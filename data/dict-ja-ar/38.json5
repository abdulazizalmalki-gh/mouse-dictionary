 "悪鬼": "روح شريرة (روح تميل لإحداث الضرر)",
 "悪魔": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / الشَّيْطَان, إِبْلِيس",
 "悪魔の宴": "اجتماع الساحرات, سبت الساحرات (اجتماع ليلي للساحرات لممارسة السحر والشعوذة؛ في العصور الوسطى كان يُعتقد أنه طقوس شيطانية)",
 "悪魔よけ": "طِلَسْم, طِلَّسْم",
 "悪魔主義": "شَيْطَانِيَّة",
 "悪魔学": "عِلْم الشَيَاطِين (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "悪魔崇拝": "الشيطانية, عبادة الشياطين (اعتقاد في الشياطين وتقديسهم (خاصة الشيطان الأكبر))",
 "悪魔払い": "رُقْيَة",
 "悪魔的": "جَهَنَّمِيّ, شَيْطَانِيّ (بالغ الشر أو القسوة؛ يُعبِّر عن الوحشية أو يليق بالجحيم)",
 "悪魔祓い": "رُقْيَة",
 "悪魔調伏": "رُقْيَة",
 "悪魔除け": "طِلَسْم, طِلَّسْم",
 "悲しい": "حَزِين, زعلان / مُحْزِنٌ\nمثال: そんな悲しい目で見ないで。 — لا تنظري إلي بهاتين العينين الحزينتين. / مُحْزِنٌ",
 "悲しいかな": "وَا حَسْرَتَاه, وَاهًا",
 "悲しさ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "悲しみ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "悲しむ": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "悲傷": "غَمّ, حُزْن",
 "悲劇": "مَأْسَاة, تْرَاجِيدْيَا / تْرَاجِيدْيَا / مَأْسَاة, فَاجِعَة",
 "悲劇俳優": "ممثل تراجيدي (ممثل يتخصص في الأدوار التراجيدية) / كاتب تراجيدي (كاتب (وخاصة كاتب مسرحي) يكتب التراجيديا)",
 "悲劇役者": "ممثل تراجيدي (ممثل يتخصص في الأدوار التراجيدية) / كاتب تراجيدي (كاتب (وخاصة كاتب مسرحي) يكتب التراجيديا)",
 "悲劇的": "مَأْسَاوِيّ, تْرَاجِيدِيّ",
 "悲咽": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "悲哀": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "悲喜こもごも": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "悲喜交々": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "悲喜交交": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "悲喜劇": "تراجيكوميديا, كوميديا جادة (كوميديا ذات عناصر أو نغمات جادة) / تراجيكوميديا, مأساة ملهاة (مؤلف درامي يتضمن عناصر من كل من المأساة والملهاة وعادة ما تسود المأساة)",
 "悲嘆": "غَمّ, حُزْن",
 "悲境": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "悲壮": "بُطُولِيّ",
 "悲悼": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)",
 "悲惨": "كَارِثِيّ, مَشْؤُوم ((عَنِ الأَحْدَاثِ) ذُو عَوَاقِبَ وَخِيمَةٍ أَوْ كَارِثِيَّةٍ)",
 "悲愁": "غَمّ, حُزْن",
 "悲愴": "سَخِيف, مُثِير لِلشَّفَقَة (يُثِير شَفَقَةً مَشُوبَةً بِالاِزْدِرَاء) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "悲憤": "استنكار, سخط (شعور بالغضب المحق)",
 "悲曲": "رِثَاء, مَرْثِيَة",
 "悲歌": "رِثَاء, مَرْثِيَة",
 "悲況": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "悲田院": "ملجأ الفقراء (مؤسسة تدار على نفقة الدولة لتوفير السكن للفقراء والمشردين)",
 "悲痛": "غَمّ, حُزْن",
