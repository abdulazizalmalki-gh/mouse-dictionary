 "弓状": "قَنْطَرِيّ, مُقَوَّس (يشكل قوسًا أو يشبهه)\nمثال: ممر مقوس",
 "弓矢": "قَوْس وَسَهْم / سِلَاح, أَسْلِحَة",
 "弓箭": "قَوْس وَسَهْم / رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ)…) / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "弓術": "رِمَايَة",
 "弓鋸": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "弔い": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة",
 "弔する": "نَدَبَ",
 "弔事": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "弔意": "تَأْسِيَة",
 "弔慰": "تَأْسِيَة",
 "弔文": "تَأْبِين, أُمْدُوحَة",
 "弔歌": "رِثَاء, مَرْثِيَة",
 "弔詞": "تَأْبِين, أُمْدُوحَة",
 "弔詩": "رِثَاء, مَرْثِيَة",
 "弔辞": "تَأْبِين, أُمْدُوحَة",
 "弔鐘": "صُور",
 "引": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)",
 "引き": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / جذب, نتر (سحب مفاجئ وخاطف) / تَرَاجُع / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "引きあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "引きうける": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / وَرَثَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "引きこもり": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ)",
 "引きさる": "تَرَاجُع",
 "引きしぼる": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي / سُلَالَة",
 "引きしめる": "شَدَّ, ضَيَّقَ",
 "引きずり降ろす": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "引きずる": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / أَطَالَ / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "引きつける": "اِجْتَذَبَ, جَذَبَ / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "引きつづく": "تَابَعَ, اِسْتَمَرَّ",
 "引きつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "引きつる": "زِيَار / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…) / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين)",
 "引きとめる": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "引きひも": "خيط زم, رباط سحب (رباط يتكون من حبل يمر عبر درزة حول فتحة)\nمثال: سحب خيط الزم وأغلق الحقيبة / رَصَاص",
 "引きまわす": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "引きも切らず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "引きも切らない": "مُسْتَمِرّ, مُتَوَاصِل",
 "引きわける": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "引き上げ": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / إعادة إلى الوطن (فعل العودة أو الإعادة إلى البلد الأصلي)",
 "引き上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…)",
 "引き下がる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / تَنَازَلَ",
 "引き下げ": "نَقْص",
 "引き下げる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "引き付け": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة…)",
 "引き付ける": "اِجْتَذَبَ, جَذَبَ / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "引き伸ばし": "تَمْدِيد / تَوْسِيع",
 "引き伸ばし機": "مكبر الصور (معدات تصوير فوتوغرافي تتكون من جهاز عرض بصري يستخدم لتكبير صورة فوتوغرافية)",
 "引き伸ばす": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "引き写し": "نسخ (فعل النسخ)",
 "引き写す": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "引き出し": "جَارُور, دُرْج\nمثال: إنه رسام مشهور. / اِنْسِحَاب",
 "引き出す": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / يَسْتَحْضِر, يَسْتَدْعِي / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / مُقْتَطَف",
 "引き出物": "هَدِيَّة, هدية",
 "引き分け": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "引き分ける": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "引き切る": "قَاطَعَ",
 "引き去る": "تَرَاجُع",
 "引き取り": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام)\nمثال: كانت الغنائم سهلة / ذهاب, رحيل (فعل المغادرة)",
 "引き取り人": "مُحَافِظ",
 "引き取り手": "مُدَّعٍ, مُدَّعِيَة",
 "引き取る": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / تَبَنَّى / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "引き受け": "مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها)\nمثال: استعد لمشاريع عظيمة",
 "引き受ける": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / وَرَثَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "引き受け人": "كَافِل",
 "引き合い": "مَرْجِع / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / شَهَادَة\nمثال: شاهد هذا الفيلم.",
 "引き合いに出す": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم:…)\nمثال: تحصلت على علامة أ.",
 "引き合う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "引き合わせ": "مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "引き合わせる": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي. / قَارَنَ",
 "引き吊り": "نَدْبَة, نَدْب / تَشَنُّج",
 "引き回し": "إِرْشَاد, هِدَايَة",
 "引き回す": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "引き寄せる": "اِجْتَذَبَ, جَذَبَ",
 "引き延ばし": "تَمْدِيد / تَوْسِيع",
 "引き延ばす": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "引き廻し": "إِرْشَاد, هِدَايَة",
 "引き廻す": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "引き当て": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "引き当てる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "引き戸": "باب منزلق (باب يفتح عن طريق الانزلاق بدلاً من التأرجح)",
 "引き戻す": "اِسْتَعَادَ",
 "引き手": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / يَمِين, يُمْنَى",
 "引き払う": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "引き抜き": "تَعْبِئَة / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "引き抜き編み目": "غرزة لقط, غرزة مخفية (غرزة فضفاضة تلتقط خيطاً أو خيطين فقط من القماش؛ مصممة لتكون غير مرئية من الجانب…)",
 "引き抜く": "مُقْتَطَف",
 "引き揚げ": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / إعادة إلى الوطن (فعل العودة أو الإعادة إلى البلد الأصلي)",
 "引き揚げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…)",
 "引き揚げ者": "عائد إلى الوطن (شخص عاد إلى بلده الأصلي أو استعاد جنسيته)",
 "引き換え": "تَبْدِيل, تَبَادُل",
 "引き換えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "引き換える": "تَبْدِيل, تَبَادُل / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات)\nمثال: هناك خط رفيع بين العقل والجنون",
 "引き換え券": "قَسِيمَة",
 "引き換え証": "إِيصَال",
 "引き摺り下ろす": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "引き摺る": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / أَطَالَ / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "引き攣り": "نَدْبَة, نَدْب / تَشَنُّج",
 "引き攣る": "زِيَار / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…) / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين)",
