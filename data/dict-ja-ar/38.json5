 "数隻": "بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "敲き": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة / خبطة, ضربة قوية (ضربة قوية) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)\nمثال: الضربة المفاجئة طرحته أرضاً / سَرِقَة, لُصُوصِيَّة",
 "敲き台": "قرمة, لوح التقطيع (كتلة خشبية ثابتة يمكن تقطيع الطعام أو تقطيعه إلى مكعبات عليها أو شق الخشب عليها)",
 "整々": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "整え": "تَحْضِير, إِعْدَاد",
 "整える": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / ضَبَطَ",
 "整った": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "整備": "صِيَانَة / إِعْمَار, تَعْمِير",
 "整備兵": "طاقم أرضي (طاقم الفنيين والميكانيكيين الذين يخدمون الطائرات على الأرض)",
 "整備員": "حارس الحديقة, مسؤول الملاعب (شخص يحافظ على الأراضي (في عقار أو حديقة أو ملعب رياضي))",
 "整備士": "مِيكَانِيكِيّ",
 "整備室": "مَهَمَّة",
 "整備工": "مِيكَانِيكِيّ",
 "整備工場": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "整備性": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "整列": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "整合": "ضَبْط",
 "整合性": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "整式": "متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود",
 "整形": "جراحة العظام, طب العظام (فرع العلوم الطبية المعني باضطرابات أو تشوهات العمود الفقري والمفاصل) / نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "整形外科": "جراحة العظام, طب العظام (فرع العلوم الطبية المعني باضطرابات أو تشوهات العمود الفقري والمفاصل) / جِرَاحَةْ تَجْمِيل",
 "整形外科医": "جراح تجميل (جراح يقوم بتجميل الجسم (خاصة الوجه))",
 "整形手術": "جِرَاحَةْ تَجْمِيل",
 "整復": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "整復師": "أخصائي في العلاج الطبيعي, أخصائية في العلاج الطبيعي",
 "整数": "عَدَد صَحِيح (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "整整": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "整斉": "مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين) / مُدَبَّر, مُرَتَّب (منظم أو مخطط له مسبقاً) / مرتب, منسق (موضع أو مرتب بنوع معين من النظام)\nمثال: قطع الشطرنج المرتبة بعناية",
 "整枝": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "整氷車": "زامبوني (العلامة التجارية لآلة تسوي الجليد في حلبة التزلج على الجليد)",
 "整流": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تصحيح, تعديل (فعل تقديم تحسين لاستبدال خطأ؛ تقويم) / تقويم (تحويل التيار المتردد إلى تيار مباشر) / تقطير, تكرير ((في الكيمياء) عملية تكرير أو تنقية مادة ما عن طريق التقطير)",
 "整流器": "مقوم تيار (جهاز كهربائي يحول التيار المتردد إلى تيار مستمر) / مُصَحِّح, مُقَوِّم (شخص يصحح أو يُقوّم الأمور)\nمثال: مصحح للتحيزات",
 "整流子": "مبدل كهربائي (مفتاح لعكس اتجاه التيار الكهربائي)",
 "整流板": "مقوم تيار (جهاز كهربائي يحول التيار المتردد إلى تيار مستمر) / مُصَحِّح, مُقَوِّم (شخص يصحح أو يُقوّم الأمور)\nمثال: مصحح للتحيزات",
 "整流管": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "整然": "منضبط, منظم (خالٍ من العنف أو الاضطراب) / مُنَظَّم, نَظِيف (نَظِيفٌ أَوْ مُنَظَّمٌ بِشَكْلٍ جَيِّد) / تمرجي, ساعي المستشفى (مرافق مستشفى ذكر لديه واجبات عامة لا تشمل العلاج الطبي للمرضى) / جندي مراسلة, مراسل (جندي يعمل كمساعد لضابط أعلى رتبة)\nمثال: حشد منظم واجه الرئيس",
 "整版": "طَابُوقَة",
 "整理": "تصنيف, فرز (التجميع حسب الفئة أو النوع أو الحجم) / تصنيف, تويب (العملية المعرفية الأساسية للترتيب في فئات أو أصناف) / تصنيف, فرز (عملية تفصل العناصر إلى مجموعات وفقاً لمعيار محدد)\nمثال: عنق الزجاجة في تسليم البريد هو عملية الفرز / تَصْفِية / تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي) / تحصين داخلي (خندق يتكون من تحصين داخلي إضافي لإطالة أمد الدفاع)",
 "整理がつく": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "整理が付く": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "整理ダンス": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "整理箪笥": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "整理統合": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "整級数": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "整経機": "آلة التسدية, آلة السداء (آلة نسيج تستخدم لتسدية أي خيوط طبيعية أو صناعية)",
 "整置": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "整調": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي) / تَنْظِيم / سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "整除数": "جُزْء قَاسِم, قَاسِم تَامّ (عدد صحيح هو قاسم تام لكمية معينة)\nمثال: 4 هو قاسم تام لـ 12",
 "整音": "تجويد الصوت, ضبط النغمة (فعل تعديل أنبوب الأرغن (أو آلة النفخ) ليتوافق مع معايير النغمة والطبقة واللون)",
 "整頓": "تَرْتِيب, مَنْهَجِيَّة (صفة تقدير المنهج والنظام) / ترتيب, نظام (حالة من الترتيب المنتظم أو الصحيح)\nمثال: رتب مكتبه",
 "整風": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تصحيح, تعديل (فعل تقديم تحسين لاستبدال خطأ؛ تقويم) / تقويم (تحويل التيار المتردد إلى تيار مباشر) / تقطير, تكرير ((في الكيمياء) عملية تكرير أو تنقية مادة ما عن طريق التقطير)",
 "整骨師": "مقوم العظام (معالج يعالج الهيكل العظمي والعضلات)",
 "整髪": "تصفيف شعر, عناية بالشعر (العناية بالشعر: نشاط غسل أو قص أو تجعيد أو ترتيب الشعر) / زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "整髪剤": "تصفيف شعر, عناية بالشعر (العناية بالشعر: نشاط غسل أو قص أو تجعيد أو ترتيب الشعر) / زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "敵": "مُنَافِس / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر. / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / تَهْدِيد",
 "敵う": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "敵に回る": "اِنْقَلَبَ عَلَى",
 "敵わない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / مُسْتَحِيل",
 "敵人": "عَدُوّ, عَدُوَّة (ركض أو جري) / عَدُوّ (ركض أو جري) / عَدَائِيّ\nمثال: عدو عدوي صديقي. / مُنَافِس",
 "敵兵": "عَدُوّ, عَدُوَّة (ركض أو جري) / عَدُوّ (ركض أو جري) / عَدَائِيّ\nمثال: عدو عدوي صديقي.",
 "敵対": "عَدَاوَة, عَدَاء",
 "敵対勢力": "خَصْم, مُقَاوِم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "敵対的": "مُعَادِي",
 "敵対的買収": "استحواذ عدائي (استحواذ تقاومه إدارة الشركة المستهدفة)",
 "敵対者": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "敵役": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "敵意": "عَدَاوَة, عَدَاء",
 "敵愾心": "عَدَاوَة, عَدَاء",
 "敵手": "مُنَافِس",
 "敵討": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "敵討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "敷": "انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / تأمين الهامش, هامش (مبلغ الضمان الذي يودعه العميل لدى وسيط عند الاقتراض من الوسيط لشراء أوراق مالية)",
 "敷き": "انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / تأمين الهامش, هامش (مبلغ الضمان الذي يودعه العميل لدى وسيط عند الاقتراض من الوسيط لشراء أوراق مالية)",
 "敷きわら": "مِحَفَّة / بَعْثَرَ",
 "敷き写し": "تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما) / رسم تتبعي, شف (فعل رسم مخطط أو تصميم أو مسودة عن طريق الشف) / رسم شفاف, شف (رسم تم إنشاؤه بوضع ورقة نصف شفافة على الصورة الأصلية ونسخ خطوط الصورة الأصلية عليها)\nمثال: تتبع الأنساب",
 "敷き布団": "فُوتُون, فُوتُون يَابَانِيّ",
 "敷き物": "سَجَّادَة, بِسَاط / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "敷き皮": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "敷き藁": "مِحَفَّة / بَعْثَرَ",
 "敷き詰める": "لِحَاف, بَطَّانِيَّة",
 "敷き革": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "敷く": "تَفَرَّقَ (تفرق الشَّيْء تفَرقا وتفراقا تبدد وَالرجلَانِ ذهب كل مِنْهُمَا فِي طَرِيق؛ تفرَّقَ) / فَرَّقَ / مُنْتَشِر, مُتَفَرِّق\nمثال: أتستطيع أن تفرق توم من أخيه؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / عَبَّأَ, نَشَرَ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "敷地": "مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "敷居": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "敷居をまたぐ": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "敷居を跨ぐ": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "敷居値ゲート": "عنصر العتبة (عنصر منطقي يؤدي عملية العتبة)",
 "敷居値演算": "عملية عتبة (عملية تجرى على المعاملات للحصول على قيمة دالة العتبة)",
 "敷居値素子": "عنصر العتبة (عنصر منطقي يؤدي عملية العتبة)",
 "敷居値関数": "دَالَّة العَتَبَة (دالة تأخذ القيمة 1 إذا تجاوزت دالة محددة للحجج عتبة معينة و 0 خلاف ذلك)",
 "敷島": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "敷布": "وَرَقَة, وَرَق",
 "敷布団": "فُوتُون, فُوتُون يَابَانِيّ",
 "敷延": "إسهاب, استفاضة (مناقشة (منطوقة أو مكتوبة) تتوسع في موضوع أو فكرة بإسهاب أو بالتفصيل) / سَرَدَ (الشيء: نَسَجَهُ ليصبح مفهوما؛ الأمر:الحديث يتلوه بإستمرار)\nمثال: يحاول الانفصاليون تطوير سرد زائف من أجل تبرير مشروعهم السياسي.",
 "敷板": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "敷物": "سَجَّادَة, بِسَاط / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "敷皮": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "敷石": "حَجَر رَصْف (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "敷衍": "إسهاب, استفاضة (مناقشة (منطوقة أو مكتوبة) تتوسع في موضوع أو فكرة بإسهاب أو بالتفصيل) / سَرَدَ (الشيء: نَسَجَهُ ليصبح مفهوما؛ الأمر:الحديث يتلوه بإستمرار)\nمثال: يحاول الانفصاليون تطوير سرد زائف من أجل تبرير مشروعهم السياسي.",
 "敷設": "وضع البيض (إنتاج البيض (خاصة في الطيور))",
 "敷金": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "敷革": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "斂葬": "دَفْن (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "斃る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "斃仆": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "斃死": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "文": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / مُؤَلَّف, مُصَنَّف / الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي) / تَصْرِيح, بَيَان / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / نُمُوذَج, نَمَط / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / لعبة الخيط (لعبة تُلعب بخيط ملفوف حول الأصابع) / لغة مون (لغة مون-خمير التي يتحدث بها شعب مون) / مون (عضو في شعب بوذي يعيش في ميانمار والأجزاء المجاورة من تايلاند) / الاثنين, يوم الاثنين (اليوم الثاني من الأسبوع) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "文なし": "فقير",
 "文人": "شَاعِر, شَاعِرَة",
 "文体論": "أُسْلُوبِيّ (يتعلّق بالأسلوب (خاصة في استخدام اللغة))",
 "文具": "قِرْطَاسِيَّة",
 "文典": "عِلْم قَوَاعِد (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "文化": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "文化の盗用": "استيلاء ثقافي",
 "文化人類学": "أنثروبولوجيا اجتماعية, أنثروبولوجيا ثقافية (فرع الأنثروبولوجيا الذي يتعامل مع الثقافة والمجتمع البشري)",
 "文化包丁": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "文化大革命": "ثَوْرَة ثَقَافِيَّة",
 "文化的": "ثَقَافِيّ, مَدَنِيّ",
 "文化盗用": "استيلاء ثقافي",
 "文化系": "ثَقَافِيّ, مَدَنِيّ",
 "文化革命": "ثَوْرَة ثَقَافِيَّة",
 "文句": "شِكَايَة, شَكْوَى / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "文句なく": "بشكل قاطع, بلا جدال (بطريقة لا تقبل الجدل أو النزاع)\nمثال: أنت تكتب كما لو أن هذه الحقيقة، وإن كانت تدينني بلا جدال بالانضمام إلى صفوف البوهيمية، إلا أنها أكسبتني حق الدخول إلى أي رفقة",
 "文句なし": "بِلَا مُنَازِع, مُسَلَّمٌ بِه (مُتَّفَقٌ عَلَيْهِ عُمُومًا؛ لَا يَخْضَعُ لِلنِّزَاع)",
 "文句のつけようがない": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "文句の付けようがない": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "文句の付けようが無い": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "文句をいう": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "文句をつける": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "文句を付ける": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "文句を言う": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "文句無し": "بِلَا مُنَازِع, مُسَلَّمٌ بِه (مُتَّفَقٌ عَلَيْهِ عُمُومًا؛ لَا يَخْضَعُ لِلنِّزَاع)",
 "文園": "تَجْمِيعَة, دِيوَان",
 "文士": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "文字": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "文字セット": "مجموعة المحارف (قائمة مرتبة من الأحرف التي تستخدم معاً في الكتابة أو الطباعة)",
 "文字化け": "فَسَاد",
 "文字参照": "خطاب مرجعي, شهادة حسن سيرة وسلوك (توصية رسمية من صاحب عمل سابق إلى صاحب عمل مستقبلي محتمل تصف مؤهلات الشخص وموثوقيته)\nمثال: غالباً ما يتم الرد على طلبات خطابات المراجع بشكل مراوغ",
 "文字合わせ錠": "قفل أرقام, قفل مركب (قفل لا يمكن فتحه إلا عن طريق تدوير الأقراص بتسلسل خاص)",
 "文字式": "متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود",
 "文字数／インチ": "استبيان كاليفورنيا للشخصية / مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "文字盤": "مُؤَشِّر / مِزْوَل, مُدَرَّجَة / لَوْحَةُ مَفَاتِيح",
 "文字組": "تَنْضِيد",
 "文字組み": "تَنْضِيد",
 "文字言語": "تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "文字起こし": "كَرْشَنَة, نَقْصَوَة",
 "文字通り": "حَرْفِيًّا / بِٱلْحَرْف / لَفْظِيّ, حَرْفِيّ",
 "文字間": "تتبع الأثر, ملاحقة (ملاحقة (شخص أو حيوان) باتباع الآثار أو العلامات التي تركوها وراءهم)",
 "文字集合": "مجموعة المحارف (قائمة مرتبة من الأحرف التي تستخدم معاً في الكتابة أو الطباعة)",
 "文学": "أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "文学作品": "عمل أدبي, مؤلف أدبي (كتابة إبداعية أو خيالية)",
