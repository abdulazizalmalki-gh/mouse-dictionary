 "征東": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "征東大将軍": "رَئِيس أَرْكَان",
 "征東将軍": "رَئِيس أَرْكَان",
 "征矢": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "征箭": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "征衣": "زي عسكري (زي تعريف محدد للجنود)",
 "征西": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "征討": "إخضاع, غزو (فعل الغزو)\nمثال: قمع الطاغية للشعب",
 "征途": "بعثة, حملة (رحلة منظمة لغرض معين)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "径": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / قُطْر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر.",
 "径間": "شِبْر",
 "待ち": "انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما))\nمثال: كان الانتظار محنة بالنسبة له",
 "待ちどうしい": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "待ちぶせ": "كَمين",
 "待ち伏せ": "كَمين",
 "待ち伏せる": "كَمين",
 "待ち受け": "انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما))\nمثال: كان الانتظار محنة بالنسبة له / وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待ち受ける": "اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "待ち受け画像": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待ち受け画面": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待ち合い": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء / غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة. / مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "待ち合せ": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "待ち合わせ": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "待ち合わせる": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء",
 "待ち合わせ場所": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "待ち時間": "كمون (حالة كونه غير ظاهر أو نشط بعد)",
 "待ち構える": "اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "待ち焦がれる": "اِشْتَاقَ",
 "待ち画": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待ち行列": "طابُور, صَفّ (وَحْدة عسكريَّة تضمّ عِدَّة سَرايا)\nمثال: كانا واقفين في طابور.",
 "待ち設ける": "تَوَقَّعَ",
 "待ち遠しい": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "待った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "待つ": "اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / حَاجَة, ضَرُورَة",
 "待てど暮せど": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "待てど暮らせど": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "待井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "待伏せ": "كَمين",
 "待伏せる": "كَمين",
 "待受け": "انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما))\nمثال: كان الانتظار محنة بالنسبة له / وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待受ける": "اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "待受画像": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待受画面": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待合": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء / غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة. / مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "待合い": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء / غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة. / مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "待合室": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "待合所": "مَلَاذ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين. / غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "待合茶屋": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "待宵草": "أخدرية, زهرة الربيع المسائية",
 "待期者": "متقاعد (شخص تقاعد من العمل النشط)",
 "待機": "حَجْر صِحِّيّ, عَزْل (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "待機室": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "待機的": "انتخابي, منتخب (خاضع لانتخاب شعبي)\nمثال: مسؤول منتخب",
 "待機部屋": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "待画": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "待設ける": "تَوَقَّعَ",
 "待遇": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري. / رَاتِب, أَجْر",
 "待遠しい": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "待避": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)",
 "待避壕": "مخبأ محصن, ملجأ (حجرة (غالباً تحت الأرض) محصنة ضد القصف ومزودة بالطعام ومرافق المعيشة؛ تُستخدم…)",
 "待避所": "دوران للخارج ((باليه) الدوران الخارجي لساق الراقص من الورك)\nمثال: الإقبال على التجمع / مَلَاذ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "待避線": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط…)",
 "待降節": "بزوغ, قدوم (وصول كان منتظراً (خاصة لشيء مهم))\nمثال: قدوم الحاسوب",
 "待雪草": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "律": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / زِفْت / خُطْوَة, خَطْوَة",
 "律する": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "律儀": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "律動": "إِيقَاع",
 "律動的": "إيقاعي, موزون (يتكرر بانتظام موزون)\nمثال: الدقات الإيقاعية لأجراس الكنيسة",
 "律師": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد))",
 "律文": "نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ…)\nمثال: نظم سامي كل شيء.",
 "律法": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / اَلتَّوْرَاة",
 "律法学者": "حَاخَام, حَبْر / نَاسِخ\nمثال: لست بذاك الكاتب.",
 "律義": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "後": "وَرَاءَ / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / بَقِيَّة / أَكْثَر / فِيمَا بَعْد, بعدين / مُسْتَقْبَل / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ) / خَلْفِيّ\nمثال: عنده حقيبة ظهر. / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / أسفل, جانب سفلي (الجانب السفلي من أي شيء) / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / عَاقِبَة",
 "後々": "مُسْتَقْبَل",
 "後え": "خَلْفِيّ",
 "後から": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "後から後から": "وَاحِدًا تِلْوَ الآخَرِ",
 "後じさる": "تَرَاجُع",
 "後ずさる": "تَرَاجُع",
 "後で": "فِيمَا بَعْد, بعدين",
 "後に": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "後にする": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "後になって": "أَخِير, بَعْدَ ذٰلِك",
 "後になる": "تَأَخَّرَ",
 "後の世": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "後の先": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة)",
 "後の方": "فِيمَا بَعْد, بعدين",
 "後は野となれ山となれ": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "後へ引く": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "後ほど": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "後らす": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "後らせる": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "後れる": "تَأَخَّرَ",
 "後れを取る": "تَأَخَّرَ",
 "後れ咲き": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "後ろ": "خَلْفِيّ\nمثال: عنده حقيبة ظهر.",
 "後ろぐらい": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ)",
 "後ろめたい": "مُذْنِب, مُذْنِبَة",
 "後ろ倒し": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "後ろ側": "خَلْفِيّ\nمثال: عنده حقيبة ظهر.",
 "後ろ前": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة)\nمثال: تحرك للخلف",
 "後ろ向き": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة)\nمثال: تحرك للخلف / اِنْحِدَارِيّ, تَرَاجُعِيّ (يتحوّل من الأفضل إلى الأسوأ)",
 "後ろ手": "وَرَاءَ",
 "後ろ指": "غِيبَة",
 "後ろ指を差す": "اِغْتَابَ, أَبَرَ",
 "後ろ指を指す": "اِغْتَابَ, أَبَرَ",
 "後ろ暗い": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ)",
 "後ろ楯": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "後ろ盾": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "後ろ脚": "رجل خلفية, ساق خلفية (الطرف الخلفي لذوات الأربع)",
 "後ろ言": "فضيحة, نميمة خبيثة (قيل وقال مشين عن الحياة الخاصة للآخرين)",
 "後ろ足": "رجل خلفية, ساق خلفية (الطرف الخلفي لذوات الأربع)",
 "後をつける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "後を付ける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "後を慕って": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ)\nمثال: و بعد قليل أتى.",
 "後を絶たない": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "後を継ぐ": "نَجَحَ",
 "後を追う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "後ジテ": "بَطَل, بَطَلَة",
 "後ノリ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "後ピン": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "後一歩": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "後世": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / آخِرَة",
 "後乗り": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "後人": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "後仕手": "بَطَل, بَطَلَة",
 "後仕舞": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "後付": "مُلْحَق / تحديث, تعديل تحديثي (عملية إضافة مكون أو ملحق لشيء لم يكن يحتوي عليه عند تصنيعه)\nمثال: أمرت المحكمة بتحديث جميع السيارات",
 "後付け": "مُلْحَق / تحديث, تعديل تحديثي (عملية إضافة مكون أو ملحق لشيء لم يكن يحتوي عليه عند تصنيعه)\nمثال: أمرت المحكمة بتحديث جميع السيارات",
 "後代": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "後件": "الأخير, المذكور آخراً (الثاني من بين اثنين أو المذكور ثانياً بين اثنين)\nمثال: كان توم وديك بطلين لكن الأخير فقط هو من يُذكر اليوم / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "後任": "خَلِيف",
 "後任者": "خَلِيف",
 "後側": "خَلْفِيّ\nمثال: عنده حقيبة ظهر.",
 "後備役": "قوات الاحتياط (القوات المسلحة التي ليست في الخدمة الفعلية ولكن يمكن استدعاؤها في حالة الطوارئ)",
 "後催眠暗示": "إيحاء ما بعد التنويم (اقتراح يتم تقديمه لشخص تحت التنويم المغناطيسي يحدد إجراءً سيقوم به (عادةً…)",
 "後先": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / عَاقِبَة / سِيَاق, قَرِينَة",
 "後光": "هَالَة",
 "後入れ先出し": "ما يرد أخيراً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأحدث (التي تم شراؤها مؤخراً) هي…)",
 "後入れ先出し記憶装置": "كَوْمَة",
 "後入先出": "ما يرد أخيراً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأحدث (التي تم شراؤها مؤخراً) هي…)",
 "後出": "فِيمَا بَعْد, بعدين",
 "後刻": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "後加工": "تَعْدِيل",
 "後半": "شوط ثاني (الثاني من شوطين للعب)",
 "後半戦": "شوط ثاني (الثاني من شوطين للعب)",
 "後半期": "شوط ثاني (الثاني من شوطين للعب)",
 "後口": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / فِيمَا بَعْد, بعدين",
 "後向き": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة)\nمثال: تحرك للخلف / اِنْحِدَارِيّ, تَرَاجُعِيّ (يتحوّل من الأفضل إلى الأسوأ)",
 "後味": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما)",
 "後嗣": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "後回し": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "後天": "البعديَة",
 "後天性": "مُكْتَسَب",
 "後天性免疫不全症候群": "إيدز, متلازمة نقص المناعة المكتسب (مرض خطير (غالباً ما يكون قاتلاً) يصيب الجهاز المناعي وينتقل عن طريق منتجات الدم…)",
 "後天的": "مُكْتَسَب / البعديَة",
 "後妻": "سُرِّيَة / حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "後始末": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "後室": "أرملة",
 "後宮": "حَرِيم, حَرَمْلِك",
 "後家": "أَرْمَلَة",
 "後尾": "خَلْفِيّ",
 "後屈": "انثناء خلفي (عملية الانحناء للخلف)\nمثال: انقلاب الرحم للخلف",
 "後山": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "後川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "後席": "مَقْعَد خَلْفِيّ (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "後座": "ارتداد, انعكاس (حركة العودة من الارتطام) / الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "後庭": "ساحة خلفية, فناء خلفي (الأرض الواقعة خلف المنزل)",
 "後形質": "تغيير",
 "後後": "مُسْتَقْبَل",
 "後悔": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "後成説": "تخلق لاحق (تغير جيولوجي في المحتوى المعدني للصخر بعد تشكله)",
 "後戯": "حديث الوسادة (محادثة حميمة بين العشاق (تحدث عادة في السرير))",
 "後戻り": "ارتداد, تراجع (العودة إلى حالة سابقة)",
 "後手にまわる": "تَأَخَّرَ",
 "後手に回る": "تَأَخَّرَ",
 "後手を踏む": "تَأَخَّرَ",
 "後手後手": "تفاعلي, نشط تفاعلياً (يشارك بسهولة في التفاعلات)\nمثال: الصوديوم معدن تفاعلي",
 "後払い": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "後押し": "دفع (فعل تطبيق قوة لتحريك شيء بعيداً)\nمثال: أعطى الباب دفعة قوية / عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "後指": "غِيبَة",
 "後掲": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ)\nمثال: و بعد قليل أتى.",
 "後援": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "後援会": "لَجْنَة",
 "後援者": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة)\nمثال: مساعدي الذي لا يقدر بثمن",
 "後方": "خَلْفِيّ",
 "後方一致": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "後方端": "حافة خلفية (الحافة الخلفية لسطح انسيابي (مثل الجناح))",
 "後方視的": "متعلِّق بالماضي, رَجْعِيّ",
 "後日": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "後日物語": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "後日談": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "後日譚": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "後昆": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "後景": "خلفية",
 "後書": "خَاتِمَة",
 "後書き": "خَاتِمَة",
 "後期": "شوط ثاني (الثاني من شوطين للعب)",
 "後期印象派": "ما بعد الانطباعية (في الرسم الغربي، حركة في فرنسا مثلت امتداداً للانطباعية ورفضاً للقيود المتأصلة…)",
 "後期研修医": "طبيب مقيم (طبيب يعيش في المستشفى ويعتني بالمرضى المقيمين تحت إشراف الطاقم الطبي للمستشفى)\nمثال: كان الطبيب المقيم يتلقى تدريباً سريرياً خاصاً في المستشفى",
 "後来": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "後架": "مِرْحَاض, تواليت",
 "後株": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "後根": "جذر خلفي, جذر ظهري (أحد جذري العصب الشوكي الذي يمر ظهرياً من الحبل الشوكي ويتكون من ألياف حسية)",
 "後檣": "الصاري الخلفي, صاري المزينة (الصاري الثالث من المقدمة في سفينة ذات ثلاثة صواري أو أكثر؛ الصاري الخلفي الأقصر…)",
 "後流": "تيار انزلاقي, تيار هوائي خلفي (تدفق الهواء الذي تدفعه مروحة الطائرة إلى الخلف)",
 "後獣類": "وحشيات بعدية (ثدييات بدائية ذات جراب توجد بشكل رئيسي في أستراليا والأمريكتين)",
 "後生": "آخِرَة",
 "後生動物": "تالي, حيوان تالي (أي حيوان من المملكة الفرعية للحيوانات التوالي؛ جميع الحيوانات باستثناء الأوليات…)",
 "後産": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها…)",
 "後甲板": "سطح المؤخرة (سطح خلف وسط السفينة)",
 "後番組": "متابعة اللعب (جولة ثانية فورية مفروضة على فريق كريكيت يسجل عدداً محدداً من الركضات أقل من…)",
 "後療法": "رعاية النقاهة, رعاية تالية (رعاية وعلاج المريض في فترة النقاهة)",
 "後発医薬品": "دواء جنيس (نسخ من الأدوية يمكن عرضها للبيع بعد انتهاء حماية براءة الاختراع للدواء ذي…)\nمثال: الأدوية الجنيسة عادة ما تكون أرخص من الأدوية ذات العلامات التجارية",
 "後発品": "إِجْمالِيّ, جامِع",
 "後発者": "قادم متأخراً, متأخر (شخص يصل متأخرًا)",
 "後発薬": "دواء جنيس (نسخ من الأدوية يمكن عرضها للبيع بعد انتهاء حماية براءة الاختراع للدواء ذي…)\nمثال: الأدوية الجنيسة عادة ما تكون أرخص من الأدوية ذات العلامات التجارية",
 "後目": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "後知恵": "إدراك متأخر (فهم طبيعة حدث ما بعد وقوعه)\nمثال: الإدراك المتأخر دائماً أفضل من التوقع",
 "後程": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "後端": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "後納": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "後継": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)\nمثال: لعب الأوراق الرابحة بالتسلسل / خَلِيف / وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَلِيف",
 "後継ぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَلِيف",
 "後継者": "خَلِيف",
 "後続": "نَجَحَ",
 "後編": "شوط ثاني (الثاني من شوطين للعب) / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "後縁": "حافة خلفية (الحافة الخلفية لسطح انسيابي (مثل الجناح))",
 "後置": "إتباع, وضع لاحق ((لغويات) وضع عنصر لغوي بعد آخر (مثل وضع المعدِّل بعد الكلمة التي يعدلها في…)",
 "後置記法": "التدوين البولندي العكسي, تدوين لاحق (تدوين خالٍ من الأقواس لتكوين التعبيرات الرياضية يتبع فيه كل معامل المعاملات…)",
 "後置詞": "إتباع, وضع لاحق ((لغويات) وضع عنصر لغوي بعد آخر (مثل وضع المعدِّل بعد الكلمة التي يعدلها في…)",
 "後羽": "سُوَيْقَة ثَانَوِيَّة (ريشة إضافية (صغيرة عادة) على الجانب السفلي من قاعدة ساق بعض الريش في بعض الطيور)",
 "後者": "الأخير, المذكور آخراً (الثاني من بين اثنين أو المذكور ثانياً بين اثنين)\nمثال: كان توم وديك بطلين لكن الأخير فقط هو من يُذكر اليوم / خَلِيف",
 "後肢": "طرف خلفي (زائدة خلفية مثل الساق أو بنية مماثلة في حيوانات أخرى)",
 "後背": "خَلْفِيّ\nمثال: عنده حقيبة ظهر.",
 "後背地": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "後胤": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "後脚": "رجل خلفية, ساق خلفية (الطرف الخلفي لذوات الأربع)",
 "後脛骨筋": "ظنبوبية خلفية (عضلة عميقة في الساق)",
 "後脳": "دماغ خلفي (الجزء الخلفي من الدماغ بما في ذلك المخيخ وجذع الدماغ)",
 "後腹": "آلام ما بعد الولادة (آلام تشعر بها المرأة بعد ولادة طفلها؛ مرتبطة بتقلصات الرحم) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "後臼歯": "ضِرْس",
 "後舌母音": "صائت خلفي ((صوتيات) أي صوت صائت يتم إنتاجه في مؤخرة الفم)",
 "後葉": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / غدة نخامية خلفية, نخامية خلفية (الفص الخلفي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "後藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "後衛": "حرس المؤخرة (مفرزة مكلفة بحماية مؤخرة هيئة عسكرية (منسحبة)) / خَلْفِيّ\nمثال: عنده حقيبة ظهر.",
 "後裔": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "後見": "حراسة, حفظ (مسؤولية الوصي أو الحارس)\nمثال: ترك سيارته في حفظي / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "後見人": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "後記": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / التَّالِي ذِكْرُهُ, المَذْكُور أَدْنَاه (على وشك أن يُذكَر أو يُحدَّد فيما يلي)",
 "後詰め": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة…)\nمثال: طلبوا دعماً مدفعياً",
 "後語り": "خَاتِمَة",
 "後講釈": "بَعْد المَوْت (يحدث أو يتم بعد الموت)\nمثال: تغيرات ما بعد الموت",
