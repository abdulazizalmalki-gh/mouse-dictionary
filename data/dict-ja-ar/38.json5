 "更新": "تَجْدِيد",
 "更更": "أبداً",
 "更正": "تَصْحِيح",
 "更生": "إِعَادَةُ تَأْهِيل / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر) / إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى) / إِحْيَاء دِينِيّ, اِجْتِمَاع نَهْضَة دِينِيَّة (اجتماع تبشيري يهدف إلى إيقاظ الاهتمام بالدين)\nمثال: انتعاش التجارة",
 "更生保護": "إِعَادَةُ تَأْهِيل",
 "更生期": "انقطاع الطمث, سن اليأس (الوقت في حياة المرأة الذي تنتهي فيه الدورة الشهرية)",
 "更科升麻": "بق باني, طارد البق ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا) / خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)\nمثال: قد غزا بق الفراش فرنسا.",
 "更衣": "تَجْدِيد, إِحْيَاء / فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "更衣場": "غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "更衣室": "غرفة الخزائن, غرفة تبديل الملابس (غرفة (كما في منشأة رياضية أو مكان عمل) يمكنك فيها تغيير الملابس وتحتوي على خزائن للتخزين المؤقت لملابسك وممتلكاتك الشخصية)",
 "更衣所": "غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "更訂": "تَنْقِيح",
 "更迭": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "書": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "書きあげる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "書きおくる": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書きかけ": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "書きかた": "الخط, فن الخط (الكتابة اليدوية الجميلة) / تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "書きことば": "كلمة مكتوبة (الشكل المكتوب للكلمة)\nمثال: بينما الكلمة المنطوقة ترمز لشيء ما، فإن الكلمة المكتوبة ترمز لشيء يرمز لشيء ما",
 "書きこむ": "مَلَأَ / خَزَنَ (حفظ، إدخر، أودع في مخزن) / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書きしるす": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "書きだし": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "書きだす": "مُقْتَطَف / خلاصة / صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى لتُبَاع هناك) / تَصْدِير / صَدَّرَ (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: صادرات الجزائر في تزايد.",
 "書きとめる": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "書きなぐる": "خربشة",
 "書きまちがい": "تهجئة خاطئة, خطأ إملائي (تهجئة غير صحيحة)",
 "書きもの": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "書きもの机": "طاولة كتابة, مكتب (مكتب للكتابة (عادة بسطح مائل)) / حقيبة مكتب متنقل (حقيبة محمولة تحتوي على أدوات الكتابة ولها سطح للكتابة)",
 "書き上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "書き下ろす": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書き人": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "書き付け": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "書き候": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書き入れ": "إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل",
 "書き入れ時": "موسم الذروة (الموسم الذي يكون فيه السفر أكثر نشاطًا والأسعار أعلى)\nمثال: سافروا إلى أوروبا في موسم الذروة",
 "書き写す": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "書き出し": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "書き出す": "مُقْتَطَف / خلاصة / صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى لتُبَاع هناك) / تَصْدِير / صَدَّرَ (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: صادرات الجزائر في تزايد.",
 "書き分ける": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
