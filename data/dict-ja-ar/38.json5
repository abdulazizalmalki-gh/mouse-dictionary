 "料額印面": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "斜": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق) / مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح) / مَائِل, قُطْرِيّ",
 "斜に構える": "فِرَاش, أَرِيكَة",
 "斜め": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق) / مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح)",
 "斜めならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "斜めに": "بِشَكْل مَائِل, قُطْرِيًّا (بطريقة قطرية)\nمثال: تعيش بشكل قطري عبر الشارع منا",
 "斜め向かい": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "斜交": "مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مائل, منحرف (مائل أو منحرف في الاتجاه أو المسار أو الموضع - ليس متوازياً ولا متعامداً ولا قائم الزاوية) / منحرفة خارجية (عضلة بطنية مرتبة بشكل قطري على جانبي الجذع) / حالة غير الرفع (أي حالة نحوية غير حالة الرفع)\nمثال: أشعة الشمس الشتوية المائلة",
 "斜交い": "بِانْحِرَاف, بِمَيْل (بزاوية مائلة) / بِمَيْل (فوق أو عبر في اتجاه مائل) / قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)\nمثال: سطعت الشمس بميل على وجهه",
 "斜向い": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "斜向かい": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "斜子織": "تويل, نسيج قطني طويل (نسيج يستخدم لإنتاج تأثير أضلاع قطرية متوازية)",
 "斜子織り": "تويل, نسيج قطني طويل (نسيج يستخدم لإنتاج تأثير أضلاع قطرية متوازية)",
 "斜度": "اِنْحِدَار, مَيْل (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع الأفقي) / تَدَرُّج, مَيْل (تغير متدرج في حجم كمية فيزيائية أو بعد ما)\nمثال: منحدر بمقدار خمس درجات",
 "斜方形": "مُعَيِّن",
 "斜方沸石": "شابازيت (مجموعة معادن من عائلة الزيوليت تتكون من سيليكات مائية للكالسيوم والألومنيوم)",
 "斜格": "حالة غير الرفع (أي حالة نحوية غير حالة الرفع)",
 "斜格性": "التواء, انحراف (صفة الميل وعدم الاستقامة في المسار) / انحراف, ميلان (خاصية عدم التوازي أو التعامد، بل التواجد بزاوية مائلة)",
 "斜滑降": "اِجْتَازَ, عَبَرَ",
 "斜眼": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "斜視": "حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "斜角": "زاوية مائلة (زاوية ليست قائمة وليست من مضاعفات الزاوية القائمة)",
 "斜路": "منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "斜辺": "وَتَر, ضِلْع مُتَوَتِّر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "斜陽": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "斜面": "مُنْحَدَر / مَيْل",
 "斜頚": "تشنج الرقبة, صعر (حالة غير طبيعية يميل فيها الرأس إلى جانب واحد بسبب تقلص عضلات الرقبة على ذلك الجانب)",
 "斜頭症": "رأس وارب (تشوه خلقي في الجمجمة حيث يكون المحور الرئيسي للجمجمة مائلاً)",
 "斜頸": "تشنج الرقبة, صعر (حالة غير طبيعية يميل فيها الرأس إلى جانب واحد بسبب تقلص عضلات الرقبة على ذلك الجانب)",
 "斟酌": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "斡旋": "خدمات (أداء واجبات أو توفير مساحة ومعدات مفيدة للآخرين)\nمثال: حاول العمدة الحفاظ على خدمات المدينة / وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "斡旋員": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "斡旋業者": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "斡旋者": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "斤": "أَهْل, أَقَارِب (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ)\nمثال: أهل أبدو أنيقا؟ / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه / رَغِيف",
 "斤目": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "斤量": "حجر الارتكاز (أدنى حجر في القوس الذي يبدأ منه القوس) / جمارك, مكوس (الأموال المحصلة بموجب التعريفة الجمركية) / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "斥ける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / طَرَدَ",
 "斥候": "كَشَّاف",
 "斥候兵": "كَشَّاف",
 "斥候隊": "كَشَّاف",
 "斥力": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / استهجان, نفور شديد (نفور شديد) / تنافر, قوة تنافر (القوة التي تتنافر بها الأجسام عن بعضها البعض)",
 "斧": "فَأْس / بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية)",
 "斧斤": "فَأْس",
 "斧槍": "فأس برمح, مطرد (رمح مزود برأس فأس)",
 "斧正": "تَصْحِيح",
 "斧足類": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / صَفَائِحِيُّ الخَيَاشِيم (ثُنَائِيُّ الصَّدَفَة؛ مِنَ الرَّخَوِيَّاتِ ذَاتِ الصَّدَفَتَيْن)",
 "斧鉞": "فَأْس",
 "斧鑿": "تفكير شاق, كدح ذهني (تفكير شاق ومجهد) / دراسة مضنية, مؤلف متكلف (عمل أدبي رصين نتاج تفكير وجهد شاق)",
 "斫り": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "斬": "ضرب العنق, قطع الرأس (القتل بقطع الرأس) / قطع الرأس (الإعدام بقطع رأس الضحية)",
 "斬って捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "斬り伏せる": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "斬り倒す": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "斬り刻む": "آلة كي, معصرة غسيل (مجفف ملابس لتجفيف وكي الغسيل بتمريره بين أسطوانتين ساخنتين ثقيلتين)",
 "斬り取り": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة / سَطْو / لُصُوصِيَّة",
 "斬り払う": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "斬り捨て": "تَضْحِيَة, قُرْبَان / ضَحَّى / إِغْفَال",
 "斬り捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه) / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "斬り殺す": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "斬り解く": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "斬り込み": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "斬り込む": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "斬る": "شريحة / قَطَّعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "斬れ味": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد / نشاط, همة (حيوية وطاقة)\nمثال: هذا المنشط مضمون لإعطائك مزيداً من النشاط",
 "斬取り": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة / سَطْو / لُصُوصِيَّة",
 "斬味": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد / نشاط, همة (حيوية وطاقة)\nمثال: هذا المنشط مضمون لإعطائك مزيداً من النشاط",
 "斬捨て": "تَضْحِيَة, قُرْبَان / ضَحَّى / إِغْفَال",
 "斬撃": "خَطّ مَائِل (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "斬新": "مُسْتَجِدّ / رِوَايَة",
 "斬新奇抜": "مُسْتَجِدّ / رِوَايَة",
 "斬新性": "إبداع, ابتكار (الأصالة بحكم تقديم أفكار جديدة)",
 "斬殺": "اغتيال, جريمة قتل (قتل إنسان لإنسان آخر بشكل غير قانوني ومع سبق الإصرار)",
 "斬罪": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "斬解く": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "斬首": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "斬首刑": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "斬馬刀": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "断": "قَرَار, تَصْمِيم",
 "断々乎": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "断々固": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "断じて": "مطلقا, على الإطلاق",
 "断じる": "قَرَّرَ, صَمَّمَ / قَرَّرَ / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "断ずる": "قَرَّرَ, صَمَّمَ / قَرَّرَ / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "断ち切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: استعملت ريمة لجذب الانتباه. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "断ち割る": "انفصل",
 "断ち落とし": "قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "断つ": "جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: استعملت ريمة لجذب الانتباه. / اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "断り": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / تَصْرِيح, سَمَاح / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "断りを入れる": "بَلَّغَ, أَبْلَغَ",
 "断る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / بَلَّغَ, أَبْلَغَ",
 "断わり": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / تَصْرِيح, سَمَاح / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "断わる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / بَلَّغَ, أَبْلَغَ",
 "断切": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "断口": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "断固": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "断固として": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "断定": "نَتِيجَة / إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "断層": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "断層写真": "صورة مقطعية (الصورة المقطعية هي صورة بالأشعة السينية تنتج عن طريق التصوير المقطعي)",
 "断層撮影": "تصوير طبي, تصوير مقطعي ((طب) الحصول على صور لداخل الجسم)",
 "断層線": "خط الصدع (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "断層運動": "صدع, فالق ((جيولوجيا) شق في القشرة الأرضية ناتج عن إزاحة جانب واحد بالنسبة للآخر)\nمثال: بنوها فوق صدع جيولوجي مباشرة",
 "断岩": "جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً)",
 "断崖": "جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً)",
 "断念": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "断截": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "断捨離": "التبسيطية, الفن التقليلي (حركة فنية في النحت والرسم بدأت في الخمسينيات وأكدت على التبسيط الشديد للشكل واللون)",
 "断断乎": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "断断固": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "断案": "نَتِيجَة",
 "断然": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم / بالتأكيد, بشكل قاطع (بدون شك وخارج نطاق الشك)\nمثال: كان باهظ الثمن بلا شك / إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل",
 "断熱": "عزل (فعل حماية شيء ما عن طريق إحاطته بمادة تقلل أو تمنع انتقال الصوت أو الحرارة أو الكهرباء) / انعزال, تقوقع (حالة العزلة أو الانفصال) / عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "断熱性": "عزل (فعل حماية شيء ما عن طريق إحاطته بمادة تقلل أو تمنع انتقال الصوت أو الحرارة أو الكهرباء) / انعزال, تقوقع (حالة العزلة أو الانفصال) / عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "断熱的": "أديباتي, كظيم للحرارة (يحدث دون فقدان أو اكتساب للحرارة)\nمثال: تمدد أديباتي",
 "断熱過程": "عملية أديباتية, عملية كظمية ((في الديناميكا الحرارية) أي عملية تحدث دون اكتساب أو فقدان للحرارة)",
 "断片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "断片化": "تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة) / تشظي, تفتت (تناثر شظايا القنبلة بعد انفجارها) / تجزئة ((في علم الحاسوب) حالة الملف المقسم والمخزن في العديد من المواقع المختلفة على قرص ممغنط) / تفتت, شرذمة (تفكك المعايير الاجتماعية التي تحكم السلوك والفكر والعلاقات الاجتماعية)\nمثال: تؤدي التجزئة إلى إبطاء أداء النظام لأنه يستغرق وقتاً إضافياً لتحديد موقع أجزاء الملف المجزأ وتجميعها",
 "断片的": "شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة)",
 "断獄": "اِعْتِقَاد, عَقِيدَة",
 "断種": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "断端": "جُذْمُور, كُنَّاشَة",
 "断絶": "اِنْقِرَاض / فصل, قطع (عملية الفصل أو القطع) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "断続": "تَقَطُّع (صفة كون الشيء متقطعاً؛ خاضعاً للانقطاع أو التوقف الدوري)",
 "断続平衡説": "توازن متقطع, توازن نقطي (نظرية للتطور ترى أن التغيير التطوري في السجل الأحفوري جاء في نوبات وبدايات بدلاً من عملية ثابتة من التغيير البطيء)",
 "断続的": "مُتَقَطِّع / مَوْسِمِيّ",
 "断線": "فصل, قطع الاتصال (عملية قطع الاتصال) / فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً)) / انفصال, تفكك (حالة الانفصال)\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "断罪": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / ضرب العنق, قطع الرأس (القتل بقطع الرأس) / قطع الرأس (الإعدام بقطع رأس الضحية)",
 "断罪者": "مُعَاقِب",
 "断腸": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "断薬": "اِنْسِحَاب",
 "断行": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد)",
 "断裁": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "断裁器": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "断裁機": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "断言": "إقرار, تأكيد (إعلان يتم التأكيد عليه بقوة (كما لو لم تكن هناك حاجة إلى أدلة داعمة)) / إقرار, بيان (فعل تأكيد أو إقرار أو بيان شيء ما)",
 "断言的": "غَيْرُ مَشْرُوط, قَاطِع (غير مقيّد بتحفّظات أو استثناءات) / تصنيفي, فئوي (يتعلق بـ أو مدرج في فئة أو فئات)",
 "断路": "فصل, قطع الاتصال (عملية قطع الاتصال) / فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً)) / انفصال, تفكك (حالة الانفصال)\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "断郊": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "断郊競争": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "断郊競走": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "断面": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم.",
 "断面積": "مَقْطَعِيّ (يُمَثِّل مُسْتَوًى ناتِجًا عَن القَطْع عَرْضِيًّا بِزاوِيَة قائِمَة) / عرضي, مقطعي (من أو يتعلق بمقطع عرضي)\nمثال: شريحة مقطعية",
 "断頭": "ضرب العنق, قطع الرأس (القتل بقطع الرأس) / قطع الرأس (الإعدام بقطع رأس الضحية)",
 "断頭台": "طَابُوقَة",
 "断食": "صَوْم, صِيَام",
 "断食月": "رَمَضَان",
 "断髪": "بُوب",
 "斯うした": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "斯かる": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "斯く": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "斯くて": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "斯くの如き": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "斯くの如く": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "斯くも": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "斯様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "新": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / جدة, حداثة (جودة كون الشيء جديداً؛ عكس القدم) / التَقْوِيم الغَرْبِيّ, التَقْوِيم المِيلَادِيّ",
 "新しい": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "新しく": "حديثاً, طازجاً (مؤخراً جداً)\nمثال: متزوجان حديثاً",
 "新た": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "新エネ": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "新エネルギー": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "新プラトン主義": "أفلاطونية محدثة (نظام من العقائد الفلسفية واللاهوتية يتألف من عناصر الأفلاطونية والأرسطية والتصوف الشرقي؛ مذهبها الأكثر تميزاً يرى أن المبدأ الأول ومصدر الواقع يتجاوز…)\nمثال: كانت الأفلاطونية المحدثة سائدة في أوروبا الوثنية حتى القرن السادس",
 "新ロマン主義": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "新ローマン主義": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "新世界": "الْعَالَم الْجَدِيد",
 "新世界猿": "قرد العالم الجديد (قرود شجرية ذات وجوه مشعرة ولها فتحتا أنف متباعدتان وذيول طويلة عادة ما تكون قابضة)",
 "新世紀世代": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "新人": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن / إنسان عاقل (شبيه البشر الوحيد الباقي؛ النوع الذي ينتمي إليه الإنسان الحديث؛ رئيسيات تسير على قدمين ولها لغة وقدرة على صنع واستخدام أدوات معقدة؛ حجم الدماغ لا يقل…)",
 "新人研修": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة)",
 "新任": "تدشين, تنصيب (التنصيب الاحتفالي في منصب ما) / اسْتِهْلَالِيّ, تَدْشِينِيّ (يَهْدِفُ إِلَى تَحْرِيكِ الأُمُورِ أَوْ إِطْلَاقِهَا) / افتتاحي, تدشيني (يحدث عند أو يميز تنصيباً رسمياً أو تقليد منصب) / خطاب التنصيب (خطاب يلقى في مراسم التنصيب (خاصة من قبل رئيس الولايات المتحدة))\nمثال: استمتع الرئيس الجديد بوضوح بحفل تنصيبه",
 "新伝": "عَصْرِيّ, حَدِيث",
 "新保守主義": "محافظة جديدة (نهج في السياسة أو اللاهوت يمثل عودة إلى وجهة نظر تقليدية (على عكس المدارس الفكرية الأكثر ليبرالية أو راديكالية في الستينيات))",
 "新修": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "新入": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "新入り": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "新入生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ)) / طالب سنة أولى (طالب جامعي في السنة الأولى) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "新兵": "مُجَنَّد",
 "新刊紹介": "مراجعة كتاب (مراجعة نقدية لكتاب (عادة ما يكون كتاباً نُشر حديثاً))",
 "新制中学": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "新制大学": "جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة.",
 "新制高校": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "新印象主義": "انطباعية جديدة (حركة في أواخر القرن التاسع عشر في الرسم الفرنسي سعت لتحسين الانطباعية من خلال نهج منهجي للشكل واللون، باستخدام التقنية التنقيطية بشكل خاص)\nمثال: الانطباعية الجديدة لماكسيميليان لوس ومؤيده روبرت بيرنييه، على سبيل المثال، يجب تمييزها عن تلك الخاصة بسورا ومؤيده غوستاف خان",
 "新参": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "新参者": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "新古典主義": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور جديد أو بدافع جديد)",
 "新古典派": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور جديد أو بدافع جديد)",
 "新古品": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "新味": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / تحفة صغيرة, حلية (صنف صغير غير مكلف يتم إنتاجه بكميات كبيرة) / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)",
 "新品": "جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر)",
 "新地": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "新型コロナウイルス感染症": "كوفيد-19, كوڤيد-19",
 "新報": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "新境地": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "新大陸": "الْعَالَم الْجَدِيد",
 "新天地": "الْعَالَم الْجَدِيد",
 "新奇": "مُسْتَجِدّ / رِوَايَة",
 "新婚初夜": "ليلة الدخلة, ليلة الزفاف (الليلة التالية للزفاف عندما ينام العريس والعروس معاً)",
 "新婚夫婦": "حديث الزواج (شخص تزوج حديثاً)",
 "新婚旅行": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
