 "放送": "إِذَاعَة",
 "放送劇": "دراما إذاعية, مسرح إذاعي (أداء درامي صوتي بحت يبث على الراديو)",
 "放送員": "مُذِيع, مُذِيعَة",
 "放送大学": "الجامعة المفتوحة (جامعة بريطانية مفتوحة للأشخاص الذين ليس لديهم مؤهلات أكاديمية رسمية ويكون التدريس فيها بالمراسلة أو البث أو المدرسة الصيفية)",
 "放送室": "إِسْتُودِيُو",
 "放送局": "محطة بث (محطة مجهزة لبث البرامج الإذاعية أو التلفزيونية)",
 "放送時間": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "放送枠": "فترة زمنية, فسحة زمنية (وقت مخصص في جدول أو أجندة)\nمثال: البرنامج التلفزيوني لديه موعد بث جديد",
 "放送用人工衛星": "سيزيوم (عنصر فلزي ناعم فضي أبيض قابل للسحب (سائل في درجات الحرارة العادية))",
 "放送者": "إِذَاعَة / مُذِيع, مُذِيعَة",
 "放逐": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "放逸": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم",
 "放電": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج) / تفريغ كهربائي (تفريغ للكهرباء)",
 "放電灯": "مصباح تفريغ (مصباح يولد الضوء عن طريق تفريغ كهربائي بين قطبين في غاز)",
 "放飼": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "放鷹": "صَقَارَة",
 "政": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "政体": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "政倫審": "لجنة الأخلاقيات (لجنة معينة للنظر في القضايا الأخلاقية)",
 "政党": "حِزْب, حِزْب سِيَاسِيّ (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "政客": "سِيَاسِيّ, سِيَاسِيَّة",
 "政庁": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "政府": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "政府機関": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "政権": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "政権を握る": "تَوَلَّى السُلْطَة, جَاءَ إِلَى السُلْطَة",
 "政権交代": "تَغْيِير اَلْنِظَام",
 "政権公約": "بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "政治": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "政治とカネ": "كْلِيبْتُقْرَاطِيَّة",
 "政治システム": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "政治上": "سِيَاسِيّ / سياسياً (فيما يتعلق بالحكومة) / سياسياً (فيما يتعلق بالعلاقات الاجتماعية التي تنطوي على السلطة)\nمثال: وحدات منظمة سياسياً",
 "政治亡命": "لُجُوء سِيَاسِيّ",
 "政治体制": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "政治保護": "لُجُوء سِيَاسِيّ",
 "政治制度": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "政治囚": "سَجِين سِيَاسِيّ, مُعْتَقَل سِيَاسِيّ",
 "政治学": "عُلُوم سِيَاسِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "政治学者": "عَالِم سِيَاسِيّ, عَالِمَة سِيَاسِيَّة (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "政治家": "سِيَاسِيّ, سِيَاسِيَّة",
 "政治局": "مَكْتَب سِيَاسِيّ (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "政治屋": "سِيَاسِيّ, سِيَاسِيَّة",
 "政治犯": "سَجِين سِيَاسِيّ, مُعْتَقَل سِيَاسِيّ",
 "政治献金": "تبرع سياسي (مساهمة تُقدم لسياسي أو حملة سياسية أو حزب سياسي)",
 "政治理論": "أيديولوجيا, توجه سياسي (توجه يميز تفكير مجموعة أو أمة)",
 "政治的": "سِيَاسِيّ",
 "政治的に正しい": "صائب سياسيا (يظهر الصواب السياسي)",
 "政治的指導者": "سياسي (شخص نشط في السياسة الحزبية)",
 "政治経済学": "اقتصاد, علم الاقتصاد (فرع العلوم الاجتماعية الذي يتعامل مع إنتاج وتوزيع واستهلاك السلع والخدمات وإدارتها)",
 "政治行動委員会": "لجنة العمل السياسي (لجنة تشكلها مجموعة مصالح خاصة لجمع الأموال لمرشحيها السياسيين المفضلين)",
 "政治要綱": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "政治運動": "حملة انتخابية (حملة المرشح ليتم انتخابه) / حملة, حملة سياسية (سباق بين المرشحين لمنصب منتخب)\nمثال: أدرت حملته لمنصب الحاكم",
 "政界": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "政略": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "政略結婚": "زَوَاج مَصْلَحَة",
 "政策": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر) / سَنَد تَأْمِين ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً)\nمثال: عاد إلى السياسة.",
 "政策官庁": "مَعْنِيّ بِرَسْم السِّيَاسَات (يهتم بالسياسات العامة لا بالإدارة التنفيذية)",
 "政策方針": "خط مشترك (خط هاتف يخدم مشتركين اثنين أو أكثر) / خط الحزب (سياسة مجموعة سياسية)\nمثال: فاز في تصويت على أساس خطوط الحزب",
 "政策決定者": "صَانِعُ سِيَاسَة (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "政策決定過程": "مَعْنِيّ بِرَسْم السِّيَاسَات (يهتم بالسياسات العامة لا بالإدارة التنفيذية)",
 "政策研究大学院大学": "مَقْبِض",
 "政策立案者": "صانع القرار, واضع السياسات (شخص يضع الخطة التي تتبعها حكومة أو شركة وما إلى ذلك)\nمثال: غالباً ما يتخذ صناع القرار القرار الصحيح لسبب خاطئ",
 "政道": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "故": "مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / بِسَبَب, بِحُكْم / عَمْدًا / خُصُوصًا, خَاصَّةً / سَابِق / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "故なしとしない": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "故に": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "故事": "تَقْلِيد",
 "故事来歴": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "故人": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "故意": "نِيَّة / قصد جنائي, نية جرمية ((قانون) النية الإجرامية؛ الأفكار والنوايا وراء فعل خاطئ (بما في ذلك المعرفة بأن الفعل غير قانوني))",
 "故意に": "عُمْداً",
 "故殺": "قتل خطأ, قتل غير متعمد (قتل دون سبق إصرار وترصد)",
 "故無しとしない": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "故買": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "故買者": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "故郷": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / خَرَاب, خَرَابَة / دَمَّرَ",
 "故障": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة. / تَمْرِين / مَسْأَلَة / اِعْتَرَاض / اِعْتِرَاض",
 "故障中": "مُعَطَّل",
 "故障車": "مُعَطَّل",
 "敏": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "敏い": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "敏し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "敏感": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "敏捷": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة) / رَشِيق الذِّهْن, سَرِيعُ الْبَدِيهَة (سريع الفهم والاستيعاب ذهنيًّا) / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "敏捷力": "براعة يدوية, خفة يد (البراعة في استخدام اليدين)",
 "敏捷性": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "敏活": "سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "敏腕": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "敏速": "سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "救い": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / خَلَاص, تَطْهِير اَلنَّفْس",
 "救いの手": "مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "救いようのない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "救い主": "مُخَلِّص, مُنْقِذ (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص / مَسِيح",
 "救い出す": "أَنْقَذَ, خَلَّصَ / إِنْقَاذ",
 "救い様のない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "救う": "أَنْقَذَ, خَلَّصَ / إِنْقَاذ / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "救われない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "救世": "خَلَاص, تَطْهِير اَلنَّفْس",
 "救世主": "مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر) / مَسِيح",
 "救世軍": "جيش الخلاص (منظمة خيرية ودينية للتبشير ورعاية الفقراء والمشردين)",
 "救出": "أَنْقَذَ, خَلَّصَ / إِنْقَاذ",
 "救助": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "救助活動": "عملية إنقاذ (عملية منظمة للتحرير من الخطر أو الحبس)",
 "救助網": "شبكة أمان (شبكة قوية كبيرة لالتقاط لاعبي سيرك الأكروبات الذين يسقطون أو يقفزون من الأرجوحة) / شَبَكَة أَمَان (ضمان للأمن المهني أو المالي)",
 "救助船": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救助艇": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救命": "إنقاذ الغرقى (إنقاذ حياة الغرقى)\nمثال: أخذ دورة في إنقاذ الغرقى",
 "救命いかだ": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "救命ボート": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救命救急士": "مُسْعِف, مُسْعِفة",
 "救命桴": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "救命筏": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "救命索": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق) / حبل الغواص (حبل يرفع أو ينزل غواص أعماق البحار) / شريان حياة, طوق نجاة (دعم يمكن الناس من البقاء أو الاستمرار في فعل شيء ما (غالباً من خلال توفير اتصال أساسي)) / خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)\nمثال: وفر الجسر الجوي شريان حياة لبرلين",
 "救命胴衣": "سُتْرَة نَجَاة, صِدَار نَجَاة (ضرب من اللِبَاس الخارجي، عبارة عن ثوب قصير يصل إلى الخصر مفتوح من أمام ويُزَرَّر له أكمام طويلة ويَاقَة؛ في إحدى مدن البحرين)\nمثال: أحتاج سترة جديدة",
 "救命艇": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救急": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "救急医療": "طب الطوارئ (فرع الطب المعني بالتشخيص والعلاج الفوري للإصابات أو الصدمات أو المرض المفاجئ)",
 "救急医療室": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين يحتاجون إلى علاج طبي فوري)",
 "救急所": "محطة إسعافات أولية (محطة تقدم الرعاية الطارئة أو العلاج قبل التمكن من الحصول على المساعدة الطبية المنتظمة)",
 "救急救命士": "مُسْعِف, مُسْعِفة",
 "救急救命室": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين يحتاجون إلى علاج طبي فوري)",
 "救急科": "الطَوَارِئ",
 "救急箱": "حقيبة إسعافات أولية (مجموعة تتكون من ضمادات وأدوية لتقديم الإسعافات الأولية)",
 "救急自動車": "سَيَّارَة إِسْعَاف (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "救急車": "سَيَّارَة إِسْعَاف (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "救急隊員": "مُسْعِف, مُسْعِفة",
 "救恤": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "救援": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "救援投手": "رامي الإغاثة, رامٍ بديل (رامٍ لا يبدأ المباراة بل يدخل كبديل)",
 "救援活動": "عملية إنقاذ (عملية منظمة للتحرير من الخطر أو الحبس)",
 "救援軍": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "救援隊": "فريق الإنقاذ (مجموعة من المنقذين)",
 "救済": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / خَلَاص, تَطْهِير اَلنَّفْس",
 "救済者": "مُخَلِّص, مُنْقِذ (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "救護": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "救護所": "محطة إسعافات أولية (محطة تقدم الرعاية الطارئة أو العلاج قبل التمكن من الحصول على المساعدة الطبية المنتظمة)",
 "救護班": "فريق الإنقاذ (مجموعة من المنقذين)",
 "救貧法": "قانون الفقراء (قانون يوفر الدعم للفقراء)",
 "救貧院": "ملجأ الفقراء (مؤسسة تدار على نفقة الدولة لتوفير السكن للفقراء والمشردين)",
 "救難": "أَنْقَذَ, خَلَّصَ / إِنْقَاذ",
 "救難信号": "إشارة استغاثة, نداء استغاثة (إشارة معترف بها دولياً ترسلها سفينة أو طائرة تفيد بالحاجة إلى المساعدة)",
 "敗": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "敗る": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "敗れ": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "敗れる": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "敗亡": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "敗余": "مَغْلُوب",
 "敗北": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "敗北主義": "انهزامية (قبول حتمية الهزيمة)",
 "敗北主義者": "انهزامي, سلبي (شخص يستسلم للهزيمة دون تقديم اقتراحات إيجابية)",
 "敗北者": "خَاسِر / فَاشِل",
 "敗戦": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "敗残": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "敗者": "خَاسِر / فَاشِل",
 "敗者復活": "رِيمُونْتَادَا / جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق النهائي)",
 "敗者復活戦": "جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق النهائي)",
 "敗肉": "جِيفة, فَطِيسَة",
 "敗血症": "تَلَوُّث اَلْدَم (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "敗血症性": "إنتاني, متقيح (يحتوي على كائنات مسببة للأمراض أو ناتج عنها) / إنتاني, تعفني (من أو يتعلق بالتعفن أو ناتج عنه)\nمثال: التهاب حلق إنتاني",
 "敗衄": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "敗走": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "敗軍": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "教": "ـِيَّة",
 "教え": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "教えさとす": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "教える": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / خَطَبَ, وَعَظَ (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد) / كَرَزَ\nمثال: أخبرني ما الخطب.",
 "教え導く": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教え諭す": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "教え魔": "متعالم, مدعي المعرفة (شخص يظن أنه يعرف كل شيء ويرفض قبول النصيحة أو المعلومات من الآخرين)",
 "教わる": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "教会": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "教会員": "مواظب على الكنيسة (شخص متدين يذهب إلى الكنيسة بانتظام)",
 "教会堂": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "教会学校": "مدرسة أبرشية, مدرسة كنسية (مدرسة دينية خاصة تديرها كنيسة أو أبرشية)",
 "教会旋法": "مقام كنسي (أي من نظام المقامات المستخدمة في التراتيل الغريغورية حتى عام 1600؛ مشتق تاريخياً من المقام اليوناني)",
 "教会暦": "تقويم كنسي (تقويم للسنة المسيحية يشير إلى تواريخ الصيام والأعياد)",
 "教会法": "قانون كنسي (مجموعة القوانين المدونة التي تحكم شؤون الكنيسة المسيحية)",
 "教会管区": "أبرشية كبرى, مقاطعة كنسية (المنطقة الخاضعة لولاية رئيس أساقفة أو مطران أو أحد التقسيمات الإقليمية لنظام كنسي)\nمثال: الولايات المتحدة مقسمة إلى 33 مقاطعة كنسية",
 "教会音楽": "موسيقى دينية, موسيقى كنسية (نوع من الموسيقى المؤلفة للأداء كجزء من الاحتفالات الدينية)",
 "教典": "أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "教則本": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ",
 "教化": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / تَعْلِيم, ثَقَافَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم. / إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "教区": "أبرشية / رَعِيَّة",
 "教区学校": "مدرسة أبرشية, مدرسة كنسية (مدرسة دينية خاصة تديرها كنيسة أو أبرشية)",
 "教区民": "أبناء الرعية (عضو في رعية)",
 "教員": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教唆": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث) / تَحْرِيض",
 "教唆者": "مُحَرِّض, مُحَرِّضَة",
 "教場": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "教壇": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "教壇に立つ": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教委": "مجلس التعليم, مجلس المدرسة (مجلس مسؤول عن المدارس العامة المحلية)",
 "教子": "ابن بالمعمودية, ابنة بالمعمودية (رضيع يكفله شخص بالغ (العراب) عند المعمودية)",
 "教官": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教宣": "دِعَايَة, بْرُوبَاغَنْدَا",
 "教室": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "教導": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "教師": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教師役": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教徒": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "教戒": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل) / إِنْذَار, تَحْذِير (توبيخ حازم)",
 "教戒師": "قِسِّيس, قَسّ (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "教授": "أُسْتَاذ, مُعَلِّم (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "教授法": "مهنَة التدريس, تَعْلِيم",
 "教授陣": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "教旨": "مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: الوجودية مذهب إنساني.",
 "教書": "رِسَالَة, خَبَر / ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة) / مَرْسُوم\nمثال: حرث ما حرث الثور. / كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "教本": "كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "教条": "دوغما, عقيدة (عقيدة دينية تُعلن كحقيقة دون برهان)",
 "教条主義": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "教母": "عَرَّابَة, إِشْبِينَة",
 "教法": "بيداغوجيا, طريقة تدريس (مبادئ وطرق التعليم)",
 "教派": "فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني.",
 "教父": "عَرَّاب, إِشْبِين (عامل العَرَبَات؛ عند النصارى: كفيل الطفل المعتمد)\nمثال: العراب هو فيلمي المفضل. / أب الكنيسة ((في المسيحية) أي من حوالي 70 لاهوتياً في الفترة من القرن الثاني إلى السابع أسست كتاباتهم العقيدة الرسمية للكنيسة وأكدتها)",
 "教父学": "باترولوجيا, علم الآباء (دراسة حياة وكتابات ومذاهب آباء الكنيسة) / علم الآباء, كتابات الآباء (كتابات آباء الكنيسة الأوائل)",
 "教理": "مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: الوجودية مذهب إنساني.",
 "教生": "طالب معلم (طالب جامعي يقوم بالتدريس تحت إشراف معلم معتمد للتأهل للحصول على درجة في التعليم)",
 "教皇": "بَابَا / حَبْر أَعْظَم ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / حَبْر ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / الْبَابَا, الْأَب\nمثال: لا تكتب بالحبر.",
 "教皇の座": "اَلْكُرْسِيّ اَلرَّسُولِيّ",
 "教皇庁": "الكوريا, الكوريا الرومانية ((الكنيسة الرومانية الكاثوليكية) الإدارة المركزية التي تحكم الكنيسة الرومانية الكاثوليكية)",
 "教皇領": "دَوْلَة الْكَنِيسَة, الدَّوْلَة الْبَابَوِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "教示": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "教科": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "教科書": "كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "教科用図書": "كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "教程": "مَنْهَج, مَنْهَج دِرَاسِيّ",
 "教範": "بيداغوجيا, طريقة تدريس (مبادئ وطرق التعليم)",
 "教練": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود.",
 "教練教官": "مدرب عسكري, مدرب مشاة (ضابط صف يدرب المجندين على السير العسكري والانضباط)",
 "教義": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول)",
 "教義学": "عَقَائِدِي",
 "教習": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "教習所": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "教習生": "مُتَدَرِّب, مُتَدَرِّبَة",
 "教者": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教職員": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "教育": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / تَعْلِيم, ثَقَافَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم. / ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "教育制度": "نظام مدرسي (مؤسسة تشمل المنشآت والمعدات لتوفير التعليم من رياض الأطفال حتى المدرسة الثانوية)",
 "教育委員会": "مجلس التعليم, مجلس المدرسة (مجلس مسؤول عن المدارس العامة المحلية)",
 "教育学": "مهنَة التدريس, تَعْلِيم",
 "教育実習生": "طالب معلم (طالب جامعي يقوم بالتدريس تحت إشراف معلم معتمد للتأهل للحصول على درجة في التعليم)",
 "教育家": "مُعَلِّم, مُؤَدِّب (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教育施設": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "教育機関": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "教育法": "بيداغوجيا, طريقة تدريس (مبادئ وطرق التعليم)",
 "教育現場": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "教育的": "تَعْلِيمِيّ",
 "教育省": "وزارة التعليم (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية المتعلقة بالتعليم (بما في ذلك المساعدات الفيدرالية للمؤسسات التعليمية والطلاب)؛ أنشئت…)",
 "教育者": "مُعَلِّم, مُؤَدِّب (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教育課程": "مَنْهَج, مَنْهَج دِرَاسِيّ",
 "教訓": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس.",
 "教訓を垂れる": "مُحَاضَرَة",
 "教訓的": "إرشادي, تثقيفي (يخدم غرض التعليم أو التنوير أو الإعلام)",
 "教誡": "إِنْذَار, تَحْذِير (توبيخ حازم)",
 "教誨": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل)",
 "教誨師": "قِسِّيس, قَسّ (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "教諭": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教護院": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "教鞭をとる": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教鞭を取る": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教鞭を執る": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教養": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "教養のない": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "教養人": "رَاقٍ, مُثَقَّف (على درجة عالية من الثقافة أو التعليم) / مثقف رفيع, نخبوي (شخص ذو أذواق فكرية أو علمية رفيعة)",
 "教養番組": "برنامج تعليمي (برنامج لتوفير التعليم)",
 "敝履": "بَالٍ",
 "敝衣": "بَالٍ",
 "敢えて": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "敢えない": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "敢えなく": "بشكل محزن, للأسف (بطريقة مؤسفة) / بشكل مؤسف, بشكل محزن (بطريقة مؤسفة أو تدعو للرثاء) / بحزن (مع الحزن؛ بطريقة حزينة)\nمثال: للأسف مات قبل أن يتمكن من رؤية حفيده",
 "敢え無い": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "敢え無く": "بشكل محزن, للأسف (بطريقة مؤسفة) / بشكل مؤسف, بشكل محزن (بطريقة مؤسفة أو تدعو للرثاء) / بحزن (مع الحزن؛ بطريقة حزينة)\nمثال: للأسف مات قبل أن يتمكن من رؤية حفيده",
 "敢ない": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "敢為": "جَرِيء, جَسُور",
 "敢無く": "بشكل محزن, للأسف (بطريقة مؤسفة) / بشكل مؤسف, بشكل محزن (بطريقة مؤسفة أو تدعو للرثاء) / بحزن (مع الحزن؛ بطريقة حزينة)\nمثال: للأسف مات قبل أن يتمكن من رؤية حفيده",
 "敢然": "بجرأة\nمثال: يجب أن نعالج هذه المهام بجرأة",
 "敢行": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "散": "قِرْش, عُمْلَة",
 "散々": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها / مُتَفَرِّق",
 "散々っぱら": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "散々ぱら": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "散じる": "نَثَرَ, تَفَرَّقَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "散ずる": "نَثَرَ, تَفَرَّقَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "散らし": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة) / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "散らす": "نَثَرَ, تَفَرَّقَ / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / أَلْهَى",
 "散らばら": "هُنَا وَهُنَاكَ",
 "散り": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "散りばめる": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها)",
 "散り散り": "مُتَفَرِّق",
 "散る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / نَثَرَ, تَفَرَّقَ / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "散乱": "تَشَتُّت",
 "散会": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / تأجيل, رفع الجلسة (فعل التأجيل إلى وقت أو مكان آخر)",
 "散光星雲": "سديم غازي, سديم منتشر (عنقود من النجوم داخل سحابة معقدة من الغاز والغبار)",
 "散兵": "مناوش",
 "散在": "شرذمة, مجموعة متفرقة (تجمع متجول أو غير منظم (لأشياء أو أشخاص))\nمثال: مجموعة متناثرة من المباني الملحقة",
 "散大": "تمدد, توسع (عملية توسيع فتحة) / إطناب, توسع (مناقشة مطولة (منطوقة أو مكتوبة) حول موضوع معين)\nمثال: توسع حدقة العين",
 "散布": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "散布度": "عَدَم الصِّلَة, عَدَم العَلَاقَة (عدم وجود علاقة لشيء ما بالموضوع المطروح)",
 "散布量": "عَدَم الصِّلَة, عَدَم العَلَاقَة (عدم وجود علاقة لشيء ما بالموضوع المطروح)",
 "散弾": "طَلَقَة, طَلَق / رَمْيَة / لَقْطَة / حُقْنَة, حَقْن",
 "散弾銃": "بندقية خرطوش, بندقية صيد (سلاح ناري يُحمل على الكتف مزدوج السبطانة أملس الجوف لإطلاق الخردق في مديات قصيرة)",
 "散形花序": "خيمة, نورة خيمية (نورة مسطحة القمة أو مستديرة تميز الفصيلة الخيمية حيث تنشأ سيقان الزهور الفردية من نفس النقطة تقريبًا؛ الزهور الأصغر سنًا تكون في المركز)",
 "散房花序": "عذق, نورة عذقية (نورة مسطحة القمة أو محدبة تنمو فيها سيقان الزهور الفردية للأعلى من نقاط مختلفة على الساق الرئيسية لتصل إلى نفس الارتفاع تقريبًا؛ الزهور الخارجية تفتح…)",
 "散散": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها / مُتَفَرِّق",
 "散文": "نَثْر",
 "散文的": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / رَتِيب, عَادِيّ (يفتقر إلى الظرف والخيال) / نَثْرِيّ, وَاقِعِيّ (خالٍ من الخيال أو التصوّر الإبداعي)",
 "散文詩": "قصيدة نثر (نثر يشبه الشعر)",
 "散歩": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "散歩道": "تجوال, تنزة (مشي متمهل (عادة في مكان عام)) / موكب الافتتاح (مسير لجميع الضيوف في افتتاح رقصة رسمية) / برومناد (شكل في رقص المربعات؛ يسير الأزواج عكس اتجاه عقارب الساعة في دائرة) / متنزه, ممشى (منطقة عامة مخصصة كممشى للمشاة)",
 "散漫": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "散発": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "散発的": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "散瞳": "توسع الحدقة (توسع انعكاسي للحدقة حيث تسحب العضلة القزحية للخارج؛ يحدث استجابة لانخفاض الضوء أو أدوية معينة)",
 "散瞳薬": "دواء موسع للحدقة, موسع الحدقة (دواء يسبب توسع حدقة العين؛ يستخدم للمساعدة في فحوصات العين)",
 "散積": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "散積み": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "散策": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "散財": "عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل) / إسراف استعراضي (عرض متباه (للجهد أو الإسراف، إلخ.))\nمثال: نوبة إفراط في التسوق",
 "散逸": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "散銭": "قِرْش, عُمْلَة",
 "散開": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "散髪": "حَلَاقَة",
 "散髪屋": "حَلَّاق / حلاقَة",
 "敦朴": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "敦樸": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "敦睦": "حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما)",
 "敬": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "敬い": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "敬う": "وَقَّرَ",
 "敬す": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "敬する": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "敬仰": "توقير, عبادة (العبادة المقدمة لله وحده) / تبجيل, عشق (فعل الإعجاب بشدة) / عبادة, هيام (شعور بالحب العميق والإعجاب)",
 "敬具": "اَلْمُخْلِص",
 "敬意": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "敬畏": "هَيْبَة / ذُهُول",
 "敬白": "اَلْمُخْلِص",
 "敬礼": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "敬神": "تَقْوَى / بِرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "敬虔": "صَالِح, وَرِع ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "敬虔主義": "تزمت ديني, غلو في الدين (تقوى مصطنعة أو مبالغ فيها وحماسة دينية) / التقوية (حركة ألمانية في القرن السابع عشر والثامن عشر في الكنيسة اللوثرية تشدد على التقوى الشخصية والعبادة)",
 "敬語": "تَشْرِيفِيّ, تَكْرِيمِيّ (يمنح أو يُظهر الشرف والاحترام) / لقب تشريف (تعبير عن الاحترام)\nمثال: يستخدم اليابانيون العديد من ألقاب التشريف",
 "敬譲語": "تَشْرِيفِيّ, تَكْرِيمِيّ (يمنح أو يُظهر الشرف والاحترام) / لقب تشريف (تعبير عن الاحترام)\nمثال: يستخدم اليابانيون العديد من ألقاب التشريف",
 "敬遠": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "数": "كَثِيرًا, غَالِبًا / عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب. / عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "数々": "كَثِيرًا, غَالِبًا / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "数ある": "عَدِيد, كَثِير",
 "数えきれない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
