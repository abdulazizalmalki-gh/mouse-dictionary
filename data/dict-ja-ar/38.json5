 "旅行先": "وِجْهَة, وُجْهَة",
 "旅行客": "سَائِح, سَائِحَة",
 "旅行家": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "旅行小切手": "شيك سياحي, شيك مسافر (خطاب اعتماد يصدره بنك أو شركة شحن سريع يكون قابلاً للدفع عند تقديمه لأي مراسل للمصدر)",
 "旅行日程": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "旅行案内": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "旅行案内書": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "旅行業者": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "旅行業者代理業": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "旅行社": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "旅行者": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "旅行者用小切手": "شيك سياحي, شيك مسافر (خطاب اعتماد يصدره بنك أو شركة شحن سريع يكون قابلاً للدفع عند تقديمه لأي مراسل للمصدر)",
 "旅行計画": "خطة سفر, مسار رحلة (مسار مقترح للسفر)",
 "旅行鞄": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "旅行鳩": "حمام مهاجر (حمامة مهاجرة اجتماعية من أمريكا الشمالية منقرضة الآن)",
 "旅費": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل)",
 "旅路": "رِحْلَة, سَفَر",
 "旅鴉": "هَائِم / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "旅鼠": "لاموس, ليمونغ (أي من القوارض قصيرة الذيل ومكسوة القدمين بالفراء، تنتشر في المناطق القطبية)",
 "旋削": "تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "旋回": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "旋律": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "旋条": "تحزيز, ششخانة (قطع أخاديد حلزونية داخل ماسورة سلاح ناري)",
 "旋毛曲がり": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "旋毛虫": "تريكينا (نيماتودا طفيلية توجد في أمعاء الخنازير والجرذان والبشر وتنتج يرقات تشكل أكياساً في العضلات الهيكلية)",
 "旋毛虫症": "ترايكينوسس, داء الشعرينات (الإصابة بيرقات الترايكينة التي تنتقل عن طريق تناول اللحوم غير المطهية جيداً (خاصة لحم الخنزير)؛ تهاجر اليرقات من الجهاز الهضمي إلى العضلات حيث تتكيس)",
 "旋法": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / مِنْوَال\nمثال: لقد أزمت الوضع.",
 "旋盤": "مِخْرَطَة",
 "旋転": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "旋風": "زَوْبَعَة / حَاسَّة, حِسّ",
 "旌": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "族": "قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / طَرَف / حَفْلَة, اِحْتِفَال / ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "族内婚": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون)",
 "族外婚": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "族縁": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "族長": "بَطْرِيَرْك, بَطْرَك / شَيْخ, بَطْرِيَرْك",
 "旗": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗ざお": "سارية العلم (عمود طويل أو سارية يرفع عليها العلم) / أرابيس, رشاد الصخر (أي من عدة نباتات رشاد محبة للصخور من جنس أرابيس)",
 "旗じるし": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗下": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "旗亭": "مَطْعَم",
 "旗印": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗幟": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / مَوْقِف",
 "旗弁": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "旗手": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة) / حامل اللواء (قائد بارز لحركة سياسية)",
 "旗持": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة) / حامل اللواء (قائد بارز لحركة سياسية)",
 "旗持ち": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة) / حامل اللواء (قائد بارز لحركة سياسية)",
 "旗振り": "بادئ (مزرعة تحتوي على خميرة أو بكتيريا تستخدم لبدء عملية التخمير أو التحمض في صنع الزبدة أو الجبن أو العجين) / ذراع تدوير, مرفق تدوير (أداة يدوية تتكون من عمود دوار بمقبض مواز) / بادئ التشغيل, مارش (محرك كهربائي لبدء تشغيل المحرك) / فاتح للشهية, مقبلات (طعام أو شراب لتحفيز الشهية (يُقدم عادة قبل الوجبة أو كطبق أول))\nمثال: لصنع العجين المخمر تحتاج إلى بادئ",
 "旗振り役": "مُبَادِر",
 "旗旒信号": "إشارة العلم, الإشارة بالأعلام (أي من الطرق المتنوعة لاستخدام الأعلام أو الرايات لإرسال الإشارات)\nمثال: سمحت إشارات العلم بالاتصال عن بعد قبل اختراع الراديو وما زالت تستخدم خاصة فيما يتعلق بالسفن",
 "旗日": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "旗本": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "旗標": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗竿": "سارية العلم (عمود طويل أو سارية يرفع عليها العلم) / أرابيس, رشاد الصخر (أي من عدة نباتات رشاد محبة للصخور من جنس أرابيس)",
 "旗艦": "سَفِينَةُ الْقَائِد, سَفِينَةُ الْقِيَادَة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "旗色": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "旗門": "بَوَّابَة",
 "旗頭": "قَائِد, زَعِيم",
 "旗魚": "مارلين (أسماك رياضة محيطية كبيرة طويلة الفك؛ ترتبط بأسماك الشراع وأسماك الرمح؛ ليست من ذوات الدم البارد تماماً أي قادرة على تدفئة أدمغتها وعيونها)",
 "旗魚座": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "旗鼓": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "旗鼓堂々": "بانتصار, بزهو (بطريقة منتصرة)\nمثال: صرخت بانتصار",
 "旗鼓堂堂": "بانتصار, بزهو (بطريقة منتصرة)\nمثال: صرخت بانتصار",
 "既に": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / قَبْلًا, قَبْل / بلا ريب, مما لا يمكن إنكاره (إلى درجة لا يمكن إنكارها أو بطريقة لا تقبل الإنكار)\nمثال: هي بلا ريب الطالبة الأكثر موهبة في الصف",
 "既にして": "في غضون ذلك, في هذه الأثناء (خلال الوقت الفاصل)\nمثال: في غضون ذلك لن أفكر في المشكلة",
 "既の事": "تَقْرِيبًا, عَلَى وَشْك",
 "既判力": "قضية مقضية (مسألة تم تسويتها بالفعل في المحكمة ولا يمكن إثارتها مرة أخرى)",
 "既卒者": "طَالِب, طَلَبَة / خِرِّيج, خِرِّيجُون",
 "既女": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "既婚": "مُتَزَوِّج, مُتَأَهِّل",
 "既婚女性": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "既婚男性": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "既婚者": "زوج, شريك حياة (شريك الشخص في الزواج)",
 "既存": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي",
 "既定": "مُتَرَسِّخ",
 "既往": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "既往歴": "تاريخ الحالة, سجل الحالة (سجل مفصل لخلفية شخص أو مجموعة قيد الدراسة أو العلاج)",
 "既往症": "سِيرَة مَرْضِيَة",
 "既得": "ثَابِت, مُكْتَسَب (مُحَدَّدٌ وَمُطْلَقٌ وَغَيْرُ مَشْرُوطٍ)",
 "既得権益": "مصلحة خاصة, مصلحة راسخة (مجموعات تسعى للسيطرة على نظام اجتماعي أو نشاط تستمد منه منفعة خاصة) / حق مكتسب, مصلحة مكتسبة ((قانون) مصلحة يوجد فيها حق ثابت في التمتع الحالي أو المستقبلي والتي يمكن نقلها إلى شخص آخر)",
 "既成": "مُتَرَسِّخ",
 "既成事実": "أَمْر وَاقِع (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "既成概念": "صُورَة نَمَطِيَّة",
 "既成観念": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "既払い": "مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا)",
 "既決": "مَلْحُوظ, وَاضِح (يُمْكِنُ تَمْيِيزُهُ؛ بَارِزٌ وَجَلِيّ) / أَدَانَ / سَجِين, مُدَان",
 "既決囚": "أَدَانَ / سَجِين, مُدَان",
 "既済": "مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا)",
 "既男": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "既知": "مَعْلُوم",
 "既約": "غير قابل للاختزال (غير قادر على أن يتم جعله أصغر أو أبسط)\nمثال: حد أدنى غير قابل للاختزال",
 "既製": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "既製品": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "既製服": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "既視感": "دِيجَا ڤُو",
 "既設": "مُتَرَسِّخ",
 "既述": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "既遂": "مُرْتَبِط, مُلْتَزِم (مرتبط في علاقة جنسية حصرية) / ملتزم (مقيد أو ملزم، كما هو الحال بموجب تعهد لقضية أو عمل أو موقف معين)\nمثال: أعضاء كنيسة ملتزمون",
 "日": "يَوْم, نَهَار (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل. / شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.\nمثال: この部屋はあまり日が当たらない。 — لا تشع الشمس على هذه الغرفة كثيراً. / تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام / الْأَحَد, يَوْم الْأَحَد / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "日々": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم",
 "日々草": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "日かげ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "日がさ": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "日がな一日": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "日がな１日": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "日が射す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "日が差す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "日が暮れる": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "日ぎめ": "يَوْمِيًّا (واحد كل يوم)\nمثال: سنوفر 100 ساعة عمل يومياً",
 "日ぐれ": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "日ごと": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
