{
 "廻文": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / قَلْب مُسْتَوٍ",
 "廻旋": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "廻旋曲": "روندو (شكل موسيقي غالباً ما يكون الحركة الأخيرة للسوناتا)",
 "廻漕": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "廻状": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "廻章": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "廻縁": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "廻航": "مِلَاحَة",
 "廻船": "سفينة بضائع, سفينة شحن (سفينة مصممة لحمل البضائع)",
 "廿": "عِشْرُونَ",
 "廿日大根": "فُجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "廿日鼠": "فأر المنزل (فأر بني رمادي من العالم القديم أصبح الآن آفة منزلية شائعة في جميع أنحاء العالم)",
 "弁": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / بِنْتُو / بَتَلَة, تُوَيْجَة",
 "弁え": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة / عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "弁える": "مَيَّزَ / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس.",
 "弁じる": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "弁ずる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "弁償": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "弁償金": "إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ) / إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تعويضات الحرب ((عادة بصيغة الجمع) تعويض يفرضه المنتصرون على دولة مهزومة) / إصلاح, جبر الضرر (تعويض (مُعطى أو مُستلم) عن إهانة أو إصابة)\nمثال: كيف يمكنني التكفير عن خطئي",
 "弁別": "تَمْيِيْز",
 "弁別的": "مُمَيَّز, نَمُوذَجِيّ (خاصّ بسمة تساعد في التمييز بين الأشخاص أو الأشياء) / قَابِل لِلتَّصْنِيف (يمكن تصنيفه ضمن فئات)",
 "弁別的特徴": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "弁別的素性": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "弁別素性": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "弁別閾": "عتبة الفارق, عتبة تفاضلية (أصغر تغيير في التحفيز يمكن للشخص اكتشافه)",
 "弁務官": "مُفَوَّض, مُفَوَّضَة",
 "弁口": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "弁士": "مُحَاضِر, مُحَاضِرَة",
 "弁当": "بِنْتُو",
 "弁当箱": "صندوق الغداء (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)",
 "弁慶": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "弁慶の泣き所": "عَقِب أَخِيل, كَعْب أَخِيل",
 "弁慶格子": "ترتان, قماش كاروهات (قماش ذو تصميم متقاطع)",
 "弁慶縞": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "弁慶草": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "弁才": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
