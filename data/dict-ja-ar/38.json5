 "惚れた腫れた": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ",
 "惚れる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "惚れ惚れ": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "惚れ薬": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "惜": "وَا حَسْرَتَاه, وَاهًا",
 "惜しい": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ) / ثَمِين / تَقْرِيبًا, عَلَى وَشْك",
 "惜しくも": "بكل أسف, لسوء الحظ (بسبب سوء الحظ)\nمثال: لسوء الحظ أمطرت طوال اليوم",
 "惜しげ": "تثاقل, تردد (درجة معينة من عدم الرغبة) / ممانعة مغناطيسية ((في الفيزياء) ممانعة للفيض المغناطيسي (مناظرة للمقاومة الكهربائية))\nمثال: ممانعة في إلزام نفسه",
 "惜しげなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜しげもなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜しげも無く": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜しげ無く": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜しみない": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "惜しみなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜しみ無い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "惜しみ無く": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜しむ": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه. / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح. / قِيمَة / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "惜しむべき": "مُؤْسِف",
 "惜し気": "تثاقل, تردد (درجة معينة من عدم الرغبة) / ممانعة مغناطيسية ((في الفيزياء) ممانعة للفيض المغناطيسي (مناظرة للمقاومة الكهربائية))\nمثال: ممانعة في إلزام نفسه",
 "惜し気なく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜し気もなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜し気も無く": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜し気無く": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惜気": "تثاقل, تردد (درجة معينة من عدم الرغبة) / ممانعة مغناطيسية ((في الفيزياء) ممانعة للفيض المغناطيسي (مناظرة للمقاومة الكهربائية))\nمثال: ممانعة في إلزام نفسه",
 "惜気もなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "惟神の道": "شِنْتَوِيَّة, شِنْتُو",
 "惟神道": "شِنْتَوِيَّة, شِنْتُو",
 "惡": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "惣嫁": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "惣菜": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "惨": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "惨い": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مَأْسَاوِيّ, تْرَاجِيدِيّ",
 "惨たらしい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "惨め": "بَائِس",
 "惨めったらしい": "بَائِس",
 "惨事": "كَارِثَة, مُصِيبَة",
 "惨劇": "مَأْسَاة, تْرَاجِيدْيَا / تْرَاجِيدْيَا / مَأْسَاة, فَاجِعَة",
 "惨害": "خراب, فوضى عارمة (اضطراب عنيف وغير ضروري)",
 "惨憺": "بَائِس / مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "惨死": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "惨殺": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "惨澹": "بَائِس / مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "惨烈": "رَهِيب, فَظِيع / فَظِيع, أَرْبَد",
 "惨禍": "بَلَاء, بُؤْس",
 "惨落": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "惨酷": "بِشَاعَة, قَسْوَة",
 "惰力": "عَطَالَة",
 "惰弱": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / ضَعِيف",
 "惰性": "عَطَالَة",
 "惰性的": "مِيكَانِيكِيّ",
 "惰気": "بُطْء",
 "惰眠": "بُطْء",
 "惰行": "سَاحِل, شَاطِئ",
 "想": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "想い": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "想いを寄せる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "想い人": "حَبِيب, عَزِيز (شخص تحبه، عادة ما يكون فرداً من عائلتك)",
 "想い入れ": "مَوْقِف, سُلُوك",
 "想い出": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "想い出話": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "想い描く": "تَخَيَّلَ, تَصَوَّرَ",
 "想い焦がれる": "اِشْتَاقَ",
 "想う": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة. / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / تَخَيَّلَ, تَصَوَّرَ / تَوَقَّعَ",
 "想像": "خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي.",
 "想像を絶する": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "想像上": "خِيَّالِيّ",
 "想像力": "خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي.",
 "想像妊娠": "حَمْل كَاذِب (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "想入れ": "مَوْقِف, سُلُوك",
 "想定": "فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "想察": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة)",
 "想念": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "想望": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "想起": "تذكر, ذاكرة (العمليات المعرفية التي يتم من خلالها تذكر التجارب السابقة)\nمثال: يمكنه فعل ذلك من الذاكرة / سِيرَة مَرَضِيَّة, تَارِيخ مَرَضِيّ / ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "惸然": "وَحِيد, مُنْفَرِد",
 "惸独": "يَتِيم / يَتِيمَة",
 "惹きつける": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "惹き付ける": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "惹く": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "惹句": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "惹起": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "惻隠": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "惻隠の情": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "愁い": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن. / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "愁え": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / غَمّ, حُزْن / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "愁ふ": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "愁傷": "غَمّ, حُزْن",
 "愁嘆": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "愁歎": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "愁然": "بِأَسًى, بِحُزْن (مع الحزن؛ بطريقة حزينة) / بأسى, بحزن (بطريقة حزينة)\nمثال: نظرت إليه والدته بحزن عندما أخبرها أنه انضم للجيش",
 "愁訴": "شِكَايَة, شَكْوَى",
 "愈": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد / بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "愉しげ": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "愉快": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "愉悦": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "愉楽": "مُتْعَة, لَذَّة",
 "愍然": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "愍諒": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "意": "مشاعر (الحساسية العاطفية أو الأخلاقية (خاصة فيما يتعلق بالمبادئ الشخصية أو الكرامة))\nمثال: جرحت الملاحظة مشاعره / مَعْنًى / الْمَعْنَى",
 "意にかなう": "رَضَّى",
 "意に介す": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "意に介する": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "意に叶う": "رَضَّى",
 "意に満たない": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "意に適う": "رَضَّى",
 "意のままに": "حسب المشيئة, كما يشاء (كما يختار المرء أو يرضى)\nمثال: يمكنه التجول في الحي كما يشاء",
 "意を得る": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "意を決する": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "意を用いる": "أَعَارَ اِنْتِبَاه",
 "意中の人": "حَبِيب, حَبِيبَة",
 "意力": "إرَادَة / رَغْبَة, إرَادَة",
 "意匠": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "意向": "قَصْد, إِرَادَة",
 "意向調査": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "意味": "مَعْنًى / الْمَعْنَى",
 "意味ありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "意味がない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "意味が無い": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "意味が通らない": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "意味するもの": "مَعْنًى / الْمَعْنَى",
 "意味ない": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "意味をなさない": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "意味を成さない": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)",
 "意味不": "غَامِض",
 "意味不明": "غَامِض",
 "意味内容": "مَعْنًى / الْمَعْنَى",
 "意味合い": "تَلَازُم",
 "意味役割": "دور دلالي ((لغويات) العلاقة الأساسية التي يمتلكها مكون مع الفعل الرئيسي في الجملة)",
 "意味深": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "意味深い": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "意味深長": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "意味無い": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "意味的": "دَلَالَات الأَلفَاظ",
 "意味論": "عِلْم اَلْمَعَانِي (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "意味関係": "عَلَاقَة دَلَالِيَّة (علاقة بين المعاني)",
 "意図": "قَصْد, إِرَادَة",
 "意図せず": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "意図的": "عَمْدِيّ, إرَادِيّ",
 "意固地": "مُتَعَنِّت, عَنِيد",
 "意地": "عِنَاد / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد / شَهِيَّة",
 "意地が悪い": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة",
 "意地ずく": "عِنَاد",
 "意地っ張り": "مُتَعَنِّت, عَنِيد",
 "意地づく": "عِنَاد",
 "意地でも": "بأي ثمن, مهما كلف الأمر (بغض النظر عن التكلفة)\nمثال: أراد إنقاذ حياتها بأي ثمن",
 "意地になって": "بإصرار, بعناد (بطريقة عنيدة)\nمثال: بقيت بعناد في نفس الوضع",
 "意地尽": "عِنَاد",
 "意地尽く": "عِنَاد",
 "意地悪": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة",
 "意地悪い": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "意地汚い": "نَهِم, شَرِه / جَشِع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "意外": "مُفَاجِئ",
 "意外性": "مُبَاغَتَة, مُفَاجَأَة (الاستثنائية بحكم كون الشيء غير متوقع)\nمثال: مفاجأة الترحيب الحار",
 "意字": "رمز تصويري (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "意志": "إرَادَة / رَغْبَة, إرَادَة",
 "意志の強い": "قَوِيُّ الإِرَادَة (يَتَّسِمُ بِاسْتِقْلَالِيَّةٍ قَوِيَّةٍ فِي الفِكْرِ وَالحُكْم) / صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "意志の疎通": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "意志の自由": "حُرِّيَّة الْإِرَادَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "意志力": "ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "意志堅固": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "意志欠乏": "أبوليا, انعدام الإرادة (فقدان قوة الإرادة)",
 "意志疎通": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "意志的": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "意思": "قَصْد, إِرَادَة",
 "意思が強い": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "意思の疎通": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "意思疎通": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "意思確認書": "خطاب نوايا (أي رسالة تعبر عن نية اتخاذ (أو التخلي عن) إجراء ما)",
 "意思能力": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "意思表示カード": "بطاقة متبرع (بطاقة تحملها معك وتجيز استخدام أعضائك للزراعة بعد وفاتك)",
 "意想外": "مُفَاجِئ",
 "意欲": "إرَادَة / رَغْبَة, إرَادَة",
 "意欲的": "سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "意気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "意気地": "عزة نفس, كرامة (صفة الجدارة بالتقدير أو الاحترام)\nمثال: كان من دون كرامته أن يغش",
 "意気地なし": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "意気地のない": "عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "意気地無し": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "意気投合": "انسجم, تفاهم (التمتع بعلاقات طيبة وسلسة مع الآخرين)\nمثال: أنا ورئيسي نتفاهم بشكل جيد للغاية",
 "意気揚々": "ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر) / ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح)",
 "意気揚揚": "ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر) / ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح)",
 "意気沮喪": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "意気消沈": "اعتلال المزاج, انقباض (حالة من الاكتئاب الخفيف)",
 "意気盛ん": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "意気組": "تأهب, حماس (استعداد فوري) / توق, شغف (شعور إيجابي بالرغبة في المضي قدماً في شيء ما)\nمثال: استعداد لمواصلة المناقشات",
 "意気組み": "تأهب, حماس (استعداد فوري) / توق, شغف (شعور إيجابي بالرغبة في المضي قدماً في شيء ما)\nمثال: استعداد لمواصلة المناقشات",
 "意気衝天": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "意気軒昂": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "意気軒高": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "意気込み": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "意気阻喪": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "意義": "مَعْنًى / الْمَعْنَى",
 "意義深い": "هَامّ (أصابه الهيام)\nمثال: الحضور هام جدا.",
 "意表": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "意表外": "مُفَاجِئ",
 "意見": "رَأْي, نَظَر / تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "意見を述べる": "رَأَى, ظَنَّ (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "意見交換": "عَصَف ذِهْنِيّ, قَدَح ذِهْنِيّ",
 "意見書": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "意識": "وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي. / وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "意識が低い": "جَاهِل",
 "意識の流れ": "تيار الوعي (التدفق المستمر للأفكار والمشاعر التي تشكل التجربة الواعية للفرد) / تيار الوعي (نوع أدبي يكشف عن أفكار ومشاعر الشخصية أثناء تطورها عن طريق مناجاة طويلة)",
 "意識を回復する": "أَنْعَشَ",
 "意識下": "اللَّاوَعِيّ",
 "意識不明": "فِقْدَان اَلْوَعْي, إِغْمَاء",
 "意識化": "تَحْقِيق",
 "意識喪失": "فقدان الوعي (حدوث فقدان للقدرة على الإدراك والاستجابة)",
 "意識改革": "ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "意識的": "مدرك, واعٍ (عارف ومدرك؛ لديه وعي بما يحيط به وبالأحاسيس والأفكار) / مُتَعَمَّد, وَاعٍ (مُتصوَّر عن قصد ووعي)\nمثال: ظل واعياً أثناء العملية",
 "意識調査": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "意趣": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه. / قَصْد, إِرَادَة / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "意趣晴らし": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "意趣返し": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "意趣遺恨": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "愕然": "مَذْهُول",
 "愚": "حَمَاقَة (خطأ سخيف) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "愚か": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚かしい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚かにも": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "愚か者": "مُغَفَّل, أَحْمَق",
 "愚にもつかない": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚にも付かない": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚人": "مُغَفَّل, أَحْمَق",
 "愚作": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها)",
 "愚僧": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "愚兄": "اَلْأَخ اَلْأَكْبَر",
 "愚劣": "حَمَاقَة (خطأ سخيف)",
 "愚夫": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "愚女": "اِبْنَة, بِنْت",
 "愚妻": "زَوْجَة, اِمْرَأَة",
 "愚姉": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "愚弄": "اِسْتِهْزَاء",
 "愚弟": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "愚息": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "愚惷": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚昧": "غَبِيّ / غَبِيّ, أَحْمَق",
 "愚暗": "حَمَاقَة (خطأ سخيف)",
 "愚案": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "愚父": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "愚物": "مُغَفَّل, أَحْمَق",
 "愚生": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "愚痴": "قَمْقَمَ",
 "愚痴っぽい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "愚痴る": "قَمْقَمَ",
 "愚痴をこぼす": "تذمر دائم (شكوى مزعجة ومستمرة) / دائم الشكوى ((اليديشية) شخص يشتكي باستمرار)",
 "愚痴を溢す": "تذمر دائم (شكوى مزعجة ومستمرة) / دائم الشكوى ((اليديشية) شخص يشتكي باستمرار)"
}
