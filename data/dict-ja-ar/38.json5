 "徴求": "طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "徴用": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية)\nمثال: تعلم الرسم من والده",
 "徴発": "حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي…)\nمثال: أولاً عليك ملء طلب الصرف / تَجْنِيد إِجْبَارِيّ",
 "徴税": "تحصيل الضرائب, جباية الضرائب (جمع الضرائب)",
 "徴税吏": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "徴証": "لافِتَة\nمثال: توم وقع و أصيب.",
 "徴集": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية)",
 "徹する": "اِخْتَرَقَ",
 "徹カラ": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "徹底": "استقصاء, شمولية (اجتهاد في أداء جميع جوانب المهمة)",
 "徹底的": "مُفَصَل",
 "徹甲": "خارق للدروع (الشيء)\nمثال: ذلك خارق للعادة.",
 "徹頭徹尾": "باستفاضة, بدقة (بطريقة شاملة)\nمثال: بحثنا في الملفات بدقة",
 "徽章": "مِيدَالِيَة, مِِيدَالْيَة",
 "心": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / قَلْب, فُؤَاد / نِوَاة / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "心ある": "عَمِيق اَلتَّفْكِير / حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول / ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد)\nمثال: ناقد فطن",
 "心おきなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "心おだやか": "هَادِئ",
 "心から": "بحماس, بقلب قوي (بمتعة ودون تحفظ)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "心がけ": "مَوْقِف, سُلُوك",
 "心がける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心がまえ": "استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب",
 "心が広い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "心が折れる": "يَئِسَ, أُحْبِطَ",
 "心が狭い": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية)\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "心が込められた": "كُلِّيّ الإِخْلَاص, مُخْلِص (بِتَفَانٍ وَحَمَاسَة غَيْر مَشْرُوطَيْن)",
 "心ここにあらず": "مُشتَّت",
 "心ここに在らず": "مُشتَّت",
 "心して": "بِعِنَايَة",
 "心す": "تَوَخَّى اَلْحِذْر",
 "心する": "تَوَخَّى اَلْحِذْر",
 "心づかい": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "心づく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "心づくし": "إِحْسَان",
 "心づけ": "مكافأة تقديرية (مكافأة (كما في الخدمة الجديرة بالتقدير) تُعطى دون مطالبة أو التزام)",
 "心づもり": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "心ない": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين)\nمثال: سلوك مستهتر بشكل صادم / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "心なし": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "心なしか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "心ならずも": "دُونَ رَغْبَة, عَلَى مَضَض (بطريقة غير راغبة)\nمثال: لقد أخطأ بحقها كرهاً",
 "心にくい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "心にとどめる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心にとめる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心にもない": "زائف, غير مخلص (يفتقر إلى الإخلاص)\nمثال: امرأة ساحرة ولكنها غير مخلصة تماماً",
 "心にも無い": "زائف, غير مخلص (يفتقر إلى الإخلاص)\nمثال: امرأة ساحرة ولكنها غير مخلصة تماماً",
 "心に掛ける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心に描く": "تَخَيَّلَ, تَصَوَّرَ",
 "心に染む": "بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "心に留める": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心に秘める": "احتفظ بكل شيء لنسفه",
 "心のどこかで": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "心のぶつかり合い": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "心の優しい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "心の平ら": "مُعْتَدِل المِزَاج, هَادِئ الطَّبْع (لا يُستثار بسهولة؛ رَزين وثابت المزاج)",
 "心の広い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "心の支え": "دعم معنوي (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "心の狭い": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية)\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "心の理論": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "心の琴線": "أوتار القلب, شغاف القلب (أعمق مشاعر الحب والرحمة لديك)\nمثال: العديد من حالات التبني تلامس شغاف القلب",
 "心の病": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "心の病気": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "心の痛み": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "心の糧": "غذاء للفكر, مادة للتفكير (أي شيء يوفر حافزاً عقلياً للتفكير)",
 "心の臓": "قَلْب, فُؤَاد",
 "心の色": "إِحْسَان",
 "心の貧しい": "بخيل, شحيح (غير راغب في إنفاق (المال، الوقت، الموارد، إلخ))\nمثال: تمارس الاقتصاد دون أن تكون بخيلة",
 "心ばえ": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / طَبِيعَة, طبيعة",
 "心ばかり": "صَغِير, صغير",
 "心ひそかに": "دَاخِلِيًّا, فِي السِّرّ (فيما يتعلق بالمشاعر الخاصة)\nمثال: داخلياً، كانت تغلي غضباً",
 "心もとない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَصَبِيّ / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "心やり": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "心より": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "心をいたす": "كَرَّسَ, قَدَّمَ",
 "心をこめて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "心を入れ替える": "إِصْلَاح",
 "心を動かす": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "心を打つ": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "心を捉える": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "心を痛める": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心を砕く": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心を籠めて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "心を致す": "كَرَّسَ, قَدَّمَ",
 "心を許す": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء.",
 "心を込めて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "心を配る": "أَعَارَ اِنْتِبَاه",
 "心エコー": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "心エコー図": "مخطط صدى القلب (صورة بيانية للقلب منتجة بواسطة جهاز تخطيط صدى القلب)",
 "心エコー診断": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "心タンポナーデ": "اندكاك قلبي, سطام قلبي (ضغط ميكانيكي على القلب ناتج عن تجمع كميات كبيرة من السوائل في حيز التامور مما…)",
 "心マ": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على…)",
 "心丈夫": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "心不全": "قُصُور القَلْب, فَشَل القَلْب",
 "心中": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "心中穏やかでない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "心中立て": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / وَفَاء, إِخْلَاص",
 "心事": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "心付": "مكافأة تقديرية (مكافأة (كما في الخدمة الجديرة بالتقدير) تُعطى دون مطالبة أو التزام)",
 "心付く": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "心付け": "مكافأة تقديرية (مكافأة (كما في الخدمة الجديرة بالتقدير) تُعطى دون مطالبة أو التزام)",
 "心休め": "مُوَاسَاة",
 "心使い": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "心做し": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "心停止": "سَكْتَة قَلْبِيَّة",
 "心傷": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "心傷れ": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "心像": "صورة, صورة ذهنية (تمثيل عقلي أيقوني (يشبه الصورة المرئية))\nمثال: فرض خيالها عليها صوراً مروعة جداً لا يمكن تأملها",
 "心優しい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "心内膜": "شُغاف",
 "心内膜炎": "التهاب الشغاف (التهاب الشغاف وصمامات القلب)",
 "心出し": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "心切り": "قمع الإطفاء, مطفأة الشموع (أداة مخروطية الشكل ذات مقبض؛ تستخدم لإطفاء الشموع)",
 "心労": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心喰い虫": "دودة ثمار التفاح, عثة التفاح (عثة رمادية صغيرة تعيش يرقاتها في التفاح والجوز الإنجليزي)",
 "心喰虫": "دودة ثمار التفاح, عثة التفاح (عثة رمادية صغيرة تعيش يرقاتها في التفاح والجوز الإنجليزي)",
 "心嚢": "تَأْمُور",
 "心因": "نشوء نفسي (مصطلح عام لأصل وتطور أي جانب من جوانب العقل تقريبًا)",
 "心因性": "نَفْسِيّ المَنْشَأ (ذو منشأ نفسيّ أو عاطفيّ لا جسديّ)",
 "心土": "تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "心地": "تَبْطِين",
 "心地いい": "مُرِيح, وَثِير",
 "心地よい": "مُرِيح, وَثِير",
 "心地良い": "مُرِيح, وَثِير",
 "心境": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص)",
 "心境の変化": "انقلاب, تراجع (قرار بعكس قرار سابق)",
 "心変わり": "انقلاب, تراجع (قرار بعكس قرار سابق) / جُنُون",
 "心外": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ) / لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "心外膜炎": "اِلْتِهَاب التَّأْمُور",
 "心安い": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "心安だて": "صراحة (سمة كون المرء صريحاً ومباشراً)",
 "心安らか": "هَادِئ",
 "心安立て": "صراحة (سمة كون المرء صريحاً ومباشراً)",
 "心室": "بُطَيْن",
 "心室細動": "رجفان بطيني",
 "心寂しい": "وَحِيد, مُوحِش / مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "心密かに": "دَاخِلِيًّا, فِي السِّرّ (فيما يتعلق بالمشاعر الخاصة)\nمثال: داخلياً، كانت تغلي غضباً",
 "心尽くし": "إِحْسَان",
 "心尽し": "إِحْسَان",
 "心底": "قَلْبًا وَقَالَبًا",
 "心延え": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / طَبِيعَة, طبيعة",
 "心弱い": "حَسَّاس, رَقِيقُ القَلْب (يتأثّر بسهولة بمعاناة الآخرين وضيقهم)",
 "心張り棒": "حَانَة, بَار",
 "心強い": "بَاعِثٌ لِلأَمَل, مُبَشِّر (يُشجِّع بطريقة تبعث البهجة والأمل)",
 "心当たり": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "心当たりのない": "مُفَاجِئ",
 "心当て": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "心待ち": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "心後れ": "تردد, عدم الثقة بالنفس (انعدام الثقة بالنفس)",
 "心得": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي / استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب / نَائِب, نَائِبَة",
 "心得る": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "心得違い": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "心忙しい": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)\nمثال: ليلة قلقة",
 "心性": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "心恥かしい": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "心悲しい": "حَزِين, زعلان",
 "心悸": "خَفَقَان",
 "心悸亢進": "خَفَقَان",
 "心情": "عَاطِفَة",
 "心情的": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "心情論": "انفعالية, عاطفية (طبيعة أو صفة عاطفية)",
 "心意": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "心意気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "心慮": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "心憎い": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "心成し": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "心房": "أُذَيْن",
 "心房中隔欠損": "عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "心房細動": "رَجَفَان أُذَيْنِيّ",
 "心所": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن…)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "心打": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "心打ち": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "心抜き器": "أداة إزالة اللب, مقوّر (أداة لإزالة اللب من التفاح)",
 "心拍": "نَبْض, نَبْضُ القَلْب",
 "心拍出量": "النِّتَاج القَلْبِيّ (كمية الدم التي يضخها البطينان في فترة زمنية معينة)\nمثال: يبلغ النتاج القلبي للبالغ في حالة الراحة حوالي ثلاثة لترات في الدقيقة",
 "心拍数": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "心拍計": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "心拍記録": "تخطيط القلب, تخطيط كهربائية القلب (إجراء تشخيصي يتمثل في تسجيل نشاط القلب إلكترونياً باستخدام جهاز تخطيط القلب)",
 "心持": "شُعُور, إِحْسَاس / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً",
 "心持ち": "شُعُور, إِحْسَاس / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً",
 "心掛け": "مَوْقِف, سُلُوك",
 "心掛ける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心有る": "عَمِيق اَلتَّفْكِير / حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول / ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد)\nمثال: ناقد فطن",
 "心材": "خشب القلب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "心柄": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص)",
 "心根": "قَلْب, فُؤَاد / طَبِيعَة, طبيعة",
 "心棒": "قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر)",
 "心構え": "استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب",
 "心機": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن…)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "心機一転": "قَلَبَ",
 "心残り": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "心気": "عَقْلِيَّة / تهيج, سرعة الغضب (شعور بالتهيج والنزق)",
 "心気症": "وَسَاوِس مرضية",
 "心淋しい": "مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "心添え": "نَصِيحَة, مَشُورَة",
 "心炎": "التهاب القلب (التهاب القلب)",
 "心無い": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين)\nمثال: سلوك مستهتر بشكل صادم / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "心猿": "عَاطِفَة, شَغْف\nمثال: قبل توم ماري بشغف.",
 "心理": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص)",
 "心理テスト": "اختبار شخصية (أي اختبار يهدف إلى تقييم الشخصية)",
 "心理士": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "心理学": "سَيْكُولُوجْيَا, عِلْم النَّفْس",
 "心理学的": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ)\nمثال: نظريات نفسية",
 "心理学者": "نَفْسَانِيّ, عَالِم النَّفْس",
 "心理戦": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "心理戦争": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "心理測定学": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "心理状態": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص)",
 "心理療法": "علاج نفسي (علاج المشاكل العقلية أو العاطفية بوسائل نفسية)",
 "心理療法士": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "心理療法家": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "心理的": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ)\nمثال: نظريات نفسية",
 "心理的瑕疵物件": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "心理臨床家": "عِلْم نَفْس سَرِيرِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "心理言語学": "لسانيات نفسية (فرع علم النفس المعرفي الذي يدرس الأساس النفسي للكفاءة والأداء اللغوي)",
 "心界": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "心疾患": "اعتلال القلب, مرض القلب (مرض يصيب القلب)",
 "心痛": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心癖": "استعداد مسبق, تأهب (استعداد مسبق للتفاعل بطريقة معينة)",
 "心的": "عَقْلِيّ",
 "心的外傷": "صدمة, صدمة نفسية (جرح أو صدمة عاطفية غالباً ما يكون لها آثار طويلة الأمد)",
 "心的外傷後ストレス障害": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "心的表示": "تصور داخلي, تمثيل (عرض للأمور في العقل على شكل فكرة أو صورة)",
 "心皮": "كربلة (مدقة بسيطة أو عنصر واحد من مدقة مركبة)",
 "心眼": "عين العقل, مخيلة (تخيل مشاهد متذكرة أو مخترعة)\nمثال: استطعت رؤيتها بوضوح في مخيلتي",
 "心祝い": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "心神": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "心神喪失": "جُنُون",
 "心移り": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "心積もり": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "心積り": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "心穏やか": "هَادِئ",
 "心立て": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "心筋": "عضلة قلبية (النسيج العضلي للقلب؛ متكيف للانقباض الإيقاعي المستمر)",
 "心筋梗塞": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "心筋炎": "التهاب عضلة القلب (التهاب عضلة القلب)",
 "心筋症": "اعتلال عضلة القلب (اضطراب (مجهول السبب عادةً) يصيب عضلة القلب)",
 "心算": "قَصْد, إِرَادَة / اِعْتِقَاد",
 "心細い": "عَاجِز",
 "心組": "تَحْضِير, إِعْدَاد",
 "心組み": "تَحْضِير, إِعْدَاد",
 "心緒": "عَاطِفَة, عَوَاطِف",
 "心線": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ",
 "心置きなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "心置き無く": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "心耳": "صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / أُذَيْن",
 "心肝": "قَلْب, فُؤَاد",
 "心肺": "جهاز القلب والرئة (مضخة للحفاظ على الدورة الدموية أثناء جراحة القلب؛ تحول الدم من القلب وتؤكسده ثم…)",
 "心肺停止": "توقف الانقباض, توقف قلبي رئوي (غياب الانقباض القلبي؛ فشل بطينات القلب في الانقباض (عادة بسبب الرجفان البطيني)…)",
 "心肺蘇生法": "إنعاش قلبي رئوي (إجراء طوارئ يتكون من تدليك القلب الخارجي والتنفس الاصطناعي)",
 "心胆": "قَلْب, فُؤَاد",
 "心膜": "تَأْمُور",
 "心膜炎": "اِلْتِهَاب التَّأْمُور",
 "心膜腔": "تجويف التامور (الحيز بين طبقات التامور الذي يحتوي على سائل يزيت أسطح الغشاء ويسمح بحركة القلب…)",
 "心臓": "قَلْب, فُؤَاد / أَحْشَاء",
 "心臓にけがはえた": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "心臓に毛が生えた": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "心臓マッサージ": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على…)",
 "心臓マヒ": "قُصُور القَلْب, فَشَل القَلْب",
 "心臓停止": "سَكْتَة قَلْبِيَّة",
 "心臓外科": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "心臓学": "طِبّ اَلْقَلْب (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "心臓専門医": "أخصائي قلب, جراح قلب (أخصائي في طب القلب؛ متخصص في بنية ووظيفة واضطرابات القلب)",
 "心臓弁": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي)",
 "心臓弁膜": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي)",
 "心臓弁膜症": "مرض صمام القلب (مرض قلبي ناجم عن تضيق صمامات القلب وانسداد تدفق الدم أو ناجم عن التنكس وارتجاع…)",
 "心臓形": "قلبي, منحنى قلبي (دويري خارجي تتساوى فيه الدائرة المتدحرجة مع الدائرة الثابتة) / قَلْبِيّ الشَّكْل ((عن الورقة) على شكل قلب)",
 "心臓手術": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "心臓炎": "التهاب القلب (التهاب القلب)",
 "心臓病": "اعتلال القلب, مرض القلب (مرض يصيب القلب)",
 "心臓病学": "طِبّ اَلْقَلْب (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "心臓発作": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "心臓超音波検査": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "心臓部": "قَلْب, فُؤَاد",
 "心臓麻痺": "قُصُور القَلْب, فَشَل القَلْب",
 "心苦しい": "أَلِيم, مُؤْلِم",
 "心血": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "心血管": "جِهَاز اَلدَّوَرَان, جِهَاز قَلْبِيّ وِعَائِيّ",
 "心血管疾患": "مرض القلب والأوعية الدموية, مرض قلبي وعائي (مرض يصيب القلب أو الأوعية الدموية)",
 "心血管系": "الجهاز الدوري, جهاز الدوران (الأعضاء والأنسجة المشاركة في تدوير الدم والليمف عبر الجسم)",
 "心術": "طَبِيعَة, طبيعة",
 "心裡留保": "تحفظ, تحفظ ذهني (شك غير معلن يمنعك من قبول شيء ما بقلب خالص)",
 "心覚え": "ذَاكِرَة, حَافِظَة",
 "心許ない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَصَبِيّ / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "心許無い": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَصَبِيّ / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "心証": "اِنْطِبَاع, أَثَر / إيمان راسخ, قناعة (إيمان راسخ بشيء ما دون الحاجة إلى إثبات أو دليل)",
 "心象": "صورة, صورة ذهنية (تمثيل عقلي أيقوني (يشبه الصورة المرئية))\nمثال: فرض خيالها عليها صوراً مروعة جداً لا يمكن تأملها",
 "心身一体": "شمولية, نظرية شمولية (النظرية القائلة بأن أجزاء أي كل لا يمكن أن توجد ولا يمكن فهمها إلا في علاقتها…)\nمثال: تفيد الشمولية بأن الكل أكبر من مجموع أجزائه",
 "心遣い": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "心遣り": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "心配": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / اِهْتِمَام",
 "心配ごと": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心配ご無用": "هُنَاكَ, يُوجَدُ",
 "心配り": "اِهْتِمَام, اِنْتِبَاه",
 "心配事": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心配御無用": "هُنَاكَ, يُوجَدُ",
 "心配無用": "هُنَاكَ, يُوجَدُ",
 "心酔": "توقير, عبادة (العبادة المقدمة لله وحده) / تَفَرُّغ",
 "心障": "اضطراب نفسي",
 "心雑音": "لغط القلب, نفخة قلبية (صوت غير طبيعي للقلب؛ أحياناً يكون علامة على وظيفة غير طبيعية لصمامات القلب)",
 "心電図": "مُخَطَط كَهْرَبِيَّة اَلْقَلْب, إِلِكْتْرُوكَارْدِيُوغْرَام",
 "心電計": "جهاز تخطيط القلب, مخطط القلب (أداة طبية تسجل التيارات الكهربائية المرتبطة بانقباضات القلب)",
 "心霊": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "心霊主義": "روحانية (الاهتمام بأمور الروح)",
 "心霊学": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية)",
 "心霊治療": "شفاء بالإيمان (الرعاية المقدمة من خلال الصلاة والإيمان بالله)",
 "心霊現象": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن…)",
 "心霊術": "روحانية (الاهتمام بأمور الروح)",
 "心霊論": "روحانية (الاهتمام بأمور الروح)",
 "心霊論者": "روحاني (متعلق بالروحانية أو متصل بها)\nمثال: استشار العديد من الوسطاء",
 "心静か": "هَادِئ",
 "心音": "نَبْض, نَبْضُ القَلْب",
 "心頭": "قَلْب, فُؤَاد",
 "心頼み": "اتكال, اعتماد (يقين مبني على الخبرة السابقة)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "心願": "صَلَاة, دُعَاء",
 "心骨": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "心髄": "نِقْيُ ٱلْعَظْم, مُخُّ ٱلْعَظْم / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك",
 "心魂": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "必": "تَحْدِيد, قَطْعِيَّة (صفة القابلية للتنبؤ بثقة كبيرة)",
 "必する": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "必ず": "دَائِمًا, أَبَدًا",
 "必ずしも": "دَائِمًا, أَبَدًا",
 "必ずや": "بِالتَّأْكِيد",
 "必修": "إِجْبَارِيّ, إِلْزَامِيّ (مطلوب بموجب قاعدة أو نظام)",
 "必備": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "必勝不敗": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "必定": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك)\nمثال: هو كذلك بالضرورة",
 "必携": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة / دَلِيل, كُتَيِّب",
 "必携品": "ضَرُورَة, حَاجَة",
 "必死": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة)",
 "必死になって": "بإلحاح, بشكل عاجل (بإلحاح شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "必殺": "مُمِيت",
 "必滅": "فناء, موت (الجودة أو الحالة المتمثلة في كونه فانياً)",
 "必然": "حَتْمِيّ / حَتْمِيَّة, وُجُوب (صفة كون الشيء غير قابل للتجنب)",
 "必然性": "ضَرُورَة, حَاجَة",
 "必然的": "حَتْمِيّ",
 "必用": "ضَرُورِيّ, لَازِم / ضَرُورَة, حَاجَة",
 "必竟": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "必至": "حَتْمِيّ",
 "必要": "ضَرُورِيّ, لَازِم / ضَرُورَة, حَاجَة",
 "必要とする": "حَاجَة, ضَرُورَة\nمثال: とりわけ子供たちは愛情を必要とする。 — و فوق كل شيء، يحتاج الأطفال إلى الحب.",
 "必要ない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "必要は発明の母": "اَلْحَاجَة أَمّ اَلاِخْتِرَاع",
 "必要不可欠": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "必要事": "ضَرُورَة, حَاجَة",
 "必要品": "ضَرُورَة, حَاجَة",
 "必要性": "ضَرُورَة, حَاجَة",
 "必要条件": "شَرْط ضَرُورِيّ (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "必要無い": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "必要物": "ضَرُورَة, حَاجَة",
 "必要語": "كلمة مفتاحية (كلمة مهمة تستخدم في الفهرسة أو التصنيف)",
 "必見": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً)",
 "必需": "ضَرُورِيّ, لَازِم",
 "必需品": "ضَرُورَة, حَاجَة",
 "必須": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "必須アミノ酸": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "必須条件": "أمر لا غنى عنه, شرط أساسي (شرط مسبق لا يمكن الاستغناء عنه)",
 "忌": "حِدَاد\nمثال: هو ذئب في ثوب حمل. / مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / صَافٍ, اَلصَّافِي",
 "忌々しい": "مُزْعِج",
 "忌々しき": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "忌まわしい": "بَشِع, مَقِيت (مسيء للعقل ومثير للنفور) / مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع)",
 "忌ま忌ましい": "مُزْعِج",
 "忌み": "حِدَاد\nمثال: هو ذئب في ثوب حمل. / مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / صَافٍ, اَلصَّافِي",
 "忌み言葉": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "忌む": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "忌むべき": "بَغِيض",
 "忌中": "حِدَاد\nمثال: هو ذئب في ثوب حمل.",
 "忌憚": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز)",
 "忌憚のない": "طليق, غير مقيد (غير خاضع للتقييد)\nمثال: ضحك غير مقيد",
 "忌憚の無い": "طليق, غير مقيد (غير خاضع للتقييد)\nمثال: ضحك غير مقيد",
 "忌服": "حِدَاد\nمثال: هو ذئب في ثوب حمل.",
 "忌言葉": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "忌諱": "استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما)",
 "忌避": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / تنححي, رد القاضي ((قانون) اعتراض مبني على علاقة القاضي بأحد الأطراف)",
 "忍": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "忍ばせる": "أَخْفَى",
 "忍び": "تسلل, خلسة (تجنب الكشف عن طريق التحرك بحذر) / نِينْجُوتْسُو / نِينْجَا, نِنْجَا / لص متسلل (لص يسرق دون استخدام العنف)",
 "忍びがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "忍びない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "忍びの者": "نِينْجَا, نِنْجَا",
 "忍びやか": "خَلْسِيّ, مُتَسَلِّل (يتّسم بالهدوء والحذر والسرّيّة؛ يحرص على تجنّب الملاحظة)",
 "忍び会い": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء",
 "忍び出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "忍び声": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح)",
 "忍び忍び": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "忍び笑い": "إِهْلَاس",
 "忍び逢い": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء",
 "忍び難い": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "忍び音": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح)",
 "忍ぶ": "أَخْفَى, خَبَأَ\nمثال: أين اختبأ ياني؟ / تَحَمَّلَ, صَبَرَ",
 "忍会": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء",
 "忍冬": "صريمة الجدي اليابانية, عسلة يابانية (عسلة آسيوية دائمة الخضرة زاحفة بأوراق نصف دائمة الخضرة وزهور بيضاء عطرة تتحول…)",
 "忍従": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر)",
 "忍田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "忍石": "تغصن, زائدة شجرية (ليف قصير ينقل الإشارات نحو جسم الخلية العصبية)",
 "忍者": "نِينْجَا, نِنْجَا",
 "忍耐": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "忍耐力": "ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "忍耐強い": "دَؤُوب, مُثَابِر (يُوَاظِبُ بِهُدُوءٍ وَثَبَاتٍ خَاصَّةً فِي التَّفَاصِيلِ وَالدِّقَّة)",
 "忍耐心": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "忍苦": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "忍術": "نِينْجُوتْسُو",
 "忍辱": "حِلْم (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / ثُوم, ثُومَة",
 "忖度": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة) / احترام, توقير (تعبير مهذب (بالقول أو الفعل) عن التقدير)\nمثال: كان توقيره لرغباتها ممتعاً للغاية",
