 "怫然": "ساخط, ساخطة",
 "怯え": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怯む": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "怯夫": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "怯弱": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "怯懦": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "怱々": "مَشْغُول / اَلْمُخْلِص / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "怱忙": "مَشْغُول",
 "怱忙として": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "怱怱": "مَشْغُول / اَلْمُخْلِص / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "恃み": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / اتكال, اعتماد (يقين مبني على الخبرة السابقة) / اتكال, اعتماد (حالة الاعتماد على شيء ما)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "恋": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "恋いる": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "恋い慕う": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "恋い焦がれる": "تَاقَ (اشتاقَ ومالَ بشدة إلى الشيء أو الشخص؛ تحركَ أو تطلعَ بشوق نحو أمر مرغوب) / اِشْتَاقَ",
 "恋う": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "恋しい": "ضَائِع, فَائِت (لم تلتقطه الحواسّ أو العقل؛ فاته الإدراك)",
 "恋しがる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "恋する": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "恋に落ちる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
