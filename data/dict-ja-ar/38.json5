 "忘れ勝ち": "نَسَّاء, نَسِيّ",
 "忘れ形見": "تذكار (شيء يذكر بأحداث الماضي) / يَتِيم",
 "忘れ得ぬ": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘れ草": "تِبْغ, تَبْغ",
 "忘れ難い": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘八": "يُوحَنَّا, يَحْيَى ((في المسيحية) أي من شخصيات الكتاب المقدس الذين تسموا بهذا الاسم، وأشهرهم:…)\nمثال: توم وماريا قالو ليوحنا, أنهم لا يعتقدون أن تكون ايلكا في الأسفل. / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "忘八屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "忘却": "نِسْيَان",
 "忘却のかなた": "إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن…)",
 "忘却の彼方": "إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن…)",
 "忘失": "فَقَدَ\nمثال: خسر توم وظيفته.",
 "忘己利他": "إِيثَار, غَيْرِيَّة",
 "忘年会": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "忘恩": "جحود, نكران الجميل (الافتقار إلى الامتنان)",
 "忘我": "ترانس",
 "忘新年会": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "忘草": "تِبْغ, تَبْغ",
