 "役員": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / مَأْمُور",
 "役回り": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役場": "بَلَدِيَّة",
 "役夫": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "役得": "مِنْحَة, عِلَاوَة",
 "役所": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "役所仕事": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "役所言葉": "لغة بيروقراطية, لغة رسمية (أسلوب الكتابة المميز لبعض المسؤولين الحكوميين: رسمي وغامض)",
 "役柄": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役目": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "役立たず": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役立つ": "فَائِدَة, جَدْوَى",
 "役者": "مُمَثِّل, مُمَثِّلَة",
 "役職": "عَارِضَة, عَارْضَة\nمثال: نشر توم الغسيل.",
 "役身折酬": "عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "彼": "هُوَ / خَلِيل, رَفِيق\nمثال: ليس لديه صديقة. / الْمُخْتَار, الْمُخْتَارَة / لِكَيْ, أَنْ",
 "彼とか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما.",
 "彼の": "الْمُخْتَار, الْمُخْتَارَة / لِكَيْ, أَنْ",
 "彼のさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "彼の人": "هُوَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "彼の国": "اَلنِّرْفَانَا",
 "彼の地": "هُنَاكَ",
 "彼の娘": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "彼の子": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "彼の岸": "اَلنِّرْفَانَا",
 "彼の方": "هُوَ",
 "彼の様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "彼は誰時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "彼ぴ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "彼ぴっぴ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "彼ら": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼ピ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "彼ピッピ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "彼女": "هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل…)\nمثال: هذه هي المسألة. / صَدِيقَة, صَاحِبَة (مؤنث الصديق؛ الصاحبة الخليلة)\nمثال: ليس لديه صديقة.",
 "彼女たち": "هُمَا",
 "彼女ら": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼女等": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼女自身": "نَفْسُهَا",
 "彼奴ばら": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼奴ら": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼奴等": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼奴輩": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼岸": "اَلنِّرْفَانَا",
 "彼岸桜": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "彼岸花": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "彼方": "أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "彼方方": "هُنَاك, هُنَالِك / ـهُ, ـهِ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا…)",
 "彼方此方": "هُنَا وَهُنَاكَ",
 "彼氏": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة. / هُوَ",
 "彼程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "彼等": "هُمَا\nمثال: هن يحببن الجاز.",
 "彼自身": "نَفْسَهُ",
 "彼誰時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "往々": "أَحْيَانًا, سَاعَات",
 "往々にして": "أَحْيَانًا, سَاعَات",
 "往き交い": "مُرُور",
 "往き来": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "往き返り": "ذهاب وعودة",
 "往って来い": "تَذَبذُب, تَقَلُّب",
 "往なす": "نَاكَفَ",
 "往にし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "往ぬ": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "往事": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "往信": "شوط أول (الأول من شوطين للعب)",
 "往古来今": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "往年": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "往往": "أَحْيَانًا, سَاعَات",
 "往復": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق)) / مُرَاسَلَة / تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "往復乗車券": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))",
 "往復切符": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))\nمثال: 往復切符を買いましたか。 — ھل إشتريت تذكرة ذهاب وإياب؟",
 "往復書簡": "مُرَاسَلَة",
 "往復機関": "محرك ترددي (محرك احتراق داخلي يتم فيه تدوير العمود المرفقي بواسطة مكابس تتحرك صعوداً…)",
 "往復航空券": "ذهاب وعودة",
 "往時": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "往来": "مُرُور / طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية. / رَاجِع, عَائِد (يَعُودُ مِنْ جَدِيد)",
 "往査": "زِيَارَة مَوْقِع, مُعَايَنَة مَيْدَانِيَّة (زيارة بصفة رسمية لفحص موقع لتحديد مدى ملاءمته لمشروع ما)",
 "往生": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / ترك, هجران (فعل الهجر أو التخلي) / قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "往生際": "ترك, هجران (فعل الهجر أو التخلي)",
 "往者": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "往訪": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)",
 "往返": "ذهاب وعودة",
 "往還": "مُرُور",
 "征": "سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "征く": "غَادَرَ, رَحَلَ (تَرَكَ)\nمثال: غادر سامي للتو.",
 "征する": "قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "征伐": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / تأنيب, توبيخ (عقاب لفظي)",
 "征典": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "征圧": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "征夷大将軍": "رَئِيس أَرْكَان / شُوغُون",
 "征戦": "بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي)",
 "征服": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / هَزَمَ, غَلَبَ",
