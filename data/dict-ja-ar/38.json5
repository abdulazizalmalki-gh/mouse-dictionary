{
 "擬足": "قدم كاذبة (نتوء مؤقت تستخدمه بعض الكائنات الحية الدقيقة كعضو للتغذية أو الحركة)",
 "擬革": "جلد صناعي (قماش مصنوع ليبدو مثل الجلد)",
 "擬革紙": "جلد صناعي (قماش مصنوع ليبدو مثل الجلد)",
 "擬音": "مُؤَثِّر صَوْتِيّ",
 "擬餌": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "擬餌針": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "擬餌鉤": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "擯斥": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "擱く": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "擱坐": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "擱座": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "擲弾": "قُنْبُلَة, قُنْبُلَة يَدَوِيَّة",
 "擲弾兵": "جرينادير, ذيل الجرذ (سمكة أعماق ذات رأس وجسم كبيرين وذيل طويل مستدق) / رامي القنابل, غرينادير (جندي مشاة مجهز بقنابل يدوية)",
 "擲弾発射筒": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "擲弾筒": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "擺つ": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك. / حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "擽り": "دغدغة (فعل الدغدغة) / دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "擾乱": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "攀援": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "攀禽類": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق) / متسلق (شخص يمارس التسلق كرياضة؛ وخاصة متسلق الجبال) / متسلق (شخص يصعد سيراً على الأقدام) / متسلق اجتماعي (شخص يسعى للوجاهة الاجتماعية من خلال التملق)\nمثال: بدا المتسلق القائد قوياً ولكن شريكه كان يترنح غالباً في حباله",
 "攀縁": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "攣る": "تَشَنُّج, شَدٌّ عَضَلِيّ",
 "攣縮": "تَشَنُّج",
 "攪乱": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "攪乱者": "مثير للاضطراب, مزعج (شخص يقاطع أو يعكر صفو الهدوء والسكينة؛ شخص يسبب الفوضى والهرج)",
 "攪乳器": "مَخَاضَة",
 "攪拌": "إثارة, تحريك (فعل تحريك شيء ما؛ التسبب في تحركه (عادة بقوة)) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / اضطراب, هياج (الشعور بالاضطراب وعدم الهدوء) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة",
 "攪拌機": "خَلَّاط, خَفَّاقَة",
 "攫う": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة / اِحْتَكَرَ",
 "支": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "支う": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "支え": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / عَقَبَة, حَاجِز",
 "支える": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "支保工": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر) / خَشَب!\nمثال: نحن نقطع الخشب.",
 "支出": "صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / مَصَارِيف, تَكَالِيف\nمثال: أيمكنك صرف خمسين؟",
 "支出係": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "支出金": "إنفاق, صرف (عملية إنفاق أو صرف المال) / صرف, مصروف (مبالغ مدفوعة للسلع والخدمات قد تكون قابلة للخصم الضريبي حالياً (على عكس النفقات الرأسمالية))",
 "支川": "ثَرِيّ, مُوسِر (يمتلك وفرة من المال أو الممتلكات القيّمة) / رافد (فرع يصب في المجرى الرئيسي) / مرفه, ميسور (شخص ميسور الحال؛ شخص في وضع مالي جيد)\nمثال: ما يسمى بالأثرياء الناشئين",
 "支度": "تَحْضِير, إِعْدَاد",
 "支度部屋": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "支弁": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "支所": "فَرْع, غُصْن",
 "支払": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "支払い": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "支払い人": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "支払い手形": "أوراق دفع, سندات دفع (سند يعد بدفع مبلغ معين من المال في وقت معين)",
 "支払い済み": "ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر) / مُسْتَعْمَر, مُسْتَوْطَن (يسكنه مستوطنون أو مستعمرون) / مستقر, مستوطن (تم تأسيسه في وضع أو مكان مرغوب؛ غير متنقل) / محسوم, مُبت فيه (تم تحديده أو البت فيه بما لا يدع مجالاً للنزاع أو الشك)\nمثال: بدو؛ اندمجوا بين الناس المستقرين",
 "支払い準備率": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على دفع عدد كبير غير عادي من عمليات السحب عند الطلب إذا حدث ذلك)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "支払い者": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "支払い能力": "سُيُولَة",
 "支払不能": "إِعْسَار, إِعْسَار مَالِيّ",
 "支払利息": "مصاريف الفوائد (الفوائد المدفوعة على القروض)",
 "支払手形": "أوراق دفع, سندات دفع (سند يعد بدفع مبلغ معين من المال في وقت معين)",
 "支払準備率": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على دفع عدد كبير غير عادي من عمليات السحب عند الطلب إذا حدث ذلك)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "支払者": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "支払能力": "سُيُولَة",
 "支承": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "支持": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / إسناد, تدعيم (فعل التدعيم بالدعامات)",
 "支持層": "ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين) / طبقة تحتية, طبقة سفلية (أي طبقة تقع تحت أخرى) / ركيزة, طبقة تحتية (سطح ينمو عليه كائن حي أو يلتصق به) / ركيزة, مادة تفاعل (المادة التي يعمل عليها إنزيم أو خميرة)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "支持線": "مستوى الدعم ((سوق الأسهم) السعر الذي تصبح عنده ورقة مالية معينة جذابة للمستثمرين)",
 "支持者": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "支援": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "支援体制": "نظام دعم (شبكة من المرافق والأشخاص الذين يتفاعلون ويظلون في اتصال غير رسمي للمساعدة المتبادلة؛ شبكة تمكنك من العيش بأسلوب معين)",
 "支援者": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "支援金": "تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "支族": "قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة.",
 "支柱": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "支流": "رَافِد",
 "支点": "نقطة ارتكاز (المحور الذي تدور حوله الرافعة)",
 "支燃性": "قابلية الاحتراق, قابلية الاشتعال (صفة القدرة على الاشتعال والاحتراق)",
 "支石墓": "دولمن, منضدة صخرية (مقبرة صخرية ضخمة من عصور ما قبل التاريخ تتكون عادة من حجرين عموديين كبيرين وحجر غطاء)",
 "支索": "مَكَثَ, بَقِيَ / إِقَامَة",
 "支給": "إمداد, تزويد (نشاط توريد أو توفير شيء ما) / إعداد, تحضير (العملية المعرفية للتفكير فيما ستفعله في حالة حدوث شيء ما) / بند, شرط (شرط منصوص عليه) / إمدادات, مؤونة (مخزون أو إمداد من شيء ما (خاصة الطعام أو الملابس أو الأسلحة))\nمثال: أعيق تخطيطه للتقاعد بسبب العديد من الشكوك",
 "支給品": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "支給額": "سماح (فعل السماح) / تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / بدل, تعديل (مبلغ يضاف أو يخصم بناءً على ظروف مؤهلة) / بدل, مخصص (مبلغ مسموح به أو ممنوح (كما خلال فترة معينة))\nمثال: اعترض على السماح بالتدخين في غرفة الطعام",
 "支線": "خط فرعي (خط سكة حديد متصل بخط رئيسي)",
 "支署": "محطة فرعية (محطة فرعية يتم فيها تحويل الكهرباء للتوزيع بواسطة شبكة منخفضة الجهد)",
 "支脈": "مِهْمَاز",
 "支辨": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "支那": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "支那そば": "رَامِن, رَامَن",
 "支那チベット語族": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "支那チベット諸語": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "支那学": "علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "支那文字": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "支那栗": "كستناء صينية (شجرة صغيرة بجوز حلو صغير؛ برية أو موطنة في كوريا والصين)",
 "支那語": "صِينِيّ",
 "支部": "فَرْع, غُصْن",
 "支配": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "支配人": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "支配層": "أصحاب السلطة, الطبقة الحاكمة (فئة الناس التي تمارس السلطة أو الحكم)",
