 "未練がましい": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "未練たらしい": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "未練たらたら": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "未練タラタラ": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "未練未酌がない": "بارد المشاعر, قاسي القلب (يفتقر إلى التعاطف أو الشعور)",
 "未練未酌が無い": "بارد المشاعر, قاسي القلب (يفتقر إلى التعاطف أو الشعور)",
 "未聞": "غَيْر مَسْمُوع (ليس بالضرورة خافتاً لكنه لم يُسمع)",
 "未舗装": "ترابي, غير معبد (ليس له سطح معبد)",
 "未見": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب) / غَيْر مَرْئِيّ, غَيْر مُلَاحَظ (لم يُلاحَظ ولم يُشاهَد) / غَيْرُ مَرْئِيّ, غَيْرُ مُلَاحَظ (لَمْ يُرَ أَوْ لَمْ يُدْرَك) / العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "未規定": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "未解明": "غَيْر مُوَضَّح (لم يتم توضيح سببه أو علته) / غَيْر مُفَسَّر (لم يُفسَّر أو يُوضَّح)",
 "未解決": "عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "未記入": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "未設": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "未詳": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض",
 "未読": "غَيْرُ قَارِئ (لم يكتسب معرفة عن طريق القراءة)",
 "未踏": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "未踏査": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "未配当": "غَيْرُ مُقَسَّم, مُوَحَّد (غير مُجزَّأ إلى أقسام أو حصص؛ يشكّل وحدة غير مقسّمة) / حَصْرِيّ, مُوَحَّد (غَيْرُ مُقَسَّمٍ بَيْنَ أَكْثَرَ مِنْ هَدَفٍ أَوْ غَرَضٍ وَاحِدٍ) / غَيْر مُقَسَّم, غَيْر مُوَزَّع (غير مشترك مع الآخرين أو موزَّع بينهم) / غَيْرُ مُنْقَسِم (لم يُفرِّقه خلاف في الرأي)",
 "未開": "هَمَجِيّ / غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "未開人": "هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ",
 "未開墾": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / بور, غير مزروع ((للأرض أو الحقول) غير معدة لزراعة المحاصيل) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة)",
 "未開封": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه)",
 "未開拓": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "未開発": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "末": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى. / النِهاية / بُودْرَة",
 "末々": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / الطَّبَقَاتُ الدُّنْيَا",
 "末えい": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末つ方": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "末に": "أَخِيراً",
 "末の世": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية) / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "末の末": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "末代": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "末代まで": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末始終": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末孫": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末尾": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "末席": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "末恐ろしい": "مُجَفِّل, مُخِيف",
 "末成": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "末成り": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "末摘花": "مُرِّيق, مُرَّيْق",
 "末日": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "末日聖徒": "قديس الأيام الأخيرة, مورموني (عضو في كنيسة يسوع المسيح لقديسي الأيام الأخيرة)",
 "末日聖徒イエスキリスト教会": "كنيسة المورمون, كنيسة يسوع المسيح لقديسي الأيام الأخيرة (كنيسة أسسها جوزيف سميث عام 1830 ومقرها الرئيسي في سولت ليك سيتي، يوتا)",
 "末期": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "末期的": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / طرفي, نهائي (كائن أو واقع في النهاية أو الطرف) / دوري, فصلي (متعلق بـ أو يحدث في فصل دراسي أو فترة زمنية محددة)\nمثال: العمود الطرفي",
 "末木": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "末末": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / الطَّبَقَاتُ الدُّنْيَا",
 "末枯れる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / صَعَقَ",
 "末梢": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "末梢性": "طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية) / طَرَفِيّ, هَامِشِيّ (مرتبط بالقضية الرئيسية لكنّه ليس ذا أهمية محورية) / جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: المقاطعات الطرفية لروسيا",
 "末梢的": "تافِه",
 "末梢神経系": "الجهاز العصبي المحيطي (قسم الجهاز العصبي الذي يقع خارج الدماغ والحبل الشوكي)",
 "末永い": "دَائِم",
 "末永く": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末派": "فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني.",
 "末流": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "末生り": "شَاحِب الوَجْه (ذو وجه شاحب)",
 "末端": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش)) / القواعد, عامة الأعضاء (الناس الذين يشكلون الجسم الرئيسي لأي مجموعة)\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "末端価格": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى هامش ربح التجزئة)",
 "末端巨大症": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "末端消費者": "مستخدم نهائي",
 "末端肥大症": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "末筆ながら": "أخيراً وليس آخراً",
 "末筆乍ら": "أخيراً وليس آخراً",
 "末節": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / شيء ثانوي, غير ضروري (أي شيء ليس أساسياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "末葉": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末裔": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "末路": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "末輩": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "末造": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "末長い": "دَائِم",
 "末長く": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "末頼もしい": "مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل) / مُبَشِّر, وَاعِد (يُنْبِئ بِاحْتِمال النَّجاح أَوْ نَتيجَة إيجابِيَّة)",
 "末香": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "本": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / رَئِيسِيّ / حَقِيقِيّ / وَاقِعِيّ / رِيَال (العُمْلَة الرسمية لدى)",
 "本しゅす": "أَطْلَس / صَقِيل",
 "本ちゃん": "أَدَاء / مَسْرَحِيَّة / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / اِرْتِفَاع / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "本に": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "本のムシ": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق)",
 "本の虫": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق)",
 "本ガス": "غاز المدينة (غاز فحم مصنع للاستخدام المنزلي والصناعي)",
 "本チャン": "أَدَاء / مَسْرَحِيَّة / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / اِرْتِفَاع / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "本丸": "نِوَاة",
 "本人確認": "التحقق من الهوية, القياسات الحيوية (التعرف التلقائي على الأفراد الأحياء باستخدام خصائصهم الفسيولوجية والسلوكية)",
 "本会": "جَلْسَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "本位": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "本位記号": "طَبِيعِيّ",
 "本位貨幣": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "本体": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / نُومِينُون",
 "本体論": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "本体部": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "本元": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "本初": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "本初子午線": "خَطّ الزَّوَال, خَطّ الطُّول الرَّئِيسِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "本券": "سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "本則": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "本務": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "本卦帰り": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "本卦還り": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "本命": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "本営": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "本因坊": "أستاذ كبير (لاعب ذو مهارة استثنائية أو عالمية في الشطرنج أو البريدج)",
 "本国": "وَطَن, مَوْطِن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "本国人": "أَصْلِيّ",
 "本土": "يَابِسَة, بَرّ",
 "本城": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "本場": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "本場風": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه) / صَحِيح, مَوْثُوق (مطابق للحقائق وبالتالي جدير بالتصديق)",
 "本塁": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما) / قاعدة المنزل ((بيسبول) قاعدة تتكون من لوح مطاطي حيث يقف الضارب؛ يجب أن يلمسها عداء القاعدة من أجل التسجيل)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本塁打": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "本契約": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "本好き": "محب للكتب, مولع بالكتب (شخص يحب الكتب (ويجمعها عادة))",
 "本字": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "本官": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "本家": "مُؤَسِّس, مُؤَسِّسَة",
 "本家本元": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "本審査": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "本尊": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى أيضًا وَثَنًا) / آيْدُول",
 "本局": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本屋": "متجر كتب, مكتبة (متجر تباع فيه الكتب) / دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "本州": "هُونْشُو",
 "本店": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本式": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "本当": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / أَصْلِيّ",
 "本当に": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "本当のところ": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "本当の所": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "本影": "منطقة الظل التام (منطقة من الظل الكامل ناتجة عن الانسداد الكلي للضوء)",
 "本意ない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه) / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "本意無い": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه) / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "本態性振戦": "رعاش مجهول السبب (رعاش غير معروف السبب (عادة في اليدين والرأس) يتطور لدى كبار السن؛ غالباً ما يخلط بينه وبين مرض باركنسون لكنه لا يهدد الحياة ويمكن عادة السيطرة عليه)",
 "本態性高血圧": "ارتفاع ضغط الدم الأساسي, فرط ضغط الدم الأولي (ارتفاع مستمر ومرضي في ضغط الدم لا يمكن العثور على سبب محدد له)",
 "本所": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本手": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "本拠": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "本拠地": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "本数": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "本文": "رِسَالَة, مِيسِيج",
 "本文批評": "نقد نصي (مقارنة نص معين بمواد ذات صلة من أجل إثبات أصالته)",
 "本方": "تَاجِر جُمْلَة / رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "本日": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار",
 "本有": "أَصَالَة, فِطْرِيَّة (صفة كون الشيء فطرياً)",
 "本有的": "فِطْرِيّ",
 "本望": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "本来": "أَصْلًا / أساساً, جوهرياً (في الجوهر؛ في الأصل أو بحكم الطبيعة)\nمثال: هو في الأساس غير صادق / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "本来から言えば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "本来であれば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "本来なら": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "本格化": "تسوية, تنظيم (فعل تحقيق التوحيد؛ جعله منتظماً) / تسوية, تنظيم (حالة ما تم جعله نظامياً (أو أكثر انتظاماً))",
 "本格派": "صفائي, متشدد في القواعد (شخص يصر على الدقة الكبيرة والصحة (خاصة في استخدام الكلمات))",
 "本格的": "أَصْلِيّ / شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "本案": "جَدَارَة",
 "本棚": "رَفّ كُتُب, رَفُّ الْكُتُب (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف.",
 "本極まり": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل ما تبقى هو إنفاذ الحكم)",
 "本権": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "本気": "جِدِّيَّة",
 "本気で": "بِجِدِّيَّة, بجد",
 "本気にする": "أَخَذَهُ عَلَى مَحْمَلِ الجِدِّ, أَخَذَهُ بِالجِدِّيَّة",
 "本気度": "جِدِّيَّة",
 "本決まり": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل ما تبقى هو إنفاذ الحكم)",
 "本決り": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل ما تبقى هو إنفاذ الحكم)",
 "本法": "دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "本流": "شراع رئيسي مربع (شراع رئيسي مربع الشكل) / الطبق الرئيسي (الطبق الأساسي في الوجبة) / الاتجاه العام, التيار السائد (تيار الفكر السائد)\nمثال: كان تفكيره ضمن التيار السائد الأمريكي",
 "本源": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "本然": "طَبِيعِيّ",
 "本物": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "本田": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "本番": "أَدَاء / مَسْرَحِيَّة / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / اِرْتِفَاع",
 "本番行為": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "本省": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما) / وزارة الداخلية (الإدارة الحكومية المسؤولة عن الشؤون الداخلية (خاصة في بريطانيا))\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本碁": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "本社": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "本立": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "本立て": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "本箱": "مَكْتَبَة, خِزَانَةُ الْكُتُب",
 "本節": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "本組み": "مَاكْيَاج, بُنْيَة",
 "本結び": "عقدة مربعة (عقدة مزدوجة مصنوعة من عقدتين نصفيتين وتستخدم لربط نهايات حبلين)",
 "本統": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "本線": "خط رئيسي (المسار الرئيسي لنظام النقل)",
 "本編": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي») / شَرِيط / فِيلْم سِينَمَائِيّ / تَصْوِير مُتَحَرِّك\nمثال: استمر الفلم ساعتين.",
 "本署": "قسم شرطة, مركز شرطة (محطة تعمل كمقر للشرطة في منطقة معينة؛ وتخدم كمكان يتم منه إرسال رجال الشرطة وإحضار الأشخاص المقبوض عليهم إليه)",
 "本美之主貝": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود الأمريكيين) / بطلينوس صلب (بطلينوس دائري ذو قشرة صلبة من الساحل الأطلسي؛ بطلينوس كبير يستخدم عادة للحساء أو أطباق البطلينوس الأخرى)",
 "本職": "مُحْتَرِف, مُحْتَرِفَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "本能": "غَرِيزَة, سَلِيقَة",
 "本能的": "غَرِيزِيّ, فِطْرِيّ (نابع من الغريزة أو كأنّه منها؛ بلا تفكير واعٍ)",
 "本腰": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية"
