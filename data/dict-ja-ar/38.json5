 "悪業": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي)",
 "悪気": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه / زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "悪液質": "متلازمة الهزال",
 "悪漢": "مُشَاغِب",
 "悪玉": "شخص سيء, شرير (شخص يلحق الأذى بالآخرين)",
 "悪玉コレステロール": "كوليسترول البروتين الدهني منخفض الكثافة (الكوليسترول الموجود في البروتينات الدهنية منخفضة الكثافة؛ الكوليسترول 'السيئ'؛ يُعتقد أن المستوى المرتفع منه في الدم يرتبط بحالات مرضية مختلفة)",
 "悪玉化": "كَبْش فِدَاء",
 "悪用": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "悪疫": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "悪癖": "رَذِيلَة",
 "悪目": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "悪知恵": "مَاكِر",
 "悪童": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "悪罵": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "悪習": "رَذِيلَة",
 "悪者": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "悪臭": "نَتَانَة",
 "悪臭を放つ": "نَتُنَ, نَتِنَ",
 "悪舌": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "悪茶利": "مزحة عملية, مَقلَب (خدعة أو مقلب يُدبّر لشخص ما (خاصة لجعل الضحية يبدو أحمقاً))",
 "悪虐": "بِشَاعَة, قَسْوَة / خِيَانَة",
 "悪虐無道": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "悪行": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي)",
 "悪言": "تَشْهِير, اِفْتِرَاء",
 "悪計": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "悪評": "خزي, سوء صيت (شهرة شريرة أو سمعة عامة سيئة) / خزي, عار (حالة من عدم الشرف الشديد)\nمثال: تاريخ سيعيش في الخزي",
 "悪賢い": "مَاكِر",
 "悪質": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة / لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صوف مُعاد (ألياف صوف مستصلحة)",
 "悪質化": "مُتَدَهْوِر, نَحْو الأَسْوَأ (يتغير للأسوأ) / إساءة, تدهور (تغيير شيء ما بحيث يصبح أسوأ) / تدهور, تردي (عملية التغير إلى حالة أدنى)\nمثال: قلق من العاصفة المتدهورة (تزداد سوءاً)",
 "悪質性": "حقد دفين, خبث (صفة الميل إلى الشر؛ سوء النية الشديد) / خباثة (حالة خبيثة؛ تقدمية ومقاومة للعلاج وتميل للتسبب في الوفاة)",
 "悪趣味": "بهرجة, صخب لوني (لون صارخ أو زخرفة مفرطة) / بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق) / خُبْث, سُوء (صفة كون الشيء غير سار للغاية) / خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / قذارة, نجاسة (حالة تتميز بالقذارة والنفايات الكريهة)\nمثال: جفلت من قذارة جرحه",
 "悪辣": "خَبِيث, مُحْتَال (يتّسم بالمهارة في الخداع والمكر)",
 "悪逆": "بِشَاعَة, قَسْوَة / خِيَانَة",
 "悪逆無道": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "悪逆非道": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "悪遊び": "مَقْلَب",
 "悪運": "نَحْس, سُوءُ الحَظّ",
 "悪銭": "حَرَام, غَيْر مَشْرُوع (مُكْتَسَب بِطُرُق غَيْر مَشْروعَة أَوْ غَيْر نَزيهَة)",
 "悪阻": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "悪霊": "روح شريرة (روح تميل لإحداث الضرر)",
 "悪露": "سائل النفاس, هُلاب (مادة تفرز من المهبل (حطام خلوي ومخاط ودم) وتتناقص تدريجياً في الكمية خلال الأسابيع التالية للولادة)",
 "悪風": "رَذِيلَة / عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
