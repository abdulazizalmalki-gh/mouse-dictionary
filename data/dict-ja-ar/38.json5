 "応募用紙": "استمارة طلب, نموذج تقديم (نموذج يستخدم عند تقديم طلب)",
 "応募者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "応化": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "応召兵": "مُجَنَّد",
 "応召者": "مجند إلزامي, مكلف (شخص يتم تجنيده في الخدمة العسكرية (غالباً بشكل إلزامي))",
 "応報": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "応変": "مَصْلَحَة ظَرْفِيَّة, مُلَائَمَة (صفة كون الشيء مناسباً للغابة المنشودة)",
 "応対": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "応当": "مُقَابِلٌ, مُنَاظِرٌ (مُصَاحِب ومُلازم)",
 "応急処置": "إجراء طوارئ (إجراء يتم اعتماده لمواجهة حالة طوارئ (خاصة الطوارئ الطبية))",
 "応急措置": "إِسْعَافَات أَوَّلِيَّة, إِسْعَاف أَوَّلِيّ",
 "応戦": "هُجُوم مُضَادّ",
 "応手": "استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق)\nمثال: رد فعل سيء للدواء",
 "応接": "اِسْتِقْبَال",
 "応接係": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "応接室": "غرفة الاستقبال الرسمية, غرفة الصالون (غرفة رسمية يمكن فيها استقبال الزوار والترفيه عنهم)",
 "応接間": "غرفة الاستقبال (غرفة لاستقبال وترفيه الزوار (كما في منزل خاص أو فندق))",
 "応援": "مُسَاعَدَة / مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق)\nمثال: انتهى كل شيء ما عدا الصياح",
 "応援者": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة)\nمثال: مساعدي الذي لا يقدر بثمن",
 "応用": "تَطْبِيق\nمثال: هذا الكتاب جديد / تبيقي (يهتم بالمشاكل أو البيانات الملموسة بدلاً من المبادئ الأساسية)\nمثال: فيزياء تطبيقية",
 "応用アソシエーション": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "応用プログラム": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص",
 "応用力": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "応用問題": "تَمْرِين, تَدْرِيب",
 "応用心理学": "علم النفس التطبيقي, علم النفس الصناعي (أي من عدة فروع لعلم النفس التي تسعى لتطبيق المبادئ النفسية على المشاكل العملية…)",
 "応用数学": "رياضيات تطبيقية (فروع الرياضيات المعنية بدراسة العالم المادي أو البيولوجي أو الاجتماعي)",
 "応用科学": "تكنولوجيا, علم الهندسة (التخصص الذي يتعامل مع فن أو علم تطبيق المعرفة العلمية على المشاكل العملية)\nمثال: واجه صعوبة في تحديد أي فرع من الهندسة سيدرس",
 "応答": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "応答メッセージ": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها…)\nمثال: ألقى زيري تحية.",
 "応答側": "مجيب (شخص يستجيب)",
 "応答時間": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "応答時間ウインドウ": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "応答能": "أهلية, جدارة (صفة التمتع بالمؤهلات البدنية والفكرية الكافية)",
 "応訴": "دعوى مضادة (دعوى مرفوعة ضد شخص قام بمقاضاتك)",
 "応諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا.",
 "応酬": "تَبْدِيل, تَبَادُل / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
