 "日記": "دَفْتَرُ يَوْمِيّاتٍ, يَوْمِيَّات",
 "日記帳": "دَفْتَرُ يَوْمِيّاتٍ, يَوْمِيَّات",
 "日誌": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل) / دفتر يومية, سجل (كتاب سجل كشيء مادي) / مذكرات, يوميات (سجل كتابي يومي للتجارب والملاحظات (الشخصية عادة)) / دورية, مجلة علمية (دورية مخصصة لموضوع معين)\nمثال: يقرأ المجلات الطبية",
 "日語": "يَابَانِيّ",
 "日足": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "日輪": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "日輪草": "زَهْرَة اَلشَّمْس, دَوَّار اَلشَّمْس",
 "日避猿": "ليمور طائر (ثديي شجري ليلي من جنوب شرق آسيا والفلبين يشبه الليمور وله طية من الجلد على كل جانب من الرقبة إلى الذيل تستخدم للقفزات الانزلاقية الطويلة)",
 "日配品": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "日銀": "بنك اليابان (البنك المركزي لليابان)",
 "日銀短観": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "日録": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل) / دفتر يومية, سجل (كتاب سجل كشيء مادي) / مذكرات, يوميات (سجل كتابي يومي للتجارب والملاحظات (الشخصية عادة)) / دورية, مجلة علمية (دورية مخصصة لموضوع معين)\nمثال: يقرأ المجلات الطبية",
 "日長石": "أفينتورين, حجر الشمس (كوارتز نصف شفاف مرصع بقطع صغيرة من الميكا أو معادن أخرى)",
 "日間": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "日除け": "مَظَلَّة / مَظَلَّة, شَمْسِيَّة",
 "日陰": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "日陰蔓": "صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج الصنوبر؛ أوروبا والجزر البريطانية وشمال إفريقيا) / صنوبر أرضي (أي من عدة طحالب نادي ذات سيقان زاحفة طويلة وفروع منتصبة)",
 "日雀": "قرقف فحمي",
 "日雇": "مُياوِم",
 "日雇い": "مُياوِم",
 "日雇い労働者": "مُياوِم",
 "日雇労働者": "مُياوِم",
 "日頃": "عَادَةً, الاَكْثِرْ",
 "日頃の行い": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "日食": "كُسُوف اَلشَّمْس",
 "旦つく": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "旦夕": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "旦日": "غَدًا, الْغَد (اليومُ الذي يأْتي بعدَ اليوم الحالي، اليوم التالي؛ قد يراد به القريب من الزمان) / غَد, بُكرة (اليوم الذي يأتي بعد اليوم الذي أنت فيه؛ أي يوم يأتي في المستقبل، قرب أو بعد، على ال)\nمثال: لربما تمطر غدا.",
 "旦那": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق. / شوجر دادي (رجل ثري أكبر سناً يقدم هدايا باهظة لشخص شاب مقابل الصداقة أو العلاقة الحميمة)",
 "旦那さま": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "旦那様": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "旦那氏": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "旦那芸": "الهواية, مبدأ الهواية (القناعة بوجوب ممارسة الرياضة كهواية (للمتعة) وليس من أجل المال)",
 "旦那衆": "رجل, رفيق (صبي أو رجل) / رجل محترم, سيد (اختصار غير رسمي لـ \"رجل نبيل\")\nمثال: ذلك الرجل هو مضيفك",
 "旧": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة. / أيام الخوالي (أوقات ماضية يتم تذكرها بحنين) / سَابِق / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "旧る": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "旧世界": "الْعَالَم الْقَدِيم",
 "旧世界猿": "قرد العالم القديم (من أفريقيا أو الجزيرة العربية أو آسيا؛ له ذيول غير قابضة وفتحتا أنف متقاربتان)",
 "旧事": "سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / ما فات, ما مضى (أحداث ماضية يجب وضعها جانباً)\nمثال: دع ما فات يموت",
 "旧人": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "旧例": "تَقْلِيد",
 "旧典": "تَقْلِيد",
 "旧北区": "مِنْطَقَة قُطْبِيَّة شَمَالِيَّة قَدِيمَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "旧名": "اِسْم بَتُولَة, اِسْم فَتَاةٍ قَبْلَ زَوَّاج (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "旧国": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "旧址": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "旧型": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "旧墟": "خَرَاب, خَرَابَة / دَمَّرَ",
 "旧大陸": "الْعَالَم الْقَدِيم",
 "旧太陽暦": "التقويم الشرقي",
 "旧套": "تَقْلِيدِيَّة, عُرْفِيَّة (الأرثوذكسية كنتيجة لكون الشخص تقليدياً)",
 "旧姓": "اِسْم بَتُولَة, اِسْم فَتَاةٍ قَبْلَ زَوَّاج (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "旧幕": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "旧年": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "旧弊": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)\nمثال: 旧弊な人は新しい事になじめない。 — لا يمكنك تعليم كلب عجوز حيلا جديدة. / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "旧式": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "旧思想": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "旧故": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "旧教": "كَاثُولِيكِيَّة, جَاثَلِيقِيَّة",
 "旧教徒": "كَاثُولِيكِيّ, جَاثَلِيقِيّ",
 "旧来": "تَقْلِيدِيّ",
 "旧正月": "رَأْس السَّنَة الصِّينِيَّة, عِيد الرَّبِيع (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "旧波": "المحافظون, المدرسة القديمة (فئة من الناس يفضلون الأفكار التقليدية)",
 "旧派": "المحافظون, المدرسة القديمة (فئة من الناس يفضلون الأفكار التقليدية)",
 "旧流": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "旧皮質": "قشرة عتيقة (القشرة الشمية للمخ)",
 "旧石器": "أداة باليوليثية, أداة من العصر الحجري القديم (أداة حجرية من العصر الحجري القديم)",
 "旧石器時代": "باليوليثي, حجري قديم (من أو متعلق بالفترة الثانية من العصر الحجري (تلي العصر الحجري الفجري))\nمثال: قطع أثرية من العصر الحجري القديم",
 "旧約": "اَلْعَهْد اَلْقَدِيم",
 "旧約全書": "اَلْعَهْد اَلْقَدِيم",
 "旧約聖書": "اَلْعَهْد اَلْقَدِيم",
 "旧衣": "بَالٍ",
 "旧趾": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "旧邦": "أرض الأجداد, البلد القديم (بلد الأصل للمهاجر)",
 "旧里": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "旨": "مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "旨々": "بِنَجَاحٍ / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "旨い": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "旨い汁": "حِصَّةُ الأَسَد",
 "旨がる": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / تلذذ, شغف (استمتاع قوي ومتحمس) / ريليش, مقبلات مخللة (تابل حار أو لذيذ)",
 "旨く": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "旨み": "لَذَّة / أُومَامِي / مَهَارَة / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "旨意": "نِيَّة",
 "旨旨": "بِنَجَاحٍ / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "旨趣": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "旨酒": "مُرْتَفِع الدَّرَجَة",
 "早": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早々": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة / بِسُرْعَة, عَاجِلًا / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早い": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "早いこと": "بِسُرْعَة, عَاجِلًا",
 "早いとこ": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "早いところ": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "早いもので": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "早い事": "بِسُرْعَة, عَاجِلًا",
 "早い所": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "早い物で": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "早い話が": "بِاخْتِصَار",
 "早う": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早かれ遅かれ": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "早かろう悪かろう": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "早がわり": "مَسْخ",
 "早く": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / بِسُرْعَة, عَاجِلًا",
 "早くから": "في وقت مبكر, مبكراً (خلال مرحلة مبكرة)\nمثال: في وقت مبكر من مسيرتها المهنية",
 "早くも": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "早さ": "سُرْعَة / تبكير (صفة المجيء مبكراً أو في وقت أسبق)",
 "早すぎる": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "早まる": "أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "早め": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早めに": "قبل الأوان, مبكراً (قبل الوقت المعتاد أو المتوقع)\nمثال: تخرجت مبكراً",
 "早める": "يقرب / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "早よ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早わかり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "早わざ": "مَأْثَرَة",
 "早乙女": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "早付け木": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "早付木": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "早分かり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "早分り": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "早口言葉": "جملة صعبة النطق, عقدة لسان (تعبير يصعب نطقه بوضوح)",
 "早咲き": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "早回し": "مسح, مسح ضوئي (فعل تحريك شعاع ضوئي أو إلكتروني بؤري بدقة بشكل منهجي فوق سطح ما لإنتاج صورة له للتحليل أو الإرسال) / مسح ضوئي (عملية ترجمة الصور إلى شكل رقمي يمكن للكمبيوتر التعرف عليه)",
 "早変り": "مَسْخ",
 "早変わり": "مَسْخ",
 "早天": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "早少女": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "早尚": "ابتسار, سابق لأوانه (حالة كون الشيء سابقاً لأوانه)",
 "早急": "فَوْرِيّ",
 "早成": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر) / مبكر النضوج, نابغ (يتميز بالتطور أو النضج المبكر بشكل استثنائي (خاصة في القدرات العقلية))\nمثال: طفل نابغ",
 "早手": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "早技": "مَأْثَرَة",
 "早早": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة / بِسُرْعَة, عَاجِلًا / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早晩": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "早暁": "فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "早替り": "مَسْخ",
 "早替わり": "مَسْخ",
 "早期老化症": "شيخوخة مبكرة (شذوذ نادر يتميز بالشيخوخة المبكرة (شيب الشعر وتجاعيد الجلد وانحناء الظهر) لدى الطفل)",
 "早期警戒情報": "خَاطَ (خَطَّ، خَيطَ في إبرة أو آلة؛ وَصَلَ أو أَصَّلَ أجزاء معًا باستخدام الخيط) / خَيَّطَ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: خاط سامي جيبه المثقوب.",
 "早梅": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "早業": "مَأْثَرَة",
 "早漏": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب في المهبل)",
 "早瀬": "سَرِيع",
 "早熟": "نبوغ مبكر, نضج مبكر (الذكاء الذي يتحقق قبل الجداول الزمنية النمائية الطبيعية بكثير)",
 "早生児": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "早産児": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "早発性痴呆": "شيزوفرينيا, فصام (أي من الاضطرابات الذهانية العديدة التي تتميز بتشوهات الواقع واضطرابات التفكير واللغة والانسحاب من التواصل الاجتماعي)",
 "早発性痴呆症": "شيزوفرينيا, فصام (أي من الاضطرابات الذهانية العديدة التي تتميز بتشوهات الواقع واضطرابات التفكير واللغة والانسحاب من التواصل الاجتماعي)",
 "早目": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "早目に": "قبل الأوان, مبكراً (قبل الوقت المعتاد أو المتوقع)\nمثال: تخرجت مبكراً",
 "早稲田電子専門学校": "وعي, إدراك (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "早老症": "شيخوخة مبكرة (شذوذ نادر يتميز بالشيخوخة المبكرة (شيب الشعر وتجاعيد الجلد وانحناء الظهر) لدى الطفل)",
 "早耳": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "早見": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "早計": "مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ)",
 "早起き": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح) / باكور, مبكر (شخص يصل مبكرًا قبل الآخرين)",
 "早起きは三文の得": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "早起きは三文の徳": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "早足": "سير سريع (المسير بتوقيت سريع) / خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "早速": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "早過ぎる": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "早道": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد)",
 "早鐘": "جرس الإنذار, ناقوس الخطر (صوت إنذار (عادة جرس))",
 "早鐘を打つ": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "早附け木": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "早附木": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "早馬": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "旬": "مَوْسِم / مَوْسِم, جُزْء / مَحْبُوب / عَقْد (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "旬外れ": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "旭": "تفاح ماكنتوش (تفاح مبكر النضج شائع في شمال شرق الولايات المتحدة؛ يؤكل نيئًا بشكل أساسي ولكنه مناسب لصلصة التفاح)",
 "旱": "جَفَاف",
 "旱り": "جَفَاف",
 "旱天": "جَفَاف",
 "旱魃": "جَفَاف",
 "旺然": "سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "旺盛": "دَجِر",
 "昂じる": "طَوَّرَ",
 "昂ずる": "طَوَّرَ",
 "昂ぶり": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "昂り": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "昂揚": "منسوب",
 "昂揚感": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله)) / سرب قُبَّرَات (سرب من طيور القُبَّرَة (خاصة أثناء الطيران)) / شرف (موقع كوكب في دائرة البروج يُعتقد أنه يمارس فيه أقصى تأثير له) / انخطاف, طرب (حالة من الانجراف وراء عاطفة غامرة)\nمثال: الاستماع إلى الموسيقى العذبة في نشوة تامة",
 "昂然": "مبتهج, مسرور جداً (فخور ومسرور بانتشاء؛ في معنويات عالية) / فَرِح, مُبْتَهِج (مليء ببهجة نشيطة ومرحة)\nمثال: الفائز المبتهج",
 "昂進": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "昆布": "عشب البحر, كيلب (أعشاب بحرية بنية كبيرة لها سعف جلدي متموج)",
 "昆弟": "أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "昆明": "كُونْمِينْج, كُونْمِينْغ",
 "昆虫": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية.",
 "昆虫学": "عِلْم اَلْحَشَرَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "昆虫学者": "عالم حشرات (عالم حيوان يدرس الحشرات)",
 "昆虫恐怖症": "رهاب الحشرات (خوف مرضي من الحشرات)",
 "昇り": "صُعُود, تَسَلُّق / مُتَّجِهٌ لِلْأَعْلَى (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا صُعُودًا)",
 "昇り藤": "ذِئْبِيّ",
 "昇る": "صَعِد",
 "昇交点": "عقدة صاعدة (النقطة التي يتقاطع فيها المدار مع مستوى مسار الشمس متجهاً شمالاً)",
 "昇任": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇叙": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇圧剤": "رافع ضغط الدم, مُقَبِّض وعائي (أي عامل يسبب تضيق الأوعية وارتفاع ضغط الدم (يُفهم عادة على أنه زيادة الضغط الشرياني))",
 "昇圧機": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى) / صاروخ معزز, معزز الإقلاع (المرحلة الأولى من صاروخ متعدد المراحل) / محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة) / سارق متاجر (لص يسرق البضائع الموجودة في متجر)",
 "昇圧薬": "رافع ضغط الدم, مُقَبِّض وعائي (أي عامل يسبب تضيق الأوعية وارتفاع ضغط الدم (يُفهم عادة على أنه زيادة الضغط الشرياني))",
 "昇天": "صُعُود, اِرْتِقَاء / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "昇天祭": "عِيد الصُعُود, يَوْم الصُعُود",
 "昇格": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇格人事": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇段": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇汞": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد للآفات أو مطهر أو مادة حافظة للخشب)",
 "昇温": "مُدَفِّئ, مُسَخِّن (يُنتِج إحساساً بالحرارة عند وضعه على الجسم) / مُدْفِئ (يمنح الدفء والحرارة) / دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد) / تدفئة, تسخين (عملية التحول إلى الدفء؛ ارتفاع درجة الحرارة)\nمثال: رحبوا بذوبان الجليد الربيعي",
 "昇級": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇華": "تسامي ((في علم النفس) تعديل التعبير الطبيعي عن دافع أو غريزة (خاصة الجنسية) إلى تعبير مقبول اجتماعياً) / تسامي ((في الكيمياء) تغير مباشر من الحالة الصلبة إلى الغازية دون المرور بالحالة السائلة)",
 "昇華熱": "حرارة التسامي (حرارة تمتصها وحدة كتلة من مادة عندما تتغير من حالة صلبة إلى غازية)",
 "昇藤": "ذِئْبِيّ",
 "昇進": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇進人事": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "昇開橋": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "昇降口": "دُخُول / مَدْخَل",
 "昇降機": "مِصْعَدْ",
 "昇降舵": "مِصْعَدْ",
 "昇順整列": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / فَرَزَ\nمثال: انه نوع من الفطر.",
 "昌平": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "昌運": "اِزْدِهَار, رَخَاء",
 "明": "تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا / إتْيَان, أَتْي / سُطُوع / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة / بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة. / سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644) / بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح / بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة) / بِنَظَافَة (بطريقة تقلل من الأوساخ والتلوث) / نَظِيف بِطَبْعِه (يتّسم بالنظافة عادةً وبشكل معتاد)\nمثال: هبط لاعب الجمباز بلا عيب",
 "明か": "شَفَّاف / وَاضِح",
 "明かし": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "明かす": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد. / بَرْهَنَ, أَثْبَتَ",
 "明かへん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "明かり": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / بُرْهَان, دَلِيل",
 "明かり取り": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "明かり窓": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه) / نافذة العارضة (نافذة فوق الباب تكون عادة مفصلية بعارضة أفقية فوق الباب)",
 "明き": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة. / رَاحَة, خُلُو مِنَ الْعَمَل / إهمال, عدم استخدام (حالة الشيء الذي لم يستخدم وتم إهماله)\nمثال: كان المنزل في حالة إهمال رهيبة",
 "明きめくら": "كُمْنَة",
 "明き巣": "سَطْو / لُصُوصِيَّة\nمثال: 空巣にやられた。 — سُرق منزلنا عندما كنا مسافرين.",
 "明き盲": "كُمْنَة",
 "明く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "明くる": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "明くる年": "السَّنَة الْقادِمَة",
 "明け": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "明けおめ": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "明けそめる": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "明けておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "明けても暮れても": "طوال الوقت, يوماً بعد يوم (دون توقف)\nمثال: يلعب الشطرنج يوماً بعد يوم",
 "明けの明星": "نَجْمَة الصَّبَاح",
 "明けへん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "明けましておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "明ける": "فَارِغ / فَرَغَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "明け初める": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "明け広げ": "غَيْر مُتَيَقِّظ, مَكْشُوف (لا يُبدي أيّ حذر أو احتراس) / غَيْرُ مَحْرُوس (يَفْتَقِرُ إِلَى الحِرَاسَةِ أَوِ الحِمَايَة)",
 "明け払う": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "明け放し": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "明け方": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "明け暮れ": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "明け暮れる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "明け染める": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "明け渡し": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "明け渡す": "أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "明け番": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "明け透け": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "明つ神": "قَيْصَر, إِمْبْرَاطُور",
 "明の明星": "نَجْمَة الصَّبَاح",
 "明へん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "明らか": "شَفَّاف / وَاضِح / لَامِع, نَيِّر / مُسْتَنِير",
 "明らかにする": "اِسْتَجْلَى",
 "明らめる": "اِسْتَجْلَى",
 "明り取り": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "明り窓": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه) / نافذة العارضة (نافذة فوق الباب تكون عادة مفصلية بعارضة أفقية فوق الباب)",
 "明るい": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / لَامِع, نَيِّر / مُسْتَنِير / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / عَارِف / عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "明るさ": "سُطُوع",
 "明るみ": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "明呪": "تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا",
 "明哲": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "明喩": "تَشْبِيه",
 "明媚": "بَدِيع المَنْظَر, خَلَّاب (يوحي بأنه مناسب لصورة؛ جميل كاللوحة) / بَدِيع, خَلَّاب (جذّاب بصريّاً بألوانه وتفاصيله الحيّة)",
 "明察": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "明年": "السَّنَة الْقادِمَة",
 "明度": "سُطُوع",
 "明弁": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "明後日": "بَعْدَ غَدٍ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مثال: و بعد قليل أتى. / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "明徳": "فَضِيلَة / عِفَّة, طَهَارَة",
 "明徴": "تَوْضِيح",
 "明快": "شَفَّاف / وَاضِح",
 "明所視": "رؤية ضوئية, رؤية نهارية (رؤية طبيعية في ضوء النهار؛ رؤية بإضاءة كافية لتنشيط المخاريط وإدراك تدرج اللون)",
 "明敏": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "明文化": "اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "明方": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "明日": "غَدًا, الْغَد (اليومُ الذي يأْتي بعدَ اليوم الحالي، اليوم التالي؛ قد يراد به القريب من الزمان) / غَد, بُكرة (اليوم الذي يأتي بعد اليوم الذي أنت فيه؛ أي يوم يأتي في المستقبل، قرب أو بعد، على ال)\nمثال: لربما تمطر غدا.",
 "明星": "نَجْمَة الصَّبَاح / إِجَّامَة / نَجْمَة",
 "明晰": "شَفَّاف / وَاضِح",
 "明智": "حصافة, حكمة (سمة تكوين الآراء عن طريق التمييز والتقييم) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)",
 "明暗境界線": "مُبِيد (مَادَّةٌ كيميائيَّة سَامَّةٌ تُستخدم لإِبَادَةِ الْحَشَرَاتِ والجراثيم)\nمثال: اشترى ياني مبيد النمل.",
 "明月": "قمر الحصاد (القمر المكتمل الأقرب إلى الاعتدال الخريفي (في سبتمبر)) / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "明朗": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / شَفَّاف / وَاضِح",
 "明朝": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "明朝体": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "明渡": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "明渡し": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "明滅": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "明澄": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح) / مَنْطِقِيّ, مُتَمَاسِك (قادر على التفكير والتعبير بوضوح واتّساق) / صَافِي الذِّهْن, وَاعٍ (ذو عقل صافٍ وواضح الإدراك)",
 "明白": "بَدِيهِيّ, بَدَهِيّ",
 "明盲": "كُمْنَة",
 "明瞭": "شَفَّاف / وَاضِح\nمثال: その２語の用法の区別は明瞭である。 — الفرق في الاستخدام بين الكلمتين واضح.",
 "明瞭度": "مَفْهُومِيَّة, وُضُوح المَعْنَى (صفة اللغة التي تكون مفهومة) / تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري",
 "明確": "شَفَّاف / وَاضِح",
 "明確化": "تَوْضِيح",
 "明礬": "شَبّ",
 "明示": "إيضاح, تبيان (تفسير يزيل عقبات الفهم) / تبيان, توضيح (فعل الشرح الذي يخدم في إزالة الغموض وإلقاء الضوء)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي",
 "明示的": "صريح",
 "明示的並列命令コンピューティング技術": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "明神": "قَيْصَر, إِمْبْرَاطُور",
 "明細": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / مُفَصَّل",
 "明細書": "مُوَاصَفَة",
 "明言": "إِعْلَان, بَيَان",
 "明記": "مُوَاصَفَة",
 "明証": "بُرْهَان, دَلِيل",
 "明辨": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "明達": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "明順応": "تأقلم مع الضوء (عملية تكيف العينين مع مستويات عالية نسبياً من الإضاءة؛ تتقلص الحدقة وينشط نظام المخاريط)",
 "昏倒": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "昏冥": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "昏睡": "غَيْبُوبَة / نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "昏迷": "تخدير, ذهول (فعل جعل الشخص متبلد الشعور أو خاملاً) / ترنح, ذهول (وعي هامشي) / انصعاق, ذهول (شعور بالدهشة المذهلة)\nمثال: اشتهر الأستاذ بجعل طلابه في حالة ذهول",
 "昏迷状態": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "易": "سُهُولَة",
 "易々": "بِسُهُولَة / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "易い": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "易き": "سُهُولَة",
 "易しい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "易を見る": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "易刺激性": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "易動度": "حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
 "易化": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد)",
 "易怒性": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "易感染性": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "易断": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "易易": "بِسُهُولَة / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "易者": "عراف, قاريء البخت (شخص يتنبأ بمستقبلك الشخصي)",
 "昔": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "昔々": "قَدِيماً",
 "昔々あるところに": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "昔々ある所に": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "昔かたぎ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔ながら": "غَيْر مُغَيَّر (باقٍ في حالة أصلية) / ثَابِت, غَيْر مُتَغَيِّر (لم يُصنع أو يصبح مختلفاً)\nمثال: استمر غير متغير عبر الزمن",
 "昔人": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط الإمبراطورية الرومانية في أوروبا الغربية))",
 "昔人間": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔堅気": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔年": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "昔式": "أولد فاشن (كوكتيل مصنوع من الويسكي والبيترز والسكر مع شرائح الفاكهة)",
 "昔昔": "قَدِيماً",
 "昔時": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "昔気質": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔者": "عجوز, كبير السن (شخص متقدم في السن)",
 "昔蜥蜴": "تواتارا (العضو الوحيد الباقي من رتبة منقاريات الرأس من الزواحف الكبيرة الشائكة الشبيهة بالسحالي ثنائية الثقوب في الجزر الساحلية قبالة نيوزيلندا)",
 "昔話": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس) / استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "昔語": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "昔語り": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "昔風": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "星": "إِجَّامَة / نَجْمَة / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط / إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة. / مذنب, مرتكب الجريمة (شخص يرتكب مخالفة) / سِنْغَافُورَة (دولة مدينة تقع في جنوب شرق قارة آسيا البحري جنوب شبه جزيرة ملايو وشمال مضيق سنغافورة، اسمها الرسمي جمهورية سنغافورة)",
 "星々": "سورة النجم",
 "星くず": "خيال حالم, سحر رومانسي (صفة رومانسية حالمة أو عاطفية)",
 "星さま": "إِجَّامَة / نَجْمَة",
 "星になる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "星を落とす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "星光": "ضوء النجوم (ضوء النجوم)",
 "星列": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة",
 "星占い": "تَنْجِيم",
 "星占い師": "مُنَجِّم, مُنَجِّمَة",
 "星印": "إِجَّامَة / نَجْمَة / إِجَّامَة, نُجَيْمَة",
 "星口動物": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها مظهر الفول السوداني)",
 "星図": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء)",
 "星型": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "星型六角形": "نجمة سداسية (مضلع منتظم يتكون من مد كل ضلع من أضلاع مسدس منتظم لتشكيل مثلثين متساويي الأضلاع)",
 "星学": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "星官": "كَوْكَبَة",
 "星宝貝": "ودعة النمر (ودعة تستخدم صدفتها للزينة)",
 "星宿": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "星屎": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "星屑": "خيال حالم, سحر رومانسي (صفة رومانسية حالمة أو عاطفية)",
 "星座": "كَوْكَبَة / برج, برج فلكي ((علم التنجيم) واحدة من 12 منطقة متساوية تنقسم إليها دائرة البروج)",
 "星座図": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء)",
 "星座投影機": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية) / قبة فلكية (جهاز بصري لعرض صور الأجرام السماوية والظواهر الفلكية الأخرى على السطح الداخلي لقبة نصف كروية) / بلانيتاريوم, قبة فلكية (مبنى يضم أداة لعرض مواقع الكواكب على سقف مقبب)",
 "星形": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "星彩": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة / ضوء النجوم (ضوء النجوم)",
 "星影": "ضوء النجوم (ضوء النجوم)",
 "星斗": "إِجَّامَة / نَجْمَة",
 "星明かり": "ضوء النجوم (ضوء النجوم)",
 "星明り": "ضوء النجوم (ضوء النجوم)",
 "星星": "سورة النجم",
 "星月": "إِجَّامَة / نَجْمَة",
 "星条旗": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "星条旗新聞": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "星椋鳥": "زرزور شائع (طائر اجتماعي ذو ريش بلمعان معدني داكن؛ يبني أعشاشاً حول المساكن والهياكل الأخرى؛ متوطن في جميع أنحاء العالم)",
 "星様": "إِجَّامَة / نَجْمَة",
 "星河": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "星漢": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "星状体": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "星石": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "星章": "إِجَّامَة / نَجْمَة",
 "星系": "نِظَام نَجْمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "星群": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة",
 "星草": "عشبة الغليون (نبات مائي معمر في أمريكا الشمالية وأيرلندا وجزر هبريدس له أوراق خضراء شفافة في لولب قاعدي وعناقيد كثيفة تشبه الأزرار من الزهور البيضاء الدقيقة)",
 "星虫": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها مظهر الفول السوداني)",
 "星蝕": "احْتِجَاب / الغَيْبَة",
 "星辰": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "星間": "بين النجوم (يقع بين أو وسط النجوم)\nمثال: كثافة الهيدروجين في الفضاء بين الكواكب وبين النجوم",
 "星間空間": "الفضاء بين النجوم, فضاء بين نجمي (الفضاء الموجود بين النجوم)",
 "星雲": "سَدِيم / مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "星雲説": "فرضية سديمية ((علم الكونيات) النظرية القائلة بأن النظام الشمسي تطور من سديم غازي ساخن)",
 "星霜": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "星食": "احْتِجَاب / الغَيْبَة",
 "星鼻土竜": "خلد نجمي الأنف (خلد برمائي من شرق أمريكا الشمالية له مجسات لحمية وردية حول الأنف)",
 "映え": "مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به) / مَجْد, شَرَف (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا / جَذَّاب, مُغْرٍ (قادر على جذب الاهتمام أو لفت الانتباه الإيجابي) / جذاب, محبوب ((للشخصيات في الأدب أو الدراما) تثير مشاعر التعاطف أو الإعجاب)\nمثال: أضاف شخصية جذابة لا تُنسى إلى الأساطير الأمريكية الشعبية",
 "映える": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "映し出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / وَصَفَ / عَكَسَ",
 "映し絵": "صورة شعاعية (صورة فوتوغرافية منتجة على سطح حساس للإشعاع بواسطة إشعاع غير الضوء المرئي (خاصة الأشعة السينية أو أشعة غاما))",
 "映じる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "映す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "映ずる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "映り": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "映りこむ": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "映り行く": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "映り込む": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "映る": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "映像": "صُورَة / اِنْطِبَاع, سُمْعَة / فِيدِيُو, فيديو / اِنْعِكَاس, عَكْس",
 "映像作家": "سينمائي, صانع أفلام (منتج للأفلام السينمائية)",
 "映像圧縮": "ضغط الصور (ضغط الرسومات للتخزين أو الإرسال)",
 "映像媒体": "تسجيل فيديو, فيديو (تسجيل للمكونات المرئية والمسموعة (خاصة تلك التي تحتوي على تسجيل لفيلم أو برنامج تلفزيوني))",
 "映写": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "映写幕": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "映写機": "جِهَاز إِسْقَاط",
 "映射": "عَاكِسٌ لِلضَّوْء (يُسبِّب الانعكاس أو يحتوي على جهاز عاكس)",
 "映画": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي») / شَرِيط / فِيلْم سِينَمَائِيّ / تَصْوِير مُتَحَرِّك\nمثال: استمر الفلم ساعتين.",
 "映画スター": "نجم سينمائي (نجم يلعب أدوار البطولة في السينما)",
 "映画作家": "سينمائي مبدع, مخرج مؤلف (صانع أفلام له أسلوب شخصي ويحتفظ بالسيطرة الإبداعية على أعماله)",
 "映画俳優組合": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "映画学校": "مدرسة سينما (أي مؤسسة تعليمية مخصصة لتدريس جوانب صناعة الأفلام، بما في ذلك مواضيع مثل إنتاج الأفلام ونظرية الفيلم وإنتاج الوسائط الرقمية وكتابة السيناريو)",
 "映画監督": "مُخْرِج, مُخْرِجَة",
 "映画研究": "دراسات سينمائية (تخصص أكاديمي يتعامل مع مختلف المناهج النظرية والتاريخية والنقدية للأفلام)",
 "映画祭": "مهرجان أفلام, مهرجان سينمائي (مهرجان سينمائي يعرض الأفلام (عادة الأفلام المنتجة خلال العام الماضي))",
 "映画芸術科学協会": "أكاديمية فنون وعلوم الصور المتحركة (أكاديمية تمنح جوائز سنوية للإنجازات في إنتاج الصور المتحركة والأداء)",
 "映画館": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "映研": "دراسات سينمائية (تخصص أكاديمي يتعامل مع مختلف المناهج النظرية والتاريخية والنقدية للأفلام)",
 "春": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة. / السَّنَة الْجَدِيدَة / مُمْتَاز, فَاخِر / مُرَاهَقَة",
 "春の宮": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "春の目覚め": "بُلُوغ",
 "春の野芥子": "تِفَاف, جَعْضِيض",
 "春休": "عُطْلَة الرَّبِيع, إِجَازَة الرَّبِيع",
 "春休み": "عُطْلَة الرَّبِيع, إِجَازَة الرَّبِيع",
 "春分": "اعتدال ربيعي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة الحوت) / اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "春分点": "اعتدال ربيعي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة الحوت) / اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "春夏冬": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "春婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "春宮": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "春巻": "سبرينغ رول, لفافة البيض (خضروات ولحم مفروم ملفوف في فطيرة ومقلية)",
 "春巻き": "سبرينغ رول, لفافة البيض (خضروات ولحم مفروم ملفوف في فطيرة ومقلية)",
 "春情": "شَهْوَة",
 "春意": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "春機": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "春機発動期": "بُلُوغ",
 "春水": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "春泥": "وَحْل (الخوض في الوَحَل؛ لغة رديئة من وَحَل؛ وهو الطين الخفيف الذي فيه ماء كثير) / سلاش\nمثال: علقت السيارة في الوحل.",
 "春眠": "نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "春秋": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "春節": "رَأْس السَّنَة الصِّينِيَّة, عِيد الرَّبِيع (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "春紫菀": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة البيضاء أو الوردية النحيلة جداً؛ الولايات المتحدة وكندا)",
 "春菊": "أقحوان تاجي (نبات سنوي شجيري في منطقة البحر الأبيض المتوسط بزهور بيضاء مصفرة)",
 "春陽": "ربيع (موسم النمو)\nمثال: البراعم الناشئة كانت علامة أكيدة على الربيع",
 "春駒": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب) / أسطوانة مشروخة, موضوع مفضل (موضوع يعود إليه الشخص باستمرار)",
 "昧旦": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "昧爽": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "昨": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "昨今": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "昨夕": "اَلْبَارِحَةَ",
 "昨夜": "اَلْبَارِحَةَ",
 "昨年": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "昨日": "أَمْس / أَمْسِ",
 "昨晩": "اَلْبَارِحَةَ\nمثال: 君は昨晩外出しましたか。 — هل خرجت ليلة الأمس؟",
 "昨週": "اَلْأُسْبُوع السّابِق",
 "昭々": "شَفَّاف / وَاضِح",
 "昭和": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昭昭": "شَفَّاف / وَاضِح",
 "昭然": "ظَاهِر (اسم فاعل من ظَهَرَ هو الذي يَظْهَر على عدوه؛ ضد الباطن) / بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل) / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: كل شئ ظاهر على وجهه.",
 "昭示": "إيضاح, تبيان (تفسير يزيل عقبات الفهم) / تبيان, توضيح (فعل الشرح الذي يخدم في إزالة الغموض وإلقاء الضوء)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي",
 "是": "استقامة, بر (التمسك بالمبادئ الأخلاقية)",
 "是が非でも": "بِأَيِّ ثَمَنٍ",
 "是とする": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "是正": "تَصْحِيح",
 "是正措置": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تصحيح, تعديل (فعل تقديم تحسين لاستبدال خطأ؛ تقويم) / تقويم (تحويل التيار المتردد إلى تيار مباشر) / تقطير, تكرير ((في الكيمياء) عملية تكرير أو تنقية مادة ما عن طريق التقطير)",
 "是者": "مُقَامِر / مُغَامِر",
 "是認": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "是非": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / مَحَاسِن وَمَسَاوِئ",
 "是非とも": "بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "是非ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "是非に及ばず": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "是非もない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "是非もなし": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "是非も無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "是非も無し": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "是非共": "بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "是非善悪": "أدب, صواب (السلوك الصحيح أو المناسب)",
 "是非是非": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "是非無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "昴": "الثُّرَيَّا",
 "昴宿": "الثُّرَيَّا",
 "昴星": "الثُّرَيَّا",
 "昵懇": "أُلْفَة",
 "昵近": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / ألفة, حميمية (صداقة وثيقة أو دافئة) / أُلْفَة, دِرَايَة (الاعتيادية بحكم كون الشيء مألوفاً أو معروفاً جيداً) / تلقائية, عفوية (أسلوب عفوي)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "昼": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل! / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼ごはん": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼ご飯": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "昼すぎ": "بَعْد الظُّهْر, بَعْدَ الزَّوَال (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "昼の部": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "昼ひなか": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "昼も夜も": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "昼ドラ": "تَمْثِيلِيَّة, مُسَلْسَلَات تِلِفِزْيُونِيَّة",
