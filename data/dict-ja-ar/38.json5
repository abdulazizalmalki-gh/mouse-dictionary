 "新潟": "نيغاتا, نييغاتا",
 "新版": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "新玉の": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "新生": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "新生児死亡": "وفاة حديثي الولادة (وفاة رضيع ولد حياً خلال أول 28 يوماً من الحياة)",
 "新生児溶血性疾患": "كثرة الأرومات الحمر الجنينية",
 "新生児頭部皮膚炎": "قبعة المهد (التهاب جلد فروة الرأس الشائع عند الرضع)",
 "新生活": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "新生物": "ورم (كتلة نسيجية جديدة غير طبيعية لا تخدم أي غرض)",
 "新発": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "新発売": "أَطْلَقَ, قَذَفَ",
 "新発意": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "新登場": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "新皮質": "قشرة حديثة (الجزء القشري من الدماغ الحديث)",
 "新知識": "حتى الآن, عصري (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "新石器時代": "حجري حديث, نيوليثي (من أو متعلق بأحدث فترة من العصر الحجري (تلي العصر الحجري المتوسط))\nمثال: أدلة على مستوطنات من العصر الحجري الحديث",
 "新篇": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "新築祝い": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "新米": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / مبتدئ (شخص دخل في رهبنة دينية لكنه لم يأخذ النذور النهائية بعد)",
 "新約": "اَلْعَهْد اَلْجَدِيد",
 "新約全書": "اَلْعَهْد اَلْجَدِيد",
 "新約聖書": "اَلْعَهْد اَلْجَدِيد",
 "新編": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "新聞": "جَرِيدَة / صَحِيفَة",
 "新聞売り": "بائع صحف (صبي يوزع الصحف)",
 "新聞売店": "كُشْك صُحُف (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "新聞広告": "إِعْلَان صُحُفِيّ (إعلان مطبوع ينشر في صحيفة)",
 "新聞発表": "بَيَان صَحَفِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "新聞紙": "ورق جرائد (ورق رخيص مصنوع من لب الخشب ويستخدم لطباعة الصحف)\nمثال: استخدموا رزمًا من ورق الجرائد كل يوم / جَرِيدَة / صَحِيفَة",
 "新聞紙上": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "新聞配達": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "新自由主義": "نِيُولِيبِرَالِيَّة",
 "新自由主義者": "نِيُولِيبْرَالِيّ (يُؤْمِنُ بِضَرُورَةِ النُّمُوِّ الِاقْتِصَادِيِّ إِضَافَةً إِلَى الأَهْدَافِ اللِّيبْرَالِيَّةِ التَّقْلِيدِيَّةِ) / ليبرالي جديد (ليبرالي يتبنى الليبرالية الجديدة)",
 "新興": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "新興国": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "新興都市": "مدينة مزدهرة (بلدة تتمتع بازدهار مفاجئ)",
 "新芽": "نَبْتَة",
 "新装": "تجديد, ترميم (حالة الاستعادة إلى الحالة الجيدة السابقة)\nمثال: كان النزل تجديداً لمنزل استعماري",
 "新規": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "新規住宅着工件数": "بدء الإسكان, بدء البناء (فعل البدء في بناء منزل)",
 "新規性": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / تحفة صغيرة, حلية (صنف صغير غير مكلف يتم إنتاجه بكميات كبيرة) / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)",
 "新規株式公開": "اكتتاب عام أولي, طرح أولي (أول عرض للشركة لبيع الأسهم للجمهور)",
 "新設": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "新設合併": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "新語": "مُوَلَّدَة / تَوْلِيد",
 "新調": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط",
 "新造": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / زَوْجَة, اِمْرَأَة",
 "新造語": "مُوَلَّدَة / تَوْلِيد",
 "新進": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "新進気鋭": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "新郎": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد)",
 "新鋭": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "新開": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "新開地": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "新陳代謝": "تَجْدِيد / أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ) / تَمْثِيل غِذَائِيّ / اِسْتِقْلَاب (يُشير مُعجم مُفردات كلمة \"قلَب\" إلى معانٍ متعددة تدور حول فكرة التغيير و التحويل، سواءً كان ذلك بتغيير مكان شيء ما (كإفراغ قدر أو عكس شيء)…؛ يُشير الفعل \"قلب\" إلى معانٍ تتراوح بين الحركة المادية لعكس اتجاه أو وضع شيء ما (كقلب كأس أو صفحة)…)",
 "新面目": "مظهر جديد, نيو لوك (نمط من الملابس النسائية ابتكره كريستيان ديور عام 1947؛ تضمن صدراً ضيقاً وخصراً نحيفاً وتنورة واسعة ذات طيات)",
 "新顔": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "新館": "توسعة, جناح (إضافة توسع المبنى الرئيسي)",
 "新香": "مُخَلَّل",
 "新馬": "حولي (حيوان في سنته الثانية) / حولي (حصان سباق يُعتبر عمره سنة واحدة حتى الأول من يناير الثاني بعد ولادته) / طفل صغير, طفل يحبو (طفل صغير بدأ للتو في المشي) / حصان بديل (حصان جديد خاصة (سابقاً) ليحل محل حصان قُتل أو أصيب في المعركة)",
 "新鮮": "طَازَج, طَازَة / عَذْب",
 "新鮮味": "جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً",
 "方": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / أُقْنُوم / فَرْد / جَانِب / صَفْحَة / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / جَانِب / صَفْحَة / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق. / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / بِالْقُرْب, قُرْبَ / مَوْجُود (الذي له وجود)\nمثال: رقصنا حول النار. / قُرْب, جِوَار (أَدْنَى؛ قدَّرَ) / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: جلست بالقرب منها. / سَاحِل, شَاطِئ",
 "方々": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / هُنَا وَهُنَاكَ\nمثال: 観光名所をほうぼう訪ね歩いたので、すっかり疲れ果ててしまった。 — زيارة جميع المعالم السياحية حقاً ترهقني كثيراً .",
 "方がた": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "方がつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "方が付く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "方たち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "方を付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "方今": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "方伯": "لاندغريف (كونت كان له ولاية قضائية على منطقة كبيرة في ألمانيا في العصور الوسطى)",
 "方位": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "方位測定器": "محدد الاتجاه (راديو؛ يحدد اتجاه موجات الراديو القادمة)",
 "方位磁石": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "方位磁針": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "方位角": "سَمْت ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "方位計": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "方便": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "方則": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "方向": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "方向づけ": "إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً)",
 "方向づける": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "方向付け": "إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً)",
 "方向付ける": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "方向性": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / اتجاهية (خاصية كون الشيء موجهاً أو يحافظ على اتجاه معين) / اتجاهية, توجيهية (خاصية الميكروفون أو الهوائي بكونه أكثر حساسية في اتجاه واحد من الآخر)\nمثال: اتجاهية الكتابة الإنجليزية من اليسار إلى اليمين / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَرْمًى / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَجَّلَ هَدَفًا (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: لقد أخطأ الهدف.",
 "方向感覚": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "方向指示器": "إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "方向探知器": "محدد الاتجاه (راديو؛ يحدد اتجاه موجات الراديو القادمة)",
 "方向探知機": "محدد الاتجاه (راديو؛ يحدد اتجاه موجات الراديو القادمة)",
 "方向舵": "دَفَّة, سُكَّان / سُكَّان, دَفَّة",
 "方向観念": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "方向転換": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "方図": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "方墳": "مُسَطَّح القِمَّة (له سطح علوي مسطح أو مُستوٍ)",
 "方士": "سَاحِر",
 "方尖柱": "مِسَلَّة",
 "方式": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "方形": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "方方": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / هُنَا وَهُنَاكَ\nمثال: 観光名所をほうぼう訪ね歩いたので、すっかり疲れ果ててしまった。 — زيارة جميع المعالم السياحية حقاً ترهقني كثيراً .",
 "方書き": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "方杖": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "方案": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "方正": "استقامة, نزاهة (الصلاح الناتج عن كون الشخص شريفاً وصادقاً)",
 "方法": "طَرِيقَة, مِنْهَج",
 "方法学": "مَنْهَج",
 "方法的": "إِجْرَائِيّ, شَكْلِيّ (يتعلق بممارسة المحكمة والإجراءات بدلاً من مبادئ القانون) / إجرائي (من أو متعلق بالإجراءات)\nمثال: القانون الإجرائي",
 "方法論": "مَنْهَج",
 "方略": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "方眼": "شَبَك, شَبَكَة / شَبَكَة كَهْرُبَاء / شَبَك",
 "方眼紙": "ورق رسم بياني (ورق يحتوي على خطوط للسماح برسم الرسوم البيانية)",
 "方程式": "مُعَادَلَة (المُوَازَنَة؛ في الرِيَاضِيَّات: هي مسألة مُتَوَازِنَة فيها طرفين كل واحد منهما يعادل الآخر فيها مَجْهُول أو أكثر يُرَادُ استخراجه)",
 "方立": "قائم النافذة (شريط رأسي غير هيكلي بين مصاريع أو ألواح النافذة (أو ألواح الشاشة))",
 "方策": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "方舟": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "方術": "طَرِيقَة, مِنْهَج / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "方角": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة / طَرِيقَة, مِنْهَج",
 "方解石": "كالسيت (معدن شائع يتكون من كربونات الكالسيوم المتبلورة؛ مكون رئيسي للحجر الجيري)",
 "方言": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "方言学": "عِلْم اللَّهْجَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "方計": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "方途": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "方達": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "方針": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر) / سَنَد تَأْمِين ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً)\nمثال: عاد إلى السياسة. / إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى اتجاه القطب المغناطيسي للأرض)",
 "方鉛鉱": "غَالِينَا",
 "方錐": "هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها)",
 "方錐形": "هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها)",
 "方陣": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "方面": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "方面隊": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "方領": "مُرَبَّعُ الشَّكْلِ (على هيئة المربّع)",
 "施し": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "施し物": "صَدَقَة, خَيْر",
 "施す": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "施与": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "施主": "مُتَبَرِّع / زَبُون, مُشْتَرٍ / عَمِيل (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "施入": "صَدَقَة, خَيْر",
 "施工": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "施政": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "施条銃": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "施為": "مَأْثُرَة",
 "施物": "صَدَقَة, خَيْر",
 "施策": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر) / سَنَد تَأْمِين ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً)\nمثال: عاد إلى السياسة.",
 "施肥": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "施行": "إنفاذ, تطبيق (فعل الإنفاذ؛ ضمان الامتثال أو الطاعة لـ) / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "施術": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / جراحة, عملية جراحية (إجراء طبي يتضمن شقاً بالأدوات؛ يتم إجراؤه لإصلاح تلف أو وقف مرض في جسم حي)\nمثال: سيحددون موعد العملية بمجرد توفر غرفة عمليات",
 "施術者": "مُمَارِس",
 "施設": "مَرَافِق, مُنْشَأَة / سُهُولَة / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "施釉": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "施錠": "إقفال, إيصاد (فعل قفل شيء ما لحمايته)",
 "旁": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة) / جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "旁註": "مُلَاحَظَة هَامِشِيَّة",
 "旁証": "إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "旄牛": "الياك (ثور بري كبير طويل الشعر من التبت غالباً ما يتم استئناسه) / ثرثرة صاخبة, لغو (حديث صاخب)",
 "旅": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "旅がらす": "هَائِم / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "旅する": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "旅の人": "رحّالة, مسافر (شخص يغير موقعه)",
 "旅の者": "رحّالة, مسافر (شخص يغير موقعه)",
 "旅亭": "فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق.",
 "旅人": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب. / مُتَنَقِّل",
 "旅人の木": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من عصارة مائية صافية؛ يشاع أنه مصدر طوارئ للمياه للمسافرين)",
 "旅人木": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من عصارة مائية صافية؛ يشاع أنه مصدر طوارئ للمياه للمسافرين)",
 "旅先": "وِجْهَة, وُجْهَة",
 "旅具": "أمتعة, حقائب سفر (حقائب تستخدم لحمل المتعلقات عند السفر) / أمتعة عسكرية (المعدات المحمولة واللوازم لجيش ما) / امرأة سيئة السمعة (امرأة عديمة القيمة أو غير أخلاقية)",
 "旅券": "جَوَاز سَفَر, إِجَازَة مُرُور",
 "旅券査証": "تَأْشِيرَة, فِيزَا",
 "旅商い": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "旅商人": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "旅回り": "رِحْلَة / جَوْلَة",
 "旅団": "لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "旅姿": "حقيبة أدوات السفر, حقيبة مستلزمات (حقيبة لحمل أدوات النظافة أثناء السفر)",
 "旅客": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "旅客列車": "قطار ركاب (قطار يحمل الركاب)",
 "旅客施設使用料": "بيرفلوروكربون (غاز دفيئة قوي ينبعث أثناء إنتاج الألومنيوم)",
 "旅客船": "سفينة ركاب (سفينة بنيت لنقل الركاب)",
 "旅店": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "旅次": "فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق.",
 "旅烏": "هَائِم / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "旅程": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "旅立ち": "رَحِيل, مُغَادَرَة",
 "旅立つ": "غَادَرَ, رَحَلَ (تَرَكَ)\nمثال: غادر سامي للتو. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "旅籠": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "旅舎": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "旅行": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "旅行かばん": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "旅行カバン": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "旅行代理店": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
