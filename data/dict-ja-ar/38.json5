 "形而下": "مَادِّيّ, مَلْمُوس",
 "形而下学": "خصائص فيزيائية, فيزياء (الخصائص الفيزيائية والظواهر والقوانين لشيء ما)\nمثال: درس فيزياء الإشعاع",
 "形見": "تذكار (شيء يذكر بأحداث الماضي)",
 "形象": "شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形象文字": "هِيرُوغْلِيفِيَّة",
 "形貌": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "形質": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة. / بَدِيل وِرَاثِيّ",
 "形質人類学": "أنثروبولوجيا فيزيائية (فرع الأنثروبولوجيا الذي يتعامل مع نشأة وتنوع البشر)",
 "形質導入": "تحويل الطاقة (العملية التي يقبل بها محول الطاقة الطاقة بشكل ما ويعيد طاقة ذات صلة بشكل مختلف)\nمثال: تحويل الموجات الصوتية إلى فولتية بواسطة ميكروفون",
 "形質細胞": "خلية بلازمية (خلية تتطور من الخلية اللمفاوية البائية كرد فعل لمستضد معين؛ توجد في نخاع العظم…)",
 "形質転換": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "形跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "形骸": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / بريد ميت, رسالة مهملة (بريد لا يمكن تسليمه ولا إعادته)",
 "彦": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "彦坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "彦星": "النَّسْر الطَّائِر",
 "彦頁": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "彩り": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون",
 "彩る": "مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون / زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "彩層": "غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية…)",
 "彩度": "تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة)",
 "彩球": "غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية…)",
