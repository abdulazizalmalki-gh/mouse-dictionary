 "強請り": "تَسَوُّل / اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / مبتز (مجرم يبتز المال من شخص ما بتهديده بفضح معلومات محرجة عنه)",
 "強請る": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "強豪": "محطة توليد الكهرباء, محطة طاقة (محطة لتوليد الكهرباء) / فريق قوي (فريق يُعتبر الأفضل في فئته) / دِينَامُو, شُعْلَة طَاقَة (شخص عالي الطاقة لا يكل)",
 "強辯": "إِصْرَار, إِلْحَاح (مطالب مستمرة ومتواصلة)",
 "強迫": "إجبار, إكراه (استخدام القوة للتسبب في حدوث شيء ما) / إلزام داخلي, اندفاع قسري (رغبة ملحة لفعل أو قول شيء قد يكون من الأفضل تركه دون فعل أو قول) / إكراه, فعل قهري (دافع غير عقلاني لأداء أفعال تافهة أو متكررة، حتى ضد إرادة الشخص)\nمثال: على الرغم من دفعي إلى الرجبي بالإكراه، بدأت أستمتع باللعبة / هَوَس",
 "強迫性障害": "اِضْطِرَاب الْوَسْوَاس الْقَهْرِيّ",
 "強迫症": "اِضْطِرَاب الْوَسْوَاس الْقَهْرِيّ",
 "強迫的": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / قَهْرِيّ, وَسْوَاسِيّ (ناتج عن إكراه نفسي أو يوحي به) / قهري (شخص ذو طبع قهري؛ شخص يشعر بأنه مضطر للقيام بأشياء معينة)",
 "強迫神経症": "وَسْوَاسِيّ قَهْرِيّ (يتسم بالوساوس والأفعال القهرية معًا) / مُصاب بِالوَسْواس القَهْرِيّ (شخص لديه خصائص الوسواس القهري)",
 "強迫観念": "هَوَس",
 "強電線": "خَطّ اَلْكَهْرَبَاء, خَطّ اَلطَّاقَة (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "強面談判": "حَازِم, مُتَشَدِّد (صَارِمٌ وَلَا يَقْبَلُ التَّسْوِيَةَ)",
 "強靭": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة)",
 "強靭性": "شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "強靱": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة)",
 "強音": "نَبْر, تَأْكِيد / شَكْل, شَكْلَة ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ) / نَبْر\nمثال: اجلس بشكل مريح.",
 "強風": "رياح شديدة (رياح قوية جداً)\nمثال: غطت الأمطار والرياح الشديدة المنطقة",
 "弾": "ضَرَّة / خرزة (كرة صغيرة بها ثقب في المنتصف) / حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / حبة, قطرة (شكل كروي وصغير)\nمثال: حبات العرق على جبهته / كَوْم / رَصَاصَة, رَصَاص",
 "弾き": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس. / لَاعِب / مَشْغَل, جِهَاز / مَشْغَل / مُقَامِر",
 "弾きだす": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / طَرَدَ, نَفَى",
 "弾き出す": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / طَرَدَ, نَفَى",
 "弾き物": "آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "弾き玉": "كُرَيَّات",
 "弾き返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "弾き音": "رَفْرَف",
 "弾き飛ばす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "弾き鳴らす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "弾く": "قَلَبَ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "弾ける": "بُوب, مُوسِيقَى شَعْبِيَّة / قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / ارتداد (جودة المادة القادرة على الارتداد) / ارتداد, نط (الارتداد من ارتطام (أو سلسلة من الارتطامات))",
 "弾け飛ぶ": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "弾じる": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "弾ずる": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "弾み": "قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / ارتداد (جودة المادة القادرة على الارتداد) / ارتداد, نط (الارتداد من ارتطام (أو سلسلة من الارتطامات)) / زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة. / عَزْم / لَحْظَة, دَقِيقَة",
 "弾みをつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "弾みを付ける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "弾み車": "حَدَّافَة",
 "弾む": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة. / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل) / إسراف استعراضي (عرض متباه (للجهد أو الإسراف، إلخ.))\nمثال: نوبة إفراط في التسوق / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "弾よけ": "مُضَادّ لِلرَّصَاص, وَاقٍ مِن الرَّصَاص (لا تخترقه الرصاصات) / رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "弾丸": "رَصَاصَة, رَصَاص",
 "弾丸ライナー": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "弾丸列車": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)\nمثال: أنهت المهمة في لمح البصر",
 "弾丸道路": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "弾倉": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "弾力": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "弾力性": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "弾力的": "مَرِن",
 "弾劾": "طَعْن, سَحْب ثِقَة / استنكار, تنديد (فعل علني للتنديد)",
 "弾圧": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "弾圧政治": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "弾奏": "أَدَاء / مَسْرَحِيَّة",
 "弾帯": "حزام ذخيرة, نطاق (حزام خراطيش عريض يرتديه الجنود فوق الكتف)",
 "弾幕": "قصف مركز, وابل (النار الكثيفة للمدفعية لإشباع منطقة بدلاً من ضرب هدف محدد) / تدفق, وابل (التدفق السريع والمستمر للتواصل اللغوي (المنطوق أو المكتوب))\nمثال: أطلقوا وابلاً من النيران أمام القوات المتقدمة",
 "弾性": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "弾性ゴム": "مطاط, مطاط طبيعي (مادة مرنة يتم الحصول عليها من عصارة اللاتكس للأشجار (خاصة أشجار جنس الهيفيا والفيكس) والتي يمكن معالجتها بالكبريت وتشطيبها في مجموعة متنوعة من…)",
 "弾性率": "مُعَامِل الْمُرُونَة, مِعْيَار الْمُرُونَة ((في الفيزياء) نسبة الإجهاد المطبق إلى التغير في شكل جسم مرن)",
 "弾指": "عَزْم / لَحْظَة, دَقِيقَة / نَقْد, اِنْتِقَاد",
 "弾機": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "弾正": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "弾片": "شَظَايَا",
 "弾物": "آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "弾痕": "ثقب رصاصة (ثقب أحدثته رصاصة مرت من خلاله)",
 "弾発": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "弾着": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "弾着距離": "مدى, قدرة / مَدَى",
 "弾糸": "خنفساء مطقطقة (أي من الخنافس المتنوعة واسعة الانتشار) / قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "弾薬": "ذُخِيرَة",
 "弾薬庫": "مخزن البارود, مخزن الذخيرة (مستودع (كحجرة في سفينة حربية) حيث تُخزن الأسلحة والذخيرة)",
 "弾薬筒": "خَرْطُوش, خَرْطُوشَة",
 "弾車": "حَدَّافَة",
 "弾込め": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين",
 "弾速": "سُرْعَة الفُوَّهَة (سرعة المقذوف لحظة خروجه من فوهة البندقية)",
 "弾道": "مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / بَالِسْتِيّ",
 "弾道ミサイル": "صَارُوخ بَالِسْتِيّ, صَارُوخ قَذْفِيّ (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "弾道ミサイル防衛": "صَارُوخ بَالِسْتِيّ, صَارُوخ قَذْفِيّ (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "弾道学": "باليستيات, علم القذائف (علم ديناميكيات الطيران للمقذوفات) / علم المقذوفات, مسار قذفي (مسار جسم في رحلة حرة)",
 "弾道弾": "قَذِيفَة, صَارُوخ / صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "弾道弾迎撃ミサイル": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "弾道弾迎撃ミサイル制限条約": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "弾除け": "مُضَادّ لِلرَّصَاص, وَاقٍ مِن الرَّصَاص (لا تخترقه الرصاصات) / رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "弾音": "رَفْرَف",
 "弾頭": "رَأْس حَرْبِيّ (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "弾鳴らす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "彌榮": "اِزْدِهَار, رَخَاء / حَظًّا مُوَفَّقًاَ ((حَظَا) فلان حظوا: مشى رويدا)\nمثال: حظا سعيدا يا زيري.",
 "彌生": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "彌縫策": "ارتجال, حل مرتجل (وسيلة غير مخطط لها)",
 "彎入": "خَلِيج",
 "彎曲": "منحنى",
 "彎月": "هِلَال",
 "当": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / حساب جاري, حساب شيكات (حساب بنكي يمكن للمودع أن يسحب منه شيكات تدفع عند الطلب) / أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة! / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "当たらず触らず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "当たらず障らず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "当たり": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / نَجَاح / خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\". / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "当たりはずれ": "تَرَاوُح, اِخْتِلَاف",
 "当たりをつける": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "当たりを付ける": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "当たり前": "طَبِيعِيّ / عَادِيّ",
 "当たり外れ": "تَرَاوُح, اِخْتِلَاف",
 "当たり屋": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "当たり木": "مِدَقَّة, يَد",
 "当たり棒": "مِدَقَّة, يَد",
 "当たり狂言": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "当たり鉢": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "当たり障らず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "当たり障り": "عَقَبَة, حَاجِز",
 "当たり障りのない": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "当たり障りの無い": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "当たる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته. / لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "当ったり前": "طَبِيعِيّ / عَادِيّ",
 "当て": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / سكن مؤقت (أماكن معيشة مؤقتة) / منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية) / حشوة, لبادة (كتلة مسطحة من مادة ناعمة تستخدم للحماية أو الحشو أو الراحة) / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "当てこすり": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "当てこする": "لَمَّحَ, أَلْمَحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه) / تسحّب, تسلل / اِنْدَسّ\nمثال: لمح سامي منزلا.",
 "当てこむ": "تَوَقَّعَ, اِرْتَقَبَ",
 "当てごと": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تخمين, حدس (تقدير يعتمد على معلومات قليلة أو معدومة)",
 "当てずっぽ": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "当てずっぽう": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "当てっこ": "لعبة تخمين (لعبة يتنافس فيها المشاركون لتحديد شيء مشار إليه بشكل غامض)",
 "当てつけ": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "当てど": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "当てどなく": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "当てにする": "تَوَقَّعَ",
 "当てにならない": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "当てになる": "مَوْثُوق",
 "当てのない": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "当てはずれ": "خَيْبَة أَمَل",
 "当てはまる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "当てはめる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "当てもない": "عَشْوَائِيّ",
 "当てもなく": "عَشْوَائِيًّا",
 "当てもの": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها. / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "当ても無い": "عَشْوَائِيّ",
 "当ても無く": "عَشْوَائِيًّا",
 "当てる": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "当て事": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تخمين, حدس (تقدير يعتمد على معلومات قليلة أو معدومة)",
 "当て付け": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "当て付けがましい": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم)",
 "当て外れ": "خَيْبَة أَمَل",
 "当て嵌める": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "当て所": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "当て所なく": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "当て推量": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "当て擦り": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "当て擦る": "لَمَّحَ, أَلْمَحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه) / تسحّب, تسلل / اِنْدَسّ\nمثال: لمح سامي منزلا.",
 "当て物": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها. / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "当て言": "النقد الساخر, سُخْرِيَّة / إطناب, تعبير غير مباشر (طريقة غير مباشرة للتعبير عن شيء ما)",
 "当て込む": "تَوَقَّعَ, اِرْتَقَبَ",
 "当て逃げ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "当て馬": "كابح (سطح انسيابي مفصلي على السطح العلوي لجناح الطائرة يتم رفعه لتقليل الرفع وزيادة السحب) / جناح خلفي (سطح انسيابي مثبت في الجزء الخلفي من السيارة لتقليل الرفع عند السرعات العالية) / مُدَلِّل (شخص يدلل أو يفسد بالتدليل المفرط) / سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "当に": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "当り": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / نَجَاح / خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\". / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "当り前": "طَبِيعِيّ / عَادِيّ",
 "当り外れ": "تَرَاوُح, اِخْتِلَاف",
 "当り屋": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "当り木": "مِدَقَّة, يَد",
 "当り棒": "مِدَقَّة, يَد",
 "当り鉢": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "当り障り": "عَقَبَة, حَاجِز",
 "当る": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته. / لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "当を得る": "أَصَابَ, أَحَقَّ",
 "当世": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "当世向き": "عَصْرِيّ, مُوَاكِب لِلصَّرْعَة (مُتَوَافِق مَعَ أَحْدَث صَرْعَات المُوضَة)",
 "当世気質": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "当世流": "عَصْرِيّ, حَدِيث",
 "当世風": "حتى الآن, عصري (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "当事者性": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "当今": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "当付": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "当付がましい": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم)",
 "当付けがましい": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم)",
 "当代一": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "当分": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "当分の間": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "当初": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "当否": "أدب, صواب (السلوك الصحيح أو المناسب)",
 "当地": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "当夜": "هٰذَا الْمَسَاء, اللَّيْلَ / اَللَّيْلَة",
 "当季": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "当家": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "当局": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "当局者": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "当帰芍薬散": "اَلطِّبّ اَلصِّينِيّ",
 "当座": "وقت راهن (المناسبة الحالية)\nمثال: للوقت الراهن / فَوْرِيّ / حساب جاري, حساب شيكات (حساب بنكي يمكن للمودع أن يسحب منه شيكات تدفع عند الطلب)",
 "当座しのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "当座凌ぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "当座貸越": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "当座資産": "أصول سائلة, أصول متداولة (أصول في شكل نقد (أو قابلة للتحويل بسهولة إلى نقد))",
 "当座逃れ": "ارتجال, حل مرتجل (وسيلة غير مخطط لها)",
 "当座預金": "حساب جاري, حساب شيكات (حساب بنكي يمكن للمودع أن يسحب منه شيكات تدفع عند الطلب)",
 "当座預金口座": "حساب جاري, حساب شيكات (حساب بنكي يمكن للمودع أن يسحب منه شيكات تدفع عند الطلب)",
 "当惑": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "当意即妙": "رَدّ مُفْحِم, سُرْعَة بَدِيهَة (براعة وذكاء في الرد)",
 "当方": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "当日": "يَوْم, نَهَار (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "当時物": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "当期純利益": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "当木": "مِدَقَّة, يَد",
 "当来": "آخِرَة",
 "当歳馬": "حولي (حيوان في سنته الثانية) / حولي (حصان سباق يُعتبر عمره سنة واحدة حتى الأول من يناير الثاني بعد ولادته) / طفل صغير, طفل يحبو (طفل صغير بدأ للتو في المشي)",
 "当歳駒": "حولي (حيوان في سنته الثانية) / حولي (حصان سباق يُعتبر عمره سنة واحدة حتى الأول من يناير الثاني بعد ولادته) / طفل صغير, طفل يحبو (طفل صغير بدأ للتو في المشي)",
 "当法人": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "当然": "طَبِيعِيّ / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "当然ながら": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "当然のこと": "أمر مفروغ منه, نتيجة حتمية (نهاية لا مفر منها)",
 "当然のことながら": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "当然の事": "أمر مفروغ منه, نتيجة حتمية (نهاية لا مفر منها)",
 "当然の事ながら": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "当番兵": "بَاتْمَان",
 "当直勤務": "خدمة تنظيم المرور (السيطرة على حركة المرور بواسطة شرطي متمركز عند تقاطع)",
 "当社比": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "当節": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "当職": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "当落": "تَسَبَّب / نَتِيجَة",
 "当該": "مُنَاسِب / لَائِق",
 "当路": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "当週": "أُسْبُوع / جُمْعَة (مجموعة، قبضة أو كمية صغيرة؛ جمعةٌ من تمر، أي قبضة منهُ) / اسبوع / إسبوع / أُسبوع / سيمانة\nمثال: اليوم هو الجمعة.",
 "当量": "مُعَادِل",
 "当銀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "当面": "تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة. / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى. / الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "当面の間": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "彗星": "مُذَنَّب",
 "彙": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "彙報": "بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري))",
 "彙類": "تَصْنِيف",
 "彝": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "彝語": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "形": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَلَامِح, سِحْنَة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / سلوك ((علم النفس) مجموع الاستجابات أو ردود الفعل أو الحركات التي يقوم بها الكائن الحي في أي موقف) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / أداء, تصرف (فعل أو رد فعل شيء ما (مثل آلة أو مادة) تحت ظروف محددة)\nمثال: يمكن دراسة سلوك الجسيمات الصغيرة في التجارب / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / نَعْت, صِفَة / إِجْرَائِيّ",
 "形づくる": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形ばかり": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "形付け": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "形代": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "形体": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形作る": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形動詞": "اِسْم فَاعِل, اِسْم مَفْعُول (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "形勢": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "形取る": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "形姿": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "形容": "وَصْف, تَوْصِيف / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形容しようのない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "形容のない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "形容詞": "نَعْت, صِفَة / إِجْرَائِيّ",
 "形容詞幹": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "形容詞的": "وَصْفِيّ, نَعْتِيّ",
 "形容語": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "形式": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية)) / شَكْلِيَّة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / مِنْوَال\nمثال: لقد أزمت الوضع.",
 "形式ばった": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "形式上": "اِحْتِفَالِيّ, مَرَاسِمِيّ (يَتَّسِمُ بِالأُبَّهَةِ أَوِ المَرَاسِمِ أَوِ الرَّسْمِيَّةِ) / احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: مراسم تخليد ذكرى بيرل هاربور",
 "形式主義": "شكلية (ممارسة الالتزام الدقيق بالأشكال المقررة أو الخارجية) / شكلانية (المذهب القائل بأن الهيكل الرسمي بدلاً من المحتوى هو ما يجب تمثيله) / شكلانية ((فلسفة) النظرية الفلسفية القائلة بأن البيانات الرسمية (المنطقية أو الرياضية) ليس لها معنى ولكن رموزها (التي تعتبر كيانات مادية) تظهر شكلاً له تطبيقات…)",
 "形式化": "إضفاء الطابع الرسمي (فعل جعل الشيء رسمياً (كبيان القواعد الرسمية التي تحكم فئات التعبيرات))",
 "形式張った": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "形式的": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "形式言語": "لُغَة رَسْمِيَّة, لُغَة مُتَصَرِّفَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "形式語": "كَلِمَة وَظِيفِيَّة (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "形式論": "شكلية (ممارسة الالتزام الدقيق بالأشكال المقررة أو الخارجية) / شكلانية (المذهب القائل بأن الهيكل الرسمي بدلاً من المحتوى هو ما يجب تمثيله) / شكلانية ((فلسفة) النظرية الفلسفية القائلة بأن البيانات الرسمية (المنطقية أو الرياضية) ليس لها معنى ولكن رموزها (التي تعتبر كيانات مادية) تظهر شكلاً له تطبيقات…)",
 "形式論理": "منطق رمزي, منطق رياضي (أي نظام منطقي يجرد شكل العبارات بعيدًا عن محتواها لتأسيس معايير مجردة للاتساق والصحة)",
 "形式論理学": "منطق رمزي, منطق رياضي (أي نظام منطقي يجرد شكل العبارات بعيدًا عن محتواها لتأسيس معايير مجردة للاتساق والصحة)",
 "形影一如": "زَوْجَانِ",
 "形態": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形態学": "مُورْفُولُوجِيَا / صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / تَصْرِيف\nمثال: أيمكنك صرف خمسين؟",
 "形態形成": "تشكل, تكون الشكل (تمايز ونمو هيكل كائن حي (أو جزء من كائن حي))",
 "形態模写": "مُشَاكهَة",
 "形態素": "مُورْفِيم, مَقْطَع صَرْفِيّ",
 "形態論": "مُورْفُولُوجِيَا / صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / تَصْرِيف\nمثال: أيمكنك صرف خمسين؟",
 "形態音素": "صوت صرفي, مورفوفونيم ((لغويات) الفونيمات (أو سلاسل الفونيمات) التي تشكل الألومورفات المختلفة لمورفيم ما)",
 "形態音韻論": "علم الصرف الصوتي (دراسة التحقق الصوتي للمتغيرات الصرفية لمورفيمات اللغة)",
 "形成": "تَشَكُّل / تَشْكِيلَة / أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة",
 "形成体": "مُنَظِّم",
 "形成外科": "جِرَاحَةْ تَجْمِيل",
 "形成層": "كامبيوم (الطبقة الداخلية للسمحاق) / كامبيوم (طبقة تكوينية أحادية الخلية من الأنسجة بين الخشب واللحاء في معظم النباتات الوعائية وهي المسؤولة عن النمو الثانوي)",
 "形成手術": "جِرَاحَةْ تَجْمِيل",
 "形振り": "مَلَابِس, ثِيَاب",
 "形気": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "形状": "شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形状適合": "مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ) / قَابِلٌ لِلامْتِثَال, مُطَاوِع (مُسْتَعِدٌّ لِلامْتِثَالِ وَالتَّكَيُّف) / سَرِيع الاسْتِجَابَة, مُمْتَثِل (سريع الامتثال والانصياع)",
 "形相": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形而上": "مِيتَافِيزِيقِيّ",
 "形而上学": "مِيتَافِيزِيقَا, مَا وَرَاءَ الطَّبِيعِيَّات",
 "形而下": "مَادِّيّ, مَلْمُوس",
 "形而下学": "خصائص فيزيائية, فيزياء (الخصائص الفيزيائية والظواهر والقوانين لشيء ما)\nمثال: درس فيزياء الإشعاع",
 "形見": "تذكار (شيء يذكر بأحداث الماضي)",
 "形象": "شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "形象文字": "هِيرُوغْلِيفِيَّة",
 "形貌": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "形質": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة. / بَدِيل وِرَاثِيّ",
 "形質人類学": "أنثروبولوجيا فيزيائية (فرع الأنثروبولوجيا الذي يتعامل مع نشأة وتنوع البشر)",
 "形質導入": "تحويل الطاقة (العملية التي يقبل بها محول الطاقة الطاقة بشكل ما ويعيد طاقة ذات صلة بشكل مختلف) / تحويل, نقل جيني ((علم الوراثة) عملية نقل المادة الوراثية من خلية إلى أخرى بواسطة بلازميد أو عاثية)\nمثال: تحويل الموجات الصوتية إلى فولتية بواسطة ميكروفون",
 "形質細胞": "خلية بلازمية (خلية تتطور من الخلية اللمفاوية البائية كرد فعل لمستضد معين؛ توجد في نخاع العظم وأحياناً في الدم)",
 "形質転換": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "形跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "形骸": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / بريد ميت, رسالة مهملة (بريد لا يمكن تسليمه ولا إعادته) / حبر على ورق, قانون مهمل (حالة شيء فقد أهميته أو فعاليته)",
 "彦": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "彦坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "彦星": "النَّسْر الطَّائِر",
 "彦頁": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "彩り": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "彩る": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون / زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "彩層": "غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية أثناء الكسوف الكلي للشمس)",
 "彩度": "تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة)",
 "彩球": "غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية أثناء الكسوف الكلي للشمس)",
 "彩画": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "彩色": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "彩色く": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "彩飾": "إِضَاءَة",
 "彫": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫り": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫りつける": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫り付ける": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫り刻む": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫り師": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "彫り物": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / وَشْم / وَشَمَ, وَشَّمَ",
 "彫り物師": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "彫る": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / وَشْم / وَشَمَ, وَشَّمَ",
 "彫付ける": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫像": "تِمْثال, دُمْيَة",
 "彫刻": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫刻具座": "إِزْمِيل",
 "彫刻凹版": "لوحة نحاسية (نقص يتكون من صفيحة ملساء من النحاس تم حفرها أو نقشها)",
 "彫刻刀": "إِزْمِيل",
 "彫刻室座": "نَحَّات, مَثَّال (من يمتهن النَّحْتَ، وهو فَنَّان يصنع التماثيل من الحجارة أو الخشب؛ كثير النَّحْتِ)",
 "彫刻家": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "彫刻師": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "彫刻版": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "彫刻物": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "彫刻術": "تِمْثَال, مَنْحُوتَة / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "彫器": "منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "彫塑": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "彫塑術": "فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "彫工": "مُقطِّع اللحم (شخص يقوم بتقطيع اللحم) / مثّال, نحات (فنان يبدع المنحوتات) / حفار, نحات الخشب (يصنع ألواحاً خشبية مزخرفة)",
 "彫師": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "彫心鏤骨": "تفكير شاق, كدح ذهني (تفكير شاق ومجهد) / دراسة مضنية, مؤلف متكلف (عمل أدبي رصين نتاج تفكير وجهد شاق)",
 "彫物": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / وَشْم / وَشَمَ, وَشَّمَ",
 "彫物師": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "彫金": "طَارَدَ",
 "彫金家": "مشروب تعقيب (مشروب يؤخذ مباشرة بعد مشروب آخر) / مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "彫金師": "مشروب تعقيب (مشروب يؤخذ مباشرة بعد مشروب آخر) / مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "彬蔚": "جَمِيل (حَسَن) / وَسِيم\nمثال: طقس اليوم جميل.",
 "彭湃": "حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً)",
 "影": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / اِنْعِكَاس, عَكْس / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "影がさす": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مِنْسَج",
 "影が射す": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مِنْسَج",
 "影が差す": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مِنْسَج",
 "影と形のように": "بتلازم, بشكل لا ينفصل (دون إمكانية للفصل)\nمثال: هذان الاثنان مرتبطان بشكل لا ينفصل",
 "影に日に": "أبداً",
 "影のある": "كَئِيب, مُوحِش",
 "影の内閣": "حكومة الظل (مجموعة من كبار أعضاء الحزب السياسي الذي هو خارج السلطة؛ من المحتمل أن يتولى هؤلاء الأعضاء مناصب مقابلة كوزراء في مجلس الوزراء البريطاني إذا تم انتخاب…)",
 "影の薄い": "غَيْرُ ظَاهِر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "影を潜める": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "影像": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "影印": "جهاز فاكس, فاكس (ناسخة ترسل النسخة عن طريق السلك أو الراديو) / صورة طبق الأصل, فاكسيميلي (نسخة طبق الأصل أو استنساخ)",
 "影山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "影武者": "ثُنَائِيّ / ضِعْف",
 "影法師": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "影絵": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "影裏": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "影響": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響を及ぼす": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響下": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響力": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響圏": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "影響者": "مُؤَثِّر",
 "彷彿": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "彷徨": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "彷徨う": "بوتر, مضرب الإسقاط (المضرب الحديدي المستخدم عادة في المنطقة الخضراء للإسقاط) / لاعب الضربة القصيرة",
 "彷徨える": "تجوال, رومينغ",
 "彷徨えるユダヤ人": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "彷徨き回る": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "彷徨変異": "تَذَبذُب, تَقَلُّب",
 "役": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟ / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "役する": "وَظَّفَ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "役にたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役にもたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役にも立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役に立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役に立た無い": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役に立てる": "مَأْثُرَة / اِسْتَغَلَّ",
 "役を勤める": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "役人根性": "بيروقراطية (مسؤولون حكوميون غير منتخبين)",
 "役付取締役": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "役作り": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "役儀": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役割": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "役割り": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "役務": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "役員": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / مَأْمُور / مَسْؤُول / ضَابِط",
 "役回り": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役場": "بَلَدِيَّة",
 "役夫": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "役得": "مِنْحَة, عِلَاوَة",
 "役所": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "役所仕事": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "役所言葉": "لغة بيروقراطية, لغة رسمية (أسلوب الكتابة المميز لبعض المسؤولين الحكوميين: رسمي وغامض)",
 "役柄": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役目": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "役立たず": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役立つ": "فَائِدَة, جَدْوَى",
 "役者": "مُمَثِّل, مُمَثِّلَة",
 "役職": "عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "役身折酬": "عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "彼": "هُوَ / خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / الْمُخْتَار, الْمُخْتَارَة / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "彼とか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "彼の": "الْمُخْتَار, الْمُخْتَارَة / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "彼のさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の人": "هُوَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の国": "اَلنِّرْفَانَا",
 "彼の地": "هُنَاكَ",
 "彼の娘": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の子": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の岸": "اَلنِّرْفَانَا",
 "彼の方": "هُوَ",
 "彼の様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "彼は誰時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "彼ぴ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼ぴっぴ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼ら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼ピ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼ピッピ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼女": "هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا)\nمثال: هذه هي المسألة. / صَدِيقَة, صَاحِبَة (مؤنث الصديق؛ الصاحبة الخليلة) / صَدِيقَة (مؤنث الصديق؛ الصاحبة الخليلة)\nمثال: ليس لديه صديقة.",
 "彼女たち": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم",
 "彼女ら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼女等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼女自身": "نَفْسُهَا",
 "彼奴ばら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼奴ら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼奴等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼奴輩": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼岸": "اَلنِّرْفَانَا",
 "彼岸桜": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "彼岸花": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "彼方": "أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ) / أَقْصَى / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / فَوْق / فَوْقَ\nمثال: أبعد صورتها عني.",
 "彼方方": "هُنَاك, هُنَالِك / ـهُ, ـهِ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "彼方此方": "هُنَا وَهُنَاكَ",
 "彼氏": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / هُوَ",
 "彼程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "彼等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼自身": "نَفْسَهُ",
 "彼誰時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "往々": "أَحْيَانًا, سَاعَات",
 "往々にして": "أَحْيَانًا, سَاعَات",
 "往き交い": "مُرُور",
 "往き来": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "往き返り": "ذهاب وعودة",
 "往って来い": "تَذَبذُب, تَقَلُّب",
 "往なす": "نَاكَفَ",
 "往にし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "往ぬ": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "往事": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "往信": "شوط أول (الأول من شوطين للعب)",
 "往古来今": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "往年": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "往往": "أَحْيَانًا, سَاعَات",
 "往復": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق)) / مُرَاسَلَة / تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "往復乗車券": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))",
 "往復切符": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))\nمثال: 往復切符を買いましたか。 — ھل إشتريت تذكرة ذهاب وإياب؟",
 "往復書簡": "مُرَاسَلَة",
 "往復機関": "محرك ترددي (محرك احتراق داخلي يتم فيه تدوير العمود المرفقي بواسطة مكابس تتحرك صعوداً وهبوطاً في أسطوانات)",
 "往復航空券": "ذهاب وعودة",
 "往時": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "往来": "مُرُور / طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية. / رَاجِع, عَائِد (يَعُودُ مِنْ جَدِيد)",
 "往査": "زِيَارَة مَوْقِع, مُعَايَنَة مَيْدَانِيَّة (زيارة بصفة رسمية لفحص موقع لتحديد مدى ملاءمته لمشروع ما)",
 "往生": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة) / قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "往生際": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "往者": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
