 "得も言えぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "得も言われず": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "得も言われぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "得る": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "得をする": "فَائِدَة, جَدْوَى",
 "得体": "طَبِيعَة, طبيعة",
 "得体が知れない": "غَرِيب, عَجِيب",
 "得体の知れない": "غَرِيب, عَجِيب",
 "得体の知れぬ": "غَرِيب, عَجِيب",
 "得分": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال. / نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "得喪": "اِكْتِسَاب",
 "得得": "بانتصار, بزهو (بطريقة منتصرة)\nمثال: صرخت بانتصار",
 "得心": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "得意": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / راعي; حامي; وصي; سيد; و",
 "得意げ": "فَخُور",
 "得意先": "زَبُون, عَمِيل",
 "得意場": "زَبُون, عَمِيل",
 "得意客": "زَبُون, مُشْتَرٍ\nمثال: سامي عميل فدرالي.",
 "得意気": "فَخُور",
 "得意満面": "اعتداد بالنفس, عجرفة (شعور مفرط بالرضا عن النفس)",
 "得手": "بصوت عالٍ, بقوة (توجيه في الموسيقى؛ للعزف بقوة وصوت عالٍ نسبي)\nمثال: مقاطع الفورتي (القوية) في المقطوعة",
 "得手勝手": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "得点": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "得点者": "مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة)",
 "得物": "سِلَاح, أَسْلِحَة",
 "得用": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي",
 "徘徊": "تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به",
 "徜徉": "تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به",
 "御": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس. / جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "御々足": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "御しがたい": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة)\nمثال: طفل صعب المراس",
 "御しやすい": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات)\nمثال: عقول شابة طيعة",
 "御し易い": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات)\nمثال: عقول شابة طيعة",
 "御し難い": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة)\nمثال: طفل صعب المراس",
 "御す": "قَادَ, سَاقَ / سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "御する": "قَادَ, سَاقَ / سَيْطَرَ\nمثال: من أنت لتحكم علي؟ / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "御す文字": "سُوشِي",
 "御ませ": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر)\nمثال: طفل نابغ",
 "御丁寧": "أَدِيب, مُؤَدَّب / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "御三": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "御三どん": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "御上": "قَيْصَر, إِمْبْرَاطُور / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / مالكة (امرأة مالكة) / سَيِّد\nمثال: يبدو زيري أحسن.",
 "御不浄": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "御世": "حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "御両親": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "御主": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "御主人様": "سَيِّد\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)",
 "御乳の人": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك…)",
 "御了承": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "御事": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "御仁": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)\nمثال: ظهرت شخصية غريبة عند الباب",
 "御仏": "بُوذَا, بُدّ",
 "御代": "حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "御令嬢": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "御令息": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "御伴": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "御伽": "خادِم, مُعْتَنٍ (يُقَدِّم مُساعَدَة عَمَلِيَّة ورِعايَة) / قِصَّة خُرَافِيَّة, خُرَافَة",
 "御伽噺": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "御体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "御佛": "بُوذَا, بُدّ",
 "御使い": "مَلَاك\nمثال: زيري ملك لنفسه.",
 "御供": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "御供え": "قُرْبَان",
 "御兄弟": "شَقِيق, شَقِيقَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "御光": "هَالَة",
 "御免": "أَنَا آسِف, أَنَا آسِفَة / تَصْرِيح, سَمَاح / إِقَالَة",
 "御免こうむる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "御免なさい": "أَنَا آسِف, أَنَا آسِفَة",
 "御免を蒙る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "御免下さい": "أَنَا آسِف, أَنَا آسِفَة",
 "御免蒙る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "御免被る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "御入り候": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "御入り候ふ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "御分": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "御利益": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا. / فَائِدَة, جَدْوَى",
 "御前": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "御前さま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "御前方": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "御前様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "御前橘": "توت البودنغ, قرانيا قزمية (عشب معمر زاحف يتميز بتوت أحمر ودوامات أوراق عنقودية عند أطراف البراعم؛ غرينلاند…)",
 "御協力": "تَعَاوُن",
 "御台": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "御台盤": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "御器噛": "صُرْصُور",
 "御器噛り": "صُرْصُور",
 "御国": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "御国言葉": "يَابَانِيّ",
 "御国詞": "يَابَانِيّ",
 "御國": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "御園生": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "御坊": "مَعْبَد / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "御堂": "مَعْبَد / كَاتِدْرَائِيَّة",
 "御壁": "تُوفُو, توفو",
 "御多分": "غَالِبِيَّة, أَغْلَبِيّة",
 "御多忙中": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "御夜": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "御大": "رَئِيس, رَئِيسَة",
 "御大層": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "御子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "御子柴": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "御存じ": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "御孟様": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "御守": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "御守り": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
