 "弱拍": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "弱毒": "تخفيف, وهن (خاصية الشيء الذي تم إضعافه أو تقليل سمكه أو كثافته) / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت",
 "弱毒化": "تخفيف, وهن (خاصية الشيء الذي تم إضعافه أو تقليل سمكه أو كثافته) / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت",
 "弱気": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان. / هُبُوطِيّ (يتوقع انخفاضاً في الأسعار)",
 "弱気市場": "سوق هابطة (سوق يتميز بانخفاض أسعار الأوراق المالية)",
 "弱気相場": "سوق هابطة (سوق يتميز بانخفاض أسعار الأوراق المالية)",
 "弱火": "سلق, غلي (الطهي في سائل تم غليه)",
 "弱点": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "弱者": "ضَعِيف",
 "弱肉強食": "شريعَة الغاب, قانون الغابَة (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟",
 "弱腰外交": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "弱虫": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "弱視": "عين كسولة, غمش (ضعف بصري دون وجود مرض عضوي ظاهر)",
 "弱音": "ترطيب, تندية (فعل جعل الشيء رطباً قليلاً) / أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "弱音をはく": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "弱音を吐く": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "弱音器": "أَخْرَس, أَبْكَم ((أَخْرَسَت) الأَرْض: لم تصلح للزِّرَاعَة؛ (أَخْرَسَ) الله فلَانا: أَصَابَهُ بالخرس) / صَامِت",
 "弱齢": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "張っ倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "張り": "تَوَتُّر / شَدّ / جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / القدرة على التعافي بعد الصدمة / ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "張りあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "張りつめる": "سُلَالَة",
 "張りぼて": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / زَائِف, مُتَظَاهَر بِه (مُتَّخَذ بغرض الخداع والتضليل) / زائف, مزيف (شيء هو تزييف؛ ليس كما يبدو) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "張り上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "張り付く": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / مَكَثَ, بَقِيَ / إِقَامَة",
 "張り付け": "أَفِكْس",
 "張り付ける": "أَلْصَقَ / إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "張り倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "張り出": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "張り出し": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "張り出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "張り合い": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "張り合いのない": "مُحْبِط, مُثَبِّط",
 "張り合う": "تَنَافَسَ, تَبَارَى",
 "張り型": "قَضِيب اِصْطِنَاعِيّ",
 "張り子": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "張り子の虎": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
 "張り抜き": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "張り替える": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "張り札": "مُلْصَق, أَفِيش",
 "張り番": "نَاطُور",
 "張り紙": "مُلْصَق / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "張り裂ける": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "張り詰める": "سُلَالَة",
 "張り込み": "كمين مراقبة (مراقبة مكان أو شخص ما من قبل الشرطة (كما في توقع جريمة)) / نَاطُور / تجميع ولصق (تكوين من أشياء مسطحة ملصقة على لوح أو خلفية أخرى)\nمثال: أروه تجميعاً ولصقاً لغلاف الكتاب",
 "張り込む": "عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل) / إسراف استعراضي (عرض متباه (للجهد أو الإسراف، إلخ.))\nمثال: نوبة إفراط في التسوق / أَلْصَقَ",
 "張り飛ばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "張る": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَلَأَ",
 "張三李四": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "張出": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "張出し": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "張出し窓": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "張力": "تَوَتُّر / شَدّ / جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "張力計": "مقياس التوتر السطحي (أداة قياس لقياس التوتر السطحي لسائل) / مقياس الشد (أداة قياس لقياس الشد في سلك أو ليف أو عارضة) / مقياس رطوبة التربة (أداة قياس لقياس محتوى الرطوبة في التربة)",
 "張合い": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "張子": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "張子の虎": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
 "張形": "قَضِيب اِصْطِنَاعِيّ",
 "張抜き": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "張替": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "張本人": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "張札": "مُلْصَق, أَفِيش",
 "張番": "نَاطُور",
 "張筋": "مُوتَر",
 "張裂ける": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "張込み": "كمين مراقبة (مراقبة مكان أو شخص ما من قبل الشرطة (كما في توقع جريمة)) / نَاطُور / تجميع ولصق (تكوين من أشياء مسطحة ملصقة على لوح أو خلفية أخرى)\nمثال: أروه تجميعاً ولصقاً لغلاف الكتاب",
 "強": "قَلِيلًا / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / محطة توليد الكهرباء, محطة طاقة (محطة لتوليد الكهرباء) / فريق قوي (فريق يُعتبر الأفضل في فئته) / دِينَامُو, شُعْلَة طَاقَة (شخص عالي الطاقة لا يكل)",
 "強い": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / متين (القوّي الشديد الصلب؛ الغليظ القوي)\nمثال: هذا السلم (الدرج) متين للغاية. / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / صلب, غير مرن (مقاوم للانحناء) / صارم, غير مرن (غير قابل للتغيير) / صارم, لا هوادة فيه (لا يقدم تنازلات) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)\nمثال: قضيب حديدي غير مرن / مُتْعَب, تَعْبَان",
 "強いところ": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "強いる": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "強い力": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات؛ يتوسطه غلوونات)",
 "強い所": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "強い相互作用": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات؛ يتوسطه غلوونات)",
 "強い肴": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "強か": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "強か者": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "強がり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "強がる": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "強さ": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "強ち": "حَتْماً, بِالضَّرُورَة",
 "強の者": "مُحَارِب قَدِيم",
 "強み": "بصوت عالٍ, بقوة (توجيه في الموسيقى؛ للعزف بقوة وصوت عالٍ نسبي) / فورتي, قوي ((تستخدم بشكل رئيسي كتوجيه أو وصف في الموسيقى) تشير إلى أن المقطع المذكور يجب أن يعزف بصوت عالٍ) / الجزء القوي (الجزء الأقوى من نصل السيف بين المقبض والجزء الضعيف) / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: مقاطع الفورتي (القوية) في المقطوعة",
 "強める": "قَوَّى, عَزَّزَ",
 "強健": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "強制": "إجبار, إكراه (استخدام القوة للتسبب في حدوث شيء ما) / إلزام داخلي, اندفاع قسري (رغبة ملحة لفعل أو قول شيء قد يكون من الأفضل تركه دون فعل أو قول) / إكراه, فعل قهري (دافع غير عقلاني لأداء أفعال تافهة أو متكررة، حتى ضد إرادة الشخص)\nمثال: على الرغم من دفعي إلى الرجبي بالإكراه، بدأت أستمتع باللعبة",
 "強制労働": "عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "強制収容": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "強制収容所": "مُعَسْكَر اِعْتِقَال, مُعْتَقَل",
 "強制執行": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "強制性交": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "強制性交等罪": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "強制改行": "سياسة صارمة, موقف متشدد (موقف حازم لا يقبل المساومة)\nمثال: اتخذ الحاكم موقفاً متشدداً تجاه المخدرات",
 "強制的": "قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي) / اضْطِرَارِيّ, قَسْرِيّ (فُرض بسبب وضع طارئ أو غير متوقع) / إِجْبَارِيّ, قَسْرِيّ (تَمَّ بِالإِجْبَارِ وَالإِكْرَاه) / إجباري, قسري (ناتج عن أو خاضع للقوة)\nمثال: تدفئة بالهواء القسري",
 "強制移送": "طَرْد / إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "強制退去": "طَرَدَ",
 "強制送還": "طَرْد",
 "強制連行": "نَقْل, نَقْلِيَّات",
 "強力": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "強勢": "إِجْهَاد / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد) / رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "強化": "تعزيز, تقوية (عملية زيادة قوة شيء ما) / تعزيز, تقوية (أن يصبح الشيء أقوى) / تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "強化試合": "مُبَارَاة وِدِّيَّة",
 "強取": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "強含み市況": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "強固": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "強圧": "ضَغْط",
 "強圧手段": "بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة)",
 "強圧的": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "強壮": "سَلِيمُ الجَسَد, قَوِيُّ البُنْيَة (ذُو جَسَدٍ قَوِيٍّ وَصَحِيحٍ)",
 "強壮剤": "مُنَبِّه, مُنْعِش (يبثّ الحيوية والطاقة) / منبور, نغمي ((للمقاطع) تحمل النبرة الرئيسية، وعادة ما تكون مصحوبة بتغيير في طبقة الصوت) / أَسَاسِيّ نَغْمِيّ (متعلق بالنغمة الأساسية في السلم الكبير أو الصغير أو كائنها) / نغمي (يستخدم تنوعات في طبقة الصوت لتمييز معاني الكلمات المتشابهة)\nمثال: المقطع النغمي يحمل النبرة الرئيسية في الكلمة",
 "強壮薬": "مُنَبِّه, مُنْعِش (يبثّ الحيوية والطاقة) / منبور, نغمي ((للمقاطع) تحمل النبرة الرئيسية، وعادة ما تكون مصحوبة بتغيير في طبقة الصوت) / أَسَاسِيّ نَغْمِيّ (متعلق بالنغمة الأساسية في السلم الكبير أو الصغير أو كائنها) / نغمي (يستخدم تنوعات في طبقة الصوت لتمييز معاني الكلمات المتشابهة)\nمثال: المقطع النغمي يحمل النبرة الرئيسية في الكلمة",
 "強大": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "強奪": "سَرِقَة, لُصُوصِيَّة",
 "強奪物": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته واستولت عليه)\nمثال: لقد سلب مني كل شيء.",
 "強奪者": "سَارِق (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي) / سَارِقَة / لِصّ / لِصَّة\nمثال: ياني سارق بنوك.",
 "強姦": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "強姦犯": "مُغْتَصِب",
 "強姦罪": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "強姦魔": "مُغْتَصِب",
 "強度": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "強弁": "إِصْرَار, إِلْحَاح (مطالب مستمرة ومتواصلة)",
 "強引": "مُتَسَلِّط",
 "強弱": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / إِجْهَاد",
 "強弱法": "دِينَامِيكَا, حَرَكِيَّة",
 "強張り": "شدة, صرامة (صرامة مفرطة) / ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / جمود, صلابة (حزم ثابت في الغرض أو الرأي أو العمل) / تشنج, تصلب (خاصية التحرك بألم أو صعوبة)\nمثال: صرامة الشخصية",
 "強張る": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "強強": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "強心臓": "جرأة, لفت للنظر (صفة البروز بقوة وبشكل مميز) / جبروت, وقاحة (عدوانية وقحة) / إقدام, جرأة (سمة الاستعداد للقيام بأمور تنطوي على مخاطرة أو خطر)\nمثال: لم أصدق وقاحتها",
