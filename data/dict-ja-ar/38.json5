 "意見を述べる": "رَأَى, ظَنَّ (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "意見交換": "عَصَف ذِهْنِيّ, قَدَح ذِهْنِيّ",
 "意見書": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: (…)\nمثال: لا جدال في ذلك.",
 "意識": "وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي. / وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي.",
 "意識が低い": "جَاهِل",
 "意識の流れ": "تيار الوعي (التدفق المستمر للأفكار والمشاعر التي تشكل التجربة الواعية للفرد)",
 "意識を回復する": "أَنْعَشَ",
 "意識下": "اللَّاوَعِيّ",
 "意識不明": "فِقْدَان اَلْوَعْي, إِغْمَاء",
 "意識化": "تَحْقِيق",
 "意識喪失": "فقدان الوعي (حدوث فقدان للقدرة على الإدراك والاستجابة)",
 "意識改革": "ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "意識的": "مدرك, واعٍ (عارف ومدرك؛ لديه وعي بما يحيط به وبالأحاسيس والأفكار)\nمثال: ظل واعياً أثناء العملية",
 "意識調査": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "意趣": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه. / قَصْد, إِرَادَة / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "意趣晴らし": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "意趣返し": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "意趣遺恨": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "愕然": "مَذْهُول",
 "愚": "حَمَاقَة (خطأ سخيف) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "愚か": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚かしい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚かにも": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "愚か者": "مُغَفَّل, أَحْمَق",
 "愚にもつかない": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚にも付かない": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚人": "مُغَفَّل, أَحْمَق",
 "愚作": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها)",
 "愚僧": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "愚兄": "اَلْأَخ اَلْأَكْبَر",
 "愚劣": "حَمَاقَة (خطأ سخيف)",
 "愚夫": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)",
 "愚女": "اِبْنَة, بِنْت",
 "愚妻": "زَوْجَة, اِمْرَأَة",
 "愚姉": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "愚弄": "اِسْتِهْزَاء",
 "愚弟": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "愚息": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "愚惷": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "愚昧": "غَبِيّ",
 "愚暗": "حَمَاقَة (خطأ سخيف)",
 "愚案": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "愚父": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "愚物": "مُغَفَّل, أَحْمَق",
 "愚生": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "愚痴": "قَمْقَمَ",
 "愚痴っぽい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "愚痴る": "قَمْقَمَ",
 "愚痴をこぼす": "تذمر دائم (شكوى مزعجة ومستمرة)",
 "愚痴を溢す": "تذمر دائم (شكوى مزعجة ومستمرة)"
}
