 "きがかわる": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きがかん": "رَغْبَة, تَعَطُّش\nمثال: جاع الرجل العجوز حتى الموت.",
 "きがく": "موسيقى آلية (موسيقى تُنتج عن طريق العزف على آلة موسيقية) / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "きがけ": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "きがさす": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "きがじゅくす": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "きがすすまない": "غير راغب, نافر (غير راغب بسبب كره خفيف أو عدم موافقة)\nمثال: غير راغب في قول أي شيء لأي شخص",
 "きがする": "تحسس\nمثال: شعر ماريا طويل.",
 "きがそぞろ": "مَهْوُوس, مُنْشَغِل (لَدَيْهِ انْشِغَالٌ مُفْرِطٌ أَوْ قَهْرِيٌّ بِشَيْءٍ مَا)",
 "きがちいさい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "きがつく": "لَاحَظَ",
 "きがつくと": "فَجْأَةً",
 "きがつよい": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "きがとおくなる": "إِغْمَاء",
 "きがない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "きがながい": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "きがぬける": "يَئِسَ, أُحْبِطَ",
 "きがね": "متطلب / ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "きがはやい": "مُتَسَرِّع",
 "きがへん": "مَجْنُون, مَخْبُول",
 "きがまえ": "تأهب, حماس (استعداد فوري)\nمثال: استعداد لمواصلة المناقشات",
 "きがみじかい": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "きがむかない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "きがもめる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "きがよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "きがよわい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "きがる": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "きがるい": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "きがるに": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "きがん": "صَلَاة, دُعَاء",
 "きがんじょ": "مَعْبَد",
 "きがんぽう": "صِيغَة التَّمَنِّي (صيغة تعبر عن رغبة أو أمل)",
 "きき": "أَزْمَة, بُحْرَان\nمثال: 我々は一大危機に直面している。 — نحن بصدد كارثة عنيفة. / مَرِح, فَرِح / استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما) / أَدَاة, جِهَاز / تَدْمِير, هَدْم / فعالية, قوة تأثير (القدرة على إنتاج تأثيرات فسيولوجية أو كيميائية قوية)\nمثال: قوة تأثير التوكسين / جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم)\nمثال: لديه السلطة لإصدار مذكرات التوقيف / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق. / بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / باهِر / وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة. / حَافِل بِالنَّشَاط, صَاخِب (مليء بالنشاط الحيويّ والصاخب) / سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا. / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "ききあわせ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "ききいっぱつ": "فِي آخِرِ لَحْظَةٍ, في اللحظة الأخيرة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ききいれる": "مَنَحَ",
 "ききおく": "أَصْغَى, أَنْصَتَ",
 "ききおとす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "ききおよぶ": "سَمِعَ بِـ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "ききかいかい": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "ききかた": "مُسْتَمِع, مُسْتَمِعَة",
 "ききこみそうさ": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "ききざけ": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "ききすごす": "تَجَاهَلَ, طَنَّش",
 "ききすてならない": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه)",
 "ききすてる": "تَجَاهَلَ, طَنَّش",
 "ききずてならない": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه)",
 "ききずてにする": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "ききそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "ききただす": "تَيَقَّنَ, تَثَبَّتَ",
 "ききだしゃ": "ضارب بديل ((في البيسبول) بديل للضارب الأساسي)",
 "ききつける": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "ききつたえ": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "ききつたえる": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "ききづたえ": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "ききて": "مستمع, منصت (شخص يستمع بانتباه) / مُجري المقابلة (شخص يجري مقابلة)",
 "ききてき": "النقد",
 "ききとどける": "مَنَحَ",
 "ききとりちょうさ": "تقصي الحقائق",
 "ききとる": "لُقْطَة\nمثال: كنت أمسك بالكرة. / اِسْتَعْلَمَ, سَأَلَ",
 "ききどころ": "نقطة ضغط (منطقة على الجلد حساسة للغاية للضغط)\nمثال: يجب أن تعرف نقاط الضغط لكي تمارس شياتسو / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "ききながす": "تَجَاهَلَ, طَنَّش",
 "ききなれた": "مَأْلُوف",
 "ききにくい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "ききのがす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "ききふるした": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "ききまちがえる": "أَسَاءَ الْفَهْم",
 "ききめ": "تَأْثِير, أَثَر",
 "ききもの": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "ききもらす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "ききゃく": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ききゃくるい": "زعنفيات الأقدام (ثديي مائي آكل للحوم له جسم انسيابي متخصص للسباحة مع أطراف متحورة كزعانف)",
 "ききゅう": "حَاوَلَ (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا! / طَوَارِئ, حَالَةْ اَلطَّوَارِئ / عرضة / شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك. / نُفَّاخَة, بَالُون / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "ききゅうそんぼう": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "ききゅうそんぼうのとき": "أَزْمَة, بُحْرَان",
 "ききょ": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / حَرَكَة / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "ききょう": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة / استرواح الصدر (وجود غير طبيعي للهواء في التجويف الجنبي مما يؤدي إلى انخماص الرئة؛ قد يكون…) / إياب, رجوع (المجيء أو العودة إلى الوطن)\nمثال: عند عودته من أستراليا أقمنا له حفلة ترحيب / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به…)\nمثال: اعتنق المسيحية. / رِدَّة, اِرْتِدَاد",
 "ききょきょどう": "سُلُوك, تَصَرُّف",
 "ききょく": "أَزْمَة, بُحْرَان",
 "ききょどうさ": "سُلُوك, تَصَرُّف",
 "ききわけ": "مَعْقُولِيَّة, وَجَاهَة (صفة كون الشيء معقولاً أو مقبولاً لشخص عاقل)\nمثال: شكك في وجاهة ادعاءاتي",
 "ききわけがいい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ききわけがよい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ききわけのいい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ききわけのない": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "ききわけのよい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ききわける": "تَعَرَّفَ",
 "ききん": "ذَخِيرَة / مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / مَجَاعَة",
 "ききんぞく": "معدن نفيس (أي من المعادن الأقل شيوعاً والقيمة التي تُستخدم غالباً لصنع العملات المعدنية أو…)",
 "ききんぞくてん": "تاجر مجوهرات, متجر مجوهرات (شركة تبيع وتشتري المجوهرات)",
 "きき酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "きぎ": "خَوْف, وَهَل\nمثال: خاف زيري نوعا ما. / تَوْقِيت مُنَاسِب, مُوَاتَاة (الملاءمة الزمنية) / شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة)\nمثال: توم يتسلق شجرة. / تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "きぎょう": "مُغَامَرَة, شَرِكَة",
 "きぎょうか": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات / رجل صناعة, صناعي (شخص يدير أو يمتلك مصلحة مالية كبيرة في مؤسسة صناعية) / رَائِد أَعْمال مُتَعَهِّد",
 "きぎょうがっぺい": "اِنْدِمَاج",
 "きぎょうくみあい": "نِقابة",
 "きぎょうごうどう": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء.",
 "きぎょうしゃ": "رجل صناعة, صناعي (شخص يدير أو يمتلك مصلحة مالية كبيرة في مؤسسة صناعية)",
 "きぎょうたんきけいざいかんそくちょうさ": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "きぎょうないくみあい": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "きぎょうひみつ": "سر تجاري (سر (طريقة أو جهاز أو صيغة) يمنح الشركة المصنعة ميزة على المنافسة)",
 "きぎょうべつくみあい": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "きぎょうれんごう": "اتحاد احتكاري, كارتل (ائتلاف من المنظمات المستقلة تم تشكيله للحد من المنافسة من خلال التحكم في إنتاج…)\nمثال: أقاموا الاتحاد الاحتكاري على أمل الحصول على احتكار",
 "きぎんこう": "أرجنتيت",
 "きく": "أُقْحُوَان / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / اِسْتَطَاعَ, قَدَرَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / أَصْغَى, أَنْصَتَ / سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / سَمِعَ بِـ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم / سطر افتتاحي (السطر الأول من قطعة كتابية (مثل قصة صحفية)) / مِعْيَارِيّ / حاد الانحدار, شديد الانحدار (ذو ميل حاد)\nمثال: سلالم العلية شديدة الانحدار / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "きくいし": "أمونيت (أحد الأصداف الأحفورية الملتفة والمقسمة لرخويات منقرضة)",
 "きくいただき": "صعوة ذهبية (صعوة أوروبية ذات بقعة تاج صفراء محاطة بالأسود)",
 "きくいむし": "خنفساء اللحاء (خنفساء صغيرة تحفر أنفاقاً في لحاء وخشب الأشجار؛ قريبة من السوس)",
 "きくいも": "أرضي شوكي قدسي, خرشوف قدسي (درنة دوار الشمس تؤكل نيئة أو مسلوقة أو مقطعة إلى شرائح رقيقة ومقلية)",
 "きくう": "مجال جوي (الحيز الموجود في الغلاف الجوي فوق الأرض مباشرة)",
 "きくがさね": "أُقْحُوَان / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي",
 "きくきゅうじょ": "مُبَجِّلٌ, مُوَقِّرٌ (يُظهر التوقير والاحترام)",
 "きくごぼう": "سلسفي أسود (سلسفي أسود طويل)",
 "きくさ": "خُضْرَة, عَشَابَة",
 "きくざ": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس)",
 "きくじゅんじょう": "متوسط, معدل (إحصائية تصف موقع التوزيع)\nمثال: وضعت المعيار للمنازل الأمريكية",
 "きくじん": "أَخْضَر مُصْفَرّ (بلون متوسط بين الأصفر والأخضر)",
 "きくする": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "きくず": "قش خشب, نشارة خشب (نشارة خشب مجعد رقيقة تستخدم للتعبئة أو الحشو)",
 "きくちば": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة)",
 "きくぢしゃ": "هِنْدِبَاء",
 "きくな": "أقحوان تاجي (نبات سنوي شجيري في منطقة البحر الأبيض المتوسط بزهور بيضاء مصفرة)",
 "きくばり": "اِهْتِمَام",
 "きくもん": "تَحْقِيق مَعَ, اِسْتِجْوَاب / اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس)",
 "きくん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "きぐ": "آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل)) / اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم / مُعَدَّات, تَجْهِيزَات",
 "きぐう": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة.",
 "きぐうけんさ": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "きぐうけんさビット": "بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من…)",
 "きぐうせい": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية)",
 "きぐつ": "سابو, قبقاب خشبي (حذاء منحوت من كتلة واحدة من الخشب)",
 "きぐみ": "مَوْقِف, سُلُوك",
 "きぐらい": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "きぐるい": "الة موسيقية\nمثال: نسى زيري الآلة.",
 "きぐろう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "きけい": "تَشَوُّه شَكْلِيّ / حِيلَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَلِيغ الدُّعَابَة, حَاضِر البَدِيهَة (يجمع بين الفكرة الذكيّة والتعبير الطريف)",
 "きけいしゅ": "ورم مسخي (ورم يتكون من خليط من الأنسجة غير الموجودة عادة في ذلك الموقع)",
 "きけつ": "عَاقِبَة / جَوَابُ الشَّرْط (الجَوَاب : ما يكون رَدًّا على سؤالٍ أَو دعاءٍ أَو دَعْوَى، أَو رسالةٍ أَو…)\nمثال: لقد وجدتم الجواب. / مَلْحُوظ, وَاضِح (يُمْكِنُ تَمْيِيزُهُ؛ بَارِزٌ وَجَلِيّ) / أَدَانَ",
 "きけつしゅう": "أَدَانَ",
 "きけもの": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "きける": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "きけん": "خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / مُخَاطَرة\nمثال: أنا ذاهب للخطر. / اِمْتِنَاع, إِمْسَاك / جَو, غِلَاف جَوِّيّ",
 "きけんいんし": "عَامِل اِخْتِطَار (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "きけんかいひ": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "きけんかくど": "زَاوِيَة حَرِجَة",
 "きけんしんごう": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "きけんしんし": "مَرْمُوق, بَارِز",
 "きけんじんぶつ": "شَخْص مُنْفَلِت, مَصْدَر خَطَر غَيْر مَضْبُوط (شخص يُتوقع منه أداء مهمة معينة لكنه يخرج عن السيطرة ويصبح خطيراً)",
 "きけんせい": "مُخَاطَرة\nمثال: أنا ذاهب للخطر.",
 "きけんちたい": "منطقة خطر (منطقة خطرة)",
 "きけんぶつ": "اِنْفِجَارِيّ, مُتَفَجِّر",
 "きけんりょういき": "مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "きけんドラッグ": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات…)",
 "きげき": "فُكَاهَة, كُومِيدِيَا / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "きげきてき": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه)",
 "きげきやくしゃ": "كُومِيدْيَان",
 "きげん": "اِصْطِلَاح, مُصْطَلَح / حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله) / فُكَاهَة, دُعَابَة\nمثال: خلط توم بين السكر و الملح. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن. / فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط) / حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين)\nمثال: في عام 200 من الحقبة العامة / مَنْشَأ / غَرِيب, عَجِيب / مُقَوِّم",
 "きげんかい": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "きげんがいい": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "きげんがよい": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "きげんきづま": "فُكَاهَة, دُعَابَة\nمثال: خلط توم بين السكر و الملح.",
 "きげんきづまをとる": "تَمَلَّقَ",
 "きげんせつ": "24 مايو, يوم الكومنولث (بريطاني، ذكرى ميلاد الملكة فيكتوريا)",
 "きげんぜん": "ق. م, قَبْلَ الْمِيلَاد",
 "きげんとり": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "きげんのいい": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "きげんのよい": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "きげんのわるい": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "きげんよく": "بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك",
 "きげんをそこねる": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "きげんをとる": "تَمَلَّقَ",
 "きこ": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة…)\nمثال: هل كان في الجيش.",
 "きこう": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / آلِيَّة / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / دِرْع (غطاء واقٍ صلب وقاسٍ إلى حد ما لحيوان أو نبات) / مَنَاخ, مُنَاخ (الموضع الذي تُناخ فيه الإبل؛ مبرك الإبل)\nمثال: أشجار الكرز تحتاج لمناخ بارد. / مَسَمّ / مَوْسِم / فيلم سياحي, محاضرة عن الرحلات (فيلم أو محاضرة مصورة عن السفر) / رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية)\nمثال: تعلم الرسم من والده / ركوب الخيل (السفر محمولاً على ظهر الخيل) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري / حِيلَة / نَادِر / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة. / غُرْفَةُ مُعَادَلَةِ الضَّغْط (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة. / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات…)\nمثال: عدن إلى المصرف.",
 "きこうか": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب)",
 "きこうかいかく": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "きこうがく": "عِلْم اَلْمُنَاخ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "きこうがくしゃ": "عالم مناخ (خبير في علم المناخ)",
 "きこうしゃ": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب)",
 "きこうせいぎ": "تَغَيُّر مَنَاخِيّ (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "きこうたい": "منطقة مناخية (أي من المناطق الجغرافية المقسمة بشكل فضفاض وفقاً للمناخ السائد وخط العرض) / مَسَمّ",
 "きこうち": "ميناء توقف, ميناء رسو (أي ميناء تتوقف فيه السفينة باستثناء الميناء الأم)",
 "きこうへんどう": "تَغَيُّر مَنَاخِيّ (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "きこうへんどうにかんするこくさいれんごうわくぐみじょうやく": "الْأُمَم الْمُتَّحِدَة",
 "きこうへんどうわくぐみじょうやくていやくこくかいぎ": "الْأُمَم الْمُتَّحِدَة",
 "きこえ": "اِسْتِقْبَال / سُمْعَة, شُهْرَة / اِنْطِبَاع, أَثَر / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين)",
 "きこえる": "سليم\nمثال: اقرأ بصوت عالي. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "きこく": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة…)",
 "きこくしゅうしゅう": "كَابُوسِيّ, مُقْشَعِرّ (مخيف إلى أقصى حد؛ يُجمِّد الدماء في العروق)",
 "きこしめす": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "きこつ": "عَمُود فَقْرِيّ / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة / نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "きこどうどう": "بانتصار, بزهو (بطريقة منتصرة)\nمثال: صرخت بانتصار",
 "きこむ": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "きこゆ": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "きこゆる": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "きこり": "حَطَّاب",
 "きこん": "مُتَزَوِّج, مُتَأَهِّل / صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "きこんしゃ": "زوج, شريك حياة (شريك الشخص في الزواج)",
 "きこんじょせい": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "きこんだんせい": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "きご": "أصل, جذر ((لغويات) شكل الكلمة بعد إزالة جميع اللواحق) / يُونَانِيّ, إِغْرِيقِيّ",
 "きごう": "لافِتَة\nمثال: توم وقع و أصيب. / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "きごうか": "ترميز, رمزية (ممارسة إضفاء معنى رمزي على الأشياء)\nمثال: النسر هو رمز للولايات المتحدة",
 "きごうがく": "سميوطيقا",
 "きごうがくしゃ": "رمزي, فنان رمزي (عضو في حركة فنية عبرت عن الأفكار بشكل غير مباشر عبر الرموز)",
 "きごうろん": "سميوطيقا",
 "きごうろんがくしゃ": "رمزي, فنان رمزي (عضو في حركة فنية عبرت عن الأفكار بشكل غير مباشر عبر الرموز)",
 "きごうろんりがく": "منطق رمزي, منطق رياضي (أي نظام منطقي يجرد شكل العبارات بعيدًا عن محتواها لتأسيس معايير مجردة للاتساق…)",
 "きごころ": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "きごころのしれた": "ثَدْي",
 "きごみ": "حَمَاس, حَمَاسَة",
 "きさ": "محار الدم (محار أحمر الدم) / فِيل, فيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من…)\nمثال: لدى الفيل أنف طويل.",
 "きさい": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / سَاحِر, مُشَعْوِذ / مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا) / حذق, حنكة (الذكاء الذي يظهر من خلال الحنكة (كما في التعاملات التجارية)) / إِمْبِرَاطُورَة, مَلِكَة",
 "きさいじこう": "مُحْتَوَى, مَضْمُون",
 "きさいもれ": "إِغْفَال",
 "きさがい": "محار الدم (محار أحمر الدم)",
 "きさき": "إِمْبِرَاطُورَة, مَلِكَة",
 "きさく": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة. / حِيلَة",
 "きさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "きさらぎ": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "きさん": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / تبخير (الإفناء عن طريق تبخير الشيء)",
 "きさんじ": "اِسْتِجْمَام",
 "きざ": "مُتَأَثِّر (وقع عليه فعل أو تأثير)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام / خَرْبَشَ",
 "きざい": "مُعَدَّات, تَجْهِيزَات / أَدَاة / قَاعِدَة / ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "きざくろいし": "ألمندين (عقيق أحمر غامق يتكون من سيليكات الحديد والألمنيوم)",
 "きざこきゅう": "ضيق النفس الاضطجاعي (شكل من أشكال ضيق التنفس حيث لا يستطيع الشخص التنفس براحة إلا عند الوقوف أو…)",
 "きざし": "لافِتَة\nمثال: توم وقع و أصيب.",
 "きざす": "بُرْعُم",
 "きざったらしい": "مُتَأَثِّر (وقع عليه فعل أو تأثير)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "きざっぽい": "مُتَأَثِّر (وقع عليه فعل أو تأثير)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "きざはし": "سَلَالِم",
 "きざみ": "مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب) / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / فَاصِل",
 "きざみこむ": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب.",
 "きざみち": "زيادة, علاوة (المقدار الذي يزداد به الشيء)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "きざみはば": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً'))\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "きざみめ": "ثلم, حز (قطع صغير)\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "きざむ": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / عَذَاب",
 "きざわり": "بَغِيض, غَيْر مَقْبُول (ليس على هواك)\nمثال: موقف بغيض",
 "きし": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات…)\nمثال: عدن إلى المصرف. / عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / مَوْقِف / فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه) / إِغْمَاء / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "きしかいせい": "اِنْعَاش",
 "きしかた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "きしかん": "دِيجَا ڤُو",
 "きしきし": "صَرِير\nمثال: لدى مايوكو حاسة بصر حادة.",
 "きしつ": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية / مَصْفُوفَة / تَكْوِين\nمثال: العدالة مضمونة في الدستور. / رُطُوبَة",
 "きしつせい": "عُضْوِيّ",
 "きしつてき": "عُضْوِيّ",
 "きしてん": "مَنْشَأ",
 "きしどう": "مُرُوءَة",
 "きしどうものがたり": "رُومَانْسِيَّة",
 "きしべ": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "きしみ": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا) / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "きしむ": "مرطبان\nمثال: من ترك الجرة مفتوحة؟",
 "きしゃ": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء) / قِطَار بُخَارِيّ / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل. / مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "きしゃかいけん": "مُؤْتَمَر صَحَفِيّ",
 "きしゃかいけんじょう": "مُؤْتَمَر صَحَفِيّ",
 "きしゃきゅう": "بُرْج اَلْقَوْس, اَلْقَوْس (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "きしゃく": "تَخْفِيف",
 "きしゃしつ": "شرفة الصحافة (منطقة (أحياناً في شرفة) مخصصة للمراسلين (خاصة في قاعة تشريعية))",
 "きしゃせき": "شرفة الصحافة (منطقة (أحياناً في شرفة) مخصصة للمراسلين (خاصة في قاعة تشريعية))",
 "きしゃだん": "فيلق صحفي, مجموعة صحفية (مجموعة من الصحفيين يمثلون منشورات مختلفة يغطون جميعاً نفس المواضيع)\nمثال: الفيلق الصحفي للبيت الأبيض",
 "きしゃちん": "أجرة القطار, تذكرة قطار (الأجرة المفروضة للسفر بالقطار)",
 "きしゃはっぴょう": "بَيَان صَحَفِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء…)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "きしゃぽっぽ": "تُوت تُوت",
 "きしゅ": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة) / نَمُوذَج / أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير. / نَتِيجَة / فَارِس, رَاكِب (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد. / انتفاخ الرئة (حالة غير طبيعية للرئتين تتميز بانخفاض وظيفة الجهاز التنفسي) / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "きしゅう": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "きしゅうこうげき": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "きしゅく": "إِقَامَة / بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "きしゅくがっこう": "مَدْرَسَة دَاخِلِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "きしゅくしゃ": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "きしゅくりょう": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "きしょ": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "きしょい": "معيب",
 "きしょう": "حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة) / طَقْس, جَوّ / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / نَادِر / مِيدَالِيَة, مِِيدَالْيَة / اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / نَذْر / جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / حاد الانحدار, شديد الانحدار (ذو ميل حاد)\nمثال: سلالم العلية شديدة الانحدار / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / ضحكة ساخرة (ضحكة غير محترمة)",
 "きしょうえいせい": "قمر صناعي للأرصاد الجوية (قمر صناعي يبث صوراً متكررة للأرض أدناه لمراقبة الطقس)",
 "きしょうかち": "تَأَنُّق مُتَكَلَّف, تَحَذْلُق (صفة التشدد أو الإفراط في التهذيب والتأنق)",
 "きしょうかんそくせん": "سفينة أرصاد جوية (سفينة عابرة للمحيطات مجهزة لإجراء ملاحظات الأرصاد الجوية)",
 "きしょうがく": "عِلْم اَلطَّقْس, عِلْم الَأَرْصَاد الْجَوِّيَّة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "きしょうがくしゃ": "عالم أرصاد جوية (متخصص يدرس العمليات في الغلاف الجوي للأرض التي تسبب الأحوال الجوية)",
 "きしょうきょく": "مكتب الأرصاد الجوية (وحدة إدارية مسؤولة عن جمع وتفسير بيانات الأرصاد الجوية لدراسة الطقس والتنبؤات)",
 "きしょうせい": "شح, ندرة (كمية صغيرة وغير كافية)",
 "きしょうひん": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)\nمثال: رقة الغلاف الجوي العلوي",
 "きしょうぶ": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع…)",
 "きしょうよほう": "أرصاد جوية, تنبؤ جوي (التنبؤ بما سيكون عليه الطقس)",
 "きしょうよほうし": "متنبئ جوي (شخص يتنبأ بالطقس)",
 "きしょうらっぱ": "بوق الصباح, نوبة الاستيقاظ (إشارة للنهوض في الصباح؛ في الجيش هي نداء بالبوق عند شروق الشمس)",
 "きしょうレーダー": "رادار الطقس (رادار قادر على اكتشاف السحب وهطول الأمطار)",
 "きしょく": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ:…) / عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / مَوْقِف / مَزَاج / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / تَطَفُّل (العلاقة بين نوعين مختلفين من الكائنات الحية يحصل فيها أحدهما على فوائد من الآخر…) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَالِيّ الرُتْبَة",
 "きしょくがわるい": "عَجِيب, غَرِيب",
 "きしょくのわるい": "عَجِيب, غَرِيب",
 "きしょくわるい": "عَجِيب, غَرِيب",
 "きしょー": "معيب",
 "きしり": "صرير (صوت صرير)\nمثال: صرير ألواح الأرضية كشف أمره / اِحْتِكَاك / زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا)",
 "きしる": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا)",
 "きしん": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَنِين, اِشْتِيَاق / مُرَاسَلَة / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "きしんごう": "ضوء أصفر (إشارة للمضي قدماً بحذر)",
 "きじ": "مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء. / عَجِين, عَجِينَة / لَقِيط, مَلْقُوط / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "きじく": "مِحْوَر / قَاعِدَة, أَسَاس",
 "きじこうこく": "إِعْلَان تَحْرِيرِيّ, مَقَال إِعْلَانِيّ (إعلان مكتوب ومقدم بأسلوب تقرير تحريري أو صحفي)",
 "きじつ": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "きじねこ": "مُنَمَّش بِالبُنِّيّ (ذو نمش بنّيّ اللون)",
 "きじはた": "هُونْغ كُونْغ",
 "きじもく": "دَجَاجِيّ",
 "きじもなかずばうたれまい": "هُنَاكَ, يُوجَدُ",
 "きじや": "بَزَّاز",
 "きじゅう": "رَشَاش, مِتْرالِيُوز (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا…)\nمثال: إني أطلق النار برشاش روسي. / بندقية قصيرة, كاربين (بندقية آلية خفيفة)",
 "きじゅうき": "كُرْكِيّ, غُرْنُوق\nمثال: رفع سامي نظارته.",
 "きじゅつ": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر. / وَصْف, تَوْصِيف / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "きじゅつげんごがく": "لسانيات وصفية (وصف (في وقت معين) للغة فيما يتعلق بأصواتها وصرفها ونحوها ودلالاتها دون أحكام…)",
 "きじゅつこう": "إِدْخَال",
 "きじゅつし": "كلمة دالة, واصف (معلومة مخزنة تُستخدم لتحديد عنصر في نظام تخزين واسترجاع المعلومات) / مشعوذ, مُحَضّر أرواح (طبيب ساحر يمارس استحضار الأرواح)",
 "きじゅつてき": "وصفي (يتعلق بمنهج التحليل اللغوي الذي يهدف إلى وصف أشكال اللغة وتراكيبها واستخداماتها…)\nمثال: نحو وصفي",
 "きじゅつぶんぽう": "نحو وصفي (قواعد نحوية تنتجها اللسانيات الوصفية)",
 "きじゅん": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / مِعْيَارِيّ",
 "きじゅんか": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "きじゅんじてん": "عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "きじゅんせん": "خط القاعدة (الخطوط التي يجب أن يتبعها لاعب البيسبول أثناء الجري بين القواعد)\nمثال: أنشأوا خط أساس للميزانية",
 "きじゅんち": "قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة…)",
 "きじゅんてん": "مرجع, نقطة مرجعية (مؤشر يوجهك بشكل عام)",
 "きじゅんひょうほん": "عينة نمطية, عينة نموذجية (العينة الأصلية التي يتم بناءً عليها وصف نوع جديد (في البيولوجيا))",
 "きじゅんほう": "النظام الأساسي",
 "きじょ": "آلِيَّة / سَاحِرَة / امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / سيدة نبيلة, ليدي (امرأة من طبقة النبلاء في بريطانيا)",
 "きじょう": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا…)\nمثال: إنها مجرد نظرية. / بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم / ركوب الخيل (السفر محمولاً على ظهر الخيل) / تفلق\nمثال: سافر بالقطار / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "きじょうばん": "قاموس مكتبي (قاموس موجز بحجم مناسب للحمل باليد)",
 "きじょうぶ": "مُطَمْئِن (يعيد الثقة ويخفف القلق)\nمثال: ملاحظة مطمئنة جداً / بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "きじょうみゃく": "وَرِيد فَرْد",
 "きじらみ": "قمل النبات القافز (حشرة صغيرة نشطة تشبه الزيز لها أرجل خلفية متكيفة للقفز؛ تتغذى على عصارة النبات)",
 "きじりょく": "قوة دافعة مغناطيسية (القوة التي تنتج الفيض المغناطيسي)",
 "きじるし": "جُنُون",
 "きじん": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة / غَرِيب الْأَطْوَار (شخص يعتبر غريب الأطوار أو مجنوناً ويبرز عن المجموعة) / أَخْضَر مُصْفَرّ (بلون متوسط بين الأصفر والأخضر)",
 "きす": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / دَرَجَة\nمثال: الصهاينة أشر من النازيين. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي. / صَلَّحَ / تَوَقَّعَ / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / صِفَة, خُصُوصِيَّة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة.",
 "きすい": "مُرْتَبِط, مُلْتَزِم (مرتبط في علاقة جنسية حصرية)\nمثال: أعضاء كنيسة ملتزمون",
 "きすいえんこう": "موليبدينيت (معدن يشبه الجرافيت يُثمن كمصدر رئيسي للموليبدينوم ومركباته)",
 "きすいせん": "جونكيل, نرجس مؤنث (نبات زينة يزرع على نطاق واسع موطنه جنوب أوروبا ولكنه متوطن في أماكن أخرى له…)",
 "きすう": "عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / نَتِيجَة / عَدَد أَصْلِيّ (عدد عناصر مجموعة رياضية؛ يشير إلى كمية ولكن ليس إلى الترتيب) / قَاعِدَة / مُوَجِّه ذَاتِيًّا (يوجه أو يقود نحو المنزل أو الوجهة)",
 "きすううじょうふくよう": "فَرْدِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بوريقة مُنفردة عند القمّة)",
 "きすうし": "عدد أصلي ((نحو) كلمة تعبر عن كمية قابلة للعد)",
 "きすうほう": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
 "きすぐ": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "きする": "صَلَّحَ / تَوَقَّعَ / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / صِفَة, خُصُوصِيَّة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة. / مُلَاحَظَة, مَلْحُوظَة / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي.",
 "きず": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / تفتيت, شطف (عملية شطف جزء من شيء ما) / عَيْبٌ\nمثال: ここに傷があるので安くしてください。 — يوجد خدشة هنا، فهل تستطيع اعطائي حسم؟ / بُقْعَة",
 "きずあと": "نَدْبَة, نَدْب",
 "きずい": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "きずいしょう": "سيترين (كوارتز أصفر شبه كريم يشبه التوباز)",
 "きずいせん": "جونكيل, نرجس مؤنث (نبات زينة يزرع على نطاق واسع موطنه جنوب أوروبا ولكنه متوطن في أماكن أخرى له…)",
 "きずきあげる": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "きずく": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / لَاحَظَ",
 "きずぐすり": "مَرْهَم, زَبْدَة",
 "きずぐち": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / بضع, شق جراحي (قطع أنسجة الجسم أو أعضائه (خاصة بواسطة جراح كجزء من عملية))",
 "きずつきやすい": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "きずつける": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة.",
 "きずな": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض)\nمثال: الالتصاق المتبادل للخلايا / رسن, مقود (قيد يتكون من حبل (أو سلسلة خفيفة) يستخدم لتقييد حيوان) / رمل أخضر (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل.",
 "きずみ": "فَحْم الْخَشَب",
 "きずもの": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "きずもん": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "きずテープ": "ضمادة لاصقة (ضمادة تتكون من قطعة شاش ماص مثبتة بشريط بلاستيكي أو قماشي مطلي بمادة لاصقة)",
 "きずバン": "ضمادة لاصقة (ضمادة تتكون من قطعة شاش ماص مثبتة بشريط بلاستيكي أو قماشي مطلي بمادة لاصقة)",
 "きせい": "تَطَفُّل (العلاقة بين نوعين مختلفين من الكائنات الحية يحصل فيها أحدهما على فوائد من الآخر…) / مُتَرَسِّخ / جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / إياب, رجوع (المجيء أو العودة إلى الوطن)\nمثال: عند عودته من أستراليا أقمنا له حفلة ترحيب / اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة)\nمثال: تحدث بحماسة كبيرة / نَذْر / نَادِر / تَنْظِيم / تَصْحِيح / مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا) / استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال / ذَاكِرَة, حَافِظَة / آلِيَّة / استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس)",
 "きせいかいじょ": "إلغاء التنظيم, رفع القيود (عملية التحرير من اللوائح (خاصة اللوائح الحكومية))",
 "きせいかんねん": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "きせいかんわ": "إلغاء التنظيم, رفع القيود (عملية التحرير من اللوائح (خاصة اللوائح الحكومية))",
 "きせいがいねん": "صُورَة نَمَطِيَّة",
 "きせいきのう": "عملية تحكم (عملية تتحكم في تسجيل أو معالجة أو إرسال أو تفسير البيانات)\nمثال: بدأت عملية تحكم بمعالجة البيانات",
 "きせいこん": "ممص (ملحق يشبه الجذر في النباتات الطفيلية يخترق المضيف ويحصل منه على الغذاء)",
 "きせいしゃ": "طُفَيْلِيّ",
 "きせいしょくぶつ": "نبات طفيلي (نبات يعيش على نبات آخر ويحصل منه على الغذاء العضوي)",
 "きせいじじつ": "أَمْر وَاقِع (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "きせいせいぶつ": "طُفَيْلِيّ",
 "きせいせん": "شريط زينة, وشاح (زينة تتكون من شريط أو حبل مزخرف)",
 "きせいちゅう": "طُفَيْلِيّ",
 "きせいちゅうびょう": "داء الديدان الطفيلية (إصابة الجسم بالديدان الطفيلية)",
 "きせいてっぱい": "إلغاء التنظيم, رفع القيود (عملية التحرير من اللوائح (خاصة اللوائح الحكومية))",
 "きせいばえ": "ذبابة تاشينا (ذبابة شائكة تعيش يرقاتها بشكل طفيلي في اليرقات والحشرات الأخرى؛ مهمة في مكافحة…)",
 "きせいばち": "زِنْبَار طُفَيْلِيّ",
 "きせいひん": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "きせいふく": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "きせいほう": "زِنْبَار طُفَيْلِيّ",
 "きせいやくぶつ": "مادة خاضعة للرقابة (عقار أو مادة كيميائية تخضع حيازتها واستخدامها لرقابة القانون)",
 "きせいバチ": "زِنْبَار طُفَيْلِيّ",
 "きせき": "حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر. / محل هندسي (مجموعة كل النقاط أو الخطوط التي تحقق شروطاً محددة أو تتحدد بها)\nمثال: المحل الهندسي للنقاط المتساوية البعد عن نقطة معينة هو دائرة / بيروكسين (أي من مجموعة معادن السيليكات البلورية الشائعة في الصخور النارية والمتحولة) / مُعْجِزَة, أُعْجُوبَة / قائمة الوفيات (قائمة بالأشخاص الذين ماتوا مؤخراً) / جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "きせきてき": "خَارِق, مُعْجِز (الشيء)\nمثال: ذلك خارق للعادة.",
 "きせずして": "بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
 "きせつ": "مُتَرَسِّخ / مَوْسِم / فغر الرغامى (عملية جراحية تخلق فتحة في القصبة الهوائية مع إدخال أنبوب لتوفير ممر للهواء…)",
 "きせつせい": "موسمي (يحدث في أو يعتمد على موسم معين)\nمثال: عمالة موسمية",
 "きせつせいかんじょうしょうがい": "حَزِين, زعلان",
 "きせつせいきぶんしょうがい": "حَزِين, زعلان",
 "きせつせいじょうどうしょうがい": "حَزِين, زعلان",
 "きせつちょうせい": "تعديل موسمي (تعديل إحصائي يتم لاستيعاب التقلبات المتوقعة كدالة لموسم السنة)\nمثال: يجب إجراء التعديلات الموسمية لبدايات الإسكان في منتصف الشتاء",
 "きせつてき": "موسمي (يحدث في أو يعتمد على موسم معين)\nمثال: عمالة موسمية",
 "きせつはずれ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "きせる": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / غِطَاء / دَبُّوس",
 "きせん": "حافة الطريق, قارعة الطريق (حدود عشبية على طول الطريق)\nمثال: على شفا البكاء / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء. / في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "きせんいでん": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)",
 "きせんしょうか": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "きせんじょうげ": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "きぜつ": "إِغْمَاء / بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن)",
 "きぜわしい": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)\nمثال: ليلة قلقة",
 "きぜん": "بِلَا تَرَدُّد, عَازِم (يتميز بالسرعة والحزم في اتخاذ القرار)\nمثال: وقف بحزم ضد العدو / تَنَهَّدَ",
 "きそ": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة",
 "きそい": "مُنَافَسَة, مُبَارَاة",
 "きそう": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية)\nمثال: تعلم الرسم من والده / تَنَافَسَ, تَبَارَى / تَبَرُّع, هِبَة / حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة / مُوَجِّه ذَاتِيًّا (يوجه أو يقود نحو المنزل أو الوجهة) / ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية / كُوشَانِيّ, كُوشَانِيَّة",
 "きそうきょく": "كابريتشيو (مقطوعة آلية لا تلتزم بقواعد أي شكل موسيقي محدد وتُعزف بارتجال)",
 "きそうご": "ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "きそうしゃ": "مُتَبَرِّع",
 "きそうてんがい": "رَائِع",
 "きそがため": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "きそく": "تَنَفُس, نَفَس / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / غُلّ, أَغْلال",
 "きそくせい": "اطِّرَاد, انْتِظَام (صفة الاتصاف بمبدأ ثابت أو معدل ثابت)\nمثال: كان مشهوراً بانتظام عاداته",
 "きそくただしい": "عَادِيّ",
 "きそくてき": "مُمَنْهَج",
 "きそくどうし": "فِعْل مُنْتَظِم, فِعْل عَادِيّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "きそくをまもる": "خَلَدَ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في…)\nمثال: خلد ياني إلى النوم.",
 "きそけい": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية…)",
 "きそこうぞう": "بِنْيَة تَحْتِيَّة",
 "きそじちたい": "بَلَدِيَّة",
 "きそじょう": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما)\nمثال: الكتاب هو لائحة اتهام للفلسفة الحديثة",
 "きそたいおん": "درجة حرارة الجسم الأساسية (درجة حرارة الجسم في الصباح قبل النهوض أو التحرك أو تناول أي شيء)",
 "きそたいしゃ": "استقلاب قاعدي, معدل الأيض الأساسي (كمية الطاقة المطلوبة للحفاظ على جسم الفرد في حالة الراحة)",
 "きそたいしゃりつ": "مُعَدَّل الْأَيْض الْأَسَاسِيّ, مُعَدَّل الاِسْتِقْلَاب الْأَسَاسِيّ (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير…)\nمثال: انخفض معدل الجريمة.",
 "きそたいしゃりょう": "مُعَدَّل الْأَيْض الْأَسَاسِيّ, مُعَدَّل الاِسْتِقْلَاب الْأَسَاسِيّ (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير…)\nمثال: انخفض معدل الجريمة.",
 "きそちしき": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "きそつしゃ": "طَالِب, طَلَبَة",
 "きそてき": "أَسَاسِيّ",
 "きそりつ": "سعر الفائدة الأساسي (سعر الفائدة الذي يحدده بنك إنجلترا للإقراض للبنوك الأخرى)",
 "きそれん": "تدريب أساسي (الفترة الأولية لتدريب الأفراد العسكريين الجدد؛ تتضمن نشاطاً بدنياً مكثفاً…)",
 "きそん": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة.",
 "きそレン": "تدريب أساسي (الفترة الأولية لتدريب الأفراد العسكريين الجدد؛ تتضمن نشاطاً بدنياً مكثفاً…)",
 "きぞう": "تَبَرُّع, هِبَة",
 "きぞうしゃ": "مُتَبَرِّع",
 "きぞうひん": "هَدِيَّة, هدية",
 "きぞく": "انتماء (السعادة التي تشعر بها في علاقة آمنة)\nمثال: مع زملائه في الفصل شعر بإحساس بالانتماء / انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / نُبْل, نَبَالَة",
 "きぞくいしき": "بِطَاقَة هُوِيَّة",
 "きぞくいん": "مَجْلِس لُورْدَات",
 "きぞくかいきゅう": "نُبْل, نَبَالَة",
 "きぞくしゅぎ": "أرستقراطية (مبادئ أو ممارسات أو خصائص الأرستقراطية)\nمثال: هذا التصميم مذهل تماماً ويحمل روح الأرستقراطية",
 "きぞくせい": "أَرِسْتُقْرَاطِيَّة",
 "きぞくせいじ": "أَرِسْتُقْرَاطِيَّة",
 "きぞくてき": "أَرِسْتُقْرَاطِيّ",
 "きぞん": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي",
 "きた": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا. / رياح شمالية (رياح تهب من الشمال) / جَيِّد (بَيِّن الجَوْدَة)",
 "きたい": "خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل) / جِسْم طَائِرَة, جِسْم (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم. / غَاز / غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة / غَرِيب, عَجِيب / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه…)\nمثال: عندي ابنا خالة. / قَاعِدَة / ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "きたいち": "قِيمَة مُتَوَقَّعَة / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له))",
 "きたいていすう": "ثَابِت الْغَاز, ثَابِت الْغَازَات الْعَامّ (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "きたいはずれ": "خَيْبَة أَمَل",
 "きたいみもん": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل)",
 "きたいる": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى)\nمثال: خذها إلى الأعلى.",
 "きたえ": "تطريق, حدادة (تشكيل المعدن عن طريق التسخين والطرق) / إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول)",
 "きたえる": "وَرْشَة حِدَادَة / ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "きたかいきせん": "مَدَار السَّرَطَان (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "きたかぜ": "رياح شمالية (رياح تهب من الشمال)",
 "きたがわ": "الجانب الشمالي (الجانب الذي يقع في الشمال)",
 "きたく": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "きたぐに": "الأراضي الشمالية, الشمال (أي منطقة تقع في الشمال أو باتجاهه)",
 "きたす": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "きたせきどうかいりゅう": "التيار الاستوائي الشمالي (تيار استوائي يتدفق غرباً عبر المحيط الهادئ شمال خط الاستواء مباشرة)",
 "きたたいせいようじょうやくきこう": "مُنَظَّمَة حِلْف شَمَال اَلْأَطْلَسِيّ, اَلْحِلْف اَلْأَطْلَسِيّ",
 "きたちょうせん": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا.",
 "きたちょうせんじん": "كوري شمالي (من أو يتعلق بكوريا الشمالية أو شعبها أو ثقافتها أو يميزهم)",
 "きたない": "قَذِر, وَسِخ\nمثال: أنت من وسخ الأرض. / مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة / دَنِيء, نَذْل (جَبَان بِشَكْلٍ مُحْتَقَر ووَضِيع)",
 "きたないせんそう": "حَرْب قَذِرَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "きたないばくだん": "قُنْبُلَة قَذِرَة",
 "きたないやりかた": "حيلة دنيئة, خدعة خبيثة (خدعة عدوانية أو غير لطيفة)",
 "きたならしい": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة)",
 "きたのかた": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / زَوْجَة, اِمْرَأَة",
 "きたのほう": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "きたはんきゅう": "نِصْف اَلْكُرَة الْأَرْضِيَّة الشَّمَالِيّ",
 "きたひがし": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي)",
 "きたまえぶね": "شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "きたより": "شَمَالًا (في اتجاه الشمال)\nمثال: يكسبون أكثر في الشمال",
 "きたりす": "سنجاب أحمر (سنجاب بني محمر شائع في أوروبا وأجزاء من آسيا)",
 "きたる": "قَادِم\nمثال: زيري بجانب الحوض. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "きたろうぶくろ": "دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "きたん": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز)",
 "きたんのない": "طليق, غير مقيد (غير خاضع للتقييد)\nمثال: ضحك غير مقيد",
 "きたアイルランド": "أِيرْلَنْدَا الشَّمَالِيَّة (جزيرة تقع في شمال المحيط الأطلسي، تحدها جزيرة بريطانيا العظمى من الشرق؛ دولة في…)",
 "きたアフリカ": "شَمَال إِفْرِيقِيَا, شَمَال أَفْرِيقِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "きたアメリカ": "أَمْرِيكَا الشَّمَالِيَّة",
 "きたオポッサム": "أمريكي شمالي (متعلق بقارة أمريكا الشمالية أو دولها أو شعوبها أو مميز لها)",
 "きたキプロス": "قُبْرُص الشَّمَالِيَّة (دولة تحكمها جمهورية قبرص، وهي عضو من الاتحاد الأوروبي منذ 2004، ولكنها لا تسيطر…)\nمثال: كانت قبرص محمية بريطانية.",
 "きたマケドニア": "مَقِدُونِيَا الشَّمَالِيَّة",
 "きたマケドニアきょうわこく": "جُمْهُورِيَّة شَمَالِ مَقْدُونِيَا",
 "きたヨーロッパ": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة.",
 "きだい": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "きだおれ": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "きだち": "بستان, غابة صغيرة (حديقة تتكون من خشب مزروع صغير بدون شجيرات سفلية)",
 "きだちはっか": "ندغ صيفي (عشبة ذات أوراق بنكهة رقيقة ولها استخدامات عديدة)",
 "きだちひゃくりこう": "زَعْتَر, صَعْتَر (هو الصَعْتَر ببعض اللهجات العامية؛ شراب يشبه الشَاي يصنع من الصعتر)",
 "きだて": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "きだはし": "سَلَالِم",
 "きだん": "كتلة هوائية (جسم كبير من الهواء بخصائص موحدة أفقياً) / زوج (رجل متزوج؛ شريك المرأة في الزواج) / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "きち": "استدلال (التفكير المتضمن في استخلاص نتيجة أو إصدار حكم منطقي بناءً على أدلة ظرفية…) / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / قَاعِدَة / متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مَعْلُوم / وعي, إدراك (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي. / حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "きちがい": "جُنُون / شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما)",
 "きちがいざた": "جُنُون",
 "きちがいなすび": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "きちがいみず": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "きちがい水": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "きちがい沙汰": "جُنُون",
 "きちきち": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ) / بِدِقَّة",
 "きちく": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية)",
 "きちじょう": "سَعِيد\nمثال: فرح فاضل كثيرا.",
 "きちっと": "كَمَا يَجِب, كَمَا يَنْبَغِي / بأناقة, بترتيب (بترتيب ونظافة)\nمثال: وضعت الخف تحت السرير بترتيب",
 "きちゃく": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / نَتِيجَة / نَقْص",
 "きちゅう": "حِدَاد\nمثال: هو ذئب في ثوب حمل. / جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)",
 "きちょう": "قَاعِدَة, أَسَاس / رَائِج, مُتَدَاوَل / فكرة رئيسية, محور (فكرة أساسية أو مركزية) / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار. / سجل, سجل رسمي (سجل مكتوب رسمي للأسماء أو الأحداث أو المعاملات) / ثَمِين / حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس) / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "きちょうえんぜつ": "خطاب افتتاحي, كلمة رئيسية (خطاب يحدد الموضوع الرئيسي)",
 "きちょうこうえん": "خطاب افتتاحي, كلمة رئيسية (خطاب يحدد الموضوع الرئيسي)",
 "きちょうひん": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه…)\nمثال: إعطي قيمة لذاتك.",
 "きちょうめん": "مَنْهَجِيّ, مُنَظَّم (يتسم بالمنهجية والدقة في الترتيب)",
 "きちんきちん": "بشكل صحيح (بطريقة دقيقة)\nمثال: رسمت الزهرة بشكل صحيح من قبل ابنه",
 "きちんと": "كَمَا يَجِب, كَمَا يَنْبَغِي / بأناقة, بترتيب (بترتيب ونظافة)\nمثال: وضعت الخف تحت السرير بترتيب",
 "きっかい": "غَرِيب, عَجِيب / سَائِل",
 "きっかいせんばん": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "きっかけ": "فُرْصَة\nمثال: 彼等は彼に逃げるきっかけを与えた。 — أعطوه فرصة للهروب. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "きっかり": "بِالضَّبْط, تَمَامًا / بانتظام, في الموعد (في الوقت المتوقع أو المناسب)\nمثال: تصل دائماً في الموعد",
 "きっきゅうじょ": "مُبَجِّلٌ, مُوَقِّرٌ (يُظهر التوقير والاحترام)",
 "きっきゅう如": "مُبَجِّلٌ, مُوَقِّرٌ (يُظهر التوقير والاحترام)",
 "きっきょ": "اِجْتِهَاد",
 "きっきょう": "ثَرْوَة / دَهْشَة, تَعَجُّب",
 "きっきょうぎょうてん": "مَذْهُول",
 "きっきん": "مُسْتَعْجِل",
 "きっくつ": "ثني, حني (عملية ثني شيء ما) / غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب)\nمثال: كلام غير مفهوم / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب",
 "きっくつした": "قوي, متين (قوي ومتين في البنية أو البناء؛ دائم التحمل)\nمثال: مع منزل مليء بالأولاد، يجب أن يكون لديك أثاث متين",
 "きっこう": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء) / تَنَافُس, مُنَافَسَة (فعل التنافس من أجل الربح أو الجائزة)\nمثال: كانت الفرق في تنافس شرس على المركز الأول",
 "きっこうきん": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "きっこうさよう": "تضاد حيوي ((كيمياء حيوية) تداخل في أو تثبيط العمل الفسيولوجي لمادة كيميائية بواسطة أخرى…)\nمثال: التنافر المتأصل بين الرأسمالية والاشتراكية",
 "きっこうやく": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "きっさ": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ…)\nمثال: هذا المقهى مريح. / بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "きっさう": "بُشْرَى (الخبر السار)",
 "きっさき": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "きっさてん": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "きっしょい": "معيب",
 "きっしょう": "سَعِيد\nمثال: فرح فاضل كثيرا.",
 "きっしょく": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "きっしょー": "معيب",
 "きっす": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / تَأَلَّمَ, عَانَى\nمثال: لقد عانى جمال كثيرا.",
 "きっすい": "صَافٍ, اَلصَّافِي / مُسْوَدَّة",
 "きっすいせん": "خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن…)",
 "きっする": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / تَأَلَّمَ, عَانَى\nمثال: لقد عانى جمال كثيرا.",
 "きっせき": "تَأْنِيب, عَذَل",
 "きっそう": "بُشْرَى (الخبر السار)",
 "きっそうさん": "حمض البنتانويك, حمض الفاليريك (حمض كربوكسيلي سائل شفاف يستخدم في العطور والأدوية)",
 "きったはった": "عَنِيف",
 "きっちり": "بِالضَّبْط, تَمَامًا / بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان)\nمثال: كانت البدايات متقاربة زمنياً / كَمَا يَجِب, كَمَا يَنْبَغِي",
 "きって": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "きってあつめ": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "きってしゅうしゅう": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "きってしゅうしゅうか": "جامع طوابع, هاوي طوابع (جامع ودارس للطوابع البريدية)",
 "きってすてる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا! / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "きってちょう": "ألبوم طوابع (ألبوم للطوابع)",
 "きってはきれない": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "きってもきれない": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "きっと": "بِالتَّأْكِيد / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: قالت بصرامة: 'لا' / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ) / فَجْأَةً",
 "きっぱし": "جُثَّة, جُثْمَان (جسد إنسان ميت)\nمثال: كانت الجثة مخصصة للتشريح",
 "きっぱり": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "きっぱん": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "きっぷ": "تَذْكِرَة / شَخْصِيَّة\nمثال: زيري سيء الخلق.",
