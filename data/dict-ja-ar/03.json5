 "がくいき": "شَهَادَة, دِبْلُوم",
 "がくいり": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "がくいろんぶん": "أُطْرُوحَة",
 "がくいん": "مَعْهَد (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم إذا انتأَوا عنهُ رجعوا إليه. الجمع مَعَاهِد. استخدام قديم) / أنشأ (أَوْجَدَ، خَلَقَ؛ بَدَأَ)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا / عازف فرقة (عازف ذكر في فرقة موسيقية (خاصة فرقة عسكرية))",
 "がくう": "جَوِّيّ, هَوَائِيّ",
 "がくえん": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "がくえんちょう": "مُدِير (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "がくおん": "نغمة, نوتة (تدوين يمثل حدة ومدة صوت موسيقي)\nمثال: أمسك المغني بالنوتة لفترة طويلة جداً",
 "がくかんせつ": "مفصل صدغي فكي, مفصل فكي (المفصل بين رأس عظم الفك السفلي والعظم الصدغي)",
 "がくがく": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / مُتَأَرْجِح, مُتَمَوِّج ((للصوت) يتذبذب بشكل غير ثابت) / جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "がくがすくない": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "がくがない": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "がくぎょ": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر.",
 "がくぎょう": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "がくぎょうふしん": "أداء دون المستوى, تقصير (أداء أضعف من المتوقع (أقل مما كان يمكن التنبؤ به من اختبارات الذكاء))",
 "がくぐん": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "がくげい": "إنسانيات, علوم إنسانية (دراسات تهدف إلى توفير معرفة عامة ومهارات فكرية (بدلاً من المهارات المهنية أو الوظيفية))\nمثال: كلية الآداب والعلوم",
 "がくげいいん": "منظم معارض",
 "がくげき": "أُوبِرَا, أُوپِرَا",
 "がくこつ": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "がくさい": "متعدد التخصصات, مشترك التخصصات (يستمد من أو يتميز بمشاركة مجالين دراسيين أو أكثر)\nمثال: دراسات متعددة التخصصات",
 "がくさいてき": "متعدد التخصصات, مشترك التخصصات (يستمد من أو يتميز بمشاركة مجالين دراسيين أو أكثر)\nمثال: دراسات متعددة التخصصات",
 "がくし": "أَعْزَب, عَازِب / بَكَالُورِيَا / مُوسِيقِيّ, مُوسِيقِيَّة (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "がくしいん": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "がくしき": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "がくしごう": "بَكَالُورِيَا",
 "がくしゃ": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / ضليع, عالم (شخص تم قبوله كعضو في مجال علمي أو معرفي)",
 "がくしゅう": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم. / ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "がくしゅうきょくせん": "منحنى التعلم (رسم بياني يوضح معدل التعلم (خاصة الرسم البياني الذي يوضح المقدار الذي تم تذكره كدالة لعدد محاولات التذكر))",
 "がくしゅうこんなん": "اضطراب التعلم, صعوبات التعلم (اضطراب يوجد لدى الأطفال ذوي الذكاء الطبيعي الذين يواجهون صعوبات في تعلم مهارات محددة)",
 "がくしゅうしつ": "قاعة المطالعة (فصل دراسي مخصص للدراسة) / حصة دراسة حرة, قاعة استذكار (فترة زمنية خلال اليوم الدراسي تخصص للدراسة والمذاكرة)",
 "がくしゅうしゃ": "صبيّ, متدرب مهني (يعمل لدى خبير لتعلم مهنة) / تلميذ, طالب (شخص (خاصة طفل) يتعلم (كما من معلم) أو يكتسب المعرفة أو المعتقدات)",
 "がくしゅうしょうがい": "اضطراب التعلم, صعوبات التعلم (اضطراب يوجد لدى الأطفال ذوي الذكاء الطبيعي الذين يواجهون صعوبات في تعلم مهارات محددة)",
 "がくしゅうじてん": "قاموس المتعلم (قاموس مكتوب خصيصاً لمن يتعلمون لغة أجنبية)",
 "がくしゅうせいむりょくかん": "عَجْز مُتَعَلِّم, عَجْز مُكْتَسَب",
 "がくしゅうちょう": "كراسة تمارين, كراسة عمل (كتاب أو كتيب للطالب يحتوي على مسائل مع مساحات لحلها)",
 "がくしゅうのうりょく": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "がくしゅうよう": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "がくしょう": "حَرَكَة / عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "がくしょく": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "がくじゅつ": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء) / عِلْم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "がくじゅつしょ": "مجلد ضخم (كتاب كبير وعلمي (عادة))",
 "がくじゅつてき": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "がくじゅつろんぶん": "رِسَالَة",
 "がくじん": "مُوسِيقِيّ, مُوسِيقِيَّة (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا. / متسلق جبال الألب (متسلق جبال يتخصص في التسلق الصعب)",
 "がくせい": "طَالِب, طَالِبَة",
 "がくせいかいかん": "اتحاد الطلاب (مبنى في الحرم الجامعي مخصص للأنشطة الاجتماعية والتنظيمية للطلاب)",
 "がくせいかばん": "حقيبة مدرسية (حقيبة لحمل الكتب والأدوات المدرسية)\nمثال: وجد القاموس المناسب تماماً لوضعه في حقيبته المدرسية",
 "がくせいふく": "زِي مَدْرَسِيّ",
 "がくせき": "إِنْجَاز",
 "がくせつ": "نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "がくぜん": "مَذْهُول",
 "がくそう": "مَوْضُوع / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم. / تأطير, صياغة (صياغة الخطط والتفاصيل الهامة) / إطار صورة, برواز (إطار يدعم ويحمي صورة أو مرآة)\nمثال: صياغة المراسيم القضائية",
 "がくたい": "فِرْقَة, فرقة / فِرْقَة",
 "がくだん": "أُورْكِسْتْرَا",
 "がくだんいん": "مُوسِيقِيّ, مُوسِيقِيَّة (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "がくちょう": "رَئِيس, رَئِيسَة / قائد فرقة موسيقية (قائد فرقة موسيقية (وخاصة الفرق النحاسية أو العسكرية))",
 "がくてき": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "がくと": "طَالِب, طَالِبَة",
 "がくどう": "تِلْمِيذ, تِلْمِيذَة",
 "がくどうみゃく": "شريان فكي علوي (أي من شريانين يتفرعان من الشريان السباتي الظاهر ويغذيان تراكيب الوجه)",
 "がくねん": "سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "がくねんど": "سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "がくのある": "متعلم, مثقف (يمتلك تعليماً (خاصة وجود معرفة أكثر من المتوسط)) / مُسْتَنِير, وَاعٍ (يتّسم بالفهم الكامل للمسألة المطروحة)",
 "がくは": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "がくばつ": "ربطة عنق المدرسة (ربطة عنق تشير إلى المدرسة التي ارتادها مرتديها)",
 "がくばついしき": "ربطة عنق المدرسة (ربطة عنق تشير إلى المدرسة التي ارتادها مرتديها)",
 "がくひ": "دروس خصوصية, وصاية تعليمية (تدريس التلاميذ بشكل فردي (عادة بواسطة معلم خاص)) / رسوم دراسية, مصاريف الدراسة (رسم يُدفع للتعليم (خاصة للتعليم العالي))\nمثال: كانت الرسوم الدراسية والسكن والطعام أكثر من 25000 دولار",
 "がくびく": "ارتعاش, نفضة (تشنج عضلي مفاجئ؛ خاصة الناتج عن حالة عصبية)",
 "がくふ": "مُؤَسَّسَة تَعْلِيمِيَّة / حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر. / إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "がくふだい": "حامل النوتة الموسيقية (حامل خفيف لحمل أوراق الموسيقى المطبوعة)",
 "がくぶ": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر) / غناء ورقص (أداء مسرحي يجمع بين الغناء والرقص) / قسم الموسيقى (القسم الأكاديمي المسؤول عن تدريس الموسيقى وتذوق الموسيقى)",
 "がくぶがくせい": "طالب جامعي (طالب جامعي لم يحصل بعد على درجته الأولى)",
 "がくぶせい": "طالب جامعي (طالب جامعي لم يحصل بعد على درجته الأولى)",
 "がくぶち": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / عارضة (الجزء السفلي من السطح المعمد؛ يرتكز مباشرة على تيجان الأعمدة) / إطار الباب (الإطار الزخرفي حول الباب أو النافذة)",
 "がくぶちょう": "عميد (إداري مسؤول عن قسم في جامعة أو كلية) / عميد مجمع الكرادلة ((الكنيسة الكاثوليكية الرومانية) رئيس مجمع الكرادلة) / عَمِيد (رجل هو العضو الأقدم في مجموعة ما)\nمثال: هو عميد المراسلين الأجانب",
 "がくへん": "سَبَلَة, كَأْسِيَّة",
 "がくぼ": "حَمَاة",
 "がくめい": "اِسْم عِلْمِيّ (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "がくめん": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "がくめんかかく": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "がくめんちょうかがく": "إصدار مُكَلف / فاخر",
 "がくめんどおり": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية) / حَرْفِيًّا, كَلِمَة بِكَلِمَة (باستخدام نفس الكلمات تماماً)\nمثال: كرر ملاحظاتها حرفياً",
 "がくもん": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس. / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "がくもんじょ": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "がくもんてき": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "がくもんのと": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "がくや": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة. / مِن وَرَاءَ السِّتارِ, وَرَاءَ الكَوالِيسِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "がくやうら": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "がくやぐち": "باب المسرح, مدخل الكواليس (مدخل إلى منطقة الكواليس في المسرح؛ يستخدمه الفنانون وموظفو المسرح الآخرون)",
 "がくり": "فَجْأَةً",
 "がくりょう": "قاعة إقامة (سكن جامعي) / مدرسة بنات, مدرسة خاصة (مكان خاص لتعليم الصغار) / كلية لاهوت, معهد لاهوتي (مدرسة لاهوتية لتدريب القساوسة أو الكهنة أو الحاخامات) / مَعْهَد, كُلِّيَّة (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم إذا انتأَوا عنهُ رجعوا إليه. الجمع مَعَاهِد. استخدام قديم) / كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا",
 "がくりょく": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "がくんと": "فَجْأَةً",
 "がく片": "سَبَلَة, كَأْسِيَّة",
 "がぐ": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "がぐつき": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "がけ": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف. / جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً) / بَيْن (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / عَاشِر / عُشْر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "がけい": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "がけくずれ": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "がけっぷち": "حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / حافة الهاوية, شفا (حافة مكان شديد الانحدار) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء",
 "がけぶち": "حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / حافة الهاوية, شفا (حافة مكان شديد الانحدار) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء",
 "がけぷち": "حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / حافة الهاوية, شفا (حافة مكان شديد الانحدار) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء",
 "がけ崩れ": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "がこう": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "がこうそう": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "がごう": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "がさいれ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "がさがさ": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "がさごそ": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "がさつ": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "がさつく": "حَفِيف",
 "がさみ": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "がさり": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "がさる": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "がさ入れ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "がざみ": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "がざめ": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "がし": "ورق رسم (ورق معد خصيصاً للاستخدام في الرسم الهندسي أو الفني) / مُبَارَك, مَبْرُوك / رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع. / كَمَا لَو, كَأَنَّ",
 "がしかし": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "がしがし": "بمرح صاخب (بطريقة مرحة وخالية من الهموم)\nمثال: كانت سعيدة بمرح صاخب",
 "がしっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "がしゃがしゃ": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / مُبَعْثَر, مُكَدَّس (مَمْلُوءٌ أَوْ مُتَنَاثِرٌ بِتَرَاكُمٍ فَوْضَوِيٍّ مِنَ الأَشْيَاء)",
 "がしゃん": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "がしゃーん": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "がしゅ": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / أَنَاقَة / جاذبية تصويرية, جمال أخاذ (حيوي وممتع بصرياً) / جَمَال, رَوْعَة تَصْوِيرِيَّة (صفة كون الشيء معبراً بشكل مذهل أو نابضاً بالحياة)",
 "がしゅう": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات) / تضخم الأنا, غرور (شعور متضخم بالفخر بتفوقك على الآخرين)",
 "がしょう": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "がしん": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "がしんたれ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "がじがじ": "عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع / مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب)",
 "がじゃがじゃ": "تفتيش دقيق, نبش (بحث شامل عن شيء ما (غالباً ما يسبب الفوضى أو الارتباك)) / أشياء مهملة, خردة (خليط من الأشياء المراد التخلص منها)\nمثال: قام بنبش العلية جيداً لكنه لم يجد زلاجاته",
 "がじゃまめ": "بريتل الفول السوداني, فول سوداني مقرمش (حلوى السكر المكرمل المحتوية على الفول السوداني)",
 "がじゅん": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "がじょう": "أَنَانِيَّة / حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "がじょく": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "がじん": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "がす": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / هَنَّأَ, يُهَنِّئُ",
 "がする": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / هَنَّأَ, يُهَنِّئُ",
 "がせ": "مُزَيَّف",
 "がせい": "تبرعم (تكاثر لاجنسي يصبح فيه نمو محلي على سطح أو في جسم الأصل فرداً منفصلاً)",
 "がせき": "زُبَالَة / نُفَايَات (بقيَّة؛ ما زاد على الحاجة) / قُمَامَة / مُخَلَّفَات\nمثال: توم عامل نفايات. / طُوبَة, لَبِنَة",
 "がせねた": "مَعْلُومَات مُضَلِّلَة",
 "がせネタ": "مَعْلُومَات مُضَلِّلَة",
 "がぜん": "فَجْأَةً / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "がそ": "بِكْسِل",
 "がぞう": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "がぞうあっしゅく": "ضغط الصور (ضغط الرسومات للتخزين أو الإرسال)",
 "がぞうようそ": "بكسل, عنصر صورة ((علم الحاسوب) أصغر مكون منفصل لصورة على الشاشة (عادة نقطة ملونة))\nمثال: كلما زاد عدد البكسلات في البوصة، زادت الدقة",
 "がた": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن. / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق. / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / بِالْقُرْب, قُرْبَ / مَوْجُود (الذي له وجود)\nمثال: رقصنا حول النار. / تداعي, تهالك (حالة تدهور بسبب الشيخوخة أو الاستخدام الطويل) / هرم, وهن الشيخوخة (حالة الهزال والضعف بسبب أو كما لو كان بسبب أمراض الشيخوخة)\nمثال: إنه مسرور بشكل غامض باكتشاف وهنه هذا، وينغمس فيما يتخيله امتيازًا للشيخوخة بالتحدث إلى نفسه في الأماكن العامة / انحلال, فجور (انغماس منحل في الملذات الحسية) / تَخَلْخُل, حَرَكَة حُرَّة (حركة أو مساحة للحركة (خاصة في الأجزاء الميكانيكية)) / انْفِلَات, تَحَرُّر (صفة قابلية الحركة بحكم التحرر من الارتباط أو القيود الأخرى) / تَرَاخٍ, تَسَيُّب (نقص الدقة الصارمة؛ التساهل في الممارسة)\nمثال: كان هناك الكثير من التخلخل في عجلة القيادة",
 "がたい": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / مأرمة, نسيج أولي (كتلة من الخلايا غير المتمايزة يتطور منها عضو أو جزء من الجسم)",
 "がたいがいい": "ضَخْم, هَائِل",
 "がたいのいい": "ضَخْم, هَائِل",
 "がたいのよい": "ضَخْم, هَائِل",
 "がたおち": "غَطَّسَ, غَمَسَ / غَطَسَ",
 "がたがた": "جداً, حقاً (تستخدم لإعطاء التوكيد) / خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / حشرجة, خشخشة (سلسلة سريعة من الأصوات العالية القصيرة (كما قد تسمع بالسماعة الطبية في بعض أنواع اضطرابات الجهاز التنفسي))\nمثال: كانت موهوبة جداً / مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / مُتَرَنِّح, مُهْتَزّ (يميل إلى الاهتزاز والترنّح بسبب ضعف أو خلل) / كُسَاحِيّ, مُصَاب بِالْكُسَاح (مصاب بالكُساح أو يتّسم بأعراضه)",
 "がたがたになる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "がたごと": "جداً, حقاً (تستخدم لإعطاء التوكيد) / خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / حشرجة, خشخشة (سلسلة سريعة من الأصوات العالية القصيرة (كما قد تسمع بالسماعة الطبية في بعض أنواع اضطرابات الجهاز التنفسي))\nمثال: كانت موهوبة جداً",
 "がたつく": "قَعْقَعَ / خُشْخِيشَة, شُخْلِيلَة",
 "がたぴし": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "がたろ": "كَبَا",
 "がたろう": "كَبَا",
 "がたん": "فَجْأَةً",
 "がたんごとん": "طقطقة إيقاعية (طقطقة سريعة وإيقاعية)\nمثال: طقطقة الآلات الكاتبة",
 "がた落ち": "غَطَّسَ, غَمَسَ / غَطَسَ",
 "がだい": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "がち": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة / بشكل سائد, في الغالب (أكبر بكثير في العدد أو التأثير)\nمثال: المرضى في الغالب من السكان الأصليين / جِدِّيّ / جَدِّيّ, جَادّ",
 "がちがち": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / صرصرة, طقطقة (سلسلة سريعة من الضوضاء التي تصدرها أجزاء الآلة) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ) / صلب الهيكل (يصف منطاداً أو سفينة هوائية تحافظ على شكلها بواسطة إطار أو هيكل صلب غير مرن) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك) / قِرْشَبّ, أَكُول (الرجل المسن الضخم العظيم الخلق؛ السيد الشريف الذي له هيبة ووقار)",
 "がちで": "بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "がちまやー": "أَكَّال, شَرَه",
 "がちゃがちゃ": "بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار / فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "がちゃつく": "قَعْقَعَ",
 "がちゃめ": "حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "がちゃ目": "حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "がちりん": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "がちんがちん": "تفتيت, شطف (عملية شطف جزء من شيء ما)",
 "がっか": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس.",
 "がっかい": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور. / الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "がっかく": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "がっかせん": "غدة تحت الفك السفلي (غدة لعابية داخل الفك السفلي على كلا الجانبين تنتج معظم اللعاب الليلي؛ تفرغ اللعاب في الفم تحت اللسان)",
 "がっかん": "عميد (إداري مسؤول عن قسم في جامعة أو كلية) / عميد مجمع الكرادلة ((الكنيسة الكاثوليكية الرومانية) رئيس مجمع الكرادلة) / عَمِيد (رجل هو العضو الأقدم في مجموعة ما)\nمثال: هو عميد المراسلين الأجانب",
 "がっき": "فترة دراسية, فصل دراسي (الوقت الذي تعقد فيه المدرسة الفصول الدراسية)\nمثال: اضطروا لتقصير الفصل الدراسي / آلَة مُوسِيقِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "がっきえんそうしゃ": "عازف, موسيقي (شخص يعزف الموسيقى كمهنة)",
 "がっきゃく": "رجل فكية, قدم فكية (واحدة من مجموعة من ثلاثة زوائد مزدوجة على صدر القشريات عشاريات الأرجل، تقع خلف الفك العلوي وتستخدم في التغذية)\nمثال: الزائدة المعدلة للمساعدة في التغذية تعرف بالرجل الفكية",
 "がっきゅう": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "がっきゅうてき": "دراسي, مدرسي (مكون من أو متعلق بالمدارس) / سكولاستي, مدرسي (مكون من أو متعلق بالمذهب الفلسفي للمدرسية (السكولاستية)) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق) / سكولاستي, مدرسي (فيلسوف أو لاهوتي مدرسي (سكولاستي))\nمثال: سنة دراسية",
 "がっきょく": "تأليف موسيقي, عمل موسيقي (عمل موسيقي تم إبداعه)\nمثال: التأليف مكتوب في أربع حركات",
 "がっく": "منطقة تعليمية (منطقة تدار مدارسها العامة معاً) / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "がっくり": "كَسِير الْقَلْب",
 "がっこう": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "がっこうしんぶん": "صحيفة مدرسية (صحيفة يكتبها وينشرها طلاب في مدرسة)",
 "がっこうせいど": "نظام مدرسي (مؤسسة تشمل المنشآت والمعدات لتوفير التعليم من رياض الأطفال حتى المدرسة الثانوية)",
 "がっこうちょう": "مدير مدرسة (المربي الذي لديه سلطة تنفيذية لمدرسة)\nمثال: أرسلت التلاميذ المشاغبين لرؤية المدير",
 "がっこつ": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "がっさいぶくろ": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "がっさく": "تَعَاوُن مُشْتَرَك, عَمَل مُشْتَرَك (فعل العمل المشترك) / تَوَاطُؤ, عَمَالَة (فعل التعاون الخياني مع عدو يحتل بلدك)\nمثال: عملوا إما بشكل تعاوني أو بشكل مستقل",
 "がっさん": "مَجْمُوع",
 "がっしき": "كُلّ, جَمِيع",
 "がっしと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "がっしゃん": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "がっしゃーん": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "がっしゅう": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "がっしゅうこく": "اِتِّحَادِيَّة, فِدِرَالِيَّة / الْوِلَايَات الْمُتَّحِدَة الْأَمْرِيكِيَّة, الْوِلَايَات الْمُتَّحِدَة",
 "がっしゅく": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "がっしゅくけいしき": "سَكَنِيّ",
 "がっしゅくしょ": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "がっしゅくじょ": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "がっしょう": "كَوْرَس, كُورَس / لَازِمَة, قَرَار / اَلْمُخْلِص / تَحَالُف, اِتِّحَاد",
 "がっしょうきょく": "كَوْرَس, كُورَس / لَازِمَة, قَرَار",
 "がっしょうたい": "كَوْرَس, كُورَس / لَازِمَة, قَرَار",
 "がっしょうだん": "خُورُس, جَوْقَة",
 "がっしょうぶ": "خُورُس, جَوْقَة",
 "がっしょうれんこう": "تَحَالُف, اِتِّحَاد",
 "がっしり": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "がっす": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "がっする": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "がっそう": "فِرْقَة, جَوْق / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "がっそうきょうそうきょく": "كونشرتو جروسو (تأليف باروكي للأوركسترا ومجموعة من الآلات المنفردة)",
 "がっそうだん": "فِرْقَة, جَوْق / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "がっそうちょう": "دوزان الحفلات, طبقة الحفلات",
 "がったい": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي! / تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "がったいじ": "ربط, عقد (عملية ربط أو توثيق الأشياء ببعضها البعض) / رابط, موثق (شيء يستخدم للربط أو التوثيق) / خيط ربط, رباط جراحي (خيط يستخدمه الجراحون لربط وعاء دموي (لتضييق تدفق الدم)) / رباط (شريط معدني يستخدم لربط الريشة بقطعة الفم في الكلارينيت أو الساكسفون)",
 "がったり": "فَجْأَةً",
 "がったんごっとん": "طقطقة إيقاعية (طقطقة سريعة وإيقاعية)\nمثال: طقطقة الآلات الكاتبة",
 "がっち": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "がっちり": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب. / ضَيِّق / حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "がっちりや": "جلدة, شحيح (شخص بخيل جداً)",
 "がっちり屋": "جلدة, شحيح (شخص بخيل جداً)",
 "がっつり": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / كَمَا يَجِب, كَمَا يَنْبَغِي",
 "がってん": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "がってんし": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "がってんしょうちのすけ": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "がってんだ": "مَفْهُوم",
 "がってん承知の助": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "がってん承知之助": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "がっぴ": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / خِفِي, خِيفِي (اختفى أو صار غير مرئي؛ أصبح سريًا أو مجهولًا)\nمثال: كانت لدى سامي حياة خفية.",
 "がっぷり": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "がっぺい": "اِنْدِمَاج",
 "がっぺいしゅうごう": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "がっぺいしょう": "تَعْقِيد / مُضَاعَفَة",
 "がっぽう": "اِنْدِمَاج",
 "がっぽうどり": "وَقْوَاق, وَقْوَاقِيَّة",
 "がっぽがっぽ": "بِالجُمْلَة (على نطاق واسع دون تمييز دقيق)\nمثال: أشتري الطعام بالجملة",
 "がっぽり": "بِالجُمْلَة (على نطاق واسع دون تمييز دقيق)\nمثال: أشتري الطعام بالجملة",
 "がつ": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "がつがつ": "بجوع, بنهم (بأسلوب شخص جائع جداً)\nمثال: انقض على الطعام بنهم / بِجَشَع, بِطَمَع (بطريقة جشعة)",
 "がつりん": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "がつん": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار. / بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "がてら": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "がてん": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "がてんがいく": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "がてんがゆく": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "がなりたてる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "がなり立てる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "がなる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "がにまた": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / ساق مقوسة, فحج (ساق منحنية للخارج عند الركبة (أو أسفل الركبة))",
 "がに股": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / ساق مقوسة, فحج (ساق منحنية للخارج عند الركبة (أو أسفل الركبة))",
 "がのつよい": "عَنِيد",
 "がはく": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "がはと": "فَجْأَةً",
 "がばがば": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه) / بشكل كبير / فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة) / مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "がばっと": "فَجْأَةً",
 "がばと": "فَجْأَةً",
 "がばりと": "فَجْأَةً",
 "がばん": "لوحة رسم هندسي (لوح أملس يوضع عليه الورق لعمل الرسومات)",
 "がひょう": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "がび": "هِلَال",
 "がびょう": "دبوس رسم, دبوس ضغط (دبوس لتثبيت الأوراق على لوحة إعلانات أو لوحة رسم)",
 "がふ": "خيش, قماش القنب (قماش ثقيل منسوج بإحكام) / أرضية الحلبة (البساط الذي يشكل أرضية الحلبة التي يتنافس فيها الملاكمون أو المصارعون المحترفون) / كانفاس, لوحة قماشية (لوحة زيتية على نسيج القنب (الكانفاس)) / خيمة قماشية (خيمة مصنوعة من نسيج القماش)\nمثال: نهض الملاكم عن أرضية الحلبة / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "がぶがぶ": "جرع, عب (شرب ملء الفم بسرعة كبيرة)",
 "がぶっと": "قضم بصوت عال (فعل المضغ بصوت عال)",
 "がぶのみ": "جرع, عب (شرب ملء الفم بسرعة كبيرة)",
 "がぶり": "بالتأكيد, بشكل قاطع (بدون شك وخارج نطاق الشك)\nمثال: كان باهظ الثمن بلا شك",
 "がぶる": "زِفْت",
 "がぶ飲み": "جرع, عب (شرب ملء الفم بسرعة كبيرة)",
 "がぷっと": "قضم بصوت عال (فعل المضغ بصوت عال)",
 "がほ": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "がほう": "حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / تصويري (متعلق بالصور أو يتكون منها) / مجلة مصورة (دورية (مجلة أو صحيفة) تحتوي على العديد من الصور)\nمثال: منظور تصويري / بوغ (جسم تكاثري لاجنسي صغير عادة ما يكون وحيد الخلية تنتجه العديد من النباتات غير الزهرية والفطريات وبعض البكتيريا والأوالي، وهو قادر على التطور إلى فرد…)\nمثال: يتكون البوغ الجنسي بعد اندماج الأمشاج / بوغ داخلي (بوغ لاجنسي صغير ينمو داخل خلية بعض البكتيريا والطحالب)",
 "がほうきかがく": "هندسة إسقاطية, هندسة وصفية (هندسة الخصائص التي تظل ثابتة تحت الإسقاط)",
 "がぼう": "مَشْغَل, وَرْشَة",
 "がぼがぼ": "دائرة الإسكات (دائرة كهربائية تقطع جهاز الاستقبال عندما تصبح الإشارة أضعف من الضوضاء) / إِفْحَام, تَقْلِيل مِن الشَّأْن (ملاحظة ساحقة ومحبطة) / بسرعة هائلة, بكميات كبيرة (بمعدل هائل (خاصة في كسب المال))\nمثال: جنى المال بسرعة هائلة",
 "がま": "عُلْجُوم, ضِفْدَع طِين",
 "がまあんこう": "سمكة العلجوم (سمكة تعيش في القاع ذات جلد لزج عديم القشور ورأس عريض سميك وفم واسع)",
 "がまがえる": "عُلْجُوم, ضِفْدَع طِين",
 "がましい": "شَبِهَ, بَدَا",
 "がましゅ": "ضفدع, كيسة تحت اللسان (كيس على الجانب السفلي من اللسان)",
 "がまん": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "がまんくらべ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "がまんじる": "مَذْي",
 "がまんづよい": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "がまんならない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "がまんのげんかい": "القشة الأخيرة, القشة التي قصمت ظهر البعير (الإزعاج الأخير الذي يمدد صبرك إلى ما بعد الحد)",
 "がまん強い": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "がみ": "تَكْرِير",
 "がみがみ": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "がむしゃら": "مُتَهَوِّر",
 "がめつい": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "がめる": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "がめん": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / صُورَة / اِنْطِبَاع, سُمْعَة",
 "がもう": "زَغَبُ الإِوَزّ (زغب الإوز)",
 "がもん": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "がや": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "がやがや": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "がようし": "ورق رسم (ورق معد خصيصاً للاستخدام في الرسم الهندسي أو الفني)",
 "がよく": "أَنَانِيَّة",
 "がら": "نُمُوذَج, نَمَط / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "がらあき": "غَيْرُ مُدَافَعٍ عَنْه, مَكْشُوف (غَيْرُ مُحَصَّنٍ أَوْ غَيْرُ قَابِلٍ لِلدِّفَاعِ عَنْه)",
 "がらがら": "فَارِغ / فَرَغَ / خَشِن الصَّوْت, مُحْتَكّ (قَاسٍ أَوْ مُزْعِج فِي الصَّوْت بِشَكْلٍ غَيْر مُسْتَحَبّ) / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / قَعْقَعَ / خُشْخِيشَة, شُخْلِيلَة",
 "がらがらへび": "أَفْعًى مُجَلْجِلَة",
 "がらがら蛇": "أَفْعًى مُجَلْجِلَة",
 "がらがわるい": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "がらが悪い": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "がらくた": "جُنْك",
 "がらくたいち": "سوق البضائع المستعملة, سوق خيري (بيع المواد المتبرع بها)",
 "がらくたディーエヌエー": "حمض نووي خردة (أجزاء من الحمض النووي لا ترمز للجينات)\nمثال: يتكون معظم الجينوم من حمض نووي خردة",
 "がらくた市": "سوق البضائع المستعملة, سوق خيري (بيع المواد المتبرع بها)",
 "がらくたＤＮＡ": "حمض نووي خردة (أجزاء من الحمض النووي لا ترمز للجينات)\nمثال: يتكون معظم الجينوم من حمض نووي خردة",
 "がらっと": "بِصَوْت عَالٍ / تَمَامًا",
 "がらっぱち": "فجاجة, قلة أدب (أسلوب وقح ومهين) / بدائية, خشونة (حالة برية أو غير مهذبة)",
 "がらのわるい": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "がらの悪い": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "がらみ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار.",
 "がらり": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / تَمَامًا",
 "がらん": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع / رَنَّان, مُدَوٍّ (ذو صوت معدنيّ رنّان وعالٍ) / فَارِغ / فَرَغَ",
 "がらんがらん": "رَنَّان, مُدَوٍّ (ذو صوت معدنيّ رنّان وعالٍ)",
 "がらんちょう": "بَجَع",
 "がらんどう": "فَارِغ / فَرَغَ",
 "がらーん": "رَنَّان, مُدَوٍّ (ذو صوت معدنيّ رنّان وعالٍ) / فَارِغ / فَرَغَ",
 "がら空き": "غَيْرُ مُدَافَعٍ عَنْه, مَكْشُوف (غَيْرُ مُحَصَّنٍ أَوْ غَيْرُ قَابِلٍ لِلدِّفَاعِ عَنْه)",
 "がり": "آلة سحب, ميميوغراف (ناسخة دوارة تستخدم استنسل يتم ضغط الحبر من خلاله) / عَزْر / توبيخ ;تقريع / صَيْد / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / مُطَارَدَةُ السَّاحِرَاتِ",
 "がりがり": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة / مُتَهَالِك, هَزِيل جِدًّا (شَدِيد النُّحُول خَاصَّةً بِسَبَب المَرَض أَوِ الجُوع أَوِ البَرْد) / بِقَهْر, بِهَوَس (بطريقة قهرية)\nمثال: كان ينظف حذاءه بشكل قهري بعد كل مشي / أَنَانِيّ",
 "がりばん": "آلة سحب, ميميوغراف (ناسخة دوارة تستخدم استنسل يتم ضغط الحبر من خلاله)",
 "がりべん": "طَحَنَ (طَحَنَ؛ طِحْنٌ)",
 "がりゃく": "أَنْقَاض, رُكام / زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
