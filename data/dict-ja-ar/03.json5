 "かはんにん": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "かば": "فَرَس نَهْر (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان / بَتُولَا",
 "かばいたて": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばいだて": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばい立て": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばう": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばち": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "かばつ": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "かばと": "فَجْأَةً",
 "かばね": "جُثَّة, جُثْمَان / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ…)",
 "かばのき": "بتولا, شجر القضبان (أي شجرة أو شجيرة من الفصيلة البتولية ذات لحاء رقيق مقشر)",
 "かばらい": "دفع زائد (فعل دفع أكثر من اللازم)",
 "かばん": "كِيس, چيس",
 "かばんご": "لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "かばんもち": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "かばん持ち": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "かばん語": "لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "かひ": "فتاة خادمة (فتاة تعمل كخادمة) / أدب, صواب (السلوك الصحيح أو المناسب) / جِدَارُ الثَّمَرَة, غِلافُ الثَّمَرَة (الجدران الناضجة والمتحورة لمبيض النبات) / هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال. / غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية…) / قِشْرَة",
 "かひつ": "تَحْسِين",
 "かひへん": "تيبالة (جزء غير متمايز من الغلاف الزهري لا يمكن تمييزه كسبلة أو بتلة (كما في الزنابق…)",
 "かひょう": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض)\nمثال: الالتصاق المتبادل للخلايا",
 "かひん": "تُحْفَة, رَائِعَة",
 "かび": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد…)\nمثال: المجد لأوكرانيا / بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية / قَالِب\nمثال: هم في نفس السن.",
 "かびくさい": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "かびどめ": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها)",
 "かびる": "قَالِب",
 "かびん": "زَهْرِيَّة / تَوَتُّر",
 "かびんしょう": "فرط حساسية (حساسية مفرطة)",
 "かびんせいちょうしょうこうぐん": "القولون التشنجي, متلازمة القولون العصبي (ألم بطني متكرر وإسهال (غالباً ما يتناوب مع فترات من الإمساك)؛ يرتبط غالباً…)",
 "かび臭い": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "かぴかぴ": "جَافّ المُعَامَلَة, خَشِن (فظ وعابس ومُنفِّر في التعامل)",
 "かふ": "مَنَحَ / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / لعبة الإطفائي (لعب يتظاهر فيه الأطفال بإخماد حريق) / أَرْمَلَة / سلالة أصيلة, نسب (سلالة حيوان أصيل)\nمثال: كل سلالته كانت محاربين / أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "かふうてい": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "かふか": "حمل زائد (عبء مفرط)",
 "かふきん": "إِعَانَة مَالِيَّة",
 "かふく": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "かふくはあざなえるなわのごとし": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "かふくぶ": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "かふそく": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "かふちょう": "بَطْرِيَرْك, بَطْرَك",
 "かふちょうせい": "نِظَام أَبَوِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "かふばん": "مَعْدُود",
 "かふん": "حُبُوبُ اللِّقَاح, حُبُوبُ الطَّلْع",
 "かふんかん": "أنبوب اللقاح ((علم النبات) نمو أنبوبي رفيع من حبة اللقاح عند ترسيبها على ميسم الزهرة؛ يخترق…)",
 "かふんかんかく": "أنبوب اللقاح ((علم النبات) نمو أنبوبي رفيع من حبة اللقاح عند ترسيبها على ميسم الزهرة؛ يخترق…)",
 "かふんしょう": "حمى القش (التهاب أنف موسمي ناتج عن رد فعل تحسسي لحبوب اللقاح)",
 "かぶ": "أساس (أدنى دعامة لهيكل ما)\nمثال: بُني على أساس من الصخر الصلب / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل. / جُذْمُور, كُنَّاشَة / أصول, جذور (حالة الانتماء إلى مكان أو مجموعة معينة بحكم النسب الاجتماعي أو العرقي أو الثقافي)\nمثال: جذوره في تكساس تعود إلى زمن طويل / سُلَالَة / لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / تِسْعَة, تسعة",
 "かぶおんきょく": "تَرْفِيه, تَسْلِيَة",
 "かぶおんぎょく": "تَرْفِيه, تَسْلِيَة",
 "かぶかしすう": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "かぶかしすうさきもの": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "かぶかしすうさきものとりひき": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "かぶかしすうれんどうがたじょうじょうとうししんたく": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "かぶかしすうれんどうがたとうししんたく": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "かぶかしゅうえきりつ": "مُضَاعِف الرِّبْحِيَّة, نِسْبَة السِّعْر إِلَى الأَرْبَاح ((سوق الأسهم) سعر السهم مقسوماً على أرباحه)",
 "かぶかのはんぱつ": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "かぶがいしめ": "زَاوِيَة, رُكْن",
 "かぶき": "كَابُوكِي / عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة)",
 "かぶく": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال.",
 "かぶけん": "سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "かぶこうぞう": "أساس (أدنى دعامة لهيكل ما)\nمثال: بُني على أساس من الصخر الصلب",
 "かぶさる": "غِطَاء",
 "かぶしき": "نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "かぶしきがいしゃ": "فرقة ريبيرتوار, فرقة مسرحية دائمة (فرقة مسرحية تؤدي مسرحيات من مخزون جاهز)",
 "かぶしきこうかいかいつけ": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "かぶしきこうかいかいつけせいど": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "かぶしきこうかんりつ": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "かぶしきしじょう": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "かぶしきじょうとえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "かぶしきそうば": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "かぶしきとりひきじょ": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "かぶしきなかがいにん": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "かぶしきはいとう": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "かぶしきはいとうきん": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "かぶしきぶんかつ": "تجزئة الأسهم (زيادة في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)\nمثال: أعلنوا عن تجزئة اثنين مقابل واحد للأسهم العادية",
 "かぶしきへいごう": "تجزئة عكسية للأسهم (انخفاض في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)",
 "かぶしきオプション": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت)",
 "かぶす": "غِطَاء",
 "かぶせぶた": "سهل الارتداء (قطعة ملابس (رداء أو حذاء) يمكن ارتداؤها أو خلعها بسهولة)",
 "かぶせもの": "تَاج, إِكْلِيل",
 "かぶせる": "غِطَاء / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "かぶせ物": "تَاج, إِكْلِيل",
 "かぶせ蓋": "سهل الارتداء (قطعة ملابس (رداء أو حذاء) يمكن ارتداؤها أو خلعها بسهولة)",
 "かぶそく": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "かぶそしき": "أساس (أدنى دعامة لهيكل ما)\nمثال: بُني على أساس من الصخر الصلب",
 "かぶた": "جُذْمُور, كُنَّاشَة",
 "かぶつ": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له) / حُمُولَة, شِحْنَة",
 "かぶと": "خُوذَة, بَيْضَة",
 "かぶとうお": "كَبير الرَّأْس (ذو رَأْس كَبير الحَجْم)",
 "かぶとえび": "روبيان الشرغوف (نوع من القشريات غلصميات الأرجل)",
 "かぶとがに": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة…)",
 "かぶとずきん": "خُوذِيُّ الشَّكْلِ (لَهُ شَكْلٌ مُحَدَّبٌ كَالخُوذَةِ)",
 "かぶとむし": "خنفساء وحيد القرن (أي من خنافس كبيرة استوائية بشكل رئيسي متنوعة لها قرون على الرأس؛ آفة على جوز…)",
 "かぶとをぬぐ": "تَنَازَلَ",
 "かぶとを脱ぐ": "تَنَازَلَ",
 "かぶな": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "かぶぬし": "مُسَاهِم, مُسَاهِمَة",
 "かぶぬししほん": "رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما)",
 "かぶぬししほんりえきりつ": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك)",
 "かぶもと": "قَاعِدَة",
 "かぶや": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "かぶら": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / لَفْتِيّ الشَّكْل (على شكل لَفْتة (شَلْجَم))",
 "かぶらな": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "かぶり": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن) / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / خوذة, غطاء رأس (ملابس للرأس) / رَئِيس, رَئِيسَة",
 "かぶりつき": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "かぶりもの": "عَمْرَة, غِطَاء الرَّأْس / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "かぶり付き": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "かぶる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / دُبّ / تراكب, طية (لسان يقع فوق جزء آخر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "かぶれ": "طَفْح, طَفْح جِلْدِيّ / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "かぶろ": "صبية, فتاة (فتاة أو شابة غير متزوجة) / صَلَع",
 "かぶん": "قابل للتقسيم, قابل للقسمة (قادر على أو عرضة للتقسيم أو الفصل)\nمثال: الأرقام الزوجية تقبل القسمة على اثنين / مُفْرِط, زَائِد / اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "かぶんすう": "كَسْر غَيْر حَقِيقِيّ, كَسْر مُعْتَلّ (كسر يكون بسطه أكبر من مقامه)",
 "かぶんせい": "قَابِلِيَّةُ الْقِسْمَةِ",
 "かぶ菜": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "かへい": "زَهْرِيَّة / نُقُود, مَال\nمثال: أريد بعض المال. / سُوَيْق, سُوَيْقَة / سَاق نَبَات\nمثال: أخشى أن أصل متأخرا.",
 "かへいがく": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "かへいせいど": "نظام نقدي, وسيط تبادل (أي شيء مقبول عموماً كمعيار للقيمة ومقياس للثروة في بلد أو منطقة معينة)",
 "かへいせき": "نيموليت (أوالي أحفوري كبير من العصر الثالث)",
 "かへん": "مُتَغَيِّر / بَتَلَة, تُوَيْجَة",
 "かへんせい": "تَغَيُّرِيَّة, تَفَاوُت (صفة الخضوع للتغير)",
 "かへんていこうき": "ريوستات, مقاومة متغيرة (مقاومة لتنظيم التيار)",
 "かべ": "حَائِط, جِدَار / حَاجِز",
 "かべいた": "دريوال, لوح جداري (لوح مسطح عريض يستخدم لتغطية الجدران أو القواطع؛ مصنوع من الجص أو لب الخشب أو…)",
 "かべかけ": "ستارة حائطية, معلقة (زينة تُعلق (مثل نسيج مزخرف) على الحائط أو فوق النافذة)\nمثال: كانت جدران القلعة الباردة مغطاة بالمعلقات",
 "かべがみ": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "かべごしすいりょう": "تخمين مدروس, تقدير تخميني (تقدير يجمع بين التفكير والتخمين)",
 "かべしたじ": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "かべつち": "مِلَاط, جِبْس",
 "かべにみみあり": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "かべにみみありしょうじにめあり": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "かべぬり": "تطيين, قصارة (وضع الجص)",
 "かべのはな": "خَيْرِيّ, قَصِيصَة",
 "かべやく": "فِنْطَاس, صِهْرِيج",
 "かべん": "بَتَلَة, تُوَيْجَة",
 "かほ": "سنبلة / حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة.",
 "かほう": "إضَافَة\nمثال: جمع خيل هو خيول. / إرث عائلي, تحفة متوارثة (شيء كان موجوداً في العائلة لأجيال) / حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس. / إفراط في الثناء (ثناء مفرط أو غير مستحق)\nمثال: تؤمن معلمة البيانو بتشجيع طلابها لكنها تتجنب أي إفراط في الثناء قد يجعلهم يشعرون بالرضا عن النفس",
 "かほうさん": "حمض البيربوريك (شكل من أشكال حمض البوريك)",
 "かほうてき": "إِضَافِيّ, تَرَاكُمِيّ (يتميز أو ينتج عن طريق الإضافة)\nمثال: عملية إضافية",
 "かほうに": "تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "かほご": "مُفْرِط فِي الحِمَايَة (يحمي بشكل مبالغ فيه)",
 "かぼう": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "かぼうちょうしき": "قَابِل لِلنَّفْخ (مُصَمَّم ليُملأ بالهواء أو الغاز)",
 "かぼく": "خادم رجل (خادم من الرجال) / شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض) / أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار…)",
 "かぼそい": "رَفِيع, رَقِيق / دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف)\nمثال: مقطع كمان رقيق",
 "かぼちゃ": "قَرْع, يَقْطِين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت…)\nمثال: توقف ذلك القرع.",
 "かま": "غَلَّايَة / مَوْقِد, مِدْفَأَة / عُلْجُوم, ضِفْدَع طِين / مِنْجَل / سؤال استدراجي (سؤال مصاغ بطريقة توحي بالإجابة المطلوبة؛ قد يطرح المحامي أسئلة استدراجية في…) / جلبة, صخب (التأثير السمعي الذي يتميز بضوضاء عالية ومستمرة)",
 "かまあしむし": "أوليات الذنب (أي من الحشرات البدائية الدقيقة عديمة الأجنحة والعيون التي لها رأس مخروطي الشكل…)",
 "かまいて": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "かまいません": "عَفْوًا",
 "かまいりちゃ": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "かまいれ": "جني, حصاد (جمع المحصول الناضج)",
 "かまう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / اِهْتَمَّ, اِعْتَنَى / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "かまえ": "هَيْكَل / وَضْعِيَّة / تأهب, حماس (استعداد فوري)\nمثال: استعداد لمواصلة المناقشات",
 "かまえる": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…) / تَظَاهَرَ, اِخْتَلَقَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر…)\nمثال: تظاهر بأنه طبيب. / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "かまかぜ": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "かまがた": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまがたせっけっきゅうひんけつしょう": "خلية منجلية (خلية دم حمراء غير طبيعية لها شكل هلال وتحتوي على شكل غير طبيعي من الهيموجلوبين)",
 "かまきり": "فَرَس اَلنَّبِيّ (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "かまくび": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまくら": "منتصف يناير (الجزء الأوسط من شهر يناير)",
 "かまじょう": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまじょうせっけっきゅう": "خلية منجلية (خلية دم حمراء غير طبيعية لها شكل هلال وتحتوي على شكل غير طبيعي من الهيموجلوبين)",
 "かまじょうせっけっきゅうしょう": "خلية منجلية (خلية دم حمراء غير طبيعية لها شكل هلال وتحتوي على شكل غير طبيعي من الهيموجلوبين)",
 "かまじょうせっけっきゅうひんけつ": "خلية منجلية (خلية دم حمراء غير طبيعية لها شكل هلال وتحتوي على شكل غير طبيعي من الهيموجلوبين)",
 "かまじょうせっけっきゅうびょう": "خلية منجلية (خلية دم حمراء غير طبيعية لها شكل هلال وتحتوي على شكل غير طبيعي من الهيموجلوبين)",
 "かます": "باراكودا, عقام / اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "かますさわら": "واهو (سمكة طعام وصيد كبيرة سريعة الحركة ومفترسة؛ توجد في جميع أنحاء العالم)",
 "かませいぬ": "تاجر جملة (شخص يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من المستهلكين…)",
 "かませる": "اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "かませ犬": "تاجر جملة (شخص يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من المستهلكين…)",
 "かまたき": "عَطَشْجِيّ",
 "かまち": "إِطَار النَافِذَة",
 "かまちょ": "مُتَشَبِّث, مُتَعَلِّق (مُفْرِطٌ فِي التَّعَلُّقِ العَاطِفِيِّ)",
 "かまつか": "سجاد, كوليوس",
 "かまど": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "かまひげ": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまびすしい": "صَارِخ, صاخِب",
 "かまぶろ": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد)",
 "かまへん": "عَفْوًا",
 "かまぼこへいしゃ": "كوخ كونسيت, كوخ نيسن (كوخ جاهز من الحديد المموج له مقطع عرضي نصف دائري)",
 "かまぼこ兵舎": "كوخ كونسيت, كوخ نيسن (كوخ جاهز من الحديد المموج له مقطع عرضي نصف دائري)",
 "かまもと": "فَخَّار, خَزَف\nمثال: هذا البلد مدعوم بالصناعة. / خَزَّاف",
 "かまわない": "عَفْوًا",
 "かまをほる": "لوطي (شخص يمارس اللواط)",
 "かまを掘る": "لوطي (شخص يمارس اللواط)",
 "かま元": "فَخَّار, خَزَف\nمثال: هذا البلد مدعوم بالصناعة. / خَزَّاف",
 "かみ": "بَهَار, تَابِل / إضَافَة\nمثال: جمع خيل هو خيول. / وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / قِمَّة / قَدِيماً / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق / قَيْصَر, إِمْبْرَاطُور / رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)\nمثال: البرق يسبق الرعد / شَعْرَة\nمثال: شعر ماريا طويل. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "かみあう": "شَبَكَة",
 "かみあそび": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "かみあぶら": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "かみあわせ": "انسداد, سد (فعل السد أو الغلق)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "かみあわせる": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي / أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ",
 "かみい": "مُزَيِّن, كْوَافِير",
 "かみいれ": "مِحْفَظَة, حَافِظَة",
 "かみおくり": "رُقْيَة / جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "かみかけて": "مطلقا, على الإطلاق",
 "かみかしら": "رَئِيس, رَئِيسَة",
 "かみかぜ": "اِنْتِحَارِيّ, كَامِيكَازِي",
 "かみかたち": "تَصْفِيفَة, تَسْرِيحَة",
 "かみがかり": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "かみがしら": "رَئِيس, رَئِيسَة",
 "かみがた": "رَوْسَم / تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "かみがみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "かみがみのたそがれ": "راغناروك, شفق الآلهة (أسطورة حول الدمار النهائي للآلهة في معركة مع قوى الشر)",
 "かみき": "شوط أول (الأول من شوطين للعب)",
 "かみきず": "عَضَّ, قَضَمَ",
 "かみきり": "سكين ورق, فتاحة رسائل (سكين غير حاد يستخدم لفتح الأظرف التي تُرسل فيها الرسائل أو لشق صفحات الكتب غير…) / خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً) / مخلوق أسطوري, وحش أسطوري (وحش مشهور في الفولكلور والأسطورة)",
 "かみきりむし": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "かみきりナイフ": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "かみきれ": "وَرَقَة",
 "かみくずかご": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "かみくずひろい": "جامع القمامة, نبّاش (شخص غير ماهر يجمع الخرق من القمامة العامة كوسيلة للعيش)",
 "かみくだく": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ…)",
 "かみげ": "شَعْرَة\nمثال: شعر ماريا طويل.",
 "かみこなす": "هَضَمَ",
 "かみこま": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "かみころし": "قَتْل إِلٰه (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "かみころす": "خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "かみごいちにん": "قَيْصَر, إِمْبْرَاطُور",
 "かみごま": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "かみごろし": "قَتْل إِلٰه (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "かみさま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ…)\nمثال: لدي الآس الكوبا. / قَيْصَر, إِمْبْرَاطُور / زَوْجَة, اِمْرَأَة",
 "かみさん": "زَوْجَة, اِمْرَأَة / مالكة العقار (مالك عقار أنثى) / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "かみざら": "طبق ورقي (طبق مصنوع من الورق المقوى يستخدم لمرة واحدة)",
 "かみしだく": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ…)",
 "かみしで": "شجرة النير, نير (أي من الأشجار أو الشجيرات المتعددة من جنس النير)",
 "かみしめる": "عَضَّ, قَضَمَ / هَضَمَ",
 "かみしも": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس",
 "かみしょうようさん": "اَلطِّبّ اَلصِّينِيّ",
 "かみすき": "صناعة الورق (حرفة صنع الورق)",
 "かみすり": "شَفْرَة حِلَاقَة / بَالِغ الوُضُوح (مُحَدَّد المَعَالِم بِوُضُوح شَدِيد)",
 "かみそりど": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة)",
 "かみっぺら": "وَرَقَة",
 "かみつ": "احتقان, اكتظاظ مفرط (الاكتظاظ المفرط)\nمثال: احتقان مروري / مُحْتَقِن (مُمْتَلِئ بِإِفْرَاط كَمَا بِالدَّم) / رَحِيق",
 "かみつきがめ": "سلحفاة نهاشة (سلحفاة مياه عذبة كبيرة عدوانية ذات فكوك قوية)",
 "かみつく": "عَضَّ, قَضَمَ",
 "かみつづき": "دَبَّاسَة",
 "かみつぶて": "كرة ملعوبة (رمية غير قانونية يتم فيها وضع مادة غريبة (لعاب أو فازلين) على الكرة من قبل…)",
 "かみつよ": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "かみづかさ": "كَاهِن, قِسِّيس",
 "かみて": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "かみでっぽう": "مسدس الفلين, مسدس لعبة (لعبة تتكون من مسدس لعبة يصدر صوت فرقعة)",
 "かみとあがめる": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ…)",
 "かみどこ": "حَلَّاق",
 "かみどめ": "مشبك شعر (دبوس لتثبيت شعر النساء في مكانه)",
 "かみなづき": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "かみなべ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "かみなり": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً…)\nمثال: البرق يسبق الرعد / غَضَب",
 "かみなりがなる": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)\nمثال: البرق يسبق الرعد",
 "かみなりぐも": "سَحَاب رَاعِد, سَحَابَة رَاعِدَة (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "かみなりさま": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)\nمثال: البرق يسبق الرعد",
 "かみなりにうたれた": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "かみなりよけ": "مَانِعَة صَوَاعِق",
 "かみなりりゅう": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر…)",
 "かみにめされる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "かみにんぎょう": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "かみのあい": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة)",
 "かみのおうこく": "ملكوت الله (المجال الروحي الذي يخضع لسيادة الله)",
 "かみのおぼしめし": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "かみのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "かみのけ": "شَعْرَة\nمثال: شعر ماريا طويل.",
 "かみのこ": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير. / مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)\nمثال: زيري صهيوني مسيحي. / أُعْجُوبَة",
 "かみのことば": "كَلَام اللّٰهِ / كلمة الله (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "かみのたみ": "شعب الله المختار (أي شعب يعتقد أن الله اختاره)",
 "かみのつかい": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "かみのて": "سَيِّد\nمثال: يبدو زيري أحسن.",
 "かみのみこ": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "かみのみこと": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "かみはんき": "شوط أول (الأول من شوطين للعب)",
 "かみばさみ": "مِشْبَك وَرَق",
 "かみばな": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر) / وَرَقَة",
 "かみひこうき": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة.",
 "かみびょうし": "وَرَقِيّ الغِلَاف ((للكتب) ذو غلاف مرن)",
 "かみふぶき": "نِثَار",
 "かみぶくろ": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "かみぺら": "صحيفة, ورقة (ورق يستخدم للكتابة أو الطباعة)",
 "かみまき": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض…)\nمثال: دخن زيري سيجارة.",
 "かみまきたばこ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض…)\nمثال: دخن زيري سيجارة.",
 "かみまきタバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض…)\nمثال: دخن زيري سيجارة.",
