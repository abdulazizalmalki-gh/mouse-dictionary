 "こうぐし": "عَطَّار, عَطَّارَة / جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "こうぐち": "شَبَقِيّ, جِنْسِيّ",
 "こうぐばこ": "صَنْدُوق اَلْعِدَّة (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "こうぐん": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "こうけい": "خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "こうけいき": "اِزْدِهَار, رَخَاء",
 "こうけいしつ": "تغيير",
 "こうけいしゃ": "خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "こうけいぶ": "قَفًا",
 "こうけいり": "جَلَّاد",
 "こうけっとう": "فرط سكر الدم",
 "こうけっとうしょう": "فرط سكر الدم",
 "こうけつ": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "こうけん": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش. / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "こうけんしゃ": "رَافِد",
 "こうけんにん": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "こうげ": "تَذَبذُب, تَقَلُّب / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "こうげい": "حِرْفَة, صَنْعَة",
 "こうげいか": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "こうげいひん": "حِرْفَة يَدَوِيَّة",
 "こうげき": "حَمْلَة / هَاجَمَ\nمثال: 敵は夜に私達を攻撃した。 — هاجمنا العدو ليلاً. / نَقْد, اِنْتِقَاد",
 "こうげきしゃ": "مُعْتَدٍ, بَاغٍ",
 "こうげきせい": "عُدْوَان / عِدْوَان",
 "こうげきてき": "هُجُوم, حَمْلَة",
 "こうげきりつ": "مَسَامِّيَّة",
 "こうげん": "إِعْلَان, بَيَان",
 "こうげんさい": "تَجَلٍّ",
 "こうげんしつ": "كولاجين",
 "こうこ": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "こうこう": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "こうこうえいせい": "صِحَّة الفَمّ (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "こうこうがい": "حَنَك صَلْب ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "こうこうがいおん": "غَارِيّ",
 "こうこうさ": "اِنْزِيَاغ / زَيْغ (زَيَّغَ (زيغه): عوجه وأقام زيغه وأصلح عوجه)",
 "こうこうぜん": "فِي وَضَح اَلنَّهَار (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / جهارًا نهارًا\nمثال: جون في عمر أخي.",
 "こうこがく": "عِلْمُ الآثَار (أَدْرَكَ حقيقة الشيء) / آثَار (البقايا؛ الأطلال) / عِلْمُ الْآثَارِ الْقَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こうこがくしゃ": "عَالِم آثَار (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "こうこがくてき": "أَثَرِيّ",
 "こうこく": "مَرْكِيزِيَّة",
 "こうこくとう": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "こうこくばん": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات",
 "こうこくびら": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَشْرَة, نَشْرَة إعْلَانِيَّة\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "こうこげんのていり": "مُبَرْهَنَةْ فِيثَاغُورَس",
 "こうこつ": "عَظْم / عضم / عَظْمَة / عضمة / ثَبَات",
 "こうこつじょうたい": "ترانس",
 "こうこのうれい": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "こうこん": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "こうごう": "مُؤْتَمَر, اِجْتِمَاع / كُونْجْرِس, كُونْغْرِس",
 "こうごうぐう": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "こうごうしい": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "こうごうせい": "تَمْثِيل ضَوْئِيّ / تَرْكِيب ضَوْئِيّ (اسم للشيء الذي يُرَّكبُ بالعادة)",
 "こうごけいさん": "حِسَاب جَارٍ, حِسَابُ الْمُعَامَلَات (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "こうごさよう": "تَآثُر, تَفَاعُل / مُخَالَطَة, تَفَاعُل",
 "こうごひょうげん": "عَامِّيَّة, دَارِجَة",
 "こうさ": "صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة ولا حياة فيها؛ الصَّحْرَاءُ : الأرضُ المُسْتَوِيةُ في لِينٍ وغِلَظٍ دُونَ القُفِّ) / صحرة / صحرا / بَرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / فَرَّ / جَزاء\nمثال: عاد إلى الصحراء.",
 "こうさい": "سَرِيَّة / شَرِكَة / تأريخ (تَسْجِيْل التَارِيْخ)",
 "こうさいあいて": "النصف الآخر",
 "こうさいかん": "دِبْلُومَاسِيّ, دِبْلُومَاسِيَّة",
 "こうさいぎらい": "اِنْطِوَائِيّ",
 "こうさいしゃかい": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "こうさいほう": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "こうさいりくり": "باهِر",
 "こうさく": "خَلِيط",
 "こうさくいん": "جَاسُوس / تَجَسَّسَ / صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "こうさくきかい": "آلَة تَشْغِيل (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "こうさくしつ": "مَشْغَل, وَرْشَة",
 "こうさくせん": "سِكَّة حَدِيد مُعَلَّقَة, سِكَّة حَدِيد وَتَرِيَّة",
 "こうさくひん": "حِرْفَة يَدَوِيَّة",
 "こうさくぶつ": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "こうさつ": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "こうさてん": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة)",
 "こうさろ": "مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "こうさん": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "こうさんぶつ": "مَعْدِن (فِي : مركب صُلْب، يتكون طبيعياً من خلال عمليات جيولوجية؛ فِي : ما يستخرج من باطن الأَرْض كالحَدِيد والرَّصَاص والذَّهَب والمُجَوْهَرَات)\nمثال: هذا السلم مصنوع من المعدن",
 "こうざ": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "こうざい": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "こうざいりょう": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "こうざつ": "تَهْجِين / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "こうざつしゅ": "هَجِين",
 "こうざん": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "こうし": "شَبَك, شَبَكَة / شَبَكَة كَهْرُبَاء / شَبَك",
 "こうしがたい": "غَالِب",
 "こうしき": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته. / صِيغَة",
 "こうしきてき": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "こうしきテニス": "تَنِس, تِنِس",
 "こうしけっしょう": "فَرْط شَحْمِيَّات الدَّم",
 "こうしけつしょう": "فَرْط شَحْمِيَّات الدَّم",
 "こうしざい": "نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم",
 "こうしじょう": "مُرَبَّعَاتٍ / مُرِيب, مَشْكُوك فِيهِ",
 "こうしじん": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "こうした": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "こうしつ": "أرملة",
 "こうして": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "こうしにく": "لَحْم عِجْل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "こうしゃ": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "こうしゃく": "مَرْكِيز",
 "こうしゃくふじん": "مَرْكِيزَة",
 "こうしゃぐち": "خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "こうしゅ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "こうしゅう": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
