 "がいでん": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "がいとう": "شَارِع, زَنَقَة / مِعْطَف",
 "がいとうしゃ": "طَرَف / حَفْلَة, اِحْتِفَال",
 "がいとうなし": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "がいとうまく": "وِشَاح",
 "がいとうアンケート": "جانبي, في الشارع (على جوانب الشوارع)\nمثال: ممنوع وقوف السيارات في الشارع في ساعة الذروة",
 "がいとうインタビュー": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "がいどく": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "がいどくそ": "ذيفان خارجي (ذيفان تفرزه الكائنات الدقيقة في الوسط المحيط)",
 "がいにゅう": "بيريسبرم, محيط السويداء (النسيج المغذي خارج الكيس المحتوي على الجنين في بعض البذور)",
 "がいねん": "مَفْهُوم, تَصَوُّر",
 "がいねんか": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / بلورة المفهوم, تصور مفاهيمي (مفهوم مفصّل أو مطوّر)",
 "がいねんず": "رسم تخطيطي, مخطط هيكلي (مخطط لنظام كهربائي أو ميكانيكي)",
 "がいねんてき": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "がいねんろん": "مفاهيمية (المذهب القائل بأن تطبيق مصطلح عام على أشياء مختلفة يشير إلى وجود كيان عقلي يتوسط التطبيق)",
 "がいのない": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "がいはいよう": "أديم ظاهر, الأرومة الظاهرة (الطبقة المنتشة الخارجية التي تتطور لتشكل الجلد والأنسجة العصبية)",
 "がいはく": "حفلة مبيت, مبيت (مناسبة قضاء ليلة بعيداً عن المنزل أو استضافة ضيف للمبيت (خاصة كحفلة للأطفال)) / عمق, عمق فكري (العمق الفكري، المعرفة النافذة، البصيرة الثاقبة، إلخ) / عُمْق, غور (صفة كون الشيء عميقاً مادياً) / حدة ذهن, عمق (القدرة الفكرية على التعمق في الأفكار) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: عمق شعوري",
 "がいはつてき": "خارجي, عرضي (لا يشكل جزءاً أساسياً من شيء أو ينشأ أو يأتي من الخارج)\nمثال: أدلة خارجية",
 "がいはんぼし": "إبهام أفحج, وكعة (تضخم مؤلم في الجراب الزلالي للمفصل الأول لإبهام القدم)",
 "がいひ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / مِعْطَف",
 "がいひけい": "الجهاز اللحافي (الجلد وملحقاته)",
 "がいひょう": "تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "がいふくしゃきん": "منحرفة خارجية (عضلة بطنية مرتبة بشكل قطري على جانبي الجذع)",
 "がいぶ": "خَارِج, بره / خَارِج, بره\nمثال: 田舎の人々は外部の人に対して昔から疑い深い。 — يشتبه الريفيون عادةً بالغرباء.",
