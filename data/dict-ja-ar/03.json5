 "からと言うもの": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى.",
 "からと言う物": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى.",
 "からと言って": "بِالرَغْم مِن",
 "からな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "からなでしこ": "قرنفل صيني, قرنفل قوس قزح (قرنفل صيني بزهور وردية ليلكية مسننة بعمق مع عين أرجوانية؛ يزرع عادة كنبات سنوي)",
 "からにする": "فَارِغ / فَرَغَ",
 "からには": "بِمَا أَنّ, أَمَا وَأَنّ",
 "からねこ": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "からねんぶつ": "خِطَابَة جَوْفَاء, كَلَام مُنَمَّق (كلام صاخب ومشوش وفارغ)\nمثال: مجرد خطاب منمق",
 "からは": "بِمَا أَنّ, أَمَا وَأَنّ",
 "からふかし": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)",
 "からふとししゃも": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "からふとふくろう": "بومة رمادية عظمى (بومة كبيرة ذات وجه مسطح من شمال أمريكا الشمالية وغرب أوراسيا)",
 "からふとらいちょう": "طيهوج أحمر (طيهوج بني محمر يعيش في المستنقعات المرتفعة في بريطانيا العظمى)",
 "からふとシシャモ": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "からぶかし": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)",
 "からぶり": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "からぶろ": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "からへた": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "からぼし": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "からます": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "からませる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "からまつ": "شجرة اللاريكس, لاريكس (أي من الصنوبريات العديدة من جنس لاريكس، جميعها ذات أوراق إبرية متساقطة) / خشب الأرزية, خشب اللارك (خشب شجرة الأرزية)",
 "からまり": "شبكة عنكبوتية, فخ (فخ معقد يوقع ضحيته أو يوقعها في شرك)",
 "からまわり": "سباق (رياضة المشاركة في مسابقات السرعة)",
 "からみ": "ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية) / خابث, خباث",
 "からみあう": "اِنْضَفَرَ, تَدَاخَلَ",
 "からみつく": "تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / إزعاج, جلبة (اضطراب غاضب)\nمثال: لم يرد إثارة جلبة",
 "からむ": "خيط, دوبارة (حبل خفيف الوزن) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / إزعاج, جلبة (اضطراب غاضب)\nمثال: لم يرد إثارة جلبة",
 "からむき": "قَصْف",
 "からむし": "بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً / قُنَّبُ سِيَام",
 "からめ": "حَارّ نَوْعاً مَا (ساخن بعض الشيء) / صَارِم",
 "からめあう": "اِنْضَفَرَ, تَدَاخَلَ",
 "からめて": "باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى) / نقطة ضعف (صفة غير كافية أو ناقصة)",
 "からめで": "باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى) / نقطة ضعف (صفة غير كافية أو ناقصة)",
 "からめとる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَخّ, مِصْيَدَة / مُقْتَطَف / خلاصة",
 "からめる": "تَنْسِيق, إِحْدَاثِيّ (ترتيب وتنظيم الأشياء أو العناصر بشكل متناسق ومتناسب؛ العمل على توحيد الجهود بين جهات متعددة لتحقيق هدف مشترك) / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "からめ取る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَخّ, مِصْيَدَة / مُقْتَطَف / خلاصة",
 "からもじ": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "からもの": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "からもも": "مِشْمِش",
 "からもん": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "からり": "بِإِتْقَان, تَمَامًا / بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح / بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك / تَمَامًا",
 "からん": "بَلَاء, بُؤْس",
 "からんからん": "قَعْقَعَ",
 "からんころん": "حَبَطَقْطَقْ",
 "からオケ": "كَارَيُوكِي",
 "からコン": "فَارِغ / فَرَغَ",
 "から下手": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "から元気": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "から揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "から騒ぎ": "عَجِيج, ضَجِيج",
 "かり": "مُؤَقَّت\nمثال: 仮のブリッジをいれます。 — ستحتاج جسرًا مؤقتًا. / مُخْتَلَق / اِفْتِرَاضِيّ / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر) / اقتراض (الحصول على أموال من مقرض)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً / صَيْد / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / مُطَارَدَةُ السَّاحِرَاتِ / حَشَفَة",
 "かりあげ": "جني, حصاد (جمع المحصول الناضج)",
 "かりあげる": "أَجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / اِسْتَخْدَمَ, شَغَّلَ (عَمِلَ بالشيء، اِسْتَعْمَلَه؛ اِتَّخَذَ الشخصَ خَادِمًا عنده)\nمثال: ركبت سيارة أجرة.",
 "かりあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かりいおのまつり": "الْعَرْش",
 "かりいぬ": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "かりいれ": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر) / اقتراض (الحصول على أموال من مقرض)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً",
 "かりいれきん": "قَرْض, إِعَارَة",
 "かりいれびと": "حَصَّاد",
 "かりいれる": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "かりうけにん": "مُسْتَعِير, مُسْتَعِيرَة",
 "かりうける": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "かりうど": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "かりかえ": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "かりかえる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "かりかし": "قَرْض, إِعَارَة",
 "かりかた": "مَدِين",
 "かりかぶ": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "かりかぶけん": "شهادة مؤقتة, عملة بديلة (شهادة يعترف بقيمتها الدافع والمدفوع له؛ ليست عملة ولكن قد تكون قابلة للتحويل إلى عملة)",
 "かりかり": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ) / بِتَجَهُّم, بِحِدَّة (بطريقة سيئة المزاج)\nمثال: نظرت إلى زوجها بحدة / خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان / دلو رفع (دلو حديدي يستخدم للرفع في الآبار أو المناجم) / طعام حبيبي (حبوب مطحونة خشنة على شكل كريات (كما في طعام الحيوانات الأليفة))",
 "かりかんじょう": "حساب معلق (حساب يستخدم مؤقتاً لحمل الإيصالات والمدفوعات المشكوك فيها أو التناقضات بانتظار تحليلها وتصنيفها الدائم)",
 "かりがね": "مُرْتَفِع الدَّرَجَة",
 "かりがねぼね": "عظم الكتف, لوح الكتف (أي من عظمين مثلثين مسطحين يقعان على كل جانب من جانبي الكتف في البشر)",
 "かりきにゅう": "حساب معلق (حساب يستخدم مؤقتاً لحمل الإيصالات والمدفوعات المشكوك فيها أو التناقضات بانتظار تحليلها وتصنيفها الدائم)",
 "かりきり": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "かりきる": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "かりくび": "إِكْلِيل حَشَفَة الْقَضِيب / عنق الإوزة (شيء ذو شكل منحني رفيع (مثل عنق الإوزة)) / حَشَفَة",
 "かりくら": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "かりこ": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد)",
 "かりこし": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "かりこしきん": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "かりこみ": "حَلَاقَة / تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "かりこむ": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "かりごしらえ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "かりごや": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة / كوخ الصيد (منزل صغير (ريفي) يستخدم كمأوى مؤقت)",
 "かりしゃくほうしゃ": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة)",
 "かりしゅっしょ": "إفراج مشروط ((قانون) إفراج مشروط عن السجن يخول الشخص قضاء ما تبقى من العقوبة خارج السجن طالما تم الالتزام بشروط الإفراج) / كلمة سر, كلمة مرور (كلمة أو عبارة سرية لا يعرفها إلا مجموعة محددة) / كلمة شرف, وعد\nمثال: نسي كلمة السر (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)",
 "かりしゅっしょしゃ": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة)",
 "かりしゅつごく": "إفراج مشروط ((قانون) إفراج مشروط عن السجن يخول الشخص قضاء ما تبقى من العقوبة خارج السجن طالما تم الالتزام بشروط الإفراج) / كلمة سر, كلمة مرور (كلمة أو عبارة سرية لا يعرفها إلا مجموعة محددة) / كلمة شرف, وعد\nمثال: نسي كلمة السر (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)",
 "かりしょぶん": "أمر قضائي مؤقت, أمر وقتي (أمر قضائي يصدر أثناء المحاكمة للحفاظ على الوضع الراهن أو الحفاظ على موضوع الدعوى حتى انتهاء المحاكمة)",
 "かりそめ": "مُؤَقَّت / تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار) / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "かりそめにする": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "かりそめにも": "أبداً / بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "かりそろえる": "مَحْصُول / حَوْصَلة",
 "かりたて": "مَحْشُوش حَدِيثًا, مَقْصُوص تَوًّا (تم حشه أو قصه مؤخرًا)",
 "かりたてる": "طَرَدَ / قَادَ, سَاقَ / سَاقَ",
 "かりだす": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "かりちん": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "かりっと": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح",
 "かりて": "جزازة العشب (أداة حديقة لجز العشب في المروج) / مُسْتَعِير, مُسْتَعِيرَة / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "かりとじほん": "كُتَيِّب, كُرَّاسَة (كِتَاب صَغِير؛ دَلِيل) / كُرَّاسَة, كُتَيِّب",
 "かりとり": "جني, حصاد (جمع المحصول الناضج)",
 "かりとる": "جَزَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "かりな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "かりに": "اِفْتَرَضَ / مُؤَقَّتًا",
 "かりにも": "أبداً, بتاتاً (بأدنى درجة أو بأي حال من الأحوال)\nمثال: هل أنت مهتم على الإطلاق؟ لا، على الإطلاق / بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "かりにん": "مُسْتَعِير, مُسْتَعِيرَة",
 "かりぬい": "سقي اللحم (ترطيب الشواء أثناء طهيه) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً)",
 "かりぬし": "مُسْتَعِير, مُسْتَعِيرَة / مُسْتَأْجِر",
 "かりね": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة / شُعَيْرَات اللِّحْيَة / قَشّ",
 "かりのおや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "かりのさしとめ": "أمر قضائي مؤقت, أمر وقتي (أمر قضائي يصدر أثناء المحاكمة للحفاظ على الوضع الراهن أو الحفاظ على موضوع الدعوى حتى انتهاء المحاكمة)",
 "かりのたより": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "かりのつかい": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "かりのな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "かりのふみ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "かりはらい": "عُشْبَة ضَارَّة / بانْجو, حَشيش",
 "かりば": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "かりぱく": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりぱち": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりひきすう": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "かりびと": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "かりふく": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش)) / جُمَّة, شَعْر كَثّ (شعر يشبه مواد التسقيف بالقش) / قش (سيقان نباتات تستخدم كمادة تسقيف)",
 "かりまくら": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "かりゅう": "دُوَّامَة / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / الطَّبَقَاتُ الدُّنْيَا / بَرْكَنَ, فَلْكَنَ / حبيبة (حبة صغيرة جداً) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة) / جَدْوَل / تَيَّار / تَدَفّقَ / تنين, تنين أوروبي (مخلوق من الأساطير التيوتونية؛ يصور عادة وهو ينفث النار وله جسم زاحف وأحيانًا أجنحة) / لب (الجزء الداخلي الرخو للسن) / مجلة إثارة, مجلة رخيصة (مجلة غير مكلفة مطبوعة على ورق رديء الجودة) / عَصِيدَة, لُبّ (أي كتلة ناعمة أو رطبة) / لب, لحم الفاكهة (جزء طري رطب من الفاكهة)\nمثال: سحقه حتى أصبح لباً / تُوت, حَبَّة",
 "かりゅうかい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "かりゅうがい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "かりゅうきゅう": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "かりゅうきゅうげんしょうしょう": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "かりゅうざい": "حبيبة (حبة صغيرة جداً)",
 "かりゅうしゃかい": "الطَّبَقَاتُ الدُّنْيَا",
 "かりゅうじょう": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية)) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "かりゅうせい": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية)) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "かりゅうそう": "طبقة حبيبية (طبقة البشرة الواقعة تحت الطبقة المتقرنة مباشرة؛ تحتوي على خلايا (ذات حبيبات مرئية) تموت وتتحرك إلى السطح)",
 "かりゅうど": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "かりゅうはっけっきゅう": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "かりゅうびょう": "دَاء مَنْقُول جِنْسِيًّا",
 "かりゅうほう": "فلكنة (عملية معالجة المطاط أو المواد الشبيهة بالمطاط بالكبريت عند حرارة عالية لتحسين المرونة والقوة أو لتصلبها)",
 "かりゆし": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "かりょう": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة) / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل) / جُرْعَة زَائِدَة / تنين, تنين أوروبي (مخلوق من الأساطير التيوتونية؛ يصور عادة وهو ينفث النار وله جسم زاحف وأحيانًا أجنحة) / عِلَاج كِيمِيَائِيّ",
 "かりょく": "قوة نيرانية ((عسكرياً) القدرة النسبية على إطلاق النار على هدف ما)",
 "かりる": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا. / أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "かりわく": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب) / سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "かりん": "بادوك بورما, خشب الورد البورمي (شجرة من الهند وبورما تنتج خشباً يشبه الماهوجني) / سفرجل مزهر, سفرجل ياباني (شجيرة زينة آسيوية ذات فروع شائكة وأزهار وردية أو حمراء) / سَفَرْجَل",
 "かりんせん": "باخرة ببدالات (سفينة بخارية تدار بواسطة عجلات بدالات)",
 "かりパク": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりパチ": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりパラメータ": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "かりマスト": "صاري مؤقت (صاري مؤقت لاستبدال صاري مكسور)",
 "かり集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かる": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا. / أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة. / اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かるい": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح / طَفِيف\nمثال: 私は軽く肩を触れられるのを感じた。 — لقد شعرت بلمسة خفيفة على كتفي. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かるいきもち": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "かるいし": "حجر الخفاف, خفاف (زجاج خفيف يتكون على سطح بعض الحمم البركانية؛ يستخدم كمادة كاشطة)",
 "かるがる": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "かるがるしい": "طَفْح, طَفْح جِلْدِيّ",
 "かるくち": "ثَرْثَار",
 "かるさ": "خِفَّة",
 "かるはずみ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "かるめ": "خِفَّة",
 "かるやか": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "かるやき": "رُقَاقَة",
 "かるら": "غارودا (كائن خارق يشبه النسر يخدم كمطية لفيشنو)",
 "かるわざ": "بِهْلَوَانِيَّات",
 "かるわざし": "بَهْلَوَان",
 "かれ": "هُوَ / خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かれい": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح / جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / شَيْخُوخَة, هَرَم / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة) / بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / فلاوندر أيمن العين (فلاوندر تقع كلتا عينيه على الجانب الأيمن من الرأس) / أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "かれいおうはんへんせい": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "かれいおうはんへんせいしょう": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "かれいせい": "مُرْتَبِطٌ بِالْعُمْرِ (يتغير (زيادة أو نقصاناً) مع تقدم عمر الفرد)",
 "かれいせいはくないしょう": "مُرْتَبِطٌ بِالْعُمْرِ (يتغير (زيادة أو نقصاناً) مع تقدم عمر الفرد)",
 "かれいなる": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "かれがれ": "مَبْحُوح / ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل) / مُحَمَّص (مُحَمَّصٌ أَوْ مَشْوِيٌّ قَلِيلًا) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس) / مُتَنَافِر, مُنْفَصِل (أصبح غير محبوب بسبب الجفاء والبعد)",
 "かれがわ": "مُسْتَنْزَف الْمَاء, نَاضِب (نضب ماؤه واستُنزف) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "かれくさ": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "かれこれ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / بِالْقُرْب, قُرْبَ / مَوْجُود (الذي له وجود)\nمثال: رقصنا حول النار.",
 "かれし": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / هُوَ",
 "かれじしん": "نَفْسَهُ",
 "かれつ": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "かれはいろ": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "かれはざい": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "かれぴ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かれぴっぴ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かれら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "かれる": "صَعَقَ / نَاضِج, رَاشِد / نَفِدَ",
 "かれん": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "かれピ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かれピッピ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かれ草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "かろ": "فرن (حجرة مغلقة يتم فيها إنتاج الحرارة لتدفئة المباني، أو تدمير النفايات، أو صهر الخامات وتنقيتها، وما إلى ذلك) / رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "かろい": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح / طَفِيف\nمثال: 私は軽く肩を触れられるのを感じた。 — لقد شعرت بلمسة خفيفة على كتفي. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かろう": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "かろうじて": "بِٱلْكَاد",
 "かろがろ": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "かろがろしい": "طَفْح, طَفْح جِلْدِيّ",
 "かろしめる": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "かろはずみ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "かろやか": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "かろんじる": "تَرَفَّعَ",
 "かろんずる": "اِحْتَقَرَ, أَهَانَ",
 "かわ": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة / نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ) / نهر أبيض (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر. / هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / قشرة (الغطاء الخارجي الطبيعي للطعام (يزال عادة قبل الأكل))\nمثال: 私は林檎の皮をむくことができる。 — أستطيع تقشير تفاحة. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد. / جَانِب / صَفْحَة / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية. / غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان) / خليط كبريتيدي خام, مات (خليط من الكبريتيدات يتشكل عند صهر خامات المعادن الكبريتيدية) / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "かわあいさ": "بلقشة شائعة (البلقشة الشائعة في أوروبا وأمريكا الشمالية)",
 "かわい": "فَاتِن, قَشِيب",
 "かわいい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / بَرِيء / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل)",
 "かわいいこちゃん": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد) / حبيب, معشوق (شخص محبوب من قبل شخص آخر)",
 "かわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود) / عَذَاب / عَذَّبَ",
 "かわいがる": "لَاطَفَ, رَبَتَ / عَذَاب / عَذَّبَ",
 "かわいげ": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "かわいこちゃん": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد) / حبيب, معشوق (شخص محبوب من قبل شخص آخر)",
 "かわいそう": "فَقِير / مِسْكِين / فُقَرَاء",
 "かわいた": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / عارضة طولية, وتر (عارضة خشبية أفقية طويلة لربط القوائم) / عارضة طولية (دعامة تتكون من عضو طولي لتقوية جسم الطائرة أو الهيكل) / ناظم الخيوط (عامل ينظم الأشياء في خيوط) / لاعب في التشكيلة (عضو في تشكيلة الفريق)\nمثال: ناظم الخرز",
 "かわいらしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "かわいるか": "دلفين نهري (أي من عدة دلافين طويلة الخطم تعيش عادة في المياه العذبة في أمريكا الجنوبية وجنوب آسيا)",
 "かわいーい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / بَرِيء / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل)",
 "かわい子ちゃん": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد) / حبيب, معشوق (شخص محبوب من قبل شخص آخر)",
 "かわうお": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "かわうそ": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "かわえー": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / بَرِيء / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل)",
 "かわかす": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "かわかぶり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "かわかます": "بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على نطاق واسع في الأجزاء الباردة من نصف الكرة الشمالي) / أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة) / رمح (سلاح من العصور الوسطى يتكون من رأس رمح مثبت على عمود طويل؛ حل محله الحربة) / سنان (نقطة حادة (كما في نهاية الرمح))",
 "かわかみ": "ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار) / ضد التيار, عكس التيار (في الاتجاه المعاكس لتيار النهر)",
 "かわかむり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "かわき": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش. / تَوْق, تَشَوُّق / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "かわきゆき": "ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق، ويكون أقل كثافة من المتوسط وغير لزج)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "かわきり": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "かわぎし": "ضفة النهر",
 "かわぎぬ": "معطف فرو (معطف مصنوع من الفرو)",
 "かわく": "اِشْتَهَى",
 "かわぐち": "مَصَبّ, فُغْرَة",
 "かわげた": "عارضة طولية, وتر (عارضة خشبية أفقية طويلة لربط القوائم) / عارضة طولية (دعامة تتكون من عضو طولي لتقوية جسم الطائرة أو الهيكل) / ناظم الخيوط (عامل ينظم الأشياء في خيوط) / لاعب في التشكيلة (عضو في تشكيلة الفريق)\nمثال: ناظم الخرز",
 "かわげら": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات الخياشيم لاحمة وتعيش تحت الحجارة)",
 "かわこうば": "مدبغة (مكان عمل يتم فيه دباغة الجلود)",
 "かわごろも": "معطف فرو (معطف مصنوع من الفرو)",
 "かわさき": "كَاوَاسَاكِي",
 "かわさきびょう": "داء كاواساكي (مرض حاد يصيب الأطفال الصغار يتميز بطفح جلدي وتضخم الغدد الليمفاوية والحمى)",
 "かわざいく": "مصنوعات جلدية (عمل مصنوع من الجلد)",
 "かわざかな": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "かわしあう": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "かわしき": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "かわしも": "مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "かわす": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / تَقَاطَعَ / تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "かわず": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "かわずとび": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "かわせ": "سَرِيع",
 "かわせい": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "かわせそうば": "سِعْر صَرْف (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "かわせてがた": "حوالة مالية, سفتجة (وثيقة تأمر بدفع المال؛ يسحبها شخص أو بنك على آخر)",
 "かわせへいか": "قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "かわせみ": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "かわせレート": "سِعْر صَرْف (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "かわぞい": "ضفة النهر",
 "かわぞこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "かわた": "إِتَا",
 "かわたけ": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى) / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "かわたれどき": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "かわたれ時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "かわたろう": "كَبَا",
 "かわちい": "فَاتِن, قَشِيب",
 "かわった": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "かわっぱ": "كَبَا",
 "かわっぷち": "ضفة النهر",
 "かわっぺり": "ضفة النهر",
 "かわどこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "かわながれ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "かわなめし": "دِبَاغَة",
 "かわのみなもと": "مصدر غني, منبع (مصدر وفير) / مصدر رئيسي, منبع (مصدر المياه الذي ينشأ منه الجدول أو النهر)\nمثال: كانت نبعاً من المعلومات",
 "かわはぎ": "سلخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "かわばた": "ضفة النهر",
 "かわひも": "زنوبَة, شِبْشِب",
 "かわぶち": "ضفة النهر",
 "かわべ": "ضفة النهر",
 "かわべり": "ضفة النهر",
 "かわほり": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا / مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي / انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان) / انتهازي, وصولي (شخص يفضل المصلحة الشخصية والوسائل النفعية على المبادئ)",
 "かわます": "تروتة الجدول (تروتة المياه العذبة في أمريكا الشمالية؛ أُدخلت إلى أوروبا) / تراوت الجدول (سمكة طعام لذيذة من المياه العذبة)",
 "かわむき": "تَقْشِير / سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات) / مقلّم (أخصائي تقليم أظافر يقلم الأظافر)",
 "かわむきき": "مِقْشَرَة / كلب (مصطلحات غير رسمية للكلاب) / منادٍ (شخص يقف أمام عرض (كما في الكرنفال) ويلقي خطاب بيع صاخب وملون للزبائن المحتملين)",
 "かわめんたい": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه)",
 "かわや": "خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ) / مرحاض خارجي (مبنى خارجي صغير به مقعد يحتوي على ثقوب يمكن للمستخدم التبرز من خلالها) / حمام, دورة مياه (غرفة أو مبنى مجهز بمرحاض واحد أو أكثر)",
 "かわゆい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / بَرِيء / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل)",
 "かわよ": "فَاتِن, قَشِيب",
 "かわよい": "فَاتِن, قَشِيب",
 "かわら": "قِرْمِيدَة, قِرْمِيد / قَرْمَدَ",
 "かわらか": "مُنْعِش / دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "かわらけ": "خزف مسامي, فخار (أواني خزفية مصنوعة من طين مسامي محروق بحرارة منخفضة)",
 "かわらげ": "حصان أشهب مصفر (حصان ذو لون أسمر مصفر فاتح مع عرف وذيل داكنين) / بوكسكين, جلد الغزال (جلد سويدي ناعم مصفر مصنوع أصلاً من جلد الغزال ولكن الآن عادة من جلد الغنم)",
 "かわらこじき": "مُمَثِّل, مُمَثِّلَة",
 "かわらじょう": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "かわらない": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "かわらぬ": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "かわらばと": "حَمَام طُورَانِيّ, حَمَام أَزْرَق (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "かわらふじのき": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "かわらまつば": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "かわらや": "مبلط (عامل يضع البلاط)",
 "かわら状": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "かわり": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / شُذُوذ, عَدَم سَوِيَّة (غرابة ملحوظة نتيجة لكون الشيء غير طبيعي) / قصور عقلي (تأخر كافٍ للخروج عن النطاق الطبيعي للذكاء) / تشوه, شذوذ (حالة جسدية غير طبيعية ناتجة عن جينات معيبة أو قصور في النمو) / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة) / ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "かわりがわり": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "かわりだね": "اِخْتِلَاف / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "かわりに": "بَدَلًا مِن",
 "かわりばえ": "تَحْسِين",
 "かわりばん": "متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "かわりばんこ": "متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "かわりばんこに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "かわりめ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "かわりもの": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "かわりもん": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "かわりやく": "احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة",
 "かわりやすい": "قَابِل لِلتَّغْيِير, مُتَغَيِّر (بحيث يكون التغيير ممكناً؛ لديه ميل ملحوظ للتغيير) / قَابِل لِلتَّحَوُّل, مُتَغَيِّر (قادر على أو يميل إلى التغيير في الشكل أو الجودة أو الطبيعة) / قُزَحِيّ, مُتَلَأْلِئ (ذو ألوان متغيّرة ومتموّجة حسب زاوية الرؤية) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: سلوك متقلب",
 "かわりゆく": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "かわりよう": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "かわる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / نَجَحَ / مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "かわるがわる": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "かわろう": "كَبَا",
 "かわをはぐ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "かわをむく": "قَشَّرَ / قِشْرَة, قِشْر",
 "かわん": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "かわヨ": "فَاتِن, قَشِيب",
 "かわーい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / بَرِيء / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل)",
 "かん": "اِدْرََاك حَسِّيّ / قَدَرَ, اِسْتَطَاعَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / اِسْتَطَاعَ, مُمْكِن (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ) / صَفِيحَة, علبة\nمثال: خذ قدر ما تريد. / أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب) / سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / مَشْهَد, مَسْرَحِيَّة / قَصَبَة / شِين / تَاج, إِكْلِيل / أَفْضَل / أُنْبُوبَة / آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ. / بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء. / عز الشتاء, منتصف الشتاء (وسط فصل الشتاء) / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / طُومَار / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / تَجْرِيبِيّ, مُؤَقَّت (بِمُوجِبِ شُرُوطٍ لَمْ تُسْتَكْمَلْ أَوْ لَمْ يُتَّفَقْ عَلَيْهَا نِهَائِيًّا) / مُبْدَئِيّ, مُتَرَدِّد (غير مستقرّ في الرأي؛ مُتذبذب) / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل) / كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / سلالة هان, هان (سلالة إمبراطورية حكمت الصين (معظم الوقت من 206 قبل الميلاد إلى 220 ميلادي) ووسعت حدودها وطورت بيروقراطيتها؛ تُذكر كواحدة من العصور العظيمة للحضارة…) / أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / النِهاية / إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / فُرْصَة / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء) / سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور. / بَسَاطَة / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس. / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / رنين (صوت رنين) / كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / حُفْرَة / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / قصبة (ساق نباتات الفصيلة النجيلية) / خَان (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة) / وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / النزعَة إلى الخير / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / حَاجِز / عَقَبَة, حَاجِز / دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها) / جُمْهُورِيَة كُورِيَا / أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "かんあく": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "かんい": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / جَرِيء, جَسُور / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "かんいか": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد)",
 "かんいがたけいたいでんわ": "دائرة الصحة العامة الأمريكية (وكالة تعمل كمكتب للجراح العام؛ تشمل وكالات مهمتها تحسين الصحة العامة)",
 "かんいしょくどう": "مَقْصَف, كَافِتِيرِيَا (خوان يستخدف في غرف الطعام لحفظ أدوات المائدة، وقد يوضع عليه الطعام استعدادا لنقله إلى المائدة؛ مكان اللهو في لعب وأكل وشرب)",
 "かんいじゅうたく": "جَاهِزُ التَّرْكِيبِ, مُسَبَّقُ الصُّنْعِ (مُصنَّع بأحجام معيارية ليُشحَن ويُركَّب في مكان آخر) / مبنى جاهز (هيكل مسبق الصنع)",
 "かんいすい": "كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "かんいっぱつ": "شعرة, قيد شعرة (مسافة أو مساحة صغيرة جداً)\nمثال: نجوا بشق الأنفس (بقدر شعرة)",
 "かんいっぱつのところ": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "かんいっぱつをいれず": "فَوْرًا, حَالًا",
 "かんいてき": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんいばくだん": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんいばくはつぶつ": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんいり": "مُعَلَّب (مَحْفُوظ فِي عُلْبَة أَوْ بُرْطُمَان مُغْلَق) / مُسَجَّل لِلبَثّ, مُعَلَّب (تَمَّ تَسْجيلُه مُسْبَقًا لِلبَثّ الإِذاعِيّ أَوْ التِّلْفِزْيُونِيّ)",
 "かんいん": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى) / إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "かんいんざい": "إساءة جنسية, اعتداء جنسي (جريمة تشريعية تنص على أنه من الجريمة التسبب عمداً في انخراط شخص آخر في فعل جنسي غير مرغوب فيه بالقوة أو التهديد)\nمثال: استبدلت معظم الولايات تعريف القانون العام للاغتصاب بقوانين تحدد الاعتداء الجنسي",
 "かんいブログ": "تدوين مصغر (مدونة يتم فيها تحديد طول التدوينات الفردية (مثل تويتر))",
 "かんいベッド": "سرير سفري, سرير قابل للطي (سرير صغير يمكن طيه للتخزين أو النقل) / سرير أطفال, مهد (سرير أطفال ذو جوانب عالية مصنوعة من شرائح خشبية أو قضبان) / غطاء الإصبع, كشتبان واقٍ (غلاف يلبس لحماية الإصبع)",
 "かんう": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "かんえつ": "تَفَقُّد",
 "かんえつしき": "اِسْتِعْرَاض, مَوْكِب",
 "かんえん": "اِلْتِهَاب الْكَبِد",
 "かんおう": "استجابة, تجاوب (صفة الاستجابة أو التفاعل بسرعة؛ بالنسبة للأشخاص، تتضمن التجاوب العاطفي مع الناس والأحداث) / استجابة, تفاعلية (الاستجابة للتحفيز) / إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير / تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية) / مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "かんおけ": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "かんおん": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "かんおんせいなんちょう": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "かんおんなんちょう": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "かんか": "فَوَاكِه مُجَفَّفَة / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل / بُوتَقة / مِحْنَة, اِخْتِبَار قَاسٍ / قِدْر صَهْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد. / سِلَاح, أَسْلِحَة / صِرَاع / تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب)) / جَنَازَة (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / كَارِثَة, مُصِيبَة",
 "かんかい": "اِنْطِبَاع, أَثَر / تَقْلِيد / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / عَفْو, صَفْح",
 "かんかいん": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب) / إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "かんかく": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / مُشَاهِد, رَاءٍ / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض.",
 "かんかくかびんしょう": "فرط حساسية (حساسية مفرطة) / فرط الحساسية (حساسية مرضية)",
 "かんかくき": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "かんかくきかん": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز)",
 "かんかくしゃだん": "حرمان حسي (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من جميع المدخلات الحسية)",
 "かんかくしんけい": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "かんかくじょうひ": "ظهارة عصبية (ظهارة مرتبطة بأعضاء الحس الخاصة وتحتوي على نهايات عصبية حسية)",
 "かんかくてき": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "かんかくどんま": "نقص الحس (ضعف الحساسية اللمسية)",
 "かんかくもう": "شارب, شعرة حسية (شعرة صلبة طويلة تنمو من خطم أو حاجب معظم الثدييات مثل القطط)",
 "かんかくろん": "تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة) / حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / إثارة, تهويل (الاستخدام الصحفي لموضوع يروق للأذواق المبتذلة) / إِثَارَة, صِحَافَة الْإِثَارَة (موضوع مصمم لإثارة وإرضاء الأذواق المبتذلة)",
 "かんかくニューロン": "عصبون حسي (عصبون ينقل النبضات نحو الدماغ أو الحبل الشوكي)",
 "かんかつ": "قَضَاء / اِخْتِصَاص / كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم! / مَاكِر",
 "かんかん": "وَزْن / عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم) تستجيب للتحفيز) / ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة) / بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً) / بِحِدَّة, بِعُنْف (بطريقة عنيفة عاطفياً)\nمثال: صمت كسره نباح الكلاب بشراسة / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة / بِهُدُوء / قناة كبدية (القناة التي تصرف الصفراء من الكبد) / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "かんかんがくがく": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "かんかんぼう": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح) / راكب القارب, ملاح (شخص يقود أو يركب قارباً)",
 "かんかんぼうず": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "かんかん坊主": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "かんかん帽": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح) / راكب القارب, ملاح (شخص يقود أو يركب قارباً)",
 "かんが": "خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل / رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "かんがい": "سَقْي",
 "かんがいい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "かんがいぶかい": "مُتَحَرِّك / مُؤَثِّر",
 "かんがえ": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس / فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / قَصْد, إِرَادَة / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "かんがえかた": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "かんがえこむ": "تَفَكَّرَ, فَكَّرَ",
 "かんがえごと": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "かんがえだす": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "かんがえちがい": "سُوء فَهْم",
 "かんがえちゅう": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "かんがえつく": "جَاءَ بِـ, أَتَى بِـ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "かんがえなおす": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "かんがえなし": "دون تفكير (بطريقة خالية من التفكير) / خَامِل الذِّهْن (بطيء التفكير وخامل عقليّاً) / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / بِلَا تَفْكِير, غَيْرُ مُتَأَمِّل (لَا يُظْهِرُ أَوْ يَتَّسِمُ بِالتَّفْكِيرِ المُتَأَنِّي)\nمثال: حدق دون تفكير في الصورة",
 "かんがえにふける": "ربة الإلهام, ملهمة (مصدر إلهام الفنان) / ربة الإلهام, موز (في الأساطير اليونانية القديمة أي من بنات زيوس وميموزين التسع؛ حاميات الفنون والعلوم)\nمثال: كانت يوتيربي ملهمته",
 "かんがえぶかい": "عَمِيق اَلتَّفْكِير",
 "かんがえぶかげ": "عَمِيق اَلتَّفْكِير",
 "かんがえもつかない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "かんがえもの": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "かんがえられない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "かんがえる": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا / تَعَمَّدَ, نَوَى / تَنَبَّأَ",
 "かんがえをめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "かんがく": "علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "かんがくしゃ": "عالم صينيات (دارس للتاريخ واللغة والثقافة الصينية)",
 "かんがっき": "آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "かんがみる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "かんがよい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "かんがん": "خَجْلَان, خَجُول / خَصِيّ, مَخْصِيّ / سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "かんき": "استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / استهجان, سخط (حالة فقدان الحظوة أو الرضا)\nمثال: هو في حالة سخط من الملك (مغضوب عليه) / إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / استيقاظ, صحوة (الاستيقاظ من النوم) / استثارة, تيقظ (حالة من النشاط الفسيولوجي المتزايد)\nمثال: الهدف من الفن هو إثارة العواطف / تَهْوِيَة / فُرْجَة / موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية) / علامة الناشر, كولوفون (شعار الناشر المطبوع في كتاب (عادة في صفحة العنوان)) / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "かんきこう": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "かんきそうち": "مِرْوَحَة",
 "かんきつ": "جور, حيف (فعل غير عادل) / شر, فجور (سلوك مرفوض أخلاقياً) / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة) / حمضيات, شجرة حمضيات",
 "かんきつけい": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة) / حمضيات, شجرة حمضيات",
 "かんきつるい": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة) / حمضيات, شجرة حمضيات",
 "かんきゃく": "مُشَاهِد, رَاءٍ / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "かんきゃくすう": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "かんきゃくせき": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "かんきゃくどういんりょく": "قُوَّة الجَذْب (القدرة على جذب الناس (العملاء أو المؤيدين))",
 "かんきゅう": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة / طَوَارِئ, حَالَةْ اَلطَّوَارِئ / إصدار عسكري, مخصصات حكومية (إمدادات (كالطعام أو الملابس أو الذخيرة) تصدرها الحكومة) / أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "かんきゅうおんどけい": "مقياس حرارة جاف البصلة (مقياس حرارة عادي ببصلة جافة؛ يستخدم لقياس درجة حرارة الهواء)",
 "かんきゅうきごう": "تمبو, سرعة الإيقاع ((موسيقى) السرعة التي ستُعزف بها المقطوعة) / إِيقَاع, وُتَيْرَة (معدل حدث متكرر)",
 "かんきゅうしゃ": "عربة الحارس (العربة في القطار التي يشغلها الحارس)",
 "かんきょ": "أُنْبُوبَة",
 "かんきょう": "فَائِدَة / بِيئَة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "かんきょうかがく": "إيكولوجيا, علم البيئة (فرع علم الأحياء المعني بالعلاقات بين الكائنات الحية وبيئتها)",
 "かんきょうかがくけんきゅうしょ": "أي (بمعنى؛ أي (لتقديم شرح))",
 "かんきょうかつどうか": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきょうきょうせい": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうしんわがた": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうしんわてき": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうじょうけん": "حالة بيئية (حالة البيئة)",
 "かんきょうせってい": "تَهايُؤ",
 "かんきょうにやさしい": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうほごしゅぎ": "حماية البيئة (نشاط حماية البيئة من التلوث أو الدمار) / بيئية (المذهب الفلسفي القائل بأن البيئة أهم من الوراثة في تحديد النمو الفكري)",
 "かんきょうほごしゅぎしゃ": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきょうほごろんしゃ": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきょうもんだいせんもんか": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきり": "فَتَّاحَة, مِفَكّ (التي تكثر الفَتْح)",
 "かんきん": "تَحْقِيق / حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية / عَصَوِيَّة",
 "かんきんさくもつ": "محصول تجاري, محصول نقدي (محصول قابل للبيع بسهولة يُزرع ويُجمع من أجل السوق (مثل الخضروات أو القطن أو التبغ))",
 "かんきんしつ": "سجن السفينة, محبس (مؤسسة عقابية (خاصة على متن سفينة)) / بريغ (سفينة شراعية بصاريتين ومجهزة بأشرعة مربعة على كلا الصاريتين)",
 "かんぎょ": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح) / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "かんぎょう": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "かんく": "قَضَاء / اِخْتِصَاص / مَشَقَّة, شِدَّة",
 "かんくう": "لُومِن",
 "かんぐり": "اِتِّهَام, شَكّ / اِتِّهَام",
 "かんぐる": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "かんけい": "عَلَاقَة / مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف) / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ) / حَلَقَة, حَلْقَة",
 "かんけいかいぜん": "تَوْفِيق, مُصَالَحَة (إعادة تأسيس العلاقات الودية)",
 "かんけいかくい": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいかくいどの": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいがない": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية)",
 "かんけいさき": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى) / عُضْو مُنْتَسِب, مُنْتَسِب (زميل مرؤوس أو فرعي؛ شخص ينتسب لآخر أو لمنظمة)\nمثال: الجهات التابعة للشبكة",
 "かんけいし": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "かんけいしゃ": "طَاقَم, طَاقِم",
 "かんけいしゃかくい": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいすじ": "مُطَّلِع",
 "かんけいせい": "عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "かんけいせつ": "جملة موصولة (جملة يقدمها ضمير موصول)",
 "かんけいだいめいし": "اسم موصول, ضمير وصل (ضمير (مثل 'الذي' أو 'التي') يقدم جملة صلة تشير إلى سابق ما)",
 "かんけいだんたい": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى) / عُضْو مُنْتَسِب, مُنْتَسِب (زميل مرؤوس أو فرعي؛ شخص ينتسب لآخر أو لمنظمة)\nمثال: الجهات التابعة للشبكة",
 "かんけいとうじしゃどの": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいどうぶつ": "دودة حلقية (ديدان ذات أجسام أسطوانية مقسمة داخلياً وخارجياً) / حلقي, حلقياتي (يتعلق بـ أو ينتمي إلى أو من خصائص أي من ديدان شعبة الحلقيات)",
 "かんけいない": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية)",
 "かんけいデータベース": "قاعدة بيانات علائقية (قاعدة بيانات يتم فيها تحديد العلاقات بين عناصر المعلومات بشكل صريح كسمات يمكن الوصول إليها)\nمثال: في قاعدة البيانات العلائقية يتم تنظيم البيانات كعدد من الجداول مختلفة الأحجام",
 "かんけつ": "نَتِيجَة / وَجِيز, مُوجَز / تَقَطُّع (صفة كون الشيء متقطعاً؛ خاضعاً للانقطاع أو التوقف الدوري) / جور, حيف (فعل غير عادل) / شر, فجور (سلوك مرفوض أخلاقياً)",
 "かんけつせいばくはつせいしょうがい": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんけつせん": "سَخَّان (شبه إبْرِيق من معدن كالنحاس أو الصلب أو غيره يوضع على النار مباشرة ويستخدم لتسخين الماء. قد يقول البعض سَخَّانَة؛ آله تسخن الماء تعمل على الكهرباء أو الغاز أو غيره من الوقود. استخدام حديث)",
 "かんけつそう": "هَيْئَة التَّمَام (جهة الفعل التي تعبر عن حدث مكتمل)",
 "かんけつてき": "مُتَقَطِّع / مَوْسِمِيّ / جِرَاحِيّ",
 "かんけつばくはつしょう": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんけつぶん": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "かんけん": "تَحْقِيق / مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "かんげい": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "かんげき": "اِنْطِبَاع, أَثَر / تَقْلِيد / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "かんげきりつ": "مَسَامِّيَّة",
 "かんげざい": "مُلَيّن",
 "かんげやく": "مُلَيّن",
 "かんげん": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع) / إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / نَقْص / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "かんげんがくだん": "أُورْكِسْتْرَا",
 "かんげんがくほう": "توزيع أوركسترالي (فعل ترتيب قطعة موسيقية للأوركسترا وتعيين أجزاء للآلات الموسيقية المختلفة) / تنسيق, تنظيم دقيق (ترتيب للأحداث يحاول تحقيق أقصى قدر من التأثير) / أوركَستْرَة, توزيع للأوركسترا (توزيع لقطعة موسيقية للأداء بواسطة أوركسترا أو فرقة)\nمثال: التنسيق الماهر لحملته السياسية",
 "かんげんこうそ": "ريدوكتاز (إنزيم يحفز الاختزال الكيميائي الحيوي لبعض المواد المحددة)",
 "かんげんざい": "عامل مختزل, مختزل (مادة قادرة على إحداث اختزال لمادة أخرى بينما تتأكسد هي نفسها؛ تستخدم في التصوير الفوتوغرافي لتقليل كثافة السالب أو المطبوعة عن طريق أكسدة بعض الفضة…)",
 "かんげんしゅぎ": "اختزالية (تحليل الأشياء المعقدة إلى مكونات أبسط) / اختزالية (نظرية تفيد بأن الأنظمة المعقدة يمكن فهمها بالكامل من حيث مكوناتها)",
 "かんげんすれば": "وَبِعِبَارَة أُخْرَى",
 "かんげんぶんれつ": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده)) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "かんげんみつご": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "かんこ": "تَزْكِية / بُحَيْرَة مِلْحَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "かんこう": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / إِحْسَان / تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية / عَادَة / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / كالوميل, كلوريد الزئبقوز (مسحوق عديم اللون والطعم يستخدم طبياً كمسهل) / لُومِن",
 "かんこうきゃく": "سَائِح, سَائِحَة\nمثال: 地元の店は観光客相手に順調な商売をしている。 — المتاجر المحلية تقوم بمتاجرة جيدة مع السياح .",
 "かんこうけい": "مقياس الحساسية (أداة قياس لقياس حساسية الفيلم للضوء عبر مجموعة من التعريضات) / أكتينومتر, مقياس الإشعاع الكيميائي (أداة لقياس شدة الإشعاع الكهرومغناطيسي (عادة عن طريق التأثير الكيميائي الضوئي))",
 "かんこうしげん": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "かんこうせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "かんこうち": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)\nمثال: ナイアガラの滝は世界有数の観光地として名高い。 — ان شلالات نياغارا مشهورة كمنتجع سياحي رائد في العالم .",
 "かんこうはん": "عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي)) / عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "かんこうば": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "かんこうぶつ": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "かんこうへん": "تَشَمُّع, تَلَيُّف",
 "かんこうめいしょ": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "かんこうり": "مسؤولون حكوميون (أشخاص منتخبون أو معينون لإدارة حكومة)",
 "かんこうりょこう": "رِحْلَة / جَوْلَة",
 "かんこうれい": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "かんこうスポット": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "かんこく": "نَصِيحَة, مَشُورَة / كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / خَانِيَّة",
 "かんこくあん": "تَوْصِيَة",
 "かんこくがい": "كوريا تاون, كورياتاون (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "かんこくご": "كُورِيّ",
 "かんこくしゃ": "مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم",
 "かんこくのり": "كِيم",
 "かんこつ": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة) / وَجْنَة, عَظْم وَجْنِيّ",
 "かんこつきゅう": "تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "かんこつだったい": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "かんこどり": "وَقْوَاق, وَقْوَاقِيَّة",
 "かんご": "صِينِيّ / تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة. / كُورِيّ / ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "かんごう": "خَنْدَق / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "かんごがく": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "かんごがっこう": "كلية التمريض, مدرسة التمريض (مدرسة لتدريب الممرضات)",
 "かんごく": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "かんごし": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんごしちょう": "رئيسة الممرضات (الشخص المسؤول عن التمريض في مؤسسة طبية)",
 "かんごしゃ": "أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "かんごそつ": "ضابط طبي (ممارس طبي في القوات المسلحة) / فصة, نفل",
 "かんごにん": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんごふ": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんごふちょう": "رئيسة الممرضات (الشخص المسؤول عن التمريض في مؤسسة طبية)",
 "かんごへい": "ضابط طبي (ممارس طبي في القوات المسلحة) / فصة, نفل",
 "かんさ": "تَحْقِيق / تَفَقُّد / تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / تحسيس, توعية ((في علم النفس) عملية أن يصبح الشخص حساساً للغاية تجاه أحداث أو مواقف معينة (خاصة الأحداث أو المواقف العاطفية)) / تحسس (حالة الحساسية (كما في المستضدات))",
 "かんさい": "تَصْفِية / شَمَنْدَر اَلسُّكَّر",
 "かんさいぼう": "خَلِيَّة جِذْعِيَّة",
 "かんさいぼうがん": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "かんさかん": "مُفَتِّش, مُفَتِّشَة",
 "かんさく": "محصول بيني, محصول مؤقت (محصول ينمو بسرعة (مثل الخس) ويمكن زراعته بين محصولين عاديين يزرعان في مواسم متتالية أو بين صفين من المحاصيل في نفس الموسم)",
 "かんさつ": "تَفَقُّد / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة",
 "かんさつい": "طَبِيب شَرْعِيّ, طَبِيب عَدْلِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "かんさつかん": "مُفَتِّش, مُفَتِّشَة",
 "かんさつしゃ": "متفرج",
 "かんさつしん": "تسلخ جلدي, مذح (تسلخ بين سطحين جلديين متلامسين (كما في الإبط أو تحت الثديين أو بين الفخذين))",
 "かんさにん": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه)",
 "かんさやく": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه)",
 "かんさん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر) / مَهْجُور / خَامِد / عَاطِل عَن اَلْعَمَل / اِنْحِلَال",
 "かんさんけいすう": "عَامِل التَّحْوِيل (العامل الذي تضرب به كمية معبر عنها بوحدة معينة لتحويلها إلى وحدة أخرى)",
 "かんざい": "حراسة, وصاية (منصب الحارس أو الوصي) / خليط تبريد (خليط من المواد (عادة الملح والثلج) للحصول على درجة حرارة أقل من نقطة تجمد الماء) / علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "かんざいにん": "عُضْو مَجْلِس أُمَناء, وَصِيّ (أعضاء في مجلس حاكم أو مجلس أمناء) / أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "かんざくら": "زهرة الربيع الصينية (زهرة ربيع آسيوية مزروعة)",
 "かんざん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "かんし": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / رصد, متابعة (فعل مراقبة شيء ما (وأحياناً الاحتفاظ بسجل له))\nمثال: يلعب رصد اتصالات العدو دوراً مهماً في أوقات الحرب / جفت, ملقط جراحي (أداة استخراج تتكون من زوج من الكماشات تستخدم في العلاج الطبي (خاصة لتوليد الأطفال)) / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / إقناع بالعدول, ثني (الإقناع بعدم القيام بشيء أو عدم تصديقه؛ إقناع شخص بالعدول عن معتقد أو مسار عمل مقصود) / إِثْنَاء, نُصْح بِالْعُدُول (تواصل يثنيك عن فعل شيء) / بِنْصِر / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "かんしいん": "متفرج",
 "かんしか": "خاضع للإشراف, مُراقب (تحت المراقبة أو تحت توجيه مشرف أو ناظر)\nمثال: لعب تحت الإشراف",
 "かんしき": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب)) / أدلة جنائية, طب شرعي (اختبارات أو تقنيات علمية تستخدم في التحقيق في الجرائم) / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "かんしきか": "عَارِف, عَارِفَة / أدلة جنائية, طب شرعي (اختبارات أو تقنيات علمية تستخدم في التحقيق في الجرائم)",
 "かんしきょく": "مُرَاقِب, مُرَاقِبَة / شَاشَة الْعَرْض, شَاشَة / عَرِيف, عَرِيفَة / رَاقَّبَ",
 "かんししゃ": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "かんししょう": "مرصد, نقطة مراقبة (موقع مرتفع يتيح رؤية واسعة)",
 "かんしじん": "نَاطُور",
 "かんしせん": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "かんしたいせい": "نظام مراقبة (نظام تلفزيون الدائرة المغلقة يستخدم للمراقبة الدقيقة لشخص أو مجموعة)",
 "かんしっかん": "مرض كبدي (مرض يصيب الكبد)",
 "かんしつ": "سدى (النسيج الداعم لعضو ما (على عكس المتن أو النسيج الحشوي)) / سدى (الهيكل الكثيف عديم اللون للبلاستيدة الخضراء) / سدى فطري (كتلة من الأنسجة الفطرية التي تحتوي على هياكل حاملة للأبواغ مدمجة فيها أو عليها)",
 "かんしつせい": "بيني, خلالي (متعلق بالفرجات أو المسافات البينية)",
 "かんしつせいはいえん": "التهاب رئوي خلالي (مرض رئوي مزمن يصيب النسيج الخلالي للرئتين)",
 "かんしとう": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "かんしぶんべん": "ولادة بالملقط (ولادة يتم فيها إدخال الملقط عبر المهبل واستخدامه للإمساك برأس الجنين وسحبه)",
 "かんしゃ": "شُكْرًا\nمثال: ご協力に感謝します。 — أقدر تعاونك معنا. / قَصَب السُّكَّر / متفرج",
 "かんしゃく": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "かんしゃくだま": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "かんしゃくもち": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "かんしゃく持ち": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "かんしゃく玉": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "かんしゃさい": "عِيد اَلشُّكْر",
 "かんしゃしらず": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان) / ثَقِيل, غَيْر مُسْتَسَاغ (غير مقبول أو غير مستساغ)\nمثال: ورثة جاحدون",
 "かんしゅ": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني. / حارِس سِجْن, سَجَّان (شخص يحرس السجناء) / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس. / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "かんしゅう": "عَادَة, عُرْف / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / مُشَاهِد, رَاءٍ",
 "かんしゅうてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي) / عُرْفِيّ, مَأْلُوف (وَفْقًا لِلعُرْفِ أَوِ العَادَة)",
 "かんしゅうほう": "سابقة قضائية, قانون السوابق القضائية ((القانون المدني) قانون تم إنشاؤه من خلال اتباع قرارات قضائية سابقة) / قانون عام, قانون عرفي (نظام فقهي يعتمد على السوابق القضائية بدلاً من القوانين التشريعية)\nمثال: نشأ القانون العام في القوانين غير المكتوبة في إنجلترا وتم تطبيقه لاحقاً في الولايات المتحدة",
 "かんしゅしゃ": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "かんしゅちょう": "آمِر سِجْن",
 "かんしゅにん": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "かんしょ": "بَطَاطَا حُلْوَة / قَصَب السُّكَّر / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / مِرْحَاض, تواليت",
 "かんしょう": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع) / تَدَاخُل / عَاطِفَة / جزيرة مرجانية (جزيرة تتكون من شعاب مرجانية دائرية تحيط ببحيرة شاطئية) / إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / بطانة, حشوة (قطعة مصنوعة من مادة ناعمة أو مرنة تستخدم للملء أو إعطاء الشكل أو الحماية أو إضافة الراحة) / إِعْجَاب / تَقْدِير / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / تَفَكُّر / اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة) / فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / فاصل, فترة بينية (فترة أو حلقة فاصلة) / مَوْزَة / مَوْز (نبات فاكهة استوائية من الفصيلة الموزية؛ ثمر نبات الموز) / موزة / موز (نبات فاكهة استوائية من الفصيلة الموزية؛ ثمر نبات الموز)\nمثال: هن بحاجة للموز. / ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "かんしょうえき": "محلول منظم, محلول واق (محلول يحتوي على مادة منظمة (بفر))",
 "かんしょうか": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "かんしょうかい": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "かんしょうが": "زنجبيل, مسحوق الزنجبيل (جذر الزنجبيل المجفف والمطحون)",
 "かんしょうき": "مُمْتَصّ صَدَمَات",
 "かんしょうきおく": "ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "かんしょうけい": "مقياس التداخل (أي أداة قياس تستخدم أنماط التداخل لإجراء قياسات دقيقة للموجات)",
 "かんしょうこう": "ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "かんしょうこく": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "かんしょうざい": "بطانة, حشوة (قطعة مصنوعة من مادة ناعمة أو مرنة تستخدم للملء أو إعطاء الشكل أو الحماية أو إضافة الراحة)",
 "かんしょうしゃ": "مُتَذَوِّق, مُقَدِّر (شخص يدرك شيئاً ما تماماً ويفهمه)\nمثال: هو ليس مقدراً للمعضلة التي نحن فيها",
 "かんしょうしゅぎ": "نزعة عاطفية (ميل للعاطفية) / عاطفية مفرطة (التعبير المفرط عن المشاعر الرقيقة أو الحنين أو الحزن بأي شكل من الأشكال)",
 "かんしょうしゅぎしゃ": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "かんしょうじま": "هدب, هدب التداخل (أحد النطاقات المضيئة أو المظلمة الناتجة عن تداخل وحيود الضوء)",
 "かんしょうじゅつ": "قِراءَةُ الْكَفّ",
 "かんしょうせい": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "かんしょうそうち": "أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / مخمّد صدمات, مصدّ (جهاز يشبه الوسادة يقلل من الصدمة الناتجة عن الارتطام) / آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح) / ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "かんしょうちたい": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "かんしょうてき": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها) / مُلْتَحِم, مُتَرَابِط / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة) / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / مُتَأَمِّل (شخص مكرس لحياة التأمل)",
 "かんしょうりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "かんしょうりょういき": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "かんしょうりょくち": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "かんしょく": "عفن جاف (فطر يسبب العفن الجاف) / عفن جاف (تفتت وجفاف للأخشاب أو البصلات أو البطاطس أو الفاكهة بسبب فطر) / خدمة مدنية, موظفو الخدمة المدنية (موظفون حكوميون؛ يتم تعيينهم عادة على أساس امتحانات تنافسية) / تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "かんしょとう": "سكر القصب (سكر من قصب السكر يستخدم كعامل تحلية) / سكر القصب (سكروز يتم الحصول عليه من قصب السكر)",
 "かんしん": "إِعْجَاب\nمثال: 我々は彼女の勇気に感心する。 — نحب شجاعتها. / جَدِير بِالْإِعْجَاب / ذُهُول, دَهْشَة / تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى) / مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد) / بَائِس, مُزْرٍ (رديء الجودة أو الحالة جدًا)",
 "かんしんりょういき": "العَائِد عَلَى الِاسْتِثْمَار, العَائِد عَلَى رَأْس المَال المُسْتَثْمَر ((المالية) المبلغ، المعبر عنه كنسبة مئوية، الذي يتم كسبه على إجمالي رأس مال الشركة، ويحسب بقسمة إجمالي رأس المال على الأرباح قبل دفع الفوائد أو…)",
 "かんしプログラム": "برنامج مراقبة (برنامج يراقب وينظم ويتحكم أو يتحقق من عمليات نظام معالجة البيانات)",
 "かんじ": "سكرتير تنفيذي (سكرتير لديه واجبات ومسؤوليات إدارية) / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه) / مُشْرِف, مُشْرِفَة / ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "かんじき": "حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع عرضية ويحتوي على شبكة من السيور؛ يلبس واحد في كل قدم)",
 "かんじきうさぎ": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "かんじく": "طُومَار",
 "かんじちょう": "أمين سر (عضو في مجلس الوزراء البريطاني)",
 "かんじつげつ": "خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "かんじとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "かんじゃ": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة. / جَاسُوس / تَجَسَّسَ / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / متفرج / خَصِيّ, مَخْصِيّ",
 "かんじゃく": "صَامِت, هَادِئ",
 "かんじやすい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "かんじゅ": "مُتَقَبِّل / إحساس, إدراك (إدراك شيء ما عبر الحواس) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة)\nمثال: الكشف المبكر يمكن أن يؤدي غالباً إلى الشفاء / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "かんじゅうしき": "لحمة متوسطة, نسيج متوسط (نسيج من أصل أديم متوسط يشكل النسيج الضام والدم والعضلات الملساء)",
 "かんじゅく": "إِمْكَان",
 "かんじゅせい": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "かんじょ": "شهامَة / مِرْحَاض, تواليت",
 "かんじょう": "تاجي (يحيط كالتاج (خاصة الأوعية الدموية المحيطة بالقلب)) / تخثر تاجي (انسداد تدفق الدم في الشريان التاجي بجلطة دموية (خثرة))\nمثال: شرايين تاجية / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / عَاطِفَة, عَوَاطِف / أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل) / قَضِيبِيُّ الشَّكْلِ (يشبه القضيب أو العصا في شكله) / عُصَيِّيّ الشَّكْل, قَضِيبِيّ (على شكل العُصَيَّة أو القضيب)",
 "かんじょういにゅう": "تَعَاطُف",
 "かんじょうか": "إِنْسَان انْفِعَالِيّ, شَخْص عَاطِفِيّ (شخص يخضع لحالات عاطفية قوية)",
 "かんじょうがかり": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "かんじょうがき": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "かんじょうこうさてん": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "かんじょうこつ": "عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "かんじょうざん": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان",
 "かんじょうしょ": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "かんじょうしょうがい": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب الرئيسي في العواطف سائداً)",
 "かんじょうしょうごう": "صُلْح, مُصَالَحَة",
 "かんじょうじょうみゃくどう": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "かんじょうたい": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "かんじょうだい": "عَدَّاد",
 "かんじょうだかい": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "かんじょうちがい": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "かんじょうてき": "مُثَار عَاطِفِيًّا, مُنْفَعِل ((للأشخاص) متأثر بشكل مفرط بالعاطفة) / عاطفي (ذو عاطفة أكثر من المعتاد) / انفعالي, عاطفي (محدد أو مدفوع بالعاطفة بدلاً من العقل) / انفعالي, عاطفي (من أو يتعلق بالعاطفة)\nمثال: كان سلوكه عاطفياً للغاية",
 "かんじょうどうみゃく": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم)",
 "かんじょうどうみゃくけっせんしょう": "خُثَار تَاجِيّ",
 "かんじょうどうみゃくしっかん": "تصلب الشرايين (تصلب جدران الشرايين)",
 "かんじょうぶぎょう": "صراف الأجور, مسؤول الرواتب (شخص مسؤول عن دفع الأجور)",
 "かんじょうみゃく": "وريد كبدي (وريد يصرف الكبد؛ يصب في الوريد الأجوف)",
 "かんじょうみゃくどう": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "かんじょうむきだし": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "かんじょうもう": "عُرْوَة, عُقْدَة",
 "かんじょうネットワーク": "عُرْوَة, عُقْدَة",
 "かんじょきょく": "بِبُطْء / أداجيو (جزء بطيء من رقصة ثنائية (با دو دو) يتطلب مهارة وقوة كبيرة من الراقصين) / أَدَاجْيُو ((في الإيقاع الموسيقيّ) مُتَمَهِّل وَهَادِئ) / أداجيو, حركة بطيئة ((موسيقى) تكوين يُعزف بإيقاع أداجيو (ببطء ورشاقة))\nمثال: هنا يجب أن تعزف ببطء",
 "かんじょたい": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "かんじょほう": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده))\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "かんじる": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / مَنْظَر, مَشْهَد",
 "かんじわるい": "سَيِّئ, وحش",
 "かんじん": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / صانع أسلحة (مُصنِّع للأسلحة النارية) / صانع أسلحة, مسؤول تسليح (جندي مجند مسؤول عن صيانة الأسلحة الصغيرة والمدافع الرشاشة وما إلى ذلك) / صانع الأسلحة, صانع الدروع (عامل ماهر في صنع الدروع أو الأسلحة)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي / سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع) / خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين)) / استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك) / عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "かんじんかなめ": "حَاسِم",
 "かんじんもと": "داعم مالي, ممول (شخص يقدم الدعم المالي لمشروع ما)",
 "かんす": "تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "かんすい": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها) / تَنْفِيذ / أُجَاج, صِير (أُجاجاً الماء الشديد الملوحة والمرارة؛ الصوت الحاصل من اختلاط الكلام و حفيف المشي) / رش, نثر (فعل رش أو طرطشة الماء) / رش الماء (فعل رش الماء في المعمودية (نادر)) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / رشات, قلة متناثرة (عدد صغير (من شيء ما) مبعثر بشكل عشوائي)\nمثال: أولى علامات الاخضرار المتناثرة / إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها / ماء الآسن (الماء المتجمع في قاع السفينة)",
 "かんすいぎょ": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "かんすう": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "かんすうよびだし": "استدعاء دالة (استدعاء يمرر التحكم إلى روتين فرعي؛ وبعد تنفيذ الروتين الفرعي يعود التحكم إلى التعليمة التالية في البرنامج الرئيسي)",
 "かんすうライブラリ": "فليروفيوم (عنصر مشع ما بعد اليورانيوم)",
 "かんすばる": "الثُّرَيَّا",
 "かんすぼん": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "かんする": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / زَنَى (مَارَسَ الزِّنَى) / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب. / فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟ / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "かんずる": "مَنْظَر, مَشْهَد / تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "かんせい": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة. / إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة / عَطَالَة / انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / صَامِت, هَادِئ / فَخّ, مِصْيَدَة / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية. / ثُنَائِيّ الْجِنْس / تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟ / سُكَّرِيّ",
 "かんせいかん": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "かんせいこうほう": "ملاحة بالقصور الذاتي, نظام توجيه بالقصور الذاتي (نظام للتحكم في طائرة أو مركبة فضائية؛ يستخدم قوى القصور الذاتي)",
 "かんせいしつ": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "かんせいしょくぶつ": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "かんせいとう": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "かんせいはがき": "بطاقة بريدية (بطاقة لإرسال الرسائل بالبريد دون ظرف)",
 "かんせいゆ": "زيت جاف (زيت يتصلب في الهواء بسبب الأكسدة ويُستخدم غالباً كأساس للطلاء أو الورنيش)",
 "かんせいゆうどう": "توجيه بالقصور الذاتي (طريقة للتحكم في طيران صاروخ بواسطة أجهزة تستجيب لقوى القصور الذاتي)",
 "かんせいよう": "ورقة محيطة بالساق (ورقة تتحد قاعدتها حول الساق - وتبدو كأن الساق تخترقها)",
 "かんせいろん": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "かんせいモーメント": "عزم القصور الذاتي (ميل الجسم لمقاومة التسارع الزاوي)",
 "かんせかい": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "かんせつ": "جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل) / جُزْء, فَلْقَة (أحد الأجزاء التي ينقسم إليها الشيء بشكل طبيعي)\nمثال: قسم من صنارة الصيد / التواء, مراوغة (عمل مخادع غير مباشر) / إجراء غير مباشر, التفاف (إجراء أو عمل غير مباشر)\nمثال: استطاع رؤية ما وراء مراوغات الدبلوماسيين / مُشْتَرَك / مِفْصَل / غِطَاء ثَلْجِيّ, قَلَنْسُوَة ثَلْجِيَّة (غطاء من الثلج (كما على قمة الجبل)) / تَلْمِيح / ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق، ويكون أقل كثافة من المتوسط وغير لزج)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "かんせつえき": "سائل زليلي (سائل لزج مزلق يفرزه الغشاء المبطن للمفاصل وأغلفة الأوتار وما إلى ذلك)",
 "かんせつえん": "اِلْتِهَاب الْمَفَاصِل",
 "かんせつか": "تجويف حقاني, حفرة حقانية (التجويف في رأس لوح الكتف الذي يستقبل رأس عظم العضد لتشكيل مفصل الكتف)",
 "かんせつきょう": "منظار المفاصل (نوع من المناظير يتم إدخاله في المفصل للفحص البصري)",
 "かんせつきょうけんさ": "تنظير المفصل (عملية جراحية طفيفة التوغل لإصلاح مفصل تالف؛ يفحص الجراح المفصل بمنظار المفصل أثناء إجراء الإصلاحات من خلال شق صغير)",
 "かんせつけいせいじゅつ": "رأب المفصل (إعادة بناء أو استبدال جراحي لمفصل مشوه أو متآكل)",
 "かんせつさつえい": "تنظير تألقي (فحص هياكل الجسم باستخدام منظار التألق)",
 "かんせつさつえいほう": "تنظير تألقي (فحص هياكل الجسم باستخدام منظار التألق)",
 "かんせつしょうこ": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "かんせつしょうじゅんしゃげき": "نيران غير مباشرة (نيران توجه لهدف لا يستخدم هو نفسه كنقطة تصويب للأسلحة)",
 "かんせつしょうめい": "إضاءة غير مباشرة (وحدة إضاءة مخفية)",
 "かんせつしん": "جَاضِم",
 "かんせつせんし": "بزل المفصل (إزالة السوائل من المفصل عن طريق البزل)",
 "かんせつぜい": "ضريبة غير مباشرة (ضريبة تفرض على السلع أو الخدمات بدلاً من الأشخاص أو المؤسسات)",
 "かんせつつう": "ألم المفاصل (ألم في مفصل أو مفاصل)",
 "かんせつてき": "غير مباشر, ملتوٍ (غير مباشر في البعد المكاني؛ لا يؤدي بخط مستقيم أو مسار مباشر إلى وجهة) / ضمني, غير مباشر ((بالمعنى الموسع) غير مباشر في الأسلوب أو اللغة أو السلوك أو العمل) / غَيْر مُبَاشِر (لَهُ عَوَامِل أَوْ أَشْخَاص أَوْ تَأْثِيرَات وَسِيطَة) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة)\nمثال: أحياناً يوفر اتخاذ مسار غير مباشر الوقت",
 "かんせつはんげつ": "غضروف هلالي, هلالة ((في التشريح) قرص غضروفي يعمل كوسادة بين نهايات العظام التي تلتقي عند المفصل)",
 "かんせつひ": "فَوْق الرَّأْس (أعلى الرأس) / عَالِيًا, فِي السَّمَاء (فوق رأسك؛ في السماء) / سماش, ضربة ساحقة (رد قوي بضرب كرة التنس فوق رأسك) / علوي, فوقي (يقع أو ينشأ من الأعلى)\nمثال: اجمع الساقين معاً فوق الرأس",
 "かんせつもくてきご": "مفعول به غير مباشر (المفعول الذي هو المتلقي أو المستفيد من فعل الفعل)",
 "かんせつリウマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "かんせつリューマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "かんせん": "صَدَفِيَّة / خط رئيسي (المسار الرئيسي لنظام النقل) / عَدْوَى / غدة عرقية (أي من الغدد الموجودة في الجلد التي تفرز العرق) / دَقِيقُ المُلَاحَظَة, يَقِظ (سَرِيعُ المُلَاحَظَةِ؛ يُظْهِرُ إِدْرَاكًا حَادًّا وَسَرِيعًا)",
 "かんせんきょ": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "かんせんしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "かんせんしょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんせんどう": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "かんせんどうろ": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "かんせんびょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんせんリスク": "خطر العدوى, مخاطرة (احتمال الإصابة بالعدوى بعد حدوث التعرض لعامل معد)",
 "かんぜい": "استعجال, حث (فعل الدعم أو التشجيع بجدية) / إلحاح (طلب وتوسل بإصرار) / تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: لم يترك لي إلحاحه بديلاً سوى الموافقة / رُسُوم, جُمْرُك / تَلْمِيح",
 "かんぜいどうめい": "اتحاد جمركي (رابطة دول لتعزيز التجارة الحرة داخل الاتحاد وتحديد تعريفات مشتركة للدول غير الأعضاء)",
 "かんぜいぼうえきいっぱんきょうてい": "الاتفاقية العامة للتعريفات الجمركية والتجارة, الجات (وكالة تابعة للأمم المتحدة أنشئت بموجب معاهدة متعددة الجنسيات لتعزيز التجارة عن طريق خفض التعريفات الجمركية وحصص الاستيراد)",
 "かんぜつ": "فَرِيد, فَذّ",
 "かんぜん": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه) / بجرأة\nمثال: يجب أن نعالج هذه المهام بجرأة / طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل) / مَحْلُول الأَرْبِطَة (مع أربطة غير مربوطة) / غَيْر مَرْبُوط, مَحْلُول (غير مربوط)\nمثال: مراهقون يتسكعون بأحذية رياضية محلولة الأربطة / مَسْرُور (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح",
 "かんぜんきたい": "غاز مثالي (غاز افتراضي ذو جزيئات مهملة الحجم لا تمارس أي قوى بين الجزيئات)",
 "かんぜんこっせつ": "كسر كامل (كسر يشمل كامل عرض العظم)",
 "かんぜんこよう": "توظيف كامل (الحالة الاقتصادية عندما يكون كل من يرغب في العمل بمعدل الأجر السائد لنوع عمله موظفاً)",
 "かんぜんさいしょくしゅぎしゃ": "خُضْرِيّ",
 "かんぜんしあい": "مباراة مثالية (مباراة لا يسمح فيها الرامي لأي لاعب منافس بالوصول إلى القاعدة)",
 "かんぜんしゅぎ": "كَمَالِيَّة",
 "かんぜんしゅぎしゃ": "كَمَالِيّ",
 "かんぜんじあい": "مباراة مثالية (مباراة لا يسمح فيها الرامي لأي لاعب منافس بالوصول إلى القاعدة)",
 "かんぜんじゆうしゅぎ": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "かんぜんせい": "اكْتِمَال, تَمَام ((منطق) سمة لنظام منطقي مكون بحيث ينشأ تناقض إذا تم إدخال أي قضية لا يمكن اشتقاقها من بديهيات النظام) / تمام, كمال (حالة كونه كاملاً وتاماً؛ امتلاك كل ما هو مطلوب)",
 "かんぜんちょうあく": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط والإنْصَاف)\nمثال: يريدون العدالة.",
 "かんぜんちょうあくげき": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل والرذائل)",
 "かんぜんへき": "كَمَالِيَّة",
 "かんぜんへんたい": "تحول كامل (تحول كامل في الحشرات)",
 "かんぜんほうしゃたい": "جِسْم أَسْوَد (جسم افتراضي قادر على امتصاص كل الإشعاع الكهرومغناطيسي الساقط عليه)\nمثال: الجسم الأسود المحافظ على درجة حرارة ثابتة هو مشع كامل عند تلك الدرجة لأن الإشعاع الواصل إليه والمغادر له يجب أن يكون في توازن",
 "かんぜんむけつ": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "かんそ": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんそう": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / جفاف, يبوسة (حالة عدم احتواء سائل أو عدم التغطية به (خاصة الماء))\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة / تفاهة, رتابة طعم (الافتقار إلى أي خاصية تذوق مميزة أو مثيرة للاهتمام) / رَتَابَة, سَآمَة (الملل الشديد؛ الافتقار إلى الروح أو الاهتمام) / إنهاء, تشطيب (فعل الإنهاء) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث / اِنْطِبَاع, أَثَر / تَقْلِيد / سحنة, محيا (الوجه البشري) / تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / فاصل, فترة بينية (فترة أو حلقة فاصلة) / تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "かんそうか": "فَوَاكِه مُجَفَّفَة",
 "かんそうがく": "علم فراسة الدماغ, فرينولوجيا (دراسة مهجورة الآن لشكل الجمجمة كمؤشر على قوى الملكات العقلية المختلفة)",
 "かんそうき": "مجفف (جهاز يقوم بإزالة الرطوبة) / موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "かんそうきょく": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / فاصل, فترة بينية (فترة أو حلقة فاصلة)",
 "かんそうぎゅうにゅう": "حليب بودرة, حليب مجفف (حليب منزوع الماء (مجفف))",
 "かんそうざい": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "かんそうじゅつ": "سحنة, محيا (الوجه البشري)",
 "かんそうせんたく": "تَنْظِيف جَافّ",
 "かんそうち": "بَرّ, يَابِسَة (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "かんそうにく": "قَدِيد",
 "かんそうふきゅう": "عفن جاف (فطر يسبب العفن الجاف) / عفن جاف (تفتت وجفاف للأخشاب أو البصلات أو البطاطس أو الفاكهة بسبب فطر)",
 "かんそうみそ": "مُجَفَّف بِالتَّجْمِيد (مَحْفُوظ بِالتَّجْمِيد ثُمَّ التَّجْفِيف فِي الفَرَاغ) / مُجَفَّف تَجْمِيدِيًّا ((عَنِ الأَنْسِجَة أَوِ الدَّم أَوِ الأَمْصَال) مُجَفَّف بِالتَّجْمِيد فِي فَرَاغ عَالٍ)",
 "かんそうむみ": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / جفاف, يبوسة (حالة عدم احتواء سائل أو عدم التغطية به (خاصة الماء))\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "かんそか": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد)",
 "かんそく": "رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / رَأْي, نَظَر / قدم أنبوبية (ناتئ أنبوبي ذو مجسات لمعظم شوكيات الجلد (نجم البحر وقنفذ البحر وخيار البحر) له ممص في النهاية ويستخدم مثلاً للحركة والتنفس) / حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من الخشب واللحاء)",
 "かんそくかのうりょう": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته)",
 "かんそくききゅう": "بالون اختبار (بالون يُرسل لأعلى لاختبار التيارات الهوائية) / بالون اختبار, جس نبض (اختبار للرأي العام)",
 "かんそくしゃ": "متفرج",
 "かんそくじょ": "مَرْصَد",
 "かんぞう": "عرق السوس (حلوى سوداء منكهة بالجذر المجفف لنبات عرق السوس) / عرق سوس (نبات عميق الجذور خشن الملمس موطنه منطقة البحر الأبيض المتوسط له أزهار زرقاء وأوراق مركبة ريشية؛ يزرع على نطاق واسع في أوروبا لجذوره الحلوة السميكة…) / كَبِد, كِبْد / سَودَة / زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل وزهور تشبه الزنبق صفراء عادة تتفتح ليوم واحد فقط)",
 "かんぞうえん": "اِلْتِهَاب الْكَبِد",
 "かんぞうがん": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "かんぞうご": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "かんぞうたけ": "فطر شريحة اللحم (فطر صالح للأكل شائع بقبعة بلون الكبد أو اللحم النيئ؛ وفير في جنوب شرق الولايات المتحدة)",
 "かんぞうびょう": "مرض كبدي (مرض يصيب الكبد)",
 "かんぞく": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "かんたい": "المنطقة القطبية, المنطقة المتجمدة (جزء سطح الأرض الذي يشكل غطاء فوق القطب؛ ويتميز بمناخ متجمد) / كَرَم, إِكْرَام / ضِيَافَة / أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي) / تراخ, تسيب (صفة التراخي والإهمال) / ارتخاء, رخاوة (حالة الارتخاء الفسيولوجي)\nمثال: يمكن للحمامات أن تساعد في تخفيف رخاوة الأمعاء / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط. / رمع (تشنج يتميز بتقلصات واسترخاءات متناوبة)",
 "かんたいさいぼう": "خلية عصوية, عصية (خلية مستقبلة بصرية حساسة للضوء الخافت)",
 "かんたいぜんせん": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "かんたいりん": "تَايْغَا",
 "かんたる": "أَفْضَل",
 "かんたん": "إِعْجَاب / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / وَجِيز, قَصِير / وَجِيز, مُوجَز / صرصور الشجر (صرصور أمريكي شجري شاحب يشتهر بصريره العالي)",
 "かんたんし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんたんにいえば": "بِاخْتِصَار",
 "かんたんふ": "علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "かんたんぶん": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんだい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / حَلِيم, صَبُور (مُتَسَامِحٌ وَصَفُوحٌ عِنْدَ الِاسْتِفْزَازِ) / مُتَسَامِح, مُحْتَمِل (يُظْهِرُ قُدْرَةً عَلَى التَّحَمُّل) / مُتَحَمِّل, مُقَاوِم (قادر على تحمل الظروف البيئية أو الإجهاد الفسيولوجي) / اسم موصول, ضمير وصل (ضمير (مثل 'الذي' أو 'التي') يقدم جملة صلة تشير إلى سابق ما) / رمع (تشنج يتميز بتقلصات واسترخاءات متناوبة)",
 "かんだかい": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "かんだちべ": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "かんだちめ": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "かんだん": "دَرْدَشَ / مُحَادَثَّة / دَرْدَشَة / مُقَاطَعَة / ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة) / دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かんだんけい": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "かんだんなく": "باستمرار",
 "かんち": "اِدْرََاك حَسِّيّ / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / مَاكِر",
 "かんちがい": "سُوء فَهْم",
 "かんちき": "حَسَّاس, جِهَازُ اِسْتِشْعَار",
 "かんちく": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "かんちつ": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "かんちゅう": "سَقْي / إمداد, تزويد (نشاط توريد أو توفير شيء ما)",
 "かんちょう": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار. / جَاسُوس / تَجَسَّسَ / مشرف عام, ناظر (شخص يوجه ويدير منظمة) / مَسْؤُول العِمارَة, مُشْرِف المَبْنَى (حارس مبنى سكني يمثل المالك ويعمل كبواب وجامع للإيجار) / حُقْنَة شَرَجِيَّة, حُقْنَة / سلالة هان, هان (سلالة إمبراطورية حكمت الصين (معظم الوقت من 206 قبل الميلاد إلى 220 ميلادي) ووسعت حدودها وطورت بيروقراطيتها؛ تُذكر كواحدة من العصور العظيمة للحضارة…) / انحسار الماء, جزر (أدنى (أبعد) انحسار للمد) / تَاج, إِكْلِيل",
 "かんちょういき": "مَصَبّ, فُغْرَة",
 "かんちょうえき": "حُقْنَة شَرَجِيَّة, حُقْنَة",
 "かんちょうかせん": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "かんちょうせん": "علامة الجزر, علامة المد المنخفض (خط يحدد أدنى مستوى تم الوصول إليه) / أسوأ حالات, حضيض (حالة قصوى من الشدائد؛ أدنى نقطة لأي شيء)",
 "かんつい": "تَنْفِيذ / أَطْلَس",
 "かんつう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى) / ثَاقِب, نَافِذ (يميل إلى الاختراق؛ له قدرة على الدخول أو الثقب) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "かんつうざい": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "かんつぎて": "تركيبات أنابيب, وصلة أنابيب (تجهيزة تتكون من قطع أنابيب مسننة لربط الأنابيب ببعضها)",
 "かんづかさ": "كَاهِن, قِسِّيس",
 "かんづく": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "かんづめ": "أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب)",
 "かんづめこうじょう": "مصنع تعليب (مصنع يتم فيه تعليب الطعام)",
 "かんてい": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة. / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "かんていか": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "かんていかかく": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))",
 "かんていかん": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء) / خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "かんていし": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء) / خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "かんていにん": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "かんてき": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "かんてつ": "تَنْفِيذ / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "かんてつしょう": "داء المتورقات (الإصابة بالمتورقة الكبدية؛ يحدث أحياناً تلف في الكبد)",
 "かんてん": "طقس بارد (فترة من الطقس البارد بشكل غير عادي) / أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة) / جَفَاف / زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "かんてんきち": "ابتهاج, تهلل (تلفظ بأصوات تعبر عن الفرح العظيم) / ابتهاج, احتفال (مناسبة مبهجة تتضمن احتفالات خاصة لتمييز حدث سعيد) / تهلل, حبور (شعور بالفرح الشديد)",
 "かんてんばいち": "آغار, أجار مغذ (أي وسط استنبات يستخدم الآغار كعامل هلامي)",
 "かんでん": "إِلِكْتْرُود",
 "かんでんし": "صعق كهربائي (القتل بصدمة كهربائية) / صعق كهربائي (الإعدام بالكهرباء)",
 "かんとう": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / مُفْتَرَق, تَقَاطُع / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとうげん": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "かんとうし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "かんとく": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / تَحْقِيق / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとくかん": "مُفَتِّش, مُفَتِّشَة",
 "かんとくきょうかい": "الكنيسة الأسقفية (كنيسة الولايات المتحدة التي تتواصل مع كرسي كانتربري) / الكنيسة الأسقفية في اسكتلندا (فرع مستقل من الطائفة الإنجليكانية في اسكتلندا)",
 "かんとくしゃ": "مشرف عام, ناظر (شخص يوجه ويدير منظمة) / مَسْؤُول العِمارَة, مُشْرِف المَبْنَى (حارس مبنى سكني يمثل المالك ويعمل كبواب وجامع للإيجار)",
 "かんとくせい": "حاكم إداري, محافظ (كبير الضباط أو كبير القضاة)\nمثال: محافظ شرطة باريس",
 "かんとん": "أسر, اعتقال (حالة كونه مسجوناً)\nمثال: احتجز في الأسر حتى مات",
 "かんど": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "かんどう": "حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / طريق جانبي (طريق فرعي يتفرع من طريق رئيسي)",
 "かんどうし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんどうてき": "مُتَحَرِّك / مُؤَثِّر",
 "かんどうぶん": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんどうみゃく": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم) / شريان كبدي (شرايين تغذي الكبد)",
 "かんどうみゃくしっかん": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんどうみゃくバイパスしゅじゅつ": "تحويل مسار الشريان التاجي, مجازة تاجية (جراحة قلب مفتوح يتم فيها فتح القفص الصدري وتطعيم قسم من وعاء دموي من الشريان الأورطي إلى الشريان التاجي لتجاوز القسم المسدود من الشريان التاجي وتحسين…)",
 "かんどく": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんどころ": "مَرْبِط الْفَرَس",
 "かんな": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "かんなかけ": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "かんながらのみち": "شِنْتَوِيَّة, شِنْتُو",
 "かんなぎ": "مُتَوَسِّط",
 "かんなくず": "قش خشب, نشارة خشب (نشارة خشب مجعد رقيقة تستخدم للتعبئة أو الحشو)",
 "かんなづき": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "かんなん": "بلاء, مصاب (سبب للمعاناة والضيق الشديد) / بلاْء, علة (حالة من المعاناة أو الضيق بسبب اعتلال الصحة) / بلاء, محنة (حالة من المعاناة والضيق الشديد بسبب الشدائد) / مَشَقَّة, شِدَّة",
 "かんなんくろう": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "かんなんしんく": "مَشَقَّة, شِدَّة",
 "かんな屑": "قش خشب, نشارة خشب (نشارة خشب مجعد رقيقة تستخدم للتعبئة أو الحشو)",
 "かんにさわる": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "かんにゅう": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته) / ترسب, ترييح (غوص تدريجي إلى مستوى أدنى) / انحسار, هجوع (انخفاض في الشدة أو الدرجة (كما في أعراض المرض))\nمثال: سرطانه في حالة هجوع / انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح) / انغماد, انقلاب للداخل (حالة الطي للداخل أو التغليف)\nمثال: انغماد الأريمة / ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها) / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها) / تَطَفُّل, مُدَاخَلَة / تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات / نظرة ثاقبة",
 "かんにゅうふん": "اِنْطِوَائِيّ",
 "かんにん": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / مَغْفِرَة, غُفْرَان / خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "かんぬき": "حَانَة, بَار / سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "かんぬし": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "かんねつ": "بردية, حمى الملاريا (مراحل متعاقبة من القشعريرة والحمى وهي عرض للملاريا)",
 "かんねついんじそうち": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "かんねつしきプリンタ": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "かんねつしきプリンター": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "かんねつプリンタ": "طابعة حرارية (طابعة تنتج أحرفاً عن طريق تطبيق الحرارة على ورق خاص حساس للحرارة)",
 "かんねん": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / اِسْتِقَالَة, اِسْتِعْفَاء / تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "かんねんか": "تكوين الأفكار (عملية تكوين وربط الأفكار)",
 "かんねんけいたい": "أَيْدِيُولُوجِيَا",
 "かんねんしゅぎ": "مِثَالِيَّة",
 "かんねんてき": "مَفَاهِيمِيّ (يتعلّق بالمفاهيم أو يتّسم بتكوينها) / نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "かんねんねんぶつ": "تَفَكُّر",
 "かんねんれんごう": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "かんねんろん": "مِثَالِيَّة",
 "かんのいい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "かんのう": "شَهْوَانِيَّة / استجابة, تجاوب (صفة الاستجابة أو التفاعل بسرعة؛ بالنسبة للأشخاص، تتضمن التجاوب العاطفي مع الناس والأحداث) / استجابة, تفاعلية (الاستجابة للتحفيز) / إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير / دماغ بيني (القسم الخلفي من الدماغ الأمامي؛ يربط نصفي الكرة المخية بالدماغ المتوسط) / بَارِع, حَاذِق (يمتلك معرفة ومهارة وكفاءة ويُظهرها) / تقني, فني (مكون من أو متعلق بالتقنية أو البراعة في مهارة عملية)\nمثال: كان ابتكاره الفني هو ضربات فرشاته / صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "かんのうき": "مجموعة وظيفية (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "かんのうさよう": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير",
 "かんのうしゅぎ": "حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / حسية, شهوانية (الرغبة في الملذات الحسية)",
 "かんのうしゅぎしゃ": "شهواني (شخص يستمتع بالشهوات)",
 "かんのうせい": "عَمَلِيَّة, وَظِيفِيَّة (القدرة على خدمة غرض ما بشكل جيد)\nمثال: برمجيات ذات وظيفية أكبر / استجابة, تجاوب (صفة الاستجابة أو التفاعل بسرعة؛ بالنسبة للأشخاص، تتضمن التجاوب العاطفي مع الناس والأحداث) / استجابة, تفاعلية (الاستجابة للتحفيز)",
 "かんのうてき": "شَهْوَانِيّ",
 "かんのき": "حَانَة, بَار / سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "かんのつよい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات) / شَدِيد التَّهَيُّج (حسّاس بشكل غير طبيعي لمؤثّر ما)",
 "かんのむし": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "かんのよい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة) / إدراكي (متعلق بالإدراك الحسي)\nمثال: عين ثاقبة",
 "かんのんさま": "بَظْر",
 "かんのんとびら": "باب مزدوج (بابان عموديان يلتقيان في منتصف إطار الباب عند إغلاقهما)",
 "かんのんびらき": "باب مزدوج (بابان عموديان يلتقيان في منتصف إطار الباب عند إغلاقهما)",
 "かんの虫": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "かんはついれず": "فَوْرًا, حَالًا",
 "かんはつおかず": "فَوْرًا, حَالًا",
 "かんはつをいれず": "فَوْرًا, حَالًا",
 "かんはんとう": "شِبْه الْجَزِيرَةِ الْكُورِيَّة",
 "かんば": "بَتُولَا",
 "かんばい": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "かんばしい": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "かんばしくない": "فَقِير / مِسْكِين / فُقَرَاء",
 "かんばしった": "حَادّ, صَارِخ (ذو لون ساطع بشكل مفرط وصارخ) / حَادّ, صَاخِب (يُصِرُّ بِحِدَّةٍ عَلَى أَنْ يُسْمَع) / حَادّ, صَرِير (ذو نبرة عالية وحادَّة أو يُصدر نغمات كذلك)",
 "かんばせ": "مَلَامِح / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "かんばつ": "جَفَاف / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "かんばん": "لَافِتَة, لَوْحَة / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / سُمْعَة, شُهْرَة / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "かんばんだおれ": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "かんぱ": "مَوْجَةُ اْلبَرْدِ / قِرَاءَة",
 "かんぱい": "إِفْنَاء, تَدْمِير / إِفْنَاء / انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / توست, خبز محمص (شرائح من الخبز تم تحميصها) / نخب (شرب نخب تكريماً لشخص أو حدث أو للصحة) / مُنْتَهٍ, هالِك (شخص في مأزق يائس؛ شخص محكوم عليه بالهلاك) / نجم المجتمع (مشهور يتلقى الكثير من الإشادة والاهتمام)\nمثال: سأكون هالكاً إذا لم تنجح هذه الخطة",
 "かんぱつ": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية / فَوْرًا, حَالًا",
 "かんぱついれず": "فَوْرًا, حَالًا",
 "かんぱつおかず": "فَوْرًا, حَالًا",
 "かんぱつをいれず": "فَوْرًا, حَالًا",
 "かんぱん": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء) / ظَهْر, سَطْح (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مِسَاس / كَلَف (سبب له كُلْفَة، أي كان أمرا صعبا وغير سهل أو طبيعي؛ جعل عليه كُلْفَة وثَمَنا كبيرا، أي كان غاليا عليه)\nمثال: كلف ذلك فاضل حياته.",
 "かんぱんいす": "كرسي الشاطئ, كرسي سطح السفينة (كرسي قابل للطي للاستخدام في الهواء الطلق؛ يدعم إطار خشبي قطعة من القماش)",
 "かんぱんわたし": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "かんひだい": "تضخم الكبد (تضخم غير طبيعي للكبد)",
 "かんび": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا / صَارِم, مُتَشَدِّد / مُؤَخَّرَة",
 "かんびせい": "اكْتِمَال, تَمَام ((منطق) سمة لنظام منطقي مكون بحيث ينشأ تناقض إذا تم إدخال أي قضية لا يمكن اشتقاقها من بديهيات النظام) / تمام, كمال (حالة كونه كاملاً وتاماً؛ امتلاك كل ما هو مطلوب)",
 "かんびょう": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "かんびょうにん": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんぴしょう": "جفاف الجلد (شكل خفيف من السماك يتميز بجفاف وخشونة الجلد غير الطبيعيين)",
 "かんふきん": "إِعَادَة مَال",
 "かんふぜん": "قُصُور الشِّرْيَان التَّاجِيّ, قُصُور القَلْب (تدفق غير كافٍ للدم إلى عضلات القلب؛ يمكن أن يسبب ذبحة صدرية)",
 "かんぶ": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "かんぶかい": "مَجْلِس إِدَارَة",
 "かんぶくろ": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "かんぶつ": "بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / بقالة, متجر بقالة (سوق تباع فيه مواد البقالة)\nمثال: تضمن متجر البقالة سوقاً للحوم / تبضع, شراء (فعل الشراء)\nمثال: الشراء والبيع يملآن أيامهم / عصا الراعي, محجن (عصا طويلة ذات طرف على شكل خطاف) / جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة) / التواء, انعطاف (جزء دائري من منحنى)\nمثال: منعطف في الطريق",
 "かんぶつや": "بِقَالَة, حَانُوت بَقَّال",
 "かんぶり": "تَاج, إِكْلِيل",
 "かんぷ": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج) / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "かんぷう": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل) / ورقة القيقب (شعار كندا)",
 "かんぷきん": "إِعَادَة مَال",
 "かんぷく": "إِعْجَاب\nمثال: 君の勇気には全く感服する。 — يعجبني فيك شجاعتك.",
 "かんぷなきまで": "تَمَامًا",
 "かんぷん": "مُتَأَثِّر, مُسْتَثَار (مُثَار عاطفياً ووجدانياً)",
 "かんへんとう": "لوز, لوز حلو (شجرة نفضية شجيرية صغيرة موطنها آسيا وشمال أفريقيا لها أزهار وردية جميلة ومكسرات صالحة للأكل ذات قيمة عالية محاطة بقشرة خضراء صلبة؛ تزرع في جنوب…)",
 "かんべつ": "تَفْرِيق / تَمْيِيز",
 "かんべつしんだん": "تشخيص تفريقي (طريقة منهجية لتشخيص اضطراب يفتقر إلى أعراض أو علامات فريدة)",
 "かんべん": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟ / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんぺいしき": "اِسْتِعْرَاض, مَوْكِب",
 "かんぺき": "حدة الطبع, سرعة الغضب (شعور بالغضب الممتزج بالاستياء) / كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "かんぺきしゅぎ": "كَمَالِيَّة",
 "かんぺきしゅぎしゃ": "كَمَالِيّ",
 "かんぼう": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "かんぼうちょうかん": "رئيس أركان الجيش",
 "かんぼく": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب. / شُجَيْرَة, شَجَرَة",
 "かんぼつ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "かんぼつこっせつ": "كسر منخسف (كسر في الجمجمة حيث يُدفع العظم إلى الداخل)",
 "かんぽ": "نَفَق",
 "かんぽう": "خلل التعرق (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "かんぽどうぶつ": "بطيء الخطو, دب الماء (مفصلي من شعبة بطيئات الخطو)",
 "かんまく": "رِبَاط",
 "かんまん": "بَطِيء / أَبْطَأَ, بَطَّأَ / رَخْو, مُرْتَخٍ (يُفَرَّغ بسهولة أو بإفراط) / مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / رخو, مرتخٍ (يفتقر إلى الحزم أو الشد؛ غير مشدود) / رخو (صوتياً) (يُنطق بعضلات لسان وفك مرتخية نسبيًا)",
 "かんみ": "مُلُوْحَة / حَلَاوَةٌ / حَلْوَيَات / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "かんみりょう": "مُحَلِّيّ",
 "かんみん": "حياة خفية, كمون حياتي (حالة تتوقف فيها الأنشطة الأيضية للحيوان بشكل قابل للعكس)",
 "かんむり": "تَاج, إِكْلِيل / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "かんむりかいつぶり": "غطاس متوج كبير (غطاس كبير من العالم القديم ذو خصلات أذن سوداء)",
 "かんむりざ": "التَّاج السَّمَالِيّ",
 "かんむり座": "التَّاج السَّمَالِيّ",
 "かんめい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "かんめいちょくせつ": "صَرِيح, مُسْتَقِيم",
 "かんめいぶかい": "جَدِيرٌ بِالتَّذَكُّر, لَافِت (يَسْتَحِقُّ أَنْ يُتَذَكَّرَ)",
 "かんめんぽう": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً) / ماهوجني الجبل (نوع من الماهوجني الجبلي)",
 "かんもう": "زغب الشوك (زغب نبات الشوك المكون من شعيرات حريرية تشبه الريش) / انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "かんもくしょう": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "かんもじ": "كلام فارغ, هراء (خطابة فارغة أو حديث غير صادق أو مبالغ فيه)\nمثال: هذا الكثير من الهراء",
 "かんもん": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له. / حَاجِز / عَقَبَة, حَاجِز / باب الكبد (فتحة لدخول وخروج الأوعية الدموية الرئيسية من وإلى الكبد)",
 "かんもんじ": "كلام فارغ, هراء (خطابة فارغة أو حديث غير صادق أو مبالغ فيه)\nمثال: هذا الكثير من الهراء",
 "かんもんみゃく": "وريد بابي, وريد بابي كبدي (وريد قصير يحمل الدم إلى الكبد)",
 "かんやく": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد) / وَجِيز, مُوجَز / زِرّ / طب الأعشاب (استخدام الأعشاب الطبية للوقاية من الأمراض أو علاجها أو تعزيز الصحة) / دواء عشبي (دواء مصنوع من النباتات ويستخدم للوقاية من المرض أو علاجه أو تعزيز الصحة)",
 "かんやくかめいれいしゅうごうけいさんき": "حاسوب بمجموعة تعليمات مقلصة, ريسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على مجموعة صغيرة نسبياً من تعليمات الحاسوب التي يمكنه تنفيذها)",
 "かんゆ": "زيت السمك, زيت كبد السمك (زيت دهني يتم الحصول عليه من أكباد الأسماك المختلفة) / كناية, مجاز مرسل (استبدال اسم صفة أو ميزة باسم الشيء نفسه)",
 "かんゆう": "دَعْوَة, عزيمة / إِغْرَاء",
 "かんゆういん": "جامع الأصوات (شخص يأخذ أو يعد الأصوات) / منظم استطلاعات الرأي (شخص يجري دراسات استقصائية للرأي العام) / فاحص الأصوات (شخص يفحص الأصوات في الانتخابات) / جامع تبرعات, مستجدي (ملتمس يطلب مساهمات أو تجارة أو أصوات)\nمثال: منظم الاستطلاعات يجري استطلاعات الرأي العام",
 "かんゆうち": "أرض التاج (الأرض التي يملكها التاج (الملكية))",
 "かんゆご": "كناية, مجاز مرسل (كلمة تدل على شيء ولكنها تشير إلى شيء آخر مرتبط به)\nمثال: واشنطن هي كناية عن حكومة الولايات المتحدة",
 "かんよ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "かんよう": "تَحَمُّل / تَسَامُح / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي / تَهْذِيب / لحمة متوسطة, نسيج متوسط (نسيج من أصل أديم متوسط يشكل النسيج الضام والدم والعضلات الملساء)",
 "かんようく": "اِصْطِلَاح, مُصْطَلَح",
 "かんようご": "اِصْطِلَاح, مُصْطَلَح",
 "かんようごく": "اِصْطِلَاح, مُصْطَلَح",
 "かんようしょくぶつ": "نبات داخلي, نبات منزلي (أي من النباتات المتنوعة التي تُزرع داخل المنازل لأغراض الزينة)",
 "かんようてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي) / عُرْفِيّ, مَأْلُوف (وَفْقًا لِلعُرْفِ أَوِ العَادَة)",
 "かんようひょうげん": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "かんようほう": "اِسْتِخْدَام",
 "かんよしゃ": "مُشَارِك / مُشَارِكَة",
 "かんらく": "جُبْن, جبنة (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري. / مُتْعَة, لَذَّة / انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته) / ترسب, ترييح (غوص تدريجي إلى مستوى أدنى) / انحسار, هجوع (انخفاض في الشدة أو الدرجة (كما في أعراض المرض))\nمثال: سرطانه في حالة هجوع / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / رَضُوخ, مُذْعِن (يَمِيلُ إِلَى الِاسْتِسْلَامِ أَوِ التَّنَازُلِ أَوِ المُوَافَقَةِ) / طَيِّع, لَدِن (يَسْتَجيب لِلضَّغْط بِسُهولَة؛ قابِل لِلتَّشَكُّل) / لَيِّن, مُسْتَسْلِم (يميل إلى الاستسلام للحجة أو التأثير أو السيطرة) / إذعان, تنازل (فعل التنازل أو الإذعان)",
 "かんらくがい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "かんらくそ": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "かんらん": "سهر عند الجثمان (وقفة صلاة تعقد فوق جثة في الليلة التي تسبق الدفن) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم)) / مَلْفُوف, كُرُنْب / زَيْتُون (نوع من الشَجَر له ثمر حبّ صغير أسود أو أخضر يُعصر منه الزَيْت؛ ثمر شجر الزيتون، الحب الصغير أسود كان أو أخصر) / زَيْتُونِيّ, زَيْتِيّ\nمثال: هي تشرب زيت الزيتون.",
 "かんらんがん": "بيريدوتيت (صخر ناري خشن الحبيبات داكن يتكون بشكل أساسي من الأوليفين)",
 "かんらんしゃ": "دُولَاب هَوَاء / مُشَاهِد, رَاءٍ",
 "かんらんせき": "مُدَرَّجَات مَكْشُوفَة (مدرج خارجي بدون سقف؛ يتعرض الرواد للشمس) / أوليفين, زبرجد زيتوني (معدن يتكون من سيليكات المغنيسيوم والحديد؛ مصدر للمغنيسيوم)",
 "かんらんりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "かんらん岩": "بيريدوتيت (صخر ناري خشن الحبيبات داكن يتكون بشكل أساسي من الأوليفين)",
 "かんらん石": "أوليفين, زبرجد زيتوني (معدن يتكون من سيليكات المغنيسيوم والحديد؛ مصدر للمغنيسيوم)",
 "かんり": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين)) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "かんりいん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "かんりかかく": "سعر إداري, سعر مُدار (سعر تمليه أي هيئة غير قوى السوق)",
 "かんりかん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "かんりかんとくしゃ": "مُشْرِف, مُشْرِفَة",
 "かんりき": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي)",
 "かんりけん": "وكالة تنظيمية (وكالة حكومية تنظم الأعمال التجارية من أجل المصلحة العامة)",
 "かんりし": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "かんりしゃ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "かんりしょく": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "かんりじょう": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "かんりせきにん": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "かんりたいせい": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "かんりつ": "وَطَنِيّ, قَوْمِيّ",
 "かんりてんとう": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "かんりにん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "かんりばいしゅん": "قِوَادَة",
 "かんりゃく": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんりゃくか": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد)",
 "かんりゅう": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت) / انحسار, جزر (التدفق الخارجي للمد) / ارتجاع, جزر (تدفق غير طبيعي لسوائل الجسم إلى الخلف) / إرواء, تروية (ضخ سائل في عضو أو نسيج (خاصة عن طريق الأوعية الدموية)) / انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "かんりゅうれいきゃくき": "مكثف ارتجاعي (مكثف يتم فيه تكثيف البخار فوق سائل يغلي فيتدفق مرة أخرى إلى الوعاء لمنع جفاف محتوياته من الغليان)",
 "かんりょう": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه) / بِيرُوقْرَاطِيّ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "かんりょうきこう": "بِيرُقْرَاطِيَّة",
 "かんりょうけい": "تام (زمن للأفعال يُستخدم في وصف حدث قد اكتمل)",
 "かんりょうしゅぎ": "بِيرُقْرَاطِيَّة",
 "かんりょうしゅぎしゃ": "بِيرُوقْرَاطِيّ",
 "かんりょうしょく": "طَعَام, غِذَاء صُلْب (أيّ مادّة صلبة تُستخدَم مصدرًا للتغذية، في مقابل السوائل)",
 "かんりょうじせい": "تام (زمن للأفعال يُستخدم في وصف حدث قد اكتمل)",
 "かんりょうせい": "بِيرُقْرَاطِيَّة",
 "かんりょうてき": "بيروقراطي (من أو متعلق أو يشبه البيروقراطي أو البيروقراطية)\nمثال: أزعج سلوكه البيروقراطي زملاءه",
 "かんりりょういき": "دكتور في الطب (درجة الدكتوراه في الطب) / طبيب (ممارس طبي مرخص) / مندليفيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الأينشتاينيوم بجسيمات ألفا)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "かんりんいん": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "かんりシステム": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "かんるい": "بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل",
 "かんれい": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / عَادَة, عُرْف",
 "かんれいしゃ": "شاش, قماش الجبن (شاش قطني خشن فضفاض النسج؛ كان يستخدم في الأصل لتغليف الجبن)",
 "かんれいぜんせん": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "かんれいてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي) / عُرْفِيّ, مَأْلُوف (وَفْقًا لِلعُرْفِ أَوِ العَادَة)",
 "かんれん": "عَلَاقَة",
 "かんれんしつもん": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "かんれんせい": "ارْتِبَاط, قَرَابَة (طريقة معينة من الترابط)\nمثال: الارتباط بين جميع الكائنات الحية",
 "かんれんつう": "ألم رجيع (ألم يُشعر به في مكان بالجسم يختلف عن الجزء المصاب أو المريض حيث يُتوقع الألم)\nمثال: يمكن أن تسبب الذبحة الصدرية ألماً رجيعاً في الكتف الأيسر",
 "かんれんづけ": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "かんれんづける": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "かんれんグッズ": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "かんろ": "جَذَّابٌ جِنْسِيًّا, فَاتِن (قَادِرٌ عَلَى إِثَارَةِ الرَّغْبَةِ الجِنْسِيَّة) / شَهِيٌّ لِلغَايَة, لَذِيذٌ جِدًّا (بَالِغُ اللَّذَّةِ لِحَاسَّةِ التَّذَوُّق) / مغثر / مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة) / خَطّ أَنَابِيب (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "かんろく": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "かんろすい": "ماء وسكر (ماء محلى بالسكر)",
 "かんろに": "مُبَلْوَر, مُسَكَّر ((خَاصَّةً عَنِ الفَوَاكِه) مَحْفُوظ بِتَغْلِيفِه بِالسُّكَّر أَوْ تَشَرُّبِه إِيَّاه) / مُسَكَّر, مُغَلَّف بِالسُّكَّر (مُغَطّى بطبقة من السكر أو الشراب المركز)",
 "かんわ": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة / رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "かんわいりょう": "رِعَايَة تَلْطِيفِيَّة",
 "かんわざ": "مُعْجِزَة, أُعْجُوبَة",
 "かんわざい": "مُلَطِّف, مُخَفِّف",
 "かんわじかん": "وقت الاسترخاء (ثابت الزمن لعودة النظام الأسية إلى التوازن بعد حدوث اضطراب)",
 "かんわほう": "طريقة الاسترخاء (طريقة لحل المعادلات الآنية عن طريق تخمين حل ثم تقليل الأخطاء الناتجة عن طريق التقريبات المتتالية)",
 "かんわケア": "رِعَايَة تَلْطِيفِيَّة",
 "かんをおおう": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "かんドック": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "かんパン": "مفرقعة حفلات (هدية حفلات تتكون من لفافة ورقية (تحتوي عادة على حلوى أو هدية صغيرة) تنفجر عند سحبها من كلا الطرفين) / مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك) / بسكويت مملح, رقاقة مقرمشة (رقاقة رقيقة مقرمشة مصنوعة من الدقيق والماء مع أو بدون تخمير ودهن؛ غير محلاة أو شبه محلاة) / كراكر, مخترق خبيث (مبرمج يخترق الحواسيب (وصول غير مصرح به)، عادة للقيام بأمور خبيثة)\nمثال: غالباً ما يطلق على الكراكرز اسم هاكرز عن طريق الخطأ",
 "かん口令": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "かん味": "مُلُوْحَة",
 "かん夫": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "かん子": "جفت, ملقط جراحي (أداة استخراج تتكون من زوج من الكماشات تستخدم في العلاج الطبي (خاصة لتوليد الأطفال))",
 "かん木": "شُجَيْرَة, شَجَرَة",
 "かん水": "رش, نثر (فعل رش أو طرطشة الماء) / رش الماء (فعل رش الماء في المعمودية (نادر)) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / رشات, قلة متناثرة (عدد صغير (من شيء ما) مبعثر بشكل عشوائي)\nمثال: أولى علامات الاخضرار المتناثرة",
 "かん状": "قَضِيبِيُّ الشَّكْلِ (يشبه القضيب أو العصا في شكله) / عُصَيِّيّ الشَّكْل, قَضِيبِيّ (على شكل العُصَيَّة أو القضيب)",
 "かん養": "تَهْذِيب",
 "かん高い": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "かッ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "かトンボ": "ذبابة الكركي, طيثارة (ذباب نحيل طويل الأرجل يشبه البعوض الكبير ولكنه لا يلدغ) / فاصولياء خضراء خيطية (فاصولياء خضراء ذات خيوط يجب إزالتها)",
 "かマンガンさんえん": "برمنغنات (ملح أرجواني غامق لحمض البرمنغنيك؛ يستخدم في المحلول المائي كمطهر ومعقم)",
 "かマンガンさんカリウム": "برمنغنات البوتاسيوم (ملح سام يشكل بلورات أرجوانية داكنة ويكون لونه أحمر أرجواني عند ذوبانه في الماء؛ يستخدم كعامل مؤكسد ومبيض وكمطهر ومعقم)",
 "かーかー": "غُرَاب, زَاغ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "かーちゃん": "أُمّ, مَامَا (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟ / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "か弱い": "ضَعِيف",
 "か文字": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "か条": "بَنْد",
 "か流": "دُوَّامَة",
 "か焼": "تكليس (تحويل المعادن إلى أكاسيدها نتيجة للتسخين إلى درجة حرارة عالية)",
 "か細い": "رَفِيع, رَقِيق / ضعيف, ضعيفة / دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف) / رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / دَقِيقٌ, رَقِيقٌ (بالغ الدقة والرهافة في التطوير)\nمثال: مقطع كمان رقيق",
 "が": "عُثَّة / صُورَة, تَصْوِير / صُورَة, صُورَة شَمْسِيَّة / صُورَة / اِنْطِبَاع, سُمْعَة / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال. / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / عِنَاد / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَنَاقَة / تَهْنِئَة / وَاسِطَة, وَسِيلَة",
 "があがあ": "زَبْط / بِصَوْت عَالٍ",
 "があたろ": "كَبَا",
 "があん": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "がい": "ضبط النفس (سمة التحكم الحازم في سلوك المرء) / عناد (التمسك الحازم بأفكار أو رغبات المرء) / جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / شَارِع, زَنَقَة / السَّابِقُ ذِكْرُهُ / تَسَبَّب / نَتِيجَة / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / معدن (فِي : مركب صُلْب، يتكون طبيعياً من خلال عمليات جيولوجية؛ فِي : ما يستخرج من باطن الأَرْض كالحَدِيد والرَّصَاص والذَّهَب والمُجَوْهَرَات)\nمثال: هذا السلم مصنوع من المعدن / استلقاء (وضع الاستلقاء (كما في السرير))",
 "がいあく": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "がいい": "رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى) / حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد. / أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما)",
 "がいいん": "فَرْج, حِرّ",
 "がいいんえん": "التهاب الفرج (التهاب الفرج)",
 "がいいんし": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "がいいんせい": "خارجي المنشأ (مشتق أو ناشئ خارجياً)",
 "がいいんぶ": "فَرْج, حِرّ",
 "がいうちゅう": "فَضَاء خَارِجِيّ (فَضَاء)\nمثال: الفضاء مليئ بالغموض.",
 "がいえん": "تَمْدِيد / حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / حافة الهاوية, شفا (حافة مكان شديد الانحدار) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء",
 "がいおんどうぶつ": "ذوات الدم البارد, كائن متغير الحرارة (حيوان تتغير درجة حرارة جسمه مع درجة حرارة محيطه؛ أي حيوان باستثناء الطيور والثدييات)",
 "がいか": "اِنْتِصَار, نَصْر / سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق. / حُقّة (فاكهة لنباتات مثل لسان الحمل؛ كبسولة يسقط جزؤها العلوي عند إطلاق البذور) / إبراز, تجسيد خارجي (التجسيد في شكل خارجي) / إسقاط خارجي, تخريج (العزو إلى أسباب خارجية)",
 "がいかい": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "がいかく": "زاوية خارجية (مكملة الزاوية الداخلية لمضلع) / لَخَّصَ, اِخْتَصَرَ / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة.",
 "がいかつ": "خُلَاصَة, مُلَخَّص",
 "がいかひ": "إِيكُوكَارْب, القِشْرَةُ الخَارِجِيَّة (الطبقة الخارجية القصوى لغلاف الثمرة، مثل قشرة الخوخ أو العنب)",
 "がいかん": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / لَخَّصَ, اِخْتَصَرَ / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "がいかんざい": "خِيَانَة",
 "がいき": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "がいきゅう": "كُرَة الْقَدَم الْأَمْرِيكِيَّة, الكُرة الأَمْرِيكِيّة / حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "がいきょう": "استطلاع, ترقب (فعل النظر للخارج أو الترقب) / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "がいく": "طَابُوقَة / مَدِينَة, قَرْيَة",
 "がいけい": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "がいけいてき": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "がいけいどうみゃく": "شريان سباتي ظاهر (فرع الشريان السباتي الذي يغذي الوجه واللسان والأجزاء الخارجية من الرأس بالدم)",
 "がいけん": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "がいけんじょう": "إِلَى الخَارِج (نحو الخارج) / ظاهري, مادي (يتعلق بالواقع المادي بدلاً من الأفكار أو العقل) / مُتَّجِه إِلَى الخَارِج, مُغَادِر (ذاهب أو مُتّجه إلى الخارج أو مُغادر)\nمثال: حرك الإبرة أكثر للخارج!",
 "がいげん": "خُلَاصَة, مُلَخَّص",
 "がいこ": "حَمَاة",
 "がいこう": "دِبْلُومَاسِيَّة / بَيْع, بُيُوع / مَهَارَة البَيْع, مَهَارَات البَيْع / انبساط ((علم النفس) طبع منبسط؛ الاهتمام بما هو خارج الذات)",
 "がいこういん": "جامع الأصوات (شخص يأخذ أو يعد الأصوات) / منظم استطلاعات الرأي (شخص يجري دراسات استقصائية للرأي العام) / فاحص الأصوات (شخص يفحص الأصوات في الانتخابات) / جامع تبرعات, مستجدي (ملتمس يطلب مساهمات أو تجارة أو أصوات)\nمثال: منظم الاستطلاعات يجري استطلاعات الرأي العام",
 "がいこうか": "دِبْلُومَاسِيّ, دِبْلُومَاسِيَّة",
 "がいこうかん": "دِبْلُومَاسِيّ, دِبْلُومَاسِيَّة",
 "がいこうこうしょう": "دبلوماسية, مفاوضات دبلوماسية (تفاوض بين الدول)",
 "がいこうこうのう": "حقيبة دبلوماسية (حقيبة بريد مغلقة بإحكام تُستخدم لنقل المراسلات بين البعثة الدبلوماسية ومكتبها الرئيسي)",
 "がいこうしせつ": "دِبْلُومَاسِيّ, دِبْلُومَاسِيَّة",
 "がいこうしせつだん": "بعثة دبلوماسية (بعثة تخدم أهدافاً وغايات دبلوماسية)",
 "がいこうじゅつ": "دِبْلُومَاسِيَّة",
 "がいこうじょう": "دِبْلُومَاسِيّ",
 "がいこうせい": "انبساط ((علم النفس) طبع منبسط؛ الاهتمام بما هو خارج الذات)",
 "がいこうせいさく": "سياسة خارجية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "がいこうだん": "الخدمة الدبلوماسية, سلك دبلوماسي (هيئة الموظفين الدبلوماسيين)",
 "がいこうてき": "دِبْلُومَاسِيّ / منبسط, اِنْبِسَاطِيّ (نَبَاتٌ مُنْبَسِطٌ : مُنْتَشِرٌ؛ مُنْبَسِطٌ عَلَى بَطْنِهِ: مُمْتَدٌّ)",
 "がいこうとっけん": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين الدبلوماسيين في بلد أجنبي)",
 "がいこうどうぶつ": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "がいこうはんばいいん": "مندوب مبيعات متجول (بائع يسافر لزيارة العملاء)",
 "がいこうふういんぶくろ": "حقيبة دبلوماسية (حقيبة بريد مغلقة بإحكام تُستخدم لنقل المراسلات بين البعثة الدبلوماسية ومكتبها الرئيسي)",
 "がいこうカード": "وَرَقَة تَفَاوُض, وَرَقَة مُسَاوَمَة (نفوذ في شكل إغراء أو تنازل مفيد في المفاوضات الناجحة)",
 "がいこきゅう": "تنفس, تهوية (العملية الجسدية للشهيق والزفير؛ عملية أخذ الأكسجين من الهواء المستنشق وإطلاق ثاني أكسيد الكربون عن طريق الزفير)",
 "がいこく": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "がいこくかわせ": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "がいこくご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "がいこくごしどうじょしゅ": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "がいこくさん": "أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ",
 "がいこくしせつ": "بعثة أجنبية, مفوضية (بعثة دبلوماسية دائمة يرأسها وزير مفوض) / إرسالية, مهمة تبشيرية (منظمة من المبشرين في أرض أجنبية أرسلت للقيام بعمل ديني)",
 "がいこくじん": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "がいこくじんきしゃ": "مراسل أجنبي (صحفي يرسل تقارير إخبارية وتعليقات من دولة أجنبية للنشر أو البث)",
 "がいこくじんきょうふしょう": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "がいこくじんけんお": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "がいこくじんはいせき": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "がいこくぜい": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "がいこくちょくせつとうし": "استثمار أجنبي مباشر (مشروع مشترك بين شركة أجنبية وشركة أمريكية) / استثمار أجنبي مباشر (الاستثمار في الأعمال التجارية من قبل مواطنين أجانب (يتضمن غالباً ملكية الأسهم في العمل التجاري))",
 "がいこくのかた": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "がいこくぶたい": "عبر البحار, في الخارج (في مكان عبر المحيط) / في الخارج, وراء البحار (ما وراء أو عبر البحر) / فِي الخَارِج, وَرَاءَ البِحَار (فِي بَلَدٍ أَجْنَبِيٍّ) / عَبْر البِحَار, مَا وَرَاء البَحْر (يكون أو يمرّ عبر البحر)\nمثال: عاش في الخارج لسنوات عديدة",
 "がいこっかく": "هَيْكَل خَارِجِيّ",
 "がいこつ": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "がいこん": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "がいこんせい": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "がいご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "がいごう": "اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "がいさい": "خيشوم خارجي (يحدث في بعض الرخويات وفي الضفادع الصغيرة وغيرها من البرمائيات غير الناضجة)",
 "がいさん": "تَقْرِيب\nمثال: この国の人口は概算５千万に達する。 — يبلغ عدد سكان البلد حوالي خمسين مليون نسمة.",
 "がいし": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة) / دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "がいして": "عُمُومًا / بِوَجْهٍ عَامّ",
 "がいしていえば": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "がいしゃ": "عجلة التجديف (عجلة كبيرة مزودة بمجاذيف وتدار بواسطة محرك لدفع القارب) / ضَحِيَّة / أُضْحِيَّة",
 "がいしゃし": "حول خارجي, حول وحشي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الخارج)",
 "がいしゃせん": "باخرة ببدالات (سفينة بخارية تدار بواسطة عجلات بدالات)",
 "がいしゅう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "がいしゅういっしょく": "بِسُهُولَة",
 "がいしゅっけつ": "نَزِيف, نَزْف",
 "がいしゅつ": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "がいしゅつきんし": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "がいしゅつきんしれい": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "がいしゅつぎ": "ملابس خروج (ملابس عادية مناسبة للظهور العام (بخلاف الأزياء التنكرية أو الملابس الرياضية أو ملابس العمل وما إلى ذلك))",
 "がいしゅつぎらい": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "がいしゅつさき": "وِجْهَة, وُجْهَة",
 "がいしゅひ": "غلاف البذرة, قصرة (الطبقة الخارجية الواقية لبذور النباتات الزهرية)",
 "がいしょう": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / صَدْمَةٌ عَاطِفِيَّة\nمثال: تعرض زيري لإصابة. / وَزِير الْخَارِجِيَّة / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "がいしょうごストレスしょうがい": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "がいしょうせい": "صَادِمٌ نَفْسِيًّا (مُؤْلِمٌ مِنَ النَّاحِيَةِ النَّفْسِيَّة) / رضي, صدمي (من أو يتعلق بإصابة جسدية أو جرح للجسم)",
 "がいしょうせいてんかん": "صرع رضي, صرع ما بعد الصدمة (حالة صرع تشنجية ناجمة عن إصابة في الرأس)",
 "がいしん": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "がいじ": "أذن خارجية (جزء الأذن المرئي خارجياً) / وِزَارَةُ الْخَارِجِيَّة / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي) / رَضِيع",
 "がいじえん": "التهاب الأذن الخارجية (التهاب الأذن الخارجية (بما في ذلك الصيوان وقناة الأذن))",
 "がいじつリズム": "إيقاع يومي, ساعة بيولوجية (دورة نشاط يومية تلاحظ في العديد من الكائنات الحية)",
 "がいじどう": "قَنَاة سَمْعِيَّة, صِمَاخ",
 "がいじゅう": "آفة (أي حشرة أو حيوان غير مرغوب فيه ومدمر يهاجم الطعام أو المحاصيل أو الماشية) / ثقيل الظل, لحوح (شخص يسبب الإزعاج والمضايقة باستمرار) / طاعون, وباء (أي مرض وبائي ذو معدل وفيات مرتفع) / طاعون (عدوى خطيرة (قاتلة أحيانًا) للقوارض تسببها اليرسينيا الطاعونية وتنتقل عن طريق الخطأ إلى البشر عن طريق لدغة برغوث قام بلدغ حيوان مصاب)\nمثال: رش الحديقة للتخلص من الآفات",
 "がいじょ": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "がいじん": "أَجْنَبِيّ, أَجْنَبِيَّة / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز) / صَحْن (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "がいじんきしゃ": "مراسل أجنبي (صحفي يرسل تقارير إخبارية وتعليقات من دولة أجنبية للنشر أو البث)",
 "がいじんぶたい": "فيلق أجنبي (وحدة عسكرية تتكون من متطوعين أجانب يخدمون الدولة)",
 "がいす": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "がいする": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز) / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "がいせい": "سياسة خارجية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة. / خارجي المنشأ (مشتق أو ناشئ خارجياً) / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "がいせいてき": "خارجي المنشأ (مشتق أو ناشئ خارجياً)",
 "がいせき": "جداء اتجاهي, ضرب اتجاهي (متجه هو نتاج متجهين آخرين)",
 "がいせつ": "تحجيم, تحديد (فعل وضع حدود حول شيء ما) / عرض شامل, نظرة عامة (ملخص عام لموضوع ما)\nمثال: قدم أمين الصندوق نظرة عامة موجزة عن العواقب المالية / مُلَاءَمَة, مُوَافَقَة (صفة كون الشيء مناسباً بشكل خاص) / صوابية, ملاءمة (السلوك المناسب؛ فعل الشيء الصحيح)",
 "がいせんしゃ": "شاحنة دعاية صوتية (شاحنة مجهزة بمكبر صوت وتستخدم للإعلان)",
 "がいせんもん": "قوس النصر (قوس تذكاري ضخم؛ يُبنى عادة لإحياء ذكرى انتصار بارز)",
 "がいぜん": "ساخط, ساخطة / ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً / مَذْهُول",
 "がいぜんせい": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "がいぜんてき": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه) / محتمل, مرجح (مرجح ولكن ليس مؤكداً أن يكون حقيقياً أو واقعياً) / مرشح مرجح (متقدم من المرجح أن يتم اختياره)\nمثال: نتيجة محتملة",
 "がいぜんりつ": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "がいそう": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى. / خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي / استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة) / إقحام خارجي, استقراء ((رياضيات) حساب قيمة دالة خارج نطاق القيم المعروفة)",
 "がいそく": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي",
 "がいそくこう": "التلم الجانبي, شق سيلفيوس (أعمق وأبرز الشقوق القشرية؛ يفصل الفصوص الجبهية عن الفصوص الصدغية في كلا نصفي الكرة المخية)",
 "がいため": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "がいたん": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / كُولَا",
 "がいだんこうご": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "がいちゅう": "آفة (أي حشرة أو حيوان غير مرغوب فيه ومدمر يهاجم الطعام أو المحاصيل أو الماشية) / ثقيل الظل, لحوح (شخص يسبب الإزعاج والمضايقة باستمرار) / طاعون, وباء (أي مرض وبائي ذو معدل وفيات مرتفع) / طاعون (عدوى خطيرة (قاتلة أحيانًا) للقوارض تسببها اليرسينيا الطاعونية وتنتقل عن طريق الخطأ إلى البشر عن طريق لدغة برغوث قام بلدغ حيوان مصاب)\nمثال: رش الحديقة للتخلص من الآفات",
 "がいちゅうさき": "مقاول",
 "がいちょう": "خَشَاش, هَامَّة",
 "がいちょうどう": "قَنَاة سَمْعِيَّة, صِمَاخ",
