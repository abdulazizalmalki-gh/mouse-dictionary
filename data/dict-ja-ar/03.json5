 "かも知れない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れぬ": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れません": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れん": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知んない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも肉": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة…)\nمثال: إني أصوب على تلك البطة.",
 "かや": "نَامُوسِيَّة",
 "かやかや": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / بِصَوْت عَالٍ",
 "かやく": "بَهَار, تَوَابِل / مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / بَارُود / قابل للاختزال, قابل للتبسيط (قادر على أن يتم اختزاله)\nمثال: قابل للاختزال إلى مجموعة من مبادئ الطبيعة البشرية",
 "かやくいれ": "قرن البارود (حاوية لحمل البارود؛ مصنوعة من قرن حيوان مجوف)",
 "かやくいんぼうじけん": "مؤامرة البارود (مؤامرة في عام 1605 في إنجلترا لتفجير الملك جيمس الأول ومجلسي البرلمان للانتقام…)",
 "かやくこ": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ / برميل بارود (برميل (عادة من المعدن) للبارود أو مسحوق التفجير)",
 "かやつりぐさ": "خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية)",
 "かやねずみ": "فأر الحصاد (فأر أوراسي صغير بني محمر يعيش في حقول الذرة مثلاً)",
 "かやば": "حقل قش, مرج (قطعة أرض مغطاة أو مغطاة في الغالب بالعشب؛ حقل يُزرع فيه العشب أو البرسيم ليصنع…)",
 "かやぶき": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かやぶきやね": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かやぶき屋根": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かゆ": "إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم)",
 "かゆい": "مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة)",
 "かゆいかゆい": "خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان / حكة, هرش (إحساس جلدي مزعج يولد الرغبة في الحك) / جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "かゆみ": "حِكَّة",
 "かよい": "تنقل للعمل (سفر المتنقل للعمل) / دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "かよいじ": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "かよいちょう": "دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "かよいぶね": "مُعَدِّيَة, عَبَّارَة",
 "かよう": "قابل للذوبان ((للمادة) قادر على الذوبان في مذيب ما (عادة الماء))\nمثال: اللغز قابل للحل / مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع. / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية. / الثُّلَاثَاء, الثَّلَاثَاء\nمثال: 火曜の朝までにすべて終えなければならないのです。 — يجب علينا إنهاء كل شيء قبل صباح الثلاثاء. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي. / شَبِهَ / مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / ورقة زهرية (ورقة معدلة تكون جزءاً من الزهرة)",
 "かようせい": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل) / تَوَفُّر",
 "かようそさん": "حمض البيريوديك (أي حمض لليود يحتوي على الأكسجين)",
 "かようなしだいで": "هَكَذَا, كَذَا",
 "かような次第で": "هَكَذَا, كَذَا",
 "かようび": "الثُّلَاثَاء, الثَّلَاثَاء",
 "かようへん": "فَتِيل",
 "かよく": "إيثار, سخاء (التصرف بكرم وسخاء)\nمثال: يظهر سكان الريف تفانياً ونكراناً للذات أكثر من أبناء عمومتهم في المناطق الحضرية",
 "かよわい": "ضَعِيف",
 "から": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / لِأَنَّ / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة. / بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً)\nمثال: رفض مغريات العالم الباطلة / بِلَا عِبْء, خَفِيفُ الحِمْل (غير مُثقَل بحمل مادّي)\nمثال: غير مثقل بنظرية شاملة / خزي, عار (الافتقار إلى الشرف أو النزاهة)\nمثال: استسلم لحياة العار / جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)\nمثال: أين صندوق البريد؟ / قصبة الريشة (العمود الفقري المجوف للريشة) / مِقْبَض / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم.",
 "からあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "からい": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / مَالِح / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / أَلِيم, مُؤْلِم\nمثال: 彼女は多くの辛い思いを経験してきた。 — لقد واجهَت الكثير من الصعوبات. / برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "からいうと": "بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ",
 "からいえば": "بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ",
 "からいって": "بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ",
 "からいばり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "からいも": "بَطَاطَا حُلْوَة",
 "からうす": "مِلَاط",
 "からうめ": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "からうり": "بيع على المكشوف (بيع الأوراق المالية أو العقود الآجلة للسلع التي لا يملكها البائع (على أمل…)",
 "からえずき": "تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى)\nمثال: نوبة سيئة من التهوع",
 "からおけ": "كَارَيُوكِي",
