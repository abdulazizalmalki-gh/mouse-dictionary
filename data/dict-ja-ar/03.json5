 "かぜひかる": "شَبِيهٌ بِالنَّابِض, نَابِضِيّ (يُشبه النابض أو حركته)",
 "かぜひく": "أُصِيبَ بِبَرْدٍ",
 "かぜむき": "حَالَة, وَضْع / مَزَاج",
 "かぜよけ": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "かぜをとおす": "هَوَّى",
 "かぜをひく": "أُصِيبَ بِبَرْدٍ",
 "かぜん": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد",
 "かぜ症候群": "زُكَام",
 "かぜ薬": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "かそ": "قَابِلٌ لِلتَّشْكِيل, لَدْن (قابل للقولبة أو التشكيل (خاصة التراب أو الطين أو مادّة ليّنة أخرى)) / انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق)) / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "かそう": "خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / بَذْلَة, بَدْلَة / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / حرق الجثث (ترميد جثة الميت) / كَمَالِيّ\nمثال: علي مساعدة ماري.",
 "かそううん": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "かそうか": "بِيئَة اِفْتِرَاضِيَّة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة.",
 "かそうかいきゅう": "بْرُولِيتَارِيَا",
 "かそうきおく": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول…)",
 "かそうきおくそうち": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول…)",
 "かそうきおくシステム": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول…)",
 "かそうけん": "مَسْرَح جَرِيمَة",
 "かそうげんじつ": "وَاقِع اِفْتِرَاضِيّ (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "かそうげんじつかん": "وَاقِع اِفْتِرَاضِيّ (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "かそうしゃかい": "سِجِّين, عَالَم سُفْلِيّ",
 "かそうつうか": "عُمْلَة مُعَمَّاة, مُشَفَّرَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "かそうつうかこうかんじょ": "عملة رقمية (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "かそうてき": "خَيَالِيّ",
 "かそうど": "تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "かそうば": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد)",
 "かそうぶとうかい": "زي حفلة تنكرية (زي يُرتدى للتنكر في حفلة تنكرية)",
 "かそうみ": "عَرَافَة",
 "かそうメモリ": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول…)",
 "かそうメモリー": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول…)",
 "かそか": "انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق))",
 "かそく": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة…)\nمثال: تسارع السائق بسيارته. / قدم كاذبة (نتوء مؤقت تستخدمه بعض الكائنات الحية الدقيقة كعضو للتغذية أو الحركة)",
 "かそくき": "مُسَرِّع",
 "かそくそうち": "مُسَرِّع / مُعَجِّل جُسَيْمَات",
 "かそくど": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة…)\nمثال: تسارع السائق بسيارته.",
 "かそくどけい": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "かそくどてき": "مُسَرَّع, مُكَثَّف (تَمَّ تَسْرِيعُه، كَمَا فِي دَوْرَة أَكَادِيمِيَّة مُكَثَّفَة)",
 "かそくどびょう": "دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "かそくどセンサ": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "かそくどセンサー": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "かそけき": "إِغْمَاء",
 "かそけし": "إِغْمَاء",
 "かそこら": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "かそざい": "مادة ملدنة, ملدن (مادة تضاف إلى البلاستيك أو المواد الأخرى لجعلها أكثر مرونة)",
 "かそせい": "طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله…)",
 "かそぶっしつ": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة…)\nمثال: لدي قبعه من البلاستيك .",
 "かそぶつ": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة…)\nمثال: لدي قبعه من البلاستيك .",
 "かぞ": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "かぞいろ": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "かぞいろは": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "かぞう": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا.",
 "かぞえあげる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "かぞえきれない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かぞえたてる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "かぞえちがえる": "خطأ في العد (عد غير دقيق)",
 "かぞえる": "عَدَّ",
 "かぞく": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل:…)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "かぞくおん": "تحت المهيمنة ((موسيقى) النغمة الرابعة في السلم الدياتوني)",
 "かぞくかんけい": "عَلَاقَة أُسَرِيَّة, قَرَابَة ((الأنثروبولوجيا) الارتباط أو الاتصال عن طريق الدم أو الزواج أو التبني)",
 "かぞくけいかく": "تحديد النسل, تنظيم الأسرة (الحد من عدد الأطفال المولودين)",
 "かぞくせい": "أُسْرِيّ, عَائِلِيّ",
 "かぞくせいど": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل:…)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "かぞくたいざい": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "かぞくもち": "رجل عائلة (رجل تعتبر عائلته ذات أهمية كبرى في حياته)",
 "かぞくりょうほう": "علاج أسري (أي من الأساليب العلاجية المتعددة التي يتم فيها علاج الأسرة ككل)",
 "かぞくれき": "تاريخ العائلة, سجل العائلة الطبي (جزء من التاريخ الطبي للمريض تُطرح فيه أسئلة لمحاولة معرفة ما إذا كان لدى المريض…)",
 "かた": "إفراط في التدليل (التدليل المفرط)\nمثال: أفسد الطفل بسبب الإفراط في التدليل / بُحَيْرة شاطِئَة, لَاجُون (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة. / ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر…) / أرض المد (أرض بالقرب من البحر يغمرها المد) / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / قَالِب\nمثال: هم في نفس السن. / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب. / مُؤْتَمَر\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / كَتِف, كِتْف\nمثال: 肩が痛い。 — لدي ألم في أكتافي. / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة. / غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه)\nمثال: سرد غير مكتمل لحياته / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / أُقْنُوم / جَانِب / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "かたあげがとれる": "بَلَغَ رُشْدَهُ",
 "かたあげもとれる": "بَلَغَ رُشْدَهُ",
 "かたあげをおろす": "بَلَغَ رُشْدَهُ",
 "かたあて": "واقي كتف (ملابس واقية تتكون من وسادة صلبة مستديرة يرتديها لاعبو كرة القدم لحماية أكتافهم)",
 "かたあぶら": "مَرْهَم, بُومَادَة",
 "かたい": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب. / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / سَائِل / صَعْب / عُرْقُوب / جذام, مرض هانسن (مرض حبيبي مزمن وسار يحدث في المناطق الاستوائية وشبه الاستوائية؛ يتميز بعقيدات…)",
 "かたいき": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "かたいじ": "عِنَاد",
 "かたいっぽう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "かたいなか": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "かたいれ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "かたうで": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "かたうらみ": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "かたおし": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "かたおち": "قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "かたおもい": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "かたかい": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل…)",
 "かたかけ": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير…)",
 "かたかけかばん": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "かたかけカバン": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "かたかげ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "かたかた": "قَعْقَعَ",
 "かたかな": "كَاتَاكَانَا (ٱلْأَحْرُفَ ٱلْمُشَابِهَةَ لِلْهِيرَاغَانَا، ٱلَّتِي تُسْتَخْدَمُ لِكِتَابَةِ…)",
 "かたかんせつ": "كتف, مفصل الكتف (مفصل كروي بين رأس عظم العضد وتجويف لوح الكتف)",
 "かたがい": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل…)",
 "かたがき": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "かたがこる": "جِدِّيّ\nمثال: 彼女は肩が凝る本を読む気にはなれなかった。 — لم تكن في المزاج المناسب للكتب الجادة.",
 "かたがた": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَلَى فِكْرَة (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "かたがつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "かたがみ": "رَوْسَم",
 "かたがわり": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "かたき": "مُنَافِس / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر. / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / صُعُوبَة",
 "かたきうち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "かたきやく": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "かたきをとる": "اِنْتَقَمَ",
 "かたき討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "かたぎ": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / نَزِيه, صَادِق / خشب صلب (خشب الأشجار عريضة الأوراق ثنائية الفلقة (بالمقارنة مع خشب الصنوبريات))",
 "かたぎりスイッチ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたく": "ذَرِيعَة, عُذْر / مأوى, مسكن (سكن يعيش فيه شخص ما)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة / حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها)",
 "かたくけい": "كوي (اللغة الدرافيدية التي يتحدث بها شعب كوي في جنوب شرق الهند)",
 "かたくしんにゅうざい": "انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن)",
 "かたくそうさくれいじょう": "إذن تفتيش, مذكرة تفتيش (مذكرة تخول مسؤولي إنفاذ القانون بالبحث عن أشياء أو أشخاص متورطين في ارتكاب…)",
 "かたくな": "مُتَعَنِّت, عَنِيد",
 "かたくない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かたくむじょう": "زَائِل, غَيْرُ دَائِم (مَوْجُودٌ أَوْ بَاقٍ لِفَتْرَةٍ مَحْدُودَةٍ فَقَطْ)\nمثال: السياسة عامل غير دائم في الحياة",
 "かたくり": "بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "かたくるしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたぐ": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "かたぐち": "يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "かたぐるしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたげっけい": "غزارة الطمث, نزيف رحمي (حيض غزير أو طويل بشكل غير طبيعي؛ يمكن أن يكون عرضًا لأورام الرحم ويمكن أن يؤدي…)",
 "かたげる": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد)\nمثال: كان للبرج ميل واضح",
 "かたこ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي / بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "かたこい": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "かたこと": "بَقَّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر…)\nمثال: قد غزا بق الفراش فرنسا. / طقطقة (سلسلة من النقرات)",
 "かたさ": "ثَبَات",
 "かたさき": "كَتِف, كِتْف",
 "かたし": "صَعْب / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "かたしき": "نَمُوذَج",
 "かたしろ": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "かたじけない": "مُمْتَنّ, شَاكِر",
 "かたじけなくも": "بكياسة, بلطف (بطريقة لطيفة أو رشيقة)",
 "かたじるし": "رتبة كتف, علامة الكتف (كَتَّافات تشير إلى الرتبة)",
 "かたじん": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "かたす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور. / مُنَظَّم, نَظِيف",
 "かたすかし": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / خَيْبَة أَمَل",
 "かたすかしをくわせる": "تفادي, مراوغة (حركة مراوغة سريعة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "かたすくに": "سِجِّين, عَالَم سُفْلِيّ",
 "かたすみ": "زَاوِيَة, رُكْن",
 "かたずつう": "شَقِيقَة, صُدَاع نِصْفِي (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق…)\nمثال: هي أختي غير الشقيقة.",
 "かたたち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "かたち": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / مَلَامِح, سِحْنَة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / تصرف, سلوك (طريقة التصرف أو التحكم بالنفس)\nمثال: يمكن دراسة سلوك الجسيمات الصغيرة في التجارب",
 "かたちづくる": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "かたちばかり": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا.",
 "かたちんば": "أَعْرَج / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم)",
 "かたっくるしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたっと": "قَعْقَعَ",
 "かたっぱしから": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "かたっぽ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "かたっぽう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "かたつけ": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة) / إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "かたづけ": "إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "かたづける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته. / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "かたておち": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "かたてま": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات)",
 "かたてわざ": "أُحَادِيُّ اليَد (يستخدم يداً واحدة أو مُصمَّم لها)",
 "かたでかぜをきる": "تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة)",
 "かたとき": "لَحْظَة",
 "かたどおり": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたどる": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "かたな": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "かたなかじ": "سَيَّاف, سَلَّال",
 "かたにかつぐ": "دُبّ",
 "かたにはめる": "صُورَة نَمَطِيَّة",
 "かたぬき": "قطاعة البسكويت (أداة مطبخ تستخدم لقطع ورقة من عجين البسكويت إلى الأشكال المطلوبة قبل الخبز)",
 "かたのちからをぬく": "اِسْتَرْخَى",
 "かたはしから": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "かたはだぬぐ": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "かたはらいたい": "سَخِيف, مَسْخَرَة",
 "かたばかり": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا.",
 "かたばら": "بريسكت, لحم الصدر (قطعة لحم من الصدر أو أسفل الصدر خاصة في البقر)",
 "かたひも": "حمالة, شريط الكتف (شريط يمر فوق الكتف ويدعم ملابس أو حقيبة)",
 "かたびら": "كفن",
 "かたぶく": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "かたぶつ": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "かたほ": "بَلَغَ / ناقص-غير كامل / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "かたほう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "かたほうこうそうごどうさ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたほうこうつうしん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたほとり": "زَاوِيَة, رُكْن",
 "かたぼうえき": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "かたぼうかつぎ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَبِيب, حَبِيبَة",
 "かたまえ": "أحادي الصدر ((عن الملابس) يغلق بتداخل ضيق ويُثبت بصف واحد من الأزرار)\nمثال: سترة أحادية الصدر",
 "かたまひ": "شلل نصفي (شلل جانب واحد من الجسم)",
 "かたまり": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / تَجَسَّد",
 "かたまる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَجَمَّدَ",
 "かたみ": "تذكار (شيء يذكر بأحداث الماضي) / كَتِف, كِتْف / شرف, عفة (فضيلة المرأة أو عفتها)\nمثال: رجل شريف",
 "かたみがひろい": "فَخُور",
 "かたみち": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみちきっぷ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみちこうくうけん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみちりょうきん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみに": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "かたみのせまい": "خَجْلَان, خَجُول",
 "かたむ": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / زَنَى (مَارَسَ الزِّنَى)",
 "かたむき": "مُنْحَدَر / مَيْل, نَزَعَة",
 "かたむく": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "かたむける": "منحدر (سطح مائل يربط بين مستويين)\nمثال: تسلق المنحدر الشديد / خَرَاب, خَرَابَة / شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "かたむすび": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع) / عقدة منزلقة (عقدة في نهاية حبل يمكن أن تنزلق على الحبل الذي صنعت حوله)",
 "かため": "تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً))\nمثال: تصلب الخرسانة / تَعَهَّدَ\nمثال: لا أستطيع ضمان أي شيء. / دِفَاع, حِمَايَة",
 "かためがね": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "かためる": "تَجَمَّدَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / هَدَأَ\nمثال: استقر زيري في خيمته. / قَوَّى",
 "かたもじ": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر)",
 "かたもち": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط) / إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة)",
 "かたもちばり": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "かたや": "من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة",
 "かたやき": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "かたやぶり": "غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي",
 "かたゆで": "مَسْلُوقٌ تَمَامًا ((عَنِ البَيْض) مَسْلُوقٌ حَتَّى تَمَاسُكِ الصَّفَار)",
 "かたゆでたまご": "بيض مسلوق جيداً (بيضة مغلية برفق حتى يتصلب البياض والصفار)",
 "かたよったかんがえ": "إِجْحَاف, تَحَامُل",
 "かたより": "إِنْحِرَاف / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات)",
 "かたよる": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال.",
 "かたらい": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص)",
 "かたらう": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "かたり": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / حِكَايَة / مَوْضُوع, مَوَاضِيع / غَشَّ, جَدَعَ",
 "かたりかける": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "かたりく": "قِصَّة, حِكَايَة",
 "かたりぐさ": "قِصَّة, حِكَايَة",
 "かたりて": "رَاوٍ, رَاوِيَة",
 "かたりべ": "قَصَّاص, قَصَّاصَة",
 "かたりもの": "سَرْدِي",
 "かたりんそうこう": "تَزَلُّج",
 "かたる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة…) / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه. / اِفْتَرَضَ",
 "かたわ": "أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ) / ناقص-غير كامل",
 "かたわく": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب)",
 "かたわら": "جَانِب / مُدَّة\nمثال: جون في عمر أخي.",
 "かたわらに": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية)\nمثال: هي تعمل في مكان قريب",
 "かたわれ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / شَرِيك فِي جَرِيمَة / نَظِير",
 "かたわれづき": "هِلَال",
 "かたをいれる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "かたをかす": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "かたをつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "かたをもつ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "かたん": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "かたんしゃ": "شَرِيك فِي جَرِيمَة",
 "かたんせい": "طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله…)",
 "かたバラ": "بريسكت, لحم الصدر (قطعة لحم من الصدر أو أسفل الصدر خاصة في البقر)",
 "かたパン": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً)",
 "かた焼": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "かた焼き": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "かだい": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / تَمْرِين / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / مُفْرِط, زَائِد",
 "かだいきょく": "قطعة ديكور مستقلة (قطعة من المناظر تهدف إلى الوقوف بمفردها كجزء من إعداد المسرح)",
 "かだいし": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً)",
 "かだいじょうみゃく": "وريد أجوف سفلي (يتلقى الدم من الأطراف السفلية وأعضاء البطن ويصب في الجزء الخلفي من الأذين…)",
 "かだいひょうか": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً)",
 "かだむ": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / زَنَى (مَارَسَ الزِّنَى)",
 "かだやし": "سمكة البعوض (سمكة فضية ذات صفوف من البقع السوداء تعيش في أمريكا الشمالية الاستوائية وجزر…)",
 "かだん": "حاسم, حاسمة / سرير سفلي, مضجع سفلي (السرير السفلي من بين سريرين (أحدهما فوق الآخر)) / حوض زهور (حوض تنمو فيه الزهور)",
 "かち": "قِيمَة / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال. / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / مُتَجَسِّد\nمثال: مشي توم مع ماري.",
 "かちあう": "تَصَادُم / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "かちあがる": "يقرب",
 "かちある": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه…)\nمثال: إعطي قيمة لذاتك.",
 "かちいくさ": "اِنْتِصَار, نَصْر / مُشَاة, بِيَادَة",
 "かちうま": "فَائِز, فَائِزَة",
 "かちえる": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ…)\nمثال: و أخيرا حقق هدفه.",
 "かちかち": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "かちかん": "قيم, مبادئ (معتقدات شخص أو مجموعة اجتماعية لديهم استثمار عاطفي فيها (سواء مع أو ضد شيء ما))\nمثال: لديه قيم محافظة للغاية",
 "かちき": "إرَادَة",
 "かちく": "حيوان أليف, حيوان داجن (أي من الحيوانات المختلفة التي تم ترويضها وجعلها مناسبة للبيئة البشرية)",
 "かちくか": "اِسْتِئْنَاس (استأنس الحيوان:صار أليفاَ،ذهبت عنه وحشيّته ، استأنس الزّائر:استأذن،استأنس إلى…)\nمثال: هل يمكن استئناس ابن آوى؟",
 "かちくかこい": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "かちくしけんじょう": "حيوان أليف, حيوان داجن (أي من الحيوانات المختلفة التي تم ترويضها وجعلها مناسبة للبيئة البشرية)",
 "かちくしゃ": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً)",
 "かちぐみ": "فَائِز, فَائِزَة",
 "かちこち": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "かちこみ": "مُدَاهَمَة",
 "かちたかい": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه…)\nمثال: إعطي قيمة لذاتك.",
 "かちっと": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "かちてん": "مَفْصِل, مِفْتَاح",
 "かちとる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "かちど": "مَاشٍ",
 "かちぬき": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز)",
 "かちぬきせん": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز)",
 "かちはんだん": "حكم قيمي (تقييم يكشف عن قيم الشخص الذي يقوم بالتقييم أكثر مما يكشف عن واقع ما يتم تقييمه)",
 "かちびと": "مَاشٍ",
 "かちほこる": "نصر (نصر بمعنى: أعان، نصره الله: أعانه)\nمثال: هذا النصر هو نصركم.",
 "かちぼし": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "かちむし": "يَعْسُوب",
 "かちめ": "فُرْصَة",
 "かちゃかちゃ": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما…)",
 "かちゃり": "رنين, طنطنة (صوت معدني واضح خفيف كما لجرس صغير)",
 "かちゅう": "دردور, دوامة مائية (تيار دائري قوي من الماء (عادة نتيجة لتعارض المد والجزر)) / فَضِيحَة / جَمِيع أَنْحَاء, كُلّ / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ…) / احتراق, حرق (عملية حرق شيء ما)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة / أَرِسْتُقْرَاطِيَّة / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب.",
 "かちゅうおん": "تحت الوسطى ((موسيقى) النغمة السادسة في سلم كبير أو صغير (أو الثالثة تحت نغمة الأساس))",
 "かちょう": "مسموع / بَطْرِيَرْك, بَطْرَك / ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية) / نَامُوسِيَّة",
 "かちょうかんまくどうみゃく": "شريان مساريقي سفلي (ينشأ بالقرب من النهاية السفلية للأبهر ويغذي الأمعاء الغليظة)",
 "かちょうきん": "تُهْمَة\nمثال: أقوم بشحن هاتفي",
 "かちょうしゅうは": "تَرَدُّد صَوْتِيّ (تردد موجة صوتية مسموعة)",
