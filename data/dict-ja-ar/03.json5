 "からもん": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل…)",
 "からり": "بِإِتْقَان, تَمَامًا / بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح / بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك / تَمَامًا",
 "からん": "بَلَاء, بُؤْس",
 "からんからん": "قَعْقَعَ",
 "からんころん": "حَبَطَقْطَقْ",
 "からオケ": "كَارَيُوكِي",
 "からコン": "فَارِغ",
 "から下手": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "から元気": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية)",
 "から揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "から騒ぎ": "عَجِيج, ضَجِيج",
 "かり": "مُؤَقَّت\nمثال: 仮のブリッジをいれます。 — ستحتاج جسرًا مؤقتًا. / مُخْتَلَق / اِفْتِرَاضِيّ / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً / صَيْد / جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع / مُطَارَدَةُ السَّاحِرَاتِ / حَشَفَة",
 "かりあげ": "جني, حصاد (جمع المحصول الناضج)",
 "かりあげる": "أَجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة.",
 "かりあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かりいおのまつり": "الْعَرْش",
 "かりいぬ": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا…)\nمثال: كان الكلب ميتا.",
 "かりいれ": "حِصَاد\nمثال: حصد الفلاح القمح. / استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً",
 "かりいれきん": "قَرْض, إِعَارَة",
 "かりいれびと": "حَصَّاد",
 "かりいれる": "حِصَاد\nمثال: حصد الفلاح القمح. / اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "かりうけにん": "مُسْتَعِير, مُسْتَعِيرَة",
 "かりうける": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "かりうど": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "かりかえ": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة)",
 "かりかえる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "かりかし": "قَرْض, إِعَارَة",
 "かりかた": "مَدِين",
 "かりかぶ": "شُعَيْرَات اللِّحْيَة",
 "かりかぶけん": "شهادة مؤقتة, عملة بديلة (شهادة يعترف بقيمتها الدافع والمدفوع له؛ ليست عملة ولكن قد تكون قابلة للتحويل…)",
 "かりかり": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / بِتَجَهُّم, بِحِدَّة (بطريقة سيئة المزاج)\nمثال: نظرت إلى زوجها بحدة / خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان / دلو رفع (دلو حديدي يستخدم للرفع في الآبار أو المناجم)",
 "かりかんじょう": "حساب معلق (حساب يستخدم مؤقتاً لحمل الإيصالات والمدفوعات المشكوك فيها أو التناقضات بانتظار…)",
 "かりがね": "مُرْتَفِع الدَّرَجَة",
 "かりがねぼね": "عظم الكتف, لوح الكتف (أي من عظمين مثلثين مسطحين يقعان على كل جانب من جانبي الكتف في البشر)",
 "かりきにゅう": "حساب معلق (حساب يستخدم مؤقتاً لحمل الإيصالات والمدفوعات المشكوك فيها أو التناقضات بانتظار…)",
 "かりきり": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かりきる": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かりくび": "إِكْلِيل حَشَفَة الْقَضِيب / عنق الإوزة (شيء ذو شكل منحني رفيع (مثل عنق الإوزة)) / حَشَفَة",
 "かりくら": "منطقة صيد (منطقة يتم فيها صيد الطرائد)",
 "かりこ": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب)",
 "かりこし": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "かりこしきん": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "かりこみ": "حَلَاقَة / تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة)\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "かりこむ": "أَجَاص / حِصَاد\nمثال: حصد الفلاح القمح. / اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "かりごしらえ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "かりごや": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / كوخ الصيد (منزل صغير (ريفي) يستخدم كمأوى مؤقت)",
 "かりしゃくほうしゃ": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة)",
 "かりしゅっしょ": "إفراج مشروط ((قانون) إفراج مشروط عن السجن يخول الشخص قضاء ما تبقى من العقوبة خارج السجن…)\nمثال: نسي كلمة السر (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)",
 "かりしゅっしょしゃ": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة)",
 "かりしゅつごく": "إفراج مشروط ((قانون) إفراج مشروط عن السجن يخول الشخص قضاء ما تبقى من العقوبة خارج السجن…)\nمثال: نسي كلمة السر (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)",
 "かりしょぶん": "أمر قضائي مؤقت, أمر وقتي (أمر قضائي يصدر أثناء المحاكمة للحفاظ على الوضع الراهن أو الحفاظ على موضوع…)",
 "かりそめ": "مُؤَقَّت / تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "かりそめにする": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "かりそめにも": "أبداً / بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "かりそろえる": "مَحْصُول",
 "かりたて": "مَحْشُوش حَدِيثًا, مَقْصُوص تَوًّا (تم حشه أو قصه مؤخرًا)",
 "かりたてる": "طَرَدَ / قَادَ, سَاقَ",
 "かりだす": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "かりちん": "أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة.",
 "かりっと": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح",
 "かりて": "جزازة العشب (أداة حديقة لجز العشب في المروج) / مُسْتَعِير, مُسْتَعِيرَة / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "かりとじほん": "كُتَيِّب, كُرَّاسَة (كِتَاب صَغِير؛ دَلِيل) / كُرَّاسَة, كُتَيِّب",
 "かりとり": "جني, حصاد (جمع المحصول الناضج)",
 "かりとる": "جَزَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ…)\nمثال: طلبت من توم جز عشبنا.",
 "かりな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "かりに": "اِفْتَرَضَ / مُؤَقَّتًا",
 "かりにげ": "فرار, هروب (فعل المغادرة (بدون إذن) للمكان الذي من المتوقع أن تكون فيه)",
 "かりにも": "أبداً, بتاتاً (بأدنى درجة أو بأي حال من الأحوال)\nمثال: هل أنت مهتم على الإطلاق؟ لا، على الإطلاق / بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "かりにゅうぶ": "فترة اختبار, فترة تجريبية (فترة زمنية يتم خلالها اختبار شخص أو شيء ما)",
 "かりにん": "مُسْتَعِير, مُسْتَعِيرَة",
 "かりぬい": "سقي اللحم (ترطيب الشواء أثناء طهيه)",
 "かりぬし": "مُسْتَعِير, مُسْتَعِيرَة / مُسْتَأْجِر",
 "かりね": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / شُعَيْرَات اللِّحْيَة",
 "かりのおや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "かりのさしとめ": "أمر قضائي مؤقت, أمر وقتي (أمر قضائي يصدر أثناء المحاكمة للحفاظ على الوضع الراهن أو الحفاظ على موضوع…)",
 "かりのたより": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かりのつかい": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かりのな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "かりのふみ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かりはらい": "عُشْبَة ضَارَّة",
 "かりば": "منطقة صيد (منطقة يتم فيها صيد الطرائد)",
 "かりぱく": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりぱち": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりひきすう": "وَسِيط, بَارَامِتِر\nمثال: هي أصبحت معلمة.",
 "かりびと": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "かりふく": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かりまくら": "تَقَيَّلَ, أَخَذَ قَيْلُولَة",
 "かりも": "إكس, مِحْوَر (عمود تدور عليه العجلة)",
 "かりゅう": "دُوَّامَة / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / الطَّبَقَاتُ الدُّنْيَا / بَرْكَنَ, فَلْكَنَ / حبيبة (حبة صغيرة جداً) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة) / جَدْوَل / تنين, تنين أوروبي (مخلوق من الأساطير التيوتونية؛ يصور عادة وهو ينفث النار وله جسم زاحف وأحيانًا…) / لب (الجزء الداخلي الرخو للسن)\nمثال: سحقه حتى أصبح لباً / تُوت, حَبَّة",
 "かりゅうかい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "かりゅうがい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "かりゅうきゅう": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "かりゅうきゅうげんしょうしょう": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "かりゅうざい": "حبيبة (حبة صغيرة جداً)",
 "かりゅうしゃかい": "الطَّبَقَاتُ الدُّنْيَا",
 "かりゅうじょう": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية))",
 "かりゅうせい": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية))",
 "かりゅうそう": "طبقة حبيبية (طبقة البشرة الواقعة تحت الطبقة المتقرنة مباشرة؛ تحتوي على خلايا (ذات حبيبات…)",
 "かりゅうど": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "かりゅうはっけっきゅう": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "かりゅうびょう": "دَاء مَنْقُول جِنْسِيًّا",
 "かりゅうほう": "فلكنة (عملية معالجة المطاط أو المواد الشبيهة بالمطاط بالكبريت عند حرارة عالية لتحسين…)",
 "かりゆし": "سَعِيد\nمثال: فرح فاضل كثيرا.",
 "かりょう": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة) / غَرَامَة / جُرْعَة زَائِدَة / تنين, تنين أوروبي (مخلوق من الأساطير التيوتونية؛ يصور عادة وهو ينفث النار وله جسم زاحف وأحيانًا…) / عِلَاج كِيمِيَائِيّ",
 "かりょく": "قوة نيرانية ((عسكرياً) القدرة النسبية على إطلاق النار على هدف ما)",
 "かりる": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا. / أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "かりわく": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب) / سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "かりん": "بادوك بورما, خشب الورد البورمي (شجرة من الهند وبورما تنتج خشباً يشبه الماهوجني) / سفرجل مزهر, سفرجل ياباني (شجيرة زينة آسيوية ذات فروع شائكة وأزهار وردية أو حمراء) / سَفَرْجَل",
 "かりんせん": "باخرة ببدالات (سفينة بخارية تدار بواسطة عجلات بدالات)",
 "かりパク": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりパチ": "طُفَيْلِيّ, مُتَطَفِّل (شخص يحاول الحصول على أشياء مجانية من الآخرين)",
 "かりパラメータ": "وَسِيط, بَارَامِتِر\nمثال: هي أصبحت معلمة.",
 "かりマスト": "صاري مؤقت (صاري مؤقت لاستبدال صاري مكسور)",
 "かり集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かる": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا. / أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة. / اِصْطَادَ, صَادَ / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かるい": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح / طَفِيف\nمثال: 私は軽く肩を触れられるのを感じた。 — لقد شعرت بلمسة خفيفة على كتفي. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かるいきもち": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "かるいし": "حجر الخفاف, خفاف (زجاج خفيف يتكون على سطح بعض الحمم البركانية؛ يستخدم كمادة كاشطة)",
 "かるがる": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب)\nمثال: أخذ الأمر باستخفاف",
 "かるがるしい": "طَفْح, طَفْح جِلْدِيّ",
 "かるくち": "ثَرْثَار",
 "かるさ": "خِفَّة",
 "かるた箱": "وَرَقَة لَعْب, وَرَقَة",
 "かるはずみ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "かるめ": "خِفَّة",
 "かるやか": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "かるやき": "رُقَاقَة",
 "かるら": "غارودا (كائن خارق يشبه النسر يخدم كمطية لفيشنو)",
 "かるわざ": "بِهْلَوَانِيَّات",
 "かるわざし": "بَهْلَوَان",
 "かれ": "هُوَ / خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "かれい": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح / جَمَال, زَيْن / شَيْخُوخَة, هَرَم / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / فلاوندر أيمن العين (فلاوندر تقع كلتا عينيه على الجانب الأيمن من الرأس) / أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "かれいおうはんへんせい": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "かれいおうはんへんせいしょう": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "かれいしゅう": "عجوز, كبير السن (شخص متقدم في السن)",
 "かれいせい": "مُرْتَبِطٌ بِالْعُمْرِ (يتغير (زيادة أو نقصاناً) مع تقدم عمر الفرد)",
 "かれいせいはくないしょう": "مُرْتَبِطٌ بِالْعُمْرِ (يتغير (زيادة أو نقصاناً) مع تقدم عمر الفرد)",
 "かれいなる": "رَائِع, عَظِيم\nمثال: الصين بلد عظيم.",
 "かれがれ": "مَبْحُوح / ذَابِل, مُتَجَعِّد (نَحِيل وَمُتَجَعِّد بِسَبَب الانْكِمَاش مِنَ الشَّيْخُوخَة أَوِ المَرَض) / مُحَمَّص (مُحَمَّصٌ أَوْ مَشْوِيٌّ قَلِيلًا) / مُتَنَافِر, مُنْفَصِل (أصبح غير محبوب بسبب الجفاء والبعد)",
 "かれがわ": "مُسْتَنْزَف الْمَاء, نَاضِب (نضب ماؤه واستُنزف)",
 "かれくさ": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "かれこれ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "かれし": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة. / هُوَ",
 "かれじしん": "نَفْسَهُ",
 "かれつ": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ)…)",
 "かれはいろ": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "かれはざい": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "かれぴ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "かれぴっぴ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "かれら": "هُمَا\nمثال: هن يحببن الجاز.",
 "かれる": "صَعَقَ / نَاضِج, رَاشِد / نَفِدَ",
 "かれん": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية…)\nمثال: الكعكة حلوة جدا / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "かれピ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "かれピッピ": "خَلِيل, رَفِيق\nمثال: ليس لديه صديقة.",
 "かれ草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "かろ": "فرن (حجرة مغلقة يتم فيها إنتاج الحرارة لتدفئة المباني، أو تدمير النفايات، أو صهر…) / رَشْوَة, رِشْوَة\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "かろい": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح / طَفِيف\nمثال: 私は軽く肩を触れられるのを感じた。 — لقد شعرت بلمسة خفيفة على كتفي. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かろう": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "かろうじて": "بِٱلْكَاد",
 "かろがろ": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب)\nمثال: أخذ الأمر باستخفاف",
 "かろがろしい": "طَفْح, طَفْح جِلْدِيّ",
 "かろしめる": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "かろはずみ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "かろやか": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "かろんじる": "تَرَفَّعَ",
 "かろんずる": "اِحْتَقَرَ, أَهَانَ",
 "かわ": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة / نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ…)\nمثال: عبر جوناس النهر. / هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال. / قشرة (الغطاء الخارجي الطبيعي للطعام (يزال عادة قبل الأكل))\nمثال: 私は林檎の皮をむくことができる。 — أستطيع تقشير تفاحة. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / جَانِب / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه)",
 "かわあいさ": "بلقشة شائعة (البلقشة الشائعة في أوروبا وأمريكا الشمالية)",
 "かわい": "فَاتِن, قَشِيب",
 "かわいい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق)",
 "かわいいこちゃん": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد)",
 "かわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود) / عَذَاب",
 "かわいがる": "لَاطَفَ, رَبَتَ / عَذَاب",
 "かわいげ": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "かわいこちゃん": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد)",
 "かわいそう": "فَقِير",
 "かわいた": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما. / عارضة طولية, وتر (عارضة خشبية أفقية طويلة لربط القوائم)\nمثال: ناظم الخرز",
 "かわいらしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً)",
 "かわいるか": "دلفين نهري (أي من عدة دلافين طويلة الخطم تعيش عادة في المياه العذبة في أمريكا الجنوبية…)",
 "かわいーい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق)",
 "かわい子ちゃん": "حبيب, عزيز (شخص محبوب؛ تستخدم ككلمات تودد)",
 "かわうお": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "かわうおりょうり": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "かわうそ": "قُضَاعَة\nمثال: أردى الصياد الثعلب.",
 "かわえー": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق)",
 "かわかす": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما.",
 "かわかぶり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "かわかます": "بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على…)",
 "かわかみ": "ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار)",
 "かわかむり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "かわき": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل…)\nمثال: لا أشعر بالعطش. / تَوْق, تَشَوُّق / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما.",
 "かわきゆき": "ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق…)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "かわきり": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "かわぎし": "ضفة النهر",
 "かわぎぬ": "معطف فرو (معطف مصنوع من الفرو)",
 "かわく": "اِشْتَهَى",
 "かわぐち": "مَصَبّ, فُغْرَة",
 "かわげた": "عارضة طولية, وتر (عارضة خشبية أفقية طويلة لربط القوائم)\nمثال: ناظم الخرز",
 "かわげら": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات…)",
 "かわこうば": "مدبغة (مكان عمل يتم فيه دباغة الجلود)",
 "かわごろも": "معطف فرو (معطف مصنوع من الفرو)",
 "かわさき": "كَاوَاسَاكِي",
 "かわさきびょう": "داء كاواساكي (مرض حاد يصيب الأطفال الصغار يتميز بطفح جلدي وتضخم الغدد الليمفاوية والحمى)",
 "かわざいく": "مصنوعات جلدية (عمل مصنوع من الجلد)",
 "かわざかな": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "かわしあう": "تَبْدِيل, تَبَادُل",
 "かわしき": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "かわしも": "مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "かわす": "تَبْدِيل, تَبَادُل / تَقَاطَعَ / تفادي, مراوغة (حركة مراوغة سريعة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "かわず": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر.",
 "かわずとび": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "かわせ": "سَرِيع",
 "かわせい": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "かわせかいにゅう": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "かわせさそんえき": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "かわせそうさ": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "かわせそうば": "سِعْر صَرْف (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو…)\nمثال: إتفقوا على سعر.",
 "かわせそうばメカニズム": "سِعْر صَرْف (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو…)\nمثال: إتفقوا على سعر.",
 "かわせてがた": "حوالة مالية, سفتجة (وثيقة تأمر بدفع المال؛ يسحبها شخص أو بنك على آخر)",
 "かわせへいか": "قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة…)",
 "かわせみ": "سَلْدَج",
 "かわせレート": "سِعْر صَرْف (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو…)\nمثال: إتفقوا على سعر.",
 "かわぞい": "ضفة النهر",
 "かわぞこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "かわた": "إِتَا",
 "かわたけ": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق…) / دَاعِرَة, بَغِيَّة",
 "かわたれどき": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "かわたれ時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
