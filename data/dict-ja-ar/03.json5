 "がいこくごしどうじょしゅ": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "がいこくさん": "أَجْنَبِيّ",
 "がいこくしせつ": "بعثة أجنبية, مفوضية (بعثة دبلوماسية دائمة يرأسها وزير مفوض)",
 "がいこくじん": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "がいこくじんきしゃ": "مراسل أجنبي (صحفي يرسل تقارير إخبارية وتعليقات من دولة أجنبية للنشر أو البث)",
 "がいこくじんきょうふしょう": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "がいこくじんけんお": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "がいこくじんはいせき": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "がいこくぜい": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "がいこくちょくせつとうし": "استثمار أجنبي مباشر (مشروع مشترك بين شركة أجنبية وشركة أمريكية)",
 "がいこくのかた": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "がいこくぶたい": "عبر البحار, في الخارج (في مكان عبر المحيط)\nمثال: عاش في الخارج لسنوات عديدة",
 "がいこっかく": "هَيْكَل خَارِجِيّ",
 "がいこつ": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "がいこん": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو…)",
 "がいこんせい": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو…)",
 "がいご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "がいごう": "اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "がいさい": "خيشوم خارجي (يحدث في بعض الرخويات وفي الضفادع الصغيرة وغيرها من البرمائيات غير الناضجة)",
 "がいさん": "تَقْرِيب\nمثال: この国の人口は概算５千万に達する。 — يبلغ عدد سكان البلد حوالي خمسين مليون نسمة.",
 "がいし": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة) / دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "がいして": "عُمُومًا",
 "がいしていえば": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "がいしゃ": "عجلة التجديف (عجلة كبيرة مزودة بمجاذيف وتدار بواسطة محرك لدفع القارب) / ضَحِيَّة",
 "がいしゃし": "حول خارجي, حول وحشي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الخارج)",
 "がいしゃせん": "باخرة ببدالات (سفينة بخارية تدار بواسطة عجلات بدالات)",
 "がいしゅう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "がいしゅういっしょく": "بِسُهُولَة",
 "がいしゅっけつ": "نَزِيف, نَزْف",
 "がいしゅつ": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "がいしゅつきんし": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "がいしゅつきんしれい": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "がいしゅつぎ": "ملابس خروج (ملابس عادية مناسبة للظهور العام (بخلاف الأزياء التنكرية أو الملابس الرياضية أو…)",
 "がいしゅつぎらい": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "がいしゅつさき": "وِجْهَة, وُجْهَة",
 "がいしゅひ": "غلاف البذرة, قصرة (الطبقة الخارجية الواقية لبذور النباتات الزهرية)",
 "がいしょう": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة. / وَزِير الْخَارِجِيَّة / دَاعِرَة, بَغِيَّة",
 "がいしょうごストレスしょうがい": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "がいしょうせい": "صَادِمٌ نَفْسِيًّا (مُؤْلِمٌ مِنَ النَّاحِيَةِ النَّفْسِيَّة)",
 "がいしょうせいてんかん": "صرع رضي, صرع ما بعد الصدمة (حالة صرع تشنجية ناجمة عن إصابة في الرأس)",
 "がいしん": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على…)\nمثال: احس سامي بالحقد.",
 "がいじ": "أذن خارجية (جزء الأذن المرئي خارجياً) / وِزَارَةُ الْخَارِجِيَّة / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي) / رَضِيع",
 "がいじえん": "التهاب الأذن الخارجية (التهاب الأذن الخارجية (بما في ذلك الصيوان وقناة الأذن))",
 "がいじか": "وِزَارَةُ الْخَارِجِيَّة",
 "がいじつリズム": "إيقاع يومي, ساعة بيولوجية (دورة نشاط يومية تلاحظ في العديد من الكائنات الحية)",
 "がいじつリズムすいみんかくせいしょうがい": "إيقاع يومي, ساعة بيولوجية (دورة نشاط يومية تلاحظ في العديد من الكائنات الحية)",
 "がいじつリズムすいみんしょうがい": "إيقاع يومي, ساعة بيولوجية (دورة نشاط يومية تلاحظ في العديد من الكائنات الحية)",
 "がいじどう": "قَنَاة سَمْعِيَّة, صِمَاخ",
 "がいじゅう": "آفة (أي حشرة أو حيوان غير مرغوب فيه ومدمر يهاجم الطعام أو المحاصيل أو الماشية)\nمثال: رش الحديقة للتخلص من الآفات",
 "がいじょ": "تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "がいじん": "أَجْنَبِيّ, أَجْنَبِيَّة / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / صَحْن (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "がいじんきしゃ": "مراسل أجنبي (صحفي يرسل تقارير إخبارية وتعليقات من دولة أجنبية للنشر أو البث)",
 "がいじんぶたい": "فيلق أجنبي (وحدة عسكرية تتكون من متطوعين أجانب يخدمون الدولة)",
 "がいす": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا. / عَاقَ, عَرْقَلَ",
 "がいする": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا. / عَاقَ, عَرْقَلَ / نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "がいせい": "سياسة خارجية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة. / خارجي المنشأ (مشتق أو ناشئ خارجياً) / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "がいせいてき": "خارجي المنشأ (مشتق أو ناشئ خارجياً)",
 "がいせき": "جداء اتجاهي, ضرب اتجاهي (متجه هو نتاج متجهين آخرين)",
 "がいせつ": "تحجيم, تحديد (فعل وضع حدود حول شيء ما) / عرض شامل, نظرة عامة (ملخص عام لموضوع ما)\nمثال: قدم أمين الصندوق نظرة عامة موجزة عن العواقب المالية / مُلَاءَمَة, مُوَافَقَة (صفة كون الشيء مناسباً بشكل خاص)",
 "がいせん": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "がいせんうよく": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين…)",
 "がいせんしゃ": "شاحنة دعاية صوتية (شاحنة مجهزة بمكبر صوت وتستخدم للإعلان)",
 "がいせんもん": "قوس النصر (قوس تذكاري ضخم؛ يُبنى عادة لإحياء ذكرى انتصار بارز)",
 "がいぜん": "ساخط, ساخطة / ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً / مَذْهُول",
 "がいぜんせい": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "がいぜんてき": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه)\nمثال: نتيجة محتملة",
 "がいぜんりつ": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "がいそう": "كَحَّ, سَعَلَ\nمثال: سعل زيري مرة أخرى. / خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى)\nمثال: مشهد خارجي / استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة)",
 "がいそく": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى)\nمثال: مشهد خارجي",
 "がいそくこう": "التلم الجانبي, شق سيلفيوس (أعمق وأبرز الشقوق القشرية؛ يفصل الفصوص الجبهية عن الفصوص الصدغية في كلا نصفي…)",
 "がいため": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "がいためほう": "سوق صرف العملات (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "がいたん": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / كُولَا",
 "がいだんこうご": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "がいちゅう": "آفة (أي حشرة أو حيوان غير مرغوب فيه ومدمر يهاجم الطعام أو المحاصيل أو الماشية)\nمثال: رش الحديقة للتخلص من الآفات",
 "がいちゅうさき": "مقاول",
 "がいちょう": "خَشَاش, هَامَّة",
 "がいちょうどう": "قَنَاة سَمْعِيَّة, صِمَاخ",
 "がいてき": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "がいてん": "أبوكريفا, الأسفار المنحولة (كتب من العهد القديم مضمنة في الفولجاتا ولكنها محذوفة في النسخ اليهودية…) / اِخْتِطَاف",
 "がいてんきん": "عضلة مبعدة (عضلة تسحب جزءاً من الجسم بعيداً عن الخط الناصف)",
 "がいてんしんけい": "عصب قحفي سادس, عصب مبعد (عصب حركي صغير يغذي العضلة المستقيمة الوحشية للعين)",
 "がいでん": "نَادِرَة\nمثال: هي مدرسة لطيفة.",
 "がいとう": "شَارِع, زَنَقَة / مِعْطَف",
 "がいとうしゃ": "طَرَف",
 "がいとうせんでん": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "がいとうなし": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "がいとうまく": "وِشَاح",
 "がいとうアンケート": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "がいとうインタビュー": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "がいどく": "ضَرَرٌ",
 "がいどくそ": "ذيفان خارجي (ذيفان تفرزه الكائنات الدقيقة في الوسط المحيط)",
 "がいにゅう": "بيريسبرم, محيط السويداء (النسيج المغذي خارج الكيس المحتوي على الجنين في بعض البذور)",
 "がいねん": "مَفْهُوم, تَصَوُّر",
 "がいねんか": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا)",
 "がいねんず": "رسم تخطيطي, مخطط هيكلي (مخطط لنظام كهربائي أو ميكانيكي)",
 "がいねんてき": "عَامّ",
 "がいねんろん": "مفاهيمية (المذهب القائل بأن تطبيق مصطلح عام على أشياء مختلفة يشير إلى وجود كيان عقلي…)",
 "がいのない": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "がいはいよう": "أديم ظاهر, الأرومة الظاهرة (الطبقة المنتشة الخارجية التي تتطور لتشكل الجلد والأنسجة العصبية)",
