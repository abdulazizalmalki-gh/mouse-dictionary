 "がってんし": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "がってんしょうちのすけ": "فَهِمْتَ, فَهِمْتِ",
 "がってんだ": "مَفْهُوم",
 "がってん承知の助": "فَهِمْتَ, فَهِمْتِ",
 "がってん承知之助": "فَهِمْتَ, فَهِمْتِ",
 "がっぴ": "تَمْرَة, تَمْر\nمثال: ما تاريخ اليوم؟ / خِفِي, خِيفِي (اختفى أو صار غير مرئي؛ أصبح سريًا أو مجهولًا)\nمثال: كانت لدى سامي حياة خفية.",
 "がっぷり": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "がっぺい": "اِنْدِمَاج",
 "がっぺいしゅうごう": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى…)\nمثال: عاش الاتحاد السوفيتي!",
 "がっぺいしょう": "تَعْقِيد",
 "がっぽう": "اِنْدِمَاج",
 "がっぽうどり": "وَقْوَاق, وَقْوَاقِيَّة",
 "がっぽがっぽ": "بِالجُمْلَة (على نطاق واسع دون تمييز دقيق)\nمثال: أشتري الطعام بالجملة",
 "がっぽり": "بِالجُمْلَة (على نطاق واسع دون تمييز دقيق)\nمثال: أشتري الطعام بالجملة",
 "がつ": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر…)\nمثال: رمضان شهر حرام.",
 "がつがつ": "بجوع, بنهم (بأسلوب شخص جائع جداً)\nمثال: انقض على الطعام بنهم / بِجَشَع, بِطَمَع (بطريقة جشعة)",
 "がつりん": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "がつん": "حَادِث إِصْطِدَام\nمثال: يوشك الجسر على الانهيار. / بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "がてら": "مُدَّة\nمثال: جون في عمر أخي.",
 "がてん": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا. / معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "がてんがいく": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "がてんがゆく": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "がなりたてる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "がなり立てる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "がなる": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "がにまた": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ)",
 "がに股": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ)",
 "がのつよい": "عَنِيد",
 "がはく": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ)\nمثال: إنه رسام مشهور.",
 "がはと": "فَجْأَةً",
 "がば": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)",
 "がばい": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)",
 "がばがば": "أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه) / بشكل كبير / فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة)",
