 "けいようしかん": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "けいようしてき": "وَصْفِيّ, نَعْتِيّ",
 "けいら": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "けいらく": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "けいり": "جَلَّاد",
 "けいりく": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "けいりゃく": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "けいりゅう": "بِرْكَة, سَبْخَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "けいりょう": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "けいりょうき": "مِقْيَاس / وَزْن / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "けいりょうカップ": "كُوب قِيَاس (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "けいりん": "حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "けいるい": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "けいれい": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "けいれき": "خلفية",
 "けいれつ": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "けいれつてき": "مُمَثِّل, مُمَثِّلَة",
 "けいれん": "اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "けいろ": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "けいろせんたく": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "けいわく": "الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت.",
 "けい線": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / مُخَطَّط بَيَانِيّ / مُخَطَط / إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "けう": "نَادِر",
 "けか": "تَوْبَة",
 "けが": "جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "けがき": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "けがす": "تُرْبَة, أَرْض / اِتَّسَخَ\nمثال: その本を汚さないように扱ってくれるなら、貸してあげるよ。 — يمكنك استعارة هذا الكتاب بشرط أن تبقيه نظيفاً. / عَار, خِزْي",
 "けがらわしい": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "けがり": "جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "けがれ": "عَار, خِزْي",
 "けがれのない": "صَافٍ, اَلصَّافِي",
 "けがれをしらない": "بَرِيء, بَرِيئَة / بَرِيء",
 "けがわ": "فَرْو / مِعْطَف, ثَوْبٌ مُفَرًّى / فَرَّى",
 "けがをした": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / أَلِمَ, وَجِعَ (الوَجَع)\nمثال: ذلك سيهيج الجرح.",
 "けぎらい": "مشاعر مناهضة",
 "けくず": "قَطِيع / تَهَافَتَ, تَقَاطَرَ / مِزْقَة",
 "けげん": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "けご": "دُودَة اَلْقَزّ",
 "けさがた": "هٰذَا الصَّبَاح",
 "けし": "خَشْخَاش الْأَفْيُون",
 "けしいん": "خَتْم بَرِيدِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "けしかける": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "けしき": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "けしこみ": "صُلْح, مُصَالَحَة",
 "けしごむ": "مِمْحَاة",
 "けしさる": "تَخَلَّصَ ؛ مِن",
 "けしずみ": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "けしつぶ": "خشخاش بَذْرَة",
 "けして": "يَوْمًا",
 "けしとめる": "أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "けしのみ": "خشخاش بَذْرَة",
 "けしの実": "خشخاش بَذْرَة",
 "けしょう": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "けしょうぎ": "رُوب, ثَوْب نَوْم (مصدر للفعل رَابَ؛ اللبن المروب وهو ما يُخَضُّ ويخرج زبده كالرائب)\nمثال: أخبرني روب بالخبر السعيد.",
 "けしょうしたじ": "كِتَاب تَمْهِيدِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "けしょうしつ": "مِرْحَاض, تواليت",
 "けしょうだい": "مِزْيَنَة, مِنْضَدَة زِينَة",
 "けしょうだち": "شَذَّبَ, قَلَّمَ",
 "けしょうなおし": "تَجْدِيد, إِحْيَاء",
 "けしょうのもの": "شَبَح, شَبْح",
 "けしょうばり": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "けしょうひん": "مُسْتَحْضَرَاتُ التَّجْمِيل",
 "けしょうべや": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "けしょうりょう": "مَهْر",
 "けしん": "الحُلُول / التَّجَسُّد, التَّأَنُّس / أَفَاتَار",
 "けしゴム": "مِمْحَاة",
 "けじめ": "تَمْيِيْز / كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك. / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "けじめをつける": "مَيَّزَ",
 "けじめを付ける": "مَيَّزَ",
 "けす": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى / أَطْفَأَ / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / اِتَّسَعَ, اِحْتَوَى / اِمْتَصَ, تَشَرَّبَ / اِحْتَلَّ, شَغَلَ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / اِسْتَنْفَدَ / اِسْتَوْعَبَ, وَعَى / دَفَعَ, تَحَمَّلَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "けすじ": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "けずり": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "けずりかす": "بُرَادَة",
 "けずりだす": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "けずる": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / قَلَّلَ / حَذَفَ (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
