 "かねごと": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "かねざし": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "かねじゃく": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "かねずかいのあらい": "مُسْرِف",
 "かねたたき": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / قارع الأجراس (شخص يعزف على الأجراس اليدوية الموسيقية) / قارع الأجراس (شخص يقرع أجراس الكنيسة (مثل دعوة المصلين))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "かねつ": "تَدْفِئَة / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "かねつき": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / قارع الأجراس (شخص يعزف على الأجراس اليدوية الموسيقية) / قارع الأجراس (شخص يقرع أجراس الكنيسة (مثل دعوة المصلين))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً / مِدْفَأَة",
 "かねつきどう": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "かねつぎみ": "مُحْتَرّ بِإِفْرَاط (سُخِّن فوق الحدّ الآمن أو المطلوب)",
 "かねつしょり": "تَدْفِئَة",
 "かねづかい": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "かねて": "قَبْلًا, قَبْل",
 "かねてから": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "かねてより": "قَبْلًا, قَبْل",
 "かねどぶ": "هدر المال (المال الذي ينفق مقابل عائد غير كاف)\nمثال: قال السناتور إن المشروع كان هدراً للمال",
 "かねにきたない": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "かねになる": "مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم",
 "かねのこぎり": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "かねのない": "مُفْلِس",
 "かねのなるき": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "かねのね": "جرس موسيقي, رنين (آلة إيقاعية تتكون من مجموعة من الأجراس المضبوطة التي تُضرب بمطرقة؛ تستخدم كآلة أوركسترالية)",
 "かねのむしん": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "かねばこ": "خزينة نقود, صندوق النقد (صندوق قوي لحفظ النقود)",
 "かねばなれ": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "かねばらい": "مُجْزٍ, مُدِرّ لِلرِّبْح (يُدرّ ربحًا معقولاً)",
 "かねびら": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "かねめ": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك. / تكلفة, سعر (خاصية امتلاك قيمة مادية (غالباً ما يشار إليها بمبلغ المال الذي سيجلبه الشيء إذا بيع))\nمثال: القيمة النقدية المتقلبة للذهب والفضة",
 "かねめのもの": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "かねもうけ": "كسب المال (فعل جني المال (وتراكم الثروة)) / مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا)",
 "かねもち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "かねん": "سَرِيع الاِشْتِعَال (سهل الاشتعال)",
 "かねんせい": "قابلية الاحتراق, قابلية الاشتعال (صفة القدرة على الاشتعال والاحتراق) / قَابِل لِلاِحْتِرَاق, قَابِل لِلاِشْتِعَال (قادر على الاشتعال والاحتراق) / مادة قابلة للاحتراق, مادة قابلة للاشتعال (مادة يمكن حرقها لتوفير الحرارة أو الطاقة)",
 "かねんぶつ": "قَابِل لِلاِحْتِرَاق, قَابِل لِلاِشْتِعَال (قادر على الاشتعال والاحتراق) / مادة قابلة للاحتراق, مادة قابلة للاشتعال (مادة يمكن حرقها لتوفير الحرارة أو الطاقة)",
 "かねノコ": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "かの": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "かのう": "صديد, قيح (منتج سائل للالتهاب) / تقيح, تكون الصديد ((طب) تكوّن مادة مرضية في خراج أو حويصلة وخروج القيح)\nمثال: 傷が化膿しました。 — تَكَوّنَ الصديد في الجرح. / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي. / مُمْكِن / دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "かのうきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "かのうせい": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل يتردد في النسبة بينهما، ويراد به الإمكان الذهني») / إِمْكَانِيَّة\nمثال: هناك احتمال أن لا ينجح. / كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة / مقيح, مولد للقيح (منتج للقيح)",
 "かのうせいがひくい": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "かのうせいのひくい": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "かのうどめ": "مُضَادّ حَيَوِيّ",
 "かのうなかぎり": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "かのうにする": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "かのうほう": "مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "かのきし": "اَلنِّرْفَانَا",
 "かのくうほどにもおもわぬ": "بِلَا قَلَق, مُطْمَئِنّ (خالٍ من الاضطراب والقلق) / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / غير مهموم, مرتاح البال (غير مثقل بالمتاعب أو الاضطراب أو الضيق)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "かのくに": "اَلنِّرْفَانَا",
 "かのこ": "أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان) / شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "かのこあみ": "بيكيه (قماش منسوج بإحكام مع أضلاع بارزة) / فورة غضب, هيجان (نوبة مفاجئة من الغضب)\nمثال: اشتعل غضبه كالحطب الجاف",
 "かのこまだら": "أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان)",
 "かのごとくに": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "かのしし": "لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / أَيِّل",
 "かのじょ": "هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا)\nمثال: هذه هي المسألة. / صَدِيقَة, صَاحِبَة (مؤنث الصديق؛ الصاحبة الخليلة) / صَدِيقَة (مؤنث الصديق؛ الصاحبة الخليلة)\nمثال: ليس لديه صديقة.",
 "かのじょじしん": "نَفْسُهَا",
 "かのじょら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "かのち": "هُنَاكَ",
 "かのなみだ": "أجر زهيد, مبلغ ضئيل (دفعة غير كافية)\nمثال: يعملون طوال اليوم مقابل مبلغ زهيد",
 "かのように": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "かの国": "اَلنِّرْفَانَا",
 "かの地": "هُنَاكَ",
 "かの如くに": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "かはい": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "かはく": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة. / كَبَا / نبرة هابطة, نقر قوي (النقر الأول في المقياس الموسيقي (مع حركة ذراع المايسترو للأسفل))",
 "かはつ": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "かはらい": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "かはん": "ضفة النهر / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "かはんがた": "مَحْمُول (اسم مفعول للفعل حَمَلَ)\nمثال: فقد حاسوبه المحمول.",
 "かはんしき": "مَحْمُول (اسم مفعول للفعل حَمَلَ)\nمثال: فقد حاسوبه المحمول.",
 "かはんすう": "غَالِبِيَّة, أَغْلَبِيّة",
 "かはんせい": "قَابِلِيَّة الحَمْل (صفة كون الشيء خفيفاً بما يكفي لحمله)",
 "かはんにん": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "かば": "فَرَس نَهْر (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان / بَتُولَا",
 "かばいたて": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばいだて": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばい立て": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばう": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "かばち": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "かばつ": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "かばと": "فَجْأَةً",
 "かばね": "جُثَّة, جُثْمَان / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر)",
 "かばのき": "بتولا, شجر القضبان (أي شجرة أو شجيرة من الفصيلة البتولية ذات لحاء رقيق مقشر)",
 "かばらい": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "かばん": "كِيس, چيس",
 "かばんご": "لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "かばんもち": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع)) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "かばん持ち": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع)) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "かばん語": "لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "かひ": "فتاة خادمة (فتاة تعمل كخادمة) / أدب, صواب (السلوك الصحيح أو المناسب) / جِدَارُ الثَّمَرَة, غِلافُ الثَّمَرَة (الجدران الناضجة والمتحورة لمبيض النبات) / هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات) / قِشْرَة",
 "かひつ": "تَحْسِين",
 "かひへん": "تيبالة (جزء غير متمايز من الغلاف الزهري لا يمكن تمييزه كسبلة أو بتلة (كما في الزنابق والتوليب))",
 "かひょう": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "かひん": "تُحْفَة, رَائِعَة",
 "かび": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا / بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية / قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "かびくさい": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "かびどめ": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها)",
 "かびん": "زَهْرِيَّة / تَوَتُّر",
 "かびんしょう": "فرط حساسية (حساسية مفرطة) / فرط الحساسية (حساسية مرضية)",
 "かびんせいちょうしょうこうぐん": "القولون التشنجي, متلازمة القولون العصبي (ألم بطني متكرر وإسهال (غالباً ما يتناوب مع فترات من الإمساك)؛ يرتبط غالباً بالضغط النفسي)",
 "かび臭い": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "かぴかぴ": "جَافّ المُعَامَلَة, خَشِن (فظ وعابس ومُنفِّر في التعامل) / ذُو قِشْرَة صُلْبَة, مُتَقَشِّر (ذو قشرة صلبة كغطاء)",
 "かふ": "مَنَحَ / مِنْحة / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة) / لعبة الإطفائي (لعب يتظاهر فيه الأطفال بإخماد حريق) / رجل إطفاء (عضو ذكر في قسم الإطفاء يحاول إخماد الحرائق) / رامٍ بديل (رامٍ ذكر (في البيسبول) لا يبدأ المباراة (يتم استدعاؤه لإنقاذ الموقف)) / وقاد (عامل ذكر يقوم بتغذية النيران (كما في القطارات التي تعمل بالفحم أو السفن البخارية)) / أَرْمَلَة / سلالة أصيلة, نسب (سلالة حيوان أصيل) / سلالة, نسب (خط النسب لحيوان أصيل) / أصل, سلالة (الاشتقاق الوراثي للفرد)\nمثال: كل سلالته كانت محاربين / أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "かふうてい": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / رنين (صوت رنين)",
 "かふか": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "かふきん": "إِعَانَة مَالِيَّة",
 "かふく": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "かふくぶ": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "かふちょう": "بَطْرِيَرْك, بَطْرَك / شَيْخ, بَطْرِيَرْك",
 "かふちょうせい": "نِظَام أَبَوِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "かふばん": "مَعْدُود",
 "かふん": "حُبُوبُ اللِّقَاح, حُبُوبُ الطَّلْع",
 "かふんかん": "أنبوب اللقاح ((علم النبات) نمو أنبوبي رفيع من حبة اللقاح عند ترسيبها على ميسم الزهرة؛ يخترق القلم وينقل الأمشاج الذكرية إلى البويضة)",
 "かふんしょう": "حمى القش (التهاب أنف موسمي ناتج عن رد فعل تحسسي لحبوب اللقاح)",
 "かぶ": "أساس (أدنى دعامة لهيكل ما) / أساس, بنية تحتية (الهيكل الأساسي أو ميزات نظام أو منظمة)\nمثال: بُني على أساس من الصخر الصلب / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / جُذْمُور, كُنَّاشَة / أصول, جذور (حالة الانتماء إلى مكان أو مجموعة معينة بحكم النسب الاجتماعي أو العرقي أو الثقافي)\nمثال: جذوره في تكساس تعود إلى زمن طويل / سُلَالَة / لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / تِسْعَة, تسعة",
 "かぶおんきょく": "تَرْفِيه, تَسْلِيَة",
 "かぶおんぎょく": "تَرْفِيه, تَسْلِيَة",
 "かぶかしすう": "مؤشر سوق الأسهم (مؤشر يعتمد على تجميع إحصائي لأسعار أسهم عدد من الأسهم التمثيلية)",
 "かぶかしすうれんどうがたじょうじょうとうししんたく": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "かぶかしすうれんどうがたとうししんたく": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "かぶかしゅうえきりつ": "مُضَاعِف الرِّبْحِيَّة, نِسْبَة السِّعْر إِلَى الأَرْبَاح ((سوق الأسهم) سعر السهم مقسوماً على أرباحه)",
 "かぶかのはんぱつ": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "かぶがいしめ": "زَاوِيَة, رُكْن",
 "かぶき": "كَابُوكِي / عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة)",
 "かぶく": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "かぶけん": "سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "かぶこうぞう": "أساس (أدنى دعامة لهيكل ما) / أساس, بنية تحتية (الهيكل الأساسي أو ميزات نظام أو منظمة)\nمثال: بُني على أساس من الصخر الصلب",
 "かぶさる": "غِطَاء / غِلَاف / غَطَّى",
 "かぶしき": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "かぶしきがいしゃ": "فرقة ريبيرتوار, فرقة مسرحية دائمة (فرقة مسرحية تؤدي مسرحيات من مخزون جاهز) / شركة مساهمة (شركة يتم تمثيل رأس مالها بأسهم)",
 "かぶしきこうかいかいつけ": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "かぶしきこうかいかいつけせいど": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "かぶしきしじょう": "سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "かぶしきじょうとえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "かぶしきとりひきじょ": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "かぶしきなかがいにん": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "かぶしきはいとう": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "かぶしきはいとうきん": "أرباح الأسهم, توزيعات أسهم (أرباح مدفوعة في شكل أسهم بدلاً من النقد)",
 "かぶしきぶんかつ": "تجزئة الأسهم (زيادة في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)\nمثال: أعلنوا عن تجزئة اثنين مقابل واحد للأسهم العادية",
 "かぶしきへいごう": "تجزئة عكسية للأسهم (انخفاض في عدد الأسهم القائمة للشركة دون تغيير حقوق المساهمين)",
 "かぶしきオプション": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "かぶす": "غِطَاء / غِلَاف / غَطَّى",
 "かぶせぶた": "سهل الارتداء (قطعة ملابس (رداء أو حذاء) يمكن ارتداؤها أو خلعها بسهولة)",
 "かぶせもの": "تَاج, إِكْلِيل",
 "かぶせる": "غِطَاء / غِلَاف / غَطَّى / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "かぶせ物": "تَاج, إِكْلِيل",
 "かぶせ蓋": "سهل الارتداء (قطعة ملابس (رداء أو حذاء) يمكن ارتداؤها أو خلعها بسهولة)",
 "かぶそしき": "أساس (أدنى دعامة لهيكل ما) / أساس, بنية تحتية (الهيكل الأساسي أو ميزات نظام أو منظمة)\nمثال: بُني على أساس من الصخر الصلب",
 "かぶた": "جُذْمُور, كُنَّاشَة",
 "かぶつ": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له) / حُمُولَة, شِحْنَة",
 "かぶと": "خُوذَة, بَيْضَة",
 "かぶとうお": "كَبير الرَّأْس (ذو رَأْس كَبير الحَجْم)",
 "かぶとえび": "روبيان الشرغوف (نوع من القشريات غلصميات الأرجل)",
 "かぶとがに": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "かぶとずきん": "خُوذِيُّ الشَّكْلِ (لَهُ شَكْلٌ مُحَدَّبٌ كَالخُوذَةِ)",
 "かぶとむし": "خنفساء وحيد القرن (أي من خنافس كبيرة استوائية بشكل رئيسي متنوعة لها قرون على الرأس؛ آفة على جوز الهند)",
 "かぶとをぬぐ": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "かぶとを脱ぐ": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "かぶな": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "かぶぬし": "مُسَاهِم, مُسَاهِمَة",
 "かぶぬししほん": "رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما) / أسهم مصرح بها, رأس المال المصرح به (الحد الأقصى لعدد الأسهم المصرح بها بموجب شروط عقد تأسيس الشركة)",
 "かぶぬししほんりえきりつ": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "かぶもと": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "かぶや": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "かぶら": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / لَفْتِيّ الشَّكْل (على شكل لَفْتة (شَلْجَم))",
 "かぶらな": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "かぶり": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن) / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / خوذة, غطاء رأس (ملابس للرأس) / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "かぶりつき": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "かぶりもの": "عَمْرَة, غِطَاء الرَّأْس / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "かぶり付き": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "かぶる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / دُبّ / دُبَّة / اِحْتَمَلَ / تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "かぶれ": "طَفْح, طَفْح جِلْدِيّ / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "かぶろ": "صَلَع",
 "かぶん": "قابل للتقسيم, قابل للقسمة (قادر على أو عرضة للتقسيم أو الفصل)\nمثال: الأرقام الزوجية تقبل القسمة على اثنين / مُفْرِط, زَائِد / اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "かぶんすう": "كَسْر غَيْر حَقِيقِيّ, كَسْر مُعْتَلّ (كسر يكون بسطه أكبر من مقامه)",
 "かぶんせい": "قَابِلِيَّةُ الْقِسْمَةِ",
 "かぶ菜": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "かへい": "زَهْرِيَّة / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / سُوَيْق, سُوَيْقَة / سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "かへいがく": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "かへいせいど": "نظام نقدي, وسيط تبادل (أي شيء مقبول عموماً كمعيار للقيمة ومقياس للثروة في بلد أو منطقة معينة)",
 "かへいせき": "نيموليت (أوالي أحفوري كبير من العصر الثالث)",
 "かへん": "مُتَغَيِّر / بَتَلَة, تُوَيْجَة",
 "かへんせい": "تَغَيُّرِيَّة, تَفَاوُت (صفة الخضوع للتغير) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "かへんていこうき": "ريوستات, مقاومة متغيرة (مقاومة لتنظيم التيار)",
 "かべ": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط / حَاجِز / عَقَبَة, حَاجِز",
 "かべいた": "دريوال, لوح جداري (لوح مسطح عريض يستخدم لتغطية الجدران أو القواطع؛ مصنوع من الجص أو لب الخشب أو مواد أخرى ويستخدم بشكل أساسي لتشكيل الجدران الداخلية للمنازل)",
 "かべかけ": "ستارة حائطية, معلقة (زينة تُعلق (مثل نسيج مزخرف) على الحائط أو فوق النافذة)\nمثال: كانت جدران القلعة الباردة مغطاة بالمعلقات",
 "かべがみ": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "かべごしすいりょう": "تخمين مدروس, تقدير تخميني (تقدير يجمع بين التفكير والتخمين)",
 "かべしたじ": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "かべつち": "مِلَاط, جِبْس",
 "かべにみみあり": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "かべにみみありしょうじにめあり": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "かべぬり": "تطيين, قصارة (وضع الجص)",
 "かべのはな": "خَيْرِيّ, قَصِيصَة",
 "かべやく": "فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة",
 "かべん": "بَتَلَة, تُوَيْجَة",
 "かほ": "سنبلة / حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "かほう": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / إرث عائلي, تحفة متوارثة (شيء كان موجوداً في العائلة لأجيال) / إرث عائلي, تحفة متوارثة ((قانون) أي ممتلكات يعتبرها القانون أو العرف غير قابلة للفصل عن الميراث وتورث معه) / حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة. / مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس. / إفراط في الثناء (ثناء مفرط أو غير مستحق)\nمثال: تؤمن معلمة البيانو بتشجيع طلابها لكنها تتجنب أي إفراط في الثناء قد يجعلهم يشعرون بالرضا عن النفس",
 "かほうさん": "حمض البيربوريك (شكل من أشكال حمض البوريك)",
 "かほうてき": "إِضَافِيّ, تَرَاكُمِيّ (يتميز أو ينتج عن طريق الإضافة) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / مادة مضافة (شيء يضاف لتعزيز الطعام أو البنزين أو الطلاء أو الدواء)\nمثال: عملية إضافية",
 "かほうに": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة.",
 "かほご": "مُفْرِط فِي الحِمَايَة (يحمي بشكل مبالغ فيه)",
 "かぼう": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "かぼうちょうしき": "قَابِل لِلنَّفْخ (مُصَمَّم ليُملأ بالهواء أو الغاز)",
 "かぼく": "خادم رجل (خادم من الرجال) / شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض) / أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "かぼそい": "رَفِيع, رَقِيق / ضعيف, ضعيفة / دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف) / رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / دَقِيقٌ, رَقِيقٌ (بالغ الدقة والرهافة في التطوير)\nمثال: مقطع كمان رقيق",
 "かぼちゃ": "قَرْع, يَقْطِين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "かま": "غَلَّايَة / مَوْقِد, مِدْفَأَة / مَوْقِد / عُلْجُوم, ضِفْدَع طِين / مِنْجَل / سؤال استدراجي (سؤال مصاغ بطريقة توحي بالإجابة المطلوبة؛ قد يطرح المحامي أسئلة استدراجية في الاستجواب المضاد) / جلبة, صخب (التأثير السمعي الذي يتميز بضوضاء عالية ومستمرة)",
 "かまあしむし": "أوليات الذنب (أي من الحشرات البدائية الدقيقة عديمة الأجنحة والعيون التي لها رأس مخروطي الشكل؛ تعيش في التربة الرطبة أو المواد العضوية المتحللة)",
 "かまいて": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "かまいません": "عَفْوًا",
 "かまいれ": "جني, حصاد (جمع المحصول الناضج)",
 "かまう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم. / اِهْتَمَّ, اِعْتَنَى / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "かまえ": "هَيْكَل / وَضْعِيَّة / تأهب, حماس (استعداد فوري) / بَرَاعَة, سَلَاسَة (سهولة طبيعية وبلا جهد) / استعداد, تأهب ((علم النفس) الاستعداد المؤقت للاستجابة بطريقة معينة) / استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: استعداد لمواصلة المناقشات",
 "かまえる": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ) / تَظَاهَرَ, اِخْتَلَقَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر) / يَزْعُم, تَخَيَّل\nمثال: تظاهر بأنه طبيب. / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "かまかぜ": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "かまがた": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまきり": "فَرَس اَلنَّبِيّ (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "かまくび": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまくら": "منتصف يناير (الجزء الأوسط من شهر يناير)",
 "かまじょう": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまじょうせっけっきゅう": "خلية منجلية (خلية دم حمراء غير طبيعية لها شكل هلال وتحتوي على شكل غير طبيعي من الهيموجلوبين)",
 "かます": "باراكودا, عقام / اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "かますさわら": "واهو (سمكة طعام وصيد كبيرة سريعة الحركة ومفترسة؛ توجد في جميع أنحاء العالم) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / شجيرة الفراولة, غدب أمريكي (نبات نفضي منتصب بقرون وبذور قرمزية؛ شرق الولايات المتحدة من نيويورك إلى فلوريدا وتكساس)",
 "かませいぬ": "تاجر جملة (شخص يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من المستهلكين النهائيين)",
 "かませる": "اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "かませ犬": "تاجر جملة (شخص يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من المستهلكين النهائيين)",
 "かまたき": "عَطَشْجِيّ",
 "かまち": "إِطَار النَافِذَة",
 "かまつか": "سجاد, كوليوس",
 "かまど": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "かまひげ": "مِنْجَلِيّ, هِلَالِيّ الشَّكْل (منحنٍ كالمنجل)",
 "かまびすしい": "صَارِخ, صاخِب",
 "かまぶろ": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "かまへん": "عَفْوًا",
 "かまぼこへいしゃ": "كوخ كونسيت, كوخ نيسن (كوخ جاهز من الحديد المموج له مقطع عرضي نصف دائري)",
 "かまぼこ兵舎": "كوخ كونسيت, كوخ نيسن (كوخ جاهز من الحديد المموج له مقطع عرضي نصف دائري)",
 "かまもと": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة. / خَزَّاف",
 "かまわない": "عَفْوًا",
 "かまをほる": "لوطي (شخص يمارس اللواط)",
 "かまを掘る": "لوطي (شخص يمارس اللواط)",
 "かま元": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة. / خَزَّاف",
 "かみ": "بَهَار, تَابِل / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء. / قِمَّة / قَدِيماً / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق / قَيْصَر, إِمْبْرَاطُور / رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "かみあう": "شَبَكَة",
 "かみあぶら": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "かみあわせ": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إِطْبَاق, إِطْبَاق الأَسْنَان ((طب الأسنان) العلاقة المكانية الطبيعية للأسنان عندما يكون الفكان مغلقين) / جبهة محبوسة, جبهة مقفلة ((في الأرصاد الجوية) جبهة مركبة عندما يحيط الهواء البارد بكتلة من الهواء الدافئ ويجبرها على الارتفاع)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "かみあわせる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي / أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ / وَفَّقَ",
 "かみい": "مُزَيِّن, كْوَافِير",
 "かみいれ": "مِحْفَظَة, حَافِظَة",
 "かみおくり": "رُقْيَة / جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "かみかけて": "مطلقا, على الإطلاق",
 "かみかしら": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "かみかぜ": "اِنْتِحَارِيّ, كَامِيكَازِي",
 "かみかたち": "تَصْفِيفَة, تَسْرِيحَة",
 "かみがかり": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "かみがしら": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "かみがた": "رَوْسَم / تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "かみがみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "かみがみのたそがれ": "راغناروك, شفق الآلهة (أسطورة حول الدمار النهائي للآلهة في معركة مع قوى الشر)",
 "かみきず": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "かみきり": "سكين ورق, فتاحة رسائل (سكين غير حاد يستخدم لفتح الأظرف التي تُرسل فيها الرسائل أو لشق صفحات الكتب غير المقطوعة) / خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "かみきりむし": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً)",
 "かみきりナイフ": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "かみきれ": "وَرَقَة",
 "かみくずかご": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "かみくずひろい": "جامع القمامة, نبّاش (شخص غير ماهر يجمع الخرق من القمامة العامة كوسيلة للعيش)",
 "かみくだく": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة",
 "かみげ": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "かみこなす": "هَضَمَ",
 "かみこま": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "かみころし": "قَتْل إِلٰه (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَاتِل إِلٰه (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: قتل الصياد دبا.",
 "かみころす": "خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "かみごいちにん": "قَيْصَر, إِمْبْرَاطُور",
 "かみごま": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "かみごろし": "قَتْل إِلٰه (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَاتِل إِلٰه (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: قتل الصياد دبا.",
 "かみさま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة) / واحد النرد, آس (في وَ: العدد واحد العدد الاول) / ذَرَّة / إرسال ساحق (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر) / أفضل رامٍ في الفريق / آس, مُمْتاز (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا. / قَيْصَر, إِمْبْرَاطُور / زَوْجَة, اِمْرَأَة",
 "かみさん": "زَوْجَة, اِمْرَأَة / مالكة العقار (مالك عقار أنثى) / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "かみざら": "طبق ورقي (طبق مصنوع من الورق المقوى يستخدم لمرة واحدة)",
 "かみしだく": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة",
 "かみしで": "شجرة النير, نير (أي من الأشجار أو الشجيرات المتعددة من جنس النير)",
 "かみしめる": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / هَضَمَ",
 "かみしも": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس",
 "かみすき": "صناعة الورق (حرفة صنع الورق)",
 "かみすり": "شَفْرَة حِلَاقَة / بَالِغ الوُضُوح (مُحَدَّد المَعَالِم بِوُضُوح شَدِيد) / حَادٌّ كَالمُوسَى (حادّ كحدّة شفرة الموسى)",
 "かみそりど": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ)",
 "かみっぺら": "وَرَقَة",
 "かみつ": "احتقان, اكتظاظ مفرط (الاكتظاظ المفرط)\nمثال: احتقان مروري / مُحْتَقِن (مُمْتَلِئ بِإِفْرَاط كَمَا بِالدَّم) / رَحِيق",
 "かみつきがめ": "سلحفاة نهاشة (سلحفاة مياه عذبة كبيرة عدوانية ذات فكوك قوية)",
 "かみつく": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "かみつづき": "دَبَّاسَة",
 "かみつぶて": "كرة ملعوبة (رمية غير قانونية يتم فيها وضع مادة غريبة (لعاب أو فازلين) على الكرة من قبل الرامي قبل رميها) / كرة ورقية ممضوغة (قذيفة تصنع عن طريق مضغ قطعة من الورق وتشكيلها في كرة)",
 "かみつよ": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "かみづかさ": "كَاهِن, قِسِّيس",
 "かみて": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "かみでっぽう": "مسدس الفلين, مسدس لعبة (لعبة تتكون من مسدس لعبة يصدر صوت فرقعة)",
 "かみとあがめる": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "かみどこ": "حَلَّاق / حلاقَة",
 "かみどめ": "مشبك شعر (دبوس لتثبيت شعر النساء في مكانه)",
 "かみなづき": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "かみなり": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ) / بَرَقَ, أَبْرَقَ (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ)\nمثال: البرق يسبق الرعد / غَضَب / أَغْضَبَ / غَضِبَ",
 "かみなりがなる": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "かみなりぐも": "سَحَاب رَاعِد, سَحَابَة رَاعِدَة (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "かみなりさま": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "かみなりにうたれた": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "かみなりよけ": "مَانِعَة صَوَاعِق",
 "かみなりりゅう": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "かみにめされる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "かみにんぎょう": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "かみのあい": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / حب غير مشروط, محبة روحية (حب غير أناني لشخص آخر دون دلالات جنسية (خاصة الحب ذو الطبيعة الروحية)) / محبة إلهية ((في اللاهوت المسيحي) محبة الله أو المسيح للبشرية)",
 "かみのおうこく": "ملكوت الله (المجال الروحي الذي يخضع لسيادة الله)",
 "かみのおぼしめし": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "かみのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "かみのけ": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "かみのこ": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير. / مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)\nمثال: زيري صهيوني مسيحي. / أُعْجُوبَة / نَابِغَة",
 "かみのことば": "كَلَام اللّٰهِ / كلمة الله (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "かみのたみ": "شعب الله المختار (أي شعب يعتقد أن الله اختاره)",
 "かみのつかい": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "かみのて": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "かみのみこ": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "かみのみこと": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "かみばさみ": "مِشْبَك وَرَق",
 "かみばな": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "かみひこうき": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "かみびょうし": "وَرَقِيّ الغِلَاف ((للكتب) ذو غلاف مرن) / كتاب غلاف ورقي (كتاب بأغلفة ورقية)",
 "かみふぶき": "نِثَار",
 "かみぶくろ": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "かみまき": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "かみまきたばこ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "かみまきタバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "かみや": "صناعة الورق (حرفة صنع الورق)",
 "かみやすり": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "かみゆい": "مُزَيِّن, كْوَافِير",
 "かみら": "ثوم معمر صيني (أوراق مسطحة كبيرة تستخدم كما يستخدم الثوم المعمر) / ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "かみわける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "かみわざ": "مُعْجِزَة, أُعْجُوبَة",
 "かみをとかす": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "かみん": "ترتيب الزهور ((علم النبات) ترتيب الكؤوس والبتلات في برعم الزهرة قبل تفتحه) / سبات صيفي ((علم الحيوان) توقف أو تباطؤ النشاط خلال فصل الصيف؛ وخاصة تباطؤ عملية التمثيل الغذائي في بعض الحيوانات خلال فترة حارة أو جافة) / الْجَمَاهِير, العَامَّةُ / الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي) / تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "かみんしょう": "فرط النوم (عدم القدرة على البقاء مستيقظاً)",
 "かみコップ": "كُوب وَرَقِيّ (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "かみテープ": "شريط ورقي (شريط طويل ضيق من الورق)",
 "かみパック": "كَرْتُون, كَرْتُونَة / عَرُوسَة",
 "かみマッチ": "علبة كبريت ورقية (حافظة صغيرة من أعواد الثقاب الورقية الآمنة)",
 "かみヤスリ": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "かみ傷": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "かみ分ける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "かみ合う": "شَبَكَة",
 "かみ合わせ": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إِطْبَاق, إِطْبَاق الأَسْنَان ((طب الأسنان) العلاقة المكانية الطبيعية للأسنان عندما يكون الفكان مغلقين) / جبهة محبوسة, جبهة مقفلة ((في الأرصاد الجوية) جبهة مركبة عندما يحيط الهواء البارد بكتلة من الهواء الدافئ ويجبرها على الارتفاع)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "かみ合わせる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي / أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ / وَفَّقَ",
 "かみ殺す": "خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "かむ": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / مَضَغَ / تاتاة, تلعثم (اضطراب في الكلام ينطوي على تردد وتكرار لا إرادي لأصوات معينة) / شَبَكَة / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / شركة عائلية (شركة مملوكة بالكامل لأعضاء عائلة واحدة) / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "かむだち": "مَلْت",
 "かむだちめ": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "かむづかさ": "كَاهِن, قِسِّيس",
 "かむながらのみち": "شِنْتَوِيَّة, شِنْتُو",
 "かむり": "تَاج, إِكْلِيل",
 "かむる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / دُبّ / دُبَّة / اِحْتَمَلَ / تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "かむろ": "صَلَع",
 "かむわざ": "مُعْجِزَة, أُعْجُوبَة",
 "かめ": "سُلَحْفَاة",
 "かめあな": "حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "かめい": "التَّالِي ذِكْرُهُ, المَذْكُور أَدْنَاه (على وشك أن يُذكَر أو يُحدَّد فيما يلي) / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة / اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد)) / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "かめいかっこく": "دَوْلَة عُضْو, دَوْلَة عِضْو (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "かめいこく": "دَوْلَة عُضْو, دَوْلَة عِضْو (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "かめいしゃ": "مُشَارِك / مُشَارِكَة",
 "かめのこう": "حلقة البنزين (سلسلة مغلقة من 6 ذرات كربون مع ذرات هيدروجين مرتبطة بها)",
 "かめのて": "بَرْنَقِيل",
 "かめへん": "عَفْوًا",
 "かめむしもく": "بق حقيقي (أي من الحشرات المتنوعة من رتبة نصفيات الأجنحة وخاصة من رتيبة متباينات الأجنحة)",
 "かめん": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / تَنَكُّر / تَنَكَّرَ / أسفل, جانب سفلي (الجانب السفلي من أي شيء)",
 "かめんげき": "حفلة تنكرية (حفلة لضيوف يرتدون أزياء تنكرية وأقنعة)",
 "かめんはっこう": "تخمر سفلي (نوع بطيء من التخمر الكحولي في درجة حرارة منخفضة بما يكفي لغرق خلايا الخميرة في قاع السائل المتخمر؛ يستخدم في إنتاج جعة اللاغر)",
 "かめんぶとうかい": "حفل مقنع, حفلة تنكرية (حفل يرتدي فيه الضيوف أزياء وأقنعة)",
 "かも": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة. / فريسة سهلة, هدف سهل (ضحية بلا دفاع) / اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب / سَجَّادَة, بِسَاط",
 "かもい": "عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة)",
 "かもうち": "صيد البط (صيد البط)",
 "かもうり": "شمام شتوي (ثمرة كرمة الشمام الشتوي؛ شمام أخضر ذو لحم أخضر باهت إلى برتقالي يحفظ جيداً) / بطيخ شتوي, شمام عسلي (أي من أصناف كرمة الشمام ذات ثمار بقشرة بيضاء ملساء ولحم أبيض أو مخضر ليس له رائحة مسكية)",
 "かもがや": "إصبعية متكتلة, عشب البساتين (عشب قش ومرعى قوي من العالم القديم يُزرع على نطاق واسع)",
 "かもく": "قَلِيل الحَدِيث, مُتَكَتِّم (يميل بطبعه إلى عدم الكلام) / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / بَنْد / رُتْبَة سُفْلَى (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "かもしか": "سيرو (ظبي ماعز قصير القرون داكن المعطف يعيش في المناطق الجبلية بجنوب وجنوب شرق آسيا)",
 "かもしだす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "かもしない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもしれず": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもしれない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもしれぬ": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもしれません": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもしれん": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもしんない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かもし出す": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "かもじ": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة) / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "かもす": "خَمَّرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "かもつ": "حُمُولَة, شِحْنَة",
 "かもつき": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "かもつしつ": "عنبر الشحن, مخزن الشحن (المساحة في سفينة أو طائرة لتخزين البضائع)",
 "かもつしゃ": "عربة شحن (عربة سكة حديد تنقل البضائع)",
 "かもつじどうしゃ": "شَاحِنَة, كَمْيُون (اسم فاعل مؤنث من الفعل \"شَحَنَ\"؛ أي عربة أو سيارة تُستخدم للشحن أو النقل)\nمثال: انقلبت الشاحنة.",
 "かもつせん": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "かもつびん": "شحن البضائع (نقل البضائع تجارياً بأسعار أرخص من أسعار النقل السريع) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / أجرة الشحن, سعر الشحن (الرسم لنقل شيء ما بواسطة ناقل عام)\nمثال: نحن ندفع أجرة الشحن",
 "かもつゆそう": "شحن البضائع (نقل البضائع تجارياً بأسعار أرخص من أسعار النقل السريع) / أجرة الشحن, سعر الشحن (الرسم لنقل شيء ما بواسطة ناقل عام)\nمثال: نحن ندفع أجرة الشحن",
 "かもつれっしゃ": "قطار بضائع, قطار شحن (قطار سكة حديد يتكون من عربات بضائع)",
 "かもにく": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "かもにする": "يخدع",
 "かもね": "رُبَّمَا, مِن اَلْمُمْكِن",
 "かものはし": "خُلْدُ ٱلْمَاء, مِنْقَارُ ٱلْبَطّ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "かもはしりゅう": "ديناصور بطي المنقار, هادروصور (أي من العديد من الديناصورات الكبيرة التي تسير على قدمين ولها منقار قرني يشبه منقار البط وأقدام مكففة؛ ربما كانت مائية جزئياً)",
 "かもめ": "نَوْرَس",
 "かももく": "إِوَزِّيّ / إِوَزِّيَّة",
 "かもりょう": "صيد البط (صيد البط)",
 "かもる": "غَشَّ, جَدَعَ",
 "かもん": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "かもんばん": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "かも知れず": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れぬ": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れません": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知れん": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも知んない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "かも肉": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "かや": "نَامُوسِيَّة",
 "かやかや": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / بِصَوْت عَالٍ",
 "かやく": "بَهَار, تَوَابِل / مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / عامل مساعد, مادة مساعدة (مادة مضافة تعزز فعالية العلاج الطبي) / بَارُود / قابل للاختزال, قابل للتبسيط (قادر على أن يتم اختزاله)\nمثال: قابل للاختزال إلى مجموعة من مبادئ الطبيعة البشرية",
 "かやくいれ": "قرن البارود (حاوية لحمل البارود؛ مصنوعة من قرن حيوان مجوف)",
 "かやくいんぼうじけん": "مؤامرة البارود (مؤامرة في عام 1605 في إنجلترا لتفجير الملك جيمس الأول ومجلسي البرلمان للانتقام لاضطهاد الكاثوليك في إنجلترا؛ بقيادة جاي فوكس)",
 "かやくこ": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ / برميل بارود (برميل (عادة من المعدن) للبارود أو مسحوق التفجير) / برميل بارود (حالة قابلة للانفجار المحتمل)",
 "かやつりぐさ": "خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية)",
 "かやねずみ": "فأر الحصاد (فأر أوراسي صغير بني محمر يعيش في حقول الذرة مثلاً) / فأر الحصاد الأمريكي (أي من عدة فئران رمادية صغيرة من العالم الجديد تعيش في حقول الحبوب مثلاً)",
 "かやば": "حقل قش, مرج (قطعة أرض مغطاة أو مغطاة في الغالب بالعشب؛ حقل يُزرع فيه العشب أو البرسيم ليصنع منه القش)",
 "かやぶき": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かやぶきやね": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かやぶき屋根": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "かゆ": "إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم) / إذن انصراف (إذن رسمي بالمغادرة) / إطار مقعر ((العمارة) إطار زخرفي مقعر) / كونغي (عصيدة أرز صينية تؤكل في الإفطار)",
 "かゆい": "مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "かゆいかゆい": "خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان / حكة, هرش (إحساس جلدي مزعج يولد الرغبة في الحك) / جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "かゆみ": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
 "かよい": "تنقل للعمل (سفر المتنقل للعمل) / دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "かよいじ": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "かよいちょう": "دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "かよいぶね": "مُعَدِّيَة, عَبَّارَة",
 "かよう": "قابل للذوبان ((للمادة) قادر على الذوبان في مذيب ما (عادة الماء)) / قابل للحل (قابل للحل أو التفسير)\nمثال: اللغز قابل للحل / مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع. / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية. / الثُّلَاثَاء, الثَّلَاثَاء\nمثال: 火曜の朝までにすべて終えなければならないのです。 — يجب علينا إنهاء كل شيء قبل صباح الثلاثاء. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / شَبِهَ / مَاثَلَ / مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / ورقة زهرية (ورقة معدلة تكون جزءاً من الزهرة)",
 "かようせい": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل) / إمكانية الحل, قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من الممكن حلها) / ذَائِبِيَّة, قَابِلِيَّة الذَّوَبَان (كمية مادة معينة يمكن أن تذوب في مذيب معين (لإنتاج محلول مشبع)) / تَوَفُّر",
 "かようそさん": "حمض البيريوديك (أي حمض لليود يحتوي على الأكسجين)",
 "かようなしだいで": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かような次第で": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かようび": "الثُّلَاثَاء, الثَّلَاثَاء",
 "かようへん": "فَتِيل / مُنْصَهِرَة, مصهر",
 "かよく": "إيثار, سخاء (التصرف بكرم وسخاء) / إيثار, نكران الذات (صفة عدم وضع النفس أولاً والاستعداد لبذل الوقت أو المال أو الجهد من أجل الآخرين)\nمثال: يظهر سكان الريف تفانياً ونكراناً للذات أكثر من أبناء عمومتهم في المناطق الحضرية",
 "かよわい": "ضَعِيف",
 "から": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق. / لِأَنَّ / هكذا, بلا سبب / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة. / بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)\nمثال: رفض مغريات العالم الباطلة / بِلَا عِبْء, خَفِيفُ الحِمْل (غير مُثقَل بحمل مادّي) / غير مثقل بالأعباء, مرتاح (غير مثقل بالصعوبات أو المسؤوليات)\nمثال: غير مثقل بنظرية شاملة / خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار / جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟ / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق) / مِقْبَض / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "からあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "からい": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين) / حِرِّيف, حَارّ\nمثال: الجو حار اليوم. / مَالِح / مِلْحِيّ / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ) / أَلِيم, مُؤْلِم\nمثال: 彼女は多くの辛い思いを経験してきた。 — لقد واجهَت الكثير من الصعوبات. / برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "からいうと": "بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ",
 "からいえば": "بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ",
 "からいって": "بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ",
 "からいばり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "からいも": "بَطَاطَا حُلْوَة",
 "からうす": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "からうめ": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "からうり": "بيع على المكشوف (بيع الأوراق المالية أو العقود الآجلة للسلع التي لا يملكها البائع (على أمل شرائها لاحقاً بسعر أقل))",
 "からえずき": "تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى)\nمثال: نوبة سيئة من التهوع",
 "からおけ": "كَارَيُوكِي",
 "からかい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / تسليك الشعر, فك التشابك (فعل إزالة التشابك من شعرك بمشط) / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / إغاظة, مشاكسة (مضايقة مرحة)\nمثال: تجاهل تهكمهم",
 "からかう": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "からかね": "بُرُنْزٌ, فِلِزّ / بُرُنْزِيٌّ",
 "からから": "مُحَمَّص (مُحَمَّصٌ أَوْ مَشْوِيٌّ قَلِيلًا) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس) / فَارِغ / فَرَغَ / جداً, حقاً (تستخدم لإعطاء التوكيد) / خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / حشرجة, خشخشة (سلسلة سريعة من الأصوات العالية القصيرة (كما قد تسمع بالسماعة الطبية في بعض أنواع اضطرابات الجهاز التنفسي))\nمثال: كانت موهوبة جداً",
 "からがら": "بِٱلْكَاد",
 "からきし": "إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "からくさもよう": "أرابيسك, زخرفة عربية (زخرفة تتداخل فيها أشكال نباتية محاكية في تصميم معقد) / أرابيسك (وضعية يرفع فيها الراقص ساقاً واحدة للخلف ويمد ذراعيه في وقفة تقليدية)",
 "からくさもん": "أرابيسك, زخرفة عربية (زخرفة تتداخل فيها أشكال نباتية محاكية في تصميم معقد) / أرابيسك (وضعية يرفع فيها الراقص ساقاً واحدة للخلف ويمد ذراعيه في وقفة تقليدية)",
 "からくじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "からくだもの": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "からくち": "مَالِح / مِلْحِيّ / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ)",
 "からくに": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "からくも": "بِٱلْكَاد",
 "からくり": "آلِيَّة / حِيلَة",
 "からくりにんぎょう": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "からくり人形": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "からくれない": "قِرْمِز (القِرْمِزُ: صِبْغ أرمني أَحمر يقال إِنه من عُصارة دود يكون في آجامهم (في الصخور)، فارسي معرب؛ صبغ لونه احمر قانٍ يصنع من حشرة القرمز الجافة والمسحوقة) / قِرْمِزِيّ",
 "からけし": "فَحْم الْخَشَب",
 "からげ": "إِبَالَة, حُزْمَة",
 "からげる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "からげんき": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
