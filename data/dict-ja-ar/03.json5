 "かわべり": "ضفة النهر",
 "かわほり": "وَطْوَاط, خُفَّاش / مِظَلَّة, شَمْسِيَّة / انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "かわます": "تروتة الجدول (تروتة المياه العذبة في أمريكا الشمالية؛ أُدخلت إلى أوروبا)",
 "かわむき": "تَقْشِير / سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات)",
 "かわむきき": "مِقْشَرَة / كلب (مصطلحات غير رسمية للكلاب)",
 "かわめんたい": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه)",
 "かわや": "خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ)",
 "かわゆい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق)",
 "かわよ": "فَاتِن, قَشِيب",
 "かわよい": "فَاتِن, قَشِيب",
 "かわら": "قِرْمِيدَة, قِرْمِيد",
 "かわらか": "مُنْعِش / دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة)",
 "かわらけ": "خزف مسامي, فخار (أواني خزفية مصنوعة من طين مسامي محروق بحرارة منخفضة)",
 "かわらげ": "حصان أشهب مصفر (حصان ذو لون أسمر مصفر فاتح مع عرف وذيل داكنين)",
 "かわらこじき": "مُمَثِّل, مُمَثِّلَة",
 "かわらじょう": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "かわらない": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "かわらぬ": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "かわらばと": "حَمَام طُورَانِيّ, حَمَام أَزْرَق (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "かわらふじのき": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في…)",
 "かわらまつば": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "かわらや": "مبلط (عامل يضع البلاط)",
 "かわら状": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "かわり": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / فَرْق, اِخْتِلَاف / شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "かわりがわり": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "かわりだね": "اِخْتِلَاف / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة",
 "かわりに": "بَدَلًا مِن / في المقابل (في تبادل أو رد)\nمثال: تخلينا عن مقاعدنا على الطائرة وفي المقابل حصلنا على عدة مئات من الدولارات ومقاعد على الطائرة التالية",
 "かわりばえ": "تَحْسِين",
 "かわりばん": "متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "かわりばんこ": "متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "かわりばんこに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "かわりめ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "かわりもの": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة",
 "かわりもん": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة",
 "かわりやく": "احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة",
 "かわりやすい": "قَابِل لِلتَّغْيِير, مُتَغَيِّر (بحيث يكون التغيير ممكناً؛ لديه ميل ملحوظ للتغيير)\nمثال: سلوك متقلب",
 "かわりゆく": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "かわりよう": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "かわる": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / نَجَحَ / مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "かわるがわる": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "かわろう": "كَبَا",
 "かわをはぐ": "هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال.",
 "かわをむく": "قَشَّرَ",
 "かわん": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "かわヨ": "فَاتِن, قَشِيب",
 "かわーい": "فَاتِن, قَشِيب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز. / بَرِيء, بَرِيئَة / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق)",
 "かん": "اِدْرََاك حَسِّيّ / قَدَرَ, اِسْتَطَاعَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد. / أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب) / سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة. / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / مَشْهَد, مَسْرَحِيَّة / قَصَبَة / تَاج, إِكْلِيل / أَفْضَل / أُنْبُوبَة / آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ…)\nمثال: وعاء السکر فارغ. / بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / عز الشتاء, منتصف الشتاء (وسط فصل الشتاء) / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟ / طُومَار / شُعُور, إِحْسَاس / تَجْرِيبِيّ, مُؤَقَّت (بِمُوجِبِ شُرُوطٍ لَمْ تُسْتَكْمَلْ أَوْ لَمْ يُتَّفَقْ عَلَيْهَا نِهَائِيًّا) / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل) / كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم. / سلالة هان, هان (سلالة إمبراطورية حكمت الصين (معظم الوقت من 206 قبل الميلاد إلى 220 ميلادي)…) / أُسْرَة هَان / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / النِهاية / إتمام, إكمال (إجراء ختامي أو نهائي) / فَاصِل / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / فُرْصَة / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور. / بَسَاطَة / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / حُرُوف صِينِيَّة مُبَسَّطَة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / حَلْقَة / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / حُفْرَة / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / قصبة (ساق نباتات الفصيلة النجيلية) / خَان (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / النزعَة إلى الخير / إِلٰهِيّ\nمثال: هذا الرجل تاجر. / حَاجِز / دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ…) / جُمْهُورِيَة كُورِيَا / أُسْرَة هَان",
 "かんあく": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته",
 "かんい": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / جَرِيء, جَسُور / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة)",
 "かんいか": "تبسيط, تقليل (عملية تقليل التعقيد)",
 "かんいがたけいたいでんわ": "دائرة الصحة العامة الأمريكية (وكالة تعمل كمكتب للجراح العام؛ تشمل وكالات مهمتها تحسين الصحة العامة)",
 "かんいしょくどう": "مَقْصَف, كَافِتِيرِيَا (خوان يستخدف في غرف الطعام لحفظ أدوات المائدة، وقد يوضع عليه الطعام استعدادا…)",
 "かんいじゅうたく": "جَاهِزُ التَّرْكِيبِ, مُسَبَّقُ الصُّنْعِ (مُصنَّع بأحجام معيارية ليُشحَن ويُركَّب في مكان آخر)",
 "かんいすい": "كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "かんいっぱつ": "شعرة, قيد شعرة (مسافة أو مساحة صغيرة جداً)\nمثال: نجوا بشق الأنفس (بقدر شعرة)",
 "かんいっぱつのところ": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "かんいっぱつをいれず": "فَوْرًا, حَالًا",
 "かんいてき": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんいばくだん": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんいばくはつぶつ": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんいり": "مُعَلَّب (مَحْفُوظ فِي عُلْبَة أَوْ بُرْطُمَان مُغْلَق)",
 "かんいん": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "かんいんざい": "إساءة جنسية, اعتداء جنسي (جريمة تشريعية تنص على أنه من الجريمة التسبب عمداً في انخراط شخص آخر في فعل جنسي…)\nمثال: استبدلت معظم الولايات تعريف القانون العام للاغتصاب بقوانين تحدد الاعتداء الجنسي",
 "かんいブログ": "تدوين مصغر (مدونة يتم فيها تحديد طول التدوينات الفردية (مثل تويتر))",
 "かんいベッド": "سرير سفري, سرير قابل للطي (سرير صغير يمكن طيه للتخزين أو النقل)",
 "かんう": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "かんえつ": "تَفَقُّد",
 "かんえつしき": "اِسْتِعْرَاض, مَوْكِب",
 "かんえん": "اِلْتِهَاب الْكَبِد",
 "かんおう": "استجابة, تجاوب (صفة الاستجابة أو التفاعل بسرعة؛ بالنسبة للأشخاص، تتضمن التجاوب العاطفي مع الناس…) / إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث)\nمثال: استحثاث حالة التخدير / زَهْرَة كَرَز / تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية)",
 "かんおうかい": "زَهْرَة كَرَز",
 "かんおけ": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "かんおん": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ:…)\nمثال: شكر ياني أسرته.",
 "かんおんせいなんちょう": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "かんおんなんちょう": "فقدان السمع الحسي العصبي (فقدان السمع بسبب فشل العصب السمعي)",
 "かんか": "فَوَاكِه مُجَفَّفَة / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / خُلُو مِن اَلْعَمَل / بُوتَقة / قِدْر صَهْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد. / سِلَاح, أَسْلِحَة / صِرَاع / تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / جَنَازَة (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / كَارِثَة, مُصِيبَة",
 "かんかい": "اِنْطِبَاع, أَثَر / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / عَفْو, صَفْح",
 "かんかいん": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب)",
 "かんかく": "حَاسَّة\nمثال: لديهم حس الفكاهة. / مُشَاهِد, رَاءٍ / فَرَاغ, مَكَان\nمثال: الفضاء مليئ بالغموض.",
 "かんかくかびんしょう": "فرط حساسية (حساسية مفرطة)",
 "かんかくき": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم)…)",
 "かんかくきかん": "عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم)…)",
 "かんかくしゃだん": "حرمان حسي (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من جميع المدخلات الحسية)",
 "かんかくしんけい": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "かんかくじょうひ": "ظهارة عصبية (ظهارة مرتبطة بأعضاء الحس الخاصة وتحتوي على نهايات عصبية حسية)",
 "かんかくてき": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "かんかくどんま": "نقص الحس (ضعف الحساسية اللمسية)",
 "かんかくもう": "شارب, شعرة حسية (شعرة صلبة طويلة تنمو من خطم أو حاجب معظم الثدييات مثل القطط)",
 "かんかくろん": "تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة)",
 "かんかくニューロン": "عصبون حسي (عصبون ينقل النبضات نحو الدماغ أو الحبل الشوكي)",
 "かんかじ": "حُرُوف صِينِيَّة مُبَسَّطَة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "かんかつ": "قَضَاء / كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم! / مَاكِر",
 "かんかん": "وَزْن / عضو حسي (عضو به نهايات عصبية (في الجلد أو الأحشاء أو العين أو الأذن أو الأنف أو الفم)…) / ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً)\nمثال: صمت كسره نباح الكلاب بشراسة / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة / بِهُدُوء / قناة كبدية (القناة التي تصرف الصفراء من الكبد) / شَعْرَة\nمثال: شعر ماريا طويل.",
 "かんかんがくがく": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "かんかんぼう": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح)",
 "かんかんぼうず": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "かんかん坊主": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "かんかん帽": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح)",
 "かんが": "خُلُو مِن اَلْعَمَل / رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "かんがい": "سَقْي",
 "かんがいい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة)\nمثال: عين ثاقبة",
 "かんがいぶかい": "مُتَحَرِّك",
 "かんがえ": "تفكير, فكر (عملية استخدام عقلك للنظر في شيء ما بعناية)\nمثال: التفكير دائماً ما يجعله يعبس / فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / قَصْد, إِرَادَة / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "かんがえかた": "وِجْهَة نَظَر, حَيْثِيَّة",
 "かんがえこむ": "تَفَكَّرَ, فَكَّرَ",
 "かんがえごと": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة.",
 "かんがえだす": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية)",
 "かんがえちがい": "سُوء فَهْم",
 "かんがえちゅう": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا",
 "かんがえつく": "جَاءَ بِـ, أَتَى بِـ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "かんがえなおす": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "かんがえなし": "دون تفكير (بطريقة خالية من التفكير)\nمثال: حدق دون تفكير في الصورة",
 "かんがえにふける": "ربة الإلهام, ملهمة (مصدر إلهام الفنان)\nمثال: كانت يوتيربي ملهمته",
 "かんがえぶかい": "عَمِيق اَلتَّفْكِير",
 "かんがえぶかげ": "عَمِيق اَلتَّفْكِير",
 "かんがえもつかない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "かんがえもの": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها.",
 "かんがえられない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "かんがえる": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا / تَعَمَّدَ, نَوَى / تَنَبَّأَ",
 "かんがえをめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "かんがく": "علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "かんがくしゃ": "عالم صينيات (دارس للتاريخ واللغة والثقافة الصينية)",
 "かんがっき": "آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "かんがみる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "かんがよい": "فطن, مدرك (لديه القدرة على الإدراك أو الفهم؛ حاد البصيرة)\nمثال: عين ثاقبة",
 "かんがん": "خَجْلَان, خَجُول / خَصِيّ, مَخْصِيّ / سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "かんき": "استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة)\nمثال: هو في حالة سخط من الملك (مغضوب عليه) / إثارة, إيقاظ (فعل الإثارة أو الاستنهاض)\nمثال: الهدف من الفن هو إثارة العواطف / تَهْوِيَة / فُرْجَة / موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في…) / علامة الناشر, كولوفون (شعار الناشر المطبوع في كتاب (عادة في صفحة العنوان)) / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "かんきこう": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "かんきそうち": "مِرْوَحَة",
 "かんきつ": "جور, حيف (فعل غير عادل) / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
 "かんきつけい": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
 "かんきつるい": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
 "かんきびんらん": "خدمة مدنية, موظفو الخدمة المدنية (موظفون حكوميون؛ يتم تعيينهم عادة على أساس امتحانات تنافسية)",
 "かんきゃく": "مُشَاهِد, رَاءٍ / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "かんきゃくすう": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ))\nمثال: زاد الحضور بنسبة 50 في المائة",
 "かんきゃくせき": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "かんきゃくどういんりょく": "قُوَّة الجَذْب (القدرة على جذب الناس (العملاء أو المؤيدين))",
 "かんきゅう": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان / طَوَارِئ, حَالَةْ اَلطَّوَارِئ / إصدار عسكري, مخصصات حكومية (إمدادات (كالطعام أو الملابس أو الذخيرة) تصدرها الحكومة) / أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني…)",
 "かんきゅうおんどけい": "مقياس حرارة جاف البصلة (مقياس حرارة عادي ببصلة جافة؛ يستخدم لقياس درجة حرارة الهواء)",
 "かんきゅうきごう": "تمبو, سرعة الإيقاع ((موسيقى) السرعة التي ستُعزف بها المقطوعة)",
 "かんきゅうしゃ": "عربة الحارس (العربة في القطار التي يشغلها الحارس)",
 "かんきょ": "أُنْبُوبَة",
 "かんきょう": "فَائِدَة / بِيئَة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "かんきょうかがく": "إيكولوجيا, علم البيئة (فرع علم الأحياء المعني بالعلاقات بين الكائنات الحية وبيئتها)",
 "かんきょうかがくけんきゅうしょ": "أي (بمعنى؛ أي (لتقديم شرح))",
 "かんきょうかつどうか": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきょうがたセクハラ": "تَحَرُّش جِنْسِيّ",
 "かんきょうきょうせい": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうしんわがた": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうしんわてき": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうじょうけん": "حالة بيئية (حالة البيئة)",
 "かんきょうせってい": "تَهايُؤ",
 "かんきょうちょうちょうかん": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "かんきょうにやさしい": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "かんきょうほごしゅぎ": "حماية البيئة (نشاط حماية البيئة من التلوث أو الدمار)",
 "かんきょうほごしゅぎしゃ": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきょうほごろんしゃ": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきょうもんだいせんもんか": "بِيئِيّ, مُدافِع عَن البِيئَة (شخص يعمل لحماية البيئة من الدمار أو التلوث)",
 "かんきり": "فَتَّاحَة, مِفَكّ (التي تكثر الفَتْح)",
 "かんきん": "تَحْقِيق / حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه)\nمثال: حصر العدوى في منطقة بؤرية / عَصَوِيَّة",
 "かんきんさくもつ": "محصول تجاري, محصول نقدي (محصول قابل للبيع بسهولة يُزرع ويُجمع من أجل السوق (مثل الخضروات أو القطن أو…)",
 "かんきんしつ": "سجن السفينة, محبس (مؤسسة عقابية (خاصة على متن سفينة))",
 "かんぎょ": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح) / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "かんぎょう": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "かんく": "قَضَاء / مَشَقَّة, شِدَّة",
 "かんくう": "لُومِن",
 "かんぐり": "اِتِّهَام, شَكّ",
 "かんぐる": "اِشْتَبَهَ بِ",
 "かんけい": "عَلَاقَة / مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف) / حَبْكَة / حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَلَقَة, حَلْقَة",
 "かんけいかいぜん": "تَوْفِيق, مُصَالَحَة (إعادة تأسيس العلاقات الودية)",
 "かんけいかくい": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいかくいどの": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいがない": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة)",
 "かんけいさき": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى)\nمثال: الجهات التابعة للشبكة",
 "かんけいし": "نِسْبِيّ",
 "かんけいしゃ": "طَاقَم, طَاقِم",
 "かんけいしゃかくい": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいすじ": "مُطَّلِع",
 "かんけいせい": "عَلَاقَة, مُنَاسَبَة",
 "かんけいせつ": "جملة موصولة (جملة يقدمها ضمير موصول)",
 "かんけいだいめいし": "اسم موصول, ضمير وصل (ضمير (مثل 'الذي' أو 'التي') يقدم جملة صلة تشير إلى سابق ما)",
 "かんけいだんたい": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى)\nمثال: الجهات التابعة للشبكة",
 "かんけいとうじしゃどの": "إِلَى مَنْ يَهُمُّهُ الْأَمْرُ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "かんけいどうぶつ": "دودة حلقية (ديدان ذات أجسام أسطوانية مقسمة داخلياً وخارجياً)",
 "かんけいない": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة)",
 "かんけいデータベース": "قاعدة بيانات علائقية (قاعدة بيانات يتم فيها تحديد العلاقات بين عناصر المعلومات بشكل صريح كسمات يمكن…)\nمثال: في قاعدة البيانات العلائقية يتم تنظيم البيانات كعدد من الجداول مختلفة الأحجام",
 "かんけつ": "نَتِيجَة / وَجِيز, مُوجَز / تَقَطُّع (صفة كون الشيء متقطعاً؛ خاضعاً للانقطاع أو التوقف الدوري) / جور, حيف (فعل غير عادل)",
 "かんけつせいばくはつせいしょうがい": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんけつせん": "سَخَّان (شبه إبْرِيق من معدن كالنحاس أو الصلب أو غيره يوضع على النار مباشرة ويستخدم…)",
 "かんけつそう": "هَيْئَة التَّمَام (جهة الفعل التي تعبر عن حدث مكتمل)",
 "かんけつてき": "مُتَقَطِّع / جِرَاحِيّ",
 "かんけつばくはつしょう": "عبوة ناسفة مرتجلة (جهاز متفجر يتم ارتجاله)",
 "かんけつぶん": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "かんけん": "تَحْقِيق / مَسْؤُول\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "かんげい": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "かんげき": "اِنْطِبَاع, أَثَر / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية",
 "かんげきりつ": "مَسَامِّيَّة",
 "かんげざい": "مُلَيّن",
 "かんげやく": "مُلَيّن",
 "かんげん": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع) / إعادة, استرداد (استعادة الشيء مرة أخرى)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / نَقْص / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار))\nمثال: خطاب تحذير حول مخاطر الفسق",
 "かんげんがくだん": "أُورْكِسْتْرَا",
 "かんげんがくほう": "توزيع أوركسترالي (فعل ترتيب قطعة موسيقية للأوركسترا وتعيين أجزاء للآلات الموسيقية المختلفة)\nمثال: التنسيق الماهر لحملته السياسية",
 "かんげんこうそ": "ريدوكتاز (إنزيم يحفز الاختزال الكيميائي الحيوي لبعض المواد المحددة)",
 "かんげんざい": "عامل مختزل, مختزل (مادة قادرة على إحداث اختزال لمادة أخرى بينما تتأكسد هي نفسها؛ تستخدم في التصوير…)",
 "かんげんしゅぎ": "اختزالية (تحليل الأشياء المعقدة إلى مكونات أبسط)",
 "かんげんすれば": "وَبِعِبَارَة أُخْرَى",
 "かんげんぶんれつ": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده))\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "かんげんみつご": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "かんこ": "تَزْكِية / بُحَيْرَة مِلْحَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "かんこう": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها / إِحْسَان / تعريض (فعل تعريض شخص ما لتجربة مؤثرة)\nمثال: نددت بتعريض الأطفال للمواد الإباحية / عَادَة / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية / زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة / صَمْت, سُكُوت / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / كالوميل, كلوريد الزئبقوز (مسحوق عديم اللون والطعم يستخدم طبياً كمسهل) / لُومِن",
 "かんこうきゃく": "سَائِح, سَائِحَة\nمثال: 地元の店は観光客相手に順調な商売をしている。 — المتاجر المحلية تقوم بمتاجرة جيدة مع السياح .",
 "かんこうけい": "مقياس الحساسية (أداة قياس لقياس حساسية الفيلم للضوء عبر مجموعة من التعريضات) / أكتينومتر, مقياس الإشعاع الكيميائي (أداة لقياس شدة الإشعاع الكهرومغناطيسي (عادة عن طريق التأثير الكيميائي الضوئي))",
 "かんこうしげん": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "かんこうせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "かんこうち": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)\nمثال: ナイアガラの滝は世界有数の観光地として名高い。 — ان شلالات نياغارا مشهورة كمنتجع سياحي رائد في العالم .",
 "かんこうはん": "عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي)) / عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "かんこうば": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان…)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "かんこうぶっさんかん": "قاعة معارض, منطقة عرض (قاعة كبيرة أو منطقة لإقامة المعارض)",
 "かんこうぶつ": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "かんこうへん": "تَشَمُّع, تَلَيُّف",
 "かんこうめいしょ": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "かんこうり": "مسؤولون حكوميون (أشخاص منتخبون أو معينون لإدارة حكومة)",
 "かんこうりょこう": "رِحْلَة",
 "かんこうれい": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "かんこうれいをしく": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "かんこうスポット": "معلم سياحي, منطقة جذب سياحي (خاصية تجذب السياح)",
 "かんこく": "نَصِيحَة, مَشُورَة / كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا. / خَانِيَّة",
 "かんこくあん": "تَوْصِيَة",
 "かんこくがい": "كوريا تاون, كورياتاون (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا.",
 "かんこくぐん": "جُمْهُورِيَة كُورِيَا",
 "かんこくご": "كُورِيّ",
 "かんこくしゃ": "مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم",
 "かんこくじん": "كوري جنوبي (من أو يتعلق بكوريا الجنوبية أو شعبها أو يميزهم)",
 "かんこくのり": "كِيم",
 "かんこつ": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة) / وَجْنَة, عَظْم وَجْنِيّ",
 "かんこつきゅう": "تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "かんこつだったい": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "かんこどり": "وَقْوَاق, وَقْوَاقِيَّة",
 "かんご": "صِينِيّ / تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها…) / كُورِيّ / ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "かんごう": "خَنْدَق / لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "かんごがく": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها…)",
 "かんごがっこう": "كلية التمريض, مدرسة التمريض (مدرسة لتدريب الممرضات)",
 "かんごく": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "かんごし": "مُمَرِّض\nمثال: هذا المرض قلبي.",
 "かんごしちょう": "رئيسة الممرضات (الشخص المسؤول عن التمريض في مؤسسة طبية)",
 "かんごしゃ": "أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "かんごそつ": "ضابط طبي (ممارس طبي في القوات المسلحة)",
 "かんごにん": "مُمَرِّض\nمثال: هذا المرض قلبي.",
 "かんごふ": "مُمَرِّض\nمثال: هذا المرض قلبي.",
 "かんごふちょう": "رئيسة الممرضات (الشخص المسؤول عن التمريض في مؤسسة طبية)",
 "かんごへい": "ضابط طبي (ممارس طبي في القوات المسلحة)",
 "かんさ": "تَحْقِيق / تَفَقُّد / تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن)",
 "かんさい": "تَصْفِية / شَمَنْدَر اَلسُّكَّر",
 "かんさいぼう": "خَلِيَّة جِذْعِيَّة",
 "かんさいぼうがん": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "かんさかん": "مُفَتِّش, مُفَتِّشَة",
 "かんさく": "محصول بيني, محصول مؤقت (محصول ينمو بسرعة (مثل الخس) ويمكن زراعته بين محصولين عاديين يزرعان في مواسم…)",
 "かんさつ": "تَفَقُّد / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات…) / إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة",
 "かんさつい": "طَبِيب شَرْعِيّ, طَبِيب عَدْلِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "かんさつかん": "مُفَتِّش, مُفَتِّشَة",
 "かんさつしゃ": "متفرج",
 "かんさつしん": "تسلخ جلدي, مذح (تسلخ بين سطحين جلديين متلامسين (كما في الإبط أو تحت الثديين أو بين الفخذين))",
 "かんさにん": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة)",
 "かんさやく": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة)",
 "かんさん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / مَهْجُور / خَامِد / عَاطِل عَن اَلْعَمَل / اِنْحِلَال",
 "かんさんけいすう": "عَامِل التَّحْوِيل (العامل الذي تضرب به كمية معبر عنها بوحدة معينة لتحويلها إلى وحدة أخرى)",
 "かんざい": "حراسة, وصاية (منصب الحارس أو الوصي) / خليط تبريد (خليط من المواد (عادة الملح والثلج) للحصول على درجة حرارة أقل من نقطة تجمد الماء) / علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "かんざいにん": "عُضْو مَجْلِس أُمَناء, وَصِيّ (أعضاء في مجلس حاكم أو مجلس أمناء)",
 "かんざくら": "زهرة الربيع الصينية (زهرة ربيع آسيوية مزروعة)",
 "かんざん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة)",
 "かんし": "مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / رصد, متابعة (فعل مراقبة شيء ما (وأحياناً الاحتفاظ بسجل له))\nمثال: يلعب رصد اتصالات العدو دوراً مهماً في أوقات الحرب / جفت, ملقط جراحي (أداة استخراج تتكون من زوج من الكماشات تستخدم في العلاج الطبي (خاصة لتوليد…) / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات…) / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / إقناع بالعدول, ثني (الإقناع بعدم القيام بشيء أو عدم تصديقه؛ إقناع شخص بالعدول عن معتقد أو مسار عمل…) / بِنْصِر / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "かんしいん": "متفرج",
 "かんしか": "خاضع للإشراف, مُراقب (تحت المراقبة أو تحت توجيه مشرف أو ناظر)\nمثال: لعب تحت الإشراف",
 "かんしき": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / أدلة جنائية, طب شرعي (اختبارات أو تقنيات علمية تستخدم في التحقيق في الجرائم) / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما.",
 "かんしきか": "عَارِف, عَارِفَة / مَسْرَح جَرِيمَة",
 "かんしきょく": "مُرَاقِب, مُرَاقِبَة",
 "かんししゃ": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "かんししょう": "مرصد, نقطة مراقبة (موقع مرتفع يتيح رؤية واسعة)",
 "かんしじん": "نَاطُور",
 "かんしせん": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "かんしたいせい": "نظام مراقبة (نظام تلفزيون الدائرة المغلقة يستخدم للمراقبة الدقيقة لشخص أو مجموعة)",
 "かんしっかん": "مرض كبدي (مرض يصيب الكبد)",
 "かんしつ": "سدى (النسيج الداعم لعضو ما (على عكس المتن أو النسيج الحشوي))",
 "かんしつせい": "بيني, خلالي (متعلق بالفرجات أو المسافات البينية)",
 "かんしつせいはいえん": "التهاب رئوي خلالي (مرض رئوي مزمن يصيب النسيج الخلالي للرئتين)",
 "かんしとう": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "かんしぶんべん": "ولادة بالملقط (ولادة يتم فيها إدخال الملقط عبر المهبل واستخدامه للإمساك برأس الجنين وسحبه)",
 "かんしゃ": "شُكْرًا\nمثال: ご協力に感謝します。 — أقدر تعاونك معنا. / قَصَب السُّكَّر / متفرج",
 "かんしゃく": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "かんしゃくだま": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "かんしゃくもち": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "かんしゃく持ち": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "かんしゃく玉": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "かんしゃさい": "عِيد اَلشُّكْر / شُكْرًا, تِسْلَم",
 "かんしゃしらず": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان)\nمثال: ورثة جاحدون",
 "かんしゅ": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني. / حارِس سِجْن, سَجَّان (شخص يحرس السجناء) / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / قَوْس, قوس / شُعُور, إِحْسَاس",
 "かんしゅう": "عَادَة, عُرْف / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / مُشَاهِد, رَاءٍ",
 "かんしゅうてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "かんしゅうほう": "سابقة قضائية, قانون السوابق القضائية ((القانون المدني) قانون تم إنشاؤه من خلال اتباع قرارات قضائية سابقة)\nمثال: نشأ القانون العام في القوانين غير المكتوبة في إنجلترا وتم تطبيقه لاحقاً في الولايات المتحدة",
 "かんしゅしゃ": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "かんしゅちょう": "آمِر سِجْن",
 "かんしゅにん": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "かんしょ": "بَطَاطَا حُلْوَة / قَصَب السُّكَّر / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / مِرْحَاض, تواليت",
 "かんしょう": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تَدَاخُل / عَاطِفَة / جزيرة مرجانية (جزيرة تتكون من شعاب مرجانية دائرية تحيط ببحيرة شاطئية) / إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة. / بطانة, حشوة (قطعة مصنوعة من مادة ناعمة أو مرنة تستخدم للملء أو إعطاء الشكل أو الحماية أو…) / إِعْجَاب / تَقْدِير / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات…) / تَفَكُّر / اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة) / فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / مَوْزَة\nمثال: هن بحاجة للموز. / شجرة الصنوبر, صنوبر (شجرة صنوبرية) / ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "かんしょうえき": "محلول منظم, محلول واق (محلول يحتوي على مادة منظمة (بفر))",
 "かんしょうか": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "かんしょうかい": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة)\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "かんしょうが": "زنجبيل, مسحوق الزنجبيل (جذر الزنجبيل المجفف والمطحون)",
 "かんしょうき": "مُمْتَصّ صَدَمَات",
 "かんしょうきおく": "ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي…)",
 "かんしょうけい": "مقياس التداخل (أي أداة قياس تستخدم أنماط التداخل لإجراء قياسات دقيقة للموجات)",
 "かんしょうこう": "ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "かんしょうこく": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "かんしょうざい": "بطانة, حشوة (قطعة مصنوعة من مادة ناعمة أو مرنة تستخدم للملء أو إعطاء الشكل أو الحماية أو…)",
 "かんしょうしゃ": "مُتَذَوِّق, مُقَدِّر (شخص يدرك شيئاً ما تماماً ويفهمه)\nمثال: هو ليس مقدراً للمعضلة التي نحن فيها",
 "かんしょうしゅぎ": "نزعة عاطفية (ميل للعاطفية)",
 "かんしょうしゅぎしゃ": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "かんしょうじま": "هدب, هدب التداخل (أحد النطاقات المضيئة أو المظلمة الناتجة عن تداخل وحيود الضوء)",
 "かんしょうじゅつ": "قِراءَةُ الْكَفّ",
 "かんしょうせい": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء)",
 "かんしょうそうち": "أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر))",
 "かんしょうちたい": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "かんしょうてき": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / مُلْتَحِم, مُتَرَابِط / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة) / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "かんしょうりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "かんしょうりょういき": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "かんしょうりょくち": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "かんしょく": "عفن جاف (فطر يسبب العفن الجاف) / خدمة مدنية, موظفو الخدمة المدنية (موظفون حكوميون؛ يتم تعيينهم عادة على أساس امتحانات تنافسية) / تحسس\nمثال: شعر ماريا طويل. / شُعُور, إِحْسَاس / وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "かんしょとう": "سكر القصب (سكر من قصب السكر يستخدم كعامل تحلية)",
 "かんしん": "إِعْجَاب\nمثال: 我々は彼女の勇気に感心する。 — نحب شجاعتها. / جَدِير بِالْإِعْجَاب / ذُهُول, دَهْشَة / تفضل, خدمة (عمل يتسم باللطف والتفضل)\nمثال: كانت النتيجة في صالحه / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "かんしんりょういき": "العَائِد عَلَى الِاسْتِثْمَار, العَائِد عَلَى رَأْس المَال المُسْتَثْمَر ((المالية) المبلغ، المعبر عنه كنسبة مئوية، الذي يتم كسبه على إجمالي رأس مال…)",
 "かんしプログラム": "برنامج مراقبة (برنامج يراقب وينظم ويتحكم أو يتحقق من عمليات نظام معالجة البيانات)",
 "かんじ": "سكرتير تنفيذي (سكرتير لديه واجبات ومسؤوليات إدارية) / شُعُور, إِحْسَاس / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / مُشْرِف, مُشْرِفَة / ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "かんじき": "حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع…)",
 "かんじきうさぎ": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "かんじく": "طُومَار",
 "かんじじてん": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんじちょう": "أمين سر (عضو في مجلس الوزراء البريطاني)",
 "かんじつげつ": "خُلُو مِن اَلْعَمَل",
 "かんじとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "かんじゃ": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة. / جَاسُوس / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / متفرج / خَصِيّ, مَخْصِيّ",
 "かんじゃく": "صَامِت, هَادِئ",
 "かんじやすい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "かんじゅ": "مُتَقَبِّل / إحساس, إدراك (إدراك شيء ما عبر الحواس)\nمثال: الكشف المبكر يمكن أن يؤدي غالباً إلى الشفاء / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / كحلي / سلالة هان, هان (سلالة إمبراطورية حكمت الصين (معظم الوقت من 206 قبل الميلاد إلى 220 ميلادي)…)",
 "かんじゅうしき": "لحمة متوسطة, نسيج متوسط (نسيج من أصل أديم متوسط يشكل النسيج الضام والدم والعضلات الملساء)",
 "かんじゅく": "إِمْكَان",
 "かんじゅせい": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية)\nمثال: جلفانومتر ذو حساسية شديدة",
 "かんじょ": "شهامَة / مِرْحَاض, تواليت",
 "かんじょう": "تاجي (يحيط كالتاج (خاصة الأوعية الدموية المحيطة بالقلب))\nمثال: شرايين تاجية / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة. / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها / عَاطِفَة, عَوَاطِف / أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل) / قَضِيبِيُّ الشَّكْلِ (يشبه القضيب أو العصا في شكله)",
 "かんじょういにゅう": "تَعَاطُف",
 "かんじょうか": "إِنْسَان انْفِعَالِيّ, شَخْص عَاطِفِيّ (شخص يخضع لحالات عاطفية قوية)",
 "かんじょうがかり": "كَاشِير, صَرَّاف\nمثال: هو غبي وغير أمين.",
 "かんじょうがき": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "かんじょうこうさてん": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "かんじょうこつ": "عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "かんじょうざん": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة",
 "かんじょうしょ": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "かんじょうしょうがい": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب…)",
 "かんじょうしょうごう": "صُلْح, مُصَالَحَة",
 "かんじょうじょうみゃくどう": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "かんじょうたい": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "かんじょうだい": "عَدَّاد",
 "かんじょうだかい": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "かんじょうちがい": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "かんじょうてき": "مُثَار عَاطِفِيًّا, مُنْفَعِل ((للأشخاص) متأثر بشكل مفرط بالعاطفة)\nمثال: كان سلوكه عاطفياً للغاية",
 "かんじょうどうみゃく": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم)",
 "かんじょうどうみゃくけっせんしょう": "خُثَار تَاجِيّ",
 "かんじょうどうみゃくしっかん": "تصلب الشرايين (تصلب جدران الشرايين)",
 "かんじょうぶぎょう": "صراف الأجور, مسؤول الرواتب (شخص مسؤول عن دفع الأجور)",
 "かんじょうみゃく": "وريد كبدي (وريد يصرف الكبد؛ يصب في الوريد الأجوف)",
 "かんじょうみゃくどう": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "かんじょうむきだし": "اندفاع في الكلام, فيض عاطفي (سمة ودية منفتحة لشخص ثرثار)",
 "かんじょうもう": "عُرْوَة, عُقْدَة",
 "かんじょうネットワーク": "عُرْوَة, عُقْدَة",
 "かんじょきょく": "بِبُطْء\nمثال: هنا يجب أن تعزف ببطء",
 "かんじょたい": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "かんじょほう": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده))\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "かんじる": "تحسس\nمثال: شعر ماريا طويل. / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / لُقْطَة\nمثال: كنت أمسك بالكرة. / مَنْظَر, مَشْهَد",
 "かんじわるい": "سَيِّئ, وحش",
 "かんじん": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / صانع أسلحة (مُصنِّع للأسلحة النارية)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي / سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين)) / استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك) / عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "かんじんかなめ": "حَاسِم",
 "かんじんもと": "داعم مالي, ممول (شخص يقدم الدعم المالي لمشروع ما)",
 "かんす": "تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "かんすい": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح…) / تَنْفِيذ / أُجَاج, صِير (أُجاجاً الماء الشديد الملوحة والمرارة؛ الصوت الحاصل من اختلاط الكلام و حفيف…) / رش, نثر (فعل رش أو طرطشة الماء)\nمثال: أولى علامات الاخضرار المتناثرة / إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها / ماء الآسن (الماء المتجمع في قاع السفينة)",
 "かんすいぎょ": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "かんすう": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "かんすうよびだし": "استدعاء دالة (استدعاء يمرر التحكم إلى روتين فرعي؛ وبعد تنفيذ الروتين الفرعي يعود التحكم إلى…)",
 "かんすうライブラリ": "فليروفيوم (عنصر مشع ما بعد اليورانيوم)",
 "かんすばる": "الثُّرَيَّا",
 "かんすぼん": "دَحْرَجَ, تَدَحْرَجَ",
 "かんする": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / زَنَى (مَارَسَ الزِّنَى) / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب. / فُقْمَة\nمثال: ختم سامي القرآن في شهر رمضان. / صَمْت, سُكُوت / تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟ / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "かんずる": "مَنْظَر, مَشْهَد / تحسس\nمثال: شعر ماريا طويل. / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / لُقْطَة\nمثال: كنت أمسك بالكرة.",
 "かんせい": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما. / صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة. / إتمام, إكمال (إجراء ختامي أو نهائي) / تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية)\nمثال: جلفانومتر ذو حساسية شديدة / عَطَالَة / انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / سَيْطَرَ\nمثال: من أنت لتحكم علي؟ / حركة جوية (حركة المرور الناتجة عن حركة الطائرات) / صَامِت, هَادِئ / فَخّ, مِصْيَدَة / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية. / ثُنَائِيّ الْجِنْس / تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟ / سُكَّرِيّ",
 "かんせいかん": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "かんせいけい": "إطار مرجعي قصوري (نظام إحداثيات يكون فيه قانون نيوتن الأول للحركة سارياً)",
 "かんせいこうほう": "ملاحة بالقصور الذاتي, نظام توجيه بالقصور الذاتي (نظام للتحكم في طائرة أو مركبة فضائية؛ يستخدم قوى القصور الذاتي)",
 "かんせいしつ": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "かんせいしょくぶつ": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات…)",
 "かんせいとう": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "かんせいはがき": "بطاقة بريدية (بطاقة لإرسال الرسائل بالبريد دون ظرف)",
 "かんせいゆ": "زيت جاف (زيت يتصلب في الهواء بسبب الأكسدة ويُستخدم غالباً كأساس للطلاء أو الورنيش)",
 "かんせいゆうどう": "توجيه بالقصور الذاتي (طريقة للتحكم في طيران صاروخ بواسطة أجهزة تستجيب لقوى القصور الذاتي)",
 "かんせいよう": "ورقة محيطة بالساق (ورقة تتحد قاعدتها حول الساق - وتبدو كأن الساق تخترقها)",
 "かんせいろん": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "かんせいモーメント": "عزم القصور الذاتي (ميل الجسم لمقاومة التسارع الزاوي)",
 "かんせかい": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "かんせつ": "جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل)\nمثال: قسم من صنارة الصيد / التواء, مراوغة (عمل مخادع غير مباشر)\nمثال: استطاع رؤية ما وراء مراوغات الدبلوماسيين / مُشْتَرَك / غِطَاء ثَلْجِيّ, قَلَنْسُوَة ثَلْجِيَّة (غطاء من الثلج (كما على قمة الجبل)) / تَلْمِيح / ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق…)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "かんせつえき": "سائل زليلي (سائل لزج مزلق يفرزه الغشاء المبطن للمفاصل وأغلفة الأوتار وما إلى ذلك)",
 "かんせつえん": "اِلْتِهَاب الْمَفَاصِل",
 "かんせつか": "تجويف حقاني, حفرة حقانية (التجويف في رأس لوح الكتف الذي يستقبل رأس عظم العضد لتشكيل مفصل الكتف)",
 "かんせつきょう": "منظار المفاصل (نوع من المناظير يتم إدخاله في المفصل للفحص البصري)",
 "かんせつきょうけんさ": "تنظير المفصل (عملية جراحية طفيفة التوغل لإصلاح مفصل تالف؛ يفحص الجراح المفصل بمنظار المفصل…)",
 "かんせつけいせいじゅつ": "رأب المفصل (إعادة بناء أو استبدال جراحي لمفصل مشوه أو متآكل)",
 "かんせつさつえい": "تنظير تألقي (فحص هياكل الجسم باستخدام منظار التألق)",
 "かんせつさつえいほう": "تنظير تألقي (فحص هياكل الجسم باستخدام منظار التألق)",
 "かんせつしょうこ": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "かんせつしょうじゅんしゃげき": "نيران غير مباشرة (نيران توجه لهدف لا يستخدم هو نفسه كنقطة تصويب للأسلحة)",
 "かんせつしょうめい": "إضاءة غير مباشرة (وحدة إضاءة مخفية)",
 "かんせつしん": "جَاضِم",
 "かんせつせんし": "بزل المفصل (إزالة السوائل من المفصل عن طريق البزل)",
 "かんせつぜい": "ضريبة غير مباشرة (ضريبة تفرض على السلع أو الخدمات بدلاً من الأشخاص أو المؤسسات)",
 "かんせつつう": "ألم المفاصل (ألم في مفصل أو مفاصل)",
 "かんせつてき": "غير مباشر, ملتوٍ (غير مباشر في البعد المكاني؛ لا يؤدي بخط مستقيم أو مسار مباشر إلى وجهة)\nمثال: أحياناً يوفر اتخاذ مسار غير مباشر الوقت",
 "かんせつはんげつ": "غضروف هلالي, هلالة ((في التشريح) قرص غضروفي يعمل كوسادة بين نهايات العظام التي تلتقي عند المفصل)",
 "かんせつひ": "فَوْق الرَّأْس (أعلى الرأس)\nمثال: اجمع الساقين معاً فوق الرأس",
 "かんせつもくてきご": "مفعول به غير مباشر (المفعول الذي هو المتلقي أو المستفيد من فعل الفعل)",
 "かんせつリウマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "かんせつリューマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "かんせん": "صَدَفِيَّة / خط رئيسي (المسار الرئيسي لنظام النقل) / عَدْوَى / غدة عرقية (أي من الغدد الموجودة في الجلد التي تفرز العرق) / دَقِيقُ المُلَاحَظَة, يَقِظ (سَرِيعُ المُلَاحَظَةِ؛ يُظْهِرُ إِدْرَاكًا حَادًّا وَسَرِيعًا)",
 "かんせんきょ": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "かんせんしゃ": "نَاقِل\nمثال: يبدو أنني حامل.",
 "かんせんしょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんせんしょうほう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんせんどう": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "かんせんどうろ": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "かんせんびょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんせんリスク": "خطر العدوى, مخاطرة (احتمال الإصابة بالعدوى بعد حدوث التعرض لعامل معد)",
 "かんぜい": "استعجال, حث (فعل الدعم أو التشجيع بجدية)\nمثال: لم يترك لي إلحاحه بديلاً سوى الموافقة / رُسُوم, جُمْرُك / تَلْمِيح",
 "かんぜいどうめい": "اتحاد جمركي (رابطة دول لتعزيز التجارة الحرة داخل الاتحاد وتحديد تعريفات مشتركة للدول غير…)",
 "かんぜいぼうえきいっぱんきょうてい": "الاتفاقية العامة للتعريفات الجمركية والتجارة, الجات (وكالة تابعة للأمم المتحدة أنشئت بموجب معاهدة متعددة الجنسيات لتعزيز التجارة عن…)",
 "かんぜつ": "فَرِيد, فَذّ",
 "かんぜん": "كَامِل / بجرأة\nمثال: يجب أن نعالج هذه المهام بجرأة / طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل)\nمثال: مراهقون يتسكعون بأحذية رياضية محلولة الأربطة / مَسْرُور (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح",
 "かんぜんきたい": "غاز مثالي (غاز افتراضي ذو جزيئات مهملة الحجم لا تمارس أي قوى بين الجزيئات)",
 "かんぜんこっせつ": "كسر كامل (كسر يشمل كامل عرض العظم)",
 "かんぜんこよう": "توظيف كامل (الحالة الاقتصادية عندما يكون كل من يرغب في العمل بمعدل الأجر السائد لنوع عمله…)",
 "かんぜんさいしょくしゅぎしゃ": "خُضْرِيّ",
 "かんぜんしあい": "مباراة مثالية (مباراة لا يسمح فيها الرامي لأي لاعب منافس بالوصول إلى القاعدة)",
 "かんぜんしゅぎ": "كَمَالِيَّة",
 "かんぜんしゅぎしゃ": "كَمَالِيّ",
 "かんぜんしょく": "مادة غذائية, منتج غذائي (مادة يمكن استخدامها أو تحضيرها للاستخدام كطعام)",
 "かんぜんじあい": "مباراة مثالية (مباراة لا يسمح فيها الرامي لأي لاعب منافس بالوصول إلى القاعدة)",
 "かんぜんじゆうしゅぎ": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "かんぜんせい": "اكْتِمَال, تَمَام ((منطق) سمة لنظام منطقي مكون بحيث ينشأ تناقض إذا تم إدخال أي قضية لا يمكن…)",
 "かんぜんちょうあく": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط…)\nمثال: يريدون العدالة.",
 "かんぜんちょうあくげき": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل…)",
 "かんぜんふっかつ": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "かんぜんへき": "كَمَالِيَّة",
 "かんぜんへんたい": "تحول كامل (تحول كامل في الحشرات)",
 "かんぜんほうしゃたい": "جِسْم أَسْوَد (جسم افتراضي قادر على امتصاص كل الإشعاع الكهرومغناطيسي الساقط عليه)\nمثال: الجسم الأسود المحافظ على درجة حرارة ثابتة هو مشع كامل عند تلك الدرجة لأن الإشعاع الواصل إليه والمغادر له يجب أن يكون في توازن",
 "かんぜんむけつ": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "かんそ": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんそう": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى)\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة / تفاهة, رتابة طعم (الافتقار إلى أي خاصية تذوق مميزة أو مثيرة للاهتمام) / إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث / اِنْطِبَاع, أَثَر / سحنة, محيا (الوجه البشري) / تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة)\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "かんそうか": "فَوَاكِه مُجَفَّفَة",
 "かんそうがく": "علم فراسة الدماغ, فرينولوجيا (دراسة مهجورة الآن لشكل الجمجمة كمؤشر على قوى الملكات العقلية المختلفة)",
 "かんそうき": "مجفف (جهاز يقوم بإزالة الرطوبة) / موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في…)",
 "かんそうきょく": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول)",
 "かんそうぎゅうにゅう": "حليب بودرة, حليب مجفف (حليب منزوع الماء (مجفف))",
 "かんそうざい": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "かんそうじゅつ": "سحنة, محيا (الوجه البشري)",
 "かんそうせんたく": "تَنْظِيف جَافّ",
 "かんそうち": "بَرّ, يَابِسَة (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "かんそうにく": "قَدِيد",
 "かんそうふきゅう": "عفن جاف (فطر يسبب العفن الجاف)",
 "かんそうみそ": "مُجَفَّف بِالتَّجْمِيد (مَحْفُوظ بِالتَّجْمِيد ثُمَّ التَّجْفِيف فِي الفَرَاغ)",
 "かんそうむみ": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى)\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "かんそか": "تبسيط, تقليل (عملية تقليل التعقيد)",
 "かんそく": "رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات…) / رَأْي, نَظَر / قدم أنبوبية (ناتئ أنبوبي ذو مجسات لمعظم شوكيات الجلد (نجم البحر وقنفذ البحر وخيار البحر) له…) / حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من…)",
 "かんそくかのうりょう": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته)",
 "かんそくききゅう": "بالون اختبار (بالون يُرسل لأعلى لاختبار التيارات الهوائية)",
 "かんそくしゃ": "متفرج",
 "かんそくじょ": "مَرْصَد",
 "かんぞう": "عرق السوس (حلوى سوداء منكهة بالجذر المجفف لنبات عرق السوس) / كَبِد, كِبْد / زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل…)",
 "かんぞうえん": "اِلْتِهَاب الْكَبِد",
 "かんぞうがん": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "かんぞうご": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "かんぞうたけ": "فطر شريحة اللحم (فطر صالح للأكل شائع بقبعة بلون الكبد أو اللحم النيئ؛ وفير في جنوب شرق الولايات…)",
 "かんぞうびょう": "مرض كبدي (مرض يصيب الكبد)",
 "かんぞく": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "かんたい": "المنطقة القطبية, المنطقة المتجمدة (جزء سطح الأرض الذي يشكل غطاء فوق القطب؛ ويتميز بمناخ متجمد) / كَرَم, إِكْرَام / أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات:…) / تراخ, تسيب (صفة التراخي والإهمال)\nمثال: يمكن للحمامات أن تساعد في تخفيف رخاوة الأمعاء / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط. / رمع (تشنج يتميز بتقلصات واسترخاءات متناوبة)",
 "かんたいさいぼう": "خلية عصوية, عصية (خلية مستقبلة بصرية حساسة للضوء الخافت)",
 "かんたいじ": "حُرُوف صِينِيَّة مُبَسَّطَة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "かんたいぜんせん": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "かんたいぜんせんジェットきりゅう": "جبهة باردة (مقدمة كتلة هوائية باردة تتقدم)",
 "かんたいりん": "تَايْغَا",
 "かんたる": "أَفْضَل",
 "かんたん": "إِعْجَاب / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / وَجِيز, قَصِير / صرصور الشجر (صرصور أمريكي شجري شاحب يشتهر بصريره العالي)",
 "かんたんし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんたんにいえば": "بِاخْتِصَار",
 "かんたんふ": "علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "かんたんぶん": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんだい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / اسم موصول, ضمير وصل (ضمير (مثل 'الذي' أو 'التي') يقدم جملة صلة تشير إلى سابق ما) / رمع (تشنج يتميز بتقلصات واسترخاءات متناوبة)",
 "かんだかい": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد)",
 "かんだちべ": "نُبْل, نَبَالَة",
 "かんだちめ": "نُبْل, نَبَالَة",
 "かんだん": "دَرْدَشَ / مُقَاطَعَة / ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة) / دَرَجَةْ الْحَرَارَة\nمثال: ليس لديك أي حمى.",
 "かんだんけい": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "かんだんなく": "باستمرار",
 "かんち": "اِدْرََاك حَسِّيّ / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / مَاكِر",
 "かんちがい": "سُوء فَهْم",
 "かんちき": "حَسَّاس, جِهَازُ اِسْتِشْعَار",
 "かんちく": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "かんちつ": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / غِطَاء وَاقٍ (الغطاء الطبيعي الصلب لبعض الكائنات الحية)\nمثال: لم يكن لديهم حماية من الغبار الذري",
 "かんちゅう": "سَقْي / إمداد, تزويد (نشاط توريد أو توفير شيء ما)",
 "かんちょう": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار. / جَاسُوس / مشرف عام, ناظر (شخص يوجه ويدير منظمة) / حُقْنَة شَرَجِيَّة, حُقْنَة / سلالة هان, هان (سلالة إمبراطورية حكمت الصين (معظم الوقت من 206 قبل الميلاد إلى 220 ميلادي)…) / انحسار الماء, جزر (أدنى (أبعد) انحسار للمد) / تَاج, إِكْلِيل",
 "かんちょういき": "مَصَبّ, فُغْرَة",
 "かんちょうえき": "حُقْنَة شَرَجِيَّة, حُقْنَة",
 "かんちょうかせん": "نهر مدّي (مجرى مائي تمتد فيه تأثيرات المد والجزر لمسافة بعيدة باتجاه المنبع)",
 "かんちょうせん": "علامة الجزر, علامة المد المنخفض (خط يحدد أدنى مستوى تم الوصول إليه)",
 "かんつい": "تَنْفِيذ / أَطْلَس",
 "かんつう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / ثَاقِب, نَافِذ (يميل إلى الاختراق؛ له قدرة على الدخول أو الثقب)",
 "かんつうざい": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "かんつぎて": "تركيبات أنابيب, وصلة أنابيب (تجهيزة تتكون من قطع أنابيب مسننة لربط الأنابيب ببعضها)",
 "かんづかさ": "كَاهِن, قِسِّيس",
 "かんづく": "حَاسَّة\nمثال: لديهم حس الفكاهة.",
 "かんづめ": "أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب)",
 "かんづめこうじょう": "مصنع تعليب (مصنع يتم فيه تعليب الطعام)",
 "かんてい": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة. / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "かんていか": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "かんていかかく": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما)",
 "かんていかん": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء)",
 "かんていし": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء)",
 "かんていにん": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "かんてき": "تَفَقُّد",
 "かんてつ": "تَنْفِيذ / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "かんてつしょう": "داء المتورقات (الإصابة بالمتورقة الكبدية؛ يحدث أحياناً تلف في الكبد)",
 "かんてん": "طقس بارد (فترة من الطقس البارد بشكل غير عادي) / أغار, أغار أغار (مستخلص غرواني من الطحالب؛ يستخدم خاصة في أوساط الاستنبات وكعامل تبلور في الأطعمة) / جَفَاف / زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس / وِجْهَة نَظَر, حَيْثِيَّة",
 "かんてんきち": "ابتهاج, تهلل (تلفظ بأصوات تعبر عن الفرح العظيم)",
 "かんてんばいち": "آغار, أجار مغذ (أي وسط استنبات يستخدم الآغار كعامل هلامي)",
 "かんでん": "إِلِكْتْرُود",
 "かんでんし": "صعق كهربائي (القتل بصدمة كهربائية)",
 "かんでんち": "بطارية جافة, خلية جافة (خلية ليكلانشيه صغيرة لا تحتوي على سائل حر؛ الإلكتروليت عبارة عن عجينة وقطب…)",
 "かんとう": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / مُفْتَرَق, تَقَاطُع / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとうげん": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "かんとうし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما.",
 "かんとく": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / تَحْقِيق / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとくかん": "مُفَتِّش, مُفَتِّشَة",
 "かんとくきょうかい": "الكنيسة الأسقفية (كنيسة الولايات المتحدة التي تتواصل مع كرسي كانتربري)",
 "かんとくしゃ": "مشرف عام, ناظر (شخص يوجه ويدير منظمة)",
 "かんとくせい": "حاكم إداري, محافظ (كبير الضباط أو كبير القضاة)\nمثال: محافظ شرطة باريس",
 "かんとん": "أسر, اعتقال (حالة كونه مسجوناً)\nمثال: احتجز في الأسر حتى مات",
 "かんど": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية)\nمثال: جلفانومتر ذو حساسية شديدة / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم.",
 "かんどう": "حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً)\nمثال: تطلع إلى إثارة اليوم / طريق جانبي (طريق فرعي يتفرع من طريق رئيسي)",
 "かんどうし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
