{
 "かじろうどう": "أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال.",
 "かじをとる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "かじを取る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "かじん": "جَمَال, زَيْن / شَاعِر, شَاعِرَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "かじ付き": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق)",
 "かす": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / أَعَارَ, سَلَّفَ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة. / تُفْل / ثفل الخمر, عكر (الرواسب الناتجة عن تخمير المشروبات الكحولية) / الْبَقَايَا / جُنْك / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / تَزَوَّجَ / مَنَحَ",
 "かすい": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / جَدْوَل / سنبلة / تَقَيَّلَ, أَخَذَ قَيْلُولَة",
 "かすいたい": "الغُدَّة النُخَامِيَّة",
 "かすいぶんかい": "تحلل مائي (تفاعل كيميائي يتفاعل فيه الماء مع مركب لإنتاج مركبات أخرى؛ ويتضمن انقسام…)",
 "かすう": "جُزْء عُشْرِيّ, مَانْتِيسَا (الجزء الكسري الموجب من تمثيل اللوغاريتم) / مُضَاف (عدد يضاف إلى عدد آخر) / تكافؤ",
 "かすうぶ": "جُزْء عُشْرِيّ, مَانْتِيسَا (الجزء الكسري الموجب من تمثيل اللوغاريتم)",
 "かすか": "إِغْمَاء / فَقِير",
 "かすかす": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما. / بِٱلْكَاد",
 "かすがい": "مَشْبَك / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / زِلاَج, ضَبَّة",
 "かすとり": "خمر رديء, مشروب كحولي رخيص (مشروب كحولي مقطر بشكل غير قانوني (وعادة ما يكون رديء الجودة))",
 "かすみ": "عَجَاج / خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين)",
 "かすみいし": "نيفيلين (معدن مائل للبياض يتكون من سيليكات الصوديوم والألمنيوم أو البوتاسيوم في شكل…)",
 "かすみそう": "جِيبْسُوفِيلَا, كُنْدُس",
 "かすみ草": "جِيبْسُوفِيلَا, كُنْدُس",
 "かすめうばう": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته…)\nمثال: لقد سلب مني كل شيء.",
 "かすめとる": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "かすめる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / انتقال خفي, هروب سري (انتقال سري (لتجنب دفع الديون))\nمثال: قاموا بهروب سري ليلي",
 "かすめ取る": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "かすり": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "かすりきず": "خَرْبَشَ",
 "かすり傷": "خَرْبَشَ",
 "かする": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / مَأْثُرَة / تَزَوَّجَ / شِبْر",
 "かすれきず": "خَرْبَشَ",
 "かすれる": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ)",
 "かすれ傷": "خَرْبَشَ",
 "かず": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "かずある": "عَدِيد, كَثِير",
 "かずおおい": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "かずかぎりない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずかず": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "かずけごと": "ذَرِيعَة, عُذْر / رِسَالَة, خَبَر",
 "かずけもの": "هَدِيَّة, هدية",
 "かずしらず": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずしれず": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずしれない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずしれぬ": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずてき": "عَدَدِيّ, رَقْمِيّ",
 "かずとり": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات",
 "かずにいれる": "عَدَّ",
 "かずや": "مُنْتَجٌ بِالجُمْلَةِ (مُنتَج بكميات كبيرة غالباً بتقنيات خطوط التجميع)",
 "かずら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل. / دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "かずらばし": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "かずら橋": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "かせ": "قَيْد / رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض)\nمثال: الالتصاق المتبادل للخلايا / شلة, لفة (لفة من الحبل أو الصوف أو الغزل) / حَزين",
 "かせい": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / زَائِف, بَاطِل / فَالْسِيتُّو (عالي النبرة اصطناعيّاً؛ فوق المدى الصوتيّ الطبيعيّ) / مُسَاعَدَة, إِمْدَاد / أعمال منزلية, تنظيف المنزل (عمل تنظيف وإدارة المنزل) / الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية)\nمثال: المريخ عالم ميت. / أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ…) / طُغْيَان, اِسْتِبْدَاد / صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء) / اِنْسِجَام, تَوَافُق / بُحَاح",
 "かせいがく": "اقتصاد منزلي, تدبير منزلي (نظرية وممارسة إدارة المنزل)",
 "かせいがん": "صَخَر نَارِيّ",
 "かせいこうぎょう": "الصناعات الكيماوية (مصنعو المواد الكيميائية باعتبارهم مجموعة)",
 "かせいじん": "مِرِّيخِيّ",
 "かせいだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "かせいふ": "مُدَبَّرَة الْمَنْزَل",
 "かせいアルカリ": "غسول, محلول قلوي (محلول قوي من هيدروكسيد الصوديوم أو البوتاسيوم)",
 "かせいカリ": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "かせいソーダ": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات…)",
 "かせき": "مُسْتَحَاثَة, أُحْفُورَة / مُتَحَجِّرَة (صخرة نشأت بالتحجر؛ جسم عضوي تخللته مادة معدنية وحُفظ في شكله الأصلي)",
 "かせきがく": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "かせきこ": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة…)",
 "かせきさい": "حمل زائد (عبء مفرط)",
 "かせきねんりょう": "وَقُود أُحْفُورِيّ",
 "かせぎ": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات…)\nمثال: دُفعت الأجور نقداً / أَيِّل",
 "かせぎがしら": "مُعِيل, عَائِل",
 "かせぎだか": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات…)\nمثال: دُفعت الأجور نقداً",
 "かせぎだす": "كَسَبَ",
 "かせぎて": "مُعِيل, عَائِل",
 "かせぎどき": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "かせぎにん": "مُعِيل, عَائِل",
 "かせぎぬし": "مُعِيل, عَائِل",
 "かせぎ高": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات…)\nمثال: دُفعت الأجور نقداً",
 "かせぐ": "كَسَبَ / إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة. / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر))\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "かせげる": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "かせつ": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية. / افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "かせる": "جُلْبَة",
 "かせん": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))\nمثال: 下線のある文を訳しなさい。 — ترجم ما تحته خط. / ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية) / احتكار القلة / نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ…)\nمثال: عبر جوناس النهر. / صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل…)\nمثال: هبط الصاروخ بدون مشاكل. / الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما)\nمثال: خط المواجهة هو مكان الحدث / التفاف, دوران (عملية الدوران أو اللف أو الطي حول محور مركزي) / سفينة حارقة (سلاح يتكون من سفينة تحمل متفجرات تُترك لتنجرف لتدمير سفن العدو) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "かせんしき": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "かせんじき": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "かぜ": "رِيح, ريح / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب. / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "かぜあたりがつよい": "عَاصِف",
 "かぜあたりのつよい": "عَاصِف",
 "かぜあな": "ثقب تهوية (ثقب يسمح بمرور الهواء)",
 "かぜい": "جباية الضرائب, فرض الضرائب (فرض الضرائب؛ ممارسة الحكومة في جباية الضرائب على رعايا الدولة)",
 "かぜいりつ": "معدل الضريبة, نسبة الضريبة (المعدل المستخدم لحساب الالتزام الضريبي)",
 "かぜがつよい": "عَاصِف",
 "かぜくさ": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "かぜぐすり": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "かぜしょうこうぐん": "زُكَام",
 "かぜたつ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "かぜだつ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "かぜとおし": "تَهْوِيَة / اِتِّصَالَات, اِتِّصَال",
 "かぜにやなぎ": "بصوت خافت, بهدوء (بحجم صوت منخفض)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "かぜぬき": "ثقب تهوية (ثقب يسمح بمرور الهواء)",
 "かぜのうわさ": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "かぜのこ": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "かぜのたより": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "かぜのつて": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
