 "こうちしょ": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "こうちゃ": "شَاي أَسْوَد (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "こうちゃく": "اِلْتِصَاق / رَدْب / طَرِيق مَسْدُود, مَأْزِق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "こうちゃくざい": "غِرَاء, لِزَاق / لَصَّقَ",
 "こうちゃくじょうたい": "رَدْب / طَرِيق مَسْدُود, مَأْزِق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "こうちゅう": "خُنْفُسَاء",
 "こうちゅうるい": "خُنْفُسَاء",
 "こうちょう": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "こうちょく": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "こうちん": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "こうつう": "مُرُور / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر / حِوَار / جِمَاع (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "こうつうきかん": "نَقْل, نَقْلِيَّات",
 "こうつうしゃだん": "حَجْر صِحِّيّ, عَزْل (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "こうつうしんごう": "إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة",
 "こうつうじゅうたい": "اِزْدِحَام الْمُرُور, اِخْتِنَاق مُرُورِيّ",
 "こうつうひょうしき": "لَافِتَة مُرُور, عَلَامَة طَرِيق",
 "こうつうりょう": "مُرُور",
 "こうつごう": "مُنَاسِب, مُلَائِم",
 "こうてい": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "こうていえき": "حَمَّى قُلَاعِيَّة (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "こうていおうとう": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "こうていひょう": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / خَرِيطَةُ الطَّرِيق (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "こうていぶん": "جُمْلَةٌ مُثْبَتَةٌ (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "こうてき": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "こうてつ": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "こうてつせい": "فُولَاذ",
 "こうてん": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "こうてんし": "قُبَّرَة",
 "こうてんせい": "مُكْتَسَب",
 "こうてんせいめんえきふぜんしょうこうぐん": "إِيدْز, سِيدَا",
 "こうてんてき": "مُكْتَسَب / البعديَة",
 "こうでい": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "こうでん": "كَابْل",
 "こうでんあつ": "الفُوُلطِيَةُ مُرتَفِعَةٌ",
 "こうと": "إِيدُو",
 "こうとう": "حِزْب, حِزْب سِيَاسِيّ (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "こうとうえん": "اِنْتَهاب الحَنْجَرَة",
 "こうとうがい": "لِسَان اَلْمِزْمَار (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "こうとうがっこう": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "こうとうしき": "مُطَابَقَة / هُوِيَّة",
 "こうとうしもん": "مُقَابَلَة",
 "こうとうてき": "متسام",
 "こうとうべんむかん": "مُفَوَّضٌ سَامٍ",
 "こうとうむけい": "عَبَثِيّ, سَخِيف",
 "こうとうよう": "فص قذالي",
 "こうとうりゅうき": "تُفَّاحَة آدَم, حَرْقَدَة",
 "こうど": "هَادِيس",
 "こうどう": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / عَدْل, إِنْصَاف (عَدْل) / عَدْل, عَدَالَة (عَدْل) / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "こうどうか": "فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "こうどうきはん": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "こうどうこう": "اَلْفَجْر اَلْكَاذِب",
 "こうどうしゅぎ": "نَشَاطِيَّة",
 "こうどうしょく": "حِصَّة / قَنَّنَ (قلل الكمية واقتصد بها؛ وضع الشيء في قَنَانِي)",
 "こうどうたい": "أَبْرَاجُ السَّمَاء",
 "こうどうてき": "نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور.",
 "こうどうにうつる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "こうどうは": "فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "こうどうはんい": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "こうどうりょく": "طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "こうどうをとる": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "こうどか": "تَرْقِيَة",
 "こうどく": "قِرَاءَة",
 "こうどくしゃ": "قَارِئ, قَارِئَة / قَارِئ",
 "こうどくそ": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "こうどこうつうシステム": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "こうどつうしんシステムそうごせつぞく": "قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "こうどどうろこうつうシステム": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "こうない": "فَمَوِيّ / شَفَهِيّ / شَفَوِيّ / مَنْطُوق",
 "こうないず": "خَرِيطَة (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "こうないせいこう": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "こうないほうそう": "إِعْلَان, بَلَاغ",
 "こうなん": "عَاقِبَة / نَتِيجَة",
 "こうにさんかたんそけっしょう": "فرط ثنائي أكسيد الكربون في الدم",
 "こうにゅう": "شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "こうにゅうひん": "شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "こうにゅうぶつ": "شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "こうにわかつ": "فِقْرَة, بَنْد",
 "こうにん": "خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "こうにんしゃ": "خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "こうねつ": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "こうねつびょう": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "こうねん": "شَيْخُوخَة, عُجُوز",
 "こうねんき": "إِيَاس",
 "こうねんれい": "مُسِنّ, مُسِنَّة",
 "こうねんれいか": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "こうのう": "تَأْثِير, أَثَر",
 "こうのくすりはおつのどく": "مَصَائِبُ قَوْمٍ عِنْدَ قَوْمٍ فَوَائِدُ",
 "こうのとり": "لَقْلَق",
 "こうのもの": "مُحَارِب قَدِيم",
 "こうは": "صَقْر, بَاز",
 "こうはい": "صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "こうはいしゅ": "هَجِين",
 "こうはく": "رَشْوَة / رشوة",
 "こうはつひん": "إِجْمالِيّ, جامِع",
 "こうはん": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "こうはんてい": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "こうば": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "こうばい": "مُنْحَدَر / مَيْل",
 "こうばいしゃ": "مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز.",
 "こうばいそう": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
