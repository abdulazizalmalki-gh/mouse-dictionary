 "尊敬": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊敬心": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊王党": "إِمْبَرِيَالِيّ / إِمْبَرِيَالِيّ, إِمْبِرْيالِيَّة",
 "尊簡": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "尊翰": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "尊貴": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "尊重": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊顔": "مَلَامِح",
 "尋": "قامة",
 "尋ぬ": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "尋ね": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "尋ねる": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "尋問": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "尋常": "شَائِع / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / إِفْرَنْجِيّ / مُتْوَاضِع / مُحْتَشِم",
 "尋常ならざる": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "尋常一様": "عَادِيّ, مَأْلُوف",
 "尋常小学校": "مَدْرَسَة اَلاِبْتِدَائِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "尋常性ざ瘡": "حَبُّ الشَّبَاب (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "尋常性痤瘡": "حَبُّ الشَّبَاب (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "尋常性白斑": "بُهَاق",
 "對": "فِي مُقَابِل, ضِِدَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى اَلْعَكْس, ضِِدَّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي. / أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟ / ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "對して": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "導き": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "導きだす": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "導き出す": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "導き手": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "導く": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / استمد / استنتج",
 "導体": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
