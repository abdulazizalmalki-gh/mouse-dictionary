 "妄想": "خِدَاع, ضَلَالَة / غَرُور",
 "妄想狂": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "妄想症": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "妄想的": "خُرَافِيّ",
 "妄用": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "妄言": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "妄語": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "妄説": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "妊娠": "حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "妊娠中絶": "خِدَاج, إِجْهَاض",
 "妊孕": "حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
