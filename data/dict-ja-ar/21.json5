 "巨万": "ضَخْم, عِمْلَاق",
 "巨人": "عِمْلَاق",
 "巨人軍": "عِمْلَاق",
 "巨億": "مِلْيُون, ١٠٠٠٠٠٠",
 "巨匠": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "巨嘴鳥": "طُوقَان",
