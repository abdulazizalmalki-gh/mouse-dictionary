 "差": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "差し": "بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / عَائِق, عَقَبَة",
 "差しさわり": "عَقَبَة, حَاجِز / إِزْعَاج",
 "差しつける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "差しで": "وَجْهًا لِوَجْه",
 "差し上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "差し上る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "差し交わす": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "差し付ける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "差し伸べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差し傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "差し入れる": "أَدْخَلَ / نَقَلَ",
 "差し入れ口": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "差し出がましい": "صَاعِدًا / مُهَاجِم",
 "差し出し先": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "差し出す": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / تَضْحِيَة, قُرْبَان / ضَحَّى / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し出る": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا) / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "差し合い": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差し向い": "وَجْهًا لِوَجْه",
 "差し向かい": "وَجْهًا لِوَجْه",
 "差し向ける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "差し延べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差し引き": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差し引き勘定": "رَصِيد",
 "差し引く": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "差し当たる": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "差し押える": "إِسْتَوْلَى عَلَى",
 "差し押さえ": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "差し押さえる": "إِسْتَوْلَى عَلَى",
 "差し招く": "أَشَارَ, أَوْمَأَ",
 "差し挟む": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "差し挾む": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "差し掛かる": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "差し控える": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "差し換え": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差し換える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "差し支え": "عَائِق, عَقَبَة",
 "差し支える": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "差し昇る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "差し替え": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差し替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "差し止め": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差し止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "差し油": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "差し渡し": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "差し物": "دَبُّوس / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "差し立て": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し立てる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差し紙": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "差し繰る": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "差し置く": "نَاهِيك",
 "差し覗く": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "差し許す": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "差し詰め": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "差し越す": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し込み": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "差し込み口": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة",
 "差し込む": "أَدْخَلَ",
 "差し金": "اِقْتِرَاح, مُقْتَرَح",
 "差し障り": "عَقَبَة, حَاجِز / إِزْعَاج",
 "差し障る": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "差し響く": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "差す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَدْخَلَ",
 "差をつける": "مَيَّزَ",
 "差を付ける": "مَيَّزَ",
 "差上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "差上る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "差交す": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "差交わす": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "差付ける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "差伸べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "差入口": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "差出る": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا) / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "差出人": "مُرْسِل, مُرْسِلَة",
 "差分": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "差別": "تَمْيِيْز / تَفْرِيق / تَمْيِيز",
 "差別主義者": "مُتَعَصِّب",
 "差向い": "وَجْهًا لِوَجْه",
 "差向ける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "差延べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差引": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差引き": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差引く": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "差引勘定": "رَصِيد",
 "差押": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "差押え": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "差押える": "إِسْتَوْلَى عَلَى",
 "差押さえる": "إِسْتَوْلَى عَلَى",
 "差控える": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "差換え": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差損": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "差支え": "عَائِق, عَقَبَة",
 "差支える": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "差替え": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差止": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差止め": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "差物": "دَبُّوس / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "差略": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "差異": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "差立て": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差立てる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差等": "تَدَرُّج / تَدْرِيج",
 "差置く": "نَاهِيك",
 "差覗く": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "差込": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "差込み": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "差込む": "أَدْخَلَ",
 "差込口": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة",
 "差遣": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差配": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "差金": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "差響く": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "差額": "رَصِيد",
 "己": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لوحد / لحال",
 "己が": "ـِي, ـي",
 "己がじし": "كُلّ",
 "己ら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "己れ": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لوحد / لحال",
 "己等": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / ـنِي, ـنِيَ / ـِي, ـِيَ",
 "己等達": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "已の事": "تَقْرِيبًا, عَلَى وَشْك",
 "已むを得ず": "حَتْماً, بِالضَّرُورَة",
 "已む得ず": "حَتْماً, بِالضَّرُورَة",
 "已む無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "已む無し": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "已める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / أَلْغَى, أَبْطَلَ",
 "已往": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "巳": "ثُعْبَان, حَنَش",
 "巴旦杏": "بَرْقُوق",
 "巷": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور / شَارِع, زَنَقَة / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث. / قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "巷説": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "巷談": "إِشَاعَة, شَائِعَة",
 "巷間": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "巻": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / رِيح, ريح / لَفَّ / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / عَقِب, كَعْب / كَعْب",
 "巻き": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / رِيح, ريح / لَفَّ / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / عَقِب, كَعْب / كَعْب",
 "巻きあげ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
