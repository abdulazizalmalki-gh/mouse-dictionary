 "工具入": "صَنْدُوق اَلْعِدَّة (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "工具箱": "صَنْدُوق اَلْعِدَّة (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "工務": "هَنْدَسَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "工務店": "بَنَّاء, بَنَّاءَة (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "工匠": "صَانِع, حِرَفِيّ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "工口": "شَبَقِيّ, جِنْسِيّ",
 "工場": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "工場実習": "قُنّ, خُمّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "工夫": "اِخْتَرَعَ / أَدَاة, جِهَاز",
 "工学": "هَنْدَسَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "工学者": "مُهَنْدِس, مُهَنْدِسَة (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "工廠": "تِرْسَانَة",
 "工房": "مَشْغَل, وَرْشَة",
 "工手": "عَامِل, شَغِّيل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "工料": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "工業": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "工業化": "تَصْنِيع, تَحَوُّل صِنَاعِيّ",
 "工率": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "工程": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "工芸": "حِرْفَة, صَنْعَة",
 "工芸品": "حِرْفَة يَدَوِيَّة",
 "工芸家": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "工賃": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "工銭": "أَجْر, رَاتِب (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / شَنَّ ((شَنَّ) يَشُنُّ شَنًّا: يَبس، وأخْلَق؛ يقال (شنَّت) القِرْبَةُ، وشنَّ الجملُ من العطَشِ ونحوه)\nمثال: ركبت سيارة أجرة.",
 "工面": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "工順": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "左": "يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة) / يساري / يَسَارًا, شِمَالًا / إِلَى اَلْيَسَار, إِلَى اَلشِّمَال (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / بِقِي (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: ذهب سامي إلى اليسار. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / شَارِب",
 "左党": "شَارِب",
 "左利き": "شَارِب",
 "左前": "تَرَاجُع",
 "左右": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / جَانِب / صَفْحَة",
 "左右相称": "تَنَاظُر",
 "左巻": "غَيْر طَبِيعِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "左巻き": "غَيْر طَبِيعِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "左手": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة) / يساري / يَسَارًا, شِمَالًا / إِلَى اَلْيَسَار, إِلَى اَلشِّمَال (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / بِقِي (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: ذهب سامي إلى اليسار.",
 "左様": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "左翼系": "يَسَارِيّ",
 "左腕": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左舷": "مِينَاء, مينا / مَنْفَذ / كَيَّفَ, غَيَّرَ",
 "左袒": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "左褄": "غَيْشَا",
 "左記": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "巧い": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "巧く": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / بِنَجَاحٍ",
 "巧まざる": "طَبِيعِيّ",
 "巧まずして": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "巧まぬ": "طَبِيعِيّ",
 "巧み": "مَاهِر, حَاذِق / حِرْفَة, صَنْعَة / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "巧む": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "巧妙": "عَبْقَرِيّ",
 "巧手": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
