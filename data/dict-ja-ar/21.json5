 "大路": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大軍": "اَلْحَرْب الْعُظْمَى",
 "大転換": "تغير البحر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "大辟": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "大逆": "خِيَانَة عُظْمَى",
 "大逆罪": "خِيَانَة عُظْمَى",
 "大通": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大通り": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大連": "دَالْيَان",
 "大道": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "大道具": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "大道商人": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "大邦": "قُوَّة عُظْمَى (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "大邱": "دَايْغُو",
 "大邸宅": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "大部": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "大部分": "غَالِبِيَّة, أَغْلَبِيّة",
 "大部隊": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "大都": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "大都会": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "大都市": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "大都市圏": "مَديِنَةٌ ضَخْمَةٌ",
 "大量": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء.",
 "大量出血": "نَزِيف, نَزْف",
 "大量殺人": "قَتْل جَمَاعِيّ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "大量殺害": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)",
 "大量破壊兵器": "سِلَاح دَمَار شَامِل",
 "大量虐殺": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "大金星": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "大釘": "سنبلة",
 "大釜": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "大鋸屑": "نُشَارَة",
 "大鍋": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "大鎌": "مِنْجَل, مِقْضَب",
 "大鑑": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "大阪": "أُوسَاكَا",
 "大阪民国": "أُوسَاكَا",
 "大降り": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "大陸": "قَارَّة",
 "大陸性": "قَارِّيّ",
 "大陸法": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "大陸的": "قَارِّيّ / هَادِئ / طَمْأَنَ",
 "大隊": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "大雑把": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "大難": "بَلَاء, بُؤْس",
 "大雨": "وَابِل, مَطَر غَزِير",
 "大韓民国": "جُمْهُورِيَة كُورِيَا",
 "大願": "مَطْمَح",
 "大風": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية. / هَادِئ / طَمْأَنَ",
 "大食": "نَهَم, شَرَه",
 "大食い": "نَهَم, شَرَه",
