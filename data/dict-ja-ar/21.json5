 "学派": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学生": "طَالِب, طَالِبَة",
 "学生服": "زِي مَدْرَسِيّ",
 "学的": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "学科": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "学究": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "学究的": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "学窓": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学童": "تِلْمِيذ, تِلْمِيذَة",
 "学級": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "学績": "إِنْجَاز",
 "学群": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学習": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "学習帳": "دَفْتَر, كُرَّاس",
 "学習性無力感": "عَجْز مُتَعَلِّم, عَجْز مُكْتَسَب",
 "学習用": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "学習者": "طَالِب, طَالِبَة",
 "学者": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "学舎": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "学芸員": "منظم معارض",
 "学術": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء) / عِلْم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "学術的": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "学術論文": "رِسَالَة",
 "学説": "نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "学課": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس.",
 "学識": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "学部": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "学長": "رَئِيس, رَئِيسَة",
 "学院": "مَعْهَد (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم إذا انتأَوا عنهُ رجعوا إليه. الجمع مَعَاهِد. استخدام قديم) / أنشأ (أَوْجَدَ، خَلَقَ؛ بَدَأَ)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا",
 "孩児": "رَضِيع",
 "孫": "حَفِيد, حَفِيدَة",
 "孫さん": "حَفِيد, حَفِيدَة",
 "孫娘": "حَفِيدَة",
