 "酒客譫妄症": "هذيان ارتعاشي (هذيان حاد ناجم عن التسمم الكحولي)",
 "酒害": "كُحُولِيَّة",
 "酒宴": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "酒家": "مُتَّجِر كُحُول / سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "酒屋": "مُتَّجِر كُحُول / صاحب مصنع بيرة (المالك أو المدير لمصنع بيرة) / خمّار, صانع البيرة (شخص يصنع البيرة من الشعير والجنجل والماء)",
 "酒店": "مُتَّجِر كُحُول / فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق.",
 "酒徒": "شَارِب",
 "酒房": "مُتَّجِر كُحُول",
 "酒手": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "酒楼": "مَطْعَم",
 "酒気": "تسمم كحولي, ثمالة (حالة مؤقتة ناتجة عن الاستهلاك المفرط للكحول)",
 "酒池肉林": "باخاناليا, حفلة مجون (تجمع جامح ينطوي على الإفراط في الشرب والانحلال الجنسي)",
 "酒皶": "العد الوردي, الوردية (مرض جلدي يصيب البالغين (غالبًا النساء) تتضخم فيه الأوعية الدموية في الوجه مما يؤدي إلى مظهر متورد)",
 "酒皻": "العد الوردي, الوردية (مرض جلدي يصيب البالغين (غالبًا النساء) تتضخم فيه الأوعية الدموية في الوجه مما يؤدي إلى مظهر متورد)",
 "酒盛": "جلسة شرب (فترة طويلة من الشرب)",
 "酒盛り": "جلسة شرب (فترة طويلة من الشرب)",
 "酒石": "جِيرُ الأَسْنَان, قَلَح (طبقة قشرية تتكون على الأسنان واللثة) / تتار (عضو في الشعب المنغولي في آسيا الوسطى الذي غزا روسيا في القرن الثالث عشر) / امرأة شرسة, صارمة (امرأة يقظة بشراسة وبغيضة) / طرطرات البوتاسيوم الهيدروجينية, كريم التارتار (ملح يستخدم بشكل خاص في مسحوق الخبز (البيكنج بودر))",
 "酒石英": "طرطرات البوتاسيوم الهيدروجينية, كريم التارتار (ملح يستخدم بشكل خاص في مسحوق الخبز (البيكنج بودر))",
 "酒石酸": "حمض الطرطريك (حمض يوجد في العديد من الفواكه؛ يستخدم في المشروبات الغازية والحلويات ومسحوق الخبز)",
 "酒石酸塩": "طرطرات (ملح أو إستر لحمض الطرطريك)",
 "酒石酸水素カリウム": "طرطرات البوتاسيوم الهيدروجينية, كريم التارتار (ملح يستخدم بشكل خاص في مسحوق الخبز (البيكنج بودر))",
 "酒精": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "酒精強化ワイン": "نبيذ مقوى (نبيذ أضيف إليه كحول (عادة براندي العنب))",
 "酒肆": "حَانَة, بَار",
 "酒興": "ابتهاج, احتفال صاخب (احتفال صاخب؛ بهجة ومرح)",
 "酒色": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "酒蔵": "سرداب, قبو نبيذ (مساحة تخزين حيث يُخزن النبيذ) / حَانَة, بَار",
 "酒造": "تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة)",
 "酒造場": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "酒造家": "صاحب مصنع بيرة (المالك أو المدير لمصنع بيرة) / خمّار, صانع البيرة (شخص يصنع البيرة من الشعير والجنجل والماء)",
 "酒面雁": "إوز صيني (إوز بري كبير جداً من شمال شرق آسيا؛ يتزاوج بحرية مع الإوز الرمادي)",
 "酒類": "كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره",
 "酒飲み": "شَارِب",
 "酔い": "سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر. / دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "酔いが回る": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "酔いが覚める": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "酔いどれ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "酔いを覚ます": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "酔い心地": "ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول)) / ثَمِل, نَشْوَان (كأنه تحت تأثير الكحول مجازاً)\nمثال: حشد صاخب من البحارة المخمورين",
 "酔う": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "酔っぱらい": "سَكْرَان, ثَمِل (من شرب الخمر حتى سَكِرَ) / سِكِّير, خِمِّير\nمثال: تبدو كأنها سكرانة.",
 "酔っぱらう": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "酔っ払い": "سَكْرَان, ثَمِل (من شرب الخمر حتى سَكِرَ) / سِكِّير, خِمِّير\nمثال: تبدو كأنها سكرانة.",
 "酔っ払う": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "酔わす": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "酔わせる": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "酔余": "سِكِّير, مُدْمِن الخَمْر (مُنْغَمِس فِي شُرْب الكُحُول أَوْ يَتَّسِم بِهِ)",
 "酔態": "سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "酔歩": "سير عشوائي (عملية عشوائية تتكون من سلسلة من التغييرات التي يتم تحديد خصائص كل منها (مثل الحجم أو الاتجاه) عن طريق الصدفة)",
 "酔漢": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "酔狂": "نَزْوَة",
 "酔芙蓉": "ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة)",
 "酢": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "酢文字": "سُوشِي",
 "酢豆腐": "مُنَصِّبٌ نَفْسَهُ (يصف نفسه بصفة ما دون تأييد من الآخرين)",
 "酢酸": "حمض الأسيتيك, حمض الخليك (سائل لاذع عديم اللون يستخدم على نطاق واسع في تصنيع البلاستيك والمستحضرات الصيدلانية)",
 "酢酸エチル": "إيثيل أسيتات, خلات الإيثيل (إستر سائل متطاير قابل للاشتعال عديم اللون عطري يصنع من الإيثانول وحمض الأسيتيك؛ يستخدم في المنكهات والعطور وكمذيب للبلاستيك)",
 "酢酸セルロース": "أسيتات السليلوز (إستر لحمض الأسيتيك؛ يُستخدم في الألياف والأقمشة والأفلام الفوتوغرافية والورنيش)",
 "酢酸塩": "أسيتات, رايون أسيتات (قماش مصنوع من ألياف أسيتات السليلوز) / أسيتات, إيثانوات (ملح أو إستر لحمض الأسيتيك (الخليك))",
 "酢酸繊維素": "أسيتات السليلوز (إستر لحمض الأسيتيك؛ يُستخدم في الألياف والأقمشة والأفلام الفوتوغرافية والورنيش)",
 "酢酸鉛": "أسيتات الرصاص, سكر الرصاص (مادة صلبة بيضاء سامة تستخدم في صباغة القطن وفي صنع المينا والورنيش)",
 "酣": "اِرْتِفَاع",
 "酥": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "酥油": "أَصْطَرَك, أَسْطَرَك",
 "酩酊": "سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "酩酊者": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "酪漿": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "酪素": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "酪製品": "منتجات الألبان (الحليب والزبدة والجبن)",
 "酪農": "إنتاج الألبان, مزارع الألبان (عمل إنتاج الألبان)",
 "酪農品": "منتجات الألبان (الحليب والزبدة والجبن)",
 "酪農場": "مزرعة ألبان (مزرعة يتم فيها إنتاج منتجات الألبان)",
 "酪農家": "بائع الحليب, مزارع الألبان (مالك أو مدير لمزرعة ألبان أو منشأة لمنتجات الألبان)",
 "酪酸": "حمض البيوتيريك, حمض الزبدة (حمض دهني كريه الرائحة يوجد خاصة في الزبدة)",
 "酬い": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "酬ゆ": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "酵母": "خَمِيرَة",
 "酵素": "إِنْزِيم",
 "酵素学": "علم الإنزيمات (فرع الكيمياء الحيوية الذي يتعامل مع الطبيعة الكيميائية والنشاط البيولوجي للإنزيمات)",
 "酷": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "酷い": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مَأْسَاوِيّ, تْرَاجِيدِيّ / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "酷い仕打ち": "غبن, معاملة مجحفة (معاملة غير عادلة)",
 "酷く": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة)\nمثال: مثير للاهتمام جداً",
 "酷すぎる": "صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "酷たらしい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "酷のある": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "酷使": "اِسْتِغْلَال (استخدام الموارد أو الظروف أو الفرص بشكل مثمر أو للحصول على فائدة؛ استغلال شخص أو موقف بشكل غير عادل لتحقيق مكاسب شخصية)\nمثال: يبدو أن رئيس القسم يحب استغلال سلطته.",
 "酷悪": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "酷烈": "صَرَامَة",
 "酷薄": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "酷薄無情": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "酷評": "تهجم لاذع, هجوم عنيف (هجوم لفظي صاعق)",
 "酷遇": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "酷過ぎる": "صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "酸": "حَامِض / لَاذِع / حامض / حَامِض, حَمْض / تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / حموضة (خاصية كون الشيء حمضياً) / حموضة, طعم حامض (تجربة التذوق عند تناول الخل أو عصير الليمون)",
 "酸い": "حَامِض",
 "酸っぱい": "حَامِض",
 "酸っぱみ": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / حموضة (خاصية كون الشيء حمضياً) / حموضة, طعم حامض (تجربة التذوق عند تناول الخل أو عصير الليمون)",
 "酸み": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / حموضة (خاصية كون الشيء حمضياً) / حموضة, طعم حامض (تجربة التذوق عند تناول الخل أو عصير الليمون)",
 "酸価": "رَقَم الحُمُوضَة, قِيمَة حَمْضِيَّة ((في الكيمياء) كمية الحمض الحر الموجودة في الدهون مقاسة بملليغرامات هيدروكسيد البوتاسيوم اللازمة لمعادلتها)",
 "酸化": "أكسدة (عملية التأكسد؛ إضافة الأكسجين إلى مركب مع فقدان الإلكترونات؛ وتحدث دائماً مصحوبة بالاختزال)",
 "酸化アルミニウム": "أكسيد الألمنيوم, ألومينا (أي من أشكال أكسيد الألمنيوم المختلفة التي توجد بشكل طبيعي مثل الكورندوم)",
 "酸化カルシウム": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "酸化ジルコニウム": "أكسيد الزركونيوم, ثاني أكسيد الزركونيوم (أكسيد بلوري أبيض؛ يستخدم في الحراريات والعزل والمواد الكاشطة والمينا والزجاج)",
 "酸化チタン": "ثاني أكسيد التيتانيوم (مسحوق أبيض يستخدم كصبغة لقدرته العالية على التغطية وقوة تحمله)",
 "酸化バリウム": "أكسيد الباريوم, أول أكسيد الباريوم (أكسيد للباريوم؛ مسحوق أبيض سام)",
 "酸化ヒ素": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "酸化マグネシウム": "بيريكلاز, مغنيسيا (معدن صلب أبيض يوجد بشكل طبيعي كأكسيد مغنيسيوم؛ مصدر للمغنيسيوم)",
 "酸化亜鉛": "أكسيد الخارصين, أكسيد الزنك (أكسيد الزنك؛ مسحوق أبيض يستخدم كصبغة أو في مستحضرات التجميل أو الزجاج أو الأحبار وفي مرهم الزنك)",
 "酸化剤": "مؤكسد",
 "酸化数": "حَالَة الْأَكْسَدَة, عَدَد الْأَكْسَدَة (درجة أكسدة ذرة أو أيون أو جزيء؛ بالنسبة للذرات أو الأيونات البسيطة، يساوي عدد الأكسدة الشحنة الأيونية)\nمثال: عدد الأكسدة للهيدروجين هو +1 وللأكسجين هو -2",
 "酸化物": "أُكْسِيد",
 "酸化的": "تَأَكْسُدِيّ (يحدث في وجود الأكسجين)",
 "酸化的リン酸化": "فسفرة تأكسدية",
 "酸化的燐酸化": "فسفرة تأكسدية",
 "酸化砒素": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "酸化窒素": "أكسيد النيتروجين (أي من أكاسيد النيتروجين المتعددة التي تتكون بفعل حمض النيتريك على المواد القابلة للأكسدة؛ موجودة في عوادم السيارات)",
 "酸化還元": "أكسدة واختزال (تفاعل كيميائي عكسي يكون فيه أحد التفاعلين أكسدة والعكسي اختزالاً)",
 "酸化還元反応": "أكسدة واختزال (تفاعل كيميائي عكسي يكون فيه أحد التفاعلين أكسدة والعكسي اختزالاً)",
 "酸化還元酵素": "أوكسيدوريدوكتاز (إنزيم يحفز الأكسدة والاختزال)",
 "酸化酵素": "أوكسيداز (أي من الإنزيمات التي تحفز الأكسدة البيولوجية)",
 "酸化銅": "أكسيد النحاس (أكسيد للنحاس)",
 "酸化防止剤": "مضاد للأكسدة (مادة تمنع الأكسدة أو تمنع التفاعلات التي يعززها الأكسجين أو البيروكسيدات)",
 "酸味": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / حموضة (خاصية كون الشيء حمضياً) / حموضة, طعم حامض (تجربة التذوق عند تناول الخل أو عصير الليمون)",
 "酸塊": "عِنَب الثَعْلَب",
 "酸塩基平衡": "توازن الحمض والقاعدة ((في علم وظائف الأعضاء) التوازن الطبيعي بين الأحماض والقلويات في الجسم)\nمثال: مع وجود توازن طبيعي للحمض والقاعدة في الجسم، يكون الدم قلويًا قليلاً",
 "酸塩基指示薬": "كاشف حمض-قاعدة, مؤشر الرقم الهيدروجيني (مؤشر يتغير لونه عند الانتقال من المحاليل الحمضية إلى القاعدية)",
 "酸度": "حُمُوضَة",
 "酸性": "حُمُوضَة / حِمْضِيّ (كونه أو يحتوي على حمض؛ محلول يحتوي على فائض من ذرات الهيدروجين (أس هيدروجيني أقل من 7)) / حَامِض, حَمْضِيّ (ذو مذاق حامض)",
 "酸性化": "تحميض, تخليل (عملية التحول إلى حمض أو التحويل إلى مادة حمضية)",
 "酸性度": "حُمُوضَة",
 "酸性染料": "صبغة حمضية (صبغة يكون فيها الكروموفور (حامل اللون) جزءاً من أيون سالب)",
 "酸性血症": "حُمَّاض",
 "酸性雨": "مَطَر حَمْضِيّ (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "酸敗": "تحميض, تخليل (عملية التحول إلى حمض أو التحويل إلى مادة حمضية)",
 "酸模": "حميض الحدائق, حميض حامض (حميض أوروبي بأوراق سهمية كبيرة حمضية قليلاً يزرع في جميع أنحاء المنطقة المعتدلة الشمالية للسلطة والخضروات الربيعية) / حميض ترسي, حميض فرنسي (نبات معمر منخفض بأوراق بيضاوية إلى رمحية صغيرة خضراء فضية)",
 "酸洗": "مُخَلَّل",
 "酸漿": "حرنكش, كرز أرضي",
 "酸漿貝": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام)",
 "酸素": "أُكْسِجِين\nمثال: 酸素が無ければ生きられない。 — لا يمكنك العيش من دون أكسجين.",
 "酸素マスク": "قناع أكسجين (جهاز تنفس يوضع فوق الفم والأنف؛ يزود بالأكسجين من خزان تخزين مرفق)",
 "酸素処理": "أكسجة, تزويد بالأكسجين (عملية توفير الأكسجين أو الاتحاد معه أو المعالجة به)\nمثال: أكسجة الدم",
 "酸素化": "أكسجة, تزويد بالأكسجين (عملية توفير الأكسجين أو الاتحاد معه أو المعالجة به)\nمثال: أكسجة الدم",
 "酸素欠乏": "انعدام الأكسجين (نقص حاد في الأكسجة؛ غياب الأكسجين في الغازات المستنشقة أو في الدم الشرياني أو في الأنسجة)",
 "酸素欠乏症": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "酸素添加酵素": "أكسيجيناز (أوكسيدوريدوكتاز يحفز دمج الأكسجين الجزيئي)",
 "酸素系": "أُكْسِجِين",
 "酸素負債": "دَيْن الأكسجين (عجز تراكمي في الأكسجين ناتج عن تمرين مكثف؛ يجب تعويض العجز عندما يعود الجسم للراحة)",
 "酸葉": "حُمَّاض بُسْتَانِيّ / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "酸血": "حموضة الدم (اضطراب دموي يتميز بزيادة تركيز أيونات الهيدروجين في الدم)",
 "酸血症": "حموضة الدم (اضطراب دموي يتميز بزيادة تركيز أيونات الهيدروجين في الدم)",
 "酸酷": "بِشَاعَة, قَسْوَة",
 "酸類": "حَامِض / لَاذِع / حامض / حَامِض, حَمْض",
 "酸鼻": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "醂す": "غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان) / خليط كبريتيدي خام, مات (خليط من الكبريتيدات يتشكل عند صهر خامات المعادن الكبريتيدية)",
 "醇": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة) / صَافٍ, اَلصَّافِي",
 "醇乎": "صَافٍ, اَلصَّافِي",
 "醇化": "تَكْرِير / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "醋酸": "حمض الأسيتيك, حمض الخليك (سائل لاذع عديم اللون يستخدم على نطاق واسع في تصنيع البلاستيك والمستحضرات الصيدلانية)",
 "醍醐": "سَمْن حَيَوَانِيّ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "醒ます": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ) / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "醒めやらぬ": "تريث, تلكؤ (فعل التريث أو البقاء لفترة أطول)",
 "醒める": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "醒め遣らぬ": "تريث, تلكؤ (فعل التريث أو البقاء لفترة أطول)",
 "醒覚": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "醗酵": "تخمر (عملية يسبب فيها عامل ما تحلل مادة عضوية إلى مواد أبسط؛ وخاصة التحلل اللاهوائي للسكر إلى كحول) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة",
 "醜": "دمامة, قبح (صفات المظهر التي لا تمنح المتعة للحواس) / خباثة, دناءة (صفة الشر والفساد الأخلاقي) / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل. / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / غير جدير, لا يستحق (يفتقر إلى القيمة أو الاستحقاق) / غَيْرُ مُسْتَحِقٍّ (لَا يَسْتَحِقُّ التَّقْدِيرَ أَوِ المُكَافَأَةَ)\nمثال: طرد طالب يعتبر سلوكه غير جدير",
 "醜い": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / كَرِيه المَنْظَر (غير سار للنظر)",
 "醜いアヒルの子": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "醜名": "فَضِيحَة",
 "醜怪": "بَشِع, مُنَفِّر (قبيح لدرجة تبعث على الرعب) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "醜悪": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "醜業": "بِغَاءٌ, دَعَارَة",
 "醜業婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "醜聞": "فَضِيحَة",
 "醜語": "بذاء, كوبرولاليا (استخدام لا إرادي للغة بذيئة؛ غالباً ما يصاحب الاضطرابات العقلية)",
 "醜語症": "بذاء, كوبرولاليا (استخدام لا إرادي للغة بذيئة؛ غالباً ما يصاحب الاضطرابات العقلية)",
 "醞醸": "تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة) / إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "醤油": "صَلْصَةْ اَلصُّويَا",
 "醤蝦": "روبيان الأبوسوم (قشريات تشبه الروبيان تحمل إناثها البيض والصغار في كيس بين الأرجل)",
 "醪": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "醵金": "اِشْتِرَاك",
 "醸しだす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "醸し出す": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "醸す": "خَمَّرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "醸成": "تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة) / إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "醸母": "خَمِيرَة",
 "醸造": "تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة)",
 "醸造学": "علم التخمير (فرع الكيمياء المعني بالتخمير (كما في صناعة النبيذ أو التخمير أو التقطير))",
 "醸造家": "صاحب مصنع بيرة (المالك أو المدير لمصنع بيرة) / خمّار, صانع البيرة (شخص يصنع البيرة من الشعير والجنجل والماء)",
 "醸造所": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "醸造酒": "مشروب مخمر (مشروب مصنوع عن طريق النقع والغلي والتخمير بدلاً من التقطير)",
 "釁る": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "采": "هِرَاوَة / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "采は投げられた": "سبق السيف العذل, حُصِّلَ مَا فِي الصُدُورِ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "采六": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "采女佑": "عَالِيّ الرُتْبَة",
 "采振木": "ساسكاتون (توت أرجواني أو أحمر صالح للأكل)",
 "采配": "هِرَاوَة / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "采配を振る": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "采配を振るう": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
