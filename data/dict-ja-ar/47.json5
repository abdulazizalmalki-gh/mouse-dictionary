 "自裁": "مُنْتَحِر, مُنْتَحِرَة",
 "自製": "مَنْزِلِيّ",
 "自覚": "وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني. / ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "自覚的": "خَجُول, مُرْتَبِك مِنْ ذَاتِهِ (واعٍ بشكل مفرط وغير مريح بمظهره أو سلوكه) / مُدْرِكٌ لِنَفْسِهِ, وَاعٍ بِذَاتِهِ (مُدْرِكٌ لِذَاتِهِ كَفَرْدٍ وَلِكَيْنُونَتِهِ وَأَفْعَالِهِ وَأَفْكَارِهِ)",
 "自記気圧計": "باروجراف, مسجل الضغط الجوي (بارومتر مسجل؛ يسجل تلقائياً التغيرات في الضغط الجوي على الورق)",
 "自記温度計": "مقياس حرارة ذاتي التسجيل (مقياس حرارة يسجل درجة الحرارة تلقائياً)",
 "自認": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "自警": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين) / إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "自警団": "دِفَاع عَنِ النَّفْسِ",
 "自警団員": "عضو لجنة الأمن الأهلية (عضو في لجنة الأمن الأهلية)",
 "自讃": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "自負": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自負心": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自販機": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "自責": "إدانة النفس, اتهام الذات (اعتراف بأنك فشلت في فعل أو أن تكون شيئاً تعلم أنه يجب عليك فعله أو كونه)",
