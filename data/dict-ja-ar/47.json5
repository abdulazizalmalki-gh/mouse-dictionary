 "通底": "كَامِن, مُتَأَصِّل (في طبيعة الشيء وإن لم يكن ظاهراً للعيان) / أَسَاسِيّ, جَذْرِيّ (يتعلّق بالحقائق أو المبادئ الأساسية أو يتضمّنها) / سُفْلِيّ, كَامِن تَحْت (يقع تحت أو أسفل شيء آخر)",
 "通弁": "تَفْسِير",
 "通弊": "صدع عادي (صدع مائل يبدو فيه أن الجدار المعلق قد انزلق لأسفل بالنسبة للجدار السفلي)",
 "通教": "دورة بالمراسلة (دورة تقدم (بالبريد) من قبل مدرسة مراسلة)",
 "通時": "تطور اللغة, لسانيات تاريخية (دراسة التغير اللغوي)\nمثال: تزامن وتطور اللغة",
 "通時的": "تاريخي, تعاقبي (يُستخدم لدراسة ظاهرة (خاصة اللغة) مع تغيرها عبر الزمن)\nمثال: علم اللغة التاريخي",
 "通時言語学": "تطور اللغة, لسانيات تاريخية (دراسة التغير اللغوي)\nمثال: تزامن وتطور اللغة",
 "通有": "اشْتِرَاك, قَوَاسِم مُشْتَرَكَة (مشاركة سمات مشتركة) / الدهماء, العامة (طبقة تتكون من أشخاص يفتقرون إلى رتبة دينية أو نبيلة)",
 "通気": "تَهْوِيَة",
 "通気孔": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "通水": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "通流": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "通牒": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "通理": "عَقْلَانِيَّة (صفة الاتساق مع المنطق أو الاستناد إليه) / رجاحة عقل, عقلانية (حالة امتلاك الحس السليم والحكم الصائب)\nمثال: ربما تكون عقلانيته قد تضررت",
 "通用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "通用口": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "通用門": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "通知": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "通知書": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "通知状": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "通知票": "التقرير المدرسي عن الطالب",
 "通知簿": "التقرير المدرسي عن الطالب",
 "通知表": "التقرير المدرسي عن الطالب",
 "通称": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "通称名": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "通算": "مَجْمُوع",
 "通約": "نَقْص",
 "通航": "مِلَاحَة",
 "通船": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "通行": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "通行人": "عابر سبيل, مار (شخص يمر بشكل عارض أو بالصدفة)",
 "通行券": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "通行帯": "زُقَاق, ممر / مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "通行手形": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي?",
 "通行料": "خَسَائِر / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "通行料金": "خَسَائِر / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "通行権": "حرم الطريق, حق المرور (الممر المكون من مسار أو شريط من الأرض يملك شخص ما الحق القانوني في المرور عبره) / أولوية المرور, حق الأولوية (حق مركبة أو سفينة في أن تكون لها الأسبقية على أخرى) / حق المرور (امتياز شخص ما في المرور عبر أرض تخص شخصًا آخر)",
 "通行止": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "通行止め": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
