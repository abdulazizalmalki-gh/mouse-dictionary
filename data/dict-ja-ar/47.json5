 "逃げ足": "فرار, هروب (فعل المغادرة (بدون إذن) للمكان الذي من المتوقع أن تكون فيه)",
 "逃げ遂せる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "逃げ道": "مخرج, منفذ (فتحة تسمح بالهروب أو الخروج)\nمثال: أغلق المخرج",
 "逃す": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس.",
 "逃れ": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "逃れる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "逃亡": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "逃亡中": "بإسهاب, بشكل عام (بطريقة عامة)\nمثال: تحدث بإسهاب عن خططه",
 "逃亡犯": "هارب من العدالة (شخص مطلوب من قبل ضباط القانون؛ شخص يحاول التهرب من العدالة)",
 "逃亡犯罪人": "هارب من العدالة (شخص مطلوب من قبل ضباط القانون؛ شخص يحاول التهرب من العدالة)",
 "逃亡者": "آبِق",
 "逃口上": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "逃場": "مَلْجَأ, مَلَاذ",
 "逃走": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "逃避": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "逃避的": "حالم, هروبي (شخص يهرب إلى عالم من الخيال)",
 "逆": "عَكَسَ / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث. / عَكْسِيّ, مُعَاكِس (معكوس في الترتيب أو الطبيعة أو الأثر) / عكسي (معاكس في الطبيعة أو التأثير أو العلاقة بكمية أخرى) / مَعْكُوس (شيء معكوس في التسلسل أو الطابع أو التأثير)\nمثال: يكون الحد في تناسب عكسي مع حد آخر إذا زاد (أو نقص) بنقصان (أو زيادة) الآخر",
 "逆さ": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها) / رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆さくらげ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆さま": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها) / رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆さクラゲ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆さ海月": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆さ磔": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆さ鯰": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆ざや": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "逆しま": "عَكَسَ / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "逆なで": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "逆に": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "逆にいうと": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "逆にいえば": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "逆に言うと": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "逆に言えば": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "逆ねじ": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "逆ねじを食わせる": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "逆むけ": "سَأْفَة",
 "逆もしかり": "الْعَكْس بِالْعَكْس, الْعَكْس صَحِيح",
 "逆もまたしかり": "الْعَكْس بِالْعَكْس, الْعَكْس صَحِيح",
 "逆もまた然り": "الْعَكْس بِالْعَكْس, الْعَكْس صَحِيح",
 "逆も然り": "الْعَكْس بِالْعَكْس, الْعَكْس صَحِيح",
 "逆らう": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "逆アセンブル": "تَفْكِيك",
 "逆クリッピング": "حجب, درع (فعل الحجب عن الأذى) / تدريع إشعاعي, حجب (درع من الرصاص أو الخرسانة يهدف ليكون حاجزاً للإشعاع المنبعث في التحلل النووي) / تدريع, حجب كهرومغناطيسي (درع يتكون من ترتيب لشبكة معدنية أو صفائح مصممة لحماية المعدات الإلكترونية من التداخل الكهرومغناطيسي المحيط)",
 "逆コース": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / ارتداد, تراجع (العودة إلى حالة سابقة) / ارتداد, انعكاس (التحول في الاتجاه المعاكس) / ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة)",
 "逆ザヤ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "逆ポーランド記法": "التدوين البولندي العكسي, تدوين لاحق (تدوين خالٍ من الأقواس لتكوين التعبيرات الرياضية يتبع فيه كل معامل المعاملات الخاصة به)",
 "逆上せ": "هبة ساخنة (إحساس مفاجئ وقصير بالحرارة (يرتبط بانقطاع الطمث وبعض الاضطرابات العقلية))",
 "逆位": "عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "逆作用": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "逆児": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "逆凪": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "逆切り落し": "حجب, درع (فعل الحجب عن الأذى) / تدريع إشعاعي, حجب (درع من الرصاص أو الخرسانة يهدف ليكون حاجزاً للإشعاع المنبعث في التحلل النووي) / تدريع, حجب كهرومغناطيسي (درع يتكون من ترتيب لشبكة معدنية أو صفائح مصممة لحماية المعدات الإلكترونية من التداخل الكهرومغناطيسي المحيط)",
 "逆剥け": "سَأْفَة",
 "逆効果": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "逆叉": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "逆向き": "عَكَسَ / مُتَّجِه لِلْخَلْف (منحني أو مقوس للخلف أو للأسفل)\nمثال: أوراق ذات أشواك متجهة للخلف",
 "逆向性健忘": "فقدان الذاكرة الرجعي, نسيان رجعي (فقدان الذاكرة للأحداث التي سبقت الصدمة مباشرة)",
 "逆回転": "دوران خلفي (دوران (عادة لكرة متحركة) يؤخر أو يعكس الحركة الأمامية)",
 "逆境": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "逆子": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "逆巻く": "طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "逆徒": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "逆心": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "逆性": "عَكْسِيّ, مُعَاكِس (معكوس في الترتيب أو الطبيعة أو الأثر) / عكسي (معاكس في الطبيعة أو التأثير أو العلاقة بكمية أخرى) / مَعْكُوس (شيء معكوس في التسلسل أو الطابع أو التأثير)\nمثال: يكون الحد في تناسب عكسي مع حد آخر إذا زاد (أو نقص) بنقصان (أو زيادة) الآخر",
 "逆性石けん": "صابون مقلوب, منظف كاتيوني (فئة من المنظفات الاصطناعية التي يكون فيها الجزء النشط سطحياً من الجزيء هو الكاتيون (الأيون الموجب))",
 "逆性石鹸": "صابون مقلوب, منظف كاتيوني (فئة من المنظفات الاصطناعية التي يكون فيها الجزء النشط سطحياً من الجزيء هو الكاتيون (الأيون الموجب))",
 "逆戻り": "ارتداد, تراجع (العودة إلى حالة سابقة) / انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط)",
 "逆手にとる": "اِسْتَغَلَّ",
 "逆手に取る": "اِسْتَغَلَّ",
 "逆手打ち": "ضربة خلفية (رد يتم بظهر اليد مواجهاً لاتجاه الضربة) / مَائِلٌ لِلْخَلْف ((في الخطّ اليدويّ) ذو حروف مائلة إلى الخلف)",
 "逆捩じ": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "逆捩じを食わせる": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "逆捻": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "逆推進ロケット": "صاروخ عكسي, صاروخ كابح (محرك صاروخي صغير على صاروخ أكبر أو مركبة فضائية يتم إطلاقه لإبطاء أو تغيير مسارها)",
 "逆換": "عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "逆撫で": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "逆数": "مُتَبَادَل / مَقْلُوب",
 "逆断層": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "逆旅": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "逆波": "بحر معاكس (بحر تجري فيه الأمواج مباشرة عكس مسار السفينة)",
 "逆流": "ارتجاع, تدفق عكسي (تدفق يعود نحو مصدره)",
 "逆浪": "بحر معاكس (بحر تجري فيه الأمواج مباشرة عكس مسار السفينة)",
 "逆浸透": "تناضح عكسي ((في الكيمياء) طريقة لإنتاج الماء النقي؛ حيث يمر المذيب عبر غشاء شبه منفذ في اتجاه معاكس لاتجاه التناضح الطبيعي عندما يتعرض لضغط هيدروستاتيكي أكبر من…)",
 "逆浸透法": "تناضح عكسي ((في الكيمياء) طريقة لإنتاج الماء النقي؛ حيث يمر المذيب عبر غشاء شبه منفذ في اتجاه معاكس لاتجاه التناضح الطبيعي عندما يتعرض لضغط هيدروستاتيكي أكبر من…)",
 "逆玉": "صائدة ثروات (امرأة ترتبط برجل غني أو تتزوجه للحصول على ممتلكات منه من خلال الهدايا أو تسوية الطلاق) / منقب عن الذهب (عامل منجم يحفر أو يغسل التربة بحثاً عن الذهب في حقل ذهب)",
 "逆産": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "逆用": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "逆磔": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逆立ち": "وقوف على اليدين (فعل دعم النفس باليدين فقط في وضع مقلوب)",
 "逆立てる": "شعرة خشنة, هلبه (شعرة صلبة) / شعرة خشنة, شعيرة (ألياف صلبة (شعر خشن أو خيط)؛ طبيعية أو اصطناعية)",
 "逆符号化": "فك تشفير",
 "逆茂木": "حِظَار",
 "逆行": "ارتداد, تراجع (العودة إلى حالة سابقة) / انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط)",
 "逆行性健忘症": "فقدان الذاكرة الرجعي, نسيان رجعي (فقدان الذاكرة للأحداث التي سبقت الصدمة مباشرة)",
 "逆襲": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "逆説": "مُفَارَقَة",
 "逆説的": "مُتَنَاقِض ظَاهِرِيّاً (يبدو متناقضاً لكنه قد يكون صحيحاً مع ذلك)",
 "逆賊": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "逆転": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية",
 "逆転写酵素": "إنزيم النسخ العكسي",
 "逆転劇": "رِيمُونْتَادَا",
 "逆転勝ち": "رِيمُونْتَادَا",
 "逆転移": "تحويل مضاد, نقل مضاد (إزاحة المحلل النفسي لمشاعره تجاه المريض أو بشكل عام التورط العاطفي للمحلل النفسي في التفاعل العلاجي)",
 "逆転負け": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية",
 "逆送": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "逆運": "نَحْس, سُوءُ الحَظّ",
 "逆選択": "اختيار عكسي, انتقاء سلبي (حالة يمتلك فيها البائعون معلومات لا يمتلكها المشترون (أو العكس) حول جانب من جوانب جودة المنتج)",
 "逆関数": "دَالَّة عَكْسِيَّة, مَعْكُوس الدَّالَّة (دالة يتم الحصول عليها من خلال التعبير عن المتغير التابع لدالة واحدة كمتغير مستقل لدالة أخرى)",
 "逆鞘": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "逆風": "كَوْس, رِيَاح مُضَادَّة",
 "逆飛び込み": "رَأْسِيَّة",
 "逆鯰": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "逍遙": "تجوال بلا وجهة, تسكع (تجوال بلا هدف في مسار متعرج)",
 "逍遥": "تجوال بلا وجهة, تسكع (تجوال بلا هدف في مسار متعرج)",
 "透かし": "علامة مائية (علامة مميزة تضغط على الورق أثناء التصنيع؛ وتكون مرئية عند رفع الورق للضوء) / خط الماء, علامة الماء (خط يحدد المستوى الذي وصل إليه جسم مائي) / أشغال مفرغة (عمل زخرفي (مثل التطريز أو الشبكة الخشبية) له نمط من الفتحات)",
 "透かしっぺ": "فَسْو",
 "透かし彫り": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن)",
 "透かし細工": "أشغال مفرغة (عمل زخرفي (مثل التطريز أو الشبكة الخشبية) له نمط من الفتحات)",
 "透かし絵": "شَفَّافِيَّة",
 "透かす": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض.",
 "透き": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / فُرْصَة",
 "透き写し": "تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما) / رسم تتبعي, شف (فعل رسم مخطط أو تصميم أو مسودة عن طريق الشف) / رسم شفاف, شف (رسم تم إنشاؤه بوضع ورقة نصف شفافة على الصورة الأصلية ونسخ خطوط الصورة الأصلية عليها)\nمثال: تتبع الأنساب",
 "透き目": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "透き見": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير)",
 "透き間なく": "بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً",
 "透け感": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "透け透け": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "透っ波": "جَاسُوس / تَجَسَّسَ / لِصّ, لِصَّة / ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "透り": "اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "透光性": "شُفُوفِيَّة, نِصْف شَفَّافِيَّة (خاصية السماح بمرور الضوء بشكل مشتت)",
 "透写": "تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما) / رسم تتبعي, شف (فعل رسم مخطط أو تصميم أو مسودة عن طريق الشف) / رسم شفاف, شف (رسم تم إنشاؤه بوضع ورقة نصف شفافة على الصورة الأصلية ونسخ خطوط الصورة الأصلية عليها)\nمثال: تتبع الأنساب",
 "透写紙": "وَرَق إِسْتِشْفاف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "透察": "نظرة ثاقبة",
 "透彫": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن)",
 "透徹": "شَفَّافِيَّة / صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "透徹した": "شَفَّاف / وَاضِح",
 "透明": "شَفَّاف",
 "透明帯": "منطقة شفافة (غشاء سميك حول بويضة الثدييات؛ يمكن اختراقه بواسطة حيوان منوي واحد في عملية الإخصاب؛ يبقى عادة حول البويضة المخصبة حتى يتم زرعها في جدار الرحم)",
 "透明度": "شَفَّافِيَّة",
