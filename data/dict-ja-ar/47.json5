 "重量不足": "نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال)",
 "重量分析": "تحليل وزني (التحليل الكمي عن طريق الوزن)",
 "重量感": "ثقل, وزن (خاصية كون الشيء عظيم الوزن نسبياً) / اعتبار, ثقل (الأهمية النسبية الممنوحة لشيء ما)\nمثال: ثقل الرصاص",
 "重量挙げ": "رفع الأثقال (كمال أجسام عن طريق تمرين يتضمن رفع الأوزان)",
 "重金属": "مُوسِيقَى الْمِيتَال (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن) / هيفي ميتال\nمثال: أتعلم الموسيقى.",
 "重鎮": "قَائِد, زَعِيم",
 "重陽子": "دِيُوتِرُون (نواة الديوتيريوم؛ تتكون من بروتون واحد ونيوترون واحد؛ تستخدم كجسيم قاذف في المسرعات)",
 "重飲食": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "野": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / مُتَوَحِّش / بَرِّيّ / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "野いちご": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "野いばら": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "野うさぎ": "قُوَاع, أَرْنَب بَرِّيَّة",
 "野ざらし": "مُتَجَعِّد مِنَ الطَّقْس (اسمرّ وخشن جلده من التعرض للعوامل الجوية في الهواء الطلق) / مُتَآكِلٌ بِالعَوَامِلِ الجَوِّيَّةِ, مُتَجَوٍّ (بَالٍ بِسَبَبِ التَّعَرُّضِ لِلْعَوَامِلِ الجَوِّيَّةِ)",
 "野ねずみ": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "野の花": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "野ばら": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "野べ": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "野ろ": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "野ウサギ": "قُوَاع, أَرْنَب بَرِّيَّة",
 "野バラ": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "野人": "رَيْفِيّ, قَرَوِيّ / بلطجي, فتوة (رجل قاسٍ ووحشي) / مَدَنِيّ / مَدَنِيَّة",
 "野伏": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته) / رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "野伏せり": "قاطع طريق, لص مسلح (لص مسلح يكون (عادة) عضواً في عصابة)",
 "野兎": "قُوَاع, أَرْنَب بَرِّيَّة",
 "野兎病": "تولاريميا, حمى الأرانب (مرض شديد العدوى يصيب القوارض (وخاصة الأرانب والسناجب) وينتقل أحيانًا إلى البشر عن طريق القراد أو الذباب أو عن طريق التعامل مع الحيوانات المصابة)",
 "野党": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "野卑": "بَذِيء",
 "野原": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "野合": "تَوَاطُؤ",
 "野営": "تَخْيِيم",
 "野営地": "مخيم, موقع تخييم (موقع يمكن للأشخاص في العطلة نصب خيمة فيه)",
 "野外": "بالخارج, في الخارج (خارج مبنى) / خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: في الصيف نلعب في الخارج / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "野外劇": "اِسْتِعْرَاض",
 "野外音楽堂": "منصة الفرقة الموسيقية (منصة حيث يمكن لفرقة موسيقية (نحاسية) العزف في الهواء الطلق)",
 "野天": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "野太い": "جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة) / صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب) / حَلْقِيّ (يبدو كأنَّه يُنطَق من أعماق الحلق)",
 "野宿": "تَخْيِيم",
 "野宿者": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "野師": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "野干玉": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة)",
 "野心": "مَطْمَح / خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "野心的": "طَمُوح",
 "野性": "همجية, وحشية (حالة طبيعية بربرية أو غير مهذبة بشكل مستعصٍ) / رعونة, طيش (ميل جامح لفعل ما يحلو للمرء) / ضراوة, عنف (خاصية كون الشيء جامحاً أو مضطرباً) / تحرر, جموح (شعور بحدة عاطفية مفرطة)\nمثال: كان لدى ليزا دائماً ميل للطيش",
 "野性的": "مُتَوَحِّش / بَرِّيّ",
 "野戦": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "野戦特科": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "野戦病院": "مستشفى ميداني (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "野戦砲": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "野戦砲兵": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "野戦糧食": "جراية ميدانية, حصة ميدانية (حصص غذائية تصرف للقوات العسكرية في الميدان)",
 "野戦食": "جراية ميدانية, حصة ميدانية (حصص غذائية تصرف للقوات العسكرية في الميدان)",
 "野手": "لاعب ميداني, مدافع (عضو في فريق الكريكيت يقوم بالدفاع (الالتقاط) بدلاً من الضرب) / لاعب ميداني, مدافع (عضو في فريق البيسبول يتواجد في الملعب للدفاع بدلاً من الضرب)",
 "野手選択": "خيار المدافع (لعبة تتم على كرة أرضية يختار فيها المدافع إخراج عداء متقدم بدلاً من الضارب)",
 "野放し": "مَرْعًى, مَسْرَح",
 "野晒": "مُتَجَعِّد مِنَ الطَّقْس (اسمرّ وخشن جلده من التعرض للعوامل الجوية في الهواء الطلق) / مُتَآكِلٌ بِالعَوَامِلِ الجَوِّيَّةِ, مُتَجَوٍّ (بَالٍ بِسَبَبِ التَّعَرُّضِ لِلْعَوَامِلِ الجَوِّيَّةِ)",
 "野晒し": "مُتَجَعِّد مِنَ الطَّقْس (اسمرّ وخشن جلده من التعرض للعوامل الجوية في الهواء الطلق) / مُتَآكِلٌ بِالعَوَامِلِ الجَوِّيَّةِ, مُتَجَوٍّ (بَالٍ بِسَبَبِ التَّعَرُّضِ لِلْعَوَامِلِ الجَوِّيَّةِ)",
 "野暮ったい": "غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)\nمثال: ملابس غير عصرية",
 "野暮天": "جَلَافَة, غَلَاظَة (انعدام الأناقة بسبب كون الشخص غليظاً وجلفاً) / خشونة, غلظة (أسلوب شخص وقح أو غير حساس)",
 "野望": "مَطْمَح",
 "野次る": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "野次を飛ばす": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "野次馬根性": "تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك)",
 "野武士": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "野沢菜": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "野牛": "جَامُوس, جَامُوسَة",
 "野狐": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "野狐囲碁": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "野狐禅": "مُتَسَمٍّ, مُدَّعٍ (كما يدّعيه المرء لنفسه في كثير من الأحيان دون مبرّر)",
 "野猪": "خَنْزِير بَرِيّ",
 "野獣": "حَيَوَان بَرِّيّ, حَيَوَان وَحْشِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "野獣主義": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
 "野獣派": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
 "野球": "بَيْسْبُول",
 "野球チーム": "فريق بيسبول (فريق يلعب البيسبول)",
 "野球人": "لاعب بيسبول, لاعب كرة القاعدة (رياضي يلعب كرة القاعدة (البيسبول))",
 "野球場": "ملعب بيسبول (ملعب مخصص للعبة البيسبول)",
 "野球帽": "قبعة بيسبول, قبعة جوكي (قبعة ذات حاجب)",
 "野球選手": "لاعب بيسبول, لاعب كرة القاعدة (رياضي يلعب كرة القاعدة (البيسبول))",
 "野球部": "نادي بيسبول (فريق من لاعبي البيسبول المحترفين الذين يلعبون ويسافرون معًا)\nمثال: لعب كل نادٍ ست مباريات على أرضه مع فرق في قسمه الخاص",
 "野生": "مُتَوَحِّش / بَرِّيّ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "野生イヌ": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب المستأنسة لتمييزها عن ابن آوى أو الذئاب)",
 "野生動物": "حَيَوَان بَرِّيّ, حَيَوَان وَحْشِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "野生化": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "野生犬": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب المستأنسة لتمييزها عن ابن آوى أو الذئاب)",
 "野生生物": "اَلْحَيَاة اَلْبَرِّيَّة",
 "野生絶滅": "يَع",
 "野盗": "قاطع طريق, لص مسلح (لص مسلح يكون (عادة) عضواً في عصابة)",
 "野砲": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "野罌粟": "تِفَاف, جَعْضِيض",
 "野育ち": "غَيْرُ مُتَمَدْرِس (يفتقر إلى التعليم المدرسي)",
 "野臥": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته) / رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "野良猫": "قط شوارع (قط بلا مأوى)",
 "野芥子": "تِفَاف, جَعْضِيض",
 "野花": "زهرة برية (نبات زهري بري أو غير مزروع) / جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "野苺": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "野茨": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "野草": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "野菊": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "野菜": "نَبَات, بَقْلَة (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / خُضَر, خُضَار (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه) / نَبَاتِيّ / خَضْرَاوِيّ\nمثال: هذا النبات مهدد بالانقراض. / مَارِهْوَانَا, حَشِيش",
 "野菜汁": "حساء الخضروات, مينستروني (حساء مصنوع من مجموعة متنوعة من الخضروات)",
 "野菜畑": "بستان تجاري (حديقة تُزرع فيها الفواكه والخضروات لغرض التسويق)",
 "野菜類": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "野萵苣": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "野薔薇": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "野蚕": "دودة قز عملاقة (يرقة عثة ساتورنيد؛ تغزل كمية كبيرة من الحرير القوي في بناء شرنقتها)",
 "野蛮": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "野蛮人": "هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ",
 "野趣": "خُشُونَة, رِيفِيَّة (صفة كون الشخص ريفياً أو فجاً)",
 "野辺": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "野辺の送り": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "野辺送り": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "野遊": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "野遊び": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "野選": "خيار المدافع (لعبة تتم على كرة أرضية يختار فيها المدافع إخراج عداء متقدم بدلاً من الضارب)",
 "野郎": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير.",
 "野郎ども": "اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير.",
 "野郎共": "اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير.",
 "野雁": "حُبَارَى",
 "野面": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "野音": "منصة الفرقة الموسيقية (منصة حيث يمكن لفرقة موسيقية (نحاسية) العزف في الهواء الطلق)",
 "野風増": "مُشَاغِب",
 "野飼い": "مَرْعًى, مَسْرَح",
 "野馬": "حصان بري (حصان منزلي غير مروض أو وحشي)",
 "野鳥観察": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "野鴨": "بط بري (بطة غير مستأنسة (خاصة البركة))",
 "野鶏": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام)",
 "野鼠": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "量": "كَمِّيَّة, مِقْدَار / كَرَم, سَخَاء / تَقَدُّم",
 "量り": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "量る": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "量化": "تكميم, قياس كمي (فعل اكتشاف أو التعبير عن كمية شيء ما) / تسوير, تكميم (قيد مفروض على متغيرات قضية منطقية (مثل المحددات الكمية 'بعض' أو 'كل' أو 'لا'))",
 "量化子": "مُحَدِدْ الْكَمِيَّةْ (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "量子": "كَمّ",
 "量子もつれ": "تشابك كمي",
 "量子コンピュータ": "حاسوب كمي (نظام حوسبة يستفيد بشكل مباشر من الظواهر الميكانيكية الكمومية، مثل التراكب والتشابك، لإجراء عمليات على البيانات)",
 "量子コンピューター": "حاسوب كمي (نظام حوسبة يستفيد بشكل مباشر من الظواهر الميكانيكية الكمومية، مثل التراكب والتشابك، لإجراء عمليات على البيانات)",
 "量子力学": "ميكانيكا الكم",
 "量子化": "تكميم (عملية التقسيم إلى كمات أو التعبير بمصطلحات نظرية الكم)",
 "量子物理学": "فيزياء الكم (فرع الفيزياء القائم على نظرية الكم)",
 "量子縺れ": "تشابك كمي",
 "量子色力学": "ديناميكا لونية كمية (نظرية التفاعلات القوية بين الجسيمات الأولية)",
 "量子論": "نَظَرِيَّة كَمّ (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "量子電気力学": "ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "量子電磁力学": "ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "量定": "تَقْيِيم / تَقْدِير, تَقْيِيم",
 "量感": "ثقل, جسامة (خاصية كون الشيء كبيراً في الكتلة) / ثقل, ضخامة (كبر حجم غير عملي أو يصعب التعامل معه)",
 "量水器": "عداد المياه (عداد لقياس كمية المياه المارة عبر مخرج معين)",
 "量水計": "عداد المياه (عداد لقياس كمية المياه المارة عبر مخرج معين)",
 "量産": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "量産品": "مُنْتَجٌ بِالجُمْلَةِ (مُنتَج بكميات كبيرة غالباً بتقنيات خطوط التجميع)",
 "量的": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس) / كمي ((للشعر) له نظام متري يعتمد على المدة النسبية للمقاطع) / كمي (يتعلق بقياس الكمية)\nمثال: تصدير القمح دون قيود كمية",
 "量目": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "量記号": "مُحَدِدْ الْكَمِيَّةْ (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "量詞": "مُصَنِّف, مُصَنِّفَة",
 "量販店": "سوق مركزي, متجر متعدد الأقسام (متجر تجزئة كبير منظم في أقسام تقدم مجموعة متنوعة من البضائع؛ عادة ما يكون جزءاً من سلسلة متاجر)",
 "釐": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي)",
 "金": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / مِيتَال / ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبِي\nمثال: ذهب إلى الدكان. / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / مَجْمُوع / مَبْلَغ / الْجُمُعَة, الجُمْعَة",
 "金がない": "مُفْلِس",
 "金が無い": "مُفْلِس",
 "金ぐつわ": "شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "金つば": "سلاح ذو عمود, فأس الحرب (سلاح قتال قريب يتم فيه تثبيت الجزء القتالي الرئيسي من السلاح في نهاية عمود طويل، عادة من الخشب، مما يوسع النطاق الفعال للمستخدم)\nمثال: نظراً لاحتوائها على القليل نسبياً من المعدن، فإن الأسلحة ذات الأعمدة رخيصة الصنع، مما جعلها السلاح المفضل للمجندين الفلاحين",
 "金づち": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "金づち頭": "عَنِيد",
 "金てこ": "عَتَلَة",
 "金になる": "مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم",
 "金に汚い": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "金のない": "مُفْلِس",
 "金のなる木": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "金の卵": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه)",
 "金の無心": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "金ぴか": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / وليمة احتفالية ((في بريطانيا) وليمة احتفالية أو ترفيهية تقام في الكلية)",
 "金ぷら": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أواني مطلية بالذهب (أدوات مائدة مطلية بالذهب)",
 "金めっき": "تذهيب, طلي بالذهب (طلاء من الذهب أو شيء يشبه الذهب)",
 "金ドブ": "هدر المال (المال الذي ينفق مقابل عائد غير كاف)\nمثال: قال السناتور إن المشروع كان هدراً للمال",
 "金ノコ": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "金バエ": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "金ピカ": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / وليمة احتفالية ((في بريطانيا) وليمة احتفالية أو ترفيهية تقام في الكلية)",
 "金プラ": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أواني مطلية بالذهب (أدوات مائدة مطلية بالذهب)",
 "金メダル": "ميدالية ذهبية (كأس مصنوعة من الذهب (أو لها مظهر الذهب) تمنح عادة للفائز بالمركز الأول في المسابقة)",
 "金メッキ": "تذهيب, طلي بالذهب (طلاء من الذهب أو شيء يشبه الذهب)",
 "金モール": "جديلة, شريط مجدول (حاشية تستخدم لتزيين الملابس أو الستائر)",
 "金亀子": "جعران (أي من الأنواع العديدة من الخنافس ممتلئة الجسم ذات رؤوس بقرون قرنية)",
 "金仏": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "金使い": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "金儲け": "كسب المال (فعل جني المال (وتراكم الثروة)) / مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا)",
 "金入れ": "جِزْدَان, جُزْدَان / خزينة نقود, صندوق النقد (صندوق قوي لحفظ النقود)",
 "金円": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "金冠": "إكليل (الحافة الواقعة بين جلد الرسغ وقرن الحافر) / إكليل, تاج صغير (تاج صغير؛ يشير عادة إلى رتبة عالية ولكن أقل من رتبة السيادة)",
 "金切りのこぎり": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "金切り声": "زَعَقَ / صَرَخَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "金切り鋸": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "金切り音": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "金切鋸": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "金利": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "金利生活者": "ريعي, صاحب دخل ريعي (شخص دخله من إيجارات العقارات أو فوائد السندات واستثمارات أخرى)",
 "金剛": "فاجرا (صاعقة إندرا) / صَاعِقَة",
 "金剛不壊": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "金剛堅固": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "金剛杵": "فاجرا (صاعقة إندرا)",
 "金剛石": "مَاس, أَلْمَاسَة / اَلدِّينَارِيّ",
 "金剛砂": "سُنْبَاذَج",
 "金口": "ذَهَبِيّ اللَّوْن (ذو لون الذَّهب)",
 "金味": "فلزي, معدني (يحتوي على معدن أو مصنوع منه أو يشبهه أو يتسم بخصائصه) / خيط معدني (خيط مصنوع جزئياً أو كلياً من المعدن) / قماش معدني (قماش مصنوع من خيوط تتكون جزئياً أو كلياً من المعدن)\nمثال: مركب معدني",
 "金員": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "金器": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أواني مطلية بالذهب (أدوات مائدة مطلية بالذهب)",
 "金土竜": "خلد ذهبي (خلد من جنوب أفريقيا ذو شعر حماية قزحي اللون مختلط بالفراء السفلي)",
 "金坑": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه)",
 "金型": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "金城鉄壁": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "金壺眼": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "金太郎あめ": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "金太郎アメ": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "金太郎飴": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "金子": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "金字塔": "هَرَم, أَهْرَام ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "金屎": "خابث, خباث",
 "金屑": "خردة معدنية (معدن مهمل مناسب لإعادة المعالجة)\nمثال: باع السيارة أخيراً كخردة معدنية",
 "金属": "مِيتَال",
 "金属くず": "خردة معدنية (معدن مهمل مناسب لإعادة المعالجة)\nمثال: باع السيارة أخيراً كخردة معدنية",
 "金属元素": "عنصر فلزي, معدن (أي من عدة عناصر كيميائية تكون عادةً مواد صلبة لامعة موصلة للحرارة أو الكهرباء ويمكن تشكيلها)",
 "金属加工": "تشغيل المعادن, مصنوعات معدنية (نشاط صنع الأشياء من المعدن بمهارة)",
 "金属塊": "غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان) / خليط كبريتيدي خام, مات (خليط من الكبريتيدات يتشكل عند صهر خامات المعادن الكبريتيدية)",
 "金属屑": "خردة معدنية (معدن مهمل مناسب لإعادة المعالجة)\nمثال: باع السيارة أخيراً كخردة معدنية",
 "金属性": "رنين معدني (حالة امتلاك رنين سمعي مشابه للمعدن)",
 "金属探知機": "كاشف معادن (كاشف يعطي إشارة عند اكتشاف وجود معدن؛ يستخدم للكشف عن وجود قطع معدنية شاردة في المنتجات الغذائية أو للعثور على معادن مدفونة)",
 "金属灰": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "金属結合": "رابطة فلزية, رابطة معدنية (رابطة كيميائية يتم فيها مشاركة الإلكترونات عبر العديد من الأنوية ويحدث توصيل إلكتروني)",
 "金属製": "فلزي, معدني (يحتوي على معدن أو مصنوع منه أو يشبهه أو يتسم بخصائصه) / خيط معدني (خيط مصنوع جزئياً أو كلياً من المعدن) / قماش معدني (قماش مصنوع من خيوط تتكون جزئياً أو كلياً من المعدن)\nمثال: مركب معدني",
 "金属酸化物半導体": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "金属酸化膜半導体": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "金属量": "رنين معدني (حالة امتلاك رنين سمعي مشابه للمعدن)",
 "金山": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه) / لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "金工": "تشغيل المعادن, مصنوعات معدنية (نشاط صنع الأشياء من المعدن بمهارة) / أشغال معدنية (الأجزاء المعدنية لشيء ما)\nمثال: كانت هناك ثقوب رصاص في الأشغال المعدنية",
 "金巾": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / كاليكو, منقط (مصنوع من الكاليكو (قماش قطني) أو يشبه الكاليكو في كونه منقوشاً) / كاليكو (قماش خشن ذو طباعة زاهية)\nمثال: فساتين كاليكو",
 "金床": "سَنْدان, سِنْدَان",
 "金庫": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / مخزن, مستودع (منشأة يمكن فيها إيداع الأشياء للتخزين أو الحفظ)",
 "金庫株": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة ولكنها غير متداولة؛ لا يمكن التصويت بها ولا تدفع أرباحاً)",
 "金庫番": "أمين الصندوق, خازن (موظف مسؤول عن استلام وصرف الأموال)",
 "金庫破り": "كسار خزائن (لص يكسر الخزائن لسرقة محتوياتها الثمينة)",
 "金彩": "ورق الذهب (شكل رقيق جداً من رقائق الذهب)",
 "金性": "قيراط (وحدة قياس لنسبة الذهب في السبيكة؛ الذهب عيار 18 قيراطًا هو 75% ذهب)",
 "金払い": "مُجْزٍ, مُدِرّ لِلرِّبْح (يُدرّ ربحًا معقولاً)",
 "金持": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "金持ち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "金探": "كاشف معادن (كاشف يعطي إشارة عند اكتشاف وجود معدن؛ يستخدم للكشف عن وجود قطع معدنية شاردة في المنتجات الغذائية أو للعثور على معادن مدفونة)",
 "金敷": "سَنْدان, سِنْدَان",
 "金敷き": "سَنْدان, سِنْدَان",
 "金星": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي.",
 "金時": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر. / بَطَاطَا حُلْوَة",
 "金時芋": "بَطَاطَا حُلْوَة",
 "金曜": "الْجُمُعَة, الجُمْعَة",
 "金曜日": "الْجُمُعَة, الجُمْعَة",
