 "臙脂虫": "دودة القرمز (حشرة قشرية حمراء مكسيكية تتغذى على الصبار؛ مصدر لصبغة حمراء)",
 "臠": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "臣": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي)) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي)) / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / وصيف (في العصور الوسطى، شاب يعمل كمرافق لفارس كأول مرحلة في التدريب للفروسية) / أفاق, محتال (شخص مخادع ولا يمكن الوثوق به)",
 "臣下": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "臣従": "عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "臣服": "عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "臣民": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "臥し所": "مَخْدَع, غُرْفَةُ نَوْم",
 "臥す": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "臥する": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "臥せる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "臥やす": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "臥ゆ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "臥位": "استلقاء (وضع الاستلقاء (كما في السرير))",
 "臥具": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "臥床": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "臥所": "مَخْدَع, غُرْفَةُ نَوْم",
 "臥褥": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "臥雲": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "臨み": "تَحَدٍّ, التَّحَدِّي",
 "臨む": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "臨写": "نسخ (فعل النسخ)",
 "臨在": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "臨場": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "臨場感": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "臨席": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "臨床": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية",
 "臨床上": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية",
 "臨床医": "إكلينيكي, سريري (ممارس (للطب أو علم النفس) يقوم بعمل سريري بدلاً من التجارب المعملية)",
 "臨床家": "إكلينيكي, سريري (ممارس (للطب أو علم النفس) يقوم بعمل سريري بدلاً من التجارب المعملية)",
 "臨床心理士": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "臨床心理学": "عِلْم نَفْس سَرِيرِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "臨床心理学者": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "臨床的": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية",
 "臨床試験": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "臨床講義": "عِيَادَة, مَصَحَّة",
 "臨採": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "臨時": "مُؤَقَّت / خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "臨時工": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "臨時従業員": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "臨時的採用教員": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "臨時職員": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "臨時記号": "عَرْضِيّ",
 "臨時費": "مصروفات عرضية, نفقات نثرية ((غالباً بصيغة الجمع) مصروف لم يتم وضعه في الميزانية أو لم يتم تحديده)\nمثال: طلب تعويضاً قدره 7 دولارات عن نفقات نثرية",
 "臨書": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "臨検": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "臨機": "مُنَاسِب, مُلَائِم",
 "臨機応変": "خِصِّيصًا لِهَذَا الغَرَض (لغرض محدد) / لِغَرَض بِعَيْنِه, مَخْصُوص (مُخصَّص لغرض واحد معين أو معنيّ به) / مَخْصُوص, مُرْتَجَل (غالباً ما يكون مرتجلاً أو مخصصاً لغرض آني)\nمثال: تم تعيينهم لهذا الغرض",
 "臨死体験": "تجربة الاقتراب من الموت (تجربة القرب من الموت ولكن النجاة منه)",
 "臨海": "سَاحِلِيّ (يقع على أو بالقرب من أو يحد ساحلاً) / سَاحِلِيّ, مُحَاذٍ لِلسَّاحِل (على طول الساحل أو يتبعه) / ساحلي (من أو متعلق بساحل)\nمثال: مستنقعات ساحلية",
 "臨港列車": "قطار الميناء (قطار ينقل الركاب من أو إلى الميناء)",
 "臨界": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / حراجة (حالة حرجة؛ خاصة النقطة التي يصبح فيها التفاعل النووي مستداماً ذاتياً) / حرج, خطورة (حالة من الإلحاح الحرج) / النقد",
 "臨界点": "مفترق طرق, منعطف حرج (حالة أزمة أو نقطة زمنية يجب فيها اتخاذ قرار حاسم)\nمثال: في ذلك المنعطف لم يكن لديه أدنى فكرة عما يجب فعله",
 "臨界角": "زَاوِيَة حَرِجَة",
 "臨界量": "كتلة حرجة (الحد الأدنى من كتلة المواد القابلة للانشطار التي يمكن أن تحافظ على التفاعل المتسلسل) / كتلة حرجة (الحد الأدنى من الكمية (لشيء ما) المطلوب لبدء مشروع أو الحفاظ عليه)\nمثال: وصلت المعركة من أجل سوق الكمبيوتر الآن إلى الكتلة الحرجة",
 "臨終": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "臨終の床": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "自": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "自から": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自ずから": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自ずから明らか": "بَدَهِيّ, بَدِيهِيّ (واضح دون حاجة إلى برهان أو حجّة)",
 "自ずと": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自と": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自ら": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自ら進んで": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "自主": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "自主性": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "自主権": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "自主的": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "自主管理": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "自主規制": "خَاضِع لِلرَّقَابَة, مُرَاقَب (مقموع أو خاضع للرقابة)",
 "自主防衛": "ذَاتِيُّ التَّوْجِيه, مُسْتَقِلّ ((عَنِ الأَشْخَاصِ) حُرٌّ مِنَ السَّيْطَرَةِ وَالقُيُودِ الخَارِجِيَّةِ فِي الفِعْلِ وَالحُكْم)",
 "自乗": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "自乗根": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "自今": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "自今以後": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "自他": "تَعَدٍّ (العلاقة النحوية التي ينشئها الفعل المتعدي) / تَعَدٍّ ((المنطق والرياضيات) علاقة بين ثلاثة عناصر بحيث إذا كانت قائمة بين الأول والثاني وبين الثاني والثالث، فإنها بالضرورة تكون قائمة بين الأول والثالث) / مُتَكَلِّم",
 "自伝": "سِيرَة ذَاتِيَّة",
 "自伝文学": "سِيرَة ذَاتِيَّة",
 "自体": "نَفْسُهُ, نَفْسُهَا / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَصْلًا",
 "自余": "آخَرُون",
 "自作": "حِرْفَة يَدَوِيَّة",
 "自作自演": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "自供": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "自信": "ثِقَة بِالنَّفْس",
 "自信たっぷり": "وَاثِق / مُتَأَكِّد",
 "自信作": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "自信喪失": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "自信過剰": "مَغْرُور, مُفْرِط الثِّقَة (يتّسم بثقة مفرطة تتجاوز الحدّ المعقول)",
 "自儘": "أَنَانِيّ",
 "自分": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "自分から": "طَوْعًا, طَوَاعِيَةً",
 "自分で": "بالذات, شخصياً (بالحضور الجسدي المباشر؛ دون وسيط)\nمثال: ذهبت إلى هناك شخصياً",
 "自分のことのように": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "自分のことの様に": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "自分のために": "بِمُفْرَدِي",
 "自分の事のように": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "自分の力": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自分の為に": "بِمُفْرَدِي",
 "自分ひとり": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自分らしい": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "自分らしさ": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً) / تفرد, فردية (صفة كون المرء فرداً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش",
 "自分一人": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自分中心": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "自分勝手": "أَنَانِيَّة",
 "自分探し": "اكتشاف الذات (اكتشاف الفرد لتفرده وشخصيته)",
 "自分撮り": "سِلْفِي, سِيلْفِي",
 "自分本位": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "自分独り": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自分磨き": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "自分自身": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自切": "بتر ذاتي (إزالة تلقائية أو طرح لجزء من الجسم (مثل ذيل السحلية أو مخلب سرطان البحر) خاصة عندما يصاب الكائن الحي أو يتعرض للهجوم)",
 "自制": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء)\nمثال: 君は自制しなければならない。 — عليك أن تتحكم بنزواتك.",
 "自制心": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "自刻": "بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "自剄": "اِنْتَحَرَ",
 "自前主義": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自力": "لوحد / لحال",
 "自力救済": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "自力更生": "إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)",
 "自力本願": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自助": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "自助具": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "自助努力": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "自助論": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "自動": "تِلْقَائِيّ, أُوتُوماتِيكِيّ (عَفْوِيّ؛ آلِيّ) / تِلْقَائِيّ (عَفْوِيّ؛ آلِيّ)\nمثال: كان سامي معرضا لحكم تلقائي بالسجن المؤبد إن أدين. / فِعْل لَازِم (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "自動データ処理": "معالجة آلية للبيانات (معالجة البيانات بواسطة الحاسوب)",
 "自動データ収集": "أدينوسين ديميناز (إنزيم يوجد في الثدييات يمكنه تحفيز نزع الأمين من الأدينوزين وتحويله إلى إينوزين وأمونيا)\nمثال: يمكن أن يؤدي نقص نازعة أمين الأدينوزين إلى شكل من أشكال مرض نقص المناعة المشترك الشديد",
 "自動ピアノ": "بيانو ميكانيكي (بيانو يعمل ميكانيكياً يستخدم لفة من الورق المثقوب لتنشيط المفاتيح)",
 "自動プログラムツール": "مناسب",
 "自動二輪": "مُوتُوسِيكِل, دَرَّاجَة نَارِيَّة",
 "自動二輪車": "مُوتُوسِيكِل, دَرَّاجَة نَارِيَّة",
 "自動人形": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "自動列車停止装置": "صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "自動制御装置": "مؤازر آلي (من أو ينطوي على آليات مؤازرة (سيرفو)) / آلية مؤازرة, سيرفو (نظام تحكم يحول حركة ميكانيكية صغيرة إلى حركة تتطلب طاقة أكبر بكثير؛ قد يتضمن نظام تغذية مرتدة سلبية)",
 "自動化": "أَتْمَتَة, تَأْلِيَّة",
 "自動変速機": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "自動変速装置": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "自動安定装置": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "自動小銃": "بندقية آلية, بندقية أوتوماتيكية (بندقية ذاتية التلقيم قادرة على الإطلاق الآلي للنار)",
 "自動巻き": "ذَاتِيّ التَّعْبِئَة (مُصَمَّم بحيث لا تكون هناك حاجة للتعبئة اليدوية)",
 "自動式": "تِلْقَائِيّ, أُوتُوماتِيكِيّ (عَفْوِيّ؛ آلِيّ) / تِلْقَائِيّ (عَفْوِيّ؛ آلِيّ)\nمثال: كان سامي معرضا لحكم تلقائي بالسجن المؤبد إن أدين.",
 "自動性": "تِلْقَائِيَّة",
 "自動拳銃": "مسدس آلي, مسدس أوتوماتيكي (مسدس يستمر في إطلاق النار حتى نفاذ الذخيرة أو تحرير الزناد)",
 "自動操縦": "طيار آلي, نظام طيران آلي (جهاز ملاحي يحافظ تلقائياً على مسار السفن أو الطائرات أو المركبات الفضائية في اتجاه ثابت) / تصرف تلقائي, طيار آلي (حالة معرفية يتصرف فيها الشخص دون وعي ذاتي كامل)\nمثال: قامت بأعمالها المنزلية بشكل تلقائي",
 "自動操縦装置": "طيار آلي, نظام طيران آلي (جهاز ملاحي يحافظ تلقائياً على مسار السفن أو الطائرات أو المركبات الفضائية في اتجاه ثابت) / تصرف تلقائي, طيار آلي (حالة معرفية يتصرف فيها الشخص دون وعي ذاتي كامل)\nمثال: قامت بأعمالها المنزلية بشكل تلقائي",
 "自動操舵装置": "طيار آلي, نظام طيران آلي (جهاز ملاحي يحافظ تلقائياً على مسار السفن أو الطائرات أو المركبات الفضائية في اتجاه ثابت) / تصرف تلقائي, طيار آلي (حالة معرفية يتصرف فيها الشخص دون وعي ذاتي كامل)\nمثال: قامت بأعمالها المنزلية بشكل تلقائي",
 "自動火器": "سلاح آلي, سلاح ناري أوتوماتيكي (سلاح ناري يعيد تحميل نفسه ويستمر في إطلاق النار حتى يتم تحرير الزناد)",
 "自動火災報知設備": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان) / إنذار الحريق (صيحة أو جرس للتحذير من اندلاع حريق)",
 "自動現金預払機": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "自動症": "تِلْقَائِيَّة",
 "自動的": "تِلْقَائِيّ, أُوتُوماتِيكِيّ (عَفْوِيّ؛ آلِيّ) / تِلْقَائِيّ (عَفْوِيّ؛ آلِيّ)\nمثال: كان سامي معرضا لحكم تلقائي بالسجن المؤبد إن أدين.",
 "自動翻訳": "ترجمة آلية (استخدام الحواسيب للترجمة من لغة إلى أخرى)",
 "自動記録器": "حطّاب (شخص يقطع الأشجار)",
 "自動詞": "فِعْل لَازِم (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "自動販売機": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "自動車": "سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "自動車エンジン": "محرك سيارة (المحرك الذي يدفع السيارة)",
 "自動車メーカー": "شركة تصنيع سيارات, صانع سيارات (عمل تجاري يشارك في تصنيع السيارات)",
 "自動車保険": "تأمين السيارات (تأمين ضد الخسارة الناتجة عن السرقة أو حوادث المرور)",
 "自動車保険料": "تأمين السيارات (تأمين ضد الخسارة الناتجة عن السرقة أو حوادث المرور)",
 "自動車修理工": "ميكانيكي سيارات (شخص مهنته إصلاح وصيانة السيارات)",
 "自動車修理工場": "محطة خدمة (محطة يتم فيها بيع البنزين والزيت وتتوفر فيها مرافق لإصلاح أو صيانة السيارات)",
 "自動車化": "تزويد بمحركات, ميكنة (فعل الميكنة (التجهيز بمحركات أو مركبات آلية))",
 "自動車学校": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自動車専用道路": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "自動車工学": "هندسة السيارات (نشاط تصميم وبناء السيارات)",
 "自動車教習所": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自動車整備士": "مِيكَانِيكِيّ سَيَّارَاتٍ",
 "自動車業界": "سيارة, مركبة آلية (مركبة بعجلات ذاتية الدفع لا تسير على قضبان)",
 "自動車登録番号標": "لَوْحَةُ سَيَّارَةٍ, لَوْحَةُ تَسْجِيلٍ مَرْكَبَةٍ",
 "自動車運搬船": "مقطورة نقل السيارات, ناقلة سيارات (مقطورة يمكن تحميلها بسيارات جديدة لتسليمها إلى وكالات البيع) / سفينة نقل السيارات (سفينة شحن مجهزة خصيصاً لنقل كميات كبيرة من السيارات)\nمثال: ناقلة السيارات أوريجا ليدر، التي بنيت عام 2008 بسعة 6200 سيارة، هي أول سفينة في العالم تعمل جزئياً بالطاقة الشمسية",
 "自動車道": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "自動車駅": "مَحَطَّة حَافِلَات",
 "自動送信": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "自動運転": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "自動金銭出入機": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "自動電圧切替": "التصلب الجانبي الضموري (سماكة الأنسجة في المسالك الحركية للحبل الشوكي؛ يؤدي إلى ضمور عضلي تدريجي)",
 "自動電話": "تِلِفُون عُمُومِيّ, هَاتِف عُمُومِيّ (هَاتِف)",
 "自動預金支払機": "صَرَّافَة, صَرَّاف آلِيّ",
 "自叙": "سِيرَة ذَاتِيَّة",
 "自叙伝": "سِيرَة ذَاتِيَّة",
 "自営業者": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "自嘲": "سُخْرِيَة مِن الذَّات (دعابة لطيفة على حساب النفس)\nمثال: رسالته إلى المنزل تحمل لمسة من السخرية من الذات",
 "自嘲的": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "自噴": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً)",
 "自噴井": "بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "自国民": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "自国産テロリズム": "إرهاب محلي (إرهاب يمارس في بلدك ضد شعبك)\nمثال: كان تفجير المبنى الفيدرالي في أوكلاهوما سيتي عام 1995 مثالاً على الإرهاب المحلي",
 "自在": "خطاف القدر",
 "自在かぎ": "خطاف القدر",
 "自在に": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "自在スパナ": "مِفْتَاح إِنْجْلِيزِيّ (مفتاح)\nمثال: بحث عن المفتاح.",
 "自在戸": "باب متأرجح (باب يتأرجح على مفصل مزدوج؛ يفتح في أي من الاتجاهين)",
 "自在継ぎ手": "مفصل عام, وصلة كاردان (قارنة تربط عمودين دوارين مما يسمح بحرية الحركة في جميع الاتجاهات)\nمثال: في المركبات الآلية، يسمح المفصل العام لعمود التدوير بالتحرك صعوداً وهبوطاً أثناء مرور المركبة فوق المطبات",
 "自在継手": "مفصل عام, وصلة كاردان (قارنة تربط عمودين دوارين مما يسمح بحرية الحركة في جميع الاتجاهات)\nمثال: في المركبات الآلية، يسمح المفصل العام لعمود التدوير بالتحرك صعوداً وهبوطاً أثناء مرور المركبة فوق المطبات",
 "自在鉤": "خطاف القدر",
 "自堕落": "مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "自壊": "إبادة, محق (تدمير شامل) / اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تفتت, تفكك (في حالة متحللة)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية / انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "自壊作用": "إبادة, محق (تدمير شامل) / اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تفتت, تفكك (في حالة متحللة)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية",
 "自変数": "متغير تجريبي, متغير مستقل ((إحصاء) متغير تكون قيمه مستقلة عن التغيرات في قيم المتغيرات الأخرى)",
 "自失": "تخدير, ذهول (فعل جعل الشخص متبلد الشعور أو خاملاً) / ترنح, ذهول (وعي هامشي) / انصعاق, ذهول (شعور بالدهشة المذهلة)\nمثال: اشتهر الأستاذ بجعل طلابه في حالة ذهول",
 "自学": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自宅出産": "وضع, ولادة (عملية الولادة)",
 "自宅学習": "دراسة منزلية (دورة دراسية يتم تنفيذها في المنزل بدلاً من الفصل الدراسي)",
 "自宅警備員": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ) / مَيَّالٌ لِلِانْطِوَاء (يميل إلى الانطواء بعض الشيء) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)",
 "自宅軟禁": "إِقَامَة جَبْرِيَّة",
 "自害": "مُنْتَحِر, مُنْتَحِرَة",
 "自家": "مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "自家保険": "تأمين ذاتي (تأمين نفسك عن طريق تخصيص أموال لتغطية الخسائر المحتملة بدلاً من شراء بوليصة تأمين)",
 "自家受粉": "تلقيح ذاتي (إخصاب عن طريق نقل حبوب اللقاح من المئبر إلى الميسم في نفس الزهرة)",
 "自家受精": "إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "自家撞着": "تناقض ذاتي (مناقضة النفس)",
 "自家本位": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "自家生殖": "تزاوج ذاتي (الإخصاب الذاتي في النباتات)",
 "自家発電": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "自家移植": "طعم ذاتي (نسيج يؤخذ من موقع ويُطعم في موقع آخر على نفس الشخص)\nمثال: عندما تفشل الكسور في الالتئام، يمكن أن تكون الطعوم الذاتية من العظام قيمة للغاية في مساعدة العظم على الشفاء",
 "自家蛍光": "فلورة ذاتية (فلورة مستحثة ذاتياً)",
 "自家製": "مَنْزِلِيّ",
 "自家醸造": "مُخَمَّرٌ مَنْزِلِيًّا (مُخمَّر أو مُختمَر في المنزل)",
 "自尊": "عزة نفس, كرامة (صفة الجدارة بالتقدير أو الاحترام)\nمثال: كان من دون كرامته أن يغش",
 "自尊心": "تَقْدِير ذَات",
 "自尊感情": "تَقْدِير ذَات",
 "自尽": "مُنْتَحِر, مُنْتَحِرَة",
 "自己": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自己インダクタンス": "حَثّ ذَاتِيّ, مُعَامِل الحَثّ الذَّاتِيّ (النسبة بين القوة الدافعة الكهربائية الناتجة في دائرة عن طريق الحث الذاتي ومعدل تغير التيار الذي ينتجها، معبراً عنها بالهنري)",
 "自己チュー": "أَنَانِيَّة",
 "自己中": "أَنَانِيَّة",
 "自己中心": "أَنَانِيَّة",
 "自己中心性": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "自己中心的": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "自己主張": "تأكيد الذات (فعل تأكيد المرء لنفسه بطريقة عدوانية) / إثبات الذات (فعل طرح آرائك الخاصة بطريقة متباهية أو غير مراعية توحي بأنك تشعر بالتفوق على الآخرين)",
 "自己主義": "أَنَانِيَّة",
 "自己保全": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "自己保存": "حفظ الذات, غريزة البقاء (حفظ النفس من الأذى؛ ميل طبيعي أو غريزي)",
 "自己保身": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "自己修養": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "自己催眠": "تنويم ذاتي (تنويم مغناطيسي يقوم به الشخص لنفسه)",
 "自己免疫": "مناعة ذاتية (إنتاج أجسام مضادة ضد أنسجة جسمك؛ يسبب أمراض المناعة الذاتية أو تفاعلات فرط الحساسية)",
 "自己免疫不全": "مرض مناعة ذاتية (أي من مجموعة كبيرة من الأمراض التي تتميز بخلل في وظائف الجهاز المناعي مما يجعله ينتج أجساماً مضادة ضد أنسجة الجسم نفسه)",
 "自己免疫性": "مناعة ذاتية (إنتاج أجسام مضادة ضد أنسجة جسمك؛ يسبب أمراض المناعة الذاتية أو تفاعلات فرط الحساسية)",
 "自己免疫疾患": "مرض مناعة ذاتية (أي من مجموعة كبيرة من الأمراض التي تتميز بخلل في وظائف الجهاز المناعي مما يجعله ينتج أجساماً مضادة ضد أنسجة الجسم نفسه)",
 "自己分析": "تحليل ذاتي (تطبيق مبادئ العلاج النفسي لتحليل شخصيتك الخاصة) / تحليل ذاتي, محاسبة النفس (فحص دقيق لمعتقداتك ودوافعك)",
 "自己分解": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "自己反省": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "自己受容器": "مستقبل الحس العميق (نهايات عصبية خاصة في العضلات والأوتار والأعضاء الأخرى تستجيب للمحفزات المتعلقة بوضع وحركة الجسم)",
 "自己否定": "إِنْكَار الذَّات, زُهْد (التخلي عن مصالحك الخاصة لصالح مصالح الآخرين) / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / انضباط ذاتي (سمة ممارسة الانضباط الذاتي)",
 "自己啓発書": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "自己啓発本": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "自己嫌悪": "اشمئزاز من الذات, كره الذات (خزي ناتج عن كراهية قوية لنفسك أو لأفعالك)",
 "自己完結": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自己完結的": "مُسْتَغْرِق فِي نَفْسِه, مُنْغَمِس فِي ذَاتِه (منغمس في اهتماماته أو أفكاره الخاصة)",
 "自己実現": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "自己弁護": "تبرير, حجة (دفاع عن سلوك مسيء أو فشل في الوفاء بوعد وما إلى ذلك)\nمثال: استمر في إيجاد الأعذار للبقاء",
 "自己意識": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "自己愛": "نَرْجِسِيَّة (حُبُّ المرء ذاته وعِشْقُهُ إِيَّاهَا دون سواها)",
 "自己愛性パーソナリティ障害": "اِضْطِرَاب الشَخْصِيَّة النَرْجِسِيَّة",
 "自己愛性人格障害": "اِضْطِرَاب الشَخْصِيَّة النَرْجِسِيَّة",
 "自己憐憫": "رثاء الذات (شعور بالأسى (غالباً ما يكون متساهلاً مع الذات) على معاناة المرء الخاصة)",
 "自己批判": "نقد ذاتي (انتقاد المرء لنفسه)",
 "自己抑制": "تمالك النفس (إظهار التحفظ المفروض على الذات)\nمثال: اعتدال فعال في النقاش",
 "自己投影": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "自己抗体": "جسم مضاد ذاتي (جسم مضاد يعمل ضد أنسجة الكائن الحي الذي ينتجه)",
 "自己撞着": "تناقض ذاتي (مناقضة النفس)",
 "自己暗示": "إيحاء ذاتي (نظام لتطوير الذات طوره إميل كوي وكان شائعاً في العشرينيات والثلاثينيات)",
 "自己本位": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "自己株式": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة ولكنها غير متداولة؛ لا يمكن التصويت بها ولا تدفع أرباحاً)",
 "自己欺まん": "خداع الذات (مفهوم خاطئ يكون في صالح الشخص الذي يحمله)",
 "自己欺瞞": "خداع الذات (مفهوم خاطئ يكون في صالح الشخص الذي يحمله)",
 "自己決定": "تَقْرِيرُ المَصِير",
 "自己消化": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "自己満": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "自己満足": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "自己犠牲": "إِيثَار, نُكْرَان الذَّات (التصرف بقلة اهتمام بالنفس مقابل نجاح النشاط المشترك)",
 "自己目": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "自己相似図形": "فركتل, كسرية ((رياضيات) نمط هندسي يتكرر عند كل مقياس، وبالتالي لا يمكن تمثيله بالهندسة الكلاسيكية)",
 "自己矛盾": "تناقض ذاتي (مناقضة النفس)",
 "自己研鑽": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "自己破壊": "انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "自己移入": "تَعَاطُف",
 "自己移植": "طعم ذاتي (نسيج يؤخذ من موقع ويُطعم في موقع آخر على نفس الشخص)\nمثال: عندما تفشل الكسور في الالتئام، يمكن أن تكون الطعوم الذاتية من العظام قيمة للغاية في مساعدة العظم على الشفاء",
 "自己組織化": "تنظيم ذاتي (تنظيم نفسك (خاصة تنظيم نقابة العمال الخاصة بك))",
 "自己肥大": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "自己肯定感": "تَقْدِير ذَات",
 "自己臭恐怖症": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "自己臭症": "رائحَة الجسم (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…)\nمثال: شم تلك الرائحة.",
 "自己表現": "تعبير عن الذات (التعبير عن فردية المرء (عادة من خلال الأنشطة الإبداعية))",
 "自己診断": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "自己評価": "تَقْدِير ذَات",
 "自己誘導": "حث ذاتي (توليد قوة دافعة كهربائية في دائرة بتغيير التيار في تلك الدائرة؛ يقاس عادة بالهنري)",
 "自己責任": "بِمُفْرَدِي",
 "自己鍛錬": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / انضباط ذاتي (سمة ممارسة الانضباط الذاتي)",
 "自己開示": "إِفْصَاح عَن الذَّات",
 "自己防衛": "دِفَاع عَنِ النَّفْسِ",
 "自己陶酔": "نَرْجِسِيَّة (حُبُّ المرء ذاته وعِشْقُهُ إِيَّاهَا دون سواها)",
 "自律": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "自律システム": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "自律的": "اِسْتِقْلَالِيّ",
 "自律神経節": "عقدة ذاتية (أي من عقد الجهاز العصبي الذاتي التي تغذي أليافها غير الميالينية الأعضاء الداخلية)",
 "自律神経系": "جهاز عصبي ذاتي (جزء الجهاز العصبي للفقاريات الذي يتحكم في الأفعال اللاإرادية للعضلات الملساء والقلب والغدد)",
 "自律訓練法": "تدريب التحفيز الذاتي, علاج ذاتي المنشأ (تدريب المرضى على الاسترخاء الذاتي)",
 "自得": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "自惚れ": "خلاء, غرور (سمة كون المرء مغروراً ومعجباً بنفسه بشكل مفرط؛ كبرياء زائف) / خيال جامح, صورة بلاغية مبتكرة (أداة أو تأثير فني) / تعبير بارع (تعبير ذكي أو مبتكر) / صورة شعرية متكلفة (صورة شعرية معقدة أو مقارنة بعيدة المنال لأشياء متباينة جداً)",
 "自意識": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "自愛": "عشق الذات, نرجسية (اهتمام وإعجاب استثنائي بالنفس) / خيلاء, عجب (مشاعر الفخر المفرط)\nمثال: عشق للذات حجب كل شخص آخر",
 "自慢": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自慢げ": "فَخُور",
 "自慢たらしい": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "自慢たらたら": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "自慢ばなし": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "自慢気": "فَخُور",
 "自慢話": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "自慰": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "自慰行為": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "自我": "اَلْأَنَا / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自我実現": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "自我意識": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "自撮り": "سِلْفِي, سِيلْفِي",
 "自明": "بَدَهِيّ, بَدِيهِيّ (واضح دون حاجة إلى برهان أو حجّة)",
 "自明の理": "افتراض أساسي, بديهية (افتراض أساسي لحجة ما)",
 "自暴": "يَئِسَ / يَأْس",
 "自暴自棄": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "自校": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自校給食": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "自棄": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "自棄っ腹": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "自棄のやんぱち": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "自棄腹": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "自死": "مُنْتَحِر, مُنْتَحِرَة / اسْتِماتَة",
 "自殖": "إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "自殺": "مُنْتَحِر, مُنْتَحِرَة",
 "自殺点": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "自殺的": "اِنْتِحَارِيّ",
 "自民族中心主義": "تَمَرْكُز عِرْقِيّ",
 "自決": "تَقْرِيرُ المَصِير / مُنْتَحِر, مُنْتَحِرَة",
 "自沈": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "自治": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها)",
 "自治体": "بَلَدِيَّة",
 "自治体警察": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "自治区": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "自治政府": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها)",
 "自治権": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "自治機関": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "自治行政": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها)",
 "自治都市": "مَشَاعِيَّة",
 "自治領": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "自涜": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "自滅": "انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "自滅的": "اِنْتِحَارِيّ, مُدَمِّرٌ لِلذَّات (خطير على النفس أو على المصالح الشخصيّة)",
 "自然": "طَبِيعَة, طبيعة / طَبِيعِيّ / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自然の摂理": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "自然主義": "طبيعية ((فلسفة) المذهب القائل بأن العالم يمكن فهمه بمصطلحات علمية دون اللجوء إلى تفسيرات روحية أو خارقة للطبيعة) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "自然主義者": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان)) / طبيعاني, فيلسوف الطبيعة (مدافع عن العقيدة القائلة بأن العالم يمكن فهمه بالمصطلحات العلمية)",
 "自然人類学": "أنثروبولوجيا فيزيائية (فرع الأنثروبولوجيا الذي يتعامل مع نشأة وتنوع البشر)",
 "自然保護区": "مَحْمِيَّة طَبِيعِيَّة",
 "自然免疫": "مناعة طبيعية, مناعة فطرية (مناعة ضد المرض تحدث كجزء من التكوين البيولوجي الطبيعي للفرد)",
 "自然出産": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "自然分娩": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "自然分離": "انتزاع, قَلْع (تمزيق قسري أو فصل جراحي لجزء من الجسم عن آخر) / اجتثاث, انحراف النهر (تغير مفاجئ في مجرى النهر الذي يشكل الحدود بين قطعتين من الأرض مما يؤدي إلى فقدان جزء من أرض مالك واحد وزيادة لاحقة في أرض آخر)",
 "自然史": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "自然史博物館": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "自然哲学": "فيزياء (علم المادة والطاقة وتفاعلاتهما)\nمثال: مادته المفضلة كانت الفيزياء",
 "自然地理": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "自然地理学": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "自然学": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "自然対数": "لوغاريتم طبيعي",
 "自然崇拝": "عبادة الطبيعة (نظام ديني يؤله ويعبد القوى والظواهر الطبيعية)",
 "自然律": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "自然放射線": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "自然数": "عَدَد طَبِيعِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "自然林": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط البشري)",
 "自然毒": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "自然治療": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "自然治癒": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "自然法": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "自然法則": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "自然流産": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "自然消滅": "شَبَح, خَيَال",
 "自然淘汰": "اِنْتِقَاءٌ طَبِيعِيّ",
 "自然災害": "كارثة طبيعية",
 "自然物": "جِسْم طَبِيعِيّ (جسم موجود في الطبيعة؛ ليس من صنع الإنسان)",
 "自然状態": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "自然現象": "ظاهرة طبيعية (جميع الظواهر التي ليست اصطناعية)",
 "自然環境": "بِيئَة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة.",
 "自然界": "طَبِيعَة, طبيعة",
 "自然療法": "علاج طبيعي, نعتالوباثي (طريقة لعلاج المرض باستخدام الغذاء والتمارين والحرارة لمساعدة عملية الشفاء الطبيعية)",
 "自然療法士": "معالج طبيعي (معالج يمارس العلاج الطبيعي (غير الدوائي))",
 "自然発火": "احتراق ذاتي (اشتعال مادة (مثل الخرق الزيتية) ناتج عن عملية أكسدة داخلية)",
 "自然発生": "تولد ذاتي, نشوء تلقائي (ظاهرة عضوية افتراضية يتم من خلالها إنشاء الكائنات الحية من مواد غير حية)",
 "自然的": "طَبِيعِيّ",
 "自然石": "حجر الحقل (حجر يوجد بشكل طبيعي في الحقول؛ يستخدم غالباً كمواد بناء)",
 "自然神学": "اللاهوت الطبيعي (لاهوت يرى أن معرفة الله يمكن اكتسابها عن طريق العقل البشري دون مساعدة الوحي الإلهي)",
 "自然神教": "رُبُوبِيَّة",
 "自然科学": "علوم طبيعية (العلوم المعنية بدراسة العالم المادي وظواهره)",
 "自然科学者": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان))",
 "自然言語": "لُغَةْ طَبِيعِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "自然言語処理": "مُعَالَجَة اللُّغَات الطَبِيعِيَّة",
 "自然言語理解": "لُغَةْ طَبِيعِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "自然誌": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)",
 "自然資源": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "自然選択": "اِنْتِقَاءٌ طَبِيعِيّ",
 "自然霊": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / عنصري (متعلق بـ أو كونه عنصراً (كيميائياً)) / جوهري, عاصف (متعلق بالظروف الجوية القاسية)\nمثال: كبريت عنصري",
 "自然食": "طعام صحي (أي طعام طبيعي أو محضر يعتقد شعبياً أنه يعزز الصحة الجيدة)",
 "自爆": "عَمَلِيَّة تَفْجِيرِيَّة إِنْتِحَارِيَّة, عَمَلِيَّة تَفْجِيرِيَّة",
 "自爆テロ": "عَمَلِيَّة تَفْجِيرِيَّة إِنْتِحَارِيَّة, عَمَلِيَّة تَفْجِيرِيَّة",
 "自用": "مُتَعَنِّت",
 "自由": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "自由か死か": "أَعْطِنِي",
 "自由がきかない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "自由が利かない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "自由が効かない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "自由に": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "自由の女神": "تِمْثَال الْحُرِّيَّة\nمثال: 自由の女神はアメリカの象徴である。 — تمثال الحرية رمزٌ لأمريكا.",
 "自由の女神像": "تِمْثَال الْحُرِّيَّة",
 "自由の身": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "自由エネルギー": "طاقة ((في الفيزياء) كمية ديناميكية حرارية تكافئ قدرة نظام فيزيائي على القيام بشغل؛ وحدات الطاقة هي الجول أو الإرج)\nمثال: يمكن للطاقة أن تتخذ أشكالاً متنوعة",
 "自由ソフトウェア": "بَرْمَجِيَّات حُرَّة",
 "自由三昧": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由世界": "الْعَالَم الْحُرّ",
 "自由主義": "لِيبْرَالِيَّة",
 "自由主義者": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / تحرري, ليبرالي (متسامح مع التغيير؛ غير مقيد بالسلطوية أو الأرثوذكسية أو التقاليد) / حُرّ, مُتَصَرِّف (غير حرفيّ في الترجمة أو التفسير) / جَوَاد, سَخِيّ اليَد (يُعطي أو يُمنح بسخاء وبلا تردد)",
 "自由人": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل)",
 "自由党": "الحزب الليبرالي (حزب سياسي في أستراليا وكندا ودول أخرى، وسابقاً في بريطانيا العظمى)",
 "自由刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "自由労働者": "مُياوِم",
 "自由勝手": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由化": "تحرير, تخفيف القيود (عملية جعل الشيء أقل صرامة)",
 "自由参加": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / اِخْتِيَارِيّ",
 "自由国": "ولاية حرة (أي ولاية كانت تحظر العبودية قبل الحرب الأهلية الأمريكية)",
 "自由型": "أسلوب حر, سباحة حرة (سباق (كما في السباحة) يمتلك فيه كل متسابق حرية اختيار الأسلوب الذي سيستخدمه)",
 "自由契約": "انتقال حر ((رياضة) حالة اللاعب المحترف الحر في التفاوض على عقد للعب لأي فريق) / حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً)) / عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "自由契約選手": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل) / لاعب حر ((في الرياضة) رياضي محترف حر في توقيع عقد للعب مع أي فريق)",
 "自由奔放": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة) / حُرّ, مُنْطَلِق (خالٍ من القيود أو القواعد)",
 "自由帳": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "自由度": "درجة الحرية ((إحصاء) متغير غير مقيد في توزيع التردد) / درجة الحرية (واحدة من الحد الأدنى لعدد المعاملات اللازمة لوصف حالة نظام فيزيائي)",
 "自由形": "أسلوب حر, سباحة حرة (سباق (كما في السباحة) يمتلك فيه كل متسابق حرية اختيار الأسلوب الذي سيستخدمه)",
 "自由思想": "ربوبية, فكر حر (شكل من أشكال العقلانية اللاهوتية يؤمن بالله على أساس العقل دون الرجوع إلى الوحي)",
 "自由思想家": "مفكر حر (شخص يرفض الدين)",
 "自由恋愛": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "自由意志": "حُرِّيَّة الْإِرَادَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "自由意志論": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "自由戦士": "محارب للحرية",
 "自由時間": "رَاحَة, خُلُو مِنَ الْعَمَل\nمثال: いくらか自由時間があるときは、いつもクラシック音楽を聴くのが楽しみだ。 — أحب دائما أن أستمع للموسيقى الكلاسيكية عندما يكون لدي وقت فارغ.",
 "自由業": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "自由権": "حرية مدنية (حق فردي أساسي يحميه القانون ويُعبر عنه بالحصانة من التدخل الحكومي غير المبرر) / حرية سياسية, حرية مدنية (حرية الفرد في ممارسة حقوقه كما تضمنها قوانين البلاد)",
 "自由権規約人権委員会": "الْأُمَم الْمُتَّحِدَة",
 "自由民": "أحرار (الناس الذين يتمتعون بالحرية)\nمثال: موطن الأحرار والشجعان",
 "自由気まま": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由港": "ميناء حر (ميناء مفتوح بشروط متساوية لجميع السفن التجارية) / منطقة حرة, ميناء حر (منطقة مجاورة للميناء حيث يمكن استلام البضائع المعدة لإعادة الشحن وتخزينها دون دفع رسوم جمركية)",
 "自由研究": "بحث علمي, مشروع بحثي (البحث في الأسئلة التي تطرحها النظريات والفرضيات العلمية)",
 "自由自在": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由至上主義": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "自由落下": "انخفاض حاد, سقوط (انخفاض حاد ومفاجئ في كمية ما) / سقوط حر (حركة السقوط المثالية لشيء يخضع فقط لمجال الجاذبية)\nمثال: انخفاض بمقدار 57 نقطة في مؤشر داو جونز",
 "自由裁量": "دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
