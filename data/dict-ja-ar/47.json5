 "考試": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "考課": "تَقْيِيم, تَقْدِير",
 "考量": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "耄碌": "خرف, هرم (حالة الخرف) / خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "者": "أُقْنُوم / فَرْد / أُقْنُوم / فَرْد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "者ども": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "者共": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "耆欲": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة",
 "耆那教": "جَيْنِيَّة, جَايْنِيَّة",
 "而るを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "而今": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "而今而後": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "而後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "耐えうる": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "耐えがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "耐えきれる": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "耐えしのぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "耐える": "دُبّ / دُبَّة / اِحْتَمَلَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "耐え凌ぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "耐え得る": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "耐え忍ぶ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "耐え難い": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "耐久": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "耐久力": "مَتَانَة",
 "耐久性": "مَتَانَة",
 "耐久財": "سلع استهلاكية معمرة, سلع معمرة (سلع استهلاكية لا تتلف أو تُستهلك بمجرد الاستخدام)",
 "耐乏": "تَقَشُّف",
 "耐力壁": "جدار حامل (أي جدار يدعم أرضية أو سقف مبنى)",
 "耐容": "اِحْتَمَلَ",
 "耐屈曲": "مُرُونة",
 "耐性": "مُقَاوَمَة",
 "耐水": "طَارِد لِلْمَاء, مُقَاوِم لِلْمَاء (يمنع نفاذ الماء)",
 "耐火": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "耐火建築物": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "耐火煉瓦": "طوب حراري (طوب مصنوع من الطين الناري؛ يستخدم لتبطين الأفران والمداخن)",
 "耐火物": "جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد) / عَصِيّ, مُمْتَنِع (غير مستجيب مؤقتاً أو غير مستجيب بالكامل لعملية أو محفّز) / عَصِيّ, مُسْتَعْصٍ (لا يستجيب للعلاج) / بطانة الفرن, مادة حرارية (بطانة تتكون من مادة ذات نقطة انصهار عالية؛ تستخدم لتبطين الجدران الداخلية للفرن)",
 "耐炎性": "مُقَاوِم لِلَّهَب (مقاوم لالتقاط النار)",
 "耐熱ガラス": "مَانِع لِلْحَرَارة",
 "耐熱合金": "مَانِع لِلْحَرَارة",
 "耐熱材料": "مَانِع لِلْحَرَارة",
 "耐熱鋼": "مَانِع لِلْحَرَارة",
 "耐用": "مَتَانَة",
 "耐蝕": "مُقَاوِم لِلتَّآكُل (محصَّن ضدّ التآكل والصدأ)",
 "耐難い": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "耐食": "مُقَاوِم لِلتَّآكُل (محصَّن ضدّ التآكل والصدأ)",
 "耒耜": "مِجْرَفَة, مِجْرَف / الْبَسْتُونِيّ",
 "耕うん": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "耕す": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "耕作": "تَهْذِيب",
 "耕作地": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "耕作者": "عزاقة, محراث (أداة زراعية تستخدم لتفتيت سطح التربة (للتهوية ومكافحة الأعشاب الضارة والحفاظ على الرطوبة)) / خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "耕地": "مَزْرَعَة / ضيعة, هاديندا (المنزل الرئيسي في مزرعة أو عزبة كبيرة) / ضيعة, هاسيندا (ضيعة كبيرة في البلدان الناطقة بالإسبانية)",
 "耕耘": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "耕耘機": "عزاقة, محراث (أداة زراعية تستخدم لتفتيت سطح التربة (للتهوية ومكافحة الأعشاب الضارة والحفاظ على الرطوبة)) / خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "耕芸": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "耕運機": "عزاقة, محراث (أداة زراعية تستخدم لتفتيت سطح التربة (للتهوية ومكافحة الأعشاب الضارة والحفاظ على الرطوبة)) / خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "耳": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا. / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق",
 "耳あか": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "耳あて": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "耳うどん": "أُذُنِيُّ الشَّكْلِ, أُذُنِيّ (ذو شكل يشبه الأذن)",
 "耳かす": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "耳くそ": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "耳こすり": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "耳ざとい": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "耳そろえて": "بغتة, فجأة (بشكل مفاجئ) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: فجأة، بدأ بالصراخ",
 "耳たぶ": "شحمة الأذن (الجزء اللحمي المتدلي من الأذن الخارجية للإنسان)",
 "耳だれ": "عَلَامَة اِسْتِفْهَام, ؟ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "耳とう": "سدادة أذن (سدادة من القطن أو الشمع أو المطاط يتم تركيبها في قناة الأذن للحماية من دخول الماء أو الضوضاء العالية) / سدادة أذن (سماعة) (سماعة أذن يتم إدخالها في قناة الأذن)",
 "耳なじみ": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / ألفة, حميمية (صداقة وثيقة أو دافئة) / أُلْفَة, دِرَايَة (الاعتيادية بحكم كون الشيء مألوفاً أو معروفاً جيداً) / تلقائية, عفوية (أسلوب عفوي)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "耳にする": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "耳の不自由": "صَمَم",
 "耳の早い": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "耳より": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "耳をそろえて": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
 "耳を揃えて": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
 "耳ピ": "قُرْط, حَلَق",
 "耳ピアス": "قُرْط, حَلَق",
 "耳下腺": "غدة نكفية (غدة لعابية كبيرة تنتج 50% من اللعاب أثناء النهار؛ توجد في البشر أمام وأسفل كل أذن)",
 "耳下腺炎": "نُكَاف",
 "耳介": "صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب)",
 "耳付き": "خَشِن الحَوَافّ (ذو حافة خشنة غير مستوية؛ يوصف به الورق اليدوي أو ما يشبهه) / ذو أذنين, مؤذن (له أذنان (أو زوائد تشبه الأذنين) أو له أذنان من نوع معين؛ غالباً ما يستخدم في التركيبات اللفظية) / رَثّ, مُثَنَّى الزَّوَايَا (بَالٍ أَوْ رَثٌّ مِنْ كَثْرَةِ الاسْتِعْمَالِ أَوْ (لِلصَّفَحَاتِ) مَطْوِيُّ الزَّوَايَا)",
 "耳切り": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "耳垂れ": "عَلَامَة اِسْتِفْهَام, ؟ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "耳垢": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "耳塚": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "耳学問": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "耳寄り": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "耳小骨": "عظيمات السمع (عظيمات الأذن الوسطى التي تنقل الاهتزازات الصوتية من طبلة الأذن إلى الأذن الداخلية)",
 "耳屎": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "耳年増": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
