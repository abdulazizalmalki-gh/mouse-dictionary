 "金銀": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "金銀複本位制": "نظام المعدنين (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكميات محددة من معدنين (عادة الذهب والفضة) مع تحديد قيم بنسبة محددة مسبقاً)",
 "金銭": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "金銭登録器": "آلَة تَسْجِيل نَقْد (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "金銭登録機": "آلَة تَسْجِيل نَقْد (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "金銭的": "نَقْدِيّ, مَالِيّ",
 "金鋏": "كَلْبَتَان",
 "金鋸": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "金錆": "صَدَأ / صَدَّأَ",
 "金鍍金": "تذهيب, طلي بالذهب (طلاء من الذهب أو شيء يشبه الذهب)",
 "金鍔": "سلاح ذو عمود, فأس الحرب (سلاح قتال قريب يتم فيه تثبيت الجزء القتالي الرئيسي من السلاح في نهاية عمود طويل، عادة من الخشب، مما يوسع النطاق الفعال للمستخدم)\nمثال: نظراً لاحتوائها على القليل نسبياً من المعدن، فإن الأسلحة ذات الأعمدة رخيصة الصنع، مما جعلها السلاح المفضل للمجندين الفلاحين",
 "金鎖": "سلسلة ذهبية, لابورنوم شائع (شجيرة زينة أو شجرة من جنس لابورنوم؛ تزرع غالباً لزينة عيد الفصح)",
 "金離れ": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "金雲母": "فلوغوبيت (شكل بني من الميكا يتكون من سيليكات مائية للبوتاسيوم والمغنيسيوم والألمنيوم)",
 "金額": "مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً",
 "金食い": "غَالٍ, الْغَالِي",
 "金高": "مَجْمُوع / مَبْلَغ",
 "金魚": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "金魚のうんこ": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "金魚のウンコ": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "金魚のフン": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "金魚の糞": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "金魚草": "أَنْف الْعِجْل (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "金魚鉢": "حوض سمك كروي (وعاء شفاف تحفظ فيه الأسماك الصغيرة) / انعدام الخصوصية, تحت المجهر (حالة من انعدام الخصوصية)\nمثال: يعيش الرئيس في وضع تنعدم فيه الخصوصية (تحت المجهر)",
 "金鳳花": "حَوْذَان",
 "金麩羅": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أواني مطلية بالذهب (أدوات مائدة مطلية بالذهب)",
 "金麸羅": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أواني مطلية بالذهب (أدوات مائدة مطلية بالذهب)",
 "金黒羽白": "زرقاي",
 "釘": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "釘付け": "مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "釘打ち機": "آلة برشمة (آلة لدق المسامير)",
 "釘打機": "آلة برشمة (آلة لدق المسامير)",
 "釘抜き": "كَلْبَتَان",
 "釘頭": "رأس المسمار (نتوء مسطح في نهاية المسمار مقابل للنقطة الحادة) / رأس المسمار (شيء يشبه رأس المسمار يُستخدم كأداة زخرفية)",
 "釜": "غَلَّايَة",
 "釜を掘る": "لوطي (شخص يمارس اللواط)",
 "釜山": "بُوسَان",
 "釜風呂": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "針": "إِبْرَة, مِخْيَط / خَطَّاف / لَكْمَة خُطَّافِيَّة / ضربة لاذعة (ضربة حادة مؤلمة) / إبرة لاسعة (عضو حاد للهجوم أو الدفاع (كما في الدبور أو سمك الراي اللاسع أو العقرب) غالباً ما يكون متصلاً بغدة سم) / ستينغر (نظام صواريخ أرض-جو محمول منخفض الارتفاع يستخدم التوجيه بالأشعة تحت الحمراء وصمام تصادم؛ يطلق من الكتف) / طَعْنَة, كَلِمَة جَارِحَة (ملاحظة قادرة على الجرح معنوياً)\nمثال: الطعنة الأكثر قسوة على الإطلاق / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "針ねずみ": "قُنْفُذ",
 "針の目": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "針ほどのことを棒ほどに言う": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "針もぐら": "قَصِير المِنْقَار (ذو منقار قصير)",
 "針ニッケル鉱": "ميليريت (معدن أصفر يتكون من كبريتيد النيكل؛ مصدر ثانوي للنيكل)",
 "針仕事": "أشغال الإبرة, تطريز (العمل الذي يتم بالإبرة (مثل الخياطة أو التطريز)) / أشغال الإبرة, تطريز (إبداع تم إنشاؤه أو تجميعه بالإبرة والخيط)",
 "針刺し": "وسادة الدبابيس (وسادة صلبة صغيرة تغرز فيها الدبابيس لتكون جاهزة للاستخدام)",
 "針千本": "سمكة النيص (تنتصب أشواكها عندما ينتفخ الجسم؛ توجد عالمياً في المياه الدافئة)",
 "針土竜": "قَصِير المِنْقَار (ذو منقار قصير)",
 "針子": "خَيَّاطَة",
 "針孔": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
 "針小棒大": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "針山": "وسادة الدبابيس (وسادة صلبة صغيرة تغرز فيها الدبابيس لتكون جاهزة للاستخدام)",
 "針槐": "شَجَرَةُ الْجَرَادِ, سَنْطٌ كَاذِبٌ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "針状": "إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر)",
 "針目": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "針穴": "ثقب دبوس (ثقب صغير ربما يكون قد صنع بواسطة دبوس)",
 "針莧": "قطيفة شائكة (نبات حولي قائم في آسيا الوسطى الاستوائية وأفريقيا له زوج من الأشواك المتباعدة عند معظم عقد الأوراق)",
 "針葉": "إِبْرَة, مِخْيَط",
 "針葉樹": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط)",
 "針術": "الوَخْز بِالْإِبْر",
 "針路": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "針金": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "針金細工": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "針金虫": "دودة سلكية (يرقة تشبه الدودة لخنفساء النقر؛ تتغذى على جذور العديد من المحاصيل)",
 "針金製造工場": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "針鉄鉱": "غوثيت (معدن أحمر أو أصفر أو بني؛ أكسيد الحديد ومكون شائع للصدأ)",
 "針魚": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "針鰻": "إلفير (صغير الأنقليس) / صغير ثعبان البحر (ثعبان بحر صغير؛ قد يقلى أو يحمر بالعجين)",
 "針鼠": "قُنْفُذ",
 "釣": "صَيْد سَمَك, صَيْد / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "釣り": "صَيْد سَمَك, صَيْد / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "釣りランプ": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "釣り上げる": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "釣り下がる": "دَلَّى",
 "釣り人": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "釣り具": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "釣り合い": "رَصِيد",
 "釣り合う": "رَصِيد / بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "釣り師": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "釣り床": "أُرْجُوحَة شَبَكِيَّة",
 "釣り手": "علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "釣り柿": "كَاكَا / كَاكِي / بِرْسِيمُون",
 "釣り浮き": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "釣り竿": "قَصْبَة صَيْد",
 "釣り籠": "سلة صيد السمك (سلة خوص يستخدمها الصيادون لحفظ السمك)",
 "釣り糸": "خيط الصيد, سنارة (طول من الحبل يُربط به القائد والعوامة والثقالة والخطاف)",
 "釣り舟": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً) / قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
 "釣り船": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً) / قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
 "釣り込む": "اِجْتَذَبَ, جَذَبَ",
 "釣り道具": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "釣り銭": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "釣り鐘堂": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "釣り鐘墨": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "釣り鐘草": "جريس, زهرة الجرس",
