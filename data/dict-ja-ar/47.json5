 "臨終の床": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص)",
 "自": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "自から": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自ずから": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自ずから明らか": "بَدَهِيّ, بَدِيهِيّ (واضح دون حاجة إلى برهان أو حجّة)",
 "自ずと": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自と": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自ら": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "自ら進んで": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "自主": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "自主性": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "自主権": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "自主的": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "自主管理": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "自主規制": "خَاضِع لِلرَّقَابَة, مُرَاقَب (مقموع أو خاضع للرقابة)",
 "自主防衛": "ذَاتِيُّ التَّوْجِيه, مُسْتَقِلّ ((عَنِ الأَشْخَاصِ) حُرٌّ مِنَ السَّيْطَرَةِ وَالقُيُودِ الخَارِجِيَّةِ فِي…)",
 "自乗": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "自乗根": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "自今": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "自今以後": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "自他": "تَعَدٍّ (العلاقة النحوية التي ينشئها الفعل المتعدي) / مُتَكَلِّم",
 "自伝": "سِيرَة ذَاتِيَّة",
 "自伝文学": "سِيرَة ذَاتِيَّة",
 "自体": "نَفْسُهُ, نَفْسُهَا / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / أَصْلًا",
 "自余": "آخَرُون",
 "自作": "حِرْفَة يَدَوِيَّة",
 "自作自演": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "自供": "إِقْرَار, اِعْتِرَاف",
 "自信": "ثِقَة بِالنَّفْس",
 "自信たっぷり": "وَاثِق",
 "自信作": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "自信喪失": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض…)",
 "自信過剰": "مَغْرُور, مُفْرِط الثِّقَة (يتّسم بثقة مفرطة تتجاوز الحدّ المعقول)",
 "自儘": "أَنَانِيّ",
 "自分": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "自分から": "طَوْعًا, طَوَاعِيَةً",
 "自分で": "بالذات, شخصياً (بالحضور الجسدي المباشر؛ دون وسيط)\nمثال: ذهبت إلى هناك شخصياً",
 "自分のことのように": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "自分のことの様に": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "自分のために": "بِمُفْرَدِي",
 "自分の事のように": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "自分の力": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "自分の為に": "بِمُفْرَدِي",
 "自分ひとり": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "自分らしい": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة.",
 "自分らしさ": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش",
 "自分一人": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "自分中心": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "自分勝手": "أَنَانِيَّة",
