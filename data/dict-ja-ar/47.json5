 "遍く": "بعيداً, على نطاق واسع (إلى أو على مدى أو نطاق كبير؛ بعيداً) / بتباعد (بحيث تترك مساحة كبيرة أو مسافة بين الأشياء)\nمثال: تجول بعيداً عبر العديد من الأراضي",
 "遍在": "وجود في كل مكان, وجود كلي (حالة الوجود في كل مكان في آن واحد (أو ما يبدو كذلك))",
 "遍歴": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "遍歴者": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "遍羅": "لبروسية (أسماك بحرية استوائية بشكل رئيسي ذات شفاه لحمية وأسنان قوية؛ عادة ما تكون زاهية الألوان)",
 "遍路": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة. / حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "過ぎ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ\nمثال: スピードの出し過ぎは危険です。 — القيادة بسرعات عالية خطر.",
 "過ぎこしかた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "過ぎこし方": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "過ぎし": "سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / ما فات, ما مضى (أحداث ماضية يجب وضعها جانباً)\nمثال: دع ما فات يموت",
 "過ぎたこと": "سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / ما فات, ما مضى (أحداث ماضية يجب وضعها جانباً)\nمثال: دع ما فات يموت",
 "過ぎた事": "سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / ما فات, ما مضى (أحداث ماضية يجب وضعها جانباً)\nمثال: دع ما فات يموت",
 "過ぎゆく": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "過ぎる": "اِخْتَرَقَ, نَفَذَ / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "過ぎ去る": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "過ぎ来し方": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "過ぎ行く": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "過ぎ越し": "الفَاسِخ, عِيد اَلْفِصْح / عِيد الْفِصْح, الْعِيد الْكَبِير",
 "過ぎ越しの祭": "الفَاسِخ, عِيد اَلْفِصْح",
 "過ぐ": "اِخْتَرَقَ, نَفَذَ / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "過ごす": "أَنْفَقَ, صَرَفَ / قَضَى / شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "過す": "أَنْفَقَ, صَرَفَ / قَضَى / شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "過ち": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "過つ": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / أَضَلَّ",
 "過る": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "過マンガン酸カリウム": "برمنغنات البوتاسيوم (ملح سام يشكل بلورات أرجوانية داكنة ويكون لونه أحمر أرجواني عند ذوبانه في الماء؛ يستخدم كعامل مؤكسد ومبيض وكمطهر ومعقم)",
 "過マンガン酸塩": "برمنغنات (ملح أرجواني غامق لحمض البرمنغنيك؛ يستخدم في المحلول المائي كمطهر ومعقم)",
 "過ヨウ素酸": "حمض البيريوديك (أي حمض لليود يحتوي على الأكسجين)",
 "過保護": "مُفْرِط فِي الحِمَايَة (يحمي بشكل مبالغ فيه)",
 "過充電": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "過分": "مُفْرِط, زَائِد / اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "過剰": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "過剰反応": "رد فعل مبالغ فيه (رد فعل مفرط؛ رد فعل بسلوك عاطفي غير لائق)",
 "過剰摂取": "جُرْعَة زَائِدَة",
 "過剰生産": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "過剰行動": "فرط النشاط (حالة تتميز بالأرق المفرط والحركة الزائدة)",
 "過労": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "過半数": "غَالِبِيَّة, أَغْلَبِيّة",
 "過去": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "過去る": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "過去ログ": "أَرْشِيف / خَشَبَة",
 "過去分詞": "اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "過去完了": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "過去完了形": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "過去形": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "過去時制": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "過去最大": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "過去進行形": "ماضي مستمر (زمن مستمر يُستخدم لوصف حدث كان مستمراً في الماضي)",
 "過呼吸": "فرط التهوية (زيادة عمق ومعدل التنفس بشكل أكبر مما تتطلبه حاجة الجسم؛ يمكن أن يسبب الدوار ووخز الأصابع وألم الصدر إذا استمر)",
 "過塩化物": "بيركلوريد (كلوريد يحتوي على نسبة عالية غير عادية من الكلور)",
 "過塩素酸": "حمض البيركلوريك (عامل مؤكسد قوي؛ يُكوّن البيركلورات)",
 "過塩素酸塩": "بيركلورات (ملح لحمض البيركلوريك)",
 "過多": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "過多月経": "غزارة الطمث, نزيف رحمي (حيض غزير أو طويل بشكل غير طبيعي؛ يمكن أن يكون عرضًا لأورام الرحم ويمكن أن يؤدي إلى فقر الدم إذا طال أمده)",
 "過大": "مُفْرِط, زَائِد",
 "過大視": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "過大評価": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "過失": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "過失割合": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة للمدعي)",
 "過失相殺": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة للمدعي)",
 "過客": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "過密": "احتقان, اكتظاظ مفرط (الاكتظاظ المفرط)\nمثال: احتقان مروري / مُحْتَقِن (مُمْتَلِئ بِإِفْرَاط كَمَا بِالدَّم)",
 "過小評価": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "過少": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "過度": "مُفْرِط, زَائِد",
 "過当": "مُفْرِط, زَائِد",
 "過形成": "فرط التنسج (زيادة غير طبيعية في عدد الخلايا)",
 "過怠": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "過払": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "過払い": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "過振り": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "過敏": "تَوَتُّر",
 "過敏性腸症候群": "القولون التشنجي, متلازمة القولون العصبي (ألم بطني متكرر وإسهال (غالباً ما يتناوب مع فترات من الإمساك)؛ يرتبط غالباً بالضغط النفسي)",
 "過敏症": "فرط حساسية (حساسية مفرطة) / فرط الحساسية (حساسية مرضية)",
 "過日": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "過沃素酸": "حمض البيريوديك (أي حمض لليود يحتوي على الأكسجين)",
 "過渡": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة) / مُؤَقَّت, سَريع الزوال",
 "過渡現象": "مُؤَقَّت, سَريع الزوال",
 "過渡的": "انتقالي (من أو يتعلق بالانتقال أو يتميز به)\nمثال: المراهقة هي مرحلة انتقالية بين الطفولة والبلوغ",
 "過激": "الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل) / شَاقّ, مُضْنٍ (يتّسم بطاقة أو قوة بذل كبيرة)",
 "過激主義": "تَطَرُّف, غُلُوّ",
 "過激思想": "تَطَرُّف, غُلُوّ",
 "過激派": "مُتَطَرِّف, مُتَطَرِّفَة / تَطَرُّفِيّ\nمثال: その過激派が政府打倒の陰謀を企てているという噂が立ってる。 — ثمّة شائعةٌ تقول أن الأصوليين يرسمون خطة مضادة للحكومة.",
 "過焦点距離": "مَسَافَة بُؤْرِيَّة مُفْرِطَة, مَسَافَة فَرْط البُؤْرَة (المسافة أمام العدسة التي يتم تركيزها عند اللانهاية والتي تكون بعدها جميع الأشياء محددة وواضحة بشكل جيد)",
 "過熟児": "طفل متأخر الولادة (رضيع يولد بعد 42 أسبوعاً من الحمل؛ عادة ما يظهر علامات قصور المشيمة)",
 "過熱": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "過熱気味": "مُحْتَرّ بِإِفْرَاط (سُخِّن فوق الحدّ الآمن أو المطلوب)",
 "過疎": "انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق))",
 "過疎化": "انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق))",
 "過眠症": "فرط النوم (عدم القدرة على البقاء مستيقظاً)",
 "過硼酸": "حمض البيربوريك (شكل من أشكال حمض البوريك)",
 "過程": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "過積載": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "過納": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "過給機": "شاحن فائق (ضاغط يدفع المزيد من الأكسجين إلى أسطوانات محرك الاحتراق الداخلي)",
 "過般": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "過行く": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "過褒": "إفراط في الثناء (ثناء مفرط أو غير مستحق)\nمثال: تؤمن معلمة البيانو بتشجيع طلابها لكنها تتجنب أي إفراط في الثناء قد يجعلهم يشعرون بالرضا عن النفس",
 "過言": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / بيان خاطئ (بيان يحتوي على خطأ)",
 "過誤": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "過誤腫": "هيمارتوما, ورم عابي (نمو بؤري يشبه الورم ولكنه ينتج عن خلل في التطور في عضو ما)",
 "過負荷": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "過越": "الفَاسِخ, عِيد اَلْفِصْح / عِيد الْفِصْح, الْعِيد الْكَبِير",
 "過越し": "الفَاسِخ, عِيد اَلْفِصْح / عِيد الْفِصْح, الْعِيد الْكَبِير",
 "過越しの祭": "الفَاسِخ, عِيد اَلْفِصْح",
 "過越の祭": "الفَاسِخ, عِيد اَلْفِصْح",
 "過越祭": "الفَاسِخ, عِيد اَلْفِصْح",
 "過酷": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "過酸化バリウム": "بيروكسيد الباريوم, ثاني أكسيد الباريوم (مسحوق أبيض سام يتم الحصول عليه بتسخين أكسيد الباريوم في الهواء)",
 "過酸化ベンゾイル": "بيروكسيد البنزويل (بيروكسيد بلوري أبيض يستخدم في التبييض (الدقيق أو الزيوت أو الدهون) وكمحفز لتفاعلات الجذور الحرة)",
 "過酸化水素": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ)",
 "過酸化物": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ) / بيروكسيد",
 "過酸症": "فرط الحموضة (حموضة زائدة)",
 "過重": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "過重労働": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "過量": "جُرْعَة زَائِدَة",
 "過食": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "過食嘔吐": "نهام (جوع مرضي لا يشبع (خاصة عندما تسببه آفات الدماغ)) / الشره المرضي, النهام (اضطراب في الأكل يظهر بين الشابات اللاتي يفرطن في الأكل ثم يشعرن بالذنب والاكتئاب وإدانة الذات)",
 "過食症": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز بالإفراط في الأكل تليها فترات من الصيام أو التقيؤ المستحث ذاتياً)",
 "遐齢": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "遑々": "سريع, مستعجل (يتحرك بسرعة أو يؤدى بسرعة أو بعجلة كبيرة)\nمثال: رحلة سريعة إلى المتجر",
 "遑遑": "سريع, مستعجل (يتحرك بسرعة أو يؤدى بسرعة أو بعجلة كبيرة)\nمثال: رحلة سريعة إلى المتجر",
 "道": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَاوِيَّة / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى. / تاو (المبدأ النهائي للكون) / طاوِيّ (معتنق لأي فرع من الطاوية)",
 "道しるべ": "دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / خُنْفُسَاء نَمِرِيَّة",
 "道ずれ": "رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "道ならぬ": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "道にまよう": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "道に迷う": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "道のり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "道ばた": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "道をゆずる": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "道を譲る": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "道を踏み外す": "ضَلَّ",
 "道上": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة",
 "道中": "رِحْلَة, سَفَر / فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة / فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "道中ご無事に": "رِحْلَة سَعِيدَة, رِحْلَة مُوَفَّقَة",
 "道傍": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "道具": "أَدَاة / طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة / أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية.",
 "道具一式": "جرو (صغير أي من حيوانات الفراء المختلفة) / طقم, عدة (معدات تتكون من مجموعة من المواد أو الأدوات لغرض محدد) / حقيبة عدة, طقم (حافظة لاحتواء مجموعة من الأدوات)\nمثال: جرو الثعلب",
 "道具主義": "أداتية (نظام فلسفي براغماتي يعتبر الفكرة أدوات يجب أن توجه أفعالنا وتقاس قيمتها بنجاحها)",
 "道具方": "مسؤول إكسسوارات المسرح (عضو ذكر في طاقم المسرح مسؤول عن الممتلكات والإكسسوارات)",
 "道具的": "أداتِيّ, وَسيلِيّ (يَعْمَل كَوَسيلَة أو أداة لِتَحْقيق غايَة) / آلي (متعلق بالآلات الموسيقية أو مصمم لها أو يعزف عليها)\nمثال: مؤلفات آلية",
 "道具的条件づけ": "إشراط وسيلي (إشراط إجرائي يقرن استجابة بتعزيز في تجارب منفصلة؛ يحدث التعزيز فقط بعد إعطاء الاستجابة)",
 "道具的条件付け": "إشراط وسيلي (إشراط إجرائي يقرن استجابة بتعزيز في تجارب منفصلة؛ يحدث التعزيز فقط بعد إعطاء الاستجابة)",
 "道具箱": "صَنْدُوق اَلْعِدَّة (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "道具論": "أداتية (نظام فلسفي براغماتي يعتبر الفكرة أدوات يجب أن توجه أفعالنا وتقاس قيمتها بنجاحها)",
 "道化": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / غَرُوتِسْكِيّ, مُضْحِك الغَرَابَة (غَرِيب بِشَكْلٍ مُثِير لِلسُّخْرِيَة) / مُهَرِّج",
 "道化る": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "道化師": "مُهَرِّج",
 "道化役者": "مُهَرِّج",
 "道化者": "مُهَرِّج",
 "道化芝居": "فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة) / حشوة مفرومة, فورس ميت (خليط من الدجاج النيئ المفروم والفطر مع الفستق والكمأة والبصل والبقدونس والكثير من الزبدة ويربط بالبيض)",
 "道半ば": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "道場": "ماندا (لغة درافيدية يتم التحدث بها في جنوب وسط الهند، وتحديداً في أوديشا)",
 "道塗": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "道士": "طاوي (متعلق بالنظام الفلسفي الذي طوره لاو تزو وتشوانغ تزو والذي يدعو إلى حياة بسيطة وصادقة) / طاوي (متعلق بالنظام الديني الصيني الشعبي القائم على تعاليم لاو تزو ولكنه يشمل مجموعة من الآلهة مع العرافة والسحر) / طاوِيّ (معتنق لأي فرع من الطاوية)\nمثال: معابد طاوية",
 "道学": "أَخْلَاق, أَدَب / كُونْفُوشِيَّة, كُونْفُشْيُوسِيَة / طَاوِيَّة",
 "道学者": "طاوي (متعلق بالنظام الفلسفي الذي طوره لاو تزو وتشوانغ تزو والذي يدعو إلى حياة بسيطة وصادقة) / طاوي (متعلق بالنظام الديني الصيني الشعبي القائم على تعاليم لاو تزو ولكنه يشمل مجموعة من الآلهة مع العرافة والسحر) / طاوِيّ (معتنق لأي فرع من الطاوية)\nمثال: معابد طاوية",
 "道家": "طاوي (متعلق بالنظام الفلسفي الذي طوره لاو تزو وتشوانغ تزو والذي يدعو إلى حياة بسيطة وصادقة) / طاوي (متعلق بالنظام الديني الصيني الشعبي القائم على تعاليم لاو تزو ولكنه يشمل مجموعة من الآلهة مع العرافة والسحر) / طاوِيّ (معتنق لأي فرع من الطاوية)\nمثال: معابد طاوية",
 "道導": "دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / خُنْفُسَاء نَمِرِيَّة",
 "道床": "أساس الطريق (طبقة أساس تدعم طريقاً)",
 "道府県": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "道徳": "أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "道徳上": "أخلاقياً (فيما يتعلق بالمبادئ الأخلاقية) / أخلاقياً, بفضيلة (بطريقة أخلاقية)\nمثال: غير مبرر أخلاقياً / أَخْلَاقِيّ / عِظَة",
 "道徳主義": "حكم أخلاقي, وعظ أخلاقي (أحكام حول أخلاق شخص آخر) / عظة أخلاقية (حكمة أخلاقية)\nمثال: لم يستطع تحمل وعظها الأخلاقي المتسلط",
 "道徳劇": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل والرذائل)",
 "道徳哲学": "أخلاق, فلسفة أخلاقية (الدراسة الفلسفية للقيم والقواعد الأخلاقية)",
 "道徳学": "أخلاق, فلسفة أخلاقية (الدراسة الفلسفية للقيم والقواعد الأخلاقية)",
 "道徳心": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "道徳性": "أَخْلَاق, أَخْلَاقِيَّة",
 "道徳感覚": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "道徳的": "أَخْلَاقِيّ",
 "道徳的危険": "خطر أخلاقي ((في الاقتصاد) غياب الحافز للحماية من المخاطر عندما تكون محمياً منها (كما هو الحال في التأمين))\nمثال: تتعرض شركات التأمين لخطر أخلاقي إذا لم يكن الطرف المؤمن عليه نزيهاً",
 "道徳経": "داوديجنغ",
 "道徳經": "داوديجنغ",
 "道徳観念": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "道心": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "道念": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "道教": "طَاوِيَّة / خُنْفُسَاء نَمِرِيَّة",
 "道教え": "خُنْفُسَاء نَمِرِيَّة",
 "道普請": "إنشاء الطرق, رصف الطرق (عملية بناء الطرق وتشييدها)",
 "道柳": "عشب العقدة (عشب ضار منخفض النمو بسنيبلات على طول سيقان الأوراق)",
 "道案内": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق)",
 "道楽": "تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع))\nمثال: الإبحار هو هوايتها المفضلة / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "道楽者": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً) / هَاوٍ",
 "道標": "دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق) / دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / خُنْفُسَاء نَمِرِيَّة",
 "道理": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "道理で": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "道県": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "道破": "إِعْلَان, بَيَان",
 "道程": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "道立": "محافظي, ولائي (من أو متعلق بمحافظة أو ولاية (إدارية))\nمثال: متحف الولاية",
 "道端": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "道筋": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / استدلال, تفكير منطقي (تفكير متماسك ومنطقي)",
 "道管": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات / وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "道糸": "خيط الصيد, سنارة (طول من الحبل يُربط به القائد والعوامة والثقالة والخطاف)",
 "道義": "أَخْلَاق, أَخْلَاقِيَّة",
 "道義心": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "道義的": "أَخْلَاقِيّ / عِظَة",
 "道義的責任": "التزام أخلاقي (التزام ينشأ عن اعتبارات الصواب والخطأ)",
 "道脇": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "道芝": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "道草をくう": "ضَيَّعَ اَلْوَقْت",
 "道草を食う": "ضَيَّعَ اَلْوَقْت",
 "道行": "ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "道行き": "ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "道行く人": "عابر سبيل, مار (شخص يمر بشكل عارض أو بالصدفة)",
 "道走": "جواب (الجَوَاب : ما يكون رَدًّا على سؤالٍ أَو دعاءٍ أَو دَعْوَى، أَو رسالةٍ أَو اعتراضٍ ونحو ذلك والجمع : أَجوبة الأعراف - 82؛ الجَوَاب: صوت جَوْبِ الطير وفي حديث بناءِ الكعبة: حديث شريف فسمعنا جواباً من السماءِ، فإِذا بطائر أَعظم من النَّسر)\nمثال: لقد وجدتم الجواب.",
 "道路": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "道路上": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة",
 "道路封鎖": "حَاجِز",
 "道路工事": "إنشاء الطرق, رصف الطرق (عملية بناء الطرق وتشييدها)",
 "道路建設": "إنشاء الطرق, رصف الطرق (عملية بناء الطرق وتشييدها)",
 "道路掃除人": "عامل نظافة الشوارع, كنّاس الشوارع (عامل يعمل لتنظيف الشوارع (خاصة من يعمل لدى قسم الصرف الصحي في البلدية))",
 "道路標識": "عَلَامَةُ طَرِيق, لَافِتَةُ مُرُور (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "道路橋": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "道路脇": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "道辺": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "道途": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "道連れ": "رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "道順": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "達し": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "達す": "بَلَغَ",
 "達する": "بَلَغَ",
 "達人": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "達士": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "達弁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "達意": "جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم) / صفاء الذهن, وضوح (حالة ذهنية صافية؛ غير مشوشة)",
 "達成": "إِنْجَاز",
 "達成可能": "قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "達率": "مُعَامِل (في : هو قِيمَة تبيّن دَرَجَة وجود صِفَة أو علاقة في موقف معلوم؛ في : هو العَدَد الذي يسبق المُتَغَيِّر (الحَرْف) في ذات الحد)\nمثال: أساء توم معاملة ماري.",
 "達眼": "نظرة ثاقبة",
 "達磨": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "達磨ストーブ": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم)",
 "達磨宗": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "達磨船": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "達磨鮫": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "達者": "صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي. / مَاهِر / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "達見": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "達識": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "達辯": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "違い": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "違いない": "أَكِيد / مُتَأَكِّد / طَبْعًا, أَكِيد",
 "違い無い": "أَكِيد / مُتَأَكِّد / طَبْعًا, أَكِيد",
 "違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي. / اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "違うくて": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "違える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / اِلْتِوَاء / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "違くて": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "違乱": "شَغَب ((شَغَبَ) القومَ، وعليهم، وفيهم، وبهم يَشْغَبَ شَغَبًا: هَيَّجَ الشر بينهُم؛ يقال: شَغَبَ فلانٌ: أَحدثَ فتْنَةً وجلَبَةٌ)\nمثال: هو حرض على الشغب. / اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "違作": "فشل المحصول (فشل المحاصيل في إنتاج فائض قابل للتسويق)",
 "違例": "لَا تَقْلِيدِيَّة (الخروج عن المألوف بحكم كون الشيء غير تقليدي) / خروج عن المألوف, عدم التقليدية (الأصالة بحكم كونها غير تقليدية)",
 "違反": "اِنْتِهَاك / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "違反切符": "تَذْكِرَة / تذكرة",
 "違反者": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "違命": "عِصْيَان",
 "違和": "تناقض, عدم ملاءمة (صفة عدم الاتفاق أو عدم الملاءمة)",
 "違和感": "كَرَب, كَآبَة (كَرَبَهُ الغَمُّ وَالهَمُّ: اشتدَّا عليه، أثقلا عليه؛ كَرَبَتْهُ المشاكِلُ: صَعُبَتْ عليه)\nمثال: كانت أسرة سامي تنتظر في كرب.",
 "違変": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "違式": "أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / بساطة, لا رسمية (أسلوب لا يأخذ الأشكال والمراسم على محمل الجد)\nمثال: لا أشعر بالراحة أبداً مع الغرباء",
 "違心": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "違憲": "عَدَم دُسْتُورِيَّة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "違憲性": "عَدَم دُسْتُورِيَّة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "違法": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "違法コピー": "قَرْصَنَة / تَزْوِير",
 "違法ドラッグ": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات عقار محظور؛ تم تعديل القانون في عام 1986 لحظر العقاقير المصممة)",
 "違法性": "لَا قَانُونِيَّة, مُخَالَفَة القَانُون (عدم المشروعية بحكم انتهاك قانون تشريعي ما)",
 "違法所持": "حيازة غير قانونية (حيازة مواد خاضعة للرقابة)",
 "違法者": "مخالف للقانون (شخص يخالف القانون)",
 "違犯": "جنحة, مخالفة (تجاوز يشكل انتهاكاً لما يُحكم بأنه حق) / عملية هجومية, هجوم (عمل مهاجمة العدو) / إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / إهانة, استياء (شعور بالغضب ناتج عن التعرض للإهانة)\nمثال: لقد شعر بالاستياء من سؤالي",
 "違犯行為": "اِنْتِهَاك",
 "違算": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "違約": "خرق العقد (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق.",
 "違約金": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / مَسْلُوب, مُصَادَر (تمّت مصادرته كعقوبة) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "違背": "اِنْتِهَاك",
 "違警罪": "جُنْحَة",
 "遙々": "حتى النهاية, طوال الطريق (إلى الهدف) / إلى أبعد حد (كناية عن الوصول للعلاقة الجنسية الكاملة) / تَمَامًا, كُلِّيًّا\nمثال: تسلقت الجبل حتى النهاية",
 "遙か": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / قَدِيماً",
 "遙かに": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل / قَدِيماً",
 "遜色": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "遠": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "遠々しい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "遠い": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / قصير النظر, مصاب بقصر النظر (غير قادر على رؤية الأشياء البعيدة بوضوح)",
 "遠い昔": "زمن سحيق, قديم الزمان (الماضي البعيد وراء الذاكرة)",
 "遠からず": "قَرِيبًا, سَرْعَانَ مَا",
 "遠く": "قَدِيماً / إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل",
 "遠さ": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "遠ざかる": "اِبْتَعَدَ",
 "遠まわし": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "遠位": "بعيد, قاصٍ (يقع في أبعد نقطة من نقطة الاتصال أو المنشأ، كما في طرف أو عظم) / بعيد عن الوسط, وحشي (موجه بعيداً عن خط الوسط أو المستوى الإنسي للجسم)",
 "遠写": "قَلِيْلُ ٱلاِحْتِمالِ (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)\nمثال: و بعد قليل أتى.",
 "遠出": "هَذَيَان / هَذَى",
 "遠吠": "عُوَاء / غِيبَة",
 "遠吠え": "عُوَاء / غِيبَة",
 "遠回し": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "遠回り": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "遠地点": "أَوْج",
 "遠大": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد)",
 "遠征": "بعثة, حملة (رحلة منظمة لغرض معين) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "遠征試合": "مباراة الذهاب, مباراة خارج الأرض (مباراة تُلعب بعيداً عن الملعب الرئيسي للفريق)",
 "遠心": "طَرْد مَرْكَزِيّ",
 "遠心分": "نَابِذ",
 "遠心分離": "طرد مركزي, نبذ مركزي (عملية فصل المواد ذات الكثافات المختلفة باستخدام جهاز الطرد المركزي)",
 "遠心分離機": "طَرْد مَرْكَزِيّ",
 "遠心力": "قوة الطرد المركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "遠心性": "حَرَكِيّ, صَادِر (للأعصاب والنبضات العصبية؛ تنقل المعلومات بعيداً عن الجهاز العصبي المركزي) / عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد)\nمثال: أعصاب ونبضات صادرة",
 "遠心性神経": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "遠心機": "طَرْد مَرْكَزِيّ",
 "遠心的": "نَابِذ",
 "遠慮": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / احتراس, تروي (التعقل في تجنب الضرر أو الخطر) / تدبير, تروٍ (التخطيط أو التآمر قبل التصرف)\nمثال: توخى الحذر عند فتح الباب",
 "遠慮がち": "خَجُول, خَجِل / خَجُول",
 "遠慮なく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "遠慮のない": "صريح, غير متحفظ (غير حذر أو متحفظ) / غير محجوز (غير محجوز)\nمثال: سلوك غير متحفظ",
 "遠慮の無い": "صريح, غير متحفظ (غير حذر أو متحفظ) / غير محجوز (غير محجوز)\nمثال: سلوك غير متحفظ",
 "遠慮会釈もない": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم",
 "遠慮会釈も無い": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم",
 "遠慮勝ち": "خَجُول, خَجِل / خَجُول",
 "遠慮気味": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "遠慮深い": "مَحْجُوز",
 "遠日点": "أَوْج",
 "遠景": "إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: أكثر ما يميز الحديقة هو المناظر الجميلة",
 "遠望": "إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: أكثر ما يميز الحديقة هو المناظر الجميلة",
 "遠沈": "رَاسِب",
 "遠泳": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "遠洋": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "遠洋定期船": "باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم))",
 "遠洋漁業": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "遠洋航路": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن)",
 "遠流": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "遠浅": "سِرْب, مجموعة أسماك (مجموعة كبيرة من الأسماك) / مياه ضحلة (امتداد من المياه الضحلة) / رصيف رملي, مياه ضحلة (ضفة رملية في مسطح مائي تكون مرئية عند الجزر المنخفض)\nمثال: سبح سرب من الأسماك الصغيرة اللامعة بالجوار",
 "遠海": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "遠点": "أوج, نقطة الأوج ((في الفلك) النقطة في المدار الأبعد عن الجرم الذي يتم الدوران حوله)",
 "遠猷": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "遠目": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "遠眼": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "遠眼鏡": "تِلِسْكُوب, مِقْرَاب",
 "遠矢": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "遠祖": "جد, سلف (مؤسس العائلة) / جَدّ, سَلَف (شخص من زمن سابق ساهم في التقاليد التي تشترك فيها مجموعة ما)\nمثال: حافظوا على إيمان أجدادنا",
 "遠行": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "遠見": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "遠視": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "遠視眼": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "遠謀": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "遠赤外線": "شُوح",
 "遠足": "رحلة ميدانية (رحلة جماعية (إلى متحف أو غابة أو مكان تاريخي) للفحص المباشر) / جَوْلَة, نُزْهَة",
 "遠距離": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "遠距離介護": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "遠近": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "遠近両用メガネ": "نظارة ثنائية البؤرة ((جمع) نظارات لها طولان بؤريان، أحدهما للرؤية القريبة والآخر للرؤية البعيدة)",
 "遠近両用眼鏡": "نظارة ثنائية البؤرة ((جمع) نظارات لها طولان بؤريان، أحدهما للرؤية القريبة والآخر للرؤية البعيدة)",
 "遠近法": "مَنْظُور, نَظْرَة",
 "遠逝": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "遠道": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "遠遠しい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "遠隔": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "遠隔アクセスデータ処理": "معالجة بيانات موزعة, معالجة عن بعد (معالجة البيانات التي يتم فيها تنفيذ بعض الوظائف في أماكن مختلفة ومتصلة بمرافق الإرسال)",
 "遠隔保守システム": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة) / إعانة, عون (نشاط المساهمة في تلبية حاجة أو تعزيز جهد أو غرض ما)\nمثال: قدم لي مساعدة في الأعمال المنزلية",
 "遠隔処理": "معالجة بيانات موزعة, معالجة عن بعد (معالجة البيانات التي يتم فيها تنفيذ بعض الوظائف في أماكن مختلفة ومتصلة بمرافق الإرسال)",
 "遠隔性": "بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "遠隔操作": "تَحَكُّم مِن بُعْد (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "遠隔測定": "قياس عن بعد (النقل والقياس التلقائي للبيانات من مصادر بعيدة عن طريق الأسلاك أو الراديو أو وسائل أخرى)",
 "遠隔端末装置": "طرفية بعيدة, محطة طرفية نائية (طرفية متصلة بجهاز كمبيوتر عن طريق وصلة بيانات)",
 "遠隔計測器": "تيليمتر, مقياس عن بعد (أي أداة علمية لمراقبة الأحداث عن بعد ونقل المعلومات مرة أخرى إلى المراقب)",
 "遠隔通信": "اتصالات سلكية ولاسلكية (فرع الهندسة الكهربائية المعني بتكنولوجيا الاتصالات الإلكترونية عن بعد) / اتصالات, اتصالات عن بعد ((غالباً بصيغة الجمع) الأنظمة المستخدمة في نقل الرسائل عبر مسافات إلكترونياً)",
 "遠離": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص)",
 "遡る": "صَعِدَ, يَصْعَدُ",
 "遡及的": "بِأَثَر رَجْعِيّ, رَجْعِيّ الأَثَر (يؤثّر في أمور ماضية) / بأثر رجعي (وصفي لأي حدث أو حافز أو عملية لها تأثير على آثار الأحداث أو المحفزات أو العمليات التي حدثت سابقًا)",
 "遡求": "فِدَاء / خَلَاص",
 "遣い": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية) / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة) / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "遣い切る": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "遣い捨て": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "遣い物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "遣い込む": "غَلَّ, اِخْتَلَسَ",
 "遣う": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "遣っつける": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "遣って行く": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "遣っ付ける": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "遣らす": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "遣らずの雨": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "遣らずぶったくり": "سرقة كبرى, نهب (فعل السرقة)",
 "遣らずぼったくり": "سرقة كبرى, نهب (فعل السرقة)",
 "遣らせる": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "遣りあう": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "遣りこなす": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "遣りっ放し": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "遣り出し": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / صاري المقدمة المائل, عمود المقدمة (صارٍ يبرز من مقدمة السفينة)",
 "遣り出す": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "遣り切れない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "遣り合う": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "遣り抜く": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "遣り掛け": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "遣り損い": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "遣り損じ": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "遣り損じる": "خطأ فادح, زلة (خطأ محرج)",
 "遣り損ずる": "خطأ فادح, زلة (خطأ محرج)",
 "遣り損ない": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "遣り損なう": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "遣り方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "遣り水": "جَدْوَل / تَيَّار / تَدَفّقَ / ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "遣り熟す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "遣り甲斐のある": "جَدِيرٌ بِالاهْتِمَامِ (ذُو قِيمَةٍ كَافِيَةٍ تُبَرِّرُ اسْتِثْمَارَ الوَقْتِ أَوِ الاهْتِمَامِ)",
 "遣り繰り": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "遣り返す": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "遣り通す": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "遣り遂げる": "أَدَّى",
 "遣わす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / أَنْعَمَ",
 "遣水": "جَدْوَل / تَيَّار / تَدَفّقَ / ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "遥々": "حتى النهاية, طوال الطريق (إلى الهدف) / إلى أبعد حد (كناية عن الوصول للعلاقة الجنسية الكاملة) / تَمَامًا, كُلِّيًّا\nمثال: تسلقت الجبل حتى النهاية",
 "遥か": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / قَدِيماً",
 "遥かかなた": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "遥かに": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل / قَدِيماً",
 "遥か彼方": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "遥か昔": "قَدِيماً",
 "遥遠": "بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "適": "عَرَضِيّ",
 "適う": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "適える": "أَوْفَى, أَدَّى",
 "適さない": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "適した": "كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى)\nمثال: خسر كافة ممتلكاته.",
 "適す": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "適する": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "適わない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / مُسْتَحِيل",
 "適不適": "مُلَاءَمَة, مُنَاسَبَة (صفة امتلاك الخصائص الصحيحة لغرض معين)\nمثال: مطلب مهم هو الملاءمة للرحلات الطويلة",
 "適任": "كَفُوء, مُلَائِم (كافٍ لكنّه ليس متميّزًا أو استثنائيًّا) / كفء, مؤهل (مؤهل بشكل صحيح أو كافٍ أو قادر أو فعال) / ذو أهلية قانونية, مختص (مؤهل قانونياً أو كافٍ من الناحية القانونية)\nمثال: طابع كفء",
 "適任者": "كُفْءٌ تَمَامًا, مُؤَهَّلٌ جِدًّا (مؤهّل أكثر من الحدّ الكافي)",
 "適例": "تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال)",
 "適切": "مُنَاسِب / لَائِق",
 "適合": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / امتثال, توافق (التطابق في الشكل أو المظهر) / امْتِثَال, تَحَجُّر (تقليدية متصلبة) / امتثال, مسايرة (الالتزام بالمعايير التقليدية في الأفكار والمعتقدات)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "適合性": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "適合検査": "امتثال, توافق (التطابق في الشكل أو المظهر)",
 "適合率": "إِحْكَام, دِقَّة (صفة القابلية للتكرار في الكمية أو الأداء)\nمثال: تعامل معها بدقة آلة أوتوماتيكية",
 "適否": "أدب, صواب (السلوك الصحيح أو المناسب)",
 "適宜": "مُنَاسِب, مُلَائِم / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "適度": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "適当": "مُنَاسِب, مُلَائِم / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / شَكْلِيّ, صُورِيّ (يُؤَدَّى أَوْ يُنْتَجُ كَإِجْرَاءٍ شَكْلِيٍّ فَحَسْبُ)",
 "適応": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "適応力": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "適応度": "لِيَاقَة, صِحَّة (مصدر من لَاقَ)\nمثال: كان زيري يتمتع باللياقة البدنية.",
 "適応性": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "適応放散": "تشعب تكيفي (تطور أشكال مختلفة عديدة من مجموعة كائنات متجانسة أصلاً أثناء ملئها لمنافذ بيئية مختلفة)",
 "適応能力": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "適応障害": "سوء التكيف (حالة عدم القدرة على التكيف بشكل صحيح مع بيئتك مما يؤدي إلى عدم استقرار عاطفي)",
 "適性": "اِسْتِعْدَاد, مَوْهِبَة",
 "適時": "فِي الوَقْت المُنَاسِب (في وقت ملائم) / فِي أَوَانِه, فِي الوَقْت المُنَاسِب (يحدث أو يتم في الوقت الملائم أو المناسب) / فِي الوَقْتِ المُنَاسِب (قبل انتهاء المهلة الزمنية المحدّدة)\nمثال: وصلت رسالتك في الوقت المناسب",
 "適格": "مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "適格である": "مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "適格性": "أَهْلِيَّة, اسْتِحْقَاق (صفة أو حالة كون الشخص مؤهلاً)\nمثال: أهلية المرشح للمنصب",
 "適正": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "適法": "قَانُونِيّ",
 "適法性": "قَانُونِيَّة, مَشْرُوعِيَّة",
 "適法手続": "ضَمَان الحُقُوق (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "適用": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "適用外": "مُعْفًى",
 "適用性": "قَابِلِيَّة التَّطْبِيق, مُلَاءَمَة (الصلة بحكم كون الشيء قابلاً للتطبيق على الموضوع المطروح)",
 "適用業務": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "適用範囲": "حَيِّز",
 "適用除外": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة) / إعفاء (خصم مسموح به لدافع الضرائب بسبب وضعه (وجود معالين معينين أو كونه كفيفاً أو تجاوز سن 65 إلخ)) / إعفاء, تحرر (الحصانة من التزام أو واجب)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "適確": "مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "適者": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "適者生存": "انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة)",
 "適語": "الكلمة المناسبة (الكلمة أو التعبير المناسب)",
 "遭う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "遭逢": "لقاء عارض, مصادفة (لقاء عارض مع شخص أو شيء)",
 "遭遇": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "遭遇戦": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "遭難": "كَارِثَة, مُصِيبَة",
 "遭難信号": "إشارة استغاثة, نداء استغاثة (إشارة معترف بها دولياً ترسلها سفينة أو طائرة تفيد بالحاجة إلى المساعدة)",
 "遭難救助隊": "فريق الإنقاذ (مجموعة من المنقذين)",
 "遭難者": "ضَحِيَّة / أُضْحِيَّة",
 "遮へい": "حجب, درع (فعل الحجب عن الأذى) / تدريع إشعاعي, حجب (درع من الرصاص أو الخرسانة يهدف ليكون حاجزاً للإشعاع المنبعث في التحلل النووي) / تدريع, حجب كهرومغناطيسي (درع يتكون من ترتيب لشبكة معدنية أو صفائح مصممة لحماية المعدات الإلكترونية من التداخل الكهرومغناطيسي المحيط)",
 "遮る": "قَاطَعَ",
 "遮二無二": "بإلحاح, بشكل عاجل (بإلحاح شديد) / باستماتة, بيأس (بيأس شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "遮光": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة)",
 "遮光幕": "أَبَاجُور, عَاكِس النُّور",
 "遮断": "تَوَحُّد",
 "遮断器": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "遮断壁": "حاجز / جدار ساحلي",
 "遮断機": "حَاجِز / عَقَبَة, حَاجِز",
 "遮断薬": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "遮水": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "遮熱": "عزل حراري (تقليل انتقال الحرارة بين الأجسام المتلامسة حرارياً أو في نطاق التأثير الإشعاعي)\nمثال: هناك عدد من المنتجات المتاحة المصممة لتحسين العزل الحراري للمنازل، بما في ذلك الزجاج الحراري مثل بلانيثيرم",
 "遮眼帯": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين) / إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "遮眼革": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين) / إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "遮莫": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "遮蔽": "حجب, درع (فعل الحجب عن الأذى) / تدريع إشعاعي, حجب (درع من الرصاص أو الخرسانة يهدف ليكون حاجزاً للإشعاع المنبعث في التحلل النووي) / تدريع, حجب كهرومغناطيسي (درع يتكون من ترتيب لشبكة معدنية أو صفائح مصممة لحماية المعدات الإلكترونية من التداخل الكهرومغناطيسي المحيط)",
 "遮蔽物": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "遮音": "عَازِل لِلصَّوْت (لا ينفذ منه الصوت)",
 "遮音壁": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة الصوت)",
 "遵奉": "أَطَاعَ",
 "遵奉者": "اتباعي, مساير (يتميز بالعرف والامتثال للعادات أو القواعد أو الأنماط) / مُلْتَزِم, مُمْتَثِل (يتمسك بالعادات أو المذاهب الراسخة خاصة في الدين) / ملتزم, ممتثل (شخص يمتثل لمعايير السلوك الراسخة (خاصة في الأمور الدينية))\nمثال: تحت المظهر الراديكالي، المراهقون ممتثلون (للأعراف) بشكل مدهش",
 "遵守": "رصد, مراقبة (فعل المراقبة؛ أخذ نظرة متأنية) / اِحْتِرَام, اِلْتِزَام (الامتثال للقانون أو العرف أو الممارسة وما إلى ذلك) / انتباه, ملاحظة (فعل الملاحظة أو الانتباه) / احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: نجا من ملاحظة الشرطة",
 "遵法精神": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "遵行": "طَاعَة, إِطَاعَة",
 "遷化": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "遷延": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遷流": "مُؤَقَّت, سَريع الزوال",
 "遷移": "تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "選": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "選する": "اِخْتَارَ",
 "選ばれし者": "الْمُخْتَار, الْمُخْتَارَة",
 "選び": "اِخْتَارَ",
 "選びとる": "اِخْتَارَ",
 "選び出す": "اِخْتَارَ",
 "選び取る": "اِخْتَارَ",
 "選び方": "اِخْتِيَار, خِيَار",
 "選ぶ": "اِخْتَارَ",
 "選り": "اِخْتَارَ",
 "選り出す": "اِخْتَارَ",
 "選り分ける": "صَنَّفَ, قَسَّمَ",
 "選り屑": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "選り抜き": "نُخْبَة\nمثال: あの科学者たちは選り抜きだ。 — هؤلاء العلماء هم صفوة الصفوة.",
 "選り抜く": "اِخْتَارَ",
 "選る": "اِخْتَارَ",
 "選任": "تَعْيِين, تَرْشِيح",
 "選出": "اِنْتِخَاب, اِنْتِخَابَات",
 "選別": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "選地": "مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "選外": "غير مختار (لم يتم اختياره)",
 "選外佳作": "تنويه شرفي, ذكر مشرف (اعتراف رسمي بالاستحقاق)\nمثال: على الرغم من أنه لم يفز بالجائزة، إلا أنه حصل على تنويه خاص",
 "選奨": "تَوْصِيَة",
 "選好": "تَفْضِيل, أَفْضَلِيَّة",
 "選定": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "選手": "لَاعِب / مَشْغَل, جِهَاز / مَشْغَل / مُقَامِر",
 "選手団": "فَرِيق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "選手権": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "選手権保持者": "نَصِير, نَصِيرَة",
 "選抜": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "選抜チーム": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "選択": "اِخْتِيَار, خِيَار",
 "選択の自由": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة",
 "選択中": "مختار, منتقى (تم اختياره تفضيلاً على غيره)",
 "選択子": "مفتاح اختيار (مفتاح يستخدم للاختيار بين البدائل) / مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "選択権": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "選択的": "اِنْتِقَائِيّ",
 "選択的セロトニン再取り込み阻害薬": "مثبط استرداد السيروتونين الانتقائي (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد السيروتونين بحيث يتوفر المزيد من السيروتونين للعمل على المستقبلات في الدماغ)",
 "選択者": "مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "選択肢": "اِخْتِيَار, خِيَار",
 "選択項目": "اِخْتِيَار, خِيَار",
 "選挙": "اِنْتِخَاب, اِنْتِخَابَات",
 "選挙人": "مُصَوِّت, نَاخِب",
 "選挙人団": "مجمع انتخابي (هيئة الناخبين الذين ينتخبون رسمياً رئيس الولايات المتحدة ونائب الرئيس)",
 "選挙制度": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "選挙区": "دائرة إدارية, قِسم (منطقة في مدينة أو بلدة محددة لأغراض إدارية)",
 "選挙学": "علم الانتخابات (فرع علم الاجتماع الذي يدرس اتجاهات الانتخابات)",
 "選挙日": "يوم الاقتراع, يوم الانتخابات (اليوم المحدد للانتخابات؛ في الولايات المتحدة هو أول ثلاثاء بعد أول اثنين في نوفمبر)",
 "選挙権": "اقتراع, حق الانتخاب (حق قانوني يكفل التصويت في الانتخابات)\nمثال: حصلت النساء الأمريكيات على حق التصويت في عام 1920",
 "選挙権年齢": "سن الانتخاب, سن التصويت (السن الذي يكون فيه الشخص كبيراً بما يكفي للتصويت في الانتخابات العامة)",
 "選挙母体": "الهيئة الناخبة, ناخبون (هيئة المواطنين الذين يحق لهم التصويت)",
 "選挙民": "مُصَوِّت, نَاخِب",
 "選挙運動": "حملة انتخابية (حملة المرشح ليتم انتخابه) / حملة, حملة سياسية (سباق بين المرشحين لمنصب منتخب)\nمثال: أدرت حملته لمنصب الحاكم",
 "選書": "تَجْمِيعَة, دِيوَان",
 "選民": "شعب الله المختار (أي شعب يعتقد أن الله اختاره)",
 "選民思想": "نُخْبَوِيَّة",
 "選科": "مادة اختيارية, مقرر اختياري (دورة يمكن للطالب اختيارها من بين البدائل)",
 "選考": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "選者": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "選良": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم) / نُخْبَة",
 "選言": "فصل, قطع الاتصال (عملية قطع الاتصال) / انفصال, تفكك (حالة الانفصال)",
 "選言的": "انفصالي, فصلي (يخدم أو يميل إلى التقسيم أو الفصل)",
 "選鉱": "استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة)",
 "選集": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "遺す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "遺事": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "遺伝": "إرث جيني, وراثة (مجموع الصفات الموروثة) / وراثة (العملية البيولوجية التي تنتقل بها العوامل الوراثية من جيل إلى جيل)",
 "遺伝カウンセリング": "اسْتِشَارَة وِرَاثِيَّة (إرشاد للآباء المحتملين حول احتمالية حدوث اضطرابات وراثية في أطفالهم المستقبليين)",
 "遺伝因子": "مُوَرِّثَة, جِين",
 "遺伝地図": "خريطة جينية (تمثيل رسومي لترتيب الجينات على الكروموسوم)",
 "遺伝子": "مُوَرِّثَة, جِين",
 "遺伝子マーカー": "واسم جيني (جين محدد ينتج سمة يمكن التعرف عليها ويمكن استخدامه في دراسات العائلة أو السكان)",
 "遺伝子地図": "خريطة جينية (تمثيل رسومي لترتيب الجينات على الكروموسوم)",
 "遺伝子型": "تكوين وراثي, نمط جيني (الأليلات المحددة في مواقع معينة موجودة في كائن حي) / الطراز الجيني, النمط الجيني (مجموعة من الكائنات الحية تشترك في تكوين جيني محدد)",
 "遺伝子工学": "هندسة وراثية (تكنولوجيا إعداد الحمض النووي المؤتلف في المختبر عن طريق تقطيع جزيئات الحمض النووي وربط الأجزاء معاً من أكثر من كائن حي)",
 "遺伝子疾患": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "遺伝子発現": "تعبير جيني",
 "遺伝子突然変異": "طفرة جينية, طفرة نقطية ((في علم الوراثة) طفرة ناتجة عن إعادة تنظيم داخل الجزيء لجين ما)",
 "遺伝子組み換え": "غرام (وحدة مترية للوزن تساوي واحداً من الألف من الكيلوغرام)",
 "遺伝子組換え": "غرام (وحدة مترية للوزن تساوي واحداً من الألف من الكيلوغرام)",
 "遺伝学": "عِلْمُ وِرَاثَة, وِرَاثِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "遺伝学者": "عالم وراثة (عالم أحياء يتخصص في علم الوراثة)",
 "遺伝性": "قابل للتوريث, وراثي (قابل لأن يورَّث)\nمثال: سمات وراثية مثل لون العين",
 "遺伝性疾患": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "遺伝暗号": "شفرة وراثية, كود جيني (ترتيب النيوكليوتيدات في جزيئات الحمض النووي الذي يحمل المعلومات الوراثية في الخلايا الحية)",
 "遺伝的": "عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة) / جيني, وراثي (مكون من أو متعلق بعلم الوراثة) / تكويني, نشوئي (يخص أو يشير إلى الأصل أو المنشأ) / جيني, مورثي (مكون من أو متعلق بـ أو ناتج عن أو كونه جيناً)\nمثال: بحث وراثي",
 "遺伝的アルゴリズム": "خوارزمية جينية ((حوسبة) إجراء بحث يستخدم تقنيات مستوحاة من النظرية البيولوجية للاختيار الطبيعي)",
 "遺伝相談": "اسْتِشَارَة وِرَاثِيَّة (إرشاد للآباء المحتملين حول احتمالية حدوث اضطرابات وراثية في أطفالهم المستقبليين)",
 "遺伝資源へのアクセスと利益配分": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة الأخرى)",
 "遺体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "遺体安置所": "جنائزي (من أو يتعلق بالجنازة) / موتي (من أو يتعلق بالموت أو يميزه) / دار الجنائز, مشررحة (مبنى (أو غرفة) تُحفظ فيه الجثث قبل الدفن أو الحرق)",
 "遺体整復師": "محنط (متعهد دفن يعالج الجثث بالمواد الحافظة)",
