 "耳語": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "耳輪": "قُرْط, حَلَق",
 "耳遠い": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "耳金": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً كطعم للصيد) / عروة, مقبض ناتئ (قطعة بارزة تستخدم لرفع أو دعم أو تدوير شيء ما) / شراع عارضة, شراع لوغ (شراع بأربعة أركان يُرفع من عارضة تكون مائلة بالنسبة للصارية)",
 "耳鏡": "منظار الأذن (أداة طبية تتكون من عدسة مكبرة وضوء؛ تستخدم لفحص الأذن الخارجية (القناة السمعية وخاصة طبلة الأذن))",
 "耳障り": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "耳飾": "قُرْط, حَلَق",
 "耳飾り": "قُرْط, حَلَق",
 "耳馴染み": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / ألفة, حميمية (صداقة وثيقة أو دافئة) / أُلْفَة, دِرَايَة (الاعتيادية بحكم كون الشيء مألوفاً أو معروفاً جيداً) / تلقائية, عفوية (أسلوب عفوي)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "耳鳴": "طَنِين",
 "耳鳴り": "طَنِين",
 "耳鼻咽喉科": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "耳鼻咽喉科学": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "耳鼻科": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "耳鼻科学": "طب الأنف والأذن والحنجرة (التخصص الطبي الذي يتعامل مع أمراض الأذن والأنف والحنجرة)",
 "耶蘇": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا. / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "耶蘇会": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
 "耶蘇基督": "يَسُوع الْمَسِيح, عِيسَى الْمَسِيح ((في المسيحية) الْمَسِيح يَسُوع النَّاصِرِيّ، وهو الشخصية المركزية في المسيحية، حيث يؤمنون بأنه ابن الله…)",
 "耶蘇教": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "耻": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "耽溺": "صَكّ غُفْرَان",
 "耽美的": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / استيطيقي, جمالي (يتعلق بموضوع علم الجمال (الاستيطيقا)) / جمالية ((فلسفة) نظرية فلسفية حول ماهية الجميل)\nمثال: الملكات الجمالية",
 "聆し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "聖": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / مُقَدَّس / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / قَيْصَر, إِمْبْرَاطُور / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "聖い": "مُقَدَّس",
 "聖なる": "مُقَدَّس",
 "聖カタリナ女子大学": "سانت كاترين",
 "聖ニコラス": "القِدِّيس نِقُولَا",
 "聖上": "قَيْصَر, إِمْبْرَاطُور",
 "聖人": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة. / بُوذَا, بُدّ / حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "聖人君子": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "聖伝": "تَقْلِيد",
 "聖体": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "聖体拝領": "تَنَاوُل (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه) / أَفْخَارِسْتِيَا\nمثال: تناول سامي سما.",
 "聖像": "قُونَة, أَيْقُونَة / أَيْقُونَة",
 "聖公会": "الكنيسة الإنجليكانية, كنيسة إنجلترا (الكنيسة الوطنية لإنجلترا (وجميع الكنائس الأخرى في بلدان أخرى تشاركها معتقداتها)؛ مقرها في كانتربري والملك هو رئيسها الزمني)",
 "聖典": "أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية)",
 "聖別": "تكريس (تقديس شيء ما عن طريق تخصيصه (عادة بطقوس دينية) لله) / تَكْرِيس (التزام رسمي بحياتك أو وقتك لغرض عزيز (لخدمة أو هدف))\nمثال: حضر الكاردينال تكريس الكنيسة",
 "聖刻文字": "هِيرُوغْلِيفِيَّة",
 "聖化": "تقديس (حفل ديني يتم فيه جعل شيء مقدسًا)",
 "聖卓": "مَذْبَح, هَيْكَل",
 "聖句": "أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "聖史劇": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "聖名祝日": "يَوْم اِسْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "聖告": "إعلان, بلاغ (بيان عام رسمي) / 25 مارس, عيد البشارة (مهرجان يحيي ذكرى إعلان التجسد من قبل الملاك جبرائيل للسيدة العذراء مريم؛ يوم ربع سنوي في إنجلترا وويلز وأيرلندا)\nمثال: أصدرت الحكومة إعلاناً حول التغييرات في الحرب على المخدرات",
 "聖哲": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
