 "自製": "مَنْزِلِيّ",
 "自覚": "وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني. / ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل)",
 "自覚的": "خَجُول, مُرْتَبِك مِنْ ذَاتِهِ (واعٍ بشكل مفرط وغير مريح بمظهره أو سلوكه)",
 "自記気圧計": "باروجراف, مسجل الضغط الجوي (بارومتر مسجل؛ يسجل تلقائياً التغيرات في الضغط الجوي على الورق)",
 "自記温度計": "مقياس حرارة ذاتي التسجيل (مقياس حرارة يسجل درجة الحرارة تلقائياً)",
 "自認": "إدخال, قبول (فعل السماح لشخص بالدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "自警": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين) / إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "自警団": "دِفَاع عَنِ النَّفْسِ",
 "自警団員": "عضو لجنة الأمن الأهلية (عضو في لجنة الأمن الأهلية)",
 "自讃": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "自負": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "自負心": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
