 "花道": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "花野菜": "قَرْنَبِيط, قُنَّبِيط",
 "花金": "الْجُمُعَة, الجُمْعَة",
 "花鑢": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "花開く": "زَهْرَة\nمثال: أرى زهرة على المكتب. / زَهْرَة, زُهُور\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "花頭窓": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "花魁": "دَاعِرَة, بَغِيَّة",
 "花鶏": "شرشور جبلي, عصفور زغاري",
 "芳しい": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "芳しくない": "فَقِير",
 "芳ばしい": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ)\nمثال: مركب عضوي عطري",
 "芳信": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "芳名": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)",
 "芳川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "芳志": "إِحْسَان",
 "芳恩": "تفضل, خدمة (عمل يتسم باللطف والتفضل)\nمثال: كانت النتيجة في صالحه",
 "芳春": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة.",
 "芳烈": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ)\nمثال: مركب عضوي عطري",
 "芳詠": "قَصِيدَة, شِعْر",
 "芳賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "芳醇": "برخامة, بنعومة (بطريقة رخيمة)",
 "芳韻": "قَصِيدَة, شِعْر",
 "芳香": "أَرِيج, عَبِير\nمثال: هذا العطر يجعلني أشعر بالمرض.",
 "芳香剤": "أَرِيج, عَبِير",
 "芳香族": "مركب عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات)",
 "芳香族化合物": "مركب عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات)",
 "芳香族性": "عطرية (خاصية امتلاك أريج)",
 "芳香族炭化水素": "هيدروكربون عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات…)",
 "芳香油": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "芳香療法": "علاج بالروائح (الاستخدام العلاجي للمستخلصات النباتية العطرية والزيوت الأساسية في الحمامات أو…)",
 "芸": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "芸がない": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
 "芸が無い": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
 "芸なし": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ)",
 "芸なし猿": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "芸のない": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
