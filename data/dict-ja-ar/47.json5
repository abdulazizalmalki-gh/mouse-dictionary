 "肝いり": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝がん": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝が太い": "جَرِيء, جَسُور",
 "肝っ玉": "أَحْشَاء",
 "肝に銘じる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "肝の据わった": "لَا يَتَزَعْزَع, وَقُور (لا يسهل إزعاجه أو إثارته؛ يتّسم بهدوء وضبط نفس شديدَين)",
 "肝を煎る": "إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / التهاب بالاحتكاك, سحجة (ألم ودفء ناتج عن الاحتكاك)\nمثال: كان لديه سحجة سيئة على ركبته / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "肝ガン": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝付": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "肝入り": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝動脈": "شريان كبدي (شرايين تغذي الكبد)",
 "肝心": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "肝心要": "حَاسِم",
 "肝所": "مَرْبِط الْفَرَس",
 "肝斑": "كَلَف (سبب له كُلْفَة، أي كان أمرا صعبا وغير سهل أو طبيعي؛ جعل عليه كُلْفَة وثَمَنا كبيرا، أي كان غاليا عليه)\nمثال: كلف ذلك فاضل حياته.",
 "肝木": "رباطية أوبولس, ورد غيلدر (شجيرة نفضية من العالم القديم تشكل غابات صغيرة، لها عناقيد من الزهور البيضاء وتوت أحمر لامع صغير)",
 "肝油": "زيت السمك, زيت كبد السمك (زيت دهني يتم الحصول عليه من أكباد الأسماك المختلفة)",
 "肝炎": "اِلْتِهَاب الْكَبِد",
 "肝煎": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝煎り": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
