 "船方": "مراكبي (رجل يقود أو يركب قارباً)",
 "船旅": "رِحْلَة",
 "船木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "船架": "مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو إصلاحها)",
 "船枻": "تبليط بالألواح الخشبية (عمل تغطية منطقة بألواح خشبية) / أرضية خشبية, تبليط خشبي ((بحرياً) غطاء أو أرضية مصنوعة من الألواح الخشبية (كما في السفينة)) / ألواح خشبية (الألواح الخشبية بشكل جماعي؛ كمية من الألواح)",
 "船棚": "تبليط بالألواح الخشبية (عمل تغطية منطقة بألواح خشبية) / أرضية خشبية, تبليط خشبي ((بحرياً) غطاء أو أرضية مصنوعة من الألواح الخشبية (كما في السفينة)) / ألواح خشبية (الألواح الخشبية بشكل جماعي؛ كمية من الألواح)",
 "船橋": "جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "船檣": "صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "船歌": "أغنية المراكبي, باركارول (أغنية قوارب يغنيها جندوليو البندقية)",
 "船止": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "船止め": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "船殻": "بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة)",
 "船淦": "ماء الآسن (الماء المتجمع في قاع السفينة)",
 "船渠": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "船渡し": "مُعَدِّيَة, عَبَّارَة / سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "船溜まり": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة) / رسوم الرسو (رسم للإرساء)",
 "船田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "船留": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "船留め": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "船着": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "船着き": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "船着き場": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "船着場": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "船積": "بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "船積み": "بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "船窓": "فتحة إطلاق النار, كوة (فتحة (في جدار أو سفينة أو مركبة مدرعة) لإطلاق النار من خلالها) / كوة (نافذة في سفينة أو طائرة)",
 "船端": "حافة المركب, طراد (اللوح العلوي لجانب القارب؛ أعلى ألواح السفينة الخشبية)",
 "船競べ": "سباق القوارب (سباق بين أشخاص يجدفون أو يقودون القوارب)",
 "船縁": "حافة المركب, طراد (اللوح العلوي لجانب القارب؛ أعلى ألواح السفينة الخشبية)",
 "船繋り": "أَنْكُورِيج",
 "船脚": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "船腹": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "船舶": "وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "船舶工学": "مهندس بحري (ضابط بحري مسؤول عن تشغيل وصيانة محركات السفينة)",
 "船舶技師": "مهندس بحري (ضابط بحري مسؤول عن تشغيل وصيانة محركات السفينة)",
 "船舶職員": "ضابط بحري (شخص مخول للخدمة في منصب قيادي على سفينة)\nمثال: هو الضابط المسؤول عن محركات السفينة",
 "船艇": "سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة.",
 "船艙": "حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "船荷": "حُمُولَة, شِحْنَة",
 "船荷証券": "بُولِيصَةُ شَحْنٍ",
 "船蔵": "مرفأ قوارب (سقيفة على حافة نهر أو بحيرة؛ تستخدم لتخزين القوارب) / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "船藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "船虫": "قمل البحر (قشريات بحرية متماثلة الأرجل)",
 "船賃": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "船足": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "船路": "رِحْلَة",
 "船軍": "معركة بحرية (معركة ضارية بين أساطيل بحرية) / بَحْرِيَّة / كُحْلِيّ",
 "船遊び": "إبحار باليخوت, ركمجة (السفر المائي للمتعة)",
 "船酔い": "دُوَار اَلْبَحْر, مَيْد (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "船長": "ربان, قبطان (الضابط البحري الذي يتولى قيادة سفينة عسكرية) / ربان, قبطان (ضابط مرخص له بقيادة سفينة تجارية) / طالب متغيب (طالب يفشل في حضور الفصول الدراسية) / مراكبي (رجل يقود أو يركب قارباً)",
 "船隊": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي)",
 "船頭": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار. / مراكبي (رجل يقود أو يركب قارباً)",
 "船食虫": "دودة السفن (ذوات صدفتين بحرية تشبه الدودة تحفر في الأرصفة الخشبية والسفن بواسطة أصداف تشبه المثقاب)",
 "船饅頭": "مُنْخَفِض الدَّرَجَة",
 "船首": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "船首像": "تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية) / واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "船首楼": "عنبر البحارة (أماكن معيشة تتكون من بنية فوقية في مقدمة السفينة التجارية حيث يتم إيواء الطاقم)",
 "艀": "قَدَّاحَة, وَلَّاعَة",
 "艀船": "قَدَّاحَة, وَلَّاعَة",
 "艇": "قَارِب, مَرْكَب (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "艇体": "بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة)",
 "艇長": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "艇首": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "艘": "قارب صغير (قارب صغير الحجم)",
 "艙口": "حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "艟艨": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)",
 "艤装": "تجهيز السفن (فعل تجديد وتجهيز سفينة)",
 "艦": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "艦尾": "صَارِم, مُتَشَدِّد / مُؤَخَّرَة",
 "艦橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "艦艇": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "艦長": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "艦隊": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي)",
 "艦首": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "艨艟": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "艫": "صَارِم, مُتَشَدِّد / مُؤَخَّرَة / صَارِم, مُتَشَدِّد / مُؤَخَّرَة / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "艫座": "سطح الكوثل (سطح مكشوف جزئي على البنية الفوقية لمؤخرة السفينة)",
 "艫綱": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "艮": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة) / معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك",
 "艮為山": "معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك",
 "良": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "良い": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "良いお年を": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "良いころ": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "良い具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "良い塩梅に": "لِحُسْن اَلْحَظّ",
 "良い夢を": "لَيْلَة سَعِيدَة وَأَحْلَام لَذِيذَة (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار)",
 "良い天気": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "良い時間": "مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "良い気": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "良い目": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "良い話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "良い頃": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "良い顔": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "良からぬ": "سَيِّئ, وحش",
 "良かれ悪しかれ": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "良かろう": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "良き": "خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / خَيْر, صَلَاح ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض)\nمثال: يبدو زيري بخير. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "良きにつけ悪しきにつけ": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "良きにはからえ": "تَوَخَّى اَلْحِذْر",
 "良きに計らえ": "تَوَخَّى اَلْحِذْر",
 "良き手本": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "良く": "بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / شُكْرًا, تِسْلَم / لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَا أَعْرِف (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَسْتُ أَدْرِي / لَا أَدْرِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "良くある質問": "أَسِئْلَة مُكَرَّرَة",
 "良くする": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "良くできました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "良くないね": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "良くなる": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "良くも悪くも": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "良く出来ました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "良く焼き": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "良く考えたら": "فِعْلًا",
 "良さ": "جَدَارَة",
 "良し": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "良しとする": "قِيمَة",
 "良しなに": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "良し悪し": "نَوْعِيَّة, جَوْدَة",
 "良人": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / إنسان طيب, فاعل خير (شخص يعامل الآخرين بإحسان)",
 "良化": "تَحْسِين",
 "良好": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "良川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "良心": "ضَمِير (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر) / طَوِيَّة / وِجْدَان\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "良心の囚人": "سَجِين الرَأْي",
 "良心的": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / حي الضمير, متفانٍ (يسترشد بالضمير أو بما يتوافق معه أو مع الشعور بالصواب والخطأ)\nمثال: قرار نابع من الضمير بالتحدث علناً عن الظلم",
 "良心的兵役拒否者": "مستنكف ضميرياً (من يرفض الخدمة في القوات المسلحة لأسباب تتعلق بالضمير)",
 "良性": "كَرِيم, لَطِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "良性腫瘍": "ورم حميد (ورم غير سرطاني)",
 "良書": "الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "良民": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "良知": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ)",
 "良能": "قدرة طبيعية, قدرة فطرية (القدرة الموروثة)",
 "良識": "بديهة, حس سليم (حكم عملي سليم)\nمثال: الحس السليم ليس شائعًا جدًا",
 "良識ある": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "良質": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "良馬場": "مسار سريع (وسيلة سريعة لتحقيق هدف)\nمثال: رأوا الاستقلال كمسار سريع للديمقراطية",
 "艱苦": "مَشَقَّة, شِدَّة",
 "艱難": "مَشَقَّة, شِدَّة",
 "艱難苦労": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "艱難辛苦": "مَشَقَّة, شِدَّة",
 "色": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون / بَشْرَة / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟ / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء / مَيْل, نَزَعَة",
 "色々": "مُخْتَلِف, مُتَنَوَّع / بشكل متنوع, بشكل مختلف (بطرق متنوعة)\nمثال: البدائل التي يتم تمثيلها بشكل مختلف من قبل المشاركين",
 "色あせる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "色ごと": "عَلَاقَة غَرَامِيَّة",
 "色っぽい": "عِشْقِيّ, غَرَامِيّ / عَاشِق",
 "色つき": "مُلَوَّن",
 "色つや": "بَشْرَة",
 "色づく": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "色とび": "بَاهِت, مَغْسُول (فاقد اللون بسبب التعرّض للضوء أو الغسيل المتكرّر) / مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)",
 "色とりどり": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / مُتَنَوِّع",
 "色どり": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "色ぬり": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "色み": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "色めく": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "色よい": "مُفِيد, مُوَاتٍ (يمنح ميزة) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / مؤاتٍ, مساعد ((عن الرياح أو الطقس) تميل إلى التعزيز أو التسهيل) / إيجابي, مؤيد (مشجع أو موافق أو مبهج)\nمثال: عقد مفيد لبلدنا",
 "色を塗る": "تلطيخ, رسم رديء (لوحة غير متقنة) / بقعة, تلطخ (عيب ناتج عن الأوساخ) / طيانة, ملاط طيني (مادة تستخدم لطلاء الجدران بالطين)\nمثال: كانت هناك لطخة على خده",
 "色んな": "مُخْتَلِف, مُتَنَوَّع",
 "色事": "عَلَاقَة غَرَامِيَّة",
 "色事師": "زير نساء, كازانوفا (أي رجل مشهور بمغامراته العاطفية)",
 "色付き": "مُلَوَّن",
 "色付く": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "色付け": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "色付ける": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "色出し": "أَحْزَنَ ((أَحْزَنَ) الْمَكَان: حزن وَيُقَال: أَحْزَن بهم الْمنزل: نبا بهم؛ (أَحْزَنَ) فُلَان: صَار فِي الْحزن)\nمثال: أحزن كثيرا على سامي.",
 "色分け": "تَصْنِيف",
 "色収差": "زيغ لوني (زيغ بصري تكون فيه للصورة حواف ملونة)",
 "色取り": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "色合": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / نكهة ((فيزياء) الأنواع الستة للكواركات) / روح, شعور (الجو العام لمكان أو موقف وتأثيره على الناس)\nمثال: أثاره شعور المدينة",
 "色合い": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / نكهة ((فيزياء) الأنواع الستة للكواركات) / روح, شعور (الجو العام لمكان أو موقف وتأثيره على الناس)\nمثال: أثاره شعور المدينة",
 "色図鑑": "كِتَاب مَرْجِعِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "色塗り": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "色変り": "تبدل اللون, تغير اللون (فعل تغيير اللون الطبيعي لشيء ما بجعله باهتاً أو قذراً أو غير طبيعي أو شاحباً) / بقعة, تلون (مظهر متسخ أو متغير اللون)\nمثال: ترك النبيذ بقعة داكنة / مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "色変わり": "تبدل اللون, تغير اللون (فعل تغيير اللون الطبيعي لشيء ما بجعله باهتاً أو قذراً أو غير طبيعي أو شاحباً) / بقعة, تلون (مظهر متسخ أو متغير اللون)\nمثال: ترك النبيذ بقعة داكنة / مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "色女": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / سُرِّيَة",
 "色好い": "مُفِيد, مُوَاتٍ (يمنح ميزة) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / مؤاتٍ, مساعد ((عن الرياح أو الطقس) تميل إلى التعزيز أو التسهيل) / إيجابي, مؤيد (مشجع أو موافق أو مبهج)\nمثال: عقد مفيد لبلدنا",
 "色好み": "شَهْوَانِيَّة",
 "色度": "لَوْنِيَّة",
 "色度測定": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "色彩": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "色彩設計": "مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي",
 "色彩豊か": "زَاهِي الأَلْوَان, مُلَوَّن (لديه لون أو لون معين؛ تستخدم أحياناً في التركيب) / زَاهِي الأَلْوَان, مُلَوَّن (لديه الكثير من الألوان أو ألوان متنوعة) / حَيَوِيّ, مُثِير (لافت للنظر في التنوع والاهتمام)\nمثال: ورق كريب ملون",
 "色恋": "عَلَاقَة غَرَامِيَّة",
 "色恋沙汰": "عَلَاقَة غَرَامِيَّة",
 "色情": "شَهْوَة",
 "色情倒錯": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "色情狂": "سعار جنسي, نيمفومانيا (رغبة جنسية شديدة بشكل غير طبيعي لدى النساء)",
 "色染め": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "色欲": "شَهْوَة",
 "色気": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / اِنْجِذَاب جِنْسِيّ, جَاذِبِيَّة جِنْسِيَّة / جنس, غريزة جنسية (مجموع المشاعر الناتجة عن الرغبة في إشباع الدوافع الجنسية)\nمثال: أراد حياة جنسية أفضل / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "色消し": "انعدام اللون, لا لونية (الخاصية البصرية لكون الشيء بدون لون لوني)",
 "色濃い": "مَوْسُوم, مُسْتَهْدَف (مُمَيَّزٌ لِلْمُلَاحَظَةِ وَخَاصَّةً لِمَصِيرٍ وَخِيمٍ) / صَرِيح, وَاضِح (بارز بقوّة؛ سهل الملاحظة) / موسوم, مُعلَّم (لديه أو يبدو وكأن لديه علامة تعريف أو علامة كما هو محدد؛ غالباً ما تستخدم في التركيبات)\nمثال: لعب بأوراق معلمة (مغشوشة)",
 "色焼け": "بُرُونْزِيّ, مُسَمَّر ((للبشرة) ذو لون سُمرة من التعرض للشمس)",
 "色物": "عرض منوعات (عرض يتكون من سلسلة من العروض القصيرة غير المترابطة)",
 "色玉": "رُمَّان",
 "色男": "عَاشِق, عَاشِقَة / مُغْرَم",
 "色町": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "色画用紙": "ورق أعمال يدوية, ورق مقوى ملون (ورق مناسب للرسم وعمل القصاصات الفنية)",
 "色目": "نظرة خبيثة, نظرة شهوانية (نظرة أو ابتسامة موحية أو ساخرة) / تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق)\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "色目を使う": "نظرة خبيثة, نظرة شهوانية (نظرة أو ابتسامة موحية أو ساخرة) / تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "色盲": "عمى الألوان",
 "色相": "تدرج لوني, صبغة (نوع اللون كما يتحدد بطوله الموجي السائد)",
 "色相環": "دائرة الألوان, عجلة الألوان (مخطط يتم فيه ترتيب الألوان المكملة (أو أسمائها) على جوانب متقابلة من دائرة)",
 "色眼鏡": "نَظَّارَة شَمْسِيَّة, نَظَّارَة شَمْس",
 "色石": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "色素": "دهان, طلاء (مادة تستخدم كطلاء لحماية أو تزيين سطح (خاصة خليط من صبغة معلقة في سائل)؛ تجف لتشكل طبقة صلبة) / خضاب, صبغة (مادة تلوين جافة (خاصة مسحوق يخلط مع سائل لإنتاج الطلاء، إلخ)) / خضاب, صبغة (أي مادة ينتج عن وجودها في الأنسجة النباتية أو الحيوانية لون مميز)",
 "色素性乾皮症": "جفاف الجلد المصطبغ (حالة وراثية نادرة تتميز بطفح جلدي على الجلد المكشوف يحدث في مرحلة الطفولة وحساسية للضوء مع حروق شمس شديدة؛ يورث كصفة جسدية متنحية تكون فيها عمليات…)",
 "色素欠乏症": "مهق, نقص الصباغ (غياب التصبغ الطبيعي خاصة في الجلد أو خلايا الدم الحمراء)",
 "色素沈着": "تصبغ (تلوين الأنسجة الحية بواسطة صبغة) / تصبغ (ترسب الصبغة في الحيوانات أو النباتات أو البشر)",
 "色素脱失": "زوال الصباغ, نقص التصبغ (غياب أو فقدان التصبغ (أو تصبغ أقل من الطبيعي) في الجلد أو الشعر)",
 "色絵": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "色良い": "مُفِيد, مُوَاتٍ (يمنح ميزة) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / مؤاتٍ, مساعد ((عن الرياح أو الطقس) تميل إلى التعزيز أو التسهيل) / إيجابي, مؤيد (مشجع أو موافق أو مبهج)\nمثال: عقد مفيد لبلدنا",
 "色色": "مُخْتَلِف, مُتَنَوَّع / بشكل متنوع, بشكل مختلف (بطرق متنوعة)\nمثال: البدائل التي يتم تمثيلها بشكل مختلف من قبل المشاركين",
 "色艶": "بَشْرَة",
 "色街": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "色褪せる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "色見本": "مخطط الألوان (مخطط يعرض الألوان)",
 "色覚異常": "عمى الألوان (عجز وراثي عن تمييز الاختلافات في درجات الألوان)",
 "色里": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "色飛び": "بَاهِت, مَغْسُول (فاقد اللون بسبب التعرّض للضوء أو الغسيل المتكرّر) / مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)",
 "色香": "حسن, ملاحة (صفة كون الشخص حسن المظهر وجذاباً)",
 "色鬼": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة)",
 "色魔": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة)",
 "色鮮やか": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "色黒": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها)",
 "艶": "بَرِيق / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام / فَائِدَة / رُومَانْسِيَّة / سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "艶々": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "艶々しい": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "艶かしい": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "艶っぽい": "رُومَانْسِيّ",
 "艶めかしい": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "艶めく": "لَمَعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "艶やか": "سَاحِر, فَاتِن (يتمتع بجاذبية ورومانسية وإثارة) / بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "艶事": "عَلَاقَة غَرَامِيَّة",
 "艶出し": "رَزَّزَ ((رَزَّزَه): ثَبَّتَه؛ (رَزَّزَه) وطأه ومهده يُقَال: رززت أَمرك عِنْد فلَان ورززت لَك الْأَمر)",
 "艶文": "رِسَالَةُ حُبٍّ",
 "艶書": "رِسَالَةُ حُبٍّ",
 "艶歌": "تْرُوبَادُور",
 "艶消し": "مَصْنَفَر, مُجَمَّد (ذو سطح خشن يشبه الصقيع؛ يُقال عن الزجاج) / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "艶然": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان) / كَيِّس, لَطِيف (يُظهر الكياسة واللطف في التعامل) / دمث, كريم النفس (يتميز بالسحر والذوق الرفيع وكرم الروح) / رَؤُوف, كَرِيم (يتسم بالطيبة والمجاملة الدافئة خاصة من ملك تجاه رعاياه)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "艶物": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "艶福家": "زير نساء, مغوٍ (رجل يستغل النساء)",
 "艶種": "عَلَاقَة غَرَامِيَّة",
 "艶美": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية) / ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "艶艶": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "艶艶しい": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "艶言": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "艶麗": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "艷やか": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "艷冶": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "艾": "حبق الراعي, شيح (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس)",
 "艾髪": "عجوز, كبير السن (شخص متقدم في السن)",
 "芋": "درنة (ساق أو جذر تحت أرضي لحمي يخدم في التكاثر وتخزين الغذاء) / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة) / خَامِل, فَاشِل (لا يَنْفَجِر؛ غَيْر مَشْحون بِمادَّة مُتَفَجِّرَة فَعَّالَة) / عمل فاشل, قنبلة (حدث يفشل بشدة أو يكون غير فعال تماماً) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث) / فاشِل, مُخْفِق (شخص غير ناجح)\nمثال: كانت التجربة الأولى عملاً فاشلاً حقاً",
 "芋あん": "بَطَاطَا حُلْوَة",
 "芋くさい": "رِيفِيُّ الطَّابِع (يتّسم بسمات الحياة الريفيّة)",
 "芋っぽい": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "芋づる式": "وَاحِدًا تِلْوَ الآخَرِ",
 "芋づる接続": "سلسلة الإقحوان (سلسلة زهور تتكون من خيط من زهور الإقحوان مرتبطة بسيقانها؛ يرتديها الطلاب في يوم التخرج في بعض المدارس) / سلسلة متصلة ((مجازياً) سلسلة من الأشياء أو الأشخاص أو التجارب المرتبطة)",
 "芋の子を洗うよう": "حَاشِد, مُكْتَظّ (مليء بالكائنات الحيّة خاصّة)",
 "芋ほり": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "芋る": "مُخَيِّم",
 "芋を洗うよう": "حَاشِد, مُكْتَظّ (مليء بالكائنات الحيّة خاصّة)",
 "芋助": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ) / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "芋掘り": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "芋焼酎": "بَطَاطَا حُلْوَة",
 "芋臭い": "رِيفِيُّ الطَّابِع (يتّسم بسمات الحياة الريفيّة)",
 "芋蔓接続": "سلسلة الإقحوان (سلسلة زهور تتكون من خيط من زهور الإقحوان مرتبطة بسيقانها؛ يرتديها الطلاب في يوم التخرج في بعض المدارس) / سلسلة متصلة ((مجازياً) سلسلة من الأشياء أو الأشخاص أو التجارب المرتبطة)",
 "芋虫": "يَرَقَة, دُودَة الْفَرَاشَة",
 "芋頭": "أحدوبة, حديبة (نتوء على عظم خاصة لربط عضلة أو رباط) / درينة, عقيدة (نتوء صغير مستدير يشبه الثالول على النبات) / درنة (تورم يعتبر الآفة المميزة لمرض السل)",
 "芋餡": "بَطَاطَا حُلْوَة",
 "芒": "سفا (نتوء يشبه الشعيرة بالقرب من طرف هوائي (قرن استشعار) بعض الذباب)",
 "芒洋": "شَاسِع, وَاسِع",
 "芒硝": "كبريتات الصوديوم (ملح أبيض مر صلب يستخدم في تصنيع الزجاج والورق والأصباغ والمستحضرات الصيدلانية)",
 "芒硝泉": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "芙蓉": "عشبة القطن, فيلاغو (أي نبات من جنس فيلاغو له عناقيد رأسية من رؤوس زهور صوفية صغيرة) / ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة)",
 "芙蓉峰": "جَبَل فُوجِي, فُوجِي (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "芝": "غَضْراء, مَرْجة",
 "芝刈り器": "جُزَازَة عُشْب",
 "芝刈り機": "جُزَازَة عُشْب",
 "芝刈機": "جُزَازَة عُشْب",
 "芝居": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "芝居っ気": "بطولات زائفة, سلوك درامي مبالغ (سلوك تفاخري أو استعراضي أو مبالغ فيه أو ميلودرامي)\nمثال: البطولات الزائفة هي لتلك الأفلام الملحمية التي يصنعونها في هوليوود",
 "芝居好き": "مرتاد المسرح (شخص يحضر المسرح)",
 "芝居小屋": "بيت اللعب (لعبة تتكون من نموذج صغير لمنزل يمكن للأطفال اللعب بداخله)",
 "芝居気": "مسرحي (مناسب لـ أو من خصائص خشبة المسرح أو المسرح) / مسرحي (متعلق بالمسرح أو فنونه) / تمثيل, عرض مسرحي (أداء لمسرحية)\nمثال: وضعية مسرحية",
 "芝居者": "مُمَثِّل, مُمَثِّلَة",
 "芝崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芝桜": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "芝生": "غَضْراء, مَرْجة",
 "芝生茸": "حلقة الجنيات (حلقة من الفطريات تحدد محيط النمو الجوفي المعمر للميسيليوم)",
 "芝目": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "芝草": "غَضْراء, مَرْجة",
 "芝蘭": "موهوب (وهبه الله موهبة أو مواهب)\nمثال: كاتب موهوب",
 "芝麻醤": "طَحِينَة",
 "芥": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات / تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها)",
 "芥子": "خَشْخَاش الْأَفْيُون",
 "芥子の実": "خشخاش بَذْرَة",
 "芥子油": "زيت الخردل (زيت يُستخرج من بذور الخردل ويُستخدم في صنع الصابون)",
 "芥子泥": "لبخة الخردل (لبخة تحتوي على مسحوق الخردل الأسود؛ توضع على الجلد كمهيج مضاد أو محمر للجلد)",
 "芥子粒": "خشخاش بَذْرَة",
 "芥子色": "خَرْدَل",
 "芥子菜": "أوراق الخردل, خردل (أوراق تؤكل مطبوخة) / خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "芥川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芥田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芥菜": "أوراق الخردل, خردل (أوراق تؤكل مطبوخة) / خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "芥虫": "خنفساء أرضية (خنفساء أرضية مفترسة سوداء لامعة أو معدنية اللون تقضي على العديد من الحشرات الضارة)",
 "芦": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "芦原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芦岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芦毛": "رمادي مرقط (رمادي بنمط مرقط من علامات رمادية أغمق)",
 "芦田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芦笛": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "芦荻": "قَصَبَة, بُوصَة",
 "芫菁": "خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "芬": "فِنْلَنْدَا, فِنْلَنْدَة / رَيًّا, عَبِق",
 "芬々": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "芬芬": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "芭蕉": "موز ياباني (نبات موز آسيوي يزرع خاصة كنبات ورقي في اليابان)",
 "芯": "فَتِيل, فَتِيلَة / نِوَاة / مِدَقَّة / سَدَاة",
 "芯が強い": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "芯ケース": "رصاص القلم, سن قلم الرصاص (خليط من الجرافيت مع الطين بدرجات صلابة مختلفة؛ مادة التحديد في قلم الرصاص)",
 "芯出し": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "芯切り": "قمع الإطفاء, مطفأة الشموع (أداة مخروطية الشكل ذات مقبض؛ تستخدم لإطفاء الشموع) / مستنشق السعوط (شخص يتعاطى السعوط (النشوق)) / مُطْفِئ الشُّمُوع (شخص يطفئ الشموع)",
 "芯地": "تَبْطِين",
 "芯線": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "花": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير / زَهْرَة كَرَز / جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / إزهار, تفتح (العملية العضوية لحمل الزهور)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "花々": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير / جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "花が咲く": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "花き": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "花き園芸": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花き栽培": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花こう岩": "صَوَّان, غْرَانِيت",
 "花ざかり": "فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول",
 "花しょうぶ": "سوسن دموي",
 "花たく": "حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "花つき": "مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / ازدهار, تفتح (عملية تنموية)\nمثال: نبات مزهر",
 "花つくり": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花づくり": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花づな": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "花の下紐": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "花の宴": "زَهْرَة كَرَز",
 "花の木": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "花の都": "عَاصِمَة (اسم فاعل؛ مؤنث عَاصِم؛ اسم؛ المَدِينَة الكبيرة) / حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)",
 "花びら": "بَتَلَة, تُوَيْجَة",
 "花を咲かせる": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "花を添える": "غريس",
 "花キャベツ": "قَرْنَبِيط, قُنَّبِيط",
 "花井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花付き": "مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / ازدهار, تفتح (عملية تنموية)\nمثال: نبات مزهر",
 "花作り": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花入": "زَهْرِيَّة",
 "花入れ": "زَهْرِيَّة",
 "花冠": "تُوَيْج, تاج / إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "花卉": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "花卉園芸": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花卉栽培": "زراعة الزهور (زراعة النباتات المزهرة)",
 "花占い": "عَرَافَة",
 "花咲く": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "花唇": "بَتَلَة, تُوَيْجَة",
 "花圃": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "花園": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "花壇": "حوض زهور (حوض تنمو فيه الزهور)",
 "花売り娘": "فتاة الزهور (فتاة صغيرة تحمل الزهور في موكب (الزفاف)) / بائعة الزهور (امرأة تبيع الزهور في الشارع)",
 "花大根": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "花婿": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد)",
 "花嫁": "عَرُوس",
 "花嫁介添人": "وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف)",
 "花嫁学校": "مدرسة إتيكيت (مدرسة خاصة للفتيات تركز على التدريب في الأنشطة الثقافية والاجتماعية)",
 "花嫁御寮": "عَرُوس",
 "花嫁衣装": "فستان زفاف (ثوب ترتديه العروس في حفل الزفاف)",
 "花嫁衣裳": "فستان زفاف (ثوب ترتديه العروس في حفل الزفاف)",
 "花実": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花客": "زَهْرَة كَرَز",
 "花屋": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة) / بائع زهور, منسق زهور (شخص يزرع الزهور ويتاجر بها)\nمثال: صنع بائع الزهور باقة جذابة",
 "花岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花岩": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花崗岩": "صَوَّان, غْرَانِيت",
 "花巨頭": "دلفين ريسو (دلفين رمادي أردوازي غير حاد الأنف شائع في البحار الشمالية) / أوركا, حوت قاتل (حوت مسنن مفترس أسود وأبيض ذو زعنفة ظهرية كبيرة؛ شائع في البحار الباردة)",
 "花布": "طَوْق شَعَر (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "花床": "حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "花序": "إزهار, نورة (الجزء المزهر من النبات أو ترتيب الزهور على الساق) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "花弁": "بَتَلَة, تُوَيْجَة",
 "花形": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق / إِجَّامَة / نَجْمَة",
 "花房": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "花托": "حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "花文字": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "花木": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "花札屋": "نينتندو",
 "花村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花束": "شَذًى, شَذًا",
 "花柄": "سُوَيْق, سُوَيْقَة",
 "花柱": "أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "花柳": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "花柳界": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "花柳病": "دَاء مَنْقُول جِنْسِيًّا",
 "花柳街": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "花桃": "زَهْرَة خَوْخ",
 "花梗": "شمراخ (ساق زهرة منتصبة بلا أوراق تنمو مباشرة من الأرض كما في الزنبق)",
 "花梨": "بادوك بورما, خشب الورد البورمي (شجرة من الهند وبورما تنتج خشباً يشبه الماهوجني) / سفرجل مزهر, سفرجل ياباني (شجيرة زينة آسيوية ذات فروع شائكة وأزهار وردية أو حمراء) / سَفَرْجَل",
 "花椒": "فَاغِرَة",
 "花椰菜": "قَرْنَبِيط, قُنَّبِيط",
 "花樹": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "花水": "رَحِيق",
 "花江": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花活け": "زَهْرِيَّة",
 "花海棠": "تفاح بري جنوبي (شجرة صغيرة أو شجيرة من جنوب شرق الولايات المتحدة؛ تزرع للزينة لأزهارها الوردية اللون) / تفاح بيكتل البري (مشتق من تفاح آيوا البري ويزرع لأزهاره الوردية المزدوجة الكبيرة)",
 "花火": "مُفَرْقِعَات, أَلْعَاب نَارِيَّة\nمثال: すごい花火だ！ — هذه الألعاب النارية رائعة!",
 "花火日和": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر",
 "花火線香": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر) / ألماس (قطع الألماس (مصطلح عامي))\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "花燭": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "花片": "بَتَلَة, تُوَيْجَة",
 "花物": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "花独活": "جزر البقر, هرقلية (نبات خشن طويل له سيقان سميكة وعنقود من الزهور البيضاء إلى الأرجوانية)",
 "花環": "إِكْلِيل",
 "花瓣": "بَتَلَة, تُوَيْجَة",
 "花瓶": "زَهْرِيَّة",
 "花生け": "زَهْرِيَّة",
 "花田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花町": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "花畑": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "花盛り": "فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول",
 "花穂": "سنبلة",
 "花立て": "زَهْرِيَّة",
 "花粉": "حُبُوبُ اللِّقَاح, حُبُوبُ الطَّلْع",
 "花粉症": "حمى القش (التهاب أنف موسمي ناتج عن رد فعل تحسسي لحبوب اللقاح)",
 "花粉管": "أنبوب اللقاح ((علم النبات) نمو أنبوبي رفيع من حبة اللقاح عند ترسيبها على ميسم الزهرة؛ يخترق القلم وينقل الأمشاج الذكرية إلى البويضة)",
 "花粉管核": "أنبوب اللقاح ((علم النبات) نمو أنبوبي رفيع من حبة اللقاح عند ترسيبها على ميسم الزهرة؛ يخترق القلم وينقل الأمشاج الذكرية إلى البويضة)",
 "花糸": "فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "花紋板": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "花紙": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "花結び": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "花綱": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "花綵": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "花緑青": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر) / أخضر باريس (ملح مزدوج سام من زرنيخات النحاس وخلات النحاس)",
 "花美": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا / بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية",
 "花色": "سَمَاوِيّ, لَبَنِيّ",
 "花芽": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "花芽形成": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "花苔": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "花茎": "سُوَيْقَة جِذْرِيَّة",
 "花草": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "花菖蒲": "سوسن دموي",
 "花菱草": "إيشولتسية, خشخاش كاليفورنيا (من ساحل المحيط الهادئ لأمريكا الشمالية؛ يزرع على نطاق واسع لزهوره الصفراء إلى الحمراء)",
 "花葉": "ورقة زهرية (ورقة معدلة تكون جزءاً من الزهرة)",
 "花葵": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "花蓋": "غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "花蕾": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "花薄荷": "مَرْدَقُوش, مَرْدَقُوش بَرِّيّ",
 "花虎の尾": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "花虎魚": "سمكة السرجس (أسماك صغيرة ذات أشكال وألوان عجيبة توجد بين كتل طحالب السرجس)",
 "花虻": "ذُبَاب حَوَّام, ذُبَاب الزُّهُور",
 "花蜂": "نَحْلَة / نَحْل / نحل / نحلة / بِي",
 "花蜜": "رَحِيق",
 "花街": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "花被": "غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية والمدقات)",
 "花被片": "تيبالة (جزء غير متمايز من الغلاف الزهري لا يمكن تمييزه كسبلة أو بتلة (كما في الزنابق والتوليب))",
 "花見": "زَهْرَة كَرَز",
 "花見の宴": "زَهْرَة كَرَز",
 "花言": "صِينِيّ",
 "花豆": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "花豌豆": "بَازِلَّاء الزُهُور",
 "花車": "أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل) / هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "花軸": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي) / محور (محور ورقة مركبة أو نورة مركبة)\nمثال: تسبب السقوط في كسر ظهره",
 "花輪": "إِكْلِيل",
 "花道": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "花野菜": "قَرْنَبِيط, قُنَّبِيط",
 "花金": "الْجُمُعَة, الجُمْعَة",
 "花鑢": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "花開く": "زَهْرَة / زَهَرَ ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: أرى زهرة على المكتب. / زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "花頭窓": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "花魁": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "花鶏": "شرشور جبلي, عصفور زغاري",
 "芳しい": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ) / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "芳しくない": "فَقِير / مِسْكِين / فُقَرَاء",
 "芳ばしい": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ) / أروماتي, عطري ((كيمياء) من أو متعلق بـ أو يحتوي على حلقة بنزين واحدة أو أكثر)\nمثال: مركب عضوي عطري",
 "芳信": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "芳名": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)",
 "芳川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芳志": "إِحْسَان",
 "芳恩": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "芳春": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "芳烈": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ) / أروماتي, عطري ((كيمياء) من أو متعلق بـ أو يحتوي على حلقة بنزين واحدة أو أكثر)\nمثال: مركب عضوي عطري",
 "芳詠": "قَصِيدَة, شِعْر",
 "芳賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芳醇": "برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "芳韻": "قَصِيدَة, شِعْر",
 "芳香": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض.",
 "芳香剤": "أَرِيج, عَبِير",
 "芳香族": "مركب عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات)",
 "芳香族化合物": "مركب عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات)",
 "芳香族性": "عطرية (خاصية امتلاك أريج)",
 "芳香族炭化水素": "هيدروكربون عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات العضوية)",
 "芳香油": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "芳香療法": "علاج بالروائح (الاستخدام العلاجي للمستخلصات النباتية العطرية والزيوت الأساسية في الحمامات أو التدليك)",
 "芸": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "芸がない": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
 "芸が無い": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
 "芸なし": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ)",
 "芸なし猿": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "芸のない": "عادي, غير ملهم (محبط للروح أو لا يبعث على الإلهام)\nمثال: فيلا ذات تصميم غير ملهم",
 "芸事": "تَنْفِيذ",
 "芸人": "كُومِيدْيَان / عَازِف",
 "芸名": "اسم فني (الاسم المستعار لممثل)",
 "芸妓": "غَيْشَا",
 "芸子": "غَيْشَا",
 "芸当": "أَدَاء / مَسْرَحِيَّة",
 "芸無し": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ)",
 "芸無し猿": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "芸者": "غَيْشَا",
 "芸能": "فنون أدائية (فنون أو مهارات تتطلب أداءً عاماً) / تَنْفِيذ",
 "芸能リポーター": "كاتب عمود القيل والقال (صحفي يكتب عموداً من القيل والقال عن المشاهير)",
 "芸能レポーター": "كاتب عمود القيل والقال (صحفي يكتب عموداً من القيل والقال عن المشاهير)",
 "芸能人": "فنان ترفيهي, مُؤنِس (شخص يحاول إمتاع الناس أو تسليتهم)",
 "芸能界": "صناعة الترفيه (المشاركون في توفير الترفيه: الراديو والتلفزيون والأفلام والمسرح)",
 "芸能者": "عَازِف",
 "芸能記者": "كاتب عمود القيل والقال (صحفي يكتب عموداً من القيل والقال عن المشاهير)",
 "芸術": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "芸術作品": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "芸術品": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "芸術家": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "芸術性": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة",
 "芸術的": "ذَوَّاقِيّ, فَنِّيّ (يُلبّي المعايير والحساسيات الجمالية) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / فني (يتعلق بالفن أو الفنانين أو يميزهم)\nمثال: خلفيته الفنية",
 "芸談": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "芸道": "فنون أدائية (فنون أو مهارات تتطلب أداءً عاماً)",
 "芹沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芹澤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "芹菜": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة)",
 "芽": "نَبْتَة",
 "芽がでる": "بُرْعُم",
 "芽が出る": "بُرْعُم",
 "芽ぐむ": "بُرْعُم",
 "芽ばえる": "بُرْعُم / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "芽をふく": "بُرْعُم",
 "芽を出す": "نَبْتَة",
 "芽を吹く": "بُرْعُم",
 "芽キャベツ": "كُرُنْب بْرُوكْسِل",
 "芽体": "مأرمة, نسيج أولي (كتلة من الخلايا غير المتمايزة يتطور منها عضو أو جزء من الجسم)",
 "芽出し": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "芽吹き": "بُرْعُم",
 "芽吹く": "بُرْعُم / طَوَّرَ",
 "芽子": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة) / أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "芽球": "برعمية (العنصر المادي المنفصل الذي اقترحه داروين كمسؤول عن الوراثة) / ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "芽生": "تبرعم (تكاثر لاجنسي يصبح فيه نمو محلي على سطح أو في جسم الأصل فرداً منفصلاً)",
 "芽生え": "بُرْعُم",
 "芽生える": "بُرْعُم / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "芽立ち": "بُرْعُم",
 "芽細胞腫": "ورم أرومي (ورم يتكون من خلايا غير ناضجة غير متمايزة)",
 "芽胞": "بوغ (جسم تكاثري لاجنسي صغير عادة ما يكون وحيد الخلية تنتجه العديد من النباتات غير الزهرية والفطريات وبعض البكتيريا والأوالي، وهو قادر على التطور إلى فرد…)\nمثال: يتكون البوغ الجنسي بعد اندماج الأمشاج / بوغ داخلي (بوغ لاجنسي صغير ينمو داخل خلية بعض البكتيريا والطحالب)",
 "苑": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان. / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان. / رَوْضَة, رَوْضَة أَطْفَال",
 "苑地": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / وَقَّفَ, صَفَّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: ليس لدينا حديقة.",
 "苑田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "苔": "أُشْنَة, طُحْلُب",
 "苔桃": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر) / توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "苔植物": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "苔状": "رَجْعِيّ, مُتَحَجِّر ((ازدرائيًّا) قَدِيم الطِّرَاز وَمُتَخَلِّف عَنِ العَصْر) / مُطَحْلَب (مُكتسٍ بالطحلب بشكل مفرط)",
 "苔瑪瑙": "عقيق طحلبي (عقيق يشبه الطحالب بعلامات بنية أو سوداء أو خضراء)",
 "苔癬": "أُشْنَة, حَزَاز",
 "苔虫": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "苔虫類": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "苔類": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه) / حشيشة الكبد (أي من النباتات اللاوعائية الخضراء الصغيرة العديدة من طائفة الكبدية تنمو في الأماكن الرطبة وتشبه الأعشاب البحرية الخضراء أو الحزازيات الورقية)",
 "苗": "شَتْلَة / لغة المياو, لغة الهمونغ (لغة ذات انتماء غير مؤكد يتحدث بها شعب الهمونغ) / مياو, همونغ (شعب يعيش تقليدياً في القرى الجبلية في جنوب الصين والمناطق المجاورة في فيتنام ولاوس وتايلاند؛ هاجر الكثير منهم إلى الولايات المتحدة)",
 "苗圃": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "苗売り人": "بستاني (رجل يعتني بحديقة)",
 "苗字": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "苗床": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "苗族": "لغة المياو, لغة الهمونغ (لغة ذات انتماء غير مؤكد يتحدث بها شعب الهمونغ) / مياو, همونغ (شعب يعيش تقليدياً في القرى الجبلية في جنوب الصين والمناطق المجاورة في فيتنام ولاوس وتايلاند؛ هاجر الكثير منهم إلى الولايات المتحدة)",
 "苗木": "شَتْلَة",
 "苗条": "صَوَّبَ (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر) / صَوَّبَ, أَطْلَقَ النَّار (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "苗裔": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "苗語": "هْمُونْغ",
 "苗頭": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحراف (حركة مؤشر أو قلم أداة قياس من موضع الصفر الخاص به) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "苛々": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "苛ち": "مُسْتَعْجِل",
 "苛む": "عَذَاب / عَذَّبَ",
 "苛め": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا) / تَنَمُّر (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)\nمثال: الإنفصاليون مثل الإرهاب.",
 "苛めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "苛めっ子": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "苛める": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "苛性": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / مادة كاوية (أي مادة كيميائية تحرق أو تدمر الأنسجة الحية) / محرقة, منحنى كاوٍ (غلاف أشعة الضوء المنعكسة أو المنكسرة بواسطة سطح منحني)",
 "苛性アルカリ": "غسول, محلول قلوي (محلول قوي من هيدروكسيد الصوديوم أو البوتاسيوم)",
 "苛性カリ": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "苛性ソーダ": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات الصوديوم المختلفة)",
 "苛性加里": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "苛政": "طُغْيَان, اِسْتِبْدَاد",
 "苛烈": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "苛立たしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "苛立たしげ": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "苛立たし気": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "苛立ち": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب)\nمثال: اشتعل غضبه كالحطب الجاف",
 "苛苛": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "苛酷": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "苜蓿": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "苞": "قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها) / تَذْكار",
 "苞苴": "تَذْكار",
 "苞葉": "قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها)",
 "苟も": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "苟且": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "苣木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若": "شَبَاب / شَبَاب, صِبًا / شَابّ / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / صَغِير, حَدَث",
 "若々しい": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "若々しさ": "شباب, فتوة (النضارة والحيوية المميزة للشاب)",
 "若い": "صَغِير, حَدَث / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة / حَزين / خافِت, مُنْخَفِض",
 "若いときの苦労は買うてもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "若いときの苦労は買ってもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "若いもん": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若い子": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若い時の苦労は買うてもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "若い時の苦労は買ってもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "若い者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若い衆": "شاب (مراهق أو شاب بالغ ذكر)",
 "若き": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / صَغِير, حَدَث",
 "若き日": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "若く": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "若さ": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "若し": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "若しくは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "若しや": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "若どり": "طائر صغير, فرخ طائر (طائر لا يزال صغيراً) / دَجَاج, لَحْم دَجَاج",
 "若め": "شَابّ نَوْعًا مَا (صغير السنّ إلى حدّ ما)",
 "若やか": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "若井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若人": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若僧": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "若宮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若干": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "若干名": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "若年": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "若年型": "سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / شبابي, صبياني (متعلق بالأطفال أو الشباب أو مميز لهم أو مناسب لهم) / حدث, قاصر (شخص صغير السن لم يكتمل نموه بعد)\nمثال: سكري الأحداث",
 "若年型糖尿病": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "若年寄": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若年寄り": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若年層": "صَغِير, حَدَث",
 "若年性糖尿病": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "若年性認知症": "خرف ما قبل الشيخوخة, خرف مبكر (خرف يبدأ قبل سن 65)",
 "若年者": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "若年認知症": "خرف ما قبل الشيخوخة, خرف مبكر (خرف يبدأ قبل سن 65)",
 "若手": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若木": "شَتْلَة",
 "若本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若杉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若松": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "若林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若枝": "صَوَّبَ (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر) / صَوَّبَ, أَطْلَقَ النَّار (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "若槻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若気": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "若気る": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "若水": "درجة أولى, ماء أول (أحجار كريمة من أعلى جودة)",
 "若瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若狭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若生": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若田部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若目": "شَابّ نَوْعًا مَا (صغير السنّ إلى حدّ ما)",
 "若竹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若紫": "بَنَفْسَجِيّ",
 "若者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若者文化": "ثقافة الشباب (الشباب (كوحدة جيلية) باعتبارهم طبقة ثقافية أو ثقافة فرعية)",
 "若者言葉": "عَامِّيَّة, دَارِجَة",
 "若芽": "نَبْتَة",
 "若若しい": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "若若しさ": "شباب, فتوة (النضارة والحيوية المميزة للشاب)",
 "若菜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "若蔵": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "若虫": "حورية (يرقة حشرة ذات تحول غير كامل (مثل اليعسوب أو ذبابة مايو)) / حورية ((الأساطير الكلاسيكية) إلهة طبيعة صغيرة تُصور عادة كعذراء جميلة) / حورية (شابة جميلة وممتلئة الجسم)\nمثال: اعتقد الإغريق القدماء أن الحوريات يسكن الغابات والمسطحات المائية",
 "若衆": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若衆道": "اشتهاء الغلمان, لواط بالأطفال (العلاقات الجنسية بين رجل وصبي (عادة الجماع الشرجي مع الصبي كشريك سلبي))",
 "若輩": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "若輩者": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "若返り": "تجديد الشباب (فعل الاستعادة لحالة أكثر شباباً) / استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "若造": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "若道": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "若魚": "سمكة صغيرة (سمكة لا تزال صغيرة)",
 "若鳥": "طائر صغير, فرخ طائر (طائر لا يزال صغيراً) / دَجَاج, لَحْم دَجَاج",
 "若鶏": "طائر صغير, فرخ طائر (طائر لا يزال صغيراً) / دَجَاج, لَحْم دَجَاج",
 "若齢": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "苦": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "苦々しい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "苦あれば楽あり": "مَنْ جَدَّ وَجَدَ وَمَنْ زَرَعَ حَصَدَ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "苦い": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي. / حَامِض",
 "苦さ": "مَرَارَة",
 "苦しい": "أَلِيم, مُؤْلِم\nمثال: 苦しい、やめろ。 — إن ذلك مؤلم ، توقف. / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب) / ضَيِّق / مُتَكَلِّف, مُجْهَد (يناضل من أجل إحداث أثر أو انطباع) / قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي) / مُتَكَلَّف, مُجْهَد (يفتقر إلى السلاسة والطبيعية) / مُتَكَلَّف, مُجْهَد (يُظْهِرُ عَلَامَاتِ التَّوَتُّرِ الذِّهْنِيِّ وَالعَاطِفِيّ)",
 "苦しいときの神頼み": "هُنَاك, يُوجَد",
 "苦しい時の神頼み": "هُنَاك, يُوجَد",
 "苦しがる": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "苦しさ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "苦しみ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "苦しむ": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "苦しめる": "عَذَاب / عَذَّبَ / مِحْنَة",
 "苦しゅうない": "عَفْوًا",
 "苦し紛れ": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "苦っぽい": "لَاذِع, مَائِلٌ لِلمَرَارَة (مُرٌّ بَعْضَ الشَّيْء)",
 "苦にする": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "苦になる": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "苦に病む": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "苦は楽の種": "مَنْ جَدَّ وَجَدَ وَمَنْ زَرَعَ حَصَدَ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "苦み": "مَرَارَة",
 "苦みばしった": "رُجُولِيّ",
 "苦み走った": "رُجُولِيّ",
 "苦もなく": "بِسُهُولَة",
 "苦も無く": "بِسُهُولَة",
