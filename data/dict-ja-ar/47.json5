 "肩文字": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "肩書": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "肩書き": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "肩甲": "رِيشَة كَتِفِيَّة (ريشة تغطي كتف الطائر) / كتفي (متعلق بـ أو بالقرب من لوح الكتف) / وشاح كتف رهباني (رداء يتكون من قطعة طويلة وعريضة من القماش الصوفي تلبس فوق الكتفين مع فتحة للرأس؛ جزء من الزي الرهباني)",
 "肩甲帯": "حزام الكتف, قوس صدرية (القوس العظمي الذي يتكون من الترقوة ولوح الكتف في البشر)",
 "肩甲骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "肩章": "رتبة كتف, علامة الكتف (كَتَّافات تشير إلى الرتبة)",
 "肩紐": "حمالة, شريط الكتف (شريط يمر فوق الكتف ويدعم ملابس أو حقيبة)",
 "肩胛骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "肩身": "كَتِف, كِتْف / شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "肩身が広い": "فَخُور",
 "肩身の狭い": "خَجْلَان, خَجُول",
 "肩透かし": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / خَيْبَة أَمَل",
 "肩透かしをくわせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "肩透かしを食わせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "肩部": "كَتِف, كِتْف",
 "肩関節": "كتف, مفصل الكتف (مفصل كروي بين رأس عظم العضد وتجويف لوح الكتف)",
 "肩骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "肩高": "حارك (أعلى جزء من الظهر عند قاعدة العنق لحيوانات مختلفة خاصة حيوانات الجر)",
 "肯う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد. / صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "肯じる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯ずる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯んじる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯んずる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯定": "تَأْكِيد, تَوْكِيد / إِيحَاء ذَاتِيّ / إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "肯定応答": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "肯定文": "جُمْلَةٌ مُثْبَتَةٌ (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "肯定的": "إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "肯諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肱": "ذِرَاع / سِلَاح / سَلَّحَ / عَضُد (مُعِين؛ قُوَّة)",
 "肱木": "شَرِيحَة",
 "育ち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "育ちがいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちがよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちが悪い": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "育ちが良い": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちのいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちのよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちの良い": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちゆく": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "育ち行く": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "育つ": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "育て": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "育てあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "育ての親": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "育てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / تنشئَة, تَرْبِيَة",
 "育て上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "育て親": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "育む": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "育休": "إجَازَة أُمُومَة",
 "育児": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "育児休暇": "إجَازَة أُمُومَة",
 "育児休業": "إجازة عائلية, إجازة والدية (ميزة للموظفين تتيح إجازة مدفوعة الأجر لرعاية طفل أو ترتيب شؤونه، تشمل إجازة الأمومة والأبوة)",
 "育児嚢": "جراب, جريب (حاوية صغيرة أو متوسطة الحجم لحفظ أو حمل الأشياء) / جيب ((في التشريح) بنية تشبه الكيس في العديد من الحيوانات (مثل الجرابيات أو الغوفر أو البجع)) / جيب, كيس (حيز مغلق)\nمثال: وجد عمال المناجم المحاصرون جيباً من الهواء",
 "育児学": "طب الأطفال (فرع الطب المعني بعلاج الرضع والأطفال)",
 "育児室": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "育児放棄": "إهمال الأطفال (فشل القائمين على الرعاية في توفير الرعاية العاطفية والجسدية الكافية للطفل)",
 "育児施設": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "育児語": "كلام الأطفال (الكلام النامي للطفل الصغير) / محاكاة كلام الأطفال (تقليد شخص بالغ لكلام طفل صغير)",
 "育児院": "دَار الْأَيْتَام, مَيْتَم (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "育成": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَنَمِّر, نَاهِض (واقف على الرِّجل الخلفيَّة اليسرى مع رفع القوائم الأماميَّة والرأس جانبيّاً) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل)",
 "育成牛": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "育林": "زراعة الغابات (فرع علم الغابات الذي يتعامل مع تنمية ورعاية الغابات)",
 "育毛剤": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "育種": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "育種家": "مربي حيوانات, مُرَبٍّ (شخص يقوم بتربية الحيوانات بغرض التكاثر والإنتاج)",
 "育種所": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "育英": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / تَعْلِيم, ثَقَافَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "育英資金": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "育雛": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / استغراق في التفكير, وجوم (تأمل مرضي مستمر في مشكلة ما) / تحضين, حضن (الجلوس على البيض لفقسه بواسطة دفء الجسم)",
 "育雛器": "مربي حيوانات, مُرَبٍّ (شخص يقوم بتربية الحيوانات بغرض التكاثر والإنتاج)",
