 "英語": "إِنْجِلِيزِيّ إِنْكِلِيزِيّ, إنْقِليزي (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ) / إِنْجِلِيزِيّ, إِنْجِلِيزِيَّة (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ)\nمثال: ما أكتبه ليس إنجليزية.",
 "英語人": "نَاطِقٌ بِالإِنْجِلِيزِيَّة (قادر على التواصل باللغة الإنجليزية)",
 "英語劇": "تمثيل, عرض مسرحي (أداء لمسرحية)",
 "英語圏": "نَاطِقٌ بِالإِنْجِلِيزِيَّة (قادر على التواصل باللغة الإنجليزية)",
 "英語基礎能力試験": "اللغة الإنجليزية (لغة هندية أوروبية تنتمي للفرع الجرماني الغربي؛ اللغة الرسمية لبريطانيا والولايات المتحدة ومعظم دول الكومنولث)",
 "英語塾": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "英語学科": "قسم اللغة الإنجليزية (القسم الأكاديمي المسؤول عن تدريس الأدب الإنجليزي والأمريكي)",
 "英語教師": "معلم لغة إنجليزية (شخص يدرس اللغة الإنجليزية)",
 "英議会": "البرلمان البريطاني (الهيئة التشريعية البريطانية)",
 "英貨": "جُنَيْه, جُنَيْه إِسْتَرْلِينِيّ",
 "英連邦": "الكومنولث البريطاني, رابطة الشعوب البريطانية (رابطة دول تتكون من المملكة المتحدة والعديد من المستعمرات البريطانية السابقة التي أصبحت الآن دولاً ذات سيادة لكنها لا تزال تدين بالولاء للتاج البريطاني)",
 "英里": "عُقْدَة",
 "英雄": "بَطَل, بَطَلَة",
 "英雄主義": "بَسَالَة, بُطُولَة",
 "英雄崇拝": "تقديس الأبطال (الإعجاب بالرجال العظماء (أو ذكراهم))",
 "英雄的": "بُطُولِيّ",
 "英雄譚": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "英雄豪傑": "بَطَل, بَطَلَة",
 "英雲岩": "غرايزن (صخر جرانيتي يتكون من الكوارتز والميكا)",
 "英霊": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "苹果": "تُفَّاحَة / تُفَّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاحة\nمثال: هذه تفاحة أيضا.",
 "苹菓酒": "سِيدَر",
 "苺": "فَرَاوْلَة, فِرِيز",
 "苺ジャム": "مربى الفراولة (مربى مصنوع من الفراولة)",
 "茂み": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد)",
 "茂呂田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "茂木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "茂森": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "茄": "بَاذِنْجَان, بَادِنْجَان",
 "茄子": "بَاذِنْجَان, بَادِنْجَان",
 "茅原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "茅場": "حقل قش, مرج (قطعة أرض مغطاة أو مغطاة في الغالب بالعشب؛ حقل يُزرع فيه العشب أو البرسيم ليصنع منه القش)",
 "茅屋": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "茅舎": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "茅茨": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "茅葺": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "茅葺き": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "茅葺き屋根": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "茅葺屋根": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "茉莉": "فُلّ (فَلُّ السَّيْفِ: كَسْرٌ فِي حَدِّهِ؛ فَلُّ الْحَدِيدِ أَوِ الفِضَّةِ أَوِ الذَّهَبِ أَوِ النَّارِ : مَا تَنَاثَرَ مِنْ ذَلِكَ)",
 "茉莉花": "فُلّ (فَلُّ السَّيْفِ: كَسْرٌ فِي حَدِّهِ؛ فَلُّ الْحَدِيدِ أَوِ الفِضَّةِ أَوِ الذَّهَبِ أَوِ النَّارِ : مَا تَنَاثَرَ مِنْ ذَلِكَ)",
 "茎": "سَاق / نِوَاة / لامينارية (أي من أعشاب البحر المختلفة خاصة من جنس لامينارية) / طحلب بحري (أي من الأعشاب البحرية الخشنة المختلفة) / فوكوس منشاري (عشب بحري من الطحالب البنية ذو حواف مسننة) / فوكوس حويصلي (عشب صخري شائع يستخدم في تحضير عشب البحر وكسماد)",
 "茎状突起": "نتوء إبري (يمتد من قاعدة العظم الصدغي)",
 "茎節": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "茗": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة) / فِنْجَان شَاي (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: صب الشاي لضيفك.",
 "茗醼": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)",
 "茘枝": "ليتشي (فاكهة صينية ذات قشرة هشة رقيقة تحيط بلب هلامي حلو وبذرة واحدة) / شجرة الليتشي, ليتشي (شجرة صينية تزرع خاصة في الفلبين والهند لفاكهتها الصالحة للأكل) / قَاوُون",
 "茜": "فُوَّة صَبْغِيَّة / فُوَّة",
 "茜屋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "茜色": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "茣蓙": "إطار داخلي (تركيب يتكون من حد أو خلفية لصورة) / حصير (غطاء من نسيج خشن (عادة من القش أو القنب))",
 "茨": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة. / نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي)) / حدبة الأسنان, شرفة (ارتفاع صغير على سطح طحن الأسنان) / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "茨だらけ": "شَائِك / بَائِس",
 "茨の冠": "إكليل الشوك (تاج ساخر مصنوع من فروع الشوك وضعه الجنود الرومان على يسوع قبل الصلب) / إكليل الشوك, شوك المسيح (فربيون شجيري متسلق نوعاً ما في مدغشقر ذو سيقان شائكة خشبية طويلة مع القليل من الأوراق وزهور بقنابات قرمزية) / صليب (مجازي), عبء (أي بلاء يسبب معاناة كبيرة)\nمثال: هذا هو صليبه (عبؤه) الذي يجب أن يحمله",
 "茨城": "إِيبَارَاكِي",
 "茨姫": "الْجَمِيلَة الْنَائِمَة",
 "茨木": "إِيبَارَاكِي / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "茫": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "茫々": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / جَامِح, هَائِج / غَيْرُ مَصُون, مُهْمَل (لَا يُعْتَنَى بِهِ أَوْ يُصَانُ بِشَكْلٍ صَحِيح) / أَشْعَث (لَمْ يُمَشَّطْ بِعِنَايَة)",
 "茫洋": "شَاسِع, وَاسِع",
 "茫漠": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "茫然": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة) / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "茫然自失": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "茫茫": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / جَامِح, هَائِج / غَيْرُ مَصُون, مُهْمَل (لَا يُعْتَنَى بِهِ أَوْ يُصَانُ بِشَكْلٍ صَحِيح) / أَشْعَث (لَمْ يُمَشَّطْ بِعِنَايَة)",
 "茴香": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "茵": "وِسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وَسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وُسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / نُمْرُقَة / نِمْرِقَة / نَمْرَقَة\nمثال: غطى توم رأسه بوسادة.",
 "茶": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة) / فِنْجَان شَاي (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: صب الشاي لضيفك. / بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر. / اِسْتِهْزَاء",
 "茶々": "مُقَاطَعَة",
 "茶々を入れる": "قَاطَعَ",
 "茶きん": "مفرش شاي (مفرش طاولة صغير)",
 "茶さじ": "مِلْعَقَة شَاي, مِلْعَقَة صَغِيرَة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "茶せん": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "茶っぽい": "بُنِّيّ (بلون مشابه للخشب أو التراب)",
 "茶どころ": "اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "茶にする": "سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي. / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "茶の子": "وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "茶の湯": "سَادُو, طُقُوس اَلشَّاي",
 "茶の間": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
