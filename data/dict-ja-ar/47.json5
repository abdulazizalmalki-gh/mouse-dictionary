 "腹赤": "تَرُوتَة, أُطْرُوط",
 "腹足類": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات)",
 "腹踊り": "رَقْص شَرْقِيّ, رَقْص بَلَدِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "腹違い": "أَبَوِيّ",
 "腹部": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "腹部大動脈瘤": "تمدد الشريان الأورطي البطني (تمدد الأوعية الدموية في الشريان الأورطي البطني المرتبط بالشيخوخة وارتفاع ضغط الدم)",
 "腹部突き上げ法": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "腹鰭": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه الحركة؛ تقابل الأطراف الخلفية للفقاريات البرية)",
 "腹黒": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "腹黒い": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "腺": "غُدَّة",
 "腺がん": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "腺ガン": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "腺ペスト": "طاعون دملي (الشكل الأكثر شيوعًا للطاعون لدى البشر؛ يتميز بقشعريرة وإعياء وهذيان وتكون دمامل في الإبطين والفخذ؛ لا ينتشر من شخص لآخر)",
 "腺房": "عنيبة (واحدة من الأكياس الصغيرة أو التوسعات الشبيهة بالكيس في غدة مركبة) / عنيبة (واحدة من الحسيلات الصغيرة التي تشكل فاكهة متجمعة أو متعددة مثل التوت الأسود)",
 "腺様": "شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية) / لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "腺熱": "داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "腺疫": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)",
 "腺癌": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "腺腫": "ورم غدي (ورم ظهاري حميد من أصل غدي)",
 "腿": "فَخِذ, فَخْذ",
 "腿口類": "فكيات الأرجل (تستخدم في بعض التصنيفات؛ تشمل رتب سيفيات الذيل وعقارب البحر)",
 "腿節": "عظم الفخذ, فخذ (أطول وأسمك عظم في الهيكل العظمي البشري؛ يمتد من الحوض إلى الركبة)",
 "腿肉": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "膀胱": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "膀胱括約筋": "عضلة عاصرة, مصرة (حلقة من العضلات تنقبض لإغلاق فتحة)",
 "膀胱炎": "التهاب المثانة (التهاب المثانة البولية والحالبين)",
 "膀胱結石": "حَصَاةُ المَثَانَة (حصاة تتكون في المثانة)",
 "膃肭": "فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر جلد الفقمة) / فقمة الفراء الشمالية (فقمة ذات أذنين تعيش في شمال المحيط الهادئ)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "膈": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "膏沃": "خُصُوبَة",
 "膏肓": "مَقْتَل (موضع القَتْل؛ ما يُسبب القتل)",
 "膏腴": "خُصُوبَة",
 "膏薬": "مِلَاط, جِبْس / مَرْهَم, دَهُون",
 "膜": "غِشَاء",
 "膜性": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "膜性迷路": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "膜状": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "膜翅類": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "膜迷路": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "膜骨": "عظم غشائي (أي عظم ينمو داخل الأنسجة الغشائية دون تكوين غضروفي مسبق؛ مثل الترقوة وعظام الجمجمة)",
 "膜鳴楽器": "طبل (آلة إيقاعية موسيقية؛ تتكون عادة من أسطوانة مجوفة مع غشاء مشدود عبر كل طرف)",
 "膝": "رُكْبَة / حَجَر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / وَلَغَ\nمثال: عوقب زيري بالحجر.",
 "膝がしら": "رَضَفَة",
 "膝げり": "رُكْبَة",
 "膝づめ": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "膝の皿": "رَضَفَة",
 "膝を交えて": "بشكل وثيق, جيداً (بمعرفة كبيرة أو حميمة بشكل خاص) / بشكل وثيق, حميمياً (بطريقة وثيقة)\nمثال: كنا نعرفهم جيداً",
 "膝を屈する": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "膝を折る": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا) / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "膝を抱く": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "膝丈": "يصل للركبة (يمتد إلى الركبة)",
 "膝下": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "膝元": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "膝小僧": "رَضَفَة",
 "膝栗毛": "تَمَشٍّ, تَنَزُّه",
 "膝皿貝": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية) / خيتون (سترة صوفية ارتداها الرجال والنساء في اليونان القديمة)",
 "膝窩動脈": "شريان مأبضي (استمرار للشريان الفخذي يتفرع لتغذية الساقين والقدمين)",
 "膝窩静脈": "وريد مأبضي (وريد ينشأ في الركبة ويصعد ليصبح الوريد الفخذي)",
 "膝立ち": "جثو, ركوع (دعم نفسك على ركبتيك)",
 "膝蓋": "رضفة, صابونة الركبة (عظم مثلث مسطح صغير أمام الركبة يحمي مفصل الركبة)",
 "膝蓋反射": "منعكس الرضفة, منعكس الركبة (تمدد انعكاسي للساق ناتج عن نقرة حادة على وتر الرضفة)",
 "膝蓋骨": "رَضَفَة",
 "膝行": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "膝行る": "خَلَطَ (اختلط) / مَشَى يَجُرُّ قَدَمَيْهِ, رَسَفَ (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: خلط توم بين السكر و الملح.",
 "膝許": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "膝詰": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "膝詰め": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "膝蹴り": "رُكْبَة",
 "膝車": "رَضَفَة",
 "膝部": "رُكْبَة",
 "膝関節": "ركبة, مفصل الركبة (مفصل رزي في الساق البشرية يربط القصبة والشظية بعظم الفخذ وتحميه الرضفة من الأمام)",
 "膝頭": "رَضَفَة",
 "膠": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً) / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / انشراح, روقان (مزاج مبتهج ومقبول)",
 "膠付け": "غِرَاء, لِزَاق / لَصَّقَ",
 "膠原病": "نسيج ضام",
 "膠原質": "كولاجين",
 "膠嚢": "كَبْسُولة",
 "膠泥": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "膠状": "غرواني, مادة غروية (خليط له خصائص بين المحلول والمعلق الدقيق)",
 "膠着": "إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع) / تراص, تلازن (تكتل البكتيريا أو الخلايا الحمراء عند ربطها معًا بواسطة الأجسام المضادة (الراصات)) / تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "膠着剤": "لَاصِق, مُلْتَصِق (يميل إلى الالتصاق) / مادة لاصقة (مادة توحد أو تربط الأسطح ببعضها البعض)",
 "膠着状態": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "膠着語": "لغة إلصاقية (لغة تتكون فيها الكلمات من تسلسل خطي من المورفيمات المتميزة، ويمثل كل مكون من مكونات المعنى بمورفيم خاص به)\nمثال: تميل اللغات الإلصاقية إلى امتلاك معدل مرتفع من اللواحق/المورفيمات لكل كلمة، وتكون منتظمة جداً",
 "膠芽腫": "ورم أرومي دبقي (ورم دماغي خبيث سريع النمو يتكون من أرومات إسفنجية؛ قاتل تقريبًا دائمًا)",
 "膠質": "غرواني, مادة غروية (خليط له خصائص بين المحلول والمعلق الدقيق)",
 "膣": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "膣けいれん": "تشنج المهبل (انقباض عضلي يسبب انغلاق المهبل؛ عادة ما يكون رد فعل قلق قبل الجماع أو فحص الحوض)",
 "膣カンジタ症": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "膣カンジダ症": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "膣垢": "مَسْحَة مَهْبِلِيَّة (مسحة مأخوذة من الغشاء المخاطي المهبلي للتحليل الخلوي)",
 "膣外射精": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "膣洞": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "膣炎": "التهاب المهبل (التهاب المهبل (يرتبط عادة بداء المبيضات))",
 "膣痙攣": "تشنج المهبل (انقباض عضلي يسبب انغلاق المهبل؛ عادة ما يكون رد فعل قلق قبل الجماع أو فحص الحوض)",
 "膣穴": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "膣肉": "فَرْج, حِرّ",
 "膣鏡": "منظار المهبل, منظار عنق الرحم (أداة تنظير تكبر ظهارة المهبل وعنق الرحم في الجسم الحي للسماح بالمراقبة والدراسة المباشرة لهذه الأنسجة)\nمثال: يستخدم منظار المهبل المتخصص المجهز بكاميرا في فحص وجمع الأدلة لضحايا الاغتصاب والاعتداء الجنسي",
 "膨ら": "انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "膨らか": "سمين",
 "膨らかす": "تَوَسَّعَ",
 "膨らし粉": "بيكنج باودر",
 "膨らす": "تَوَسَّعَ",
 "膨らせる": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "膨らます": "اِنْتَفَخَ, وَرِمَ",
 "膨らみ": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "膨らむ": "تَوَسَّعَ",
 "膨れ": "جُلْبَة",
 "膨れっ面": "بوّز, بَرطَمَ",
