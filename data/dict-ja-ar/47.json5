 "腰蓑": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
 "腰越": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "腰部": "صُلْب, حَقْو (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "腰間": "وَرِك",
 "腰骨": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة) / ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "腰高": "مُتَسَلِّط",
 "腱": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…)",
 "腱板": "كُفَّة مُدَوَّرَة",
 "腱板損傷": "كُفَّة مُدَوَّرَة",
 "腱板疎部": "كُفَّة مُدَوَّرَة",
 "腱炎": "التهاب الوتر (التهاب الوتر)",
 "腱索": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط.",
 "腱膜": "وَتَر عَرِيض (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…)",
 "腱膜瘤": "إبهام أفحج, وكعة (تضخم مؤلم في الجراب الزلالي للمفصل الأول لإبهام القدم)",
 "腱鞘炎": "التهاب الوتر وغمده (التهاب الوتر وغمده المحيط) / التهاب الوتر (التهاب الوتر)",
 "腸": "مِعًى / مِعًى / فَرَث / مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها…) / قَلْب, فُؤَاد",
 "腸の腐った": "فَاسِقٌ, مُنْحَرِف (يَنْحَرِفُ عَمَّا يُعْتَبَرُ أَخْلَاقِيًّا أَوْ صَحِيحًا أَوْ لَائِقًا)",
 "腸カタル": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)",
 "腸チフス": "الْحُمَّى التِّيفِيَّة",
 "腸チフス菌": "سالمونيلا تيفية, عصوية التيفوئيد (شكل من أشكال السالمونيلا يسبب حمى التيفوئيد)",
 "腸内": "مَعَوِيّ",
 "腸内フローラ": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد…)",
 "腸内洗浄": "غسيل القولون (حقنة شرجية مائية تعطى لتنظيف القولون)",
 "腸内細菌叢": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد…)",
 "腸捻転": "انفتال (التواء غير طبيعي للأمعاء (عادة في منطقة اللفائفي أو القولون السيني) مما يؤدي…)",
 "腸満": "تطبل البطن (انتفاخ البطن الناجم عن تراكم الغازات في الأمعاء أو التجويف البريتوني)",
 "腸炎": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)",
 "腸疾患": "اعتلال معوي (مرض يصيب القناة المعوية)",
 "腸石": "حَصَاة مِعَوِيَّة (حصاة تحدث في الأمعاء)",
 "腸管": "قَنَاة هَضْمِيَّة",
 "腸線": "خيط معوي, وتر جراحي (حبل قوي مصنوع من أمعاء الأغنام ويستخدم في الجراحة)",
 "腸詰": "سُجُق, نَقَانِق",
 "腸詰め": "سُجُق, نَقَانِق",
 "腸詰め菌": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "腸詰菌": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "腸重積": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات…)\nمثال: انغماد الأريمة",
 "腸重積症": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات…)\nمثال: انغماد الأريمة",
 "腸閉塞": "انسداد معوي (انسداد الأمعاء (خاصة اللفائفي) الذي يمنع محتويات الأمعاء من المرور إلى الأمعاء…)",
 "腸間膜": "مِسْرَاق",
 "腸骨": "حرقفة (الجزء العلوي والأعرض من العظام الثلاثة المكونة لعظم الورك)",
 "腸骨動脈": "شريان حرقفي (واحد من الشرايين الكبيرة التي تغذي الحوض والساقين بالدم)",
 "腹": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه. / شَجَاعَة, جَسَارَة / كَرَم, سَخَاء",
 "腹いせ": "اِنْتِقَام",
 "腹がいる": "أَهْدَأَ, هَدَّأَ",
 "腹がくろい": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة)",
 "腹が太い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "腹が居る": "أَهْدَأَ, هَدَّأَ",
 "腹が決まる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "腹が黒い": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة)",
 "腹づもり": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "腹にたまる": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "腹に一物": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "腹に溜まる": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "腹に納める": "احتفظ بكل شيء لنسفه",
 "腹に落ちる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "腹の底": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "腹の据わった": "بَاسِل, جَرِيء (يتميز بالشجاعة والتصميم في مواجهة الصعوبات أو الخطر؛ قوي وغير مكبوت)\nمثال: عليك أن تعجب بها: كان شيئاً جريئاً للقيام به",
 "腹の虫": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة…)",
 "腹びれ": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه…)",
 "腹ぺこ": "جَائِع, جَوْعَان",
 "腹ぼて": "عرض, معرض (شيء يُعرض للجمهور)\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
