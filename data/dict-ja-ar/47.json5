 "臣服": "عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "臣民": "فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "臥し所": "مَخْدَع, غُرْفَةُ نَوْم",
 "臥す": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "臥する": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "臥せる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "臥やす": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "臥ゆ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "臥位": "استلقاء (وضع الاستلقاء (كما في السرير))",
 "臥具": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير)",
 "臥床": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما.",
 "臥所": "مَخْدَع, غُرْفَةُ نَوْم",
 "臥褥": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما.",
 "臥雲": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "臨み": "تَحَدٍّ, التَّحَدِّي",
 "臨む": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "臨写": "نسخ (فعل النسخ)",
 "臨在": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "臨場": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "臨場感": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "臨席": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ))\nمثال: زاد الحضور بنسبة 50 في المائة",
 "臨床": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة)\nمثال: مراقبة سريرية",
