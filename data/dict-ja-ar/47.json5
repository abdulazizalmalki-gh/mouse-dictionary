 "聖年": "سنة مقدسة ((الكنيسة الكاثوليكية) فترة غفران من الخطايا (تُمنح عادة كل 25 سنة))",
 "聖座": "اَلْكُرْسِيّ اَلرَّسُولِيّ",
 "聖徒": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)\nمثال: زيري صهيوني مسيحي.",
 "聖性": "قُدْسِيَّة",
 "聖戦": "حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "聖所": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "聖教": "كُونْفُوشِيَّة, كُونْفُشْيُوسِيَة / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به…)\nمثال: اعتنق المسيحية. / بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "聖日": "عطلة دينية, يوم مقدس (يوم محدد للاحتفال الديني)",
 "聖旨": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "聖書": "إِنْجِيل\nمثال: 君は聖書に手をのせて誓うべきだ。 — ينبغي أن تقسم ويدك على الإنجيل.",
 "聖書解釈学": "تأويلي, تفسيري (متعلق بالتفسير (خاصة للنصوص الدينية))",
 "聖木曜日": "الخميس المقدس, خميس العهد (الخميس الذي يسبق عيد الفصح؛ يحيي ذكرى العشاء الأخير)",
 "聖杯": "صُوَاع",
 "聖枝祭": "أحد الشعانين (الأحد الذي يسبق عيد الفصح)",
 "聖楽": "موسيقى دينية, موسيقى كنسية (نوع من الموسيقى المؤلفة للأداء كجزء من الاحتفالات الدينية)",
 "聖樹": "شَجَرَةُ الْمِيلَادِ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "聖櫃": "تَابُوت اَلْعَهْد (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل) / كنيس, معبد يهودي ((اليهودية) مكان العبادة لجماعة يهودية)",
 "聖歌": "تَرْتِيلَة, تَرْنِيمَة",
 "聖歌隊": "خُورُس, جَوْقَة",
 "聖殿": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "聖母": "مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة…)\nمثال: مريم طرقت الباب.",
 "聖母マリア": "مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة…)\nمثال: مريم طرقت الباب.",
 "聖母子": "مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة…)\nمثال: مريم طرقت الباب.",
 "聖母被昇天": "15 أغسطس, عيد الانتقال (احتفال في الكنيسة الكاثوليكية بانتقال السيدة العذراء مريم إلى السماء عند انتهاء…)",
 "聖水": "مَاء مُقَدَّس (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء. / بَوْل",
 "聖水盤": "حوض الماء المقدس (حوض للماء المقدس)",
 "聖油": "زيت مقدس, ميرون (مرهم مكرس يتكون من خليط من الزيت والبلسم)",
 "聖火ランナー": "حامل الشعلة, رائد (قائد في حملة أو حركة ما)",
 "聖爵": "صُوَاع",
 "聖画像": "قُونَة, أَيْقُونَة",
 "聖痕": "آثار الجروح, وصمات (علامات تشبه الجروح على جسد المسيح المصلوب)",
 "聖経": "سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية) / إِنْجِيل",
 "聖者": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "聖職": "وِزَارَة",
 "聖職者": "قِسِّيس, كَاهِن (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "聖菓": "كعكة عيد الميلاد (كعكة فواكه غنية (مغطاة عادة بالتزيين والمرزبان) وتؤكل في عيد الميلاد)",
 "聖誕祭": "الْكْرِيسْمَاس, الْمِيلَاد",
 "聖週": "أسبوع الآلام, الأسبوع المقدس (الأسبوع الذي يسبق عيد الفصح)",
 "聖遷": "نزوح جماعي, هجرة (رحلة لمجموعة كبيرة للهروب من بيئة معادية)",
 "聖遺物": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "聖都": "المدينة السماوية, المدينة المقدسة (عبارات تستخدم للإشارة إلى الجنة)\nمثال: كانت المدينة السماوية هدف كريستيان في رواية 'رحلة الحاج' لبونيان",
 "聖金曜日": "الْجُمْعَة الْعَظِيمَة, جُمْعَة الْآلَام",
 "聖霊": "الرُّوح الْقُدُس\nمثال: 聖霊がある方の上に下って、その上にとどまられるのが見えたなら、その方こそ聖霊によってバプテスマを授ける方である。 — الذي ترى الروح نازلا ومستقرا عليه فهذا هو الذي يعمد بالروح القدس.",
 "聖霊降臨": "شافوت, عيد الأسابيع ((اليهودية) يوم مقدس يهودي يُحتفل به في السادس من سيفان للاحتفال بتلقي موسى…)",
 "聖霊降臨祭": "شافوت, عيد الأسابيع ((اليهودية) يوم مقدس يهودي يُحتفل به في السادس من سيفان للاحتفال بتلقي موسى…)",
 "聖餐": "تَنَاوُل, إِفْخَارِيسْتِيَا (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام…)\nمثال: تناول سامي سما.",
 "聖餐式": "تَنَاوُل, إِفْخَارِيسْتِيَا (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام…)\nمثال: تناول سامي سما.",
 "聖騎士": "بَطَل, مُكافِح (شخص يقاتل من أجل قضية ما)",
 "聖骨箱": "ذخيرة مقدسة, وعاء الذخائر (حاوية تُحفظ فيها الآثار الدينية أو تُعرض (خاصة آثار القديسين))",
 "聚落": "مُسْتَعْمَرَة, مُسْتَوْطَنَة / مُسْتَعْمَرَة",
 "聞いた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "聞いた風": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "聞え": "اِسْتِقْبَال / سُمْعَة, شُهْرَة / اِنْطِبَاع, أَثَر / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين)",
 "聞える": "سليم\nمثال: اقرأ بصوت عالي. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "聞かす": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "聞かせどころ": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "聞かせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "聞かせ所": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "聞かぬ気": "مُتَوَحِّش, خارج عن السيطرَة",
 "聞かん気": "مُتَوَحِّش, خارج عن السيطرَة",
 "聞き": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا. / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "聞きおく": "أَصْغَى, أَنْصَتَ",
 "聞きただす": "تَيَقَّنَ, تَثَبَّتَ",
 "聞きつける": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "聞きとどける": "مَنَحَ",
 "聞きにくい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "聞きもの": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "聞きもらす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞き付ける": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "聞き伝え": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "聞き伝える": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "聞き入れる": "مَنَحَ",
 "聞き分け": "مَعْقُولِيَّة, وَجَاهَة (صفة كون الشيء معقولاً أو مقبولاً لشخص عاقل)\nمثال: شكك في وجاهة ادعاءاتي",
 "聞き分けがいい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "聞き分けがよい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "聞き分けが良い": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "聞き分けのいい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "聞き分けのない": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "聞き分けのよい": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "聞き分けの良い": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "聞き分ける": "تَعَرَّفَ",
 "聞き及ぶ": "سَمِعَ بِـ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "聞き取り調査": "تقصي الحقائق",
 "聞き取る": "لُقْطَة\nمثال: كنت أمسك بالكرة. / اِسْتَعْلَمَ, سَأَلَ",
 "聞き古した": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "聞き合せ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "聞き届ける": "مَنَحَ",
 "聞き悪い": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "聞き慣れた": "مَأْلُوف",
 "聞き所": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "聞き手": "مستمع, منصت (شخص يستمع بانتباه) / مُجري المقابلة (شخص يجري مقابلة)",
 "聞き捨てならない": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه)",
 "聞き捨てにする": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "聞き捨てる": "تَجَاهَلَ, طَنَّش",
 "聞き損なう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞き方": "مُسْتَمِع, مُسْتَمِعَة",
 "聞き旧した": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "聞き流す": "تَجَاهَلَ, طَنَّش",
 "聞き漏らす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞き物": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "聞き糺す": "تَيَقَّنَ, تَثَبَّتَ",
 "聞き置く": "أَصْغَى, أَنْصَتَ",
 "聞き落す": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞き落とす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞き質す": "تَيَقَّنَ, تَثَبَّتَ",
 "聞き込み捜査": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "聞き逃す": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞き過ごす": "تَجَاهَلَ, طَنَّش",
 "聞き過す": "تَجَاهَلَ, طَنَّش",
 "聞き酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "聞き間違える": "أَسَاءَ الْفَهْم",
 "聞き難い": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "聞く": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / أَصْغَى, أَنْصَتَ / سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / سَمِعَ بِـ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "聞ける": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "聞こえ": "اِسْتِقْبَال / سُمْعَة, شُهْرَة / اِنْطِبَاع, أَثَر / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين)",
 "聞こえた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "聞こえる": "سليم\nمثال: اقرأ بصوت عالي. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "聞こし召す": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "聞こゆ": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "聞ゆ": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "聞ゆる": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "聞付ける": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "聞入れる": "مَنَحَ",
 "聞分け": "مَعْقُولِيَّة, وَجَاهَة (صفة كون الشيء معقولاً أو مقبولاً لشخص عاقل)\nمثال: شكك في وجاهة ادعاءاتي",
 "聞届ける": "مَنَحَ",
 "聞損なう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "聞物": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "聞見": "مَعْلُومَات, مَعْلُومَة",
 "聞込み捜査": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "聞過ごす": "تَجَاهَلَ, طَنَّش",
 "聞酒": "تَذَوُّق النَّبِيذ (تجمع للناس لتذوق ومقارنة أنواع مختلفة من النبيذ)",
 "聟": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "聡い": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "聡敏": "حصافة, حكمة (سمة تكوين الآراء عن طريق التمييز والتقييم)",
 "聡明": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "聢と": "بِالتَّأْكِيد / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح)\nمثال: إنه ممكن بوضوح / بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "聯句": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى)",
 "聯隊": "فَوْج",
 "聰明": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "聲": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء. / سليم\nمثال: اقرأ بصوت عالي. / حَاسَّة\nمثال: لديهم حس الفكاهة.",
