 "至上権": "تَفَوُّق",
 "至上者": "الْكَائِنُ الْأَسْمَى",
 "至人": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "至大": "عِمْلاق",
 "至妙": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "至宝": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "至尊": "قَيْصَر, إِمْبْرَاطُور",
 "至当": "عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "至心": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "至急": "مُسْتَعْجِل / بإلحاح, بشكل عاجل (بإلحاح شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "至急便": "بريد سريع (بريد يتم توزيعه بواسطة نظام سريع وفعال)",
 "至情": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "至極": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / قِمَّة",
 "至点": "اِنْقِلَاب شَمْسِيّ",
 "至福": "تطويبة\nمثال: التطويبة المفضلة لديها هي 'طوبى للودعاء لأنهم يرثون الأرض'",
 "至福千年": "أَلْفِيَّة",
 "至福千年説": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "至聖所": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان…)\nمثال: كل سياسي يخشى المساس بقدس الأقداس، نظام الضمان الاجتماعي",
 "至要": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي",
 "至誠": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "至軽風": "هواء خفيف (رياح تتحرك بسرعة 1-3 عقد؛ 1 على مقياس بوفورت)",
 "至近弾": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "至近距離": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "至適": "أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني)",
 "至高": "أَعْلَى, سَيِّد (الأَعْظَم مَكَانَةً أَوْ سُلْطَةً أَوْ قُوَّةً)",
 "致し方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "致し方ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "致す": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "致事": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "致仕": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "致命": "مُمِيت, قَاتِل",
 "致命的": "مُمِيت, قَاتِل",
 "致死": "مُمِيت",
 "致死因子": "جين مميت (أي جين له تأثير يسبب موت الكائن الحي في أي مرحلة من مراحل الحياة)",
 "致死性": "مُمِيت",
 "致死的": "مُمِيت",
 "致死遺伝子": "جين مميت (أي جين له تأثير يسبب موت الكائن الحي في أي مرحلة من مراحل الحياة)",
 "致死量": "جرعة مميتة (حجم الجرعة التي تسبب الموت)",
 "臺灣": "تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان.",
 "臼": "رَحًى (رَحَى: طاحون؛ مؤنثة، جمعها: أرحاء، أرحية، أرح، رَحِيّ، رِحِيّ، رِحًى، وأُرْحِي…)",
 "臼づく": "بَاوْنْد",
 "臼井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "臼搗く": "بَاوْنْد",
 "臼歯": "ضِرْس",
 "臼田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "臼砲": "مِلَاط",
 "臼辺鳥": "دَجَاج, لَحْم دَجَاج",
 "舁き上げる": "كَتِف, كِتْف",
 "舂き砕く": "بَاوْنْد",
 "舂き米": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "舂く": "بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / بَاوْنْد",
 "舂米": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "舅": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "與田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "興": "فَائِدَة",
 "興ざめ": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "興し": "إِعْمَار, تَعْمِير / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "興す": "نَشَّطَ, قَوَّى (جعل شخصًا أو شيئًا أكثر حيوية أو نشاطًا؛ حفَّز حركة أو نشاطًا في مجال معين)\nمثال: نشط البرنامج الآن. / أَطْلَقَ, قَذَفَ",
 "興る": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "興亡盛衰": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء)\nمثال: لم لا تبدل ملابسك؟",
 "興信所": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "興味": "فَائِدَة",
 "興味が薄い": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "興味ない": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة)\nمثال: متفرج غير مهتم",
 "興味の薄い": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "興味をそそる": "حَدَّدَ ((حَدَّدَ) على الشَّيْء: أَقَامَ لَهُ حدا؛ (حَدَّدَ) عَلى فلَان: مَنعه من حريَّة…)\nمثال: حدد له موعدا مع الطبيب.",
 "興味本位": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "興味無い": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة)\nمثال: متفرج غير مهتم",
 "興味索然": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "興奮": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً)\nمثال: تطلع إلى إثارة اليوم",
 "興奮剤": "مُنَشِّط, مُنَبِّه",
 "興奮性": "استثارية, سرعة التأثر (سهولة الإثارة)",
 "興奮薬": "منبه, منشط (عقار يسرع مؤقتاً بعض العمليات الحيوية)",
 "興廃": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر",
 "興敗": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر",
 "興梠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "興業銀行": "بنك صناعي, شركة قروض صناعية (شركة تمويل تقدم قروضاً صغيرة للعمال الصناعيين)",
 "興産": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "興盛": "اِزْدِهَار, رَخَاء",
 "興行": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / صناعة الترفيه (المشاركون في توفير الترفيه: الراديو والتلفزيون والأفلام والمسرح)",
 "興行主": "منتج مسرحي, منظم عروض (راعٍ ذكر يحجز وينظم وسائل الترفيه العامة)",
 "興行収入": "شباك التذاكر (المكتب الذي تباع فيه تذاكر الدخول)",
 "興行師": "منتج مسرحي, منظم عروض (راعٍ ذكر يحجز وينظم وسائل الترفيه العامة)",
 "興起": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "興趣": "فَائِدَة",
 "興醒め": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "興銀": "بنك صناعي, شركة قروض صناعية (شركة تمويل تقدم قروضاً صغيرة للعمال الصناعيين)",
 "興隆": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "舌": "لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان. / للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب)",
 "舌ざわり": "مَلْمَس",
 "舌たるい": "لُثْغَة",
 "舌っ足らず": "غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "舌の根の乾かぬうち": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌の根の乾かぬ内": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌の根も乾かぬうち": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌の根も乾かぬ内": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌下": "تحت اللسان (يقع أسفل اللسان)",
 "舌下神経": "عصب تحت اللسان, عصب قحفي ثاني عشر (يغذي العضلات الداخلية لللسان وعضلات اللسان الأخرى)",
 "舌下腺": "غدة تحت اللسان (غدة لعابية صغيرة تنتج الميوسين (المكون اللزج للعاب)؛ توجد في البشر على جانبي…)",
 "舌代": "لَاحَظَ",
 "舌側": "لِسَانِيّ",
 "舌先": "ذَلَق, أَسَلَة (ذَلِقَ اللِّسانُ: كَانَ ذَلِقًا، ذَليقًا، أَيْ فَصِيحًا، طَلْقًا؛ ذَلِقَ…)",
 "舌動脈": "شريان لساني (شريان ينشأ من الشريان السباتي الظاهر ويغذي الجانب السفلي من اللسان)",
 "舌咽神経": "عصب بلعومي لساني, عصب قحفي تاسع (عصب حسي للبلعوم ومؤخرة اللسان؛ تعصب الألياف الحركية العضلات التي ترفع البلعوم…)",
 "舌圧子": "خافض لسان (خافض رقيق يستخدم للضغط على اللسان لأسفل أثناء فحص الفم والحلق)",
 "舌尖": "ذَلَق, أَسَلَة (ذَلِقَ اللِّسانُ: كَانَ ذَلِقًا، ذَليقًا، أَيْ فَصِيحًا، طَلْقًا؛ ذَلِقَ…) / إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)",
 "舌尖音": "ذِرْوِيّ, قِمِّيّ (يقع عند القمة أو الذروة)",
 "舌形動物": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية…)",
 "舌炎": "التهاب اللسان (التهاب اللسان)",
 "舌痛症": "ألم اللسان (ألم في اللسان)",
 "舌禍": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "舌端": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "舌端音": "رِقَاقِيّ, صَفِيحِيّ (مرتب في صفائح أو يتكون من رقائق)",
 "舌耕": "كلمة منطوقة, لفظة منطوقة (كلمة يتم نطقها بصوت عالٍ)",
 "舌背音": "ظَهْرِيّ",
 "舌苔": "فَرْو",
 "舌虫": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية…)",
 "舌触り": "مَلْمَس",
 "舌足らず": "غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "舌鋒": "لسان حاد, لسان سليط (طريقة مريرة أو نقدية في التحدث)",
 "舌鋒鋭い": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "舌長": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "舌革": "لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان.",
 "舌頂音": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة)",
 "舌頭": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "舌骨": "عظم لامي",
 "舌鮃": "وَحِيد\nمثال: سمكة ميناد ماتت",
 "舍人": "خَادِم, خَادِمَة",
 "舎": "كُوخ, تَخْشِيبَة / بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "舎人": "خَادِم, خَادِمَة",
 "舎利": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "舎利別": "شَرَاب, قَطْر",
 "舎利塔": "ذخيرة مقدسة, وعاء الذخائر (حاوية تُحفظ فيها الآثار الدينية أو تُعرض (خاصة آثار القديسين))",
 "舎利塩": "كبريتات المغنيسيوم (ملح للمغنيسيوم)",
 "舎営": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص))\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "舎宅": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "舎密": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء.",
 "舎弟": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "舐": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舐ぶる": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舐め": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舐める": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)\nمثال: その子犬は彼女の頬を舐めた。 — الكلب لعق خدها. / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / اِسْتَخَفَّ, اِسْتَهَانَ\nمثال: 俺をなめるな。 — لا تستخف بمقدرتي.",
 "舐めプレイ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)\nمثال: كانت هزيمة بفارق ضئيل",
 "舐め腐る": "تَرَفَّعَ",
 "舐め舐め": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)\nمثال: كانت هزيمة بفارق ضئيل",
 "舐る": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舗": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها)\nمثال: ذهب إلى الدكان.",
 "舗石": "حَجَر رَصْف (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "舗装": "تبليط, رصف (فعل وضع مواد الرصف على منطقة ما)",
