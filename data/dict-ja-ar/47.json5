 "臭化メチル": "بروميد الميثيل",
 "臭化水素": "بروميد الهيدروجين (غاز عديم اللون ينتج حمض الهيدروبروميك عند ذوبانه في الماء)",
 "臭化物": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "臭化銀": "بروميد الفضة (بروميد يغمق لونه عند تعرضه للضوء؛ يُستخدم في صنع المستحلبات الفوتوغرافية)",
 "臭味": "نَتُنَ, نَتِنَ / تَصَنُّع, تَكَلُّف",
 "臭橘": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة…)",
 "臭気": "نَتُنَ, نَتِنَ",
 "臭気止め": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "臭素": "بُرُوم, بُرُومِين",
 "臭素紙": "ورق بروميد (ورق تصوير حساس بمستحلبات بروميد الفضة ينتج نغمات صور سوداء محايدة أو زرقاء…)",
 "臭素酸": "حمض البروميك (حمض غير مستقر يستخدم كعامل مؤكسد)",
 "臭覚": "حاسة الشم, شم (الملكة التي تمكننا من تمييز الروائح)",
 "臭跡": "أَرِيج",
 "臭鼠": "فَأْرُ المِسْك",
 "至": "أَنّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
