 "遊色効果": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "遊蕩": "مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "遊行": "تسكع / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "遊行者": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "遊覧": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة",
 "遊覧地": "مُنْتَجَع",
 "遊覧客": "متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "遊覧船": "طراد مقصورة, يخت ترفيهي (قارب آلي كبير يحتوي على مقصورة وسباكة ووسائل راحة أخرى ضرورية للعيش على متنه)",
 "遊説": "جولة خطابية (القيام بحملة لشيء ما عن طريق إلقاء الخطب السياسية)",
 "遊走": "هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "遊走子": "بوغ حيواني, بوغ متحرك (بوغ لاجنسي لبعض الطحالب والفطريات يتحرك بواسطة الأسواط)",
 "遊走腎": "تتدلي الكلية, هبوط الكلية (تدلي الكلية)",
 "遊離": "تَفْرِقَة / تخليص, فك التشابك (عملية التحرير من حالة تشابك أو تعقيد)",
 "遊離基": "جذر حر, شق طليق (ذرة أو مجموعة ذرات بها إلكترون واحد غير مزدوج على الأقل؛ في الجسم عادة ما يكون جزيء أكسجين فقد إلكتروناً وسيعمل على استقرار نفسه عن طريق سرقة إلكترون…)\nمثال: الجذور الحرة في الجسم هي جسيمات عالية الطاقة ترتد بعشوائية وتضر بالخلايا",
 "運": "ثَرْوَة",
 "運がいい": "مَحْظُوظ, جَالِب للحَظّ",
 "運がない": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "運がよい": "مَحْظُوظ, جَالِب للحَظّ",
 "運が悪い": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "運が無い": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "運が良い": "مَحْظُوظ, جَالِب للحَظّ",
 "運ちゃん": "سَائِق, سَوَّاق",
 "運のいい": "مَحْظُوظ, جَالِب للحَظّ",
 "運のよい": "مَحْظُوظ, جَالِب للحَظّ",
 "運の悪い": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "運の良い": "مَحْظُوظ, جَالِب للحَظّ",
 "運び": "تَقَدُّم",
 "運びだす": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "運び出す": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "運び屋": "رسول, ساعي (شخص يحمل رسالة)",
 "運び手": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "運ぶ": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "運よく": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "運ゲー": "لعبة حظ (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "運休": "يُعَلِّق / تَعْلِيق",
 "運動": "تَمْرِين, تَدْرِيب / تَمَرَّنَ / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / حَرَكَة",
 "運動エネルギー": "طَاقَة حَرَكِيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "運動ニューロン": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "運動不足": "خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "運動会": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق) / يوم حافل, يوم ممتع (وقت من المتعة والنجاح غير المعتاد) / يوم رياضي (يوم للمنافسات الرياضية الخارجية) / يوم مناورات ((عسكرية) يوم للتدريبات والعروض العسكرية)",
 "運動公園": "مَلْعَب, إِسْتَاد (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "運動具": "بضائع رياضية, سلع رياضية (معدات رياضية تباع كسلعة)",
 "運動力": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "運動員": "مرشح (سياسي يترشح لمنصب عام)",
 "運動器": "الجهاز العضلي الهيكلي (نظام العضلات والأوتار والأربطة والعظام والمفاصل والأنسجة المرتبطة بها التي تحرك الجسم وتحافظ على شكله)",
 "運動場": "ملعب, ميدان اللعب (قطعة أرض مجهزة لممارسة لعبة ما) / مجال تنافس, ملعب (الظروف التي تجري في ظلها المنافسة)\nمثال: هلل الجمهور عندما نزل فريق برينستون إلى الملعب",
 "運動失調": "رَنَح ((رَنَّحَ) فلان: تمايل من السكر وغيره؛ (رَنَّحَ) الشراب فلانا: جعله يرنح)",
 "運動失調症": "رنح, فقدان الانتظام الحركي (عدم القدرة على تنسيق الحركات العضلية الإرادية؛ حركات غير مستقرة ومشية مترنحة)",
 "運動学": "علم الحركة المجردة, كينماتيكا (فرع الميكانيكا المعني بالحركة دون الإشارة إلى القوة أو الكتلة)",
 "運動家": "نَاشِط, نَاشِطَة / رِيَاضِيّ, رِيَاضِيَّة",
 "運動性": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "運動性構音障害": "رتة, عسر التلفظ (ضعف القدرة التعبيرية الناتجة عن عيوب في الأعصاب الحركية المحيطية أو في عضلات الكلام)",
 "運動感覚": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم) / إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "運動欄": "القسم الرياضي (قسم الصحيفة الذي يغطي الأخبار الرياضية)",
 "運動率": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "運動皮質": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "運動着": "ملابس رياضية (ملابس تلبس للرياضة أو للارتداء غير الرسمي)",
 "運動神経": "عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد) / مُنْعَكَس",
 "運動者": "نَاشِط, نَاشِطَة",
 "運動能力": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "運動覚": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم) / إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "運動選手": "رِيَاضِيّ, رِيَاضِيَّة",
 "運動野": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "運動量": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "運動障害": "خلل الحركة, عسر الحركة (شذوذ في أداء الحركات العضلية الإرادية)",
 "運動障害性構音障害": "رتة, عسر التلفظ (ضعف القدرة التعبيرية الناتجة عن عيوب في الأعصاب الحركية المحيطية أو في عضلات الكلام)",
 "運動靴": "مُتَسَلِّل / حِذَاء رِيَاضِيّ (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "運動領": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "運勢": "ثَرْوَة",
 "運勢判断": "عَرَافَة",
 "運命": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "運命のいたずら": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء",
 "運命の悪戯": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء",
 "運命的": "مَحْتُوم, مُقَدَّر ((يُتبع عادة بـ 'أن') محكوم بالقدر) / ذَاهِب, مُتَّجِه (متجه أو ينوي التوجه في اتجاه معين)",
 "運命論": "جبرية (مذهب فلسفي يرى أن جميع الأحداث محددة مسبقاً لكل الأوقات وأن البشر عاجزون عن تغييرها) / إيمان بالقضاء والقدر, قدرية (موقف ذهني خاضع ناتج عن قبول عقيدة أن كل ما يحدث مقدر سلفاً وحتمي)",
 "運命論者": "جبري, قدري (من أو متعلق بالقدرية (الإيمان بالقضاء والقدر المحتوم)) / حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)\nمثال: شخص قدري",
 "運営": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "運営上": "عَامِل, قَيْدَ التَّشْغِيل (في حالة تنفيذ أو تشغيل) / تشغيلي, عملياتي ((عسكري) متعلق أو مخصص أو مشارك في العمليات العسكرية) / جَاهِز لِلْعَمَل, صَالِح لِلاسْتِعْمَال (مناسب وجاهز للاستخدام أو الخدمة) / تشغيلي, عملياتي (يخص عملية أو سلسلة من الإجراءات لتحقيق نتيجة)\nمثال: صعوبات تشغيلية",
 "運営委員会": "لجنة توجيهية (لجنة لترتيب جدول أعمال هيئة (تشريعية) أكبر)",
 "運営管理官": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "運営経費": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "運営者": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "運営費": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "運弓": "استخدام القوس (إدارة القوس في العزف على آلة وترية) / مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / انحناء (حني الرأس أو الجسم أو الركبة كعلامة على الاحترام أو الخضوع أو التحية)\nمثال: كان استخدام عازف الكمان للقوس ممتازاً",
 "運弓法": "استخدام القوس (إدارة القوس في العزف على آلة وترية) / مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / انحناء (حني الرأس أو الجسم أو الركبة كعلامة على الاحترام أو الخضوع أو التحية)\nمثال: كان استخدام عازف الكمان للقوس ممتازاً",
 "運悪く": "بكل أسف, لسوء الحظ (بسبب سوء الحظ)\nمثال: لسوء الحظ أمطرت طوال اليوم",
 "運指": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "運搬": "نَقَلَ / نَقْل",
 "運搬人": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "運搬作用": "نَقْل, نَقْلِيَّات",
 "運搬船": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "運搬ＲＮＡ": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "運気": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "運河": "قَنَاة",
 "運漕": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "運用": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة",
 "運用委託": "اِنْتِدَاب, حُكْم",
 "運用方法": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
