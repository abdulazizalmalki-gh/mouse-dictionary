 "艦橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "艦艇": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "艦長": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "艦隊": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات:…)",
 "艦首": "قَوْس, قوس",
 "艨艟": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "艫": "صَارِم, مُتَشَدِّد / صَارِم, مُتَشَدِّد / قَوْس, قوس",
 "艫座": "سطح الكوثل (سطح مكشوف جزئي على البنية الفوقية لمؤخرة السفينة)",
 "艫綱": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "艮": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك",
 "艮為山": "معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك",
 "良": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "良い": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "良いお年を": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "良いころ": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "良い具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "良い塩梅に": "لِحُسْن اَلْحَظّ",
 "良い夢を": "لَيْلَة سَعِيدَة وَأَحْلَام لَذِيذَة (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل…)",
 "良い天気": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "良い時間": "مُتَأَخِّر / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "良い気": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير)",
 "良い目": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "良い話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "良い頃": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "良い顔": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "良からぬ": "سَيِّئ, وحش",
 "良かれ悪しかれ": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "良かろう": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "良き": "خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل…)\nمثال: يبدو زيري بخير. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "良きにつけ悪しきにつけ": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "良きにはからえ": "تَوَخَّى اَلْحِذْر",
 "良きに計らえ": "تَوَخَّى اَلْحِذْر",
 "良き手本": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "良く": "بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / شُكْرًا, تِسْلَم / لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "良くある質問": "أَسِئْلَة مُكَرَّرَة",
 "良くする": "حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "良くできました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "良くないね": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود.",
 "良くなる": "حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "良くも悪くも": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "良く出来ました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "良く焼き": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "良く考えたら": "فِعْلًا",
 "良さ": "جَدَارَة",
 "良し": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "良しとする": "قِيمَة",
 "良しなに": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "良し悪し": "نَوْعِيَّة, جَوْدَة",
 "良人": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / إنسان طيب, فاعل خير (شخص يعامل الآخرين بإحسان)",
 "良化": "تَحْسِين",
 "良好": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "良川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "良心": "ضَمِير (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "良心の囚人": "سَجِين الرَأْي",
 "良心的": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)\nمثال: قرار نابع من الضمير بالتحدث علناً عن الظلم",
 "良心的兵役拒否者": "مستنكف ضميرياً (من يرفض الخدمة في القوات المسلحة لأسباب تتعلق بالضمير)",
 "良性": "كَرِيم, لَطِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "良性腫瘍": "ورم حميد (ورم غير سرطاني)",
 "良書": "الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "良民": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "良知": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس:…)",
 "良能": "قدرة طبيعية, قدرة فطرية (القدرة الموروثة)",
 "良識": "بديهة, حس سليم (حكم عملي سليم)\nمثال: الحس السليم ليس شائعًا جدًا",
 "良識ある": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "良質": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "良馬場": "مسار سريع (وسيلة سريعة لتحقيق هدف)\nمثال: رأوا الاستقلال كمسار سريع للديمقراطية",
 "艱苦": "مَشَقَّة, شِدَّة",
 "艱難": "مَشَقَّة, شِدَّة",
 "艱難苦労": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "艱難辛苦": "مَشَقَّة, شِدَّة",
 "色": "مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون / بَشْرَة / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن…)\nمثال: ما هو لون شعرك؟ / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / تَعْبِير / مَيْل, نَزَعَة",
 "色々": "مُخْتَلِف, مُتَنَوَّع / بشكل متنوع, بشكل مختلف (بطرق متنوعة)\nمثال: البدائل التي يتم تمثيلها بشكل مختلف من قبل المشاركين",
 "色あせる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / بَاهِت, شَاحِب",
 "色ごと": "عَلَاقَة غَرَامِيَّة",
 "色っぽい": "عِشْقِيّ, غَرَامِيّ",
 "色つき": "مُلَوَّن",
 "色つや": "بَشْرَة",
 "色づく": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "色とび": "بَاهِت, مَغْسُول (فاقد اللون بسبب التعرّض للضوء أو الغسيل المتكرّر)",
 "色とりどり": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / مُتَنَوِّع",
 "色どり": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون",
 "色ぬり": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "色み": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "色めく": "مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "色よい": "مُفِيد, مُوَاتٍ (يمنح ميزة)\nمثال: عقد مفيد لبلدنا",
 "色を塗る": "تلطيخ, رسم رديء (لوحة غير متقنة)\nمثال: كانت هناك لطخة على خده",
 "色んな": "مُخْتَلِف, مُتَنَوَّع",
 "色事": "عَلَاقَة غَرَامِيَّة",
 "色事師": "زير نساء, كازانوفا (أي رجل مشهور بمغامراته العاطفية)",
 "色付き": "مُلَوَّن",
 "色付く": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "色付け": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "色付ける": "مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون",
 "色出し": "أَحْزَنَ ((أَحْزَنَ) الْمَكَان: حزن وَيُقَال: أَحْزَن بهم الْمنزل: نبا بهم؛ (أَحْزَنَ)…)\nمثال: أحزن كثيرا على سامي.",
 "色分け": "تَصْنِيف",
 "色収差": "زيغ لوني (زيغ بصري تكون فيه للصورة حواف ملونة)",
 "色取り": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون",
 "色合": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)\nمثال: أثاره شعور المدينة",
 "色合い": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)\nمثال: أثاره شعور المدينة",
 "色図鑑": "كِتَاب مَرْجِعِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "色塗り": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "色変り": "تبدل اللون, تغير اللون (فعل تغيير اللون الطبيعي لشيء ما بجعله باهتاً أو قذراً أو غير طبيعي أو شاحباً)\nمثال: ترك النبيذ بقعة داكنة / مُخْتَلِف\nمثال: أرني مثالا آخر.",
