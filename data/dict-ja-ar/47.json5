 "辛い": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين) / حِرِّيف, حَارّ\nمثال: الجو حار اليوم. / مَالِح / مِلْحِيّ / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ) / أَلِيم, مُؤْلِم\nمثال: 彼女は多くの辛い思いを経験してきた。 — لقد واجهَت الكثير من الصعوبات. / أَلِيم, مُؤْلِم / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "辛うじて": "بِٱلْكَاد",
 "辛く": "بخشونة, بصرير (بطريقة قاسية ومزعجة للأذن) / بحدة, بخشونة (بطريقة قاسية أو غير لطيفة)\nمثال: وقع صوتها بصرير على آذاننا",
 "辛くも": "بِٱلْكَاد",
 "辛さ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "辛み": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "辛め": "حَارّ نَوْعاً مَا (ساخن بعض الشيء) / صَارِم",
 "辛らつ": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "辛党": "شَارِب",
 "辛労": "مَشَقَّة, شِدَّة",
 "辛口": "مَالِح / مِلْحِيّ / خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ)",
 "辛塩": "مِلْح, ملح / مَلَّحَ / مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "辛子": "خَرْدَل",
 "辛子油": "زيت الخردل (زيت يُستخرج من بذور الخردل ويُستخدم في صنع الصابون)",
 "辛子色": "خَرْدَل",
 "辛抱": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "辛抱強い": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "辛気": "عَقْلِيَّة / تهيج, سرعة الغضب (شعور بالتهيج والنزق)",
 "辛気くさい": "كَئِيب, كَنُود (يسبب مشاعر حزينة من الكآبة وعدم الكفاءة)\nمثال: التوقعات الاقتصادية محبطة / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "辛気臭い": "كَئِيب, كَنُود (يسبب مشاعر حزينة من الكآبة وعدم الكفاءة)\nمثال: التوقعات الاقتصادية محبطة / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "辛物": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "辛目": "حَارّ نَوْعاً مَا (ساخن بعض الشيء) / صَارِم",
 "辛苦": "مَشَقَّة, شِدَّة",
 "辛苦艱難": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "辛辛": "بِٱلْكَاد",
 "辛辣": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "辛酒": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "辛酸": "مَشَقَّة, شِدَّة",
 "辞": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم. / مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101) / كوري (وحدة للنشاط الإشعاعي تساوي كمية النظير المشع الذي يتحلل بمعدل 37 مليار تفكك في الثانية)",
 "辞す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / اِسْتَقَالَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辞する": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / اِسْتَقَالَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辞めさせる": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "辞める": "اِسْتَقَالَ",
 "辞世": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "辞令": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "辞任": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "辞儀": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辞典": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "辞去": "ذهاب, رحيل (فعل المغادرة)",
 "辞彙": "مَسْرَد",
 "辞書": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "辞書学": "علم المعجم, لكسيكولوجيا (فرع اللسانيات الذي يدرس المكون المعجمي للغة)",
 "辞書形": "لَيمَّا ((في علم اللسانيات) الشكل المعجمي القانوني للكلمات التي تتشارك في المعنى عينه…)",
 "辞書攻撃": "هجوم المعجم",
 "辞書編集": "صناعة المعاجم, معجمية (فعل تأليف القواميس)",
 "辞書編集者": "معجمي, واضع المعاجم (جامع أو كاتب القاموس؛ دارس للمكون اللفظي للغة)",
 "辞書部門": "معجم ذهني, مفردات (معرفة مستخدم اللغة بالكلمات) / قاموس, معجم (كتاب مرجعي يحتوي على قائمة أبجدية بالكلمات مع معلومات عنها)",
 "辞書類": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "辞林": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "辞柄": "ذَرِيعَة, عُذْر",
 "辞職": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "辞職願": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "辞職願い": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "辞謝": "إِنْكَار, رَفْض",
 "辞退": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辟": "زَائِف, بَاطِل / كَاذِب",
 "辟易": "تألم, جفل (استجابة انعكاسية لألم مفاجئ) / تقطيب الألم, جفول (تعبير الوجه عن ألم مفاجئ)",
 "辣腕": "حذق, حنكة (الذكاء الذي يظهر من خلال الحنكة (كما في التعاملات التجارية))",
 "辨": "بِنْتُو",
 "辨え": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة / عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "辨える": "مَيَّزَ / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس.",
 "辨償": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "辨別": "تَمْيِيْز",
 "辨務官": "مُفَوَّض, مُفَوَّضَة",
 "辨当": "بِنْتُو",
 "辨慶": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "辨明": "تَفْسِير, شَرْح",
 "辨済": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "辨理": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "辨當": "بِنْتُو",
 "辮髪": "ضَفِيرَة صَغِيرَة (جديلة من الشعر المضفر)",
 "辯": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "辯士": "مُحَاضِر, مُحَاضِرَة",
 "辯才": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "辯明": "تَفْسِير, شَرْح",
 "辯疏": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "辯舌": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "辯解": "تَفْسِير, شَرْح",
 "辯論": "مُنَاقَشَة, بَحْث",
 "辯護": "دِفَاع, حِمَايَة / دِفاع",
 "辯駁": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "辰": "تِنِّين",
 "辰巳": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "辰星": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم / زِئْبَق, زَاؤُوق / حُلْبُوب",
 "辰沙": "زِنْجَفْر",
 "辰砂": "زِنْجَفْر",
 "辱": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "辱め": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل. / اِنْتِهَاك",
 "辱める": "أَخْزَى, اِسْتَذَلَّ (أَخْزَى: (فعل) أخزَى يُخزي ، أخْزِ ، إخزاءً ، فهو مُخْزٍ ، والمفعول مُخزًى) / اِنْتَهَكَ",
 "辱知": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "農": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "農事": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "農人": "فَلَّاح, فَلَّاحَة",
