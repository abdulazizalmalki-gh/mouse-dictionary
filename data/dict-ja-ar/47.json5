 "苗字": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "苗床": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "苗族": "لغة المياو, لغة الهمونغ (لغة ذات انتماء غير مؤكد يتحدث بها شعب الهمونغ)",
 "苗木": "شَتْلَة",
 "苗条": "صَوَّبَ (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد…)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "苗裔": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "苗語": "هْمُونْغ",
 "苗頭": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك))\nمثال: تحويل عن الطريق السريع الرئيسي",
 "苛々": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "苛ち": "مُسْتَعْجِل",
 "苛む": "عَذَاب",
 "苛め": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ…)\nمثال: الإنفصاليون مثل الإرهاب.",
 "苛めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "苛めっ子": "مُسْتَأْسِد, مُتَنَمِّر",
 "苛める": "مُسْتَأْسِد, مُتَنَمِّر",
 "苛性": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ…)",
 "苛性アルカリ": "غسول, محلول قلوي (محلول قوي من هيدروكسيد الصوديوم أو البوتاسيوم)",
 "苛性カリ": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "苛性ソーダ": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات…)",
 "苛性加里": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "苛政": "طُغْيَان, اِسْتِبْدَاد",
 "苛烈": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم)",
 "苛立たしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "苛立たしげ": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "苛立たし気": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "苛立ち": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما)\nمثال: اشتعل غضبه كالحطب الجاف",
 "苛苛": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "苛酷": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم)",
 "苜蓿": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات…)",
 "苞": "قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها) / تَذْكار",
 "苞苴": "تَذْكار",
 "苞葉": "قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها)",
 "苟も": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "苟且": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "苣木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "若": "شَبَاب / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / صَغِير, حَدَث",
 "若々しい": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "若々しさ": "شباب, فتوة (النضارة والحيوية المميزة للشاب)",
 "若い": "صَغِير, حَدَث / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة / حَزين",
 "若いときの苦労は買うてもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "若いときの苦労は買ってもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "若いもん": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若い子": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若い時の苦労は買うてもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "若い時の苦労は買ってもせよ": "لا يدّخر جهدًا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "若い者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若い衆": "شاب (مراهق أو شاب بالغ ذكر)",
 "若き": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / صَغِير, حَدَث",
 "若き日": "شَبَاب",
 "若く": "مُبَارَاة / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "若さ": "شَبَاب",
 "若し": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "若しくは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "若しや": "رُبَّمَا\nمثال: يا لها من جملة!",
 "若どり": "طائر صغير, فرخ طائر (طائر لا يزال صغيراً) / دَجَاج, لَحْم دَجَاج",
 "若め": "شَابّ نَوْعًا مَا (صغير السنّ إلى حدّ ما)",
 "若やか": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "若井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "若人": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "若僧": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "若宮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "若山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "若干": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "若干名": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "若年": "شَبَاب",
 "若年型": "سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج)\nمثال: سكري الأحداث",
 "若年型糖尿病": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية…)",
 "若年寄": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
