 "肉付きのいい": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "肉付きのよい": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "肉付きの良い": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "肉付け": "عارضة أزياء, نمذجة",
 "肉体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "肉体労働者": "شغيل, عامل يدوي (شخص يعمل بيديه؛ شخص يعمل في العمالة اليدوية)",
 "肉体的": "جَسَدِيّ, بَدَنِيّ / جِنْسِيّ (المنسوب إلى الجِنْس؛ في : علاقة قانونية تربط فردا معينا بدولة معينة، قد تكون أصيلة أو مكتسبة)\nمثال: تعرض للتحرش الجنسي.",
 "肉体関係": "اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "肉冠": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "肉切り": "سكين التقطيع (سكين كبير يستخدم لتقطيع اللحم المطبوخ)",
 "肉切り包丁": "سكين التقطيع (سكين كبير يستخدم لتقطيع اللحم المطبوخ)",
 "肉切り庖丁": "سكين التقطيع (سكين كبير يستخدم لتقطيع اللحم المطبوخ)",
 "肉刑": "عُقُوبَةٌ بَدَنِيَّة",
 "肉刺": "بَطْبَاطَة, نَفْطَة / شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "肉刺し": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "肉割れ": "عَلَامَة تَمَدُّد, عَلَامَة مَطّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "肉厚": "سَمِيك, غَلِيظ / غَلِيظ",
 "肉叉": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "肉叢": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "肉合": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "肉合い": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "肉団子": "كُرَات اللَحْم",
 "肉垂": "تعريشة, سياج أغصان (هيكل يتكون من أوتاد متشابكة مع الفروع لتشكيل سياج) / دالية, لغد (طية جلدية لحمية مجعدة وغالباً ما تكون زاهية الألوان تتدلى من عنق أو حلق بعض الطيور (الدجاج والديك الرومي) أو السحالي) / أكاسيا, سنط (أي من الأشجار الأسترالية المتنوعة التي تنتج أعمدة رفيعة مناسبة للسياج المضفر)",
 "肉垂れ": "تعريشة, سياج أغصان (هيكل يتكون من أوتاد متشابكة مع الفروع لتشكيل سياج) / دالية, لغد (طية جلدية لحمية مجعدة وغالباً ما تكون زاهية الألوان تتدلى من عنق أو حلق بعض الطيور (الدجاج والديك الرومي) أو السحالي) / أكاسيا, سنط (أي من الأشجار الأسترالية المتنوعة التي تنتج أعمدة رفيعة مناسبة للسياج المضفر)",
 "肉塊": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "肉壁": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "肉壷": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "肉壺": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "肉太": "بولد, خط عريض (نمط خط ذو خطوط سميكة وثقيلة)",
 "肉屋": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "肉幹": "قَضِيب, ذَكَر",
 "肉感的": "شَهْوَانِيّ",
 "肉慾": "شَهْوَة",
 "肉慾的": "شَهْوَانِيّ",
 "肉挽き器": "معركة طاحنة, مفرمة (أي عمل يؤدي إلى إصابة أو دمار (مجازي)) / مفرمة لحم (طاحونة لفرم اللحم)\nمثال: مفرمة السياسة دمرت سمعته",
 "肉挽き機": "معركة طاحنة, مفرمة (أي عمل يؤدي إلى إصابة أو دمار (مجازي)) / مفرمة لحم (طاحونة لفرم اللحم)\nمثال: مفرمة السياسة دمرت سمعته",
 "肉杭": "قَضِيب, ذَكَر",
 "肉柱": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "肉桂": "قِرْفَة",
 "肉桂色": "قِرْفَة",
 "肉棒": "زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "肉欲": "شَهْوَة",
 "肉欲的": "شَهْوَانِيّ",
 "肉汁": "بويون, مرق متبل (مرق صافي متبل)",
 "肉池": "محبرة ختم, وسادة حبر (كتلة من مادة ماصة مشبعة بالحبر؛ تستخدم لنقل الحبر بالتساوي إلى ختم مطاطي)",
 "肉片": "قطعة لحم, قطعية لحم (قطعة من اللحم تم قطعها من ذبيحة الحيوان)",
 "肉牛": "أبقار اللحم, ماشية اللحم (الماشية التي تُربى من أجل لحومها)",
 "肉球": "قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "肉的": "مَادِّيّ, مَلْمُوس",
 "肉眼": "عَيْن مُجَرَّدَة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "肉穂花序": "إغريض (المحور اللحمي لسنبلة محاط غالباً بقنابة)",
 "肉穴": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا / اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "肉竿": "قَضِيب, ذَكَر",
 "肉筆": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "肉筆画": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "肉縁": "صِلَة الدَّم الوَاحِد",
 "肉置き": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "肉肉しい": "لَحْمِيّ",
 "肉腫": "ساركومة (ورم خبيث عادة ينشأ من النسيج الضام (العظام أو العضلات وما إلى ذلك)؛ أحد الأنواع الأربعة الرئيسية للسرطان)",
 "肉色": "بِلَوْن الجِلْد البَشَرِيّ (بلون أحمر فاتح أو وردي كلون البشرة)",
 "肉芽": "تحبيب (فعل تشكيل شيء ما إلى حبيبات) / تحبب, نسيج حبيبي (نسيج ضام جديد وأوعية دموية دقيقة تتشكل على أسطح الجرح أثناء عملية الشفاء)\nمثال: تحبيب الأدوية / بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور) / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "肉芽組織": "تحبب, نسيج حبيبي (نسيج ضام جديد وأوعية دموية دقيقة تتشكل على أسطح الجرح أثناء عملية الشفاء)",
 "肉芽腫": "ورم حبيبي (ورم يتكون من نسيج حبيبي ناتج عن إصابة أو التهاب أو عدوى)",
 "肉茎": "سُوَيْق, سُوَيْقَة / زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "肉薄": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية)) / رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "肉蠅": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "肉襞": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "肉襦袢": "بِلَوْن الجِلْد البَشَرِيّ (بلون أحمر فاتح أو وردي كلون البشرة)",
 "肉親": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "肉質": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "肉迫": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية))",
 "肉阜": "لحيمة, نتوء لحمي (نتوء على نبات أو حيوان مثل داليات الطيور أو نتوء بالقرب من نقير بعض البذور)",
 "肉類": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "肉食": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉食動物": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉食性": "أكل اللحوم (صفة كون الحيوان يأكل اللحوم كجزء رئيسي من نظامه الغذائي)",
 "肉食獣": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉食系": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉髯": "تعريشة, سياج أغصان (هيكل يتكون من أوتاد متشابكة مع الفروع لتشكيل سياج) / دالية, لغد (طية جلدية لحمية مجعدة وغالباً ما تكون زاهية الألوان تتدلى من عنق أو حلق بعض الطيور (الدجاج والديك الرومي) أو السحالي) / أكاسيا, سنط (أي من الأشجار الأسترالية المتنوعة التي تنتج أعمدة رفيعة مناسبة للسياج المضفر)",
 "肋": "ضِلْع",
 "肋材": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "肋筋": "رِكَاب",
 "肋膜": "جنب, غشاء الجنب (الغشاء المصلي الرقيق حول الرئتين والجدران الداخلية للصدر)",
 "肋膜炎": "ذات الجنب (التهاب غشاء الجنب الرئوي)",
 "肋軟骨": "غضروف ضلعي (الغضاريف التي تربط القص بنهايات الأضلاع؛ تسمح مرونتها للصدر بالتحرك أثناء التنفس)",
 "肋軟骨炎": "التهاب الغضروف الضلعي (التهاب عند تقاطع الضلع وغضروفه)",
 "肋間": "وَرْبِيَّة, وَرْبِيّ",
 "肋間動脈": "شريان بين الضلوع, شريان ورابي (عدة شرايين تغذي المسافات الوربية (بين الأضلاع) في القفص الصدري)",
 "肋間筋": "عضلة بين الضلوع, عضلة ورقية (عضلات بين الأضلاع؛ تنقبض أثناء الشهيق)",
 "肋骨": "ضِلْع / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر.",
 "肌": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "肌ざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "肌の色": "بشرة, لون البشرة (لون وجه الشخص)",
 "肌合": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "肌合い": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "肌寒": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "肌寒い": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "肌感覚": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "肌理": "مَلْمَس / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم. / تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "肌着": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "肌膚": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "肌色": "بشرة, لون البشرة (لون وجه الشخص)",
 "肌触り": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "肌質": "مَلْمَس",
 "肌身": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "肌馬": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "肌骨": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "肖像": "صُورَة / بُورْتْرِيَّة\nمثال: この切手には誰の肖像が印刷してありますか。 — من هو الشخص المصور على هذا الطابع؟",
 "肖像画": "صُورَة / بُورْتْرِيَّة",
 "肖像画家": "رسام بورتريه, مصور وجوه (رسام أو راسم للصور الشخصية (البورتريه))",
 "肘": "كُوع, مِرْفَق / كُوعٌ",
 "肘当て": "واقي كوع (ملابس واقية تتكون من وسادة تلبس فوق الكوع من قبل لاعبي كرة القدم والهوكي)",
 "肘掛": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "肘掛け": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "肘掛け椅子": "كُرْسِيّ ذُو ذِرَاعَيْن, أَرِيكَة (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "肘木": "شَرِيحَة",
 "肘鉄": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "肘鉄砲": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "肘関節": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "肘頭": "نَاتِئ مِرْفَقِيّ, طَرَف الْمِرْفَق",
 "肛門": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "肛門外科": "طب المستقيم (فرع الطب المعني بتشخيص وعلاج اضطرابات القولون أو المستقيم أو الشرج)",
 "肛門学": "طب المستقيم (فرع الطب المعني بتشخيص وعلاج اضطرابات القولون أو المستقيم أو الشرج)",
 "肛門性交": "جِمَاع شَرَجِيّ (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
