 "透過的データ": "شَفَّاف",
 "透閃石": "تريموليت (معدن أبيض أو أخضر باهت (سيليكات الكالسيوم والمغنيسيوم) من مجموعة الأمفيبول يستخدم كشكل من أشكال الأسبستوس)",
 "逐一": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "逐一命令操作": "تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)",
 "逐年": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "逐日": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "逐次": "بالدور, على التوالي (في ترتيب أو تسلسل مناسب)\nمثال: تحدث إلى كل طفل بدوره",
 "逐次刊行物": "دورية منتظمة, سلسلة (دورية تظهر في أوقات مجدولة)",
 "逐次化": "نشر متسلسل (النشر في شكل متسلسل)",
 "逐次印字装置": "طابعة الحروف المتسلسلة (طابعة تطبع حرفاً واحداً في كل مرة)",
 "逐次的": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)",
 "逐語的": "حَرْفًا بِحَرْفٍ, حَرْفِيًّا\nمثال: 英語を逐語的に日本語訳してはいけない。 — لا تترجم الإنجليزية إلى اليابانية حرفياً.",
 "逐電": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "逓伝": "سِبَاق تَتَابُع",
 "逓信": "اتصالات, علوم الاتصال (التخصص الذي يدرس مبادئ نقل المعلومات وطرق إيصالها (مثل المطبوعات أو الراديو أو التلفزيون وما إلى ذلك))\nمثال: الاتصالات هي مجال دراسته الرئيسي",
 "逓倍": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "逓倍器": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "逓次": "بالدور, على التوالي (في ترتيب أو تسلسل مناسب)\nمثال: تحدث إلى كل طفل بدوره",
 "逓送": "إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى) / ترويج, تعزيز (النهوض بمشروع ما)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً",
 "逓降変圧器": "محول خفض الجهد (محول يقلل الجهد)",
 "途": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "途につく": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "途に就く": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "途上": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "途上国": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "途中": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / منطقة الألعاب (المكان في معرض أو كرنفال حيث توجد العروض الجانبية ووسائل الترفيه المماثلة)\nمثال: كان في منتصف السلم عندما سقط",
 "途中下車": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "途中待機": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "途中棄権": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "途中経過": "تَقَدُّم / دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "途中降機": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "途切らす": "قَاطَعَ",
 "途切らせる": "قَاطَعَ",
 "途切れ": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "途切れがち": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / مَخْلُوع, مَفْصُول (منفصل عند المفصل؛ متخلّع) / مَفْصُول, مُفَكَّكُ المَفَاصِل (مَفْصُول عِنْدَ المَفَاصِل)",
 "途切れ途切れ": "مَكْسُور",
 "途子": "زُقَاق / مُفْتَرَق, تَقَاطُع",
 "途方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "途方もない": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "途方も無い": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "途端": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "途端に": "بينما, في الوقت الذي (في نفس الوقت الذي)\nمثال: بينما كان يحتضر، تجادلوا حول تركته",
 "途絶": "إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان",
 "途絶え": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "途絶える": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "途轍もない": "مُسْرِف / ضَخْم, هَائِل",
 "逗留": "مَكَثَ, بَقِيَ / إِقَامَة",
 "逗留客": "مقيم مؤقت (ساكن مؤقت)",
 "這々": "بِارْتِبَاك, بِتَشَوُّش (بطريقة مرتبكة)\nمثال: كتبت له الملكة أوغوستا رسالة هستيرية تعاطفت معه فيها بارتباك",
 "這々の体": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "這いずる": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم) / حظيرة صغار الحيوانات (حظيرة مسيجة بحيث يمكن لصغار الحيوانات دخولها ولكن لا يمكن للكبار ذلك) / زحف (حركة طولية بطيئة أو تشوه بطيء) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "這い上がる": "هَزَمَ, غَلَبَ",
 "這い上る": "هَزَمَ, غَلَبَ / تسلق بصعوبة (تسلق محرج أو صعب)\nمثال: كان الوصول إلى القمة تسلقاً صعباً",
 "這い登る": "تسلق بصعوبة (تسلق محرج أو صعب)\nمثال: كان الوصول إلى القمة تسلقاً صعباً",
 "這う": "زَحَفَ, دَبَّ (تَقَدَّمَ على الأرضِ معتمداً على بطنه دون استخدامٍ للأطراف؛ الشيءُ: تَقَدَّمَ ببطءٍ نحو الأمامِ)\nمثال: زحف سامي عبر نافذته. / تلوّي, تململ (عملية التلوّي أو التململ) / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مَسْلَك (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: اضطررت إلى جر سامي.",
 "這う這うの体": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "這般": "هٰذِهِ, هٰؤُلَاءِ",
 "這裏": "دَاخِل / في غضون (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / فِي خِلَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "這這": "بِارْتِبَاك, بِتَشَوُّش (بطريقة مرتبكة)\nمثال: كتبت له الملكة أوغوستا رسالة هستيرية تعاطفت معه فيها بارتباك",
 "這這の体": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "通": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة. / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / قدرة سحرية (القدرة على أداء السحر)",
 "通い": "تنقل للعمل (سفر المتنقل للعمل) / دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "通い帳": "دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "通い船": "مُعَدِّيَة, عَبَّارَة",
 "通い路": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "通う": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / شَبِهَ / مَاثَلَ",
 "通し": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة) / يبقي",
 "通し切符": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "通し券": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "通し矢": "بَعِيد المَدَى (مُناسِب لِلوُصول إلى مَسافات بَعيدَة) / بَعِيد المَدَى (يَشْمَل فَتْرَة زَمَنِيَّة مُمْتَدَّة)",
 "通し稽古": "بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "通じ": "حَرَكَة / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "通じて": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق. / طَوَال / عُمُومًا / بِوَجْهٍ عَامّ",
 "通じる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / تَدَفُّق / تَدَفَّقَ, سَالَ / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / تَآمَرَ, اِئْتَمَرَ",
 "通じ薬": "مُلَيّن",
 "通す": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "通ずる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)\nمثال: すべての道はローマに通ず。 — كل الطرق تؤدي إلى روما. / تَدَفُّق / تَدَفَّقَ, سَالَ / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / تَآمَرَ, اِئْتَمَرَ",
 "通り": "شَارِع, زَنَقَة / مُرُور / تَدَفُّق / تَدَفَّقَ, سَالَ / إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ) / وَفْقًا لِ / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة / شَارِع, زَنَقَة",
 "通りいっぺん": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / شَكْلِيّ, صُورِيّ (يُؤَدَّى أَوْ يُنْتَجُ كَإِجْرَاءٍ شَكْلِيٍّ فَحَسْبُ) / فُرْصَة",
 "通りがかり": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "通りすぎる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "通りぬける": "اِخْتَرَقَ, نَفَذَ",
 "通り一遍": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / شَكْلِيّ, صُورِيّ (يُؤَدَّى أَوْ يُنْتَجُ كَإِجْرَاءٍ شَكْلِيٍّ فَحَسْبُ) / فُرْصَة",
 "通り合わせる": "صَادَفَ (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "通り名": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في وثائق تأسيسها) / اسم مستعار (اسم تم انتحاله)",
 "通り抜ける": "اِخْتَرَقَ, نَفَذَ",
 "通り掛かり": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "通り掛け": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "通り掛り": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "通り言葉": "حكمة, مثل (قول مكثف ولكنه لا ينسى يجسد حقيقة مهمة من التجربة يعتبرها الكثير من الناس صحيحة) / رطانة, لغة اصطلاحية (مصطلحات تقنية متخصصة مميزة لموضوع معين) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص)) / جارغون (نوع عديم اللون (أو أصفر شاحب أو دخاني) من الزركون)\nمثال: هم لا يتحدثون لغتنا",
 "通り過ぎる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "通り道": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "通り雨": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "通り魔": "سلاح قاطع (سلاح (سيف أو خنجر) يستخدم للقطع) / مشطب (شخص يجرح شخصاً آخر (بآلة حادة))",
 "通り魔的": "عَشْوَائِيّ",
 "通る": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / اِخْتَرَقَ / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "通事": "مُتَرْجِم, مُتَرْجِمَة",
 "通人": "شخص راق, شخص محنك (شخص حكيم دنيوياً)",
