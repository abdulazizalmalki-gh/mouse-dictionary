 "追加・削除": "تَنْقِيح / تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "追加削除": "تَنْقِيح / تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "追加接種": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى)",
 "追加的": "إِضَافِيّ (إِضافيّ : ما يُضاف ، ما يُزاد؛ ما يُتْبَع شيئاً آخر ، ما يُلْحَق به ، ما يُزاد على الأصل)\nمثال: ستعطيني بطانية إضافية.",
 "追加額": "إكسسوار, تكملة (مكون إضافي يحسن القدرة أو الأداء) / إضافة, تحسين (مكون يضاف إلى شيء لتحسينه) / إضافة برمجية, مكون إضافي (وحدة برمجية تعمل على توسيع أو تعزيز قدرات تطبيق موجود)\nمثال: كانت إضافة الحمام تحسيناً كبيراً",
 "追及": "تَحْقِيق / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه)\nمثال: كانت تقود بشكل جيد لكن تجاوزها المتهور لكل سيارة على الطريق أخافني",
 "追啓": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "追尾": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "追帳": "ثَمَانِيَة, تمانية / ثَمَانِيَةٌ",
 "追弔": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "追従": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "追従者": "تَابِع / مُتَابِع / ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "追徴金": "رسم إضافي (رسم إضافي (كما هو الحال بالنسبة للعناصر التي تم حذفها سابقاً أو كعقوبة لعدم ممارسة الحذر العام أو المهارة العامة))",
 "追悼": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "追悼の辞": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "追悼碑": "نُصْب / نُصْب تَذْكَارِيّ",
 "追想": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "追憶": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "追懐": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "追手": "مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد) / سَاعٍ, طَالِب (شخص يسعى وراء خطة أو هدف)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل / مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد) / سَاعٍ, طَالِب (شخص يسعى وراء خطة أو هدف)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل / رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة)",
 "追抜き": "تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه)\nمثال: كانت تقود بشكل جيد لكن تجاوزها المتهور لكل سيارة على الطريق أخافني / مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "追撃": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "追放": "نَفْي, تَبْعِيد / نَفَى / حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "追放者": "نَفْي, تَبْعِيد / نَفَى",
 "追散らす": "طَرَدَ",
 "追求": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "追求める": "لَاحَقَ / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع)\nمثال: اتبع قلبك فحسب.",
 "追熟": "انقطاع الطمث, سن اليأس (الوقت في حياة المرأة الذي تنتهي فيه الدورة الشهرية) / إياس, سن اليأس للرجال (فترة في حياة الرجل تقابل سن اليأس)",
 "追白": "مُلَاحَظَة",
 "追究": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "追立てる": "أَجْلَى, طَرَدَ",
 "追而書": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "追而書き": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "追落し": "إقالة, خلع (فعل طرد شخص ما أو إجباره على الخروج (من منصب))",
 "追落とし": "إقالة, خلع (فعل طرد شخص ما أو إجباره على الخروج (من منصب))",
 "追行": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "追補": "ملحق / مُكَمِّل",
 "追複曲": "الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد",
 "追記": "مُلَاحَظَة / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "追試": "إعادة إنتاج, استنساخ (فعل عمل نسخ) / تكرار التجربة (تكرار تجربة لاختبار صحة استنتاجها) / مجسم, نسخة مطابقة (نسخة ليست الأصل؛ شيء تم نسخه) / تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير",
 "追認": "إبرام, تصديق (جعل الشيء ساري المفعول عن طريق التصديق عليه أو تأكيده رسميًا)\nمثال: المصادقة على المعاهدة",
 "追走": "طَارَدَ",
 "追越": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "追越し": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "追越車線": "الحارة السريعة, المسار السريع (الحارة المرورية للمركبات التي تتحرك بسرعة) / إيقاع سريع, حياة صاخبة (نمط حياة محموم ومضغوط يتميز غالباً بالتهور أو التبديد)\nمثال: الحياة في المسار السريع للموضة علمتها الكثير",
 "追跡": "طَارَدَ / تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما) / رسم تتبعي, شف (فعل رسم مخطط أو تصميم أو مسودة عن طريق الشف) / رسم شفاف, شف (رسم تم إنشاؤه بوضع ورقة نصف شفافة على الصورة الأصلية ونسخ خطوط الصورة الأصلية عليها)\nمثال: تتبع الأنساب",
 "追跡プログラム": "برنامج تتبع (برنامج خدمي يعرض تسلسل ونتائج تنفيذ التعليمات في برنامج آخر)",
 "追跡者": "مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد) / سَاعٍ, طَالِب (شخص يسعى وراء خطة أو هدف)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "追跡調査": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "追蹤": "طَارَدَ",
 "追込み": "مَعْرِض, صَالَةُ عَرْض / سِيَاقَة, قِيَادَة",
 "追追": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "追録": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "追随": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "追随を許さない": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "追随性": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "追随者": "شماس مساعد, مساعد الكاهن (شخص يساعد الكاهن أو القس في الخدمة الليتورجية؛ رجل دين مرسوم في أعلى الرتب الصغرى في الكنيسة الكاثوليكية الرومانية)",
 "追風": "رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة)",
 "退かす": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "退く": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / اِسْتَقَالَ / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / اِسْتَقَالَ / انحسار, جزر (التدفق الخارجي للمد) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد)) / اِسْتَقَالَ",
 "退ける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / طَرَدَ",
 "退け時": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "退っ引き": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "退っ引きならぬ": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "退任": "تَقَاعُد",
 "退任展": "متعلِّق بالماضي, رَجْعِيّ",
 "退会": "اِنْسِحَاب",
 "退位": "تنازل عن العرش (فعل التنازل عن العرش) / تنازل عن العرش, تنحي (استقالة رسمية وتنازل عن السلطات)",
 "退修会": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "退出": "ذهاب, رحيل (فعل المغادرة)",
 "退勢": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "退化": "انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط) / انحطاط, تدهور (عملية التراجع من مستوى أعلى إلى مستوى أدنى من القوة الفعالة أو الحيوية أو الجودة الأساسية) / انحلال, تدهور (حالة كونه منحطاً في الصفات العقلية أو الأخلاقية) / ارتداد, تراجع (العودة إلى حالة سابقة) / انحدار, انحدار إحصائي / نكوص ((في الطب النفسي) آلية دفاع تهرب فيها من الواقع عن طريق افتراض حالة أكثر طفولية) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "退化次数": "بطلان, حكم بالبطلان (شيء باطل (خاصة تشريع ليس له شرعية قانونية)) / عدم, لاشيء (حالة عدم الوجود)",
 "退却": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "退去": "رَحِيل, مُغَادَرَة / تَرَاجُع",
 "退去強制": "طَرْد",
 "退団": "ذهاب, رحيل (فعل المغادرة)",
 "退場": "ذهاب, رحيل (فعل المغادرة) / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "退嬰": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "退嬰主義": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "退嬰的": "مُحَافِظ",
 "退学": "إِقَالَة",
 "退学処分": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "退屈": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "退廃": "نَخْر / اضمحل / تضعضع / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "退廃的": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "退形成性": "كشمي (من أو متعلق بالكشم (فقدان التمايز الخلوي))",
 "退役軍人": "جندي سابق, محارب قديم (شخص ذكر خدم في القوات المسلحة)",
 "退所": "ذهاب, رحيل (فعل المغادرة)",
