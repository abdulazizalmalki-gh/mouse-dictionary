 "自責点": "ركضة مكتسبة (ركضة لم تُسجل نتيجة لخطأ من الفريق الآخر)",
 "自費": "مِنَ الجَيْب, نَقْدِيّ (يستلزم إنفاق مال نقديّ مباشر)",
 "自賛": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "自走": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه)",
 "自走式": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه)",
 "自走砲": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه)",
 "自足": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自身": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "自身番": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "自車学": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自車校": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自転": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة",
 "自転車": "دَرَّاجَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة…)\nمثال: كين يريد دراجة.",
 "自転車をこぐ": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "自転車を漕ぐ": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "自転車タクシー": "ريكشو دراجة, عربة نقل بدواسات (دراجة ثلاثية العجلات (تدفع عادة بالتدويس)؛ تستخدم في الشرق لنقل الركاب بالأجرة)\nمثال: الأولاد الذين كانوا يسحبون الريكشو سابقاً يركبون الآن دراجات الريكشو",
