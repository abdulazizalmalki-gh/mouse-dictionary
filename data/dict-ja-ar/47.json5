 "軒輊": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "軛": "فَدَّان / نِير / متطلب",
 "軟": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "軟ら": "جُودُو",
 "軟らか": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "軟らかい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / مُؤَدَّب / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / مَرِن",
 "軟らかさ": "نُعُومَة",
 "軟マンガン鉱": "بيرولوسيت (معدن يتكون من ثاني أكسيد المنغنيز؛ مصدر مهم للمنغنيز)",
 "軟体動物": "رِخْوِيّ",
 "軟体動物学": "علم الرخويات (فرع علم الحيوان الذي يدرس بنية وسلوك الرخويات)",
 "軟体生物": "رِخْوِيّ",
 "軟化": "مُلَطِّف, مُلَيِّن (يُنَعِّم ويُلَيِّن البَشَرَة أو الأنْسِجَة) / تليين (عملية التحول إلى شيء أكثر ليونة)\nمثال: أخر التبريد تليين الفاكهة / إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف)",
 "軟化剤": "ملين, منعم (مادة تضاف إلى مادة أخرى لجعلها أقل صلابة)",
 "軟化症": "تلين (حالة من التلين غير الطبيعي للأنسجة)",
 "軟口蓋": "حَنَك رَخُو ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "軟口蓋音": "طَبَقِيّ",
 "軟式": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "軟式飛行船": "مُنْطَاد ذُو مُحَرِّك",
 "軟弱": "ضَعِيف / عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "軟弱外交": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "軟弱者": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "軟性": "نُعُومَة",
 "軟文学": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "軟木": "خشب لين (خشب يسهل نشره (من الصنوبريات مثل الصنوبر أو التنوب))",
 "軟材": "خشب لين (خشب يسهل نشره (من الصنوبريات مثل الصنوبر أو التنوب))",
 "軟毛": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / بلوغ (وقت الحياة الذي تصبح فيه الغدد الجنسية وظيفية)",
 "軟水": "ماء يسر (ماء ليس عسراً (لا يحتوي على أملاح معدنية تتداخل مع تكوين الرغوة مع الصابون))",
 "軟泥": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / رُسَابَة",
 "軟派": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة) / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا. / دُبّ / دُبَّة / اِحْتَمَلَ",
 "軟派師": "هراسة (أداة مطبخ تستخدم للهرس (مثل البطاطس)) / زير نساء, ملاحق النساء (رجل عدواني في التودد للنساء وملاحقتهن)",
 "軟炭": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "軟玉": "نيفرِيت, يشم نيفريت (معدن أمفيبولي يتكون من سيليكات الكالسيوم والمغنيسيوم في شكل بلوري أحادي الميل؛ مصدر لليشم (أقل قيمة من الجاديت)؛ كان يعتقد قديماً أنه يعالج اضطرابات…)",
 "軟石けん": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية) / كلام معسول, ملاطفة (تملق مصمم لكسب الرضا)",
 "軟石鹸": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية) / كلام معسول, ملاطفة (تملق مصمم لكسب الرضا)",
 "軟禁": "إِقَامَة جَبْرِيَّة",
 "軟禁状態": "إِقَامَة جَبْرِيَّة",
 "軟腐病": "عفن طري (تحلل طري أو لزج للنباتات تسببه البكتيريا أو الفطريات)",
 "軟膏": "مَرْهَم, دَهُون",
 "軟膏剤": "مَرْهَم, دَهُون",
 "軟膜": "الأم الحنون",
 "軟調": "ضَعِيف / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "軟貨": "بَنْكْنُوت, وَرَقَة نَقْدِيَّة",
 "軟質": "نُعُومَة",
 "軟質ガラス": "زجاج لين (زجاج ذو نقطة تليين منخفضة نسبياً)",
 "軟質小麦": "قمح طري (قمح ذو حبات نشوية طرية يستخدم في المعجنات وحبوب الإفطار)",
 "軟質硝子": "زجاج لين (زجاج ذو نقطة تليين منخفضة نسبياً)",
 "軟鋼": "صلب طري, فولاذ لين (فولاذ يحتوي على أقل من 0.15% كربون)",
 "軟鑞": "لحام طري, لحام لين (سبيكة لحام تنصهر عند درجة حرارة منخفضة نسبياً)",
 "軟風": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "軟骨": "غُضْرُوف (مادة قاسية مرنة تُكوِّن هياكل أو أجزاء من هياكل الفقاريات. تُشكل غالبية هياكل الأجنة في معظم الفقاريات…) / غضروف (نسيج مرن قوي؛ يتحول معظمه إلى عظم عند البالغين)",
 "軟骨形成不全症": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى التقزم)",
 "軟骨無形成症": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى التقزم)",
 "軟骨腫": "ورم غضروفي (ورم حميد شائع يتكون من خلايا غضروفية)",
 "軟骨魚類": "سمكة غضروفية (أسماك قد يكون هيكلها متكلسًا ولكنه غير متعظم)",
 "転": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "転かす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "転がし": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة",
 "転がす": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / قَلَبَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "転がり出る": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "転がり込む": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "転がる": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "転ける": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / تماماً, مباشرة (بشكل كامل) / انهيار, سقوط (فعل رمي نفسك للأسفل؛ الانهيار؛ الغوص) / بصوت ارتطام, سقوطاً (مع صوت ارتطام) / إخفاق تام, فشل ذريع (فشل كامل)\nمثال: سقط مباشرة على وجهه",
 "転げる": "سقطة, وقعة (سقوط مفاجئ من وضعية الوقوف) / دحرجة, شقلبة (حركة بهلوانية تتضمن التدحرج أو الدوران)\nمثال: تعرض لسقطة سيئة على الجليد",
 "転じて": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "転じる": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "転す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "転ずる": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "転た": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "転た寝": "غفوة, نعاس (نوم خفيف متقطع)",
 "転てつ機": "مِقْلَاد",
 "転ばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "転ばぬ先の杖": "اَلْوِقَايَةُ خَيْرٌ مِنَ الْعِلَاجِ",
 "転び": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / منخفض, هابط (يصبح أقل أو أصغر في الدرجة أو القيمة) / مُتَرَاجِع, هَابِط (يتناقص في الكمّيّة أو الدرجة)\nمثال: سوق هابطة / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / رِدَّة, اِرْتِدَاد / عجين سائل (خليط سائل أو شبه سائل، مثل الدقيق والبيض والحليب، يستخدم في الطهي) / ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب)",
 "転び出る": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "転び寝": "غفوة, نعاس (نوم خفيف متقطع)",
 "転ぶ": "اِرْتَدَّ (عن كذا: رجع عنه مردودا؛ عن الاسلام: رجع إلى الكفر بعد أن أسلم)\nمثال: ارتد سترة، فالجو بارد. / دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "転位": "تغيير المقام, نقل موسيقي ((موسيقى) العزف بمقام مختلف عن المقام المقصود؛ تحريك طبقة الصوت لمقطوعة موسيقية لأعلى أو لأسفل) / عكس, قلب (فعل عكس الترتيب أو المكان) / تبادل المواقع ((كهرباء) إعادة ترتيب المواقع النسبية لخطوط الطاقة لتقليل تأثيرات السعة والحث المتبادل) / نقل ((رياضيات) نقل كمية من أحد جانبي المعادلة إلى الجانب الآخر مع تغيير الإشارة)\nمثال: كتب كتابًا دراسيًا عن التأثيرات الكهربائية لتبادل المواقع",
 "転作": "دَوْرَة زِرَاعِيَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "転倒": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "転借": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "転入": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "転写": "كَرْشَنَة, نَقْصَوَة",
 "転写紙": "ورق نقل (ورق مطلي بمستحضر لنقل تصميم إلى سطح آخر)",
 "転出": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "転化": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "転化糖": "سكر محول, سكر منقلب (خليط من أجزاء متساوية من الجلوكوز والفركتوز ناتج عن التحلل المائي للسكروز؛ يوجد طبيعياً في الفواكه؛ وهو أكثر حلاوة من الجلوكوز)",
 "転向": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "転向者": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "転回": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / شقلبة أمامية على اليدين, قفزة اليدين (حركة بهلوانية ينتقل فيها الشخص من وضع الوقوف إلى الوقوف على اليدين ثم يعود للوقوف مرة أخرى) / عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "転回形": "عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "転売": "إِعَادَةُ بَيْع",
 "転売ヤー": "مُوَزِّع",
 "転売屋": "مُوَزِّع",
 "転変": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "転嫁": "إلصاق تهمة, اتهام (العزو إلى مصدر أو سبب (غالباً بشكل سلبي)) / إسناد تهمة, إلصاق تهمة (بيان ينسب شيئاً غير نزيه (خاصة جريمة جنائية))\nمثال: الاتهام بأن نجاحي كان بسبب المحسوبية عنى أنني لم أُؤخذ على محمل الجد / إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى)",
 "転子": "مدور (أحد النتوءات العظمية التي تنمو بالقرب من الطرف العلوي لعظم الفخذ والتي تتصل بها العضلات)",
 "転寝": "غفوة, نعاس (نوم خفيف متقطع)",
 "転居": "مُتَحَرِّك / مُؤَثِّر",
 "転帰": "نَتِيجَة",
 "転座": "إزفاء, انتقال كروموسومي ((علم الوراثة) تبادل أجزاء الكروموسوم) / نقل (نقل المواد المذابة داخل النبات)\nمثال: يمكن أن تؤدي الانتقالات الكروموسومية إلى اضطرابات خلقية خطيرة",
 "転成": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "転所": "انتقال, تغير الموقع (حركة عبر الفضاء تغير موقع شيء ما)",
 "転折": "تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "転換": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "転換期": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "転換点": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "転換社債": "سند قابل للتحويل (سند يمكن تحويله إلى أوراق مالية أخرى في ظل ظروف معينة)",
 "転換社債型新株予約権付社債": "سند قابل للتحويل (سند يمكن تحويله إلى أوراق مالية أخرى في ظل ظروف معينة)",
 "転機": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "転流": "إزفاء, انتقال كروموسومي ((علم الوراثة) تبادل أجزاء الكروموسوم) / نقل (نقل المواد المذابة داخل النبات)\nمثال: يمكن أن تؤدي الانتقالات الكروموسومية إلى اضطرابات خلقية خطيرة / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "転炉": "محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "転生": "تَنَاسُخُ الأَرْوَاحِ",
 "転用": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "転瞬": "طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "転石": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها)",
 "転社": "سند قابل للتحويل (سند يمكن تحويله إلى أوراق مالية أخرى في ظل ظروف معينة)",
 "転移": "مُتَحَرِّك / مُؤَثِّر / انتشار الورم, نقلة (انتشار مرض (وخاصة السرطان) إلى جزء آخر من الجسم) / تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "転移性": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "転移酵素": "ترانسفيراز (أي من الإنزيمات المختلفة التي تنقل مجموعة كيميائية من مركب إلى مركب آخر)",
 "転移ＲＮＡ": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "転置": "تغيير المقام, نقل موسيقي ((موسيقى) العزف بمقام مختلف عن المقام المقصود؛ تحريك طبقة الصوت لمقطوعة موسيقية لأعلى أو لأسفل) / عكس, قلب (فعل عكس الترتيب أو المكان) / تبادل المواقع ((كهرباء) إعادة ترتيب المواقع النسبية لخطوط الطاقة لتقليل تأثيرات السعة والحث المتبادل) / نقل ((رياضيات) نقل كمية من أحد جانبي المعادلة إلى الجانب الآخر مع تغيير الإشارة)\nمثال: كتب كتابًا دراسيًا عن التأثيرات الكهربائية لتبادل المواقع",
 "転置行列": "منقول المصفوفة (مصفوفة تتشكل عن طريق تبديل الصفوف والأعمدة لمصفوفة معطاة)",
 "転舵": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "転落": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "転覆": "فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت / أَطَاحَ",
 "転記": "إرسال بالبريد (إرسال رسالة عبر البريد) / قيد محاسبي ((مسك الدفاتر) إدراج في سجلات الشركة) / إعلان ورقي, ملصق (لافتة منشورة في مكان عام كإعلان)\nمثال: يشير ختم البريد إلى وقت الإرسال",
 "転訛": "فَسَاد",
 "転調": "تحوير",
 "転貸": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "転路器": "مِقْلَاد",
 "転路手": "عامل التحويلة (رجل يقوم بتشغيل محولات (تحويلات) السكك الحديدية)",
 "転蹶": "عَثْرَة / تَلَعْثَمَ (اضطرب في كلامه) / عَثَرَ",
 "転身": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "転載": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "転轍手": "عامل التحويلة (رجل يقوم بتشغيل محولات (تحويلات) السكك الحديدية)",
 "転轍機": "مِقْلَاد",
 "転送": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "転送処理": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة)",
 "転送時間": "وقت الإرسال (التوقيت العالمي المنسق عند إرسال بث من الأرض إلى مركبة فضائية أو جرم سماوي آخر)",
 "転送電話": "تحويل المكالمات (يتيح لك تحويل مكالماتك الواردة إلى أي هاتف يمكنك الاتصال به مباشرة)",
 "転進": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
