 "遺言": "إرَادَة / رَغْبَة, إرَادَة",
 "遺言信託": "ائتمان وصائي (ائتمان ينشأ بموجب وصية ويصبح نشطاً بعد وفاة المانح)",
 "遺言執行者": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية.",
 "遺言書": "إرَادَة / رَغْبَة, إرَادَة",
 "遺言状": "إرَادَة / رَغْبَة, إرَادَة",
 "遺言者": "مُوصٍ (شخص يكتب وصية)",
 "遺言補足書": "ملحق وصية (ملحق لوصية؛ صك وصية يهدف إلى تغيير وصية تم تنفيذها بالفعل)",
 "遺財": "إيصاء, ميراث ((قانون) هبة لممتلكات شخصية بموجب وصية)",
 "遺贈": "إيصاء, ميراث ((قانون) هبة لممتلكات شخصية بموجب وصية)",
 "遺跡": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "遺骨": "رَمَاد, سَكَن / دَرْدَار / جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "遺骸": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "遼": "سلالة لياو, لياو (السلالة التي حكمت جزءاً كبيراً من منشوريا وشمال شرق الصين من 947 إلى 1125)",
 "遼遠": "بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "遽然": "مُبَاغِت, مُفَاجِئ",
 "避く": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "避け": "حِمَايَة",
 "避けては通れない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "避けて通れない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "避ける": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري / يَدْرَأ",
 "避る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "避妊": "منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "避妊ピル": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "避妊リング": "لولب رحمي (جهاز لمنع الحمل يتكون من قطعة من البلاستيك أو المعدن المثني يتم إدخالها عبر المهبل إلى الرحم)",
 "避妊具": "مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "避妊薬": "مَانِع لِلْحَمْل (قادر على منع الحمل أو الإخصاب) / مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "避寒": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات الحَرَارَة)\nمثال: ولد في فصل الشتاء.",
 "避忌": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً",
 "避暑": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "避止": "اِمْتِنَاع, إِمْسَاك",
 "避退": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "避難": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "避難口": "كوة نجاة, مخرج طوارئ (فتحة توفر وسيلة للهروب في حالات الطوارئ)",
 "避難地": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "避難場": "مَلْجَأ, مَلَاذ",
 "避難所": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "避難民": "مُرَحَّل",
 "避難者": "مُرَحَّل",
 "避難階段": "مخرج طوارئ",
 "避雷針": "مَانِعَة صَوَاعِق",
 "邀撃": "اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "邀撃機": "طائرة اعتراضية, معترضة (طائرة مقاتلة سريعة وقادرة على المناورة مصممة لاعتراض طائرات العدو)",
 "邁進": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "邂逅": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "還る": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "還付": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "還付金": "إِعَادَة مَال",
 "還俗": "عَلْمَنَة",
 "還元": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / نَقْص",
 "還元主義": "اختزالية (تحليل الأشياء المعقدة إلى مكونات أبسط) / اختزالية (نظرية تفيد بأن الأنظمة المعقدة يمكن فهمها بالكامل من حيث مكوناتها)",
 "還元分裂": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده)) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "還元剤": "عامل مختزل, مختزل (مادة قادرة على إحداث اختزال لمادة أخرى بينما تتأكسد هي نفسها؛ تستخدم في التصوير الفوتوغرافي لتقليل كثافة السالب أو المطبوعة عن طريق أكسدة بعض الفضة…)",
 "還元酵素": "ريدوكتاز (إنزيم يحفز الاختزال الكيميائي الحيوي لبعض المواد المحددة)",
 "還府金": "إِعَادَة مَال",
 "還御": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "還流": "انحسار, جزر (التدفق الخارجي للمد) / ارتجاع, جزر (تدفق غير طبيعي لسوائل الجسم إلى الخلف)",
 "還流冷却器": "مكثف ارتجاعي (مكثف يتم فيه تكثيف البخار فوق سائل يغلي فيتدفق مرة أخرى إلى الوعاء لمنع جفاف محتوياته من الغليان)",
 "還送": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "邌る": "اِسْتِعْرَاض, مَوْكِب",
 "邏卒": "شرطي (عضو ذكر في قوة الشرطة)",
 "邑々": "حَزِين, زعلان / مُحْزِنٌ",
 "邑落": "هَامْلِت",
 "邑邑": "حَزِين, زعلان / مُحْزِنٌ",
 "那覇": "نَاهَا",
 "那辺": "أَيْن, فين / حَيْثُ",
 "邦国": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "邦土": "حَيِّز",
 "邦家": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "邦文": "يَابَانِيّ",
 "邦語": "يَابَانِيّ",
 "邪": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "邪宗": "هَرْطَقَة, بِدْعَة / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "邪悪": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "邪推": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين) / توجس, ريبة (شك في نزاهة شخص ما)",
 "邪教": "هَرْطَقَة, بِدْعَة",
 "邪曲": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "邪気": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد. / ميازما, وخم (أبخرة غير صحية تتصاعد من الأرض أو من مصادر أخرى) / جو فاسد, ميازما (جو غير صحي)\nمثال: وخم المستنقعات",
 "邪法": "هَرْطَقَة, بِدْعَة / سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "邪淫": "شَبَق",
 "邪眼": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "邪術": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "邪視": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "邪道": "هَرْطَقَة, بِدْعَة",
 "邪険": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "邪鬼": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "邪魔": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "邪魔くさい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "邪魔だて": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "邪魔っけ": "إِزْعَاج",
 "邪魔っ気": "إِزْعَاج",
 "邪魔にならない": "غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "邪魔を入れる": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "邪魔ッけ": "إِزْعَاج",
 "邪魔ッ気": "إِزْعَاج",
 "邪魔物": "عَقَبَة, حَاجِز / إِزْعَاج",
 "邪魔立て": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "邪魔者": "عَقَبَة, حَاجِز / إِزْعَاج",
 "邪魔臭い": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "邯鄲": "صرصور الشجر (صرصور أمريكي شجري شاحب يشتهر بصريره العالي)",
 "邸": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "邸内": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "邸宅": "مَجْلِس",
 "郁々": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "郁郁": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "郊外": "ضَاحِيَة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "郊外居住者": "ساكن الضاحية (مقيم في ضاحية)",
 "郎": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "郎党": "تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي)",
 "郎君": "شاب (مراهق أو شاب بالغ ذكر) / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "郎女": "صبية",
