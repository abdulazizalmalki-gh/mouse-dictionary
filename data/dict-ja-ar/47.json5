 "遅らす": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遅らせる": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遅れ": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遅ればせ": "مُتَأَخِّر, مُتَلَكِّئ (بعد الوقت المتوقّع أو المعتاد؛ مُؤَجَّل)",
 "遅ればせながら": "بشكل متأخر, متأخراً (في وقت لاحق عن المعتاد أو المتوقع)\nمثال: وصل القطار متأخراً",
 "遅れる": "تَأَخَّرَ",
 "遅れを取る": "تَأَخَّرَ",
 "遅れ咲き": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "遅れ馳せ": "مُتَأَخِّر, مُتَلَكِّئ (بعد الوقت المتوقّع أو المعتاد؛ مُؤَجَّل)",
 "遅れ馳せながら": "بشكل متأخر, متأخراً (في وقت لاحق عن المعتاد أو المتوقع)\nمثال: وصل القطار متأخراً",
 "遅刻": "تأخر (صفة المجيء متأخراً أو في وقت لاحق)\nمثال: 遅刻するのではないかと心配した。 — خشيت أن أتأخر.",
 "遅刻者": "قادم متأخراً, متأخر (شخص يصل متأخرًا)",
 "遅参": "تأخر (صفة المجيء متأخراً أو في وقت لاحق)",
 "遅咲き": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "遅延": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遅延処理": "احترام, توقير (تعبير مهذب (بالقول أو الفعل) عن التقدير) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين) / احترام, توقير (مراعاة مهذبة لمشاعر الناس)\nمثال: كان توقيره لرغباتها ممتعاً للغاية",
 "遅延線": "خط تأخير (دائرة مصممة لإدخال تأخير محسوب في نقل الإشارة)",
 "遅智慧": "إدراك متأخر (فهم طبيعة حدث ما بعد وقوعه)\nمثال: الإدراك المتأخر دائماً أفضل من التوقع",
 "遅桜": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "遅滞": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遅滞なく": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "遅滞無く": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "遅疑": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "遅疑逡巡": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "遅発性": "مُتَأَخِّر (لم يبلغ المستوى الطبيعي من التطور)",
 "遅発性ウイルス": "فيروس بطيء (فيروس يظل خاملاً في الجسم لفترة طويلة قبل ظهور الأعراض)\nمثال: مرض كورو يسببه فيروس بطيء",
