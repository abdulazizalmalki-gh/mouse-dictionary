 "通過": "مُرُور / عُبُور / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "通過儀礼": "طَقْس الْعُبُور",
 "通過判定": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "通過点": "حَاجِز, نُقْطَة تَفْتِيش",
 "通過者": "مَارّ, مَارَّة",
 "通達": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "通釈": "تَفْسِير, شَرْح",
 "通風": "تَهْوِيَة",
 "通風口": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "通風孔": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "通風機": "مِرْوَحَة",
 "逝く": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "逝去": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "逞しい": "ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية) / عَصِيّ, لَا يُرْوَض (مُسْتَحِيلُ الإِخْضَاعِ أَوِ التَّطْوِيعِ) / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "速": "ترس, عجلة مسننة (عجلة مسننة تتعشق مع آلية مسننة أخرى لتغيير سرعة أو اتجاه الحركة المنقولة) / تجهيزات, عُدَّة (معدات تتكون من مواد متنوعة لازمة لعملية معينة أو رياضة وما إلى ذلك) / آلية تروس, ترس (آلية لنقل الحركة لغرض محدد (مثل ترس التوجيه في السيارة)) / مجموعة تروس, نظام نقل الحركة (آلية عجلات تتكون من مجموعة متصلة من التروس الدوارة التي يتم من خلالها نقل القوة أو تغيير الحركة أو عزم الدوران)\nمثال: علق ربطة عنق الأحمق في مجموعة التروس",
 "速い": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "速く": "بِسُرْعَة, عَاجِلًا",
 "速さ": "سُرْعَة / تبكير (صفة المجيء مبكراً أو في وقت أسبق)",
 "速まる": "أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "速め": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "速めに": "قبل الأوان, مبكراً (قبل الوقت المعتاد أو المتوقع)\nمثال: تخرجت مبكراً",
 "速める": "يقرب / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "速やか": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "速わかり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "速乾性": "سَرِيع الجَفَاف (مادّة سائلة تجفّ بسرعة)",
 "速写": "صورة فورية, لقطة سريعة (صورة غير رسمية؛ تُلتقط عادة بكاميرا صغيرة محمولة باليد)\nمثال: لم يتم تحميض صوري الفورية بعد",
 "速分かり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "速力": "سُرْعَة",
 "速力度": "سُرْعَة",
 "速報": "بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري))",
 "速度": "سُرْعَة / سُرْعَة, سُرْعَة مُتَّجِهَة (المسافة المقطوعة لكل وحدة زمنية)",
 "速度制限": "حَدّ اَلسُّرْعَة اَلْأُقْصَى, حَدّ اَلسُّرْعَة (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "速度落とせ": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "速度規制": "حَدّ اَلسُّرْعَة اَلْأُقْصَى, حَدّ اَلسُّرْعَة (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "速度計": "عَدَّادُ السُّرْعَة",
 "速度違反": "إسراع, سرعة (تغيير الموقع بسرعة)",
 "速急": "فَوْرِيّ",
 "速成法": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد)",
 "速成科": "حَلَقَة دِرَاسِيَّة مُكَثِّفَة",
 "速戦即決": "حَرْب خَاطِفَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "速攻": "هجوم خاطف ((كرة السلة) اندفاع سريع للحصول على تسديدة في أقرب وقت ممكن بعد الاستحواذ على الكرة) / فَوْرًا, حَالًا",
 "速業": "مَأْثَرَة",
 "速歩": "سير سريع (المسير بتوقيت سريع) / خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "速球": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة",
 "速目": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "速目に": "قبل الأوان, مبكراً (قبل الوقت المعتاد أو المتوقع)\nمثال: تخرجت مبكراً",
 "速耳": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "速記": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر)",
 "速記文字": "آلة الاختزال (آلة لكتابة أحرف الاختزال) / رمز اختزال, ستينوغراف (حرف من حروف الاختزال)",
 "速記符号": "آلة الاختزال (آلة لكتابة أحرف الاختزال) / رمز اختزال, ستينوغراف (حرف من حروف الاختزال)",
 "速記者": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "速記術": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر)",
 "速足": "سير سريع (المسير بتوقيت سريع) / خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "速達": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "造り": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / سَاشِيمِي / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "造りつけ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "造りつける": "صَلَّحَ / أَصْلَحَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "造り上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / اِفْتَرَى, اِخْتَلَقَ",
 "造り主": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "造り付け": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "造り付ける": "صَلَّحَ / أَصْلَحَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "造り手": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / فَلَّاح, فَلَّاحَة",
 "造り替える": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "造り物": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / زينة / مَحْصُول / حَوْصَلة",
 "造り花": "زهرة اصطناعية (تقليد مصنوع يدوياً لزهرة)",
 "造り込み": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة",
 "造り込む": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "造る": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "造作": "مُشْكِلَة, مَتاعِب / كَرَم, إِكْرَام / ضِيَافَة / بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء. / تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة) / لَائِق, مُنَاسِب (مطابق تماماً وصحيح) / مَعْقُول, مُلَائِم (يتناغم مع روح الأشخاص أو المناسبة المعنيّة) / تجهيزات, مستلزمات ((عادة بصيغة الجمع) المفروشات والمعدات (خاصة لسفينة أو فندق))",
 "造作ない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "造作なく": "بِسُهُولَة",
 "造作もない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "造作もなく": "بِسُهُولَة",
 "造作も無い": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "造作も無く": "بِسُهُولَة",
 "造作無い": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "造作無く": "بِسُهُولَة",
 "造兵廠": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "造化": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "造卵器": "أرشيجونة, عضو التأنيث (عضو جنسي أنثوي يوجد في الحزازيات والسراخس ومعظم عاريات البذور)",
 "造反": "ثَوْرَة, تَمَرُّد",
 "造反者": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "造営": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "造営物": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "造園": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "造型": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "造山運動": "تَكَوُّنُ الجِبَالِ",
 "造幣": "اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً) / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة)",
 "造幣局": "نَعْنَاع, نعناع",
 "造形": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "造影剤": "مادة تباين, وسط تباين (مادة معتمة للأشعة السينية؛ عند إعطائها تسمح لأخصائي الأشعة بفحص العضو أو الأنسجة التي تملؤها)",
 "造成": "إِعْمَار, تَعْمِير",
 "造替": "إخصاء, تعقيم الحيوانات (تعقيم الحيوان)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء",
 "造本": "تجليد",
 "造林": "تشجير (تحويل الأراضي الجرداء أو المزروعة إلى غابة (أصلاً لغرض الصيد))",
 "造林学": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "造次": "عَزْم / لَحْظَة, دَقِيقَة",
 "造次顛沛": "عَزْم / لَحْظَة, دَقِيقَة",
 "造水": "تَقْطِير, إِعْذَاب",
 "造物": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "造物主": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "造石高": "خَمَّرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "造立": "إقامة, انتصاب (فعل البناء أو الرفع لأعلى)",
 "造精器": "مئبرية, معفر (العضو الجنسي الذكري للنباتات المنتجة للأبواغ؛ ينتج الحيوانات المنوية النباتية؛ يعادل المئبر في الزهور)",
 "造胞体": "طور بوغي, نابت بوغي (الفرد أو الطور المنتج للأبواغ في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "造船": "بناء السفن (عملية بناء وصناعة السفن)",
 "造船台": "طريق سفن, قناة ملاحية (قناة كبيرة بما يكفي للسفن المبحرة في المحيطات) / مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو إصلاحها)",
 "造船家": "باني سفن (عمل تجاري يبني ويصلح السفن) / باني سفن (شخص يبني السفن كعمل تجاري) / بناء السفن, نجار سفن (نجار يساعد في بناء وإطلاق السفن الخشبية)",
 "造船所": "ترسانة بحرية, حوض بناء السفن (مكان عمل يتم فيه بناء السفن أو إصلاحها)",
 "造船業": "صناعة بناء السفن (صناعة تقوم ببناء السفن)",
 "造花": "زهرة اصطناعية (تقليد مصنوع يدوياً لزهرة)",
 "造苑": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "造血": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "造血幹細胞": "خلية جذعية مكونة للدم (خلايا جذعية مكونة للدم في نخاع العظم؛ تنشأ منها الخلايا التائية والبائية)",
 "造言": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "造設": "تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة)",
 "造詣": "بلوغ, وصول (الوصول إلى مرحلة جديدة) / إدراك, تحقيق (عملية تحقيق هدف أو غاية) / إنجاز, اكتساب (قدرة تم اكتسابها عن طريق التدريب)\nمثال: تأخر بلوغه سن الرشد بسبب سوء التغذية",
 "造詣深い": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "造語": "اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً) / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة)",
 "造語症": "مُوَلَّدَة / تَوْلِيد",
 "逡巡": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "逢い引き": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / لِقَاء سِرِّيّ, مَوْعِد غَرَامِيّ (مواعدة سرية (خاصة بين العشاق))\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "逢い見る": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "逢う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "逢う魔が時": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "逢引": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / لِقَاء سِرِّيّ, مَوْعِد غَرَامِيّ (مواعدة سرية (خاصة بين العشاق))\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "逢引き": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / لِقَاء سِرِّيّ, مَوْعِد غَرَامِيّ (مواعدة سرية (خاصة بين العشاق))\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "逢瀬": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء",
 "逢着": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "逢魔が時": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "逢魔時": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "連": "مَقْطَع, بَيْت / قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة. / تَنَبَّأَ / تَوَقُّع / طَرَف / حَفْلَة, اِحْتِفَال",
 "連々": "مُتَوَاصِل, مُتَّصِل",
 "連なり": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "連なる": "مَدَّدَ / اِمْتَدَّ / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "連ねる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / وَصْلَة",
 "連れ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "連れこむ": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "連れて": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "連れていく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "連れてゆく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "連れて行く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "連れ去り": "اِخْتِطَاف",
 "連れ去る": "يَخْطِفّ",
 "連れ合う": "تَزَوَّجَ",
 "連れ子": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "連れ込む": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "連チャン": "تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / خصلة, مسحة (سمة مميزة) / خيط البرق, شعاع (وميض مفاجئ (كالبرق)) / سلسلة, فترة متصلة (سلسلة غير منقطعة من الأحداث)\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "連ツイ": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "連中": "سَرِيَّة / شَرِكَة / فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "連体格": "حَالَة اَلْمُضَاف إِلَيْهِ, مَجْرُور",
 "連作": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "連係": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "連係プレー": "عَمَل جَمَاعِيّ (عمل تعاوني يقوم به فريق (خاصة عندما يكون فعالاً))\nمثال: سيتطلب الأمر المال والتخطيط الجيد، وقبل كل شيء، العمل الجماعي",
 "連分数": "كَسْر مُسْتَمِرّ (كسر بسطه عدد صحيح ومقامه عدد صحيح زائد كسر بسطه عدد صحيح ومقامه عدد صحيح زائد كسر وهكذا)",
 "連判状": "عَرِيضَة, طَلَب",
 "連動性": "ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية)",
 "連動機": "إمساك, قبضة (فعل الإمساك) / دبرياج, قابض (قارنة تربط أو تفصل الأجزاء الدافعة والمدفوعة لآلية القيادة) / دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة) / حقيبة يد صغيرة, كلاتش (حقيبة نسائية بدون حمالات تُحمل في اليد)\nمثال: أرخى قبضته عن ذراعي",
 "連動装置": "تداخل, تشابك (فعل التشابك أو التداخل) / جهاز منع التشغيل, قفل تعشيق (جهاز يمنع محرك السيارة من البدء)\nمثال: تشابك أذرع الشرطة أبقى الحشد تحت السيطرة",
 "連勝": "سلسلة انتصارات (فترة متصلة من الانتصارات)",
 "連勝単式": "إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "連勝式": "تَنَبَّأَ / تَوَقُّع",
 "連単": "إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "連去る": "يَخْطِفّ",
 "連句": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "連合": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي! / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "連合会": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "連合体": "اِتِّحَادِيَّة, فِدِرَالِيَّة",
 "連合作戦": "عملية مشتركة (عملية عسكرية تنفذ بالتعاون بين دولتين حليفتين أو أكثر أو عملية عسكرية تنفذ بتنسيق القوات البحرية والبرية والجوية)",
 "連合国": "الْحُلَفَاء",
 "連合国最高司令官総司令部": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "連合国総司令部": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "連合国軍最高司令官総司令部": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "連合王国": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "連合軍": "الْحُلَفَاء",
 "連合野": "منطقة الترابط (مناطق قشرية ليست حركية ولا حسية ولكن يُعتقد أنها تشارك في المعالجة العليا للمعلومات)",
 "連吟": "با دو دو, رقص ثنائي ((في الباليه) رقصة لشخصين (عادة راقصة باليه وراقص نبيل)) / ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً)\nمثال: الخطيبان",
 "連坐": "تَلَازُم",
 "連声": "سَنْدْهِي, وَصْل",
 "連子": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق) / شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن)",
 "連字": "شعار, لوغو (شعار أو رمز لشركة)",
 "連山": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "連峯": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "連峰": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "連帯": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية. / مُشْتَرَك / مِفْصَل",
 "連帯債務": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "連帯責任": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "連年": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "連座": "تَلَازُم",
 "連想": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "連想配列": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "連打": "قصف مركز, وابل (النار الكثيفة للمدفعية لإشباع منطقة بدلاً من ضرب هدف محدد) / تدفق, وابل (التدفق السريع والمستمر للتواصل اللغوي (المنطوق أو المكتوب))\nمثال: أطلقوا وابلاً من النيران أمام القوات المتقدمة",
 "連接": "صِلَة, صُلَة / عَلَاقَة, صِلَة / وَصْلَة",
 "連接的": "مُلْتَحِم, مُتَرَابِط",
 "連接都市": "تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "連携": "تَعَاوُن / مُكَامَلَة",
 "連携プレー": "عَمَل جَمَاعِيّ (عمل تعاوني يقوم به فريق (خاصة عندما يكون فعالاً))\nمثال: سيتطلب الأمر المال والتخطيط الجيد، وقبل كل شيء، العمل الجماعي / تَعَاوُن",
 "連日": "يَوْمًا بَعْدَ يَوْم",
 "連星": "نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)",
 "連星系": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "連架": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "連枷": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "連母音": "مُصَوِّت مُزْدَوِج",
 "連珠形": "اللمنيسكات, منحنى الثمانية (أي من المنحنيات الجبرية المستوية التي تكون على شكل الرقم ثمانية)",
 "連環": "ملعب غولف ساحلي (ملعب غولف مبني على أرض رملية بالقرب من الشاطئ)",
 "連発": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة / ضربة طائرة (رد تنس يتم بضرب الكرة قبل ارتدادها) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية)\nمثال: فاجأتهم رشقنا من الجناح الأيسر",
 "連発銃": "سلاح ناري متكرر الرمي (سلاح ناري يمكنه إطلاق عدة طلقات دون إعادة تلقيم)",
 "連盟": "عُصْبَة, اِتِّحَاد / دَوْرِيّ (لُفِّي؛ اسْتَدِيرِي)\nمثال: كان دوري كي أنظف المسكن",
 "連立": "تَحَالُف, اِئْتِلَاف",
 "連立方程式": "معادلات آنية, نظام معادلات (مجموعة من المعادلات في متغيرين أو أكثر توجد لها قيم يمكن أن تحقق جميع المعادلات في وقت واحد)",
 "連累": "تواطؤ (الذنب كشريك في جريمة أو مخالفة)",
 "連結": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "連結器": "رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة",
 "連結性": "اتصال, ترابط (خاصية كون الشيء متصلاً أو الدرجة التي يمتلك بها الشيء اتصالات)",
 "連結網": "ويب",
 "連結網表示": "مَنْظَر, مَشْهَد",
 "連結詞": "رَابِطَة, رَابِط",
 "連絡": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "連絡を入れる": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "連絡を絶つ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "連絡事項": "رِسَالَة, خَبَر",
 "連絡員": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "連絡船": "مُعَدِّيَة, عَبَّارَة",
 "連絡通路": "دهليز, ممر (ممر بين الغرف أو بين المباني) / ممر (مسار أو قناة أو مجرى يمكن أن يمر عبره أو من خلاله شيء ما)\nمثال: الممرات الأنفية",
 "連絡道路": "طريق فرعي, مدخل طريق (طريق قصير يتيح الوصول إلى طريق سريع)",
 "連続": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / إطالة, تمديد (نتيجة إطالة المدة) / الاستمرارية الجيدة, قانون الاستمرارية (مبدأ تنظيم غيشتالتي ينص على وجود ميل فطري لإدراك الخط كاستمرار لاتجاهه المحدد) / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / مُتَوَاصِل, مُتَّصِل",
 "連続体": "استمرارية, متصل (كل مستمر غير مكاني أو مدى أو تتابع لا يكون فيه أي جزء أو قسم متميزاً أو قابلاً للتمييز عن الأجزاء المجاورة)",
 "連続性": "استمرار, ثبات (خاصية فترة زمنية مستمرة ومتصلة) / الكونتنيويتي, نص التتابع (نص مفصل يستخدم في صنع الأفلام لتجنب الانقطاع بين اللقطات) / استمرارية, تواصل (اتصال أو اتحاد غير منقطع)",
 "連続技": "فرقة جاز, كومبو (فرقة صغيرة من موسيقيي الجاز)",
 "連続殺人犯": "قَاتِل مُتَسَلْسِل, قَاتِلَة مُتَسَلْسِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة)\nمثال: بيتي قاتلة أمك.",
 "連続殺人鬼": "قَاتِل مُتَسَلْسِل, قَاتِلَة مُتَسَلْسِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة)\nمثال: بيتي قاتلة أمك.",
 "連続的": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع) / بِالتَّتَابُع, بِالتَّسَلْسُل (بطريقة تسلسلية) / مُتَتَالٍ, مُتَعَاقِب (مُتَتَابِعٌ دُونَ انْقِطَاع) / مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)\nمثال: رقمنا الأوراق بالتتابع",
 "連綿": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "連繋": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "連荘": "تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / خصلة, مسحة (سمة مميزة) / خيط البرق, شعاع (وميض مفاجئ (كالبرق)) / سلسلة, فترة متصلة (سلسلة غير منقطعة من الأحداث)\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "連行": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة",
 "連衡": "تَحَالُف, اِتِّحَاد",
 "連言": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "連記": "إدراج, سرد (فعل عمل قائمة بالعناصر) / قائمة (قاعدة بيانات تحتوي على مصفوفة مرتبة من العناصر (أسماء أو موضوعات))",
 "連語": "كلمة مركبة, مركب (كلمة تتكون من أي مجموعة متنوعة من الكلمات أو الصيغ التركيبية أو اللواحق) / رَابِطَة, رَابِط",
 "連載": "نشر متسلسل (النشر في شكل متسلسل)",
 "連載小説": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات) / تَتَابُعِيّ, تَسَلْسُلِيّ (يتعلق بالتنفيذ المتتابع لعمليات متعددة) / تسلسلي (يخص أو يحدث في أو ينتج سلسلة) / تسلسلي (يخص أو مؤلف بتقنية تسلسلية (في الموسيقى))\nمثال: زواج أحادي متسلسل",
 "連辞": "رَابِطَة, رَابِط",
 "連通": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "連連": "مُتَوَاصِل, مُتَّصِل",
 "連邦": "اِتِّحَادِيَّة, فِدِرَالِيَّة",
 "連邦主義": "اتحادية, فيدرالية (فكرة التنظيم الفيدرالي لوحدات تتمتع بحكم ذاتي إلى حد ما)",
 "連邦制度": "اتحادية, فيدرالية (فكرة التنظيم الفيدرالي لوحدات تتمتع بحكم ذاتي إلى حد ما)",
 "連邦取引委員会": "لجنة التجارة الفيدرالية (وكالة مستقلة تابعة للحكومة الفيدرالية الأمريكية تحافظ على المنافسة العادلة والحرة؛ تطبق قوانين مكافحة الاحتكار الفيدرالية؛ وتثقف الجمهور حول سرقة…)",
 "連邦国家": "دَوْلَةٌ اِتِّحَادِيَّة, وِلَايَةٌ اِتِّحَادِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "連邦捜査局": "مكتب التحقيقات الفيدرالي (وكالة إنفاذ قانون فيدرالية تعد ذراع التحقيق الرئيسي لوزارة العدل)",
 "連邦政府": "حُكُومَة اَلاِتِّحَادِيَّة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "連邦政府裁判所": "محكمة فيدرالية (محكمة أنشأتها سلطة حكومة فيدرالية)",
 "連邦政府関係機関": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "連邦最高裁判所": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "連邦準備制度": "الاحتياطي الفيدرالي, الفيدرالي (البنك المركزي للولايات المتحدة؛ يضم 12 بنكاً فرعياً للاحتياطي الفيدرالي وجميع البنوك الوطنية والبنوك التجارية المرخصة من الدولة وبعض شركات الائتمان)\nمثال: يسعى الفيدرالي للسيطرة على اقتصاد الولايات المتحدة من خلال رفع وخفض أسعار الفائدة قصيرة الأجل والمعروض النقدي",
 "連邦準備制度理事会": "مجلس الاحتياطي الفيدرالي (المجلس المكون من سبعة أعضاء الذي يحكم نظام الاحتياطي الفيدرالي)",
 "連邦準備理事会": "مجلس الاحتياطي الفيدرالي (المجلس المكون من سبعة أعضاء الذي يحكم نظام الاحتياطي الفيدرالي)",
 "連邦準備銀行": "بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "連邦王国": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "連邦直轄地": "مُقَاطَعَة فِدِرَالِيَّة",
 "連邦管区": "مُقَاطَعَة فِدِرَالِيَّة",
 "連邦航空管理局": "إدارة الطيران الفيدرالية (وكالة في وزارة النقل مسؤولة عن سلامة الطيران المدني)",
 "連邦裁判所": "محكمة فيدرالية (محكمة أنشأتها سلطة حكومة فيدرالية)",
 "連邦貿易委員会": "لجنة التجارة الفيدرالية (وكالة مستقلة تابعة للحكومة الفيدرالية الأمريكية تحافظ على المنافسة العادلة والحرة؛ تطبق قوانين مكافحة الاحتكار الفيدرالية؛ وتثقف الجمهور حول سرقة…)",
 "連邦通信委員会": "لجنة الاتصالات الفيدرالية (وكالة حكومية مستقلة تنظم الاتصالات بين الولايات والاتصالات الدولية عبر الراديو والتلفزيون والأسلاك والكابلات والأقمار الصناعية)",
 "連銀": "بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "連鎖": "سِلْسِلَة / ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية)",
 "連鎖反応": "تَفَاعُل مُتَسَلْسِل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "連鎖店": "متجر ضمن سلسلة (واحد من سلسلة متاجر بيع بالتجزئة تحت نفس الإدارة وتبيع نفس البضائع)",
 "連鎖状球菌": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "連鎖球菌": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "連鎖球菌性咽頭炎": "التهاب الحلق العقدي (عدوى في البلعوم الفموي واللوزتين بواسطة المكورات العقدية)",
 "連鎖的": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)",
 "連鎖群": "جينات مرتبطة, مجموعة ارتباط (أي زوج من الجينات يميل إلى الانتقال معاً)",
 "連関": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "連隊": "فَوْج",
 "連雀": "جناح الشمع (طيور مغردة ذات ريش مخملي بني في نصف الكرة الشمالي لها رؤوس متوجة وأطراف أجنحة شمعية حمراء)",
 "連音": "سَنْدْهِي, وَصْل / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / تَكْرِير",
 "逮捕": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "逮捕令状": "أمر قبض, مذكرة توقيف (مذكرة تخول مسؤولي إنفاذ القانون بالقبض على الجاني وإحضاره إلى المحكمة)",
 "逮捕歴": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "逮捕状": "أمر قبض, مذكرة توقيف (مذكرة تخول مسؤولي إنفاذ القانون بالقبض على الجاني وإحضاره إلى المحكمة)",
 "週": "أُسْبُوع / جُمْعَة (مجموعة، قبضة أو كمية صغيرة؛ جمعةٌ من تمر، أي قبضة منهُ) / اسبوع / إسبوع / أُسبوع / سيمانة\nمثال: اليوم هو الجمعة.",
 "週刊誌": "أُسْبُوعِيًّا / أُسْبُوعِيٌّ",
 "週別": "أُسْبُوعِيًّا / أُسْبُوعِيٌّ",
 "週日": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "週期": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "週末": "نِهَايَة الْأُسْبُوع, عَطْلَة الْأُسْبُوع",
 "週次": "أُسْبُوعِيًّا / أُسْبُوعِيٌّ",
 "週間": "أُسْبُوع / جُمْعَة (مجموعة، قبضة أو كمية صغيرة؛ جمعةٌ من تمر، أي قبضة منهُ) / اسبوع / إسبوع / أُسبوع / سيمانة\nمثال: اليوم هو الجمعة.",
 "進ずる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "進ぜる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "進び": "تَسْلِيَة",
 "進み": "تَقَدُّم",
 "進み出る": "مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "進む": "يقرب / سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / تَقَدَّمَ, مَضَى (التحرك للأمام؛ السفر قدماً في الزمان أو المكان)\nمثال: تقدمنا نحو واشنطن / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "進める": "يقرب / أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "進め方": "تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "進んで": "بِإِرَادَتِه, طَوَاعِيَة (بمحض إرادته الحرة)\nمثال: خضع طواعية لأخذ البصمات",
 "進上": "مِعْطَاء",
 "進上物": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "進入": "إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل",
 "進入禁止": "مَمْنُوع الدُّخُولُ",
 "進入路": "طريق فرعي, مدخل طريق (طريق قصير يتيح الوصول إلى طريق سريع) / مسار الاقتراب, مسار الانزلاق (المسار النهائي الذي تتبعه الطائرة أثناء هبوطها)",
 "進出": "يقرب\nمثال: その会社は中国への進出を目指している。 — تهدف الشركة إلى فتح فروع في الصين. / يقرب",
 "進化": "تَطَوُّر",
 "進化を遂げる": "طَوَّرَ",
 "進化主義": "تطورية, نظرية التطور ((أحياء) نظرية علمية لأصل أنواع النباتات والحيوانات)",
 "進化生物学": "علم الأحياء التطوري (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "進化発生学": "علم الأحياء النمائي التطوري (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "進化的に安定な戦略": "إِس",
 "進化論": "نَظَرِيَّة التَّطَوُّر (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "進化論者": "تطوري (شخص يؤمن بالتطور العضوي)",
 "進取": "مبادر, مقدام (يتميز بالخيال والمبادرة والاستعداد للقيام بمشاريع جديدة)\nمثال: سياسة خارجية مقدامة",
 "進取的": "مبادر, مقدام (يتميز بالخيال والمبادرة والاستعداد للقيام بمشاريع جديدة)\nمثال: سياسة خارجية مقدامة",
 "進呈": "إِرَاءَة / إِهْدَاء, مَنْح",
 "進塁": "يقرب",
 "進境": "تَقَدُّم",
 "進学塾": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "進展": "تَقَدُّم",
 "進度": "تَقَدُّم",
 "進捗": "تَقَدُّم",
 "進捗報告": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "進撃": "يقرب",
 "進撃命令": "عتاد المسير (تجهيزات للمسير)\nمثال: كانت السرية مجهزة بكامل عتاد المسير",
 "進攻": "حَمْلَة / هَاجَمَ",
 "進数": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "進歩": "تَقَدُّم",
 "進歩主義": "تقدمية (التوجه السياسي لمن يفضلون التقدم نحو ظروف أفضل في الحكومة والمجتمع)",
 "進歩党": "الحزب التقدمي, حزب بول موس (حزب سياسي سابق في الولايات المتحدة؛ أسسه ثيودور روزفلت خلال الحملة الرئاسية لعام 1912؛ كان شعاره صورة لحيوان الموظ)",
 "進歩性": "اِخْتِرَاع",
 "進歩的": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "進水": "إطلاق, قذف (فعل الدفع بقوة) / إطلاق سفينة, تدشين (فعل تحريك سفينة مبنية حديثاً إلى الماء لأول مرة) / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "進物": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "進物所": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ.",
 "進発": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "進級": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "進行": "تَقَدُّم / مُتَتَالِيَة",
 "進行中": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "進行係": "ميسّر (شخص يجعل التقدم أسهل)",
 "進行形": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "進行役": "ميسّر (شخص يجعل التقدم أسهل)",
 "進行性": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "進行性骨化性線維異形成症": "خلل التنسج الليفي المعظم المترقي (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "進行波": "موجة متنقلة, موجة مسافرة (موجة يتحرك فيها الوسط في اتجاه انتشار الموجة)",
 "進行相": "مُسْتَمِرّ, هَيْئَة تَقَدُّمِيَّة (جهة الفعل التي تعبر عن حدث جارٍ)",
 "進言": "نَصِيحَة, مَشُورَة",
 "進路": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "進路変更": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "進軍": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "進退": "حَرَكَة / مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد",
 "進運": "تَقَدُّم",
 "進達": "إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى) / ترويج, تعزيز (النهوض بمشروع ما)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً / يقرب",
 "進駐": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "逶迤": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "逶迱": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "逸": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "逸す": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "逸する": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "逸らす": "أَزْعَجَ / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "逸り気": "نَفَاد صَبْر",
 "逸る": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "逸る気持ち": "حَمَاس, حَمَاسَة",
 "逸れる": "شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي) / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "逸事": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "逸出": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف. / تَقَدُّم",
 "逸品": "تُحْفَة, رَائِعَة",
 "逸失": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "逸楽": "مُتْعَة, لَذَّة",
 "逸民": "متقاعد (شخص تقاعد من العمل النشط)",
 "逸物": "بشكل ممتاز, على ما يرام (بشكل جيد جداً) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "逸脱": "إِنْحِرَاف / إِغْفَال",
 "逸言": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "逸話": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "逸走": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "逸足": "سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "逸遊": "مُتْعَة, لَذَّة",
 "逼塞": "إِقَامَة جَبْرِيَّة",
 "逼迫": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة) / خسة, شح (بخل شديد) / اِكْتِظَاظ, تَرْكِيز (الخاصية المكانية للازدحام أو التكدس معاً) / انقباض, ضيق (شعور بالضيق في جزء من الجسم)\nمثال: شعر بانقباض في صدرها",
 "遁れ": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "遁走": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "遁走曲": "فُوغَا",
 "遁辞": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "遂": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / أَبَدًا",
 "遂げる": "أَدَّى",
 "遂に": "أَخِيراً / أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "遂行": "تَنْفِيذ",
 "遅々": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "遅い": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "遅かれ早かれ": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "遅く": "مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا / بِبُطْء",
 "遅し": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "遅す": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "遅まきながら": "بشكل متأخر, متأخراً (في وقت لاحق عن المعتاد أو المتوقع)\nمثال: وصل القطار متأخراً",
