 "ステーツマン": "رَجُل دَوْلَة (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "ステーツマンシップ": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "ステート": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "ステートメント": "تَصْرِيح, بَيَان",
 "ステートレス": "بِلَا وَطَن, عَدِيم الجِنْسِيَّة (بلا جنسية أو مواطنة)",
 "ステーブル": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "ステープラー": "دَبَّاسَة",
 "ステープル": "أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / سلع أساسية (سلعة ضرورية يكون الطلب عليها ثابتاً) / دبوس دباسة / مسمار مشبك (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)",
 "ステープルファイバー": "ألياف أساسية, تيلة (ألياف طبيعية (قطن خام، صوف، قنب، كتان) يمكن غزلها لتشكيل خيوط)\nمثال: تتفاوت الألياف الأساسية بشكل كبير في الطول",
 "ステープル・ファイバー": "ألياف أساسية, تيلة (ألياف طبيعية (قطن خام، صوف، قنب، كتان) يمكن غزلها لتشكيل خيوط)\nمثال: تتفاوت الألياف الأساسية بشكل كبير في الطول",
 "スト": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "ストさんかしゃ": "ضارب, مطرقة (الجزء من جهاز ميكانيكي الذي يضرب شيئاً ما) / ضارب (شخص يضرب) / مُضرِب (موظف مضرب عن العمل ضد صاحب العمل) / متدرب بحري (شخص يتلقى تدريباً مكثفاً للحصول على تصنيف فني بحري)\nمثال: ضارب قوي",
 "ストやぶり": "كاسر الإضراب (شخص يعمل (أو يوفر عمالاً) أثناء الإضراب)",
 "ストア": "خَزَنَ (حفظ، إدخر، أودع في مخزن) / رِوَاقِيّ / جَلِد, رَزِين (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "ストアしゅぎ": "رِوَاقِيَّة",
 "ストアフロント": "واجهة المتجر (الجانب الأمامي لمتجر يواجه الشارع؛ يحتوي عادة على نوافذ عرض)",
 "ストアー": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "ストア主義": "رِوَاقِيَّة",
 "ストイシズム": "رِوَاقِيَّة",
 "ストイチズム": "رِوَاقِيَّة",
 "ストイック": "رِوَاقِيّ / جَلِد, رَزِين (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / مُنْضَبِط ذَاتِيًّا (يُستخدم عن الأشخاص غير المُتساهلين مع أنفسهم)",
 "ストゥーパ": "سْتُوبَا",
 "ストッキング": "جَوْرَب",
 "ストック": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / قرنفل, قرنفل شائع (نبات أوراسي ذو زهور وردية إلى أرجوانية حمراء برائحة التوابل وعادة ما تكون مزدوجة؛ يزرع على نطاق واسع في العديد من الأصناف والألوان) / جلي فلاور, منثور (أي من عدة نباتات من العالم القديم تزرع لزهورها زاهية الألوان) / عصا التزلج (عمود ذو أطراف معدنية يستخدم كعامل مساعد في التزلج) / عَصَايَة, خَيْزُرَانَة",
 "ストックオプション": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "ストックカー": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً) / سيارة مخزنة (سيارة محفوظة في مخزون التجار للبيع المنتظم)",
 "ストックカーレース": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً) / سيارة مخزنة (سيارة محفوظة في مخزون التجار للبيع المنتظم)",
 "ストックブローカー": "سمسار بورصة, وسيط أوراق مالية (وكيل في بيع وشراء الأسهم والسندات)",
 "ストックホルダー": "حامل أسهم, مساهم (شخص يمتلك حصصاً من الأسهم في شركة مساهمة)",
 "ストックホルム": "سْتُوكْهُولْم, إِسْتُوكْهُولْم",
 "ストックヤード": "حظيرة مواشي (ساحة مسيجة حيث يتم الاحتفاظ بالماشية أو الخنازير أو الخيول أو الأغنام مؤقتاً)",
 "ストック・オプション": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "ストック・カー": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً) / سيارة مخزنة (سيارة محفوظة في مخزون التجار للبيع المنتظم)",
 "ストック・カー・レース": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً) / سيارة مخزنة (سيارة محفوظة في مخزون التجار للبيع المنتظم)",
 "ストッティング": "سن, شوكة (نتوء مدبب)",
 "ストッパー": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام) / مانع, ورقة حاكمة ((في البريدج) ورقة لعب ذات قيمة عالية تكفي لضمان الفوز بالجولة في نقش معين) / قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم",
 "ストップ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ストップウォッチ": "سَاعَةُ سِبَاق, سَاعَةُ إِيقَاف (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "ストップウオッチ": "سَاعَةُ سِبَاق, سَاعَةُ إِيقَاف (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "ストップオーバー": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "ストップモーション": "إِيقَاف الْحَرَكَة",
 "ストップライト": "إشارة المرور, ضوء المرور (إشارة بصرية للتحكم في تدفق حركة المرور عند التقاطعات) / ضوء التوقف, ضوء الفرامل (ضوء أحمر في الجزء الخلفي من المركبة يشير إلى استخدام الفرامل للإبطاء أو التوقف)",
 "ストマ": "فغرة (فم أو فتحة تشبه الفم (خاصة تلك التي يتم إنشاؤها جراحياً على سطح الجسم لإنشاء فتحة لعضو داخلي)) / ثغر, مسام (مسام بشروي دقيق في ورقة أو ساق يمكن للغازات وبخار الماء المرور من خلاله)",
 "ストマイ": "ستربتوميسين",
 "ストマック": "مَعِدَة, مِعْدَة",
 "ストライカー": "ضارب, مطرقة (الجزء من جهاز ميكانيكي الذي يضرب شيئاً ما) / ضارب (شخص يضرب) / مُضرِب (موظف مضرب عن العمل ضد صاحب العمل) / متدرب بحري (شخص يتلقى تدريباً مكثفاً للحصول على تصنيف فني بحري)\nمثال: ضارب قوي",
 "ストライキ": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "ストライク": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "ストライクゾーン": "منطقة الضربة ((في البيسبول) المنطقة فوق القاعدة الرئيسية بين ركبتي الضارب وكتفيه والتي يجب أن تمر الرمية خلالها ليتم احتسابها ضربة (سترايك))",
 "ストライク・ゾーン": "منطقة الضربة ((في البيسبول) المنطقة فوق القاعدة الرئيسية بين ركبتي الضارب وكتفيه والتي يجب أن تمر الرمية خلالها ليتم احتسابها ضربة (سترايك))",
 "ストライダー": "مسرع الخطى (شخص يمشي بسرعة بخطوات طويلة)",
 "ストライド": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً')) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / خطوة (المسافة التي تغطيها خطوة)\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "ストライピング": "تقليم (فعل وضع خطوط مقلمة)",
 "ストライプ": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة) / تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / صنف, طينة (نوع أو فئة (من الناس أو التوجهات)) / شارة الرتبة, شريط رتبة\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "ストライプドバス": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / قاروص مقلم (يصاد على طول ساحل المحيط الأطلسي للولايات المتحدة)",
 "ストライプド・バス": "قاروص مخطط (سمكة طعام وصيد بحرية ذات خطوط طولية داكنة؛ تهاجر عكس تيار النهر لوضع البيض) / قاروص مقلم (يصاد على طول ساحل المحيط الأطلسي للولايات المتحدة)",
 "ストラクチャ": "هَيْكَل",
 "ストラクチャー": "هَيْكَل",
 "ストラグル": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "ストラックアウト": "خروج بالضربات, سترايك آوت (خروج ناتج عن حصول الضارب على ثلاث ضربات (سترايك))",
 "ストラッグル": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "ストラップ": "رِبَاط",
 "ストラップレス": "بِلَا أَشْرِطَة, بِلَا حَمَّالَات (ليس له أشرطة أو حمالات) / فستان بلا حمالات (رداء نسائي يكشف الكتفين وليس له حمالات كتف)",
 "ストラテジスト": "استراتيجي, خبير استراتيجي (خبير في الاستراتيجية (خاصة في الحرب))",
 "ストラテジー": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "ストランド": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "ストリキニン": "ستريكنين (سم قلويدي نباتي يستخرج بشكل رئيسي من الجوز المقيئ؛ كان يستخدم سابقاً كمنبه)",
 "ストリキニーネ": "ستريكنين (سم قلويدي نباتي يستخرج بشكل رئيسي من الجوز المقيئ؛ كان يستخدم سابقاً كمنبه)",
 "ストリッパー": "بئر ناضب (بئر نفط انخفض إنتاجه إلى أقل من عشرة براميل يومياً) / راقصة تعري, متعرية (فنانة تقدم ترفيهاً مثيراً بخلع الملابس على أنغام الموسيقى) / نازع العروق (عامل ينزع السيقان من أوراق التبغ المرطبة ويربط الأوراق معاً) / مزيل الطلاء (مركب كيميائي يستخدم لإزالة الطلاء أو الورنيش)",
 "ストリップ": "تعري, رقص التعري (شكل من أشكال الترفيه الإيروتيكي حيث يخلع الراقص ملابسه تدريجياً على أنغام الموسيقى)\nمثال: قامت بعرض تعري أمام الجميع مباشرة / تعرية, كشف (إزالة الغطاء) / شَرِيط / قِطَاع / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ストリップショウ": "تعري, رقص التعري (شكل من أشكال الترفيه الإيروتيكي حيث يخلع الراقص ملابسه تدريجياً على أنغام الموسيقى)\nمثال: قامت بعرض تعري أمام الجميع مباشرة",
 "ストリップショー": "تعري, رقص التعري (شكل من أشكال الترفيه الإيروتيكي حيث يخلع الراقص ملابسه تدريجياً على أنغام الموسيقى)\nمثال: قامت بعرض تعري أمام الجميع مباشرة",
 "ストリップティーズ": "رَقْص تَعَرِيّ, اِسْتْرِبْتِيز (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "ストリップポーカー": "بوكر التعري, ستريب بوكر (بوكر يتم فيه دفع خسائر اللاعب عن طريق إزالة قطعة من الملابس)",
 "ストリップ・ショー": "تعري, رقص التعري (شكل من أشكال الترفيه الإيروتيكي حيث يخلع الراقص ملابسه تدريجياً على أنغام الموسيقى)\nمثال: قامت بعرض تعري أمام الجميع مباشرة",
 "ストリップ・ポーカー": "بوكر التعري, ستريب بوكر (بوكر يتم فيه دفع خسائر اللاعب عن طريق إزالة قطعة من الملابس)",
 "ストリング": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "ストリングオーケストラ": "أوركسترا وترية (أوركسترا تعزف الآلات الوترية فقط)",
 "ストリングス": "بند, شرط ((عادة بصيغة الجمع) بيان لما هو مطلوب كجزء من اتفاقية) / قسم الوتريات (قسم الأوركسترا الذي يعزف على الآلات الوترية)\nمثال: حدد العقد شروط الإيجار",
