 "ソルブ語": "صُورْبِيّ",
 "ソルベ": "شَرْبَات مُثَلَّج",
 "ソルベンシーマージン": "هَامِش الْمَلَاءَة (الفرق بين أصول وخصوم شركة تأمين معينة (مقدار زيادة الأصول عن الخصوم)، وينظمه القانون)",
 "ソルベンシー・マージン": "هَامِش الْمَلَاءَة (الفرق بين أصول وخصوم شركة تأمين معينة (مقدار زيادة الأصول عن الخصوم)، وينظمه القانون)",
 "ソレイユ": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / زَهْرَة اَلشَّمْس, دَوَّار اَلشَّمْس",
 "ソレノイド": "سولينويد, ملف لولبي (ملف من الأسلاك حول قلب حديدي؛ يصبح مغناطيساً عند مرور التيار عبر الملف)",
 "ソレル": "حُمَّاض بُسْتَانِيّ / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "ソロ": "منفرداً, وحده (دون أي شخص أو شيء آخر) / طيران منفرد (رحلة طيران يكون فيها الطيار غير مصحوب بأحد) / أداء منفرد, انفراد (أي نشاط يتم أداؤه بمفرده دون مساعدة) / فَرْدِيّ, مُنْفَرِد (مؤلَّف أو مُؤَدّى بصوت واحد أو آلة واحدة)\nمثال: بقي الطفل في المنزل وحده",
 "ソロっと": "قَرِيبًا, سَرْعَانَ مَا",
 "ソロイスト": "عازف منفرد (موسيقي يؤدي عزفاً منفرداً)",
 "ソロソロ": "قَرِيبًا, سَرْعَانَ مَا / بِبُطْء / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "ソロッと": "قَرِيبًا, سَرْعَانَ مَا",
 "ソロバン": "مِعَد, مِعْدَاد / نَاصِيَة (منبت شعر الغرّة الذي يقع فوق الجبهة مباشرة؛ عن شعر الغرّة) / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "ソロホーマー": "ركضة كاملة فردية, ضربة فردية ساحقة (ركضة كاملة (هوم ران) تتحقق عندما لا يكون هناك عدائون على القواعد)",
 "ソロモンしょとう": "جُزُر سُلَيْمَان (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ソロモン諸島": "جُزُر سُلَيْمَان (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ソロリ": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "ソロリソロリ": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "ソロ・ホーマー": "ركضة كاملة فردية, ضربة فردية ساحقة (ركضة كاملة (هوم ران) تتحقق عندما لا يكون هناك عدائون على القواعد)",
 "ソワカ": "لَا فُضَّ فُوكَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ソワソワ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "ソワニエ": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "ソワレ": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "ソング": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية. / زنوبَة, شِبْشِب",
 "ソングライター": "كاتب أغاني, مؤلف أغاني (مؤلف الكلمات أو الموسيقى للأغاني الشعبية)",
 "ソング・ライター": "كاتب أغاني, مؤلف أغاني (مؤلف الكلمات أو الموسيقى للأغاني الشعبية)",
 "ソンブレロ": "سومبريرو (قبعة قش ذات تاج عالٍ وحافة عريضة؛ تلبس في الجنوب الغربي الأمريكي وفي المكسيك)",
 "ソンムル": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "ソヴィエト": "سوفييت, سُوفْيَات / الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "ソヴィエトれんぽう": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "ソヴィエト連邦": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "ソー": "مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "ソーイング": "خِيَاطَة, حِيَاكَة",
 "ソーイングセット": "طقم خياطة, عدة خياطة (مجموعة من الأدوات المستخدمة في الخياطة)",
 "ソーイング・セット": "طقم خياطة, عدة خياطة (مجموعة من الأدوات المستخدمة في الخياطة)",
 "ソーガム": "ذُرَة, سرغوم",
 "ソーキング": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً",
 "ソークワクチン": "لقاح سالك (لقاح فيروس شلل الأطفال يتكون من فيروس غير نشط يتم حقنه تحت الجلد لتوفير المناعة ضد شلل الأطفال)",
 "ソーク・ワクチン": "لقاح سالك (لقاح فيروس شلل الأطفال يتكون من فيروس غير نشط يتم حقنه تحت الجلد لتوفير المناعة ضد شلل الأطفال)",
 "ソーサラー": "سَاحِر",
