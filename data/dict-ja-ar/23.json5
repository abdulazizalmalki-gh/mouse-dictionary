 "持出す": "أَخْرَجَ / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "持分": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "持前": "طَبِيعِيّ",
 "持参": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "持参金": "مَهْر",
 "持合": "وَحْدَة, اِتِّحَاد / مَسَكَ, مسك",
