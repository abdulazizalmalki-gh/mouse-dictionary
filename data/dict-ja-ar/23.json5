 "擬": "زائف",
 "擬い": "تَقْلِيد",
 "擬える": "قَلَّدَ",
 "擬く": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو. / قَلَّدَ",
 "擬す": "قَلَّدَ / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / قَارَنَ / شَبَّهَ",
 "擬する": "قَلَّدَ / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / قَارَنَ / شَبَّهَ",
 "擬人化": "تَجْسِيد",
 "擬人法": "تَجْسِيد",
 "擬人観": "تَجْسِيم",
 "擬似": "زَائِف, بَاطِل / كَاذِب / اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "擬似的": "مُتَصَنَّع, صِنَاعِيّ",
 "擬制": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "擬態": "مُشَاكهَة",
 "擬蠍": "عَقْرَب زَائِفَة, عَقْرَب مُزَيَّف",
 "擬製": "تَقْلِيد",
 "擬音": "مُؤَثِّر صَوْتِيّ",
 "擯斥": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "擱く": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "擲弾": "قُنْبُلَة, قُنْبُلَة يَدَوِيَّة",
 "擲弾発射筒": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "擲弾筒": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "擺つ": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك. / حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "擽り": "دَغْدَغَة / طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "攀援": "تَسَلَّقَ / شَعْبَطَة",
 "攀縁": "تَسَلَّقَ / شَعْبَطَة",
 "攣る": "تَشَنُّج, شَدٌّ عَضَلِيّ",
 "攣縮": "تَشَنُّج",
 "攪乱": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "攪乱者": "مُثِير لِلْمَشاكِل, مُثِير لِلْمَتَاعِب",
 "攪乳器": "مَخَاضَة",
 "攪拌": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "攪拌機": "خَلَّاط, خَفَّاقَة",
 "攫う": "اِحْتَكَرَ",
 "支": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "支う": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "支え": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "支える": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "支保工": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر) / خَشَب!\nمثال: نحن نقطع الخشب.",
 "支出": "صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / مَصَارِيف, تَكَالِيف\nمثال: أيمكنك صرف خمسين؟",
 "支出係": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
