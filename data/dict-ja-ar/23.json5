 "ジュー": "يَهُودِيّ, يَهُودِيَّة (صفة المنسوب إلى اليَهُود، سواء كان شخصا أو شيئا أو فكرة أو غيره؛ معتنق الديانة اليهودية)\nمثال: أنا يهودي أمريكي.",
 "ジュークボックス": "جُوكْبُوكْس",
 "ジューサー": "عَصَّارَة",
 "ジューシー": "عصيري, كثير العصارة (غني بالعصارة) / دَسِم, مُغْرٍ (مُربِح ومجزٍ ماليًّا) / فَاحِش, مُوحٍ بِالبَذَاءَة (يُلمّح إلى سلوك جنسيّ غير لائق) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية)",
 "ジュージュー": "أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة)",
 "ジュース": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / مَشْرُوب غَازِيّ / اثنان, دو (واحدة من أوراق اللعب الأربع في الحزمة التي تحمل نقطتين) / اللعنة, تباً (كلمة تستخدم في تعبيرات الارتباك أو التعجب) / اثْنَان (العدد الأصلي الذي هو مجموع واحد وواحد أو رمز يمثل هذا العدد) / تعادل (تعادل في التنس أو تنس الطاولة يتطلب الفوز بنقطتين متتاليتين للفوز باللعبة)\nمثال: يا إلهي!",
 "ジューズハープ": "القيثار الفكي, قيثارة اليهود (آلة موسيقية صغيرة على شكل قيثارة توضع بين الأسنان ويتم العزف عليها بنقر لسان سلكي مع تغيير شكل تجويف الفم)",
 "ジューズ・ハープ": "القيثار الفكي, قيثارة اليهود (آلة موسيقية صغيرة على شكل قيثارة توضع بين الأسنان ويتم العزف عليها بنقر لسان سلكي مع تغيير شكل تجويف الفم)",
 "ジュータン": "سَجَّادَة, بِسَاط",
 "ジューテリウム": "ديوتيريوم, هيدروجين ثقيل (نظير للهيدروجين يحتوي على نيوترون واحد (مقارنة بعدم وجود نيوترونات في الهيدروجين العادي))",
 "ジュート": "جوت",
 "ジューリー": "حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة (أو المقلدة))",
 "ジュール": "جُول (وحدة طاقة)\nمثال: عاد دانيال من جولة.",
 "ジュールクニチー": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ジューン": "يُونِيُو, حَزِيرَان (الشهر السادس في السنة الميلادية الغربية المعرّبة)\nمثال: ستتزوج ابنتي في يونيو",
 "ジューンベリー": "ساسكاتون (توت أرجواني أو أحمر صالح للأكل) / أملنشير, توت يونيو (أي من الأشجار أو الشجيرات المتنوعة في أمريكا الشمالية التي لها زهور بيضاء بارزة وثمار زرقاء مسودة أو أرجوانية صالحة للأكل)",
 "ジョイ": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "ジョイスティック": "عَصَا الْأَلْعَاب, عَصَا التَّحَكُّم فِي الْأَلْعَاب (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)",
 "ジョイスト": "رافدة (عارضة تستخدم لدعم الأرضيات أو الأسقف)",
