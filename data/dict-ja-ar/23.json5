 "シートパイル": "خازوق لوحي, ركيزة لوحية (ركيزة في صف من الركائز المدفوعة جنباً إلى جنب لاحتجاز الأرض أو منع التسرب)",
 "シートベルト": "حِزَام أَمَان (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "シートペーパー": "مَقْعَد الْمِرْحَاض (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "シート・パイル": "خازوق لوحي, ركيزة لوحية (ركيزة في صف من الركائز المدفوعة جنباً إلى جنب لاحتجاز الأرض أو منع التسرب)",
 "シート・ベルト": "حِزَام أَمَان (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "シート・ペーパー": "مَقْعَد الْمِرْحَاض (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "シード": "بِذْرَة, زَرِّيعَة",
 "シードせんしゅ": "لاعب مصنف (واحد من اللاعبين البارزين في بطولة (يتم تصنيفهم لتجنب مواجهتهم مبكراً))",
 "シードマネー": "تمويل أولي, رأس مال تأسيسي (رأس المال اللازم لإنشاء عمل تجاري أو مشروع جديد)",
 "シードル": "سِيدَر",
 "シード・マネー": "تمويل أولي, رأس مال تأسيسي (رأس المال اللازم لإنشاء عمل تجاري أو مشروع جديد)",
 "シード選手": "لاعب مصنف (واحد من اللاعبين البارزين في بطولة (يتم تصنيفهم لتجنب مواجهتهم مبكراً))",
 "シーニュ": "لافِتَة\nمثال: توم وقع و أصيب.",
 "シーネ": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق…)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "シーバス": "قاروس, قاروص",
 "シーバックソーン": "أَبُو قَايِس, شَوْك الْقَصَّار",
 "シーパワー": "قوة بحرية (القوة العسكرية البحرية)",
 "シービー": "سند قابل للتحويل (سند يمكن تحويله إلى أوراق مالية أخرى في ظل ظروف معينة) / التهاب الشعب الهوائية المزمن (شكل من أشكال التهاب الشعب الهوائية يتميز بإنتاج مفرط للبلغم مما يؤدي إلى سعال…)",
 "シーピー": "ورقة تجارية (التزام قصير الأجل غير مضمون وغير مسجل يصدره مقترض مؤسسي للمستثمرين الذين لديهم…) / الحزب الشيوعي (حزب سياسي يدعو بنشاط إلى شكل شيوعي للحكومة؛ في الدول الشيوعية هو الحزب السياسي…) / شلل دماغي / شحن, نقل (المشروع التجاري لنقل البضائع والمواد)",
 "シーピーアイ": "مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "シーピーエス": "دَوْرَة فِي الثَّانِيَة, هَرْتز (وحدة التردد؛ الهرتز الواحد له فترة دورية تبلغ ثانية واحدة (سميت تيمناً بـ…)",
 "シーピーユー": "المعالج, المعالج المركزي ((علوم الحاسوب) جزء من الحاسوب (شريحة المعالج الدقيق) يقوم بمعظم معالجة البيانات)\nمثال: تشكل وحدة المعالجة المركزية والذاكرة الجزء المركزي من الكمبيوتر الذي يتم توصيل الأجهزة الطرفية به",
 "シーフ": "لِصّ, لِصَّة",
 "シーフード": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "シーブイエス": "بِقَالَة, مَتْجَر صَغِير / مِئَة وَخَمْسَة (يَدُلُّ عَلَى العَدَد 105) / فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "シープ": "خَرُوف\nمثال: إن شاء الله ؛",
 "シープスキン": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "シープドッグ": "كلب راعي (أي من سلالات الكلاب المختلفة عادة ما تكون طويلة الشعر تربى لرعي وحراسة الأغنام)",
 "シープラスプラス": "سِي++, سِي بْلَس بْلَس",
 "シープラスプラスげんご": "سِي++, سِي بْلَس بْلَس",
 "シープラプラ": "سِي++, سِي بْلَس بْلَس",
 "シープ・スキン": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "シープ・ドッグ": "كلب راعي (أي من سلالات الكلاب المختلفة عادة ما تكون طويلة الشعر تربى لرعي وحراسة الأغنام)",
 "シーホース": "حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي)",
 "シーボーギウム": "سِيبُورْجِيُوم",
 "シーム": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ…)",
 "シームレス": "سَلِس, مُتَنَاغِم (متسق ومتماسك تماماً بلا انقطاع)\nمثال: جوارب بدون درزات",
 "シーメンス": "سيمنز, مو (وحدة للموصلية تساوي مقلوب الأوم)",
 "シーモンキー": "روبيان ملحي (شائع في البحيرات المالحة)",
 "シーラカンス": "سمك السيلاكانث (سمكة كان يُعتقد أنها انقرضت منذ العصر الطباشيري ولكن عُثر عليها عام 1938 قبالة…)",
 "シーラチャ": "سريراتشا (صلصة مصنوعة من الثوم المهروس والفلفل الحار سميت تيمناً بمدينة سي راشا في تايلاند)",
 "シーラチャー": "سريراتشا (صلصة مصنوعة من الثوم المهروس والفلفل الحار سميت تيمناً بمدينة سي راشا في تايلاند)",
 "シーランド": "سيلاند, امارة سيلاند",
 "シーラー": "خاتم, واضع الختم (مسؤول يضع ختماً على وثيقة)",
 "シーリング": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف. / عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "シーリーズ": "سِلْسِلَة, مَجْمُوعَة",
 "シール": "فُقْمَة\nمثال: ختم سامي القرآن في شهر رمضان. / مُلْصَق",
 "シールスキン": "رداء جلد الفقمة (رداء (مثل سترة أو معطف أو روب) مصنوع من جلد الفقمة)\nمثال: معطف من جلد الفقمة",
 "シールド": "مِجَنّ, تُرْس",
 "シーレーション": "جراية معلبة, حصة سي (حصة ميدانية معلبة كانت تصرف من قبل الجيش الأمريكي)",
 "シーレーン": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن)",
 "シーロスタット": "سيلوستات, م定ة فلكية (جهاز بصري يستخدم لتتبع مسار جرم سماوي وعكس ضوئه إلى تلسكوب؛ يحتوي على مرآة…)",
 "シーン": "مَنْظَر, مَشْهَد / سِينَارْيُو / بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "シー・アイ・エス": "اِتِّحَاد اَلدُّوَل اَلْمُسْتَقِلَّة (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى…)\nمثال: عاش الاتحاد السوفيتي! / رابطة الدول المستقلة (تحالف مكون من دول كانت جمهوريات سوفيتية اشتراكية في الاتحاد السوفيتي قبل تفككه…)",
 "シー・アイ・エー": "سي آي إيه, وكالة الاستخبارات المركزية (وكالة مستقلة تابعة لحكومة الولايات المتحدة مسؤولة عن جمع وتنسيق أنشطة…)",
 "シー・アイ・オー": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في…)",
 "シー・アンカー": "مرساة عائمة (قيد يتكون من إطار مغطى بالقماش يطفو خلف السفينة؛ يمنع الانجراف أو يحافظ على…)",
 "シー・アール・シー": "فحص التكرار الدوري (رمز لتصحيح الخطأ يُسجل في كل قطاع من القرص المغناطيسي ويُستخدم لاكتشاف الأخطاء…)",
 "シー・アール・ティー": "أنبوب أشعة الكاثود (أنبوب مفرغ يبعث فيه كاثود ساخن شعاعاً من الإلكترونات يمر عبر أنود عالي الجهد…)",
 "シー・イー": "الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين)\nمثال: في عام 200 من الحقبة العامة",
 "シー・イー・オー": "رَئِيس تَنْفِيذِيّ",
 "シー・エイチ": "قَنَاة",
 "シー・エス": "قمر صناعي للاتصالات (قمر صناعي ينقل الإشارات مرة أخرى إلى الأرض؛ يتحرك في مدار ثابت بالنسبة للأرض) / سفينة حاويات (سفينة شحن مصممة لحمل البضائع المعبأة في حاويات)\nمثال: يمكن أن يتجاوز وزن الوثائق الخاصة بجميع الشحنات على متن سفينة حاويات حديثة 90 رطلاً / عِلْم الْحَاسُوب, حَاسُوبِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "シー・エフ": "إِعْلَان تِجَارِيّ / لاعب الوسط (الشخص الذي يلعب في وسط الملعب الخارجي) / تَمْوِيل الْجَمَاعِيّ / قارن (انظر للمقارنة)",
 "シー・エフ・オー": "مدير مالي (المسؤول التنفيذي للشركة الذي لديه سلطة مالية لتخصيص الاعتمادات والتفويض…)",
 "シー・エフ・シー": "كلوروفلوروكربون (فلوروكربون مع كلور؛ كان يستخدم سابقاً كمبرد وكمادة دافعة في علب الرش)\nمثال: الكلور الموجود في مركبات الكربون الكلورية فلورية يسبب استنفاذ الأوزون في الغلاف الجوي",
 "シー・エム": "إِعْلَان تِجَارِيّ / سِنْتِيمِتْر",
 "シー・エル・ブイ": "مِئَة وَخَمْسَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 155)",
 "シー・エー": "مُضِيف, مُضِيفَة (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا. / كالسيوم (عنصر فلزي أبيض يحترق بضوء ساطع؛ خامس أكثر العناصر وفرة في القشرة الأرضية) / عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً / كَلْسِيُوم, كَالْسِيُوم",
 "シー・エー・ティー・ブイ": "تِلِفِزْيُون كَبْلِيّ (تِلْفَاز)\nمثال: لنشاهد التلفزيون.",
 "シー・オー・オー": "رئيس تنفيذي (المسؤول التنفيذي للشركة المسؤول عن عمليات الشركة؛ يقدم تقاريره إلى مجلس الإدارة…)",
 "シー・オー・ディー": "غَادُس\nمثال: قد أثلجت كثيرا. / الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "シー・キュー・シー": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "シー・グリーン": "أخضر بحري (خاصية اللون الأخضر المتوسط الذي يشبه مياه البحر)",
 "シー・ケー": "ركلة ركنية (ركلة حرة من الزاوية تُمنح للجانب الآخر عندما يرسل لاعب الكرة خلف خط مرماه)",
 "シー・サーペント": "ثعبان البحر الأسطوري (مخلوق ضخم في البحر يشبه الثعبان أو التنين)",
 "シー・シー": "مِئَتَان (يَدُلُّ عَلَى العَدَد 200) / سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "シー・ジー": "جرافيكس الكمبيوتر, رسوم حاسوبية (التمثيل التصويري ومعالجة البيانات بواسطة الكمبيوتر)",
 "シー・ズー": "تشيه تزو",
 "シー・ティー": "أشعة مقطعية, تصوير مقطعي محوسب (طريقة لفحص أعضاء الجسم عن طريق مسحها بالأشعة السينية واستخدام الكمبيوتر لبناء…)",
 "シー・ティー・エス": "أشعة مقطعية, تصوير مقطعي محوسب (طريقة لفحص أعضاء الجسم عن طريق مسحها بالأشعة السينية واستخدام الكمبيوتر لبناء…) / متلازمة النفق الرسغي (اضطراب مؤلم ناتج عن ضغط العصب في النفق الرسغي؛ يتميز بعدم الراحة والضعف في…)",
 "シー・ティー・シー": "مركز مكافحة الإرهاب (وكالة تساعد مدير الاستخبارات المركزية في تنسيق جهود مكافحة الإرهاب من أجل…)",
 "シー・ディー": "قرص مضغوط (تسجيل مشفر رقمياً على قرص بصري أصغر من سجل الفونوغراف؛ يتم تشغيله بواسطة الليزر) / صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية) / شَهَادَة إِيدَاع, شَهَادَة اِدِّخَار",
 "シー・ディー・アール": "قرص مضغوط قابل للتسجيل (قرص مضغوط يمكنك الكتابة عليه مرة واحدة فقط وبعد ذلك يصبح ذاكرة للقراءة فقط)",
 "シー・ディー・ディー・エー": "سِي دِي, قُرْص مَضْغُوط",
 "シー・ディー・ロム": "قرص مضغوط (تسجيل مشفر رقمياً على قرص بصري أصغر من سجل الفونوغراف؛ يتم تشغيله بواسطة الليزر)",
 "シー・バス": "قاروس, قاروص",
 "シー・パワー": "قوة بحرية (القوة العسكرية البحرية)",
 "シー・ビー": "سند قابل للتحويل (سند يمكن تحويله إلى أوراق مالية أخرى في ظل ظروف معينة) / التهاب الشعب الهوائية المزمن (شكل من أشكال التهاب الشعب الهوائية يتميز بإنتاج مفرط للبلغم مما يؤدي إلى سعال…)",
 "シー・ピー": "ورقة تجارية (التزام قصير الأجل غير مضمون وغير مسجل يصدره مقترض مؤسسي للمستثمرين الذين لديهم…) / الحزب الشيوعي (حزب سياسي يدعو بنشاط إلى شكل شيوعي للحكومة؛ في الدول الشيوعية هو الحزب السياسي…) / شلل دماغي / شحن, نقل (المشروع التجاري لنقل البضائع والمواد)",
 "シー・ピー・アイ": "مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "シー・ピー・エス": "دَوْرَة فِي الثَّانِيَة, هَرْتز (وحدة التردد؛ الهرتز الواحد له فترة دورية تبلغ ثانية واحدة (سميت تيمناً بـ…)",
 "シー・ピー・ユー": "المعالج, المعالج المركزي ((علوم الحاسوب) جزء من الحاسوب (شريحة المعالج الدقيق) يقوم بمعظم معالجة البيانات)\nمثال: تشكل وحدة المعالجة المركزية والذاكرة الجزء المركزي من الكمبيوتر الذي يتم توصيل الأجهزة الطرفية به",
 "シー・ブイ・エス": "بِقَالَة, مَتْجَر صَغِير / مِئَة وَخَمْسَة (يَدُلُّ عَلَى العَدَد 105) / فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "シー・プラス・プラス": "سِي++, سِي بْلَس بْلَس",
 "シー・プラ・プラ": "سِي++, سِي بْلَس بْلَس",
 "シー・モンキー": "روبيان ملحي (شائع في البحيرات المالحة)",
 "シー・レーン": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن)",
 "ジ": "الـ",
 "ジアセチルモルヒネ": "هيروين (مخدر يُعتبر مخدراً قوياً؛ مشتق مورفين شديد الإدمان؛ الحقن الوريدي يوفر أسرع…)",
 "ジアゼパム": "ديازيبام, فاليوم (مهدئ (الاسم التجاري فاليوم) يستخدم لتخفيف القلق وإرخاء العضلات؛ يعمل عن طريق…)",
