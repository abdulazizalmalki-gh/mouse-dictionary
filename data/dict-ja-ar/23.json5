 "掛構い": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "掛橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "掛目": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "掛矢": "ميقعة, فِطِّيس",
 "掛算": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "掛紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "掛詞": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "掛違い": "صِرَاع, نِزَاع",
 "掛違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "掛金": "قِسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة.",
 "掟": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "掟破り": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "掠う": "اِحْتَكَرَ",
 "掠める": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "掠め取る": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "掠め奪う": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته واستولت عليه)\nمثال: لقد سلب مني كل شيء.",
 "掠り": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "掠り傷": "خَرْبَشَ",
 "掠る": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى / مَأْثُرَة / اِسْتَغَلَّ",
 "掠れる": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى",
 "掠れ傷": "خَرْبَشَ",
 "掠奪": "غَزَاوَة",
 "採る": "تَبَنَّى / مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة) / مُقْتَطَف / خلاصة / اِفْتَرَضَ",
 "採れたて": "طَازَج, طَازَة / عَذْب",
 "採れ立て": "طَازَج, طَازَة / عَذْب",
 "採光": "إِضَاءَة",
 "採卵鶏": "طَبَقَة",
 "採取": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "採択": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "採捕": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "採掘": "تعدين",
 "採掘場": "مَقْلَع",
 "採決": "تَصْوِيت, اِقْتِرَاع / صَوَّتَ (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "採点": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "採用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "採番": "تَرْقِيم",
 "採石": "مَقْلَع",
 "採石場": "مَقْلَع",
 "採算": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "採算がとれる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "採算が取れる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "採算性": "مَرْدُودِيَّة",
 "採納": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "採鉱": "تعدين",
 "採録": "تَسْجِيل",
 "採集": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "採食": "إِطْعَام",
 "採餌": "إِطْعَام",
 "探し当てる": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "探し求める": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "探す": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探り": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "探りを入れる": "مِسْبَار",
 "探り出す": "يَشُمّ, يَكْتَشِف",
 "探る": "اِسْتَكْشَفَ",
 "探信儀": "سُونار",
 "探偵": "مُحَقِّق (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "探偵団": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / نَادٍ لَيْلِيّ, اَلنَّادِي اَللَّيْلِيّ / سِبَاتِي\nمثال: لا تمسك العصا من الوسط.",
 "探勝": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة",
 "探掘": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "探査": "مِسْبَار",
 "探査機": "مِسْبَار",
 "探検": "اِسْتِكْشَاف",
 "探検家": "مُسْتَكْشِف",
 "探検者": "مُسْتَكْشِف",
 "探求": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探測": "مِسْبَار",
 "探究": "بَحْث, تَحْقِيق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "探究者": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "探索": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探索者": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "探訪": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "探針": "مِسْبَار",
 "探険": "اِسْتِكْشَاف",
 "探険家": "مُسْتَكْشِف",
 "探険者": "مُسْتَكْشِف",
 "掣肘": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "接ぎ": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع) / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "接ぎ台": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "接ぎ木": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "接ぎ目": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "接ぎ穂": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
