 "旅行者用小切手": "مُسَافِر شِيك (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "旅行鞄": "حَقِيبَةُ السَّفَر, شَنْطَة",
 "旅路": "رِحْلَة, سَفَر",
 "旅鴉": "هَائِم / غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "旋削": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "旋回": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "旋律": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "旋条": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "旋法": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / مِنْوَال\nمثال: لقد أزمت الوضع.",
 "旋盤": "مِخْرَطَة",
 "旋転": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "旋風": "زَوْبَعَة / حَاسَّة, حِسّ",
 "旌": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "族": "قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "族縁": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "族長": "بَطْرِيَرْك, بَطْرَك / شَيْخ, بَطْرِيَرْك",
 "旗": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗ざお": "سَارِيَةْ العَلَم (اسم فاعل مؤنث للفعل \"سَرَى\"؛ العمود الذي يُنصب عليه العلم أو الشراع)",
 "旗じるし": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗下": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "旗亭": "مَطْعَم",
 "旗印": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗幟": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / مَوْقِف",
 "旗弁": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "旗振り": "مُحَرِّض, مُحَرِّضَة",
 "旗振り役": "مُبَادِر",
 "旗本": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "旗標": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "旗竿": "سَارِيَةْ العَلَم (اسم فاعل مؤنث للفعل \"سَرَى\"؛ العمود الذي يُنصب عليه العلم أو الشراع)",
 "旗艦": "سَفِينَةُ الْقَائِد, سَفِينَةُ الْقِيَادَة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "旗色": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "旗門": "بَوَّابَة",
 "旗頭": "قَائِد, زَعِيم",
 "旗魚": "سَمَكَة سَيْف (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "旗魚座": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "旗鼓": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "既に": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / قَبْلًا, قَبْل",
 "既にして": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "既の事": "تَقْرِيبًا, عَلَى وَشْك",
 "既卒者": "طَالِب, طَلَبَة / خِرِّيج, خِرِّيجُون",
 "既婚": "مُتَزَوِّج, مُتَأَهِّل",
 "既存": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي",
 "既定": "مُتَرَسِّخ",
 "既往": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "既往歴": "سِيرَة مَرْضِيَة",
 "既往症": "سِيرَة مَرْضِيَة",
 "既得": "صُدَيْرِيّ (المنسوب إلى الصُدَيْر أي مصغر الصدر؛ لباس للرجال غربي يغطي الجذع ويزرّر عند الصدر وليس له أكمام، يُرتدى غالبا تحت السترة)",
 "既成": "مُتَرَسِّخ",
 "既成事実": "أَمْر وَاقِع (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "既成概念": "صُورَة نَمَطِيَّة",
 "既決": "قَرَّرَ, صَمَّمَ / قَرَّرَ / أَدَانَ / سَجِين, مُدَان",
 "既決囚": "أَدَانَ / سَجِين, مُدَان",
 "既知": "مَعْلُوم",
 "既視感": "دِيجَا ڤُو",
 "既設": "مُتَرَسِّخ",
 "既述": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "既遂": "نَاجِح, فَائِز",
 "日": "يَوْم, نَهَار (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل. / شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.\nمثال: この部屋はあまり日が当たらない。 — لا تشع الشمس على هذه الغرفة كثيراً. / تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام",
 "日々": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم",
 "日かげ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "日が射す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "日が差す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "日が暮れる": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "日ぎめ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日ぐれ": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "日ごと": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日ごと夜ごと": "يَوْمًا بَعْدَ يَوْم",
 "日ごろ": "عَادَةً, الاَكْثِرْ",
 "日でり": "جَفَاف",
 "日にち": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام",
 "日に日に": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日の丸": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "日の入り": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "日の出": "شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "日の御子": "قَيْصَر, إِمْبْرَاطُور / وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "日の本": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "日の目": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日もすがら": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "日よけ": "مَظَلَّة / مَظَلَّة, شَمْسِيَّة",
 "日を追って": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日中": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "日付": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "日付け": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "日傘": "مَظَلَّة, شَمْسِيَّة",
 "日傭取": "مُياوِم",
 "日光": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日光浴": "حَمَّام شَمْس (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "日光角化症": "تقران سفعي/تقرن سفعي",
 "日出": "شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "日出ずる国": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "日出づる国": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "日出国": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "日別": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日割": "جَدْوَل, جَدْوَل أَعْمَال",
 "日割り": "جَدْوَل, جَدْوَل أَعْمَال",
 "日午": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "日向ぼっこ": "حَمَّام شَمْس (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "日向臭い": "فَلَّاحِيّ, قَرَوِيّ",
 "日周": "نَهَارِيّ",
 "日和見": "اِمْتَطَى",
 "日唐傘": "مَظَلَّة, شَمْسِيَّة",
 "日嗣の御子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "日嗣の皇子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "日夕": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "日外": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "日夜": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "日天": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "日天子": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "日子": "أَيَّام",
 "日射し": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日射病": "ضَرْبَة شَمْس (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "日差し": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日常": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日常生活": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "日常生活動作": "أنشطة الحياة اليومية",
 "日常的": "دُنْيَوِيّ / عَادِيّ / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "日当たりのいい": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "日当たりのよい": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "日当たりの良い": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "日影": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "日日": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم",
 "日時計": "مِزْوَلَة",
 "日暮": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "日暮れ": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "日暮れ方": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "日暮れ時": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "日曜": "الْأَحَد, يَوْم الْأَحَد\nمثال: 銀行は日曜にはやってません。 — لا يكون المصرف مفتوحاً أيام الأحد.",
 "日曜日": "الْأَحَد, يَوْم الْأَحَد",
 "日替り定食": "طَبَق اليَوْم (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "日替わり定食": "طَبَق اليَوْم (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "日月": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "日本": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "日本側": "يَابَانِيّ",
 "日本医学会": "مُرَبًّى / شَوَّشَ",
 "日本国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "日本国民": "يَابَانِيّ",
 "日本工業大学": "صُغْبَة",
 "日本海": "بَحْر اَلْيَابَان (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "日本的": "يَابَانِيّ",
 "日本移動通信株式会社": "إِيدُو",
 "日本統合医療学会": "جِيم (كتب جيمًا)\nمثال: أنا أعتني بجيم.",
 "日本語": "يَابَانِيّ",
 "日本語能力試験": "اِخْتِبَار اَللُّغَة اَلْيَابَانِيَّة, جَاي إِل بِيه تِي (اختبر الشّيء:خبره)\nمثال: تم اختبار زيري.",
 "日本車両検査協会": "بِوَاسِطَة, عَن طَرِيق / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)",
 "日本酒": "غاية, غَرَض",
 "日東": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "日極": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日極め": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日次": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日毎": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日毎夜毎": "يَوْمًا بَعْدَ يَوْم",
 "日決め": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "日没": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "日焼け": "حَرْق شَمْسِيّ, لَفْح الشَّمْس (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "日焼け止め": "حَاجِبَة اَلْأَشِعَّة اَلشَّمْسِيَّة, وَاقِيَة مِنَ الشَّمْس",
 "日照": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "日照り": "جَفَاف",
 "日程": "جَدْوَل, جَدْوَل أَعْمَال",
 "日程表": "جَدْوَل, جَدْوَل أَعْمَال",
 "日脚": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "日蔭": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "日蝕": "كُسُوف اَلشَّمْس"
}
