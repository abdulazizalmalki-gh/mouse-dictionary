 "センター・スプレッド": "الصفحتان الوسطيان (الصفحتان المتقابلتان في وسط المجلة)",
 "センター・テーブル": "طَاوِلَةُ قَهْوَة (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم)) / طَاوِلَةُ لِلْقَهْوَة (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "センター・ライン": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "センター揃え": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "センチ": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر) / رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "センチメンタリスト": "عَاطِفِيّ مُفْرِط, وِجْدَانِيّ (شخص ينغمس في العاطفة المفرطة)",
 "センチメンタリズム": "نزعة عاطفية (ميل للعاطفية) / عاطفية مفرطة (التعبير المفرط عن المشاعر الرقيقة أو الحنين أو الحزن بأي شكل من الأشكال)",
 "センチメンタル": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "センチメント": "عَاطِفَة",
 "センチメーター": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر)",
 "センチメートル": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر)",
 "センチモ": "سنتيمو (وحدة نقدية كسرية لفنزويلا وكوستاريكا وغينيا الاستوائية وباراغواي وإسبانيا)",
 "センチュリー": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "センティ": "سنتي (100 سنتي تساوي 1 لوتي في ليسوتو)",
 "センティメンタル": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "センティモ": "سنتيمو (وحدة نقدية كسرية لفنزويلا وكوستاريكا وغينيا الاستوائية وباراغواي وإسبانيا)",
 "センテンス": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "セント": "سِنْت / سَنْت / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "セントキッツネイビス": "سَانْت كِيتْس وَنِيفِيس",
 "セントキッツ・ネイビス": "سَانْت كِيتْس وَنِيفِيس",
 "セントクリストファーネイビス": "سَانْت كِيتْس وَنِيفِيس",
 "セントクリストファー・ネイビス": "سَانْت كِيتْس وَنِيفِيس",
 "セントバーナード": "سانت برنارد (سلالة ألبية سويسرية من الكلاب القوية الكبيرة ذات معطف سميك من الشعر تستخدم ككلب إنقاذ)",
 "セントビンセントおよびグレナディーンしょとう": "سَانْت فِينْسِنْت وجُزُر غْرِينَادِين, سَانْت فِنْسِنْت وَجُزُر غْرِينَادِين",
 "セントビンセントおよびグレナディーン諸島": "سَانْت فِينْسِنْت وجُزُر غْرِينَادِين, سَانْت فِنْسِنْت وَجُزُر غْرِينَادِين",
 "セントビンセントグレナディーン": "سَانْت فِينْسِنْت وجُزُر غْرِينَادِين, سَانْت فِنْسِنْت وَجُزُر غْرِينَادِين",
 "セントビンセント・グレナディーン": "سَانْت فِينْسِنْت وجُزُر غْرِينَادِين, سَانْت فِنْسِنْت وَجُزُر غْرِينَادِين",
 "セントビンセント及びグレナディーン諸島": "سَانْت فِينْسِنْت وجُزُر غْرِينَادِين, سَانْت فِنْسِنْت وَجُزُر غْرِينَادِين",
 "セントポーリア": "بنفسج أفريقي, سانت بوليا (نبات أفريقي استوائي يزرع كنبات منزلي لزهوره البنفسجية أو البيضاء أو الوردية)",
 "セントラル": "مَرْكَزِيّ",
 "セントラルヒーティング": "تَدْفِئَة مَرْكَزِيَّة",
 "セントラルプロセシングユニット": "وحدَة المعالجَة المَرْكَزِيَّة",
 "セントラルリーグ": "مِئَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 150) / سنتيلتر (وحدة مترية للحجم تساوي واحداً من المائة من اللتر) / كلور (عنصر لافلزي شائع ينتمي إلى الهالوجينات؛ يشتهر كغاز سام أصفر ثقيل مهيج)",
 "セントラル・ヒーティング": "تَدْفِئَة مَرْكَزِيَّة",
 "セントラル・プロセシング・ユニット": "وحدَة المعالجَة المَرْكَزِيَّة",
 "セントラル・リーグ": "مِئَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 150) / سنتيلتر (وحدة مترية للحجم تساوي واحداً من المائة من اللتر) / كلور (عنصر لافلزي شائع ينتمي إلى الهالوجينات؛ يشتهر كغاز سام أصفر ثقيل مهيج)",
 "セントルシア": "سَانْت لُوسِيَا",
 "セントロイド": "مركز هندسي, نقطة مركزية (مركز كتلة جسم ذو كثافة منتظمة)",
 "セント・バーナード": "سانت برنارد (سلالة ألبية سويسرية من الكلاب القوية الكبيرة ذات معطف سميك من الشعر تستخدم ككلب إنقاذ)",
 "セント・ルシア": "سَانْت لُوسِيَا",
 "センド": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "センナ": "سنا إسكندراني, سنا مكي (شجيرة قائمة لها عناقيد من الزهور الصفراء السمراء؛ تستخدم الأوراق المجففة طبياً كمسهل؛ تصنف أحياناً في جنس كاسيا)",
 "センナリウリ": "شَايُوت",
 "センニチコウ": "قطيفة كروية, مدنة (عشب أمريكي استوائي له زهور وردية إلى حمراء أو أرجوانية يمكن تجفيفها دون أن تفقد لونها)",
 "センニンコク": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب)",
 "センノウ": "صائدة الذباب, ليخنيس (أعشاب معمرة في الغالب بسيقان لزجة تمسك بالحشرات؛ واسعة الانتشار في المنطقة المعتدلة الشمالية)",
 "センバツ": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "センブリ": "ذبابة ألدر (حشرة داكنة اللون لها يرقات مائية مفترسة)",
 "センモウチュウ": "تريكينا (نيماتودا طفيلية توجد في أمعاء الخنازير والجرذان والبشر وتنتج يرقات تشكل أكياساً في العضلات الهيكلية)",
 "セヴンティーン": "سَبْعَةَ عَشَرَ",
 "セーシェル": "سِيشِيل, سيشل",
 "セージ": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "セーター": "سْوِيتَر",
 "セード": "مَظَلَّة",
 "セービング": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "セービンワクチン": "لقاح سابين, لقاح شلل الأطفال الفموي (لقاح فموي (يحتوي على فيروس شلل أطفال حي ولكن ضعيف) يعطى لتوفير المناعة ضد شلل الأطفال)",
 "セービン・ワクチン": "لقاح سابين, لقاح شلل الأطفال الفموي (لقاح فموي (يحتوي على فيروس شلل أطفال حي ولكن ضعيف) يعطى لتوفير المناعة ضد شلل الأطفال)",
 "セーフ": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي. / جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "セーフガード": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / أمان, تصريح مرور آمن (وثيقة أو مرافقة توفر ممراً آمناً عبر منطقة خاصة في وقت الحرب)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "セーフセックス": "جنس آمن (نشاط جنسي (خاصة الجماع) مع استخدام تدابير (مثل الواقي الذكري اللاتكس) لتجنب انتقال الأمراض)",
 "セーフティ": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "セーフティネット": "شبكة أمان (شبكة قوية كبيرة لالتقاط لاعبي سيرك الأكروبات الذين يسقطون أو يقفزون من الأرجوحة) / شَبَكَة أَمَان (ضمان للأمن المهني أو المالي)",
 "セーフティボックス": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
 "セーフティ・ネット": "شبكة أمان (شبكة قوية كبيرة لالتقاط لاعبي سيرك الأكروبات الذين يسقطون أو يقفزون من الأرجوحة) / شَبَكَة أَمَان (ضمان للأمن المهني أو المالي)",
 "セーフティ・ボックス": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
 "セーフティー": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "セーフティーゾーン": "جزيرة مرورية (منطقة محددة في الطريق يُمنع مرور السيارات فيها؛ توفر منطقة آمنة للمشاة)",
 "セーフティーネット": "شبكة أمان (شبكة قوية كبيرة لالتقاط لاعبي سيرك الأكروبات الذين يسقطون أو يقفزون من الأرجوحة) / شَبَكَة أَمَان (ضمان للأمن المهني أو المالي)",
 "セーフティーバルブ": "صمام أمان (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "セーフティーファクター": "عَامِل الأَمَان, عَامِل السَّلَامَة (نسبة إجهاد الكسر للهيكل إلى أقصى إجهاد مقدر في الاستخدام العادي)",
 "セーフティーベルト": "حزام أمان, حزام نجاة (حزام يربطك بشيء ما كقيد لمنعك من التعرض للأذى)",
 "セーフティーボックス": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
