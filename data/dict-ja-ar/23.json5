 "ゼリー・フライ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "ゼロ": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ゼロいがい": "غَيْرُ صِفْرِيّ (لَا يَتَضَمَّنُ الصِّفْرَ)",
 "ゼロから": "من الصفر (من البداية، خاصة دون الاعتماد على موارد أو مزايا أخرى)\nمثال: خبز الكعكة من الصفر",
 "ゼロきょり": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "ゼロきょりしゃげき": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "ゼロくうかん": "فضاء صفري, فضاء فارغ (فضاء لا يحتوي على نقاط؛ وفضاء فارغ)",
 "ゼロじかん": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "ゼロちてん": "نقطة الانفجار, نقطة الصفر (نقطة تفجير سلاح نووي (أو فوقها أو تحتها)) / نقطة الصفر, نقطة الهدف (هدف قذيفة (مثل قنبلة أو صاروخ))",
 "ゼロばんめ": "صِفْرِيّ",
 "ゼロわゲーム": "لعبة صفرية, لعبة محصلتها صفر (لعبة يكون فيها مجموع كل المكاسب والخسائر صفراً)",
 "ゼログラフィー": "تصارخ جاف, زيروغرافيا (تكوين صورة بفعل الضوء على لوحة مشحونة مطلية خصيصًا؛ يتم تطوير الصورة الكامنة بمساحيق تلتصق فقط بالمناطق المشحونة كهربائياً)\nمثال: تحسين الحواف هو أمر جوهري في التصوير الجاف",
 "ゼロサムゲーム": "لعبة صفرية, لعبة محصلتها صفر (لعبة يكون فيها مجموع كل المكاسب والخسائر صفراً)",
 "ゼロサム・ゲーム": "لعبة صفرية, لعبة محصلتها صفر (لعبة يكون فيها مجموع كل المكاسب والخسائر صفراً)",
 "ゼロックス": "آلة تصوير زيروغرافية, زيروكس (ناسخة (العلامة التجارية زيروكس) تنسخ المواد الرسومية بفعل الضوء على سطح عازل موصل ضوئياً مشحون كهربائياً يتم فيه تطوير الصورة الكامنة بمسحوق راتنجي) / زيروكس, نسخة زيروكس (نسخة مصنوعة بواسطة ناسخة زيروغرافية)",
 "ゼロメートル": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع اليابسة أو عمق البحر)",
 "ゼロメートルちたい": "عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "ゼロメートル地帯": "عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "ゼロ・メートル": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع اليابسة أو عمق البحر)",
 "ゼロ以外": "غَيْرُ صِفْرِيّ (لَا يَتَضَمَّنُ الصِّفْرَ)",
 "ゼロ和ゲーム": "لعبة صفرية, لعبة محصلتها صفر (لعبة يكون فيها مجموع كل المكاسب والخسائر صفراً)",
 "ゼロ地点": "نقطة الانفجار, نقطة الصفر (نقطة تفجير سلاح نووي (أو فوقها أو تحتها)) / نقطة الصفر, نقطة الهدف (هدف قذيفة (مثل قنبلة أو صاروخ))",
 "ゼロ時間": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "ゼロ番目": "صِفْرِيّ",
 "ゼロ空間": "فضاء صفري, فضاء فارغ (فضاء لا يحتوي على نقاط؛ وفضاء فارغ)",
 "ゼロ距離": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "ゼロ距離射撃": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "ゼンゴ": "حَرْشَفَة دِرْعِيَّة (صفيحة عظمية أو قرنية كبيرة كما في المدرع أو السلحفاة أو الجانب السفلي للثعبان)",
 "ゼンスト": "إضراب عام",
 "ゼンタイ": "لَاصِق بِالجِلْد (ضَيِّق جِدًّا بِحَيْث يَلْتَصِق بِالجِلْد)",
 "ゼンチョ": "وَثَنِيّ / وَثَنِيّ, وَثَنِيَّة",
 "ゼンマイ": "أوسمندا, سرخس مزهر (أي سرخس من جنس أوسمندا: سراخس كبيرة بجذور زاحفة؛ توجد أكياس الأبواغ العارية على سعف معدلة تشبه عناقيد الزهور) / سرخس مزهر (سرخس أسترالاسي بعناقيد من أكياس الأبواغ على سيقان السعف الخصبة)",
 "ゼーゼー": "أَزْمِيّ, رَبْوِيّ (مُتَعَلِّق بِالتَّنَفُّس بِصَوْت صَفير)",
 "ゼーゼーいう": "أزيز (التنفس مع صوت أجش أو صفير) / حيلة ذكية ((بريطانية) مخطط أو خدعة ذكية أو مسلية)\nمثال: حيلة ذكية نجحت على الأرجح في تحييد تهديد التجسس الألماني",
 "ゼーゼー言う": "أزيز (التنفس مع صوت أجش أو صفير) / حيلة ذكية ((بريطانية) مخطط أو خدعة ذكية أو مسلية)\nمثال: حيلة ذكية نجحت على الأرجح في تحييد تهديد التجسس الألماني",
 "ゼータ": "زِيتَا",
 "ソ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / ثَابِت الْجَاذِبِيَّة, ثَابِت الْجَذْب الْعَامّ ((في الفيزياء) الثابت العام الذي يربط القوة بالكتلة والمسافة في قانون نيوتن للجاذبية) / غيبي بايت, غيغابايت (وحدة معلومات تساوي 1024 ميبي بايت أو 2 أس 30 بايت) / غيغابايت (وحدة معلومات تساوي 1000 ميغابايت أو 10 أس 9 بايت) / تسارع الجاذبية, قوة جي (وحدة قوة تساوي القوة التي تمارسها الجاذبية؛ تستخدم للإشارة إلى القوة التي يتعرض لها جسم عند تسارعه) / الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "ソれん": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "ソれんぽう": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "ソアラー": "طائرة شراعية (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "ソアリング": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "ソイ": "صُويَا / صَلْصَةْ اَلصُّويَا",
 "ソイソース": "صَلْصَةْ اَلصُّويَا",
 "ソイル": "تُرْبَة, أَرْض / اِتَّسَخَ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / تُرْبَة, تُرَاب / بُقْعَة, قَذَارَة",
 "ソイ・ソース": "صَلْصَةْ اَلصُّويَا",
 "ソウゲンライチョウ": "دجاجة البراري الكبرى (أكثر أنواع دجاج البراري شيوعاً)",
 "ソウメンカボチャ": "قرع السباغيتي (قرع بيضاوي متوسط الحجم ذو لب على شكل خيوط تشبه السباغيتي) / قرع السباغيتي (نبات قرع يحمل ثماراً بيضاوية بقشرة صفراء ناعمة ولب طري خيطي يشبه السباغيتي)",
 "ソウル": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة. / سِيئُول, سِيُول",
