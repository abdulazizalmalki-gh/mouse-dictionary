 "文法的": "نَحْوِيّ",
 "文無し": "فقير",
 "文献": "أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "文献学": "فِقْهُ اللُّغَة (عَلِمَ، أو فَهِمَ، وَهو لمطلق الفهم) / عِلْمُ فِقْهِ اللُّغَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "文献資料": "مَرْجِع / وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "文献集": "وَثَائِق",
 "文理": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "文目": "نُمُوذَج, نَمَط",
 "文盲": "أُمِّيَّة / أُمِّيّ",
 "文章": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "文章家": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "文章法": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "文章論": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "文筆": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "文筆家": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "文筆業": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "文節": "جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "文脈": "سِيَاق, قَرِينَة",
 "文芸": "أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "文芸家": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "文芸復興": "نَهْضَة, عَصْر اَلنَّهْضَة / عَصْر اَلنَّهْضَة, اَلنَّهْضَة (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "文苑": "تَجْمِيعَة, دِيوَان",
 "文藝": "أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "文言": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "文身": "وَشْم / وَشَمَ, وَشَّمَ",
 "文通": "مُرَاسَلَة",
 "文選": "تَجْمِيعَة, دِيوَان",
 "文鎮化": "طُوبَة, لَبِنَة",
 "文集": "تَجْمِيعَة, دِيوَان",
 "文革": "ثَوْرَة ثَقَافِيَّة",
 "文題": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "文鳥": "عصفور جاوة",
 "斉しく": "بِالتَّسَاوِي",
 "斉一": "مُسَاوَاة / تَسَاوٍ",
 "斉列": "مَصْفُوفَة",
 "斉整": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "斎": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل. / مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / صَافٍ, اَلصَّافِي",
 "斎う": "اِحْتَفَلَ",
 "斎く": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "斎み": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل. / مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / صَافٍ, اَلصَّافِي",
 "斎む": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "斎戒": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "斎戒沐浴": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "斐然": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
