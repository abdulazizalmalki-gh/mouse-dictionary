 "チョコ・バー": "لوح شوكولاتة (لوح من حلوى الشوكولاتة)",
 "チョチョイ": "بِسُهُولَة",
 "チョッと": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بِسُهُولَة",
 "チョッキ": "صُدْرِيّة, صِدَار (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي المَرْيُول، ثوب يُغطي الجزء الأمامي من الجسم ويُربط من خلف يُرتدى فوق الملابس لحمايتها أثناء الطبخ أو العمل. الجمع صداري)",
 "チョック": "تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن) / إسفين, سنادة (كتلة من الخشب تستخدم لمنع انزلاق أو تدحرج جسم ثقيل)\nمثال: كان ممتلئاً تماماً / مصد الباب (سدادة تمنع الأبواب المفتوحة من التحرك)",
 "チョット": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بِسُهُولَة",
 "チョッパる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "チョッパヤ": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)\nمثال: أنهت المهمة في لمح البصر",
 "チョッパリ": "ياباني (مصطلح مسيء) ((عامية مسيئة) مصطلح مسيء لشخص من أصل ياباني)",
 "チョッパー": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء) / ساطور (سكين جزار له شفرة مربعة كبيرة) / مروحية, هليكوبتر (طائرة بدون أجنحة تحصل على رفعها من دوران شفرات علوية) / سن (مصطلحات غير رسمية للسن البشري)",
 "チョップ": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء) / ضربة قاطعة (رد تنس يتم بحركة هبوطية تضع دوراناً خلفياً على الكرة) / فك (الفك (مصطلح عامي)) / شريحة لحم بضلع, كستليتة (قطعة صغيرة من اللحم تشمل جزءاً من الضلع)\nمثال: سأضربه على فكه",
 "チョップスティック": "أَعْوَاد الْأَكْل, هَاشِي",
 "チョボ": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط",
 "チョボチョボ": "بشكل متناثر, بكثافة قليلة (بطريقة متفرقة وغير كثيفة)\nمثال: مأهولة بشكل متناثر",
 "チョメチョメ": "بيب, صفير (نغمة عالية قصيرة تصدر كإشارة أو تحذير)",
 "チョリソ": "تشوريزو (سجق خنزير إسباني حار)",
 "チョリソー": "تشوريزو (سجق خنزير إسباني حار)",
 "チョリッス": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / مَفْهُوم",
 "チョリース": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / مَفْهُوم",
 "チョリーッス": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / مَفْهُوم",
 "チョロい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "チョロイ": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "チョロチョロ": "تقاطر, تنقيط (التدفق على شكل قطرات؛ تشكل وسقوط قطرات من السائل)\nمثال: هناك تقاطر عبر السقف / خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "チョン": "كُورِيّ / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / تَصْفِيق / صَفَّق / صَفَّقَ / النِهاية / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط / تشون (100 تشون تساوي 1 وون في كوريا الشمالية) / تشون (100 تشون تساوي 1 وون في كوريا الجنوبية)",
 "チョンこう": "كُورِيّ",
 "チョンこく": "كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "チョンカス": "حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "チョンガー": "أَعْزَب, عَازِب",
 "チョンコ": "كُورِيّ",
 "チョンコー": "كُورِيّ",
 "チョンチョン": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "チョンボ": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "チョン公": "كُورِيّ",
 "チョン国": "كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "チョー": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / طَبْعًا",
 "チョーカー": "طوق مكشكش, ياقة عالية (ياقة عالية وضيقة) / طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / فاشِل تَحْت الضَّغْط, مُنْهار (شخص سيء الحظ غير قادر على الأداء بفعالية بسبب التوتر العصبي أو الاضطراب) / خانِق (شخص يقتل عن طريق الخنق)\nمثال: كان بإمكانه الفوز لو لم ينهار تحت الضغط",
 "チョーキング": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى) / طَبْشُورَة",
 "チョーク": "طَبْشُورَة / تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن) / إسفين, سنادة (كتلة من الخشب تستخدم لمنع انزلاق أو تدحرج جسم ثقيل)\nمثال: كان ممتلئاً تماماً / مصد الباب (سدادة تمنع الأبواب المفتوحة من التحرك) / اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "チョークコイル": "ملف خانق (ملف ذو مقاومة منخفضة ومحاثة عالية يستخدم في الدوائر الكهربائية لتمرير التيار المستمر وتخفيف التيار المتردد)",
 "チョーク・コイル": "ملف خانق (ملف ذو مقاومة منخفضة ومحاثة عالية يستخدم في الدوائر الكهربائية لتمرير التيار المستمر وتخفيف التيار المتردد)",
 "チラつかせる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "チラつく": "وَمِيض, وَمْضَة / طَرْفَة, وَمْضَة / رَفْرَفَ, خفَقَ",
 "チラシ": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة) / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "チラチラ": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب) / لمحة, نظرة خاطفة (نظرة سريعة) / بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "チラッとみる": "لمحة, نظرة خاطفة (نظرة سريعة) / لمحة, نظرة خاطفة (رؤية موجزة أو غير كاملة) / لمحة (إشارة غامضة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "チラッと見る": "لمحة, نظرة خاطفة (نظرة سريعة) / لمحة, نظرة خاطفة (رؤية موجزة أو غير كاملة) / لمحة (إشارة غامضة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "チラッチラッ": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب) / لمحة, نظرة خاطفة (نظرة سريعة) / بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "チラツキ": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "チラノサウルス": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "チラノザウルス": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "チラミン": "تيرامين (حمض أميني مشتق من التيروزين؛ له تأثير محاكي للودي؛ يوجد في الشوكولاتة ومشروبات الكولا والجبن الناضج والبيرة)",
 "チラリ": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
