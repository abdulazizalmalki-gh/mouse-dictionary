 "セイウチ": "فَظّ",
 "セイシェル": "سِيشِيل, سيشل",
 "セイジ": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "セイタカシギ": "أبو مغازل أسود الجناح (أبو مغازل من أوروبا وأفريقيا وآسيا ذو ريش أبيض في الغالب ولكن بأجنحة سوداء) / كُرْسُوع, أَبُو الْمَغَازِل",
 "セイタン": "غلوتين القمح (غلوتين محضر من القمح)",
 "セイノー": "كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: تم تجميعهم كلهم معاً",
 "セイバンモロコシ": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب الولايات المتحدة حيث يعتبر آفة خطيرة في الأراضي المزروعة)",
 "セイバー": "سيف الفرسان, سيف مقوس (سيف قوي ذو نصل منحني وظهر سميك) / سيف ضالع, سيف منحني (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "セイボリー": "شَهِيّ, مَرِيء / مالح / نَدْغ",
 "セイミ": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها) / كِيمِيَائِيّ, كِيمِيَاوِيّ\nمثال: هو يحب الكيمياء.",
 "セイヨウアブラナ": "بذور السلجم (بذرة نباتات السلجم؛ مصدر لزيت صالح للأكل)",
 "セイヨウオトギリソウ": "حَشِيشَة الْقَلْب, دَاذِيّ",
 "セイヨウカリン": "مُشْمُلَة / إِسْكِدُنْيَا / زُعْرُور / مُصَع",
 "セイヨウキヅタ": "حبل المساكين, لبلاب (كرمة من العالم القديم ذات أوراق مفصصة دائمة الخضرة وثمار سوداء تشبه التوت)",
 "セイヨウキヌヤナギ": "أوزير, صفصاف سلالين (أي من أنواع الصفصاف المختلفة ذات الأغصان المرنة المستخدمة في صناعة السلال والأثاث) / صفصاف سلالين (غصن مرن لشجرة الصفصاف)",
 "セイヨウサクラソウ": "الربيعية, بريملة",
 "セイヨウシミ": "السمكة الفضية (نوع فضي من السمك الذهبي) / سمكة الفضة (حشرة فضية رمادية غير مجنحة توجد في المنازل وتتغذى على أغلفة الكتب والملابس المنشاة)",
 "セイヨウスグリ": "عِنَب الثَعْلَب",
 "セイヨウスノキ": "عنبية (توت أزرق مسود يشبه التوت الأزرق الأمريكي)",
 "セイヨウスモモ": "برقوق شائع (أي من أنواع البرقوق المختلفة واسعة الانتشار التي تزرع في المناطق المعتدلة الباردة)",
 "セイヨウトチノキ": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل) / كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "セイヨウトネリコ": "مران أوروبي, مران عالي (مران طويل من أوروبا إلى القوقاز له أوراق خضراء داكنة لامعة من الأعلى وشاحبة زغبية من الأسفل)",
 "セイヨウナナカマド": "غُبَيْرَاء, غُبَيْرَاء أُورُوبِّيَّة (تصغير غَبْرَاء، وهي الأرض ومؤنث أغْبَر ووأنثى الحجل؛ نبات أو ثمرته)",
 "セイヨウニンジン": "جنسنغ أمريكي (عشب الغابات في أمريكا الشمالية يشبه الجنسنغ الصيني ويستخدم كبديل له)",
