 "抱えあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "抱えこむ": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱える": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / وَظَّفَ",
 "抱え上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "抱え主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱え手": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱え込む": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱きかかえる": "مَسَكَ, مسك",
 "抱きしめる": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱きつく": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き付く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き合せる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱き合わせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱き寄せる": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き抱える": "مَسَكَ, مسك",
 "抱き着く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱き締める": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق\nمثال: その子供は母親の腕の中に抱かれて安心した。 — أحس الطفل بالأمان بين ذراعي أمه. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "抱っこ": "مَسَكَ, مسك",
 "抱主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱卵": "حِضَانَة, تَفْرِيخ",
 "抱合": "تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱合せる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱合わせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "抱懐": "مَرْفَأ, مَرْسَى",
 "抱手": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "抱擁": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "抱水": "هَايْدْرَات",
 "抱負": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "抵当": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "抵当権": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "抵抗": "مُقَاوَمَة\nمثال: 無駄な抵抗はやめなさい。 — لن تستفيد من المقاومة فلا تحاول. / مُقَاوَمَة",
 "抵抗力": "مُقَاوَمَة",
 "抵抗性": "مُقَاوَمَة",
 "抵抗感": "مشاعر مناهضة",
 "抵梧": "صِرَاع, نِزَاع",
 "抵牾く": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو. / قَلَّدَ",
 "抵触": "مِسَاس / صِرَاع, نِزَاع / تَصَادُّم, اِصْطِدَام",
 "抹殺": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه. / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد.",
 "抹茶": "مَاتْشَا",
 "抹香": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "抹香鯨": "حُوتُ الْعَنْبَر (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "押え": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة / دِفاع",
 "押える": "غِطَاء / غِلَاف / غَطَّى / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / قَبْضَة / اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "押さえ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / دِفَاع, حِمَايَة / دِفاع",
 "押さえる": "غِطَاء / غِلَاف / غَطَّى / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / قَبْضَة / اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "押さえ込む": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "押し": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن. / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "押しあう": "كَوْم",
 "押しきる": "هَزَمَ, غَلَبَ",
 "押したおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押したてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押しつけ": "فَرْض",
 "押しつけがましい": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押しつつむ": "لِحَاف, بَطَّانِيَّة",
 "押しつぶす": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "押して": "رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "押していく": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "押して行く": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "押しとどめる": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "押しなべて": "عَلَى اَلْعَمُوم (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "押しのけ容積": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "押しの強い": "عُدْوَانِيّ / هُجُومِيّ",
 "押しも押されぬ": "تَعَرَّفَ",
 "押しも押されもしない": "تَعَرَّفَ",
 "押しも押されもせぬ": "تَعَرَّفَ",
 "押しピン": "دَبُّوس",
 "押し上げ": "اِضْطِرَاب",
 "押し並べて": "عَلَى اَلْعَمُوم (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "押し付け": "فَرْض",
 "押し付けがましい": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押し倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押し傷": "كَدَمَ / كَدْمَة, رَضّ",
 "押し入る": "تَطَفَّلَ, تَدَخَّلَ",
 "押し入れ": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押し出し": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "押し切る": "هَزَمَ, غَلَبَ",
 "押し包む": "لِحَاف, بَطَّانِيَّة",
 "押し合い": "كَوْم",
 "押し合う": "كَوْم",
 "押し子": "مِكْبَس غَطَّاس",
 "押し広げる": "تَوَسَّعَ",
 "押し広める": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "押し引き": "سَاوَمَ (بالسلعة وعليها: غالى بها وفاوض عليها، أي عرضها بثمن ودفع له المشتري أقل منه وهكذا حتى يتفقا على ثمن بين هذا وذاك؛ على الأمر: تفاوض كما يفعل البائع والمشتري مع السلعة)",
 "押し手": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / عِنَاد",
 "押し止める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "押し殺す": "طَوَّعَ, تَغَلَّبَ عَلَى",
 "押し潰す": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "押し留める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "押し目": "ضَعْف",
 "押し立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押し縮める": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "押し詰める": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "押し込み": "سَطْو / لُصُوصِيَّة / عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押し込める": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "押し迫る": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "押し通す": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "押し隠す": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "押す": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / أَفِكْس",
 "押すな押すな": "مُزْدَحِم",
 "押っ始める": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "押っ放り出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "押っ立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "押っ被さる": "غِطَاء / غِلَاف / غَطَّى",
 "押っ被せる": "غِطَاء / غِلَاف / غَطَّى",
 "押なつ": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "押上げ": "اِضْطِرَاب",
 "押倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "押傷": "كَدَمَ / كَدْمَة, رَضّ",
 "押入": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押入れ": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押出し": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "押切る": "هَزَمَ, غَلَبَ",
 "押包む": "لِحَاف, بَطَّانِيَّة",
 "押収": "مُصَادَرَة, اِسْتِيلَاء (دُفْعَة مالية منتزَعة عن طريق الحكومة في أوقات الحرب؛ عِقاب موضوعه اِسْتِصْفَاء مال المحكوم عليه واِسْتِيلَاء الدّولة عليه)",
 "押合い": "كَوْم",
 "押合う": "كَوْم",
 "押子": "مِكْبَس غَطَّاس",
 "押手": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / عِنَاد",
 "押捺": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "押放り出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "押立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "押込み": "سَطْو / لُصُوصِيَّة / عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "押込める": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "押送": "مُرَافَقَة",
 "押韻": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "抽だい": "مِصْمَال",
 "抽出": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "抽出法": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "抽出物": "مُقْتَطَف / خلاصة",
 "抽挿": "مِدَكّ",
 "抽苔": "مِصْمَال",
 "抽象名詞": "اِسْم مَعْنًى (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "抽象的": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ",
 "抽送": "مِدَكّ",
 "抽選": "يَانَصِيب",
 "抽選会": "يَانَصِيب",
 "担い": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "担い手": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "担う": "كَتِف, كِتْف / دُبّ / دُبَّة / اِحْتَمَلَ",
 "担ぎ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "担ぎだす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ出す": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "担ぎ屋": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "担ぐ": "كَتِف, كِتْف / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "担体": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "担保": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "担保物件": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "担保責任": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "担子菌": "دِعَامِيّ",
 "担子菌類": "دِعَامِيّ",
 "担当者": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "担当部長": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "担持": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "担架": "نَقَّالَة, مِحَفَّة",
 "担送車": "نَقَّالَة, مِحَفَّة",
 "拇指": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "拈くる": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون) / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "拉ぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "拉致": "اِخْتِطَاف",
 "拉致る": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟ / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "拉薩": "لَاسَا",
 "拍": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "拍動": "نَبْض, نَبْضُ القَلْب",
 "拍子": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / عَزْم / لَحْظَة, دَقِيقَة",
 "拍子抜け": "خَيْبَة أَمَل",
 "拍手": "تَصْفِيق",
 "拍手を送る": "صَفَّقَ",
 "拍手喝采": "تَصْفِيق",
 "拍節": "نَبْض, نَبْضَة",
 "拍車": "مِهْمَاز / تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "拍車がかかる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "拍車が掛かる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "拍車をかける": "مِهْمَاز",
 "拍車を掛ける": "مِهْمَاز",
 "拐かす": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "拐取": "اِخْتِطَاف",
 "拐引": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "拒ぎ": "دِفَاع, حِمَايَة / دِفاع",
 "拒む": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "拒否": "إِنْكَار, رَفْض",
 "拒否る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒否処分": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد.",
 "拒否反応": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒止": "إِنْكَار, رَفْض",
 "拒絶": "إِنْكَار, رَفْض",
 "拒絶反応": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "拒食症": "قَهَم",
 "拓く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "拓植": "اِسْتِعْمَار",
 "拓殖": "اِسْتِعْمَار",
 "拗ける": "منحنى",
 "拗じくれる": "منحنى",
 "拗ねる": "بوّز, بَرطَمَ",
 "拗ね者": "كَلْبِيّ",
 "拗らす": "تَعَقَّدَ, عَقَّدَ",
 "拗らせる": "تَعَقَّدَ, عَقَّدَ",
 "拗れ": "تَعْقِيد / مُضَاعَفَة",
 "拘う": "شَارَكَ, سَاهَمَ",
 "拘らう": "شَارَكَ, سَاهَمَ",
 "拘らず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "拘り": "هَوَس / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "拘り合う": "شَارَكَ, سَاهَمَ",
 "拘る": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "拘わらず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "拘わる": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "拘引": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "拘引状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "拘束": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "拘留": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس.",
 "拘禁": "تَوْقِيف",
 "拘禁刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "拘禁者": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "拘置": "تَوْقِيف",
 "拘置所": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "拙": "فَقِير / مِسْكِين / فُقَرَاء / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "拙い": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "拙劣": "أَخْرَق",
 "拙悪": "فَقِير / مِسْكِين / فُقَرَاء",
 "拙技": "مَهَارَة",
 "拙策": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "拙者": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "拙速": "مُتَسَرِّع",
 "招き": "دَعْوَة, عزيمة / إِغْرَاء",
 "招きよせる": "أَشَارَ, أَوْمَأَ",
 "招き寄せる": "أَشَارَ, أَوْمَأَ",
 "招く": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَشَارَ, أَوْمَأَ / يَسْتَحْضِر, يَسْتَدْعِي / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "招じる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "招ずる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "招宴": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "招待": "دَعْوَة, عزيمة / إِغْرَاء",
 "招待状": "دَعْوَة, عزيمة / إِغْرَاء",
 "招来": "دَعْوَة, عزيمة / إِغْرَاء / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "招聘": "دَعْوَة, عزيمة / إِغْرَاء",
 "招致": "دَعْوَة, عزيمة / إِغْرَاء",
 "招請": "دَعْوَة, عزيمة / إِغْرَاء",
 "招集": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "拜見": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "拝": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "拝す": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝する": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝み倒す": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "拝む": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "拝伏": "سُجُود",
 "拝借": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "拝受": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "拝呈": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "拝啓": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "拝察": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "拝所": "مَعْبَد",
 "拝承": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "拝火教": "زرادشتِيَّة",
 "拝火教徒": "زَرَادُشْتِيّ, زَرَادَشْتِيّ",
 "拝礼": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "拝答": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "拝聞": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "拝見": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "拝観": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
