 "シリーズもの": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "シリーズ物": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "シルエット": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "シルキー": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير)",
 "シルキーバス": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "シルキー・バス": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "シルク": "حَرِير, إبْرِيسِم",
 "シルクぶろ": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "シルクハット": "قبعة علوية (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "シルクバス": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "シルクプリント": "طباعة الشاشة الحريرية",
 "シルクロード": "طَرِيق اَلْحَرِير (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "シルク・ハット": "قبعة علوية (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "シルク・バス": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "シルク・プリント": "طباعة الشاشة الحريرية",
 "シルク・ロード": "طَرِيق اَلْحَرِير (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "シルク風呂": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه)",
 "シルコンフレックス": "سيركومفلكس, قبعة (علامة تشكيل (^) توضع فوق حرف متحرك في بعض اللغات للإشارة إلى جودة صوتية خاصة)",
 "シルスイキツツキ": "نقار الخشب مصاص العصارة أصفر البطن (نقار خشب مصاص للعصارة من شرق أمريكا الشمالية ذو بطن أصفر شاحب)",
 "シルデナフィル": "سيلدينافيل, فياغرا (عقار للفحولة (الاسم التجاري فياغرا) يستخدم لعلاج ضعف الانتصاب لدى الرجال)",
 "シルト": "غَرِين",
 "シルトがん": "حجر غريني (حجر رملي ناعم الحبيبات من الغرين المتماسك)",
 "シルト岩": "حجر غريني (حجر رملي ناعم الحبيبات من الغرين المتماسك)",
 "シルバー": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب. / عجوز, كبير السن (شخص متقدم في السن)",
 "シルバーエイジ": "شَيْخُوخَة, عُجُوز",
 "シルバーオンライン": "جهاز أمان, واقي (جهاز مصمم لمنع الإصابة أو الحوادث)",
 "シルバーグレイ": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "シルバーグレー": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "シルバースター": "النجمة الفضية (وسام عسكري أمريكي للشجاعة في المعركة)",
 "シルバーバック": "غوريلا فضية الظهر (ذكر غوريلا بالغ ذو شعر رمادي عبر الظهر)",
 "シルバーフォックス": "ثعلب فضي (ثعلب أحمر في الطور اللوني الذي يكون فيه فراءه ذو أطراف بيضاء)",
 "シルバー・エイジ": "شَيْخُوخَة, عُجُوز",
 "シルバー・オンライン": "جهاز أمان, واقي (جهاز مصمم لمنع الإصابة أو الحوادث)",
 "シルバー・グレイ": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "シルバー・グレー": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "シルバー・スター": "النجمة الفضية (وسام عسكري أمريكي للشجاعة في المعركة)",
 "シルバー・フォックス": "ثعلب فضي (ثعلب أحمر في الطور اللوني الذي يكون فيه فراءه ذو أطراف بيضاء)",
 "シルフ": "حورية الهواء, سيلف (كائن عنصري يعتقد أنه يسكن الهواء) / حسناء رشيقة (شابة رشيقة ونحيلة)",
 "シルブプレ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "シルリング": "شِلِّن",
 "シルヴプレ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "シル・ブ・プレ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "シル・ヴ・プレ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "シレッと": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "シロアリ": "أَرَضَة",
 "シロイタチ": "اِبْنُ مِقْرَض (الولد الذكر)\nمثال: هو له ابن صغير.",
 "シロイルカ": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ) / بيلوغا (مصدر قيم للكافيار والجيلاتين السمكي؛ توجد في البحر الأسود وبحر قزوين)",
 "シロイワヤギ": "ماعز الجبل (ثديي ثابت القدم يعيش في المناطق الجبلية بشمال غرب أمريكا الشمالية)",
 "シロインゲンマメ": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "シロエリハゲワシ": "نسر أسمر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "シロカジキ": "مارلين أسود (سمكة صيد كبيرة في المحيط الهادئ؛ قد يصل وزنها إلى 1000 رطل)",
 "シロカモメ": "عمدة (عمدة بلدية في ألمانيا أو هولندا أو فلاندرز أو النمسا)",
 "シロガネアジ": "سمكة لوك داون (تشبه سمكة القمر ولكن عيونها مرتفعة على الجبهة المقطوعة)",
 "シロガラシ": "خَرْدَل أَبْيَض",
 "シロキサン": "سيلوكسان (أي من فئة كبيرة من المركبات التي تحتوي على ذرات سيليكون وأكسجين متناوبة)",
 "シロクマ": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "シロクロエリマキキツネザル": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "シログチ": "كرواكر أبيض (سمكة طعام بحرية فضية صغيرة توجد قبالة كاليفورنيا) / السمكة الملكة, كرواكر أبيض (سمكة طبل فضية ومائلة للزرقة في المياه الساحلية الضحلة لكاليفورنيا)",
 "シログワイ": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "シロサイ": "وحيد القرن الأبيض (وحيد قرن أفريقي كبير رمادي فاتح له قرنان؛ مهدد بالانقراض)",
 "シロザケ": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "シロシビン": "سيلوسيبين (مركب مهلوس يتم الحصول عليه من فطر)",
 "シロシュモクザメ": "قرش المطرقة الأملس (يتم صيده من أجل جلوده وكبده الغني بالفيتامينات)",
 "シロシン": "سيلوسيبين (مركب مهلوس يتم الحصول عليه من فطر) / سيلوسين (قلويد تريبتامين ومادة مخدرة ذات تأثير سيروتونيني، توجد في معظم الفطر المخدر جنباً إلى جنب مع نظيرتها المفسفرة السيلوسيبين)\nمثال: التأثيرات المغيرة للعقل للسيلوسين متغيرة للغاية وشخصية وتشبه تأثيرات إل إس دي وثنائي ميثيل تريبتامين",
 "シロタエギク": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء الجذابة وزهوره القرمزية المبهرجة) / شيح الشاطئ, طاحونة الغبار (عشبة بأوراق رمادية توجد على طول الساحل الشرقي لأمريكا الشمالية؛ تستخدم كنبات زينة) / طاحونة الغبار, قنطريون رمادي (نبات ذو أوراق وسيقان مغطاة بزغب يشبه الغبار) / سينراريا فضية, طاحونة مغبرة (نبات معمر صلب كثير التفرع من منطقة البحر الأبيض المتوسط ذو سيقان وأوراق صوفية بيضاء جداً)",
 "シロチョウガイ": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "シロッコ": "رِيح شَلُوق",
 "シロップ": "شَرَاب, قَطْر",
 "シロップざい": "شَرَاب, قَطْر / مَمْزُوج بِالعَسَل, مُعَسَّل (مُضاف إليه العسل) / سَكَرِينِيّ, مُفْرِط الحَلَاوَة (حلو أكثر من اللازم حتى يصبح مُقَرِّفًا) / قَطِرِيّ, لَزِج (ذُو مُقَاوَمَةٍ عَالِيَةٍ نِسْبِيًّا لِلتَّدَفُّق)",
 "シロップ剤": "شَرَاب, قَطْر / مَمْزُوج بِالعَسَل, مُعَسَّل (مُضاف إليه العسل) / سَكَرِينِيّ, مُفْرِط الحَلَاوَة (حلو أكثر من اللازم حتى يصبح مُقَرِّفًا) / قَطِرِيّ, لَزِج (ذُو مُقَاوَمَةٍ عَالِيَةٍ نِسْبِيًّا لِلتَّدَفُّق)",
 "シロツメクサ": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "シロナガスクジラ": "حوت أزرق (أكبر حيوان ثديي معروف على الإطلاق؛ حوت باليني مهاجر أزرق رمادي يعيش غالباً في نصف الكرة الجنوبي)",
 "シロニンジン": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "シロハヤブサ": "سنقر (صقر قطبي كبير ونادر له أطوار لونية بيضاء وداكنة)",
 "シロバナムシヨケギク": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان)",
 "シロフォン": "سِيلُوفُون",
 "シロホン": "سِيلُوفُون",
 "シロモノ": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض) / أجهزة منزلية كبيرة, سلع بيضاء (الأجهزة المنزلية الكهربائية الكبيرة (مثل الثلاجات أو الغسالات) التي تكون عادة مطلية بالمينا الأبيض) / مِلْح, ملح / مَلَّحَ",
 "シロモミ": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق تفوح منها رائحة البرتقال عند سحقها) / شوح أبيض, شوح كولورادو (شوح متوسط إلى طويل من وسط إلى غرب الولايات المتحدة له تاج منتصب ضيق وخشب ناعم)",
 "シロワニ": "قرش الرمل, قرش الرمل الببري (قرش المياه الضحلة ذو أسنان حادة مسننة يوجد على جانبي المحيط الأطلسي؛ خطير أحياناً على السباحين)",
 "シロンボ": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
