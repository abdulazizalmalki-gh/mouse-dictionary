 "テレマーケティング": "تسويق عبر الهاتف (استخدام الهاتف كوسيلة تفاعلية للترويج والمبيعات)",
 "テレミン": "ثيرمين (آلة موسيقية إلكترونية؛ يمكن عزف الألحان عن طريق تحريك اليد اليمنى بين قضيبين يعملان كهوائيات للتحكم في النغمة؛ تتحكم اليد اليسرى في الصياغة)",
 "テレメタリング": "تيليمتر, مقياس عن بعد (أي أداة علمية لمراقبة الأحداث عن بعد ونقل المعلومات مرة أخرى إلى المراقب)",
 "テレメトリ": "قياس عن بعد (النقل والقياس التلقائي للبيانات من مصادر بعيدة عن طريق الأسلاك أو الراديو أو وسائل أخرى)",
 "テレメトリング": "تيليمتر, مقياس عن بعد (أي أداة علمية لمراقبة الأحداث عن بعد ونقل المعلومات مرة أخرى إلى المراقب)",
 "テレメトリー": "قياس عن بعد (النقل والقياس التلقائي للبيانات من مصادر بعيدة عن طريق الأسلاك أو الراديو أو وسائل أخرى)",
 "テレメータリング": "تيليمتر, مقياس عن بعد (أي أداة علمية لمراقبة الأحداث عن بعد ونقل المعلومات مرة أخرى إلى المراقب)",
 "テレメーター": "تيليمتر, مقياس عن بعد (أي أداة علمية لمراقبة الأحداث عن بعد ونقل المعلومات مرة أخرى إلى المراقب)",
 "テレワーク": "عَمَل عَنْ بُعْدٍ, عَمَل مِنَ الْمَنْزِل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "テレヴィジョン": "تِلْفَاز, تِلِفِزْيُون (جِهَاز اتصالات لبَثّ واِسْتِقْبَال صور متحركة وصوت عن بعد يواسطة أَمْوَاج كهرومغناطيسية؛ الجِهَة التي تقوم بإدارة وتكوين وبث البَرَامِج التي تعرض على إحدى القَنَوَات في جهاز التلفاز. غالبا ما يستعاض عنها باستخدام كلمة تلفزيون)\nمثال: لنشاهد التلفاز.",
 "テロ": "ترويع / إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "テロこうい": "إرهاب, عمل إرهابي (الاستخدام المحسوب للعنف (أو التهديد بالعنف) ضد المدنيين من أجل تحقيق أهداف سياسية أو دينية أو أيديولوجية؛ يتم ذلك من خلال الترهيب أو الإكراه أو بث…)",
 "テロこうげき": "هجوم إرهابي (هجوم مفاجئ ينطوي على الاستخدام المتعمد للعنف ضد المدنيين على أمل تحقيق أهداف سياسية أو دينية)",
 "テロじけん": "هجوم إرهابي (هجوم مفاجئ ينطوي على الاستخدام المتعمد للعنف ضد المدنيين على أمل تحقيق أهداف سياسية أو دينية)",
 "テロそしき": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "テロップ": "تعليق (وصف موجز مصاحب لرسم توضيحي) / ترجمة مرئية, سطر ترجمة (ترجمة الحوار الأجنبي لفيلم أو برنامج تلفزيوني؛ تُعرض عادة في أسفل الشاشة) / اعتراض تافه, مماحكة (إبداء اعتراض؛ خاصة المراوغة المبنية على حجة خادعة)",
 "テロメア": "تيلومير, قسيم طرفي (أي من الطرفين (الحرين) لكروموسوم حقيقي النواة)\nمثال: تعمل التيلوميرات كأغطية لمنع الأطراف اللزجة للكروموسومات من التكتل العشوائي معاً",
 "テロメラーゼ": "تيلوميراز (إنزيم في الخلايا حقيقية النواة يمكنه إضافة التيلوميرات إلى نهايات الكروموسومات بعد انقسامها)",
 "テロリスト": "إِرْهَابِيّ, إِرْهَابِيَّة",
 "テロリストグループ": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "テロリスト・グループ": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "テロリズム": "إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "テロル": "ترويع / إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "テロ事件": "هجوم إرهابي (هجوم مفاجئ ينطوي على الاستخدام المتعمد للعنف ضد المدنيين على أمل تحقيق أهداف سياسية أو دينية)",
 "テロ攻撃": "هجوم إرهابي (هجوم مفاجئ ينطوي على الاستخدام المتعمد للعنف ضد المدنيين على أمل تحقيق أهداف سياسية أو دينية)",
 "テロ組織": "جماعة إرهابية, منظمة إرهابية (حركة سياسية تستخدم الإرهاب كسلاح لتحقيق أهدافها)",
 "テロ行為": "إرهاب, عمل إرهابي (الاستخدام المحسوب للعنف (أو التهديد بالعنف) ضد المدنيين من أجل تحقيق أهداف سياسية أو دينية أو أيديولوجية؛ يتم ذلك من خلال الترهيب أو الإكراه أو بث…)",
 "テン": "عَشَرَة (يَدُلُّ عَلَى العَدَد 10) / عَشَرَة, عَقْد (العدد الأصلي الذي هو مجموع تسعة وواحد؛ أساس النظام العشري) / دَلَق, خَزّ (صب وأراق؛ خرج سريعًا) / عَشَرَة, عَشْرَة",
 "テンガロンハット": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "テングすびょう": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "テングギンザメ": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "テングザル": "قرد الململة, قرد ذو خرطوم (قرد من بورنيو له أنف بصلي طويل)",
 "テングスびょう": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "テングス病": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "テングフルーツコウモリ": "خفاش أنبوبي الأنف (أي من خفافيش الفاكهة المتنوعة التي تتميز بفتحات أنف ممتدة إلى أنابيب متباعدة)",
 "テング巣病": "مكنسة الساحرة (نمو غير طبيعي كثيف (متكتل) للأغصان الصغيرة على شجرة أو شجيرة ناتج عن فطريات أو حشرات أو اضطرابات فسيولوجية أخرى)",
 "テンゲ": "تنغي (وحدة المال الأساسية في كازاخستان) / تينغي (100 تينغي تساوي 1 مانات في تركمانستان)",
 "テンサイ": "شَمَنْدَر اَلسُّكَّر",
 "テンション": "كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول. / تَوَتُّر / شَدّ / جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "テンジクアオイ": "غُرْنُوق / جِيرَانِيُوم",
 "テンジクネズミ": "خِنْزِير غِينِيَّا",
 "テンス": "صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر",
 "テンソル": "مُوتَر",
 "テンタサン": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "テンダロイン": "تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري) / حي الرذيلة, منطقة خطرة (حي في المدينة معروف بالرذيلة وارتفاع معدل الجريمة)",
 "テンダー": "طَرِيّ, غَضّ ((عَنِ النَّبَاتَاتِ) غَيْرُ مُقَاوِم؛ يَسْهُلُ أَنْ يَمُوتَ بِظُرُوفِ النُّمُوِّ السَّيِّئَة) / حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما) / طَرِيّ, غَضّ (صغير السنّ وغير ناضج) / حَسَّاس, مُؤْلِم (يُؤْلِمُ عِنْدَ اللَّمْس)",
 "テンダーオファー": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "テンダーネス": "حنان",
 "テンダーロイン": "تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري) / حي الرذيلة, منطقة خطرة (حي في المدينة معروف بالرذيلة وارتفاع معدل الجريمة)",
 "テンダー・オファー": "عَرْض شِرَاء عَام (عرض لشراء أسهم في شركة (عادة فوق سعر السوق) نقداً أو بأوراق مالية أو كليهما)",
 "テンデバラバラ": "مُخْتَلِف, مُتَنَوَّع",
 "テンデンシー": "مَيْل, نَزَعَة",
 "テンデンバラバラ": "مُخْتَلِف, مُتَنَوَّع",
 "テント": "خَيْمَة (هو البَيْت الذي يقام من أعواد الشَجَر يُلقى عليه نَبَات يستطل به في الحَرّ ويكون مُؤَقَّتا؛ البيت الذي يتخذ من صوف أو قطن أو غيره من النسيج يقوم على عِمَاد أو أكثر. يطلق على الخِبَاء أيضا)\nمثال: سرقت خيمة كارل.",
 "テントウムシ": "خنفساء أبو العيد, دعسوقة (خنفساء صغيرة مستديرة زاهية الألوان ومرقطة تتغذى عادة على المن والآفات الحشرية الأخرى)",
 "テンナンショウ": "قلقاس هندي, لوف مبقع (لوف أوروبي شائع ذو قنابة سنانية الشكل وطلع أرجواني قصير؛ يظهر في أوائل الربيع؛ مصدر لنشا يسمى اللوف) / أريسيما, لفت هندي (عشبة غابات أمريكية شائعة تزهر في الربيع ذات أوراق غمدية وطلع منتصب يشبه الهراوة مع قنابة خضراء وأرجوانية متقوسة تنتج توتاً قرمزياً)",
 "テンバイヤー": "مُوَزِّع",
 "テンパイ": "صَيْد سَمَك, صَيْد",
 "テンパー": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / تمبرا, رسم غراوي (طريقة للرسم تخلط فيها الأصباغ بالماء ومادة رابطة؛ تستخدم لرسم الملصقات أو الجداريات أو مناظر المسرح) / ديستمبر, صباغة غروية (لوحة تم إنشاؤها بطلاء مصنوع عن طريق خلط الأصباغ بالماء ومادة رابطة) / ديستمبر, طلاء غروي (طلاء يصنع بخلط الأصباغ مع الماء ومادة رابطة) / تعكر مزاج, مزاج سيء (مزاج غاضب وغير مقبول)",
 "テンプ": "مُؤَقَّت / رقاص الساعة, عجلة التوازن (عجلة تنظم معدل الحركة في الآلة؛ وخاصة عجلة تتذبذب مقابل النابض الشعري في الساعة لتنظيم دقاتها)",
 "テンプテーション": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "テンプラ": "تِيمْبُورَا",
 "テンプル": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "テンプレ": "قَالَب, قالِب / قَالَبِيّ, نَمَطِيّ (يَتَّسِمُ بِاتِّبَاعِ صِيغَةٍ أَوْ قَالَبٍ مُعَيَّن)",
 "テンプレート": "قَالَب, قالِب",
 "テンペスト": "عاصفة هوجاء ((أدبياً) رياح عنيفة) / عاصفة (هيجان أو اضطراب عنيف)\nمثال: اجتاحت عاصفة هوجاء الجزيرة",
 "テンペラ": "ألوان الملصقات, تمبرا (صبغة ممزوجة بمواد غلوتينية قابلة للذوبان في الماء مثل الغراء وصفار البيض)",
 "テンペラメント": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "テンポ": "تمبو, سرعة الإيقاع ((موسيقى) السرعة التي ستُعزف بها المقطوعة) / إِيقَاع, وُتَيْرَة (معدل حدث متكرر)",
 "テンポラリ": "مُؤَقَّت",
 "テンポラリー": "مُؤَقَّت",
 "テンポラリーワーカー": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "テンポラリー・ワーカー": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "テンレック": "تنرق عديم الذيل (حيوان غزير الإنتاج يتغذى بشكل رئيسي على ديدان الأرض)",
 "テン・ガロン・ハット": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "テ・ジェ・ヴェ": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة)",
 "テーク": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "テークアウェイ": "انتزاع الكرة (فعل أخذ الكرة أو القرص من الفريق المهاجم (كما عن طريق اعتراض التمريرة)) / تنازل نقابي (تنازل تقدمه نقابة عمالية لشركة تحاول خفض نفقاتها) / تيك أواي, طعام سفري (طعام معد مسبقاً مخصص ليؤكل خارج المكان)",
 "テークアウェー": "انتزاع الكرة (فعل أخذ الكرة أو القرص من الفريق المهاجم (كما عن طريق اعتراض التمريرة)) / تنازل نقابي (تنازل تقدمه نقابة عمالية لشركة تحاول خفض نفقاتها) / تيك أواي, طعام سفري (طعام معد مسبقاً مخصص ليؤكل خارج المكان)",
