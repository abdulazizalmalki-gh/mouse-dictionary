 "ティーザー": "آلة ندغ, مشط صوف (جهاز لندغ الصوف (فك تشابكه)) / حاجب الكواليس (لوح مسطح في كل جانب من جوانب المسرح لمنع الجمهور من الرؤية داخل الأجنحة) / إعلان تشويقي, مشهد استهلالي (افتتاحية لجذب الانتباه تُعرض في بداية عرض تلفزيوني) / أُحْجِيَّة, لُغْز (مشكلة محيرة بشكل خاص يقال أن لها حلاً صحيحاً)\nمثال: تستخدم آلة الندغ لفك تشابك الألياف",
 "ティーシャツ": "تِي شِيرْت",
 "ティーシーピーアイピー": "مَجْمُوعَة بْرُوتُوكُولَات الْإِنْتَرْنِت (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "ティースプーン": "مِلْعَقَة شَاي, مِلْعَقَة صَغِيرَة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "ティーセット": "طقم الشاي (مجموعة من الخزف أو الفضيات لتقديم الشاي)",
 "ティータイム": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "ティータオル": "منشفة أطباق (منشفة لتجفيف الأطباق)",
 "ティーチイン": "تيتش-إن, ندوة تعليمية (جلسة ممتدة (كما في الحرم الجامعي) للمحاضرات والمناقشة حول قضية مهمة ومثيرة للجدل عادة)",
 "ティーチャ": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "ティーチャー": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "ティーチング": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "ティーチングアシスタント": "تانتالوم (عنصر فلزي رمادي صلب لامع مقاوم للتآكل بشدة)",
 "ティーチング・アシスタント": "تانتالوم (عنصر فلزي رمادي صلب لامع مقاوم للتآكل بشدة)",
 "ティーティーエス": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت الشمسي المتوسط مصححاً لعدم انتظام حركات الأرض)",
 "ティーネイジャー": "مُرَاهِق",
 "ティーネージャー": "مُرَاهِق",
 "ティーバッグ": "كيس شاي (كيس ورقي صغير يحتوي على مقدار من الشاي) / كيس شاي (كمية مقاسة من الشاي في كيس لتقديم فردي للشاي)",
 "ティーパーティ": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)\nمثال: 明後日ティーパーティーを開きましょう。 — لنعمل حفلةَ شاي بعد غد.",
 "ティーパーティー": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)\nمثال: 明後日ティーパーティーを開きましょう。 — لنعمل حفلةَ شاي بعد غد.",
 "ティービー": "سُلّ / تِيرَابَايْت / أذونات الخزانة (التزام قصير الأجل لا يحمل فائدة (يتم شراؤه بخصم)؛ يمكن تداوله على أساس الخصم لمدة 91 يوماً)",
 "ティービーエス": "تيبي بايت, تيرابايت (وحدة معلومات تساوي 1024 غيبي بايت أو 2 أس 40 بايت) / تيرابايت (وحدة معلومات تساوي 1000 غيغابايت أو 10 أس 12 بايت) / تيرابت (وحدة معلومات تساوي 1000 غيغابت أو 10 أس 12 بت) / درن, سل (عدوى تنتقل عن طريق استنشاق أو ابتلاع عصيات السل وتظهر في شكل حمى وآفات صغيرة (عادة في الرئتين ولكن في أجزاء أخرى مختلفة من الجسم في المراحل الحادة))",
 "ティーブイ": "تِلْفَاز, تِلِفِزْيُون (جِهَاز اتصالات لبَثّ واِسْتِقْبَال صور متحركة وصوت عن بعد يواسطة أَمْوَاج كهرومغناطيسية؛ الجِهَة التي تقوم بإدارة وتكوين وبث البَرَامِج التي تعرض على إحدى القَنَوَات في جهاز التلفاز. غالبا ما يستعاض عنها باستخدام كلمة تلفزيون)\nمثال: لنشاهد التلفاز.",
 "ティーボール": "مصفاة شاي كروية (أداة مطبخ تتكون من كرة معدنية مثقبة لصنع الشاي)",
 "ティーボーンステーキ": "شريحة تي بون",
 "ティーポット": "إِبْرِيق شَاي, إِبْرِيق الشَّاي",
 "ティーム": "فَرِيق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "ティーリンパきゅう": "خلية تائية, خلية لمفاوية تائية (خلية لمفاوية صغيرة تتطور في الغدة الصعترية؛ تنظم استجابة الجهاز المناعي للخلايا المصابة أو الخبيثة)",
 "ティールーム": "غرفة الشاي, محل شاي (مطعم يتوفر فيه الشاي والوجبات الخفيفة)",
 "ティーレックス": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "ティーワゴン": "عربة شاي (عربة تقديم لتقديم الشاي أو المرطبات الخفيفة)",
 "ティーン": "مُرَاهِق, يَافِع (في سنّ المراهقة بين الثالثة عشرة والتاسعة عشرة) / مراهق, يافع (حدث في المرحلة بين بداية البلوغ والنضج)",
 "ティーンエイジ": "مُرَاهِق, يَافِع (في سنّ المراهقة بين الثالثة عشرة والتاسعة عشرة)",
 "ティーンエイジャ": "مُرَاهِق",
 "ティーンエイジャー": "مُرَاهِق",
 "ティーンエージ": "مُرَاهِق, يَافِع (في سنّ المراهقة بين الثالثة عشرة والتاسعة عشرة)",
 "ティーンエージャ": "مُرَاهِق",
 "ティーンエージャー": "مُرَاهِق",
 "ティーンズ": "الأَعْدَاد بَيْن الثَّالِثَة عَشْرَة والتَّاسِعَة عَشْرَة / سن المراهقة (الفترة العمرية بين 13 و 19 سنة)",
 "ティーンネイジャー": "مُرَاهِق",
 "ティーヴィー": "تِلْفَاز, تِلِفِزْيُون (جِهَاز اتصالات لبَثّ واِسْتِقْبَال صور متحركة وصوت عن بعد يواسطة أَمْوَاج كهرومغناطيسية؛ الجِهَة التي تقوم بإدارة وتكوين وبث البَرَامِج التي تعرض على إحدى القَنَوَات في جهاز التلفاز. غالبا ما يستعاض عنها باستخدام كلمة تلفزيون)\nمثال: لنشاهد التلفاز.",
 "ティー・アール・エヌ・エー": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ティー・エイチ・シー": "تتراهيدروكانابينول, تي إتش سي (مادة ذات تأثير نفسي موجودة في الماريجوانا)",
 "ティー・エス": "مُتَحَوِّل جِنْسِيّ, مُتَحَوِّلَة جِنْسِيَّة / تغيير الجنس (تغيير في الخصائص الجنسية الجسدية للشخص (عن طريق الجراحة والعلاجات الهرمونية))",
 "ティー・エヌ・ティー": "تي إن تي, ثلاثي نتروتولوين (مادة متفجرة تتكون من مركب بلوري أصفر وهو مشتق سام وقابل للاشتعال من التولوين)",
 "ティー・エル・エス": "ثاليوم (عنصر فلزي ناعم رمادي قابل للطرق يشبه القصدير ولكنه يتغير لونه عند التعرض للهواء؛ وهو شديد السمية)",
 "ティー・エー": "تانتالوم (عنصر فلزي رمادي صلب لامع مقاوم للتآكل بشدة)",
 "ティー・グラウンド": "تِي",
 "ティー・ケー・オー": "ضربة قاضية فنية (ضربة قاضية يعلنها الحكم الذي يقرر أن أحد الملاكمين غير قادر على الاستمرار)",
