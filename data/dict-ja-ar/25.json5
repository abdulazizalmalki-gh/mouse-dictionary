 "潮": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / فُرْصَة",
 "潮を吹く": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / بَخَّ, بَجَّسَ (معناه عظم الأمر وفخُم تقال عند الرضى والإعجاب بالشيء أو عند الفخر أو المدح)\nمثال: توم التقط بطل الشامبو و بخ القليل في يده",
 "潮を噴く": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / بَخَّ, بَجَّسَ (معناه عظم الأمر وفخُم تقال عند الرضى والإعجاب بالشيء أو عند الفخر أو المدح)\nمثال: توم التقط بطل الشامبو و بخ القليل في يده",
 "潮先": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "潮合": "فُرْصَة",
 "潮合い": "فُرْصَة",
 "潮吹き": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / قَذْف اَلْإِنَاث (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "潮時": "فُرْصَة",
 "潮汁": "مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "潮汐": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "潮流": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / مَيْل, نَزَعَة",
 "潮目": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "潮紅": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "潰える": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "潰しにする": "خُرْدَة / يتخلى, نبذ / شجار",
 "潰す": "كَسَّرَ / تَكَسَّرَ / تَصَادُّم / جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "潰れ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "潰れる": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "潰乱": "فَسَاد / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "潰崩": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "潰瘍": "قُرْحَة",
 "潰走": "تَدَافُع, هَرْج (تزاحمَ وتدافعَ الأشخاصُ في مكانٍ واحدٍ؛ يدافع بمعنى الحماية والدفاع)\nمثال: لا تدافع عن القتلة!",
 "潺湲": "غَرْغَرَ, بَقْبَقَ",
 "澄ましこむ": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "澄ましバター": "سمن (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "澄まし込む": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "澄ます": "شَفَّاف / وَاضِح / سُلَالَة",
 "澄徹": "شَفَّافِيَّة",
 "澎湃": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "澪": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر. / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "澱": "رُكُود / ركود اقتصادي / تَوَقَّفَ / تَوَقُّف, وَقْف",
 "澱み": "رُكُود / ركود اقتصادي / تَوَقَّفَ / تَوَقُّف, وَقْف",
 "澱みない": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "澱みなく": "بِطَلَاقَة, لِبْلِب",
 "澱み無い": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "澱む": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "澱粉": "نَشَاء",
 "澳門": "مَاكَاوْ, أَوْمِين",
 "澹然": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "激しい": "عَنِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / مُسْتَمِرّ, مُتَوَاصِل",
 "激す": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "激する": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "激ヤバ": "خَرَاء, خِرَاء / خَرِئَ / مُدْهِش, مُذْهِل / مَجْنُون, مَخْبُول",
 "激動": "اِضْطِرَاب",
 "激変": "اِضْطِرَاب",
 "激怒": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "激情": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف.",
 "激憤": "مرارة",
 "激戦州": "وِلَايَة مُتَأَرْجِحَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى.",
 "激昂": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "激流": "سَرِيع",
