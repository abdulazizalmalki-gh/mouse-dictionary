 "ノギス": "قدمة ذات الورنية (فرجار مزود بمقياس ورنية لإجراء قياسات دقيقة للغاية)",
 "ノクターン": "مقطوعة ليلية, نوكتورن (قطعة موسيقية غنائية تأملية (خاصة للبيانو))",
 "ノゲシ": "تِفَاف, جَعْضِيض",
 "ノコ": "مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "ノコギリ": "مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "ノコギリやし": "بالميتو المنشاري (نخيل شائك صغير قوي يشكل كتل من جنوب الولايات المتحدة)",
 "ノコギリエイ": "سمك المنشار (سمكة راي بدائية ذات أسنان حادة على كل حافة من خطم طويل مفلطح)",
 "ノコギリガザミ": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "ノコギリソウ": "أخيلية, قيصوم",
 "ノコギリパルメット": "بالميتو المنشاري (نخيل شائك صغير قوي يشكل كتل من جنوب الولايات المتحدة)",
 "ノコギリヤシ": "بالميتو المنشاري (نخيل شائك صغير قوي يشكل كتل من جنوب الولايات المتحدة)",
 "ノコノコ": "بلا مبالاة (بطريقة غير مبالية)\nمثال: كانت الحرب تندلع في أوروبا، لكنها خططت لقضاء عطلة بلا مبالاة",
 "ノザワナ": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "ノシ": "إِلَى اَللِّقَاء, بَاي بَاي (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ノシノシ": "تجارة الأخشاب, قطع الأخشاب (تجارة قطع أو تجهيز أو بيع الأخشاب) / بَطيء, ثَقيل الحَرَكَة (بَطيء ومُتَثاقِل بِسَبَب الوَزْن)",
 "ノシメコクガ": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "ノシメマダラメイガ": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "ノジュール": "عُقَيدَة (عقدة صغيرة) / عُقَيـْدَة ((في علم المعادن) كتلة معدنية صغيرة مستديرة (عادة ما تكون أصلب من الصخور أو الرواسب المحيطة)) / درينة, عقيدة (نتوء صغير مستدير يشبه الثالول على النبات)",
 "ノス": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ノスタルジア": "حَنِين, اِشْتِيَاق",
 "ノスタルジック": "حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها)",
 "ノスタルジー": "حَنِين, اِشْتِيَاق",
 "ノストラダムス": "نُوسْتْرَادَامُوس",
 "ノズル": "بزبوز, فوهة (فوهة بارزة يتم تصريف السائل منها) / أنف, منقار (مصطلحات غير رسمية للأنف)",
 "ノゾキ": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير)",
 "ノヂシャ": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "ノッと": "فَجْأَةً",
 "ノッカー": "مطرقة الباب, مقرة (أداة (عادة معدنية ومزخرفة) مثبتة بمفصلة على الباب للطرق عليه) / ثدي (أحد عضوين غديين لحميين ناعمين يفرزان الحليب على صدر المرأة) / ذام, مستخف (من يستخف أو يقلل من قيمة شيء ما) / طَارِق (شخص يطرق (كما في طلب الدخول))\nمثال: افتح الباب وانظر من الطارق",
 "ノッキング": "طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "ノック": "خَبَطَ, دَقَّ (ضرب بقوة أو عشوائية؛ سار بلا هدى أو اتجاه محدد) / تَنَصَّتَ",
 "ノックアウト": "إغماء, ضربة قاضية (ضربة تفقد الخصم وعيه) / عَنِيف, قَاضٍ (شديد القوة والعنف) / حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر)",
 "ノックス": "أكسيد النيتروجين (أي من أكاسيد النيتروجين المتعددة التي تتكون بفعل حمض النيتريك على المواد القابلة للأكسدة؛ موجودة في عوادم السيارات)",
 "ノックダウン": "ضربة قاضية (ضربة تسقط الخصم عن قدميه) / قَابِل لِلتَّفْكِيك ((أثاث) سهل التركيب والتفكيك)",
 "ノッシノッシ": "تجارة الأخشاب, قطع الأخشاب (تجارة قطع أو تجهيز أو بيع الأخشاب) / بَطيء, ثَقيل الحَرَكَة (بَطيء ومُتَثاقِل بِسَبَب الوَزْن)",
 "ノッチ": "ثلم, حز (قطع صغير) / ثلم, حز (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط) / ممر, ممر جبلي (موقع في سلسلة جبال لتكوين جيولوجي يكون أقل ارتفاعاً من القمم المحيطة) / ثلمة, حز\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "ノット": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ノッブ": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / عقدة, مقبض (نتوء أو بروز دائري مستدير) / مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / تغلظ, عقدة (أي تضخم سميك) / مِقْبَض اَلْبَاب",
 "ノッポ": "عَمُود مِصْبَاح, عَمُود إِنَارَة / طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم) / فَارِع, نَحِيل طَوِيل (طويل ونحيف ذو أطراف طويلة رفيعة)",
 "ノド": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء) / مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "ノドチンコ": "لَهَاة",
 "ノネズミ": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "ノノてん": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "ノノ字点": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "ノノ点": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "ノバ": "مُسْتَعِر",
 "ノバスコシア": "نُوفَا سْكُوتْيَا, نُوفَا سْكُوشَا",
 "ノバラ": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "ノバ・スコシア": "نُوفَا سْكُوتْيَا, نُوفَا سْكُوشَا",
 "ノビ": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / إطالة, تمدد (تمرين مصمم لمد الأطراف والعضلات إلى أقصى حد لها) / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / إطالة (عملية تطويل شيء ما) / إطالة, تمديد (إضافة إلى طول شيء ما) / استطالة (صفة كون الشيء مستطيلاً أو ممدوداً)",
 "ノフウゾ": "مُشَاغِب",
 "ノブ": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / عقدة, مقبض (نتوء أو بروز دائري مستدير) / مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / تغلظ, عقدة (أي تضخم سميك) / مِقْبَض اَلْبَاب",
 "ノブレスオブリージ": "نبل الأخلاق, واجب الطبقة الراقية (التزام ذوي الرتب العالية بأن يكونوا شرفاء وكرماء)",
 "ノブレスオブリージュ": "نبل الأخلاق, واجب الطبقة الراقية (التزام ذوي الرتب العالية بأن يكونوا شرفاء وكرماء)",
 "ノブレス・オブリージ": "نبل الأخلاق, واجب الطبقة الراقية (التزام ذوي الرتب العالية بأن يكونوا شرفاء وكرماء)",
 "ノブレス・オブリージュ": "نبل الأخلاق, واجب الطبقة الراقية (التزام ذوي الرتب العالية بأن يكونوا شرفاء وكرماء)",
 "ノベライズ": "تحويل إلى رواية, روينة (تحويل شيء ما إلى شكل رواية)",
 "ノベライゼーション": "تحويل إلى رواية, روينة (تحويل شيء ما إلى شكل رواية)",
 "ノベリスト": "رِوَائِيّ, رِوَائِيَّة",
 "ノベル": "مُسْتَجِدّ / رِوَايَة",
 "ノベルティ": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / تحفة صغيرة, حلية (صنف صغير غير مكلف يتم إنتاجه بكميات كبيرة) / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)",
 "ノベルティー": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / تحفة صغيرة, حلية (صنف صغير غير مكلف يتم إنتاجه بكميات كبيرة) / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)",
 "ノベレット": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم)",
 "ノベンバー": "نُوفِمْبِر, نُوفَمْبِر (الشهر الحادي عشر في السنة الميلادية)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "ノマッド": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "ノマド": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "ノミ": "بُرْغُوث / إِزْمِيل",
 "ノミこうい": "دَلْو, سَطْل",
 "ノミの心臓": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "ノミや": "مُؤَلِّف, كَتَّاب / مُرَاهِن / حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو) / شركة وساطة وهمية, مكتب مراهنات غير قانوني (شركة وساطة غير أخلاقية أو عدوانية بشكل مفرط)",
 "ノミナリズム": "اسمية ((فلسفة) المذهب القائل بأن الأشياء المختلفة التي تحمل نفس المصطلح ليس بينها قاسم مشترك سوى الاسم)",
 "ノミナル": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ) / اسْمِيّ, بِاسْم شَخْص مُعَيَّن (مُسَمًّى؛ يحمل اسم شخص محدد) / رَمْزِيّ, شَكْلِيّ (صغير بشكل لا يُذكر؛ مجرد إجراء شكلي ('شَكْلِيّ' غير رسمي)) / اسمي (متعلق بـ أو من سمات مبلغ لم يتم تعديله للتضخم)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "ノミナルプライス": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "ノミナル・プライス": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "ノミネーション": "تَعْيِين, تَرْشِيح",
 "ノミネート": "تَعْيِين, تَرْشِيح",
 "ノミ屋": "مُؤَلِّف, كَتَّاب / مُرَاهِن / حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو) / شركة وساطة وهمية, مكتب مراهنات غير قانوني (شركة وساطة غير أخلاقية أو عدوانية بشكل مفرط)",
 "ノミ行為": "دَلْو, سَطْل",
 "ノモグラフ": "رسم بياني حسابي, نوغرام (تمثيل بياني للعلاقات العددية)",
 "ノモグラム": "رسم بياني حسابي, نوغرام (تمثيل بياني للعلاقات العددية)",
 "ノモン": "قياس",
 "ノラネコ": "قط شوارع (قط بلا مأوى)",
 "ノラリクラリ": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس / بتهرب, بمراوغة (مع تهرب؛ بأسلوب مراوغ)\nمثال: بدا أن زوجها يعرف الكثير من الأشخاص المذكورين، لكنه أجاب بمراوغة عندما سُئل عن هويتهم",
 "ノリ": "نُورِي\nمثال: うちの猫は大変海苔が好きである。 — قطة منزلنا تحب النوري كثيرًا. / ركوب الخيل (السفر محمولاً على ظهر الخيل) / ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته) / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَزَاج",
 "ノリがいい": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "ノリがよい": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "ノリが良い": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "ノリノリ": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "ノリ残り": "شَرِيط لَاصِق",
 "ノルアドレナリン": "نورأدرينالين, نورإبينفرين (مركب كاتيكولاميني سلف للإبينفرين تفرزه نخاع الغدة الكظرية ويُفرز أيضاً عند المشابك العصبية)",
 "ノルウェー": "النُّرْوِيج (دولة تغطي مساحتُها الشطرين الشمالي والغربي من شبه الجزيرة الإسكندنافية التي تقع في شمال قارة أوروبا؛ اسمها الرسمي مملكة النرويج، وعاصمتها أوسلو)\nمثال: أنا من النرويج.",
 "ノルウェーおうこく": "مَمْلَكَة اَلنُّرْوِيج (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "ノルウェーかえで": "قَيْقَب دُلْبِيّ",
 "ノルウェーご": "نُرْوِيجِيَّة (مواطنة من بلد النرويج؛ لغة بلد النرويج. )\nمثال: أنا أحب النرويجية.",
 "ノルウェーじん": "نُرْوِيجِيَّة (مواطنة من بلد النرويج؛ لغة بلد النرويج. )\nمثال: أنا أحب النرويجية.",
 "ノルウェーカエデ": "قَيْقَب دُلْبِيّ",
 "ノルウェー人": "نُرْوِيجِيَّة (مواطنة من بلد النرويج؛ لغة بلد النرويج. )\nمثال: أنا أحب النرويجية.",
 "ノルウェー楓": "قَيْقَب دُلْبِيّ",
 "ノルウェー王国": "مَمْلَكَة اَلنُّرْوِيج (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "ノルウェー語": "نُرْوِيجِيَّة (مواطنة من بلد النرويج؛ لغة بلد النرويج. )\nمثال: أنا أحب النرويجية.",
 "ノルエピネフリン": "نورأدرينالين, نورإبينفرين (مركب كاتيكولاميني سلف للإبينفرين تفرزه نخاع الغدة الكظرية ويُفرز أيضاً عند المشابك العصبية)",
 "ノルタルジック": "حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها)",
 "ノルディック": "إِسْكَنْدِنَافِيّ الطِّرَاز, نُورْدِيّ (يشبه شعوب إسكندنافيا) / شمالي, نورديك (متعلق بألمانيا وإسكندنافيا (خاصة في السياق العرقي)) / إسكندنافي, شمالي (من أو متعلق بـ أو يشكل المجموعة الإسكندنافية من اللغات) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا)\nمثال: أراد هتلر أن يحكم الشعوب الشمالية أوروبا",
 "ノルドご": "نرويجي (من أو يتعلق بالنرويج أو شعبها أو ثقافتها أو لغتها) / إسكندنافي, نورسي (من أو يتعلق بإسكندنافيا أو شعوبها أو ثقافاتها) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا) / نرويجي (مواطن أو ساكن في النرويج)\nمثال: الرنجة النرويجية",
 "ノルド語": "نرويجي (من أو يتعلق بالنرويج أو شعبها أو ثقافتها أو لغتها) / إسكندنافي, نورسي (من أو يتعلق بإسكندنافيا أو شعوبها أو ثقافاتها) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا) / نرويجي (مواطن أو ساكن في النرويج)\nمثال: الرنجة النرويجية",
 "ノルマ": "حِصَّة, سَهْم / حِصَّة, نَصِيب مُقَرَّر",
 "ノルマル": "عَادِيّ / طَبِيعِيّ",
 "ノルマンじん": "نورماني (من أو متعلق بـ أو مميز للنورمان) / نورماندي, نورماني (من أو متعلق بـ أو مميز لنورماندي) / نورماندي (أحد سكان نورماندي)\nمثال: الغزو النورماني عام 1066",
 "ノルマンディー": "نُورْمَانْدِي",
 "ノルマン人": "نورماني (من أو متعلق بـ أو مميز للنورمان) / نورماندي, نورماني (من أو متعلق بـ أو مميز لنورماندي) / نورماندي (أحد سكان نورماندي)\nمثال: الغزو النورماني عام 1066",
 "ノルム": "متوسط, معدل (إحصائية تصف موقع التوزيع) / قاعدة, معيار (معيار أو نموذج أو نمط يعتبر نموذجياً)\nمثال: وضعت المعيار للمنازل الأمريكية / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "ノロ": "يَحْمُور, يَأْمُور",
 "ノロジカ": "يَحْمُور, يَأْمُور",
 "ノロマ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "ノロリ": "بِبُطْء",
 "ノロ鹿": "يَحْمُور, يَأْمُور",
 "ノワゼット": "بُنْدُق, بُنْدُقَة (نوع من الثَمَر صلب ينمو محاطا بغلاف صلب كالجَوْز يكثر في الشَام. الحبة الواحدة بُنْدُقَة ولا يُجْمَع؛ الشجر الذي يُثمِرُ بُنْدُقًا، يُجمع على بُنْدُقَات)",
 "ノワール": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / غَامِق, دَاكِن",
 "ノン": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ノンけ": "غيري الجنس, مباين الجنس (شخص لديه ميول جنسية تجاه أشخاص من الجنس الآخر)",
 "ノンアイロン": "لَا يَحْتَاج كَيًّا (يُستخدم للأقمشة التي لا تحتاج إلى كيّ) / سَهْل الغَسْل وَالتَّجْفِيف (مُعالَج بحيث يُغسَل ويُجفَّف بسهولة ولا يحتاج إلى كيّ تقريبًا)",
 "ノンアルコール": "خالٍ من الكحول, غير كحولي (يتميز بغياب الكحول)",
 "ノンキ": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ノンクレジット": "نَظِيف / نضيف / نَظَّفَ",
 "ノンケ": "غيري الجنس, مباين الجنس (شخص لديه ميول جنسية تجاه أشخاص من الجنس الآخر)",
 "ノンシャラン": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ノンストップ": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة) / بلا توقف (بدون توقف) / دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع) / بِدُون تَوَقُّف ((عَنِ الرِّحْلَات خَاصَّةً الجَوِّيَّة) تَتِمّ بِدُون تَوَقُّفَات)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "ノンスリップ": "مُضَادٌّ لِلِانْزِلَاقِ (مصمَّم لتقليل الانزلاق أو منعه)",
 "ノンセクション": "غَيْرُ مُنْتَسِب (لَيْسَ لَدَيْهِ انْتِسَابٌ أَوِ ارْتِبَاطٌ بِجِهَةٍ مَا)",
 "ノンセンス": "هُرَاء, لَغْو / غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / غير أنيق, فاقد للأناقة (يفتقر إلى الأسلوب أو الأناقة)\nمثال: ملابس غير عصرية",
 "ノンチャラン": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ノンデリ": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية) / عديم الإحساس, غليظ (يفتقر إلى المشاعر الإنسانية؛ غير حساس عقليًا أو أخلاقيًا)\nمثال: غير حساس للإشعاع",
 "ノンバイナリー": "لَاثُنَائِيّ",
 "ノンパラメトリック": "لا بارامتري, لا وسيطي (لا ينطوي على تقدير لوسائط (بارامترات) إحصائية)",
 "ノンパレル": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / أقراص شوكولاتة مزينة (قرص مسطح من الشوكولاتة مغطى بحبيبات السكر الملونة) / حبيبات السكر الملونة, فارماسيل (حبيبات ملونة من السكر تستخدم كطبقة علوية على الحلويات والكعك) / مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "ノンビリ": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب)\nمثال: اقرأ الدليل في وقت فراغك / اِسْتَرْخَى",
 "ノンフィクション": "أدب واقعي, نثر غير خيالي (كتابة نثرية ليست خيالية)",
 "ノンフライヤー": "قلّاية هوائيّة",
 "ノンブランド": "إِجْمالِيّ, جامِع",
 "ノンブル": "تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات)",
 "ノンプレイヤーキャラクター": "مركز منع الانتشار (وكالة تعمل كنقطة محورية لجميع أنشطة مجتمع الاستخبارات المتعلقة بمنع انتشار أسلحة الدمار الشامل وأنظمة إطلاق الصواريخ الخاصة بها)",
 "ノンプレーヤーキャラクター": "مركز منع الانتشار (وكالة تعمل كنقطة محورية لجميع أنشطة مجتمع الاستخبارات المتعلقة بمنع انتشار أسلحة الدمار الشامل وأنظمة إطلاق الصواريخ الخاصة بها)",
 "ノンホールピアス": "قَابِل لِلتَّعْلِيق بِمَشْبَك (يمكن تثبيته بواسطة مشبك) / أداة تُشبك, مشبك (جهاز (مثل قرط، نظارة شمسية، ميكروفون، إلخ) يتم تثبيته بواسطة مشابك)",
 "ノンホール・ピアス": "قَابِل لِلتَّعْلِيق بِمَشْبَك (يمكن تثبيته بواسطة مشبك) / أداة تُشبك, مشبك (جهاز (مثل قرط، نظارة شمسية، ميكروفون، إلخ) يتم تثبيته بواسطة مشابك)",
