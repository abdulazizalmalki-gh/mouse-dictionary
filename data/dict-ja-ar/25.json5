 "消渇": "سُكَّرِيّ, دِيَابِيطَا / سَيَلَان",
 "消滅": "اِنْقِرَاض / إِفْنَاء, تَدْمِير / إِفْنَاء",
 "消火器": "مِطْفَأَةُ حَرِيق, طَفَّايَةُ حَرِيق",
 "消火栓": "صُنْبُور حَرِيق, صُنْبُور اِطْفَاء حَرِيق",
 "消灯ラッパ": "تَنَصَّتَ",
 "消灯令": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "消灯喇叭": "تَنَصَّتَ",
 "消炭": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "消磨": "اِنْجِرَاف",
