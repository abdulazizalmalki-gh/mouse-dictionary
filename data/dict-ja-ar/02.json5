 "かくのごとき": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくのごとく": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくのごみ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "かくのふゆ": "شتاء نووي (فترة طويلة من الظلام والبرد القارس يتوقع العلماء أنها ستعقب حرباً نووية شاملة؛ حيث ستغطي طبقة من الغبار والدخان في الغلاف الجوي الأرض وتحجب أشعة…)",
 "かくの如き": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくの如く": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくはん": "كُلّ, جَمِيع / إثارة, تحريك (فعل تحريك شيء ما؛ التسبب في تحركه (عادة بقوة)) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / اضطراب, هياج (الشعور بالاضطراب وعدم الهدوء) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة / عَاقَبَ, قَاصَصَ",
 "かくはんき": "خَلَّاط, خَفَّاقَة",
 "かくはんのう": "تفاعل نووي (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "かくはんのうろ": "مُفَاعِل نَوَوِيّ",
 "かくばくだん": "قُنْبُلَة نَوَوِيَّة",
 "かくばくはつ": "انفجار ذري, انفجار نووي (انفجار قنبلة ذرية)",
 "かくばしら": "خَيْزَرَان, خَيْزُرَان",
 "かくひ": "بُشَيْرَة",
 "かくひょう": "مُكَعَّبُ ثَلْجٍ",
 "かくびょう": "بري بري (عوز فيتامين ناتج عن نقص الثيامين (فيتامين ب1))",
 "かくふく": "توسيع (عملية جعل الشيء أوسع) / توسعة جانبية, مفسح (جزء من الطريق تم توسيعه للسماح للسيارات بالمرور أو التوقف) / تعريض, توسيع (زيادة في العرض)",
 "かくぶちのめがね": "ذُو إِطَارٍ قَرْنِيّ (ذو إطار مصنوع من القرن أو صَدَفة السلحفاة أو البلاستيك المُشابِه)",
 "かくぶつりがく": "فيزياء ذرية, فيزياء نووية (فرع الفيزياء الذي يدرس البنية الداخلية للنواة الذرية)",
 "かくぶんれつ": "انشطار / انقسام النواة (عملية عضوية تتكون من انقسام نواة الخلية أثناء الانقسام المتساوي أو المنصف)",
 "かくぶんれつせい": "قابل للانشطار, قابل للفلق (قابل للفلق أو الشق أو التقسيم في اتجاه الألياف) / انشطاري, قابل للانشطار (قابل للخضوع للانشطار النووي)\nمثال: بلورات قابلة للانفلاق",
 "かくぶんれつせいぶっしつ": "انشطاري, قابل للانشطار (قابل للخضوع للانشطار النووي)\nمثال: نواة انشطارية",
 "かくぶんれつはんのう": "انشطار",
 "かくへいき": "سِلَاح نَوَوِيّ",
 "かくへき": "حاجز / جدار ساحلي",
 "かくべからざる": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "かくべち": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "かくべつ": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "かくほ": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء / مربط, نقطة تأمين (شيء يمكن تثبيت حبل متسلق الجبال به)",
 "かくほうめん": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر)\nمثال: الفائدة مركبة ربع سنوياً",
 "かくほゆうこく": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "かくぼう": "قبعة التخرج (قبعة أكاديمية ذات مربع مسطح وشرابة في الأعلى) / لوح الملاط (لوح مربع بمقبض تحته؛ يستخدمه البناؤون لحمل أو نقل الملاط)",
 "かくまう": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "かくまく": "قَرْنِيَّة / تَقْسِيم",
 "かくまくいしょく": "رأب القرنية, زراعة القرنية (إجراء جراحي يتم فيه استبدال جزء أو كل القرنية التالفة أو المريضة بأنسجة قرنية سليمة من متبرع)",
 "かくまくえん": "التهاب القرنية (التهاب القرنية يسبب دمع العين وألم وتشوش الرؤية)",
 "かくまくぎんこう": "بنك العيون (مكان لتخزين وحفظ القرنيات التي يتم الحصول عليها من الجثث البشرية مباشرة بعد الوفاة؛ تستخدم لزرع القرنية للمرضى الذين يعانون من عيوب القرنية)",
 "かくまくせっかい": "بضع القرنية (شق جراحي في القرنية)",
 "かくまで": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "かくめい": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "かくめいか": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "かくめいじ": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "かくめいてき": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "かくめいは": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "かくも": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "かくや": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくやく": "لَامِع, نَيِّر / مُسْتَنِير",
 "かくやす": "رَخِيص",
 "かくやすこうくうがいしゃ": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "かくやすスマホ": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "かくゆうごう": "اِنْدِمَاج نَوَوِيّ",
 "かくゆうごうはんのう": "اندماج, اندماج نووي (تفاعل نووي تتحد فيه النوى لتكوين نوى أكثر ضخامة مع إطلاق متزامن للطاقة)",
 "かくよくし": "ردع نووي (العقيدة العسكرية القائلة بأن العدو سيرتدع عن استخدام الأسلحة النووية طالما أمكن تدميره كنتيجة لذلك)\nمثال: عندما تلجأ دولتان إلى الردع النووي، قد تكون النتيجة دماراً متبادلاً",
 "かくらん": "ضَرْبَة شَمْس (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "かくらんしゃ": "مثير للاضطراب, مزعج (شخص يقاطع أو يعكر صفو الهدوء والسكينة؛ شخص يسبب الفوضى والهرج)",
 "かくり": "تَوَحُّد",
 "かくりつ": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً / تَأْسِيس / مُؤَسَّسَة / حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "かくりつかてい": "عملية عشوائية (عملية إحصائية تنطوي على عدد من المتغيرات العشوائية التي تعتمد على متغير بارامتري (عادة ما يكون الوقت))",
 "かくりつてき": "عَشْوَائيّ, غَيْر مُصَمَّم",
 "かくりつひょうほん": "عينة عشوائية (عينة مأخوذة بشكل عشوائي) / عينة عشوائية (عينة يكون فيها لكل عنصر في المجتمع فرصة متساوية للاختيار)",
 "かくりつへんすう": "مُتَغَيِّر عَشْوَائِيّ",
 "かくりつりろん": "نظرية الاحتمالات (فرع الرياضيات التطبيقية الذي يتعامل مع الاحتمالات)",
 "かくりつろん": "نظرية الاحتمالات (فرع الرياضيات التطبيقية الذي يتعامل مع الاحتمالات)",
 "かくりょう": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء) / وزير في الحكومة (شخص عضو في مجلس الوزراء)",
 "かくりょく": "سُومُو",
 "かくりよ": "آخِرَة",
 "かくる": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "かくれ": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "かくれおに": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "かくれが": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "かくれがに": "سرطان البازلاء (سرطان صغير ناعم الجسم يعيش بشكل تكافلي في عباءات بعض الرخويات ذات الصدفتين)",
 "かくれきがん": "بريشيا (صخر حصوي يتكون من شظايا حادة مغمورة في الطين أو الرمل)",
 "かくれざと": "شَانْغْرِيلَا",
 "かくれば": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "かくればしょ": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "かくれひそむ": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "かくれみ": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "かくれみの": "غِطَاء / غِلَاف / غَطَّى",
 "かくれもない": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "かくれや": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "かくれる": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَقَاعَدَ / اِعْتَزَلَ",
 "かくれんぼ": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "かくれんぼう": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "かくれ家": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "かくろん": "خاص, فردي (كائن أو مميز لشيء واحد أو شخص واحد)\nمثال: قطرات فردية من المطر",
 "かくエネルギー": "طَاقَة ذَرِّيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "かくクラブ": "النادي النووي (الدول التي تمتلك أسلحة نووية)",
 "かくテロ": "إرهاب نووي (استخدام جهاز نووي من قبل منظمة إرهابية لإحداث دمار هائل أو استخدام (أو التهديد باستخدام) مواد مشعة انشطارية)",
 "かく乱": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "かく言う": "بالمثل, كذلك (بطريقة مماثلة)\nمثال: تأثر بالمثل",
 "かぐ": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية. / استنشاق, تشمم (استشعار رائحة عن طريق الاستنشاق من الأنف) / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "かぐし": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "かぐつき": "مؤثث, مفروش (مزود بما هو ضروري لغرض ما (مثل الأثاث أو المعدات أو السلطة))\nمثال: شقة مفروشة",
 "かぐわしい": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ)",
 "かぐん": "وَحْدَة",
 "かけ": "اِئْتِمَان / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / دَجَاج, لَحْم دَجَاج\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل. / قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد)) / رِهَان, مُرَاهَنَة / ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "かけあい": "مُفَاوَضَات, مُذَاكَرَات / حِوَار, مُحَادَثَة / حِوَار",
 "かけあう": "تَفَاوَضَ",
 "かけあし": "بِخُطْوَة سَرِيعَة, بِسُرْعَة مُضَاعَفَة (بسرعة أكبر) / أجر مضاعف (أجر مضاعف (للعمل الإضافي)) / خَطْوَة مُزْدَوِجَة (وتيرة مسير سريعة (180 خطوة/دقيقة) أو هرولة بطيئة)\nمثال: الآن دعونا نعزف القطعة مرة أخرى بسرعة مضاعفة / راكض, مخب (يركب بمشية بين الخبب والعدو (الخبب السريع))\nمثال: الجنود المخبون / ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "かけあわす": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار",
 "かけあわせる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かけい": "حرق, حرق على الخازوق (الإعدام بالنار) / جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق / سُوَيْقَة جِذْرِيَّة / أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "かけいず": "شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "かけいせい": "فرط التنسج (زيادة غير طبيعية في عدد الخلايا)",
 "かけうりだいきん": "حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "かけおち": "فرار مع الحبيب (فعل الهروب مع عشيق (عادةً للزواج))",
 "かけかえ": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "かけかえる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "かけかまい": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "かけがえ": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "かけがえのない": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "かけがえの無い": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "かけがね": "زِلاَج, ضَبَّة",
 "かけがみ": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "かけきん": "قِسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة. / رهان, مراهنة (المال المخاطر به في مقامرة)",
 "かけくぎ": "وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "かけくら": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "かけくらべ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "かけことば": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "かけこみ": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "かけこみでら": "مَلْجَأ, مَلَاذ",
 "かけごえ": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "かけごこち": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "かけごと": "مُرَاهَنَة",
 "かけごとし": "مُقَامِر / مُغَامِر",
 "かけごや": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "かけざん": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "かけじる": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "かけだし": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / مبتدئ (شخص دخل في رهبنة دينية لكنه لم يأخذ النذور النهائية بعد) / فرار, هروب (فعل المغادرة (بدون إذن) للمكان الذي من المتوقع أن تكون فيه)",
 "かけだしもの": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "かけだす": "نَفِدَ",
 "かけちがい": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / خلاف, عدم اتفاق (الفعل الكلامي المتمثل في الاختلاف أو الجدال أو النزاع) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: تباين متزايد في الآراء",
 "かけちがう": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "かけっくら": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "かけっこ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "かけつ": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "かけつける": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "かけどおし": "شَحْطَة / شَرْطَة",
 "かけどけい": "ساعة حائط (ساعة مثبتة على الحائط)",
 "かけにでる": "قِمَار / قَامَرَ",
 "かけぬける": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "かけね": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "かけのぼる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "かけはし": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "かけはしとなる": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "かけひ": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "かけひき": "مساومة (التفاوض على شروط صفقة أو اتفاقية) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "かけふ": "غطاء قماشي (غطاء مصنوع من القماش)",
 "かけふだ": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "かけぶとん": "لِحَاف",
 "かけめ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة)",
 "かけもの": "كاكيمونو (معلقة حائطية يابانية (من الورق أو الحرير)؛ عادة ما تكون ضيقة وعليها صورة أو كتابة وبكرة في الأسفل) / غطاء سرير, مفرش سرير (غطاء مزخرف للسرير) / رِهَان, مُرَاهَنَة",
 "かけや": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار الرصف أو للتكسير أو الضرب أو التسطيح أو التنعيم) / عصا الإيقاع, مطرقة الطبل (عصا طبل خفيفة ذات رأس مستدير تستخدم لضرب الآلات الإيقاعية مثل الأجراس والطبول) / صولجان, مطرقة رياضية (أداة رياضية ذات مقبض طويل ورأس يشبه المطرقة؛ تستخدم في الألعاب الرياضية (البولو أو الكروكيت) لضرب الكرة) / مُؤَلِّف, كَتَّاب / مُرَاهِن",
 "かけら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / أُوقِيَّة / وِقِيَّة / أَوْنْس / أونصة / أونسة",
 "かける": "عَلَّقَ / أَغْلَقَ الْخَطّ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح)\nمثال: أغلق الباب بغضب / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أَنْفَقَ, صَرَفَ / قَضَى / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن الأرض في آن واحد) / يقرب / تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد)) / رهان (فعل المقامرة) / رهان, مراهنة (المال المخاطر به في مقامرة)\nمثال: فعل ذلك في رهان / تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء) / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "かけ合せる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かけ合わす": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار",
 "かけ合わせる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かけ声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "かけ心地": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "かけ橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "かけ算": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "かけ違い": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / خلاف, عدم اتفاق (الفعل الكلامي المتمثل في الاختلاف أو الجدال أو النزاع) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: تباين متزايد في الآراء",
 "かけ違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "かげ": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / اِنْعِكَاس, عَكْس / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر. / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / وَرَاءَ / خلفية / قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة / غَزَالِيّ اللَّوْن (بلون الغزال؛ بني فاتح مصفر) / صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج الصنوبر؛ أوروبا والجزر البريطانية وشمال إفريقيا) / صنوبر أرضي (أي من عدة طحالب نادي ذات سيقان زاحفة طويلة وفروع منتصبة)",
 "かげうら": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "かげえ": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かげがさす": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مِنْسَج",
 "かげき": "أُوبِرَا, أُوپِرَا / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل) / شَاقّ, مُضْنٍ (يتّسم بطاقة أو قوة بذل كبيرة) / صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "かげきしそう": "تَطَرُّف, غُلُوّ",
 "かげきしゅぎ": "تَطَرُّف, غُلُوّ",
 "かげきじょう": "أوبرا, دار الأوبرا (مبنى يتم فيه تقديم الأعمال الدرامية الموسيقية)",
 "かげきだん": "فرقة أوبرا (فرقة تنتج الأوبرا)",
 "かげきは": "مُتَطَرِّف, مُتَطَرِّفَة / تَطَرُّفِيّ\nمثال: その過激派が政府打倒の陰謀を企てているという噂が立ってる。 — ثمّة شائعةٌ تقول أن الأصوليين يرسمون خطة مضادة للحكومة.",
 "かげぐち": "فضيحة, نميمة خبيثة (قيل وقال مشين عن الحياة الخاصة للآخرين)",
 "かげぐちをたたく": "اِغْتَابَ, أَبَرَ",
 "かげごと": "فضيحة, نميمة خبيثة (قيل وقال مشين عن الحياة الخاصة للآخرين)",
 "かげつけしょり": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة)",
 "かげとかたちのように": "بتلازم, بشكل لا ينفصل (دون إمكانية للفصل)\nمثال: هذان الاثنان مرتبطان بشكل لا ينفصل",
 "かげながら": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "かげにひに": "بِأَمَانَة, بِإِخْلَاص (بطريقة تتسم بالوفاء والموثوقية)\nمثال: كان يعمل دائماً، بإخلاص، مثل المذياع",
 "かげのある": "كَئِيب, مُوحِش",
 "かげのうすい": "غَيْرُ ظَاهِر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "かげのないかく": "حكومة الظل (مجموعة من كبار أعضاء الحزب السياسي الذي هو خارج السلطة؛ من المحتمل أن يتولى هؤلاء الأعضاء مناصب مقابلة كوزراء في مجلس الوزراء البريطاني إذا تم انتخاب…)",
 "かげひなた": "ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى) / ذُو وَجْهَيْن ((في الأقمشة) له وجهان صالحان للاستخدام)",
 "かげぼうし": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かげむしゃ": "ثُنَائِيّ / ضِعْف",
 "かげり": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "かげをひそめる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "かげん": "حد جنوبي, حد سفلي (الحد الموجود على الجانب السفلي (أو الجنوبي) لشيء ما) / حد أدنى (أصغر كمية ممكنة) / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية. / أخبار سارة, بشارة (أخبار جيدة) / تزكية, توصية (شيء يوصي (أو يعبر عن الثناء على) شخص أو شيء على أنه جدير أو مرغوب فيه) / دَرَجَة / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / ضَبْط / تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري) / صِينِيّ / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / بيان خاطئ (بيان يحتوي على خطأ) / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "かげんうんどう": "حركة ظاهرية (وهم بصري للحركة ينتج عن عرض تتابع سريع لصور ثابتة لجسم متحرك)\nمثال: تعتمد السينما على الحركة الظاهرية",
 "かげんかかく": "حد أدنى للسعر (أرضية لا يُسمح للأسعار بالانخفاض دونها)\nمثال: استخدمت الحكومة دعم الأسعار للحفاظ على الحد الأدنى للسعر",
 "かげんせつ": "دوسيتية, ظاهرية (العقيدة الهرطقية (المرتبطة بالغنوصيين) القائلة بأن يسوع لم يكن له جسد بشري وأن معاناته وموته على الصليب كانت ظاهرية وليست حقيقية)",
 "かげんていこうき": "ريوستات, مقاومة متغيرة (مقاومة لتنظيم التيار)",
 "かげんてき": "اِفْتِرَاضِيّ",
 "かげんてきめいほう": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "かげんてきめいれい": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "かげんめいほう": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "かこ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار. / أَيِّل",
 "かこい": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)\nمثال: 家の周りには囲いがしてある。 — هناك سياج حول المنزل. / إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / سَيِّدَة / خَلِيلَة, عَشِيقَة / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "かこいおんな": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "かこいこみ": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "かこいこむ": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "かこいめ": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "かこいもの": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "かこう": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين. / اِحْتَفَظَ, أَبْقَى / خَزَنَ (حفظ، إدخر، أودع في مخزن) / تَنَازُلِيّ / نُزُول / اَصْل / خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها / تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة / ضوء النار (ضوء النار (خاصة في الموقد)) / فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان / حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات)) / شعلة, عين الموقد (عناصر التسخين في الموقد التي توضع عليها الأواني والمقالي للطهي)\nمثال: محرك الديزل هو حراق زيت / مَصَبّ, فُغْرَة / هندسة كيميائية (نشاط تطبيق الكيمياء لحل المشكلات العملية) / هندسة كيميائية (فرع الهندسة المعني بتصميم وبناء وتشغيل المصانع والآلات المستخدمة في العمليات الكيميائية الصناعية) / شمراخ (ساق زهرة منتصبة بلا أوراق تنمو مباشرة من الأرض كما في الزنبق) / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かこうがん": "صَوَّان, غْرَانِيت",
 "かこうき": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "かこうぎし": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "かこうけっちょう": "قولون نازل (جزء الأمعاء الغليظة الذي ينزل من القولون المستعرض إلى القولون السيني)",
 "かこうじゅつ": "صناعة الألعاب النارية (حرفة صنع الألعاب النارية) / إبهار فني ((موسيقى) براعة في العرض (كما في الأداء الموسيقي))",
 "かこうだいどうみゃく": "أبهر نازل (الجزء النازل من الأبهر الذي يتفرع إلى الأبهر الصدري والأبهر البطني)",
 "かこうひん": "بَارِع, مُبْهِر (يوحي بالألعاب النارية؛ متألق ومبهر) / ألعاب نارية (من أو متعلق بحرفة صنع الألعاب النارية) / ألعاب نارية, مفرقعات ((عادة بصيغة الجمع) جهاز يحتوي على مادة متفجرة تحترق بمعدل منخفض وبلهب ملون؛ يمكن استخدامه لإضاءة المناطق أو إرسال إشارات وما إلى ذلك)\nمثال: دخان الألعاب النارية",
 "かこうデータ": "بيانات خام (بيانات غير محللة؛ بيانات لم تخضع بعد للتحليل)",
 "かこかんりょう": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "かこかんりょうけい": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "かこきゅう": "فرط التهوية (زيادة عمق ومعدل التنفس بشكل أكبر مما تتطلبه حاجة الجسم؛ يمكن أن يسبب الدوار ووخز الأصابع وألم الصدر إذا استمر)",
 "かこく": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "かこけい": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "かこさいだい": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "かこしんこうけい": "ماضي مستمر (زمن مستمر يُستخدم لوصف حدث كان مستمراً في الماضي)",
 "かこじせい": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "かこつ": "تَعَظُّم / جُسْأَة / الكالس النباتات",
 "かこつけ": "ذَرِيعَة, عُذْر",
 "かこぶんし": "اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "かこみ": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي) / حِصَار, مُحَاصَرَة",
 "かこみきじ": "عَمُود / خَانَة",
 "かこむ": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / حَاصَرَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "かこん": "أشباه الجذور (أي من الخيوط الرفيعة المختلفة التي تعمل كجذور في الطحالب والسراخس والفطريات وما إلى ذلك)",
 "かこログ": "أَرْشِيف / خَشَبَة",
 "かご": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / حَمَّالَة, مِحَفَّة / سَلَّة / أَيِّل / صِينِيّ",
 "かごう": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / اقتران سفلي ((في علم الفلك) محاذاة الأرض وكوكب على نفس الجانب من الشمس)",
 "かごうぶつ": "مُرَكَّب (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة)\nمثال: أطلقت الشرطة النار على إطارات مركبة توم.",
 "かごしま": "كَاغُوشِيمَا",
 "かごしゅ": "هيمارتوما, ورم عابي (نمو بؤري يشبه الورم ولكنه ينتج عن خلل في التطور في عضو ما)",
 "かごと": "ذَرِيعَة, عُذْر / رِسَالَة, خَبَر",
 "かごむ": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / حَاصَرَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "かごや": "صانع السلال (من الهنود الحمر الأوائل المرتبطين بشعب بويبلو؛ معروفون بمهارتهم في صنع السلال)",
 "かごりょう": "فخ جراد البحر (فخ لصيد جراد البحر)",
 "かごん": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / بيان خاطئ (بيان يحتوي على خطأ)",
 "かご漁": "فخ جراد البحر (فخ لصيد جراد البحر)",
 "かさ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص / هَالَة / بثرة قيحية (ارتفاع جلدي ملتهب صغير يحتوي على قيح؛ فقاعة مملوءة بالقيح) / زُهَرِيّ, مَرَض فِرَنْجِيّ / مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير ويرتفع مستدقا حتى ينتهي إلى نُقْطةٍ أَو سطحٍ أصْغرَ من قاعِدَته)",
 "かさあげ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / متزايد, متنامٍ (يصبح أكبر أو أضخم) / متصاعد (موسيقى) ((موسيقى) يتزايد في السرعة و/أو الحجم)\nمثال: أسعار متزايدة",
 "かさい": "حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟ / محكمة الأسرة, محكمة العلاقات الأسرية (محكمة في بعض ولايات الولايات المتحدة لها اختصاص في النزاعات العائلية (خاصة تلك المتعلقة بالأطفال))",
 "かさいかんちき": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان) / إنذار الحريق (صيحة أو جرس للتحذير من اندلاع حريق)",
 "かさいし": "حجر التتويج, حجر القمة (حجر يشكل قمة الجدار أو المبنى) / تتويج, لمسة نهائية (لمسة أخيرة؛ إنجاز متوج؛ ذروة)",
 "かさいせんぷう": "عاصفة من الجدل (تفجر للجدل بشكل كبير) / عاصفة نارية (عاصفة تنجذب فيها الرياح العنيفة إلى عمود من الهواء الساخن المتصاعد فوق منطقة تعرضت لقصف شديد)\nمثال: تسبب الحادث في عاصفة سياسية",
 "かさいほうちき": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان) / إنذار الحريق (صيحة أو جرس للتحذير من اندلاع حريق)",
 "かさいほけん": "تأمين ضد الحريق (تأمين ضد الخسارة الناتجة عن الحريق)",
 "かさかさ": "جَافّ, عَقِيم (يفتقر إلى الحيوية أو الروح؛ بلا حياة) / مَنْزُوع الرُّطُوبَة, مُجَفَّف (مَحْفُوظ بِإِزَالَة الرُّطُوبَة الطَّبِيعِيَّة) / مُجَفَّف كُلِّيًّا (جُفِّف بالكامل ونُزعت منه كلّ الرطوبة) / سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "かさかさなる": "حَفِيف",
 "かさかさ鳴る": "حَفِيف",
 "かさがい": "بطلينوس (أي من بطنيات القدم البحرية المختلفة عادة بأصداف مخروطية منخفضة؛ توجد ملتصقة بالصخور في المناطق الساحلية) / بطلينوس صدفي, ليمبيت (رخويات ذات صدفة مخروطية منخفضة)",
 "かさぎ": "حجر الغطاء, طوبة رأسية (طوبة توضع جانبياً في أعلى الجدار)",
 "かさく": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かさご": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "かささぎふえがらす": "عقعق أسترالي (طيور مغردة سوداء وبيضاء تشبه العقعق)",
 "かさだか": "ضَخْم / مُتَعَالٍ, الْمُتَعَالِي",
 "かさだかい": "ضَخْم / مُتَعَالٍ, الْمُتَعَالِي",
 "かさなり": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "かさなりあう": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "かさなる": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "かさね": "كَوْم",
 "かさねあわせ": "تراكب, تطابق (وضع شيء فوق شيء آخر) / تطابق هندسي ((هندسة) وضع كائن بشكل مثالي في موضع آخر لإظهار أن الاثنين يتطابقان) / مبدأ التراكب, مبدأ التعاقب الطبقي ((جيولوجيا) المبدأ القائل بأنه في سلسلة من الصخور الرسوبية الطبقية، تكون الطبقة السفلى هي الأقدم) / تراكب, تطابق الطبقات ((في الجيولوجيا) ترسب طبقة جيولوجية فوق أخرى)",
 "かさねあわせのげんり": "مبدأ التراكب (إزاحة أي نقطة بسبب تراكب أنظمة الموجات تساوي مجموع إزاحات الموجات الفردية عند تلك النقطة) / مبدأ التراكب, مبدأ التعاقب الطبقي ((جيولوجيا) المبدأ القائل بأنه في سلسلة من الصخور الرسوبية الطبقية، تكون الطبقة السفلى هي الأقدم)\nمثال: مبدأ التراكب هو أساس النظرية الموجية للضوء",
 "かさねあわせる": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "かさねいんさつ": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "かさねかける": "حَجَر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / وَلَغَ\nمثال: عوقب زيري بالحجر.",
 "かさねがさね": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "かさねぎ": "طَبَقَة",
 "かさねことば": "حَشْو, إِطْنَاب",
 "かさねつぎて": "وصلة تراكبية (وصلة تصنع عن طريق تداخل طرفين وربطهما معاً)",
 "かさねて": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "かさはぐるま": "ترس مخروطي (تروس تتعشق بزاوية)",
 "かさぶた": "جُلْبَة",
 "かさむ": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "かさん": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / مَعْدُود",
 "かさんかすいそ": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ)",
 "かさんかぶつ": "بيروكسيد, بيروكسيد الهيدروجين (سائل لزج ذو خصائص أكسدة قوية؛ عامل تبييض قوي؛ يستخدم أيضاً (في المحاليل المائية) كمطهر خفيف، وفي (التركيزات القوية) كمؤكسد في وقود الصواريخ) / بيروكسيد",
 "かさんかバリウム": "بيروكسيد الباريوم, ثاني أكسيد الباريوم (مسحوق أبيض سام يتم الحصول عليه بتسخين أكسيد الباريوم في الهواء)",
 "かさんかベンゾイル": "بيروكسيد البنزويل (بيروكسيد بلوري أبيض يستخدم في التبييض (الدقيق أو الزيوت أو الدهون) وكمحفز لتفاعلات الجذور الحرة)",
 "かさんき": "أفعى شائعة (أفعى أرضية صغيرة شائعة في شمال أوراسيا) / جامع (آلة تجمع الأرقام) / جامع الأعداد (شخص يقوم بجمع الأرقام)",
 "かさんしょう": "فرط الحموضة (حموضة زائدة)",
 "かさ上げ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / متزايد, متنامٍ (يصبح أكبر أو أضخم) / متصاعد (موسيقى) ((موسيقى) يتزايد في السرعة و/أو الحجم)\nمثال: أسعار متزايدة",
 "かさ高": "ضَخْم / مُتَعَالٍ, الْمُتَعَالِي",
 "かさ高い": "ضَخْم / مُتَعَالٍ, الْمُتَعَالِي",
 "かざ": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "かざあな": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "かざい": "أَمْوَال, ثَرْوَة",
 "かざかみ": "باتجاه الريح (نحو الريح) / في مهب الريح, مواجه للريح (في الجانب المعرض للرياح) / الجانب المواجه للريح, مهب الريح (جانب الشيء الذي يكون باتجاه الرياح) / اِتِّجَاه الرِّيح, مَهَبّ الرِّيح (الاتجاه الذي تأتي منه الرياح)\nمثال: كانوا يبحرون باتجاه الريح",
 "かざかみにもおけない": "عَار, خِزْي",
 "かざきり": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات) / رِيشَةُ الطَّيَرَان, قَلَمُ الرِّيشَة (أي من ريش الجناح أو الذيل الأكبر للطائر)",
 "かざきりばね": "رِيشَةُ الطَّيَرَان, قَلَمُ الرِّيشَة (أي من ريش الجناح أو الذيل الأكبر للطائر)",
 "かざぐすり": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "かざぐるま": "طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق) / دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة) / دولاب الهواء (لعبة تتكون من ريش من الورق الملون أو البلاستيك مثبتة بدبوس على عصا وتدور عندما توجه نحو الرياح) / عجلة الدبابيس (لعبة) (عجلة بها العديد من الدبابيس المثبتة بزوايا قائمة على حافتها) / أيونيم هاورثي, دولاب الهواء (شجيرة معمرة في تينيريفي ذات أوراق في وريدات تشبه دواليب الهواء)\nمثال: أدار عجلة الدبابيس وتوقفت والمؤشر على 'انطلق'",
 "かざしたにいる": "تَأَخَّرَ",
 "かざしも": "بعيداً عن الريح (بعيداً عن الريح) / تحت الريح, في اتجاه الريح (في الجانب البعيد عن هبوب الرياح) / الجانب المحجوب عن الريح, ذروة الريح (جانب الشيء الذي يكون محمياً من الرياح) / تَحْت الرِّيح, ذَرَى (الاتجاه الذي تهب نحوه الرياح)\nمثال: كانوا يبحرون بعيداً عن الريح",
 "かざしもにいる": "تَأَخَّرَ",
 "かざしもにたつ": "تَأَخَّرَ",
 "かざとおし": "تَهْوِيَة / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "かざなみ": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام) / مَشَقَّة, شِدَّة",
 "かざぬき": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "かざまど": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "かざみ": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات) / سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "かざみどり": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات) / مُتَذَبْذِب, مُحَايِد (شخص لا يتخذ موقفاً مع أي طرف في نزاع)",
 "かざむき": "حَالَة, وَضْع / مَزَاج",
 "かざよけ": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "かざり": "زينة",
 "かざりいし": "حجر شبه كريم (حجر كريم ذو قيمة أقل)",
 "かざりがき": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "かざりけ": "تَصَنُّع, تَكَلُّف",
 "かざりけのない": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かざりたてる": "جَمَّلَ, زَخْرَفَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "かざりだな": "خزانة عرض, فاترينة (حاوية زجاجية تستخدم لتخزين وعرض العناصر في متجر أو متحف أو منزل)",
 "かざりっけ": "تَصَنُّع, تَكَلُّف",
 "かざりつけ": "زينة",
 "かざりつける": "إِظْهَار, عَرْض / شَاشَة",
 "かざりばね": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "かざりまど": "شُبَّاك, فَاتْرِينَة",
 "かざりもの": "حِلْيَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية) / واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "かざる": "حِلْيَة / إِظْهَار, عَرْض / شَاشَة / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "かざん": "بُرْكَان, جَبَلُ النَّار (فَتْحَةُ أَوْ فَوْهَةُ انْفجارٍ حَلَزونِيَّةُ الشَّكْلِ، تَكونُ في مَواقِعَ جَبَلِيَّةٍ تَقْذِفُ نيراناً مُلْتَهِبَةً)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "かざんがく": "علم البراكين (فرع الجيولوجيا الذي يدرس البراكين)",
 "かざんがん": "صخر بركاني (صخر ناري طافح تصلب بالقرب من سطح الأرض أو عليه)",
 "かざんだん": "قنبلة بركانية",
 "かざんふんか": "ثوران, ثوران بركاني (الحدوث المفاجئ لتفريغ عنيف للبخار والمواد البركانية)",
 "かざんガラス": "زجاج بركاني (نوع من الزجاج الطبيعي ينتج عندما تبرد الحمم المنصهرة بسرعة كبيرة)",
 "かし": "ضابط صفّ / استمرارية, طول نفس (قوة البقاء والاستمرار)\nمثال: تلك المسرحية القديمة في برودواي لديها استمرارية حقاً / مَنَحَ / مِنْحة / حيوية معلقة (توقف مؤقت للوظائف الحيوية مع فقدان الوعي يشبه الموت؛ ناتج عادة عن الاختناق) / رُؤْيَة / ليبريتو, نص الأوبرا (كلمات أوبرا أو مسرحية موسيقية) / صناعة الحلويات, مهنة الحلواني (مهنة ومهارات صانع الحلويات) / متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر) / سكاكر, صناعة الحلويات (الحلوى والسكاكر الأخرى كصنف جماعي)\nمثال: قررت الشركة التركيز على السكاكر والمشروبات الغازية / بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً) / قَرْض, إِعَارَة / مَعْرُوف / أَنْعَمَ / دَائِن / عَيْبٌ / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً) / ضفة النهر / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "かしあたえる": "أَعَارَ, سَلَّفَ",
 "かしい": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج خشباً صلباً)",
 "かしか": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري) / تَسْجِيل",
 "かしかた": "دَائِن",
 "かしかん": "ضابط صفّ",
 "かしかんへい": "مجند (فرد ذكر مجند في القوات المسلحة)",
 "かしがましい": "صَارِخ, صاخِب",
 "かしきり": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "かしきる": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "かしきん": "قَرْض, إِعَارَة",
 "かしきんぎょうしゃ": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "かしきんこ": "صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
 "かしく": "اَلْمُخْلِص",
 "かしぐ": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي) / زاوية منحازة, وجهة نظر خاصة (طريقة منحازة للنظر إلى شيء ما أو تقديمه)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "かしげる": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / انحياز طفيف, ميل (تحيز طفيف ولكنه ملحوظ) / جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: كان للبرج ميل واضح",
 "かしこ": "هُنَاكَ / اَلْمُخْلِص / ذهني, عقلي (يخاطب أو يستخدم الفكر والعقل) / عَقْلَانِيّ, فِكْرِيّ (مرتبط بالعقل أو يتطلّب استخدامه) / ذهني, فكري (يشمل الذكاء بدلاً من العواطف أو الغريزة) / مثقف, مفكر (شخص يستخدم عقله بشكل إبداعي)\nمثال: السخرية سلاح فكري",
 "かしこい": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة. / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "かしこう": "ضوء, ضوء مرئي ((في الفيزياء) إشعاع كهرومغناطيسي يمكن أن ينتج إحساساً بصرياً)\nمثال: تم تصفية الضوء من خلال نافذة زجاجية ناعمة",
 "かしこうぼうえんきょう": "تلسكوب بصري (تلسكوب فلكي مصمم لجمع وتسجيل الضوء من المصادر الكونية)",
 "かしこくも": "بكياسة, بلطف (بطريقة لطيفة أو رشيقة)",
 "かしこし": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "かしこまった": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かしこまりました": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "かしさげる": "أَعَارَ, سَلَّفَ",
 "かしざしき": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "かししぶり": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة مرتفعة)",
 "かしじどうしゃ": "تأجير السيارات, سيارة مستأجرة (سيارة مستأجرة)\nمثال: استلمت سيارة مستأجرة من المطار وقادتها إلى فندقها",
 "かしずく": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "かしせい": "رُؤْيَة",
 "かしたい": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف الخلفية أو الأجزاء المماثلة في الفقاريات الأخرى)",
 "かしだおれ": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "かしだおれきん": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "かしだし": "إعارة, إقراض (التصرف في المال أو الممتلكات مع توقع إعادة نفس الشيء (أو ما يعادله))",
 "かしだしけん": "بطاقة استعارة, بطاقة مكتبة (بطاقة تثبت حق حاملها في استخدام المكتبة)",
 "かしだしげんど": "سطر الكاتب (سطر يعطي اسم كاتب قصة أو مقال) / حد ائتماني, خط ائتمان (الحد الأقصى للائتمان المسموح به للعميل)",
 "かしだす": "أَعَارَ, سَلَّفَ",
 "かしちん": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "かしつ": "وَرْنِيش / حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "かしつき": "مرطب هواء (جهاز مصمم لإضافة الرطوبة إلى الهواء في المبنى)\nمثال: يضمن مرطب الهواء مستوى الرطوبة المناسب للوحاتنا",
 "かしつけ": "قَرْض, إِعَارَة",
 "かしつけきん": "قَرْض, إِعَارَة",
 "かしつけざんだか": "رَصِيد سَالِب, رَصِيد مَدِين (رصيد حساب تتجاوز فيه الديون (المدفوعات) الاعتمادات (الإيداعات)، ويكون العميل مديناً للبنك بالمال)",
 "かしつける": "أَعَارَ, سَلَّفَ",
 "かしつそうさい": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة للمدعي)",
 "かしつわりあい": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة للمدعي)",
 "かしづく": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "かして": "مُقْرِض",
 "かしてあげる": "أَعَارَ, سَلَّفَ",
 "かしてん": "حَلْوَانِيّ",
 "かしぬし": "مُقْرِض",
 "かしましい": "صَارِخ, صاخِب",
 "かしめ": "تَجْعِيدَة (خصلة شعر تم تمويجها أو تجعيدها صناعياً) / مجند بالإكراه (شخص يخدع الرجال أو يجبرهم على الخدمة كبحارة أو جنود) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: طية في المنديل / ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / تعادل (نهاية مسابقة تتعادل فيها النتيجة ولا يتحدد الفائز)\nمثال: انتهت المباراة بالتعادل",
 "かしめる": "تَجْعِيدَة (خصلة شعر تم تمويجها أو تجعيدها صناعياً) / مجند بالإكراه (شخص يخدع الرجال أو يجبرهم على الخدمة كبحارة أو جنود) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: طية في المنديل",
 "かしもと": "خبير مالي, ممول (شخص ماهر في المعاملات المالية واسعة النطاق)",
 "かしもとがずるい": "دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ) / بِلَا دَافِع, عَابِث (يحدث دون دافع أو استفزاز) / امرأة خليعة, فاسقة (امرأة بذيئة أو فاسقة)",
 "かしもとがズルい": "دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ) / بِلَا دَافِع, عَابِث (يحدث دون دافع أو استفزاز) / امرأة خليعة, فاسقة (امرأة بذيئة أو فاسقة)",
 "かしゃ": "عربة شحن (عربة سكة حديد تنقل البضائع) / كاشا (حنطة سوداء مسلوقة أو مخبوزة) / قِطَار بُخَارِيّ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة)",
 "かしゃかしゃ": "طقطقة (سلسلة من النقرات)",
 "かしゃく": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟ / استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر) / اقتراض (الحصول على أموال من مقرض)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً / لَوْم, مَلَامَة",
 "かしゃくなき": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "かしゃわたし": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "かしや": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
 "かしゅ": "مُطْرِب, مُغَنٍّ / عَطَشْجِيّ / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "かしゅう": "تَجْمِيعَة, دِيوَان / كتاب أغاني (كتاب يحتوي على مجموعة من الأغاني) / كَالِيفُورْنِيَا / وَاشِنْطُن, واشنتن / وَاشِنْطُن",
 "かしゅひ": "آريل, غلاف البذرة اللحمي (غطاء لحمي وعادة زاهي الألوان لبعض البذور يتطور من ساق البويضة ويغلف البذرة جزئياً أو كلياً)",
 "かしょ": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "かしょう": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / زَهِيد, شَحِيح (ناقص في الكمية أو الحجم) / ضَيِّق, كَاشِف لِلْجَسَد ((عن الملابس) يكشف الجسد ويُظهره) / سروال داخلي نسائي (سراويل داخلية قصيرة للنساء أو الأطفال) / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية. / قاع النهر (قناة يشغلها (أو كان يشغلها) نهر) / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية / معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد)) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية) / فَاغِرَة / شبه, صورة مماثلة (صورة تتكون من تمثيل رسومي لشخص أو شيء) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / مظهر خادع, وهم (تمثيل عقلي خاطئ)\nمثال: أمل أن يكون لادعاءاته مظهر من المصداقية / تكليس (تحويل المعادن إلى أكاسيدها نتيجة للتسخين إلى درجة حرارة عالية) / فَسَاد / حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "かしょうてんきょり": "مَسَافَة بُؤْرِيَّة مُفْرِطَة, مَسَافَة فَرْط البُؤْرَة (المسافة أمام العدسة التي يتم تركيزها عند اللانهاية والتي تكون بعدها جميع الأشياء محددة وواضحة بشكل جيد)",
 "かしょうひょうか": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "かしょうびょう": "لفحة الكمثرى, لفحة نارية (مرض يسبب اسوداد أوراق أشجار الكمثرى والتفاح)",
 "かしょく": "شركة عائلية (شركة مملوكة بالكامل لأعضاء عائلة واحدة) / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة) / زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج) / شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة)) / زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة / زينة / صَالِح لِلْأَكَل ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "かしょくおうと": "نهام (جوع مرضي لا يشبع (خاصة عندما تسببه آفات الدماغ)) / الشره المرضي, النهام (اضطراب في الأكل يظهر بين الشابات اللاتي يفرطن في الأكل ثم يشعرن بالذنب والاكتئاب وإدانة الذات)",
 "かしょくしょう": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز بالإفراط في الأكل تليها فترات من الصيام أو التقيؤ المستحث ذاتياً)",
 "かしょくのてん": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "かしょぶん": "قابل للتخلص منه, يستخدم لمرة واحدة (مصمم ليتم التخلص منه بعد الاستخدام) / تحت اليد, قابل للتصرف فيه (حر أو متاح للاستخدام أو التصرف) / مُسْتَهْلَك, مُنْتَج للاسْتِعْمَالِ لِمَرَّةٍ وَاحِدَة (عنصر يمكن التخلص منه بعد استخدامه)\nمثال: أكواب ورقية تستخدم لمرة واحدة",
 "かしょぶんしょとく": "دخل قابل للإنفاق, دخل متاح (الدخل (بعد الضرائب) المتاح لك للادخار أو الإنفاق)",
 "かしら": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / قَائِد, زَعِيم / قِمَّة",
 "かしらがき": "عُنْوَان (عُنْوَان)\nمثال: نسيت عنوان توم. / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "かしらじ": "أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "かしらつき": "تَصْفِيفَة, تَسْرِيحَة",
 "かしらぶん": "رَئِيس, رَئِيسَة",
 "かしらもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "かしらもじご": "اِخْتِصَار",
 "かしらをたてにふる": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "かしらん": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "かしり": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "かしりょう": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "かしわ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "かしわぎ": "بلوط, سنديان (شجرة نفضية من جنس السنديان؛ لها جوز (بلوط) وأوراق مفصصة)\nمثال: تنمو أشجار البلوط العظيمة من ثمار البلوط الصغيرة",
 "かしん": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي) / ربة الإلهام, ملهمة (مصدر إلهام الفنان) / ربة الإلهام, موز (في الأساطير اليونانية القديمة أي من بنات زيوس وميموزين التسع؛ حاميات الفنون والعلوم)\nمثال: كانت يوتيربي ملهمته / قَنَاة / بَتَلَة, تُوَيْجَة / منتصف النهر, وسط المجرى (الجزء الأوسط من مجرى النهر)",
 "かしんどうみゃく": "شريان شفوي سفلي (شريان هو فرع من الشريان الوجهي يغذي الشفة السفلى)",
 "かじ": "صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ / أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار. / دَفَّة, سُكَّان / سُكَّان, دَفَّة / صيف (أكثر فصول السنة دفئاً)\nمثال: قضوا صيفاً كسولاً على الشاطئ / حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…) / تَعْلِيق",
 "かじか": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه عريضة)",
 "かじき": "مارلين (أسماك رياضة محيطية كبيرة طويلة الفك؛ ترتبط بأسماك الشراع وأسماك الرمح؛ ليست من ذوات الدم البارد تماماً أي قادرة على تدفئة أدمغتها وعيونها)",
 "かじきざ": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "かじきまぐろ": "مارلين (أسماك رياضة محيطية كبيرة طويلة الفك؛ ترتبط بأسماك الشراع وأسماك الرمح؛ ليست من ذوات الدم البارد تماماً أي قادرة على تدفئة أدمغتها وعيونها)",
 "かじき座": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "かじく": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي) / محور (محور ورقة مركبة أو نورة مركبة)\nمثال: تسبب السقوط في كسر ظهره",
 "かじせんぷう": "عاصفة من الجدل (تفجر للجدل بشكل كبير) / عاصفة نارية (عاصفة تنجذب فيها الرياح العنيفة إلى عمود من الهواء الساخن المتصاعد فوق منطقة تعرضت لقصف شديد)\nمثال: تسبب الحادث في عاصفة سياسية",
 "かじだいこう": "أعمال منزلية, تنظيف المنزل (عمل تنظيف وإدارة المنزل)",
 "かじつ": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة. / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "かじつき": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق) / سيكلوأكسيجيناز (أحد إنزيمين مرتبطين يتحكمان في إنتاج البروستاغلاندين ويتم حظرهما بواسطة الأسبرين)",
 "かじづか": "دَفَّة",
 "かじてつだい": "خادم منزلي, عامل منزلي (خادم يتقاضى أجراً لأداء مهام وضيعة حول المنزل)",
 "かじとり": "توجيه السفينة (فعل توجيه السفينة) / توجيه, قيادة (فعل تحديد المسار والحفاظ عليه) / إرشاد, توجيه (فعل التوجيه أو إظهار الطريق)\nمثال: تم تنصيب مجلس جديد بتوجيه من الملك / إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "かじどろ": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "かじのき": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…)",
 "かじば": "مسبك, ورشة حدادة (مكان عمل يتم فيه تشكيل المعدن بالتسخين والطرق)",
 "かじばどろぼう": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "かじぼう": "قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق) / زَارِع",
 "かじまくら": "رِحْلَة",
 "かじゃ": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "かじや": "حَدَّاد, قَيْن",
 "かじゅ": "شجرة فاكهة (شجرة تحمل فاكهة صالحة للأكل) / شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "かじゅう": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية. / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة) / عصير الفاكهة (مشروب يتم إنتاجه عن طريق عصر أو سحق الفاكهة) / حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / بدانة, وزن زائد (خاصية السمنة المفرطة) / ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية)",
 "かじゅうでん": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "かじゅうへいきん": "متوسط حسابي موزون, متوسط موزون (متوسط يتم فيه تعيين وزن لكل كمية مراد حساب متوسطها، مما يحدد الأهمية النسبية لكل كمية في المتوسط)\nمثال: هذا النموذج الميكانيكي البسيط هو الآن تمثيل مألوف للمتوسط الحسابي الموزون لمجموعة من الملاحظات",
 "かじゅうろうどう": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "かじゅえん": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة)\nمثال: أحب سقي البستان.",
 "かじゅえんげいがく": "علم زراعة الفاكهة (فرع علم النبات الذي يدرس ويزرع الفواكه)",
 "かじゅくじ": "طفل متأخر الولادة (رضيع يولد بعد 42 أسبوعاً من الحمل؛ عادة ما يظهر علامات قصور المشيمة)",
 "かじゅさいばいしゃ": "زارع الفاكهة, مزارع فاكهة (شخص يزرع الفاكهة لأغراض تجارية)",
 "かじょ": "إزهار, نورة (الجزء المزهر من النبات أو ترتيب الزهور على الساق) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "かじょう": "لَوْلَب, بُرْغِيّ / بَنْد / إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "かじょうがき": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "かじょうぎんが": "مَجَرَة حَلَزُونِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "かじょうこうどう": "فرط النشاط (حالة تتميز بالأرق المفرط والحركة الزائدة)",
 "かじょうせいさん": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "かじょうせっしゅ": "جُرْعَة زَائِدَة",
 "かじょうはんのう": "رد فعل مبالغ فيه (رد فعل مفرط؛ رد فعل بسلوك عاطفي غير لائق)",
 "かじょしき": "ذُو أَوْرَاق سَائِبَة (ذو أوراق يمكن إزالتها أو إعادة ترتيبها بسهولة)",
 "かじる": "نَخَرَ, قَضَمَ",
 "かじろうどう": "أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "かじをとる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "かじを取る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "かじん": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / شَاعِر, شَاعِرَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "かじ付き": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق) / سيكلوأكسيجيناز (أحد إنزيمين مرتبطين يتحكمان في إنتاج البروستاغلاندين ويتم حظرهما بواسطة الأسبرين)",
 "かす": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل) / أَعَارَ, سَلَّفَ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / تُفْل / حُثالَة / ثفل الخمر, عكر (الرواسب الناتجة عن تخمير المشروبات الكحولية) / الْبَقَايَا / جُنْك / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / تَزَوَّجَ / مَنَحَ / مِنْحة",
 "かすい": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف) / خَائِرُ القُوَى (ضَعِيفٌ مِنْ شِدَّةِ الإِنْهَاك) / جَدْوَل / تَيَّار / تَدَفّقَ / سنبلة / تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "かすいたい": "الغُدَّة النُخَامِيَّة",
 "かすいぶんかい": "تحلل مائي (تفاعل كيميائي يتفاعل فيه الماء مع مركب لإنتاج مركبات أخرى؛ ويتضمن انقسام الرابطة وإضافة كاتيون الهيدروجين وأنيون الهيدروكسيد من الماء)",
 "かすう": "جُزْء عُشْرِيّ, مَانْتِيسَا (الجزء الكسري الموجب من تمثيل اللوغاريتم) / مُضَاف (عدد يضاف إلى عدد آخر) / تكافؤ / تَعَلُّق",
 "かすうぶ": "جُزْء عُشْرِيّ, مَانْتِيسَا (الجزء الكسري الموجب من تمثيل اللوغاريتم)",
 "かすか": "إِغْمَاء / أُغْمِيَ, غُشِيَ / فَقِير / مِسْكِين / فُقَرَاء",
 "かすかす": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / بِٱلْكَاد",
 "かすがい": "مَشْبَك / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / زِلاَج, ضَبَّة",
 "かすとり": "خمر رديء, مشروب كحولي رخيص (مشروب كحولي مقطر بشكل غير قانوني (وعادة ما يكون رديء الجودة))",
 "かすみ": "عَجَاج / خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "かすみいし": "نيفيلين (معدن مائل للبياض يتكون من سيليكات الصوديوم والألمنيوم أو البوتاسيوم في شكل بلوري؛ يستخدم في صناعة السيراميك والمينا)",
 "かすみそう": "جِيبْسُوفِيلَا, كُنْدُس",
 "かすみ草": "جِيبْسُوفِيلَا, كُنْدُس",
 "かすめうばう": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته واستولت عليه)\nمثال: لقد سلب مني كل شيء.",
 "かすめとる": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "かすめる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى / انتقال خفي, هروب سري (انتقال سري (لتجنب دفع الديون)) / انطلاق سريع, حركة خاطفة (حركة سريعة مفاجئة)\nمثال: قاموا بهروب سري ليلي",
 "かすめ取る": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "かすり": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / رعي (فعل الرعي) / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "かすりきず": "خَرْبَشَ",
 "かすり傷": "خَرْبَشَ",
 "かする": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل) / سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى / مَأْثُرَة / اِسْتَغَلَّ / تَزَوَّجَ / شِبْر",
 "かすれきず": "خَرْبَشَ",
 "かすれる": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / رَعَى / اِرْتَعَى",
 "かすれ傷": "خَرْبَشَ",
 "かず": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "かずある": "عَدِيد, كَثِير",
 "かずおおい": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "かずかぎりない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずかず": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "かずけごと": "ذَرِيعَة, عُذْر / رِسَالَة, خَبَر",
 "かずけもの": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "かずしらず": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずしれず": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずしれない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずしれぬ": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かずてき": "عَدَدِيّ, رَقْمِيّ",
 "かずとり": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات",
 "かずにいれる": "عَدَّ / كُونْت",
 "かずや": "مُنْتَجٌ بِالجُمْلَةِ (مُنتَج بكميات كبيرة غالباً بتقنيات خطوط التجميع)",
 "かずら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "かせ": "قَيْد / غِلّ / رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا / شلة, لفة (لفة من الحبل أو الصوف أو الغزل) / حَزين / خافِت, مُنْخَفِض",
 "かせい": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / زَائِف, بَاطِل / كَاذِب / فَالْسِيتُّو (عالي النبرة اصطناعيّاً؛ فوق المدى الصوتيّ الطبيعيّ) / صوت مستعار, فالسيتو (صوت غنائي ذكوري بنغمات عالية مصطنعة في سجل علوي) / مُسَاعَدَة, إِمْدَاد / أعمال منزلية, تنظيف المنزل (عمل تنظيف وإدارة المنزل) / الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت. / أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / مادة كاوية (أي مادة كيميائية تحرق أو تدمر الأنسجة الحية) / محرقة, منحنى كاوٍ (غلاف أشعة الضوء المنعكسة أو المنكسرة بواسطة سطح منحني) / طُغْيَان, اِسْتِبْدَاد / صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء) / اِنْسِجَام, تَوَافُق / بُحَاح",
 "かせいがく": "اقتصاد منزلي, تدبير منزلي (نظرية وممارسة إدارة المنزل)",
 "かせいがん": "صَخَر نَارِيّ",
 "かせいこうぎょう": "الصناعات الكيماوية (مصنعو المواد الكيميائية باعتبارهم مجموعة)",
 "かせいじん": "مِرِّيخِيّ",
 "かせいふ": "مُدَبَّرَة الْمَنْزَل",
 "かせいアルカリ": "غسول, محلول قلوي (محلول قوي من هيدروكسيد الصوديوم أو البوتاسيوم)",
 "かせいカリ": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "かせいソーダ": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات الصوديوم المختلفة)",
 "かせき": "مُسْتَحَاثَة, أُحْفُورَة / مُتَحَجِّرَة (صخرة نشأت بالتحجر؛ جسم عضوي تخللته مادة معدنية وحُفظ في شكله الأصلي) / تحجر, تصخر (عملية تحويل بعض المواد النباتية إلى حجر عن طريق التشبع بالماء المحمل بالجزيئات المعدنية دون تغيير الشكل الأصلي)",
 "かせきがく": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "かせきこ": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة الرئيسية)",
 "かせきさい": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "かせきねんりょう": "وَقُود أُحْفُورِيّ",
 "かせぎ": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً / أَيِّل",
 "かせぎがしら": "مُعِيل, عَائِل",
 "かせぎだか": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً",
 "かせぎだす": "كَسَبَ",
 "かせぎて": "مُعِيل, عَائِل",
 "かせぎにん": "مُعِيل, عَائِل",
 "かせぎぬし": "مُعِيل, عَائِل",
 "かせぎ高": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً",
 "かせぐ": "كَسَبَ / إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة. / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "かせげる": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "かせつ": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية. / افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "かせる": "جُلْبَة",
 "かせん": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))\nمثال: 下線のある文を訳しなさい。 — ترجم ما تحته خط. / ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية) / احتكار القلة / نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ) / نهر أبيض (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر. / صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل. / الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما) / خط النار (الخط الذي يطلق منه الجنود النار)\nمثال: خط المواجهة هو مكان الحدث / التفاف, دوران (عملية الدوران أو اللف أو الطي حول محور مركزي) / سفينة حارقة (سلاح يتكون من سفينة تحمل متفجرات تُترك لتنجرف لتدمير سفن العدو) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "かせんしき": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "かせんじき": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "かぜ": "رِيح, ريح / لَفَّ / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "かぜあたりがつよい": "عَاصِف",
 "かぜあたりのつよい": "عَاصِف",
 "かぜあな": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "かぜい": "جباية الضرائب, فرض الضرائب (فرض الضرائب؛ ممارسة الحكومة في جباية الضرائب على رعايا الدولة) / إيرادات ضريبية (دخل الحكومة الناتج عن الضرائب) / جباية, ضريبة (رسم يفرض على شخص المواطن أو ممتلكاته أو نشاطه لدعم الحكومة)",
 "かぜいりつ": "معدل الضريبة, نسبة الضريبة (المعدل المستخدم لحساب الالتزام الضريبي)",
 "かぜがつよい": "عَاصِف",
 "かぜくさ": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "かぜぐすり": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "かぜたつ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "かぜだつ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "かぜとおし": "تَهْوِيَة / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "かぜにやなぎ": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "かぜぬき": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "かぜのうわさ": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "かぜのこ": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "かぜのたより": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "かぜのつて": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "かぜのつよい": "عَاصِف",
 "かぜのふきまわし": "فُرْصَة",
 "かぜひかる": "شَبِيهٌ بِالنَّابِض, نَابِضِيّ (يُشبه النابض أو حركته)",
 "かぜひく": "أُصِيبَ بِبَرْدٍ",
 "かぜむき": "حَالَة, وَضْع / مَزَاج",
 "かぜよけ": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "かぜをとおす": "هَوَّى",
 "かぜをひく": "أُصِيبَ بِبَرْدٍ",
 "かぜん": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد",
 "かぜ薬": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "かそ": "قَابِلٌ لِلتَّشْكِيل, لَدْن (قابل للقولبة أو التشكيل (خاصة التراب أو الطين أو مادّة ليّنة أخرى)) / انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق)) / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "かそう": "خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / بَذْلَة, بَدْلَة / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / حرق الجثث (ترميد جثة الميت) / كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "かそううん": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "かそうか": "بِيئَة اِفْتِرَاضِيَّة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة.",
 "かそうかいきゅう": "بْرُولِيتَارِيَا",
 "かそうきおく": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول عشوائي إضافية؛ مساحة التخزين القابلة للعنونة المتاحة لمستخدم نظام الحاسوب…)",
 "かそうきおくそうち": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول عشوائي إضافية؛ مساحة التخزين القابلة للعنونة المتاحة لمستخدم نظام الحاسوب…)",
 "かそうげんじつ": "وَاقِع اِفْتِرَاضِيّ (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / حَقِيقَة ظَاهِرِيَّة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: أنا واقع في حبك",
 "かそうげんじつかん": "وَاقِع اِفْتِرَاضِيّ (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / حَقِيقَة ظَاهِرِيَّة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: أنا واقع في حبك",
 "かそうしゃかい": "سِجِّين, عَالَم سُفْلِيّ",
 "かそうつうか": "عُمْلَة مُعَمَّاة, مُشَفَّرَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "かそうてき": "خَيَالِيّ",
 "かそうど": "تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "かそうば": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد) / محرقة الجثث (مبنى جنائزي حيث يتم حرق الجثث)",
 "かそうぶとうかい": "حفل مقنع, حفلة تنكرية (حفل يرتدي فيه الضيوف أزياء وأقنعة)",
 "かそうみ": "عَرَافَة",
 "かそうメモリ": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول عشوائي إضافية؛ مساحة التخزين القابلة للعنونة المتاحة لمستخدم نظام الحاسوب…)",
 "かそうメモリー": "ذاكرة افتراضية, ذاكرة ظاهرية ((في علم الحاسوب) ذاكرة يتم إنشاؤها باستخدام القرص الصلب لمحاكاة ذاكرة وصول عشوائي إضافية؛ مساحة التخزين القابلة للعنونة المتاحة لمستخدم نظام الحاسوب…)",
 "かそか": "انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق))",
 "かそく": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته. / قدم كاذبة (نتوء مؤقت تستخدمه بعض الكائنات الحية الدقيقة كعضو للتغذية أو الحركة)",
 "かそくき": "مُسَرِّع / مُعَجِّل / دَوَّاسَةُ الوَقُود",
 "かそくそうち": "مُسَرِّع / مُعَجِّل / دَوَّاسَةُ الوَقُود / مُعَجِّل جُسَيْمَات",
 "かそくど": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "かそくどけい": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "かそくどてき": "مُسَرَّع, مُكَثَّف (تَمَّ تَسْرِيعُه، كَمَا فِي دَوْرَة أَكَادِيمِيَّة مُكَثَّفَة)",
 "かそくどびょう": "دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "かそくどセンサ": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "かそくどセンサー": "مقياس التسارع (أداة لقياس تسارع الطائرات أو الصواريخ)",
 "かそけき": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "かそけし": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "かそこら": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "かそざい": "مادة ملدنة, ملدن (مادة تضاف إلى البلاستيك أو المواد الأخرى لجعلها أكثر مرونة)",
 "かそせい": "طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله دون أن ينكسر)",
 "かそぶっしつ": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة أو الضَّغط ، تقبل التَّشكيل ، وتصنع منها أدواتٌ مختلفة) / بْلَاسْتِيكِيّ\nمثال: لدي قبعه من البلاستيك .",
 "かそぶつ": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة أو الضَّغط ، تقبل التَّشكيل ، وتصنع منها أدواتٌ مختلفة) / بْلَاسْتِيكِيّ\nمثال: لدي قبعه من البلاستيك .",
 "かぞ": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "かぞいろ": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "かぞいろは": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "かぞう": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "かぞえあげる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "かぞえきれない": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "かぞえたてる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "かぞえちがえる": "خطأ في العد (عد غير دقيق)",
 "かぞえる": "عَدَّ / كُونْت",
 "かぞく": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "かぞくおん": "تحت المهيمنة ((موسيقى) النغمة الرابعة في السلم الدياتوني)",
 "かぞくかんけい": "عَلَاقَة أُسَرِيَّة, قَرَابَة ((الأنثروبولوجيا) الارتباط أو الاتصال عن طريق الدم أو الزواج أو التبني)",
 "かぞくけいかく": "تحديد النسل, تنظيم الأسرة (الحد من عدد الأطفال المولودين)",
 "かぞくせい": "أُسْرِيّ, عَائِلِيّ",
 "かぞくせいど": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "かぞくたいざい": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "かぞくもち": "رجل عائلة (رجل تعتبر عائلته ذات أهمية كبرى في حياته)",
 "かぞくりょうほう": "علاج أسري (أي من الأساليب العلاجية المتعددة التي يتم فيها علاج الأسرة ككل)",
 "かぞくれき": "تاريخ العائلة, سجل العائلة الطبي (جزء من التاريخ الطبي للمريض تُطرح فيه أسئلة لمحاولة معرفة ما إذا كان لدى المريض ميول وراثية لأمراض معينة)",
 "かた": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل / بُحَيْرة شاطِئَة, لَاجُون (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة. / ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه) / أرض المد (أرض بالقرب من البحر يغمرها المد) / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن. / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / كَتِف, كِتْف\nمثال: 肩が痛い。 — لدي ألم في أكتافي. / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى. / بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا. / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / أُقْنُوم / فَرْد / جَانِب / صَفْحَة / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "かたあげがとれる": "بَلَغَ رُشْدَهُ",
 "かたあげもとれる": "بَلَغَ رُشْدَهُ",
 "かたあげをおろす": "بَلَغَ رُشْدَهُ",
 "かたあて": "واقي كتف (ملابس واقية تتكون من وسادة صلبة مستديرة يرتديها لاعبو كرة القدم لحماية أكتافهم)",
 "かたあぶら": "مَرْهَم, بُومَادَة",
 "かたい": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين. / سَائِل / فَقِير / عُرْقُوب / جذام, مرض هانسن (مرض حبيبي مزمن وسار يحدث في المناطق الاستوائية وشبه الاستوائية؛ يتميز بعقيدات ملتهبة تحت الجلد وهزال أجزاء الجسم؛ تسببه عصيات المتفطرة الجذامية)",
 "かたいき": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "かたいじ": "عِنَاد",
 "かたいっぽう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "かたいなか": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "かたいれ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "かたうらみ": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "かたおし": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "かたおち": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "かたおもい": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "かたかい": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات) / أحادي الصدفة (يستخدم للرخويات، خاصة بطنيات القدم، مثل القواقع وغيرها)",
 "かたかけ": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها)",
 "かたかけかばん": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "かたかけカバン": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "かたかげ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "かたかた": "قَعْقَعَ",
 "かたかな": "كَاتَاكَانَا (ٱلْأَحْرُفَ ٱلْمُشَابِهَةَ لِلْهِيرَاغَانَا، ٱلَّتِي تُسْتَخْدَمُ لِكِتَابَةِ كَلِمَاتٍ غَيْرِ يَابَانِيَّةٍ وَأَسْمَاءٍ أَجْنَبِيَّةٍ…)",
 "かたかんせつ": "كتف, مفصل الكتف (مفصل كروي بين رأس عظم العضد وتجويف لوح الكتف)",
 "かたがい": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات) / أحادي الصدفة (يستخدم للرخويات، خاصة بطنيات القدم، مثل القواقع وغيرها)",
 "かたがき": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "かたがこる": "جِدِّيّ / جَدِّيّ, جَادّ\nمثال: 彼女は肩が凝る本を読む気にはなれなかった。 — لم تكن في المزاج المناسب للكتب الجادة.",
 "かたがた": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / عَلَى فِكْرَة (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "かたがつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "かたがみ": "رَوْسَم",
 "かたがわり": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "かたき": "مُنَافِس / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر. / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / صُعُوبَة",
 "かたきうち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "かたきやく": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "かたきをとる": "اِنْتَقَمَ",
 "かたき討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "かたぎ": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد / نَزِيه, صَادِق / خشب صلب (خشب الأشجار عريضة الأوراق ثنائية الفلقة (بالمقارنة مع خشب الصنوبريات))",
 "かたぎりスイッチ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたく": "ذَرِيعَة, عُذْر / مأوى, مسكن (سكن يعيش فيه شخص ما) / مقر إقامة, موطن قانوني ((في القانون) المسكن الذي يوجد به منزلك الدائم أو مؤسستك الرئيسية وإليه تنوي العودة كلما تغيبت؛ يُلزم كل شخص بأن يكون له موطن واحد فقط في كل مرة)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة / حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "かたくけい": "كوي (اللغة الدرافيدية التي يتحدث بها شعب كوي في جنوب شرق الهند) / كوي (عضو في الشعب الدرافيدي الذي يعيش في جنوب شرق الهند)",
 "かたくしんにゅうざい": "انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن) / تعد على الممتلكات (تدخل غير مشروع في حيازة الممتلكات (المنقولة والعقارية)، أو الإجراء القانوني المتخذ لاسترداد التعويضات)",
 "かたくそうさくれいじょう": "إذن تفتيش, مذكرة تفتيش (مذكرة تخول مسؤولي إنفاذ القانون بالبحث عن أشياء أو أشخاص متورطين في ارتكاب جريمة وإنتاجهم في المحكمة؛ تصف المذكرة المواقع التي قد يفتش فيها المسؤولون)",
 "かたくな": "مُتَعَنِّت, عَنِيد",
 "かたくない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "かたくむじょう": "زَائِل, غَيْرُ دَائِم (مَوْجُودٌ أَوْ بَاقٍ لِفَتْرَةٍ مَحْدُودَةٍ فَقَطْ) / زائل, غير دائم (ليس دائماً؛ لا يدوم)\nمثال: السياسة عامل غير دائم في الحياة",
 "かたくり": "بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "かたくるしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたぐ": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي) / زاوية منحازة, وجهة نظر خاصة (طريقة منحازة للنظر إلى شيء ما أو تقديمه)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "かたぐち": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "かたぐるしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたげっけい": "غزارة الطمث, نزيف رحمي (حيض غزير أو طويل بشكل غير طبيعي؛ يمكن أن يكون عرضًا لأورام الرحم ويمكن أن يؤدي إلى فقر الدم إذا طال أمده)",
 "かたげる": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / انحياز طفيف, ميل (تحيز طفيف ولكنه ملحوظ) / جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: كان للبرج ميل واضح",
 "かたこ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي / بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "かたこい": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "かたこと": "بَقَّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا. / طقطقة (سلسلة من النقرات)",
 "かたさ": "ثَبَات",
 "かたさき": "كَتِف, كِتْف",
 "かたし": "صَعْب / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "かたしき": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "かたじけない": "مُمْتَنّ, شَاكِر",
 "かたじけなくも": "بكياسة, بلطف (بطريقة لطيفة أو رشيقة)",
 "かたじるし": "رتبة كتف, علامة الكتف (كَتَّافات تشير إلى الرتبة)",
 "かたじん": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "かたす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / مُنَظَّم, نَظِيف",
 "かたすかし": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / خَيْبَة أَمَل",
 "かたすかしをくわせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "かたすくに": "سِجِّين, عَالَم سُفْلِيّ",
 "かたすみ": "زَاوِيَة, رُكْن",
 "かたずつう": "شَقِيقَة, صُدَاع نِصْفِي (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق؛ مؤنث الشَقِيْق، وهو الأَخ من نفس الأُمّ والأبّ)\nمثال: هي أختي غير الشقيقة.",
 "かたたち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "かたち": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَلَامِح, سِحْنَة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / سلوك ((علم النفس) مجموع الاستجابات أو ردود الفعل أو الحركات التي يقوم بها الكائن الحي في أي موقف) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / أداء, تصرف (فعل أو رد فعل شيء ما (مثل آلة أو مادة) تحت ظروف محددة)\nمثال: يمكن دراسة سلوك الجسيمات الصغيرة في التجارب",
 "かたちづくる": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "かたちばかり": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "かたちんば": "أَعْرَج / أَكْسَح / أَشَلّ ((أَشَلَّ) فلانٌ: أصَابه الشَّلَل؛ (أَشَلَّ) اللهُ فلانًا أَو يَدَهُ: أصابَها بالشَّلَل) / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم) / غير متطابق, متنافر (إما غير متطابق أو متطابق بشكل غير مناسب)",
 "かたっくるしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたっと": "قَعْقَعَ",
 "かたっぱしから": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "かたっぽ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "かたっぽう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "かたつけ": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة) / إنهاء, تشطيب (فعل الإنهاء) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "かたづけ": "إنهاء, تشطيب (فعل الإنهاء) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "かたづける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "かたておち": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "かたてま": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها)",
 "かたてわざ": "أُحَادِيُّ اليَد (يستخدم يداً واحدة أو مُصمَّم لها)",
 "かたでかぜをきる": "تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة) / شِيك جِدًّا, فَخْم ((عامّيّة بريطانيّة) أَنِيق لِلغَايَة) / عامل متجول أسترالي (عامل أسترالي متجول يحمل ممتلكاته الشخصية في صرة أثناء سفره بحثاً عن عمل)",
 "かたとき": "لَحْظَة",
 "かたどおり": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かたどる": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "かたな": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "かたなかじ": "سَيَّاف, سَلَّال",
 "かたにかつぐ": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "かたにはめる": "صُورَة نَمَطِيَّة",
 "かたぬき": "قطاعة البسكويت (أداة مطبخ تستخدم لقطع ورقة من عجين البسكويت إلى الأشكال المطلوبة قبل الخبز)",
 "かたのちからをぬく": "اِسْتَرْخَى",
 "かたはしから": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "かたはだぬぐ": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "かたはらいたい": "سَخِيف, مَسْخَرَة",
 "かたばかり": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "かたばら": "بريسكت, لحم الصدر (قطعة لحم من الصدر أو أسفل الصدر خاصة في البقر)",
 "かたひも": "حمالة, شريط الكتف (شريط يمر فوق الكتف ويدعم ملابس أو حقيبة)",
 "かたびら": "كفن",
 "かたぶく": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي) / زاوية منحازة, وجهة نظر خاصة (طريقة منحازة للنظر إلى شيء ما أو تقديمه)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "かたぶつ": "مُتَحَفِّظ بِإِفْرَاط, مُتَزَمِّت (مبالِغ في التمسّك باللياقة والتحفّظ)",
 "かたほ": "بَلَغَ / ناقص-غير كامل / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "かたほう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "かたほうこうそうごどうさ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたほうこうつうしん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたほとり": "زَاوِيَة, رُكْن",
 "かたぼうえき": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "かたぼうかつぎ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَبِيب, حَبِيبَة",
 "かたまえ": "أحادي الصدر ((عن الملابس) يغلق بتداخل ضيق ويُثبت بصف واحد من الأزرار)\nمثال: سترة أحادية الصدر",
 "かたまひ": "شلل نصفي (شلل جانب واحد من الجسم)",
 "かたまり": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / تَجَسَّد",
 "かたまる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَجَمَّدَ",
 "かたみ": "تذكار (شيء يذكر بأحداث الماضي) / كَتِف, كِتْف / شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "かたみがひろい": "فَخُور",
 "かたみち": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみちきっぷ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみちこうくうけん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみちりょうきん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "かたみに": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "かたみのせまい": "خَجْلَان, خَجُول",
 "かたむ": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / زَنَى (مَارَسَ الزِّنَى)",
 "かたむき": "مُنْحَدَر / مَيْل / مَيْل, نَزَعَة",
 "かたむく": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي) / زاوية منحازة, وجهة نظر خاصة (طريقة منحازة للنظر إلى شيء ما أو تقديمه)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "かたむける": "منحدر (سطح مائل يربط بين مستويين) / منحدر, ميل (تكوين جيولوجي مرتفع ومائل)\nمثال: تسلق المنحدر الشديد / خَرَاب, خَرَابَة / دَمَّرَ / شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "かたむすび": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع) / عقدة منزلقة (عقدة في نهاية حبل يمكن أن تنزلق على الحبل الذي صنعت حوله)",
 "かため": "تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً)) / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور) / تحجر, تصلب (تصلب أو تغلظ غير طبيعي للأنسجة)\nمثال: تصلب الخرسانة / تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء. / دِفَاع, حِمَايَة / دِفاع",
 "かためがね": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "かためる": "تَجَمَّدَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / قَوَّى",
 "かたもじ": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "かたもち": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط) / إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة)",
 "かたもちばり": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "かたやき": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "かたやぶり": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "かたゆで": "مَسْلُوقٌ تَمَامًا ((عَنِ البَيْض) مَسْلُوقٌ حَتَّى تَمَاسُكِ الصَّفَار) / عَديم الإحْساس, مُتَقَسٍّ (أصبَح قاسِيًا بِفِعْل التَّجْرِبَة؛ لا تُؤَثِّر فيه المَشاعِر) / عَنِيد, مُتَجَلِّد (قاسٍ وغليظ بفعل الخبرة والتجربة)",
 "かたゆでたまご": "بيض مسلوق جيداً (بيضة مغلية برفق حتى يتصلب البياض والصفار)",
 "かたよったかんがえ": "إِجْحَاف, تَحَامُل",
 "かたより": "إِنْحِرَاف / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "かたよる": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "かたらい": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / خطبة, خطوبة (وعد متبادل بالزواج)",
 "かたらう": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "かたり": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / حِكَايَة / مَوْضُوع, مَوَاضِيع / غَشَّ, جَدَعَ",
 "かたりかける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "かたりく": "قِصَّة, حِكَايَة",
 "かたりぐさ": "قِصَّة, حِكَايَة",
 "かたりて": "رَاوٍ, رَاوِيَة",
 "かたりべ": "قَصَّاص, قَصَّاصَة",
 "かたりもの": "سَرْدِي / قِصَّة, حِكَايَة / سَرْدِيَّة, رِوَايَة",
 "かたりんそうこう": "تَزَلُّج",
 "かたる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه. / اِفْتَرَضَ",
 "かたわ": "أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ) / ناقص-غير كامل",
 "かたわく": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب)",
 "かたわら": "جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "かたわらに": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "かたわれ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / شَرِيك فِي جَرِيمَة / نَظِير",
 "かたわれづき": "هِلَال",
 "かたをいれる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "かたをかす": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "かたをつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "かたをもつ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "かたん": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "かたんしゃ": "شَرِيك فِي جَرِيمَة",
 "かたんせい": "طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله دون أن ينكسر)",
 "かたバラ": "بريسكت, لحم الصدر (قطعة لحم من الصدر أو أسفل الصدر خاصة في البقر)",
 "かたパン": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً) / ماهوجني الجبل (نوع من الماهوجني الجبلي)",
 "かた焼": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "かた焼き": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "かだい": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / تَمْرِين / مَسْأَلَة / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مُفْرِط, زَائِد",
 "かだいきょく": "قطعة ديكور مستقلة (قطعة من المناظر تهدف إلى الوقوف بمفردها كجزء من إعداد المسرح)",
 "かだいし": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "かだいじょうみゃく": "وريد أجوف سفلي (يتلقى الدم من الأطراف السفلية وأعضاء البطن ويصب في الجزء الخلفي من الأذين الأيمن للقلب؛ يتكون من اتحاد الوريدين الحرقفيين)",
 "かだいひょうか": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية)",
 "かだむ": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / زَنَى (مَارَسَ الزِّنَى)",
 "かだやし": "سمكة البعوض (سمكة فضية ذات صفوف من البقع السوداء تعيش في أمريكا الشمالية الاستوائية وجزر الهند الغربية؛ مهمة في مكافحة البعوض)",
 "かだん": "حاسم, حاسمة / سرير سفلي, مضجع سفلي (السرير السفلي من بين سريرين (أحدهما فوق الآخر)) / حوض زهور (حوض تنمو فيه الزهور)",
 "かち": "قِيمَة / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "かちあう": "تَصَادُم / يتصادم / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "かちあがる": "يقرب",
 "かちある": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "かちいくさ": "اِنْتِصَار, نَصْر / مُشَاة, بِيَادَة",
 "かちうま": "فَائِز, فَائِزَة",
 "かちえる": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "かちかち": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "かちかん": "قيم, مبادئ (معتقدات شخص أو مجموعة اجتماعية لديهم استثمار عاطفي فيها (سواء مع أو ضد شيء ما))\nمثال: لديه قيم محافظة للغاية",
 "かちき": "إرَادَة / رَغْبَة, إرَادَة",
 "かちく": "حيوان أليف, حيوان داجن (أي من الحيوانات المختلفة التي تم ترويضها وجعلها مناسبة للبيئة البشرية)",
 "かちくか": "اِسْتِئْنَاس (استأنس الحيوان:صار أليفاَ،ذهبت عنه وحشيّته ، استأنس الزّائر:استأذن،استأنس إلى فلان:أَنِس به،سكن إليه،ذهبت به وحشته،ألفه و اطمأنّ إليه؛ الاستئناس في كلام العرب النّظر،يُقال:اذهب فاستأنس هل ترى أحداً، استأنس الرّجل:استأذن وتبصّر،وبه فُسِّر قوله تعالى:…)\nمثال: هل يمكن استئناس ابن آوى؟",
 "かちくかこい": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "かちくしゃ": "سيارة سباق قياسية (سيارة سباق بالهيكل الأساسي لسيارة متاحة تجارياً) / سيارة مخزنة (سيارة محفوظة في مخزون التجار للبيع المنتظم)",
 "かちぐみ": "فَائِز, فَائِزَة",
 "かちこち": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "かちこみ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "かちたかい": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "かちっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "かちてん": "مَفْصِل, مِفْتَاح",
 "かちとる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "かちど": "مَاشٍ",
 "かちぬき": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "かちぬきせん": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "かちはんだん": "حكم قيمي (تقييم يكشف عن قيم الشخص الذي يقوم بالتقييم أكثر مما يكشف عن واقع ما يتم تقييمه)",
 "かちびと": "مَاشٍ",
 "かちほこる": "نصر (نصر بمعنى: أعان، نصره الله: أعانه)\nمثال: هذا النصر هو نصركم.",
 "かちぼし": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "かちむし": "يَعْسُوب",
 "かちめ": "فُرْصَة",
 "かちゃかちゃ": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "かちゃり": "رنين, طنطنة (صوت معدني واضح خفيف كما لجرس صغير)",
 "かちゅう": "دردور, دوامة مائية (تيار دائري قوي من الماء (عادة نتيجة لتعارض المد والجزر)) / تلفيف, دوامة (شكل شيء يدور بسرعة) / فَضِيحَة / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر) / احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة / أَرِسْتُقْرَاطِيَّة / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "かちゅうおん": "تحت الوسطى ((موسيقى) النغمة السادسة في سلم كبير أو صغير (أو الثالثة تحت نغمة الأساس))",
 "かちょう": "مسموع / بَطْرِيَرْك, بَطْرَك / شَيْخ, بَطْرِيَرْك / ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية) / نَامُوسِيَّة",
 "かちょうかんまくどうみゃく": "شريان مساريقي سفلي (ينشأ بالقرب من النهاية السفلية للأبهر ويغذي الأمعاء الغليظة)",
 "かちょうきん": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "かちょうしゅうは": "تَرَدُّد صَوْتِيّ (تردد موجة صوتية مسموعة)",
 "かちょうしゅうはすう": "تَرَدُّد صَوْتِيّ (تردد موجة صوتية مسموعة)",
 "かちょうど": "مسموعية (جودة أو حقيقة كون الشيء مسموعاً أو مدركاً بالأذن)",
 "かちろん": "أكسيولوجيا, علم القيم (دراسة القيم والأحكام القيمية)",
 "かちわる": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "かちん": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "かちんかちん": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "かちんこ": "كلاكيت, لوحة التصفيق (معدات تصوير فوتوغرافي تستخدم لمزامنة الصوت والصورة المتحركة؛ لوحات تضرب معاً أمام كاميرا الفيلم)",
 "かちんこちん": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "かち割る": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "かち合う": "تَصَادُم / يتصادم / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "かち込み": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "かっ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "かっか": "ثمرة نووية, حسلة (فاكهة لحمية غير متفتحة ذات بذرة واحدة: مثل اللوز والخوخ والبرقوق والكرز والخمان والزيتون والعناب)",
 "かっかく": "باهِر",
 "かっかん": "موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات الشخصية)",
 "かっかんてき": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "かっき": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد. / تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل)",
 "かっきおういつ": "فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة) / فوار ((للسائل) يطلق فقاعات) / غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون)\nمثال: نبيذ فوار",
 "かっきづける": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "かっきてき": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "かっきゅう": "فلقة, قسيمة أريمية (أي خلية ناتجة عن انقسام البويضة المخصبة)",
 "かっきょ": "مسافة زاوية (الفصل الزاوي بين جسمين كما يدركه المراقب)\nمثال: سجل المسافات الزاوية بين النجوم",
 "かっきょう": "نَشَاط\nمثال: 株式市場は活況を呈している。 — سوق الأسهم يشهد نشاطاً زائداً.",
 "かっきり": "بِالضَّبْط, تَمَامًا / بِالْضَبْط / بانتظام, في الموعد (في الوقت المتوقع أو المناسب)\nمثال: تصل دائماً في الموعد",
 "かっきる": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "かっくう": "طيران شراعي (نشاط الطيران بطائرة شراعية)",
 "かっくうき": "طائرة شراعية (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "かっけ": "بري بري (عوز فيتامين ناتج عن نقص الثيامين (فيتامين ب1))",
 "かっけい": "مَعِيشَة, مَعَاش",
 "かっけぇ": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "かっけえ": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "かっけつ": "نفث الدم (سعال الدم من الجهاز التنفسي؛ عادة ما يشير إلى عدوى شديدة في الشعب الهوائية أو الرئتين)",
 "かっけー": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "かっこ": "كُلّ / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / شَرِيحَة / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / مُنَاسِب, مُلَائِم / حذاء خشبي, قبقاب (حذاء عادة ما يكون نعله خشبياً)",
 "かっこいい": "جَذَّاب",
 "かっこう": "نُزُول / اَصْل / مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / مُنَاسِب, مُلَائِم / فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل. / تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "かっこういい": "جَذَّاب",
 "かっこうがいい": "جَذَّاب",
 "かっこうがよい": "جَذَّاب",
 "かっこうきょうぎ": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة",
 "かっこうのいい": "جَذَّاب",
 "かっこうのまと": "ضَحِيَّة, فَرِيسَة (شخص يكون هدفاً لهجوم (خاصة السخرية أو الاستغلال) من قبل شخص أو تأثير معاد)\nمثال: وقع فريسة لقطاع الطرق",
 "かっこうのよい": "جَذَّاب",
 "かっこうのわるい": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "かっこうふう": "رياح هابطة (رياح ناتجة عن الحركة الهابطة للهواء البارد)",
 "かっこうわるい": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "かっこうをつける": "جِلْسَة, جَلْسَة / تَكَلُّف",
 "かっこええ": "جَذَّاب",
 "かっこつき": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟ / شَرِيحَة",
 "かっこない": "شَرِيحَة",
 "かっこふどう": "مَنِيع",
 "かっこふばつ": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "かっこむ": "مِجْرَفَة, مِجْرَاف / مجرفة",
 "かっこよい": "جَذَّاب",
 "かっこわるい": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "かっこをつける": "جِلْسَة, جَلْسَة / تَكَلُّف",
 "かっこ付き": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟ / شَرِيحَة",
 "かっこ悪い": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "かっさい": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "かっさいをおくる": "صَفَّقَ",
 "かっさばく": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "かっさらう": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "かっし": "جرذ الخشب (أي من القوارض الصغيرة قصيرة الذيل المتنوعة في نصف الكرة الشمالي، تتميز بفراء ناعم رمادي من الأعلى وأبيض من الأسفل مع ذيول مكسوة بالفراء وآذان كبيرة؛…)",
 "かっしゃ": "مَنْجُور",
 "かっしゃしんけい": "عصب بكري, عصب قحفي رابع (أي من العصبين القحفيين على كلا الجانبين اللذين يتحكمان في العضلات المائلة العلوية للعينين)",
 "かっしょうき": "طائرة شراعية (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "かっしょくさいぼうしゅ": "ورم القواتم (ورم وعائي في الغدة الكظرية)",
 "かっしょくはん": "قناع الحمل, كلف (تغير لون وجه المرأة إلى الأسمر ويرتبط بالحمل أو باستخدام حبوب منع الحمل)",
 "かっすいき": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "かっせい": "نَشَاط / نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور.",
 "かっせいか": "إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / تحفيز, تنشيط (فعل استنهاض كائن حي للعمل) / مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل) / تحفيز, تنبيه ((في علم وظائف الأعضاء) تأثير منبه (على الأعصاب أو الأعضاء وما إلى ذلك)) / تفعيل, تنشيط (الجعل نشطاً وفعالاً (مثل القنبلة)) / تفعيل, تنشيط (نشاط التسبب في الحصول على طاقة ونشاط) / تنشيط (تحفيز النشاط في كائن حي أو مادة كيميائية)",
 "かっせいかエネルギー": "طاقة التنشيط (الطاقة التي يجب أن يكتسبها نظام ذري قبل أن تحدث عملية (مثل الانبعاث أو التفاعل))\nمثال: يقال إن المحفزات تقلل من طاقة التنشيط أثناء المرحلة الانتقالية للتفاعل",
 "かっせいざい": "مُنْشِط",
 "かっせいたん": "فحم منشط, كربون نشط (مسحوق أو حبيبات الكربون تستخدم للتنقية عن طريق الامتزاز؛ يُعطى عن طريق الفم (كطين سائل) ليكون ترياقاً لبعض أنواع السموم)",
 "かっせいぶい": "موقع نشط (الجزء من الإنزيم أو الجسم المضاد حيث يحدث التفاعل الكيميائي)",
 "かっせき": "مقعد منزلق (مقعد المجذف الذي ينزلق للأمام والخلف) / تلك (معدن ناعم الحبيبات ذو ملمس صابوني ناعم ويتكون من سيليكات المغنيسيوم المائية؛ يستخدم في مجموعة متنوعة من المنتجات بما في ذلك بودرة التلك)",
 "かっせきこ": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "かっせん": "مَعْرَكَة / صِمَام (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه. / شُعْلَة نَشَاط, مُتَحَمِّس (شخص يقظ ونشيط للغاية)",
 "かっそう": "طيران شراعي (نشاط الطيران بطائرة شراعية) / تَاكْسِي, سَيَّارَةُ أُجْرَة / طحالب بنية (طحالب يحجب الكلوروفيل فيها أصباغ بنية وصفراء)",
 "かっそうるい": "طحالب بنية (طحالب يحجب الكلوروفيل فيها أصباغ بنية وصفراء)",
 "かっそうろ": "مَدْرَج, مُدَرَّجُ الْمَطَارِ",
 "かっそく": "مِدَكّ",
 "かったい": "سَائِل / فَقِير / جذام, مرض هانسن (مرض حبيبي مزمن وسار يحدث في المناطق الاستوائية وشبه الاستوائية؛ يتميز بعقيدات ملتهبة تحت الجلد وهزال أجزاء الجسم؛ تسببه عصيات المتفطرة الجذامية)",
 "かったくざい": "مِزْلَق",
 "かったつ": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك) / غير قابل للصدمة, متفتح الذهن (لا يمكن أن يصاب بالصدمة (يتقبل كل شيء))\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "かったつじざい": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك) / غير قابل للصدمة, متفتح الذهن (لا يمكن أن يصاب بالصدمة (يتقبل كل شيء))\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "かったるい": "فَاقِدُ الحَمَاس, مُتَبَلِّد (يفتقر إلى الحماس أو الحيوية) / فَاتِرُ الهِمَّة, مُحْبَط (يتّسم بانخفاض المعنويّات وانعدام الحماس) / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "かったん": "فحم بني, ليغنيت (مرحلة وسيطة بين الخث والفحم البيتوميني)",
 "かっち": "مَاكِر",
 "かっちゅうし": "صانع أسلحة (مُصنِّع للأسلحة النارية) / صانع أسلحة, مسؤول تسليح (جندي مجند مسؤول عن صيانة الأسلحة الصغيرة والمدافع الرشاشة وما إلى ذلك) / صانع الأسلحة, صانع الدروع (عامل ماهر في صنع الدروع أو الأسلحة)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير",
 "かっちょいい": "جَذَّاب",
 "かっちょよい": "جَذَّاب",
 "かっちり": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / مُحْكَم, مُلائِم (ضَيِّق وَمُلائِم لِلجِسْم بِشَكْل مُريح)",
 "かって": "أَنَانِيَّة / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / مُلَاءَمَة, مُنَاسَبَة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "かってきまま": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "かってぐち": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "かってっこう": "ليمونيت (خام أكسيد الحديد واسع الانتشار؛ خليط من الغوثيت والهيماتيت والليبدوكروشيت)",
 "かってでる": "مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "かってに": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "かってにしやがれ": "مَبْهُور, لَاهِث",
 "かってむき": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "かっとう": "صِرَاع, نِزَاع\nمثال: 父と私の葛藤に、彼は気付いていないようです。 — لا يبدو على علم بسوء التفاهم الذي بيني وبين أبي. / تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / تَخْصِيص",
 "かっとなる": "اِنْدَلَعَ",
 "かっとばす": "تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي) / خبطة, صفقة (ارتطام قوي يصدر صوتاً عالياً) / ارتطام, صفع (الضجيج الناتج عن الارتطام القوي لجسمين) / اكتساح, سلام (الفوز بجميع الحيل أو جميعها باستثناء واحدة في لعبة البريدج)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "かっぱ": "كَبَا / خِيَار (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار. / تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه / شرح مستفيض, عرض (تفسير أو شرح منهجي (مكتوب عادة) لموضوع معين) / مِعْطَف",
 "かっぱつ": "دَجِر",
 "かっぱのへ": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "かっぱの屁": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "かっぱらい": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة / لص متسلل (لص يسرق دون استخدام العنف)",
 "かっぱらう": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "かっぱん": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "かっぱんしょ": "مَطْبَعَة",
 "かっぱんじょ": "مَطْبَعَة",
 "かっぷ": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "かっぷく": "إخراج الأحشاء, نزع الأحشاء (عملية إزالة الأمعاء أو الأحشاء؛ عملية القطع بحيث تبرز الأحشاء)",
 "かっぷほうしき": "خطة تقسيط, شراء بالتقسيط (نظام لدفع ثمن البضائع على أقساط)",
 "かっぺ": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "かっぺん": "تحمير, تحميص (الطهي حتى يصبح لونه بنياً ومقرمشاً فوق نار أو شواية)\nمثال: التحميص الجيد يجب أن يحمر جانبي قطعة الخبز",
 "かっぽ": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً')) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / خطوة (المسافة التي تغطيها خطوة)\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "かっぽう": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ. / مَطْعَم",
 "かっぽうてん": "مَطْعَم",
 "かっぽうどり": "وَقْوَاق, وَقْوَاقِيَّة",
 "かっぽじる": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "かっ切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "かっ捌く": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح."
}
