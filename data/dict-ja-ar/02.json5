 "おそぢえ": "إدراك متأخر (فهم طبيعة حدث ما بعد وقوعه)\nمثال: الإدراك المتأخر دائماً أفضل من التوقع",
 "おそなえ": "قُرْبَان",
 "おそば": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها. / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "おそばづき": "خَادِم, خَادِمَة",
 "おそば付き": "خَادِم, خَادِمَة",
 "おそまきながら": "بشكل متأخر, متأخراً (في وقت لاحق عن المعتاد أو المتوقع)\nمثال: وصل القطار متأخراً",
 "おそまつ": "فَقِير / مِسْكِين / فُقَرَاء",
 "おそめ": "مُتَأَخِّرٌ نَوْعاً مَا (متأخّر إلى حدّ ما)",
 "おそよう": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おそらく": "مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おそらくは": "مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おそる": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "おそるおそる": "بخوف (مع شعور بالخوف) / برعب, بشكل مخيف (بطريقة مثيرة للقلق)\nمثال: هرعت أسفل الدرج بخوف",
 "おそるべき": "فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُذْهِل",
 "おそるべし": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة)",
 "おそれ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما. / مُخَاطَرة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / خَاطَرَ\nمثال: أنا ذاهب للخطر. / هَيْبَة / ذُهُول",
 "おそれいりやのきしぼじん": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "おそれいりやのきしもじん": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "おそれいる": "عَجَبَ",
 "おそれおおい": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة) / جاف, غير مهذب (لا يظهر أي كياسة؛ وقح) / جِلْف, خَشِن (يفتقر إلى اللباقة الاجتماعية)\nمثال: شاب منعزل وفظ أحياناً",
 "おそれおおくも": "بكياسة, بلطف (بطريقة لطيفة أو رشيقة)",
 "おそれげ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "おそれげもなく": "بشجاعة (بطريقة شجاعة)\nمثال: دخل المنزل المحترق بشجاعة",
 "おそれしらず": "انتفاء الخوف, جسارة (سمة عدم الشعور بالخوف) / جسارة, عدم الخوف (عدم الشعور بالخوف)",
 "おそれる": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "おそれをしらない": "جريء, جريئة",
 "おそれ多い": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة) / جاف, غير مهذب (لا يظهر أي كياسة؛ وقح) / جِلْف, خَشِن (يفتقر إلى اللباقة الاجتماعية)\nمثال: شاب منعزل وفظ أحياناً",
 "おそろ": "نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "おそろい": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "おそろしい": "فَظِيع / مُرْعِب / فَظِيع, أَرْبَد\nمثال: その嵐の天候は恐ろしかった。 — كان جو العاصفة رهيبا. / مدهش, مفاجئ (يسبب المفاجأة أو العجب أو الذهول)\nمثال: التقرير يظهر نقصاً مفاجئاً في البيانات الواقعية الصلبة",
 "おそろしげ": "مُجَفِّل, مُخِيف",
 "おそろっち": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "おそわる": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "おそん": "تصبيغ, تلوين مجهري ((علم الأنسجة) استخدام صبغة لتلوين العينات للدراسة المجهرية) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "おそーい": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "おぞい": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / خَبِيث, مَاكِر / مُقْرِف, مُقَزِّز",
 "おぞけ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "おぞましい": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "おたあさま": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "おたおた": "مُتَوَتِّر, مُرْتَبِك (أُلقِي في حالة من الاضطراب والارتباك المتهيّج)",
 "おたかい": "مُتَعَالٍ, الْمُتَعَالِي",
 "おたから": "كَنْز / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "おたがい": "بَعْضُهُ الْبَعْض",
 "おたがいに": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "おたく": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / أُوتَاكُو, عُطَاكُو",
 "おたくさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おたけび": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / صرخة, عويل (صيحة حادة ثاقبة) / صراخ, صرخة (ضجيج عالي النبرة يشبه صرخة الإنسان)\nمثال: جذب صراخها الجيران",
 "おたずね": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / بَحْثِيّ, فَاحِص (يستكشف بشكل معمّق وشامل) / سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / ثَاقِب, نَافِذ (ذو حدة ونفاذ في الفكر أو التعبير)",
 "おたずねもの": "هارب من العدالة (شخص مطلوب من قبل ضباط القانون؛ شخص يحاول التهرب من العدالة)",
 "おたたさま": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "おたち": "رَحِيل, مُغَادَرَة / مَنْزِلَة, مَكَانَة",
 "おたちだい": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "おたっし": "إِعْلَان, بَلَاغ",
 "おたなもの": "تاجر, صاحب متجر (تاجر ذكر يمتلك أو يدير متجراً)",
 "おたのしみ": "مُتْعَة, مِتْعَة / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "おたのしみかい": "طَرَف / حَفْلَة, اِحْتِفَال",
 "おたふくかぜ": "نُكَاف",
 "おたふくまめ": "فُول, بَاقِلَّاء",
 "おたふく風邪": "نُكَاف",
 "おたま": "مِغْرَفَة / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "おたまじゃくし": "مِغْرَفَة / شُرْغُوف (الضِفْدَعُ الصغير) / نغمة, نوتة (تدوين يمثل حدة ومدة صوت موسيقي)\nمثال: أمسك المغني بالنوتة لفترة طويلة جداً",
 "おたまや": "ضَرِيح, مَرْقَد",
 "おためしごよう": "جَلَّاد",
 "おたんこなす": "مُغَفَّل, أَحْمَق",
 "おたんじょうかい": "حَفْلَة عِيد مِيلَاد",
 "おたんじょうび": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "おたんじょうびおめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "おたんちん": "مُغَفَّل, أَحْمَق",
 "おだい": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ) / مَوْضُوع",
 "おだいじに": "أَتَمَنَّى لَكَ الشِّفَاءَ الْكَامِل, أَتَمَنَّى لَكِ الشِّفَاءَ الْكَامِل\nمثال: くれぐれもお体をお大事に。 — اعتنِ بنفسك.",
 "おだいばん": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "おだいもく": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "おだく": "تَلْوِيث, تَلَوُّث",
 "おだちん": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "おだて": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "おだてる": "تَمَلَّقَ, تَبَصْبَصَ",
 "おだぶつ": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "おだやか": "هَادِئ / طَمْأَنَ / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "おだんご": "كَعْكَة الشَّعْر (لفة من الشعر توضع عند مؤخرة العنق)",
 "おだんごあたま": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "おだんごヘア": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "おち": "اِنْزَلَقَ / أثر, عاقبة (ظاهرة تتبع وتنتج عن ظاهرة سابقة)\nمثال: كان التأثير المغناطيسي أكبر عندما كان القضيب بالطول / نُكْتَة",
 "おちあう": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "おちいりやすい": "سَاجِد, مُنْكَبّ (مستلقٍ على الوجه متَّجهاً للأسفل) / مُعَرَّض, نَزَّاع (لديه ميل أو نزعة (لشيء ما)؛ غالبًا يُستخدم مُركّبًا)",
 "おちいる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "おちおち": "بِهُدُوء",
 "おちかづき": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "おちかづきになる": "تَعَرَّفَ",
 "おちくぼむ": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "おちぐち": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / فَم, بق / فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "おちこち": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "おちこぼれ": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات) / الْبَقَايَا / مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "おちこぼれる": "تَأَخَّرَ / قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "おちこみ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُنْخَفَض",
 "おちついた": "هَادِئ / طَمْأَنَ / ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر) / مُسْتَعْمَر, مُسْتَوْطَن (يسكنه مستوطنون أو مستعمرون) / مستقر, مستوطن (تم تأسيسه في وضع أو مكان مرغوب؛ غير متنقل) / محسوم, مُبت فيه (تم تحديده أو البت فيه بما لا يدع مجالاً للنزاع أو الشك)\nمثال: بدو؛ اندمجوا بين الناس المستقرين / غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "おちつき": "هُدُوء / اِسْتِقْرَار",
 "おちつく": "أَهْدَأَ, هَدَّأَ / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "おちつける": "صَامِت, هَادِئ",
 "おちど": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "おちのひと": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك سواء)",
 "おちのびる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "おちばいろ": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة) / قماش خمري (قماش منزلي الغزل لونه بني محمر)",
 "おちむしゃ": "هَارِب",
 "おちゃ": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة) / فِنْجَان شَاي (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: صب الشاي لضيفك. / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / سَادُو, طُقُوس اَلشَّاي",
 "おちゃかい": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)",
 "おちゃっぴい": "ثَرْثَار",
 "おちゃのこ": "بَسِيطَة, لُقْمَة سَائِغَة",
 "おちゃのこさいさい": "بَسِيطَة, لُقْمَة سَائِغَة",
 "おちゃのま": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "おちゃめ": "دَاعِب, لَعُوب / جُوكَر",
 "おちゃや": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "おちゃらかす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "おちゃをにごす": "لَفَّ وَدَارَ",
 "おちゆく": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "おちょくる": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "おちょける": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "おちり": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "おちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "おちんちん": "قَضِيب, ذَكَر",
 "おっ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "おっかあ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مالكة (امرأة مالكة) / كَهْل / كَهْلَة",
 "おっかけ": "طَارَدَ / مُعْجَبَة (معجبة شابة متحمسة (خاصة التي تتبع فرق الروك)) / قَرِيبًا, سَرْعَانَ مَا",
 "おっかける": "طَارَدَ",
 "おっかさん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "おっかない": "مُجَفِّل, مُخِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "おっかなびっくり": "بخوف (مع شعور بالخوف) / برعب, بشكل مخيف (بطريقة مثيرة للقلق)\nمثال: هرعت أسفل الدرج بخوف",
 "おっかぶさる": "غِطَاء / غِلَاف / غَطَّى",
 "おっかぶせる": "غِطَاء / غِلَاف / غَطَّى",
 "おっきい": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おっきな": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おっくう": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "おっけ": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "おっけい": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "おっけん": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "おっけー": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "おっこ": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت / خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "おっこう": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "おっこちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "おっことす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "おっこる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "おっさん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً) / عجوز متصابي (رجل في منتصف العمر ذو ميول شهوانية)",
 "おっしゃる": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / سُمِّيَ",
 "おっせぇ": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "おっせえ": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "おっせー": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "おっそい": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "おっそーい": "بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "おった": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "おったつ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "おったてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "おっちぬ": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "おっちゃん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "おっちょこちょい": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "おっちん": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "おっちんとん": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "おっつく": "بَلَغَ",
 "おっつけ": "قَرِيبًا, سَرْعَانَ مَا",
 "おって": "مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد) / سَاعٍ, طَالِب (شخص يسعى وراء خطة أو هدف)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل / بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "おってがき": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "おっと": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة! / فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر جلد الفقمة) / فقمة الفراء الشمالية (فقمة ذات أذنين تعيش في شمال المحيط الهادئ)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "おっとせい": "فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر جلد الفقمة) / فقمة الفراء الشمالية (فقمة ذات أذنين تعيش في شمال المحيط الهادئ)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "おっとっと": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "おっとり": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "おっはあ": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おっはー": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おっぱ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "おっぱい": "ثَدْي / حليب الأم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "おっぱいをあげる": "أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع)",
 "おっぱじめる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "おっぱらう": "طَرَدَ",
 "おっぴら": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "おっぴらく": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "おっぴろげる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "おっほん": "نحنحة (إصدار صوت مشابه لتنظيف الحلق؛ يهدف لجذب الانتباه، أو التعبير عن التردد، أو ملء وقفة، أو إخفاء الإحراج، أو تحذير صديق، إلخ)",
 "おっぽ": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "おっぽりだす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "おっぽり出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "おっもしれー": "مُضْحِك, هَزْلِيّ",
 "おっ始める": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "おっ広げる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "おっ放り出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "おっ死ぬ": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "おっ母": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مالكة (امرأة مالكة) / كَهْل / كَهْلَة",
 "おっ母さん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "おっ立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "おっ立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "おっ開く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "おつ": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / شُكْرًا, تِسْلَم / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "おつうじ": "حَرَكَة",
 "おつかい": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية)\nمثال: あの子はよくお使いをする。 — غالبًا ما يقوم الصبي بالمشاوير / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة)",
 "おつかれ": "شُكْرًا / أراكَ قَريبًا, سَلَام / إِرْهَاق, تَعَب",
 "おつかれさま": "شُكْرًا, تِسْلَم\nمثال: 「おさきにしつれいします」「おつかれさまでした」 — انهيت عملي اليوم ،و مقر بالجميل. / أراكَ قَريبًا, سَلَام",
 "おつかれサマンサ": "شُكْرًا, تِسْلَم",
 "おつき": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "おつきあい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "おつきさま": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "おつぎ": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "おつくり": "سَاشِيمِي / تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "おつけ": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "おつげ": "كَاهِن, عَرَّاف / إِلْهَام",
 "おつげのしゅくじつ": "25 مارس, عيد البشارة (مهرجان يحيي ذكرى إعلان التجسد من قبل الملاك جبرائيل للسيدة العذراء مريم؛ يوم ربع سنوي في إنجلترا وويلز وأيرلندا)",
 "おつしゅ": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "おつじゅん": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "おつとめ": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "おつねん": "إِسْبَات",
 "おつぼう": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض؛ مضيف لقراد داء لايم)",
 "おつぼね": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "おつまみ": "وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "おつむ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / دِمَاغ / مخ (دِمَاغ) / نفوخ / دِماغ / مُخ (دِمَاغ)",
 "おつや": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "おつゆ": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "おつり": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "おつれ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "おて": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "おてあげ": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "おてあらい": "مِرْحَاض, تواليت\nمثال: お手洗いはどこですか。 — أين الحمّام؟",
 "おてかず": "مُشْكِلَة, مَتاعِب",
 "おてすう": "مُشْكِلَة, مَتاعِب",
 "おてだま": "كيس حبوب, كيس فول (كيس قماشي صغير مملوء بالحبوب المجففة؛ يُرمى في الألعاب)",
 "おてつき": "سَيِّدَة / خَلِيلَة, عَشِيقَة / مُخَالَفَة",
 "おてつだい": "خَادِمَة, خَدامَة / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "おてつだいさん": "خَادِمَة, خَدامَة",
 "おてて": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "おてふき": "مِنْشَفَة",
 "おてほん": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "おてまえ": "مَهَارَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おてもと": "أَعْوَاد الْأَكْل, هَاشِي",
 "おてもときん": "المخصصات الملكية (بدل للنفقات الشخصية للملك)",
 "おてやわらか": "مُؤَدَّب",
 "おてやわらかに": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "おてら": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "おてらさま": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "おてらさん": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "おてん": "بُقْعَة",
 "おてんき": "طَقْس, جَوّ\nمثال: いいお天気ですね。 — إنه يوم جميل. / مَزَاج",
 "おてんとうさま": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / بروفيدنس",
 "おてんとさま": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / بروفيدنس",
 "おてんば": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おてんばむすめ": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おてんば娘": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おでい": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / رُسَابَة / جَهَنَّم, جَحِيم / جَحِيم, جَهَنَّم",
 "おでかけ": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "おでき": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "おでこ": "حَاجِب (قوس الشعر فوق كل عين) / جبهة, جبين (جزء الوجه فوق العينين) / قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة",
 "おでまし": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "おでんわ": "مُكَالَمَة / مُكَالَمَة هَاتِفِيَّة, مُحَادَثَة تِلِفُونِيَّة / هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه) / تَلْفَنَ / هَاتَفَ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "おと": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / شُهْرَة / أَخ الْأَصْغَر, أَخ الصَّغِير / صَغِير, حَدَث / فَاتِن, قَشِيب",
 "おとあわせ": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "おといあわせ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "おとう": "بَابَا",
 "おとうさま": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "おとうさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おとうちゃん": "بَابَا",
 "おとうと": "أَخ الْأَصْغَر, أَخ الصَّغِير / شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "おとうとぎみ": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "おとうとごろし": "قتل الأخ, قتل الشقيق (قتل الشخص لأخيه أو أخته) / نيران صديقة (نيران تصيب أو تقتل حليفاً) / قاتل أخيه (شخص يقتل أخاه أو أخته)",
 "おとうとさん": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "おとおし": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "おとおしだい": "رسم الدخول, رسم خدمة المطعم (رسم ثابت يفرضه مطعم أو ملهى ليلي بالإضافة إلى رسوم الطعام والشراب)",
 "おとおじ": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "おとおり": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "おとがい": "فَكّ / ثَرْثَار",
 "おとがめなし": "تَبْرِئَة",
 "おとぎ": "خادِم, مُعْتَنٍ (يُقَدِّم مُساعَدَة عَمَلِيَّة ورِعايَة) / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / انتباه, تركيز (العملية التي يركز بها الشخص على بعض سمات البيئة مع استبعاد (نسبي) لسمات أخرى) / قِصَّة خُرَافِيَّة, خُرَافَة",
 "おとぎのくに": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا))",
 "おとぎの国": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا))",
 "おとぎばなし": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "おとぎ話": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "おとく": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي / مُفِيد, نَافِع / تَجْدِيف",
 "おとこ": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت / خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "おとこあるじ": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "おとこおや": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "おとこおんな": "بَيْنَ جِنْسِيّ (ذو خصائص جنسية وسيطة بين الذكورة والأنوثة) / بَيْن جِنْسِيّ (يوجد أو يحدث بين الجنسين)",
 "おとこがたつ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "おとこきょうだい": "أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "おとこぎ": "مُرُوءَة",
 "おとこくい": "غَاوِيَة",
 "おとこくさい": "رُجُولِيّ",
 "おとこぐい": "غَاوِيَة",
 "おとこぐるい": "إباحية, خلاعة (صفة الفسق والمجون) / تهتك, جموح (سمة الافتقار للتحفظ أو السيطرة؛ حرية متهورة من الكبت أو القلق)\nمثال: رقصت بجموح",
 "おとこごろし": "فاتنة, مغوية (امرأة تعتبر مغرية بشكل خطير)",
 "おとこし": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / خادم رجل (خادم من الرجال)",
 "おとこしゅ": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / خادم رجل (خادم من الرجال)",
 "おとこしゅう": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / خادم رجل (خادم من الرجال) / مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "おとこたち": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "おとこたらし": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "おとこっぷり": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "おとこっぽい": "رُجُولِيّ",
 "おとこで": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "おとこでひとつで": "بجهد فردي, بمفرده (دون مساعدة)\nمثال: بنيت هذا المنزل بمفردي",
 "おとこどうし": "بصراحة, كرجل لرجل (بشكل مباشر أو صريح) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / أَمِين, صَرِيح (مُبَاشِر وَصَادِق)\nمثال: يجب أن نتحدث كرجل لرجل",
 "おとこのこ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / شاب (مراهق أو شاب بالغ ذكر) / وَلَد مُخَنَّث, فِمْبُوي (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "おとこのなかのおとこ": "أَلْفَا, حَيَوان أَلْفَا / فَحْل, رَجُل أَلْفَا",
 "おとこのひと": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "おとこの娘": "وَلَد مُخَنَّث, فِمْبُوي (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "おとこぶり": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "おとこまえ": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))\nمثال: 彼はなかなかの男前だ。 — إنه وسيم. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "おとこまさり": "قَوِيُّ الإِرَادَة (يَتَّسِمُ بِاسْتِقْلَالِيَّةٍ قَوِيَّةٍ فِي الفِكْرِ وَالحُكْم) / صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "おとこみがき": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "おとこむすび": "عقدة مربعة (عقدة مزدوجة مصنوعة من عقدتين نصفيتين وتستخدم لربط نهايات حبلين)",
 "おとこもじ": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "おとこもち": "حمام الرجال (مرحاض عام للرجال)",
 "おとこもの": "حمام الرجال (مرحاض عام للرجال)",
 "おとこやもめ": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة. / أَعْزَب, عَازِب",
 "おとこらしい": "رُجُولِيّ",
 "おとさた": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "おとし": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تَنْظِيف / فَخّ, مِصْيَدَة / نَتِيجَة",
 "おとしあな": "حفرة, فخ (فخ على شكل حفرة مخفية) / شرك, فخ (صعوبة غير متوقعة أو مفاجئة)",
 "おとしいれる": "فَخّ, مِصْيَدَة / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "おとしがき": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "おとしがみ": "وَرَق مِرْحَاض, وَرَق حَمَّام (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "おとしこうし": "بوابة منزلقة (بوابة تتكون من شبكة حديدية أو خشبية تتدلى في مدخل قلعة أو مدينة محصنة؛ يمكن إنزالها لمنع المرور)",
 "おとしこむ": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "おとしご": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "おとしたまご": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "おとしだね": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "おとしだまキャンペーン": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "おとしどころ": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "おとしまえ": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "おとしより": "عجوز, كبير السن (شخص متقدم في السن)",
 "おとす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "おとずれ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / وُصُول, وِفَادَة / أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "おとずれる": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "おとっさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おとっつぁん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "おとっつあん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "おとと": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "おととび": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات",
 "おとど": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "おとどけ": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "おとどけさき": "وِجْهَة, وُجْهَة",
 "おとどけずみ": "نَقَلَ / مُبَلَّغ عَنْه, مُقَرَّر (تم جعله معروفاً أو التحدث عنه؛ خاصة تقديمه في حساب رسمي)\nمثال: رأيه المبلغ عنه (المنقول)",
 "おとどけや": "مُسَلِّم, مُوَصِّل (شخص يسلم أو ينقل أموالاً أو بضائع) / عامل توصيل, موصل طلبات (شخص يعمل لتوصيل الطلبات) / مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر)",
 "おとどり": "تسجيل صوتي (تسجيل للإشارات الصوتية)",
 "おとなう": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "おとなかわいい": "بَالِغ",
 "おとなげ": "نَضْج",
 "おとなげない": "غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "おとなし": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "おとなしい": "مُؤَدَّب / صَامِت, هَادِئ",
 "おとなしく": "بتواضع (بطريقة متواضعة) / بخضوع, بوداعة (بطريقة خاضعة أو مفتقرة للروح)\nمثال: خفض رأسه بتواضع",
 "おとなしやか": "مُؤَدَّب",
 "おとなじみた": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر) / مبكر النضوج, نابغ (يتميز بالتطور أو النضج المبكر بشكل استثنائي (خاصة في القدرات العقلية))\nمثال: طفل نابغ",
 "おとなじみる": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "おとなじょし": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おとなっぽい": "بَالِغ",
 "おとなになる": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "おとなのおもちゃ": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "おとなびる": "نَاضِج, رَاشِد",
 "おとなりさん": "جَار, جَارة (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "おとのかべ": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة الصوت)",
 "おとのさま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "おとまり": "مَكَثَ, بَقِيَ / إِقَامَة",
 "おとまりかい": "حفلة مبيت, مبيت (مناسبة قضاء ليلة بعيداً عن المنزل أو استضافة ضيف للمبيت (خاصة كحفلة للأطفال))",
 "おとめ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おとめあぜな": "الخط البراهمي (خط (من المحتمل أنه مقتبس من الآرامية حوالي القرن السابع قبل الميلاد) تطورت منه الخطوط الهندية اللاحقة)",
 "おとめご": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おとめざ": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع) / بُرْج اَلْعَذْرَاء, العذراء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おとめチック": "بَنَاتِيّ",
 "おとめ座": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع) / بُرْج اَلْعَذْرَاء, العذراء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おとも": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "おともだち": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "おともなく": "بِهُدُوء",
 "おとり": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / طُعم, مستدرج (مخادع يقود شخصاً ما إلى الخطر (عادة كجزء من مؤامرة))",
 "おとりしょうほう": "إغراء واستبدال (طريقة خادعة للبيع تتضمن الإعلان عن منتج بسعر منخفض جداً لجذب العملاء ثم إقناعهم بالتحول إلى منتج أكثر تكلفة)",
 "おとりそうさ": "عملية سرية, كمين (عملية مصممة للقبض على شخص يرتكب فعلاً إجرامياً) / عملية إيقاع, كمين للشرطة (لعبة ثقة معقدة مخطط لها ومنفذة بعناية كبيرة (خاصة عملية ينفذها عملاء سريون للقبض على المجرمين))\nمثال: نفذت الشرطة عملية سرية",
 "おとりよせ": "ترتيب, نظم (فعل وضع الأشياء في ترتيب تسلسلي) / ترتيب, نظام (ترتيب منطقي أو مفهوم لعناصر منفصلة)\nمثال: كانت هناك أخطاء في ترتيب العناصر في القائمة",
 "おとり商法": "إغراء واستبدال (طريقة خادعة للبيع تتضمن الإعلان عن منتج بسعر منخفض جداً لجذب العملاء ثم إقناعهم بالتحول إلى منتج أكثر تكلفة)",
 "おとり捜査": "عملية سرية, كمين (عملية مصممة للقبض على شخص يرتكب فعلاً إجرامياً) / عملية إيقاع, كمين للشرطة (لعبة ثقة معقدة مخطط لها ومنفذة بعناية كبيرة (خاصة عملية ينفذها عملاء سريون للقبض على المجرمين))\nمثال: نفذت الشرطة عملية سرية",
 "おとる": "تَأَخَّرَ",
 "おとろえ": "إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف)",
 "おとろえる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "おとろしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "おとわれ": "قُلَامَة / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "おとん": "بَابَا",
 "おどおど": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "おどかし": "تَهْدِيد",
 "おどかす": "هَدَّدَ / أَنْذَرَ / فَاجَأَ, بَاغَثَ",
 "おどけ": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "おどけぐち": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "おどけしばい": "فُكَاهَة, كُومِيدِيَا / كُومِيدِيَا",
 "おどけばなし": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "おどけもの": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おどける": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "おどけ者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おどけ話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "おどし": "تَهْدِيد",
 "おどしつける": "هَدَّدَ / أَنْذَرَ",
 "おどしとる": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "おどしをかける": "هَدَّدَ / أَنْذَرَ",
 "おどす": "هَدَّدَ / أَنْذَرَ",
 "おどらす": "أَضَلَّ / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "おどらせる": "أَضَلَّ / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "おどり": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى) / مقتل, نقطة ضعف (مكان ذو قابلية خاصة للإصابة) / يافوخ (أي فجوة غشائية بين عظام الجمجمة عند الرضيع أو الجنين) / معزة خاصة, نقطة ضعف (عاطفة وجدانية)\nمثال: كانت لديها معزة خاصة لابنها الأصغر / قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام)",
 "おどりうた": "بَالَاد",
 "おどりこ": "رَاقِص, رَاقِصَة",
 "おどりじ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "おどりて": "رَاقِص, رَاقِصَة",
 "おどりでる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "おどりば": "صَالَةُ رَقْص (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس. / هُبُوط / بَسْطَة / رُكُود / ركود اقتصادي",
 "おどる": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص. / وَثَبَ (طَفَرَ أو قَفَزَ وهو يجري) / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "おどれ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おどろ": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية)",
 "おどろいたことに": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة) / بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: كان ودوداً بشكل مفاجئ",
 "おどろおどろしい": "مُخِيف, مُوحِش (يُوحِي بِالخَوْف؛ غَرِيب وَمُرْعِب) / مُخِيف, مُوحٍ بِالخَوَارِق (يوحي بما هو خارق للطبيعة؛ غامض ومريب) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة)",
 "おどろかす": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "おどろかせる": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "おどろき": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "おどろくなかれ": "يَا لَلْعَجَبِ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "おどろくべき": "مُذْهِل",
 "おどろくほど": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة) / بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: كان ودوداً بشكل مفاجئ",
 "おどろく程": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة) / بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: كان ودوداً بشكل مفاجئ",
 "おなか": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "おなかいっぱい": "جرعة زائدة, طفح الكيل (وفرة مفرطة غير مرغوب فيها)\nمثال: جرعة زائدة من شكاويك",
 "おなががも": "بلبول شمالي",
 "おながざめ": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها)",
 "おながれ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "おなご": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "おなさけ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "おなしゃす": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "おなじ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها) / نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "おなじい": "نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "おなじく": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها) / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "おなじみ": "مَأْلُوف / عَادِيّ / مُنْتَظِمٌ",
 "おなじよう": "مُمَاثِل",
 "おなべ": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة / خادمة (عاملة منزلية)",
 "おなま": "صَفَاقَة, وَقَاحَة",
 "おなまえ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "おなみだちょうだい": "دَرَامَا مُؤَثِّرَة, قِصَّة مُبْكِيَة (سرد عاطفي مفرط)",
 "おなめ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "おなもみ": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…) / خراق البحر, شبيط",
 "おなら": "رِيح, ريح / لَفَّ",
 "おなり": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "おなわ": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره)",
 "おに": "غُول, غَشِيم / هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "おにあい": "صَيْرُورَة",
 "おにあそび": "زَقِيطَة",
 "おにいさん": "اَلْأَخ اَلْأَكْبَر / شاب (مراهق أو شاب بالغ ذكر)",
 "おにいちゃん": "اَلْأَخ اَلْأَكْبَر / شَابّ, فَتًى",
 "おにかます": "باراكودا كبيرة (باراكودا رمادية بنية كبيرة (تصل إلى 6 أقدام) تحظى بتقدير كبير كسمكة غذائية ورياضية؛ قد تكون خطرة على السباحين)",
 "おにぎり": "أُونِيجِيرِي",
 "おにころし": "ماء النار (أي مشروبات روحية قوية (مثل الويسكي القوي أو الرم))",
 "おにご": "خائن (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك! / زَقِيطَة",
 "おにごっこ": "زَقِيطَة",
 "おにごろし": "ماء النار (أي مشروبات روحية قوية (مثل الويسكي القوي أو الرم))",
 "おにしょうぐん": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "おにだるまおこぜ": "السمكة الصخرية (سمكة بحرية استوائية سامة تشبه قطعة من الصخر)",
 "おにっこ": "خائن (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "おにのくびをとったよう": "ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر) / ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح)",
 "おにのげし": "شَوْكِيّ الأَوْرَاق (ذو أوراق شوكية)",
 "おにのように": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "おにばば": "شَمْطَاء",
 "おにばばあ": "شَمْطَاء",
 "おにひとで": "نجم البحر المكلل بالشوك (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "おにび": "سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "おにびし": "جوز اليسوعيين, كستناء الماء (نوع من كستناء الماء)",
 "おにふだ": "جُوكَر",
 "おにもつ": "أمتعة, حقائب سفر (حقائب تستخدم لحمل المتعلقات عند السفر) / أمتعة عسكرية (المعدات المحمولة واللوازم لجيش ما) / امرأة سيئة السمعة (امرأة عديمة القيمة أو غير أخلاقية) / حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "おにゃのこ": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おにゃの子": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おにゆり": "زنبق الصنوبر, زنبق النمر (زنبق من جنوب شرق الولايات المتحدة له زهور كأسية الشكل ببتلات منحنية صفراء عميقة إلى قرمزية) / زنبق النمر (نبات معمر شرق آسيوي له زهور برتقالية محمرة كبيرة منقطة بالأسود ببتلات منحنية للخلف)",
 "おにカサゴ": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "おぬ": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おぬし": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おぬぬめ": "تَوْصِيَة",
 "おね": "سلسلة جبال",
 "おねいさん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "おねうち": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "おねえさん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "おねえちゃん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / صبية",
 "おねがい": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "おねがいいたします": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "おねがいごと": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "おねがいします": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "おねがいだから": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "おねがいもうしあげる": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "おねこ": "قط ذكر (ذكر القط)",
 "おねしゃす": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "おねしょ": "تبول في الفراش (سلس البول أثناء النوم؛ شائع بشكل خاص عند الأطفال (الذين عادة ما يتجاوزونه مع النمو))",
 "おねだり": "تَسَوُّل",
 "おねむ": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "おねんね": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "おの": "فَأْس / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おのあしるい": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / صَفَائِحِيُّ الخَيَاشِيم (ثُنَائِيُّ الصَّدَفَة؛ مِنَ الرَّخَوِيَّاتِ ذَاتِ الصَّدَفَتَيْن)",
 "おのおの": "كُلّ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おのが": "ـِي, ـي",
 "おのがじし": "كُلّ",
 "おのこ": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "おのころじま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おのごろじま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おのずから": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "おのずからあきらか": "بَدَهِيّ, بَدِيهِيّ (واضح دون حاجة إلى برهان أو حجّة)",
 "おのずから明らか": "بَدَهِيّ, بَدِيهِيّ (واضح دون حاجة إلى برهان أو حجّة)",
 "おのずと": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "おののき": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "おののく": "هَزَّ",
 "おのぼりさん": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "おのぼれ": "خلاء, غرور (سمة كون المرء مغروراً ومعجباً بنفسه بشكل مفرط؛ كبرياء زائف) / خيال جامح, صورة بلاغية مبتكرة (أداة أو تأثير فني) / تعبير بارع (تعبير ذكي أو مبتكر) / صورة شعرية متكلفة (صورة شعرية معقدة أو مقارنة بعيدة المنال لأشياء متباينة جداً)",
 "おのみ": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "おのれ": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لوحد / لحال",
 "おのれと": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "おのれら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おは": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おはこんばんちは": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "おはこんばんちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "おはこんばんにちは": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "おはこんばんにちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "おはじき": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "おはそん": "تصبيغ, تلوين مجهري ((علم الأنسجة) استخدام صبغة لتلوين العينات للدراسة المجهرية) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "おはな": "إِيكِيبَانَا / زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "おはなし": "قِصَّة, حِكَايَة / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "おはなしちゅう": "مَشْغُول",
 "おはなばたけ": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة. / خَيَال (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / فَنْتَازِيَا\nمثال: يحب الخيال العلمي.",
 "おはやめに": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "おはよ": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おはよう": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おはようございます": "صَبَاح الْخَيْر, صَبَاح النُّور\nمثال: 皆さん、おはようございます。 — صَبَاح الْخَيْر جَمِيْعاً.",
 "おはようさん": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おはよー": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おはよーございます": "صَبَاح الْخَيْر, صَبَاح النُّور\nمثال: 皆さん、おはようございます。 — صَبَاح الْخَيْر جَمِيْعاً.",
 "おはよーさん": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おはらい": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "おはらいばこ": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه) / إِقَالَة",
 "おはり": "أشغال الإبرة, تطريز (العمل الذي يتم بالإبرة (مثل الخياطة أو التطريز)) / أشغال الإبرة, تطريز (إبداع تم إنشاؤه أو تجميعه بالإبرة والخيط) / خَيَّاطَة",
 "おはりこ": "خَيَّاطَة",
 "おば": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "おばあさま": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "おばあさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "おばあちゃま": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "おばあちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "おばあ様": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "おばかさん": "بانجو, عشب (أسماء دارجة للماريجوانا) / أسرار, خفايا (مصطلحات عامية للمعلومات الداخلية) / كولا (مشروب غازي منكه بمستخلص من جوز الكولا) / أحمق, جاهل (شخص جاهل أو أحمق)\nمثال: هل هذه هي الحقيقة المجردة؟",
 "おばけ": "شَبَح, خَيَال / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "おばけやしき": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "おばこ": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "おばさん": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "おばしま": "دَرَابْزُون",
 "おばじゃひと": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "おばち": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "おばちゃま": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "おばちゃん": "خالة, عمة (أخت الأب أو الأم؛ زوجة العم أو الخال)",
 "おばね": "رِيشَةُ الذَّيْل (ريش ينمو من ذيل (عصعص) الطائر)",
 "おばはん": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة. / كَهْل / كَهْلَة",
 "おばん": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق واللاعب الذي يحمل الملكة غير المطابقة في نهاية اللعبة هو الخاسر) / خاسر في لعبة العانس / عانس (امرأة مسنة غير متزوجة) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء) / مَسَاء",
 "おばんです": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "おばーさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "おひいさま": "أَمِيرَة / غِرَاء, لِزَاق / لَصَّقَ",
 "おひきうけ": "مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / تجهيز الموتى, مهنة الحانوتي (مهنة مدير الجنازات)\nمثال: استعد لمشاريع عظيمة",
 "おひさ": "لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "おひさしぶり": "لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "おひさま": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "おひつじ": "كَبْش",
 "おひつじざ": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おひつじ座": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おひとよし": "دماثة, طيبة النفس (استعداد مبتهج ليكون المرء خدومًا) / حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "おひま": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "おひめさま": "أَمِيرَة / غِرَاء, لِزَاق / لَصَّقَ",
 "おひゃくしょうさん": "فَلَّاح, فَلَّاحَة",
 "おひや": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "おひょう": "هَلْبُوت",
 "おひらき": "انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / انفصال, تفكك (التفرق أو الانقسام)",
 "おひる": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء. / ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل! / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "おひるぎ": "أفيسينيا مارينا, قرم أسود (مانغروف في جزر الهند الغربية وساحل فلوريدا الجنوبي؛ يوجد في غابات كثيفة وله جذور قصيرة عديدة تنحني لأعلى من الأرض) / مانغروف أسود (شجرة أسترالية تشبه المانغروف الأسود في جزر الهند الغربية وفلوريدا)",
 "おひれ": "تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما) / تنميق, زخرفة زائدة (زينة فائضة عن الحاجة) / تنميق, زخرفة (توضيح تفسير باستخدام تفاصيل زخرفية (أحياناً خيالية))\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة",
 "おひれをつける": "بَالَغَ",
 "おひろい": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "おひろめ": "إِعْلَان, بَلَاغ",
 "おび": "أوبيا, سحر أوبيا (معتقد ديني من أصل أفريقي يتضمن السحر والشعوذة؛ يمارس في أجزاء من جزر الهند الغربية والأمريكتين الاستوائيتين) / أوبيا ((جزر الهند الغربية) أتباع نظام ديني يتضمن السحر والشعوذة) / فِرْقَة, فرقة / فِرْقَة / حِزَام, طَوْق ((في التشريح) بنية مطوّقة (مثل الحافة حول قاعدة السن))",
 "おびえ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "おびかわ": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "おびきいれる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "おびきよせる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "おびきん": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "おびき入れる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "おびき寄せる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "おびく": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "おびじょう": "حِزَامِيّ الشَّكْل (على شكل حزام)",
 "おびじょうほうしん": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "おびただしい": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "おびのこ": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "おびのこぎり": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "おびのこばん": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "おびやかす": "أَخَافَ, أَرْعَبَ / هَدَّدَ / أَنْذَرَ",
 "おびる": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "おびれ": "زعنفة ذيلية (ذيل الأسماك وبعض الفقاريات المائية الأخرى)",
 "おびグラフ": "رسم بياني بالأعمدة, مخطط شريطي (مخطط بأشرطة تتناسب أطوالها مع الكميات)",
 "おふ": "غلوتين القمح (غلوتين محضر من القمح)",
 "おふくろ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "おふざけ": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "おふせ": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "おふろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "おぶ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "おぶいひも": "مِقْلَاع / حَمَّالَة",
 "おぶい紐": "مِقْلَاع / حَمَّالَة",
 "おぶう": "أبوش, حمل على الظهر (عملية حمل شخص أو شيء على الظهر) / أوباً, على الظهر (على الظهر أو الكتفين أو الركوب على الورك) / محمولاً (على عربة مسطحة للسكك الحديدية (شحن الحاويات))\nمثال: حملت طفلها على ظهرها / مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "おぶつ": "قَذَارَة",
 "おぶね": "قارب صغير (قارب صغير الحجم)",
 "おへそ": "سُرَّة",
 "おへや": "فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / شَقَّة (نِصْف الشيء إذا شُقَّ؛ القطعة المَشْقُوقَة بشكل مستطيل من الثَوْب أو العَصَا)\nمثال: فتش ياني الشقة.",
 "おへんじ": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "おべっか": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "おべっかつかい": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "おべっか使い": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "おべべ": "مَلَابِس, ثِيَاب",
 "おべんちゃら": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "おべんとう": "بِنْتُو",
 "おほしさま": "إِجَّامَة / نَجْمَة",
 "おほね": "رَمَاد, سَكَن / دَرْدَار",
 "おほん": "نحنحة (إصدار صوت مشابه لتنظيف الحلق؛ يهدف لجذب الانتباه، أو التعبير عن التردد، أو ملء وقفة، أو إخفاء الإحراج، أو تحذير صديق، إلخ)",
 "おぼうさん": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "おぼえ": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "おぼえがき": "مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب) / مُذَكِرَة",
 "おぼえこむ": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "おぼえず": "لَاشُعُورِيًّا",
 "おぼえる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها. / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم. / تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "おぼこい": "طُفُولِيّ",
 "おぼこむすめ": "بتول, بِكْر (المنقطعه عن الرجال)",
 "おぼこ娘": "بتول, بِكْر (المنقطعه عن الرجال)",
 "おぼしい": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おぼしき": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おぼしめし": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب) / هوى, ولع (استعداد للإعجاب بشيء ما) / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: كان لديه ولع بالويسكي",
 "おぼしめす": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "おぼす": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "おぼっちゃま": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "おぼっちゃん": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "おぼつかない": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "おぼらす": "غَرِقَ / أَغْرَقَ",
 "おぼれこむ": "غَرِقَ / أَغْرَقَ",
 "おぼれしぬ": "غَرِقَ / أَغْرَقَ",
 "おぼれじぬ": "غَرِقَ / أَغْرَقَ",
 "おぼれるものはわらをもつかむ": "الغريق يتعلق بقشة",
 "おぼろ": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "おぼろぐも": "طبقي متوسط (سحابة طبقية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "おぼろげ": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "おぼろ雲": "طبقي متوسط (سحابة طبقية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "おぼん": "بُون / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: هذه شركة صينية.",
 "おま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまい": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまいつ": "مُعْجَبَة (معجبة شابة متحمسة (خاصة التي تتبع فرق الروك))",
 "おまいり": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "おまえ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "おまえがた": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまえさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまえさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "おまえたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまえら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまけ": "هدية مجانية (شيء مجاني (يتم تقديمه عادةً كجزء من مخطط ترويجي))\nمثال: كانت خارطة الطريق هدية مجانية / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "おまけに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "おまごさん": "حَفِيد, حَفِيدَة",
 "おましどころ": "بَقَاء / إِقَامَة / دَار (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "おまじない": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "おませ": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر) / مبكر النضوج, نابغ (يتميز بالتطور أو النضج المبكر بشكل استثنائي (خاصة في القدرات العقلية))\nمثال: طفل نابغ",
 "おまた": "فَرْج, حِرّ",
 "おまつ": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا) / صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…) / صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني) / صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "おまつり": "عِيد, مَهْرَجَان",
 "おまつりさわぎ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "おまもり": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "おまる": "قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول)",
 "おまわり": "شُرْطِيّ, شُرَطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي. / طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "おまわりさん": "شُرْطِيّ, شُرَطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "おまん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おまんこ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس.",
 "おまんま": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "おみ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "おみあいデート": "لقاء مع غريب, موعد مدبر (موعد غرامي مع شخص غريب) / رفيق موعد أعمى (مشارك في موعد أعمى (شخص تقابله لأول مرة في موعد))\nمثال: هي لا تذهب أبداً في مواعيد مدبرة",
 "おみあげ": "إساءة, خدمة سيئة (فعل يُقصد به المساعدة ولكن نتائجه تكون سيئة)\nمثال: لقد أساء إليهم",
 "おみあし": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "おみえ": "وُصُول, وِفَادَة",
 "おみえになる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "おみおくり": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "おみき": "غاية, غَرَض",
 "おみこし": "مُسْتَدَقّ الظَّهْر",
 "おみごと": "بْرَافُو, بِرَافُو",
 "おみず": "مِيَاه / سَقَى / أَسْقَى, سَقَى / مُضِيفَة / سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق) / فَاحِش, مُوحٍ بِالبَذَاءَة (يُلمّح إلى سلوك جنسيّ غير لائق) / حَيَوِيّ, نَابِض (مليء بالحيويّة والنَّشاط والقوّة) / غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "おみせ": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "おみせする": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "おみそれ": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "おみつもり": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "おみな": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "おみまい": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / تعامل, صفقة (فعل التعامل داخل أو بين المجموعات (كالقيام بأنشطة تجارية)) / تعامل (طريقة أو أسلوب السلوك فيما يتعلق بالآخرين)\nمثال: لا يمكن إجراء أي معاملات بدونه",
 "おみや": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "おみやげ": "إساءة, خدمة سيئة (فعل يُقصد به المساعدة ولكن نتائجه تكون سيئة)\nمثال: لقد أساء إليهم",
 "おみ足": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "おむかえ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "おむこさん": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد) / زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "おむすび": "أُونِيجِيرِي",
 "おむつ": "حِفَاضة, حِفَاظ",
 "おむつかぶれ": "التهاب جلد الحفاض, طفح الحفاض (التهاب جلد الفخذين والأرداف عند الرضع؛ يُفترض أنه ناتج عن الأمونيا في البول في حفاضات الطفل)",
 "おめ": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / مَشْهَد / مَنْظَر",
 "おめあり": "شُكْرًا",
 "おめい": "عَار, خِزْي",
 "おめえ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おめおめ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "おめがね": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "おめく": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "おめこ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس.",
 "おめこぼし": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما) / تآمر, تواطؤ (الاتفاق على مؤامرة سرية)",
 "おめし": "استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى)",
 "おめしもの": "مَلَابِس, ثِيَاب",
 "おめしゃす": "مُبَارَك, مَبْرُوك",
 "おめずおくせず": "بشجاعة, بلا خوف\nمثال: قاد القوات إلى القتال بلا خوف",
 "おめず臆せず": "بشجاعة, بلا خوف\nمثال: قاد القوات إلى القتال بلا خوف",
 "おめだま": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "おめつけ": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم) / كلب حراسة (كلب مدرب لحراسة الممتلكات) / جِهَة رَقابِيَّة, حارِس (وصي أو مدافع ضد السرقة أو الممارسات غير القانونية أو الهدر)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "おめつけやく": "كلب حراسة (كلب مدرب لحراسة الممتلكات) / جِهَة رَقابِيَّة, حارِس (وصي أو مدافع ضد السرقة أو الممارسات غير القانونية أو الهدر)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "おめでた": "حدث سعيد (الولادة الحية لطفل)",
 "おめでたい": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا. / سَاذَج",
 "おめでたくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "おめでとうございます": "مُبَارَك, مَبْرُوك",
 "おめでとう御座います": "مُبَارَك, مَبْرُوك",
 "おめどおり": "جُمْهُور, نَظَّارَة",
 "おめにかかる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "おめにかける": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "おめみえ": "جُمْهُور, نَظَّارَة / إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / وضع تحت المراقبة ((قانون) طريقة للتعامل مع الجناة دون سجنهم؛ حيث يطلق سراح المتهم المدان بشروط تفرضها المحكمة) / إطلاق سراح مشروط, فترة مراقبة (فترة تجريبية تُمنح للمذنب كوقت لإصلاح نفسه بدلاً من السجن) / فترة اختبار, فترة تجربة (فترة تجريبية يتم فيها اختبار شخصيتك وقدراتك لمعرفة ما إذا كنت مناسباً للعمل أو للعضوية)\nمثال: الوضع تحت المراقبة جزء من عملية إصدار الحكم",
 "おめめ": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "おめん": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "おめー": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おも": "شَيْخ, قَائِد / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "おもい": "ثَقِيل / بَطِيء / أَبْطَأَ, بَطَّأَ / مُهِمّ / جِدِّيّ / جَدِّيّ, جَادّ / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "おもいあがり": "خلاء, غرور (سمة كون المرء مغروراً ومعجباً بنفسه بشكل مفرط؛ كبرياء زائف) / خيال جامح, صورة بلاغية مبتكرة (أداة أو تأثير فني) / تعبير بارع (تعبير ذكي أو مبتكر) / صورة شعرية متكلفة (صورة شعرية معقدة أو مقارنة بعيدة المنال لأشياء متباينة جداً)",
 "おもいあたる": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "おもいあわせる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "おもいいる": "تَفَكَّرَ, فَكَّرَ",
 "おもいいれ": "مَوْقِف, سُلُوك",
 "おもいうかべる": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي. / تَخَيَّلَ, تَصَوَّرَ",
 "おもいえがく": "تَخَيَّلَ, تَصَوَّرَ",
 "おもいおこす": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "おもいかえす": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "おもいがけず": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "おもいがけない": "مُفَاجِئ",
 "おもいきった": "بشجاعة (بطريقة شجاعة)\nمثال: دخل المنزل المحترق بشجاعة",
 "おもいきって": "بِإِصْرَار, بِعَزْم (إظهار تصميم أو هدف حازم) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: رفضت بحزم النظر إليه أو التحدث معه",
 "おもいきり": "عَزْم, عُزْم / دِقَّة",
 "おもいきる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "おもいこがれる": "اِشْتَاقَ",
 "おもいこみ": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "おもいこむ": "اِفْتَرَضَ / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "おもいごと": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "おもいさだめる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "おもいしる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "おもいたつ": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "おもいだす": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "おもいちがい": "سُوء فَهْم",
 "おもいっきし": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "おもいっきり": "عَزْم, عُزْم / دِقَّة",
 "おもいつき": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "おもいつく": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "おもいで": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "おもいでのしな": "تذكار, هدية تذكارية (شيء ذو قيمة عاطفية)",
 "おもいでばなし": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "おもいとどまる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "おもいなおす": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "おもいなす": "اِفْتَرَضَ",
 "おもいのこす": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "おもいのほか": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "おもいびと": "حَبِيب, عَزِيز (شخص تحبه، عادة ما يكون فرداً من عائلتك)",
 "おもいまわす": "تَفَكَّرَ, فَكَّرَ",
 "おもいめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "おもいもうける": "تَوَقَّعَ, اِرْتَقَبَ",
 "おもいもかけない": "مُفَاجِئ",
 "おもいもの": "حَبِيب, حَبِيبَة",
 "おもいもよらない": "مُفَاجِئ",
 "おもいやり": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "おもいよる": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "おもいをめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "おもいをめぐらせる": "تَفَكَّرَ, فَكَّرَ",
 "おもいをよせる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "おもう": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة. / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / تَخَيَّلَ, تَصَوَّرَ / تَوَقَّعَ",
 "おもうさま": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "おもうぞんぶん": "بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "おもうに": "الْمُفْتَرَض مِنْ",
 "おもえらく": "الْمُفْتَرَض مِنْ",
 "おもえる": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもおもしい": "جِدِّيّ / جَدِّيّ, جَادّ",
 "おもかげ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / أثر, بقية (دلالة على أن شيئاً ما كان موجوداً)\nمثال: لم يكن هناك أي أثر لدليل على الادعاء",
 "おもかじ": "يَمِينِيُّ السَّفِينَة (واقع على الجانب الأيمن من السفينة أو الطائرة) / الجانب الأيمن, الميمنة (الجانب الأيمن لسفينة أو طائرة لشخص على متنها ويواجه المقدمة أو الأنف)",
 "おもがい": "عِذَار",
 "おもき": "أَهَمِّيَّة",
 "おもきをおく": "شَدَّدَ (الشيءَ: قَوَّاه وجعله شديدًا؛ في الأمر: بالغ فيه)",
 "おもくるしい": "ثَقِيل",
 "おもくろい": "مُشَوِّق, ممتع / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "おもさ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "おもざし": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "おもし": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "おもしい": "مُشَوِّق, ممتع",
 "おもしれえ": "مُضْحِك, هَزْلِيّ",
 "おもしれー": "مُضْحِك, هَزْلِيّ",
 "おもしろ": "مُمْتِع",
 "おもしろい": "مُشَوِّق, ممتع / مُمْتِع / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "おもしろいように": "بِسُهُولَة",
 "おもしろおかしい": "طريف, فکاهي (مليء بـأو يتميز بالفكاهة)\nمثال: قصص فكاهية / مُمْتِع",
 "おもしろがる": "اِسْتَمْتَعَ, تَمَتَّعَ / حَظِيَ (نَعِمَ بِشَيْءٍ أَو نَالَ حَظًّا مِنْهُ؛ نَالَ مَكَانَةً وَمَنْزِلَةً عِنْدَ شَخْصٍ)\nمثال: من حسن حظي أن صرت صديقه.",
 "おもしろさ": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة) / طَرَافَة, فُكَاهَة (صفة كون الشيء مضحكا) / سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / خلط ((في العصور الوسطى) أحد السوائل الأربعة في الجسم التي كان يعتقد أن توازنها يحدد الحالة العاطفية والجسدية)\nمثال: لم تقدر فكاهتي / مَرَح, تَرْفِيه / مَرِح, مُسَلٍّ",
 "おもしろはんぶん": "على سبيل المزاح, للمرح (غير مقصود بجدية؛ يعني مزحة)\nمثال: كان كل ذلك للمرح",
 "おもしろみ": "فَائِدَة",
 "おもしろネタ": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "おもしをする": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "おもすれえ": "مُضْحِك, هَزْلِيّ",
 "おもすれー": "مُضْحِك, هَزْلِيّ",
 "おもたい": "ثَقِيل",
 "おもたげ": "ثَقِيل",
 "おもだち": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "おもだった": "شَيْخ, قَائِد",
 "おもち": "موتْشِي",
 "おもちかえり": "لِقَاء جِنْسِيّ لِلَيْلَة وَاحِدَة (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا)\nمثال: اريد لقاء والدك / سَفَريّ",
 "おもちゃかぼちゃ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "おもちゃばこ": "صندوق ألعاب (صندوق لتخزين الألعاب)",
 "おもちゃカボチャ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "おもちゃ南瓜": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "おもちゃ箱": "صندوق ألعاب (صندوق لتخزين الألعاب)",
 "おもったい": "ثَقِيل",
 "おもってもいない": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "おもってもみない": "مُفَاجِئ",
 "おもづな": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "おもて": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / جَبْهَة / أَمَامِيّ / خَارِج, بره / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "おもてかんばん": "جَبْهَة / أَمَامِيّ",
 "おもてがき": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "おもてがまえ": "وَاجِهَة",
 "おもてがわ": "جَبْهَة / أَمَامِيّ",
 "おもてぐち": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "おもてげんかん": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "おもてざしき": "صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء)",
 "おもてだった": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "おもてだって": "عَلَانِيَةً, عَلَنًا",
 "おもてつき": "واجهة المبنى (وجه أو مقدمة مبنى) / واجهة (امتداد الأرض المحاذية لشارع أو ماء) / وَاجِهَة (الاتجاه الذي يواجهه شيء ما (مثل مبنى))",
 "おもてど": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "おもてどおり": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "おもてなし": "كَرَم, إِكْرَام / ضِيَافَة / استجمام, ترويح عن النفس (نشاط يجدد النشاط ويرفه؛ نشاط يجدد صحتك وروحك بالمتعة والاسترخاء) / ضيافة, مرطبات (وجبات خفيفة ومشروبات تقدم كوجبة خفيفة)\nمثال: وقت للراحة والاستجمام بجانب المسبح",
 "おもてぶたい": "وسط المسرح (المنطقة المركزية على خشبة المسرح) / بؤرة الاهتمام, صدارة (موقع البروز أو الأهمية)",
 "おもてむき": "ظَاهِرِيّ, مَزْعُوم (يبدو كذلك في الظاهر؛ مُدَّعى أو مُتظاهَر به) / بَادٍ, ظَاهِرِيّ (يبدو كذلك لكن ليس بالضرورة حقيقيًّا)",
 "おもてめ": "غرزة عدلة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيسر)",
 "おもてめん": "الوجه (للعملة) (جانب العملة أو الميدالية الذي يحمل الختم أو التصميم الرئيسي) / نظير, وجه مقابل (الجانب الأكثر وضوحاً من بديلين أو حالتين أو جانبين)\nمثال: الوجه المقابل لهذه القضية",
 "おもて面": "الوجه (للعملة) (جانب العملة أو الميدالية الذي يحمل الختم أو التصميم الرئيسي) / نظير, وجه مقابل (الجانب الأكثر وضوحاً من بديلين أو حالتين أو جانبين)\nمثال: الوجه المقابل لهذه القضية",
 "おもとじ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "おもとめやすい": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "おもな": "شَيْخ, قَائِد",
 "おもなが": "طَوِيل الوَجْه (ذو وجه أطول من المعتاد)",
 "おもなる": "رَئِيسِيّ",
 "おもに": "غَالِبًا / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / ثقل, حمل (اهتمام شاق أو صعب) / رهن, عبء (حق للغير على الممتلكات (مثل حق الحجز أو الرهن العقاري))\nمثال: عبء المسؤولية",
 "おもねる": "تَمَلَّقَ, تَبَصْبَصَ",
 "おもはゆい": "مُحْرَج, بِٱلْحَرَج",
 "おもひで": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "おもみ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / أَهَمِّيَّة",
 "おもみづけ": "ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية)",
 "おもむき": "مَعْنًى / الْمَعْنَى / تَأْثِير, أَثَر / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / غريس",
 "おもむきのある": "أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "おもむきぶかい": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "おもむく": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / اِلْتَزَمَ",
 "おもむろに": "فَجْأَةً / بِبُطْء",
 "おももち": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "おもり": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / كرة هابطة (رمية تنحني للأسفل بسرعة عند اقترابها من اللوحة) / ثقالة (وزن يغرق (لتثبيت الشباك أو خيوط الصيد تحت الماء)) / دونات, كعكة مقلية (كعكة مقلية صغيرة على شكل حلقة) / مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل) / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "おもろい": "مُشَوِّق, ممتع / مُمْتِع",
 "おもわ": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "おもわく": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف. / تَكَهُّنٌ / مُضَارَبَة",
 "おもわくし": "مُضَارِب",
 "おもわくちがい": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "おもわしい": "لَائِق, مَقْبُول (يفي بالمتطلبات والمعايير المطلوبة) / مقبول, مُرضٍ (يبعث على الرضا)\nمثال: ظروف معيشية مرضية / بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもわしくない": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "おもわず": "لَاشُعُورِيًّا",
 "おもわせぶり": "هَامّ (أصابه الهيام)\nمثال: الحضور هام جدا.",
 "おもわせる": "أَعَادَ إِلَى الذَّاكِرَة, اسْتَحْضَرَ (استدعى إلى الذهن)\nمثال: هذه الصور تعيد ذكريات حزينة",
 "おもわぬ": "مُفَاجِئ",
 "おもわれる": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもんじる": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "おもんずる": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "おもんない": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "おもんね": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんねえ": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんねー": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんばかり": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おもんぱかり": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おや": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟ / تَاجِر, تَاجِرَة / مُؤَسِّس, مُؤَسِّسَة / مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "おやかぎ": "ماستر كي, مفتاح رئيسي (مفتاح يؤمن الدخول في كل مكان)",
 "おやかた": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى. / والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "おやかたさま": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "おやがた": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "おやがわり": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "おやき": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "おやぎ": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "おやぎょう": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "おやくごめん": "إِقَالَة / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "おやくしょことば": "لغة بيروقراطية, لغة رسمية (أسلوب الكتابة المميز لبعض المسؤولين الحكوميين: رسمي وغامض)",
 "おやくしょしごと": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "おやくそく": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "おやくめ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "おやこうこう": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "おやこでんわ": "تحويلة, هاتف فرعي (جهاز هاتف إضافي متصل بنفس خط الهاتف)",
 "おやご": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "おやごさん": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "おやごろし": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "おやしらず": "ضِرْس اَلْعَقْل",
 "おやじギャグ": "بَالٍ",
 "おやすい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "おやすいごよう": "عَفْوًا",
 "おやすみ": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة\nمثال: お休み、いい夢たくさん見てね。 — ليلة سعيدة و أحلام أسعد.",
 "おやすみなさい": "تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة",
 "おやだいだい": "مِيرَاث, إرْثْ",
 "おやだま": "رَئِيس, رَئِيسَة",
 "おやっさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة. / شَيْخ, عَجُوز",
 "おやつ": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "おやなかせ": "عَار, خِزْي",
 "おやなし": "بلا والدين, يتيم (ليس لديه والد أو والدين أو لا يرعاه بدائل الوالدين) / يَتِيم / يَتِيمَة",
 "おやなしご": "يَتِيم / يَتِيمَة",
 "おやににぬこはおにご": "الْوَلَدُ سُرّ أَبِيهِ",
 "おやのかたき": "عدو لدود (عدو يريد قتلك)",
 "おやびん": "رَئِيس, رَئِيسَة",
 "おやぶん": "رَئِيس, رَئِيسَة",
 "おやま": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "おやみ": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "おやみたけりゃこをみろ": "الْوَلَدُ سُرّ أَبِيهِ",
 "おやむし": "حشرة كاملة, يافعة (حشرة بالغة ناتجة بعد التحول) / إيماجو, صورة الوالد ((في التحليل النفسي) صورة مثالية لشخص (عادة أحد الوالدين) تشكلت في الطفولة)",
 "おやもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / مَصْفُوفَة",
 "おやゆび": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات) / إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "おやゆびのつめ": "ظفر الإبهام (ظفر إصبع الإبهام)",
 "おやゆびひめ": "ثُومْبِلِينَا",
 "おやクラス": "فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "おやチャ": "تَاجِر, تَاجِرَة",
 "おやプログラム": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "おゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "おゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "およぎ": "سِبَاحَة",
 "およぎて": "سَبَّاح, عَوَّام",
 "およぐ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "およし": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "およそ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / عُمُومًا / بِوَجْهٍ عَامّ / تَمَامًا / لَخَّصَ, اِخْتَصَرَ",
 "およばない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "および": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "およびごし": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "およびじゃない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "およびでない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "およぶ": "بَلَغَ / مُنْتَجَع / اِقْتَضَى, تَطَلَّبَ",
 "およぼす": "تَمْرِين, تَدْرِيب / تَمَرَّنَ",
 "およめさん": "زَوْجَة, اِمْرَأَة",
 "およる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "およろこび": "حدث سعيد (الولادة الحية لطفل)",
 "おら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おらあ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おらおら": "اِنْتِهَازِيّ, مُلِحّ (يتسم بطموح عدواني ونشاط ومبادرة)",
 "おらんだがらし": "قُرَّة, حُرْف",
 "おり": "فُرْصَة / طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة / قَفَص / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نَسَجَ / تُفْل / حُثالَة / مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "おりあい": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "おりあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "おりあげ": "جون, خليج صغير (مدخل مائي صغير) / تجويف صخري, كهف صغير (كهف صغير أو ضيق في جانب جرف أو جبل)",
 "おりあしく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "おりいって": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "おりいと": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "おりえり": "طَيَّة",
 "おりおり": "أَحْيَانًا",
 "おりかえし": "طَيَّة / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / كَوْرَس, كُورَس / لَازِمَة, قَرَار / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "おりかえしちてん": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "おりかえしてん": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "おりかえす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "おりかばん": "حَقِيبَة, مِحْفَظَة",
 "おりから": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "おりがみ": "أُورِيغَامِي, طَيّ اَلْوَرَق / بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما) / دمغة, علامة جودة (علامة على سلعة تجارية للإشارة إلى منشئها وأصالتها)",
 "おりがみつき": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "おりがみをつける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "おりき": "مِنْسَج / بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "おりく": "قصيدة استهلالية, قصيدة الحروف الأوائل (شعر تشكل فيه أحرف معينة، مثل الحرف الأول في كل سطر، كلمة أو رسالة) / مُرَبَّع الْكَلِمَات (لغز حيث تملأ شبكة مربعة بكلمات تقرأ نفس الشيء رأسياً وأفقياً)",
 "おりくち": "قِمَّة",
 "おりぐち": "قِمَّة",
 "おりけい": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "おりこ": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "おりこう": "نَسَّاج, نَسَّاجَة / تَنَوُّط / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "おりこうさん": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "おりこみ": "أَدْخَلَ / إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "おりこみずみ": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "おりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / أَدْخَلَ / يحساب حساب",
 "おりしき": "جثو, ركوع (دعم نفسك على ركبتيك)",
 "おりしく": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "おりしも": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "おりじ": "مَلْمَس / قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "おりそう": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "おりたたみ": "طي (عملية الطي) / طي (عملية جيولوجية تسبب انحناء في طبقة صخرية) / طي البروتين (العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد)\nمثال: قام بطي المناديل طية مزدوجة",
 "おりたたみいんさつぶつ": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "おりたたみき": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "おりたたみしき": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "おりたたみナイフ": "مِطْواة",
 "おりたたみ印刷物": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "おりたたむ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "おりちょう": "رَزْمَة صَغِيرَة, مَلْزَمَة وَرَق (كمية من الورق؛ 24 أو 25 ورقة)",
 "おりづるらん": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة؛ تزرع لأزهارها طويلة الأمد التي تشبه العنكبوت بيضاء إلى وردية أرجوانية)",
 "おりど": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "おりどころ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "おりにふれて": "بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "おりば": "انخفاض, تراجع (تغير نحو الأسفل) / جرف, منحدر صخري (واجهة صخرية شديدة الانحدار والمرتفع) / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "おりひめ": "اَلنَّسْر اَلْوَاقِع",
 "おりふし": "أَحْيَانًا",
 "おりまげる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "おりめ": "مَلْمَس / طَوَى / طَيَّة / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "おりめただしい": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً) / حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "おりもあろうに": "أبداً, على الإطلاق (في أي وقت)\nمثال: هل دخنت من قبل؟",
 "おりもの": "إفراز مهبلي (إفرازات من غدد عنق الرحم للمهبل؛ عادة ما تكون صافية أو بيضاء) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…) / خَلَاص / نسيجي (من أو متعلق بالأقمشة أو صناعة النسيج) / قماش, مادة (مادة مصنوعة عن طريق نسج أو تلبيد أو حياكة أو حبك ألياف طبيعية أو صناعية)\nمثال: بحث نسيجي",
 "おりものしょう": "بَزَّاز",
 "おりもののみみ": "برسل, حاشية القماش (حافة القماش المنسوجة بحيث لا تنسل أو تتآكل) / حاشية السجاد (حد يتكون من هدب زخرفي في أحد طرفي السجادة الشرقية)",
 "おりゃる": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おりよく": "لِحُسْن اَلْحَظّ",
 "おりる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / تَقَاعَدَ / اِعْتَزَلَ / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "おりわるく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "おる": "نَسَجَ / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / طَوَى / طَيَّة / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / قَاطَعَ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "おるすになる": "أَهْمَلَ / إِهْمَال",
 "おれ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / طَوَى / طَيَّة",
 "おれあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "おれい": "شُكْرًا / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "おれいにはおよびません": "عَفْوًا",
 "おれおんな": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おれかえる": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "おれがおれが": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / مَغْرُور, مُعْجَب بِنَفْسِه (يتسم بتضخيم أهمية ذاته؛ ذو نرجسية مفرطة)",
 "おれきれき": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "おれくち": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "おれさま": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "おれし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれせん": "بشكل متعرج (في مسار متعرج أو على طريق متعرج) / زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية) / زجزاج, متعرج (شكل زاوي يتميز بمنعطفات حادة في اتجاهات متبادلة)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "おれたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "おれっち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれまがる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "おれめ": "طَوَى / طَيَّة",
 "おれら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "おれ合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "おれ女": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おろ": "سائل النفاس, هُلاب (مادة تفرز من المهبل (حطام خلوي ومخاط ودم) وتتناقص تدريجياً في الكمية خلال الأسابيع التالية للولادة) / بشكل غير كامل, ناقصاً (ليس لدرجة كاملة أو تامة)\nمثال: كلمات مفهومة بشكل غير كامل",
 "おろおろ": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "おろか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "おろかしい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おろかにも": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "おろかもの": "مُغَفَّل, أَحْمَق",
 "おろか者": "مُغَفَّل, أَحْمَق",
 "おろし": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / مِبْشَرَة / إِجْمَالِيّ, بِالْجُمْلَةِ",
 "おろしうり": "إِجْمَالِيّ, بِالْجُمْلَةِ",
 "おろしうりがいしゃ": "تَاجِر جُمْلَة",
 "おろしうりぎょうしゃ": "تَاجِر جُمْلَة",
 "おろしうりしじょう": "سوق الجملة (السوق لبيع السلع لتاجر التجزئة)",
 "おろしうりぶっかしすう": "مؤشر أسعار الجملة, مؤشر أسعار المنتجين (مؤشر للتغيرات في أسعار الجملة)",
 "おろしがいしゃ": "تَاجِر جُمْلَة",
 "おろしがね": "مِبْشَرَة",
 "おろしき": "مِبْشَرَة",
 "おろしぎょうしゃ": "قَاسِم",
 "おろしぐすり": "سَقْط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله)\nمثال: أصيب عندما سقط.",
 "おろししょう": "تَاجِر جُمْلَة",
 "おろしたて": "جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر)",
 "おろしどんや": "تَاجِر جُمْلَة",
 "おろし器": "مِبْشَرَة",
 "おろし金": "مِبْشَرَة",
 "おろす": "بَشَر (بَشَرَ؛ بُشِرَ)\nمثال: لكنهم كلهم بشر. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / يُجْهِض",
 "おろそか": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "おろそかにする": "أَهْمَلَ / إِهْمَال",
 "おわい": "سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد) / روث, زبل (فضلات الحيوانات) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "おわかれ": "فِرَاقٌ",
 "おわかれかい": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "おわしどころ": "بَقَاء / إِقَامَة / دَار (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "おわしましどころ": "بَقَاء / إِقَامَة / دَار (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "おわす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "おわび": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "おわらい": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه)",
 "おわらいげいにん": "كُومِيدْيَان",
 "おわらいタレント": "كُومِيدْيَان",
 "おわり": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "おわりかけ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "おわりね": "سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "おわりまで": "النِهاية",
 "おわりんこ": "خَرِب, مُنْتَهٍ (أُوصِلَ إِلَى الخَرَاب) / مكتمل, منتهٍ (انتهى أو تم الانتهاء منه) / تام الصنع, جاهز ((عن المواد أو البضائع) تم إيصالها للحالة النهائية المطلوبة) / مَطْلِيّ, مُكَسًّى بِطِلَاء (مُغَطًّى بِطِلَاءٍ أَوْ تَشْطِيبٍ سَطْحِيّ)\nمثال: هل انتهيت؟",
 "おわる": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مَصَّة / مَصَّ, رَشَفَ (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "おわれるみ": "هَارِب, هَارِبَة",
 "おわん": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "おん": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه / إِحْسَان / ذَكَرِيّ / ذَكَر, ذكر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "おんあい": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "おんあたり": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おんあつ": "ضغط الصوت (الفرق بين الضغط اللحظي عند نقطة في مجال صوتي والضغط المتوسط عند تلك النقطة)",
 "おんあつレベル": "قدرة صوتية, مستوى ضغط الصوت (الشدة الفيزيائية للصوت)",
 "おんいき": "مدى, قدرة / مَدَى",
 "おんいりそうろう": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "おんいん": "فُونِيم, صَوْت لُغَوِيّ / نَغْمَة, نَغْم",
 "おんいんがく": "صَوْتِيَات",
 "おんいんがくしゃ": "عالم فونولوجيا, عالم وظائف الأصوات (متخصص في علم الأصوات (الفونولوجيا))",
 "おんいんそしき": "نظام صوت, نظام صوتي (نظام من المعدات الإلكترونية لتسجيل أو إعادة إنتاج الصوت)",
 "おんいんたいけい": "نظام صوتي, نظام فونولوجي (نظام الأصوات المستخدم في لغة معينة)",
 "おんいんろん": "فُونُولُوجِيَّا, عِلْمُ ٱلْأَصْوَاتِ ٱللُّغَوِيَّةِ",
 "おんうた": "قَصِيدَة, شِعْر",
 "おんおん": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "おんか": "قيمة النغمة, قيمة زمنية ((موسيقى) المدة النسبية لنغمة موسيقية)",
 "おんかい": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "おんかん": "دفاء",
 "おんが": "رَشِيق, ظَرِيف / فيلم صوتي, فيلم ناطق (فيلم سينمائي تم تسجيل المؤثرات الصوتية والحوار عليه)",
 "おんがえし": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "おんがくいん": "حديقة داخلية, مشتل زجاجي (دفيئة يتم فيها ترتيب النباتات بطريقة مبهجة) / كونسرفتوار, معهد موسيقي (مدرسة ذات مرافق خاصة للفنون الجميلة) / كونسرفتوار, معهد موسيقي (هيئة التدريس والطلاب في مدرسة متخصصة في أحد الفنون الجميلة)",
 "おんがくえいが": "مُوسِيقِيّ (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية) / مَسْرَح مُوسِيقِيّ\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "おんがくか": "مُوسِيقِيّ, مُوسِيقِيَّة (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "おんがくかい": "حَفْلَة / عَزْف, حَفْلَة مُوسِيقِيَّة (والمعزف :الملاهي واحدها معزف ومعزفة)\nمثال: عزف على البيانو.",
 "おんがくかんとく": "قائد فرقة, مايسترو (الشخص الذي يقود مجموعة موسيقية)",
 "おんがくがく": "علم الموسيقى (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "おんがくがっこう": "مدرسة موسيقى (مدرسة متخصصة في الموسيقى) / مدرسة موسيقى (مدرسة لدراسة الموسيقى)",
 "おんがくきょうしつ": "مدرسة موسيقى (مدرسة متخصصة في الموسيقى) / مدرسة موسيقى (مدرسة لدراسة الموسيقى)",
 "おんがくしきしゃ": "قائد الجوقة ((في اليونان القديمة) قائد مجموعة أو مهرجان؛ قائد الجوقة)",
 "おんがくせい": "براعة موسيقية (البراعة الفنية في أداء الموسيقى)",
 "おんがくたい": "فِرْقَة, فرقة / فِرْقَة",
 "おんがくだい": "مدرسة موسيقى (مدرسة لدراسة الموسيقى)",
 "おんがくだいがく": "مدرسة موسيقى (مدرسة لدراسة الموسيقى)",
 "おんがくてき": "مُوسِيقِيّ (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية) / مَسْرَح مُوسِيقِيّ\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "おんがくどう": "قاعة حفلات موسيقية (قاعة تُقام فيها الحفلات الموسيقية)",
 "おんがくひょうろんか": "ناقد موسيقي (ناقد للعروض الموسيقية)",
 "おんがっか": "مُوسِيقِيّ, مُوسِيقِيَّة (متعلق أو له صلة بالموسيقى؛ الشخض الذي يعزف أو يؤلف الموسيقى، كمهنة أو هواية)\nمثال: سيبدأ الفيلم الموسيقي قريبا.",
 "おんがっかい": "حَفْلَة / عَزْف, حَفْلَة مُوسِيقِيَّة (والمعزف :الملاهي واحدها معزف ومعزفة)\nمثال: عزف على البيانو.",
 "おんきせがましい": "فَوْقِيّ, مُتَعَالٍ ((يُستخدم للسلوك أو الموقف) يتسم بالاستعلاء والتعالي على الآخرين)",
 "おんきゅう": "مَعَاش / بَنْسِيُون",
 "おんきょう": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "おんきょうがく": "علم الصوتيات (دراسة الخصائص الفيزيائية للصوت)",
 "おんきょうき": "جهاز سبر, مسبار صوتي (جهاز لعمل عمليات السبر)",
 "おんきょうきき": "نظام صوت, نظام صوتي (نظام من المعدات الإلكترونية لتسجيل أو إعادة إنتاج الصوت)",
 "おんきょうこうか": "مُؤَثِّر صَوْتِيّ / علم الصوتيات (دراسة الخصائص الفيزيائية للصوت)",
 "おんきょうそくしん": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "おんきょうそくしんき": "سونار, مسبار الصدى (أداة قياس ترسل نبضة صوتية في الماء وتقيس المسافات من حيث الوقت الذي يستغرقه صدى النبضة للعودة)",
 "おんきょうそくしんぎ": "سونار, مسبار الصدى (أداة قياس ترسل نبضة صوتية في الماء وتقيس المسافات من حيث الوقت الذي يستغرقه صدى النبضة للعودة)",
 "おんきょうちょうせいたく": "خَلَّاط, خَفَّاقَة",
 "おんきょうていい": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "おんきょうインピーダンス": "مقاومة صوتية, ممانعة صوتية (ممانعة لتدفق الصوت عبر سطح؛ المقاومة الصوتية هي المكون الحقيقي للممانعة الصوتية والمفاعلة الصوتية هي المكون التخيلي)",
 "おんぎ": "وَاجِب, فَرِيضَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "おんぎょう": "خفاء, عدم المرئية (صفة عدم إمكانية الإدراك بالعين) / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "おんぎょく": "أداء موسيقي (فعل أداء الموسيقى)",
 "おんけい": "غريس / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "おんけいてき": "مُفِيد",
 "おんけいろん": "فُونُولُوجِيَّا, عِلْمُ ٱلْأَصْوَاتِ ٱللُّغَوِيَّةِ",
 "おんけつどうぶつ": "ذوات الدم الحار (لديه دم حار (في الحيوانات التي يتم تنظيم درجة حرارة جسمها داخليًا))",
 "おんけん": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "おんけんは": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "おんけんろせん": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط)",
 "おんげん": "سَمْعِيّ, أُودْيُو",
 "おんこ": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه / اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "おんこう": "مُؤَدَّب / زِفْت / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "おんさ": "شوكة رنانة (أداة معدنية ذات شعبتين تصدر نغمة ثابتة عند طرقها؛ تستخدم لضبط الآلات الموسيقية)",
 "おんし": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / قصيدة سيمفونية, قصيدة نغمية (تكوين أوركسترالي مبني على الأدب أو الحكايات الشعبية) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "おんしつ": "دَفِيئَة زِرَاعِيّة, دَفِيئَة",
 "おんしつこうか": "اَلاِحْتِبَاس اَلْحَرَارِيّ",
 "おんしつこうかガス": "غازات دفيئة",
 "おんしゃ": "عَفْو / نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "おんしゃく": "قَرْض, إِعَارَة",
 "おんしゅう": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / تفتيش, معاينة (فحص رسمي أو حكومي) / تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة) / مراجعة ((قانون) إعادة فحص قضائي لإجراءات محكمة (خاصة من قبل محكمة استئناف))\nمثال: وقفت الفصيلة جاهزة للتفتيش / مرارة",
 "おんしょ": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "おんしょう": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / بُؤْرَة",
 "おんしょく": "جرس الصوت, خامة الصوت ((موسيقى) الخاصية المميزة لصوت مركب (صوت بشري أو ضجيج أو صوت موسيقي))\nمثال: كان جرس صوت السوبرانو الخاص بها غنياً وجميلاً",
 "おんしらず": "جاحد, غير ممتن (لا يشعر أو لا يظهر الامتنان) / ثَقِيل, غَيْر مُسْتَسَاغ (غير مقبول أو غير مستساغ)\nمثال: ورثة جاحدون",
 "おんしん": "مُرَاسَلَة",
 "おんじ": "كتابة مقطعية, نظام مقطعي (نظام كتابة تمثل رموزه مقاطع صوتية)",
 "おんじゃくめん": "كريزوتيل (معدن ليفي رمادي أو أخضر؛ مصدر تجاري مهم للأسبستوس)",
 "おんじゅん": "طيع, مروض (مستعد للتعلم أو القيادة أو الإشراف أو التوجيه) / سَلِس, وَدِيع (سَهْلُ القِيَادَةِ وَالتَّعَامُل) / قَابِل لِلتَّعْلِيم, وَدِيع (مستعد وراغب في التعلم)\nمثال: الجماهير المنصاعة لأمة مستعبدة",
 "おんじょう": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة. / حب المساعدة, طيبة (ود يتضح من خلال طبع طيب ومحب للمساعدة) / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "おんじょうしゅぎ": "أبوية, وصاية (موقف (لشخص أو حكومة) يرى وجوب السيطرة على المرؤوسين بطريقة أبوية لمصلحتهم)",
 "おんじん": "مُتَبَرِّع",
 "おんすいき": "سخان مياه (سخان وخزان تخزين لتوفير المياه الساخنة)",
 "おんせい": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / تَلْفَنَ / سَمْعِيّ, أُودْيُو",
 "おんせいがく": "صَوْتِيَات",
 "おんせいきかん": "عضو نطق (أي من الأعضاء المشاركة في إنتاج الكلام)",
 "おんせいきごう": "رمز صوتي (حرف مكتوب يُستخدم في النسخ الصوتي لتمثيل صوت كلام معين)",
 "おんせいげんご": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "おんせいごうせいそうち": "مركب كلام (جهاز يستخدم للإنتاج الاصطناعي للكلام البشري)\nمثال: يتم الحكم على جودة مركب الكلام من خلال تشابهه مع الصوت البشري وقدرته على أن يكون مفهوماً بوضوح",
 "おんせいちょうせいたく": "خَلَّاط, خَفَّاقَة",
 "おんせいにんしき": "تعرف على الكلام",
