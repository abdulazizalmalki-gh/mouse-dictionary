 "お日様": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "お早う": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "お早うございます": "صَبَاح الْخَيْر, صَبَاح النُّور\nمثال: 皆さん、おはようございます。 — صَبَاح الْخَيْر جَمِيْعاً.",
 "お早めに": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "お星さま": "إِجَّامَة",
 "お星様": "إِجَّامَة",
 "お昼": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء. / ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل! / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "お時間": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "お晩": "مَسَاء",
 "お晩です": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "お暇": "ذهاب, رحيل (فعل المغادرة) / رَاحَة, خُلُو مِنَ الْعَمَل",
 "お暇なら": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "お替り": "ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "お替わり": "ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "お月さま": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "お月様": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "お札": "بَنْكْنُوت, وَرَقَة نَقْدِيَّة",
 "お株": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "お椀": "زِبْدِيَّة",
 "お楽しみ": "مُتْعَة, مِتْعَة / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "お楽しみ会": "طَرَف",
 "お構い": "تَرْفِيه, تَسْلِيَة / إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما)\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "お構いなし": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات / تَبْرِئَة",
 "お次": "قَادِم\nمثال: زيري بجانب الحوض.",
 "お歌": "قَصِيدَة, شِعْر",
 "お止し": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "お正月": "السَّنَة الْجَدِيدَة / يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "お歳暮": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "お歴々": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "お殿様": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "お母": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة",
 "お母さま": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "お母さん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "お母さんっ子": "ابن أمه (صبي متعلق بأمه بشكل مفرط؛ يفتقر إلى الاهتمامات الذكورية الطبيعية)",
 "お母さん子": "ابن أمه (صبي متعلق بأمه بشكل مفرط؛ يفتقر إلى الاهتمامات الذكورية الطبيعية)",
 "お母ちゃん": "أُمّ, مَامَا (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "お母様": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "お毛々": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "お毛毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "お気に": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "お気になさらず": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "お気にめす": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "お気に入り": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم)\nمثال: هذا الكتاب هو أحد مفضلاتي / علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة)",
 "お気に召す": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "お気の毒": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "お水": "مِيَاه / مُضِيفَة / سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق)",
 "お汁": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "お求めやすい": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "お求め安い": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "お決まり": "مِعْيَارِيّ / مَلْحُوظ, وَاضِح (يُمْكِنُ تَمْيِيزُهُ؛ بَارِزٌ وَجَلِيّ)",
 "お決り": "مِعْيَارِيّ / مَلْحُوظ, وَاضِح (يُمْكِنُ تَمْيِيزُهُ؛ بَارِزٌ وَجَلِيّ)",
 "お泊まり": "مَكَثَ, بَقِيَ",
 "お泊まり会": "حفلة مبيت, مبيت (مناسبة قضاء ليلة بعيداً عن المنزل أو استضافة ضيف للمبيت (خاصة كحفلة للأطفال))",
 "お泊まり保育": "حَضَانَة, رَوْضَة",
 "お泊り会": "حفلة مبيت, مبيت (مناسبة قضاء ليلة بعيداً عن المنزل أو استضافة ضيف للمبيت (خاصة كحفلة للأطفال))",
 "お泊り保育": "حَضَانَة, رَوْضَة",
 "お洒落": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية)\nمثال: ملابس عصرية",
