 "かくる": "أَخْفَى, خَبَأَ\nمثال: أين اختبأ ياني؟",
 "かくれ": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "かくれおに": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "かくれが": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع",
 "かくれがに": "سرطان البازلاء (سرطان صغير ناعم الجسم يعيش بشكل تكافلي في عباءات بعض الرخويات ذات الصدفتين)",
 "かくれきがん": "بريشيا (صخر حصوي يتكون من شظايا حادة مغمورة في الطين أو الرمل)",
 "かくれざと": "شَانْغْرِيلَا",
 "かくれば": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "かくればしょ": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "かくれひそむ": "أَخْفَى, خَبَأَ\nمثال: أين اختبأ ياني؟",
 "かくれみ": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "かくれみの": "غِطَاء",
 "かくれもない": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "かくれや": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع",
 "かくれる": "أَخْفَى, خَبَأَ\nمثال: أين اختبأ ياني؟ / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / تَقَاعَدَ",
 "かくれんぼ": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "かくれんぼう": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "かくれ家": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع",
 "かくろん": "خاص, فردي (كائن أو مميز لشيء واحد أو شخص واحد)\nمثال: قطرات فردية من المطر",
 "かくん": "اِنْهَار",
 "かくエネルギー": "طَاقَة ذَرِّيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة…)\nمثال: طلب بطاقة اعتماد.",
 "かくクラブ": "النادي النووي (الدول التي تمتلك أسلحة نووية)",
 "かくシェルター": "قُنْبُلَة نَوَوِيَّة",
 "かくテロ": "إرهاب نووي (استخدام جهاز نووي من قبل منظمة إرهابية لإحداث دمار هائل أو استخدام (أو التهديد…)",
 "かく乱": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "かく言う": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "かぐ": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل…)\nمثال: يصنع قطعة أثاث خشبية. / استنشاق, تشمم (استشعار رائحة عن طريق الاستنشاق من الأنف) / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "かぐし": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "かぐつき": "مؤثث, مفروش (مزود بما هو ضروري لغرض ما (مثل الأثاث أو المعدات أو السلطة))\nمثال: شقة مفروشة",
 "かぐわしい": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ)",
 "かぐん": "وَحْدَة",
 "かけ": "اِئْتِمَان / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة. / علاقة (أي شيء يمكن تعليق شيء منه) / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / دَجَاج, لَحْم دَجَاج\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل. / قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد)) / رِهَان, مُرَاهَنَة / ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "かけあい": "مُفَاوَضَات, مُذَاكَرَات / حِوَار, مُحَادَثَة",
 "かけあう": "تَفَاوَضَ",
 "かけあし": "بِخُطْوَة سَرِيعَة, بِسُرْعَة مُضَاعَفَة (بسرعة أكبر)\nمثال: الآن دعونا نعزف القطعة مرة أخرى بسرعة مضاعفة / راكض, مخب (يركب بمشية بين الخبب والعدو (الخبب السريع))\nمثال: الجنود المخبون / ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "かけあわす": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل…)\nمثال: البغل هو هجين بين حصان وحمار",
 "かけあわせる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل…)\nمثال: البغل هو هجين بين حصان وحمار / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かけい": "حرق, حرق على الخازوق (الإعدام بالنار) / جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية)\nمثال: دخل على وقع نغمة احتفالية من الأبواق / سُوَيْقَة جِذْرِيَّة / أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "かけいず": "شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "かけいせい": "فرط التنسج (زيادة غير طبيعية في عدد الخلايا)",
 "かけうりだいきん": "حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "かけおち": "فرار مع الحبيب (فعل الهروب مع عشيق (عادةً للزواج))",
 "かけかえ": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً",
 "かけかえる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "かけかまい": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَلَاقَة, مُنَاسَبَة",
 "かけがえ": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً",
 "かけがえのない": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "かけがえの無い": "لا يستبدل, لا يعوض (مستحيل استبداله)\nمثال: تحف لا تعوض",
 "かけがね": "زِلاَج, ضَبَّة",
 "かけがみ": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "かけきん": "قِسْط (عَدْل؛ حِصَّة عادلة)\nمثال: سامي بحاجة إلى قسط من الراحة. / رهان, مراهنة (المال المخاطر به في مقامرة)",
 "かけくぎ": "وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "かけくら": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "かけくらべ": "سِبَاق, مُسَابَقَة\nمثال: هذا القميص مبلل بالعرق.",
 "かけことば": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "かけこみ": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "かけこみでら": "مَلْجَأ, مَلَاذ",
 "かけごえ": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "かけごこち": "رَاحَة",
 "かけごと": "مُرَاهَنَة",
 "かけごとし": "مُقَامِر",
 "かけごや": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "かけざん": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "かけじる": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "かけだし": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / فرار, هروب (فعل المغادرة (بدون إذن) للمكان الذي من المتوقع أن تكون فيه)",
 "かけだしもの": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "かけだす": "نَفِدَ",
 "かけちがい": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "かけちがう": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "かけっくら": "سِبَاق, مُسَابَقَة\nمثال: هذا القميص مبلل بالعرق.",
 "かけっこ": "سِبَاق, مُسَابَقَة\nمثال: هذا القميص مبلل بالعرق.",
 "かけつ": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض.",
 "かけつける": "اِنْدَفَعَ, أَسْرَعَ",
 "かけどおし": "شَحْطَة",
 "かけどけい": "ساعة حائط (ساعة مثبتة على الحائط)",
 "かけにでる": "قِمَار",
 "かけぬける": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "かけね": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "かけのぼる": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "かけはし": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "かけはしとなる": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "かけひ": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "かけひき": "مساومة (التفاوض على شروط صفقة أو اتفاقية) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك…)",
 "かけふ": "غطاء قماشي (غطاء مصنوع من القماش)",
 "かけふだ": "لافِتَة\nمثال: توم وقع و أصيب.",
 "かけぶとん": "لِحَاف",
 "かけめ": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / تفتيت, شطف (عملية شطف جزء من شيء ما)",
 "かけもの": "كاكيمونو (معلقة حائطية يابانية (من الورق أو الحرير)؛ عادة ما تكون ضيقة وعليها صورة أو…) / غطاء سرير, مفرش سرير (غطاء مزخرف للسرير) / رِهَان, مُرَاهَنَة",
 "かけや": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار…) / مُؤَلِّف, كَتَّاب",
 "かけゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "かけら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / أُوقِيَّة",
 "かける": "عَلَّقَ\nمثال: أغلق الباب بغضب / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / أَنْفَقَ, صَرَفَ / رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن…) / يقرب / تفتيت, شطف (عملية شطف جزء من شيء ما) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد)) / رهان (فعل المقامرة)\nمثال: فعل ذلك في رهان / تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء) / رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا.",
 "かけ合せる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل…)\nمثال: البغل هو هجين بين حصان وحمار / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かけ合わす": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل…)\nمثال: البغل هو هجين بين حصان وحمار",
 "かけ合わせる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل…)\nمثال: البغل هو هجين بين حصان وحمار / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かけ声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "かけ心地": "رَاحَة",
 "かけ橋": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي",
 "かけ算": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "かけ違い": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "かけ違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "かげ": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / اِنْعِكَاس, عَكْس / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / وَرَاءَ / خلفية / قتامة, كآبة (شعور بتوجس كئيب)\nمثال: أشعل عود ثقاب ليبدد العتمة / غَزَالِيّ اللَّوْن (بلون الغزال؛ بني فاتح مصفر) / صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج…)",
 "かげうら": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "かげえ": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かげがさす": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مِنْسَج",
 "かげき": "أُوبِرَا, أُوپِرَا / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل) / صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ)…)",
 "かげきしそう": "تَطَرُّف, غُلُوّ",
 "かげきしゅぎ": "تَطَرُّف, غُلُوّ",
 "かげきじょう": "أوبرا, دار الأوبرا (مبنى يتم فيه تقديم الأعمال الدرامية الموسيقية)",
 "かげきだん": "فرقة أوبرا (فرقة تنتج الأوبرا)",
 "かげきは": "مُتَطَرِّف, مُتَطَرِّفَة\nمثال: その過激派が政府打倒の陰謀を企てているという噂が立ってる。 — ثمّة شائعةٌ تقول أن الأصوليين يرسمون خطة مضادة للحكومة.",
 "かげぐち": "فضيحة, نميمة خبيثة (قيل وقال مشين عن الحياة الخاصة للآخرين)",
 "かげぐちをたたく": "اِغْتَابَ, أَبَرَ",
 "かげごと": "فضيحة, نميمة خبيثة (قيل وقال مشين عن الحياة الخاصة للآخرين)",
 "かげつけしょり": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات)",
 "かげとかたちのように": "بتلازم, بشكل لا ينفصل (دون إمكانية للفصل)\nمثال: هذان الاثنان مرتبطان بشكل لا ينفصل",
 "かげながら": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "かげにひに": "أبداً",
 "かげのある": "كَئِيب, مُوحِش",
 "かげのうすい": "غَيْرُ ظَاهِر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "かげのないかく": "حكومة الظل (مجموعة من كبار أعضاء الحزب السياسي الذي هو خارج السلطة؛ من المحتمل أن يتولى…)",
 "かげひなた": "ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "かげぼうし": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かげむしゃ": "ثُنَائِيّ",
 "かげり": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "かげをひそめる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "かげん": "التربيع الثاني, التربيع المتناقص / حد جنوبي, حد سفلي (الحد الموجود على الجانب السفلي (أو الجنوبي) لشيء ما) / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية. / أخبار سارة, بشارة (أخبار جيدة) / دَرَجَة / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / ضَبْط / بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً / تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري) / صِينِيّ / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / بيان خاطئ (بيان يحتوي على خطأ) / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "かげんうんどう": "حركة ظاهرية (وهم بصري للحركة ينتج عن عرض تتابع سريع لصور ثابتة لجسم متحرك)\nمثال: تعتمد السينما على الحركة الظاهرية",
 "かげんかかく": "حد أدنى للسعر (أرضية لا يُسمح للأسعار بالانخفاض دونها)\nمثال: استخدمت الحكومة دعم الأسعار للحفاظ على الحد الأدنى للسعر",
 "かげんせつ": "دوسيتية, ظاهرية (العقيدة الهرطقية (المرتبطة بالغنوصيين) القائلة بأن يسوع لم يكن له جسد بشري وأن…)",
 "かげんていこうき": "ريوستات, مقاومة متغيرة (مقاومة لتنظيم التيار)",
 "かげんてき": "اِفْتِرَاضِيّ",
 "かげんてきめいほう": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "かげんてきめいれい": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "かげんのつき": "التربيع الثاني, التربيع المتناقص",
 "かげんめいほう": "أَمْر شَرْطِيّ (مبدأ ينص على الإجراء المطلوب لتحقيق هدف منشود)",
 "かこ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى. / بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب…)\nمثال: هى متزوجة من بحار. / أَيِّل",
 "かこい": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر)\nمثال: 家の周りには囲いがしてある。 — هناك سياج حول المنزل. / إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / سَيِّدَة / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "かこいおんな": "سَيِّدَة",
 "かこいこみ": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر)",
 "かこいこむ": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "かこいめ": "سَيِّدَة",
 "かこいもの": "سَيِّدَة",
 "かこう": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / مَلَاذ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين. / اِحْتَفَظَ, أَبْقَى / خَزَنَ (حفظ، إدخر، أودع في مخزن) / تَنَازُلِيّ / نُزُول / خفة, رشاقة (خفة في الحركة أو الأسلوب)\nمثال: رقة لمستها / تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة / ضوء النار (ضوء النار (خاصة في الموقد)) / فَوَّهَةُ الْبُرْكَان, فَوَّهَة / حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات))\nمثال: محرك الديزل هو حراق زيت / مَصَبّ, فُغْرَة / هندسة كيميائية (نشاط تطبيق الكيمياء لحل المشكلات العملية) / شمراخ (ساق زهرة منتصبة بلا أوراق تنمو مباشرة من الأرض كما في الزنبق) / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "かこうがん": "صَوَّان, غْرَانِيت",
 "かこうき": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "かこうぎし": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "かこうけっちょう": "قولون نازل (جزء الأمعاء الغليظة الذي ينزل من القولون المستعرض إلى القولون السيني)",
 "かこうじゅつ": "صناعة الألعاب النارية (حرفة صنع الألعاب النارية)",
 "かこうだいどうみゃく": "أبهر نازل (الجزء النازل من الأبهر الذي يتفرع إلى الأبهر الصدري والأبهر البطني)",
 "かこうひん": "بَارِع, مُبْهِر (يوحي بالألعاب النارية؛ متألق ومبهر)\nمثال: دخان الألعاب النارية",
 "かこうデータ": "بيانات خام (بيانات غير محللة؛ بيانات لم تخضع بعد للتحليل)",
 "かこかんりょう": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "かこかんりょうけい": "ماضي تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الماضي)",
 "かこきゅう": "فرط التهوية (زيادة عمق ومعدل التنفس بشكل أكبر مما تتطلبه حاجة الجسم؛ يمكن أن يسبب الدوار…)",
 "かこく": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "かこけい": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "かこさいだい": "تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "かこしんこうけい": "ماضي مستمر (زمن مستمر يُستخدم لوصف حدث كان مستمراً في الماضي)",
 "かこじせい": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "かこつ": "تَعَظُّم / جُسْأَة",
 "かこつけ": "ذَرِيعَة, عُذْر",
 "かこぶんし": "اسم المفعول (صيغة فعلية تعبر عن عمل مكتمل)",
 "かこみ": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حِصَار, مُحَاصَرَة",
 "かこみきじ": "عَمُود",
 "かこむ": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / حَاصَرَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "かこん": "أشباه الجذور (أي من الخيوط الرفيعة المختلفة التي تعمل كجذور في الطحالب والسراخس والفطريات وما…)",
 "かこログ": "أَرْشِيف / خَشَبَة",
 "かご": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي. / حَمَّالَة, مِحَفَّة / سَلَّة / أَيِّل / صِينِيّ",
 "かごう": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / اقتران سفلي ((في علم الفلك) محاذاة الأرض وكوكب على نفس الجانب من الشمس)",
 "かごうぶつ": "مُرَكَّب (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة)\nمثال: أطلقت الشرطة النار على إطارات مركبة توم.",
 "かごかき": "كرسي محمول, محفّة كرسي (محفّة مغلقة لراكب واحد)",
 "かごしま": "كَاغُوشِيمَا",
 "かごしゅ": "هيمارتوما, ورم عابي (نمو بؤري يشبه الورم ولكنه ينتج عن خلل في التطور في عضو ما)",
 "かごと": "ذَرِيعَة, عُذْر / رِسَالَة, خَبَر",
 "かごむ": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / حَاصَرَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "かごや": "صانع السلال (من الهنود الحمر الأوائل المرتبطين بشعب بويبلو؛ معروفون بمهارتهم في صنع السلال) / كرسي محمول, محفّة كرسي (محفّة مغلقة لراكب واحد)",
 "かごりょう": "فخ جراد البحر (فخ لصيد جراد البحر)",
 "かごん": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / بيان خاطئ (بيان يحتوي على خطأ)",
 "かご漁": "فخ جراد البحر (فخ لصيد جراد البحر)",
 "かさ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / مِظَلَّة, شَمْسِيَّة / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة)\nمثال: شراؤها بالجملة أرخص / هَالَة / بثرة قيحية (ارتفاع جلدي ملتهب صغير يحتوي على قيح؛ فقاعة مملوءة بالقيح) / زُهَرِيّ, مَرَض فِرَنْجِيّ / مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير…)",
 "かさあげ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / متزايد, متنامٍ (يصبح أكبر أو أضخم)\nمثال: أسعار متزايدة",
 "かさい": "حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟ / محكمة الأسرة, محكمة العلاقات الأسرية (محكمة في بعض ولايات الولايات المتحدة لها اختصاص في النزاعات العائلية (خاصة تلك…)",
