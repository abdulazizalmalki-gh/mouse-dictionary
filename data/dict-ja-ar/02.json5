 "きしゅう": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "きしゅうこうげき": "كَمين / كَمِين",
 "きしゅく": "إِقَامَة / مَهْجَع",
 "きしゅくがっこう": "مَدْرَسَة دَاخِلِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "きしゅくしゃ": "مَهْجَع",
 "きしゅくりょう": "مَهْجَع",
 "きしょ": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "きしょい": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きしょう": "طَقْس, جَوّ / طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "きしょうがく": "عِلْم اَلطَّقْس, عِلْم الَأَرْصَاد الْجَوِّيَّة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "きしょうよほう": "تَوَقُّع جَوِّيّ, تَوَقُّع طَقْس",
 "きしょく": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "きしょくがわるい": "عَجِيب, غَرِيب",
 "きしょくのわるい": "عَجِيب, غَرِيب",
 "きしょくわるい": "عَجِيب, غَرِيب",
 "きしょー": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きしり": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا) / اِحْتِكَاك",
 "きしる": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا)",
 "きしん": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "きじ": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "きじく": "مِحْوَر",
 "きじつ": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "きじもく": "دَجَاجِيّ / دَجَاجِيَّة",
 "きじや": "بَزَّاز",
 "きじゅう": "رَشَاش, مِتْرالِيُوز (أي آلَة تَرُش المَاء؛ المِدْفَع الرَشَّاش: هو بين المِدْفَع والرَشَّاشَة لا يُحمَل باليد ويثبت على الأرض إلا أنه يَرُشّ الرصاص كالرشاشة)\nمثال: إني أطلق النار برشاش روسي.",
 "きじゅうき": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "きじゅつ": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "きじゅつこう": "إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل",
 "きじゅつし": "سَاحِر",
 "きじゅん": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "きじゅんじてん": "عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "きじゅんほう": "النظام الأساسي",
 "きじょ": "آلِيَّة",
 "きじょう": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "きじょうぶ": "شجاع (الثعبان)\nمثال: إنك شجاع للغاية.",
 "きじょうみゃく": "وَرِيد فَرْد",
 "きじらみ": "بْسِيلَّا",
 "きじるし": "جُنُون",
 "きじん": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "きす": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة) / ذَكَرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "きすい": "نَاجِح, فَائِز",
 "きすう": "عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "きする": "صَلَّحَ / أَصْلَحَ / تَوَقَّعَ / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "きず": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره) / عَيْبٌ\nمثال: ここに傷があるので安くしてください。 — يوجد خدشة هنا، فهل تستطيع اعطائي حسم؟ / بُقْعَة",
 "きずあと": "نَدْبَة, نَدْب",
 "きずきあげる": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "きずく": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "きずぐすり": "مَرْهَم, زَبْدَة",
 "きずぐち": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "きずつきやすい": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "きずつける": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "きずな": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / غُلّ, أَغْلال",
