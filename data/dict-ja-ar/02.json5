 "ぎもんし": "اِسْتِفْهَامِيّ / أَدَاة اِسْتِفْهَام",
 "ぎもんてん": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "ぎもんにおもう": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "ぎもんふ": "عَلَامَة اِسْتِفْهَام, ؟ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ぎゃあぎゃあ": "صرخة / صَرَخَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "ぎゃく": "عَكَسَ / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ぎゃくうん": "نَحْس, سُوءُ الحَظّ",
 "ぎゃくかいてん": "عَدَّاد",
 "ぎゃくきりおとし": "مِجَنّ, تُرْس / وَقَى, حَمَى (حَمى شخصًا أو شيئًا من خطرٍ أو أذى؛ اتخذ الاحتياطات اللازمة لتجنب وقوع الضرر)",
 "ぎゃくぐう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ぎゃくさつ": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "ぎゃくさよう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "ぎゃくすう": "مُتَبَادَل / مَقْلُوب",
 "ぎゃくせい": "طُغْيَان, اِسْتِبْدَاد",
 "ぎゃくせつ": "مُفَارَقَة",
 "ぎゃくそう": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "ぎゃくぞく": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "ぎゃくたい": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ぎゃくてにとる": "اِسْتَغَلَّ",
 "ぎゃくてんがち": "رِيمُونْتَادَا",
 "ぎゃくてんげき": "رِيمُونْتَادَا",
 "ぎゃくと": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "ぎゃくに": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ぎゃくふう": "كَوْس, رِيَاح مُضَادَّة",
 "ぎゃくふごうか": "فك تشفير",
 "ぎゃくむき": "عَكَسَ",
 "ぎゃくもしかり": "الْعَكْس بِالْعَكْس, الْعَكْس صَحِيح",
 "ぎゃくもまたしかり": "الْعَكْس بِالْعَكْس, الْعَكْس صَحِيح",
 "ぎゃくよう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ぎゃくアセンブル": "تَفْكِيك",
 "ぎゃくクリッピング": "مِجَنّ, تُرْس / وَقَى, حَمَى (حَمى شخصًا أو شيئًا من خطرٍ أو أذى؛ اتخذ الاحتياطات اللازمة لتجنب وقوع الضرر)",
 "ぎゃっきょう": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "ぎゃんなき": "فَوْرة غَضَب, نَوْبة غَضَب",
 "ぎゅう": "مَوَاشٍ, مَاشِيَة / بَقَر (فتح وشق ووسّع؛ فتش عن الخفايا وكشف عنها، عرف أحوال الناس)\nمثال: أفضل لحم البقر. / لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "ぎゅうかく": "بُوق (فَسَد؛ باق الرجل: كَذَب) / زَمْر, بُوق\nمثال: كان سامي ينبه بالبوق.",
 "ぎゅうぎゅう": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا) / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / عَذَاب / عَذَّبَ",
 "ぎゅうぎゅうづめ": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "ぎゅうぎゅう詰め": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "ぎゅうじる": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "ぎゅうじをとる": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "ぎゅうたろう": "قَوَّاد, عرص / قَادَ, قَوَّدَ",
 "ぎゅうづめ": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "ぎゅうなべ": "سوكيياكي",
 "ぎゅうにく": "لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "ぎゅうにゅう": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "ぎゅうにゅうはいたつ": "بَائِع لَبَن",
 "ぎゅうにゅうや": "مشتقات الحليب / مَلْبَنَة / حَلِيبِيّ / لَبَنِيّ",
 "ぎゅうふん": "هُرَاء",
 "ぎゅうらく": "زُبْدَة (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما يراد به أو أهم ما فيه) / زبدة (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما يراد به أو أهم ما فيه)\nمثال: اشترت رطلي زبدة.",
 "ぎゅう詰め": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "ぎゅって": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "ぎゅっと": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "ぎゆう": "بَسَالَة, بُطُولَة",
 "ぎょい": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "ぎょう": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ぎょうかい": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "ぎょうかんをよみとる": "قَرَأَ مَا بَيْنَ السُّطُور (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "ぎょうかんをよむ": "قَرَأَ مَا بَيْنَ السُّطُور (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "ぎょうぎ": "مُشَاوَرَة, اِسْتِشَارَة",
 "ぎょうぎさほう": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "ぎょうぎょう": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "ぎょうぎょうしい": "بَالَغَ",
 "ぎょうぎわるい": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ぎょうけつ": "تَجَمَّدَ",
 "ぎょうこ": "تَجَمَّدَ",
 "ぎょうこう": "حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ) / بَخْت\nمثال: لقد حالفني الحظ.",
 "ぎょうこつ": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "ぎょうさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / بَالَغَ",
 "ぎょうし": "وَقَّرَ",
 "ぎょうしゃ": "بَائِع, تَاجِر",
 "ぎょうしゃはんばい": "إِجْمَالِيّ, بِالْجُمْلَةِ",
 "ぎょうしゅうかい": "إِجْمَالِيّ, مَجْمُوع / سْكَانْدَا",
 "ぎょうしゅく": "تَرْكِيز",
 "ぎょうしょう": "قَائِد, زَعِيم",
 "ぎょうしょうにん": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "ぎょうじ": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "ぎょうじゃ": "نُسُكِيّ / نَاسِك",
 "ぎょうじょ": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "ぎょうじょう": "سُلُوك, تَصَرُّف",
 "ぎょうずい": "وُضُوء, غُسْل / وَضُوء",
 "ぎょうずる": "أَدَّى",
 "ぎょうせい": "نَجْمَة الصَّبَاح",
 "ぎょうせいく": "جَنَاح",
 "ぎょうせいけん": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "ぎょうせいじょうれい": "أَمْرٌ تَنْفِيذِيٌّ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "ぎょうせいてき": "إِجْرَائِيّ",
 "ぎょうせいふ": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "ぎょうせき": "إِنْجَاز",
 "ぎょうぜんとして": "بِهُدُوء",
 "ぎょうそう": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "ぎょうそろえ": "تَبْرِير",
 "ぎょうぞろえ": "تَبْرِير",
 "ぎょうたい": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "ぎょうちゃく": "اِلْتِصَاق",
 "ぎょうちゃくりょく": "اِلْتِصَاق",
 "ぎょうてん": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "ぎょうにゅう": "خُثَارَة, أَقِط",
 "ぎょうはん": "إِجْمَالِيّ, بِالْجُمْلَةِ",
 "ぎょうほう": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "ぎょうぼう": "اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "ぎょうむ": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "ぎょうむしっこう": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "ぎょうむじょう": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "ぎょうむてき": "مُحْتَرِف, مُحْتَرِفَة",
 "ぎょうむめいれい": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ぎょうゆう": "شَجَاعَة",
 "ぎょうれつ": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / مَصْفُوفَة",
 "ぎょうれつしき": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "ぎょえい": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "ぎょかい": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "ぎょかいるい": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "ぎょかく": "مَصْيَدَة",
 "ぎょかくだか": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "ぎょかくぶつ": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "ぎょかくりょう": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "ぎょぎょう": "مَصْيَدَة",
 "ぎょぎょうしゃ": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょく": "مَصْيَدَة",
 "ぎょくえい": "قَرِيس, قَرِيت",
 "ぎょくざ": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "ぎょくしょう": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "ぎょくと": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "ぎょくりん": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "ぎょけい": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية.",
 "ぎょこう": "بُرْج اَلْحُوت, اَلْحُوت (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ぎょし": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "ぎょしゃ": "سَائِق, سَوَّاق",
 "ぎょしょう": "صلصة السمك, صوص السمك",
 "ぎょしょく": "فَحْشَاء, فِسْق",
 "ぎょしん": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "ぎょす": "قَادَ, سَاقَ / سَاقَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "ぎょする": "قَادَ, سَاقَ / سَاقَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "ぎょせんいん": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょせんのりくみいん": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょぞく": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "ぎょたい": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "ぎょたく": "أَرْشِيف",
 "ぎょふ": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょもう": "شَبَكَة صَيْد",
 "ぎょゆ": "زَيْت السَّمَك (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "ぎょらい": "طُرْبِيد",
 "ぎょらんいし": "أوليث",
 "ぎょりょう": "مَصْيَدَة",
 "ぎょるい": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "ぎょるいがく": "عِلْم اَلْأَسْمَاك (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ぎょろう": "صَيْد سَمَك, صَيْد",
 "ぎょろぎょろ": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "ぎょろり": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "ぎょーさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / بَالَغَ",
 "ぎよう": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "ぎよく": "نَمْل, نَمْلَة",
 "ぎらい": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "ぎらつく": "وَهَج / لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ぎらり": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "ぎり": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب."
