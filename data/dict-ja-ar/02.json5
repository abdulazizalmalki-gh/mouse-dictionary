 "おもてにほん": "الْمُحِيط الْهَادِئ",
 "おもてぶたい": "وسط المسرح (المنطقة المركزية على خشبة المسرح)",
 "おもてむき": "ظَاهِرِيّ, مَزْعُوم (يبدو كذلك في الظاهر؛ مُدَّعى أو مُتظاهَر به)",
 "おもてめ": "غرزة عدلة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب…)",
 "おもてめん": "الوجه (للعملة) (جانب العملة أو الميدالية الذي يحمل الختم أو التصميم الرئيسي)\nمثال: الوجه المقابل لهذه القضية",
 "おもて面": "الوجه (للعملة) (جانب العملة أو الميدالية الذي يحمل الختم أو التصميم الرئيسي)\nمثال: الوجه المقابل لهذه القضية",
 "おもとじ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "おもとめやすい": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "おもな": "شَيْخ, قَائِد",
 "おもなが": "طَوِيل الوَجْه (ذو وجه أطول من المعتاد)",
 "おもなる": "رَئِيسِيّ",
 "おもに": "غَالِبًا / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً)\nمثال: عبء المسؤولية",
 "おもねる": "تَمَلَّقَ, تَبَصْبَصَ",
 "おもはゆい": "مُحْرَج, بِٱلْحَرَج",
 "おもひで": "ذَاكِرَة, حَافِظَة",
 "おもみ": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / أَهَمِّيَّة",
 "おもみづけ": "ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية)",
 "おもむき": "مَعْنًى / تَأْثِير, أَثَر / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / غريس",
 "おもむきのある": "أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "おもむきぶかい": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "おもむく": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / اِلْتَزَمَ",
 "おもむろに": "فَجْأَةً / بِبُطْء",
 "おもめ": "قَلِيلًا",
 "おももち": "تَعْبِير",
 "おもり": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / كرة هابطة (رمية تنحني للأسفل بسرعة عند اقترابها من اللوحة) / مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل) / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "おもろい": "مُشَوِّق, ممتع / مُمْتِع",
 "おもわ": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "おもわく": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / تَكَهُّنٌ",
 "おもわくし": "مُضَارِب",
 "おもわくちがい": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "おもわしい": "لَائِق, مَقْبُول (يفي بالمتطلبات والمعايير المطلوبة)\nمثال: ظروف معيشية مرضية / بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもわしくない": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
