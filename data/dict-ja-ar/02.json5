 "かんせんしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "かんせんしょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんせんどう": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "かんせんどうろ": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "かんせんびょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんぜい": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح.",
 "かんぜつ": "فَرِيد, فَذّ",
 "かんぜん": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "かんぜんさいしょくしゅぎしゃ": "خُضْرِيّ",
 "かんぜんしゅぎ": "كَمَالِيَّة",
 "かんぜんしゅぎしゃ": "كَمَالِيّ",
 "かんぜんせい": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "かんぜんちょうあく": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط والإنْصَاف)\nمثال: يريدون العدالة.",
 "かんぜんへき": "كَمَالِيَّة",
 "かんそ": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "かんそう": "قُحُولَة",
 "かんそうか": "فَوَاكِه مُجَفَّفَة",
 "かんそうせんたく": "تَنْظِيف جَافّ",
 "かんそうち": "بَرّ, يَابِسَة (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "かんそうにく": "قَدِيد",
 "かんそく": "رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / رَأْي, نَظَر",
 "かんそくしゃ": "متفرج",
 "かんそくじょ": "مَرْصَد",
 "かんぞう": "عِرْقْسُوس, نَبَات اَلسُّوس",
 "かんぞうえん": "اِلْتِهَاب الْكَبِد",
 "かんぞく": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "かんたい": "كَرَم, إِكْرَام / ضِيَافَة",
 "かんたいさいぼう": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "かんたいりん": "تَايْغَا",
 "かんたる": "أَفْضَل",
 "かんたん": "إِعْجَاب",
 "かんたんし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんたんにいえば": "بِاخْتِصَار",
 "かんたんふ": "عَلَامَةْ تَعَجُّب, عَلَامَةْ هُتَاف (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "かんたんぶん": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんだい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "かんだちべ": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "かんだちめ": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "かんだん": "دَرْدَشَ / مُحَادَثَّة / دَرْدَشَة",
 "かんだんけい": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "かんだんなく": "باستمرار",
 "かんち": "اِدْرََاك حَسِّيّ",
 "かんちがい": "سُوء فَهْم",
 "かんちき": "حَسَّاس, جِهَازُ اِسْتِشْعَار",
 "かんちく": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "かんちつ": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "かんちゅう": "سَقْي / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "かんちょう": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "かんちょういき": "مَصَبّ, فُغْرَة",
 "かんちょうえき": "حُقْنَة شَرَجِيَّة, حُقْنَة",
 "かんつい": "تَنْفِيذ",
 "かんつう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "かんつうざい": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "かんづかさ": "كَاهِن, قِسِّيس",
 "かんづく": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "かんてい": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "かんていか": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "かんていにん": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "かんてき": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "かんてつ": "تَنْفِيذ / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "かんてん": "جَفَاف",
 "かんでん": "إِلِكْتْرُود",
 "かんとう": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "かんとうげん": "مُقَدِّمَة",
 "かんとうし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんとか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "かんとく": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "かんとくかん": "مُفَتِّش, مُفَتِّشَة",
 "かんとくしゃ": "مُشْرِف, مُشْرِفَة",
 "かんど": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "かんどう": "تَبَرَّأَ, تَبَرَّأَ مِنْ",
 "かんどうし": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんどうてき": "مُتَحَرِّك / مُؤَثِّر",
 "かんどうぶん": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "かんどうみゃくしっかん": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "かんどく": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "かんどころ": "مَرْبِط الْفَرَس",
 "かんな": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "かんなかけ": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "かんながらのみち": "شِنْتَوِيَّة, شِنْتُو",
 "かんなぎ": "مُتَوَسِّط",
 "かんなづき": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "かんなん": "مَشَقَّة, شِدَّة",
 "かんなんくろう": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "かんなんしんく": "مَشَقَّة, شِدَّة",
 "かんにさわる": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "かんにゅう": "مُنْخَفَض",
 "かんにゅうふん": "اِنْطِوَائِيّ",
 "かんにん": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / مَغْفِرَة, غُفْرَان",
 "かんぬき": "حَانَة, بَار",
 "かんねん": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / اِسْتِقَالَة, اِسْتِعْفَاء",
 "かんねんけいたい": "أَيْدِيُولُوجِيَا",
 "かんねんしゅぎ": "مِثَالِيَّة",
 "かんねんてき": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "かんねんねんぶつ": "تَفَكُّر",
 "かんねんれんごう": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "かんねんろん": "مِثَالِيَّة",
 "かんのいい": "بَدِيهِيٌّ",
 "かんのう": "شَهْوَانِيَّة",
 "かんのうき": "مجموعة وظيفية (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "かんのうせい": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "かんのうてき": "شَهْوَانِيّ",
