 "おもんじる": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام)\nمثال: تعامل معها باحترام.",
 "おもんずる": "شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "おもんない": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "おもんね": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんねえ": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんねー": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんばかり": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おもんぱかり": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おや": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟ / تَاجِر, تَاجِرَة / مُؤَسِّس, مُؤَسِّسَة / مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "おやかぎ": "ماستر كي, مفتاح رئيسي (مفتاح يؤمن الدخول في كل مكان)",
 "おやかた": "سَيِّد\nمثال: يبدو زيري أحسن. / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "おやかたさま": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "おやがた": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "おやがわり": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "おやき": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "おやぎ": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "おやぎょう": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "おやくごめん": "إِقَالَة / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه)",
 "おやくしょことば": "لغة بيروقراطية, لغة رسمية (أسلوب الكتابة المميز لبعض المسؤولين الحكوميين: رسمي وغامض)",
 "おやくしょしごと": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "おやくそく": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "おやくめ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "おやこうこう": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "おやこでんわ": "تحويلة, هاتف فرعي (جهاز هاتف إضافي متصل بنفس خط الهاتف)",
 "おやご": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "おやごさん": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "おやごろし": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه)",
 "おやしらず": "ضِرْس اَلْعَقْل",
 "おやじぎゃる": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おやじギャグ": "بَالٍ",
 "おやじギャル": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おやすい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "おやすいごよう": "عَفْوًا",
 "おやすみ": "عِيد\nمثال: ذهب سامي في عطلة. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة\nمثال: お休み、いい夢たくさん見てね。 — ليلة سعيدة و أحلام أسعد.",
 "おやすみなさい": "تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة",
 "おやだいだい": "مِيرَاث, إرْثْ",
 "おやだま": "رَئِيس, رَئِيسَة",
 "おやっさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة. / شَيْخ, عَجُوز",
 "おやつ": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "おやなかせ": "عَار, خِزْي",
 "おやなし": "بلا والدين, يتيم (ليس لديه والد أو والدين أو لا يرعاه بدائل الوالدين) / يَتِيم",
 "おやなしご": "يَتِيم",
 "おやににぬこはおにご": "الْوَلَدُ سُرّ أَبِيهِ",
 "おやのかたき": "عدو لدود (عدو يريد قتلك)",
 "おやびん": "رَئِيس, رَئِيسَة",
 "おやぶん": "رَئِيس, رَئِيسَة",
 "おやま": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "おやみ": "ركود, هدوء مؤقت (فترة من الطقس الهادئ)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "おやみたけりゃこをみろ": "الْوَلَدُ سُرّ أَبِيهِ",
 "おやむし": "حشرة كاملة, يافعة (حشرة بالغة ناتجة بعد التحول)",
 "おやもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / مَصْفُوفَة",
 "おやゆび": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن…) / إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "おやゆびのつめ": "ظفر الإبهام (ظفر إصبع الإبهام)",
 "おやゆびひめ": "ثُومْبِلِينَا",
 "おやクラス": "فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "おやチャ": "تَاجِر, تَاجِرَة",
 "おやプログラム": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "おゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "おゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "およぎ": "سِبَاحَة",
 "およぎて": "سَبَّاح, عَوَّام",
 "およぐ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق)\nمثال: سبح مع الدلافين.",
 "およし": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "およそ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / عُمُومًا / تَمَامًا / لَخَّصَ, اِخْتَصَرَ",
 "およばない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "および": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "およびごし": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة)",
 "およびじゃない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "およびでない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "およびもつかない": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "およびもつかぬ": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "およぶ": "بَلَغَ / مُنْتَجَع / اِقْتَضَى, تَطَلَّبَ",
 "およぼす": "تَمْرِين, تَدْرِيب",
 "およめさん": "زَوْجَة, اِمْرَأَة",
 "およる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "およろこび": "حدث سعيد (الولادة الحية لطفل)",
 "おら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おらあ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おらおら": "اِنْتِهَازِيّ, مُلِحّ (يتسم بطموح عدواني ونشاط ومبادرة)",
 "おらぶ": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)",
 "おらんだがらし": "قُرَّة, حُرْف",
 "おり": "فُرْصَة / طي (عملية الطي)\nمثال: قام بطي المناديل طية مزدوجة / قَفَص / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / نَسَجَ / تُفْل / مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه) / ترك, هجران (فعل الهجر أو التخلي)",
 "おりあい": "اِتِّفَاق, تَوَافُق / عَلَاقَة, مُنَاسَبَة",
 "おりあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "おりあげ": "جون, خليج صغير (مدخل مائي صغير)",
 "おりあしく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "おりいって": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "おりいと": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها)\nمثال: خيط من الخرز",
 "おりえり": "طَيَّة",
 "おりおり": "أَحْيَانًا",
 "おりかえし": "طَيَّة / رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة) / كَوْرَس, كُورَس / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "おりかえしちてん": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "おりかえしてん": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "おりかえす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "おりかばん": "حَقِيبَة, مِحْفَظَة",
 "おりから": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "おりがみ": "أُورِيغَامِي, طَيّ اَلْوَرَق / بصمة, سمة فارقة (سمة أو صفة مميزة لشخص أو شيء ما)",
 "おりがみつき": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "おりがみをつける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "おりき": "مِنْسَج / بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "おりく": "قصيدة استهلالية, قصيدة الحروف الأوائل (شعر تشكل فيه أحرف معينة، مثل الحرف الأول في كل سطر، كلمة أو رسالة)",
 "おりくち": "قِمَّة",
 "おりぐち": "قِمَّة",
 "おりけい": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "おりこ": "نَسَّاج, نَسَّاجَة",
 "おりこう": "نَسَّاج, نَسَّاجَة / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "おりこうさん": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "おりこみ": "أَدْخَلَ / إدماج, دمج (التضمين عن طريق الدمج)",
 "おりこみずみ": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "おりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / أَدْخَلَ / يحساب حساب",
 "おりしき": "جثو, ركوع (دعم نفسك على ركبتيك)",
 "おりしく": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "おりしも": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "おりじ": "مَلْمَس / قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "おりそう": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "おりたたみ": "طي (عملية الطي)\nمثال: قام بطي المناديل طية مزدوجة",
 "おりたたみいんさつぶつ": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "おりたたみき": "مِلَفّ, مُجَلَّد",
 "おりたたみしき": "قَابِل لِلطَّيّ (يمكن طيّه وتخزينه)",
 "おりたたみナイフ": "مِطْواة",
 "おりたたみ印刷物": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "おりたたむ": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "おりちょう": "رَزْمَة صَغِيرَة, مَلْزَمَة وَرَق (كمية من الورق؛ 24 أو 25 ورقة)",
 "おりづるらん": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة…)",
 "おりど": "باب أكورديون, باب قابل للطي (باب داخلي يفتح عن طريق الطي للخلف في أقسام (بدلاً من التأرجح على مفصلات))",
 "おりどころ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "おりにふれて": "بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "おりば": "انخفاض, تراجع (تغير نحو الأسفل)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "おりひめ": "اَلنَّسْر اَلْوَاقِع",
 "おりふし": "أَحْيَانًا",
 "おりまげる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "おりめ": "مَلْمَس / طَوَى / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "おりめただしい": "حَسَنُ الأَخْلَاقِ, مُؤَدَّب (صحيح السلوك اجتماعياً)",
 "おりもあろうに": "أبداً, على الإطلاق (في أي وقت)\nمثال: هل دخنت من قبل؟",
 "おりもの": "إفراز مهبلي (إفرازات من غدد عنق الرحم للمهبل؛ عادة ما تكون صافية أو بيضاء) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…) / خَلَاص / نسيجي (من أو متعلق بالأقمشة أو صناعة النسيج)\nمثال: بحث نسيجي",
 "おりものしょう": "بَزَّاز",
 "おりもののみみ": "برسل, حاشية القماش (حافة القماش المنسوجة بحيث لا تنسل أو تتآكل)",
 "おりゃる": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おりよく": "لِحُسْن اَلْحَظّ",
 "おりる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / تَقَاعَدَ / صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "おりわるく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "おる": "نَسَجَ / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / طَوَى / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / قَاطَعَ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "おるすになる": "أَهْمَلَ",
 "おれ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / طَوَى",
 "おれあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "おれい": "شُكْرًا / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / قَوْس, قوس / مُكَافَأَة, ثَوَاب",
 "おれいにはおよびません": "عَفْوًا",
 "おれおんな": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おれかえる": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "おれがおれが": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "おれきれき": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "おれくち": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "おれさま": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "おれし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おれせん": "بشكل متعرج (في مسار متعرج أو على طريق متعرج)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "おれたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "おれっこ": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おれっち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おれまがる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "おれめ": "طَوَى",
 "おれら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "おれ合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "おれ女": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おろ": "سائل النفاس, هُلاب (مادة تفرز من المهبل (حطام خلوي ومخاط ودم) وتتناقص تدريجياً في الكمية خلال…) / بشكل غير كامل, ناقصاً (ليس لدرجة كاملة أو تامة)\nمثال: كلمات مفهومة بشكل غير كامل",
 "おろおろ": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "おろか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / نَاهِيكَ عَن, هٰذَا عَدَا عَنْ / متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "おろかしい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おろかにも": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "おろかもの": "مُغَفَّل, أَحْمَق",
 "おろか者": "مُغَفَّل, أَحْمَق",
 "おろし": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / مِبْشَرَة / إِجْمَالِيّ, بِالْجُمْلَةِ",
 "おろしうり": "إِجْمَالِيّ, بِالْجُمْلَةِ",
