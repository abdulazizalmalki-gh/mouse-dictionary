 "きっこうきん": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "きっこうやく": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "きっさ": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "きっさう": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "きっさき": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "きっしょい": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きっしょう": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "きっしょく": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "きっしょー": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きっす": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "きっすい": "صَافٍ, اَلصَّافِي",
 "きっする": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "きっせき": "تَأْنِيب, عَذَل / أَنَّبَ, أَلَامَ (أَنَّبَهُ: وبَّخهُ وعنَّفَهُ ولامه، أو بالغ في ذلك؛ يقال فلان لا ينفع فيه تأنيب ولا تأديب)",
 "きっそう": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "きったはった": "عَنِيف",
 "きっちり": "بِالضَّبْط, تَمَامًا / بِالْضَبْط / بِإِتْقَان, تَمَامًا / كَمَا يَجِب, كَمَا يَنْبَغِي",
 "きって": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "きってすてる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "きってもきれない": "صَحِيح / تَكَامُلِيّ",
 "きっと": "بِالتَّأْكِيد / ضَيِّق / فَجْأَةً",
 "きっぱし": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "きっぱん": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "きっぷ": "تَذْكِرَة / تذكرة",
 "きっぷうりば": "تَذْكِرَة / تذكرة",
 "きっぽう": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "きつ": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "きつい": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / ضَيِّق / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "きつえん": "تَدْخِين",
 "きつえんしゃ": "مُدَخِّن, مُدَخِّنَة",
 "きつおん": "تَلَجْلَجَ, تَلَعْثَمَ",
 "きつおんしょう": "تَأْتَأَة, تَمْتَمَة",
 "きつけ": "غِيَار, رِبَاط / مَرَقَة, صَلْصَة (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / دَمَال / تَلَبُّس, تَرَدٍّ / لِبَاس (الزِيّ أو بعض الثياب تُلْبَس مع بعض لا جمع له؛ ما يُلْبَس من الثياب، الجمع ألْبِسَة)\nمثال: أحسن زيري اللباس.",
 "きつけぐすり": "مُنَشِّط, مُنَبِّه / كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "きつける": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "きつぜん": "شَاهِق",
 "きつね": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "きつねざる": "لَيْمُور",
 "きつねなす": "عُشَر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "きつねのこはつらじろ": "الْوَلَدُ سُرّ أَبِيهِ",
 "きつねのてぶくろ": "قِمَعِيَّة",
 "きつぷ": "تَذْكِرَة / تذكرة",
 "きつりつ": "شَاهِق",
 "きつ音": "تَلَجْلَجَ, تَلَعْثَمَ",
 "きづかい": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "きづかれ": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "きづき": "وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "きづく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "きづくり": "بُسْتَانِيّ, بُسْتَانِيَّة",
 "きづけ": "عِنَايَة, رِعَايَة",
 "きづな": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / غُلّ, أَغْلال",
 "きづま": "فُكَاهَة, دُعَابَة / مِزَاج / خِلْط, أَخْلَاط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "きづまり": "غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きづまをあわす": "تَمَلَّقَ",
 "きてい": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / قَاعِدَة, أَسَاس",
 "きていしゅもく": "إِجْبَارِيّ, إِلْزَامِيّ",
 "きていど": "الحَالَة الطَبِيعِيَّة",
 "きていのうど": "الحَالَة الطَبِيعِيَّة",
 "きてれつ": "فَرْدِيّ",
 "きてん": "اِتِّجَاه سَمَاوِيّ, جِهَة أَصْلِيَّة",
 "きでん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "きと": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "きとう": "أُسْطُوَانَة",
 "きとうかん": "إِكْلِيل الْحَشَفَة",
 "きとうきゅう": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "きとうし": "شَامَان, كَاهِن",
 "きとうしつ": "مُصَلًّى (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد) / خِطَابَة",
 "きとく": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله. / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "きど": "سُطُوع",
 "きどあいらく": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "きどう": "مُنَاوَرَة, تَدْرِيب عَسْكَرِيّ / مُنْتَقِل / مُتَنَقِّل",
 "きどうえんしゅう": "مُنَاوَرَة, تَدْرِيب عَسْكَرِيّ",
 "きどうがわ": "مُبَادِر",
 "きどうたい": "شُرطةُ مُكافَحةِ الشَغَب",
 "きどく": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله. / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "きどった": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "きどばん": "بَوَّاب, حَاجِب",
 "きどり": "تَصَنُّع, تَكَلُّف",
 "きどりや": "مُتَعَالٍ, المُتَعَالِي",
 "きない": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "きないモード": "وضع الطيران, وضع الطائرة (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "きなが": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "きなきな": "مِمْسَحَة",
 "きなくさい": "صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر / مُريب, مَشبوه",
 "きなる": "فَرْدِيّ",
 "きなん": "خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "きなんしっそう": "اِخْتِفَاء",
 "きな臭い": "صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر / مُريب, مَشبوه",
 "きに": "رَهَج أَصْفَر / تَزْيِيف",
 "きにいり": "مُفَضَّل",
 "きにいる": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "きにする": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "きにそむ": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "きにち": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "きになる": "عَجَب / تَسَاءَلَ (القوم: سَألوأ بعضهم بعضا؛ المرء: سَألَ نفسه مرة بعد مرة)\nمثال: قطة؟ تساءل الرجل العجوز.",
 "きにめす": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "きにやむ": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "きにゅう": "إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل\nمثال: この紙に記入するのを手伝ってください。 — الرجاء مساعدتي في ملء هذا النموذج.",
 "きにゅうらん": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "きにん": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "きぬ": "حَرِير, إبْرِيسِم",
 "きぬけ": "خُمُول",
 "きぬげねずみ": "قَدَاد / هَامِسْتَر",
 "きぬさらぎ": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "きぬたこつ": "سَنْدان, سِنْدَان",
 "きぬた骨": "سَنْدان, سِنْدَان",
 "きぬのみち": "طَرِيق اَلْحَرِير (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "きぬをさくよう": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "きね": "مِدَقَّة, يَد",
 "きねずみ": "سِنْجَاب",
 "きねん": "صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ",
 "きねんかん": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "きねんさい": "عِيد سَنَوِيّ / يُوبِيل",
 "きねんすべき": "جَسِيم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "きねんぞう": "نُصُب, مَعْلَم تَذْكَارِيّ",
 "きねんひん": "تَذْكار",
 "きねんび": "عِيد سَنَوِيّ / يُوبِيل",
 "きねんぶつ": "تَذْكار",
 "きのあらい": "عُدْوَانِيّ / هُجُومِيّ",
 "きのう": "وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "きのうかくちょう": "تَمْدِيد",
 "きのうご": "كَلِمَة وَظِيفِيَّة (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "きのうてき": "عَوْدِيّ",
 "きのおおきい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "きのかわ": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "きのきいた": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "きのきく": "مُنْتَبِه / شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "きのしれた": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "きのちいさい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "きのとおくなる": "دَائِخ / غَالِب",
 "きのどく": "فَقِير / مِسْكِين / فُقَرَاء",
 "きのどくにおもう": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "きのながい": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "きのぬけた": "مُسَطَّح",
 "きのは": "وَرَقَة, وَرَقة / صَحِيفَة",
 "きのはやい": "مُتَسَرِّع",
 "きのままで": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "きのまよい": "خِدَاع, ضَلَالَة / غَرُور",
 "きのみ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "きのよわい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "きのり": "فَائِدَة",
 "きのりしない": "تعوزه الحماسَة, مفتقر إلى الحماسَة",
 "きはく": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "きはずかしい": "مُحْرَج, بِٱلْحَرَج",
 "きはたしか": "عَاقِل (من له عَقْل يعقل به، يطلق على الإنسان وغيره إن كان يعقل؛ ذو النُهَى والرَأي السديد. هذه من الألفاظ التي يستوي فيها الذكر والأنثى)\nمثال: لا عاقل يفعل ذلك.",
 "きはだ": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "きはつゆ": "بَنْزِين, بِنْزِين",
 "きはん": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "きば": "نَاب (مَثَّل مكان أحد ما، كان نَائِبا عنه)\nمثال: كم يكلف ناب الفيل؟",
 "きばく": "تَفْجِير",
 "きばくざい": "مُمْتَاز, فَاخِر / زِنَاد",
 "きばたらき": "حِسّ, لَبَاقَة (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة.",
 "きばだち": "مَوْقِف حِصَان",
 "きばつ": "مُسْتَجِدّ / رِوَايَة",
 "きばなすずしろ": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "きばむ": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "きばむしゃ": "غَيْر مُكْتَرِث (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きばらし": "اِسْتِجْمَام",
 "きばる": "سُلَالَة",
 "きばん": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ",
 "きひ": "تَجَنُّب (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري / تَحَدٍّ, التَّحَدِّي",
 "きひん": "أَنَاقَة",
 "きひんのある": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "きび": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "きびきび": "بخفَة",
 "きびしい": "صَارِم / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / شَدِيد",
 "きびしさ": "صَرَامَة",
 "きびす": "عَقِب, كَعْب / كَعْب",
 "きびすをかえす": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "きびすを返す": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "きびわるい": "غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きびん": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "きふ": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "きふう": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "きふきん": "تَبَرُّع, هِبَة",
 "きふく": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "きふじん": "رَبَّة, رَبَّةْ اَلْبَيْت / خَاتُون, سَيِّدَة / لِيدِي",
 "きふほう": "تَدْوِين مُوسِيقِيّ",
 "きぶ": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "きぶく": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "きぶしょう": "كَسَل",
 "きぶつ": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد. / نَفَّذَ (نَفَذَ: من النّفَاذ وهو جَوَازُ الشيء من الشيء، والخُلُوصُ منه) / نَجَزَ / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: نفذ منا شيء ما.",
 "きぶん": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "きぶんてんかん": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "きへい": "فَارِس, سِلَاح الفُرْسَان (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "きへいたい": "فَارِس, سِلَاح الفُرْسَان (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "きへん": "خِدَاع, خَدْع",
