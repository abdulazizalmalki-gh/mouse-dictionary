 "おだい": "تُهْمَة\nمثال: أقوم بشحن هاتفي / سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ) / مَوْضُوع",
 "おだいじに": "تَوَخَّى اَلْحِذْر\nمثال: くれぐれもお体をお大事に。 — اعتنِ بنفسك.",
 "おだいばん": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "おだいもく": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "おだく": "تَلْوِيث, تَلَوُّث",
 "おだちん": "مُكَافَأَة, ثَوَاب",
 "おだて": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "おだてる": "تَمَلَّقَ, تَبَصْبَصَ",
 "おだぶつ": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "おだやか": "هَادِئ / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "おだんご": "كَعْكَة الشَّعْر (لفة من الشعر توضع عند مؤخرة العنق)",
 "おだんごあたま": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز…)\nمثال: خبزت كعكة لتوم.",
 "おだんごヘア": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز…)\nمثال: خبزت كعكة لتوم.",
 "おち": "اِنْزَلَقَ / أثر, عاقبة (ظاهرة تتبع وتنتج عن ظاهرة سابقة)\nمثال: كان التأثير المغناطيسي أكبر عندما كان القضيب بالطول / نُكْتَة",
 "おちあう": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "おちいりやすい": "سَاجِد, مُنْكَبّ (مستلقٍ على الوجه متَّجهاً للأسفل)",
 "おちいる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "おちおち": "بِهُدُوء",
 "おちかづき": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "おちかづきになる": "تَعَرَّفَ",
 "おちくぼむ": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "おちぐち": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / فَم, بق / فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "おちこち": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "おちこぼれ": "بعثرة, نثر (عملية البعثرة) / الْبَقَايَا / مُتَسَرِّب (شخص يترك المدرسة قبل التخرج)",
 "おちこぼれる": "تَأَخَّرَ / قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "おちこみ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُنْخَفَض",
 "おちずか": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")",
 "おちついた": "هَادِئ / ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر)\nمثال: بدو؛ اندمجوا بين الناس المستقرين / غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "おちつき": "هُدُوء / اِسْتِقْرَار",
 "おちつく": "أَهْدَأَ, هَدَّأَ / هَدَأَ\nمثال: استقر زيري في خيمته. / مُبَارَاة",
 "おちつける": "صَامِت, هَادِئ",
 "おちど": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "おちのひと": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك…)",
 "おちのびる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "おちばいろ": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة)",
 "おちむしゃ": "هَارِب",
 "おちものパズルゲーム": "لَعْبَةْ فِيدِيُو (اللَعْبَة البَرْبَرية دواء عشبيّ)",
 "おちゃ": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك. / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / سَادُو, طُقُوس اَلشَّاي",
 "おちゃかい": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)",
 "おちゃっぱ": "وَرَقَةْ اَلشَّاي, أَوْرَاق اَلشَّاي",
 "おちゃっぴい": "ثَرْثَار",
 "おちゃのこ": "بَسِيطَة, لُقْمَة سَائِغَة",
 "おちゃのこさいさい": "بَسِيطَة, لُقْمَة سَائِغَة",
 "おちゃのま": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "おちゃめ": "دَاعِب, لَعُوب / جُوكَر",
 "おちゃや": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ…)\nمثال: هذا المقهى مريح.",
 "おちゃらかす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "おちゃをにごす": "لَفَّ وَدَارَ",
 "おちゆく": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ\nمثال: استقر زيري في خيمته.",
 "おちょくる": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "おちょける": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "おちり": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما.",
 "おちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "おちんちん": "قَضِيب, ذَكَر",
 "おっ": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "おっかあ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مالكة (امرأة مالكة) / كَهْل",
 "おっかけ": "طَارَدَ / مُعْجَبَة (معجبة شابة متحمسة (خاصة التي تتبع فرق الروك)) / قَرِيبًا, سَرْعَانَ مَا",
 "おっかける": "طَارَدَ",
 "おっかさん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "おっかない": "مُجَفِّل, مُخِيف / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "おっかなびっくり": "بخوف (مع شعور بالخوف)\nمثال: هرعت أسفل الدرج بخوف",
 "おっかぶさる": "غِطَاء",
 "おっかぶせる": "غِطَاء",
 "おっかー": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)",
 "おっきい": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おっきな": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おっくう": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "おっけ": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / غَرَامَة",
 "おっけい": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / غَرَامَة",
 "おっけん": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "おっけー": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / غَرَامَة",
 "おっこ": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / خَلِيل, رَفِيق\nمثال: ليس لديه صديقة. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "おっこう": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "おっこちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "おっことす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "おっこる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "おっさん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً) / عجوز متصابي (رجل في منتصف العمر ذو ميول شهوانية)",
 "おっしゃる": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / سُمِّيَ",
 "おっせぇ": "بَطِيء / مُتَأَخِّر",
 "おっせえ": "بَطِيء / مُتَأَخِّر",
 "おっせー": "بَطِيء / مُتَأَخِّر",
 "おっそい": "بَطِيء / مُتَأَخِّر",
 "おっそーい": "بَطِيء / مُتَأَخِّر",
 "おった": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة))",
 "おったつ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "おったてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "おっちぬ": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "おっちゃん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "おっちょこちょい": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "おっちん": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "おっちんとん": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "おっつく": "بَلَغَ",
 "おっつけ": "قَرِيبًا, سَرْعَانَ مَا",
 "おって": "مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل / بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "おってがき": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "おっと": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة! / فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر…)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "おっとせい": "فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر…)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "おっとっと": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "おっとり": "بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: قبلته بخفة على جبينه",
 "おっはあ": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おっはー": "صَبَاح الْخَيْر, صَبَاح النُّور",
 "おっぱ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "おっぱい": "ثَدْي / حليب الأم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب…)\nمثال: كنت أشرب الحليب",
 "おっぱいをあげる": "أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع…)",
 "おっぱいアイス": "آيس كريم طري, كاسترد مجمد (تحلية تشبه الآيس كريم ولكن بقاعدة من الكاسترد المغلي)",
 "おっぱじめる": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "おっぱらう": "طَرَدَ",
 "おっぴら": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "おっぴらく": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "おっぴろげる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / مَفْتُوح\nمثال: فتح الباب آليا.",
 "おっほん": "نحنحة (إصدار صوت مشابه لتنظيف الحلق؛ يهدف لجذب الانتباه، أو التعبير عن التردد، أو ملء…)",
 "おっぽ": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب.",
 "おっぽりだす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "おっぽり出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "おっもしれー": "مُضْحِك, هَزْلِيّ",
 "おっ始める": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "おっ広げる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / مَفْتُوح\nمثال: فتح الباب آليا.",
 "おっ放り出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "おっ死ぬ": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "おっ母": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مالكة (امرأة مالكة) / كَهْل",
 "おっ母さん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "おっ立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "おっ立てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "おっ開く": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "おつ": "ثَانٍ, تاني\nمثال: لن أفعلها ثانية. / أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية)\nمثال: ملابس عصرية / غَرِيب, عَجِيب / شُكْرًا, تِسْلَم / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "おつあり": "شُكْرًا, تِسْلَم",
 "おつうじ": "حَرَكَة",
 "おつかい": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية)\nمثال: あの子はよくお使いをする。 — غالبًا ما يقوم الصبي بالمشاوير / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة)",
 "おつかれ": "شُكْرًا / أراكَ قَريبًا, سَلَام / إِرْهَاق, تَعَب",
 "おつかれさま": "شُكْرًا, تِسْلَم\nمثال: 「おさきにしつれいします」「おつかれさまでした」 — انهيت عملي اليوم ،و مقر بالجميل. / أراكَ قَريبًا, سَلَام",
 "おつかれサマンサ": "شُكْرًا, تِسْلَم",
 "おつき": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان)",
 "おつきあい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "おつきさま": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "おつぎ": "قَادِم\nمثال: زيري بجانب الحوض.",
 "おつくり": "سَاشِيمِي / تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "おつけ": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "おつげ": "كَاهِن, عَرَّاف",
 "おつげのしゅくじつ": "25 مارس, عيد البشارة (مهرجان يحيي ذكرى إعلان التجسد من قبل الملاك جبرائيل للسيدة العذراء مريم؛ يوم…)",
 "おつしゅ": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "おつじゅん": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "おつとめ": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "おつねん": "إِسْبَات",
 "おつぼう": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض…)",
 "おつぼね": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "おつまみ": "وَجْبَة خَفِيفَة, لُمْجَة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "おつむ": "رَئِيس, رَئِيسَة / دِمَاغ",
 "おつや": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "おつゆ": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "おつり": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "おつれ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "おて": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "おてあげ": "ترك, هجران (فعل الهجر أو التخلي)",
 "おてあらい": "مِرْحَاض, تواليت\nمثال: お手洗いはどこですか。 — أين الحمّام؟",
 "おてかず": "مُشْكِلَة, مَتاعِب",
 "おてすう": "مُشْكِلَة, مَتاعِب",
 "おてだま": "كيس حبوب, كيس فول (كيس قماشي صغير مملوء بالحبوب المجففة؛ يُرمى في الألعاب)",
 "おてつき": "سَيِّدَة / مُخَالَفَة",
 "おてつだい": "خَادِمَة, خَدامَة / مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "おてつだいさん": "خَادِمَة, خَدامَة",
 "おてて": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة.",
 "おてふき": "مِنْشَفَة",
 "おてほん": "نَمُوذَج",
 "おてまえ": "مَهَارَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おてもと": "أَعْوَاد الْأَكْل, هَاشِي",
 "おてもときん": "المخصصات الملكية (بدل للنفقات الشخصية للملك)",
 "おてやわらか": "مُؤَدَّب",
 "おてやわらかに": "بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: قبلته بخفة على جبينه",
 "おてら": "مَعْبَد / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "おてらさま": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "おてらさん": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "おてん": "بُقْعَة",
 "おてんき": "طَقْس, جَوّ\nمثال: いいお天気ですね。 — إنه يوم جميل. / مَزَاج",
 "おてんとうさま": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…) / بروفيدنس",
 "おてんとさま": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…) / بروفيدنس",
 "おてんば": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おてんばむすめ": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おてんば娘": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おでい": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / جَهَنَّم, جَحِيم",
 "おでかけ": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "おでき": "دُمَّل, خُرَاج",
 "おでこ": "حَاجِب (قوس الشعر فوق كل عين)\nمثال: غربت الشمس خلف قمة التلال البعيدة",
 "おでまし": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "おでんわ": "مُكَالَمَة / هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "おと": "سليم\nمثال: اقرأ بصوت عالي. / مُلَاحَظَة, مَلْحُوظَة / شُهْرَة / أَخ الْأَصْغَر, أَخ الصَّغِير / صَغِير, حَدَث / فَاتِن, قَشِيب",
 "おとあわせ": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "おといあわせ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "おとう": "بَابَا",
 "おとうさま": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "おとうさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おとうちゃん": "بَابَا",
 "おとうと": "أَخ الْأَصْغَر, أَخ الصَّغِير / شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "おとうとぎみ": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "おとうとごろし": "قتل الأخ, قتل الشقيق (قتل الشخص لأخيه أو أخته)",
 "おとうとさん": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "おとおし": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة…)",
 "おとおしだい": "رسم الدخول, رسم خدمة المطعم (رسم ثابت يفرضه مطعم أو ملهى ليلي بالإضافة إلى رسوم الطعام والشراب)",
 "おとおじ": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "おとおり": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "おとがい": "فَكّ / ثَرْثَار",
 "おとがめなし": "تَبْرِئَة",
 "おとぎ": "خادِم, مُعْتَنٍ (يُقَدِّم مُساعَدَة عَمَلِيَّة ورِعايَة) / قِصَّة خُرَافِيَّة, خُرَافَة",
 "おとぎのくに": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور)",
 "おとぎの国": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور)",
 "おとぎばなし": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "おとぎ話": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "おとく": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي / مُفِيد, نَافِع / تَجْدِيف",
 "おとこ": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / خَلِيل, رَفِيق\nمثال: ليس لديه صديقة. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "おとこあるじ": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "おとこおや": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "おとこおんな": "بَيْنَ جِنْسِيّ (ذو خصائص جنسية وسيطة بين الذكورة والأنوثة)",
 "おとこがたつ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "おとこきょうだい": "أَخ\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "おとこぎ": "مُرُوءَة",
 "おとこくい": "غَاوِيَة",
 "おとこくさい": "رُجُولِيّ",
 "おとこぐい": "غَاوِيَة",
 "おとこぐるい": "إباحية, خلاعة (صفة الفسق والمجون)\nمثال: رقصت بجموح",
 "おとこごろし": "فاتنة, مغوية (امرأة تعتبر مغرية بشكل خطير)",
 "おとこし": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / خادم رجل (خادم من الرجال)",
 "おとこしゅ": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / خادم رجل (خادم من الرجال)",
 "おとこしゅう": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / خادم رجل (خادم من الرجال) / مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "おとこたち": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "おとこたらし": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "おとこっぷり": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "おとこっぽい": "رُجُولِيّ",
 "おとこで": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "おとこでひとつで": "بجهد فردي, بمفرده (دون مساعدة)\nمثال: بنيت هذا المنزل بمفردي",
 "おとこどうし": "بصراحة, كرجل لرجل (بشكل مباشر أو صريح)\nمثال: يجب أن نتحدث كرجل لرجل",
 "おとこなき": "بَاكٍ",
 "おとこのこ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى. / شاب (مراهق أو شاب بالغ ذكر) / وَلَد مُخَنَّث, فِمْبُوي (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "おとこのなかのおとこ": "أَلْفَا, حَيَوان أَلْفَا",
 "おとこのひと": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "おとこの娘": "وَلَد مُخَنَّث, فِمْبُوي (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "おとこぶり": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "おとこまえ": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))\nمثال: 彼はなかなかの男前だ。 — إنه وسيم. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "おとこまさり": "قَوِيُّ الإِرَادَة (يَتَّسِمُ بِاسْتِقْلَالِيَّةٍ قَوِيَّةٍ فِي الفِكْرِ وَالحُكْم)",
 "おとこみがき": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "おとこむすび": "عقدة مربعة (عقدة مزدوجة مصنوعة من عقدتين نصفيتين وتستخدم لربط نهايات حبلين)",
 "おとこもじ": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "おとこもち": "حمام الرجال (مرحاض عام للرجال)",
 "おとこもの": "حمام الرجال (مرحاض عام للرجال)",
 "おとこやもめ": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة. / أَعْزَب, عَازِب",
 "おとこらしい": "رُجُولِيّ",
 "おとさた": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من…)\nمثال: هذه أخبار طيبة.",
 "おとし": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي. / سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تَنْظِيف / فَخّ, مِصْيَدَة / نَتِيجَة",
 "おとしあな": "حفرة, فخ (فخ على شكل حفرة مخفية)",
 "おとしいれる": "فَخّ, مِصْيَدَة / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "おとしがき": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "おとしがみ": "وَرَق مِرْحَاض, وَرَق حَمَّام (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "おとしこうし": "بوابة منزلقة (بوابة تتكون من شبكة حديدية أو خشبية تتدلى في مدخل قلعة أو مدينة محصنة؛ يمكن…)",
 "おとしこむ": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おとしご": "مُنْتَج",
 "おとしたまご": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من…)\nمثال: ياني يحب البيض.",
 "おとしだね": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "おとしだま": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "おとしだまキャンペーン": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "おとしどころ": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "おとしまえ": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "おとしより": "عجوز, كبير السن (شخص متقدم في السن)",
 "おとす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه. / نَقَلَ\nمثال: لا أزال عطشانا. / فَقَدَ\nمثال: خسر توم وظيفته. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى.",
 "おとずれ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / وُصُول, وِفَادَة / أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من…)\nمثال: هذه أخبار طيبة.",
 "おとずれる": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "おとそ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "おとっさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おとっつぁん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "おとっつあん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "おとと": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "おととび": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض)\nمثال: تقدم بسلسلة من القفزات",
 "おとど": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "おとどけ": "تَوْصِيل, تَسْلِيم\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "おとどけさき": "وِجْهَة, وُجْهَة",
 "おとどけずみ": "نَقَلَ / مُبَلَّغ عَنْه, مُقَرَّر (تم جعله معروفاً أو التحدث عنه؛ خاصة تقديمه في حساب رسمي)\nمثال: رأيه المبلغ عنه (المنقول)",
 "おとどけや": "مُسَلِّم, مُوَصِّل (شخص يسلم أو ينقل أموالاً أو بضائع)",
 "おとどり": "تسجيل صوتي (تسجيل للإشارات الصوتية)",
 "おとなう": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "おとなかわいい": "بَالِغ",
 "おとなげ": "نَضْج",
 "おとなげない": "غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "おとなし": "صَمْت, سُكُوت",
 "おとなしい": "مُؤَدَّب / صَامِت, هَادِئ",
 "おとなしく": "بتواضع (بطريقة متواضعة)\nمثال: خفض رأسه بتواضع",
 "おとなしやか": "مُؤَدَّب",
 "おとなじみた": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر)\nمثال: طفل نابغ",
 "おとなじみる": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "おとなじょし": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "おとなっぽい": "بَالِغ",
 "おとなになる": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "おとなのおもちゃ": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "おとなのおもちゃや": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "おとなびる": "نَاضِج, رَاشِد",
 "おとなりさん": "جَار, جَارة (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل…)\nمثال: لدي جارة مسلمة.",
 "おとのかべ": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة…)",
 "おとのさま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "おとまり": "مَكَثَ, بَقِيَ",
 "おとまりかい": "حفلة مبيت, مبيت (مناسبة قضاء ليلة بعيداً عن المنزل أو استضافة ضيف للمبيت (خاصة كحفلة للأطفال))",
 "おとまりほいく": "حَضَانَة, رَوْضَة",
 "おとめ": "بِنْت\nمثال: أنا أري الفتاة.",
 "おとめあぜな": "الخط البراهمي (خط (من المحتمل أنه مقتبس من الآرامية حوالي القرن السابع قبل الميلاد) تطورت منه…)",
 "おとめご": "بِنْت\nمثال: أنا أري الفتاة.",
 "おとめざ": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おとめチック": "بَنَاتِيّ",
 "おとめ座": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おとも": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "おともだち": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "おともなく": "بِهُدُوء",
 "おとり": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おとりしょうほう": "إغراء واستبدال (طريقة خادعة للبيع تتضمن الإعلان عن منتج بسعر منخفض جداً لجذب العملاء ثم إقناعهم…)",
 "おとりそうさ": "عملية سرية, كمين (عملية مصممة للقبض على شخص يرتكب فعلاً إجرامياً)\nمثال: نفذت الشرطة عملية سرية",
 "おとりよせ": "ترتيب, نظم (فعل وضع الأشياء في ترتيب تسلسلي)\nمثال: كانت هناك أخطاء في ترتيب العناصر في القائمة",
 "おとり商法": "إغراء واستبدال (طريقة خادعة للبيع تتضمن الإعلان عن منتج بسعر منخفض جداً لجذب العملاء ثم إقناعهم…)",
 "おとり捜査": "عملية سرية, كمين (عملية مصممة للقبض على شخص يرتكب فعلاً إجرامياً)\nمثال: نفذت الشرطة عملية سرية",
 "おとる": "تَأَخَّرَ",
 "おとろえ": "إضعاف (عملية تقليل قوة شيء ما)",
 "おとろえる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "おとろしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / فَظِيع",
 "おとわれ": "قُلَامَة / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "おとん": "بَابَا",
 "おどおど": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "おどかし": "تَهْدِيد",
 "おどかす": "هَدَّدَ / فَاجَأَ, بَاغَثَ",
 "おどけ": "طُرْفَة, نُكْتَة",
 "おどけぐち": "طُرْفَة, نُكْتَة",
 "おどけしばい": "فُكَاهَة, كُومِيدِيَا",
 "おどけばなし": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "おどけもの": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おどける": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة)\nمثال: روى نكتة مضحكة جداً",
 "おどけ者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おどけ話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "おどし": "تَهْدِيد",
 "おどしつける": "هَدَّدَ",
 "おどしとる": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "おどしをかける": "هَدَّدَ",
 "おどす": "هَدَّدَ",
 "おどらす": "أَضَلَّ / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "おどらせる": "أَضَلَّ / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "おどり": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى) / مقتل, نقطة ضعف (مكان ذو قابلية خاصة للإصابة)\nمثال: كانت لديها معزة خاصة لابنها الأصغر / قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام)",
 "おどりうた": "بَالَاد",
 "おどりこ": "رَاقِص, رَاقِصَة",
 "おどりこそう": "قراص أبيض, لاميون أبيض (نبات قراص أوروبي ميت بزهور بيضاء)",
 "おどりじ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "おどりて": "رَاقِص, رَاقِصَة",
 "おどりでる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "おどりば": "صَالَةُ رَقْص (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ…)\nمثال: حجزت الصالة يوم الخميس. / هُبُوط / رُكُود",
 "おどる": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص. / وَثَبَ (طَفَرَ أو قَفَزَ وهو يجري) / بَاوْنْد",
 "おどれ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おどろ": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج)",
 "おどろいたことに": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة)\nمثال: كان ودوداً بشكل مفاجئ",
 "おどろおどろしい": "مُخِيف, مُوحِش (يُوحِي بِالخَوْف؛ غَرِيب وَمُرْعِب) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "おどろかす": "دَهْشَة, تَعَجُّب",
 "おどろかせる": "دَهْشَة, تَعَجُّب",
 "おどろき": "دَهْشَة, تَعَجُّب",
 "おどろくなかれ": "يَا لَلْعَجَبِ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "おどろくべき": "مُذْهِل",
 "おどろくほど": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة)\nمثال: كان ودوداً بشكل مفاجئ",
 "おどろく程": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة)\nمثال: كان ودوداً بشكل مفاجئ",
 "おなか": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "おなかいっぱい": "جرعة زائدة, طفح الكيل (وفرة مفرطة غير مرغوب فيها)\nمثال: جرعة زائدة من شكاويك",
 "おなががも": "بلبول شمالي",
 "おながざめ": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك…)",
 "おながれ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما)",
 "おなご": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "おなさけ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة. / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "おなしゃす": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "おなじ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها) / نَفْسَهُ, نَفْسَهَا / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "おなじい": "نَفْسَهُ, نَفْسَهَا",
 "おなじく": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها) / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "おなじみ": "مَأْلُوف / عَادِيّ",
 "おなじよう": "مُمَاثِل",
 "おなべ": "مِقْلَاة (وعاء قلي الطعام) / خادمة (عاملة منزلية)",
 "おなま": "صَفَاقَة, وَقَاحَة",
 "おなまえ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "おなみだちょうだい": "دَرَامَا مُؤَثِّرَة, قِصَّة مُبْكِيَة (سرد عاطفي مفرط)",
 "おなめ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "おなもみ": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في…)",
 "おなら": "رِيح, ريح",
 "おならをする": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في…)",
 "おなり": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "おなわ": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره)",
 "おに": "غُول, غَشِيم / هُوَ, هِيَ / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "おにあい": "صَيْرُورَة",
 "おにあそび": "زَقِيطَة",
 "おにいさん": "اَلْأَخ اَلْأَكْبَر / شاب (مراهق أو شاب بالغ ذكر)",
 "おにいちゃん": "اَلْأَخ اَلْأَكْبَر / شَابّ, فَتًى",
 "おにかます": "باراكودا كبيرة (باراكودا رمادية بنية كبيرة (تصل إلى 6 أقدام) تحظى بتقدير كبير كسمكة غذائية…)",
 "おにぎり": "أُونِيجِيرِي",
