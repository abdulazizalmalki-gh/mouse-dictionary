 "お涙ちょうだい": "دَرَامَا مُؤَثِّرَة, قِصَّة مُبْكِيَة (سرد عاطفي مفرط)",
 "お涙頂戴": "دَرَامَا مُؤَثِّرَة, قِصَّة مُبْكِيَة (سرد عاطفي مفرط)",
 "お淑やか": "رَشِيق, ظَرِيف",
 "お湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "お澄まし": "تزمت, تصنع (لياقة مبالغ فيها ومتغطرسة)",
 "お灸": "تأنيب, توبيخ (عقاب لفظي)",
 "お灸をすえる": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "お灸を据える": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "お爨": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "お爨どん": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "お父": "بَابَا",
 "お父さま": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "お父さん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "お父ちゃん": "بَابَا",
 "お父っつぁん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "お父ん": "بَابَا",
 "お父様": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "お爺さん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز\nمثال: おじいさんはその木の人形をピノキオと名づけました。 — سمّى الرجلُ المسنُّ الدميةَ الخشبيةَ \"بينوكيو\".",
 "お爺ちゃま": "جَدِّي",
 "お爺ちゃん": "جَدِّي",
 "お爺様": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز",
 "お猿さん": "سَعْدَان, قِرْد",
 "お玉": "مِغْرَفَة / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "お玉じゃくし": "مِغْرَفَة / شُرْغُوف (الضِفْدَعُ الصغير) / نغمة, نوتة (تدوين يمثل حدة ومدة صوت موسيقي)\nمثال: أمسك المغني بالنوتة لفترة طويلة جداً",
 "お玉杓子": "مِغْرَفَة / شُرْغُوف (الضِفْدَعُ الصغير) / نغمة, نوتة (تدوين يمثل حدة ومدة صوت موسيقي)\nمثال: أمسك المغني بالنوتة لفترة طويلة جداً",
 "お生": "صَفَاقَة, وَقَاحَة",
 "お生憎様": "آسِف / مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "お産": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد.",
 "お留守になる": "أَهْمَلَ",
 "お疲れ": "شُكْرًا / أراكَ قَريبًا, سَلَام / إِرْهَاق, تَعَب",
 "お疲れさま": "شُكْرًا, تِسْلَم\nمثال: 「おさきにしつれいします」「おつかれさまでした」 — انهيت عملي اليوم ،و مقر بالجميل. / أراكَ قَريبًا, سَلَام",
 "お疲れサマンサ": "شُكْرًا, تِسْلَم",
 "お疲れ様": "شُكْرًا, تِسْلَم\nمثال: 「おさきにしつれいします」「おつかれさまでした」 — انهيت عملي اليوم ،و مقر بالجميل. / أراكَ قَريبًا, سَلَام",
 "お白州": "مَحْكَمَة, عَدْلِيَّة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "お白洲": "مَحْكَمَة, عَدْلِيَّة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "お百姓さん": "فَلَّاح, فَلَّاحَة",
 "お皿": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "お盆": "بُون / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة…)\nمثال: هذه شركة صينية.",
 "お目": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة. / مَشْهَد",
 "お目々": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "お目こぼし": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "お目にかかる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "お目にかける": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "お目に掛かる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "お目に掛ける": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "お目付": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم) / كلب حراسة (كلب مدرب لحراسة الممتلكات)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "お目付け": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم) / كلب حراسة (كلب مدرب لحراسة الممتلكات)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "お目付け役": "كلب حراسة (كلب مدرب لحراسة الممتلكات)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "お目付役": "كلب حراسة (كلب مدرب لحراسة الممتلكات)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "お目玉": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "お目目": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "お目見え": "جُمْهُور, نَظَّارَة / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / وضع تحت المراقبة ((قانون) طريقة للتعامل مع الجناة دون سجنهم؛ حيث يطلق سراح المتهم المدان بشروط…)\nمثال: الوضع تحت المراقبة جزء من عملية إصدار الحكم",
 "お目通り": "جُمْهُور, نَظَّارَة",
 "お相子": "مُتَسَاوٍ, مُتَصَالِح (على قدم المساواة عن طريق الدفع أو الردّ)",
 "お相撲さん": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "お眠": "نوم (توقف الوعي وانخفاض معدل الأيض)",
 "お眼鏡": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "お知らせ": "لَاحَظَ",
 "お碗": "زِبْدِيَّة",
 "お礼": "شُكْرًا / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / قَوْس, قوس / مُكَافَأَة, ثَوَاب",
 "お礼には及びません": "عَفْوًا",
 "お祈り": "صَلَاة, دُعَاء",
 "お祈りメール": "إيميل, بريد إلكتروني ((علوم الكمبيوتر) نظام للاتصال الإلكتروني العالمي حيث يمكن لمستخدم الكمبيوتر…)\nمثال: لا يمكنك إرسال طرود بالبريد الإلكتروني",
 "お祓い": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "お祖母さん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "お祖母ちゃま": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة.",
 "お祖母様": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "お祖父さん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز\nمثال: おじいさんはその木の人形をピノキオと名づけました。 — سمّى الرجلُ المسنُّ الدميةَ الخشبيةَ \"بينوكيو\".",
 "お祖父ちゃま": "جَدِّي",
 "お祖父様": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز",
