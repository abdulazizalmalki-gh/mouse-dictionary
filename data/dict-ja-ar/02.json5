 "かざりがき": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "かざりけ": "تَصَنُّع, تَكَلُّف",
 "かざりけのない": "بَسِيط\nمثال: هذا الشعور سهل.",
 "かざりたてる": "جَمَّلَ, زَخْرَفَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "かざりだな": "خزانة عرض, فاترينة (حاوية زجاجية تستخدم لتخزين وعرض العناصر في متجر أو متحف أو منزل)",
 "かざりっけ": "تَصَنُّع, تَكَلُّف",
 "かざりつけ": "زينة",
 "かざりつける": "إِظْهَار, عَرْض",
 "かざりばね": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور)\nمثال: عمود من الدخان",
 "かざりまど": "شُبَّاك, فَاتْرِينَة",
 "かざりもの": "حِلْيَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية)",
 "かざる": "حِلْيَة / إِظْهَار, عَرْض / دَرَجَة\nمثال: الصهاينة أشر من النازيين. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "かざん": "بُرْكَان, جَبَلُ النَّار (فَتْحَةُ أَوْ فَوْهَةُ انْفجارٍ حَلَزونِيَّةُ الشَّكْلِ، تَكونُ في مَواقِعَ…)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "かざんがく": "علم البراكين (فرع الجيولوجيا الذي يدرس البراكين)",
 "かざんがん": "صخر بركاني (صخر ناري طافح تصلب بالقرب من سطح الأرض أو عليه)",
 "かざんだん": "قنبلة بركانية",
 "かざんふんか": "ثوران, ثوران بركاني (الحدوث المفاجئ لتفريغ عنيف للبخار والمواد البركانية)",
 "かざんガラス": "زجاج بركاني (نوع من الزجاج الطبيعي ينتج عندما تبرد الحمم المنصهرة بسرعة كبيرة)",
 "かし": "ضابط صفّ / استمرارية, طول نفس (قوة البقاء والاستمرار)\nمثال: تلك المسرحية القديمة في برودواي لديها استمرارية حقاً / مَنَحَ / حيوية معلقة (توقف مؤقت للوظائف الحيوية مع فقدان الوعي يشبه الموت؛ ناتج عادة عن الاختناق) / رُؤْيَة / ليبريتو, نص الأوبرا (كلمات أوبرا أو مسرحية موسيقية) / صناعة الحلويات, مهنة الحلواني (مهنة ومهارات صانع الحلويات)\nمثال: قررت الشركة التركيز على السكاكر والمشروبات الغازية / بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج…) / قَرْض, إِعَارَة / مَعْرُوف / دَائِن / عَيْبٌ / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي. / فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / ضفة النهر / مَيْدَان\nمثال: هذا المكان مقدس",
 "かしあたえる": "أَعَارَ, سَلَّفَ",
 "かしい": "بلوط هولم, سنديان أخضر (بلوط دائم الخضرة من جنوب أوروبا له أوراق تشبه إلى حد ما أوراق البهشية؛ ينتج…)",
 "かしか": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري) / تَسْجِيل",
 "かしかた": "دَائِن",
 "かしかん": "ضابط صفّ",
 "かしかんがっこう": "صف ضابط, ضابط صف (ضابط عسكري يتم تعيينه من المجندين)",
 "かしかんへい": "مجند (فرد ذكر مجند في القوات المسلحة)",
 "かしがましい": "صَارِخ, صاخِب",
 "かしきり": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かしきる": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かしきん": "قَرْض, إِعَارَة",
 "かしきんぎょうしゃ": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "かしきんこ": "صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
 "かしく": "اَلْمُخْلِص",
 "かしぐ": "اِنْحِدَار, زَاوِيَة المَيْل (درجة الانحراف عن المستوى الأفقي)\nمثال: كان للسقف انحدار حاد / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "かしげる": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد)\nمثال: كان للبرج ميل واضح",
 "かしこ": "هُنَاكَ / اَلْمُخْلِص / ذهني, عقلي (يخاطب أو يستخدم الفكر والعقل)\nمثال: السخرية سلاح فكري",
 "かしこい": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة. / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "かしこう": "ضوء, ضوء مرئي ((في الفيزياء) إشعاع كهرومغناطيسي يمكن أن ينتج إحساساً بصرياً)\nمثال: تم تصفية الضوء من خلال نافذة زجاجية ناعمة",
 "かしこうぼうえんきょう": "تلسكوب بصري (تلسكوب فلكي مصمم لجمع وتسجيل الضوء من المصادر الكونية)",
 "かしこくも": "بكياسة, بلطف (بطريقة لطيفة أو رشيقة)",
 "かしこし": "سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "かしこまった": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "かしこまりました": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "かしさげる": "أَعَارَ, سَلَّفَ",
 "かしざしき": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "かししぶり": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة…)",
 "かしじどうしゃ": "تأجير السيارات, سيارة مستأجرة (سيارة مستأجرة)\nمثال: استلمت سيارة مستأجرة من المطار وقادتها إلى فندقها",
 "かしずく": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "かしせい": "رُؤْيَة",
 "かしたい": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف…)",
 "かしだおれ": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "かしだおれきん": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "かしだし": "إعارة, إقراض (التصرف في المال أو الممتلكات مع توقع إعادة نفس الشيء (أو ما يعادله))",
 "かしだしけん": "بطاقة استعارة, بطاقة مكتبة (بطاقة تثبت حق حاملها في استخدام المكتبة)",
 "かしだしげんど": "سطر الكاتب (سطر يعطي اسم كاتب قصة أو مقال)",
 "かしだす": "أَعَارَ, سَلَّفَ",
 "かしちん": "أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة.",
 "かしつ": "وَرْنِيش / حَادِث\nمثال: لا تدعها للصدفة. / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي.",
 "かしつき": "مرطب هواء (جهاز مصمم لإضافة الرطوبة إلى الهواء في المبنى)\nمثال: يضمن مرطب الهواء مستوى الرطوبة المناسب للوحاتنا",
 "かしつけ": "قَرْض, إِعَارَة",
 "かしつけきん": "قَرْض, إِعَارَة",
 "かしつけざんだか": "رَصِيد سَالِب, رَصِيد مَدِين (رصيد حساب تتجاوز فيه الديون (المدفوعات) الاعتمادات (الإيداعات)، ويكون العميل…)",
 "かしつける": "أَعَارَ, سَلَّفَ",
 "かしつそうさい": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة…)",
 "かしつわりあい": "إهمال مشترك, إهمال نسبي ((قانون) إهمال موزع بين المدعي والمدعى عليه مع تخفيض مقابل في التعويضات المدفوعة…)",
 "かしづく": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "かして": "مُقْرِض",
 "かしてあげる": "أَعَارَ, سَلَّفَ",
 "かしてん": "حَلْوَانِيّ",
 "かしぬし": "مُقْرِض",
 "かしましい": "صَارِخ, صاخِب",
 "かしめ": "تَجْعِيدَة (خصلة شعر تم تمويجها أو تجعيدها صناعياً)\nمثال: طية في المنديل / ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح)\nمثال: انتهت المباراة بالتعادل",
 "かしめる": "تَجْعِيدَة (خصلة شعر تم تمويجها أو تجعيدها صناعياً)\nمثال: طية في المنديل",
 "かしもと": "خبير مالي, ممول (شخص ماهر في المعاملات المالية واسعة النطاق)",
 "かしもとがずるい": "دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ)",
 "かしもとがズルい": "دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ)",
 "かしゃ": "عربة شحن (عربة سكة حديد تنقل البضائع) / كاشا (حنطة سوداء مسلوقة أو مخبوزة) / قِطَار بُخَارِيّ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "かしゃかしゃ": "طقطقة (سلسلة من النقرات)",
 "かしゃく": "إِبْرَاء, إِعْفَاء / استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً / لَوْم, مَلَامَة",
 "かしゃくなき": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "かしゃわたし": "لِأَنَّ",
 "かしや": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
 "かしゅ": "مُطْرِب, مُغَنٍّ / عَطَشْجِيّ / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "かしゅう": "تَجْمِيعَة, دِيوَان / كتاب أغاني (كتاب يحتوي على مجموعة من الأغاني) / كَالِيفُورْنِيَا / وَاشِنْطُن, واشنتن",
 "かしゅひ": "آريل, غلاف البذرة اللحمي (غطاء لحمي وعادة زاهي الألوان لبعض البذور يتطور من ساق البويضة ويغلف البذرة…)",
 "かしょ": "مَيْدَان\nمثال: هذا المكان مقدس",
 "かしょう": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض. / زَهِيد, شَحِيح (ناقص في الكمية أو الحجم) / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية. / قاع النهر (قناة يشغلها (أو كان يشغلها) نهر) / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية / معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد)) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…) / سَيِّد\nمثال: يبدو زيري أحسن. / حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / فَاغِرَة / شبه, صورة مماثلة (صورة تتكون من تمثيل رسومي لشخص أو شيء)\nمثال: أمل أن يكون لادعاءاته مظهر من المصداقية / تكليس (تحويل المعادن إلى أكاسيدها نتيجة للتسخين إلى درجة حرارة عالية) / فَسَاد / حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "かしょうてんきょり": "مَسَافَة بُؤْرِيَّة مُفْرِطَة, مَسَافَة فَرْط البُؤْرَة (المسافة أمام العدسة التي يتم تركيزها عند اللانهاية والتي تكون بعدها جميع…)",
 "かしょうひょうか": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "かしょうびょう": "لفحة الكمثرى, لفحة نارية (مرض يسبب اسوداد أوراق أشجار الكمثرى والتفاح)",
 "かしょく": "شركة عائلية (شركة مملوكة بالكامل لأعضاء عائلة واحدة) / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج) / شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة)) / زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة)\nمثال: الزراعة حياة شاقة / زينة / صَالِح لِلْأَكَل ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور…)\nمثال: قم بما هو صالح.",
 "かしょくおうと": "نهام (جوع مرضي لا يشبع (خاصة عندما تسببه آفات الدماغ))",
 "かしょくしょう": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز…)",
 "かしょくのてん": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "かしょぶん": "قابل للتخلص منه, يستخدم لمرة واحدة (مصمم ليتم التخلص منه بعد الاستخدام)\nمثال: أكواب ورقية تستخدم لمرة واحدة",
 "かしょぶんしょとく": "دخل قابل للإنفاق, دخل متاح (الدخل (بعد الضرائب) المتاح لك للادخار أو الإنفاق)",
 "かしら": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما / رَئِيس, رَئِيسَة / شَعْرَة\nمثال: شعر ماريا طويل. / قَائِد, زَعِيم / قِمَّة",
 "かしらがき": "عُنْوَان (عُنْوَان)\nمثال: نسيت عنوان توم. / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "かしらじ": "أَوَّلِيّ, أَوَّل\nمثال: لم تكن أول مرة.",
 "かしらつき": "تَصْفِيفَة, تَسْرِيحَة",
 "かしらぶん": "رَئِيس, رَئِيسَة",
 "かしらもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / أَوَّلِيّ, أَوَّل\nمثال: لم تكن أول مرة.",
 "かしらもじご": "اِخْتِصَار",
 "かしらをたてにふる": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة…)\nمثال: أومأ زيري بنعم.",
 "かしらん": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "かしり": "تَعْوِيذَة",
 "かしりょう": "أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة.",
 "かしわ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "かしわぎ": "بلوط, سنديان (شجرة نفضية من جنس السنديان؛ لها جوز (بلوط) وأوراق مفصصة)\nمثال: تنمو أشجار البلوط العظيمة من ثمار البلوط الصغيرة",
 "かしん": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة)\nمثال: تطلع إلى إثارة اليوم / تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي) / ربة الإلهام, ملهمة (مصدر إلهام الفنان)\nمثال: كانت يوتيربي ملهمته / قَنَاة / بَتَلَة, تُوَيْجَة / منتصف النهر, وسط المجرى (الجزء الأوسط من مجرى النهر)",
 "かしんどうみゃく": "شريان شفوي سفلي (شريان هو فرع من الشريان الوجهي يغذي الشفة السفلى)",
 "かじ": "صَلَاة, دُعَاء / أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار. / دَفَّة, سُكَّان / صيف (أكثر فصول السنة دفئاً)\nمثال: قضوا صيفاً كسولاً على الشاطئ / حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا…) / تَعْلِيق",
 "かじか": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه…)",
 "かじき": "مارلين (أسماك رياضة محيطية كبيرة طويلة الفك؛ ترتبط بأسماك الشراع وأسماك الرمح؛ ليست من…)",
 "かじきざ": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "かじきまぐろ": "مارلين (أسماك رياضة محيطية كبيرة طويلة الفك؛ ترتبط بأسماك الشراع وأسماك الرمح؛ ليست من…)",
 "かじき座": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "かじく": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره",
 "かじしんぱん": "محكمة الأسرة, محكمة العلاقات الأسرية (محكمة في بعض ولايات الولايات المتحدة لها اختصاص في النزاعات العائلية (خاصة تلك…)",
 "かじせんぷう": "عاصفة من الجدل (تفجر للجدل بشكل كبير)\nمثال: تسبب الحادث في عاصفة سياسية",
 "かじだいこう": "أعمال منزلية, تنظيف المنزل (عمل تنظيف وإدارة المنزل)",
 "かじつ": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة. / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "かじつき": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق)",
 "かじづか": "دَفَّة",
 "かじてつだい": "خادم منزلي, عامل منزلي (خادم يتقاضى أجراً لأداء مهام وضيعة حول المنزل)",
 "かじとり": "توجيه السفينة (فعل توجيه السفينة)\nمثال: تم تنصيب مجلس جديد بتوجيه من الملك / إِرْشَاد, هِدَايَة",
 "かじどろ": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "かじのき": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا…)",
 "かじば": "مسبك, ورشة حدادة (مكان عمل يتم فيه تشكيل المعدن بالتسخين والطرق)",
 "かじばどろぼう": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "かじぼう": "قصبة الريشة (العمود الفقري المجوف للريشة) / زَارِع",
 "かじまくら": "رِحْلَة",
 "かじゃ": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "かじや": "حَدَّاد, قَيْن",
 "かじゅ": "شجرة فاكهة (شجرة تحمل فاكهة صالحة للأكل) / شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "かじゅう": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل…)\nمثال: يصنع قطعة أثاث خشبية. / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / عصير الفاكهة (مشروب يتم إنتاجه عن طريق عصر أو سحق الفاكهة) / حِمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل…) / ثِقَل تَرْجِيحِيّ, وَزْن ((في الإحصاء) معامل يُخصص لعناصر توزيع تكراري لتمثيل أهميتها النسبية)",
 "かじゅうでん": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "かじゅうへいきん": "متوسط حسابي موزون, متوسط موزون (متوسط يتم فيه تعيين وزن لكل كمية مراد حساب متوسطها، مما يحدد الأهمية النسبية…)\nمثال: هذا النموذج الميكانيكي البسيط هو الآن تمثيل مألوف للمتوسط الحسابي الموزون لمجموعة من الملاحظات",
 "かじゅうろうどう": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "かじゅえん": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان.",
 "かじゅえんげいがく": "علم زراعة الفاكهة (فرع علم النبات الذي يدرس ويزرع الفواكه)",
 "かじゅくじ": "طفل متأخر الولادة (رضيع يولد بعد 42 أسبوعاً من الحمل؛ عادة ما يظهر علامات قصور المشيمة)",
 "かじゅさいばいしゃ": "زارع الفاكهة, مزارع فاكهة (شخص يزرع الفاكهة لأغراض تجارية)",
 "かじょ": "إزهار, نورة (الجزء المزهر من النبات أو ترتيب الزهور على الساق)",
 "かじょう": "لَوْلَب, بُرْغِيّ / بَنْد / إفراط في التدليل (التدليل المفرط)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "かじょうがき": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "かじょうぎんが": "مَجَرَة حَلَزُونِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي:…)\nمثال: أنا بطل المجرة.",
 "かじょうこうどう": "فرط النشاط (حالة تتميز بالأرق المفرط والحركة الزائدة)",
 "かじょうせいさん": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "かじょうせっしゅ": "جُرْعَة زَائِدَة",
 "かじょうはんのう": "رد فعل مبالغ فيه (رد فعل مفرط؛ رد فعل بسلوك عاطفي غير لائق)",
 "かじょしき": "ذُو أَوْرَاق سَائِبَة (ذو أوراق يمكن إزالتها أو إعادة ترتيبها بسهولة)",
 "かじる": "نَخَرَ, قَضَمَ"
}
