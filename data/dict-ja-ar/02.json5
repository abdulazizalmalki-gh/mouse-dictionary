 "かなしさ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "かなしばり": "شَلَل النَّوْم, جَاثُوم",
 "かなしみ": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن. / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "かなしむ": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "かなた": "أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ) / أَقْصَى / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / فَوْق / فَوْقَ\nمثال: أبعد صورتها عني.",
 "かなたこなた": "هُنَا وَهُنَاكَ",
 "かなづち": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "かなづちあたま": "عَنِيد",
 "かなてこ": "عَتَلَة",
 "かなであう": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "かなでる": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "かなとこ": "سَنْدان, سِنْدَان",
 "かなばさみ": "كَلْبَتَان",
 "かなばし": "كَلْبَتَان",
 "かなべら": "مِلْعَقَةُ الصَيْدَلِيِّ, محراك (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "かなぼう": "عَتَلَة",
 "かなぼうひき": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "かなめ": "حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "かなめいし": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "かなもの": "مَتاع الحاسب, المَتاع",
 "かなやま": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "かならず": "دَائِمًا, أَبَدًا",
 "かならずしも": "دَائِمًا, أَبَدًا",
 "かならずや": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "かなり": "مِن اَلْعَدْل, بِالْعَدْل (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "かなりあなす": "عُشَر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "かなわない": "مُسْتَحِيل",
 "かなわぬ": "مُسْتَحِيل",
 "かなん": "جَنُوب الصِّين (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنُوب الصِّين, سَاوْث تَشَايْنَا (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "かに": "سَرَطَان, سَلْطَعون",
 "かにく": "لَحْمٌ (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "かにくそ": "عقي",
 "かにざ": "سَرَطَان",
 "かにばば": "عقي",
 "かにむし": "عَقْرَب زَائِفَة, عَقْرَب مُزَيَّف",
 "かにゅう": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "かにゅうしゃ": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "かにゅうでんしん": "تِلِكْس",
 "かにわ": "بَتُولَا",
 "かに座": "سَرَطَان",
 "かね": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / مِيتَال",
 "かねあい": "اِتِّزَان, تَوَازُن",
 "かねいれ": "جِزْدَان, جُزْدَان / حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "かねがた": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "かねがない": "مُفْلِس",
 "かねがね": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "かねくい": "غَالٍ, الْغَالِي",
 "かねぐら": "خَزِينَة / راعي; حامي; وصي; سيد; و / حريف; زبون",
 "かねぐり": "تَمْوِيل, مَالِيَّة / مَوَّل",
 "かねごと": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "かねずかいのあらい": "مُسْرِف",
 "かねつ": "تَدْفِئَة",
 "かねつき": "مِدْفَأَة",
 "かねつしょり": "تَدْفِئَة",
 "かねて": "قَبْلًا, قَبْل",
 "かねてから": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "かねてより": "قَبْلًا, قَبْل",
 "かねにきたない": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "かねのない": "مُفْلِس",
 "かねのむしん": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "かねばこ": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "かねばらい": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "かねびら": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "かねめ": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك. / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "かねめのもの": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "かの": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "かのう": "تَقَيَّحَ\nمثال: 傷が化膿しました。 — تَكَوّنَ الصديد في الجرح.",
 "かのうきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "かのうせい": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل يتردد في النسبة بينهما، ويراد به الإمكان الذهني») / إِمْكَانِيَّة\nمثال: هناك احتمال أن لا ينجح. / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "かのうせいがひくい": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "かのうせいのひくい": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "かのうどめ": "مُضَادّ حَيَوِيّ",
 "かのうなかぎり": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "かのうにする": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "かのうほう": "مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "かのきし": "اَلنِّرْفَانَا",
 "かのくに": "اَلنِّرْفَانَا",
 "かのこ": "أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان) / شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "かのこまだら": "أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان)",
 "かのごとくに": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "かのしし": "لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / أَيِّل",
 "かのじょ": "هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا)\nمثال: هذه هي المسألة. / صَدِيقَة, صَاحِبَة (مؤنث الصديق؛ الصاحبة الخليلة) / صَدِيقَة (مؤنث الصديق؛ الصاحبة الخليلة)\nمثال: ليس لديه صديقة.",
 "かのじょじしん": "نَفْسُهَا",
