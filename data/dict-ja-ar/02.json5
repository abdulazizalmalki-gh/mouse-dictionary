 "おばちゃん": "خالة, عمة (أخت الأب أو الأم؛ زوجة العم أو الخال)",
 "おばね": "رِيشَةُ الذَّيْل (ريش ينمو من ذيل (عصعص) الطائر)",
 "おばはん": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة. / كَهْل",
 "おばん": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق…) / مَسَاء",
 "おばんです": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "おばーさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "おひいさま": "أَمِيرَة / غِرَاء, لِزَاق",
 "おひきうけ": "مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها)\nمثال: استعد لمشاريع عظيمة",
 "おひさ": "لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "おひさしぶり": "لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "おひさま": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "おひつじ": "كَبْش",
 "おひつじざ": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おひつじ座": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おひとよし": "دماثة, طيبة النفس (استعداد مبتهج ليكون المرء خدومًا) / حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "おひとりさま": "لوحد",
 "おひま": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "おひまなら": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "おひめさま": "أَمِيرَة / غِرَاء, لِزَاق",
 "おひゃくしょうさん": "فَلَّاح, فَلَّاحَة",
 "おひや": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "おひょう": "هَلْبُوت",
 "おひらき": "انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول))",
 "おひる": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء. / ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل! / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "おひるぎ": "أفيسينيا مارينا, قرم أسود (مانغروف في جزر الهند الغربية وساحل فلوريدا الجنوبي؛ يوجد في غابات كثيفة وله…)",
 "おひれ": "تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما)\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة",
 "おひれをつける": "بَالَغَ",
 "おひろい": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "おひろめ": "إِعْلَان, بَلَاغ",
 "おび": "أوبيا, سحر أوبيا (معتقد ديني من أصل أفريقي يتضمن السحر والشعوذة؛ يمارس في أجزاء من جزر الهند…) / فِرْقَة, فرقة / حِزَام, طَوْق ((في التشريح) بنية مطوّقة (مثل الحافة حول قاعدة السن))",
 "おびえ": "خَوْف, وَهَل\nمثال: خاف زيري نوعا ما.",
 "おびかわ": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "おびきいれる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おびきよせる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おびきん": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في…)",
 "おびき入れる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おびき寄せる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おびく": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "おびじょう": "حِزَامِيّ الشَّكْل (على شكل حزام)",
 "おびじょうほうしん": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "おびただしい": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "おびのこ": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "おびのこぎり": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "おびのこばん": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "おびやかす": "أَخَافَ, أَرْعَبَ / هَدَّدَ",
 "おびる": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "おびれ": "زعنفة ذيلية (ذيل الأسماك وبعض الفقاريات المائية الأخرى)",
 "おびグラフ": "رسم بياني بالأعمدة, مخطط شريطي (مخطط بأشرطة تتناسب أطوالها مع الكميات)",
 "おふ": "غلوتين القمح (غلوتين محضر من القمح)",
 "おふくろ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "おふざけ": "طُرْفَة, نُكْتَة",
 "おふせ": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "おふる": "مَوْرُوث, مُسْتَعْمَل (انتقل من شخص إلى آخر (كالملابس المستعملة))",
 "おふれ": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)",
 "おふろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "おぶ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "おぶいひも": "مِقْلَاع",
 "おぶい紐": "مِقْلَاع",
 "おぶう": "أبوش, حمل على الظهر (عملية حمل شخص أو شيء على الظهر)\nمثال: حملت طفلها على ظهرها / مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "おぶつ": "قَذَارَة",
 "おぶついれ": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "おぶね": "قارب صغير (قارب صغير الحجم)",
 "おへそ": "سُرَّة",
 "おへや": "فَضاء (فَضَاء)\nمثال: الفضاء مليئ بالغموض. / شَقَّة (نِصْف الشيء إذا شُقَّ؛ القطعة المَشْقُوقَة بشكل مستطيل من الثَوْب أو العَصَا)\nمثال: فتش ياني الشقة.",
 "おへんじ": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "おべっか": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "おべっかつかい": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "おべっか使い": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "おべべ": "مَلَابِس, ثِيَاب",
 "おべんちゃら": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "おべんとう": "بِنْتُو",
 "おほしさま": "إِجَّامَة",
 "おほね": "رَمَاد, سَكَن",
 "おほん": "نحنحة (إصدار صوت مشابه لتنظيف الحلق؛ يهدف لجذب الانتباه، أو التعبير عن التردد، أو ملء…)",
 "おぼうさん": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…) / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "おぼえ": "ذَاكِرَة, حَافِظَة",
 "おぼえがき": "مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب) / مُذَكِرَة",
 "おぼえこむ": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "おぼえず": "لَاشُعُورِيًّا",
 "おぼえる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها. / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم. / تحسس\nمثال: شعر ماريا طويل. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おぼこ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / اِبْنَة, بِنْت",
 "おぼこい": "طُفُولِيّ",
 "おぼこむすめ": "بتول, بِكْر (المنقطعه عن الرجال)",
 "おぼこ娘": "بتول, بِكْر (المنقطعه عن الرجال)",
 "おぼしい": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おぼしき": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おぼしめし": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب)\nمثال: كان لديه ولع بالويسكي",
 "おぼしめす": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おぼす": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おぼっちゃま": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / شاب (مراهق أو شاب بالغ ذكر)",
 "おぼっちゃん": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / شاب (مراهق أو شاب بالغ ذكر)",
 "おぼつかない": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي))\nمثال: مستقبل غير مؤكد / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "おぼらす": "غَرِقَ",
 "おぼれこむ": "غَرِقَ",
 "おぼれしぬ": "غَرِقَ",
 "おぼれじぬ": "غَرِقَ",
 "おぼれる": "غَرِقَ",
 "おぼれるものはわらをもつかむ": "الغريق يتعلق بقشة",
 "おぼろ": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم)",
 "おぼろぐも": "طبقي متوسط (سحابة طبقية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "おぼろげ": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "おぼろ雲": "طبقي متوسط (سحابة طبقية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "おぼん": "بُون / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة…)\nمثال: هذه شركة صينية.",
 "おま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまい": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまいつ": "مُعْجَبَة (معجبة شابة متحمسة (خاصة التي تتبع فرق الروك))",
 "おまいり": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "おまえ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "おまえがた": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまえさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまえさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "おまえたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまえら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまけ": "هدية مجانية (شيء مجاني (يتم تقديمه عادةً كجزء من مخطط ترويجي))\nمثال: كانت خارطة الطريق هدية مجانية / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…) / إضَافَة\nمثال: جمع خيل هو خيول.",
 "おまけに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "おまごさん": "حَفِيد, حَفِيدَة",
 "おましどころ": "بَقَاء\nمثال: إذهب إلى الدار.",
 "おまじない": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "おます": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)",
 "おませ": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر)\nمثال: طفل نابغ",
 "おまた": "فَرْج, حِرّ",
 "おまたせしました": "شُكْرًا, تِسْلَم",
 "おまちどうさま": "أَنَا آسِف, أَنَا آسِفَة",
 "おまちどおさま": "أَنَا آسِف, أَنَا آسِفَة",
 "おまつ": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا)",
 "おまつり": "عِيد, مَهْرَجَان",
 "おまつりさわぎ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "おまもり": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "おまる": "قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول)",
 "おまわり": "شُرْطِيّ, شُرَطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي. / طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "おまわりさん": "شُرْطِيّ, شُرَطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "おまん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おまんこ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى…)\nمثال: أنا مثلي الجنس.",
 "おまんま": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "おみ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان)",
 "おみあいデート": "لقاء مع غريب, موعد مدبر (موعد غرامي مع شخص غريب)\nمثال: هي لا تذهب أبداً في مواعيد مدبرة",
 "おみあげ": "إساءة, خدمة سيئة (فعل يُقصد به المساعدة ولكن نتائجه تكون سيئة)\nمثال: لقد أساء إليهم",
 "おみあし": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "おみえ": "وُصُول, وِفَادَة",
 "おみえになる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "おみおくり": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد)\nمثال: كنت هناك مع والدي عند الانطلاق / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "おみき": "غاية, غَرَض",
 "おみこし": "مُسْتَدَقّ الظَّهْر",
 "おみごと": "بْرَافُو, بِرَافُو",
 "おみず": "مِيَاه / مُضِيفَة / سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق)",
 "おみせ": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "おみせする": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "おみそれ": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "おみつもり": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "おみな": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "おみながみ": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "おみまい": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / تعامل, صفقة (فعل التعامل داخل أو بين المجموعات (كالقيام بأنشطة تجارية))\nمثال: لا يمكن إجراء أي معاملات بدونه",
 "おみゃあ": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "おみや": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "おみやげ": "إساءة, خدمة سيئة (فعل يُقصد به المساعدة ولكن نتائجه تكون سيئة)\nمثال: لقد أساء إليهم",
 "おみ足": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "おむかえ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "おむこさん": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد) / زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "おむすび": "أُونِيجِيرِي",
 "おむつ": "حِفَاضة, حِفَاظ",
 "おむつかぶれ": "التهاب جلد الحفاض, طفح الحفاض (التهاب جلد الفخذين والأرداف عند الرضع؛ يُفترض أنه ناتج عن الأمونيا في البول في…)",
 "おめ": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة. / مَشْهَد",
 "おめあり": "شُكْرًا",
 "おめい": "عَار, خِزْي",
 "おめえ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おめおめ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "おめがね": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "おめく": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "おめこ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى…)\nمثال: أنا مثلي الجنس.",
 "おめこぼし": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "おめし": "استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى)",
 "おめしもの": "مَلَابِس, ثِيَاب",
 "おめしゃす": "مُبَارَك, مَبْرُوك",
 "おめずおくせず": "بشجاعة, بلا خوف\nمثال: قاد القوات إلى القتال بلا خوف",
 "おめず臆せず": "بشجاعة, بلا خوف\nمثال: قاد القوات إلى القتال بلا خوف",
 "おめだま": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "おめつけ": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم) / كلب حراسة (كلب مدرب لحراسة الممتلكات)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "おめつけやく": "كلب حراسة (كلب مدرب لحراسة الممتلكات)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "おめでた": "حدث سعيد (الولادة الحية لطفل)",
 "おめでたい": "سَعِيد\nمثال: فرح فاضل كثيرا. / سَاذَج",
 "おめでたくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "おめでとう": "سَعِيد",
 "おめでとうございます": "مُبَارَك, مَبْرُوك",
 "おめでとう御座います": "مُبَارَك, مَبْرُوك",
 "おめどおり": "جُمْهُور, نَظَّارَة",
 "おめにかかる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "おめにかける": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "おめみえ": "جُمْهُور, نَظَّارَة / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / وضع تحت المراقبة ((قانون) طريقة للتعامل مع الجناة دون سجنهم؛ حيث يطلق سراح المتهم المدان بشروط…)\nمثال: الوضع تحت المراقبة جزء من عملية إصدار الحكم",
 "おめめ": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "おめん": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "おめー": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おも": "شَيْخ, قَائِد / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "おもい": "ثَقِيل / بَطِيء / مُهِمّ / جِدِّيّ / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي)\nمثال: يمكن لتوم البقاء إن رغب. / حَبِيب, حَبِيبَة\nمثال: لا أحب المدرسة.",
 "おもいあがり": "خلاء, غرور (سمة كون المرء مغروراً ومعجباً بنفسه بشكل مفرط؛ كبرياء زائف)",
 "おもいあたる": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "おもいあわせる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا",
 "おもいいる": "تَفَكَّرَ, فَكَّرَ",
 "おもいいれ": "مَوْقِف, سُلُوك",
 "おもいうかべる": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي. / تَخَيَّلَ, تَصَوَّرَ",
 "おもいえがく": "تَخَيَّلَ, تَصَوَّرَ",
 "おもいおこす": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "おもいかえす": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "おもいがけず": "بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
 "おもいがけない": "مُفَاجِئ",
 "おもいきった": "بشجاعة (بطريقة شجاعة)\nمثال: دخل المنزل المحترق بشجاعة",
 "おもいきって": "بِإِصْرَار, بِعَزْم (إظهار تصميم أو هدف حازم)\nمثال: رفضت بحزم النظر إليه أو التحدث معه",
 "おもいきや": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "おもいきり": "عَزْم, عُزْم",
 "おもいきる": "تَنَازَلَ / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "おもいこがれる": "اِشْتَاقَ",
 "おもいこみ": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "おもいこむ": "اِفْتَرَضَ / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "おもいごと": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي)\nمثال: يمكن لتوم البقاء إن رغب.",
 "おもいさだめる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "おもいしる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "おもいたつ": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / تَنَازَلَ",
 "おもいだす": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "おもいちがい": "سُوء فَهْم",
 "おもいっきし": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "おもいっきり": "عَزْم, عُزْم",
 "おもいつき": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "おもいつく": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي.",
 "おもいで": "ذَاكِرَة, حَافِظَة",
 "おもいでのしな": "تذكار, هدية تذكارية (شيء ذو قيمة عاطفية)",
 "おもいでばなし": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "おもいとどまる": "تَنَازَلَ",
 "おもいなおす": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "おもいなす": "اِفْتَرَضَ",
 "おもいのこす": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "おもいのほか": "بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
 "おもいびと": "حَبِيب, عَزِيز (شخص تحبه، عادة ما يكون فرداً من عائلتك)",
 "おもいまわす": "تَفَكَّرَ, فَكَّرَ",
 "おもいめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "おもいもうける": "تَوَقَّعَ, اِرْتَقَبَ",
 "おもいもかけない": "مُفَاجِئ",
 "おもいもの": "حَبِيب, حَبِيبَة",
 "おもいもよらない": "مُفَاجِئ",
 "おもいやり": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "おもいやりよさん": "تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "おもいよる": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "おもいをめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "おもいをめぐらせる": "تَفَكَّرَ, فَكَّرَ",
 "おもいをよせる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "おもう": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / تَخَيَّلَ, تَصَوَّرَ / تَوَقَّعَ",
 "おもうさま": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "おもうぞんぶん": "بحماس, بقلب قوي (بمتعة ودون تحفظ)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "おもうに": "الْمُفْتَرَض مِنْ",
 "おもえらく": "الْمُفْتَرَض مِنْ",
 "おもえる": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもおもしい": "جِدِّيّ",
 "おもかげ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / أثر, بقية (دلالة على أن شيئاً ما كان موجوداً)\nمثال: لم يكن هناك أي أثر لدليل على الادعاء",
 "おもかじ": "يَمِينِيُّ السَّفِينَة (واقع على الجانب الأيمن من السفينة أو الطائرة)",
 "おもがい": "عِذَار",
 "おもき": "أَهَمِّيَّة",
 "おもきをおく": "شَدَّدَ (الشيءَ: قَوَّاه وجعله شديدًا؛ في الأمر: بالغ فيه)",
 "おもくるしい": "ثَقِيل",
 "おもくろい": "مُشَوِّق, ممتع / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "おもさ": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "おもざし": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもし": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "おもしい": "مُشَوِّق, ممتع",
 "おもしれえ": "مُضْحِك, هَزْلِيّ",
 "おもしれー": "مُضْحِك, هَزْلِيّ",
 "おもしろ": "مُمْتِع",
 "おもしろい": "مُشَوِّق, ممتع / مُمْتِع / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "おもしろいように": "بِسُهُولَة",
 "おもしろおかしい": "طريف, فکاهي (مليء بـأو يتميز بالفكاهة)\nمثال: قصص فكاهية / مُمْتِع",
 "おもしろがる": "اِسْتَمْتَعَ, تَمَتَّعَ\nمثال: من حسن حظي أن صرت صديقه.",
 "おもしろさ": "اِلْتِمَاس, اِسْتِئْنَاف / روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة)\nمثال: لم تقدر فكاهتي / مَرَح, تَرْفِيه",
 "おもしろはんぶん": "على سبيل المزاح, للمرح (غير مقصود بجدية؛ يعني مزحة)\nمثال: كان كل ذلك للمرح",
 "おもしろみ": "فَائِدَة",
 "おもしろネタ": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "おもしをする": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "おもすれえ": "مُضْحِك, هَزْلِيّ",
 "おもすれー": "مُضْحِك, هَزْلِيّ",
 "おもたい": "ثَقِيل",
 "おもたげ": "ثَقِيل",
 "おもだち": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "おもだった": "شَيْخ, قَائِد",
 "おもち": "موتْشِي",
 "おもちかえり": "لِقَاء جِنْسِيّ لِلَيْلَة وَاحِدَة (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا)\nمثال: اريد لقاء والدك / سَفَريّ",
 "おもちゃかぼちゃ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت…)\nمثال: توقف ذلك القرع.",
 "おもちゃばこ": "صندوق ألعاب (صندوق لتخزين الألعاب)",
 "おもちゃカボチャ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت…)\nمثال: توقف ذلك القرع.",
 "おもちゃ南瓜": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت…)\nمثال: توقف ذلك القرع.",
 "おもちゃ箱": "صندوق ألعاب (صندوق لتخزين الألعاب)",
 "おもったい": "ثَقِيل",
 "おもってもいない": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "おもってもみない": "مُفَاجِئ",
 "おもづな": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "おもて": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / جَبْهَة / خَارِج, بره / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "おもてかんばん": "جَبْهَة",
 "おもてがき": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "おもてがまえ": "وَاجِهَة",
 "おもてがわ": "جَبْهَة",
 "おもてぐち": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "おもてげんかん": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "おもてざしき": "صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء)",
 "おもてだった": "عَلَنِيّ, عَامّ",
 "おもてだって": "عَلَانِيَةً, عَلَنًا",
 "おもてつき": "واجهة المبنى (وجه أو مقدمة مبنى)",
 "おもてど": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "おもてどおり": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
