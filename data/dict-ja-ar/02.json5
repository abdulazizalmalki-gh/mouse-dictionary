 "お祭り": "عِيد, مَهْرَجَان",
 "お祭りさわぎ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "お祭り騒ぎ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "お祭騒ぎ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "お稲荷さん": "صَفَن, كِيس اَلصَّفَن",
 "お稽古": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب.",
 "お立ち": "رَحِيل, مُغَادَرَة / مَنْزِلَة, مَكَانَة",
 "お立ち台": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس)",
 "お笑い": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه)",
 "お笑いタレント": "كُومِيدْيَان",
 "お笑い芸人": "كُومِيدْيَان",
 "お節介": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / حشري, فضولي (شخص مزعج يتدخل في شؤون الآخرين بفضول)",
 "お節介屋": "تَجَسَّسَ",
 "お節介焼き": "فُضُولِيّ",
 "お米": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "お粉": "بُودْرَة",
 "お粗末": "فَقِير",
 "お粥": "إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم)",
 "お約束": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "お経": "سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية)",
 "お絵かき": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / خربشة, شخبطة (رسم بلا هدف)",
 "お絵描き": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / خربشة, شخبطة (رسم بلا هدف)",
 "お縄": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره)",
 "お美事": "بْرَافُو, بِرَافُو",
 "お義兄さん": "شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "お義姉さん": "أُخْت زَوْجَة (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم",
 "お義母さん": "حَمَاة / أم بالتبني, أم حاضنة (امرأة تعمل كأم حاضنة وتربي طفل شخص آخر) / زَوْجَةُ الْأَب",
 "お義父さん": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر. / أب بالتبني, أب حاضن (رجل هو والد حاضن) / زَوْجُ ٱلْأُمّ, أَب رَبِيب (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "お老成": "سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر)\nمثال: طفل نابغ",
 "お聞きいただく": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "お股": "فَرْج, حِرّ",
 "お腰": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "お腹": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "お腹いっぱい": "جرعة زائدة, طفح الكيل (وفرة مفرطة غير مرغوب فيها)\nمثال: جرعة زائدة من شكاويك",
 "お腹一杯": "جرعة زائدة, طفح الكيل (وفرة مفرطة غير مرغوب فيها)\nمثال: جرعة زائدة من شكاويك",
 "お臍": "سُرَّة",
 "お花": "إِيكِيبَانَا / زَهْرَة, زُهُور\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "お花畑": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة. / خَيَال (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "お花見": "زَهْرَة كَرَز",
 "お茶": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك. / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / سَادُو, طُقُوس اَلشَّاي",
 "お茶の子": "بَسِيطَة, لُقْمَة سَائِغَة",
 "お茶の子さいさい": "بَسِيطَة, لُقْمَة سَائِغَة",
 "お茶の間": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "お茶を濁す": "لَفَّ وَدَارَ",
 "お茶会": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)",
 "お茶屋": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ…)\nمثال: هذا المقهى مريح.",
 "お茶目": "دَاعِب, لَعُوب / جُوكَر",
 "お荷物": "أمتعة, حقائب سفر (حقائب تستخدم لحمل المتعلقات عند السفر) / حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "お菓子": "حَلْوَى",
 "お菓子屋": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
 "お菜": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "お葬式": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "お蔭様": "مُسَاعَدَة, إِمْدَاد / غريس",
 "お蔭様で": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "お蔵": "أَلْغَى, أَبْطَلَ",
 "お薦": "سَائِل",
 "お薦め": "تَوْصِيَة",
 "お行儀": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "お袋": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "お見え": "وُصُول, وِفَادَة",
 "お見えになる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "お見せする": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "お見それ": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "お見事": "بْرَافُو, بِرَافُو",
 "お見合いデート": "لقاء مع غريب, موعد مدبر (موعد غرامي مع شخص غريب)\nمثال: هي لا تذهب أبداً في مواعيد مدبرة",
 "お見積": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "お見積もり": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "お見積り": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "お見舞": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / تعامل, صفقة (فعل التعامل داخل أو بين المجموعات (كالقيام بأنشطة تجارية))\nمثال: لا يمكن إجراء أي معاملات بدونه",
 "お見舞い": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / تعامل, صفقة (فعل التعامل داخل أو بين المجموعات (كالقيام بأنشطة تجارية))\nمثال: لا يمكن إجراء أي معاملات بدونه",
 "お見送り": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد)\nمثال: كنت هناك مع والدي عند الانطلاق / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "お見逸れ": "بخس في التقدير, تقليل من التقدير (تقدير منخفض جداً؛ تقدير أقل من القيمة الحقيقية أو الفعلية)",
 "お言葉": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "お詫び": "اِعْتِذَار, عُذْر",
 "お話": "قِصَّة, حِكَايَة / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "お話し": "قِصَّة, حِكَايَة / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "お話し中": "مَشْغُول",
 "お話中": "مَشْغُول",
 "お話会": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "お誂え向き": "كَامِل",
 "お誕生会": "حَفْلَة عِيد مِيلَاد",
 "お誕生日": "عِيد مِيلَاد\nمثال: طقس اليوم جميل.",
 "お誕生日おめでとう": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "お誕生日おめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "お買い上げ": "شِرَاء, اِشْتِرَاء",
 "お買い得": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "お買上": "شِرَاء, اِشْتِرَاء",
 "お買上げ": "شِرَاء, اِشْتِرَاء",
 "お買得": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "お越し": "إتْيَان, أَتْي\nمثال: ぜひまたお越しください。 — أتمنّى أن تأتي مرّة أخرى.",
 "お越しいただき": "إتْيَان, أَتْي",
 "お越しになる": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "お越し頂き": "إتْيَان, أَتْي",
 "お足": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "お車": "سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "お車代": "أتعاب شرفية, مكافأة شرفية (رسوم تُدفع مقابل خدمة مجانية اسمياً) / نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب…)",
 "お転婆": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "お転婆娘": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "お辞儀": "قَوْس, قوس",
 "お辞儀草": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال)",
 "お迎え": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "お近づき": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "お近づきになる": "تَعَرَّفَ",
 "お近付き": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "お近付きになる": "تَعَرَّفَ",
 "お返し": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "お返事": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "お通し": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة…)",
 "お通し代": "رسم الدخول, رسم خدمة المطعم (رسم ثابت يفرضه مطعم أو ملهى ليلي بالإضافة إلى رسوم الطعام والشراب)",
 "お通じ": "حَرَكَة",
 "お通り": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "お通夜": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "お造り": "سَاشِيمِي / تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "お連れ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "お遊び": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "お達し": "إِعْلَان, بَلَاغ",
 "お遣い": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية)\nمثال: あの子はよくお使いをする。 — غالبًا ما يقوم الصبي بالمشاوير / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة)",
 "お邪魔": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع)",
 "お邪魔虫": "حشري, فضولي (شخص مزعج يتدخل في شؤون الآخرين بفضول)",
 "お部屋": "فَضاء (فَضَاء)\nمثال: الفضاء مليئ بالغموض. / شَقَّة (نِصْف الشيء إذا شُقَّ؛ القطعة المَشْقُوقَة بشكل مستطيل من الثَوْب أو العَصَا)\nمثال: فتش ياني الشقة.",
 "お酌": "غَيْشَا",
 "お酒": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "お酢": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "お釈迦さま": "بُوذَا, بُدّ",
 "お釈迦さん": "بُوذَا, بُدّ",
 "お釈迦様": "بُوذَا, بُدّ",
 "お金": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "お金持ち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "お釜": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد. / فَوَّهَةُ الْبُرْكَان, فَوَّهَة / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / رجل مثلي (رجل مثلي الجنس)",
 "お釜を掘る": "لوطي (شخص يمارس اللواط)",
 "お釜帽": "قبعة بولر, قبعة مستديرة (قبعة لباد مستديرة وصلبة ذات حافة ضيقة)",
 "お針": "أشغال الإبرة, تطريز (العمل الذي يتم بالإبرة (مثل الخياطة أو التطريز)) / خَيَّاطَة",
 "お針子": "خَيَّاطَة",
 "お釣": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "お釣り": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "お銭": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "お鍋": "مِقْلَاة (وعاء قلي الطعام) / خادمة (عاملة منزلية)",
 "お開き": "انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول))",
 "お陀仏": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "お陰": "غريس / مُسَاعَدَة, إِمْدَاد / أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "お陰さま": "مُسَاعَدَة, إِمْدَاد / غريس",
 "お陰さまで": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "お陰様": "مُسَاعَدَة, إِمْدَاد / غريس",
 "お陰様で": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "お隠れ": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "お隠れになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "お隣さん": "جَار, جَارة (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل…)\nمثال: لدي جارة مسلمة.",
 "お零れ": "ذهاب, رحيل (فعل المغادرة)",
 "お電話": "مُكَالَمَة / هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "お面": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "お預け": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "お頭": "قَائِد, زَعِيم / رَئِيس, رَئِيسَة",
 "お題": "مَوْضُوع",
 "お題目": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "お顔": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "お願い": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "お願いいたします": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "お願いします": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "お願いだから": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "お願い事": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "お願い申し上げる": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "お願い致します": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "お風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "お食事処": "مَطْعَم",
 "お飯": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "お飾り": "زينة",
 "お餅": "موتْشِي",
 "お館様": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "お香": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق…)",
 "お馬さん": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "お馬鹿さん": "بانجو, عشب (أسماء دارجة للماريجوانا)\nمثال: هل هذه هي الحقيقة المجردة؟",
 "お馴染み": "مَأْلُوف / عَادِيّ",
 "お駄賃": "مُكَافَأَة, ثَوَاب",
 "お騒がせ": "مُثِير لِلْمَشاكِل, مُثِير لِلْمَتَاعِب",
 "お骨": "رَمَاد, سَكَن",
 "お高い": "مُتَعَالٍ, الْمُتَعَالِي",
 "お髪": "شَعْرَة\nمثال: شعر ماريا طويل.",
 "お麩": "غلوتين القمح (غلوتين محضر من القمح)",
 "お麸": "غلوتين القمح (غلوتين محضر من القمح)",
 "おｋ": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "か": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل. / إضَافَة\nمثال: جمع خيل هو خيول. / كَنَدَا, كَنَدَة (دولة في قارة أمريكا الشمالية؛ عاصمتها أُوتَاوَا)\nمثال: هذا خطاب من كندا. / مَقْبُول, مُرْضٍ (جدير بالقبول أو مرضٍ)\nمثال: مستويات مقبولة من الإشعاع / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل:…)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / بَعُوضَة, نَامُوسَة / جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في…) / مَكْتَبَة شَخْصِيَّة / أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / وَا, يَا يَاه\nمثال: آه ، هناك فراشة! / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة! / لقمة (نتوء دائري على عظم حيث يشكل مفصلاً مع عظم آخر) / تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة. / تَنْوِير / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة. / ـِيّ / الثُّلَاثَاء, الثَّلَاثَاء / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار. / رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح…)\nمثال: شم تلك الرائحة. / أَقَلِّيَّة / أَرْمَلَة / تكافؤ / بَهْرَجَة, زَخْرَفَة صَارِخَة (الاستعراض المبتذل عديم الذوق) / إزهار, تزهير (رواسب مسحوقية على سطح ما)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور / جُمْهُورِيَّة الصِّين / كَارِثَة, مُصِيبَة / أَيِّل",
 "かあ": "نَعْق, نَعِيق",
 "かあかあ": "غُرَاب, زَاغ\nمثال: سأساعدك يا صاح.",
 "かあさま": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "かあさん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة",
 "かあちゃん": "أُمّ, مَامَا (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "かあつすいがたげんしろ": "مفاعل الماء المضغوط (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يمكن للبخار المنتج تشغيل توربين بخاري)",
 "かあつすいろ": "مفاعل الماء المضغوط (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يمكن للبخار المنتج تشغيل توربين بخاري)",
 "かあつせい": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل)",
 "かい": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / شوط ((بيسبول) واحد من تسعة أقسام للعب يكون لكل فريق خلالها دور في الضرب) / حَادِثَة, وَاقِعَة / هُوَي / طَابَق, دَوْر / سَلَالِم / مَرْحَلَة / مَحَار / صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة. / إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم) / تَسَبَّب / مِلْعَقَة, معلقة (أداة للأكل والاحتساء والطبخ وتقديم الطعام) / مِضْرَب / شِرَاء, اِشْتِرَاء / مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز. / شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك. / سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / تَنْقِيح / مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا. / تَفْسِير, شَرْح / مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع. / مَمْلَكَة, مُلْك (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار))\nمثال: خطاب تحذير حول مخاطر الفسق / مُتْعَة, لَذَّة / سَرِيع / أُخْدُود (أخْدُودُ) / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية. / ملابس داخلية (رداء يلبس تحت ملابس أخرى) / مَفْتُوح\nمثال: فتح الباب آليا. / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / أَلِيف",
 "かいあく": "تدهور, تردي (عملية التغير إلى حالة أدنى)",
 "かいあげ": "شِرَاء, اِشْتِرَاء",
 "かいあげる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "かいあしるい": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها…)",
 "かいあって": "بِفَضْل, بِسَبَبِ",
 "かいあわせ": "سحاق تداككي (شكل من أشكال السحاق يحاكي الجماع الغيري)",
 "かいあん": "تَنْقِيح",
 "かいい": "سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / شَبَح, خَيَال / قَوِيّ البُنْيَة, مَفْتُول العَضَلَات ((للشخص) يمتلك قوة بدنية ووزنًا؛ متين وجبار) / مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة) / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "かいいき": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "かいいれ": "شِرَاء, اِشْتِرَاء",
 "かいいれる": "شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "かいいん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه. / بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب…)\nمثال: هى متزوجة من بحار. / اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "かいいんけん": "بطاقة عضوية (بطاقة تثبت العضوية في منظمة ما) / عُضْوِيَّة",
 "かいいんしょう": "بطاقة عضوية (بطاقة تثبت العضوية في منظمة ما)",
 "かいいんとうろく": "اِشْتِرَاك",
 "かいいんカード": "بطاقة عضوية (بطاقة تثبت العضوية في منظمة ما)",
 "かいう": "زنبق الكالا, كالا (نبات من جنوب إفريقيا يزرع على نطاق واسع لقنابته البيضاء النقية البارزة وطلعه…)",
 "かいうける": "شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "かいうん": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد)\nمثال: 海運会社に勤めています。 — أعمل لدى شركة شحن.",
 "かいえつ": "فُرْجَة",
 "かいえん": "افتتاح, ليلة الافتتاح (الأداء الأول (كما في إنتاج مسرحي))\nمثال: تلقى الافتتاح مراجعات نقدية جيدة / عَمِيق, غَوِيط",
 "かいおうせい": "نِبْتُون",
 "かいおき": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "かいおけ": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "かいおん": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ)…) / مُتَوَسِّط, وَسَطِيّ (يتعلّق بالوسط أو يقع فيه أو يمتدّ نحوه) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "かいおんせつ": "مقطع مفتوح (مقطع صوتي ينتهي بصائت أو حرف لين)",
 "かいか": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل…)\nمثال: الحضارة الامازيغية عظيمة. / مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم)\nمثال: نبات مزهر / أسفل الدرج, في الطابق السفلي (في طابق أدنى)\nمثال: المستأجرون يعيشون في الطابق السفلي / سراب, وهم خادع (وهم يضلل) / اِنْسِجَام, تَوَافُق",
 "かいかい": "خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان / حكة, هرش (إحساس جلدي مزعج يولد الرغبة في الحك) / جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "かいかいろ": "دائرة مفتوحة (دائرة كهربائية غير مكتملة لا يتدفق فيها تيار)",
 "かいかえる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "かいかき": "إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "かいかく": "إِصْلَاح / رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "かいかくか": "مُصْلِح",
 "かいかくしゃ": "مُصْلِح",
 "かいかくは": "إِصْلَاحِيّ",
 "かいかけきん": "حسابات الدائنين, ذمم دائنة (حسابات المدين للأموال التي يدين بها؛ تنشأ عادة عن شراء المنتجات أو الخدمات)",
 "かいかた": "مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز.",
 "かいかつ": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / مَفْتُوح\nمثال: فتح الباب آليا.",
 "かいかぶり": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً)",
 "かいかぶる": "تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً)",
 "かいかん": "مُتْعَة, لَذَّة / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / قاعة اجتماعات, قاعة تجميع (قاعة يمكن لعدد كبير من الناس التجمع فيها)",
 "かいかんしょうしつ": "انعدام التلذذ, خمود التلذذ (عدم القدرة على الشعور بالمتعة)",
 "かいかんたい": "مِنْطَقَة رَاحَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "かいが": "لَوْحَة, صُورَة",
 "かいがい": "أَجْنَبِيّ\nمثال: 君はどれくらいよく海外に行きますか。 — كم مرة تسافر إلى الخارج عادةً؟",
 "かいがいいじゅうしゃ": "مُهَاجِر, مُهَاجِرَة",
 "かいがいいてん": "بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر",
 "かいがいしい": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "かいがいちょくせつとうし": "استثمار أجنبي مباشر (مشروع مشترك بين شركة أجنبية وشركة أمريكية)",
 "かいがてき": "بَدِيع المَنْظَر, خَلَّاب (يوحي بأنه مناسب لصورة؛ جميل كاللوحة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)\nمثال: منظور تصويري",
 "かいがてん": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "かいがない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "かいがね": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "かいがら": "صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة.",
 "かいがらついほう": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام)\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "かいがらぼね": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "かいがらむし": "حشرة قشرية (حشرة صغيرة من رتبة متشابهات الأجنحة تعيش وتتغذى عادة على النباتات وتفرز غطاء…)",
 "かいがん": "سَاحِل, شَاطِئ / تَنْوِير",
 "かいがんせん": "خط الساحل (المخطط الخارجي للساحل)",
 "かいがんばた": "سَاحِل, شَاطِئ",
 "かいがんへいや": "سهل ساحلي (سهل مجاور للساحل)",
 "かいがんほ": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "かいき": "جَلْسَة\nمثال: خضع زيد لدورة مكثفة / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / ارتداد, تراجع (العودة إلى حالة سابقة) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / غَرِيب / كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً) / إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ / قَاعِدَة / نسيم البحر (نسيم منعش من البحر (خلال النهار)) / شِفَاء, تَعَافِي",
 "かいきえん": "بهرجة, تأنق مفرط (إتقان مفرط وتكلف)\nمثال: كتب بأسلوب منمق للغاية",
 "かいきけいすう": "معامل الانحدار (عندما يكون خط الانحدار خطياً، فإن معامل الانحدار هو الثابت الذي يمثل معدل تغير…)",
 "かいきげっしょく": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "かいきげんしょう": "مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ)",
 "かいきしき": "معادلة الانحدار (المعادلة التي تمثل العلاقة بين قيم مختارة لمتغير واحد (س) والقيم المرصودة للآخر…)",
 "かいきしょく": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "かいきせん": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة. / خط الانحدار, منحنى الانحدار (منحنى أملس يتم تركيبه على مجموعة من البيانات المزدوجة في تحليل الانحدار)",
 "かいきてき": "عَوْدِيّ",
 "かいきねつ": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز…)",
 "かいきねん": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "かいきぶんせき": "تحليل الانحدار (استخدام الانحدار لعمل تنبؤات كمية لمتغير واحد من قيم متغير آخر)",
 "かいきものがたり": "قصة غموض, لغز جنائي (قصة تدور حول جريمة (عادة جريمة قتل) تُقدم كرواية أو مسرحية أو فيلم)",
 "かいきゅう": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة / صِنْف, صَنْف\nمثال: اقرأ هذا الفصل. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "かいきゅうさべつ": "طَبَقِيَّة, تَمَايُز طَبَقِيّ",
 "かいきゅうせいど": "نظام طبقي (هيكل اجتماعي يتم فيه تحديد الطبقات عن طريق الوراثة)",
 "かいきゅうだん": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "かいきゅうとうそう": "صراع الطبقات",
 "かいきょう": "الْإِسْلَام / قَنَاة / حَنِين, اِشْتِيَاق / بضع الصدر (شق جراحي في جدران الصدر لفتح التجويف الجنبي)",
 "かいきょうじいん": "مَسْجِد, جَامِع (هو مكان السُجُوْد، بناء كان أم لا، عاما كان أم خاصا؛ المُصَلَّى)\nمثال: دخل إلى المسجد.",
 "かいきょうじゅつ": "بضع الصدر (شق جراحي في جدران الصدر لفتح التجويف الجنبي)",
 "かいきょうと": "مُسْلِم, مُسْلِمَة ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "かいきょうびょう": "حَنِين, اِشْتِيَاق",
 "かいきょく": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "かいきる": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かいぎ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ:…)\nمثال: إنها بلا شك محقة. / تَفْسِير, شَرْح / مهارة الملاحة البحرية (المهارة في الإبحار)",
 "かいぎし": "ضابط بحري (شخص مخول للخدمة في منصب قيادي على سفينة)\nمثال: هو الضابط المسؤول عن محركات السفينة",
 "かいぎしつ": "غرفة اجتماعات (غرفة يمكن عقد مؤتمر فيها)",
 "かいぎしゅぎ": "ارتياب, شك (الشك في حقيقة شيء ما)",
 "かいぎしゅぎしゃ": "شاك, متشكك (شخص يشك عادة في المعتقدات المقبولة)",
 "かいぎしりょう": "تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "かいぎしん": "ارتياب, شك (الشك في حقيقة شيء ما)",
 "かいぎじこう": "جَدْوَل, جَدْوَل أَعْمَال",
 "かいぎじょう": "غرفة اجتماعات (غرفة يمكن عقد مؤتمر فيها)",
 "かいぎたい": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "かいぎてき": "شُكُوكِيّ",
 "かいぎゃく": "طُرْفَة, نُكْتَة",
 "かいぎゅう": "بقر البحر (أي من فصيلتين من الثدييات المائية العاشبة الكبيرة ذات ذيول مجدافية الشكل وأطراف…)",
 "かいぎょ": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "かいぎょう": "سطر جديد (العملية التي تمهد لطباعة أو عرض الحرف التالي كأول حرف في السطر التالي) / تغذية السطر (العملية التي تمهد لطباعة أو عرض الحرف التالي في السطر التالي)",
 "かいぎょうざい": "مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: المذيب لا يغير حالته عند تكوين محلول",
 "かいぎろく": "محضر, مداولات (وصف مكتوب لما دار في اجتماع ما)",
 "かいぎろん": "ارتياب, شك (الشك في حقيقة شيء ما)",
 "かいく": "تَطَوُّر",
 "かいくかん": "فترة مفتوحة (فترة لا تتضمن نقطتي نهايتها)",
 "かいくれ": "أبداً",
 "かいぐ": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "かいぐう": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "かいぐすり": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "かいぐん": "بَحْرِيَّة / زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية)",
 "かいぐんこうしょう": "ترسانة بحرية عسكرية (حوض بناء سفن عسكري)",
 "かいぐんしょうかん": "أَمِيرُ البَحْر, أَدْمِيرَال",
 "かいぐんとくしゅぶたい": "جندي قوات خاصة بحرية, نيفي سيل (عضو في وحدة الحرب الخاصة البحرية مدرب على الحرب غير التقليدية (خاصة في الولايات…)",
 "かいぐんへいがっこう": "أكاديمية بحرية, كلية بحرية (أكاديمية لتدريب الضباط البحريين)",
 "かいけい": "مُحَاسِبَة (المُحَاسَبَة: المهنة التي يقوم أصحابها بحساب الأرباح والخسائر وغيرها في…)\nمثال: محاسبة النفس صفة حميدة. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة. / مُحَاسِب, مُحَاسِبَة / حالة اقتصادية, وضع اقتصادي (حالة الاقتصاد) / درنة (ساق أو جذر تحت أرضي لحمي يخدم في التكاثر وتخزين الغذاء) / لوحة بحرية, منظر بحري (لوحة للبحر (لتمييزها عن المناظر الطبيعية البرية))",
 "かいけいかん": "مُحَاسِب, مُحَاسِبَة",
 "かいけいかんさ": "تدقيق, مراجعة (فحص منهجي أو مراجعة لحالة أو وضع)\nمثال: أجرى تدقيقاً لجميع النباتات في ممتلكاته",
 "かいけいかんさにん": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة)",
 "かいけいがかり": "مُحَاسِب, مُحَاسِبَة",
 "かいけいがく": "مُحَاسِبَة (المُحَاسَبَة: المهنة التي يقوم أصحابها بحساب الأرباح والخسائر وغيرها في…)\nمثال: محاسبة النفس صفة حميدة.",
 "かいけいけい": "مُحَاسِب, مُحَاسِبَة",
 "かいけいけんさ": "تدقيق, مراجعة (فحص منهجي أو مراجعة لحالة أو وضع)\nمثال: أجرى تدقيقاً لجميع النباتات في ممتلكاته",
 "かいけいけんさかん": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة)",
 "かいけいし": "مُحَاسِب, مُحَاسِبَة",
 "かいけいしょり": "مُحَاسِبَة (المُحَاسَبَة: المهنة التي يقوم أصحابها بحساب الأرباح والخسائر وغيرها في…)\nمثال: محاسبة النفس صفة حميدة.",
 "かいけいじょうほうシステム": "تلقيح صناعي (إدخال السائل المنوي إلى قناة فالوب أو الرحم بوسيلة غير الجماع الجنسي)\nمثال: يأمل العاملون في الذكاء الاصطناعي في تقليد أو محاكاة الذكاء في أجهزة الكمبيوتر والروبوتات",
 "かいけいちょうぼ": "دَفْتَر حِسَابَات",
 "かいけいねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ…)\nمثال: في عمره 24 سنة.",
 "かいけいぼ": "دَفْتَر حِسَابَات",
 "かいけっちょうどうみゃく": "شريان لفائفي قولوني (شريان ينشأ من الشريان المساريقي العلوي ويغذي الجزء النهائي من اللفائفي والأعور…)",
 "かいけつ": "مُسْتَعْمَرَة, مُسْتَوْطَنَة / عَجَب\nمثال: قطة؟ تساءل الرجل العجوز.",
 "かいけつさく": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "かいけつずみ": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)\nمثال: ألغاز محلولة وغير محلولة",
 "かいけつのいとぐち": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)",
 "かいけつびょう": "إِسْقَرْبُوط",
 "かいけつふのう": "عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "かいけつほう": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "かいけつほうほう": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "かいけん": "مُقَابَلَة / خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "かいけんしゃ": "مُجري المقابلة (شخص يجري مقابلة)",
 "かいけんじょう": "مُؤْتَمَر صَحَفِيّ",
 "かいげん": "تَنْوِير / حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "かいげんれい": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "かいこ": "إِقَالَة / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي. / استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة / دُودَة اَلْقَزّ / مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز.",
 "かいこう": "مِلَاحَة / مِينَاء, مينا / أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / مَفْتُوح\nمثال: فتح الباب آليا. / إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى) / مَرْفَأ, مَرْسَى / هَايْكُو, خَايْكُو / توليد, مضاعفة (فعل إنتاج النسل أو المضاعفة من خلال هذا الإنتاج)",
 "かいこういちばん": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "かいこうじょう": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة…)",
 "かいこうば": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة…)",
 "かいこうぶ": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة)",
 "かいこが": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير)",
 "かいこく": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار))\nمثال: خطاب تحذير حول مخاطر الفسق",
 "かいこだな": "سرير سفينة, سرير قطار (سرير على متن سفينة أو قطار؛ عادة ما يكون في طبقات)",
 "かいこだん": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "かいこちゅう": "دقة قديمة, رجعي (محافظ قديم الطراز أو ممل في موقفه أو مظهره)\nمثال: قد تتهمني بأنني رجعي عجوز أحاول منع الشباب من الاستمتاع",
 "かいこつ": "الخط الأويغوري (الخط (المشتق من الآرامية) المستخدم لكتابة اللغة الأويغورية)",
 "かいこつうち": "إنهاء خدمة, فصل (إشعار رسمي بأنك قد طُردت من وظيفتك)",
 "かいこてき": "متعلِّق بالماضي, رَجْعِيّ / حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها)",
 "かいこてん": "متعلِّق بالماضي, رَجْعِيّ",
 "かいことば": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "かいこみ": "شِرَاء, اِشْتِرَاء",
 "かいころく": "مُذَكَّرَات, مُذَكِّرَات",
 "かいこん": "نَدِمَ\nمثال: للأسف ذلك صحيح. / ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / مَفْتُوح\nمثال: فتح الباب آليا.",
 "かいこんち": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "かいご": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها…) / نَدَم\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / إِصْلَاح / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت. / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى) / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "かいごう": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية. / حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "かいごかんせい": "توافقية مستقبلية",
 "かいごさつじん": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "かいごし": "مُقَدِّم الرِّعايَة (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "かいごしせつ": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "かいごしゃ": "مُقَدِّم رِعَايَة (شخص مسؤول عن تلبية احتياجات طفل أو شخص بالغ معال)",
 "かいごつきホーム": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "かいごにんてい": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "かいごほけんほう": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "かいさ": "فَرْق, اِخْتِلَاف",
 "かいさい": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور. / مُسْتَعْمَرَة, مُسْتَوْطَنَة / إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما)\nمثال: تلك القبعة ملكي",
 "かいさいち": "دائرة الاختصاص المكاني, مكان الانعقاد (في القانون: الولاية القضائية التي ستُعقد فيها المحاكمة)",
 "かいさいちゅう": "قَيْد التَّنْفِيذ, قَيْد الحَرَكَة (في حالة حركة؛ بدأ في التحرك)\nمثال: تحركت السفينة",
 "かいさいび": "تَمْرَة, تَمْر\nمثال: ما تاريخ اليوم؟",
 "かいさき": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه)\nمثال: وقعوا في روتين محادثة ممل",
 "かいさく": "تُحْفَة, رَائِعَة / تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء))\nمثال: المسرحية هي اقتباس لرواية قصيرة / استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "かいさつぐち": "خَوْخَة",
 "かいさま": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "かいさん": "تشتت, نثر (عملية تشتيت أو نشر شيء ما)\nمثال: تشتت القوات / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / بَحْرِيّ / تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "かいさんまきがい": "سمكة الحلزون (أسماك صغيرة تشبه الشرغوف تعيش في المياه الباردة مع زعانف حوضية تشكل ممصاً…)",
 "かいざい": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي",
 "かいざいはいれつ": "إنترون (تسلسل من الحمض النووي لجين حقيقي النواة لا يترجم إلى بروتين)",
 "かいざん": "تَغَيُّر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟ / جبل بحري (جبل تحت الماء يرتفع فوق قاع المحيط)",
 "かいし": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / إنهاء, خاتمة (فعل إنهاء شيء ما)\nمثال: إنهاء الاتفاقية / بحار (رجل يخدم كبحار) / مساحة, مسح الأراضي (ممارسة قياس الزوايا والمسافات على الأرض بحيث يمكن رسمها بدقة على خريطة)\nمثال: درس المساحة في الكلية / جَارّ, حَرْف جَرّ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل…)\nمثال: لدي جارة مسلمة. / سَرَاب",
 "かいしかかく": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "かいしき": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "かいしじこく": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "かいしつ": "إِصْلَاح / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "かいして": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "かいしでい": "لبخة الخردل (لبخة تحتوي على مسحوق الخردل الأسود؛ توضع على الجلد كمهيج مضاد أو محمر للجلد)",
 "かいしめ": "زَاوِيَة, رُكْن",
 "かいしゃ": "سَرِيَّة",
 "かいしゃいん": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "かいしゃがえり": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "かいしゃきぎょう": "كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "かいしゃく": "ضرب العنق, قطع الرأس (القتل بقطع الرأس) / مُسَاعَدَة, إِمْدَاد / تَفْسِير",
 "かいしゃくがく": "عِلْم التَّأْوِيل, هِرْمِنْيُوطِيقَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "かいしゃくじっこう": "تَفْسِير",
 "かいしゃくじっこうプログラム": "مُتَرْجِم, مُتَرْجِمَة",
 "かいしゃくじん": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "かいしゃくにん": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "かいしゃくみあい": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "かいしゃにんげん": "موظف ولاؤه للشركة (موظف يكون ولاؤه الأول للشركة بدلاً من زملائه في العمل)",
 "かいしゃめい": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "かいしゃれんが": "طوب رملي جيري, طوب سيليكات الكالسيوم (طوب مصنوع من الرمل والجير المطفأ بدلاً من الطين؛ عادة ما يكون لونه رمادياً…)",
 "かいしゅ": "اِخْتِطَاف",
 "かいしゅう": "جُمْهُور, نَظَّارَة / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / أَصْلَحَ",
 "かいしゅうきん": "شِفَاء, تَعَافِي",
 "かいしゅうしゃ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "かいしゅん": "تَوْبَة / تجديد الشباب (فعل الاستعادة لحالة أكثر شباباً)\nمثال: التجدد السنوي للمناظر الطبيعية / شِفَاء, تَعَافِي",
 "かいしょ": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة) / مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة)\nمثال: رجل ذو دهاء عظيم / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "かいしょう": "مُفَاوَضَات, مُذَاكَرَات / إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة)\nمثال: رجل ذو دهاء عظيم / دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تْسُونَامِي",
 "かいしょうせき": "نيتروكالسيت (الشكل المعدني لنترات الكالسيوم)",
 "かいしょうほ": "أدميرال خلفي, لواء بحري (أدميرال أدنى رتبة من نائب أدميرال)",
 "かいしょうほう": "قانون بحري (فرع القانون الدولي الذي يتعامل مع المياه الإقليمية والدولية أو الشحن أو صيد…) / مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "かいしょく": "إطلاق نار (فعل إطلاق النار من بندقية) / رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود) / إِنْذَار, تَحْذِير (توبيخ حازم)",
 "かいしょくちゅう": "كَوْمَة",
 "かいしん": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد. / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / إِصْلَاح / إله البحر (إله يجسد البحر ويُعتقد عادةً أنه يعيش فيه أو يسيطر عليه) / حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / زلزال بحري (زلزال في قاع البحر) / توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب)",
 "かいしんげき": "سلسلة انتصارات (فترة متصلة من الانتصارات)",
 "かいしんしゃ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "かいしんじゅつ": "جراحة القلب المفتوح (جراحة قلب يتم فيها فتح القفص الصدري، وإيقاف القلب، وتحويل الدم عبر جهاز القلب…)",
 "かいじ": "مُتْعَة, لَذَّة / أَطْلَقَ سَرَاح, حَرَّرَ / اِكْتِشَاف / سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / مغناطيس المجال (مغناطيس يوفر مجالاً مغناطيسياً في دينامو أو محرك كهربائي)",
 "かいじしゃく": "مغناطيس المجال (مغناطيس يوفر مجالاً مغناطيسياً في دينامو أو محرك كهربائي)",
 "かいじつ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "かいじまきせん": "ملف المجال (الملف الكهربائي حول مغناطيس المجال الذي ينتج القوة الدافعة المغناطيسية لإنشاء…)",
 "かいじゅ": "شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من…) / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "かいじゅう": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش. / ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء) / غَامِض",
 "かいじゅうせき": "شيليت (معدن يستخدم كخام للتنجستن)",
 "かいじゅうぞう": "مزراب (جرغول) (زخرفة تتكون من شكل منحوت بشكل غريب لشخص أو حيوان)",
 "かいじょ": "إنهاء, خاتمة (فعل إنهاء شيء ما)\nمثال: إنهاء الاتفاقية / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث / مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / شهامَة",
 "かいじょう": "قاعة اجتماعات, قاعة تجميع (قاعة يمكن لعدد كبير من الناس التجمع فيها) / دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / ضَخْم, هائِل الكُتْلَة (ذو كُتْلَة كَبيرَة؛ يَحْتَوي عَلى كَمِّيَّة هائِلَة مِن المادَّة) / تَنْقِيح / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / تَنْصِيب / أعلى الدرج, في الطابق العلوي (في طابق أعلى)\nمثال: عاشوا في الطابق العلوي / عاملي (مكون من أو متعلق بالمضروب أو العاملي (رياضيات))",
 "かいじょうじえいたいけいむたい": "شُرْطَة عَسْكَرِيَّة, الشُّرْطَة الْعَسْكَرِيَّة",
 "かいじょうほう": "قانون بحري (فرع القانون الدولي الذي يتعامل مع المياه الإقليمية والدولية أو الشحن أو صيد…) / نَمِيمَة, إِشَاعَة",
 "かいじょしゃ": "مرافق عسكري, مساعد (ضابط يعمل كمساعد عسكري لضابط أعلى رتبة)",
 "かいじょはんのう": "تطهير انفعالي, تنفيس ((التحليل النفسي) تطهير التوترات العاطفية)",
 "かいじん": "رَمَاد, سَكَن / إله البحر (إله يجسد البحر ويُعتقد عادةً أنه يعيش فيه أو يسيطر عليه) / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا. / إله البحر (إله يجسد البحر ويُعتقد عادةً أنه يعيش فيه أو يسيطر عليه)",
 "かいす": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَسَّرَ, أَوَّلَ / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "かいすい": "ماء البحر, ماء مالح (ماء يحتوي على أملاح)",
 "かいすいぎ": "مايوه, ملابس سباحة (رداء ضيق يلبس للسباحة)",
 "かいすいぎょ": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "かいすいじゅん": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "かいすいたんすいか": "تَقْطِير, إِعْذَاب",
 "かいすいぼう": "قبعة سباحة (قبعة محكمة القياس تبقي الشعر جافاً أثناء السباحة)",
 "かいすいめん": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "かいすいよく": "استجمام بحري, سباحة في البحر (الاستحمام أو السباحة في البحر أو المحيط)",
 "かいすう": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "かいする": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَسَّرَ, أَوَّلَ / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "かいずか": "تلة نفايات أثرية ((علم الآثار) كومة من النفايات المنزلية تحتوي على أصداف وعظام حيوانات تحدد موقع…)",
 "かいせい": "قِيَامَة / إعادة تكوين, تجدد (التشكيل مرة أخرى (خاصة مع تحسينات أو إزالة العيوب)؛ التجديد وإعادة التأسيس) / طقس جيد (طقس مناسب للأنشطة الخارجية) / تَنْقِيح / إعادة تأسيس, استعادة (الاستعادة إلى حالة سابقة)\nمثال: أدت التمارين المنتظمة إلى استعادة قدرته على التحمل / بَحْرِيّ / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "かいせいあん": "تَعْدِيل",
 "かいせいどうぶつ": "حيوان بحري, كائن بحري (أي من الحيوانات العديدة التي تعيش في البحر بما في ذلك الأسماك والرخويات والعديد…)",
 "かいせき": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة) / وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت. / تَحْلِيل",
 "かいせきがく": "تَحْلِيل",
 "かいせきき": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "かいせききかがく": "هندسة إحداثية, هندسة تحليلية (استخدام الجبر لدراسة الخصائص الهندسية)",
 "かいせきこ": "بُحَيْرة شاطِئَة, لَاجُون (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "かいせきせい": "تحليلية (خاصية كون الشيء تحليلياً)",
 "かいせきぶ": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "かいせきりょうり": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "かいせつ": "تَفْسِير, شَرْح / حيود (عندما يمر الضوء بحواف حادة أو يمر عبر شقوق ضيقة تنحرف الأشعة وتنتج أهداباً من…) / تَأْسِيس",
 "かいせつこうし": "محزز حيود (جهاز بصري يتكون من سطح به العديد من الأخاديد المتوازية؛ يشتت شعاع الضوء (أو…)",
 "かいせつしゃ": "مُعَلِّق / مُؤَسِّس, مُؤَسِّسَة",
 "かいせつしょ": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل)",
 "かいせん": "خِطْبَة, خُطُوبَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة / دَارَة (لا جمع له) / اِنْتِخَاب, اِنْتِخَابَات / جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس. / سفينة بضائع, سفينة شحن (سفينة مصممة لحمل البضائع) / معركة بحرية (معركة ضارية بين أساطيل بحرية) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه. / مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "かいせんきょく": "روندو (شكل موسيقي غالباً ما يكون الحركة الأخيرة للسوناتا)",
 "かいせんきんけんばん": "كُفَّة مُدَوَّرَة",
 "かいせんけんばん": "كُفَّة مُدَوَّرَة",
 "かいせんしょう": "صلصة البط, صلصة هويسين (تابل صيني سميك حلو ولاذع)",
 "かいせんじょう": "مُشَوَّه, مُلْتَوٍ (ملتوٍ بشدة (خاصة كما في الألم أو الصراع))",
 "かいせんせつだん": "عقبة خفية, عقدة (عقبة غير متوقعة)",
 "かいせんそうだつ": "جِدَال (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: (…)\nمثال: لا جدال في ذلك.",
 "かいせんちゅう": "سوسة الجرب (سوس مبيض يهاجم جلد البشر والحيوانات الأخرى)\nمثال: سوس الجرب يسبب الجرب",
 "かいせんどうみゃく": "شريان منعطف (أي من عدة شرايين منحنية مزدوجة)",
 "かいせんは": "حزب الحرب (حزب سياسي يدعم الحرب)",
 "かいぜつ": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين)",
 "かいぜん": "تحسين, تلطيف (فعل تخفيف العلل والتغيير للأفضل) / سَعِيد\nمثال: فرح فاضل كثيرا. / مُعَتَّق ((عَنِ التَّبْغ) مُعَتَّق كَعَمَلِيَّة حِفْظ) / مَعْزُول, مُنْعَزِل (بَعِيدٌ وَمُنْفَصِلٌ مَادِّيًّا أَوِ اجْتِمَاعِيًّا)",
 "かいそ": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة / خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار. / مُؤَسِّس, مُؤَسِّسَة",
 "かいそう": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة / إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً / رحلة فارغة, مركبة فارغة (قطار أو حافلة أو سيارة أجرة تسافر فارغة (بدون ركاب أو حمولة)) / إعادة دفن (فعل الدفن مرة أخرى) / إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة / نجيل بحري / عُشْب بَحْرِيّ / صِنْف, صَنْف\nمثال: اقرأ هذا الفصل. / دحر, هزيمة منكرة (هزيمة ساحقة) / شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش) / إشْقِيل, بَصَل الفَأْر",
 "かいそうか": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات)",
 "かいそうかメニュー": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "かいそうがたメニュー": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "かいそうき": "مُذَكَّرَات, مُذَكِّرَات / مبعد (أداة جراحية تمسك حواف الشق الجراحي للخلف)",
 "かいそうこうぞう": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات)",
 "かいそうしゃ": "ثاكِل, حَزِين (شخص يشعر بالحزن (خاصة الحزن على شخص مات)) / رحلة فارغة, مركبة فارغة (قطار أو حافلة أو سيارة أجرة تسافر فارغة (بدون ركاب أو حمولة))",
 "かいそうちょうせき": "أوليغوكلاز, بلاجيوكلاز (أي من سلسلة الفلسبارات ثلاثية الميل التي تشكل الصخور)",
 "かいそうてん": "وكيل شحن بحري (وكيل مالك السفينة)",
 "かいそうでんしゃ": "رحلة فارغة, مركبة فارغة (قطار أو حافلة أو سيارة أجرة تسافر فارغة (بدون ركاب أو حمولة))",
 "かいそうぶんるいたいけい": "نظام تصنيف هرمي (نظام تصنيف حيث يتم ترتيب المدخلات بناءً على بنية هرمية)",
 "かいそうるい": "عُشْب بَحْرِيّ",
 "かいそうろく": "مُذَكَّرَات, مُذَكِّرَات",
 "かいそうシーン": "استرجاع فني, فلاش باك (انتقال (في الأعمال الأدبية أو المسرحية أو الأفلام) إلى حدث أو مشهد سابق يقطع…)",
 "かいそうメニュー": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "かいそく": "تَكْوِين\nمثال: العدالة مضمونة في الدستور. / سرعة (معدل سريع)",
 "かいそくしゅ": "جدرة, ندبة متضخمة (نسيج ندبي وردي مرتفع في موقع إصابة؛ ينتج عن إصلاح الأنسجة المفرط)",
 "かいそくちょう": "بِسُرْعَة, بِنَشَاط (بإيقاع سريع وحيوي)\nمثال: العب هذا القسم بسرعة",
 "かいそろえる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "かいぞう": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى) / فَظّ / فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه…) / عَزْم, عُزْم",
 "かいぞうど": "عَزْم, عُزْم",
 "かいぞうにんげん": "سَايْبُورْغ",
 "かいぞうりょく": "دقة, قدرة التمييز (قدرة المجهر أو التلسكوب على قياس الفصل الزاوي للصور المتقاربة)",
 "かいぞえ": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري. / وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف) / ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "かいぞえにん": "إشبين العريس (الإشبين الرئيسي في حفل الزفاف) / ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "かいぞく": "قُرْصَان / هُوَي",
 "かいぞくき": "العلم الأسود, علم القراصنة (علم يحمل عادة جمجمة بيضاء وعظمتين متقاطعتين على خلفية سوداء؛ يشير إلى سفينة…)",
 "かいぞくこうい": "قَرْصَنَة",
 "かいぞくせん": "سفينة قراصنة (سفينة يديرها قراصنة)",
 "かいぞくはんソフトウェア": "قَرْصَنَة",
 "かいぞくばん": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "かいたい": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل. / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / تبضيع, تشريح (القطع بغرض الفصل إلى قطع) / حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير. / كَسَل / إساءة أداء, سوء تصرف (أداء عمل مشروع بطريقة خاطئة أو ضارة) / حَلَّ, سَرَّحَ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "かいたいこうじょう": "ورشة تفكيك سيارات (مكان يتم فيه تفكيك السيارات المسروقة للحصول على قطع غيارها)",
 "かいたいや": "مُخَرِّب / ساحة خردة (حقل يتم فيه جمع الخردة وتخزينها لإعادة بيعها)",
 "かいたく": "استصلاح, تدوير (استعادة المواد المفيدة من النفايات)\nمثال: إصلاح الأطفال الجانحين / رَائِد",
 "かいたくしゃ": "رَائِد",
 "かいだい": "مُلَخَّص / هَضْبَة",
 "かいだす": "شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "かいだめ": "اِكْتِنَاز",
 "かいだるい": "مُتْعَب, تَعْبَان",
 "かいだん": "تفاوض, محادثات (مناقشة تهدف إلى التوصل إلى اتفاق)\nمثال: استمرت مفاوضات الاستحواذ عدة أيام / سَلَالِم / حَلّ (فعل الحل (لمنظمة أو جماعة))\nمثال: واجهت الأوركسترا احتمال الحل",
 "かいだんしつ": "عَمُود السُّلَّم",
 "かいだんしょうこうき": "تلفريك الكراسي, مصعد الكراسي (مصعد تزلج يجلس فيه الركاب (المتزلجون أو السياح) ويُنقلون صعوداً أو هبوطاً على…)",
 "かいだんたんす": "كُمُودِينُو, أَدْرَاجِيَّة",
 "かいだんのふきぬけ": "عَمُود السُّلَّم",
 "かいだんタンス": "كُمُودِينُو, أَدْرَاجِيَّة",
 "かいだんホール": "عَمُود السُّلَّم",
 "かいちく": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "かいちゅう": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة…) / إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "かいちゅうかがみ": "مرآة جيب, مرآة صغيرة (مرآة صغيرة محمولة باليد عادة ما تكون في علبة معدنية أو بلاستيكية مستديرة…)",
 "かいちゅうしょう": "إسكارس, داء الصفر (إصابة أمعاء الإنسان بديدان الصفر الأسطوانية)",
 "かいちゅうでんとう": "مَشْعَل",
 "かいちゅうどけい": "ساعة جيب (ساعة تُحمل في جيب ساعة صغير)",
 "かいちゅうばな": "بِحَجْم الجَيْب (صغير بما يكفي لحمله في جيب الثوب)",
 "かいちゅうもの": "جِزْدَان, جُزْدَان",
 "かいちょう": "رَئِيس, رَئِيسَة / اللَفَائِفِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / اِنْسِجَام, تَوَافُق / طائر بحري (طائر يتردد على المياه الساحلية والمحيط المفتوح: النوارس، البجع، الأطيش، الغاق…) / إِظْهَار, عَرْض / فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا)\nمثال: نظرة كاشفة / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / تَدَرُّج / باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي)",
 "かいちょうえん": "التهاب اللفائفي (التهاب اللفائفي)",
 "かいちょうせき": "أَنُورْثَيْت",
 "かいちょうふん": "جوانو, ذرق الطيور (فضلات الطيور البحرية؛ تستخدم كسماد)",
 "かいちょく": "تَعْمِيمِيّ, دَوْرِيّ (مُعَدٌّ لِلتَّوْزِيعِ الوَاسِعِ) / إِنْذَار, تَحْذِير (توبيخ حازم)",
 "かいちん": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / نوم (توقف الوعي وانخفاض معدل الأيض)",
 "かいつう": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "かいつけ": "شِرَاء, اِشْتِرَاء / عَادِيّ",
 "かいつける": "شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "かいつぶり": "غطاس صغير (غطاس أوروبي صغير) / غطاس (طائر مائي صغير مدمج الجسم بالكامل تقريباً يبني أعشاشاً عائمة؛ يشبه الغواص ولكنه…)",
 "かいつまむ": "لَخَّصَ, اِخْتَصَرَ",
 "かいづか": "تلة نفايات أثرية ((علم الآثار) كومة من النفايات المنزلية تحتوي على أصداف وعظام حيوانات تحدد موقع…)",
 "かいて": "مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز.",
 "かいてい": "تَنْقِيح / قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)\nمثال: 海の植物は海底に付着して育つ。 — النباتات البحرية تنمو في قاع البحر. / تَحْتَ بَحْرِيّ, غَوَّاصِيّ (تحت سطح البحر) / مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / سَلَالِم / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "かいていじしん": "زلزال بحري (زلزال في قاع البحر)",
 "かいてき": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "かいてきさ": "رَاحَة",
 "かいてしじょう": "سوق المشترين (سوق يكون فيه عدد الأشخاص الذين يريدون البيع أكثر ممن يريدون الشراء)",
 "かいてつ": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص))\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "かいてつざくろいし": "أندراديت (عقيق يتكون من سيليكات الكالسيوم والحديد وتتراوح ألوانه من الأصفر والأخضر إلى…)",
 "かいてどくせん": "احتكار الشراء ((اقتصاد) سوق يتم فيه عرض السلع أو الخدمات من قبل عدة بائعين ولكن يوجد مشترٍ…)",
 "かいてん": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة / تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أصيب برضوض شديدة بسبب انقلاب زلاجته بسرعة عالية / تَزَلُّجٌ مُتَعَرِّج",
 "かいてんいす": "كرسي دوار (كرسي يدور على قاعدته)",
 "かいてんうんどう": "دوران حلزوني (عملية الدوران في دائرة أو حلزون)\nمثال: قامت الطائرة بثلاث دورات قبل أن تتحطم",
 "かいてんきょうぎ": "تَزَلُّجٌ مُتَعَرِّج",
 "かいてんぎ": "جَيْرُوسْكُوب",
 "かいてんけい": "تاكومتر, مقياس سرعة الدوران (أداة قياس للإشارة إلى سرعة الدوران)",
 "かいてんし": "عَمُود نَاقِل الْحَرَكَة",
 "かいてんしきかんそうき": "مجفف قلّاب, نشافة هوائية (مجفف ملابس يقوم بتدوير الملابس المبللة داخل أسطوانة مع هواء ساخن)",
 "かいてんしきけんじゅう": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس.",
 "かいてんしきだんそう": "أُسْطُوَانَة",
 "かいてんしきん": "صندوق متجدد (صندوق يهدف، في حال الاقتراض منه أو استخدامه، إلى تجديده ليتم إقراضه أو إنفاقه…)",
 "かいてんすし": "حِزَام نَاقِل (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "かいてんずし": "حِزَام نَاقِل (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "かいてんそくどけい": "تاكومتر, مقياس سرعة الدوران (أداة قياس للإشارة إلى سرعة الدوران)",
 "かいてんだい": "قرص دوار (منصة أفقية دائرية تقوم بتدوير اسطوانة الفونوغراف أثناء تشغيلها)",
 "かいてんだえんたい": "شبه كرة, كرواني (شكل يتولد عن تدوير قطع ناقص حول أحد محاوره)",
 "かいてんだんそう": "أُسْطُوَانَة",
 "かいてんだんそうしきけんじゅう": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس.",
 "かいてんとびら": "باب دوار (باب يتكون من أربعة قواطع متعامدة تدور حول محور مركزي؛ باب مصمم لمعادلة ضغط…)",
 "かいてんばいばい": "مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم)",
 "かいてんへんりゅうき": "محول دوار, محول متزامن (محول كهربائي يتكون من آلة متزامنة تحول التيار المتردد إلى تيار مستمر أو العكس)",
 "かいてんもくば": "أرجوحة دوارة, دوامة الخيل (آلة دوارة كبيرة بها مقاعد لركوب الأطفال للتسلية)\nمثال: إذا خسرنا الانتخابات، فإن دوامة التشريع بأكملها ستبدأ من جديد",
 "かいてんよく": "جناح دوار, شفرة دوارة (السطح الانسيابي الطويل الذي يدور لتوفير الرفع الذي يدعم طائرة الهليكوبتر في…)",
 "かいてんりつ": "دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)",
 "かいてんドア": "باب دوار (باب يتكون من أربعة قواطع متعامدة تدور حول محور مركزي؛ باب مصمم لمعادلة ضغط…)",
 "かいとう": "دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد)\nمثال: رحبوا بذوبان الجليد الربيعي / تخفيف الضغط (تخفيف الضغط (خاصة إعادة شخص مضغوط تدريجياً إلى الضغط الجوي)) / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد. / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / تحلل السكر / جمعية سرية (جمعية تخفي أنشطتها عن غير الأعضاء) / تحول (فعل التغيير في الممارسة أو العادة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين / حج القحف (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند…)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "かいとうしゃ": "رَادّ, مُجِيب (يقوم بالرد أو الإجابة)",
 "かいとうしゅじゅつ": "حج القحف (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند…)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "かいとうじゅつ": "حج القحف (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند…)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "かいとり": "شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك. / استبدال, مقايضة (عنصر من الممتلكات يتم تقديمه كجزء من الدفع مقابل عنصر جديد)",
 "かいとる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "かいど": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "かいどう": "تَجْمِيع, مَجْمَع (مصدر جَمَّعَ)\nمثال: أنشؤوا جمعية سينمائية. / كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟ / طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / تفاح بري جنوبي (شجرة صغيرة أو شجيرة من جنوب شرق الولايات المتحدة؛ تزرع للزينة لأزهارها الوردية…) / تفاح سيبيري بري (تفاح بري آسيوي يزرع في العديد من الأصناف لفاكهته الحمراء الصغيرة الحمضية عادة…)",
 "かいどうしきゆうぎき": "آلة بيع, آلة قمار (آلة يتم تشغيلها عن طريق إدخال عملة معدنية في فتحة)",
 "かいどき": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "かいどく": "فَكَّ تَّعْمِيَة, فَكَّ مُعَمَّى / صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "かいな": "ذِرَاع / عَضُد (مُعِين؛ قُوَّة)",
 "かいない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "かいなし": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "かいなで": "سَطْحِيّ",
 "かいなひねり": "ثُنَائِيُّ اليَد (يتطلّب يدَيْن أو مُصمَّم لشخصَيْن)\nمثال: جراح بارع باليدين",
 "かいならし": "أَلِيف\nمثال: إلى أية روضة ذهبت؟",
 "かいならす": "أَلِيف\nمثال: إلى أية روضة ذهبت؟",
 "かいなん": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "かいなんきゅうじょ": "صَلَاة اَلْعَصْر, عَصْر",
 "かいなんぷう": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "かいになる": "صَمَتَ, سَكَتَ",
 "かいにゅう": "تَدَخُّل, تَطَفُّل",
 "かいにん": "إِقَالَة / حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "かいぬし": "مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز. / مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "かいね": "سعر الشراء (السعر الذي يتم شراء شيء ما به فعلياً)",
 "かいは": "فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "かいはい": "تَنْقِيح",
 "かいはく": "رَمَادِيّ, أَشْيَب",
 "かいはくしつ": "مادة رمادية, مادة سنجابية (نسيج عصبي رمادي يحتوي على أجسام الخلايا والألياف؛ يشكل القشرة المخية المكونة من…)",
 "かいはくずいえん": "شَلَل الْأَطْفَال",
 "かいはつ": "إِعْمَار, تَعْمِير / اِسْتِغْلَال (استخدام الموارد أو الظروف أو الفرص بشكل مثمر أو للحصول على فائدة؛ استغلال شخص…)\nمثال: يبدو أن رئيس القسم يحب استغلال سلطته.",
 "かいはつきょういくきょうかい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "かいはつけいい": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "かいはつしゃ": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو…)",
 "かいはつじぎょう": "إِعْمَار, تَعْمِير",
 "かいはつとじょうこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "かいはつもと": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو…)",
 "かいはん": "تَنْقِيح / نشر (العمل التجاري لإصدار المواد المطبوعة للبيع أو التوزيع)",
 "かいば": "حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي) / حصين (بنية عصبية معقدة (تشبه حصان البحر) تتكون من مادة رمادية وتقع على أرضية كل بطين…) / فَظّ / عَلَف",
 "かいばおけ": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "かいばしら": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "かいばじょうりゅうき": "حصين (بنية عصبية معقدة (تشبه حصان البحر) تتكون من مادة رمادية وتقع على أرضية كل بطين…)",
 "かいばつ": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن)",
 "かいばと": "حمام مستأنس (حمام مستأنس يُربى للرياضة أو الطعام)",
 "かいひ": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / تنحٍّ, رد القاضي ((قانون) استبعاد قاضٍ أو هيئة محلفين بسبب التحيز أو تضارب المصالح) / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "かいひさく": "تَحَاشٍ\nمثال: تجنب الازدحام المروري",
 "かいひせい": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "かいひてき": "مُتَهَرِّب, مُرَاوِغ (غامض أو ملتبس عمداً)",
 "かいひふのう": "حَتْمِيّ",
 "かいひゃく": "خِلْقَة, خَلْق\nمثال: زيري سيء الخلق.",
 "かいひょう": "فقمة حقيقية, فقمة عديمة الأذن (أي من عدة فقمات تفتقر إلى سديلات الأذن الخارجية ولها معطف صلب يشبه الشعر مع…) / ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع / دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد)\nمثال: رحبوا بذوبان الجليد الربيعي",
 "かいひょうざい": "مذيب الجليد, مزيل الجليد (مادة تستخدم لإذابة الجليد؛ يمكن أن تكون على شكل سائل أو بلورات صلبة)\nمثال: عزيزتي، الممر مغطى بالجليد مرة أخرى، أعتقد أننا يجب أن نشتري مذيباً للجليد قبل أن ينزلق شخص ما ويكسر ساقه",
 "かいひん": "سَاحِل, شَاطِئ",
 "かいび": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية…)\nمثال: الكعكة حلوة جدا",
 "かいびゃく": "خِلْقَة, خَلْق\nمثال: زيري سيء الخلق.",
 "かいふ": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة)",
 "かいふう": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "かいふく": "إعادة, استرداد (استعادة الشيء مرة أخرى)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / شِفَاء, تَعَافِي",
 "かいふくかのう": "قابل للاسترداد, قابل للاستعادة (يمكن استرداده أو استعادته)\nمثال: الحقيقة القابلة للاستعادة لحدث ماض",
 "かいふくき": "نَقَاهَة",
 "かいふくしつ": "غرفة الإفاقة (غرفة مستشفى لرعاية المرضى مباشرة بعد الجراحة)",
 "かいふくしゅじゅつ": "بضع البطن, فتح البطن (شق جراحي في جدار البطن؛ غالباً ما يتم لفحص أعضاء البطن)",
 "かいふくじゅつ": "بضع البطن, فتح البطن (شق جراحي في جدار البطن؛ غالباً ما يتم لفحص أعضاء البطن)",
 "かいふくふかのう": "غير قابل للاسترداد (لا يمكن استرداده أو استعادته)",
 "かいふくふのう": "غير قابل للاسترداد (لا يمكن استرداده أو استعادته)",
 "かいふくようじょうほう": "برنامج زمني, جدول أعمال (خطة منظمة زمنياً للأمور التي يجب الاهتمام بها)",
 "かいふくりょく": "القدرة على التعافي بعد الصدمة",
 "かいぶし": "بقعة, تلطخ (عيب ناتج عن الأوساخ)\nمثال: كانت هناك لطخة على خده",
 "かいぶつ": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "かいぶん": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / قَلْب مُسْتَوٍ / فَضِيحَة / رَمَاد, سَكَن / دفعة, مجموعة (مجموعة من الأشياء أو الأشخاص يتم التعامل معهم معًا)\nمثال: دفعة من الرسائل / مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "かいぶんか": "ثقافة فرعية (مجموعة اجتماعية داخل ثقافة وطنية لها أنماط مميزة من السلوك والمعتقدات)",
 "かいぶんるい": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "かいへい": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب…)\nمثال: هى متزوجة من بحار.",
 "かいへいき": "مِقْلَاد / جهاز ميكانيكي (آلية تتكون من جهاز يعمل وفق مبادئ ميكانيكية) / حَاجِز",
 "かいへいたい": "مُشَاة البَحْرِيَّة",
 "かいへいだん": "مشاة البحرية (أعضاء هيئة من القوات المدربة للخدمة في البر أو البحر)",
 "かいへん": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة / شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ. / نَخْر",
 "かいへんき": "فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول",
 "かいへんまいびょう": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "かいべん": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة…) / مُشْتَرًى مِنَ المَتْجَرِ (مشترى وليس مصنوعاً في المنزل)",
 "かいほ": "سَاحِل, شَاطِئ",
 "かいほう": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها…) / بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري)) / أَطْلَقَ سَرَاح, حَرَّرَ\nمثال: 人質は解放されるだろう。 — سيُفرج عن الرهائن. / مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا. / دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / نَقَاهَة / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / اِحْتَضَنَ, عَانَقَ / ثَدْي / بُشْرَى (الخبر السار) / كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ) / تَطَوُّر / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "かいほうかん": "رُحْب, رَحَب (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: رحب فاضل بليلى.",
 "かいほうぐんぽう": "جَيْش التَحْرِير الشَعْبِيّ الصِينِيّ (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة…)\nمثال: هل كان في الجيش.",
 "かいほうこっせつ": "كسر مركب, كسر مفتوح (كسر عظمي مصحوب بتهتك في الأنسجة الرخوة أو جرح مفتوح)",
 "かいほうし": "نشرة إخبارية (تقرير أو رسالة مفتوحة تقدم أخباراً غير رسمية أو سرية تهم مجموعة خاصة)",
 "かいほうせい": "انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار))\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "かいほうせき": "سيبيوليت, ميرشوم (معدن طيني أبيض)",
 "かいほうち": "النِّسْبَة البُؤْرِيَّة, رَقَم البُؤْرَة (نسبة البعد البؤري إلى قطر نظام عدسة (الكاميرا))",
 "かいほうてき": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "かいほうにおもむく": "حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "かいほうのしんがく": "لاهوت التحرير (شكل من أشكال اللاهوت المسيحي (طوره الكاثوليك في أمريكا الجنوبية) يؤكد على…)",
 "かいほつ": "إِعْمَار, تَعْمِير / اِسْتِغْلَال (استخدام الموارد أو الظروف أو الفرص بشكل مثمر أو للحصول على فائدة؛ استغلال شخص…)\nمثال: يبدو أن رئيس القسم يحب استغلال سلطته.",
 "かいぼう": "تبضيع, تشريح (القطع بغرض الفصل إلى قطع) / تَحْلِيل / اِحْتَضَنَ, عَانَقَ / ثَدْي / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "かいぼうがく": "تَشْرِيح",
 "かいぼうがくしゃ": "مُشَرِّح, مُشَرِّحَة",
 "かいま": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "かいまく": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "かいまくせん": "فَتَّاحَة, مِفَكّ (التي تكثر الفَتْح)",
 "かいまん": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "かいみ": "مُتْعَة, لَذَّة",
 "かいむ": "مَعْدُوم",
 "かいむらさき": "أرجواني صوري (لون أحمر أرجواني زاهٍ؛ كان يرتديه الأباطرة في روما القديمة وبيزنطة)",
 "かいむらさきいろ": "أرجواني صوري (لون أحمر أرجواني زاهٍ؛ كان يرتديه الأباطرة في روما القديمة وبيزنطة)",
 "かいめい": "إيضاح, تبيان (تفسير يزيل عقبات الفهم)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي / حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل…)\nمثال: الحضارة الامازيغية عظيمة. / ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "かいめいしょうほう": "صولميزاسيون (الغناء باستخدام مقاطع الصولفا للدلالة على نغمات سلم دو الكبير)",
 "かいめつ": "تَدْمِير, هَدْم",
 "かいめつてき": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ)",
 "かいめん": "إِسْفَنْج / مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…) / واجِهَة",
 "かいめんか": "تَحْتَ بَحْرِيّ, غَوَّاصِيّ (تحت سطح البحر)",
 "かいめんかがく": "كيمياء السطوح (فرع الكيمياء الذي يدرس العمليات التي تحدث عند الواجهات بين الأطوار (خاصة تلك…)",
 "かいめんかっせいざい": "عَامِل سَطْحِيّ (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "かいめんじょう": "إِسْفَنْجِيّ (يُشبه الإسفنج في قدرته على امتصاص السوائل وإعادتها عند الضغط)",
 "かいめんじょうしょう": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "かいめんちょうりょく": "توتر بين سطحي (توتر سطحي عند السطح الفاصل بين سائلين غير قابلين للامتزاج)",
 "かいめんどうぶつ": "إِسْفَنْج",
 "かいめんへんか": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "かいめんへんどう": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "かいもく": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "かいもとめる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "かいもどし": "إعادة شراء, استرداد (فعل إعادة شراء شيء تم بيعه سابقاً)",
 "かいもの": "تَسَوُّق, شِرَاء",
 "かいものかご": "سلة تسوق (سلة يدوية تستخدم لحمل البضائع أثناء التسوق)",
 "かいものがえり": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "かいものきゃく": "مُتَسَوِّق, مُتَسَوِّقَة",
 "かいものずき": "مدمن تسوق, مهووس بالشراء (متسوق قهري)\nمثال: مدمنو التسوق لا يستطيعون مقاومة الصفقات أبداً",
 "かいものぶくろ": "حقيبة تسوق (حقيبة مصنوعة من البلاستيك أو الورق المقوى (غالباً بمقابض)؛ تستخدم لنقل البضائع…)",
 "かいものリスト": "قائمة تسوق, قائمة مشتريات (قائمة بعناصر غير متجانسة يريدها شخص ما)\nمثال: جاءت النقابة إلى الطاولة بقائمة كاملة من المطالب",
 "かいもん": "تَسَوُّق, شِرَاء / مَضِيق, مُخْتَنَق (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "かいゆ": "شِفَاء, تَعَافِي",
 "かいゆう": "جَوْلَة, نُزْهَة",
 "かいゆうせい": "صلاحية الملاحة (صفة الملاءمة لمرور السفن أو الطائرات)",
 "かいよう": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / قُرْحَة / مَغْفِرَة, غُفْرَان / إِقَالَة / حَمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "かいようがく": "علم المحيطات (فرع العلم الذي يتعامل مع الجوانب الفيزيائية والبيولوجية للمحيطات)",
 "かいようがくしゃ": "عالم محيطات (عالم يدرس الجوانب الفيزيائية والبيولوجية للبحار)",
 "かいようきょうふしょう": "رُهَابُ ٱلْبَحْر",
 "かいようこうこがく": "الآثار الغارقة, علم الآثار البحرية (علم الآثار للمواقع تحت الماء)",
 "かいようしんそうすい": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "かいようせい": "بَحْرِيّ",
 "かいようせいだいちょうえん": "التهاب القولون التقرحي (مرض التهابي مزمن خطير في الأمعاء الغليظة والمستقيم يتميز بنوبات متكررة من آلام…)",
 "かいようせいぶつがく": "علم الأحياء البحرية (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "かいようたいききょく": "الإدارة الوطنية للمحيطات والغلاف الجوي (وكالة في وزارة التجارة تقوم برسم خرائط المحيطات والحفاظ على مواردها الحية…)",
 "かいようてい": "قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)",
 "かいようほう": "قانون بحري (فرع القانون الدولي الذي يتعامل مع المياه الإقليمية والدولية أو الشحن أو صيد…)",
 "かいよく": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر))",
 "かいよせ": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "かいらい": "دُمْيَة",
 "かいらいこっか": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "かいらいし": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "かいらいせいけん": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "かいらいせいふ": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "かいらく": "مُتْعَة, لَذَّة",
 "かいらくげんそく": "مبدأ اللذة ((التحليل النفسي) المبدأ الحاكم للهو؛ المبدأ القائل بأن الرضيع يسعى إلى الإشباع…)",
 "かいらくしゅぎ": "مَذْهَب اَللِّذَّة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب:…)\nمثال: الوجودية مذهب إنساني.",
 "かいらくしゅぎしゃ": "باحث عن اللذة, متعي (شخص تحفزه الرغبة في الملذات الحسية)",
 "かいらくじゅんのう": "تَكَيُّف المُتْعَة, تَكَيُّف اللَذَّة",
 "かいらくせつ": "مَذْهَب اَللِّذَّة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب:…)\nمثال: الوجودية مذهب إنساني.",
 "かいらん": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع)\nمثال: دوران المحيط جزء مهم من المناخ العالمي / فَسَاد / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "かいり": "فك الارتباط, نأى (عملية الإزالة من الارتباط أو الشراكة) / قُنْدُس, سَمُّور / تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين / مِيل بَحْرِيّ",
 "かいりしょう": "اضطراب انشقاقي, اضطراب تفارقي (انفصال شديد لدرجة تنهار معه الوظائف المتكاملة عادة للوعي وإدراك الذات)",
 "かいりせいしょうがい": "اضطراب انشقاقي, اضطراب تفارقي (انفصال شديد لدرجة تنهار معه الوظائف المتكاملة عادة للوعي وإدراك الذات)",
 "かいりせいじんかくしょうがい": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان…)",
 "かいりつ": "مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "かいりていすう": "ثَابِت التَّفَكُّك (ثابت التوازن لتفكك عكسي)",
 "かいりねつ": "حرارة التفكك (الحرارة اللازمة لمادة سائلة لتتفكك إلى مكونات أبسط)",
 "かいりゅう": "تيار محيطي (التدفق المستمر لمياه المحيط السطحية في اتجاه سائد) / انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "かいりゅうはつでん": "تيار محيطي (التدفق المستمر لمياه المحيط السطحية في اتجاه سائد)",
 "かいりょう": "تَحْسِين",
 "かいりょうがた": "اِخْتِلَاف",
 "かいりょうこうじ": "تحسين, تلطيف (فعل تخفيف العلل والتغيير للأفضل)",
 "かいりょうしゅぎ": "إصلاحية (مذهب الإصلاح)",
 "かいりょうばん": "تَكْرِير",
 "かいりょくせき": "جلوكونيت (معدن أخضر يتكون من سيليكات مائية للبوتاسيوم أو الحديد أو المغنيسيوم أو الألمنيوم)",
 "かいるい": "مَحَار",
 "かいるいがく": "جمع الأصداف, علم الأصداف (جمع ودراسة أصداف الرخويات)",
 "かいれい": "سلسلة جبال / خَلَّاب, سَاحِر (جميل بشكل مُبْهِر)",
 "かいれき": "السَّنَة الْجَدِيدَة",
 "かいれつ": "شطر, فلق (عملية الفلق أو الشق)",
 "かいろ": "دَارَة (لا جمع له) / دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "かいろう": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر…)\nمثال: ذهب إلى الرواق.",
 "かいろうちたい": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر…)\nمثال: ذهب إلى الرواق.",
 "かいろうどうけつ": "سلة زهرة فينوس (إسفنج بحري في المياه العميقة له هيكل أسطواني من شبكة زجاجية معقدة)",
 "かいろきこう": "الدوائر الكهربائية (معدات إلكترونية تتكون من نظام من الدوائر)",
 "かいろきばん": "بطاقة الدائرة, لوحة الدائرة (دائرة مطبوعة يمكن إدخالها في فتحات التوسعة في الكمبيوتر لزيادة قدراته)",
 "かいろこうせいようそ": "الدوائر الكهربائية (معدات إلكترونية تتكون من نظام من الدوائر)",
 "かいろしゃだんき": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "かいろず": "تَخْطِيطِيّ, شَكْلِيّ (ممثل في شكل مبسط أو رمزي)",
 "かいわ": "مُحَادَثَة\nمثال: أخذت تكلم الكلب. / اِنْسِجَام, تَوَافُق",
 "かいわい": "جِوَار, قُرْب\nمثال: ينبح كلب في الحي. / مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع.",
 "かいわご": "عَامِّيَّة, دَارِجَة",
 "かいわぶん": "كَلَام مُبَاشِر, مُقْتَبَس",
 "かいわん": "خَلِيج",
 "かいをかさねる": "يقرب",
 "かいん": "مَجْلِس أَدْنَى",
 "かいんぎ": "مَجْلِس أَدْنَى",
 "かいんぎいん": "عضو كونغرس (عضو ذكر في مجلس النواب الأمريكي)",
 "かいグループ": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "かいパン": "سروال قصير, شورت ((تستخدم بصيغة الجمع) سراويل تنتهي عند الركبة أو فوقها)",
 "かいボタン": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "かい撫で": "سَطْحِيّ",
 "かう": "اِحْتَفَظَ, أَبْقَى\nمثال: ナンシーは犬を飼いたがっていますか。 — أتريد نانسي اقتناء كلب. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك. / قِيمَة / كَبَّدَ / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "かうぶり": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "かえ": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / سعر الصرف (الرسم لتبادل عملة دولة بعملة دولة أخرى) / دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "かえうた": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "かえことば": "كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "かえし": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "かえしぬい": "غرزة خلفية (غرزة متداخلة مصنوعة ببدء الغرزة التالية في منتصف الغرزة السابقة)",
 "かえしばり": "غرزة خلفية (غرزة متداخلة مصنوعة ببدء الغرزة التالية في منتصف الغرزة السابقة)",
 "かえしわざ": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة)",
 "かえす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / قَلَبَ / جَازَى / أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "かえすがえす": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "かえだま": "احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة",
 "かえって": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "かえってくる": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "かえで": "قَيْقَب",
 "かえでとう": "سكر القيقب (سكر مصنوع من عصارة شجرة القيقب السكري)",
 "かえな": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في…) / اسم فني (الاسم المستعار لممثل)",
 "かえらぬひと": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "かえり": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / طَيَّة / ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة)",
 "かえりがけ": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "かえりぎわ": "وقت المغادرة (الوقت المقرر لمغادرة وسيلة نقل عامة من نقطة انطلاق معينة)",
 "かえりこと": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "かえりごと": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "かえりざき": "رِيمُونْتَادَا",
 "かえりざく": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "かえりしな": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "かえりつく": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "かえりづゆ": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار…)",
 "かえりみ": "عَاكِسٌ لِلضَّوْء (يُسبِّب الانعكاس أو يحتوي على جهاز عاكس) / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "かえりみられない": "مُتَجَاهَل, مُهْمَل (لم يُؤبَه له؛ أُهمِل عمداً)",
 "かえりみる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني.",
 "かえる": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / إِصْلَاح / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / قَلَبَ / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية. / ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر. / اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / تَبْدِيل, تَبَادُل / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "かえるあんこう": "سمكة الضفدع (سمكة لها فم يشبه فم الضفدع مع طُعم على الخطم)",
 "かえるおよぎ": "سباحة الصدر (طريقة سباحة؛ تُمد الذراعان معاً أمام الرأس وتُسحبان للخلف على الجانبين مصحوبة…)",
 "かえるで": "قَيْقَب",
 "かえるとび": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "かえるのこはかえる": "الْوَلَدُ سُرّ أَبِيهِ",
 "かえん": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة. / لَهَب, شُعْلَة / تمليح (فعل إضافة الملح إلى الطعام)",
 "かえんかぶつ": "بيركلوريد (كلوريد يحتوي على نسبة عالية غير عادية من الكلور)",
 "かえんさい": "شَمَنْدَر, بَنْجَر",
 "かえんそさん": "حمض البيركلوريك (عامل مؤكسد قوي؛ يُكوّن البيركلورات)",
 "かえんそさんえん": "بيركلورات (ملح لحمض البيركلوريك)",
 "かえんびん": "زُجاجَة حَارِقَة, كُوكْتَيْل مُولُوتُوف (قطعة زُجَاج؛ قِنْدِيل)\nمثال: سرقوا زجاجة نبيذي!",
 "かえんほうしゃき": "قَاذِفَة لَهَب",
 "かえんガソリン": "بنزين رصاصي (بنزين معالج بمركب رصاص لتقليل قرقعة المحرك)",
 "かお": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "かおあわせ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج)\nمثال: الاقتران العرضي للمراهقين / مباراة, مواجهة (المزاوجة بين الناس أو الأشياء للمقارنة أو المنافسة)\nمثال: كانت مباراة جيدة لكن الفريق المضيف فاز",
 "かおあわせる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "かおいろ": "بَشْرَة / مَلَامِح",
 "かおかたち": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "かおがほころぶ": "خَشَبَة",
 "かおがみえる": "قابل للتعرف عليه, ممكن تحديد هويته (يمكن التعرف عليه أو تحديده)",
 "かおきき": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "かおく": "مَجْلِس",
 "かおしゃしん": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "かおじゃしん": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "かおじゅう": "جَمِيع أَنْحَاء, كُلّ",
 "かおだし": "تَزَاوُر, زِيَارَة (نشاط القيام بالزيارات)\nمثال: كان الغرض هو الترويج للمنازل والنوادي والتزاور والخدمات الأخرى / حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "かおだち": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "かおだて": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "かおつき": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "かおつなぎ": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي.",
 "かおない": "مُحْرَج, بِٱلْحَرَج",
 "かおなじみ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "かおにもみじをちらす": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "かおにんしき": "التعرف على الوجه, التمييز الوجهي (تحديد هوية بيومتري عن طريق مسح وجه الشخص ومطابقته مع مكتبة من الوجوه المعروفة)\nمثال: استخدموا التعرف على الوجه لرصد الإرهابيين المعروفين",
 "かおばせ": "مَلَامِح",
 "かおぶれ": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "かおぼん": "فَيْس بُوك, فِيس بُوك",
 "かおみしり": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "かおもじ": "رمز تعبيري (تمثيل لتعبير وجهي (مثل الابتسامة أو العبوس) يتم إنشاؤه بكتابة سلسلة من الأحرف…)\nمثال: -( و :-) رموز تعبيرية",
 "かおやく": "رَئِيس, رَئِيسَة",
 "かおり": "أريج, رائحة (أي خاصية تكتشف بواسطة الجهاز الشمي)",
 "かおりがする": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح…)\nمثال: شم تلك الرائحة.",
 "かおりたかい": "رَيًّا, عَبِق",
 "かおりぶくろ": "كيس عطر, وسادة معطرة (كيس ناعم صغير يحتوي على مسحوق معطر؛ يستخدم لتعطير الأشياء في الدرج أو الصندوق)",
 "かおをあからめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "かおをあわす": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "かおをあわせる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "かおをしかめる": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "かおをたてる": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "かおをゆがめる": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "かおん": "تَدْفِئَة / نَبْر, تَأْكِيد\nمثال: اجلس بشكل مريح.",
 "かおアップ": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو…)",
 "かおパンツ": "قناع الوجه (قناع يوفر غطاءً واقياً للوجه في رياضات مثل البيسبول أو كرة القدم أو الهوكي)",
 "かか": "بِصَوْت عَالٍ / أمي, ماما (مصطلحات غير رسمية للأم)",
 "かかあ": "زَوْجَة, اِمْرَأَة",
 "かかい": "حد أدنى ((رياضيات) عدد يساوي أو أقل من أي عدد آخر في مجموعة معطاة)",
 "かかえ": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين) / مُوَظَّف, مُوَظَّفَة",
 "かかえあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "かかえこむ": "اِحْتَضَنَ, عَانَقَ",
 "かかえて": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "かかえぬし": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "かかえる": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / وَظَّفَ",
 "かかえ込む": "اِحْتَضَنَ, عَانَقَ",
 "かかく": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / زَهْرَة كَرَز / مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب. / بطامة (الجزء الخارجي المحمر من النواة العدسية)",
 "かかくきせい": "ضبط الأسعار, مراقبة الأسعار (قيد على الحد الأقصى للأسعار تضعه الحكومة وتحافظ عليه (كما في فترات الحرب أو…)",
 "かかくきょうそう": "حَرْب أَسْعَار, مُنَافَسَة سِعْرِيَّة (منافسة شديدة يقوم فيها المتنافسون بخفض أسعار التجزئة لكسب الأعمال)",
 "かかくせってい": "تسعير (تقييم شيء ما من حيث سعره)",
 "かかくせんそう": "حَرْب أَسْعَار, مُنَافَسَة سِعْرِيَّة (منافسة شديدة يقوم فيها المتنافسون بخفض أسعار التجزئة لكسب الأعمال)",
 "かかくとうせい": "ضبط الأسعار, مراقبة الأسعار (قيد على الحد الأقصى للأسعار تضعه الحكومة وتحافظ عليه (كما في فترات الحرب أو…)",
 "かかくひょう": "قَائِمَةُ أَسْعَار",
 "かかげる": "تَسَكَّعَ / مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / مِرْوَحَة, مروحة",
 "かかさず": "بِجِدّ",
 "かかさん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة",
 "かかし": "فَزَّاعَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية)",
 "かかす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / اِسْتَغْنَى",
 "かかずらう": "شَارَكَ, سَاهَمَ",
 "かかずりあう": "شَارَكَ, سَاهَمَ",
 "かかせない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "かかと": "عَقِب, كَعْب",
 "かかり": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال…)\nمثال: أيمكنك صرف خمسين؟ / حَمْلَة / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم' / تُهْمَة\nمثال: أقوم بشحن هاتفي / صِلَة, صُلَة",
 "かかりあい": "عَلَاقَة, مُنَاسَبَة",
 "かかりいん": "مَسْؤُول\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "かかりうけ": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ:…)",
 "かかりつけ": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل:…)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "かかりつけい": "طبيب الأسرة (ممارس عام يعالج جميع أفراد الأسرة)",
 "かかりつけのいしゃ": "طبيب الأسرة (ممارس عام يعالج جميع أفراد الأسرة)",
 "かかりつけの医者": "طبيب الأسرة (ممارس عام يعالج جميع أفراد الأسرة)",
 "かかりつけ医": "طبيب الأسرة (ممارس عام يعالج جميع أفراد الأسرة)",
 "かかり合い": "عَلَاقَة, مُنَاسَبَة",
 "かかる": "شِبْر / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / شَاب, رَجُل",
 "かかわらず": "رَغْم أَنَّ, رُغْم أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره. / بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "かかわり": "عَلَاقَة",
 "かかわりあい": "عَلَاقَة, مُنَاسَبَة",
 "かかわる": "شَارَكَ, سَاهَمَ / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / غُصَيْن\nمثال: لا تمسك العصا من الوسط.",
 "かかん": "بِلَا تَرَدُّد, عَازِم (يتميز بالسرعة والحزم في اتخاذ القرار)\nمثال: وقف بحزم ضد العدو / تُوَيْج, تاج / إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير. / خَان (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / تَبَادُلِيّ ((عَنْ عَمَلِيَّةٍ ثُنَائِيَّة) مُسْتَقِلٌّ عَنِ التَّرْتِيب)",
 "かかんぐん": "زمرة أبيلية, زمرة إبدالية (زمرة تحقق قانون التبادل)",
 "かかんしょうてき": "مُلْتَحِم, مُتَرَابِط",
 "かかんそくりょう": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته)",
 "かが": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "かがい": "اِعْتِدَاء, حَمْلَة / شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة) / غلاف زهري (مصطلح جماعي للأجزاء الخارجية للزهرة المكونة من الكأس والتويج وتحيط بالأسدية…)",
 "かがいかつどう": "نشاط لا صفي (أنشطة تعليمية لا تقع ضمن نطاق المناهج الدراسية العادية)",
 "かがいしゃ": "مذنب, مرتكب الجريمة (شخص يرتكب مخالفة)",
 "かがく": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم) / كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء. / تثمين, تقدير (تقدير لقيمة شيء ما)\nمثال: وضع تقييماً عالياً للصداقة / عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / شِعْر (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "かがくかん": "متحف العلوم (متحف يجمع ويعرض الأشياء ذات الاهتمام العلمي)",
 "かがくかんそくえいせい": "بحث علمي, مشروع بحثي (البحث في الأسئلة التي تطرحها النظريات والفرضيات العلمية)",
 "かがくきき": "أداة علمية (أداة يستخدمها العلماء)",
 "かがくぎじゅつ": "تِكْنُولُوجْيَا, تِقَانَة",
 "かがくぎじゅつちょうちょうかん": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "かがくけつごう": "رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)",
 "かがくけんきゅう": "بحث علمي, مشروع بحثي (البحث في الأسئلة التي تطرحها النظريات والفرضيات العلمية)",
 "かがくげんそ": "عُنْصُر كِيمِيَائِيّ (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي.",
 "かがくこうがく": "هندسة كيميائية (نشاط تطبيق الكيمياء لحل المشكلات العملية)",
 "かがくこうぎょう": "الصناعات الكيماوية (مصنعو المواد الكيميائية باعتبارهم مجموعة)",
 "かがくこうぎょうきょうかい": "سِي أَي إِي",
 "かがくこうじょう": "مصنع كيميائي (منشأة صناعية يتم فيها إنتاج المواد الكيميائية)",
 "かがくこつ": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "かがくごうせい": "تمثيل كيميائي",
 "かがくさよう": "تغير كيميائي, عملية كيميائية ((في الكيمياء) أي عملية تتحدد بواسطة التركيب الذري والجزيئي وبنية المواد المعنية)",
 "かがくざい": "عامل كيميائي, مادة كيميائية فاعلة (عامل ينتج تفاعلات كيميائية)",
 "かがくしき": "صيغة, صيغة كيميائية (تمثيل لمادة باستخدام رموز لعناصرها المكونة)",
 "かがくしゃ": "كِيمِيَائِيّ / عَالِم, عَالِمَة (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "かがくじっけんしつ": "مختبر كيمياء (مختبر للبحوث في الكيمياء)",
 "かがくじゅようき": "مستقبل كيميائي (مستقبل حسي يستجيب للمنبهات الكيميائية)",
 "かがくせん": "حرب كيميائية (حرب تستخدم عوامل كيميائية لقتل أو إصابة أو شل العدو) / إشعاع أكتيني, إشعاع كيميائي ضوئي (إشعاع كهرومغناطيسي يمكن أن يحدث تفاعلات كيميائية ضوئية)",
 "かがくせんい": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "かがくちしき": "مَعْرِفَة عِلْمِيَّة (المعرفة التي تم جمعها عن طريق الدراسة المنهجية والمُنظَّمة وفق مبادئ عامة)\nمثال: الرياضيات هي الأساس لكثير من المعرفة العلمية",
 "かがくてき": "كِيمَاوِيّ, كِيمِيَائِيّ / عِلْمِيّ",
 "かがくてきさんそようきゅうりょう": "غَادُس\nمثال: قد أثلجت كثيرا.",
 "かがくてきしゃかいしゅぎ": "اشتراكية علمية (اشتراكية مرتبطة بشكل رئيسي بالماركسيين وتقوم أساساً على الاعتقاد بأن القوى…)\nمثال: يعترف ماركس بمساهمة فلسفة هيجل واقتصاديات ريكاردو والاشتراكية الطوباوية لورييه وسانت سيمون وأوين في اشتراكيته العلمية",
 "かがくてきせいしつ": "خاصية كيميائية (خاصية تستخدم لتوصيف المواد في التفاعلات التي تغير هويتها)",
 "かがくてきほうほう": "اَلْمِنْهَج الْعِلْمِيّ",
 "かがくてんびん": "ميزان تحليلي, ميزان كيميائي (ميزان ذو عارضة عالي الدقة يستخدم في التحليل الكيميائي الكمي)",
 "かがくはくぶつかん": "متحف العلوم (متحف يجمع ويعرض الأشياء ذات الاهتمام العلمي)",
 "かがくはんのう": "تَفَاعُل كِيمِيَائِيّ (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "かがくひん": "كِيمَاوِيّ, كِيمِيَائِيّ",
 "かがくぶっしつ": "كيماوي, مادة كيميائية (مادة تُنتج أو تُستخدم في تفاعل ينطوي على تغييرات في الذرات أو الجزيئات)",
 "かがくぶっしつかびんしょう": "عريف الحفل, مذيع الربط (شخص يعمل كمضيف في المناسبات الرسمية (يلقي خطابات تمهيدية ويقدم المتحدثين…)",
 "かがくぶんせき": "تحليل كيميائي, تحليل نوعي (فعل تفكيك مادة إلى عناصرها المكونة)",
 "かがくへいき": "سِلَاح كِيمِيَائِيّ",
 "かがくへいききんしきかん": "منظمة حظر الأسلحة الكيميائية (منظمة دولية لنزع السلاح الكيميائي؛ تدير اتفاقية الأسلحة الكيميائية)",
 "かがくへいこう": "اتزان كيميائي, توازن كيميائي (تفاعل كيميائي يجري فيه التفاعل ومكافئه العكسي بمعدلات متساوية)",
 "かがくへんか": "تغير كيميائي, عملية كيميائية ((في الكيمياء) أي عملية تتحدد بواسطة التركيب الذري والجزيئي وبنية المواد المعنية)",
 "かがくやくひん": "كِيمَاوِيّ, كِيمِيَائِيّ",
 "かがくりょうほう": "عِلَاج كِيمِيَائِيّ",
 "かがくりょうろん": "سْتُويكُيُومِتْرِيّ, قِيَاس اِتِّحَادِيّ ((الكيمياء) العلاقة بين كميات المواد التي تشارك في تفاعل أو تكون مركباً (عادة ما…)",
 "かがくりろん": "نظرية علمية (نظرية تشرح الملاحظات العلمية)\nمثال: يجب أن تكون النظريات العلمية قابلة للتفنيد",
 "かがくエネルギー": "طاقة كيميائية (ذلك الجزء من الطاقة في مادة ما الذي يمكن إطلاقه بواسطة تفاعل كيميائي)",
 "かがけいせい": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "かがし": "فَزَّاعَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية)",
 "かがせ": "فَزَّاعَة",
 "かがち": "حرنكش, كرز أرضي",
 "かがふり": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "かがまる": "قَوْس, قوس",
 "かがみ": "مِرْآة, مراية (أداة لها القابلية على عكس الضوء بطريقة تحافظ على الكثير من صفاتهما الأصلية قبل…)\nمثال: أنظر في المرآة! / نَمُوذَج",
 "かがみいた": "لَجْنَة, لَجْنَة تَحْكِيم",
 "かがみのま": "الغرفة الخضراء, غرفة الاستراحة (غرفة خلف الكواليس في المسرح حيث يستريح المؤدون أو يستقبلون الزوار)",
 "かがみもち": "السَّنَة الْجَدِيدَة",
 "かがむ": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "かがめる": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل)",
 "かがやかしい": "باهِر",
 "かがやき": "سُطُوع",
 "かがやく": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / خَشَبَة",
 "かがやくばかり": "مُشِعّ, مُتَوَهِّج",
 "かがよう": "بريق, تلاعب الضوء (ضوء ضعيف ومرتعش)\nمثال: بريق الألوان على الريش المتقزح",
 "かがり": "مَجْمَرَة, مَنْقَل / مَشْعَل / رفو (فعل إصلاح ثقب في ثوب بخيوط متقاطعة)",
 "かがりび": "مَشْعَل",
 "かがり火": "مَشْعَل",
 "かがる": "غَرَزَة",
 "かがわ": "كَاغَاوَا",
 "かがん": "ضفة النهر / خَان (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "かがんぼ": "ذبابة الكركي, طيثارة (ذباب نحيل طويل الأرجل يشبه البعوض الكبير ولكنه لا يلدغ)",
 "かき": "مَحَار / تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ)\nمثال: و بعد قليل أتى. / سِلَاح نَارِيّ / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار. / سُور / حَاجِز / كاكي (أبو مغازل مسود من نيوزيلندا يُعتبر أحياناً مرحلة لونية من أبو مغازل أبيض الرأس) / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف. / كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق) / سكتة دِمَاغِيَّة",
 "かきあげる": "كَتِف, كِتْف / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "かきあつめる": "مِدَمَّة, مُشْط / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かきあらためる": "إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "かきあらわす": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "かきあわせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "かきいだく": "اِحْتِضَان, حَضْن",
 "かきいれ": "إِدْخَال",
 "かきいれどき": "موسم الذروة (الموسم الذي يكون فيه السفر أكثر نشاطًا والأسعار أعلى)\nمثال: سافروا إلى أوروبا في موسم الذروة",
 "かきいろ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "かきうつす": "نُسْخَة",
 "かきえんげい": "زراعة الزهور (زراعة النباتات المزهرة)",
 "かきおき": "إرَادَة",
 "かきおくる": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "かきおこし": "كَرْشَنَة, نَقْصَوَة",
 "かきおこす": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "かきおろす": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "かきかえ": "إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى) / تَجْدِيد / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "かきかえる": "إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "かきかけ": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه)\nمثال: أعمال غير منتهية",
 "かきかた": "الخط, فن الخط (الكتابة اليدوية الجميلة) / تنسيق, شكل (المظهر العام لمنشور)",
 "かきかんせい": "إدارة النيران, التحكم في الرمي (التحضير لإيصال القذائف إلى الهدف)",
 "かきかんせいそうち": "نظام الائتمان الزراعي (نظام تعاوني وطني للبنوك والجمعيات يوفر الائتمان للمزارعين والشركات ذات الصلة…)",
 "かきがっこう": "مدرسة صيفية (دورة أكاديمية خلال الصيف؛ عادة للدراسة العلاجية أو التكميلية)",
 "かききえる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "かききず": "خَرْبَشَ",
 "かききる": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "かきくどく": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ…)\nمثال: بحث عن المفتاح.",
 "かきくわえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かきけす": "مَحَا, مَحَى",
 "かきこ": "عَارِضَة, عَارْضَة\nمثال: نشر توم الغسيل.",
 "かきことば": "كلمة مكتوبة (الشكل المكتوب للكلمة)\nمثال: بينما الكلمة المنطوقة ترمز لشيء ما، فإن الكلمة المكتوبة ترمز لشيء يرمز لشيء ما",
 "かきこみ": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة. / إِدْخَال / إرسال بالبريد (إرسال رسالة عبر البريد)\nمثال: يشير ختم البريد إلى وقت الإرسال",
 "かきこむ": "مَلَأَ / خَزَنَ (حفظ، إدخر، أودع في مخزن) / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مِجْرَفَة, مِجْرَاف",
 "かきさいばい": "زراعة الزهور (زراعة النباتات المزهرة)",
 "かきしるす": "تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "かきそうろう": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "かきそえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かきそこなう": "خَرَاب, خَرَابَة",
 "かきそんじる": "خَرَاب, خَرَابَة",
 "かきたす": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "かきたてる": "تَفْصِيل, تَفَاصِيل\nمثال: اقرأ هذا الفصل. / خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "かきだし": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "かきだす": "مُقْتَطَف / صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى…)\nمثال: صادرات الجزائر في تزايد.",
 "かきちらす": "خربشة",
 "かきつけ": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "かきつづる": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "かきつらねる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "かきて": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب. / فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "かきとどめる": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "かきとめ": "بَرِيد مُسَجِّل / تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "かきとめゆうびん": "بَرِيد مُسَجِّل",
 "かきとめる": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "かきとり": "كَرْشَنَة, نَقْصَوَة",
 "かきどう": "المسلك التنفسي السفلي (الشعب الهوائية والرئتين)",
 "かきなおし": "إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى)",
 "かきなおす": "إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "かきなぐる": "خربشة",
 "かきなでる": "سكتة دِمَاغِيَّة / دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "かきならす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار / مِدَمَّة, مُشْط",
 "かきぬき": "مُقْتَطَف",
 "かきぬく": "مُقْتَطَف",
 "かきね": "وَشِيع, سِيَاج نَبَاتِيّ / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "かきのき": "خرمة يابانية, كاكي (شجرة آسيوية صغيرة نفضية تحمل فاكهة كبيرة حمراء أو برتقالية صالحة للأكل قابضة)",
 "かきばい": "صَدَفَةُ المَحَّار (صدفة حيوان المحار)",
 "かきびと": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "かきま": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية",
 "かきまぜきそく": "تَهَافَتَ",
 "かきまぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かきまちがい": "تهجئة خاطئة, خطأ إملائي (تهجئة غير صحيحة)",
 "かきまわす": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "かきみだす": "مُسْتَاء, مُمْتَعِض",
 "かきむしる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "かきもじ": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "かきもの": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "かきものづくえ": "طاولة كتابة, مكتب (مكتب للكتابة (عادة بسطح مائل))",
 "かきゃく": "استمرارية, طول نفس (قوة البقاء والاستمرار)\nمثال: تلك المسرحية القديمة في برودواي لديها استمرارية حقاً",
 "かきゃくしゃ": "قاطرات وعربات, مخزون متحرك (مجموعة من المركبات ذات العجلات المملوكة لشركة سكة حديد أو شركة نقل بري)",
 "かきやく": "مُوَظَّف",
 "かきゅう": "لِلشَّبَاب, لِلنَّاشِئَة (يشمل الأشخاص اليافعين أو مُعَدّ لهم)\nمثال: هي أصغر مني بسنتين / إلحاح, استعجال (أهمية ضاغطة تتطلب إجراءً سريعاً)\nمثال: إلحاح حاجته / كُرَة نَارِيَّة / كرة نارية, نيزك متفجر (نيزك مضيء بشكل خاص (ينفجر أحياناً))",
 "かきゅうき": "شاحن فائق (ضاغط يدفع المزيد من الأكسجين إلى أسطوانات محرك الاحتراق الداخلي)",
 "かきゅうさいばんしょ": "محكمة أدنى, محكمة ابتدائية (أي محكمة يمكن استئناف قراراتها أمام محكمة أعلى)",
 "かきゅうしん": "محكمة أدنى, محكمة ابتدائية (أي محكمة يمكن استئناف قراراتها أمام محكمة أعلى)",
 "かきゅうせい": "طالب مبتدئ (طالب جامعي ليس في السنة النهائية بعد)",
 "かきゅうてきすみやかに": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "かきょ": "ترمل (حالة كون المرأة أرملة لم تتزوج مرة أخرى) / مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "かきょう": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي)\nمثال: مشهد فراش الموت هو ذروة المسرحية / مدرب, معلم خاص (شخص يعطي تعليمات خاصة (كما في الغناء أو التمثيل، إلخ)) / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "かきょく": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "かきわける": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "かきん": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / تُهْمَة\nمثال: أقوم بشحن هاتفي / خَرْبَشَ / عَيْبٌ / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "かきんコレラ": "كوليرا الطيور (مرض إسهالي حاد (خاصة للدجاج) تسببه الكائنات الحية الدقيقة التي تسبب التسمم…)",
 "かきんペスト": "طاعون الطيور (أي من مرضين فيروسيين حادين يصيبان الطيور الداجنة؛ يتميزان برفض الأكل وارتفاع…)",
 "かきフライ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "かき乱す": "مُسْتَاء, مُمْتَعِض",
 "かき傷": "خَرْبَشَ",
 "かき入れ時": "موسم الذروة (الموسم الذي يكون فيه السفر أكثر نشاطًا والأسعار أعلى)\nمثال: سافروا إلى أوروبا في موسم الذروة",
 "かき切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "かき口説く": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ…)\nمثال: بحث عن المفتاح.",
 "かき合わせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "かき回す": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "かき抱く": "اِحْتِضَان, حَضْن",
 "かき撫でる": "سكتة دِمَاغِيَّة / دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "かき消える": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "かき消す": "مَحَا, مَحَى",
 "かき混ぜた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "かき混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "かき混ぜ規則": "تَهَافَتَ",
 "かき立てる": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "かき込む": "مِجْرَفَة, مِجْرَاف",
 "かき集める": "مِدَمَّة, مُشْط",
 "かき鳴らす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "かぎ": "زِرّ / قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه…)\nمثال: يحاول توم كسر القفل. / خَطَّاف / تِكْنُولُوجْيَا, تِقَانَة",
 "かぎあてる": "يَشُمّ, يَكْتَشِف",
 "かぎあな": "ثقب المفتاح (الثقب الذي يتم إدخال المفتاح فيه)",
 "かぎかっこ": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "かぎがかかる": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه…)\nمثال: يحاول توم كسر القفل.",
 "かぎがた": "خُطَّافِيّ الشَّكْل (على شكل خُطّاف)",
 "かぎぐすり": "استنشاقي, شهيقي (يقوم بالاستنشاق أو يخدم عملية الاستنشاق)\nمثال: مسام شهيقي",
 "かぎざき": "تمزيق, شق (عملية شق أو تمزيق شيء ما)\nمثال: قام بتمزيق الظرف بقوة",
 "かぎじゅうじ": "صَلِيب مَعْقُوف",
 "かぎじょう": "خُطَّافِيّ, شَبِيه بِالخُطَّاف (له شكل الخطاف أو يشبهه خاصة في القدرة على الإمساك والتعلق)",
 "かぎだす": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد.",
 "かぎっこ": "طفل المفتاح (طفل في سن المدرسة يبقى في المنزل دون إشراف الكبار لجزء من اليوم (خاصة بعد…)",
 "かぎつける": "يَشُمّ, يَكْتَشِف",
 "かぎづめ": "مِخْلَب, بُرْثُن",
 "かぎとる": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح…)\nمثال: شم تلك الرائحة. / حَاسَّة\nمثال: لديهم حس الفكاهة.",
 "かぎなり": "خُطَّافِيّ, شَبِيه بِالخُطَّاف (له شكل الخطاف أو يشبهه خاصة في القدرة على الإمساك والتعلق)",
 "かぎのて": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "かぎの手": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "かぎばり": "خَطَّاف",
 "かぎばりあみ": "كُرُوشِيه",
 "かぎむし": "حاملات المخالب, دودة مخملية (أي من الحيوانات آكلة اللحوم العديدة التي تشبه الديدان ذات الجلد المخملي الشائعة…)",
 "かぎゃく": "سادية / عَكُوس, قَابِل لِلاِنْعِكَاس (قادر على اتّخاذ أو إنتاج أيّ من حالتين)\nمثال: ارتفاع ضغط الدم القابل للعكس / عَكُوْسَة",
 "かぎゃくあい": "سادية",
 "かぎゃくしゅみ": "سادية",
 "かぎゃくしん": "سادية",
 "かぎゃくせい": "انْعِكَاسِيَّة, قَابِلِيَّة لِلْعَكْس (صفة القابلية للعكس في أي اتجاه)",
 "かぎゃくせいあい": "سادية",
 "かぎゃくせいあいしゃ": "سادي (شخص يحصل على المتعة من إلحاق الألم بالآخرين)",
 "かぎゃくせいよく": "سادية",
 "かぎゃくてき": "عَكُوس, قَابِل لِلاِنْعِكَاس (قادر على اتّخاذ أو إنتاج أيّ من حالتين)\nمثال: ارتفاع ضغط الدم القابل للعكس / سادى",
 "かぎゃくカウンタ": "عَدَّاد",
 "かぎや": "قَفَّال, قَفَّالَة",
 "かぎゅう": "حَلَزُون / قوقعة (الأنبوب الحلزوني الشكل (في الأذن الداخلية ملفوف حول العُميد) حيث تتحول…)",
 "かぎゅうかく": "قوقعة (الأنبوب الحلزوني الشكل (في الأذن الداخلية ملفوف حول العُميد) حيث تتحول…)",
 "かぎゅうかくじょう": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل)",
 "かぎょう": "شركة عائلية (شركة مملوكة بالكامل لأعضاء عائلة واحدة) / تِجَارَة / عمل منزلي, واجب مدرسي (عمل، مثل العمل المدرسي أو العمل بالقطعة، يتم في المنزل)",
 "かぎり": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / دَرَجَة / النِهاية / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "かぎりある": "متناهٍ, محدود (مقيد أو محدود في الحجم أو المدى المكاني أو الزماني)",
 "かぎりない": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "かぎりなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "かぎる": "حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "かぎわ": "حلقة المفاتيح (حلقة دائرية من المعدن لحمل المفاتيح)",
 "かぎをかける": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه…)\nمثال: يحاول توم كسر القفل.",
 "かぎタバコ": "نَشُوق",
 "かぎホック": "خطاف وعروة (نوع من أدوات التثبيت المستخدمة في الملابس)",
 "かぎ出す": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد.",
 "かぎ十字": "صَلِيب مَعْقُوف",
 "かぎ取る": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح…)\nمثال: شم تلك الرائحة. / حَاسَّة\nمثال: لديهم حس الفكاهة.",
 "かぎ薬": "استنشاقي, شهيقي (يقوم بالاستنشاق أو يخدم عملية الاستنشاق)\nمثال: مسام شهيقي",
 "かぎ裂き": "تمزيق, شق (عملية شق أو تمزيق شيء ما)\nمثال: قام بتمزيق الظرف بقوة",
 "かぎ針": "خَطَّاف",
 "かぎ針編み": "كُرُوشِيه",
 "かく": "سكتة دِمَاغِيَّة / كُلّ / تَرْتِيب, دَرَجَة (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / طَرِيقَة, مِنْهَج / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر. / نِوَاة / سِلَاح نَوَوِيّ / نَوَاة / زَاوِيَة / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من…)\nمثال: لدى الفيل أنف طويل. / استجواب قسري, الدرجة الثالثة (استجواب يصاحبه غالبًا تعذيب لانتزاع معلومات أو اعتراف) / ضَيْف, زَائِر / زَبُون, عَمِيل / تفتيت, شطف (عملية شطف جزء من شيء ما) / نَقْص, عَدَم وُجُود / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / خَرْبَشَ / مِجْرَفَة, مِجْرَاف / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / تَخَيَّلَ, تَصَوَّرَ / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة) / ثَانٍ, تاني\nمثال: لن أفعلها ثانية. / مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / أَكِيد\nمثال: لديك بعض الكتب. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة. / حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / إِبْرَة, شَوْكَة",
 "かくあげ": "تَرْقِيَة",
 "かくい": "الْجَمِيع, كُلّ شَخْص / اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かくいう": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "かくいがく": "طب نووي (فرع الطب الذي يستخدم المواد المشعة إما لتصوير جسم المريض أو لتدمير الخلايا…)",
 "かくいしょく": "نقل نواة الخلية الجسدية (نقل نواة الخلية ومادتها الوراثية من خلية إلى أخرى)",
 "かくいつ": "اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل))",
 "かくいつか": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار))\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "かくいつしゅぎ": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار))\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "かくいつてき": "زَيّ, زِي",
 "かくいどり": "وَطْوَاط, خُفَّاش",
 "かくいん": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء)",
 "かくう": "مُخْتَلَق / جَوِّيّ, هَوَائِيّ",
 "かくうえ": "أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "かくうてつどう": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "かくうんどうりょう": "زخم زاوي (حاصل ضرب زخم جسم دوار وبعده عن محور الدوران)\nمثال: أي جسم دوار له زخم زاوي حول مركز كتلته",
 "かくえき": "لَامِع, نَيِّر",
 "かくか": "ثمرة نووية, حسلة (فاكهة لحمية غير متفتحة ذات بذرة واحدة: مثل اللوز والخوخ والبرقوق والكرز والخمان…) / تقرن (عملية عضوية يتم فيها ترسيب الكيراتين في الخلايا وتصبح الخلايا قرنية (كما في…) / صُلْبُ القِشْرَةِ (لِلْحَيَوَانَاتِ أَوِ النَّبَاتَاتِ الَّتِي لَهَا صَدَفَةٌ أَوْ قِشْرَةٌ…)",
 "かくかがく": "كيمياء إشعاعية, كيمياء نووية (كيمياء المواد المشعة)",
 "かくかく": "باهِر / نقيق (تلفظ أجش خشن (كما للضفدع)) / بصلابة, بوعورة (بطريقة وعرة) / مُتَقَطِّع",
 "かくかしょう": "تقرن (حالة جلدية تتميز بفرط نمو طبقات الجلد القرنية)",
 "かくかそくど": "تَسَارُع زَاوِيّ ((الفيزياء) معدل تغير السرعة الزاوية لجسم يدور)",
 "かくかぞく": "أسرة نووية (أسرة تتكون من الوالدين وأطفالهم وجدي أحد الزوجين)",
 "かくかっこ": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "かくかん": "موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات…)",
 "かくがい": "شَاذّ",
 "かくがた": "نمط نووي (مظهر التركيب الصبغي لخلية جسدية في فرد أو نوع (بما في ذلك عدد وترتيب وحجم وهيكل…) / مُسْتَطِيل (مُنْحَرِف عَن شَكْل المُرَبَّع أَوْ الدَّائِرَة بِاسْتِطالَتِه في اتِّجاه واحِد)",
 "かくがっこ": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "かくがり": "قَصَّة قَصِيرَة جِدّاً (قصة شعر قصيرة جداً؛ عادة للرجال أو الأولاد)",
 "かくがん": "شيرت, صخر صواني (نوع من السيليكا يحتوي على كوارتز دقيق التبلور)",
 "かくきょり": "مسافة زاوية (الفصل الزاوي بين جسمين كما يدركه المراقب)\nمثال: سجل المسافات الزاوية بين النجوم",
 "かくぎ": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "かくぎゅう": "مصارعة الثيران (استعراض إسباني أو برتغالي أو أمريكي لاتيني؛ يقوم فيه الماتادور بمناوشة (وعادة)…)",
 "かくぎょう": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من…)\nمثال: لدى الفيل أنف طويل.",
 "かくぎり": "زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام…)",
 "かくけつまくえん": "التهاب القرنية والملتحمة (التهاب القرنية والملتحمة)",
 "かくげん": "قَوْل / إقرار, تأكيد (إعلان يتم التأكيد عليه بقوة (كما لو لم تكن هناك حاجة إلى أدلة داعمة))",
 "かくこう": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من…)\nمثال: لدى الفيل أنف طويل.",
 "かくことができない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "かくことのできない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "かくご": "تأهب, حماس (استعداد فوري)\nمثال: استعداد لمواصلة المناقشات / عَزْم, عُزْم / اِسْتِقَالَة, اِسْتِعْفَاء / عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف. / خَبَر (بلاه وامتحنه ليعرف ما يُمكن عنه؛ عرفه على حقيقته بعد أن جربّه)\nمثال: زيري عنده خبرة.",
 "かくごおり": "مُكَعَّبُ ثَلْجٍ",
 "かくさ": "تَبَايُن, تَفَاوُت (عدم المساواة أو الاختلاف في جانب ما) / مدى, قدرة",
 "かくさく": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة)",
 "かくさげ": "إنزال, تخفيض الرتبة (فعل التخفيض في الرتبة أو المنصب)",
 "かくされたいと": "أَجَنْدَة",
 "かくさん": "انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل…)\nمثال: تساهم في انتشار الجهل والتضليل. / حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات…)",
 "かくさんぞうふくけんさ": "حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات…)",
 "かくさんりつ": "هيالورونيداز (إنزيم يحلل حمض الهيالورونيك وبالتالي يقلل من لزوجته ويزيد من نفاذية النسيج…)",
 "かくさんポンプ": "مضخة انتشار, مضخة تكثيف (مضخة تفريغ تستخدم للحصول على فراغ عالي)",
 "かくざ": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها)\nمثال: خيط من الخرز",
 "かくざとう": "قَنْد",
 "かくし": "نُوَيَّة, نِيُوكْلِيُون (مكون (بروتون أو نيوترون) للنواة الذرية) / إخفاء, كتمان (نشاط إبقاء شيء ما سراً)\nمثال: ذهب في الاختباء (تواري عن الأنظار) / جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "かくしき": "شَكْلِيَّة / رتبة, مكانة اجتماعية (الموقع في تسلسل هرمي اجتماعي)\nمثال: البريطانيون أكثر وعياً بالمكانة الاجتماعية من الأمريكيين",
 "かくしきのう": "بَيْضَة عِيد اَلْفِصْح, بَيْضَة اَلْفِصْح (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "かくしこと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "かくしことば": "رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "かくしご": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "かくしごと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "かくした": "دونية, مكانة أدنى (حالة كونه أدنى)",
 "かくしだて": "سِرِّيَّة",
 "かくしつ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / جِلْدِيّ, مُتَجَلِّد (يشبه الجلد أو مصنوع ليشبهه؛ صلب لكنه مرن) / بلازما نووية, جبلة نووية (البروتوبلازم الذي يشكل نواة الخلية) / كيراتين",
 "かくしつおとし": "تَقَشُّر, حَرْشَفَة (رقاقة رفيعة من البشرة الميتة تنسلخ من سطح الجلد)\nمثال: يزداد التقشر بسبب حروق الشمس",
 "かくしつか": "تقرن (عملية عضوية يتم فيها ترسيب الكيراتين في الخلايا وتصبح الخلايا قرنية (كما في…)",
 "かくしつそう": "طبقة قرنية, طبقة متقرنة (الطبقة الخارجية من البشرة وتتكون من خلايا ميتة تتساقط)",
 "かくして": "هَكَذَا, كَذَا",
 "かくしどころ": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "かくしばしょ": "مخبأ (مساحة تخزين مخفية (للمال أو المؤن أو الأسلحة))",
 "かくしぼうちょう": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "かくしゃ": "فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات…)\nمثال: دخل إلى الفندق.",
 "かくしゃく": "حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / لَامِع, نَيِّر",
 "かくしゅ": "إِقَالَة / ضرب العنق, قطع الرأس (القتل بقطع الرأس)",
 "かくしゅう": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / أسبوعياً, كل أسبوع (دون تفويت أسبوع)\nمثال: زارت عمتها أسبوعياً",
 "かくしゅしてまつ": "اِشْتَاقَ",
 "かくしゅつ": "بصق (فعل البصق (طرد اللعاب بقوة))",
 "かくしょう": "تَأْكِيد\nمثال: السر سيبقى سرا.",
 "かくしょうたい": "نوية",
 "かくしょく": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو…)\nمثال: هذا الخبز لذيذ.",
 "かくしん": "نِوَاة / اِعْتِقَاد, عَقِيدَة\nمثال: 私は君の援助を確信している。 — أنا واثق من مساعدتك لي. / إِصْلَاح / اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "かくしんけい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح)",
 "かくしんしゃ": "رائد, سبّاق (شخص يساعد في فتح مجال جديد للبحث أو التكنولوجيا أو الفن)",
 "かくしんしゅぎ": "تقدمية (التوجه السياسي لمن يفضلون التقدم نحو ظروف أفضل في الحكومة والمجتمع)",
 "かくしんせいとう": "الحزب التقدمي, حزب بول موس (حزب سياسي سابق في الولايات المتحدة؛ أسسه ثيودور روزفلت خلال الحملة الرئاسية…)",
 "かくしんてき": "اِبْتِكارِيّ, مُبْتَكَر / رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / حَاسِم",
 "かくしマイク": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي.",
 "かくじ": "كُلّ / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "かくじききょうめい": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "かくじききょうめいえいぞうほう": "رنين مغناطيسي نووي (رنين البروتونات للإشعاع في مجال مغناطيسي)",
 "かくじだいてき": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "かくじつ": "أَكِيد\nمثال: لديك بعض الكتب.",
 "かくじつせい": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "かくじつど": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "かくじゅう": "تَمَدُّد",
 "かくじょう": "أَقْرَن",
 "かくじん": "نوية",
 "かくじんにかれのものを": "كل شخص حرّ في ذوقه",
 "かくす": "أَخْفَى, خَبَأَ\nمثال: أين اختبأ ياني؟ / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / دَرَجَة\nمثال: الصهاينة أشر من النازيين. / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه. / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / طَرَدَ, أَقَالَ / قَارَنَ / هَدَّدَ",
 "かくすい": "هَرَم, أَهْرَام ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها…)",
 "かくすいだい": "هرم ناقص (جذع مُشكل من هرم)",
 "かくする": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / دَرَجَة\nمثال: الصهاينة أشر من النازيين. / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "かくずけ": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما)\nمثال: وضع تقييماً عالياً للصداقة",
 "かくせい": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام) / تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "かくせいいでん": "ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة) / عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة",
 "かくせいき": "مُكَبِّر صَوْت, بُوق",
 "かくせいざい": "مُنَشِّط, مُنَبِّه",
 "かくせいじょうたい": "صحو, يقظة (حالة دورية تكون فيها واعيًا ومدركًا للعالم)\nمثال: الوعي أثناء اليقظة عند الشخص السليم يكون منظمًا ومألوفًا إلى حد كبير",
 "かくせいせつび": "مكبر صوت (محول كهروصوتي يحول الإشارات الكهربائية إلى أصوات عالية بما يكفي لسماعها من…)",
 "かくせいそうち": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)",
 "かくせん": "بُثُور سَوْدَاء, رُؤُوس سَوْدَاء",
 "かくせんがん": "أمفيبوليت (صخر متحول يتكون أساساً من الأمفيبول والبلاجيوكلاز)",
 "かくせんせき": "أمفيبول (معدن أو نوع معدني ينتمي إلى مجموعة الأمفيبول)",
 "かくぜつ": "تَوَحُّد",
 "かくぜん": "شَفَّاف / مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "かくそくど": "سُرْعَة زَاوِيَّة ((الفيزياء) معدل تغير الموضع الزاوي لجسم يدور؛ يُعبر عنه عادة بالراديان في…)",
 "かくそくない": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي))\nمثال: مستقبل غير مؤكد / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "かくたい": "عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف.",
 "かくたいか": "تجسيم, تشييء (فعل تمثيل فكرة مجردة كشيء مادي)",
 "かくたいこく": "طاقة نووية, قدرة نووية (الطاقة النووية باعتبارها مصدراً للكهرباء لشبكة الطاقة (للاستخدام المدني))",
 "かくたる": "أَكِيد\nمثال: لديك بعض الكتب.",
 "かくたん": "بصق (فعل البصق (طرد اللعاب بقوة))",
 "かくたんぱくしつ": "بروتين نووي (أي من عدة مواد موجودة في نوى جميع الخلايا الحية؛ تتكون من بروتين مرتبط بحمض نووي)",
 "かくだい": "تَمَدُّد / تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تَصْعِيد",
 "かくだいかいしゃく": "تفسير واسع, نشاط قضائي (تفسير للدستور الأمريكي يرى أن روح العصر واحتياجات الأمة يمكن أن تؤثر بشكل مشروع…)",
 "かくだいかぞく": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "かくだいかん": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي)",
 "かくだいきょう": "عَدَسَةٌ مُكَبِّرَة",
 "かくだいしゅくしょう": "تسلق (الصعود بواسطة سلم أو ما شابه)",
 "かくだいすいけい": "استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة)",
 "かくだん": "درامي, مثير (مناسب لـ أو من خصائص الدراما)\nمثال: دخول درامي بعباءة ملوحة / أَفْضَل, أَحْسَن\nمثال: إيمي فتاة حسنة.",
 "かくだんとう": "رأس حربي ذري, رأس نووي (الرأس الحربي لصاروخ مصمم لإيصال قنبلة ذرية)",
 "かくち": "اِدْرََاك حَسِّيّ / إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "かくちく": "مُنَافَسَة, مُبَارَاة",
 "かくちゅう": "مَنْشُور",
 "かくちょう": "تَمَدُّد / هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف. / نَغْمَة, نَغْم / سُرّة الطبلة (ارتفاع دائري طفيف حيث تلتصق المطرقة بطبلة الأذن)",
 "かくちょうか": "تَوْسِيع",
 "かくちょうかぞく": "أسرة ممتدة (أسرة تتكون من الأسرة النووية وأقاربهم بالدم)",
 "かくちょうかのう": "قابل للامتداد, قابل للتمدد (قادر على أن يبرز أو يتمدد أو ينبسط)\nمثال: لسان قابل للامتداد",
 "かくちょうき": "اِنْبِسَاط (أَرَى على وَجْهِهِ انْبِسَاطاً : اِنْشِراحاً؛ اِنْبِسَاطُ الذِّراعَيْنِ:…)",
 "かくちょうきのう": "تَمَدُّد",
 "かくちょうげんじつ": "الواقع المعزز",
 "かくちょうこうが": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "かくちょうせい": "قَابِلِيَّة التَّوَسُّع, قَابِلِيَّة القِيَاس (صفة القابلية للتوسع أو تغيير الحجم)",
 "かくちょうだかい": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "かくちょうぶぶん": "تَمْدِيد",
 "かくちょうスロット": "شق, فتحة ((حاسوب) مقبس في الحاسوب المصغر يقبل لوحة دوائر إضافية)\nمثال: يحتوي الحاسوب على ثلاث فتحات لذاكرة إضافية",
 "かくっと": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "かくつう": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير.",
 "かくつく": "تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب)",
 "かくづけ": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما)\nمثال: وضع تقييماً عالياً للصداقة",
 "かくて": "هَكَذَا, كَذَا",
 "かくてい": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / قَرَار, تَصْمِيم",
 "かくていさいばん": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل…)",
 "かくていてき": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "かくていはんげき": "عَاقَبَ, قَاصَصَ",
 "かくと": "كويب (ممص على أقدام بعض الذباب)",
 "かくとう": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض) / مَنْشُور",
 "かくとうか": "مُبَارِز, مُقَاتِل",
 "かくとうぎ": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "かくとうじゅつ": "مُلْتَحِم, وَجْهاً لِوَجْه (على مسافة قريبة جداً؛ في قتال مباشر)",
 "かくとうせんぶたい": "قوات الصدمة (جنود مدربون ومسلحون بشكل خاص لقيادة هجوم)",
 "かくとく": "اِكْتِسَاب",
 "かくとくけいしつ": "صِفَة مُكْتَسَبَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة.",
 "かくとくめんえき": "مناعة مكتسبة (مناعة ضد مرض معين ليست فطرية ولكن تم اكتسابها خلال الحياة)",
 "かくとした": "أَكِيد\nمثال: لديك بعض الكتب.",
 "かくど": "زَاوِيَة / وِجْهَة, وُجْهَة / حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "かくない": "خزانة, دولاب (قطعة أثاث تشبه الخزانة ذات أبواب وأرفف وأدراج؛ للتخزين أو العرض)",
 "かくないしょう": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء)",
 "かくなるうえは": "بِمَا أَنّ, أَمَا وَأَنّ",
 "かくなる上は": "بِمَا أَنّ, أَمَا وَأَنّ",
 "かくにゅうき": "مَخَاضَة",
 "かくにん": "تَأْكِيد\nمثال: السر سيبقى سرا.",
 "かくにんしゃ": "ضامن, مزكٍّ (شخص يضمن آخر أو يشهد بصحة بيان ما)",
 "かくにんしょう": "تَأْكِيد\nمثال: السر سيبقى سرا.",
 "かくねん": "كُلّ سَنَتَيْن (كل عامين)\nمثال: يقام هذا المهرجان كل سنتين / اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "かくねんりょう": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "かくねんりょうか": "إِثْرَاء",
 "かくねんりょうさいしょり": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "かくねんりょうぼう": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "かくねんりょうサイクル": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "かくねんりょうデブリ": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "かくねんりょうプール": "وقود نووي (وقود (مثل اليورانيوم) يمكن استخدامه في المفاعلات النووية كمصدر للكهرباء)",
 "かくのう": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "かくのうこ": "حَظِيرَة, سَقِيفَة",
 "かくのうばこ": "خزانة, دولاب (قطعة أثاث تشبه الخزانة ذات أبواب وأرفف وأدراج؛ للتخزين أو العرض)",
 "かくのうようき": "مِئَة وَخَمْسَة (يَدُلُّ عَلَى العَدَد 105)",
 "かくのうりょういき": "عنبر الشحن, مخزن الشحن (المساحة في سفينة أو طائرة لتخزين البضائع)",
 "かくのうメッセージいちらん": "سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية))",
