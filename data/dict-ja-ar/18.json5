 "入れ物": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "入れ直す": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد. / إِعَادَة التَّشْغِيل / أَعَادَ تَشْغِيل (كَرَّرَ؛ أَرْجَعَ، رَدَّ)\nمثال: أعاد توم كتابته.",
 "入れ知恵": "اِقْتِرَاح, مُقْتَرَح",
 "入れ籠": "عُشّ / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار) / مُنْتَجَع / مَعْقَل (الملجأ والجبل المرتفع) / عَشَّشَ\nمثال: كان دوري كي أنظف المسكن",
 "入れ質": "جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "入れ髪": "مِقْلَاد",
 "入れ黒子": "وَشْم / وَشَمَ, وَشَّمَ",
 "入会": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "入会地": "شَائِع",
 "入会者": "مُشَارِك / دَاخِل, وَافِد",
 "入冦": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان.",
 "入出力": "آيُّو",
 "入出力処理装置": "مُدْخَل",
 "入出力制御システム": "مُدْخَل",
 "入力": "مُدْخَل",
 "入力促進": "فورا / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "入力情報": "مُدْخَل",
 "入力線": "مُدْخَل",
 "入力要求": "فورا / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "入力電流": "مُدْخَل",
 "入口": "دُخُول / مَدْخَل",
 "入団": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "入国者": "مُشَارِك / دَاخِل, وَافِد",
 "入園者": "مُشَارِك / دَاخِل, وَافِد",
 "入域": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى."
}
