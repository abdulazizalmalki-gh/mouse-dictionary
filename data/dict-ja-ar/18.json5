 "れんあいもの": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "れんおん": "سَنْدْهِي, وَصْل / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / تَكْرِير",
 "れんか": "أغنية حب, أغنية عاطفية (أغنية عن الحب أو تعبر عن الحب لشخص آخر) / مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "れんかばん": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "れんかひん": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "れんかん": "صِلَة, صُلَة / ملعب غولف ساحلي (ملعب غولف مبني على أرض رملية بالقرب من الشاطئ)",
 "れんが": "طُوبَة, لَبِنَة",
 "れんがづくり": "أعمال الطوب, بناء بالطوب (بناء يتم باستخدام الطوب والملاط)",
 "れんき": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "れんきんじゅつ": "اَلْخِيمِيَاء, خِيمِيَاء / بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال)",
 "れんきんじゅつし": "خِيمِيَائِيّ",
 "れんぎん": "با دو دو, رقص ثنائي ((في الباليه) رقصة لشخصين (عادة راقصة باليه وراقص نبيل))\nمثال: الخطيبان / بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "れんく": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى)",
 "れんけい": "صِلَة, صُلَة / تَعَاوُن / مُكَامَلَة",
 "れんけいプレー": "عَمَل جَمَاعِيّ (عمل تعاوني يقوم به فريق (خاصة عندما يكون فعالاً))\nمثال: سيتطلب الأمر المال والتخطيط الجيد، وقبل كل شيء، العمل الجماعي / تَعَاوُن",
 "れんけつ": "صِلَة, صُلَة / نَزِيه, صَادِق",
 "れんけつき": "رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة",
 "れんけつし": "رَابِطَة, رَابِط",
 "れんけつせい": "اتصال, ترابط (خاصية كون الشيء متصلاً أو الدرجة التي يمتلك بها الشيء اتصالات)",
 "れんけつもう": "ويب",
 "れんけつもうひょうじ": "مَنْظَر, مَشْهَد",
 "れんげざ": "وضع اللوتس, وضعية زهرة اللوتس (وضع جلوس مع تقاطع الساقين؛ يستخدم في اليوغا)",
 "れんげん": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "れんこう": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام)\nمثال: كانت الغنائم سهلة / تَحَالُف, اِتِّحَاد",
 "れんこん": "علامة تموج (واحدة من سلسلة من الحواف الصغيرة الناتجة في الرمال بواسطة التيارات المائية أو…)",
 "れんご": "كلمة مركبة, مركب (كلمة تتكون من أي مجموعة متنوعة من الكلمات أو الصيغ التركيبية أو اللواحق) / رَابِطَة, رَابِط",
 "れんごう": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى…)\nمثال: عاش الاتحاد السوفيتي! / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "れんごうおうこく": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "れんごうかい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "れんごうぐん": "الْحُلَفَاء",
 "れんごうこく": "الْحُلَفَاء",
 "れんごうこくぐんさいこうしれいかんそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうこくさいこうしれいかんそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうこくそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうさくせん": "عملية مشتركة (عملية عسكرية تنفذ بالتعاون بين دولتين حليفتين أو أكثر أو عملية عسكرية تنفذ…)",
 "れんごうたい": "اِتِّحَادِيَّة, فِدِرَالِيَّة",
 "れんごうや": "منطقة الترابط (مناطق قشرية ليست حركية ولا حسية ولكن يُعتقد أنها تشارك في المعالجة العليا…)",
 "れんごく": "مَطْهَر",
 "れんさ": "سِلْسِلَة / ربط, صلة (عملية ربط الأشياء ببعضها البعض)",
 "れんさい": "نشر متسلسل (النشر في شكل متسلسل)",
 "れんさいしょうせつ": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)\nمثال: زواج أحادي متسلسل",
 "れんさきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى…)",
 "れんさきゅうきんせいいんとうえん": "التهاب الحلق العقدي (عدوى في البلعوم الفموي واللوزتين بواسطة المكورات العقدية)",
 "れんさく": "سِلْسِلَة, مَجْمُوعَة",
 "れんさぐん": "جينات مرتبطة, مجموعة ارتباط (أي زوج من الجينات يميل إلى الانتقال معاً)",
 "れんさじょうきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى…)",
 "れんさつ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "れんさてき": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)",
 "れんさてん": "متجر ضمن سلسلة (واحد من سلسلة متاجر بيع بالتجزئة تحت نفس الإدارة وتبيع نفس البضائع)",
 "れんさはんのう": "تَفَاعُل مُتَسَلْسِل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "れんざ": "تَلَازُم",
 "れんざん": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "れんしゅう": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب.",
 "れんしゅうあいて": "شريك تدريب (ملاكم يتدرب معه ملاكم آخر استعداداً لنزال مهم)",
 "れんしゅうき": "مُدَرِّب, مُدَرِّبَة",
 "れんしゅうきょく": "إيتود, دراسة موسيقية (تأليف قصير لآلة منفردة؛ يهدف كتمرين أو لإظهار البراعة التقنية)",
 "れんしゅうじあい": "مباراة استعراضية, مباراة ودية (مباراة لا يتم تسجيل نتيجتها في الترتيب الرسمي للموسم)",
 "れんしゅうじょ": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "れんしゅうじょう": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "れんしゅうせい": "طَالِب, طَالِبَة",
 "れんしゅうちょう": "دَفْتَر, كُرَّاس",
 "れんしゅうもんだい": "تَمْرِين, تَدْرِيب",
 "れんしゅうをつむ": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب.",
 "れんしゅく": "تَشَنُّج",
 "れんしょう": "سلسلة انتصارات (فترة متصلة من الانتصارات)",
 "れんしょうしき": "تَنَبَّأَ",
 "れんしょうたんしき": "إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "れんじ": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن) / رَابِطَة, رَابِط / شعار, لوغو (شعار أو رمز لشركة)",
 "れんじつ": "يَوْمًا بَعْدَ يَوْم",
 "れんじゃく": "جناح الشمع (طيور مغردة ذات ريش مخملي بني في نصف الكرة الشمالي لها رؤوس متوجة وأطراف أجنحة…)",
 "れんじゅう": "سَرِيَّة / فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "れんじゅく": "إِمْكَان",
 "れんじゅけい": "اللمنيسكات, منحنى الثمانية (أي من المنحنيات الجبرية المستوية التي تكون على شكل الرقم ثمانية)",
 "れんじょう": "حَبِيب, حَبِيبَة\nمثال: لا أحب المدرسة. / داء العشق, لوعة الحب (حنين وشوق لحبيب) / سَنْدْهِي, وَصْل / رَحْمَة\nمثال: زيري مثير للشفقة.",
 "れんせい": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)",
 "れんせいけい": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "れんせつ": "صِلَة, صُلَة / وَصْلَة",
 "れんせつてき": "مُلْتَحِم, مُتَرَابِط",
 "れんせつとし": "تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "れんそう": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية. / دَفْن (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "れんそうはいれつ": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟",
 "れんぞく": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / مُتَوَاصِل, مُتَّصِل",
 "れんぞくさつじんき": "قَاتِل مُتَسَلْسِل, قَاتِلَة مُتَسَلْسِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "れんぞくさつじんはん": "قَاتِل مُتَسَلْسِل, قَاتِلَة مُتَسَلْسِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "れんぞくせい": "استمرار, ثبات (خاصية فترة زمنية مستمرة ومتصلة)",
 "れんぞくたい": "استمرارية, متصل (كل مستمر غير مكاني أو مدى أو تتابع لا يكون فيه أي جزء أو قسم متميزاً أو قابلاً…)",
 "れんぞくてき": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع)\nمثال: رقمنا الأوراق بالتتابع",
 "れんぞくわざ": "فرقة جاز, كومبو (فرقة صغيرة من موسيقيي الجاز)",
 "れんたい": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور…)\nمثال: التضامن اساس الإنسانية. / مُشْتَرَك / فَوْج",
 "れんたいかく": "حَالَة اَلْمُضَاف إِلَيْهِ, مَجْرُور",
 "れんたいさいむ": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "れんたいせきにん": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "れんたいほしょう": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "れんたつ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير.",
 "れんたつのし": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير.",
 "れんたん": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود) / إكسير الحياة (مادة افتراضية يعتقد أنها تحافظ على الحياة إلى أجل غير مسمى؛ كان يسعى إليها…) / إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "れんたんじゅつ": "اَلْخِيمِيَاء, خِيمِيَاء",
 "れんだ": "قصف مركز, وابل (النار الكثيفة للمدفعية لإشباع منطقة بدلاً من ضرب هدف محدد)\nمثال: أطلقوا وابلاً من النيران أمام القوات المتقدمة",
 "れんちゃく": "مَوَدَّة\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "れんちゅう": "سَرِيَّة",
 "れんちょく": "أَمَانَة, نَزَاهَة",
 "れんぢゅう": "سَرِيَّة / فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "れんつう": "اِتِّصَالَات, اِتِّصَال",
 "れんてつ": "حديد مطاوع (حديد يحتوي على نسبة منخفضة من الكربون وهو متين وقابل للطرق وبالتالي يمكن تشكيله…)",
 "れんど": "مَهَارَة",
 "れんどうき": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "れんどうせい": "ربط, صلة (عملية ربط الأشياء ببعضها البعض)",
 "れんどうそうち": "تداخل, تشابك (فعل التشابك أو التداخل)\nمثال: تشابك أذرع الشرطة أبقى الحشد تحت السيطرة",
 "れんにゅう": "حَلِيب مَكْثِف (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب…)\nمثال: كنت أشرب الحليب",
 "れんねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "れんばんじょう": "عَرِيضَة, طَلَب",
