 "アンピシリン": "أمبيسيلين (بنسلين شبه صناعي (الأسماء التجارية برينسيبين وبوليسيلين وغيرها))",
 "アンファン": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "アンファンテリブル": "طفل رهيب, مشاغب (شخص يسبب سلوكه غير التقليدي إحراجاً للآخرين)",
 "アンファン・テリブル": "طفل رهيب, مشاغب (شخص يسبب سلوكه غير التقليدي إحراجاً للآخرين)",
 "アンフィプロステュロス": "ذُو رِوَاقَيْن, مُتَعَدِّد الأَعْمِدَة (يتّسم بأعمدة حرّة في أروقة عند كلا الطرفين أو على كلا الجانبين)",
 "アンフェア": "ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة",
 "アンフェタミン": "أَمْفِيتامين",
 "アンフォラ": "أمفورا, جرة إغريقية (جرة قديمة بمقبضين وعنق ضيق؛ استخدمت لحفظ الزيت أو النبيذ)",
 "アンフォルメル": "إنفورميل, الفن غير الرسمي (مدرسة فنية فرنسية نشأت في الخمسينيات وتتميز بضربات غير منتظمة وبقع لونية تطبق عشوائياً على القماش؛ تقارن بالتعبيرية التجريدية الأمريكية)\nمثال: حوالي عام 1945، أسس عدد من الرسامين الأوروبيين والأمريكيين مرحلة حاسمة في الفن الحديث تُعرف عموماً باسم الفن غير الرسمي",
 "アンブシュア": "قطعة الفم (فتحة آلة النفخ التي ينفخ فيها العازف مباشرة)",
 "アンブシュール": "قطعة الفم (فتحة آلة النفخ التي ينفخ فيها العازف مباشرة)",
 "アンブッシュ": "كَمين / كَمِين",
 "アンブリゴナイト": "أمبليغونيت (معدن أبيض أو رمادي يتكون من فوسفات الليثيوم والألمنيوم؛ وهو مصدر لليثيوم)",
 "アンブレイカブル": "غير قابل للكسر, متين (من المستحيل كسره خاصة في ظل الاستخدام العادي)\nمثال: أواني طعام بلاستيكية غير قابلة للكسر",
 "アンブレラ": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "アンプ": "أمبير (الوحدة الأساسية للتيار الكهربائي المعتمدة في النظام الدولي للوحدات) / أدينوسين أحادي الفوسفات\nمثال: الدائرة المنزلية النموذجية تحمل من 15 إلى 50 أمبير / مضخم إلكتروني\nمثال: 昨日、アンプを組み立てた。 — صنعتُ مُضَخِّمًا أمس.",
 "アンプラグド": "صَوْتِيّ",
