 "アウト・オブ・ファッション": "خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)",
 "アウト・ポケット": "جيب خارجي, جيب رقعة (جيب مسطح يُخيط على الجزء الخارجي من الملابس)",
 "アウフタクト": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "アウラ": "جَوّ, هَالَة (صفة مميزة ولكن غير ملموسة تحيط بشخص أو شيء) / إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس) / أورة, نسمة (إحساس (مثل نسيم بارد أو ضوء ساطع) يسبق بداية اضطرابات معينة مثل نوبة الصداع النصفي أو نوبة الصرع)\nمثال: جو من الغموض",
 "アウラル": "أيرير (100 أيرير تساوي 1 كرونا في آيسلندا)",
 "アウル": "بُومَة",
 "アウローラ": "شَفَق قُطْبِيّ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)",
 "アウン": "تنفس خلوي, تنفس داخلي (العمليات الأيضية التي تحصل بها بعض الكائنات الحية على الطاقة من الجزيئات العضوية؛ العمليات التي تحدث في الخلايا والأنسجة والتي يتم خلالها إطلاق…) / تنفس, تهوية (العملية الجسدية للشهيق والزفير؛ عملية أخذ الأكسجين من الهواء المستنشق وإطلاق ثاني أكسيد الكربون عن طريق الزفير) / نَفَس (عملية كاملة واحدة من الشهيق والزفير)\nمثال: ثلاثون نَفَسًا في الدقيقة",
 "アエロフロート": "إِيرُوفْلُوت",
 "アオアシシギ": "طيطوي أخضر الساق (طيطوي أوروبي كبير ذو أرجل مخضرة)",
 "アオイ": "خُبَازَى",
 "アオウミガメ": "سلحفاة خضراء (سلحفاة استوائية كبيرة ذات لحم مخضر يُستخدم في حساء السلاحف)",
 "アオカケス": "قيق أزرق (قيق شائع في شرق أمريكا الشمالية؛ لونه أزرق ساطع مع صدر رمادي)",
 "アオカビチーズ": "جُبْنَة زَرْقَاء",
 "アオガラ": "قرقف أزرق",
 "アオギス": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "アオコ": "بكتيريا زرقاء, طحالب خضراء مزرقة (كائنات بدائية النواة تقوم بالتمثيل الضوئي بشكل أساسي وتحتوي على صبغة زرقاء بالإضافة إلى الكلوروفيل؛ توجد منفردة أو في مستعمرات في بيئات متنوعة؛ مهمة…)",
 "アオサ": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل)",
 "アオザイ": "آو داي (الزي التقليدي للنساء الفيتناميات المكون من سترة بأكمام طويلة وألواح أمامية وخلفية؛ تلبس السترة فوق بنطال)",
 "アオザメ": "ماكو قصير الزعنفة (قرش مزرق نشط وسريع جداً يوجد في جميع أنحاء العالم في المياه الدافئة؛ سمكة صيد مهمة)",
 "アオタ": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "アオチビキ": "رَمَادِيّ مُزْرَقّ (رمادي مع مسحة زرقاء)",
 "アオナギ": "لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "アオハル": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "アオミドロ": "سبيروجيرا, لولبية (طحالب مياه عذبة تتكون من خيوط دقيقة تحتوي على أشرطة كلوروفيل حلزونية)",
 "アオリスト": "الأوريست, الماضي غير المحدد (زمن فعل في بعض اللغات (مثل اليونانية الكلاسيكية والسنسكريتية) يعبر عن حدث (خاصة حدث ماض) دون الإشارة إلى اكتماله أو استمراره)",
 "アカ": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "アカアシイワシャコ": "حجل أحمر الساق (حجل شائع في غرب أوروبا ذو أرجل حمراء)",
 "アカウオ": "الْمُحِيط الْهَادِئ",
 "アカウソ": "دغناش (عصفور أوروبي شائع لونه أسود وأبيض في الغالب مع حلق وصدر أحمر)",
 "アカウミガメ": "سلحفاة ضخمة الرأس (سلحفاة بحرية كبيرة آكلة للحوم؛ واسعة الانتشار في البحار المفتوحة الدافئة)",
 "アカウンタビリティ": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "アカウンタビリティー": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "アカウンティング": "مُحَاسِبَة (المُحَاسَبَة: المهنة التي يقوم أصحابها بحساب الأرباح والخسائر وغيرها في الأعْمَال؛ علم المُحَاسَبَة: هو العلم الذي يعنى بما يقوم به أصحاب مهنة المحاسبة)\nمثال: محاسبة النفس صفة حميدة.",
 "アカウント": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "アカウントエグゼクティブ": "مدير حساب عميل, مسؤول حسابات (شخص مسؤول عن حساب العميل لدى وكالة إعلانات أو شركة وساطة أو غيرها من الأعمال الخدمية)",
 "アカウント・エグゼクティブ": "مدير حساب عميل, مسؤول حسابات (شخص مسؤول عن حساب العميل لدى وكالة إعلانات أو شركة وساطة أو غيرها من الأعمال الخدمية)",
 "アカオオカミ": "دُول ((دَوَّلَ) دالًا: كتبها. و(تدويلُ المدينة): جعل الأمر فيها لدول مختلفة)\nمثال: لبنان دولة صغيرة. / ذئب أحمر (ذئب رمادي محمر من جنوب غرب أمريكا الشمالية)",
 "アカオノスリ": "باز أحمر الذيل (نوع من الصقور الأمريكية ذات اللون البني الداكن ولها ذيل بني محمر)",
 "アカカワイノシシ": "خَنْزِير الأَنْهار الأَحْمَر",
 "アカガイ": "محار الدم (محار أحمر الدم)",
 "アカギツネ": "ثعلب أحمر (الثعلب الشائع في العالم القديم؛ ذو فرو بني محمر؛ يُعتبر عادة نوعاً واحداً حول القطب الشمالي) / ثعلب أحمر (ثعلب العالم الجديد؛ غالباً ما يُعتبر نفس نوع ثعلب العالم القديم) / الثعلب الأحمر, سيلوزيا فضية (نبات حولي عشبي ذو سنابل من الزهور البيضاء الفضية)",
 "アカグマ": "دُبّ أَسْمَر",
 "アカゲザル": "مكاك ريسوسي (يعيش في جنوب آسيا؛ يُستخدم في الأبحاث الطبية)",
 "アカサンゴ": "مرجان أحمر (شعاب مرجانية خاصة في البحر الأبيض المتوسط ذات لون وردي أو أحمر تستخدم للزينة والمجوهرات) / مرجان, مرجان أحمر (الهيكل الصخري الصلب لمرجان البحر المتوسط، ذو لون أحمر أو وردي دقيق ويستخدم للمجوهرات)",
 "アカザ": "سبانخ بري, هنري الطيب (نبات أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يجمع من البرية كبقلة)",
 "アカシア": "أَقَاقِيَا, سَنْط",
 "アカシカ": "أيل أحمر (أيل شائع في المناطق المعتدلة من أوروبا وآسيا)",
 "アカシヤ": "أَقَاقِيَا, سَنْط",
 "アカスグリ": "كِشْمِش أَحْمَر",
 "アカタテハ": "أحمر هندي (لون بني محمر يشبه التربة الحمراء) / تربة حمراء هندية (تربة حمراء تحتوي على أكسيد الحديديك؛ تستخدم غالباً كخضاب) / أحمر هندي (خضاب أحمر يتكون جزئياً من أكسيد الحديديك ويستخدم غالباً في الدهانات ومستحضرات التجميل)",
 "アカダニ": "سوس عنكبوتي (سوس غازل للشبك يهاجم نباتات الحدائق وأشجار الفاكهة)",
 "アカツツガムシ": "تيفوس الأجمة, مرض تسوتسوغاموشي (ينقله يرقات العث وينتشر في آسيا)",
 "アカツメクサ": "نفل المروج, نفل بنفسجي (نبات معمر قصير العمر، منتصب إلى منبطح، ذو أزهار حمراء أرجوانية إلى وردية؛ أكثر أنواع نفل العلف زراعة)",
 "アカデミ": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور. / الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "アカデミア": "الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "アカデミィ": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور. / الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "アカデミシズム": "سُكُولَائِيَّة, مَدْرَسِيَّة (أرثوذكسية من النوع المدرسي (السكولائي)) / أَكَادِيمِيَّة, نَظَرِيَّة بَحْتَة (الأفكار والمواقف التخمينية البحتة) / أكاديمية, فن أكاديمي (أسلوب في الرسم والنحت أنتج تحت تأثير أكاديميات الفن الأوروبية)\nمثال: الإعداد ومعالجة الموضوع هنا نموذجيان لنهجه الفني، الذي يقع بين الأكاديمية المثالية لبوغيرو والواقعية الاجتماعية لدواميه",
 "アカデミシャン": "أَكَادِيمِيّ, أَكَادِيمِيَّة",
 "アカデミズム": "سُكُولَائِيَّة, مَدْرَسِيَّة (أرثوذكسية من النوع المدرسي (السكولائي)) / أكاديمية, فن أكاديمي (أسلوب في الرسم والنحت أنتج تحت تأثير أكاديميات الفن الأوروبية)\nمثال: الإعداد ومعالجة الموضوع هنا نموذجيان لنهجه الفني، الذي يقع بين الأكاديمية المثالية لبوغيرو والواقعية الاجتماعية لدواميه",
 "アカデミック": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "アカデミックガウン": "روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "アカデミック・ガウン": "روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "アカデミー": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور. / الأوساط الأكاديمية, المجتمع الأكاديمي (العالم الأكاديمي)",
 "アカデミーしょう": "أوسكار, جائزة الأوسكار (جائزة سنوية تمنحها أكاديمية فنون وعلوم الصور المتحركة للإنجازات في إنتاج وأداء الأفلام)",
 "アカデミー賞": "أوسكار, جائزة الأوسكار (جائزة سنوية تمنحها أكاديمية فنون وعلوم الصور المتحركة للإنجازات في إنتاج وأداء الأفلام)",
 "アカトビ": "حَدَأَة حَمْرَاء",
 "アカネ": "فُوَّة صَبْغِيَّة / فُوَّة",
 "アカハラ": "زُحَار",
 "アカバナ": "سنفية, عشب الصفصاف",
 "アカバナルリハコベ": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "アカヒゲ": "غَرْبِيّ",
 "アカビット": "أكوافيت (مشروب إسكندنافي منكه عادة ببذور الكراوية)",
 "アカプリッチオ": "كابريتشيو (مقطوعة آلية لا تلتزم بقواعد أي شكل موسيقي محدد وتُعزف بارتجال)",
 "アカペラ": "أَكَابِيلَّا",
 "アカボウクジラ": "حوت منقاري (أي من الحيتان العديدة التي تعيش في جميع المحيطات ولها فكوك تشبه المنقار مع أسنان أثرية في الفك العلوي)",
 "アカボウフラ": "دودة الدم (دودة بحرية مقسمة بجسم أحمر زاهي؛ تستخدم غالباً كطعم)",
 "アカマツ": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "アカマンボウ": "أوبا, سمكة القمر (سمكة كبيرة بيضاوية الشكل زاهية الألوان تعيش في أعماق المحيط الأطلسي والهادئ والبحر الأبيض المتوسط)",
 "アカムシ": "دودة الدم (دودة بحرية مقسمة بجسم أحمر زاهي؛ تستخدم غالباً كطعم) / بق الحصاد, سوس الحصاد (يرقة سوس تمتص دم الفقاريات بما في ذلك البشر مسببة تهيجاً شديداً)",
 "アカヤマアリ": "نملة دموية (نملة مستعبدة واسعة الانتشار في نصف الكرة الشمالي)",
 "アカン": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عَجَزَ, لَا يَسْتَطِيع",
 "アカンご": "أَكَانِيَّة",
 "アカンタレ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "アカンパニメント": "مُصَاحَبَة",
 "アカン語": "أَكَانِيَّة",
 "アガる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "アガチス": "خشب الكاوري (خشب أبيض دقيق الحبيبات لشجرة من جنس أغاتيس) / كاوري (شجرة خشب طويلة من نيوزيلندا لها خشب أبيض مستقيم الحبيبات) / صمغ الكاوري, كاوري (راتنج أشجار الكاوري في نيوزيلندا؛ يوجد عادة كأحفورة؛ ويُجمع أيضاً لصنع الورنيش والمشمع)",
 "アガパンサス": "عِشْقِيَّة",
 "アガベ": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "アガペー": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / حب غير مشروط, محبة روحية (حب غير أناني لشخص آخر دون دلالات جنسية (خاصة الحب ذو الطبيعة الروحية)) / محبة إلهية ((في اللاهوت المسيحي) محبة الله أو المسيح للبشرية) / وليمة المحبة (تجمع اجتماعي يهدف إلى خلق النوايا الحسنة بين المشاركين)",
 "アガマ": "عَضْرَفُوط, أُمّ حُبَيْن",
 "アキシャル": "مِحْوَرِيّ (واقِع عَلى المِحْوَر أَوْ في اتِّجاهِه) / محوري (من أو متعلق بـ أو يشبه محور الدوران) / محوري (يتعلق بـ أو متصل بالمحور)\nمثال: زاوية محورية",
 "アキダクト": "قناة مائية, قنطرة مائية (قناة تشبه الجسر تحمل المياه فوق وادٍ)",
 "アキテクチャ": "هَنْدَسَة مِعْمَارِيَّة, عِمَارَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "アキニレ": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات) / دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "アキノキリンソウ": "عصا الذهب, قضيب الذهب (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "アキノノゲシ": "خس هندي, مونتيا (نبات من جنس مونتيا له أوراق صالحة للأكل ذات مذاق لطيف)",
 "アキヘラザメ": "فِي المِيَاهِ العَمِيقَة (مُتَعَلِّقٌ بِالمِيَاهِ العَمِيقَةِ أَوْ يَجْرِي فِيهَا)",
 "アキメネス": "أشيمينيس, نبات الماء الساخن (أي نبات من جنس أشيمينيس ذو زهور مبهرجة على شكل جرس تشبه الغلوكسينيا)",
 "アキュセイション": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "アキュゼイション": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "アキュパイ": "اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها)",
 "アキュムレータ": "سجل المركم, مركم ((علم الحاسوب) سجل يحتوي على جامع مدمج يضيف رقم إدخال إلى محتويات السجل) / بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب))",
 "アキュムレーター": "سجل المركم, مركم ((علم الحاسوب) سجل يحتوي على جامع مدمج يضيف رقم إدخال إلى محتويات السجل) / بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب))",
