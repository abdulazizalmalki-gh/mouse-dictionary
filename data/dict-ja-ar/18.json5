 "らいらいらくらく": "صَرِيح, مُنْفَتِحُ القَلْب (يتواصل بحرّيّة وصراحة ومباشرة) / خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها)",
 "らいらく": "إِفْرَنْجِيّ",
 "らいりゅう": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "らいりん": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "らいれき": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "らい患者": "أَبْرَص, أَجْذَم ((أَبْرَصَ) الرجل: ولد ولدا أبرص؛ (أَبْرَصَ) الله فلانا: أصابه بالبرص)",
 "らい病": "جُذَام",
 "らい菌": "عصوية الجذام, متفطرة جذامية (مسبب مرض الجذام)",
 "らい落": "إِفْرَنْجِيّ",
 "らおん": "كراكر",
 "らかん": "بوذا (الشخص الذي حقق حالة من الاستنارة الكاملة)",
 "らがんしりょく": "عَيْن مُجَرَّدَة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "らぎょう": "انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون إخفاء؛ غير كتوم) / عري (حالة عدم وجود ملابس أو غطاء من أي نوع) / عراء, قفار (جو موحش ومقفر)\nمثال: عراء المنظر الطبيعي",
 "らく": "رَاحَة / جابر / وَاسَى, عَزَّى / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / مُرِيح, وَثِير / مُرْتَاح / مُرِيح / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "らくあればくあり": "هُنَاكَ, يُوجَدُ",
 "らくいん": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "らくうしょう": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية) / سرو البرك / سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "らくえき": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "らくえん": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "らくがき": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "らくがきちょう": "دفتر رسم",
 "らくがみ": "صعود سريع, نمو سريع (ارتفاع سريع)",
 "らくげ": "صعود سريع, نمو سريع (ارتفاع سريع)",
 "らくご": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "らくごしゃ": "مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "らくさ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "らくさん": "حمض البيوتيريك, حمض الزبدة (حمض دهني كريه الرائحة يوجد خاصة في الزبدة)",
 "らくさんきん": "حمض البيوتيريك, حمض الزبدة (حمض دهني كريه الرائحة يوجد خاصة في الزبدة)",
 "らくしじょう": "جُدْجُد / صُرْصُر / صُرْصُور / كْرِيكِت",
 "らくしゃ": "لَاك / عَجَلَة الْمِغْزَل",
 "らくしゅ": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية) / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "らくしょ": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "らくしょう": "انحناء خلفي مع الوقوف على اليدين, شقلبة ماشية (دمج بين الانحناء الخلفي والوقوف على اليدين) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: تسويق هذا المنتج لن يكون نزهة / لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "らくしょく": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "らくじつ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "らくじょう": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "らくすい": "طاقة مائية, قوة مائية (القدرة على بذل الشغل الكامنة في مسقط مائي) / مُرْهِق, مُنْهِك (له أثر مُوهِن ومُنهِك للقوى)",
 "らくせい": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم)",
 "らくせいひん": "منتجات الألبان (الحليب والزبدة والجبن)",
 "らくせつ": "انسلاخ, تقشر (فقدان أجزاء من الجلد الخارجي عن طريق التقشير أو التساقط)",
 "らくせん": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "らくそ": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "らくそう": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "らくたん": "تثبيط (فعل التثبيط أو الإحباط) / إِحْبَاط, تَثْبِيط (التعبير عن المعارضة وعدم الاستحسان) / إحباط, تثبيط (شعور اليأس في مواجهة العقبات)\nمثال: تثبيط السرقة الصغيرة",
 "らくだ": "جَمَل, نَاقَة (حَسُنَ)\nمثال: يا لها من جملة! / تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "らくだい": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "らくだつ": "فِرَار, هَجْر / إِغْفَال / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "らくち": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "らくちょう": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "らくちん": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "らくてん": "تَفَاؤُل",
 "らくてんか": "مُتَفَائِل",
 "らくてんかん": "تَفَاؤُل",
 "らくてんしゅぎ": "تَفَاؤُل",
 "らくてんしゅぎしゃ": "مُتَفَائِل",
 "らくてんち": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "らくてんてき": "مُتَفَائِل",
 "らくてんろん": "تَفَاؤُل",
 "らくど": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "らくにする": "اِسْتَرْخَى",
 "らくのう": "إنتاج الألبان, مزارع الألبان (عمل إنتاج الألبان)",
 "らくのうか": "بائع الحليب, مزارع الألبان (مالك أو مدير لمزرعة ألبان أو منشأة لمنتجات الألبان)",
 "らくのうぎょう": "إنتاج الألبان, مزارع الألبان (عمل إنتاج الألبان)",
 "らくのうじょう": "مزرعة ألبان (مزرعة يتم فيها إنتاج منتجات الألبان)",
 "らくのうひん": "منتجات الألبان (الحليب والزبدة والجبن)",
 "らくはつ": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "らくばく": "مُقْفِر, مَهْجُور",
 "らくめい": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "らくよう": "إسقاط الورق, تعرية الأشجار (التسبب في تساقط أوراق الأشجار والنباتات الأخرى (عن طريق استخدام مواد كيميائية مثلاً)) / إزالة الأوراق, تساقط الأوراق (فقدان أوراق الشجر) / نَفَضِي, نَفَضِية",
 "らくようざい": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "らくようしょう": "شجرة اللاريكس, لاريكس (أي من الصنوبريات العديدة من جنس لاريكس، جميعها ذات أوراق إبرية متساقطة) / خشب الأرزية, خشب اللارك (خشب شجرة الأرزية)",
 "らくようじょう": "صَفَائِحِيّ, وَرَقِيّ ((خاصة للصخور المتحولة) ذو طبقات رقيقة تشبه الأوراق) / غَزِير الأَوْرَاق, وَرَقِيّ (يحمل أوراقاً عديدة وكثيفة) / ورقي (مكون من أو يخص أو يشبه ورقة النبات)",
 "らくようせい": "نَفَضِي, نَفَضِية",
 "らくらい": "صَاعِقَة",
 "らくらく": "بارتياح, برغد (في راحة مالية) / بارتياح (براحة نفسية؛ دون توتر) / براحة (براحة جسدية)\nمثال: يعيشون برغد",
 "らくるい": "إدماع, تدميع (ذرف الدموع)",
 "らくチン": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "らご": "لَاتِينِيّ, الرُّومِيَّة (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية) / لَاتِينِيّ, الرُّومِيّ (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية)\nمثال: العديد من الكلمات الإنجليزية أصلها لاتيني.",
 "らさいるい": "بزاق البحر, عاريات الخياشيم (أي من بطنيات القدم البحرية المختلفة من رتيبة عاريات الخياشيم التي لها جسم عديم الصدفة وغالباً ما يكون ملوناً بشكل جميل)",
 "らし": "لَوْلَب / بُرْغِيّ, قَلَاوُوظ",
 "らしい": "ـِيّ",
 "らしからぬ": "غَيْر مُمَيِّز, غَيْر نَمَطِيّ (متميز وغير نمطي)\nمثال: كتاب غير مميز لمؤلفه (لا يشبه أسلوبه المعتاد)",
 "らしき": "ـِيّ",
 "らしくない": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "らしさ": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "らししょくぶつ": "عاريات البذور (نباتات من طائفة عاريات البذور تكون بذورها غير محاطة بمبيض)",
 "らしゃめん": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛",
 "らしゅつ": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "らしんぎ": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "らしんばん": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "らしんばんざ": "حُقّ, علبة مجوهرات أثرية (صندوق صغير استخدمه الإغريق القدماء لحفظ الأدوية) / حُقّة (فاكهة لنباتات مثل لسان الحمل؛ كبسولة يسقط جزؤها العلوي عند إطلاق البذور)",
 "らしんばん座": "حُقّ, علبة مجوهرات أثرية (صندوق صغير استخدمه الإغريق القدماء لحفظ الأدوية) / حُقّة (فاكهة لنباتات مثل لسان الحمل؛ كبسولة يسقط جزؤها العلوي عند إطلاق البذور)",
 "らせん": "لَوْلَب, بُرْغِيّ / لَوْلَب / بُرْغِيّ, قَلَاوُوظ / لَوْلَب / لَوْلَب, بُرْغِيّ",
 "らせんじょう": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "らせんすいしんき": "مروحة دافعة (مروحة بعدة شفرات مائلة تدور للدفع ضد الماء أو الهواء)",
 "らせんたい": "لَوْلَب, بُرْغِيّ",
 "らせん体": "لَوْلَب, بُرْغِيّ",
 "らせん状": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "らそつ": "شرطي (عضو ذكر في قوة الشرطة)",
 "らぞう": "عَارٍ, عُرْيَان",
 "らたい": "عُرْي",
 "らたいが": "عَارٍ, عُرْيَان",
 "らたいしゅぎ": "عُرْيَانِيَّة, مَذْهَب الْعُرْي",
 "らち": "اِخْتِطَاف / حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "らちがい": "خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "らちもない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "らちゅう": "يَرَقَة, دُودَة الْفَرَاشَة",
 "らちる": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟ / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "らっか": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "らっかえだにかえらずはきょうふたたびてらさず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "らっかさん": "بَرَاشُوت, مِظَلّة هُبُوط",
 "らっかさんぶたい": "مظليين (مشاة مدربون ومجهزون للقفز بالمظلات)",
 "らっかさんへい": "مِظَلِّيّ",
 "らっかせい": "فُولٌ سُودَانِيٌّ, فُسْتُقُ العَبِيد",
 "らっかせいゆ": "زيت الفول السوداني (زيت مستخرج من الفول السوداني؛ يُستخدم في الطهي وصنع الصابون)",
 "らっかん": "تَفَاؤُل",
 "らっかんしゅぎ": "تَفَاؤُل",
 "らっかんてき": "مُتَفَائِل",
 "らっかんろん": "تَفَاؤُل",
 "らっかんろんしゃ": "مُتَفَائِل",
 "らっこ": "قضاعة البحر (قضاعة بحرية كبيرة من سواحل شمال المحيط الهادئ ذات فراء بني داكن سميك جداً)",
 "らっしゃる": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "らっち": "اِخْتِطَاف / حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "らっちもない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "らっぱ": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق. / بَلْطَجِيّ / جَاسُوس / تَجَسَّسَ",
 "らっぱかんえん": "التهاب البوق, التهاب قناة فالوب (التهاب قناة فالوب (عادة نتيجة انتشار العدوى من المهبل أو الرحم) أو قناة استاكيوس)",
 "らっぱしゅ": "تم بواق (بجعة برية بيضاء نقية كبيرة من غرب أمريكا الشمالية لها صرخة رنانة) / بوقي (طائر اجتماعي كبير يشبه الكركي من غابات أمريكا الجنوبية له ريش أسود لامع وصرخة طويلة عالية؛ يسهل تدجينه) / بشير, منادي ((رسمياً) شخص يعلن عن أخبار مهمة) / عازف بوق, عازف كورنيت (موسيقي يعزف على البوق أو الكورنيت)\nمثال: كان لدى الزعيم منادٍ يعلن عن وصوله بالبوق",
 "らっぱすいせん": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "らっぱずいせん": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "らっぱふき": "عازف بوق (شخص يعزف على البوق (البيوجل))",
 "らっぱ吹き": "عازف بوق (شخص يعزف على البوق (البيوجل))",
 "らつわん": "حذق, حنكة (الذكاء الذي يظهر من خلال الحنكة (كما في التعاملات التجارية))",
 "らでん": "أم اللؤلؤ, عرق اللؤلؤ (الطبقة الداخلية المتقزحة لصدفة الرخويات)",
 "らでんざいく": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
