 "よばれる": "سُمِّيَ",
 "よばれるプログラム": "إجراء, دالة (تسلسل محدد من الخطوات، جزء من برنامج حاسوبي أكبر)",
 "よばわり": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "よばわる": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "よばん": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "よひと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "よひょう": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح)",
 "よび": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / تَحْضِير, إِعْدَاد / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびあつめる": "اِجْتَمَعَ (ضد تَفَرَّقَ، كانوا جَمِيْع، أو كانوا مع بعض؛ الناس على كذا: ضدّ تَفَرَّقُوْا…)\nمثال: اجتمع الناس في المتنزه.",
 "よびいれる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびうり": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "よびえきしょうこうくんれんかてい": "فيلق تدريب ضباط الاحتياط (برنامج تدريبي لإعداد طلاب الجامعات ليصبحوا ضباطًا مفوضين)",
 "よびおこす": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびかえす": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "よびかけ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびかける": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن…)\nمثال: لا أتحمل البرد. / اِلْتِمَاس, اِسْتِئْنَاف",
 "よびきん": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "よびぐん": "قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي) / طامح, طامع (شاب طموح ومتطلع)\nمثال: طامح رفيع المستوى",
 "よびこ": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "よびこう": "مدرسة إعدادية, مدرسة تحضيرية (مدرسة ثانوية خاصة)",
 "よびこうさく": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "よびこみ": "كلب (مصطلحات غير رسمية للكلاب)",
 "よびこむ": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびごえ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびさます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق / اِسْتَحْضَارَ, اِسْتَدَعَى",
 "よびざせき": "مقعد خلفي قابل للطي (مقعد خارجي قابل للطي في الجزء الخلفي من بعض السيارات القديمة)",
 "よびしけん": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "よびせん": "أَوَّلِيّ",
 "よびせんきょ": "أَوَّلِيّ",
 "よびそうち": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه.",
 "よびだし": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه. / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "よびだしおん": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "よびだしがわ": "طَازَج (طَازَج وَجَدِيد)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "よびだしじかん": "وقت الوصول ((في علم الحاسوب) الفترة بين طلب البيانات من قبل النظام ووقت توفير البيانات…)\nمثال: وقت الوصول هو مجموع وقت البحث وكمون الدوران ووقت معالجة الأوامر",
 "よびだしじょう": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "よびだしでんわ": "رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "よびだしふごう": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا.",
 "よびだす": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري) / دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびちしき": "خلفية, معلومات أساسية (معلومات ضرورية لفهم موقف أو مشكلة)\nمثال: أطلعته السفارة على خلفية الحادث",
 "よびつけ": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "よびつける": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびてき": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "よびとめる": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن…)\nمثال: لا أتحمل البرد.",
 "よびどい": "كُوع, مِرْفَق",
 "よびな": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "よびね": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "よびひ": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "よびひん": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه.",
 "よびぶひん": "قِطْعَة غَيَار (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "よびへい": "جندي احتياط (عضو في قوات الاحتياط العسكرية)",
 "よびみず": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض)\nمثال: الهدف من الفن هو إثارة العواطف",
 "よびみずしきけいざいせいさく": "تحضير المضخة (إدخال الماء في المضخة لتحسين الختم وبدء تدفق المياه)",
 "よびもどす": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "よびや": "مُرَوِّج",
 "よびょう": "تَعْقِيد",
 "よびよせる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびりん": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "よふけ": "الهزيع الأخير من الليل, ساعات الصباح الأولى (الساعات التي تلي منتصف الليل مباشرة)",
 "よふん": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "よぶ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / يَسْتَحْضِر, يَسْتَدْعِي / دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "よぶこ": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "よぶん": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود)\nمثال: سيارة سريعة بشكل استثنائي / نَمِيمَة, إِشَاعَة",
 "よへい": "أثر باق, بقية (شيء نجا وبقي من الماضي)\nمثال: بقية من الستينيات",
 "よほう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / تَنَبَّأَ",
 "よほど": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "よぼう": "سبق الإصرار والترصّد (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك. / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / شَعْبِيَّة / شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "よぼういがく": "طب وقائي (فرع الطب المعني بالوقاية من الأمراض)\nمثال: المؤسسة الطبية لا تربح من الطب الوقائي",
 "よぼういりょう": "طب وقائي (فرع الطب المعني بالوقاية من الأمراض)\nمثال: المؤسسة الطبية لا تربح من الطب الوقائي",
 "よぼうこうげき": "ضربة وقائية, هجوم وقائي (ضربة تُنفذ من أجل ردع عدوان متوقع من قبل قوات معادية)",
 "よぼうせっしゅ": "تَطْعِيم, تَلْقِيح (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة…)",
 "よぼうせん": "إجراء دفاعي, دفاع (عمل عسكري أو موارد تحمي دولة ضد أعداء محتملين)\nمثال: ماتوا في الدفاع عن ستالينغراد / احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "よぼうそち": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "よぼうちゅうしゃ": "تمنيع",
 "よぼうてき": "اِحْتِرَازِيّ",
 "よぼうやく": "اِحْتِرَازِيّ",
 "よぼよぼ": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "よまいごと": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض)\nمثال: سمعوا هدير الرعد",
 "よまわり": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "よみ": "قِرَاءَة",
 "よみあげ": "تِلَاوَة",
 "よみかえる": "حِمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "よみかた": "نُطْق, لَفْظ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / تَفْسِير",
 "よみがあまい": "اِسْتَخَفَّ, اِسْتَهَانَ",
