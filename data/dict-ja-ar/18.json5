 "りょくさく": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية) / كَدْح\nمثال: شعر توم بالتعب.",
 "りょくしょう": "زِنْجَار",
 "りょくしょく": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر.",
 "りょくせっけん": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية)",
 "りょくせんせき": "أكتينوليت (معدن أخضر من مجموعة الأمفيبول؛ سيليكات الكالسيوم والمغنيسيوم والحديد)",
 "りょくそう": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح…) / خضرة, نضارة (المظهر الغزير للنباتات المزدهرة)",
 "りょくそうしょくぶつ": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح…)",
 "りょくそうしょくぶつもん": "الطحالب الخضراء, قسم الطحالب الخضراء (قسم كبير من الطحالب حقيقية النواة التي تعيش بشكل رئيسي في المياه العذبة وتمتلك…)",
 "りょくそうるい": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح…)",
 "りょくちたい": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "りょくちゃ": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "りょくちゅうせき": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "りょくでいせき": "كلوريت (معدن أخضر أو أسود بشكل عام؛ يوجد كمكون للعديد من الصخور عادة في شكل بلورة مسطحة)",
 "りょくとう": "مَاش",
 "りょくどう": "حزام أخضر (حزام من المتنزهات أو الأراضي الريفية المحيطة ببلدة أو مدينة)",
 "りょくないしょう": "زَرَق, المَاء الأَزْرَق",
 "りょくば": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم…)",
 "りょくひ": "سماد أخضر (محصول نامٍ يتم حرثه في التربة لإغنائها)",
 "りょくようかんらん": "كُرْنُب أَجْعَد",
 "りょくりん": "غابة خضراء (أراضي حرجية مكتملة الأوراق)",
 "りょぐ": "أمتعة, حقائب سفر (حقائب تستخدم لحمل المتعلقات عند السفر)",
 "りょけん": "جَوَاز سَفَر, إِجَازَة مُرُور",
 "りょけんさしょう": "تَأْشِيرَة, فِيزَا",
 "りょこう": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ…)\nمثال: سافر سامي وليلى.",
 "りょこうあんない": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "りょこうあんないしょ": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "りょこうか": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "りょこうかばん": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "りょこうがいしゃ": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうきゃく": "سَائِح, سَائِحَة",
 "りょこうぎょうしゃ": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうぎょうしゃだいりぎょう": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうぎょうほう": "وَكَالَةُ سَفَر",
 "りょこうけいかく": "خطة سفر, مسار رحلة (مسار مقترح للسفر)",
 "りょこうこぎって": "شيك سياحي, شيك مسافر (خطاب اعتماد يصدره بنك أو شركة شحن سريع يكون قابلاً للدفع عند تقديمه لأي مراسل…)",
 "りょこうさき": "وِجْهَة, وُجْهَة",
 "りょこうしゃ": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب. / وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうしゃけっせんしょう": "سفر جوي, طيران (السفر عبر الطائرات)\nمثال: السفر الجوي ينطوي على الكثير من الانتظار في المطارات",
 "りょこうしゃようこぎって": "شيك سياحي, شيك مسافر (خطاب اعتماد يصدره بنك أو شركة شحن سريع يكون قابلاً للدفع عند تقديمه لأي مراسل…)",
 "りょこうだいりてん": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうにってい": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول…)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "りょこうばと": "حمام مهاجر (حمامة مهاجرة اجتماعية من أمريكا الشمالية منقرضة الآن)",
 "りょしゃ": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "りょしゅう": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب.",
 "りょじ": "فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات…)\nمثال: دخل إلى الفندق.",
 "りょじん": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "りょじんぼく": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من…)",
 "りょだん": "لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "りょっか": "استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "りょっかやね": "حديقة سطح (حديقة على سطح مبنى مسطح)",
 "りょっこう": "جهد, عناء (استخدام الطاقة البدنية أو العقلية؛ العمل الشاق)\nمثال: حصل على درجة امتياز لجهده",
 "りょてい": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول…)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات…)\nمثال: دخل إلى الفندق.",
 "りょてん": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "りょはん": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "りょひ": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب…)",
 "りょり": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
 "りよう": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / بَالَاد / حَلَّاق",
 "りよういん": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようかのう": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "りようきゃく": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل.",
 "りようけん": "تَذْكِرَة",
 "りようし": "حَلَّاق",
 "りようしつ": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようしゃ": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل.",
 "りようしゃしょうめいしょう": "شَهَادَة",
 "りようしょ": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようてん": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようほう": "اِسْتِخْدَام",
 "りようめいさい": "بيان محاسبي, كشف حساب (بيان بالمعاملات الحديثة والرصيد الناتج)\nمثال: يرسلون لي كشف حساب كل شهر",
 "りよく": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "りりき": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "りりく": "إِقْلَاع",
 "りりしい": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل)",
 "りりつ": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو…)\nمثال: إتفقوا على سعر.",
 "りりょ": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
 "りりょう": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "りりょく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "りれき": "خلفية / خَشَبَة / تخلفية, هستيريا مغناطيسية (تأخر التأثير عن سببه؛ وخاصة الظاهرة التي يتخلف فيها الحث المغناطيسي لمادة…)",
 "りれきげんしょう": "تخلفية, هستيريا مغناطيسية (تأخر التأثير عن سببه؛ وخاصة الظاهرة التي يتخلف فيها الحث المغناطيسي لمادة…)",
 "りれきしょ": "سِيرَة ذَاتِيَّة",
 "りろ": "مَنْطِق (عِلْمُ المَنْطِق: هو عِلْم من العلوم البحتة هدفه البَحْث عن قواعد التفكير…)\nمثال: غزة منطقة مكشوفة.",
 "りろせいぜん": "مَنْطِقِيّ",
 "りろん": "نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير…)\nمثال: إنها مجرد نظرية.",
 "りろんか": "مُنَظِّر",
 "りろんじょう": "على الورق, نظرياً (في النظرية؛ وفقاً للحقائق المفترضة)\nمثال: على الورق يبدو المرشح واعداً / نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا…)\nمثال: إنها مجرد نظرية.",
 "りろんてき": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا…)\nمثال: إنها مجرد نظرية.",
 "りをえる": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "りん": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي) / فُسْفُور / جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس. / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا. / رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر)\nمثال: سلوكها الوقور / صِيغَة, صِيغَةُ الْفِعْل / شَفَّاف",
 "りんうんも": "ليبيدوليت (معدن من مجموعة الميكا؛ مصدر مهم لليثيوم)",
 "りんか": "سراب, وهم خادع (وهم يضلل)",
 "りんかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / حراجة (حالة حرجة؛ خاصة النقطة التي يصبح فيها التفاعل النووي مستداماً ذاتياً) / النقد / سَاحِلِيّ (يقع على أو بالقرب من أو يحد ساحلاً)\nمثال: مستنقعات ساحلية / مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "りんかいかく": "زَاوِيَة حَرِجَة",
 "りんかいせき": "أباتيت",
 "りんかいてん": "مفترق طرق, منعطف حرج (حالة أزمة أو نقطة زمنية يجب فيها اتخاذ قرار حاسم)\nمثال: في ذلك المنعطف لم يكن لديه أدنى فكرة عما يجب فعله",
 "りんかいりょう": "كتلة حرجة (الحد الأدنى من كتلة المواد القابلة للانشطار التي يمكن أن تحافظ على التفاعل…)\nمثال: وصلت المعركة من أجل سوق الكمبيوتر الآن إلى الكتلة الحرجة",
 "りんかく": "بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي))\nمثال: بالكاد استطاع تمييز أشكالهم / خُلَاصَة, مُلَخَّص / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
