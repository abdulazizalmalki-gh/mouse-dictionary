 "よみきかせ": "قِرَاءَة",
 "よみこなす": "هَضَمَ",
 "よみこみ": "قِرَاءَة",
 "よみこむ": "حِمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "よみじ": "هَادِيس",
 "よみする": "مِدْحَة, إِثْنَاء",
 "よみだし": "قِرَاءَة",
 "よみだしせんようメモリ": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "よみだす": "استرجع",
 "よみちがい": "قراءة خاطئة (سوء تفسير ناتج عن قراءة غير دقيقة)",
 "よみちがえ": "قراءة خاطئة (سوء تفسير ناتج عن قراءة غير دقيقة)",
 "よみて": "قَارِئ, قَارِئَة / مُلَحِّن / كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "よみとく": "فَسَّرَ, أَوَّلَ / فَكَّ تَّعْمِيَة, فَكَّ مُعَمَّى",
 "よみとばす": "يَرْتَ",
 "よみとり": "قِرَاءَة",
