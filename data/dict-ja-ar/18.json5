 "わかり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "わかりきった": "بَدِيهِيّ, بَدَهِيّ",
 "わかりづらい": "مُرْبِك",
 "わかりにくい": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "わかりみ": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "わかる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / أَظُنُّ ذٰلِك",
 "わかれ": "فِرَاقٌ / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / انفصال, تفكك (التفرق أو الانقسام) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور)",
 "わかれでる": "شُعَاعِيّ (ذو أشعّة أو أجزاء شعاعيّة كما في رؤوس أزهار الأقحوان) / شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك)",
 "わかれにのぞん": "فِرَاقٌ",
 "わかればなし": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "わかれみち": "فَرْع, غُصْن / مُفْتَرَق, تَقَاطُع",
 "わかれめ": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "わかれる": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / فَرْع, غُصْن / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / نَثَرَ, تَفَرَّقَ",
 "わかれわかれ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "わかれをつげる": "وَدَّعَ",
 "わかわかしい": "شَبَابِيّ, مَفْعَم بِالحَيَوِيَّة (يوحي بالشباب؛ نشيط ومفعم بالحيويّة)",
 "わかわかしさ": "شباب, فتوة (النضارة والحيوية المميزة للشاب)",
 "わかん": "زِنًى, سِفَاح (مَارَسَ الزِّنَى)",
 "わが": "ـِي, ـي",
 "わがきみ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わがとう": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わがはい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わがほう": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わがまま": "أَنَانِيّ / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "わがままもの": "أناني (شخص يتصف بأنانية مفرطة وغير عادية)",
 "わがままをいう": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "わがままを言う": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "わがまま者": "أناني (شخص يتصف بأنانية مفرطة وغير عادية)",
 "わがみ": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わがもの": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "わがよのはる": "أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "わが世の春": "أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "わが党": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わが君": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わが方": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わが身": "نَفْسِي / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わき": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده) / بِالْقُرْب مِن, بِجَانِب / بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / خارج الـموضوع / غَلَيَان / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "わきあいあい": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "わきあがる": "هَاجَ, غَلَى / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "わきおこる": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "わきかえる": "هَاجَ, غَلَى",
 "わきが": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام)",
 "わきがあまい": "عرضة / عُرْضَة لِلْجَرْح / هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت) / ضَعِيْف",
 "わきくさ": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام)",
 "わきくそ": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام)",
 "わきづくえ": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "わきでる": "تَدَفُّق / تَدَفَّقَ, سَالَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "わきど": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "わきのした": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده)",
 "わきの下": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده)",
 "わきばしら": "حلق الباب, عارضة الباب (القائم الجانبي للباب)",
 "わきばら": "جَانِب / صَفْحَة / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "わきほね": "ضِلْع",
 "わきぼね": "ضِلْع",
 "わきまえ": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة / عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "わきまえる": "مَيَّزَ / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس.",
 "わきみず": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "わきみち": "طريق جانبي (طريق فرعي يتفرع من طريق رئيسي) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "わきめ": "مَاصّ / مُغَفَّل",
 "わきめもふらず": "قَلْبًا وَقَالَبًا",
 "わきやく": "دور ثانوي, دور صغير (دور صغير)",
 "わき上がる": "هَاجَ, غَلَى / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "わき役": "دور ثانوي, دور صغير (دور صغير)",
 "わき目もふらず": "قَلْبًا وَقَالَبًا",
 "わき目も振らず": "قَلْبًا وَقَالَبًا",
 "わき腹": "جَانِب / صَفْحَة / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "わき芽": "مَاصّ / مُغَفَّل",
 "わき道": "طريق جانبي (طريق فرعي يتفرع من طريق رئيسي) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "わぎも": "حَبِيب, حَبِيبَة",
 "わぎもこ": "حَبِيب, حَبِيبَة",
 "わく": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة)\nمثال: سأقدم طلبي في إطار فئة أخرى. / دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / ثَار (ثارَ يَثُورُ ثَوَرانًا، وثَوْرًا، وثَوْرَةً: هاج وانتَشَرَ؛ يُقال: ثارَ الدُّخانُ والغُبَرُ، وثار الدّم بفلان، وثارت به الحصْبَةُ، وثار به الشَّرُّ والغَضَبُ)\nمثال: ثار الفلاحون على الحكومة. / خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر. / ذَابَ, انْصَهَرَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه. / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية. / بَكَرَة",
 "わくがい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "わくぐみ": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "わくせい": "كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس) / كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل. / حصان غامض (حصان سباق لا يُعرف عنه سوى القليل) / حصان أسود, مرشح غامض (مرشح سياسي غير معروف جيداً ولكنه قد يفوز بشكل غير متوقع)",
 "わくせいけい": "نِظَام نَجْمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "わくせいじょうせいうん": "سَدِيم كَوْكَبِيّ",
 "わくせいたんさき": "جَوَّال, قائِد كَشْفِيّ (عضو بالغ في حركة الكشافة) / جوال, متشرد (شخص يعيش حياة تجوال غير مستقرة)",
 "わくせいちょくれつ": "اقتران كوكبي (تكوين خط مستقيم لـ 3 أجرام سماوية (مثل الشمس والأرض والقمر) في نظام جاذبية)",
 "わくでき": "صَكّ غُفْرَان",
 "わくらば": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "わくらん": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "わくをつける": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر.",
 "わけ": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب. / إِقْتِسَام, مُقَاسَمَة / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / مَعْنًى / الْمَعْنَى / حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "わけあい": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "わけあう": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "わけあたえる": "وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق.",
 "わけあり": "ناقص-غير كامل",
 "わけありぶっけん": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "わけがない": "هُنَاكَ, يُوجَدُ / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "わけがら": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "わけがわからない": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم / أَنَا تَائِه, أَنَا تَائِهَة",
 "わけが無い": "هُنَاكَ, يُوجَدُ / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "わけぎ": "بصل الشجرة, بصل مصري (نوع من البصل المعمر يزرع بشكل رئيسي للغرابة أو كبصل أخضر مبكر؛ له بصيلات صغيرة تحل محل الزهور)",
 "わけしり": "شخص راق, شخص محنك (شخص حكيم دنيوياً)",
 "わけしりがお": "مُتَعَالِم",
 "わけて": "الأهم, قبل كل شيء (فوق كل اعتبار آخر) / أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً",
 "わけても": "خُصُوصًا, خَاصَّةً",
 "わけとる": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "わけどり": "إِقْتِسَام, مُقَاسَمَة",
 "わけない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "わけなく": "بِسُهُولَة",
 "わけにはいかない": "عَجَزَ, لَا يَسْتَطِيع",
 "わけにはいけない": "عَجَزَ, لَا يَسْتَطِيع",
 "わけには行かない": "عَجَزَ, لَا يَسْتَطِيع",
 "わけのわかった": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "わけのわからない": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "わけの分からない": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "わけへだて": "تَمْيِيْز",
 "わけへだてなく": "بِالتَّسَاوِي",
 "わけまえ": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "わけめ": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / أَزْمَة, بُحْرَان / أَزْمَة",
 "わけもつ": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "わける": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم. / مَيَّزَ / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "わけわかめ": "أَنَا تَائِه, أَنَا تَائِهَة",
 "わけ知り顔": "مُتَعَالِم",
 "わけ隔てなく": "بِالتَّسَاوِي",
 "わげ": "صُلْح, مُصَالَحَة",
 "わこうど": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "わこく": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "わこと": "زَوْجَة, اِمْرَأَة",
 "わご": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "わごう": "اِنْسِجَام, تَوَافُق",
 "わごりょ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わごりょう": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わごれ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わごん": "عَرَبَة",
 "わさ": "عُرْوَة, عُقْدَة",
 "わさび": "وَسَابِي / فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "わさびじょうゆ": "صَلْصَةْ اَلصُّويَا",
 "わさびだいこん": "فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "わさびのき": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في عناقيد متدلية وقرون يستخدم لبها طبياً؛ آسيا الاستوائية ووسط وجنوب…)",
 "わさび大根": "فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "わさび醤油": "صَلْصَةْ اَلصُّويَا",
 "わさわさ": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "わさんぼん": "دَقِيقُ الْحُبَيْبَاتِ, مُتَرَاصّ (كثيف أو متراصّ البنية كخشب مؤلّف من خلايا صغيرة القطر) / مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "わざ": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / مَأْثُرَة",
 "わざと": "عَمْدًا",
 "わざとらしい": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "わざまえ": "مَهَارَة",
 "わざわい": "كَارِثَة, مُصِيبَة",
 "わざわざ": "خصيصاً, صراحة (بنوايا محددة؛ للغرض الصريح)\nمثال: هي بحاجة إلى المال خصيصاً لمرضاها / عَمْدًا",
 "わし": "عُقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わしざ": "الْعُقَاب",
 "わしばな": "أَنْف مَعْقُوف (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "わしゃ": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "わしゅうごう": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "わしら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わしわし": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة",
 "わしん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "わしんじょうやく": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "わし座": "الْعُقَاب",
 "わし鼻": "أَنْف مَعْقُوف (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "わじ": "كَانَا",
 "わじょう": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد)) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "わする": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "わするなぐさ": "أُذْن الفَأْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "わすれえぬ": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "わすれがたい": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "わすれがたみ": "تذكار (شيء يذكر بأحداث الماضي) / يَتِيم / يَتِيمَة",
 "わすれがち": "نَسَّاء, نَسِيّ",
 "わすれぐさ": "تِبْغ, تَبْغ / تَبْغ, تَبَغ",
 "わすれっぽい": "نَسَّاء, نَسِيّ",
 "わすれなぐさ": "أُذْن الفَأْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "わすれなぐさいろ": "أُذْن الفَأْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "わすれもしない": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "わすれられない": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "わすれる": "نَسِيَ (لَمْ يَتَذَكَّرْ؛ غَابَ عَنْ الذِهْن)\nمثال: لقد نسي صديقتك.",
 "わすれんぼう": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "わずか": "قَلِيلًا / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.\nمثال: 私はわずか１０００円しか持っていない。 — ليس لدي أكثر من 1,000 ين .",
 "わずかに": "قَلِيلًا / بِٱلْكَاد / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "わずらい": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "わずらいつく": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "わずらう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "わずらわしい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "わずらわす": "مُشْكِلَة, مَتاعِب",
 "わずらわせる": "مُشْكِلَة, مَتاعِب",
 "わせい": "اِنْسِجَام, تَوَافُق",
 "わせいがく": "علم التوافقيات (دراسة الصوت الموسيقي)",
 "わせだでんしせんもんがっこう": "وعي, إدراك (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "わせん": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "わそう": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "わた": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / قطن, نبات القطن (نبات خبازي شجيري منتصب أو شجرة صغيرة تحمل لوزات تحتوي على بذور ذات ألياف شعرية طويلة عديدة) / ضرب الكرة ((بيسبول) محاولة الضارب للوصول إلى القاعدة) / حشوة قطنية, لباد (حشو مصنوع من لفات أو صفائح من الصوف القطني أو الألياف الصناعية) / فَرَث",
 "わたあぶら": "زيت بذر القطن (زيت صالح للأكل معصور من بذور القطن)",
 "わたあめ": "غَزْل اَلْبَنَات (غَزَلَ بمعنى حاك أو نسج، سواء في الحياكة أو الكلام. ويمكن أن يكون مرتبطًا بـ الغرام أو الحديث الغزلي؛ مُغازَلَةُ النِّساءِ: مُحادَثَتُهُنَّ، والاسمُ: الغَزَلُ والمَغْزَلُ)",
 "わたい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わたがし": "غَزْل اَلْبَنَات (غَزَلَ بمعنى حاك أو نسج، سواء في الحياكة أو الكلام. ويمكن أن يكون مرتبطًا بـ الغرام أو الحديث الغزلي؛ مُغازَلَةُ النِّساءِ: مُحادَثَتُهُنَّ، والاسمُ: الغَزَلُ والمَغْزَلُ)",
 "わたくし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / شَخْصِيّ / أَنَانِيَّة / سِرِّيَّة",
 "わたくしぎ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わたくしごと": "سِرِّيَّة, خَلْوَة",
 "わたくしじしん": "نَفْسِي",
 "わたくしする": "مُنَاسِب / لَائِق",
 "わたくしたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わたくしども": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わたくしめ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わたくしもまた": "أَنَا أَيْضًا, أَنَا كَذٰلِك",
 "わたくしりつ": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "わたくりき": "محلج قطن (آلة تفصل البذور عن ألياف القطن الخام)",
 "わたげ": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة.",
 "わたし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مُعَدِّيَة, عَبَّارَة / تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "わたしじしん": "نَفْسِي",
 "わたしたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わたしども": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わたしば": "منصة انطلاق, نقطة انطلاق (بداية ينطلق منها مشروع) / نقطة الانطلاق (مكان يتم منه إطلاق مشروع أو رحلة استكشافية)\nمثال: يستخدم أفكار الآخرين كنقطة انطلاق لأفكاره الخاصة",
 "わたしぶね": "مُعَدِّيَة, عَبَّارَة",
 "わたしもり": "مشغل عبارة (رجل ذكر يقوم بتشغيل عبارة)",
 "わたす": "اِجْتَازَ, عَبَرَ / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "わたすげ": "عشب القطن (أي سعد من جنس إريوفوروم؛ نباتات مستنقعات شمالية معتدلة بسنابل متكتلة)",
 "わたつみ": "إله البحر (إله يجسد البحر ويُعتقد عادةً أنه يعيش فيه أو يسيطر عليه) / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "わたの原": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)",
 "わたばね": "زُغَيْبَة (ريش زغبي للطيور الصغيرة؛ يبقى في بعض الطيور البالغة)",
 "わたぼこり": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور)) / زينة رخيصة, شيء تافه (شيء قليل القيمة أو الأهمية) / زغب, وبر (أي مادة ريشية خفيفة)",
 "わたり": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة) / استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية) / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية. / قُطْر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر. / جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود",
 "わたりあう": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ)",
 "わたりあほうどり": "قطرس جوال (قطرس كبير جداً؛ أبيض بأجنحة سوداء عريضة)",
 "わたりいた": "سقالة, ممشى الصعود (جسر مؤقت للصعود والنزول من السفينة عند الرصيف)",
 "わたりかに": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "わたりがに": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "わたりどり": "طائر مهاجر (أي طائر يهاجر موسمياً) / جوال, متشرد (شخص يعيش حياة تجوال غير مستقرة)",
 "わたりにふね": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "わたりま": "شِبْر",
 "わたりもの": "هَائِم",
 "わたりろうか": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "わたる": "غِطَاء / غِلَاف / غَطَّى",
 "わたるせけんにおにはない": "هُنَاكَ, يُوجَدُ",
 "わたわた": "مُتَوَتِّر, مُرْتَبِك (أُلقِي في حالة من الاضطراب والارتباك المتهيّج)",
 "わだ": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "わだい": "مَوْضُوع, مَوَاضِيع / آنِيّ, رَاهِنٌ (ذو اهتمام في الوقت الحاضر) / ظَاهِرِيّ, مَوْضِعِيّ (مُتَعَلِّق بِسَطْح جُزء مِنَ الجِسْم) / مبوب, موضوعي (متعلق بالمواضيع أو مرتب حسب الموضوعات)\nمثال: سجل مفصل على أساس زمني وموضوعي",
 "わだいか": "تصدر, موضعة في الصدارة ((لسانيات) توكيد يوضع على الموضوع أو بؤرة الجملة بتقديمه إلى بداية الجملة)",
 "わだいせい": "أهمية إخبارية, جدارة إخبارية (صفة كونه مثيرًا للاهتمام بما يكفي للإبلاغ عنه في الأخبار)\nمثال: اعترف القاضي بالأهمية الإخبارية للمحاكمة",
 "わだかまり": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "わだかまりなく": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "わだかまる": "مِلَفّ, وَشِيعَة / وَشِيعَة",
 "わだち": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, مسار عجل (أخدود أو شق (خاصة في الأرض اللينة الناتج عن العجلات)) / دورة الشبق, شبق (ينطبق على الثدييات غير البشرية: حالة أو فترة من الإثارة الجنسية والنشاط المتزايد)\nمثال: وقعوا في روتين محادثة ممل",
 "わだつみ": "إله البحر (إله يجسد البحر ويُعتقد عادةً أنه يعيش فيه أو يسيطر عليه) / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "わちき": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わちゃわちゃ": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / صرصرة, طقطقة (سلسلة سريعة من الضوضاء التي تصدرها أجزاء الآلة)",
 "わっ": "يَع",
 "わっか": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس. / هَالَة",
 "わっかもん": "صغير, طفل (شخص صغير السن من أي من الجنسين)",
 "わっし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わっち": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わってはいる": "قَاطَعَ",
 "わっと": "فَجْأَةً",
 "わっぱ": "أَصْفَاد, أَغْلَال / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "わっぷ": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "わて": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "わとう": "مَوْضُوع, مَوَاضِيع",
 "わどの": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わどめ": "تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن) / إسفين, سنادة (كتلة من الخشب تستخدم لمنع انزلاق أو تدحرج جسم ثقيل)\nمثال: كان ممتلئاً تماماً / مسمار المحور (مسمار يتم إدخاله عبر محور العجلة لتثبيت العجلة) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك)\nمثال: الإيمان هو ركيزته",
 "わな": "فَخّ, مِصْيَدَة / عُرْوَة, عُقْدَة",
 "わなく": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "わなげ": "رمي الحلقات, رمي حدوة الحصان (لعبة يتم فيها رمي حلقات حديدية (أو حلقات حديدية مفتوحة) على وتد في الأرض على أمل تطويقه)",
 "わななく": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "わなにかかる": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "わなみ": "شَرَكٌ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه) / مِصْيَدَةٌ\nمثال: هذه شركة صينية. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わなわ": "أنشوطة, وهق (حبل طويل ذو عقدة منزلقة يستخدم لصيد الحيوانات)",
 "わに": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر. / لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "わにあし": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / ساق مقوسة, فحج (ساق منحنية للخارج عند الركبة (أو أسفل الركبة))",
 "わにがめ": "سلحفاة القاطور النهاشة (نوع كبير له ثلاثة تلال على ظهره؛ يوجد في جنوب شرق الولايات المتحدة)",
 "わにぐち": "قَاطُور, تِمْسَاح أَمْرِيكِيّ",
 "わにぐちクリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "わになし": "أَفُوكَادُو",
