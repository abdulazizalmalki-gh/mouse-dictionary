 "りゅうじょうせい": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "りゅうじょうはん": "حبيبة (حبة صغيرة جداً)",
 "りゅうじん": "لغات ناغا (لغات كاماروبان يتم التحدث بها في شمال شرق الهند وغرب بورما) / نَفْي, تَبْعِيد / نَفَى / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "りゅうすい": "جَدْوَل / تَيَّار / تَدَفّقَ",
 "りゅうすう": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "りゅうず": "تَاج, إِكْلِيل / الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد",
 "りゅうせい": "شِهَاب / اِزْدِهَار, رَخَاء",
 "りゅうせいう": "زخة شهب, وابل شهبي (تساقط عابر للشهب عندما يدخل سرب من الشهب الغلاف الجوي للأرض)",
 "りゅうせいぐん": "سِرْب نَيَازِك (مجموعة من النيازك ذات مسارات متشابهة)",
 "りゅうせいじん": "نَيْزَك دَقِيق (حجر نيزكي أو نيزك صغير جداً لدرجة أنه ينجرف إلى الأرض دون أن يسخن بشدة في الغلاف الجوي)",
 "りゅうせいたい": "نَيْزَك",
 "りゅうせいぶっしつ": "نَيْزَك",
 "りゅうぜつらん": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "りゅうぜん": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "りゅうぜんこう": "عَنْبَر",
 "りゅうそく": "تغير مستمر, تقلب (في تغيير مستمر) / كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة) / تدفق, سيلان (جريان أو تصريف) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)\nمثال: آراؤه في تقلب مستمر",
 "りゅうぞく": "سالب, ناهب (شخص يهاجم بحثاً عن الغنائم)",
 "りゅうたい": "سَائِل, مَائِع / حبيبة (حبة صغيرة جداً)",
 "りゅうたいりきがく": "ميكانيكا الموائع, هيدروليكا (دراسة ميكانيكا السوائل)",
 "りゅうたく": "نَفْي, تَبْعِيد / نَفَى",
 "りゅうたん": "جَنْطِيَانَا, كُوشَاد",
 "りゅうだんほう": "مورتر, هاون (مدفع يلقم من الفوهة ذو سبطانة قصيرة يطلق القذائف بزوايا مرتفعة لمدى قصير)",
 "りゅうだんぽう": "مورتر, هاون (مدفع يلقم من الفوهة ذو سبطانة قصيرة يطلق القذائف بزوايا مرتفعة لمدى قصير)",
 "りゅうち": "تَوْقِيف",
 "りゅうちけん": "طحال (عضو بيضاوي كبير أحمر داكن على الجانب الأيسر من الجسم بين المعدة والحجاب الحاجز؛ ينتج خلايا تشارك في الاستجابات المناعية) / امتياز, حق الحجز (الحق في أخذ ممتلكات شخص آخر إذا لم يتم الوفاء بالتزام)",
 "りゅうちじょ": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "りゅうちじょう": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "りゅうちょう": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "りゅうつう": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "りゅうつうきぎょう": "بائع بالمفرق, تاجر تجزئة (تاجر يبيع البضائع بالتجزئة)",
 "りゅうつうけいろ": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "りゅうつうもう": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "りゅうつうコスト": "تكلفة التوزيع (أي تكلفة يتكبدها منتج أو تاجر جملة أو تاجر تجزئة أو موزع (كما للإعلان والشحن وما إلى ذلك))",
 "りゅうつうチャネル": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "りゅうつうチャンネル": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "りゅうてい": "بَاكٍ / بُكَاء",
 "りゅうてき": "نَفْي, تَبْعِيد / نَفَى",
 "りゅうてん": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟ / تَنَاسُخ الْأَرْوَاح",
 "りゅうと": "بأناقة, على الموضة (بطريقة عصرية وأنيقة) / بقوة, بنشاط (بنشاط وحيوية) / ببراعة, بذكاء (بطريقة ذكية)\nمثال: كان يرتدي ملابس أنيقة",
 "りゅうとうだび": "انحدار في الأسلوب, هبوط مفاجئ (تغيير من موضوع جاد إلى موضوع مخيب للآمال) / تراجع مخيب, خيبة أمل (تراجع مخيب للآمال بعد ارتفاع سابق)\nمثال: النهاية المخيبة لمهنة رائعة",
 "りゅうど": "حببية, خشونة (جودة التكون من جزيئات كبيرة نسبياً)",
 "りゅうどう": "تَدَفُّق / تَدَفَّقَ, سَالَ",
 "りゅうどうこう": "كالكوسيت (معدن رمادي ثقيل يعد خاماً للنحاس)",
 "りゅうどうしさん": "أصول سائلة, أصول متداولة (أصول في شكل نقد (أو قابلة للتحويل بسهولة إلى نقد))",
 "りゅうどうせい": "سُيُولَة (توفر النقد أو سهولة التحويل إلى نقد؛ القدرة على سداد الديون) / سيولة (خاصية التدفق بسهولة) / حالة سائلة, سائل (الحالة التي تظهر فيها المادة استعداداً مميزاً للتدفق مع ميل ضئيل أو معدوم للتشتت وعدم قابلية للانضغاط عالية نسبياً)\nمثال: إضافة الرصاص تجعل السبيكة أسهل في السكب لأن درجة الانصهار تنخفض وتزداد السيولة / انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب / حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
 "りゅうどうたい": "سَائِل, مَائِع",
 "りゅうどうてき": "سَائِل, مَائِع",
 "りゅうどうぶつ": "سَائِل, مَائِع",
 "りゅうどすい": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي) / رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "りゅうにゅう": "تدفق داخلي (عملية التدفق إلى الداخل)",
 "りゅうは": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "りゅうひてっこう": "أرسينوبيريت (خام الزرنيخ ذو لون أبيض فضي أو رمادي)",
 "りゅうひょう": "جليد طافٍ (كتل من الجليد تطفو في البحر المفتوح)",
 "りゅうひょうや": "حقل جليدي (كتلة مسطحة كبيرة من الجليد (أكبر من الطوف الجليدي) تطفو في البحر)",
 "りゅうぶん": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية.",
 "りゅうべい": "كيلولتر, متر مكعب (وحدة مترية للحجم أو السعة تساوي 1000 لتر)",
 "りゅうほ": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "りゅうぼう": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / انجراف التربة (جرف التربة عن طريق تدفق المياه) / لَاجِئ, لَاجِئَة",
 "りゅうぼく": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "りゅうみん": "لَاجِئ, لَاجِئَة",
 "りゅうもんがん": "ريوليت (صخر بركاني حمضي جداً)",
 "りゅうよう": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي / استخدام, استعمال (فعل الاستخدام) / استخدام, انتفاع (حالة كونه مستخدماً)\nمثال: حذر من استخدام المخدرات",
 "りゅうり": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "りゅうりゅう": "سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / عَضَلِيّ / إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "りゅうりょう": "تَدَفُّق, مُعَدَّل التَّدَفُّق (كمية السائل التي تتدفق في وقت معين)",
 "りゅうりょうけい": "مقياس التدفق (جهاز يستخدم لقياس معدل تدفق الكتلة أو الحجم لسائل أو غاز)",
 "りゅうるいしょう": "تكرار النهاية, سجع (تكرار نهايات جملتين أو أبيات متتالية أو أكثر)",
 "りゅうれい": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته. / سَادُو, طُقُوس اَلشَّاي",
 "りゅうろ": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟ / قَنَاة",
 "りゅう座": "تِنِّين",
 "りゆう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "りゆうづけ": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق) / ترشيد, عقلنة (تنظيم العمل التجاري وفقاً لمبادئ الإدارة العلمية لزيادة الكفاءة) / إنطاق ((رياضيات) تبسيط تعبير أو معادلة عن طريق إزالة الجذور دون تغيير قيمة التعبير أو جذور المعادلة) / تبرير, عقلنة (العملية المعرفية لجعل شيء ما يبدو متسقاً مع العقل أو قائماً عليه)",
 "りょ": "مَفْهُوم / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / أَجْنَبِيّ, أَجْنَبِيَّة",
 "りょう": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / نُزُل, أُوتِيل (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب. / فِيلَا, دَارَة / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / صَيْد / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / كَمِّيَّة, مِقْدَار / كَرَم, سَخَاء / تِنِّين / لغات ناغا (لغات كاماروبان يتم التحدث بها في شمال شرق الهند وغرب بورما) / صَيْد سَمَك, صَيْد / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / تايل (وحدة وزن مستخدمة في شرق آسيا تساوي تقريبًا 1.3 أوقية) / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / مَعْلُومَة, حَقِيقَة / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / سلسلة جبال / سلالة لياو, لياو (السلالة التي حكمت جزءاً كبيراً من منشوريا وشمال شرق الصين من 947 إلى 1125)",
 "りょうあえんこう": "سميثسونيت",
 "りょうい": "مُعْجِزَة, أُعْجُوبَة",
 "りょういき": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "りょういきかくほ": "تجزئة, تقسيم (عملية التقسيم أو التجزئة؛ الفصل عن طريق إنشاء حدود تقسم أو تبقي الأشياء متباعدة) / تصنيف, تقسيم (تحليل إلى فئات متنافية)",
 "りょうえん": "بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "りょうか": "تكميم, قياس كمي (فعل اكتشاف أو التعبير عن كمية شيء ما) / تسوير, تكميم (قيد مفروض على متغيرات قضية منطقية (مثل المحددات الكمية 'بعض' أو 'كل' أو 'لا')) / تَحْسِين / كستناء الماء (درنة بصلية صالحة للأكل لنبات مستنقعات صيني) / كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة) / جوز الماء, كستناء الماء (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "りょうかい": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "りょうかいじこう": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "りょうかいずみ": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "りょうかく": "زَاوِيَة, رُكْن / زاوية الالتواء, زاوية زوجية (الزاوية بين مستويين)",
 "りょうかし": "مُحَدِدْ الْكَمِيَّةْ (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "りょうかん": "ثقل, جسامة (خاصية كون الشيء كبيراً في الكتلة) / ثقل, ضخامة (كبر حجم غير عملي أو يصعب التعامل معه) / مشرف سكن طلابي (معلم مسؤول عن سكن داخلي مدرسي)",
 "りょうかんせい": "نظام الغنائم, نظام المحسوبية (نظام توظيف وترقية الموظفين المدنيين الذين هم أصدقاء ومؤيدون للمجموعة الحاكمة)",
 "りょうかんせいど": "نظام الغنائم, نظام المحسوبية (نظام توظيف وترقية الموظفين المدنيين الذين هم أصدقاء ومؤيدون للمجموعة الحاكمة)",
 "りょうが": "فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / فَائِق, مُتَعَالٍ (يتجاوز الحدود المعتادة لا سيما في التفوق)",
 "りょうがえ": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "りょうがえじょ": "صِرَافَة اَلْعُمْلَات, مَكْتَب صِرَافَة",
 "りょうがくいんめん": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "りょうがんし": "رؤية بكلتا العينين, رؤية ثنائية (الرؤية التي تنطوي على استخدام كلتا العينين)",
 "りょうき": "موسم الصيد (الموسم الذي يكون فيه صيد الأسماك قانونيًا) / موسم الصيد (الموسم الذي يكون فيه قتل نوع معين قانونيًا)",
 "りょうきき": "براعة يدوية مزدوجة, مهارة كلتا اليدين (خاصية المهارة المتساوية بكلتا اليدين)",
 "りょうきごう": "مُحَدِدْ الْكَمِيَّةْ (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "りょうきてき": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "りょうきゃくき": "فِرْجَار, بِرْكَار",
 "りょうきゅう": "تَلّ, أَكَمَة (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: لقد تسلقت تل طويل",
 "りょうきん": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "りょうきんじょ": "بوابة رسوم (بوابة أو حاجز عبر جسر أو طريق برسوم مرور يتم رفعها عند دفع الرسوم)",
 "りょうきんひょう": "تَعَارِيف, تَعْرِفَة / تَعَارِيف",
 "りょうぎゃく": "إِذْلَال, ذِلَّة",
 "りょうくどこう": "مغنسيت (معدن أبيض يتكون من كربونات المغنيسيوم؛ مصدر للمغنيسيوم)",
 "りょうくどせき": "مغنسيت (معدن أبيض يتكون من كربونات المغنيسيوم؛ مصدر للمغنيسيوم)",
 "りょうぐち": "زَوْجَانِ / بَعْضُ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "りょうけい": "مُعَيِّن / ثنائية الشكل ((في علم الأحياء) وجود شكلين من الأفراد ضمن نفس النوع الحيواني (بشكل مستقل عن الفروق الجنسية)) / ثنائية الشكل ((في الكيمياء) خاصية بعض المواد التي تمكنها من الوجود في شكلين بلوريين متميزين)",
 "りょうけいきん": "عضلة معينية (أي من عدة عضلات في الجزء العلوي من الظهر تساعد في تحريك لوح الكتف)",
 "りょうけん": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة / مَغْفِرَة, غُفْرَان / كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "りょうけんちがい": "خِدَاع, ضَلَالَة / غَرُور",
 "りょうげんのひ": "حَرِيق هَائِل (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "りょうこう": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "りょうこくかん": "ثُنَائِيّ",
 "りょうごく": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "りょうさつ": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "りょうさん": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "りょうさんひん": "مُنْتَجٌ بِالجُمْلَةِ (مُنتَج بكميات كبيرة غالباً بتقنيات خطوط التجميع)",
 "りょうし": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا. / صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا. / كَمّ / ورق كتابة (مادة ورقية مصنعة في شكل أوراق رقيقة بحجم مناسب لتقبل الحبر؛ تستخدم لكتابة المراسلات والمخطوطات) / مُصَنِّف, مُصَنِّفَة",
 "りょうしいろりきがく": "ديناميكا لونية كمية (نظرية التفاعلات القوية بين الجسيمات الأولية)",
 "りょうしか": "تكميم (عملية التقسيم إلى كمات أو التعبير بمصطلحات نظرية الكم)",
 "りょうしき": "بديهة, حس سليم (حكم عملي سليم)\nمثال: الحس السليم ليس شائعًا جدًا",
 "りょうしきある": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "りょうしつ": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "りょうしでんきりきがく": "ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "りょうしでんじりきがく": "ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "りょうしぶつりがく": "فيزياء الكم (فرع الفيزياء القائم على نظرية الكم)",
 "りょうしもつれ": "تشابك كمي",
 "りょうしゃ": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / مَهْجَع",
 "りょうしゅ": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "りょうしゅう": "إِيصَال / قَائِد, زَعِيم",
 "りょうしょ": "الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "りょうしょう": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "りょうしょうずみ": "مُعْتَرَف بِه, مُقَرّ بِه (تم التعرف عليه أو الإعلان عنه أو الإقرار به) / مُعْتَرَفٌ بِهِ (مقبول ومُسَلَّمٌ به عمومًا)\nمثال: القائد المعترف به للمجتمع",
 "りょうしょく": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة) / فَحْشَاء, فِسْق",
 "りょうしりきがく": "ميكانيكا الكم",
 "りょうしろん": "نَظَرِيَّة كَمّ (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "りょうしん": "ضَمِير (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر) / طَوِيَّة / وِجْدَان\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة / وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "りょうしんおん": "شَفَتَانِيّ",
 "りょうしんてき": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / حي الضمير, متفانٍ (يسترشد بالضمير أو بما يتوافق معه أو مع الشعور بالصواب والخطأ)\nمثال: قرار نابع من الضمير بالتحدث علناً عن الظلم",
 "りょうしんてきへいえききょひしゃ": "مستنكف ضميرياً (من يرفض الخدمة في القوات المسلحة لأسباب تتعلق بالضمير)",
 "りょうしんのしゅうじん": "سَجِين الرَأْي",
 "りょうしコンピュータ": "حاسوب كمي (نظام حوسبة يستفيد بشكل مباشر من الظواهر الميكانيكية الكمومية، مثل التراكب والتشابك، لإجراء عمليات على البيانات)",
 "りょうしコンピューター": "حاسوب كمي (نظام حوسبة يستفيد بشكل مباشر من الظواهر الميكانيكية الكمومية، مثل التراكب والتشابك، لإجراء عمليات على البيانات)",
 "りょうじ": "قُنْصُل / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "りょうじかん": "قُنْصُلِيَّة",
 "りょうじじむしょ": "قُنْصُلِيَّة",
 "りょうじょ": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "りょうじょう": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "りょうじょうのくんし": "لِصّ, لِصَّة / فَأْرَة, فَأْر",
 "りょうじょく": "سَبَّ, شَتَمَ (تفاحة) / إهانة\nمثال: كتب سامي رواية تحتوى على أكثر من سب مئة صفحة. / اِعْتِدَاء جِنْسِيّ",
 "りょうじん": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / إنسان طيب, فاعل خير (شخص يعامل الآخرين بإحسان)",
 "りょうすい": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "りょうすいき": "عداد المياه (عداد لقياس كمية المياه المارة عبر مخرج معين)",
 "りょうすいけい": "عداد المياه (عداد لقياس كمية المياه المارة عبر مخرج معين)",
 "りょうすいひょう": "مقياس مستوى الماء, ميزان ماء / مَنْسُوب المِيَاه, مُسْتَوَى المَاء (مستوى سطح جسم مائي) / خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن السفينة) / مستوى الماء, منسوب المياه الجوفية (السطح تحت الأرضي الذي تكون الأرض تحته مشبعة بالكامل بالماء)\nمثال: أمطار الربيع رفعت منسوب المياه الجوفية",
 "りょうする": "مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "りょうせい": "بَرْمَائِيّ (يعمل أو يعيش على اليابسة وفي الماء) / برمائي (متعلق بحيوانات طائفة البرمائيات أو مميز لها)\nمثال: مركبات برمائية / طالب داخلي (تلميذ يعيش في المدرسة خلال الفصل الدراسي) / مقتحم السفينة, مهاجم (شخص يشق طريقه بالقوة للصعود على متن سفينة) / ساكن, نزيل (مستأجر في منزل شخص آخر)\nمثال: استعدوا لصد المقتحمين / كَرِيم, لَطِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "りょうせいあい": "ازدواجية الميول الجنسية (النشاط الجنسي مع كل من الرجال والنساء) / ازدواجية الجنس, خنوثة (إظهار خصائص كلا الجنسين)",
 "りょうせいあいしゃ": "مزدوج الميل الجنسي",
 "りょうせいぐゆう": "خناثي, خنثوي (لديه خصائص الذكور والإناث معاً) / خنثوي (يتعلق بـ أو يظهر أعضاء جنسية ذكرية وأنثوية معاً ولكن بمظهر أنثوي غالب)",
 "りょうせいしゅよう": "ورم حميد (ورم غير سرطاني)",
 "りょうせいてき": "خناثي, خنثوي (لديه خصائص الذكور والإناث معاً) / خنثوي (يتعلق بـ أو يظهر أعضاء جنسية ذكرية وأنثوية معاً ولكن بمظهر أنثوي غالب)",
 "りょうせいるい": "بَرْمَائِيّ / بَرْمَائِيّ, قَازِب",
 "りょうせん": "خط التلال (سلسلة طويلة وضيقة من التلال)",
 "りょうぜつ": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "りょうぜん": "بَدِيهِيّ, بَدَهِيّ / شَفَّاف / وَاضِح",
 "りょうだて": "اِمْتَطَى",
 "りょうだん": "تنصيف (التقسيم إلى جزأين متساويين)",
 "りょうち": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد) / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ) / مُرَبًّى / حَافَظَ / حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / ذَاكِرَة / أُسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: حفظ رقم هاتفها.",
 "りょうちょう": "طائر صيد, طائر طريدة (أي طائر (مثل الطيهوج أو التدرج) يتم صيده كرياضة)",
 "りょうちょく": "أحقية, حق (أي شيء يتفق مع مبادئ العدالة)\nمثال: يشعر أنه على حق",
 "りょうて": "عَشَرَة, عَشْرَة",
 "りょうてい": "جوسق, شرفة حديقة (مبنى صغير مسقوف يوفر الظل والراحة) / تَقْيِيم / تَقْدِير, تَقْيِيم",
 "りょうてき": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس) / كمي ((للشعر) له نظام متري يعتمد على المدة النسبية للمقاطع) / كمي (يتعلق بقياس الكمية)\nمثال: تصدير القمح دون قيود كمية",
 "りょうてきき": "براعة يدوية مزدوجة, مهارة كلتا اليدين (خاصية المهارة المتساوية بكلتا اليدين)",
 "りょうてっこう": "نَيْزَك حَدِيدِيّ (حجر نيزكي يتكون أساساً من النيكل والحديد) / سيدريت (خام حديد في شكل كربونات الحديدوز)",
 "りょうとう": "مزدوج الميل الجنسي",
 "りょうとうせいじ": "حكم ثنائي (شكل من أشكال الحكم بوجود حاكمين مشتركين)",
 "りょうとうつかい": "مزدوج الميل الجنسي",
 "りょうとうづかい": "مزدوج الميل الجنسي",
 "りょうとうろんぽう": "مُعْضِلَة / مِحْنَة",
 "りょうとく": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / سَرِقَة, سَرَقَة",
 "りょうとくざい": "استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "りょうとする": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "りょうとつ": "عَدَسِيّ, مُحَدَّبُ الوَجْهَيْنِ (مُحَدَّب مِنْ كِلَا الجانِبَيْنِ؛ بِشَكْلِ العَدَسَة)",
 "りょうど": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "りょうどう": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات) / قِيَادَة",
 "りょうどかいふくしゅぎ": "وَحْدَوِيّة",
 "りょうどかいふくしゅぎしゃ": "مناصر لاستعادة الأرض (مدافع عن استعادة الأراضي القومية المحتلة)",
 "りょうどり": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "りょうない": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "りょうにん": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / إنسان طيب, فاعل خير (شخص يعامل الآخرين بإحسان)",
 "りょうのう": "قدرة طبيعية, قدرة فطرية (القدرة الموروثة) / دماغ خلفي (الجزء الخلفي من الدماغ بما في ذلك المخيخ وجذع الدماغ)",
 "りょうはせい": "صلاحية للإبحار (اللياقة لعبور البحار)",
 "りょうはんてん": "سوق مركزي, متجر متعدد الأقسام (متجر تجزئة كبير منظم في أقسام تقدم مجموعة متنوعة من البضائع؛ عادة ما يكون جزءاً من سلسلة متاجر)",
 "りょうば": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين) / منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "りょうばのけん": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "りょうばのこぎり": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "りょうばのつるぎ": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "りょうばば": "مسار سريع (وسيلة سريعة لتحقيق هدف)\nمثال: رأوا الاستقلال كمسار سريع للديمقراطية",
 "りょうびょう": "شِفَاء / شَفَى",
 "りょうびん": "سَوَالِف, سَالِف اَلشَّعْر",
 "りょうふ": "مشرف سكن (رجل مسؤول عن الأطفال في مؤسسة)",
 "りょうぶん": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "りょうほ": "حصن, معقل (جزء بارز من سور أو تحصين آخر) / حصن, قلعة (معقل يمكن للناس الذهاب إليه للاحتماء أثناء المعركة) / حصن, معقل (مجموعة تدافع عن مبدأ ما)\nمثال: معقل ضد الفساد",
 "りょうほう": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "りょうほうこう": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "りょうほうし": "معالج (شخص ماهر في نوع معين من العلاج)",
 "りょうほうとも": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "りょうほんいせい": "نظام المعدنين (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكميات محددة من معدنين (عادة الذهب والفضة) مع تحديد قيم بنسبة محددة مسبقاً)",
 "りょうぼ": "مشرفة سكن (امرأة تعمل كمرافقة في سكن للشباب)",
 "りょうぼく": "خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "りょうまい": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "りょうまえ": "مزدوج الصدر ((عن الملابس) يغلق بلف حافة واحدة من الأمام جيداً فوق الأخرى عادةً بصف مزدوج من الأزرار)\nمثال: سترة مزدوجة الصدر",
 "りょうみ": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "りょうみん": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "りょうめ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "りょうめんかち": "ازدواجية المشاعر, تناقض وجداني (مشاعر أو عواطف مختلطة)",
 "りょうめんさくせん": "ثُنَائِيُّ الشُّعَب (ذُو شُعْبَتَيْن)",
 "りょうめんしだ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "りょうめんたい": "موشور معيني (متوازي سطوح يحده ستة أوجه متشابهة (إما معينات أو متوازيات أضلاع))",
 "りょうめんコピー": "ثُنَائِيّ الجَانِب (ذو جانبين أو جزأين) / ذو وجهين, قابل للقلب (يمكن قلبه أو استخدامه على أي من الجانبين)\nمثال: سترة ذات وجهين",
 "りょうもく": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "りょうや": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "りょうゆう": "شَرِيك, شَرِيكَة / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "りょうゆうけん": "دومينيون (واحدة من الدول ذاتية الحكم في الكومنولث البريطاني) / إِقْلِيم إِدَارِيّ, مُقَاطَعَة (منطقة محدّدة لأغراض إداريّة أو غيرها) / حكم, سلطان (الهيمنة أو السلطة من خلال السلطة القانونية)\nمثال: احتفظت فرنسا بحكم لا جدال فيه على مناطق شاسعة من أفريقيا",
 "りょうよう": "تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة)",
 "りょうようしょ": "مَصَحَّة",
 "りょうようじょ": "مَصَحَّة",
 "りょうようひ": "نفقة طبية (المبلغ المنفق لتشخيص أو علاج أو الوقاية من المشاكل الطبية)",
 "りょうらん": "بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة",
 "りょうり": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ. / تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء",
 "りょうりおんせん": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "りょうりしょ": "كِتَاب طَبْخ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "りょうりぢゃや": "مَطْعَم",
 "りょうりつ": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف) / تَعَارِيف, تَعْرِفَة / تَعَارِيف",
 "りょうりつう": "ذَوَّاق",
 "りょうりてん": "مَطْعَم",
 "りょうりどうぐ": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "りょうりにん": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "りょうりばん": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "りょうりほう": "إعداد الطعام, طبخ (فعل إعداد شيء (كالطعام) بتطبيق الحرارة)\nمثال: الطبخ يمكن أن يكون فناً رائعاً",
 "りょうりゃく": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "りょうりや": "مَطْعَم",
 "りょうりょう": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / وَحِيد, مُوحِش / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى. / رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح)",
 "りょうりレシピ": "وَصْفَة",
 "りょうる": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر. / مِقْبَض",
 "りょうマンガンこう": "رودوكروزيت (معدن يتكون من كربونات المنغنيز؛ مصدر للمنغنيز)",
 "りょかく": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "りょかくしせつしようりょう": "بيرفلوروكربون (غاز دفيئة قوي ينبعث أثناء إنتاج الألومنيوم)",
 "りょかくせん": "سفينة ركاب (سفينة بنيت لنقل الركاب)",
 "りょかくれっしゃ": "قطار ركاب (قطار يحمل الركاب)",
 "りょがい": "مُفَاجِئ / فَظّ",
 "りょきゃく": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "りょきゃくせん": "سفينة ركاب (سفينة بنيت لنقل الركاب)",
 "りょきゃくれっしゃ": "قطار ركاب (قطار يحمل الركاب)",
 "りょく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "りょくいんじゅ": "شجرة ظل (شجرة تزرع أو تقدر قيمتها بشكل رئيسي لظلها من أشعة الشمس)",
 "りょくえき": "عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "りょくおうしょく": "أصفر مخضر (درجة من الأصفر مشوبة بالأخضر)",
 "りょくか": "استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "りょくかやね": "حديقة سطح (حديقة على سطح مبنى مسطح)",
 "りょくぎょく": "زُمُرُّد / أَخْضَر زُمُرُّدِيّ, خَضْرَاء زُمُرُّدِيَّة (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا)\nمثال: ذلك الضوء أخضر.",
 "りょくぎょくずい": "كريسوبراز (نوع أخضر من الكالسيدوني يُثمّن كحجر كريم)",
 "りょくぎょくせき": "زُمُرُّد / أَخْضَر زُمُرُّدِيّ, خَضْرَاء زُمُرُّدِيَّة (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا)\nمثال: ذلك الضوء أخضر.",
 "りょくさ": "رمل أخضر (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "りょくさく": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية) / كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "りょくしょう": "زِنْجَار / زِنْجَارِيّ",
 "りょくしょく": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "りょくせっけん": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية)",
 "りょくせんせき": "أكتينوليت (معدن أخضر من مجموعة الأمفيبول؛ سيليكات الكالسيوم والمغنيسيوم والحديد)",
 "りょくそう": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة) / خضرة, نضارة (المظهر الغزير للنباتات المزدهرة) / خضرة (أوراق خضراء)",
 "りょくそうしょくぶつ": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "りょくそうしょくぶつもん": "الطحالب الخضراء, قسم الطحالب الخضراء (قسم كبير من الطحالب حقيقية النواة التي تعيش بشكل رئيسي في المياه العذبة وتمتلك الكلوروفيل أ وب وتخزن الغذاء على شكل نشا ولها جدران خلوية سيليلوزية)",
 "りょくそうるい": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "りょくちたい": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "りょくちゃ": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "りょくちゅうせき": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "りょくでいせき": "كلوريت (معدن أخضر أو أسود بشكل عام؛ يوجد كمكون للعديد من الصخور عادة في شكل بلورة مسطحة)",
 "りょくとう": "مَاش",
 "りょくどう": "حزام أخضر (حزام من المتنزهات أو الأراضي الريفية المحيطة ببلدة أو مدينة)",
 "りょくないしょう": "زَرَق, المَاء الأَزْرَق",
 "りょくば": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم مشابه آخر غير ملامس له)",
 "りょくひ": "سماد أخضر (محصول نامٍ يتم حرثه في التربة لإغنائها)",
 "りょくようかんらん": "كُرْنُب أَجْعَد",
 "りょくりん": "غابة خضراء (أراضي حرجية مكتملة الأوراق)",
 "りょぐ": "أمتعة, حقائب سفر (حقائب تستخدم لحمل المتعلقات عند السفر) / أمتعة عسكرية (المعدات المحمولة واللوازم لجيش ما) / امرأة سيئة السمعة (امرأة عديمة القيمة أو غير أخلاقية)",
 "りょけん": "جَوَاز سَفَر, إِجَازَة مُرُور",
 "りょけんさしょう": "تَأْشِيرَة, فِيزَا",
 "りょこう": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "りょこうあんない": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "りょこうあんないしょ": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "りょこうか": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "りょこうかばん": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "りょこうがいしゃ": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうきゃく": "سَائِح, سَائِحَة",
 "りょこうぎょうしゃ": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうぎょうしゃだいりぎょう": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうぎょうほう": "وَكَالَةُ سَفَر",
 "りょこうけいかく": "خطة سفر, مسار رحلة (مسار مقترح للسفر)",
 "りょこうこぎって": "شيك سياحي, شيك مسافر (خطاب اعتماد يصدره بنك أو شركة شحن سريع يكون قابلاً للدفع عند تقديمه لأي مراسل للمصدر)",
 "りょこうさき": "وِجْهَة, وُجْهَة",
 "りょこうしゃ": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب. / وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうしゃけっせんしょう": "سفر جوي, طيران (السفر عبر الطائرات)\nمثال: السفر الجوي ينطوي على الكثير من الانتظار في المطارات",
 "りょこうしゃようこぎって": "شيك سياحي, شيك مسافر (خطاب اعتماد يصدره بنك أو شركة شحن سريع يكون قابلاً للدفع عند تقديمه لأي مراسل للمصدر)",
 "りょこうだいりてん": "وكيل سفر, وكيل سياحي (شخص يبيع أو يرتب رحلات أو جولات للعملاء)",
 "りょこうにってい": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "りょこうばと": "حمام مهاجر (حمامة مهاجرة اجتماعية من أمريكا الشمالية منقرضة الآن)",
 "りょしゃ": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "りょしゅう": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "りょじ": "فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق.",
 "りょじん": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "りょじんぼく": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من عصارة مائية صافية؛ يشاع أنه مصدر طوارئ للمياه للمسافرين)",
 "りょだん": "لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "りょっか": "استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "りょっかやね": "حديقة سطح (حديقة على سطح مبنى مسطح)",
 "りょっこう": "جهد, عناء (استخدام الطاقة البدنية أو العقلية؛ العمل الشاق)\nمثال: حصل على درجة امتياز لجهده",
 "りょてい": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق.",
 "りょてん": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "りょはん": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "りょひ": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل)",
 "りょり": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "りよう": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / بَالَاد / حَلَّاق / حلاقَة",
 "りよういん": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようかのう": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "りようきゃく": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "りようけん": "تَذْكِرَة / تذكرة",
 "りようし": "حَلَّاق / حلاقَة",
 "りようしつ": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようしゃ": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "りようしゃしょうめいしょう": "شَهَادَة",
 "りようしょ": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようてん": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "りようほう": "اِسْتِخْدَام",
 "りようめいさい": "بيان محاسبي, كشف حساب (بيان بالمعاملات الحديثة والرصيد الناتج)\nمثال: يرسلون لي كشف حساب كل شهر",
 "りよく": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "りりき": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "りりく": "إِقْلَاع",
 "りりしい": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "りりつ": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "りりょ": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "りりょう": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "りりょく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "りれき": "خلفية / خَشَبَة / تخلفية, هستيريا مغناطيسية (تأخر التأثير عن سببه؛ وخاصة الظاهرة التي يتخلف فيها الحث المغناطيسي لمادة فيرومغناطيسية عن المجال المغناطيسي المتغير)",
 "りれきげんしょう": "تخلفية, هستيريا مغناطيسية (تأخر التأثير عن سببه؛ وخاصة الظاهرة التي يتخلف فيها الحث المغناطيسي لمادة فيرومغناطيسية عن المجال المغناطيسي المتغير)",
 "りれきしょ": "سِيرَة ذَاتِيَّة",
 "りろ": "مَنْطِق (عِلْمُ المَنْطِق: هو عِلْم من العلوم البحتة هدفه البَحْث عن قواعد التفكير السَوِية البعيدة عن الخَطَأ. يسمى أيضا بالمِيزان؛ العقل والتفكير السويّ الحكيم)\nمثال: غزة منطقة مكشوفة.",
 "りろせいぜん": "مَنْطِقِيّ",
 "りろん": "نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "りろんか": "مُنَظِّر",
 "りろんじょう": "على الورق, نظرياً (في النظرية؛ وفقاً للحقائق المفترضة) / نظرياً (بطريقة نظرية)\nمثال: على الورق يبدو المرشح واعداً / نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "りろんてき": "نَظَرِيّ (المنسوب إلى النَظَر؛ في : العِلْم النَظَرِيّ هو العلم الذي يُفحص بالنظر لا بالاختبار ويشمل غالبا العلوم التي تعتمد على ما في بطون الكتب مثل الفَلْسَفَة والآدَاب…)\nمثال: إنها مجرد نظرية.",
 "りをえる": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "りん": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي) / فُسْفُور / جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ) / اِتِّصَال\nمثال: ياني يرن الجرس. / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور / صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر / شَفَّاف / وَاضِح",
 "りんうんも": "ليبيدوليت (معدن من مجموعة الميكا؛ مصدر مهم لليثيوم)",
 "りんか": "سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "りんかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / حراجة (حالة حرجة؛ خاصة النقطة التي يصبح فيها التفاعل النووي مستداماً ذاتياً) / حرج, خطورة (حالة من الإلحاح الحرج) / النقد / سَاحِلِيّ (يقع على أو بالقرب من أو يحد ساحلاً) / سَاحِلِيّ, مُحَاذٍ لِلسَّاحِل (على طول الساحل أو يتبعه) / ساحلي (من أو متعلق بساحل)\nمثال: مستنقعات ساحلية / مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "りんかいかく": "زَاوِيَة حَرِجَة",
 "りんかいせき": "أباتيت",
 "りんかいてん": "مفترق طرق, منعطف حرج (حالة أزمة أو نقطة زمنية يجب فيها اتخاذ قرار حاسم)\nمثال: في ذلك المنعطف لم يكن لديه أدنى فكرة عما يجب فعله",
 "りんかいりょう": "كتلة حرجة (الحد الأدنى من كتلة المواد القابلة للانشطار التي يمكن أن تحافظ على التفاعل المتسلسل) / كتلة حرجة (الحد الأدنى من الكمية (لشيء ما) المطلوب لبدء مشروع أو الحفاظ عليه)\nمثال: وصلت المعركة من أجل سوق الكمبيوتر الآن إلى الكتلة الحرجة",
 "りんかく": "بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / ملامح عامة, هيئة (ميزة (أو ترتيب الميزات) لأي شيء له هيكل معقد) / خط الكنتور, خط المناسيب (خط مرسوم على خريطة يربط بين النقاط المتساوية الارتفاع)\nمثال: بالكاد استطاع تمييز أشكالهم / خُلَاصَة, مُلَخَّص / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "りんかくせん": "لَخَّصَ, اِخْتَصَرَ",
 "りんかすいそ": "فوسفين (غاز عديم اللون له رائحة سمكية قوية؛ يستخدم كمبيد للآفات)",
 "りんかん": "اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب. / سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "りんが": "بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "りんがく": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "りんき": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف. / مُنَاسِب, مُلَائِم / تُفَّاحَة / تُفَّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاحة\nمثال: هذه تفاحة أيضا.",
 "りんきおうへん": "خِصِّيصًا لِهَذَا الغَرَض (لغرض محدد) / لِغَرَض بِعَيْنِه, مَخْصُوص (مُخصَّص لغرض واحد معين أو معنيّ به) / مَخْصُوص, مُرْتَجَل (غالباً ما يكون مرتجلاً أو مخصصاً لغرض آني)\nمثال: تم تعيينهم لهذا الغرض",
 "りんきょ": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "りんきん": "مكورة بنية, نيسرية بنية (البكتيريا المنتجة للقيح التي تسبب السيلان) / تُفَّاحَة / تُفَّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاحة\nمثال: هذه تفاحة أيضا.",
 "りんぎょう": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "りんけい": "حَلَقِيّ, دَائِرِيّ (ذو شكل يشبه الحلقة أو الخاتم) / انتفاخ, بصيلة (جزء مستدير من أداة أسطوانية (عادة في أحد الطرفين)) / لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء) / بَصَلَة (اتساع أو تمدد مستدير في قناة أو وعاء أو عضو) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي)\nمثال: بصيلة المحقنة / تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "りんけいせき": "تريديميت (شكل معدني من السيليكا)",
 "りんけいどうぶつ": "حيوان دولابي, دولابيات (كائنات دقيقة متعددة الخلايا مائية لها عضو مهدب يشبه العجلة للتغذية والحركة)",
 "りんけん": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "りんこ": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / فِي الجِوَار, فِي المَنْزِل المُجَاوِر (في أو إلى المسكن المجاور)\nمثال: كان المجرم يعيش في المنزل المجاور طوال هذا الوقت",
 "りんこう": "تالق فسفوري, فسفرة (فلورة تستمر بعد توقف الإشعاع القاصف)",
 "りんこうもく": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل للتغذى على النمل والنمل الأبيض)",
 "りんこうれっしゃ": "قطار الميناء (قطار ينقل الركاب من أو إلى الميناء)",
 "りんこく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "りんご": "تُفَّاحَة / تُفَّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاحة\nمثال: هذه تفاحة أيضا. / شَجَرَةُ اَلتُّفَّاحِ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "りんごあめ": "تفاح الحلوى, تفاح مكرمل (تفاحة مغطاة بمادة تشبه الحلوى (عادة سكر مكرمل))",
 "りんごえん": "بستان تفاح (بستان من أشجار التفاح)",
 "りんごさん": "حَمْض التُّفَّاح (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "りんごしゅ": "سِيدَر",
 "りんごす": "خل التفاح (خل مصنوع من عصير التفاح)",
 "りんごばたけ": "بستان تفاح (بستان من أشجار التفاح)",
 "りんごアメ": "تفاح الحلوى, تفاح مكرمل (تفاحة مغطاة بمادة تشبه الحلوى (عادة سكر مكرمل))",
 "りんごジュース": "عَصِير التُّفَّاح (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "りんご園": "بستان تفاح (بستان من أشجار التفاح)",
 "りんご酒": "سِيدَر",
 "りんご酢": "خل التفاح (خل مصنوع من عصير التفاح)",
 "りんご飴": "تفاح الحلوى, تفاح مكرمل (تفاحة مغطاة بمادة تشبه الحلوى (عادة سكر مكرمل))",
 "りんさい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "りんさん": "حمض الفوسفوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "りんさんえん": "شراب الفوسفات (مشروب غازي مع شراب الفاكهة وقليل من حمض الفوسفوريك) / فوسفات (ملح لحمض الفوسفوريك)",
 "りんさんカルシウム": "فوسفات الكالسيوم (فوسفات للكالسيوم؛ مكون رئيسي لعظام الحيوانات)",
 "りんさんナトリウム": "فوسفات الصوديوم (فوسفات للصوديوم؛ يستخدم كملين لتنظيف الأمعاء)",
 "りんざい": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "りんししつ": "دُهْن فُوسْفُورِيّ, لِيبِيد مُفَسْفَر (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "りんしたいけん": "تجربة الاقتراب من الموت (تجربة القرب من الموت ولكن النجاة منه)",
 "りんしつ": "سَيَلَان",
 "りんしゃ": "نسخ (فعل النسخ)",
 "りんしょ": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "りんしょう": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية / صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "りんしょうい": "إكلينيكي, سريري (ممارس (للطب أو علم النفس) يقوم بعمل سريري بدلاً من التجارب المعملية)",
 "りんしょうか": "إكلينيكي, سريري (ممارس (للطب أو علم النفس) يقوم بعمل سريري بدلاً من التجارب المعملية)",
 "りんしょうこうぎ": "عِيَادَة, مَصَحَّة",
 "りんしょうしけん": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "りんしょうしんりがく": "عِلْم نَفْس سَرِيرِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "りんしょうしんりがくしゃ": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "りんしょうしんりし": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "りんしょうじょう": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية",
 "りんしょうてき": "بَارِد الأَعْصَاب, سَرِيرِيّ (منفصل علمياً وخالٍ من العاطفة) / إكلينيكي, سريري (متعلق بالعيادة أو يتم كما لو كان في عيادة ويعتمد على المراقبة المباشرة للمرضى)\nمثال: مراقبة سريرية",
 "りんしょうばい": "كرز الشجيرة الشرقي, لوز مزهر (نبات شرقي خشبي بفاكهة حمراء ملساء غير مجعدة يزرع خاصة لأزهاره البيضاء أو الوردية الشاحبة)",
 "りんしょく": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "りんしょくか": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "りんしるい": "حرشفيات الأجنحة (حشرة لها في حالة البلوغ أربعة أجنحة مغطاة بدرجة ما بحراشف صغيرة)",
 "りんじ": "مُؤَقَّت / خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / رِسَالَة خَاصَّة",
 "りんじきごう": "عَرْضِيّ",
 "りんじく": "العجلة والمحور, الملفاف (رافعة مرتبة بحيث يُلف حبل ينفك من عجلة على أسطوانة أو عمود متحد المحور مع العجلة)",
 "りんじこう": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "りんじしょくいん": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "りんじじゅうぎょういん": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "りんじてきさいようきょういん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "りんじひ": "مصروفات عرضية, نفقات نثرية ((غالباً بصيغة الجمع) مصروف لم يتم وضعه في الميزانية أو لم يتم تحديده)\nمثال: طلب تعويضاً قدره 7 دولارات عن نفقات نثرية",
 "りんじゅう": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "りんじゅうのとこ": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "りんじょう": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / حَلَقِيّ, دَائِرِيّ (ذو شكل يشبه الحلقة أو الخاتم) / مُحَرْشَف, حَرْشَفِيّ",
 "りんじょうかん": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "りんじん": "جَار, جَارة (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "りんせい": "عَرِيضَة, طَلَب / طَبِيعَة, طبيعة",
 "りんせいしょ": "عَرِيضَة, طَلَب",
 "りんせいどう": "برونز فوسفوري (برونز مقاوم للتآكل يحتوي على الفوسفور؛ يستخدم في المحامل والتروس)",
 "りんせき": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "りんせつ": "تَجَاوُر, تَلَاصُق (صفة القرب الشديد لدرجة التلامس) / مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "りんせつした": "مُجَاوِر",
 "りんせん": "سَعْفَة, قَرَع",
 "りんぜん": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "りんたんぱくしつ": "بروتين فوسفوري (يحتوي على حمض الفوسفوريك المرتبط كيميائياً)",
 "りんち": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "りんちゅうるい": "حيوان دولابي, دولابيات (كائنات دقيقة متعددة الخلايا مائية لها عضو مهدب يشبه العجلة للتغذية والحركة)",
 "りんてっこう": "ليبيدوكروشيت (معدن أحمر إلى بني محمر يتكون من هيدروكسيد أكسيد الحديد؛ يوجد غالباً في خامات الحديد مع الغوثيت)",
 "りんてん": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "りんてんき": "مكبس دوار (مكبس طباعة للطباعة من أسطوانة دوارة)",
 "りんどう": "جَنْطِيَانَا, كُوشَاد / حُجْرَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم) / غُرْفَة, غُرْفَةُ نَوْم (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / مَجْلِس\nمثال: قعدنا في وسط الحجرة.",
 "りんどうしきだんそう": "أُسْطُوَانَة",
 "りんどく": "سيلان (مرض تناسلي شائع تسببه بكتيريا النيسرية البنية؛ الأعراض هي تبول مؤلم وألم حول مجرى البول)",
 "りんね": "تناسخ الأرواح, سامسارا ((في الهندوسية والبوذية) الدورة اللانهائية من الولادة والمعاناة والموت والبعث) / تَنَاسُخُ الأَرْوَاحِ",
 "りんばん": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "りんばんせき": "أمبليغونيت (معدن أبيض أو رمادي يتكون من فوسفات الليثيوم والألمنيوم؛ وهو مصدر لليثيوم)",
 "りんびょう": "سَيَلَان",
 "りんぶ": "رقص دائري (رقصة صالونات تتميز بحركة دورانية) / رقص حلقي, رقصة دائرية (رقصة شعبية؛ يشكل الراقصون دائرة)",
 "りんぶきょく": "روندو (شكل موسيقي غالباً ما يكون الحركة الأخيرة للسوناتا)",
 "りんぶん": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "りんぷん": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "りんぺん": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم. / ضلع قائم",
 "りんぺんよう": "حرشفة (ورقة متخصصة أو قنابة تحمي برعماً أو نورة هرية)",
 "りんぽ": "جار, مجاور (جسم قريب من نفس النوع) / جَار (شخص يسكن (أو يقع) بالقرب من آخر)\nمثال: فورت وورث جارة لدالاس",
 "りんぽかん": "دار رعاية اجتماعية (مركز في منطقة محرومة يقدم خدمات مجتمعية)",
 "りんぽじぎょう": "خِدْمَة اجْتِمَاعِيَّة",
 "りんむ": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "りんむかん": "حراجي, خبير الغابات (شخص مدرب في علم الحراجة وزراعة الغابات)",
 "りんもう": "فارثنغ (عملة برونزية بريطانية سابقة بقيمة ربع بنس)",
 "りんよう": "حرشفة (ورقة متخصصة أو قنابة تحمي برعماً أو نورة هرية)",
 "りんらく": "خَرَاب, خَرَابَة / دَمَّرَ",
 "りんり": "أَخْلَاق, أَدَب / بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة / طَافِح, مَمْلُوء حَتَّى الحَافَة (مَمْلُوء إِلَى أَقْصَى حَدّ)",
 "りんりいいんかい": "لجنة الأخلاقيات (لجنة معينة للنظر في القضايا الأخلاقية)",
 "りんりかん": "أَخْلَاق, أَدَب / حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "りんりがく": "أَخْلَاق, أَدَب",
 "りんりきてい": "أخلاقيات, دستور أخلاقي (نظام من المبادئ التي تحكم الأخلاق والسلوك المقبول)",
 "りんりせい": "أَخْلَاق, أَخْلَاقِيَّة",
 "りんりつ": "شعرة خشنة, هلبه (شعرة صلبة) / شعرة خشنة, شعيرة (ألياف صلبة (شعر خشن أو خيط)؛ طبيعية أو اصطناعية)",
 "りんりてき": "أَخْلَاقِيّ",
 "りんりん": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع / عزف الكاريلون, قرع الأجراس (عزف مجموعة من الأجراس المعلقة (عادة) في برج) / حشد الأصوات, دعاية انتخابية (إقناع الناخبين في حملة سياسية) / قرع الأجراس (صوت شخص يعزف على مجموعة من الأجراس)",
 "りんれつ": "عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "りんタク": "ريكشو دراجة, عربة نقل بدواسات (دراجة ثلاثية العجلات (تدفع عادة بالتدويس)؛ تستخدم في الشرق لنقل الركاب بالأجرة)\nمثال: الأولاد الذين كانوا يسحبون الريكشو سابقاً يركبون الآن دراجات الريكشو",
 "りん粉": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "り災": "مُعَانَاة",
 "る": "نَفْي, تَبْعِيد / نَفَى",
 "るい": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / مُوَازٍ / مُتَوَازٍ / مُشْكِلَة, مَتاعِب",
 "るいいん": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "るいえき": "بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل",
 "るいえん": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "るいえんたい": "تَنَاظِرِيَّة",
 "るいおん": "ديافون (بوق ضباب يصدر إشارة تتكون من نغمتين)",
 "るいか": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته. / مُمَاثَلَة, تَمَاثُل",
 "るいかてき": "تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "るいがいねん": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "るいき": "جِهَاز دَمْعِيّ (الهياكل التي تفرز وتصرف الدموع من العين)",
 "るいきゅう": "الكرة اللينة, سوفتبول (لعبة تشبه البيسبول إلى حد كبير تُلعب في ملعب أصغر وبكرة أكبر) / سوفتبول, كرة لينة (الكرة المستخدمة في لعب السوفتبول)",
 "るいぎ": "تَرَادُف (العلاقة الدلالية التي تربط بين كلمتين يمكن (في سياق معين) أن تعبرا عن نفس المعنى)",
 "るいぎご": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة.",
 "るいぎごじてん": "مَكْنَز",
 "るいけい": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "るいけいか": "تمثيل رمزي (فعل التمثيل بنوع أو رمز) / تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي)",
 "るいけいがく": "تصنيف نمطي, نمذجة (التصنيف وفقاً للنوع العام)",
 "るいけいてき": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "るいけいろん": "تصنيف نمطي, نمذجة (التصنيف وفقاً للنوع العام)",
 "るいげん": "رجعي, نكوصي (يعارض التقدم؛ يعود إلى حالة سابقة أقل تقدماً) / تنازلي ((للضرائب) معدلة بحيث ينخفض المعدل مع زيادة الدخل)",
 "るいこつ": "عظم دمعي (عظم هش صغير يشكل جزءاً من الجدران الداخلية الأمامية لكل محجر عين ويوفر مساحة لمرور القنوات الدمعية)",
 "るいごじしょ": "مَكْنَز",
 "るいごじてん": "مَكْنَز",
 "るいさん": "مَجْمُوع",
 "るいさんき": "سجل المركم, مركم ((علم الحاسوب) سجل يحتوي على جامع مدمج يضيف رقم إدخال إلى محتويات السجل) / بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب))",
 "るいししつ": "دهون, ليبيد (مركب عضوي زيتي غير قابل للذوبان في الماء ولكنه قابل للذوبان في المذيبات العضوية؛ مكون هيكلي أساسي للخلايا الحية (إلى جانب البروتينات والكربوهيدرات))",
