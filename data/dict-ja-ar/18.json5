 "アシメトリック": "غير متماثل, غير متناظر (يتميز بعدم التماثل في الترتيب المكاني أو وضع الأجزاء أو المكونات)",
 "アシメトリー": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "アシュア": "أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "アシュアランス": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات) / تأكيد, طمأنة (بيان يهدف إلى إلهام الثقة) / تَعَهُّد, ضَمَان (التزام ملزم بالقيام بشيء أو إعطائه أو الامتناع عنه) / تأمين (بريطاني) (مصطلح بريطاني لبعض أنواع التأمين)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "アシュラム": "أشرم ((في الهند) مكان للخلوة الدينية للهندوس) / أشرم (مكان للخلوة الدينية مصمم على غرار الأشرم الهندي)",
 "アシュワガンダ": "اشواغاندا",
 "アシル": "أسيل, مجموعة أسيل",
 "アシルか": "أسيلة, أكلة (عملية إدخال مجموعة أسيل في مركب ما)",
 "アシルき": "أسيل, مجموعة أسيل\nمثال: مثال على مجموعة الأسيل هو مجموعة الأسيتيل",
 "アシル化": "أسيلة, أكلة (عملية إدخال مجموعة أسيل في مركب ما)",
 "アシル基": "أسيل, مجموعة أسيل\nمثال: مثال على مجموعة الأسيل هو مجموعة الأسيتيل",
 "アシンメトリ": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "アシンメトリック": "غير متماثل, غير متناظر (يتميز بعدم التماثل في الترتيب المكاني أو وضع الأجزاء أو المكونات)",
 "アシンメトリー": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "アジ": "إثارة, تحريك (فعل تحريك شيء ما؛ التسبب في تحركه (عادة بقوة)) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / اضطراب, هياج (الشعور بالاضطراب وعدم الهدوء) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة / جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / ماكريل الحصان (سمكة طعام كبيرة ممدودة ومضغوطة تعيش في مياه المحيط الأطلسي لأوروبا) / تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية)",
 "アジかぶつ": "أزيد (مركب كيميائي يحتوي على مجموعة الأزيد مقترنة بعنصر أو شق كيميائي)",
 "アジけん": "الْأُمَم الْمُتَّحِدَة",
 "アジる": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "アジア": "آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "アジアかぜ": "الإنفلونزا الآسيوية (إنفلونزا سببها الفيروس الآسيوي الذي تم عزله لأول مرة في عام 1957)",
 "アジアしょこく": "دولة آسيوية (أي دولة من الدول التي تشغل القارة الآسيوية)",
 "アジアじん": "آسِيَوِيّ / آسِيَوِيَّة",
 "アジアぞう": "فيل آسيوي, فيل هندي (فيل آسيوي له آذان أصغر وأنياب توجد أساساً لدى الذكور)",
 "アジアみんぞく": "دولة آسيوية (أي دولة من الدول التي تشغل القارة الآسيوية)",
 "アジアアフリカかいぎ": "أفرو-آسيوي (من أو يتعلق بدول أفريقيا وآسيا أو شعوبها)\nمثال: سكان أفرو-آسيويين",
 "アジアアフリカ会議": "أفرو-آسيوي (من أو يتعلق بدول أفريقيا وآسيا أو شعوبها)\nمثال: سكان أفرو-آسيويين",
 "アジアインフルエンザ": "الإنفلونزا الآسيوية (إنفلونزا سببها الفيروس الآسيوي الذي تم عزله لأول مرة في عام 1957)",
 "アジアン": "آسِيَوِيّ / آسِيَوِيَّة",
 "アジアンタム": "سرخس كزبرة البئر, كزبرة البئر (أي من السراخس الأرضية الصغيرة إلى الكبيرة المتنوعة من جنس أديانتوم لها سعف متفرع كفياً دقيقاً)",
 "アジア・インフルエンザ": "الإنفلونزا الآسيوية (إنفلونزا سببها الفيروس الآسيوي الذي تم عزله لأول مرة في عام 1957)",
 "アジア人": "آسِيَوِيّ / آسِيَوِيَّة",
