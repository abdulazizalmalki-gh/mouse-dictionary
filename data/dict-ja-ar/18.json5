 "よろしゅう": "مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よろず": "عَشَرَة آلَاف / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)\nمثال: واجه عدداً لا يحصى من التفاصيل / كُلّ شَيْء / مُخْتَلِف, مُتَنَوَّع",
 "よろずとせ": "عَشَرَة آلَاف",
 "よろずや": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً…)",
 "よろずよ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "よろず屋": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً…)",
 "よろつく": "تَرَنُّح",
 "よろぴく": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よろめく": "تَرَنُّح",
 "よろよろ": "آيِل لِلسُّقُوط, مُتَدَاعٍ ((للهياكل أو المؤسسات) فقد استقراره؛ يتهاوى أو على وشك الانهيار)",
 "よろん": "رَأْي عَامّ / رأي عارض, ملاحظة قضائية عارضة (رأي يبديه قاضٍ حول نقطة قانونية لا تؤثر بشكل مباشر على القضية المعنية وبالتالي…)",
 "よろんちょうさ": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "よろピク": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よわ": "نَادِرَة\nمثال: هي مدرسة لطيفة. / لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل…)\nمثال: كانت ليلة رائعة.",
 "よわい": "ضَعِيف / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "よわいする": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "よわいそうごさよう": "تفاعل ضعيف, قوة نووية ضعيفة ((في الفيزياء) تفاعل بين الجسيمات الأولية ينطوي على نيوترينوات أو مضادات…)",
 "よわいちから": "تفاعل ضعيف, قوة نووية ضعيفة ((في الفيزياء) تفاعل بين الجسيمات الأولية ينطوي على نيوترينوات أو مضادات…)",
 "よわいもの": "ضَعِيف",
 "よわいものいじめ": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ…)\nمثال: الإنفصاليون مثل الإرهاب.",
 "よわいをかさねる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "よわき": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان. / هُبُوطِيّ (يتوقع انخفاضاً في الأسعار)",
 "よわきいちば": "سوق هابطة (سوق يتميز بانخفاض أسعار الأوراق المالية)",
