 "わるもの": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "わるガキ": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "われ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة.",
 "われおもうゆえにわれあり": "أُفَكِّر، إِذَن أَنَا مَوْجُود, أُفَكِّر، إِذَن أُوجَد",
 "われから": "روبيان الهيكل العظمي (قشري صغير من مزدوجات الأرجل له شكل غريب يوحي بفرس النبي؛ يوجد بشكل رئيسي على الأعشاب البحرية)",
 "われがちに": "تَهَافَتَ",
 "われこそは": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "われしらず": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "われと": "لوحد / لحال / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "われとわがみ": "نَفْسِي",
 "われなべにとじぶた": "هُنَاكَ, يُوجَدُ",
 "われにかえる": "أَهْدَأَ, هَدَّأَ",
 "われにもあらず": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "われにもなく": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "われぼめ": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "われめ": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره) / قَطَعَ, شَطَبَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "われめちゃん": "فَرْج, حِرّ",
 "われものちゅうい": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "われやすい": "سَرِيعُ الكَسْر, هَشّ (قَلِيلُ المُرُونَة؛ يَسْهُلُ تَشَقُّقُهُ أَوِ انْكِسَارُهُ) / غَيْرُ مُلَدَّن, هَشّ ((لِلْمَعْدَنِ أَوِ الزُّجَاج) لَمْ يُلَدَّنْ وَبِالتَّالِي سَهْلُ التَّشَقُّقِ أَوِ الكَسْر) / جَافّ, قَاسٍ (يفتقر إلى الدفء والسخاء في الروح) / بريتل, توفي (سكر مكرمل مبرد في صفائح رقيقة)",
 "われら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "われらが": "ـنَا",
 "われる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / انفصل / مِشْبَك / كْلِيبْ",
 "われわれ": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "わろ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わろう": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "わろす": "هَهَه / خُخُخ / هَاهَا / لُول",
 "わろた": "هَهَه / خُخُخ / هَاهَا / لُول",
 "わわる": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "わをかける": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "わをむすぶ": "سَالَمَ, صَالَحَ",
 "わん": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة / خَلِيج, شَرْم / هَوْ / هَو هَو",
 "わんがた": "وِعَائِيُّ الشَّكْل (ذو شكل مقعّر مفتوح من الأعلى كالوعاء)",
 "わんがんきき": "حَرْب الْخَلِيج الثَّانِيَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "わんがんせんそう": "حَرْب الْخَلِيج الثَّانِيَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "わんがんせんそうしょうこうぐん": "متلازمة حرب الخليج (حالة طبية غير مؤكدة المصدر أثرت على العديد من قدامى المحاربين في حرب الخليج عام 1991؛ تتميز بالتعب والصداع والدوخة والغثيان والطفح الجلدي وآلام…)",
 "わんがんふんそう": "حَرْب الْخَلِيج الثَّانِيَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "わんきょく": "منحنى",
 "わんきょくぶ": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / انحناء الحبل, عروة (الجزء الأوسط من حبل مرتخٍ (لتمييزه عن أطرافه)) / جون, خليج واسع (خليج واسع يتشكل من انحناء في الخط الساحلي) / جون, خليج صغير (انحناء أو منحنى (خاصة في الخط الساحلي)) / انحناء الحبل (حلقة في حبل)\nمثال: خليج بنين",
 "わんげつ": "هِلَال",
 "わんこ": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "わんこう": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا. / درع الذراع (درع صفيحي يحمي الذراع)",
 "わんこつ": "رسغ, مفصل الرسغ (مفصل بين النهاية البعيدة للكعبرة والصف القريب من عظام الرسغ)",
 "わんさ": "بِسَخَاء, بِغَزَارَة (بطريقة سخية)",
 "わんさか": "بِسَخَاء, بِغَزَارَة (بطريقة سخية)",
 "わんしょう": "شريط الذراع (رباط يُرتدى حول العضد) / شريط الذراع (يُلبس حول الذراع كتعريف أو للإشارة إلى الحداد)",
 "わんしんけいそう": "ضَفِيرَة عَضُدِيَّة",
 "わんせい": "منحني البويضة ((عن بويضة النبات) منحنية بحيث تكون النقير بالقرب من القاعدة وتلامس سويقتها تقريبًا)",
 "わんそくどうぶつ": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام) / عضدي الأرجل (من أو ينتمي إلى شعبة عضديات الأرجل)",
 "わんそくるい": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام) / عضدي الأرجل (من أو ينتمي إلى شعبة عضديات الأرجل)",
 "わんちゃん": "كلب (مصطلحات غير رسمية للكلاب)",
 "わんつか": "قَلِيلًا",
 "わんとうこつきん": "الْعَضَلَة الْعَضُدِيَّة الْكُعْبُرُيَّة",
 "わんど": "بُحَيْرة شاطِئَة, لَاجُون (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "わんにゅう": "خليج",
 "わんぱく": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "わんぱくこぞう": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "わんぱくぼうず": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "わんぴ": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "わんりゅう": "تَيَّار الْخَلِيج",
 "わんりょく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "わんわん": "كلب (مصطلحات غير رسمية للكلاب) / نبح, هوهوة (نباح الكلب) / صراخ, عويل (صرخات عالية أثناء البكاء) / جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد / كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "わん公": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "わん子": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "わん曲": "منحنى",
 "わゴム": "شريط مطاطي (شريط ضيق من المطاط المرن يستخدم لتثبيت الأشياء (مثل الأوراق) معاً)",
 "をおいて": "غَيْر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "をかいして": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "をとおして": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "をも": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "をもって": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / بِسَبَب, بِحُكْم / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "を介して": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "を以って": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / بِسَبَب, بِحُكْم / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "を以て": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / بِسَبَب, بِحُكْم / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "を通して": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "ん": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ل (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لدى / مْتاع\nمثال: يا لها من جملة! / صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين. / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة. / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / إرَادَة / رَغْبَة, إرَادَة / وَدَّ (تمنى ورجا؛ أراد شيئا)\nمثال: السيدة وود طباخة جيدة.",
 "ん〜っ": "مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر)",
 "んがため": "لِكَي, لِ",
 "んず": "إرَادَة / رَغْبَة, إرَادَة / تَعَمَّدَ, نَوَى / يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "んだ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "んちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "んちわー": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "んっ": "مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر)",
 "んで": "لِأَنَّ / هكذا, بلا سبب / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "んな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "んば": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "んまい": "لَذِيذ / شَهِيّ",
 "んん": "هيكتومتر (وحدة مترية للطول تساوي 100 متر) / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "んんっ": "مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر)",
 "んー": "هيكتومتر (وحدة مترية للطول تساوي 100 متر)",
 "んーっ": "مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر)",
 "ゟ": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَدَلًا مِن / أَكْثَر مِن, عَنّ / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "ア": "مُتَوَسِّط, مِنَ الدَّرَجَة الثَّانِيَة (متوسط إلى رديء في الجودة) / ـِيّ / آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون. / الْأَرْجَنْتِين, الأرجنتين / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "アしきしゅうきゅう": "كرة القدم (لعبة كرة قدم يحاول فيها فريقان من 11 لاعباً ركل الكرة أو ضربها بالرأس إلى مرمى الخصم)",
 "アっ": "آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "アァ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "アア": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "アィディア": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "アイ": "نِيلِيّ / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "アイアイ": "آيْآي",
 "アイアイエス": "جهاز المخابرات العراقي (الذراع الأكثر شهرة وربما الأهم في النظام الأمني العراقي)\nمثال: تورطت المخابرات العراقية في العديد من الأنشطة الإرهابية",
 "アイアス": "حمض إندول الأسيتيك (هرمون نباتي يعزز استطالة السيقان والجذور)",
 "アイアニング": "كوي, كي (عمل استخدام الحرارة لتمليس الملابس المغسولة لإزالة أي تجاعيد) / ملابس للكي (الملابس (أو البياضات) التي يجب كيها أو تم كيها)\nمثال: كانت هناك سلة مليئة بالملابس للكي",
 "アイアン": "حَدِيد (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد) / حَدِيدِيّ / كَوَى\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "アイアンマン": "رجل حديدي (رجل قوي ذو قدرة تحمل بدنية استثنائية)",
 "アイアール": "إدارة الإيرادات الداخلية, مصلحة الضرائب (مجلس تابع للحكومة البريطانية يدير ويجمع الضرائب المباشرة الرئيسية) / إيريديوم (عنصر فلزي ثقيل هش من مجموعة البلاتين) / أشعة تحت الحمراء, ضوء تحت أحمر (إشعاع كهرومغناطيسي بأطوال موجية أطول من الضوء المرئي ولكن أقصر من موجات الراديو)",
 "アイイー": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "アイウエオ": "كَانَا",
 "アイエイチ": "تسخين بالحث (تسخين مادة موصلة ناتج عن تيار كهربائي مستحث فيها)",
 "アイエス": "تَنْظِيم الدَّوْلَة الْإِسْلَامِيَّة, الدَّوْلَة الْإِسْلَامِيَّة",
 "アイエスオー": "منظمة دولية",
 "アイエッチ": "تسخين بالحث (تسخين مادة موصلة ناتج عن تيار كهربائي مستحث فيها)",
 "アイエフ": "إنترفيرون (بروتين مضاد للفيروسات تنتجه الخلايا التي غزاها الفيروس؛ يثبط تكاثر الفيروس) / واجِهَة / صندوق مؤشرات (صندوق استثمار مشترك يستثمر في الأسهم التي تشكل أساس مؤشر أسهم أو سندات معروف) / صندوق مؤشر (صندوق استثمار مشترك أصوله عبارة عن أسهم مدرجة في قائمة معينة)",
 "アイエムエフ": "صُنْدُوق اَلنَّقْد اَلدُّوَلِيّ (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "アイエムオー": "المنظمة البحرية الدولية (وكالة الأمم المتحدة المعنية بالأنشطة البحرية الدولية)",
 "アイエルオー": "منظمة العمل الدولية (وكالة الأمم المتحدة المعنية بمصالح العمل والعمال)",
 "アイオダイン": "يُود",
 "アイオリ": "أيولي, صلصة الثوم (مايونيز بالثوم)",
 "アイオリソース": "أيولي, صلصة الثوم (مايونيز بالثوم)",
 "アイオリ・ソース": "أيولي, صلصة الثوم (مايونيز بالثوم)",
 "アイオワ": "آيوا",
 "アイオーシー": "اللجنة الأولمبية الدولية (المنظمة المسؤولة عن تنظيم الألعاب الأولمبية الحديثة)",
 "アイオーティ": "إِنْتَرْنَت الْأَشْيَاء (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "アイオーティー": "إِنْتَرْنَت الْأَشْيَاء (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "アイオーン": "أيون, دهر ((الغنوصية) قوة إلهية أو طبيعة تنبثق من الكائن الأسمى وتلعب أدواراً مختلفة في عمل الكون) / حقب, دهر (فترة زمنية طويلة لا يمكن قياسها) / دهر (أطول قسم في الزمن الجيولوجي)",
