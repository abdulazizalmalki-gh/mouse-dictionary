 "りさん": "تَشَتُّت",
 "りさんてき": "مُمَيَّز, مُنْفَصِل / مُتَقَطِّع",
 "りざい": "تَمْوِيل, مَالِيَّة / مَوَّل",
 "りざいか": "خبير مالي, ممول (شخص ماهر في المعاملات المالية واسعة النطاق)",
 "りざいがく": "اقتصاد, علم الاقتصاد (فرع العلوم الاجتماعية الذي يتعامل مع إنتاج وتوزيع واستهلاك السلع والخدمات وإدارتها)",
 "りざや": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "りし": "فَائِدَة",
 "りしゅう": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة",
 "りしゅうかもく": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "りしょう": "انكماش الهلام, نضْح (انفصال السائل عن الهلام الناتج عن الانكماش (كما في صناعة الجبن)) / دمج الحركات (انكماش حرفين متحركين في إدغام)",
 "りしょくしゃ": "عاطل عن العمل (شخص بلا وظيفة)",
 "りしりつ": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "りしん": "رُبُوبِيَّة",
 "りしんりつ": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "りしんろん": "رُبُوبِيَّة",
 "りじ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "りじかい": "مَجْلِس إِدَارَة",
 "りじちょう": "مدير (شخص يتحكم في الموارد والنفقات)",
 "りじゅん": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "りじん": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته. / قَرَوِيّ, قَرَوِيَّة",
 "りじんしょう": "تجريد من الشخصية, تشييء (تمثيل إنسان كشيء مادي مجرد من الصفات الشخصية أو الفردية) / اختلال الإنية, تبدد الشخصية ((في الوجودية) فقدان الهوية الشخصية؛ شعور الفرد بأنه ترس مجهول في آلة اجتماعية غير شخصية) / اضطراب تبدد الشخصية, تبدد الشخصية (اضطراب انشقاقي عاطفي يحدث فيه فقدان للاتصال بالواقع الشخصي للفرد مصحوباً بمشاعر اللاواقعية والغرابة)\nمثال: وفقًا لماركس، فإن معاملة العمل كسلعة تجسد تشييء الفرد",
 "りす": "سِنْجَاب",
 "りすい": "سَقْي",
 "りすう": "مَسَافَة بِالمِيل (المسافة المقاسة بالأميال) / بدل الأميال, تعويض المسافة (بدل سفر بمعدل معين لكل ميل مقطوع) / اِسْتِهْلَاك الوَقُود (نسبة عدد الأميال المقطوعة إلى عدد جالونات البنزين المحروقة)",
 "りすざる": "سعدان السنجاب (قرد صغير طويل الذيل يعيش في أمريكا الوسطى والجنوبية، ذو فراء مخضر وخطم أسود)",
 "りすもどき": "زبابيات الشجر (ثديي شجري آكل للحشرات من جنوب شرق آسيا يشبه السنجاب وله عيون كبيرة وخطم حاد طويل)",
 "りする": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / فَائِدَة, جَدْوَى / اِسْتَغَلَّ",
 "りせい": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
