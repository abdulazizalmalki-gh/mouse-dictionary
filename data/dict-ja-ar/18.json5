 "ア式蹴球": "كرة القدم (لعبة كرة قدم يحاول فيها فريقان من 11 لاعباً ركل الكرة أو ضربها بالرأس إلى مرمى الخصم)",
 "イ": "أول, أولي (الذي يسبق كل الآخرين في الزمان أو المكان أو الدرجة)\nمثال: المنزل الأول على اليمين / ا (الْأَلِفُ بِدُونِ هَمْزَةٍ ؛ تُسْتَخْدَمُ فِي آخِرِ أَوْ وَسَطِ الكلام لمد الصوت بحركة الفتحة؛ تبتدئ بها بعض الأسماء في اللغة العربية وهي) / إِي, آ (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى في إجابة النداء وليس بحاجة إلى قَسَم) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري. / إِنْدُونِيسِيَا / أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "イぐさ": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "イたんちょう": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "イちょうちょう": "رَائِد",
 "イア": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "イアフォン": "سَمَّاعَات",
 "イアブック": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "イアホン": "سَمَّاعَات",
 "イアリング": "قُرْط, حَلَق",
 "イアンボス": "تفعيلة إيامبية, تفعيلة قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-مشددة)",
 "イアース": "حمض إندول الأسيتيك (هرمون نباتي يعزز استطالة السيقان والجذور)",
 "イイスス": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا.",
 "イェイ": "لغة بويي (فرع من لغات تاي، يُتحدث به في جنوب وجنوب غرب مقاطعة قويتشو ومقاطعة يونان في الصين)",
 "イェス": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "イェッサー": "نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "イェティ": "يَتِي",
 "イェティー": "يَتِي",
 "イェニチェリ": "إِنْكِشَارِيّ",
 "イェロー": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر. / بِطَاقَة صَفْرَاء / آسِيَوِيّ / آسِيَوِيَّة",
 "イエイヌ": "كلب, كلب أليف (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: نبح الكلب طوال الليل (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)",
 "イエス": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "イエスキリスト": "يَسُوع الْمَسِيح, عِيسَى الْمَسِيح ((في المسيحية) الْمَسِيح يَسُوع النَّاصِرِيّ، وهو الشخصية المركزية في المسيحية، حيث يؤمنون بأنه ابن الله…)\nمثال: كان يسوع يهوديا.",
 "イエスズメ": "عُصْفُور, دُورِيّ",
 "イエスタデイ": "أَمْس / أَمْسِ",
 "イエスタデー": "أَمْس / أَمْسِ",
 "イエスマン": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "イエス・キリスト": "يَسُوع الْمَسِيح, عِيسَى الْمَسِيح ((في المسيحية) الْمَسِيح يَسُوع النَّاصِرِيّ، وهو الشخصية المركزية في المسيحية، حيث يؤمنون بأنه ابن الله…)\nمثال: كان يسوع يهوديا.",
 "イエズス": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا.",
 "イエズスかい": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
