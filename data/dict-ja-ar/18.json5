 "イオタ": "إِيُوتَا",
 "イオニアしき": "نظام إيوني (ثاني نظام يوناني؛ التاج مزخرف بلفائف لولبية)",
 "イオニア式": "نظام إيوني (ثاني نظام يوناني؛ التاج مزخرف بلفائف لولبية)",
 "イオン": "شَارِد, أَيُون / أيون, دهر ((الغنوصية) قوة إلهية أو طبيعة تنبثق من الكائن الأسمى وتلعب أدواراً مختلفة في عمل الكون) / حقب, دهر (فترة زمنية طويلة لا يمكن قياسها) / دهر (أطول قسم في الزمن الجيولوجي)\nمثال: أوه، لقد حدث ذلك منذ دهر",
 "イオンか": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن طريق إضافة أو طرح الإلكترونات من الذرات بواسطة مجالات كهربائية قوية في غاز) / تأين (حالة التفكك إلى أيونات (كما يحدث بالحرارة أو الإشعاع أو التفاعل الكيميائي أو التفريغ الكهربائي))\nمثال: تأين الغاز",
 "イオンけつごう": "رابطة أيونية, رابطة شاردية (رابطة كيميائية تفقد فيها ذرة إلكتروناً لتشكل أيوناً موجباً وتكتسب الذرة الأخرى إلكتروناً لتشكل أيوناً سالباً)",
 "イオンこうかん": "تبادل أيوني (عملية يتم فيها تبادل الأيونات بين محلول ومادة صلبة غير قابلة للذوبان (عادة ما تكون راتنجية)؛ تستخدم على نطاق واسع في المعالجة الصناعية)",
 "イオンせい": "أيوني, شردي (يحتوي على أو يتضمن أو يحدث في شكل أيونات (شوارد)) / إيوني (مكون من أو متعلق بإيونيا أو سكانها أو لغتها) / إيوني (مكون من أو متعلق بالطراز الإيوني للعمارة اليونانية الكلاسيكية) / الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)\nمثال: شحنة أيونية",
 "イオンどうにゅう": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "イオンエンジン": "محرك أيوني (نوع من محركات الدفع التفاعلي لدفع الصواريخ في الفضاء؛ يتم تسريع تيار من الأيونات الموجبة إلى سرعة عالية بواسطة مجال كهربائي)",
 "イオントフォレシス": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "イオンビーム": "حزمة أيونية (حزمة من الأيونات تتحرك في نفس الاتجاه وبنفس السرعة)",
 "イオンポンプ": "مضخة أيونية (مضخة تفريغ تزيل الغاز عن طريق تأيين الذرات أو الجزيئات وامتصاصها على سطح معدني)",
 "イオン・エンジン": "محرك أيوني (نوع من محركات الدفع التفاعلي لدفع الصواريخ في الفضاء؛ يتم تسريع تيار من الأيونات الموجبة إلى سرعة عالية بواسطة مجال كهربائي)",
 "イオン・ビーム": "حزمة أيونية (حزمة من الأيونات تتحرك في نفس الاتجاه وبنفس السرعة)",
 "イオン・ポンプ": "مضخة أيونية (مضخة تفريغ تزيل الغاز عن طريق تأيين الذرات أو الجزيئات وامتصاصها على سطح معدني)",
 "イオン交換": "تبادل أيوني (عملية يتم فيها تبادل الأيونات بين محلول ومادة صلبة غير قابلة للذوبان (عادة ما تكون راتنجية)؛ تستخدم على نطاق واسع في المعالجة الصناعية)",
 "イオン化": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن طريق إضافة أو طرح الإلكترونات من الذرات بواسطة مجالات كهربائية قوية في غاز) / تأين (حالة التفكك إلى أيونات (كما يحدث بالحرارة أو الإشعاع أو التفاعل الكيميائي أو التفريغ الكهربائي))\nمثال: تأين الغاز",
 "イオン導入": "رحلان أيوني, علاج أيوني (علاج يستخدم تياراً كهربائياً موضعياً لإدخال أيونات الدواء إلى الأنسجة)",
 "イオン性": "أيوني, شردي (يحتوي على أو يتضمن أو يحدث في شكل أيونات (شوارد)) / إيوني (مكون من أو متعلق بإيونيا أو سكانها أو لغتها) / إيوني (مكون من أو متعلق بالطراز الإيوني للعمارة اليونانية الكلاسيكية) / الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)\nمثال: شحنة أيونية",
 "イオン結合": "رابطة أيونية, رابطة شاردية (رابطة كيميائية تفقد فيها ذرة إلكتروناً لتشكل أيوناً موجباً وتكتسب الذرة الأخرى إلكتروناً لتشكل أيوناً سالباً)",
 "イカ": "حَبَّار",
 "イカれぽんち": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً) / أبله, طائش (شخص بسيط طائش ومشتت الذهن)\nمثال: إنها بلهاء تماماً",
 "イカれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "イカれポンチ": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً) / أبله, طائش (شخص بسيط طائش ومشتت الذهن)\nمثال: إنها بلهاء تماماً",
 "イカサマ": "غِشّ, اِحْتِيال",
 "イカダ": "طَوْف / رَمَث (رَمَّثَ على كذا: زاد؛ يقال: رَمَّثَ على الخمسين، ورَمَّثَتْ غَنَمُهُ على المئةِ) / قَارِب مَطَّاطِيّ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "イカフライ": "حبار, كاليماري ((في المطبخ الإيطالي) حبار مجهز كطعام)",
 "イカリング": "حبار, كاليماري ((في المطبخ الإيطالي) حبار مجهز كطعام)",
 "イカレぽんち": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً) / أبله, طائش (شخص بسيط طائش ومشتت الذهن)\nمثال: إنها بلهاء تماماً",
 "イカレる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "イカレポンチ": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً) / أبله, طائش (شخص بسيط طائش ومشتت الذهن)\nمثال: إنها بلهاء تماماً",
 "イガイガ": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك) / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "イキ": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً / بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية! / نَشْوَة, هِزَّة اَلْجِمَاع",
 "イキがいい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "イキのいい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "イキのよい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "イキむ": "سُلَالَة",
 "イキイキ": "بِشَكْل حَيّ, بِوُضُوح (بطريقة حية)\nمثال: وصف مغامراته بشكل حي",
 "イギリス": "الْمَمْلَكَةُ الْمُتَّحِدَة / إِنْجِلْتِرَا (منطقة في بِرِيطَانِيَا الْعُظْمَى، تقع بشرق وِيلْز، وجنوب إِسْكُتْلَنْدَا؛ عاصمتها لُنْدُن؛ وهي إحدى الدول المكونة للمملكة المتحدة) / إِنْقِلْتِرَا / إِنْكِلْتِرَا / إِنْكِلْتِرَة\nمثال: أنا من إنجلترا.",
 "イギリスえいご": "اَلْإِنْجِلِيزِيَّة اَلْبِرِيطَانِيَّة",
 "イギリスかいきょう": "بَحْر الْمَانْش, الْمَانْش (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "イギリスけいけんろん": "تجريبية بريطانية (التقليد الفلسفي السائد في بريطانيا العظمى منذ القرن السابع عشر)",
 "イギリスご": "إِنْجِلِيزِيّ إِنْكِلِيزِيّ, إنْقِليزي (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ) / إِنْجِلِيزِيّ, إِنْجِلِيزِيَّة (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ)\nمثال: ما أكتبه ليس إنجليزية.",
 "イギリスしょとう": "اَلْجُزُر اَلْبِرِيطَانِيَّة",
 "イギリスじん": "بَرِيطَانِيّ, بَرِيطَانِيَّة (مِنْ، أو متعلق بالمملكة المتحدة أو بريطانيا بمعانيها الأخرى)\nمثال: توم مواطن بريطاني. / إنجليزي (مواطن أو ساكن في إنجلترا)",
 "イギリスていこく": "الإِمْبَرَاطُورِيّة الْبَرِيطَانِيَّة",
