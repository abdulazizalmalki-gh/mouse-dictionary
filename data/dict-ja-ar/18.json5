 "アンソフィライト": "أنثوفيليت (معدن بني غامق من مجموعة الأمفيبول؛ سيليكات المغنيسيوم والحديد)",
 "アンソロ": "تَجْمِيعَة, دِيوَان",
 "アンソロジー": "تَجْمِيعَة, دِيوَان",
 "アンソロピック": "إنساني, بشري (يتعلق بالبشرية أو فترة وجود الجنس البشري)",
 "アンタゴニスト": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "アンタゴニズム": "تضاد حيوي ((كيمياء حيوية) تداخل في أو تثبيط العمل الفسيولوجي لمادة كيميائية بواسطة أخرى لها بنية مماثلة) / تضاد, عداء (شعور معبر عنه بوضوح بالكراهية والعداء) / تَضَادّ, تَنَافُر (العلاقة بين مبادئ أو قوى أو عوامل متعارضة) / بغضاء, خصومة (حالة من الضغينة العميقة)\nمثال: التنافر المتأصل بين الرأسمالية والاشتراكية",
 "アンタッチャブル": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "アンタナナリボ": "أَنْتَانَانَارِيفُو",
 "アンタハン": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "アンタレス": "قَلْب الْعَقْرَب",
 "アンタント": "اتفاق ودي, وفاق (تفاهم ودي بين القوى السياسية) / الاتفاق الودي, الوفاق (تحالف غير رسمي بين الدول)",
 "アンダ": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "アンダカット": "قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "アンダスタンド": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "アンダラ": "مُغَفَّل, أَحْمَق",
 "アンダンテ": "بِنَغَم مُتَوَسِّط البُطْء (بإيقاع بطيء باعتدال) / أَنْدَانْتِي ((في الإيقاع الموسيقيّ) بَطِيء بِشَكْلٍ مُعْتَدِل) / أندانتي (تأليف موسيقي أو مقطع يُؤدى ببطء معتدل) / أندانتي (وتيرة بطيئة باعتدال (سرعة المشي))\nمثال: يجب عزف هذا المقطع بنغم متوسط البطء",
 "アンダンティーノ": "أَنْدَانْتِينُو ((في الإيقاع الموسيقيّ) سَرِيع بِشَكْلٍ مُعْتَدِل)",
 "アンダー": "تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة. / ضعف الدعاية, قلة التعرض (دعاية أو تعرض غير كافٍ) / تعريض ناقص (فعل تعريض الفيلم لضوء قليل جدًا أو لفترة قصيرة جدًا)",
 "アンダーウェア": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "アンダーウエア": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "アンダーカット": "قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "アンダーカバー": "خَفِيّ, سِرِّيّ (يُجْرَى بِأَهْدَافٍ أَوْ أَسَالِيبَ خَفِيَّة)",
 "アンダーグラウンド": "تحت الأرض, جوفياً (تحت سطح الأرض) / سرياً, في الخفاء (في أو إلى مخبأ أو عملية سرية) / خَفِيّ, سِرِّيّ (يُجْرَى بِأَهْدَافٍ أَوْ أَسَالِيبَ خَفِيَّة) / تَحْتَ أَرْضِيّ, جَوْفِيّ (تحت مستوى سطح الأرض)\nمثال: المياه تتدفق جوفياً",
 "アンダーグランド": "تحت الأرض, جوفياً (تحت سطح الأرض) / سرياً, في الخفاء (في أو إلى مخبأ أو عملية سرية) / خَفِيّ, سِرِّيّ (يُجْرَى بِأَهْدَافٍ أَوْ أَسَالِيبَ خَفِيَّة) / تَحْتَ أَرْضِيّ, جَوْفِيّ (تحت مستوى سطح الأرض)\nمثال: المياه تتدفق جوفياً",
 "アンダーコート": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "アンダーザテーブル": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "アンダーシャツ": "فانيلا, قميص داخلي رجالي (رداء داخلي رجالي بلا ياقة للجزء العلوي من الجسم)",
 "アンダーシャート": "فانيلا, قميص داخلي رجالي (رداء داخلي رجالي بلا ياقة للجزء العلوي من الجسم)",
 "アンダースカート": "تنورة داخلية (رداء داخلي يلبس تحت التنورة)",
 "アンダースコア": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))",
 "アンダースタンド": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "アンダーステア": "انعطاف قاصر, قصور التوجيه (عندما تنعطف السيارة بمقدار أقل مما أمر به السائق)",
 "アンダースロー": "رمية سفلية (رمية تلقى من الجانب بدلاً من فوق الرأس)",
 "アンダートーン": "لون خفي, مسحة (لون شاحب أو هادئ) / معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني) / صوت خفيض, همس (نبرة صوت هادئة أو مكتومة)",
 "アンダードッグ": "مُسْتَضْعَف, غَيْر مُرَشَّح",
 "アンダーハンド": "من تحت الذراع (مع أرجحة اليد تحت مستوى الكتف) / بدسيسة, بمكر (بمكر وسرية) / مُتَسَلِّل, مُحْتَال (يتسم بالخداع والمراوغة) / من أسفل الذراع (مع تقديم اليد ورفعها من تحت مستوى الكتف)\nمثال: رمي الكرة من تحت الذراع",
 "アンダーバー": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))",
 "アンダーパス": "نَفَق مُشَاة",
 "アンダーヘア": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "アンダーメッセージ": "دَلَالَة (ما يستلزم العلم به العلم بشيء آخر)\nمثال: القدس مدينة ذات دلالة رمزية بالنسبة لكل من المسلمين و المسيحيين و اليهود.",
 "アンダーライター": "شركة تأمين, مؤمّن (مؤسسة مالية تبيع بوليصات التأمين) / مكتتب تأمين, وسيط تأمين (وكيل يقوم ببيع وثائق التأمين) / متعهد اكتتاب, مصرفي استثماري (مصرفي يتعامل بشكل رئيسي في ضمان تغطية الأوراق المالية الجديدة)",
 "アンダーライン": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))",
