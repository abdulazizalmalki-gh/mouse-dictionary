 "人達": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "人里": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "人里はなれた": "وَحِيد, مُوحِش",
 "人里離れた": "وَحِيد, مُوحِش",
 "人間": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "人間のくず": "خَشَاش, هَامَّة",
 "人間のクズ": "خَشَاش, هَامَّة",
 "人間の堕落": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "人間の屑": "خَشَاش, هَامَّة",
 "人間の盾": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "人間らしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "人間力": "ثِقَة",
 "人間化": "أَنْسَنَة",
 "人間同士": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "人間嫌い": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "人間性": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "人間愛": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "人間拡張": "ههه",
 "人間疎外": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "人間的": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
