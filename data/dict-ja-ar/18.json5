 "二つながら": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二つ乍ら": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二つ共": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二つ割り": "نِصْف, نُصْف",
 "二つ名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "二つ折": "ثُنَائِيّ / ضِعْف",
 "二つ折り": "ثُنَائِيّ / ضِعْف",
 "二つ目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二つ結び": "حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة.",
 "二の次": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二の腕": "عَضُد (مُعِين؛ قُوَّة)",
 "二の足を踏む": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "二カ国語": "ثُنَائِي اَللُّغَة",
 "二ヵ国語": "ثُنَائِي اَللُّغَة",
 "二ヶ国語": "ثُنَائِي اَللُّغَة",
 "二世": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "二乗": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "二乗冪": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "二乗根": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "二九": "ثَمَانِيَةَ عَشَرَ",
 "二人": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "二人して": "مَعًا, سَوِيًّا",
 "二人とも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二人共": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二人目": "مُخَاطَب",
 "二人称": "مُخَاطَب",
 "二人組": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "二人部屋": "غُرْفَة مُزْدَوِجَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "二代目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二伸": "مُلَاحَظَة",
 "二佐": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "二俣": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "二倍": "ثُنَائِيّ / ضِعْف\nمثال: 社長は私の歳の２倍です。 — رئيسي في العمل يكبرني عمراً بمرتين.",
 "二元性": "ثَنَوِيَّة",
 "二元的": "مُثَنًّى / مُثَنَّى",
 "二元論": "ثَنَوِيَّة",
 "二八": "سِتَّةَ عَشَرَ",
 "二六時中": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "二分": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "二分の一": "نِصْف, نُصْف",
 "二分探索": "بَحْث ثُنَائِيّ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "二分木": "شَجَرَة ثُنَائِيَّة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "二分音符": "بَيْضَاء (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "二十": "عِشْرُونَ",
 "二十代": "عِشْرُونَ",
 "二十四時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "二十日大根": "فُجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "二卵性": "أَخَوِيّ",
 "二又": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "二号": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "二号さん": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "二名法": "تَسْمِيَة ثُنَائِيَّة",
 "二周目": "تَنَاسُخُ الأَرْوَاحِ",
 "二命名法": "تَسْمِيَة ثُنَائِيَّة",
 "二回": "مَرَّتَيْن, مرتين",
 "二国間": "ثُنَائِيّ",
 "二塁打": "ثُنَائِيّ / ضِعْف",
 "二士": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "二子": "تَوْأَم",
 "二字": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "二尉": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "二度": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "二度三度": "مِرَارًا وَتِكْرَارًا",
 "二度音程": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二形": "خُنْثَى / خُنْثَوِيّ",
 "二律背反": "التضاد",
 "二日酔い": "خُمَار (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / خُمَار اَلسُّكْر (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / صُدَاع الخَمْر\nمثال: اعتنقت ليلى الإسلام و بدأت ترتدي الخمار.",
 "二時": "اَلسَّاعَة اَلثَّانِيَة",
 "二月": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "二本": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "二本建て": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "二本棒": "مُغَفَّل, سَاذَج",
 "二極真空管": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "二次": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة. / خَيَالِيّ, مُتَخَيَّل",
 "二次元": "خَيَالِيّ, مُتَخَيَّل",
 "二次性": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二次的": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二段": "ثُنَائِيّ / ضِعْف",
 "二段ベッド": "سَرِير بِطَابَقَيْن (قطعة أثاث للنوم والاستلقاء والجلوس؛ مسطبة من الخشب المزيَّن يوضع عليه كرسي، يغلب على ما تحت عرش الملك)\nمثال: قاس طول السرير.",
