 "れいきゅう": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "れいきゅうしゃ": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "れいきゅうじどうしゃ": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "れいきょり": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "れいきょりしゃげき": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "れいきん": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "れいぎ": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "れいぎさほう": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "れいぎしらず": "فَظّ",
 "れいぎただしい": "مُهَذَّب, مُؤَدَّب",
 "れいぎただしさ": "أَدَب (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "れいくうかん": "فضاء صفري, فضاء فارغ (فضاء لا يحتوي على نقاط؛ وفضاء فارغ)",
 "れいぐう": "جَفَاء, سُوء الِاسْتِقْبَال (ترحيب غير لطيف وغير مراعٍ)\nمثال: لقد فوجئ بمثل هذا الجفاء",
 "れいけい": "سَيِّدَة, مَدَام",
 "れいけつ": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين) / بِدَم بَارِد",
 "れいけつかん": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "れいけつどうぶつ": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "れいけん": "مُعْجِزَة, أُعْجُوبَة",
 "れいけんあらたか": "خَارِق, مُعْجِز (الشيء)\nمثال: ذلك خارق للعادة.",
 "れいげん": "مُقَدِّمَة / بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط) / صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل) / مُعْجِزَة, أُعْجُوبَة / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "れいげんあらたか": "خَارِق, مُعْجِز (الشيء)\nمثال: ذلك خارق للعادة.",
 "れいこ": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "れいこう": "ضِيَائِيَّة, تَأَلُّق",
 "れいこく": "قَسْوَة, وَحْشِيَّة",
 "れいこくむざん": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "れいこくむじょう": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "れいこん": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "れいこんしょうめつ": "إِفْنَاء, تَدْمِير / إِفْنَاء",
 "れいごう": "مرعبه, مخيف",
 "れいさい": "تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "れいさいのう": "زراعة الكفاف (الزراعة التي توفر الاحتياجات الأساسية للمزارع دون فوائض للتسويق)",
 "れいし": "ليتشي (فاكهة صينية ذات قشرة هشة رقيقة تحيط بلب هلامي حلو وبذرة واحدة) / شجرة الليتشي, ليتشي (شجرة صينية تزرع خاصة في الفلبين والهند لفاكهتها الصالحة للأكل) / قَاوُون / فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية) / إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "れいしき": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "れいしつ": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "れいしゅうごう": "مجموعة خالية, مجموعة فارغة (مجموعة فارغة؛ مجموعة ليس لها أعضاء)",
 "れいしょ": "أَمْر, مُذَكِّرَة (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "れいしょう": "تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة) / إطار بارد, دفيئة باردة (غطاء واقٍ يتكون من إطار خشبي ذي سطح زجاجي تُحمى فيه النباتات الصغيرة من البرد)",
 "れいしょうてき": "ساخر",
 "れいしょく": "أغذية مجمدة, طعام مجمد (طعام محفوظ بالتجميد)",
 "れいしん": "إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "れいじ": "تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "れいじゅう": "عُبُودِيَّة, رِقّ",
 "れいじょう": "اِبْنَة, بِنْت / أَمْر, مُذَكِّرَة (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك / ألفة, مجاملة (حالة أو جو من الانسجام أو الكياسة والاحترام المتبادل) / قِمَّة / إِجْتِمَاع قِمَّة",
 "れいじん": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية) / مؤدي عروض المنستريل, منشد متجول (مؤدٍ في عروض المنستريل (عروض موسيقية وكوميدية قديمة)) / جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "れいすい": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "れいすいかい": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "れいすいき": "بَرَّاد",
 "れいすいとう": "برج تبريد (نظام تبريد يستخدم في الصناعة لتبريد الماء الساخن (عن طريق التبخر الجزئي) قبل إعادة استخدامه كمبرد)",
 "れいする": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "れいせい": "هُدُوء / اِجْتِهَاد / رُوحَانِيَّة, رَوْحَانِيَّة",
 "れいせつ": "حشمة, ذوق (اللياقة في الأخلاق والسلوك) / رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم) / عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / رسم توضيحي (عمل فني يساعد على جعل شيء ما واضحاً أو جذاباً)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "れいせん": "الْحَرْب الْبَارِدَة / حَرْب بَارِدَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "れいせんがたしこう": "الْحَرْب الْبَارِدَة / حَرْب بَارِدَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "れいせんしゅうけつ": "النِهاية",
 "れいせんじだい": "الْحَرْب الْبَارِدَة / حَرْب بَارِدَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "れいぜん": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "れいそく": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "れいぞう": "تخزين بارد, تخزين بالتبريد (تخزين مبرد للحفظ) / تجميد, حفظ بارد (في حالة تعليق أو تأجيل)",
 "れいぞうこ": "ثَلَّاجَة",
 "れいぞうしゃ": "عربة تبريد (عربة شحن مجهزة بنظام تبريد)",
 "れいぞうほう": "تبريد علاجي (خفض درجة حرارة الجسم عمداً لأغراض علاجية) / تبريد, تثليج (عملية تبريد أو تجميد (مثل الطعام) لأغراض الحفظ)\nمثال: التبريد عن طريق غمر جسم المريض في حمام بارد",
 "れいぞく": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / تبعية (جودة الخضوع المطيع) / تَبَعِيَّة (العلاقة النحوية لكلمة أو عبارة معدلة إلى الكلمة الرئيسية التي تعدلها) / انْدِرَاج, تَبَعِيَّة دَلَالِيَّة (العلاقة الدلالية لكون الكلمة فرعية أو تابعة لرتبة أو فئة أدنى (مثل: تفاحة مندرجة تحت فاكهة)) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "れいぞくこく": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "れいぞくてき": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "れいたい": "شَبَح, خَيَال",
 "れいたん": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "れいたんむじょう": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال)",
 "れいだい": "مِثَال, مَثَل / مِثَال",
 "れいだいほうすん": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "れいだんぼう": "تَكْيِيف",
 "れいちょう": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة) / تَاج, إِكْلِيل",
 "れいちょうもく": "رَئِيسِيَّات",
 "れいちょうるい": "رَئِيسِيَّات",
 "れいちょうるいがく": "علم الرئيسيات (فرع علم الحيوان الذي يدرس الرئيسيات)",
 "れいてき": "رُوحَانِيّ, رُوحِيّ",
 "れいてつ": "رَشِيد, سَدِيدُ الرَّأْي (يمارس الحكم السليم أو يُظهِره)",
 "れいてん": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب) / ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "れいでん": "ضَرِيح",
 "れいとう": "تجمد, تجميد (سحب الحرارة لتحويل شيء من سائل إلى صلب)",
 "れいとうき": "ثَلَّاجَة",
 "れいとうこ": "فريزر, مجمد (ثلاجة كهربائية يُجمد فيها الطعام ويُحفظ لفترات طويلة)",
 "れいとうざい": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد) / مادة تبريد, وسيط تبريد (أي مادة تستخدم للتبريد (كما في الثلاجة))",
 "れいとうしつ": "فريزر, مجمد (ثلاجة كهربائية يُجمد فيها الطعام ويُحفظ لفترات طويلة)",
 "れいとうしゃ": "عربة تبريد (عربة شحن مجهزة بنظام تبريد)",
 "れいとうしょくひん": "أغذية مجمدة, طعام مجمد (طعام محفوظ بالتجميد)",
 "れいとうそうち": "ثَلَّاجَة",
 "れいとうほぞん": "تخزين بارد, تخزين بالتبريد (تخزين مبرد للحفظ) / تجميد, حفظ بارد (في حالة تعليق أو تأجيل)",
 "れいど": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب) / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر.",
 "れいどう": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "れいにく": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "れいになく": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "れいにはおよばない": "عَفْوًا",
 "れいによって": "كَالْعَادَة, كَالْمُعْتَاد",
 "れいねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "れいねんになく": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "れいの": "عَادِيّ / السَّابِقُ ذِكْرُهُ\nمثال: もう例の手紙の返事を書いたかい。 — هل رددت على تلك الرسالة بعد؟",
 "れいのうしゃ": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها) / نفساني, وسيط روحي (شخص يبدو حساساً لأشياء تتجاوز النطاق الطبيعي للإدراك)",
 "れいのうりょくしゃ": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها) / نفساني, وسيط روحي (شخص يبدو حساساً لأشياء تتجاوز النطاق الطبيعي للإدراك)",
 "れいのけん": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم.",
 "れいのごとく": "كَالْعَادَة, كَالْمُعْتَاد",
 "れいはい": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "れいはいしき": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "れいはいしょ": "مَعْبَد",
 "れいはいどう": "مُصَلًّى, كَنِيسَة (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد)",
 "れいば": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة)",
 "れいばい": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد) / مادة تبريد, وسيط تبريد (أي مادة تستخدم للتبريد (كما في الثلاجة))",
 "れいばいし": "روحاني (متعلق بالروحانية أو متصل بها) / وسيط روحي (شخص يعمل كوسيط بين الأحياء والأموات)\nمثال: استشار العديد من الوسطاء",
 "れいばんめ": "صِفْرِيّ",
 "れいひょう": "النقد الساخر, سُخْرِيَّة",
 "れいびょう": "ضَرِيح, مَرْقَد / زباد (ثديي يشبه القط يفرز عادة المسك المستخدم في العطور) / بساريسك, قط حلقي الذيل (ثديي قارت شبيه بالراكون من المكسيك وجنوب غرب الولايات المتحدة له ذيل كثيف طويل بحلقات سوداء وبيضاء)",
 "れいふ": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "れいふうせん": "مبرد تبخيري, مكيف صحراوي (نظام تبريد يبرد عن طريق التبخر)",
 "れいふく": "فستان منزلي صباحي (فستان نسائي غير رسمي للأعمال المنزلية) / زي صباحي رسمي (زي رسمي للرجال خلال النهار)",
 "れいふじん": "سَيِّدَة, مَدَام",
 "れいぶん": "شُهْرَة",
 "れいほう": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول. / تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "れいほん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "れいぼう": "تَكْيِيف",
 "れいぼうかんび": "مُكَيَّف (مُبرَّد بجهاز تكييف الهواء)",
 "れいぼうき": "مُكَيِّف هَوَاء",
 "れいぼうしゃ": "مُكَيَّف (مُبرَّد بجهاز تكييف الهواء)",
 "れいみょう": "خَارِق, مُعْجِز (الشيء)\nمثال: ذلك خارق للعادة.",
 "れいみん": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "れいむ": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "れいめい": "شُهْرَة / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / اسم المعمودية (الاسم الأول الذي يُعطى للمسيحيين عند الولادة أو التعميد)",
 "れいめいき": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "れいもつ": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "れいよう": "ظَبْي (الغَزَال ذو القُرُون الحادة، سمي ظبيا لأن قِرْنه يَظْبِي أي يجرح)\nمثال: أبو ظبي هي عاصمة الإمارات العربية المتحدة.",
 "れいらく": "دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / انهيار, سقوط (تراجع مفاجئ في القوة أو العدد أو الأهمية) / سقوط, هطول (سقوط أي شكل من أشكال الماء على الأرض (مطر أو ثلج أو برد أو صقيع أو رذاذ))\nمثال: سقوط آل هابسبورغ",
 "れいり": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "れいりこうかつ": "مَاكِر",
 "れいりょう": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "れいれい": "ذُو طَنِين, مُتَرَنِّم (يشبه صوت الرنين القصير العالي لجرس صغير) / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / غير مبالٍ, غير مكترث (يفتقر إلى الاهتمام أو الرعاية أو الشعور) / غَيْرُ مُنْشَغِل, غَيْرُ مُهْتَمّ (لَيْسَ مُنْشَغِلًا أَوْ مُنْخَرِطًا فِي أَمْرٍ مَا) / غَيْرُ مُبَالٍ, غَيْرُ مُكْتَرِث (مرتاح النفس؛ غير قلق) / استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "れいれいしい": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "れいろう": "شَفَّاف / وَاضِح",
 "れいわ": "رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم) / عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / رسم توضيحي (عمل فني يساعد على جعل شيء ما واضحاً أو جذاباً)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "れいわゲーム": "لعبة صفرية, لعبة محصلتها صفر (لعبة يكون فيها مجموع كل المكاسب والخسائر صفراً)",
 "れいをいう": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "れいコー": "قَهْوَة مُثْلِجَة (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "れき": "تَقْوِيم / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "れきげつ": "شهر, شهر تقويمي (أحد الأقسام الاثني عشر للسنة التقويمية)\nمثال: دفع الفاتورة الشهر الماضي",
 "れきし": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "れきしいぜん": "مَا قَبْلَ التَّارِيخ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "れきしか": "مُؤَرِّخ, مُؤَرِّخَة",
 "れきしがく": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "れきしがくは": "المدرسة التاريخية (مدرسة للاقتصاديين والفلاسفة القانونيين الألمان في القرن التاسع عشر حاولت شرح الأنظمة الاقتصادية الحديثة بمصطلحات تطورية أو تاريخية)",
 "れきしげんごがく": "لُغَوِيَات تَارِيخِيَّة",
 "れきしさいしんろんしゃ": "تحريفي (شيوعي يحاول إعادة كتابة الماركسية لتبرير التراجع عن الموقف الثوري)",
 "れきししゅぎ": "تاريخانية (نظرية تقول بأن الأحداث الاجتماعية والثقافية تحددها التاريخ)",
 "れきししりょう": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "れきしじょう": "تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ) / تَارِيخِيّ (يَنْتَمِي لِلْمَاضِي؛ ذُو أَهَمِّيَّةٍ أَوْ شُهْرَةٍ تَارِيخِيَّة)",
 "れきしちず": "أَطْلَس",
 "れきしてき": "تَارِيخِي / تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ) / تَارِيخِيّ (يَنْتَمِي لِلْمَاضِي؛ ذُو أَهَمِّيَّةٍ أَوْ شُهْرَةٍ تَارِيخِيَّة)",
 "れきしてきげんざい": "المضارع التاريخي (استخدام صيغة المضارع لوصف أحداث أو حالات في الماضي)",
 "れきしのいちページ": "تَارِيخِي",
 "れきしはくりかえす": "التَّارِيخ يُعِيدُ نَفْسِهِ",
 "れきしゅう": "أسبوع (فترة من سبعة أيام متتالية)",
 "れきじつ": "يوم تقويمي, يوم مدني (يوم يحسب من منتصف الليل إلى منتصف الليل)",
 "れきじょ": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "れきすう": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "れきせい": "أَسْفَلْت, زِفْت",
 "れきせいたん": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "れきせいウランこう": "بتشبيند, يورانينيت (معدن يتكون من أكسيد اليورانيوم وآثار من الراديوم والثوريوم والبولونيوم والرصاص والهيليوم؛ يسمى اليورانينيت في شكله الكتلي بتشبيند وهو خام اليورانيوم…)",
 "れきせん": "مُحَارِب قَدِيم",
 "れきぜん": "بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "れきだいし": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "れきでん": "تَقْلِيد",
 "れきとした": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "れきねん": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "れきねんど": "سنة تقويمية, سنة ميلادية (السنة (التي تحسب من 1 يناير إلى 31 ديسمبر) وفقاً للتقويم الغريغوري)",
 "れきねんれい": "عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً",
 "れきほう": "تَقْوِيم",
 "れきほん": "تَقْوِيم",
 "れきゆう": "رِحْلَة / جَوْلَة",
 "れきれき": "مَرْمُوق, بَارِز / شَفَّاف / وَاضِح",
 "れだま": "وَزّال, وَزّال أَسَلِيّ",
 "れっか": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة) / شَيْخُوخَة, هَرَم / حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟ / شَقّ, صَدْع ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "れっかい": "انفلاق, تفتح ((في علم الأحياء) إطلاق المواد عن طريق انشقاق عضو أو نسيج؛ الانفتاح الطبيعي عند النضج لثمرة أو جسم تناسلي آخر لإطلاق البذور أو الأبواغ أو انفتاح جرح…)",
 "れっかのごとく": "احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "れっかウラン": "يُورَانِيُوم مُنْضَب, يُورَانِيُوم مُسْتَنْفَد",
 "れっき": "قَائِمَة, قائمة",
 "れっきと": "بشكل محترم, بوقار (بطريقة لائقة وذات سمعة أخلاقية حسنة) / بشكل جيد, بشكل مقبول (إلى حد يستحق التقدير أو القبول)",
 "れっきとした": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "れっきょ": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / ترقيم, قائمة مرقمة (قائمة مرقمة)\nمثال: استمر العد لعدة ساعات",
 "れっきょう": "قُوَّة عُظْمَى (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "れっこう": "بَاسُور / فُرْجَة",
 "れっこうヘルニア": "فتق الحجاب الحاجز, فتق حجابي (فتق ناتج عن بروز جزء من المعدة عبر الحجاب الحاجز)",
 "れっこく": "دَوْلَة, وَطَن (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "れっし": "وَطَنِيّ, وَطَنِيَّة",
 "れっしゃ": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "れっしゅく": "كَوْكَبَة",
 "れっしょう": "تَهَتُّك",
 "れっする": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "れっせい": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى) / جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى) / مُتَنَحٍّ / إعلان القداسة (فعل قبول شخص متوفى في قائمة القديسين)",
 "れっせいいでんし": "جين متنحي (جين ينتج نمطه الظاهري المميز فقط عندما يكون أليله مطابقاً)\nمثال: الجين المتنحي للعيون الزرقاء",
 "れっせいかん": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "れっせいがく": "علم خلل النسل (دراسة عمل العوامل التي تسبب انحطاطاً في نوع النسل المنتج)",
 "れっせき": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "れっせきしゃ": "حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "れっそう": "تَهَتُّك",
 "れっちゅう": "رِوَاق (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة)\nمثال: ذهب إلى الرواق.",
 "れっとう": "أَرْخَبِيل / جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "れっとうかん": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "れっとうふくごう": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "れっぴん": "مَعْرُوض",
 "れっぷ": "بَطَلَة",
 "れっぷう": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "れっぷく": "تطويب ((الكنيسة الكاثوليكية) فعل للبابا يعلن فيه أن شخصًا متوفى عاش حياة مقدسة ويستحق التبجيل العام؛ خطوة أولى نحو إعلان القداسة) / تطويب (فعل جعل الشخص مباركاً وسعيداً للغاية) / سعادة قصوى, طوبى (حالة من السعادة العارمة)",
 "れつ": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / مُتَتَالِيَة, مُتَوَالِيَة / سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة / دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "れつあく": "فَقِير / مِسْكِين / فُقَرَاء",
 "れつい": "سَيِّئَة",
 "れつご": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / تبعية (جودة الخضوع المطيع) / تَبَعِيَّة (العلاقة النحوية لكلمة أو عبارة معدلة إلى الكلمة الرئيسية التي تعدلها) / انْدِرَاج, تَبَعِيَّة دَلَالِيَّة (العلاقة الدلالية لكون الكلمة فرعية أو تابعة لرتبة أو فئة أدنى (مثل: تفاحة مندرجة تحت فاكهة))",
 "れつざ": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "れつじ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "れつじゃく": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "れつじゃくいしき": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "れつじょ": "بَطَلَة",
 "れつじょう": "شَهْوَة",
 "れつでん": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "れつにくし": "قَاطِع لِلَّحْم ((عَنِ السِّنّ) مُتَكَيِّف لِتَمْزِيق اللَّحْم)",
 "れつれつ": "مُتَّقِد, مُلْتَهِب ((قديم) شديد الحرارة؛ مشتعل أو متوهِّج) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "れろれろ": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "れん": "مَقْطَع, بَيْت / قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة. / تَنَبَّأَ / تَوَقُّع / طَرَف / حَفْلَة, اِحْتِفَال / رَخِيص / صَافٍ, اَلصَّافِي",
 "れんあい": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "れんあいかんけい": "عَلَاقَة غَرَامِيَّة",
 "れんあいしょうせつ": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "れんあいばなし": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "れんあいもの": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "れんおん": "سَنْدْهِي, وَصْل / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / تَكْرِير",
 "れんか": "أغنية حب, أغنية عاطفية (أغنية عن الحب أو تعبر عن الحب لشخص آخر) / مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "れんかばん": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "れんかひん": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "れんかん": "صِلَة, صُلَة / عَلَاقَة, صِلَة / ملعب غولف ساحلي (ملعب غولف مبني على أرض رملية بالقرب من الشاطئ)",
 "れんが": "طُوبَة, لَبِنَة",
 "れんがづくり": "أعمال الطوب, بناء بالطوب (بناء يتم باستخدام الطوب والملاط)",
 "れんき": "إدراج, سرد (فعل عمل قائمة بالعناصر) / قائمة (قاعدة بيانات تحتوي على مصفوفة مرتبة من العناصر (أسماء أو موضوعات))",
 "れんきんじゅつ": "اَلْخِيمِيَاء, خِيمِيَاء / بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال) / صانع ثروة, كاسب المال (شخص ناجح في جمع الثروة)",
 "れんきんじゅつし": "خِيمِيَائِيّ",
 "れんぎん": "با دو دو, رقص ثنائي ((في الباليه) رقصة لشخصين (عادة راقصة باليه وراقص نبيل)) / ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً)\nمثال: الخطيبان / بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "れんく": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "れんけい": "صِلَة, صُلَة / عَلَاقَة, صِلَة / تَعَاوُن / مُكَامَلَة",
 "れんけいプレー": "عَمَل جَمَاعِيّ (عمل تعاوني يقوم به فريق (خاصة عندما يكون فعالاً))\nمثال: سيتطلب الأمر المال والتخطيط الجيد، وقبل كل شيء، العمل الجماعي / تَعَاوُن",
 "れんけつ": "صِلَة, صُلَة / عَلَاقَة, صِلَة / نَزِيه, صَادِق",
 "れんけつき": "رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة",
 "れんけつし": "رَابِطَة, رَابِط",
 "れんけつせい": "اتصال, ترابط (خاصية كون الشيء متصلاً أو الدرجة التي يمتلك بها الشيء اتصالات)",
 "れんけつもう": "ويب",
 "れんけつもうひょうじ": "مَنْظَر, مَشْهَد",
 "れんげざ": "وضع اللوتس, وضعية زهرة اللوتس (وضع جلوس مع تقاطع الساقين؛ يستخدم في اليوغا)",
 "れんげん": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "れんこう": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة / تَحَالُف, اِتِّحَاد",
 "れんこん": "علامة تموج (واحدة من سلسلة من الحواف الصغيرة الناتجة في الرمال بواسطة التيارات المائية أو الرياح)",
 "れんご": "كلمة مركبة, مركب (كلمة تتكون من أي مجموعة متنوعة من الكلمات أو الصيغ التركيبية أو اللواحق) / رَابِطَة, رَابِط",
 "れんごう": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي! / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "れんごうおうこく": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "れんごうかい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "れんごうぐん": "الْحُلَفَاء",
 "れんごうこく": "الْحُلَفَاء",
 "れんごうこくぐんさいこうしれいかんそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうこくさいこうしれいかんそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうこくそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうさくせん": "عملية مشتركة (عملية عسكرية تنفذ بالتعاون بين دولتين حليفتين أو أكثر أو عملية عسكرية تنفذ بتنسيق القوات البحرية والبرية والجوية)",
 "れんごうたい": "اِتِّحَادِيَّة, فِدِرَالِيَّة",
 "れんごうや": "منطقة الترابط (مناطق قشرية ليست حركية ولا حسية ولكن يُعتقد أنها تشارك في المعالجة العليا للمعلومات)",
 "れんごく": "مَطْهَر",
 "れんさ": "سِلْسِلَة / ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية)",
 "れんさい": "نشر متسلسل (النشر في شكل متسلسل)",
 "れんさいしょうせつ": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات) / تَتَابُعِيّ, تَسَلْسُلِيّ (يتعلق بالتنفيذ المتتابع لعمليات متعددة) / تسلسلي (يخص أو يحدث في أو ينتج سلسلة) / تسلسلي (يخص أو مؤلف بتقنية تسلسلية (في الموسيقى))\nمثال: زواج أحادي متسلسل",
 "れんさきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "れんさきゅうきんせいいんとうえん": "التهاب الحلق العقدي (عدوى في البلعوم الفموي واللوزتين بواسطة المكورات العقدية)",
 "れんさく": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "れんさぐん": "جينات مرتبطة, مجموعة ارتباط (أي زوج من الجينات يميل إلى الانتقال معاً)",
 "れんさじょうきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "れんさつ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "れんさてき": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)",
 "れんさてん": "متجر ضمن سلسلة (واحد من سلسلة متاجر بيع بالتجزئة تحت نفس الإدارة وتبيع نفس البضائع)",
 "れんさはんのう": "تَفَاعُل مُتَسَلْسِل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "れんざ": "تَلَازُم",
 "れんざん": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "れんしゅう": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "れんしゅうあいて": "شريك تدريب (ملاكم يتدرب معه ملاكم آخر استعداداً لنزال مهم)",
 "れんしゅうき": "مُدَرِّب, مُدَرِّبَة",
 "れんしゅうきょく": "إيتود, دراسة موسيقية (تأليف قصير لآلة منفردة؛ يهدف كتمرين أو لإظهار البراعة التقنية)",
 "れんしゅうじあい": "مباراة استعراضية, مباراة ودية (مباراة لا يتم تسجيل نتيجتها في الترتيب الرسمي للموسم)",
 "れんしゅうじょ": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "れんしゅうじょう": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "れんしゅうせい": "طَالِب, طَالِبَة",
 "れんしゅうちょう": "دَفْتَر, كُرَّاس",
 "れんしゅうもんだい": "تَمْرِين, تَدْرِيب / تَمَرَّنَ",
 "れんしゅうをつむ": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
