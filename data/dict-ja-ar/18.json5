 "アヴァランシュ": "تَيْهُور, اِنْهِيَار ثَلْجِيّ",
 "アヴァランチ": "تَيْهُور, اِنْهِيَار ثَلْجِيّ",
 "アヴァンギャルド": "جَرِيء, طَلِيعِيّ (جديد أو أصيل بشكل جذري) / الموجة الجديدة, ريادة (أي مجموعة إبداعية نشطة في ابتكار وتطبيق مفاهيم وتقنيات جديدة في مجال معين (خاصة في الفنون))",
 "アヴァンチュール": "عَلَاقَة غَرَامِيَّة",
 "アヴァン・ギャルド": "جَرِيء, طَلِيعِيّ (جديد أو أصيل بشكل جذري) / الموجة الجديدة, ريادة (أي مجموعة إبداعية نشطة في ابتكار وتطبيق مفاهيم وتقنيات جديدة في مجال معين (خاصة في الفنون))",
 "アヴィエーション": "طَيَرَان, مِلَاحَة جَوِّيَّة (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "アヴィーナサティヴァ": "شوفان, شوفان زراعي (يزرع على نطاق واسع في المناطق المعتدلة لحبوبه الصالحة للأكل)",
 "アヴィーナ・サティヴァ": "شوفان, شوفان زراعي (يزرع على نطاق واسع في المناطق المعتدلة لحبوبه الصالحة للأكل)",
 "アヴェック": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع) / زَوْجَانِ / بَعْضُ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "アヴェニュ": "شَارِع",
 "アヴェニュー": "شَارِع",
 "ア・カプリッチオ": "كابريتشيو (مقطوعة آلية لا تلتزم بقواعد أي شكل موسيقي محدد وتُعزف بارتجال)",
 "ア・カペラ": "أَكَابِيلَّا",
 "ア・テンポ": "تمبو, سرعة الإيقاع ((موسيقى) السرعة التي ستُعزف بها المقطوعة) / إِيقَاع, وُتَيْرَة (معدل حدث متكرر)",
 "ア・プリオリ": "مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام) / مُسَبَّق\nمثال: سامي مسلم سابق.",
 "ア・ポステリオリ": "البعديَة",
 "ア・ラ・モード": "آلا مود, مع المثلجات (مع الآيس كريم في الأعلى أو على الجانب)\nمثال: قدمنا فطيرة التفاح مع المثلجات",
 "アー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "アーカイバル": "أرشيفي (من أو متعلق بـ أو موجود في أو يعمل كأرشيف)",
 "アーカイビング": "أَرْشِيف",
 "アーカイブ": "أَرْشِيف",
 "アーカイブス": "أرشيف, سجلات (مجموعة من السجلات خاصة حول مؤسسة ما)",
 "アーカイブズ": "أرشيف, سجلات (مجموعة من السجلات خاصة حول مؤسسة ما)",
 "アーカイヴ": "أَرْشِيف",
 "アーカンソー": "أَرْكَنْسَاس / أركنسا",
 "アーガイル": "جورب آرغيل (جورب محبوك أو منسوج بتصميم المعينات (آرغيل)) / أرجيل, نمط المعينات (تصميم يتكون من نمط من المعينات المتنوعة الألوان على خلفية صلبة (أصلاً للمواد المحبوكة)؛ مصمم على غرار الترتان لإحدى عشائر غرب اسكتلندا) / وعاء مرق حافظ للحرارة (وعاء مرق مغطى يحتوي على وعاء مركزي منفصل للماء الساخن للحفاظ على المرق دافئاً)",
 "アーガット": "إرغوت, دابرة (فطر يصيب نباتات الحبوب المختلفة مكوناً كتلاً سوداء مدمجة من خيوط متفرعة تحل محل العديد من حبوب النبات؛ مصدر لقلويدات مهمة طبياً ولحمض الليسرجيك) / إرغوت (مرض نباتي يسببه فطر الإرغوت)",
 "アーガル": "جورب آرغيل (جورب محبوك أو منسوج بتصميم المعينات (آرغيل)) / أرجيل, نمط المعينات (تصميم يتكون من نمط من المعينات المتنوعة الألوان على خلفية صلبة (أصلاً للمواد المحبوكة)؛ مصمم على غرار الترتان لإحدى عشائر غرب اسكتلندا) / وعاء مرق حافظ للحرارة (وعاء مرق مغطى يحتوي على وعاء مركزي منفصل للماء الساخن للحفاظ على المرق دافئاً)",
 "アーキオロジー": "عِلْمُ الآثَار (أَدْرَكَ حقيقة الشيء) / آثَار (البقايا؛ الأطلال) / عِلْمُ الْآثَارِ الْقَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "アーキタイプ": "أصل, نموذج بدئي (شيء يعمل كنموذج أو أساس لعمل نسخ)\nمثال: هذه اللوحة نسخة من الأصل",
 "アーキテクチャ": "هَنْدَسَة مِعْمَارِيَّة, عِمَارَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "アーキテクチャラル": "مِعْمَارِيّ",
 "アーキテクチャル": "مِعْمَارِيّ",
