 "シニョン": "كَعْكَة الشَّعْر (لفة من الشعر توضع عند مؤخرة العنق)",
 "シニヨン": "كَعْكَة الشَّعْر (لفة من الشعر توضع عند مؤخرة العنق)",
 "シヌソイド": "جيبيات (ممرات دقيقة مبطنة ببطانة غشائية للدم في نسيج عضو ما) / منحنى الجيب",
 "シネシネ": "مَرِن",
 "シネマ": "سِينَمَا (مصطلح يشير إلى التصوير المتحرك الذي يعرض للجمهور و يعتبر التصوير السينمائي من توابعه التمثيل و الإخراج و الإنتاج و كل مايتعلق بذلك و يعتبر من الفنون…؛ فن إنتاج و إخراج الأفلام التي تعرض على الشاشة التلفاز أمام المشاهدين و يطلق عليه الفن السابع أو التصوير السينمائي)\nمثال: كان في السينما.",
 "シネラリア": "سينراريا (عشب من جزر الكناري يُزرع على نطاق واسع لزهوره الزرقاء أو الأرجوانية أو الحمراء أو المتنوعة التي تشبه الأقحوان)",
 "シネラリヤ": "سينراريا (عشب من جزر الكناري يُزرع على نطاق واسع لزهوره الزرقاء أو الأرجوانية أو الحمراء أو المتنوعة التي تشبه الأقحوان)",
 "シノドンティス": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل) / أداة مُصدرة للصرير, لعبة بزمارة (أي أداة أو جسم يُصدر صوت صرير عند استخدامه)\nمثال: تلك الأحذية الرياضية تُصدر صريراً",
 "シノニム": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة.",
 "シノプシス": "مُلَخَّص",
 "シノロジー": "علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "シノワズリー": "زخرفة صينية, شينوازي (نمط فني يعكس التأثير الصيني؛ مزخرف بإتقان وذو أنماط معقدة)",
 "シバ": "شِيڤَا",
 "シバキ合い": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "シバザクラ": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "シバシバ": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "シバナ": "تريغلوشين بحري, عشب السهم (نبات معمر ذو خصلات يوجد في المياه الضحلة أو المستنقعات؛ يسمم الماشية أحياناً)",
 "シバフタケ": "حلقة الجنيات (حلقة من الفطريات تحدد محيط النمو الجوفي المعمر للميسيليوم)",
 "シパシパ": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "シビ": "تُونَة, تُنّ",
 "シビれる": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد) / نَمِلَ\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "シビア": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "シビアー": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "シビック": "مدني (من أو متعلق بـ أو يليق بالمواطنين كأفراد) / بلدي, مديني (من أو متعلق بـ أو ينتمي إلى مدينة)\nمثال: حقوق مدنية",
 "シビックセンター": "مركز مجتمعي, مركز مدني (مركز يمكن لأعضاء المجتمع التجمع فيه لممارسة أنشطة اجتماعية أو ثقافية) / مركز المدينة, وسط البلد (مركز المدينة (وغالباً ما يحتوي على المباني الحكومية والتجارية))",
 "シビック・センター": "مركز مجتمعي, مركز مدني (مركز يمكن لأعضاء المجتمع التجمع فيه لممارسة أنشطة اجتماعية أو ثقافية) / مركز المدينة, وسط البلد (مركز المدينة (وغالباً ما يحتوي على المباني الحكومية والتجارية))",
 "シビヤ": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "シビヤー": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "シビュラ": "عرافة ((في روما القديمة) امرأة كانت تعتبر وسيطاً روحياً أو نبياً) / عرافة (امرأة تقرأ البخت)",
 "シビライゼーション": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل المدن أو القرى؛ حَضَارَة: مصدر؛ مَدَنِية. \"السرعة جزء من الحضارة الحديثة\"، أي جزء من الحياة في المدن في الوقت الحديث) / تَثْقِيف\nمثال: الحضارة الامازيغية عظيمة.",
 "シビリアン": "مَدَنِيّ / مَدَنِيَّة",
 "シビリゼーション": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل المدن أو القرى؛ حَضَارَة: مصدر؛ مَدَنِية. \"السرعة جزء من الحضارة الحديثة\"، أي جزء من الحياة في المدن في الوقت الحديث) / تَثْقِيف\nمثال: الحضارة الامازيغية عظيمة.",
 "シビル": "مَدَنِيّ, أَهْلِيّ / مَدَنِيّ / مَدَنِيَّة",
 "シビルユニオン": "اتحاد مدني (اتحاد طوعي مدى الحياة (أو حتى الطلاق) لأطراف بالغة من نفس الجنس)\nمثال: يتمتع أطراف الاتحاد المدني بجميع المزايا والحماية والمسؤوليات نفسها بموجب قانون فيرمونت مثل الأزواج في الزواج",
 "シビル・ユニオン": "اتحاد مدني (اتحاد طوعي مدى الحياة (أو حتى الطلاق) لأطراف بالغة من نفس الجنس)\nمثال: يتمتع أطراف الاتحاد المدني بجميع المزايا والحماية والمسؤوليات نفسها بموجب قانون فيرمونت مثل الأزواج في الزواج",
 "シビレ": "حلويات اللحم, لحم الغدد (غدد حيوانية صالحة للأكل (مثل البنكرياس والغدة التيموسية))",
 "シビレる": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد) / نَمِلَ\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "シビレウナギ": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "シビレエイ": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "シビレナマズ": "رعاد, سلور كهربائي (سلور مياه عذبة في النيل ووسط أفريقيا الاستوائية يمتلك عضواً كهربائياً)",
 "シフィリス": "زُهَرِيّ, مَرَض فِرَنْجِيّ",
 "シフォン": "شيفون (قماش شفاف من الحرير أو الرايون)",
 "シフォンケーキ": "كعكة شيفون (كعكة خفيفة جداً)",
 "シフォン・ケーキ": "كعكة شيفون (كعكة خفيفة جداً)",
 "シフト": "نَوْبَة / عصا التروس, ناقل الحركة (جهاز ميكانيكي لتعشيق وفصل التروس)",
 "シフトアウト": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "シフトイン": "سِي",
 "シフトキー": "مفتاح العالي, مفتاح شيفت (المفتاح الموجود على لوحة مفاتيح الآلة الكاتبة الذي يحول من الأحرف الصغيرة إلى الأحرف الكبيرة)",
 "シフトダウン": "نقل لسرعة أدنى (التغيير إلى ترس أقل في السيارة أو الدراجة) / تغيير لنمط حياة أبسط (تغيير من مهنة مجزية مالياً ولكنها مرهقة إلى مهنة أقل أجراً ولكنها أكثر إشباعاً)",
 "シフトレジスタ": "سجل الإزاحة ((في علم الحاسوب) سجل يمكن فيه إزاحة جميع البتات موضعاً واحداً أو أكثر إلى اليسار أو اليمين)",
 "シフトレジスター": "سجل الإزاحة ((في علم الحاسوب) سجل يمكن فيه إزاحة جميع البتات موضعاً واحداً أو أكثر إلى اليسار أو اليمين)",
 "シフト・アウト": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "シフト・イン": "سِي",
 "シフト・キー": "مفتاح العالي, مفتاح شيفت (المفتاح الموجود على لوحة مفاتيح الآلة الكاتبة الذي يحول من الأحرف الصغيرة إلى الأحرف الكبيرة)",
 "シフト・ダウン": "نقل لسرعة أدنى (التغيير إلى ترس أقل في السيارة أو الدراجة) / تغيير لنمط حياة أبسط (تغيير من مهنة مجزية مالياً ولكنها مرهقة إلى مهنة أقل أجراً ولكنها أكثر إشباعاً)",
 "シフト・レジスタ": "سجل الإزاحة ((في علم الحاسوب) سجل يمكن فيه إزاحة جميع البتات موضعاً واحداً أو أكثر إلى اليسار أو اليمين)",
 "シフト・レジスター": "سجل الإزاحة ((في علم الحاسوب) سجل يمكن فيه إزاحة جميع البتات موضعاً واحداً أو أكثر إلى اليسار أو اليمين)",
 "シブチン": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "シブレット": "ثُوم مُعَمَّر",
 "シプロヘプタジン": "بيرياكتين, سيبروهيبتادين (مضاد للهيستامين (الاسم التجاري بيرياكتين) يستخدم لعلاج بعض تفاعلات الحساسية)",
 "シベ": "زَبَاد",
 "シベット": "زَبَاد",
 "シベリア": "سِيبِيرِيَا",
 "シベリアンハスキー": "هَسْكِي سِيبِيرِيّ",
 "シベリアン・ハスキー": "هَسْكِي سِيبِيرِيّ",
 "シベリヤ": "سِيبِيرِيَا",
 "シボる": "عصر, لوي (عصر مع التواء)\nمثال: عصر القماش المبلل / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / مَكْتَبَة شَخْصِيَّة / مَأْثُرَة / اِسْتَغَلَّ",
 "シボリ": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما) / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "シボレス": "شعار مميز, شيبوليث (طريقة تحدث مميزة لمجموعة معينة من الناس) / شعار, عبارة مميزة (قول مفضل لمجموعة أو منظمة أو فرد)",
 "シボレテ": "شعار مميز, شيبوليث (طريقة تحدث مميزة لمجموعة معينة من الناس) / شعار, عبارة مميزة (قول مفضل لمجموعة أو منظمة أو فرد)",
 "シマ": "جَزِيرَة / جزيرة",
 "シマアオジ": "درسة صفراء الصدر (شائع في روسيا وسيبيريا)",
 "シマアジ": "شَرْشِير صَيْفِيّ",
 "シマウマ": "حِمَار وَحْشِيّ, حِمَار وَحْشِيّ مُخَطَّط (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "シマエナガ": "قُرْقُف طَوِيل الذِّيل",
 "シマカンギク": "أُقْحُوَان",
 "シマクトゥバ": "لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "シマスカンク": "ظربان مخطط (أكثر أنواع الظربان شيوعاً وانتشاراً في أمريكا الشمالية)",
 "シマハイイロギツネ": "قَصِير الذَّيْل (ذو ذيل قصير)",
 "シマバエ": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "シマリ": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / ثَبَات / حذر, حرص (صفة كون المرء حذراً ومجتهداً) / حذر, حيطة (سمة كون المرء حذراً؛ الانتباه للخطر المحتمل)\nمثال: أعجبت بحرصه في عمله / نَتِيجَة",
 "シマリス": "صيدناني (سنجاب أرضي يحفر الجحور من غرب أمريكا وآسيا؛ له جيوب خدية وشريط فاتح وداكن يمتد أسفل الجسم)",
 "シミ": "بُقْعَة",
 "シミター": "سَيْف (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)",
 "シミュレーション": "مُحَاكَاة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "シミュレータ": "محاكي (آلة تحاكي بيئة لغرض التدريب أو البحث)",
 "シミュレーター": "محاكي (آلة تحاكي بيئة لغرض التدريب أو البحث)",
 "シミュレート": "مُحَاكَاة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "シミリ": "تَشْبِيه",
 "シミー": "شيمي (رقص حيوي (عادة على موسيقى الراغتايم) مع هز الكتفين والوركين كثيراً) / شيميز, قميص نوم قصير (رداء داخلي نسائي بلا أكمام) / ارتجاج, اهتزاز (تذبذب غير طبيعي في مركبة آلية (خاصة في العجلات الأمامية))\nمثال: كان يشعر بالاهتزاز في عجلة القيادة",
 "シミーズ": "فستان فضفاض (فستان فضفاض يتدلى بشكل مستقيم من الكتفين بدون خصر) / شيميز, قميص نوم قصير (رداء داخلي نسائي بلا أكمام)",
 "シムカード": "بِطَاقَة, شَرِيحَة",
 "シムーン": "سَمُوم",
 "シメ": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مَجْمُوع / نَتِيجَة / أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / بلبل زيتوني",
 "シメる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / مَجْمُوع / اِقْتَصَدَ, اِدَّخَرَ",
 "シメジメ": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى / بِتَجَهُّم, بِكَآبَة (مع الكآبة)\nمثال: يتوقع الكثيرون مثل هذا التغيير بكآبة",
 "シメチジン": "تاغاميت, سيميتيدين (دواء (الاسم التجاري تاغاميت) يستخدم لعلاج القرحة الهضمية عن طريق تقليل إفراز حمض المعدة)",
 "シメトリ": "تَنَاظُر",
 "シメトリック": "متماثل, متناظر (له تشابه في الحجم والشكل والموقع النسبي للأجزاء المقابلة)",
 "シメトリー": "تَنَاظُر",
 "シメン": "سيمين (أي من ثلاثة نظائر لهيدروكربون سائل عطري عديم اللون يوجد في الزيت المتطاير للكمون والزعتر ويستخدم في تصنيع الراتنجات الاصطناعية)",
 "シモチャ": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "シモネタ": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "シモン": "سِمْعَان, شَمْعُون",
 "シャアバーン": "شَعْبَان (شَعْبَانُ : الشهر الثامن من شهور السنة الهجرية، بعد رجب وقبل شهر رمضان؛ يُدْخِلُ شعبان في رمضَان: يخلط بين الأمور)",
 "シャアペン": "قَلَم الرَصَاص مِيقَانِيقِيّ (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "シャイ": "خَجُول, خَجِل / خَجُول",
 "シャイア": "حصان شاير, شاير (سلالة بريطانية من خيول الجر الثقيلة الكبيرة) / شاير, مقاطعة ريفية (منطقة إدارية سابقة في إنجلترا؛ تعادل المقاطعة)",
 "シャイアン": "لغة الشايان (لغة ألغونكوية يتحدث بها شعب الشايان) / شايان (فرد من شعب هندي في أمريكا الشمالية يعيش في السهول الغربية (الآن في أوكلاهوما ومونتانا))",
 "シャイアー": "حصان شاير, شاير (سلالة بريطانية من خيول الجر الثقيلة الكبيرة) / شاير, مقاطعة ريفية (منطقة إدارية سابقة في إنجلترا؛ تعادل المقاطعة)",
 "シャイツ": "زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام عشوائية)",
 "シャイニング": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة) / بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً) / لَامِع, مُشْرِق (يتميز بجدارة استثنائية)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "シャイフ": "شَيْخ",
 "シャウト": "صرخة, عويل (صيحة حادة ثاقبة) / صراخ, صرخة (ضجيج عالي النبرة يشبه صرخة الإنسان)\nمثال: جذب صراخها الجيران",
 "シャウワール": "شَوَّال",
 "シャオホンシュー": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "シャオリーベン": "ياباني (مصطلح مسيء) ((عامية مسيئة) مصطلح مسيء لشخص من أصل ياباني)",
 "シャカリキに": "بجنون, بهيجان (بطريقة لا يمكن كبحها)\nمثال: قاومت بجنون",
 "シャガ": "سوسن دموي",
 "シャキシャキ": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "シャキッと": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح / بشكل منعش, بصورة مبهجة (بطريقة جديدة وممتعة تبعث على الانشراح) / بإنعاش, بشكل منعش (بطريقة تزيل التعب وتعيد الحيوية)\nمثال: كانت متحررة من الخجل بشكل منعش / بِصَرَاحَة, بِصِدْق ((تستخدم للتأكيد وتعكس موقف المتحدث) من الصحيح بصدق أن)\nمثال: بصدق، أنا لا أصدق ذلك / بأناقة (بطريقة أنيقة)\nمثال: كانت ترتدي ملابس أنيقة جداً",
 "シャキーン": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "シャギー": "أَشْعَث / شاغ (خطوة رقص حيوية تتكون من القفز على كل قدم بالتناوب) / مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي) / شاج, قماش وبري (قماش ذو وبر خشن طويل) / شَعْر أَشْعَث (تشابك ملبد من الشعر أو الألياف)\nمثال: اشترى سجادة وبرية",
 "シャク": "بقدونس البقر, سرفيل بري (عشب ثنائي الحول خشن قائم من العالم القديم أدخل كعشب ضار في شرق أمريكا الشمالية)",
 "シャクシギ": "كَرَوَان",
 "シャクシナ": "كُرُنْب صِينِيّ, بُوك تْشُوي",
 "シャクシューカ": "شَكْشُوكَة",
 "シャクジョウソウ": "شبيه الغليون الهندي, عصارة الصنوبر",
 "シャクナゲ": "رودودندرون, وردية الشجر (أي شجيرة من جنس رودودندرون: شجيرات دائمة الخضرة أو أشجار شجيرية صغيرة ذات أوراق جلدية وعناقيد مبهرجة من الزهور الجريسية (على شكل جرس))",
 "シャケ": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "シャコ": "روبيان السرعوف (قشريات بحرية استوائية حفارة بزوائد إمساك كبيرة) / دُرَّاج / حَجَل, قبج (طَائِرٌ مِنْ فَصيلَةِ التَّدْرُجِيَّاتِ، مِنْ رُتْبَةِ الدَّجاجِيّاتِ، رَمادِيُّ اللَّوْنِ، أَحْمَرُ المِنْقارِ والسَّاقَيْنِ…؛ حَجَلُ: الذَّكَرُ من القَبَجِ، الواحدةُ: حَجَلَةٌ)\nمثال: إن الإسم \"سكورة\" مشتق من كلمة \"تاسكورت\" الذي يعني حجلة بالأمازيغية. / محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "シャコガイ": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "シャコバサボテン": "صبار عيد الميلاد (صبار نباتي (هوائي) من أصل برازيلي يزرع على نطاق واسع كنبات منزلي له قطع مسطحة مفصلية وعادة أزهار وردية أرجوانية تتفتح في الشتاء)",
 "シャコ貝": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "シャシ": "شَاصِي, هَيْكَل",
 "シャシャ": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "シャシー": "شَاصِي, هَيْكَل",
 "シャジクソウ": "نفل صغير, نفل مشكوك (نفل موطنه أيرلندا ذو أزهار مصفرة؛ غالباً ما يعتبر النفل الحقيقي أو الأصلي) / فصة ذئبية, فصة سوداء (عشب أوروبي مفترش ذو زهور صفراء صغيرة وقرون سوداء منحنية؛ تم توطينه في أمريكا الشمالية)",
 "シャジクモ": "عشب الحجر, كارا (أي من الطحالب المائية المغمورة المختلفة من جنس كارا لها عقد ذات فروع تشبه الخيوط؛ عادة ما تكون مغطاة برواسب كربونات الكالسيوم)",
 "シャソン": "أُغْنِيَّة فَرَنْسِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "シャチ": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / زِرّ",
 "シャッキシャッキ": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "シャッキリ": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح / بشكل منعش, بصورة مبهجة (بطريقة جديدة وممتعة تبعث على الانشراح) / بإنعاش, بشكل منعش (بطريقة تزيل التعب وتعيد الحيوية)\nمثال: كانت متحررة من الخجل بشكل منعش / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "シャッタ": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب)",
 "シャッター": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب)",
 "シャッターチャンス": "فرصة تصوير (مناسبة تتيح (أو يتم ترتيبها عمداً لـ) التقاط صور توفر دعاية إيجابية لمن يتم تصويرهم)",
 "シャッター・チャンス": "فرصة تصوير (مناسبة تتيح (أو يتم ترتيبها عمداً لـ) التقاط صور توفر دعاية إيجابية لمن يتم تصويرهم)",
 "シャット": "أَغْلَقَ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / اِنْغَلَقَ\nمثال: أغلق الباب بغضب",
 "シャットアウト": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "シャットダウン": "إغلاق, إقفال (إنهاء العمليات)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "シャットル": "رِيشَة / مَكُّوك / مَكُوك / مَكُوك فَضَاء",
 "シャット・アウト": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "シャッフリング": "تسكع, جر الأقدام (المشي بحركة جر بطيئة دون رفع القدمين) / خلط الأوراق (فعل خلط أوراق اللعب بشكل عشوائي)\nمثال: من طريقة جره لأقدامه افترضت أنه عجوز جداً",
 "シャッフル": "خَلَطَ (اختلط) / مَشَى يَجُرُّ قَدَمَيْهِ, رَسَفَ (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: خلط توم بين السكر و الملح. / رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "シャッフルボード": "شافلبورد (لعبة يستخدم فيها اللاعبون عصياً طويلة لدفع أقراص خشبية إلى منطقة التسجيل المحددة على سطح أملس)",
 "シャッポ": "قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "シャッポをぬぐ": "اِسْتَسْلَمَ / اِسْتَسْلَام",
