 "床": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "床あしらい": "خِدْمَة",
 "床しい": "جَدِير بِالْإِعْجَاب / فُضُولِيّ",
 "床屋": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "床山": "مُزَيِّن, كْوَافِير",
 "床店": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "床材": "أَرْضِيَّة (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية.",
 "床榻": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "床虱": "بَقّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا.",
 "床見世": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "床面": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "序": "فُرْصَة / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "序で": "فُرْصَة / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "序でながら": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "序の口": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "序列": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "序奏": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "序文": "مُقَدِّمَة",
 "序曲": "اِفْتِتَاحِيَّة",
 "序次": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "序盤": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "序章": "مُقَدِّمَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
