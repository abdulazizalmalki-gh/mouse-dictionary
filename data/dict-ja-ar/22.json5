 "思い入れ": "مَوْقِف, سُلُوك",
 "思い出": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "思い出す": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "思い切り": "عَزْم, عُزْم / دِقَّة",
 "思い切る": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "思い合せる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "思い合わせる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "思い回す": "تَفَكَّرَ, فَكَّرَ",
 "思い定める": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "思い寄る": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "思い巡らす": "تَفَكَّرَ, فَكَّرَ",
 "思い当たる": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "思い描く": "تَخَيَّلَ, تَصَوَّرَ",
