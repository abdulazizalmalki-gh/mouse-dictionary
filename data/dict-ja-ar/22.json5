 "建造物": "هَيْكَل",
 "廻し": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد. / وِشَاح / اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "廻す": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "廻り": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / رِحْلَة / جَوْلَة",
 "廻る": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "廻文": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / قَلْب مُسْتَوٍ",
 "廻旋": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "廻状": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "廻章": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "廻航": "مِلَاحَة",
 "廻船": "قَدَّاحَة, وَلَّاعَة",
 "廿": "عِشْرُونَ",
 "廿日大根": "فُجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "弁": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / بِنْتُو / بَتَلَة, تُوَيْجَة",
 "弁え": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "弁える": "مَيَّزَ / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس.",
 "弁じる": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "弁ずる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "弁別": "تَمْيِيْز",
 "弁務官": "مُفَوَّض, مُفَوَّضَة",
 "弁口": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "弁士": "مُحَاضِر, مُحَاضِرَة",
 "弁当": "بِنْتُو",
 "弁慶": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "弁慶の泣き所": "عَقِب أَخِيل, كَعْب أَخِيل",
 "弁慶縞": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "弁才": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "弁明": "تَفْسِير, شَرْح",
 "弁済": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "弁理": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "弁當": "بِنْتُو",
 "弁疏": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "弁者": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "弁膜": "صِمَام (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "弁舌": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "弁解": "تَفْسِير, شَرْح",
 "弁証学": "دِفَاعِيَّات",
 "弁証法": "جدلية",
 "弁証法的": "جدلية",
 "弁証論": "دِفَاعِيَّات",
 "弁論": "مُنَاقَشَة, بَحْث",
 "弁護": "دِفَاع, حِمَايَة / دِفاع",
 "弁護人": "شُورَى / مَشُورَة / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "弁護依頼人": "زَبُون, مُشْتَرٍ / عَمِيل (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "弁護士": "مُحَامٍ, مُحَامِيَة",
 "弁護者": "دَاعِم, مُؤَيِّد",
 "弁難": "نَقْد, اِنْتِقَاد",
 "弁駁": "تَنَاقُضٌ",
 "弁髪": "طابُور, صَفّ (وَحْدة عسكريَّة تضمّ عِدَّة سَرايا) / وَقَفَ فِي الصَّفّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: كانا واقفين في طابور.",
 "弄う": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "弄くる": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "弄する": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ / سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "弄び物": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "弄ぶ": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "弄り": "لَاطَفَ, رَبَتَ",
 "弄る": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "弄物": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "弊": "ضَرَرٌ / ضَرَّ أَضَرَّ / ـِي, ـي",
 "弊害": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "弊政": "سُوء إدَارَة",
 "弊方": "ـنِي, ـنِيَ / ـِي, ـِيَ",
 "弊職": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "弊誌": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "弋人": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "弌": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / أَفْضَل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "弍": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "弎": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "式": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا. / عُرْس, زِفَاف / مُعَادَلَة (المُوَازَنَة؛ في الرِيَاضِيَّات: هي مسألة مُتَوَازِنَة فيها طرفين كل واحد منهما يعادل الآخر فيها مَجْهُول أو أكثر يُرَادُ استخراجه)",
 "式典": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "式変形": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "式微": "نَخْر / اضمحل / تضعضع",
 "式法": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "弐": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "弐つ": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "弐拾": "عِشْرُونَ",
 "弑する": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "弓": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / رِمَايَة",
 "弓なり": "قَوْس, مُنْحَنَى",
 "弓なりになる": "قَوْس",
 "弓を引く": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "弓使い": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "弓兵": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "弓取": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "弓取り": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "弓師": "قَوَّاس",
 "弓弦": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "弓張": "تَرْبِيع",
 "弓張り": "تَرْبِيع",
 "弓張り月": "تَرْبِيع",
 "弓張月": "تَرْبِيع",
 "弓形": "قَوْس, مُنْحَنَى",
 "弓形になる": "قَوْس",
 "弓手": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "弓状": "قَوْس",
 "弓矢": "قَوْس وَسَهْم / سِلَاح, أَسْلِحَة",
 "弓箭": "قَوْس وَسَهْم / رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ) / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب.",
 "弓術": "رِمَايَة",
 "弔い": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة / تَعْزِيَة",
 "弔する": "نَدَبَ",
 "弔事": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "弔意": "تَأْسِيَة / تَعْزِيَة",
 "弔慰": "تَأْسِيَة / تَعْزِيَة",
 "弔文": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "弔歌": "رِثَاء, مَرْثِيَة",
 "弔詞": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "弔詩": "رِثَاء, مَرْثِيَة",
 "弔辞": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "弔鐘": "صُور",
 "引き": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "引きあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "引きうける": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / وَرَثَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "引きさる": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "引きしぼる": "سُلَالَة",
 "引きしめる": "شَدَّ, ضَيَّقَ",
 "引きずる": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / أَطَالَ / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "引きつける": "اِجْتَذَبَ, جَذَبَ",
 "引きつづく": "تَابَعَ, اِسْتَمَرَّ",
 "引きつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "引きつる": "زِيَار / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ) / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "引きとめる": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "引きひも": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "引きまわす": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "引きも切らず": "باستمرار",
 "引きも切らない": "مُسْتَمِرّ, مُتَوَاصِل",
 "引きわける": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "引き上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "引き上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "引き下がる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "引き下げ": "نَقْص",
 "引き下げる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "引き付ける": "اِجْتَذَبَ, جَذَبَ",
 "引き伸ばし": "تَمْدِيد / تَوْسِيع",
 "引き伸ばす": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "引き写し": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "引き写す": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "引き出し": "جَارُور, دُرْج / رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ)\nمثال: إنه رسام مشهور. / اِنْسِحَاب",
 "引き出す": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / يَسْتَحْضِر, يَسْتَدْعِي / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / مُقْتَطَف / خلاصة",
 "引き出物": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "引き分け": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "引き分ける": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "引き切る": "قَاطَعَ",
 "引き去る": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "引き取り": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "引き取り人": "مُحَافِظ",
 "引き取り手": "مُدَّعٍ, مُدَّعِيَة",
 "引き取る": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / تَبَنَّى / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "引き受け": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه.",
 "引き受ける": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / وَرَثَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "引き受け人": "كَافِل",
 "引き合い": "مَرْجِع / شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "引き合いに出す": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "引き合う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "引き合わせ": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "引き合わせる": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي. / قَارَنَ / شَبَّهَ",
 "引き吊り": "نَدْبَة, نَدْب / تَشَنُّج",
 "引き回し": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "引き回す": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "引き寄せる": "اِجْتَذَبَ, جَذَبَ",
 "引き延ばし": "تَمْدِيد / تَوْسِيع",
 "引き延ばす": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "引き廻し": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "引き廻す": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "引き当て": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "引き当てる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "引き戻す": "اِسْتَعَادَ",
 "引き手": "مِقْبَض",
 "引き払う": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "引き抜き": "تَعْبِئَة / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "引き抜く": "مُقْتَطَف / خلاصة",
 "引き揚げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "引き揚げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "引き換え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "引き換えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "引き換える": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "引き換え券": "قَسِيمَة / كُوبُون, قَسِيمَة شِرائِيَّة",
 "引き換え証": "إِيصَال",
 "引き摺る": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / أَطَالَ / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "引き攣り": "نَدْبَة, نَدْب / تَشَنُّج",
 "引き攣る": "زِيَار / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ) / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "引き数": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "引き明け": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "引き替え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "引き替える": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "引き止める": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "引き比べる": "قَارَنَ / شَبَّهَ",
 "引き波": "عائِق",
 "引き渡し": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "引き渡す": "نَقَلَ",
 "引き物": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس) / مِقْبَض",
 "引き留める": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "引き破る": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "引き移る": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "引き立つ": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "引き立て": "مَعْرُوف / أَنْعَمَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "引き立てる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "引き立て役": "فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "引き算": "طَرْح (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "引き紐": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "引き結ぶ": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / جِزْدَان, جُزْدَان",
 "引き絞る": "سُلَالَة",
 "引き継ぎ": "وَرَثَ",
 "引き継ぐ": "وَرَثَ / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "引き続き": "باستمرار / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "引き続く": "تَابَعَ, اِسْتَمَرَّ",
 "引き網": "شبكة",
 "引き締まった": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "引き締め": "تَضْيِيق",
 "引き締める": "شَدَّ, ضَيَّقَ",
 "引き舟": "زَوْرَق اَلْقَطْر",
 "引き船": "زَوْرَق اَلْقَطْر",
 "引き落し": "اِنْسِحَاب",
 "引き落とし": "اِنْسِحَاب",
 "引き起こす": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "引き越す": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
