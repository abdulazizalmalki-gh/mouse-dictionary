 "コクテル": "كُوكْتَيْل, كُوكْتِيل",
 "コクピット": "قمرة القيادة (مقصورة حيث يجلس الطيار أثناء قيادة الطائرة) / مقصورة القيادة (المقعد الذي يجلس فيه السائق أثناء قيادة سيارة سباق) / حلبة مصارعة الديوك (حفرة لمصارعة الديوك)",
 "コクリ": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / فَجْأَةً / عَمِيق, غَوِيط",
 "コクワ": "أكتينيديا حادة, كيوي هاردي (كرمة آسيوية متسلقة لها أوراق طويلة مسننة بدقة وعناقيد من الزهور البيضاء تليها ثمار صفراء مخضرة صالحة للأكل)",
 "コクーン": "شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر من أطوار حياتها)",
 "コケ": "أُشْنَة, طُحْلُب / حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "コケしょくぶつ": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "コケコッコー": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "コケッティシュ": "مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "コケット": "غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "コケットリー": "دَلَال",
 "コケティッシュ": "مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "コケムシ": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "コケモモ": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر) / توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "コケ植物": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "ココやし": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "ココア": "كاكاو / كَاكَاو",
 "ココアバター": "زُبْدَة الْكَاكَاو (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما يراد به أو أهم ما فيه)\nمثال: اشترت رطلي زبدة.",
 "ココアパウダー": "مسحوق الكاكاو (البقايا المسحوقة لسائل الشوكولاتة بعد إزالة زبدة الكاكاو؛ يستخدم في الخبز والوصفات قليلة الدسم والسعرات وكمنكه للآيس كريم)",
 "ココア・バター": "زُبْدَة الْكَاكَاو (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما يراد به أو أهم ما فيه)\nمثال: اشترت رطلي زبدة.",
 "ココア・パウダー": "مسحوق الكاكاو (البقايا المسحوقة لسائل الشوكولاتة بعد إزالة زبدة الكاكاو؛ يستخدم في الخبز والوصفات قليلة الدسم والسعرات وكمنكه للآيس كريم)",
 "ココスしょとう": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "ココス諸島": "جوز الهند, نارجيل (شجرة نخيل طويلة تحمل جوز الهند كثمار؛ تزرع على نطاق واسع في جميع أنحاء المناطق الاستوائية)",
 "ココット": "كَسْرُول, طَاجِن / رامكين, صحن فخار صغير (طبق صغير مقاوم للنار يستخدم للخبز وتقديم الحصص الفردية) / رامكين (طبق جبن مصنوع من البيض وفتات الخبز يخبز ويقدم في أطباق فردية مقاومة للنار)",
 "ココナッツ": "جَوْز الْهِنْد (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ) / نَارْجِيل\nمثال: نريد أن نأكل نبات جوز الهند.",
 "ココナッツオイル": "دُهْن النَارَجِيل, دُهْن جَوْز الْهِنْد (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "ココナッツジュース": "مَاء النَارَجِيل, ماء جَوْز الْهِنْد (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "ココナッツミルク": "حَلِيب النَارَجِيل, حَلِيب جَوْز الْهِنْد (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
