 "平方": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "平方メートル": "مِتْرٌ مُرَبَّعٌ (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر.",
 "平方形": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "平方根": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "平日": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "平明": "شَفَّاف / وَاضِح",
 "平明達意": "تَلَفَّظَ",
 "平易": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平時": "وَقْت السَّلَامِ, وَقْت السِّلْمِ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "平板": "بَلَاط / مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "平民主義": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "平民的": "شَائِع",
 "平気": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "平気の平左": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "平淡": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "平準": "مُسْتَوًى / مَرْحَلَة",
 "平準化": "مُسْتَوًى / مَرْحَلَة",
 "平滑化": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "平然": "هَادِئ / طَمْأَنَ",
 "平爪": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "平生": "عَادِيّ",
 "平癒": "شِفَاء, تَعَافِي",
 "平穏": "هَادِئ / طَمْأَنَ",
 "平穏無事": "سِلْمِيّ / مُسَالِم",
 "平等": "مُسَاوَاة / تَسَاوٍ",
 "平米": "مِتْرٌ مُرَبَّعٌ (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر.",
 "平素": "عَادِيّ / عَادَةً",
 "平素は": "عَادَةً, الاَكْثِرْ",
 "平素より": "دَائِمًا, أَبَدًا",
 "平落": "فَطِيرَة",
 "平虫": "دُودَة مُسَطَّحَة",
 "平行世界": "عَالَم مُوَازِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "平行四辺形": "مُتَوَازِي أَضْلَاع",
 "平行移動": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "平衡": "رَصِيد",
 "平角": "زَاوِيَة مُسْتَقِيمَة",
 "平身低頭": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "平野": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平野部": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平鍋": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "平静": "هَادِئ / طَمْأَنَ / صَبْر, تساوي ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "平面": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "平面的": "مُسَطَّح / سَطْحِيّ",
 "年": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / شَيْخُوخَة, عُجُوز",
 "年かさ": "مُسِنّ, مُسِنَّة",
 "年がいく": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "年がら年中": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "年が明ける": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "年が行く": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "年ごろ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年とった": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
