 "忍びやか": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "忍び会い": "مَوْعِد, لِقَاء اَلْحُبّ (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "忍び声": "هَمْس / هَمَسَ, وَسْوَسَ",
 "忍び笑い": "إِهْلَاس",
 "忍び逢い": "مَوْعِد, لِقَاء اَلْحُبّ (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "忍び音": "هَمْس / هَمَسَ, وَسْوَسَ",
 "忍ぶ": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "忍会": "مَوْعِد, لِقَاء اَلْحُبّ (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "忍従": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "忍者": "نِينْجَا, نِنْجَا",
 "忍耐": "مُثَابَرَة",
 "忍耐力": "مُثَابَرَة",
 "忍耐心": "مُثَابَرَة",
 "忍苦": "رِوَاقِيَّة",
 "忍術": "نِينْجُوتْسُو",
 "忍辱": "حِلْم (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / ثُوم, ثُومَة",
 "忖度": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "志": "إرَادَة / رَغْبَة, إرَادَة / إِحْسَان / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "志す": "تَعَمَّدَ, نَوَى",
 "志向": "قَصْد, إِرَادَة",
 "志士": "وَطَنِيّ, وَطَنِيَّة",
 "志操": "مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "志望": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "志望者": "مُرَشَّح / مُرَشَّحَة",
 "志業": "مَطْمَح",
 "志気": "عَزِيمَة",
 "志集": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "志願": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "志願書": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "志願者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "忘るな草": "أُذْن الفَأْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "忘れえぬ": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘れがたい": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘れがち": "نَسَّاء, نَسِيّ",
 "忘れっぽい": "نَسَّاء, نَسِيّ",
 "忘れな草": "أُذْن الفَأْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "忘れもしない": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘れられない": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘れる": "نَسِيَ (لَمْ يَتَذَكَّرْ؛ غَابَ عَنْ الذِهْن)\nمثال: لقد نسي صديقتك.",
 "忘れ勝ち": "نَسَّاء, نَسِيّ",
 "忘れ形見": "تَذْكار / يَتِيم / يَتِيمَة",
 "忘れ得ぬ": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘れ草": "تِبْغ, تَبْغ / تَبْغ, تَبَغ",
 "忘れ難い": "غَيْر مَنْسِيّ, لَا يُنْسَى (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "忘八": "يُوحَنَّا, يَحْيَى ((في المسيحية) أي من شخصيات الكتاب المقدس الذين تسموا بهذا الاسم، وأشهرهم: \"يُوحَنَّا الْمَعْمَدَان\"، و\"يُوحَنَّا الْإِنْجِيلِيّ\"…؛ (في المسيحية) إنجيل يوحنا، آخر الأناجيل القانونية الأربع) / إِنْجِيل يُوحَنَّا\nمثال: توم وماريا قالو ليوحنا, أنهم لا يعتقدون أن تكون ايلكا في الأسفل. / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "忘八屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "忘却": "نِسْيَان",
 "忘却のかなた": "إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "忘却の彼方": "إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "忘失": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "忘己利他": "إِيثَار, غَيْرِيَّة",
 "忘我": "ترانس",
 "忘草": "تِبْغ, تَبْغ / تَبْغ, تَبَغ",
 "忙しい": "مَشْغُول",
 "忙しない": "مُسْتَعْجِل",
 "忙殺": "غَالِب",
 "応": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "応え": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "応える": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "応じて": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "応じる": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "応ずる": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد. / رَضَّى",
 "応分": "مُنَاسِب / لَائِق",
 "応力": "إِجْهَاد",
 "応募": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "応募者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "応召兵": "مُجَنَّد",
 "応召者": "مُجَنَّد",
 "応報": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "応対": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "応当": "مَاثَلَ / راسَلَ",
 "応戦": "هُجُوم مُضَادّ",
 "応接": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "応接係": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "応援": "مُسَاعَدَة / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "応用": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "応用アソシエーション": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "応用問題": "تَمْرِين, تَدْرِيب / تَمَرَّنَ",
 "応答": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "応答メッセージ": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية.",
 "応諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "応酬": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "忝い": "مُمْتَنّ, شَاكِر",
 "忠": "وَفَاء, إِخْلَاص",
 "忠なる": "توفر على, صرف همته إلى",
 "忠信": "الإِيمَان",
 "忠勤": "وَفَاء, إِخْلَاص",
 "忠告": "نَصِيحَة, مَشُورَة",
 "忠実": "وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "忠実やか": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "忠実度": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء",
 "忠実忠実しい": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "忠心": "وَفَاء, إِخْلَاص",
 "忠愛": "وَفَاء, إِخْلَاص",
 "忠節": "وَفَاء, إِخْلَاص",
 "忠義": "وَفَاء, إِخْلَاص",
 "忠言": "نَصِيحَة, مَشُورَة",
 "忠誠": "وَفَاء, إِخْلَاص",
 "忠誠を尽くす": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "忠誠心": "وَفَاء, إِخْلَاص",
 "忠順": "اِنْتِمَاء",
 "忠魂": "وَفَاء, إِخْلَاص",
 "快": "مُتْعَة, لَذَّة / سَرِيع",
 "快い": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "快く": "طَوْعًا, طَوَاعِيَةً",
 "快事": "مُتْعَة, لَذَّة",
 "快作": "تُحْفَة, رَائِعَة",
 "快味": "مُتْعَة, لَذَّة",
 "快哉": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "快報": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "快弁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "快悦": "فُرْجَة",
 "快感": "مُتْعَة, لَذَّة",
 "快感帯": "مِنْطَقَة رَاحَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "快方": "نَقَاهَة / نَقَاهَة, فَتْرَةُ نَقَاهَة",
 "快方に赴く": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "快楽": "مُتْعَة, لَذَّة",
 "快楽主義": "مَذْهَب اَللِّذَّة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه)\nمثال: الوجودية مذهب إنساني.",
 "快楽主義者": "إِبِيقُورِيّ",
 "快楽説": "مَذْهَب اَللِّذَّة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه)\nمثال: الوجودية مذهب إنساني.",
 "快楽順応": "تَكَيُّف المُتْعَة, تَكَيُّف اللَذَّة",
 "快気": "شِفَاء, تَعَافِي",
 "快活": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "快然": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا. / شِفَاء / شَفَى",
 "快癒": "شِفَاء, تَعَافِي",
 "快美": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "快調": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "快辯": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "快適": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "快適さ": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "快音": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "忰せる": "جُلْبَة",
 "念": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / اِهْتِمَام, اِنْتِبَاه",
 "念い": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "念じる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / أُهْزُوجَة, أَهَازِيج",
 "念ずる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / أُهْزُوجَة, أَهَازِيج",
 "念のため": "تَحَسُبًا",
 "念の為": "تَحَسُبًا",
 "念を入れる": "أَعَارَ اِنْتِبَاه",
 "念を押す": "ذَكَّرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "念入り": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "念入れ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "念力": "إِيمَان, مُعْتَقَد / إِيمَان, دِين",
 "念書": "مُذَكِرَة",
 "念波": "تَخَاطُر",
 "念無し": "مُفَاجِئ / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "念珠": "مِسْبَحَة, سُبْحَة",
 "念頭": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "念頭におく": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "念頭に入れる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "念頭に置く": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "忸怩": "خَجُول",
 "忻然": "سَعِيد, مُفْرِح",
 "忽": "مُبَاغِت, مُفَاجِئ",
 "忽せ": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / اِسْتَرْخَى",
 "忽せにする": "أَهْمَلَ / إِهْمَال",
 "忽ち": "فَوْرًا, حَالًا / فَجْأَةً",
 "忽地": "فَجْأَةً",
 "忽焉": "مُبَاغِت, مُفَاجِئ",
 "忽然": "مُبَاغِت, مُفَاجِئ",
 "忿怒": "غَضَب / أَغْضَبَ / غَضِبَ",
 "怏々": "لَعُوق",
 "怏怏": "لَعُوق",
 "怒らす": "غَضَب / أَغْضَبَ / غَضِبَ / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "怒らせる": "غَضَب / أَغْضَبَ / غَضِبَ / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "怒り": "غَضَب / أَغْضَبَ / غَضِبَ",
 "怒りだす": "اِنْدَلَعَ",
 "怒りを買う": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "怒り出す": "اِنْدَلَعَ",
 "怒り心頭": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "怒り狂う": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "怒る": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "怒気": "غَضَب / أَغْضَبَ / غَضِبَ",
 "怒涛": "مُضْطَرِب, صَاخِب",
 "怒濤": "مُضْطَرِب, صَاخِب",
 "怒鳴り出す": "اِنْدَلَعَ",
 "怒鳴り散らす": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "怒鳴る": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "怖": "مُجَفِّل, مُخِيف",
 "怖い": "مُجَفِّل",
 "怖いもの知らず": "مُتَهَوِّر",
 "怖い物知らず": "مُتَهَوِّر",
 "怖がり": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "怖がる": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怖じけ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怖じ気": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怖る": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怖れる": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怖気": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "怜悧": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "怜悧狡猾": "مَاكِر",
 "思い": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / خَيَّال, تَخَيُّل (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / صُورَة ذِهْنِيَّة\nمثال: يحب الخيال العلمي. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "思いあがり": "غَطْرَسَة",
 "思いいれ": "مَوْقِف, سُلُوك",
 "思いがけない": "مُفَاجِئ",
 "思いきり": "عَزْم, عُزْم / دِقَّة",
 "思いこみ": "إِجْحَاف, تَحَامُل",
 "思いこむ": "اِفْتَرَضَ / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "思いたつ": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "思いっきし": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "思いっきり": "عَزْم, عُزْم / دِقَّة",
 "思いっ切し": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "思いつき": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "思いつく": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "思いとどまる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "思いなおす": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "思いなす": "اِفْتَرَضَ",
 "思いめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "思いもかけない": "مُفَاجِئ",
 "思いもよらない": "مُفَاجِئ",
 "思いも寄らない": "مُفَاجِئ",
 "思いも掛けない": "مُفَاجِئ",
 "思いやり": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "思いをめぐらす": "تَفَكَّرَ, فَكَّرَ",
 "思いをめぐらせる": "تَفَكَّرَ, فَكَّرَ",
 "思いを寄せる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "思いを巡らす": "تَفَكَّرَ, فَكَّرَ",
 "思いを巡らせる": "تَفَكَّرَ, فَكَّرَ",
 "思い上がり": "غَطْرَسَة",
 "思い事": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "思い人": "عَاشِق, عَاشِقَة / مُغْرَم",
 "思い付き": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "思い付く": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
