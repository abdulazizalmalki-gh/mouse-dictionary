 "心に掛ける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心に描く": "تَخَيَّلَ, تَصَوَّرَ",
 "心に染む": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "心に留める": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心に秘める": "احتفظ بكل شيء لنسفه",
 "心の優しい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "心の広い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "心の支え": "دعم معنوي (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "心の理論": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "心の病": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "心の病気": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "心の臓": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "心の色": "إِحْسَان",
 "心ばえ": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / طَبِيعَة, طبيعة",
 "心ばかり": "صَغِير, صغير",
 "心ひそかに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "心もとない": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَصَبِيّ",
 "心やり": "اِسْتِجْمَام",
 "心をいたす": "كَرَّسَ, قَدَّمَ / توفر",
 "心をこめて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "心を入れ替える": "إِصْلَاح",
 "心を動かす": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "心を痛める": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心を砕く": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心を籠めて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "心を致す": "كَرَّسَ, قَدَّمَ / توفر",
 "心を許す": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "心を込めて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "心を配る": "أَعَارَ اِنْتِبَاه",
 "心不全": "قُصُور القَلْب, فَشَل القَلْب",
 "心中": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "心中穏やかでない": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "心中立て": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء / وَفَاء, إِخْلَاص",
 "心事": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "心付": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "心付く": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "心付け": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "心休め": "مُوَاسَاة",
 "心使い": "عِنَايَة, رِعايَة",
 "心停止": "سَكْتَة قَلْبِيَّة",
 "心傷": "غَمّ, حُزْن",
 "心傷れ": "غَمّ, حُزْن",
 "心優しい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "心内膜": "شُغاف",
 "心出し": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "心労": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心嚢": "تَأْمُور",
 "心地": "تَبْطِين",
 "心地いい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "心地よい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "心地良い": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "心変わり": "جُنُون",
 "心外": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "心外膜炎": "اِلْتِهَاب التَّأْمُور",
 "心安い": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "心安らか": "هَادِئ / طَمْأَنَ",
 "心室": "بُطَيْن",
 "心室細動": "رجفان بطيني",
 "心寂しい": "وَحِيد, مُوحِش",
 "心密かに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "心尽くし": "إِحْسَان",
 "心尽し": "إِحْسَان",
 "心底": "قَلْبًا وَقَالَبًا",
 "心延え": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / طَبِيعَة, طبيعة",
 "心張り棒": "حَانَة, بَار",
 "心当たり": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "心当たりのない": "مُفَاجِئ",
 "心当て": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "心得": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / دِرَايَة, بَرَاعَة / نَائِب, نَائِبَة",
 "心得る": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس.",
 "心得違い": "سُوء فَهْم",
 "心性": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "心悲しい": "حَزِين, زعلان / مُحْزِنٌ",
 "心悸": "خَفَقَان",
 "心悸亢進": "خَفَقَان",
 "心情": "عَاطِفَة",
 "心意": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "心意気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "心慮": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "心憎い": "جَدِير بِالْإِعْجَاب",
 "心房": "أُذَيْن",
 "心房細動": "رَجَفَان أُذَيْنِيّ",
 "心拍": "نَبْض, نَبْضُ القَلْب",
 "心持": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / قَلِيلًا",
 "心持ち": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / قَلِيلًا",
 "心掛け": "مَوْقِف, سُلُوك",
 "心掛ける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "心有る": "عَمِيق اَلتَّفْكِير / حَرِيص, حَكِيم / حَرِيص",
 "心材": "خشب القلب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "心根": "قَلْب, فُؤَاد / قَلْب / كُبَّا / طَبِيعَة, طبيعة",
 "心機": "مَوْقِف, سُلُوك",
 "心残り": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "心気": "عَقْلِيَّة",
 "心気症": "وَسَاوِس مرضية",
 "心淋しい": "وَحِيد, مُوحِش",
 "心添え": "نَصِيحَة, مَشُورَة",
 "心無い": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "心猿": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف.",
 "心理": "عَقْلِيَّة",
 "心理学": "سَيْكُولُوجْيَا, عِلْم النَّفْس",
 "心理学者": "نَفْسَانِيّ, عَالِم النَّفْس",
 "心理的": "عَقْلِيّ",
 "心痛": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "心癖": "طَبِيعَة, طبيعة",
 "心的": "عَقْلِيّ",
 "心的外傷後ストレス障害": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "心祝い": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "心神": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "心神喪失": "جُنُون",
 "心積もり": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "心積り": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "心穏やか": "هَادِئ / طَمْأَنَ",
 "心筋梗塞": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "心算": "قَصْد, إِرَادَة / اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان",
