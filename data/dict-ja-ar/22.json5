 "コスモス": "فَضَاء (فَضَاء) / كَوْن / الْكَوْن\nمثال: الفضاء مليئ بالغموض.",
 "コスモノート": "رَجُل فَضَاء, رَائِد فَضَاء (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "コスモポリタニズム": "الْمُوَاطَنَة الْعَالَمِيَّة",
 "コスモポリタン": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "コスモロジー": "عِلْم الكَوْن الفِيزِيَائِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "コスレタス": "خس روماني, خس طويل (خس ذو أوراق خضراء داكنة طويلة في رأس ممدود معبأ بشكل فضفاض) / خس روماني (خس ذو أوراق طويلة خضراء داكنة على شكل ملعقة)",
 "コス・レタス": "خس روماني, خس طويل (خس ذو أوراق خضراء داكنة طويلة في رأس ممدود معبأ بشكل فضفاض) / خس روماني (خس ذو أوراق طويلة خضراء داكنة على شكل ملعقة)",
 "コス島": "كُوس",
 "コズミック": "كَوْنِيّ, فَضَائِيّ",
 "コセカント": "قَاطِعُ تَمَام",
 "コソコソ": "خلسة, سراً (بطريقة سرية)\nمثال: كان يراقبها خلسة وهي تنتظر في ردهة الفندق",
 "コソコソ話": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "コソドロ": "لص متسلل (لص يسرق دون استخدام العنف)",
 "コソボ": "كُوسُوفُو",
 "コソヴォ": "كُوسُوفُو",
 "コソ泥": "لص متسلل (لص يسرق دون استخدام العنف)",
 "コタニワタリ": "سرخس الشريط الفلوريدي, سرخس لسان البقر (سرخس هوائي أو أرضي أحياناً شائع ذو أوراق شريطية خضراء مصفرة شاحبة؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى أوروغواي) / سرخس لسان الأيل, لسان الأيل (سرخس أوراسي بسعف رمحي بسيط) / أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "コタン": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "コタンジェント": "ظِلّ اَلتَّمَام (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "コダラ": "سمك الحدوق, سمك القد (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "コチ": "مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / مسطحة الرأس (سمكة غذائية في المنطقة الإندونيسية من المحيط الهادئ؛ تشبه الغرنار)",
 "コチコチ": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "コチニール": "دودة قرمزية",
 "コチョウゲンボウ": "يؤيؤ",
 "コチョウラン": "أوركيد العثة, فالاينوبسيس (أي من بساتين الفاكهة المختلفة من جنس فالاينوبسيس ذات أوراق بيضاوية أو بيضاوية مقلوبة عريضة لامعة متدلية غالباً خضراء داكنة مشوبة بالأرجواني أو مرقطة…)",
 "コチョコチョ": "دغدغة (فعل الدغدغة) / دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "コッカースパニエル": "كوكر سبانييل (سلالة صغيرة ذات شعر حريري مموج؛ تم تطويرها في الأصل في إنجلترا)",
 "コッカー・スパニエル": "كوكر سبانييل (سلالة صغيرة ذات شعر حريري مموج؛ تم تطويرها في الأصل في إنجلترا)",
 "コック": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر. / ديك (طائر ذكر بالغ) / ديك (ذكر الدجاج البالغ) / ديك, مطرقة (جزء من قفل البندقية يضرب كبسولة القدح عند سحب الزناد) / صنبور, محبس (صنبور يتكون من جهاز دوار لتنظيم تدفق السائل)",
 "コックオバン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コックオーバン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コックオーヴァン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コックス": "ربان القارب, كوكس (موجه قارب السفينة أو طاقم السباق) / سيكلوأكسيجيناز (أحد إنزيمين مرتبطين يتحكمان في إنتاج البروستاغلاندين ويتم حظرهما بواسطة الأسبرين)",
 "コックニー": "كوكني (متعلق بشخص من الكوكني (سكان شرق لندن) أو يشبهه) / كوكني (مميز للكوكني (سكان شرق لندن) أو لهجتهم) / كوكني (اللهجة غير القياسية للسكان الأصليين للطرف الشرقي من لندن) / كوكي\nمثال: أطفال شوارع من الكوكني",
 "コックピット": "قمرة القيادة (مقصورة حيث يجلس الطيار أثناء قيادة الطائرة) / مقصورة القيادة (المقعد الذي يجلس فيه السائق أثناء قيادة سيارة سباق) / حلبة مصارعة الديوك (حفرة لمصارعة الديوك)",
 "コックリ": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / فَجْأَةً / عَمِيق, غَوِيط",
 "コックリング": "حلقة القضيب (حلقة يمكن وضعها حول القضيب، عادة عند القاعدة، لإبطاء تدفق الدم)",
 "コックローチ": "صُرْصُور",
 "コック・オ・バン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コック・オー・バン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コック・オー・ヴァン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コッコーバン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コッコーヴァン": "دجاج بالنبيذ, كوك أو فان (دجاج وبصل وفطر مطهو ببطء في النبيذ الأحمر والتوابل)",
 "コッソリ": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "コッター": "تيلة, خابور (مثبت يتكون من إسفين أو مسمار يتم إدخاله عبر فتحة لتثبيت قطعتين أخريين معاً) / فلاح قن (قن إنجليزي من العصور الوسطى) / فلاح إسكتلندي, كوتر (مزارع فلاح في المرتفعات الاسكتلندية)",
 "コッテージ": "كُوخ, مُنَيْزِل",
 "コッテージチーズ": "جُبْن قَرِيش (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "コッテージ・チーズ": "جُبْن قَرِيش (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "コットン": "قُطْن, قُطُن / قُطْنِي, قطن",
 "コッパー": "نُحَاس, نحاس (في : عنصرْ فِلزيّ قابل للطَّرْق ، يوصَف عادة بالأحمر لقرب لونه من الحمرة؛ ما سقَط من شرر الصُّفْر أو الحدود إِذا طُرق)\nمثال: هي تصهر النحاس.",
 "コップ": "زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟ / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء) / فِنْجَان (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: هل لي بكأس ماء؟ / شُرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "コップざ": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان",
 "コップンカー": "شُكْرًا, تِسْلَم",
 "コップ座": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان",
 "コッペパン": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "コツ": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / عَظْم / عضم / عَظْمَة / عضمة / رَمَاد, سَكَن / دَرْدَار",
 "コツをつかむ": "أَتْقَنَ, بَرَعَ (أن يصبح بارعاً أو ماهراً تماماً في شيء ما)\nمثال: أتقنت اليابانية في أقل من عامين",
 "コツコツ": "بثبات / طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "コツコツはたらく": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "コツコツ働く": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "コツフ": "زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟ / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء) / فِنْجَان (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: هل لي بكأس ماء؟",
 "コツメ": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "コテ": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / لفافة شعر, مجعد شعر (جهاز ميكانيكي يتكون من أنبوب أسطواني يُلف حوله الشعر لتجعيده) / مجند بالإكراه (شخص يخدع الرجال أو يجبرهم على الخدمة كبحارة أو جنود) / أداة كبس, زرادية كبس (أداة يدوية تستخدم لربط قطعتين من المعدن أو مادة أخرى قابلة للطرق (عادة سلك وصفيحة معدنية) عن طريق تشويه أحدهما أو كليهما لتثبيت الآخر)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً / مِجْرَفَة, مَالَج / مَالَج",
 "コテコテ": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / تماماً, كلياً (عبر النطاق بالكامل)\nمثال: تبلل تماماً في المطر",
 "コテン": "فَجْأَةً",
 "コテンコテン": "تَمَامًا",
 "コテンパ": "تَمَامًا",
