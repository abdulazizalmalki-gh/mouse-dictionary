 "影響を及ぼす": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響下": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響力": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "影響圏": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "影響者": "مُؤَثِّر",
 "彷彿": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "彷徨": "تَجَوَّلَ",
 "彷徨える": "تجوال, رومينغ",
 "彷徨変異": "تَذَبذُب, تَقَلُّب",
 "役": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "役する": "وَظَّفَ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "役にたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役にもたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役にも立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役に立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役に立た無い": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役に立てる": "مَأْثُرَة / اِسْتَغَلَّ",
 "役を勤める": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "役作り": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "役儀": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役割": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "役割り": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "役務": "مَخَاض / عَمَلَ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "役員": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / مَأْمُور / مَسْؤُول / ضَابِط",
 "役回り": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役場": "بَلَدِيَّة",
 "役夫": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "役得": "مِنْحَة, عِلَاوَة",
 "役所": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "役柄": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "役目": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "役立たず": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "役者": "مُمَثِّل, مُمَثِّلَة",
 "役職": "عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "彼": "هُوَ / خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼とか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "彼の": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "彼のさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の人": "هُوَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の国": "اَلنِّرْفَانَا",
 "彼の地": "هُنَاكَ",
 "彼の娘": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の子": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "彼の岸": "اَلنِّرْفَانَا",
 "彼の方": "هُوَ",
 "彼の様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "彼は誰時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "彼ぴ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼ぴっぴ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼ら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼ピ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼ピッピ": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "彼女": "هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا)\nمثال: هذه هي المسألة. / صَدِيقَة, صَاحِبَة (مؤنث الصديق؛ الصاحبة الخليلة) / صَدِيقَة (مؤنث الصديق؛ الصاحبة الخليلة)\nمثال: ليس لديه صديقة.",
 "彼女ら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼女等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼女自身": "نَفْسُهَا",
 "彼奴ばら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼奴ら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼奴等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼奴輩": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼岸": "اَلنِّرْفَانَا",
 "彼方": "أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ) / أَقْصَى / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / فَوْق / فَوْقَ\nمثال: أبعد صورتها عني.",
 "彼方方": "هُنَاك, هُنَالِك / ـهُ, ـهِ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "彼氏": "خَلِيل, رَفِيق / صَدِيق, رَفِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / هُوَ",
 "彼等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "彼自身": "نَفْسَهُ",
 "彼誰時": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
