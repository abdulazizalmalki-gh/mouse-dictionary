 "相加平均": "المتوسط الحسابي",
 "相勤める": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "相半ばする": "رَصِيد",
 "相即不離": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "相反": "تَقَابُل مُتَبَادَل, قُطْبِيَّة (علاقة بين صفتين أو اتجاهين متعاكسين)\nمثال: نظر إليها كقطبية متوازنة بين الخير والشر / ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / استهجان, نفور شديد (نفور شديد) / تنافر, قوة تنافر (القوة التي تتنافر بها الأجسام عن بعضها البعض)",
 "相反する": "صِرَاع, نِزَاع",
 "相反性": "مُتَبَادَل / مَقْلُوب",
 "相反的": "مُتَبَادَل / مَقْلُوب",
 "相口": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة) / زفرة, طعم سمك (طعم يتكون من سمك مقطع وزيوت سمك يتم إلقاؤها في البحر لجذب الأسماك) / رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم) / خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "相同": "تَجَانُس, تَمَاثُل (صفة التشابه أو التطابق في الموقع أو القيمة أو الهيكل أو الوظيفة)",
 "相向い": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "相向かい": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "相哀れむ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "相場": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح) / تَكَهُّنٌ / مُضَارَبَة / سُمْعَة, شُهْرَة",
 "相場師": "مُضَارِب",
 "相変らず": "كَالْعَادَة, كَالْمُعْتَاد",
 "相変わらず": "كَالْعَادَة, كَالْمُعْتَاد",
 "相変化": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "相変態": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "相好": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "相婿": "شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "相容れない": "غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "相容れる": "تَعَايَشَ",
 "相容性": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "相対": "بَيْن شَخْصَيْن, خَاصّ وَحَمِيم (يشمل شخصين؛ خاصّ وحميميّ) / أريكة لشخصين, مقعد المحبين (أريكة صغيرة تتسع لشخصين) / حديث ثنائي, نجوى (محادثة خاصة بين شخصين) / نسبية (صفة كون الشيء نسبياً وله دلالة فقط عند ربطه بشيء آخر) / نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة) / نِسْبِيّ / قَرِيب, قَرِيبَة / تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "相対す": "صِرَاع, نِزَاع",
 "相対する": "صِرَاع, نِزَاع",
 "相対主義": "نِسْبَوِيَّة",
 "相対多数": "أكثرية نسبية, تعددية ((في انتخابات بها أكثر من خيارين) عدد الأصوات للمرشح أو الحزب الذي يحصل على أكبر عدد (ولكن أقل من نصف الأصوات)) / جموع, حشد (كمية كبيرة غير محددة) / تعدد, جمع (حالة الجمع)\nمثال: حشد من النمل",
 "相対形式プログラム": "برنامج قابل للنقل (برنامج يمكن وضعه في أجزاء مختلفة من الذاكرة في أوقات مختلفة)",
 "相対性": "نسبية (صفة كون الشيء نسبياً وله دلالة فقط عند ربطه بشيء آخر) / نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "相対性原理": "مبدأ النسبية ((فيزياء) قانون عالمي ينص على أن قوانين الميكانيكا لا تتأثر بحركة مستقيمة منتظمة لنظام الإحداثيات الذي يتم الرجوع إليه)",
 "相対性理論": "نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "相対湿度": "رُطُوبَة نِسْبِيَّة (نسبة كمية الماء في الهواء عند درجة حرارة معينة إلى الحد الأقصى للكمية التي يمكن أن يحملها عند تلك الدرجة؛ معبراً عنها كنسبة مئوية)",
 "相対的": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "相対論": "نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة) / نِسْبَوِيَّة",
 "相対速度": "سُرْعَة نِسْبِيَّة (الفرق المتجهي بين سرعتي جسمين: سرعة جسم بالنسبة لآخر يُعتبر ساكناً)\nمثال: قد تبدو الحركة مختلفة عند النظر إليها من إطار مرجعي مختلف، لكن يمكن تفسير ذلك بتضمين السرعة النسبية للإطار المرجعي في وصف الحركة",
 "相対運動": "حركة نسبية (الحركة كما تلاحظ من أو تشير إلى نظام مادي يشكل إطاراً مرجعياً (مثل جدارين متجاورين وأرضية غرفة))",
 "相引": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر) / قارنة, وصلة (جهاز ميكانيكي يعمل على توصيل نهايات الأجسام المتجاورة) / مقرن, وصلة ربط (وصلة (مثل المشبك أو الملزمة) بين شيئين بحيث يتحركان معاً)\nمثال: الاقتران العرضي للمراهقين",
 "相当": "مُنَاسِب / لَائِق / كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "相当な注意": "عناية واجبة (العناية التي يمارسها الرجل العاقل في ظل الظروف؛ المعيار لتحديد الواجب القانوني)",
 "相当語句": "مُعَادِل",
 "相役": "شَرِيك, شَرِيكَة",
 "相応": "مُنَاسِب, مُلَائِم / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "相応しい": "مُنَاسِب / لَائِق",
 "相思": "تَفَاهُم مُتَبَادَل, وُدّ مُتَبَادَل (تعاطف كل شخص مع الآخر)",
 "相性": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "相憐れむ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "相成る": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "相手": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / مُسْتَلِم, مُسْتَلِمَة / خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "相手が悪い": "مَتْفُوق عَلَيْه (تجاوزه غيره بشكل حاسم حتى يبدو من طبقة أدنى)",
 "相手どる": "تَحَدٍّ, التَّحَدِّي",
 "相手をする": "اِهْتَمَّ, اِعْتَنَى",
 "相手を選ぶ": "مَيَّزَ",
 "相手側": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "相手先固定接続": "انقباض بطيني سابق لأوانه (عدم انتظام في إيقاع القلب؛ يمكن أن يكون تكرار حدوثه مقدمة للرجفان البطيني) / بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "相手取る": "تَحَدٍّ, التَّحَدِّي",
 "相手固定接続": "انقباض بطيني سابق لأوانه (عدم انتظام في إيقاع القلب؛ يمكن أن يكون تكرار حدوثه مقدمة للرجفان البطيني) / بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "相手国": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "相手役": "حَبِيب, حَبِيبَة",
