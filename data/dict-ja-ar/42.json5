 "津液": "لُعَاب, رِيق / سَائِل, مَائِع",
 "津田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "津賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "津軽": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "洩らす": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "洩る": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "洩れ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / إِغْفَال / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "洩れる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "洩れ聞く": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "洪大": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "洪水": "طُوفَان, فَيَضَان (عاصفة)",
 "洪水吐": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "洪水吐き": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "洲": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / قَارَّة / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى. / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / ضفة رملية (ضفة مغمورة من الرمال بالقرب من الشاطئ أو في النهر؛ يمكن أن تنكشف عند الجزر المنخفض)",
 "洵美": "بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن) / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "洸々": "بَاسِل, مَغْوَار (يَمْتَلِك أَوْ يُظْهِر بَسَالَةً وإِقْدَامًا)",
 "洸洋": "غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل) / سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / عميق جداً, لا يسبر غوره (عن العمق؛ غير قادر على أن يسبر أو يقاس)",
 "洸洸": "بَاسِل, مَغْوَار (يَمْتَلِك أَوْ يُظْهِر بَسَالَةً وإِقْدَامًا)",
 "活": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "活かす": "استدانة, روافع مالية (الاستثمار بأموال مقترضة كوسيلة لتضخيم المكاسب المحتملة (مع خطر حدوث خسائر أكبر)) / قُوَّة تَأْثِير, نُفُوذ (أفضلية استراتيجية؛ القدرة على التصرف بفاعلية) / قوة الرافعة, ميزة ميكانيكية (الميزة الميكانيكية المكتسبة من خلال التواجد في وضع يسمح باستخدام رافعة)\nمثال: يمكن للمجموعات الصغيرة نسبياً أن تمارس أحياناً نفوذاً سياسياً هائلاً / اِسْتَعَادَ",
 "活き": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً / بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "活きがいい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "活きが良い": "طَازَج, طَازَة / عَذْب / دَجِر",
 "活きのいい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "活きの良い": "طَازَج, طَازَة / عَذْب / دَجِر",
 "活き活き": "بِشَكْل حَيّ, بِوُضُوح (بطريقة حية)\nمثال: وصف مغامراته بشكل حي",
 "活く": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "活ける": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "活け込む": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "活人画": "تابلوه, لوحة حية (مجموعة من الأشخاص مرتبين بشكل جذاب (كما لو كانوا في لوحة))",
 "活仏": "الدالاي لاما (كبير اللامات وكان حاكم التبت سابقاً)",
 "活劇": "فِيلْمُ أَكْشِنْ, فِيلْمُ حَرَكَةٍ",
 "活力": "تدفق, حيوية (أسلوب نشيط) / حيوية, نشاط (خاصية القدرة على البقاء والنمو) / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية) / حيوية, طاقة (قدرة صحية على النشاط القوي)\nمثال: حيوية البذرة",
 "活力説": "حيوية ((فلسفة) مذهب يرى أن الحياة مبدأ حيوي متميز عن الفيزياء والكيمياء)",
 "活動": "نَشَاط / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "活動休止": "فُرْجَة",
 "活動写真": "فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "活動力": "طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "活動基準原価計算": "أبجدية, ألفباء (مجموعة رموز تتضمن حروفاً وتُستخدم لكتابة لغة ما)",
 "活動家": "نَاشِط, نَاشِطَة",
 "活動成果": "تَسَبَّب / نَتِيجَة",
 "活動的": "نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور.",
 "活動者": "نَاشِط, نَاشِطَة",
 "活動詞": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو الضرورة)",
 "活動過剰": "فرط النشاط (حالة تتميز بالأرق المفرط والحركة الزائدة)",
 "活動過多": "فرط النشاط (حالة تتميز بالأرق المفرط والحركة الزائدة)",
 "活動電位": "جهد الفعل (تغير الجهد المحلي عبر جدار الخلية أثناء انتقال السيال العصبي)",
 "活塞": "مِدَكّ",
 "活字": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "活字メディア": "الصحافة المطبوعة, وسائل الإعلام المطبوعة (وسيط ينشر المواد المطبوعة)",
 "活字体": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / خط, نمط الخط (حجم وأسلوب محدد للحروف ضمن عائلة خطوط معينة)",
 "活字体で書く": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "活字化": "نشر (العمل التجاري لإصدار المواد المطبوعة للبيع أو التوزيع)",
 "活字印刷": "طِبَاعَة, طِبَاعَة الْحَرْفِ",
 "活字媒体": "الصحافة المطبوعة, وسائل الإعلام المطبوعة (وسيط ينشر المواد المطبوعة)",
 "活字書体": "خط, نمط الخط (حجم وأسلوب محدد للحروف ضمن عائلة خطوط معينة)",
 "活弁": "فيلم صامت (فيلم بدون مسار صوتي)",
 "活性": "نَشَاط / نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور.",
 "活性剤": "مُنْشِط",
 "活性化": "إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / تحفيز, تنشيط (فعل استنهاض كائن حي للعمل) / مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل) / تحفيز, تنبيه ((في علم وظائف الأعضاء) تأثير منبه (على الأعصاب أو الأعضاء وما إلى ذلك)) / تفعيل, تنشيط (الجعل نشطاً وفعالاً (مثل القنبلة)) / تفعيل, تنشيط (نشاط التسبب في الحصول على طاقة ونشاط) / تنشيط (تحفيز النشاط في كائن حي أو مادة كيميائية)",
 "活性化エネルギー": "طاقة التنشيط (الطاقة التي يجب أن يكتسبها نظام ذري قبل أن تحدث عملية (مثل الانبعاث أو التفاعل))\nمثال: يقال إن المحفزات تقلل من طاقة التنشيط أثناء المرحلة الانتقالية للتفاعل",
 "活性炭": "فحم منشط, كربون نشط (مسحوق أو حبيبات الكربون تستخدم للتنقية عن طريق الامتزاز؛ يُعطى عن طريق الفم (كطين سائل) ليكون ترياقاً لبعض أنواع السموم)",
 "活性炭フィルター": "فحم منشط, كربون نشط (مسحوق أو حبيبات الكربون تستخدم للتنقية عن طريق الامتزاز؛ يُعطى عن طريق الفم (كطين سائل) ليكون ترياقاً لبعض أنواع السموم)",
 "活性部位": "موقع نشط (الجزء من الإنزيم أو الجسم المضاد حيث يحدث التفاعل الكيميائي)",
 "活栓": "صِمَام (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "活気": "طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "活気づける": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "活気付ける": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "活気横溢": "فَوَّار, مُتَأَلِّق (يتميّز بروح عالية أو حماسة متّقدة) / فوار ((للسائل) يطلق فقاعات) / غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون)\nمثال: نبيذ فوار",
 "活況": "نَشَاط\nمثال: 株式市場は活況を呈している。 — سوق الأسهم يشهد نشاطاً زائداً.",
 "活版": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "活版所": "مَطْبَعَة",
 "活物寄生": "طُفَيْلِيّ",
 "活用": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل",
 "活用語尾": "علامة إعراب, لاحقة تصريفية (تصريف يضاف في نهاية جذر الكلمة)",
 "活発": "دَجِر",
 "活眼": "نظرة ثاقبة",
 "活線": "شُعْلَة نَشَاط, مُتَحَمِّس (شخص يقظ ونشيط للغاية)",
 "活舌": "تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري",
 "活荷重": "حمل حي (حمل متغير على هيكل (مثل الجسر) مثل حركة المرور المتحركة)",
 "活計": "مَعِيشَة, مَعَاش / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "活路": "مخرج, منفذ (فتحة تسمح بالهروب أو الخروج)\nمثال: أغلق المخرج",
 "活躍": "نَشَاط",
 "活軸": "محور حي, محور دافع (محور مركبة ذاتية الدفع الذي يوفر قوة القيادة)",
 "活辯": "فيلم صامت (فيلم بدون مسار صوتي)",
 "活量": "نَشَاط",
 "派": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني.",
 "派出": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "派川": "تفرع نهري (فرع من نهر يتدفق بعيداً عن المجرى الرئيسي ولا يعود إليه)",
 "派手": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "派手やか": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "派手好き": "مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "派手好み": "مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "派手派手しい": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "派生": "استمداد, اشتقاق (فعل اشتقاق شيء أو الحصول عليه من مصدر أو أصل) / تحويل المسار, سحب (سحب المياه من قناتها الرئيسية كما للري) / اشتقاق, سحب (سحب السوائل أو الالتهاب بعيداً عن جزء مريض من الجسم) / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم)",
 "派生作品": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "派生的": "مشتقّ",
 "派生語": "مشتقّ",
 "派谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "派遣": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "派遣会社": "وَكَالَة تَوْظِيف",
 "派遣労働者": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "派遣団": "تَفْوِيض / بِعْثَة, وَفْد",
 "派遣従業員": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "派遣社員": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "派遣隊": "مَشْرُوْط",
 "派閥": "طُغْمَة, عُصْبَة",
 "派閥均衡": "توازن القوى",
 "流": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل. / تَدَفُّق / تَدَفَّقَ, سَالَ / نَفْي, تَبْعِيد / نَفَى",
 "流々": "إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "流される": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "流し": "غَطَسَ / مَجْلَى, مَغْسَلَة / رِحْلَة بَحْرِيَّة / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / طفو (فعل الشخص الذي يطفو على الماء) / عَائِم, مُتَنَقِّل (يَمِيلُ إِلَى التَّنَقُّلِ مِنْ مَكَانٍ لِآخَر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "流し元": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "流し出す": "نَفِدَ",
 "流し台": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "流し板": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "流し網": "شبكة عائمة (شبكة صيد كبيرة مدعومة بعوامات؛ تنجرف مع التيار)",
 "流し読み": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / تهرب ضريبي بإخفاء الدخل (عدم التصريح عن الدخل لتجنب دفع الضرائب عليه) / قشط (عملية إزالة المواد الطافية من سطح سائل) / تصفح سريع, قراءة سريعة (القراءة أو إلقاء نظرة سريعة)",
 "流し込む": "أَدْخَلَ",
 "流し釣り": "صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "流す": "بَالُوعَة / طَفَا, عَامَ / طَفَا / تَلْفَزَة, إِذَاعَة / أَذَاعَ, بَثَّ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "流ちょう": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "流れ": "تَدَفُّق / تَدَفَّقَ, سَالَ / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / نُزُول / اَصْل / فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "流れつく": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "流れる": "جَدْوَل / تَيَّار / تَدَفّقَ / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني / مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / سهو, غفلة (خطأ ناتج عن عدم الانتباه) / انقضاء, فترة انقطاع (استراحة أو توقف في حدوث شيء ما)\nمثال: فترة انقطاع لمدة ثلاثة أسابيع بين الرسائل",
 "流れ図": "مخطط انسيابي, مخطط تدفق (رسم تخطيطي لتسلسل العمليات في برنامج كمبيوتر أو نظام محاسبي)",
 "流れ星": "شِهَاب / سَعِيرَا",
 "流れ木": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "流れ物": "انجراف (انحراف (سفينة أو طائرة) عن مسارها المقصود بسبب الانجراف)",
 "流れ着く": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "流れ者": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "流丐": "سَائِل / فَقِير",
 "流亡": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / انجراف التربة (جرف التربة عن طريق تدفق المياه)",
 "流人": "نَفْي, تَبْعِيد / نَفَى / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "流体": "سَائِل, مَائِع",
 "流体力学": "ميكانيكا الموائع, هيدروليكا (دراسة ميكانيكا السوائل)",
 "流儀": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "流入": "تدفق داخلي (عملية التدفق إلى الداخل)",
 "流出": "تسرب, نضوح (خروج سائل من حاوية ما) / عين, نبع (تدفق طبيعي للمياه الجوفية) / تدفق خارجي (عملية التدفق إلى الخارج)\nمثال: حاولوا وقف تسرب الغاز من الأنبوب التالف",
 "流刑": "نَفْي, تَبْعِيد / نَفَى",
 "流刑地": "مستعمرة عقابية, منفى (مؤسسة عقابية يتم فيها نفي السجناء (غالباً ما تقع في جزيرة يصعب الهروب منها))",
 "流刑者": "مطرود, مُبعَد (شخص يُطرد من وطنه أو بلده بأمر من السلطة)",
 "流動": "تَدَفُّق / تَدَفَّقَ, سَالَ",
 "流動体": "سَائِل, مَائِع",
 "流動性": "سُيُولَة (توفر النقد أو سهولة التحويل إلى نقد؛ القدرة على سداد الديون) / سيولة (خاصية التدفق بسهولة) / حالة سائلة, سائل (الحالة التي تظهر فيها المادة استعداداً مميزاً للتدفق مع ميل ضئيل أو معدوم للتشتت وعدم قابلية للانضغاط عالية نسبياً)\nمثال: إضافة الرصاص تجعل السبيكة أسهل في السكب لأن درجة الانصهار تنخفض وتزداد السيولة / انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب / حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
 "流動物": "سَائِل, مَائِع",
 "流動的": "سَائِل, مَائِع",
 "流動資産": "أصول سائلة, أصول متداولة (أصول في شكل نقد (أو قابلة للتحويل بسهولة إلى نقد))",
 "流域": "حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج)\nمثال: التحكم في الفيضانات في حوض ميسوري",
 "流域治水": "حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج)\nمثال: التحكم في الفيضانات في حوض ميسوري",
 "流川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "流布": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "流感": "إِنْفْلُوَنْزَا\nمثال: 流感の予防ワクチンの注射をした。 — طُعِّمتُ من الإنفلونزا.",
 "流星": "شِهَاب",
 "流星体": "نَيْزَك",
 "流星塵": "نَيْزَك دَقِيق (حجر نيزكي أو نيزك صغير جداً لدرجة أنه ينجرف إلى الأرض دون أن يسخن بشدة في الغلاف الجوي)",
 "流星物質": "نَيْزَك",
 "流星群": "سِرْب نَيَازِك (مجموعة من النيازك ذات مسارات متشابهة)",
 "流星雨": "زخة شهب, وابل شهبي (تساقط عابر للشهب عندما يدخل سرب من الشهب الغلاف الجوي للأرض)",
 "流暢": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "流木": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "流束": "تغير مستمر, تقلب (في تغيير مستمر) / كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة) / تدفق, سيلان (جريان أو تصريف) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)\nمثال: آراؤه في تقلب مستمر",
 "流民": "لَاجِئ, لَاجِئَة",
 "流氓": "لَاجِئ, لَاجِئَة",
 "流水": "جَدْوَل / تَيَّار / تَدَفّقَ",
 "流氷": "جليد طافٍ (كتل من الجليد تطفو في البحر المفتوح)",
 "流氷野": "حقل جليدي (كتلة مسطحة كبيرة من الجليد (أكبر من الطوف الجليدي) تطفو في البحر)",
 "流汗": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "流沙": "رِمَال مُتَحَرِّكَة",
 "流派": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "流流": "إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "流浪": "تسكع, تشرد (حالة التجوال من مكان إلى آخر؛ عدم وجود منزل دائم أو وسيلة للعيش)",
 "流浪人": "هَائِم",
 "流浪者": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "流涎": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "流涕": "بَاكٍ / بُكَاء",
 "流涙症": "تكرار النهاية, سجع (تكرار نهايات جملتين أو أبيات متتالية أو أكثر)",
 "流産": "إِجْهَاض, إِخْفَاق (أن يموت الجنين في بطن أمه فيسقط؛ تَعمُّد قتل الجنين في بطن الأم)",
 "流用": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي / استخدام, استعمال (فعل الاستخدام) / استخدام, انتفاع (حالة كونه مستخدماً)\nمثال: حذر من استخدام المخدرات",
 "流石": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "流砂": "رِمَال مُتَحَرِّكَة",
 "流竄": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "流紋岩": "ريوليت (صخر بركاني حمضي جداً)",
 "流罪": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "流血": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "流血沙汰": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "流行": "مُودَة, مُوضَة / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "流行っ子": "إِجَّامَة / نَجْمَة",
 "流行り": "مُودَة, مُوضَة / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "流行りっ子": "إِجَّامَة / نَجْمَة",
 "流行りもの": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "流行り物": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "流行り病": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "流行り目": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "流行り言葉": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "流行り風邪": "إِنْفْلُوَنْزَا",
 "流行る": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "流行性": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "流行性感冒": "إِنْفْلُوَنْزَا",
 "流行性耳下腺炎": "التهاب الغدة النكفية الوبائي, نكاف (مرض فيروسي معد حاد يتميز بالحمى وتورم الغدد النكفية)",
 "流行性脳炎": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "流行病": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "流行言葉": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "流行語": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "流行遅れ": "خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)",
 "流行風邪": "إِنْفْلُوَنْزَا",
