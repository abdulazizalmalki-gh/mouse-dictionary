 "石礫": "مِقْلَاع / خرطوش, طلقة (قذيفة صلبة تطلق من سلاح ناري) / حبة, كرية (كتلة مستديرة صغيرة من مادة ما)\nمثال: أزت الطلقة بجانب أذنه",
 "石積み": "أعمال البناء, بناء (حرفة البناء) / أعمال البناء, بناء حجري (هيكل مبني من الحجر أو الطوب بواسطة بناء) / الماسونية (الماسونيون مجتمعين)",
 "石突": "جلبة, طوق معدني (غطاء معدني أو طوق يوضع على عمود خشبي لمنع تشققه)",
 "石突き": "جلبة, طوق معدني (غطاء معدني أو طوق يوضع على عمود خشبي لمنع تشققه)",
 "石窟": "كهف كبير, مغارة (كهف كبير أو غرفة كبيرة داخل كهف) / كهف, مغارة (أي مساحة مغلقة مظلمة وكبيرة)\nمثال: كانت عيناه كهوفاً مظلمة",
 "石窯ピザ": "يَعْمَل بِالحَطَب (يُشغَّل بحرق الخشب)",
 "石竜": "سِحْلِيَّة, ضَبّ",
 "石竹": "قرنفل صيني, قرنفل قوس قزح (قرنفل صيني بزهور وردية ليلكية مسننة بعمق مع عين أرجوانية؛ يزرع عادة كنبات سنوي)",
 "石笛鯛": "صَغِير الأَسْنَان (ذو أسنان صغيرة)",
 "石筆": "قلم حجر, قلم لوح (قلم من الأردواز الناعم (أو الحجر الصابوني) يستخدم للكتابة على لوح)",
 "石筍": "صاعدة, صواعد الكهوف (أسطوانة من كربونات الكالسيوم تبرز لأعلى من أرضية كهف جيري)",
 "石細工": "أعمال البناء, بناء (حرفة البناء) / أعمال البناء, بناء حجري (هيكل مبني من الحجر أو الطوب بواسطة بناء) / الماسونية (الماسونيون مجتمعين)",
 "石絨": "أَسْبِسْتُوس, أَسْبِسْت",
 "石綿": "أَسْبِسْتُوس, أَسْبِسْت",
 "石綿沈着症": "داء الأسبست, سحار أسبستي (مرض رئوي ناجم عن استنشاق جزيئات الأسبستوس)",
 "石綿症": "داء الأسبست, سحار أسبستي (مرض رئوي ناجم عن استنشاق جزيئات الأسبستوس)",
 "石脳油": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "石膏": "مِلَاط, جِبْس",
 "石膏ボード": "جبس بورد, لوح جصي (لوح جداري بقلب من الجص الجبسي مرتبط بطبقات من الورق أو الألواح الليفية؛ يستخدم بدلاً من الجص أو الألواح الجدارية لعمل الجدران الداخلية)",
 "石臼": "رَحًى (رَحَى: طاحون؛ مؤنثة، جمعها: أرحاء، أرحية، أرح، رَحِيّ، رِحِيّ، رِحًى، وأُرْحِي، ومِثل: رَحْوان ورَحْيان؛ ورَحَى: وَجْ، جمعه أرحاء، بمعنى الصدر)",
 "石英": "مَرْو, كَوَارْتْز",
 "石英ガラス": "زجاج الكوارتز, سيليكا زجاجية (زجاج عديم اللون مصنوع من السيليكا النقية تقريباً)",
 "石英岩": "كوارتزيت (صخر متحول صلب يتكون أساساً من بلورات الكوارتز المتشابكة)",
 "石英砂": "رمل الكوارتز (رمل يتكون أساساً من الكوارتز، يستخدم كمادة خام رئيسية لإنتاج الزجاج التجاري)",
 "石蓴": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل)",
 "石蕗": "ليغولاريا, نبات النمر (أي من النباتات المتنوعة في أوراسيا المعتدلة؛ تزرع لزهورها الصفراء وأوراقها الجميلة)",
 "石蚕": "ذباب كاديس, ذبابة القمص (حشرة صغيرة تشبه العثة لها زوجان من الأجنحة الغشائية المشعرة ويرقات مائية)",
 "石蝋": "زيت الكاز, كيروسين ((الاستخدام البريطاني) الكيروسين) / ألكان, برافين / شمع البارافين (من البترول الخام؛ يُستخدم للشموع وللطبقات الحافظة أو المقاومة للماء)",
 "石蟹": "سرطان الحجر (سرطان كبير صالح للأكل من الساحل الجنوبي للولايات المتحدة (خاصة فلوريدا)) / سلطعون حجري (لحم شاحب ذو ملمس ونكهة دقيقة؛ يوجد في فلوريدا ولكنه الآن نادر جداً)",
 "石製": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "石質": "حَجَرِيّ, صَخْرِيّ (شَبيه بالصَّخْر أو الغْرانِيت في الصَّلابَة) / عَنيد, غَليظ (شَديد القَسْوَة وعَديم الرَّحْمَة؛ لا يَرِقّ قَلْبُه) / حَجَرِيّ, صَخْرِيّ (مليء بالصخور أو الأحجار)",
 "石造": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "石造り": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "石頭": "عِنَاد",
 "石首魚": "كرواكر أبيض (سمكة طعام بحرية فضية صغيرة توجد قبالة كاليفورنيا) / السمكة الملكة, كرواكر أبيض (سمكة طبل فضية ومائلة للزرقة في المياه الساحلية الضحلة لكاليفورنيا)",
 "石高": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "石鹸": "صَابُون, صابونة",
 "石鹸の泡": "رغوة الصابون (الرغوة التي ينتجها الصابون أو المنظفات)",
 "石鹸玉": "فُقَّاعَةُ صَابُون",
 "石鹸石": "حجر صابوني, ستيتيت (نوع مضغوط ثقيل وناعم من التلك ذو ملمس صابوني؛ يستخدم لصنع المواقد وأسطح الطاولات والزخارف)",
 "石鹸草": "غَاسُول, شِرْش الْحَلاوَة",
 "石黄": "رَهَج أَصْفَر",
 "石鼈": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية) / خيتون (سترة صوفية ارتداها الرجال والنساء في اليونان القديمة)",
 "石龍": "سِحْلِيَّة, ضَبّ",
 "砂": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "砂かぶり": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "砂かぶり席": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "砂ぎも": "قَانِصَة",
 "砂じんあらし": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "砂じん嵐": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "砂のう": "قَانِصَة / كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن)",
 "砂ぼこり": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "砂をかむよう": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة)",
 "砂を噛むよう": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة)",
 "砂を噛む様": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة)",
 "砂上の楼閣": "بَيْت مِنْ وَرَق (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "砂丘": "كثيب, كثيب رملي (سلسلة من الرمال كونتها الرياح؛ توجد في الصحاري أو بالقرب من البحيرات والمحيطات)",
 "砂利": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "砂利敷き": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "砂原": "صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة ولا حياة فيها؛ الصَّحْرَاءُ : الأرضُ المُسْتَوِيةُ في لِينٍ وغِلَظٍ دُونَ القُفِّ) / صحرة / صحرا / بَرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / فَرَّ / جَزاء\nمثال: عاد إلى الصحراء.",
 "砂吹き": "تيار رملي, سفح رملي (هبة رياح محملة بالرمال)",
 "砂嘴": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "砂嚢": "كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن) / قَانِصَة / قَانِصَة / كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن)",
 "砂土": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "砂埃": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "砂堆": "ضفة رملية (ضفة مغمورة من الرمال بالقرب من الشاطئ أو في النهر؛ يمكن أن تنكشف عند الجزر المنخفض)",
 "砂場": "صندوق الرمل (لعبة تتكون من كومة من الرمل أو صندوق مملوء بالرمل ليلعب فيه الأطفال) / حفرة رملية (حفرة كبيرة في أرض رملية يُستخرج منها الرمل)",
 "砂塵": "عَاصِفَة رَمْلِيَّة",
 "砂塵嵐": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "砂子": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل. / تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في التعدين الغريني) / رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "砂山": "كَثِيب, غُرْد",
 "砂岩": "حَجَر رَمْلِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "砂嵐": "عَاصِفَة رَمْلِيَّة / ضَوْضَاء, ضَجِيج",
 "砂州": "ضحضاح ماء",
 "砂時計": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "砂洲": "ضحضاح ماء",
 "砂消しゴム": "ممحاة حبر (ممحاة تزيل علامات الحبر)",
 "砂漏": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "砂漠": "صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة ولا حياة فيها؛ الصَّحْرَاءُ : الأرضُ المُسْتَوِيةُ في لِينٍ وغِلَظٍ دُونَ القُفِّ) / صحرة / صحرا / بَرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / فَرَّ / جَزاء\nمثال: عاد إلى الصحراء.",
 "砂漠化": "تَصَحُّر",
 "砂猫": "قط الرمال (قط بري صحراوي)",
 "砂石": "حَصَاة",
 "砂礫": "حَصَاة",
 "砂糖": "سُكَّر (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "砂糖いれ": "سُكَّرِيَّة",
 "砂糖にんじん": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "砂糖の衣": "تغليفة سكرية, كريمة التزيين (طبقة سكرية مُنكهة تُستخدم لتغطية وتزيين الكعك)",
 "砂糖人参": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "砂糖入れ": "سُكَّرِيَّة",
 "砂糖大根": "شَمَنْدَر اَلسُّكَّر",
 "砂糖椰子": "غوموتي, نخيل السكر (نخيل ريشي ماليزي قاعدته مغطاة بكثافة بالألياف؛ ينتج عصارة حلوة تستخدم في النبيذ ولب الجذع ينتج الساغو)",
 "砂糖楓": "قيقب سكري, قيقب صخري (قيقب من شرق ووسط أمريكا الشمالية له أوراق ثلاثية إلى خماسية الفصوص وخشب صلب متقارب الحبيبات يستخدم كثيراً في أعمال الخزائن خاصة الشكل المجعد…)",
 "砂糖煮": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "砂糖菓子": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "砂糖蜀黍": "سورغم حلو, سورغو (أي من عدة أنواع من السورغم تزرع كمصدر للشراب)",
 "砂糖蜜": "شَرَاب, قَطْر",
 "砂糖衣": "تغليفة سكرية, كريمة التزيين (طبقة سكرية مُنكهة تُستخدم لتغطية وتزيين الكعك)",
 "砂紋": "علامة تموج (واحدة من سلسلة من الحواف الصغيرة الناتجة في الرمال بواسطة التيارات المائية أو الرياح)",
 "砂紙": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "砂肝": "قَانِصَة",
 "砂色": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "砂蚤": "برغوث الرمل, شيغوة (برغوث استوائي صغير؛ تحفر الأنثى المخصبة تحت جلد العائل بما في ذلك البشر)",
 "砂袋": "كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن) / قَانِصَة",
 "砂被り": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "砂金": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في التعدين الغريني)",
 "砂金石": "أفينتورين, حجر الشمس (كوارتز نصف شفاف مرصع بقطع صغيرة من الميكا أو معادن أخرى)",
 "砂鉢": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق الدوران بينما تتبع إبرة الفونوغراف الأخدود) / طبق تقديم كبير (طبق كبير ضحل يستخدم لتقديم الطعام)",
 "砂鉱": "راسب غريني معدني (رواسب طميية تحتوي على جزيئات من معادن ثمينة)",
 "砂鉱床": "راسب غريني معدني (رواسب طميية تحتوي على جزيئات من معادن ثمينة)",
 "砌": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "砒化水素": "أرسين, زرنيخيد الهيدروجين (غاز سام عديم اللون وقابل للاشتعال يستخدم في التركيب العضوي ولتطعيم الترانزستورات وكغاز سام في الحروب)",
 "砒化物": "زرنيخيد (مركب من الزرنيخ مع عنصر أكثر إيجابية)",
 "砒素剤": "زرنيخي (يتعلق بـ أو يحتوي على الزرنيخ) / زرنيخي, مركب زرنيخي (مبيد آفات أو دواء يحتوي على الزرنيخ)\nمثال: بخار زرنيخي",
 "砒酸": "حمض الزرنيخيك (حمض يتكون من خماسي أكسيد الزرنيخ)",
 "砒酸鉛": "زرنيخات الرصاص",
 "研": "بَحْث, تَحْقِيق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "研き": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / تَحْسِين",
 "研ぎ": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "研ぎすます": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "研ぎ上げ": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ)",
 "研ぎ屋": "آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح)",
 "研ぎ師": "آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح)",
 "研ぎ澄ます": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "研ぎ物": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "研ぎ物師": "آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح)",
 "研ぎ石": "مِسَنّ, مِجْلَخَة",
 "研ぐ": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / غَسَلَ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي. / مجرف, مكان محفور (مكان تم حفره (خاصة بالمياه الجارية))",
 "研修": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "研修会": "مَشْغَل, وَرْشَة",
 "研修制度": "برنامج تدريبي (برنامج مصمم للتدريب على مهارات محددة)",
 "研修医": "طبيب امتياز (طالب متقدم أو خريج طب يكتسب خبرة عملية تحت الإشراف)",
 "研修員": "مُتَدَرِّب, مُتَدَرِّبَة",
 "研修期間": "إقامة طبية, نيابة طبية (منصب الطبيب الذي يتلقى تدريباً خاصاً في مستشفى (عادة بعد إكمال فترة الامتياز)) / إقامة, سكن (فعل السكن في مكان ما)",
 "研修生": "مُتَدَرِّب, مُتَدَرِّبَة",
 "研削": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "研削盤": "آلة تجليخ, جلاخة (أداة آلية تلمع المعدن) / طاحونة, مطحنة (آلات تعالج المواد عن طريق الطحن أو السحق) / رحى, ضرس (سن طاحنة ذات تاج عريض؛ تقع خلف الضواحك) / سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "研学": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "研屋": "آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح)",
 "研師": "آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح)",
 "研澄ます": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "研物": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "研物師": "آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح)",
 "研磨": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف / تكرير, تنقية (عملية إزالة الشوائب (كما هو الحال من الزيت أو المعادن أو السكر، إلخ))",
 "研磨仕上げ": "تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "研磨剤": "أداة سحج, ساحِج (أداة أو آلة تستخدم لحك أو تنعيم أو تلميع الأسطح) / كاشط, مادة كاشطة (مادة تكشط أو تبري)",
 "研磨材": "خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / خَادِش, كَاشِط (يسبّب الحكّ والسحج) / كاشط, مادة كاشطة (مادة تكشط أو تبري)",
 "研磨機": "آلة تجليخ, جلاخة (أداة آلية تلمع المعدن) / طاحونة, مطحنة (آلات تعالج المواد عن طريق الطحن أو السحق) / رحى, ضرس (سن طاحنة ذات تاج عريض؛ تقع خلف الضواحك) / سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "研磨紙": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "研究": "بَحْث, تَحْقِيق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "研究休暇": "تفرغي (من أو متعلق بإجازة التفرغ) / سبتي (من أو متعلق بيوم السبت (يوم الراحة)) / إجازة تفرغ (إجازة تؤخذ عادة كل سبع سنوات (خاصة للأكاديميين))\nمثال: مشروع بحث التفرغ",
 "研究会": "نَدْوَة",
 "研究分担者": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "研究員": "بَاحِث, بَاحِثَة (كَلَّم أو حَدَّث في أمر مهم؛ حَاوَرَ وجَادَلَ ونَاقَشَ، لإيجاد حلّ ما أو شيء)\nمثال: مزيان باحث في ميدان الأمراض القلبية.",
 "研究室": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة) / مُخْتَبَر, مَعْمَل",
 "研究家": "بَاحِث, بَاحِثَة (كَلَّم أو حَدَّث في أمر مهم؛ حَاوَرَ وجَادَلَ ونَاقَشَ، لإيجاد حلّ ما أو شيء)\nمثال: مزيان باحث في ميدان الأمراض القلبية.",
 "研究所": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة) / مُخْتَبَر, مَعْمَل",
 "研究施設": "مركز أبحاث (مركز يتم فيه إجراء الأبحاث)",
 "研究書": "دراسة مفردة, مونوجراف (أطروحة مفصلة وموثقة حول موضوع معين)",
 "研究社新和英大辞典": "بانجو, عشب (أسماء دارجة للماريجوانا)",
 "研究科": "كلية الدراسات العليا (مدرسة في جامعة تقدم دراسة تؤدي إلى درجات علمية تتجاوز درجة البكالوريوس)",
 "研究結果": "لوازم, مستلزمات (مجموعة من الأدوات والمواد الأخرى التي يستخدمها الحرفي لصنع المجوهرات أو الملابس أو الأحذية)",
 "研究者": "بَاحِث, بَاحِثَة (كَلَّم أو حَدَّث في أمر مهم؛ حَاوَرَ وجَادَلَ ونَاقَشَ، لإيجاد حلّ ما أو شيء)\nمثال: مزيان باحث في ميدان الأمراض القلبية.",
 "研究職": "بَاحِث, بَاحِثَة (كَلَّم أو حَدَّث في أمر مهم؛ حَاوَرَ وجَادَلَ ونَاقَشَ، لإيجاد حلّ ما أو شيء)\nمثال: مزيان باحث في ميدان الأمراض القلبية.",
 "研究論文": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "研究責任者": "باحث رئيسي (العالم المسؤول عن تجربة أو مشروع بحثي)",
 "研練": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "研錬": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "砕く": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "砕け": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه / نَتِيجَة",
 "砕けた": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "砕ける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "砕け波": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد) / تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ) / كاسر الحجارة (عامل محجر يكسر كتل الحجر)",
 "砕屑": "قَابِل لِلتَّفْكِيك (يمكن تفكيكه إلى أجزاء منفصلة) / فُتَاتِيّ, كَلَاسْتِيكِيّ (ينتمي إلى صخور مكوّنة من شظايا صخور أقدم)",
 "砕屑岩": "صَخْر فُتَاتِيّ ((جيولوجيا) صخر يتكون من قطع مكسورة من صخور أقدم)",
 "砕屑物": "فتات الصخور (مادة مفككة (شظايا حجرية وطمي وما إلى ذلك) ناتجة عن تآكل الصخور) / حطام, ركام (بقايا شيء تم تدميره أو تفتيته)",
 "砕氷船": "كَسَّارَةْ جَلِيد",
 "砕氷艦": "كَسَّارَةْ جَلِيد",
 "砕波": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد) / تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ) / كاسر الحجارة (عامل محجر يكسر كتل الحجر)",
 "砕片": "رُكام (الشيء المُتَرَاكِم بعضه فوق بعضٍ مثل السحاب والرمل والحجر وما أشبههُ؛ وقطيعٌ رُكَامٌ أي ضخم)",
 "砕石": "رصف (رصف بطبقة من حجر المكدام) / طريق معبد بالقار, مكادام (سطح مرصوف يحتوي على طبقات مضغوطة من الصخور المكسرة متماسكة مع القطران) / مكدام (حجر مكسر يستخدم في الطرق المعبدة بطريقة ماك آدم)\nمثال: رصف الطريق / سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "砕鉱機": "طاحونة تكسير, طاحونة ركاز (طاحونة يتم فيها سحق الخام بالمطارق)",
 "砕骨器": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "砥": "مِسَنّ, مِجْلَخَة",
 "砥ぐ": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / غَسَلَ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي. / مجرف, مكان محفور (مكان تم حفره (خاصة بالمياه الجارية))",
 "砥石": "مِسَنّ, مِجْلَخَة",
 "砥草": "ذيل الحصان الخشن, كنباث شتوي (ذيل حصان منتصب دائم الخضرة بسيقان خشنة الحواف؛ كان يستخدم سابقاً لتنظيف الأواني)",
 "砦": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "砧木": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / طَابُوقَة",
 "砧骨": "سندان (عظم صغير في الأذن الوسطى يقع بين المطرقة والركاب)",
 "砲": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "砲丸": "كرة مدفع (مقذوف صلب كان يُطلق في العصور القديمة من مدفع) / طَلَقَة, طَلَق / رَمْيَة / لَقْطَة / حُقْنَة, حَقْن",
 "砲丸投": "رَمْيُ الجُلَّة",
 "砲丸投げ": "رَمْيُ الجُلَّة",
 "砲兵": "مِدْفَعِيّة",
 "砲列": "ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "砲列甲板": "سطح المدافع (سابقاً أي سطح غير السطح المكشوف يحتوي على مدافع من أوله لآخره)",
 "砲口": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "砲台": "ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "砲塔": "برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران)",
 "砲弾": "صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة.",
 "砲手": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية) / رامي, مسلح (شخص يطلق النار بمسدس (فيما يتعلق بقدرته))",
 "砲撃": "بومباردون (مزمار كبير؛ عضو الباس في عائلة المزمار)",
 "砲架": "كُرْسِيّ, قَنْدَاق (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "砲火": "إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر",
 "砲熕": "مِدْفَعِيّة",
 "砲艦": "زَوْرَق مِدْفَعِيَّة",
 "砲艦外交": "دبلوماسية الزوارق الحربية, سياسة القوة (دبلوماسية تهدد فيها الدول باستخدام القوة لتحقيق أهدافها)",
 "砲術": "المدفعية, علم المدفعية (المدافع مجتمعة)",
 "砲術家": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية) / رامي, مسلح (شخص يطلق النار بمسدس (فيما يتعلق بقدرته))",
 "砲身": "سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح)",
 "砲車": "كُرْسِيّ, قَنْدَاق (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "砲門": "مَزْغَل",
 "破く": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "破ける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "破たん": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "破る": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق. / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "破れ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به) / تلف, فساد (عملية التحول إلى شيء تالف أو فاسد) / الفاسد, تلف (الكمية التي فسدت)\nمثال: كان إفسادها لثوبي متعمداً",
 "破れかぶれ": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "破れる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / انفصل / مِشْبَك / كْلِيبْ / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "破れ目": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "破倫": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "破傷風": "كُزَاز, كُزَّاز",
 "破傷風抗毒素": "مضاد ذيفان التيتانوس (مضاد ذيفان يُعطى للتحصين قصير المدى ضد التيتانوس في حالات التعرض المحتمل لعصيات التيتانوس)",
 "破却": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "破城槌": "كبش ضارب (كبش يستخدم لكسر أبواب المباني المحصنة)",
 "破壊": "تَدْمِير, هَدْم / حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "破壊分子": "تَخْرِيبِيّ, مُتَمَرِّد (مُعَارِض لِسُلْطَة مَدَنِيَّة أَوْ حُكُومَة) / ثوري (مؤيد راديكالي للثورة السياسية أو الاجتماعية)",
 "破壊工作": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "破壊措置命令": "إرداء بالرصاص (القتل بإطلاق النار على شخص بدم بارد)",
 "破壊活動": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها)",
 "破壊的": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "破壊者": "مُدَمِّر",
 "破天荒": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل) / جَرِيء, جَسُور",
 "破婚": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "破局": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "破廉恥": "وَقِح, صَفِيق",
 "破廉恥漢": "أَعْرَج",
 "破恋": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "破折": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "破損": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "破擦音": "صَامِت مَوْقُوف اِحْتِكَاكِيّ, صَامِت مَزْجِيّ",
 "破断": "تَمَزُّق",
 "破格": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ / شَاذّ, غَيْر مُنْتَظِم",
 "破棄": "تَدْمِير, هَدْم / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / إبطال, فسخ ((في القانون) إنهاء رسمي (لعلاقة أو إجراء قضائي ونحوه)) / إبطال, إلغاء (حالة كونه ملغى أو مبطلاً) / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية",
 "破殻": "روبيان الهيكل العظمي (قشري صغير من مزدوجات الأرجل له شكل غريب يوحي بفرس النبي؛ يوجد بشكل رئيسي على الأعشاب البحرية)",
 "破滅": "خَرَاب, خَرَابَة / دَمَّرَ",
 "破滅的": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "破片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "破牢": "هروب من السجن (هروب من السجن) / كسر الحماية (إزالة أقفال الأمان من جهاز إلكتروني)\nمثال: تم التخطيط للهروب بعناية",
 "破瓜": "بلوغ (وقت الحياة الذي تصبح فيه الغدد الجنسية وظيفية) / اِفْتَضَّ, تَصَرُّف",
 "破瓜期": "بُلُوغ",
 "破瓜病": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب والتصرفات الطفولية والسلوك الغريب؛ وعادة ما يتضح خلال فترة البلوغ؛ وهو الفئة…)",
 "破産": "إِفْلَاس",
 "破産寸前": "مُتَرَاصّ, مُتَلَاصِق ((عَنْ حَرَكَة المُرُور) مُتَلَاصِق سَيَّارَة بِسَيَّارَة بِسَبَب الازْدِحَام)",
 "破目": "عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "破砕": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "破砕性": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف) / قابل للكسر (صنف هش وسهل الكسر)\nمثال: الفخار الخزفي قابل للكسر",
 "破砕機": "ساحقة, كسارة (جهاز يقوم بسحق شيء ما)",
 "破竹": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "破算": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "破約": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "破綻": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "破綻をきたす": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "破綻を来す": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "破船": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "破落戸": "أفاق, محتال (شخص مخادع ولا يمكن الوثوق به) / بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "破裂": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / تَوَزُّع",
 "破談": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "破過": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "破鏡": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "破門": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد) / حِرْمَان كَنَسِيّ",
 "破面": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "破風": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون)",
 "破骨細胞": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "破魔": "رُقْيَة",
 "硅石": "ثاني أكسيد السيليكون, سيليكا",
 "硅砂": "رمل الكوارتز (رمل يتكون أساساً من الكوارتز، يستخدم كمادة خام رئيسية لإنتاج الزجاج التجاري)",
 "硅肺": "سَحَار سِيلِيسِيّ",
 "硝化": "نترجة (أكسدة مركبات الأمونيوم في المواد العضوية الميتة إلى نترات ونيتريت بواسطة بكتيريا التربة (مما يجعل النيتروجين متاحاً للنباتات)) / نترتة (العملية الكيميائية التي تضاف فيها مجموعة نيترو إلى مركب عضوي (أو تحل محل مجموعة أخرى في مركب عضوي))",
 "硝化綿": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "硝子": "زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟",
 "硝子体": "جسم زجاجي, خلط زجاجي (الهلام الشفاف عديم اللون الذي يملأ الغرفة الخلفية لمقلة العين)",
 "硝子屋": "زجّاج, قاطع الزجاج (شخص يقطع الزجاج المسطح حسب المقاس)",
 "硝子細工": "أواني زجاجية (صنف من أدوات المائدة مصنوع من الزجاج)",
 "硝子軟骨": "غضروف زجاجي (غضروف شفاف شائع في المفاصل والممرات التنفسية؛ يشكل معظم الهيكل العظمي للجنين)",
 "硝安": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "硝煙反応": "استجابة الجلد الجلفانية (تغير في الخصائص الكهربائية للجلد استجابة للتوتر أو القلق)",
 "硝石": "ملح البارود, نترات البوتاسيوم",
 "硝薬": "بَارُود",
 "硝酸": "حمض النتريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "硝酸アンモニウム": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "硝酸ウラニル": "نترات اليورانيل (ملح أصفر يتم الحصول عليه عن طريق تفاعل أملاح اليورانيوم مع حمض النيتريك)",
 "硝酸エステル": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "硝酸カリウム": "ملح البارود, نترات البوتاسيوم",
 "硝酸カルシウム": "نترات الكالسيوم (ملح متميع قابل للذوبان في الماء؛ يستخدم أحياناً كمصدر للنيتروجين في الأسمدة)",
 "硝酸セルロース": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "硝酸ナトリウム": "نترات الصوديوم",
 "硝酸塩": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "硝酸繊維素": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "硝酸銀": "نترات الفضة (نترات تستخدم في صنع المستحلبات الفوتوغرافية؛ وتستخدم أيضاً في الطب للكي وكعامل مضاد للبكتيريا موضعي)",
 "硫化カドミウム": "كبريتيد الكادميوم (كبريتيد أصفر يستخدم بشكل رئيسي كصبغة)",
 "硫化亜鉛": "كبريتيد الخارصين, كبريتيد الزنك (مركب بلوري متفسفر أصفر إلى أبيض يوجد طبيعياً في السفاليريت أو الفورتزيت ويستخدم كصبغة مضيئة)",
 "硫化水素": "كبريتيد الهيدروجين (كبريتيد له رائحة كريهة تشبه رائحة البيض الفاسد)",
 "硫化物": "كبريتيد (مركب من الكبريت وعنصر آخر أكثر إيجابية كهربائية)",
 "硫化鉄鉱": "بيريت (أي من الكبريتيدات ذات المظهر المعدني المختلفة (ويعتبر البيريت أكثرها شيوعاً))",
 "硫砒鉄鉱": "أرسينوبيريت (خام الزرنيخ ذو لون أبيض فضي أو رمادي)",
 "硫酸": "حمض الكبريتيك, زاج (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "硫酸エステル": "كبريتات (ملح أو إستر لحمض الكبريتيك)",
 "硫酸カルシウム": "كبريتات الكالسيوم",
 "硫酸ナトリウム": "كبريتات الصوديوم (ملح أبيض مر صلب يستخدم في تصنيع الزجاج والورق والأصباغ والمستحضرات الصيدلانية)",
 "硫酸バリウム": "كبريتات الباريوم (مسحوق أبيض غير قابل للذوبان وغير منفذ للأشعة يستخدم كصبغة)",
 "硫酸マグネシウム": "كبريتات المغنيسيوم (ملح للمغنيسيوم)",
 "硫酸亜鉛": "كبريتات الزنك (مسحوق عديم اللون قابل للذوبان في الماء؛ يستخدم كمثبت للون أو لحفظ الخشب أو للترسيب الكهربائي للزنك)",
 "硫酸塩": "كبريتات (ملح أو إستر لحمض الكبريتيك)",
 "硫酸銅": "سُلْفَات اَلنُّحَاس",
 "硫銀鉱": "أرجنتيت",
 "硫銅鉱": "كالكوسيت (معدن رمادي ثقيل يعد خاماً للنحاس)",
 "硫黄": "كِبْرِيتِيّ",
 "硫黄山": "منجم كبريت (منجم يُستخرج منه الكبريت من الأرض)",
 "硫黄酸化物": "أكسيد الكبريت (أي من أكاسيد الكبريت المتعددة)",
 "硬": "شدة, صرامة (صرامة مفرطة) / صعوبة, وعورة (صفة الصعوبة في القيام بالشيء) / تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب) / عسارة, عسر الماء (صفة للمياه التي تحتوي على أملاح معدنية مذابة تمنع الصابون من تكوين رغوة)\nمثال: صرامة الشخصية",
 "硬い": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "硬さ": "ثَبَات",
 "硬し": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
