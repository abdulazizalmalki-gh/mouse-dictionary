 "河上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河伯": "كَبَا",
 "河内": "هَانُوي",
 "河北": "خِبِي, خِيبِي",
 "河南": "خِنَان, خِينَان",
 "河原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河原乞食": "مُمَثِّل, مُمَثِّلَة",
 "河原撫子": "قرنفل رائع, قرنفل مهدب (قرنفل أوراسي معمر ذو زهور ليلكية أو وردية عطرة بحواف مهدبة بعمق)",
 "河原木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河原母子": "أناغاليس لؤلؤي (نبات خالد أمريكي له أوراق بشعيرات صوفية ناعمة ورؤوس عذقية بقنابات بيضاء لؤلؤية)",
 "河原者": "فنان ترفيهي, مُؤنِس (شخص يحاول إمتاع الناس أو تسليتهم)",
 "河原藤木": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في…)",
 "河原鳩": "حَمَام طُورَانِيّ, حَمَام أَزْرَق (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)",
 "河口": "مَصَبّ, فُغْرَة",
 "河合": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河太郎": "كَبَا",
 "河岸": "ضفة النهر / ضفة النهر / مَيْدَان\nمثال: هذا المكان مقدس",
 "河崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河川": "نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ…)\nمثال: عبر جوناس النهر.",
 "河川敷": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "河床": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "河底": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "河心": "منتصف النهر, وسط المجرى (الجزء الأوسط من مجرى النهر)",
 "河本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河水": "جَدْوَل",
 "河沿い": "ضفة النهر",
 "河流": "جَدْوَل",
 "河海豚": "دلفين نهري (أي من عدة دلافين طويلة الخطم تعيش عادة في المياه العذبة في أمريكا الجنوبية…)",
 "河渠": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "河漢": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "河獺": "قُضَاعَة\nمثال: أردى الصياد الثعلب.",
 "河田": "إِتَا",
 "河畔": "ضفة النهر",
 "河童": "كَبَا / خِيَار (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "河童の屁": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "河端": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河竹": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق…) / دَاعِرَة, بَغِيَّة",
 "河西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河豚": "فوغو (سمكة منتفخة تحظى بتقدير كبير كطعام شهي في اليابان ولكنها خطيرة جداً لأن الجلد…)",
 "河跡湖": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة…)",
 "河身": "قَنَاة",
 "河辺": "ضفة النهر",
 "河郎": "كَبَا",
 "河野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "河馬": "فَرَس نَهْر (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "河鱒": "تروتة الجدول (تروتة المياه العذبة في أمريكا الشمالية؛ أُدخلت إلى أوروبا)",
 "沸々": "غليان هادئ (درجة حرارة أقل بقليل من نقطة الغليان)\nمثال: بقي الحساء يغلي بهدوء لساعات",
 "沸かし器": "إناء مزخرف, جرة كبيرة (مزهرية كبيرة عادة ما يكون لها قاعدة أو أرجل)",
 "沸かし湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
