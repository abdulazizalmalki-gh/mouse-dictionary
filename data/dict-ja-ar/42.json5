 "永里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "永野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "永阪": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "氾濫": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "氾濫原": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "汀": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ. / شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "汀段": "كتف الطريق (حافة ضيقة من الأرض (غير معبدة عادة) على طول جانب الطريق)\nمثال: توقفت السيارة على كتف الطريق",
 "汀渚": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "汀線": "خط الساحل, شاطئ (خط الحدود بين اليابسة والماء)",
 "汁": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء)\nمثال: هل مذاق الشوربة جيد؟ / صَلْصَة, مَرَق",
 "汁だく": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "汁吸啄木鳥": "نقار الخشب مصاص العصارة أصفر البطن (نقار خشب مصاص للعصارة من شرق أمريكا الشمالية ذو بطن أصفر شاحب)",
 "汁椀": "زبدية حساء, طبق شوربة (وعاء لتقديم الحساء)",
 "汁気": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "汁液": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "汁物": "شُورَبَة (في : هي الحَسَاء)\nمثال: هل مذاق الشوربة جيد؟",
 "求む": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "求むる": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "求め": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "求める": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء\nمثال: اشترى زيري ذلك.",
 "求人": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة))",
 "求人広告": "إِعْلَان طَلَب, إِعْلَان مَطْلُوب (إعلان صحفي يذكر ما هو مطلوب)",
 "求人者": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "求刑": "وَصَّى, أَوْصَى",
 "求婚": "طَلَب زَوَاج, عَرْض زَوَاج (عرض للزواج)",
 "求婚者": "خاطب, طالب الزواج (رجل يتودد لامرأة (بغرض الزواج))",
 "求心": "جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز)\nمثال: قوة الجذب المركزي",
 "求心力": "قوة جذب مركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "求心性": "جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز)\nمثال: قوة الجذب المركزي",
 "求心性神経": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "求心的": "اِنْطِوَائِيّ / جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز)\nمثال: قوة الجذب المركزي",
 "求愛": "تودد, مغازلة (تودد الرجل للمرأة؛ السعي لكسب عواطف المرأة (عادةً بهدف الزواج))\nمثال: كانت فترة تودد قصيرة ومكثفة",
 "求法者": "سائل, مستفسر (شخص يطرح سؤالاً)",
 "求知心": "رغبة في المعرفة, نهم للعلم (فضول يحفز البحث والدراسة)",
 "求積": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "求積法": "تربيع (إنشاء مربع له نفس مساحة شكل آخر)",
 "求答": "حل (إيجاد حل لمشكلة)",
 "求縁": "تودد, مغازلة (تودد الرجل للمرأة؛ السعي لكسب عواطف المرأة (عادةً بهدف الزواج))\nمثال: كانت فترة تودد قصيرة ومكثفة",
 "求職申し込み": "طَلَب تَوْظِيف (طلب للحصول على وظيفة)",
 "汎ゲルマン主義": "جامعة جرمانية (حركة كان هدفها التوحيد السياسي لجميع الشعوب التي تتحدث الألمانية أو اللغات…)",
 "汎スラブ主義": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "汎スラヴ主義": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "汎化": "تَعْمِيم",
 "汎愛": "عمل خيري, هدية خيرية (التعزيز الطوعي لرفاهية الإنسان)",
 "汎用": "إِجْمالِيّ, جامِع",
 "汎用品": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "汎用型コンピュータ": "حاسوب مركزي (حاسوب رقمي كبير يخدم 100-400 مستخدم ويشغل غرفة خاصة مكيفة الهواء)",
 "汎用性": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "汎用機": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "汎用的": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
