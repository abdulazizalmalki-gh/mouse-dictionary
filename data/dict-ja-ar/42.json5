 "水酸化カルシウム": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "水酸化ナトリウム": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات…)",
 "水酸化バリウム": "هيدروكسيد الباريوم (بلورات بيضاء سامة؛ تصنع بإذابة أكسيد الباريوم في الماء)",
 "水酸化物": "هيدروكسيد (مركب كيميائي يحتوي على مجموعة الهيدروكسيل)",
 "水酸化物イオン": "أَيُون الهِيدْرُوكْسِيد",
 "水酸基": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو…)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "水酸根": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو…)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "水野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "水量計": "مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع)",
 "水金": "رَشْوَة, رِشْوَة\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "水鉄砲": "رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "水鉛": "مُولِبْدِينُوم",
 "水鉛鉛鉱": "ولفينيت (معدن أصفر إلى برتقالي أو بني يستخدم كخام للموليبدينوم)",
 "水銀": "زِئْبَق, زَاؤُوق",
 "水銀中毒": "تسمم بالزئبق (حالة تسمم ناتجة عن تناول أو استنشاق الزئبق؛ التسمم الحاد بالزئبق يسبب طعماً…)",
 "水銀剤": "حَامِي الطَّبْع, مِزَاجِيّ",
 "水銀柱ミリメートル": "تور, مليمتر زئبقي (وحدة ضغط تساوي 0.001316 ضغط جوي؛ سُميت نسبة إلى تورشيللي)",
 "水銀気圧計": "بارومتر زئبقي (بارومتر يظهر الضغط بارتفاع عمود من الزئبق)",
 "水銀温度計": "مقياس حرارة زئبقي (مقياس حرارة يتكون من زئبق موجود في بصلة في أسفل أنبوب شعري زجاجي مدرج ومختوم…)",
 "水銀電池": "خلية زئبقية (خلية أولية تتكون من أنود الزنك وكاثود من أكسيد الزئبق وإلكتروليت من هيدروكسيد…)",
 "水門": "خَوْخَة",
 "水閘": "بوابة هويس, صمام هويس (منظم يتكون من صمام أو بوابة تتحكم في معدل تدفق المياه عبر هويس)",
 "水陸両用": "بَرْمَائِيّ (يعمل أو يعيش على اليابسة وفي الماء)\nمثال: مركبات برمائية",
 "水際": "جانب الماء (أرض متاخمة لجسم مائي)\nمثال: 彼らは水際でキャンプをした。 — خيموا على حافة الماء. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "水難": "إِغْرَاق",
 "水雷": "طُرْبِيد / لِي, لي",
 "水雷艇": "قارب طوربيد (سفينة حربية صغيرة عالية السرعة مصممة لهجمات الطوربيد في المياه الساحلية)",
 "水霜": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "水面下": "تَحْت مَائِيّ, مَغْمُور (ينمو أو يبقى تحت سطح الماء) / خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "水頭": "جانب الماء (أرض متاخمة لجسم مائي)",
 "水頭症": "مواه الرأس",
 "水風呂": "درجة حرارة الغرفة (درجة الحرارة العادية للغرفة التي يعيش فيها الناس)",
 "水飛沫": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "水食": "تآكل, حت (تآكل بفعل العمليات الكيميائية)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "水飢饉": "جَفَاف",
 "水飲み": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء. / زُجَاج, قزاز\nمثال: هل لي بكأس ماء؟ / فَلَّاح, فَلَّاحَة",
 "水飲み場": "سبيل ماء, نافورة شرب (نافورة عامة لتوفير تيار من مياه الشرب)",
 "水飴": "شراب الذرة (شراب محضر من الذرة)",
 "水馬": "بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水魔": "كلب الراعي الأسترالي, كيلبي (كلب راعي أسترالي ذو آذان مدببة)",
 "水魚": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "水鱶": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض…)",
 "水鳥": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "水鶏": "تفلق\nمثال: سافر بالقطار",
 "水黽": "بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "氷": "جَلِيد, ثَلْج / جَلِيد, ثَلْج / بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن…)\nمثال: لا أتحمل البرد. / دَلَاة جَلِيدِيَّة / جَلِيد, ثَلْج",
 "氷のう": "كمادة ثلج, كيس ثلج (كيس مقاوم للماء مملوء بالثلج؛ يوضع على الجسم لتبريده أو تقليل التورم)",
 "氷上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "氷人": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "氷冠": "غطاء جليدي (كتلة من الجليد والثلج تغطي بشكل دائم مساحة كبيرة من الأرض (مثل المناطق القطبية…)",
 "氷原": "حقل جليدي (كتلة مسطحة كبيرة من الجليد (أكبر من الطوف الجليدي) تطفو في البحر)",
 "氷嚢": "كمادة ثلج, كيس ثلج (كيس مقاوم للماء مملوء بالثلج؛ يوضع على الجسم لتبريده أو تقليل التورم)",
 "氷堆石": "ركام جليدي, مورين (تربة وحجارة متراكمة ترسبها الأنهار الجليدية)",
 "氷塊": "طوف جليدي (كتلة مسطحة من الجليد (أصغر من الحقل الجليدي) تطفو في البحر)",
 "氷室": "بَيْت جَلِيد, بَيْت الْجَلِيد (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)",
 "氷山": "جَبَل جَلِيد, جَبَل جَلِيدِيّ (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "氷州石": "سبار أيسلندي (كالسيت شفاف يوجد في أيسلندا ويستخدم في المجاهر المستقطبة)",
 "氷帽": "غطاء جليدي (كتلة من الجليد والثلج تغطي بشكل دائم مساحة كبيرة من الأرض (مثل المناطق القطبية…)",
 "氷挟み": "ملقط ثلج (ملقط لرفع كتل الثلج)",
 "氷晶": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "氷晶石": "كريوليت (معدن أبيض يتكون من فلوريدات الألمنيوم والصوديوم؛ مصدر للفلور)",
 "氷期": "عصر جليدي (أي فترة زمنية غطت فيها الأنهار الجليدية جزءاً كبيراً من سطح الأرض)\nمثال: كان أحدث عصر جليدي خلال البليستوسين",
 "氷柱": "دَلَاة جَلِيدِيَّة / جَلِيد, ثَلْج",
 "氷棚": "رف جليدي (جليد متصل باليابسة ولكنه يبرز في البحر)",
 "氷水": "ماء مثلج (ماء يُقدم بارداً جداً أو مع الثلج)\nمثال: 私はビニール袋にワインを注ぎ、それからそれを氷水に付けた。 — سكبت النبيذ في كيس و بعدها غمسته في مياه مجمدة.",
 "氷河": "مَثْلَجَة, مَجْلَدَة",
 "氷河学": "علم الجليد (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "氷河時代": "عَصْر جَلِيدِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "氷河期": "عصر جليدي (أي فترة زمنية غطت فيها الأنهار الجليدية جزءاً كبيراً من سطح الأرض)\nمثال: كان أحدث عصر جليدي خلال البليستوسين / جَفَاف",
