 "淫": "انحلال, فجور (انغماس منحل في الملذات الحسية) / إباحية, خلاعة (صفة الفسق والمجون)",
 "淫ら": "فَاحِش, قَذِر",
 "淫乱": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "淫佚": "فُجُور (اسم فاعل من الفعل \"فَجَرَ\"؛ مصدر من الفعل \"فَجَرَ\") / إِغْوَاء / فُسُوق",
 "淫具": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "淫口": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "淫唇": "شَفْر ((شَفَّرَتِ) الشَّمْسُ: دنَت للغُرُوبِ؛ (شَفَّرَتِ) المالُ: قَلَّ وذهب)",
 "淫売": "بِغَاءٌ, دَعَارَة",
 "淫売婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "淫売宿": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "淫売屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
