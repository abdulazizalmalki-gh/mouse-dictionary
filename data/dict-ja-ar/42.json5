 "殺人犯": "قَاتِل, قَاتِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "殺人的": "رَهِيب, فَظِيع",
 "殺人罪": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "殺人者": "قَاتِل (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "殺人鬼": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني)",
 "殺伐": "فَظّ, قَاسِي الصَّرَاحَة (مُبَاشِر وَدَقِيق بِشَكْلٍ مُنَفِّر)",
 "殺傷": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "殺傷力": "إِمَاتَة, فَتْك (صفة كون الشيء مميتاً)",
 "殺傷能力": "إِمَاتَة, فَتْك (صفة كون الشيء مميتاً)",
 "殺処分": "مرفوض, منبوذ (الشخص أو الشيء الذي يتم رفضه أو تنحيته جانباً لكونه أقل جودة)",
 "殺到": "اِنْدَفَعَ, أَسْرَعَ",
 "殺害": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا.",
 "殺害予告": "تَهْدِيد بِالْقَتْل",
 "殺害者": "قَاتِل, قَاتِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "殺戮": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون…)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "殺気": "تعطش للدماء (رغبة في سفك الدماء)",
 "殺生": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا. / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "殺真菌薬": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها)",
 "殺精子剤": "مبيد النطاف (عامل مانع للحمل يقتل الحيوانات المنوية)",
 "殺精子薬": "مبيد النطاف (عامل مانع للحمل يقتل الحيوانات المنوية)",
 "殺菌": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى…)",
 "殺菌剤": "مُطَهِّر",
 "殺菌消毒剤": "مُطَهِّر",
 "殺菌消毒器": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم…)",
 "殺虫剤": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "殺風景": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي)",
 "殺鬼": "شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ…)\nمثال: العجلة من الشيطان. / زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة)",
 "殻": "صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة. / بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "殻むき": "قَصْف",
 "殻剥き": "قَصْف",
 "殻斗": "كويب (ممص على أقدام بعض الذباب)",
 "殻果": "صُلْبُ القِشْرَةِ (لِلْحَيَوَانَاتِ أَوِ النَّبَاتَاتِ الَّتِي لَهَا صَدَفَةٌ أَوْ قِشْرَةٌ…)",
 "殻竿": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "殻頂": "سُرّة الطبلة (ارتفاع دائري طفيف حيث تلتصق المطرقة بطبلة الأذن)",
 "殿": "خَلْفِيّ / مِرْسَاة, أَنْجَر / إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم) / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / سيد (صيغة خطاب للرجل) / قَاعَة, صَالَة",
 "殿上": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "殿上人": "رجل حاشية (مرافق في بلاط الحاكم)",
 "殿下": "سُمُوُّكَ, سُمُوُّكِ",
 "殿原": "نُبْل, نَبَالَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "殿堂": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / ضَرِيح / قاعة المشاهير (مبنى يحتوي على جوائز تكرم الأشخاص المشهورين)",
 "殿方": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / حمام الرجال (مرحاض عام للرجال)",
 "殿様": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "殿様バッタ": "جراد مهاجر (جراد من العالم القديم يسافر في أسراب ضخمة يجرد مساحات واسعة من الغطاء النباتي)",
 "殿様芸": "الهواية, مبدأ الهواية (القناعة بوجوب ممارسة الرياضة كهواية (للمتعة) وليس من أجل المال)",
 "殿様蛙": "ذُو بُقَع دَاكِنَة (عليه بقع داكنة اللون)",
 "殿筋": "عضلة ألوية (أي واحدة من ثلاث عضلات هيكلية كبيرة تشكل الأرداف وتحرك الفخذ)",
 "殿舎": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "殿達": "نُبْل, نَبَالَة / زَائِر",
 "殿部": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "殿閣": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "毀つ": "دَمَّرَ",
 "毀れ": "ثلم, حز (قطع صغير)\nمثال: هو في السجن",
 "毀傷": "جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "毀壊": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "毀損": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة.",
 "毀棄": "تَدْمِير, هَدْم",
 "毅然": "بِلَا تَرَدُّد, عَازِم (يتميز بالسرعة والحزم في اتخاذ القرار)\nمثال: وقف بحزم ضد العدو",
 "母": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / أمي, ماما (مصطلحات غير رسمية للأم)",
 "母さま": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "母さん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة",
 "母じゃ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "母じゃ人": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "母ちゃん": "أُمّ, مَامَا (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "母なる": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "母の命": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "母の日": "عِيد اَلْأُمّ",
 "母上": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
