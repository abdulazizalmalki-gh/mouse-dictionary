 "祓う": "طَرَدَ",
 "祓魔": "رُقْيَة",
 "祓魔師": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "祖": "مُؤَسِّس, مُؤَسِّسَة / سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\") / سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\") / العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة) / جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "祖先": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "祖先伝来": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "祖先崇拝": "عبادة الأسلاف (عبادة الأجداد) / عبادة الأسلاف (عادة تبجيل الأسلاف المتوفين الذين يُعتبرون ما زالوا جزءاً من العائلة، ويُعتقد أن أرواحهم تمتلك القدرة على التدخل في شؤون الأحياء)\nمثال: معظم ممارسات عبادة الأسلاف المعروفة تاريخياً في اليابان هي تعديلات لعادات صينية",
 "祖国": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "祖国愛": "وَطَنِيَّة, مَحَبَّةْ وَطَن",
 "祖型": "أصل, نموذج بدئي (شيء يعمل كنموذج أو أساس لعمل نسخ)\nمثال: هذه اللوحة نسخة من الأصل",
 "祖宗": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "祖母": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "祖母さん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "祖父": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز",
 "祖父ちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "祖父母": "جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "祖父祖母": "جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "祖考": "جد, سلف (مؤسس العائلة) / جَدّ, سَلَف (شخص من زمن سابق ساهم في التقاليد التي تشترك فيها مجموعة ما)\nمثال: حافظوا على إيمان أجدادنا",
 "祝": "تَهْنِئَة / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / عُطْلَة رَسْمِيَّة, إِجَازَة عَامَّة / اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝い": "تَهْنِئَة / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "祝いごと": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝い事": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝う": "اِحْتَفَلَ",
 "祝す": "هَنَّأَ, يُهَنِّئُ",
 "祝する": "هَنَّأَ, يُهَنِّئُ",
 "祝とう": "بركة, دعاء بالبركة (فعل الدعاء للحصول على الحماية الإلهية) / بركة, دعاء بالبركة (صلاة شعائرية لطلب الحماية الإلهية)",
 "祝事": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝儀": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال. / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "祝典": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝別": "تكريس (تقديس شيء ما عن طريق تخصيصه (عادة بطقوس دينية) لله) / تَكْرِيس (التزام رسمي بحياتك أو وقتك لغرض عزيز (لخدمة أو هدف))\nمثال: حضر الكاردينال تكريس الكنيسة",
 "祝勝": "احتفال النصر (احتفال يعقب انتصاراً في معركة أو منافسة رياضية)",
 "祝宴": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "祝意": "مُبَارَك, مَبْرُوك",
 "祝日": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "祝杯": "توست, خبز محمص (شرائح من الخبز تم تحميصها) / نخب (شرب نخب تكريماً لشخص أو حدث أو للصحة) / مُنْتَهٍ, هالِك (شخص في مأزق يائس؛ شخص محكوم عليه بالهلاك) / نجم المجتمع (مشهور يتلقى الكثير من الإشادة والاهتمام)\nمثال: سأكون هالكاً إذا لم تنجح هذه الخطة",
 "祝着": "مُبَارَك, مَبْرُوك",
 "祝祭": "عِيد, مَهْرَجَان",
 "祝祭日": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "祝祷": "بركة, دعاء بالبركة (فعل الدعاء للحصول على الحماية الإلهية) / بركة, دعاء بالبركة (صلاة شعائرية لطلب الحماية الإلهية)",
 "祝福": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال. / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "祝融": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "祝言": "احتفال, مهرجان (أي نشاط ترفيهي بهيج) / عُرْس, زِفَاف",
 "祝賀": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝賀会": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق / قَيْصَر, إِمْبْرَاطُور / رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة. / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "神々": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "神々しい": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "神々の黄昏": "راغناروك, شفق الآلهة (أسطورة حول الدمار النهائي للآلهة في معركة مع قوى الشر)",
 "神かけて": "مطلقا, على الإطلاق",
 "神がかり": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神さま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة) / واحد النرد, آس (في وَ: العدد واحد العدد الاول) / ذَرَّة / إرسال ساحق (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر) / أفضل رامٍ في الفريق / آس, مُمْتاز (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "神さん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "神とあがめる": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "神と崇める": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "神に召される": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "神のみ子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "神の使い": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "神の命": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "神の国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神の子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير. / مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)\nمثال: زيري صهيوني مسيحي. / أُعْجُوبَة / نَابِغَة",
 "神の御子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "神の思し召し": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "神の思召": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "神の思召し": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "神の愛": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة) / حب غير مشروط, محبة روحية (حب غير أناني لشخص آخر دون دلالات جنسية (خاصة الحب ذو الطبيعة الروحية)) / محبة إلهية ((في اللاهوت المسيحي) محبة الله أو المسيح للبشرية)",
 "神の手": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "神の民": "شعب الله المختار (أي شعب يعتقد أن الله اختاره)",
 "神の王国": "ملكوت الله (المجال الروحي الذي يخضع لسيادة الله)",
 "神の言": "كَلَام اللّٰهِ / كلمة الله (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "神の言葉": "كَلَام اللّٰهِ / كلمة الله (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "神わざ": "مُعْجِزَة, أُعْجُوبَة",
 "神主": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "神事": "مُعْجِزَة, أُعْجُوبَة",
 "神仙": "كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية)",
 "神仙菜": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل) / لافر أحمر (أعشاب بحرية حمراء صالحة للأكل) / حوض تطهير, مغسل ((العهد القديم) حوض كبير استخدمه الكهنة في المعابد اليهودية القديمة لأداء طقوس الاغتسال)",
 "神位": "إِلَٰهِيَّة",
 "神作": "تُحْفَة, رَائِعَة",
 "神使": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "神像": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى أيضًا وَثَنًا) / آيْدُول",
 "神出鬼没": "متملص, مراوغ",
 "神判": "محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو مؤلمة يعتقد أنها تحت السيطرة الإلهية؛ كان الهروب عادة علامة على البراءة)",
 "神勅": "كَاهِن, عَرَّاف / إِلْهَام",
 "神化": "تَأْلِيه",
 "神占": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "神司": "كَاهِن, قِسِّيس",
 "神品": "تُحْفَة, رَائِعَة",
 "神国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神域": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "神壇": "مَذْبَح, هَيْكَل",
 "神変": "مُعْجِزَة, أُعْجُوبَة",
 "神奈川": "كَانَاغَاوَا",
 "神奈川沖浪裏": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "神女": "إِلَاهَة, إِلٰهَة / مَعْبُودَة",
 "神妙": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / خَجُول, وَدِيع (متواضع في الروح أو السلوك؛ يُوحي بلطف منسحب أو خضوع مهيب) / خَنُوع, وَدِيع (بالغ الطاعة والانقياد) / غَامِض",
 "神学": "إِلٰهِيَّات",
 "神学士": "دكتوراه في اللاهوت (درجة الدكتوراه في الدراسات الدينية)",
 "神学校": "مدرسة بنات, مدرسة خاصة (مكان خاص لتعليم الصغار) / كلية لاهوت, معهد لاهوتي (مدرسة لاهوتية لتدريب القساوسة أو الكهنة أو الحاخامات)",
 "神学者": "عَالِم لَاهُوت, لَاهُوتِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "神官": "كَاهِن, قِسِّيس",
 "神官文字": "كَهَنُوتِيّ, هِيرَاطِيقِيّ (يلتزم بأنماط وأساليب ثابتة؛ شديد التقييد والرسمية) / هيراطيقي (مكتوب بـ أو ينتمي إلى شكل متصل من الكتابة المصرية القديمة) / كهنوتي (مرتبط بالكهنوت أو الكهنة) / الخط الهيراطيقي, هيراطيقية (شكل متصل (مختزل) من الهيروغليفية المصرية؛ استخدمه الكهنة بشكل خاص)\nمثال: نص مصري هيراطيقي",
 "神州": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神巫": "سَاحِرَة",
 "神性": "إِلَٰهِيَّة",
 "神憑り": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神懸かり": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神懸り": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神戸": "كُوبِه",
 "神掛けて": "مطلقا, على الإطلاق",
 "神政": "ثِيُقْرَاطِيَّة",
 "神教": "ألوهية, إيمان بوجود إله (العقيدة أو الإيمان بوجود إله أو آلهة)",
 "神明": "إِلٰه, مَعْبُود (كل ما اتُّخِذَ معبودًا)\nمثال: يؤمن فاضل بإله الإسلام. / أَمَاتِيرَاسُو",
 "神明裁判": "محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو مؤلمة يعتقد أنها تحت السيطرة الإلهية؛ كان الهروب عادة علامة على البراءة)",
 "神智学": "الحكمة الإلهية, ثيوصوفيا (نظام عقائدي يقوم على البصيرة الصوفية في طبيعة الله والروح)",
 "神格": "إِلَٰهِيَّة",
 "神格化": "تَأْلِيه",
 "神業": "مُعْجِزَة, أُعْجُوبَة",
 "神楽": "كاغورا (رقصة فخمة من ديانة الشنتو تشكل الآن جزءاً من مهرجانات القرى اليابانية)\nمثال: تُعد الكاغورا، وخاصة تلك الأشكال التي تتضمن سرد القصص أو إعادة تمثيل الخرافات، أحد التأثيرات الأساسية على مسرح نو",
 "神様": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة) / واحد النرد, آس (في وَ: العدد واحد العدد الاول) / ذَرَّة / إرسال ساحق (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر) / أفضل رامٍ في الفريق / آس, مُمْتاز (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "神権": "الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون لمحاسبة رعاياهم؛ التمرد هو أسوأ الجرائم السياسية)\nمثال: تم الإعلان عن مذهب الحق الإلهي للملوك من قبل عائلة ستيوارت في بريطانيا في القرن السادس عشر",
 "神権政治": "ثِيُقْرَاطِيَّة",
 "神樹": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "神樹蚕": "عثة سينثيا (عثة آسيوية كبيرة أُدخلت إلى الولايات المتحدة؛ تتغذى اليرقات على شجرة السماء)",
 "神武以来": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "神殺し": "قَتْل إِلٰه (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَاتِل إِلٰه (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: قتل الصياد دبا.",
 "神殿": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع\nمثال: この神殿は建てるのに４６年かかりました。 — في ست وأربعين سنة بني هذا الهيكل.",
 "神気": "طاقة تشي, كي (طاقة الحياة المتداولة التي يعتقد في الفلسفة الصينية أنها كامنة في كل شيء؛ في الطب الصيني التقليدي يعتبر توازن الأشكال السلبية والإيجابية في الجسم…) / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "神洲": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神漿": "أمبروزيا, طعام الآلهة ((الأساطير الكلاسيكية) طعام وشراب الآلهة؛ البشر الذين أكلوه أصبحوا خالدين) / أمبروزيا (تحلية فواكه مصنوعة من البرتقال والموز مع جوز الهند المبشور) / أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / خبز النحل (خليط من الرحيق وحبوب اللقاح يعده النحل العامل ويُطعم لليرقات)",
 "神無月": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "神父": "رئيس دير (رئيس دير فرنسي)",
 "神的": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "神神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "神神しい": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "神祠": "ضَرِيح",
 "神秘": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "神秘主義": "تصوف, غموضية (فكر غامض أو غير عقلاني) / تصوف, عرفان (دين يقوم على الاتحاد الروحي الغامض مع حقيقة مطلقة)",
 "神秘劇": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "神秘化": "تضليل, تعمية (نشاط حجب فهم الناس وتركهم في حيرة أو ارتباك) / أحجية, شيء مُحيّر (شيء مصمم لإثارة الحيرة أو الإرباك) / ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "神秘学": "تنجيم, علوم خفية (اعتقاد بوجود قوى خارقة للطبيعة وإمكانية إخضاعها للسيطرة البشرية) / التنجيم, العلوم الخفية (دراسة ما وراء الطبيعة أو القوى الخارقة)",
 "神秘性": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "神秘的": "غَامِض",
 "神秘的雰囲気": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "神童": "طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة.",
 "神符": "تَمِيمَة, أُخْذَة",
 "神経": "عَصَب / أعصاب, ثبات (التحكم في العواطف) / توتر عصبي, عصبية (حالة نفسية غير مستقرة)\nمثال: هذا النوع من التوتر ليس جيداً لأعصابي",
 "神経が細い": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "神経が細かい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "神経が鋭い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "神経の可塑性": "اللُّدُونة العصبية",
 "神経の細い": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "神経の鈍い": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية) / عديم الإحساس, غليظ (يفتقر إلى المشاعر الإنسانية؛ غير حساس عقليًا أو أخلاقيًا)\nمثال: غير حساس للإشعاع",
 "神経の鋭い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "神経を使う": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "神経インパルス": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "神経ガス": "غَاز أَعْصَاب, عَامِل أَعْصَاب",
 "神経ホルモン": "هرمون عصبي (هرمون يتم إطلاقه بواسطة نبضات عصبية (مثل النورإبينفرين أو الفازوبريسين))",
 "神経中枢": "مركز, مركز عصبي (مجموعة من الخلايا العصبية تتحكم في عملية جسدية محددة) / غرفة العمليات, مركز الأعصاب (مركز يوفر المعلومات والتحكم)\nمثال: في معظم الناس يقع مركز الكلام في نصف الكرة الأيسر",
 "神経伝達物質": "نَاقِل عَصَبِيّ",
 "神経元": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経内分泌": "عصبي صماوي (متعلق بالجهازين العصبي والصماوي (خاصة في وظيفتهما المشتركة))",
 "神経内科": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "神経剤": "عامل أعصاب, غاز الأعصاب (غاز سام يتم استنشاقه أو امتصاصه عبر الجلد وله آثار ضارة على الجهاز العصبي والتنفسي)",
 "神経単位": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経叢": "ضفيرة عصبية (شبكة من الأعصاب المتقاطعة)",
 "神経可塑性": "اللُّدُونة العصبية",
 "神経周膜": "حول العصب, غمد الحزمة العصبية (غمد من النسيج الضام يغطي حزمة من الألياف العصبية)",
 "神経回路網": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم) / شبكة عصبونية, شبكة عصبية (هندسة حاسوبية يتم فيها توصيل المعالجات بطريقة توحي بالاتصالات بين الخلايا العصبية؛ يمكنها التعلم عن طريق التجربة والخطأ)",
 "神経堤": "عُرْف عَصَبِيّ (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: من عرف نفسه فقد عرف ربه.",
 "神経外科": "جراحة الأعصاب (أي جراحة تتعلق بالجهاز العصبي (الدماغ أو الحبل الشوكي أو الأعصاب المحيطية))",
 "神経多様性": "تَنَوُّع عَصَبِيّ",
 "神経学": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "神経学者": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "神経心理学": "علم النفس العصبي, علم النفس الفسيولوجي (فرع علم النفس المعني بالأسس الفسيولوجية للعمليات النفسية)",
 "神経性": "عَصَبِيّ",
 "神経性大食症": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز بالإفراط في الأكل تليها فترات من الصيام أو التقيؤ المستحث ذاتياً)",
 "神経性無食欲症": "فقدان الشهية العصبي ((الطب النفسي) اضطراب نفسي يتميز بأوهام جسدية بأن الشخص سمين جداً رغم كونه نحيفاً جداً)",
 "神経戦": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "神経支配": "إِمْدَاد عَصَبِيّ, تَعْصِيب (توزيع الألياف العصبية على عضو أو منطقة في الجسم) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة)",
 "神経核": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経梅毒": "زهري عصبي (زهري يصيب الجهاز العصبي المركزي)",
 "神経毒": "ذيفان عصبي, سم عصبي (أي سم يؤثر على الأنسجة العصبية)",
 "神経炎": "التهاب العصب (التهاب العصب مصحوب بألم وأحياناً فقدان الوظيفة)",
 "神経生物学": "بيولوجيا عصبية (فرع علم الأحياء الذي يتعامل مع تشريح وفسيولوجيا وباثولوجيا الجهاز العصبي)",
 "神経生理学": "فسيولوجيا عصبية (فرع علم الأعصاب الذي يدرس فسيولوجيا الجهاز العصبي)",
 "神経病": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "神経症": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "神経症的": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي) / عصابي (مميز للعصاب أو مصاب به) / عُصابِيّ, مَرِيض نَفْسِيّ (شخص يعاني من العصاب)\nمثال: اضطراب عصابي",
 "神経痛": "ألم عصبي (ألم تشنجي حاد على طول مسار عصب واحد أو أكثر)",
 "神経科": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "神経科医": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "神経科学": "عُلُوم عَصَبِيَّة, عِلْم الأَعْصَاب (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "神経科学者": "عالم أعصاب (عالم أحياء عصبية يتخصص في دراسة الدماغ)",
 "神経筋": "عصبي عضلي (يؤثر على أو يميز كلا من الأنسجة العصبية والعضلية)",
 "神経筋接合部": "مشبك عصبي عضلي (الوصلة بين الليف العصبي والعضلة التي يغذيها)",
 "神経管": "أنبوب عصبي (أنبوب من نسيج الأديم الظاهر في الجنين يتطور منه الدماغ والحبل الشوكي)",
 "神経節": "عُقْدَة عَصَبِيَّة",
 "神経精神医学": "طب النفس العصبي (فرع الطب المعني بالاضطرابات العقلية المنسوبة لأمراض الجهاز العصبي)",
 "神経系": "جِهَاز عَصَبِيّ",
 "神経細胞": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経細胞体": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان) / سوما (تجسيد لشراب مسكر مقدس يُستخدم في الطقوس الفيدية) / سوما, هاوما (كرمة عديمة الأوراق من جزر الهند الشرقية؛ كانت عصارتها اللبنية الحامضة تستخدم سابقاً لصنع مشروب مسكر)\nمثال: درس ليوناردو جسم الإنسان",
 "神経終末": "نهاية عصبية (الهيكل الطرفي للمحور العصبي الذي لا ينتهي عند مشبك عصبي)",
 "神経組織": "نسيج عصبي (نسيج يتكون من عصبونات)",
 "神経網": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم) / شبكة عصبونية, شبكة عصبية (هندسة حاسوبية يتم فيها توصيل المعالجات بطريقة توحي بالاتصالات بين الخلايا العصبية؛ يمكنها التعلم عن طريق التجربة والخطأ)",
 "神経線維": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "神経繊維": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "神経腫": "ورم عصبي (أي ورم مشتق من خلايا الجهاز العصبي)",
 "神経膠": "خلايا دبقية, نسيج عصبي دبقي (نسيج داعم يحيط ويدعم الخلايا العصبية في الجهاز العصبي المركزي)",
 "神経膠細胞": "خلية دبقية, خلية غروية عصبية (خلية من خلايا الدبق العصبي)",
 "神経膠腫": "ورم دبقي (ورم في الدماغ يتكون من الخلايا الدبقية)",
 "神経芽細胞": "أرومة عصبية (خلية تتطور منها الخلية العصبية)",
 "神経芽細胞腫": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "神経芽腫": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "神経衝撃": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "神経衰弱": "وهن عصبي (انهيار عصبي (مصطلح غير تقني)) / تَرْكِيز",
 "神経解剖学": "تشريح عصبي (تشريح الجهاز العصبي)",
 "神経言語プログラミング": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "神経言語学": "لسانيات عصبية (فرع اللسانيات الذي يدرس العلاقة بين اللغة وبنية ووظيفة الجهاز العصبي)",
 "神経調節性失神": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "神経質": "عَصَبِيّ / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط)",
 "神経過敏": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "神経障害": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "神統記": "أصل الآلهة, ثيوغونيا (دراسة أصول وأنساب الآلهة)",
 "神義論": "ثيوديسيا, عدالة الإله (فرع اللاهوت الذي يدافع عن صلاح الله وعدله في مواجهة وجود الشر)",
 "神聖": "قُدْسِيَّة",
 "神聖ローマ帝国": "اَلْإِمْبَرَاطُورِيَّة اَلرُّومَانِيَّة اَلْمُقَدَّسَة",
 "神聖ローマ皇帝": "إمبراطور روماني مقدس (عاهل الإمبراطورية الرومانية المقدسة)",
 "神聖化": "تقديس (حفل ديني يتم فيه جعل شيء مقدسًا)",
 "神聖性": "قُدْسِيَّة (صفة كون الشيء مقدساً)",
 "神聖戦争": "حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "神聖文字": "هِيرُوغْلِيفِيَّة",
 "神聖視": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله)) / مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "神託": "كَاهِن, عَرَّاف / إِلْهَام",
 "神話": "خُرَافَة",
 "神話学": "عِلْم اَلْأَسَاطِير (أَدْرَكَ حقيقة الشيء) / مِيثُولُوجِيَا\nمثال: أدرس علم النفس.",
 "神話的": "أُسْطُورِيّ, مِيثُولُوجِيّ (مبنيّ على القصص التقليدية أو مرويّ فيها؛ يفتقر إلى أساس واقعي)",
 "神輿": "مُسْتَدَقّ الظَّهْر",
 "神輿を上げる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "神送り": "رُقْيَة",
 "神通力": "قدرة سحرية (القدرة على أداء السحر)",
 "神速": "سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "神道": "شِنْتَوِيَّة, شِنْتُو",
 "神道信者": "شنتوي (متعلق بالشنتوية أو مميز لها) / شِنْتُوِيّ (مؤمن بالشنتوية)\nمثال: معابد شنتوية",
 "神道家": "شنتوي (متعلق بالشنتوية أو مميز لها) / شِنْتُوِيّ (مؤمن بالشنتوية)\nمثال: معابد شنتوية",
 "神霊": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "神韻縹渺": "رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ) / جَلِيل, سَامٍ (يبعث على الرهبة والإجلال؛ عُلْوِيّ) / أَسْمَى, سَامٍ (في أعلى درجة أو أقصاها؛ بالغ الشدة) / رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه)",
 "神風": "اِنْتِحَارِيّ, كَامِيكَازِي",
 "神髄": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "神魂": "قلباً وقالباً (بإيمان كامل) / جوهر, خلاصة (الجزء المختار أو الأكثر أهمية أو حيوية في فكرة أو تجربة ما)\nمثال: كانت معه قلباً وقالباً",
 "祟り": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "祟り目": "بَلَاء, بُؤْس\nمثال: 弱り目に祟り目。 — لا تأتي المصائب فُرَادَى.",
 "祟る": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "祠宇": "ضَرِيح",
 "祢宜": "كَاهِن, قِسِّيس / جُنْدُب, جَرَادَة",
 "祥": "فَأل, نَذِيْر",
 "票": "تَصْوِيت, اِقْتِرَاع / صَوَّتَ (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / مُلْصَق, بِطَاقَة",
 "票差": "هَامِش",
 "票決": "تَصْوِيت, اِقْتِرَاع / صَوَّتَ (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "票田": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "祭": "عِيد, مَهْرَجَان / مُتَّقِد, مُلْتَهِب (عاطفيّ أو سريع الغضب) / اشتعال, حريق (عملية احتراق المواد القابلة للاشتعال منتجة حرارة وضوءاً ودخاناً (غالباً))\nمثال: كانت النار واحدة من أولى اكتشافات أسلافنا / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "祭り": "عِيد, مَهْرَجَان / مُتَّقِد, مُلْتَهِب (عاطفيّ أو سريع الغضب) / اشتعال, حريق (عملية احتراق المواد القابلة للاشتعال منتجة حرارة وضوءاً ودخاناً (غالباً))\nمثال: كانت النار واحدة من أولى اكتشافات أسلافنا / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "祭り上げる": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / تَمَلَّقَ, تَبَصْبَصَ",
 "祭る": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ) / صَلَّى, دَعَا",
 "祭主": "كَاهِن, قِسِّيس",
 "祭事": "عِيد, مَهْرَجَان",
 "祭儀": "طَقْس دِينِيّ, شَعِيرَة",
 "祭典": "عِيد, مَهْرَجَان",
 "祭司": "كَاهِن, قِسِّيس",
 "祭壇": "مَذْبَح, هَيْكَل",
 "祭壇座": "مَذْبَح, هَيْكَل",
 "祭壇画": "ستار المذبح, لوحة المذبح الخلفية (ساتر مطلي أو منحوت يوضع فوق وخلف المذبح أو مائدة العشاء الرباني)",
 "祭式": "طَقْس دِينِيّ, شَعِيرَة",
 "祭政一致": "ثِيُقْرَاطِيَّة",
 "祭日": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "祭殿": "ضَرِيح",
 "祭礼": "عِيد, مَهْرَجَان",
 "祭祀": "شَعِيرَة, مَرَاسِم",
 "祭禮": "عِيد, مَهْرَجَان",
 "祭騒ぎ": "احتفال, مهرجان (أي نشاط ترفيهي بهيج)",
 "禀告": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "禀性": "طَبِيعَة, طبيعة",
 "禀請": "عَرِيضَة, طَلَب",
 "禀請書": "عَرِيضَة, طَلَب",
 "禁": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ) / حَظْر ((حَظَّرَ): بالغ في الحظر) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: حرم الإسلام الترويع",
 "禁じる": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁じ手": "مُخَالَفَة",
 "禁ず": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁ずる": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁め": "اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "禁中": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "禁令": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁制": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁制原理": "مبدأ استبعاد باولي (لا يمكن لأي إلكترونين أو بروتونين أو نيوترونين في نظام معين أن يكونا في حالات تتميز بنفس مجموعة الأعداد الكمية)",
 "禁制品": "تَهْرِيب",
 "禁則": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁反言": "إِغْلَاق, اِسْتُوبْل (قاعدة إثبات تمنع الشخص من إنكار حقيقة واقعة تم تسويتها بالفعل)",
 "禁呪": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "禁固": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禁固刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禁圧": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة",
 "禁域": "غير جاهز (لا يعمل بشكل صحيح أو ليس في حالة مناسبة للمتابعة)\nمثال: كان إطلاق الفضاء غير جاهز",
 "禁忌": "مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / مُضَادّ اِسْتِطْبَاب",
 "禁戒": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁手": "مُخَالَفَة",
 "禁断": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "禁断の木の実": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "禁断の果実": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "禁断症状": "عَرَض الانسحاب (أي اضطراب جسدي أو نفسي (مثل التعرق أو الاكتئاب) يعاني منه مدمن المخدرات عند حرمانه من الدواء)",
 "禁欲": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "禁欲主義": "زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد)",
 "禁欲主義者": "نُسُكِيّ / نَاسِك",
 "禁欲生活": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "禁欲的": "زَهِيد, مُتَقَشِّف (مقتصد في الاستهلاك خاصة الطعام والشراب) / قَنُوع, مُعْتَدِل (يَتَّسِمُ بِالاعْتِدَالِ فِي الانْغِمَاسِ وَالتَّنَعُّم)\nمثال: ملذات المائدة لم تكن ذات أهمية تذكر لشخص متقشف بطبعه",
 "禁欲者": "نُسُكِيّ / نَاسِك",
 "禁止": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁止令": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ) / حَظْر ((حَظَّرَ): بالغ في الحظر) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: حرم الإسلام الترويع",
 "禁止命令": "أمر حجر, قرار حظر (أمر محكمة يمنع طرفاً من القيام بنشاط معين) / تَحْرِيم, حِرْمَان كَنَسِيّ (لوم كنسي من قبل الكنيسة الكاثوليكية يسحب أسراراً معينة والدفن المسيحي من شخص أو جميع الأشخاص في منطقة معينة)",
 "禁止条約": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ) / حَظْر ((حَظَّرَ): بالغ في الحظر) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: حرم الإسلام الترويع",
 "禁治産": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "禁煙": "التَّدْخِين مَمْنُوعَ, مَمْنُوع التَّدْخِين",
 "禁煙車": "خَالٍ مِنَ الدُّخَانِ (خالٍ من الدخان)",
 "禁獄": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禁秘": "سِرِّيَّة",
 "禁裏様": "قَيْصَر, إِمْبْرَاطُور",
 "禁足": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "禁輸": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁輸品": "تَهْرِيب",
 "禁遏": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁酒": "تعديل, تلطيف (عملية التلطيف أو المزج المعتدل) / اعتدال, رصانة (الامتناع عن الإفراط) / اعتدال, عفة (سمة تجنب التجاوزات والإفراط)",
 "禁酒家": "عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة) / زاهد, ناسك (شخص يمارس نكران الذات كتأديب روحي)",
 "禁酒法": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁錮": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禁錮刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禄": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد) / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "禄高": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "禅": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "禅宗": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "禅家": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "禅師": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "禅道": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "禅門": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "禊": "وُضُوء, غُسْل / وَضُوء",
 "禊ぎ": "وُضُوء, غُسْل / وَضُوء",
 "禊ぐ": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "禍": "كَارِثَة, مُصِيبَة / شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "禍々しい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "禍乱": "بَلَاء, بُؤْس",
 "禍事": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "禍害": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "禍禍しい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "禍言": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "福": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "福井": "فُوكُوي",
 "福利": "رَفَاهَة, خَيْر",
 "福利厚生": "امتياز وظيفي, ميزة إضافية (ميزة عرضية تُمنح لأنواع معينة من التوظيف (خاصة إذا كانت تُعتبر حقاً))\nمثال: سيارة الليموزين هي إحدى الامتيازات الإضافية للوظيفة",
 "福助": "كَبير الرَّأْس (ذو رَأْس كَبير الحَجْم)",
 "福岡": "فُوكُوُكَا",
 "福島": "فُوكُوشِيمَا",
 "福州": "فُوجُو",
 "福建": "فُوجْيَان",
 "福建語": "فوكين, لغة مين (أي من أشكال اللغة الصينية التي يتم التحدث بها في مقاطعة فوجيان)",
 "福引": "يَانَصِيب",
 "福引き": "يَانَصِيب",
 "福徳": "ثَرْوَة",
 "福祉": "رَفَاهَة, خَيْر",
 "福祉事業": "خدمة اجتماعية, عمل خيري (نشاط منظم لتحسين ظروف المحرومين في المجتمع)",
 "福祉司": "أخصائي اجتماعي, باحث اجتماعي (شخص يعمل لتقديم الخدمات الاجتماعية (خاصة للمحرومين))",
 "福祉国家": "دولة الرفاهية (حكومة تتحمل المسؤولية عن رفاهية مواطنيها من خلال برامج في الصحة العامة والإسكان العام والمعاشات التقاعدية وتعويض البطالة وما إلى ذلك)",
 "福者": "مُبَارَك",
 "福袋": "كيس الحظ (حاوية يسحب منها الشخص غرضاً مغلفاً بشكل عشوائي دون معرفة المحتويات) / حقيبة مفاجآت (تشكيلة من عناصر متنوعة عشوائية)",
 "福音": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل / إِنْجِيل",
 "福音主義": "إنجيلية (تؤكد على أهمية التحول الشخصي والإيمان كوسيلة للخلاص) / تبشير بالإنجيل (التبشير الحماسي والدعوة للإنجيل)",
 "福音伝道": "تبشير بالإنجيل (التبشير الحماسي والدعوة للإنجيل)",
 "福音伝道者": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "福音史家": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "福音書": "إنجيل, الأناجيل (الكتب الأربعة في العهد الجديد (متى ومرقس ولوقا ويوحنا) التي تروي قصة حياة المسيح وتعاليمه)",
 "福音派": "تَبْشِيرِيّ, دَعَوِيّ (يتّسم بحماسة متّقدة لقضيّة ما) / إنجيلي (متعلق بالإنجيل المسيحي أو متوافق معه، خاصة كما في الكتب الأربعة الأولى من العهد الجديد) / إنجيلي (متعلق بكنيسة مسيحية تؤمن بالتحول الشخصي وعصمة الكتاب المقدس وخاصة الأناجيل الأربعة)\nمثال: المسيحية الإنجيلية",
 "禦ぎ": "دِفَاع, حِمَايَة / دِفاع",
 "禪": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "禰宜": "كَاهِن, قِسِّيس / جُنْدُب, جَرَادَة",
 "禽獣": "مُتَوَحِّش",
 "禽竜": "إغوانودون (ديناصور عاشب ضخم ثنائي الأرجل ذو ذيل طويل ثقيل؛ شائع في أوروبا وشمال أفريقيا؛ من العصر الطباشيري المبكر)",
 "禽類": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "禽鳥": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "禾穀": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "禿": "صَلَع / أَصْلَع حَلِيق / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "禿げ": "صَلَع / أَصْلَع حَلِيق / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "禿げ頭": "صَلَع",
 "禿びる": "كَلِيل",
 "禿瘡": "ثعلبة بقعية (صلع متقطع (على شكل بقع))",
 "禿筆": "بَالٍ",
 "禿袋鼯鼠": "فأر طائر (كسكس طائر صغير جداً)",
 "禿頭": "صَلَع",
 "禿頭病": "ثَعْلَبَة, حَاصَّة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "禿髪": "صَلَع",
 "禿鷲": "نسر (العالم القديم) (أي من النسور الكبيرة المتعددة في أفريقيا وأوراسيا)",
 "禿鷹": "نَسْر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "秀": "تَقَدُّم",
 "秀でる": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "秀句": "حَسَن الصِّيَاغَة ((عَنِ اللُّغَة) مَصُوغ بِمَهَارَة وَبِشَكْلٍ مُمْتِع) / حَسَن التَّشْكِيل (ذو شكل أنيق ومُرضٍ)",
 "秀才": "أُعْجُوبَة / نَابِغَة",
 "秀抜": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "秀逸": "مُمْتَاز, فَاخِر",
 "秀麗": "رَشِيق, ظَرِيف",
 "私": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / شَخْصِيّ / أَنَانِيَّة / سِرِّيَّة",
 "私ごと": "سِرِّيَّة, خَلْوَة",
 "私する": "مُنَاسِب / لَائِق",
 "私たち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "私ども": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "私め": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "私も又": "أَنَا أَيْضًا, أَنَا كَذٰلِك",
 "私事": "سِرِّيَّة, خَلْوَة",
 "私企業": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "私信": "رسالة شخصية (رسالة تتعلق بالشؤون الشخصية)",
 "私儀": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "私党": "فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "私共": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "私刑": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين)",
 "私利": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "私利私欲": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "私報": "رِسَالَة خَاصَّة",
 "私塾": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "私娼窟": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "私学校": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "私心": "أَنَانِيَّة",
 "私情": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "私意": "أَنَانِيَّة",
 "私掠免許": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "私掠免許状": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "私掠船": "سفينة قرصنة مفوضة (سفينة حربية مملوكة للقطاع الخاص مفوضة للاعتداء على الشحن التجاري أو السفن الحربية لدولة معادية) / قرصان مفوض (ضابط أو عضو طاقم في سفينة قرصنة مفوضة)",
 "私書": "رسالة شخصية (رسالة تتعلق بالشؤون الشخصية)",
 "私有地": "أرض, إقليم (إقليم تمارس عليه السيادة أو السيطرة) / إقطاعية, ضيعة (ممتلكات واسعة من الأراضي (خاصة في الريف) يحتفظ بها المالك لاستخدامه الخاص)\nمثال: امتد نطاق حكمه إلى أوروبا",
 "私有財産": "مِلْكِيَّة خَاصَّة",
 "私服": "زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني)",
 "私欲": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "私法人": "شركة مساهمة خاصة, شركة مغلقة (شركة مملوكة لعدد قليل من الأشخاص؛ ليس لأسهمها سوق عام)",
 "私消": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "私淑": "أَلَه (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "私物": "مِلْكِيَّة خَاصَّة",
 "私物化": "استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "私生児": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "私生子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "私産": "مِلْكِيَّة خَاصَّة",
 "私用": "أمور شخصية, شأن خاص (مسائل ذات اهتمام شخصي)\nمثال: رتب أموره الشخصية",
 "私的": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "私的制裁": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين)",
 "私的所有": "مِلْكِيَّة خَاصَّة",
 "私窠子": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "私窩子": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "私立": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "私立学校": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "私立探偵": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)\nمثال: その男は私立探偵だとわかった。 — تبين أنا الرجل محقق خاص.",
 "私立校": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "私等": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "私自身": "نَفْسِي",
 "私製": "غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)\nمثال: نوع من العمدة غير الرسمي",
 "私設": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "私設回線": "خط خاص (خط هاتف يخدم مشتركاً واحداً)",
 "私訴": "دعوى مدنية (دعوى قضائية تزعم انتهاكات للقانون المدني من قبل المدعى عليه)",
 "私語": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)\nمثال: 私語をやめて話を聞け。 — اسكت و اسمعني. / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / كلام معسول, ملاطفة (تملق مصمم لكسب الرضا)",
 "私財": "مِلْكِيَّة خَاصَّة",
 "私通": "وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "私道": "مدخل السيارات, ممر خاص (طريق يؤدي إلى منزل خاص)\nمثال: أوقفوا سيارتهم في الممر الخاص",
 "私達": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "私領": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / وَقَّفَ, صَفَّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: ليس لدينا حديقة.",
 "秉燭": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "秋": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "秋の野罌粟": "خس هندي, مونتيا (نبات من جنس مونتيا له أوراق صالحة للأكل ذات مذاق لطيف)",
 "秋の野芥子": "خس هندي, مونتيا (نبات من جنس مونتيا له أوراق صالحة للأكل ذات مذاق لطيف)",
 "秋の麒麟草": "عصا الذهب, قضيب الذهب (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "秋分": "اعتدال خريفي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة العذراء) / اعتدال خريفي (22 سبتمبر)",
 "秋味": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "秋日": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "秋月": "قمر الحصاد (القمر المكتمل الأقرب إلى الاعتدال الخريفي (في سبتمبر))",
 "秋楡": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات) / دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "秋沙": "بلقشة (بط غواص كبير آكل للأسماك ذو عرف ومنقار نحيل معقوف بحواف مسننة)",
 "秋波": "غَمَزَ / غَمْزَة",
 "秋津": "يَعْسُوب",
 "秋津島": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "秋津洲": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "秋田蘭画": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "秋茱萸": "زَيْزَفُون / خِلَاف",
 "秋萩": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة)",
 "秋霜": "جَلَافَة",
 "秋霜烈日": "جَلَافَة",
 "秋風が吹く": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "秋風が立つ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "科": "قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / نَوْعِيَّة, جَوْدَة / دَلَال / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / غَلْطَة / غَلَط\nمثال: كان خطأ حاسوبي. / خَطِيئَة, إِثْم / أَثِمَ, أَذْنَبَ ((أَثِمَ) أثما وإثما وأثاما ومأثما: وقع في الإثم فهو أثم وآثم وأثيم وأثام وأثوم)\nمثال: أثمة ما تريد إخباري عنه؟ / زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
