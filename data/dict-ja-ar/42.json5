 "流言蜚語": "إشاعة كاذبة, فرية (تلفيق مضلل عمداً)",
 "流言飛語": "إشاعة كاذبة, فرية (تلفيق مضلل عمداً)",
 "流謫": "نَفْي, تَبْعِيد / نَفَى",
 "流賊": "سالب, ناهب (شخص يهاجم بحثاً عن الغنائم)",
 "流路": "قَنَاة",
 "流転": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟ / تَنَاسُخ الْأَرْوَاح",
 "流通": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "流通コスト": "تكلفة التوزيع (أي تكلفة يتكبدها منتج أو تاجر جملة أو تاجر تجزئة أو موزع (كما للإعلان والشحن وما إلى ذلك))",
 "流通チャネル": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "流通チャンネル": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "流通企業": "بائع بالمفرق, تاجر تجزئة (تاجر يبيع البضائع بالتجزئة)",
 "流通経路": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "流通網": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "流量": "تَدَفُّق, مُعَدَّل التَّدَفُّق (كمية السائل التي تتدفق في وقت معين)",
 "流量計": "مقياس التدفق (جهاز يستخدم لقياس معدل تدفق الكتلة أو الحجم لسائل أو غاز)",
 "流離": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "流離う": "تَجَوَّلَ",
 "流露": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "流麗": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "浄め": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "浄める": "صَفَّى",
 "浄写": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "浄化": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / تنظيف (فعل جعل الشيء نظيفاً) / الضارب الرابع ((بيسبول) المركز الرابع في ترتيب الضرب (يشغله عادة أفضل ضارب في الفريق)) / ربح طائل (ربح كبير جداً)\nمثال: قام بتنظيف حذائه جيداً",
 "浄化槽": "خزان تحليل, خزان صرف صحي (خزان كبير يتم فيه تفكيك المواد الصلبة أو مياه الصرف الصحي بواسطة البكتيريا)",
 "浄化装置": "جهاز تنقية, منقٍّ (جهاز لإزالة الشوائب)",
 "浄土": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "浄書": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "浄水器": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "浄水地": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "浄瑠璃": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "浄聖": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
