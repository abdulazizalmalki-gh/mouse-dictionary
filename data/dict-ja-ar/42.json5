 "液体に浸ける": "رَمْيَة سَاحِقَة",
 "液体に浸す": "رَمْيَة سَاحِقَة",
 "液体に漬ける": "رَمْيَة سَاحِقَة",
 "液体化": "إسالة (تحويل مادة صلبة أو غازية إلى سائل)",
 "液体石鹸": "صابون سائل (صابون في شكل سائل)",
 "液体空気": "هواء سائل (الهواء في حالة سائلة)",
 "液体窒素": "نيتروجين سائل (نيتروجين في الحالة السائلة)",
 "液体酸素": "أكسجين سائل (سائل مغناطيسي أزرق شفاف يتم الحصول عليه بضغط الأكسجين الغازي وتبريده تحت نقطة غليانه)",
 "液化": "إسالة (تحويل مادة صلبة أو غازية إلى سائل)",
 "液化天然ガス": "غَاز طَبِيعِيّ مُسَال",
 "液化石油ガス": "غاز معبأ, غاز نفطي مسال (غازات هيدروكربونية، عادة البروبان أو البوتان، محفوظة تحت الضغط)",
 "液圧プレス": "مكبس هيدروليكي (مكبس تنتقل فيه القوة المطبقة بواسطة مكبس على مساحة صغيرة عبر الماء إلى مكبس آخر ذي مساحة كبيرة)",
 "液性": "سُيُولَة (توفر النقد أو سهولة التحويل إلى نقد؛ القدرة على سداد الديون) / سيولة (خاصية التدفق بسهولة) / حالة سائلة, سائل (الحالة التي تظهر فيها المادة استعداداً مميزاً للتدفق مع ميل ضئيل أو معدوم للتشتت وعدم قابلية للانضغاط عالية نسبياً)\nمثال: إضافة الرصاص تجعل السبيكة أسهل في السكب لأن درجة الانصهار تنخفض وتزداد السيولة / خلطي (متعلق بسوائل الجسم أو الأخلاط)",
 "液晶": "بلورة سائلة (سائل يظهر خصائص البلورة التي لا تظهرها السوائل العادية)",
 "液晶テレビ": "بلورة سائلة (سائل يظهر خصائص البلورة التي لا تظهرها السوائل العادية)",
 "液晶ディスプレイ": "إل سي دي, شاشة الكريستال السائل (شاشة رقمية تستخدم خلايا الكريستال السائل التي تغير الانعكاسية في مجال كهربائي مطبق؛ تستخدم لشاشات الكمبيوتر المحمولة والساعات وما إلى ذلك)",
 "液晶パネル": "بلورة سائلة (سائل يظهر خصائص البلورة التي لا تظهرها السوائل العادية)",
 "液晶ビューカム": "بلورة سائلة (سائل يظهر خصائص البلورة التي لا تظهرها السوائل العادية)",
