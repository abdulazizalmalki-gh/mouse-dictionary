 "真字": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "真実": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "真実味": "صِدْق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "真実性": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء",
 "真帆": "مع الريح (مع الريح؛ في اتجاه هبوب الريح) / باتجاه الريح (نحو الريح) / مَعَ اتِّجَاه الرِّيح (نحو الجانب البعيد عن مصدر الرياح)\nمثال: طاروا مع الريح",
 "真平": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "真心": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "真心をこめて": "قَلْبًا وَقَالَبًا",
 "真心を込めて": "قَلْبًا وَقَالَبًا",
 "真性": "أَصْلِيّ",
 "真性コレラ": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "真成": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "真打": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "真打ち": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "真摯": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "真旗魚": "مارلين مخطط (سمكة طعام وصيد في المحيط الهادئ معلمة بخطوط عمودية زرقاء داكنة)",
 "真旦": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "真昼": "ظهر, ظهيرة (منتصف اليوم)",
 "真昼の夢": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "真木撮棒": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "真東": "الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)",
 "真核生物": "حقيقيات النوى",
 "真梶木": "مارلين مخطط (سمكة طعام وصيد في المحيط الهادئ معلمة بخطوط عمودية زرقاء داكنة)",
 "真榊": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "真横": "جَانِب / صَفْحَة",
 "真正": "أَصْلِيّ",
 "真正水平派": "حَفَّار",
 "真正直": "صَرِيح, مُسْتَقِيم",
 "真正細菌": "بكتيريا, جرثومة ((في علم الأحياء الدقيقة) كائنات وحيدة الخلية أو غير خلوية كروية أو حلزونية أو عصوية الشكل تفتقر إلى الكلوروفيل وتتكاثر بالانشطار؛ مهمة كمسببات…)",
 "真水": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "真海豚": "قَصِير المِنْقَار (ذو منقار قصير)",
 "真猿": "سَعْدَان, قِرْد",
 "真猿類": "قِرْدِيَّاتُ الشَّكْلِ",
 "真獣類": "ثدييات مشيمية, مشيميات (ثدييات لها مشيمة؛ جميع الثدييات باستثناء الكظاميات والجرابيات) / حقيقي الوحشية, مشيمي (من أو يتعلق بالثدييات المشيمية (الحقيقية))\nمثال: ثدييات مشيمية",
 "真率": "أمانة, صدق (صفة كون الشخص صادقاً) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "真珠": "لُؤْلُؤَة / لُؤْلُؤ (نوع من المجوهرات الغالية التي تكون في البحر عميقًا؛ اسم شخصي معطًى ذو استخدامات تاريخية للذكور من العرب) / جَوْهَر (جَوْهَر)\nمثال: يريد شراء عقد لؤلؤ لزوجته.",
 "真珠光沢": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "真珠取り": "غواص لؤلؤ (غواص يبحث عن الرخويات التي تحتوي على اللؤلؤ)",
 "真珠層": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真珠母": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真珠色": "رَمَادِيّ لُؤْلُؤِيّ (رمادي مع لمعة لؤلؤية)",
 "真珠貝": "محار اللؤلؤ (ذوات صدفتين بحرية استوائية توجد بشكل رئيسي قبالة شرق آسيا وساحل المحيط الهادئ لأمريكا الشمالية وأمريكا الوسطى؛ مصدر رئيسي للؤلؤ)",
 "真珠質": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真理": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "真田": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / جَدِيلَة, ضَفِيرَة (تسريحة شعر تتشكل بجدل أو لف الشعر)",
 "真田紐": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "真田編み": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / جَدِيلَة, ضَفِيرَة (تسريحة شعر تتشكل بجدل أو لف الشعر)",
 "真白": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "真皮": "أَدَمة",
 "真直": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم / غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر) / استقامة, حسن نية (امتلاك نوايا صادقة) / استقامة, مباشرة (صحة المسار نحو الهدف) / استقامة (الخلو من الانحناءات أو المنعطفات أو الزوايا)\nمثال: تصرف بحسن نية",
 "真直ぐ": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم",
 "真相": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "真相究明委員会": "تقصي الحقائق",
 "真相調査": "تقصي الحقائق",
 "真砂": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "真神": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "真秀": "مُمْتَاز, فَاخِر / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / صَرِيح, مُسْتَقِيم",
 "真空": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية؛ المِرْحَاض، الغرفة التي تقضى فيها الحاجة)\nمثال: حبب إليه الخلاء.",
 "真空容器": "حُجْرَة فَرَاغِيَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة.",
 "真空帯": "جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "真空掃除機": "مِكْنَسَة كَهْرَبَائِيَّة",
 "真空管": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "真竹": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "真筆": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "真箇": "حَقِيقِيّ / وَاقِعِيّ / رِيَال (العُمْلَة الرسمية لدى)",
 "真経津の鏡": "مِرْآة, مراية (أداة لها القابلية على عكس الضوء بطريقة تحافظ على الكثير من صفاتهما الأصلية قبل ملامسة سطح المرآة)\nمثال: أنظر في المرآة!",
 "真芯": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران)",
 "真苧": "قُنَّبُ سِيَام",
 "真菅": "سعد, عشبة السعد (نبات يشبه العشب أو الأسل ينمو في الأماكن الرطبة وله سيقان صلبة وأوراق ضيقة تشبه العشب وسنيبلات من الزهور غير الواضحة)",
 "真菌": "فُطْر ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "真菌学": "عَلْم الفَطْرِيَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "真菌感染症": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "真菌毒": "ذيفان فطري, سم فطري (ذيفان ينتجه فطر)",
 "真菌症": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "真薯": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة)",
 "真蜱": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "真裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "真西": "الغَرْب (نقطة البوصلة الأصلية التي تكون عند 270 درجة)",
 "真言": "تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا",
 "真誠": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "真諦": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "真賢木": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "真贋": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها)",
 "真赤": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "真近点離角": "شذوذ حقيقي (المسافة الزاوية لنقطة في مدار ما بعد نقطة الحضيض مقاسة بالدرجات)",
 "真逆さま": "رَأْسًا عَلَى عَقِب, مُنْدَفِع (بالرأس أولاً نحو الأمام) / برأسه أولاً, مندفعاً (بالرأس قبل الجسم) / باندفاع, بتهور (بطريقة متسرعة ومتهورة) / باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: انزلق العداء برأسه أولاً نحو القاعدة الثالثة",
 "真逆様": "رَأْسًا عَلَى عَقِب, مُنْدَفِع (بالرأس أولاً نحو الأمام) / برأسه أولاً, مندفعاً (بالرأس قبل الجسم) / باندفاع, بتهور (بطريقة متسرعة ومتهورة) / باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: انزلق العداء برأسه أولاً نحو القاعدة الثالثة",
 "真鍮": "شَبَه / صُفْر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / صُفَّر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "真青": "أَزْرَق سَمَاوِيّ, لَازَوَرْدِيّ (ذو لون أزرق عميق مائل إلى البنفسجيّ كسماء أكتوبر الصافية) / بَاهِت, ذَابِل (خفيف اللون وضعيفه؛ يفتقر إلى الحيويّة) / بَاهِت, شَاحِب (ذو لون خفيف وضعيف يفتقر إلى العمق) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت)",
 "真面": "مُمْتَاز, فَاخِر / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / صَرِيح, مُسْتَقِيم",
 "真面目": "جِدِّيّ / جَدِّيّ, جَادّ",
 "真顔": "وجه جاد (تعبير وجهي جاد لا يعطي أي دليل على الاهتمام أو التسلية)",
 "真骨類": "سمكة عظمية (سمكة عظمية من طويئفة العظميات)",
 "真髄": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "真魚鰹": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي) / سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة) / سمك الزبدة (أي من العديد من أسماك الطعام الصغيرة المفلطحة الأطلسية ذات الجلد الناعم)",
 "真鯒": "مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / مسطحة الرأس (سمكة غذائية في المنطقة الإندونيسية من المحيط الهادئ؛ تشبه الغرنار)",
 "真鯖": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "真鯛": "لغة تاي الحمراء (فرع من لغات تاي، يُتحدث به في ولاية كاتشين ومنطقة ساغينغ في بورما)",
 "真鱈": "قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي)",
 "真鴨": "بركة, بط بري (بط بري مخوض ينحدر منه البط المنزلي؛ واسع الانتشار)",
 "真麦": "قَمْح, حِنْطَة",
 "真麻": "قُنَّبُ سِيَام",
 "眠い": "نَعْسَان, نَاعِس",
 "眠たい": "نَعْسَان, نَاعِس",
 "眠らす": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "眠らせる": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "眠り": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "眠りこむ": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りにつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに付く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに就く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに着く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに落ちる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠り姫": "الْجَمِيلَة الْنَائِمَة",
 "眠り病": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "眠り草": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال) / ست الحسن, ميموزا (أي من الشجيرات أو الأشجار الاستوائية المختلفة من جنس الميموزا ذات أزهار صفراء عادة وأوراق مركبة) / سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "眠り薬": "مُخَدِّر",
 "眠り込む": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠る": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "眠れる": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "眠れる森の美女": "الْجَمِيلَة الْنَائِمَة",
 "眠剤": "مُنَوِّم",
 "眠気": "نُعَاس, سِنَة",
 "眩い": "فَاتِن, قَشِيب / مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "眩く": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "眩しい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "眩ます": "إبهار, إعشاء (سطوع يكفي للتسبب بالعمى الجزئي والمؤقت)",
 "眩めく": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "眩人": "سَاحِر",
 "眩惑": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "眩暈": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "眩瞑": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "眴せ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "眷属": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / تَابِع / مُتَابِع",
 "眷族": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / تَابِع / مُتَابِع",
 "眷顧": "مَعْرُوف / أَنْعَمَ",
 "眸子": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "眺む": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء. / عَجَبَ / لَاحَظَ, رَاقَبَ",
 "眺め": "مَنْظَر, مَشْهَد / مَشْهَد",
 "眺める": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء. / عَجَبَ / لَاحَظَ, رَاقَبَ",
 "眺め回す": "تَلَفَّتَ",
 "眺望": "مَنْظَر, مَشْهَد",
 "眼": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / نظرة ثاقبة / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / نِوَاة / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / نظرة ثاقبة / لُبّ / ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
 "眼につく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "眼に付く": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "眼を開く": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "眼を飛ばす": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "眼中": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "眼中にない": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "眼中に無い": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "眼光": "نظرة ثاقبة",
 "眼内レンズ": "عدسة داخل العين (عدسة اصطناعية تزرع في عين شخص ما لاستبدال عدسة طبيعية تالفة أو لشخص تمت إزالة إعتام عدسة العين لديه)",
 "眼内圧": "ضغط داخل العين (الضغط الذي تمارسه السوائل داخل مقلة العين؛ ينظم بواسطة مقاومة التدفق الخارجي للخلط المائي)\nمثال: يمكن أن ينتج الجلوكوما عن زيادة الضغط داخل العين",
 "眼力": "نظرة ثاقبة",
 "眼動脈": "شريان عيني (فرع من الشريان السباتي الباطن يغذي العين والتراكيب المجاورة)",
 "眼医者": "أخصائي عيون, طبيب عيون (طبيب متخصص في تشخيص وعلاج أمراض العين)",
 "眼圧": "ضغط داخل العين (الضغط الذي تمارسه السوائل داخل مقلة العين؛ ينظم بواسطة مقاومة التدفق الخارجي للخلط المائي)\nمثال: يمكن أن ينتج الجلوكوما عن زيادة الضغط داخل العين",
 "眼孔": "مِحْجَر, حَجَاج",
 "眼差し": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "眼帯": "رقعة العين (غطاء قماشي واقٍ للعين المصابة)",
 "眼底検査": "تنظير العين (فحص الجزء الداخلي من العين باستخدام منظار العين)",
 "眼房水": "خلط مائي, سائل مائي (السائل الصافي داخل مقلة العين بين القرنية والعدسة)",
 "眼指": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "眼振": "رَأْرَأَة",
 "眼杯": "كأس بصرية ((علم الأجنة) انخفاض يشبه الكوب بجدارين يتطور إلى الطبقات الصباغية والحسية للشبكية)",
 "眼点": "بقعة عينية (علامة تشبه العين (كما في أجنحة بعض الفراشات)؛ عادة ما تكون بقعة ملونة داخل حلقة بلون آخر)",
 "眼状紋": "بقعة عينية (علامة تشبه العين (كما في أجنحة بعض الفراشات)؛ عادة ما تكون بقعة ملونة داخل حلقة بلون آخر)",
 "眼球": "مُقْلَة اَلْعَيْن",
 "眼球なめ": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "眼球振盪": "رَأْرَأَة",
 "眼球突出": "جحوظ العين (بروز مقلة العين من المحجر)",
 "眼球舐め": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "眼球運動": "حركة العين (حركة العينين)",
 "眼球銀行": "بنك العيون (مكان لتخزين وحفظ القرنيات التي يتم الحصول عليها من الجثث البشرية مباشرة بعد الوفاة؛ تستخدم لزرع القرنية للمرضى الذين يعانون من عيوب القرنية)",
 "眼界": "ساحة بصرية",
 "眼疾": "مرض عيني (أي مرض يصيب العين)",
 "眼疾患": "مرض عيني (أي مرض يصيب العين)",
 "眼病": "مرض عيني (أي مرض يصيب العين)",
 "眼目": "نِوَاة",
 "眼瞼": "جَفْن (مَنَعَ نَفْسَهُ عَنْ كُلِّ مَكْرُوهٍ؛ وَضَعَ الطَّعَامَ فِي الجَفْنَةِ)",
 "眼瞼下垂": "تدلي الجفن (تدلي الجفن العلوي بسبب شلل وضعف العضلات)",
 "眼瞼炎": "التهاب الجفن (التهاب الجفون يتميز بالاحمرار والتورم والقشور الجافة)",
 "眼瞼痙攣": "تشنج الجفن (تشنج عضلة الجفن مما يؤدي إلى انغلاق العين)",
 "眼科": "طِبّ اَلْعُيُون (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "眼科医": "طَبِيب عُيُون (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "眼科学": "طِبّ اَلْعُيُون (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "眼窩": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "眼筋": "عضلة العين (واحدة من العضلات الصغيرة للعين التي تعمل على تدوير مقلة العين)",
 "眼精疲労": "إجهاد العين, وهن البصر (تعب في العين ناتج عن العمل القريب لفترات طويلة من قبل شخص يعاني من مشكلة بصرية غير مصححة)",
 "眼角動脈": "الشريان الزاوي (الفرع النهائي للشريان الوجهي)",
 "眼識": "تَفْرِيق / تَمْيِيز",
 "眼路": "ساحة بصرية",
 "眼鏡": "نظارة ((جمع) أداة بصرية تتكون من إطار يحمل زوجاً من العدسات لتصحيح الرؤية المعيبة) / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "眼鏡カイマン": "كايمان نظاراتي (كايمان ذو حواف عظمية حول العينين؛ يوجد من جنوب المكسيك إلى الأرجنتين)",
 "眼鏡ケース": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "眼鏡レンチ": "مفتاح حلقي, مفتاح مغلق (مفتاح ربط بحلقة مغلقة (لقمة) تتناسب فوق صامولة أو رأس مسمار)",
 "眼鏡入れ": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "眼鏡屋": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "眼鏡店": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "眼鏡熊": "دب أبو نظارة",
 "眼鏡猿": "تَارْسِير",
 "眼鏡蛇": "كوبرا هندية (كوبرا من أفريقيا الاستوائية وآسيا)",
 "着": "وُصُول, وِفَادَة / مَلَابِس, ثِيَاب",
 "着々": "بثبات",
 "着く": "بَلَغَ",
 "着ける": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / أْثَث ((أَثَّثَ): لين ومهد؛ (أَثَّثَ) البيت: فرشه بالأثاث) / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "着する": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着せる": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / غِطَاء / غِلَاف / غَطَّى / دَبُّوس",
 "着つける": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着る": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "着る物": "مَلَابِس, ثِيَاب",
 "着メロ": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "着付け": "غِيَار, رِبَاط / مَرَقَة, صَلْصَة (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / دَمَال / تَلَبُّس, تَرَدٍّ / لِبَاس (الزِيّ أو بعض الثياب تُلْبَس مع بعض لا جمع له؛ ما يُلْبَس من الثياب، الجمع ألْبِسَة)\nمثال: أحسن زيري اللباس. / رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى)",
 "着付ける": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着信": "وُصُول, وِفَادَة",
 "着信者": "مُسْتَلِم, مُسْتَلِمَة",
 "着信転送機能": "تحويل المكالمات (يتيح لك تحويل مكالماتك الواردة إلى أي هاتف يمكنك الاتصال به مباشرة)",
 "着信音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "着古し": "بَالٍ",
 "着味": "بَهَار, تَابِل",
 "着圧": "ضغط, كبس (تطبيق الضغط) / ضغط, ضغط البيانات (تشفير المعلومات مع تقليل النطاق الترددي أو البتات المطلوبة) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً) / تصلب, تكثيف (زيادة في كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد",
 "着地": "هُبُوط / بَسْطَة / رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع) / وِجْهَة, وُجْهَة / نَتِيجَة",
 "着地点": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع) / أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "着実": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "着床": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "着弾": "تأثير, تعدي (التأثير بقوة) / صَدْمَة, صِدَام (التفاعل العنيف بين الأفراد أو الجماعات التي تدخل في القتال) / ارتطام, صدمة (ضرب جسم لآخر) / تأثير, وقع (عاقبة قوية؛ تأثير قوي)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية",
 "着弾距離": "مدى, قدرة / مَدَى",
 "着彩": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "着御": "وُصُول, وِفَادَة",
 "着想": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "着意": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "着手": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / لعب (فعل المشاركة في لعبة أو رياضة أو ترفيه آخر) / عزف (فعل العزف على آلة موسيقية) / أداء, تمثيل (أداء دور في عمل درامي)",
 "着払": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "着払い": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "着替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "着替え所": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "着服": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "着水": "هبوط مائي (هبوط مركبة فضائية في البحر في نهاية رحلة فضائية)",
 "着氷": "تَغْطِيَة سُكَّر (وضع شيء فوق آخر لإخفائه أو حمايته؛ معالجة ونقل أخبار حدث أو موضوع معين ونشره لجمهور أو ما يصطلح عليه بالتغطية الإعلامية)\nمثال: تمت تغطية زيري. / هُبُوط / بَسْطَة",
 "着港": "وُصُول, وِفَادَة",
 "着火": "إشعال, إضرام (عملية إضرام النار في شيء ما) / نظام إشعال (الآلية التي تشعل الوقود في محرك الاحتراق الداخلي) / إشعال, اتقاد (عملية بدء الاحتراق أو اشتعال النار)",
 "着火剤": "مكعب إشعال, ولاعة فحم (قطعة من مادة تحترق بسهولة ويمكن استخدامها لبدء إشعال الفحم أو الكوك)",
 "着火材": "مكعب إشعال, ولاعة فحم (قطعة من مادة تحترق بسهولة ويمكن استخدامها لبدء إشعال الفحم أو الكوك)",
 "着物": "كِيمُونُو / مَلَابِس, ثِيَاب",
 "着物虱": "قملة الجسم (قملة طفيلية تغزو جسم البشر)",
 "着生": "عليقي, نباتي هوائي (من أو يتعلق بالنباتات الهوائية (التي تنمو على نباتات أخرى))",
 "着生植物": "نبات فوقي, نبات هوائي (نبات يستمد الرطوبة والمواد المغذية من الهواء والمطر؛ ينمو عادة على نبات آخر ولكنه لا يتطفل عليه)",
 "着用": "ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي",
 "着用品": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "着用者": "لابِس, مُرتَدٍ (شخص يرتدي أو يحمل أو يعرض شيئاً كغطاء للجسم أو زينة)\nمثال: مرتدي التاج",
 "着目": "اِهْتِمَام, اِنْتِبَاه",
