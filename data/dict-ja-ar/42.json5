 "硼珪酸塩": "بوروسيليكات (ملح لأحماض البوريك والسيليسيليك)",
 "硼砂": "بَوْرَق",
 "硼素": "بُورُون / بُور",
 "硼酸": "حمض البوريك (أي من الأحماض المختلفة التي تحتوي على البورون والأكسجين) / حمض الأرثوبوريك, حمض البوريك (مادة صلبة بيضاء أو عديمة اللون حمضية قليلاً قابلة للذوبان في الماء والإيثانول؛ تستخدم في صناعة الزجاج والورق والمواد اللاصقة وفي المنظفات وكمطهر…)",
 "硼酸塩": "بورات (ملح أو إستر لحمض البوريك)",
 "碁": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "碁盤": "لوحة غو (لوحة تستخدم للعب غو)",
 "碁盤目状": "مُرَصَّع بِالفُسَيْفِسَاء (مزين بقطع صغيرة من الزجاج أو الحجر الملون مُجمَّعة في فسيفساء) / مُتَرَصِّع, مُفَسْفَس (ذو مظهر مربّعات أو رقع ملوّنة كالفسيفساء)",
 "碁盤縞": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "碇": "مِرْسَاة, أَنْجَر / مُذِيع, مُذِيعَة / رَسَا ((رَسَا) الشيءُ يَرْسُو رَسْواً، ورُسُوّاً: ثَبَتَ؛ رَسا الجبلُ: ثَبَتَ أصَله في الأَرض)",
 "碇泊": "أَنْكُورِيج",
 "碇置": "أَنْكُورِيج",
 "碌に": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "碍子": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "碑": "لَوْحَة تِذْكَارِيَّة",
 "碑文": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "碑文学": "علم النقوش (دراسة النقوش القديمة)",
 "碑銘": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "碕": "رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "碗": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "碧": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر. / ضَوْء أَخْضَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "碧玉": "يَشْب / يَشْم",
 "碧眼紅毛": "غَرْبِيّ",
 "碧空": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "碧色": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "碧雲": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "碩儒": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "確": "أَكِيد / مُتَأَكِّد / طَبْعًا, أَكِيد / مَوْثُوق / أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "確か": "أَكِيد / مُتَأَكِّد / طَبْعًا, أَكِيد / مَوْثُوق",
 "確かなものにする": "قَوَّى, عَزَّزَ",
 "確かな物にする": "قَوَّى, عَزَّزَ",
 "確かに": "بِالتَّأْكِيد",
 "確かめ": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "確かめる": "تَأَكَّدَ",
 "確からしい": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه) / محتمل, مرجح (مرجح ولكن ليس مؤكداً أن يكون حقيقياً أو واقعياً) / مرشح مرجح (متقدم من المرجح أن يتم اختياره)\nمثال: نتيجة محتملة",
 "確からしさ": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "確けし": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "確たる": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "確と": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بِشَكْل وَاضِح, بِوُضُوح (بدرجة متميزة) / بِتَمَيُّز, بِشَكْل مُمَيَّز (بطريقة مميزة وقابلة للتمييز)\nمثال: إنه ممكن بوضوح / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "確とした": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "確乎不動": "مَنِيع",
 "確乎不抜": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "確保": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء / مربط, نقطة تأمين (شيء يمكن تثبيت حبل متسلق الجبال به)",
 "確信": "اِعْتِقَاد, عَقِيدَة\nمثال: 私は君の援助を確信している。 — أنا واثق من مساعدتك لي.",
 "確反": "عَاقَبَ, قَاصَصَ",
 "確固": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "確固不動": "مَنِيع",
 "確固不抜": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "確執": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "確定": "قَرَار, تَصْمِيم",
 "確定反撃": "عَاقَبَ, قَاصَصَ",
 "確定的": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "確定裁判": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل ما تبقى هو إنفاذ الحكم)",
 "確実": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "確実度": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "確実性": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "確然": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "確率": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "確率変数": "مُتَغَيِّر عَشْوَائِيّ",
 "確率標本": "عينة عشوائية (عينة مأخوذة بشكل عشوائي) / عينة عشوائية (عينة يكون فيها لكل عنصر في المجتمع فرصة متساوية للاختيار)",
 "確率理論": "نظرية الاحتمالات (فرع الرياضيات التطبيقية الذي يتعامل مع الاحتمالات)",
 "確率的": "عَشْوَائيّ, غَيْر مُصَمَّم",
 "確率論": "نظرية الاحتمالات (فرع الرياضيات التطبيقية الذي يتعامل مع الاحتمالات)",
 "確率過程": "عملية عشوائية (عملية إحصائية تنطوي على عدد من المتغيرات العشوائية التي تعتمد على متغير بارامتري (عادة ما يكون الوقت))",
 "確立": "تَأْسِيس / مُؤَسَّسَة",
 "確言": "إقرار, تأكيد (إعلان يتم التأكيد عليه بقوة (كما لو لم تكن هناك حاجة إلى أدلة داعمة)) / إقرار, بيان (فعل تأكيد أو إقرار أو بيان شيء ما)",
 "確証": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "確認": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "確認者": "ضامن, مزكٍّ (شخص يضمن آخر أو يشهد بصحة بيان ما)",
 "確認証": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "碼頭": "رَصِيف",
 "碾き割": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "碾き割り": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "碾き割る": "طَحَنَ (طَحَنَ؛ طِحْنٌ)",
 "碾き臼": "رحى (طاحونة حجرية بدائية لطحن الذرة باليد)",
 "碾割り": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "碾臼": "رحى (طاحونة حجرية بدائية لطحن الذرة باليد)",
 "磁力": "مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة",
 "磁力計": "مقياس المغناطيسية (مقياس لمقارنة قوة المجالات المغناطيسية)",
 "磁化": "مَغْنَطَة",
 "磁北": "الشَّمَال, الشَّمَال المِغْنَاطِيسِيّ (الاتجاه الذي تشير إليه إبرة البوصلة)",
 "磁器": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "磁器製品": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "磁土": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "磁場": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / أجواء, جو (الغلاف الجوي للبيئة المحيطة) / أجواء, جو (بيئة معينة أو تأثير محيط)\nمثال: كان هناك جو من الإثارة",
 "磁心": "نِوَاة",
 "磁性": "مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة",
 "磁束": "فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك) / تدفق مغناطيسي (مقياس لقوة المجال المغناطيسي عبر مساحة معينة)",
 "磁束密度": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "磁束計": "مقياس التدفق المغناطيسي (مقياس يقيس التدفق المغناطيسي عن طريق التيار الذي يولده في ملف)",
 "磁気": "مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة",
 "磁気インク": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة استشعار مغناطيسية)",
 "磁気コアメモリ": "ذاكرة القلب المغناطيسي (ذاكرة كمبيوتر تتكون من مصفوفة من القلوب المغناطيسية؛ تم استبدالها الآن بذواكر أشباه الموصلات)",
 "磁気コンパス": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "磁気ストライプ": "شريط مغناطيسي (شريط قصير من الشريط المغناطيسي ملحق ببطاقة ائتمان أو بطاقة خصم؛ يحتوي على بيانات تخبر جهاز القراءة بهويتك ورقم حسابك، إلخ)",
 "磁気テープ": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل الإشارات الصوتية أو الفيديو أو لتخزين معلومات الحاسوب)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "磁気ディスク": "قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين المعلومات عليها)",
 "磁気ドラム": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "磁気ヘッド": "رأس مغناطيسي (مغناطيس كهربائي (كما في مسجل الشريط) يحول التغيرات الكهربائية إلى تغيرات مغناطيسية يمكن تخزينها على سطح واسترجاعها لاحقاً)",
 "磁気モーメント": "عَزْم مَغْنَاطِيسِيّ",
 "磁気偏差": "اختلاف مغناطيسي, انحراف مغناطيسي (الزاوية (في موقع معين) بين الشمال المغناطيسي والشمال الحقيقي)",
 "磁気共鳴": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم الفضاء في مجال مغناطيسي)",
 "磁気共鳴映像法": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "磁気共鳴画像": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "磁気力": "جذب مغناطيسي, مغناطيسية (الانجذاب للحديد؛ يرتبط بالتيارات الكهربائية وكذلك المغناطيسات؛ ويتميز بمجالات القوة)",
 "磁気単極子": "أُحَادِيّ القُطْب المِغْنَاطِيسِيّ (جسيم افتراضي له قطب مغناطيسي واحد بدلاً من القطبين المعتادين)",
 "磁気双極子": "ثنائي قطب مغناطيسي (ثنائي قطب بأقطاب مغناطيسية متضادة)",
 "磁気圏": "غلاف مغناطيسي (المجال المغناطيسي لكوكب؛ الحجم حول الكوكب الذي تخضع فيه الجسيمات المشحونة للمجال المغناطيسي للكوكب أكثر من المجال المغناطيسي الشمسي)",
 "磁気子午線": "خط الزوال المغناطيسي (خط وهمي يمر عبر كلا القطبين المغناطيسيين للأرض)",
 "磁気学": "علم المغناطيسية, مغناطيسية (فرع العلوم الذي يدرس المغناطيسية)",
 "磁気嵐": "عاصفة مغناطيسية (اضطراب مفاجئ في المجال المغناطيسي للأرض؛ ناتج عن انبعاث جسيمات من الشمس)",
 "磁気抵抗率": "ممانعة مغناطيسية ((في الفيزياء) مقاومة المادة لإنشاء مجال مغناطيسي فيها)",
 "磁気機雷": "لغم مغناطيسي ((بحري) لغم بحري يتم تفجيره بواسطة آلية تستجيب للمواد المغناطيسية (مثل الهيكل الفولاذي للسفينة))",
 "磁気流体力学": "ديناميكا الموائع المغناطيسية (دراسة تفاعل المجالات المغناطيسية والموائع الموصلة للكهرباء (مثل البلازما أو المعدن المنصهر))",
 "磁気浮上": "رفع مغناطيسي, ماجليف (تكنولوجيا سكك حديدية عالية السرعة؛ حيث يُعلق القطار على وسادة مغناطيسية فوق مسار ممغنط ويسافر دون احتكاك)",
 "磁気能率": "عَزْم مَغْنَاطِيسِيّ",
 "磁気記憶装置": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات المخزنة من المعلومات)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "磁気誘導": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي) / تمغنط, مغنطة (العملية التي تجعل المادة مغناطيسية (مؤقتاً أو بشكل دائم))",
 "磁流鉄鉱": "بايريت مغناطيسي, بيروتيت",
 "磁界": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "磁界強度": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "磁石": "مَغْنَاطِيس / بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "磁石盤": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "磁硫鉄鉱": "بايريت مغناطيسي, بيروتيت",
 "磁製": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "磁針": "إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى اتجاه القطب المغناطيسي للأرض)",
 "磁鉄鉱": "ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "磁鉱": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق)) / ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "磁電管": "ماجنترون, مغناطيسون (أنبوب مفرغ ثنائي الصمام يتم فيه التحكم في تدفق الإلكترونات من كاثود مركزي إلى أنود أسطواني بواسطة مجالات مغناطيسية وكهربائية متقاطعة؛ يستخدم بشكل…)",
 "磊々落々": "صَرِيح, مُنْفَتِحُ القَلْب (يتواصل بحرّيّة وصراحة ومباشرة) / خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها)",
 "磊塊": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "磊嵬": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "磊磈": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "磊磊落落": "صَرِيح, مُنْفَتِحُ القَلْب (يتواصل بحرّيّة وصراحة ومباشرة) / خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها)",
 "磊落": "إِفْرَنْجِيّ",
 "磐": "صَخْرَة, حجر / صَخْرَة / رُوك, مُوسِيقَى اَلرُّوك / جُرْفٌ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "磐境": "ضَرِيح",
 "磐石": "ثَبَات",
 "磔": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "磔刑": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "磔刑像": "وضعية الصليب (تمرين جمباز يُؤدى على الحلقات عندما يدعم لاعب الجمباز نفسه بذراعين ممدودتين أفقياً) / الصليب المصلوب, الصليب المقدس (تمثيل للصليب الذي مات عليه يسوع)",
 "磔柱": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "磚": "طُوبَة, لَبِنَة",
 "磠砂": "كلوريد الأمونيوم, ملح النشادر (ملح أبيض يستخدم في الخلايا الجافة)",
 "磨き": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / تَحْسِين",
 "磨きこむ": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨きをかける": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ) / بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨きを掛ける": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ) / بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨き液": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨き立てる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨き紙": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "磨き込む": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨く": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "磨ぐ": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / غَسَلَ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي. / مجرف, مكان محفور (مكان تم حفره (خاصة بالمياه الجارية))",
 "磨りつぶす": "خلطة علفية, هريس (خليط من أعلاف الحيوانات المطحونة) / نقيع الشعير, هريس (خليط من حبوب الشعير المهروسة والماء الساخن؛ يستخدم في التخمير) / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "磨りガラス": "زجاج مصنفر (زجاج يشتت الضوء بسبب خشونة سطحه الناتجة عن الكشط أو الحفر) / مسحوق الزجاج (زجاج مفتت ناتج عن الطحن ويستخدم كمادة كاشطة)",
 "磨り出し": "تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "磨り出す": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "磨り消す": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى",
 "磨り減らす": "كَشَطَ, قَشَطَ",
 "磨り潰す": "خلطة علفية, هريس (خليط من أعلاف الحيوانات المطحونة) / نقيع الشعير, هريس (خليط من حبوب الشعير المهروسة والماء الساخن؛ يستخدم في التخمير) / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "磨損": "إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)",
 "磨石": "مِسَنّ, مِجْلَخَة",
 "磨研紙": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "磨砕": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "磨羯宮": "بُرْج اَلْجَدْي (ظهر وارتفع) / اَلْجَدْي\nمثال: وصل كارل إلى برج آخر.",
 "磨耗": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "磨面": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "磬": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "磯": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "磯べ": "سَاحِل, شَاطِئ",
 "磯城島": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "磯波": "تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ)",
 "磯辺": "سَاحِل, شَاطِئ",
 "磯釣": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "磯釣り": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "礁": "شَعَاب",
 "礎": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "礎石": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "礙子": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "礦石": "رِكَاز, خَامَة",
 "礪茶": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "礫": "حَصَاة / حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر. / حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "礬土": "أكسيد الألمنيوم, ألومينا (أي من أشكال أكسيد الألمنيوم المختلفة التي توجد بشكل طبيعي مثل الكورندوم)",
 "示し": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس. / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "示し合せる": "تَآمَرَ, اِئْتَمَرَ",
 "示し合わす": "تَآمَرَ, اِئْتَمَرَ",
 "示し合わせる": "تَآمَرَ, اِئْتَمَرَ",
 "示す": "تَظَاهَر, احْتَجَّ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / أَشَارَ / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "示唆": "اِقْتِرَاح, مُقْتَرَح",
 "示唆的": "إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "示圧計": "مقياس الضغط (مقياس لقياس ضغط السوائل والإشارة إليه)",
 "示威": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "示威行為": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "示威運動": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "示導動機": "لايت موتيف, لحن دال (جملة لحنية تصاحب ظهور شخص أو موقف معين (كما في أوبرا فاغنر))",
 "示差": "تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً) / تفاضلي (ينطوي على أو يحتوي على مشتق واحد أو أكثر (في الرياضيات)) / ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات) / عَامِل تَفَاضُل, فَارِق (صفة تميز بين الأشياء المتشابهة)\nمثال: معاملة تفاضلية",
 "示差的特徴": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "示度": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة) / دَلَالَة, مُؤَشِّر (شيء (كمسار عمل) يشار إليه على أنه مناسب أو ضروري) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء) / استطباب, دعي الاستعمال ((طب) سبب لوصف دواء أو إجراء عملية)\nمثال: لم يصدق قراءة العداد",
 "示性値": "رَقَم الجَوْدَة, مُعَامِل الجَدَارَة (تعبير رقمي يمثل كفاءة نظام أو مادة أو إجراء معين)",
 "示指": "سبابة (الإصبع المجاور للإبهام)",
 "示教": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "示準化石": "أحفورة مرشدة (أحفورة معروفة بأنها عاشت في عصر جيولوجي معين ويمكن استخدامها لتأريخ طبقة الصخور التي توجد فيها)",
 "示現": "مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي)) / تجلي, مظهر (دلالة واضحة لوجود أو حضور أو طبيعة شخص أو شيء ما) / انعكاس, تعبير (تعبير بدون كلمات) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "示達": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "礼": "شُكْرًا / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "礼す": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "礼には及ばない": "عَفْوًا",
 "礼やか": "أَدِيب, مُؤَدَّب",
 "礼を言う": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "礼事": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "礼儀": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "礼儀作法": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "礼儀正しい": "مُهَذَّب, مُؤَدَّب",
 "礼儀正しさ": "أَدَب (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "礼儀知らず": "فَظّ",
 "礼典": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "礼式": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "礼拝": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "礼拝堂": "مُصَلًّى, كَنِيسَة (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد)",
 "礼拝式": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "礼拝所": "مَعْبَد",
 "礼服": "فستان منزلي صباحي (فستان نسائي غير رسمي للأعمال المنزلية) / زي صباحي رسمي (زي رسمي للرجال خلال النهار)",
 "礼法": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "礼物": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "礼状": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "礼砲": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "礼節": "حشمة, ذوق (اللياقة في الأخلاق والسلوك)",
 "礼譲": "ألفة, مجاملة (حالة أو جو من الانسجام أو الكياسة والاحترام المتبادل)",
 "礼讃": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "礼賛": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "礼金": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "社": "ضَرِيح / سَرِيَّة / شَرِكَة / ضَرِيح / كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "社不": "شاذ, غير متكيف (شخص غير قادر على التكيف مع ظروفه)",
 "社中": "فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "社交": "تفاعل اجتماعي, تواصل (التواصل بين الأفراد)",
 "社交クラブ": "جمعية, رابطة (رابطة رسمية لأشخاص لديهم اهتمامات مماثلة)\nمثال: انضم إلى نادي الجولف",
 "社交ダンス": "رقص الصالونات (أي من مجموعة متنوعة من الرقصات الاجتماعية التي يؤديها الأزواج في قاعة الرقص)",
 "社交不安障害": "اِضْطِرَاب الْقَلَقِ الاِجْتِمَاعِي",
 "社交場": "حمامات معدنية, منتجع صحي (منتجع صحي يقع بالقرب من نبع أو عند شاطئ البحر)",
 "社交室": "صَالَة, قَاعَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "社交性": "ألفة, حب الاختلاط (الميل النسبي أو الاستعداد ليكون المرء اجتماعياً أو يختلط بأقرانه)",
 "社交服": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "社交界": "مُجْتَمَع رَاقِيّ (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية)\nمثال: سامي خطر للمجتمع.",
 "社交的": "أَنِيس, اجْتِمَاعِيّ (وَدُودٌ وَلَطِيفٌ فِي المُعَامَلَةِ) / أليف, أنيس (يميل إلى الرفقة مع الآخرين أو يؤدي إليها) / تجمع اجتماعي, لقاء تعارفي (حفلة تجمع الناس لتعزيز الروابط الاجتماعية والنشاط الجماعي)\nمثال: مناسبة اجتماعية",
 "社交辞令": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "社会": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "社会の窓": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "社会システム": "بنية اجتماعية, تنظيم اجتماعي (الناس في مجتمع يُنظر إليهم كنظام منظم بنمط مميز من العلاقات)\nمثال: التنظيمات الاجتماعية في إنجلترا وأمريكا مختلفة جداً",
 "社会不安障害": "حَزِين, زعلان / مُحْزِنٌ",
