 "気違い": "جُنُون / شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما)",
 "気違い水": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "気違い沙汰": "جُنُون",
 "気違い茄子": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "気違茄子": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "気遣い": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "気遣わしい": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "気配": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة)\nمثال: لم يصدق قراءة العداد / نَغْمَة, نَغْم",
 "気配り": "اِهْتِمَام",
 "気鋭": "مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط)",
 "気長": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "気門": "متنفس (فتحة تنفسية)",
 "気閘": "غُرْفَةُ مُعَادَلَةِ الضَّغْط (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "気随": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "気障": "مُتَأَثِّر (وقع عليه فعل أو تأثير)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "気障ったらしい": "مُتَأَثِّر (وقع عليه فعل أو تأثير)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "気障っぽい": "مُتَأَثِّر (وقع عليه فعل أو تأثير)\nمثال: متأثر جداً لدرجة عدم القدرة على الكلام",
 "気障り": "بَغِيض, غَيْر مَقْبُول (ليس على هواك)\nمثال: موقف بغيض",
 "気難しい": "صَعْب / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "気難し屋": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "気音": "صوت مهموس, هاء (صامت يُنطق مع نَفَس مسموع)",
 "気韻": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة…)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة.",
 "気風": "شَخْصِيَّة\nمثال: زيري سيء الخلق.",
 "気骨": "عَمُود فَقْرِيّ / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気高い": "رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ)",
 "気鬱": "قتامة, كآبة (شعور بتوجس كئيب)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "気鬱症": "مُنْخَفَض",
 "氛氳": "دَجِر",
 "氣": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / طَبِيعَة, طبيعة / قَصْد, إِرَادَة / مَزَاج",
 "氤氳": "نَشِيط",
 "水": "مِيَاه / سَائِل, مَائِع / طُوفَان, فَيَضَان (عاصفة) / الْأَرْبِعَاء, يَوْم الْأَرْبِعَاء / مِيَاه",
 "水あか": "فَرْو",
 "水あげ": "هُبُوط / لُقْطَة\nمثال: كنت أمسك بالكرة. / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة) / تَصَرُّف",
 "水あめ": "شراب الذرة (شراب محضر من الذرة)",
 "水いぼ": "مليساء معدية (مرض فيروسي يصيب الجلد يتميز بتورمات بيضاء مستديرة؛ ينتقل من شخص لآخر (غالبًا…)",
 "水いらず": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "水いらずで": "بشكل خاص, سراً (محتفظ به كسر أو مقتصر على المعنيين بالأمر)\nمثال: نوقش الأمر سراً",
 "水おけ": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / صِهْرِيج, فِنْطَاس (حوض تجتمع فيه الماء؛ وسيلة النقل التي تنقل الماء)\nمثال: الصهريج مملوء بالماء.",
 "水かき": "ويب / مِضْرَب",
 "水がめ": "إبريق ماء, جرة ماء (إبريق يحفظ الماء)",
 "水がん": "أكلة الفم, نوما (تقرح حاد في الأغشية المخاطية للفم أو الأعضاء التناسلية)",
 "水きり台": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "水ぎせる": "شِيشَة, نَارْجِيلَة",
 "水くさい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم)",
 "水け": "رُطُوبَة / بُخَار مَاء (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من…)\nمثال: السحابة هي كتلة بخار في السماء. / اِسْتِسْقَاء",
 "水こし": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "水こぼし": "دلو الفضلات السائلة (دلو كبير يستخدم لاستقبال مياه الصرف من حوض الغسيل)",
 "水しぶき": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "水すまし": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水たまり": "غَدِير, بِرْكَة",
 "水だめ": "بالوعة, بيارة (صهريج مغطى؛ تتدفق إليه مياه الصرف الصحي والمجاري)",
 "水っぱな": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "水っぽい": "رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق)",
 "水っ洟": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "水で薄める": "خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة.",
