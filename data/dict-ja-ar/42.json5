 "治療費": "نفقة طبية (المبلغ المنفق لتشخيص أو علاج أو الوقاية من المشاكل الطبية)",
 "治癒": "شِفَاء",
 "治績": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "治者": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة.",
 "治験": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "治験者": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "沼": "نَعْصَة, مُسْتَنْقَع / هَوَس / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "沼倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沼地": "مستنقع عشبي, هور (أرض رطبة منخفضة ذات غطاء نباتي عشبي؛ عادة ما تكون منطقة انتقالية بين اليابسة…)\nمثال: آلاف الأفدنة من المستنقعات",
 "沼尻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沼杉": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية)",
 "沼気": "غاز المستنقعات (غاز الميثان الناتج عن تحلل النباتات في الماء)",
 "沼沢": "نَعْصَة, مُسْتَنْقَع",
 "沼沢地": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "沼沢植物": "نبات المستنقعات (نبات شبه مائي ينمو في الأراضي الرطبة الرخوة؛ معظمها من ذوات الفلقة الواحدة:…)",
 "沼田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沼田場": "حمام طين (حمام في الطين الدافئ (لعلاج الروماتيزم مثلاً))",
 "沼蛙": "أرز بري (حبوب عشب مائي من أمريكا الشمالية)",
 "沼間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沽券": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة…)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "沿い": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "沿う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان. / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "沿って": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
