 "海軍将官": "أَمِيرُ البَحْر, أَدْمِيرَال",
 "海軍工廠": "ترسانة بحرية عسكرية (حوض بناء سفن عسكري)",
 "海軍特殊部隊": "جندي قوات خاصة بحرية, نيفي سيل (عضو في وحدة الحرب الخاصة البحرية مدرب على الحرب غير التقليدية (خاصة في الولايات…)",
 "海軟風": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "海辺": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "海運": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد)\nمثال: 海運会社に勤めています。 — أعمل لدى شركة شحن.",
 "海里": "مِيل بَحْرِيّ",
 "海野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "海錨": "مرساة عائمة (قيد يتكون من إطار مغطى بالقماش يطفو خلف السفينة؛ يمنع الانجراف أو يحافظ على…)",
 "海門": "مَضِيق, مُخْتَنَق (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "海難": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "海難救助": "صَلَاة اَلْعَصْر, عَصْر",
 "海震": "زلزال بحري (زلزال في قاع البحر)",
 "海面": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "海面上昇": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "海面下": "تَحْتَ بَحْرِيّ, غَوَّاصِيّ (تحت سطح البحر)",
 "海面変動": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "海面変化": "مُسْتَوَى سَطْح البَحْر (مستوى سطح المحيط (خاصة المتوسط بين المد والجزر)؛ يُستخدم كمعيار في حساب ارتفاع…)",
 "海鞘": "بخاخ البحر (زقاقية يمكنها تقليص جسمها وقذف تيارات من الماء)",
 "海風": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "海食柱": "كَوْمَة",
 "海馬": "فَظّ / فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه…) / أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ) / حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي) / حصين (بنية عصبية معقدة (تشبه حصان البحر) تتكون من مادة رمادية وتقع على أرضية كل بطين…) / فَظّ",
 "海馬状隆起": "حصين (بنية عصبية معقدة (تشبه حصان البحر) تتكون من مادة رمادية وتقع على أرضية كل بطين…)",
 "海驢": "أَسَد بَحْر, كَلْب البَحْر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة…)",
 "海魚": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "海鮮": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "海鮮醤": "صلصة البط, صلصة هويسين (تابل صيني سميك حلو ولاذع)",
 "海鰓": "قلم البحر (مستعمرات لحمية تشبه الريش تعيش في المياه الدافئة)",
 "海鱒": "ترويت بحري (نوع بحري فضي اللون من الترويت البني يهاجر إلى المياه العذبة للتكاثر)",
 "海鱮": "شوب البحر (أسماك تعيش في أسراب غالباً في المحيط الهندي وغرب المحيط الهادئ؛ نوعان في غرب…)",
 "海鳥": "طائر بحري (طائر يتردد على المياه الساحلية والمحيط المفتوح: النوارس، البجع، الأطيش، الغاق…)",
 "海鳥糞": "جوانو, ذرق الطيور (فضلات الطيور البحرية؛ تستخدم كسماد)",
 "海鳩": "غلموت الحمام (غلموت شمال المحيط الهادئ)",
 "海鴉": "مور شائع (أكثر أنواع طائر المور شيوعاً)",
 "海鷂魚": "شُعَاع",
 "海鷲": "عقاب البحر (أي من العقبان الكبيرة المتنوعة التي تتغذى عادة على الأسماك)",
 "海鼠": "خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "海鼠売": "خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "海鼠売り": "خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "海鼠板": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "浸ける": "اِبْتَلَّ\nمثال: 彼はスプーンをスープの中につけた。 — هو غمس ملعقته في الحساء.",
 "浸け置き": "نقع (غسل شيء عن طريق تركه منقعاً في سائل)\nمثال: نقعه بالماء نقعاً",
 "浸す": "اِبْتَلَّ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / مُبْتَلّ",
 "浸入": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع…)\nمثال: تخلل مياه الأمطار عبر التربة",
 "浸出": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع…)\nمثال: تخلل مياه الأمطار عبر التربة",
 "浸剤": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة)\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "浸水": "فيضان",
 "浸漬": "نقع (غسل شيء عن طريق تركه منقعاً في سائل)\nمثال: نقعه بالماء نقعاً",
 "浸潤": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع…)\nمثال: تخلل مياه الأمطار عبر التربة / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "浸礼教会": "الكنيسة المعمدانية, المعمدانيون (أي من مختلف الكنائس البروتستانتية الإنجيلية التي تؤمن بمعمودية المؤمنين الطوعيين)",
 "浸透": "تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "浸透圧": "ضغط أسموزي, ضغط تناضحي ((في الكيمياء الفيزيائية) الضغط الذي يمارسه محلول واللازم لمنع التناضح إلى ذلك…)",
 "浸透性": "خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "浸透探傷検査": "بِي, پِي",
 "浸食": "تآكل, حت (تآكل بفعل العمليات الكيميائية)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "涅槃": "اَلنِّرْفَانَا / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "涅色": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان…)\nمثال: لديه قميص أسود.",
 "消えうせる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "消えうせろ": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي!",
 "消えてなくなる": "اِنْقَرَضَ",
 "消えないインク": "حبر لا يمحى (حبر لا يمكن مسحه أو غسله)",
 "消えゆく": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "消える": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / اِبْتَعَدَ",
 "消え去る": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "消え失せる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "消え失せろ": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي!",
 "消え残る": "نَجَا",
 "消え行く": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "消し": "نَقْص",
 "消しこみ": "صُلْح, مُصَالَحَة",
 "消した": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "消しゴム": "مِمْحَاة",
 "消し印": "خَتْم بَرِيدِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "消し去る": "تَخَلَّصَ ؛ مِن",
 "消し止める": "أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "消し炭": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ:…)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "消し込み": "صُلْح, مُصَالَحَة",
 "消す": "مَحَا, مَحَى / أَطْفَأَ / نَقَلَ\nمثال: لا أزال عطشانا. / اِتَّسَعَ, اِحْتَوَى\nمثال: دفع زيري الثمن.",
 "消する": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "消ずる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "消ゆ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "消光": "اِنْقِرَاض / إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "消化": "هَضْم / اِسْتِهْلَاك",
 "消化不良": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا. / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "消化剤": "هَضْمِيّ",
 "消化器学": "طب الجهاز الهضمي (فرع الطب الذي يدرس الجهاز الهضمي وأمراضه)",
 "消化性潰瘍": "قرحة هضمية",
 "消化液": "عصارة هضمية (إفرازات تساعد على الهضم)",
 "消化管": "جهاز هضمي, قناة هضمية (ممر أنبوبي من الغشاء المخاطي والعضلات يمتد حوالي 8.3 متر من الفم إلى الشرج…)",
 "消化管間質腫瘍": "لُبّ",
 "消化系": "جِهَاز هَضْمِيّ",
 "消化腺": "غدة هضمية (أي غدة لها قنوات تصب إفرازاتها في القناة الهضمية)",
 "消印": "خَتْم بَرِيدِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "消却": "شطب, محو (الحذف عن طريق الشطب أو المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو / رَدّ, مُعَامَلَة بِالمِثْل (عمل جماعي متبادل)\nمثال: في المقابل، أعطيناهم بقدر ما حصلنا عليه",
 "消去": "شطب, محو (الحذف عن طريق الشطب أو المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو / حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)\nمثال: حذف ياني حسابه. / اِنْقِرَاض",
 "消去法": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)\nمثال: حذف ياني حسابه.",
 "消夏": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "消失": "اِخْتِفَاء",
 "消失点": "نقطة التلاشي (مظهر نقطة في الأفق تلتقي عندها الخطوط المتوازية)",
 "消息": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من…)\nمثال: هذه أخبار طيبة. / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "消息を絶つ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "消息不明": "لا يمكن تتبعه, مجهول المصدر (يستحيل تتبعه أو تعقبه)\nمثال: مصدر لا يمكن تتبعه",
 "消息子": "مِسْبَار",
 "消息文": "رسالة شخصية (رسالة تتعلق بالشؤون الشخصية)",
 "消息通": "مُطَّلِع",
 "消散": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "消極": "مَبْنِيٌّ لِلْمَجْهُول / زوال الاستقطاب (فقدان القطبية أو الاستقطاب) / كاثود, مهبط (قطب كهربائي سالب الشحنة وهو مصدر الإلكترونات التي تدخل جهازاً كهربائياً)",
