 "汪汪": "ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة)",
 "汰る": "هَزَّ",
 "汲々": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "汲み上げる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "汲み入れる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "汲み取り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "汲み取り便所": "مِرْحَاض خَارِجِيّ",
 "汲み取り式便所": "مِرْحَاض, تواليت",
 "汲み取る": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "汲む": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا / وَرَثَ",
 "汲上げる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "汲汲": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "決": "قَرَار, تَصْمِيم",
 "決して": "يَوْمًا",
 "決す": "قَرَّرَ, صَمَّمَ",
 "決する": "قَرَّرَ, صَمَّمَ / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "決って": "دَائِمًا, أَبَدًا",
 "決まった": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "決まって": "دَائِمًا, أَبَدًا",
 "決まり": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / مُسْتَعْمَرَة, مُسْتَوْطَنَة / عَادَة / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "決まりが悪い": "مُحْرَج, بِٱلْحَرَج",
 "決まりきった": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه)\nمثال: قطعة خشب مثبتة",
 "決まりごと": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "決まり事": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "決まり切った": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه)\nمثال: قطعة خشب مثبتة",
 "決まり悪い": "مُحْرَج, بِٱلْحَرَج",
 "決まり手": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها)",
 "決まり文句": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "決まる": "نَجَحَ",
 "決め": "اِتِّفَاق, تَوَافُق",
 "決めうち": "دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "決めこむ": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決めつける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "決める": "قَرَّرَ, صَمَّمَ / التحام ((ملاكمة) فعل أحد الملاكمين بالإمساك بالآخر لتجنب التعرض للضرب وللراحة لحظياً)\nمثال: تعال هنا وأعطني حضنًا كبيرًا / سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "決め付ける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
