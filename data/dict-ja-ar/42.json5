 "油菜": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "油薬": "مِلَاط, جِبْس / مَرْهَم, دَهُون",
 "油虫": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "油角鮫": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "油送管": "خط أنابيب نفط (خط أنابيب يستخدم لنقل النفط)",
 "油送船": "نَاقِلَةُ نِفْط, نَاقِلَةُ نَفْط",
 "油酸": "حمض الأوليك (سائل زيتي عديم اللون يحدث كغليسريد؛ هو الحمض الدهني الرئيسي في زيت الزيتون وزيت الكانولا؛ يُستخدم في صنع الصابون ومستحضرات التجميل والمراهم وزيوت…)",
 "油頁岩": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "油魚": "سَمَنْدَل",
 "油鮫": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "治": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة. / سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / شِفَاء / شَفَى",
 "治す": "شِفَاء / شَفَى",
 "治する": "شِفَاء / شَفَى / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "治まり": "نَتِيجَة / رَصِيد",
 "治まる": "أَهْدَأَ, هَدَّأَ",
 "治む": "حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / طَوَّعَ, تَغَلَّبَ عَلَى",
 "治める": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / طَوَّعَ, تَغَلَّبَ عَلَى",
 "治り": "شِفَاء, تَعَافِي",
 "治る": "شُفِيَ, بَرِئَ",
 "治世": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "治具": "جيغ (أي من الرقصات الريفية القديمة المختلفة التي تتضمن الركل والقفز) / ركيزة تشغيل, مثبتة (جهاز يثبت قطعة العمل ويوجه الأدوات العاملة عليها) / رقاص صيد (طعم للصياد بخطاف واحد أو أكثر يتم تحريكه لأعلى ولأسفل في الماء) / جيغ (موسيقى في زمن ثلاثة أرباع لرقص الجيغ)",
 "治国": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "治安": "أمن عام, سلم (الأمن العام للأماكن العامة)\nمثال: تم القبض عليه بتهمة إقلاق السلم العام",
 "治安出動": "أمن عام, سلم (الأمن العام للأماكن العامة)\nمثال: تم القبض عليه بتهمة إقلاق السلم العام",
 "治安部隊": "أمن خاص, قوة أمنية (مجموعة موظفة بشكل خاص لحماية أمن شركة أو صناعة)",
 "治山": "تشجير (تحويل الأراضي الجرداء أو المزروعة إلى غابة (أصلاً لغرض الصيد))",
 "治水": "السيطرة على الفيضانات ((هندسة) فن أو تقنية محاولة السيطرة على الأنهار بالسدود وغيرها لتقليل حدوث الفيضانات)",
 "治略": "إدارة, حكم (فعل الحكم؛ ممارسة السلطة) / إدارة, المؤسسة (الأشخاص (أو اللجان أو الأقسام وما إلى ذلك) الذين يشكلون هيئة لغرض إدارة شيء ما)\nمثال: لوائح لحكم سجون الولاية",
 "治病": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "治療": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "治療不可能": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "治療不能": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "治療法": "شِفَاء / شَفَى",
 "治療的クローニング": "استنساخ طبي حيوي, استنساخ علاجي (زرع نووي لخلايا المريض نفسه لصنع خلية بيضية يمكن منها استخلاص خلايا متوافقة مناعياً (خاصة الخلايا الجذعية) للزرع)",
 "治療的流産": "إجهاض علاجي (إجهاض مفتعل قانونياً لأسباب طبية (مثل تهديد حياة الأم))",
 "治療者": "المعالج",
 "治療薬": "عِلَاج, تِرْيَاق / تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "治療費": "نفقة طبية (المبلغ المنفق لتشخيص أو علاج أو الوقاية من المشاكل الطبية)",
 "治癒": "شِفَاء",
 "治績": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "治者": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "治験": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "治験者": "تجربة سريرية (اختبار محكوم بصرامة لدواء جديد أو جهاز طبي جراحي جديد على البشر)",
 "沼": "نَعْصَة, مُسْتَنْقَع / هَوَس / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "沼倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沼地": "مستنقع عشبي, هور (أرض رطبة منخفضة ذات غطاء نباتي عشبي؛ عادة ما تكون منطقة انتقالية بين اليابسة والماء)\nمثال: آلاف الأفدنة من المستنقعات",
 "沼尻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沼杉": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية) / سرو البرك / سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "沼気": "غاز المستنقعات (غاز الميثان الناتج عن تحلل النباتات في الماء)",
 "沼沢": "نَعْصَة, مُسْتَنْقَع",
 "沼沢地": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "沼沢植物": "نبات المستنقعات (نبات شبه مائي ينمو في الأراضي الرطبة الرخوة؛ معظمها من ذوات الفلقة الواحدة: السعادى، الطحالب، الأعشاب، البردي، إلخ؛ وربما الخلنج)",
 "沼田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沼田場": "حمام طين (حمام في الطين الدافئ (لعلاج الروماتيزم مثلاً))",
 "沼蛙": "أرز بري (حبوب عشب مائي من أمريكا الشمالية)",
 "沼間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沽券": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "沿い": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "沿う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "沿って": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "沿ドニエストル": "تْرَانْسْنِيسْتْرِيَا",
 "沿層": "بِاتِّجَاه الحَافَّة, مِن الحَافَّة (مع الحافة للأمام أو على، بواسطة، أو نحو الحافة) / بِالكِاد, بِشَقّ الأَنْفُس (كما لو كان بحافة؛ بالكاد)\nمثال: نشر اللوح من الحافة",
 "沿層坑道": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "沿岸": "سَاحِل, شَاطِئ",
 "沿岸部": "خط الساحل (المخطط الخارجي للساحل)",
 "沿海": "سَاحِل, شَاطِئ",
 "沿海地方": "بْرِيمُورْسْكِي كْرَاي",
 "沿路": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "沿道": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "沿革": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "況や": "نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "況んや": "نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "泉": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "泉下": "هَادِيس",
 "泉塩": "مِلْح, ملح / مَلَّحَ",
 "泉川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "泉州": "تْشْيُوَانْتْشُو, تْشْيُوَانْجُو",
 "泉水": "نَافُورَة, فَوَّارَة",
 "泉貨": "قِرْش, عُمْلَة",
 "泉質": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "泉門": "مقتل, نقطة ضعف (مكان ذو قابلية خاصة للإصابة) / يافوخ (أي فجوة غشائية بين عظام الجمجمة عند الرضيع أو الجنين) / معزة خاصة, نقطة ضعف (عاطفة وجدانية)\nمثال: كانت لديها معزة خاصة لابنها الأصغر",
 "泉頭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "泊": "إِقَامَة",
 "泊まり": "مَكَثَ, بَقِيَ / إِقَامَة / خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / أَنْكُورِيج",
 "泊まり込む": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "泊めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "泊める": "غَلِقَ (ق. (فعل: ثلاثي لازم). غَلِقَ، يَغْلَقُ، مصدر غَلَقٌ؛ غلِقَ يَغلَق، غَلَقًا، فهو غَلِق)\nمثال: أعاد زيري غلق الخيمة.",
 "泊り": "مَكَثَ, بَقِيَ / إِقَامَة / خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / أَنْكُورِيج",
 "泊り客": "ضيف المنزل (ضيف يتم استقباله في منزلك)",
 "泊り賃": "تَعَارِيف, تَعْرِفَة / تَعَارِيف",
 "泊り込む": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "泊地": "أَنْكُورِيج",
 "泌乳": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي) / إدرار الحليب, رضاعة (إنتاج وإفراز الحليب بواسطة الغدد الثديية) / رضاعة, فترة الرضاعة (الفترة التي تلي الولادة والتي يتم خلالها إفراز الحليب)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "泌乳量": "إدرار الحليب, محصول الحليب (كمية الحليب التي تنتجها البقرة)\nمثال: الموسيقى الهادئة يمكن أن تحسن إدرار الحليب",
 "泌尿": "تبول (إخراج البول)",
 "泌尿器": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "泌尿器科": "طب المسالك البولية (فرع الطب الذي يتعامل مع تشخيص وعلاج اضطرابات المسالك البولية أو الجهاز البولي التناسلي)",
 "泌尿器科医": "طبيب مسالك بولية (أخصائي في طب المسالك البولية)",
 "泌尿器科学": "طب المسالك البولية (فرع الطب الذي يتعامل مع تشخيص وعلاج اضطرابات المسالك البولية أو الجهاز البولي التناسلي)",
 "法": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / مُنْحَدَر / مَيْل / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / طَرِيقَة, مِنْهَج / مَزَاج / دَارْمَا",
 "法の下の平等": "المساواة أمام القانون (الحق في الحماية المتساوية للقوانين)",
 "法の支配": "سيادة القانون (حالة من النظام تتوافق فيها الأحداث مع القانون)",
 "法の網": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "法主": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "法人": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "法人化": "إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "法人組織にする": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "法令": "قانون تشريعي, نظام أساسي (قانون تم تمريره من قبل هيئة تشريعية)",
 "法令線": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "法令遵守": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "法令順守": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "法体系": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "法典化": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي) / دستور, مدونة (مجموعة من القواعد أو المبادئ أو القوانين (وخاصة المكتوبة منها))",
 "法制": "تَشْرِيع / شَرِيعَة, قَانُون (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟",
 "法制化": "تشريع, سن القوانين (عملية سن أو تشريع القوانين)",
 "法制審議会": "مجلس تشريعي (هيئة تشريعية مكونة من مجلس واحد)",
 "法制度": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "法則": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "法則性": "اطِّرَاد, انْتِظَام (صفة الاتصاف بمبدأ ثابت أو معدل ثابت) / انتظام, انتظام هندسي (خاصية للمضلعات: خاصية امتلاك أضلاع متساوية وزوايا متساوية)\nمثال: كان مشهوراً بانتظام عاداته",
 "法助動詞": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو الضرورة)",
 "法動詞": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو الضرورة)",
 "法務官": "قاضٍ عسكري, محامٍ عسكري (ضابط أركان يعمل كمستشار قانوني لقائد عسكري) / محامٍ عسكري (ضابط معين في مكتب المحامي العام للقضاء العسكري) / بريتور, قاضٍ روماني (قاضٍ منتخب سنوياً في الجمهورية الرومانية القديمة)",
 "法務総監": "محامٍ عام للقضاء العسكري (المستشار القانوني الأقدم لفرع من فروع الجيش)",
 "法医": "جِنائِيّ",
 "法医学": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "法博": "دكتوراه في القانون (درجة قانون فخرية)",
 "法域": "قَضَاء / اِخْتِصَاص",
 "法執行": "إنفاذ القانون (ضمان طاعة القوانين)",
 "法場": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "法外": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "法学": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "法学士": "بكالوريوس في القانون (درجة في القانون مدتها ثلاث سنوات)",
 "法学者": "حاكم, قاضي (مسؤول عام مخول بالفصل في المسائل المعروضة على محكمة العدل) / حقوقي, فقيه قانوني (باحث قانوني متمكن في القانون المدني أو قانون الأمم)",
 "法学部": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "法宇": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "法官": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "法定": "قَانُونِيّ",
 "法定代理人": "ممثل قانوني (ممثل شخصي ذو صفة قانونية (مثل التوكيل الرسمي أو منفذ الوصية))",
 "法定休日": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "法定伝染病": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "法定外公共物": "ممتلكات عامة (ممتلكات تملكها الحكومة)",
 "法定年齢": "السن القانوني, سن الرشد (السن الذي يعتبر فيه الأشخاص مؤهلين لإدارة شؤونهم الخاصة)",
 "法定強姦": "مُجَامَعَة قَاصِر",
 "法定推定相続人": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "法定準備率": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على دفع عدد كبير غير عادي من عمليات السحب عند الطلب إذا حدث ذلك)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "法定相続人": "وريث شرعي (الشخص المخول قانوناً بوراثة ممتلكات شخص يموت دون وصية)",
 "法定通貨": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "法家": "مُحَامٍ, مُحَامِيَة / التزام حرفي بالقانون, قانونية حرفية (الامتثال الصارم لحرفية القانون بدلاً من روحه)",
 "法師": "أُقْنُوم / فَرْد",
 "法度": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ) / حَظْر ((حَظَّرَ): بالغ في الحظر) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: حرم الإسلام الترويع / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "法廷": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "法廷侮辱": "اِزْدِرَاء المَحْكَمَة (عدم احترام قواعد محكمة قانونية)",
 "法廷侮辱罪": "اِزْدِرَاء المَحْكَمَة (عدم احترام قواعد محكمة قانونية)",
 "法廷弁護士": "محامي مرافعة (محامٍ بريطاني أو كندي يتحدث في المحاكم العليا نيابة عن الدفاع أو الادعاء)",
 "法式": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "法律": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "法律上": "قَانُونِيّ",
 "法律事務所": "شركة محاماة, مكتب محاماة (شركة من المحامين)",
 "法律制度": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "法律婚": "شَرْعًا, قَانُونِيًّا (بموجب القانون؛ مطابق للقانون) / بحكم القانون, شرعي (بحق؛ وفقاً للقانون)\nمثال: نحن متزوجان قانونياً الآن",
 "法律学": "إجْتِهَاد, فِقْه",
 "法律学者": "مُحَامٍ, مُحَامِيَة",
 "法律家": "مُحَامٍ, مُحَامِيَة",
 "法律案": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "法律的": "قَانُونِيّ",
 "法律行為": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "法悦": "نَشْوَة",
 "法整備": "تَشْرِيع / شَرِيعَة, قَانُون (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟",
 "法文化": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي) / دستور, مدونة (مجموعة من القواعد أو المبادئ أو القوانين (وخاصة المكتوبة منها))",
 "法曹": "مهنة المحاماة, نقابة المحامين (مجموعة الأفراد المؤهلين لممارسة القانون في ولاية قضائية معينة)\nمثال: تم قبوله في نقابة المحامين في نيو جيرسي",
 "法服": "روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "法案": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "法案審議": "مُنَاقَشَة, بَحْث",
 "法楽": "تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع))\nمثال: الإبحار هو هوايتها المفضلة",
 "法治主義": "دستورية (الدعوة لنظام حكم وفقاً لمبادئ دستورية) / دستورية (نظام حكم دستوري (عادة بوجود دستور مكتوب))",
 "法治社会": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "法王": "بَابَا / حَبْر أَعْظَم ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / حَبْر ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / الْبَابَا, الْأَب\nمثال: لا تكتب بالحبر. / بُوذَا, بُدّ",
 "法王庁": "الكوريا, الكوريا الرومانية ((الكنيسة الرومانية الكاثوليكية) الإدارة المركزية التي تحكم الكنيسة الرومانية الكاثوليكية)",
 "法王権": "البابوية (حكومة الكنيسة الرومانية الكاثوليكية)",
 "法理": "مبدأ قانوني, مبدأ قضائي ((قانون) مبدأ يقوم عليه صياغة الفقه القانوني)",
 "法理学": "إجْتِهَاد, فِقْه",
 "法界": "كَوْن, الْكَوْن",
 "法界無縁": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "法的": "قَانُونِيّ",
 "法的手続き": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية)",
 "法的措置": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "法的文書": "سند, صك قانوني ((في القانون) وثيقة تنص على علاقة تعاقدية أو تمنح حقاً ما)",
 "法的行為": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "法相": "حقيقة, صحة (المطابقة للواقع أو الفعليّة)",
 "法科": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "法科大学院": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "法科学": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "法網": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "法線": "عَادِيّ / طَبِيعِيّ",
 "法螺": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم) / كونش, محار الملك",
 "法螺を吹く": "تَبَاهَى",
 "法螺吹き": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "法螺話": "خُرَافَة, قِصَّة مُبَالَغ فِيهَا (قصة غير محتملة (غير عادية أو لا تصدق أو خيالية))",
 "法螺貝": "كونش, محار الملك",
 "法術": "طَرِيقَة, مِنْهَج / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "法衣": "رداء كهنوتي (ثوب (وخاصة الملابس الاحتفالية) يرتديه رجال الدين)",
 "法要": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)",
 "法規": "تَشْرِيع / شَرِيعَة, قَانُون (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟",
 "法規制": "تَنْظِيم",
 "法語": "مَوْعِظَة, خُطْبَة",
 "法論": "إجْتِهَاد, فِقْه",
 "法輪功": "فَالُون غُونْغ, فَالُون دَافَا",
 "法輪大法": "فَالُون غُونْغ, فَالُون دَافَا",
 "法院": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "法面": "مُنْحَدَر / مَيْل",
 "泛かべる": "طَفَا, عَامَ / طَفَا / ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "泛べる": "طَفَا, عَامَ / طَفَا / ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "泡": "فُقَّاعَة",
 "泡々": "فَقَّاعِيّ, مَرِح (مليء بالبهجة والمرح أو يُظهرهما) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير) / شامبانيا (نبيذ أبيض فوار يُنتج إما في منطقة شامبانيا أو يشبه ذلك المنتج هناك)",
 "泡が立つ": "فُقَّاعَة",
 "泡だち": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "泡だて器": "خفاقة البيض (خلاط لخفق البيض أو الكريمة) / مروحية, هليكوبتر (طائرة بدون أجنحة تحصل على رفعها من دوران شفرات علوية)",
 "泡ぶく": "فُقَّاعَة",
 "泡吹虫": "نطاط الضفدع (نوع من حشرة البصاق)",
 "泡姫": "عامل بالجنس, عاملة بالجنس (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "泡沫": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا) / كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "泡沫会社": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "泡沫夢幻": "مُؤَقَّت, سَريع الزوال",
 "泡沫的": "مُؤَقَّت, سَريع الزوال",
 "泡泡": "فَقَّاعِيّ, مَرِح (مليء بالبهجة والمرح أو يُظهرهما) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير) / شامبانيا (نبيذ أبيض فوار يُنتج إما في منطقة شامبانيا أو يشبه ذلك المنتج هناك)",
 "泡立ち": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير)",
 "泡立つ": "فُقَّاعَة",
 "泡立てる": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "泡立てクリーム": "قِشْدَة مَخْفُوقة",
 "泡立て器": "خفاقة البيض (خلاط لخفق البيض أو الكريمة) / مروحية, هليكوبتر (طائرة بدون أجنحة تحصل على رفعها من دوران شفرات علوية)",
 "泡箱": "غرفة الفقاقيع (جهاز يسجل مسارات الجسيمات المؤينة)",
 "泡銭": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "泡風呂": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / رغوة الحمام (مستحضر بلوري أو مسحوق أو سائل يُرغي في ماء الاستحمام ويعطره وينعمه) / جَاكُوزِي",
 "波": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة / مَيْل, نَزَعَة / بُولَنْدَا, بُولُونِيَا (دولة تقع في وسط أوروبا. اسمها الرسمي: جمهورية بولندا. عاصمتها وأكبر مدينة فيها: وارسو)\nمثال: أظن أننا ما زلنا في بولندا.",
 "波うつ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة\nمثال: 彼女は胸を波打たせた。 — رفعت صدرها.",
 "波しぶき": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "波の花": "مِلْح, ملح / مَلَّحَ",
 "波よけ": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "波ダッシュ": "تِلْدَة",
 "波並": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "波乗り": "رَكْمَجَة, رَكُوب أَمْوَاج",
 "波乗り板": "لوح ركوب الأمواج (لوح ضيق طافٍ لركوب الأمواج)",
 "波乱": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي / تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "波動": "تموج, موجة ((في الفيزياء) حركة صعود وهبوط أو جيئة وذهاباً) / تموج (حركة تشبه الموج؛ ارتفاع وانخفاض لطيف بطريقة الأمواج) / تموج, موجة (منحنى متموج) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "波動方程式": "معادلة موجية (معادلة تفاضلية تصف مرور الموجات التوافقية عبر وسط ما)",
 "波動説": "نظرية موجية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كموجات)",
 "波動関数": "دَالَّة مَوْجِيَّة",
 "波及": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "波型": "مُمَوَّج (ذو تموّجات وتعرّجات متوازية على السطح)",
 "波多野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "波布": "ذُو بُقَع صَفْرَاء (عليه بقع صفراء اللون)",
 "波布草": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "波平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "波形": "شَكْل مَوْجِيّ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "波形鋼板": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "波戸": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "波打ち際": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "波打つ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة\nمثال: 彼女は胸を波打たせた。 — رفعت صدرها.",
 "波打際": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "波数": "عَدَد مَوْجِيّ (مقلوب الطول الموجي للموجة)",
 "波斯": "فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "波束": "قطار أمواج (تتابع من الأمواج المتباعدة بفترات منتظمة)",
 "波来土": "بيرليت (خليط صفائحي من السمنتيت والفيريت يتشكل أثناء تبريد الأوستنيت؛ أحد مكونات الفولاذ والحديد الزهر)",
 "波止": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "波止場": "رَصِيف",
 "波浪": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "波浪注意報": "أعالي البحار, مياه دولية (البحار المفتوحة في العالم خارج المياه الإقليمية لأي دولة)",
 "波消しブロック": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "波瀾": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي / تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "波状": "مُتَمَوِّج, مُجَعَّد (غير مستوٍ بسبب وجود تجاعيد أو موجات)",
 "波状熱": "حمى مالطية, حمى متموجة (مرض بكتيري معد يصيب البشر ينتقل عن طريق الاتصال بالحيوانات المصابة أو اللحوم أو منتجات الألبان المصابة؛ يتميز بالحمى والصداع) / إجهاض معدي, حمى مالطية (مرض معد يصيب الحيوانات الأليفة يؤدي غالبًا إلى الإجهاض التلقائي؛ يمكن أن ينتقل إلى البشر)",
 "波田野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "波立つ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "波紋": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / تموج ((في الإلكترونيات) تذبذب ذو سعة صغيرة مفروض فوق قيمة ثابتة) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "波線符号": "تِلْدَة",
 "波羅蜜": "كَمَال, إتقان / جاكية",
 "波羅蜜多": "كَمَال, إتقان",
 "波腹": "بطن الموجة, نقطة التضاد ((في الفيزياء) نقطة الإزاحة القصوى في نظام دوري)",
 "波長": "طُول مَوْج (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "波除け": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "波頭": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "波風": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام) / مَشَقَّة, شِدَّة",
 "波飛沫": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "泣いた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "泣いても笑っても": "مَهْمَا",
 "泣かせ": "إِزْعَاج",
 "泣き": "بُكَاء",
 "泣きしきる": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣きじゃくる": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "泣きつく": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "泣きどころ": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "泣きべそをかく": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "泣きまね": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "泣きみそ": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين) / جبان, ضعيف الشخصية (شخص يفتقر إلى الثقة، متردد وضعيف الإرادة)",
 "泣きわめく": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣きゲー": "لَعْبَةْ فِيدِيُو (اللَعْبَة البَرْبَرية دواء عشبيّ)",
 "泣き付く": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "泣き入る": "فجأة بدأ يبكي",
 "泣き出す": "فجأة بدأ يبكي\nمثال: 彼女は今にも泣き出しそうだった。 — كادت أن تبكي.",
 "泣き叫ぶ": "صرخة / صَرَخَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "泣き味噌": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين) / جبان, ضعيف الشخصية (شخص يفتقر إلى الثقة، متردد وضعيف الإرادة)",
 "泣き喚く": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣き声": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "泣き寝入り": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "泣き悲しむ": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣き所": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "泣き真似": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "泣き立てる": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣き脅し": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "泣き落とし": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "泣き虫": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين) / جبان, ضعيف الشخصية (شخص يفتقر إلى الثقة، متردد وضعيف الإرادة)",
 "泣き言": "شِكَايَة, شَكْوَى",
 "泣き頻る": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣く": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "泣くに泣けない": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "泣く子も黙る": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً)",
 "泣く泣く": "باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته / بتردد, على مضض (مع تردد أو عدم رغبة)",
 "泣付く": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "泣入る": "فجأة بدأ يبكي",
 "泣寝入り": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "泣悲しむ": "رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "泣脅し": "قِصَّة اسْتِعْطَاف, قِصَّة حَزِينَة (قصة عاطفية (أو دراما) عن ضائقة شخصية؛ مصممة لإثارة التعاطف)",
 "泣虫": "بكاء, كثير الشكوى (شخص يميل إلى الشكوى المفرطة والبكاء والأنين) / جبان, ضعيف الشخصية (شخص يفتقر إلى الثقة، متردد وضعيف الإرادة)",
 "泥": "طِين, وَحْل / لِصّ, لِصَّة / أَنْدْرُويِد",
 "泥だんご": "حشرة, دنيء (شخص ذو شخصية سيئة أو غير أخلاقية لا يستحق الاحترام)",
 "泥まみれ": "مُغَطًّى بِالطِّين, مُوحَل (متّسخ وفوضويّ؛ مغطّى بالوحل أو الطين) / عَكِر, مُتَكَدِّر (عكر بسبب الرواسب أو الترسّبات؛ يُقال عن السوائل) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء)",
 "泥まんじゅう": "فطيرة طين (كتلة من الطين شكلها طفل على شكل فطيرة)",
 "泥よけ": "واقي الطين (قطعة منحنية فوق عجلة دراجة أو دراجة نارية لحماية الراكب من الماء أو الطين الذي تقذفه العجلات) / مِصَدّ",
