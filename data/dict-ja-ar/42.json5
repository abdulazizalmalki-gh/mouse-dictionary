 "租税回避": "تجنب ضريبي (تقليل المسؤولية الضريبية إلى الحد الأدنى بطرق قانونية)",
 "租税回避地": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "租税避難地": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "秣": "عَلَف",
 "秤": "مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "秤動": "مَيَسَان",
 "秤量": "وَزْن",
 "秦": "تشين, سلالة تشين (السلالة الصينية (من 246 قبل الميلاد إلى 206 قبل الميلاد) التي أسست أول حكومة إمبراطورية مركزية وبنت جزءاً كبيراً من سور الصين العظيم)",
 "秦皮葉の楓": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "秩序": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "秩序整然": "منضبط, منظم (خالٍ من العنف أو الاضطراب) / مُنَظَّم, نَظِيف (نَظِيفٌ أَوْ مُنَظَّمٌ بِشَكْلٍ جَيِّد) / تمرجي, ساعي المستشفى (مرافق مستشفى ذكر لديه واجبات عامة لا تشمل العلاج الطبي للمرضى) / جندي مراسلة, مراسل (جندي يعمل كمساعد لضابط أعلى رتبة)\nمثال: حشد منظم واجه الرئيس",
 "秩序正しい": "منضبط, منظم (خالٍ من العنف أو الاضطراب) / مُنَظَّم, نَظِيف (نَظِيفٌ أَوْ مُنَظَّمٌ بِشَكْلٍ جَيِّد) / تمرجي, ساعي المستشفى (مرافق مستشفى ذكر لديه واجبات عامة لا تشمل العلاج الطبي للمرضى) / جندي مراسلة, مراسل (جندي يعمل كمساعد لضابط أعلى رتبة)\nمثال: حشد منظم واجه الرئيس",
 "秩序立てる": "نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء.",
 "秩父三十四所": "أَرْبَعَة وَثَلَاثُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "秭": "سِبْتِيلْيُون (العدد الذي يمثله واحد متبوعاً بـ 24 صفراً)",
 "称": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / شُهْرَة",
 "称え": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "称える": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "称す": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "称する": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "称号": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "称呼": "تسمية المنشأ (مؤشر جغرافي يستخدم لتحديد المكان الذي يُزرع فيه العنب للنبيذ) / تسمية, لقب (كلمة أو كلمات تعريفية يُدعى بها شخص أو شيء ويُصنف أو يتميز بها عن الآخرين) / رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "称嘆": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "称揚": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "称歎": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "称美": "إِعْجَاب",
 "称賛": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "移しかえる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / منقول المصفوفة (مصفوفة تتشكل عن طريق تبديل الصفوف والأعمدة لمصفوفة معطاة)",
 "移し変える": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / منقول المصفوفة (مصفوفة تتشكل عن طريق تبديل الصفوف والأعمدة لمصفوفة معطاة)",
 "移し換える": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / منقول المصفوفة (مصفوفة تتشكل عن طريق تبديل الصفوف والأعمدة لمصفوفة معطاة)",
 "移し替え": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移し替える": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / منقول المصفوفة (مصفوفة تتشكل عن طريق تبديل الصفوف والأعمدة لمصفوفة معطاة)",
 "移す": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / أَنْفَقَ, صَرَفَ / قَضَى / أَعْدَى",
 "移り": "تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "移りゆく": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "移り住む": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "移り変り": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "移り変る": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "移り変わり": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "移り変わる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "移り気": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "移り行く": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "移る": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "移ろい": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت",
 "移ろう": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "移住": "هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "移住労働者": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "移住民": "مُهَاجِر, مُهَاجِرَة",
 "移住者": "مُهَاجِر, مُهَاجِرَة",
 "移入": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / نَقَلَ / نَقْل",
 "移出": "نَقَلَ / نَقْل",
 "移動": "حَرَكَة / مُنْتَقِل / مُتَنَقِّل",
 "移動労働者": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "移動図書館": "مكتبة متنقلة (شاحنة مغلقة بها أرفف كتب؛ تعمل كمكتبة متنقلة أو مكتبة لبيع الكتب)",
 "移動式": "مُنْتَقِل / مُتَنَقِّل",
 "移動性": "حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية) / مُنْتَقِل / مُتَنَقِّل",
 "移動端末": "سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية)) / مخطوطة (شكل العمل الأدبي المقدم للنشر) / ماجستير العلوم (درجة الماجستير في العلوم) / تصلب متعدد (اضطراب عصبي تدريجي مزمن ينطوي على فقدان غمد المايلين حول ألياف عصبية معينة)",
 "移動車": "دمية, لعبة (نسخة صغيرة من شخص؛ تستخدم كلعبة) / دولي, عربة نقل يدوية (وسيلة نقل تتكون من منصة ذات عجلات لنقل الأشياء الثقيلة) / دولي, عربة الكاميرا (وسيلة نقل تتكون من حامل بعجلات يمكن تثبيت الكاميرا عليه)",
 "移動電話": "جَوَّال, هَاتِف مَحْمُول (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "移受換": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移替": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "移染": "اِمْتِصَاص",
 "移植": "زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر)\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية / زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر) / زراعة الأعضاء, نقل الأعضاء (عملية نقل عضو من كائن حي (المتبرع) إلى آخر (المتلقي))\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية / الباب العالي (البلاط العثماني في القسطنطينية)",
 "移植可能性": "قَابِلِيَّة الحَمْل (صفة كون الشيء خفيفاً بما يكفي لحمله)",
 "移植性": "قَابِلِيَّة الحَمْل (صفة كون الشيء خفيفاً بما يكفي لحمله)",
 "移植手術": "زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر) / زراعة الأعضاء, نقل الأعضاء (عملية نقل عضو من كائن حي (المتبرع) إلى آخر (المتلقي))\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية",
 "移植片": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "移民": "هِجْرَة, مُهَاجَرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية. / مُهَاجِر, مُهَاجِرَة",
 "移民労働者": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "移民団": "مستعمر, مستوطن (شخص يستقر في مستعمرة جديدة أو ينتقل إلى بلد جديد)",
 "移流": "نقل أفقي ((في الأرصاد الجوية) النقل الأفقي للحرارة أو غيرها من الخصائص الجوية)",
 "移監": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移籍": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移行": "تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移行性": "قَابِلِيَّة الحَمْل (صفة كون الشيء خفيفاً بما يكفي لحمله) / انتقالي (من أو يتعلق بالانتقال أو يتميز به)\nمثال: المراهقة هي مرحلة انتقالية بين الطفولة والبلوغ",
 "移設": "انتقال, نقل السكن (عملية تغيير مكان إقامتك أو عملك) / إعادة توطين, نقل (نقل الناس (كعائلة أو مستعمرة) إلى مستوطنة جديدة (كما بعد اضطراب من نوع ما))\nمثال: يقولون أن ثلاثة انتقالات تعادل حريقاً واحداً",
 "移調": "تغيير المقام, نقل موسيقي ((موسيقى) العزف بمقام مختلف عن المقام المقصود؛ تحريك طبقة الصوت لمقطوعة موسيقية لأعلى أو لأسفل) / عكس, قلب (فعل عكس الترتيب أو المكان) / تبادل المواقع ((كهرباء) إعادة ترتيب المواقع النسبية لخطوط الطاقة لتقليل تأثيرات السعة والحث المتبادل) / نقل ((رياضيات) نقل كمية من أحد جانبي المعادلة إلى الجانب الآخر مع تغيير الإشارة)\nمثال: كتب كتابًا دراسيًا عن التأثيرات الكهربائية لتبادل المواقع",
 "移譲": "تسليم, تمرير (عملية تمرير شيء ما لشخص آخر)",
 "移転": "مُتَحَرِّك / مُؤَثِّر / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移転支出": "مدفوعات تحويلية (إنفاق عام (كما هو الحال بالنسبة لتعويضات البطالة أو مزايا المحاربين القدامى) ليس مقابل سلع وخدمات)",
 "移送": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "移項": "تغيير المقام, نقل موسيقي ((موسيقى) العزف بمقام مختلف عن المقام المقصود؛ تحريك طبقة الصوت لمقطوعة موسيقية لأعلى أو لأسفل) / عكس, قلب (فعل عكس الترتيب أو المكان) / تبادل المواقع ((كهرباء) إعادة ترتيب المواقع النسبية لخطوط الطاقة لتقليل تأثيرات السعة والحث المتبادل) / نقل ((رياضيات) نقل كمية من أحد جانبي المعادلة إلى الجانب الآخر مع تغيير الإشارة)\nمثال: كتب كتابًا دراسيًا عن التأثيرات الكهربائية لتبادل المواقع",
 "移駐": "مُتَحَرِّك / مُؤَثِّر",
 "稀": "نَادِر / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / نَادِر",
 "稀に見る": "نَادِر",
 "稀ガス": "غَازٌ خَامِل",
 "稀世": "نَادِر",
 "稀代": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "稀土": "عنصر أرضي نادر, لانثانيد (أي عنصر من سلسلة اللانثانيدات (الأعداد الذرية من 57 إلى 71))",
 "稀土類": "عنصر أرضي نادر, لانثانيد (أي عنصر من سلسلة اللانثانيدات (الأعداد الذرية من 57 إلى 71))",
 "稀土類元素": "عنصر أرضي نادر, لانثانيد (أي عنصر من سلسلة اللانثانيدات (الأعداد الذرية من 57 إلى 71))",
 "稀少": "نَادِر",
 "稀少価値": "تَأَنُّق مُتَكَلَّف, تَحَذْلُق (صفة التشدد أو الإفراط في التهذيب والتأنق) / قيمة لا تقدر بثمن, نفاسة (الجودة الإيجابية لكون الشيء ثميناً ويفوق القيمة) / تكلفة باهظة, نفاسة (الجودة التي يمتلكها شيء ذو سعر أو قيمة كبيرة)",
 "稀少品": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / رقة, ندرة (جودة التخلخل (قلة الكثافة)) / ندرة (ندرة ملحوظة)\nمثال: رقة الغلاف الجوي العلوي",
 "稀有": "نَادِر",
 "稀薄": "رَفِيع, رَقِيق / ضعيف, ضعيفة / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "稀覯": "نَادِر",
 "稃": "بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "稈": "قصبة (ساق نباتات الفصيلة النجيلية)",
 "程": "اِتِّسَاع, مَدَّى / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "程々": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "程々に": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / باعتدال (مع الاعتدال)\nمثال: كبير جداً",
 "程なく": "قَرِيبًا, سَرْعَانَ مَا",
 "程なくして": "قَرِيبًا, سَرْعَانَ مَا",
 "程に": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / لِأَنَّ / هكذا, بلا سبب",
 "程ほど": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "程ほどに": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / باعتدال (مع الاعتدال)\nمثال: كبير جداً",
 "程よい": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "程よく": "بشكل محق, عن حق (بصدق؛ كما هو مبرر)\nمثال: اعتبر عن حق أعظم مغني في عصره",
 "程合い": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب) / إِشْرَاف\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "程好い": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "程度": "دَرَجَة",
