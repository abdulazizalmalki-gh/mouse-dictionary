 "眉一つ動かさない": "الحصى الحية, ليثوبس",
 "眉唾": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "眉唾もの": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "眉唾物": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "眉墨": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "眉宇": "حَاجِب (قوس الشعر فوق كل عين) / جبهة, جبين (جزء الوجه فوق العينين) / قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة",
 "眉庇": "حافة أمامية, قناع (حافة تبرز إلى الأمام لتظليل العينين) / قناع الخوذة (قطعة من الدرع الصفيحي (ذات شقوق للعين) مثبتة أو مفصلية بخوذة من العصور الوسطى لحماية الوجه)\nمثال: سحب حافة قبعته لأسفل ومشى بجهد للأمام",
 "眉斑": "حَاجِب (قوس الشعر فوق كل عين)",
 "眉月": "هِلَال",
 "眉根を寄せる": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "眉毛": "حَاجِب",
 "眉目": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "眉目秀麗": "جَمِيل (حَسَن) / وَسِيم\nمثال: طقس اليوم جميل.",
 "眉茶じない": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "眉茶𪃹": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "眉間": "حَاجِب (قوس الشعر فوق كل عين) / جبهة, جبين (جزء الوجه فوق العينين) / قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة",
 "眉雪": "أَبْيَض ثَلْجِيّ (بلون أبيض كبياض الثلج)",
 "看す": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "看る": "اِهْتَمَّ, اِعْتَنَى",
 "看取": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "看取り": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة. / خنفساء ساعة الموت (تحفر في الخشب وتصدر صوتاً يشبه دقات الساعة يعتقد شعبياً أنه ينذر بالموت) / قمل الكتب (حشرات دقيقة غير مجنحة من رتبة سوكوبترا ضارة بالكتب والأوراق)",
 "看取る": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "看守": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "看守者": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "看守長": "آمِر سِجْن",
 "看客": "مُشَاهِد, رَاءٍ",
 "看板": "لَافِتَة, لَوْحَة / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / سُمْعَة, شُهْرَة / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "看板倒れ": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "看点": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "看病": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "看病人": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "看的": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "看破": "قِرَاءَة",
 "看視": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "看視人": "نَاطُور",
 "看護": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "看護人": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
