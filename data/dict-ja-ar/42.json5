 "相銀": "بنك ادخار متبادل (بنك ادخار مرخص من الدولة ومملوك للمودعين فيه ويديره مجلس أمناء)",
 "相関": "اِرْتِبَاط",
 "相関係数": "الارتباط, معامل الارتباط (إحصائية تمثل مدى التقارب في التباين بين متغيرين؛ يمكن أن تتراوح من -1 (ارتباط سلبي تام) مروراً بـ 0 (لا يوجد ارتباط) إلى +1 (ارتباط إيجابي تام))\nمثال: ما هو الارتباط بين هذين المتغيرين؟",
 "相関性": "نسبية (صفة كون الشيء نسبياً وله دلالة فقط عند ربطه بشيء آخر) / نسبية, نظرية النسبية ((فيزياء) النظرية القائلة بأن المكان والزمان مفاهيم نسبية وليست مطلقة)",
 "相関的": "تَرَابُطِيّ, تَلَازُمِيّ (يعبر عن علاقة تبادلية أو تكاملية) / مُتَرَابِطٌ, مُتَلَازِمٌ (مرتبط ارتباطاً متبادلاً) / متغير مترابط (أي من متغيرين أو أكثر مرتبطين أو متكاملين)",
 "相関詞": "تَرَابُطِيّ, تَلَازُمِيّ (يعبر عن علاقة تبادلية أو تكاملية) / مُتَرَابِطٌ, مُتَلَازِمٌ (مرتبط ارتباطاً متبادلاً) / متغير مترابط (أي من متغيرين أو أكثر مرتبطين أو متكاملين)",
 "相関関係": "اِرْتِبَاط",
 "盾": "مِجَنّ, تُرْس / وَقَى, حَمَى (حَمى شخصًا أو شيئًا من خطرٍ أو أذى؛ اتخذ الاحتياطات اللازمة لتجنب وقوع الضرر)\nمثال: 盾の両面を見よ。 — انظر إلى جانبي الدرع. / ذَرِيعَة, عُذْر",
 "盾座": "مِجَنّ, تُرْس / وَقَى, حَمَى (حَمى شخصًا أو شيئًا من خطرٍ أو أذى؛ اتخذ الاحتياطات اللازمة لتجنب وقوع الضرر)",
 "盾状地": "مِجَنّ, تُرْس / وَقَى, حَمَى (حَمى شخصًا أو شيئًا من خطرٍ أو أذى؛ اتخذ الاحتياطات اللازمة لتجنب وقوع الضرر)",
 "盾突く": "عَصَى",
 "省": "وِزَارَة / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى. / خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "省く": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "省みる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "省察": "اِنْعِكَاس, عَكْس",
 "省庁": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "省思": "اِنْعِكَاس, عَكْس",
 "省略": "إِغْفَال / اِخْتِصَار",
 "省略形": "اِخْتِصَار",
 "省略時": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "省略符号": "نقاط الحذف (واحدة من سلسلة من النقاط ('؛') تشير إلى أن شيئاً ما قد تم حذفه أو أن الجملة غير مكتملة)",
 "省略記号": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "省筆": "إِغْفَال",
 "省都": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "眇": "حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف) / صَغِير, صغير / حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف)",
 "眇々": "طَفِيف",
 "眇たる": "صَغِير, صغير",
 "眇める": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "眇眇": "طَفِيف",
 "眈々": "بِجَشَع, بِطَمَع (بطريقة جشعة) / بِحَسَد, بِغَيْرَة (مع الغيرة؛ بطريقة حاسدة)\nمثال: نظر إلى سيارة صديقه الجديدة بحسد",
 "眈眈": "بِجَشَع, بِطَمَع (بطريقة جشعة) / بِحَسَد, بِغَيْرَة (مع الغيرة؛ بطريقة حاسدة)\nمثال: نظر إلى سيارة صديقه الجديدة بحسد",
