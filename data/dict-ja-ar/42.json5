 "消防艇": "قارب إطفاء (قارب مجهز لمكافحة الحرائق على السفن أو على طول الواجهة البحرية)",
 "消防車": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "消防車両": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "消防隊": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "消除": "حذف, شطب (عملية حذف شيء مكتوب أو مطبوع) / استئصال, حذف (الإسقاط الذي يحدث عندما يختصر التغيير التحريري مقطعاً مكتوباً) / حذف ((في علم الوراثة) فقدان أو غياب نيوكليوتيد واحد أو أكثر من الكروموسوم) / حذف (أي عملية يتم فيها ترك أصوات أو كلمات من الكلمات أو العبارات المنطوقة)\nمثال: حذوفات المحرر كثيراً ما تزعج المؤلفين الشباب",
 "消音": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "消音器": "كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / كوفية, لفحة (وشاح يلبس حول الرقبة) / كاتم صوت (جهاز صوتي أنبوبي يدرج في نظام العادم مصمم لتقليل الضوضاء)",
 "消音装置": "كَاتِم, كَاتِم الصَّوْت",
 "涌かす": "رَبَّى",
 "涌き": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "涌き出る": "تَدَفُّق / تَدَفَّقَ, سَالَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "涌井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "涌水": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "涌泉": "نَافُورَة, فَوَّارَة",
 "涎": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "涎をだす": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "涎を垂らす": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "涎掛け": "مِرْيَلَة",
 "涕泣": "بُكَاء",
 "涙": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "涙ぐましい": "مُؤَثِّر / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "涙する": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "涙ながら": "باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته",
 "涙もろい": "بكّاء",
 "涙器": "جِهَاز دَمْعِيّ (الهياكل التي تفرز وتصرف الدموع من العين)",
 "涙嚢": "كيس دمعي (إحدى النهايتين المتسعتين للقنوات الدمعية عند النهايات الأنفية للعينين والتي تمتلئ بالدموع التي تفرزها الغدد الدمعية)",
 "涙嚢炎": "التهاب كيس الدمع (التهاب الكيس الدمعي يسبب انسداد الأنبوب الذي يصرف الدموع إلى الأنف)",
 "涙小管": "قناة دمعية (أي من عدة قنوات صغيرة تحمل الدموع من الغدد الدمعية)",
 "涙液": "بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل",
 "涙脆い": "بكّاء",
 "涙腺": "غدة دمعية (أي من الغدد الموجودة في العين التي تفرز الدموع)",
 "涙腺動脈": "شريان دمعي (شريان ينشأ من الشريان العيني ويغذي الغدة الدمعية وعضلات العين المستقيمة والجفن العلوي والجبهة)",
 "涙骨": "عظم دمعي (عظم هش صغير يشكل جزءاً من الجدران الداخلية الأمامية لكل محجر عين ويوفر مساحة لمرور القنوات الدمعية)",
 "涜神": "تَجْدِيف",
 "涜職": "فَسَاد",
 "涯": "النِهاية",
 "液": "سَائِل, مَائِع / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟ / صَلْصَة, مَرَق",
 "液だく": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / حَسَائِيّ (ذُو قِوَامٍ وَمَظْهَرٍ يُشْبِهُ الحَسَاء)",
 "液だめ": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "液体": "سَائِل, مَائِع",
