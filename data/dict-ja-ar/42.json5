 "泊り賃": "تَعَارِيف, تَعْرِفَة",
 "泊り込む": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "泊地": "أَنْكُورِيج",
 "泌乳": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "泌乳量": "إدرار الحليب, محصول الحليب (كمية الحليب التي تنتجها البقرة)\nمثال: الموسيقى الهادئة يمكن أن تحسن إدرار الحليب",
