 "沖縄方言": "لُغَة أُوكِينَاوَا (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "沖縄語": "لُغَة أُوكِينَاوَا (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "沖縄開発庁長官": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "沖繩": "أُوكِينَاوَا",
 "沖醤蝦": "كريل (قشريات عوالق تشبه الروبيان؛ مصدر رئيسي للغذاء للحيتان البالينية مثلاً)",
 "沖野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沖鱛": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "沙": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل.",
 "沙市": "سِيَاتَل",
 "沙村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沙汰": "شَأْن / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / إرشادات / لَاحَظَ",
 "沙汰の外": "عَبَثِيّ, سَخِيف",
 "沙汰の限り": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "沙汰やみ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما)",
 "沙汰止み": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما)",
 "沙港": "سِيَاتَل",
 "沙漏": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "沙皮": "جلد القرش (قماش ناعم هش الملمس)",
 "沙石": "حَصَاة",
 "沙穀": "ساغو (نشا مسحوق من بعض أنواع نخيل الساغو؛ يُستخدم في آسيا كمكثف للطعام ومقوٍ للمنسوجات)",
 "沙穀椰子": "سيكاس, نخيل الساغو (سيكاد قزم يشبه النخيل من اليابان ينتج الساغو)",
 "沙羅": "شَاؤُول, طَالُوت",
 "沙羅双樹": "شَاؤُول, طَالُوت",
 "沙羅曼蛇": "سَمَنْدَل",
 "沙羅樹": "شَاؤُول, طَالُوت",
 "沙鉢": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق…)",
 "沙鶏": "قطا بالاس (قطا أوراسي ذو رقعة سوداء على البطن)",
 "沛然": "جَارِف, سَيْلِيّ (ينهمر بغزارة شديدة)\nمثال: تعرية سيلية",
 "没": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "没す": "غَطَسَ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / صَادَرَ",
 "没する": "غَطَسَ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / صَادَرَ",
 "没にする": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "没る": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "没交渉": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "没個性的": "غَيْر شَخْصِيّ, مُحَايِد (لا تفضيل شخصيّ لديه)\nمثال: شركة غير شخصية",
 "没入": "تغطيس, غمر (فعل تبليل شيء بغمره) / غَرَق",
 "没入感": "تغطيس, غمر (فعل تبليل شيء بغمره)",
 "没分暁漢": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "没却": "تَجَاهَلَ, طَنَّش",
 "没収": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية)\nمثال: عانى من نوبة صرع",
 "没取": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "没後": "بعد الوفاة (بعد الموت)\nمثال: نُشرت مقطوعات البيانو هذه بعد الوفاة",
 "没我": "إِيثَار, غَيْرِيَّة",
 "没我的": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "没法子": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "没理想": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية)",
 "没義道": "وحشية",
 "没落": "خَرَاب, خَرَابَة",
 "没薬": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "没趣味": "انْعِدَام الذَّوْق (عدم الأناقة الذي يدل عليه الافتقار إلى الذوق الرفيع)",
 "没風流": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "没風流漢": "فلستيون",
 "没食子": "عَفْص",
 "没食子蜂": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "没食子酸": "حمض العفص, حمض الغاليك (حمض بلوري عديم اللون يتم الحصول عليه من العفص)",
 "沢": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء) / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "沢井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沢尻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沢山": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى)\nمثال: خسر كافة ممتلكاته.",
 "沢本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沢村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沢渡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沢火革": "جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في…)",
 "沢田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沢野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "沪紙": "ورق ترشيح (ورق مسامي غير معالج يستخدم للترشيح)",
 "沫": "فُقَّاعَة",
 "沮む": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "沮喪": "إحباط, انقباض (حالة من الاكتئاب السوداوي)",
 "沮害": "تَفَقُّد",
 "河": "نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ…)\nمثال: عبر جوناس النهر. / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه)",
