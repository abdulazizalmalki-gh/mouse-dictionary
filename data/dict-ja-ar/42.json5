 "発火": "إشعال, إضرام (عملية إضرام النار في شيء ما) / نظام إشعال (الآلية التي تشعل الوقود في محرك الاحتراق الداخلي) / إشعال, اتقاد (عملية بدء الاحتراق أو اشتعال النار) / إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "発火点": "نقطة الوميض (أدنى درجة حرارة يمكن عندها إشعال بخار سائل قابل للاشتعال في الهواء) / نقطة الانفجار, نقطة الوميض (النقطة التي يكون عندها الشيء جاهزاً للانفجار)",
 "発災": "تَفَشٍّ",
 "発炎筒": "كرة طائرة قصيرة ((بيسبول) كرة طائرة تضرب لمسافة قصيرة في الملعب الخارجي) / تمريرة جانبية (تمريرة أمامية قصيرة لظهير يركض نحو الخطوط الجانبية) / شعلة ضوئية, مشعل (جهاز ينتج ضوءاً ساطعاً للتحذير أو الإضاءة أو تحديد الهوية) / توهج, وميض (انفجار ضوئي يستخدم للتواصل أو الإضاءة)",
 "発煙": "إِسْتِشَاط غَضَبًا, ثَار",
 "発煙弾": "قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع)",
 "発煙筒": "قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع)",
 "発熱": "حُمَّة, حُمَّى",
 "発熱体": "عنصر تسخين (مكون في سخان أو موقد يحول الوقود أو الكهرباء إلى حرارة)",
 "発熱反応": "تفاعل طارد للحرارة (تفاعل كيميائي مصحوب بانبعاث للحرارة)",
 "発狂": "جُنُون",
 "発現": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟ / تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "発生": "حُدُوث / جِيل, نَسْل / جِيل / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "発生学": "علم الأجنة (فرع علم الأحياء الذي يدرس تكوين وتطور الكائنات الحية في مراحلها المبكرة)",
 "発生学者": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "発生源": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "発生率": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "発生順": "مُرَتَّب زَمَنِيَّا (المَوْضوع في مَرْتبتِه؛ ما بدا عليه التَّرتيب)\nمثال: شعر توم ممشوط و مرتب.",
 "発疹": "طَفْح, طَفْح جِلْدِيّ",
 "発疹熱": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى والقشعريرة وآلام العضلات والطفح الجلدي)",
 "発痘": "تَفَشٍّ",
 "発癌性物質": "مادة مسرطنة, مسبب للسرطان (أي مادة تسبب السرطان)",
 "発癌物質": "مادة مسرطنة, مسبب للسرطان (أي مادة تسبب السرطان)",
 "発着所": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع)",
 "発着駅": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "発砲": "إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "発砲音": "إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر",
 "発破": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / زَاعِق, صَاخِب (عالٍ بشكل مزعج ونافذ)",
 "発祥": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "発祥の地": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "発祥地": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "発端": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "発給": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "発育": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "発育不全": "تظهير ناقص ((في التصوير الفوتوغرافي) معالجة غير كافية للفيلم مما يؤدي إلى تباين غير كافٍ) / تخلف, نقص النمو (حالة التطور غير الكافي)\nمثال: يمكن إرجاع الكثير من الفقر إلى تخلف الصناعة / عدم التنسج, لاتنسج (فشل بعض الأنسجة أو الأعضاء في النمو)",
 "発育不良": "تظهير ناقص ((في التصوير الفوتوغرافي) معالجة غير كافية للفيلم مما يؤدي إلى تباين غير كافٍ) / تخلف, نقص النمو (حالة التطور غير الكافي)\nمثال: يمكن إرجاع الكثير من الفقر إلى تخلف الصناعة",
 "発航": "رَحِيل, مُغَادَرَة",
 "発色": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "発色団": "حامل اللون, كروموفور (المجموعة الكيميائية التي تمنح اللون للجزيء)",
 "発芽": "اِنْتَاش",
 "発行": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟ / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر",
 "発行人": "جهة إصدار, مُصدِر (مؤسسة تصدر شيئاً ما (أوراق مالية أو منشورات أو عملة وما إلى ذلك))",
 "発行所": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "発行済み": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "発行者": "جهة إصدار, مُصدِر (مؤسسة تصدر شيئاً ما (أوراق مالية أو منشورات أو عملة وما إلى ذلك))",
 "発行部数": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "発表": "إِعْلَان, بَلَاغ",
 "発表会": "حَيْثِيَّة / إِرَاءَة / إِهْدَاء, مَنْح",
 "発表者": "مُذِيع, مُذِيعَة",
 "発見": "اِكْتِشَاف",
 "発見器": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة) ويستجيب له بطريقة مميزة) / كاشف (معدات إلكترونية تكشف عن وجود إشارات راديو أو نشاط إشعاعي) / كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "発見料": "رسم الإيجاد, عمولة الوساطة (رسم يُدفع لشخص يجد مصدراً للدعم المالي أو لشخص يجمع الناس معاً لأغراض العمل)\nمثال: حصلت الوكالة على عمولة وساطة عندما تم تعيين مرشحهم كرئيس تنفيذي جديد",
 "発見的": "إرشادي",
 "発見者": "مُكْتَشِف",
 "発覚": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة) / كشف الإشارة (الكشف عن استقبال إشارة)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "発言": "تَصْرِيح, بَيَان",
 "発言者": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "発話": "تصويت, تلفظ (استخدام الأصوات المنطوقة للاتصال السمعي)",
 "発話者": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "発語": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "発議": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "発赤薬": "دواء محمر للجلد (دواء للاستخدام الخارجي ينتج احمراراً في الجلد)",
 "発走": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "発起": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / عَزْم, عُزْم / دِقَّة",
 "発起人": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "発起書": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "発足": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "発車": "رَحِيل, مُغَادَرَة\nمثال: バスは五分後に発車します。 — ستنطلق الحافلة بعد خمس دقائق.",
 "発送": "إرسال, بعث (فعل التسبب في ذهاب شيء ما (خاصة الرسائل))",
 "発送先": "وِجْهَة, وُجْهَة",
 "発送者": "شركة شحن (شركة تعمل في مجال شحن البضائع) / شاحن (شخص يقوم بشحن البضائع)",
 "発進": "رَحِيل, مُغَادَرَة / بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "発達": "إِعْمَار, تَعْمِير / تَقَدُّم / تَمَدُّد / تَوَسُّع",
 "発達でこぼこ": "تَنَوُّع عَصَبِيّ",
 "発達凸凹": "تَنَوُّع عَصَبِيّ",
 "発達心理学": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "発酵": "تخمر (عملية يسبب فيها عامل ما تحلل مادة عضوية إلى مواد أبسط؛ وخاصة التحلل اللاهوائي للسكر إلى كحول) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة",
 "発酵学": "علم التخمير (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "発酵種": "خَمِيرَة",
 "発酵素": "خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "発錆": "تصدأ, صدأ (تكوّن أكاسيد الحديد ذات اللون البني المحمر على الحديد عن طريق الأكسدة في درجات حرارة منخفضة بوجود الماء)",
 "発電": "تِلِغْرَاف, بَرْقِيَّة",
 "発電器官": "أورغن كهربائي ((موسيقى) محاكاة إلكترونية للأورغن الأنبوبي)",
 "発電子": "درع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "発電所": "محطة توليد الكهرباء, محطة طاقة (محطة لتوليد الكهرباء)",
 "発電機": "دِينَامُو",
 "発露": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "発音": "نُطْق, لَفْظ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم",
 "発音区別符号": "شَكْل, شَكْلَة ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "発音学": "صَوْتِيَات",
 "発音記号": "رمز صوتي (حرف مكتوب يُستخدم في النسخ الصوتي لتمثيل صوت كلام معين)",
 "発頭": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "発頭人": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "発願": "صَلَّى, دَعَا",
 "発馬": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "発馬機": "بوابة الانطلاق (حاجز متحرك على خط بداية مسار السباق)",
 "登り": "صُعُود, تَسَلُّق / مُتَّجِهٌ لِلْأَعْلَى (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا صُعُودًا)",
 "登りきる": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "登り切る": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "登り口": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "登り坂": "صُعُود, تَسَلُّق / انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "登る": "صَعِد",
 "登場": "دُخُول / مَدْخَل / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "登場人物": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "登場感": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "登壇者": "مانح, متبرع (شخص يقدم هدية أو هبة من ممتلكاته) / راعٍ, مُقدِّم (مدافع يقدم شخصًا (كما في جائزة أو درجة علمية أو مقدمة إلخ)) / مقدّم (شخص يقدم رسالة من نوع ما (مثل عريضة أو خطاب أو شيك أو نصب تذكاري إلخ))",
 "登山": "تسلق الجبال (نشاط تسلق الجبال)",
 "登山口": "بداية المسار (بداية طريق أو مسار مشي)",
 "登山客": "متسلق جبال (شخص يقوم بتسلق الجبال)",
 "登山家": "متسلق جبال (شخص يقوم بتسلق الجبال)",
 "登山者": "متسلق جبال (شخص يقوم بتسلق الجبال)\nمثال: 落石は登山者にとって危険である。 — الصخور الواقعة تشكل خطرا على المتسلقين.",
 "登山道": "درب جبلي (مسار عبر منطقة جبلية)",
 "登攀": "تسلق (الصعود بواسطة سلم أو ما شابه) / تدريج, قياس (فعل القياس أو الترتيب أو التعديل وفقًا لمقياس) / تدرج, تصنيف (فعل الترتيب في سلسلة متدرجة)",
 "登校": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "登校拒否": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "登校日": "دوام مدرسي, يوم دراسي (فترة التدريس في المدرسة؛ الفترة الزمنية التي تكون فيها المدرسة في حالة انعقاد) / يوم دراسي (أي يوم تكون فيه المدرسة في حالة انعقاد)\nمثال: ابق بعد الدوام المدرسي",
 "登極": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش)) / حق الدخول, دخول (الحق في الدخول) / إذعان, انضمام (الموافقة على أو القبول بـ (غالبًا على مضض)) / إضافة, مُقتنى جديد (شيء يضاف إلى ما تمتلكه بالفعل)\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "登用": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "登記": "سجل, سجل رسمي (سجل مكتوب رسمي للأسماء أو الأحداث أو المعاملات)",
 "登記簿": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "登載": "رَكْض (عَدَا)\nمثال: إنها تحب الركض. / تَسْجِيل",
 "登録": "تَسْجِيل",
 "登録器": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "登録機": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "登録済": "مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة المَطْلُوبَة) / مسجل (مدرج أو مسجل رسمياً) / مسجل ((للحيوانات) مسجل رسمياً أو معتمد لدى جمعية سلالة معترف بها؛ خاصة في سجل الأنساب)\nمثال: يتم تسجيل 'البريد المسجل' في كل نقطة على مساره لضمان التسليم الآمن",
 "登録済み": "مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة المَطْلُوبَة) / مسجل (مدرج أو مسجل رسمياً) / مسجل ((للحيوانات) مسجل رسمياً أو معتمد لدى جمعية سلالة معترف بها؛ خاصة في سجل الأنساب)\nمثال: يتم تسجيل 'البريد المسجل' في كل نقطة على مساره لضمان التسليم الآمن",
 "登録番号": "رقم التسجيل, رقم الرخصة (الرقم الموجود على لوحة الترخيص والذي يحدد السيارة التي تحمله)",
 "登録禁止": "قَائِمَة سَوْدَاء",
 "登録簿": "دليل (قائمة أبجدية بالأسماء والعناوين) / دليل ((علوم الكمبيوتر) قائمة بالملفات المخزنة في الذاكرة (عادة على قرص صلب))",
 "登録者": "مُسَجَّل (شخص مسجل رسمياً (مع آخرين) في سجل (ويحصل على حقوق معينة بذلك))",
 "登録者数": "تَسْجِيل",
 "登頂": "قِمَّة / إِجْتِمَاع قِمَّة",
 "登高器": "صاعد ((في الطباعة) جزء الحروف الصغيرة الطويلة الذي يمتد فوق مستوى الحروف الصغيرة الأخرى) / صاعد (حرف صغير له جزء يمتد فوق الحروف الصغيرة الأخرى) / صاعد (شخص يصعد)",
 "發兌": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "發動機": "مُحَرِّك, مُوتُور (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "白": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / بَرَاءَة / فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية) / غير مُعتق (غير مُعمر أو مُعالج) / غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل)\nمثال: أخشاب غير معتقة / بِدِقَّة / حَقِيقِيّ, صَادِق (غَيْر مُصْطَنَع؛ مَحْسُوس أَوْ مُعَبَّر عَنْهُ بِصِدْق) / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / بِلْجِيكَا / أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "白々": "شَفَّاف / وَاضِح / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "白々しい": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / سَافِر, مَكْشُوف (بِلَا أَيِّ مُحَاوَلَةٍ لِلْإِخْفَاء) / ماكر, متصنع (غير صريح أو مباشر؛ يعطي مظهراً كاذباً للصراحة)\nمثال: عامل طموح، ومخادع، وجاهل، ومنافق، جسد؛ أكثر السمات البغيضة في عصره",
 "白々明け": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "白あり": "أَرَضَة",
 "白い": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة. / بَرِيء, بَرِيئَة / بَرِيء / لَامِع, نَيِّر / مُسْتَنِير",
 "白いたち": "اِبْنُ مِقْرَض (الولد الذكر)\nمثال: هو له ابن صغير.",
 "白いんげん豆": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "白い物": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "白かび": "تَعَفُّن, عُفُونَة",
 "白くま": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "白け": "تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "白ける": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "白げる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "白さび病": "صدأ أبيض (فطر يسبب مرضاً يتميز بكتلة مسحوقية بيضاء من الكونيديا)",
 "白っぽい": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / أَبْيَض مُعْتِم, حَلِيبِيّ (يُشبه الحليب في لونه الأبيض غير الصافي) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "白なまず": "بُهَاق",
 "白ぶどう酒": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "白み": "بَيَاض",
 "白みがかった": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / أَبْيَض مُعْتِم, حَلِيبِيّ (يُشبه الحليب في لونه الأبيض غير الصافي)",
 "白む": "بَيَّضَ, اِبْيَضَّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض. / بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "白め": "بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص))",
 "白んぼ": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "白ん坊": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "白アリ": "أَرَضَة",
 "白イタチ": "اِبْنُ مِقْرَض (الولد الذكر)\nمثال: هو له ابن صغير.",
 "白インゲンマメ": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "白インゲン豆": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "白カビ": "تَعَفُّن, عُفُونَة",
 "白テン": "قَاقِم",
 "白ナマズ": "بُهَاق",
 "白ニンジン": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "白ロシア": "بِيلَارُوسِيَا, رُوسْيَا الْبَيْضَاء",
 "白ロシア語": "بِيلَارُوسِيّ",
 "白ワイン": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "白丁": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "白亜": "طَبْشُورَة",
 "白亜質": "ملاط, ملاط الأسنان (مادة عظمية متخصصة تغطي جذر السن) / طَبَاشِيرِيّ اللَّوْن (بلون الطباشير الأبيض) / جيري, طباشيري (مكون من أو يحتوي على أو يشبه كربونات الكالسيوم أو الكالسيت أو الطباشير)",
 "白亜館": "الْبَيْت الْأَبْيَض / بَيْت أَبْيَض (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "白人": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "白人参": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "白人種": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "白人至上主義": "تفوق العرق الأبيض (التحيز القائل بأن أفراد العرق الأبيض متفوقون على أفراد الأعراق الأخرى)",
 "白人至上主義者": "مؤمن بتفوق البيض (شخص يعتقد أن العرق الأبيض هو الأسمى أو يجب أن يكون كذلك)",
 "白光": "كورونا (سيجار طويل بنهايات غير حادة) / إِكْلِيل ((في التشريح) أي بنية تشبه التاج في شكلها) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي) / هالة (دائرة واحدة أو أكثر من الضوء تُرى حول جسم مضيء)",
 "白兵戦": "مُلْتَحِم, وَجْهاً لِوَجْه (على مسافة قريبة جداً؛ في قتال مباشر)",
 "白内障": "شلالات قوية, مسقط مائي ضخم (شلال كبير؛ تدفق عنيف للمياه فوق جرف) / إعتام عدسة العين, الماء الأبيض (مرض عيني ينطوي على تغيم أو عتامة في العدسة الطبيعية للعين)",
 "白切符": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "白化": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم. / برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "白化個体": "أَمْهَق",
 "白化現象": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "白口": "كرواكر أبيض (سمكة طعام بحرية فضية صغيرة توجد قبالة كاليفورنيا) / السمكة الملكة, كرواكر أبيض (سمكة طبل فضية ومائلة للزرقة في المياه الساحلية الضحلة لكاليفورنيا)",
 "白味がかった": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / أَبْيَض مُعْتِم, حَلِيبِيّ (يُشبه الحليب في لونه الأبيض غير الصافي)",
 "白土": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "白地": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "白堊": "طَبْشُورَة",
 "白堊館": "الْبَيْت الْأَبْيَض / بَيْت أَبْيَض (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "白墨": "طَبْشُورَة",
 "白壁": "تُوفُو, توفو",
 "白太": "خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "白妙": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "白妙菊": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء الجذابة وزهوره القرمزية المبهرجة) / شيح الشاطئ, طاحونة الغبار (عشبة بأوراق رمادية توجد على طول الساحل الشرقي لأمريكا الشمالية؛ تستخدم كنبات زينة) / طاحونة الغبار, قنطريون رمادي (نبات ذو أوراق وسيقان مغطاة بزغب يشبه الغبار) / سينراريا فضية, طاحونة مغبرة (نبات معمر صلب كثير التفرع من منطقة البحر الأبيض المتوسط ذو سيقان وأوراق صوفية بيضاء جداً)",
 "白子": "سرء, مني السمك (حيوانات منوية للسمك أو غدة تناسلية ممتلئة بالحيوانات المنوية؛ لها قوام كريمي) / أَمْهَق / أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / أسماك صغيرة, وايت بيت (أسماك المنوة أو غيرها من الأسماك الصغيرة في المياه العذبة أو المالحة (خاصة الرنجة)؛ تطهى عادة كاملة) / إلفير (صغير الأنقليس) / صغير ثعبان البحر (ثعبان بحر صغير؛ قد يقلى أو يحمر بالعجين)",
 "白子鳩": "فَاخِتَة",
 "白岩山羊": "ماعز الجبل (ثديي ثابت القدم يعيش في المناطق الجبلية بشمال غرب أمريكا الشمالية)",
 "白川夜舟": "مُتَعَالِم",
 "白川夜船": "مُتَعَالِم",
 "白帯下": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "白度": "بَيَاض",
 "白張": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "白慈姑": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "白折": "مُرْتَفِع الدَّرَجَة",
 "白拍子": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "白撞木鮫": "قرش المطرقة الأملس (يتم صيده من أجل جلوده وكبده الغني بالفيتامينات)",
 "白斑": "صَيْخَد / بُهَاق",
 "白旗": "راية الهدنة, علم أبيض (علم يتكون من قطعة قماش بيضاء تُرفع للإشارة إلى الاستسلام أو لطلب الهدنة)",
 "白日の下にさらす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "白日の下に晒す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "白日夢": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "白星": "اِنْتِصَار, نَصْر",
 "白昼": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "白昼夢": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "白書": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "白板": "سَبُورَة بَيْضَاء",
 "白栲": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "白樅": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق تفوح منها رائحة البرتقال عند سحقها) / شوح أبيض, شوح كولورادو (شوح متوسط إلى طويل من وسط إلى غرب الولايات المتحدة له تاج منتصب ضيق وخشب ناعم)",
 "白毛": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "白水郎": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "白河夜舟": "مُتَعَالِم",
 "白河夜船": "مُتَعَالِم",
 "白波": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون) / لِصّ, لِصَّة",
 "白浪": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون) / لِصّ, لِصَّة",
 "白海豚": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ) / بيلوغا (مصدر قيم للكافيار والجيلاتين السمكي؛ توجد في البحر الأسود وبحر قزوين)",
 "白湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "白濁": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي) / تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب) / مَنِيّ",
 "白濁液": "مَنِيّ",
 "白灯油": "كِيرُوسِين",
 "白熊": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "白熱": "احتدام, توهج أبيض (سخونة شيء يتم تسخينه حتى يتحول إلى اللون الأبيض)",
 "白熱灯": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "白熱的": "مُسَخَّن (جُعِل دافئاً أو ساخناً) / حَامٍ, مُحْتَدِم (يتّسم بالحدّة العاطفيّة؛ عنيف)",
 "白熱電球": "لَمْبَة, مِصْبَاح",
 "白物": "بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض) / أجهزة منزلية كبيرة, سلع بيضاء (الأجهزة المنزلية الكهربائية الكبيرة (مثل الثلاجات أو الغسالات) التي تكون عادة مطلية بالمينا الأبيض) / مِلْح, ملح / مَلَّحَ",
 "白物家電": "بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض) / أجهزة منزلية كبيرة, سلع بيضاء (الأجهزة المنزلية الكهربائية الكبيرة (مثل الثلاجات أو الغسالات) التي تكون عادة مطلية بالمينا الأبيض)",
 "白犀": "وحيد القرن الأبيض (وحيد قرن أفريقي كبير رمادي فاتح له قرنان؛ مهدد بالانقراض)",
 "白状": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "白狐": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "白玉": "أَبْيَض الأَزْهَار ((للنباتات) ذو أزهار بيضاء)",
 "白玉椿": "أَبْيَض الأَزْهَار ((للنباتات) ذو أزهار بيضاء)",
 "白玉楼中の人となる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "白球を追う": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "白田": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج) / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "白痴": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / حماقة, طيش (سلوك أحمق أو لا معنى له) / مُغَفَّل, أَحْمَق",
 "白痴美": "حمقاء جميلة (شابة مدللة من قبل رجال أكبر سناً وأثرياء وأقوياء)",
 "白癜": "بُهَاق",
 "白癩": "بُهَاق",
 "白癬": "سَعْفَة, قَرَع",
 "白白": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "白白しい": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / سَافِر, مَكْشُوف (بِلَا أَيِّ مُحَاوَلَةٍ لِلْإِخْفَاء) / ماكر, متصنع (غير صريح أو مباشر؛ يعطي مظهراً كاذباً للصراحة)\nمثال: عامل طموح، ومخادع، وجاهل، ومنافق، جسد؛ أكثر السمات البغيضة في عصره",
 "白白明け": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "白百合": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند المصريين القدماء) / زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "白皙": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "白皮症": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "白目": "بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص))",
 "白目をむく": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "白目を剝く": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "白目を剥く": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "白眉": "أَفْضَل",
 "白石": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "白禿瘡": "سَعْفَة, قَرَع",
 "白秋": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "白米": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "白粉": "بُودْرَة",
 "白粉中毒": "تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "白粉臭い": "مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "白粉花": "أعجوبة بيرو, شب الليل (نبات حديقة شائع في أمريكا الشمالية ذو زهور عطرة حمراء أو أرجوانية أو صفراء أو بيضاء تفتح في وقت متأخر من بعد الظهر)",
 "白粘土": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "白紙": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض) / بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة) / خَرْبَشَ",
 "白紙委任": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "白紙委任状": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "白紙状態": "صَفْحَة بَيْضَاء",
 "白線": "خط أبيض (شريط أبيض في منتصف الطريق لتحديد مسارات المرور)",
 "白羊宮": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "白羽": "ريشة بيضاء (رمز للجبن)",
 "白肉": "كرشة",
 "白肌": "بُهَاق",
 "白膚": "بُهَاق",
 "白舵木": "مارلين أسود (سمكة صيد كبيرة في المحيط الهادئ؛ قد يصل وزنها إلى 1000 رطل)",
 "白色": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "白色わい星": "قَزْم أَبْيَض",
 "白色人種": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "白色矮星": "قَزْم أَبْيَض",
 "白色雑音": "ضوضاء بيضاء (ضوضاء ناتجة عن محفز يحتوي على جميع ترددات الاهتزاز المسموعة)\nمثال: الضوضاء البيضاء عامل حجب جيد",
 "白芥子": "خَرْدَل أَبْيَض",
 "白花虫除菊": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من الأسفل؛ مصدر لمبيد حشري؛ يوضع أحياناً في جنس أقحوان)",
 "白茶": "بني فاتح (بني فاتح ولكنه غير مشبع) / شَاي أَبْيَض (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "白茶けた": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "白茶ける": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "白菜": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة) / كرنب صيني, ملفوف صيني (نبات ذو رأس ممدود من أوراق عريضة معنقة تشبه الكرفس؛ يستخدم كخضروات في شرق آسيا) / كُرُنْب صِينِيّ, بُوك تْشُوي",
 "白葡萄酒": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة))\nمثال: أنا شربت النبيذ.",
 "白葦毛": "مُتَدَاعٍ, مُتَهَالِك (بَالٍ وَمُتَحَطِّمٌ بِسَبَبِ الاسْتِعْمَالِ الشَّدِيدِ)",
 "白蓮": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند المصريين القدماء) / شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "白蝋虫": "نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "白蝶貝": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "白蟻": "أَرَضَة",
 "白血球": "كُرَيَّةُ دَمٍ بَيْضَاءُ, خَلِيَّةُ دَمٍ بَيْضَاءُ",
 "白血球増加": "كثرة الكريات البيض (زيادة غير طبيعية في عدد خلايا الدم البيضاء في الدم نتيجة للعدوى)",
 "白血球増加症": "كثرة الكريات البيض (زيادة غير طبيعية في عدد خلايا الدم البيضاء في الدم نتيجة للعدوى)",
 "白血球減少": "نقص الكريات البيض (انخفاض غير طبيعي في عدد خلايا الدم البيضاء)",
 "白血球減少症": "نقص الكريات البيض (انخفاض غير طبيعي في عدد خلايا الدم البيضاء)",
 "白血病": "سَرَطَان دَم",
 "白衣": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "白衣の天使": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "白襟禿鷲": "نسر أسمر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "白詰め草": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "白詰草": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "白豚": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "白象": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا) / الفيل الأبيض (ممتلكات قيمة تكون تكاليف صيانتها باهظة للغاية)",
 "白貂": "قَاقِم",
 "白質": "مادة بيضاء (نسيج عصبي أبيض للجهاز العصبي المركزي يتكون من عصبونات وأغمادها المايلينية)",
 "白身": "غِرْقِل, آح البَيْض / صدر, لحم أبيض (اللحم المقطع من صدر الطائر) / خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "白金": "بَلَاتِين / بَلَاتِينُوم",
 "白金黒": "أسود البلاتين (مسحوق أسود ناعم من البلاتين؛ يستخدم كمحفز في التفاعلات الكيميائية)",
 "白鉄鉱": "مَرْقَشِيتَا",
 "白鉛鉱": "خام الرصاص الأبيض, سيروسيت (معدن يتكون من كربونات الرصاص وهو مصدر مهم للرصاص)",
 "白銀": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب. / ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "白鑞": "بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص))",
 "白長須鯨": "حوت أزرق (أكبر حيوان ثديي معروف على الإطلاق؛ حوت باليني مهاجر أزرق رمادي يعيش غالباً في نصف الكرة الجنوبي)",
 "白隠元豆": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "白隼": "سنقر (صقر قطبي كبير ونادر له أطوار لونية بيضاء وداكنة)",
 "白雁": "إوز الثلج (الإوز الأزرق في الطور اللوني الأبيض)",
 "白雨": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "白雪姫": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "白雲母": "مُوسْكُوفِيّ",
 "白雲石": "دولوميت (معدن فاتح اللون يتكون من كربونات الكالسيوم والمغنيسيوم؛ مصدر للمغنيسيوم؛ يستخدم كخزف وكسماد) / دولوميت (نوع من الصخور الرسوبية يشبه الرخام أو الحجر الجيري ولكنه غني بكربونات المغنيسيوم)",
 "白面": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ / عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "白頭ワシ": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "白頭翁": "زهرة الرياح, شقائق النعمان / أَشْيَب",
 "白頭鷲": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "白額": "إِجَّامَة / نَجْمَة",
 "白飛び": "بياض شامل, تعتيم ثلجي (حالة جوية قطبية بوجود سحب فوق الثلج تنتج بياضاً موحداً وتصعب رؤية الأشياء؛ تحدث عندما يساوي الضوء المنعكس من الثلج الضوء القادم عبر السحب)",
 "白馬": "دَاكِن اللَّوْن (ذو لون داكن أو قاتم) / رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "白馬の王子": "فتى الأحلام, فارس الأحلام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "白馬の騎士": "الفارس الأبيض (شركة تكون مستحوذاً ودوداً في عملية استحواذ)",
 "白馬非馬": "سفسطة (حجة غير صحيحة عمدًا تظهر البراعة في التفكير على أمل خداع شخص ما)",
 "白駒の隙を過ぐるが如し": "الْوَقْتُ يَمْضِي",
 "白骨": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "白髪まじり": "شائِب",
 "白髪マーモット": "مرموط أشيب (مرموط جبلي كبير من أمريكا الشمالية)",
 "白髪交じり": "شائِب",
 "白髪染め": "صبغة شعر (صبغة لتلوين الشعر)",
 "白髪混じり": "شائِب",
 "白魔法": "سحر أبيض (سحر يُستخدم لأغراض خيرة فقط)",
 "白魔術": "سحر أبيض (سحر يُستخدم لأغراض خيرة فقط)",
 "白魚": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / أسماك صغيرة, وايت بيت (أسماك المنوة أو غيرها من الأسماك الصغيرة في المياه العذبة أو المالحة (خاصة الرنجة)؛ تطهى عادة كاملة)",
 "白鮭": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "白鯨": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ)",
 "白鳥": "تَمّ, قُقْنُس\nمثال: 白鳥は当地からフロリダに移動する。 — يهاجر البجع من هنا إلى فلوريدا.",
 "白鳥の歌": "أغنية البجعة, العمل الأخير (أداء أو جهد أخير (خاصة قبل التقاعد))",
 "白鳥座": "الدَّجَاجَة",
 "白鳩": "يَمَام, حَمَام",
 "白鴎": "عمدة (عمدة بلدية في ألمانيا أو هولندا أو فلاندرز أو النمسا)",
 "白黒": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "白黒テレビ": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "白黒襟巻狐猿": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "白鼬": "اِبْنُ مِقْرَض (الولد الذكر)\nمثال: هو له ابن صغير.",
 "百": "مِٱئَة, مِئَة / مِٱئَة, مِئَة / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "百万": "مِلْيُون, ١٠٠٠٠٠٠ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "百万都市": "مدينة كبيرة",
 "百万長者": "مِلْيُونِير",
 "百世": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "百事": "كُلّ, جَمِيع",
 "百代": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "百倍": "مائة ضعف (بمعامل مائة)\nمثال: زادت أموالهم مائة ضعف",
 "百八十度": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "百分位数": "رتبة مئينية, مئين ((إحصاء) أي من النقاط الـ 99 المرقمة التي تقسم مجموعة مرتبة من الدرجات إلى 100 جزء يحتوي كل منها على واحد بالمائة من المجموع)",
 "百分比": "النِّسْبَة الْمِئَوِيَّة",
 "百分率": "النِّسْبَة الْمِئَوِيَّة",
 "百十番": "مِئَة وَعَشَرَة (يَدُلُّ عَلَى العَدَد 110) / أُطْلُب الشُّرْطَة, نَاد الشُّرْطَة",
 "百千": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "百千万": "حشد, كثرة كاثرة (عدد كبير جداً (خاصة من الناس))",
 "百千鳥": "زقزاق (أي من طيور شاطئية عديدة ذات بنية مدمجة نسبياً ومناقير مستقيمة وأجنحة مدببة كبيرة؛ قريبة الصلة بطيور الطيطوي)",
 "百卒長": "سينتوريون",
 "百合": "زَنْبَق, سَوْسَن",
 "百合の木": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "百合の樹": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "百合木": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "百合樹": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "百合水仙": "ألستروميريا (أي من النباتات الأمريكية الجنوبية المختلفة من جنس ألستروميريا التي تقدر لخيماتها الجميلة من الزهور)",
 "百合鴎": "نورس اسود الرأس",
 "百塩茶": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "百姓": "فَلَّاح, فَلَّاحَة / زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "百寿": "مُعَمَّر (بلغ المئة عام من العمر على الأقلّ) / معمر (شخص يبلغ من العمر 100 عام على الأقل)",
 "百寿者": "مُعَمَّر (بلغ المئة عام من العمر على الأقلّ) / معمر (شخص يبلغ من العمر 100 عام على الأقل)",
 "百年": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "百年祭": "مئوي (من أو يتعلق بفترة 100 عام أو إكمالها) / ذكرى مئوية (الذكرى السنوية المئة)\nمثال: احتفال مئوي",
 "百戦百勝": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "百戦練磨": "مُحَارِب قَدِيم",
 "百戦錬磨": "مُحَارِب قَدِيم",
 "百折不撓": "عدم كلل (تصميم لا يكل)",
 "百日せき": "سُعَال دِيكِيّ",
 "百日ぜき": "سُعَال دِيكِيّ",
 "百日咳": "سُعَال دِيكِيّ",
 "百日紅": "تمرحنة, وردية الكريب (شجيرة زينة من شرق الهند تزرع بكثرة في جنوب الولايات المتحدة)",
 "百日草": "زينيا (أي من نباتات مختلفة من جنس زينيا تُزرع لرؤوس أزهارها الملونة بألوان زاهية ومتنوعة)",
 "百日鬘": "طَوِيل الشَّعْر (ذو شعر طويل)",
 "百歳": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "百点満点": "كَمَال, إتقان",
 "百獣の王": "مَلِك الوُحُوش (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "百発百中": "معصوم, منزه عن الخطأ (غير قادر على الفشل أو الخطأ)\nمثال: ترياق لا يخطئ (فعال دائماً)",
 "百科": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "百科事典": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "百科全書": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "百科辞典": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "百科辞書": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "百聞は一見にしかず": "صُورَة تُسَاوِي أَلْف كَلِمَة",
 "百聞は一見に如かず": "صُورَة تُسَاوِي أَلْف كَلِمَة",
 "百舌": "صرد (أي من الطيور العديدة في العالم القديم ذات منقار قوي معقوف تتغذى على الحيوانات الأصغر)",
 "百舌鳥": "صرد (أي من الطيور العديدة في العالم القديم ذات منقار قوي معقوف تتغذى على الحيوانات الأصغر)",
 "百般": "كُلّ, جَمِيع",
 "百色眼鏡": "مِشْكَال, مِنْظَارُ التَّهَاوِيل",
 "百芸": "جاك لجميع المهن",
 "百貨店": "مَتْجَر شَامِل, مَتْجَر تَنْوِيعِيّ",
 "百足": "أُمّ أَرْبَعَة وَأَرْبَعِين (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "百遍": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "皀莢": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "皁色": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "皁莢": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "皂莢": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "的": "ـِيّ\nمثال: その女性は非常に協力的である。 — النساء داعِمات جدًّا. / كَـ / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال. / بِاتِّجاه, مَع / مِن جِهة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "的はずれ": "عَرَضِيّ",
 "的を絞る": "بُؤْرَة",
 "的場": "منطقة الهدف (موقع الهدف المراد إصابته)",
 "的外れ": "عَرَضِيّ",
 "的屋": "بائع متجول لبضائع رديئة (بائع لبضائع رديئة) / كاتب إعلانات (شخص يكتب إعلانات الراديو أو التلفزيون)",
 "的玉": "الكرة المستهدفة (كرة البلياردو التي يقصد أن تكون أول كرة تضربها الكرة البيضاء)",
 "的球": "الكرة المستهدفة (كرة البلياردو التي يقصد أن تكون أول كرة تضربها الكرة البيضاء)",
 "的確": "مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "的鯛": "ضوري مذهب",
 "皆": "الْجَمِيع, كُلّ شَخْص / كُلّ شَيْء",
 "皆々": "كُلّ, جَمِيع / كُلّ شَيْء",
 "皆々様": "الْجَمِيع, كُلّ شَخْص",
 "皆が皆": "اَلْجَمِيع, كُلّ شَخْص",
 "皆さま": "الْجَمِيع, كُلّ شَخْص",
 "皆さん": "كُلّ, جَمِيع",
 "皆の者": "اَلْجَمِيع, كُلّ شَخْص",
 "皆の衆": "اَلْجَمِيع, كُلّ شَخْص",
 "皆まで": "النِهاية",
 "皆伐": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن) / جَلِيّ, وَاضِح (وَاضِح وَمُتَمَيِّز لِلحَوَاسّ؛ سَهْل الإِدْرَاك) / مَقْطُوع الأَشْجَار كُلِّيًّا (أُزيلت جميع أشجاره دفعة واحدة)",
 "皆具": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "皆既": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "皆既食": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "皆様": "الْجَمِيع, كُلّ شَخْص",
 "皆様方": "الْجَمِيع, كُلّ شَخْص",
 "皆殺し": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "皆済": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "皆無": "مَعْدُوم",
 "皆皆": "كُلّ, جَمِيع / كُلّ شَيْء",
 "皆皆様": "الْجَمِيع, كُلّ شَخْص",
 "皆目": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "皇": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "皇后": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "皇后宮": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "皇嗣": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇国": "إِمْبِرَاطُورِيَّة",
 "皇天": "بروفيدنس",
 "皇太后": "إِمْبِرَاطُورَة الأُمّ",
 "皇太子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇太子妃": "ولية العهد (وريثة أنثى ظاهرة للعرش) / زوجة ولي العهد (زوجة ولي العهد)",
 "皇妃": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "皇婿": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "皇子の命": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇子の尊": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇孫": "قَيْصَر, إِمْبْرَاطُور",
 "皇帝": "قَيْصَر, إِمْبْرَاطُور",
 "皇帝ペンギン": "بطريق إمبراطور (أكبر البطاريق؛ بطريق من القارة القطبية الجنوبية)",
 "皇帝教皇主義": "إيراستية (المذهب القائل بأن الدولة لها السيادة على الكنيسة في الأمور الكنسية)",
 "皇御国": "إِمْبِرَاطُورِيَّة",
 "皇御孫": "قَيْصَر, إِمْبْرَاطُور",
 "皇族": "مَلَكِيَّة",
 "皇朝": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "皇漢医学": "اَلطِّبّ اَلصِّينِيّ",
 "皇配": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "皎々": "لَامِع, نَيِّر / مُسْتَنِير",
 "皓々": "لَامِع, نَيِّر / مُسْتَنِير",
 "皓礬": "كبريتات الزنك (مسحوق عديم اللون قابل للذوبان في الماء؛ يستخدم كمثبت للون أو لحفظ الخشب أو للترسيب الكهربائي للزنك)",
 "皮": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / قشرة (الغطاء الخارجي الطبيعي للطعام (يزال عادة قبل الأكل))\nمثال: 私は林檎の皮をむくことができる。 — أستطيع تقشير تفاحة. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "皮かぶり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "皮かむり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "皮なめし": "دِبَاغَة",
 "皮ひも": "زنوبَة, شِبْشِب",
