 "池魚の殃": "أَضْرَار جَانِبِيَّة",
 "汪々": "ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة) / حَجِيم, ضَخْم الحَجْم (كبير في الحجم أو الكتلة) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)",
 "汪汪": "ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة) / حَجِيم, ضَخْم الحَجْم (كبير في الحجم أو الكتلة) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)",
 "汰る": "هَزَّ",
 "汲々": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "汲み上げる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "汲み入れる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "汲み取り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "汲み取り便所": "مِرْحَاض خَارِجِيّ",
 "汲み取り式便所": "مِرْحَاض, تواليت",
 "汲み取る": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "汲む": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا / وَرَثَ",
 "汲上げる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "汲汲": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "決": "قَرَار, تَصْمِيم",
 "決して": "يَوْمًا",
 "決す": "قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "決する": "قَرَّرَ, صَمَّمَ / قَرَّرَ / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "決って": "دَائِمًا, أَبَدًا",
 "決まった": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "決まって": "دَائِمًا, أَبَدًا",
 "決まり": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / مُسْتَعْمَرَة, مُسْتَوْطَنَة / عَادَة / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "決まりが悪い": "مُحْرَج, بِٱلْحَرَج",
 "決まりきった": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "決まりごと": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "決まり事": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "決まり切った": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "決まり悪い": "مُحْرَج, بِٱلْحَرَج",
 "決まり手": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "決まり文句": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "決まる": "نَجَحَ",
 "決め": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "決めうち": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "決めこむ": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決めつける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "決める": "قَرَّرَ, صَمَّمَ / قَرَّرَ / التحام ((ملاكمة) فعل أحد الملاكمين بالإمساك بالآخر لتجنب التعرض للضرب وللراحة لحظياً) / حضن, عناق (عناق قوي أو عاطفي) / مشبك, ملزمة (جهاز (يستخدمه النجارون عادة) يثبت الأشياء معاً بإحكام) / برشمة, طرف المسمار المثني (الجزء المسطح من مسمار أو برغي أو برشام)\nمثال: تعال هنا وأعطني حضنًا كبيرًا / سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "決め付ける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "決め手": "عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي)",
 "決め打ち": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "決め込む": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決り切った": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "決り手": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "決り文句": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "決る": "نَجَحَ / تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز",
 "決別": "تَفْرِقَة",
 "決勝": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "決勝戦": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "決勝点": "خط النهاية (خط يشير إلى موقع نهاية السباق)",
 "決勝線": "خط النهاية (خط يشير إلى موقع نهاية السباق)",
 "決壊": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "決定": "قَرَار, تَصْمِيم",
 "決定づける": "قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "決定力": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع) / حسم, قاطع (سمة الحزم كما يتضح من صلابة الشخصية أو الغرض)\nمثال: نهائية الموت",
 "決定戦": "جولة الإعادة, الجولة الثانية",
 "決定投票": "صوت مرجح (التصويت الحاسم الذي يدلي به رئيس الجلسة لحل التعادل)",
 "決定版": "أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة) / القول الفصل (بيان موثوق ونهائي) / الكلمة الأخيرة (البيان النهائي في جدال لفظي)",
 "決定的": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "決定表": "جدول القرار (جدول لجميع الاحتمالات والإجراءات التي يجب اتخاذها لكل منها)",
 "決定論": "حَتْمِيَّة",
 "決定論的": "حَتْمِيّ, قَطْعِيّ (نتيجة حتمية لأسباب سابقة كافية)",
 "決心": "عَزِيمَة",
 "決意": "قَرَار, تَصْمِيم",
 "決戦": "جولة الإعادة, الجولة الثانية",
 "決断": "قَرَار, تَصْمِيم",
 "決断力": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع) / حسم, قاطع (سمة الحزم كما يتضح من صلابة الشخصية أو الغرض)\nمثال: نهائية الموت",
 "決済": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "決然": "حاسم, حاسمة",
 "決疑論": "إفتاء أخلاقي, دراسة الحالات الأخلاقية (فلسفة أخلاقية تقوم على تطبيق المبادئ الأخلاقية العامة لحل المعضلات الأخلاقية) / إفتاء سفسطائي, تلاعب بالألفاظ (مجادلة خادعة أو دقيقة بشكل مفرط وتهدف إلى التضليل)",
 "決着": "نَتِيجَة",
 "決着をつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "決着を付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "決算": "تغطية, تقرير صحفي (الأخبار كما يقدمها المراسلون للصحف أو الإذاعة أو التلفزيون)\nمثال: اتهموا الصحيفة بتغطية متحيزة للعلاقات العرقية",
 "決算報告": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "決算日": "نهاية العالم, هلاك (مصير غير سار أو كارثي) / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)\nمثال: كان الجميع يدركون الهلاك القادم لكنهم كانوا عاجزين عن تجنبه",
 "決算書": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "決算賞与": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "決行": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "決裁": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "決裂": "تَوَزُّع",
 "決議": "عَزْم, عُزْم / دِقَّة",
 "決議事項": "عَزْم, عُزْم / دِقَّة",
 "決議案": "عَزْم, عُزْم / دِقَّة",
 "決議権": "حق التصويت (الحق في التصويت؛ وخاصة حق المساهم العادي في التصويت شخصيًا أو بالوكالة في شؤون الشركة)",
 "決議機関": "اِجْتِمَاع حِزْبِيّ مُغْلَق, مُؤْتَمَر حِزْبِيّ (اجتماع سياسي مغلق)",
 "決起": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع) / استيقاظ, صحوة (الاستيقاظ من النوم) / استثارة, تيقظ (حالة من النشاط الفسيولوجي المتزايد)",
 "決起会": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "決起大会": "تَجَمُّع تَشْجِيعِيّ (تجمع (خاصة للطلاب) قبل مباراة رياضية)",
 "決起集会": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "決込む": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決闘": "مُبَارَزَة",
 "決闘者": "مُبارز (شخص يخوض المبارزات)",
 "汽笛": "صافرة بخارية (صافرة يتم إنتاج الصوت فيها بواسطة البخار؛ عادة ما تكون متصلة بغلاية بخارية)",
 "汽缶": "غَلَّايَة",
 "汽罐": "غَلَّايَة",
 "汽船": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "汽艇": "أَطْلَقَ, قَذَفَ",
 "汽車": "قِطَار بُخَارِيّ / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "汽車ぽっぽ": "تُوت تُوت",
 "汽車ポッポ": "تُوت تُوت",
 "汽車賃": "أجرة القطار, تذكرة قطار (الأجرة المفروضة للسفر بالقطار)",
 "汽鑵": "غَلَّايَة",
 "沁みる": "اِبْتَلَّ / لَسَعَ",
 "沃る": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "沃化": "يَوَّدَ",
 "沃化カリウム": "يوديد البوتاسيوم (ملح بلوري يُستخدم في التخليق العضوي وصنع المستحلبات الفوتوغرافية وفي ملح الطعام المعالج باليود)",
 "沃化水素": "يوديد الهيدروجين (غاز عديم اللون ينتج حمض الهيدرويوديك في المحلول المائي)",
 "沃化物": "يوديد (ملح أو إستر لحمض الهيدرويوديك)",
 "沃化銀": "يوديد الفضة (يوديد يُستخدم في التصوير الفوتوغرافي، وفي استمطار السحب، وفي الطب)",
 "沃地": "وَاحَة, غُوطَة (بقعة خضراء في الصحراء أو في أرض قاحلة، وأصبحت كذلك بسبب وجود مصدر ماء بقربها)",
 "沃素": "يُود",
 "沃素一三一": "يود-131 (نظير مشع ثقيل لليود له عمر نصف 8 أيام؛ يستخدم في ملح الصوديوم لتشخيص أمراض الغدة الدرقية ولعلاج تضخم الغدة الدرقية)",
 "沃素一二五": "يود-125 (نظير مشع خفيف لليود له عمر نصف 60 يوماً؛ يستخدم كمتتبع في دراسات الغدة الدرقية وكعلاج لفرط نشاط الغدة الدرقية)",
 "沃素酸": "حمض اليوديك (حمض بلوري قابل للذوبان؛ يستخدم ككاشف ومطهر)",
 "沈々": "صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "沈み込む": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "沈む": "غَطَسَ / مَجْلَى, مَغْسَلَة / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "沈め": "غَرَق / كرة هابطة (رمية تنحني للأسفل بسرعة عند اقترابها من اللوحة) / ثقالة (وزن يغرق (لتثبيت الشباك أو خيوط الصيد تحت الماء)) / دونات, كعكة مقلية (كعكة مقلية صغيرة على شكل حلقة)",
 "沈める": "غَطَسَ / مَجْلَى, مَغْسَلَة / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "沈んだ心": "اعتلال المزاج, انقباض (حالة من الاكتئاب الخفيف)",
 "沈下": "غَرَق",
 "沈吟": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "沈子": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "沈床園": "حديقة غائرة (حديقة تقع تحت مستوى الأرض المحيطة بها)",
 "沈思": "تَفَكُّر",
 "沈殿": "تَسَاقُط, هُطُول / تَرَسُّب / عجلة",
 "沈殿剤": "مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ) / مادة مرسبة, مرسب (عامل يسبب تشكل راسب)",
 "沈殿物": "رَاسِب",
 "沈沈": "صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "沈没": "غَرَق",
 "沈泥": "غَرِين",
 "沈渣": "رَاسِب",
 "沈滞": "رُكُود / ركود اقتصادي",
 "沈潜": "تَفَكُّر",
 "沈澱": "تَسَاقُط, هُطُول / تَرَسُّب / عجلة",
 "沈澱物": "رَاسِب",
 "沈痛": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "沈着": "اتزان, رباطة جأش (ثبات العقل تحت الضغط)\nمثال: تقبل مشاكلهم برباطة جأش وهي باتزان / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "沈砂": "إقدام, عزيمة (الثبات والتصميم) / جريت, حجر رملي خشن (حجر رملي سيليسي خشن الحبيبات صلب)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "沈積": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى)",
 "沈積岩": "صَخْر رُسُوبِيّ",
 "沈積物": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "沈降": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى) / انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته) / ترسب, ترييح (غوص تدريجي إلى مستوى أدنى) / انحسار, هجوع (انخفاض في الشدة أو الدرجة (كما في أعراض المرض))\nمثال: سرطانه في حالة هجوع",
 "沈静": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل",
 "沈香": "عُود, رَنْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "沈鬱": "سَوْدَاوِيَّة",
 "沈黙": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري)",
 "沈黙は金": "اَلسُّكُوتُ مِن ذَهَبٍ",
 "沈黙は金雄弁は銀": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "沈黙寡言": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "沐する": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "沐浴": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام) / وُضُوء, غُسْل / وَضُوء",
 "沐猴": "سَعْدَان, قِرْد",
 "沓底": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "沓脱ぎ石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "沓野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沖": "أُوكِينَاوَا",
 "沖つ": "مُحِيطِيّ",
 "沖の太夫": "قَطْرَس (طائر بحري كبير)",
 "沖アミ": "كريل (قشريات عوالق تشبه الروبيان؛ مصدر رئيسي للغذاء للحيتان البالينية مثلاً)",
 "沖仲仕": "عامل ميناء (عامل ذكر يقوم بتحميل وتفريغ السفن في الميناء)",
 "沖合": "بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة) / بَحْرِيّ, نَحْو البَحْر ((للرياح) قادمة من اليابسة) / بَعِيد عَن الشَّاطِئ (على مسافة من الشاطئ)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر",
 "沖合い": "بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة) / بَحْرِيّ, نَحْو البَحْر ((للرياح) قادمة من اليابسة) / بَعِيد عَن الشَّاطِئ (على مسافة من الشاطئ)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر",
 "沖永": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沖波": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة)",
 "沖津": "مُحِيطِيّ",
 "沖浪": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة)",
 "沖田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沖積": "رسوبي, طمي (من أو يتعلق بالطمي (الترسبات النهرية))",
 "沖積土": "تربة طميية (تربة خصبة ناعمة الحبيبات ترسبها المياه المتدفقة فوق سهول الفيضانات أو في قيعان الأنهار)",
 "沖積層": "طَمْي, إِبْلِيز",
 "沖積平野": "سهل طمي (أرض منبسطة ناتجة عن رواسب متكررة من المواد الطميية بواسطة المياه الجارية)",
 "沖縄": "أُوكِينَاوَا",
 "沖縄山芋": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "沖縄方言": "لُغَة أُوكِينَاوَا (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "沖縄語": "لُغَة أُوكِينَاوَا (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "沖縄開発庁長官": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "沖繩": "أُوكِينَاوَا",
 "沖醤蝦": "كريل (قشريات عوالق تشبه الروبيان؛ مصدر رئيسي للغذاء للحيتان البالينية مثلاً)",
 "沖野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沖鱛": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "沙": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "沙市": "سِيَاتَل",
 "沙村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沙汰": "شَأْن / عَلَاقَة غَرَامِيَّة / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / إرشادات / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "沙汰の外": "عَبَثِيّ, سَخِيف",
 "沙汰の限り": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "沙汰やみ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "沙汰止み": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "沙港": "سِيَاتَل",
 "沙漏": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "沙皮": "جلد القرش (قماش ناعم هش الملمس)",
 "沙石": "حَصَاة",
 "沙穀": "ساغو (نشا مسحوق من بعض أنواع نخيل الساغو؛ يُستخدم في آسيا كمكثف للطعام ومقوٍ للمنسوجات)",
 "沙穀椰子": "سيكاس, نخيل الساغو (سيكاد قزم يشبه النخيل من اليابان ينتج الساغو) / نخيل الساغو (أي من أشجار نخيل آسيوية استوائية مختلفة تنتج جذوعها الساغو)",
 "沙羅": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "沙羅双樹": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "沙羅曼蛇": "سَمَنْدَل",
 "沙羅樹": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "沙鉢": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق الدوران بينما تتبع إبرة الفونوغراف الأخدود) / طبق تقديم كبير (طبق كبير ضحل يستخدم لتقديم الطعام)",
 "沙鶏": "قطا بالاس (قطا أوراسي ذو رقعة سوداء على البطن)",
 "沛然": "جَارِف, سَيْلِيّ (ينهمر بغزارة شديدة) / جَارِف, عَارِم (يُشْبِهُ السَّيْلَ فِي قُوَّتِهِ وَوَفْرَتِه) / جارف, سيلي (متعلق بالسيل أو ناتج عن تدفق قوي للمياه)\nمثال: تعرية سيلية",
 "没": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "没す": "غَطَسَ / مَجْلَى, مَغْسَلَة / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / صَادَرَ",
 "没する": "غَطَسَ / مَجْلَى, مَغْسَلَة / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / صَادَرَ",
 "没にする": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "没る": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "没交渉": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "没個性的": "غَيْر شَخْصِيّ, مُحَايِد (لا تفضيل شخصيّ لديه) / عام, غير شخصي (لا يتعلق بالأشخاص الفرديين أو لا يستجيب لهم)\nمثال: شركة غير شخصية",
 "没入": "تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف) / غَرَق",
 "没入感": "تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "没分暁漢": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "没却": "تَجَاهَلَ, طَنَّش",
 "没収": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "没取": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "没後": "بعد الوفاة (بعد الموت)\nمثال: نُشرت مقطوعات البيانو هذه بعد الوفاة",
 "没我": "إِيثَار, غَيْرِيَّة",
 "没我的": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "没法子": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "没理想": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "没義道": "وحشية",
 "没落": "خَرَاب, خَرَابَة / دَمَّرَ",
 "没薬": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "没趣味": "انْعِدَام الذَّوْق (عدم الأناقة الذي يدل عليه الافتقار إلى الذوق الرفيع) / انعدام النكهة, تفاهة (خاصية عدم امتلاك أي نكهة)",
 "没風流": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "没風流漢": "فلستيون",
 "没食子": "عَفْص",
 "没食子蜂": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "没食子酸": "حمض العفص, حمض الغاليك (حمض بلوري عديم اللون يتم الحصول عليه من العفص)",
 "沢": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء) / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "沢井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沢尻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沢山": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "沢本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沢村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沢渡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沢火革": "جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في الترانزستورات؛ يوجد في الجرمانيت والأرجيروديت)",
 "沢田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沢野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "沪紙": "ورق ترشيح (ورق مسامي غير معالج يستخدم للترشيح)",
 "沫": "فُقَّاعَة",
 "沮む": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "沮喪": "إحباط, انقباض (حالة من الاكتئاب السوداوي) / براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء)",
 "沮害": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "河": "نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ) / نهر أبيض (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر. / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "河の源": "مصدر غني, منبع (مصدر وفير) / مصدر رئيسي, منبع (مصدر المياه الذي ينشأ منه الجدول أو النهر)\nمثال: كانت نبعاً من المعلومات",
 "河上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河伯": "كَبَا",
 "河内": "هَانُوي",
 "河北": "خِبِي, خِيبِي",
 "河南": "خِنَان, خِينَان",
 "河原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河原乞食": "مُمَثِّل, مُمَثِّلَة",
 "河原撫子": "قرنفل رائع, قرنفل مهدب (قرنفل أوراسي معمر ذو زهور ليلكية أو وردية عطرة بحواف مهدبة بعمق) / لينانثوس (عشب متفرع بساق سلكية منخفض من جنوب كاليفورنيا له زهور وردية مهدبة)",
 "河原木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河原母子": "أناغاليس لؤلؤي (نبات خالد أمريكي له أوراق بشعيرات صوفية ناعمة ورؤوس عذقية بقنابات بيضاء لؤلؤية)",
 "河原者": "فنان ترفيهي, مُؤنِس (شخص يحاول إمتاع الناس أو تسليتهم)",
 "河原藤木": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "河原鳩": "حَمَام طُورَانِيّ, حَمَام أَزْرَق (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)",
 "河口": "مَصَبّ, فُغْرَة",
 "河合": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河太郎": "كَبَا",
 "河岸": "ضفة النهر / ضفة النهر / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "河崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河川": "نَهْر, أَنْهَار (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ) / نهر أبيض (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "河川敷": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "河床": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "河底": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "河心": "منتصف النهر, وسط المجرى (الجزء الأوسط من مجرى النهر)",
 "河本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河水": "جَدْوَل / تَيَّار / تَدَفّقَ",
 "河沿い": "ضفة النهر",
 "河流": "جَدْوَل / تَيَّار / تَدَفّقَ",
 "河海豚": "دلفين نهري (أي من عدة دلافين طويلة الخطم تعيش عادة في المياه العذبة في أمريكا الجنوبية وجنوب آسيا)",
 "河渠": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "河漢": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "河獺": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "河田": "إِتَا",
 "河畔": "ضفة النهر",
 "河童": "كَبَا / خِيَار (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "河童の屁": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "河端": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河竹": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى) / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "河西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河豚": "فوغو (سمكة منتفخة تحظى بتقدير كبير كطعام شهي في اليابان ولكنها خطيرة جداً لأن الجلد والأعضاء سامة)",
 "河跡湖": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة الرئيسية)",
 "河身": "قَنَاة",
 "河辺": "ضفة النهر",
 "河郎": "كَبَا",
 "河野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "河馬": "فَرَس نَهْر (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "河鱒": "تروتة الجدول (تروتة المياه العذبة في أمريكا الشمالية؛ أُدخلت إلى أوروبا) / تراوت الجدول (سمكة طعام لذيذة من المياه العذبة)",
 "沸々": "غليان هادئ (درجة حرارة أقل بقليل من نقطة الغليان)\nمثال: بقي الحساء يغلي بهدوء لساعات",
 "沸かし器": "إناء مزخرف, جرة كبيرة (مزهرية كبيرة عادة ما يكون لها قاعدة أو أرجل) / سماور, غلاية كبيرة (وعاء كبير لصنع القهوة أو الشاي)",
 "沸かし湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "沸かす": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "沸き": "غَلَيَان",
 "沸きかえる": "هَاجَ, غَلَى",
 "沸き上がる": "هَاجَ, غَلَى / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "沸き起こる": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "沸き返る": "هَاجَ, غَلَى",
 "沸く": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / ثَار (ثارَ يَثُورُ ثَوَرانًا، وثَوْرًا، وثَوْرَةً: هاج وانتَشَرَ؛ يُقال: ثارَ الدُّخانُ والغُبَرُ، وثار الدّم بفلان، وثارت به الحصْبَةُ، وثار به الشَّرُّ والغَضَبُ)\nمثال: ثار الفلاحون على الحكومة. / خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر. / ذَابَ, انْصَهَرَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "沸沸": "غليان هادئ (درجة حرارة أقل بقليل من نقطة الغليان)\nمثال: بقي الحساء يغلي بهدوء لساعات",
 "沸点": "احتقان, نقطة الغليان (أن يكون المرء غاضباً جداً أو منفعلاً؛ جاهز للانفجار) / نقطة الغليان (درجة الحرارة التي يغلي عندها السائل عند مستوى سطح البحر)\nمثال: بعد ساعة من الانتظار كنت عند نقطة الغليان",
 "沸石": "زيوليت (أي من عائلة المعادن الزجاجية المشابهة للفلدسبار والتي تحتوي على سيليكات الألومنيوم المائية للكالسيوم أو الصوديوم أو البوتاسيوم؛ تتشكل في تجاويف…)",
 "沸騰": "غَلَيَان / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "沸騰水型原子炉": "مفاعل الماء المغلي (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يغلي الماء في قلب المفاعل ويمكن للبخار الناتج تشغيل توربين بخاري)",
 "沸騰点": "احتقان, نقطة الغليان (أن يكون المرء غاضباً جداً أو منفعلاً؛ جاهز للانفجار) / نقطة الغليان (درجة الحرارة التي يغلي عندها السائل عند مستوى سطح البحر)\nمثال: بعد ساعة من الانتظار كنت عند نقطة الغليان",
 "油": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
