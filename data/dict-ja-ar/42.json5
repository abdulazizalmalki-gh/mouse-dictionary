 "歩く": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "歩ぶ": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "歩み": "مُتَجَسِّد\nمثال: مشي توم مع ماري. / خطوة, خطوة واسعة (خطوة في المشي أو الجري)\nمثال: عاش بوتيرة سريعة / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / زِفْت",
 "歩みよる": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني.",
 "歩み合い": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "歩み寄り": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "歩み寄る": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني.",
 "歩み方": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور.",
 "歩み板": "لوحة القدم (لوح عمودي أو لوحة تشكل قدم السرير)",
 "歩み続ける": "تَابَعَ, اِسْتَمَرَّ",
 "歩む": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا. / دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…) / صَعِدَ",
 "歩を進める": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "歩一歩": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "歩人": "مَاشٍ",
 "歩兵": "مُشَاة, بِيَادَة / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "歩兵戦闘車両": "مَرْكَبَةُ مُشَاةِ قِتَالِيَّة",
 "歩割": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير…)\nمثال: انخفض معدل الجريمة. / عُمُولَة",
 "歩卒": "جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة)",
 "歩合": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير…)\nمثال: انخفض معدل الجريمة. / عُمُولَة",
 "歩哨": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "歩容": "مشية (طريقة مشي الشخص)",
 "歩帯": "ميزاب حركي (إحدى المناطق الخمس على السطح السفلي لشوكيات الجلد التي توجد عليها الأقدام…)",
 "歩幅": "خُطْوَة, خَطْوَة",
 "歩廊": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر…)\nمثال: ذهب إلى الرواق.",
 "歩引き": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "歩掛り": "إنْتَاجِيَّة",
 "歩数計": "مقياس الخطوات (أداة قياس لتسجيل عدد الخطوات المقطوعة في المشي)",
 "歩様": "مشية (طريقة المشي)\nمثال: كان لديه مشية مضحكة",
 "歩武": "خُطْوَة, خَطْوَة",
 "歩留まり": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "歩留り": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "歩行": "مُتَجَسِّد\nمثال: مشي توم مع ماري. / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / مُتَجَسِّد\nمثال: مشي توم مع ماري.",
 "歩行器": "مشاية أطفال (هيكل مغلق على عجلات؛ يساعد الأطفال على تعلم المشي)",
 "歩行者": "رَاجِل, مَاشٍ",
 "歩行者用信号機": "عُبُورُ الْمُشَاة, مَمَرُّ الرَّاجِلِينَ",
 "歩行虫": "خنفساء أرضية (خنفساء أرضية مفترسة سوداء لامعة أو معدنية اللون تقضي على العديد من الحشرات…) / دُودَة أَلْفِيَّة, ذات الألف قدم",
 "歩行補助器": "مَاشٍ",
 "歩調": "خطوة, خطوة واسعة (خطوة في المشي أو الجري)\nمثال: عاش بوتيرة سريعة",
 "歩道": "مَمْشًى, مَسار الْشَاة",
 "歩道橋": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "歪": "مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / إِهْلِيلَج",
 "歪み": "سُلَالَة / التواء, تشويه (عملية لي أو تشويه شكل شيء ما (مثل الجسم))\nمثال: قام البهلوان بالتواءات لا تصدق / خلل بسيط, عقدة (صعوبة أو عيب في خطة أو عملية)\nمثال: لا يزال هناك بعض العقد التي يجب حلها",
 "歪む": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة)",
 "歪める": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / مُرْتَشٍ, فَاسِد",
 "歪力": "إِجْهَاد",
 "歪度": "تَجَانُف",
 "歪曲": "تحريف, تشويه (خطأ تحريف الحقائق)",
 "歯": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي. / سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "歯かす": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر)",
