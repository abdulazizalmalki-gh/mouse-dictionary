 "水涸れ": "جَفَاف",
 "水深計": "مقياس العمق (مقياس لقياس عمق الأخاديد أو الثقوب أو التجاويف الأخرى)",
 "水添": "هدرجة (عملية كيميائية تضيف ذرات الهيدروجين إلى زيت غير مشبع)\nمثال: يستخدم منتجو الأغذية الهدرجة لمنع الدهون من التعفن",
 "水源": "مصدر غني, منبع (مصدر وفير) / مصدر رئيسي, منبع (مصدر المياه الذي ينشأ منه الجدول أو النهر)\nمثال: كانت نبعاً من المعلومات",
 "水源地": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "水準": "مُسْتَوًى / مَرْحَلَة / مقياس مستوى الماء, ميزان ماء / مَنْسُوب المِيَاه, مُسْتَوَى المَاء (مستوى سطح جسم مائي) / خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن السفينة) / مستوى الماء, منسوب المياه الجوفية (السطح تحت الأرضي الذي تكون الأرض تحته مشبعة بالكامل بالماء)\nمثال: أمطار الربيع رفعت منسوب المياه الجوفية",
 "水準儀": "ميزان المساح (أداة مسح تتكون أساساً من تلسكوب صغير مع ميزان كحولي ملحق يدور حول محور عمودي؛ لقياس الارتفاعات النسبية للأرض)",
 "水準器": "مِيزَانُ مَاء (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "水準測量": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة) / تسوية بالأرض, دك (التدمير الكامل لمبنى) / تسوية الأرض, تمهيد (تغيير مستوى الأرض إلى سطح أفقي أملس أو منحدر بلطف)",
 "水準点": "علامة مرجعية, نقطة إسناد (علامة مسّاح على جسم دائم ذي موضع وارتفاع محددين مسبقاً تُستخدم كنقطة مرجعية) / علامة مرجعية, معيار مرجعي (معيار يمكن من خلاله قياس شيء ما أو الحكم عليه)\nمثال: لوحته تضع المعيار للجودة",
 "水溜まり": "غَدِير, بِرْكَة",
 "水溜り": "غَدِير, بِرْكَة",
 "水溶性": "ذَوَّابٌ فِي المَاء (قابل للذوبان في الماء)",
 "水溶液": "محلول مائي (محلول في الماء)",
 "水漉し": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "水漏": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "水漏り": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "水漏れ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "水澄": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水澄し": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水澄まし": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水濠": "قفزة مائية (بركة أو تيار مائي في سباق الحواجز أو مسابقة مماثلة) / خَنْدَق",
