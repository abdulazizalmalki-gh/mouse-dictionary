 "民族浄化": "تَطْهِير عِرْقِيّ (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "民族的": "عِرْقِيّ",
 "民族社会主義": "نَازِيَّة",
 "民族統一主義": "وَحْدَوِيّة",
 "民族自決": "تَقْرِيرُ المَصِير",
 "民族舞踊": "رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص.",
 "民族誌": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "民族誌学": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "民族資本": "عاصمة وطنية (العاصمة لبلد ما)",
 "民族集団": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "民族音楽": "فولك, موسيقى تراثية (الموسيقى التقليدية وعادة مجهولة المؤلف التي تعبر عن حياة الناس في مجتمع ما)",
 "民有化": "خَصْخَصَة, خَوْصَصَة",
 "民業": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "民権": "حق مدني (حق أو حقوق تخص الشخص بحكم المواطنة، بما في ذلك الحريات والامتيازات الأساسية…)",
 "民権主義": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ…)\nمثال: عاشت الديمقراطية!",
 "民法": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "民法典": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "民生": "مُسْتَهْلِك / مَدَنِيّ",
 "民生用": "مُسْتَهْلِك",
 "民画": "فن شعبي (نوع فني مجهول الأصل يعكس القيم التقليدية للمجتمع)",
 "民芸": "فن شعبي (نوع فني مجهول الأصل يعكس القيم التقليدية للمجتمع)",
 "民草": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "民衆": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "民衆化": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام)",
 "民衆扇動": "ديماغوجية, غوغائية (نداءات حماسية تخاطب تحيزات وعواطف الجماهير)",
 "民衆文字": "شَعْبِيّ, دَارِج",
 "民衆的": "مَحْبُوب",
 "民衆駅": "مَحَطَّة السِّكَك الْحَدِيدِيَّة, مَحَطَّة",
 "民訴": "دعوى مدنية (إجراء قانوني لحماية حق مدني خاص أو لفرض تعويض مدني (متميز عن الملاحقة الجنائية))",
 "民話": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "民論": "رَأْي عَامّ",
 "民謡": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية.",
 "民譚": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "民踊": "رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص.",
 "民進党": "الحزب الديمقراطي (الأقدم من بين الحزبين السياسيين الرئيسيين في الولايات المتحدة)",
 "民間": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / شَعْبِيّ",
 "民間人": "مواطن عادي (مواطن لا يشغل أي منصب رسمي أو عام)",
 "民間企業": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "民間会社": "شركة مساهمة خاصة, شركة مغلقة (شركة مملوكة لعدد قليل من الأشخاص؛ ليس لأسهمها سوق عام)",
 "民間伝承": "فُولْكْلُور, فُولْكُلُور",
 "民間団体": "مُنَظَّمَة غَيْر حُكُومِيَّة",
 "民間薬": "طب تقليدي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "民間語源": "تأثيل شعبي (تأثيل شائع ولكنه خاطئ)",
 "民間説話": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "民間防衛": "دِفَاع مَدَنِيّ, حِمَايَة مَدَنِيَّة",
 "民需品": "بضائع استهلاكية, سلع استهلاكية (بضائع (مثل الطعام أو الملابس) مخصصة للاستخدام أو الاستهلاك المباشر)",
 "気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / طَبِيعَة, طبيعة / قَصْد, إِرَادَة / مَزَاج / بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا. / لافِتَة\nمثال: توم وقع و أصيب. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "気がいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "気がかり": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気がすすまない": "غير راغب, نافر (غير راغب بسبب كره خفيف أو عدم موافقة)\nمثال: غير راغب في قول أي شيء لأي شخص",
 "気がする": "تحسس\nمثال: شعر ماريا طويل.",
 "気がつく": "لَاحَظَ",
 "気がつくと": "فَجْأَةً",
 "気がない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "気がもめる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気がよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "気が付く": "لَاحَظَ",
 "気が付くと": "فَجْأَةً",
 "気が向かない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "気が変": "مَجْنُون, مَخْبُول",
 "気が変わる": "غَيَّرَ رَأْيَهُ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "気が多い": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "気が大きい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "気が小さい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "気が差す": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気が弱い": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "気が強い": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "気が抜ける": "يَئِسَ, أُحْبِطَ",
 "気が揉める": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気が早い": "مُتَسَرِّع",
 "気が漫ろ": "مَهْوُوس, مُنْشَغِل (لَدَيْهِ انْشِغَالٌ مُفْرِطٌ أَوْ قَهْرِيٌّ بِشَيْءٍ مَا)",
 "気が無い": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "気が短い": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "気が置かれる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気が置けない": "لَطِيف, مَحْبُوب ((للأشخاص) لطيف المظهر والشخصية)",
 "気が良い": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "気が荒い": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "気が起きない": "غير متحمس, فاقد للدافع (بدون دافع)",
 "気が軽い": "خَفِيف الرُّوح, فَرِح (بلا هموم؛ سعيد وخفيف القلب)",
 "気が進まない": "غير راغب, نافر (غير راغب بسبب كره خفيف أو عدم موافقة)\nمثال: غير راغب في قول أي شيء لأي شخص",
 "気が遠くなる": "إِغْمَاء",
 "気が重い": "مُحْبَط, مُكْتَئِب",
 "気が長い": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "気さく": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "気ぜわしい": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)\nمثال: ليلة قلقة",
 "気だて": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "気だるい": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط)",
 "気っぷ": "شَخْصِيَّة\nمثال: زيري سيء الخلق.",
 "気っ風": "شَخْصِيَّة\nمثال: زيري سيء الخلق.",
 "気つけ薬": "اسْتِشْفائِيّ, تَعافٍ (يُساعِد عَلى التَّعافي واسْتِعادَة الصِّحَّة) / كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "気づかい": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "気づかれ": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気づかわしい": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "気づき": "وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي.",
 "気づく": "لَاحَظَ",
 "気で気を病む": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "気どり": "تَصَنُّع, تَكَلُّف",
 "気にいる": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "気にする": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "気になる": "عَجَب\nمثال: قطة؟ تساءل الرجل العجوز.",
 "気に入り": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "気に入る": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "気に召す": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "気に染む": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "気に病む": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "気のいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "気のう": "كيس هوائي (أي من الامتدادات الغشائية المملوءة بالهواء لرئات الطيور) / غلاف غازي, كيس المنطاد (الكيس الذي يحتوي على الغاز في المنطاد)",
 "気のきいた": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "気のきく": "مُنْتَبِه / أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "気のどくに思う": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "気のない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "気のよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "気の利いた": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "気の利く": "مُنْتَبِه / أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "気の多い": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "気の大きい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
