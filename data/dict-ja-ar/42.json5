 "相": "عَادَة, عُرْف / مَعًا, سَوِيًّا / تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / جانب, ناحية (خاصية أو جانب يجب أخذه بعين الاعتبار) / جانب, وجه (ميزة أو عنصر متميز في مشكلة ما) / إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: تعبير حزين / سحنة, محيا (الوجه البشري) / مَرْحَلَة / بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "相こ": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / مُتَسَاوٍ, مُتَصَالِح (على قدم المساواة عن طريق الدفع أو الردّ)",
 "相する": "يُقَدِّر / يُغَرِّم",
 "相づちを打つ": "سري, قناة خلفية (عبر قناة خلفية (غير رسمية أو سرية))\nمثال: فشل المفاوضات عبر القنوات الخلفية",
 "相なる": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "相まって": "مَعًا, سَوِيًّا",
 "相まつ": "اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "相まみえる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "相も変らず": "كَالْعَادَة, كَالْمُعْتَاد",
 "相も変らぬ": "عَادِيّ",
 "相も変わらず": "كَالْعَادَة, كَالْمُعْتَاد",
 "相も変わらぬ": "عَادِيّ",
 "相中": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "相乗": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "相乗作用": "تآزرية (العقيدة اللاهوتية القائلة بأن الخلاص ينتج عن التفاعل بين الإرادة البشرية والنعمة الإلهية) / تآزر, تعاضد (عمل شيئين معاً (عضلات أو أدوية مثلاً) لإنتاج تأثير أكبر من مجموع تأثيراتهما الفردية)",
 "相乗効果": "تآزر / تَعَاضُد",
 "相乗平均": "وسط هندسي",
 "相乗積": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "相互": "مُتَبَادَل",
 "相互いに": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "相互インダクタンス": "مَحَاثَّة مُتَبَادَلَة, مُعَامِل الحَثّ المُتَبَادَل (مقياس للحث بين دائرتين كهربائيتين؛ النسبة بين القوة الدافعة الكهربائية في دائرة والتغير المقابل في التيار في دائرة مجاورة؛ يقاس عادة بالهنري)",
 "相互互換性": "تَبَادُلِيَّة, قَابِلِيَّة لِلتَّبَادُل (صفة القابلية للاستبدال أو التبادل)",
 "相互作用": "تَآثُر, تَفَاعُل / مُخَالَطَة, تَفَاعُل",
 "相互依存": "اعْتِمَاد مُتَبَادَل, تَبَادُل (علاقة متبادلة بين كيانات مترابطة (أشياء أو أفراد أو مجموعات))",
 "相互動作性": "توافق تشغيلي",
 "相互参照": "إحالة مرجعية (إشارة في مكان واحد في عمل ما إلى معلومات في مكان آخر في نفس العمل)",
 "相互扶助": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "相互接続": "ترابط, توصيل بيني ((علم الحاسوب) عملية التوصيل البيني (للأسلاك أو أجهزة الكمبيوتر أو النظريات وما إلى ذلك)) / ترابط متبادل (حالة من الاتصال المتبادل)\nمثال: ترابط متبادل بين المبنيين",
 "相互接続性": "ترابط, توصيل بيني ((علم الحاسوب) عملية التوصيل البيني (للأسلاك أو أجهزة الكمبيوتر أو النظريات وما إلى ذلك)) / ترابط متبادل (حالة من الاتصال المتبادل)\nمثال: ترابط متبادل بين المبنيين",
 "相互理解": "تَفَاهُم مُتَبَادَل, وُدّ مُتَبَادَل (تعاطف كل شخص مع الآخر)",
 "相互確証破壊": "دمار متبادل",
 "相互誘導": "حث متبادل (توليد قوى دافعة كهربائية في دائرتين متجاورتين كل منهما في الأخرى)",
 "相互通信": "تواصل متبادل (تواصل متبادل؛ تواصل مع بعضهم البعض)\nمثال: اعترضوا التواصل المتبادل بين سفن العدو",
 "相互運用性": "توافق تشغيلي",
 "相互銀行": "بنك ادخار متبادل (بنك ادخار مرخص من الدولة ومملوك للمودعين فيه ويديره مجلس أمناء)",
 "相互関係": "تَرَابُط, عَلَاقَة مُتَبَادَلَة (علاقة متبادلة أو ارتباط متبادل)\nمثال: العلاقات المتبادلة بين بنية الحيوان ووظيفته",
 "相仲": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "相伝": "مِيرَاث, إرْثْ",
 "相伴": "مُشَارِك, نَشِط (يَأْخُذُ دَوْرًا فَاعِلًا فِي نَشَاطٍ مَا)",
 "相伴う": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
