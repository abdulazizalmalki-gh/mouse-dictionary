 "注文生産": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "注文者": "منظم, منهجي (منظم يضع الأشياء في ترتيب) / طالب بضاعة, مقدم الطلب (شخص يقدم طلباً للشراء)\nمثال: كان أرسطو منظماً عظيماً للأفكار",
 "注水": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها)",
 "注油": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "注疏": "تَعْلِيق",
 "注目": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "注目の的": "محور, مركز اهتمام (الشيء الذي يركز عليه الاهتمام والانتباه)\nمثال: قصصه جعلته محور الحفلة",
 "注目度": "حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز",
 "注目株": "أسهم ساخنة, إصدار ساخن (أسهم صادرة حديثاً عليها طلب عام كبير)",
 "注解": "بَرِيق",
 "注解者": "شارح, معلّق نصي (معلّق يكتب ملاحظات توضيحية لنص ما)",
 "注記": "تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "注進": "مَعْلُومَات, مَعْلُومَة",
 "注釈": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "注釈者": "شارح, معلّق نصي (معلّق يكتب ملاحظات توضيحية لنص ما)",
 "注音符号": "بُوبُومُوفُو",
 "泫然": "وَحِيد, مُنْفَرِد",
 "泰": "تَايْلَانْد, تَايْلَنْد (دولة تقع في جنوب شرق آسيا، تحدها ميانمار ولاوس وكمبوديا وماليزيا)\nمثال: بانكوك هي عاصمة تايلاند.",
 "泰国": "تَايْلَانْد, تَايْلَنْد (دولة تقع في جنوب شرق آسيا، تحدها ميانمار ولاوس وكمبوديا وماليزيا)\nمثال: بانكوك هي عاصمة تايلاند.",
 "泰山北斗": "عَلَم, نجم لامع (مشهور يمثل إلهاماً للآخرين)\nمثال: استضاف تجمعاً كبيراً من النجوم اللامعة",
 "泰山木": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور بيضاء ضخمة حلوة الرائحة)",
 "泰平": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "泰斗": "عَلَم, نجم لامع (مشهور يمثل إلهاماً للآخرين)\nمثال: استضاف تجمعاً كبيراً من النجوم اللامعة",
 "泰然": "هَادِئ / طَمْأَنَ",
 "泰然自若": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "泰西": "المغرب, نصف الكرة الغربي (نصف الكرة الذي يشمل أمريكا الشمالية وأمريكا الجنوبية)",
 "泰語": "تَايْلَنْدِيّ, تَايْلَانْدِيّ",
 "泳": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة",
 "泳いだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "泳ぎ": "سِبَاحَة",
 "泳ぎ手": "سَبَّاح, عَوَّام",
 "泳ぐ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "泳動": "هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "泳者": "سَبَّاح, عَوَّام",
 "洋": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ",
 "洋々": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / صَرِيح, فَجّ (يفتقر إلى الدقّة والخفاء؛ واضح وسافر) / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / عَرِيض, غَيْر مُفَصَّل (غير مفصل أو دقيق؛ يتناول الخطوط العامة فقط)",
 "洋がらし": "خَرْدَل",
 "洋の東西を問わず": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "洋上": "بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة) / بَحْرِيّ, نَحْو البَحْر ((للرياح) قادمة من اليابسة) / بَعِيد عَن الشَّاطِئ (على مسافة من الشاطئ)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر",
 "洋傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "洋刀": "سيف الفرسان, سيف مقوس (سيف قوي ذو نصل منحني وظهر سميك) / سيف ضالع, سيف منحني (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "洋品": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال) / خردوات, مستلزمات ملابس رجالية (السلع الجافة (كالملابس الرجالية أو أدوات الخياطة) التي يبيعها الخردواتي)",
 "洋式": "أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ / مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)",
 "洋弓": "رِمَايَة",
 "洋服タンス": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "洋服ダンス": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "洋服屋": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال) / خَيَّاط, خَيَّاطَة",
 "洋服店": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "洋服掛け": "شماعة, علاقة ملابس (علاقة مصممة على شكل أكتاف الشخص وتستخدم لتعليق الملابس عليها)",
 "洋服箪笥": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "洋洋": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / صَرِيح, فَجّ (يفتقر إلى الدقّة والخفاء؛ واضح وسافر) / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / عَرِيض, غَيْر مُفَصَّل (غير مفصل أو دقيق؛ يتناول الخطوط العامة فقط)",
 "洋灯": "مِصْبَاح (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي يُسْتَضَاءُ بِه، مِصْبَاح كَهْرَبَائِيّ) / لَمْبَة / قِنْدِيل (مصباح فيه فتيل يُضاء بالزيت) / سِرَاج\nمثال: ليس كل مصباح سحريا.",
 "洋灰": "أَسْمَنْت / سَمْنَتَ",
 "洋燈": "مِصْبَاح (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي يُسْتَضَاءُ بِه، مِصْبَاح كَهْرَبَائِيّ) / لَمْبَة / قِنْدِيل (مصباح فيه فتيل يُضاء بالزيت) / سِرَاج\nمثال: ليس كل مصباح سحريا.",
