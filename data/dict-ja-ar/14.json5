 "はなうらない": "عَرَافَة",
 "はなうりむすめ": "فتاة الزهور (فتاة صغيرة تحمل الزهور في موكب (الزفاف)) / بائعة الزهور (امرأة تبيع الزهور في الشارع)",
 "はなえんどう": "بَازِلَّاء الزُهُور",
 "はなおこぜ": "سمكة السرجس (أسماك صغيرة ذات أشكال وألوان عجيبة توجد بين كتل طحالب السرجس)",
 "はなかいどう": "تفاح بري جنوبي (شجرة صغيرة أو شجيرة من جنوب شرق الولايات المتحدة؛ تزرع للزينة لأزهارها الوردية اللون) / تفاح بيكتل البري (مشتق من تفاح آيوا البري ويزرع لأزهاره الوردية المزدوجة الكبيرة)",
 "はなかぜ": "زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع) / زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع) / نخير, نفخ (فعل الزفير بقوة)",
 "はなから": "مُنْذُ البِدَايَة",
 "はながさく": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "はながた": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق / إِجَّامَة / نَجْمَة",
 "はながたかい": "فَخُور",
 "はながない": "غَيْر جَذَّاب, غَيْر مُغْرٍ (غير قادر على جذب الانتباه الإيجابي) / بغيض, غير محبوب ((للشخصيات في الأدب أو الدراما) تميل إلى إثارة مشاعر النفور)\nمثال: جعلوا المكان غير جذاب قدر الإمكان",
 "はながみ": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "はながめ": "زَهْرِيَّة",
 "はなきり": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "はなきん": "الْجُمُعَة, الجُمْعَة",
 "はなぎ": "بُرَة",
 "はなぎれ": "طَوْق شَعَر (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "はなくそ": "مُخَاط, مُخَاط أَنْف",
 "はなぐすり": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "はなぐすりをかがせる": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "はなぐま": "قوطي (ثديي قارت من أمريكا الوسطى وأمريكا الجنوبية)",
 "はなげ": "مُغَفَّل, أَحْمَق",
 "はなげをぬく": "مُغَفَّل, أَحْمَق",
 "はなごけ": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "はなごんどう": "دلفين ريسو (دلفين رمادي أردوازي غير حاد الأنف شائع في البحار الشمالية) / أوركا, حوت قاتل (حوت مسنن مفترس أسود وأبيض ذو زعنفة ظهرية كبيرة؛ شائع في البحار الباردة)",
 "はなさ": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "はなさき": "أَمَامَ, قُدَّامَ / أَمَامَ / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "はなさきしあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなさきじあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなさきふんべつ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなさく": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "はなざかり": "فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول",
 "はなし": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / مَوْضُوع, مَوَاضِيع / مُنَاقَشَة, بَحْث / إِشَاعَة, شَائِعَة / ذهاب, رحيل (فعل المغادرة) / باستمرار",
 "はなしあい": "مُنَاقَشَة, بَحْث",
 "はなしあいて": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "はなしあう": "نَاقَشَ, بَحَثَ",
 "はなしかける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "はなしかわって": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "はなしかわるけど": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "はなしがい": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "はなしがはやい": "عَفْوًا",
 "はなしがわかる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "はなしことば": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "はなしじょうず": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "はなしずき": "نَمِيمَة, إِشَاعَة / اِغْتَابَ\nمثال: ジョージはとても話好きだ。 — جورج ثرثار جداً.",
 "はなしちゅう": "مَشْغُول",
 "はなして": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "はなしにならない": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "はなしのわかる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "はなしははやい": "عَفْوًا",
 "はなしばなし": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "はなしぶり": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "はなしょうぶ": "سوسن دموي",
 "はなしる": "مُخَاط, مُخَاط أَنْف",
 "はなしをさえぎる": "قَاطَعَ",
 "はなしをつける": "تَفَاوَضَ",
 "はなしをもる": "بَالَغَ",
 "はなじ": "رُعَاف",
 "はなじる": "مُخَاط, مُخَاط أَنْف",
 "はなす": "أَطْلَقَ سَرَاح, حَرَّرَ / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "はなせん": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "はなぞの": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "はなたか": "مَغْرُور, فَخُور",
 "はなたかだか": "فَخُور",
 "はなたけ": "شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية) / لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "はなたて": "زَهْرِيَّة",
 "はなたば": "شَذًى, شَذًا",
 "はなたらし": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はなたれ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はなたれこぞう": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف) / مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "はなだいこん": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "はなだか": "مَغْرُور, فَخُور",
 "はなぢ": "رُعَاف",
 "はなっつら": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "はなっぱし": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "はなっぱしがつよい": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "はなっぱしら": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "はなっぱしらがつよい": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "はなっぱしらのつよい": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "はなっぱり": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "はなつ": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار. / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس. / نَفَثَ, أَصْدَرَ\nمثال: そのごみ箱は悪臭を放っていた。 — أطلق صندوق القمامة رائحةً كريهة.",
 "はなつき": "مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / ازدهار, تفتح (عملية تنموية)\nمثال: نبات مزهر",
 "はなつきあい": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "はなつくり": "زراعة الزهور (زراعة النباتات المزهرة)",
 "はなつまみ": "إِزْعَاج",
 "はなづか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "はなづくり": "زراعة الزهور (زراعة النباتات المزهرة)",
 "はなづな": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً) / إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "はなづら": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "はなであしらう": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه) / أَفْطَس, قَصِير بِشَكْل غَيْر عَادِيّ (قَصير بِشَكْل غَيْر اعتِيادِيّ) / رفض, زجر (حالة من الإبعاد أو الصد)\nمثال: كان التجاهل متعمداً بوضوح",
 "はなとらのお": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "はなにかかった": "أَنْفِي",
 "はなにつく": "نَتُنَ, نَتِنَ",
 "はなのあな": "مَنْخَر",
 "はなのえん": "زَهْرَة كَرَز",
 "はなのき": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "はなのさ": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "はなのさき": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "はなのした": "نَثْرَة / فَم, بق",
 "はなのしたひも": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "はなのたかい": "فَخُور",
 "はなはだ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "はなはだしい": "الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "はなはだもって": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "はなはだ以て": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "はなはっか": "مَرْدَقُوش, مَرْدَقُوش بَرِّيّ",
 "はなばしら": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين) / حاجز (فاصل أو جدار خاصة في المبيض)",
 "はなばたけ": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "はなばち": "نَحْلَة / نَحْل / نحل / نحلة / بِي",
 "はなばな": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير / جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "はなばなしい": "باهِر",
 "はなひげ": "شَارِب",
 "はなひらく": "زَهْرَة / زَهَرَ ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: أرى زهرة على المكتب. / زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "はなひる": "عَطَسَ / عُطَاس, عَطْسَة",
 "はなび": "مُفَرْقِعَات, أَلْعَاب نَارِيَّة\nمثال: すごい花火だ！ — هذه الألعاب النارية رائعة!",
 "はなびしそう": "إيشولتسية, خشخاش كاليفورنيا (من ساحل المحيط الهادئ لأمريكا الشمالية؛ يزرع على نطاق واسع لزهوره الصفراء إلى الحمراء)",
 "はなびせんこう": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر) / ألماس (قطع الألماس (مصطلح عامي))\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "はなびびより": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر",
 "はなびら": "بَتَلَة, تُوَيْجَة",
 "はなふき": "مِنْدِيل, مَحْرَمَة",
 "はなふだや": "نينتندو",
 "はなぶさ": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "はなまがり": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "はなまち": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "はなまめ": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "はなみ": "زَهْرَة كَرَز / أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة) / رَخْت",
 "はなみず": "مُخَاط, مُخَاط أَنْف",
 "はなみのうたげ": "زَهْرَة كَرَز",
 "はなむけ": "شم (فعل إدراك رائحة شيء ما)",
 "はなむこ": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد)",
 "はなむすび": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "はなめ": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "はなめがね": "نظارة مشبك الأنف (نظارات تُثبت على الأنف بواسطة زنبرك)",
 "はなもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "はなもちならない": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "はなもちならぬ": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "はなもとしあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなもとじあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなもの": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "はなや": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة) / بائع زهور, منسق زهور (شخص يزرع الزهور ويتاجر بها)\nمثال: صنع بائع الزهور باقة جذابة",
 "はなやか": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "はなやさい": "قَرْنَبِيط, قُنَّبِيط",
 "はなやすり": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "はなよめ": "عَرُوس",
 "はなよめいしょう": "فستان زفاف (ثوب ترتديه العروس في حفل الزفاف)",
 "はなよめかいぞえにん": "وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف)",
 "はなよめがっこう": "مدرسة إتيكيت (مدرسة خاصة للفتيات تركز على التدريب في الأنشطة الثقافية والاجتماعية)",
 "はなよめごりょう": "عَرُوس",
 "はならび": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "はなる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はなれさる": "تَخَلَّى عَن, تَوَقَّفَ",
 "はなればなれ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "はなれる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はなれわざ": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "はなれ技": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "はなれ業": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "はなろくしょう": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر) / أخضر باريس (ملح مزدوج سام من زرنيخات النحاس وخلات النحاس)",
 "はなわ": "إِكْلِيل / بُرَة",
 "はなをかむ": "اِمْتَخَطَ, مَخَطَ",
 "はなをさかせる": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "はなをすする": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "はなをそえる": "غريس",
 "はなをならす": "استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء) / ضحكة ساخرة (ضحكة غير محترمة)",
 "はなキャベツ": "قَرْنَبِيط, قُنَّبِيط",
 "はなクソ": "مُخَاط, مُخَاط أَنْف",
 "はなピ": "بُرَة",
 "はなピアス": "بُرَة",
 "はなピー": "بُرَة",
 "はな垂らし": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はな垂れ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はな垂れ小僧": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف) / مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "はな水": "مُخَاط, مُخَاط أَنْف",
 "はにかみ": "خَجَل, حَيَاء (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق)\nمثال: توم لص بلا خجل.",
 "はにきぬきせない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにきぬきせぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにきぬをきせない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにきぬをきせぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにく": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "はにゅうのやど": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "はぬけ": "خلو الفم من الأسنان, درد (حالة أو وضعية عدم وجود أسنان)\nمثال: بشكل غير متوقع، استحضر صورة طبيب الأسنان المسؤول عن خلو فمه من الأسنان / انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "はね": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟ / جَنَاح / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / رِيشَة / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "はねあがり": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات / تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل)",
 "はねあがりもの": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はねあがる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / يتسرع",
 "はねあげ": "قَابِل لِلرَّفْع (مصمّم بحيث يمكن رفعه أو طيه جانباً)",
 "はねあげど": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "はねあげる": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "はねいた": "منطلق",
 "はねおと": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "はねかえす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "はねかえり": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はねかえる": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねかくし": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "はねかける": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねかざり": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "はねかす": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねぐるま": "دافعة (شفرة الدوار (كما في ضاغط المحرك النفاث))",
 "はねっかえり": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はねっ返り": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はねつき": "باتلدور (لعبة مضرب قديمة)",
 "はねつける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はねとばす": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري) / رشة, لطخة (كمية صغيرة من شيء رطب أو سائل)\nمثال: سمع طرطشة نيران",
 "はねのける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はねばし": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "はねる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / قَلَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "はねペン": "إِبْرَة, شَوْكَة",
 "はね上げる": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "はね橋": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "はね返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "はね返り": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はね飛ばす": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري) / رشة, لطخة (كمية صغيرة من شيء رطب أو سائل)\nمثال: سمع طرطشة نيران",
 "はのね": "نَاب (مَثَّل مكان أحد ما، كان نَائِبا عنه)\nمثال: كم يكلف ناب الفيل؟",
 "はのようせい": "جِنِّيّ أَسْنَان (جَنِيَ يَجْنَى جَنًى: خرج ظهرُه ودخلَ صدرُه؛ فهو أَجْنى)",
 "はは": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははうえ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははうし": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "ははうじ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "ははおや": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははおやぎょう": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははおやらしい": "أُمِّيّ, أُمُومِيّ",
 "ははかた": "أُمِّيّ, أُمُومِيّ",
 "ははぎみ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははご": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははじゃ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははじゃひと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははとじ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははなる": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははのひ": "عِيد اَلْأُمّ",
 "ははのみこと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "はば": "عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "はばかり": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام))",
 "はばかりさま": "شُكْرًا, تِسْلَم",
 "はばかりさん": "شُكْرًا, تِسْلَم",
 "はばかる": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "はばき": "طماق, غطاء ساق (رداء يغطي الساق (يمتد عادة من الركبة إلى الكاحل)) / إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "はばきき": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はばたき": "رَفْرَف",
 "はばたく": "رَفْرَف",
 "はばち": "دبور المنشار, ذبابة المنشار (حشرة تمتلك أنثاها آلة وضع بيض تشبه المنشار لإدخال البيض في أنسجة أوراق أو سيقان النبات العائل)",
 "はばったい": "عَرِيض / مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "はばつ": "طُغْمَة, عُصْبَة",
 "はばつきんこう": "توازن القوى",
 "はばとび": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض) / القفز الطويل, الوثب الطويل (مسابقة تتضمن القفز لأبعد مسافة ممكنة انطلاقاً من الجري)",
 "はばにする": "تَجَاهَلَ, طَنَّش / تَبَاهَى",
 "はばのせまい": "ضَيِّق",
 "はばのひろい": "عَرِيض",
 "はばひろ": "عَرِيض",
 "はばひろい": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "はばびろ": "عَرِيض",
 "はばむ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "はばり": "مِفْصَد, فَاصِد",
 "はびこる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "はふ": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون) / عجلة تلميع (عجلة مغطاة بمادة ناعمة)",
 "はふく": "بطن الموجة, نقطة التضاد ((في الفيزياء) نقطة الإزاحة القصوى في نظام دوري)",
 "はふらす": "تَجَاهَلَ, طَنَّش",
 "はぶ": "ذُو بُقَع صَفْرَاء (عليه بقع صفراء اللون)",
 "はぶく": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "はぶそう": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "はぶにする": "تَجَاهَلَ, طَنَّش",
 "はぶり": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はぶりがいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりがよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりのいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりのよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりの良い": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はへい": "مَقْبَض / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "はへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "はべらす": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はべり": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "はべる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はぼね": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "はま": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ. / يُوكُوهَامَا / ضفة النهر / رُقْيَة",
 "はまうつぼ": "هَالُوك, جَعْفِيل",
 "はまかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "はまかんざし": "بخل, تقتير (الحرص الشديد في إنفاق المال؛ التردد في إنفاق المال بلا ضرورة) / أرميريا, زهرة الثريفت (أي من العديد من النباتات دائمة الخضرة المحبة للشمس ومنخفضة النمو من جنس أرميريا لها رؤوس مستديرة من الزهور الوردية أو البيضاء)",
 "はまき": "سِيجَار, سِيكَار",
 "はまきタバコ": "سِيجَار, سِيكَار",
 "はますげ": "سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "はまとびむし": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "はまな": "كرامبي, كرنب بحري (نبات معمر في الرمال الساحلية والحصى لشمال أوروبا وبحر البلطيق والبحر الأسود له عناقيد من الزهور البيضاء الصغيرة وأوراق زرقاء خضراء لحمية كبيرة تستخدم…)",
 "はまなし": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "はまなす": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "はまひばり": "قبرة مقرنة",
 "はまびし": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "はまべ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "はまる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / رَضَّى",
 "はみ": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس) / بِت (انقطع؛ قَطَع) / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "はみがき": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "はみがきこ": "مسحوق الأسنان (مستحضر لتنظيف الأسنان في شكل مسحوق)\nمثال: 歯磨き粉はどこにありますか？ — أين معجون الأسنان؟",
 "はみがきざい": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "はみがきようじ": "فُرْشَاة أَسْنَان",
 "はみだし": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "はみだしもの": "مَنْبُوذ, مَنْبُوذَة",
 "はみだしもん": "مَنْبُوذ, مَنْبُوذَة",
 "はみだし者": "مَنْبُوذ, مَنْبُوذَة",
 "はみだす": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみでる": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出し": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "はみ出し者": "مَنْبُوذ, مَنْبُوذَة",
 "はみ出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出る": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はむ": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام) / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はむかう": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "はむし": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور) / خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "はむしゃ": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة",
 "はむはむ": "قَضَمَ",
 "はむら": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はめ": "لَجْنَة, لَجْنَة تَحْكِيم / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية / برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور)) / بِت (انقطع؛ قَطَع)",
 "はめあい": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はめいた": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة) / تلبيسة خشبية, وزرة جدارية (جدار مغطى بألواح (عادة خشبية) في جزئه السفلي)",
 "はめこみ": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "はめこむ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はめたおす": "ضَاجَعَ, جَامَعَ",
 "はめつ": "خَرَاب, خَرَابَة / دَمَّرَ",
 "はめつてき": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "はめはめ": "اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة) / مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "はめる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / حجيرة, رف رسائل (حجرة صغيرة) / تصنيف نمطي, خانة (فئة محددة (غالبًا ما تكون مبسطة)) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はめん": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "はめ倒す": "ضَاجَعَ, جَامَعَ",
 "はめ合い": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はめ込み": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "はめ込む": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はも": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام)",
 "はもじい": "مُحْرَج, بِٱلْحَرَج",
 "はもと": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "はもの": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: أحتاج الى سكين. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はものし": "سَكَاكِينِيّ",
 "はもん": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / تموج ((في الإلكترونيات) تذبذب ذو سعة صغيرة مفروض فوق قيمة ثابتة) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد) / حِرْمَان كَنَسِيّ",
 "はや": "منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية) / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "はやあし": "سير سريع (المسير بتوقيت سريع) / خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "はやい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はやいこと": "بِسُرْعَة, عَاجِلًا",
 "はやいとこ": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "はやいところ": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "はやいはなしが": "بِاخْتِصَار",
 "はやいもので": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "はやうしもよど、おそうしもよど": "هُنَاكَ, يُوجَدُ",
 "はやうま": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "はやおき": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح) / باكور, مبكر (شخص يصل مبكرًا قبل الآخرين)",
 "はやおきはさんもんのとく": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はやかれおそかれ": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "はやかろうわるかろう": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "はやがね": "جرس الإنذار, ناقوس الخطر (صوت إنذار (عادة جرس))",
 "はやがねをうつ": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "はやがわり": "مَسْخ",
 "はやく": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / بِسُرْعَة, عَاجِلًا / دور ثانوي, دور صغير (دور صغير) / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "はやくから": "في وقت مبكر, مبكراً (خلال مرحلة مبكرة)\nمثال: في وقت مبكر من مسيرتها المهنية",
 "はやくちことば": "جملة صعبة النطق, عقدة لسان (تعبير يصعب نطقه بوضوح)",
 "はやくも": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "はやけ": "احتراق الأوراق, لفحة الأوراق (مرض نباتي يسبب مظهرًا محترقًا أو ملفوحاً للأوراق)",
 "はやさ": "سُرْعَة / تبكير (صفة المجيء مبكراً أو في وقت أسبق)",
 "はやさい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "はやざき": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "はやし": "خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة. / أُورْكِسْتْرَا / حِلْيَة",
 "はやしたてる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "はやし立てる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "はやす": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "はやすぎる": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "はやせ": "سَرِيع",
 "はやつけぎ": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "はやて": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "はやと": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "はやとうり": "شَايُوت",
 "はやはや": "بِسُرْعَة, عَاجِلًا",
 "はやばや": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はやひと": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "はやぶさ": "صَقْر, شَاهِين",
 "はやま": "سَفْح (لها معانٍ متعددة تتعلق بالانصباب والسكب؛ أراقَ دمًا أو ماءً)\nمثال: كان ذلك الحوض في سفح الجبل.",
 "はやまる": "أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "はやまわし": "مسح, مسح ضوئي (فعل تحريك شعاع ضوئي أو إلكتروني بؤري بدقة بشكل منهجي فوق سطح ما لإنتاج صورة له للتحليل أو الإرسال) / مسح ضوئي (عملية ترجمة الصور إلى شكل رقمي يمكن للكمبيوتر التعرف عليه)",
 "はやみ": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "はやみち": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد)",
 "はやみみ": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "はやめ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / قَلِيلًا",
 "はやめに": "قَلِيلًا",
 "はやめる": "يقرب / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "はやり": "مُودَة, مُوضَة / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "はやりかぜ": "إِنْفْلُوَنْزَا",
 "はやりぎ": "نَفَاد صَبْر",
 "はやりことば": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "はやりっこ": "إِجَّامَة / نَجْمَة",
 "はやりっ子": "إِجَّامَة / نَجْمَة",
 "はやりめ": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "はやりもの": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "はやりやまい": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "はやり病": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "はやり目": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "はやり眼": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "はやり風邪": "إِنْفْلُوَنْزَا",
 "はやるきもち": "حَمَاس, حَمَاسَة",
 "はやる気持ち": "حَمَاس, حَمَاسَة",
 "はやわかり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "はやわざ": "مَأْثَرَة",
 "はやーい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はよ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はよう": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه. / شَجَاعَة, جَسَارَة / كَرَم, سَخَاء",
 "はらあか": "تَرُوتَة, أُطْرُوط",
 "はらあて": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / لَبَب",
 "はらい": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / كنس (فعل التنظيف بالمكنسة) / شَامِل, عَشْوَائِيّ (يَتَجَاهَل الفُرُوقَات وَالتَّمَايُزَات) / شَامِل, وَاسِع النِّطَاق (يشمل مساحة واسعة أو يتحرّك عبرها)",
 "はらいおとす": "اِنْتَفَضَ",
 "はらいきよめる": "صَفَّى",
 "はらいこみ": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "はらいこむ": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "はらいさげ": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "はらいし": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "はらいすぎ": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "はらいせ": "اِنْتِقَام",
 "はらいた": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "はらいだし": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "はらいだす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "はらいど": "بيرليت (خليط صفائحي من السمنتيت والفيريت يتشكل أثناء تبريد الأوستنيت؛ أحد مكونات الفولاذ والحديد الزهر)",
 "はらいのける": "يَدْرَأ",
 "はらいのこし": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "はらいのこり": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "はらいもどし": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "はらいもどしきん": "إِعَادَة مَال",
 "はらいもどす": "جَازَى",
 "はらいわたす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "はらう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / طَرَدَ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "はらえ": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "はらおち": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらおどり": "رَقْص شَرْقِيّ, رَقْص بَلَدِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "はらおび": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه) / خَصْر, مُحِيط الجسم (المسافة حول جسم الشخص)",
 "はらか": "تَرُوتَة, أُطْرُوط",
 "はらがいる": "أَهْدَأَ, هَدَّأَ",
 "はらがきまる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "はらがくろい": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "はらがけ": "مِرْيَلَة",
 "はらがふとい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "はらきり": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "はらぎたない": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "はらくだし": "مُلَيّن / إِسْهَال",
 "はらくだり": "إِسْهَال",
 "はらぐろ": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "はらぐろい": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "はらこ": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "はらさき": "تفريغ من المضمون (تغيير شيء ما (مثل قانون تشريعي أو بيان) بطريقة تقلل من قيمته) / إخراج الأحشاء, نزع الأحشاء (عملية إزالة الأمعاء أو الأحشاء؛ عملية القطع بحيث تبرز الأحشاء) / إفراغ الأحشاء (إزالة جراحية لعضو (أو محتويات عضو) من مريض)\nمثال: اعتماد تعديلاتهم كان سيعني تفريغ القانون من مضمونه",
 "はらじゅく": "هَارَاجُوكُو",
 "はらす": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)\nمثال: 彼は父の死の恨みを晴らした。 — انتقم لموت أبيه.",
 "はらすじ": "عضلة بطنية (عضلات البطن)",
 "はらたけ": "فطر الحقل, فطر المروج (فطر شائع صالح للأكل يوجد طبيعياً في التربة المفتوحة الرطبة؛ الفطر المزروع تجارياً)",
 "はらだたしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "はらだち": "غَضَب / أَغْضَبَ / غَضِبَ",
 "はらちがい": "أَبَوِيّ",
 "はらっぱ": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はらづもり": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "はらにいちもつ": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "はらにおさめる": "احتفظ بكل شيء لنسفه",
 "はらにおちる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらにたまる": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "はらのすわった": "بَاسِل, جَرِيء (يتميز بالشجاعة والتصميم في مواجهة الصعوبات أو الخطر؛ قوي وغير مكبوت)\nمثال: عليك أن تعجب بها: كان شيئاً جريئاً للقيام به",
 "はらのそこ": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "はらのむし": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة ولكن بعضها طفيلي)",
 "はらはら": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم)",
 "はらびれ": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه الحركة؛ تقابل الأطراف الخلفية للفقاريات البرية)",
 "はらへった": "أَنَا جَائِع, أَنَا جَائِعَة",
 "はらぺこ": "جَائِع, جَوْعَان",
 "はらぼて": "عرض, معرض (شيء يُعرض للجمهور) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "はらまき": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة))",
 "はらませ": "تَلْقِيح",
 "はらみ": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "はらみた": "كَمَال, إتقان",
 "はらみった": "كَمَال, إتقان",
 "はらみつ": "كَمَال, إتقان / جاكية",
 "はらむ": "حَبِلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته) / خَرَجَ بِ (اِنْتَقَلَ إلى خارج المكان)\nمثال: حبل الكذب قصير. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "はらもみのうち": "تَوَخَّى اَلْحِذْر",
 "はらやみ": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "はららご": "بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "はらり": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "はらわた": "مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان / فَرَث / مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…) / قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "はらわたのくさった": "فَاسِقٌ, مُنْحَرِف (يَنْحَرِفُ عَمَّا يُعْتَبَرُ أَخْلَاقِيًّا أَوْ صَحِيحًا أَوْ لَائِقًا)",
 "はらをきめる": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "はらをすえる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "はらん": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي / تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟ / حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل يجب تشكيلها بالصب)",
 "はらペコ": "جَائِع, جَوْعَان",
 "はらボテ": "عرض, معرض (شيء يُعرض للجمهور) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "はり": "إِبْرَة, مِخْيَط / خَطَّاف / لَكْمَة خُطَّافِيَّة / ضربة لاذعة (ضربة حادة مؤلمة) / إبرة لاسعة (عضو حاد للهجوم أو الدفاع (كما في الدبور أو سمك الراي اللاسع أو العقرب) غالباً ما يكون متصلاً بغدة سم) / ستينغر (نظام صواريخ أرض-جو محمول منخفض الارتفاع يستخدم التوجيه بالأشعة تحت الحمراء وصمام تصادم؛ يطلق من الكتف) / طَعْنَة, كَلِمَة جَارِحَة (ملاحظة قادرة على الجرح معنوياً)\nمثال: الطعنة الأكثر قسوة على الإطلاق / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / تَوَتُّر / شَدّ / جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / القدرة على التعافي بعد الصدمة / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / مَرْو, كَوَارْتْز / زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟ / إِبْرَة, مِخْيَط / الوَخْز بِالْإِبْر / خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "はりあい": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "はりあいのない": "مُحْبِط, مُثَبِّط",
 "はりあう": "تَنَافَسَ, تَبَارَى",
 "はりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "はりあな": "ثقب دبوس (ثقب صغير ربما يكون قد صنع بواسطة دبوس)",
 "はりうなぎ": "إلفير (صغير الأنقليس) / صغير ثعبان البحر (ثعبان بحر صغير؛ قد يقلى أو يحمر بالعجين)",
 "はりえ": "كولاج, مونتاج (تجميع ولصق مصنوع عن طريق لصق قطع من الورق أو الصور معاً لتشكيل صورة فنية) / تجميع فني, خليط (أي مجموعة من أشياء متنوعة)\nمثال: استخدم حاسوبه لعمل كولاج من الصور مركبة على خريطة",
 "はりえんじゅ": "شَجَرَةُ الْجَرَادِ, سَنْطٌ كَاذِبٌ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "はりお": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "はりかえる": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "はりかた": "قَضِيب اِصْطِنَاعِيّ",
 "はりがた": "قَضِيب اِصْطِنَاعِيّ",
 "はりがね": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "はりがねざいく": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "はりがねせいぞうこうじょう": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "はりがねむし": "دودة سلكية (يرقة تشبه الدودة لخنفساء النقر؛ تتغذى على جذور العديد من المحاصيل)",
 "はりがみ": "مُلْصَق / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "はりき": "أواني زجاجية (صنف من أدوات المائدة مصنوع من الزجاج) / صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "はりぐすり": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "はりこ": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / خَيَّاطَة",
 "はりこのとら": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
 "はりこみ": "كمين مراقبة (مراقبة مكان أو شخص ما من قبل الشرطة (كما في توقع جريمة)) / نَاطُور / تجميع ولصق (تكوين من أشياء مسطحة ملصقة على لوح أو خلفية أخرى)\nمثال: أروه تجميعاً ولصقاً لغلاف الكتاب",
 "はりこむ": "عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل) / إسراف استعراضي (عرض متباه (للجهد أو الإسراف، إلخ.))\nمثال: نوبة إفراط في التسوق / أَلْصَقَ",
 "はりさける": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "はりさし": "وسادة الدبابيس (وسادة صلبة صغيرة تغرز فيها الدبابيس لتكون جاهزة للاستخدام)",
 "はりしごと": "أشغال الإبرة, تطريز (العمل الذي يتم بالإبرة (مثل الخياطة أو التطريز)) / أشغال الإبرة, تطريز (إبداع تم إنشاؤه أو تجميعه بالإبرة والخيط)",
 "はりじょう": "إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر)",
 "はりす": "قَائِد, زَعِيم",
 "はりせんぼん": "سمكة النيص (تنتصب أشواكها عندما ينتفخ الجسم؛ توجد عالمياً في المياه الدافئة)",
 "はりたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "はりだし": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "はりだしまど": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "はりだす": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "はりつく": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / مَكَثَ, بَقِيَ / إِقَامَة",
 "はりつけ": "أَفِكْس / صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "はりつけばしら": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "はりつける": "أَلْصَقَ / إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "はりつめる": "سُلَالَة",
 "はりとばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "はりぬき": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "はりねずみ": "قُنْفُذ",
 "はりのめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "はりばん": "نَاطُور",
 "はりびゆ": "قطيفة شائكة (نبات حولي قائم في آسيا الوسطى الاستوائية وأفريقيا له زوج من الأشواك المتباعدة عند معظم عقد الأوراق)",
 "はりふだ": "مُلْصَق, أَفِيش",
 "はりほどのことをぼうほどにいう": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "はりぼて": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / زَائِف, مُتَظَاهَر بِه (مُتَّخَذ بغرض الخداع والتضليل) / زائف, مزيف (شيء هو تزييف؛ ليس كما يبدو) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "はりめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "はりもぐら": "قَصِير المِنْقَار (ذو منقار قصير)",
 "はりやま": "وسادة الدبابيس (وسادة صلبة صغيرة تغرز فيها الدبابيس لتكون جاهزة للاستخدام)",
 "はりん": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "はり札": "مُلْصَق, أَفِيش",
 "はり薬": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "はる": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة. / السَّنَة الْجَدِيدَة / مُمْتَاز, فَاخِر / مُرَاهَقَة / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَلَأَ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "はるあき": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "はるあさし": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "はるか": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / قَدِيماً",
 "はるかかなた": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "はるかに": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل / قَدِيماً",
 "はるかむかし": "قَدِيماً",
 "はるか彼方": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "はるぎ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "はるごま": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب) / أسطوانة مشروخة, موضوع مفضل (موضوع يعود إليه الشخص باستمرار)",
 "はるじおん": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة البيضاء أو الوردية النحيلة جداً؛ الولايات المتحدة وكندا)",
 "はるじょおん": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة البيضاء أو الوردية النحيلة جداً؛ الولايات المتحدة وكندا)",
 "はるたうち": "السَّنَة الْجَدِيدَة",
 "はるにみっかのはれまなし": "طقس جيد (طقس مناسب للأنشطة الخارجية)",
 "はるののげし": "تِفَاف, جَعْضِيض",
 "はるのみや": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "はるのめざめ": "بُلُوغ",
 "はるばる": "حتى النهاية, طوال الطريق (إلى الهدف) / إلى أبعد حد (كناية عن الوصول للعلاقة الجنسية الكاملة) / تَمَامًا, كُلِّيًّا\nمثال: تسلقت الجبل حتى النهاية",
 "はるまき": "سبرينغ رول, لفافة البيض (خضروات ولحم مفروم ملفوف في فطيرة ومقلية)",
 "はるやすみ": "عُطْلَة الرَّبِيع, إِجَازَة الرَّبِيع",
 "はれ": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "はれがましい": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "はれぎ": "أفضل الثياب, ملابس الأحد (أفضل الملابس التي يمتلكها الشخص والتي تلبس عادة للكنيسة يوم الأحد)",
 "はれつ": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / تَوَزُّع",
 "はれて": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "はればれ": "لَامِع, نَيِّر / مُسْتَنِير / شَفَّاف / وَاضِح",
 "はればれしい": "شَفَّاف / وَاضِح",
 "はれぼったい": "ذُو هَبَّات, هَبُوب (يَهُبّ عَلَى شَكْل هَبَّات أَوْ نَفَحَات مُتَقَطِّعَة) / مُتَوَرِّم, مُنْتَفِخ (مُتَمَدِّد بِشَكْل غَيْر طَبيعِيّ بِسَبَب السَّوائِل أو الغاز) / مُنَفَّش, مُنْتَفِخ (منفوخ وبارز؛ يُستخدم لتسريحة الشعر أو الملابس)",
 "はれま": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "はれもの": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "はれものにさわるよう": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "はれやか": "شَفَّاف / وَاضِح",
 "はれる": "اِنْتَفَخَ, وَرِمَ / جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "はれん": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "はれんち": "وَقِح, صَفِيق",
 "はれんちかん": "أَعْرَج",
 "はろう": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة / هروب من السجن (هروب من السجن) / كسر الحماية (إزالة أقفال الأمان من جهاز إلكتروني)\nمثال: تم التخطيط للهروب بعناية",
 "はろうちゅういほう": "أعالي البحار, مياه دولية (البحار المفتوحة في العالم خارج المياه الإقليمية لأي دولة)",
 "はわうじ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "はわく": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "はわじゃ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "はわじゃひと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "はをたてる": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "はをとなえる": "سَيْطَرَ",
 "はをみがく": "نَظَّفَ الْأَسْنَان\nمثال: タロー君、歯を磨いていらっしゃい。 — يا تارو روح وفرش أسنانك.",
 "はん": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / مَقَاس, قِيَاس / نِصْف, نُصْف / عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان / ضِدّ, مُضَادّ / تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / طَبْعَة / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / فِرْقَة, جَمَاعَة / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية / مِثَال, مَثَل / مِثَال / مُشْكِلَة, مَتاعِب / جَرِيمَة, جِنَايَة / جَرِيمَة\nمثال: ハイジャック犯達は飛行機の後部に移った。 — تحركوا خاطفو الطائرة الى مؤخرة الطائرة . / سيد (صيغة خطاب للرجل) / تَعْقِيد / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / أُوسَاكَا",
 "はんあい": "عمل خيري, هدية خيرية (التعزيز الطوعي لرفاهية الإنسان)",
 "はんい": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد. / اِتِّسَاع, مَدَّى",
 "はんいご": "عَكْس / نَقِيض",
 "はんいしき": "ترنح, ذهول (وعي هامشي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات / فِقْدَان اَلْوَعْي, إِغْمَاء / عقل باطن, لاوعي (حالة ذهنية غير متاحة للوعي المباشر)",
 "はんいんえい": "شِبْه ظِلّ",
 "はんいんよう": "خُنْثَى / خُنْثَوِيّ",
 "はんえい": "شِبْه ظِلّ / اِزْدِهَار, رَخَاء / اِنْعِكَاس, عَكْس / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "はんえいきゅうてき": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "はんえいゆう": "بطل مزيف, بطلة مزيفة",
 "はんえり": "قطعة رقبة (قطعة من الملابس تلبس حول الرقبة)",
 "はんえん": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة) / تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "はんえんけい": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "はんえんアーチ": "قوس روماني, قوس نصف دائري (قوس مستدير مرسوم من مركز واحد)",
 "はんおう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد. / مَاهَارَاجَا",
 "はんおん": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "はんおんかい": "سلم كروماتيكي, سلم لوني (سلم مكون من 12 نغمة يتضمن جميع أشباه النغمات في الأوكتاف)",
 "はんか": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / قُصُور ((في علم الأمراض) عجز جزء من الجسم أو عضو عن العمل بشكل طبيعي) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة / صخب, ضجة (اضطراب نشط وسريع) / إطار التنورة, بستل (هيكل يُلبس في الخلف أسفل الخصر لإعطاء امتلاء لتنورة المرأة) / تَعْمِيم",
 "はんかいおん": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "はんかがい": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "はんかくさい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はんかくめい": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "はんかこ": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "はんかつう": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود / مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "はんかん": "مشاعر مناهضة / مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات الاستخبارات المعادية أو الأفراد المنخرطون في التجسس أو التخريب أو التخريب…)",
 "はんかんすう": "عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين) / شَغَّال, عَامِل ((عَنِ الآلَات مَثَلًا) يَعْمَلُ أَوْ قَادِر عَلَى العَمَل) / وظيفي (يتعلق بالوظيفة أو يؤثر عليها بدلاً من علم وظائف الأعضاء (الفسيولوجيا)) / وَظِيفِيّ (مصمم لوظيفة معينة أو مكيَّف لاستخدام محدد)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "はんかんそう": "شِبْه قَاحِل (قاحل إلى حدٍّ ما)",
 "はんかんてき": "شِبْه رَسْمِيّ (له بعض السلطة أو الإقرار الرسميّ)",
 "はんが": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "はんがか": "صانع طباعة, فنان غرافيكي (فنان يصمم ويصنع المطبوعات)",
 "はんがた": "تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "はんがん": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / مُفَتِّش, مُفَتِّشَة / فَرْفُورِيُوس",
 "はんき": "عطلة نصف الفصل (إجازة قصيرة في منتصف الفصل الدراسي تقريباً)\nمثال: جاء للزيارة في عطلة نصف الفصل",
 "はんきかん": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض؛ معنية بالتوازن)",
 "はんきっぷ": "بنصف السعر (مقابل نصف السعر)\nمثال: اشترته بنصف السعر أثناء التخفيضات",
 "はんきゅう": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب) / نِصْف كُرَة",
 "はんきゅうけい": "نِصْف كُرَة",
 "はんきょう": "صَدًى / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "はんきょうげんご": "ترديد مرضي, مصاداة ((طب نفسي) تكرار ميكانيكي وبلا معنى لكلمات شخص آخر (كما في الفصام)) / إيكولاليا, محاكاة لفظية (تكرار الرضيع للأصوات التي ينطق بها الآخرون)",
 "はんきょうていい": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "はんきょうらん": "مُجَنَّن, مُختَلُّ العَقْل (دُفِع إلى الجنون؛ فَقَدَ عقله)",
 "はんきんぞく": "شِبْهُ فِلِزِّيّ (عُنْصُرٌ لَا فِلِزِّيٌّ لَهُ بَعْضُ خَصَائِصِ الفِلِزَّات)",
 "はんきんるい": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق) / متسلق (شخص يمارس التسلق كرياضة؛ وخاصة متسلق الجبال) / متسلق (شخص يصعد سيراً على الأقدام) / متسلق اجتماعي (شخص يسعى للوجاهة الاجتماعية من خلال التملق)\nمثال: بدا المتسلق القائد قوياً ولكن شريكه كان يترنح غالباً في حباله",
 "はんぎ": "طَابُوقَة",
 "はんぎご": "عَكْس / نَقِيض",
 "はんぎゃく": "خِيَانَة",
 "はんぎゃくざい": "خِيَانَة",
 "はんぎゃくしゃ": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんぎゃくにん": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんぎゃくぶんし": "مُرْتَدّ, مُنْشَقّ (تَخَلَّى عَنْ قَضِيَّة أَوْ مَبْدَأ) / خَائِن, مُرْتَدّ (شخص غير مخلص يخون أو يتخلى عن قضيته أو دينه أو حزبه السياسي أو صديقه، إلخ) / مرتد, منشق (شخص يتمرد ويصبح خارجاً عن القانون)",
 "はんぎょじん": "غرانق الماء",
 "はんぎり": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "はんぐつ": "محل, مكان (وضع معين)\nمثال: لو كنت مكاني ماذا كنت ستفعل؟",
 "はんぐん": "مُتَمَرِّد, ثَائِر",
 "はんけい": "كُعْبُرَة / نِصْف قُطْر, شُعَاع / تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "はんけいけんてき": "شِبْهُ تَجْرِيبِيّ (يعتمد إلى حدّ ما على الملاحظة أو التجربة)",
 "はんけっきゅうげんしょうしょう": "نقص الكريات الشامل (نقص غير طبيعي في جميع خلايا الدم (الحمراء والبيضاء والصفائح الدموية))",
 "はんけつ": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "はんけん": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية. / بذرَة",
 "はんけんしょゆう": "جَمِيع اَلْحُقُوق مَحْفُوظَة, كَافَّة اَلْحُقُوق مَحْفُوظَة",
 "はんけんしんがい": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "はんげき": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "はんげっかん": "مَرَّتَيْن فِي الشَّهْر (مرتين في الشهر) / نِصْفُ شَهْرِيّ (يحدث مرتين في الشهر) / نصف شهرية (دورية تصدر مرتين كل شهر (أو 24 عدداً في السنة))\nمثال: الرواتب تدفع مرتين في الشهر",
 "はんげつ": "تَرْبِيع / نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "はんげつがた": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "はんげつけい": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "はんげつばん": "هِلَالَة",
 "はんげつべん": "صمام هلالي (صمام قلبي ذو شرفات على شكل أنصاف أقمار؛ يمنع الدم من التدفق عائداً إلى القلب)",
 "はんげんき": "عمر النصف (الوقت اللازم لشيء ما للانخفاض إلى نصف قيمته الأولية (على وجه الخصوص، الوقت اللازم لتحلل نصف الذرات في مادة مشعة))",
 "はんげんじょうりく": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "はんこ": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "はんこう": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة من قوة مهاجمة) / جَرِيمَة, جِنَايَة / جَرِيمَة / نشر (العمل التجاري لإصدار المواد المطبوعة للبيع أو التوزيع) / فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم) / انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "はんこうたく": "نصف لامع (طلاء يجف بلمسة نهائية بين اللامعة وغير اللامعة)",
 "はんこうてき": "عَاصٍ",
 "はんこけい": "شِبْهُ صُلْب (صلب جزئيًّا؛ ذو صلابة ولزوجة وسطى بين الصلب والسائل)",
 "はんこたい": "شِبْهُ صُلْب (صلب جزئيًّا؛ ذو صلابة ولزوجة وسطى بين الصلب والسائل)",
 "はんこつのせいしん": "عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "はんこん": "نَدْبَة, نَدْب",
 "はんこんそしき": "نسيج ندبي (النسيج الضام الذي يشكل الندبة؛ يتكون من أرومات ليفية في الندبات الجديدة وألياف الكولاجين في الندبات القديمة)",
 "はんご": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء / اِسْتِفْهَام مَجَازِيّ",
 "はんごう": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "はんごてき": "سَاخِر, مُفَارِق (يَتَّسِمُ بِالتَّبَايُنِ بَيْنَ مَا هُوَ مُتَوَقَّعٌ وَمَا يَحْدُثُ فِعْلًا) / تَهَكُّمِيّ, سَاخِر (فكاهيّ بأسلوب ساخر أو هازئ)",
 "はんさ": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "はんさつ": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "はんさよう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんざい": "جَرِيمَة, جِنَايَة / جَرِيمَة",
 "はんざいがく": "علم الجريمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "はんざいきろく": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "はんざいし": "موت خاطئ, وفاة غير مشروعة (وفاة ناتجة عن فعل خاطئ أو إهمال؛ وفاة يمكن أن تكون أساساً لدعوى مدنية للحصول على تعويضات نيابة عن عائلة المتوفى أو ورثته)",
 "はんざいしゃ": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "はんざいしゅうだん": "جَرِيمة مُنَظَّمة",
 "はんざいせい": "إجرام (حالة كون الشخص مجرماً)",
 "はんざいそしき": "عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)",
 "はんざいにん": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "はんざいはっせいりつ": "مُعَدَّل الجَرِيمَة (نسبة الجرائم في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "はんざいばしょ": "مَسْرَح جَرِيمَة",
 "はんざいようぎしゃ": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "はんざいりつ": "مُعَدَّل الجَرِيمَة (نسبة الجرائم في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "はんざいれき": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "はんざいグループ": "جَرِيمة مُنَظَّمة",
 "はんざつ": "مَعْقِد / عُقْدَة",
 "はんし": "قاضٍ عسكري, محامٍ عسكري (ضابط أركان يعمل كمستشار قانوني لقائد عسكري) / محامٍ عسكري (ضابط معين في مكتب المحامي العام للقضاء العسكري)",
 "はんしき": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / صِيغَة",
 "はんした": "رسومات, عمل فني (صور فوتوغرافية أو تمثيلات مرئية أخرى في منشور مطبوع)\nمثال: كان الناشر مسؤولاً عن جميع الأعمال الفنية في الكتاب",
 "はんしゃ": "اِنْعِكَاس, عَكْس / مُنْعَكَس / قَاسِم / جَرِيمة مُنَظَّمة",
 "はんしゃうんどう": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "はんしゃかい": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها) / مُعَادٍ لِلاخْتِلَاط (يتجنّب الاتّصال بالآخرين وينفر منه)",
 "はんしゃかいせいじんかくしょうがい": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "はんしゃかいせいパーソナリティしょう": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "はんしゃかいせいパーソナリティしょうがい": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "はんしゃかいてき": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها) / مُعَادٍ لِلاخْتِلَاط (يتجنّب الاتّصال بالآخرين وينفر منه)",
 "はんしゃかいてきしゅうだん": "جَرِيمة مُنَظَّمة",
 "はんしゃかいてきせいりょく": "جَرِيمة مُنَظَّمة",
 "はんしゃかく": "زاوية الانعكاس (الزاوية بين شعاع منعكس وخط عمودي على السطح العاكس عند نقطة السقوط)",
 "はんしゃきょう": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "はんしゃさよう": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "はんしゃざい": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "はんしゃしじ": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "はんしゃしじだいめいし": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "はんしゃしんけい": "مُنْعَكَس",
 "はんしゃせい": "تأمل, تفكر (القدرة على التفكير الهادئ أو التأمل) / انعكاس, انعكاسية (القدرة على عكس الأشعة) / اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما) / انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "はんしゃだいめいし": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "はんしゃてき": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه) / اِنْعِكَاسِيّ, تِلْقَائِيّ (بِدُونِ إِرَادَةٍ أَوْ تَحَكُّمٍ وَاعٍ) / ضمير انعكاسي (ضمير شخصي يدل على أن فعل الفاعل يؤثر على الفاعل نفسه)",
 "はんしゃてきに": "انعكاسياً, بشكل لا إرادي (بطريقة انعكاسية؛ بواسطة ردود الفعل)\nمثال: أجابت بشكل لا إرادي",
 "はんしゃのう": "البَيَاض, القُدْرَة العَاكِسَة (نسبة الضوء المنعكس إلى الضوء الساقط)",
 "はんしゃは": "صَدًى",
 "はんしゃばん": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "はんしゃぼうえんきょう": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "はんしゃりつ": "اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما)",
 "はんしゃりょうほう": "ريفلعكسولوجي, علم المنعكسات (تدليك لتخفيف التوتر عن طريق ضغط الأصابع؛ يعتمد على الاعتقاد بوجود نقاط انعكاسية على القدمين واليدين والرأس متصلة بكل جزء من الجسم) / علم المنعكسات (دراسة الفعل المنعكس وعلاقته بسلوك الكائنات الحية)",
 "はんしゃろ": "فرن عاكس (فرن يتم فيه تسخين المواد المعالجة بشكل غير مباشر بواسطة اللهب الموجه إلى سقف وجدران الفرن)",
 "はんしゅ": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "はんしゅう": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "はんしゅつ": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "はんしゅりゅう": "هُدْب (هُدْبُ العين ما نبت من الشعر على أشفارها) / هُدُب (هُدْبُ العين ما نبت من الشعر على أشفارها)",
 "はんしょう": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل / إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان) / إنذار الحريق (صيحة أو جرس للتحذير من اندلاع حريق) / اِنْعِكَاس, عَكْس / تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد) / صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "はんしょうだいめいし": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "はんしょく": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "はんしょくき": "موسم التزاوج, موسم التكاثر (موسم التكاثر هو الموسم الأنسب، وعادة ما يكون بظروف مواتية ووفرة في الغذاء والماء، للتكاثر)",
 "はんしょくち": "مرتع, مفقس (مكان تتكاثر فيه الحيوانات)",
 "はんしょくひんば": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "はんしょくよう": "حِضْنَة, صغار (صغار حيوان يتم رعايتهم في وقت واحد)",
 "はんしょくりょく": "خُصُوبَة",
 "はんしん": "نِصْف إِلٰه",
 "はんしんきょう": "وَحْدَة اَلْوُجُود",
 "はんしんぞう": "مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "はんしんはんぎ": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / شَاكّ, غَيْر مُقْتَنِع (ليس على اقتناع أو يقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة)",
 "はんしんはんじん": "نِصْف إِلٰه",
 "はんしんふずい": "شلل نصفي (شلل جانب واحد من الجسم)",
 "はんしんまひ": "شلل نصفي (شلل جانب واحد من الجسم)",
 "はんしんよく": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "はんしんろん": "وَحْدَة اَلْوُجُود",
 "はんじ": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / نِصْف سَاعَة / ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز) / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんじせい": "دايامغناطيسية, مغناطيسية معاكسة (ظاهرة تظهرها مواد مثل النحاس أو البزموت التي تصبح ممغنطة في مجال مغناطيسي بقطبية معاكسة للقوة المغناطيسية؛ وعلى عكس الحديد يتم نفرها قليلاً بواسطة…)",
 "はんじどうしょうじゅう": "ذَاتِيّ التَّعْبِئَة, نِصْف آلِيّ ((للأسلحة النارية) قادر على التعبئة والإطلاق المتواصل آلياً) / نِصْف آلِيّ (آلي جزئياً) / مسدس نصف آلي (مسدس عبارة عن سلاح ناري نصف آلي قادر على التحميل والإطلاق بشكل مستمر)",
 "はんじもの": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "はんじゃ": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "はんじゅうしん": "ساتير",
 "はんじゅく": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع) / غَيْرُ جَاهِز, غَيْرُ نَاضِج (لم يكتمل استعداده بعد)\nمثال: فاكهة غير ناضجة",
 "はんじゅんじょしゅうごう": "فِئَةٌ مُرَتَّبَةٌ جُزْئِيًّا (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة) / مَجْمُوعَةٌ مُرَتَّبَةٌ جُزْئِيًّا (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "はんじょう": "تشويش, مقاطعة (الصياح لمقاطعة خطاب لا توافق عليه) / اِزْدِهَار, رَخَاء / مُبَرْقَع, مُرَقَّش (ذو بقع أو رقع من الألوان المتباينة)",
 "はんじょうし": "تسمم بالفلور, تفلور (حالة مرضية ناتجة عن التناول المفرط للفلور (عادة من مياه الشرب))",
 "はんじょうしゅっけつ": "ازرقاق, كدمة (هروب الدم من الأوعية الدموية الممزقة إلى الأنسجة المحيطة لتكوين بقعة أرجوانية أو سوداء وزرقاء على الجلد) / كدمة دموية (المنطقة الأرجوانية أو الزرقاء المسودة الناتجة عن الكدمة)",
 "はんじょうをいれる": "قَاطَعَ",
 "はんじょうをうつ": "قَاطَعَ",
 "はんじる": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "はんすい": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんすう": "نِصْف, نُصْف / أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات) / أحادي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على مجموعة كاملة واحدة فقط من الكروموسومات) / نَظِير جَمْعِيّ ((الرياضيات) أحد زوجين من الأعداد مجموعهما صفر؛ النظير الجمعي لـ -5 هو +5) / اجترار / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "はんすうせい": "أحادية الصيغة الصبغية (حالة كون الكائن أحادي الصيغة الصبغية)",
 "はんすうたい": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات) / أحادي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على مجموعة كاملة واحدة فقط من الكروموسومات)",
 "はんすうどうぶつ": "مُجْتَرّ / مُجْتَرّ, مُجْتَرَّات",
 "はんすうるい": "مُجْتَرّ / مُجْتَرّ, مُجْتَرَّات",
 "はんする": "نَاقَضَ / اِنْتَهَكَ / عَصَى",
 "はんずる": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "はんせい": "اِنْعِكَاس, عَكْس / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "はんせいいでん": "مرتبط بالجنس",
 "はんせつ": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي) / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "はんせん": "سَفِينَة شَرَاعِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "はんせんうんどう": "حركة مناهضة للحرب (حملة ضد دخول الحرب أو استمرارها)",
 "はんせんしゅぎ": "سَلَامِيَّة, سِلْمِيَّة",
 "はんせんしゅぎしゃ": "مُسَالِم / مُسَالِمَة",
 "はんぜん": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "はんそ": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق)",
 "はんそう": "إِبْحَار / نَقْل, نَقْلِيَّات / استشفاء, رعاية في المستشفى (الوضع تحت الرعاية الطبية في المستشفى) / تأمين دخول المستشفى (تأمين يدفع كل أو جزء من نفقات المستشفى للمريض) / استشفاء, تنويم في المستشفى (حالة تلقي العلاج كمريض داخل المستشفى) / إقامة بالمستشفى, استشفاء (فترة زمنية تكون فيها محتجزاً في المستشفى للعلاج)\nمثال: كان يأمل تجنب نفقات الاستشفاء",
 "はんそうきしゃ": "نِصْف مُجَنْزَر (له جنازير في الخلف وعجلات في الأمام)",
 "はんそうせん": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "はんそうは": "موجة حاملة",
 "はんそく": "مُخَالَفَة / اِنْتِهَاك / تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんそくきん": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "はんそくさいぼう": "نَقِيض (المقابل المباشر)\nمثال: الهدوء: نقيض الانشغال المركز",
 "はんそくまけ": "إِقْصَاء",
 "はんそくプレー": "خطأ ((بيسبول) فشل لاعب مدافع في إخراج الخصم عندما كان اللعب العادي كافياً لذلك)",
 "はんそで": "كم قصير, نصف كم (كم يمتد من الكتف إلى الكوع)",
 "はんぞく": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんたい": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / عَكَسَ / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "はんたいいけん": "رأي مخالف (رأي يختلف مع تصرف المحكمة في القضية)",
 "はんたいがわ": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "はんたいきゅうふ": "واحدة بواحدة",
 "はんたいご": "عَكْس / نَقِيض",
 "はんたいしゃ": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه",
 "はんたいじ": "حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "はんたいじんえい": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "はんたいじんもん": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر)",
 "はんたいせい": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "はんたいせいがわ": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "はんたいせいは": "مُنْشَقّ",
 "はんたいとうひょう": "استبعاد, حظر (فعل استبعاد شخص ما عن طريق تصويت سلبي أو حق النقض)",
 "はんたいひょう": "بَل (أصابه ماء كثير أو سائل آخر مشابه للماء؛ الشخصُ الشيءَ: صبّ عليه ماء كثير أو غمس الشيء في الماء)\nمثال: ليس أنا ، بل أنت!",
 "はんたいべんろん": "رد المدعى عليه الثاني (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تفنيد, نقض (الفعل الكلامي للدحض عن طريق تقديم حجة أو ادعاء معاكس)\nمثال: اليوم هناك برد.",
 "はんたいぼうえきふう": "رياح عكسية تجارية (رياح تهب من الغرب إلى الشرق وتقع فوق الرياح التجارية في المناطق المدارية)",
 "はんだ": "سبيكة لحام, مادة اللحام (سبيكة (عادة من الرصاص والقصدير) تستخدم عند صهرها لربط سطحين معدنيين)",
 "はんだい": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "はんだごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام",
 "はんだづけ": "لحام, لصق (التثبيت بإحكام معاً)",
 "はんだん": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "はんだんりょく": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんだんミス": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "はんだゴテ": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام",
 "はんだ付け": "لحام, لصق (التثبيت بإحكام معاً)",
 "はんちゅう": "فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "はんちゅうせいし": "نَقِيض النِّيُوتْرُون (الجسيم المضاد للنيوترون)",
 "はんちゅうせいびし": "نَقِيض النِّيُوتْرِينُو (الجسيم المضاد للنيوترينو)",
 "はんちょう": "ارتداد, انعكاس (حركة العودة من الارتطام) / ارتداد (الرجوع الخلفي المفاجئ للبندقية عند إطلاقها)",
 "はんちょくせん": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "はんつや": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "はんてい": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんていきじゅん": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار)",
 "はんていし": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "はんていりつ": "تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً",
 "はんてん": "جَوّ / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "はんてんこうせい": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة من قوة مهاجمة)",
 "はんてんぼく": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "はんで": "لِأَنَّ / هكذا, بلا سبب",
 "はんでおしたみたいに": "باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: لطيف وكريم دائماً",
 "はんでおしたよう": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "はんと": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط / مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "はんとう": "شِبْه جَزِيرَة / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "はんとうじん": "كُورِيّ",
 "はんとうまく": "غشاء شبه منفذ (غشاء (مثل غشاء الخلية) يسمح لبعض الجزيئات بالمرور من خلاله دون غيرها)",
 "はんとうめい": "شِبْه شَفَّاف (يسمح بمرور الضوء بشكل منتشر دون أن يكون شفّافاً تماماً)",
 "はんとき": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "はんとけいまわり": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "はんとしごとに": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة)",
 "はんどう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんどういるか": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "はんどうか": "رجعي",
 "はんどうかくめい": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "はんどうけいせい": "تكوين عكسي ((في الطب النفسي) آلية دفاع يطور فيها الشخص بغير وعي مواقف وسلوكاً معاكساً للرغبات والدوافع المكبوتة غير المقبولة وتعمل على إخفائها)\nمثال: أخلاقه الصارمة هي مجرد تكوين عكسي لإخفاء دافعه الجنسي",
 "はんどうげん": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "はんどうこう": "بورنيت, خام الطاووس (معدن يتكون من كبريتيدات النحاس والحديد ويوجد في رواسب النحاس)",
 "はんどうしゅぎ": "رجعية (التوجه السياسي للرجعيين)",
 "はんどうしゅぎしゃ": "رجعي",
 "はんどうたい": "شِبْه مُوَصِّل",
 "はんどうたいけんしゅつき": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "はんどうたいそし": "جهاز شبه موصل, نبيطة شبه موصلة (موصل مصنوع من مادة شبه موصلة)",
 "はんどうてき": "رجعي",
 "はんどうタービン": "توربين تفاعلي, عنفة رد الفعل (توربين بشفرات مرتبة لتوليد عزم الدوران من الانخفاض التدريجي لضغط البخار من المدخل إلى المخرج)",
 "はんどく": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "はんどくしがたい": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "はんどん": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "はんながぐつ": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات) / بسطار",
 "はんなま": "نَادِر / شِبْه جَافّ (جافّ إلى حدٍّ ما) / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はんなり": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "はんにゃとう": "غاية, غَرَض",
 "はんにゅうぐち": "باب الخدمة, مدخل الخدمة (مدخل مخصص لاستخدام الخدم أو لتسليم البضائع وإزالة القمامة)",
 "はんにん": "جَانٍ ((جَانَ) جونا وجونة: اسود) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "はんにんそく": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "はんにんまえ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "はんのう": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんのうじかん": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "はんのうせい": "استجابة, تفاعلية (الاستجابة للتحفيز) / تفاعلية, نشاط كيميائي (القابلية السريعة للتغير الكيميائي)",
 "はんのうちゅうかんたい": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "はんのうろ": "مُفَاعِل",
 "はんはん": "مُنَاصَفَةً, بِالنِّصْف",
 "はんばい": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "はんばいいん": "طاقم المبيعات (أولئك في شركة المسؤولون عن المبيعات)",
 "はんばいかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "はんばいがいしゃ": "قَاسِم",
 "はんばいき": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "はんばいぎょうしゃ": "تَاجِر, تَاجِرَة",
 "はんばいしゃ": "بَائِع, بَائِعَة",
 "はんばいじてん": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا الاتصالات) بين الأفراد والشركات في الولايات المتحدة) / ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش) / بولونيوم (عنصر فلزي مشع يشبه التيلوريوم والبزموت)",
 "はんばいじてんかんり": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا الاتصالات) بين الأفراد والشركات في الولايات المتحدة) / ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش) / بولونيوم (عنصر فلزي مشع يشبه التيلوريوم والبزموت)",
 "はんばいじてんじょうほうかんりシステム": "عند نقطة البيع (من أو متعلق بـ أو كونه الموقع الذي يتم فيه شراء شيء ما)",
 "はんばいじゅつ": "فن البيع, مهارة البيع (المهارة في البيع؛ المهارة في إقناع الناس بالشراء)\nمثال: قرأ كتابًا عن فن البيع لكنه لم يساعده",
 "はんばいすいしん": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんばいそくしん": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんばいてん": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "はんばいにん": "بَائِع, بَائِعَة",
 "はんばいねだん": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "はんばいひ": "تكلفة التوزيع (أي تكلفة يتكبدها منتج أو تاجر جملة أو تاجر تجزئة أو موزع (كما للإعلان والشحن وما إلى ذلك))",
 "はんばいぶ": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "はんばいぶもん": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "はんばいめい": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "はんばいもと": "بَائِع, بَائِعَة",
 "はんばく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "はんばり": "نصف نعل (نعل حذاء يمتد من القوس إلى إصبع القدم)",
 "はんぱ": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي) / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط / غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "はんぱく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "はんぱじゃない": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "はんぱつ": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / جَائِحَة",
 "はんぱつさよう": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / استهجان, نفور شديد (نفور شديد) / تنافر, قوة تنافر (القوة التي تتنافر بها الأجسام عن بعضها البعض)",
 "はんぱつりょく": "رجوعية, مرونة (الخاصية الفيزيائية للمادة التي تمكنها من العودة إلى شكلها أو موضعها الأصلي بعد تشوه لا يتجاوز حد المرونة) / رجوعية, مرونة (حدوث ارتداد أو رجوع للخلف)",
 "はんぱない": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "はんぱもの": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما) / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はんぱもん": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "はんぴゃく": "مُخْتَلِف, مُتَنَوَّع",
 "はんぶっしつ": "مَادَّة مُضَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "はんぶん": "نِصْف, نُصْف",
 "はんぶんすう": "كَسْر مُرَكَّب (كسر يحتوي على كسور في بسطه أو مقامه)",
 "はんぷ": "تَوْزِيع / قماش الأشرعة (قماش قوي (مثل قماش القنب القطني) يستخدم لصنع الأشرعة والخيام)",
 "はんぷく": "تَكْرَار, إِعَادَة / إعادة إنتاج, استنساخ (فعل عمل نسخ) / تكرار التجربة (تكرار تجربة لاختبار صحة استنتاجها) / مجسم, نسخة مطابقة (نسخة ليست الأصل؛ شيء تم نسخه) / تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير / عَوْدِيَّة / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / عَكَسَ / تَكْرَار, إِعَادَة",
 "はんぷくせい": "تكرار (إطناب ناتج عن التكرار المفرط) / مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية",
 "はんぷくてき": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية",
 "はんべい": "معاد لأمريكا (يعارض الولايات المتحدة وسياساتها) / مُعَادٍ لِأَمْرِيكَا (شخص يعارض الولايات المتحدة وسياساتها)",
 "はんべつ": "تَمْيِيْز",
 "はんべつがつく": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "はんべり": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "はんぺい": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال) / سُور / سِيَاج",
 "はんぺら": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "はんぺん": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال)",
 "はんぼいん": "أَشْبَاهُ العِلَلِ",
 "はんぼう": "مَشْغُول",
 "はんぽ": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "はんま": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はんまい": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "はんみち": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "はんみょう": "خُنْفُسَاء نَمِرِيَّة / خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "はんめん": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز / نِصْف, نُصْف / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَكَسَ",
 "はんめんきょうし": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "はんめんに": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はんも": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "はんもうしょう": "عَمًى",
 "はんもく": "عَدَاوَة",
 "はんもと": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はんももひき": "يصل للركبة (يمتد إلى الركبة) / مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "はんもん": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر) / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "はんもんおうのう": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "はんや": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "はんやく": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / كَرْشَنَة, نَقْصَوَة",
 "はんやけ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はんよう": "إِجْمالِيّ, جامِع / انشغال, دبيب (حالة الوجود أو الظهور بمظهر المنشغل بنشاط ما)\nمثال: أظهروا كل نشاط مجموعة من القنادس",
 "はんようがたコンピュータ": "حاسوب مركزي (حاسوب رقمي كبير يخدم 100-400 مستخدم ويشغل غرفة خاصة مكيفة الهواء)",
 "はんようき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんようし": "نَقِيض البُرُوتُون (بروتون غير مستقر سالب الشحنة؛ الجسيم المضاد للبروتون)",
 "はんようせい": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "はんようてき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんようひん": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんらたい": "شِبْه عَارٍ (مكسوّ جزئياً فقط)",
 "はんらん": "انتفاضة / غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "はんらんげん": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "はんらんしゃ": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんらんぶんし": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんりゅう": "تَيَّار مُعَاكِس (أفعال معاكسة لنشاط المجموعة الرئيسي) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)\nمثال: عطلت التيارات السياسية المعاكسة المؤتمر",
 "はんりゅうし": "جُسَيْم مُضَادّ (جسيم له نفس كتلة جسيم آخر ولكن له قيم معاكسة لخصائصه الأخرى؛ يؤدي تفاعل الجسيم وجسيمه المضاد إلى الفناء وإنتاج طاقة إشعاعية)",
 "はんりゅうどうたい": "شِبْهُ سَائِل (سائل إلى حدّ ما؛ بين الصلب والسائل)",
 "はんりょ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "はんりょく": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんりょどうぶつ": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان أَلِيف (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "はんりん": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "はんるい": "مُشْكِلَة, مَتاعِب",
 "はんれい": "مِثَال, مَثَل / مِثَال / أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح. / مِثَال مُعَاكِس, مِثَال مُضَادّ",
 "はんれいがん": "جابرو (واحد من عائلة الصخور المتطفلة الحبيبية)",
 "はんれいしゅう": "كِتَابِيّ, نَمُوذَجِيّ (وفقًا لما هو مذكور في الكتب المرجعية أو يتسم بخصائصها؛ نموذجي) / سجل القضايا, مدونة القضايا (كتاب يُحتفظ فيه بسجلات مكتوبة مفصلة لقضية ما ويعد مصدراً للمعلومات للعمل اللاحق)",
 "はんれい岩": "جابرو (واحد من عائلة الصخور المتطفلة الحبيبية)",
 "はんれき": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "はんれつ": "نَمَط / نُمُوذَج, مِثَال / قِيَاس",
 "はんろ": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق. / منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "はんろう": "مُشْكِلَة, مَتاعِب",
 "はんろん": "اِعْتَرَاض / اِعْتِرَاض / لَخَّصَ, اِخْتَصَرَ",
 "はんキリスト": "ضِدّ الْمَسِيح, الدَّجَّال",
 "はんクラ": "دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة)\nمثال: حرر القابض بسلاسة بقدم واحدة وداس على دواسة الوقود بالقدم الأخرى",
 "はんクラッチ": "دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة)\nمثال: حرر القابض بسلاسة بقدم واحدة وداس على دواسة الوقود بالقدم الأخرى",
 "はんゲルマンしゅぎ": "جامعة جرمانية (حركة كان هدفها التوحيد السياسي لجميع الشعوب التي تتحدث الألمانية أو اللغات الجرمانية)",
 "はんスラブしゅぎ": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "はんスラヴしゅぎ": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "はんズボン": "شُورْت",
 "はんセム": "مُعَادَاة السَّامِيَّة",
 "はんセムしゅぎ": "مُعَادَاة السَّامِيَّة",
 "はんダース": "سِتَّة (يَدُلُّ عَلَى العَدَد 6)",
 "はんトラストほう": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "はんドン": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "はんパン": "شُورْت",
 "はんファシズム": "مُعَادَاة الْفَاشِيَّة",
 "はんユダヤしゅぎ": "مُعَادَاة السَّامِيَّة",
 "はんユダヤしゅぎしゃ": "مُعَادٍ لِلسَّامِيَّةِ",
 "はん濫": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "はブラシ": "فُرْشَاة أَسْنَان\nمثال: この歯ブラシを使っているのは母ではない。 — الشخص الذي يستخدم فرشاة الأسنان هذه ليس أمي.",
 "はレタス": "خس مفكك الأوراق, خس ورقي (خس ذو أوراق مجعدة بشكل فضفاض لا تشكل رأساً مضغوطاً) / خس ورقي (يتميز بأوراق مجعدة أو محززة تشكل وريدة فضفاضة لا تتطور إلى رأس مدمج)",
 "はー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーあ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مَفْهُوم / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "はーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーッ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーーい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مَفْهُوم / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "は文字い": "مُحْرَج, بِٱلْحَرَج",
 "は種": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "は種床": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "ば": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / فُرْصَة, مُنَاسَبَة / مُنَاسَبَة (مؤنث مُنَاسَب؛ اسم مفعول من نَاسَبَ؛ التي نُوسِبَتْ أي اتُّخِذَتْ نَسِيبَة؛ الحَدَث الذي يكون مناسِبًا لفعل شيئا ما، غالبا ما يُقصد به حَدَثًا سعيدا وما يُراد فعله هو الاحتفال ويجوز استخدامها في الاحداث غير سعيدة)\nمثال: أرى مرآة مناسبة / مَنْظَر, مَشْهَد / مَشْهَد / مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / أَكْثَر / لِأَنَّ / هكذا, بلا سبب",
 "ばぁちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "ばぁば": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "ばあい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "ばあいわけ": "تَجَمُّع, مَجْمُوعَة (أيّ عدد من الكيانات (الأعضاء) يُعتبَر وحدة واحدة) / تجميع, تصنيف (نشاط جمع الأشياء معاً في مجموعات) / تجميع, تصنيف (نظام لتصنيف الأشياء إلى مجموعات)",
 "ばあさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "ばあたり": "مُدَرَّج مُغَطَّى, مِنَصَّة رَئِيسِيَّة (موقف في مضمار سباق أو ملعب يتكون من طبقات بها صفوف من المقاعد الفردية تحت سقف واقٍ) / المنصة الرئيسية, جمهور المدرجات (الجمهور في ملعب أو مضمار سباق) / خِصِّيصًا لِهَذَا الغَرَض (لغرض محدد) / لِغَرَض بِعَيْنِه, مَخْصُوص (مُخصَّص لغرض واحد معين أو معنيّ به) / مَخْصُوص, مُرْتَجَل (غالباً ما يكون مرتجلاً أو مخصصاً لغرض آني)\nمثال: تم تعيينهم لهذا الغرض / بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "ばあたりけいこ": "بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "ばあちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "ばあば": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "ばあや": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك سواء)",
 "ばい": "ثُنَائِيّ / ضِعْف / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / دُوَّامَة, بُلْبُل / لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / طبيب خيول (طبيب بيطري يعالج الخيول)",
 "ばいいん": "بِغَاءٌ, دَعَارَة",
 "ばいう": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ばいうき": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ばいえん": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "ばいおん": "نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي) / إِيحَاء, نَبْرَة خَفِيَّة ((عادة الجمع) معنى أو جودة ضمنية خفية)\nمثال: إيحاءات اليأس",
 "ばいか": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / زَهْرَة بَرْقُوق / سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "ばいかい": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة)",
 "ばいかいご": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ばいかいしゃ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / مُتَّجِهٌ / مُتَّجِهاتٌ / شُعاعٌ / أَشِعَّةٌ / ناقِلٌ / نَواقِلُ",
 "ばいかいぶつ": "مُتَوَسِّط / نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "ばいかいへんすう": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "ばいかさい": "زَهْرَة بَرْقُوق",
 "ばいきゃく": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "ばいきゃくかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "ばいきゃくだいきん": "إيراد إجمالي, مقبوضات (المبلغ الكامل للدخل قبل إجراء أي خصومات)",
 "ばいきゅう": "مُضَاعَف (ازداد كثيراً في الشدّة أو الحجم أو الكمّية)",
 "ばいきん": "جُرْثُومَة / خَشَاش, هَامَّة",
 "ばいこく": "خِيَانَة",
 "ばいこくど": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "ばいごま": "دُوَّامَة, بُلْبُل",
 "ばいさん": "العشاء الأخير (عشاء الفصح التقليدي ليسوع مع تلاميذه عشية صلبه) / الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "ばいしつ": "مُتَوَسِّط",
 "ばいしゃく": "تَدْبِير الزِيجَات (الوساطة من أجل تحقيق زواج بين الآخرين)",
 "ばいしゃくにん": "خَاطِب, خَاطِبَة",
 "ばいしゅう": "اِكْتِسَاب / رَشْوَة / رشوة",
 "ばいしゅん": "بِغَاءٌ, دَعَارَة",
 "ばいしゅんがい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "ばいしゅんふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ばいしゅんやど": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ばいしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة) / بِغَاءٌ, دَعَارَة / تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات",
 "ばいしょうきん": "تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة) / تعويض, ضمانة (إعفاء قانوني من المسؤولية عن الأضرار) / تأمين, ضمان (حماية ضد الخسارة المستقبلية)",
 "ばいしょうせきにんほけん": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "ばいしょうふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ばいしょうめいれい": "أمر محكمة (أمر صادر عن محكمة قانونية يطالب شخصاً بفعل شيء ما أو الامتناع عن فعله)",
 "ばいしょく": "بِغَاءٌ, دَعَارَة / تَهْذِيب",
 "ばいしん": "مُحَلَّفِين, هَيْئَةُ مُحَلَّفِين / لَجْنَة",
 "ばいしんいん": "مُحَلَّف",
 "ばいしんいんせき": "مقصورة المحلفين (منطقة مسيجة داخل قاعة المحكمة لهيئة المحلفين)",
 "ばいしんせい": "نظام هيئة المحلفين (نظام قانوني لتحديد الحقائق في دعوى قضائية)",
 "ばいしんせいど": "نظام هيئة المحلفين (نظام قانوني لتحديد الحقائق في دعوى قضائية)",
 "ばいじ": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "ばいじゅう": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "ばいじょ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ばいじん": "جسيمات, مادة جسيمية (كتلة صغيرة منفصلة من مادة صلبة أو سائلة تبقى منتشرة بشكل فردي في انبعاثات الغاز أو السائل (تعتبر عادة ملوثاً للغلاف الجوي))",
 "ばいすう": "متعدد / مُضَاعَف",
 "ばいすうせい": "تعدد الصيغة الصبغية (حالة كون الكائن متعدد الصيغة الصبغية)",
 "ばいすうたい": "متعدد الصيغة الصبغية (لخلية أو كائن حي يحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات) / متعدد الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات)\nمثال: خلية متعددة الصيغة الصبغية",
 "ばいすうひれいのほうそく": "قانون النسب المتضاعفة ((كيمياء) قانون ينص على أنه عندما يمكن لعنصرين أن يتحدوا لتكوين أكثر من مركب واحد، فإن كميات أحدهما التي تتحد مع كمية ثابتة من الآخر ستظهر علاقة…)",
 "ばいする": "ثُنَائِيّ / ضِعْف / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ばいせき": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "ばいせん": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات",
 "ばいせんざい": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / سَوْدَاوِيّ, قَاتِم (ساخر بقسوة؛ ذو طابع مُشؤوم) / مادة لاذعة, مثبت لون (مادة تستخدم لمعالجة الجلود أو المواد الأخرى قبل الصباغة؛ تساعد في عملية الصباغة)",
 "ばいぞう": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "ばいたい": "مُتَوَسِّط",
 "ばいたいしゅうたん": "إِم",
 "ばいたいアクセスせいぎょ": "معطف ماكنتوش (معطف واق من المطر مصنوع من قماش معالج بالمطاط)",
 "ばいたいインタフェースコネクタ": "ميكروفون (جهاز لتحويل الموجات الصوتية إلى طاقة كهربائية)",
 "ばいち": "وسط استنبات, وسط زرع ((علم الجراثيم) مادة مغذية (صلبة أو سائلة) تستخدم لزراعة الكائنات الحية الدقيقة)",
 "ばいちょう": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / طُعم, مستدرج (مخادع يقود شخصاً ما إلى الخطر (عادة كجزء من مؤامرة))",
 "ばいてん": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ばいどく": "زُهَرِيّ, مَرَض فِرَنْجِيّ",
 "ばいなら": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "ばいにする": "ثُنَائِيّ / ضِعْف",
 "ばいにん": "بَائِع, تَاجِر",
 "ばいばい": "تِجَارَة / مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "ばいばいかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "ばいぶん": "كاتب مأجور (كاتب متواضع المستوى ومحتقر (يكتب من أجل المال فقط دون اهتمام بالجودة))",
 "ばいぼく": "عرافة, قراءة الطالع (ممارسة التنبؤ بمستقبل الناس (عادة مقابل أجر))",
 "ばいまし": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "ばいも": "بُوقِيَّة, عَرَار",
 "ばいやく": "دواء مسجل براءة اختراع (دواء محمي ببراءة اختراع ومتاح بدون وصفة طبية من الطبيب)",
 "ばいやくしょう": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "ばいやくずみ": "مباع (تم التصرف فيه لمشتري)\nمثال: هذه البضاعة مباعة",
 "ばいやくてん": "صيدلية (متجر تجزئة تباع فيه الأدوية وسلع أخرى)",
 "ばいよう": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة. / تَهْذِيب",
 "ばいようえき": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "ばいようき": "مُتَوَسِّط",
 "ばいようし": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "ばいようど": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "ばいりつ": "تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع) / تَكْبِير (نسبة حجم الصورة إلى حجم الشيء)",
 "ばいりょく": "مؤازر آلي (من أو ينطوي على آليات مؤازرة (سيرفو)) / آلية مؤازرة, سيرفو (نظام تحكم يحول حركة ميكانيكية صغيرة إلى حركة تتطلب طاقة أكبر بكثير؛ قد يتضمن نظام تغذية مرتدة سلبية)",
 "ばいりん": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ばいをふくむ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "ばい菌": "جُرْثُومَة / خَشَاش, هَامَّة",
 "ばえ": "جَذَّاب, مُغْرٍ (قادر على جذب الاهتمام أو لفت الانتباه الإيجابي) / جذاب, محبوب ((للشخصيات في الأدب أو الدراما) تثير مشاعر التعاطف أو الإعجاب)\nمثال: أضاف شخصية جذابة لا تُنسى إلى الأساطير الأمريكية الشعبية",
 "ばおくれ": "رَهَاب المَسْرَح",
 "ばか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / غَبِيّ / غَبِيّ, أَحْمَق / تافِه / متعطل, مختل وظيفياً (لا يؤدي أو غير قادر على أداء وظيفته العادية)\nمثال: صمام متعطل",
 "ばかあたり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية))",
 "ばかく": "جلد الحصان (جلد مصنوع من إهاب الحصان)",
 "ばかくさい": "عَبَثِيّ, سَخِيف",
 "ばかげた": "عَبَثِيّ, سَخِيف",
 "ばかさわぎ": "مزاح خشن (لعب صاخب أو خشن)",
 "ばかざめ": "قرش متشمس (قرش شمالي كبير غير ضار يتغذى على العوالق؛ غالباً ما يسبح ببطء أو يطفو على سطح البحر)",
 "ばかし": "حَوَالَيْ, تَقْرِيبًا / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ばかじん": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "ばかす": "أَرْبَكَ",
 "ばかすか": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ばかず": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "ばかたれ": "أحمق, غبي (شخص غبي وغير كفء)",
 "ばかちん": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ばかっぽい": "غَبِيّ / غَبِيّ, أَحْمَق",
 "ばかでかい": "ضَخْم, هَائِل",
 "ばかでもチョンでも": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ばかとてんさいはかみひとえ": "هُنَاكَ, يُوجَدُ",
 "ばかどり": "قَطْرَس (طائر بحري كبير)",
 "ばかなまね": "حماقة, طيش (سلوك أحمق أو لا معنى له)",
 "ばかに": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "ばかにする": "سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "ばかにつけるくすりはない": "هُنَاكَ, يُوجَدُ",
 "ばかはっけんき": "تَغْرِيد",
 "ばかばかしい": "عَبَثِيّ, سَخِيف",
 "ばかばなし": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "ばかみたい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ばかもの": "مُغَفَّل, أَحْمَق",
 "ばかもやすみやすみいえ": "أَعْطِنِي",
 "ばかもん": "مُغَفَّل, أَحْمَق",
 "ばかやろう": "أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)\nمثال: 俺は人事課の馬鹿野郎にあごで指図されるつもりはない。 — لن يحكمني غبي من قسم الموارد البشرية.",
 "ばかよけ": "مُحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "ばからしい": "عَبَثِيّ, سَخِيف",
 "ばかり": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / حَوَالَيْ, تَقْرِيبًا / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ばかりでなく": "أَيْضًا",
 "ばかりに": "لِأَنَّ / هكذا, بلا سبب / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ばかわらい": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "ばかをいえ": "أَعْطِنِي",
 "ばかチョンカメラ": "كاميرا صوّب والتقط, كاميرا مدمجة (كاميرا تصوير خفيفة الوزن ذات تركيز تلقائي)",
 "ばがいしじょう": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة البورصة) / سوق التجزئة (السوق لبيع السلع أو الخدمات للمستهلكين بدلاً من المنتجين أو الوسطاء)",
 "ばがいとりひき": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "ばがば": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ばがぼん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ばきばき": "تصدع, شرخ (عملية إحداث شقوق في شيء ما) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / تصدع, طرقعة (ضجيج حاد مفاجئ) / تكسير (العملية التي يتم فيها تكسير جزيئات النفتا أو البترول الثقيلة إلى هيدروكربونات ذات وزن جزيئي أقل (خاصة في عملية تكرير النفط))",
 "ばぎゃば": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ばく": "دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى درجة تمنح في الدراسات العليا) / مَعْرِض / تَابِير / موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط / إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / شَاسِع, وَاسِع",
 "ばくあつ": "موجة صادمة",
 "ばくえい": "مُخَيِّم",
 "ばくえき": "قِمَار, مُقَامَرَة",
 "ばくおん": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "ばくか": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / شُوغُون",
 "ばくが": "مَلْت",
 "ばくがとう": "سكر الشعير, مالتوز (سكر بلوري أبيض يتكون أثناء هضم النشويات)",
 "ばくぎ": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "ばくぐい": "اِلْتَهَمَ",
 "ばくげき": "تَفْجِير, قَصْف / حَمْلَة / هَاجَمَ",
 "ばくげきき": "قَاذِفَة قَنَابِل",
 "ばくごう": "تَفْجِير",
 "ばくさい": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / زَاعِق, صَاخِب (عالٍ بشكل مزعج ونافذ)",
 "ばくし": "تَفْجِير, قَصْف",
 "ばくしゃ": "مُخَيِّم",
 "ばくしゅ": "بِيرَة, جِعَة",
 "ばくしゅく": "انحباس صوتي, انطباق (المرحلة الانحباسية الأولية للصامت الانفجاري) / انفجار داخلي, انكماش (انهيار مفاجئ نحو الداخل)\nمثال: انفجار المصباح الكهربائي نحو الداخل",
 "ばくしょく": "اِلْتَهَمَ",
 "ばくしん": "شَحْطَة / شَرْطَة",
 "ばくじゅう": "نقيع الشعير (مالت غير مخمر أو قيد التخمير) / عشبة (تستخدم عادة في التركيب: 'عشبة الكبد'، 'عشبة الحليب'، 'عشبة الدوامة')",
 "ばくじゅうろか": "رش, نثر (فعل رش أو طرطشة الماء)",
 "ばくする": "دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق) / كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب. / أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: إن توم لا يملك أسرة.",
 "ばくせい": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "ばくぜん": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ばくそう": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر)) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان)) / دوي, رعد (ضجيج عميق طويل وعالٍ)\nمثال: ثمل بشدة",
 "ばくたい": "ضِمَادَة, عِصَابَة / عِنان",
 "ばくだい": "شَاسِع, وَاسِع\nمثال: ジョンは莫大な財産を相続した。 — ورث جون ثروة كبيرة.",
 "ばくだん": "قُنْبُلَة / قَنْبَلَ",
 "ばくだんマーク": "قُنْبُلَة / قَنْبَلَ",
 "ばくち": "قِمَار, مُقَامَرَة / تَكَهُّنٌ / مُضَارَبَة / مُبَاغِت, مُفَاجِئ",
 "ばくちく": "مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك)",
 "ばくちやど": "بيت قمار, وكر قمار (مبنى عام يمكن فيه لعب مجموعة متنوعة من ألعاب الحظ (يُدار كعمل تجاري))",
 "ばくちん": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "ばくと": "مُقَامِر / مُغَامِر",
 "ばくとした": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ばくなき": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "ばくねん": "اشتعال سريع, تفرقع (احتراق ينتشر عبر غاز أو على سطح مادة متفجرة بمعدل سريع مدفوعاً بنقل الحرارة) / طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "ばくは": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "ばくはつ": "اِنْفِجَار, تَفْجِير / فورة, نوبة (اضطراب عنيف مفاجئ) / انفجار, تدفق عاطفي (تعبير غير مقيد عن العاطفة) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: اندلاع أمطار غزيرة",
 "ばくはつかん": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء تفاعل متفجر مدمر)",
 "ばくはつじこ": "اِنْفِجَار, تَفْجِير",
 "ばくはつてき": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "ばくはつぶつ": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "ばくはつガス": "غاز المناجم, فايردامب (خليط من الغازات (معظمها الميثان) يتشكل في مناجم الفحم ويصبح متفجراً عند اختلاطه بالهواء)",
 "ばくはんたいせい": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع محميين من قبل اللوردات الذين كان عليهم خدمتهم في الحرب)",
 "ばくばく": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة)) / خفقان, نبض قوي (حالة من النبض القوي والسريع (للقلب)) / ضرب متكرر, قصف (ضربات ثقيلة متكررة)\nمثال: فاجأه طرق القبضات المفاجئ / بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "ばくふ": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / شَلَّال",
 "ばくふう": "انفجار قنبلة (انفجار قنبلة)",
 "ばくやく": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "ばくよう": "قِمَار, مُقَامَرَة",
 "ばくらい": "قنبلة أعماق (قنبلة تنفجر عند عمق محدد مسبقاً تحت الماء؛ جهاز مضاد للغواصات)",
 "ばくりゅうしゅ": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "ばくりょう": "طَاقَم, طَاقِم",
 "ばくりょうちょう": "رئيس أركان الجيش",
 "ばくれつ": "اِنْفَجَرَ / تَفْرَقَعَ",
 "ばくれつだん": "قُنْبُلَة / قَنْبَلَ",
 "ばくろ": "إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)",
 "ばくろん": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "ばく然": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ばく進": "شَحْطَة / شَرْطَة",
 "ばぐ": "عِنان",
 "ばけがく": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها) / كِيمِيَائِيّ, كِيمِيَاوِيّ\nمثال: هو يحب الكيمياء.",
 "ばけのかわ": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ばけもの": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "ばけものやしき": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ばけもん": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "ばける": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / تَحَوَّلَ, مَسَخَ (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "ばけチェック": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "ばげん": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ばさばさ": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / غَيْرُ مَصُون, مُهْمَل (لَا يُعْتَنَى بِهِ أَوْ يُصَانُ بِشَكْلٍ صَحِيح) / أَشْعَث (لَمْ يُمَشَّطْ بِعِنَايَة) / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / بِشَكْل حَاسِم, بِشَكْل قَاطِع (بدرجة لا تقبل الجدل) / بِتَبْت, بِشَكْل نِهَائِيّ (مع النهائية؛ بشكل قاطع) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: قانون فيشر لعام 1918 رفع بشكل حاسم وضعهم وأجورهم",
 "ばさま": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة.",
 "ばさら": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم / تأنق مفرط (أسلوب وملابس المتأنق أو المغرور)",
 "ばした": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "ばしっと": "مُبَاشَرَةً",
 "ばしばし": "بِعُنْف / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "ばしゃ": "عَرَبَة / مُدَرِّب, مُدَرِّبَة / حافلة السفر, حافلة النقل الخارجي (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "ばしゃばしゃ": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح)",
 "ばしゃら": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم / تأنق مفرط (أسلوب وملابس المتأنق أو المغرور)",
 "ばしゅ": "سَائِس / هَندَم",
 "ばしょ": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض.",
 "ばしょがら": "حَالَة, وَضْع",
 "ばしょふさぎ": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "ばじゅつ": "فروسية (المهارة في التعامل مع الخيول وركوبها)",
 "ばじょう": "على ظهر الخيل, ممتطياً جواداً (على ظهر حصان) / صهوة, ظهر الحصان (ظهر الحصان) / ظهر الخنزير, هوتباك (سلسلة ضيقة من التلال)\nمثال: ركب على ظهر الخيل إلى المدينة",
 "ばじょうやりじあい": "مبارزة بالرماح (قتال بين فارسين يتبارزان بالرماح غير الحادة)",
 "ばすえ": "أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "ばせい": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "ばせん": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول) / وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان",
 "ばそり": "مجرور بالخيول (يسحب بواسطة حصان)\nمثال: عربة تجرها الخيول",
 "ばたあし": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "ばたっと": "فَجْأَةً",
 "ばたつかせる": "رَفْرَف",
 "ばたつく": "قَعْقَعَ",
 "ばたばた": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / وَاحِدًا تِلْوَ الآخَرِ / بانشغال, بنشاط (بطريقة مشغولة)\nمثال: كانوا منشغلين بشراء الهدايا التذكارية",
 "ばたり": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ばたん": "فَرْقَعَة / كوكاتو (ببغاء ذو عرف أبيض أو فاتح اللون من المنطقة الأسترالية؛ غالباً ما يتم الاحتفاظ به كطيور أقفاص)",
 "ばたんきゅう": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)",
 "ばた脚": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "ばた足": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "ばだい": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "ばち": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / ريشة / عصا الطبل (عصا تستخدم للقرع على الطبل) / ساق الطائر (الجزء السفلي من ساق الطائر)",
 "ばちあたり": "بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "ばちがい": "غَيْر مُلَائِم, غَيْر مُنَاسِب (غير مناسب لمناسبة معينة إلخ) / غَيْرُ لَائِقٍ, غَيْرُ مُنَاسِبٍ (لَا يَتَّسِقُ مَعَ مَا هُوَ صَحِيحٌ أَوْ لَائِقٌ)\nمثال: تبدو الضوضاء غير مناسبة في وقت الحزن",
 "ばちくそ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ばちこり": "بِإِتْقَان, تَمَامًا",
 "ばちこーん": "صفعة (فعل صفع شيء ما؛ ضربة توجه بكف مفتوحة) / قبلة حارة (قبلة مفعمة بالحماس) / ارْتِطَامًا, مُبَاشَرَةً / إتش, سم (أسماء دارجة للهيروين)\nمثال: اصطدم مباشرة بالعمود",
 "ばちばち": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية) / عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "ばちゃく": "لَبَّادَة, لُبَّادَة",
 "ばちん": "صفعة (فعل صفع شيء ما؛ ضربة توجه بكف مفتوحة) / قبلة حارة (قبلة مفعمة بالحماس) / ارْتِطَامًا, مُبَاشَرَةً / إتش, سم (أسماء دارجة للهيروين)\nمثال: اصطدم مباشرة بالعمود / دفعة طاقة, صدمة مفاجئة (حدث مفاجئ يمنح طاقة أو إثارة، عادةً بتأثير درامي)\nمثال: أعطوها دفعة أخرى من الإشعاع",
 "ばっか": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / شُوغُون",
 "ばっかく": "إرغوت, دابرة (فطر يصيب نباتات الحبوب المختلفة مكوناً كتلاً سوداء مدمجة من خيوط متفرعة تحل محل العديد من حبوب النبات؛ مصدر لقلويدات مهمة طبياً ولحمض الليسرجيك) / إرغوت (مرض نباتي يسببه فطر الإرغوت)",
 "ばっかし": "حَوَالَيْ, تَقْرِيبًا / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ばっかり": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / حَوَالَيْ, تَقْرِيبًا / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ばっかん": "قداحة, مشعل (جهاز لإشعال الوقود أو الشحنات أو الحرائق) / مادة إشعال, مشعل (مادة تستخدم لإشعال النار أو إضرامها)\nمثال: هل لديك ولاعة؟",
 "ばっき": "تَهْوِيَة",
 "ばっきょ": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "ばっきん": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "ばっきんけい": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "ばっくり": "فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول)",
 "ばっくん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "ばっこ": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "ばっこやなぎ": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
 "ばっこんき": "مشجع رياضي (مؤيد متحمس للرياضة)",
 "ばっさい": "حطابة, قطع الأشجار (عمل قطع الأشجار للحصول على الأخشاب)",
 "ばっさばっさ": "وَاحِدًا تِلْوَ الآخَرِ / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "ばっさり": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / بشكل جذري (بطريقة جذرية)",
 "ばっしょう": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "ばっすい": "مُقْتَطَف / خلاصة",
 "ばっする": "عَاقَبَ, قَاصَصَ\nمثال: どうしてあなたは彼らを罰しているのですか。 — ما الذي تعاقبهم عليه؟",
 "ばっせき": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "ばっせん": "فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً))\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "ばっそう": "قلع الأظافر (شكل من أشكال التعذيب يتم فيه نزع أظافر اليدين أو القدمين)",
 "ばっそく": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / قانون العقوبات (المدونة القانونية التي تحكم الجرائم وعقوباتها)",
 "ばっそん": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "ばった": "جُنْدُب, جَرَادَة",
 "ばったく": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "ばったもの": "تقليد, نسخة غير مرخصة (نسخة غير مصرح بها أو تقليد)",
 "ばったもん": "تقليد, نسخة غير مرخصة (نسخة غير مصرح بها أو تقليد)",
 "ばったり": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ばったん": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ばった物": "تقليد, نسخة غير مرخصة (نسخة غير مصرح بها أو تقليد)",
 "ばっち": "بِنْطَال, سِرْوَال (البِنْطَال : ضرب من الألبسة حديث يلبس في النصف الأسفل من الجسم يتكون من ساقين مثل السَرَاويِل إلا أنها أضيق…) / سِرْوَال اَلسُّنَة (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)",
 "ばっちぃ": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばっちい": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばっちし": "بِإِتْقَان, تَمَامًا / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "ばっちり": "بِإِتْقَان, تَمَامًا / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "ばっちー": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばってき": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "ばってん": "س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف العربية يسبقه حرف النُوْن ويلية حرف العَيْن وهو الحرف الثاني عشر بالترتيب…؛ تنقل المضارع من الحال إلى الاستقبال) / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "ばっと": "فَجْأَةً",
 "ばっとう": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "ばっぽん": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما) / جَذْرِيّ, صَارِم (قويّ وحازم وصارم)",
 "ばっぽんてき": "جَذْرِيّ, صَارِم (قويّ وحازم وصارم)",
 "ばっ気": "تَهْوِيَة",
 "ばつ": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / طُغْمَة, عُصْبَة / س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف العربية يسبقه حرف النُوْن ويلية حرف العَيْن وهو الحرف الثاني عشر بالترتيب…؛ تنقل المضارع من الحال إلى الاستقبال) / إكستاسي, إم دي إم إيه (عقار منشط مرتبط كيميائياً بالميسكالين والأمفيتامين ويستخدم بشكل غير مشروع لتأثيراته المبهجة والمهلوسة؛ كان يستخدم سابقاً في العلاج النفسي ولكن في عام…)\nمثال: غالباً ما يستخدم الإكستاسي في الحفلات لأنه يمكن رواد الحفلات من البقاء نشطين لفترات طويلة من الزمن / اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / خَاتِمَة",
 "ばつえい": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "ばつがわるい": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつが悪い": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつぐん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "ばつぞう": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "ばつぞく": "عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر)",
 "ばつだ": "جَزَاء",
 "ばつなぎ": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "ばつのわるい": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつの悪い": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつぶん": "خَاتِمَة",
 "ばつぼく": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "ばつもう": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "ばつもうしょう": "هوس نتف الشعر",
 "ばつもうへき": "هوس نتف الشعر",
 "ばつよう": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "ばつりゅう": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "ばつろ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "ばつをあたえる": "عَاقَبَ, قَاصَصَ",
 "ばてい": "سَائِس / هَندَم",
 "ばていけいアーチ": "قوس حدوة الحصان, قوس مغاربي (قوس مستدير يتسع قبل أن يدور)",
 "ばていせき": "سَبَج",
 "ばとう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ばなれ": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه)",
 "ばにく": "لَحْم حِصَان (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "ばにゅうしゅ": "كوميس (مشروب كحولي مصنوع من حليب الفرس المخمر؛ صنعه أصلاً بدو آسيا الوسطى)",
 "ばねじかけ": "آلية الساعة (أي آلية من عجلات مسننة يتم تشغيلها بواسطة زنبرك ملفوف؛ تشبه أعمال الساعة الميكانيكية)",
 "ばねはかり": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "ばねばかり": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "ばね仕掛け": "آلية الساعة (أي آلية من عجلات مسننة يتم تشغيلها بواسطة زنبرك ملفوف؛ تشبه أعمال الساعة الميكانيكية)",
 "ばね秤": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "ばのりょうしろん": "نظرية الحقل الكمومي (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "ばのりろん": "نظرية المجال ((فيزياء) نظرية تشرح ظاهرة فيزيائية من حيث مجال وطريقة تفاعله مع المادة أو مع مجالات أخرى)",
 "ばば": "خَرَاء, خِرَاء / خَرِئَ / بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا / جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز / جُوكَر / مضمار سباق (مسار تقام عليه السباقات)",
 "ばばあ": "عَجُوز / شَمْطَاء",
 "ばばくさい": "مُتَزَمِّت, وَسْوَاسِيّ (شَدِيد التَّدْقِيق بِشَكْلٍ مُتَزَمِّت)",
 "ばばこみ": "مَضْغُوط, مَكْبُوس (مضغوط معًا أو مكبوس بإحكام) / مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "ばばっちい": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばばぬき": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق واللاعب الذي يحمل الملكة غير المطابقة في نهاية اللعبة هو الخاسر) / خاسر في لعبة العانس / عانس (امرأة مسنة غير متزوجة) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "ばばばじゅつ": "ترويض الخيول, دريساج (مناورات الحصان استجابة لإشارات جسدية من الفارس)",
 "ばばー": "عَجُوز / شَمْطَاء",
 "ばば抜き": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق واللاعب الذي يحمل الملكة غير المطابقة في نهاية اللعبة هو الخاسر) / خاسر في لعبة العانس / عانس (امرأة مسنة غير متزوجة) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "ばひつ": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "ばひふう": "خُنَاق",
 "ばびそ": "رُعَام",
 "ばふんし": "مُنْخَفِض الدَّرَجَة",
 "ばふんづか": "كومة روث, مزبلة (كومة من الروث أو القمامة) / مزبلة (حالة قذرة أو متدهورة)",
 "ばぼう": "مَعْلِف, مُرَاح / بَسْطة",
 "ばみり": "سنبلة",
 "ばむ": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "ばめん": "مَنْظَر, مَشْهَد / مَشْهَد",
 "ばめんてんかん": "معطف ذيل, معطف مشطوف (معطف رجالي مقصوص بشكل قطري من الخصر إلى خلف الركبتين) / رسم مقطعي (تمثيل (رسم أو نموذج) لشيء ما يتم فيه حذف الجزء الخارجي للكشف عن الأجزاء الداخلية)",
 "ばや": "وَدَّ (تمنى ورجا؛ أراد شيئا)\nمثال: السيدة وود طباخة جيدة. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "ばやい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "ばやく": "كاناستا (شكل من أشكال الرومي يستخدم رزمتين من الأوراق وأربعة جوكر؛ الجوكر والاثنين هما أوراق حرة؛ الهدف هو تشكيل مجموعات من نفس الرتبة)",
 "ばら": "قِرْش, عُمْلَة",
 "ばらいろ": "لَامِع, نَيِّر / مُسْتَنِير",
 "ばらえん": "حديقة ورود (حديقة لزراعة الورود)",
 "ばらきせき": "رودونيت (معدن وردي أو أحمر يتكون من سيليكات المنغنيز البلورية؛ يستخدم كحجر زينة)",
 "ばらけつ": "جانح, حدث جانح (مذنب شاب)",
 "ばらしん": "طفح جلدي (أي طفح أحمر على الجلد)",
 "ばらじゅうじだん": "صليبي وردي (من أو متعلق بالصليب الوردي (روزيكروشيان)) / صَلِيبِيّ وَرْدِيّ (عضو في جمعية سرية في القرن السابع عشر للفلاسفة والعلماء) / عُضْو جَمْعِيَّة الصَّلِيب الوَرْدِيّ (عضو في أي من المنظمات المختلفة التي اشتقت لاحقاً من جمعية القرن السابع عشر)",
 "ばらす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "ばらせん": "سِلْك شَائِك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن. / قِرْش, عُمْلَة",
 "ばらつき": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / تَشَتُّت",
 "ばらつく": "مَطَر, مطر (السماء: أنزلت مَطَرًا) / أَمْطَرَ, مَطَرَ / أَمْطَرَ\nمثال: فجأة هطل المطر.",
 "ばらづみ": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "ばらのつぼみ": "فتاة يافعة ((إشارة أدبية إلى) فتاة شابة جميلة) / برعم الورد (برعم زهرة الورد)",
 "ばらばら": "مُتَفَرِّق",
 "ばらばらになる": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "ばらまき": "إِذَاعَة",
 "ばらまく": "نَثَرَ, تَفَرَّقَ",
 "ばらまど": "نافذة وردية (نافذة دائرية مليئة بالزخارف)",
 "ばらむつ": "السمكة الزيتية (ماكريل ثعباني كبير جداً يعيش في المياه العميقة)",
 "ばらもん": "بِرَهْمَن / براهمانية (المعتقدات الدينية للهند القديمة كما هو محدد في الكتب المقدسة الفيدا والبراهمانا والأوبنشاد) / البراهمية (النظام الديني والاجتماعي للهندوسية الأرثوذكسية)",
 "ばらもんきょう": "براهمانية (المعتقدات الدينية للهند القديمة كما هو محدد في الكتب المقدسة الفيدا والبراهمانا والأوبنشاد) / البراهمية (النظام الديني والاجتماعي للهندوسية الأرثوذكسية)",
 "ばらゆ": "زيت الورد (زيت عطري متطاير يتم الحصول عليه من الورود الطازجة بالتقطير بالبخار)",
 "ばらり": "مُتَفَرِّق / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "ばらん": "حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل يجب تشكيلها بالصب)",
 "ばら撒き": "إِذَاعَة",
 "ばら撒く": "نَثَرَ, تَفَرَّقَ",
 "ばら積": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "ばら積み": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "ばら色": "لَامِع, نَيِّر / مُسْتَنِير",
 "ばら蒔き": "إِذَاعَة",
 "ばら輝石": "رودونيت (معدن وردي أو أحمر يتكون من سيليكات المنغنيز البلورية؛ يستخدم كحجر زينة)",
 "ばら銭": "قِرْش, عُمْلَة",
 "ばり": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها. / ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / رايش, نتوء خشن (نتوء خشن يتبقى على قطعة العمل بعد الحفر أو القطع) / ريشة حفر, مبرد دوار (مبرد دوار لتنعيم الحواف الخشنة المتبقية على قطعة العمل) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / بَوْل",
 "ばりき": "حِصَان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد. / مجرور بالخيول (يسحب بواسطة حصان)\nمثال: عربة تجرها الخيول",
 "ばりきかじゅう": "حِمْل القُدْرَة (نسبة وزن الطائرة إلى قدرة محركها)",
 "ばりざんぼう": "إِهَانَة, سَبّ (تعبير وقح يهدف إلى الإساءة أو الأذى) / تَشْوِيه السُّمْعَة, تَلْطِيخ السُّمْعَة (تشهير افترائي)\nمثال: عندما ارتكب الطالب خطأ غبياً لم يوفر له أي شتيمة",
 "ばりっと": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية",
 "ばりばり": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "ばれい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ばれいしょ": "بَطَاطَا / بَطَاطِس",
 "ばればれ": "بَدِيهِيّ, بَدَهِيّ",
 "ばれる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "ばれん": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "ばろく": "لِجَام, صُرْع",
 "ばわい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "ばをはなれる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ばん": "مَقَاس, قِيَاس / طَبْعَة / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / مَسَاء / عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟ / لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله. / تَمَامًا / عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / دجاجة الماء (أنثى طائر الطيهوج الأحمر) / دجاجة الماء (دجاجة ماء سوداء تسكن البرك والبحيرات)",
 "ばんい": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "ばんいち": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "ばんいつ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "ばんか": "رِثَاء, مَرْثِيَة / طَمَاطِم / بَنَدُورَة / بَنْدُورَة",
 "ばんかい": "شِفَاء, تَعَافِي",
 "ばんかきょう": "مِشْكَال, مِنْظَارُ التَّهَاوِيل",
 "ばんから": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "ばんかん": "مُتَأَخِّر النُّضْج (من النباتات التي تنضج في الخريف)",
 "ばんかんじょうみゃく": "وريد ضعفاني (واحد من الأوردة التي تخدم الجزء الإسفنجي من عظام القحف)",
 "ばんがい": "اِسْتِثْنَاء / اِسْتِثْنَاء, خَطَأ / إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي / أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه) / حجم ضخم, مقاس استثنائي (مقاس ملابس غير عادي (خاصة المقاس الكبير جداً))",
 "ばんがん": "تَجْمِيعِيّ, مُتَكَتِّل (مؤلف من عناصر متباينة مجتمعة في كتلة واحدة) / تكتل شركات, مجموعة شركات (مجموعة من الشركات المتنوعة تحت ملكية مشتركة وتدار كمنظمة واحدة) / تكتلات صخرية, كونغلوميريت (صخر مركب يتكون من جزيئات متفاوتة الحجم)",
 "ばんき": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ばんきん": "صاج, صفيحة معدنية (ورقة من المعدن مشكلة في لوحة رقيقة) / حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "ばんきんこう": "صاج, صفيحة معدنية (ورقة من المعدن مشكلة في لوحة رقيقة)",
 "ばんきんや": "صاج, صفيحة معدنية (ورقة من المعدن مشكلة في لوحة رقيقة)",
 "ばんきんよろい": "تصفيح, درع صفيحي (صفيحة فولاذية مقواة خصيصاً تستخدم لحماية التحصينات أو المركبات من نيران العدو) / درع صفائحي, درع صفيحي (نوع تاريخي من الدروع الشخصية المصنوعة من صفائح الحديد أو الصلب، حلت محل الزرد خلال القرن الرابع عشر)\nمثال: أدت القوة المتزايدة للأسلحة النارية وتوفرها إلى التخلي عن أجزاء من الدرع الصفائحي لصالح قوات أرخص وأكثر قدرة على الحركة",
 "ばんぎく": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "ばんくるわせ": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "ばんぐせつ": "يَوْم كَذْبَة أَبْرِيل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ばんぐみ": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "ばんぐみへんせい": "بَرْمَجَة (فِي : هي عملية كتابة تعليمات وتوجيه أوامر لجهاز الحَاسُوبِ أو أي جهاز آخر مثل قارئات أقراص الدي في دي أو أجهزة استقبال الصوت والصورة في نظم الاتصالات…؛ اسم لفظي للفعل بَرْمَجَ)\nمثال: تسمح لغة البرمجة بكتابة البرامج الحاسوبية.",
 "ばんぐん": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "ばんけん": "كلب حراسة (كلب مدرب لحراسة الممتلكات) / جِهَة رَقابِيَّة, حارِس (وصي أو مدافع ضد السرقة أو الممارسات غير القانونية أو الهدر)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "ばんげい": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "ばんこ": "خُلْد (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "ばんこう": "بربرية",
 "ばんこく": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / سَخِيّ, غَزِير (يُوفِّر إمدادًا وافرًا وغزيرًا) / ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة) / بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "ばんこくおんぴょうもじ": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "ばんこくきょうつう": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ",
 "ばんこくこうほう": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ばんこくこくさいおんぴょうもじ": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "ばんこくひょうじゅんじ": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "ばんこつ": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "ばんご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ばんごう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんごうきごう": "جنيه, علامة الجنيه (رمز لوحدة العملة (خاصة للجنيه الإسترليني في بريطانيا العظمى))",
 "ばんごはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ばんさい": "شَيْخُوخَة, عُجُوز",
 "ばんさいるい": "أسماك غضروفية, صفيحية الخياشيم (أي من الأسماك العديدة من طائفة الأسماك الغضروفية التي تتميز بهيكل غضروفي وحراشف درعية: أسماك القرش، الشفنينيات، الزلاجات)",
 "ばんさん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟ / وضع, ولادة (عملية الولادة)",
 "ばんさんかい": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "ばんざい": "بانزاي (هتاف ياباني للحماس أو النصر) / ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة) / حياة أبدية, خلود (حياة بلا بداية أو نهاية)\nمثال: 女王万歳。 — تحيا الملكة!",
 "ばんしゃ": "شُكْرًا, شُكْرًا جَزِيلًا",
 "ばんしゅ": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "ばんしゅう": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "ばんしょ": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين) / حَاجِز, نُقْطَة تَفْتِيش / بَطَاطَا حُلْوَة",
 "ばんしょう": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس. / مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / نَبَات فُلْفُل (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / فُلَيْفِلَة\nمثال: هذا النبات مهدد بالانقراض.",
 "ばんしょく": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / تَعَشَّى (تَنَاوَلَ العَشَاء)\nمثال: هل العشاء جاهز؟",
 "ばんじ": "كُلّ, جَمِيع",
 "ばんじきゅうす": "هُنَاكَ, يُوجَدُ",
 "ばんじばんたん": "كُلّ شَيْء",
 "ばんじまして": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "ばんじゃく": "ثَبَات",
 "ばんじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "ばんじゅう": "حيوان جر (حيوان يستخدم لسحب الأحمال الثقيلة)",
 "ばんじょう": "مُبَارَك, مَبْرُوك / سِيَادَة, حَاكِمِيَّة (السِّيَادةُ : الشرفُ؛سادَ يَسُودُ سِيَادَةً، والاسمُ السُّؤدُد، وَهُوَ المَجْدُ و الشَّرفُ؛ ساد يسود سيادةً وسُودَداً وسؤْدُداً :عظُم ومجُد وشرُف)\nمثال: أوكرانيا دولة ذات سيادة. / تَنْوِيع",
 "ばんじん": "اَلْجَمِيع, كُلّ شَخْص / مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "ばんじんのたに": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "ばんせい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんせいせい": "عاجِز عِنْد الفَقْس ((للفراخ) عارية وعمياء ومعتمدة على الوالدين في الغذاء)",
 "ばんせいせつ": "عِيدُ جَمِيعِ اَلْقِدِّيسِين",
 "ばんせいふえき": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんせん": "مقياس الأسلاك (مقياس لقياس قطر السلك) / إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة",
 "ばんぜん": "كَمَال, إتقان",
 "ばんそう": "مُصَاحَبَة / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "ばんそうこう": "ضمادة لاصقة (ضمادة تتكون من قطعة شاش ماص مثبتة بشريط بلاستيكي أو قماشي مطلي بمادة لاصقة)",
 "ばんそうしゃ": "مصاحب موسيقي (شخص يقدم مصاحبة موسيقية (عادة على البيانو))",
 "ばんそうぶ": "مُصَاحَبَة",
 "ばんそつ": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "ばんた": "حَارِس",
 "ばんたろう": "حَارِس",
 "ばんたん": "كُلّ, جَمِيع",
 "ばんだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんだいそう": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "ばんだいふえき": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんち": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "ばんづけ": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "ばんて": "عَدَّ / كُونْت",
 "ばんてき": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "ばんとう": "صلاة الغروب, صلاة المساء (السادسة من الساعات القانونية السبع للمكتب الإلهي؛ في وقت مبكر من المساء)",
 "ばんど": "أكسيد الألمنيوم, ألومينا (أي من أشكال أكسيد الألمنيوم المختلفة التي توجد بشكل طبيعي مثل الكورندوم)",
 "ばんどういるか": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "ばんどうさんじゅうさんしょ": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "ばんどころ": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "ばんなんをはいして": "بِأَيِّ ثَمَنٍ",
 "ばんにん": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي. / اَلْجَمِيع, كُلّ شَخْص",
 "ばんにんむき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんのう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة) / قَدِير, كُلِّيّ القُدْرَة (يمتلك قدرة غير محدودة)",
 "ばんのうきょうけつしゃ": "متبرع عام",
 "ばんのうほうちょう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんのうやく": "ترياق عام, دواء لكل داء (علاج افتراضي لجميع العلل أو الأمراض؛ كان يسعى إليه الخيميائيون)",
 "ばんのうよごれおとし": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんのうナイフ": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんば": "حصان الجر (حصان متكيف لجر الأحمال الثقيلة)",
 "ばんばん": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / أَبَدًا",
 "ばんぴぎょるい": "لوحيات الأدمة (فقاري يشبه السمكة بصفائح عظمية على الرأس والجزء العلوي من الجسم؛ ساد في البحار والأنهار خلال العصر الديفوني؛ يعتبر أقدم الفقاريات ذات الفكوك)",
 "ばんぴるい": "لوحيات الأدمة (فقاري يشبه السمكة بصفائح عظمية على الرأس والجزء العلوي من الجسم؛ ساد في البحار والأنهار خلال العصر الديفوني؛ يعتبر أقدم الفقاريات ذات الفكوك)",
 "ばんぶつのれいちょう": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "ばんぺい": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "ばんめし": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ばんめん": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ",
 "ばんや": "كشك الحراسة (مأوى صغير مفتوح من الأمام لحماية الحارس من الطقس)",
 "ばんやむをえず": "هُنَاكَ, يُوجَدُ",
 "ばんゆう": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "ばんゆういんりょくていすう": "ثَابِت الْجَاذِبِيَّة, ثَابِت الْجَذْب الْعَامّ ((في الفيزياء) الثابت العام الذي يربط القوة بالكتلة والمسافة في قانون نيوتن للجاذبية)",
 "ばんゆうざいしんろん": "الكل في الله, وحدة الشهود (الاعتقاد بأن الله موجود في جزء من الكون وظواهره ويتجاوز الكون أيضاً ويتدخل في عملياته)",
 "ばんゆうしんきょう": "وَحْدَة اَلْوُجُود",
 "ばんゆうないざいしんろん": "الكل في الله, وحدة الشهود (الاعتقاد بأن الله موجود في جزء من الكون وظواهره ويتجاوز الكون أيضاً ويتدخل في عملياته)",
 "ばんり": "عَشَرَة آلَاف",
 "ばんりのちょうじょう": "سُور اَلصِّين اَلْعَظِيم",
 "ばんりゅうるい": "بيليكوصور (زاحف بدائي كبير له شراع شوكي طويل؛ من العصر البرمي أو أواخر العصر القديم في أوروبا وأمريكا الشمالية)",
 "ばんりょ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ばんれいさい": "2 نوفمبر, عيد جميع الموتى (يوم للتضرع من أجل جميع الأرواح في المطهر)",
 "ばんれいし": "تفاح السكر, قشطة سكرية (فاكهة استوائية لبية حلوة ذات قشرة حرشفية سميكة وبذور سوداء لامعة) / سكر التفاح, قشطة حرشفية (شجرة استوائية أمريكية تحمل فاكهة لبية حلوة بقشرة حرشفية سميكة وبذور سوداء لامعة)",
 "ばんれいせつ": "2 نوفمبر, عيد جميع الموتى (يوم للتضرع من أجل جميع الأرواح في المطهر)",
 "ばんカラ": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "ばん馬": "حصان الجر (حصان متكيف لجر الأحمال الثقيلة)",
 "ばーさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "ばーちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "ばーば": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "ぱ": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات",
 "ぱあ": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء. / حَمَاقَة (خطأ سخيف)",
 "ぱあっと": "بحماس / بإطراء شديد, بحماس بالغ (بطريقة مسرفة أو متحمسة)\nمثال: ناقشوا السؤال بحماس",
 "ぱあん": "فَرْقَعَة",
 "ぱい": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه)",
 "ぱいおつ": "ثَدْي",
 "ぱいせん": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "ぱいぱい": "أطيش (أطيش استوائي صغير ذو منقار ساطع أو أقدام ساطعة أو كليهما) / أحمق, جاهل (شخص جاهل أو أحمق) / حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "ぱかぱか": "حَبَطَقْطَقْ",
 "ぱからっぱからっ": "حَبَطَقْطَقْ",
 "ぱかん": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / جَاحِظ العَيْنَيْن, فَاغِر الفَم (مفتوح العينين أو الفم من شدة الدهشة)",
 "ぱくっ": "بعيداً, على نطاق واسع (إلى أو على مدى أو نطاق كبير؛ بعيداً) / بتباعد (بحيث تترك مساحة كبيرة أو مسافة بين الأشياء)\nمثال: تجول بعيداً عبر العديد من الأراضي",
 "ぱくぱく": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "ぱくり": "فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول) / اِنْتِحال",
 "ぱくりや": "محتال, مخادع (محتال ذكر يستغل ثقة ضحيته)",
 "ぱくる": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ぱくんちょ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぱぐれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "ぱこる": "فَرْقَعَة",
 "ぱさぱさ": "مُجَفَّف كُلِّيًّا (جُفِّف بالكامل ونُزعت منه كلّ الرطوبة)",
 "ぱしっ": "قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ぱしゃん": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ぱしり": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "ぱす": "إِنْذَار",
 "ぱたっと": "فَجْأَةً",
 "ぱたぱた": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / خفقاً, دقا (وصف لضربات إيقاعية (مثل القلب)) / بخطوات خفيفة, طقطقة (كما في صوت الخطوات الخفيفة) / طقطقة, نقر سريع (سلسلة من أصوات النقر السريعة)\nمثال: قلبه كان يخفق / بِسُرْعَة, عَاجِلًا",
 "ぱたり": "فَجْأَةً",
 "ぱたん": "فَجْأَةً",
 "ぱちくり": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "ぱちこく": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "ぱちっ": "جَاحِظ, وَاسِع العَيْنَيْن ((يوصف به العينان) مفتوحتان بالكامل أو متّسعتان) / سَاذَج, طِفْلِيُّ البَرَاءَة (يُظهر بساطة طفوليّة وسذاجة في التصديق)",
 "ぱちぱち": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية) / تصفيق (إظهار الموافقة عن طريق ضرب اليدين ببعضهما البعض) / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "ぱちもの": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "ぱちもん": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "ぱちる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぱちんこ": "باتشينكو (لعبة بينبول يابانية تُلعب على لوحة عمودية) / مِقْلَاع / مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "ぱち物": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "ぱっくり": "فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول)",
 "ぱっくんちょ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぱったり": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ぱっち": "مُحْكَم, مُلائِم (ضَيِّق وَمُلائِم لِلجِسْم بِشَكْل مُريح)",
 "ぱっつんぱっつん": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "ぱっと": "فَجْأَةً / بشكل بارز, بوضوح (بطريقة بارزة) / بشكل لافت, بوضوح تام (بطريقة تميل إلى جذب الانتباه)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر",
 "ぱっとしない": "عادي, غير مثير للإعجاب (غير قادر على إثارة الإعجاب)",
 "ぱっとみ": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "ぱっと見": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "ぱっぱと": "بِسُرْعَة, عَاجِلًا",
 "ぱつぱつ": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "ぱつんぱつん": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "ぱなし": "ذهاب, رحيل (فعل المغادرة) / باستمرار",
 "ぱねぇ": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "ぱねえ": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "ぱぱっと": "بِسُرْعَة, عَاجِلًا",
 "ぱぱぱっと": "بِسُرْعَة, عَاجِلًا",
 "ぱやぱや": "مُزَغَّب, وَبِرِيّ (مكسو بشعيرات خفيفة ودقيقة) / ضَبَابِيّ, غَامِض (مشوّش وغير متماسك؛ غير مُحكم التفكير) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "ぱらっと": "بِسُرْعَة, عَاجِلًا / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف / بشكل متناثر, بكثافة قليلة (بطريقة متفرقة وغير كثيفة)\nمثال: مأهولة بشكل متناثر",
 "ぱらつく": "رش, نثر (فعل رش أو طرطشة الماء) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة)",
 "ぱらぱら": "رش, نثر (فعل رش أو طرطشة الماء) / رش الماء (فعل رش الماء في المعمودية (نادر)) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / رشات, قلة متناثرة (عدد صغير (من شيء ما) مبعثر بشكل عشوائي)\nمثال: أولى علامات الاخضرار المتناثرة / خلط تفريقي, خلط سريع (خلط الأوراق بقسم الرزمة وتداخل النصفين عند الزوايا) / تموج صغير, مويجة (موجة صغيرة على سطح سائل) / ضَئِيل / رِخْو, مُتَفَتِّت (يَسْهُلُ تَفَتُّتُهُ إِلَى قِطَعٍ صَغِيرَةٍ أَوْ تَحَوُّلُهُ إِلَى مَسْحُوق)",
 "ぱらみつ": "جاكية",
 "ぱらり": "رش, نثر (فعل رش أو طرطشة الماء) / رش الماء (فعل رش الماء في المعمودية (نادر)) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / رشات, قلة متناثرة (عدد صغير (من شيء ما) مبعثر بشكل عشوائي)\nمثال: أولى علامات الاخضرار المتناثرة",
 "ぱりっと": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية / بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح",
 "ぱりぱり": "مُقَرْمَش, مُقَرْمَشَة / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / إدماع, تدميع (ذرف الدموع) / مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا) / جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر)",
 "ぱんぱん": "فَرْقَعَة / محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "ぱんピー": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ぱネェ": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "ぱー": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء. / حَمَاقَة (خطأ سخيف)",
 "ぱーっと": "بحماس / بإطراء شديد, بحماس بالغ (بطريقة مسرفة أو متحمسة)\nمثال: ناقشوا السؤال بحماس",
 "ぱーん": "فَرْقَعَة",
 "ひ": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار. / يَوْم, نَهَار (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل. / شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.\nمثال: この部屋はあまり日が当たらない。 — لا تشع الشمس على هذه الغرفة كثيراً. / تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / نِسْبَة (مصدر للفعل \"نَسَبَ\"؛ (في النحو) صفة أُضيفت إليها يَاءُ النَّسَبِ، غرضها نسب المنسوب إلى المنسوب إليه)\nمثال: بالنسبة لي، إنه مهم. / مُبَارَاة / شَحّاطَة, شَخَّاطَة / الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا. / سَاوَى, كَلَّفَ / تَكْلِفَة, كُلْفَة / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / فِنْطَاس / كوليس, مجرى انزلاق (عضو خشبي محفور (مخدد) لاستيعاب لوح منزلق) / كواليس (لوح مسطح يقع في أجنحة المسرح) / جَلِيد, ثَلْج / بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد. / رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / لَوْحَة تِذْكَارِيَّة / غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / فلاي بول, كرة طائرة ((بيسبول) ضربة تطير عالياً في الهواء) / أَمِيرَة / مَكُّوك / مَكُوك / خادمة (عاملة منزلية) / طِحَال / قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "ひあい": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن.",
 "ひあかり": "ضوء المصباح (الضوء الصادر من مصباح) / ضوء النار (ضوء النار (خاصة في الموقد))",
 "ひあし": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "ひあそび": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "ひあたりのいい": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "ひあたりのよい": "مُشْمِس / شَامِس (اسم فاعل من الفعل \"شَمَسَ\"؛ ذو شمس)",
 "ひあっしゅく": "غير قابل للانضغاط (غير قابل للضغط؛ يقاوم الانضغاط)\nمثال: أكوام من القمامة غير القابلة للانضغاط",
 "ひあぶり": "حرق, حرق على الخازوق (الإعدام بالنار)",
 "ひい": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / لَا قَانُونِيَّة, مُخَالَفَة القَانُون (عدم المشروعية بحكم انتهاك قانون تشريعي ما) / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "ひいき": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه / مُفَضَّل / راعي; حامي; وصي; سيد; و / حريف; زبون",
 "ひいきにする": "مَعْرُوف / أَنْعَمَ",
 "ひいく": "فِي طَوْرِ التَّسْمِين (خَاضِعٌ لِعَمَلِيَّةِ التَّسْمِينِ اسْتِعْدَادًا لِلذَّبْحِ)",
 "ひいこら": "إجهاد, توتر (مجهود مكثف أو عنيف) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل)",
 "ひいずるくに": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "ひいちにちと": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ひいづるくに": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "ひいて": "بدوره",
 "ひいては": "بدوره",
 "ひいでる": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ひいらぎ": "بَهَشِيَّة, إِيلِكْس",
 "ひいる": "عُثَّة",
 "ひいれ": "تَدْفِئَة / بزوغ الفجر, شروق (ضوء النهار الأول)\nمثال: استيقظنا قبل الفجر / بسترة (تعقيم جزئي للأطعمة عند درجة حرارة تدمر الكائنات الحية الدقيقة الضارة دون تغييرات كبيرة في كيمياء الغذاء)",
 "ひいろ": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "ひいん": "حِمَايَة",
 "ひうお": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / أسماك صغيرة, وايت بيت (أسماك المنوة أو غيرها من الأسماك الصغيرة في المياه العذبة أو المالحة (خاصة الرنجة)؛ تطهى عادة كاملة) / سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "ひうちいし": "صَوَّان, ظُرَر / صَوَّانَة, ظِرّ",
 "ひうちがね": "ضارب, مطرقة (الجزء من جهاز ميكانيكي الذي يضرب شيئاً ما) / ضارب (شخص يضرب) / مُضرِب (موظف مضرب عن العمل ضد صاحب العمل) / متدرب بحري (شخص يتلقى تدريباً مكثفاً للحصول على تصنيف فني بحري)\nمثال: ضارب قوي",
 "ひうら": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "ひうん": "مُصِيبَة, شَقْوَة",
 "ひえ": "برود, جفاء (نقص في المودة أو الحماس) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل)\nمثال: برود مؤلم في النبرة والأسلوب / دخن ياباني (عشب حولي خشن يزرع في اليابان وجنوب شرق آسيا لبذوره الصالحة للأكل وللعلف؛ غذاء مهم للحياة البرية في الولايات المتحدة)",
 "ひえいせい": "غير صحي, ملوث (ليس صحيًا أو نظيفًا)\nمثال: مجاري مفتوحة غير صحية",
 "ひえいり": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "ひえいりそしき": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "ひえいりだんたい": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "ひえいりてき": "غَيْرُ رِبْحِيّ, غَيْرُ هَادِفٍ لِلرِّبْحِ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひえき": "فَائِدَة, جَدْوَى",
 "ひえこみ": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة / تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب)",
 "ひえこむ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひえつ": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "ひえばら": "إِسْهَال",
 "ひえびえ": "ببرود (بافتقار لدفء المشاعر؛ بطريقة باردة غير عاطفية)\nمثال: خاطبها ببرود",
 "ひえん": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "ひえんざんし": "الكمية المحسوبة, مُعامَل (كمية يتم إجراء عملية رياضية عليها)",
 "ひえんそう": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "ひお": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / أسماك صغيرة, وايت بيت (أسماك المنوة أو غيرها من الأسماك الصغيرة في المياه العذبة أو المالحة (خاصة الرنجة)؛ تطهى عادة كاملة)",
 "ひおい": "مَظَلَّة",
 "ひおう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひおうぎ": "زنبق التوت, زنبق النمر (نبات حديقة تكشف كبسولته عند النضج عن كتلة من البذور تشبه التوت الأسود) / زنبق الصنوبر, زنبق النمر (زنبق من جنوب شرق الولايات المتحدة له زهور كأسية الشكل ببتلات منحنية صفراء عميقة إلى قرمزية) / زنبق النمر (زنبق من غرب الولايات المتحدة له زهور برتقالية حمراء إلى قرمزية منقطة بالمارون)",
 "ひおおい": "مَظَلَّة",
 "ひおしこうどう": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ひか": "تحت الجلد (متعلق بالمنطقة الواقعة تحت البشرة أو يقع فيها)\nمثال: إبرة تحت الجلد / رِثَاء, مَرْثِيَة / تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري) / بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا) / تَمَاثُل, زَوْجِيَّة ((الرياضيات) علاقة بين زوج من الأعداد الصحيحة: إذا كان كلاهما فردياً أو كلاهما زوجياً فلهما نفس الزوجية)",
 "ひかいじごうい": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "ひかえ": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / مُسْتَنْسَخ, مُكَرَّر (منسوخ بشكل مطابق عن الأصل) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً) / بديل احتياطي, نسخة إضافية (شيء إضافي من نفس النوع)\nمثال: صنع نسخة للملفات",
 "ひかえかべ": "دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "ひかえがき": "مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "ひかえしつ": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ひかえじょ": "صالة, غرفة انتظار (غرفة (كما في فندق أو مطار) بها مقاعد حيث يمكن للناس الانتظار)",
 "ひかえせんしゅ": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ひかえちょう": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "ひかえのま": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "ひかえめ": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ひかえめにいう": "قَلَّلَ",
 "ひかえる": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "ひかかんしょうてき": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "ひかがくてき": "غير علمي (لا يتسق مع أساليب أو مبادئ العلم)\nمثال: افتقار غير علمي للموضوعية",
 "ひかき": "سِطَام, مِسْعَار / بُوكَر, بُوكِر",
 "ひかきぼう": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "ひかく": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة / جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد. / بطامة (الجزء الخارجي المحمر من النواة العدسية)",
 "ひかくえんざんし": "عَلَاقَة",
 "ひかくかいぼうがく": "تشريح مقارن (دراسة السمات التشريحية للحيوانات من أنواع مختلفة)",
 "ひかくかのう": "قابل للمقارنة, مماثل (يمكن مقارنته أو يستحق المقارنة) / مُطَابِق, مُمَاثِل (مُتَوافِق من كلّ وجه)",
 "ひかくきゅう": "دَرَجَة نِسْبِيَّة",
 "ひかくこうどうがく": "علم سلوك الحيوان (فرع علم الحيوان الذي يدرس سلوك الحيوانات في بيئاتها الطبيعية)",
 "ひかくてき": "نِسْبِيّاً",
 "ひかくにならない": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن مقارنتها)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "ひかくぶそう": "سِلَاح نَوَوِيّ",
 "ひかくぶんか": "عبر الثقافات (يتعامل مع ثقافتين أو أكثر أو يقارن بينهما)\nمثال: مسح عبر الثقافات",
 "ひかくぶんがく": "أدب مقارن (دراسة الأعمال الأدبية من ثقافات مختلفة (غالباً مترجمة))",
 "ひかげ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "ひかげのかずら": "صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج الصنوبر؛ أوروبا والجزر البريطانية وشمال إفريقيا) / صنوبر أرضي (أي من عدة طحالب نادي ذات سيقان زاحفة طويلة وفروع منتصبة)",
 "ひかすいそ": "أرسين, زرنيخيد الهيدروجين (غاز سام عديم اللون وقابل للاشتعال يستخدم في التركيب العضوي ولتطعيم الترانزستورات وكغاز سام في الحروب)",
 "ひかすう": "مُضَاف إِلَيْهِ (عدد يضاف إليه عدد آخر)",
 "ひかぜい": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "ひかぜいひん": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "ひかそしき": "تحت الأدمة (طبقة من الخلايا تفرز الجليد الكيتيني في المفصليات مثلاً)",
 "ひかっせい": "خَامِد",
 "ひかつどう": "خَامِد",
 "ひかぶつ": "زرنيخيد (مركب من الزرنيخ مع عنصر أكثر إيجابية)",
 "ひかぶん": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "ひからかさ": "مَظَلَّة, شَمْسِيَّة",
 "ひからす": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひからびる": "صَعَقَ",
 "ひかり": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة) / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / إِضَاءَة / سَعَادَة, فَرَح / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ひかりかがやく": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひかりかびんせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "ひかりかんじゅせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "ひかりきのこばえ": "يَرَاع, حَبَاحِب",
 "ひかりじき": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "ひかりでんどう": "موصلية ضوئية (تغير في الموصلية الكهربائية لمادة نتيجة لامتصاص الإشعاع الكهرومغناطيسي)",
 "ひかりとかげ": "بصيص أمل, جانب مضيء (جانب مواسٍ لموقف صعب)\nمثال: كل سحابة لها جانب مضيء",
 "ひかりのはやさ": "سرعَة الضوء",
 "ひかりのまち": "بلاد العجائب",
 "ひかりばしら": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "ひかりふだ": "لَامِع, نَيِّر / مُسْتَنِير",
 "ひかりもの": "لَامِع, نَيِّر / مُسْتَنِير",
 "ひかりもも": "دُرَّاق",
 "ひかりりょうほう": "علاج ضوئي (استخدام الضوء القوي لعلاج حب الشباب أو فرط بيليروبين الدم لدى حديثي الولادة)",
 "ひかりをあてる": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "ひかりケーブル": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "ひかりディスク": "قرص ضوئي (قرص مطلي بالبلاستيك يمكنه تخزين البيانات الرقمية كحفر صغيرة محفورة في السطح؛ يقرأ بواسطة ليزر يمسح السطح)",
 "ひかりファイバ": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "ひかりファイバー": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "ひかりファイバーケーブル": "ليفي بصري (مكون من أو متعلق بالألياف البصرية)",
 "ひかる": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひかるぼう": "عصا مضيئة (أنبوب بلاستيكي صغير يحتوي على مواد كيميائية تنتج ضوءاً عند كسرها)",
 "ひかん": "تَشَاؤُم / شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات الحَرَارَة)\nمثال: ولد في فصل الشتاء. / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي)) / قِنّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "ひかんざくら": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز) / فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "ひかんしゅぎ": "تَشَاؤُم",
 "ひかんしゅぎしゃ": "مُتَشَائِم",
 "ひかんしょうてき": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "ひかんてき": "مُتَشَائِم",
 "ひかんびゃくしょう": "قِنّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "ひかんろん": "تَشَاؤُم",
 "ひかんろんしゃ": "مُتَشَائِم",
 "ひが": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "ひがあ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "ひがい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "ひがいしゃ": "ضَحِيَّة / أُضْحِيَّة",
 "ひがいしゃさんかせいど": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ひがいもうそう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "ひがえりおんせん": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ひがくれる": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "ひがごと": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "ひがさ": "مَظَلَّة, شَمْسِيَّة / حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "ひがさす": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひがし": "شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق.",
 "ひがしかぜ": "رياح شرقية (رياح تهب من الشرق)",
 "ひがしかた": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "ひがしがた": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "ひがしがわ": "الجانب الشرقي (الجانب الذي يقع في الشرق)",
 "ひがしがわしょこく": "اَلْكُتْلَة الشَّرْقِيَّة",
 "ひがしきた": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي)",
 "ひがしはんきゅう": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "ひがしみなみ": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي)",
 "ひがしより": "شَرْقِيًّا, مِن الشَّرْق (من الشرق) / شَرْقِيّ (قادم من الشرق؛ يُستخدم خاصة عن الرياح) / شَرْقِيّ, وَاقِعٌ فِي الشَّرْق (يقع في الشرق أو باتّجاهه) / رياح شرقية (رياح تهب من الشرق)\nمثال: هبت الرياح شرقياً طوال الليل",
 "ひがしアジア": "شَرْق آسِيَا (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "ひがしアジアかんこうきょうかい": "شَرْق آسِيَا (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "ひがしアメリカおうぎはくじら": "تَيَّار الْخَلِيج",
 "ひがしインドがいしゃ": "شركة الهند الشرقية (شركة إنجليزية تشكلت عام 1600 لتطوير التجارة مع المستعمرات البريطانية الجديدة في الهند وجنوب شرق آسيا؛ تولت السيطرة الإدارية على البنغال في القرن…)",
 "ひがしゴート": "قوطي شرقي (فرد من المجموعة الشرقية للقوط الذين أسسوا مملكة في شمال إيطاليا حوالي 500 م)",
 "ひがしシナかい": "بَحْر الصِّين الشَّرْقِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "ひがしティモール": "تِيمُور الشَّرْقِيَّة",
 "ひがしドイツ": "أَلْمَانِيَا الشَّرْقِيَّة (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "ひがしヨーロッパ": "أُورُوبَّا الشَّرْقِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "ひがた": "أرض المد (أرض بالقرب من البحر يغمرها المد)",
 "ひがついたよう": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه)",
 "ひがつく": "اِشْتَعَلَ / اِنْدَلَعَ",
 "ひがないちにち": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "ひがみ": "إِجْحَاف, تَحَامُل",
 "ひがみこんじょう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "ひがみごころ": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "ひがみっぽい": "سَاخِر",
 "ひがみ心": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "ひがみ根性": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "ひがめ": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما) / تَحَيُّز",
 "ひがら": "قرقف فحمي",
 "ひがらかさ": "مَظَلَّة, شَمْسِيَّة",
 "ひがわ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "ひがわりていしょく": "طَبَق اليَوْم (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "ひがん": "اَلنِّرْفَانَا",
 "ひがんざくら": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "ひがんばな": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "ひが目": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما) / تَحَيُّز",
 "ひき": "عُلْجُوم, ضِفْدَع طِين / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / جذب, نتر (سحب مفاجئ وخاطف) / سفينة قطر, قاطرة (قارب صغير قوي مصمم لسحب أو دفع السفن الأكبر) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / لَاعِب / مَشْغَل, جِهَاز / مَشْغَل / مُقَامِر / تَشْهِير, بُهْتَان / تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما)",
 "ひきあい": "مَرْجِع / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "ひきあいにだす": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "ひきあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "ひきあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "ひきあげ": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / إنقاذ الممتلكات (فعل إنقاذ البضائع أو الممتلكات التي كانت معرضة لخطر التلف أو الدمار) / بضائع مستنقذة (ممتلكات أو بضائع تم إنقاذها من التلف أو الدمار) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / إعادة إلى الوطن (فعل العودة أو الإعادة إلى البلد الأصلي)",
 "ひきあげしゃ": "عائد إلى الوطن (شخص عاد إلى بلده الأصلي أو استعاد جنسيته)",
 "ひきあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "ひきあて": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "ひきあてきん": "قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي)",
 "ひきあてる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "ひきあみ": "شبكة",
 "ひきあわせ": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "ひきあわせる": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي. / قَارَنَ / شَبَّهَ",
 "ひきいる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "ひきうけ": "مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / تجهيز الموتى, مهنة الحانوتي (مهنة مدير الجنازات)\nمثال: استعد لمشاريع عظيمة",
 "ひきうけにん": "كَافِل",
 "ひきうける": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / وَرَثَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "ひきうす": "رحى (طاحونة حجرية بدائية لطحن الذرة باليد)",
 "ひきうつし": "نسخ (فعل النسخ)",
 "ひきうつす": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "ひきうつる": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "ひきおこす": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "ひきおとし": "قيد مدين (قيد محاسبي يعترف بالمبالغ المستحقة الدفع)",
 "ひきおとす": "قيد مدين (قيد محاسبي يعترف بالمبالغ المستحقة الدفع)",
 "ひきかえ": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "ひきかえけん": "قَسِيمَة / كُوبُون, قَسِيمَة شِرائِيَّة",
 "ひきかえしょう": "إِيصَال",
 "ひきかえす": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "ひきかえて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ひきかえる": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "ひきがえる": "عُلْجُوم, ضِفْدَع طِين",
 "ひきがね": "زِنَاد",
 "ひききる": "قَاطَعَ",
 "ひきくらべる": "قَارَنَ / شَبَّهَ",
 "ひきげき": "تراجيكوميديا, كوميديا جادة (كوميديا ذات عناصر أو نغمات جادة) / تراجيكوميديا, مأساة ملهاة (مؤلف درامي يتضمن عناصر من كل من المأساة والملهاة وعادة ما تسود المأساة)",
 "ひきこす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "ひきこみしき": "قَابِلٌ لِلسَّحْب (يمكن سحبه وإرجاعه إلى الداخل)",
 "ひきこみせん": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / كساء خارجي (مادة تطبق على السطح الخارجي للمبنى لجعله مقاومًا للعوامل الجوية)",
 "ひきこもごも": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "ひきこもり": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ) / مَيَّالٌ لِلِانْطِوَاء (يميل إلى الانطواء بعض الشيء) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)",
 "ひきさがる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "ひきさげ": "نَقْص",
 "ひきさげる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "ひきさる": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "ひきざん": "طَرْح (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "ひきしぼる": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي / سُلَالَة",
 "ひきしまった": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "ひきしめ": "تَضْيِيق",
 "ひきしめる": "شَدَّ, ضَيَّقَ",
 "ひきすう": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "ひきずりおろす": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "ひきずる": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / أَطَالَ / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ひきたつ": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "ひきたて": "مَعْرُوف / أَنْعَمَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "ひきたてやく": "فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "ひきたてる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "ひきだい": "حامل النشر (هيكل لحمل الخشب الذي يتم نشره)",
 "ひきだし": "جَارُور, دُرْج / رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ)\nمثال: إنه رسام مشهور. / اِنْسِحَاب",
 "ひきだす": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / يَسْتَحْضِر, يَسْتَدْعِي / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / مُقْتَطَف / خلاصة",
 "ひきつぎ": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "ひきつぐ": "وَرَثَ / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "ひきつける": "اِجْتَذَبَ, جَذَبَ / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "ひきつづき": "باستمرار / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "ひきつづく": "تَابَعَ, اِسْتَمَرَّ",
 "ひきつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "ひきつる": "زِيَار / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ) / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "ひきづな": "حبل الشد ((مصطلح بحري) حبل يستخدم لتمديد أو تثبيت التجهيزات على السفن) / حبل تعليق, قيطان (حبل يُرتدى حول الرقبة لحمل سكين أو صافرة) / حبل الإطلاق (حبل مزود بخطاف مرفق يستخدم لإطلاق أنواع معينة من المدافع)",
 "ひきづり": "صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "ひきて": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / عقدة, مقبض (نتوء أو بروز دائري مستدير) / مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / تغلظ, عقدة (أي تضخم سميك)",
 "ひきで": "يَمِين, يُمْنَى",
 "ひきでもの": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "ひきとめる": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひきとり": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة / ذهاب, رحيل (فعل المغادرة)",
 "ひきとりて": "مُدَّعٍ, مُدَّعِيَة",
 "ひきとりにん": "مُحَافِظ",
 "ひきとる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / تَبَنَّى / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ひきど": "باب منزلق (باب يفتح عن طريق الانزلاق بدلاً من التأرجح)",
 "ひきなみ": "أثر السفينة, موجة المؤخرة (الموجة التي تنتشر خلف القارب أثناء تحركه للأمام) / توابع, عقابيل (عواقب حدث (خاصة حدث كارثي)) / تيار انزلاقي, تيار هوائي خلفي (تدفق الهواء الذي تدفعه مروحة الطائرة إلى الخلف)\nمثال: قلب أثر الزورق القارب الصغير / عائِق",
 "ひきならす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "ひきにげ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "ひきぬき": "تَعْبِئَة / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "ひきぬきあみめ": "غرزة لقط, غرزة مخفية (غرزة فضفاضة تلتقط خيطاً أو خيطين فقط من القماش؛ مصممة لتكون غير مرئية من الجانب الصحيح)",
 "ひきぬく": "مُقْتَطَف / خلاصة",
 "ひきのばし": "تَمْدِيد / تَوْسِيع",
 "ひきのばしき": "مكبر الصور (معدات تصوير فوتوغرافي تتكون من جهاز عرض بصري يستخدم لتكبير صورة فوتوغرافية)",
 "ひきのばす": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "ひきはなす": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "ひきはらう": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ひきひも": "خيط زم, رباط سحب (رباط يتكون من حبل يمر عبر درزة حول فتحة)\nمثال: سحب خيط الزم وأغلق الحقيبة / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "ひきふね": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "ひきまど": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "ひきまわし": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "ひきまわす": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "ひきむすぶ": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / جِزْدَان, جُزْدَان",
 "ひきもきらず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "ひきもきらない": "مُسْتَمِرّ, مُتَوَاصِل",
 "ひきもどす": "اِسْتَعَادَ",
 "ひきもの": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس) / مِقْبَض / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "ひきゃく": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "ひきやぶる": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "ひきゅう": "إِيثَارِيّ, مُضَحٍّ بِنَفْسِه (مستعدّ لحرمان نفسه من أجل الآخرين) / ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "ひきゅうめん": "لَاكُرَوِيّ (يختلف قليلاً عن الشكل الكروي التامّ)",
 "ひきょう": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان. / ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة / مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة / بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار. / مُشَوِّق, ممتع / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "ひきょういくしゃ": "طَالِب, طَالِبَة",
 "ひきょうえき": "خَارِجٌ عَنِ المَعْهُود, غَيْرُ مَأْلُوف (استثنائيّ أو غير عاديّ أو جدير بالملاحظة) / تَمَّ التَّعَامُلُ مَعَهُ, مَفْرُوغ مِنْهُ (تَمَّ التَّعَامُلُ مَعَهُ وَالِانْتِهَاءُ مِنْهُ) / شَاذّ, مُسِيء (غير لائق أو حتى مُسيء)",
 "ひきょうごうてき": "غير تنافسي (لا ينطوي على منافسة أو روح تنافسية)\nمثال: وظائف غير تنافسية",
 "ひきょうもの": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "ひきょうりょくてき": "غَيْر مُتَعَاوِن (غير متعاون عَمْدًا) / غير متعاون (غير راغب في التعاون)\nمثال: شاهد غير متعاون",
 "ひきょく": "رِثَاء, مَرْثِيَة",
 "ひきょじゅうしゃ": "غير مقيم (لا يعيش في مكان معين أو مملوك لمقيمين دائمين) / غَيْر مُقِيم (شخص لا يعيش في مكان معين)\nمثال: طلاب غير مقيمين يتنقلون إلى الفصول",
 "ひきょり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ひきよせる": "اِجْتَذَبَ, جَذَبَ",
 "ひきり": "مثقاب يدوي (مثقاب محمول صغير يُمسك ويشغل باليد)",
 "ひきわけ": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "ひきわける": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "ひきわたし": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "ひきわたす": "نَقَلَ",
 "ひきわり": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "ひきわる": "مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل. / طَحَنَ (طَحَنَ؛ طِحْنٌ)",
 "ひきん": "شَائِع",
 "ひきんぞく": "معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة / لا فلزي, لا معدني (لا يحتوي على معدن ولا يشبهه ولا يتسم بخصائصه) / لا فلز (عنصر كيميائي يفتقر إلى الخصائص الفلزية النموذجية)\nمثال: عناصر لا فلزية",
 "ひき続く": "تَابَعَ, اِسْتَمَرَّ",
 "ひき臼": "رحى (طاحونة حجرية بدائية لطحن الذرة باليد)",
 "ひき逃げ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "ひぎ": "شَعِيرَة, مَرَاسِم / نَقْد, اِنْتِقَاد / لَوْم, مَلَامَة / أسرار النخبة, باطنية (أسرار لا يعرفها إلا أقلية مطلعة)",
 "ひぎしゃ": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "ひぎつね": "فَيَرْفُكْس",
 "ひぎめ": "يَوْمِيًّا (واحد كل يوم)\nمثال: سنوفر 100 ساعة عمل يومياً",
 "ひぎゃく": "مُعَانَاة",
 "ひぎゃくしゅみ": "مَاسُوشِيَّة, مَازُوخِيَّة",
 "ひぎゃくしん": "مَاسُوشِيَّة, مَازُوخِيَّة",
 "ひぎゃくせいあい": "مَاسُوشِيَّة, مَازُوخِيَّة",
 "ひぎゃくせいあいしゃ": "مَاسُوشِيّ, مَازُوخِيّ",
 "ひぎゃくせいよく": "مَاسُوشِيَّة, مَازُوخِيَّة",
 "ひぎゃくてき": "مازوخي, ماسوشي (استمداد المتعة أو الإشباع الجنسي من التعرض للإيذاء أو الهيمنة)",
 "ひぎょう": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "ひぎょうのさんこ": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "ひく": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل. / طَحَنَ (طَحَنَ؛ طِحْنٌ) / انحسار, جزر (التدفق الخارجي للمد) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد)) / اِسْتَقَالَ / صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "ひくい": "حَزين / خافِت, مُنْخَفِض / قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / عَمِيق, غَوِيط",
 "ひくいどり": "شبنم (طائر كبير أسود لا يطير من أستراليا وغينيا الجديدة له عرف قرني على الرأس)",
 "ひくつ": "خانع, ذليل (خاضع أو متملق في الموقف أو السلوك)\nمثال: تحدث بنبرة خانعة",
 "ひくつく": "زِيَار",
 "ひくて": "عاشق, معجب (شخص معجب بامرأة شابة) / مُعْجَب (شخص يبدي إعجاباً؛ شخص يقدر أو يحترم أو يستحسن) / مؤيد, مشجع (شخص يدعم سياسيًا أو فريقًا وما إلى ذلك)\nمثال: كان لديها العديد من المعجبين",
 "ひくにひけない": "مُرْتَبِط, مُلْتَزِم (مرتبط في علاقة جنسية حصرية) / ملتزم (مقيد أو ملزم، كما هو الحال بموجب تعهد لقضية أو عمل أو موقف معين)\nمثال: أعضاء كنيسة ملتزمون",
 "ひくひく": "ارتعاش, نفضة (تشنج عضلي مفاجئ؛ خاصة الناتج عن حالة عصبية)",
 "ひくまる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "ひくみ": "مُنْخَفِض الوَضْع (ذو ارتفاع صغير فوق سطح الأرض أو الأفق أو مستوى البحر) / عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "ひくめ": "حَزين / خافِت, مُنْخَفِض",
 "ひくめる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "ひぐ": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "ひぐち": "حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات)) / شعلة, عين الموقد (عناصر التسخين في الموقد التي توضع عليها الأواني والمقالي للطهي)\nمثال: محرك الديزل هو حراق زيت",
 "ひぐま": "دُبّ أَسْمَر",
 "ひぐらし": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "ひぐれ": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ひぐれがた": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ひぐれどき": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ひぐんじ": "غَيْر عَسْكَرِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひけ": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "ひけい": "خطة سرية, لعبة (مخطط سري للقيام بشيء ما (خاصة شيء مخادع أو غير قانوني))\nمثال: دبروا مؤامرة لتشويه سمعة الحاكم",
 "ひけぎわ": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "ひけし": "لعبة الإطفائي (لعب يتظاهر فيه الأطفال بإخماد حريق) / رجل إطفاء (عضو ذكر في قسم الإطفاء يحاول إخماد الحرائق) / رامٍ بديل (رامٍ ذكر (في البيسبول) لا يبدأ المباراة (يتم استدعاؤه لإنقاذ الموقف)) / وقاد (عامل ذكر يقوم بتغذية النيران (كما في القطارات التي تعمل بالفحم أو السفن البخارية))",
 "ひけしやく": "إِطْفَائِيّ / مشخص المشاكل, مصلح الأعطال (عامل وظيفته تحديد وإصلاح مصادر الأعطال (خاصة في الأجهزة الميكانيكية)) / لعبة الإطفائي (لعب يتظاهر فيه الأطفال بإخماد حريق) / رجل إطفاء (عضو ذكر في قسم الإطفاء يحاول إخماد الحرائق) / رامٍ بديل (رامٍ ذكر (في البيسبول) لا يبدأ المباراة (يتم استدعاؤه لإنقاذ الموقف)) / وقاد (عامل ذكر يقوم بتغذية النيران (كما في القطارات التي تعمل بالفحم أو السفن البخارية))",
 "ひけそうば": "سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "ひけっしょうしつ": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "ひけっしょうせい": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "ひけつ": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / إِمْسَاك / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひけどき": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "ひける": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "ひけん": "قِرَاءَة / بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / تَجْرِيبِيّ, رَصْدِيّ (يعتمد على الملاحظة أو التجربة) / اِخْتِبَارِيّ, تَجْرِيبِيّ (ذو طبيعة تجريبية أو يخضع لتجربة) / تجريبي (يتعلق بالتجربة أو يعتمد عليها)\nمثال: فيزياء تجريبية",
 "ひけんしゃ": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / ممتحَن (شخص يتم اختباره (مثل اختبار الذكاء أو امتحان أكاديمي))",
 "ひげ": "إماتة الشهوات, كفارة (عقاب ذاتي طوعي للتكفير عن خطأ ما) / شَارِب / لِحْيَة (الشعر النامي على الجزء السفلي من وجه الرجل) / ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "ひげいじゅつてき": "عَدِيم الذَّوْق الفَنِّيّ (يفتقر إلى الحس الجمالي)",
 "ひげき": "مَأْسَاة, تْرَاجِيدْيَا / تْرَاجِيدْيَا / مَأْسَاة, فَاجِعَة",
 "ひげきてき": "مَأْسَاوِيّ, تْرَاجِيدِيّ",
 "ひげきはいゆう": "ممثل تراجيدي (ممثل يتخصص في الأدوار التراجيدية) / كاتب تراجيدي (كاتب (وخاصة كاتب مسرحي) يكتب التراجيديا)",
 "ひげきやくしゃ": "ممثل تراجيدي (ممثل يتخصص في الأدوار التراجيدية) / كاتب تراجيدي (كاتب (وخاصة كاتب مسرحي) يكتب التراجيديا)",
 "ひげくじら": "حوت باليني (حوت ذو صفائح بالين على طول الفك العلوي لتصفية العوالق من الماء)",
 "ひげけっしょう": "شَارِب, كُلْبَة",
 "ひげぜんまい": "نابض شعري (زنبرك حلزوني دقيق ينظم حركة عجلة التوازن في الساعة)",
 "ひげそり": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "ひげむし": "دودة لحوية (حيوان نحيل له مجسات وغطاء خارجي يشبه الأنبوب؛ يعيش في قاع المحيط العميق)",
 "ひげもじまんのうち": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "ひげもじゃ": "مُلْتَحٍ",
 "ひげわし": "كاسر العظام, نسر ملتحي (أكبر طائر جارح أوراسي؛ له ريش أسود يتدلى حول المنقار)",
 "ひげん": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "ひげんじつ": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "ひげんじつせい": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "ひげんじつてき": "غير واقعي (ليس واقعياً)\nمثال: توقعات غير واقعية",
 "ひげんすう": "مَطْرُوح مِنْه (العدد الذي يتم طرح المطروح منه)",
 "ひげ剃り": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "ひげ結晶": "شَارِب, كُلْبَة",
 "ひこ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "ひこう": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه / طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر. / اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني / عَرَجَ / تثخين, تغليظ (فعل التغليظ أو التثخين) / مُتَزَايِد التَّعْقِيد (يَزْدَاد تَعْقِيدًا وَتَشَابُكًا) / تغلظ, عقدة (أي تضخم سميك) / مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف / جَرَادَة / نُخَالَة / نقطة ضغط (منطقة على الجلد حساسة للغاية للضغط) / نقطة ضغط (حيث يحتمل حدوث مشاكل أو صعوبات) / نقطة ضغط (أي من عدة نقاط في الجسم حيث يمكن الشعور بالنبض وحيث يؤدي الضغط على شريان تحتي إلى السيطرة على النزيف من ذلك الشريان في نقطة أبعد)\nمثال: يجب أن تعرف نقاط الضغط لكي تمارس شياتسو / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا / قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ひこうか": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "ひこうかい": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "ひこうかんぱん": "سطح الطيران (السطح العلوي لحاملة طائرات؛ يستخدم كمدرج)",
 "ひこうき": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / طَيَّارَة (هي الطَائِرَة؛ هي الطائرة الورقية)\nمثال: لقد وصلت الطائرة.",
 "ひこうきぐも": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "ひこうきよい": "داء الجو, دوار الجو (دوار الحركة الذي يحدث أثناء السفر بالطائرة (خاصة أثناء الاضطرابات الجوية))",
 "ひこうきんしくういき": "مِنْطَقَةُ حَظْرِ الطَّيَرَان (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "ひこうぐも": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "ひこうけんしゃ": "جَنَاح",
 "ひこうけんにん": "جَنَاح",
 "ひこうし": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "ひこうしき": "غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "ひこうしょうねん": "جانح, حدث جانح (مذنب شاب)",
 "ひこうしん": "نخالية (أي من الاضطرابات الجلدية المتعددة التي تتميز بتساقط رقائق جافة من الجلد)",
 "ひこうじょう": "مَهْبِط, مَدْرَج",
 "ひこうせん": "سفينة هوائية, منطاد موجه (طائرة ذاتية الدفع قابلة للتوجيه)",
 "ひこうそくめいぼしきひれいだいひょうせい": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "ひこうぞうせいやくしゅうごう": "عشوائي, غير مهيكل (يفتقر لهيكل محدد أو تنظيم) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)\nمثال: وضع غير منظم بلا مسؤول",
 "ひこうたい": "سِلَاح طَيَرَان / طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "ひこうてい": "قارب طائر (طائرة مائية كبيرة تطفو ببدنها في الماء بدلاً من استخدام عوامات)",
 "ひこうにん": "غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)\nمثال: نوع من العمدة غير الرسمي",
 "ひこうびん": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "ひこうりつ": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "ひこうりつてき": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "ひこく": "مُدَّعًى عَلَيْهِ / مُتَّهَم / مُتَّهَمَة",
 "ひこくえいか": "خصخصة (تحويل شيء ما من ملكية الدولة أو سيطرتها إلى الملكية الخاصة)",
 "ひこくがわ": "دِفَاع, حِمَايَة / دِفاع",
 "ひこくせき": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "ひこくにん": "مُتَّهَم, مُتَّهَمَة",
 "ひこくみん": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "ひこっきょうと": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "ひこつ": "شظية, عظم الشظية (العظم الخارجي والأرق من بين عظمتي الساق البشرية بين الركبة والكاحل) / شظوي (متعلق بعظم الشظية أو الجزء الخارجي من الساق تحت الركبة)",
 "ひこぴーぢ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "ひこぼし": "النَّسْر الطَّائِر",
 "ひこようしゃ": "مُوَظَّف, مُوَظَّفَة",
 "ひこん": "أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "ひこページ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "ひこ星": "النَّسْر الطَّائِر",
 "ひご": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / نَمِيمَة, إِشَاعَة / اِغْتَابَ / إقبال الزبائن, تجارة (الأعمال التي يقدمها العملاء لمؤسسة تجارية) / رعاية, نظام المحسوبية ((سياسة) منح خدمات أو إعطاء عقود أو إجراء تعيينات في مناصب مقابل الدعم السياسي) / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / ازْدِرَاء, تَعَالٍ (تواصل يشير إلى عدم الاحترام من خلال معاملة المتلقي بفوقية)\nمثال: حتى قبل الظهر كان هناك إقبال كبير",
 "ひごうし": "بَشَر (بَشَرَ؛ بُشِرَ)\nمثال: لكنهم كلهم بشر.",
 "ひごうのさいご": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "ひごうのし": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "ひごうほう": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひごうほうか": "حظر, منع (حظر رسمي أو مرسوم ضد شيء ما)",
 "ひごうり": "لَا مَنْطِقِيَّة (استدلال غير صالح أو غير صحيح)",
 "ひごうりてき": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة)",
 "ひごけん": "حَقُّ اللُّجُوءِ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "ひごしゃ": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "ひごと": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "ひごとに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ひごとよごと": "يَوْمًا بَعْدَ يَوْم",
 "ひごよみ": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "ひごろ": "عَادَةً, الاَكْثِرْ",
 "ひごろのおこない": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "ひさ": "قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "ひさい": "مُعَانَاة / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "ひさいしゃ": "ضَحِيَّة / أُضْحِيَّة",
 "ひさかた": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "ひさかたぶり": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "ひさき": "لَهَب, شُعْلَة",
 "ひさく": "مِغْرَفَة / خطة سرية, لعبة (مخطط سري للقيام بشيء ما (خاصة شيء مخادع أو غير قانوني))\nمثال: دبروا مؤامرة لتشويه سمعة الحاكم",
 "ひさぐ": "بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "ひさこ": "قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "ひさご": "قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "ひさし": "تنده, مظلة قماشية (ظلة مصنوعة من قماش القنب لحماية الناس أو الأشياء من المطر أو الشمس) / حافة أمامية, قناع (حافة تبرز إلى الأمام لتظليل العينين) / قناع الخوذة (قطعة من الدرع الصفيحي (ذات شقوق للعين) مثبتة أو مفصلية بخوذة من العصور الوسطى لحماية الوجه)\nمثال: سحب حافة قبعته لأسفل ومشى بجهد للأمام",
 "ひさしい": "طَوِيل",
 "ひさしぶり": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر / لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "ひさびさ": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "ひさめ": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "ひさん": "كَارِثِيّ, مَشْؤُوم ((عَنِ الأَحْدَاثِ) ذُو عَوَاقِبَ وَخِيمَةٍ أَوْ كَارِثِيَّةٍ) / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات) / حمض الزرنيخيك (حمض يتكون من خماسي أكسيد الزرنيخ)",
 "ひさんなまり": "زرنيخات الرصاص",
 "ひさんぼうし": "مُضَادٌّ لِلتَّشَظِّي, مُقَاوِمٌ لِلتَّحَطُّم (مُقَاوِمٌ لِلتَّحَطُّمِ أَوِ التَّشَظِّي)",
 "ひざ": "رُكْبَة / حَجَر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / وَلَغَ\nمثال: عوقب زيري بالحجر.",
 "ひざかな": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "ひざかり": "ظهر, ظهيرة (منتصف اليوم)",
 "ひざかんせつ": "ركبة, مفصل الركبة (مفصل رزي في الساق البشرية يربط القصبة والشظية بعظم الفخذ وتحميه الرضفة من الأمام)",
 "ひざがしら": "رَضَفَة",
 "ひざくら": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز) / فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "ひざくりげ": "تَمَشٍّ, تَنَزُّه",
 "ひざぐるま": "رَضَفَة",
 "ひざげり": "رُكْبَة",
 "ひざこぞう": "رَضَفَة",
 "ひざし": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "ひざたけ": "يصل للركبة (يمتد إلى الركبة)",
 "ひざだち": "جثو, ركوع (دعم نفسك على ركبتيك)",
 "ひざづめ": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "ひざのさら": "رَضَفَة",
 "ひざの皿": "رَضَفَة",
 "ひざまずく": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "ひざまづく": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "ひざもと": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "ひざら": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة / مَبْخَرَة",
 "ひざらがい": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية) / خيتون (سترة صوفية ارتداها الرجال والنساء في اليونان القديمة)",
 "ひざをいだく": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "ひざをおる": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا) / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "ひざをくっする": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "ひざをだく": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "ひざをまじえて": "بشكل وثيق, جيداً (بمعرفة كبيرة أو حميمة بشكل خاص) / بشكل وثيق, حميمياً (بطريقة وثيقة)\nمثال: كنا نعرفهم جيداً",
 "ひざ丈": "يصل للركبة (يمتد إلى الركبة)",
 "ひざ元": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "ひざ詰め": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "ひざ蹴り": "رُكْبَة",
 "ひし": "إفراز دهني, زهم (الإفراز الزيتي للغدد الدهنية؛ مع العرق يرطب ويحمي الجلد) / اِمْتِنَاع, إِمْسَاك / جوز اليسوعيين, كستناء الماء (نوع من كستناء الماء) / حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته) / رَقّ",
 "ひしお": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "ひしかくし": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "ひしがくし": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "ひしがた": "مُعَيِّن",
 "ひしきじ": "أُمِّيَّة",
 "ひしぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "ひしげきせい": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "ひししょくぶつ": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "ひしせん": "غُدَّة دُهْنيّة",
 "ひしつ": "قشرة العدسة (النسيج الذي يحيط بنواة العدسة) / قشرة مخية (طبقة الخلايا العصبية غير الميالينية (المادة الرمادية) التي تشكل قشرة المخ) / قشرة (النسيج المكون للطبقة الخارجية لعضو أو هيكل في النبات أو الحيوان)",
 "ひしと": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / بحدة, بعدوانية (بطريقة عدوانية) / بشكل حاد, بوضوح (بطريقة محددة بوضوح) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: كانت تُستجوب بحدة",
 "ひしはいしゃ": "خَاضِع لِلْحُكْم, مَحْكُوم (يخضع لسلطة حاكمة)",
 "ひしひし": "بشكل حاد (ذو بداية سريعة ومفاجئة (طبياً)) / بِدَهَاء, بِفِطْنَة (بطريقة ذكية) / بحدة, بشدة (بطريقة حادة أو نافذة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: فيروس مضعف بشكل حاد / بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام",
 "ひしめき": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "ひしめく": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "ひしゃ": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ひしゃく": "مِغْرَفَة",
 "ひしゃぐ": "سَطَّح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)",
 "ひしゃげる": "سَطَّح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)",
 "ひしゃこうてき": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "ひしゃたい": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "ひしゅ": "تضخم الطحال (تضخم غير طبيعي للطحال) / خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "ひしゅう": "غَمّ, حُزْن",
 "ひしゅうきょうしゅぎ": "عَلْمَانِيَّة, لَائِكِيَّة",
 "ひしゅうようしゃ": "سَاكِن, سَاكِنَة",
 "ひしゅしどうさ": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "ひしゅよう": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "ひしょ": "سِكْرِتِير, سِكْرِتِيرَة / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف. / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / سِجِّين, عَالَم سُفْلِيّ",
 "ひしょう": "تَافِه / إنفاق, صرف (عملية إنفاق أو صرف المال) / إنفاق, مصروفات (أموال مدفوعة؛ مبلغ تم إنفاقه) / اختلاس, سوء استخدام (استعارة غير مشروعة) / اختلاس, استيلاء (الاستيلاء الاحتيالي على أموال أو ممتلكات معهود بها لرعايتك ولكنها مملوكة فعلياً لشخص آخر)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية / طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر. / غَمّ, حُزْن",
 "ひしょうしつ": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "ひしょうたい": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام) / قذيفة, مقذوف (سلاح يُرمى أو يُقذف بقوة على الأهداف ولكنه ليس ذاتي الدفع) / صاروخ, مركبة صاروخية (أي مركبة ذاتية الدفع بواسطة محرك صاروخي)",
 "ひしょうてん": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "ひしょうにん": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "ひしょくけい": "مقياس الألوان (أداة قياس تستخدم في التحليل اللوني لتحديد كمية مادة ما من اللون الذي تنتجه مع كواشف محددة)",
 "ひしょくしゃ": "فَرِيسَة / غَنِيمَة",
 "ひしょくていりょう": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "ひしょくぶんせき": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "ひしん": "طَفْح, طَفْح جِلْدِيّ / شَفْر ((شَفَّرَتِ) الشَّمْسُ: دنَت للغُرُوبِ؛ (شَفَّرَتِ) المالُ: قَلَّ وذهب)",
 "ひしんけい": "رُمْحِيّ ((عن شكل الورقة) كرأس الرمح؛ ضيّق يتدرَّج إلى قمّة مُدبَّبة)",
 "ひしんじゅんせいにゅうかんがん": "مدير الاستخبارات المركزية (رئيس مجتمع الاستخبارات الأمريكي ومدير وكالة المخابرات المركزية)",
 "ひしんわか": "عقلنة, نزع الأسطورة (إعادة صياغة رسالة (دينية مثلاً) بمصطلحات عقلانية)",
 "ひし形": "مُعَيِّن",
 "ひじ": "كُوع, مِرْفَق / كُوعٌ / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひじあて": "واقي كوع (ملابس واقية تتكون من وسادة تلبس فوق الكوع من قبل لاعبي كرة القدم والهوكي)",
 "ひじかけ": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "ひじかけいす": "كُرْسِيّ ذُو ذِرَاعَيْن, أَرِيكَة (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "ひじがしら": "نَاتِئ مِرْفَقِيّ, طَرَف الْمِرْفَق",
 "ひじき": "شَرِيحَة",
 "ひじっさいてき": "غير عملي (ليس عملياً؛ غير قابل للتطبيق أو لا يهتم بالأمور العملية) / خَيَالِيّ, غَيْرُ وَاقِعِيّ (غَيْرُ عَمَلِيٍّ وَلَا قَابِلٍ لِلتَّحْقِيق؛ تَأَمُّلِيّ)\nمثال: تعويم السفينة ثبت أنه غير عملي بسبب التكلفة",
 "ひじてっぽう": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひじてつ": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひじでっぽう": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひじゅう": "ثقل نوعي (كثافة مادة بالنسبة لكثافة الماء) / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "ひじゅうけい": "مقياس الكثافة (أداة قياس لتحديد الكثافة أو الثقل النوعي)",
 "ひじゅつ": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "ひじゅん": "إبرام, تصديق (جعل الشيء ساري المفعول عن طريق التصديق عليه أو تأكيده رسميًا)\nمثال: المصادقة على المعاهدة",
 "ひじゅんかんてき": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة) / لاحلقي, لاسواري (غير حلقي؛ خاصة وجود أجزاء مرتبة في لوالب بدلاً من دوارات)",
 "ひじょう": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد",
 "ひじょうかいだん": "مخرج طوارئ",
 "ひじょうきん": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "ひじょうきんこうし": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "ひじょうぐち": "مخرج طوارئ\nمثال: その建物には非常口がない。 — ليس لهذه البناية مخرج للطوارئ.",
 "ひじょうしき": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "ひじょうしんごう": "إِنْذَار",
 "ひじょうじ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "ひじょうじょう": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "ひじょうすう": "مَضْرُوب (العدد الذي يتم ضربه في المضروب فيه)",
 "ひじょうせん": "شريط زينة, وشاح (زينة تتكون من شريط أو حبل مزخرف) / شريط, وشاح (حبل أو شريط يلبس كشارة شرف أو رتبة) / طوق, كردون (سلسلة من الحراس أو المراكز العسكرية تحيط أو تحرس مكاناً أو شيئاً ما)",
 "ひじょうちゅう": "مُؤَقَّت, سَريع الزوال",
 "ひじょうとにん": "مَنْقُول, مُحَوَّل (شخص ينتقل أو يتم نقله من منصب إلى آخر) / المحال إليه ((قانون) شخص يُنقل إليه سند ملكية أو ممتلكات)\nمثال: كان أفضل طالب منقولاً من جامعة ولاية لويزيانا",
 "ひじょうに": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ひじょうブレーキ": "مكبح الطوارئ, مكبح يدوي (مكبح يعمل باليد؛ يعمل عادة عن طريق وصلة ميكانيكية)",
 "ひじょうベル": "جرس الإنذار, ناقوس الخطر (صوت إنذار (عادة جرس))",
 "ひじょすう": "حِصَّة / مَقْسُوم",
 "ひじり": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / قَيْصَر, إِمْبْرَاطُور / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "ひじん": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد) / الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي)",
 "ひじんかくか": "تجريد من الشخصية, تشييء (تمثيل إنسان كشيء مادي مجرد من الصفات الشخصية أو الفردية) / اختلال الإنية, تبدد الشخصية ((في الوجودية) فقدان الهوية الشخصية؛ شعور الفرد بأنه ترس مجهول في آلة اجتماعية غير شخصية) / اضطراب تبدد الشخصية, تبدد الشخصية (اضطراب انشقاقي عاطفي يحدث فيه فقدان للاتصال بالواقع الشخصي للفرد مصحوباً بمشاعر اللاواقعية والغرابة)\nمثال: وفقًا لماركس، فإن معاملة العمل كسلعة تجسد تشييء الفرد",
 "ひじんどう": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "ひじんどうせい": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "ひじんどうてき": "غير إنساني, وحشي (يفتقر ويعكس الافتقار إلى الشفقة أو الرحمة)\nمثال: البشر غير إنسانيين فطرياً؛ هذا يفسر الكثير من البؤس والمعاناة في العالم",
 "ひじ当て": "واقي كوع (ملابس واقية تتكون من وسادة تلبس فوق الكوع من قبل لاعبي كرة القدم والهوكي)",
 "ひじ掛け": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "ひす": "أَخْفَى",
 "ひすい": "يَشْم / يَشْب / سَلْدَج / قِرِلَّى / رَفْرَاف",
 "ひすいいろ": "أخضر يشمي (لون أخضر فاتح يتراوح من الأزرق المخضر إلى الأخضر المصفر)",
 "ひすいきせき": "جاديت (معدن أخضر صلب يتكون من سيليكات صوديوم ألمنيوم في شكل بلوري أحادي الميل؛ مصدر لليشم)",
 "ひすう": "خبز النان (خبز مخمر يخبز في فرن طيني في الهند؛ عادة ما يكون على شكل دمعة) / جدة (والدة أبيك أو أمك) / جدة (جدتك (مصطلح غير رسمي))",
 "ひする": "قَارَنَ / شَبَّهَ / أَخْفَى",
 "ひずみ": "سُلَالَة",
 "ひずみけい": "مقياس الانفعال (مقياس لقياس الانفعال في سطح ما)",
 "ひずみ計": "مقياس الانفعال (مقياس لقياس الانفعال في سطح ما)",
 "ひずむ": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "ひずめ": "حافِر, ظِلْف",
 "ひせいき": "شَاذّ, غَيْر مُنْتَظِم / دُون الطَّبِيعِيّ (أقل من المستوى الطبيعي أو المتوسط) / دون الطبيعي (شخص ذكاؤه أقل من الطبيعي)",
 "ひせいきろうどうしゃ": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "ひせいさんてき": "غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "ひせいじてき": "لَا سِيَاسِيّ, مُحَايِد سِيَاسِيًّا (محايد من الناحية السياسية)",
 "ひせいそくぎょうれつ": "مصفوفة منفردة (مصفوفة مربعة يساوي محددها صفراً)",
 "ひせいふそしき": "مُنَظَّمَة غَيْر حُكُومِيَّة",
 "ひせき": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مِضْمَار\nمثال: اختفى فلم ير له أثر. / سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / غَثّ, شَوْب (الحيوان والإنسان: عجف وهزل، ضد سمن؛ غَثَّت الشاة، ق)",
 "ひせきのこころ": "ثبات, صمود (عزم راسخ) / ثَبَات, رَبَاطَة جَأْش (الولاء في مواجهة المتاعب والصعوبات)",
 "ひせつ": "عَاصِفَة ثَلْجِيَّة, دَمَق / عرقوب (المفصل الرصغي للساق الخلفية للثدييات ذوات الحوافر؛ يقابل الكاحل البشري) / نبيذ الراين, هوك (أي من أنواع النبيذ الأبيض المتعددة من وادي نهر الراين في ألمانيا) / ثائرة, غضب (شعور بالغضب والعداء) / قشور جلد الحيوان, وَبَر (قشور صغيرة من جلود الحيوانات أو شعرها أو ريش الطيور يمكن أن تسبب تفاعلات تحسسية لدى بعض الناس)\nمثال: ثارت ثائرته",
 "ひせん": "مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة) / شَلَّال",
 "ひせんけい": "غير خطي (يصف أو يتضمن معادلة تكون حدودها ليست من الدرجة الأولى)",
 "ひせんとういん": "مَدَنِيّ / مَدَنِيَّة",
 "ひせんろん": "سَلَامِيَّة, سِلْمِيَّة",
 "ひせんろんしゃ": "مُسَالِم / مُسَالِمَة",
 "ひぜん": "جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس. / جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "ひぜんダニ": "سوسة الجرب (سوس مبيض يهاجم جلد البشر والحيوانات الأخرى)\nمثال: سوس الجرب يسبب الجرب",
 "ひそ": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "ひそう": "بُطُولِيّ / سَخِيف, مُثِير لِلشَّفَقَة (يُثِير شَفَقَةً مَشُوبَةً بِالاِزْدِرَاء) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / سَطْحِيّ / كَنْز / قشرة العدسة (النسيج الذي يحيط بنواة العدسة) / قشرة مخية (طبقة الخلايا العصبية غير الميالينية (المادة الرمادية) التي تشكل قشرة المخ) / قشرة (النسيج المكون للطبقة الخارجية لعضو أو هيكل في النبات أو الحيوان)",
 "ひそうぞくにん": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ひそうてき": "سَطْحِيّ",
 "ひそか": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひそざい": "زرنيخي (يتعلق بـ أو يحتوي على الزرنيخ) / زرنيخي, مركب زرنيخي (مبيد آفات أو دواء يحتوي على الزرنيخ)\nمثال: بخار زرنيخي",
 "ひそひそ": "سراً, في الخفاء (بسرية؛ ليس علناً)\nمثال: التقوا سراً",
 "ひそひそごえ": "هَمْس / هَمَسَ, وَسْوَسَ",
 "ひそひそばなし": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "ひそひそ声": "هَمْس / هَمَسَ, وَسْوَسَ",
 "ひそひそ話": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "ひそみ": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "ひそめる": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / حَاكَ (نسج الثوب أو القماش؛ دبّر مكيدة أو خديعة)",
 "ひそやか": "صَامِت, هَادِئ",
 "ひぞう": "كَنْز / طِحَال",
 "ひぞうてきしゅつ": "استئصال الطحال (إزالة جراحية للطحال)",
 "ひぞうぶつ": "مَخْلُوق, كَائِن",
 "ひぞく": "قَاطِع طَرِيق / بَذِيء",
 "ひた": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "ひたい": "جَبْهَة, جَبِين / إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "ひたいおう": "غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "ひたいがみ": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / خُصْلَة أَمَامِيَّة, نَاصِيَة (خصلة شعر تنمو (أو تتدلى) فوق الجبهة)",
 "ひたいぎわ": "خط الشعر, منبت الشعر (الحد الطبيعي الذي يشكله الشعر على الرأس) / خط رفيع جداً, خط شعري (خط رفيع للغاية)",
 "ひたいしょう": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "ひたいをあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ひたいをよせあう": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ひたおしに": "بثبات",
 "ひたき": "صائد الذباب (العالم القديم) (أي من مجموعة كبيرة من الطيور المغردة الصغيرة التي تتغذى على الحشرات التي يتم اصطيادها أثناء الطيران)",
 "ひたす": "اِبْتَلَّ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "ひたすら": "بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "ひたと": "بِالْقُرْب مِن, بِجَانِب / مُبَاشَرَةً / فَجْأَةً",
 "ひたひた": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد)) / بثبات / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / بسرعة, سريعاً\nمثال: يعمل بسرعة",
 "ひたぶる": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "ひたむき": "جَدِّي, جَادّ / عَرْبُون",
 "ひたん": "غَمّ, حُزْن",
 "ひだ": "طَوَى / طَيَّة / تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / صفيحة رقيقة (لوحة رقيقة) / صفيحة (غشاء رقيق هو إحدى الطبقات المتكلسة التي تشكل العظام) / خيشوم, صفيحة (أي من الهياكل المشعة الشبيهة بالأوراق المنتجة للأبواغ على الجانب السفلي من غطاء الفطر أو فطريات مماثلة)",
 "ひだい": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً / تضخم (تضخم غير طبيعي لجزء من الجسم أو عضو)",
 "ひだいか": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "ひだいした": "متضخم ((عن عضو أو جزء من الجسم) متضخم بشكل مفرط نتيجة لزيادة حجم الخلايا المكونة له) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُتَضَخِّم (أكْبَر مِن الحَجْم الطَّبيعِيّ) / مُكَبَّر (كالصورة الفوتوغرافية؛ جُعل أكبر حجماً)\nمثال: ألياف عضلة القلب المتضخمة",
 "ひだえり": "دريجة شرسة",
 "ひだち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "ひだっそ": "جَمْرَة خَبِيثَة",
 "ひだね": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "ひだま": "كُرَة نَارِيَّة",
 "ひだり": "يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة) / يساري / يَسَارًا, شِمَالًا / إِلَى اَلْيَسَار, إِلَى اَلشِّمَال (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / بِقِي (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: ذهب سامي إلى اليسار. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / شَارِب",
 "ひだりいどうみゃく": "شريان معدي أيسر (فرع من الشريان الزلاقي يغذي الانحناء الصغير للمعدة والجزء البطني من المريء)",
 "ひだりうちわ": "بحبوحة, رغد العيش (أمان مالي)",
 "ひだりうわて": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりきき": "أعسرية, عسر (تفضيل استخدام اليد اليسرى) / زواج اليد اليسرى, زواج مورغاناتي (حالة الولادة من زواج مورغاناتي (زواج بين نبيل وامرأة من طبقة أدنى لا يرث فيه الأبناء ألقاب الأب)) / شَارِب",
 "ひだりぎっちょ": "أعسرية, عسر (تفضيل استخدام اليد اليسرى) / زواج اليد اليسرى, زواج مورغاناتي (حالة الولادة من زواج مورغاناتي (زواج بين نبيل وامرأة من طبقة أدنى لا يرث فيه الأبناء ألقاب الأب))",
 "ひだりだしゃ": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりづま": "غَيْشَا",
 "ひだりて": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة) / يساري / يَسَارًا, شِمَالًا / إِلَى اَلْيَسَار, إِلَى اَلشِّمَال (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / بِقِي (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: ذهب سامي إلى اليسار.",
 "ひだりてざひょうけい": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりとう": "شَارِب",
 "ひだりとうしゅ": "رامٍ أعسر (رامي بيسبول يرمي الكرة باليد اليسرى)",
 "ひだりなげ": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりまえ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "ひだりまき": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة! / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "ひだりまきまいまい": "حلزون الحديقة (أي من عدة حلزونات غير صالحة للأكل من جنس هيليكس؛ غالباً ما تكون آفات مدمرة)",
 "ひだりまわり": "دوران عكس عقارب الساعة, دوران يساري (دوران إلى اليسار)",
 "ひだりハンドル": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ひだりバッター": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだるい": "جَائِع, جَوْعَان",
 "ひだ襟": "دريجة شرسة",
 "ひち": "سَبْعَة\nمثال: 私は今朝7時に起きた。 — استيقظت في السابعة هذا الصباح.",
 "ひちしゃ": "خَاضِع لِلْحُكْم, مَحْكُوم (يخضع لسلطة حاكمة)",
 "ひちゃくしゅつし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "ひちゅう": "سراً, في الخفاء (بسرية؛ ليس علناً)\nمثال: التقوا سراً",
 "ひちゅんちゃ": "هايسون (شاي أخضر صيني بأوراق ملتوية)",
 "ひちょう": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "ひちょうきん": "عضلة الساق التوأمية (العضلة الموجودة في الجزء الخلفي من الساق التي تشكل الجزء الأكبر من ربلة الساق؛ مسؤولة عن الثني الأخمصي للقدم)",
 "ひちょうわ": "مُتَنَافِر",
 "ひちょっけつ": "غَيْر مُتَّصِل, غَيْر مُتَوَاجِد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひっかえす": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "ひっかかり": "مَسَكَ, مسك / صِلَة, صُلَة / عَلَاقَة, صِلَة / عدم ارتياح, قلق (سمة عدم الارتياح) / اعتلال, توعك (انزعاج جسدي (كمرض خفيف أو اكتئاب))",
 "ひっかかる": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ひっかききず": "خَرْبَشَ",
 "ひっかきまわす": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "ひっかき傷": "خَرْبَشَ",
 "ひっかく": "خَرْبَشَ",
 "ひっかけ": "خَطَّاف / لَكْمَة خُطَّافِيَّة / شَرَكٌ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه) / مِصْيَدَةٌ\nمثال: هذه شركة صينية.",
 "ひっかけかぎ": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "ひっかけもんだい": "سُؤَال خَادِع (سُؤَال)\nمثال: أجب على السؤال.",
 "ひっかける": "خَطَّاف / لَكْمَة خُطَّافِيَّة / غَشَّ / شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "ひっかけシーリング": "مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)",
 "ひっかけ問題": "سُؤَال خَادِع (سُؤَال)\nمثال: أجب على السؤال.",
 "ひっかけ鉤": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "ひっき": "نسخ (فعل النسخ) / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "ひっきしゃ": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات)",
 "ひっきちょう": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "ひっきょう": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ひっきょうするに": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ひっきようぐ": "أداة كتابة (أداة تستخدم للكتابة)",
 "ひっきりなし": "مُتَوَاصِل, مُتَّصِل",
 "ひっきりなしに": "باستمرار",
 "ひっくい": "حَزين / خافِت, مُنْخَفِض / قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / عَمِيق, غَوِيط",
 "ひっくくる": "إِبَالَة, حُزْمَة",
 "ひっくりかえす": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくりかえる": "قَلَبَ",
 "ひっくりがえす": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくりがえる": "قَلَبَ",
 "ひっくり返す": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくり返る": "قَلَبَ",
 "ひっくるめて": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "ひっけい": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة / دَلِيل, كُتَيِّب",
 "ひっけいひん": "ضَرُورَة, حَاجَة",
 "ひっけん": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "ひっこし": "مُتَحَرِّك / مُؤَثِّر",
 "ひっこしいわい": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "ひっこしや": "شركة نقل, شركة نقل أثاث (شركة تقوم بنقل ممتلكات عائلة أو شركة من موقع إلى آخر) / متحرك (شخص يتحرك) / عامل نقل أثاث (عامل توظفه شركة نقل) / مقدم الاقتراح, مُقْتَرِح ((في الإجراءات البرلمانية) شخص يقدم اقتراحاً رسمياً)\nمثال: كان عمال النقل حريصين جداً مع البيانو الكبير",
 "ひっこす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "ひっこぬく": "مُقْتَطَف / خلاصة",
 "ひっこみ": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "ひっこみじあん": "مَحْجُوز",
 "ひっこむ": "غَطَسَ / مَجْلَى, مَغْسَلَة / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "ひっこめる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "ひっさげる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "ひっさつ": "مُمِيت / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ひっさらう": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "ひっし": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه) / حَتْمِيّ",
 "ひっしになって": "بإلحاح, بشكل عاجل (بإلحاح شديد) / باستماتة, بيأس (بيأس شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "ひっしゃ": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب. / نسخ (فعل النسخ)",
 "ひっしゅ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっしゅう": "إِجْبَارِيّ, إِلْزَامِيّ (مطلوب بموجب قاعدة أو نظام) / لَازِم, مَطْلُوب (ضروري للإغاثة أو الإمداد)",
 "ひっしょうふはい": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "ひっす": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっすう": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっすじょうけん": "أمر لا غنى عنه, شرط أساسي (شرط مسبق لا يمكن الاستغناء عنه)",
 "ひっする": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "ひっすアミノさん": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "ひっせい": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات) / أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة) / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "ひっせき": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم) / مخطوطة (كتاب أو وثيقة مكتوبة بخط اليد)",
 "ひっせきがく": "جرافولوجي, علم الخط (دراسة خط اليد (خاصة كمؤشر على شخصية الكاتب أو مزاجه))",
 "ひっそく": "إِقَامَة جَبْرِيَّة",
 "ひっそり": "صَامِت, هَادِئ / خلسة, دون لفت للانتباه (بطريقة تهدف إلى تجنب جذب الانتباه)\nمثال: دخل الغرفة دون لفت للانتباه",
 "ひっそりかん": "بِهُدُوء",
 "ひっそり閑": "بِهُدُوء",
 "ひったくり": "لِصّ, لِصَّة",
 "ひったくる": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "ひったん": "أسلوب الكتابة, نوع أدبي (نمط للتعبير عن النفس في الكتابة)",
 "ひっち": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "ひっちゃかめっちゃか": "فَوْضَوِيّ",
 "ひっちゅう": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل",
 "ひっつかまえる": "إِسْتَوْلَى عَلَى",
 "ひっつかむ": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "ひっつきむし": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "ひっつき虫": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "ひっつく": "تَزَوَّجَ",
 "ひっつける": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "ひっつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "ひっつれる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ひってき": "مُنَافِس",
 "ひっとう": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "ひっとうしゃ": "اسم أول, اسم شخصي (الاسم الذي يسبق اللقب)",
 "ひっとらえる": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっぱく": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة) / خسة, شح (بخل شديد) / اِكْتِظَاظ, تَرْكِيز (الخاصية المكانية للازدحام أو التكدس معاً) / انقباض, ضيق (شعور بالضيق في جزء من الجسم)\nمثال: شعر بانقباض في صدرها",
 "ひっぱたく": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "ひっぱり": "جر, سحب (فعل السحب؛ تطبيق قوة لتحريك شيء تجاهك أو معك)\nمثال: جعله السحب لأعلى التل يتنفس بصعوبة",
 "ひっぱりぎみ": "مَتِين, مَشْدُود (مَسْحُوبٌ أَوْ مَمْدُودٌ بِإِحْكَام) / مُتَوَتِّرٌ بِشِدَّة (مُعَرَّضٌ لِتَوَتُّرٍ شَدِيدٍ؛ مَشْدُودٌ بِإِحْكَام)",
 "ひっぱりだす": "أَخْرَجَ",
 "ひっぱりつよさ": "قوة الشد (قوة المادة معبراً عنها كأكبر إجهاد طولي يمكن أن تتحمله دون أن تتمزق)",
 "ひっぱりづよさ": "قوة الشد (قوة المادة معبراً عنها كأكبر إجهاد طولي يمكن أن تتحمله دون أن تتمزق)",
 "ひっぱる": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "ひっぷ": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ひっ捕える": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっ捕まえる": "إِسْتَوْلَى عَلَى",
 "ひっ捕らえる": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっ迫": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة) / خسة, شح (بخل شديد) / اِكْتِظَاظ, تَرْكِيز (الخاصية المكانية للازدحام أو التكدس معاً) / انقباض, ضيق (شعور بالضيق في جزء من الجسم)\nمثال: شعر بانقباض في صدرها",
 "ひつ": "فُرْشَاة الطِلَاء / الخط, فن الخط (الكتابة اليدوية الجميلة) / لُوط / خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / تَحْدِيد, قَطْعِيَّة (صفة القابلية للتنبؤ بثقة كبيرة)",
 "ひつい": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "ひつう": "غَمّ, حُزْن",
 "ひつかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "ひつぎ": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "ひつぎのみこ": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ひつぐう": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ひつけ": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ひつけやく": "مُحَرِّض, مُحَرِّضَة",
 "ひつじ": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛ / باتجاه الجنوب الجنوب الغربي (إلى أو نحو أو في الجنوب الجنوب الغربي)",
 "ひつじかい": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "ひつじがわ": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "ひつじぐも": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "ひつじごや": "حظيرة أغنام, زريبة غنم (حظيرة للأغنام)",
 "ひつじさる": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة)",
 "ひつじゅ": "ضَرُورِيّ, لَازِم",
 "ひつじゅひん": "ضَرُورَة, حَاجَة",
 "ひつじょう": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك) / بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: هو كذلك بالضرورة",
 "ひつじ雲": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "ひつぜつ": "وَصْف, تَوْصِيف",
 "ひつぜん": "حَتْمِيّ / حَتْمِيَّة, وُجُوب (صفة كون الشيء غير قابل للتجنب)",
 "ひつぜんせい": "ضَرُورَة, حَاجَة",
 "ひつぜんてき": "حَتْمِيّ",
 "ひつにゅう": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي) / إدرار الحليب, رضاعة (إنتاج وإفراز الحليب بواسطة الغدد الثديية) / رضاعة, فترة الرضاعة (الفترة التي تلي الولادة والتي يتم خلالها إفراز الحليب)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "ひつにゅうりょう": "إدرار الحليب, محصول الحليب (كمية الحليب التي تنتجها البقرة)\nمثال: الموسيقى الهادئة يمكن أن تحسن إدرار الحليب",
 "ひつにょう": "تبول (إخراج البول)",
 "ひつにょうき": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "ひつび": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひつぼく": "قِرْطَاسِيَّة",
 "ひつめい": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "ひつめつ": "فناء, موت (الجودة أو الحالة المتمثلة في كونه فانياً) / مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "ひつよう": "ضَرُورِيّ, لَازِم / ضَرُورَة, حَاجَة",
 "ひつようご": "كلمة مفتاحية (كلمة مهمة تستخدم في الفهرسة أو التصنيف) / كلمة مفتاحية (كلمة تستخدم كنمط لفك تشفير رسالة مشفرة)",
 "ひつようじ": "ضَرُورَة, حَاجَة",
 "ひつようじょうけん": "شَرْط ضَرُورِيّ (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "ひつようせい": "ضَرُورَة, حَاجَة",
 "ひつようとする": "حَاجَة, ضَرُورَة / اِحْتَاجَ\nمثال: とりわけ子供たちは愛情を必要とする。 — و فوق كل شيء، يحتاج الأطفال إلى الحب.",
 "ひつようない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひつようははつめいのはは": "اَلْحَاجَة أَمّ اَلاِخْتِرَاع",
 "ひつようひん": "ضَرُورَة, حَاجَة",
 "ひつようふかけつ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひつようぶつ": "ضَرُورَة, حَاجَة",
 "ひつろく": "تدوين, سجل مكتوب (وثيقة مكتوبة تحفظ المعرفة بوقائع أو أحداث)",
 "ひづくり": "تطريق, حدادة (تشكيل المعدن عن طريق التسخين والطرق)",
 "ひづけ": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "ひづめ": "حافِر, ظِلْف",
 "ひてい": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد. / إِنْكَار / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "ひていけい": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر. / غَيْر مُنْتَظِم, لَا نَمَطِيّ (ينحرف عن التوقعات الطبيعية؛ غريب أو شاذ بعض الشيء) / شاذ, غير نمطي (لا يمثل مجموعة أو فئة أو نوعًا)\nمثال: فئة من الطحالب غير النموذجية",
 "ひていけいどうし": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "ひていけいはいえん": "التهاب رئوي لانمطي (مرض تنفسي حاد يتميز بحمى عالية وسعال)",
 "ひていこう": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "ひていてき": "سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة",
 "ひてきしゅつし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "ひてきよう": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ひてんしゅうさ": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "ひでぇ": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひでえ": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひでり": "جَفَاف",
 "ひでん": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひでんか": "أَمِيرَة",
 "ひでー": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひと": "قَاطِع طَرِيق / أُقْنُوم / فَرْد / بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب / بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق. / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ) / إنفاق, صرف (عملية إنفاق أو صرف المال) / إنفاق, مصروفات (أموال مدفوعة؛ مبلغ تم إنفاقه) / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "ひとあし": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "ひとあしさきに": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا",
 "ひとあじ": "تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها)",
 "ひとあじもふたあじも": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "ひとあたり": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "ひとあたりがいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりがよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりのいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりのよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあつめ": "جمهور, حشد كبير (تجمع كبير للناس)",
 "ひとあばれ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "ひとあめ": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "ひとあれ": "مُشْكِلَة, مَتاعِب",
 "ひとあわ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "ひとあわふかせる": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "ひとあんしん": "سَكِينَة, طُمَأْنِينَة",
 "ひといき": "تَوَقَّفَ / تَوَقُّف, وَقْف / قَلِيلًا",
 "ひといきれ": "ثقل دم, جمود (وقار ممل ومتغطرس) / انعدام التهوية, كتمة (صفة انحباس الهواء وسوء التهوية) / انسداد (حالة انسداد أو توقف الهواء في الأنف أو الحلق)",
 "ひといちばい": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "ひとう": "غَيْر مَعْرُوف لِلْأَغْلَبِيَّة, قَلِيل الشُّهْرَة (غير معروف لمعظم الناس) / الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا.",
 "ひとうけ": "شَعْبِيَّة",
 "ひとうり": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19) / تاجر رقيق (شخص يعمل في تجارة الرقيق)",
 "ひとえざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة صلبة واحدة؛ ينتج الكثير منها أيضاً خشباً صلباً قيماً)",
 "ひとえつぎ": "عقدة الشراع, عقدة النساج (عقدة تستخدم لربط حبل مؤقتاً بمنتصف حبل آخر)",
 "ひとえに": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "ひとおし": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "ひとおもいに": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "ひとおよぎ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "ひとかい": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19)",
 "ひとかかえ": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "ひとかけら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / خرقة, رقعة (قطعة صغيرة من القماش) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "ひとかげ": "سَمَنْدَل",
 "ひとかさね": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "ひとかず": "بَالِغ, رَاشِد",
 "ひとかせぎ": "كَسَبَ",
 "ひとかた": "عَادِيّ, مَأْلُوف",
 "ひとかたならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "ひとかたならぬ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひとかど": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "ひとかどのじんぶつ": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどのにんげん": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどの人物": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどの人間": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかまえ": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة)) / تجمع, حزمة (تجمع لعدد من الأشياء المتشابهة) / تكتل, كتلة (كتلة متماسكة)\nمثال: مجموعة من الأشجار",
 "ひとかわ": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ひとかわむける": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "ひとがいい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "ひとがしら": "جُمْجُمَة",
 "ひとがたロボット": "أَنْدْرُويِد",
 "ひとがましい": "مُحْتَرَم",
 "ひとがよい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "ひとがら": "شَخْصِيَّة",
 "ひとがわるい": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "ひときざみ": "فَائِق, مُمْتَاز (من أعلى مستويات الجودة)",
 "ひときり": "تَوَقَّفَ / تَوَقُّف, وَقْف / اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب سياسية أو لمنافع شخصية)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "ひときれ": "شريحة / قَطَّعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "ひときわ": "بشكل بارز, بوضوح (بطريقة بارزة) / بشكل لافت, بوضوح تام (بطريقة تميل إلى جذب الانتباه)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر",
 "ひとぎき": "سُمْعَة, شُهْرَة",
 "ひとぎきのわるい": "سيء السمعة (يفتقر للاحترام في الشخصية أو السلوك أو المظهر)",
 "ひとぎらい": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "ひとく": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / اختباء (حالة الاختباء)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "ひとくい": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "ひとくいうま": "عَاضّ (شخص يقوم بالعض)",
 "ひとくいざめ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "ひとくいじんしゅ": "غُول, آكِلُ لُحُوم البَشْر",
 "ひとくいせい": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "ひとくいてき": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "ひとくいザメ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "ひとくぎり": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "ひとくせ": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "ひとくせい": "سرية, كتمان (التكتم في حفظ المعلومات السرية) / خصوصية, سرية (حالة كونه سرياً)\nمثال: يجب عليك احترام سرية اتصالات عميلك",
 "ひとくち": "لُقْمَة / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / بِاخْتِصَار",
 "ひとくちばなし": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "ひとくち話": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "ひとくとっけん": "اِمْتِيَاز",
 "ひとくふう": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "ひとくろう": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد) / سجن مشدد (مدة تُقضى في سجن شديد الحراسة)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "ひとけ": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "ひとげ": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "ひとこえ": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ひとこと": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "ひとこぶらくだ": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "ひとこま": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "ひところ": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひとごえ": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "ひとごこち": "وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي. / رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ひとごころ": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي.",
 "ひとごろし": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ひとさがし": "تَعْبِئَة",
 "ひとさし": "سبابة (الإصبع المجاور للإبهام)",
 "ひとさしゆび": "سبابة (الإصبع المجاور للإبهام)",
 "ひとさま": "آخَرُون",
 "ひとさらい": "اِخْتِطَاف / مُخْتَطِف",
 "ひとさわがせ": "إنذار كاذب (تحذير يُعطى بشأن شيء يفشل في الحدوث)",
 "ひとざいさん": "ثَرْوَة",
 "ひとざと": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "ひとざとはなれた": "وَحِيد, مُوحِش",
 "ひとしい": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل / مُعَادِل",
 "ひとしお": "خُصُوصًا, خَاصَّةً",
 "ひとしきり": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "ひとしく": "بِالتَّسَاوِي",
 "ひとしごと": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ひとしな": "بَنْد / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَبَق (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: هذا الطبق لذيذ.",
 "ひとしばい": "حِيلَة",
 "ひとしれず": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "ひとしれぬ": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひとじち": "رَهِينَة\nمثال: 人質は解放されるだろう。 — سيُفرج عن الرهائن.",
 "ひとじに": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "ひとじらみ": "قملة شائعة (قملة الرأس أو الجسم)",
 "ひとすじ": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "ひとすじしまか": "بعوضة النمر الآسيوية (موطنها اليابان ومخططة، تزدهر في جنوب غرب ووسط غرب الولايات المتحدة وتنتشر إلى منطقة البحر الكاريبي؛ ناقل محتمل لأمراض خطيرة)",
 "ひとすじなわ": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "ひとすみ": "زَاوِيَة, رُكْن",
 "ひとずき": "جاذبية (جاذبية جنسية) / جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ひとそうどう": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ひとそれぞれ": "كل شخص حرّ في ذوقه",
 "ひとたち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "ひとたび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "ひとたまりもなく": "بِسُهُولَة",
 "ひとたらし": "اِحْتِيَال / اِحْتَالَ / مُحْتَال",
 "ひとだかり": "كَوْم",
 "ひとだすけ": "إِحْسَان",
 "ひとだま": "شِهَاب",
 "ひとだまし": "خِدَاع, خَدْع",
 "ひとっこ": "أُقْنُوم / فَرْد",
 "ひとっこひとり": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "ひとっとび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひとっぱしり": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひとっぷろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひとっ走り": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひとっ風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひとっ飛び": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひとつ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "ひとつあな": "عِصَابَة",
 "ひとつあなのむじな": "عِصَابَة",
 "ひとつおき": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "ひとつおきに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "ひとつかみ": "حَفْنَة / جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "ひとつがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ひとつがき": "بَنْد",
 "ひとつき": "طَعْن / طَعْنَة / طَعَنَ",
 "ひとつこころ": "إخلاص, صدق عزيمة (التزام كامل أو حماس غير متحفظ) / إخلاص قلبي, حرارة (صفة الإخلاص القلبي الحار)",
 "ひとつずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつづき": "سِلْسِلَة",
 "ひとつづつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつとして": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ひとつながり": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "ひとつには": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً",
 "ひとつばなし": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "ひとつひとつ": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "ひとつふたつ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "ひとつぼし": "نَجْمَة الْمَسَاء",
 "ひとつまたひとつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつまみ": "قَرَصَ / قَرْصَة",
 "ひとつめ": "أَعْوَر, عَوْرَاء / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "ひとつめかっしゃ": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ひとつめこぞう": "أَعْوَر, عَوْرَاء",
 "ひとつも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ひとつや": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "ひとづき": "سُمْعَة, شُهْرَة",
 "ひとづきあい": "تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "ひとづて": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "ひとづま": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "ひとて": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص. / سَرِيَّة / شَرِكَة",
 "ひとで": "كَوْم / نَجْمَةُ اَلْبَحْرِ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "ひとでなし": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية) / همجي, وحش (شخص قاسي وجشع)",
 "ひととおり": "عُمُومًا / بِوَجْهٍ عَامّ / كُلّ شَيْء / عَادِيّ, مَأْلُوف",
 "ひととき": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "ひととなり": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "ひととび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひととり": "قاعدة الأسرى (لعبة أطفال؛ يقوم فريقان بأسر اللاعبين المعارضين عن طريق لمسهم وأخذهم إلى قاعدتهم الخاصة)",
 "ひとどおり": "حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "ひとなか": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "ひとなかせ": "إِزْعَاج",
 "ひとなつこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ひとなつっこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ひとなで": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "ひとなみ": "تَدَافُع, هَرْج (تزاحمَ وتدافعَ الأشخاصُ في مكانٍ واحدٍ؛ يدافع بمعنى الحماية والدفاع)\nمثال: لا تدافع عن القتلة! / عَادِيّ, مَأْلُوف",
 "ひとなみはずれた": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "ひとなめ": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة / غِلَاف",
 "ひとにぎり": "حَفْنَة / جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "ひとにざる": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "ひとにゅうとうしゅウイルス": "فيروس الورم الحليمي البشري (أي من مجموعة فيروسات بابوفا المرتبطة بالسرطانات التناسلية أو الفموية أو مجموعة مرتبطة بأورام تناسلية حميدة)",
 "ひとねいり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひとねむり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひとのいい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "ひとのくち": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "ひとのこ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / اِبْنُ الإنْسان (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ひとのこといえない": "مَنْ أَنْتَ؟, مَنْ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ひとのつね": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية",
 "ひとのはえをおうよりおのれのはえをおえ": "تَوَخَّى اَلْحِذْر",
 "ひとのみ": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / مَصَّة, رَشْفَة / مَزّ, كَرَع",
 "ひとのみち": "أخلاق, مبدأ أخلاقي (مبادئ الصواب والخطأ التي يقبلها فرد أو مجموعة اجتماعية) / مَبْدَأ أَخْلَاقِيّ (المبدأ القائل بأن السلوك يجب أن يكون أخلاقياً)\nمثال: الأخلاق البيوريتانية",
 "ひとのよい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "ひとはしり": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひとはた": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ひとはだ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ひとはな": "نَجَاح",
 "ひとはら": "مِحَفَّة / بَعْثَرَ / بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "ひとはパンのみにていくるにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "ひとはパンのみにていくるものにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "ひとばしら": "خِنْزِير غِينِيَّا",
 "ひとばん": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひとひ": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ひとひら": "وَرَقَة, وَرَقة / صَحِيفَة",
 "ひとびと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / اَلْجَمِيع, كُلّ شَخْص",
 "ひとふき": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひとふで": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى. / رِزْمَة, رُزْمَة",
 "ひとふろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひとふんばり": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "ひとぼしごろ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ひとまえ": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "ひとまえで": "جهراً, علناً (بطريقة يمكن للجمهور الوصول إليها أو ملاحظتها؛ بصراحة)\nمثال: اعترفت علناً بكونها شيوعية",
 "ひとまく": "مَنْظَر, مَشْهَد / مَشْهَد",
 "ひとまくもの": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "ひとまず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "ひとまとまり": "حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة.",
 "ひとまとめ": "إِبَالَة, حُزْمَة",
 "ひとまね": "مُشَاكهَة",
 "ひとまわり": "دَارَة (لا جمع له)",
 "ひとみ": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひとみごくう": "ضَحِيَّة / أُضْحِيَّة",
 "ひとみしり": "حياء, خجل (شعور بالخوف من الإحراج)",
 "ひとみをこらす": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "ひとむかし": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ひとむかしまえ": "قَدِيماً",
 "ひとむら": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ひとむれ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "ひとめ": "لمحة, نظرة خاطفة (نظرة سريعة) / مَنْظُور عَيْن الْطَائِر / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "ひとめにつかない": "غَيْر مُدْرَك (لم يُدرَك أو يُعلَّق عليه)",
 "ひとめぼれ": "اَلْحُبّ مِن اَلنَّظْرَة اَلْأُولَى\nمثال: 一目惚れなの。 — كان حبًّا من أوّل نظرة.",
 "ひとめもはばからず": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "ひとめんえきふぜんウイルス": "الإيدز, فيروس نقص المناعة البشرية (الفيروس الذي يسبب متلازمة نقص المناعة المكتسب (الإيدز)؛ يتكاثر في الخلايا التائية المساعدة ويقتلها)",
 "ひともしごろ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ひともじ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ひともなげ": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "ひともり": "كَوْم",
 "ひともんちゃく": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "ひとや": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "ひとやく": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "ひとやくかう": "شَارَكَ, سَاهَمَ",
 "ひとやすみ": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "ひとやま": "كَوْم / سَنَام / حَدَبَة, سَنَام / مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ひとやまいくら": "بَخْس الثَّمَن, رَخِيص جِدّاً (رخيص للغاية؛ شبه مجاني) / لُوط",
 "ひとよ": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひとよせ": "جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب) / جاذبية, عنصر جذب (خاصية توفر المتعة وتجذب) / مَعلم ترفيهي, وسيلة جذب (ترفيه يُقدم للجمهور) / عامل جذب, مصدر جذب (فنان ترفيهي يجذب جماهير غفيرة)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ひとよせせき": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "ひとよづま": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ひとより": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "ひとらしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "ひとり": "لوحد / لحال / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ひとりあたり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "ひとりおやかた": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "ひとりおんな": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "ひとりかって": "أَنَانِيّ",
 "ひとりぎめ": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "ひとりごちる": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "ひとりごつ": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "ひとりごと": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "ひとりじめ": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "ひとりずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとりてんぐ": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "ひとりで": "وَحِيد, مُنْفَرِد",
 "ひとりでに": "آلياً, تلقائياً (بطريقة انعكاسية لا إرادية) / تلقائياً, ميكانيكياً (بطريقة ميكانيكية؛ بواسطة آلية)\nمثال: أجاب تلقائياً",
 "ひとりにつき": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "ひとりのこらず": "كُلّ, جَمِيع",
 "ひとりひとり": "كُلّ",
 "ひとりびとり": "كُلّ",
 "ひとりべや": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ひとりぼっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ひとりぽっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ひとりまえ": "بَالِغ, رَاشِد\nمثال: 彼女も一人前の女になった。 — لقد اصبحت امرأة بالغة. / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "ひとりみ": "عزوبية (حالة كون الرجل غير متزوج) / عزوبية (فترة حياة الرجل قبل الزواج)",
 "ひとりも": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとりよう": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً",
 "ひとりよがり": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "ひとりエッチ": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "ひとり占め": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "ひとり残らず": "كُلّ, جَمِيع",
 "ひとり決め": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "ひとり言": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "ひとり部屋": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ひとわたり": "عُمُومًا / بِوَجْهٍ عَامّ",
 "ひとわらわせ": "سَخِيف, مَسْخَرَة",
 "ひとわらわれ": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ひとをくった": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "ひとコマ": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "ひとマネ": "مُشَاكهَة",
 "ひと仕事": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ひと休み": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "ひと先ず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "ひと切り": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "ひと吹き": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひと味": "تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها)",
 "ひと味もふた味も": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "ひと安心": "سَكِينَة, طُمَأْنِينَة",
 "ひと寝入り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひと山": "كَوْم / سَنَام / حَدَبَة, سَنَام / مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ひと工夫": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "ひと度": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "ひと思いに": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "ひと息": "تَوَقَّفَ / تَوَقُّف, وَقْف / قَلِيلًا",
 "ひと悶着": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "ひと抱え": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "ひと昔": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ひと昔前": "قَدِيماً",
 "ひと時": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "ひと晩": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひと暴れ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "ひと条": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "ひと気": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "ひと泡": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "ひと泳ぎ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "ひと目": "لمحة, نظرة خاطفة (نظرة سريعة) / مَنْظُور عَيْن الْطَائِر",
 "ひと眠り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひと筋": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "ひと続き": "سِلْسِلَة",
 "ひと肌": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ひと腹": "مِحَفَّة / بَعْثَرَ / بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "ひと舐め": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة / غِلَاف",
 "ひと苦労": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد) / سجن مشدد (مدة تُقضى في سجن شديد الحراسة)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "ひと荒れ": "مُشْكِلَة, مَتاعِب",
 "ひと言": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "ひと財産": "ثَرْوَة",
 "ひと走り": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひと足先に": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا",
 "ひと踏ん張り": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "ひと雨": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "ひと風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひと飛び": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひと騒動": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ひどい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひどいしうち": "غبن, معاملة مجحفة (معاملة غير عادلة)",
 "ひどい仕打ち": "غبن, معاملة مجحفة (معاملة غير عادلة)",
 "ひどう": "ظَالِم, جَائِر / سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية) / صِيغَة مَجْهُول / مَبْنِي مَجْهُول",
 "ひどうき": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ひどうきしき": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ひどうきてんそうモード": "وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "ひどうしゃ": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "ひどうとくてき": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "ひどうみゃく": "شريان طحالي (شريان ينشأ من الجذع الزلاقي ويغذي الطحال بالدم)",
 "ひどうめい": "عدم الانحياز (شعب (أو دول) غير متحالفين مع آخرين في حلف أو معاهدة)",
 "ひどく": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة)\nمثال: مثير للاهتمام جداً",
 "ひどけい": "مِزْوَلَة",
 "ひどすぎる": "صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "ひどの": "مِرْحَاض, تواليت",
 "ひな": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير. / طائر صغير, فرخ طائر (طائر لا يزال صغيراً)",
 "ひなうた": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "ひなか": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "ひなかんべつし": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "ひながた": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "ひなぎく": "أُقْحُوَان",
 "ひなげし": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "ひなさき": "بَظْر",
 "ひなたくさい": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق",
 "ひなたぼっこ": "حَمَّام شَمْس (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ひなつぼし": "الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت.",
 "ひなどり": "صُوص, فَرُّوج / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "ひなびた": "رَيْفِيّ, قَرَوِيّ",
 "ひなびと": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد)",
 "ひなべ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "ひなゆり": "كاماسيا شرقية, ياقوتية برية (كاماسيا شرقية؛ شرق ووسط أمريكا الشمالية) / جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "ひならず": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "ひならずして": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "ひなわ": "فَتِيل / مُنْصَهِرَة, مصهر",
 "ひなわじゅう": "بندقية فتيل (طراز مبكر من المسكيت؛ كان يتم إنزال فتيل بطيء الاحتراق في ثقب في المؤخرة لإشعال الشحنة)",
 "ひなん": "نَقْد, اِنْتِقَاد / إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "ひなんかいだん": "مخرج طوارئ",
 "ひなんがましい": "تَأْدِيبِيّ, عَتَابِيّ (يُعَبِّر عَنِ التَّوْبِيخ أَوِ اللَّوْم خَاصَّةً بِغَرَض التَّصْحِيح)",
 "ひなんぐち": "كوة نجاة, مخرج طوارئ (فتحة توفر وسيلة للهروب في حالات الطوارئ)",
 "ひなんしゃ": "مُرَحَّل",
 "ひなんじょ": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "ひなんち": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "ひなんはしご": "مخرج طوارئ",
 "ひなんば": "مَلْجَأ, مَلَاذ",
 "ひなんばしご": "مخرج طوارئ",
 "ひなんみん": "مُرَحَّل",
 "ひなんゆうどうとう": "مخرج طوارئ",
 "ひなんをあびせる": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひな型": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "ひな形": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "ひな菊": "أُقْحُوَان",
 "ひな鑑別師": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "ひな鳥": "صُوص, فَرُّوج / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "ひにあぶらをそそぐ": "صَبَّ اَلزَّيْت عَلَى اَلنَّار, زَادَ اَلنَّار حَطَباً (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "ひにく": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء / مُفَاجِئ / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "ひにくなことに": "بتهكم, بسخرية (بطريقة ساخرة) / للمفارقة, من السخرية أن (على عكس الخطة أو التوقع)\nمثال: بدأت بتقليده بسخرية",
 "ひにくや": "ساخر, متهكم (فكاهي يستخدم السخرية والتهكم والغمز لانتقاد الرذائل أو الحماقات)",
 "ひにくる": "هجا",
 "ひにけに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ひにち": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام",
 "ひにちじょう": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひにちじょうせい": "اسْتِثْنَائِيَّة, غَرَابَة (صفة كون الشيء استثنائياً وغير مألوف)",
 "ひにちじょうてき": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひにひに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم / يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "ひにゅう": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي) / إدرار الحليب, رضاعة (إنتاج وإفراز الحليب بواسطة الغدد الثديية) / رضاعة, فترة الرضاعة (الفترة التي تلي الولادة والتي يتم خلالها إفراز الحليب)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "ひにょう": "تبول (إخراج البول)",
 "ひにょうき": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "ひにょうきか": "طب المسالك البولية (فرع الطب الذي يتعامل مع تشخيص وعلاج اضطرابات المسالك البولية أو الجهاز البولي التناسلي)",
 "ひにょうきかい": "طبيب مسالك بولية (أخصائي في طب المسالك البولية)",
 "ひにょうきかがく": "طب المسالك البولية (فرع الطب الذي يتعامل مع تشخيص وعلاج اضطرابات المسالك البولية أو الجهاز البولي التناسلي)",
 "ひにん": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد. / منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "ひにんぐ": "مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "ひにんげんか": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "ひにんげんてき": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひにんじょう": "عديم الرحمة, قاسي القلب (يفتقر إلى الشعور أو الشفقة أو الدفء) / فَاقِدُ الشَّجَاعَة (خالٍ من الشجاعة أو الحماس)",
 "ひにんほう": "منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "ひにんめいしゃ": "مُعَيَّن (شخص تم تعيينه في وظيفة أو منصب) / معيّن (مسؤول يتم تعيينه)",
 "ひにんやく": "مَانِع لِلْحَمْل (قادر على منع الحمل أو الإخصاب) / مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "ひにんピル": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "ひにんリング": "لولب رحمي (جهاز لمنع الحمل يتكون من قطعة من البلاستيك أو المعدن المثني يتم إدخالها عبر المهبل إلى الرحم)",
 "ひねくさい": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "ひねくりまわす": "لَوَى, بَرَمَ / إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "ひねくり回す": "لَوَى, بَرَمَ / إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "ひねくる": "برم, دوران سريع (عملية الدوران بسرعة) / التواء, عقدة (انحناء حاد في خط ناتج عن سحب خط به حلقة بقوة)\nمثال: أدار الكرنك بقوة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "ひねくれもの": "عبوس, متجهم (شخص ذو تعبير وجه كئيب أو عابس بشكل معتاد)",
 "ひねくれる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "ひねくれ者": "عبوس, متجهم (شخص ذو تعبير وجه كئيب أو عابس بشكل معتاد)",
 "ひねつ": "حرارة نوعية (الحرارة اللازمة لرفع درجة حرارة جرام واحد من مادة ما درجة مئوية واحدة)",
 "ひねつしょり": "غير مبستر (لم يخضع للبسترة)",
 "ひねり": "لَوَى, بَرَمَ / براعة, ذكاء (خاصية كون الشخص بارعاً) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "ひねりだす": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "ひねり出す": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "ひねる": "لَوَى, بَرَمَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ひのいり": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "ひのうちどころ": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "ひのうちどころがない": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "ひのうちどころのない": "مَعْصُوم, كَامِل / مَعْصُوم",
 "ひのうりつ": "عدم كفاءة (نقص المهارة الناتج عن نقص الكفاءة)",
 "ひのうるい": "حبلي الذيل, غلالية (حيوان بحري بدائي له جسم يشبه الكيس غير مقسم وحبل ذيلي يكون واضحاً في اليرقة)",
 "ひのきぶたい": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひのき舞台": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひのくに": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "ひのくるま": "ضائقة شديدة, ظروف يائسة (حالة من الضيق الشديد)",
 "ひのけ": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "ひのこ": "شَرَارَة",
 "ひのせい": "سَمَنْدَل",
 "ひのたま": "كُرَة نَارِيَّة / سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "ひのて": "لَهَب, شُعْلَة / حَمْلَة / هَاجَمَ",
 "ひので": "شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "ひのとり": "فِينِيكْس, فُقْنُس",
 "ひのばん": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "ひのべ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "ひのまる": "علم وطني (شعار يُرفع كرمز للجنسية) / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "ひのまるのはた": "علم وطني (شعار يُرفع كرمز للجنسية)",
 "ひのみ": "برج مراقبة الحرائق (برج مراقبة حيث يتمركز حارس لمراقبة نشوب الحرائق)",
 "ひのみこ": "قَيْصَر, إِمْبْرَاطُور / وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ひのみやぐら": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ひのめ": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "ひのもと": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "ひはい": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد)",
 "ひはいぐうしゃかんじんこうじゅせい": "تلقيح صناعي (إدخال السائل المنوي إلى قناة فالوب أو الرحم بوسيلة غير الجماع الجنسي)",
 "ひはいすい": "غير مُجفف, غير مُصرَّف (لم يتم تصريف محتواه)\nمثال: الحفاظ على الأراضي الرطبة: إبقاؤها غير مجففة",
 "ひはし": "مزراب (جرغول) (زخرفة تتكون من شكل منحوت بشكل غريب لشخص أو حيوان) / جرغول, مزراب (فوهة تنتهي بشكل تمثال بشري أو حيواني منحوت بشكل غريب)",
 "ひはん": "نَقْد, اِنْتِقَاد / سِمْنَة, بَدَانَة",
 "ひはんしゃ": "نَقَّاد, نَاقِد / ناقد",
 "ひはんてき": "النقد",
 "ひはんてきしこう": "تَفْكِير نَقْدِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "ひはんりょく": "تَفْكِير نَقْدِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "ひばいどうめい": "قَاطَعَ / مُقَاطَعَة",
 "ひばくしゃえんごほう": "قُنْبُلَة ذَرِّيَّة",
 "ひばくち": "موقع قصف (منطقة في بلدة دمرتها القنابل)\nمثال: افتتحوا موقف سيارات في موقع القصف",
 "ひばご": "تَقْرِيع, سِبَاب (لغة مسيئة أو سامة تستخدم للتعبير عن اللوم أو الاستهجان أو الضغينة العميقة)",
 "ひばさみ": "ملقط فحم, ملقط نار (ملقط للإمساك بالفحم المشتعل)",
 "ひばし": "ملقط فحم, ملقط نار (ملقط للإمساك بالفحم المشتعل)",
 "ひばち": "مَجْمَرَة, مَنْقَل",
 "ひばな": "شَرَارَة",
 "ひばなをちらす": "شَرَارَة",
 "ひばら": "طِحَال",
 "ひばり": "قُبَّرَة",
 "ひひ": "رُبَّاح, بَابُون / شهواني, فاسق (رجل لديه رغبات جنسية قوية) / كُلّ, جَمِيع",
 "ひひいん": "صَهِيل / صَهَلَ (صَهَلَ: (فعل)صهَلَ يَصهَل ويَصهِل ، صَهيلاً وصُهالاً ، فهو صاهِل صَهَلَ الْفَرَسُ : صَوَّتَ؛ ل. (فعل: ثلاثي لازم). صَهَلَ، يَصْهَلُ، مصدر صُهَالٌ، صَهِيلٌ.صَهَلَ الْفَرَسُ :صَوَّتَ)",
 "ひひひ": "إِهْلَاس",
 "ひひひひ": "إِهْلَاس",
 "ひひょう": "نَقْد, اِنْتِقَاد",
 "ひひょうか": "نَقَّاد, نَاقِد / ناقد",
 "ひひょうじ": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "ひひらく": "صَهِيل / صَهَلَ (صَهَلَ: (فعل)صهَلَ يَصهَل ويَصهِل ، صَهيلاً وصُهالاً ، فهو صاهِل صَهَلَ الْفَرَسُ : صَوَّتَ؛ ل. (فعل: ثلاثي لازم). صَهَلَ، يَصْهَلُ، مصدر صُهَالٌ، صَهِيلٌ.صَهَلَ الْفَرَسُ :صَوَّتَ)",
 "ひび": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة)) / شق صخري, صدع (شق ضيق في الصخر) / انفراج, فجوة (فجوة بين كتل السحب)\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات / يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم / شَاب, رَجُل",
 "ひびがきれる": "شَاب, رَجُل",
 "ひびがはいる": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひびが入る": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひびが切れる": "شَاب, رَجُل",
 "ひびき": "صَدًى / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ひびきわたる": "صَدًى",
 "ひびく": "هَزَّ / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "ひびのきれた": "مُشَقَّق",
 "ひびの切れた": "مُشَقَّق",
 "ひびやき": "خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح)",
 "ひびわれ": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひびわれる": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひび割れ": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひび割れる": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひび焼き": "خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح)",
 "ひふ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ひふいしょく": "طُعْم جِلْدِيّ (قطعة جلد تؤخذ من منطقة مانحة وتزرع جراحياً في موقع إصابة أو حرق)",
 "ひふえん": "التهاب الجلد (التهاب يصيب الجلد؛ يصبح الجلد مثيرًا للحكة وقد تتكون فيه بثور)",
 "ひふか": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ひふかい": "أخصائي أمراض جلدية, طبيب جلدية (طبيب متخصص في فسيولوجيا وأمراض الجلد)",
 "ひふかがく": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ひふかんかく": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "ひふがん": "سَرَطَان اَلْجِلْد",
 "ひふきんえん": "التهاب الجلد والعضلات (التهاب عضلات يتميز بضعف عضلات الأطراف والرقبة والكثير من آلام العضلات والتورم المصاحب لطفح جلدي يؤثر على الخدين والجفون والرقبة والصدر والأطراف)",
 "ひふく": "مَلَابِس, ثِيَاب / تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود / غِطَاء / غِلَاف / غَطَّى",
 "ひふくきん": "عضلة الساق التوأمية (العضلة الموجودة في الجزء الخلفي من الساق التي تشكل الجزء الأكبر من ربلة الساق؛ مسؤولة عن الثني الأخمصي للقدم)",
 "ひふくけい": "مورفيم مقيد",
 "ひふくさくもつ": "محصول تغطية (محصول يُزرع لمنع تآكل التربة وتوفير السماد الأخضر)",
 "ひふこうかしょう": "تصلب الجلد (مرض مناعي ذاتي يصيب الأوعية الدموية والنسيج الضام)",
 "ひふしんきんしょう": "فطار جلدي (عدوى فطرية في الجلد (خاصة في الأجزاء الرطبة المغطاة بالملابس))",
 "ひふせいすう": "عَدَد صَحِيح (أي من الأعداد الطبيعية (الموجبة أو السالبة) أو الصفر)\nمثال: العدد الصحيح هو عدد ليس كسراً",
 "ひふたんそ": "جمرة خبيثة جلدية (شكل من أشكال عدوى الجمرة الخبيثة يبدأ كحطاطة تصبح حويصلة وتنفجر مع إفراز سموم)",
 "ひふびょう": "مرض جلدي (مرض يصيب الجلد)",
 "ひふぶんせつ": "مبضع الجلد (أداة جراحية تستخدم لقطع شرائح رقيقة جداً من الجلد)",
 "ひふべん": "رَفْرَف",
 "ひふもんり": "علم بصمات الأصابع (دراسة الدوائر والحلقات والأقواس في أطراف الأصابع وراحة اليد وباطن القدمين)\nمثال: بعض علماء الإجرام يتخصصون في علم بصمات الأصابع",
 "ひふようしゃ": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "ひふん": "استنكار, سخط (شعور بالغضب المحق)",
 "ひぶ": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "ひぶくれ": "بَطْبَاطَة, نَفْطَة",
 "ひぶそう": "أَعْزَل",
 "ひぶそうちたい": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "ひぶたがきられる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "ひぶたをきる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "ひぶね": "سفينة حارقة (سلاح يتكون من سفينة تحمل متفجرات تُترك لتنجرف لتدمير سفن العدو)",
 "ひぶん": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "ひぶんがく": "علم النقوش (دراسة النقوش القديمة)",
 "ひへい": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد) / إفقار (فعل جعل شخص ما فقيراً) / عوز, فقر (حالة امتلاك القليل من المال أو عدم امتلاكه وقلة الممتلكات المادية)",
 "ひべつ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "ひべん": "رَفْرَف",
 "ひほ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "ひほけんしゃ": "مُؤمَّن عليه (شخص تحميه بوليصة تأمين؛ شخص يتعاقد على بوليصة تأمين تعوضه عن خسارة الممتلكات أو الحياة أو الصحة، إلخ)",
 "ひほごこく": "الحِمَايَة",
 "ひほごしゃ": "جَنَاح",
 "ひぼう": "تَشْهِير, اِفْتِرَاء",
 "ひぼうちゅうしょう": "تَشْهِير, اِفْتِرَاء",
 "ひぼうりょく": "لاعنف",
 "ひぼうりょくていこう": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "ひぼうりょくふふくじゅう": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "ひぼし": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع. / مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "ひぼん": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひぼんじん": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "ひま": "خِرْوَع, تَنُّوم / وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها) / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / إجازة, وقت راحة (فترة زمنية لا يُطلب منك العمل فيها)\nمثال: طلب إجازة لحضور جنازة جدته / إِقَالَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "ひまがない": "مَشْغُول",
 "ひまく": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود / كَبْسُولة / غِطَايَة, غشاوة / فِلْم, فيلم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي»)\nمثال: استمر الفلم ساعتين.",
 "ひまし": "الخروع",
 "ひましに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ひましゆ": "زيت الخروع (مسهل يستخرج من بذور نبات الخروع؛ يستخدم في الطلاء والورنيش وكذلك طبياً)",
 "ひまし油": "زيت الخروع (مسهل يستخرج من بذور نبات الخروع؛ يستخدم في الطلاء والورنيش وكذلك طبياً)",
 "ひまじん": "عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "ひまつ": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / قُطَيْرَة",
 "ひまつぶし": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "ひまつり": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ひまなとき": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "ひまねた": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "ひまわりあぶら": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "ひまわりゆ": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "ひまわり油": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "ひまをだす": "طَرَدَ, أَقَالَ",
 "ひまをつぶす": "ضَيَّعَ اَلْوَقْت",
 "ひまをやる": "طَرَدَ, أَقَالَ",
 "ひまん": "بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "ひまんさいぼう": "خَلِيَّة بَدِينَة, خَلِيَّة صَارِيَّة",
 "ひまんしょう": "سِمْنَة, بَدَانَة",
 "ひみず": "ماء مثلج (ماء يُقدم بارداً جداً أو مع الثلج)\nمثال: 私はビニール袋にワインを注ぎ、それからそれを氷水に付けた。 — سكبت النبيذ في كيس و بعدها غمسته في مياه مجمدة.",
 "ひみつ": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "ひみつかい": "خَلْفَ أَبْوَاب مُغْلَقَة (غير مفتوح للعامّة)",
 "ひみつきち": "مخبأ سري, وكر (مكان للاختباء؛ عادة مكان ناءٍ يستخدمه الخارجون عن القانون)",
 "ひみつけいさつ": "بُولِيس سِرِّيّ",
