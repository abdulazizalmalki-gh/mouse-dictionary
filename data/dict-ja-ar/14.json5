{
 "ひっきようぐ": "أداة كتابة (أداة تستخدم للكتابة)",
 "ひっきりなし": "مُتَوَاصِل, مُتَّصِل",
 "ひっきりなしに": "باستمرار",
 "ひっくい": "حَزين / خافِت, مُنْخَفِض / قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / عَمِيق, غَوِيط",
 "ひっくくる": "إِبَالَة, حُزْمَة",
 "ひっくりかえす": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくりかえる": "قَلَبَ",
 "ひっくりがえす": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくりがえる": "قَلَبَ",
 "ひっくり返す": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくり返る": "قَلَبَ",
 "ひっくるめて": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "ひっけい": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة / دَلِيل, كُتَيِّب",
 "ひっけいひん": "ضَرُورَة, حَاجَة",
 "ひっけん": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "ひっこし": "مُتَحَرِّك / مُؤَثِّر",
 "ひっこしいわい": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "ひっこしや": "شركة نقل, شركة نقل أثاث (شركة تقوم بنقل ممتلكات عائلة أو شركة من موقع إلى آخر) / متحرك (شخص يتحرك) / عامل نقل أثاث (عامل توظفه شركة نقل) / مقدم الاقتراح, مُقْتَرِح ((في الإجراءات البرلمانية) شخص يقدم اقتراحاً رسمياً)\nمثال: كان عمال النقل حريصين جداً مع البيانو الكبير",
 "ひっこす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "ひっこぬく": "مُقْتَطَف / خلاصة",
 "ひっこみ": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "ひっこみじあん": "مَحْجُوز",
 "ひっこむ": "غَطَسَ / مَجْلَى, مَغْسَلَة / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "ひっこめる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "ひっさげる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "ひっさつ": "مُمِيت / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ひっさらう": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "ひっし": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه) / حَتْمِيّ",
 "ひっしになって": "بإلحاح, بشكل عاجل (بإلحاح شديد) / باستماتة, بيأس (بيأس شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "ひっしゃ": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب. / نسخ (فعل النسخ)",
 "ひっしゅ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっしゅう": "إِجْبَارِيّ, إِلْزَامِيّ (مطلوب بموجب قاعدة أو نظام) / لَازِم, مَطْلُوب (ضروري للإغاثة أو الإمداد)",
 "ひっしょうふはい": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "ひっす": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっすう": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっすじょうけん": "أمر لا غنى عنه, شرط أساسي (شرط مسبق لا يمكن الاستغناء عنه)",
 "ひっする": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "ひっすアミノさん": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "ひっせい": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات) / أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة) / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "ひっせき": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم) / مخطوطة (كتاب أو وثيقة مكتوبة بخط اليد)",
 "ひっせきがく": "جرافولوجي, علم الخط (دراسة خط اليد (خاصة كمؤشر على شخصية الكاتب أو مزاجه))",
 "ひっそく": "إِقَامَة جَبْرِيَّة",
 "ひっそり": "صَامِت, هَادِئ / خلسة, دون لفت للانتباه (بطريقة تهدف إلى تجنب جذب الانتباه)\nمثال: دخل الغرفة دون لفت للانتباه",
 "ひっそりかん": "بِهُدُوء",
 "ひっそり閑": "بِهُدُوء",
 "ひったくる": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "ひったん": "أسلوب الكتابة, نوع أدبي (نمط للتعبير عن النفس في الكتابة)",
 "ひっち": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "ひっちゃかめっちゃか": "فَوْضَوِيّ",
 "ひっちゅう": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل",
 "ひっつかまえる": "إِسْتَوْلَى عَلَى",
 "ひっつかむ": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "ひっつきむし": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "ひっつき虫": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "ひっつく": "تَزَوَّجَ",
 "ひっつける": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "ひっつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "ひっつれる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ひってき": "مُنَافِس",
 "ひっとう": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "ひっとらえる": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっぱく": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة) / خسة, شح (بخل شديد) / اِكْتِظَاظ, تَرْكِيز (الخاصية المكانية للازدحام أو التكدس معاً) / انقباض, ضيق (شعور بالضيق في جزء من الجسم)\nمثال: شعر بانقباض في صدرها",
 "ひっぱたく": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "ひっぱり": "جر, سحب (فعل السحب؛ تطبيق قوة لتحريك شيء تجاهك أو معك)\nمثال: جعله السحب لأعلى التل يتنفس بصعوبة",
 "ひっぱりぎみ": "مَتِين, مَشْدُود (مَسْحُوبٌ أَوْ مَمْدُودٌ بِإِحْكَام) / مُتَوَتِّرٌ بِشِدَّة (مُعَرَّضٌ لِتَوَتُّرٍ شَدِيدٍ؛ مَشْدُودٌ بِإِحْكَام)",
 "ひっぱりだす": "أَخْرَجَ",
 "ひっぱりつよさ": "قوة الشد (قوة المادة معبراً عنها كأكبر إجهاد طولي يمكن أن تتحمله دون أن تتمزق)",
 "ひっぱりづよさ": "قوة الشد (قوة المادة معبراً عنها كأكبر إجهاد طولي يمكن أن تتحمله دون أن تتمزق)",
 "ひっぱる": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "ひっぷ": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ひっ捕える": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっ捕まえる": "إِسْتَوْلَى عَلَى",
 "ひっ捕らえる": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっ迫": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة) / خسة, شح (بخل شديد) / اِكْتِظَاظ, تَرْكِيز (الخاصية المكانية للازدحام أو التكدس معاً) / انقباض, ضيق (شعور بالضيق في جزء من الجسم)\nمثال: شعر بانقباض في صدرها",
 "ひつ": "فُرْشَاة الطِلَاء / الخط, فن الخط (الكتابة اليدوية الجميلة) / لُوط / خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / تَحْدِيد, قَطْعِيَّة (صفة القابلية للتنبؤ بثقة كبيرة)",
 "ひつい": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "ひつう": "غَمّ, حُزْن",
 "ひつかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "ひつぎ": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "ひつぎのみこ": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ひつぐう": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ひつけ": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ひつけやく": "مُحَرِّض, مُحَرِّضَة",
 "ひつじ": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛ / باتجاه الجنوب الجنوب الغربي (إلى أو نحو أو في الجنوب الجنوب الغربي)",
 "ひつじかい": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "ひつじがわ": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "ひつじぐも": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "ひつじごや": "حظيرة أغنام, زريبة غنم (حظيرة للأغنام)",
 "ひつじさる": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة)",
 "ひつじゅ": "ضَرُورِيّ, لَازِم",
 "ひつじゅひん": "ضَرُورَة, حَاجَة",
 "ひつじょう": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك) / بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: هو كذلك بالضرورة",
 "ひつじ雲": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "ひつぜつ": "وَصْف, تَوْصِيف",
 "ひつぜん": "حَتْمِيّ / حَتْمِيَّة, وُجُوب (صفة كون الشيء غير قابل للتجنب)",
 "ひつぜんせい": "ضَرُورَة, حَاجَة",
 "ひつぜんてき": "حَتْمِيّ",
 "ひつにゅう": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي) / إدرار الحليب, رضاعة (إنتاج وإفراز الحليب بواسطة الغدد الثديية) / رضاعة, فترة الرضاعة (الفترة التي تلي الولادة والتي يتم خلالها إفراز الحليب)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "ひつにゅうりょう": "إدرار الحليب, محصول الحليب (كمية الحليب التي تنتجها البقرة)\nمثال: الموسيقى الهادئة يمكن أن تحسن إدرار الحليب",
 "ひつにょう": "تبول (إخراج البول)",
 "ひつにょうき": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "ひつび": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひつぼく": "قِرْطَاسِيَّة",
 "ひつめい": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "ひつめつ": "فناء, موت (الجودة أو الحالة المتمثلة في كونه فانياً) / مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "ひつよう": "ضَرُورِيّ, لَازِم / ضَرُورَة, حَاجَة",
 "ひつようご": "كلمة مفتاحية (كلمة مهمة تستخدم في الفهرسة أو التصنيف) / كلمة مفتاحية (كلمة تستخدم كنمط لفك تشفير رسالة مشفرة)",
 "ひつようじ": "ضَرُورَة, حَاجَة",
 "ひつようじょうけん": "شَرْط ضَرُورِيّ (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "ひつようせい": "ضَرُورَة, حَاجَة",
 "ひつようとする": "حَاجَة, ضَرُورَة / اِحْتَاجَ\nمثال: とりわけ子供たちは愛情を必要とする。 — و فوق كل شيء، يحتاج الأطفال إلى الحب.",
 "ひつようない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひつようははつめいのはは": "اَلْحَاجَة أَمّ اَلاِخْتِرَاع",
 "ひつようひん": "ضَرُورَة, حَاجَة",
 "ひつようふかけつ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひつようぶつ": "ضَرُورَة, حَاجَة",
 "ひつろく": "تدوين, سجل مكتوب (وثيقة مكتوبة تحفظ المعرفة بوقائع أو أحداث)",
 "ひづくり": "تطريق, حدادة (تشكيل المعدن عن طريق التسخين والطرق)",
 "ひづけ": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "ひづめ": "حافِر, ظِلْف",
 "ひてい": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد. / إِنْكَار / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "ひていけい": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر. / غَيْر مُنْتَظِم, لَا نَمَطِيّ (ينحرف عن التوقعات الطبيعية؛ غريب أو شاذ بعض الشيء) / شاذ, غير نمطي (لا يمثل مجموعة أو فئة أو نوعًا)\nمثال: فئة من الطحالب غير النموذجية",
 "ひていけいどうし": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "ひていけいはいえん": "التهاب رئوي لانمطي (مرض تنفسي حاد يتميز بحمى عالية وسعال)",
 "ひていこう": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "ひていてき": "سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة",
 "ひてきしゅつし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "ひてきよう": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ひてんしゅうさ": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "ひでぇ": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひでえ": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひでり": "جَفَاف",
 "ひでん": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひでんか": "أَمِيرَة",
 "ひでー": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひと": "قَاطِع طَرِيق / أُقْنُوم / فَرْد / بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب / بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق. / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ) / إنفاق, صرف (عملية إنفاق أو صرف المال) / إنفاق, مصروفات (أموال مدفوعة؛ مبلغ تم إنفاقه) / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "ひとあし": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "ひとあしさきに": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا",
 "ひとあじ": "تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها)",
 "ひとあじもふたあじも": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "ひとあたり": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "ひとあたりがいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりがよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりのいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりのよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあつめ": "جمهور, حشد كبير (تجمع كبير للناس)",
 "ひとあばれ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "ひとあめ": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "ひとあれ": "مُشْكِلَة, مَتاعِب",
 "ひとあわ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "ひとあわふかせる": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "ひとあんしん": "سَكِينَة, طُمَأْنِينَة",
 "ひといき": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "ひといきれ": "ثقل دم, جمود (وقار ممل ومتغطرس) / انعدام التهوية, كتمة (صفة انحباس الهواء وسوء التهوية) / انسداد (حالة انسداد أو توقف الهواء في الأنف أو الحلق)",
 "ひといちばい": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "ひとう": "غَيْر مَعْرُوف لِلْأَغْلَبِيَّة, قَلِيل الشُّهْرَة (غير معروف لمعظم الناس) / الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر الفلبين، أرخبيل في جنوب شرق قارة آسيا يمثل أساس جمهورية الفلبين)\nمثال: الفلبين بلد كاثوليكي أساسا.",
 "ひとうけ": "شَعْبِيَّة",
 "ひとうり": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19) / تاجر رقيق (شخص يعمل في تجارة الرقيق)",
 "ひとえつぎ": "عقدة الشراع, عقدة النساج (عقدة تستخدم لربط حبل مؤقتاً بمنتصف حبل آخر)",
 "ひとえに": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "ひとおし": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "ひとおもいに": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "ひとおよぎ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "ひとかい": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19)",
 "ひとかかえ": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "ひとかけら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / خرقة, رقعة (قطعة صغيرة من القماش) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "ひとかげ": "سَمَنْدَل",
 "ひとかさね": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "ひとかず": "بَالِغ, رَاشِد",
 "ひとかせぎ": "كَسَبَ",
 "ひとかた": "عَادِيّ, مَأْلُوف",
 "ひとかたならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "ひとかたならぬ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひとかど": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "ひとかどのじんぶつ": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどのにんげん": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどの人物": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどの人間": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかまえ": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة)) / تجمع, حزمة (تجمع لعدد من الأشياء المتشابهة) / تكتل, كتلة (كتلة متماسكة)\nمثال: مجموعة من الأشجار",
 "ひとかわ": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ひとかわむける": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "ひとがいい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "ひとがしら": "جُمْجُمَة",
 "ひとがたロボット": "أَنْدْرُويِد",
 "ひとがましい": "مُحْتَرَم",
 "ひとがよい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "ひとがら": "شَخْصِيَّة",
 "ひとがわるい": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "ひときざみ": "فَائِق, مُمْتَاز (من أعلى مستويات الجودة)",
 "ひときり": "تَوَقَّفَ / تَوَقُّف, وَقْف / اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب سياسية أو لمنافع شخصية)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "ひときれ": "شريحة / قَطَّعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "ひときわ": "بشكل بارز, بوضوح (بطريقة بارزة) / بشكل لافت, بوضوح تام (بطريقة تميل إلى جذب الانتباه)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر",
 "ひとぎき": "سُمْعَة, شُهْرَة",
 "ひとぎきのわるい": "سيء السمعة (يفتقر للاحترام في الشخصية أو السلوك أو المظهر)",
 "ひとぎらい": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "ひとく": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / اختباء (حالة الاختباء)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "ひとくい": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "ひとくいうま": "عَاضّ (شخص يقوم بالعض)",
 "ひとくいざめ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "ひとくいじんしゅ": "غُول, آكِلُ لُحُوم البَشْر",
 "ひとくいせい": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "ひとくいてき": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "ひとくいザメ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "ひとくぎり": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "ひとくせ": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "ひとくせい": "سرية, كتمان (التكتم في حفظ المعلومات السرية) / خصوصية, سرية (حالة كونه سرياً)\nمثال: يجب عليك احترام سرية اتصالات عميلك",
 "ひとくち": "لُقْمَة / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / بِاخْتِصَار",
 "ひとくちばなし": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "ひとくち話": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "ひとくとっけん": "اِمْتِيَاز",
 "ひとくろう": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد) / سجن مشدد (مدة تُقضى في سجن شديد الحراسة)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "ひとけ": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "ひとげ": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "ひとこえ": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ひとこぶらくだ": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "ひとこま": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "ひところ": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひとごえ": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "ひとごこち": "وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي. / رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ひとごころ": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي.",
 "ひとごろし": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ひとさがし": "تَعْبِئَة",
 "ひとさし": "سبابة (الإصبع المجاور للإبهام)",
 "ひとさしゆび": "سبابة (الإصبع المجاور للإبهام)",
 "ひとさま": "آخَرُون",
 "ひとさらい": "اِخْتِطَاف / مُخْتَطِف",
 "ひとさわがせ": "إنذار كاذب (تحذير يُعطى بشأن شيء يفشل في الحدوث)",
 "ひとざいさん": "ثَرْوَة",
 "ひとざと": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "ひとざとはなれた": "وَحِيد, مُوحِش",
 "ひとしい": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل / مُعَادِل",
 "ひとしお": "خُصُوصًا, خَاصَّةً",
 "ひとしきり": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "ひとしく": "بِالتَّسَاوِي",
 "ひとしごと": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ひとしな": "بَنْد / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَبَق (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: هذا الطبق لذيذ.",
 "ひとしばい": "حِيلَة",
 "ひとしれず": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "ひとしれぬ": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ひとじち": "رَهِينَة\nمثال: 人質は解放されるだろう。 — سيُفرج عن الرهائن.",
 "ひとじに": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "ひとじらみ": "قملة شائعة (قملة الرأس أو الجسم)",
 "ひとすじ": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "ひとすじしまか": "بعوضة النمر الآسيوية (موطنها اليابان ومخططة، تزدهر في جنوب غرب ووسط غرب الولايات المتحدة وتنتشر إلى منطقة البحر الكاريبي؛ ناقل محتمل لأمراض خطيرة)",
 "ひとすじなわ": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "ひとすみ": "زَاوِيَة, رُكْن",
 "ひとずき": "جاذبية (جاذبية جنسية) / جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ひとそうどう": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ひとそれぞれ": "كل شخص حرّ في ذوقه",
 "ひとたち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "ひとたび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "ひとたまりもなく": "بِسُهُولَة",
 "ひとたらし": "اِحْتِيَال / اِحْتَالَ / مُحْتَال",
 "ひとだかり": "كَوْم",
 "ひとだすけ": "إِحْسَان",
 "ひとだま": "شِهَاب",
 "ひとだまし": "خِدَاع, خَدْع",
 "ひとっこ": "أُقْنُوم / فَرْد",
 "ひとっこひとり": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "ひとっとび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひとっぱしり": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひとっぷろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひとっ走り": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひとっ風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひとっ飛び": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひとつ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ひとつあな": "عِصَابَة",
 "ひとつあなのむじな": "عِصَابَة",
 "ひとつおき": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "ひとつおきに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "ひとつかみ": "حَفْنَة / جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "ひとつがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ひとつがき": "بَنْد",
 "ひとつき": "طَعْن / طَعْنَة / طَعَنَ",
 "ひとつこころ": "إخلاص, صدق عزيمة (التزام كامل أو حماس غير متحفظ) / إخلاص قلبي, حرارة (صفة الإخلاص القلبي الحار)",
 "ひとつずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつづき": "سِلْسِلَة",
 "ひとつづつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつとして": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ひとつながり": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "ひとつばなし": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "ひとつひとつ": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "ひとつふたつ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "ひとつぼし": "نَجْمَة الْمَسَاء",
 "ひとつまたひとつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつまみ": "قَرَصَ / قَرْصَة",
 "ひとつめ": "أَعْوَر, عَوْرَاء / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "ひとつめかっしゃ": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ひとつめこぞう": "أَعْوَر, عَوْرَاء",
 "ひとつも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ひとつや": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "ひとづき": "سُمْعَة, شُهْرَة",
 "ひとづきあい": "تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "ひとづて": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "ひとづま": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "ひとて": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص. / سَرِيَّة / شَرِكَة",
 "ひとで": "كَوْم / نَجْمَةُ اَلْبَحْرِ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "ひとでなし": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية) / همجي, وحش (شخص قاسي وجشع)",
 "ひととおり": "عُمُومًا / بِوَجْهٍ عَامّ / كُلّ شَيْء / عَادِيّ, مَأْلُوف",
 "ひととき": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "ひととなり": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "ひととび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひととり": "قاعدة الأسرى (لعبة أطفال؛ يقوم فريقان بأسر اللاعبين المعارضين عن طريق لمسهم وأخذهم إلى قاعدتهم الخاصة)",
 "ひとどおり": "حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "ひとなか": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "ひとなかせ": "إِزْعَاج",
 "ひとなつこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ひとなつっこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ひとなで": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "ひとなみ": "تَدَافُع, هَرْج (تزاحمَ وتدافعَ الأشخاصُ في مكانٍ واحدٍ؛ يدافع بمعنى الحماية والدفاع)\nمثال: لا تدافع عن القتلة! / عَادِيّ, مَأْلُوف",
 "ひとなみはずれた": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "ひとなめ": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة / غِلَاف",
 "ひとにぎり": "حَفْنَة / جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "ひとにざる": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "ひとにゅうとうしゅウイルス": "فيروس الورم الحليمي البشري (أي من مجموعة فيروسات بابوفا المرتبطة بالسرطانات التناسلية أو الفموية أو مجموعة مرتبطة بأورام تناسلية حميدة)",
 "ひとねいり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひとねむり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひとのいい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "ひとのくち": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "ひとのこ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / اِبْنُ الإنْسان (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ひとのつね": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية",
 "ひとのみ": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / مَصَّة, رَشْفَة / مَزّ, كَرَع",
 "ひとのみち": "أخلاق, مبدأ أخلاقي (مبادئ الصواب والخطأ التي يقبلها فرد أو مجموعة اجتماعية) / مَبْدَأ أَخْلَاقِيّ (المبدأ القائل بأن السلوك يجب أن يكون أخلاقياً)\nمثال: الأخلاق البيوريتانية",
 "ひとのよい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "ひとはしり": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひとはた": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ひとはだ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ひとはな": "نَجَاح",
 "ひとはら": "مِحَفَّة / بَعْثَرَ / بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "ひとはパンのみにていくるにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "ひとはパンのみにていくるものにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "ひとばしら": "خِنْزِير غِينِيَّا",
 "ひとばん": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひとひ": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ひとひら": "وَرَقَة, وَرَقة / صَحِيفَة",
 "ひとびと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / اَلْجَمِيع, كُلّ شَخْص",
 "ひとふき": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひとふで": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / رِزْمَة, رُزْمَة",
 "ひとふろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひとふんばり": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "ひとぼしごろ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ひとまえ": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "ひとまえで": "جهراً, علناً (بطريقة يمكن للجمهور الوصول إليها أو ملاحظتها؛ بصراحة)\nمثال: اعترفت علناً بكونها شيوعية",
 "ひとまく": "مَنْظَر, مَشْهَد / مَشْهَد",
 "ひとまくもの": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "ひとまず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "ひとまとまり": "حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة.",
 "ひとまとめ": "إِبَالَة, حُزْمَة",
 "ひとまね": "مُشَاكهَة",
 "ひとまわり": "دَارَة (لا جمع له)",
 "ひとみ": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひとみごくう": "ضَحِيَّة / أُضْحِيَّة",
 "ひとみしり": "حياء, خجل (شعور بالخوف من الإحراج)",
 "ひとみをこらす": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "ひとむかし": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ひとむかしまえ": "قَدِيماً",
 "ひとむら": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ひとむれ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "ひとめ": "لمحة, نظرة خاطفة (نظرة سريعة) / مَنْظُور عَيْن الْطَائِر / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "ひとめにつかない": "غَيْر مُدْرَك (لم يُدرَك أو يُعلَّق عليه)",
 "ひとめぼれ": "اَلْحُبّ مِن اَلنَّظْرَة اَلْأُولَى\nمثال: 一目惚れなの。 — كان حبًّا من أوّل نظرة.",
 "ひとめもはばからず": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "ひとめんえきふぜんウイルス": "الإيدز, فيروس نقص المناعة البشرية (الفيروس الذي يسبب متلازمة نقص المناعة المكتسب (الإيدز)؛ يتكاثر في الخلايا التائية المساعدة ويقتلها)",
 "ひともしごろ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ひともじ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ひともなげ": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "ひともり": "كَوْم",
 "ひともんちゃく": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "ひとや": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "ひとやく": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "ひとやくかう": "شَارَكَ, سَاهَمَ",
 "ひとやすみ": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "ひとやま": "كَوْم / سَنَام / حَدَبَة, سَنَام / مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ひとやまいくら": "بَخْس الثَّمَن, رَخِيص جِدّاً (رخيص للغاية؛ شبه مجاني) / لُوط",
 "ひとよ": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひとよせ": "جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب) / جاذبية, عنصر جذب (خاصية توفر المتعة وتجذب) / مَعلم ترفيهي, وسيلة جذب (ترفيه يُقدم للجمهور) / عامل جذب, مصدر جذب (فنان ترفيهي يجذب جماهير غفيرة)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ひとよせせき": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "ひとよづま": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ひとらしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "ひとり": "لوحد / لحال / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ひとりあたり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "ひとりおやかた": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "ひとりおんな": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "ひとりかって": "أَنَانِيّ",
 "ひとりぎめ": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "ひとりごちる": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "ひとりごつ": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "ひとりごと": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "ひとりじめ": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "ひとりずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとりてんぐ": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "ひとりで": "وَحِيد, مُنْفَرِد",
 "ひとりでに": "آلياً, تلقائياً (بطريقة انعكاسية لا إرادية) / تلقائياً, ميكانيكياً (بطريقة ميكانيكية؛ بواسطة آلية)\nمثال: أجاب تلقائياً",
 "ひとりにつき": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "ひとりのこらず": "كُلّ, جَمِيع",
 "ひとりひとり": "كُلّ",
 "ひとりびとり": "كُلّ",
 "ひとりべや": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ひとりぼっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ひとりぽっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ひとりまえ": "بَالِغ, رَاشِد\nمثال: 彼女も一人前の女になった。 — لقد اصبحت امرأة بالغة. / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "ひとりみ": "عزوبية (حالة كون الرجل غير متزوج) / عزوبية (فترة حياة الرجل قبل الزواج)",
 "ひとりも": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとりよがり": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "ひとりエッチ": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "ひとり占め": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "ひとり残らず": "كُلّ, جَمِيع",
 "ひとり決め": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "ひとり言": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "ひとり部屋": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "ひとわたり": "عُمُومًا / بِوَجْهٍ عَامّ",
 "ひとわらわせ": "سَخِيف, مَسْخَرَة",
 "ひとわらわれ": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ひとをくった": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "ひとコマ": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "ひとマネ": "مُشَاكهَة",
 "ひと仕事": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ひと休み": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "ひと先ず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "ひと切り": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "ひと吹き": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひと味": "تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها)",
 "ひと味もふた味も": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "ひと安心": "سَكِينَة, طُمَأْنِينَة",
 "ひと寝入り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひと山": "كَوْم / سَنَام / حَدَبَة, سَنَام / مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ひと度": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "ひと思いに": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "ひと息": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "ひと悶着": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "ひと抱え": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "ひと昔": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ひと昔前": "قَدِيماً",
 "ひと時": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "ひと晩": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひと暴れ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "ひと条": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "ひと気": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "ひと泡": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "ひと泳ぎ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "ひと目": "لمحة, نظرة خاطفة (نظرة سريعة) / مَنْظُور عَيْن الْطَائِر",
 "ひと眠り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "ひと筋": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "ひと続き": "سِلْسِلَة",
 "ひと肌": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ひと腹": "مِحَفَّة / بَعْثَرَ / بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "ひと舐め": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة / غِلَاف",
 "ひと苦労": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد) / سجن مشدد (مدة تُقضى في سجن شديد الحراسة)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "ひと荒れ": "مُشْكِلَة, مَتاعِب",
 "ひと財産": "ثَرْوَة",
 "ひと走り": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "ひと足先に": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا",
 "ひと踏ん張り": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "ひと雨": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "ひと風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ひと飛び": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ひと騒動": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ひどい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُفْرِط, زَائِد",
 "ひどいしうち": "غبن, معاملة مجحفة (معاملة غير عادلة)",
 "ひどい仕打ち": "غبن, معاملة مجحفة (معاملة غير عادلة)",
 "ひどう": "ظَالِم, جَائِر / سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية) / صِيغَة مَجْهُول / مَبْنِي مَجْهُول",
 "ひどうき": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ひどうきしき": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ひどうきてんそうモード": "وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "ひどうしゃ": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "ひどうとくてき": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "ひどうみゃく": "شريان طحالي (شريان ينشأ من الجذع الزلاقي ويغذي الطحال بالدم)",
 "ひどうめい": "عدم الانحياز (شعب (أو دول) غير متحالفين مع آخرين في حلف أو معاهدة)",
 "ひどく": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة)\nمثال: مثير للاهتمام جداً",
 "ひどけい": "مِزْوَلَة",
 "ひどすぎる": "صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "ひどの": "مِرْحَاض, تواليت",
 "ひな": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير. / طائر صغير, فرخ طائر (طائر لا يزال صغيراً)",
 "ひなうた": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "ひなか": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "ひなかんべつし": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "ひながた": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "ひなぎく": "أُقْحُوَان",
 "ひなげし": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "ひなさき": "بَظْر",
 "ひなたくさい": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق",
 "ひなたぼっこ": "حَمَّام شَمْس (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ひなつぼし": "الْمِرِّيخ, المريخ (رابع كوكب من كواكب المجموعة الشمسية) / مَارِس (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: المريخ عالم ميت.",
 "ひなどり": "صُوص, فَرُّوج / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "ひなびた": "رَيْفِيّ, قَرَوِيّ",
 "ひなびと": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد)",
 "ひなべ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "ひなゆり": "كاماسيا شرقية, ياقوتية برية (كاماسيا شرقية؛ شرق ووسط أمريكا الشمالية) / جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "ひならず": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "ひならずして": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "ひなわ": "فَتِيل / مُنْصَهِرَة, مصهر",
 "ひなわじゅう": "بندقية فتيل (طراز مبكر من المسكيت؛ كان يتم إنزال فتيل بطيء الاحتراق في ثقب في المؤخرة لإشعال الشحنة)",
 "ひなん": "نَقْد, اِنْتِقَاد / إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "ひなんかいだん": "مخرج طوارئ",
 "ひなんがましい": "تَأْدِيبِيّ, عَتَابِيّ (يُعَبِّر عَنِ التَّوْبِيخ أَوِ اللَّوْم خَاصَّةً بِغَرَض التَّصْحِيح)",
 "ひなんぐち": "كوة نجاة, مخرج طوارئ (فتحة توفر وسيلة للهروب في حالات الطوارئ)",
 "ひなんしゃ": "مُرَحَّل",
 "ひなんじょ": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "ひなんち": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "ひなんば": "مَلْجَأ, مَلَاذ",
 "ひなんみん": "مُرَحَّل",
 "ひなんをあびせる": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひな型": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "ひな形": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "ひな菊": "أُقْحُوَان",
 "ひな鑑別師": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "ひな鳥": "صُوص, فَرُّوج / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "ひにあぶらをそそぐ": "صَبَّ اَلزَّيْت عَلَى اَلنَّار, زَادَ اَلنَّار حَطَباً (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "ひにく": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء / مُفَاجِئ / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "ひにくなことに": "بتهكم, بسخرية (بطريقة ساخرة) / للمفارقة, من السخرية أن (على عكس الخطة أو التوقع)\nمثال: بدأت بتقليده بسخرية",
 "ひにくや": "ساخر, متهكم (فكاهي يستخدم السخرية والتهكم والغمز لانتقاد الرذائل أو الحماقات)",
 "ひにくる": "هجا",
 "ひにけに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ひにち": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟ / أَيَّام",
 "ひにちじょう": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひにちじょうせい": "اسْتِثْنَائِيَّة, غَرَابَة (صفة كون الشيء استثنائياً وغير مألوف)",
 "ひにちじょうてき": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひにひに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم / يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "ひにゅう": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي) / إدرار الحليب, رضاعة (إنتاج وإفراز الحليب بواسطة الغدد الثديية) / رضاعة, فترة الرضاعة (الفترة التي تلي الولادة والتي يتم خلالها إفراز الحليب)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "ひにょう": "تبول (إخراج البول)",
 "ひにょうき": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "ひにょうきか": "طب المسالك البولية (فرع الطب الذي يتعامل مع تشخيص وعلاج اضطرابات المسالك البولية أو الجهاز البولي التناسلي)",
 "ひにょうきかい": "طبيب مسالك بولية (أخصائي في طب المسالك البولية)",
 "ひにょうきかがく": "طب المسالك البولية (فرع الطب الذي يتعامل مع تشخيص وعلاج اضطرابات المسالك البولية أو الجهاز البولي التناسلي)",
 "ひにん": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد. / منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "ひにんぐ": "مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "ひにんげんか": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "ひにんげんてき": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひにんじょう": "عديم الرحمة, قاسي القلب (يفتقر إلى الشعور أو الشفقة أو الدفء) / فَاقِدُ الشَّجَاعَة (خالٍ من الشجاعة أو الحماس)",
 "ひにんめいしゃ": "مُعَيَّن (شخص تم تعيينه في وظيفة أو منصب) / معيّن (مسؤول يتم تعيينه)",
 "ひにんやく": "مَانِع لِلْحَمْل (قادر على منع الحمل أو الإخصاب) / مانع حمل, وسيلة منع حمل (عامل أو جهاز يهدف إلى منع الحمل)",
 "ひにんピル": "حبوب منع الحمل (مانع حمل على شكل حبة تحتوي على الإستروجين والبروجستين لمنع الإباضة وبالتالي منع الحمل)",
 "ひにんリング": "لولب رحمي (جهاز لمنع الحمل يتكون من قطعة من البلاستيك أو المعدن المثني يتم إدخالها عبر المهبل إلى الرحم)",
 "ひねくさい": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "ひねくりまわす": "لَوَى, بَرَمَ / إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "ひねくり回す": "لَوَى, بَرَمَ / إعادة كتابة, تنقيح (شيء تمت كتابته مرة أخرى)\nمثال: كانت إعادة الكتابة أفضل بكثير",
 "ひねくる": "برم, دوران سريع (عملية الدوران بسرعة) / التواء, عقدة (انحناء حاد في خط ناتج عن سحب خط به حلقة بقوة)\nمثال: أدار الكرنك بقوة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "ひねくれもの": "عبوس, متجهم (شخص ذو تعبير وجه كئيب أو عابس بشكل معتاد)",
 "ひねくれる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "ひねくれ者": "عبوس, متجهم (شخص ذو تعبير وجه كئيب أو عابس بشكل معتاد)",
 "ひねつ": "حرارة نوعية (الحرارة اللازمة لرفع درجة حرارة جرام واحد من مادة ما درجة مئوية واحدة)",
 "ひねつしょり": "غير مبستر (لم يخضع للبسترة)",
 "ひねり": "لَوَى, بَرَمَ / براعة, ذكاء (خاصية كون الشخص بارعاً) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "ひねりだす": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "ひねり出す": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "ひねる": "لَوَى, بَرَمَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ひのいり": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "ひのうちどころ": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "ひのうちどころがない": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "ひのうちどころのない": "مَعْصُوم, كَامِل / مَعْصُوم",
 "ひのうりつ": "عدم كفاءة (نقص المهارة الناتج عن نقص الكفاءة)",
 "ひのうるい": "حبلي الذيل, غلالية (حيوان بحري بدائي له جسم يشبه الكيس غير مقسم وحبل ذيلي يكون واضحاً في اليرقة)",
 "ひのきぶたい": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひのき舞台": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひのくに": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "ひのくるま": "ضائقة شديدة, ظروف يائسة (حالة من الضيق الشديد)",
 "ひのけ": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "ひのこ": "شَرَارَة",
 "ひのせい": "سَمَنْدَل",
 "ひのたま": "كُرَة نَارِيَّة / سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "ひのて": "لَهَب, شُعْلَة / حَمْلَة / هَاجَمَ",
 "ひので": "شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "ひのとり": "فِينِيكْس, فُقْنُس",
 "ひのばん": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "ひのべ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "ひのまる": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "ひのみ": "برج مراقبة الحرائق (برج مراقبة حيث يتمركز حارس لمراقبة نشوب الحرائق)",
 "ひのみこ": "قَيْصَر, إِمْبْرَاطُور / وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ひのみやぐら": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ひのめ": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "ひのもと": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "ひはい": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد)",
 "ひはいすい": "غير مُجفف, غير مُصرَّف (لم يتم تصريف محتواه)\nمثال: الحفاظ على الأراضي الرطبة: إبقاؤها غير مجففة",
 "ひはし": "مزراب (جرغول) (زخرفة تتكون من شكل منحوت بشكل غريب لشخص أو حيوان) / جرغول, مزراب (فوهة تنتهي بشكل تمثال بشري أو حيواني منحوت بشكل غريب)",
 "ひはん": "نَقْد, اِنْتِقَاد / سِمْنَة, بَدَانَة",
 "ひはんしゃ": "نَقَّاد, نَاقِد / ناقد",
 "ひはんてき": "النقد",
 "ひはんてきしこう": "تَفْكِير نَقْدِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "ひばいどうめい": "قَاطَعَ / مُقَاطَعَة",
 "ひばくち": "موقع قصف (منطقة في بلدة دمرتها القنابل)\nمثال: افتتحوا موقف سيارات في موقع القصف",
 "ひばご": "تَقْرِيع, سِبَاب (لغة مسيئة أو سامة تستخدم للتعبير عن اللوم أو الاستهجان أو الضغينة العميقة)",
 "ひばさみ": "ملقط فحم, ملقط نار (ملقط للإمساك بالفحم المشتعل)",
 "ひばし": "ملقط فحم, ملقط نار (ملقط للإمساك بالفحم المشتعل)",
 "ひばち": "مَجْمَرَة, مَنْقَل",
 "ひばな": "شَرَارَة",
 "ひばなをちらす": "شَرَارَة",
 "ひばら": "طِحَال",
 "ひばり": "قُبَّرَة",
 "ひひ": "رُبَّاح, بَابُون / شهواني, فاسق (رجل لديه رغبات جنسية قوية) / كُلّ, جَمِيع",
 "ひひいん": "صَهِيل / صَهَلَ (صَهَلَ: (فعل)صهَلَ يَصهَل ويَصهِل ، صَهيلاً وصُهالاً ، فهو صاهِل صَهَلَ الْفَرَسُ : صَوَّتَ؛ ل. (فعل: ثلاثي لازم). صَهَلَ، يَصْهَلُ، مصدر صُهَالٌ، صَهِيلٌ.صَهَلَ الْفَرَسُ :صَوَّتَ)",
 "ひひひ": "إِهْلَاس",
 "ひひひひ": "إِهْلَاس",
 "ひひょう": "نَقْد, اِنْتِقَاد",
 "ひひょうか": "نَقَّاد, نَاقِد / ناقد",
 "ひひょうじ": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "ひび": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة)) / شق صخري, صدع (شق ضيق في الصخر) / انفراج, فجوة (فجوة بين كتل السحب)\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات / يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم / شَاب, رَجُل",
 "ひびがきれる": "شَاب, رَجُل",
 "ひびがはいる": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひびが入る": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひびが切れる": "شَاب, رَجُل",
 "ひびき": "صَدًى / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ひびきわたる": "صَدًى",
 "ひびく": "هَزَّ / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "ひびのきれた": "مُشَقَّق",
 "ひびの切れた": "مُشَقَّق",
 "ひびやき": "خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح)",
 "ひびわれ": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひびわれる": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひび割れ": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひび割れる": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "ひび焼き": "خزف مشقق (خزف مصقول بشبكة من الشقوق الدقيقة على السطح)",
 "ひふ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ひふいしょく": "طُعْم جِلْدِيّ (قطعة جلد تؤخذ من منطقة مانحة وتزرع جراحياً في موقع إصابة أو حرق)",
 "ひふえん": "التهاب الجلد (التهاب يصيب الجلد؛ يصبح الجلد مثيرًا للحكة وقد تتكون فيه بثور)",
 "ひふか": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ひふかい": "أخصائي أمراض جلدية, طبيب جلدية (طبيب متخصص في فسيولوجيا وأمراض الجلد)",
 "ひふかがく": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ひふかんかく": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "ひふがん": "سَرَطَان اَلْجِلْد",
 "ひふきんえん": "التهاب الجلد والعضلات (التهاب عضلات يتميز بضعف عضلات الأطراف والرقبة والكثير من آلام العضلات والتورم المصاحب لطفح جلدي يؤثر على الخدين والجفون والرقبة والصدر والأطراف)",
 "ひふく": "مَلَابِس, ثِيَاب / تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود / غِطَاء / غِلَاف / غَطَّى",
 "ひふくきん": "عضلة الساق التوأمية (العضلة الموجودة في الجزء الخلفي من الساق التي تشكل الجزء الأكبر من ربلة الساق؛ مسؤولة عن الثني الأخمصي للقدم)",
 "ひふくけい": "مورفيم مقيد",
 "ひふくさくもつ": "محصول تغطية (محصول يُزرع لمنع تآكل التربة وتوفير السماد الأخضر)",
 "ひふこうかしょう": "تصلب الجلد (مرض مناعي ذاتي يصيب الأوعية الدموية والنسيج الضام)",
 "ひふしんきんしょう": "فطار جلدي (عدوى فطرية في الجلد (خاصة في الأجزاء الرطبة المغطاة بالملابس))",
 "ひふせいすう": "عَدَد صَحِيح (أي من الأعداد الطبيعية (الموجبة أو السالبة) أو الصفر)\nمثال: العدد الصحيح هو عدد ليس كسراً",
 "ひふたんそ": "جمرة خبيثة جلدية (شكل من أشكال عدوى الجمرة الخبيثة يبدأ كحطاطة تصبح حويصلة وتنفجر مع إفراز سموم)",
 "ひふびょう": "مرض جلدي (مرض يصيب الجلد)",
 "ひふぶんせつ": "مبضع الجلد (أداة جراحية تستخدم لقطع شرائح رقيقة جداً من الجلد)",
 "ひふべん": "رَفْرَف",
 "ひふもんり": "علم بصمات الأصابع (دراسة الدوائر والحلقات والأقواس في أطراف الأصابع وراحة اليد وباطن القدمين)\nمثال: بعض علماء الإجرام يتخصصون في علم بصمات الأصابع",
 "ひふようしゃ": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "ひふん": "استنكار, سخط (شعور بالغضب المحق)",
 "ひぶ": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "ひぶくれ": "بَطْبَاطَة, نَفْطَة",
 "ひぶそう": "أَعْزَل",
 "ひぶそうちたい": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "ひぶたがきられる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "ひぶたをきる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "ひぶね": "سفينة حارقة (سلاح يتكون من سفينة تحمل متفجرات تُترك لتنجرف لتدمير سفن العدو)",
 "ひぶん": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "ひぶんがく": "علم النقوش (دراسة النقوش القديمة)",
 "ひへい": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد) / إفقار (فعل جعل شخص ما فقيراً) / عوز, فقر (حالة امتلاك القليل من المال أو عدم امتلاكه وقلة الممتلكات المادية)",
 "ひべつ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "ひべん": "رَفْرَف",
 "ひほ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "ひほけんしゃ": "مُؤمَّن عليه (شخص تحميه بوليصة تأمين؛ شخص يتعاقد على بوليصة تأمين تعوضه عن خسارة الممتلكات أو الحياة أو الصحة، إلخ)",
 "ひほごこく": "الحِمَايَة",
 "ひほごしゃ": "جَنَاح",
 "ひぼう": "تَشْهِير, اِفْتِرَاء",
 "ひぼうちゅうしょう": "تَشْهِير, اِفْتِرَاء",
 "ひぼうりょく": "لاعنف",
 "ひぼうりょくていこう": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "ひぼうりょくふふくじゅう": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "ひぼし": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع. / مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "ひぼん": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひぼんじん": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "ひま": "خِرْوَع, تَنُّوم / وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها) / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / إجازة, وقت راحة (فترة زمنية لا يُطلب منك العمل فيها)\nمثال: طلب إجازة لحضور جنازة جدته / إِقَالَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "ひまがない": "مَشْغُول",
 "ひまく": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود / كَبْسُولة / غِطَايَة, غشاوة / فِلْم, فيلم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي»)\nمثال: استمر الفلم ساعتين.",
 "ひまし": "الخروع",
 "ひましに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ひましゆ": "زيت الخروع (مسهل يستخرج من بذور نبات الخروع؛ يستخدم في الطلاء والورنيش وكذلك طبياً)",
 "ひまし油": "زيت الخروع (مسهل يستخرج من بذور نبات الخروع؛ يستخدم في الطلاء والورنيش وكذلك طبياً)",
 "ひまじん": "عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "ひまつ": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / قُطَيْرَة",
 "ひまつぶし": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "ひまなとき": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "ひまねた": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "ひまわりあぶら": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "ひまわりゆ": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "ひまわり油": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
