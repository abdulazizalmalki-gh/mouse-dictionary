 "ひんこんしゃ": "فَقِير",
 "ひんこんせん": "خط الفقر, مستوى الفقر (مستوى من الدخل الشخصي يحدد حالة الفقر)",
 "ひんこんそう": "الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي)",
 "ひんし": "جُزْء كَلَام, قَسْم كَلَام",
 "ひんしつ": "نَوْعِيَّة, جَوْدَة",
 "ひんしつかんり": "مُرَاقَبَةُ الْجَوْدَة",
 "ひんしつほしょう": "ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "ひんしつチェック": "ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "ひんしゅ": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / رَبَّى",
 "ひんしゅくをかう": "اِشْمِئْزَاز",
 "ひんしゅくを買う": "اِشْمِئْزَاز",
 "ひんしょう": "تَافِه / ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "ひんしるい": "شِبْهُ أَدْرَد, قَلِيل الأَسْنَان (له أسنان قليلة أو يكاد يخلو منها)",
 "ひんじ": "عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف. / خَبَر (بلاه وامتحنه ليعرف ما يُمكن عنه؛ عرفه على حقيقته بعد أن جربّه)\nمثال: زيري عنده خبرة.",
 "ひんじゃ": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "ひんじゃく": "فَقِير",
 "ひんすう": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "ひんせい": "شَخْصِيَّة\nمثال: زيري سيء الخلق. / طَبِيعَة, طبيعة / فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "ひんせき": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひんそう": "هَزِيل, نَحِيل",
 "ひんそうのかさねどき": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "ひんとう": "دَرَجَة",
 "ひんど": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "ひんどう": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "ひんどすう": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "ひんどぶんぷ": "توزيع تكراري (توزيع التكرارات المرصودة لقيم متغير)",
 "ひんぬく": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "ひんのいい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "ひんのう": "فَلَّاح, فَلَّاحَة",
 "ひんのない": "بَذِيء",
 "ひんのよい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "ひんば": "حِجْر, فَرَس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "ひんぱく": "تسرع القلب",
 "ひんぱん": "مُتَكَرِّر",
 "ひんぴょう": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "ひんぴょうかい": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان…)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "ひんぴん": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "ひんぷん": "مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)",
 "ひんぽ": "ضَمَانْ الجَوْدَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "ひんまがる": "لَوَى, بَرَمَ",
 "ひんまげる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / شَوَّهَ",
 "ひんみゃく": "تسرع القلب",
 "ひんみん": "فقراء (الناس الذين ليس لديهم ممتلكات أو ثروة (يُعتبرون كمجموعة))\nمثال: فقراء الحضر بحاجة للمساعدة",
 "ひんみんがい": "مِنْطَقَة عَشْوَائِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "ひんみんくつ": "مِنْطَقَة عَشْوَائِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
