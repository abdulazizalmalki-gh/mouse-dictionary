 "はんしんよく": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في…)",
 "はんしんろん": "وَحْدَة اَلْوُجُود",
 "はんじ": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / نِصْف سَاعَة / ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز) / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんじせい": "دايامغناطيسية, مغناطيسية معاكسة (ظاهرة تظهرها مواد مثل النحاس أو البزموت التي تصبح ممغنطة في مجال مغناطيسي…)",
 "はんじどうしょうじゅう": "ذَاتِيّ التَّعْبِئَة, نِصْف آلِيّ ((للأسلحة النارية) قادر على التعبئة والإطلاق المتواصل آلياً)",
 "はんじもの": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها.",
 "はんじゃ": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "はんじゅうしん": "ساتير",
 "はんじゅく": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا)\nمثال: قاضٍ رقيق القلب / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: فاكهة غير ناضجة",
 "はんじゅんじょしゅうごう": "فِئَةٌ مُرَتَّبَةٌ جُزْئِيًّا (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة…)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "はんじょう": "تشويش, مقاطعة (الصياح لمقاطعة خطاب لا توافق عليه) / اِزْدِهَار, رَخَاء / مُبَرْقَع, مُرَقَّش (ذو بقع أو رقع من الألوان المتباينة)",
 "はんじょうし": "تسمم بالفلور, تفلور (حالة مرضية ناتجة عن التناول المفرط للفلور (عادة من مياه الشرب))",
 "はんじょうしゅっけつ": "ازرقاق, كدمة (هروب الدم من الأوعية الدموية الممزقة إلى الأنسجة المحيطة لتكوين بقعة أرجوانية…)",
 "はんじょうをいれる": "قَاطَعَ",
 "はんじょうをうつ": "قَاطَعَ",
 "はんじる": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا…)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "はんすい": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんすう": "نِصْف, نُصْف / أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات) / نَظِير جَمْعِيّ ((الرياضيات) أحد زوجين من الأعداد مجموعهما صفر؛ النظير الجمعي لـ -5 هو +5) / اجترار / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "はんすうせい": "أحادية الصيغة الصبغية (حالة كون الكائن أحادي الصيغة الصبغية)",
 "はんすうたい": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات)",
 "はんすうどうぶつ": "مُجْتَرّ",
 "はんすうるい": "مُجْتَرّ",
 "はんする": "نَاقَضَ / اِنْتَهَكَ / عَصَى",
 "はんずる": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا…)\nمثال: ذاب ذلك الجليد. / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "はんせい": "اِنْعِكَاس, عَكْس / نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "はんせいいでん": "مرتبط بالجنس",
 "はんせつ": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي) / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "はんせん": "سَفِينَة شَرَاعِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "はんせんうんどう": "حركة مناهضة للحرب (حملة ضد دخول الحرب أو استمرارها)",
 "はんせんしゅぎ": "سَلَامِيَّة, سِلْمِيَّة",
 "はんせんしゅぎしゃ": "مُسَالِم",
 "はんぜん": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "はんそ": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق)",
 "はんそう": "إِبْحَار / نَقْل, نَقْلِيَّات / استشفاء, رعاية في المستشفى (الوضع تحت الرعاية الطبية في المستشفى)\nمثال: كان يأمل تجنب نفقات الاستشفاء",
 "はんそうきしゃ": "نِصْف مُجَنْزَر (له جنازير في الخلف وعجلات في الأمام)",
 "はんそうせん": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "はんそうは": "موجة حاملة",
 "はんそく": "مُخَالَفَة / اِنْتِهَاك / تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんそくきん": "غَرَامَة",
 "はんそくさいぼう": "نَقِيض (المقابل المباشر)\nمثال: الهدوء: نقيض الانشغال المركز",
 "はんそくまけ": "إِقْصَاء",
 "はんそくプレー": "خطأ ((بيسبول) فشل لاعب مدافع في إخراج الخصم عندما كان اللعب العادي كافياً لذلك)",
 "はんそで": "كم قصير, نصف كم (كم يمتد من الكتف إلى الكوع)",
 "はんぞく": "مُتَمَرِّد, مُتَمَرِّدَة",
 "はんたい": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة. / عَكَسَ / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "はんたいいけん": "رأي مخالف (رأي يختلف مع تصرف المحكمة في القضية)",
 "はんたいがわ": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "はんたいきゅうふ": "واحدة بواحدة",
 "はんたいご": "عَكْس",
 "はんたいしゃ": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية))\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه",
 "はんたいじ": "حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "はんたいじんえい": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "はんたいじんもん": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء…)",
 "はんたいせい": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "はんたいせいがわ": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "はんたいせいは": "مُنْشَقّ",
 "はんたいとうひょう": "استبعاد, حظر (فعل استبعاد شخص ما عن طريق تصويت سلبي أو حق النقض)",
 "はんたいひょう": "بَل (أصابه ماء كثير أو سائل آخر مشابه للماء؛ الشخصُ الشيءَ: صبّ عليه ماء كثير أو غمس…)\nمثال: ليس أنا ، بل أنت!",
 "はんたいべんろん": "رد المدعى عليه الثاني (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "はんたいぼうえきふう": "رياح عكسية تجارية (رياح تهب من الغرب إلى الشرق وتقع فوق الرياح التجارية في المناطق المدارية)",
 "はんだ": "سبيكة لحام, مادة اللحام (سبيكة (عادة من الرصاص والقصدير) تستخدم عند صهرها لربط سطحين معدنيين)",
 "はんだい": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "はんだごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام",
 "はんだづけ": "لحام, لصق (التثبيت بإحكام معاً)",
 "はんだん": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "はんだんりょく": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんだんミス": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "はんだゴテ": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام",
 "はんだ付け": "لحام, لصق (التثبيت بإحكام معاً)",
 "はんちゅう": "فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة…)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "はんちゅうせいし": "نَقِيض النِّيُوتْرُون (الجسيم المضاد للنيوترون)",
 "はんちゅうせいびし": "نَقِيض النِّيُوتْرِينُو (الجسيم المضاد للنيوترينو)",
 "はんちょう": "ارتداد, انعكاس (حركة العودة من الارتطام)",
 "はんちょくせん": "شُعَاع",
 "はんつや": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "はんてい": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんていきじゅん": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار)",
 "はんていし": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد…)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "はんていりつ": "تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن)\nمثال: نظريته هي عكس نظريتي تماماً",
 "はんてん": "جَوّ / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "はんてんこうせい": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة…)",
 "はんてんぼく": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق…)",
 "はんで": "لِأَنَّ",
 "はんでおしたみたいに": "باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: لطيف وكريم دائماً",
 "はんでおしたよう": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "はんと": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط / مُتَمَرِّد, مُتَمَرِّدَة / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو…)",
 "はんとう": "شِبْه جَزِيرَة / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا.",
 "はんとうじん": "كُورِيّ",
 "はんとうまく": "غشاء شبه منفذ (غشاء (مثل غشاء الخلية) يسمح لبعض الجزيئات بالمرور من خلاله دون غيرها)",
 "はんとうめい": "شِبْه شَفَّاف (يسمح بمرور الضوء بشكل منتشر دون أن يكون شفّافاً تماماً)",
 "はんとき": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "はんとけいまわり": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "はんとしごとに": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة)",
 "はんどう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "はんどういるか": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط…)",
 "はんどうか": "رجعي",
 "はんどうかくめい": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "はんどうけいせい": "تكوين عكسي ((في الطب النفسي) آلية دفاع يطور فيها الشخص بغير وعي مواقف وسلوكاً معاكساً…)\nمثال: أخلاقه الصارمة هي مجرد تكوين عكسي لإخفاء دافعه الجنسي",
 "はんどうげん": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "はんどうこう": "بورنيت, خام الطاووس (معدن يتكون من كبريتيدات النحاس والحديد ويوجد في رواسب النحاس)",
 "はんどうしゅぎ": "رجعية (التوجه السياسي للرجعيين)",
 "はんどうしゅぎしゃ": "رجعي",
 "はんどうたい": "شِبْه مُوَصِّل",
 "はんどうたいけんしゅつき": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها)",
 "はんどうたいそし": "جهاز شبه موصل, نبيطة شبه موصلة (موصل مصنوع من مادة شبه موصلة)",
 "はんどうてき": "رجعي",
 "はんどうタービン": "توربين تفاعلي, عنفة رد الفعل (توربين بشفرات مرتبة لتوليد عزم الدوران من الانخفاض التدريجي لضغط البخار من…)",
 "はんどく": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "はんどくしがたい": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "はんどん": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "はんながぐつ": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات)",
 "はんなま": "نَادِر / شِبْه جَافّ (جافّ إلى حدٍّ ما) / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "はんなり": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "はんにゃとう": "غاية, غَرَض",
 "はんにゅうぐち": "باب الخدمة, مدخل الخدمة (مدخل مخصص لاستخدام الخدم أو لتسليم البضائع وإزالة القمامة)",
 "はんにん": "جَانٍ ((جَانَ) جونا وجونة: اسود) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "はんにんそく": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "はんにんまえ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "はんのう": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "はんのうじかん": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "はんのうせい": "استجابة, تفاعلية (الاستجابة للتحفيز)",
 "はんのうちゅうかんたい": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "はんのうろ": "مُفَاعِل",
 "はんはん": "مُنَاصَفَةً, بِالنِّصْف",
 "はんばい": "بَيْع\nمثال: هل يمكن ان تعطيني تخفيض",
 "はんばいいん": "طاقم المبيعات (أولئك في شركة المسؤولون عن المبيعات)",
 "はんばいかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "はんばいがいしゃ": "قَاسِم",
 "はんばいき": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "はんばいぎょうしゃ": "تَاجِر, تَاجِرَة",
 "はんばいしゃ": "بَائِع, بَائِعَة",
 "はんばいじてん": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا…)",
 "はんばいじてんかんり": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا…)",
 "はんばいじてんじょうほうかんりシステム": "عند نقطة البيع (من أو متعلق بـ أو كونه الموقع الذي يتم فيه شراء شيء ما)",
 "はんばいじゅつ": "فن البيع, مهارة البيع (المهارة في البيع؛ المهارة في إقناع الناس بالشراء)\nمثال: قرأ كتابًا عن فن البيع لكنه لم يساعده",
 "はんばいすいしん": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんばいそくしん": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんばいてん": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "はんばいにん": "بَائِع, بَائِعَة",
 "はんばいねだん": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "はんばいひ": "تكلفة التوزيع (أي تكلفة يتكبدها منتج أو تاجر جملة أو تاجر تجزئة أو موزع (كما للإعلان والشحن…)",
 "はんばいぶ": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "はんばいぶもん": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "はんばいめい": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "はんばいもと": "بَائِع, بَائِعَة",
 "はんばく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "はんばり": "نصف نعل (نعل حذاء يمتد من القوس إلى إصبع القدم)",
 "はんぱ": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط / غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "はんぱく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "はんぱじゃない": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "はんぱつ": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / جَائِحَة",
 "はんぱつさよう": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح)",
 "はんぱつりょく": "رجوعية, مرونة (الخاصية الفيزيائية للمادة التي تمكنها من العودة إلى شكلها أو موضعها الأصلي بعد…)",
 "はんぱない": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "はんぱもの": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما) / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はんぱもん": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "はんぴゃく": "مُخْتَلِف, مُتَنَوَّع",
 "はんぶっしつ": "مَادَّة مُضَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "はんぶん": "نِصْف, نُصْف",
 "はんぶんすう": "كَسْر مُرَكَّب (كسر يحتوي على كسور في بسطه أو مقامه)",
 "はんぷ": "تَوْزِيع / قماش الأشرعة (قماش قوي (مثل قماش القنب القطني) يستخدم لصنع الأشرعة والخيام)",
 "はんぷく": "تَكْرَار, إِعَادَة / إعادة إنتاج, استنساخ (فعل عمل نسخ)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير / عَوْدِيَّة / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / عَكَسَ / تَكْرَار, إِعَادَة",
 "はんぷくせい": "تكرار (إطناب ناتج عن التكرار المفرط) / مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة)\nمثال: حركة تكرارية",
 "はんぷくてき": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة)\nمثال: حركة تكرارية",
 "はんべい": "معاد لأمريكا (يعارض الولايات المتحدة وسياساتها)",
 "はんべつ": "تَمْيِيْز",
 "はんべつがつく": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "はんべり": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "はんぺい": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال) / سُور",
 "はんぺら": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "はんぺん": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال)",
 "はんぼいん": "أَشْبَاهُ العِلَلِ",
 "はんぼう": "مَشْغُول",
 "はんぽ": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "はんま": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はんまい": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "はんみち": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط",
 "はんみょう": "خُنْفُسَاء نَمِرِيَّة / خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "はんめん": "مُدَّة\nمثال: جون في عمر أخي. / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / حُدُود خَارِجِيَّة / نِصْف, نُصْف / مُدَّة\nمثال: جون في عمر أخي. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَكَسَ",
 "はんめんきょうし": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "はんめんに": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はんも": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "はんもうしょう": "عَمًى",
 "はんもく": "عَدَاوَة",
 "はんもと": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "はんももひき": "يصل للركبة (يمتد إلى الركبة) / مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي)",
 "はんもん": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء…) / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "はんもんおうのう": "عذاب, غم (ضيق عقلي شديد)",
 "はんや": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل",
 "はんやく": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / كَرْشَنَة, نَقْصَوَة",
 "はんやけ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "はんよう": "إِجْمالِيّ, جامِع / انشغال, دبيب (حالة الوجود أو الظهور بمظهر المنشغل بنشاط ما)\nمثال: أظهروا كل نشاط مجموعة من القنادس",
 "はんようがたコンピュータ": "حاسوب مركزي (حاسوب رقمي كبير يخدم 100-400 مستخدم ويشغل غرفة خاصة مكيفة الهواء)",
 "はんようき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんようし": "نَقِيض البُرُوتُون (بروتون غير مستقر سالب الشحنة؛ الجسيم المضاد للبروتون)",
 "はんようせい": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "はんようてき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんようひん": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんらたい": "شِبْه عَارٍ (مكسوّ جزئياً فقط)",
 "はんらん": "انتفاضة / غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "はんらんげん": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "はんらんしゃ": "مُتَمَرِّد, مُتَمَرِّدَة",
 "はんらんぶんし": "مُتَمَرِّد, مُتَمَرِّدَة",
 "はんりゅう": "تَيَّار مُعَاكِس (أفعال معاكسة لنشاط المجموعة الرئيسي)\nمثال: عطلت التيارات السياسية المعاكسة المؤتمر",
 "はんりゅうし": "جُسَيْم مُضَادّ (جسيم له نفس كتلة جسيم آخر ولكن له قيم معاكسة لخصائصه الأخرى؛ يؤدي تفاعل الجسيم…)",
 "はんりゅうどうたい": "شِبْهُ سَائِل (سائل إلى حدّ ما؛ بين الصلب والسائل)",
 "はんりょ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "はんりょく": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "はんりょどうぶつ": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "はんりん": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "はんるい": "مُشْكِلَة, مَتاعِب",
 "はんれい": "مِثَال, مَثَل / أُسْطُورَة\nمثال: بحث عن المفتاح. / مِثَال مُعَاكِس, مِثَال مُضَادّ",
 "はんれいがん": "جابرو (واحد من عائلة الصخور المتطفلة الحبيبية)",
 "はんれいしゅう": "كِتَابِيّ, نَمُوذَجِيّ (وفقًا لما هو مذكور في الكتب المرجعية أو يتسم بخصائصها؛ نموذجي)",
 "はんれい岩": "جابرو (واحد من عائلة الصخور المتطفلة الحبيبية)",
 "はんれき": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "はんれつ": "نَمَط",
 "はんろ": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق. / منحدر (سطح مائل يربط بين مستويين)",
 "はんろう": "مُشْكِلَة, مَتاعِب",
 "はんろん": "اِعْتَرَاض / لَخَّصَ, اِخْتَصَرَ",
 "はんキリスト": "ضِدّ الْمَسِيح, الدَّجَّال",
 "はんクラ": "دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة)\nمثال: حرر القابض بسلاسة بقدم واحدة وداس على دواسة الوقود بالقدم الأخرى",
 "はんクラッチ": "دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة)\nمثال: حرر القابض بسلاسة بقدم واحدة وداس على دواسة الوقود بالقدم الأخرى",
