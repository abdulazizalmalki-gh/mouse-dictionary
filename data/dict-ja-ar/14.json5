 "ひがんざくら": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "ひがんばな": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "ひが目": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تَحَيُّز",
 "ひき": "عُلْجُوم, ضِفْدَع طِين / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / جذب, نتر (سحب مفاجئ وخاطف) / تَرَاجُع / لَاعِب / تَشْهِير, بُهْتَان / تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء)",
 "ひきあい": "مَرْجِع / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / شَهَادَة\nمثال: شاهد هذا الفيلم.",
 "ひきあいにだす": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم:…)\nمثال: تحصلت على علامة أ.",
 "ひきあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "ひきあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "ひきあげ": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / إعادة إلى الوطن (فعل العودة أو الإعادة إلى البلد الأصلي)",
 "ひきあげしゃ": "عائد إلى الوطن (شخص عاد إلى بلده الأصلي أو استعاد جنسيته)",
 "ひきあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…)",
 "ひきあて": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "ひきあてきん": "قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي)",
 "ひきあてる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "ひきあみ": "شبكة",
 "ひきあわせ": "مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "ひきあわせる": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي. / قَارَنَ",
 "ひきいる": "رَصَاص",
 "ひきうけ": "مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها)\nمثال: استعد لمشاريع عظيمة",
 "ひきうけにん": "كَافِل",
 "ひきうける": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / وَرَثَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "ひきうす": "رحى (طاحونة حجرية بدائية لطحن الذرة باليد)",
 "ひきうつし": "نسخ (فعل النسخ)",
 "ひきうつす": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ひきうつる": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور.",
 "ひきおこす": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "ひきおとし": "قيد مدين (قيد محاسبي يعترف بالمبالغ المستحقة الدفع)",
 "ひきおとす": "قيد مدين (قيد محاسبي يعترف بالمبالغ المستحقة الدفع)",
 "ひきかえ": "تَبْدِيل, تَبَادُل",
 "ひきかえけん": "قَسِيمَة",
 "ひきかえしょう": "إِيصَال",
 "ひきかえす": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "ひきかえて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ひきかえる": "تَبْدِيل, تَبَادُل / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات)\nمثال: هناك خط رفيع بين العقل والجنون",
 "ひきがえる": "عُلْجُوم, ضِفْدَع طِين",
 "ひきがね": "زِنَاد",
 "ひききる": "قَاطَعَ",
 "ひきくらべる": "قَارَنَ",
 "ひきげき": "تراجيكوميديا, كوميديا جادة (كوميديا ذات عناصر أو نغمات جادة)",
 "ひきこす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور.",
 "ひきこみしき": "قَابِلٌ لِلسَّحْب (يمكن سحبه وإرجاعه إلى الداخل)",
 "ひきこみせん": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط…)",
 "ひきこもごも": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية…)\nمثال: الكعكة حلوة جدا",
 "ひきこもり": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ)",
 "ひきさがる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / تَنَازَلَ",
 "ひきさげ": "نَقْص",
 "ひきさげる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "ひきさる": "تَرَاجُع",
 "ひきざん": "طَرْح (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "ひきしぼる": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي / سُلَالَة",
 "ひきしまった": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال.",
 "ひきしめ": "تَضْيِيق",
 "ひきしめる": "شَدَّ, ضَيَّقَ",
 "ひきすう": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: (…)\nمثال: لا جدال في ذلك.",
 "ひきずりおろす": "إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "ひきずる": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / أَطَالَ / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "ひきたつ": "حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "ひきたて": "مَعْرُوف / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "ひきたてやく": "فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "ひきたてる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "ひきだい": "حامل النشر (هيكل لحمل الخشب الذي يتم نشره)",
 "ひきだし": "جَارُور, دُرْج\nمثال: إنه رسام مشهور. / اِنْسِحَاب",
 "ひきだす": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / يَسْتَحْضِر, يَسْتَدْعِي / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / مُقْتَطَف",
 "ひきつぎ": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "ひきつぐ": "وَرَثَ / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "ひきつける": "اِجْتَذَبَ, جَذَبَ / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "ひきつづき": "باستمرار / قَادِم\nمثال: زيري بجانب الحوض.",
 "ひきつづく": "تَابَعَ, اِسْتَمَرَّ",
 "ひきつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "ひきつる": "زِيَار / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…) / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين)",
 "ひきづな": "حبل الشد ((مصطلح بحري) حبل يستخدم لتمديد أو تثبيت التجهيزات على السفن)",
 "ひきづり": "صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء)",
 "ひきて": "عُقدة, مقبض دائري (مقبض مستدير الشكل)",
 "ひきで": "يَمِين, يُمْنَى",
 "ひきでもの": "هَدِيَّة, هدية",
 "ひきとめる": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ひきとり": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام)\nمثال: كانت الغنائم سهلة / ذهاب, رحيل (فعل المغادرة)",
 "ひきとりて": "مُدَّعٍ, مُدَّعِيَة",
 "ひきとりにん": "مُحَافِظ",
 "ひきとる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / تَبَنَّى / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "ひきど": "باب منزلق (باب يفتح عن طريق الانزلاق بدلاً من التأرجح)",
 "ひきなみ": "أثر السفينة, موجة المؤخرة (الموجة التي تنتشر خلف القارب أثناء تحركه للأمام)\nمثال: قلب أثر الزورق القارب الصغير / عائِق",
 "ひきならす": "دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "ひきにげ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "ひきぬき": "تَعْبِئَة / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "ひきぬきあみめ": "غرزة لقط, غرزة مخفية (غرزة فضفاضة تلتقط خيطاً أو خيطين فقط من القماش؛ مصممة لتكون غير مرئية من الجانب…)",
 "ひきぬく": "مُقْتَطَف",
 "ひきのばし": "تَمْدِيد / تَوْسِيع",
 "ひきのばしき": "مكبر الصور (معدات تصوير فوتوغرافي تتكون من جهاز عرض بصري يستخدم لتكبير صورة فوتوغرافية)",
 "ひきのばす": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "ひきはなす": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "ひきはらう": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "ひきひも": "خيط زم, رباط سحب (رباط يتكون من حبل يمر عبر درزة حول فتحة)\nمثال: سحب خيط الزم وأغلق الحقيبة / رَصَاص",
 "ひきふね": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "ひきまど": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "ひきまわし": "إِرْشَاد, هِدَايَة",
 "ひきまわす": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "ひきむすぶ": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه. / جِزْدَان, جُزْدَان",
 "ひきもきらず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "ひきもきらない": "مُسْتَمِرّ, مُتَوَاصِل",
 "ひきもどす": "اِسْتَعَادَ",
 "ひきもの": "هَدِيَّة, هدية / سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…) / مِقْبَض / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "ひきゃく": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "ひきやぶる": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة.",
 "ひきゅう": "إِيثَارِيّ, مُضَحٍّ بِنَفْسِه (مستعدّ لحرمان نفسه من أجل الآخرين) / ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "ひきゅうめん": "لَاكُرَوِيّ (يختلف قليلاً عن الشكل الكروي التامّ)",
 "ひきょう": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان. / ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة / مُقَارَنَة / بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار. / مُشَوِّق, ممتع / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "ひきょういくしゃ": "طَالِب, طَالِبَة",
 "ひきょうえき": "خَارِجٌ عَنِ المَعْهُود, غَيْرُ مَأْلُوف (استثنائيّ أو غير عاديّ أو جدير بالملاحظة)",
 "ひきょうごうてき": "غير تنافسي (لا ينطوي على منافسة أو روح تنافسية)\nمثال: وظائف غير تنافسية",
 "ひきょうもの": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "ひきょうりょくてき": "غَيْر مُتَعَاوِن (غير متعاون عَمْدًا)\nمثال: شاهد غير متعاون",
 "ひきょく": "رِثَاء, مَرْثِيَة",
 "ひきょじゅうしゃ": "غير مقيم (لا يعيش في مكان معين أو مملوك لمقيمين دائمين)\nمثال: طلاب غير مقيمين يتنقلون إلى الفصول",
 "ひきょり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ひきよせる": "اِجْتَذَبَ, جَذَبَ",
 "ひきり": "مثقاب يدوي (مثقاب محمول صغير يُمسك ويشغل باليد)",
 "ひきわけ": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "ひきわける": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "ひきわたし": "تَوْصِيل, تَسْلِيم\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "ひきわたす": "نَقَلَ",
 "ひきわり": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس))\nمثال: سحالة الخضروات سدت المصرف",
 "ひきわる": "مِنْشَار\nمثال: نشر توم الغسيل. / طَحَنَ (طَحَنَ؛ طِحْنٌ)",
 "ひきん": "شَائِع",
 "ひきんぞく": "معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة / لا فلزي, لا معدني (لا يحتوي على معدن ولا يشبهه ولا يتسم بخصائصه)\nمثال: عناصر لا فلزية",
 "ひき続く": "تَابَعَ, اِسْتَمَرَّ",
 "ひき臼": "رحى (طاحونة حجرية بدائية لطحن الذرة باليد)",
 "ひき逃げ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "ひぎ": "شَعِيرَة, مَرَاسِم / نَقْد, اِنْتِقَاد / لَوْم, مَلَامَة / أسرار النخبة, باطنية (أسرار لا يعرفها إلا أقلية مطلعة)",
