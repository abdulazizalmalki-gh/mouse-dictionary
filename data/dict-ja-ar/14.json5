 "ひいる": "عُثَّة",
 "ひいれ": "تَدْفِئَة / بزوغ الفجر, شروق (ضوء النهار الأول)\nمثال: استيقظنا قبل الفجر / بسترة (تعقيم جزئي للأطعمة عند درجة حرارة تدمر الكائنات الحية الدقيقة الضارة دون…)",
 "ひいろ": "سِقِلَّاتِيّ, قِرْمِزِيّ",
 "ひいん": "حِمَايَة",
 "ひうお": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "ひうちいし": "صَوَّان, ظُرَر",
 "ひうちがね": "ضارب, مطرقة (الجزء من جهاز ميكانيكي الذي يضرب شيئاً ما)\nمثال: ضارب قوي",
 "ひうら": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "ひうん": "مُصِيبَة, شَقْوَة",
 "ひえ": "برود, جفاء (نقص في المودة أو الحماس)\nمثال: برود مؤلم في النبرة والأسلوب / دخن ياباني (عشب حولي خشن يزرع في اليابان وجنوب شرق آسيا لبذوره الصالحة للأكل وللعلف؛ غذاء…)",
 "ひえいせい": "غير صحي, ملوث (ليس صحيًا أو نظيفًا)\nمثال: مجاري مفتوحة غير صحية",
 "ひえいり": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "ひえいりそしき": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "ひえいりだんたい": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "ひえいりてき": "غَيْرُ رِبْحِيّ, غَيْرُ هَادِفٍ لِلرِّبْحِ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひえき": "فَائِدَة, جَدْوَى",
 "ひえこみ": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة)\nمثال: سرت فيه رعشة مفاجئة / تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب)",
 "ひえこむ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひえつ": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل)",
 "ひえばら": "إِسْهَال",
 "ひえびえ": "ببرود (بافتقار لدفء المشاعر؛ بطريقة باردة غير عاطفية)\nمثال: خاطبها ببرود",
 "ひえん": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "ひえんざんし": "الكمية المحسوبة, مُعامَل (كمية يتم إجراء عملية رياضية عليها)",
 "ひえんそう": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور…)",
 "ひお": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف)",
 "ひおい": "مَظَلَّة",
 "ひおう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "ひおうぎ": "زنبق التوت, زنبق النمر (نبات حديقة تكشف كبسولته عند النضج عن كتلة من البذور تشبه التوت الأسود)",
 "ひおおい": "مَظَلَّة",
 "ひおしこうどう": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ひか": "تحت الجلد (متعلق بالمنطقة الواقعة تحت البشرة أو يقع فيها)\nمثال: إبرة تحت الجلد / رِثَاء, مَرْثِيَة / تَكَافُؤ, تَمَاثُل (مساواة وظيفية)",
 "ひかいじごうい": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "ひかえ": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / مُلَاحَظَة, مَلْحُوظَة / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)\nمثال: صنع نسخة للملفات",
 "ひかえかべ": "دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "ひかえがき": "مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "ひかえしつ": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "ひかえじょ": "صالة, غرفة انتظار (غرفة (كما في فندق أو مطار) بها مقاعد حيث يمكن للناس الانتظار)",
 "ひかえせんしゅ": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "ひかえちょう": "دَفْتَر, مُذَكِّرَة",
 "ひかえのま": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "ひかえめ": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ひかえめにいう": "قَلَّلَ",
 "ひかえる": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "ひかかんしょうてき": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة)\nمثال: عرض منتفخ ومفكك",
 "ひかがくてき": "غير علمي (لا يتسق مع أساليب أو مبادئ العلم)\nمثال: افتقار غير علمي للموضوعية",
 "ひかき": "سِطَام, مِسْعَار",
 "ひかきぼう": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "ひかく": "مُقَارَنَة / جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / بطامة (الجزء الخارجي المحمر من النواة العدسية)",
 "ひかくえんざんし": "عَلَاقَة",
 "ひかくかいぼうがく": "تشريح مقارن (دراسة السمات التشريحية للحيوانات من أنواع مختلفة)",
 "ひかくかのう": "قابل للمقارنة, مماثل (يمكن مقارنته أو يستحق المقارنة)",
 "ひかくきゅう": "دَرَجَة نِسْبِيَّة",
 "ひかくこうどうがく": "علم سلوك الحيوان (فرع علم الحيوان الذي يدرس سلوك الحيوانات في بيئاتها الطبيعية)",
 "ひかくてき": "نِسْبِيّاً",
 "ひかくにならない": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن…)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "ひかくぶそう": "سِلَاح نَوَوِيّ",
 "ひかくぶんか": "عبر الثقافات (يتعامل مع ثقافتين أو أكثر أو يقارن بينهما)\nمثال: مسح عبر الثقافات",
 "ひかくぶんがく": "أدب مقارن (دراسة الأعمال الأدبية من ثقافات مختلفة (غالباً مترجمة))",
 "ひかげ": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس…)\nمثال: نسي أن يطفئ النور.",
 "ひかげのかずら": "صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج…)",
 "ひかすいそ": "أرسين, زرنيخيد الهيدروجين (غاز سام عديم اللون وقابل للاشتعال يستخدم في التركيب العضوي ولتطعيم…)",
 "ひかすう": "مُضَاف إِلَيْهِ (عدد يضاف إليه عدد آخر)",
 "ひかぜい": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "ひかぜいひん": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "ひかそしき": "تحت الأدمة (طبقة من الخلايا تفرز الجليد الكيتيني في المفصليات مثلاً)",
 "ひかっせい": "خَامِد",
 "ひかつどう": "خَامِد",
 "ひかぶつ": "زرنيخيد (مركب من الزرنيخ مع عنصر أكثر إيجابية)",
 "ひかぶん": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "ひからかさ": "مَظَلَّة, شَمْسِيَّة",
 "ひからす": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひからびる": "صَعَقَ",
 "ひかり": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة) / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / إِضَاءَة / سَعَادَة, فَرَح / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "ひかりかがやく": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひかりかびんせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "ひかりかんじゅせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "ひかりきのこばえ": "يَرَاع, حَبَاحِب",
 "ひかりじき": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه)\nمثال: انتظر لحظة فقط",
 "ひかりでんどう": "موصلية ضوئية (تغير في الموصلية الكهربائية لمادة نتيجة لامتصاص الإشعاع الكهرومغناطيسي)",
 "ひかりとかげ": "بصيص أمل, جانب مضيء (جانب مواسٍ لموقف صعب)\nمثال: كل سحابة لها جانب مضيء",
