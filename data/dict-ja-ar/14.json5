 "はなはだ以て": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "はなはっか": "مَرْدَقُوش, مَرْدَقُوش بَرِّيّ",
 "はなばしら": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين)",
 "はなばたけ": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة.",
 "はなばち": "نَحْلَة",
 "はなばな": "زَهْرَة, زُهُور\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير / جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "はなばなしい": "باهِر",
 "はなひげ": "شَارِب",
 "はなひらく": "زَهْرَة\nمثال: أرى زهرة على المكتب. / زَهْرَة, زُهُور\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "はなひる": "عَطَسَ",
 "はなび": "مُفَرْقِعَات, أَلْعَاب نَارِيَّة\nمثال: すごい花火だ！ — هذه الألعاب النارية رائعة!",
 "はなびしそう": "إيشولتسية, خشخاش كاليفورنيا (من ساحل المحيط الهادئ لأمريكا الشمالية؛ يزرع على نطاق واسع لزهوره الصفراء إلى…)",
 "はなびせんこう": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر)\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "はなびびより": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر",
 "はなびら": "بَتَلَة, تُوَيْجَة",
 "はなふき": "مِنْدِيل, مَحْرَمَة",
 "はなふだや": "نينتندو",
 "はなぶさ": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "はなまがり": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "はなまち": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "はなまめ": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا)",
 "はなみ": "زَهْرَة كَرَز / أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / رَخْت",
 "はなみず": "مُخَاط, مُخَاط أَنْف",
 "はなみのうたげ": "زَهْرَة كَرَز",
 "はなむけ": "شم (فعل إدراك رائحة شيء ما)",
 "はなむこ": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد)",
 "はなむすび": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما)",
 "はなめ": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "はなめがね": "نظارة مشبك الأنف (نظارات تُثبت على الأنف بواسطة زنبرك)",
 "はなもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "はなもちならない": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "はなもちならぬ": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "はなもとしあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "はなもとじあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "はなもの": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "はなや": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة)\nمثال: صنع بائع الزهور باقة جذابة",
 "はなやか": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة)",
 "はなやさい": "قَرْنَبِيط, قُنَّبِيط",
 "はなやすり": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "はなよめ": "عَرُوس",
 "はなよめいしょう": "فستان زفاف (ثوب ترتديه العروس في حفل الزفاف)",
 "はなよめかいぞえにん": "وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف)",
 "はなよめがっこう": "مدرسة إتيكيت (مدرسة خاصة للفتيات تركز على التدريب في الأنشطة الثقافية والاجتماعية)",
 "はなよめごりょう": "عَرُوس",
 "はならび": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "はなる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "はなれさる": "تَخَلَّى عَن, تَوَقَّفَ",
 "はなればなれ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "はなれる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "はなれわざ": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه)",
 "はなれ技": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه)",
 "はなれ業": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه)",
 "はなろくしょう": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "はなわ": "إِكْلِيل / بُرَة",
 "はなをかむ": "اِمْتَخَطَ, مَخَطَ",
 "はなをさかせる": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "はなをすする": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "はなをそえる": "غريس",
 "はなをならす": "استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء)",
 "はなキャベツ": "قَرْنَبِيط, قُنَّبِيط",
 "はなクソ": "مُخَاط, مُخَاط أَنْف",
 "はなピ": "بُرَة",
 "はなピアス": "بُرَة",
 "はなピー": "بُرَة",
 "はな垂らし": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はな垂れ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はな垂れ小僧": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف)",
 "はな水": "مُخَاط, مُخَاط أَنْف",
 "はにかみ": "خَجَل, حَيَاء (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "はにきぬきせない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "はにきぬきせぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "はにきぬをきせない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "はにきぬをきせぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "はにく": "لِثَة, لَثَة",
 "はにゅうのやど": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "はぬけ": "خلو الفم من الأسنان, درد (حالة أو وضعية عدم وجود أسنان)\nمثال: بشكل غير متوقع، استحضر صورة طبيب الأسنان المسؤول عن خلو فمه من الأسنان / انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "はね": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟ / جَنَاح / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة…)\nمثال: لن نصل إلى أي مكان. / رِيشَة / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "はねあがり": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض)\nمثال: تقدم بسلسلة من القفزات / تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "はねあがりもの": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はねあがる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة. / يتسرع",
 "はねあげ": "قَابِل لِلرَّفْع (مصمّم بحيث يمكن رفعه أو طيه جانباً)",
 "はねあげど": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "はねあげる": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "はねいた": "منطلق",
 "はねおと": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "はねかえす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة)",
 "はねかえり": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はねかえる": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねかくし": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "はねかける": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねかざり": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور)\nمثال: عمود من الدخان",
 "はねかす": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねぐるま": "دافعة (شفرة الدوار (كما في ضاغط المحرك النفاث))",
 "はねっかえり": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はねっ返り": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はねつき": "باتلدور (لعبة مضرب قديمة)",
 "はねつける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はねとばす": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "はねのける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はねばし": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "はねる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / انفجار (عملية الانفجار أو التفرقع)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / أَصَابَ\nمثال: تلقى مناد ضربة. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / قَلَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "はねペン": "إِبْرَة, شَوْكَة",
 "はね上げる": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "はね橋": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "はね返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة)",
 "はね返り": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はね飛ばす": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "はのね": "نَاب (مَثَّل مكان أحد ما، كان نَائِبا عنه)\nمثال: كم يكلف ناب الفيل؟",
 "はのようせい": "جِنِّيّ أَسْنَان (جَنِيَ يَجْنَى جَنًى: خرج ظهرُه ودخلَ صدرُه؛ فهو أَجْنى)",
 "はは": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははうえ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははうし": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "ははうじ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "ははおや": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははおやぎょう": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははおやらしい": "أُمِّيّ, أُمُومِيّ",
 "ははかた": "أُمِّيّ, أُمُومِيّ",
 "ははぎみ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははご": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははじゃ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははじゃひと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははとじ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははなる": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "ははのひ": "عِيد اَلْأُمّ",
 "ははのみこと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "はば": "عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية",
 "はばかり": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام))",
 "はばかりさま": "شُكْرًا, تِسْلَم",
 "はばかりさん": "شُكْرًا, تِسْلَم",
 "はばかる": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "はばき": "طماق, غطاء ساق (رداء يغطي الساق (يمتد عادة من الركبة إلى الكاحل)) / إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "はばきき": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はばたき": "رَفْرَف",
 "はばたく": "رَفْرَف",
 "はばち": "دبور المنشار, ذبابة المنشار (حشرة تمتلك أنثاها آلة وضع بيض تشبه المنشار لإدخال البيض في أنسجة أوراق أو سيقان…)",
 "はばったい": "عَرِيض / مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "はばつ": "طُغْمَة, عُصْبَة",
 "はばつきんこう": "توازن القوى",
 "はばとび": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض)",
 "はばにする": "تَجَاهَلَ, طَنَّش / تَبَاهَى",
 "はばのせまい": "ضَيِّق",
 "はばのひろい": "عَرِيض",
 "はばひろ": "عَرِيض",
 "はばひろい": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "はばびろ": "عَرِيض",
 "はばむ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "はばり": "مِفْصَد, فَاصِد",
 "はびこる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "はふ": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون) / عجلة تلميع (عجلة مغطاة بمادة ناعمة)",
 "はふく": "بطن الموجة, نقطة التضاد ((في الفيزياء) نقطة الإزاحة القصوى في نظام دوري)",
 "はふらす": "تَجَاهَلَ, طَنَّش",
 "はぶ": "ذُو بُقَع صَفْرَاء (عليه بقع صفراء اللون)",
 "はぶく": "أَنْقَذَ, أَنْجَى\nمثال: حفظ رقم هاتفها.",
 "はぶそう": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف…)",
 "はぶにする": "تَجَاهَلَ, طَنَّش",
 "はぶり": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "はぶりがいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりがよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりのいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりのよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりの良い": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はへい": "مَقْبَض / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "はへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "はべらす": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はべり": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "はべる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はぼね": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "はま": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ. / يُوكُوهَامَا / ضفة النهر / رُقْيَة",
 "はまうつぼ": "هَالُوك, جَعْفِيل",
 "はまかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "はまかんざし": "بخل, تقتير (الحرص الشديد في إنفاق المال؛ التردد في إنفاق المال بلا ضرورة)",
 "はまき": "سِيجَار, سِيكَار",
 "はまきタバコ": "سِيجَار, سِيكَار",
 "はますげ": "سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "はまとびむし": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "はまな": "كرامبي, كرنب بحري (نبات معمر في الرمال الساحلية والحصى لشمال أوروبا وبحر البلطيق والبحر الأسود له…)",
 "はまなし": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "はまなす": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "はまひばり": "قبرة مقرنة",
 "はまびし": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "はまべ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "はまる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / رَضَّى",
 "はみ": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس) / بِت (انقطع؛ قَطَع) / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "はみがき": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "はみがきこ": "مسحوق الأسنان (مستحضر لتنظيف الأسنان في شكل مسحوق)\nمثال: 歯磨き粉はどこにありますか？ — أين معجون الأسنان؟",
 "はみがきざい": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "はみがきようじ": "فُرْشَاة أَسْنَان",
 "はみだし": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "はみだしもの": "مَنْبُوذ, مَنْبُوذَة",
 "はみだしもん": "مَنْبُوذ, مَنْبُوذَة",
 "はみだし者": "مَنْبُوذ, مَنْبُوذَة",
 "はみだす": "نَتَأَ / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみでる": "نَتَأَ / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出し": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "はみ出し者": "مَنْبُوذ, مَنْبُوذَة",
 "はみ出す": "نَتَأَ / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出る": "نَتَأَ / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はむ": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة…) / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はむかう": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "はむし": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور) / خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "はむしゃ": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة",
 "はむはむ": "قَضَمَ",
 "はむら": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "はめ": "لَجْنَة, لَجْنَة تَحْكِيم / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص)\nمثال: وجد نفسه في مأزق محرج للغاية / برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور)) / بِت (انقطع؛ قَطَع)",
