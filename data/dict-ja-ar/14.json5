 "ひかりりょうほう": "علاج ضوئي (استخدام الضوء القوي لعلاج حب الشباب أو فرط بيليروبين الدم لدى حديثي الولادة)",
 "ひかりをあてる": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "ひかりケーブル": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل…)",
 "ひかりディスク": "قرص ضوئي (قرص مطلي بالبلاستيك يمكنه تخزين البيانات الرقمية كحفر صغيرة محفورة في السطح…)",
 "ひかりファイバ": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل…)",
 "ひかりファイバー": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل…)",
 "ひかりファイバーケーブル": "ليفي بصري (مكون من أو متعلق بالألياف البصرية)",
 "ひかる": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひかるぼう": "عصا مضيئة (أنبوب بلاستيكي صغير يحتوي على مواد كيميائية تنتج ضوءاً عند كسرها)",
 "ひかん": "تَشَاؤُم / شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات…)\nمثال: ولد في فصل الشتاء. / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / قِنّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "ひかんざくら": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء…)",
 "ひかんしゅぎ": "تَشَاؤُم",
 "ひかんしゅぎしゃ": "مُتَشَائِم",
 "ひかんしょうてき": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة)\nمثال: عرض منتفخ ومفكك",
 "ひかんてき": "مُتَشَائِم",
 "ひかんびゃくしょう": "قِنّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "ひかんろん": "تَشَاؤُم",
 "ひかんろんしゃ": "مُتَشَائِم",
 "ひが": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "ひがあ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة.",
 "ひがい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة.",
 "ひがいしゃ": "ضَحِيَّة",
 "ひがいしゃさんかせいど": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ひがいもうそう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "ひがえりおんせん": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ひがくれる": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "ひがごと": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "ひがさ": "مَظَلَّة, شَمْسِيَّة / حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "ひがさす": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ひがし": "شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "ひがしかぜ": "رياح شرقية (رياح تهب من الشرق)",
 "ひがしかた": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "ひがしがた": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا)",
 "ひがしがわ": "الجانب الشرقي (الجانب الذي يقع في الشرق)",
