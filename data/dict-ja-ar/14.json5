 "はらいだし": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "はらいだす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "はらいど": "بيرليت (خليط صفائحي من السمنتيت والفيريت يتشكل أثناء تبريد الأوستنيت؛ أحد مكونات…)",
 "はらいのける": "يَدْرَأ",
 "はらいのこし": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "はらいのこり": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "はらいもどし": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً)",
 "はらいもどしきん": "إِعَادَة مَال",
 "はらいもどす": "جَازَى",
 "はらいわたす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "はらう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / طَرَدَ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / أخْلَا\nمثال: لقد ترك لك هذا.",
 "はらえ": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "はらおち": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらおどり": "رَقْص شَرْقِيّ, رَقْص بَلَدِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص.",
 "はらおび": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)",
 "はらか": "تَرُوتَة, أُطْرُوط",
 "はらがいる": "أَهْدَأَ, هَدَّأَ",
 "はらがきまる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "はらがくろい": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة)",
 "はらがけ": "مِرْيَلَة",
 "はらがふとい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "はらきり": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني…)",
 "はらぎたない": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة)\nمثال: في مزاج سيء",
 "はらくだし": "مُلَيّن / إِسْهَال",
 "はらくだり": "إِسْهَال",
 "はらぐろ": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "はらぐろい": "عَنَى, قَصَدَ",
 "はらこ": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك)",
 "はらさき": "تفريغ من المضمون (تغيير شيء ما (مثل قانون تشريعي أو بيان) بطريقة تقلل من قيمته)\nمثال: اعتماد تعديلاتهم كان سيعني تفريغ القانون من مضمونه",
 "はらじゅく": "هَارَاجُوكُو",
 "はらす": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)\nمثال: 彼は父の死の恨みを晴らした。 — انتقم لموت أبيه.",
 "はらすじ": "عضلة بطنية (عضلات البطن)",
 "はらたけ": "فطر الحقل, فطر المروج (فطر شائع صالح للأكل يوجد طبيعياً في التربة المفتوحة الرطبة؛ الفطر المزروع…)",
 "はらだたしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "はらだち": "غَضَب",
 "はらちがい": "أَبَوِيّ",
 "はらっぱ": "بَسِيط\nمثال: هذا الشعور سهل.",
 "はらづもり": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "はらにいちもつ": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "はらにおさめる": "احتفظ بكل شيء لنسفه",
 "はらにおちる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらにたまる": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "はらのすわった": "بَاسِل, جَرِيء (يتميز بالشجاعة والتصميم في مواجهة الصعوبات أو الخطر؛ قوي وغير مكبوت)\nمثال: عليك أن تعجب بها: كان شيئاً جريئاً للقيام به",
 "はらのそこ": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "はらのむし": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة…)",
 "はらはら": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم)",
 "はらびれ": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه…)",
 "はらへった": "أَنَا جَائِع, أَنَا جَائِعَة",
 "はらぺこ": "جَائِع, جَوْعَان",
 "はらぼて": "عرض, معرض (شيء يُعرض للجمهور)\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "はらまき": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة)",
 "はらませ": "تَلْقِيح",
 "はらみ": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "はらみた": "كَمَال, إتقان",
 "はらみった": "كَمَال, إتقان",
 "はらみつ": "كَمَال, إتقان / جاكية",
 "はらむ": "حَبِلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير. / اِحْتَوَى, تَضَمَّنَ",
 "はらもみのうち": "تَوَخَّى اَلْحِذْر",
 "はらやみ": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "はららご": "بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "はらり": "بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: قبلته بخفة على جبينه",
 "はらわた": "مِعًى / فَرَث / مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها…) / قَلْب, فُؤَاد",
 "はらわたのくさった": "فَاسِقٌ, مُنْحَرِف (يَنْحَرِفُ عَمَّا يُعْتَبَرُ أَخْلَاقِيًّا أَوْ صَحِيحًا أَوْ لَائِقًا)",
 "はらをきめる": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "はらをすえる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / تَحَمَّلَ, صَبَرَ",
 "はらん": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي / تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء)\nمثال: لم لا تبدل ملابسك؟ / حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل…)",
 "はらペコ": "جَائِع, جَوْعَان",
 "はらボテ": "عرض, معرض (شيء يُعرض للجمهور)\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "はり": "إِبْرَة, مِخْيَط / خَطَّاف / ضربة لاذعة (ضربة حادة مؤلمة)\nمثال: الطعنة الأكثر قسوة على الإطلاق / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة. / تَوَتُّر\nمثال: لا إنجاز بلا جهد . / القدرة على التعافي بعد الصدمة / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / مَرْو, كَوَارْتْز / زُجَاج, قزاز\nمثال: هل لي بكأس ماء؟ / إِبْرَة, مِخْيَط / الوَخْز بِالْإِبْر / خَشَبَة",
 "はりあい": "مُنَافَسَة, مُبَارَاة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو…)\nمثال: دافع عن الضعفاء.",
 "はりあいのない": "مُحْبِط, مُثَبِّط",
 "はりあう": "تَنَافَسَ, تَبَارَى",
 "はりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "はりあな": "ثقب دبوس (ثقب صغير ربما يكون قد صنع بواسطة دبوس)",
 "はりうなぎ": "إلفير (صغير الأنقليس)",
 "はりえ": "كولاج, مونتاج (تجميع ولصق مصنوع عن طريق لصق قطع من الورق أو الصور معاً لتشكيل صورة فنية)\nمثال: استخدم حاسوبه لعمل كولاج من الصور مركبة على خريطة",
 "はりえんじゅ": "شَجَرَةُ الْجَرَادِ, سَنْطٌ كَاذِبٌ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "はりお": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في…)",
 "はりかえる": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "はりかた": "قَضِيب اِصْطِنَاعِيّ",
 "はりがた": "قَضِيب اِصْطِنَاعِيّ",
 "はりがね": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ :…)\nمثال: هذا السلك ساخن.",
 "はりがねざいく": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "はりがねせいぞうこうじょう": "شبك معدني, شبكة سلكية (شبكة مصنوعة من الأسلاك)",
 "はりがねむし": "دودة سلكية (يرقة تشبه الدودة لخنفساء النقر؛ تتغذى على جذور العديد من المحاصيل)",
 "はりがみ": "مُلْصَق / لَاحَظَ",
 "はりき": "أواني زجاجية (صنف من أدوات المائدة مصنوع من الزجاج) / صَلِيب\nمثال: عبر جرذ الطريق.",
 "はりぐすり": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "はりこ": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / خَيَّاطَة",
 "はりこのとら": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
 "はりこみ": "كمين مراقبة (مراقبة مكان أو شخص ما من قبل الشرطة (كما في توقع جريمة)) / نَاطُور / تجميع ولصق (تكوين من أشياء مسطحة ملصقة على لوح أو خلفية أخرى)\nمثال: أروه تجميعاً ولصقاً لغلاف الكتاب",
 "はりこむ": "عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق / أَلْصَقَ",
 "はりさける": "انفجار (عملية الانفجار أو التفرقع)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "はりさし": "وسادة الدبابيس (وسادة صلبة صغيرة تغرز فيها الدبابيس لتكون جاهزة للاستخدام)",
 "はりしごと": "أشغال الإبرة, تطريز (العمل الذي يتم بالإبرة (مثل الخياطة أو التطريز))",
 "はりじょう": "إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر)",
 "はりす": "قَائِد, زَعِيم",
 "はりせんぼん": "سمكة النيص (تنتصب أشواكها عندما ينتفخ الجسم؛ توجد عالمياً في المياه الدافئة)",
 "はりたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "はりだし": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه) / مُلْصَق, أَفِيش",
 "はりだしまど": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل)",
 "はりだす": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم. / عَارِضَة, عَارْضَة\nمثال: نشر توم الغسيل.",
 "はりつく": "غُصَيْن\nمثال: لا تمسك العصا من الوسط. / مَكَثَ, بَقِيَ",
 "はりつけ": "أَفِكْس / صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "はりつけばしら": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "はりつける": "أَلْصَقَ / إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "はりつめる": "سُلَالَة",
 "はりとばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "はりぬき": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "はりねずみ": "قُنْفُذ",
 "はりのめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ…)",
 "はりばん": "نَاطُور",
 "はりびゆ": "قطيفة شائكة (نبات حولي قائم في آسيا الوسطى الاستوائية وأفريقيا له زوج من الأشواك المتباعدة…)",
 "はりふだ": "مُلْصَق, أَفِيش",
 "はりほどのことをぼうほどにいう": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "はりぼて": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / زَائِف, مُتَظَاهَر بِه (مُتَّخَذ بغرض الخداع والتضليل)",
 "はりめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ…)",
 "はりもぐら": "قَصِير المِنْقَار (ذو منقار قصير)",
 "はりやま": "وسادة الدبابيس (وسادة صلبة صغيرة تغرز فيها الدبابيس لتكون جاهزة للاستخدام)",
 "はりん": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "はり札": "مُلْصَق, أَفِيش",
 "はり薬": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "はる": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة. / السَّنَة الْجَدِيدَة / مُمْتَاز, فَاخِر / مُرَاهَقَة / غُصَيْن\nمثال: لا تمسك العصا من الوسط. / تَمَدَّدَ / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / مَلَأَ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "はるあき": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما)\nمثال: أيام الملك الأخيرة",
 "はるあさし": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "はるか": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / قَدِيماً",
 "はるかかなた": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "はるかに": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل / قَدِيماً",
 "はるかむかし": "قَدِيماً",
 "はるか彼方": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "はるぎ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "はるごま": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب)",
 "はるじおん": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة…)",
 "はるじょおん": "يرغوث فيلادلفيا (نبات جميل بشكل خاص له هامش دقيق من الأشعة الخيطية حول رؤوس الزهور ذات الأشعة…)",
 "はるたうち": "السَّنَة الْجَدِيدَة",
 "はるにみっかのはれまなし": "طقس جيد (طقس مناسب للأنشطة الخارجية)",
 "はるののげし": "تِفَاف, جَعْضِيض",
 "はるのみや": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "はるのめざめ": "بُلُوغ",
 "はるばる": "حتى النهاية, طوال الطريق (إلى الهدف)\nمثال: تسلقت الجبل حتى النهاية",
 "はるまき": "سبرينغ رول, لفافة البيض (خضروات ولحم مفروم ملفوف في فطيرة ومقلية)",
 "はるやすみ": "عُطْلَة الرَّبِيع, إِجَازَة الرَّبِيع",
 "はれ": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء))\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "はれがましい": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ)",
 "はれぎ": "أفضل الثياب, ملابس الأحد (أفضل الملابس التي يمتلكها الشخص والتي تلبس عادة للكنيسة يوم الأحد)",
 "はれつ": "انفجار (عملية الانفجار أو التفرقع)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / تَوَزُّع",
 "はれて": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "はればれ": "لَامِع, نَيِّر / شَفَّاف",
 "はればれしい": "شَفَّاف",
 "はれぼったい": "ذُو هَبَّات, هَبُوب (يَهُبّ عَلَى شَكْل هَبَّات أَوْ نَفَحَات مُتَقَطِّعَة)",
 "はれま": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "はれもの": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء))\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "はれものにさわるよう": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "はれやか": "شَفَّاف",
 "はれる": "اِنْتَفَخَ, وَرِمَ / جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "はれん": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "はれんち": "وَقِح, صَفِيق",
 "はれんちかん": "أَعْرَج",
 "はろう": "لَوَّحَ, رَفْرَفَ / هروب من السجن (هروب من السجن)\nمثال: تم التخطيط للهروب بعناية",
 "はろうちゅういほう": "أعالي البحار, مياه دولية (البحار المفتوحة في العالم خارج المياه الإقليمية لأي دولة)",
 "はわうじ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "はわく": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "はわじゃ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "はわじゃひと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "はをたてる": "عَضَّ, قَضَمَ",
 "はをとなえる": "سَيْطَرَ",
 "はをみがく": "نَظَّفَ الْأَسْنَان\nمثال: タロー君、歯を磨いていらっしゃい。 — يا تارو روح وفرش أسنانك.",
 "はん": "فُقْمَة\nمثال: ختم سامي القرآن في شهر رمضان. / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / مَقَاس, قِيَاس / نِصْف, نُصْف / عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / أُسْرَة هَان / ضِدّ, مُضَادّ / تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن)\nمثال: نظريته هي عكس نظريتي تماماً / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / طَبْعَة / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / فِرْقَة, جَمَاعَة / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية / مِثَال, مَثَل / مُشْكِلَة, مَتاعِب / جَرِيمَة, جِنَايَة\nمثال: ハイジャック犯達は飛行機の後部に移った。 — تحركوا خاطفو الطائرة الى مؤخرة الطائرة . / سيد (صيغة خطاب للرجل) / تَعْقِيد / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / أُوسَاكَا",
 "はんあい": "عمل خيري, هدية خيرية (التعزيز الطوعي لرفاهية الإنسان)",
 "はんい": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على…)\nمثال: احس سامي بالحقد. / اِتِّسَاع, مَدَّى",
 "はんいご": "عَكْس",
 "はんいしき": "ترنح, ذهول (وعي هامشي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات / فِقْدَان اَلْوَعْي, إِغْمَاء / عقل باطن, لاوعي (حالة ذهنية غير متاحة للوعي المباشر)",
 "はんいんえい": "شِبْه ظِلّ",
 "はんいんよう": "خُنْثَى",
 "はんえい": "شِبْه ظِلّ / اِزْدِهَار, رَخَاء / اِنْعِكَاس, عَكْس / تَطْبِيق\nمثال: هذا الكتاب جديد",
 "はんえいきゅうてき": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "はんえいゆう": "بطل مزيف, بطلة مزيفة",
 "はんえり": "قطعة رقبة (قطعة من الملابس تلبس حول الرقبة)",
 "はんえん": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة) / تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة…)",
 "はんえんけい": "نِصْف دَائِرِيّ (منحنٍ على شكل نصف دائرة)",
 "はんえんアーチ": "قوس روماني, قوس نصف دائري (قوس مستدير مرسوم من مركز واحد)",
 "はんおう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد. / مَاهَارَاجَا",
 "はんおん": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "はんおんかい": "سلم كروماتيكي, سلم لوني (سلم مكون من 12 نغمة يتضمن جميع أشباه النغمات في الأوكتاف)",
 "はんか": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ)\nمثال: عدم كفاية إعانات البطالة / صخب, ضجة (اضطراب نشط وسريع) / تَعْمِيم",
 "はんかいおん": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "はんかがい": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "はんかくさい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はんかくめい": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "はんかこ": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "はんかつう": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما)\nمثال: تم تلقي حفنة فقط من الردود / مُتَطَفِّل, هَاوٍ سَطْحِيّ (يُظهِر اهتمامًا سطحيًّا أو تافهًا؛ على مستوى الهواة)",
 "はんかん": "مشاعر مناهضة / مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات…)",
 "はんかんすう": "عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "はんかんそう": "شِبْه قَاحِل (قاحل إلى حدٍّ ما)",
 "はんかんてき": "شِبْه رَسْمِيّ (له بعض السلطة أو الإقرار الرسميّ)",
 "はんが": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات)",
 "はんがか": "صانع طباعة, فنان غرافيكي (فنان يصمم ويصنع المطبوعات)",
 "はんがた": "تنسيق, شكل (المظهر العام لمنشور)",
 "はんがん": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / مُفَتِّش, مُفَتِّشَة / فَرْفُورِيُوس",
 "はんき": "عطلة نصف الفصل (إجازة قصيرة في منتصف الفصل الدراسي تقريباً)\nمثال: جاء للزيارة في عطلة نصف الفصل",
 "はんきかん": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض…)",
 "はんきっぷ": "بنصف السعر (مقابل نصف السعر)\nمثال: اشترته بنصف السعر أثناء التخفيضات",
 "はんきゅう": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب) / نِصْف كُرَة",
 "はんきゅうけい": "نِصْف كُرَة",
 "はんきょう": "صَدًى / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق)\nمثال: رد فعل سيء للدواء",
 "はんきょうげんご": "ترديد مرضي, مصاداة ((طب نفسي) تكرار ميكانيكي وبلا معنى لكلمات شخص آخر (كما في الفصام))",
 "はんきょうていい": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "はんきょうらん": "مُجَنَّن, مُختَلُّ العَقْل (دُفِع إلى الجنون؛ فَقَدَ عقله)",
 "はんきんぞく": "شِبْهُ فِلِزِّيّ (عُنْصُرٌ لَا فِلِزِّيٌّ لَهُ بَعْضُ خَصَائِصِ الفِلِزَّات)",
 "はんきんるい": "كرامبون, نصل تسلق (مسمار حديدي يركب في الحذاء لمنع الانزلاق على الجليد عند المشي أو التسلق)\nمثال: بدا المتسلق القائد قوياً ولكن شريكه كان يترنح غالباً في حباله",
 "はんぎ": "طَابُوقَة",
 "はんぎご": "عَكْس",
 "はんぎゃく": "خِيَانَة",
 "はんぎゃくざい": "خِيَانَة",
 "はんぎゃくしゃ": "مُتَمَرِّد, مُتَمَرِّدَة",
 "はんぎゃくにん": "مُتَمَرِّد, مُتَمَرِّدَة",
