 "ひょっこり": "فَجْأَةً",
 "ひょっと": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال))\nمثال: ربما ستتصل غداً / عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "ひょっとこ": "مُهَرِّج",
 "ひょっとしたら": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال))\nمثال: ربما ستتصل غداً",
 "ひょっとすると": "رُبَّمَا\nمثال: يا لها من جملة!",
 "ひょろい": "مُمْتَدّ وَنَحِيل (طَوِيل وَنَحِيف كَالمِغْزَل)",
 "ひょろける": "تَرَنُّح",
 "ひょろっと": "طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم)",
 "ひょろつく": "تَرَنُّح",
 "ひょろながい": "طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم)",
 "ひょろひょろ": "بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل / طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم)",
 "ひょろり": "طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم)",
 "ひょろ長い": "طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم)",
 "ひょんな": "غَرِيب, عَجِيب",
 "ひょんなことから": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة.",
 "ひょんな事から": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة.",
 "ひよう": "سَاوَى, كَلَّفَ / طيران (حالة السفر جواً)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
