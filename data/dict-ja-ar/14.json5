 "ひんもうるい": "قليلات الأشواك (ديدان حلقية خنثوية برية ومائية لها شعيرات محمولة بشكل فردي على طول الجسم)",
 "ひんもく": "بَنْد",
 "ひんやり": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "ひんよく": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "ひん剥く": "قَشَّرَ",
 "ひん抜く": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "ひん斥": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ひん曲がる": "لَوَى, بَرَمَ",
 "ひん曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / شَوَّهَ",
 "ひアクティブか": "إبطال مفعول, تعطيل (فعل التعطيل أو جعل الشيء غير فعال (مثل القنبلة))",
 "ひイオンけいごうせいせんざい": "منظف أنيوني, منظف لا أيوني (فئة من المنظفات الاصطناعية التي لا تتأين جزيئاتها في المحاليل المائية)",
 "ひシールド": "غَيْر مُدَرَّع ((خاصة عن الآلات) غير محميّ بدرع واقٍ)",
 "ひステロイドせいこうえんしょうやく": "مضاد التهاب غير ستيرويدي (دواء مضاد للالتهاب لا يحتوي على الستيرويدات)\nمثال: مضادات الالتهاب غير الستيرويدية تثبط نشاط كل من إنزيمات كوكس-1 وكوكس-2",
 "ひフか": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ひフレームけいしき": "غير مؤطر (غير مزود بإطار)\nمثال: صور غير مؤطرة",
 "ひモテ": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "ひユークリッドきかがく": "هندسة لاإقليدية ((رياضيات) هندسة قائمة على بديهيات تختلف عن بديهيات إقليدس)",
 "ひーこら": "إجهاد, توتر (مجهود مكثف أو عنيف)",
 "ひ弱": "ضَعِيف",
 "ひ弱い": "ضَعِيف",
 "ひ押し坑道": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ひ押坑道": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ひ石": "غَثّ, شَوْب (الحيوان والإنسان: عجف وهزل، ضد سمن؛ غَثَّت الشاة، ق)",
 "び": "جَمَال, زَيْن / دِقَّة مُتَنَاهِيَة (دقة كبيرة؛ اهتمام دقيق بالتفاصيل)\nمثال: فحص المقال بأقصى درجات الدقة",
 "びいびい": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "びいんとう": "بلعوم أنفي (تجويف يشكل الجزء العلوي من البلعوم)",
 "びう": "حَاجِب (قوس الشعر فوق كل عين)\nمثال: غربت الشمس خلف قمة التلال البعيدة / رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ)",
 "びえん": "التهاب الأنف, زكام (التهاب الغشاء المخاطي المبطن للأنف (يرتبط عادة بإفرازات أنفية))",
 "びおん": "فتور (نقص في العاطفة أو القوة أو الحيوية) / أَنْفِي",
 "びおんか": "غُنَّة",
 "びおんてき": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \":…)",
 "びか": "تَجْمِيل / تعظيم, تمجيد (فعل التمجيد (كما في العبادة))\nمثال: تمجيد الله",
 "びかせき": "أحفورة مجهرية (أحفورة يجب دراستها مجهرياً)",
 "びかびか": "نَظِيف",
 "びがく": "استطيقا, علم الجمال ((فن) فرع الفلسفة الذي يتعامل مع الجمال والذوق (مع التركيز على المعايير…)\nمثال: افترض علم الجمال التقليدي وجود معايير عالمية وخالدة للقيمة الفنية",
 "びがくてき": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع)\nمثال: الملكات الجمالية",
 "びがんじゅつ": "تنظيف بشرة, علاج الوجه (عناية بالوجه تتضمن عادةً التنظيف والتدليك ووضع الكريمات التجميلية)\nمثال: تدليك وجهي",
 "びき": "جَمَال, زَيْن / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "びきかんえん": "التهاب الأنف والقصبة الهوائية (عدوى تنفسية في الأنف والحلق في الماشية)",
 "びぎょう": "جَمَال, زَيْن",
 "びく": "سلة صيد السمك (سلة خوص يستخدمها الصيادون لحفظ السمك)",
 "びくう": "جوف الأنف ((جَوَّفَ) الشَّيْء: جعل لَهُ جوفا؛ (جَوَّفَ) الصَّيْد: طعنه فِي جَوْفه)",
 "びくだい": "وِسَادَة, مِخَدَّة (ما يوضع تحت الرأس عند النوم أو الاستلقاء)",
 "びくとも": "على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم ولو قليلاً؟",
 "びくともしない": "غَيْرُ مُضْطَرِب, مُطْمَئِنّ (خالٍ من الاضطراب العاطفيّ والتوتّر العصبيّ) / عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط)",
 "びくびく": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "びくん": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "びけ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "びけい": "جَمَال, زَيْن",
 "びけいすう": "دالة مشتقة, مشتقة (نتيجة التفاضل الرياضي؛ التغيير اللحظي لكمية بالنسبة لأخرى)",
 "びけいせいじゅつ": "تجميل الأنف (جراحة تجميلية لتحسين مظهر الأنف)",
 "びけつ": "مَنْخَر",
 "びげつ": "هِلَال",
 "びこう": "مُلَاحَظَة, مَلْحُوظَة / ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / مَنْخَر / جوف الأنف ((جَوَّفَ) الشَّيْء: جعل لَهُ جوفا؛ (جَوَّفَ) الصَّيْد: طعنه فِي جَوْفه) / تعقب سري, مراقبة (فعل اتباع شخص ما سراً)",
 "びこうかい": "قُرَيْن أَنْفِي, مَحَارَة أَنْفِيَّة (واحدة من عدة عظام قرينية الشكل في التجويف الأنفي)",
 "びこうぶ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة)",
 "びこうらん": "مُلَاحَظَة, مَلْحُوظَة",
 "びこつ": "عظم أنفي (عظم مستطيل الشكل يشكل جسر الأنف) / عُصُص, عُصْعُص",
 "びこん": "أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "びご": "هُرَاء, لَغْو",
 "びさい": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في…)\nمثال: استأذنت لدقيقة.",
 "びさいこうぞう": "بنية دقيقة (وجود مجموعات من خطوط الطيف المتقاربة التي لوحظت في الطيف الذري لعناصر معينة)\nمثال: البنية الدقيقة تنتج عن مستويات طاقة مختلفة قليلاً",
 "びさくるい": "حبلي الذيل, غلالية (حيوان بحري بدائي له جسم يشبه الكيس غير مقسم وحبل ذيلي يكون واضحاً في اليرقة)",
 "びざい": "جُنْحَة",
 "びしっと": "بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: قالت بصرامة: 'لا' / بأناقة, على الموضة (بطريقة عصرية وأنيقة)\nمثال: كان يرتدي ملابس أنيقة",
 "びしつ": "فَضِيلَة",
 "びしてき": "مِجْهَرِيّ, مِيكْرُوسْكُوبِيّ (صغير جداً لدرجة أنه لا يُرى بدون مجهر)\nمثال: تحليل مجهري",
 "びしばし": "بحتة, بشكل صارم (مقتصر على شيء ما)\nمثال: تحدثنا في العمل فقط (بشكل صارم) / بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "びしびし": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "びしゃびしゃ": "مَنْقُوع / رش, طرطشة (فعل نثر الماء بشكل عشوائي)",
 "びしゅ": "مُرْتَفِع الدَّرَجَة",
 "びしゅう": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "びしゅうい": "حول أنفي (يقع بالقرب من الأنف)",
 "びしゅっけつ": "رُعَاف",
 "びしょう": "مِجْهَرِيّ, مِيكْرُوسْكُوبِيّ (صغير جداً لدرجة أنه لا يُرى بدون مجهر)\nمثال: تحليل مجهري / طَفِيف / اِبْتِسَامَة, بَسْمَة / تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "びしょういん": "صالون, صالون تجميل (محل يعمل فيه مصففو الشعر وأخصائيو التجميل)",
 "びしょうかん": "نُبَيب دقيق (نُبيب صغير جداً مجهري)",
 "びしょうじ": "ضَئِيل",
 "びしょくか": "ذواقة, محب للطعام (شخص مكرس للاستمتاع الحسي المترف (خاصة الطعام والشراب الجيد))",
 "びしょくがく": "فَنّ اَلْأَكْل (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "びしょくしゅぎ": "أبيقورية, تلذذ (طبع وعادات الأبيقوري (المحب للملذات))",
 "びしょぬれ": "مُبْتَلّ تَمَامًا, مُشَبَّع بِالْمَاء (مبلَّل كلّيًّا ومشبَّع بالماء)",
 "びしょびしょ": "مَنْقُوع / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "びしょ濡れ": "مُبْتَلّ تَمَامًا, مُشَبَّع بِالْمَاء (مبلَّل كلّيًّا ومشبَّع بالماء)",
 "びしり": "بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: قالت بصرامة: 'لا' / بأناقة, على الموضة (بطريقة عصرية وأنيقة)\nمثال: كان يرتدي ملابس أنيقة",
 "びしん": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً…)\nمثال: أقطف الزهرة بنفسي.",
 "びじゃく": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة)",
 "びじゅう": "مُخَاط, مُخَاط أَنْف / كَيْمُوس",
 "びじゅうもう": "زُغَيْبَة",
 "びじゅく": "كَيْمُوس",
 "びじゅつ": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "びじゅつうんどう": "حركة فنية (مجموعة من الفنانين يتفقون على مبادئ عامة)",
 "びじゅつか": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "びじゅつかん": "غاليري, معرض فني (غرفة أو سلسلة من الغرف حيث يتم عرض الأعمال الفنية)",
 "びじゅつかんとく": "مدير فني (المخرج المسؤول عن الجوانب الفنية لإنتاج مسرحي (الأزياء والمناظر والإضاءة))",
 "びじゅつがっこう": "مدرسة فنون (مدرسة متخصصة في الفن)",
 "びじゅつこうげい": "حرف يدوية, فنون وحرف (فنون التصميم الزخرفي والحرف اليدوية)\nمثال: رعوا الفنون والحرف اليدوية لتشجيع الحرفية في عصر الإنتاج الضخم",
 "びじゅつし": "تاريخ الفن (التخصص الأكاديمي الذي يدرس تطور الرسم والنحت)",
 "びじゅつしか": "مُؤَرِّخ الفَنّ, مُؤَرِّخة الفَنّ",
 "びじゅつしょう": "تاجر فنون (تاجر في الأعمال الفنية التي تتطلب تقييماً جمالياً)",
 "びじゅつてき": "ذَوَّاقِيّ, فَنِّيّ (يُلبّي المعايير والحساسيات الجمالية)\nمثال: خلفيته الفنية",
 "びじゅつてん": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))\nمثال: その美術展は今京都で開かれています。 — يعقد الآن المعرض الفني في كيوتو.",
 "びじゅつてんらんかい": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "びじゅつはくぶつかん": "غاليري, معرض فني (غرفة أو سلسلة من الغرف حيث يتم عرض الأعمال الفنية)",
 "びじゅつひょうろんか": "ناقد فني (ناقد للوحات الفنية)",
 "びじゅつひん": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "びじょう": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب. / شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية)\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية / إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "びじょうか": "نورة هرية, هريرة (نورة أسطوانية تشبه السنبلة)",
 "びじょうかく": "نواة مذنبة (عقدة قاعدية على شكل ذيل تقع في بطين جانبي للدماغ)",
 "びじょうふ": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "びじょざくら": "رعي الحمام, فيربينا (أي من النباتات الأمريكية الاستوائية أو شبه الاستوائية العديدة من جنس رعي الحمام…)",
 "びじん": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى…)\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة / جَمَال, زَيْن",
 "びじんのゆ": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
