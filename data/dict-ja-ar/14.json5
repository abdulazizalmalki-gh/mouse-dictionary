 "ばいやく": "دواء مسجل براءة اختراع (دواء محمي ببراءة اختراع ومتاح بدون وصفة طبية من الطبيب)",
 "ばいやくしょう": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "ばいやくずみ": "مباع (تم التصرف فيه لمشتري)\nمثال: هذه البضاعة مباعة",
 "ばいやくてん": "صيدلية (متجر تجزئة تباع فيه الأدوية وسلع أخرى)",
 "ばいよう": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة. / تَهْذِيب",
 "ばいようえき": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع…)",
 "ばいようき": "مُتَوَسِّط",
 "ばいようし": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "ばいようど": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "ばいりつ": "تكبير (عملية توسيع شيء ما في الحجم الظاهري)",
 "ばいりょく": "مؤازر آلي (من أو ينطوي على آليات مؤازرة (سيرفو))",
 "ばいりん": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار…)",
 "ばいをふくむ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ)\nمثال: روى نكتة مضحكة جداً",
 "ばい菌": "جُرْثُومَة / خَشَاش, هَامَّة",
 "ばえ": "جَذَّاب, مُغْرٍ (قادر على جذب الاهتمام أو لفت الانتباه الإيجابي)\nمثال: أضاف شخصية جذابة لا تُنسى إلى الأساطير الأمريكية الشعبية",
 "ばおくれ": "رَهَاب المَسْرَح",
 "ばか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / غَبِيّ / تافِه / متعطل, مختل وظيفياً (لا يؤدي أو غير قادر على أداء وظيفته العادية)\nمثال: صمام متعطل",
 "ばかあたり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو…)",
 "ばかく": "جلد الحصان (جلد مصنوع من إهاب الحصان)",
 "ばかくさい": "عَبَثِيّ, سَخِيف",
 "ばかげた": "عَبَثِيّ, سَخِيف",
 "ばかさわぎ": "مزاح خشن (لعب صاخب أو خشن)",
 "ばかざめ": "قرش متشمس (قرش شمالي كبير غير ضار يتغذى على العوالق؛ غالباً ما يسبح ببطء أو يطفو على سطح…)",
 "ばかし": "حَوَالَيْ, تَقْرِيبًا / وَحِيد / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "ばかじん": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "ばかす": "أَرْبَكَ",
 "ばかすか": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ばかず": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "ばかたれ": "أحمق, غبي (شخص غبي وغير كفء)",
 "ばかちん": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ばかっぽい": "غَبِيّ",
 "ばかでかい": "ضَخْم, هَائِل",
 "ばかでもチョンでも": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ばかとてんさいはかみひとえ": "هُنَاكَ, يُوجَدُ",
 "ばかどり": "قَطْرَس (طائر بحري كبير)",
 "ばかなまね": "حماقة, طيش (سلوك أحمق أو لا معنى له)",
 "ばかに": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "ばかにする": "سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا:…)\nمثال: سخر المدرس من جسمي.",
 "ばかにつけるくすりはない": "هُنَاكَ, يُوجَدُ",
 "ばかはっけんき": "تَغْرِيد",
 "ばかばかしい": "عَبَثِيّ, سَخِيف",
 "ばかばなし": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "ばかみたい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ばかもの": "مُغَفَّل, أَحْمَق",
 "ばかもやすみやすみいえ": "أَعْطِنِي",
 "ばかもん": "مُغَفَّل, أَحْمَق",
 "ばかやろう": "أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)\nمثال: 俺は人事課の馬鹿野郎にあごで指図されるつもりはない。 — لن يحكمني غبي من قسم الموارد البشرية.",
 "ばかよけ": "مُحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "ばからしい": "عَبَثِيّ, سَخِيف",
 "ばかり": "وَحِيد / حَوَالَيْ, تَقْرِيبًا / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ばかりでなく": "أَيْضًا",
 "ばかりに": "لِأَنَّ / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ばかわらい": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "ばかをいえ": "أَعْطِنِي",
 "ばかチョンカメラ": "كاميرا صوّب والتقط, كاميرا مدمجة (كاميرا تصوير خفيفة الوزن ذات تركيز تلقائي)",
 "ばがいしじょう": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة…) / سوق التجزئة (السوق لبيع السلع أو الخدمات للمستهلكين بدلاً من المنتجين أو الوسطاء)",
 "ばがいとりひき": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "ばがば": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "ばがぼん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "ばきばき": "تصدع, شرخ (عملية إحداث شقوق في شيء ما)",
 "ばぎゃば": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "ばく": "دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى…) / مَعْرِض / تَابِير / موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه)\nمثال: انتظر لحظة فقط / إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم) / شَاسِع, وَاسِع",
 "ばくあつ": "موجة صادمة",
 "ばくえい": "مُخَيِّم",
 "ばくえき": "قِمَار, مُقَامَرَة",
 "ばくおん": "أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "ばくか": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري…) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / شُوغُون",
 "ばくが": "مَلْت",
 "ばくがとう": "سكر الشعير, مالتوز (سكر بلوري أبيض يتكون أثناء هضم النشويات)",
 "ばくぎ": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "ばくぐい": "اِلْتَهَمَ",
 "ばくげき": "تَفْجِير, قَصْف / حَمْلَة",
 "ばくげきき": "قَاذِفَة قَنَابِل",
 "ばくごう": "تَفْجِير",
 "ばくさい": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ)",
 "ばくし": "تَفْجِير, قَصْف",
 "ばくしゃ": "مُخَيِّم",
 "ばくしゅ": "بِيرَة, جِعَة",
 "ばくしゅく": "انحباس صوتي, انطباق (المرحلة الانحباسية الأولية للصامت الانفجاري)\nمثال: انفجار المصباح الكهربائي نحو الداخل",
 "ばくしょく": "اِلْتَهَمَ",
 "ばくしん": "شَحْطَة",
 "ばくじゅう": "نقيع الشعير (مالت غير مخمر أو قيد التخمير)",
 "ばくじゅうろか": "رش, نثر (فعل رش أو طرطشة الماء)",
 "ばくする": "دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق)\nمثال: اتهمتني بالكذب. / أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "ばくせい": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين…)",
 "ばくぜん": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "ばくそう": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر))\nمثال: ثمل بشدة",
 "ばくたい": "ضِمَادَة, عِصَابَة / عِنان",
 "ばくだい": "شَاسِع, وَاسِع\nمثال: ジョンは莫大な財産を相続した。 — ورث جون ثروة كبيرة.",
 "ばくだん": "قُنْبُلَة",
 "ばくだんマーク": "قُنْبُلَة",
 "ばくち": "قِمَار, مُقَامَرَة / تَكَهُّنٌ / مُبَاغِت, مُفَاجِئ",
 "ばくちく": "مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك)",
 "ばくちやど": "بيت قمار, وكر قمار (مبنى عام يمكن فيه لعب مجموعة متنوعة من ألعاب الحظ (يُدار كعمل تجاري))",
 "ばくちん": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "ばくと": "مُقَامِر",
 "ばくとした": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "ばくなき": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "ばくねん": "اشتعال سريع, تفرقع (احتراق ينتشر عبر غاز أو على سطح مادة متفجرة بمعدل سريع مدفوعاً بنقل الحرارة) / طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "ばくは": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "ばくはつ": "اِنْفِجَار, تَفْجِير / فورة, نوبة (اضطراب عنيف مفاجئ)\nمثال: اندلاع أمطار غزيرة",
 "ばくはつかん": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء…)",
 "ばくはつじこ": "اِنْفِجَار, تَفْجِير",
 "ばくはつてき": "اِنْفِجَارِيّ, مُتَفَجِّر",
 "ばくはつぶつ": "اِنْفِجَارِيّ, مُتَفَجِّر",
 "ばくはつガス": "غاز المناجم, فايردامب (خليط من الغازات (معظمها الميثان) يتشكل في مناجم الفحم ويصبح متفجراً عند اختلاطه…)",
 "ばくはんたいせい": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع…)",
 "ばくばく": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم) / دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ / بحماس, بقلب قوي (بمتعة ودون تحفظ)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "ばくふ": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين…) / شَلَّال",
 "ばくふう": "انفجار قنبلة (انفجار قنبلة)",
 "ばくやく": "اِنْفِجَارِيّ, مُتَفَجِّر",
 "ばくよう": "قِمَار, مُقَامَرَة",
 "ばくらい": "قنبلة أعماق (قنبلة تنفجر عند عمق محدد مسبقاً تحت الماء؛ جهاز مضاد للغواصات)",
 "ばくりゅうしゅ": "خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "ばくりょう": "طَاقَم, طَاقِم",
 "ばくりょうちょう": "رئيس أركان الجيش",
 "ばくれつ": "اِنْفَجَرَ",
 "ばくれつだん": "قُنْبُلَة",
 "ばくろ": "إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)",
 "ばくろん": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "ばく然": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "ばく進": "شَحْطَة",
 "ばぐ": "عِنان",
 "ばけがく": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء.",
 "ばけのかわ": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ばけもの": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "ばけものやしき": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "ばけもん": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "ばける": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / تَحَوَّلَ, مَسَخَ (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "ばけチェック": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "ばげん": "تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "ばさばさ": "سرقة الماشية (سرقة الماشية) / غَيْرُ مَصُون, مُهْمَل (لَا يُعْتَنَى بِهِ أَوْ يُصَانُ بِشَكْلٍ صَحِيح) / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد)\nمثال: السجق جاف نوعا ما. / بِشَكْل حَاسِم, بِشَكْل قَاطِع (بدرجة لا تقبل الجدل)\nمثال: قانون فيشر لعام 1918 رفع بشكل حاسم وضعهم وأجورهم",
 "ばさま": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة.",
 "ばさら": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم / تأنق مفرط (أسلوب وملابس المتأنق أو المغرور)",
