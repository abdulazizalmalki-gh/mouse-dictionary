 "ひたいしょう": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "ひたいをあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ひたいをよせあう": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ひたおしに": "بثبات",
 "ひたき": "صائد الذباب (العالم القديم) (أي من مجموعة كبيرة من الطيور المغردة الصغيرة التي تتغذى على…)",
 "ひたす": "اِبْتَلَّ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / مُبْتَلّ",
 "ひたすら": "بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "ひたと": "بِالْقُرْب مِن, بِجَانِب / مُبَاشَرَةً / فَجْأَةً",
 "ひたひた": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد)) / بثبات / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / بسرعة, سريعاً\nمثال: يعمل بسرعة",
 "ひたぶる": "مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح)",
 "ひたむき": "جَدِّي, جَادّ",
 "ひたん": "غَمّ, حُزْن",
 "ひだ": "طَوَى / تَفْصِيل, تَفَاصِيل\nمثال: اقرأ هذا الفصل. / صفيحة رقيقة (لوحة رقيقة)",
 "ひだい": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء))\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً / تضخم (تضخم غير طبيعي لجزء من الجسم أو عضو)",
 "ひだいか": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء))\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "ひだいした": "متضخم ((عن عضو أو جزء من الجسم) متضخم بشكل مفرط نتيجة لزيادة حجم الخلايا المكونة له)\nمثال: ألياف عضلة القلب المتضخمة",
 "ひだえり": "دريجة شرسة",
 "ひだち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "ひだっそ": "جَمْرَة خَبِيثَة",
 "ひだね": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "ひだま": "كُرَة نَارِيَّة",
 "ひだり": "يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة)\nمثال: ذهب سامي إلى اليسار. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / شَارِب",
 "ひだりいどうみゃく": "شريان معدي أيسر (فرع من الشريان الزلاقي يغذي الانحناء الصغير للمعدة والجزء البطني من المريء)",
 "ひだりうちわ": "بحبوحة, رغد العيش (أمان مالي)",
 "ひだりうわて": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりきき": "أعسرية, عسر (تفضيل استخدام اليد اليسرى) / شَارِب",
 "ひだりぎっちょ": "أعسرية, عسر (تفضيل استخدام اليد اليسرى)",
 "ひだりだしゃ": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりづま": "غَيْشَا",
 "ひだりて": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة)\nمثال: ذهب سامي إلى اليسار.",
 "ひだりてざひょうけい": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりとう": "شَارِب",
 "ひだりとうしゅ": "رامٍ أعسر (رامي بيسبول يرمي الكرة باليد اليسرى)",
 "ひだりなげ": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだりまえ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "ひだりまき": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة! / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة",
 "ひだりまきまいまい": "حلزون الحديقة (أي من عدة حلزونات غير صالحة للأكل من جنس هيليكس؛ غالباً ما تكون آفات مدمرة)",
 "ひだりまわり": "دوران عكس عقارب الساعة, دوران يساري (دوران إلى اليسار)",
 "ひだりハンドル": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ひだりバッター": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "ひだるい": "جَائِع, جَوْعَان",
 "ひだ襟": "دريجة شرسة",
 "ひち": "سَبْعَة\nمثال: 私は今朝7時に起きた。 — استيقظت في السابعة هذا الصباح.",
 "ひちしゃ": "خَاضِع لِلْحُكْم, مَحْكُوم (يخضع لسلطة حاكمة)",
 "ひちゃくしゅつし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "ひちゅう": "سراً, في الخفاء (بسرية؛ ليس علناً)\nمثال: التقوا سراً",
 "ひちゅんちゃ": "هايسون (شاي أخضر صيني بأوراق ملتوية)",
 "ひちょう": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "ひちょうきん": "عضلة الساق التوأمية (العضلة الموجودة في الجزء الخلفي من الساق التي تشكل الجزء الأكبر من ربلة الساق…)",
 "ひちょうわ": "مُتَنَافِر",
 "ひちょっけつ": "غَيْر مُتَّصِل, غَيْر مُتَوَاجِد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひっかえす": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "ひっかかり": "مَسَكَ, مسك / صِلَة, صُلَة / عدم ارتياح, قلق (سمة عدم الارتياح)",
 "ひっかかる": "اِنْخَدَعَ بِـ / رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ひっかききず": "خَرْبَشَ",
 "ひっかきまわす": "مُسْتَاء, مُمْتَعِض",
 "ひっかき傷": "خَرْبَشَ",
 "ひっかく": "خَرْبَشَ",
 "ひっかけ": "خَطَّاف / شَرَكٌ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في…)\nمثال: هذه شركة صينية.",
 "ひっかけかぎ": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "ひっかけもんだい": "سُؤَال خَادِع (سُؤَال)\nمثال: أجب على السؤال.",
 "ひっかける": "خَطَّاف / غَشَّ / شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "ひっかけシーリング": "مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)",
 "ひっかけ問題": "سُؤَال خَادِع (سُؤَال)\nمثال: أجب على السؤال.",
 "ひっかけ鉤": "خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "ひっき": "نسخ (فعل النسخ) / مُلَاحَظَة, مَلْحُوظَة",
 "ひっきしゃ": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات)",
 "ひっきちょう": "دَفْتَر, مُذَكِّرَة",
 "ひっきょう": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ひっきょうするに": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ひっきようぐ": "أداة كتابة (أداة تستخدم للكتابة)",
 "ひっきりなし": "مُتَوَاصِل, مُتَّصِل",
 "ひっきりなしに": "باستمرار",
 "ひっくい": "حَزين / قَصِير, قصير (ضد الطويل)\nمثال: حبل الكذب قصير. / عَمِيق, غَوِيط",
 "ひっくくる": "إِبَالَة, حُزْمَة",
 "ひっくりかえす": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくりかえる": "قَلَبَ",
 "ひっくりがえす": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくりがえる": "قَلَبَ",
 "ひっくり返す": "قَلَبَ / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ひっくり返る": "قَلَبَ",
 "ひっくるめて": "بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار)\nمثال: في الإجمال، أنا آسف لما حدث",
 "ひっけい": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة / دَلِيل, كُتَيِّب",
 "ひっけいひん": "ضَرُورَة, حَاجَة",
 "ひっけん": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "ひっこし": "مُتَحَرِّك",
 "ひっこしいわい": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "ひっこしや": "شركة نقل, شركة نقل أثاث (شركة تقوم بنقل ممتلكات عائلة أو شركة من موقع إلى آخر)\nمثال: كان عمال النقل حريصين جداً مع البيانو الكبير",
 "ひっこす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور.",
 "ひっこぬく": "مُقْتَطَف",
 "ひっこみ": "تَرَاجُع",
 "ひっこみじあん": "مَحْجُوز",
 "ひっこむ": "غَطَسَ / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "ひっこめる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "ひっさげる": "رَصَاص / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "ひっさつ": "مُمِيت / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ひっさらう": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟",
 "ひっし": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / حَتْمِيّ",
 "ひっしになって": "بإلحاح, بشكل عاجل (بإلحاح شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "ひっしゃ": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب. / نسخ (فعل النسخ)",
 "ひっしゅ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっしゅう": "إِجْبَارِيّ, إِلْزَامِيّ (مطلوب بموجب قاعدة أو نظام)",
 "ひっしょうふはい": "قهر, منعة (خاصية كونه صعباً أو مستحيلاً هزيمته)",
 "ひっす": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっすう": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひっすじょうけん": "أمر لا غنى عنه, شرط أساسي (شرط مسبق لا يمكن الاستغناء عنه)",
 "ひっする": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "ひっすアミノさん": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "ひっせい": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات) / أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة) / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "ひっせき": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة…)",
 "ひっせきがく": "جرافولوجي, علم الخط (دراسة خط اليد (خاصة كمؤشر على شخصية الكاتب أو مزاجه))",
 "ひっそく": "إِقَامَة جَبْرِيَّة",
 "ひっそり": "صَامِت, هَادِئ / خلسة, دون لفت للانتباه (بطريقة تهدف إلى تجنب جذب الانتباه)\nمثال: دخل الغرفة دون لفت للانتباه",
 "ひっそりかん": "بِهُدُوء",
 "ひっそり閑": "بِهُدُوء",
 "ひったくり": "لِصّ, لِصَّة",
 "ひったくる": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "ひったん": "أسلوب الكتابة, نوع أدبي (نمط للتعبير عن النفس في الكتابة)",
 "ひっち": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي!",
 "ひっちゃかめっちゃか": "فَوْضَوِيّ",
 "ひっちゅう": "عِدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "ひっつかまえる": "إِسْتَوْلَى عَلَى",
 "ひっつかむ": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "ひっつきむし": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة)",
 "ひっつき虫": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة)",
 "ひっつく": "تَزَوَّجَ",
 "ひっつける": "غُصَيْن\nمثال: لا تمسك العصا من الوسط.",
 "ひっつり": "نَدْبَة, نَدْب / تَشَنُّج",
 "ひっつれる": "تَزَوَّجَ\nمثال: زوجة ماري طبيبة.",
 "ひってき": "مُنَافِس",
 "ひっとう": "رَئِيس, رَئِيسَة",
 "ひっとうしゃ": "اسم أول, اسم شخصي (الاسم الذي يسبق اللقب)",
 "ひっとらえる": "تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっぱく": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة)\nمثال: شعر بانقباض في صدرها",
 "ひっぱたく": "صَفْعَة, لَطْمَة\nمثال: صفع المدرس مؤخرتي.",
 "ひっぱり": "جر, سحب (فعل السحب؛ تطبيق قوة لتحريك شيء تجاهك أو معك)\nمثال: جعله السحب لأعلى التل يتنفس بصعوبة",
 "ひっぱりぎみ": "مَتِين, مَشْدُود (مَسْحُوبٌ أَوْ مَمْدُودٌ بِإِحْكَام)",
 "ひっぱりだす": "أَخْرَجَ",
 "ひっぱりつよさ": "قوة الشد (قوة المادة معبراً عنها كأكبر إجهاد طولي يمكن أن تتحمله دون أن تتمزق)",
 "ひっぱりづよさ": "قوة الشد (قوة المادة معبراً عنها كأكبر إجهاد طولي يمكن أن تتحمله دون أن تتمزق)",
 "ひっぱる": "جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…) / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي. / رَصَاص",
 "ひっぷ": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ひっ捕える": "تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっ捕まえる": "إِسْتَوْلَى عَلَى",
 "ひっ捕らえる": "تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "ひっ迫": "إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة)\nمثال: شعر بانقباض في صدرها",
 "ひつ": "فُرْشَاة الطِلَاء / الخط, فن الخط (الكتابة اليدوية الجميلة) / لُوط / خَزِينَة\nمثال: تلقى ياني طلقة في الصدر. / تَحْدِيد, قَطْعِيَّة (صفة القابلية للتنبؤ بثقة كبيرة)",
 "ひつい": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "ひつう": "غَمّ, حُزْن",
 "ひつかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "ひつぎ": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "ひつぎのみこ": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ひつぐう": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ひつけ": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ひつけやく": "مُحَرِّض, مُحَرِّضَة",
 "ひつじ": "خَرُوف\nمثال: إن شاء الله ؛ / باتجاه الجنوب الجنوب الغربي (إلى أو نحو أو في الجنوب الجنوب الغربي)",
 "ひつじかい": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "ひつじがわ": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "ひつじぐも": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "ひつじごや": "حظيرة أغنام, زريبة غنم (حظيرة للأغنام)",
 "ひつじさる": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "ひつじゅ": "ضَرُورِيّ, لَازِم",
 "ひつじゅひん": "ضَرُورَة, حَاجَة",
 "ひつじょう": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك)\nمثال: هو كذلك بالضرورة",
 "ひつじ雲": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "ひつぜつ": "وَصْف, تَوْصِيف",
 "ひつぜん": "حَتْمِيّ / حَتْمِيَّة, وُجُوب (صفة كون الشيء غير قابل للتجنب)",
 "ひつぜんせい": "ضَرُورَة, حَاجَة",
 "ひつぜんてき": "حَتْمِيّ",
 "ひつにゅう": "إرضاع, رضاعة (تغذية الرضيع بإعطائه الثدي)\nمثال: تستمر الرضاعة عادة حتى الفطام",
 "ひつにゅうりょう": "إدرار الحليب, محصول الحليب (كمية الحليب التي تنتجها البقرة)\nمثال: الموسيقى الهادئة يمكن أن تحسن إدرار الحليب",
 "ひつにょう": "تبول (إخراج البول)",
 "ひつにょうき": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "ひつび": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひつぼく": "قِرْطَاسِيَّة",
 "ひつめい": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "ひつめつ": "فناء, موت (الجودة أو الحالة المتمثلة في كونه فانياً)",
 "ひつよう": "ضَرُورِيّ, لَازِم / ضَرُورَة, حَاجَة",
 "ひつようご": "كلمة مفتاحية (كلمة مهمة تستخدم في الفهرسة أو التصنيف)",
 "ひつようじ": "ضَرُورَة, حَاجَة",
 "ひつようじょうけん": "شَرْط ضَرُورِيّ (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "ひつようせい": "ضَرُورَة, حَاجَة",
 "ひつようとする": "حَاجَة, ضَرُورَة\nمثال: とりわけ子供たちは愛情を必要とする。 — و فوق كل شيء، يحتاج الأطفال إلى الحب.",
 "ひつようない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ひつようははつめいのはは": "اَلْحَاجَة أَمّ اَلاِخْتِرَاع",
 "ひつようひん": "ضَرُورَة, حَاجَة",
 "ひつようふかけつ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ひつようぶつ": "ضَرُورَة, حَاجَة",
 "ひつろく": "تدوين, سجل مكتوب (وثيقة مكتوبة تحفظ المعرفة بوقائع أو أحداث)",
 "ひづくり": "تطريق, حدادة (تشكيل المعدن عن طريق التسخين والطرق)",
 "ひづけ": "تَمْرَة, تَمْر\nمثال: ما تاريخ اليوم؟",
 "ひづめ": "حافِر, ظِلْف",
 "ひてい": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد. / نَفْي / فَرْضِيَّة (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "ひていけい": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر. / غَيْر مُنْتَظِم, لَا نَمَطِيّ (ينحرف عن التوقعات الطبيعية؛ غريب أو شاذ بعض الشيء)\nمثال: فئة من الطحالب غير النموذجية",
 "ひていけいどうし": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "ひていけいはいえん": "التهاب رئوي لانمطي (مرض تنفسي حاد يتميز بحمى عالية وسعال)",
 "ひていこう": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "ひていてき": "سَلْبِيّ",
 "ひてきしゅつし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "ひてきよう": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ひてんしゅうさ": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "ひでぇ": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُفْرِط, زَائِد",
 "ひでえ": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُفْرِط, زَائِد",
 "ひでり": "جَفَاف",
 "ひでん": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "ひでんか": "أَمِيرَة",
 "ひでー": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عَنِيف / فَظِيع / مُفْرِط, زَائِد",
 "ひと": "قَاطِع طَرِيق / أُقْنُوم / بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب / بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق. / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ) / إنفاق, صرف (عملية إنفاق أو صرف المال) / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "ひとあし": "خُطْوَة, خَطْوَة / حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "ひとあしさきに": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "ひとあじ": "تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها)",
 "ひとあじもふたあじも": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "ひとあたり": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب.",
 "ひとあたりがいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりがよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりのいい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあたりのよい": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "ひとあつめ": "جمهور, حشد كبير (تجمع كبير للناس)",
 "ひとあばれ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "ひとあめ": "شَتْوَة, مَطْرَة\nمثال: استحم زيري هناك.",
 "ひとあれ": "مُشْكِلَة, مَتاعِب",
 "ひとあわ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "ひとあわふかせる": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "ひとあんしん": "سَكِينَة, طُمَأْنِينَة",
 "ひといき": "تَوَقَّفَ / قَلِيلًا",
 "ひといきれ": "ثقل دم, جمود (وقار ممل ومتغطرس)",
 "ひといちばい": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "ひとう": "غَيْر مَعْرُوف لِلْأَغْلَبِيَّة, قَلِيل الشُّهْرَة (غير معروف لمعظم الناس) / الْفِلِبِّين (دولة في جنوب شرق آسيا؛ اسمها الرسمي جمهورية الفلبين، وعاصمتها مانيلا؛ جزر…)\nمثال: الفلبين بلد كاثوليكي أساسا.",
 "ひとうけ": "شَعْبِيَّة",
 "ひとうり": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16…) / تاجر رقيق (شخص يعمل في تجارة الرقيق)",
 "ひとえざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة…)",
 "ひとえつぎ": "عقدة الشراع, عقدة النساج (عقدة تستخدم لربط حبل مؤقتاً بمنتصف حبل آخر)",
 "ひとえに": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "ひとおし": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "ひとおもいに": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "ひとおよぎ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق)\nمثال: سبح مع الدلافين.",
 "ひとかい": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16…)",
 "ひとかかえ": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "ひとかけら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / خرقة, رقعة (قطعة صغيرة من القماش)",
 "ひとかげ": "سَمَنْدَل",
 "ひとかさね": "بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "ひとかず": "بَالِغ, رَاشِد",
 "ひとかせぎ": "كَسَبَ",
 "ひとかた": "عَادِيّ, مَأْلُوف",
 "ひとかたならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "ひとかたならぬ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ひとかど": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "ひとかどのじんぶつ": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどのにんげん": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどの人物": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかどの人間": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとかまえ": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))\nمثال: مجموعة من الأشجار",
 "ひとかわ": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ひとかわむける": "حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "ひとがいい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "ひとがしら": "جُمْجُمَة",
 "ひとがたロボット": "أَنْدْرُويِد",
 "ひとがましい": "مُحْتَرَم",
 "ひとがよい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "ひとがら": "شَخْصِيَّة",
 "ひとがわるい": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "ひときざみ": "فَائِق, مُمْتَاز (من أعلى مستويات الجودة)",
 "ひときり": "تَوَقَّفَ / اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب…)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "ひときれ": "شريحة\nمثال: قطع زيري العشب.",
 "ひときわ": "بشكل بارز, بوضوح (بطريقة بارزة)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر",
 "ひとぎき": "سُمْعَة, شُهْرَة",
 "ひとぎきのわるい": "سيء السمعة (يفتقر للاحترام في الشخصية أو السلوك أو المظهر)",
 "ひとぎらい": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "ひとく": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "ひとくい": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "ひとくいうま": "عَاضّ (شخص يقوم بالعض)",
 "ひとくいざめ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "ひとくいじんしゅ": "غُول, آكِلُ لُحُوم البَشْر",
 "ひとくいせい": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "ひとくいてき": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "ひとくいザメ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "ひとくぎり": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "ひとくせ": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث…)\nمثال: محاسبة النفس صفة حميدة.",
 "ひとくせい": "سرية, كتمان (التكتم في حفظ المعلومات السرية)\nمثال: يجب عليك احترام سرية اتصالات عميلك",
 "ひとくち": "لُقْمَة / تجرع, عب (بلعة كبيرة وسريعة)\nمثال: أنهاه بجرعة واحدة / بِاخْتِصَار",
 "ひとくちばなし": "طُرْفَة, نُكْتَة",
 "ひとくち話": "طُرْفَة, نُكْتَة",
 "ひとくとっけん": "اِمْتِيَاز",
 "ひとくふう": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "ひとくろう": "مشقة, وقت عصيب (صعوبة يمكن التغلب عليها بالجهد)\nمثال: واجهنا وقتاً عصيباً للوصول إلى هنا",
 "ひとけ": "بَشَرِيَّة, إِنْسَانِيَّة",
 "ひとげ": "بَشَرِيَّة, إِنْسَانِيَّة",
 "ひとこえ": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ひとこと": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "ひとこぶらくだ": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "ひとこま": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "ひところ": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ひとごえ": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "ひとごこち": "وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي. / رَاحَة, تَخْفِيف",
 "ひとごころ": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي.",
 "ひとごろし": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ひとさがし": "تَعْبِئَة",
 "ひとさし": "سبابة (الإصبع المجاور للإبهام)",
 "ひとさしゆび": "سبابة (الإصبع المجاور للإبهام)",
 "ひとさま": "آخَرُون",
 "ひとさらい": "اِخْتِطَاف / مُخْتَطِف",
 "ひとさわがせ": "إنذار كاذب (تحذير يُعطى بشأن شيء يفشل في الحدوث)",
 "ひとざいさん": "ثَرْوَة",
 "ひとざと": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
 "ひとざとはなれた": "وَحِيد, مُوحِش",
 "ひとしい": "عِدْل (عَدْل)\nمثال: هل يعاملون بالعدل / مُعَادِل",
 "ひとしお": "خُصُوصًا, خَاصَّةً",
 "ひとしきり": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "ひとしく": "بِالتَّسَاوِي",
 "ひとしごと": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ひとしな": "بَنْد / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "ひとしばい": "حِيلَة",
 "ひとしれず": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "ひとしれぬ": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "ひとじち": "رَهِينَة\nمثال: 人質は解放されるだろう。 — سيُفرج عن الرهائن.",
 "ひとじに": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية)",
 "ひとじらみ": "قملة شائعة (قملة الرأس أو الجسم)",
 "ひとすじ": "جَدِّي, جَادّ / عَادِيّ, مَأْلُوف",
 "ひとすじしまか": "بعوضة النمر الآسيوية (موطنها اليابان ومخططة، تزدهر في جنوب غرب ووسط غرب الولايات المتحدة وتنتشر إلى…)",
 "ひとすじなわ": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "ひとすみ": "زَاوِيَة, رُكْن",
 "ひとずき": "جاذبية (جاذبية جنسية)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ひとそうどう": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ひとそれぞれ": "كل شخص حرّ في ذوقه",
 "ひとたち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "ひとたび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "ひとたまりもなく": "بِسُهُولَة",
 "ひとたらし": "اِحْتِيَال / مُحْتَال",
 "ひとだかり": "كَوْم",
 "ひとだすけ": "إِحْسَان",
 "ひとだま": "شِهَاب",
 "ひとだまし": "خِدَاع, خَدْع",
 "ひとっこ": "أُقْنُوم",
 "ひとっこひとり": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "ひとっとび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ひとっぱしり": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "ひとっぷろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ひとっ走り": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "ひとっ風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ひとっ飛び": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ひとつ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة. / على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً / وَحِيد / مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس.",
 "ひとつあな": "عِصَابَة",
 "ひとつあなのむじな": "عِصَابَة",
 "ひとつおき": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور…)\nمثال: سيقان بأوراق متبادلة",
 "ひとつおきに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "ひとつかみ": "حَفْنَة / جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "ひとつがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "ひとつがき": "بَنْد",
 "ひとつき": "طَعْن",
 "ひとつこころ": "إخلاص, صدق عزيمة (التزام كامل أو حماس غير متحفظ)",
 "ひとつずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつづき": "سِلْسِلَة",
 "ひとつづつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつとして": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "ひとつながり": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "ひとつには": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً",
 "ひとつばなし": "نَادِرَة\nمثال: هي مدرسة لطيفة.",
 "ひとつひとつ": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "ひとつふたつ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "ひとつぼし": "نَجْمَة الْمَسَاء",
 "ひとつまたひとつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとつまみ": "قَرَصَ",
 "ひとつめ": "أَعْوَر, عَوْرَاء / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى)",
 "ひとつめかっしゃ": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ひとつめこぞう": "أَعْوَر, عَوْرَاء",
 "ひとつも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "ひとつや": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "ひとづき": "سُمْعَة, شُهْرَة",
 "ひとづきあい": "تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "ひとづて": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "ひとづま": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "ひとて": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص. / سَرِيَّة",
 "ひとで": "كَوْم / نَجْمَةُ اَلْبَحْرِ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة. / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر))\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة / مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "ひとでなし": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية)",
 "ひととおり": "عُمُومًا / كُلّ شَيْء / عَادِيّ, مَأْلُوف",
 "ひととき": "مُدَّة\nمثال: جون في عمر أخي. / في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "ひととなり": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "ひととび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ひととり": "قاعدة الأسرى (لعبة أطفال؛ يقوم فريقان بأسر اللاعبين المعارضين عن طريق لمسهم وأخذهم إلى…)",
 "ひとどおり": "حركة المشاة (الأشخاص القادمون والذاهبون سيرًا على الأقدام)",
 "ひとなか": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع.",
 "ひとなかせ": "إِزْعَاج",
 "ひとなつこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ひとなつっこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ひとなで": "سكتة دِمَاغِيَّة",
 "ひとなみ": "تَدَافُع, هَرْج (تزاحمَ وتدافعَ الأشخاصُ في مكانٍ واحدٍ؛ يدافع بمعنى الحماية والدفاع)\nمثال: لا تدافع عن القتلة! / عَادِيّ, مَأْلُوف",
 "ひとなみはずれた": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "ひとなめ": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة",
 "ひとにぎり": "حَفْنَة / جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)",
 "ひとにざる": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "ひとにゅうとうしゅウイルス": "فيروس الورم الحليمي البشري (أي من مجموعة فيروسات بابوفا المرتبطة بالسرطانات التناسلية أو الفموية أو مجموعة…)",
 "ひとねいり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة",
 "ひとねむり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة",
 "ひとのいい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "ひとのくち": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "ひとのこ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / اِبْنُ الإنْسان (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ひとのこといえない": "مَنْ أَنْتَ؟, مَنْ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ひとのつね": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية",
 "ひとのはえをおうよりおのれのはえをおえ": "تَوَخَّى اَلْحِذْر",
 "ひとのみ": "تَحْتَ, تَحْت (أَقَلَّ)\nمثال: أنا تحت الشجرة. / مَصَّة, رَشْفَة",
 "ひとのみち": "أخلاق, مبدأ أخلاقي (مبادئ الصواب والخطأ التي يقبلها فرد أو مجموعة اجتماعية)\nمثال: الأخلاق البيوريتانية",
 "ひとのよい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "ひとはしり": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "ひとはた": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ひとはだ": "هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال.",
 "ひとはな": "نَجَاح",
 "ひとはら": "مِحَفَّة / بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك)",
 "ひとはパンのみにていくるにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "ひとはパンのみにていくるものにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "ひとばしら": "خِنْزِير غِينِيَّا",
 "ひとばん": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひとひ": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ひとひら": "وَرَقَة, وَرَقة",
 "ひとびと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / اَلْجَمِيع, كُلّ شَخْص",
 "ひとふき": "ضربة قوية (كرة طائرة طويلة جداً)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "ひとふで": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / رِزْمَة, رُزْمَة",
 "ひとふろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ひとふんばり": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا!",
 "ひとぼしごろ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "ひとまえ": "عَلَنِيّ, عَامّ",
 "ひとまえで": "جهراً, علناً (بطريقة يمكن للجمهور الوصول إليها أو ملاحظتها؛ بصراحة)\nمثال: اعترفت علناً بكونها شيوعية",
 "ひとまく": "مَنْظَر, مَشْهَد",
 "ひとまくもの": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "ひとまず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "ひとまとまり": "حُزْمَة, عُنْقُود\nمثال: شكرا لإضافتي للمجموعة.",
 "ひとまとめ": "إِبَالَة, حُزْمَة",
 "ひとまね": "مُشَاكهَة",
 "ひとまわり": "دَارَة (لا جمع له)",
 "ひとみ": "تِلْمِيذ, تِلْمِيذَة / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "ひとみごくう": "ضَحِيَّة",
 "ひとみしり": "حياء, خجل (شعور بالخوف من الإحراج)",
 "ひとみをこらす": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "ひとむかし": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "ひとむかしまえ": "قَدِيماً",
 "ひとむら": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ひとむれ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "ひとめ": "لمحة, نظرة خاطفة (نظرة سريعة) / مَنْظُور عَيْن الْطَائِر / لَاحَظَ",
 "ひとめにつかない": "غَيْر مُدْرَك (لم يُدرَك أو يُعلَّق عليه)",
 "ひとめぼれ": "اَلْحُبّ مِن اَلنَّظْرَة اَلْأُولَى\nمثال: 一目惚れなの。 — كان حبًّا من أوّل نظرة.",
 "ひとめもはばからず": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "ひとめんえきふぜんウイルス": "الإيدز, فيروس نقص المناعة البشرية (الفيروس الذي يسبب متلازمة نقص المناعة المكتسب (الإيدز)؛ يتكاثر في الخلايا…)",
 "ひともしごろ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "ひともじ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ひともなげ": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "ひともり": "كَوْم",
 "ひともんちゃく": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "ひとや": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "ひとやく": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "ひとやくかう": "شَارَكَ, سَاهَمَ",
 "ひとやすみ": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "ひとやま": "كَوْم / سَنَام / مُمِيت, قَاتِل\nمثال: قتل الصياد دبا.",
 "ひとやまいくら": "بَخْس الثَّمَن, رَخِيص جِدّاً (رخيص للغاية؛ شبه مجاني) / لُوط",
 "ひとよ": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ひとよせ": "جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ひとよせせき": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "ひとよづま": "دَاعِرَة, بَغِيَّة",
 "ひとより": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "ひとらしい": "بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق.",
 "ひとり": "لوحد / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "ひとりあたり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "ひとりおやかた": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "ひとりおんな": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "ひとりかって": "أَنَانِيّ",
 "ひとりぎめ": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "ひとりごちる": "غَمْغَمَة, تَمْتَمة",
 "ひとりごつ": "غَمْغَمَة, تَمْتَمة",
 "ひとりごと": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة)",
 "ひとりじめ": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "ひとりずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ひとりてんぐ": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "ひとりで": "وَحِيد, مُنْفَرِد",
 "ひとりでに": "آلياً, تلقائياً (بطريقة انعكاسية لا إرادية)\nمثال: أجاب تلقائياً",
 "ひとりにつき": "لِلْفَرْد الوَاحِد (لكل شخص على حدة)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "ひとりのこらず": "كُلّ, جَمِيع",
 "ひとりひとり": "كُلّ",
 "ひとりびとり": "كُلّ",
 "ひとりべや": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "ひとりぼっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ひとりぽっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ひとりまえ": "بَالِغ, رَاشِد\nمثال: 彼女も一人前の女になった。 — لقد اصبحت امرأة بالغة. / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة)",
 "ひとりみ": "عزوبية (حالة كون الرجل غير متزوج)",
 "ひとりも": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ひとりよう": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً",
 "ひとりよがり": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "ひとりエッチ": "عَادَة سِرِّيَّة",
 "ひとり占め": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "ひとり残らず": "كُلّ, جَمِيع",
 "ひとり決め": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "ひとり言": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة)",
 "ひとり部屋": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "ひとわたり": "عُمُومًا",
 "ひとわらわせ": "سَخِيف, مَسْخَرَة",
 "ひとわらわれ": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ひとをくった": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "ひとコマ": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "ひとマネ": "مُشَاكهَة",
 "ひと仕事": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ひと休み": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "ひと先ず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "ひと切り": "تَوَقَّفَ",
 "ひと吹き": "ضربة قوية (كرة طائرة طويلة جداً)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
