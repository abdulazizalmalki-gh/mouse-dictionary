 "たんしょ": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "たんしょう": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة",
 "たんしん": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "たんしんぎ": "سُونار",
 "たんしんしゃ": "أَعْزَب, عَازِب",
 "たんじ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "たんじつ": "غَدًا, الْغَد (اليومُ الذي يأْتي بعدَ اليوم الحالي، اليوم التالي؛ قد يراد به القريب من الزمان) / غَد, بُكرة (اليوم الذي يأتي بعد اليوم الذي أنت فيه؛ أي يوم يأتي في المستقبل، قرب أو بعد، على ال)\nمثال: لربما تمطر غدا.",
 "たんじゅう": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "たんじゅん": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "たんじゅんせい": "بَسَاطَة",
 "たんじゅんそぼく": "سَاذَج",
 "たんじょう": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "たんじょうかい": "حَفْلَة عِيد مِيلَاد",
 "たんじょうせき": "حجر البخت (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "たんじょうび": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "たんじょうびおめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "たんじょうびかい": "حَفْلَة عِيد مِيلَاد",
 "たんじょうびケーキ": "كَعْكَة عِيد مِيلَاد (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "たんじょうびパーティー": "حَفْلَة عِيد مِيلَاد",
 "たんじょうパーティー": "حَفْلَة عِيد مِيلَاد",
 "たんじる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / عَجَبَ",
 "たんす": "كُمُودِينُو, أَدْرَاجِيَّة",
 "たんすい": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "たんすいか": "تَقْطِير, إِعْذَاب",
 "たんすいかぶつ": "كَرْبُوهِيدْرَات",
 "たんすう": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة. / مُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة) / مُفْرَد, صِيغَة اَلْمُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة)",
 "たんずる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا. / عَجَبَ",
 "たんせい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "たんせいしょく": "سَمَاوِيّ, لَبَنِيّ",
 "たんせき": "حَصَاة مَرَارِيَّة",
 "たんせきしょう": "حَصَاة مَرَارِيَّة",
 "たんぜい": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "たんぜん": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "たんそ": "كَرْبُون",
 "たんそうしゃ": "نَقَّالَة, مِحَفَّة",
 "たんそく": "تَنَهَّدَ / تَنَهُّد",
 "たんそじゅうしほう": "تأريخ بالكربون المشع (تَسْجِيْل التَارِيْخ)",
 "たんそびょう": "جَمْرَة خَبِيثَة",
 "たんぞう": "وَرْشَة حِدَادَة",
 "たんたい": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "たんたん": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "たんだ": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "たんちょ": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "たんちょうせい": "اِطِّرَادُ دَالَّةٍ",
 "たんつば": "بَلْغَم / بَلْغَم, قُشَاعَة",
 "たんづつ": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "たんてい": "مُحَقِّق (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "たんていだん": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / نَادٍ لَيْلِيّ, اَلنَّادِي اَللَّيْلِيّ / سِبَاتِي\nمثال: لا تمسك العصا من الوسط.",
 "たんてき": "إِفْرَنْجِيّ",
 "たんてん": "مِرْسَاة, أَنْجَر / مُذِيع, مُذِيعَة / رَسَا ((رَسَا) الشيءُ يَرْسُو رَسْواً، ورُسُوّاً: ثَبَتَ؛ رَسا الجبلُ: ثَبَتَ أصَله في الأَرض)",
 "たんでき": "صَكّ غُفْرَان",
 "たんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "たんとう": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: أحتاج الى سكين.",
 "たんとうしゃ": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "たんとうちょくにゅう": "إِفْرَنْجِيّ",
 "たんとうぶちょう": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "たんどく": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت / اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "たんどくで": "وَحِيد, مُنْفَرِد",
 "たんなる": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "たんに": "بِكُلّ بَسَاطَة (بَكَلَه: خَلَطَه؛ بَكَلَ عَلَيْنَا حَديثَه وأَمْرَه: خَلَطَهُ وجاءَ بِهِ عَلَى غَيْرِ وَجْهِهِ)\nمثال: غادرنا بكل بساطة.",
 "たんぬ": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "たんねん": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "たんのう": "مَاهِر",
 "たんばん": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "たんぱく": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / إِفْرَنْجِيّ",
 "たんぱくしつ": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية) / بُرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "たんぱくせき": "أُوبَال",
 "たんぱく質": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية) / بُرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "たんぱつせい": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة.",
 "たんび": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "たんびに": "كُلَّمَا",
 "たんぺん": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "たんぺんしょうせつ": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "たんほうこう": "مُبَسَّط (دَرْسٌ مُبَسَّطٌ : سَهْلٌ، وَاضِحٌ)\nمثال: هذا الكتاب مؤلف بلغة إنجليزية مبسطة و هو سهل للقراءة.",
 "たんぼう": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "たんぽ": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "たんぽせきにん": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "たんぽぶっけん": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "たんま": "هُدْنَة",
 "たんまつ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "たんもの": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "たんや": "حَدَّاد, قَيْن",
 "たんよく": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "たんらく": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "たんらくてき": "مُتَسَرِّع",
 "たんらん": "طَمَع, شُحُّ",
 "たんり": "تَوَحُّد",
 "たんりょく": "شَجَاعَة, جَسَارَة\nمثال: 君は胆力を練る必要がある。 — يجب أن تُنَمِّيَ شجاعتك.",
 "たんれい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "たんれん": "وَرْشَة حِدَادَة / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "たんをきる": "تَنَحْنَحَ",
 "たんをはっする": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "たんパン": "شُورْت",
 "たーけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "だ": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "だあれ": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "だい": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة. / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / مُسْتَوًى / مَرْحَلَة",
 "だいあく": "بِشَاعَة, قَسْوَة",
 "だいあくにん": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "だいい": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "だいいち": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَفْضَل / إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "だいいちぎてき": "أَسَاسِيّ",
 "だいいちごう": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "だいいちしはんき": "التربيع الأوّل, التربيع المتزايد",
 "だいいちじ": "أَوَّلِيّ",
 "だいいちじせかいたいせん": "اَلْحَرْبُ العَالَمِيَّةُ الْأُولَى",
 "だいいちじたいせん": "اَلْحَرْبُ العَالَمِيَّةُ الْأُولَى",
 "だいいちせかい": "الْعَالَم الْأَوَّل",
 "だいいちにんしょう": "مُتَكَلِّم",
 "だいいっかい": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "だいいっし": "بِكْر (في : يُطلق على الحليب الذي يُحلب من أول مرة بعد الولادة)\nمثال: لا أفهم سبب ولعه بكرة القدم.",
 "だいいっせん": "جَبْهَة / أَمَامِيّ",
 "だいいっキュー": "التربيع الأوّل, التربيع المتزايد",
 "だいいん": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "だいういきょう": "ليسوم حقيقي, ينسون نجمي",
 "だいうちゅう": "كَوْن, الْكَوْن",
 "だいえいていこく": "الإِمْبَرَاطُورِيّة الْبَرِيطَانِيَّة",
 "だいえんしゅう": "لُعْبَة حَرْب (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "だいえんだん": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "だいか": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "だいかく": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "だいかま": "مِنْجَل, مِقْضَب",
 "だいかん": "مَأْمُور",
 "だいかんしゅう": "كَوْم",
 "だいかんみんこく": "جُمْهُورِيَة كُورِيَا",
 "だいがえ": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "だいがく": "جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة.",
 "だいがくがくちょう": "رَئِيس, رَئِيسَة",
 "だいがくしゃ": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "だいきゅう": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "だいきゅうし": "ضِرْس",
 "だいきょうこう": "الْكَسَاد الْعَظِيم",
 "だいきょうしつ": "صَالَة مُحَاضَرَات (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "だいきらい": "كَرِهَ, أَبْغَضَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "だいきん": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "だいきんひきかえ": "غَادُس / قُدّ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / مُورَة / بَقَلَة\nمثال: قد أثلجت كثيرا.",
 "だいきんぼし": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "だいぎ": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / طَابُوقَة",
 "だいぎいん": "مُمَثِّل, مُمَثِّلَة",
 "だいぎいんだん": "تَفْوِيض / بِعْثَة, وَفْد",
 "だいぎし": "بَرْلَمَانِيّ, بَرْلَمَانِيَّة",
 "だいぎゃく": "خِيَانَة عُظْمَى",
 "だいぎゃくさつ": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "だいく": "نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها)",
 "だいくしごと": "نِجَارة (مؤنث نَجَّار، التي تعمل بالنجارة)",
 "だいけい": "مُنْحَرِف, شِكْل مُنْحَرِف",
 "だいけんしょう": "مَاجْنَا كَارْتَا",
 "だいけんちく": "بِنَاء, مَبْنَى (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: أنا وجدت البناء.",
 "だいげん": "محاماة / تَأْييد / مُنَاصَرَة",
 "だいげんしゃ": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "だいげんすい": "رَئِيس أَرْكَان",
 "だいげんにん": "مُحَامٍ, مُحَامِيَة",
 "だいこ": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "だいこう": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "だいこうきかん": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいこうぎょう": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいこうしゃ": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
