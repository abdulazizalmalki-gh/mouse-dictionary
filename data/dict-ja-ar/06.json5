 "しっしょくしゃ": "عاطل عن العمل (شخص بلا وظيفة)",
 "しっしん": "أَكْزِيمَا / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "しっする": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "しっせい": "سوء الإدارة, سوء الحكم (حكومة غير فعالة أو غير نزيهة) / مُبْتَلّ / مَبْلُول, مُبْتَلّ / تَصْحِيح / إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / قُنْصُل",
 "しっせいかん": "قُنْصُل",
 "しっせいしょう": "بحة, خرس (اضطراب في أعضاء الصوت يؤدي إلى فقدان الصوت)",
 "しっせいしょくぶつ": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "しっせき": "عَزْر / توبيخ ;تقريع / اِخْتِفَاء",
 "しっそ": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / مُتْوَاضِع / مُحْتَشِم",
 "しっそう": "اِخْتِفَاء / ركض سريع, عدو سريع (جري سريع)",
 "しっそうしゃ": "آبِق",
 "しっそく": "مَعْلِف, مُرَاح / بَسْطة / تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "しった": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "しったい": "خطأ فادح, زلة (خطأ محرج)",
 "しったかぶりや": "مُتَعَالِم",
 "しったつり": "مَأْمُور",
 "しっち": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "しっちたい": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "しっちゃかめっちゃか": "فَوْضَوِيّ",
 "しっちゃく": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "しっちゅう": "طبعة جامعة (طبعة تحتوي على نسخ مختلفة من نص أو ملاحظات من قبل علماء أو محررين مختلفين)",
 "しっちょう": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي) / رَنَح ((رَنَّحَ) فلان: تمايل من السكر وغيره؛ (رَنَّحَ) الشراب فلانا: جعله يرنح)",
 "しっつい": "ذُلّ (ذَلَّ الرَّجُلُ: ضَعُفَ، هَانَ، حَقُرَ؛ ذَلَّتِ الدَّابَّةُ: سَهُلَتْ، إِنْقَادَتْ)\nمثال: بذل زيري قصارى جهده.",
 "しってのとおり": "كَمَا تَعْلَمُ",
 "しってん": "خطأ فادح, زلة (خطأ محرج)",
 "しっと": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "しっとう": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "しっとうい": "جَرَّاح, جَرَّاحَة",
 "しっとぶかい": "غَيُور",
 "しっとり": "رُطُوبة / صَامِت, هَادِئ",
 "しっぱい": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "しっぱいかくし": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "しっぱいさく": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "しっぱいしゃ": "خَاسِر / فَاشِل",
 "しっぱいれい": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "しっぴ": "بِطَانَة / صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "しっぴつ": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "しっぴつしゃ": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "しっぷ": "كِمادة (وسادة قماشية أو ضمادة (مع دواء أو بدونه) توضع بإحكام على جزء من الجسم (لتخفيف الانزعاج أو خفض الحرارة))",
 "しっぷう": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "しっぷうどとう": "اضطراب, قلاقل (حالة من الاضطراب والفوضى العنيفة (كما في السياسة أو الظروف الاجتماعية بشكل عام))\nمثال: كانت الثورة الصناعية فترة اضطراب كبير",
 "しっぷやく": "لَبْخَة",
 "しっぺい": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "しっぺいたいさくセンター": "مراكز السيطرة على الأمراض والوقاية منها (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية؛ تقع في أتلانتا؛ تحقق وتشخص وتحاول السيطرة على الأمراض أو الوقاية منها (خاصة الأمراض الجديدة وغير…)",
 "しっぽ": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب. / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / تذييل, ذيل (أي نتوء يشبه ذيل الحيوان) / أواخر, ذيل (وقت الجزء الأخير من شيء ما)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "しっぽり": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى / بحنان, بشدة\nمثال: أحبته بشدة / بِبُطْء",
 "しっぽをふる": "تَمَلَّقَ, تَبَصْبَصَ",
 "しっぽを振る": "تَمَلَّقَ, تَبَصْبَصَ",
 "しつ": "فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / زَوْجَة, اِمْرَأَة / غِمْد, غِلَاف / نَوْعِيَّة, جَوْدَة / طَبِيعَة, طبيعة / الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة) / سيلينيوم (عنصر لافلزي سام مرتبط بالكبريت والتيلوريوم؛ يوجد في عدة أشكال تآصلية) / خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / عَيْبٌ / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / غَلْطَة / غَلَط\nمثال: كان خطأ حاسوبي. / رُطُوبَة / جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "しつい": "خَيْبَة أَمَل",
 "しつう": "وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / أَلَمُ أَسْنَان, أَلَمُ الْأَسْنَان (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "しつうざい": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "しつおう": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "しつおん": "درجة حرارة الغرفة (درجة الحرارة العادية للغرفة التي يعيش فيها الناس)",
 "しつかじょうみゃく": "وريد مأبضي (وريد ينشأ في الركبة ويصعد ليصبح الوريد الفخذي)",
 "しつかどうみゃく": "شريان مأبضي (استمرار للشريان الفخذي يتفرع لتغذية الساقين والقدمين)",
 "しつかん": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "しつかんじょうしょう": "أَلِكْسِيثَيْمِيَا, لَامُفْرَدَاتِيّة",
 "しつかんせつ": "ركبة, مفصل الركبة (مفصل رزي في الساق البشرية يربط القصبة والشظية بعظم الفخذ وتحميه الرضفة من الأمام)",
 "しつがい": "خَارِج, بره / رضفة, صابونة الركبة (عظم مثلث مسطح صغير أمام الركبة يحمي مفصل الركبة)",
 "しつがいこつ": "رَضَفَة",
 "しつがいはんしゃ": "منعكس الرضفة, منعكس الركبة (تمدد انعكاسي للساق ناتج عن نقرة حادة على وتر الرضفة)",
 "しつがわるい": "لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صوف مُعاد (ألياف صوف مستصلحة)",
 "しつぎ": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال. / إقحام, اعتراض (فعل إقحام أو إدراج إجراء أو ملاحظة تقاطع الحديث) / اِسْتِجْوَاب ((برلماني) إجراء برلماني لمطالبة مسؤول حكومي بشرح تصرف أو سياسة ما)",
 "しつぎょう": "بِطَالَة, بَطَالَة",
 "しつぎょうしゃ": "عاطل عن العمل (شخص بلا وظيفة)",
 "しつぎょうりつ": "مُعَدَّل البَطَالَة (النسبة المئوية للقوى العاملة العاطلة عن العمل في أي تاريخ معين)",
 "しつけ": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً) / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "しつけいと": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً)",
 "しつける": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / تغيير الوجهة (الإبحار في مسار متعرج) / تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / حبل الشراع ((مصطلح بحري) حبل (أو سلسلة) ينظم الزاوية التي يتم ضبط الشراع بها بالنسبة للرياح) / سروج, عدة الخيل (تجهيزات للحصان) / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "しつけんとう": "توهان, ضياع (ارتباك (عادة ما يكون عابراً) حول مكان وجودك وكيفية المضي قدماً؛ عدم اليقين بشأن الاتجاه) / فقدان التوجيه, هذيان (وهم جامح (خاصة الناتج عن عقار مهلوس))\nمثال: كان توهانه نتيجة لعدم الانتباه",
 "しつけ糸": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً)",
 "しつげん": "زلة لسان (خطأ عرضي وتافه عادة في التحدث) / أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "しつこい": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / مُتَطَلِّب, مُلِحّ (يَسْتَدْعِي الانْتِبَاهَ فَوْرًا) / دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "しつごしょう": "حبسة, فقدان القدرة على الكلام (عدم القدرة على استخدام أو فهم اللغة (المنطوقة أو المكتوبة) بسبب آفة دماغية)",
 "しつしつ": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / تموج صغير, مويجة (موجة صغيرة على سطح سائل)",
 "しつじ": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة) / شَمَّاس",
 "しつじつ": "بَسَاطَة",
 "しつじゅ": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "しつじゅん": "رُطُوبة",
 "しつっこい": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / مُتَطَلِّب, مُلِحّ (يَسْتَدْعِي الانْتِبَاهَ فَوْرًا) / دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "しつてき": "كيفي, نوعي (يتضمن تمييزات مبنية على الصفات أو الخصائص) / نوعي (يتعلق بالمقارنات القائمة على الصفات أو يتضمنها)\nمثال: تغيير نوعي",
 "しつてん": "كتلة نقطية (مفهوم لمادة صغيرة جداً بشكل لا نهائي، أو جسم يمكن اعتباره صغيراً جداً بشكل لا نهائي)\nمثال: على عكس الجسيمات النقطية، لا ينطبق مفهوم الكتلة النقطية إلا على جسم صغير بشكل لا نهائي",
 "しつど": "رُطُوبَة",
 "しつどくしょう": "عُسْرُ ٱلْقِرَاءَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "しつどけい": "جَهَاز قِيَاس الرُطُوبَة",
 "しつない": "دَاخِلِيّ (داخل الأبواب؛ في باطن المبنى)",
 "しつないかんげんがくだん": "أوركسترا حجرة (أوركسترا صغيرة؛ تعزف عادة الموسيقى الكلاسيكية)",
 "しつないがく": "موسيقى الحجرة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "しつないぎ": "ملابس استرخاء (ملابس مناسبة للاسترخاء)",
 "しつないそうしょく": "تصميم داخلي, ديكور داخلي (مهنة أو عمل تزيين الجزء الداخلي للمبنى أو الغرفة، خاصة فيما يتعلق بتركيب الألوان والطلاء والأقمشة والسجاد، إلخ)",
 "しつないとう": "ضوء الغرفة (ضوء يوفر إضاءة عامة لغرفة)",
 "しつないばき": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف) / خُفّ (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "しつにん": "عمه, فقدان المعرفة (عدم القدرة على التعرف على الأشياء باستخدام الحواس)",
 "しつにんしょう": "عمه, فقدان المعرفة (عدم القدرة على التعرف على الأشياء باستخدام الحواس)",
 "しつのたかい": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "しつのわるい": "لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صوف مُعاد (ألياف صوف مستصلحة)",
 "しつぶ": "رُكْبَة",
 "しつぼう": "خَيْبَة أَمَل",
 "しつぼく": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "しつむしつ": "مَهَمَّة",
 "しつむりつ": "قانون الكل أو لا شيء ((في الفسيولوجيا العصبية) نبضة عصبية ناتجة عن محفز ضعيف تكون قوية تمامًا مثل نبضة عصبية ناتجة عن محفز قوي)",
 "しつめい": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر / عَمًى",
 "しつめいしゃ": "مَكْفوف",
 "しつもん": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "しつもんしゃ": "سائل, مستفسر (شخص يطرح سؤالاً)",
 "しつもんじかん": "وقت الأسئلة (فترة خلال الجلسة البرلمانية حيث يجوز لأعضاء البرلمان البريطاني توجيه أسئلة للوزراء)",
 "しつもんじょう": "اِسْتِبَانَة",
 "しつもんひょう": "اِسْتِبَانَة",
 "しつもんようし": "اِسْتِبَانَة",
 "しつよう": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "しつらい": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / فجاجة, قلة أدب (أسلوب وقح ومهين) / قِلَّة احْتِرَام, وَقَاحَة (تعبير عن عدم الاحترام) / عَفْوًا!, مَاذَا قُلْتَ؟ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / مُعَدَّات, تَجْهِيزَات",
 "しつらえ": "مُعَدَّات, تَجْهِيزَات",
 "しつらえる": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "しつりょう": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء. / سعر الغرفة (السعر المفروض يومياً لغرفة فندق) / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم.",
 "しつりょうけっそん": "نقص الكتلة (المقدار الذي تكون به كتلة النواة الذرية أقل من مجموع كتل الجسيمات المكونة لها)",
 "しつりょうさようのほうそく": "قانون فعل الكتلة ((كيمياء) القانون الذي ينص على المبدأ التالي: معدل التفاعل الكيميائي يتناسب طردياً مع التركيزات الجزيئية للمواد المتفاعلة)",
 "しつりょうすう": "عَدَد كُتْلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "しつりょうちゅうしん": "مركز الكتلة (نقطة تمثل متوسط موضع المادة في جسم ما)",
 "しつりょうぶんせきき": "مقياس الطيف الكتلي (مقياس طيف للحصول على طيف الكتلة عن طريق انحراف الأيونات إلى شق رفيع وقياس تيار الأيونات بمقياس كهربائي)",
 "しつりょうほぞんのほうそく": "حفظ الكتلة, قانون حفظ المادة (مبدأ أساسي في الفيزياء الكلاسيكية ينص على أن المادة لا تفنى ولا تستحدث في نظام معزول)",
 "しつりょうスペクトル": "طيف الكتلة (توزيع للأيونات كما يظهر بواسطة مطياف الكتلة)",
 "しつれい": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / فجاجة, قلة أدب (أسلوب وقح ومهين) / قِلَّة احْتِرَام, وَقَاحَة (تعبير عن عدم الاحترام) / عَفْوًا!, مَاذَا قُلْتَ؟ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "しつれいしごく": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "しつれいしました": "أَنَا آسِف, أَنَا آسِفَة",
 "しつれいします": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "しつれいをば": "أَنَا آسِف, أَنَا آسِفَة",
 "しつれん": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "して": "فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / براز, قذارة (مصطلحات بذيئة للبراز) / مُضَارِب / بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض. / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "してい": "خَادِم, خَادِمَة / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / تحديد الهوية, تعيين (فعل تعيين أو تحديد هوية شيء ما) / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية, لقب (كلمة أو كلمات تعريفية يُدعى بها شخص أو شيء ويُصنف أو يتميز بها عن الآخرين)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها / سهر عند الجثمان (وقفة صلاة تعقد فوق جثة في الليلة التي تسبق الدفن) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم)) / اِهْتِمَام, اِنْتِبَاه / اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال / رُؤْيَة",
 "していけん": "تَذْكِرَة / تذكرة",
 "していし": "رَابِطَة, رَابِط / كلمة دالة, واصف (معلومة مخزنة تُستخدم لتحديد عنصر في نظام تخزين واسترجاع المعلومات) / شكل الكلمة, صيغة (المظهر الصوتي أو الكتابي للكلمة الذي يمكن استخدامه لوصف أو تحديد شيء ما)",
 "してき": "تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ) / تَارِيخِيّ (يَنْتَمِي لِلْمَاضِي؛ ذُو أَهَمِّيَّةٍ أَوْ شُهْرَةٍ تَارِيخِيَّة) / إشارة, تبيان (دلالة عن طريق العرض أو التوضيح) / خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك. / شِعْرِيّ / أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني)",
 "してききょよう": "رخصة شعرية, ضرورة شعرية (رخصة يستخدمها الكاتب أو الفنان لتعزيز تأثير عمله)",
 "してきげんざい": "المضارع التاريخي (استخدام صيغة المضارع لوصف أحداث أو حالات في الماضي)",
 "してきしょゆう": "مِلْكِيَّة خَاصَّة",
 "してきせいぎ": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط والإنْصَاف)\nمثال: يريدون العدالة.",
 "してきせいさい": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين)",
 "してきはかく": "رخصة شعرية, ضرورة شعرية (رخصة يستخدمها الكاتب أو الفنان لتعزيز تأثير عمله)",
 "してきゆいぶつろん": "مادية تاريخية",
 "してせん": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "してみると": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "してみれば": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "してやる": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "してん": "نقطة ارتكاز (المحور الذي تدور حوله الرافعة) / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر / منصة انطلاق, نقطة انطلاق (بداية ينطلق منها مشروع) / نقطة الانطلاق (مكان يتم منه إطلاق مشروع أو رحلة استكشافية)\nمثال: يستخدم أفكار الآخرين كنقطة انطلاق لأفكاره الخاصة",
 "してんし": "سَرَافِيم",
 "して遣る": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "しで": "شجرة النير, نير (أي من الأشجار أو الشجيرات المتعددة من جنس النير) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しでかす": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "しでこぶし": "ماغنوليا نجمية (ماغنوليا شجيرية متساقطة الأوراق من اليابان ذات زهور بيضاء عطرية تشبه النجوم تتفتح قبل أن تنبسط الأوراق؛ تزرع كنبات زينة في الولايات المتحدة)",
 "しでのたび": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しでん": "تْرَام, تْرَامْوَاي / البَرْق / تراكم الدهون في الأرداف, ستياتوبيغيا (تراكم شديد للدهون في الأرداف)",
 "しと": "رَسُول (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله. / مَدِينَة أَشْبَاح, مَدِينَة الْأَشْبَاح / بَوْل",
 "しとう": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة. / فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "しとぎょうでん": "أَعْمَال الرُّسُل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "しとけいしょう": "خِلَافَة رَسُولِيَّة, تَسَلْسُل رَسُولِيّ",
 "しとげる": "أَدَّى",
 "しとげんこうろく": "أَعْمَال الرُّسُل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "しとしと": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه / رَطِب, بَلّ (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "しとしょうでん": "خِلَافَة رَسُولِيَّة, تَسَلْسُل رَسُولِيّ",
 "しとつ": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "しとと": "درسة (أي من الطيور المغردة آكلة البذور العديدة في أوروبا أو أمريكا الشمالية) / قماش الأعلام (قماش فضفاض النسج يستخدم للأعلام، إلخ)",
 "しとど": "درسة (أي من الطيور المغردة آكلة البذور العديدة في أوروبا أو أمريكا الشمالية) / قماش الأعلام (قماش فضفاض النسج يستخدم للأعلام، إلخ)",
 "しとね": "وِسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وَسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وُسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / نُمْرُقَة / نِمْرِقَة / نَمْرَقَة\nمثال: غطى توم رأسه بوسادة.",
 "しとめる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "しとやか": "رَشِيق, ظَرِيف",
 "しど": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة) / دَلَالَة, مُؤَشِّر (شيء (كمسار عمل) يشار إليه على أنه مناسب أو ضروري) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء) / استطباب, دعي الاستعمال ((طب) سبب لوصف دواء أو إجراء عملية)\nمثال: لم يصدق قراءة العداد / رُؤْيَة",
 "しどい": "فَظِيع, أَرْبَد",
 "しどう": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / مدخل السيارات, ممر خاص (طريق يؤدي إلى منزل خاص)\nمثال: أوقفوا سيارتهم في الممر الخاص / مُرُوءَة",
 "しどうい": "معلم جامعي (معلم في جامعة أو كلية (خاصة في كامبريدج أو أكسفورد))",
 "しどういん": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "しどうしゃ": "قَائِد, زَعِيم",
 "しどうてき": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "しどうどうき": "لايت موتيف, لحن دال (جملة لحنية تصاحب ظهور شخص أو موقف معين (كما في أوبرا فاغنر))",
 "しどうひょう": "عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق)",
 "しどうぶ": "قِيَادَة",
 "しどうほうしん": "تَوْجِيهَات",
 "しどうようりょう": "تَوْجِيهَات",
 "しどく": "تسمم بتوماين (مصطلح للتسمم الغذائي لم يعد مستخدماً علمياً)",
 "しどけない": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "しどろもどろ": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "しな": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / نَوْعِيَّة, جَوْدَة / دَلَال / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "しないちりょうがく": "علاج جذور الأسنان (فرع طب الأسنان الذي يتعامل مع أمراض لب الأسنان)",
 "しないつうわ": "مكالمة محلية (مكالمة هاتفية تتم داخل منطقة الاتصال المحلية)",
 "しないでんわ": "مكالمة محلية (مكالمة هاتفية تتم داخل منطقة الاتصال المحلية)",
 "しないりょうほうがく": "علاج جذور الأسنان (فرع طب الأسنان الذي يتعامل مع أمراض لب الأسنان)",
 "しないりょうほうせんもんい": "أخصائي لب الأسنان (طبيب أسنان متخصص في أمراض لب الأسنان والعصب)",
 "しなう": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "しなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "しながき": "فهرس, كتالوج (كتاب أو كتيب يحتوي على حصر للأشياء) / فهرس, كتالوج (قائمة كاملة بالأشياء؛ عادة ما تكون مرتبة بشكل منهجي)\nمثال: وجده في كتالوج سيرز",
 "しながく": "علم الصينيات (دراسة التاريخ واللغة والثقافة الصينية)",
 "しながら": "نَوْعِيَّة, جَوْدَة",
 "しなぐり": "كستناء صينية (شجرة صغيرة بجوز حلو صغير؛ برية أو موطنة في كوريا والصين)",
 "しなご": "صِينِيّ",
 "しなさだめ": "تَقْيِيم, تَقْدِير",
 "しなしな": "مَرِن",
 "しなせる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "しなそば": "رَامِن, رَامَن",
 "しなぞろえ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "しなだま": "خفة اليد (براعة يدوية في تنفيذ الحيل)",
 "しなだれる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "しなのき": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "しなのぐるみ": "جوز إنجليزي, جوز فارسي (جوز أوراسي يقدر لجوزه الكبير الصالح للأكل وخشبه الصلب الغني بالنقوش؛ يزرع على نطاق واسع)",
 "しなの木": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "しなびる": "ذبول (التسبب في أن يصبح الشيء مرتخياً أو متدلياً) / ذبول (أي مرض نباتي يتميز بالتدلي والذبول؛ عادة ما تسببه طفيليات تهاجم الجذور)",
 "しなめ": "بَنْد",
 "しなもじ": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "しなもの": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم."
}
