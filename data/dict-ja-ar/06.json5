 "さんぺいせん": "خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "さんぼう": "ضابط أركان (ضابط مفوض معين في طاقم القائد العسكري) / مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم / مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع / ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "さんぼうかじょ": "عذق, نورة عذقية (نورة مسطحة القمة أو محدبة تنمو فيها سيقان الزهور الفردية للأعلى من نقاط مختلفة على الساق الرئيسية لتصل إلى نفس الارتفاع تقريبًا؛ الزهور الخارجية تفتح…)",
 "さんぼうそうちょう": "رئيس أركان الجيش",
 "さんぼうちょう": "رئيس أركان الجيش",
 "さんぼうほんぶ": "هيئة الأركان العامة (ضباط عسكريون معينون لمساعدة ضابط كبير في تخطيط السياسة العسكرية)",
 "さんぼうよし": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "さんぼん": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "さんぽ": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "さんぽう": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "さんぽうげんご": "لغة خوارزمية (لغة مصطنعة مصممة للتعبير عن الخوارزميات)",
 "さんぽうよし": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "さんぽさがって": "بتواضع (بطريقة متواضعة) / ببخل, بتقتير (بطريقة بخيلة)\nمثال: خفض رأسه بتواضع",
 "さんぽみち": "تجوال, تنزة (مشي متمهل (عادة في مكان عام)) / موكب الافتتاح (مسير لجميع الضيوف في افتتاح رقصة رسمية) / برومناد (شكل في رقص المربعات؛ يسير الأزواج عكس اتجاه عقارب الساعة في دائرة) / متنزه, ممشى (منطقة عامة مخصصة كممشى للمشاة)",
 "さんまいえ": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "さんまいつづき": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "さんまいめ": "كُومِيدْيَان / أُضْحُوكَة, مَضْحَكَة",
 "さんまいや": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "さんまや": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "さんまん": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "さんみ": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / حموضة (خاصية كون الشيء حمضياً) / حموضة, طعم حامض (تجربة التذوق عند تناول الخل أو عصير الليمون) / ثَالُوث",
 "さんみいったい": "ثَالُوث",
 "さんみゃく": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "さんめんきょう": "ثُلَاثِيّ الأَضْلَاع (ذو ثلاثة أضلاع)",
 "さんめんろっぴ": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "さんもくならべ": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع مساحات؛ الهدف هو الحصول على صف من ثلاثة صلبان أو ثلاث دوائر قبل الخصم)",
 "さんもん": "رُخْص (رَخُصَ يَرْخُصُ رَخاصةً ورُخوصةً ورُخْصانًا: نَعُم ولان؛ فهو رَخْص ورَخِيص)\nمثال: هل تملك رخصة قيادة؟ / مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "さんもんしばい": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "さんもんしょうせつ": "رواية تجارية, رواية رخيصة (رواية ورقية ميلودرامية رخيصة الثمن)",
 "さんもんばん": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "さんもんぶんし": "كاتب مأجور (كاتب متواضع المستوى ومحتقر (يكتب من أجل المال فقط دون اهتمام بالجودة))",
 "さんもんやくしゃ": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "さんや": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "さんゆうかん": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
 "さんよ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف »)",
 "さんよう": "تحسيب / الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "さんようすうじ": "رَقْم عَرَبِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "さんようちゅう": "ثلاثي الفصوص (مفصلي منقرض كان وفيراً في عصور حقب الحياة القديمة؛ كان له هيكل خارجي مقسم إلى ثلاثة أجزاء)",
 "さんよしゃ": "مُشَارِك / مُشَارِكَة",
 "さんらいい": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "さんらく": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "さんらん": "تَشَتُّت / باهِر / بيض السمك, سرء (كتلة البيض التي تضعها الأسماك أو البرمائيات أو الرخويات)",
 "さんらんかん": "مضع البيض (هيكل أنبوبي لوضع البيض في نهاية البطن في العديد من إناث الحشرات وبعض الأسماك)",
 "さんらんき": "موسم التزاوج, موسم التكاثر (موسم التكاثر هو الموسم الأنسب، وعادة ما يكون بظروف مواتية ووفرة في الغذاء والماء، للتكاثر)",
 "さんらんこう": "فَرْج, حِرّ",
 "さんりゅう": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "さんりゅうしゅ": "برد, كيسة ميبومية (كيس دهني صغير في الجفن ينتج عن انسداد غدة ميبوميان)",
 "さんりょう": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "さんりょうきょう": "مَنْشُور / مَوْشُور",
 "さんりょうたい": "تريمر, ثلاثي الوحدات (بوليمر (أو جزيء من بوليمر) يتكون من ثلاثة مونومرات متطابقة)",
 "さんりん": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "さんりんがく": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "さんるい": "القاعدة الثالثة (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثالثة في الملعب الداخلي) / القاعدة الثالثة (القاعدة التي يجب أن يلمسها العداء ثالثاً في لعبة البيسبول)\nمثال: هو يلعب في القاعدة الثالثة / حَامِض / لَاذِع / حامض / حَامِض, حَمْض",
 "さんるいしゅ": "لاعب القاعدة الثالثة ((في البيسبول) شخص ذكر يلعب في القاعدة الثالثة)",
 "さんるいだ": "ضربة ثلاثية (ضربة قاعدة يتوقف عندها الضارب بأمان عند القاعدة الثالثة)",
 "さんれい": "الروح الحارسة, الملاك الحارس (ملاك يُعتقد أن لديه عاطفة خاصة تجاه فرد معين) / قِمَّة / إِجْتِمَاع قِمَّة",
 "さんれつ": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة / رَهِيب, فَظِيع / فَظِيع, أَرْبَد",
 "さんれつしゃ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "さんれんおんぷ": "ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم ثلاثي (واحد من ثلاثة أبناء ولدوا في نفس الوقت من نفس الحمل) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "さんれんぷ": "ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم ثلاثي (واحد من ثلاثة أبناء ولدوا في نفس الوقت من نفس الحمل) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "さんろスイッチ": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "さんわおん": "ثالوث, كورد ثلاثي (كورد ثلاثي النوتات كبير أو صغير؛ نوتة وثالثتها وخامستها) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "さんをおく": "حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "さんケーほうしゃ": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "さんセク": "شَرِكَة مُحَاصَّة",
 "さんディー": "ثلاثي الأبعاد (ذو شكل أو مظهر ثلاثي الأبعاد) / ثلاثي الأبعاد (فيلم بصور لها شكل أو مظهر ثلاثي الأبعاد)\nمثال: أليست الأحلام دائماً ثلاثية الأبعاد؟",
 "さんピー": "ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "さん孔": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "さー": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "さ寝": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص",
 "さ庭": "مُتَوَسِّط",
 "さ文字": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "さ湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "さ迷い歩く": "تَجَوَّلَ",
 "さ迷う": "بوتر, مضرب الإسقاط (المضرب الحديدي المستخدم عادة في المنطقة الخضراء للإسقاط) / لاعب الضربة القصيرة",
 "さ迷えるユダヤ人": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "ざ": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ざあざあ": "بثقل, بشكل كبير (بدرجة كبيرة) / بإفراط, بشراهة (الانغماس بإفراط) / بثقل, بصعوبة (بطريقة مجهدة) / بثقل (ببطء كما لو كان مثقلاً بوزن كبير)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "ざあざあぶり": "وَابِل, مَطَر غَزِير",
 "ざあざあ降り": "وَابِل, مَطَر غَزِير",
 "ざあとらしい": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "ざあます": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ざい": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب. / ثَرْوَة / بَضَائِع, سِلَع / خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / مَوْهِبَة / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة. / أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن / حُضُور (حُضُور)\nمثال: الحضور هام جدا. / جَرِيمَة, جِنَايَة / جَرِيمَة",
 "ざいあく": "جَرِيمَة, جِنَايَة / جَرِيمَة",
 "ざいい": "حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "ざいうん": "ثَرْوَة",
 "ざいか": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / جنحة, مخالفة (تجاوز يشكل انتهاكاً لما يُحكم بأنه حق) / عملية هجومية, هجوم (عمل مهاجمة العدو) / إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / إهانة, استياء (شعور بالغضب ناتج عن التعرض للإهانة)\nمثال: لقد شعر بالاستياء من سؤالي / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / بِضَاعَة, بَضَائِع / بيت المزرعة (منزل لمزارع وعائلته)",
 "ざいかいじん": "خبير مالي, ممول (شخص ماهر في المعاملات المالية واسعة النطاق)",
 "ざいかた": "ريف, منطقة ريفية (منطقة خارج المدن والبلدات)\nمثال: تغنى شعره بوتيرة الحياة الهادئة في الريف",
 "ざいかん": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "ざいかんしゃ": "سَجِين, سَجِينَة",
 "ざいがい": "عبر البحار, في الخارج (في مكان عبر المحيط) / في الخارج, وراء البحار (ما وراء أو عبر البحر) / فِي الخَارِج, وَرَاءَ البِحَار (فِي بَلَدٍ أَجْنَبِيٍّ) / عَبْر البِحَار, مَا وَرَاء البَحْر (يكون أو يمرّ عبر البحر)\nمثال: عاش في الخارج لسنوات عديدة",
 "ざいがいこうかん": "بعثة دبلوماسية (بعثة تخدم أهدافاً وغايات دبلوماسية)",
 "ざいがく": "خادِم, مُعْتَنٍ (يُقَدِّم مُساعَدَة عَمَلِيَّة ورِعايَة) / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / انتباه, تركيز (العملية التي يركز بها الشخص على بعض سمات البيئة مع استبعاد (نسبي) لسمات أخرى)",
 "ざいきょ": "مَكَثَ, بَقِيَ / إِقَامَة",
 "ざいきん": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "ざいけ": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً) / بيت المزرعة (منزل لمزارع وعائلته)",
 "ざいげん": "مَوْرِد",
 "ざいこ": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "ざいこかんり": "مراقبة المخزون (الإشراف على توريد وتخزين وإتاحة العناصر لضمان إمدادات كافية دون تكدس مفرط)",
 "ざいこくしゅう": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "ざいこしょぶんセール": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "ざいこひん": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "ざいごう": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير. / خَطِيئَة, إِثْم / أَثِمَ, أَذْنَبَ ((أَثِمَ) أثما وإثما وأثاما ومأثما: وقع في الإثم فهو أثم وآثم وأثيم وأثام وأثوم)\nمثال: أثمة ما تريد إخباري عنه؟",
 "ざいごうぐんじん": "جندي احتياط (عضو في قوات الاحتياط العسكرية)",
 "ざいごうぐんじんびょう": "داء الفيالقة (التهاب رئوي فصي حاد (قاتل أحيانًا) تسببه بكتيريا من نوع تم التعرف عليه لأول مرة بعد تفشي المرض في مؤتمر الفيلق الأمريكي في فيلادلفيا عام 1976؛ يتميز…)",
 "ざいごうもの": "مُوَاطِن (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "ざいさん": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "ざいさんけん": "حَقّ المِلْكِيَّة (الحق القانوني في الملكية)",
 "ざいさんぜい": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "ざいしつ": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ざいしゅう": "سَجِين, سَجِينَة",
 "ざいしょ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "ざいしょう": "خَطِيئَة, إِثْم / أَثِمَ, أَذْنَبَ ((أَثِمَ) أثما وإثما وأثاما ومأثما: وقع في الإثم فهو أثم وآثم وأثيم وأثام وأثوم)\nمثال: أثمة ما تريد إخباري عنه؟ / دَلِيل, بُرْهَان / دَلِيل / وزير المالية (الوزير المسؤول عن مالية الدولة)",
 "ざいしょく": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟",
 "ざいじゅう": "أَقَامَ, سَكَنَ (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "ざいじゅうしゃ": "سَاكِن, سَاكِنَة",
 "ざいじょう": "جَرِيمَة, جِنَايَة / جَرِيمَة",
 "ざいじょうにんぴ": "استدعاء للمحاكمة (وثيقة قانونية تدعو شخصاً ما إلى المحكمة للرد على لائحة اتهام)",
 "ざいせい": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "ざいせいあかじ": "عجز الميزانية (زيادة النفقات على الإيرادات)",
 "ざいせいえんじょ": "إعانة, دعم اقتصادي (هبة مالية أو مساعدة مادية أخرى لدعم شخص أو قضية)\nمثال: مساعدة اقتصادية للمناطق الكاسدة",
 "ざいせいか": "خبير مالي, ممول (شخص ماهر في المعاملات المالية واسعة النطاق)",
 "ざいせいかんぜい": "تعريفة إيرادية (تعريفة تفرض لزيادة الإيرادات)",
 "ざいせいきかん": "مؤسسة مالية, منظمة مالية (مؤسسة (عامة أو خاصة) تقوم بجمع الأموال (من الجمهور أو مؤسسات أخرى) وتستثمرها في أصول مالية)",
 "ざいせいきき": "أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)",
 "ざいせいきんこうけいかく": "ميزانية متوازنة (تكون الميزانية متوازنة عندما تكون النفقات الجارية مساوية للإيرادات)",
 "ざいせいしえん": "تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "ざいせいじょうたい": "وضع مالي (حالة الموارد المالية (للشركات أو الأفراد))",
 "ざいせいせいさく": "سياسة مالية (سياسة حكومية للتعامل مع الميزانية (خاصة الضرائب والاقتراض))",
 "ざいせいてき": "اِقْتِصَادِيّ",
 "ざいせいねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "ざいせき": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "ざいせきせんじゅうしゃ": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "ざいぞく": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "ざいた": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "ざいたい": "أدلة الجريمة, جسم الجريمة (مجموعة الأدلة التي تشكل الجريمة؛ الدليل الموضوعي على ارتكاب جريمة (يُعتقد خطأً أحياناً أنه يشير إلى جثة ضحية جريمة قتل))",
 "ざいたいしゅうすう": "عمر الحمل, عمر جنيني (عمر الجنين محسوباً من وقت الإخصاب)",
 "ざいたくきそ": "إِقَامَة جَبْرِيَّة",
 "ざいたくきんむ": "عَمَل عَنْ بُعْدٍ, عَمَل مِنَ الْمَنْزِل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "ざいたくけんしん": "افْعَلْهَا بِنَفْسِكَ (يُنجَز بنفسك دون الاستعانة بمتخصص)",
 "ざいたくワーク": "تحصين خارجي (هيكل دفاعي فرعي يقع خارج المنطقة المحصنة الرئيسية)\nمثال: التحصينات الخارجية للقلعة",
 "ざいだん": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "ざいち": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "ざいちゅうぶつ": "مُحْتَوَى, مَضْمُون",
 "ざいてん": "سَمَاوِيّ",
 "ざいにちかんこくじん": "كوري جنوبي (من أو يتعلق بكوريا الجنوبية أو شعبها أو يميزهم) / كوري جنوبي (كوري من كوريا الجنوبية)",
 "ざいにん": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "ざいにんきかん": "فترة منصب, فترة ولاية (الفترة التي يتم خلالها شغل منصب ما)",
 "ざいのう": "جِزْدَان, جُزْدَان / أَمْوَال, ثَرْوَة",
 "ざいはく": "مِرْسَاة, أَنْجَر / مُذِيع, مُذِيعَة / رَسَا ((رَسَا) الشيءُ يَرْسُو رَسْواً، ورُسُوّاً: ثَبَتَ؛ رَسا الجبلُ: ثَبَتَ أصَله في الأَرض)",
 "ざいばつ": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "ざいふりぼく": "ساسكاتون (توت أرجواني أو أحمر صالح للأكل)",
 "ざいぶつ": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "ざいぶんべん": "وضع, ولادة (عملية الولادة)",
 "ざいほう": "كَنْز",
 "ざいむしょう": "وزير المالية (الوزير المسؤول عن مالية الدولة)",
 "ざいむしょひょう": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "ざいむだいじん": "وزير المالية (الوزير المسؤول عن مالية الدولة)",
 "ざいむちょうかん": "وزير الخزانة (منصب رئيس وزارة الخزانة) / وزير الخزانة (الشخص الذي يشغل منصب وزير وزارة الخزانة)\nمثال: تم إنشاء منصب وزير الخزانة عام 1789",
 "ざいめい": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "ざいもく": "خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "ざいもつ": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "ざいや": "غَيْرُ مُنْتَسِب (لَيْسَ لَدَيْهِ انْتِسَابٌ أَوِ ارْتِبَاطٌ بِجِهَةٍ مَا)",
 "ざいやせいしん": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "ざいやとう": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "ざいらい": "سَابِق الوُجُود, مَوْجُود سَلَفًا (كان موجودًا من قبلُ أو قبل شيء آخر)",
 "ざいりゅう": "أَقَامَ, سَكَنَ (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "ざいりゅうしかくほじしゃ": "إِقَامَة, تَصْرِيح إِقَامَة",
 "ざいりゅうしゃ": "سَاكِن, سَاكِنَة",
 "ざいりゅうみん": "سَاكِن, سَاكِنَة",
 "ざいりょう": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "ざいりょく": "أَمْوَال, ثَرْوَة",
 "ざか": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "ざきょう": "تَرْفِيه, تَسْلِيَة",
 "ざくざく": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة / كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "ざくつ": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "ざくり": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة / بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "ざくろ": "رُمَّان",
 "ざくろいし": "بِجَادِيّ",
 "ざくろばな": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد)",
 "ざくろ石": "بِجَادِيّ",
 "ざくろ鼻": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد)",
 "ざこつ": "إسك, عظم الإسك (أحد الأقسام الثلاثة لعظم الورك؛ يقع أسفل الحرقفة)",
 "ざこつしんけい": "عصب النسا",
 "ざこつしんけいつう": "عِرْق النَّسَا, النَّسَا (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "ざこキャラ": "رعاع, غوغاء (حشد غير منظم من الناس) / عصابة (رابطة من المجرمين) / عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: حاولت الشرطة تفكيك العصابة",
 "ざさしんたい": "تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "ざざい": "تَحْمِيلَة, لَبُوس",
 "ざざっ": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام / بخفة, برشاقة (بطريقة رشيقة وسريعة)\nمثال: يتسلق برشاقة بوابة حديدية",
 "ざしき": "حفل عشاء, عزومة عشاء (حفلة يجتمع فيها الناس لتناول العشاء معاً)\nمثال: يجب ألا يتأخر الضيوف عن حفل العشاء أبداً",
 "ざしょ": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "ざしょう": "اِلْتِوَاء / تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "ざす": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز / جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "ざする": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "ざせき": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "ざせきすう": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "ざせつ": "نَكْسَة",
 "ざそう": "حَبُّ الشَّبَاب (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / رَضّ (رَضَّ يَرُضُّ: رَضًّا؛ رَضَّ الشيء: دقه وطحنه طحنا خشنا)",
 "ざだん": "مُحَادَثَة / مُكَالَمَة / حِوَار / مُذَاكَرَة / مُحَاوَرَة / تَكَلُّم (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "ざだんかい": "سِمْبُوزِيُوم, نَدْوَة",
 "ざちゅう": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "ざちょう": "رَئِيس",
 "ざっか": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها) / توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام التصريفات)) / تلفيقية, توفيقية (اتحاد (أو محاولة دمج) أنظمة فكرية أو معتقدات مختلفة (خاصة في الدين أو الفلسفة))\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "ざっかしょう": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "ざっかや": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "ざっきちょう": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "ざっきょ": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / مِلَّة\nمثال: سامي خطر للمجتمع.",
 "ざっきん": "مِيكْرُوب",
 "ざっくばらん": "إِفْرَنْجِيّ",
