 "さんてんリーダ": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)\nمثال: حذف ياني حسابه.",
 "さんてんリーダー": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)\nمثال: حذف ياني حسابه.",
 "さんとう": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار) / سكر ثلاثي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج ثلاثة جزيئات من السكر الأحادي عند…)",
 "さんとうきん": "ذَات اَلثَّلَاث رُؤُوسّ, مُثَلَّثَة اَلرُّؤُوس",
 "さんとうくうそう": "رقيب أركان (ضابط صف رتبته أعلى من عريف وأقل من رقيب أول في الجيش أو المارينز)",
 "さんとうぐんそう": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا…)",
 "さんとうしん": "استجواب قسري, الدرجة الثالثة (استجواب يصاحبه غالبًا تعذيب لانتزاع معلومات أو اعتراف)",
 "さんとうじゅうやく": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "さんとうせいじ": "حكم ثلاثي, مجلس ثلاثي (مجموعة من ثلاثة رجال مسؤولين عن الإدارة العامة أو السلطة المدنية)",
 "さんとうぶん": "ثَلَّثَ الزَاوِيَة (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله…)\nمثال: الساعة العاشرة والثلث.",
 "さんとうへいそう": "ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش)",
 "さんとうりくい": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة)",
 "さんとうりくさ": "رَائِد",
 "さんとうりくそう": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا…)",
 "さんとうるい": "سكر ثلاثي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج ثلاثة جزيئات من السكر الأحادي عند…)",
 "さんとくほうちょう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "さんとくぼうちょう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "さんど": "حُمُوضَة / ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / ثَالِث, ثَالِثَة\nمثال: الساعة العاشرة والثلث.",
 "さんどいり": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "さんどう": "درب جبلي (مسار عبر منطقة جبلية) / ممشى (مسار مخصص للمشي)\nمثال: بعد العاصفة الثلجية جرف الثلج من الممشى الأمامي / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض. / قناة الولادة (ممر في الرحم والمهبل يمر عبره الجنين أثناء الولادة الطبيعية) / توسع الحدقة (توسع انعكاسي للحدقة حيث تسحب العضلة القزحية للخارج؛ يحدث استجابة لانخفاض الضوء…)",
 "さんどうしゃ": "محامي, محامية",
 "さんどうやく": "دواء موسع للحدقة, موسع الحدقة (دواء يسبب توسع حدقة العين؛ يستخدم للمساعدة في فحوصات العين)",
 "さんどさんど": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "さんどのわおん": "ثالوث, كورد ثلاثي (كورد ثلاثي النوتات كبير أو صغير؛ نوتة وثالثتها وخامستها)",
 "さんどまめ": "فاصولياء شائعة (أي من أنواع الفاصولياء العديدة التي تؤكل طازجة أو مجففة) / بازلاء ثلجية, بازلاء سكرية (بازلاء خضراء ذات قرون مسطحة صالحة للأكل)",
 "さんにゅう": "دخول (فعل الدخول)\nمثال: قامت بدخول مهيب / شَامِل",
 "さんにんぐみ": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين)",
 "さんにんこん": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "さんにんしょう": "غَائِب",
 "さんにんしょうたんすうげんざい": "غَائِب",
 "さんねんせい": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي…)",
 "さんはかせ": "مَجُوس",
 "さんはんきかん": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض…)",
 "さんば": "قَابِلَة, دَايَة",
 "さんばい": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "さんばいたい": "ثُلَاثِيّ الصِّيغَة الصِّبْغِيَّة (لخلية أو كائن حي يحتوي على ثلاث مجموعات كاملة من الكروموسومات)",
 "さんばがらす": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين)",
 "さんばし": "رَصِيف",
 "さんばん": "ثَالِث, ثَالِثَة\nمثال: الساعة العاشرة والثلث.",
 "さんばんしょうぶ": "مَطَّاط",
 "さんばガラス": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين)",
 "さんぱい": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / تحميض, تخليل (عملية التحول إلى حمض أو التحويل إلى مادة حمضية)",
 "さんぱいきゃく": "زَائِر",
 "さんぱいきゅうはい": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "さんぱいしゃ": "عَابِد",
 "さんぱつ": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة / حَلَاقَة",
 "さんぱつてき": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "さんぱつや": "حَلَّاق",
 "さんび": "مِدْحَة, إِثْنَاء / مُذْهِل, مُفْزِع (يسبب الذعر والفزع)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "さんびか": "تَرْتِيلَة, تَرْنِيمَة",
 "さんびゃく": "ثَلَاثُمِئَة (يَدُلُّ عَلَى العَدَد 300) / مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية)",
 "さんびゃくだいげん": "مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية) / سفسطائي (شخص يكون استدلاله دقيقاً وغالباً ما يكون خادعاً)",
 "さんびょうし": "وزن ثلاثي (زمن موسيقي بثلاث نقرات في كل مقياس)",
 "さんぴ": "نَعْم وَلَا, بَلَى وَنَعْم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "さんぴりょうろん": "مَحَاسِن وَمَسَاوِئ",
 "さんぴん": "مُنْتَج",
 "さんぶかい": "المجلس العمومي الفرنسي, الولايات العامة الفرنسية (جمعية تمثل فئات فرنسا بأكملها؛ كان آخر اجتماع لها في عام 1789)",
 "さんぶさく": "ثُلَاثِيَّة",
 "さんぶつ": "مُنْتَج / تَسَبَّب",
 "さんぶん": "نَثْر",
 "さんぶんし": "قصيدة نثر (نثر يشبه الشعر)",
 "さんぶんてき": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة)",
 "さんぶんほう": "انقسام ثلاثي (كون الشيء ثلاثياً؛ تصنيف إلى ثلاثة أجزاء أو فئات فرعية)",
 "さんぷ": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / برنامج, برنامج حاسوبي ((علم الحاسوب) تسلسل من التعليمات التي يمكن للحاسوب تفسيرها وتنفيذها)\nمثال: تطلب البرنامج عدة مئات من سطور الكود",
 "さんぷうこ": "بولي تناسلي (متعلق بالأعضاء التناسلية والبولية أو وظائفها)\nمثال: عدوى الجهاز البولي التناسلي",
 "さんぷく": "سفح التل (جانب أو منحدر التل)",
 "さんぷど": "عَدَم الصِّلَة, عَدَم العَلَاقَة (عدم وجود علاقة لشيء ما بالموضوع المطروح)",
 "さんぷりょう": "عَدَم الصِّلَة, عَدَم العَلَاقَة (عدم وجود علاقة لشيء ما بالموضوع المطروح)",
 "さんへいほうのていり": "مُبَرْهَنَةْ فِيثَاغُورَس",
 "さんべつ": "نقابة صناعية (نقابة عمالية تقبل جميع العمال في صناعة معينة بغض النظر عن حرفتهم)",
 "さんべつかいぎ": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في…)",
 "さんべん": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "さんぺい": "مناوش",
 "さんぺいせん": "خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "さんぼう": "ضابط أركان (ضابط مفوض معين في طاقم القائد العسكري) / مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم / مَعْبَد / ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس.",
 "さんぼうかじょ": "عذق, نورة عذقية (نورة مسطحة القمة أو محدبة تنمو فيها سيقان الزهور الفردية للأعلى من نقاط مختلفة…)",
 "さんぼうそうちょう": "رئيس أركان الجيش",
 "さんぼうちょう": "رئيس أركان الجيش",
 "さんぼうほんぶ": "هيئة الأركان العامة (ضباط عسكريون معينون لمساعدة ضابط كبير في تخطيط السياسة العسكرية)",
 "さんぼうよし": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "さんぼん": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "さんぽ": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "さんぽう": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن…)\nمثال: الحساب لو سمحت.",
 "さんぽうげんご": "لغة خوارزمية (لغة مصطنعة مصممة للتعبير عن الخوارزميات)",
 "さんぽうよし": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "さんぽさがって": "بتواضع (بطريقة متواضعة)\nمثال: خفض رأسه بتواضع",
 "さんぽみち": "تجوال, تنزة (مشي متمهل (عادة في مكان عام))",
 "さんまいえ": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية…)",
 "さんまいつづき": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية…)",
 "さんまいめ": "كُومِيدْيَان / أُضْحُوكَة, مَضْحَكَة",
 "さんまいや": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "さんまや": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "さんまん": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "さんみ": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / ثَالُوث",
 "さんみいったい": "ثَالُوث",
 "さんみゃく": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "さんめんきょう": "ثُلَاثِيّ الأَضْلَاع (ذو ثلاثة أضلاع)",
 "さんめんろっぴ": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "さんもくならべ": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع…)",
 "さんもん": "رُخْص (رَخُصَ يَرْخُصُ رَخاصةً ورُخوصةً ورُخْصانًا: نَعُم ولان؛ فهو رَخْص ورَخِيص)\nمثال: هل تملك رخصة قيادة؟ / مَعْبَد",
 "さんもんしばい": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "さんもんしょうせつ": "رواية تجارية, رواية رخيصة (رواية ورقية ميلودرامية رخيصة الثمن)",
 "さんもんばん": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "さんもんぶんし": "كاتب مأجور (كاتب متواضع المستوى ومحتقر (يكتب من أجل المال فقط دون اهتمام بالجودة))",
 "さんもんやくしゃ": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "さんや": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "さんゆうかん": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "さんよ": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف…)",
 "さんよう": "تحسيب / الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "さんようすうじ": "رَقْم عَرَبِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "さんようちゅう": "ثلاثي الفصوص (مفصلي منقرض كان وفيراً في عصور حقب الحياة القديمة؛ كان له هيكل خارجي مقسم إلى…)",
 "さんよしゃ": "مُشَارِك",
 "さんらいい": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
