 "ぜっする": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "ぜっせんおん": "ذروَة (أعلى كلِّ شيء؛ أعلى نقطة أو أرفع موضع)",
 "ぜっそく": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ぜったい": "مطلقا, على الإطلاق / مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "ぜったいあんぜん": "مُحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "ぜったいおうせい": "مَلَكِيَّة مُطْلَقَة",
 "ぜったいくんしゅせい": "مَلَكِيَّة مُطْلَقَة",
 "ぜったいさいしょくしゅぎ": "خُضْرِيَّة, نَبَاتِيَّة صِرْفَة",
 "ぜったいさいしょくしゅぎしゃ": "خُضْرِيّ",
 "ぜったいしゃ": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "ぜったいすう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "ぜったいち": "قِيمَة مُطْلَقَة",
 "ぜったいてき": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "ぜったいに": "مطلقا, على الإطلاق",
 "ぜったいれいど": "صِفْر مُطَلِّق, دَرَجَة الصُّغَر الْمُطْلَق (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "ぜったん": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ぜっちょう": "قِمَّة / أَوْجٌ, ذُرْوَةٌ / نَشْوَة, هِزَّة اَلْجِمَاع",
 "ぜっちょうき": "قِمَّة / يضع شيء على قمة عالية",
 "ぜってぇ": "مطلقا, على الإطلاق / مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "ぜってえ": "مطلقا, على الإطلاق / مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "ぜってー": "مطلقا, على الإطلاق / مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "ぜっとう": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ぜっぱいおん": "ظَهْرِيّ",
 "ぜっぴん": "تُحْفَة, رَائِعَة",
 "ぜっぺき": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "ぜっぽう": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "ぜっぽうするどい": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "ぜついんしょく": "صَوْم, صِيَام",
 "ぜつえん": "تَوَحُّد",
 "ぜつだい": "عِمْلاق",
 "ぜつねん": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "ぜつぼう": "يَئِسَ / يَأْس",
 "ぜつぼうてき": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "ぜつみょう": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "ぜつむ": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ぜつめい": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ぜつめつ": "اِنْقِرَاض",
 "ぜつめつきぐ": "هَدَّدَ / أَنْذَرَ",
 "ぜつめつしゅうようじょ": "مُعَسْكَر إِبَادَة, مُعَسْكَر مَوْت",
 "ぜとする": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "ぜに": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "ぜにいれ": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "ぜにかね": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "ぜにん": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "ぜひ": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / مَحَاسِن وَمَسَاوِئ",
 "ぜひぜひ": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "ぜひとも": "بِأَيِّ ثَمَنٍ",
 "ぜひない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "ぜひにおよばず": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "ぜひもない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "ぜひもなし": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ぜん": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "ぜんい": "عن حسن نيَة (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "ぜんいつ": "وَحْدَة, اِتِّحَاد",
 "ぜんいん": "الْجَمِيع, كُلّ شَخْص",
 "ぜんえい": "طَلِيعَة / صَاعِدًا / مُهَاجِم",
 "ぜんえいせん": "مُنَاوَشَة",
 "ぜんおんぷ": "مُسْتَدِيرَة (مؤنث مُسْتَدِير، يُجمع جمعًا سالمًا على مُسْتَدِيرَات)",
 "ぜんか": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
