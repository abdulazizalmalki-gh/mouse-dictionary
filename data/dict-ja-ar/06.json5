 "たいしつてき": "بُنْيَوِيّ / دُسْتُورِيّ",
 "たいして": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "たいしゃ": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "たいしゃく": "قَرْض, إِعَارَة",
 "たいしゃしょうこうぐん": "مُتَلَازِمَة الأَيْض, المُتَلَازِمَة الاِسْتِقْلَابِيَّة",
 "たいしゅ": "نَائِب",
 "たいしゅう": "رائحَة الجسم (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…)\nمثال: شم تلك الرائحة.",
 "たいしゅうおんがく": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "たいしゅうかい": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "たいしゅうしゅぎ": "شَعْبَوِيَّة",
 "たいしゅうせい": "شَعْبِيَّة",
 "たいしゅうてき": "مَحْبُوب",
 "たいしゅうむけ": "مَحْبُوب",
 "たいしゅく": "ضُمُور, تَلَاشٍ / ضَمُرَ, تَلَاشَى",
 "たいしゅつ": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "たいしょ": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "たいしょう": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "たいしょうがい": "مُعْفًى",
 "たいしょうぐん": "رَئِيس أَرْكَان",
 "たいしょうしゃ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "たいしょうせい": "تَنَاظُر",
 "たいしょうたい": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "たいしょうてき": "مُتَنَاظِر, مُتَمَاثِل",
 "たいしょうはんい": "حَيِّز",
