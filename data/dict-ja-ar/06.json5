 "この先": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "この前": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "この場合": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この外": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "この度": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "この後": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "この所": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "この故に": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "この方": "مُنْذُ / هَٰذَا, هَٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "この方達": "هُمَا",
 "この期": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "この様に": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この次": "قَادِم\nمثال: زيري بجانب الحوض.",
 "この次から": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "この父にしてこの子あり": "الْوَلَدُ سُرّ أَبِيهِ",
 "この程": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "この節": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "この結果": "بِٱلتَّالِي, وَعَلَيْهِ فَإِنَّ",
 "この親にしてこの子あり": "الْوَلَدُ سُرّ أَبِيهِ",
 "この通り": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この間": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟",
 "この限りでない": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この限りではありません": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この限りではない": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この際": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "この頃": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام / آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "この頃様": "عَصْرِيّ, حَدِيث",
 "こはく": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد…)",
 "こはくいろ": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد…)",
 "こはくさん": "حمض السكسينيك, حمض الكهرمان (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "こはくちょう": "تم التندرا (بجعة تعشش في مناطق التندرا في العالم الجديد والقديم)",
 "こはずかしい": "قَلِيلًا",
 "こはぜ": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "こはだ": "نَبَحَ, يَنْبَح",
 "こはな": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "こはば": "صَغِير, صغير",
 "こはるびより": "صَيْف هِنْدِيّ (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "こはん": "شاطئ البحيرة (شاطئ بحيرة)",
 "こば": "شَظِيَّة",
 "こばい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "こばいけいそう": "خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج…)",
 "こばいしゃ": "مِذْيَاع, رَادِيُو",
 "こばか": "مُغَفَّل, أَحْمَق",
 "こばかにする": "تَرَفَّعَ",
 "こばく": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب)\nمثال: كانت القوارب مربوطة ببعضها البعض بالحبال",
 "こばこ": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى)",
 "こばしちどり": "زقزاق أوراسي (زقزاق نادر من المناطق المرتفعة في أوراسيا)",
 "こばしら": "عمود صغير, عُميد (عمود صغير (أو هيكل يشبه العمود) يمثل جزءاً من نبات أو حيوان)",
 "こばしり": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً)",
 "こばち": "دبور كالسيد, ذبابة كالسيد (أي من الحشرات الدقيقة المتنوعة التي تتطفل يرقاتها على بيض ويرقات الحشرات الأخرى…)",
 "こばと": "زُغْلُول, جَوْزَل",
 "こばな": "مَنْخَر",
 "こばなし": "نَادِرَة\nمثال: هي مدرسة لطيفة.",
 "こばねう": "قَصِير الأَجْنِحَة ((عن بعض الحشرات خاصّة) ذو أجنحة قصيرة جدًّا أو أثريّة)",
 "こばむ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "こばら": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "こばん": "إِهْلِيلَج",
 "こばんがた": "إِهْلِيلَج",
 "こばんざめ": "ريمورا, سمكة مصاصة (أسماك بحرية ذات جسم ممدود مسطح وقرص ماص على الرأس للالتصاق بالأسماك الكبيرة أو…) / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "こひざ": "رُكْبَة",
 "こひしつ": "قشرة عتيقة (القشرة الشمية للمخ)",
 "こひつじ": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "こひょう": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "こび": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "こびき": "خنفساء ناشرة (أي من الخنافس المتعددة التي تحفر يرقاتها ثقوباً في الأشجار الميتة أو المحتضرة…)",
 "こびきだい": "حامل النشر (هيكل لحمل الخشب الذي يتم نشره)",
 "こびじゅつ": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "こびじゅつしょう": "أثري, جامع تحف (خبير أو جامع للآثار والتحف القديمة)",
 "こびじゅつひん": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "こびと": "قَزَم",
 "こびとしょう": "تقزم (خلل جيني يؤدي إلى قصر القامة)",
 "こびへつらう": "تَمَلَّقَ, تَبَصْبَصَ",
 "こびゃくしょう": "فَلَّاح, فَلَّاحَة",
 "こびょうりがく": "علم الأمراض القديمة (دراسة أمراض العصور السابقة (المستنتجة من الأدلة الأحفورية))",
 "こびる": "تَمَلَّقَ, تَبَصْبَصَ / غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "こびをうる": "رجل لعوب, متغزل (رجل مغر يستخدم جاذبيته لاستغلال النساء) / تَمَلَّقَ, تَبَصْبَصَ",
 "こぴっと": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "こふ": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "こふう": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "こふく": "سَعَادَة, فَرَح",
 "こふん": "برويطة, عربة يدوية بعجلة واحدة (عربة لحمل الأحمال الصغيرة؛ لها مقابض وعجلة واحدة أو أكثر)",
 "こぶ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / خبطة, ضربة (ارتطام (كما هو الحال في التصادم))\nمثال: الخبطة ألقته عن الدراجة / عشب البحر, كيلب (أعشاب بحرية بنية كبيرة لها سعف جلدي متموج)",
 "こぶうし": "بقر الهند, زيبو (ثور مستأنس له سنام على الظهر وقرون طويلة ولبب كبير؛ يستخدم بشكل رئيسي كحيوان جر…)",
 "こぶくろ": "رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه.",
 "こぶげきれい": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "こぶし": "قَبْضَة / سَامُورَاي / مُحَارِب قَدِيم",
 "こぶた": "خِنَّوْص",
 "こぶつ": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / فَرْد, شَخْص",
 "こぶとり": "سمين",
 "こぶね": "قارب صغير (قارب صغير الحجم)",
 "こぶはくちょう": "تَمّ أَخْرَس",
 "こぶら": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري.",
 "こぶり": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما) / رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ)\nمثال: 我々は雨が小降りになったとき出発した。 — سوف ننطلق عندما يخفّ هطول المطر.",
 "こぶん": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب. / حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "こぶんがく": "عِلْم الكِتَابَات القَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こぶんしょ": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "こへい": "مُحَارِب قَدِيم",
 "こべつ": "فَرْد, شَخْص / مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "こべつか": "تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)",
 "こべつしどう": "تعليمي, دروس خصوصية (من أو متعلق بالمعلمين الخصوصيين أو التدريس الخصوصي)\nمثال: جلسات تعليمية",
 "こべつてき": "فَرْد, شَخْص",
 "こべつはんばい": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "こべつほうもん": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "こべや": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد)\nمثال: اقترب من الخزانة.",
 "こほこほ": "سعال, كحة (طرد مفاجئ ومزعج للهواء من الرئتين يطهر ممرات الهواء؛ عرض شائع لعدوى الجهاز…) / مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ)",
 "こほつ": "دَمَّرَ",
 "こほん": "كَحَّ, سَعَلَ\nمثال: سعل زيري مرة أخرى.",
 "こぼうず": "شقي, عفريت (شخص مؤذٍ بمرح)",
 "こぼしばなし": "تَذَمَّرَ, اِشْتَكَى",
 "こぼしや": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "こぼし屋": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "こぼし話": "تَذَمَّرَ, اِشْتَكَى",
 "こぼす": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / قَمْقَمَ",
 "こぼつ": "دَمَّرَ",
 "こぼれ": "ثلم, حز (قطع صغير)\nمثال: هو في السجن / دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / ذهاب, رحيل (فعل المغادرة)",
 "こぼれおちる": "نَثَرَ, تَفَرَّقَ",
 "こぼれざいわい": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "こぼれだす": "فَيَضَان",
 "こぼれだね": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こぼれだま": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "こぼればなし": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "こぼれる": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "こぼれダネ": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こぼれ幸い": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "こぼれ球": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "こぼれ種": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こぼれ落ちる": "نَثَرَ, تَفَرَّقَ",
 "こぼれ話": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "こぼんのう": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "こぽこぽ": "غَرْغَرَ, بَقْبَقَ",
 "こま": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / دُوَّامَة, بُلْبُل / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / مَنْظَر, مَشْهَد / كُورِيّ",
 "こまあみ": "غرزة حشو, غرزة كروشيه مفردة (غرزة الكروشيه الأساسية)",
 "こまい": "شريحة خشبية (شريط رفيع ضيق من الخشب يستخدم كدعم للجص أو لعمل الشبكات الخشبية) / صَغِير, صغير / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "こまおち": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز)\nمثال: إعاقة القراءة",
 "こまか": "صَغِير, صغير",
 "こまかい": "صَغِير, صغير / غَرَامَة / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "こまかいおかね": "فُرَاطَة",
 "こまかいかね": "فُرَاطَة",
 "こまかいこと": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "こまかく": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "こまがた": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع)",
 "こまぎれ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "こまく": "طَبْلَة اَلْأُذْن",
 "こまくえん": "التهاب الأذن الداخلية, التهاب الطبلة (التهاب الأذن الداخلية)",
 "こまくちょうきん": "موترة الطبل (عضلة صغيرة في الأذن الوسطى تتوتر لحماية طبلة الأذن)",
 "こまごま": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "こまごましい": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في…)\nمثال: استأذنت لدقيقة. / مُزْعِج / مُفَصَّل",
 "こまごました": "مُخْتَلِف, مُتَنَوَّع",
 "こまごまとした": "مُخْتَلِف, مُتَنَوَّع",
 "こまざ": "مهر (ذكر حصان صغير يقل عمره عن أربع سنوات)",
 "こます": "أَغْرَى, أَغْوَى / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "こまた": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)\nمثال: أخذوا المفترق الجنوبي",
 "こまち": "حسناء (شابة هي الأكثر سحراً وجمالاً بين عدة منافسات)\nمثال: كانت حسناء الحفل",
 "こまちむすめ": "جَمَال, زَيْن",
 "こまっこう": "حوت العنبر القزم (حوت عنبر صغير يعيش في المياه الدافئة لكلا ساحلي أمريكا الشمالية)",
 "こまった": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة)\nمثال: طفل صعب المراس / غير مناسب, في غير وقته (غير مناسب من حيث التوقيت)\nمثال: وصل في ساعة غير مناسبة للغاية / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب)",
 "こまったこと": "مُشْكِلَة, مَتاعِب",
 "こまったことに": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "こまったちゃん": "إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة)\nمثال: إزعاج بسيط",
 "こまったひと": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "こまった事": "مُشْكِلَة, مَتاعِب",
 "こまった人": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "こまつぐみ": "أبو الحناء الأمريكي (سمنة أمريكية كبيرة ذات صدر وبطن أحمر صدئ)",
 "こまづかい": "خَادِمَة, خَدامَة",
 "こまど": "قمرية, نافذة هلالية (فتحة بيضاوية أو دائرية؛ للسماح بدخول الضوء إلى قبة أو قبو)",
 "こまむすび": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "こまめ": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "こまもの": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "こまものや": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "こまものやをひらく": "تَقَيَّأَ, قَاءَ",
 "こまやか": "طَرِيّ, غَضّ ((عَنِ النَّبَاتَاتِ) غَيْرُ مُقَاوِم؛ يَسْهُلُ أَنْ يَمُوتَ بِظُرُوفِ…) / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / عَمِيق, غَوِيط",
 "こまゆみ": "شجرة المغزل, غدب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "こまらせる": "أَخْجَلَ (أَخْجَلَ (النباتُ): خَجِلَ؛ أَخْجَلَ (فلانًا): جعله يخجل)\nمثال: أخجل من تصرف ولدي.",
 "こまりごと": "تَمْرِين",
 "こまりもの": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / إِزْعَاج",
 "こまわり": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "こま切れ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "こま結び": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "こみ": "كُومِي",
 "こみあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "こみあげる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "こみいった": "دَقِيق, مُتْقَن (ذُو عَنَاصِرَ كَثِيرَة مُرَتَّبَة بِشَكْل مُعَقَّد؛ مُفَصَّل)",
 "こみこみ": "شَامِل كُلّ شَيْء / مُزْدَحِم",
 "こみだし": "عنوان فرعي (عنوان لقسم فرعي من نص) / مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق) / كُومِي",
 "こみち": "طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "こみみずく": "قَصِيرُ الأُذُنَيْن (له أذنان قصيرتان)",
 "こみら": "ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "こみ上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "こみ上げる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "こみ入った": "دَقِيق, مُتْقَن (ذُو عَنَاصِرَ كَثِيرَة مُرَتَّبَة بِشَكْل مُعَقَّد؛ مُفَصَّل)",
 "こむ": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة…)\nمثال: الباقي ليس مهم.",
 "こむぎ": "قَمْح, حِنْطَة",
 "こむぎいろ": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "こむぎこ": "دقيق القمح, طحين القمح (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "こむぎはいが": "جنين القمح (جنين حبة القمح؛ يُزال قبل الطحن ويؤكل كمصدر للفيتامينات)",
 "こむぎはいがゆ": "جنين القمح (جنين حبة القمح؛ يُزال قبل الطحن ويؤكل كمصدر للفيتامينات)",
 "こむぎばたけ": "حقل قمح (حقل مزروع بالقمح)",
 "こむぎグルテン": "غلوتين القمح (غلوتين محضر من القمح)",
 "こむし": "هاموش (ذبابة دقيقة ذات جناحين تشبه البعوض تفتقر إلى أجزاء الفم القارضة؛ تظهر في أسراب…)",
 "こむすめ": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "こむずかしい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "こむつかしい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "こむら": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد) / عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري. / هَامْلِت",
 "こむろ": "صَوْمَعَة, كِرْح / هَالَة",
 "こめ": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز / أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / تَعْلِيق, مَلْحُوظَة / إِلَى أَقْصَى حَدٍّ, اَلنُّونِيّ (الأخير أو الأعظم في سلسلة كبيرة غير محددة)",
 "こめかみ": "مَعْبَد",
 "こめくいどり": "ممراح",
 "こめくいむし": "سوسة الأرز (سوسة بنية تغزو الحبوب المخزنة وخاصة الأرز) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "こめこ": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "こめじるし": "إِجَّامَة, نُجَيْمَة",
 "こめつきばった": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "こめつきむし": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "こめねずみ": "جرذ الأرز (جرذ رشيق قوي التحمل يعيش في المستنقعات العشبية في المكسيك وجنوب شرق الولايات…)",
 "こめびつ": "مُعِيل, عَائِل",
 "こめもの": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء / أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل…)\nمثال: يصنع قطعة أثاث خشبية.",
 "こめる": "حِمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / تضمن / كفن",
 "こも": "سَائِل",
 "こもう": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "こもかぶり": "سَائِل",
 "こもごも": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "こもじ": "حرف صغير (الأحرف التي كانت تُحفظ سابقاً في النصف السفلي من صندوق حروف الطباعة) / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / طَحِين, دَقِيق",
 "こもち": "أبوة أو أمومة, والدية (حالة كونه والداً)\nمثال: لمفاجأة الجميع، أصلحت الأبوة الرجل",
 "こもちかんらん": "كُرُنْب بْرُوكْسِل",
 "こもの": "كَمَالِيّ\nمثال: علي مساعدة ماري. / صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / خَادِم, خَادِمَة",
