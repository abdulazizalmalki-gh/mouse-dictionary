 "ごろりと": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود / بسهولة, دون جهد (بدون جهد أو جهد ظاهر)\nمثال: رقصت برشاقة ودون جهد",
 "ごろりとよこになる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "ごろりと横になる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "ごろんごろん": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض)\nمثال: سمعوا هدير الرعد / تحريك بالعجلات, دحرجة (دفع شيء على عجلات)\nمثال: اتُهم بسلب السكارى في الحديقة / جَمِيع أَنْحَاء, كُلّ / باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "ごろんじゃる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "ごろんと": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود / بسهولة, دون جهد (بدون جهد أو جهد ظاهر)\nمثال: رقصت برشاقة ودون جهد",
 "ごわごわ": "بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب",
 "ごわさん": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "ごわす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ごわり": "خَمْسُون بِالْمِائَة (النصف معبراً عنه كنسبة مئوية)",
 "ごわんす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ごん": "معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك / أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في…)",
 "ごんいざん": "معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك",
 "ごんか": "بسرعة, على الفور (بطريقة دقيقة في المواعيد)\nمثال: أدى واجبه المنزلي بسرعة",
 "ごんぎょう": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "ごんぎょうじほうがかり": "مُؤَذِّن",
 "ごんく": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "ごんげ": "الحُلُول / تَجَسَّد",
 "ごんこつ": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "ごんご": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "ごんごどうだん": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "ごんごん": "فَرْقَعَة",
 "ごんさい": "سَيِّدَة",
 "ごんじょう": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)",
 "ごんす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "ごんすけ": "خادم رجل (خادم من الرجال)",
 "ごんてき": "سَيِّدَة",
 "ごんぶと": "سَمِيك, غَلِيظ",
 "ごんべい": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان. / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "ごんべえ": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان. / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "ごんぼ": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في…)",
 "ごエス": "خَمْسَة (يَدُلُّ عَلَى العَدَد 5)",
 "ごーごー": "مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ)",
 "ご一緒": "مَعًا, سَوِيًّا",
 "ご丁寧": "أَدِيب, مُؤَدَّب / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "ご不浄": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ご両親": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "ご主人": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)",
 "ご主人様": "سَيِّد\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)",
 "ご了承": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "ご仁": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)\nمثال: ظهرت شخصية غريبة عند الباب",
 "ご令嬢": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ご令息": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ご兄弟": "شَقِيق, شَقِيقَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "ご免": "أَنَا آسِف, أَنَا آسِفَة / تَصْرِيح, سَمَاح / إِقَالَة",
 "ご免なさい": "أَنَا آسِف, أَنَا آسِفَة",
 "ご利益": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا. / فَائِدَة, جَدْوَى",
 "ご協力": "تَعَاوُن",
 "ご参考まで": "لمعلوماتك",
 "ご多分": "غَالِبِيَّة, أَغْلَبِيّة",
 "ご多分に洩れず": "كَمَا هُوَ, كَمَا هِيَ",
 "ご多分に漏れず": "كَمَا هُوَ, كَمَا هِيَ",
 "ご多忙中": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "ご大層": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "ご夫人": "زَوْجَة, اِمْرَأَة",
 "ご存じ": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "ご存知のとおり": "كَمَا تَعْلَمُ",
 "ご存知の通り": "كَمَا تَعْلَمُ",
 "ご寮人": "سَيِّدَة",
 "ご尤も": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ご幣担ぎ": "خُرَافَة",
 "ご座所": "بَقَاء\nمثال: إذهب إلى الدار.",
 "ご廟": "ضَرِيح, مَرْقَد / ضَرِيح",
 "ご当地": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ご影": "صُورَة",
 "ご心配なく": "غَيْر مُهِمّ, لَا بَأْس (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ご念": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ご意見番": "مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف…)",
 "ご意見箱": "مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف…)",
 "ご愛嬌": "تَرْفِيه, تَسْلِيَة",
 "ご愛敬": "تَرْفِيه, تَسْلِيَة",
 "ご愛顧": "إقبال الزبائن, تجارة (الأعمال التي يقدمها العملاء لمؤسسة تجارية)\nمثال: حتى قبل الظهر كان هناك إقبال كبير",
 "ご所": "قَيْصَر, إِمْبْرَاطُور",
 "ご承知のとおり": "كَمَا تَعْلَمُ",
 "ご承知のように": "كَمَا تَعْلَمُ",
 "ご承知の通り": "كَمَا تَعْلَمُ",
 "ご挨拶": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها…)\nمثال: ألقى زيري تحية.",
 "ご新造": "زَوْجَة, اِمْرَأَة",
 "ご方便": "مُلَاءَمَة, مُنَاسَبَة",
 "ご時世": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ご本": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "ご本尊": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى…)",
 "ご案内": "إِرْشَاد, هِدَايَة / مَعْلُومَات, مَعْلُومَة / إِعْلَان, بَلَاغ / دَعْوَة, عزيمة",
 "ご機嫌": "فُكَاهَة, دُعَابَة\nمثال: خلط توم بين السكر و الملح. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن. / فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "ご機嫌とり": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "ご機嫌ななめ": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "ご機嫌よう": "صَبَاح الْخَيْر, صَبَاح النُّور / الوداع",
 "ご機嫌取り": "خَنُوع, مُتَذَلِّل (شخص يذل نفسه كعلامة على الاحترام؛ يتصرف وكأنه بلا كرامة)",
 "ご機嫌斜め": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "ご武運を": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "ご殿": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ご沙汰": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "ご法度": "مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "ご注意": "اِهْتِمَام, اِنْتِبَاه / اِهْتِمَام / نَصِيحَة, مَشُورَة",
 "ご注文": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ご用": "شَرِكَة\nمثال: المهم هو العمل. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "ご用の方": "زَبُون, عَمِيل",
 "ご用納め": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ご用組合": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "ご用聞き": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "ご用達": "متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ご破算": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "ご立派": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين)",
 "ご紋": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر)",
 "ご紹介": "مُقَدَّمَة",
 "ご縁": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / عَلَاقَة, مُنَاسَبَة",
 "ご老人": "عجوز, كبير السن (شخص متقدم في السن)",
 "ご膳": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / إصدار مُكَلف",
 "ご自身": "نفسكَ, نفسكِ",
 "ご苦労": "مُشْكِلَة, مَتاعِب / شُكْرًا, تِسْلَم",
 "ご苦労さま": "شُكْرًا, تِسْلَم",
 "ご苦労様": "شُكْرًا, تِسْلَم",
 "ご褒美": "مُكَافَأَة, ثَوَاب / عَالَجَ",
 "ご覧": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ",
 "ご覧じる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "ご覧なさい": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "ご覧なさる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "ご覧になる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "ご覧に入れる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "ご親切に": "برفق, بلطف (بطريقة لطيفة أو نابعة من اللطف)\nمثال: تحدث بلطف مع الصبي",
 "ご託宣": "كَاهِن, عَرَّاف",
 "ご賞味あれ": "شَهْيَة طَيِّبَة, بِٱلصِّحَّةِ وَٱلْعَافِيَةِ",
 "ご贔屓に": "شُكْرًا, تِسْلَم",
 "ご近所さん": "جار, مجاور (جسم قريب من نفس النوع)\nمثال: فورت وورث جارة لدالاس",
 "ご迷惑": "مُشْكِلَة, مَتاعِب",
 "ご連絡": "مُلَامَسَة, لَمْسَة",
 "ご都合主義": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "ご都合主義者": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "ご降誕": "وِلَادَة, مَوْلِد / ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن…)",
 "ご難": "مُصِيبَة, شَقْوَة",
 "ご鞭撻": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "ご飯": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "ご飯屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "ご飯時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "ご飯蒸し": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "ご馳走": "عَالَجَ / وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "ご馳走さま": "شُكْرًا, تِسْلَم",
 "ご馳走さまでした": "شُكْرًا, تِسْلَم",
 "ご馳走さん": "شُكْرًا, تِسْلَم",
 "ご馳走様": "شُكْرًا, تِسْلَم",
 "ご馳走様でした": "شُكْرًا, تِسْلَم",
 "さ": "فَرْق, اِخْتِلَاف / سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة…) / ـِيَّة / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين…) / يَاه, اسمع / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة)\nمثال: ذهب سامي إلى اليسار. / ضَيِّق",
 "さぁ": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "さあ": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "さあさあ": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "さあて": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "さあらぬ": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "さい": "فَرْق, اِخْتِلَاف / دَيْن (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق. / مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / وَحِيد اَلْقَرْن, كَرْكَدَّن / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / فُرْصَة, مُنَاسَبَة\nمثال: أرى مرآة مناسبة / أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا! / مُمْتَاز, فَاخِر / طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له) / زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام…) / تَفْصِيل, تَفَاصِيل\nمثال: اقرأ هذا الفصل. / قُدْرَة, مَقْدِرَة / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / هِرَاوَة\nمثال: لا تمسك العصا من الوسط.",
 "さいあい": "مَحْبُوب",
 "さいあく": "الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً / رَهِيب, فَظِيع",
 "さいあくじ": "في أسوأ الأحوال (في ظل أسوأ الظروف)\nمثال: في أسوأ الأحوال سنذهب إلى السجن",
 "さいあくのじたい": "الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً",
 "さいい": "كارثة طبيعية",
 "さいいんざい": "مثير للشهوة, مقو للباه (محفز للرغبة الجنسية)",
 "さいう": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / أَقْصَى اليَمِين (الأبعد نحو اليمين)",
 "さいうよく": "أَقْصَى اَليَمْيِنِ, الْيَمِين الْمُتَطَرِّف",
 "さいえい": "إعادة عرض, حلقة مُعادة (برنامج يتم بثه مرة أخرى)\nمثال: تحب مشاهدة الإعادة لمسلسل 'أنا أحب لوسي'",
 "さいえん": "إعادة عرض, استعادة ((موسيقى) تكرار الموضوعات التي تم تقديمها سابقًا (خاصة عند تأليف الجزء الأخير من…) / حَديقة الخُضار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة. / الأبعد, الأقصى (إلى أقصى مسافة في المكان أو الزمان)\nمثال: انظر من يستطيع القفز لأبعد مسافة",
 "さいか": "إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى) / كَارِثَة, مُصِيبَة / عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر. / أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى / تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ)\nمثال: استغرق التحميل ساعتين / تفاضل (العملية الرياضية للحصول على مشتق دالة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "さいかい": "لَم شَمْل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد. / استئناف, عودة (البدء مرة أخرى) / تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "さいかいはつ": "إعادة تأهيل, تجديد (فعل التحسين عن طريق التجديد والاستعادة)\nمثال: إنهم يتابعون برنامجاً عاماً لتجديد العقار بأكمله",
 "さいかいもくよく": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "さいかきっすいせん": "خط التحميل, علامة بليمسول (خطوط مائية لإظهار المستوى الذي يجب أن يصل إليه الماء عندما تكون السفينة محملة…)",
 "さいかく": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة)\nمثال: رجل ذو دهاء عظيم / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر",
 "さいかくにん": "إعادة تأكيد (تأكيد متجدد)",
 "さいかくもの": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "さいかち": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في…)",
 "さいかふ": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "さいかん": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى) / قُدْرَة, مَقْدِرَة / ماصة (أداة قياس تتكون من أنبوب زجاجي مدرج يستخدم لقياس أو نقل كميات دقيقة من السائل…) / تحقق إضافي, فحص مزدوج (شيء يتحقق من صحة فحص سابق)",
 "さいが": "لَوْحَة, صُورَة",
 "さいがい": "بَلَاء, بُؤْس\nمثال: 嵐は、多くの災害を引き起こした。 — تسببت العاصفة بخسائر فادحة. / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / غشاء الخيشوم, غطاء الخيشوم (سديلة صلبة تعمل كغطاء (أ) لشقوق الخياشيم في الأسماك أو (ب) لفتحة الصدفة في بعض…)",
 "さいがいきゅう": "الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "さいがいげか": "جراحة الحوادث, طب الرضوح (فرع الطب الذي يتعامل مع الإصلاح الجراحي للإصابات والجروح الناجمة عن الحوادث)",
 "さいがいずじょうくんれん": "حَفَرَ, اِحْتَفَرَ ((حَفَرَ الشَّيْءَ يَحْفِرُه) ، من حَدِّ ضَرَبَ، حَفْراً، (واحْتَفَرَه: نَقَّاه…)\nمثال: هم يحفرون حفرة.",
 "さいがいそく": "أَبْعَد, أَقْصَى (يقع في أبعد نقطة ممكنة عن المركز)",
 "さいがいわりましとくやく": "حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "さいき": "أَسْمَر رَمَادِيّ (بلون بني رمادي باهت إلى رمادي مائل للبني)\nمثال: ارتدت لوناً أشهب / تكرار, عودة (الحدوث مرة أخرى (خاصة على فترات منتظمة))\nمثال: عودة الربيع / عَوْدِيَّة / انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / رِيمُونْتَادَا / مَوْهِبَة / حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت. / حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "さいきかんし": "قصيبة (أي من أصغر القنوات القصبية؛ تنتهي في الحويصلات الهوائية)",
 "さいきかんしえん": "اِلْتِهَاب قُصَيْبَات",
 "さいきかんぱつ": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "さいきけいぶっしつ": "مَاسِخ, مُشَوِّه للأجنة (أي عامل يتداخل مع التطور الجنيني الطبيعي؛ مثل الكحول أو الثاليدومايد أو الأشعة…)",
 "さいきだいめいし": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "さいきてき": "عَوْدِيّ / اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه)",
 "さいきてきていぎ": "تعريف تكراري ((رياضيات) تعريف لدالة يمكن من خلاله حساب قيم الدالة في عدد محدود من الخطوات)",
 "さいきどう": "إِعَادَة التَّشْغِيل\nمثال: أعاد توم كتابته.",
 "さいきどうし": "فعل مطاوع, فعل منعكس (فعل يقوم فيه الفاعل بعمل موجه نحو نفسه)\nمثال: جملة 'اغتسل' تحتوي على فعل منعكس",
 "さいきねつ": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز…)",
 "さいきゅう": "قَوْس خَيْشُومِيّ (أحد الأقواس العظمية أو الغضروفية على كل جانب من البلعوم والتي تدعم خياشيم…) / غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية…)",
 "さいきょ": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "さいきょう": "كِيُوتُو",
 "さいきょういく": "إعادة تأهيل, إعادة تدريب (التدريب لمهنة جديدة)",
 "さいきようほう": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه)",
 "さいきん": "مُؤَخَّرًا / الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت / جُرْثُومَة / منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "さいきんがく": "علم البكتيريا (فرع العلوم الطبية الذي يدرس البكتيريا وعلاقتها بالمرض)",
 "さいきんがくしゃ": "عالم بكتيريا (عالم أحياء يدرس البكتيريا)",
 "さいきんしゃ": "منقب عن الذهب (عامل منجم يحفر أو يغسل التربة بحثاً عن الذهب في حقل ذهب)",
 "さいきんしん": "أقرب الأقرباء (الشخص (أو الأشخاص) الأكثر قرابة لشخص معين)",
 "さいきんせい": "بكتيري, جرثومي (متعلق بالبكتيريا أو ناتج عنها)\nمثال: عدوى بكتيرية",
 "さいきんせいせきり": "داء الشيغيلات, زحار عصوي (عدوى حادة في الأمعاء ببكتيريا الشيغيلا؛ تتميز بالإسهال والحمى وآلام البطن)",
 "さいきんせん": "حرب بيولوجية, هجوم بيولوجي (استخدام البكتيريا أو الفيروسات أو السموم لتدمير البشر والحيوانات أو الغذاء)",
 "さいきんち": "حقل ذهب, منجم ذهب (منطقة يتم فيها تعدين الذهب)",
 "さいきんどくそ": "ذيفان بكتيري (أي ذيفان داخلي أو خارجي يتكون في الخلايا البكتيرية أو تفرزه)",
 "さいきんるい": "بكتيريا, جرثومة ((في علم الأحياء الدقيقة) كائنات وحيدة الخلية أو غير خلوية كروية أو حلزونية أو…)",
 "さいぎ": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته / اِتِّهَام, شَكّ / طَقْس دِينِيّ, شَعِيرَة",
 "さいぎしん": "اِتِّهَام, شَكّ",
 "さいぎんみ": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "さいく": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / خدعة, مكيدة (مناورة خادعة (خاصة لتجنب الأسر))",
 "さいくし": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "さいくじょ": "مَشْغَل, وَرْشَة",
 "さいくつ": "تعدين",
 "さいくつしゃ": "عامل منجم (عامل يعمل في منجم)",
 "さいくつじょう": "مَقْلَع",
 "さいくつば": "مَقْلَع",
 "さいくはりゅうりゅうしあげをごろうじろ": "النِهاية",
 "さいくみたて": "إعادة تجميع, إعادة تصنيع (التجميع مرة أخرى)",
 "さいくもの": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "さいくん": "زَوْجَة, اِمْرَأَة",
 "さいぐんび": "إعادة التسلح (فعل التسلح مرة أخرى)\nمثال: عارض إعادة تسليح اليابان بعد الحرب العالمية الثانية",
 "さいけい": "إعادة نشر (عملية النشر مرة أخرى)",
 "さいけいさん": "إعادة حساب (فعل الحساب مرة أخرى (عادة لإزالة الأخطاء أو لتضمين بيانات إضافية))\nمثال: أسفرت إعادة الحساب عن قيمة أكبر بكثير",
 "さいけっせい": "إِصْلَاح",
 "さいけつ": "تَصْوِيت, اِقْتِرَاع\nمثال: اقرأ بصوت عالي. / قَرَار, تَصْمِيم",
 "さいけん": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض)\nمثال: الالتصاق المتبادل للخلايا / اِئْتِمَان / إعادة بناء (البناء مرة أخرى) / تَدْقِيق / إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "さいけんかくづけ": "تصنيف السندات (تقييم من قبل شركة تصنيف لاحتمالية تخلف إصدار سندات معين عن السداد)",
 "さいけんかんじょう": "حِسَاب مَدِين (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن…)\nمثال: الحساب لو سمحت.",
 "さいけんげか": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "さいけんさ": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)",
 "さいけんしゃ": "دَائِن",
 "さいけんしゅじゅつ": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "さいけんしょゆうしゃ": "حامل سندات (حامل سندات تصدرها حكومة أو شركة)",
 "さいけんちく": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "さいけんとう": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "さいげき": "قَطَعَ, شَطَبَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "さいげつ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "さいげつながるるごとし": "الْوَقْتُ يَمْضِي",
 "さいげん": "عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة / تَكَاثُر / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "さいげんせい": "قابلية التكرار (جودة كون الشيء قابلاً لإعادة الإنتاج)",
 "さいげんなく": "إلى ما لا نهاية (إلى اللانهاية؛ دون حد ظاهر)\nمثال: تحدث وتحدث إلى ما لا نهاية",
 "さいげんりつ": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "さいこ": "أبكر وقت, في أقرب وقت (بأقل تأخير)\nمثال: أقرب وقت يمكنني الوصول فيه هو الساعة 3 مساءً",
 "さいこう": "إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى)\nمثال: انتعاش التجارة / إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته / أَفْضَل / أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى / مَسَمّ / إِضَاءَة / تعدين / شَقّ خَيْشُومِيّ (واحدة من سلسلة فتحات شقية في بلعوم الأسماك والبرمائيات المائية يمر الماء من…) / إعادة بناء (البناء مرة أخرى) / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية / عَجِيب",
 "さいこうい": "مكان الصدارة (المكان الأول أو الأعلى أو الأكثر أهمية أو الأكثر تفاخراً)",
 "さいこうかいぎ": "مَجْلِس السُّوفْيِت الْأَعْلَى",
 "さいこうき": "طاحونة تكسير, طاحونة ركاز (طاحونة يتم فيها سحق الخام بالمطارق)",
 "さいこうきおん": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "さいこうけいえいせきにんしゃ": "رَئِيس تَنْفِيذِيّ",
 "さいこうけっさく": "تُحْفَة, رَائِعَة",
 "さいこうげん": "قِمَّة",
 "さいこうげんど": "حد شمالي, حد علوي (الحد الموجود على الجانب العلوي (أو الشمالي) لشيء ما)",
 "さいこうさい": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうさいさいばんかん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうさいじむそうきょく": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうさいはんじ": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうさいばんしょ": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうさいばんしょとしょかん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうさく": "التحفة الكبرى, العمل العظيم (عمل فني أو أدبي عظيم)",
 "さいこうさつ": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "さいこうざいむせきにんしゃ": "مدير مالي (المسؤول التنفيذي للشركة الذي لديه سلطة مالية لتخصيص الاعتمادات والتفويض…)",
 "さいこうしきかん": "رَئِيس أَرْكَان",
 "さいこうしっこうせきにんしゃ": "رئيس تنفيذي (المسؤول التنفيذي للشركة المسؤول عن عمليات الشركة؛ يقدم تقاريره إلى مجلس الإدارة…)",
 "さいこうしどうしゃ": "المُرْشِد الأَعْلَى لِلْثَّوْرَة الإِسْلَامِيَّة, قَائِد الثَّوْرَة الْإِسْلَامِيَّة",
 "さいこうしゅくんせんしゅ": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "さいこうじ": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "さいこうじょうほうせきにんしゃ": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في…)",
 "さいこうすいじゅん": "علامة المد العالي (خط يحدد أعلى مستوى تم الوصول إليه)",
 "さいこうせい": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "さいこうせきにんしゃ": "الرئيس, رئيس الولايات المتحدة (منصب رئيس دولة الولايات المتحدة)\nمثال: يتم انتخاب الرئيس كل أربع سنوات",
 "さいこうちく": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "さいこうちょう": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "さいこうとうしせきにんしゃ": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في…)",
 "さいこうにゅう": "إعادة شراء, استرداد (فعل إعادة شراء شيء تم بيعه سابقاً)",
 "さいこうび": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "さいこうふ": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "さいこうべん": "مُرَافَعَة",
 "さいこうほう": "قِمَّة / الأَبْعَد خَلْفًا, الأَخِير (يقع في أبعد نقطة نحو الخلف)",
 "さいこうほういん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいこうまど": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "さいこうりゅう": "إعادة للحبس (فعل إعادة المتهم إلى الحجز لانتظار المحاكمة (أو استمرار المحاكمة))",
 "さいこうりょ": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "さいこく": "إِشْعَار, إِخْطَار / ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "さいこくさんじゅうさんしょ": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "さいこつ": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم) / قَوْس خَيْشُومِيّ (أحد الأقواس العظمية أو الغضروفية على كل جانب من البلعوم والتي تدعم خياشيم…)",
 "さいこつき": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "さいころ": "زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام…)",
 "さいこん": "إعادة بناء (البناء مرة أخرى) / إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى) / جذير (جذر صغير أو انقسام للجذر)",
 "さいご": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "さいごく": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "さいごくさんじゅうさんしょ": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "さいごっぺ": "قنبلة نتنة (قنبلة صغيرة مصممة لإطلاق رائحة كريهة عند انفجارها)",
 "さいごつうこく": "بِلَاغ نِهَائِيّ",
 "さいごつうちょう": "بِلَاغ نِهَائِيّ",
 "さいごのしゅだん": "الملاذ الأخير, حل يائس (وسيلة لا يتم اللجوء إليها إلا عند اليأس)",
 "さいごのしんぱん": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "さいごのばんさん": "الْعَشَاء الْأَخِير",
 "さいごのぶたい": "أغنية البجعة, العمل الأخير (أداء أو جهد أخير (خاصة قبل التقاعد))",
 "さいごべ": "قنبلة نتنة (قنبلة صغيرة مصممة لإطلاق رائحة كريهة عند انفجارها)",
 "さいごまで": "النِهاية",
 "さいさ": "مبادرة الاعتدالين (انزياح غربي بطيء للاعتدالين على طول مستوى مسار الشمس ناتج عن مبادرة محور دوران…)",
 "さいさい": "كَثِيرًا, غَالِبًا / سَنَوِيّ",
 "さいさいねんねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "さいさうんどう": "مبادرة الاعتدالين (انزياح غربي بطيء للاعتدالين على طول مستوى مسار الشمس ناتج عن مبادرة محور دوران…) / أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم))",
 "さいさき": "لافِتَة\nمثال: توم وقع و أصيب.",
 "さいさく": "جَاسُوس",
 "さいさん": "مِرَارًا وَتِكْرَارًا / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "さいさんかぶ": "عَالِي الإِنْتَاجِيَّة (يُنْتِجُ كَمِّيَّة كَبِيرَة مِنَ المُنْتَجَات الزِّرَاعِيَّة أَوِ الصِّنَاعِيَّة)",
 "さいさんがとれる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "さいさんさいし": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "さいさんせい": "مَرْدُودِيَّة",
 "さいし": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته / زَوْجَة, اِمْرَأَة / كَاهِن, قِسِّيس / شَعِيرَة, مَرَاسِم",
 "さいしあい": "إعادة اللعب, مباراة عودة (شيء (خاصة لعبة) يتم لعبه مرة أخرى)",
 "さいしき": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / طَقْس دِينِيّ, شَعِيرَة / طور قلادي, لبتوتين (المرحلة الأولى من الطور التمهيدي للانقسام المنصف)",
 "さいしく": "مُلَوَّن (لديه أو قادر على إنتاج الألوان)\nمثال: فيلم ملون",
 "さいしけん": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)",
 "さいしげんか": "إِعَادَةْ تَدْوِير",
 "さいしつ": "زَوْجَة, اِمْرَأَة",
 "さいして": "مَتَى",
 "さいしどう": "اِسْتَأْنَفَ",
 "さいしゅ": "دَائِن / جني, قطف (فعل قطف (المحاصيل أو الفاكهة أو القفزات، إلخ))\nمثال: أرسل أول قطاف من التوت إلى السوق / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع / كَاهِن, قِسِّيس",
 "さいしゅう": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / تجميع, جمع (فعل جمع شيء ما معاً)",
 "さいしゅうがくねん": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "さいしゅうけい": "إعادة العد, إعادة الفرز (عد إضافي (عادةً ثانٍ)؛ خاصة للأصوات في انتخابات متقاربة النتائج)",
 "さいしゅうけってい": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل…)",
 "さいしゅうけつろん": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "さいしゅうざい": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "さいしゅうしゅだん": "الملاذ الأخير, حل يائس (وسيلة لا يتم اللجوء إليها إلا عند اليأس)",
 "さいしゅうしゅりょうみん": "صياد وجامع ثمار (عضو في مجتمع يعتمد على الصيد وجمع الثمار)",
 "さいしゅうせいひん": "مخرجات, منتج نهائي (المنتج النهائي؛ الأشياء المنتجة)",
 "さいしゅうせんこう": "قائمة مختصرة (قائمة بالمتقدمين تم تصفيتهم من قائمة أطول واعتبروا مناسبين وسيتم اختيار الشخص…)",
 "さいしゅうつうこく": "بِلَاغ نِهَائِيّ",
 "さいしゅうてき": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه)",
 "さいしゅうてきに": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "さいしゅうび": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "さいしゅっぱつ": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "さいしゅつ": "عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة",
 "さいしょ": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "さいしょう": "أَقَلَّ / رَئِيس وُزَرَاء, رَئِيسَة وُزَرَاء / دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في…)\nمثال: استأذنت لدقيقة.",
 "さいしょうか": "تقليل للحد الأدنى (عملية تقليل شيء ما إلى أقل قدر أو درجة أو وضع ممكن)",
 "さいしょうかちさい": "فارق ملحوظ بالكاد ((في الفيزياء النفسية) الفرق بين محفزين الذي يتم اكتشافه بنفس قدر عدم اكتشافه…)",
 "さいしょうげん": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "さいしょうげんど": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "さいしょうこうばいすう": "المضاعف المشترك الأصغر (أصغر مضاعف يقبل القسمة تمامًا على كل عضو في مجموعة من الأرقام)\nمثال: المضاعف المشترك الأصغر للعددين 12 و 18 هو 36",
 "さいしょうこうぶんぼ": "إل سي دي, شاشة الكريستال السائل (شاشة رقمية تستخدم خلايا الكريستال السائل التي تغير الانعكاسية في مجال كهربائي…)",
 "さいしょうしんしゅうしゅじゅつ": "ذَات أَقَل تَدَخُّل جِرَاحِيّ, بِأَقَل تَدَخُّل جِرَاحِيّ",
 "さいしょうひんか": "إِعَادَةْ تَدْوِير",
 "さいしょうゆうこうすうじ": "إل إس دي, ثنائي إيثيل أميد حمض الليسرجيك (عقار مهلوس قوي مصنع من حمض الليسرجيك)",
 "さいしょからさいごまで": "من البداية إلى النهاية (بشكل كامل وشامل)",
 "さいしょく": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء / إِضَاءَة / بحث عن الطعام (فعل البحث عن الطعام والمؤن) / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو)\nمثال: زراعة الذرة عمل شاق",
 "さいしょくしゅぎ": "نَباتِيَّة",
 "さいしょくしゅぎしゃ": "نَبَاتِيّ",
 "さいしょでさいご": "أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: كانت عالمة أولاً وأخيراً",
 "さいしようがた": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "さいしん": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي…) / فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش / آخِرُ مَا صَدَرَ, أَحْدَث (مواكب للحاضر المباشر؛ الأكثر حداثة)\nمثال: هل سمعت آخر الأخبار؟ / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "さいしんえい": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "さいしんさいばん": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي…)",
 "さいしんじょうほう": "تحديث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره…)\nمثال: تم تحديث القاموس.",
 "さいしんせい": "حالية, رواج (خاصية الانتماء إلى الوقت الحاضر)\nمثال: رواج مصطلح عامي",
 "さいしんぶ": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "さいじ": "تفاهة, شيء تافه (شيء قليل الأهمية) / عِيد, مَهْرَجَان / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / إِطْعَام",
 "さいじつ": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية) / يوم صيام (يوم مخصص للصيام)",
 "さいじゅうけいてい": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "さいじゅうど": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "さいじゅんかん": "إِعَادَةْ تَدْوِير",
 "さいじょう": "قِمَّة\nمثال: 最後に笑う者の笑いが最上。 — من يضحك أخيرًا يضحك كثيرًا. / أَفْضَل",
 "さいじょういビット": "بنك ادخار متبادل (بنك ادخار مرخص من الدولة ومملوك للمودعين فيه ويديره مجلس أمناء)",
 "さいじょうえい": "إعادة عرض, حلقة مُعادة (برنامج يتم بثه مرة أخرى)\nمثال: تحب مشاهدة الإعادة لمسلسل 'أنا أحب لوسي'",
 "さいじょうきゅう": "دَرَجَة فَائِقَة",
 "さいじょうきゅうせい": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير",
 "さいじょうきゅうひん": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "さいする": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "さいせい": "اِنْعَاش / إِصْلَاح / إِعَادَةْ تَدْوِير / تَشْغِيل / اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها)\nمثال: كوكب المشتري متكون من الغاز. / أَقْصَى الغَرْب (الأبعد باتّجاه الغرب) / أَوْجٌ, ذُرْوَةٌ",
 "さいせいいっち": "ثِيُقْرَاطِيَّة",
 "さいせいかのう": "قَابِل لِلتَّجْدِيد, مُتَجَدِّد (يمكن تجديده أو استبداله)\nمثال: عقد إيجار قابل للتجديد",
 "さいせいかのうしげん": "مورد متجدد (أي مورد طبيعي (مثل الخشب أو الطاقة الشمسية) يمكن تجديده طبيعياً بمرور الوقت)",
 "さいせいき": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / مَوْسِم",
 "さいせいさん": "تَكَاثُر",
 "さいせいふりょうせいひんけつ": "فقر الدم اللاتنسجي (فقر دم يتميز بقلة الكريات الشاملة الناتجة عن فشل نخاع العظم؛ يمكن أن يكون سببه…)",
 "さいせいほう": "شِفَاء, تَعَافِي",
 "さいせいり": "إعادة ترتيب (تغيير ترتيب شيء ما)",
 "さいせいりよう": "إِعَادَةْ تَدْوِير",
 "さいせいリスト": "قَائِمَةُ التَّشْغِيلِ",
 "さいせき": "رصف (رصف بطبقة من حجر المكدام)\nمثال: رصف الطريق / سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / تحجير (استخراج حجر البناء أو الأردواز من مقلع سطحي مفتوح)",
 "さいせきじょう": "مَقْلَع",
 "さいせってい": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "さいせつ": "إعادة تأسيس, استعادة (الاستعادة إلى حالة سابقة)\nمثال: أدت التمارين المنتظمة إلى استعادة قدرته على التحمل / قَابِل لِلتَّفْكِيك (يمكن تفكيكه إلى أجزاء منفصلة)",
 "さいせつがん": "صَخْر فُتَاتِيّ ((جيولوجيا) صخر يتكون من قطع مكسورة من صخور أقدم)",
 "さいせつぶつ": "فتات الصخور (مادة مفككة (شظايا حجرية وطمي وما إلى ذلك) ناتجة عن تآكل الصخور)",
 "さいせん": "إعادة اللعب, مباراة عودة (شيء (خاصة لعبة) يتم لعبه مرة أخرى) / إِعَادَة اِنْتِخَاب (الانتخاب مرة أخرى)\nمثال: لم يترشح لإعادة الانتخاب / طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله)",
 "さいせんたん": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة…)\nمثال: لن نصل إلى أي مكان. / طَرَف",
 "さいせんれい": "أنابابتيست, تجديد العماد (حركة بروتستانتية في القرن السادس عشر آمنت بأولوية الكتاب المقدس، وعمدت المؤمنين…)",
 "さいせんれいは": "أنابابتيست, تجديدي العماد (أحد أتباع مذهب تجديدية العماد)",
 "さいぜん": "الأَمَامِيّ, الأَوَّل (يسبق جميع الآخرين في الموقع المكاني) / قَلِيلًا\nمثال: そのかわりに最前定義した二つの経済学的変数に関する議論を行うことにしよう。 — بدلًا من ذلك، سأنتقل إلى نقاش المتغيريَّن الاقتصادييَّن اللذين عرفتهما قبل قليل. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / شَفَّاف",
 "さいぜんせん": "جَبْهَة / خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "さいそう": "غلاف لوني, كروموسفير (طبقة غازية من الغلاف الجوي للشمس (تمتد من الفوتوسفير إلى الإكليل) تكون مرئية…) / جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء)",
 "さいそうぞう": "اِسْتِجْمَام",
 "さいそく": "ضغط, كبس (فعل الضغط؛ بذل الضغط)\nمثال: ضغط على الزر / قَانُون دَاخِلِيّ, لَائِحَة دَاخِلِيَّة (قاعدة تعتمدها منظمة لتنظيم شؤونها الخاصة وسلوك أعضائها) / الأسرع (بأقصى سرعة)",
 "さいそくか": "اِسْتِمْثَال, مُلَاءَمَة",
 "さいそくじょう": "أَسْمَر رَمَادِيّ (بلون بني رمادي باهت إلى رمادي مائل للبني)\nمثال: ارتدت لوناً أشهب",
 "さいそくりょう": "إعادة المسح (مسح أو دراسة جديدة)",
 "さいそしき": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "さいた": "أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "さいたい": "تَزَوَّجَ\nمثال: زوجة ماري طبيبة. / حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さいたいかすい": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さいたいけつ": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さいたいけついしょく": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さいたいけん": "استعادة التجربة, معايشة مجددة (تكرار لتجربة سابقة (شعورياً))\nمثال: استعادة العاطفة القوية يمكن أن يكون علاجياً",
 "さいたいけんらく": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さいたいしゃ": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "さいたいじょうみゃく": "وريد سري (وريد في الحبل السري؛ يعيد الدم المغذي من المشيمة إلى الجنين)",
 "さいたいだっしゅつ": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さいたいほ": "استرداد, استعادة (فعل استعادة شيء ما)",
 "さいたかね": "تَارِيخِيّ, غَيْرُ مَسْبُوق (لم يُتجاوَز في جانب ما حتى الآن)",
 "さいたく": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "さいたすう": "أكثرية نسبية, تعددية ((في انتخابات بها أكثر من خيارين) عدد الأصوات للمرشح أو الحزب الذي يحصل على أكبر…)\nمثال: حشد من النمل",
 "さいたま": "سَايْتَامَا",
 "さいたる": "مُمْتَاز, فَاخِر",
 "さいたん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / منجم فحم (منجم يُستخرج منه الفحم من الأرض) / فَحْم حَجَرِيّ / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / قَائِمَة, قَائِمَةُ الطَّعَام",
 "さいたんじょ": "منجم فحم (منجم يُستخرج منه الفحم من الأرض)",
 "さいだい": "أَرْقَى, فَائِق الجَوْدَة (الأعلى في مستوى الجودة) / بِالتَّفْصِيل, تَفْصِيلًا / عَقْد (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "さいだいか": "إيصال للحد الأقصى, تعظيم (عملية الرفع إلى أعلى نقطة أو حالة أو موضع ممكن)",
 "さいだいげん": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل",
 "さいだいげんど": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى",
 "さいだいこうやくすう": "العَامِل المُشْتَرَك الأَكْبَر, القَاسِم المُشْتَرَك الأَكْبَر (أكبر عدد صحيح يقسم مجموعة من الأعداد الصحيحة بدون باقي)",
 "さいだいすう": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى",
 "さいだいゆうこうビット": "بنك ادخار متبادل (بنك ادخار مرخص من الدولة ومملوك للمودعين فيه ويديره مجلس أمناء)",
 "さいだいりょう": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى",
 "さいだん": "مَذْبَح, هَيْكَل / قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / لب (الجزء الداخلي الرخو للسن)\nمثال: سحقه حتى أصبح لباً",
 "さいだんが": "ستار المذبح, لوحة المذبح الخلفية (ساتر مطلي أو منحوت يوضع فوق وخلف المذبح أو مائدة العشاء الرباني)",
 "さいだんき": "أداة قطع, قاطعة (أداة للقطع) / آلة تمزيق, فرامة ورق (جهاز يمزق المستندات (عادة لمنع الأشخاص الخطأ من قراءتها))",
 "さいだんざ": "مَذْبَح, هَيْكَل",
 "さいだんし": "أداة قطع, قاطعة (أداة للقطع)",
 "さいち": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في…)\nمثال: استأذنت لدقيقة. / الأبطأ (بأقصى بطء)",
 "さいちく": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "さいちゅう": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "さいちゅうもく": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "さいちゅうもん": "إعادة طلب, طلب متكرر (طلب متكرر لنفس البضائع)\nمثال: هو الشخص الذي يرسل جميع الطلبات الجديدة وإعادة الطلب",
 "さいちょう": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / لأطول فترة (لأكثر وقت)\nمثال: بقيت لأطول فترة / أبو قرن (طائر من أفريقيا الاستوائية وآسيا له منقار كبير جداً يعلوه نتوء عظمي؛ مرتبط…)",
 "さいちょうさ": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)",
 "さいちょうせい": "إعادة تكييف, إعادة ضبط (فعل التعديل مرة أخرى (لظروف متغيرة))",
 "さいちょくせつじんもん": "إعادة استجواب ((قانون) استجواب الشاهد من قبل الطرف الذي استدعاه بعد خضوع هذا الشاهد للاستجواب…)",
 "さいちん": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "さいちんほう": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "さいつぶ": "زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام…)",
 "さいてい": "أَقَلَّ / الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً / فَظِيع, أَرْبَد / قَرَار, تَصْمِيم",
 "さいていおんぶ": "غيتار البيس",
 "さいていきおん": "حَزين",
 "さいていぎ": "إعادة تعريف (فعل إعطاء تعريف جديد)\nمثال: الكلمات مثل 'محافظ' تتطلب إعادة تعريف دورية",
 "さいていげん": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "さいていさいあく": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)",
 "さいていすいじゅん": "طَابِق أَرْضِيّ, دَوْر أَرْضِيّ",
 "さいていちんぎん": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "さいていちんぎんせい": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "さいていちんぎんほう": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "さいていとりひき": "مراجحة (نوع من الاستثمار المحوط يهدف إلى الاستفادة من الفروق الطفيفة في السعر؛ عندما…)",
 "さいてき": "أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني)",
 "さいてきか": "اِسْتِمْثَال, مُلَاءَمَة",
 "さいてん": "تعليم, وضع علامات (فعل عمل علامة مرئية على سطح)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به / عِيد, مَهْرَجَان",
 "さいてんかん": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما)\nمثال: كانت العوامات علامات للقناة المائية",
 "さいてんしゃ": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما)\nمثال: كانت العوامات علامات للقناة المائية",
 "さいてー": "أَقَلَّ / الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً / فَظِيع, أَرْبَد",
 "さいでん": "ضَرِيح",
 "さいとう": "فاصولياء فلاجوليه (نوع من الفاصولياء الفرنسية ذات بذور فاتحة اللون؛ عادة ما تكون مجففة) / أَقْصَى الشَّرْق (الأبعد باتّجاه الشرق)",
 "さいとういつ": "إِعَادَةْ تَوْحِيد",
 "さいとうこう": "إعادة نشر (منشور على وسائل التواصل الاجتماعي تم نشره سابقاً)",
 "さいとうし": "إعادة استثمار (استثمار ثانٍ أو لاحق في نفس الشيء)",
 "さいとつにゅう": "دخول مجدد (فعل الدخول مرة أخرى)",
 "さいとやく": "دواء مقيئ, مقيئ (دواء يحفز الغثيان والقيء)",
 "さいとり": "سِمْسَار, وَسِيط",
 "さいとりかいいん": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "さいど": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / فِدَاء",
 "さいどう": "تليف (عملية أو إجراء تشكيل ليفيات) / قاعة طعام مشتركة, مائدة الدير (قاعة طعام جماعية (عادة في دير))",
 "さいどうにゅう": "إعادة تقديم (فعل تجديد التقديم)",
 "さいどうみゃく": "شريان شعري, شُرَيْن (أحد الشرايين الصغيرة رقيقة الجدران التي تنتهي في الشعيرات الدموية) / شريان معدي أيسر (فرع من الشريان الزلاقي يغذي الانحناء الصغير للمعدة والجزء البطني من المريء)",
 "さいどかくにん": "تحقق إضافي, فحص مزدوج (شيء يتحقق من صحة فحص سابق)",
 "さいなむ": "عَذَاب",
 "さいなら": "مَعَ السَّلَامَة, إِلَى اللِّقَاء (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "さいなん": "بَلَاء, بُؤْس / أَقْصَى الجَنُوب (يقع في أبعد نقطة جنوبًا) / جِينَان",
 "さいに": "فِي حَال, إِذ مَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "さいにち": "يوم صيام (يوم مخصص للصيام)",
 "さいにゅう": "دخول مجدد (فعل الدخول مرة أخرى)",
 "さいにゅうかのう": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "さいにゅうやく": "مدر للحليب, مدر لللبن (عامل يحفز إفراز الحليب)",
 "さいにん": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس",
 "さいねん": "تكرار, عودة (الحدوث مرة أخرى (خاصة على فترات منتظمة))\nمثال: عودة الربيع",
 "さいねんちょう": "أَكْبَر, بِكْر (الأَوَّلُ فِي تَرْتِيبِ الوِلَادَةِ)",
 "さいのう": "مَوْهِبَة / تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "さいのかわら": "عَقِيم",
 "さいのこう": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة)",
 "さいのめ": "عَجَمَة / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "さいのろジー": "افتتان بالزوجة, تتيم بالزوجة (ولع أحمق أو خضوع مفرط للزوجة)",
 "さいの目": "عَجَمَة / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "さいは": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "さいはい": "اَلْمُخْلِص / هِرَاوَة\nمثال: لا تمسك العصا من الوسط. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / شَرِيك, شَرِيكَة",
 "さいはいち": "إعادة ترتيب (تغيير ترتيب شيء ما)",
 "さいはいちかのうプログラム": "برنامج قابل للنقل (برنامج يمكن وضعه في أجزاء مختلفة من الذاكرة في أوقات مختلفة)",
 "さいはいふ": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "さいはいぶん": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "さいはいをふる": "رَصَاص",
 "さいはいをふるう": "رَصَاص",
 "さいはっけん": "إعادة اكتشاف (فعل الاكتشاف مرة أخرى)",
 "さいはっこう": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "さいはっぴょう": "إعادة نشر (عملية النشر مرة أخرى)",
 "さいはつ": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "さいはつせい": "دَائِمُ التَّكْرَار, مُعَاوِد (يَتَكَرَّرُ مَرَّةً بَعْدَ أُخْرَى)",
 "さいはなげられた": "سبق السيف العذل, حُصِّلَ مَا فِي الصُدُورِ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "さいはん": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب. / إِعَادَةُ بَيْع",
 "さいはんぎょうしゃ": "مُوَزِّع",
 "さいはんばい": "إِعَادَةُ بَيْع",
 "さいばい": "تَهْذِيب",
 "さいばいか": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "さいばいしゃ": "خبير زراعي, مزارع (شخص يعنى بعلم أو فن أو تجارة زراعة الأرض)",
 "さいばいじょ": "مَزْرَعَة",
 "さいばいひんしゅ": "مُسْتَنْبَت",
 "さいばん": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / تَرْقِيم",
 "さいばんいん": "مُحَلَّف",
 "さいばんかん": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "さいばんけん": "قَضَاء",
 "さいばんざた": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "さいばんしょ": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さいばんしょちょうしゃ": "مبنى المحكمة (مبنى يضم المحاكم القضائية)",
 "さいばんしょめいれい": "أمر محكمة (أمر صادر عن محكمة قانونية يطالب شخصاً بفعل شيء ما أو الامتناع عن فعله)",
 "さいばんじょう": "قَضَائِي",
 "さいばんにん": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "さいひょう": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "さいひょうか": "إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "さいひょうかん": "كَسَّارَةْ جَلِيد",
 "さいひょうせん": "كَسَّارَةْ جَلِيد",
 "さいひんち": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "さいび": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في…)\nمثال: استأذنت لدقيقة.",
 "さいふ": "مِحْفَظَة, حَافِظَة",
 "さいふのひも": "خزينة, سلطة الإنفاق (الموارد المالية أو الدعم المالي)\nمثال: من يسيطر على الخزينة (الإنفاق) في هذه العائلة؟",
 "さいぶ": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "さいぶそう": "إعادة التسلح (فعل التسلح مرة أخرى)\nمثال: عارض إعادة تسليح اليابان بعد الحرب العالمية الثانية",
 "さいぶん": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "さいぶんか": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "さいぶんぱい": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "さいへん": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة / رُكام (الشيء المُتَرَاكِم بعضه فوق بعضٍ مثل السحاب والرمل والحجر وما أشبههُ؛ وقطيعٌ…) / قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "さいへんせい": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "さいべつ": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "さいほ": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "さいほう": "صَوْمَعَة, كِرْح / خِيَاطَة, حِيَاكَة",
 "さいほうし": "خَيَّاط, خَيَّاطَة",
 "さいほうそう": "إعادة بث (بث يتكرر في وقت لاحق)",
 "さいほうちょう": "طائر خياط (هازجة آسيوية استوائية تخيط الأوراق معاً لتشكيل عشها وإخفائه)",
 "さいほうばり": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة…)",
 "さいほく": "أَقْصَى الشَّمَال (يقع في أبعد نقطة شمالًا)",
 "さいほけん": "إِعَادَةُ تَأْمِين",
 "さいほっそく": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "さいぼう": "صَوْمَعَة, كِرْح",
 "さいぼういでんがく": "وراثة خلوية (فرع علم الأحياء الذي يدرس الجوانب الخلوية للوراثة (خاصة الكروموسومات))",
 "さいぼうかく": "نَوَاة",
 "さいぼうかん": "بين خلوي (يقع بين الخلايا)",
 "さいぼうかんぶっしつ": "مادة خلالية, مصفوفة (مادة الجسم التي تنغمس فيها خلايا الأنسجة)",
 "さいぼうがい": "خارج الخلية (يقع أو يحدث خارج الخلية أو الخلايا)\nمثال: سائل خارج الخلية",
 "さいぼうがいえき": "سائل خارج خلوي (سائل يحتوي على بروتينات وإلكتروليتات بما في ذلك السائل في بلازما الدم والسائل…)\nمثال: يحتوي الجسم عادة على حوالي 15 لتراً من السائل خارج الخلوي",
 "さいぼうがいマトリックス": "إجراءات إلكترونية مضادة (حرب إلكترونية يتم القيام بها لمنع أو تقليل الاستخدام الفعال للعدو للطيف…)",
 "さいぼうがく": "علم الخلية (فرع علم الأحياء الذي يدرس بنية ووظيفة الخلايا)",
 "さいぼうきかん": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "さいぼうこう": "فم خلوي (فم الحيوان الأولي)",
 "さいぼうこっかく": "هَيْكَل خَلَوِيّ",
 "さいぼうし": "تنكس حيوي, موت الخلية ((في علم وظائف الأعضاء) الانحلال الطبيعي وموت الخلايا الحية (كما في الخلايا…)",
 "さいぼうしつ": "سيتوبلازم, هيولى (بروتوبلازم الخلية باستثناء النواة؛ مليء بالبروتينات التي تتحكم في استقلاب الخلية)",
 "さいぼうしつぶんれつ": "انقسام السيتوبلازم, حركية خلوية (عملية عضوية تتكون من انقسام سيتوبلازم الخلية بعد انقسام النواة مما يؤدي إلى…)",
 "さいぼうしょうきかん": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "さいぼうじょう": "خَلَوِيّ",
 "さいぼうせいねんきん": "عفن غروي خلوي (يختلف عن العفن الغروي الحقيقي في كونه خلوياً وذو نواة طوال دورة حياته)",
 "さいぼうせつ": "نظرية الخلية ((أحياء) النظرية القائلة بأن الخلايا تشكل الوحدات الهيكلية والوظيفية الأساسية…)",
 "さいぼうどく": "ذيفان خلوي, سم خلوي (أي مادة لها تأثير سام على الخلايا)",
 "さいぼうない": "داخل الخلية (يقع أو يحدث داخل الخلية أو الخلايا)\nمثال: سائل داخل الخلية",
 "さいぼうないえき": "سائل داخل خلوي (سائل موجود داخل أغشية الخلايا (يحتوي عادة على مواد مذابة))",
 "さいぼうないきかん": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "さいぼうないしょうきかん": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "さいぼうはっせい": "تكون الخلايا, نشوء الخلية (أصل وتطور واختلاف الخلايا)",
 "さいぼうぶんれつ": "انقسام الخلية, انقسام خلوي (العملية في التكاثر والنمو التي تنقسم بها الخلية لتكوين خلايا وليدة)",
 "さいぼうへき": "جدار الخلية (طبقة صلبة من السكريات المتعددة تحيط بغشاء الخلايا النباتية وبدائية النواة…)",
 "さいぼうほうかい": "اِنْحِلَال خَلَوِيّ",
 "さいぼうまく": "الغشاء البلازمي",
 "さいまつしょうせん": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "さいみつが": "مُنَمْنَمَة",
 "さいみつじゅうてんこうぞう": "مُتَكَدِّس, مُتَلَاصِق (مرصوص بإحكام شديد)",
 "さいみまん": "أَصْغَر مِن, صُغْرَى مِن",
 "さいみん": "تَنْوِيم مَغْنَاطِيسِيّ / فَقِير",
 "さいみんざい": "مُنَوِّم",
 "さいみんじゅつ": "تنويم إيحائي, تنويم مغناطيسي (فعل إحداث التنويم المغناطيسي)",
 "さいみんじゅつし": "منوم إيحائي, منوم مغناطيسي (شخص يحفز التنويم المغناطيسي)",
 "さいみんほう": "تَنْوِيم مَغْنَاطِيسِيّ",
 "さいみんりょうほう": "علاج بالتنويم المغناطيسي (استخدام التنويم المغناطيسي في العلاج النفسي)",
 "さいむ": "دَيْن (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "さいむしゃ": "مَدِين",
 "さいむちょうか": "إِعْسَار, إِعْسَار مَالِيّ",
 "さいめい": "شُهْرَة",
 "さいめいめい": "تسمية استدراكية, مصطلح رجعي (كلمة تم تقديمها لأن المصطلح الحالي أصبح غير كافٍ)\nمثال: لم يسمع أحد عن 'الساعات التناظرية' حتى أصبحت الساعات الرقمية شائعة، لذا فإن 'ساعة تناظرية' هي مصطلح رجعي / أنابابتيست, تجديد العماد (حركة بروتستانتية في القرن السادس عشر آمنت بأولوية الكتاب المقدس، وعمدت المؤمنين…)",
 "さいもく": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "さいやく": "بَلَاء, بُؤْس",
 "さいやすね": "تَارِيخِيّ, غَيْرُ مَسْبُوق (لم يُتجاوَز في جانب ما حتى الآن)",
 "さいゆうき": "سَعْدَان, قِرْد",
 "さいゆうしゅう": "أَفْضَل",
 "さいゆうしゅうせいせき": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "さいゆうしゅうせんしゅ": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "さいゆうとう": "بِأَعْلَى مَرَاتِب الشَّرَف, بِمَرْتَبَة الشَّرَف الأُولَى (بأعلى مراتب الشرف)\nمثال: تخرج بأعلى مراتب الشرف",
 "さいゆうりょく": "قِمَّة",
 "さいよう": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "さいらい": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / تَنَاسُخُ الأَرْوَاحِ",
 "さいらんけい": "طَبَقَة",
 "さいり": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "さいりゅう": "جدول صغير, ساقية (مجرى مائي صغير)",
 "さいりょう": "أَفْضَل / قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "さいりょうけん": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة",
 "さいりょく": "قُدْرَة, مَقْدِرَة",
 "さいりよう": "إِعَادَةْ تَدْوِير",
 "さいりようかのう": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "さいりんは": "أدفنتي, مجيئي (عضو في طائفة مسيحية تتوقع المجيء الوشيك للمسيح)",
 "さいるい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "さいるいガス": "الْغَاز الْمَسِيل لِلْدَمُوع",
 "さいるいスプレー": "الْغَاز الْمَسِيل لِلْدَمُوع",
 "さいれい": "عِيد, مَهْرَجَان",
 "さいれつ": "شَقّ خَيْشُومِيّ (واحدة من سلسلة فتحات شقية في بلعوم الأسماك والبرمائيات المائية يمر الماء من…)",
 "さいろう": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة.",
 "さいろく": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى) / تَسْجِيل / طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "さいわ": "سَرَدَ, نَقَلَ (الشيء: نَسَجَهُ ليصبح مفهوما؛ الأمر:الحديث يتلوه بإستمرار)\nمثال: يحاول الانفصاليون تطوير سرد زائف من أجل تبرير مشروعهم السياسي.",
 "さいわい": "سَعَادَة, فَرَح / لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "さいわいたけ": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "さいわいなことに": "لِحُسْن اَلْحَظّ",
 "さいわいにして": "لِحُسْن اَلْحَظّ",
 "さいわいにも": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "さいわりあて": "إعادة تعيين, إعادة تكليف (التعيين في واجب مختلف)",
 "さいわん": "مَهَارَة",
 "さいアンドこう": "أَفْضَل",
 "さいエネ": "الطاقة الخضراء",
 "さいブレイク": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "さいヘルニア": "فتق سري (بروز الأمعاء والثروب عبر فتق في جدار البطن بالقرب من السرة)",
 "さい先": "لافِتَة\nمثال: توم وقع و أصيب.",
 "さい帯": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さい帯血": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "さい銭": "طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله)",
 "さう": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "さえ": "مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس. / وَحِيد / إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا. / صَفَاء, نَقَاء (صفة الماء الصافي)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها / براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "さえあれば": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "さえぎる": "قَاطَعَ",
 "さえざえ": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "さえざえした": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "さえざえとした": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "さえずり": "تَغْرِيدَة, تَغْرِيد",
 "さえずる": "غَنَّى",
 "さえつ": "تَفَقُّد",
 "さえない": "كَلِيل / غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات) / غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر)\nمثال: غير جذاب مثل معظم مناطق التعدين / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "さえに": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "さえも": "مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس.",
 "さえる": "سَيِّد\nمثال: يبدو زيري أحسن.",
 "さえわたる": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "さお": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط. / رَقَبَة, عُنُق / خَشَبَة / قَضِيب, ذَكَر",
 "さおさす": "عَمُود, قُطْب",
 "さおとめ": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "さおばかり": "ميزان العارضة, ميزان ذو كفتين (ميزان يتكون من رافعة ذات ذراعين متساويين وكفة معلقة من كل ذراع)",
 "さか": "مُنْحَدَر / حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات) / استجمام, ترويح عن النفس (نشاط يجدد النشاط ويرفه؛ نشاط يجدد صحتك وروحك بالمتعة والاسترخاء)\nمثال: وقت للراحة والاستجمام بجانب المسبح / عَكْسِيّ, مُعَاكِس (معكوس في الترتيب أو الطبيعة أو الأثر)\nمثال: يكون الحد في تناسب عكسي مع حد آخر إذا زاد (أو نقص) بنقصان (أو زيادة) الآخر / كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "さかい": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / مِسَاحَة\nمثال: غزة منطقة مكشوفة. / حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن…)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم / حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي) / سَادُو, طُقُوس اَلشَّاي / لِأَنَّ",
 "さかいする": "مُتَّجِه",
 "さかいに": "لِأَنَّ",
 "さかいめ": "حَدِّيّ, هَامِشِيّ (ذو جودة مشكوك فيها أو ضئيلة)",
 "さかえ": "اِزْدِهَار, رَخَاء",
 "さかえる": "ازدهر",
 "さかき": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام)",
 "さかぐら": "سرداب, قبو نبيذ (مساحة تخزين حيث يُخزن النبيذ) / حَانَة, بَار",
 "さかけ": "تسمم كحولي, ثمالة (حالة مؤقتة ناتجة عن الاستهلاك المفرط للكحول)",
 "さかご": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "さかさ": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها)",
 "さかさくらげ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "さかさなまず": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "さかさはりつけ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "さかさばっつけ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "さかさま": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها)",
 "さかさクラゲ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "さかしい": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "さかしま": "عَكَسَ / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "さかしら": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "さかしろ": "طَرَف",
 "さかだい": "طَرَف",
 "さかだち": "وقوف على اليدين (فعل دعم النفس باليدين فقط في وضع مقلوب)",
 "さかだちしても": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "さかだてる": "شعرة خشنة, هلبه (شعرة صلبة)",
 "さかだな": "مُتَّجِر كُحُول",
 "さかつ": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون…)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك. / حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "さかつらがん": "إوز صيني (إوز بري كبير جداً من شمال شرق آسيا؛ يتزاوج بحرية مع الإوز الرمادي)",
 "さかて": "طَرَف",
 "さかてにとる": "اِسْتَغَلَّ",
 "さかとびこみ": "رَأْسِيَّة",
 "さかどいや": "مُتَّجِر كُحُول",
 "さかどう": "سَادُو, طُقُوس اَلشَّاي",
 "さかどんや": "مُتَّجِر كُحُول",
 "さかな": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "さかなぎ": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "さかなつり": "صَيْد سَمَك, صَيْد",
 "さかなで": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "さかなみ": "بحر معاكس (بحر تجري فيه الأمواج مباشرة عكس مسار السفينة)",
 "さかなや": "سَمَّاك, بَائِع سَمَك",
 "さかなをつる": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "さかねじ": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "さかねじをくわせる": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "さかのぼる": "صَعِدَ, يَصْعَدُ / حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "さかば": "حَانَة, بَار",
 "さかばりつけ": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "さかまく": "طفرة, فورة (زيادة قوية مفاجئة)\nمثال: حفزت طفرة من المضاربة",
 "さかまた": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "さかみせ": "مُتَّجِر كُحُول",
 "さかむけ": "سَأْفَة",
 "さかもぎ": "حِظَار",
 "さかもり": "جلسة شرب (فترة طويلة من الشرب)",
 "さかや": "مُتَّجِر كُحُول / صاحب مصنع بيرة (المالك أو المدير لمصنع بيرة)",
 "さからう": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به)\nمثال: جميع من حضر عارض تلك الخطة.",
 "さかり": "اِرْتِفَاع / مُمْتَاز, فَاخِر / حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد.",
 "さかりがつく": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه)\nمثال: وقعوا في روتين محادثة ممل",
 "さかりのついた": "شبِق, في فترة الشبق ((للثدييات الدنيا) تُظهر أو تكون في حالة شبق)\nمثال: حالة الشبق",
 "さかる": "ازدهر / جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟ / اِبْتَعَدَ",
 "さかん": "ضابط ميداني (ضابط يحمل رتبة رائد أو مقدم أو عقيد) / جَصّاص, عامل جص (عامل ماهر في وضع الجص (الجبس) على الجدران) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / مَحْبُوب\nمثال: 我々の国ではウインタースポーツが盛んだ。 — الرياضات الشتوية محبوبة جداً في بلدنا. / نَشِيط, عَامِل\nمثال: لقد أوقفنا حركة المرور. / مُتَحَمِّس / سِكْرِتِير, سِكْرِتِيرَة",
 "さかんなかんげい": "حَفَاوَة, حُسْن الِاسْتِقْبَال (اللطف في استقبال الضيوف أو الغرباء)",
 "さかんに": "بِنَشَاطٍ",
 "さかんになる": "ازدهر",
 "さかんや": "جَصّاص, عامل جص (عامل ماهر في وضع الجص (الجبس) على الجدران)",
 "さが": "عَادَة, عُرْف / سَحِيق, شَدِيد الانْحِدَار (حاد الانحدار بشكل خطير) / مَلحَمَة",
 "さがい": "غِشّ, اِحْتِيال",
 "さがく": "رَصِيد",
 "さがくベッド": "سرير طبي, سرير مستشفى (سرير مفرد بإطار مقسم لثلاثة أقسام بحيث يمكن رفع الرأس أو الوسط أو القدمين حسب…)",
 "さがしあてる": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "さがしに": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "さがしもとめる": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "さがす": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "さがり": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / الْبَقَايَا / ذهاب, رحيل (فعل المغادرة) / قَلِيلًا",
 "さがりばな": "نِسَائِيّ حَصْرِيّ (يُستخدم للأنشطة التنافسية التي تشارك فيها النساء فقط)",
 "さがる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "さがん": "حَجَر رَمْلِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "さき": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا! / التَّالِي ذِكْرُهُ, المَذْكُور أَدْنَاه (على وشك أن يُذكَر أو يُحدَّد فيما يلي) / رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / رَئِيس, رَئِيسَة / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "さきいき": "مُسْتَقْبَل",
 "さきいれさきだし": "ما يرد أولاً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأقدم (التي تم شراؤها أولاً) هي…)",
 "さきいれさきだしリスト": "طابُور, صَفّ (وَحْدة عسكريَّة تضمّ عِدَّة سَرايا)\nمثال: كانا واقفين في طابور.",
 "さきおくり": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "さきがい": "استباق, حق الشفعة (الاستيلاء المسبق على شيء ما)\nمثال: استيلاء المصالح التجارية على عرض النطاق الترددي",
 "さきがけ": "رَائِد",
 "さきがね": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "さきくぐり": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية)",
 "さきごめ": "تلقيم فوهي ((عن الأسلحة النارية) تستقبل القذيفة أو الخرطوشة عبر الفوهة)",
 "さきごめじゅう": "بندقية تلقيم من الفوهة (سلاح ناري قديم كان يتم تلقيمه من خلال الفوهة)",
 "さきごろ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "さきだす": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "さきだち": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "さきだって": "قَبْل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "さきだつ": "رَصَاص / سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "さきだつもの": "إمكانيات, موارد ضرورية (الوسائل الضرورية (خاصة الوسائل المالية))",
 "さきっちょ": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "さきっぽ": "طَرَف",
 "さきつおや": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "さきづけ": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة…)",
 "さきて": "خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "さきとなり": "فِي الجِوَار, فِي المَنْزِل المُجَاوِر (في أو إلى المسكن المجاور)\nمثال: كان المجرم يعيش في المنزل المجاور طوال هذا الوقت",
 "さきどなり": "فِي الجِوَار, فِي المَنْزِل المُجَاوِر (في أو إلى المسكن المجاور)\nمثال: كان المجرم يعيش في المنزل المجاور طوال هذا الوقت",
 "さきどり": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "さきに": "قَبْلًا, قَبْل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "さきにたつ": "رَصَاص",
 "さきのおや": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "さきのばし": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "さきのばしにする": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "さきのひ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "さきばしり": "فَأل, نَذِيْر / بَشِير, مُبَشِّر / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / مَذْي",
 "さきばしりえき": "مَذْي",
 "さきばしりじる": "مَذْي",
 "さきばらい": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما)\nمثال: كان علم فراسة الدماغ سابقة لعلم الأعصاب الحديث",
 "さきぶと": "هِرَاوِيّ الشَّكْل (على شكل هِراوة تكون أعرض عند أحد طرفيها)",
 "さきぶとり": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / مُتَمَوِّج, مُنْتَشِر (يتدفق أو يمتد كما لو كان في تيار هوائي)",
 "さきぶれ": "بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "さきほど": "آنِفاً",
 "さきぼう": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "さきぼそり": "آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل)\nمثال: ليس هناك حزن أكبر من تضاؤل العائلة / تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "さきまわり": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية)",
 "さきもの": "مُسْتَقْبَل",
 "さきものがい": "تَكَهُّنٌ",
 "さきものしじょう": "سوق العقود الآجلة (بورصة سلع يتم فيها تداول العقود الآجلة)",
 "さきゅう": "كثيب, كثيب رملي (سلسلة من الرمال كونتها الرياح؛ توجد في الصحاري أو بالقرب من البحيرات والمحيطات)",
 "さきゆき": "مُسْتَقْبَل",
 "さきよみ": "تَوَقَّعَ",
 "さきわたし": "تَوْصِيل, تَسْلِيم\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "さきわれスプーン": "سبورك, ملعقة شوكية (علامة تجارية لأداة أكل بلاستيكية لها أسنان وتجويف مثل الملعقة)",
 "さきをいそぐ": "عَجَلَة\nمثال: أسرع و إلا تأخرت.",
 "さきをつづける": "تَابَعَ, اِسْتَمَرَّ",
 "さきん": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في…) / فَرْق, اِخْتِلَاف",
 "さきんじる": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "さきんずる": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك.",
 "さきんずればひとをせいす": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "さきんせき": "أفينتورين, حجر الشمس (كوارتز نصف شفاف مرصع بقطع صغيرة من الميكا أو معادن أخرى)",
 "さぎ": "غِشّ, اِحْتِيال / مَالِكُ الحَزِين, بَلَشُون (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟ / ضَجَعَ, تَمَدَّدَ\nمثال: اتهمتني بالكذب.",
 "さぎざい": "غِشّ, اِحْتِيال",
 "さぎし": "مُحْتَال",
 "さぎそう": "أوركيد مهدب (أي من عدة بساتين فاكهة أمريكية تزهر صيفاً تتميز بشفة مهدبة أو ممزقة)",
 "さぎふえ": "سمكة قناصة (سمكة صغيرة تعيش في قاع البحار الدافئة ذات جسم مضغوط وخطم طويل وفم عديم الأسنان)",
 "さぎょう": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "さぎょうい": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "さぎょういん": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "さぎょううた": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "さぎょうきおく": "ذَاكِرَة عَامِلَة",
 "さぎょうぎ": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "さぎょうげんば": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "さぎょうしゃ": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه)\nمثال: مشغل لوحة المفاتيح",
 "さぎょうだい": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة…)\nمثال: هذه ليست طاولة.",
 "さぎょうはん": "طاقم عمل, فرقة عمال (مجموعة منظمة من العمال)",
 "さぎょうば": "مَشْغَل, وَرْشَة",
 "さぎょうふか": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "さぎょうふく": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "さぎょうぶかい": "مجموعة عمل (مجموعة من الأشخاص يعملون معًا مؤقتًا حتى يتم تحقيق هدف ما)\nمثال: كان من المفترض أن تقدم مجموعة العمل تقريرًا في غضون أسبوعين",
 "さぎょうよういん": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "さぎょうりょう": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "さぎょうりょういき": "مِسَاحةُ عَمَل",
 "さぎょうりょうほう": "علاج بالعمل, علاج وظيفي (علاج يعتمد على المشاركة في أنشطة ذات مغزى من الحياة اليومية، لتمكين المشاركة في…)",
 "さぎょうグループ": "مجموعة عمل (مجموعة من الأشخاص يعملون معًا مؤقتًا حتى يتم تحقيق هدف ما)\nمثال: كان من المفترض أن تقدم مجموعة العمل تقريرًا في غضون أسبوعين",
 "さぎょうスペース": "مِسَاحةُ عَمَل",
 "さぎり": "سَدِيم",
 "さぎる": "اِحْتِيَال",
 "さぎアプリ": "حِصَان طَرْوَادَة (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "さぎグループ": "جَرِيمة مُنَظَّمة",
 "さく": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة. / مُقَطَّعٌ إِلَى قِطَع (مقسَّم إلى قطع) / رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه. / إزهار, تزهير (رواسب مسحوقية على سطح ما)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / حِصَاد\nمثال: حصد الفلاح القمح. / أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / سُور / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه. / حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير. / تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري / مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة…) / اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة) / كَبْسُولة / حَصِيرَة / طَابُوقَة",
 "さくい": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / اصْطِنَاع, تَكَلُّف (صفة كون الشيء من صنع الناس ولا يحدث بشكل طبيعي) / عُمُولَة / لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة. / سَرِيعُ الكَسْر, هَشّ (قَلِيلُ المُرُونَة؛ يَسْهُلُ تَشَقُّقُهُ أَوِ انْكِسَارُهُ)",
 "さくいてき": "عَمْدِيّ, إرَادِيّ",
 "さくいん": "دَلِيل, فِهْرِس",
 "さくいんさぎょう": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "さくいんつけ": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "さくおう": "تَوَاطُؤ",
 "さくおとこ": "مُسْتَأْجِر",
 "さくか": "كَبْسُولة",
 "さくかごうぶつ": "مخلب, مركب مخلبي (مركب حلقي غير متجانس يحتوي على أيون فلزي مرتبط بروابط تناسقية بأيونين غير…)",
 "さくがほうかい": "كَرْتُون, فِيلْم كَرْتُون",
 "さくがら": "مَحْصُول / نَوْعِيَّة, جَوْدَة",
 "さくがんき": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "さくきょう": "مَحْصُول",
 "さくぐ": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة)",
 "さくげきじゅつ": "فنون مسرحية, مسرح (فن كتابة وإنتاج المسرحيات)",
 "さくげん": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "さくこん": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "さくご": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "さくさく": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / رفيعاً, عالياً (في منصب أو مستوى أو رتبة عالية)\nمثال: تفاصيل لا يعرفها سوى قلة من الأشخاص ذوي المناصب الرفيعة",
 "さくさん": "حمض الأسيتيك, حمض الخليك (سائل لاذع عديم اللون يستخدم على نطاق واسع في تصنيع البلاستيك والمستحضرات…)",
 "さくさんえん": "أسيتات, رايون أسيتات (قماش مصنوع من ألياف أسيتات السليلوز)",
 "さくさんきん": "حمض الأسيتيك, حمض الخليك (سائل لاذع عديم اللون يستخدم على نطاق واسع في تصنيع البلاستيك والمستحضرات…)",
