 "ごちゅうおん": "مُتَوَسِّط, وَسَطِيّ (يتعلّق بالوسط أو يقع فيه أو يمتدّ نحوه)",
 "ごちゅうもん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ごちょう": "ذُو كَيَان, مُتَجَسِّد (يَمْتَلِكُ أَوْ يُوجَدُ فِي شَكْلٍ جَسَدِيّ) / نَغْمَة, نَغْم / تَجْوِيد, تَرْتِيل (جوّد القارئ:أتى بـ التّلاوة على وجهها الحقّ وراعى أحكام التّجويد في القرآن (قرأ…)",
 "ごちょごちょ": "بتفاهة (بطريقة تافهة وعابثة)\nمثال: طلبات ذات دوافع تافهة",
 "ごっかぶり": "صُرْصُور",
 "ごっかん": "عز الشتاء, منتصف الشتاء (وسط فصل الشتاء)",
 "ごっくん": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه)",
 "ごっこあそび": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "ごっこ遊び": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "ごっそり": "تَمَامًا / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ごった": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "ごったに": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "ごったまぜ": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "ごった混ぜ": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "ごった煮": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "ごっちゃ": "فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "ごっつ": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "ごっつぁん": "شُكْرًا",
 "ごっつあん": "شُكْرًا",
 "ごっつい": "قوي, متين (قوي ومتين في البنية أو البناء؛ دائم التحمل)\nمثال: مع منزل مليء بالأولاد، يجب أن يكون لديك أثاث متين / خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟ / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "ごってり": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "ごつい": "قوي, متين (قوي ومتين في البنية أو البناء؛ دائم التحمل)\nمثال: مع منزل مليء بالأولاد، يجب أن يكون لديك أثاث متين / خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟ / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "ごつごうしゅぎ": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "ごつごうしゅぎしゃ": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "ごつごつ": "قوي, متين (قوي ومتين في البنية أو البناء؛ دائم التحمل)\nمثال: مع منزل مليء بالأولاد، يجب أن يكون لديك أثاث متين",
 "ごつぜん": "شَاهِق / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "ごつりつ": "شَاهِق",
 "ごつん": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة))",
 "ごつんごつん": "ضَخْم جِدًّا ((غير رسمي) كبير جداً)",
 "ごづめ": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة…)\nمثال: طلبوا دعماً مدفعياً",
 "ごていねい": "أَدِيب, مُؤَدَّب / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "ごてごて": "تفاعلي, نشط تفاعلياً (يشارك بسهولة في التفاعلات)\nمثال: الصوديوم معدن تفاعلي / بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "ごてごてしい": "اسْتِثْنَائِيّ, خَارِقٌ لِلْعَادَة (يَفُوقُ المُعْتَادَ أَوِ المُتَوَقَّعَ بِكَثِير)",
 "ごてにまわる": "تَأَخَّرَ",
 "ごてる": "قَمْقَمَ",
 "ごてをふむ": "تَأَخَّرَ",
 "ごてん": "قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ごでん": "تضليل, معلومات خاطئة (معلومات غير صحيحة)",
 "ごと": "كُلّ / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "ごとうち": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ごとき": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "ごとく": "حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم) / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "ごとし": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "ごとに": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "ごとん": "خبطة, ضربة قوية (ضربة ثقيلة باليد)",
 "ごど": "خَامِس, خَامِسَة\nمثال: رأيت خمسة رجال.",
 "ごどう": "تَنْوِير / مُضَلِّل",
 "ごどうさ": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي)",
 "ごどく": "قراءة خاطئة (سوء تفسير ناتج عن قراءة غير دقيقة)",
 "ごなすけ": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)",
 "ごなん": "مُصِيبَة, شَقْوَة",
 "ごにち": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ごにょごにょ": "بشكل غير مفهوم (بطريقة لا يمكن فهمها)\nمثال: تحدث الأجانب بشكل غير مفهوم",
 "ごにん": "سوء تفسير, سوء فهم (وضع تفسير خاطئ لشيء ما)\nمثال: تسبب سوء تفسيره للسؤال في خطئه",
 "ごにんぐみ": "خماسي, كوينتيت (تأليف موسيقي لخمسة مؤديين)",
 "ごにんしき": "سوء تفسير, سوء فهم (وضع تفسير خاطئ لشيء ما)\nمثال: تسبب سوء تفسيره للسؤال في خطئه",
 "ごねる": "تذمر, شكوى (مصطلحات غير رسمية للاعتراض)\nمثال: لدي شكوى بخصوص الخدمة هنا / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "ごねん": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ごのせん": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة)",
 "ごは": "فَرْع, غُصْن",
 "ごはさん": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "ごはっと": "مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "ごはん": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / إخْفَاق الْعَدَالَة / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "ごはんどき": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "ごはんむし": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "ごはんや": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "ごはん屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "ごはん蒸し": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "ごばい": "خُمَاسِيّ (ذو خمس وحدات أو مكوّنات)",
 "ごばく": "نِيرَان صَدِيقَة",
 "ごばらい": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "ごばん": "لوحة غو (لوحة تستخدم للعب غو)",
 "ごばんじま": "تَفَقُّد",
 "ごばんめじょう": "مُرَصَّع بِالفُسَيْفِسَاء (مزين بقطع صغيرة من الزجاج أو الحجر الملون مُجمَّعة في فسيفساء)",
 "ごひいきに": "شُكْرًا, تِسْلَم",
 "ごひゃく": "خَمْسُمِئَة (يَدُلُّ عَلَى العَدَد 500) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ごひゃくまん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ごびへんか": "تنغيم, عروض (أنماط الضغط والتنغيم في اللغة)",
 "ごびゅう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي. / مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس…)",
 "ごびゅうすいり": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس…)",
 "ごびょう": "ضَرِيح, مَرْقَد / ضَرِيح",
 "ごふ": "طِلَسْم, طِلَّسْم",
 "ごふう": "طِلَسْم, طِلَّسْم",
 "ごふく": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "ごふくもの": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "ごふくや": "بَزَّاز",
 "ごふじょう": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ごぶ": "نِصْف, نُصْف / مُسَاوَاة",
 "ごぶうんを": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "ごぶごぶ": "مُنَاصَفَةً, بِالنِّصْف",
 "ごぶん": "سُوء فَهْم / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ごへいかつぎ": "خُرَافَة",
 "ごへん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ごへんけい": "مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "ごべつ": "جُزْء كَلَام, قَسْم كَلَام",
 "ごべんたつ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "ごほう": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / تضليل, معلومات خاطئة (معلومات غير صحيحة)",
 "ごほうび": "مُكَافَأَة, ثَوَاب / عَالَجَ",
 "ごほうべん": "مُلَاءَمَة, مُنَاسَبَة",
 "ごほごほ": "سعال, كحة (طرد مفاجئ ومزعج للهواء من الرئتين يطهر ممرات الهواء؛ عرض شائع لعدوى الجهاز…) / مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ)",
 "ごほん": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / كَحَّ, سَعَلَ\nمثال: سعل زيري مرة أخرى. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "ごほんぞん": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى…)",
 "ごぼう": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في…) / شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر) / مَعْبَد / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "ごぼうけん": "حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على…)",
 "ごぼうせい": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "ごぼうづみ": "جدار حجري (سياج مبني من الحجارة الخشنة؛ يستخدم لفصل الحقول)",
 "ごぼごぼ": "غَرْغَرَ, بَقْبَقَ",
 "ごぽごぽ": "غَرْغَرَ, بَقْبَقَ",
 "ごま": "بذور السمسم, سمسم (بذور بيضاوية صغيرة لنبات السمسم) / سِمْسِم, جُلْجُلان",
 "ごまあぶら": "زَيْت سِمْسِم, زَيْت السِمْسِم (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "ごまかし": "تحايل, غش (خداع من أجل الربح الشخصي)",
 "ごまかす": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / تفادي, مراوغة (حركة مراوغة سريعة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار / غَلَّ, اِخْتَلَسَ",
