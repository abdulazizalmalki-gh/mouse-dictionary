 "そもじ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そもそも": "مُنْذُ البِدَايَة / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "そや": "رَيْفِيّ, قَرَوِيّ",
 "そやから": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そやす": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "そやつ": "هُوَ\nمثال: そいつをつかまえて！ — أمسكه!",
 "そゆ": "أَصْطَرَك, أَسْطَرَك",
 "そよう": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة.",
 "そようちょう": "سُخْرَة (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر) / سُخْرَة, كُوج (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر)",
 "そよぐ": "حَفِيف",
 "そら": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / طَقْس, جَوّ / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "そらあい": "طَقْس, جَوّ",
 "そらいろ": "سَمَاوِيّ, أَسْمَانْجُونِيّ",
 "そらおそろしい": "مُتَوَتِّر",
 "そらおぼえ": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらきた": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "そらごと": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "そらす": "أَزْعَجَ / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "そらせる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "そらぞらしい": "زَائِف, بَاطِل / كَاذِب",
 "そらでおぼえる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらで覚える": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらとぶえんばん": "طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "そらなみだ": "دُمُوع اَلتَّمَاسِيح",
 "そらにことば": "شِبْه نَظِير",
 "そらね": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "そらのげんかん": "مَطَار (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "そらのびん": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "そらびき": "مِنْسَج",
 "そらびきばた": "مِنْسَج",
 "そらまめ": "فُول, بَاقِلَّاء",
 "そらみみ": "صَمَم",
 "そらめ": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "そらもよう": "طَقْس, جَوّ\nمثال: 空模様から判断すると、雪が降りそうだ。 — يظهر من شكل السماء أن الثلج سيتساقط. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "そらをつかう": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "そらんじる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらんずる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そら恐ろしい": "مُتَوَتِّر",
 "そら来た": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "そら涙": "دُمُوع اَلتَّمَاسِيح",
 "そら覚え": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そら豆": "فُول, بَاقِلَّاء",
 "そり": "انحناء / منحنى",
 "そりあと": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "そりかえり": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "そりじたおん": "مُرْتَدّ",
 "そりたつ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そりゃ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "そりゃあ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "そりゃく": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そりゃそうだ": "طَبْعًا",
 "そりゅうし": "جُسَيْم أَوَّلِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "そりゅうしかそくき": "مُعَجِّل جُسَيْمَات",
 "そりゅうしぶつりがく": "فيزياء الجسيمات (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "そり立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そり舌音": "مُرْتَدّ",
 "そり跡": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "そる": "منحنى",
 "それ": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: 万一それが起これば、君はどうしますか。 — إن حصل هذا لأي سبب، فماذا ستفعل؟ / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛ / هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "それいけ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それいじょう": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "それいらい": "مُنْذُ",
 "それが": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "それがし": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "それきた": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "それこそ": "خُصُوصًا, خَاصَّةً / بِالتَّأْكِيد / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "それしき": "تافِه",
 "それしゃ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / غَيْشَا",
 "それじしん": "نَفْسُهُ, نَفْسُهَا",
 "それじたい": "لذاته وعينه",
 "それじゃ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それじゃあ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それそうおう": "مُنَاسِب / لَائِق",
 "それそれ": "بِالضَّبْط, تَمَامًا / بِالْضَبْط",
 "それぞれ": "كُلّ",
 "それだから": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それだけのかちがある": "اِسْتَحَقَّ",
 "それだけの価値がある": "اِسْتَحَقَّ",
 "それっぽい": "هَٰكَذَا, كَذَا / أَقْنَعَ",
 "それで": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それでは": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それでも": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "それでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "それと": "أَيْضًا, كَذٰلِكَ",
 "それとも": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "それとわかる": "مَلْحُوظ / جَدِير بِالْمُلَاحَظَة",
 "それと分かる": "مَلْحُوظ / جَدِير بِالْمُلَاحَظَة",
 "それどころか": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それな": "بِالضَّبْط, تَمَامًا / بِالْضَبْط",
 "それならそうと": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "それならそれで": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "それなり": "لذاته وعينه",
 "それなりに": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "それに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "それにしても": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "それにつけても": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "それにひきかえて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それにもかかわらず": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "それにも拘わらず": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "それにも関わらず": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "それに引き替えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それは": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "それはそうと": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそうとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそれとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそれは": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "それみたことか": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "それもこれも": "كُلّ, جَمِيع",
 "それもそのはず": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "それゆえ": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それゆえに": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それゆけ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それよか": "بَدَلاً مِن",
 "それよりも": "بَدَلاً مِن",
 "それら": "أُولَٰئِكَ, تِلْكَ",
 "それらしい": "هَٰكَذَا, كَذَا / أَقْنَعَ",
 "それる": "ضَلَّ",
 "それを": "بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "それ以上": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "それ以来": "مُنْذُ",
 "それ式": "تافِه",
 "それ故": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それ故に": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それ来た": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "それ相応": "مُنَاسِب / لَائِق",
 "それ自体": "لذاته وعينه",
 "それ自身": "نَفْسُهُ, نَفْسُهَا",
 "それ行け": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それ見たことか": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それ見た事か": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "そろ": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "そろい": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / كُلّ, جَمِيع",
 "そろいぶみ": "تَشْكِيلَة",
 "そろい踏み": "تَشْكِيلَة",
 "そろう": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "そろえ": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "そろえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "そろそろ": "قَرِيبًا, سَرْعَانَ مَا / بِبُطْء / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "そろっと": "قَرِيبًا, سَرْعَانَ مَا",
 "そろばん": "مِعَد, مِعْدَاد / نَاصِيَة (منبت شعر الغرّة الذي يقع فوق الجبهة مباشرة؛ عن شعر الغرّة) / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "そろばんがあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "そろばんが合う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "そろばんずく": "مُرْتَزِق, مُؤْجِر",
 "そろばんだかい": "حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "そろばんづく": "مُرْتَزِق, مُؤْجِر",
 "そろばん高い": "حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "そろわない": "فَرْدِيّ",
 "そわか": "لَا فُضَّ فُوكَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "そわせる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "そん": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "そんえい": "صُورَة / بُورْتْرِيَّة",
 "そんかい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんかん": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "そんがい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがいばいしょう": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがいをあたえる": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがん": "مَلَامِح",
 "そんき": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "そんけい": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんけいしん": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんげん": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة.",
 "そんこう": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そんざい": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そんざいいぎ": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいかち": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいかん": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "そんざいしゃ": "إِن (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "そんざいりゆう": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいりょう": "كَثْرَة, غَزَارَة / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "そんざいろん": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "そんし": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "そんしつ": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "そんしつがく": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "そんしょう": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんじ": "اِنْزَلَقَ",
 "そんじゃ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そんじゃあ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そんじょそこら": "هُنَا وَهُنَاكَ / شَائِع",
 "そんじる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته. / خَسَّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "そんすう": "تَبْجِيل / تَعْظِيم",
 "そんする": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / ضَرَرٌ / ضَرَّ أَضَرَّ",
 "そんずる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته. / خَسَّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "そんそ": "طَرَف / حَفْلَة, اِحْتِفَال",
 "そんぞく": "إِلْحَاح",
 "そんたい": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "そんたく": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "そんだい": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そんち": "حَافَظَ",
 "そんちょう": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんで": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そんでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そんとくなし": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "そんな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そんなに": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そんなふうに": "هَٰكَذَا, كَذَا",
 "そんなもの": "هكذا الدنيا",
 "そんなもん": "هكذا الدنيا",
 "そんなわけで": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "そんな訳で": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "そんな風に": "هَٰكَذَا, كَذَا",
 "そんのうとう": "إِمْبَرِيَالِيّ / إِمْبَرِيَالِيّ, إِمْبِرْيالِيَّة",
 "そんぱい": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そんぼう": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "そんみん": "قَرَوِيّ, قَرَوِيَّة",
 "そんもう": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "そんゆう": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そんらく": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そんりつ": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そーいう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そーっと": "بِهُدُوء / سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "そーゆー": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そ求": "فِدَاء / خَلَاص",
 "そ知らぬ": "تَظَاهَرَ, اِخْتَلَقَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر) / يَزْعُم, تَخَيَّل\nمثال: تظاهر بأنه طبيب.",
 "そ首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "ぞい": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "ぞう": "فِيل, فيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "ぞうえい": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "ぞうえいぶつ": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "ぞうえき": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ぞうお": "بُغْض, كَرَاهِيَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "ぞうおはんざい": "جَرِيمَة كَرَاهِيَّة",
 "ぞうか": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ぞうかぶん": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ぞうがく": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
