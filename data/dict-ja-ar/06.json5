 "ぜんじつだん": "متعلِّق بالماضي, رَجْعِيّ",
 "ぜんじてき": "تَدْرِيجِيّ",
 "ぜんじゅつ": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "ぜんじょう": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "ぜんじん": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ぜんじんみとう": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ぜんじんみはつ": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ぜんすうちょうさ": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "ぜんする": "اِخْتَارَ",
 "ぜんせい": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "ぜんせいあい": "شُمُولِيَّة جِنْسِيّة",
 "ぜんせいき": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "ぜんせいじだい": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "ぜんせき": "مَقْعَد أَمَامِيّ (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "ぜんせん": "جَبْهَة / أَمَامِيّ / خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ぜんぜん": "أبداً / تَمَامًا / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ぜんぜんじつ": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / قَبْلَ أَمْس, أَمْس الْأَوَّل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: لم تكن أول مرة.",
 "ぜんそう": "اِفْتِتَاحِيَّة",
 "ぜんそうきょく": "اِفْتِتَاحِيَّة",
 "ぜんそうほう": "تَدَرُّج / تَدْرِيج",
 "ぜんそく": "رَبُو",
 "ぜんたい": "كَامِل / كُلّ",
 "ぜんたいしゅぎ": "شُمُولِيَّة",
 "ぜんたいしゅぎしゃ": "شُمُولِيّ",
 "ぜんたいぞう": "بَانُورَامَا",
 "ぜんたいてき": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "ぜんたいに": "عُمُومًا / بِوَجْهٍ عَامّ",
 "ぜんだいみもん": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ぜんだく": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "ぜんだんぬき": "رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "ぜんち": "مُقَدِّمَة",
 "ぜんちきゅう": "عَالَمِيّ",
 "ぜんちきゅうそくいシステム": "نِظَام اَلتَّمَوْضُع اَلْعَالَمِيّ, جِي بِي إِس (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / مثال: ليس بنظام كامل.",
 "ぜんちし": "جَارّ, حَرْف جَرّ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "ぜんちゅう": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "ぜんちょう": "فَأل, نَذِيْر",
 "ぜんっぜん": "أبداً / تَمَامًا / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ぜんてい": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / قَصْد, إِرَادَة / مُقَدِّمَة",
 "ぜんていじょうけん": "لَازِم / شَرْط, اِحْتِيَاج (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "ぜんてき": "مَجْمُوع",
 "ぜんと": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل\nمثال: 君には前途がある。 — ما زالت الحياة أمامك.",
 "ぜんとうぶ": "جَبْهَة / أَمَامِيّ",
 "ぜんとうよう": "فص جبهي",
 "ぜんとうようはくしつせっせつじゅつ": "جراحة فصية",
 "ぜんときん": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "ぜんとく": "فَضِيلَة / عِفَّة, طَهَارَة",
 "ぜんどう": "تَمَعُّج",
 "ぜんどううんどう": "تَمَعُّج",
 "ぜんなんぜんにょ": "وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ぜんにゅう": "حَلِيب كَامِل الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "ぜんにん": "سَابِق",
 "ぜんねん": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "ぜんのう": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "ぜんのうしゃ": "كُلِّيّ القُدْرة, جَبّار",
 "ぜんはく": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "ぜんぱん": "كَامِل / كُلّ",
 "ぜんぱんてき": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "ぜんぱんてきに": "عُمُومًا / بِوَجْهٍ عَامّ",
 "ぜんぱんに": "عُمُومًا / بِوَجْهٍ عَامّ",
 "ぜんび": "كَمَال, إتقان",
 "ぜんぴょう": "فَأل, نَذِيْر",
 "ぜんぶ": "جَبْهَة / أَمَامِيّ",
 "ぜんぶん": "دِيبَاجَة",
 "ぜんぷく": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان",
 "ぜんべいじょせいきこう": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "ぜんべいせいぞうぎょうしゃきょうかい": "حركة عدم الانحياز",
 "ぜんぽう": "صَاعِدًا / مُهَاجِم",
 "ぜんぽうごかんせい": "توافقية مستقبلية",
 "ぜんめつ": "إِفْنَاء, تَدْمِير / إِفْنَاء",
 "ぜんめん": "وَاجِهَة",
 "ぜんめんせんそう": "الحَرْب الشَّامِلَة",
 "ぜんめんてき": "مَجْمُوع",
 "ぜんもん": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "ぜんや": "اَلْبَارِحَةَ / حَوَّاء / حَوَّاء, أِيف",
 "ぜんやさい": "حَوَّاء / حَوَّاء, أِيف",
 "ぜんやしき": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "ぜんようび": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ぜんら": "عَارٍ, عُرْيَان",
 "ぜんりつせん": "بْرُوسْتَات, بَرُوسْتَات",
 "ぜんりょう": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "ぜんれい": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "ぜんろう": "رِوَاق, رُوَاق (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة)\nمثال: ذهب إلى الرواق.",
 "ぜんわん": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "ぜん動": "تَمَعُّج",
 "そ": "مُمْتَاز, فَاخِر / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "そあく": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そあん": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "そい": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "そいじゃ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そいつ": "هُوَ\nمثال: そいつをつかまえて！ — أمسكه! / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "そいつら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "そいつ等": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "そいで": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そいでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そいぼし": "قَمَر, تَابِع (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث) / قَمَر اِصْطِنَاعِيّ (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "そいん": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "そう": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "そうあん": "حَبِلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته) / خَرَجَ بِ (اِنْتَقَلَ إلى خارج المكان)\nمثال: حبل الكذب قصير.",
 "そうあんしゃ": "مُخْتَرِع, مُبْتَكِر",
 "そうい": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "そういう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そういうもの": "هكذا الدنيا",
 "そういうもん": "هكذا الدنيا",
 "そういえん": "دَاحِس",
 "そういった": "هَٰكَذَا, كَذَا",
 "そういてん": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "そういない": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "そういなく": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "そういん": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
