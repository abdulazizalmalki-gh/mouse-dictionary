{
 "こんちは": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "こんちゃ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "こんちゅう": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية.",
 "こんちゅうがく": "عِلْم اَلْحَشَرَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こんちゅうがくしゃ": "عالم حشرات (عالم حيوان يدرس الحشرات)",
 "こんちゅうきょうふしょう": "رهاب الحشرات (خوف مرضي من الحشرات)",
 "こんちょう": "هٰذَا الصَّبَاح",
 "こんちわ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "こんてい": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "こんてんぎ": "الإسطرلاب الكروي, ذات الحلق (كرة سماوية تتكون من أطواق معدنية؛ استخدمها علماء الفلك الأوائل لتحديد مواقع النجوم)",
 "こんとう": "إِغْمَاء / أُغْمِيَ, غُشِيَ / أَدِيب, مُؤَدَّب",
 "こんとうがんしゅ": "تدرن التاج (مرض بكتيري يصيب النباتات (خاصة الفواكه ذات النواة والتفاحيات والعنب والورود) يشكل نتوءات على الساق بالقرب من الأرض)",
 "こんとく": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه) / حَمِيم, وِدِّيّ (مَحْسُوس بِإِخْلَاص وَعُمْق) / لَطِيف, وَدِّيّ (دافئ وودّي بأدب ولباقة) / ليكير, مشروب كحولي حلو (مشروب قوي حلو ومنكه بشدة يُشرب عادة بعد الوجبة)",
 "こんとん": "فَوْضَى / فَوْضَوِيّ",
 "こんど": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / حالاً, خلال وقت قصير (في المستقبل القريب) / بفترة قصيرة, بوقت قصير (لفترة قصيرة) / بمسافة قصيرة (على مسافة قصيرة) / بِإِيجَاز, بِاخْتِصَار (بطريقة موجزة؛ في بضع كلمات)\nمثال: سيكون الطبيب هنا قريباً / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "こんどう": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "こんな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "こんなに": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "こんなん": "صُعُوبَة / اسْتِحَالَة, عَدَم جَدْوَى (صفة كون الشيء غير قابل للقيام به)",
 "こんにち": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "こんにちさま": "إله الشمس (إله يجسد الشمس أو يرتبط بها بشكل ما)",
 "こんにちてき": "عَصْرِيّ, حَدِيث",
 "こんにちでは": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "こんにちは": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "こんにちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "こんにった": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "こんにゃく": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة للأكل أو في البيوت الزجاجية لأوراقه الكبيرة وقنابته الحمراء الداكنة…)",
 "こんにゃくばん": "هيكتوغراف (ناسخة تتكون من لوحة جيلاتينية يمكن أخذ الحبر منها لعمل نسخة)",
 "こんにゃく版": "هيكتوغراف (ناسخة تتكون من لوحة جيلاتينية يمكن أخذ الحبر منها لعمل نسخة)",
 "こんにゅう": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "こんのいい": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "こんのよい": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "こんばん": "هٰذَا الْمَسَاء, اللَّيْلَ / اَللَّيْلَة",
 "こんばんにちは": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "こんばんにちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "こんばんは": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "こんばんわ": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "こんぱい": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد) / توست, خبز محمص (شرائح من الخبز تم تحميصها) / نخب (شرب نخب تكريماً لشخص أو حدث أو للصحة) / مُنْتَهٍ, هالِك (شخص في مأزق يائس؛ شخص محكوم عليه بالهلاك) / نجم المجتمع (مشهور يتلقى الكثير من الإشادة والاهتمام)\nمثال: سأكون هالكاً إذا لم تنجح هذه الخطة",
 "こんぱく": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "こんぱん": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "こんぶ": "عشب البحر, كيلب (أعشاب بحرية بنية كبيرة لها سعف جلدي متموج)",
 "こんぶんすう": "عَدَد مُرَكَّب الْوَحَدَات, كَمِّيَّة مُرَكَّبَة (كمية يُعَبَّر عنها بوحدتين مختلفتين)\nمثال: كمية مركبة مثل 'ساعة وعشر دقائق'",
 "こんぺき": "سَمَاوِيّ, لَازَوَرْدِيّ",
 "こんぼう": "استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "こんぼん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "こんぽう": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "こんぽうざい": "حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)",
 "こんぽうばこ": "صندوق تعبئة (صندوق كبير تُعبأ فيه البضائع للشحن أو التخزين) / صندوق الحشو (حجرة صغيرة يتم فيها ضغط الحشو حول عمود متردد أو مكبس لتشكيل ختم محكم)",
 "こんぽん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "こんぽんげんり": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "こんぽんしゅぎ": "أُصُولِيَّة",
 "こんぽんしゅぎしゃ": "أُصُولِيّ",
 "こんぽんてき": "أَسَاسِيّ",
 "こんま": "كَارْمَا",
 "こんめい": "مَعْمَعَة / تخدير, ذهول (فعل جعل الشخص متبلد الشعور أو خاملاً) / ترنح, ذهول (وعي هامشي) / انصعاق, ذهول (شعور بالدهشة المذهلة)\nمثال: اشتهر الأستاذ بجعل طلابه في حالة ذهول / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام. / كُونْمِينْج, كُونْمِينْغ",
 "こんめいじょうたい": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات / مَعْمَعَة",
 "こんもう": "استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال / شعيرة جذرية (نمو شعري رقيق لخلية بشرة خلف الطرف مباشرة؛ يمتص العناصر الغذائية من التربة)",
 "こんもり": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "こんや": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة / صَبَّاغ, صَبَّاغَة",
 "こんやく": "خِطْبَة, خُطُوبَة / مِحْنَة",
 "こんやくしゃ": "خطيب (رجل مخطوب للزواج)",
 "こんやくゆびわ": "خَاتَم اَلْخُطُوبَة",
 "こんやさい": "محصول جذري (محصول يزرع لجذوره المتضخمة: مثل البنجر والبطاطس واللفت)",
 "こんゆう": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "こんよ": "تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "こんよう": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "こんらん": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "こんりゅう": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "こんりんざい": "يَوْمًا",
 "こんりんならく": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "こんる": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "こんれい": "زفاف, زواج (فعل الزواج؛ مراسم النكاح)\nمثال: تم زواجهم في الكنيسة",
