 "たいしょく": "تَقَاعُد",
 "たいしょくか": "أَكَّال, شَرَه",
 "たいしょくかん": "أَكَّال, شَرَه",
 "たいしょくさいぼう": "بَالِعَة, مَاكْرُوفَاج",
 "たいしょくしゃ": "مُتَقَاعِد",
 "たいしょくとどけ": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "たいしょくねんきん": "مَعَاش / بَنْسِيُون",
 "たいしょほう": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "たいしょほうほう": "تَحَاشٍ / تَجَنُّب (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "たいしん": "مُوَاجَهَة, مُجَابَهَة",
 "たいしんいん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "たいじ": "مُوَاجَهَة, مُجَابَهَة",
 "たいじせいアルコールしょうこうぐん": "فَا",
 "たいじゅう": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "たいじゅうけい": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "たいじゅんかん": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "たいじょう": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "たいじょうほうしん": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "たいじん": "اِسْتِقَالَة, اِسْتِعْفَاء / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "たいじんきょうふしょう": "اِضْطِرَاب الْقَلَقِ الاِجْتِمَاعِي",
 "たいす": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "たいすい": "مُقَاوِم لِلْمَاء",
 "たいすいそう": "طَبَقَة ٱلْمِيَاهِ ٱلْجَوْفِيَّةِ",
 "たいすう": "أَسِيس, لُوغَارِثْم",
 "たいする": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "たいせい": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَأْسِيس / مُؤَسَّسَة / تَشْرِيح",
 "たいせいがわ": "تَأْسِيس / مُؤَسَّسَة",
 "たいせいよう": "الْمُحِيط الْأَطْلَسِيّ, الْأَطْلَسِيّ",
 "たいせき": "سِعَة",
 "たいせきがん": "صَخْر رُسُوبِيّ",
 "たいせきぶつ": "رَاسِب",
 "たいせち": "مُهِمّ / ثَمِين / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "たいせつ": "مُهِمّ / ثَمِين / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "たいせつどうぶつ": "تَلَفَّظَ",
 "たいせつなひと": "النصف الآخر",
 "たいせつに": "بِعِنَايَة",
 "たいせつにする": "كَنْز / اِهْتَمَّ, اِعْتَنَى",
 "たいせん": "صِرَاع",
 "たいせんあいて": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "たいぜん": "هَادِئ / طَمْأَنَ",
 "たいそ": "مُؤَسِّس, مُؤَسِّسَة",
 "たいそう": "جُمْبَاز / تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "たいぞう": "اِكْتِنَاز",
 "たいだ": "كَسْلَان",
 "たいだん": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "たいだんしゃ": "مُحَاوِر, مُتَحَاوِر",
 "たいち": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة.",
 "たいちょ": "تُحْفَة, رَائِعَة",
 "たいちょう": "شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "たいちょうかんり": "رِعَايَة صِحِّيَّة",
 "たいちょうをくずす": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "たいてい": "عَادَةً, الاَكْثِرْ / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عَادِيّ, مَأْلُوف",
 "たいてき": "عَدُوّ لَدُود (ركض أو جري)\nمثال: عدو عدوي صديقي.",
 "たいてん": "اِنْسِحَاب",
 "たいと": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "たいとう": "مُسَاوَاة / تَسَاوٍ",
 "たいとく": "تَحْقِيق",
 "たいど": "مَوْقِف, سُلُوك",
 "たいどう": "أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "たいどがおおきい": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "たいない": "مَنْزَلِيّ",
 "たいなん": "بَلَاء, بُؤْس",
 "たいにん": "تَقَاعُد",
 "たいにんてん": "متعلِّق بالماضي, رَجْعِيّ",
 "たいは": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "たいはい": "نَخْر / اضمحل / تضعضع / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "たいはいてき": "مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "たいはく": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي.",
 "たいはくせい": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي.",
 "たいはん": "غَالِبِيَّة, أَغْلَبِيّة / غَالِبًا",
 "たいばつ": "عُقُوبَةٌ بَدَنِيَّة",
 "たいばん": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "たいひ": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "たいひごう": "خَنْدَق, أُخْدُود / خَنْدَق",
 "たいひじょ": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "たいひせん": "جَانِب / صَفْحَة",
 "たいび": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "たいふう": "تَايْفُون, إِعْصَار",
 "たいふく": "زَيّ, زِي",
 "たいぶ": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "たいへい": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "たいへいしゅう": "أُوقِيَانُوسِيَا",
 "たいへいよう": "الْمُحِيط الْهَادِئ",
 "たいへき": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "たいへん": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عِمْلاق / جِدِّيّ / جَدِّيّ, جَادّ / صَعْب",
 "たいべん": "عقي",
 "たいべんきゅういんしょうこうぐん": "مَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "たいほ": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "たいほう": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "たいほういん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "たいほく": "تَايْبِيه, تَايْبِي (عاصمة دولة تايوان)",
 "たいほれき": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "たいほん": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "たいぼ": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "たいぼう": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "たいま": "قِنَّب / قِنَّب هِنْدِيّ",
 "たいまし": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "たいまそう": "قِنَّب",
 "たいまん": "أَهْمَلَ / إِهْمَال",
 "たいめ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "たいめん": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "たいもう": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "たいもん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "たいやく": "بَلَاء, بُؤْس",
 "たいよ": "قَرْض, إِعَارَة",
 "たいよう": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "たいようけい": "منظومة شمسية",
 "たいようけいがいわくせい": "كَوْكَب خَارِج الْمَجْمُوعَة الشَّمْسِيَّة ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "たいようけいぎ": "أُورُرِي, أُورُورِي",
 "たいようこう": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "たいようこうせん": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
