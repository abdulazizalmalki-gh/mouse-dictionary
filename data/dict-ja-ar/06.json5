 "そしょう": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうきろく": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "そしょうざた": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうじけん": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうにん": "مُدَّعٍ, الْمُدَّعِي",
 "そしょうひよう": "سَاوَى, كَلَّفَ / تَكْلِفَة, كُلْفَة",
 "そしょうほう": "قَانُون إِجْرَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "そしょく": "تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية. / هَيْكَل / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / مَنْدِيل, مِنْدِيل / نَسِيج حَيَوِيّ",
 "そしらぬ": "تَظَاهَرَ, اِخْتَلَقَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر) / يَزْعُم, تَخَيَّل\nمثال: تظاهر بأنه طبيب.",
 "そしり": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "そしる": "تَشْهِير, اِفْتِرَاء",
 "そじ": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "そじほう": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "そじゅ": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "そじょう": "عَرِيضَة, طَلَب",
 "そすい": "قَنَاة",
 "そすう": "عَدَد أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "そせい": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "そせいじゅつ": "اِنْعَاش",
 "そせき": "حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "そせん": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "そぜい": "ضَرِيبَة",
 "そぜいかいひち": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "そぜいひなんち": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "そそ": "رَشِيق, ظَرِيف",
 "そそう": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "そそくさ": "مُسْتَعْجِل",
 "そそぐ": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / مَضْمَضَ",
 "そそっかしい": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そそのかす": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "そそりたつ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そそり勃つ": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そそり立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そそる": "حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "そぞう": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "そぞく": "قَارِض, قَوَارِض",
 "そぞろ": "مُشتَّت",
 "そぞろあるき": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そぞろあるく": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そぞろ歩き": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そぞろ歩く": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そだ": "غُصَّيْن",
 "そだい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そだち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "そだちゆく": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "そだつ": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "そだて": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そだてあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そだてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / تنشئَة, تَرْبِيَة",
 "そち": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "そちのけ": "أَهْمَلَ / إِهْمَال",
 "そちゃ": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة) / فِنْجَان شَاي (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: صب الشاي لضيفك.",
 "そちゅう": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "そちら": "هُنَاكَ / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: これとそちらとの違いは何だい。 — ما الفرق بين هذا و ذاك؟ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そちらさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そちら様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そっか": "أَنْتَ, أَنْتِ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "そっから": "مِن هُنَاكَ, ثَمَّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そっきゅう": "فَوْرِيّ",
 "そっきょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "そっきょう": "اِرْتَجَلَ (الفرس: راوح بين العَنَق والهملجة؛ الطبّاخ: طبخ الطعام في المرجل)",
 "そっきょうてき": "اِرْتَجَلَ (الفرس: راوح بين العَنَق والهملجة؛ الطبّاخ: طبخ الطعام في المرجل)",
 "そっきん": "حَاشِيَة",
 "そっくび": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "そっくり": "كُلّ, جَمِيع",
 "そっくりさん": "ثُنَائِيّ / ضِعْف",
 "そっけない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "そっこう": "مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "そっこく": "فَوْرًا, حَالًا",
 "そっこん": "حَالِيًّا, فِي هٰذِهِ اَللَّحْظَة",
 "そっこんこつ": "رُصُغ",
 "そっす": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "そっする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "そっち": "هُنَاكَ / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: これとそちらとの違いは何だい。 — ما الفرق بين هذا و ذاك؟ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そっちのけ": "أَهْمَلَ / إِهْمَال",
 "そっちょく": "إِفْرَنْجِيّ",
 "そって": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "そっと": "بِهُدُوء / سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "そっとう": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "そっぽをむく": "تَجَاهَلَ, طَنَّش",
 "そっぽを向く": "تَجَاهَلَ, طَنَّش",
 "そっ首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "そつ": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "そつい": "مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة / طَعْن, سَحْب ثِقَة",
 "そついがわ": "مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة",
 "そついしゃ": "مُدَّعٍ / الْمُدَّعِي",
 "そつう": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "そつがない": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "そつぎょう": "تَخَرُّج / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "そつぎょうしき": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "そつぎょうしゃ": "خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "そつぎょうしょうしょ": "شَهَادَة, دِبْلُوم",
 "そつぎょうしょうめいしょ": "شَهَادَة, دِبْلُوم",
 "そつぎょうせい": "خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "そつしゃ": "خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "そつじ": "مُبَاغِت, مُفَاجِئ",
 "そつぜん": "مُبَاغِت, مُفَاجِئ",
 "そつにゅう": "فَطَمَ / اِنْفَطَمَ",
 "そつのない": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "そつゆう": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "そてい": "اِفْتِرَاض, فَرْضِيَّة",
 "そで": "كُمّ, رُدْن / جَنَاح / رَفْرَف",
 "そでごい": "سَائِل / فَقِير",
 "そでした": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "そでにすがる": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "そでにする": "تَجَاهَلَ, طَنَّش",
 "そでのした": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "そでをとおす": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "そと": "خَارِج, بره / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "そとうば": "سْتُوبَا",
 "そとうみ": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "そとがわ": "خَارِج, بره",
 "そとぐに": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "そとごはん": "نُزْهَة / مَهَمَّة سَهْلَة",
 "そとづけ": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "そとづら": "خَارِج, بره / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "そとで": "خَارِج",
 "そとなる": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "そとば": "سْتُوبَا",
 "そとばこ": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "そとまわり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "そとみ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "そとめ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "そとわく": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "そない": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هَٰكَذَا, كَذَا",
 "そなえ": "قُرْبَان",
 "そなえつけ": "مُعَدَّات, تَجْهِيزَات",
 "そなえつける": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "そなえもの": "قُرْبَان",
 "そなえる": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "そなた": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そにどり": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "そにん": "مُتَّهِم",
 "そに鳥": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "そねみ": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "そねむ": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "その": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "そのあしで": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "そのあたり": "قُرْب, جِوَار (أَدْنَى؛ قدَّرَ) / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: جلست بالقرب منها.",
 "そのあと": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのいっぽう": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "そのう": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان.",
 "そのうえ": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "そのうえで": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "そのうち": "قَرِيبًا, سَرْعَانَ مَا",
 "そのうちに": "قَرِيبًا, سَرْعَانَ مَا",
 "そのおり": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのかみ": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "そのかわり": "بَدَلاً مِن",
 "そのけ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "そのこと": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "そのころ": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのご": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのじつ": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そのすじ": "يَاكُوزَا",
 "そのた": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのため": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "そのとき": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そののち": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのはず": "طَبْعًا",
 "そのはんめん": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そのば": "هُنَاكَ / فَوْرًا, حَالًا",
 "そのばかぎり": "مُؤَقَّت",
 "そのほう": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そのほか": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのほかに": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "そのまさかだ": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "そのまま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのまんま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのみち": "عَلَاقَة غَرَامِيَّة",
 "そのもと": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そのもの": "نَفْسُهُ, نَفْسُهَا",
 "そのよう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そのケ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "その一方": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "その上": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "その上で": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "その事": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "その他": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "その他に": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "その代り": "بَدَلاً مِن",
 "その代わり": "بَدَلاً مِن",
 "その儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "その内": "قَرِيبًا, سَرْعَانَ مَا",
 "その内に": "قَرِيبًا, سَرْعَانَ مَا",
 "その半面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "その反面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "その場": "هُنَاكَ / فَوْرًا, حَالًا",
 "その場かぎり": "مُؤَقَّت",
 "その場限り": "مُؤَقَّت",
 "その外": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "その実": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "その後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "その折": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その折り": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その方": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "その時": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "その気": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "その為": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "その物": "نَفْسُهُ, نَفْسُهَا",
 "その筈": "طَبْعًا",
 "その筋": "يَاكُوزَا",
 "その足で": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "その辺り": "قُرْب, جِوَار (أَدْنَى؛ قدَّرَ) / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: جلست بالقرب منها.",
 "その道": "عَلَاقَة غَرَامِيَّة",
 "その頃": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そば": "جَانِب / صَفْحَة / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "そばかす": "نَمَش",
 "そばから": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "そばきり": "سُوبَا",
 "そばだつ": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そばだてる": "سُلَالَة",
 "そばづかえ": "خادمَة",
 "そばにょうぼう": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "そばはら": "خَاصِرَة, كَشْح / جِنَاح / جَانِب",
 "そばむ": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "そばむぎ": "حِنْطَة سَوْدَاء",
 "そばめ": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "そば切り": "سُوبَا",
 "そびえる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そびやかす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そびょう": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / لَخَّصَ, اِخْتَصَرَ",
 "そびら": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "そふ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そふぼ": "جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そぶ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そぶつ": "مَلَابِس, ثِيَاب",
