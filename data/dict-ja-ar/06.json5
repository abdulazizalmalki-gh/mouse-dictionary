 "ごういてん": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "ごういねんれい": "سن الرشد القانوني, سن الموافقة (الحد الأدنى للسن للزواج دون موافقة الوالدين أو الحد الأدنى للسن للعلاقات…)",
 "ごういん": "مُتَسَلِّط / كَارْمَا / خَمْرِيّ, عَرْبَدِيّ (يُوصَف بِهِ العَرْبَدَة وَالسُّكْر الصَّاخِب) / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب.",
 "ごうう": "طوفان, هطول غزير (مطر غزير)",
 "ごうおん": "إِشَارَة",
 "ごうか": "نَارُ جَهَنَّم (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار. / مُسْرِف",
 "ごうかい": "حَمِيم, عَمِيق (عميق الإحساس وصادق المشاعر)",
 "ごうかきゃくせん": "سفينة فاخرة (سفينة ركاب مجهزة لحياة الترف)",
 "ごうかく": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "ごうかけんらん": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "ごうかせん": "سفينة فاخرة (سفينة ركاب مجهزة لحياة الترف)",
 "ごうかん": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب. / ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية…)",
 "ごうかんざい": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب.",
 "ごうかんはん": "مُغْتَصِب",
 "ごうかんぼく": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية…)",
 "ごうかんま": "مُغْتَصِب",
 "ごうがしゃ": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "ごうがふかい": "اسْتِثْنَائِيّ, خَارِقٌ لِلْعَادَة (يَفُوقُ المُعْتَادَ أَوِ المُتَوَقَّعَ بِكَثِير)",
 "ごうがん": "مُتَعَالٍ, الْمُتَعَالِي",
 "ごうがんぶれい": "تَكَبُّر, غُرُور",
 "ごうき": "ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة) / جَرِيء, جَسُور / رَائِع, عَظِيم\nمثال: الصين بلد عظيم.",
 "ごうきゅう": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة / صراخ, عويل (صرخات عالية أثناء البكاء) / بُكَاء",
 "ごうきょ": "مُتَعَالٍ, الْمُتَعَالِي",
 "ごうきょう": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "ごうきん": "أُشَابَة",
 "ごうきんこう": "فولاذ سبائكي (فولاذ تُحدد خصائصه بإضافة عناصر أخرى بالإضافة إلى الكربون)",
 "ごうぎ": "مُشَاوَرَة, اِسْتِشَارَة / رَائِع, عَظِيم\nمثال: الصين بلد عظيم. / مُتَعَنِّت, عَنِيد",
 "ごうぐん": "مُحَارِب قَدِيم",
 "ごうけい": "إجمالي, مجموع (الإجمالي النهائي أو الكلي)\nمثال: مجموع كل مشاكلنا لم يعادل البؤس الذي عانوه",
 "ごうけつ": "بَطَل, بَطَلَة",
 "ごうけん": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة))\nمثال: تنقل كتابته طاقة كبيرة / دُسْتُورِيَّة / بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب)",
 "ごうけんせい": "دُسْتُورِيَّة",
 "ごうけんてき": "بُنْيَوِيّ",
 "ごうこ": "عَلَنِيّ, عَامّ",
 "ごうこう": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "ごうこく": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "ごうご": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم) / اَلْإِنْجِلِيزِيَّة الْأُسْتُرَالِيَّة",
 "ごうごう": "مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ) / عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "ごうしき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "ごうしゃ": "فَخْم",
 "ごうしゅ": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية)\nمثال: عانى من نوبة صرع",
 "ごうしゅう": "أُسْتُرَالِيَا, أستراليا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة…)\nمثال: جين من أستراليا.",
 "ごうしゅうとうけいきょく": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة…)",
 "ごうじ": "ربط, عقد (عملية ربط أو توثيق الأشياء ببعضها البعض)",
 "ごうじょう": "مُتَعَنِّت, عَنِيد / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "ごうじょうがんこ": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "ごうじょうっぱり": "عِنَاد",
 "ごうじん": "تَعْذِيب",
 "ごうする": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "ごうせい": "شدة, صرامة (صرامة مفرطة)\nمثال: صرامة الشخصية / مُؤَلَّف, مُصَنَّف / اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / رَائِع, عَظِيم\nمثال: الصين بلد عظيم. / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ごうせいご": "كلمة مركبة, مركب (كلمة تتكون من أي مجموعة متنوعة من الكلمات أو الصيغ التركيبية أو اللواحق)",
 "ごうせいしゃ": "مؤلف, مركّب (مثقف يقوم بالتوليف أو يستخدم أساليب تركيبية)",
 "ごうせいしゃしん": "مونتاج صور (مونتاج يستخدم صوراً فوتوغرافية)",
 "ごうせいじゅし": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة…)\nمثال: لدي قبعه من البلاستيك .",
 "ごうせいすう": "عَدَد غَيْر أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ごうせいせんい": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "ごうせいひかく": "جلد صناعي (قماش مصنوع ليبدو مثل الجلد)",
 "ごうせいぶつ": "مُرَكَّب (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة)\nمثال: أطلقت الشرطة النار على إطارات مركبة توم.",
 "ごうせいまやく": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات…)",
 "ごうせいりつ": "مُعَامِل الصَّلَابَة, مُعَامِل القَصّ (معامل المرونة لقوة القص)",
 "ごうせいゴム": "مطاط اصطناعي (أي من المواد المرنة الاصطناعية المختلفة التي تشبه خصائصها المطاط الطبيعي)",
 "ごうせき": "تَعْذِيب",
 "ごうせつ": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "ごうせん": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "ごうぜん": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر))\nمثال: ثمل بشدة / فَخُور / مُتَعَالٍ, الْمُتَعَالِي",
 "ごうそう": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً)\nمثال: بالنسبة للفخامة والخدمة الشخصية",
 "ごうそん": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
 "ごうたん": "جَرِيء, جَسُور",
 "ごうだつ": "سَرِقَة, لُصُوصِيَّة",
 "ごうだつしゃ": "سَارِق (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك.",
 "ごうだつぶつ": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته…)\nمثال: لقد سلب مني كل شيء.",
 "ごうちょう": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "ごうちょく": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "ごうつくばり": "عِنَاد / بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "ごうてき": "سِيرَانَة / رَائِع, عَظِيم\nمثال: الصين بلد عظيم.",
 "ごうてん": "حبل البيض, كلالة (أحد شريطين حلزونيين من الأنسجة يربطان صفار البيض بالغشاء المحيط عند طرفي القشرة)",
 "ごうとう": "سَارِق (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك. / سَرِقَة, لُصُوصِيَّة\nمثال: 暴力団は強盗を計画していた。 — خططت العصابة لسرقة. / غير مكبوت, متحرر (غير مكبوت أو مقيد)\nمثال: حيوية غير مكبوتة",
 "ごうとうざい": "سَرِقَة, لُصُوصِيَّة",
 "ごうとうじけん": "سَرِقَة, لُصُوصِيَّة",
 "ごうとうはん": "سَارِق (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك.",
 "ごうとうようぎしゃ": "مُشْتَبَه بِه فِي سَرِقَة (شخص يشتبه في ارتكابه جريمة سرقة)",
 "ごうどう": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / متحد, مشترك (مصنوع أو منضم أو متحد في واحد) / تطابق, توافق (صفة الاتفاق والملاءمة)",
 "ごうどうこうい": "اِتِّفَاق, تَوَافُق",
 "ごうどうコンパ": "خَلَّاط, خَفَّاقَة",
 "ごうどうトレーニング": "إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)",
 "ごうにいってはごうにしたがえ": "عِنْدَمَا تَكُون فِي رُومَا، اِفْعَل مَا يَفْعَلَه الرُّومَان",
 "ごうにいらばごうにしたがえ": "عِنْدَمَا تَكُون فِي رُومَا، اِفْعَل مَا يَفْعَلَه الرُّومَان",
 "ごうにいればごうにしたがえ": "عِنْدَمَا تَكُون فِي رُومَا، اِفْعَل مَا يَفْعَلَه الرُّومَان",
 "ごうのふかい": "اسْتِثْنَائِيّ, خَارِقٌ لِلْعَادَة (يَفُوقُ المُعْتَادَ أَوِ المُتَوَقَّعَ بِكَثِير)",
 "ごうのもの": "مُحَارِب قَدِيم",
 "ごうはら": "مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "ごうはん": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "ごうば": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ごうばん": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "ごうひ": "تَسَبَّب / خِفِي, خِيفِي (اختفى أو صار غير مرئي؛ أصبح سريًا أو مجهولًا)\nمثال: كانت لدى سامي حياة خفية.",
 "ごうふく": "عِنَاد",
 "ごうべん": "بِرْكَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا. / مُلْتَحِم البَتَلَات (ذو تويج مكوَّن من بتلات ملتحمة كلّيًّا أو جزئيًّا على شكل أنبوب أو قمع)",
 "ごうべんがいしゃ": "شَرِكَة مُحَاصَّة",
 "ごうべんじぎょう": "شَرِكَة مُحَاصَّة",
 "ごうほう": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين) / قَانُونِيّ / إِفْرَنْجِيّ",
 "ごうほうか": "إِضْفَاء الشَّرْعِيَّة, تَقْنِين (فعل جعل الشيء قانونياً)",
 "ごうほうしゅぎ": "التزام حرفي بالقانون, قانونية حرفية (الامتثال الصارم لحرفية القانون بدلاً من روحه)",
 "ごうほうせい": "قَانُونِيَّة, مَشْرُوعِيَّة (صفة الامتثال للقانون)",
 "ごうほうたい": "مُلْتَحِم خَلَوِيّ",
 "ごうほうてき": "قَانُونِيّ\nمثال: あなたは合法的手段で行動する方がよい。 — من الأحسن لك أن تسير على الطرق القانونية.",
 "ごうほうドラッグ": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات…)",
 "ごうま": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / خَزْنَة حَدِيدِيَّة, خَزْنَة",
 "ごうまい": "إقدام, جسارة (شجاعة حازمة)",
 "ごうまん": "مُتَعَالٍ, الْمُتَعَالِي",
 "ごうまんふそん": "مُتَعَالٍ, الْمُتَعَالِي",
 "ごうまんぶれい": "وقاحة (فعل وقح يفتقر للاحترام ومسيء)",
 "ごうめ": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "ごうも": "أبداً, بتاتاً (بأدنى درجة أو بأي حال من الأحوال)\nمثال: هل أنت مهتم على الإطلاق؟ لا، على الإطلاق",
 "ごうもう": "شعرة خشنة, هلبه (شعرة صلبة)",
 "ごうもくてき": "غَرَضِيّ, مُوَجَّه نَحْوَ الهَدَف (ذو غاية وهدف محدّد)",
 "ごうもくてきせい": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع)\nمثال: نهائية الموت",
 "ごうもくてきてき": "مُنَاسِب تَمَامًا, وَثِيق الصِّلَة (بالغ الملاءمة والصلة بالموضوع بشكل لافت)",
 "ごうもん": "تَعْذِيب",
 "ごうもんきんしじょうやく": "الْأُمَم الْمُتَّحِدَة",
 "ごうもんぐ": "أداة تعذيب (أداة عقاب مصممة ومستخدمة لإلحاق التعذيب بالشخص المحكوم عليه)",
 "ごうもんだい": "مَكْتَبَة شَخْصِيَّة",
 "ごうもんとうきんしじょうやく": "الْأُمَم الْمُتَّحِدَة",
 "ごうゆう": "شَجَاعَة",
 "ごうよく": "طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
