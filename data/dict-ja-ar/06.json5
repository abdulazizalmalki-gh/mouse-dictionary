 "ぜんしゃくきん": "قَرْض, إِعَارَة",
 "ぜんしゃっきん": "قَرْض, إِعَارَة",
 "ぜんしゅう": "اَلْأُسْبُوع السّابِق",
 "ぜんしゅつ": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "ぜんしょ": "خَطَّاط",
 "ぜんしょう": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "ぜんしょうせん": "مُنَاوَشَة",
 "ぜんしん": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "ぜんしんせい": "نِظَامِيّ",
 "ぜんしんせいエリテマトーデス": "ذِئْبَة حَمْرَاء, ذِئْبَة حَمَامِيَّة مَجْمُوعِيَّة",
 "ぜんしんてき": "تَدْرِيجِيّ",
 "ぜんじ": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "ぜんじだいてき": "عَتِيق, بَالٍ (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
