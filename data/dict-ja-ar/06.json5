 "これより": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "これよりさき": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / سابقاً, في وقت سابق (في وقت أبكر؛ سابقاً)\nمثال: كنت أعرفها من قبل",
 "これより先": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / سابقاً, في وقت سابق (في وقت أبكر؛ سابقاً)\nمثال: كنت أعرفها من قبل",
 "これら": "هٰذِهِ, هٰؤُلَاءِ",
 "これ以上": "بعد الآن, مرة أخرى (في الوقت الحاضر أو من الآن فصاعداً؛ تستخدم عادة مع النفي)\nمثال: أليس لا تعيش هنا بعد الآن",
 "これ程": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "これ等": "هٰذِهِ, هٰؤُلَاءِ",
 "これ見よがし": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة)",
 "ころ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول / دُبَّاء / كرة متدحرجة (كرة أرضية تتدحرج على طول الملعب الداخلي)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً",
 "ころあい": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة / أدب, صواب (السلوك الصحيح أو المناسب)",
 "ころう": "عجوز, كبير السن (شخص متقدم في السن) / انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "ころうがんめい": "مُتَعَنِّت, عَنِيد",
 "ころおい": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "ころがし": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات)\nمثال: اتُهم بسلب السكارى في الحديقة",
 "ころがす": "دَحْرَجَ, تَدَحْرَجَ / قَلَبَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "ころがりこむ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "ころがりでる": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات))\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "ころがる": "دَحْرَجَ, تَدَحْرَجَ / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "ころく": "جَعْبَة",
 "ころげる": "سقطة, وقعة (سقوط مفاجئ من وضعية الوقوف)\nمثال: تعرض لسقطة سيئة على الجليد",
 "ころころ": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / جِدًّا, لِلْغَايَة (بدرجة عالية)\nمثال: هي مستعدة للغاية لقبول الوظيفة",
 "ころし": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ころしもんく": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها)",
 "ころしや": "قاتل مأجور, مسلح (قاتل محترف ذكر يستخدم مسدساً)",
 "ころじくうけ": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "ころす": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا. / طَابُوقَة / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية) / أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "ころっと": "بِسُهُولَة / فَجْأَةً / تَمَامًا / غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "ころばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "ころばぬさきのつえ": "اَلْوِقَايَةُ خَيْرٌ مِنَ الْعِلَاجِ",
 "ころび": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة)\nمثال: سوق هابطة / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا. / رِدَّة, اِرْتِدَاد / عجين سائل (خليط سائل أو شبه سائل، مثل الدقيق والبيض والحليب، يستخدم في الطهي)",
 "ころびね": "غفوة, نعاس (نوم خفيف متقطع)",
 "ころぶ": "اِرْتَدَّ (عن كذا: رجع عنه مردودا؛ عن الاسلام: رجع إلى الكفر بعد أن أسلم)\nمثال: ارتد سترة، فالجو بارد. / دَحْرَجَ, تَدَحْرَجَ",
 "ころも": "مَلَابِس, ثِيَاب / رِدَاء (ما يُلبَس فوق الثياب كالجُبَّة والعَبَاءَة؛ الثوب يستر الجزء الأعلى من الجسم…)\nمثال: تبدو جميلة في هذا الرداء. / تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "ころもがえ": "تَجْدِيد, إِحْيَاء",
 "ころもじらみ": "قملة الجسم (قملة طفيلية تغزو جسم البشر)",
 "ころもで": "كُمّ, رُدْن",
 "ころり": "بِسُهُولَة",
 "ころんころん": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / جِدًّا, لِلْغَايَة (بدرجة عالية)\nمثال: هي مستعدة للغاية لقبول الوظيفة",
 "ころ軸受": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "ころ軸受け": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "こわ": "مُجَفِّل, مُخِيف",
 "こわい": "مُجَفِّل / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صلب, غير مرن (مقاوم للانحناء)\nمثال: قضيب حديدي غير مرن / مُتْعَب, تَعْبَان",
 "こわいけん": "اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "こわいものしらず": "طَائِش, مُتَهَوِّر (يتسم بتجاهل متحدٍّ للخطر أو العواقب)",
 "こわいろ": "نبرة, نبرة الصوت (جودة صوت الشخص)\nمثال: بدأ بنبرة حوارية / مُشَاكهَة",
 "こわがり": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こわがる": "خَوْف, وَهَل\nمثال: خاف زيري نوعا ما.",
 "こわき": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط…)",
 "こわく": "انْبِهَار, سِحْر (القدرة على جذب اهتمام شديد)\nمثال: سحر الأطفال بحيل سحرية وفتن أخرى",
 "こわくてき": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا)",
 "こわけ": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "こわごわ": "بخوف (مع شعور بالخوف)\nمثال: هرعت أسفل الدرج بخوف",
 "こわしや": "مُدَمِّر",
 "こわす": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / تَصَادُّم",
 "こわだか": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "こわっぱ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "こわね": "نبرة, نبرة الصوت (جودة صوت الشخص)\nمثال: بدأ بنبرة حوارية",
 "こわばり": "شدة, صرامة (صرامة مفرطة)\nمثال: صرامة الشخصية",
 "こわばる": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو…)",
 "こわもてだんぱん": "حَازِم, مُتَشَدِّد (صَارِمٌ وَلَا يَقْبَلُ التَّسْوِيَةَ)",
 "こわらべ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "こわらわ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "こわれもの": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف)\nمثال: الفخار الخزفي قابل للكسر",
 "こわれやすい": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "こわれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "こん": "هَٰذَا, هَٰذِهِ / كُحْلِيّ / هَٰذَا, هَٰذِهِ / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / مُثَابَرَة / جَذْريّ / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت / عواء حاد, نباح حاد (صيحة حادة عالية النبرة (خاصة من قبل كلب)) / اِحْتِقَان / نَدْبَة, نَدْب / زَوَاج, نِكَاح / غُصَيْن\nمثال: لا تمسك العصا من الوسط.",
 "こんい": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة. / إِحْسَان",
 "こんいになる": "تَعَرَّفَ",
 "こんいろ": "كُحْلِيّ",
 "こんいん": "زَوَاج, نِكَاح",
 "こんいんかんけい": "عَلَاقَة زَوْجِيَّة (العلاقة بين الزوجة والزوج)",
 "こんいんてきれい": "السن القانوني, سن الرشد (السن الذي يعتبر فيه الأشخاص مؤهلين لإدارة شؤونهم الخاصة)",
 "こんおん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "こんかい": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "こんかく": "صيد جانبي, صيد عرضي (كائنات بحرية غير مرغوب فيها يتم صيدها في الشباك أثناء صيد أنواع أخرى)\nمثال: تقتل الآلاف من الدلافين وخنازير البحر والحيتان كجزء من الصيد العرضي كل عام",
 "こんかん": "إكليل (الحافة الواقعة بين جلد الرسغ وقرن الحافر) / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / قلنسوة الجذر (كتلة من الخلايا على شكل قمع تغطي وتحمي الطرف النامي للجذر) / قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "こんかんちりょう": "قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "こんが": "برعم مختلط (برعم ينتج أوراقًا وزهورًا معًا)",
 "こんがい": "خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج)",
 "こんがいこうしょう": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "こんがいし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こんがいせいこう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "こんがすり": "كحلي",
 "こんがり": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "こんがん": "مُرَافَعَة",
 "こんき": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / جَذْريّ",
 "こんきづよい": "دَؤُوب, مُثَابِر (يُوَاظِبُ بِهُدُوءٍ وَثَبَاتٍ خَاصَّةً فِي التَّفَاصِيلِ وَالدِّقَّة)",
 "こんきゃく": "ارتباك, حيرة (مشكلة أو ارتباك ناتج عن التعقيد)",
 "こんきゅう": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "こんきゅうしゃ": "فَقِير",
 "こんきょ": "قَاعِدَة, أَسَاس / قَاعِدَة",
 "こんきょち": "قَاعِدَة",
 "こんきょのない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "こんきょはくじゃく": "غَيْر مُؤَيَّد بِأَدِلَّة, غَيْر مُوَثَّق (غير مدعوم بأدلة أخرى)",
 "こんきよく": "بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل",
 "こんぎ": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "こんぎょう": "هٰذَا الصَّبَاح",
 "こんく": "حرمان (فعل حرمان شخص ما من الطعام أو المال أو الحقوق)",
 "こんくらべ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "こんけい": "جذمور (ساق نبات أفقية ذات براعم فوق وجذور تحت تعمل كهيكل تكاثري)",
 "こんけつじん": "مُوَلَّد, مِسْتِيزُو (شخص من أصل عرقي مختلط (خاصة من أصل أوروبي وأمريكي أصلي مختلط))",
 "こんけん": "لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)",
 "こんげん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "こんげんてき": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "こんこう": "خَلِيط / تَلْوِيث, تَلَوُّث / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "こんこつ": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "こんこん": "نَبَحَ, يَنْبَح / بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين / ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ…)\nمثال: أردى الصياد الثعلب. / بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة / جَدِّي, جَادّ",
 "こんこんちき": "شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ…)\nمثال: أردى الصياد الثعلب.",
 "こんご": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こんごう": "فاجرا (صاعقة إندرا) / صَاعِقَة / علامة الجذر (علامة تشير إلى استخراج الجذر) / خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / تَمَازُج الأَجْنَاسِ / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "こんごういんこ": "مكاو (ببغاء طويل الذيل زاهي الألوان من أمريكا الوسطى وأمريكا الجنوبية؛ من بين أكبر…)",
 "こんごうかやく": "خليط متفجر (خليط كيميائي له خصائص انفجارية)",
 "こんごうき": "خَلَّاط, خَفَّاقَة",
 "こんごうけいざい": "اقتصاد مختلط (نظام اقتصادي يجمع بين المؤسسات الخاصة والحكومية)",
 "こんごうけんご": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "こんごうご": "رطانة, لغة بدجنية (لغة مصطنعة تستخدم للتجارة بين متحدثي لغات مختلفة)",
 "こんごうしゃ": "سُنْبَاذَج",
 "こんごうしゅ": "كُوكْتَيْل, كُوكْتِيل",
 "こんごうしょ": "فاجرا (صاعقة إندرا)",
 "こんごうせき": "مَاس, أَلْمَاسَة",
 "こんごうたい": "خَلِيط",
 "こんごうのうぎょう": "زراعة مختلطة (زراعة المحاصيل والأعلاف والماشية كلها في نفس المزرعة)",
 "こんごうひりょう": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "こんごうふえ": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "こんごうぶつ": "خَلِيط",
 "こんごうやく": "علاج مضاد للفيروسات القهقرية عالي النشاط, كوكتيل دوائي (مزيج من مثبطات البروتياز تؤخذ مع مثبطات المنتسخة العكسية؛ يستخدم في علاج الإيدز…)",
 "こんごとも": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こんさい": "تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين / خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "こんさいるい": "محصول جذري (محصول يزرع لجذوره المتضخمة: مثل البنجر والبطاطس واللفت)",
 "こんざい": "خَلِيط",
 "こんざつ": "اِحْتِقَان / اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "こんし": "صَدَاق",
 "こんしき": "عُرْس, زِفَاف",
 "こんしゅつよう": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما)",
 "こんしろう": "قُنْصُل",
 "こんしん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة. / تشويش, تشويش إلكتروني (إشعاع أو عكس متعمد للطاقة الكهرومغناطيسية لغرض تعطيل استخدام العدو للأجهزة أو…)",
 "こんしんかい": "حدث اجتماعي, حفل (تجمع اجتماعي رسمي أو احتفال للناس)\nمثال: كانت الحفلة حدثاً مهماً حقاً",
 "こんじ": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / كحلي / الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "こんじき": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "こんじつ": "الْيَوْمَ, النهارده",
 "こんじょう": "حب المساعدة, طيبة (ود يتضح من خلال طبع طيب ومحب للمساعدة) / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / شَخْصِيَّة\nمثال: زيري سيء الخلق. / أزرق بروسي (لون أزرق مخضر داكن)",
 "こんじょういろ": "أزرق بروسي (لون أزرق مخضر داكن)",
 "こんじょうき": "كُحْلِيّ",
 "こんじょうなし": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こんじょうのすわった": "جريء, جريئة",
 "こんじょうまがり": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "こんじょうやき": "حرق سيجارة (أثر حرق تركته سيجارة مشتعلة)\nمثال: حرق سيجارة على حافة الطاولة",
 "こんじょうわる": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "こんすい": "غَيْبُوبَة / نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "こんせい": "اِلْتِمَاس, اِسْتِئْنَاف / مُخْتَلِط / مُتَزَامِن الوُجُود, مُتَعَايِش (موجود في نفس الوقت)",
 "こんせいきょく": "مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة)",
 "こんせいご": "رطانة, لغة بدجنية (لغة مصطنعة تستخدم للتجارة بين متحدثي لغات مختلفة) / لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "こんせいぶつ": "خَلِيط",
 "こんせいよう": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما)",
 "こんせき": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "こんせつ": "مراعٍ, مهتم بالآخرين (يظهر اهتماماً بحقوق ومشاعر الآخرين)\nمثال: أصدقاء مراعون بما يكفي ليتركونا وحدنا / الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "こんせん": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / تداخل الإشارات (وجود إشارة غير مرغوب فيها عبر اقتران عرضي) / اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "こんぜつ": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "こんぜん": "كَامِل / ما قبل الزواج (يتعلق بالأحداث التي تسبق الزواج)\nمثال: اتفاق ما قبل الزواج",
 "こんぜんけいやく": "اتفاق ما قبل الزواج (عقد يُبرم قبل الزواج أو الاتحاد المدني)",
 "こんぜんけいやくしょ": "اتفاق ما قبل الزواج (عقد يُبرم قبل الزواج أو الاتحاد المدني)",
 "こんた": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こんたん": "حَبْكَة / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)",
 "こんだく": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "こんだくえき": "مُسْتَحْلَب",
 "こんだて": "قَائِمَة, قَائِمَةُ الطَّعَام / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "こんだてひょう": "قَائِمَة, قَائِمَةُ الطَّعَام",
 "こんだんかい": "جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع / حلقة نقاش, ندوة (خطاب في اجتماع أكاديمي أو ندوة)",
 "こんち": "الْيَوْمَ, النهارده",
 "こんちは": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "こんちゃ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "こんちゅう": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية.",
 "こんちゅうがく": "عِلْم اَلْحَشَرَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こんちゅうがくしゃ": "عالم حشرات (عالم حيوان يدرس الحشرات)",
 "こんちゅうきょうふしょう": "رهاب الحشرات (خوف مرضي من الحشرات)",
 "こんちょう": "هٰذَا الصَّبَاح",
 "こんちわ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "こんてい": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / أَخ\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "こんてんぎ": "الإسطرلاب الكروي, ذات الحلق (كرة سماوية تتكون من أطواق معدنية؛ استخدمها علماء الفلك الأوائل لتحديد مواقع…)",
 "こんとう": "إِغْمَاء / أَدِيب, مُؤَدَّب",
 "こんとうがんしゅ": "تدرن التاج (مرض بكتيري يصيب النباتات (خاصة الفواكه ذات النواة والتفاحيات والعنب والورود)…)",
 "こんとく": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "こんとん": "فَوْضَى / فَوْضَوِيّ",
 "こんど": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن. / حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً / مُؤَخَّرًا",
 "こんどう": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "こんな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "こんなに": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "こんなふうに": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "こんなん": "صُعُوبَة / اسْتِحَالَة, عَدَم جَدْوَى (صفة كون الشيء غير قابل للقيام به)",
 "こんな風に": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "こんにち": "الْيَوْمَ, النهارده / مُؤَخَّرًا",
 "こんにちさま": "إله الشمس (إله يجسد الشمس أو يرتبط بها بشكل ما)",
 "こんにちてき": "عَصْرِيّ, حَدِيث",
 "こんにちでは": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "こんにちは": "آلُو, آلُوْ",
 "こんにちわ": "آلُو, آلُوْ",
 "こんにった": "الْيَوْمَ, النهارده / مُؤَخَّرًا",
 "こんにゃく": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة…)",
 "こんにゃくばん": "هيكتوغراف (ناسخة تتكون من لوحة جيلاتينية يمكن أخذ الحبر منها لعمل نسخة)",
 "こんにゃく版": "هيكتوغراف (ناسخة تتكون من لوحة جيلاتينية يمكن أخذ الحبر منها لعمل نسخة)",
 "こんにゅう": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "こんぬづわ": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "こんのいい": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة)",
 "こんのよい": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة)",
 "こんばん": "هٰذَا الْمَسَاء, اللَّيْلَ",
 "こんばんにちは": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر",
