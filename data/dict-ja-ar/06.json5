 "さんじょくき": "اَلنِّفَاس",
 "さんじょくねつ": "حمى النفاس (شكل خطير من الإنتان تصاب به المرأة أثناء الولادة أو الإجهاض (يُعزى عادةً إلى ظروف غير صحية)؛ كان واسع الانتشار سابقًا ولكنه الآن غير شائع)",
 "さんじる": "نَثَرَ, تَفَرَّقَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / شَارَكَ, سَاهَمَ",
 "さんじをおくる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "さんじん": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "さんす": "دُبّ / دُبَّة / اِحْتَمَلَ / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "さんすい": "مَنْظَر طَبِيعِيّ, مَنْظَر",
 "さんすう": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت. / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "さんすうしょうがい": "عسر الحساب (ضعف القدرة على تعلم الرياضيات المناسبة للصف الدراسي)",
 "さんすくみ": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "さんする": "دُبّ / دُبَّة / اِحْتَمَلَ / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء. / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / شَارَكَ, سَاهَمَ",
 "さんずい": "فَسَاد / كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "さんずる": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / شَارَكَ, سَاهَمَ / نَثَرَ, تَفَرَّقَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "さんずん": "بائع متجول لبضائع رديئة (بائع لبضائع رديئة) / كاتب إعلانات (شخص يكتب إعلانات الراديو أو التلفزيون)",
 "さんせい": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث. / اقتراع, حق الانتخاب (حق قانوني يكفل التصويت في الانتخابات)\nمثال: حصلت النساء الأمريكيات على حق التصويت في عام 1920 / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / حُمُوضَة / حِمْضِيّ (كونه أو يحتوي على حمض؛ محلول يحتوي على فائض من ذرات الهيدروجين (أس هيدروجيني أقل من 7)) / حَامِض, حَمْضِيّ (ذو مذاق حامض) / تَحْدِيد اَلنَّسْل / إِنْتَاج",
 "さんせいう": "مَطَر حَمْضِيّ (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "さんせいか": "تحميض, تخليل (عملية التحول إلى حمض أو التحويل إلى مادة حمضية)",
 "さんせいけつしょう": "حُمَّاض",
 "さんせいけん": "اقتراع, حق الانتخاب (حق قانوني يكفل التصويت في الانتخابات)\nمثال: حصلت النساء الأمريكيات على حق التصويت في عام 1920",
 "さんせいしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "さんせいせんりょう": "صبغة حمضية (صبغة يكون فيها الكروموفور (حامل اللون) جزءاً من أيون سالب)",
 "さんせいたすう": "غَالِبِيَّة, أَغْلَبِيّة",
 "さんせいど": "حُمُوضَة",
 "さんせき": "أراغونيت (شكل معدني من كربونات الكالسيوم البلورية؛ ثنائي الشكل مع الكالسيت)",
 "さんせん": "مُخَلَّل / شَامِيسِين",
 "さんせんそうもく": "طَبِيعَة, طبيعة",
 "さんせんべん": "صمام ثلاثي الشرف (صمام ذو ثلاث شرفات؛ يقع بين الأذين الأيمن والبطين الأيمن؛ يسمح للدم بالمرور من الأذين إلى البطين ويغلق لمنع التدفق العكسي عند انقباض البطين)",
 "さんぜん": "ثَلَاثَة آلَاف (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / باهِر / قَبْل الوِلَادَة (يحدث أو يوجد قبل الولادة)\nمثال: فترة ما قبل الولادة / باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته",
 "さんそ": "أُكْسِجِين\nمثال: 酸素が無ければ生きられない。 — لا يمكنك العيش من دون أكسجين.",
 "さんそう": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا تخفى عليه خافية، والذي لا يغفل عمّا خلق…؛ فَاعِلٌ مِنْ رَقَبَ)",
 "さんそか": "أكسجة, تزويد بالأكسجين (عملية توفير الأكسجين أو الاتحاد معه أو المعالجة به)\nمثال: أكسجة الدم",
 "さんそく": "حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم)",
 "さんそけい": "أُكْسِجِين",
 "さんそけつぼう": "انعدام الأكسجين (نقص حاد في الأكسجة؛ غياب الأكسجين في الغازات المستنشقة أو في الدم الشرياني أو في الأنسجة)",
 "さんそけつぼうしょう": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "さんそしょり": "أكسجة, تزويد بالأكسجين (عملية توفير الأكسجين أو الاتحاد معه أو المعالجة به)\nمثال: أكسجة الدم",
 "さんそてんかこうそ": "أكسيجيناز (أوكسيدوريدوكتاز يحفز دمج الأكسجين الجزيئي)",
 "さんそふさい": "دَيْن الأكسجين (عجز تراكمي في الأكسجين ناتج عن تمرين مكثف؛ يجب تعويض العجز عندما يعود الجسم للراحة)",
 "さんそマスク": "قناع أكسجين (جهاز تنفس يوضع فوق الفم والأنف؛ يزود بالأكسجين من خزان تخزين مرفق)",
 "さんぞく": "قَاطِع طَرِيق / حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم)",
 "さんたい": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "さんたくそん": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "さんたん": "بَائِس / مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / منجم فحم (منجم يُستخرج منه الفحم من الأرض)",
 "さんたんげん": "غَائِب",
 "さんだい": "تمدد, توسع (عملية توسيع فتحة) / إطناب, توسع (مناقشة مطولة (منطوقة أو مكتوبة) حول موضوع معين)\nمثال: توسع حدقة العين",
 "さんだつ": "غَصْب",
 "さんだつしゃ": "غَاصِب, مُبْتَزّ",
