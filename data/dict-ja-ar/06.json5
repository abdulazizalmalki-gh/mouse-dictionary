 "さしかわす": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "さしがさ": "مِظَلَّة, شَمْسِيَّة",
 "さしがた": "مُسْتَطِيل",
 "さしがね": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية) / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "さしがみ": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "さしがめ": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها…)",
 "さしき": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "さしきかごうぶつ": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة)",
 "さしきず": "عَضَّ, قَضَمَ",
 "さしくち": "حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان)",
 "さしくる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "さしこ": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن)",
 "さしこす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "さしこみ": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة…)",
 "さしこみぐち": "قَابِس",
 "さしこむ": "أَدْخَلَ",
 "さしさわり": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / إِزْعَاج",
 "さしさわりのない": "بَريء, غَيْر مُؤْذٍ (لا يَنْتُج عَنْه ضَرَر؛ بَريء وغَيْر خَطِر)",
 "さしさわる": "عَاقَ, عَرْقَلَ",
 "さししお": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة",
 "さししめす": "دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "さしじょう": "مِصْمَال",
 "さしず": "إرشادات\nمثال: 俺は人事課の馬鹿野郎にあごで指図されるつもりはない。 — لن يحكمني غبي من قسم الموارد البشرية.",
 "さしずにん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "さしずめ": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "さしたて": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "さしたてる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "さしたる": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "さしだしさき": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "さしだしにん": "مُرْسِل, مُرْسِلَة",
 "さしだす": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / تَضْحِيَة, قُرْبَان / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "さしつかえ": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع)",
 "さしつかえない": "مَسْمُوحٌ بِخَصْمِهِ (قابل للخصم وفقاً لقوانين الضرائب)\nمثال: سلوك مسموح به في المدرسة",
 "さしつかえる": "عَاقَ, عَرْقَلَ",
 "さしつかわす": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "さしつける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "さしつらぬく": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "さしづめ": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "さして": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "さしで": "وَجْهًا لِوَجْه",
 "さしでがましい": "صَاعِدًا",
 "さしでぐち": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر)",
 "さしでる": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا) / نَتَأَ",
 "さしとおす": "طَعْن",
 "さしとめ": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "さしとめる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "さしなわ": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن…)",
 "さしぬい": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن)",
 "さしのぞく": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "さしのべる": "تَمَدَّدَ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح\nمثال: اقترح سامي المساعدة.",
 "さしのぼる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "さしはさむ": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "さしひかえる": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "さしひき": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "さしひきかんじょう": "رَصِيد",
 "さしひく": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "さしひびく": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "さしぼう": "مُؤَشِّر",
 "さしまねく": "أَشَارَ, أَوْمَأَ",
 "さしみ": "سَاشِيمِي",
 "さしむかい": "وَجْهًا لِوَجْه",
 "さしむける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / مُبَاشِر\nمثال: تبدو شاحب الوجه.",
 "さしも": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "さしもどし": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)",
 "さしもの": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / دَبُّوس / علم الدولة (علم يظهر جنسيته)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "さしものし": "صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث)",
 "さしゅ": "غَشَّ, جَدَعَ",
 "さしゅう": "إِيصَال",
 "さしゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "さしゆるす": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)…)\nمثال: سمح لسكورة بالسباحة.",
 "さしょう": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / تَأْشِيرَة, فِيزَا / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / تحريف, تزييف (تحريف متعمد للحقائق)",
 "さしわたし": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "さしんしつ": "بطين أيسر (الحجرة على الجانب الأيسر من القلب التي تتلقى الدم الشرياني من الأذين الأيسر…)",
 "さしんぼう": "أذين أيسر (الحجرة العلوية اليسرى للقلب التي تتلقى الدم من الأوردة الرئوية)",
 "さし木": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "さし絵": "رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "さし錠": "مِصْمَال",
 "さし障る": "عَاقَ, عَرْقَلَ",
 "さじ": "مِلْعَقَة, معلقة (أداة للأكل والاحتساء والطبخ وتقديم الطعام) / تفاهة, شيء تافه (شيء قليل الأهمية)",
 "さじかげん": "جُرْعَة / مَهَارَة",
 "さじき": "شُرْفَة المَسْرَح (قسم منحني أو صف من المقاعد في قاعة أو مسرح أو دار أوبرا؛ عادة ما يكون الصف…)\nمثال: كان لديهم مقاعد ممتازة في شرفة المسرح / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "さじゅつ": "غَشَّ, جَدَعَ",
 "さじょう": "سِلْسِلِيّ, شَبِيه بِالسِّلْسِلَة (ذو شكل يُشبه السلسلة) / ذُو لِسَانَيْن, مُزْدَوِج (له معنيان بقصد الخداع)",
 "さじょうかごうぶつ": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة)",
 "さじょうのろうかく": "بَيْت مِنْ وَرَق (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "さじをなげる": "تَنَازَلَ",
 "さじを投げる": "تَنَازَلَ",
 "さじん": "عَاصِفَة رَمْلِيَّة",
 "さじんあらし": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "さじ加減": "جُرْعَة / مَهَارَة",
 "さす": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَدْخَلَ / ضحضاح ماء / ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / لَسَعَ / خَاطَ (خَطَّ، خَيطَ في إبرة أو آلة؛ وَصَلَ أو أَصَّلَ أجزاء معًا باستخدام الخيط)\nمثال: خاط سامي جيبه المثقوب. / عَمُود, قُطْب / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه. / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / أَدْخَلَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / أَغْلَقَ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "さすが": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "さすがに": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "さすけね": "عَفْوًا",
 "さすまた": "ثُنَائِيُّ الشُّعَب (ذُو شُعْبَتَيْن)",
 "さすらい": "تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به",
 "さすらう": "تَجَوَّلَ",
 "さする": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ…)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف.",
 "さすれば": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "さずかりもの": "أَنِيس, رَفِيق (قريب جداً وأليف في العشرة)\nمثال: استمتع بنعم السلام",
 "さずける": "مَنَحَ\nمثال: 聖霊がある方の上に下って、その上にとどまられるのが見えたなら、その方こそ聖霊によってバプテスマを授ける方である。 — الذي ترى الروح نازلا ومستقرا عليه فهذا هو الذي يعمد بالروح القدس. / عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "させい": "بُحَاح",
 "させき": "حَصَاة",
 "させこ": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "させる": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء…)",
 "させん": "إنزال, تخفيض الرتبة (فعل التخفيض في الرتبة أو المنصب)",
 "させんせい": "يَسَارِيّ الدَّوَرَان (يدور عكس عقارب الساعة؛ يُقال عن المواد التي تحرف مستوى الضوء المستقطَب يساراً)",
 "させんとう": "سكر الفاكهة, فركتوز (سكر بسيط يوجد في العسل وفي العديد من الفواكه الناضجة)",
 "させ子": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "さそい": "دَعْوَة, عزيمة / فِتْنَة, إِغْرَاء",
 "さそいかける": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "さそいこむ": "أَغْوَى, أَغْرَى",
 "さそいだす": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "さそいみず": "تحضير المضخة (إدخال الماء في المضخة لتحسين الختم وبدء تدفق المياه) / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "さそいをかける": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "さそう": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَغْوَى, أَغْرَى / اِسْتَفَزَّ",
 "さそり": "عَقْرَب, عَقْرَبَة",
 "さそりがため": "سكونة صيد سريعة (سكونة سريعة استخدمها صيادو نيو إنجلاند للصيد غير القانوني في المياه الكندية)",
 "さそりざ": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "さそりもどき": "عقرب سوطي (عنكبوتي غير سام يشبه العقرب وله ذيل رفيع طويل بدون إبرة)",
 "さそり座": "بُرْج اَلْعَقْرَب, اَلْعَقْرَب (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "さそん": "خَسَارَة, فِقْدَان",
 "さぞ": "بِالتَّأْكِيد",
 "さぞかし": "بِالتَّأْكِيد",
 "さぞや": "بِالتَّأْكِيد",
 "さた": "شَأْن / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / إرشادات / لَاحَظَ",
 "さたい": "ضفة رملية (ضفة مغمورة من الرمال بالقرب من الشاطئ أو في النهر؛ يمكن أن تنكشف عند الجزر…)",
 "さたのかぎり": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "さたのほか": "عَبَثِيّ, سَخِيف",
 "さたやみ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما)",
 "さたん": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / إِعْجَاب / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "さだ": "بِالتَّأْكِيد / نَكْسَة / بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "さだか": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "さだまり": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "さだむ": "قَرَّرَ, صَمَّمَ / وَصَفَ\nمثال: إنه أمر مختلف .",
 "さだめ": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر",
 "さだめし": "بِالتَّأْكِيد",
 "さだめて": "بِالتَّأْكِيد",
 "さだめない": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي))\nمثال: مستقبل غير مؤكد",
 "さだめる": "قَرَّرَ, صَمَّمَ / وَصَفَ\nمثال: إنه أمر مختلف .",
 "さち": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا! / حِصَاد\nمثال: حصد الفلاح القمح.",
 "さちある": "سَعِيد, وَرْدِيّ (ينبئ بحظ جيد وطالع حسن)\nمثال: أطفال آخرون، أقل حظاً، ماتوا",
 "さちあれ": "حَظًّا مُوَفَّقًاَ ((حَظَا) فلان حظوا: مشى رويدا)\nمثال: حظا سعيدا يا زيري.",
 "さちうす": "غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "さちうすい": "غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "さっか": "مُؤَلِّف, مُصَنِّف\nمثال: ألف شكر على لطفك. / قَصِيدَة, شِعْر / كَبْسُولة / اِنْجِرَاف",
 "さっかく": "هَلْوَسَة, وَهْم / خطأ, سوء فهم (فهم لشيء ما بشكل غير صحيح)\nمثال: لم يكن ليعترف بخطئه",
 "さっかしょう": "اِنْجِرَاف",
 "さっき": "آنِفاً / تعطش للدماء (رغبة في سفك الدماء) / مُصِيبَة, شَقْوَة / مُرَبَّعَاتٍ / مِكْشَطة (أي من الأدوات اليدوية المختلفة للكشط)",
 "さっきゅう": "فَوْرِيّ",
 "さっきょ": "تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "さっきょう": "مَحْصُول",
 "さっきょく": "مُؤَلَّف, مُصَنَّف",
 "さっきょくか": "مُلَحِّن",
 "さっきょくしゃ": "مُلَحِّن",
 "さっきん": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى…)",
 "さっきんざい": "مُطَهِّر",
 "さっきんしょうどくき": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم…)",
 "さっきんしょうどくざい": "مُطَهِّر",
 "さっくり": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب)\nمثال: أخذ الأمر باستخفاف / بِسُهُولَة",
 "さっこう": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…)",
 "さっこん": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام / تخطيط شريطي, تريط (شريط أو أشرطة ذات لون مغاير)\nمثال: تظهر الكروموسومات شرائط مميزة",
 "さっさつ": "سرقة الماشية (سرقة الماشية)",
 "さっさと": "بِسُرْعَة, عَاجِلًا / بلامبالاة (مع اللامبالاة؛ بطريقة غير مبالية)\nمثال: هزت كتفيها بلامبالاة",
 "さっし": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها / فُرْشَاة\nمثال: مشط شعرك قبل أن تخرج.",
 "さっしたい": "مورفيم مقيد",
 "さっしょう": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / اِنْجِرَاف",
 "さっしょうのうりょく": "إِمَاتَة, فَتْك (صفة كون الشيء مميتاً)",
 "さっしょうりょく": "إِمَاتَة, فَتْك (صفة كون الشيء مميتاً)",
 "さっしょぶん": "مرفوض, منبوذ (الشخص أو الشيء الذي يتم رفضه أو تنحيته جانباً لكونه أقل جودة)",
 "さっしん": "إِصْلَاح",
 "さっす": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "さっする": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "さっするに": "الْمُفْتَرَض مِنْ",
 "さっせい": "وَشْم",
 "さっそう": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل)",
 "さっそく": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "さっそくですが": "أَنَا أَعْرِفُ",
 "さった": "بُودِيسَاتْفَا",
 "さっち": "حَاسَّة\nمثال: لديهم حس الفكاهة.",
 "さっちゅうざい": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "さっちょこだち": "وقوف على اليدين (فعل دعم النفس باليدين فقط في وضع مقلوب)",
 "さっと": "بِسُرْعَة, عَاجِلًا / فَجْأَةً",
 "さっとう": "اِنْدَفَعَ, أَسْرَعَ",
 "さっぱり": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / إِفْرَنْجِيّ / تَمَامًا / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "さっぷうけい": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي)",
 "さっぷざい": "بودرة تجميل, بودرة جسم (مسحوق ناعم لنشره على الجسم (كما بعد الاستحمام))",
 "さっぽろ": "سَابُورُو",
 "さつ": "شُرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي. / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟ / بَنْكْنُوت, وَرَقَة نَقْدِيَّة / مَعْبَد / طِبَاعَة",
 "さついれ": "مِحْفَظَة, حَافِظَة",
 "さつえい": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "さつえいかんとく": "مشغل كاميرا, مصور سينمائي (مصور يشغل كاميرا سينمائية)",
 "さつえいき": "كاميرا سينمائية (كاميرا تلتقط سلسلة من الصور الفوتوغرافية التي يمكن أن تعطي وهم الحركة عند عرضها…)",
 "さつえいしゃ": "مُصَوِّر, مُصَوِّرَة",
 "さつえいだいほん": "سيناريو التصوير (النص التفصيلي النهائي لصنع فيلم أو برنامج تلفزيوني)",
 "さつがい": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا.",
 "さつがいしゃ": "قَاتِل, قَاتِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "さつがいよこく": "تَهْدِيد بِالْقَتْل",
 "さつげんがっき": "آلة وترية ذات قوس, وتريات (آلات وترية يُعزف عليها بقوس)\nمثال: عزفت الوتريات بشكل رائع للغاية",
 "さつしょぶん": "مرفوض, منبوذ (الشخص أو الشيء الذي يتم رفضه أو تنحيته جانباً لكونه أقل جودة)",
 "さつしんきんやく": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها)",
 "さつじん": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "さつじんき": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني)",
 "さつじんざい": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "さつじんしゃ": "قَاتِل (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "さつじんてき": "رَهِيب, فَظِيع",
 "さつじんとう": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "さつじんはん": "قَاتِل, قَاتِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "さつじんロボット": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "さつせいしざい": "مبيد النطاف (عامل مانع للحمل يقتل الحيوانات المنوية)",
 "さつせいしやく": "مبيد النطاف (عامل مانع للحمل يقتل الحيوانات المنوية)",
 "さつぞう": "تصوير طبي, تصوير مقطعي ((طب) الحصول على صور لداخل الجسم)\nمثال: كان لا يزال يسمعها في خياله",
 "さつぞうき": "كَمِرَة, كَامِيرَا",
 "さつばつ": "فَظّ, قَاسِي الصَّرَاحَة (مُبَاشِر وَدَقِيق بِشَكْلٍ مُنَفِّر)",
 "さつひと": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "さつびら": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "さつま": "ساتسوما (يوسفي متوسط الحجم خالٍ من البذور إلى حد كبير ذو قشرة رقيقة ملساء) / بَطَاطَا حُلْوَة",
 "さつまあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "さつまいも": "بَطَاطَا حُلْوَة",
 "さつまスティック": "بَطَاطَا حُلْوَة",
 "さつま揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "さつま芋": "بَطَاطَا حُلْوَة",
 "さつよう": "لَخَّصَ, اِخْتَصَرَ",
 "さつりく": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون…)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "さつりょう": "لَفَّ, غَلَّفَ",
 "さて": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "さてい": "تَقْيِيم",
 "さていかかく": "تثمين, تقدير (تقدير لقيمة شيء ما)\nمثال: وضع تقييماً عالياً للصداقة",
 "さていしゃ": "شركة تأمين, مؤمّن (مؤسسة مالية تبيع بوليصات التأمين)",
 "さてこそ": "مِنْ أجْلِ ذَلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "さてつ": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "さては": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا. / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "さても": "عَجَبًا\nمثال: سبحان الله عما يشركون.",
 "さてん": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "さと": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة. / رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير. / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "さとい": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "さといも": "قُلْقَاس",
 "さとう": "شَارِب / يَسَارِيّ / سُكَّر (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر. / تَدَرُّج",
 "さとういれ": "سُكَّرِيَّة",
 "さとうかえで": "قيقب سكري, قيقب صخري (قيقب من شرق ووسط أمريكا الشمالية له أوراق ثلاثية إلى خماسية الفصوص وخشب صلب…)",
 "さとうがし": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "さとうきび": "قصب السكر (عشب استوائي طويل من جنوب شرق آسيا ذو سيقان مفصلية ليفية قوية؛ عصارته مصدر رئيسي…)",
 "さとうきびとう": "سكر القصب (سكر من قصب السكر يستخدم كعامل تحلية)",
 "さとうきび糖": "سكر القصب (سكر من قصب السكر يستخدم كعامل تحلية)",
 "さとうごろも": "تغليفة سكرية, كريمة التزيين (طبقة سكرية مُنكهة تُستخدم لتغطية وتزيين الكعك)",
 "さとうだいこん": "شَمَنْدَر اَلسُّكَّر",
 "さとうに": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "さとうにんじん": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ…)\nمثال: ضع الجزر في القدر.",
 "さとうのころも": "تغليفة سكرية, كريمة التزيين (طبقة سكرية مُنكهة تُستخدم لتغطية وتزيين الكعك)",
 "さとうみつ": "شَرَاب, قَطْر",
 "さとうもろこし": "سورغم حلو, سورغو (أي من عدة أنواع من السورغم تزرع كمصدر للشراب)",
 "さとうやし": "غوموتي, نخيل السكر (نخيل ريشي ماليزي قاعدته مغطاة بكثافة بالألياف؛ ينتج عصارة حلوة تستخدم في النبيذ…)",
 "さとう入れ": "سُكَّرِيَّة",
 "さとおや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً) / مُحَافِظ",
 "さとがえり": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "さとがえりしゅっさん": "وضع, ولادة (عملية الولادة)",
 "さとご": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "さとごころ": "حَنِين, اِشْتِيَاق",
 "さとし": "إِرْشَاد, هِدَايَة",
 "さとす": "نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "さとびと": "قَرَوِيّ, قَرَوِيَّة",
 "さとむら": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
 "さとり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / تَنْوِير / ساتوري",
 "さとる": "حَاسَّة\nمثال: لديهم حس الفكاهة. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "さど": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل.",
 "さどう": "عَمَلِيَّة, عَمَل / سَادُو, طُقُوس اَلشَّاي / تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً)\nمثال: معاملة تفاضلية",
 "さどうそうち": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات…) / محرك ميكانيكي, مشغل (آلية تضع شيئاً ما في حالة عمل تلقائي)",
 "さどうちゅう": "قَيْدَ الاِسْتِخْدَام (يُسْتَخْدَمُ حَالِيًّا)",
 "さどうはぐるま": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات…)",
 "さどうはぐるまそうち": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات…)",
 "さどく": "تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً",
 "さどくしゃ": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "さながら": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "さなき": "ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين)\nمثال: الخطيبان",
 "さなぎ": "خَادِرَة",
 "さなくは": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "さなくば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "さなご": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "さなだ": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته)",
 "さなだあみ": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته)",
 "さなだひも": "ضَفَّرَ, ضَفَرَ",
 "さなだむし": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "さなだ虫": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "さにわ": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان. / مُتَوَسِّط",
 "さね": "بِذْرَة, زَرِّيعَة / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان. / بَظْر / نِوَاة",
 "さのう": "الدماغ الأيسر, نصف الكرة الأيسر (نصف الكرة المخية إلى يسار الجسم الثفني الذي يتحكم في النصف الأيمن من الجسم) / قَانِصَة / كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن)",
 "さのみ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "さは": "الجناح اليساري, اليسار (أولئك الذين يدعمون درجات متفاوتة من التغيير الاجتماعي أو السياسي أو الاقتصادي…)",
 "さはい": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "さはいにん": "وكيل أراضي (شخص يدير عقاراً من الأراضي)",
 "さはち": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق…) / تنسيق الزهور (ترتيب زخرفي للزهور)",
 "さはんじ": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "さば": "إِسْقُمَرِيّ / خَادِم",
 "さばかり": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "さばき": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية)\nمثال: التعامل مع السجناء / إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "さばきのにわ": "مَحْكَمَة, عَدْلِيَّة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "さばく": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / جُزْء, جُزَء\nمثال: في أي دور تسكن؟ / صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة…)\nمثال: عاد إلى الصحراء.",
 "さばくか": "تَصَحُّر",
 "さばぐも": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه…)",
 "さばけぐち": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "さばさば": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما) / إِفْرَنْجِيّ",
 "さば雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه…)",
 "さび": "باتينا, صدأ النحاس (طبقة رقيقة من الأكسيد (تنتج عن الأكسدة على مدى فترة طويلة من الزمن) على سطح…)\nمثال: طبقة من الصقيع / صَدَأ / خَطَّاف / وَسَابِي",
 "さびいろ": "صَدَأ",
 "さびきん": "صَدَأ",
 "さびさび": "حَزِين, زعلان / صدئ, مصدأ (تراكم عليه الصدأ)\nمثال: مفصلات صدئة",
 "さびしい": "وَحِيد, مُوحِش / مُقْفِر, مَهْجُور / حَزِين, زعلان / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "さびしさ": "اِنْفِرَاد",
 "さびつく": "صَدَأ",
 "さびびょう": "صَدَأ",
 "さびる": "صَدَأ",
 "さびれる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "さび病": "صَدَأ",
 "さび色": "صَدَأ",
 "さび菌": "صَدَأ",
 "さぶ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "さぶい": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا. / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "さぶいぼ": "قشعريرة, منعكس محرك للشعر (انتصاب انعكاسي لشعر الجلد استجابة للبرد أو الضغط العاطفي أو تهيج الجلد)",
 "さぶらい": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان)",
 "さぶらう": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "さぶん": "فَرْق, اِخْتِلَاف",
 "さへん": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث…)",
 "さべ": "قَضِيب, ذَكَر",
 "さべつ": "تَمْيِيْز / تَفْرِيق",
 "さべつか": "تفاضل (العملية الرياضية للحصول على مشتق دالة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "さべつしゅぎしゃ": "مُتَعَصِّب",
 "さべつてき": "تَفْضِيلِيّ, تَمْيِيزِيّ (يُظهر تحيزاً أو محاباة)\nمثال: قاضٍ متحيز",
 "さほう": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "さほうたん": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "さほど": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "さぼう": "مَقْهًى, دَار شَاي (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ…)\nمثال: هذا المقهى مريح. / أذين أيسر (الحجرة العلوية اليسرى للقلب التي تتلقى الدم من الأوردة الرئوية)",
 "さぼり": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "さま": "سيد (صيغة خطاب للرجل) / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة)",
 "さまかた": "عِنَايَة, رِعَايَة",
 "さまがた": "عِنَايَة, رِعَايَة",
 "さまがわり": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "さまがわる": "تَحَوَّلَ, مَسَخَ (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "さまざま": "مُخْتَلِف, مُتَنَوَّع",
 "さまし": "غَشَّ",
 "さます": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ) / أَفْسَدَ\nمثال: دلل سامي صديقته. / بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا. / أَفْسَدَ\nمثال: دلل سامي صديقته.",
 "さまたげ": "إعاقة (الوقوف في طريق شخص ما)\nمثال: عرقلة سير العدالة",
 "さまたげる": "مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "さまつ": "تافِه",
 "さまねし": "مُتَكَرِّر",
 "さまや": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "さまよいあるく": "تَجَوَّلَ",
 "さまよい歩く": "تَجَوَّلَ",
 "さまよう": "بوتر, مضرب الإسقاط (المضرب الحديدي المستخدم عادة في المنطقة الخضراء للإسقاط)",
 "さまよえる": "تجوال, رومينغ",
 "さまよえるオランダじん": "الْهُولَنْدِي الطَّائِر",
 "さまよえるオランダ人": "الْهُولَنْدِي الطَّائِر",
 "さまよえるユダヤじん": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "さまよえるユダヤ人": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "さま師": "غَشَّ",
 "さみしい": "وَحِيد, مُوحِش / مُقْفِر, مَهْجُور / حَزِين, زعلان / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "さみせん": "شَامِيسِين",
 "さむ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "さむい": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا. / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "さむからしめる": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة)\nمثال: سرت فيه رعشة مفاجئة",
 "さむけ": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة)\nمثال: سرت فيه رعشة مفاجئة",
 "さむさ": "بُرُودَة",
 "さむざむ": "شَتَوِيّ / قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً)",
 "さむざむしい": "قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً)",
 "さむぞら": "طقس بارد (فترة من الطقس البارد بشكل غير عادي)",
 "さむらい": "مُحَارِب, مُقَاتِل",
 "さむらう": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "さめ": "لُخْم\nمثال: سمكة ميناد ماتت",
 "さめがわ": "جلد القرش (قماش ناعم هش الملمس)",
 "さめざめ": "بِهُدُوء",
 "さめはだいもり": "سمندل خشن الجلد (سمندل من الساحل الرطب من ألاسكا إلى جنوب كاليفورنيا)",
 "さめやらぬ": "تريث, تلكؤ (فعل التريث أو البقاء لفترة أطول)",
 "さめる": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ) / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "さも": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا . / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "さもあらばあれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "さもしい": "حَزين",
 "さもじ": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "さもないと": "خِلَافَ, خِلَافَ ذَلِك",
 "さもなくば": "خِلَافَ, خِلَافَ ذَلِك",
 "さもなければ": "خِلَافَ, خِلَافَ ذَلِك\nمثال: 急ぎなさい、さもなければ遅れますよ。 — أسرع، وإلا فإنك ستتأخر.",
 "さもん": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / علامة تموج (واحدة من سلسلة من الحواف الصغيرة الناتجة في الرمال بواسطة التيارات المائية أو…)",
 "さや": "غِمْد, غِلَاف / قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس…)\nمثال: لقد اشترى قبعة. / هَامِش / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حاوية وقود قابلة للفصل (حاوية وقود قابلة للفصل في الطائرة) / بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح / بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب",
 "さやいんげん": "فَاصُولِيَاء",
 "さやえんどう": "بازلاء ثلجية, بازلاء سكرية (بازلاء خضراء ذات قرون مسطحة صالحة للأكل)",
 "さやか": "شَفَّاف",
 "さやとり": "مراجحة (نوع من الاستثمار المحوط يهدف إلى الاستفادة من الفروق الطفيفة في السعر؛ عندما…) / بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله)",
 "さやま": "كَثِيب, غُرْد",
 "さやまめ": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس))",
 "さゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "さゆう": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟ / جَانِب / مراوغة, مواربة (التزييف عن طريق لغة غامضة أو ملتبسة)",
 "さゆうそうしょう": "تَنَاظُر",
 "さゆうたいしょう": "تناظر ثنائي, تناظر جانبي (خاصية التناظر حول مستوى عمودي)",
 "さゆうとっしゅつぶ": "بروز الحرف (جزء من الحرف المعدني الذي يبرز خارج جسمه)",
 "さゆり": "زَنْبَق, سَوْسَن",
 "さよ": "مَسَاء",
 "さよう": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "さようきじょ": "آلية عمل, حركة (الجزء التشغيلي الذي ينقل الطاقة إلى آلية)\nمثال: كان للبيانو حركة صلبة جداً",
 "さようそ": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه)\nمثال: مشغل لوحة المفاتيح",
 "さようたいしょう": "الكمية المحسوبة, مُعامَل (كمية يتم إجراء عملية رياضية عليها)",
 "さようなら": "وَدَاع\nمثال: قال زيري وداعا.",
 "さようはんさようのほうそく": "قانون الفعل ورده الفعل, قانون نيوتن الثالث (لكل فعل رد فعل مساوٍ له في المقدار ومعاكس له في الاتجاه)",
 "さよかく": "مُدَّة",
 "さよきょく": "ديفرتيمنتو, سيريناد (تأليف موسيقي في عدة حركات؛ ليس له شكل ثابت)",
 "さよく": "الجناح اليساري, اليسار (أولئك الذين يدعمون درجات متفاوتة من التغيير الاجتماعي أو السياسي أو الاقتصادي…) / الحقل الأيسر (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأيسر من…)",
 "さよくけい": "يَسَارِيّ",
 "さよくしゅ": "لاعب الدفاع الأيسر (الشخص الذي يلعب في الجانب الأيسر من الملعب الخارجي)",
 "さよくとう": "يَسَارِيّ",
 "さよなか": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل",
 "さよなきどり": "عَنْدَلِيب, بلبل",
 "さよなら": "مَعَ السَّلَامَة, إِلَى اللِّقَاء (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / وَدَاع\nمثال: قال زيري وداعا.",
 "さよならあんだ": "ضربة آمنة, ضربة قاعدة ((في البيسبول) العمل الناجح لضرب الكرة بطريقة تمكن الضارب من الوصول إلى القاعدة…)",
 "さよならハッピーバースデイ": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "さよならミスワイコフ": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "さよーなら": "وَدَاع\nمثال: قال زيري وداعا.",
 "さら": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما)\nمثال: قبل تبليغ الاستدعاء / شَاؤُول, طَالُوت / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / بَدِيهِيّ, بَدَهِيّ",
 "さらあらい": "تنظيف ما بعد الأكل, غسل الأواني (غسل الأطباق وما إلى ذلك بعد تناول وجبة)",
 "さらあらいき": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة…)\nمثال: تعطلت الغسالة مجددا.",
 "さらい": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "さらう": "جرافة, كراكة (مجرفة آلية لإزالة المواد من قناة أو قاع نهر) / إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة / اِحْتَكَرَ",
 "さらえる": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "さらけだす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "さらけ出す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "さらさら": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / بسلاسة (بدون مشاكل أو صعوبات)\nمثال: نفذ الخطط بسرعة وسلاسة / حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير) / أبداً",
 "さらし": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / دوكسينغ, كشف الهوية (نشر المعلومات الشخصية لشخص ما على الويب بقصد التسبب في المضايقة)",
 "さらしこ": "جير مكلور, مسحوق تبييض (مسحوق أبيض يتكون من هيدروكسيد الكالسيوم والكلوريد وهيبوكلوريت ويستخدم للتبييض…)",
 "さらしだい": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها…)",
 "さらしなしょうま": "بق باني, طارد البق ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر…)\nمثال: قد غزا بق الفراش فرنسا.",
 "さらしなそば": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "さらし台": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها…)",
 "さらし粉": "جير مكلور, مسحوق تبييض (مسحوق أبيض يتكون من هيدروكسيد الكالسيوم والكلوريد وهيبوكلوريت ويستخدم للتبييض…)",
 "さらじゅ": "شَاؤُول, طَالُوت",
 "さらす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن…) / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "さらずとも": "بِالرَغْم مِن",
 "さらそうじゅ": "شَاؤُول, طَالُوت",
 "さらっと": "بسلاسة (بدون مشاكل أو صعوبات)\nمثال: نفذ الخطط بسرعة وسلاسة / بشكل مباشر, بصراحة (مباشرة وبدون مراوغة؛ ليس بشكل ملتوٍ)\nمثال: لمواجهة مشكلة بصراحة",
 "さらとい": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "さらなり": "طَبْعًا",
 "さらなる": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "さらに": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "さらにもっと": "وأكثر من ذلك (وأكثر بكثير بالإضافة إلى ذلك)\nمثال: كلفني راتب أسبوع وأكثر من ذلك",
 "さらば": "وَدَاع\nمثال: قال زيري وداعا. / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "さらばかり": "رَصِيد",
 "さらばキューバ": "كُوبَا (دولة في منطقة البحر الكاريبي؛ اسمها الرسمي جمهورية كوبا، وعاصمتها هافانا)\nمثال: لدي الآس الكوبا.",
 "さらゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "さらり": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير) / رَفِيع, رَقِيق",
 "さりいく": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "さりぎわ": "رَحِيل, مُغَادَرَة",
 "さりげ": "هَٰكَذَا, كَذَا",
 "さりげない": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "さりげに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "さりとて": "بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "さりながら": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "さりゃく": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "さりゆく": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "さりょう": "مَطْعَم",
 "さり乍ら": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "さり気": "هَٰكَذَا, كَذَا",
 "さり気ない": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "さり気に": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "さる": "سَعْدَان, قِرْد / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / طَلَاق, تَطْلِيق\nمثال: طلق زيري زوجته. / خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "さるおがせ": "لحية العجوز, ياسمين بري فرجيني (نبات متسلق شائع في شرق أمريكا الشمالية يمتد فوق النباتات الأخرى ويحمل عناقيد…)",
 "さるがくざ": "منظمة مهنية, نقابة مهنية (منظمة مكونة من مهنيين وتعمل لصالحهم)",
 "さるぐつわ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ)\nمثال: روى نكتة مضحكة جداً",
 "さるさ": "سارساباريلا (مشروب غازي منكه بمستخلص من جذر السارساباريلا أو بزيت البتولا والسسافراس)",
 "さるしばい": "مبالغة في التمثيل (تمثيل رديء من قبل ممثل مبالغ)",
 "さるすべり": "تمرحنة, وردية الكريب (شجيرة زينة من شرق الهند تزرع بكثرة في جنوب الولايات المتحدة)",
 "さるなし": "أكتينيديا حادة, كيوي هاردي (كرمة آسيوية متسلقة لها أوراق طويلة مسننة بدقة وعناقيد من الزهور البيضاء تليها…)",
 "さるのこしかけ": "بوليبور, فطر متعدد المسام (فطريات مسامية خشبية؛ أي فطر من فصيلة بوليبوراسيا أو فصيلة بوليتاسيا يكون سطحه…)",
 "さるぼお": "جيب شدقي (جيب غشائي داخل فم العديد من القوارض (مثل الغوفر))",
 "さるまね": "القرد يرى، القرد يفعل\nمثال: 猿まねはやめろ。 — لا تَكن مقلّداً.",
 "さるめんかじゃ": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "さるめんかんじゃ": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "さるもく": "رَئِيسِيَّات",
 "さるもの": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "さる者": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "されき": "حَصَاة",
 "されこうべ": "جُمْجُمَة",
 "されど": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "されども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "されば": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "さればこそ": "يَعْنِي, أَي / بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد",
 "される": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / طَقْس, جَوّ",
 "さろう": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "さわ": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "さわかい": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)",
 "さわがしい": "صَارِخ, صاخِب / مُتَلَاطِم, مُضْطَرِب ((لسائل) مُحرَّك بعنف؛ في حالة اضطراب وتلاطم)",
 "さわがす": "أَزْعَجَ",
 "さわがせる": "إِنْذَار",
 "さわぎ": "جلبة, صخب (ضجيج مرتبك عالٍ من مصادر عديدة)",
 "さわぎたてる": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "さわぐ": "حَفِيف / جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد / ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "さわさわ": "سرقة الماشية (سرقة الماشية)",
 "さわし": "فنان احتيال (نصاب يستغل ثقة ضحيته)",
 "さわす": "غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق)",
 "さわち": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق…) / تنسيق الزهور (ترتيب زخرفي للزهور)",
 "さわやか": "طَازَج, طَازَة / شَفَّاف",
 "さわり": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / ضَرَرٌ / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…) / تحسس\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب. / أبرز نقطة, ذروة (الجزء الأكثر إمتاعًا في تجربة معينة)\nمثال: كان عزف البوق المنفرد هو أبرز نقطة في الحفل / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "さわりがね": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "さわる": "عَاقَ, عَرْقَلَ / لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي! / اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني. / عَاقَ, عَرْقَلَ",
 "さわん": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "さわんとうしゅ": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "さをつける": "مَيَّزَ",
 "さん": "سيد (صيغة خطاب للرجل) / حَامِض / تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء) / ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / مِدْحَة, إِثْنَاء / نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / ترجمة آلية (استخدام الحواسيب للترجمة من لغة إلى أخرى) / مَعْبَد / وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / أَصْلِيّ / أُصُول / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / عارضة, قطعة عرضية (دعامة مستعرضة) / دَرَجَة / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات / باهِر / تناول العشاء (فعل تناول وجبة العشاء) / مُذْهِل, مُفْزِع (يسبب الذعر والفزع)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "さんい": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة) / ثَالُوث / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض. / غَصْب",
 "さんいつ": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "さんいん": "مُسْتَشْفَى وِلَادَة (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "さんいんせん": "مَجْلِس عُلْوِيّ",
 "さんえん": "ملح صخري, هاليت (كلوريد الصوديوم البلوري الموجود طبيعياً)",
 "さんえんきさん": "حمض ثلاثي القاعدية (حمض يحتوي على ثلاث ذرات هيدروجين قابلة للاستبدال في كل جزيء)",
 "さんえんきしじやく": "كاشف حمض-قاعدة, مؤشر الرقم الهيدروجيني (مؤشر يتغير لونه عند الانتقال من المحاليل الحمضية إلى القاعدية)",
 "さんえんきへいこう": "توازن الحمض والقاعدة ((في علم وظائف الأعضاء) التوازن الطبيعي بين الأحماض والقلويات في الجسم)\nمثال: مع وجود توازن طبيعي للحمض والقاعدة في الجسم، يكون الدم قلويًا قليلاً",
 "さんおんとう": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "さんか": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / بَلَاء, بُؤْس / طب التوليد, قبالة (فرع الطب المعني بالولادة ورعاية الأم) / تَأْبِين, أُمْدُوحَة / أكسدة (عملية التأكسد؛ إضافة الأكسجين إلى مركب مع فقدان الإلكترونات؛ وتحدث دائماً…) / شاليه / رَقَم الحُمُوضَة, قِيمَة حَمْضِيَّة ((في الكيمياء) كمية الحمض الحر الموجودة في الدهون مقاسة بملليغرامات هيدروكسيد…)",
 "さんかあえん": "أكسيد الخارصين, أكسيد الزنك (أكسيد الزنك؛ مسحوق أبيض يستخدم كصبغة أو في مستحضرات التجميل أو الزجاج أو…)",
 "さんかい": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ))\nمثال: زاد الحضور بنسبة 50 في المائة / رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / طبيب توليد (طبيب متخصص في التوليد) / نَجْد (مصدر للفعل \"نَجَدَ\"؛ إقليم يشكِّل وسط المملكة العربية السعودية الجغرافي، حيث…)\nمثال: علينا أن نجد حلا.",
 "さんかいし": "طبيب توليد (طبيب متخصص في التوليد)",
 "さんかいしゃ": "حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "さんかいせい": "لِلشَّبَاب, لِلنَّاشِئَة (يشمل الأشخاص اليافعين أو مُعَدّ لهم)\nمثال: هي أصغر مني بسنتين",
 "さんかかんげん": "أكسدة واختزال (تفاعل كيميائي عكسي يكون فيه أحد التفاعلين أكسدة والعكسي اختزالاً)",
 "さんかかんげんこうそ": "أوكسيدوريدوكتاز (إنزيم يحفز الأكسدة والاختزال)",
 "さんかかんげんはんのう": "أكسدة واختزال (تفاعل كيميائي عكسي يكون فيه أحد التفاعلين أكسدة والعكسي اختزالاً)",
 "さんかがく": "طب التوليد, قبالة (فرع الطب المعني بالولادة ورعاية الأم)",
 "さんかがた": "تَشَارُكِيّ (يُتِيحُ فُرْصَةَ المُشَارَكَةِ الفَرْدِيَّة)",
 "さんかく": "مُثَلَّث / مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "さんかくかんけい": "مُثَلَّث حُبّ, ثُلَاثِيَّة حُبّ",
 "さんかくかんすう": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "さんかくきん": "حمالة الذراع, وشاح طبي (ضمادة لدعم الساعد المصاب؛ تتكون من قطعة قماش مثلثة عريضة تتدلى حول الرقبة) / عِصَابَة, عِصَابَةُ رَأْس / دَالِيّ الشَّكْل, مُثَلَّثِيّ (مُثلَّث أو يُوحي بشكل مُثلَّث مع نقطة في القمّة)",
 "さんかくけい": "مُثَلَّث",
 "さんかくこう": "مَصَبّ, فُغْرَة",
 "さんかくこつ": "عظم مثلثي (عظم رسغي يتمفصل مع العظام الحمصية والكلابية والهلالية)",
 "さんかくごと": "قيثارة مثلثة (قيثارة مثلثة الشكل من اليونان وروما القديمة)",
 "さんかくざ": "مُثَلَّث",
 "さんかくじょうぎ": "مُثَلَّث",
 "さんかくす": "دِلْتَا (مثلث كحرف الدال اليوناني)",
 "さんかくそくりょう": "تثليث, حساب المثلثات (طريقة للمسح؛ يتم تقسيم المنطقة إلى مثلثات ويتم قياس طول جانب واحد وزواياه مع…)",
 "さんかくちゅう": "منشور مثلثي (منشور قاعدتاه مثلثات)",
 "さんかくとうそう": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف)",
 "さんかくほう": "عِلْم اَلْمُثَلَثَات, عِلْم حِسَاب اَلْمُثَلَثَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "さんかくぼう": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف)",
 "さんかくぼうし": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف)",
 "さんかくよく": "جناح دلتا, طائرة بجناح دلتا (طائرة ذات أجنحة تمنحها مظهر مثلث متساوي الساقين)",
 "さんかくりゅう": "تَرَيْسِيرَاتُوپْس",
 "さんかくバラ": "ضلوع قصيرة من الكتف (تقع بين منطقة التشاك (الكتف) والبريسكت (الصدر))",
 "さんかく座": "مُثَلَّث",
 "さんかこうそ": "أوكسيداز (أي من الإنزيمات التي تحفز الأكسدة البيولوجية)",
 "さんかざい": "مؤكسد",
 "さんかしゃ": "مُشَارِك",
 "さんかじゆう": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / اِخْتِيَارِيّ",
 "さんかすう": "حَالَة الْأَكْسَدَة, عَدَد الْأَكْسَدَة (درجة أكسدة ذرة أو أيون أو جزيء؛ بالنسبة للذرات أو الأيونات البسيطة، يساوي عدد…)\nمثال: عدد الأكسدة للهيدروجين هو +1 وللأكسجين هو -2",
 "さんかた": "مُياوِم",
