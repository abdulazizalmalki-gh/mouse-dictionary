 "こだいまい": "أرز بري (حبوب عشب مائي من أمريكا الشمالية)",
 "こだいむらさき": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "こだいもうそう": "جنون العظمة, ميغالومانيا (حالة نفسية تتميز بأوهام العظمة)",
 "こだいもうそうきょう": "جنون العظمة, ميغالومانيا (حالة نفسية تتميز بأوهام العظمة)",
 "こだいエジプト": "مِصْر اَلْقَدِيمَة (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر…)\nمثال: ولد سامي في مصر.",
 "こだいギリシア": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها…)\nمثال: أنا من اليونان.",
 "こだいギリシアご": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "こだいギリシャ": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها…)\nمثال: أنا من اليونان.",
 "こだいギリシャご": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "こだいローマ": "رُومَا الْقَدِيمَة (ولاية إيطالية؛ مدينة هي عاصمة ولاية روما الإيطالية)\nمثال: روما مدينة قديمة.",
 "こだかいおか": "أكمة, رابية (تل طبيعي صغير)",
 "こだから": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "こだき": "انهيمار, وابل (هطول مفاجئ (للدموع أو الشرر وما إلى ذلك) يشبه زخات المطر)\nمثال: وابل صغير من بتلات الورد",
 "こだち": "بستان, غابة صغيرة (حديقة تتكون من خشب مزروع صغير بدون شجيرات سفلية)",
 "こだて": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / مَجْلِس",
 "こだね": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / نُطْفَة, حَيَوَان مَنَوِيّ (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ)",
 "こだま": "صَدًى / قطرة, كرية (كرة صغيرة)",
 "こだら": "سمك الحدوق, سمك القد (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "こだわり": "هَوَس / تَذَمَّرَ, اِشْتَكَى / اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "こだわる": "صخب, ضجة (اضطراب نشط وسريع)\nمثال: لم يرد إثارة جلبة / أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه)\nمثال: أصر على الأفضل.",
 "こち": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هَٰذَا, هَٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / رياح شرقية (رياح تهب من الشرق)",
 "こちかぜ": "رياح شرقية (رياح تهب من الشرق)",
 "こちこち": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "こちごちし": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "こちとら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "こちゃく": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين)\nمثال: الالتزام بأجندة رسمية / تَمَسَّكَ",
 "こちゃくかんねん": "هَوَس",
 "こちゅう": "حييوان, فرد مستعمرة (أحد الأفراد المتميزين الذين يشكلون حيواناً مستعمراً مثل الحيوانات الطحلبية أو…) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こちょう": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / نَفْخ, نَفْخَة (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ / فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "こちょうげんぼう": "يؤيؤ",
 "こちょうほう": "مُبَالَغَةٌ (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "こちょうらん": "أوركيد العثة, فالاينوبسيس (أي من بساتين الفاكهة المختلفة من جنس فالاينوبسيس ذات أوراق بيضاوية أو بيضاوية…)",
 "こちょくる": "دَغْدَغَة",
 "こちょぐったい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة)",
 "こちょこちょ": "دغدغة (فعل الدغدغة) / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "こちょばい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / مُحْرَج, بِٱلْحَرَج",
 "こちら": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هَٰذَا, هَٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "こちりがく": "جغرافيا قديمة (دراسة جغرافيا العصور القديمة أو الحقب القديمة)",
 "こちんこちん": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب. / مُتَأَهِّب, مُسْتَثَار (أُوصِلَ إِلَى حَالَةِ تَوَتُّرٍ شَدِيد)",
 "こぢんまり": "بإحكام (بشكل ملائم تماماً (للملابس))\nمثال: ناسقت السترة بإحكام",
 "こっか": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / نَشِيد وَطَنِيّ\nمثال: イギリスに１７４５年以前に国歌がなかったという事実は、それ自体はほとんどたいしたことではない。 — ان حقيقة بريطانيا كانت لا تملك نشيداً وطنياً قبل ١٧٤٥ هي بحد ذاتها شأن يذكر. / تَعَظُّم / تسويد, تعتيم (التغيير إلى لون أغمق)",
 "こっかあんぜんほしょうかいぎ": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية…)",
 "こっかあんぜんほしょうきょく": "وكالة الأمن القومي (منظمة التشفير الأمريكية التي تنسق وتوجه الأنشطة عالية التخصص لحماية أنظمة…)",
 "こっかい": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها) / الْبَحْر الْأَسْوَد, بَحْرُ نِيطَش / رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة…) / إِقْرَار, اِعْتِرَاف / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "こっかいぎいん": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "こっかいぎじどう": "كَابِيتُول الوِلَايَات المُتَّحِدَة",
 "こっかいけいざいきょうりょくきこう": "الْبَحْر الْأَسْوَد, بَحْرُ نِيطَش",
 "こっかいし": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران)",
 "こっかいじき": "خزف عظمي (بورسلين فاخر يحتوي على رماد العظام)",
 "こっかいじょう": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "こっかきみつ": "سِرّ دَوْلَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "こっかく": "هَيْكَل عَظْمِيّ, هَيْكَل / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "こっかくきん": "عضلة مخططة, عضلة هيكلية (عضلة متصلة في أحد طرفيها أو كليهما بعظم وبالتالي تحرك أجزاء من الهيكل العظمي…)",
 "こっかげんしゅふじん": "السيدة الأولى (زوجة الرئيس التنفيذي)",
 "こっかしどうしゃ": "رجل دولة, قائد وطني (شخص يعد قائداً محترماً في الشؤون الوطنية أو الدولية)",
 "こっかしほんしゅぎ": "رأسمالية الدولة (نظام اقتصادي رأسمالي في المقام الأول ولكن مع وجود درجة من الملكية الحكومية…)",
 "こっかしゃかいしゅぎ": "اشتراكية الدولة (نظام اقتصادي تمتلك فيه الحكومة معظم وسائل الإنتاج ولكن يُسمح ببعض درجات…) / نَازِيَّة",
 "こっかしゅぎ": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "こっかしゅぎしゃ": "قَوْمِيّ, قَوْمِيَّة",
 "こっかしゅせき": "رَئِيس دَوْلَة",
 "こっかそんぼう": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "こっかてき": "وَطَنِيّ, قَوْمِيّ",
 "こっかてんぷく": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها)\nمثال: إفساد قاصر",
 "こっかのいぬ": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "こっかはんぎゃくざい": "خِيَانَة عُظْمَى",
 "こっかん": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "こっき": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / علم وطني (شعار يُرفع كرمز للجنسية) / منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "こっきょう": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "こっきょうけいびたい": "حرس الحدود (مجموعة من الضباط الذين يقومون بدوريات على حدود الدولة)",
 "こっきょうけいびへい": "حَرْس الْحُدُود (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً…)\nمثال: كان لدى سامي حرس شخصي.",
 "こっきょうせん": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "こっきょうちたい": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "こっきょく": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "こっきり": "وَحِيد",
 "こっくり": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / فَجْأَةً / عَمِيق, غَوِيط",
 "こっくん": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "こっけい": "مُضْحِك, هَزْلِيّ / سَخِيف, مَسْخَرَة / يَوْم وَطَنِيّ (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "こっけいが": "كَارِيكَاتِير, كَارِيكَاتُور",
 "こっけいしゃ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "こっけいしゃだつ": "بَلِيغ الدُّعَابَة, حَاضِر البَدِيهَة (يجمع بين الفكرة الذكيّة والتعبير الطريف)",
 "こっけい者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "こっこさいけん": "سندات الخزانة (أداة دين بآجال استحقاق تبلغ 10 سنوات أو أكثر)",
 "こっし": "لُبّ / دهن العظام (مادة دهنية في العظام تُستخرج بالمذيبات أو بالغليان أو بالبخار؛ تُستخدم بشكل…)",
 "こっしゅ": "ورم عظمي (ورم حميد بطيء النمو يتكون من نسيج عظمي؛ عادة على الجمجمة أو الفك السفلي)",
 "こっせつ": "مُشْتَرَك",
 "こっそ": "تَسَوُّس",
 "こっそう": "بنية, قوام (تكوين الجسم البشري)\nمثال: درس ليوناردو جسم الإنسان",
 "こっそうがく": "علم فراسة الدماغ, فرينولوجيا (دراسة مهجورة الآن لشكل الجمجمة كمؤشر على قوى الملكات العقلية المختلفة)",
 "こっそうがくしゃ": "أخصائي فراسة الدماغ (شخص يدعي القدرة على قراءة شخصيتك من شكل جمجمتك)",
 "こっそり": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "こった": "مُفَصَّل / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما.",
 "こったん": "أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "こっち": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هَٰذَا, هَٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / فَجْأَةً",
 "こっちとら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "こっちゃ": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما.",
 "こっちょう": "اِرْتِفَاع",
 "こってはしあんにあたわず": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "こってり": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "こっとう": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / صَلَع",
 "こっとういち": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "こっとうひん": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "こっぱ": "شَظِيَّة",
 "こっぱい": "رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة…) / وَرَقَة لَعْب, وَرَقَة",
 "こっぱいぜい": "وَرَقَة لَعْب, وَرَقَة",
 "こっぱずかしい": "قَلِيلًا",
 "こっぱみじん": "أشلاء, قطع صغيرة (مجموعة من الشظايا الصغيرة تعتبر ككل)\nمثال: قُصفت برلين حتى تحولت إلى ركام",
 "こっぱ微塵": "أشلاء, قطع صغيرة (مجموعة من الشظايا الصغيرة تعتبر ككل)\nمثال: قُصفت برلين حتى تحولت إلى ركام",
 "こっぴどい": "فَظِيع",
 "こっぺん": "شويكة (هيكل مدبب صغير يعمل كعنصر هيكلي في مختلف اللافقاريات البحرية والمياه العذبة مثل…)",
 "こっぽう": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "こっ恥ずかしい": "قَلِيلًا",
 "こっ酷い": "فَظِيع",
 "こつ": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / عَظْم / رَمَاد, سَكَن / مُبَاغِت, مُفَاجِئ",
 "こつえん": "مُبَاغِت, مُفَاجِئ / التهاب العظم (التهاب العظم نتيجة لعدوى أو صدمة أو تنكس)",
 "こつか": "تَعَظُّم",
 "こつかんせつえん": "فُصَال عَظْمِيّ",
 "こつかんせつしょう": "فُصَال عَظْمِيّ",
 "こつがい": "سَائِل",
 "こつがく": "علم العظام (فرع التشريح الذي يدرس عظام الهيكل العظمي الفقاري)",
 "こつがくしゃ": "أخصائي علم العظام, عالم عظام (عالم تشريح ماهر في علم العظام)",
 "こつがさいぼう": "أرومة عظمية, خلية بانية للعظم (خلية يتطور منها العظم)",
 "こつがさいぼうしゅ": "ورم أرومي عظمي (ورم حميد في العظام والأنسجة الليفية؛ يحدث في الفقرات أو عظم الفخذ أو الساق أو…)",
 "こつがら": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا.",
 "こつきょく": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "こつけいせいふぜんしょう": "تكون العظم الناقص, عظم زجاجي (اضطراب وراثي سائد في النسيج الضام يتميز بعظام هشة تنكسر بسهولة)",
 "こつこつ": "بثبات / طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "こつこつはたらく": "كَدْح\nمثال: شعر توم بالتعب.",
 "こつこつ働く": "كَدْح\nمثال: شعر توم بالتعب.",
 "こつさいぼう": "خلية عظمية (خلية عظمية ناضجة)",
 "こつざい": "إِجْمَالِيّ, مَجْمُوع",
 "こつしゅ": "ورم عظمي (ورم حميد بطيء النمو يتكون من نسيج عظمي؛ عادة على الجمجمة أو الفك السفلي)",
 "こつじき": "سَائِل / تَسَوُّل",
 "こつずい": "نُخَاع, نُخَاع العَظْم",
 "こつずいいけいせいしょうこうぐん": "دكتور في الطب (درجة الدكتوراه في الطب)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "こつずいいしょく": "نُخَاع, نُخَاع العَظْم",
 "こつずいえん": "اِلْتِهَاب العَظْم والنَّقِيّ",
 "こつずいがきゅう": "أرومة نخاعية (سلف لخلايا الدم البيضاء يوجد عادة فقط في نخاع العظم)",
 "こつずいきゅう": "خلية نخاعية (خلية دم بيضاء غير ناضجة توجد عادة في نخاع العظم)",
 "こつずいしゅ": "ورم نقوي (ورم في نخاع العظم (عادة ما يكون خبيثًا) يتكون من خلايا توجد عادة في نخاع العظم)",
 "こつずいせんいしょう": "تليف نقي العظم (تليف نخاع العظم)",
 "こつずいよくせい": "نُخَاع, نُخَاع العَظْم",
 "こつずいバンク": "نُخَاع, نُخَاع العَظْم",
 "こつぜん": "مُبَاغِت, مُفَاجِئ / شَاهِق / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "こつそしょうしょう": "هَشَاشَةُ العِظَام",
 "こつぞうしょくたい": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "こつどう": "مستودع العظام, مقبرة العظام (قبو أو مبنى تُودع فيه الجثث أو العظام)",
 "こつなんかしょう": "لين العظام (تلين غير طبيعي للعظام بسبب نقص الفوسفور أو الكالسيوم أو فيتامين د)",
 "こつなんこつしゅ": "ورم عظمي غضروفي (ورم حميد يحتوي على كل من العظام والغضاريف؛ يحدث عادة بالقرب من نهاية العظام…)",
 "こつにく": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر) / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "こつにくしゅ": "ساركومة عظمية (ورم عظمي خبيث؛ أكثر شيوعًا عند الأطفال والشباب حيث يميل إلى التأثير على عظم…)",
 "こつにくそうしょく": "اِنْتِقَام, ثَأْر دَمَوِيّ (عداء يقتل فيه أعضاء الأطراف المتعارضة بعضهم البعض)",
 "こつねんれい": "عمر عظمي (عمر الشخص مقاساً بمطابقة نمو عظامه (كما يظهر في الأشعة السينية) مع نمو عظام شخص…)",
 "こつばい": "رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة…)",
 "こつばん": "حَوْض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "こつばんい": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "こつばんたい": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف…)",
 "こつぶ": "صَغِير, صغير / مَحْدُود",
 "こつまく": "سِمْحَاق",
 "こつめいろ": "تِيه عَظْمِيّ (تجويف في الجزء الصخري من العظم الصدغي يحتوي على التيه الغشائي)",
 "こつゆ": "زيت العظام (زيت داكن اللون كريه الرائحة يتم الحصول عليه بتفحيم العظام؛ يُستخدم خاصة في…)",
 "こつりつ": "شَاهِق",
 "こつをつかむ": "أَتْقَنَ, بَرَعَ (أن يصبح بارعاً أو ماهراً تماماً في شيء ما)\nمثال: أتقنت اليابانية في أقل من عامين",
 "こつを掴む": "أَتْقَنَ, بَرَعَ (أن يصبح بارعاً أو ماهراً تماماً في شيء ما)\nمثال: أتقنت اليابانية في أقل من عامين",
 "こつ然": "مُبَاغِت, مُفَاجِئ",
 "こづかい": "مَصْرُوف جَيْب, مَصْرُوف / بَوَّاب",
 "こづかいせん": "مَصْرُوف جَيْب, مَصْرُوف",
 "こづかいぜに": "مَصْرُوف جَيْب, مَصْرُوف",
 "こづきまわす": "مُسْتَأْسِد, مُتَنَمِّر",
 "こづき回す": "مُسْتَأْسِد, مُتَنَمِّر",
 "こづく": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "こづち": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار…)",
 "こづつみ": "رِزْمَة, رُزْمَة",
 "こづつみばくだん": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "こづつみゆうびんぶつ": "رِزْمَة, رُزْمَة",
 "こづめ": "حلية هلالية (حلية معدنية على شكل هلال من العصر البرونزي)",
 "こづらにくい": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "こて": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / عقاب الممر (شكل من أشكال العقاب يُجبر فيه الشخص على الركض بين صفين من الرجال يواجهون بعضهم…)\nمثال: رمى قفاز التحدي / قُفَّاز, كَفّ / سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة. / مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / لفافة شعر, مجعد شعر (جهاز ميكانيكي يتكون من أنبوب أسطواني يُلف حوله الشعر لتجعيده)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً / مِجْرَفَة, مَالَج",
 "こてい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء / تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في…) / دَافِئ, مُرِيح (يوفر دفئاً مريحاً ومأوى خاصة في مكان صغير)",
 "こていか": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في…) / تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "こていかわせそうばせい": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف…)",
 "こていかんねん": "صُورَة نَمَطِيَّة",
 "こていきおくそうち": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "こていきゃく": "مَبْنِيّ, مُدْمَج",
 "こていざい": "مثبت (ورنيش مذاب في الكحول ويرش على الصور لمنع التلطخ)",
 "こていし": "عضو ثابت (جهاز ميكانيكي يتكون من الجزء الثابت من محرك أو مولد يدور فيه أو حوله الدوار)",
 "こていしさんぜい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "こていしょうすうてんひょうじほう": "تدوين النقطة الثابتة (نظام عد جذري يُحدد فيه موقع الفاصلة العشرية بالاتفاق)",
 "こていそうば": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف…)",
 "こていそうばせい": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف…)",
 "こていち": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "こていはばフォント": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "こていひ": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن…)",
 "こていひよう": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن…)",
 "こていディスク": "قُرْص صُلْب",
 "こていディスクドライブ": "قرص صلب (قرص مغناطيسي صلب مثبت بشكل دائم في وحدة محرك أقراص)",
 "こていビットレート": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره…)",
 "こてこて": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / تماماً, كلياً (عبر النطاق بالكامل)\nمثال: تبلل تماماً في المطر",
 "こてさき": "رَخِيص",
 "こてしらべ": "تجربة أداء (اختبار لمدى ملاءمة فنان أو مؤدٍ)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام",
 "こてん": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ)\nمثال: فخار صيني كلاسيكي / فَجْأَةً",
 "こてんおんがく": "مُوسِيقَى كْلَاسِيكِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف…)\nمثال: أتعلم الموسيقى.",
 "こてんがく": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "こてんがくしゃ": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي)",
 "こてんこだい": "اَلْعُصُورُ ٱلْكلَاسِيكِيَّةُ ٱلْقَدِيمَةُ",
 "こてんこてん": "تَمَامًا",
 "こてんしゅぎ": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت…)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "こてんしゅぎしゃ": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي)",
 "こてんてき": "تَقْلِيدِيّ, كْلَاسِيكِيّ",
 "こてんてきじょうけんづけ": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء…)",
 "こてんぱ": "تَمَامًا",
 "こてんぱん": "تَمَامًا",
 "こてんりきがく": "ميكانيكا كلاسيكية, ميكانيكا نيوتنية (فرع الميكانيكا القائم على قوانين نيوتن للحركة)",
 "こてんギリシアご": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "こてんギリシャご": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "こてんラテンご": "لَاتِينِيَّة كْلَاسِيكِيَّة (المنسوبة إلى المنطقة المحيطة بمدينة روما والتي كانت تسمى لَاتِيْن في عصر الروم…)\nمثال: أعرف اللاتينية.",
 "こでこにならぬほととぎす": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "こでん": "أُسْطُورَة\nمثال: بحث عن المفتاح.",
 "こと": "كوتو (آلة وترية يابانية تشبه الزيثير؛ لها لوحة صوت خشبية مستطيلة وعادة 13 وتراً…) / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / حَادِث, حَادِثَة / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة. / فَرْق, اِخْتِلَاف / غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي",
 "ことあげ": "إِعْلَان, بَيَان",
 "ことあたらしい": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف)",
 "ことあたらしく": "مَرَّة ثَانِيَة (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ことあらためて": "مَرَّة ثَانِيَة (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ことう": "مصباح قوسي (مصباح ينتج الضوء عند تدفق تيار كهربائي عبر فجوة بين قطبين)",
 "ことかく": "نَقْص, عَدَم وُجُود",
 "ことがない": "هُنَاكَ, يُوجَدُ",
 "ことがら": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "こときれる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "ことこと": "بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: قبلته بخفة على جبينه",
 "ことこまか": "مُفَصَّل",
 "ことこまかい": "مُفَصَّل",
 "ことこまかに": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "ことこまやか": "مُفَصَّل",
 "ことごころ": "خيانة, غدر (فعل خيانة متعمد)",
 "ことごと": "كُلّ شَيْء",
 "ことごとく": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "ことごとしい": "طَنَّان, مُنْتَفِخ (مُتعالٍ ومُتكلَّف في الأسلوب بشكل استعراضي)",
 "ことさら": "عَمْدًا / خُصُوصًا, خَاصَّةً",
 "ことざ": "كِنَّارَة",
 "ことじたい": "نَفْسُهُ, نَفْسُهَا",
 "ことたりる": "كَفَى",
 "ことたる": "كَفَى",
 "ことづけ": "رِسَالَة, خَبَر / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "ことづける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "ことづて": "رِسَالَة, خَبَر",
 "ことてん": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "こととて": "لِأَنَّ",
 "ことどころ": "في مكان آخر (في أو إلى مكان آخر)\nمثال: ذهب إلى مكان آخر / بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "ことども": "أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت",
 "ことなく": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "ことなし": "خالٍ من الأحداث, رتيب (يتميز بعدم وجود أحداث جديرة بالملاحظة أو هامة)\nمثال: حياة خالية من الأحداث / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ことなる": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "ことに": "خُصُوصًا, خَاصَّةً / بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "ことにする": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "ことにすると": "رُبَّمَا\nمثال: يا لها من جملة!",
 "ことによって": "بِوَاسِطَة, عَن طَرِيق",
 "ことにより": "بِجَانِب, جنب (بجانب)\nمثال: زيري بجانب الحوض.",
 "ことによる": "بِسَبَب, مِنْ جَرَّاء",
 "ことによると": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال))\nمثال: ربما ستتصل غداً",
 "ことのえ": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "ことのしだい": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ことのは": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "ことのほか": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
 "ことのほったん": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "ことの発端": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "ことはない": "هُنَاكَ, يُوجَدُ",
 "ことば": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة. / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة. / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "ことばあそび": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "ことばえらび": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "ことばがき": "مُقَدِّمَة",
 "ことばがみつからない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "ことばじり": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "ことばすくな": "وجيز",
 "ことばずくな": "وجيز",
 "ことばずけな": "وجيز",
 "ことばたくみ": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "ことばだくみ": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "ことばつき": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ことばづかい": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ことばてん": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟",
 "ことばどおり": "حَرْفًا بِحَرْفٍ, حَرْفِيًّا",
 "ことばにあらわせない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "ことばにする": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "ことばのあや": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "ことばのうみ": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "ことばのかべ": "حاجز لغوي (حاجز أمام التواصل ناتج عن التحدث بلغات مختلفة)",
 "ことばのサラダ": "سَلَطَة كَلِمَات (خليط من الكلام غير المترابط كما يُسمع أحياناً في الفصام)",
 "ことばをかえす": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "ことばをかける": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ことばをきる": "تَوَقَّفَ",
 "ことばをつぐ": "تَابَعَ, اِسْتَمَرَّ",
 "ことばをのこす": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "ことばをのむ": "صَمَتَ",
 "ことばをはく": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "ことば典": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟",
 "ことば巧み": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "ことば選び": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "ことぶき": "مُبَارَك, مَبْرُوك / أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "ことぶく": "هَنَّأَ, يُهَنِّئُ",
 "ことほき": "مُبَارَك, مَبْرُوك",
 "ことほぎ": "مُبَارَك, مَبْرُوك",
 "ことほぐ": "هَنَّأَ, يُهَنِّئُ",
 "ことほどさように": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "ことほど左様に": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "ことめずらし": "غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي",
 "こともなげに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "ことゆえ": "حَادِث\nمثال: لا تدعها للصدفة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ことよろ": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "ことり": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما…)",
 "ことわざ": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "ことわり": "لَاحَظَ / تَصْرِيح, سَمَاح / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "ことわりをいれる": "بَلَّغَ, أَبْلَغَ",
 "ことわる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / بَلَّغَ, أَبْلَغَ",
 "ことをなす": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "ことをはこぶ": "اِنْطَلَقَ",
 "ことを運ぶ": "اِنْطَلَقَ",
 "ことん": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "こと切れる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "こと座": "كِنَّارَة",
 "こと無く": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "こと細か": "مُفَصَّل",
 "こと細かい": "مُفَصَّل",
 "こと細かに": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "こと細やか": "مُفَصَّل",
 "こと自体": "نَفْسُهُ, نَفْسُهَا",
 "こと足りる": "كَفَى",
 "こどう": "نَبْض\nمثال: ضرب سامي زوجته.",
 "こどうきょう": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "こどうぐ": "جِهَاز / مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "こどうぐかた": "مسؤول الإكسسوارات المسرحية (عضو في طاقم المسرح مسؤول عن الممتلكات والإكسسوارات)",
 "こどうぶつがく": "علم الحيوانات القديمة (دراسة الحيوانات الأحفورية)",
 "こどうみゃく": "شريان فخذي (الشريان الرئيسي للفخذ؛ وهو استمرار للشريان الحرقفي الظاهر)",
 "こどく": "عُزْلَة",
 "こどくかん": "اِنْفِرَاد",
 "こども": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "こどもあそび": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "こどもぎゃくたい": "إِسَاءَة مُعَامَلَة لِلْأَطْفَال, إِسَاءَة مُعَامَلَة الْأَطْفَال",
 "こどもしつ": "غرفة طفل (غرفة نوم للطفل)",
 "こどもしゅう": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / دَاعِرَة, بَغِيَّة",
 "こどもじだい": "طُفُولَة",
 "こどもじみた": "طُفُولِيّ",
 "こどもたち": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "こどもだまし": "تافِه",
 "こどもっぽい": "طُفُولِيّ",
 "こどものつかい": "سعي عبثي, مهمة حمقاء (مهمة غير مثمرة)",
 "こどものてのとどかない": "بمنأى عن",
 "こどもべや": "غرفة طفل (غرفة نوم للطفل)",
 "こどもらしい": "طُفُولِيّ",
 "こな": "طَحِين, دَقِيق / هِيرُويْن",
 "こなあめ": "شراب الذرة (شراب محضر من الذرة)",
 "こない": "دَاخِل\nمثال: جون في عمر أخي. / هَٰذَا, هَٰذِهِ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "こないだ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "こなおしろい": "بودرة الوجه (مسحوق تجميلي للوجه)",
 "こなぐすり": "بُودْرَة",
 "こなごなにする": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "こなさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こなざとう": "سكر بودرة, سكر ناعم (سكر محبب إلى مسحوق ناعم)",
 "こなし": "عَرَبَة / أَبْتَر ((أَبْتَرَه) بَتَرَه؛ (أَبْتَرَ) الله فلَاناً: أعقَمَه)",
 "こなじょう": "مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "こなじらみ": "ذبابة بيضاء (حشرة دقيقة تتغذى على عصارة النباتات؛ قريبة من الحشرات القشرية)",
 "こなす": "هَضَمَ / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى)\nمثال: باع زيري منزله.",
 "こなせっけん": "مسحوق الصابون (صابون في شكل مسحوق مخلوط بمواد قلوية)",
 "こなた": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هُوَ / مُنْذُ / ـنِي, ـنِيَ",
 "こなたさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こなっぽい": "بُودْرِيّ, مَسْحُوقِيّ (ذو مظهر ناعم كالبودرة في اللون)",
 "こなひき": "طَحَّان, طَحَّانَة",
