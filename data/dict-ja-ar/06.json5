 "ごみ収集": "جمع القمامة, رفع النفايات (جمع وإزالة القمامة)",
 "ごみ収集車": "شاحنة القمامة (شاحنة لجمع النفايات المنزلية)",
 "ごみ回収": "جمع القمامة, رفع النفايات (جمع وإزالة القمامة)",
 "ごみ屋": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "ごみ屑": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "ごみ箱": "حاوية نفايات, سلة مهملات (حاوية تُحفظ فيها النفايات حتى يتم جمعها)\nمثال: そのごみ箱は悪臭を放っていた。 — أطلق صندوق القمامة رائحةً كريهة.",
 "ごみ袋": "كِيس قُمَامَة",
 "ごめいわく": "مُشْكِلَة, مَتاعِب",
 "ごめん": "أَنَا آسِف, أَنَا آسِفَة / تَصْرِيح, سَمَاح / إِقَالَة",
 "ごめんください": "أَنَا آسِف, أَنَا آسِفَة",
 "ごめんこうむる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ごめんたい": "خماسي السطوح (أي متعدد سطوح له خمسة أوجه مستوية)",
 "ごめんちゃい": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "ごめんなさい": "أَنَا آسِف, أَنَا آسِفَة",
 "ごめんなちゃい": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "ごめんをこうむる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ごめん下さい": "أَنَا آسِف, أَنَا آسِفَة",
 "ごもく": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "ごもっとも": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ごもん": "قَيْصَر, إِمْبْرَاطُور / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة)",
 "ごやく": "ترجمة خاطئة (ترجمة غير صحيحة)",
 "ごゆう": "تَسْلِيَة",
 "ごゆっくり": "بِبُطْء\nمثال: ごゆっくりどうぞ。 — خذ وختك",
 "ごよう": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران. / إساءة استعمال, سوء استخدام (استخدام غير لائق أو مفرط)\nمثال: إساءة استعمال الكحول",
 "ごようおさめ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ごようがくしゃ": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "ごようきき": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "ごようくみあい": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "ごようしょうにん": "متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ごようたし": "متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ごようたつ": "متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ごようだち": "متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ごようだつ": "متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ごようにん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "ごようのかた": "زَبُون, عَمِيل",
 "ごようろん": "براغماتية, تداولية (دراسة استخدام اللغة)",
 "ごらく": "تَسْلِيَة",
 "ごらくしせつ": "منشأة ترفيهية (منشأة عامة للترفيه)",
 "ごらくしつ": "غرفة استجمام, غرفة ترفيه (غرفة مجهزة للترفيه غير الرسمي)",
 "ごらん": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة",
 "ごらんじる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごらんぜらる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごらんなさい": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごらんなさる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごらんにいれる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "ごらんになる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごりおし": "جَرَّفَ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "ごりごり": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة / صلب, غير مرن (مقاوم للانحناء) / صارم, غير مرن (غير قابل للتغيير) / صارم, لا هوادة فيه (لا يقدم تنازلات) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)\nمثال: قضيب حديدي غير مرن / إِبَاحِيّ صَرِيح (صريح إلى أقصى درجة في المحتوى الجنسي) / مُتَشَدِّد فِي الوَلَاء, مُوَالٍ بِشِدَّة (شَدِيد الوَلَاء والإِخْلَاص)",
 "ごりっぱ": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "ごりやく": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا. / فَائِدَة, جَدْوَى",
 "ごりょうかく": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع)",
 "ごりょうしょう": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "ごりょうしん": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "ごりょうにん": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "ごりょうほ": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع) / مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "ごりん": "أَلْعَاب أُولِمْبِيَّة, أُولِمْبِيَّة",
 "ごりんたいかい": "أَلْعَاب أُولِمْبِيَّة, أُولِمْبِيَّة",
 "ごり押し": "جَرَّفَ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "ごれいじょう": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ごれいそく": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ごれんらく": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "ごろ": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / تَلَاعُب لَفْظِيّ, تَوْرِيَة (تلاعب فكاهي بالكلمات)\nمثال: أفعل ذلك من أجل التلاعب اللفظي / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول / مبتز (شخص يرتكب جرائم من أجل الربح (خاصة من يحصل على المال عن طريق الاحتيال أو الابتزاز))",
 "ごろあわせ": "تَلَاعُب لَفْظِيّ, تَوْرِيَة (تلاعب فكاهي بالكلمات)\nمثال: أفعل ذلك من أجل التلاعب اللفظي",
 "ごろうじる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごろく": "مختارات أدبية, مقتطفات (مجموعة من المقتطفات من عمل أدبي)",
 "ごろごろ": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد / تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة / فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "ごろごろさま": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "ごろごろ様": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "ごろし": "مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ごろっと": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود / بسهولة, دون جهد (بدون جهد أو جهد ظاهر)\nمثال: رقصت برشاقة ودون جهد",
 "ごろつく": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / عِرَاك عِصَابَات (قتال بين عصابات متنافسة من المراهقين) / مقعد خلفي (مقعد خادم (أو حجرة أمتعة) في مؤخرة عربة) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "ごろにゃん": "خَرْخَرَ, هَرْهَرَ / خَرْخَرَة",
 "ごろのよさ": "موسيقى, نغم عذب (أي أصوات مقبولة (مستساغة ومتناغمة))\nمثال: غفا على وقع موسيقى أجراس الرياح",
 "ごろりと": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود / بسهولة, دون جهد (بدون جهد أو جهد ظاهر)\nمثال: رقصت برشاقة ودون جهد",
 "ごろりとよこになる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ごろりと横になる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ごろんごろん": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد / تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة / فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "ごろんじゃる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ごろんと": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود / بسهولة, دون جهد (بدون جهد أو جهد ظاهر)\nمثال: رقصت برشاقة ودون جهد",
 "ごわごわ": "بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب",
 "ごわさん": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "ごわす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ごわり": "خَمْسُون بِالْمِائَة (النصف معبراً عنه كنسبة مئوية)",
 "ごわんす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ごん": "معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك / أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…)",
 "ごんいざん": "معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك",
 "ごんか": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "ごんぎょう": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "ごんぎょうじほうがかり": "مُؤَذِّن",
 "ごんく": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "ごんげ": "الحُلُول / التَّجَسُّد, التَّأَنُّس / تَجَسَّد",
 "ごんこつ": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "ごんご": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ごんごどうだん": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "ごんごん": "فَرْقَعَة",
 "ごんさい": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "ごんじょう": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا) / دَامِغ, مُؤَثِّر (مقنع بقوّة ووجاهة الحجّة) / إفشاء, وشاية (كشف معلومات أو تقديم أدلة عن شخص آخر)",
 "ごんす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "ごんすけ": "خادم رجل (خادم من الرجال)",
 "ごんてき": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "ごんぶと": "سَمِيك, غَلِيظ / غَلِيظ",
 "ごんべい": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "ごんべえ": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "ごんぼ": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…)",
 "ごエス": "خَمْسَة (يَدُلُّ عَلَى العَدَد 5) / خَمْسَة, خُمَاسِيّ (العدد الأصلي الذي هو مجموع أربعة وواحد)",
 "ごーごー": "مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ) / مُدَوٍّ, مُرْعِد (يُصْدِر صوتًا كالرعد)",
 "ご一緒": "مَعًا, سَوِيًّا",
 "ご丁寧": "أَدِيب, مُؤَدَّب / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "ご不浄": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ご両親": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "ご主人様": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "ご了承": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "ご仁": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / شخص, شخصية (كلمة أخرى للشخص؛ شخص لا يستدعي التعريف به)\nمثال: ظهرت شخصية غريبة عند الباب",
 "ご令嬢": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ご令息": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "ご兄弟": "شَقِيق, شَقِيقَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "ご免": "أَنَا آسِف, أَنَا آسِفَة / تَصْرِيح, سَمَاح / إِقَالَة",
 "ご免なさい": "أَنَا آسِف, أَنَا آسِفَة",
 "ご利益": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا. / فَائِدَة, جَدْوَى",
 "ご協力": "تَعَاوُن",
 "ご参考まで": "لمعلوماتك",
 "ご多分": "غَالِبِيَّة, أَغْلَبِيّة",
 "ご大層": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة)",
 "ご存じ": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد) / مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
