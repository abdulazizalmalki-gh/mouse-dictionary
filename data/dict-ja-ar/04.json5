 "ぎやくこうか": "تأثير البلاسيبو, تأثير الدواء الوهمي (أي تأثير يبدو أنه نتيجة لإعطاء دواء وهمي؛ التغيير عادة ما يكون مفيداً ويفترض…)",
 "ぎゅう": "مَوَاشٍ, مَاشِيَة\nمثال: أفضل لحم البقر. / لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / قَوَّاد, عرص / اِحْتِضَان, حَضْن",
 "ぎゅうえき": "طاعون الماشية (مرض فيروسي معد حاد يصيب الماشية (غالباً ما يكون قاتلاً)؛ يتميز بالحمى والإسهال…)",
 "ぎゅうかく": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق.",
 "ぎゅうかわ": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر)",
 "ぎゅうがわ": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر)",
 "ぎゅうぎゅう": "صرير (صوت صرير)\nمثال: صرير ألواح الأرضية كشف أمره / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب. / عَذَاب",
 "ぎゅうぎゅうづめ": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "ぎゅうぎゅう詰め": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "ぎゅうし": "شحم البقر (شحم يتم الحصول عليه من حيوان بقري)",
 "ぎゅうしゃ": "عربة ثيران (عربة يجرها ثور)",
 "ぎゅうじる": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "ぎゅうじをとる": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "ぎゅうたろう": "قَوَّاد, عرص",
 "ぎゅうづめ": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "ぎゅうとう": "جدري البقر (مرض فيروسي يصيب الماشية يسبب مرضاً جلدياً خفيفاً يؤثر على الضرع؛ كان يستخدم…)",
 "ぎゅうなべ": "سوكيياكي",
 "ぎゅうにく": "لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "ぎゅうにゅう": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب…)\nمثال: كنت أشرب الحليب",
 "ぎゅうにゅうはいたつ": "بَائِع لَبَن",
 "ぎゅうにゅうや": "مشتقات الحليب",
 "ぎゅうひ": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر)",
 "ぎゅうひきにく": "لحم بقر مفروم (لحم بقر تم فرمه)",
 "ぎゅうび": "ذيل الثور (ذيل الماشية بعد سلخه؛ يستخدم خاصة للحساء)",
 "ぎゅうふん": "جلة, روث البقر (قطعة من روث البقر المجفف)",
 "ぎゅうや": "حظيرة أبقار (حظيرة للأبقار)",
 "ぎゅうらく": "زُبْدَة (هي الزُبْد أو هي أخص من الزُبْد. أنظر الصورة؛ زُبْدَة الكلام: هو فحواه أو ما…)\nمثال: اشترت رطلي زبدة.",
 "ぎゅうタン": "لسان بقر (لسان البقرة يؤكل كلحم)",
 "ぎゅうタンせんじゅつ": "إطالة النقاش, تعطيل برلماني ((قانون) تكتيك لتأخير أو عرقلة التشريع عن طريق إلقاء خطب طويلة)",
 "ぎゅうテール": "ذيل الثور (ذيل الماشية بعد سلخه؛ يستخدم خاصة للحساء)",
 "ぎゅうミンチ": "لحم بقر مفروم (لحم بقر تم فرمه)",
 "ぎゅうロース": "شواء بقري, لحم بقر للتحمير (قطعة من لحم البقر مناسبة للتحمير)",
 "ぎゅうロースステーキ": "خاصرة بقر, لوين بقري (قطعة لحم من خاصرة البقر)",
 "ぎゅう詰め": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "ぎゅって": "بإحكام (مثبت أو مربوط بإحكام)\nمثال: النافذة كانت مغلقة بإحكام",
 "ぎゅっと": "بإحكام (مثبت أو مربوط بإحكام)\nمثال: النافذة كانت مغلقة بإحكام",
 "ぎゅんと": "إصابة, التقاط العدوى (أن تصبح مصاباً بالعدوى)",
 "ぎゆう": "بَسَالَة, بُطُولَة",
 "ぎょい": "بِالتَّأْكِيد",
 "ぎょう": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس.",
 "ぎょういんじそうち": "طابعة سطرية (طابعة تعمل كجهاز إخراج على الحاسوب؛ تطبع سطراً كاملاً من الأحرف في وقت واحد)",
 "ぎょうか": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة)",
 "ぎょうかい": "جلطة, خثرة (كتلة من مادة تشكلت من محتوى سائل) / صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "ぎょうかいがん": "توف, طوفة بركانية (صخر بركاني صلب يتكون من رماد بركاني مضغوط)",
 "ぎょうかいようご": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "ぎょうかいアナリスト": "محلل صناعي (محلل للظروف التي تؤثر على صناعة معينة)",
 "ぎょうかんをよみとる": "قَرَأَ مَا بَيْنَ السُّطُور (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "ぎょうかんをよむ": "قَرَأَ مَا بَيْنَ السُّطُور (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "ぎょうぎ": "تداول, تريث (سمة التفكير المتأني في العمل أو القرار)\nمثال: كان رجلاً ذا تداول قضائي / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "ぎょうぎさほう": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "ぎょうぎょう": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "ぎょうぎょうしい": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "ぎょうぎわるい": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ぎょうけい": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ))\nمثال: زاد الحضور بنسبة 50 في المائة",
 "ぎょうけつ": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة / تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل) / تكثيف, تكميد (فعل زيادة كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد / خُثْرَة, جُلْطَة",
 "ぎょうこ": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "ぎょうこいんし": "عامل التخثر (أي من العوامل في الدم التي تعد أفعالها ضرورية لتخثر الدم)",
 "ぎょうこう": "حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ)\nمثال: لقد حالفني الحظ.",
 "ぎょうこざい": "عامل تجلط, مخثر (عامل ينتج التخثر)",
 "ぎょうこつ": "هَيْكَل عَظْمِيّ, هَيْكَل / ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام)",
 "ぎょうこてん": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "ぎょうさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "ぎょうざ": "هِلَالِيُّ الشَّكْلِ, هِلَالِيّ (ذو شكل يشبه الهلال)",
 "ぎょうし": "وَقَّرَ / حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "ぎょうしゃ": "بَائِع, تَاجِر",
 "ぎょうしゃはんばい": "إِجْمَالِيّ, بِالْجُمْلَةِ",
 "ぎょうしゅう": "تجميع كتلي, تكتل (فعل الجمع في كتلة) / تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً) / تلبد (عملية التلبد؛ تشكيل تجمعات صوفية تشبه السحب) / إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع)",
 "ぎょうしゅうかい": "إِجْمَالِيّ, مَجْمُوع",
 "ぎょうしゅうげん": "مستضد ملزن, مولد التلزن (أي مادة تعمل كمستضد لتسبب إنتاج الراصة (الأجسام المضادة الملزنة))",
 "ぎょうしゅうざい": "عامل تجلط, مخثر (عامل ينتج التخثر)",
 "ぎょうしゅうそ": "راصة (جسم مضاد يسبب تراص مستضد معين)",
 "ぎょうしゅく": "تكثيف, تكميد (فعل زيادة كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد",
 "ぎょうしゅくねつ": "حرارة التكثف (حرارة تتحرر بواسطة وحدة كتلة من الغاز عند نقطة غليانه عندما يتكثف إلى سائل)\nمثال: حرارة التكثف تساوي حرارة التبخر",
 "ぎょうしゅくぶつ": "تكثف, ندى (رطوبة جوية تكثفت بسبب البرودة)",
 "ぎょうしょう": "تاجر, مساوم (شخص يشتري ويحافظ على مخزون من البضائع ليتم بيعها) / قَائِد, زَعِيم",
 "ぎょうしょうにん": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)\nمثال: اشتريت جوال مستعمل.",
 "ぎょうじ": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث…)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "ぎょうじゃ": "نُسُكِيّ",
 "ぎょうじゅうざが": "أبداً",
 "ぎょうじょ": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث…)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "ぎょうじょう": "سُلُوك, تَصَرُّف",
 "ぎょうすう": "أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة)",
 "ぎょうずい": "وُضُوء, غُسْل",
 "ぎょうずる": "أَدَّى",
 "ぎょうせい": "نَجْمَة الصَّبَاح / إِجْرَائِيّ / إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة. / كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور…)\nمثال: كوكب الأرض جميل.",
 "ぎょうせいかん": "ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "ぎょうせいかんちょう": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "ぎょうせいきかん": "هيئة إدارية, وحدة إدارية (وحدة ذات مسؤوليات إدارية)",
 "ぎょうせいく": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "ぎょうせいくかく": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "ぎょうせいけん": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف…)\nمثال: هو متعطش للسلطة.",
 "ぎょうせいしょし": "كاتب عدل, موثق (شخص مخول قانونياً ليشهد على التوقيعات ويصدق على صحة الوثائق ويأخذ الإفادات)",
 "ぎょうせいじょう": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "ぎょうせいじょうれい": "أَمْرٌ تَنْفِيذِيٌّ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "ぎょうせいてき": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "ぎょうせいふ": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "ぎょうせいほう": "قانون إداري (مجموعة القواعد واللوائح والأوامر والقرارات التي تنشئها الوكالات الإدارية…)",
 "ぎょうせいサービス": "خدمة عامة, وظيفة حكومية (التوظيف ضمن نظام حكومي (خاصة في الخدمة المدنية))",
 "ぎょうせき": "إِنْجَاز / سُلُوك, تَصَرُّف / تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "ぎょうせきあっか": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "ぎょうせきしゅぎ": "حكم الجدارة, ميريتوقراطية (الاعتقاد بأن الحكام يجب أن يتم اختيارهم لقدراتهم المتفوقة وليس بسبب ثروتهم أو…)",
 "ぎょうぜん": "بسكون تام, بلا حراك (بدون حركة أو إصدار صوت)\nمثال: جلس بلا حراك كالتمثال",
 "ぎょうぜんとして": "بِهُدُوء",
 "ぎょうそう": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "ぎょうそろえ": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض)",
 "ぎょうぞろえ": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض)",
 "ぎょうたい": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري. / مجال, ميدان عمل (نوع معين من المؤسسات التجارية)\nمثال: هم متميزون في مجالهم",
 "ぎょうちゃく": "اِلْتِصَاق",
