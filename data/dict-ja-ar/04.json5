 "しいたげる": "اِسْتَضْعَفَ, قَهَرَ",
 "しいてき": "اِعْتِبَاطِيّ",
 "しいと": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "しいとめ": "حَمَاة",
 "しいら": "دُلْفِين / دَرْفِيل / دُخَس (سَمِنَ وامتلأ شحمًا ولحمًا؛ دَسَّ الشيءَ)",
 "しいる": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "しいれ": "شِرَاء, اِشْتِرَاء",
 "しいれさき": "مُزَوِّد, مُزَوِّدَة",
 "しいれる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "しいん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "しいんぐん": "اِجْتِمَاع السَّاكِنِين, التَّقَاء السَّاكِنِين (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "しう": "ضَرِيح",
 "しうち": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / حَرَكَة",
 "しうと": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "しうとめ": "حَمَاة",
 "しぇえ": "قِف, قِفِي",
 "しえ": "كَاهِن, قِسِّيس",
 "しえき": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟",
 "しえん": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "しえんきん": "ذَخِيرَة / مَوَّل",
 "しお": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / فُرْصَة",
 "しおあい": "فُرْصَة",
 "しおあじ": "مُلُوْحَة",
 "しおいれ": "رَشَّاشَةْ الْمِلْح (مؤنث رَشَّاش، وهو الكثير الرَشّ؛ سِلاح نَارِيّ يَرُشّ الرَصَاص رشّا ولا يحتاج إلى ضغط الزَنَاد لكل رَصَاصَة)",
