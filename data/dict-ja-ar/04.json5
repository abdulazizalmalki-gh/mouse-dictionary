 "しょうじゃ": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "しょうじゅう": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "しょうじゅつ": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "しょうじゅん": "مَشْهَد / مَنْظَر",
 "しょうじゅんかん": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "しょうじゅんき": "مَشْهَد / مَنْظَر",
 "しょうじゅんせいれつ": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / فَرَزَ\nمثال: انه نوع من الفطر.",
 "しょうじょ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "しょうじょう": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "しょうじょうせせ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "しょうじょうせぜ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "しょうじょうひ": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "しょうじる": "أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "しょうじん": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "しょうす": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / اِنْتَحَلَ / دَرَّسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "しょうすい": "بَوْل",
 "しょうすう": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية.",
 "しょうすうしゃ": "أَقَلِّيَّة",
 "しょうすうてん": "فَاصِل عَشْرِيّ",
 "しょうすうは": "أَقَلِّيَّة",
 "しょうすうみんぞく": "أَقَلِّيَّة قَوْمِيَّة",
 "しょうする": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / اِنْتَحَلَ / دَرَّسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "しょうずく": "هَال, هَيْل / حَبْهَان, هَال",
 "しょうずる": "أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "しょうせい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "しょうせかい": "مُنَمْنَمَة",
 "しょうせき": "بُرْهَان, دَلِيل",
 "しょうせつ": "حَانَة, بَار",
 "しょうせつか": "رِوَائِيّ, رِوَائِيَّة",
 "しょうせん": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "しょうぜん": "تَابَعَ, اِسْتَمَرَّ",
 "しょうそ": "اِنْتِصَار, نَصْر",
 "しょうそう": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "しょうそうゆうい": "نَشِيط",
 "しょうそく": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة. / حَرَكَة",
 "しょうそくし": "مِسْبَار",
 "しょうそくをたつ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "しょうそこ": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة. / حَرَكَة",
 "しょうそん": "هَامْلِت",
 "しょうぞう": "صُورَة / بُورْتْرِيَّة\nمثال: この切手には誰の肖像が印刷してありますか。 — من هو الشخص المصور على هذا الطابع؟",
 "しょうぞうが": "صُورَة / بُورْتْرِيَّة",
 "しょうぞく": "بَذْلَة, بَدْلَة",
 "しょうたい": "فَصِيلَة عَسْكَرِيَّة, فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "しょうたいじょう": "دَعْوَة, عزيمة / إِغْرَاء",
 "しょうたく": "نَعْصَة, مُسْتَنْقَع",
 "しょうだい": "دَعْوَة, عزيمة / إِغْرَاء",
 "しょうだく": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "しょうだん": "مُفَاوَضَات, مُذَاكَرَات",
 "しょうち": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / غَفُور (غَفُور: ( اسم )؛ غَفور: ( اسم ))",
 "しょうちのうえで": "عَمْدًا",
 "しょうちのすけ": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "しょうちのまく": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "しょうちょう": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "しょうちょうしゅぎ": "رَمْزِيَّة",
 "しょうちょうせいすい": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "しょうちょく": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "しょうちん": "مُنْخَفَض",
 "しょうてい": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "しょうてん": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "しょうてんがい": "وَسَطُ البَلَد",
 "しょうてんさい": "عِيد الصُعُود, يَوْم الصُعُود",
 "しょうてんをあてる": "بُؤْرَة",
 "しょうてんをあわせる": "بُؤْرَة",
 "しょうてんをしぼる": "رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري.",
 "しょうとう": "جُزَيِّرَة",
 "しょうとうらっぱ": "تَنَصَّتَ",
 "しょうとうれい": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "しょうとうラッパ": "تَنَصَّتَ",
 "しょうとく": "مُتَأَصِّل",
 "しょうとくひ": "نُصُب, مَعْلَم تَذْكَارِيّ",
 "しょうとつ": "تَصَادُّم, اِصْطِدَام / تَصَادُم / يتصادم",
 "しょうとつけんしゅつ": "سِي دِي",
 "しょうとり": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "しょうど": "إِضَاءَة",
 "しょうどう": "محاماة / تَأْييد / مُنَاصَرَة",
 "しょうどく": "قِرَاءَة",
 "しょうどくざい": "مُعَقِّمٌ",
 "しょうどくやく": "مُطَهِّر",
 "しょうなり": "أَصْغَر مِن, صُغْرَى مِن",
 "しょうに": "رَضِيع",
 "しょうにか": "طِبُّ الأَطْفَال (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しょうにかい": "طَبِيب أَطْفَال (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "しょうにまひ": "شَلَل الْأَطْفَال / شلل دماغي",
 "しょうにん": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "しょうにんかんもん": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "しょうね": "طَبِيعَة, طبيعة",
 "しょうねつじごく": "جَحِيم, جَهَنَّم / جَحِيم, سَعِير",
 "しょうねん": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "しょうねんき": "مُرَاهَقَة",
 "しょうねんろうどう": "عمالة الأطفال (مؤنث عَمَّال بمعنى صيغة مبالغة في العَمَل؛ في : هم العُمَّال؛ جمع عَامِل، وقد يكون جمع عَمَّال)",
 "しょうのいい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "しょうのう": "مُخَيْخ",
 "しょうのない": "عَنِيد / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "しょうのよい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "しょうのわるい": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "しょうはい": "نَتِيجَة",
 "しょうはく": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "しょうばい": "تِجَارَة\nمثال: 地元の店は観光客相手に順調な商売をしている。 — المتاجر المحلية تقوم بمتاجرة جيدة مع السياح . / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "しょうばいおんな": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "しょうばいになる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "しょうばいにん": "تَاجِر, تَاجِرَة / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "しょうばん": "شَارَكَ, سَاهَمَ",
 "しょうひ": "اِسْتِهْلَاك",
 "しょうひがわひどうきてつづき": "مُسْتَهْلِك / مُسْتَنْفِد",
 "しょうひきげん": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しょうひしゃ": "مُسْتَهْلِك / مُسْتَنْفِد",
 "しょうひしゅぎ": "استهلاكية, نزعة استهلاكية",
 "しょうひつ": "إِغْفَال",
 "しょうひょう": "عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "しょうひょうめい": "عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "しょうひん": "بِضَاعَة, بَضَائِع",
 "しょうひんがく": "بِضَاعَة / بَضَائِع / سِلْعَة / سِلَع ((سَلَعَ) رأْسَهُ يَسْلَعُ سَلْعًا: شجَّهُ؛ (سَلَعَ) الطَّريقَ: شَقَّهُ) / مَتَاع\nمثال: الناس ليسوا سلعة.",
 "しょうひんもくろく": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "しょうび": "وَرْدَة",
 "しょうびん": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "しょうふ": "حَطَّاب",
 "しょうふう": "قَيْقَب",
 "しょうふく": "مُتَقَبِّل",
 "しょうふだ": "عَلَامَةُ سِعْر, بِطَاقَةُ سِعْر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "しょうぶ": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "しょうぶごと": "قِمَار, مُقَامَرَة",
 "しょうぶし": "مُقَامِر / مُغَامِر",
 "しょうぶどころ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "しょうぶなし": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "しょうぶん": "طَبِيعَة, طبيعة",
 "しょうへい": "دَعْوَة, عزيمة / إِغْرَاء",
 "しょうへき": "عَقَبَة, حَاجِز",
 "しょうへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "しょうべん": "بَوْل",
 "しょうべんき": "مِبْوَلَة",
 "しょうべんくさい": "طُفُولِيّ",
 "しょうべんじょ": "مِبْوَلَة",
 "しょうべんぶくろ": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "しょうべんをする": "تَبَوَّلَ, بَالَ",
 "しょうほ": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "しょうほう": "تِجَارَة",
 "しょうほうたい": "شبكة إندوبلازمية",
 "しょうほん": "نبذة – مقتطفات من",
 "しょうぼう": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "しょうぼうぐみ": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "しょうぼうし": "إِطْفَائِيّ\nمثال: 私の夢は消防士になる事だ。 — أريد أن أكون رجل إطفاء.",
 "しょうぼうしゃ": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "しょうぼうしゃりょう": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "しょうぼうしょ": "مَرْكَز إطْفَاء (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "しょうぼうじどうしゃ": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "しょうぼうたい": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "しょうま": "اِنْجِرَاف",
 "しょうまい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "しょうみ": "تَقْدِير",
 "しょうみきげん": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しょうみじゅうりょう": "اَلْوَزْن اَلصَّافِي",
 "しょうみつ": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة.",
 "しょうむ": "تَقَاضٍ",
 "しょうめい": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "しょうめいしゃしんき": "كُشْك تَصْوِير (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "しょうめいしょ": "شَهَادَة",
 "しょうめいしょう": "شَهَادَة",
 "しょうめいせきにん": "عِبْء الإثْبات, عِبْء البَيِّنة (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\") / التزام بتقديم الدليل, التزامات بتقديم الدليل",
 "しょうめいりょく": "مِصْدَاقِيّة"
}
