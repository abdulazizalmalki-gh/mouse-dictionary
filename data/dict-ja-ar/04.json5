 "しゅぎ": "مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: الوجودية مذهب إنساني.",
 "しゅぎしゃ": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع / ـِيّ / اِشْتِرَاكِيّ / اِشْتِرَاكِيّ, اِشْتِرَاكِيَّة",
 "しゅぎょう": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "しゅぎょく": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "しゅく": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "しゅくい": "مُبَارَك, مَبْرُوك",
 "しゅくうん": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "しゅくえい": "مُخَيِّم",
 "しゅくえいち": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق)",
 "しゅくえき": "مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "しゅくえん": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "しゅくが": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "しゅくがかい": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "しゅくけい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "しゅくげん": "نَقْص",
 "しゅくごう": "كَارْمَا",
 "しゅくさい": "عِيد, مَهْرَجَان",
 "しゅくさつ": "صَعَقَ",
 "しゅくしゃ": "إِقَامَة / مَجْلِس",
 "しゅくしゅ": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "しゅくしゅく": "صَامِت, سَاكِت",
 "しゅくしょ": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "しゅくしょう": "نَقْص",
 "しゅくじつ": "عُطْلَة رَسْمِيَّة, إِجَازَة عَامَّة",
 "しゅくじゅう": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان",
 "しゅくじゅうこう": "قَصَّار",
 "しゅくじょ": "رَبَّة, رَبَّةْ اَلْبَيْت / خَاتُون, سَيِّدَة / لِيدِي / مُنْحَرِف, مُنْحَرِفَة",
 "しゅくす": "هَنَّأَ, يُهَنِّئُ",
 "しゅくすい": "خُمَار (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / خُمَار اَلسُّكْر (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / صُدَاع الخَمْر\nمثال: اعتنقت ليلى الإسلام و بدأت ترتدي الخمار.",
 "しゅくする": "هَنَّأَ, يُهَنِّئُ",
 "しゅくずき": "مِنْسَاخ / سَنْجَة تَوْصِيل",
 "しゅくせい": "أَبْرَاجُ السَّمَاء",
 "しゅくぜん": "صَامِت, سَاكِت / بِهُدُوء",
 "しゅくだい": "وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "しゅくてん": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "しゅくとう": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "しゅくとして": "بِهُدُوء",
 "しゅくはく": "إِقَامَة",
 "しゅくはくしゃ": "مُسْتَأجِر",
 "しゅくはくじょ": "إِقَامَة",
 "しゅくはくせつび": "إِقَامَة",
 "しゅくはくにん": "مُسْتَأجِر",
 "しゅくば": "مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "しゅくふ": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "しゅくふく": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال. / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "しゅくぼ": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "しゅくめい": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "しゅくめいてき": "حَاسِم, مَصِيرِيّ",
 "しゅくや": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "しゅくゆう": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "しゅくろう": "كَابِر / بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله) / خَمَان",
 "しゅくん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "しゅけい": "مُحَاسِب, مُحَاسِبَة",
 "しゅけいるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "しゅけん": "سِيَادَة, حَاكِمِيَّة (السِّيَادةُ : الشرفُ؛سادَ يَسُودُ سِيَادَةً، والاسمُ السُّؤدُد، وَهُوَ المَجْدُ و الشَّرفُ؛ ساد يسود سيادةً وسُودَداً وسؤْدُداً :عظُم ومجُد وشرُف)\nمثال: أوكرانيا دولة ذات سيادة.",
 "しゅけんしゃ": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "しゅげい": "حِرْفَة يَدَوِيَّة",
 "しゅげいひん": "حِرْفَة يَدَوِيَّة",
 "しゅこう": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه. / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "しゅこうぎょうしゃ": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "しゅこうげい": "حِرْفَة يَدَوِيَّة",
 "しゅこん": "جِذْر وَتَدِيّ, جَذْر وَتَدِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "しゅご": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "しゅごがおおきい": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "しゅごしゃ": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "しゅごてんし": "مَلَاك حَارِس",
 "しゅごにん": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "しゅさい": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "しゅさいしゃ": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "しゅさつ": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "しゅざ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅざい": "غِطَاء / غِلَاف / غَطَّى",
 "しゅざいきしゃ": "فَيْج",
 "しゅざいげん": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "しゅざいげんば": "مَنْظَر, مَشْهَد / مَشْهَد",
 "しゅざいしゃ": "مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "しゅし": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "しゅしこつ": "رَضَفَة",
 "しゅしゃ": "اِخْتِيَار, خِيَار",
 "しゅしゅ": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "しゅしゅう": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "しゅしゅつ": "صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى لتُبَاع هناك) / تَصْدِير / صَدَّرَ (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: صادرات الجزائر في تزايد.",
 "しゅしょう": "رَئِيس أَرْكَان / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "しゅしょく": "زِنْجَفْر",
 "しゅしん": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しゅじ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "しゅじい": "طَبِيب عَامّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "しゅじつ": "اَلسَّبْت",
 "しゅじつるい": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "しゅじゅ": "قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ",
 "しゅじゅうかんけい": "تَكْرِيم",
 "しゅじゅさまざま": "مُتَعَدِّد, مُتَنَوِّع",
 "しゅじゅざった": "مُخْتَلِف, مُتَنَوَّع",
 "しゅじゅつ": "عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / جِرَاحَة",
 "しゅじょう": "قَيْصَر, إِمْبْرَاطُور",
 "しゅじん": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ\nمثال: 主人は料理がとても上手です。 — زوجي طباخ ماهر. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "しゅじんこう": "بَطَل, بَطَلَة / مُتَصَدِّر / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅじんやく": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "しゅす": "أَطْلَس / صَقِيل",
 "しゅすいこう": "خَوْخَة",
 "しゅすう": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "しゅする": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس. / صَلَّحَ / أَصْلَحَ",
 "しゅずつ": "عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / جِرَاحَة",
 "しゅせい": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "しゅせき": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅせきほさかん": "رئيس أركان الجيش",
 "しゅせん": "خَطّ أَحْمَر (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "しゅせんど": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "しゅせんりつ": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "しゅぜん": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "しゅそうじゅつ": "قِراءَةُ الْكَفّ",
 "しゅそく": "طَرَف, عُضْو\nمثال: 手足がむくんでいます。 — تورمت قدميّ و يديّ.",
 "しゅぞう": "خَمَّرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "しゅぞうじょう": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "しゅぞく": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق. / نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しゅたい": "نِوَاة / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "しゅたいしそう": "زُوتْشِيَّة",
 "しゅたいせい": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "しゅたいてき": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "しゅたる": "رَئِيسِيّ",
 "しゅだい": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "しゅだいか": "شارة مُوسِيقِيّة",
 "しゅだいきょく": "شارة مُوسِيقِيّة",
 "しゅだん": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "しゅち": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "しゅちしゅぎ": "فكرانية",
 "しゅちゅうにする": "إِسْتَوْلَى عَلَى",
 "しゅちょう": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "しゅちょうこく": "إِمَارَات, إِمَارَة (الْإِمَارَات: يُقْصَدُ بها دولة الإِمَارَاتُ العَرَبِيَّةُ المُتَّحِدَة)\nمثال: أبو ظبي هي عاصمة الإمارات العربية المتحدة.",
 "しゅちょうしゃ": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "しゅっか": "صَاعِدًا / مُهَاجِم",
 "しゅっかい": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "しゅっかく": "اِسْم تَفْضِيل (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "しゅっかさき": "وِجْهَة, وُجْهَة",
 "しゅっかじ": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "しゅっきょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
