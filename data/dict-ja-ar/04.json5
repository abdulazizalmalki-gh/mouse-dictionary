 "くじる": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "くじ引き": "يَانَصِيب",
 "くす": "شجرة الكافور (شجرة كبيرة دائمة الخضرة في المناطق الدافئة ينتج خشبها العطري الكافور)",
 "くすくす": "إِهْلَاس",
 "くすくすわらう": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "くすくす笑う": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "くすぐったい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "くすぐり": "دغدغة (فعل الدغدغة) / دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "くすぐる": "دَغْدَغَة",
 "くすっと": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "くすねる": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "くすのき": "شجرة الكافور (شجرة كبيرة دائمة الخضرة في المناطق الدافئة ينتج خشبها العطري الكافور)",
 "くすぶる": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / احتراق بطيء, جمر (نار تحترق بدخان كثيف ولكن دون لهب)\nمثال: تحول الجمر فجأة إلى لهب",
 "くすべる": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "くすみ": "ثلامة, كليل (انعدام الحدة أو وضوح الحافة أو الطرف) / بَلَادَة, فُتُور (نقص في الحساسية) / خفوت, قتامة (نقص في السطوع البصري) / ضَجَر, مَلَل (صفة الافتقار إلى ما يثير الاهتمام)\nمثال: ثلامة القلم الرصاص جعلت كتابته غير مقروءة",
 "くすり": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب. / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة) / مُخَدِّر / عَقَّار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "くすりくそうばい": "هُنَاكَ, يُوجَدُ",
 "くすりと": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "くすりびん": "أُنبوب",
 "くすりや": "صَيْدَلِيَّة / صَيْدَلَة / صَيْدَلِيّ, صَيْدَلَانِيّ",
 "くすりゆび": "بِنْصِر",
 "くすりよりようじょう": "اَلْوِقَايَةُ خَيْرٌ مِنَ الْعِلَاجِ",
 "くすん": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "くすんごぶ": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "くず": "كودزو (كرمة سريعة النمو من شرق آسيا لها جذور نشوية درنية وأوراق ثلاثية مشعرة وعناقيد من الزهور الأرجوانية تليها قرون مشعرة طويلة تحتوي على العديد من البذور؛…) / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / رغوة شوائب, زَبَد (طبقة من الشوائب أو النباتات التي يمكن أن تتشكل على سطح السائل) / أراذل, حثالة (أشخاص عديمو القيمة)",
 "くずあなご": "بَطِّيّ المِنْقَار (ذو منقار يشبه منقار البطة)",
 "くずいも": "فاصوليا اليام, هيكاما (نبات ملتف من أمريكا الوسطى بجذور وقرون صالحة للأكل؛ تؤكل الدرنات الكبيرة نيئة أو مطبوخة خاصة عندما تكون صغيرة ويجب طهي القرون الصغيرة جيداً؛ تنتج…) / فاصوليا البطاطس, فاصوليا اليام (نبات ملتف في حوض الأمازون له جذور كبيرة صالحة للأكل)",
 "くずいれ": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "くずうこん": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت) / أروروت, أروروت أمريكي (نبات أبيض الزهر من جزر الهند الغربية ينتج جذره نشا الأروروت) / أروروت (نشا مغذٍ يتم الحصول عليه من جذر نبات الأروروت)",
 "くずおれる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "くずかご": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "くずし": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد)",
 "くずす": "دَمَّرَ / اِسْتَرْخَى / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "くずてつ": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "くずにく": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "くずひろい": "جامع القمامة, نبّاش (شخص غير ماهر يجمع الخرق من القمامة العامة كوسيلة للعيش)",
 "くずもの": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "くずや": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "くずやさん": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "くずり": "شَرِه, وُلْفِيرِين ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "くずれ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / شخص ولى زمانه (شخص لم يعد مشهوراً)",
 "くずれさる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "くずれる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "くず入れ": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "くず屋": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "くず屋さん": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "くず折れる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "くず肉": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "くず鉄": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "くせ": "خَلَاص, تَطْهِير اَلنَّفْس / عَادَة / تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / خاصية, سمة مميزة (سمة مميزة) / خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية) / خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "くせごと": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه وقوَّمَه وأَتقنه)",
 "くせして": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "くせだま": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "くせに": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "くせのある": "غَرِيب, مُثِيرٌ لِلدَّهْشَة ((غير رسمي) غَيْرُ تَقْلِيدِيٍّ بِشَكْلٍ لَافِت)",
 "くせもの": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "くせん": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "くせー": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز) / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / مُبَالِغ فِي التَّمْثِيل (مُتَكَلَّف فِي الأَدَاء الدِّرَامِيّ؛ مُبَالَغ فِيه) / أَخْرَق",
 "くせ球": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "くせ者": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "くぜつ": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / صرصرة, طقطقة (سلسلة سريعة من الضوضاء التي تصدرها أجزاء الآلة)",
 "くそ": "لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة / بِرَاز, سَلْح / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "くそあま": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "くそおとこ": "زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "くそおんな": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "くそがえる": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "くそがき": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
 "くそく": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "くそじじい": "شَيْخ, عَجُوز",
 "くそたれ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "くそたわけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "くそだめ": "سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد)",
 "くそったれ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما) / اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة) / مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "くそどきょう": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "くそばえ": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "くそばばあ": "عَجُوز",
 "くそぶくろ": "مَعِدَة, مِعْدَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / كيس بقايا الطعام (كيس للطعام الذي لم يأكله الزبون في المطعم ليأخذه معه)",
 "くそほど": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "くそまじめ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "くそまる": "طَرَدَ, نَفَى",
 "くそみそ": "بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "くそむし": "جَعْل الرَوْث, جِعْرَان (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "くそやろう": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
 "くそわた": "مَعِدَة, مِعْدَة",
 "くそガキ": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
 "くそスレ": "منشور تافه, منشور مسيء (منشور إنترنت ذو جودة رديئة ومثير للجدل)",
 "くそババア": "عَجُوز",
 "くそビッチ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "くそマジメ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "くそ女": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "くそ度胸": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "くそ真面目": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "くたい": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / هَيْكَل عَظْمِيّ, هَيْكَل",
 "くたかけ": "دَجَاج, لَحْم دَجَاج\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل.",
 "くたくた": "مستنفد, منهك (مفرغ من الطاقة أو القوة أو الشدة) / مُسْتَنْزَف, مُنْهَك (مُسْتَنْزَف جَسَدِيًّا) / مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)\nمثال: مستحيل زراعة التبغ في التربة المنهكة / مُتَضَرِّر, مُعَنَّف (يُظهِر أعراضًا ناتجة عن إيذاء بدنيّ ونفسيّ مُتكرِّر) / مُحَطَّم, مُهَشَّم (متضرر من الضربات أو الاستعمال القاسي) / مُحَطَّم, مُهَشَّم (مُتَضَرِّرٌ خَاصَّةً بِسَبَبِ الاسْتِعْمَالِ القَاسِي)",
 "くたばりぞこない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "くたばり損ない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "くたばる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "くたびれもうけ": "هدر الجهد (جهد لا طائل منه)",
 "くたびれ儲け": "هدر الجهد (جهد لا طائل منه)",
 "くだ": "أُنْبُوبَة / بَكَرَة",
 "くだぎつね": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "くだく": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "くだくだ": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل",
 "くだくだしい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "くだくらげ": "سحاريات (مستعمرة محيطية عائمة أو سابحة من السلائل غالباً ما تكون شفافة أو زاهية الألوان)",
 "くだけ": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه / نَتِيجَة",
 "くだけた": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "くだけなみ": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد) / تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ) / كاسر الحجارة (عامل محجر يكسر كتل الحجر)",
 "くだける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "くだけ波": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد) / تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ) / كاسر الحجارة (عامل محجر يكسر كتل الحجر)",
 "ください": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "くださる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "くだし": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "くだしあ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "くだしぐすり": "مُلَيّن",
 "くだす": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "くだちゃい": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "くだって": "بتواضع (بطريقة متواضعة) / ببخل, بتقتير (بطريقة بخيلة)\nمثال: خفض رأسه بتواضع / فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "くだつぎて": "تركيبات أنابيب, وصلة أنابيب (تجهيزة تتكون من قطع أنابيب مسننة لربط الأنابيب ببعضها)",
 "くだものとけいそう": "ثَمَرَة زَهْرَة اَلْآلَام, فَاكِهَة زَهْرَة اَلْآلَام",
 "くだものばたけ": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة)\nمثال: أحب سقي البستان.",
 "くだものや": "بائع فاكهة, فاكهاني (شخص يبيع الفاكهة)",
 "くだものナイフ": "سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات)",
 "くだもの屋": "بائع فاكهة, فاكهاني (شخص يبيع الفاكهة)",
 "くだらない": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "くだらぬ": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "くだらん": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "くだり": "مُتَّجِهٌ لِلْأَسْفَل (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا نُزُولًا) / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "くだりこうばい": "مَنْزَل, مُنْحَدَر هَابِط (الخاصية التي يمتلكها منحدر أو سطح ينخفض للأسفل)",
 "くだりざか": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "くだりばら": "إسهال (حركات أمعاء متكررة ومائية؛ يمكن أن تكون عرضاً لعدوى أو تسمم غذائي أو التهاب القولون أو ورم في الجهاز الهضمي)",
 "くだる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "くだん": "السَّابِقُ ذِكْرُهُ / عَادِيّ",
 "くだ狐": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "くち": "فَم, بق / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بَوَّابَة / كَلَام, تَكَلُّم",
 "くちあけ": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "くちあたり": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "くちあらく": "بِعُنْف",
 "くちあらそい": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "くちあんぐり": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "くちいれにん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "くちいれや": "وَكَالَة تَوْظِيف",
 "くちうるさい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "くちえ": "صفحة العنوان المقابلة (رسم توضيحي أمامي يواجه صفحة العنوان في كتاب) / واجهة مزخرفة (واجهة مبنى مزخرفة)",
 "くちおかし": "مَزَّاح, هَزْلِيّ (يتّسم بالمُزاح وحُسن الدعابة)",
 "くちおしい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "くちおも": "حَرِيص, حَكِيم / حَرِيص",
 "くちおもい": "حَرِيص, حَكِيم / حَرِيص",
 "くちかずがおおい": "ثَرْثَار",
 "くちかずがすくない": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "くちかずのおおい": "ثَرْثَار",
 "くちかずのすくない": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "くちかせ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "くちがうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "くちがうるさい": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "くちがおおい": "ثَرْثَار",
 "くちがおもい": "انطوائي, غير تواصلي (لا يميل إلى التحدث أو إعطاء المعلومات أو التعبير عن الآراء)",
 "くちがき": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "くちがきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちがさけても": "مَهْمَا",
 "くちがたい": "رزين, كتوم (يتميز بالحكمة أو التواضع وضبط النفس الحكيم) / مُتَحَرِّز, مُتَحَفِّظ (ينتبه للعواقب المحتملة ويتوخّى الحذر) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: مساعده الكتوم الموثوق به",
 "くちがね": "قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي / مَبْسَم / مَقْبِس",
 "くちがる": "ثَرْثَار",
 "くちがわるい": "ساخر",
 "くちきき": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "くちきり": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "くちぎたない": "بَذِيء اللِّسَان / طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "くちぎれい": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "くちく": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد) / خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "くちくかん": "مُدَمِّر",
 "くちくせんしゃ": "مدمرة الدبابات (مركبة مدرعة مجهزة بمدفع مضاد للدبابات وقادرة على التحرك بسرعات عالية)",
 "くちぐせ": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "くちぐちに": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "くちぐるま": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "くちぐるまにのる": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "くちけんか": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "くちげんか": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "くちこごと": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "くちことば": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً / لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "くちごうしゃ": "بَلِيغ, طَلِيق اللِّسَان (يُعبِّر عن نفسه بسهولة ووضوح وفعاليّة)",
 "くちごたえ": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "くちごもる": "غَمْغَمَة",
 "くちさがない": "ثَرْثَار, نَمَّام (يميل إلى الدردشة غير الرسمية ونقل الأخبار والقيل والقال)",
 "くちさき": "مجاملة كاذبة, نفاق (تعبير عن الموافقة غير مدعوم بقناعة حقيقية) / شَفَة, شفة",
 "くちさきだけ": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "くちざみせん": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "くちざわり": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "くちじゃみせん": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "くちじょうず": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "くちじり": "صوار (حزمة من الألياف العصبية تمر من جانب إلى آخر من الدماغ أو الحبل الشوكي)",
 "くちじろじか": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "くちすい": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "くちすぎ": "مَعِيشَة, مَعَاش",
 "くちすすぐ": "تَمَضْمَضَ, غَرْغَرَ / سَائِل الْغَرْغَرَة",
 "くちずから": "مُبَاشَرَةً",
 "くちずさむ": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "くちぞえ": "تَوْصِيَة",
 "くちたっしゃ": "فَصِيح, فُصْحَى",
 "くちだし": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "くちだっしゃ": "فَصِيح, فُصْحَى",
 "くちつき": "فَم, بق / مَبْسَم",
 "くちづき": "فَم, بق / مَبْسَم",
 "くちづけ": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "くちづける": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "くちとり": "سَائِس / هَندَم / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "くちどめ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "くちどめりょう": "شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "くちなおし": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / إنترميزو, فاصل موسيقي (قطعة قصيرة من الموسيقى الآلية مؤلفة للأداء بين فصول الدراما أو الأوبرا) / إنترميزو (حركة قصيرة تأتي بين الأقسام الرئيسية للسيمفونية)",
 "くちなし": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "くちなわ": "ثُعْبَان, حَنَش / ثُعْبَان / حَنَش (حَنَشَ (حنشه) الحنش حنشا: لدغه؛ حَنَشَ (حنشه): ساقه وطرده ويقال حنش الصيد صاده) / حَيَّة / أَفْعَى",
 "くちにかける": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "くちにする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "くちにだす": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "くちにのぼせる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "くちにはいる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "くちにはこぶ": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "くちぬき": "بَرِّيمة",
 "くちのうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "くちのかるい": "ثَرْثَار",
 "くちのきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちのたっしゃ": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "くちのは": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "くちのわるい": "ساخر",
 "くちは": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "くちはっちょう": "ثرثار, طليق اللسان (يتميز بتدفق جاهز للكلام)\nمثال: هي شابة ثرثارة للغاية تنخرط في مناجاة النفس وليس المحادثات",
 "くちはばったい": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "くちば": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة) / قماش خمري (قماش منزلي الغزل لونه بني محمر)",
 "くちばいろ": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة) / قماش خمري (قماش منزلي الغزل لونه بني محمر)",
 "くちばし": "مِنْقَار",
 "くちばしがきいろい": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة) / فرخ طائر (طائر صغير اكتسى بالريش للتو أو أصبح قادراً على الطيران) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "くちばしが黄色い": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة) / فرخ طائر (طائر صغير اكتسى بالريش للتو أو أصبح قادراً على الطيران) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "くちばしをいれる": "قَاطَعَ",
 "くちばしをさしはさむ": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "くちばしをはさむ": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "くちばしを入れる": "قَاطَعَ",
 "くちばしを挟む": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "くちばみ": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "くちばや": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "くちひげ": "شَارِب",
 "くちひも": "خيط زم, رباط سحب (رباط يتكون من حبل يمر عبر درزة حول فتحة)\nمثال: سحب خيط الزم وأغلق الحقيبة",
 "くちび": "فَتِيل / مُنْصَهِرَة, مصهر / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "くちびる": "شَفَة, شفة",
 "くちびるをとがらす": "بوّز, بَرطَمَ",
 "くちふうじ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "くちふき": "مَنْدِيل, مَنْدِيل مَائِدَة",
 "くちぶえ": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "くちぶえをふく": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "くちぶちょうほう": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちぶぶん": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "くちぶり": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / إِشَارَة, تَلْمِيح (اقتراح غير مباشر)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "くちへんとう": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "くちべた": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちべに": "أَحْمَر شِفَاه (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "くちぼそ": "باراكودا, عقام",
 "くちまえ": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "くちまね": "مُشَاكهَة",
 "くちまめ": "ثَرْثَار",
 "くちまわし": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "くちもと": "فَم, بق",
 "くちもとがゆるむ": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "くちゃい": "مُنْتِن",
 "くちゃくちゃ": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج) / فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "くちやかましい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء) / ثَرْثَار",
 "くちゅう": "مِحْنَة",
 "くちゅうざい": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "くちゅうやく": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية) / طارد الحشرات (مادة كيميائية تطرد الحشرات)",
 "くちょう": "نَغْمَة, نَغْم",
 "くちよせ": "قَنَاة",
 "くちる": "أَفْسَدَ, فَسَدَ",
 "くちわ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "くちわけ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "くちをかける": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "くちをきく": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث. / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "くちをきる": "فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح.",
 "くちをきわめて": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "くちをそえる": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "くちをだす": "قَاطَعَ",
 "くちをついてでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "くちをつく": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "くちをつぐむ": "صَمَتَ",
 "くちをつける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "くちをとがらす": "بوّز, بَرطَمَ",
 "くちをとがらせる": "بوّز, بَرطَمَ",
 "くちをふうじる": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "くちをわる": "اِعْتَرَفَ, أَقَرَّ",
 "くちコミ": "تناقل الأخبار, كلمة الفم (انتشار القيل والقال عن طريق التواصل المنطوق)\nمثال: انتشر خبر علاقتهم عن طريق التناقل الشفهي",
 "くちマネ": "مُشَاكهَة",
 "くっ": "يَع",
 "くっき": "مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة) / مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "くっきょう": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / مُمْتَاز, فَاخِر / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "くっきょく": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه وقوَّمَه وأَتقنه)",
 "くっきょくぶ": "كُوع, مِرْفَق / كُوعٌ",
 "くっきり": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "くっきん": "عضلة قابضة (عضلة هيكلية يثني انقباضها مفصلاً)",
 "くっく": "محل, مكان (وضع معين)\nمثال: لو كنت مكاني ماذا كنت ستفعل؟",
 "くっくっくっ": "قَرْقَرَة, مُنَاغَاة / هَدَلَ",
 "くっこうせい": "انتحاء ضوئي (استجابة توجيهية للضوء)",
 "くっさい": "تعدين",
 "くっさく": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "くっさくき": "حَفَّار / حَفَّارَة, حَفَّارَة آلِيَّة",
 "くっし": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "くっしん": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "くっしんせい": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "くっす": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / طَوَّعَ, تَغَلَّبَ عَلَى",
 "くっする": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / طَوَّعَ, تَغَلَّبَ عَلَى",
 "くっせい": "انتحاء",
 "くっせつ": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة) / انكسار (التغير في اتجاه موجة منتشرة (ضوء أو صوت) عند مرورها من وسط إلى آخر) / تنغيم, عروض (أنماط الضغط والتنغيم في اللغة) / تعديل الصوت (طريقة في التحدث يتم فيها تعديل جهارة أو حدة أو نبرة الصوت) / انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / إِعْرَاب, تَصْرِيف (تغيير في شكل الكلمة (عادة بإضافة لاحقة) للإشارة إلى تغيير في وظيفتها النحوية)",
 "くっせついじょう": "سوء الانكسار (خطأ في انكسار أشعة الضوء في العين كما في اللابؤرية أو قصر النظر)",
 "くっせつかく": "زاوية الانكسار (الزاوية بين شعاع منكسر وخط عمودي على السطح بين الوسطين عند نقطة الانكسار)",
 "くっせつけい": "مقياس الانكسار (أداة قياس لقياس معامل انكسار مادة ما)",
 "くっせつご": "لغة اندماجية (نوع من اللغات التركيبية حيث يمكن للمورفيمات الفردية أن تنقل أجزاء متعددة من المعلومات)",
 "くっせつぼうえんきょう": "تلسكوب كاسر (تلسكوب بصري يحتوي على عدسة محدبة كبيرة تنتج صورة يتم مشاهدتها من خلال العدسة العينية)",
 "くっせつりつ": "مُؤَشِّر الِانْكِسَار, مُعَامِل الِانْكِسَار (نسبة سرعة الضوء في الفراغ إلى سرعته في وسط ما)",
 "くっせー": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز) / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / مُبَالِغ فِي التَّمْثِيل (مُتَكَلَّف فِي الأَدَاء الدِّرَامِيّ؛ مُبَالَغ فِيه) / أَخْرَق",
 "くっそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "くったく": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / سأم, ضجر (الشعور بالملل من شيء مضجر)",
 "くったくた": "مستنفد, منهك (مفرغ من الطاقة أو القوة أو الشدة) / مُسْتَنْزَف, مُنْهَك (مُسْتَنْزَف جَسَدِيًّا) / مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)\nمثال: مستحيل زراعة التبغ في التربة المنهكة / مُتَضَرِّر, مُعَنَّف (يُظهِر أعراضًا ناتجة عن إيذاء بدنيّ ونفسيّ مُتكرِّر) / مُحَطَّم, مُهَشَّم (متضرر من الضربات أو الاستعمال القاسي) / مُحَطَّم, مُهَشَّم (مُتَضَرِّرٌ خَاصَّةً بِسَبَبِ الاسْتِعْمَالِ القَاسِي)",
 "くったくない": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "くったくのない": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
