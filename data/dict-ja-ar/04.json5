 "きんかちょう": "عصفور الزيبرا (طائر حباك أسترالي صغير ذو علامات تشبه الحمار الوحشي)",
 "きんかぶ": "سُلَالَة",
 "きんかん": "إكليل (الحافة الواقعة بين جلد الرسغ وقرن الحافر) / بُرْتُقَال ذَهَبِيّ (شجر صغير مثمر من جنس الموالح، من فصيلة الحمضيات، أزهاره بيض عطرة الرائحة، وثمره…)\nمثال: هل تحب البرتقال ؟ / كورونا (سيجار طويل بنهايات غير حادة) / حلقة الجنيات (حلقة من الفطريات تحدد محيط النمو الجوفي المعمر للميسيليوم)",
 "きんかんがっき": "آلة نحاسية, آلة نفخ نحاسية (آلة نفخ تتكون من أنبوب نحاسي (عادة ما يكون متغير الطول) يُنفخ فيه بواسطة قطعة…)",
 "きんかんしょく": "كسوف حلقي (كسوف يظهر فيه فقط قرص خارجي رفيع من الشمس)",
 "きんかんばん": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية. / إِجَّامَة",
 "きんがく": "مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً / عَلْم الفَطْرِيَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "きんがしんねん": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "きんがん": "قَصَّرَ النَّظَرِ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "きんき": "مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / مُضَادّ اِسْتِطْبَاب / مُتْعَة, لَذَّة / راية طويلة (علم طويل؛ غالباً ما يكون مستدق الطرف) / طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما) / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "きんきゅう": "إلحاح, استعجال (أهمية ضاغطة تتطلب إجراءً سريعاً)\nمثال: إلحاح حاجته",
 "きんきゅうきゅうめいしつ": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين…)",
 "きんきゅうけいほうほうそう": "يَع",
 "きんきゅうじ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "きんきゅうじたい": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "きんきゅうせい": "إلحاح, استعجال (أهمية ضاغطة تتطلب إجراءً سريعاً)\nمثال: إلحاح حاجته",
 "きんきゅうちゃくりく": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "きんきゅうていし": "غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة…)\nمثال: تغرب الشمس في الغرب.",
 "きんきゅうど": "إلحاح, استعجال (أهمية ضاغطة تتطلب إجراءً سريعاً)\nمثال: إلحاح حاجته",
 "きんきゅうはっしん": "تَهَافَتَ",
 "きんきゅうろしんれいきゃくそうち": "رمز تصحيح الخطأ ((الأتصالات) نظام تشفير يدمج بتات تماثل إضافية من أجل اكتشاف الأخطاء)",
 "きんきょりむせんつうしん": "قَصِير المَدَى (مَحْدود بِمَسافات قَصيرَة)",
 "きんきら": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط)",
 "きんきらきん": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط)",
 "きんきん": "حَادّ, صَارِخ (ذو لون ساطع بشكل مفرط وصارخ) / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة. / بَارِد كَالجَلِيد (بارد كالثلج تمامًا) / قَرِيبًا, سَرْعَانَ مَا / وَحِيد",
 "きんきんごえ": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد)",
 "きんきんぜん": "سَعِيد, مُفْرِح",
 "きんきんちょう": "توتر العضلات (التوترية الطبيعية للعضلات)\nمثال: الرياضة تحسن توتر العضلات / تأتر, تشنج عضلي (تقلصات عضلية طويلة بشكل غير طبيعي؛ استرخاء بطيء للعضلة بعد التقلص)",
 "きんきんちょうしょう": "تأتر, تشنج عضلي (تقلصات عضلية طويلة بشكل غير طبيعي؛ استرخاء بطيء للعضلة بعد التقلص)",
 "きんきんちょうせいずつう": "صداع توتري (صداع يقع في مؤخرة الرأس؛ عادة ما يكون ناتجاً عن توتر الجسم الناتج عن الإرهاق أو…)",
 "きんきんちょうせいジストロフィーしょう": "حثل عضلي توتري (شكل حاد من الحثل العضلي يتميز بضعف عام وهزال عضلي يؤثر على الوجه والقدمين…)",
 "きんきん声": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد)",
 "きんぎゅうきゅう": "بُرْج اَلثَّوْر, اَلثَّوْر (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "きんぎょ": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "きんぎょう": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء))\nمثال: خشية الله",
 "きんぎょそう": "أَنْف الْعِجْل (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "きんぎょのうんこ": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "きんぎょのふん": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "きんぎょのウンコ": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "きんぎょばち": "حوض سمك كروي (وعاء شفاف تحفظ فيه الأسماك الصغيرة)\nمثال: يعيش الرئيس في وضع تنعدم فيه الخصوصية (تحت المجهر)",
 "きんぎん": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "きんぎんふくほんいせい": "نظام المعدنين (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكميات محددة من معدنين (عادة…)",
 "きんくろはじろ": "زرقاي",
 "きんぐさり": "سلسلة ذهبية, لابورنوم شائع (شجيرة زينة أو شجرة من جنس لابورنوم؛ تزرع غالباً لزينة عيد الفصح)",
 "きんぐち": "ذَهَبِيّ اللَّوْن (ذو لون الذَّهب)",
 "きんけい": "مقدمة ((في علم الحاسوب) نافذة لتطبيق نشط) / تدرج ذهبي (تدرج متوج زاهي الألوان من جبال غرب ووسط آسيا)",
 "きんけいしつ": "ساركوبلازم, هيولى عضلية (سيتوبلازم الليفة العضلية المخططة)",
 "きんけいれん": "تشنج, تقلص عضلي (انقباض عضلي مؤلم وغير إرادي)",
 "きんけつ": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / راعي; حامي; وصي; سيد; و / ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "きんけつしょう": "تجرثم الدم (وجود عابر للبكتيريا (أو كائنات دقيقة أخرى) في الدم)",
 "きんけつびょう": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "きんけん": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "きんけんせいじ": "بلوتوقراطية",
 "きんげん": "اَلْمُخْلِص / حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت. / صَارِم, مُتَشَدِّد",
 "きんげんせんい": "لييفة عضلية (واحدة من العديد من الخيوط المتقلصة التي تشكل الألياف العضلية المخططة)",
 "きんげんだい": "العصر الحديث (الأوقات الحالية أو الحديثة)",
 "きんげんめいく": "حكمة موجزة, قول مأثور (قول تعليمي موجز وبليغ)",
 "きんこ": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / مخزن, مستودع (منشأة يمكن فيها إيداع الأشياء للتخزين أو الحفظ) / تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في…)",
 "きんこう": "رَصِيد / أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن / منجم ذهب (منجم يُعثر فيه على خام الذهب) / تشغيل المعادن, مصنوعات معدنية (نشاط صنع الأشياء من المعدن بمهارة)\nمثال: كانت هناك ثقوب رصاص في الأشغال المعدنية / وزن تروي (نظام أوزان يستخدم للمعادن الثمينة والأحجار الكريمة؛ يعتمد على باوند 12 أونصة…) / تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء))\nمثال: خشية الله",
 "きんこうせき": "روتيل (معدن يتكون من ثاني أكسيد التيتانيوم في شكل بلوري؛ يوجد في الصخور المتحولة…)",
 "きんこうち": "حقل ذهب, منجم ذهب (منطقة يتم فيها تعدين الذهب)",
 "きんこうみゃく": "حَامِلٌ لِلذَّهَب, ذَهَبِيّ (يَحْتَوِي عَلَى الذَّهَب)",
 "きんこうよさん": "ميزانية متوازنة (تكون الميزانية متوازنة عندما تكون النفقات الجارية مساوية للإيرادات)",
 "きんこうよさんじょうすう": "ميزانية متوازنة (تكون الميزانية متوازنة عندما تكون النفقات الجارية مساوية للإيرادات)",
 "きんこかぶ": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة…)",
 "きんこけい": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "きんこつ": "بنية, قوام (تكوين الجسم البشري)\nمثال: درس ليوناردو جسم الإنسان",
 "きんこつがた": "بنية رياضية, عضلية البنية (عضلي وعريض العظام)",
 "きんこつりゅうりゅう": "عَضَلِيّ",
 "きんこばん": "أمين الصندوق, خازن (موظف مسؤول عن استلام وصرف الأموال)",
 "きんこやぶり": "كسار خزائن (لص يكسر الخزائن لسرقة محتوياتها الثمينة)",
 "きんこん": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "きんごう": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير. / تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء))\nمثال: خشية الله",
 "きんごく": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "きんさ": "هامش ضيق (هامش صغير)\nمثال: لم يتواضع الرئيس بسبب هامش فوزه الضيق",
 "きんさいぼう": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "きんざん": "منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "きんし": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / خيط فطري, هيفا (أي من الخيوط الشبيهة بالخيط التي تشكل الغزل الفطري للفطريات) / حسر, قصر النظر ((طب العيون) خلل في البصر ناتج عن خلل في القدرة الانكسارية للعين؛ تظهر الأشياء…)",
 "きんしうり": "قرع السباغيتي (قرع بيضاوي متوسط الحجم ذو لب على شكل خيوط تشبه السباغيتي)",
 "きんしかんやく": "مرخي عضلات (عقار يقلل من انقباض العضلات عن طريق منع انتقال النبضات العصبية أو عن طريق تقليل…)",
 "きんしがん": "حسر, قصر النظر ((طب العيون) خلل في البصر ناتج عن خلل في القدرة الانكسارية للعين؛ تظهر الأشياء…)",
 "きんしがんてき": "قَصِيرُ النَّظَر (يفتقر إلى بُعْد النظر أو الشمولية)",
 "きんしぎょくよう": "مَلَكِيَّة",
 "きんしじゃく": "كَنَارِي",
 "きんしじゃくいろ": "كَنَارِي",
 "きんしじょうやく": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "きんしたい": "غزل فطري, ميسيليوم (الجزء الخضري للفطر المكون من كتلة من الخيوط المتفرعة)",
 "きんしっかん": "اعتلال عضلي (أي حالة مرضية تصيب العضلات ولا تعزى إلى خلل وظيفي عصبي)",
 "きんしつ": "متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "きんしつか": "تجانُس, مجانسة (عملية جعل الشيء متجانساً أو موحداً في التركيب)\nمثال: مجانسة القشطة",
 "きんしつせい": "تَجَانُس (صفة التشابه أو القابلية للمقارنة في النوع أو الطبيعة)\nمثال: هناك تجانس ملحوظ بين الشركتين",
 "きんしめいれい": "أمر حجر, قرار حظر (أمر محكمة يمنع طرفاً من القيام بنشاط معين)",
 "きんしゃ": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في…)",
 "きんしゅ": "تعديل, تلطيف (عملية التلطيف أو المزج المعتدل) / ورم عضلي (ورم حميد يتكون من أنسجة عضلية) / سُلَالَة",
 "きんしゅうしゅく": "انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية))",
 "きんしゅか": "عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة)",
 "きんしゅく": "تَضْيِيق / تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي)\nمثال: منع الصحيفة",
 "きんしゅほう": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "きんしょう": "قَلِيلًا / ميدالية ذهبية (كأس مصنوعة من الذهب (أو لها مظهر الذهب) تمنح عادة للفائز بالمركز الأول في…) / قيراط (وحدة قياس لنسبة الذهب في السبيكة؛ الذهب عيار 18 قيراطًا هو 75% ذهب) / اِلْتِهَاب / عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "きんしょく": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "きんしれい": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "きんしん": "توبة, ندامة (الندم على سلوكك السابق) / حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه)\nمثال: حصر العدوى في منطقة بؤرية / يُعَلِّق / تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي)",
 "きんしんかん": "زِنَا مَحَارِم, سِفَاح الْقُرْبَى",
 "きんしんこうはい": "تزاوج الأقارب (فعل تزاوج الأفراد ذوي القرابة الوثيقة)",
 "きんしんしょぶん": "يُعَلِّق",
 "きんしんそうかん": "زِنَا مَحَارِم, سِفَاح الْقُرْبَى",
 "きんじ": "تَقْرِيب / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي. / مُؤَخَّرًا / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "きんじさん": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "きんじち": "تَقْرِيب",
 "きんじつ": "قَرِيبًا, سَرْعَانَ مَا",
 "きんじつちゅうに": "قَرِيبًا, سَرْعَانَ مَا",
 "きんじつてん": "حضيض شمسي (نقطة الحضيض في المدار الشمسي؛ النقطة في مدار كوكب أو مذنب حيث يكون أقرب ما يكون…)",
 "きんじて": "مُخَالَفَة",
 "きんじとう": "هَرَم, أَهْرَام ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها…)",
 "きんじゅ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "きんじゅう": "مُتَوَحِّش / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "きんじょ": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض)\nمثال: إنه حي ودود",
 "きんじょうてっぺき": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "きんじる": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "きんす": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "きんすなご": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في…)",
 "きんず": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "きんずる": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "きんせい": "تَنَاظُر / حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً…)\nمثال: أقطف الزهرة بنفسي. / اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل))",
 "きんせいげんり": "مبدأ استبعاد باولي (لا يمكن لأي إلكترونين أو بروتونين أو نيوترونين في نظام معين أن يكونا في حالات…)",
 "きんせいせき": "كورديريت (معدن أزرق يتكون من المغنيسيوم والحديد والألمنيوم والسيليكون والأكسجين؛ يستخدم…)",
 "きんせいのとれた": "مُتَنَاسِب الأَبْعَاد (ذو نسب مُرضية وجميلة)",
 "きんせいひん": "تَهْرِيب",
 "きんせき": "نقش أثري (نقش محفور)",
 "きんせきがく": "علم النقوش (دراسة النقوش القديمة)",
 "きんせつ": "قرب (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها. / اقتراب, دنو (فعل الاقتراب مكانياً من شيء ما)\nمثال: اقتراب الصياد شتت الإوز / مُسْتَعْجِل / ساركومير, قُسَيْم عضلِي (وحدة من الوحدات التي ينقسم إليها اللييف العضلي)",
 "きんせつかくとう": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "きんせつがく": "بروكسيميكس, علم القربيات (دراسة المسافات المكانية بين الأفراد في مختلف الثقافات والمواقف)",
 "きんせつさつえい": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو…)",
 "きんせん": "أوتار القلب, شغاف القلب (أعمق مشاعر الحب والرحمة لديك)\nمثال: العديد من حالات التبني تلامس شغاف القلب / نُقُود, مَال\nمثال: أريد بعض المال.",
 "きんせんい": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "きんせんか": "آذَرْيُون, كَحْلَاء",
 "きんせんてき": "نَقْدِيّ, مَالِيّ",
 "きんせんとうろくき": "آلَة تَسْجِيل نَقْد (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "きんぜん": "سَعِيد, مُفْرِح",
 "きんそく": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه)\nمثال: حصر العدوى في منطقة بؤرية",
 "きんそくしょり": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى…)",
 "きんそしき": "نسيج عضلي (نسيج حيواني يتكون بشكل رئيسي من خلايا منقبضة)",
 "きんぞう": "بيت الكنز (مستودع للكنوز)",
 "きんぞく": "مِيتَال",
 "きんぞくかい": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم) / غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق)",
 "きんぞくかこう": "تشغيل المعادن, مصنوعات معدنية (نشاط صنع الأشياء من المعدن بمهارة)",
 "きんぞくくず": "خردة معدنية (معدن مهمل مناسب لإعادة المعالجة)\nمثال: باع السيارة أخيراً كخردة معدنية",
 "きんぞくけつごう": "رابطة فلزية, رابطة معدنية (رابطة كيميائية يتم فيها مشاركة الإلكترونات عبر العديد من الأنوية ويحدث توصيل…)",
 "きんぞくげんそ": "عنصر فلزي, معدن (أي من عدة عناصر كيميائية تكون عادةً مواد صلبة لامعة موصلة للحرارة أو الكهرباء…)",
 "きんぞくさんかぶつはんどうたい": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه)\nمثال: انتظر لحظة فقط",
 "きんぞくさんかまくはんどうたい": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه)\nمثال: انتظر لحظة فقط",
 "きんぞくせい": "فلزي, معدني (يحتوي على معدن أو مصنوع منه أو يشبهه أو يتسم بخصائصه)\nمثال: مركب معدني / رنين معدني (حالة امتلاك رنين سمعي مشابه للمعدن)",
 "きんぞくたんちき": "كاشف معادن (كاشف يعطي إشارة عند اكتشاف وجود معدن؛ يستخدم للكشف عن وجود قطع معدنية شاردة في…)",
 "きんぞくりょう": "رنين معدني (حالة امتلاك رنين سمعي مشابه للمعدن)",
 "きんたま": "بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "きんたまぶくろ": "صَفَن, كِيس اَلصَّفَن",
 "きんたろうあめ": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "きんたん": "كاشف معادن (كاشف يعطي إشارة عند اكتشاف وجود معدن؛ يستخدم للكشف عن وجود قطع معدنية شاردة في…)",
 "きんだい": "الأوقات المعاصرة, العصر الحديث (ظروف وأفكار العصر الحالي)\nمثال: في أوقات حديثة كهذه",
 "きんだいか": "تَحْدِيث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره…)\nمثال: تم تحديث القاموس.",
 "きんだいしゅぎ": "حداثة, عصرنة (ممارسات نموذجية للحياة أو الفكر المعاصر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "きんだいじん": "إنسان حديث (نويع من الإنسان العاقل؛ يشمل جميع الأعراق الحديثة)",
 "きんだいてき": "عَصْرِيّ, حَدِيث",
 "きんだいぶんめい": "الأوقات المعاصرة, العصر الحديث (ظروف وأفكار العصر الحالي)\nمثال: في أوقات حديثة كهذه",
 "きんだか": "مَجْمُوع",
 "きんだち": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "きんだみ": "ورق الذهب (شكل رقيق جداً من رقائق الذهب)",
 "きんだん": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "きんだんしょうじょう": "عَرَض الانسحاب (أي اضطراب جسدي أو نفسي (مثل التعرق أو الاكتئاب) يعاني منه مدمن المخدرات عند…)",
 "きんだんのかじつ": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "きんだんのこのみ": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "きんちさん": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "きんちてん": "حضيض أرضي (نقطة الحضيض في مدار حول الأرض؛ النقطة في مدار القمر الصناعي حيث يكون أقرب ما…)",
 "きんちゃく": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "きんちゃくあみ": "شباك الجر الكيسية (شبكة مصممة ليتم وضعها بواسطة قاربين حول سرب من الأسماك ثم إغلاقها من الأسفل…)",
 "きんちゃくがに": "مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات)",
 "きんちゃくきり": "نَشَّال",
 "きんちゃん": "زَبُون, عَمِيل",
 "きんちゅう": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / حقن عضلي (حقنة في العضلة)",
 "きんちょう": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة…) / تَوَتُّر\nمثال: لا إنجاز بلا جهد . / توتر عضلي, توترية (التوتر المرن للعضلات الحية والشرايين وما إلى ذلك مما يسهل الاستجابة للمحفزات)\nمثال: اختبر الطبيب توتر عضلاتي",
 "きんちょうかん": "تَوَتُّر\nمثال: لا إنجاز بلا جهد .",
 "きんちょうかんわ": "انفراج, تهدئة (تخفيف التوترات أو العلاقات المتوترة (خاصة بين الدول))",
 "きんちょうがたずつう": "صداع توتري (صداع يقع في مؤخرة الرأس؛ عادة ما يكون ناتجاً عن توتر الجسم الناتج عن الإرهاق أو…)",
 "きんちょうびょう": "فصام تخشبي, فصام جامودي (شكل من أشكال الفصام يتميز بالميل للبقاء في حالة ذهول ثابتة لفترات طويلة؛ قد…)",
 "きんちょく": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)\nمثال: قرار نابع من الضمير بالتحدث علناً عن الظلم",
 "きんつう": "ألم العضلات (ألم في عضلة أو مجموعة من العضلات)",
 "きんつうせいのうせきずいえん": "ـنِي, ـنِيَ",
 "きんつば": "سلاح ذو عمود, فأس الحرب (سلاح قتال قريب يتم فيه تثبيت الجزء القتالي الرئيسي من السلاح في نهاية عمود…)\nمثال: نظراً لاحتوائها على القليل نسبياً من المعدن، فإن الأسلحة ذات الأعمدة رخيصة الصنع، مما جعلها السلاح المفضل للمجندين الفلاحين",
 "きんてい": "رَسْمِيّ, مُخَوَّل (ممنوح السلطة)\nمثال: بلاغ رسمي",
 "きんていえいやくせいしょ": "آب (الشهر الحادي عشر من السنة المدنية؛ الشهر الخامس من السنة الدينية في التقويم…)",
 "きんてき": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "きんてつ": "ثَبَات",
 "きんてん": "حضيض, نقطة الحضيض ((في الفلك) النقطة في المدار الأقرب إلى الجسم الذي يتم الدوران حوله)",
 "きんてんかく": "شُذُوذ",
 "きんてんげつ": "شهر انحرافي, شهر شذوذي (الفترة بين حضيضين متتاليين؛ حوالي 27.5546 يوماً)",
 "きんてんねん": "سنة شاذة (وقت دوران الأرض من الحضيض إلى الحضيض مرة أخرى؛ 365 يومًا و 6 ساعات و 13 دقيقة و…)",
 "きんてんりかく": "شُذُوذ",
 "きんでんけい": "جهاز تخطيط كهربائية العضل (أداة طبية تسجل الموجات الكهربائية المرتبطة بنشاط العضلات الهيكلية)",
 "きんでんず": "تخطيط العضلات, مخطط كهربية العضل (سجل بياني للتيارات الكهربائية المرتبطة بتقلصات العضلات)",
 "きんでんずけんさ": "تخطيط كهربائية العضل (تشخيص الاضطرابات العصبية العضلية باستخدام جهاز تخطيط كهربائية العضل)",
 "きんとう": "عِدْل (عَدْل)\nمثال: هل يعاملون بالعدل / شَرْق أَدْنَى (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "きんとうか": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة)",
 "きんとうわり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "きんとき": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر. / بَطَاطَا حُلْوَة",
 "きんときいも": "بَطَاطَا حُلْوَة",
 "きんとと": "سَمَكَة زِينة (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "きんど": "شهامَة",
 "きんにく": "عَضَلَة\nمثال: توم شعر بالقوة.",
 "きんにくさいぼう": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "きんにくしかんざい": "مرخي عضلات (عقار يقلل من انقباض العضلات عن طريق منع انتقال النبضات العصبية أو عن طريق تقليل…)",
 "きんにくしつ": "عَضَلِيّ / مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال.",
 "きんにくせんい": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "きんにくだるま": "مُتَصَلِّبُ العَضَلَات (ذُو عَضَلَاتٍ مُتَصَلِّبَةٍ نَتِيجَةَ الإِفْرَاطِ فِي التَّمَارِينِ)",
 "きんにくちゅうしゃ": "حقن عضلي (حقنة في العضلة)",
 "きんにくつう": "ألم العضلات (ألم في عضلة أو مجموعة من العضلات)",
 "きんにくない": "داخل العضل (داخل العضلة)\nمثال: حقنة في العضل",
 "きんにくないちゅうしゃ": "حقن عضلي (حقنة في العضلة)",
 "きんにくりゅうりゅう": "عَضَلِيّ",
 "きんの": "أَمْس",
 "きんのうむけつ": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "きんのたまご": "منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "きんはんげん": "إِغْلَاق, اِسْتُوبْل (قاعدة إثبات تمنع الشخص من إنكار حقيقة واقعة تم تسويتها بالفعل)",
 "きんばい": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في…)",
 "きんばえ": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "きんばく": "تقييد جنسي (ممارسة جنسية تتضمن تقييد أحد الشريكين جسديًا (بالحبال أو الأصفاد))\nمثال: كان في عبودية للخوف",
