 "くうていたいいん": "مِظَلِّيّ",
 "くうていぶたい": "مظليين (مشاة مدربون ومجهزون للقفز بالمظلات)",
 "くうていへい": "مِظَلِّيّ",
 "くうていほ": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً) / أبله, طائش (شخص بسيط طائش ومشتت الذهن)\nمثال: إنها بلهاء تماماً",
 "くうてがた": "شيك بدون رصيد (شيك يتم رفضه عند التقديم لعدم كفاية الأموال)\nمثال: إصدار شيك بدون رصيد هو شكل من أشكال السرقة",
 "くうてん": "سباق (رياضة المشاركة في مسابقات السرعة)",
 "くうでん": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "くうどう": "تَجْوِيف / أَجْوَف",
 "くうどうきょうしんき": "حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "くうはく": "فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص / خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "くうはくきかん": "فَتْرَة",
 "くうばく": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "くうひ": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "くうふく": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "くうふくじ": "صَوْم, صِيَام",
 "くうぶん": "بريد ميت, رسالة مهملة (بريد لا يمكن تسليمه ولا إعادته) / حبر على ورق, قانون مهمل (حالة شيء فقد أهميته أو فعاليته)",
 "くうほう": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة. / فجوة (تجويف صغير مملوء بالسائل في سيتوبلازم الخلية)",
 "くうほうか": "تشكل فجوات, تفجي (حالة الامتلاء بالفجوات)",
 "くうぼ": "حَمَلَةُ طَائِرَات",
 "くうゆ": "نقل جوي (النقل عن طريق الجو)",
 "くうらん": "فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص",
 "くうりき": "أَيْرُودِينَامِيَّة, دِينَامِيكَا هَوَائِيَّة",
 "くうれいしき": "مُبَرَّد بِالْهَوَاء (مُبرَّد بتيّار من الهواء)",
 "くうろ": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "くうろんか": "دُوغْمَائِيّ, عَقَائِدِيّ (متمسك بالنظرية بعناد دون مراعاة للجانب العملي أو الملاءمة) / دوغمائي, متزمت (شخص عنيد ذو آراء تعسفية أو متعجرفة)",
 "くえき": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب. / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "くえない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء. / غير صالح للأكل (غير مناسب كطعام)",
 "くえん": "تُرُنْج",
 "くえんさん": "حمض الستريك, حمض الليمون (حمض ضعيف قابل للذوبان في الماء يوجد في العديد من الفواكه (خاصة الحمضيات)؛ يستخدم كعامل منكه)",
 "くえんさんえん": "سيترات (ملح أو إستر لحمض الستريك)",
 "くえんさんかいろ": "دورة حمض الستريك, دورة كريبس (في جميع النباتات والحيوانات: سلسلة من التفاعلات الإنزيمية في الميتوكوندريا تتضمن الأيض التأكسدي لمركبات الأسيتيل لإنتاج مركبات الفوسفات عالية الطاقة…)",
 "くおうるに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "くおん": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "くかいせき": "دولوميت (معدن فاتح اللون يتكون من كربونات الكالسيوم والمغنيسيوم؛ مصدر للمغنيسيوم؛ يستخدم كخزف وكسماد) / دولوميت (نوع من الصخور الرسوبية يشبه الرخام أو الحجر الجيري ولكنه غني بكربونات المغنيسيوم)",
 "くかく": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "くかくず": "خريطة مساحية, مخطط أرض (خريطة تظهر الميزات المخططة أو الفعلية لمنطقة (شوارع وقطع أراضي بناء وما إلى ذلك))",
 "くかくせいり": "تخطيط حضري, تخطيط مدن (تحديد ووضع خطط للترتيب المادي المستقبلي وحالة المجتمع السكني)",
 "くかん": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "くがい": "حَبَق اَلرَّاعِيّ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / خَارِج, بره",
 "くがくせい": "مُسْتَقِلٌّ مَالِيًّا, مُعِيلٌ لِنَفْسِه (مُسْتَقِلٌّ مِنَ النَّاحِيَةِ المَالِيَّة)",
 "くがつ": "سِبْتِمْبِر, سِبْتَمْبِر (الشهر التاسع في السنة الروميّة)\nمثال: بدأ سامي عامه الجامعي في سبتمبر.",
 "くがね": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبِي\nمثال: ذهب إلى الدكان.",
 "くき": "سَاق / كَهْف, غَار / أَوْجٌ, ذُرْوَةٌ",
 "くきょう": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية / إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "くぎ": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير. / تَضْحِيَة, قُرْبَان / ضَحَّى",
 "くぎうちき": "آلة برشمة (آلة لدق المسامير)",
 "くぎづけ": "مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "くぎに": "رماه الرمال, سمك الرمل (أسماك صغيرة جداً فضية اللون تشبه الثعابين تعيش في أسراب وتحفر في الشواطئ الرملية)",
 "くぎぬき": "كَلْبَتَان",
 "くぎょう": "كَفَّارَة / سِرّ التَوْبَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / عَالِيّ الرُتْبَة",
 "くぎょうしゃ": "نُسُكِيّ / نَاسِك",
 "くぎり": "تَوَقَّفَ / تَوَقُّف, وَقْف / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "くぎりきごう": "جهاز طرد مركزي, فراز (جهاز يستخدم قوة الطرد المركزي لفصل الجزيئات عن المعلق)",
 "くぎる": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "くぎ抜き": "كَلْبَتَان",
 "くぎ煮": "رماه الرمال, سمك الرمل (أسماك صغيرة جداً فضية اللون تشبه الثعابين تعيش في أسراب وتحفر في الشواطئ الرملية)",
 "くく": "جَدْوَل ضَرْب / مُخْتَلِف, مُتَنَوَّع / تَافِه / بهيج, مفرح (مليء بـأو يتميز بالفرح)\nمثال: شعر بانطلاق بهيج",
 "くくい": "تَمّ, قُقْنُس",
 "くくっ": "قَرْقَرَة, مُنَاغَاة / هَدَلَ",
 "くくのひょう": "جَدْوَل ضَرْب",
 "くくむ": "اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى / ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "くくり": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / إِبَالَة, حُزْمَة / نَتِيجَة",
 "くくりつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "くくり付ける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "くくる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / لَخَّصَ, اِخْتَصَرَ / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "くぐい": "تَمّ, قُقْنُس",
 "くぐつし": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "くぐつめ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "くぐまる": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "くぐむ": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس) / انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "くぐり": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "くぐりど": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "くぐりぬける": "اِخْتَرَقَ, نَفَذَ / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "くぐり戸": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "くぐり抜ける": "اِخْتَرَقَ, نَفَذَ / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "くぐる": "اِخْتَرَقَ, نَفَذَ / غَاصَ / غَطْسَ, يقفز الى الماء / نَجَا",
 "くけい": "مُسْتَطِيل",
 "くけぬい": "خياطة مخفية (خياطة لا تُرى أو تلاحظ بسهولة)",
 "くけ縫い": "خياطة مخفية (خياطة لا تُرى أو تلاحظ بسهولة)",
 "くげ": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "くげしゅ": "رجل حاشية (مرافق في بلاط الحاكم)",
 "くげしゅう": "رجل حاشية (مرافق في بلاط الحاكم)",
 "くげん": "تحريض, حث (تواصل يهدف إلى حث أو إقناع المتلقين باتخاذ إجراء ما) / تحريض, حث (فعل الحث؛ محاولة جادة للإقناع) / مُعَانَاة",
 "くげんをていする": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "くこうぞうきそく": "بناء الجملة, نحو (الترتيب النحوي للكلمات في الجمل)",
 "くこうぞうぶんぽう": "بناء الجملة, نحو (الترتيب النحوي للكلمات في الجمل)",
 "くこん": "غاية, غَرَض",
 "くさ": "حَشِيش, عُشْب / حَشِيش / نِينْجَا, نِنْجَا / مَارِهْوَانَا, حَشِيش / دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أَكْزِيمَا / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / اِخْتِلَاف",
 "くさい": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز) / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / مُبَالِغ فِي التَّمْثِيل (مُتَكَلَّف فِي الأَدَاء الدِّرَامِيّ؛ مُبَالَغ فِيه) / أَخْرَق / خَلَاص, تَطْهِير اَلنَّفْس",
 "くさかげろう": "شبكية الأجنحة الخضراء (ذبابة شبكية الأجنحة خضراء شاحبة كريهة الرائحة لها يرقات آكلة للحوم)",
 "くさかり": "جَزَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "くさかりき": "جزازة العشب (أداة حديقة لجز العشب في المروج)",
 "くさがれ": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "くさき": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "くさぐさ": "مُخْتَلِف, مُتَنَوَّع",
 "くさごえ": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "くさずり": "واقي الفخذ العلوي (واحدة من قطعتين من الدرع الصفيحي تتدليان من تنورة الدرع لحماية الفخذين العلويين)",
 "くさそてつ": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "くさぞうし": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "くさち": "مَرْعَى",
 "くさっぱら": "مَرْعَى",
 "くさとり": "عُشْبَة ضَارَّة / بانْجو, حَشيش / أداة إزالة الأعشاب, نازعة الأعشاب (أداة يدوية لإزالة الأعشاب الضارة) / مزيل الأعشاب (عامل مزرعة يتم تعيينه لإزالة الأعشاب الضارة)",
 "くさのね": "شَعْبِيّ قَاعِدِيّ (يتعلق بعامة الناس بوصفهم جماعة سياسية واقتصادية أساسية) / شَعْبِيّ, قَاعِدِيّ (أساسيّ نابع من القاعدة الشعبية)",
 "くさはえる": "ضَحْكَة / ضَحِكَ, ضحك (أثار الضحك أو جعل شخصًا يضحك بشيء مضحك أو طريف؛ سلّى أو أبهج شخصًا بجعل الأجواء مرحة)\nمثال: ضحك الجميع علي.",
 "くさはら": "مَرْعَى",
 "くさばな": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "くさび": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "くさびいし": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "くさびがた": "إسفين, وتد (أي شكل مقطعه العرضي مثلث)",
 "くさびがたもじ": "مِسْمَارِيَّة",
 "くさびじょう": "إِسْفِينِيّ الشَّكْل ((عن شكل الورقة) مُثلَّث ضيّق أعرض عند القمّة ويضيق نحو القاعدة) / إسفيني, مسماري (على شكل وتد)",
