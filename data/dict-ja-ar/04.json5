 "くつろぎ": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "くつろぐ": "اِسْتَرْخَى",
 "くつろげる": "فَضْفَاض, واسِع",
 "くつわ": "بِت (انقطع؛ قَطَع)",
 "くつわや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "くつわをならべて": "مَعًا, سَوِيًّا",
 "くつわを並べて": "مَعًا, سَوِيًّا",
 "くつクリーム": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "くて": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "くてん": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "くで": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "くとう": "عَلَامَة تَرْقِيم, تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "くとうてん": "عَلَامَة تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "くど": "بيريكلاز, مغنيسيا (معدن صلب أبيض يوجد بشكل طبيعي كأكسيد مغنيسيوم؛ مصدر للمغنيسيوم) / كانون",
 "くどい": "تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية / ثَقِيل / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط)",
 "くどう": "قَادَ, سَاقَ",
 "くどうき": "قَادَ, سَاقَ",
 "くどうし": "فعل مركب (فعل إنجليزي يتبعه حرف أو أكثر حيث يتصرف المزيج كوحدة نحوية ودلالية)",
 "くどうぶ": "قَادَ, سَاقَ",
 "くどうりん": "عجلة القيادة, عجلة دافعة (عجلة تحرك مركبة (تحول عزم الدوران إلى قوة سحب))",
 "くどき": "استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال",
 "くどきおとす": "أَقْنَعَ",
 "くどきもんく": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "くどき文句": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "くどく": "جَدَارَة / غريس / أَقْنَعَ / أَغْرَى, أَغْوَى",
 "くどくぞう": "بيت الكنز (مستودع للكنوز)",
 "くどくど": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل",
 "くどくどしい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "くながい": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "くなくな": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة / بِدَلَال, بِغُنْج (بطريقة مغازلة)\nمثال: ابتسمت بغنج",
 "くなん": "مُعَانَاة",
 "くなんのこうぐん": "كوري شمالي (من أو يتعلق بكوريا الشمالية أو شعبها أو ثقافتها أو يميزهم)",
 "くに": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما…)\nمثال: كان زيري من ولاية أخرى. / مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / قَذَارَة",
 "くにがわ": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "くにくのさく": "الملاذ الأخير, حل يائس (وسيلة لا يتم اللجوء إليها إلا عند اليأس)",
 "くにぐに": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "くにことば": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا)\nمثال: هم لا يتحدثون لغتنا",
 "くにざかい": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "くにじゅう": "جَمِيع أَنْحَاء, كُلّ",
 "くにする": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "くにつち": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "くにところ": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "くになる": "تَأَلَّمَ, عَانَى\nمثال: لقد عانى جمال كثيرا.",
 "くにのはは": "إِمْبِرَاطُورَة, مَلِكَة",
 "くにびと": "مَحَلِّيّ",
 "くにます": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام…)",
 "くにもと": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد…)\nمثال: دفنت في مسقط رأسها.",
 "くにもの": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "くにゃっと": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "くにゃり": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "くにやむ": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "くねくね": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "くねらす": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "くねる": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "くのいち": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "くのう": "أَلَم (الوَجَع)\nمثال: ألم أقل لك ذلك؟ / تَأْثِير, أَثَر",
 "くの一": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "くはい": "اِمْتِحَان, تَجْرُبَة (اِمْتِحَان)\nمثال: لدي امتحان غدا.",
 "くはらくのたね": "مَنْ جَدَّ وَجَدَ وَمَنْ زَرَعَ حَصَدَ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "くばりもの": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "くばる": "وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "くばんざくろいし": "بيروب (عقيق أحمر عميق يستخدم كحجر كريم)",
 "くぱくぱ": "نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من…)\nمثال: يبدو أن النبضات قادمة من نجم / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "くひゃく": "تِسْعُمِئَة, تِسْعُمِائَة / مُغَفَّل, أَحْمَق",
 "くび": "رَقَبَة, عُنُق / رَئِيس, رَئِيسَة\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / إِقَالَة",
 "くびかざり": "قِلَادَة",
 "くびかせ": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها…)",
 "くびかみ": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة)",
 "くびき": "فَدَّان / متطلب",
 "くびきごほう": "تلازم لفظي, زوغما (استخدام فعل مع مكملين أو أكثر، واللعب على تعدد معاني الفعل، لتأثير فكاهي)",
 "くびきり": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / إطلاق نار (فعل إطلاق النار من بندقية)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "くびきりやくにん": "جَلَّاد",
 "くびきる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "くびき語法": "تلازم لفظي, زوغما (استخدام فعل مع مكملين أو أكثر، واللعب على تعدد معاني الفعل، لتأثير فكاهي)",
 "くびじっけん": "بِطَاقَة هُوِيَّة",
 "くびす": "عَقِب, كَعْب",
 "くびすをかえす": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "くびすを返す": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "くびったけ": "بتهور, رأساً على عقب (في عجلة مضطربة)",
 "くびったま": "رَقَبَة, عُنُق",
 "くびづか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "くびづな": "رِبَاط",
 "くびながりゅう": "بليزيوصور (زاحف بحري منقرض برأس صغير على رقبة طويلة وذيل قصير وأربعة أطراف على شكل مجداف…)",
 "くびなし": "بلا رأس, مقطوع الرأس (ليس له رأس أو تشكل بدون رأس)\nمثال: الفارس بلا رأس",
 "くびなわ": "رِبَاط",
 "くびにする": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "くびひも": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة)",
 "くびふり": "تَذَبْذُبِيّ, مُتَذَبْذِبٌ (ذو اهتزازات دورية)",
 "くびまき": "وِشَاح, لِفاع",
 "くびれ": "انقباض, تضيق (فعل أو عملية الضغط)\nمثال: شعر بانقباض في صدرها / خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "くびれる": "شَدَّ, ضَيَّقَ",
 "くびれフェチ": "خصر النحلة (خصر نحيل جداً)",
 "くびわ": "يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / قِلَادَة",
 "くびわペッカリー": "بيكاري مطوق (بيكاري رمادي داكن ذو طوق أبيض غير واضح؛ من المناطق شبه الصحراوية في المكسيك…)",
 "くびをおとす": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "くびをきる": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "くびをしめる": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "くびをすくめる": "زَغَبُ البَطّ (ريش البط الناعم)",
 "くびをそろえる": "اجتماع, تجمع (تجمع اجتماعي صغير غير رسمي)\nمثال: كان هناك اجتماع غير رسمي في غرفة معيشتي",
 "くびをたてにふる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "くびをつる": "عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة.",
 "くびをはねる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "くびをよこにふる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "くぴた": "رَقَبَة, عُنُق",
 "くふ": "خَوْف, وَهَل\nمثال: خاف زيري نوعا ما.",
 "くふう": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / أَدَاة, جِهَاز",
 "くふうざい": "طارِد لِلرِّياح (يُساعِد عَلى طَرْد الغازات مِن الجِهاز الهَضْمِيّ)",
 "くふうやく": "طارِد لِلرِّياح (يُساعِد عَلى طَرْد الغازات مِن الجِهاز الهَضْمِيّ)",
 "くぶ": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "くぶくりん": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد / تِسْعَة وَتِسْعُيون",
 "くぶどおり": "تَقْرِيبًا / على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "くぶん": "تَقْسِيم\nمثال: الزواج قسمة و نصيب. / تَصْنِيف",
 "くぶんしょゆうたてもの": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة…)",
 "くぶんたてもの": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة…)",
 "くべつ": "تَمْيِيْز",
 "くべつだて": "تفاضل (العملية الرياضية للحصول على مشتق دالة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "くべる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "くほ": "ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "くほう": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "くぼ": "أَجْوَف / مَهْبَل",
 "くぼう": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "くぼたまり": "أَجْوَف",
 "くぼち": "أَجْوَف",
 "くぼまる": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "くぼみ": "أَجْوَف\nمثال: 後ろのドアにへこみができた。 — لديهم بعجة في الباب الخلفي .",
 "くぼむ": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "くぼめる": "تَجَوَّفَ",
 "くま": "دُبّ / زَاوِيَة, رُكْن / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات)",
 "くまおくり": "تضحية, قتل شعائري (فعل قتل (حيوان أو شخص) استرضاءً لإله)",
 "くまこうはちこう": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "くまさんはっつあん": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "くまで": "مِدَمَّة, مُشْط",
 "くまでしょう": "جشع, طمع (رغبة مفرطة في الثروة (عادة بكميات كبيرة))\nمثال: جشع المحامين",
 "くまでばば": "قَابِلَة, دَايَة",
 "くまどり": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات)",
 "くまどる": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "くまなく": "جَمِيع أَنْحَاء, كُلّ\nمثال: 彼は戸を白のペンキでくまなく塗った。 — دهن الباب بالأبيض. / بتألق, بسطوع\nمثال: تألقت النجوم بسطوع",
 "くまねこ": "بَنْدَة, بانْدا",
 "くまねずみ": "جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم)",
 "くまのみ": "سَمَكَة المُهَرِّج (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "くまばち": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في…)",
 "くまむし": "بطيء الخطو, دب الماء (مفصلي من شعبة بطيئات الخطو)",
 "くまもと": "كُومَامُوتُو",
 "くまんばち": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في…)",
 "くま取り": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات)",
 "くみ": "صِنْف, صَنْف\nمثال: اقرأ هذا الفصل. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / لُوط / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / مَرَارَة",
 "くみあい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "くみあいいん": "نقابي (عامل ينتمي إلى نقابة عمالية)",
 "くみあいいんしょう": "بطاقة نقابية (بطاقة تثبت العضوية في نقابة عمالية)",
 "くみあいしゅぎ": "النقابية (نظام أو مبادئ ونظرية النقابات العمالية)",
 "くみあいせんじゅうしゃ": "بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "くみあげる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن…)\nمثال: ألف شكر على لطفك.",
 "くみあわさる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "くみあわす": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "くみあわせ": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد)",
 "くみあわせじょう": "قفل أرقام, قفل مركب (قفل لا يمكن فتحه إلا عن طريق تدوير الأقراص بتسلسل خاص)",
 "くみあわせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "くみいと": "ضَفَّرَ, ضَفَرَ",
 "くみいれ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / عُشّ\nمثال: كان دوري كي أنظف المسكن",
 "くみいれる": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "くみいん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "くみうち": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة",
 "くみかえ": "إعادة ترتيب (تغيير ترتيب شيء ما)",
 "くみかえる": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "くみかえディーエヌエー": "حمض نووي معاد التركيب (حمض نووي معدل وراثياً يُصنع عن طريق إعادة دمج أجزاء من الحمض النووي من كائنات…)",
 "くみきょく": "حَشَم (استحيا أو شعر بالحياء؛ منعه من التصرف بحرية بدافع الحياء أو الاحترام)",
 "くみこ": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه. / قائم النافذة (شريط رأسي غير هيكلي بين مصاريع أو ألواح النافذة (أو ألواح الشاشة))",
 "くみこみ": "إقحام, لقطة دخيلة ((سينما) صورة ثابتة يتم إدخالها وتقاطع أحداث الفيلم) / مَبْنِيّ, مُدْمَج",
 "くみこみかんすう": "مَبْنِيّ, مُدْمَج",
 "くみこみコマンド": "مَبْنِيّ, مُدْمَج",
 "くみこむ": "أَدْخَلَ",
 "くみした": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "くみしやすい": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات)\nمثال: عقول شابة طيعة",
 "くみする": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "くみそ": "مادة مرة, مبدأ مر (أي من مئات المركبات ذات الطعم المر؛ ولا تندرج تحت تصنيف كيميائي محدد)",
 "くみたて": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "くみたてこう": "برنامج تجميع, مجمّع (برنامج لتحويل لغة التجميع إلى لغة الآلة)",
 "くみたてこうじょう": "مصنع تجميع (مصنع يتم فيه تجميع الأجزاء المصنعة لتكوين منتج نهائي)",
 "くみたてしき": "ضربة قاضية (ضربة تسقط الخصم عن قدميه)",
 "くみたてる": "تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة)\nمثال: 昨日、アンプを組み立てた。 — صنعتُ مُضَخِّمًا أمس. / صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "くみたてライン": "خط إنتاج, خط تجميع (نظام ميكانيكي في مصنع يتم بموجبه نقل السلعة عبر مواقع يتم فيها إجراء عمليات…)",
 "くみちょう": "رَئِيس, رَئِيسَة",
 "くみつく": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة",
 "くみつけ": "فَرْض / تَجْمِيع, مَجْمَع (مصدر جَمَّعَ)\nمثال: أنشؤوا جمعية سينمائية.",
 "くみて": "ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم) / مَقْبِض / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)",
 "くみとり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "くみとりしきべんじょ": "مِرْحَاض, تواليت",
 "くみとりべんじょ": "مِرْحَاض خَارِجِيّ",
 "くみとる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "くみなおす": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "くみはん": "تَنْضِيد / صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "くみひも": "ضَفَّرَ, ضَفَرَ",
 "くみふだ": "بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "くみもの": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / سطح معمد ((في العمارة) الهيكل المكون من جزء المعبد الكلاسيكي الواقع فوق الأعمدة بين التاج…)",
 "くみ上げる": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "くみ取り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "くみ取り便所": "مِرْحَاض خَارِجِيّ",
 "くむ": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا / وَرَثَ / صَلِيب\nمثال: عبر جرذ الطريق. / تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة) / ضَفَّرَ, ضَفَرَ / عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة",
 "くめん": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "くも": "سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "くもい": "سَمَاء, سما / سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "くもかすみ": "ثَوْل (بدا فيه الجنون) / فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء)\nمثال: استلقى متربصاً",
 "くもがく": "علم السحب (فرع الأرصاد الجوية الذي يدرس السحب وتكوينها)",
 "くもがくれ": "اختفاء مفاجئ, تلاشي (اختفاء مفاجئ عن الأنظار)\nمثال: あいつどこに雲隠れしたのかな。 — أتساءل أين يختبئ.",
 "くもがたるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "くもきょうふしょう": "رُهَاب اَلْعَنَاكِب",
 "くもざる": "سَعْدَان عَنْكَبُوتِيّ, آتِل",
 "くもすけ": "بَلْطَجِيّ",
 "くもつ": "قُرْبَان",
 "くもつく": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "くもつだい": "مَذْبَح, هَيْكَل",
 "くもで": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "くもなく": "بِسُهُولَة",
 "くものす": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "くものすかび": "ريزوبوس (أي من الفطريات المسببة للعفن المختلفة من جنس ريزوبوس)",
 "くもひとつない": "خَالٍ مِنَ الغُيُوم, صَافٍ (خالٍ من الغيوم)",
 "くもひとで": "نجم البحر الهش (حيوان يشبه نجم البحر بأذرع هشة تشبه السوط تشع من قرص مركزي صغير)",
 "くもまく": "أم عنكبوتية, غشاء عنكبوتي (الوسطى من السحايا الثلاث)",
 "くもまくかくう": "الحيز تحت العنكبوتية (مساحة في السحايا تحت الغشاء العنكبوتي وفوق الأم الحنون تحتوي على السائل النخاعي)",
 "くもみず": "شَحَّاذ, مُتَسَوِّل (يُمَارِسُ الاسْتِجْدَاءَ وَالتَّسَوُّل)",
 "くもゆき": "طَقْس, جَوّ / حَالَة, وَضْع",
 "くもらす": "اسوداد, صدأ (تغير لون السطح المعدني الناتج عن الأكسدة)",
 "くもらせる": "سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "くもり": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً)\nمثال: 昨日、東京は曇りでしたか。 — أكان الجو غائماً في طوكيو البارحة؟ / ضَبَاب, شبورة / قتامة, كآبة (شعور بتوجس كئيب)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "くもりど": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء)",
 "くもるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "くもをかすみと": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء)\nمثال: استلقى متربصاً",
 "くもをつかむよう": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "くもをつく": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "くもん": "عذاب, غم (ضيق عقلي شديد)",
 "くもんじょ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "くも膜": "أم عنكبوتية, غشاء عنكبوتي (الوسطى من السحايا الثلاث)",
 "くも膜下腔": "الحيز تحت العنكبوتية (مساحة في السحايا تحت الغشاء العنكبوتي وفوق الأم الحنون تحتوي على السائل النخاعي)",
 "くやくしょ": "مَجْلِس\nمثال: كان سامي يعيش في مجمع مسور.",
 "くやしい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "くやしさ": "إذلال, انكسار (مشاعر قوية من الإحراج)",
 "くやしなみだ": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما)\nمثال: حركة المرور في نيويورك مصدر قلق دائم",
 "くやしまぎれ": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع)",
 "くやしーい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "くやみ": "تَأْسِيَة",
 "くやむ": "نَدَبَ / نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "くゆ": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "くゆらす": "دُخَان, دخان\nمثال: دخن زيري سيجارة.",
 "くよくよ": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / بقلق (بطريقة قلقة)\nمثال: قالت بقلق: 'أتساءل ماذا أفعل'",
 "くら": "مَخْزَن, مُسْتَوْدَع / سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته) / مُسَابَقَة",
 "くらい": "غَامِق, دَاكِن / مُحْبَط, مُكْتَئِب / مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / حَوَالَيْ, تَقْرِيبًا / عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / دَرَجَة / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "くらいする": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "くらいつく": "قَضَمَ",
 "くらいづけ": "ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "くらいどり": "دَرَجَة",
 "くらいどりひょうきほう": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة…)",
 "くらいどりひょうげんほう": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة…)",
 "くらいどる": "مِقْيَاس\nمثال: هم يريدون السلم.",
 "くらいなら": "بَدَلًا مِن",
 "くらいのたかい": "عَالِيّ الرُتْبَة",
 "くらいのもの": "وَحِيد",
 "くらいれ": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "くらう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "くらがえ": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "くらがり": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "くらきみち": "هَادِيس",
 "くらくら": "بدوار, بدوخة (بطريقة دوارة أو خفيفة الرأس)\nمثال: مشى حوله بدوار",
 "くらさ": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "くらざらえ": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "くらし": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "くらしがたつ": "اِرْتَزَقَ",
 "くらしき": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "くらした": "سيرلوين (جزء من الخاصرة (وخاصة في البقر) يقع أمام الكفل مباشرة)",
 "くらしぶり": "نَمَط الحَيَاة",
