 "ぎょく": "مَصْيَدَة / جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية. / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / غَيْشَا",
 "ぎょくえい": "قَرِيس, قَرِيت",
 "ぎょくおんほうそう": "بث إذاعي (بث عبر الراديو)",
 "ぎょくざ": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "ぎょくしゅ": "مُرْتَفِع الدَّرَجَة",
 "ぎょくしょう": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "ぎょくずい": "عقيق أبيض, كالسيدوني (كوارتز حليبي أو رمادي نصف شفاف إلى شفاف)",
 "ぎょくせきこんこう": "تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "ぎょくと": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "ぎょくもん": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "ぎょくりん": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "ぎょぐ": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "ぎょけい": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية.",
 "ぎょこう": "بُرْج اَلْحُوت, اَلْحُوت (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً)",
 "ぎょさい": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "ぎょし": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "ぎょしがたい": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / صعب المراس, مستعصٍ (يصعب التحكم فيه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه) / ثقيل, صعب الاستخدام (صعب الاستخدام أو التعامل معه أو إدارته بسبب الحجم أو الوزن أو الشكل)\nمثال: طفل صعب المراس",
 "ぎょしゃ": "حوذي (رجل يقود عربة خيول)",
 "ぎょしゃざ": "سائق العربة الحربية (سائق العربة)",
 "ぎょしやすい": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات) / سهل الانقياد, طَيِّع (سهل الإدارة (التحكم أو التعليم أو التشكيل))\nمثال: عقول شابة طيعة",
 "ぎょしゅ": "نوع سمكي (نوع من الأسماك)",
 "ぎょしゅう": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً)",
 "ぎょしょう": "صلصة السمك, صوص السمك",
 "ぎょしょく": "فَحْشَاء, فِسْق",
 "ぎょしょくか": "شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "ぎょしん": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "ぎょす": "قَادَ, سَاقَ / سَاقَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "ぎょする": "قَادَ, سَاقَ / سَاقَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "ぎょせい": "بطروح, مني السمك (السائل المنوي الذي تنتجه ذكور الأسماك) / سرء, مني السمك (حيوانات منوية للسمك أو غدة تناسلية ممتلئة بالحيوانات المنوية؛ لها قوام كريمي)",
 "ぎょせん": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً)",
 "ぎょせんいん": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょせんのりくみいん": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょぞく": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "ぎょたい": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "ぎょたく": "أَرْشِيف",
 "ぎょっと": "مَفْزُوع, مُرْتَاع (أُثير بمفاجأة أو فزع مفاجئ فقام بحركة لا إرادية)",
 "ぎょてい": "سلم الأسماك (سلسلة من الأحواض الصاعدة توفر ممرًا لسمك السلمون للسباحة عكس التيار متجاوزًا سدًا)",
 "ぎょどう": "سلم الأسماك (سلسلة من الأحواض الصاعدة توفر ممرًا لسمك السلمون للسباحة عكس التيار متجاوزًا سدًا)",
 "ぎょふ": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "ぎょふん": "مسحوق السمك (سمك مجفف مطحون يستخدم كسماد وعلف للماشية المنزلية)",
 "ぎょもう": "شَبَكَة صَيْد",
 "ぎょゆ": "زَيْت السَّمَك (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "ぎょらい": "طُرْبِيد",
 "ぎょらいてい": "قارب طوربيد (سفينة حربية صغيرة عالية السرعة مصممة لهجمات الطوربيد في المياه الساحلية)",
 "ぎょらいはっしゃかん": "أنبوب طوربيد (أنبوب بالقرب من خط الماء للسفينة يتم من خلاله إطلاق الطوربيد)",
 "ぎょらん": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "ぎょらんいし": "أوليث",
 "ぎょりゅう": "إكتيوصور (أي من الزواحف البحرية المتعددة من حقبة الحياة الوسطى لها جسم يشبه خنزير البحر مع زعانف ظهرية وذيلية وأطراف على شكل مجداف)",
 "ぎょりゅうばい": "نِيُوزِيلَانْدَا, نِيُوزِيلَنْدَا / نْيُوزِيلَنْدِيّ",
 "ぎょりょう": "مَصْيَدَة",
 "ぎょりん": "فِلْس, قِشْرَة سَمَك (حرشفة من النوع الذي يغطي أجسام الأسماك)",
 "ぎょりんせん": "سماك (أي من العديد من الأمراض الخلقية التي يكون فيها الجلد جافاً ومتقشراً مثل السمكة)",
 "ぎょるい": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "ぎょるいがく": "عِلْم اَلْأَسْمَاك (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ぎょろう": "صَيْد سَمَك, صَيْد",
 "ぎょろぎょろ": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة",
 "ぎょろり": "شَاخِص, مُحَمْلِق ((يوصف به العينان) مفتوحتان وجامدتان كما في حالة خوف أو دهشة)",
 "ぎょーさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة)",
 "ぎよう": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "ぎよく": "رهان أولي ((بوكر) المساهمة الأولية التي يقدمها كل لاعب في مجموع الرهان)",
 "ぎらい": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "ぎらぎら": "بشكل صارخ (بطريقة صارخة وواضحة جداً)\nمثال: كان واضحاً بشكل صارخ",
 "ぎらっと": "بشكل ساطع, بشكل مبهر (بطريقة أو لدرجة تبهر الناظر)",
 "ぎらつく": "وَهَج / لَمَعَ, بَرَقَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "ぎらり": "شَاخِص, مُحَمْلِق ((يوصف به العينان) مفتوحتان وجامدتان كما في حالة خوف أو دهشة)",
 "ぎり": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب. / صهر, نسيب (قريب عن طريق الزواج)",
 "ぎりあい": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "ぎりいっぺん": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / شَكْلِيّ, صُورِيّ (يُؤَدَّى أَوْ يُنْتَجُ كَإِجْرَاءٍ شَكْلِيٍّ فَحَسْبُ)",
 "ぎりぎり": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف / بزخم, بقوة (بكامل القوة والتأثير)\nمثال: نحن نشاهد هذا الفيلم متأخرين جداً لنشعر بتأثيره الأصلي بقوة",
 "ぎりにも": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "ぎりにんじょう": "التزام أخلاقي (التزام ينشأ عن اعتبارات الصواب والخطأ)",
 "ぎりのあに": "أخ غير شقيق (أخ يشترك معك في أحد الوالدين فقط)",
 "ぎりのあね": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "ぎりのちち": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "ぎりのはは": "حَمَاة",
 "ぎりまん": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぎりょう": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "ぎりんけい": "بصلة كاذبة (تضخم صلب يشبه البصلة في ساق بعض بساتين الفاكهة)",
 "ぎりマン": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぎる": "ضربة قوية عشوائية (ضربة كاسحة أو عنيفة)",
 "ぎれい": "أَدَب, مَجَامَلَة (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب. / رصد, مراقبة (فعل المراقبة؛ أخذ نظرة متأنية) / اِحْتِرَام, اِلْتِزَام (الامتثال للقانون أو العرف أو الممارسة وما إلى ذلك) / انتباه, ملاحظة (فعل الملاحظة أو الانتباه) / احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: نجا من ملاحظة الشرطة",
 "ぎれいてき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "ぎれいへい": "حرس الشرف (مرافق لضيف مميز أو للنعش في جنازة عسكرية)",
 "ぎれつ": "بَسَالَة, بُطُولَة",
 "ぎろう": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت. / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / تسليك الشعر, فك التشابك (فعل إزالة التشابك من شعرك بمشط) / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / إغاظة, مشاكسة (مضايقة مرحة)\nمثال: تجاهل تهكمهم",
 "ぎろぎろ": "بشكل صارخ (بطريقة صارخة وواضحة جداً)\nمثال: كان واضحاً بشكل صارخ",
 "ぎろっ": "شَاخِص, مُحَمْلِق ((يوصف به العينان) مفتوحتان وجامدتان كما في حالة خوف أو دهشة)",
 "ぎろり": "شَاخِص, مُحَمْلِق ((يوصف به العينان) مفتوحتان وجامدتان كما في حالة خوف أو دهشة)",
 "ぎろん": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "ぎわ": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "ぎわく": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "ぎわだん": "بوكسر, سروال داخلي رجالي (سراويل داخلية يرتديها الرجال)",
 "ぎん": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب. / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف. / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "ぎんいろ": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "ぎんえい": "تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "ぎんかいしょく": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "ぎんかん": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "ぎんが": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير. / مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "ぎんがけい": "درب التبانة, مجرة درب التبانة (المجرة التي تحتوي على النظام الشمسي؛ تتكون من ملايين النجوم التي يمكن رؤيتها كشريط منتشر من الضوء يمتد عبر سماء الليل) / مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "ぎんがけいがいせいうん": "مجرة ((علم الفلك) مجموعة من الأنظمة النجمية؛ أي من مليارات الأنظمة التي تحتوي كل منها على العديد من النجوم والسدم والغبار)",
 "ぎんがてつどうのよる": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "ぎんがみ": "رقائق الألومنيوم, قصدير (رقائق مصنوعة من الألومنيوم) / فِضِّيّ اللَّوْن (ذو لون الفضّة)",
 "ぎんき": "أواني فضية (أدوات مائدة مصنوعة من الفضة أو الفضة المطلية أو البيوتر أو الفولاذ المقاوم للصدأ)",
 "ぎんぎつね": "ثعلب فضي (ثعلب أحمر في الطور اللوني الذي يكون فيه فراءه ذو أطراف بيضاء)",
 "ぎんぎら": "بَرَّاق, لَامِع",
 "ぎんぎん": "مَسْحُور, مُبْتَهِج (يشعر بنشوة أو سرور بالغ) / بشكل مؤلم, بشكل محزن (بشكل غير سار) / بألم, بوجع (في حالة ألم أو كما لو كان متألماً)\nمثال: كان جهله واضحاً بشكل مؤلم / بَارِد كَالجَلِيد (بارد كالثلج تمامًا) / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "ぎんこう": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف. / منجم فضة (منجم يُستخرج منه خام الفضة)",
 "ぎんこういん": "أمين صندوق, صراف بنك (موظف في بنك يستلم ويدفع الأموال)",
 "ぎんこうか": "مَصْرَفِيّ, بَنْكِيّ",
 "ぎんこうぎょう": "أعمال مصرفية, معاملات بنكية (إجراء الأعمال مع بنك؛ إيداع أو سحب الأموال أو طلب قرض، إلخ) / أعمال مصرفية (ممارسة الأعمال التجارية المتمثلة في حفظ الأموال لحسابات التوفير والحسابات الجارية أو للصرف أو لإصدار القروض والائتمان، إلخ)",
 "ぎんこうけん": "بَنْكْنُوت, وَرَقَة نَقْدِيَّة",
 "ぎんこうこうざ": "حِسَاب مَصْرَفِيّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "ぎんこうごうとう": "سارق بنوك (لص يسرق البنوك)",
 "ぎんこうほう": "بنك اليابان (البنك المركزي لليابان)",
 "ぎんこうゆうし": "قرض بنكي, قرض مصرفي (قرض يمنحه مصرف؛ يسدد مع الفائدة في تاريخ محدد أو قبله)",
 "ぎんこうよきん": "وديعة (أموال مودعة في بنك أو مؤسسة مماثلة)",
 "ぎんこうわりびき": "خصم مصرفي, سعر الخصم (فائدة على أساس سنوي تُخصم مقدماً على قرض)",
 "ぎんこうシステム": "القطاع المصرفي, النظام المصرفي (البنوك مجتمعة)",
 "ぎんざいく": "مشغولات فضية (عمل زخرفي مصنوع من الفضة)",
 "ぎんざけ": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى) / سلمون فضي, سلمون كوهو (لحم وردي دهني لسلمون صغير يتم اصطيده في المحيط الهادئ والبحيرات العظمى)",
 "ぎんざん": "منجم فضة (منجم يُستخرج منه خام الفضة)",
 "ぎんざんましこ": "مغلظ المنقار الصنوبري (طائر مغلظ المنقار كبير يعيش في الغابات الصنوبرية في العالم القديم والجديد)",
 "ぎんしゅ": "زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر) / أحمر زاهٍ, قرمزي فاتح (لون متغير يكون أحمر زاهياً ولكن أحياناً مع مسحة برتقالية)",
 "ぎんしょう": "حَيْثِيَّة / فضية, ميدالية فضية (كأس مصنوعة من الفضة (أو لها مظهر الفضة) تمنح عادة للفائز بالمركز الثاني في المسابقة)",
 "ぎんしょっき": "أواني فضية (أدوات مائدة مصنوعة من الفضة أو الفضة المطلية أو البيوتر أو الفولاذ المقاوم للصدأ)",
 "ぎんじる": "أُهْزُوجَة, أَهَازِيج / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "ぎんずる": "أُهْزُوجَة, أَهَازِيج / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "ぎんせん": "فِضِّيّ اللَّوْن (ذو لون الفضّة) / ينتشوان, إينتشوان",
 "ぎんた": "فِي حَال, إِذ مَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ぎんてき": "صافرة معدنية, مزمار القصدير (مزمار رخيص الثمن)",
 "ぎんどろ": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة) / حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "ぎんながし": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب. / سُؤَال مُحَيِّر, مُعْضِلَة (سؤال أو مشكلة صعبة أو محيرة بشكل خاص) / عارض, موديل (شخص يتخذ وضعية لمصور أو رسام أو نحات) / متصنع, مدعٍ (شخص يتظاهر عادةً بكونه شيئاً ليس عليه)\nمثال: لم يكن لدى الرئيس وقت ليكون موديلاً لذا عمل الفنان من الصور",
 "ぎんねず": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "ぎんねむ": "شجرة الرصاص, ليوسينا (شجرة منخفضة شجيرية من المناطق الاستوائية وشبه الاستوائية في أمريكا الشمالية ذات أزهار بيضاء مشوبة بالأصفر تشبه الميموزا وقرون مسطحة طويلة)",
 "ぎんはくしょく": "أَبْيَض فِضِّيّ (أبيض يشبه لون الفضة)",
 "ぎんばん": "حلبة تزلج (مبنى يحتوي على سطح للتزلج على الجليد أو التزلج بالعجلات) / طلاء بالفضة (طبقة رقيقة من الفضة مترسبة على شيء ما) / أواني مطلية بالفضة (أدوات مائدة مطلية بالفضة)",
 "ぎんばんしゃしん": "صورة داجيرية (صورة مصنوعة بعملية فوتوغرافية مبكرة؛ حيث أنتجت الصورة على لوح فضي حساس لليود وتم تظهيرها في بخار الزئبق)",
 "ぎんぱい": "فضية, ميدالية فضية (كأس مصنوعة من الفضة (أو لها مظهر الفضة) تمنح عادة للفائز بالمركز الثاني في المسابقة)",
 "ぎんぴしょう": "تفضض",
 "ぎんほんい": "معيار الفضة (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكمية محددة من الفضة)",
 "ぎんほんいせい": "معيار الفضة (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكمية محددة من الفضة)",
 "ぎんぼし": "النجمة الفضية (وسام عسكري أمريكي للشجاعة في المعركة)",
 "ぎんまく": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / شاشة عرض (سطح أبيض أو فضي يمكن عرض الصور عليه للمشاهدة) / الشاشة الفضية (صناعة السينما والأفلام)",
 "ぎんみ": "فَائِز, فَائِزَة",
 "ぎんみやく": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه) / فَائِز, فَائِزَة",
 "ぎんめっき": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "ぎんゆうしじん": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية) / مؤدي عروض المنستريل, منشد متجول (مؤدٍ في عروض المنستريل (عروض موسيقية وكوميدية قديمة))",
 "ぎんよう": "مَبْخَرَة",
 "ぎんりょうそうもどき": "زهرة الشمع, غليون هندي (نبات غابات رمي صغير شمعي أبيض أو وردي مبيض له أوراق تشبه القشور وزهرة متدلية؛ يتحول إلى الأسود مع التقدم في العمر)",
 "ぎんりん": "عجلة دراجة (عجلة الدراجة الهوائية) / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "ぎんれい": "جرس فضي, هاليزية (أي من الأشجار المتساقطة الأوراق المختلفة من جنس هاليزية ذات زهور بيضاء على شكل جرس)",
 "ぎんろう": "لحام صلد (سبيكة لحام تحتوي على النحاس؛ تنصهر عند درجة حرارة عالية نسبياً؛ تستخدم في اللحام بالنحاس)",
 "ぎんシート": "فِضِّيّ اللَّوْن (ذو لون الفضّة)",
 "ぎんメダル": "فضية, ميدالية فضية (كأس مصنوعة من الفضة (أو لها مظهر الفضة) تمنح عادة للفائز بالمركز الثاني في المسابقة)",
 "ぎんモール": "دانتيل فضي, طاحونة الغبار (شجيرة معمرة في جزر الكناري ذات زهور وأوراق بيضاء وسيقان مشعرة مغطاة بزغب يشبه الغبار؛ توضع أحياناً في جنس الأقحوان)",
 "く": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة! / نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء. / هَايْكُو / جَنَاح / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / تِسْعَة, تسعة / أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟ / تربيع (إنشاء مربع له نفس مساحة شكل آخر) / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / فَم, بق",
 "くあればらくあり": "مَنْ جَدَّ وَجَدَ وَمَنْ زَرَعَ حَصَدَ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "くい": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح. / وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان / جُذْمُور, كُنَّاشَة / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "くいあらす": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "くいあらため": "تَوْبَة",
 "くいあらためる": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "くいあわす": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "くいあわせ": "تَعْشِيقَة / عَشَّقَ (فرط الحب حتى لا يستطيع العاشق الابتعاد عن المعشوق) / اِنْسَجَمَ مَعَ, رَكَّبَ\nمثال: أغاني العشق تحرك مشاعري.",
 "くいいじ": "نَهَم, شَرَه",
 "くいいるように": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "くいうち": "ركيزة, وتد (عمود من الخشب أو الفولاذ أو الخرسانة يتم دقه في الأرض لتوفير الدعم لهيكل ما)",
 "くいうちき": "مِدَقّ, مَاكِنَة دَقّ الرَكَائِز (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "くいき": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "くいぎみ": "قَاطَعَ",
 "くいくい": "متلكئ, مضيع الوقت (شخص يضيع الوقت)",
 "くいけ": "شَهِيَّة",
 "くいこみ": "توغل, غارة (تعدٍ أو اقتحام) / توغل, غارة (غزو أو هجوم عدائي)\nمثال: قاموا بتوغلات في سوق الولايات المتحدة / عَجْز / حذاء وتدي (حذاء بكعب وتدي متصل)",
 "くいこむ": "اِخْتَلَسَ, أَزْعَجَ",
 "くいころす": "اِلْتَهَمَ",
 "くいさがる": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "くいしばる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "くいしめる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "くいしゅう": "هَانْجْتْشُو, خَانْجْتْشُو",
 "くいしんぼ": "أَكَّال, شَرَه",
 "くいしんぼう": "أَكَّال, شَرَه",
 "くいすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "くいせ": "جُذْمُور, كُنَّاشَة",
 "くいぜ": "جُذْمُور, كُنَّاشَة",
 "くいたりない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "くいちがい": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "くいちがう": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "くいっ": "بِسُرْعَة, عَاجِلًا",
 "くいつき": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "くいつく": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "くいつくしけい": "أَكَّال, شَرَه",
 "くいつみ": "السَّنَة الْجَدِيدَة",
 "くいで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "くいとめる": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "くいどうらく": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "くいな": "تفلق / درابزين, قضيب (قضيب أفقي (عادة من الخشب أو المعدن)) / سكة حديد (اختصار لسكة حديدية) / درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات)\nمثال: سافر بالقطار",
 "くいのこし": "الْبَقَايَا",
 "くいもどし": "اجترار",
 "くいもの": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / فَرِيسَة / غَنِيمَة",
 "くいものや": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "くいる": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "くい打ち": "ركيزة, وتد (عمود من الخشب أو الفولاذ أو الخرسانة يتم دقه في الأرض لتوفير الدعم لهيكل ما)",
 "くい止める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "くう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم / سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)\nمثال: رفض مغريات العالم الباطلة / سِلَاح طَيَرَان / جَدْب, عُقْم (صفة عدم إنتاج أي شيء ذي قيمة) / عدم جدوى, عقم إبداعي (نقص الخيال الإبداعي)",
 "くうあつ": "ضغط الهواء, ضغط جوي (الضغط الذي يمارسه الغلاف الجوي)",
 "くうい": "شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة. / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "くういき": "مَجَال جَوِّيّ",
 "くううん": "نقل جوي (النقل عن طريق الجو)",
 "くうかん": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض.",
 "くうかんけいさんりょう": "تَعْقِيد مَكَانِيّ",
 "くうかんげいじゅつ": "فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "くうかんこうし": "شبكة بلورية, شبكة فراغية (ترتيب هندسي ثلاثي الأبعاد للذرات أو الجزيئات أو الأيونات المكونة للبلورة)",
 "くうかんしきしっちょう": "دَوْخَة, دُوَار",
 "くうかんち": "أرض خالية, أرض فضاء (قطعة أرض لا توجد عليها مباني دائمة)",
 "くうかんてき": "فَضَائِيّ",
 "くうかんてきかんけい": "عَلاقَة مَكَانِيَّة, مَوْضِع (الخاصية المكانية لمكان أو طريقة توجد بها الأشياء)\nمثال: موضع العقارب على الساعة",
 "くうき": "هَوَاء (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ) / جَوّ / نَغَم\nمثال: أخرجي الهواء من فمك. / مَزَاج",
 "くうきあっしゅくき": "ضاغط هواء (ضاغط يسحب الهواء عند الضغط الجوي ويضخه بضغط أعلى)",
 "くうきあつ": "ضغط الهواء, ضغط جوي (الضغط الذي يمارسه الغلاف الجوي)",
 "くうきあつかい": "تَجَاهَلَ, طَنَّش",
 "くうきいれ": "مضخة تفريغ, مضخة هواء (مضخة تحرك الهواء داخل أو خارج شيء ما)",
 "くうきおせん": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "くうきかん": "جَو, غِلَاف جَوِّيّ / جَو",
 "くうきこう": "جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة) / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "くうきこきゅうき": "قناع غاز, كمامة تنفس (قناع واقٍ مزود بمرشح؛ يحمي الوجه والرئتين من الغازات السامة) / جهاز تنفس صناعي, منشقة (جهاز تنفس لإعطاء تنفس صناعي طويل الأمد)",
 "くうきさんか": "آلة صنفرة أسطوانية (أداة كهربائية تستخدم لصنفرة الخشب؛ يتم تحريك حلقة لا نهائية من ورق الصنفرة بسرعة عالية بواسطة محرك كهربائي)",
 "くうきじゅう": "بندقية هوائية, مسدس هوائي (بندقية تدفع المقذوف بواسطة الهواء المضغوط)",
 "くうきじょうかき": "مرشح هواء, منقي هواء (مرشح يزيل الغبار من الهواء الذي يمر عبره)",
 "くうきちょうせい": "تَكْيِيف",
 "くうきちょうせつ": "تَكْيِيف",
 "くうきちょうせつき": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "くうきちょうわ": "تَكْيِيف",
 "くうきちょうわき": "تَكْيِيف",
 "くうきでんち": "حويصلة هوائية, سنخ (كيس صغير جداً لحمل الهواء في الرئتين؛ يتكون من التوسع النهائي للممرات الهوائية الدقيقة)",
 "くうきにさらす": "يُهَوِّي",
