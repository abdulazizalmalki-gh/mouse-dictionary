 "くっだらねー": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "くっちせい": "انتحاء أرضي (استجابة توجيهية للجاذبية)",
 "くっちゃべる": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "くっつきむし": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "くっつき虫": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "くっつける": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "くってかかる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "くっと": "عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري. / بِسُرْعَة, عَاجِلًا",
 "くっとう": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى)",
 "くっぷく": "رَضُوخ, مُذْعِن (يَمِيلُ إِلَى الِاسْتِسْلَامِ أَوِ التَّنَازُلِ أَوِ المُوَافَقَةِ) / طَيِّع, لَدِن (يَسْتَجيب لِلضَّغْط بِسُهولَة؛ قابِل لِلتَّشَكُّل) / لَيِّن, مُسْتَسْلِم (يميل إلى الاستسلام للحجة أو التأثير أو السيطرة) / إذعان, تنازل (فعل التنازل أو الإذعان)",
 "くっ付き虫": "ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك)",
 "くっ付ける": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "くつ": "حِذَاء, نَعْل (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "くつう": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "くつうら": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "くつおと": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي) / خطوة, وقع الأقدام (صوت خطوة شخص يمشي) / خطوة (المسافة التي تغطيها خطوة)\nمثال: سمع وقع أقدام على الشرفة",
 "くつがえす": "فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت / أَطَاحَ / عَكَسَ",
 "くつがわ": "جلد الأحذية (جلد يستخدم لصنع الأحذية)",
 "くつくつ": "مَخْنُوق, مَقْمُوع (مُحتبَس بصعوبة ومُسيطَر عليه بالكاد) / سلق, غلي (الطهي في سائل تم غليه)",
 "くつした": "جَوْرَب",
 "くつしたどめ": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "くつじゅう": "تذلل, تملق (خضوع ذليل أو مهين) / تذلل, خنوع (في حالة خنوع) / انقياد, تبعية (حالة كون الشيء مفيداً في تحقيق غاية أو تنفيذ خطة)\nمثال: كانت جميع أفعاله تابعة للخطة العامة",
 "くつじょく": "عَار, خِزْي",
 "くつじょくてき": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور)",
 "くつずみ": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "くつぞこ": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "くつたび": "جَوْرَب",
 "くつぬぎいし": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "くつのきがた": "قالب حذاء (جهاز تثبيت على شكل قدم بشرية يستخدم لتشكيل أو إصلاح الأحذية)",
 "くつのひも": "شِرَاك, رِبَاط الْحِذَاء",
 "くつばみ": "بِت (انقطع؛ قَطَع)",
 "くつひも": "شِرَاك, رِبَاط الْحِذَاء",
 "くつふき": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول) / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "くつべら": "قَرْن (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "くつみがき": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "くつや": "متجر أحذية, محل أحذية (متجر تباع فيه الأحذية)",
 "くつろぎ": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / بَسَاطَة, سُهُولَة (التحرر من الصعوبة أو المشقة أو الجهد) / أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / تخفيف, راحة (حالة الارتياح أو التخفيف (خاصة بعد التخلص من الضيق))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "くつろぐ": "اِسْتَرْخَى",
 "くつろげる": "فَضْفَاض, واسِع",
 "くつわ": "بِت (انقطع؛ قَطَع)",
 "くつわや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "くつわをならべて": "مَعًا, سَوِيًّا",
 "くつわを並べて": "مَعًا, سَوِيًّا",
 "くつクリーム": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "くて": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "くてん": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "くで": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "くとう": "عَلَامَة تَرْقِيم, تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "くとうてん": "عَلَامَة تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "くど": "بيريكلاز, مغنيسيا (معدن صلب أبيض يوجد بشكل طبيعي كأكسيد مغنيسيوم؛ مصدر للمغنيسيوم) / كانون",
 "くどい": "تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية / ثَقِيل / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / وليمة احتفالية ((في بريطانيا) وليمة احتفالية أو ترفيهية تقام في الكلية)",
 "くどう": "قَادَ, سَاقَ / سَاقَ",
 "くどうき": "قَادَ, سَاقَ / سَاقَ",
 "くどうし": "فعل مركب (فعل إنجليزي يتبعه حرف أو أكثر حيث يتصرف المزيج كوحدة نحوية ودلالية)",
 "くどうぶ": "قَادَ, سَاقَ / سَاقَ",
 "くどうりん": "عجلة القيادة, عجلة دافعة (عجلة تحرك مركبة (تحول عزم الدوران إلى قوة سحب))",
 "くどき": "استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال",
 "くどきおとす": "أَقْنَعَ",
 "くどきもんく": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "くどき文句": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "くどく": "جَدَارَة / غريس / أَقْنَعَ / أَغْرَى, أَغْوَى",
 "くどくぞう": "بيت الكنز (مستودع للكنوز)",
 "くどくど": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل",
 "くどくどしい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "くながい": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "くなくな": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة / بِدَلَال, بِغُنْج (بطريقة مغازلة)\nمثال: ابتسمت بغنج",
 "くなん": "مُعَانَاة",
 "くなんのこうぐん": "كوري شمالي (من أو يتعلق بكوريا الشمالية أو شعبها أو ثقافتها أو يميزهم) / كوري شمالي (كوري من كوريا الشمالية)",
 "くに": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة. / مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى. / مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / قَذَارَة",
 "くにがわ": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "くにくのさく": "الملاذ الأخير, حل يائس (وسيلة لا يتم اللجوء إليها إلا عند اليأس)",
 "くにぐに": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "くにことば": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا) / لغة دارجة (الكلام اليومي للناس (تمييزاً عن اللغة الأدبية)) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "くにざかい": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "くにじゅう": "جَمِيع أَنْحَاء, كُلّ",
 "くにする": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "くにつち": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "くにところ": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "くになる": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "くにのはは": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "くにびと": "مَحَلِّيّ",
 "くにます": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض)",
 "くにもと": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "くにもの": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "くにゃっと": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "くにゃり": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "くにやむ": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "くねくね": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "くねらす": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "くねる": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "くのいち": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "くのう": "أَلَم (الوَجَع) / اِحْتِضَار\nمثال: ألم أقل لك ذلك؟ / تَأْثِير, أَثَر",
 "くの一": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "くはい": "اِمْتِحَان, تَجْرُبَة (اِمْتِحَان) / مِحْنَة\nمثال: لدي امتحان غدا.",
 "くはらくのたね": "مَنْ جَدَّ وَجَدَ وَمَنْ زَرَعَ حَصَدَ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "くばりもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "くばる": "وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "くばんざくろいし": "بيروب (عقيق أحمر عميق يستخدم كحجر كريم)",
 "くぱくぱ": "نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: يبدو أن النبضات قادمة من نجم / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "くひゃく": "تِسْعُمِئَة, تِسْعُمِائَة / مُغَفَّل, أَحْمَق",
 "くび": "رَقَبَة, عُنُق / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / إِقَالَة",
 "くびかざり": "قِلَادَة",
 "くびかせ": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها ويتعرضون للسخرية العامة)",
 "くびかみ": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "くびき": "فَدَّان / نِير / متطلب",
 "くびきごほう": "تلازم لفظي, زوغما (استخدام فعل مع مكملين أو أكثر، واللعب على تعدد معاني الفعل، لتأثير فكاهي)",
 "くびきり": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "くびきりやくにん": "جَلَّاد",
 "くびきる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "くびき語法": "تلازم لفظي, زوغما (استخدام فعل مع مكملين أو أكثر، واللعب على تعدد معاني الفعل، لتأثير فكاهي)",
 "くびじっけん": "بِطَاقَة هُوِيَّة",
 "くびす": "عَقِب, كَعْب / كَعْب",
 "くびすをかえす": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "くびすを返す": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "くびったけ": "بتهور, رأساً على عقب (في عجلة مضطربة)",
 "くびったま": "رَقَبَة, عُنُق",
 "くびづか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "くびづな": "رِبَاط",
 "くびながりゅう": "بليزيوصور (زاحف بحري منقرض برأس صغير على رقبة طويلة وذيل قصير وأربعة أطراف على شكل مجداف؛ من العصر الجوراسي والطباشيري)",
 "くびなし": "بلا رأس, مقطوع الرأس (ليس له رأس أو تشكل بدون رأس) / أَحْمَق, فَارِغُ الرَّأْس (لا يستخدم عقله أو ذكاءه)\nمثال: الفارس بلا رأس",
 "くびなわ": "رِبَاط",
 "くびにする": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "くびひも": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "くびふり": "تَذَبْذُبِيّ, مُتَذَبْذِبٌ (ذو اهتزازات دورية)",
 "くびまき": "وِشَاح, لِفاع",
 "くびれ": "انقباض, تضيق (فعل أو عملية الضغط) / انقباض, ضيق (شعور بالضيق في جزء من الجسم) / تضيق, تضييق (ضغط ضيق أو محكم) / تضييق, عنق زجاجة (تضييق يقلل التدفق عبر قناة)\nمثال: شعر بانقباض في صدرها / خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "くびれる": "شَدَّ, ضَيَّقَ",
 "くびれフェチ": "خصر النحلة (خصر نحيل جداً)",
 "くびわ": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / قِلَادَة",
 "くびわペッカリー": "بيكاري مطوق (بيكاري رمادي داكن ذو طوق أبيض غير واضح؛ من المناطق شبه الصحراوية في المكسيك وجنوب غرب الولايات المتحدة)",
 "くびをおとす": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "くびをきる": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "くびをしめる": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "くびをすくめる": "زَغَبُ البَطّ (ريش البط الناعم)",
 "くびをそろえる": "اجتماع, تجمع (تجمع اجتماعي صغير غير رسمي)\nمثال: كان هناك اجتماع غير رسمي في غرفة معيشتي",
 "くびをたてにふる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "くびをつる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "くびをはねる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "くびをよこにふる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "くぴた": "رَقَبَة, عُنُق",
 "くふ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "くふう": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / أَدَاة, جِهَاز",
 "くふうざい": "طارِد لِلرِّياح (يُساعِد عَلى طَرْد الغازات مِن الجِهاز الهَضْمِيّ) / طارد للغازات (دواء يمنع تكون الغازات في القناة الهضمية أو يسهل خروجها)",
 "くふうやく": "طارِد لِلرِّياح (يُساعِد عَلى طَرْد الغازات مِن الجِهاز الهَضْمِيّ) / طارد للغازات (دواء يمنع تكون الغازات في القناة الهضمية أو يسهل خروجها)",
 "くぶ": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "くぶくりん": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد / تِسْعَة وَتِسْعُيون",
 "くぶどおり": "تَقْرِيبًا / على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "くぶん": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب. / تَصْنِيف",
 "くぶんしょゆうたてもの": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة بشكل فردي) / شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)",
 "くぶんたてもの": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة بشكل فردي) / شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)",
 "くべつ": "تَمْيِيْز",
 "くべつだて": "تفاضل (العملية الرياضية للحصول على مشتق دالة) / اختلاف, تمايز (التمييز بين الأشياء على أنها مختلفة ومتميزة بناءً على خصائصها أو سماتها) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "くべる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "くほ": "ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "くほう": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "くぼ": "أَجْوَف / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "くぼう": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "くぼたまり": "أَجْوَف",
 "くぼち": "أَجْوَف",
 "くぼまる": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "くぼみ": "أَجْوَف\nمثال: 後ろのドアにへこみができた。 — لديهم بعجة في الباب الخلفي .",
 "くぼむ": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "くぼめる": "تَجَوَّفَ",
 "くま": "دُبّ / دُبَّة / اِحْتَمَلَ / زَاوِيَة, رُكْن / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة)",
 "くまおくり": "تضحية, قتل شعائري (فعل قتل (حيوان أو شخص) استرضاءً لإله)",
 "くまこうはちこう": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "くまさんはっつあん": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "くまで": "مِدَمَّة, مُشْط / يجمع الحشائش / قذائف مكثفَة / يسرح الشعر\\الحشائش",
 "くまでしょう": "جشع, طمع (رغبة مفرطة في الثروة (عادة بكميات كبيرة)) / جشع, شره (رغبة مفرطة في الطعام)\nمثال: جشع المحامين",
 "くまでばば": "قَابِلَة, دَايَة",
 "くまどり": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة)",
 "くまどる": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "くまなく": "جَمِيع أَنْحَاء, كُلّ\nمثال: 彼は戸を白のペンキでくまなく塗った。 — دهن الباب بالأبيض. / بتألق, بسطوع\nمثال: تألقت النجوم بسطوع",
 "くまねこ": "بَنْدَة, بانْدا",
 "くまねずみ": "جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم)",
 "くまのみ": "سَمَكَة المُهَرِّج (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "くまばち": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في دُبُرِها)",
 "くまむし": "بطيء الخطو, دب الماء (مفصلي من شعبة بطيئات الخطو)",
 "くまもと": "كُومَامُوتُو",
 "くまんばち": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في دُبُرِها)",
 "くま取り": "تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة)",
 "くみ": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / لُوط / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / مَرَارَة",
 "くみあい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "くみあいいん": "نقابي (عامل ينتمي إلى نقابة عمالية)",
 "くみあいいんしょう": "بطاقة نقابية (بطاقة تثبت العضوية في نقابة عمالية)",
 "くみあいしゅぎ": "النقابية (نظام أو مبادئ ونظرية النقابات العمالية)",
 "くみあいせんじゅうしゃ": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "くみあげる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي. / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "くみあわさる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "くみあわす": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "くみあわせ": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة)) / مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "くみあわせじょう": "قفل أرقام, قفل مركب (قفل لا يمكن فتحه إلا عن طريق تدوير الأقراص بتسلسل خاص)",
 "くみあわせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "くみいと": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "くみいれ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / عُشّ / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار) / مُنْتَجَع / مَعْقَل (الملجأ والجبل المرتفع) / عَشَّشَ\nمثال: كان دوري كي أنظف المسكن",
 "くみいれる": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "くみいん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "くみうち": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "くみかえ": "إعادة ترتيب (تغيير ترتيب شيء ما)",
 "くみかえる": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "くみかえディーエヌエー": "حمض نووي معاد التركيب (حمض نووي معدل وراثياً يُصنع عن طريق إعادة دمج أجزاء من الحمض النووي من كائنات حية مختلفة)",
 "くみきょく": "حَشَم (استحيا أو شعر بالحياء؛ منعه من التصرف بحرية بدافع الحياء أو الاحترام)",
 "くみこ": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه. / قائم النافذة (شريط رأسي غير هيكلي بين مصاريع أو ألواح النافذة (أو ألواح الشاشة))",
 "くみこみ": "إقحام, لقطة دخيلة ((سينما) صورة ثابتة يتم إدخالها وتقاطع أحداث الفيلم) / إعلان مقحم, مداخلة ((البث) إعلان محلي يتم إدراجه في برنامج الشبكة) / مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "くみこみかんすう": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "くみこみコマンド": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "くみこむ": "أَدْخَلَ",
 "くみした": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "くみしやすい": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات) / سهل الانقياد, طَيِّع (سهل الإدارة (التحكم أو التعليم أو التشكيل))\nمثال: عقول شابة طيعة",
 "くみする": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "くみそ": "مادة مرة, مبدأ مر (أي من مئات المركبات ذات الطعم المر؛ ولا تندرج تحت تصنيف كيميائي محدد)",
 "くみたて": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "くみたてこう": "برنامج تجميع, مجمّع (برنامج لتحويل لغة التجميع إلى لغة الآلة)",
 "くみたてこうじょう": "مصنع تجميع (مصنع يتم فيه تجميع الأجزاء المصنعة لتكوين منتج نهائي)",
 "くみたてしき": "ضربة قاضية (ضربة تسقط الخصم عن قدميه) / قَابِل لِلتَّفْكِيك ((أثاث) سهل التركيب والتفكيك)",
 "くみたてる": "تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة)\nمثال: 昨日、アンプを組み立てた。 — صنعتُ مُضَخِّمًا أمس. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "くみたてライン": "خط إنتاج, خط تجميع (نظام ميكانيكي في مصنع يتم بموجبه نقل السلعة عبر مواقع يتم فيها إجراء عمليات متتالية عليها)",
 "くみちょう": "رَئِيس, رَئِيسَة",
 "くみつく": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "くみつけ": "فَرْض / تَجْمِيع, مَجْمَع (مصدر جَمَّعَ) / جَمْعِيَّة, مَجْمَع (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "くみて": "ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم) / سجال, مناوشة كلامية (جدال يحاول فيه المشاركون الحصول على ميزة ما) / مَقْبِض / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل) / مصارع (مقاتل يحاول طرح الخصم أرضاً)",
 "くみとり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "くみとりしきべんじょ": "مِرْحَاض, تواليت",
 "くみとりべんじょ": "مِرْحَاض خَارِجِيّ",
 "くみとる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "くみなおす": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "くみはん": "تَنْضِيد / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "くみひも": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "くみふだ": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "くみもの": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / جَدِيلَة, ضَفِيرَة (تسريحة شعر تتشكل بجدل أو لف الشعر) / سطح معمد ((في العمارة) الهيكل المكون من جزء المعبد الكلاسيكي الواقع فوق الأعمدة بين التاج والسقف)",
 "くみ上げる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "くみ取り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "くみ取り便所": "مِرْحَاض خَارِجِيّ",
 "くむ": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا / وَرَثَ / صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة) / ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة / عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "くめん": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما) / آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / تجهيز مؤقت, تلفيق (أي ترتيب مرتجل للاستخدام المؤقت) / ابتكار, براعة (ملكة الابتكار؛ مهارة ابتكارية)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "くも": "سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "くもい": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "くもかすみ": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام / فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء) / بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً) / مَحْجُوب, مَخْفِيّ (غَيْرُ مُتَاحٍ لِلنَّظَر)\nمثال: استلقى متربصاً",
 "くもがく": "علم السحب (فرع الأرصاد الجوية الذي يدرس السحب وتكوينها)",
 "くもがくれ": "اختفاء مفاجئ, تلاشي (اختفاء مفاجئ عن الأنظار) / اختفاء مفاجئ, تلاشي (اختفاء مفاجئ أو غامض)\nمثال: あいつどこに雲隠れしたのかな。 — أتساءل أين يختبئ.",
 "くもがたるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "くもきょうふしょう": "رُهَاب اَلْعَنَاكِب",
 "くもざる": "سَعْدَان عَنْكَبُوتِيّ, آتِل",
 "くもすけ": "بَلْطَجِيّ",
 "くもつ": "قُرْبَان",
 "くもつく": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "くもつだい": "مَذْبَح, هَيْكَل",
 "くもで": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض) / بِشَكْل مُعَاكِس, عَلَى نَحْو مُخَالِف (ليس بالطريقة المقصودة) / صَلِيبِيّ, مُتَقَاطِع (على شكل صليب أو قطعة أفقيَّة منه) / عرضي (يقع أو يمتد عبر طول الشيء أو في اتجاه متقاطع)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "くもなく": "بِسُهُولَة",
 "くものす": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "くものすかび": "ريزوبوس (أي من الفطريات المسببة للعفن المختلفة من جنس ريزوبوس)",
 "くもひとつない": "خَالٍ مِنَ الغُيُوم, صَافٍ (خالٍ من الغيوم)",
 "くもひとで": "نجم البحر الهش (حيوان يشبه نجم البحر بأذرع هشة تشبه السوط تشع من قرص مركزي صغير)",
 "くもまく": "أم عنكبوتية, غشاء عنكبوتي (الوسطى من السحايا الثلاث)",
 "くもまくかくう": "الحيز تحت العنكبوتية (مساحة في السحايا تحت الغشاء العنكبوتي وفوق الأم الحنون تحتوي على السائل النخاعي)",
 "くもみず": "شَحَّاذ, مُتَسَوِّل (يُمَارِسُ الاسْتِجْدَاءَ وَالتَّسَوُّل) / شَحَّاذ, مُتَسَوِّل (فقير يعيش على التسول) / راهب متسول (عضو ذكر في رهبنة دينية كانت تعتمد في الأصل كلياً على الصدقات)",
 "くもゆき": "طَقْس, جَوّ / حَالَة, وَضْع",
 "くもらす": "اسوداد, صدأ (تغير لون السطح المعدني الناتج عن الأكسدة)",
 "くもらせる": "سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "くもり": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي) / تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب)\nمثال: 昨日、東京は曇りでしたか。 — أكان الجو غائماً في طوكيو البارحة؟ / ضَبَاب, شبورة / قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "くもりど": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى) / عتامة (ظاهرة عدم السماح بمرور الإشعاع الكهرومغناطيسي)",
 "くもるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "くもをかすみと": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء) / بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً) / مَحْجُوب, مَخْفِيّ (غَيْرُ مُتَاحٍ لِلنَّظَر)\nمثال: استلقى متربصاً",
 "くもをつかむよう": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "くもをつく": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "くもん": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "くもんじょ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "くも膜": "أم عنكبوتية, غشاء عنكبوتي (الوسطى من السحايا الثلاث)",
 "くも膜下腔": "الحيز تحت العنكبوتية (مساحة في السحايا تحت الغشاء العنكبوتي وفوق الأم الحنون تحتوي على السائل النخاعي)",
 "くやくしょ": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "くやしい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "くやしさ": "إذلال, انكسار (مشاعر قوية من الإحراج)",
 "くやしなみだ": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / صداع, قلق (شيء أو شخص يسبب القلق؛ مصدر للتعاسة) / إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / استياء, انزعاج (الحالة النفسية للشعور بالتهيج أو الانزعاج)\nمثال: حركة المرور في نيويورك مصدر قلق دائم",
 "くやしまぎれ": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "くやしーい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "くやみ": "تَأْسِيَة / تَعْزِيَة",
 "くやむ": "نَدَبَ / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "くゆ": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "くゆらす": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "くよくよ": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / بقلق (بطريقة قلقة)\nمثال: قالت بقلق: 'أتساءل ماذا أفعل'",
 "くら": "مَخْزَن, مُسْتَوْدَع / سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته) / مُسَابَقَة",
 "くらい": "غَامِق, دَاكِن / مُحْبَط, مُكْتَئِب / مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / حَوَالَيْ, تَقْرِيبًا / عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال. / عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / دَرَجَة / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: سجلت رقم هاتفه.",
 "くらいする": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "くらいつく": "قَضَمَ",
 "くらいづけ": "ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "くらいどり": "دَرَجَة",
 "くらいどりひょうきほう": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة الحرف على موضعه)",
 "くらいどりひょうげんほう": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة الحرف على موضعه)",
 "くらいどる": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "くらいなら": "بَدَلًا مِن / أَكْثَر مِن, عَنّ",
 "くらいのたかい": "عَالِيّ الرُتْبَة",
 "くらいのもの": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "くらいれ": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "くらう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "くらがえ": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "くらがり": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "くらきみち": "هَادِيس",
 "くらくら": "بدوار, بدوخة (بطريقة دوارة أو خفيفة الرأس)\nمثال: مشى حوله بدوار",
 "くらさ": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "くらざらえ": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "くらし": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "くらしがたつ": "اِرْتَزَقَ",
 "くらしき": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "くらした": "سيرلوين (جزء من الخاصرة (وخاصة في البقر) يقع أمام الكفل مباشرة)",
 "くらしぶり": "نَمَط الحَيَاة",
 "くらしむき": "نَمَط الحَيَاة",
 "くらしをたてる": "اِرْتَزَقَ",
 "くらじり": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "くらす": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / اِرْتَزَقَ",
 "くらずれ": "قرحة السرج (قرحة تصيب راكب الخيل بسبب احتكاك السرج) / قرحة السرج (قرحة مفتوحة على ظهر الحصان ناتجة عن سرج غير مناسب أو معدل بشكل سيء)",
 "くらだし": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "くらばらい": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "くらべ": "مُسَابَقَة",
 "くらべもの": "مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "くらべる": "قَارَنَ / شَبَّهَ / تَنَافَسَ, تَبَارَى",
 "くらます": "أَخْفَى / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / إبهار, إعشاء (سطوع يكفي للتسبب بالعمى الجزئي والمؤقت)",
 "くらもと": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "くらもの": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "くらや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "くらやみ": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "くらわす": "اِتِّفَاقِيَّة",
 "くらわせる": "اِتِّفَاقِيَّة",
 "くら替え": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "くり": "كستناء يابانية (شجرة منتشرة في اليابان لها جذع قصير) / أَجْوَف",
 "くりあげ": "يقرب",
 "くりあげる": "يقرب",
 "くりいと": "بَكَرَة",
 "くりいれる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "くりいろ": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "くりうめ": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "くりかえし": "تَكْرَار, إِعَادَة / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "くりかえす": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "くりかえる": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "くりかた": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "くりからもんもん": "وَشْم / وَشَمَ, وَشَّمَ",
 "くりがた": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "くりくり": "غزل (صنع الخيوط) / بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "くりげ": "كَسْتَنَاء / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "くりこし": "نقل التدريب, نقل التعلم (تطبيق مهارة تم تعلمها في موقف ما على موقف مختلف ولكنه مشابه) / أَرْبَاح مُرَحَّلَة, فَائِض مُرَحَّل (الأرباح المتراكمة وغير الموزعة لشركة ما بعد رصد مخصصات للأرباح الموزعة والاحتياطيات)",
 "くりこす": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "くりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "くりごと": "تَكْرَار, إِعَادَة / تَنَافُر",
 "くりさげ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "くりさげる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "くりだしはしご": "سلم قابل للتمديد (سلم يمكن تمديد طوله)",
 "くりだしばしご": "سلم قابل للتمديد (سلم يمكن تمديد طوله)",
 "くりだす": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / قَطِيع / تَهَافَتَ, تَقَاطَرَ / مِزْقَة / إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / اندفاع (فعل التحرك للأمام فجأة) / اندفاعة ((مبارزة) طعنة هجومية تتم بقدم واحدة للأمام والساق الخلفية مستقيمة وذراع السيف ممدودة للأمام)",
 "くりっ": "بِشَكْل حَيّ, بِوُضُوح (بطريقة حية)\nمثال: وصف مغامراته بشكل حي",
 "くりつ": "جَنَاح",
 "くりど": "باب منزلق (باب يفتح عن طريق الانزلاق بدلاً من التأرجح)",
 "くりぬき": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "くりぬく": "أَجْوَف",
 "くりのべ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "くりのべる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "くりひろげる": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "くりふね": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "くりぶね": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "くりまわす": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "くりや": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ.",
 "くりやびと": "طَاهٍ, طَاهِي",
 "くり抜き": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "くり抜く": "أَجْوَف",
 "くり貫き": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "くり貫く": "أَجْوَف",
 "くる": "بَكَرَة / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / عَدَّ / كُونْت / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟ / صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / كُسَاح / أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري) / تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "くるい": "جُنُون / شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي) / تَعَصُّب",
 "くるいざき": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "くるいばな": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "くるう": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي)",
 "くるおしい": "مَجْنُون",
 "くるくる": "دوران حلزوني (عملية الدوران في دائرة أو حلزون)",
 "くるくるぱあ": "دُمْيَة",
 "くるくるぱー": "دُمْيَة",
 "くるしい": "أَلِيم, مُؤْلِم\nمثال: 苦しい、やめろ。 — إن ذلك مؤلم ، توقف. / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب) / ضَيِّق / مُتَكَلِّف, مُجْهَد (يناضل من أجل إحداث أثر أو انطباع) / قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي) / مُتَكَلَّف, مُجْهَد (يفتقر إلى السلاسة والطبيعية) / مُتَكَلَّف, مُجْهَد (يُظْهِرُ عَلَامَاتِ التَّوَتُّرِ الذِّهْنِيِّ وَالعَاطِفِيّ)",
 "くるしいときのかみだのみ": "هُنَاك, يُوجَد",
 "くるしがる": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "くるしさ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "くるしまぎれ": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "くるしみ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "くるしむ": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "くるしめる": "عَذَاب / عَذَّبَ / مِحْنَة",
 "くるしゅうない": "عَفْوًا",
 "くるひもくるひも": "يَوْمًا بَعْدَ يَوْم",
 "くるびょう": "كُسَاح",
 "くるぶし": "كَاحِل, كَعْب",
 "くるべ": "لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)",
 "くるま": "سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / عَجَلَة / عجلة / رويضة / رِيكْشَا",
 "くるまいす": "كُرْسِيّ لِلْمُقْعَدِين, كُرْسِيّ مُتَحَرِّك (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "くるまだい": "أجرة الحافلة (الأجرة المفروضة لركوب حافلة أو ترام) / أتعاب شرفية, مكافأة شرفية (رسوم تُدفع مقابل خدمة مجانية اسمياً) / نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل)",
 "くるまだいく": "صانع العربات (عامل يصنع ويصلح العربات)",
 "くるまちん": "أجرة الحافلة (الأجرة المفروضة لركوب حافلة أو ترام)",
 "くるまどめ": "مِصَدّ / تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن) / إسفين, سنادة (كتلة من الخشب تستخدم لمنع انزلاق أو تدحرج جسم ثقيل)\nمثال: كان ممتلئاً تماماً / عمود حاجز, مربط (عمود قوي (كما في رصيف الميناء أو السفينة لربط حبال الإرساء))\nمثال: أغلق الطريق أمام حركة المركبات باستخدام الأعمدة الحاجزة",
 "くるまばそう": "غديرة, وودروف حلو (أوراق خضراء داكنة عطرة تستخدم لتنكيه نبيذ مايو) / جويسئة عطرة, نبات الخشبة",
 "くるまひだ": "كسرة سكين (طية واحدة متجهة في اتجاه واحد)",
 "くるままわし": "ارتداد, انعكاس (التحول في الاتجاه المعاكس) / تجهيز للرحلة العودة, وقت الدوران (عمل أو عملية تفريغ وتحميل وخدمة سفينة أو طائرة لرحلة العودة) / منطقة دوران (منطقة كبيرة بما يكفي لتدور المركبة فيها) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "くるまや": "صانع العجلات (شخص يصنع ويصلح العجلات الخشبية)",
 "くるまよい": "داء السيارة, دوار السيارة (دوار الحركة الذي يحدث أثناء السفر في السيارة)",
 "くるまようひん": "جزء سيارة, قطعة غيار سيارة (مكون من مكونات السيارة)\nمثال: تجارته هي قطع غيار السيارات",
 "くるまよせ": "انخفاض, تراجع (تغير نحو الأسفل) / جرف, منحدر صخري (واجهة صخرية شديدة الانحدار والمرتفع) / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "くるま屋": "صانع العجلات (شخص يصنع ويصلح العجلات الخشبية)",
 "くるみ": "جَوْز (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "くるみあぶら": "زيت الجوز (زيت مستخرج من الجوز)",
 "くるみゆ": "زيت الجوز (زيت مستخرج من الجوز)",
 "くるみわり": "كَسَّارَة جَوْز / كَسَّارَة بُنْدُق",
 "くるみわりにんぎょう": "كَسَّارَة جَوْز / كَسَّارَة بُنْدُق",
 "くるみ割り": "كَسَّارَة جَوْز / كَسَّارَة بُنْدُق",
 "くるみ割り人形": "كَسَّارَة جَوْز / كَسَّارَة بُنْدُق",
 "くるみ油": "زيت الجوز (زيت مستخرج من الجوز)",
 "くるむ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "くるめく": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "くるめる": "تضمن",
 "くるり": "فَجْأَةً / تَمَامًا / مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "くるりぼう": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "くるり棒": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "くるるど": "أَبْوَاب, بَاب",
 "くるわ": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "くるわせる": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "くるん": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / بِالْقُرْب, قُرْبَ / مَوْجُود (الذي له وجود)\nمثال: رقصنا حول النار.",
 "くる病": "كُسَاح",
 "くれ": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "くれがた": "مَسَاء",
 "くれぐれ": "هُبُوط, غَسَق",
 "くれぐれも": "المخلص, تفضلوا بقبول فائق الاحترام (صيغة مكتوبة لإنهاء الرسالة) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: مدحته بصدق لانتصاره / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "くれて": "مُتَبَرِّع",
 "くれてやる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "くれない": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ)",
 "くれないいろ": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "くれのおも": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "くれゆく": "انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "くれる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "くろ": "جسر, طريق مرتفع (طريق مرفوع فوق الماء أو المستنقعات أو الرمال) / أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / ذَنْب, خِطْء (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / نَدَم\nمثال: عذر أقبح من ذنب.",
 "くろあげは": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "くろあしあほうどり": "قطرس أسود الرجلين (نوع من القطرس ذو أقدام سوداء)",
 "くろあしいたち": "نمس أسود الأقدام (ثديي من العرسيات في مناطق البراري بالولايات المتحدة؛ مهدد بالانقراض تقريباً)",
 "くろあしげ": "رمادي فولاذي (رمادي داكن يميل قليلاً للأرجواني أو الأزرق)",
 "くろあしカコミスル": "أمريكي وسطي (من أو يتعلق بدول أو ثقافات أو شعوب أمريكا الوسطى) / أمريكي وسطي (مواطن أو ساكن في أمريكا الوسطى)",
 "くろい": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / غَامِق, دَاكِن / مُريب, مَشبوه / أَسْوَد حَالِك, أَسْوَد فَاحِم (بأشد درجات السواد؛ كلون الفحم الحجري أو القار) / مُسَخَّم, مُغَطًّى بِالسُّخَام (مُغطّى بالسُّخام أو ما يشبهه)",
 "くろいし": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "くろいろ": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "くろいんげんまめ": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "くろう": "مُشْكِلَة, مَتاعِب / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "くろうしょう": "تَشَاؤُم",
 "くろうたどり": "شُحْرُور",
 "くろうと": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / بائعة هوى",
 "くろうとかたぎ": "احترافية, مهنية (الخبرة المميزة للشخص المهني)",
 "くろうとすじ": "مُحْتَرِف, مُحْتَرِفَة",
 "くろうにん": "حَكِيمٌ بِطُرُقِ الدُّنْيَا (ذو خبرة ودراية بطرق العالم وأساليبه)",
 "くろうみがめ": "الْبَحْر الْأَسْوَد, بَحْرُ نِيطَش",
 "くろうんも": "بيوتيت (ميكا بنية داكنة إلى سوداء توجد في الصخور النارية والمتحولة)",
 "くろおび": "حِزَام أَسْوَد (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "くろがし": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
 "くろがね": "حَدِيد (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد) / حَدِيدِيّ / كَوَى\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "くろがも": "بط أسود شائع (نوع من البط الأسود)",
 "くろがらし": "خردل أسود (نبات حولي أوراسي واسع الانتشار يزرع لبذوره النفاذة؛ مصدر رئيسي لخردل المائدة)",
 "くろくする": "سَوَّدَ / اِسْوَدَّ",
 "くろくま": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني) / دب أسود آسيوي (دب ذو معطف أسود يعيش في وسط وشرق آسيا)",
 "くろぐま": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني) / دب أسود آسيوي (دب ذو معطف أسود يعيش في وسط وشرق آسيا)",
 "くろぐわい": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "くろげ": "دَاكِن الشَّعْر (ذو شعر بلون داكن)",
 "くろこ": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي) / خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "くろこげ": "شار",
 "くろこしょう": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "くろこんごうせき": "ألماس أسود, كربونادو (ألماس داكن أقل جودة يستخدم صناعياً للحفر والتلميع)",
 "くろご": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي) / خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "くろごけぐも": "أرملة سوداء (عنكبوت سام من العالم الجديد؛ الأنثى سوداء بعلامة حمراء على شكل ساعة رملية على الجانب السفلي من البطن)",
 "くろごめ": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "くろさい": "وحيد القرن الأسود",
 "くろざとう": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "くろしお": "تيار اليابان, تيار كوروشيو (تيار محيطي دافئ يتدفق باتجاه الشمال الشرقي قبالة ساحل اليابان إلى شمال المحيط الهادئ)",
 "くろしおだいだこう": "تيار اليابان, تيار كوروشيو (تيار محيطي دافئ يتدفق باتجاه الشمال الشرقي قبالة ساحل اليابان إلى شمال المحيط الهادئ)",
 "くろしょうじょう": "شِمْبَانْزِي",
 "くろしろ": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "くろしろえりまききつねざる": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "くろじ": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / حروف سوداء, قوطي (نمط خط ثقيل استخدم من القرن الخامس عشر إلى الثامن عشر)",
 "くろじてんかん": "ارتداد, انعكاس (التحول في الاتجاه المعاكس) / تجهيز للرحلة العودة, وقت الدوران (عمل أو عملية تفريغ وتحميل وخدمة سفينة أو طائرة لرحلة العودة) / منطقة دوران (منطقة كبيرة بما يكفي لتدور المركبة فيها) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "くろすいしょう": "خوذة موريون (خوذة معدنية كان يرتديها الجنود العاديون في القرن السادس عشر)",
 "くろすぐり": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "くろずいしょう": "خوذة موريون (خوذة معدنية كان يرتديها الجنود العاديون في القرن السادس عشر)",
 "くろずみ": "بُثُور سَوْدَاء, رُؤُوس سَوْدَاء / تسويد, تعتيم (التغيير إلى لون أغمق)",
 "くろずむ": "سَوَّدَ / اِسْوَدَّ",
 "くろそこひ": "كُمْنَة",
 "くろたちかます": "ماكريل الثعبان (أسماك استوائية مفترسة ذات فكوك بارزة وأسنان قوية)",
 "くろたねそう": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة) / ثلج في الصيف (عشبة الطيور ذات أوراق رمادية فضية مشعرة وأزهار بيضاء كبيرة نوعاً ما) / حب في الضباب, ليمون الماء البري (زهرة العاطفة الاستوائية الأمريكية ذات قنابات مقسمة بدقة؛ السيقان كريهة الرائحة عند سحقها)",
 "くろたま": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "くろだま": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "くろちく": "خيزران أسود (خيزران صغير له سيقان خضراء رقيقة تتحول إلى اللون الأسود اللامع)",
 "くろちゃ": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "くろちゃいろ": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "くろっち": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "くろっぽい": "غَامِق, دَاكِن",
 "くろてん": "سَمُّور",
 "くろでんきせき": "شورل (تورمالين أسود)",
 "くろと": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / بائعة هوى",
 "くろとう": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "くろとうぞくかもめ": "كركر طفيلي, كركر قطبي (نوع من الكركر)",
 "くろとびいろ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "くろにんじん": "جزر بري, دانتيل الملكة آن (عشب أوراسي مستوطن على نطاق واسع بأوراق مقطعة بدقة وخيمات مركبة بيضاء من الزهور الصغيرة البيضاء أو الصفراء وجذور صفراء رفيعة)",
 "くろぬり": "مُسْوَدّ ((للوجه) أسود خاصة من احتقان الدم) / مُدَخَّن, مُسْوَدّ (أصبح داكنًا بفعل الدخان)",
 "くろぬりメイク": "مكياج الوجه الأسود (المكياج (عادة من الفلين المحروق) الذي يستخدمه المؤدي لتقليد ذوي البشرة السوداء)",
 "くろねこ": "القطة السوداء",
 "くろばえ": "ذبابة الزجاجة (ذبابة كبيرة عادة ما تكون مشعرة ذات لون أزرق أو أخضر معدني؛ تضع البيض في الجيف أو الروث أو الجروح)",
 "くろばむ": "سَوَّدَ / اِسْوَدَّ",
 "くろひょう": "نَمِر أَسْوَد (عضو في حزب الفهود السود السياسي)",
 "くろふ": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "くろふさすぐり": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "くろぶち": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "くろへび": "ثعبان أسود, متسابق أسود (ثعبان متسابق مسود من شرق الولايات المتحدة ينمو حتى ستة أقدام) / ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "くろほ": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "くろほびょう": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "くろぼ": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "くろぼきん": "تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس)",
 "くろぼし": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات) / خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "くろぼびょう": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "くろまい": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "くろまく": "عبقري, فذ (شخص لديه قدرة فكرية استثنائية وأصالة في التفكير) / العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)\nمثال: كان موزارت طفلاً عبقرياً",
 "くろまじゅつ": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "くろまだら": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "くろまつ": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا) / صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…) / صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني) / صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "くろまほう": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "くろまめのき": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "くろまる": "سَوَّدَ / اِسْوَدَّ / بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "くろみがかった": "مَائِل لِلسَّوَاد (مائل إلى السواد قليلاً)",
 "くろみずひき": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "くろみつ": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "くろむ": "سَوَّدَ / اِسْوَدَّ",
 "くろむぎ": "سُلْت, شَيْلَم",
 "くろむし": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً كطعم للصيد)",
 "くろめがね": "نَظَّارَة شَمْسِيَّة, نَظَّارَة شَمْس",
 "くろめまめ": "لُوبِيَاء, لُوبِيَا",
 "くろめる": "سَوَّدَ / اِسْوَدَّ",
 "くろも": "هيدريلا (نبات مغمور بأوراق رمحية محيطية وأزهار إبطية منعزلة؛ نبات من العالم القديم استوطن في جنوب الولايات المتحدة ويسد الممرات المائية في فلوريدا)",
 "くろもじ": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "くろやき": "شار",
 "くろやけ": "شار",
 "くろやま": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء.",
 "くろらいちょう": "طيهوج أسود (طيهوج يكون الذكر فيه أسود مزرق)",
 "くろらか": "سَوَاد",
 "くろんぼ": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا)) / أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم) / عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "くろんぼう": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا)) / أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم) / عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "くろインゲンまめ": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "くろコショウ": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "くろシャツ": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "くろシャツたい": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "くろシャツとう": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "くろスグリ": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "くろダイヤ": "ألماس أسود, كربونادو (ألماس داكن أقل جودة يستخدم صناعياً للحفر والتلميع)",
 "くろパン": "خُبْز أَسْمَر (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "くろビール": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "くわ": "تُوت / مِعْزَقة",
 "くわいれ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "くわうるに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "くわえざん": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "くわえて": "بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "くわえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / تضمن / اِتِّفَاقِيَّة",
 "くわがた": "حُنْظُب / خُنْفُسَاء الْأَيِّل",
 "くわがたむし": "حُنْظُب / خُنْفُسَاء الْأَيِّل",
 "くわけ": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "くわこ": "دودة قز عملاقة (يرقة عثة ساتورنيد؛ تغزل كمية كبيرة من الحرير القوي في بناء شرنقتها) / دُودَة اَلْقَزّ",
 "くわご": "دودة قز عملاقة (يرقة عثة ساتورنيد؛ تغزل كمية كبيرة من الحرير القوي في بناء شرنقتها) / دُودَة اَلْقَزّ",
 "くわしい": "مُفَصَّل / عَارِف / عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "くわしく": "بِالتَّفْصِيل, تَفْصِيلًا / أَعْطِنِي",
 "くわす": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "くわせもの": "مُزَيَّف / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "くわせる": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "くわだて": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "くわだてる": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه. / حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "くわちゃ": "مغرة صفراء (صبغة تتكون من الليمونيت الممزوج بالطين والسيليكا)",
 "くわっちーさびら": "شُكْرًا, تِسْلَم",
 "くわはじめ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "くわり": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي) / تخم, حد (حدود منطقة معينة)\nمثال: هناك خط رفيع بين العقل والجنون",
 "くわわる": "شَارَكَ, سَاهَمَ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "くわん": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / رنين (صوت رنين)",
 "くわ入れ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "くん": "سيد (صيغة خطاب للرجل) / سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية)) / مخطوطة (شكل العمل الأدبي المقدم للنشر) / ماجستير العلوم (درجة الماجستير في العلوم) / تصلب متعدد (اضطراب عصبي تدريجي مزمن ينطوي على فقدان غمد المايلين حول ألياف عصبية معينة) / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق. / مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / جَدَارَة / أريج, رائحة (أي خاصية تكتشف بواسطة الجهاز الشمي) / أريج, شذا (رائحة مميزة ومستحبة) / طَيِّب الرَّائِحَةِ, عَطِر (ذُو رَائِحَة مُسْتَحَبَّة) / قَوِيّ الرَّائِحَةِ, نَفَّاذ (ذُو رَائِحَة قَوِيَّة نَفَّاذَة)",
 "くんいく": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "くんえん": "تَدْخِين",
 "くんか": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ) / فَسَّرَ / أَبَانَ\nمثال: شكرا على الشرح.",
 "くんかい": "تَحْذِير, إِنْذار / تَفْسِير / شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ) / فَسَّرَ / أَبَانَ\nمثال: شكرا على الشرح.",
 "くんくん": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "くんくんなく": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "くんくん鳴く": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "くんこ": "تَفْسِير",
 "くんこう": "جَدَارَة / بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "くんこがく": "تأويلي, تفسيري (متعلق بالتفسير (خاصة للنصوص الدينية))",
 "くんこく": "مَلِكِيَّة / عَزْر / توبيخ ;تقريع",
 "くんし": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "くんしゅ": "عَاهِل",
 "くんしゅこく": "مَلِكِيَّة",
 "くんしゅしゅぎ": "ملكية (الإيمان بالملكية كنظام سياسي والدعوة إليها)",
 "くんしゅせい": "مَلِكِيَّة",
 "くんしゅせいたい": "مَلِكِيَّة",
 "くんしょう": "زينة",
 "くんじ": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "くんじょう": "تبخير, تعقيم بالدخان (تطبيق غاز أو دخان على شيء لغرض تطهيره)",
 "くんじょうざい": "مادة تبخير, مبيد تبخيري (مادة كيميائية تستخدم في التبخير)",
 "くんじょうしょうどく": "تبخير, تعقيم بالدخان (تطبيق غاز أو دخان على شيء لغرض تطهيره)",
 "くんせい": "تَدْخِين / مُدَخَّن ((خَاصَّةً عَنِ اللُّحُوم وَالأَسْمَاك) مُجَفَّف وَمَحْفُوظ بِالتَّعْلِيق فِي دُخَان الخَشَب)",
 "くんだり": "حتى النهاية, طوال الطريق (إلى الهدف) / إلى أبعد حد (كناية عن الوصول للعلاقة الجنسية الكاملة) / تَمَامًا, كُلِّيًّا\nمثال: تسلقت الجبل حتى النهاية",
 "くんてき": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "くんとう": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / تَعْلِيم, ثَقَافَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "くんどう": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "くんなまし": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "くんゆ": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "くんりん": "حَاكِم, سَائِد (يمارس السلطة أو الحكم فعلياً) / مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة) / مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "くんれい": "إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً) / تعليمات, توجيه (تصريح يشجع أو يحظر نشاطاً ما)\nمثال: يحب المدير أن يرسل لنا التوجيهات",
 "くんれん": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "くんれんしょ": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "くんれんじょ": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "くんれんせい": "مُتَدَرِّب, مُتَدَرِّبَة",
 "くんろ": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "くん蒸": "تبخير, تعقيم بالدخان (تطبيق غاز أو دخان على شيء لغرض تطهيره)",
 "くッ": "يَع",
 "くノ一": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "ぐ": "أَدَاة / مُقَوِّم / حَمَاقَة (خطأ سخيف) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぐあい": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / حَالَة, ظَرْف",
 "ぐあいがわるい": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض) / مُعَطَّل / غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ / غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ぐあん": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حَمَاقَة (خطأ سخيف)",
 "ぐいぐい": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة / بشدة, بقوة (بقوة أو بطريقة قوية) / بشدة, بقوة (بطريقة قوية)\nمثال: يجادل بقوة لاقتراحه / بثقل, بشكل كبير (بدرجة كبيرة) / بإفراط, بشراهة (الانغماس بإفراط) / بثقل, بصعوبة (بطريقة مجهدة) / بثقل (ببطء كما لو كان مثقلاً بوزن كبير)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "ぐう": "صَخْرَة, حجر / صَخْرَة / رُوك, مُوسِيقَى اَلرُّوك / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد / عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ぐうい": "رَمْزِيَّة",
 "ぐういげき": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل والرذائل)",
 "ぐういしょうせつ": "تَمْثِيل",
 "ぐういてき": "تَمْثِيلِيّ, رَمْزِيّ (يُستخدم في الرمز أو يتميز به أو يحتوي عليه)",
 "ぐうかく": "زَاوِيَة, رُكْن",
 "ぐうきせい": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري) / بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا) / تَمَاثُل, زَوْجِيَّة ((الرياضيات) علاقة بين زوج من الأعداد الصحيحة: إذا كان كلاهما فردياً أو كلاهما زوجياً فلهما نفس الزوجية)",
 "ぐうぐう": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "ぐうげん": "تَمْثِيل",
 "ぐうご": "مُحَادَثَة / مُكَالَمَة / حِوَار / مُذَاكَرَة / مُحَاوَرَة / تَكَلُّم (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "ぐうじん": "دُمْيَة",
 "ぐうす": "عَالَجَ",
 "ぐうすう": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ぐうすううじょうふくよう": "زَوْجِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بزوج من الوريقات عند القمّة)",
 "ぐうすか": "بشكل جيد, بقوة (كلياً وبالكامل) / بثقل, بعمق (بعمق أو بشكل كامل)\nمثال: هُزم شر هزيمة",
 "ぐうする": "عَالَجَ / اِنْطَوَى",
 "ぐうせい": "ارتجالياً, بشكل عفوي (بدون تحضير مسبق) / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما) / ارتجال (خطاب أو ملاحظة مرتجلة) / إمبرومبتو, مرتجلة (مقطع موسيقي قصير يبدو وكأنه صُنع بعفوية دون تحضير مسبق)\nمثال: تحدث ارتجالياً",
 "ぐうぜん": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "ぐうぜんせい": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "ぐうぜんにも": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "ぐうぜんのいっち": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "ぐうぞう": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "ぐうぞうか": "تقديس أعمى, عبادة الأصنام (فعل العبادة بشكل أعمى ومفرط) / تبجيل, عشق (فعل الإعجاب بشدة)",
 "ぐうぞうきょう": "وَثَنِيَّة",
 "ぐうぞうきょうとてき": "مُتَعَبِّد, مُتَفَانٍ (مخلص أو مُعجَب بشكل أعمى أو مفرط) / عبادي للأصنام, وثني (يتعلق بعبادة الأصنام أو يمارسها)\nمثال: عبادة وثنية",
 "ぐうぞうし": "تقديس أعمى, عبادة الأصنام (فعل العبادة بشكل أعمى ومفرط) / تبجيل, عشق (فعل الإعجاب بشدة)",
 "ぐうぞうすうはい": "وَثَنِيَّة",
 "ぐうぞうすうはいしゃ": "عابد الأصنام, وثني (شخص يعبد الأصنام)",
 "ぐうぞうはかい": "أيقونية, تحطيم المعتقدات التقليدية (توجه يهدف إلى مهاجمة المعتقدات أو المؤسسات الراسخة)",
 "ぐうぞうれいはい": "وَثَنِيَّة",
 "ぐうたら": "كَسُول, مِكْسَال",
 "ぐうているい": "شفعيات الأصابع, مزدوجات الأصابع (ثدييات مشيمية لها حوافر بعدد زوجي من الأصابع الوظيفية في كل قدم) / شفعي الأصابع (من أو متعلق بـ أو ينتمي إلى الثدييات من رتبة مزدوجات الأصابع)",
 "ぐうはつ": "عَرْضِيّ",
 "ぐうはつさいむ": "التزام طارئ, خصوم محتملة (التزامات قد تتكبدها المنشأة اعتماداً على نتيجة حدث مستقبلي غير مؤكد مثل قضية قضائية)\nمثال: تشمل أمثلة الالتزامات الطارئة الدعاوى القضائية المعلقة وضمان المنتج والمطالبات ضد الشركة التي لم يتم الاعتراف بها كديون",
 "ぐうはつじようてつづき": "إجراء طوارئ (بديل للإجراء العادي؛ يتم تفعيله إذا نشأ موقف غير عادي ولكنه متوقع)",
 "ぐうはつせい": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "ぐうはつてき": "عَرْضِيّ",
 "ぐうゆ": "تَمْثِيل",
 "ぐうゆうせい": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "ぐうりょく": "زَوْجَانِ / بَعْضُ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "ぐうわ": "خُرَافَة, أُسْطُورَة / خُرَافَة",
 "ぐがん": "ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد) / حَاذِق, مُمَيِّز (قَادِر عَلَى إِدْرَاك الفُرُوقَات الدَّقِيقَة؛ حَسَّاس) / سَرِيعُ الفَهْم, فَطِن (سَرِيعُ الإِدْرَاكِ وَالاسْتِيعَاب) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: ناقد فطن",
 "ぐきぐき": "بانتفاض, بحركات متقطعة (بحركات اهتزازية) / بتشنج, بحركات ارتعاشية (مع تشنجات)\nمثال: نهضت بتصلب وحركات متقطعة من مقعد النافذة",
 "ぐぐっと": "بسرعة, سريعاً\nمثال: يعمل بسرعة",
 "ぐぐる": "جُوجِل, غُوغِل\nمثال: 「どんなことでも直ぐに分かります、・・・ググれば」「ググれば？」 — \"بإمكانك أن تعرف عن أي شيء في لحظة؛إذا بحثت باستخدام جوجل.\" \"جوجل؟\"",
 "ぐけい": "اَلْأَخ اَلْأَكْبَر / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ぐげん": "الحُلُول / التَّجَسُّد, التَّأَنُّس",
 "ぐげんか": "تَجَسَّد",
 "ぐこう": "حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "ぐさい": "قُرْبَان / زَوْجَة, اِمْرَأَة / خَلَاص, تَطْهِير اَلنَّفْس",
 "ぐさく": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها) / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ぐさぐさ": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا) / عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع / فَضْفَاض, واسِع",
 "ぐさっと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق",
 "ぐさり": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق",
 "ぐざい": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ぐし": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "ぐしぐし": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "ぐしぬい": "غرزة السراجة (غرز يدوية صغيرة ومتساوية تمر للداخل والخارج)",
 "ぐしゃ": "مُغَفَّل, أَحْمَق",
 "ぐしゃぐしゃ": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / عَجينِيّ, غَيْر مُخْتَمِر (ذو قِوام العَجين بِسَبَب قِلَّة التَّخْمير أو سوء الطَّبْخ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء) / مَكْسُور, مُذَلَّل (خاضع أو مُنزَل إلى حالة أو مكانة متدنّية) / مَهْرُوس, مُجَعَّد (مضغوط أو مجعّد السطح) / فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "ぐしゃっと": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "ぐしゃり": "مسحوق, مهروس (الذي تم ضغطه بعنف)\nمثال: العري المهروس للطيور الصغيرة",
 "ぐしゅん": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ぐしょう": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "ぐしょうか": "إبراز, تجسيد خارجي (التجسيد في شكل خارجي)",
 "ぐしょうてき": "مَادِّيّ / خَرَسَانَة",
 "ぐしょうめいし": "اِسْمُ ذَاتٍ (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "ぐしょぐしょ": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً",
 "ぐしょぬれ": "مُبْتَلّ تَمَامًا, مُشَبَّع بِالْمَاء (مبلَّل كلّيًّا ومشبَّع بالماء)",
 "ぐしょ濡れ": "مُبْتَلّ تَمَامًا, مُشَبَّع بِالْمَاء (مبلَّل كلّيًّا ومشبَّع بالماء)",
 "ぐしん": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぐし縫": "غرزة السراجة (غرز يدوية صغيرة ومتساوية تمر للداخل والخارج)",
 "ぐじ": "تايلفيش (سمكة غذائية بنفسجية مرقطة بالأصفر تعيش في المياه العميقة الدافئة) / بلانكيلو (أسماك غذائية بحرية مهمة)",
 "ぐじぐじ": "بشكل متأخر, متأخراً (في وقت لاحق عن المعتاد أو المتوقع) / ببطء, على مهل (بدون سرعة)\nمثال: وصل القطار متأخراً",
 "ぐじゃぐじゃ": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / عَجينِيّ, غَيْر مُخْتَمِر (ذو قِوام العَجين بِسَبَب قِلَّة التَّخْمير أو سوء الطَّبْخ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء) / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "ぐじょ": "اِبْنَة, بِنْت",
 "ぐじん": "مُغَفَّل, أَحْمَق",
 "ぐす": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "ぐすく": "مَعْبَد",
 "ぐすぐす": "شَهَّاق, نَشَّاج (يميل إلى الشهقة والنشيج من البكاء)",
 "ぐする": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "ぐすん": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "ぐすーよー": "اَلْجَمِيع, كُلّ شَخْص",
 "ぐず": "ثقيل الظل, شخص ممل (شخص يبعث على الملل) / أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "ぐずう": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "ぐずぐず": "بِبُطْء / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ) / غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد) / غير مستقر (غير مستقر أو مؤسس) / غير محسوم, معلق (لا يزال موضع شك) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: نمط حياة غير مستقر / فَضْفَاض, واسِع",
 "ぐずつく": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "ぐずらぐずら": "ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء",
 "ぐずりなき": "بَاكٍ / بُكَاء",
 "ぐずり泣き": "بَاكٍ / بُكَاء",
 "ぐずる": "قَمْقَمَ",
 "ぐせい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぐぜ": "خَلَاص, تَطْهِير اَلنَّفْس",
 "ぐそう": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぐそく": "اكْتِمَال, تَمَام ((منطق) سمة لنظام منطقي مكون بحيث ينشأ تناقض إذا تم إدخال أي قضية لا يمكن اشتقاقها من بديهيات النظام) / تمام, كمال (حالة كونه كاملاً وتاماً؛ امتلاك كل ما هو مطلوب) / دِرْع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "ぐたい": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "ぐたいか": "تَجَسَّد",
 "ぐたいせい": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "ぐたいてき": "مَادِّيّ / خَرَسَانَة",
 "ぐたぐた": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل / باسترخاء, بكسل (بطريقة خاملة) / بكسل (بطريقة بطيئة وكسولة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "ぐたり": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "ぐだくさん": "حَمِيم, عَمِيق (عميق الإحساس وصادق المشاعر) / جَلْد, قَوِيّ (ذو صِحَّة قَوِيَّة وطاقَة عالِيَة) / فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / حَارّ, صَادِق (يُظهر ودًّا حارًّا وصادقًا نابعًا من القلب)",
 "ぐだぐだ": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل / باسترخاء, بكسل (بطريقة خاملة) / بكسل (بطريقة بطيئة وكسولة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "ぐち": "قَمْقَمَ",
 "ぐちぐち": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام)",
 "ぐちっぽい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "ぐちゃぐちゃ": "طَرِيّ, لُبِّيّ (يُشْبِهُ اللُّبَّ أَوِ الثَّمَرَ المُفْرِطَ النُّضْجِ؛ لَا يَتَّسِمُ بِالصَّلَابَةِ) / غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي) / فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض) / مُبَعْثَر (يَفْتَقِرُ إِلَى التَّرْتِيبِ وَالنِّظَام)",
 "ぐちょぐちょ": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً",
 "ぐちる": "قَمْقَمَ",
 "ぐちをこぼす": "تذمر دائم (شكوى مزعجة ومستمرة) / دائم الشكوى ((اليديشية) شخص يشتكي باستمرار)",
 "ぐっしょり": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً",
 "ぐっすり": "بشكل جيد, بقوة (كلياً وبالكامل) / بثقل, بعمق (بعمق أو بشكل كامل)\nمثال: هُزم شر هزيمة",
 "ぐったり": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "ぐっちゃぐちゃ": "طَرِيّ, لُبِّيّ (يُشْبِهُ اللُّبَّ أَوِ الثَّمَرَ المُفْرِطَ النُّضْجِ؛ لَا يَتَّسِمُ بِالصَّلَابَةِ) / غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي) / فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض) / مُبَعْثَر (يَفْتَقِرُ إِلَى التَّرْتِيبِ وَالنِّظَام)",
 "ぐっと": "فَجْأَةً / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم / تَمَامًا",
 "ぐつう": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "ぐつぐつ": "سلق, غلي (الطهي في سائل تم غليه)",
 "ぐてい": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "ぐとく": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぐどん": "غَبِيّ / غَبِيّ, أَحْمَق",
 "ぐない": "تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة",
 "ぐにぐに": "مَطَّاطِيّ (له قوام مرن يُشبه المطّاط في ليونته أو صلابته) / غُضْرُوفِيّ, مَطَّاطِيّ (صعب المضغ كالغضروف)",
 "ぐにもつかない": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ぐにゃぐにゃ": "مُتَرَهِّل",
 "ぐにゃっと": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "ぐにゃり": "بترهل, برخاوة (بطريقة مترهلة)\nمثال: كانت عضلات الرجل العجوز تتدلى بترهل",
 "ぐにん": "مُغَفَّل, أَحْمَق",
 "ぐぬぬ": "لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة",
 "ぐねぐね": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "ぐねり": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "ぐねる": "اِلْتِوَاء",
 "ぐはつ": "تَزَامُن, تَوَافُق (العمل معاً، كوكلاء أو ظروف أو أحداث) / تزامن, تصادف (الخاصية الزمنية لحدوث شيئين في نفس الوقت) / تزامن, توافق (اتفاق النتائج أو الآراء) / تلاقى الأفكار, توافق (حالة من التعاون)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "ぐび": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "ぐびじんそう": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "ぐふ": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "ぐふう": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء. زَوْبَعَة؛ دوّامات هوائيّة شديدة السرعة تدور حول مراكزٍ من الهواء عالي الضغط، سواء كانت فوق الأرض أو فوق الماء. [])\nمثال: السطح دمر من قبل الإعصار.",
 "ぐふふ": "إِهْلَاس",
 "ぐぶ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "ぐぶぐぶ": "غَرْغَرَ, بَقْبَقَ",
 "ぐぶつ": "مُغَفَّل, أَحْمَق",
 "ぐほうしゃ": "سائل, مستفسر (شخص يطرح سؤالاً)",
 "ぐまい": "غَبِيّ / غَبِيّ, أَحْمَق",
 "ぐむ": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "ぐめん": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما) / آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / تجهيز مؤقت, تلفيق (أي ترتيب مرتجل للاستخدام المؤقت) / ابتكار, براعة (ملكة الابتكار؛ مهارة ابتكارية)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "ぐもう": "غَبِيّ / غَبِيّ, أَحْمَق",
 "ぐゆう": "استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب",
 "ぐらい": "حَوَالَيْ, تَقْرِيبًا / عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "ぐらぐら": "مُتَأَرْجِح, مُتَمَوِّج ((للصوت) يتذبذب بشكل غير ثابت) / مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل) / تَذَبْذُب, تَقَلُّب (صفة كون الشيء غير ثابت وخاضع للتغيرات) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: احتفظ بسجل لتقلبات الأسعار / بدوار, بدوخة (بطريقة دوارة أو خفيفة الرأس)\nمثال: مشى حوله بدوار",
 "ぐらし": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "ぐらつく": "بَكَرَة / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "ぐりぐり": "أَدَارَ عَيْنَيْهِ, بَرَمَ عَيْنَيْهِ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ) / قَعْقَعَ / خُشْخِيشَة, شُخْلِيلَة",
 "ぐる": "شَرِيك فِي جَرِيمَة",
 "ぐるぐる": "في دوائر مفرغة (دون إحراز تقدم)\nمثال: تحدث المرشحان في دوائر مفرغة",
 "ぐるぐるまき": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "ぐるぐる巻き": "حَلَزُونِيّ, لَوْلَبِيّ (على شكل لفائف حلزونية)",
 "ぐるっと": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "ぐるになる": "تَآمَرَ, اِئْتَمَرَ",
 "ぐるみ": "شَامِل",
 "ぐるり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "ぐるりと": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "ぐれえ": "حَوَالَيْ, تَقْرِيبًا / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "ぐれつ": "حَمَاقَة (خطأ سخيف)",
 "ぐれんたい": "دَمَوِيّ, سَفَّاح",
 "ぐれん隊": "دَمَوِيّ, سَفَّاح",
 "ぐろい": "غَرِيب",
 "ぐろう": "اِسْتِهْزَاء / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぐゎー": "صَغِير, صغير",
 "ぐわい": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / حَالَة, ظَرْف",
 "ぐん": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش. / فَرِيق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / قيادة, منصب القائد (منصب أو مكتب القائد)",
 "ぐんいそうかん": "جراح عام (كبير الضباط الطبيين في الجيش أو البحرية) / الجراح العام (رئيس دائرة الصحة العامة بالولايات المتحدة)",
 "ぐんえき": "خِدْمَةٌ عَسْكَرِيَّة",
 "ぐんか": "بسطار",
 "ぐんかくきょうそう": "سِبَاق تَسَلُّح",
 "ぐんかん": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "ぐんかんちょう": "فِرْقَاطَة",
 "ぐんかんどり": "فِرْقَاطَة",
 "ぐんがく": "علوم عسكرية (التخصص الذي يتعامل مع مبادئ الحرب) / مارش عسكري, موسيقى عسكرية (موسيقى مسير حيوية مناسبة للجنود الذين يسيرون في عرض عسكري)",
 "ぐんがくちょう": "فرقة عسكرية, فرقة موسيقية للحفلات (مجموعة من الموسيقيين يعزفون على الآلات النحاسية وآلات النفخ الخشبية والإيقاعية)",
 "ぐんがっこう": "مَدْرَسَةٌ عَسْكَرِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "ぐんき": "أسلحة, تسليح (الأسلحة مجتمعة) / راية المعركة (علم يقود القوات إلى المعركة)",
 "ぐんきちかん": "إحباط المعنويات, إفساد الأخلاق (تدمير الأساس الأخلاقي لعقيدة أو سياسة) / انهيار معنوي, تثبيط العزيمة (اكتئاب ناتج عن تقويض معنوياتك) / إحباط, تثبيط (حالة من الاضطراب والارتباك)\nمثال: أدى عدم ثباته إلى إحباط معنويات موظفيه",
 "ぐんきゅう": "حَمامَةٌ زاجِلة, حَمامٌ زاجِلٌ",
 "ぐんきょ": "أنيسية, حب الاجتماع (صفة كون المرء اجتماعياً — كره البقاء وحيداً)",
 "ぐんぐん": "بسرعة, سريعاً\nمثال: يعمل بسرعة",
 "ぐんけい": "دجاج الصيد (أي من السلالات المتعددة التي تربى لمصارعة الديوك) / تَشَكُّل / تَشْكِيلَة / شُرْطَة عَسْكَرِيَّة, الشُّرْطَة الْعَسْكَرِيَّة",
 "ぐんけいさつ": "شُرْطَة عَسْكَرِيَّة, الشُّرْطَة الْعَسْكَرِيَّة",
 "ぐんこう": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "ぐんこくか": "عَسْكَرَة",
 "ぐんこくしゅぎ": "عَسْكَرِيَّة",
 "ぐんこくしゅぎしゃ": "دَاعِيَة حَرْب, مُحِبّ لِلْحَرْب (شخص يدعو للحرب أو السياسات الحربية)",
 "ぐんさよう": "عَمَل جَمَاعِيّ (إجراء يتّخذه مجموعة من الناس)",
 "ぐんさんふくごうたい": "مَجْمَع صِنَاعِيّ عَسْكَرِيّ (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "ぐんざん": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "ぐんし": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / استراتيجي, خبير استراتيجي (خبير في الاستراتيجية (خاصة في الحرب))",
 "ぐんしきん": "صندوق طوارئ, ميزانية حرب (صندوق مجمع لتمويل حرب (أو حملة سياسية)) / أموال, موارد مالية (أصول في شكل مال)",
 "ぐんしゃ": "فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة",
 "ぐんしゅ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "ぐんしゅう": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / كَوْم",
 "ぐんしゅく": "نَزْع السِلَاح (قَلَعَ، أَزَالَ؛ خَلَعَ)\nمثال: نزع زيري البساط.",
 "ぐんしょう": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "ぐんしょく": "مركز عسكري, موقع عسكري (منشأة عسكرية تتمركز فيها مجموعة من القوات)\nمثال: يوفر هذا الموقع العسكري مصدراً هاماً للدخل للمدينة المجاورة",
 "ぐんしれいぶ": "المقر الرئيسي, مقر القيادة (المنشأة العسكرية التي يؤدي منها القائد مهام القيادة)\nمثال: كان مقر الجنرال عبارة عن خيمتين كبيرتين",
 "ぐんしん": "إله الحرب (إله يُعبد بصفته مانحاً للنصر في الحرب)",
 "ぐんじ": "قِنِّينَةُ مَاء (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك)\nمثال: لم يبق في القنينة أي ماء. / زَهْرِيَّة",
 "ぐんじえんしゅう": "مُنَاوَرَة عَسْكَرِيَّة",
 "ぐんじか": "عَسْكَرَة",
 "ぐんじがく": "علوم عسكرية (التخصص الذي يتعامل مع مبادئ الحرب)",
 "ぐんじがっこう": "مَدْرَسَةٌ عَسْكَرِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "ぐんじきょうれん": "تدريب عسكري (تدريب الجنود على الإجراءات العسكرية)",
