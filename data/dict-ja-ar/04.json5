{
 "きねん": "صَلَاة, دُعَاء / تأبين, تذكار (اعتراف بالخدمة الجديرة بالتقدير) / تذكار (شيء يذكر بأحداث الماضي) / أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما)\nمثال: أيام الملك الأخيرة",
 "きねんかん": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "きねんさい": "عِيد سَنَوِيّ / اجتماع صلاة (خدمة يغني فيها الناس الترانيم ويصلون معًا)",
 "きねんすべき": "جَسِيم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى…)\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "きねんぞう": "نُصُب, مَعْلَم تَذْكَارِيّ",
 "きねんひてき": "صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة)\nمثال: استخدام القوس في العمارة النصبية",
 "きねんひん": "تَذْكار",
 "きねんび": "يوم الذكرى (عطلة قانونية في الولايات المتحدة، آخر يوم اثنين في مايو؛ يحيي ذكرى أعضاء القوات…)",
 "きねんぶつ": "تَذْكار",
 "きねんろんぶんしゅう": "كتاب تكريمي (مجموعة من الكتابات المنشورة تكريماً لعالم ما)",
 "きねんスタンプ": "ختم الرسالة (ختم على رسالة)",
 "きのあらい": "عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "きのいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "きのう": "وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث)\nمثال: استحثاث حالة التخدير / كيس هوائي (أي من الامتدادات الغشائية المملوءة بالهواء لرئات الطيور) / غلاف غازي, كيس المنطاد (الكيس الذي يحتوي على الغاز في المنطاد)",
 "きのうかくちょう": "تَمْدِيد",
 "きのうご": "كَلِمَة وَظِيفِيَّة (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "きのうしゅぎ": "وظيفية (أي مذهب يركز على المنفعة أو الغرض)",
 "きのうしょうがい": "اضطراب وظيفي (اضطراب يظهر أعراضاً لا يمكن تحديد سبب فسيولوجي أو تشريحي لها)",
 "きのうせい": "عَمَلِيَّة, وَظِيفِيَّة (القدرة على خدمة غرض ما بشكل جيد)\nمثال: برمجيات ذات وظيفية أكبر",
 "きのうたんいつかぶんぽう": "جو خانق ((عامية بريطانية) جو كريه الرائحة ودخاني وعديم الهواء)",
 "きのうてき": "اسْتِقْرَائِيّ, تَحْرِيضِيّ (يحثّ أو يؤثّر؛ يقود إلى فعلٍ ما)\nمثال: تفكير استقرائي / عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "きのうふぜん": "خلل وظيفي, قصور وظيفي (أي اضطراب في أداء عضو أو جزء من الجسم، أو اضطراب في عمل مجموعة اجتماعية)\nمثال: ضعف الانتصاب",
 "きのうほう": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث)\nمثال: استحثاث حالة التخدير",
 "きのえね": "جرذ الخشب (أي من القوارض الصغيرة قصيرة الذيل المتنوعة في نصف الكرة الشمالي، تتميز بفراء…)",
 "きのおおい": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "きのおおきい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "きのおけない": "بَشُوش, لَطِيف (يَنْشُرُ الدِّفْء وَالوُدّ مِنْ حَوْلِه)",
 "きのかわ": "نَبَحَ, يَنْبَح",
 "きのきいた": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "きのきく": "مُنْتَبِه / أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "きのこぐも": "سحابة الفطر (سحابة كبيرة من الحطام والغبار على شكل فطر ترتفع في السماء بعد انفجار (خاصة…)",
 "きのこ雲": "سحابة الفطر (سحابة كبيرة من الحطام والغبار على شكل فطر ترتفع في السماء بعد انفجار (خاصة…)",
 "きのしれた": "مَوْثُوق بِه, مُؤْتَمَن ((يوصف به الأشخاص) جدير بالثقة والاعتماد)",
 "きのせい": "حورية الغابة, درياد (إلهة أو حورية الغابات)",
 "きのちいさい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "きのつまる": "قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي)",
 "きのつよい": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "きのとう": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض…)",
 "きのとおくなる": "دَائِخ / غَالِب",
 "きのどく": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / غير قابل للعفو, لا يغتفر (مما لا يقبل العفو)\nمثال: سلوك لا يغتفر",
 "きのどくにおもう": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "きのない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "きのながい": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "きのぬけた": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير)",
 "きのは": "وَرَقَة, وَرَقة",
 "きのはやい": "مُتَسَرِّع",
 "きのぼりうお": "فرخ متسلق (فرخ صغير من الهند تحورت خياشيمه لتسمح له بتنفس الهواء؛ وله زعانف صدرية شوكية…)",
 "きのぼりカンガルー": "كنغر شجري, ولب الشجر (ولب شجري من غينيا الجديدة وشمال أستراليا له أرجل خلفية وأمامية متساوية الطول)",
 "きのままで": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "きのまよい": "خِدَاع, ضَلَالَة",
 "きのみ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "きのみじかい": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "きのめ": "برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور))",
 "きのやまい": "انهيار عصبي (اضطراب عاطفي شديد أو معجز)",
 "きのよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "きのよわい": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "きのり": "فَائِدَة",
 "きのりうす": "غير متحمس, فاتر (غير متحمس؛ يفتقر إلى الإثارة أو الحماسة)\nمثال: أداء غير متحمس (فاتر) للأوركسترا",
 "きのりしない": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض)",
 "きはい": "ترك, هجران (فعل الهجر أو التخلي)",
 "きはく": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / رَفِيع, رَقِيق / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "きはじゅくす": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "きはずかしい": "مُحْرَج, بِٱلْحَرَج",
 "きはた": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع…)",
 "きはたしか": "عَاقِل (من له عَقْل يعقل به، يطلق على الإنسان وغيره إن كان يعقل؛ ذو النُهَى والرَأي…)\nمثال: لا عاقل يفعل ذلك.",
 "きはだ": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية) / نَبَحَ, يَنْبَح",
 "きはだまぐろ": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "きはちす": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة…)",
 "きはつせい": "استثارية, سرعة التأثر (سهولة الإثارة)\nمثال: دفع تقلب السوق العديد من المستثمرين بعيداً",
 "きはつせいきおくそうち": "تخزين متطاير, ذاكرة متطايرة (تخزين حاسوبي تُمحى بياناته عند إيقاف تشغيل الطاقة)",
 "きはつど": "استثارية, سرعة التأثر (سهولة الإثارة)\nمثال: دفع تقلب السوق العديد من المستثمرين بعيداً",
 "きはつゆ": "بَنْزِين, بِنْزِين",
 "きはつゆぜい": "ضريبة البنزين, ضريبة الوقود (ضريبة على كل غالون من البنزين المباع)",
 "きはらい": "مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا)",
 "きはん": "نَمُوذَج / غُلّ, أَغْلال / رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "きはんてき": "تقريري, معياري (يتعلق بإعطاء توجيهات أو قواعد (للصواب والخطأ))\nمثال: النحو المعياري يهتم بقواعد الاستخدام الصحيح",
 "きはんてきけいざいがく": "اقتصاد معياري (جزء من الاقتصاد يعبر عن قيمة أو أحكام معيارية حول العدالة الاقتصادية أو ما…)",
 "きはんぶんぽう": "نحو معياري (قواعد نحوية تنتجها اللسانيات المعيارية)",
 "きはんりょく": "قضية مقضية (مسألة تم تسويتها بالفعل في المحكمة ولا يمكن إثارتها مرة أخرى)",
 "きば": "نَاب (مَثَّل مكان أحد ما، كان نَائِبا عنه)\nمثال: كم يكلف ناب الفيل؟ / ركوب الخيل (السفر محمولاً على ظهر الخيل) / ساحة أخشاب, مستودع أخشاب (مكان عمل يتم فيه تخزين الأخشاب للبيع)",
 "きばく": "إشعال, إضرام (عملية إضرام النار في شيء ما)",
 "きばくざい": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء…) / زِنَاد",
 "きばくそうち": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء…)",
 "きばさみ": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "きばた": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع…)",
 "きばたらき": "حِسّ, لَبَاقَة (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ…)\nمثال: لديهم حس الفكاهة.",
 "きばたん": "كوكاتو كبريتي العرف (كوكاتو أبيض ذو عرف أصفر قابل للانتصاب)",
 "きばだち": "مَوْقِف حِصَان",
 "きばつ": "غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي",
 "きばなすずしろ": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "きばのろ": "طرغول مائي (أكبر أنواع الطرغول؛ يعيش في المناطق المستنقعية بغرب أفريقيا)",
 "きばむ": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "きばむしゃ": "غَيْر مُكْتَرِث (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きばや": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "きばらい": "مَدْفُوعٌ مُسْبَقًا (مَدْفُوعُ الثَّمَنِ مُقَدَّمًا)",
 "きばらし": "اِسْتِجْمَام",
 "きばる": "سُلَالَة / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق",
 "きばをむく": "تشابك, متاهة (شيء مختلط أو مشوش)\nمثال: تشابك من اللوائح الحكومية",
 "きばん": "لَوْحَة, خَشَبَة / قَاعِدَة / أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات / مِنَصَّة",
 "きばんがん": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "きひ": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / تنححي, رد القاضي ((قانون) اعتراض مبني على علاقة القاضي بأحد الأطراف) / تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "きひん": "أَنَاقَة / أريج, رائحة (أي خاصية تكتشف بواسطة الجهاز الشمي) / طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "きひんのある": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "きび": "خفاء, دقة (صفة الصعوبة في الكشف أو التحليل)\nمثال: عليك أن تعجب بدقة الفروق التي رسمها / خَبيث, فَتّاك (يُلحِق ضَرَرًا تَدْريجِيًّا خَفِيًّا ولكِنَّه بالِغ) / حَاسَّة, حِسّ / دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب. / في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان / إحكام, إرفاق (عملية تثبيت الأشياء ببعضها البعض)",
 "きびきび": "بخفَة",
 "きびざとう": "بني فاتح (بني فاتح ولكنه غير مشبع)",
