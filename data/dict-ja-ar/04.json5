 "さいエネ": "الطاقة الخضراء",
 "さい先": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "さい帯": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "さう": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "さえ": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "さえぎる": "قَاطَعَ",
 "さえざえ": "قُبَيْلاً",
 "さえざえした": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "さえざえとした": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "さえずり": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ",
 "さえずる": "غَنَّى",
 "さえつ": "تَفَقُّد",
 "さえない": "كَلِيل / خَيَّبَ آمَالَهُ ((خَيَّبَ)و(خيبه): جعله خائبا وَحرمه وَلم ينله طلبه)\nمثال: خيبة أملها كانت جلية للجميع. / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "さえに": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "さえも": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "さえる": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "さお": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط. / رَقَبَة, عُنُق / خَشَبَة / كَمَرَة, جَائِز / شُعَاع / قَضِيب, ذَكَر",
 "さおさす": "عَمُود, قُطْب / زَانَة",
 "さおばかり": "قَبَّان, قَرَسْطُون",
 "さか": "مُنْحَدَر / مَيْل / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "さかい": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "さかいする": "مُتَّجِه",
 "さかいに": "لِأَنَّ / هكذا, بلا سبب",
 "さかいめ": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "さかえ": "اِزْدِهَار, رَخَاء",
 "さかえる": "ازدهر",
 "さかぐら": "حَانَة, بَار",
 "さかさ": "عَكَسَ",
 "さかさま": "عَكَسَ",
 "さかしい": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "さかしま": "عَكَسَ / عَبَثِيّ, سَخِيف",
 "さかしろ": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "さかだい": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "さかだな": "مُتَّجِر كُحُول",
 "さかつ": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك. / حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "さかて": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "さかてにとる": "اِسْتَغَلَّ",
 "さかとびこみ": "رَأْسِيَّة",
 "さかどいや": "مُتَّجِر كُحُول",
 "さかどんや": "مُتَّجِر كُحُول",
 "さかな": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "さかなつり": "صَيْد سَمَك, صَيْد",
 "さかなや": "سَمَّاك, بَائِع سَمَك",
 "さかなをつる": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "さかのぼる": "صَعِدَ, يَصْعَدُ",
 "さかば": "حَانَة, بَار",
 "さかまた": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "さかみせ": "مُتَّجِر كُحُول",
 "さかむけ": "سَأْفَة",
 "さかもぎ": "حِظَار",
 "さかや": "مُتَّجِر كُحُول",
 "さからう": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "さかり": "اِرْتِفَاع / مُمْتَاز, فَاخِر / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "さかる": "ازدهر / جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "さかん": "اِزْدَهَرَ, أَهَلَّ / مَحْبُوب\nمثال: 我々の国ではウインタースポーツが盛んだ。 — الرياضات الشتوية محبوبة جداً في بلدنا. / نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور. / مُتَحَمِّس",
 "さかんに": "بِنَشَاطٍ",
 "さかんになる": "ازدهر",
 "さが": "عَادَة, عُرْف",
 "さがい": "غِشّ, اِحْتِيال",
 "さがく": "رَصِيد",
 "さがしあてる": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "さがしもとめる": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "さがす": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "さがり": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / الْبَقَايَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "さがる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "さがん": "حَجَر رَمْلِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "さき": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "さきいき": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "さきいれさきだしリスト": "طابُور, صَفّ (وَحْدة عسكريَّة تضمّ عِدَّة سَرايا) / وَقَفَ فِي الصَّفّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: كانا واقفين في طابور.",
 "さきおくり": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "さきがけ": "رَائِد",
 "さきがね": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "さきくぐり": "تَوَقَّعَ, اِرْتَقَبَ",
 "さきごろ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "さきだす": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "さきだち": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "さきだって": "قَبْل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "さきだつ": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "さきだつもの": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "さきっちょ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "さきっぽ": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "さきつおや": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "さきづけ": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "さきて": "خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "さきに": "قَبْلًا, قَبْل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "さきにたつ": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "さきのおや": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "さきのばし": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "さきのばしにする": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "さきのひ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "さきばしり": "فَأل, نَذِيْر / بَشِير, مُبَشِّر / مَذْي",
 "さきばしりえき": "مَذْي",
 "さきばしりじる": "مَذْي",
 "さきばらい": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "さきぶとり": "ازدهر",
 "さきぶれ": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "さきほど": "آنِفاً",
 "さきぼう": "أَدَاة",
 "さきぼそり": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "さきまわり": "تَوَقَّعَ, اِرْتَقَبَ",
 "さきもの": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "さきものがい": "تَكَهُّنٌ / مُضَارَبَة",
 "さきゆき": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "さきよみ": "تَوَقَّعَ",
 "さきわたし": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "さきをいそぐ": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "さきをつづける": "تَابَعَ, اِسْتَمَرَّ",
 "さきん": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "さきんじる": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "さきんずる": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "さきんずればひとをせいす": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "さぎ": "غِشّ, اِحْتِيال",
 "さぎざい": "غِشّ, اِحْتِيال",
 "さぎし": "مُحْتَال",
 "さぎょう": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "さぎょういん": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "さぎょうきおく": "ذَاكِرَة عَامِلَة",
 "さぎょうぎ": "إِرْهَاق, تَعَب / تَعِبَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "さぎょうげんば": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "さぎょうしゃ": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "さぎょうだい": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "さぎょうば": "مَشْغَل, وَرْشَة",
 "さぎょうりょういき": "مِسَاحةُ عَمَل",
 "さぎょうスペース": "مِسَاحةُ عَمَل",
 "さぎり": "سَدِيم",
 "さぎる": "اِحْتِيَال / اِحْتَالَ",
 "さく": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / شَقَّ, فَسَخَ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم. / رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "さくい": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "さくいてき": "عَمْدِيّ, إرَادِيّ",
 "さくいん": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "さくいんさぎょう": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "さくいんつけ": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "さくおう": "تَوَاطُؤ",
 "さくおとこ": "مُسْتَأْجِر",
 "さくか": "كَبْسُولة",
 "さくがら": "مَحْصُول / حَوْصَلة / نَوْعِيَّة, جَوْدَة",
 "さくがんき": "آلَات ثَقْب الصُخُور",
 "さくきょう": "مَحْصُول / حَوْصَلة",
 "さくぐ": "عَالَجَ",
 "さくげん": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "さくこん": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "さくご": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "さくざつ": "تَعْقِيد / مُضَاعَفَة",
 "さくし": "خداع بصري",
 "さくしゃ": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "さくしゃふめい": "مَجْهُول",
 "さくしゃみしょう": "مَجْهُول",
 "さくしゅ": "اِسْتِغْلَال (استخدام الموارد أو الظروف أو الفرص بشكل مثمر أو للحصول على فائدة؛ استغلال شخص أو موقف بشكل غير عادل لتحقيق مكاسب شخصية)\nمثال: يبدو أن رئيس القسم يحب استغلال سلطته. / حَلْب (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: أخرج زيري دلو الحلب.",
 "さくしゅう": "اَلْأُسْبُوع السّابِق",
 "さくじ": "إِطْعَام",
 "さくじつ": "أَمْس / أَمْسِ",
 "さくじょ": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "さくじょう": "كَابْل",
 "さくす": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "さくする": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "さくず": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "さくせい": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "さくせいしゃ": "مُؤَلِّف, مُصَنِّف / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "さくせん": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "さくせんじょう": "إِسْتِرَاتِيجِيّ",
 "さくぜん": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "さくたい": "مَعْقِد / عُقْدَة",
 "さくちゅうじんぶつ": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "さくっ": "بِسُرْعَة, عَاجِلًا",
 "さくつけ": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "さくづけ": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "さくてい": "قَرَار, تَصْمِيم",
 "さくどう": "مُنَاوَرَة, تَدْرِيب عَسْكَرِيّ",
 "さくにゅう": "حَلْب (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: أخرج زيري دلو الحلب.",
 "さくにゅうじょう": "مشتقات الحليب / مَلْبَنَة / حَلِيبِيّ / لَبَنِيّ",
 "さくねん": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "さくば": "مَزْرَعَة",
 "さくばく": "مُقْفِر, مَهْجُور",
 "さくばん": "اَلْبَارِحَةَ\nمثال: 君は昨晩外出しましたか。 — هل خرجت ليلة الأمس؟",
 "さくひん": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "さくひんしゅう": "تَجْمِيعَة, دِيوَان",
 "さくひんめい": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "さくふ": "خَشَبَة",
 "さくふう": "أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "さくぶん": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "さくへん": "شَظِيَّة",
 "さくぼう": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "さくま": "خَمَشَ ((خَمَّشَ): خَدَشَ، وخَمَّشَ وَجْهَهُ تَخْمِيشًا: خَدَشَه؛ (خَمَّشَه): خمشه أى جرح بشرته)",
 "さくもつ": "مَحْصُول / حَوْصَلة",
 "さくもつさいばいがく": "عِلْم الزِرَاعَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "さくもん": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "さくや": "اَلْبَارِحَةَ",
