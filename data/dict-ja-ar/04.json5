 "ごうけんせい": "دُسْتُورِيَّة",
 "ごうけんてき": "بُنْيَوِيّ / دُسْتُورِيّ",
 "ごうこ": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "ごうご": "تَبَاهَى / اَلْإِنْجِلِيزِيَّة الْأُسْتُرَالِيَّة",
 "ごうごう": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "ごうしき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "ごうしゃ": "فَخْم",
 "ごうしゅ": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته واستولت عليه)\nمثال: لقد سلب مني كل شيء.",
 "ごうしゅう": "أُسْتُرَالِيَا, أستراليا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…) / أُسْتُرَالِيَا, أُوسْتُرَالِيَا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "ごうじょう": "مُتَعَنِّت, عَنِيد",
 "ごうじょうがんこ": "مُتَعَنِّت, عَنِيد",
 "ごうじょうっぱり": "عِنَاد",
 "ごうじん": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "ごうする": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "ごうせい": "مُؤَلَّف, مُصَنَّف",
 "ごうせいじゅし": "بْلَاسْتِيك (مادّة لدائنيّة ( مرنة ) عضويّة الأصل أو مركّبة ، يمكن سبكها تحت تأثير الحرارة أو الضَّغط ، تقبل التَّشكيل ، وتصنع منها أدواتٌ مختلفة) / بْلَاسْتِيكِيّ\nمثال: لدي قبعه من البلاستيك .",
 "ごうせいすう": "عَدَد غَيْر أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ごうせいぶつ": "مُرَكَّب (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة)\nمثال: أطلقت الشرطة النار على إطارات مركبة توم.",
 "ごうせき": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "ごうせつ": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "ごうぜん": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "ごうそう": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "ごうそん": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
