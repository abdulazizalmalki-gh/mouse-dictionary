 "きまじめ": "مُفْرِط فِي الجِدِّيَّة (جادّ إلى حدّ المبالغة)",
 "きまずい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "きまって": "دَائِمًا, أَبَدًا",
 "きまつしけん": "امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "きまつテスト": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "きまま": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة) / عَمْدِيّ, مُتَعَمَّد (تَمَّ بِقَصْدٍ وَتَصْمِيم) / مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "きままかって": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "きまめ": "بَازِلَّاء هِنْدِيَّة, بِسِلَّة هِنْدِيَّة",
 "きまよい": "مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل) / تَذَبْذُب, تَقَلُّب (صفة كون الشيء غير ثابت وخاضع للتغيرات) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: احتفظ بسجل لتقلبات الأسعار",
 "きまり": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / مُسْتَعْمَرَة, مُسْتَوْطَنَة / عَادَة / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "きまりがわるい": "مُحْرَج, بِٱلْحَرَج",
 "きまりが悪い": "مُحْرَج, بِٱلْحَرَج",
 "きまりきった": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "きまりごと": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "きまりて": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "きまりもんく": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "きまりわるい": "مُحْرَج, بِٱلْحَرَج",
 "きまり悪い": "مُحْرَج, بِٱلْحَرَج",
 "きまり文句": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "きまる": "نَجَحَ",
 "きまわりない": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم",
 "きまズィー": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "きまゼット": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "きまＺ": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "きみ": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)\nمثال: 私の娘は卵の黄身が好きです。 — ابنتي تحب صفار البيض. / حَاسَّة, حِسّ / مَيْل, نَزَعَة / دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن) / ملَة, مل\nمثال: دخن زيري سيجارة. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / عَاهِل / هُوَ / أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر. / شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "きみかげそう": "زنبق الوادي, كونفالاريا (نبات معمر منخفض النمو له عادة ورقتان كبيرتان مستطيلتان سنانيتان وعنقود من الزهور الصغيرة العطرة المتدلية على شكل جرس تليها توت قرمزي)",
 "きみがかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "きみがわるい": "مخيف",
 "きみじか": "عَصَبِيّ / ضجر, عجول (قلق أو سريع الغضب تحت التأخير أو المعارضة)\nمثال: نافذ الصبر مع الطلاب الأبطاء",
 "きみず": "صَفْرَاء (مؤنث أَصْفَر؛ صفة ما كان لونها الصفار؛ الغُدّة الصفراء: غدة في الكبد، تسمى أيضا الغدّة الصفراوية والمَرَارَة)\nمثال: هذه وردة صفراء.",
 "きみたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "きみつ": "سِرِّيَّة / كَتِيم لِلْهَوَاء, مُحْكَم الإِغْلَاق (لا يسمح بمرور الهواء أو الغاز دخولاً أو خروجاً) / بِلَا ثَغَرَات, مُحْكَم (لَيْسَ فِيهِ نِقَاطُ ضَعْف)\nمثال: これらの容器は気密になっている。 — هذه الحاوياتُ محكمة الإغلاقِ.",
 "きみつかいじょ": "رفع السرية (تخفيض أو إزالة الحكومة للقيود المفروضة على وثيقة أو سلاح سري)",
 "きみつじょうほう": "تَلْمِيح, طَرَف خَيْط (إشارة إلى فرصة محتملة)\nمثال: حصل على نصيحة حول سوق الأسهم",
 "きみつせい": "سرية, كتمان (التكتم في حفظ المعلومات السرية) / خصوصية, سرية (حالة كونه سرياً)\nمثال: يجب عليك احترام سرية اتصالات عميلك",
 "きみつほご": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "きみつほじけいやく": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "きみどり": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "きみのわるい": "مخيف",
 "きみゃく": "صِلَة, صُلَة / عَلَاقَة, صِلَة / وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "きみゃくをつうじる": "تَآمَرَ, اِئْتَمَرَ",
 "きみょう": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "きみら": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "きみわるい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "きむすこ": "شاب (مراهق أو شاب بالغ ذكر)",
 "きむすめ": "بتول, بِكْر (المنقطعه عن الرجال)",
 "きむずかしい": "صَعْب / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال)",
 "きむずかしや": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "きむぢ": "مُخَاطَب",
 "きめ": "مَلْمَس / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم. / تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "きめい": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم. / حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "きめうち": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "きめぇ": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きめえ": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きめこまか": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "きめこまかい": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "きめこまやか": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "きめこむ": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "きめごまか": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "きめつける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "きめて": "عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي)",
 "きめる": "قَرَّرَ, صَمَّمَ / قَرَّرَ / التحام ((ملاكمة) فعل أحد الملاكمين بالإمساك بالآخر لتجنب التعرض للضرب وللراحة لحظياً) / حضن, عناق (عناق قوي أو عاطفي) / مشبك, ملزمة (جهاز (يستخدمه النجارون عادة) يثبت الأشياء معاً بإحكام) / برشمة, طرف المسمار المثني (الجزء المسطح من مسمار أو برغي أو برشام)\nمثال: تعال هنا وأعطني حضنًا كبيرًا / سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "きめー": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きめ細か": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "きめ細かい": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "きめ細やか": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "きも": "كَبِد, كِبْد / سَودَة / شَجَاعَة, جَسَارَة / مَرْبِط الْفَرَس",
 "きもい": "معيب / كُلِّيّ / مُقَرَّف / سَيِّء, جَارِح",
 "きもいり": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "きもう": "خِدَاع, خَدْع",
 "きもがふとい": "جَرِيء, جَسُور",
 "きもくるわんばかり": "بجنون, بهيجان (بطريقة لا يمكن كبحها)\nمثال: قاومت بجنون",
 "きもそぞろ": "قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "きもだま": "أَحْشَاء",
 "きもち": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / قَلِيلًا",
 "きもちいい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة. / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / لَطِيف, مَقْبُول (مطابق لإعجابك أو مشاعرك أو طبيعتك) / مُسْتَعِدٌّ لِلمُوَافَقَةِ (مُهَيَّأٌ لِلمُوَافَقَةِ أَوِ القَبُولِ) / مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ)\nمثال: هل الخطة مقبولة لديك؟",
 "きもちがいい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة. / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / لَطِيف, مَقْبُول (مطابق لإعجابك أو مشاعرك أو طبيعتك) / مُسْتَعِدٌّ لِلمُوَافَقَةِ (مُهَيَّأٌ لِلمُوَافَقَةِ أَوِ القَبُولِ) / مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ)\nمثال: هل الخطة مقبولة لديك؟",
 "きもちがよい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة. / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / لَطِيف, مَقْبُول (مطابق لإعجابك أو مشاعرك أو طبيعتك) / مُسْتَعِدٌّ لِلمُوَافَقَةِ (مُهَيَّأٌ لِلمُوَافَقَةِ أَوِ القَبُولِ) / مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ)\nمثال: هل الخطة مقبولة لديك؟",
 "きもちがわるい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة / غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きもちよい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة. / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / لَطِيف, مَقْبُول (مطابق لإعجابك أو مشاعرك أو طبيعتك) / مُسْتَعِدٌّ لِلمُوَافَقَةِ (مُهَيَّأٌ لِلمُوَافَقَةِ أَوِ القَبُولِ) / مُتَوَافِق, مُنْسَجِم (مُتَّسِقٌ وَمُتَنَاسِقٌ)\nمثال: هل الخطة مقبولة لديك؟",
 "きもちよく": "بشكل ممتع, بلطف (بطريقة ممتعة) / بشكل لطيف, بمرح (بطريقة مرحة ولطيفة)\nمثال: قضينا ظهيرة كسولة بشكل ممتع / طَوْعًا, طَوَاعِيَةً",
 "きもちわるい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة / غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "きもったま": "أَحْشَاء",
 "きもにめいじる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "きもねり": "جَرُؤَ / تَحَدَّى / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "きもの": "كِيمُونُو / مَلَابِس, ثِيَاب",
 "きものじらみ": "قملة الجسم (قملة طفيلية تغزو جسم البشر)",
 "きものすわった": "لَا يَتَزَعْزَع, وَقُور (لا يسهل إزعاجه أو إثارته؛ يتّسم بهدوء وضبط نفس شديدَين)",
 "きもをいる": "إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / التهاب بالاحتكاك, سحجة (ألم ودفء ناتج عن الاحتكاك)\nمثال: كان لديه سحجة سيئة على ركبته / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "きもん": "نقطة ضعف (صفة غير كافية أو ناقصة) / بَوَّابَة / متنفس (فتحة تنفسية)",
 "きゃあ": "زَبُون, عَمِيل",
 "きゃあきゃあ": "صرخة, عويل (صيحة حادة ثاقبة) / صراخ, صرخة (ضجيج عالي النبرة يشبه صرخة الإنسان)\nمثال: جذب صراخها الجيران / ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / صرصرة, طقطقة (سلسلة سريعة من الضوضاء التي تصدرها أجزاء الآلة)",
 "きゃいきゃい": "بابتهاج, بسعادة (بطريقة مبهجة)",
 "きゃいん": "عواء حاد, نباح حاد (صيحة حادة عالية النبرة (خاصة من قبل كلب))",
 "きゃいんきゃいん": "عواء حاد, نباح حاد (صيحة حادة عالية النبرة (خاصة من قبل كلب))",
 "きゃく": "ضَيْف, زَائِر / زَبُون / زَبُون, عَمِيل / رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / تَعْدِيل",
 "きゃくあし": "زَبُون, عَمِيل",
 "きゃくあしらい": "كَرَم, إِكْرَام / ضِيَافَة",
 "きゃくあつかい": "كَرَم, إِكْرَام / ضِيَافَة",
 "きゃくいり": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "きゃくいん": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "きゃくいんきょうじゅ": "أستاذ زائر (أستاذ يزور كلية أو جامعة أخرى للتدريس لفترة محدودة)",
 "きゃくご": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف. / خَبَر (بلاه وامتحنه ليعرف ما يُمكن عنه؛ عرفه على حقيقته بعد أن جربّه)\nمثال: زيري عنده خبرة.",
 "きゃくさき": "زَبُون, عَمِيل",
 "きゃくしき": "شَكْلِيَّة / رتبة, مكانة اجتماعية (الموقع في تسلسل هرمي اجتماعي)\nمثال: البريطانيون أكثر وعياً بالمكانة الاجتماعية من الأمريكيين",
 "きゃくしつ": "غرفة الاستقبال الرسمية, غرفة الصالون (غرفة رسمية يمكن فيها استقبال الزوار والترفيه عنهم) / غرفة صالون, مقصورة قطار خاصة (مقصورة خاصة في عربة النوم بها ثلاثة أسرّة ومرحاض)",
 "きゃくしつがかり": "كاتب الغرف, موظف حجز الغرف (موظف فندق مسؤول عن تخصيص الغرف للنزلاء)",
 "きゃくしゃ": "عربة ركاب (عربة قطار حيث يركب المسافرون) / فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق. / عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة) / سبّاك معادن (عامل يصب المعدن المنصهر في منتجات نهائية)",
 "きゃくしょう": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "きゃくしょうばい": "صناعة الخدمات (صناعة تقدم خدمات بدلاً من سلع ملموسة)",
 "きゃくしょく": "تجسيد درامي, تمثيل مسرحي (تمثيل درامي) / درجمة, معالجة درامية (التحويل إلى شكل درامي (مسرحي أو تمثيلي))\nمثال: كانت المسرحية معالجة درامية لقصة قصيرة / تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما) / تنميق, زخرفة زائدة (زينة فائضة عن الحاجة) / تنميق, زخرفة (توضيح تفسير باستخدام تفاصيل زخرفية (أحياناً خيالية))\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة",
 "きゃくしん": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "きゃくじん": "طَازَج (طَازَج وَجَدِيد) / بَارِد عَلِيل, مُنْعِش ((عامّيّة اسكتلنديّة) يمنح البرودة والانتعاش) / زائر, ضيف (زائر اجتماعي أو للعمل) / متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "きゃくすじ": "زبائن, عملاء (الزبائن بشكل جماعي)\nمثال: لديهم زبائن من الطبقة العليا",
 "きゃくずき": "كَرَم, إِكْرَام / ضِيَافَة",
 "きゃくせい": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "きゃくせき": "مقعد الراكب (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / جُمْهُور, نَظَّارَة",
 "きゃくぜん": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "きゃくそう": "زبائن, عملاء (الزبائن بشكل جماعي)\nمثال: لديهم زبائن من الطبقة العليا",
 "きゃくたい": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "きゃくたいか": "تجسيم, تشييء (فعل تمثيل فكرة مجردة كشيء مادي) / تجسيد, تشخيص (تمثيل ملموس لفكرة أو مبدأ مجرد)",
 "きゃくだね": "زبائن, عملاء (الزبائن بشكل جماعي)\nمثال: لديهم زبائن من الطبقة العليا",
 "きゃくちゅう": "حاشية سفلية (ملاحظة مطبوعة توضع أسفل النص في صفحة مطبوعة)",
 "きゃくとう": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "きゃくど": "وِجْهَة, وُجْهَة",
 "きゃくねん": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "きゃくひき": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح)",
 "きゃくぶ": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
