 "しおとし": "إِغْفَال",
 "しおとす": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "しおどき": "فُرْصَة",
 "しおふき": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / قَذْف اَلْإِنَاث (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "しおぶた": "هَام (أصابه الهيام)\nمثال: الحضور هام جدا.",
 "しおみ": "مُلُوْحَة",
 "しおみず": "مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "しおめ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "しおらしい": "مُؤَدَّب / مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "しおれる": "صَعَقَ",
 "しおをかける": "مِلْح, ملح / مَلَّحَ",
 "しおをする": "مِلْح, ملح / مَلَّحَ",
 "しおをふく": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / بَخَّ, بَجَّسَ (معناه عظم الأمر وفخُم تقال عند الرضى والإعجاب بالشيء أو عند الفخر أو المدح)\nمثال: توم التقط بطل الشامبو و بخ القليل في يده",
 "しおん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "しか": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "しかい": "رَئِيس",
 "しかいし": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "しかいしゃ": "رَئِيس",
 "しかいのしし": "بَابِيرُوسَة",
 "しかいやく": "مُشْرِف",
 "しかえし": "اِنْتِقَام",
 "しかえす": "اِنْتَقَمَ",
 "しかかり": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "しかく": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / حَشَّاش\nمثال: بيتي قاتلة أمك.",
 "しかくい": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "しかくけい": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "しかくげいじゅつ": "فُنُون بَصَرِيَّة (بمعنى الضرب من الشيء والنوع؛ بمعنى بعض الصناعات الراقية التي تحتاج إلى مهارة يحكمها الذوق والمواهب)\nمثال: زيري يحب الفنون.",
 "しかくしめん": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "しかくてき": "بَصَرِيّ",
 "しかけ": "أَدَاة, جِهَاز / حِيلَة / مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم. / فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "しかけじらい": "شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "しかけにん": "مُحَرِّض, مُحَرِّضَة",
 "しかける": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / تَحَدٍّ, التَّحَدِّي / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "しかし": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "しかして": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "しかしながら": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "しかしゅう": "تَجْمِيعَة, دِيوَان",
 "しかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "しかたがない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مُزْعِج",
 "しかたない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مُزْعِج",
 "しかたのない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مُزْعِج",
 "しかっけい": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "しかつく": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "しかつめらしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "しかと": "تَجَاهَلَ, طَنَّش",
 "しかにく": "لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "しかのつの": "قَرْن الْأَيِّل (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "しかのみならず": "أَيْضًا, كَذٰلِكَ",
 "しかばね": "جُثَّة, جُثْمَان",
 "しかめっつら": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめっ面": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめつら": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめづら": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめる": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "しかめ面": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "しからば": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "しかり": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "しかりとばす": "وَبَّخَ (التأنيب بشدة)",
 "しかる": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "しかるに": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "しかるべき": "مُنَاسِب / لَائِق",
 "しかるべく": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "しかれども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "しかれば": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "しかん": "مُؤَرِّخ, مُؤَرِّخَة",
 "しかんがっこう": "أَكَادِيمِيَّةٌ عَسْكَرِيَّة",
 "しかんぜんしょう": "تسمّم الحمل",
 "しが": "شِيغَا",
 "しがい": "ضَاحِيَة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "しがいか": "تَمَدُّن, تَحَضُّر",
 "しがいせん": "اقتتال شوارع",
 "しがいでんしゃ": "تْرَام, تْرَامْوَاي",
 "しがく": "شِعْرِيّ",
 "しがくしゃ": "مُؤَرِّخ, مُؤَرِّخَة",
 "しがっか": "مُؤَرِّخ, مُؤَرِّخَة",
 "しがつ": "أَبْرِيل, نِيسَان (الشهر الرابع من السنة الميلادية الروميّة)\nمثال: أبريل شهر الرابع في السنة",
 "しがつばか": "كِذْبَةُ أَبْرِيل",
 "しがない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / فَقِير / مِسْكِين / فُقَرَاء",
 "しがみつく": "تَمَسَّكَ",
 "しがみ付く": "تَمَسَّكَ",
 "しがむ": "مَضَغَ",
 "しがらみ": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ) / غُلّ, أَغْلال",
 "しがん": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "しがんしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "しがんしょ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "しき": "رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة.",
 "しきい": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきいし": "حَجَر رَصْف (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "しきいた": "عَارِضَة",
 "しきいち": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきいをまたぐ": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "しきい値": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきうつし": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "しきかくいじょう": "عمى الألوان",
 "しきかん": "آمِر, مُقَدَّم",
 "しききん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "しきけん": "مَنْظَر, مَشْهَد",
 "しきご": "مُقَدِّمَة",
 "しきさい": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "しきしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "しきしゃ": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل / آمِر, مُقَدَّم",
 "しきじ": "مَحْو الْأُمِّيَّة",
 "しきじょう": "شَهْوَة",
 "しきじょうとうさく": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "しきそ": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "しきたり": "عَادَة, عُرْف",
 "しきち": "مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "しきつめる": "لِحَاف, بَطَّانِيَّة",
 "しきてん": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "しきど": "لَوْنِيَّة",
 "しきび": "نَخْر / اضمحل / تضعضع",
 "しきふ": "وَرَقَة, وَرَق",
 "しきぶとん": "فُوتُون, فُوتُون يَابَانِيّ",
 "しきへんけい": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "しきべつ": "تَمْيِيْز",
 "しきべつし": "مُعَرِّف",
 "しきべつしんごう": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "しきべつめい": "مُعَرِّف",
 "しきほう": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "しきぼう": "هِرَاوَة / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "しきみ": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきもう": "عمى الألوان",
 "しきもの": "سَجَّادَة, بِسَاط / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "しきゃ": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "しきゅう": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "しきゅうけい": "عُنُق اَلرَّحِم",
 "しきゅうけいぶ": "عُنُق اَلرَّحِم",
 "しきゅうないまく": "بطانَة الرحم",
 "しきゅうひん": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "しきょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しきょう": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "しきょうく": "أَبْرَشِيَّة",
 "しきょうざきょうかい": "كَاتِدْرَائِيَّة",
 "しきょうざせいどう": "كَاتِدْرَائِيَّة",
 "しきょうひん": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "しきよく": "شَهْوَة",
 "しきり": "تَقْسِيم / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "しきりと": "كَثِيرًا, غَالِبًا / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "しきりに": "كَثِيرًا, غَالِبًا / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "しきる": "تَقْسِيم / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "しきれつ": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "しきわら": "مِحَفَّة / بَعْثَرَ",
 "しきん": "ذَخِيرَة / مَوَّل",
