 "しゅうせいろん": "تَعْدِيلِيَّة",
 "しゅうせいプログラム": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع)",
 "しゅうせき": "أَرِيج",
 "しゅうせきかいろ": "دارة متكاملة (لا جمع له)",
 "しゅうせきじょ": "مَخْزَن, مُسْتَوْدَع",
 "しゅうせん": "تَحْرِير / حَرَّرَ, عَدَّلَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس.",
 "しゅうせんぎょうしゃ": "سِمْسَار, وَسِيط",
 "しゅうせんにん": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
