 "しげきぶつ": "مُنَشِّط, مُنَبِّه",
 "しげきやく": "مُنَشِّط, مُنَبِّه",
 "しげしげ": "كَثِيرًا, غَالِبًا / بثبات",
 "しげみ": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد)",
 "しげん": "مَوْرِد",
 "しこ": "أَشَارَ, أَوْمَأَ",
 "しこう": "قَصْد, إِرَادَة",
 "しこうか": "حِنَّاء (الحِنَّاءُ : نَبَات من الفصيلة الخثرية التي تتبع رتبة الآسيّات، وَرَقُهُ كورق الرُّمان وعيدانه كعيدانه، له زهر أبيضَ كالعناقيد، وَرَقُهُ أخْضَرُ…؛ خضاب أحمر يُؤخذ من ورق شجرة الحِنَّاء)\nمثال: طائر ابو الحناء هو من اشهر الطيور المغردة التي تعيش في انكلترا .",
 "しこうさくご": "التَّجْرِبَة وَالْخَطَأ",
 "しこうひん": "صَكّ غُفْرَان",
 "しこく": "شِيكُوكُو",
 "しこくいぬ": "شِيكُوكُو",
 "しこくけん": "شِيكُوكُو",
 "しこしこ": "بثبات / عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "しこしらえ": "تَحْضِير, إِعْدَاد",
 "しこたま": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "しこつ": "سُلَامَى, سُلَامِيَّة",
 "しこなす": "مِقْبَض",
 "しこみ": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / تَحْضِير, إِعْدَاد",
 "しこむ": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه) / اِكْتَسَبَ, كَسَبَ\nمثال: متى حصل الحادث؟ / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "しこり": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "しこる": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "しこん": "آنِفاً",
 "しご": "لُغَة بَائِدَة, لُغَة مَيِّتَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しごき": "ذُلّ (ذَلَّ الرَّجُلُ: ضَعُفَ، هَانَ، حَقُرَ؛ ذَلَّتِ الدَّابَّةُ: سَهُلَتْ، إِنْقَادَتْ)\nمثال: بذل زيري قصارى جهده. / تِكَّة, حِزَام (في و: هو الشُقَف)",
 "しごく": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ / اِسْتَمْنَى / مَارَسَ الْعَادَة السِّرِّيَّة (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية.",
 "しごせん": "خَطّ الطُّول (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "しごと": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "しごとぎ": "بذلة",
 "しごとし": "عَامِل, شَغِّيل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "しごとだい": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "しごとちゅう": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "しごとにん": "مُحْتَرِف, مُحْتَرِفَة",
 "しごとりつ": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "しごとをやめる": "اِسْتَقَالَ",
 "しさ": "اِقْتِرَاح, مُقْتَرَح",
 "しさい": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / اِعْتَرَاض / اِعْتِرَاض",
 "しさいに": "بِالتَّفْصِيل, تَفْصِيلًا",
 "しさく": "تَكَهُّنٌ / مُضَارَبَة",
 "しさくか": "مُفَكِّر (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "しさつ": "تَفَقُّد",
 "しさついん": "مُفَتِّش, مُفَتِّشَة",
 "しさつおん": "صَفِيرِيّ / حَرْفُ صَفِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "しさてき": "حَامِل (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة) / حَوامِلُ / حُبْلَى\nمثال: يبدو أنني حامل.",
 "しさん": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "しさんふさいひょう": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "しざい": "مِلْكِيَّة خَاصَّة",
 "しし": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "ししおう": "أَسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / لَيْث (أَسَد) / أسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / سبع (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / أسد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "ししがき": "حِظَار",
 "ししがへる": "فَقَدَ وَزْن",
 "ししがり": "صَيْد",
 "ししき": "سِفْر اَلْقُضَاة (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "ししきゅう": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ししざ": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ししつ": "طَبِيعَة, طبيعة",
 "ししついじょうしょう": "فَرْط شَحْمِيَّات الدَّم",
 "ししとして": "بِجِدّ",
 "ししふんじん": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "ししまい": "رَقَص الأَسَد (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "ししむら": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "ししゃ": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "ししゃく": "فيكونت",
 "ししゃごにゅう": "تَقْرِيب",
 "ししゃごにゅうきのう": "تَقْرِيب",
 "ししゃのしょ": "كِتَاب الْمَوْتَى (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "ししゅ": "شِعْرِيّ",
 "ししゅう": "تَطْرِيز",
 "ししゅく": "إِقَامَة",
 "ししゅつ": "صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / مَصَارِيف, تَكَالِيف\nمثال: أيمكنك صرف خمسين؟",
 "ししゅつがかり": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ししゅんき": "بُلُوغ",
 "ししょ": "أَمِين مَكْتَبَة, أَمِينَةْ مَكْتَبَة (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ししょう": "طَعْن / طَعْنَة / طَعَنَ",
 "ししょうかぶ": "تَحْت اَلْمِهَاد, وِطَاء (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "ししょうくつ": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ししょうじ": "ضَئِيل / تَصْغِيرِيّ",
 "ししょうふち": "مُتَهَوِّر",
 "ししょうをきたす": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "ししょく": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "ししょくき": "غُول",
 "ししん": "مَبْعُوث, وَزِير مُفَوَّض",
 "しし座": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "しじ": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "しじき": "مُؤَشِّر",
 "しじきをだす": "إِشَارَة",
 "しじさき": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "しじし": "مُؤَشِّر",
 "しじしゃ": "دَاعِم, مُؤَيِّد",
 "しじつ": "جِدِّيّ / جَدِّيّ, جَادّ",
 "しじばん": "لَافِتَة, لَوْحَة",
 "しじぼう": "مُؤَشِّر",
 "しじやく": "مُؤَشِّر",
 "しじゅ": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "しじゅう": "باستمرار",
 "しじゅつ": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / اِجْرَاء",
 "しじゅつしゃ": "مُمَارِس",
 "しじゅん": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "しじゅんせつ": "الصَّوْم الْأَرْبَعِينِيّ / اَلصَّوْم اَلْكَبِير",
 "しじょ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "しじょう": "يَوْمًا",
 "しじょうけいざい": "اِقْتِصَاد اَلسُّوق (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد.",
 "しじょうけん": "تَفَوُّق",
 "しじょうしゃ": "الْكَائِنُ الْأَسْمَى",
 "しじょうじゅう": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "しじょうちょうさ": "بَحْث سُوق, بَحْث السُوق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "しじん": "حَضَر (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / تَاجِر, تَاجِرَة",
 "しす": "سَاهَمَ / تَمْوِيل, مَالِيَّة / مَوَّل",
 "しすい": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "しすいき": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود.",
 "しすう": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب) / أُسّ",
 "しすうかんすうてき": "أُسِّيّ",
 "しすうてき": "أُسِّيّ",
 "しすうぶ": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "しすます": "أَدَّى",
 "しする": "سَاهَمَ / تَمْوِيل, مَالِيَّة / مَوَّل",
 "しず": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "しずい": "مِدَقَّة",
 "しずおか": "شِيزُوكَا",
 "しずか": "صَامِت, هَادِئ / بَطِيء / أَبْطَأَ, بَطَّأَ / هَادِئ / طَمْأَنَ",
 "しずかに": "بِهُدُوء",
 "しずく": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "しずけさ": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "しずけし": "صَامِت, هَادِئ",
