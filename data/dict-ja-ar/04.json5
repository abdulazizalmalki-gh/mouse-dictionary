 "くず肉": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة…)",
 "くず鉄": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "くせ": "خَلَاص, تَطْهِير اَلنَّفْس / عَادَة / تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط / مُخْطِئ\nمثال: نحن نرفض الظلم.",
 "くせごと": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه…)",
 "くせして": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "くせだま": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "くせに": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "くせのある": "غَرِيب, مُثِيرٌ لِلدَّهْشَة ((غير رسمي) غَيْرُ تَقْلِيدِيٍّ بِشَكْلٍ لَافِت)",
 "くせもの": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "くせん": "كِفَاح, نِضَال",
 "くせー": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / مُبَالِغ فِي التَّمْثِيل (مُتَكَلَّف فِي الأَدَاء الدِّرَامِيّ؛ مُبَالَغ فِيه) / أَخْرَق",
 "くせ球": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "くせ者": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "くぜつ": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود))",
 "くそ": "لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / بِرَاز, سَلْح / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / فَظِيع / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "くそあま": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "くそおとこ": "زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "くそおんな": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "くそがえる": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر.",
 "くそがき": "اِبْن كَلْب (الولد الذكر)\nمثال: هو له ابن صغير.",
 "くそく": "مِعْيَارِيّ",
 "くそじじい": "شَيْخ, عَجُوز",
 "くそたれ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "くそたわけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "くそだめ": "سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد)",
 "くそったれ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما) / اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "くそどきょう": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "くそばえ": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "くそばばあ": "عَجُوز",
 "くそぶくろ": "مَعِدَة, مِعْدَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / كيس بقايا الطعام (كيس للطعام الذي لم يأكله الزبون في المطعم ليأخذه معه)",
 "くそほど": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "くそまじめ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "くそまる": "طَرَدَ, نَفَى",
 "くそみそ": "بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "くそむし": "جَعْل الرَوْث, جِعْرَان (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "くそやろう": "اِبْن كَلْب (الولد الذكر)\nمثال: هو له ابن صغير.",
 "くそわた": "مَعِدَة, مِعْدَة",
 "くそガキ": "اِبْن كَلْب (الولد الذكر)\nمثال: هو له ابن صغير.",
 "くそスレ": "منشور تافه, منشور مسيء (منشور إنترنت ذو جودة رديئة ومثير للجدل)",
 "くそババア": "عَجُوز",
 "くそビッチ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "くそマジメ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "くそ女": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "くそ度胸": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "くそ真面目": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "くたい": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / هَيْكَل عَظْمِيّ, هَيْكَل",
 "くたかけ": "دَجَاج, لَحْم دَجَاج\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل.",
 "くたくた": "مستنفد, منهك (مفرغ من الطاقة أو القوة أو الشدة)\nمثال: مستحيل زراعة التبغ في التربة المنهكة / مُتَضَرِّر, مُعَنَّف (يُظهِر أعراضًا ناتجة عن إيذاء بدنيّ ونفسيّ مُتكرِّر)",
 "くたばりぞこない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "くたばり損ない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "くたばる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "くたびれもうけ": "هدر الجهد (جهد لا طائل منه)",
 "くたびれ儲け": "هدر الجهد (جهد لا طائل منه)",
 "くだ": "أُنْبُوبَة / بَكَرَة",
 "くだぎつね": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "くだく": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "くだくだ": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل",
 "くだくだしい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "くだくらげ": "سحاريات (مستعمرة محيطية عائمة أو سابحة من السلائل غالباً ما تكون شفافة أو زاهية الألوان)",
 "くだけ": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه / نَتِيجَة",
 "くだけた": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / غير رسمي (ليس رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "くだけなみ": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "くだける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "くだけ波": "قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "ください": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "くださる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / تفضل, خدمة (عمل يتسم باللطف والتفضل)\nمثال: كانت النتيجة في صالحه",
 "くだし": "إخْلَاء, تَخْلِيَة",
 "くだしあ": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "くだしぐすり": "مُلَيّن",
 "くだす": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى. / نَبْض\nمثال: ضرب سامي زوجته. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "くだちゃい": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "くだって": "بتواضع (بطريقة متواضعة)\nمثال: خفض رأسه بتواضع / فِيمَا بَعْد, بعدين / قَادِم\nمثال: زيري بجانب الحوض.",
 "くだつぎて": "تركيبات أنابيب, وصلة أنابيب (تجهيزة تتكون من قطع أنابيب مسننة لربط الأنابيب ببعضها)",
 "くだものとけいそう": "ثَمَرَة زَهْرَة اَلْآلَام, فَاكِهَة زَهْرَة اَلْآلَام",
 "くだものばたけ": "بُسْتَان, بَيَارَة (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان.",
 "くだものや": "بائع فاكهة, فاكهاني (شخص يبيع الفاكهة)",
 "くだものナイフ": "سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات)",
 "くだもの屋": "بائع فاكهة, فاكهاني (شخص يبيع الفاكهة)",
 "くだらない": "تافِه / غَبِيّ",
 "くだらぬ": "تافِه / غَبِيّ",
 "くだらん": "تافِه / غَبِيّ",
 "くだり": "مُتَّجِهٌ لِلْأَسْفَل (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا نُزُولًا) / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "くだりこうばい": "مَنْزَل, مُنْحَدَر هَابِط (الخاصية التي يمتلكها منحدر أو سطح ينخفض للأسفل)",
 "くだりざか": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "くだりばら": "إسهال (حركات أمعاء متكررة ومائية؛ يمكن أن تكون عرضاً لعدوى أو تسمم غذائي أو التهاب…)",
 "くだる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / اِسْتَسْلَمَ",
 "くだん": "السَّابِقُ ذِكْرُهُ / عَادِيّ",
 "くだ狐": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "くち": "فَم, بق / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بَوَّابَة / كَلَام, تَكَلُّم",
 "くちあけ": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "くちあたり": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب.",
 "くちあらく": "بِعُنْف",
 "くちあらそい": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "くちあんぐり": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "くちいれにん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "くちいれや": "وَكَالَة تَوْظِيف",
 "くちうるさい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "くちえ": "صفحة العنوان المقابلة (رسم توضيحي أمامي يواجه صفحة العنوان في كتاب)",
 "くちおかし": "مَزَّاح, هَزْلِيّ (يتّسم بالمُزاح وحُسن الدعابة)",
 "くちおしい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "くちおも": "حَرِيص, حَكِيم",
 "くちおもい": "حَرِيص, حَكِيم",
 "くちかずがおおい": "ثَرْثَار",
 "くちかずがすくない": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "くちかずのおおい": "ثَرْثَار",
 "くちかずのすくない": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "くちかせ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ)\nمثال: روى نكتة مضحكة جداً",
 "くちがうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "くちがうるさい": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "くちがおおい": "ثَرْثَار",
 "くちがおもい": "انطوائي, غير تواصلي (لا يميل إلى التحدث أو إعطاء المعلومات أو التعبير عن الآراء)",
 "くちがき": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة…)",
 "くちがきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちがさけても": "مَهْمَا",
 "くちがたい": "رزين, كتوم (يتميز بالحكمة أو التواضع وضبط النفس الحكيم)\nمثال: مساعده الكتوم الموثوق به",
 "くちがね": "قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس…)\nمثال: لقد اشترى قبعة. / إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي / مَبْسَم / مَقْبِس",
 "くちがる": "ثَرْثَار",
 "くちがわるい": "ساخر",
 "くちきき": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة…)",
 "くちきり": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "くちぎたない": "بَذِيء اللِّسَان / طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
 "くちぎれい": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "くちく": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد) / خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق…)",
 "くちくかん": "مُدَمِّر",
 "くちくせんしゃ": "مدمرة الدبابات (مركبة مدرعة مجهزة بمدفع مضاد للدبابات وقادرة على التحرك بسرعات عالية)",
 "くちぐせ": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "くちぐちに": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "くちぐるま": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "くちぐるまにのる": "اِنْخَدَعَ بِـ",
 "くちけんか": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "くちげんか": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "くちこごと": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "くちことば": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً / لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "くちごうしゃ": "بَلِيغ, طَلِيق اللِّسَان (يُعبِّر عن نفسه بسهولة ووضوح وفعاليّة)",
 "くちごたえ": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "くちごもる": "غَمْغَمَة",
 "くちさがない": "ثَرْثَار, نَمَّام (يميل إلى الدردشة غير الرسمية ونقل الأخبار والقيل والقال)",
 "くちさき": "مجاملة كاذبة, نفاق (تعبير عن الموافقة غير مدعوم بقناعة حقيقية) / شَفَة, شفة",
 "くちさきだけ": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "くちざみせん": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "くちざわり": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "くちじゃみせん": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "くちじょうず": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "くちじり": "صوار (حزمة من الألياف العصبية تمر من جانب إلى آخر من الدماغ أو الحبل الشوكي)",
 "くちじろじか": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "くちすい": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "くちすぎ": "مَعِيشَة, مَعَاش",
 "くちすすぐ": "تَمَضْمَضَ, غَرْغَرَ",
 "くちずから": "مُبَاشَرَةً",
 "くちずさむ": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "くちぞえ": "تَوْصِيَة",
 "くちたっしゃ": "فَصِيح, فُصْحَى",
 "くちだし": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق)",
 "くちだっしゃ": "فَصِيح, فُصْحَى",
 "くちつき": "فَم, بق / مَبْسَم",
 "くちづき": "فَم, بق / مَبْسَم",
 "くちづけ": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "くちづける": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "くちとり": "سَائِس / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "くちどめ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "くちどめりょう": "شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "くちなおし": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول)",
 "くちなし": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة…)",
 "くちなわ": "ثُعْبَان, حَنَش / ثُعْبَان",
 "くちにかける": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "くちにする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "くちにだす": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "くちにのぼせる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "くちにはいる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "くちにはこぶ": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "くちぬき": "بَرِّيمة",
 "くちのうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "くちのかるい": "ثَرْثَار",
 "くちのきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちのたっしゃ": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "くちのは": "نَمِيمَة, إِشَاعَة",
 "くちのわるい": "ساخر",
 "くちは": "نَمِيمَة, إِشَاعَة",
 "くちはっちょう": "ثرثار, طليق اللسان (يتميز بتدفق جاهز للكلام)\nمثال: هي شابة ثرثارة للغاية تنخرط في مناجاة النفس وليس المحادثات",
 "くちはばったい": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "くちば": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة)",
 "くちばいろ": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة)",
 "くちばし": "مِنْقَار",
 "くちばしがきいろい": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة)",
 "くちばしが黄色い": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة)",
 "くちばしをいれる": "قَاطَعَ",
 "くちばしをさしはさむ": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "くちばしをはさむ": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "くちばしを入れる": "قَاطَعَ",
 "くちばしを挟む": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "くちばみ": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "くちばや": "عميق\nمثال: صام ياني رمضان.",
 "くちひげ": "شَارِب",
 "くちひも": "خيط زم, رباط سحب (رباط يتكون من حبل يمر عبر درزة حول فتحة)\nمثال: سحب خيط الزم وأغلق الحقيبة",
 "くちび": "فَتِيل / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "くちびる": "شَفَة, شفة",
 "くちびるをとがらす": "بوّز, بَرطَمَ",
 "くちふうじ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / صَمْت, سُكُوت",
 "くちふき": "مَنْدِيل, مَنْدِيل مَائِدَة",
 "くちぶえ": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "くちぶえをふく": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "くちぶちょうほう": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちぶぶん": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "くちぶり": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "くちへんとう": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "くちべた": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "くちべに": "أَحْمَر شِفَاه (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "くちぼそ": "باراكودا, عقام",
 "くちまえ": "مِهْنَة\nمثال: ما وظيفة زوجتك؟",
 "くちまね": "مُشَاكهَة",
 "くちまめ": "ثَرْثَار",
 "くちまわし": "تَعْبِير",
 "くちもと": "فَم, بق",
 "くちもとがゆるむ": "اِبْتِسَامَة, بَسْمَة",
 "くちゃい": "مُنْتِن",
 "くちゃくちゃ": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج) / فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "くちやかましい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء) / ثَرْثَار",
 "くちゅう": "مِحْنَة",
 "くちゅうざい": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "くちゅうやく": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد الحشرات (مادة كيميائية تطرد الحشرات)",
 "くちょう": "نَغْمَة, نَغْم",
 "くちよせ": "قَنَاة",
 "くちる": "أَفْسَدَ, فَسَدَ",
 "くちわ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة)",
 "くちわけ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "くちをかける": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "くちをきく": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث. / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "くちをきる": "فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح.",
 "くちをきわめて": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "くちをそえる": "ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "くちをだす": "قَاطَعَ",
 "くちをついてでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "くちをつく": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "くちをつぐむ": "صَمَتَ",
 "くちをつける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "くちをとがらす": "بوّز, بَرطَمَ",
 "くちをとがらせる": "بوّز, بَرطَمَ",
 "くちをふうじる": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة)",
 "くちをわる": "اِعْتَرَفَ, أَقَرَّ",
 "くちコミ": "تناقل الأخبار, كلمة الفم (انتشار القيل والقال عن طريق التواصل المنطوق)\nمثال: انتشر خبر علاقتهم عن طريق التناقل الشفهي",
 "くちマネ": "مُشَاكهَة",
 "くっ": "يَع",
 "くっき": "مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة)",
 "くっきょう": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / مُمْتَاز, فَاخِر / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "くっきょく": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه…)",
 "くっきょくぶ": "كُوع, مِرْفَق",
 "くっきり": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "くっきん": "عضلة قابضة (عضلة هيكلية يثني انقباضها مفصلاً)",
 "くっく": "محل, مكان (وضع معين)\nمثال: لو كنت مكاني ماذا كنت ستفعل؟",
 "くっくっくっ": "قَرْقَرَة, مُنَاغَاة",
 "くっこうせい": "انتحاء ضوئي (استجابة توجيهية للضوء)",
 "くっさい": "تعدين",
 "くっさく": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "くっさくき": "حَفَّار",
 "くっし": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق)\nمثال: ركبنا في السيارة المتقدمة",
 "くっしん": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "くっしんせい": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "くっす": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / طَوَّعَ, تَغَلَّبَ عَلَى",
 "くっする": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / طَوَّعَ, تَغَلَّبَ عَلَى",
 "くっせい": "انتحاء",
 "くっせつ": "ثني, حني (عملية ثني شيء ما) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة) / تنغيم, عروض (أنماط الضغط والتنغيم في اللغة)",
 "くっせついじょう": "سوء الانكسار (خطأ في انكسار أشعة الضوء في العين كما في اللابؤرية أو قصر النظر)",
 "くっせつかく": "زاوية الانكسار (الزاوية بين شعاع منكسر وخط عمودي على السطح بين الوسطين عند نقطة الانكسار)",
 "くっせつけい": "مقياس الانكسار (أداة قياس لقياس معامل انكسار مادة ما)",
 "くっせつご": "لغة اندماجية (نوع من اللغات التركيبية حيث يمكن للمورفيمات الفردية أن تنقل أجزاء متعددة من…)",
 "くっせつぼうえんきょう": "تلسكوب كاسر (تلسكوب بصري يحتوي على عدسة محدبة كبيرة تنتج صورة يتم مشاهدتها من خلال العدسة…)",
 "くっせつりつ": "مُؤَشِّر الِانْكِسَار, مُعَامِل الِانْكِسَار (نسبة سرعة الضوء في الفراغ إلى سرعته في وسط ما)",
 "くっせー": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / مُبَالِغ فِي التَّمْثِيل (مُتَكَلَّف فِي الأَدَاء الدِّرَامِيّ؛ مُبَالَغ فِيه) / أَخْرَق",
 "くっそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "くったく": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / سأم, ضجر (الشعور بالملل من شيء مضجر)",
 "くったくた": "مستنفد, منهك (مفرغ من الطاقة أو القوة أو الشدة)\nمثال: مستحيل زراعة التبغ في التربة المنهكة / مُتَضَرِّر, مُعَنَّف (يُظهِر أعراضًا ناتجة عن إيذاء بدنيّ ونفسيّ مُتكرِّر)",
 "くったくない": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "くったくのない": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "くっだらない": "تافِه / غَبِيّ",
 "くっだらねえ": "تافِه / غَبِيّ",
