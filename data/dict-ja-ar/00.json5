 "あしをはこぶ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "あしをひきずる": "عَرَجَ",
 "あしをひっぱる": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال.",
 "あしをふみいれる": "أَدْخَلَ\nمثال: دخل توم المبنى.",
 "あしヒレ": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان…)",
 "あし毛": "رمادي مرقط (رمادي بنمط مرقط من علامات رمادية أغمق)",
 "あじ": "بَهَار / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن…)\nمثال: إنه وسيم و ذكي. / جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / رئيس, زعيم (قائد مجموعة من الناس)\nمثال: من أقطاب الصناعة",
 "あじあい": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)\nمثال: أثاره شعور المدينة / مَعْنًى",
 "あじあう": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "あじかげん": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "あじがする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "あじがでる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "あじきある": "مُشَوِّق, ممتع",
 "あじきき": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق. / مُتَذَوِّق",
 "あじきない": "مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "あじけない": "مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "あじさし": "خَرْشَنَة",
 "あじざけ": "مُرْتَفِع الدَّرَجَة",
 "あじたま": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا)\nمثال: قاضٍ رقيق القلب",
 "あじたまご": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا)\nمثال: قاضٍ رقيق القلب",
 "あじつけ": "بَهَار, تَابِل",
 "あじつけたまご": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا)\nمثال: قاضٍ رقيق القلب",
 "あじな": "شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن…)\nمثال: إنه وسيم و ذكي.",
 "あじのある": "مُشَوِّق, ممتع",
 "あじのもと": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "あじみ": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "あじもそっけもない": "كَلِيل",
 "あじゃじゃしたー": "شُكْرًا, تِسْلَم",
 "あじゃぱあ": "قِف, قِفِي",
 "あじゃら": "دعابة خفيفة, ملاطفة (ملاحظة مقبولة أو مسلية)\nمثال: يتبادلون الملاطفات",
 "あじゃり": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة / بَادَرَ\nمثال: اذكر كل عضو باسمه.",
 "あじゃれ": "دعابة خفيفة, ملاطفة (ملاحظة مقبولة أو مسلية)\nمثال: يتبادلون الملاطفات",
 "あじろ": "خوص, غصن الصفصاف (عمل مصنوع من أغصان رفيعة متشابكة (خاصة أغصان الصفصاف))",
 "あじわい": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)\nمثال: أثاره شعور المدينة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "あじわいしる": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "あじわいぶかい": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "あじわい深い": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "あじわう": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "あじをつける": "مَوْسِم",
 "あじをととのえる": "بَهَار",
 "あじをみる": "عَيِّنَة",
 "あじん": "دُونَ المُسْتَوَى البَشَرِيّ (غَيْرُ صَالِحٍ لِلْبَشَرِ)\nمثال: عامل السكان الأصليين كأنهم دون البشر / أرجنتيني (من أو يتعلق بالأرجنتين أو شعبها أو يميزهم)\nمثال: تانغو أرجنتيني / أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "あじフライ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あすこ": "هُنَاكَ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "あすぶ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / تَسَكَّعَ / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "あすら": "نِصْف إِلٰه",
 "あずかり": "حراسة, حفظ (مسؤولية الوصي أو الحارس)\nمثال: ترك سيارته في حفظي / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "あずかりきん": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "あずかりしょ": "غرفة المعاطف, غرفة الملابس (غرفة يمكن ترك المعاطف والأشياء الأخرى فيها مؤقتاً)",
 "あずかりじょ": "غرفة المعاطف, غرفة الملابس (غرفة يمكن ترك المعاطف والأشياء الأخرى فيها مؤقتاً)",
 "あずかる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / اِهْتَمَّ, اِعْتَنَى / اِحْتَفَظَ",
 "あずきいろ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "あずきぞうむし": "فاصولياء الأزوكي, لوبياء زاوية (نبات حولي كثيف يزرع على نطاق واسع في الصين واليابان للدقيق المصنوع من بذوره)",
 "あずきアイス": "بُوظَة, آيْس كِرِيم",
 "あずき色": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "あずけ": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "あずけいれ": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "あずけぬし": "مودع (شخص أودع مالاً في بنك أو مؤسسة مماثلة)",
 "あずける": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "あずさ": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف…)",
 "あずま": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "あずまごと": "عَرَبَة",
 "あずましい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "あずまや": "عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "あずま屋": "عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "あせ": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق. / رُطُوبَة / تجرع, عب (بلعة كبيرة وسريعة)\nمثال: أنهاه بجرعة واحدة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あせい": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "あせおさえ": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "あせしらず": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "あせする": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "あせつ": "شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل)",
 "あせどめ": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "あせび": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من…)",
 "あせぶ": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من…)",
 "あせぼ": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من…) / حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "あせも": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "あせり": "نَفَاد صَبْر",
 "あせる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / خَسَّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه…)\nمثال: بيع المنزل بثمن بخس.",
 "あせをかく": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "あせをながす": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "あせんやく": "سنط الكادي, كاث هندي (شجرة شائكة من جزر الهند الشرقية لها أوراق ريشية مزدوجة وزهور صفراء تليها قرون…)",
 "あぜ": "جسر, طريق مرتفع (طريق مرفوع فوق الماء أو المستنقعات أو الرمال)",
 "あぜん": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "あそ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あそこ": "هُنَاكَ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "あそばす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "あそび": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / مُتْعَة, لَذَّة / مُرُونة / الورقة الحرة, بطانة الغلاف (ورقة فارغة في مقدمة أو مؤخرة الكتاب)",
 "あそびあいて": "رفيق اللعب (رفيق في اللعب)",
 "あそびあるく": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "あそびがみ": "الورقة الحرة, بطانة الغلاف (ورقة فارغة في مقدمة أو مؤخرة الكتاب)",
 "あそびぎ": "زي رياضي نسائي, ملابس لعب (زي رياضي للنساء أو الأطفال؛ يتكون عادة من شورت وبلوزة) / بليزر, سترة رياضية (سترة خفيفة الوزن أحادية الصدر؛ غالباً ما تكون مخططة بألوان نادٍ أو مدرسة)",
 "あそびぐるま": "بكرة شد, بكرة وسيطة (بكرة على عمود تضغط على حزام التوجيه لتوجيهه أو شده)",
 "あそびごころ": "متعة, مرح (أنشطة ممتعة أو مسلية)\nمثال: أفعل ذلك من أجل المتعة / تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "あそびごと": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "あそびじかん": "وقت اللعب (وقت مخصص للعب أو التسلية)",
 "あそびずき": "دَاعِب, لَعُوب / باحث عن اللذة, متعي (شخص تحفزه الرغبة في الملذات الحسية)",
 "あそびたわむれる": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "あそびともだち": "رفيق اللعب (رفيق في اللعب)",
 "あそびどうぐ": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "あそびなかま": "رفيق اللعب (رفيق في اللعب)",
 "あそびにん": "مُسْتَهْتَر / مُقَامِر / عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "あそびば": "مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "あそびめ": "دَاعِرَة, بَغِيَّة",
 "あそびゴコロ": "متعة, مرح (أنشطة ممتعة أو مسلية)\nمثال: أفعل ذلك من أجل المتعة / تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "あそび女": "دَاعِرَة, بَغِيَّة",
 "あそび心": "متعة, مرح (أنشطة ممتعة أو مسلية)\nمثال: أفعل ذلك من أجل المتعة / تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "あそぶ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / تَسَكَّعَ / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "あぞく": "جنس فرعي, جنيس ((في الأحياء) مجموعة تصنيفية بين الجنس والنوع) / زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية)",
 "あた": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية))\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ",
 "あたい": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / قِيمَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あたいする": "اِسْتَحَقَّ",
 "あたいせんきん": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى)",
 "あたいりく": "شِبْه قارَة",
 "あたうかぎり": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "あたう限り": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "あたえ": "هَدِيَّة, هدية",
 "あたえたまう": "أَنْعَمَ",
 "あたえたもう": "أَنْعَمَ",
 "あたえぬし": "مُعْطٍ",
 "あたえる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تعيين شخص لعمل ما / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "あたおか": "مَجْنُون, مَخْبُول",
 "あたかも": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "あたかもよし": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "あたかも好し": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "あたくし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あたし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あたしたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "あたしゃ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あたし達": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "あたする": "ضَرَرٌ / غَزَا, اِجْتاحَ / عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به)\nمثال: جميع من حضر عارض تلك الخطة.",
 "あたたか": "دَافِئ",
 "あたたかい": "دَافِئ / مراعٍ, مهتم بالآخرين (يظهر اهتماماً بحقوق ومشاعر الآخرين)\nمثال: أصدقاء مراعون بما يكفي ليتركونا وحدنا",
 "あたたかさ": "دفاء",
 "あたたかみ": "دفاء",
 "あたたまる": "اِسْتَدْفَأَ",
 "あたためる": "دَافِئ / احتفظ بكل شيء لنسفه / جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "あたふた": "مُسْتَعْجِل",
 "あたぼう": "طَبِيعِيّ",
 "あたま": "رَئِيس, رَئِيسَة / شَعْرَة\nمثال: شعر ماريا طويل. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / قَائِد, زَعِيم",
 "あたまいい": "لَامِع, نَيِّر",
 "あたまうち": "هَضْبَة",
 "あたまおかしい": "مَجْنُون, مَخْبُول",
 "あたまかざり": "خوذة, غطاء رأس (ملابس للرأس)",
 "あたまかず": "تَعْدَاد الأَشْخَاص, عَدَد الأَفْرَاد (عدد الأشخاص في مجموعة معينة)",
 "あたまかぶ": "شَيْخ, قَائِد",
 "あたまから": "بشكل قاطع, بشكل مطلق (بطريقة غير مشروطة)\nمثال: نفى التهم بشكل قاطع / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "あたまからつまさきまで": "مِن الرَّأْس إِلَى القَدَم (في جميع النقاط من الرأس إلى القدمين)\nمثال: كان مسلحاً من رأسه إلى أخمص قدميه",
 "あたまがいい": "لَامِع, نَيِّر",
 "あたまがおかしい": "مَجْنُون, مَخْبُول",
 "あたまがかたい": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "あたまがさがる": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "あたまがひくい": "مُتَوَاضِع\nمثال: لقد أزمت الوضع.",
 "あたまがふるい": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "あたまがへん": "مَجْنُون, مَخْبُول",
 "あたまがまっしろになる": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "あたまがまわらない": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "あたまがやわらかい": "مَرِن",
 "あたまがよい": "لَامِع, نَيِّر",
 "あたまがわるい": "بَطِيء",
 "あたまきん": "دفعة أولى, عربون (دفعة جزئية تُدفع وقت الشراء؛ والباقي يُدفع لاحقاً)",
 "あたまくだし": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "あたまごし": "تَجَاهَلَ, طَنَّش",
 "あたまごなし": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "あたまじらみ": "قملة الرأس (تغزو رأس وجسم البشر)",
 "あたまだし": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين)\nمثال: أرسل تنبيهاً للمدعي العام / كُو",
 "あたまつき": "تَصْفِيفَة, تَسْرِيحَة",
 "あたまでっかち": "ثَقِيل الأَعْلَى, مُثْقَل مِنَ الأَعْلَى (غير مستقر بسبب الحمل الزائد في الجزء العلوي)",
 "あたまにいれる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "あたまにおく": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "あたまにはいる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "あたまのいい": "لَامِع, نَيِّر",
 "あたまのいたい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "あたまのおかしい": "مَجْنُون, مَخْبُول",
 "あたまのかいてん": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "あたまのかいてんがおそい": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "あたまのかいてんがはやい": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "あたまのかいてんのはやい": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "あたまのかたい": "مُتَعَنِّت, عَنِيد",
 "あたまのくろいねずみ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "あたまのくろいネズミ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "あたまのたかい": "مُتَعَالٍ, الْمُتَعَالِي",
 "あたまのたりない": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "あたまのにぶい": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "あたまのやわらかい": "مَرِن",
 "あたまのよい": "لَامِع, نَيِّر",
 "あたまのよわい": "ثقيل الظل, شخص ممل (شخص يبعث على الملل)\nمثال: إنه الاقتصاد يا غبي!",
 "あたまのわるい": "بَطِيء",
 "あたまひとつ": "رَئِيس, رَئِيسَة",
 "あたまひも": "رِبَاط",
 "あたまよい": "لَامِع, نَيِّر",
 "あたまわるい": "بَطِيء",
 "あたまをさげる": "قَوْس, قوس / اِعْتَذَرَ, اِسْتَعْذَرَ / عَجَبَ",
 "あたまをたてにふる": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة…)\nمثال: أومأ زيري بنعم.",
 "あたまをはたらかせる": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "あたら": "وَا حَسْرَتَاه, وَاهًا",
 "あたらしい": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "あたらしく": "حديثاً, طازجاً (مؤخراً جداً)\nمثال: متزوجان حديثاً",
 "あたらずさわらず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "あたり": "أَصَابَ\nمثال: تلقى مناد ضربة. / نَجَاح / خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\". / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض)\nمثال: إنه حي ودود / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / على سبيل المثال, مثلاً (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذ الثعابين الشريطية على سبيل المثال (يفيد الاستعلاء؛ يفيد التعليل)",
 "あたりいちめん": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "あたりいったい": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あたりかまわず": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "あたりき": "بُوضُوح",
 "あたりきしゃりき": "بُوضُوح",
 "あたりきょうげん": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "あたりぎ": "مِدَقَّة, يَد",
 "あたりさわらず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "あたりさわり": "عَقَبَة, حَاجِز",
 "あたりさわりのない": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "あたりはずれ": "تَرَاوُح, اِخْتِلَاف",
 "あたりばち": "مِلَاط",
 "あたりぼう": "مِدَقَّة, يَد",
 "あたりまえ": "طَبِيعِيّ / عَادِيّ",
 "あたりめえ": "طَبِيعِيّ / عَادِيّ",
 "あたりめー": "طَبِيعِيّ / عَادِيّ",
 "あたりや": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "あたりをつける": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "あたり一帯": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あたり一面": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "あたり鉢": "مِلَاط",
 "あたる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي! / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "あたん": "فحم بني / عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية))\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ",
 "あだ": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية))\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة) / جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "あだうち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "あだおろそか": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "あだざくら": "دَاعِرَة, بَغِيَّة",
 "あだする": "ضَرَرٌ / غَزَا, اِجْتاحَ / عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به)\nمثال: جميع من حضر عارض تلك الخطة.",
 "あだっきゅう": "خلع جزئي (إزاحة جزئية لمفصل أو عضو)",
 "あだっぽい": "جذاب, فاتن (يميل إلى إغراء شخص للقيام بعمل أو حالة مرغوبة)",
 "あだとなる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "あだな": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "あだなす": "اِنْتَقَمَ",
 "あだになる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "あだびと": "آخَرُون\nمثال: 彼女はもっと他人の言うことを聞くべきだ。 — ينبغي لها أن تستمع إلى آراء الآخرين أكثر.",
 "あだやおろそか": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "あだをなす": "اِنْتَقَمَ",
 "あだん": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق…)",
 "あだ名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "あだ討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "あち": "هُنَاك, هُنَالِك / لِكَيْ, أَنْ / هُنَاكَ",
 "あちぃ": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "あちい": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "あちき": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あちこち": "هُنَا وَهُنَاكَ / مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "あちさん": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / سَمِيك, غَلِيظ",
 "あちち": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "あちゃ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あちゃあ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あちゃー": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あちら": "هُنَاك, هُنَالِك / لِكَيْ, أَنْ / هُنَاكَ",
 "あちらこちら": "هُنَا وَهُنَاكَ / مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "あちらご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "あちら語": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "あぢぃ": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あぢい": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あぢー": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あっ": "آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あっか": "تدهور, تردي (عملية التغير إلى حالة أدنى)",
 "あっかい": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "あっかん": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية))\nمثال: لم يستطع إخفاء عدائه / مُشَاغِب / إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت) / عَجَّبَ",
 "あっかんじょう": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية))\nمثال: لم يستطع إخفاء عدائه",
 "あっき": "روح شريرة (روح تميل لإحداث الضرر) / زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "あっけい": "حَبْكَة",
 "あっけない": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "あっけらかん": "بلا مبالاة (بطريقة غير مبالية)\nمثال: كانت الحرب تندلع في أوروبا، لكنها خططت لقضاء عطلة بلا مبالاة / بِذُهُول, بِفَرَاغ (بطريقة فارغة وغير مستوعبة)\nمثال: حدقت فيه بذهول",
 "あっこ": "هُنَاكَ",
 "あっこう": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي) / تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "あっこん": "اِنْطِبَاع, أَثَر",
 "あっさい": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "あっさいき": "آلة تجليخ, جلاخة (أداة آلية تلمع المعدن)",
 "あっさく": "ضَغْط",
 "あっさくき": "ضاغط (جهاز ميكانيكي يضغط الغازات)",
 "あっさくくうき": "هَوَاء مَضْغُوط (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "あっさつ": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "あっさり": "بِسُهُولَة / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب)\nمثال: أخذ الأمر باستخفاف",
 "あっし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あっしゅく": "ضغط, كبس (تطبيق الضغط)\nمثال: تقلص الغاز عند التبريد / تكثيف, تكميد (فعل زيادة كثافة شيء ما)",
 "あっしゅくき": "ضاغط (جهاز ميكانيكي يضغط الغازات)",
 "あっしゅくくうき": "هَوَاء مَضْغُوط (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "あっしゅくくうききかい": "هَوَاء مَضْغُوط (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "あっしゅくせい": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل)",
 "あっしゅくぶくろ": "كيس الغبار, كيس المكنسة (كيس يتم شفط الأوساخ إليه بواسطة المكنسة الكهربائية)",
 "あっしゅくりつ": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل)",
 "あっしん": "إحساس بالضغط, ضغط (الإحساس الجسدي الناتج عن تطبيق قوة على منطقة من الجلد)\nمثال: كانت حساسية جلده للضغط والحرارة طبيعية",
 "あっしんき": "ضاغط ممدد (نظام لتحسين نسبة الإشارة إلى الضوضاء لإشارة عند جهاز إرسال أو مسجل عن طريق ضغط…)",
 "あっす": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / اِسْتَضْعَفَ, قَهَرَ",
 "あっする": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / اِسْتَضْعَفَ, قَهَرَ",
 "あっせい": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر…)\nمثال: نحن نرفض الظلم. / اِسْتِبْدَاد, ظُلْم (مصدر الفعل \"اسْتَبَدَّ\"؛ الحزم وعدم التردد في اتخاذ القرار وتنفيذه)",
 "あっせいしゃ": "ظَالِم",
