 "あかうそ": "دغناش (عصفور أوروبي شائع لونه أسود وأبيض في الغالب مع حلق وصدر أحمر)",
 "あかうま": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…) / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "あかうみがめ": "سلحفاة ضخمة الرأس (سلحفاة بحرية كبيرة آكلة للحوم؛ واسعة الانتشار في البحار المفتوحة الدافئة)",
 "あかおおかみ": "دُول ((دَوَّلَ) دالًا: كتبها. و(تدويلُ المدينة): جعل الأمر فيها لدول مختلفة)\nمثال: لبنان دولة صغيرة. / ذئب أحمر (ذئب رمادي محمر من جنوب غرب أمريكا الشمالية)",
 "あかおノスリ": "باز أحمر الذيل (نوع من الصقور الأمريكية ذات اللون البني الداكن ولها ذيل بني محمر)",
 "あかかがち": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء…)",
 "あかかびびょう": "جُلْبَة",
 "あかかわいのしし": "خَنْزِير الأَنْهار الأَحْمَر",
 "あかがい": "محار الدم (محار أحمر الدم)",
 "あかがね": "نُحَاس, نحاس (في : عنصرْ فِلزيّ قابل للطَّرْق ، يوصَف عادة بالأحمر لقرب لونه من الحمرة؛ ما…)\nمثال: هي تصهر النحاس.",
 "あかがねいろ": "نحاسي (لون بني محمر يشبه لون النحاس المصقول)",
 "あかがね色": "نحاسي (لون بني محمر يشبه لون النحاس المصقول)",
 "あかがり": "الذعر الأحمر (فترة من الخوف العام من الشيوعيين)",
 "あかがれびょう": "لفحة الإبر (مرض يصيب الصنوبريات يسبب تساقط الإبر)",
 "あかきいろ": "أصفر برتقالي, زعفراني (درجة من الأصفر مشوبة بالبرتقالي)",
 "あかぎつね": "ثعلب أحمر (الثعلب الشائع في العالم القديم؛ ذو فرو بني محمر؛ يُعتبر عادة نوعاً واحداً حول…)",
 "あかぎれ": "شَاب, رَجُل",
 "あかくろぎ": "ذَاتِيُّ التَّوَازُن (يُوازِن نفسه بنفسه)",
 "あかぐま": "دُبّ أَسْمَر",
 "あかぐろい": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "あかげざる": "مكاك ريسوسي (يعيش في جنوب آسيا؛ يُستخدم في الأبحاث الطبية)",
 "あかご": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "あかさびる": "صَدَأ",
 "あかさんご": "مرجان أحمر (شعاب مرجانية خاصة في البحر الأبيض المتوسط ذات لون وردي أو أحمر تستخدم للزينة…)",
 "あかざ": "سبانخ بري, هنري الطيب (نبات أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يجمع من البرية كبقلة)",
 "あかざとう": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "あかし": "بُرْهَان, دَلِيل / شَهَادَة\nمثال: شاهد هذا الفيلم. / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور.",
 "あかしお": "المد الأحمر (مياه البحر التي يتغير لونها بسبب أعداد كبيرة من سوطيات دينية معينة تنتج…)",
 "あかしか": "أيل أحمر (أيل شائع في المناطق المعتدلة من أوروبا وآسيا)",
 "あかしびと": "شَهَادَة\nمثال: شاهد هذا الفيلم.",
 "あかしをたてる": "بَرْهَنَ, أَثْبَتَ",
 "あかしんごう": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "あかしんぶん": "صحافة الفضائح, صحافة صفراء (الصحافة التي تنخرط في الإثارة (خاصة فيما يتعلق بالحياة الخاصة للشخصيات العامة))",
 "あかじ": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "あかじがく": "خسائر, خسائر المقامرة (شيء مفقود (خاصة المال المفقود في المقامرة))",
 "あかす": "أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد. / بَرْهَنَ, أَثْبَتَ",
 "あかすぎ": "خشب أحمر (الخشب المحمر الناعم لأي من نوعي أشجار السيكويا)\nمثال: نحن نقطع الخشب.",
 "あかすぐり": "كِشْمِش أَحْمَر",
 "あかずきん": "لَيْلَى وَٱلذِّئْب",
 "あかずの": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه) / مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "あかずみ": "خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي",
 "あかせる": "أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "あかせん": "خَطّ أَحْمَر (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "あかせんくいき": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "あかせんちたい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "あかたては": "أحمر هندي (لون بني محمر يشبه التربة الحمراء)",
 "あかたてはちょう": "فراشة الأميرال الأحمر (من المناطق المعتدلة في أوروبا وآسيا؛ لها أجنحة سوداء بعلامات حمراء وبيضاء)",
 "あかたまねぎ": "بَصَل أَحْمَر, بَصَل أَرْجُوَانِيّ",
 "あかだい": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "あかだに": "سوس عنكبوتي (سوس غازل للشبك يهاجم نباتات الحدائق وأشجار الفاكهة)",
 "あかだま": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد…) / دواء مسجل براءة اختراع (دواء محمي ببراءة اختراع ومتاح بدون وصفة طبية من الطبيب)",
 "あかちゃ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "あかちゃいろ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "あかちゃん": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "あかちゃんことば": "كلام الأطفال (الكلام النامي للطفل الصغير)",
 "あかちゃんご": "كلام الأطفال (الكلام النامي للطفل الصغير)",
 "あかっつら": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "あかっぽい": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت)",
 "あかつ": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة\nمثال: لم يصب السهم توم.",
 "あかつき": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة. / وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث…)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "あかつきおき": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "あかつち": "طين أحمر (طين ناتج احمراره عن أكسيد الحديد)",
 "あかつつがむし": "تيفوس الأجمة, مرض تسوتسوغاموشي (ينقله يرقات العث وينتشر في آسيا)",
 "あかつめくさ": "نفل المروج, نفل بنفسجي (نبات معمر قصير العمر، منتصب إلى منبطح، ذو أزهار حمراء أرجوانية إلى وردية؛ أكثر…)",
 "あかつら": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "あかづら": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "あかでんわ": "تِلِفُون عُمُومِيّ, هَاتِف عُمُومِيّ (هَاتِف)",
 "あかとき": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "あかとび": "حَدَأَة حَمْرَاء",
 "あかとんぼ": "حيوان سريع الحركة, وثّاب (شخص أو حيوان يتحرك بشكل مفاجئ وسريع)\nمثال: السناجب حيوانات وثابة",
 "あかなす": "طَمَاطِم",
 "あかに": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "あかにく": "لحم أحمر (لحم لونه داكن قبل الطهي (مثل لحم البقر، الغزال، الضأن)) / لحم داكن (لحم أرجل الطيور المستخدم كطعام)",
 "あかぬ": "غَيْرُ مُتْعَب, لَا يَكِلّ (ذو طاقة غير منقوصة؛ لم يُصِبْهُ تعب)",
 "あかぬけ": "تَكْرِير",
 "あかね": "فُوَّة صَبْغِيَّة",
 "あかねいろ": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "あかねんど": "طين أحمر (طين ناتج احمراره عن أكسيد الحديد)",
 "あかね色": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "あかはた": "راية حمراء, نذير خطر (شيء يثير الغضب أو يتطلب إجراءً فوريًا)\nمثال: القيام بذلك يشبه التلويح بخرقة حمراء أمام ثور",
 "あかはたじけん": "راية حمراء, نذير خطر (شيء يثير الغضب أو يتطلب إجراءً فوريًا)\nمثال: القيام بذلك يشبه التلويح بخرقة حمراء أمام ثور",
 "あかはだ": "انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون…)\nمثال: عراء المنظر الطبيعي",
 "あかはだか": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "あかはら": "زُحَار",
 "あかばな": "سنفية, عشب الصفصاف",
 "あかばなるりはこべ": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "あかひげ": "غَرْبِيّ",
 "あかふじ": "جَبَل فُوجِي, فُوجِي (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "あかふだ": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "あかぶどうしゅ": "نَبِيذ أَحْمَر, خَمْر أَحْمَر (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها…)\nمثال: أنا شربت النبيذ.",
 "あかへん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "あかべ": "تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)",
 "あかほん": "رواية تجارية, رواية رخيصة (رواية ورقية ميلودرامية رخيصة الثمن) / كتاب قصص (كتاب يحتوي على مجموعة من القصص (عادة للأطفال))",
 "あかぼう": "حَمَّال",
 "あかぼうくじら": "حوت منقاري (أي من الحيتان العديدة التي تعيش في جميع المحيطات ولها فكوك تشبه المنقار مع…)",
 "あかぼうふら": "دودة الدم (دودة بحرية مقسمة بجسم أحمر زاهي؛ تستخدم غالباً كطعم)",
 "あかぼん": "رواية تجارية, رواية رخيصة (رواية ورقية ميلودرامية رخيصة الثمن) / كتاب قصص (كتاب يحتوي على مجموعة من القصص (عادة للأطفال))",
 "あかまつ": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "あかまんぼう": "أوبا, سمكة القمر (سمكة كبيرة بيضاوية الشكل زاهية الألوان تعيش في أعماق المحيط الأطلسي والهادئ…)",
 "あかみ": "خشب القلب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب. / احمرار (خاصية الميل للاحمرار إلى حد ما)\nمثال: احتضن احمرار المارسالا واقرنه بالأخضر والذهبي لتغليف الهدايا أو البطاقات",
 "あかみがかった": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت)",
 "あかみそ": "بُنِّيّ (بلون مشابه للخشب أو التراب)",
 "あかみにく": "لحم أحمر (لحم لونه داكن قبل الطهي (مثل لحم البقر، الغزال، الضأن))",
 "あかむ": "اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "あかむけ": "سَحَج (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ)",
 "あかむし": "دودة الدم (دودة بحرية مقسمة بجسم أحمر زاهي؛ تستخدم غالباً كطعم) / بق الحصاد, سوس الحصاد (يرقة سوس تمتص دم الفقاريات بما في ذلك البشر مسببة تهيجاً شديداً)",
 "あかむま": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…) / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "あかむらさき": "أحمر أرجواني (أحمر مع مسحة من الأرجواني)",
 "あかめ": "بربوني, سلطان إبراهيم (أسماك استوائية زاهية الألوان ذات زوائد استشعارية في الذقن) / تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)",
 "あかめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "あかやまあり": "نملة دموية (نملة مستعبدة واسعة الانتشار في نصف الكرة الشمالي)",
 "あからさま": "بَسِيط\nمثال: هذا الشعور سهل.",
 "あからむ": "اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "あからめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "あからんだ": "أَحْمَر الوَجْه, مُحْمَرّ (ذو بَشَرَة حَمْراء مُشْرِقَة تَدُلّ عَلى صِحَّة جَيِّدَة)",
 "あかり": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / بُرْهَان, دَلِيل",
 "あかりとり": "فتحة سقف, منور (نافذة في السقف للسماح بدخول ضوء النهار)",
 "あかりまど": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه)",
 "あかるい": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / لَامِع, نَيِّر / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / عَارِف\nمثال: هو عالم أحيائي.",
 "あかるさ": "سُطُوع",
 "あかるみ": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / مَفْتُوح\nمثال: فتح الباب آليا.",
 "あかん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عَجَزَ, لَا يَسْتَطِيع",
 "あかんたれ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "あかんぼ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "あかんぼう": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "あかキャベツ": "ملفوف أحمر (رأس مدمج من الأوراق الحمراء الأرجوانية)",
 "あかゲット": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "あかスグリ": "كِشْمِش أَحْمَر",
 "あかチン": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "あかブドウしゅ": "نَبِيذ أَحْمَر, خَمْر أَحْمَر (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها…)\nمثال: أنا شربت النبيذ.",
 "あかランプ": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "あかワイン": "نَبِيذ أَحْمَر, خَمْر أَحْمَر (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها…)\nمثال: أنا شربت النبيذ.",
 "あかーん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عَجَزَ, لَا يَسْتَطِيع",
 "あか抜け": "تَكْرِير",
 "あがき": "مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "あがく": "كِفَاح, نِضَال\nمثال: 窮地から足掻き出る。 — سوف يتهرب من المأزق. / كِفَاح, نِضَال",
 "あがた": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو…) / رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "あがっ": "أَحّ, حِلْيَة",
 "あがったり": "محكوم, مَحْكُوم (خاضِع إِدَارَةحُكُوْمَة؛ الَّذي صَدَرَحُكْمٌ بحقِّه)",
 "あがない": "كَفَّارَة",
 "あがなう": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "あがまう": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام)\nمثال: تعامل معها باحترام.",
 "あがみ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / نَفْسِي",
 "あがめたてる": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام)\nمثال: تعامل معها باحترام.",
 "あがめる": "وَقَّرَ",
 "あがり": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / إتمام, إكمال (إجراء ختامي أو نهائي) / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / انتصار, فوز (النجاح بعد صعوبة كبيرة)\nمثال: الفوز ليس كل شيء",
 "あがりくち": "دُخُول",
 "あがりぐち": "دُخُول",
 "あがりこむ": "أَدْخَلَ\nمثال: دخل توم المبنى.",
 "あがりさがり": "تَذَبذُب, تَقَلُّب",
 "あがりしょう": "الرهاب الاجتماعي (أي رهاب (بخلاف رهاب الخلاء) يرتبط بمواقف تكون فيها عرضة لانتقاد الآخرين (مثل…)",
 "あがりだか": "إِيرَاد",
 "あがりだん": "بَيْتُ الدَّرَج, دَرَج (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "あがりはな": "دُخُول",
 "あがりば": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع) / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "あがりばな": "دُخُول / شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "あがりもの": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "あがり症": "الرهاب الاجتماعي (أي رهاب (بخلاف رهاب الخلاء) يرتبط بمواقف تكون فيها عرضة لانتقاد الآخرين (مثل…)",
 "あがり花": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "あがる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / أَدْخَلَ\nمثال: دخل توم المبنى. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا. / حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "あき": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن. / فَرَاغ, مَكَان\nمثال: الفضاء مليئ بالغموض. / شَاغِر, وَظِيفَة شَاغِرَة\nمثال: الأب في الغرفة. / رَاحَة, خُلُو مِنَ الْعَمَل / إهمال, عدم استخدام (حالة الشيء الذي لم يستخدم وتم إهماله)\nمثال: كان المنزل في حالة إهمال رهيبة / إرهاق, إعياء (فقدان مؤقت للقوة والطاقة ناتج عن عمل بدني أو عقلي شاق)\nمثال: أدخل المستشفى بسبب الإعياء الشديد",
 "あきあじ": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا)",
 "あきうど": "تَاجِر, تَاجِرَة",
 "あきかぜがたつ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "あきかぜがふく": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "あきぐみ": "زَيْزَفُون",
 "あきさ": "بلقشة (بط غواص كبير آكل للأسماك ذو عرف ومنقار نحيل معقوف بحواف مسننة)",
 "あきしつ": "شَاغِر, وَظِيفَة شَاغِرَة\nمثال: الأب في الغرفة.",
 "あきじかん": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "あきじょうきょう": "تَوَفُّر",
 "あきす": "سَطْو\nمثال: 空巣にやられた。 — سُرق منزلنا عندما كنا مسافرين.",
 "あきすねらい": "سَطْو",
 "あきすひがい": "سَطْو",
 "あきずしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "あきた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "あきたらない": "غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "あきたらんが": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "あきたりない": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "あきっぽい": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "あきつ": "يَعْسُوب",
 "あきつかみ": "قَيْصَر, إِمْبْرَاطُور",
 "あきつしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "あきつみかみ": "قَيْصَر, إِمْبْرَاطُور",
 "あきづしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "あきない": "تِجَارَة / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أصيب برضوض شديدة بسبب انقلاب زلاجته بسرعة عالية / شَرِكَة\nمثال: المهم هو العمل.",
 "あきないもの": "سلعة تجارية (سلعة معروضة للبيع)",
 "あきないや": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها)\nمثال: ذهب إلى الدكان.",
 "あきなう": "بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى)\nمثال: باع زيري منزله.",
 "あきなし": "شَرِكَة\nمثال: المهم هو العمل.",
 "あきにれ": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات)",
 "あきのきりんそう": "عصا الذهب, قضيب الذهب (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "あきのくれ": "النِهاية",
 "あきののげし": "خس هندي, مونتيا (نبات من جنس مونتيا له أوراق صالحة للأكل ذات مذاق لطيف)",
 "あきはぎ": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في…)",
 "あきびと": "تَاجِر, تَاجِرَة",
 "あきべや": "شَاغِر, وَظِيفَة شَاغِرَة\nمثال: الأب في الغرفة.",
 "あきま": "شَاغِر, وَظِيفَة شَاغِرَة\nمثال: الأب في الغرفة. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية",
 "あきません": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عَجَزَ, لَا يَسْتَطِيع",
 "あきまへん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عَجَزَ, لَا يَسْتَطِيع",
 "あきめくら": "كُمْنَة",
 "あきもせず": "بِإِصْرَار (مع الإصرار)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار",
 "あきやすい": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "あきゅうせい": "تَحْت حَادّ, شِبْه حَادّ (أقلّ حِدّة من الحادّ؛ يتعلّق بمرض موجود لدى شخص بلا أعراض ظاهرة)",
 "あきゅうせいこうかせいぜんのうえん": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال…)",
 "あきゅうど": "تَاجِر, تَاجِرَة",
 "あきょう": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "あきらか": "شَفَّاف / لَامِع, نَيِّر",
 "あきらかにする": "اِسْتَجْلَى",
 "あきらさま": "بَسِيط\nمثال: هذا الشعور سهل.",
 "あきらめ": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "あきらめがつく": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "あきらめつく": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "あきらめる": "تَنَازَلَ / اِسْتَجْلَى",
 "あきらめモード": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "あきれわらい": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "あきれ笑い": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "あきんど": "تَاجِر, تَاجِرَة",
 "あぎ": "حلتيت (راتنج صمغي بني لنباتات مختلفة؛ له طعم ورائحة قوية)",
 "あぎと": "ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل…) / خَيْشُوم, نَخْشُوش",
 "あぎゃん": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)",
 "あく": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / مَفْتُوح\nمثال: فتح الباب آليا.",
