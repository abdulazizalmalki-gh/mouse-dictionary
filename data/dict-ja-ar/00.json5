 "あんど": "رَاحَة, تَخْفِيف",
 "あんな": "هَٰكَذَا, كَذَا",
 "あんなあ": "يَاه, اسمع",
 "あんない": "إِرْشَاد, هِدَايَة / مَعْلُومَات, مَعْلُومَة / إِعْلَان, بَلَاغ / دَعْوَة, عزيمة",
 "あんないがかり": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "あんないき": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "あんないこうこく": "إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)",
 "あんないしゃ": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "あんないしょ": "دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "あんないじょ": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "あんないじょう": "مرشدة (مرشدة أنثى)",
 "あんないにん": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "あんないやく": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "あんないカウンター": "مَكْتَبُ الاِسْتِعْلَامَات, مَكْتَبُ الْمَعْلُومَات (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "あんなに": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "あんなふうに": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "あんなー": "يَاه, اسمع",
 "あんな風に": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "あんに": "ضمناً (بدون التعبير عن ذلك بوضوح)\nمثال: يفترض ضمناً أنك تعرف الإجابة",
 "あんね": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "あんねい": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
