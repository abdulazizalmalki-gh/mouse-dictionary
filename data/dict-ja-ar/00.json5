 "いがめる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / مُرْتَشٍ, فَاسِد",
 "いがらい": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة)",
 "いがらっぽい": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة)",
 "いき": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / أَنِيق / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي. / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً / بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية! / نَفَس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / سِلْمِيّ / بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من…)\nمثال: السحابة هي كتلة بخار في السماء. / هِجْرَان, هُجْرَان / مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / عَتَبَة\nمثال: هذه بداية جيدة. / تَنَازُل, وَثِيقَةُ تَنَازُل / هِجْرَان, هُجْرَان",
 "いきあし": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "いきあたりばったり": "عَشْوَائِيّ",
 "いきあたる": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "いきいき": "بِشَكْل حَيّ, بِوُضُوح (بطريقة حية)\nمثال: وصف مغامراته بشكل حي",
 "いきうつし": "صُورَة طِبْق الأَصْل, نُسْخَة مُطَابِقَة (صورة مماثلة تماماً أو نظير مطابق)",
 "いきおい": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة)\nمثال: الدفعة المفاجئة أسقطته أرضاً / بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "いきおいよく": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "いきか": "دُونَ العَتَبَةِ الوَاعِيَة (تَحْتَ عَتَبَةِ الإِدْرَاكِ الوَاعِي)",
 "いきかい": "مُرُور",
 "いきかえる": "أَحْيَا",
 "いきかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "いきがい": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "いきがいい": "طَازَج, طَازَة / دَجِر",
 "いきがかり": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "いきがきれる": "اِنْهَار\nمثال: يوشك الجسر على الانهيار. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "いきがた": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "いきがつまる": "اِخْتَنَقَ\nمثال: خنق زيري وليد بعمامته.",
 "いきがととのう": "أَهْدَأَ, هَدَّأَ",
 "いきがながい": "دَائِم, طَوِيل الأَمَد (مَوْجود مُنْذُ فَتْرَة طَويلَة وَيَسْتَمِرّ)\nمثال: سكرتير دائم للرئيس / إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "いきがはずむ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきがよい": "طَازَج, طَازَة / دَجِر",
 "いきき": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "いきぎれ": "ضيق التنفس, قصر النفس (حالة من عسر التنفس)",
 "いきぐみ": "تأهب, حماس (استعداد فوري)\nمثال: استعداد لمواصلة المناقشات",
 "いきぐるしい": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم / طُغْيَانِيّ, قَمْعِيّ (يَتَّسِم بِقَسْوَة ظَالِمَة أَوْ سُلُوك تَعَسُّفِيّ)",
 "いきけんこう": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "いきごみ": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة)\nمثال: تحدث بحماسة كبيرة",
 "いきさかん": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "いきさき": "وِجْهَة, وُجْهَة / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / مُسْتَقْبَل",
 "いきざい": "هِجْرَان, هُجْرَان",
 "いきざま": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "いきしな": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "いきしょうちん": "اعتلال المزاج, انقباض (حالة من الاكتئاب الخفيف)",
 "いきしょうてん": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "いきじ": "عزة نفس, كرامة (صفة الجدارة بالتقدير أو الاحترام)\nمثال: كان من دون كرامته أن يغش",
 "いきじごく": "جحيم, عذاب (أي مكان يسوده الألم والاضطراب)\nمثال: جحيم المعركة",
 "いきすじ": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة) / عَلَاقَة غَرَامِيَّة",
 "いきすだま": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى))\nمثال: بدا وكأنه رأى شبحاً",
 "いきずたま": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى))\nمثال: بدا وكأنه رأى شبحاً",
 "いきずり": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار / ذٰلِكَ / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "いきせき": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきせききる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "いきそそう": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "いきた": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "いきたえる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "いきたかせき": "حفرية حية",
 "いきち": "شريان الحياة, عصب الحياة (قوة أساسية أو مانحة للحياة)\nمثال: الماء هو شريان الحياة في الهند / عَتَبَة\nمثال: هذه بداية جيدة.",
 "いきちか": "دُونَ العَتَبَةِ الوَاعِيَة (تَحْتَ عَتَبَةِ الإِدْرَاكِ الوَاعِي)",
 "いきちがい": "خلاف, صراع (خلاف أو جدال حول أمر مهم)\nمثال: كان لديه نزاع مع زوجته",
 "いきちがいになる": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "いきちがう": "صَلِيب\nمثال: عبر جرذ الطريق. / تَصَادُم",
 "いきつぎ": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة…)",
 "いきつく": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "いきつけ": "عَادِيّ",
 "いきつける": "مُتَكَرِّر",
 "いきつづける": "نَجَا",
 "いきづかい": "تَنَفُس, نَفَس",
 "いきづく": "تَنَفَّسَ / حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "いきづくり": "أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة)",
 "いきづまり": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات / خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "いきているかせき": "حفرية حية",
 "いきとうごう": "انسجم, تفاهم (التمتع بعلاقات طيبة وسلسة مع الآخرين)\nمثال: أنا ورئيسي نتفاهم بشكل جيد للغاية",
 "いきどおり": "مرارة",
 "いきどおろしい": "مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "いきどころ": "وِجْهَة, وُجْهَة",
 "いきどまり": "طَرِيق مَسْدُود, طَرِيق غَيْر نَافِذ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "いきながらえる": "نَجَا",
 "いきなり": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة",
 "いきぬき": "اِسْتِرْخَاءْ / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "いきぬく": "نَجَا",
 "いきのいい": "طَازَج, طَازَة / دَجِر",
 "いきのお": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "いきのこり": "بقاء (شيء ينجو ويبقى) / ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "いきのこる": "نَجَا",
 "いきのした": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきのながい": "دَائِم, طَوِيل الأَمَد (مَوْجود مُنْذُ فَتْرَة طَويلَة وَيَسْتَمِرّ)\nمثال: سكرتير دائم للرئيس / إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "いきのね": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "いきのねをとめる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "いきのびる": "نَجَا",
 "いきのよい": "طَازَج, طَازَة / دَجِر",
 "いきば": "وِجْهَة, وُجْهَة",
 "いきばる": "سُلَالَة",
 "いきまく": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "いきみ": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "いきむ": "سُلَالَة",
 "いきもたえだえ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきもの": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما)",
 "いきやすめ": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "いきょ": "اِسْتِنَاد / دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر…)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "いきょう": "وَثَنِيَّة / بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم. / منظار المعدة (نوع من المناظير لفحص المعدة بصرياً) / تَهْدِيد",
 "いきょうじん": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "いきょうと": "وَثَنِيّ",
 "いきょく": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "いきょくこう": "كالامين, هيميمورفيت (معدن أبيض؛ خام شائع للزنك)",
 "いきよい": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة)\nمثال: الدفعة المفاجئة أسقطته أرضاً / بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "いきよいよく": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "いきようよう": "ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر)",
 "いきりょう": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى))\nمثال: بدا وكأنه رأى شبحاً",
 "いきる": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي. / اِرْتَزَقَ / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "いきるみち": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "いきれ": "تَبَخُّر, ضَبَابِيَّة (تغيم ناتج عن ضباب أو بخار)",
 "いきわたる": "مُبَعْثَر, مُنْتَشِر (مُمْتَدٌّ عَلَى مِسَاحَةٍ وَاسِعَةٍ؛ غَيْرُ مُتَمَرْكِزٍ فِي مَكَانٍ وَاحِدٍ)",
 "いきをきらす": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきをきらせる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきをきる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきをする": "تَنَفَّسَ",
 "いきをのむ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきをのむほど": "خَاطِف لِلأَنْفَاس, مُذْهِل (يميل إلى وقف التنفس الطبيعي من شدة الإثارة)",
 "いきをのむよう": "خَاطِف لِلأَنْفَاس, مُذْهِل (يميل إلى وقف التنفس الطبيعي من شدة الإثارة)",
 "いきをはく": "زَفَرَ (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو…)",
 "いきをはずませる": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "いきをひきとる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "いき値": "عَتَبَة\nمثال: هذه بداية جيدة.",
 "いぎ": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة…)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / مَعْنًى / اِعْتَرَاض / المتوازي, قضيبان متوازيان (جهاز جمباز يتكون من قضيبين خشبيين متوازيين مثبتين على قوائم)",
 "いぎたない": "شعث, غير مرتب (غير نظيف وغير منظم)\nمثال: مهملة وغير مرتبة في عاداتها الشخصية",
 "いぎのもうしたて": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ:…)\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "いぎぶかい": "هَامّ (أصابه الهيام)\nمثال: الحضور هام جدا.",
 "いぎもうしたて": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "いぎょう": "رَائِع / ممارسة الطب (مزاولة مهنة الطب)",
 "いく": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء))\nمثال: خشية الله / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / كَم / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / جَدْوَل / حَيَوِيّ / حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "いくいく": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "いくえい": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "いくえいしきん": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "いくえにも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "いくか": "كَم",
 "いくきゅう": "إجَازَة أُمُومَة",
 "いくさ": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / قُوَّات, عَسْكَرِيَّة",
 "いくさおとめ": "فَالْكِيرِي",
 "いくさがみ": "إله الحرب (إله يُعبد بصفته مانحاً للنصر في الحرب)",
 "いくさき": "وِجْهَة, وُجْهَة / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / مُسْتَقْبَل",
 "いくさきざき": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "いくさだいしょう": "آمِر, مُقَدَّم",
