 "いけいけ": "ابتهاج, زهو (شعور بالفرح والفخر) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط)",
 "いけいこうはい": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو…)",
 "いけいざい": "جُنْحَة",
 "いけいせい": "خلل التنسج (نمو غير طبيعي (للأعضاء أو الخلايا) أو هيكل غير طبيعي ناتج عن هذا النمو)",
 "いけいせつごう": "متغاير الزيجوت, متغاير اللواقح (وجود أليلات غير متشابهة في المواقع الكروموسومية المقابلة)\nمثال: متغاير الزيجوت للون العين",
 "いけいせつごうたい": "متباين اللاقحة, متغاير الزيجوت ((علم الوراثة) كائن حي يمتلك أليلين مختلفين لجين معين مما يؤدي إلى ذرية متنوعة)",
 "いけいたい": "ألومورف, بديل صرفي (تمثيل صوتي متغير لمورفيم ما)\nمثال: كربونات الكالسيوم توجد في الأشكال المغايرة كالكالسيت والأراجونيت",
 "いけいはいぐうし": "مشيج متباين (أحد زوجين من الأمشاج غير المتشابهة خاصة في الحجم)",
 "いけおじ": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "いけがき": "وَشِيع, سِيَاج نَبَاتِيّ",
 "いけこむ": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "いけさま": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "いけしゃあしゃ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "いけしゃあしゃあ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "いけす": "حَوْض سَمَك (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "いけすかない": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة)\nمثال: في مزاج سيء",
 "いけず": "بِلَا شَفَقَة, قَاسِي القَلْب (يفتقر إلى المشاعر الإنسانية واللطف)\nمثال: ملاحظة طائشة وقاسية",
 "いけずうずうしい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "いけぞんざい": "فَظّ",
 "いけてる": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "いけない": "سَيِّئ, وحش / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "いけにえ": "تَضْحِيَة, قُرْبَان / ضَحِيَّة",
 "いけばな": "إِيكِيبَانَا",
 "いけません": "مُخْطِئ\nمثال: نحن نرفض الظلم. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "いけめん": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "いける": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي. / دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته. / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات…)\nمثال: عدن إلى المصرف.",
 "いけるくち": "شَارِب",
 "いける口": "شَارِب",
 "いけん": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف…)\nمثال: هو متعطش للسلطة. / رَأْي, نَظَر / تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة) / اِعْتَرَاض / تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة) / عَدَم دُسْتُورِيَّة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / سَيِّئ, وحش / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "いけんこうかん": "عَصَف ذِهْنِيّ, قَدَح ذِهْنِيّ",
 "いけんしょ": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: (…)\nمثال: لا جدال في ذلك.",
 "いけんせい": "عَدَم دُسْتُورِيَّة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "いけんをのべる": "رَأَى, ظَنَّ (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "いけ図々しい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "いけ図図しい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "いけ好かない": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة)\nمثال: في مزاج سيء",
 "いけ様": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "いけ込む": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "いけ面": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "いげ": "تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة. / تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ)\nمثال: و بعد قليل أتى.",
 "いげた": "شُبَّاك",
 "いげん": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة…)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان. / إرَادَة",
 "いげんせい": "عِلَاجِيُّ المَنْشَأ (ناتج عن كلام الطبيب أو علاجه؛ يُستخدم خاصّة لمضاعفات العلاج)",
 "いげんのある": "رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر)\nمثال: سلوكها الوقور",
 "いこ": "يَتِيم / ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر…)\nمثال: نحن نرفض الظلم.",
 "いこい": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "いこう": "مُنْذُ / قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة. / تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / تغيير المقام, نقل موسيقي ((موسيقى) العزف بمقام مختلف عن المقام المقصود؛ تحريك طبقة الصوت لمقطوعة موسيقية…)\nمثال: كتب كتابًا دراسيًا عن التأثيرات الكهربائية لتبادل المواقع / جُثَّة, جُثْمَان (جسد إنسان ميت)\nمثال: كانت الجثة مخصصة للتشريح / رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة. / قَصْد, إِرَادَة",
 "いこうせい": "قَابِلِيَّة الحَمْل (صفة كون الشيء خفيفاً بما يكفي لحمله) / انتقالي (من أو يتعلق بالانتقال أو يتميز به)\nمثال: المراهقة هي مرحلة انتقالية بين الطفولة والبلوغ",
 "いこうちょうさ": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "いこうどうおん": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "いこく": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "いこくしゅみ": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "いこくじょうしょ": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "いこくじょうちょ": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "いこくじょうちょう": "غَرَائِبِيَّة (صفة كون الشيء غريباً ومثيراً)\nمثال: أحب غرائبية مصر",
 "いこくじん": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "いこくのひと": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "いこじ": "مُتَعَنِّت, عَنِيد",
 "いこつ": "رَمَاد, سَكَن / جُثَّة, جُثْمَان (جسد إنسان ميت)\nمثال: كانت الجثة مخصصة للتشريح",
 "いこみ": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد)",
 "いこみき": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "いこん": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "いご": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى / إِيطَالِيّ / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "いごこちいい": "مُرِيح, وَثِير",
 "いごこちがいい": "مُرِيح, وَثِير",
 "いごこちがよい": "مُرِيح, وَثِير",
 "いごこちのいい": "مُرِيح, وَثِير",
 "いごこちのよい": "مُرِيح, وَثِير",
 "いごこちよい": "مُرِيح, وَثِير",
 "いごっそう": "قَوِيُّ الإِرَادَة (يَتَّسِمُ بِاسْتِقْلَالِيَّةٍ قَوِيَّةٍ فِي الفِكْرِ وَالحُكْم)",
 "いごん": "إرَادَة",
 "いごんしっこうしゃ": "مُنْجِز, مُنَفِّذ\nمثال: مات من دون أن يترك وصية.",
 "いごんしょ": "إرَادَة",
 "いごんしんたく": "ائتمان وصائي (ائتمان ينشأ بموجب وصية ويصبح نشطاً بعد وفاة المانح)",
 "いさ": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "いさい": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / كُلّ شَيْء / بروز, وضوح (وضوح عالٍ) / عَبْقَرِيّ, نَابِغَة",
 "いさいしょうち": "مَفْهُوم",
 "いさお": "إِنْجَاز",
 "いさおし": "إِنْجَاز / شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح. / فَاضِل, جَدِير",
 "いさかい": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "いさかう": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "いさぎよい": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان)\nمثال: لطيف حتى مع الزوار غير المتوقعين / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم. / سَلِيم, غَيْرُ فَاسِد (لَمْ يَتَحَلَّلْ أَوْ يَتَعَفَّن)",
 "いさぎよし": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "いさく": "فشل المحصول (فشل المحاصيل في إنتاج فائض قابل للتسويق)",
 "いさご": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل.",
 "いささ": "صَغِير, صغير",
 "いささか": "قَلِيلًا",
 "いさな": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / قَلَى",
 "いさなとり": "صَيْد اَلْحِيتَان",
 "いさば": "سَمَّاك, بَائِع سَمَك",
 "いさましい": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / تحريك, تقليب (تحريك سائل باستخدام أداة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة",
