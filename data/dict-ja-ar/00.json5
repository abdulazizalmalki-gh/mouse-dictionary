 "あっと言う間": "لَحْظَة",
 "あっと言う間に": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "あっと言わせる": "فَاجَأَ, بَاغَثَ",
 "あっぱい": "إقْصَاء, اِسْتِثْنَاء",
 "あっぱく": "ضَغْط / ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر…)\nمثال: نحن نرفض الظلم.",
 "あっぱくせい": "ضغط, كبس (تطبيق الضغط)\nمثال: تقلص الغاز عند التبريد",
 "あっぱっぱ": "فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض)",
 "あっぱらぱあ": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "あっぱらぱー": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "あっぱれ": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين)",
 "あっぶねー": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي))\nمثال: مستقبل غير مؤكد / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "あっぷ": "حَمّل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "あっぷあっぷ": "مُعَانَاة",
 "あっぷく": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "あっぽ": "بِرَاز, سَلْح",
 "あっ砕": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "あつ": "سَمَاكَة / ضَغْط",
 "あつあつ": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سَمِيك, غَلِيظ",
 "あつい": "سَمِيك, غَلِيظ / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / جِدِّيّ / وافِر, وَفِير / حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ / حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُتَحَمِّس, حَمَاسِيّ / شَدِيد",
 "あついせんそう": "حَرْب سَاخِنَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "あついた": "عَارِضَة / طبق فولاذي (طبق من الفولاذ)",
 "あつえん": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات)\nمثال: اتُهم بسلب السكارى في الحديقة",
 "あつえんこうじょう": "مطحنة درفلة (مصنع صلب يتم فيه دحرجة المعدن إلى صفائح وقضبان)",
 "あつかい": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري. / تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية)\nمثال: التعامل مع السجناء",
 "あつかいやすい": "طيع, قابل للإدارة (يمكن إدارته أو التحكم فيه)",
 "あつかう": "عَالَجَ / مِقْبَض / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى)\nمثال: باع زيري منزله.",
 "あつかましい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "あつかわ": "صفاقة, وقاحة (سلوك يتسم بتحدٍ جريء للأعراف وافتقار للحياء)",
 "あつがみ": "كَرْتُون, وَرَق مُقَوَّى",
 "あつくるしい": "حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين)",
 "あつぐち": "سَمِيك, غَلِيظ",
 "あつけ": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "あつさ": "سَمَاكَة / حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد.",
 "あつさあたり": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "あつじょう": "طَبَقَة",
 "あつで": "سَمِيك, غَلِيظ",
 "あつでん": "بيزوكهريائي, كهروضغطي (يتعلق بالكهرباء الضغطية أو يتضمنها)\nمثال: صفائح كهروضغطية",
 "あつでんき": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)…)",
 "あつでんこうか": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)…)",
 "あつにゅう": "تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية)",
 "あつぬり": "إمباستو, تلوين سميك (رسم يطبق فيه الصبغ بكثافة بحيث تكون علامات الفرشاة أو سكين الرسم مرئية)",
 "あつばん": "أسطوانة الآلة الكاتبة, سطوانة (الأسطوانة الدوارة في الآلة الكاتبة التي تضرب عليها المفاتيح)",
 "あつぼったい": "ثَقِيل",
 "あつまり": "جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع",
 "あつまる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "あつみ": "سَمَاكَة / عمق, عمق فكري (العمق الفكري، المعرفة النافذة، البصيرة الثاقبة، إلخ)\nمثال: عمق شعوري",
 "あつみつ": "تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين",
 "あつめ": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "あつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "あつもり": "مُثِير",
 "あつよく": "تَفَقُّد",
 "あつらえ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "あつらえむき": "كَامِل",
 "あつらえ向き": "كَامِل",
 "あつりょく": "ضَغْط",
 "あつりょくがま": "طنجرة ضغط, قدر ضغط (وعاء ضغط للطبخ في درجات حرارة أعلى من نقطة غليان الماء)",
 "あつりょくけい": "مانومتر, مقياس ضغط الغاز (مقياس ضغط لمقارنة ضغوط الغاز)",
 "あつりょくだんたい": "جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من…)",
 "あつりょくなべ": "طنجرة ضغط, قدر ضغط (وعاء ضغط للطبخ في درجات حرارة أعلى من نقطة غليان الماء)",
 "あつりょくをくわえる": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "あつれき": "اِحْتِكَاك",
 "あつろき": "مكبس ترشيح (جهاز يستخدم للترشيح يتكون من مجموعة من الإطارات المغطاة بقطعة قماش مرشح على كلا…)\nمثال: يستخدم مكبس الترشيح في العمليات ذات الحجم الثابت والدفعات، مما يعني أنه يجب إيقاف العملية لتفريغ كعكة المرشح قبل بدء الدفعة التالية",
 "あづい": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あづま": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "あて": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あてぃし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "あていぼく": "جنبة, شجيرة فرعية (شجيرة خشبية منخفضة النمو أو نبات معمر بقاعدة خشبية)",
 "あてうま": "كابح (سطح انسيابي مفصلي على السطح العلوي لجناح الطائرة يتم رفعه لتقليل الرفع وزيادة…)",
 "あてがい": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "あてがう": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "あてがき": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "あてこすり": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق)\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "あてこする": "لَمَّحَ, أَلْمَحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "あてこと": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تخمين, حدس (تقدير يعتمد على معلومات قليلة أو معدومة) / النقد الساخر, سُخْرِيَّة / إطناب, تعبير غير مباشر (طريقة غير مباشرة للتعبير عن شيء ما)",
 "あてこむ": "تَوَقَّعَ, اِرْتَقَبَ",
 "あてごと": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تخمين, حدس (تقدير يعتمد على معلومات قليلة أو معدومة)",
 "あてさき": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "あてさきへんこう": "تَحْوِيل",
 "あてしょ": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "あてずいりょう": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "あてずっぽ": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "あてずっぽう": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "あてっこ": "لعبة تخمين (لعبة يتنافس فيها المشاركون لتحديد شيء مشار إليه بشكل غامض)",
 "あてつけ": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق)\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "あてつけがましい": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم)",
 "あてど": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "あてどころ": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "あてどなく": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "あてな": "عُنْوَان, وُجْهَة (توجيهات مكتوبة للعثور على موقع ما؛ تكتب على الرسائل أو الطرود التي سيتم تسليمها…)",
 "あてながき": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "あてにげ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "あてにする": "تَوَقَّعَ",
 "あてにならない": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "あてになる": "مَوْثُوق",
 "あてのない": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "あてはずれ": "خَيْبَة أَمَل",
 "あてはまる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "あてはめる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "あてびと": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "あてもない": "عَشْوَائِيّ",
 "あてもなく": "عَشْوَائِيًّا",
 "あてもの": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها. / سَلِيبَة / تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "あてやか": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "あてる": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم. / تعيين شخص لعمل ما / أَصَابَ\nمثال: تلقى مناد ضربة. / فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "あてレコ": "دَبْلَجَة (دَبْلَجَةُ فِلْمٍ : تَغْيِيرُ لُغَةِ الفِلْمِ الأصْلِيَّةِ إلَى لُغَةٍ أُخْرَى)",
 "あて先": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "あて先変更": "تَحْوِيل",
 "あて名": "عُنْوَان, وُجْهَة (توجيهات مكتوبة للعثور على موقع ما؛ تكتب على الرسائل أو الطرود التي سيتم تسليمها…)",
 "あて外れ": "خَيْبَة أَمَل",
 "あて所": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "あて書き": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "あて馬": "كابح (سطح انسيابي مفصلي على السطح العلوي لجناح الطائرة يتم رفعه لتقليل الرفع وزيادة…)",
 "あでやか": "سَاحِر, فَاتِن (يتمتع بجاذبية ورومانسية وإثارة)",
 "あと": "وَرَاءَ / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / بَقِيَّة / أَكْثَر / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / مَوْضِع\nمثال: هنا موقع الحادث. / نَدْبَة, نَدْب",
 "あとあし": "رجل خلفية, ساق خلفية (الطرف الخلفي لذوات الأربع)",
 "あとあじ": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما)",
 "あとあと": "مُسْتَقْبَل",
 "あといっぽ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "あといれさきだし": "ما يرد أخيراً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأحدث (التي تم شراؤها مؤخراً) هي…)",
 "あといれさきだしきおくそうち": "كَوْمَة",
 "あとうかんけいきょうかい": "شَرْق آسِيَا (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "あとおい": "تتبع الأثر, ملاحقة (ملاحقة (شخص أو حيوان) باتباع الآثار أو العلامات التي تركوها وراءهم) / تَقْلِيد",
 "あとおし": "دفع (فعل تطبيق قوة لتحريك شيء بعيداً)\nمثال: أعطى الباب دفعة قوية / عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "あとかこう": "تَعْدِيل",
 "あとかた": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あとかぶ": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "あとから": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "あとからあとから": "وَاحِدًا تِلْوَ الآخَرِ",
 "あとがき": "خَاتِمَة",
 "あとがたり": "خَاتِمَة",
 "あとがま": "خَلِيف",
 "あとくち": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / فِيمَا بَعْد, بعدين",
 "あとこうしゃく": "بَعْد المَوْت (يحدث أو يتم بعد الموت)\nمثال: تغيرات ما بعد الموت",
 "あとさき": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / عَاقِبَة / سِيَاق, قَرِينَة",
 "あとざん": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها…)",
 "あとしまつ": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "あとしらなみ": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "あとじさる": "تَرَاجُع",
 "あとじて": "بَطَل, بَطَلَة",
 "あとじまい": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "あとずさる": "تَرَاجُع",
 "あとち": "مَوْضِع\nمثال: هنا موقع الحادث.",
 "あとぢえ": "إدراك متأخر (فهم طبيعة حدث ما بعد وقوعه)\nمثال: الإدراك المتأخر دائماً أفضل من التوقع",
 "あとつぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَلِيف",
 "あとづけ": "مُلْحَق / تحديث, تعديل تحديثي (عملية إضافة مكون أو ملحق لشيء لم يكن يحتوي عليه عند تصنيعه)\nمثال: أمرت المحكمة بتحديث جميع السيارات",
 "あとづける": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あとで": "فِيمَا بَعْد, بعدين",
 "あととり": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "あとにする": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "あとになって": "أَخِير, بَعْدَ ذٰلِك",
 "あとになる": "تَأَخَّرَ",
 "あとのほう": "فِيمَا بَعْد, بعدين",
 "あとのり": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "あとはのとなれやまとなれ": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "あとはら": "آلام ما بعد الولادة (آلام تشعر بها المرأة بعد ولادة طفلها؛ مرتبطة بتقلصات الرحم) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あとばら": "آلام ما بعد الولادة (آلام تشعر بها المرأة بعد ولادة طفلها؛ مرتبطة بتقلصات الرحم) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あとばらい": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "あとばんぐみ": "متابعة اللعب (جولة ثانية فورية مفروضة على فريق كريكيت يسجل عدداً محدداً من الركضات أقل من…)",
 "あとへはひく": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "あとへひく": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "あとへん": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "あとまわし": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "あとめ": "مِيرَاث, إرْثْ",
 "あともどり": "ارتداد, تراجع (العودة إلى حالة سابقة)",
 "あとやま": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "あとり": "شرشور جبلي, عصفور زغاري",
 "あとりょうほう": "رعاية النقاهة, رعاية تالية (رعاية وعلاج المريض في فترة النقاهة)",
 "あとわ": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "あとをおう": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "あとをくらます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "あとをしたって": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ)\nمثال: و بعد قليل أتى.",
 "あとをたたない": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "あとをつぐ": "نَجَحَ",
 "あとをつける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "あとを追う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "あとピン": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "あと一歩": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "あと口": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / فِيمَا بَعْد, بعدين",
 "あど": "عَقِب, كَعْب",
 "あどけない": "بَرِيء, بَرِيئَة",
 "あな": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / حُفْرَة / جُحْر, سَرَب (معنى الفعل \"جَحَرَ\" متعدد: يدل على دخول الجحر (للضب مثلاً)، أو تأخر وتخلّف…)\nمثال: ادخل إلى ذلك الجحر. / عَجْز",
 "あなあき": "مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "あなあけ": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول)",
 "あなあけき": "لَكْمَة\nمثال: لكم اشتقت إليك!",
 "あない": "إِرْشَاد, هِدَايَة / مَعْلُومَات, مَعْلُومَة / إِعْلَان, بَلَاغ / دَعْوَة, عزيمة / لِكَيْ, أَنْ / هَٰكَذَا, كَذَا",
 "あなうさぎ": "أرنب أوروبي, أرنب العالم القديم (حيوان حفار بني رمادي شائع موطنه جنوب أوروبا وشمال أفريقيا ولكن تم إدخاله في…)",
 "あなうま": "حصان غامض (حصان سباق لا يُعرف عنه سوى القليل)",
 "あなうめ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود / إجراء كلوز, اختبار إكمال الفراغات (اختبار لتشخيص القدرة على القراءة؛ يتم حذف كلمات من نص نثري ويطلب من القارئ ملء…)",
 "あなうめもんだい": "إجراء كلوز, اختبار إكمال الفراغات (اختبار لتشخيص القدرة على القراءة؛ يتم حذف كلمات من نص نثري ويطلب من القارئ ملء…)",
 "あながあくほど": "بشكل ثاقب, بصوت حاد (بصوت حاد)\nمثال: غنت بصوت حاد نوعاً ما",
 "あながち": "حَتْماً, بِالضَّرُورَة",
 "あなくま": "غُرَيْر / غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "あなぐま": "غُرَيْر / غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "あなぐら": "قَبْو, سِرْدَاب",
 "あなぐり": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "あなご": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة…)",
 "あなた": "أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "あなたがた": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / هُنَاك, هُنَالِك / ـهُ, ـهِ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا…)",
 "あなたこなた": "هُنَا وَهُنَاكَ",
 "あなたさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あなたたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あなた方": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あなた様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あなた達": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あなだらけ": "خَاطِئ, غَلَط (يتّسم بالأخطاء؛ لا يتّفق مع النموذج أو القواعد المُقرَّرة)",
 "あなだらけにする": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها.",
 "あなつばめ": "سمامة الكهوف (سمامة من شرق آسيا؛ تنتج عش الطائر الصالح للأكل)",
 "あなどり": "اِحْتِقَار, اِزْدِرَاء",
 "あなどりがたい": "مَهِيب, مُرْهِب (يبعث على الخوف والرهبة)",
 "あなどる": "اِزْدِرَاء",
