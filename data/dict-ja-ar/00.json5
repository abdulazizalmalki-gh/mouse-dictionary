 "いからせる": "غَضَب / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "いかり": "غَضَب / مِرْسَاة, أَنْجَر",
 "いかりくるう": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "いかりしんとう": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "いかりだす": "اِنْدَلَعَ",
 "いかりゃく": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "いかりをかう": "أَهَانَ (شخص يكون لئيم لآخر بالكلام)\nمثال: أهان سامي ليلى بقص شعرها.",
 "いかりをこめて": "بِعُنْف, بِهَوَج ((عن العناصر الطبيعية) بطريقة جامحة وعاصفة)\nمثال: كانت الرياح تهب بهوج",
 "いかれぽんち": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً)\nمثال: إنها بلهاء تماماً",
 "いかれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "いかれポンチ": "رأس جسر جوي (رأس جسر استولت عليه قوات محمولة جواً)\nمثال: إنها بلهاء تماماً",
 "いかん": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ) / ضابط طبي (ممارس طبي في القوات المسلحة) / سَيِّئ, وحش / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "いかんせん": "بكل أسف, لسوء الحظ (بسبب سوء الحظ)\nمثال: لسوء الحظ أمطرت طوال اليوم",
 "いかんせんせい": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "いかんそく": "حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من…)",
 "いかんそくしょくぶつ": "نبات وعائي (نبات أخضر يحتوي على نظام وعائي: السراخس، عاريات البذور، كاسيات البذور)",
 "いかんながら": "أَنَا آسِف, أَنَا آسِفَة",
 "いかんなく": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل",
 "いかんにかかわらず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "いかんによらず": "بِغَضِّ ٱلنَّظَر عَن, دُونَ الاِهْتِمَام بِـ (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
