 "あら皮": "نَبَحَ, يَنْبَح",
 "あり": "نَمْل, نَمْلَة / مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية)\nمثال: ستبلي حسناً بمفردها / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ありあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "ありあり": "بوضوح (بدون شك أو تساؤل)\nمثال: كانوا تائهين بوضوح",
 "ありうべからざる": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه)",
 "ありうべき": "مُمْكِن / مُفَضَّل, أَفْضَل",
 "ありうる": "مُمْكِن",
 "ありえない": "مُسْتَحِيل / لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ありえないほど": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ありか": "مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "ありかた": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "ありがじゅっぴき": "شُكْرًا, تِسْلَم",
