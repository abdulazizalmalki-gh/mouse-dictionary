 "あけっぴろげ": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / إِفْرَنْجِيّ",
 "あけておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "あけてもくれても": "طوال الوقت, يوماً بعد يوم (دون توقف)\nمثال: يلعب الشطرنج يوماً بعد يوم",
 "あけないよるはない": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "あけに": "سلة خوص (سلة مصنوعة من الخوص)",
 "あけのみょうじょう": "نَجْمَة الصَّبَاح",
 "あけはなし": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "あけはらう": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "あけばん": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "あけひろげ": "غَيْر مُتَيَقِّظ, مَكْشُوف (لا يُبدي أيّ حذر أو احتراس)",
 "あけび": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)",
 "あけへん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "あけぼの": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "あけぼのいろ": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "あけましておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "あけやらぬ": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "あける": "مَفْتُوح\nمثال: فتح الباب آليا. / فَارِغ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "あけわたし": "إخْلَاء, تَخْلِيَة",
 "あけわたす": "أخْلَا\nمثال: لقد ترك لك هذا.",
 "あげ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげあげ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "あげあし": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "あげあしとり": "عَيَّاب, مُتَصَيِّدٌ لِلْأَخْطَاءِ (يميل إلى إيجاد العيوب ولفت الانتباه إليها)",
 "あげあぶら": "زَيْت اَلْطَهِي (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "あげいた": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "あげかまぼこ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげく": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "あげくのはて": "أَخِيراً",
 "あげくび": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة)",
 "あげさげ": "تَذَبذُب, تَقَلُّب / تحوير",
 "あげさげまど": "نافذة مزدوجة الرفع (نافذة لها درفتان تنزلقان لأعلى ولأسفل)",
 "あげしお": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة / طفرة, فورة (زيادة قوية مفاجئة)\nمثال: حفزت طفرة من المضاربة",
 "あげせん": "عُمُولَة",
 "あげそうば": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "あげそこ": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "あげぞこ": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "あげつらい": "جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: انخرطوا في جدال عنيف",
 "あげつらう": "نَاقَشَ, بَحَثَ / اِنْتَقَدَ",
 "あげて": "كُلّ, جَمِيع",
 "あげど": "تَمْرِين اَلضَّغَط",
 "あげなべ": "قلاية, مقلاة عميقة (جهاز مطبخ للقلي العميق؛ يعتمد حجمه على الاستخدام المقصود)\nمثال: تُستخدم المقالي العميقة لطهي العديد من الوجبات السريعة وجعلها مقرمشة",
 "あげはなす": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "あげふ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげぶた": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "あげまき": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげまど": "تَمْرِين اَلضَّغَط",
 "あげもち": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげもの": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげや": "رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر)",
 "あげゆみ": "سحبة قوس لأعلى (ضربة لأعلى من طرف القوس إلى كعبه)",
 "あげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / أَطْلَقَ, قَذَفَ / يَسْتَحْضِر, يَسْتَدْعِي / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر. / اِتَّسَعَ, اِحْتَوَى\nمثال: دفع زيري الثمن. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "あげんしりゅうし": "جُسَيْم (جسم له كتلة محدودة وهيكل داخلي ولكن أبعاده ضئيلة)",
 "あげギョーザ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげパン": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげ巻": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげ巻き": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あこ": "هُنَاكَ",
 "あこう": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "あこうだい": "سمكة الصخر الحمراء (سمكة كبيرة في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "あこう鯛": "سمكة الصخر الحمراء (سمكة كبيرة في ساحل المحيط الهادئ لأمريكا الشمالية)",
 "あこがれ": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "あこがれる": "اِشْتَاقَ",
 "あこぎ": "طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
 "あこく": "الْأَرْجَنْتِين, الأرجنتين",
 "あこつ": "عَقِب, كَعْب",
 "あご": "فَكّ / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "あごでつかう": "هَذَى",
 "あごで使う": "هَذَى",
 "あごのほね": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あごの骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あごひげ": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "あごひげあざらし": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط…)",
 "あごひも": "حزام الذقن (شريط متصل بقبعة؛ يمر تحت الذقن ويثبت القبعة في مكانها)",
 "あごぼね": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あごわれ": "طَابَع اَلْحُسْن",
 "あご割れ": "طَابَع اَلْحُسْن",
 "あご骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あさ": "صَبَاح\nمثال: كان يريد أن بصبح حاخاما. / إِفْطَار, فَطُور\nمثال: وجدت بعض الفطر. / قِنَّب هِنْدِيّ / قِنَّب",
 "あさあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "あさい": "ضَحِل / طَفِيف / قَصِير, قصير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "あさからぬ": "عَمِيق, غَوِيط",
 "あさからばんまで": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "あさがお": "أثمان نيلي, مجد الصباح الياباني (عشب متسلق استوائي حولي من العالم القديم يتميز بمجموعة واسعة من الألوان وزهور…) / قُمْعِيّ الشَّكْل (على شكل قِمع) / ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة…)",
 "あさがた": "صَبَاح\nمثال: كان يريد أن بصبح حاخاما.",
 "あさがたにんげん": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح)",
 "あさがはやい": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "あさぎうら": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء)",
 "あさぎずみ": "مُنْخَفِض الدَّرَجَة",
 "あさくず": "مشاقة (ألياف قنب أو جوت فضفاضة يتم الحصول عليها عن طريق فك الحبال القديمة؛ عندما تُشبع…)",
 "あさぐろい": "غَامِق, دَاكِن",
 "あさげ": "إِفْطَار, فَطُور\nمثال: وجدت بعض الفطر.",
 "あさごはん": "إِفْطَار, فَطُور\nمثال: وجدت بعض الفطر.",
 "あさせ": "سِرْب, مجموعة أسماك (مجموعة كبيرة من الأسماك)\nمثال: سبح سرب من الأسماك الصغيرة اللامعة بالجوار",
 "あさたね": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم…)",
 "あさだ": "جنجل ياباني (كرمة زينة موطنها شرق آسيا؛ تزرع لأوراقها المبرقشة)",
 "あさだち": "أثمان, مجد الصباح (أي من الكروم الملتفة المتنوعة ذات أزهار قمعية الشكل تغلق في وقت متأخر من اليوم)",
 "あさつき": "ثُوم مُعَمَّر",
 "あさにゆうに": "دَائِمًا, أَبَدًا",
 "あさぬの": "كَتَّان",
 "あさねぼう": "استلقاء, بقاء في الفراش (البقاء لفترة طويلة في الفراش في الصباح)",
 "あさのみ": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم…)",
 "あさはか": "ضَحِل",
 "あさはら": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "あさはん": "إِفْطَار, فَطُور\nمثال: وجدت بعض الفطر.",
 "あさばん": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あさひ": "تفاح ماكنتوش (تفاح مبكر النضج شائع في شمال شرق الولايات المتحدة؛ يؤكل نيئًا بشكل أساسي ولكنه…)",
 "あさひる": "اِفْتَرَى, اِخْتَلَقَ",
 "あさぼらけ": "فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "あさましい": "بَائِس, تَعِيس (يتسم بالبؤس الجسدي)",
 "あさめし": "إِفْطَار, فَطُور\nمثال: وجدت بعض الفطر.",
 "あさめしまえ": "بَسِيطَة, لُقْمَة سَائِغَة",
 "あさゆう": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "あさり": "بَحْثِيّ, فَاحِص (يستكشف بشكل معمّق وشامل) / صَيْد سَمَك, صَيْد",
 "あさる": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "あさんかちっそ": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "あざ": "وَحْمَة / كَدَمَ",
 "あざけり": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى…)",
 "あざける": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "あざした": "شُكْرًا",
