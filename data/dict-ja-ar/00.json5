 "あつい": "سَمِيك, غَلِيظ / غَلِيظ / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / جِدِّيّ / جَدِّيّ, جَادّ / وافِر, وَفِير / حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ / حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُتَحَمِّس, حَمَاسِيّ / شَدِيد",
 "あついせんそう": "حَرْب سَاخِنَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "あついた": "عَارِضَة / طبق فولاذي (طبق من الفولاذ)",
 "あつえん": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة",
 "あつえんこうじょう": "مطحنة درفلة (مصنع صلب يتم فيه دحرجة المعدن إلى صفائح وقضبان)",
 "あつかい": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء",
 "あつかいやすい": "طيع, قابل للإدارة (يمكن إدارته أو التحكم فيه) / قَابِل لِلتَّحْقِيق, قَابِل لِلْإِنْجَاز (يمكن تحقيقه أو إنجازه؛ في حيّز الإمكان)",
 "あつかう": "عَالَجَ / مِقْبَض / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "あつかましい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)",
 "あつかわ": "صفاقة, وقاحة (سلوك يتسم بتحدٍ جريء للأعراف وافتقار للحياء)",
 "あつがみ": "كَرْتُون, وَرَق مُقَوَّى",
 "あつくるしい": "حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين) / شَهْوَانِيّ, مُغْرٍ (مُثير جنسيًّا أو مُمتع حسّيًّا)",
 "あつぐち": "سَمِيك, غَلِيظ / غَلِيظ",
 "あつけ": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "あつさ": "سَمَاكَة / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "あつさあたり": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "あつじょう": "طَبَقَة",
 "あつで": "سَمِيك, غَلِيظ / غَلِيظ",
 "あつでん": "بيزوكهريائي, كهروضغطي (يتعلق بالكهرباء الضغطية أو يتضمنها)\nمثال: صفائح كهروضغطية",
 "あつでんき": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)؛ أو بدلاً من ذلك، ينتج الإجهاد الكهروستاتيكي تغيراً في الأبعاد الخطية…)",
 "あつでんこうか": "بيزوكهربائية, كهرباء انضغاطية (كهرباء ناتجة عن الضغط الميكانيكي على بلورات معينة (خاصة الكوارتز أو ملح روشيل)؛ أو بدلاً من ذلك، ينتج الإجهاد الكهروستاتيكي تغيراً في الأبعاد الخطية…)",
 "あつにゅう": "تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية) / مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "あつぬり": "إمباستو, تلوين سميك (رسم يطبق فيه الصبغ بكثافة بحيث تكون علامات الفرشاة أو سكين الرسم مرئية)",
 "あつばん": "أسطوانة الآلة الكاتبة, سطوانة (الأسطوانة الدوارة في الآلة الكاتبة التي تضرب عليها المفاتيح) / قرص الطباعة (اللوحة المسطحة في المطبعة التي تضغط الورق مقابل الحروف) / صفيحة ارتكاز, قاعدة الماكينة (طاولة العمل في أداة آلية (مخرطة أو مكبس))",
 "あつぼったい": "ثَقِيل",
 "あつまり": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "あつまる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "あつみ": "سَمَاكَة / عمق, عمق فكري (العمق الفكري، المعرفة النافذة، البصيرة الثاقبة، إلخ) / عُمْق, غور (صفة كون الشيء عميقاً مادياً) / حدة ذهن, عمق (القدرة الفكرية على التعمق في الأفكار) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: عمق شعوري",
 "あつみつ": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "あつめ": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "あつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "あつもり": "مُثِير",
 "あつよく": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "あつらえ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "あつらえむき": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "あつらえ向き": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "あつりょく": "ضَغْط",
 "あつりょくがま": "طنجرة ضغط, قدر ضغط (وعاء ضغط للطبخ في درجات حرارة أعلى من نقطة غليان الماء)",
 "あつりょくけい": "مانومتر, مقياس ضغط الغاز (مقياس ضغط لمقارنة ضغوط الغاز)",
 "あつりょくだんたい": "جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من خلال الضغط)",
 "あつりょくなべ": "طنجرة ضغط, قدر ضغط (وعاء ضغط للطبخ في درجات حرارة أعلى من نقطة غليان الماء)",
 "あつりょくをくわえる": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "あつれき": "اِحْتِكَاك",
 "あつろき": "مكبس ترشيح (جهاز يستخدم للترشيح يتكون من مجموعة من الإطارات المغطاة بقطعة قماش مرشح على كلا الجانبين، يتم ضخ السائل المراد تصفيته بينها)\nمثال: يستخدم مكبس الترشيح في العمليات ذات الحجم الثابت والدفعات، مما يعني أنه يجب إيقاف العملية لتفريغ كعكة المرشح قبل بدء الدفعة التالية",
 "あづい": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あづま": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "あて": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / سكن مؤقت (أماكن معيشة مؤقتة) / منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية) / حشوة, لبادة (كتلة مسطحة من مادة ناعمة تستخدم للحماية أو الحشو أو الراحة) / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あてぃし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あていぼく": "جنبة, شجيرة فرعية (شجيرة خشبية منخفضة النمو أو نبات معمر بقاعدة خشبية)",
 "あてうま": "كابح (سطح انسيابي مفصلي على السطح العلوي لجناح الطائرة يتم رفعه لتقليل الرفع وزيادة السحب) / جناح خلفي (سطح انسيابي مثبت في الجزء الخلفي من السيارة لتقليل الرفع عند السرعات العالية) / مُدَلِّل (شخص يدلل أو يفسد بالتدليل المفرط) / سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "あてがい": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "あてがう": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "あてがき": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "あてこすり": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "あてこする": "لَمَّحَ, أَلْمَحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه) / تسحّب, تسلل / اِنْدَسّ\nمثال: لمح سامي منزلا.",
 "あてこと": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تخمين, حدس (تقدير يعتمد على معلومات قليلة أو معدومة) / النقد الساخر, سُخْرِيَّة / إطناب, تعبير غير مباشر (طريقة غير مباشرة للتعبير عن شيء ما)",
 "あてこむ": "تَوَقَّعَ, اِرْتَقَبَ",
 "あてごと": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تخمين, حدس (تقدير يعتمد على معلومات قليلة أو معدومة)",
 "あてさき": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "あてさきへんこう": "تَحْوِيل",
 "あてしょ": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "あてずいりょう": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "あてずっぽ": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "あてずっぽう": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "あてっこ": "لعبة تخمين (لعبة يتنافس فيها المشاركون لتحديد شيء مشار إليه بشكل غامض)",
 "あてつけ": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "あてつけがましい": "مُتَمَلِّق, مُتَوَدِّد (مَحْسُوب لإرضاء الآخرين أو كسب ودّهم)",
 "あてど": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "あてどころ": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "あてどなく": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "あてな": "عُنْوَان, وُجْهَة (توجيهات مكتوبة للعثور على موقع ما؛ تكتب على الرسائل أو الطرود التي سيتم تسليمها إلى ذلك الموقع)",
 "あてながき": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "あてにげ": "خَاطِف, كَرّ وَفَرّ (مصمَّم لهجوم خاطف يعقبه انسحاب سريع)",
 "あてにする": "تَوَقَّعَ",
 "あてにならない": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "あてになる": "مَوْثُوق",
 "あてのない": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "あてはずれ": "خَيْبَة أَمَل",
 "あてはまる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "あてはめる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "あてびと": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "あてもない": "عَشْوَائِيّ",
 "あてもなく": "عَشْوَائِيًّا",
 "あてもの": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها. / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "あてやか": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "あてる": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم. / تعيين شخص لعمل ما / أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر.",
 "あてレコ": "دَبْلَجَة (دَبْلَجَةُ فِلْمٍ : تَغْيِيرُ لُغَةِ الفِلْمِ الأصْلِيَّةِ إلَى لُغَةٍ أُخْرَى)",
 "あて先": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "あて先変更": "تَحْوِيل",
 "あて名": "عُنْوَان, وُجْهَة (توجيهات مكتوبة للعثور على موقع ما؛ تكتب على الرسائل أو الطرود التي سيتم تسليمها إلى ذلك الموقع)",
 "あて外れ": "خَيْبَة أَمَل",
 "あて所": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "あて書き": "عنوان بريدي (العنوان الذي يمكن التواصل من خلاله مع شخص أو منظمة)",
 "あて馬": "كابح (سطح انسيابي مفصلي على السطح العلوي لجناح الطائرة يتم رفعه لتقليل الرفع وزيادة السحب) / جناح خلفي (سطح انسيابي مثبت في الجزء الخلفي من السيارة لتقليل الرفع عند السرعات العالية) / مُدَلِّل (شخص يدلل أو يفسد بالتدليل المفرط) / سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
 "あでやか": "سَاحِر, فَاتِن (يتمتع بجاذبية ورومانسية وإثارة)",
 "あと": "وَرَاءَ / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى. / بَقِيَّة / أَكْثَر / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر. / مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث. / نَدْبَة, نَدْب",
 "あとあし": "رجل خلفية, ساق خلفية (الطرف الخلفي لذوات الأربع)",
 "あとあじ": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما)",
 "あとあと": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "あといっぽ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "あといれさきだし": "ما يرد أخيراً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأحدث (التي تم شراؤها مؤخراً) هي التي تباع أولاً)",
 "あといれさきだしきおくそうち": "كَوْمَة / كُومَة",
 "あとうかんけいきょうかい": "شَرْق آسِيَا (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "あとおい": "تتبع الأثر, ملاحقة (ملاحقة (شخص أو حيوان) باتباع الآثار أو العلامات التي تركوها وراءهم) / تَقْلِيد",
 "あとおし": "دفع (فعل تطبيق قوة لتحريك شيء بعيداً)\nمثال: أعطى الباب دفعة قوية / عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل) / زوري (صندل يثبت في القدم بواسطة شريط فوق الأصابع) / دافع (شخص يدفع) / تاجر مخدرات, مروج مخدرات (تاجر غير مرخص في المخدرات غير المشروعة)",
 "あとかこう": "تَعْدِيل",
 "あとかた": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "あとかぶ": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "あとから": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى.",
 "あとからあとから": "وَاحِدًا تِلْوَ الآخَرِ",
 "あとがき": "خَاتِمَة",
 "あとがたり": "خَاتِمَة",
 "あとがま": "خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "あとくち": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ",
 "あとこうしゃく": "بَعْد المَوْت (يحدث أو يتم بعد الموت) / بَعْد الوَفَاة, بَعْدِيّ (بعد الموت أو بعد وقوع حدث ما) / تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / تحليل لاحق, مراجعة ما بعد الحدث (مناقشة لحدث ما بعد وقوعه)\nمثال: تغيرات ما بعد الموت",
 "あとさき": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / عَاقِبَة / نَتِيجَة / سِيَاق, قَرِينَة",
 "あとざん": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "あとしまつ": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "あとしらなみ": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "あとじさる": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "あとじて": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "あとじまい": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "あとずさる": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "あとち": "مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "あとぢえ": "إدراك متأخر (فهم طبيعة حدث ما بعد وقوعه)\nمثال: الإدراك المتأخر دائماً أفضل من التوقع",
 "あとつぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "あとづけ": "مُلْحَق / تحديث, تعديل تحديثي (عملية إضافة مكون أو ملحق لشيء لم يكن يحتوي عليه عند تصنيعه) / تجهيز لاحق, تحديث (مكون أو ملحق يضاف إلى شيء بعد تصنيعه)\nمثال: أمرت المحكمة بتحديث جميع السيارات",
 "あとづける": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "あとで": "فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ",
 "あととり": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "あとにする": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "あとになって": "أَخِير, بَعْدَ ذٰلِك",
 "あとになる": "تَأَخَّرَ",
 "あとのほう": "فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ",
 "あとのり": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "あとはのとなれやまとなれ": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "あとはら": "آلام ما بعد الولادة (آلام تشعر بها المرأة بعد ولادة طفلها؛ مرتبطة بتقلصات الرحم) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あとばら": "آلام ما بعد الولادة (آلام تشعر بها المرأة بعد ولادة طفلها؛ مرتبطة بتقلصات الرحم) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あとばらい": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "あとばんぐみ": "متابعة اللعب (جولة ثانية فورية مفروضة على فريق كريكيت يسجل عدداً محدداً من الركضات أقل من خصومه في الجولة الأولى)",
 "あとへはひく": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "あとへひく": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "あとへん": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "あとまわし": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "あとめ": "مِيرَاث, إرْثْ",
 "あともどり": "ارتداد, تراجع (العودة إلى حالة سابقة) / انحدار, انحدار إحصائي / نكوص ((في الطب النفسي) آلية دفاع تهرب فيها من الواقع عن طريق افتراض حالة أكثر طفولية) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "あとやま": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل) / زوري (صندل يثبت في القدم بواسطة شريط فوق الأصابع) / دافع (شخص يدفع) / تاجر مخدرات, مروج مخدرات (تاجر غير مرخص في المخدرات غير المشروعة)",
 "あとり": "شرشور جبلي, عصفور زغاري",
 "あとりょうほう": "رعاية النقاهة, رعاية تالية (رعاية وعلاج المريض في فترة النقاهة)",
 "あとわ": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "あとをおう": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "あとをくらます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "あとをしたって": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "あとをたたない": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "あとをつぐ": "نَجَحَ",
 "あとをつける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "あとを追う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "あとピン": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما) / بؤرة, نقطة التجمع (نقطة التقاء الضوء (أو أي إشعاع آخر) أو النقطة التي ينبعث منها) / بؤرة, بؤرة الإصابة (نقطة مركزية أو موضع العدوى في كائن حي)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "あと一歩": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "あと口": "طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ",
 "あど": "عَقِب, كَعْب / كَعْب",
 "あどけない": "بَرِيء, بَرِيئَة / بَرِيء",
 "あな": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / حُفْرَة / جُحْر, سَرَب (معنى الفعل \"جَحَرَ\" متعدد: يدل على دخول الجحر (للضب مثلاً)، أو تأخر وتخلّف (للخير أو الحيوان أو العام -بمعنى قلة مطره-)…؛ يُشيرُ الفعل معانٍ مُتعدِّدة بحسب سياقه، منها: الدخول في شيء (مثل دخول الضبّ جُحْره)، وإدخال شيء في شيء آخر، والارتفاع (كارتفاع الشمس)…)\nمثال: ادخل إلى ذلك الجحر. / عَجْز",
 "あなあき": "مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "あなあけ": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "あなあけき": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "あない": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / مَعْلُومَات, مَعْلُومَة / إِعْلَان, بَلَاغ / دَعْوَة, عزيمة / إِغْرَاء / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هَٰكَذَا, كَذَا",
 "あなうさぎ": "أرنب أوروبي, أرنب العالم القديم (حيوان حفار بني رمادي شائع موطنه جنوب أوروبا وشمال أفريقيا ولكن تم إدخاله في أماكن أخرى؛ مستأنس على نطاق واسع ومطور بألوان مختلفة ولاحتياجات مختلفة؛…)",
 "あなうま": "حصان غامض (حصان سباق لا يُعرف عنه سوى القليل) / حصان أسود, مرشح غامض (مرشح سياسي غير معروف جيداً ولكنه قد يفوز بشكل غير متوقع)",
 "あなうめ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود / إجراء كلوز, اختبار إكمال الفراغات (اختبار لتشخيص القدرة على القراءة؛ يتم حذف كلمات من نص نثري ويطلب من القارئ ملء الفراغات)",
 "あなうめもんだい": "إجراء كلوز, اختبار إكمال الفراغات (اختبار لتشخيص القدرة على القراءة؛ يتم حذف كلمات من نص نثري ويطلب من القارئ ملء الفراغات)",
 "あながあくほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "あながち": "حَتْماً, بِالضَّرُورَة",
 "あなくま": "غُرَيْر / غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "あなぐま": "غُرَيْر / غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "あなぐら": "قَبْو, سِرْدَاب",
 "あなぐり": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "あなご": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام)",
 "あなた": "أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ) / أَقْصَى / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / فَوْق / فَوْقَ\nمثال: أبعد صورتها عني.",
 "あなたがた": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / هُنَاك, هُنَالِك / ـهُ, ـهِ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "あなたこなた": "هُنَا وَهُنَاكَ",
 "あなたさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あなたたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あなた方": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あなた様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あなた達": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あなだらけ": "خَاطِئ, غَلَط (يتّسم بالأخطاء؛ لا يتّفق مع النموذج أو القواعد المُقرَّرة) / بِهِ خَلَل, مَعْطُوب (فيه عطب أو خلل)",
 "あなだらけにする": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "あなつばめ": "سمامة الكهوف (سمامة من شرق آسيا؛ تنتج عش الطائر الصالح للأكل)",
 "あなどり": "اِحْتِقَار, اِزْدِرَاء",
 "あなどりがたい": "مَهِيب, مُرْهِب (يبعث على الخوف والرهبة) / رَهِيب, هَائِل (مُثير للإعجاب للغاية في القوّة أو التميّز)",
 "あなどる": "اِزْدِرَاء",
 "あなねらい": "حصان غامض (حصان سباق لا يُعرف عنه سوى القليل) / حصان أسود, مرشح غامض (مرشح سياسي غير معروف جيداً ولكنه قد يفوز بشكل غير متوقع)",
 "あなのあくほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "あなば": "حَسَنُ الصِّيَانَة, مَعْتَنًى بِه (يُحَافَظُ عَلَيْهِ فِي حَالَةٍ جَيِّدَة) / حَسَنُ الصِّيَانَة, مُعْتَنًى بِه (يَتَّسِمُ بِالنِّظَامِ وَالتَّرْتِيبِ؛ خَالٍ مِنَ الفَوْضَى)",
 "あなばち": "دبور حفار (دبور انفرادي يحفر أعشاشاً في التربة ويخزن فيها حشرات مشلولة لليرقات)",
 "あなほり": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "あなぼこ": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "あなや": "قِف, قِفِي",
 "あなんこうぎょうこうとうせんもんがっこう": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "あに": "اَلْأَخ اَلْأَكْبَر / شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري. / أَبَدًا / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "あにうえ": "اَلْأَخ اَلْأَكْبَر",
 "あにきぶん": "أخ أكبر (أخ أكبر سناً) / الأخ الأكبر (قائد شمولي ومنتهك للخصوصية (مصطلح مستوحى من رواية 1984))",
 "あにご": "اَلْأَخ اَلْأَكْبَر",
 "あにさま": "اَلْأَخ اَلْأَكْبَر",
 "あにさん": "اَلْأَخ اَلْأَكْبَر / أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري. / شاب (مراهق أو شاب بالغ ذكر)",
 "あにじゃ": "اَلْأَخ اَلْأَكْبَر",
 "あにじゃひと": "اَلْأَخ اَلْأَكْبَر",
 "あによめ": "أُخْت زَوْجَة (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه) / سِلْفَة / أُخْت زَوْج (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "あね": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "あねうえ": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "あねぎみ": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "あねさま": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "あねさまにんぎょう": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "あねさん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "あねったい": "المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية)",
 "あねったいこうあつたい": "عروض الخيل (أي من الحزامين أو المنطقتين بالقرب من 30 درجة شمالاً أو 30 درجة جنوباً؛ تتميز بهدوء ورياح خفيفة محيرة)",
 "あの": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "あのう": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "あのかた": "هُوَ",
 "あのこ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あのさ": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "あのさあ": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "あのさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あのな": "يَاه, اسمع / هَلَا",
 "あのなあ": "يَاه, اسمع / هَلَا",
 "あのなー": "يَاه, اسمع / هَلَا",
 "あのね": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "あのねえ": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "あのひと": "هُوَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あのよう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "あのように": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "あのよにいく": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "あのー": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "あの世に行く": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "あの人": "هُوَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あの娘": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あの子": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あの方": "هُوَ",
 "あの方達": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم",
 "あの様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "あの様に": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "あはれ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / وَا حَسْرَتَاه, وَاهًا",
 "あばきたてる": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "あばく": "أَفْشَى / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / أَهْمَلَ / إِهْمَال",
 "あばずれ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "あばずれおんな": "غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "あばずれ女": "غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "あばた": "أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "あばよ": "أراكَ قَريبًا, سَلَام",
 "あばら": "ضِلْع",
 "あばらきん": "رِكَاب",
 "あばらぼね": "ضِلْع",
 "あばらや": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "あばら家": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "あばら屋": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "あばら筋": "رِكَاب",
 "あばれうま": "منفلت من عقاله",
 "あばれくるう": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "あばれまわる": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "あばれもの": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "あばれる": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "あばれんぼう": "دَمَوِيّ, سَفَّاح",
 "あひさん": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "あひるくち": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)\nمثال: تعبير حزين",
 "あひるぐち": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)\nمثال: تعبير حزين",
 "あびきょうかん": "فوضى, هرج ومرج (حالة من الارتباك والاضطراب الشديد)",
 "あびせかける": "شَحْطَة / شَرْطَة / كَوْمَة",
 "あびる": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "あふ": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "あふげいごう": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق)\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "あふよう": "خشخاش",
 "あふる": "طُوفَان, فَيَضَان (عاصفة)",
 "あふるる": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "あふれ": "فَيَضَان / فَاضَ",
 "あふれる": "فَيَضَان / فَاضَ",
 "あふれんばかり": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "あぶ": "نُعَرَة",
 "あぶく": "فُقَّاعَة",
 "あぶくぜに": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "あぶく銭": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "あぶなあぶな": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "あぶない": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "あぶなかしい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "あぶながる": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "あぶなく": "تَقْرِيبًا",
 "あぶなげ": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "あぶなげない": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "あぶなっかしい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "あぶねー": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "あぶみ": "رِكَاب",
 "あぶみこつ": "رِكَاب",
 "あぶみ骨": "رِكَاب",
 "あぶら": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته. / زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "あぶらあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あぶらあせ": "عرق بارد (الحالة الجسدية للتعرق المتزامن مع القشعريرة؛ مرتبطة بالخوف)",
 "あぶらいし": "فَحْم حَجَرِيّ / فَحْم / فحم / فَحَم",
 "あぶらえ": "لَوْحَة زَيْتِيَة",
 "あぶらえのぐ": "طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "あぶらかす": "كُسْبَة, كُسْب / مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あぶらぎく": "أُقْحُوَان",
 "あぶらぎった": "زَيْتِيّ, دُهْنِيّ / زَيْتِيّ",
 "あぶらぐすり": "مِلَاط, جِبْس / مَرْهَم, دَهُون",
 "あぶらけ": "تملق, مداهنة (الجدية المفتعلة المليئة بالرضا عن الذات والتملق لخدمة المصالح الشخصية) / دهنية, زيتية (يتكون من الزيت أو مغطى به)",
 "あぶらげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あぶらこ": "جرينلينغ (سمكة غذائية في شمال المحيط الهادئ)",
 "あぶらこい": "دُهْنِيّ",
 "あぶらさし": "مزيتة (علبة ذات فوهة طويلة لوضع الزيت على الآلات)",
 "あぶらざめ": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "あぶらしょう": "تملق, مداهنة (الجدية المفتعلة المليئة بالرضا عن الذات والتملق لخدمة المصالح الشخصية) / دهنية, زيتية (يتكون من الزيت أو مغطى به)",
 "あぶらそこむつ": "إسكولار (ماكريل ثعباني كبير له حلقات تشبه النظارات حول عينيه)",
 "あぶらっこい": "دُهْنِيّ",
 "あぶらっぽい": "دُهْنِيّ",
 "あぶらつのざめ": "كلب البحر الشائك (كلاب بحر صغيرة تعيش في القاع)",
 "あぶらつぼ": "خَطّ, بُنْط (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "あぶらといし": "مسن زيتي (حجر شحذ للاستخدام مع الزيت)",
 "あぶらとり": "ورق نشاف (ورق ماص يستخدم لتجفيف الحبر)",
 "あぶらとりがみ": "ورق نشاف (ورق ماص يستخدم لتجفيف الحبر)",
 "あぶらとり紙": "ورق نشاف (ورق ماص يستخدم لتجفيف الحبر)",
 "あぶらな": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "あぶらならし": "بَهَار, تَابِل",
 "あぶらにく": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "あぶらにみず": "غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "あぶらぬの": "معطف مشمع (معطف ماكنتوش مصنوع من قماش قطني معالج بالزيت والصبغة لجعله مقاوماً للماء)",
 "あぶらひき": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "あぶらぶとり": "بدين, سمين (شخص مستدير الجسم)",
 "あぶらみ": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "あぶらむし": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
