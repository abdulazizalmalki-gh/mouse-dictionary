 "あるいは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / رُبَّمَا, مِن اَلْمُمْكِن",
 "あるかぎり": "كُلّ, جَمِيع",
 "あるがまま": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "あるき": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "あるきだす": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "あるく": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "あることないこと": "نصف الحقيقة (بيان صحيح جزئياً يهدف إلى الخداع أو التضليل)",
 "あるしゅ": "أَكِيد\nمثال: لديك بعض الكتب.",
 "あるじ": "رَئِيس, رَئِيسَة",
 "あるたけ": "كَامِل",
 "あるだけ": "كَامِل",
 "あるとき": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "あるとこにはある": "هُنَاك, يُوجَد",
 "あるところにはある": "هُنَاك, يُوجَد",
 "あるに": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "あるは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "あるひ": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "あるひと": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "あるべき": "مِثَالِيّ",
 "あるまじき": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)\nمثال: طرد طالب يعتبر سلوكه غير جدير",
 "ある事ない事": "نصف الحقيقة (بيان صحيح جزئياً يهدف إلى الخداع أو التضليل)",
 "ある人": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ある所にはある": "هُنَاك, يُوجَد",
 "ある日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ある時": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ある種": "أَكِيد\nمثال: لديك بعض الكتب.",
 "ある限り": "كُلّ, جَمِيع",
 "あれ": "لِكَيْ, أَنْ / آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛ / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / عاصفة هوجاء ((أدبياً) رياح عنيفة)\nمثال: اجتاحت عاصفة هوجاء الجزيرة / وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "あれい": "دُمْبِل",
 "あれえ": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "あれかし": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "あれくるう": "عربدة, هيجان (سلوك عنيف غاضب ومدمر) / حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "あれしょう": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى)\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "あれた": "مُتَوَحِّش",
 "あれだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "あれち": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "あれっ": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "あれどめ": "مَرْهَم, زَبْدَة",
 "あれの": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "あれへん": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "あれほど": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "あれもよう": "عَاصِف",
 "あれや": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "あれよあれよ": "فَجْأَةً",
 "あれら": "أُولَٰئِكَ, تِلْكَ / هُمَا\nمثال: هن يحببن الجاز.",
 "あれー": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "あれ程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "あわ": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي…) / فُقَّاعَة",
 "あわあわ": "فَقَّاعِيّ, مَرِح (مليء بالبهجة والمرح أو يُظهرهما) / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب)\nمثال: أخذ الأمر باستخفاف",
 "あわい": "فَرَاغ, مَكَان\nمثال: الفضاء مليئ بالغموض. / فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / إِغْمَاء",
 "あわがたつ": "فُقَّاعَة",
 "あわく": "اِنْهَار\nمثال: يوشك الجسر على الانهيار. / أَهْمَلَ",
 "あわさる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "あわす": "مُبَارَاة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / قَارَنَ",
 "あわせ": "ضِدّ\nمثال: أرني مثالا آخر.",
 "あわせいた": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "あわせくぎ": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "あわせて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار / إِضَافَةً عَلى ذٰلِكَ",
 "あわせめ": "مُشْتَرَك",
 "あわせる": "مُبَارَاة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / قَارَنَ",
 "あわただしい": "مَشْغُول / سَرِيع",
 "あわたてき": "خفاقة البيض (خلاط لخفق البيض أو الكريمة)",
 "あわだち": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض)",
 "あわだつ": "فُقَّاعَة",
 "あわだてき": "خفاقة البيض (خلاط لخفق البيض أو الكريمة)",
 "あわだてる": "نَبْض\nمثال: ضرب سامي زوجته.",
 "あわだてクリーム": "قِشْدَة مَخْفُوقة",
 "あわてふためく": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "あわてもの": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "あわてる": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر. / عَجَلَة\nمثال: أسرع و إلا تأخرت.",
 "あわてるこじきはもらいがすくない": "هُنَاكَ, يُوجَدُ",
 "あわばこ": "غرفة الفقاقيع (جهاز يسجل مسارات الجسيمات المؤينة)",
 "あわひめ": "عامل بالجنس, عاملة بالجنس (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "あわび": "أُذُن اَلْبَحْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "あわふきむし": "نطاط الضفدع (نوع من حشرة البصاق)",
 "あわぶく": "فُقَّاعَة",
 "あわぶろ": "حمام فقاعات (حمام يضاف إليه مادة لتكوين رغوة وتعطير ماء الاستحمام) / جَاكُوزِي",
 "あわや": "تَقْرِيبًا",
 "あわよい": "مُنَاسِب, مُلَائِم",
 "あわれ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / وَا حَسْرَتَاه, وَاهًا",
 "あわれがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "あわれげ": "حَزِين, زعلان",
 "あわれっぽい": "حَزِين, شَجِيّ (يعبّر عن الحزن والأسى)",
 "あわれみ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "あわれむ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "あん": "لِكَيْ, أَنْ / صومعة (مسكن الناسك) / فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / مُسْوَدَّة / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب. / تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه / ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "あんあん": "غَامِق, دَاكِن",
 "あんあんのうちに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "あんあんり": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "あんい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير)",
 "あんいつ": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية))\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "あんうつ": "قتامة, كآبة (شعور بتوجس كئيب)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "あんえい": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "あんおん": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "あんか": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً) / ضَحِل",
 "あんかん": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً / غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "あんがい": "بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة / مُفَاجِئ",
 "あんがと": "شُكْرًا",
 "あんがとう": "شُكْرًا",
 "あんがど": "شُكْرًا",
 "あんき": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "あんきょ": "عبّارة, قنطرة (مصرف عرضي مغلق بالكامل تحت طريق أو سكة حديد)",
 "あんきりょく": "ذَاكِرَة, حَافِظَة",
 "あんぎゃ": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند…)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة. / ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "あんぐ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "あんけつ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "あんけん": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم. / إِيذَان, إِعْلَان",
 "あんこ": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه / حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء / اِبْنَة, بِنْت / شاب (مراهق أو شاب بالغ ذكر) / سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "あんこう": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / مُغَفَّل, أَحْمَق / عبّارة, قنطرة (مصرف عرضي مغلق بالكامل تحت طريق أو سكة حديد)",
 "あんこうがた": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "あんこうしょく": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "あんこがた": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "あんこく": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "あんこくがい": "سِجِّين, عَالَم سُفْلِيّ",
 "あんこくじだい": "اَلْعُصُورُ الْمُظْلِمَةُ",
 "あんこくぶっしつ": "مَادَّة مَظْلِمَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "あんこくエネルギー": "طاقة مظلمة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة…)\nمثال: طلب بطاقة اعتماد.",
 "あんこ型": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "あんこ形": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "あんご": "رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "あんごう": "دُسْتُور, دَسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور. / صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة.",
 "あんごうか": "ترميز, تشفير (نشاط تحويل البيانات أو المعلومات إلى رمز)",
 "あんごうかいどく": "تحليل الشفرات, تشفير (علم تحليل وفك الشفرات والرموز والرسائل المشفرة)",
 "あんごうかしゅほう": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "あんごうがく": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "あんごうぎじゅつ": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "あんごうしゅほう": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "あんごうつうか": "عُمْلَة مُعَمَّاة, مُشَفَّرَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "あんごうぶん": "رسالة سرية, كتابة مشفرة (قطعة من الكتابة برمز أو شفرة)",
 "あんごうほう": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "あんごうりろん": "تشفير, تعمية (فعل الكتابة برمز أو شفرة)",
 "あんさつ": "اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب…)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "あんさつしゃ": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي…)\nمثال: بيتي قاتلة أمك.",
 "あんさつじけん": "اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب…)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "あんさん": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あんざんがん": "أنديزيت (صخر بركاني رمادي داكن)",
 "あんざんし": "فَزَّاعَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية)",
 "あんし": "رُؤْيَة لَيْلِيَّة",
 "あんしじゅつ": "قَتْلٌ رَحِيم (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "あんしつ": "تَرَاجُع / غرفة مظلمة (غرفة يتم فيها تحميض الصور الفوتوغرافية)",
 "あんしゅ": "رَئِيسِيَّة دَيْر / رِسامة",
 "あんしゅつ": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "あんしゅれい": "وضع اليد (وضع الأيدي على رأس الشخص لطلب البركة الروحية في الرسامة المسيحية)",
 "あんしょ": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "あんしょう": "تِلَاوَة / شَعَاب / دُسْتُور, دَسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور.",
 "あんしょうか": "ترميز, تشفير (نشاط تحويل البيانات أو المعلومات إلى رمز)",
 "あんしょうばんごう": "الرقم السري, رقم التعريف الشخصي (رقم تختاره وتستخدمه للوصول إلى حسابات مختلفة)",
