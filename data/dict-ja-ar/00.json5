 "あらあらしさ": "جَلَافَة",
 "あらい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / مُسْرِف",
 "あらいこ": "مَسْحُوق غَسِيل (لَفْظٌ يُطْلِقُ عَلَى اَلْمَوَادِّ اَلصُّلْبَةِ اَلْمُكَوَّنَةِ مِنْ ذَرَّاتٍ أَوْ حَبَّاتٍ صَغِيرَةٍ، مَدْقُوق؛ في و: مادّة صلبة ناعمة مدقوقة تستعمل لأغراض شتّى ')",
 "あらいごし": "مَخَاضَة",
 "あらいざらい": "كُلّ, جَمِيع",
 "あらいし": "أَنْقَاض, رُكام",
 "あらいすすぎ": "تَنْظِيف",
 "あらいだし": "اِكْتِشَاف",
 "あらいだす": "اِكْتَشَفَ",
 "あらいっこ": "غَسَلَ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي.",
 "あらいもの": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَبَق (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: هذا الطبق لذيذ.",
 "あらいもん": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَبَق (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: هذا الطبق لذيذ.",
 "あらいや": "مِدَكّ",
 "あらう": "غَسَلَ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي. / صَفَّى / مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "あらかじめ": "قَبْلًا, قَبْل\nمثال: 私たちはあらかじめスナックを用意しておいた。 — لقد أعددنا الوجبات الخفيفة مسبقًا.",
 "あらかせぎ": "سَرِقَة, لُصُوصِيَّة",
 "あらかた": "تَقْرِيبًا, عَلَى وَشْك / حَوَالَيْ, تَقْرِيبًا",
 "あらかね": "رِكَاز, خَامَة",
 "あらかわ": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "あらがう": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "あらがね": "رِكَاز, خَامَة",
 "あらぎも": "أَحْشَاء",
 "あらぎょう": "زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد)",
 "あらくれ": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "あらくれおとこ": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "あらげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "あらごなし": "طَحَنَ (طَحَنَ؛ طِحْنٌ)",
 "あらざる": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "あらし": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة / جَلَبَة",
 "あらしのまえのしずけさ": "الْهُدُوء الَّذِي يَسْبِق الْعَاصِفَةَ",
 "あらしまわる": "اِجْتَاحَ, خَرَبَ",
 "あらす": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة. / غَزَا, اِجْتاحَ / طْرُول / مُتَصَيِّد, طْرُول",
 "あらすじ": "لَخَّصَ, اِخْتَصَرَ",
 "あらず": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "あらずもがな": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "あらずんば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "あらせられる": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "あらそい": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "あらそいうったえる": "اِتَّهَمَ",
 "あらそいごと": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "あらそいずき": "مُثِير لِلْجَدَل",
 "あらそう": "تَنَافَسَ, تَبَارَى\nمثال: １０チームが賞を得ようと争った。 — تنافس عشر فرق على الجائزة. / نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع. / نَفَى",
 "あらた": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "あらたか": "لافِتٌ لِلنَّظَرِ, لافِتَةٌ لِلنَّظَرِ",
 "あらたまった": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "あらたまの": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "あらたまる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "あらたむ": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "あらため": "اِخْتِبَار, اِمْتِحَان (اختبر الشّيء:خبره) / فَحْص (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض) / اِمْتِحَان, اِخْتِبَار (اِمْتِحَان)\nمثال: تم اختبار زيري.",
 "あらためて": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / خُصُوصًا, خَاصَّةً",
 "あらためる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / إِصْلَاح / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "あらっぽい": "مُتَوَحِّش / بَرِّيّ / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "あらない": "مَعْدُوم",
 "あらなみ": "مَشَقَّة, شِدَّة",
 "あらぬ": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / مُفَاجِئ",
 "あらぬこと": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "あらぬ事": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "あらの": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "あらひとがみ": "قَيْصَر, إِمْبْرَاطُور",
 "あらびき": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "あらぶる": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "あらへん": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "あらまし": "لَخَّصَ, اِخْتَصَرَ / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار.",
 "あらまほしい": "مِثَالِيّ",
 "あらみかみ": "قَيْصَر, إِمْبْرَاطُور",
 "あらゆる": "كُلّ, جَمِيع",
 "あららげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "あらり": "رِبْح إِجْمَالِيّ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "あらりえき": "رِبْح إِجْمَالِيّ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "あられ": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "あられぼし": "نَاتِئَة",
 "あられもない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "あらわ": "مَكْشُوف, مُعَرَّض / عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "あらわす": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "あらわにする": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد.",
 "あらわる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "あらわれ": "تَجَسَّد",
 "あらわれでる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "あらわれる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "あらんかぎり": "كُلّ, جَمِيع",
 "あらん限り": "كُلّ, جَمِيع",
 "あら挽き": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "あら皮": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "あり": "نَمْل, نَمْلَة",
 "ありあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "ありうべからざる": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ありうべき": "مُمْكِن / مُفَضَّل, أَفْضَل",
 "ありうる": "مُمْكِن",
 "ありえない": "مُسْتَحِيل / لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ありえないほど": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ありか": "مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث.",
 "ありかた": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "ありがじゅっぴき": "شُكْرًا, تِسْلَم",
