 "あぶみ骨": "رِكَاب",
 "あぶら": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "あぶらいし": "فَحْم حَجَرِيّ / فَحْم / فحم / فَحَم",
 "あぶらえ": "لَوْحَة زَيْتِيَة",
 "あぶらえのぐ": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "あぶらかす": "كُسْبَة, كُسْب",
 "あぶらぎく": "أُقْحُوَان",
 "あぶらぎった": "زَيْتِيّ, دُهْنِيّ / زَيْتِيّ",
 "あぶらぐすり": "مِلَاط, جِبْس / مَرْهَم, دَهُون",
 "あぶらこい": "دُهْنِيّ",
 "あぶらっこい": "دُهْنِيّ",
 "あぶらっぽい": "دُهْنِيّ",
 "あぶらつぼ": "خَطّ, بُنْط (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "あぶらな": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "あぶらならし": "بَهَار, تَابِل",
 "あぶらにく": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "あぶらぬの": "مُشَمَّع",
 "あぶらひき": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "あぶらみ": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "あぶらむし": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / طُفَيْلِيّ",
 "あぶらめ": "سَمَنْدَل",
 "あぶらもも": "دُرَّاق",
 "あぶらをさす": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "あぶらをそそぐ": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "あぶらをひく": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "あぶらギッシュ": "زَيْتِيّ, دُهْنِيّ / زَيْتِيّ",
 "あぶら虫": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / طُفَيْلِيّ",
 "あぶりだす": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد.",
