 "あくねん": "خبث, لؤم (الخبث الناتج عن كون الشخص حقودًا أو سيئ الطبع) / حقد, كيد (الشعور بالحاجة لرؤية الآخرين يعانون)",
 "あくのすうじく": "مِحْوَر اَلشَّرّ",
 "あくのちまた": "حي المشردين, منطقة بائسة (حي في المدينة يرتاده المشردون ومدمنو الكحول والمخدرات)",
 "あくのみちへいざなう": "أَضَلَّ",
 "あくは": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي / مَقْبِض",
 "あくば": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / حصان بري (حصان منزلي غير مروض أو وحشي)",
 "あくひょう": "خزي, سوء صيت (شهرة شريرة أو سمعة عامة سيئة) / خزي, عار (حالة من عدم الشرف الشديد)\nمثال: تاريخ سيعيش في الخزي",
 "あくび": "تَثَاءَبَ / تَثَاؤُب",
 "あくふ": "فأس يدوية (أداة حجرية ذات حافة قاطعة؛ يُمسك الحجر في اليد ويستخدم للقطع)",
 "あくふう": "رَذِيلَة / عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "あくへい": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "あくへき": "رَذِيلَة",
 "あくへん": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة)",
 "あくま": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / الشَّيْطَان, إِبْلِيس",
 "あくまがく": "عِلْم الشَيَاطِين (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "あくましゅぎ": "شَيْطَانِيَّة",
 "あくますうはい": "الشيطانية, عبادة الشياطين (اعتقاد في الشياطين وتقديسهم (خاصة الشيطان الأكبر))",
 "あくまちょうぶく": "رُقْيَة",
 "あくまてき": "جَهَنَّمِيّ, شَيْطَانِيّ (بالغ الشر أو القسوة؛ يُعبِّر عن الوحشية أو يليق بالجحيم)",
 "あくまで": "النِهاية / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "あくまでも": "النِهاية / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "あくまのうたげ": "اجتماع الساحرات, سبت الساحرات (اجتماع ليلي للساحرات لممارسة السحر والشعوذة؛ في العصور الوسطى كان يُعتقد أنه طقوس شيطانية)",
 "あくまばらい": "رُقْيَة",
 "あくまよけ": "طِلَسْم, طِلَّسْم",
 "あくみょう": "سمعة سيئة, شهرة سيئة (حالة كونه معروفاً بعمل أو صفة غير مرغوب فيها) / إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / إثم, جنحة (الخروج عما هو مقبول أخلاقياً)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "あくみょうたかい": "سَيِّئُ الصِّيتِ, مَشْهُورٌ بِالسُّوءِ (معروف على نطاق واسع وعادة بشكل سلبي)",
 "あくみょうだかい": "سَيِّئُ الصِّيتِ, مَشْهُورٌ بِالسُّوءِ (معروف على نطاق واسع وعادة بشكل سلبي)",
 "あくむ": "كَابُوس",
 "あくめ": "حصان بري (حصان منزلي غير مروض أو وحشي)",
 "あくめい": "سمعة سيئة, شهرة سيئة (حالة كونه معروفاً بعمل أو صفة غير مرغوب فيها)",
 "あくめいたかい": "سَيِّئُ الصِّيتِ, مَشْهُورٌ بِالسُّوءِ (معروف على نطاق واسع وعادة بشكل سلبي)",
 "あくめいだかい": "سَيِّئُ الصِّيتِ, مَشْهُورٌ بِالسُّوءِ (معروف على نطاق واسع وعادة بشكل سلبي)",
 "あくやく": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "あくやくれいじょう": "شريرة (امرأة شريرة)",
 "あくゆう": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "あくよう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "あくらつ": "خَبِيث, مُحْتَال (يتّسم بالمهارة في الخداع والمكر)",
 "あくりょう": "روح شريرة (روح تميل لإحداث الضرر)",
 "あくりょく": "مَقْبِض",
 "あくる": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "あくるとし": "السَّنَة الْقادِمَة",
 "あくる年": "السَّنَة الْقادِمَة",
 "あくれい": "روح شريرة (روح تميل لإحداث الضرر)",
 "あくをとる": "يَرْتَ",
 "あく洗い": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / تمشيط (التحرك عبر منطقة للبحث عن شيء ما)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء",
 "あぐん": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "あけ": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "あけい": "فَحْمِيّ",
 "あけおめ": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "あけおめことよろ": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "あけがた": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "あけくち": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "あけくれ": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あけくれる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "あけぐち": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "あけすけ": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "あけそめる": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "あけっぱなし": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "あけっぴろげ": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / مَفْتُوح عَلَى مِصْرَاعَيْه (مفتوح على اتّساعه) / إِفْرَنْجِيّ",
 "あけておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "あけてもくれても": "طوال الوقت, يوماً بعد يوم (دون توقف)\nمثال: يلعب الشطرنج يوماً بعد يوم",
 "あけないよるはない": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "あけに": "سلة خوص (سلة مصنوعة من الخوص)",
 "あけのみょうじょう": "نَجْمَة الصَّبَاح",
 "あけはなし": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "あけはらう": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "あけばん": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "あけひろげ": "غَيْر مُتَيَقِّظ, مَكْشُوف (لا يُبدي أيّ حذر أو احتراس) / غَيْرُ مَحْرُوس (يَفْتَقِرُ إِلَى الحِرَاسَةِ أَوِ الحِمَايَة)",
 "あけび": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)",
 "あけへん": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "あけぼの": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "あけぼのいろ": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "あけましておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "あけやらぬ": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "あける": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / فَارِغ / فَرَغَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "あけわたし": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "あけわたす": "أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "あげ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات)) / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげあげ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "あげあし": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "あげあしとり": "عَيَّاب, مُتَصَيِّدٌ لِلْأَخْطَاءِ (يميل إلى إيجاد العيوب ولفت الانتباه إليها) / تَذَمُّر, تَصَيُّد الْأَخْطَاء (نقد تافه وغير مبرر ومستمر)",
 "あげあぶら": "زَيْت اَلْطَهِي (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "あげいた": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "あげかまぼこ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげく": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى.",
 "あげくのはて": "أَخِيراً",
 "あげくび": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "あげさげ": "تَذَبذُب, تَقَلُّب / تحوير",
 "あげさげまど": "نافذة مزدوجة الرفع (نافذة لها درفتان تنزلقان لأعلى ولأسفل)",
 "あげしお": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة / طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "あげせん": "عُمُولَة",
 "あげそうば": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "あげそこ": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "あげぞこ": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "あげつらい": "جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: انخرطوا في جدال عنيف",
 "あげつらう": "نَاقَشَ, بَحَثَ / اِنْتَقَدَ / نَقَدَ",
 "あげて": "كُلّ, جَمِيع",
 "あげど": "تَمْرِين اَلضَّغَط",
 "あげなべ": "قلاية, مقلاة عميقة (جهاز مطبخ للقلي العميق؛ يعتمد حجمه على الاستخدام المقصود)\nمثال: تُستخدم المقالي العميقة لطهي العديد من الوجبات السريعة وجعلها مقرمشة",
 "あげはなす": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "あげふ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげぶた": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "あげまき": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげまど": "تَمْرِين اَلضَّغَط",
 "あげもち": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげもの": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげや": "رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر)",
 "あげゆみ": "سحبة قوس لأعلى (ضربة لأعلى من طرف القوس إلى كعبه)",
 "あげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / أَطْلَقَ, قَذَفَ / يَسْتَحْضِر, يَسْتَدْعِي / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر. / اِتَّسَعَ, اِحْتَوَى / اِمْتَصَ, تَشَرَّبَ / اِحْتَلَّ, شَغَلَ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / اِسْتَنْفَدَ / اِسْتَوْعَبَ, وَعَى / دَفَعَ, تَحَمَّلَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران. / رَشَّحَ, عَيَّنَ (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "あげんしりゅうし": "جُسَيْم (جسم له كتلة محدودة وهيكل داخلي ولكن أبعاده ضئيلة)",
 "あげギョーザ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげパン": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげ巻": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あげ巻き": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あこ": "هُنَاكَ",
 "あこう": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "あこうだい": "سمكة الصخر الحمراء (سمكة كبيرة في ساحل المحيط الهادئ لأمريكا الشمالية) / سمك الصخر الأحمر (لحم أحمر لسمكة طعام كبيرة من ساحل المحيط الهادئ)",
 "あこう鯛": "سمكة الصخر الحمراء (سمكة كبيرة في ساحل المحيط الهادئ لأمريكا الشمالية) / سمك الصخر الأحمر (لحم أحمر لسمكة طعام كبيرة من ساحل المحيط الهادئ)",
 "あこがれ": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "あこがれる": "اِشْتَاقَ",
 "あこぎ": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "あこく": "الْأَرْجَنْتِين, الأرجنتين",
 "あこつ": "عَقِب, كَعْب / كَعْب",
 "あご": "فَكّ / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "あごでつかう": "هَذَى",
 "あごで使う": "هَذَى",
 "あごのほね": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あごの骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あごひげ": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "あごひげあざらし": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "あごひも": "حزام الذقن (شريط متصل بقبعة؛ يمر تحت الذقن ويثبت القبعة في مكانها)",
 "あごぼね": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あごわれ": "طَابَع اَلْحُسْن",
 "あご割れ": "طَابَع اَلْحُسْن",
 "あご骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "あさ": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما. / إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر. / قِنَّب هِنْدِيّ / قِنَّب",
 "あさあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "あさい": "ضَحِل / طَفِيف / قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "あさからぬ": "عَمِيق, غَوِيط",
 "あさからばんまで": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "あさがお": "أثمان نيلي, مجد الصباح الياباني (عشب متسلق استوائي حولي من العالم القديم يتميز بمجموعة واسعة من الألوان وزهور مكشكشة أو مزدوجة) / قُمْعِيّ الشَّكْل (على شكل قِمع) / ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "あさがた": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما.",
 "あさがたにんげん": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح) / باكور, مبكر (شخص يصل مبكرًا قبل الآخرين)",
 "あさがはやい": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "あさぎうら": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء)",
 "あさぎずみ": "مُنْخَفِض الدَّرَجَة",
 "あさくず": "مشاقة (ألياف قنب أو جوت فضفاضة يتم الحصول عليها عن طريق فك الحبال القديمة؛ عندما تُشبع بالقطران كانت تستخدم لسد الشقوق وحشو الوصلات في السفن الخشبية)",
 "あさぐろい": "غَامِق, دَاكِن",
 "あさげ": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "あさごはん": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "あさせ": "سِرْب, مجموعة أسماك (مجموعة كبيرة من الأسماك) / مياه ضحلة (امتداد من المياه الضحلة) / رصيف رملي, مياه ضحلة (ضفة رملية في مسطح مائي تكون مرئية عند الجزر المنخفض)\nمثال: سبح سرب من الأسماك الصغيرة اللامعة بالجوار",
 "あさたね": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "あさだ": "جنجل ياباني (كرمة زينة موطنها شرق آسيا؛ تزرع لأوراقها المبرقشة)",
 "あさだち": "أثمان, مجد الصباح (أي من الكروم الملتفة المتنوعة ذات أزهار قمعية الشكل تغلق في وقت متأخر من اليوم)",
 "あさつき": "ثُوم مُعَمَّر",
 "あさにゆうに": "دَائِمًا, أَبَدًا",
 "あさぬの": "كَتَّان",
 "あさねぼう": "استلقاء, بقاء في الفراش (البقاء لفترة طويلة في الفراش في الصباح)",
 "あさのみ": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "あさはか": "ضَحِل",
 "あさはら": "تفاهة, شيء تافه (شيء قليل الأهمية) / تفاهة, ضآلة (صفة كون الشيء غير مهم وتافهاً أو سطحياً) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم)",
 "あさはん": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "あさばん": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あさひ": "تفاح ماكنتوش (تفاح مبكر النضج شائع في شمال شرق الولايات المتحدة؛ يؤكل نيئًا بشكل أساسي ولكنه مناسب لصلصة التفاح)",
 "あさひる": "اِفْتَرَى, اِخْتَلَقَ",
 "あさぼらけ": "فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "あさましい": "بَائِس, تَعِيس (يتسم بالبؤس الجسدي) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / بَائِس, مُعَذَّب (شَديد التَّعاسَة؛ مَليء بالبُؤس والشَّقاء)",
 "あさめし": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "あさめしまえ": "بَسِيطَة, لُقْمَة سَائِغَة",
 "あさゆう": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "あさり": "بَحْثِيّ, فَاحِص (يستكشف بشكل معمّق وشامل) / سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / ثَاقِب, نَافِذ (ذو حدة ونفاذ في الفكر أو التعبير) / صَيْد سَمَك, صَيْد",
 "あさる": "بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "あさんかちっそ": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "あざ": "وَحْمَة / كَدَمَ / كَدْمَة, رَضّ",
 "あざけり": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "あざける": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "あざした": "شُكْرًا",
 "あざす": "شُكْرًا",
 "あざっした": "شُكْرًا",
 "あざっす": "شُكْرًا",
 "あざとい": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة) / مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "あざな": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "あざます": "شُكْرًا",
 "あざまる": "شُكْرًا",
 "あざまーす": "شُكْرًا",
 "あざみ": "شوك, قردمان",
 "あざみうま": "تربس (أي من الحشرات الماصة الصغيرة إلى الدقيقة ذات أجنحة ريشية ضيقة إن وجدت؛ تتغذى على عصارة النبات والعديد منها مدمر)",
 "あざむく": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "あざやか": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / مَاهِر, حَاذِق",
 "あざらしししょう": "تفقم الأطراف (شذوذ في النمو يكون فيه الجزء العلوي من الذراع أو الساق مفقوداً بحيث تكون اليدين أو القدمين متصلة بالجسم مثل الجذوع؛ حالة نادرة ناتجة عن تناول…)",
 "あざり": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة / بَادَرَ / عُضْو جَدِيد, مُنْتَسِب (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "あざれ": "دعابة خفيفة, ملاطفة (ملاحظة مقبولة أو مسلية)\nمثال: يتبادلون الملاطفات",
 "あざわらう": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "あざーした": "شُكْرًا",
 "あざーす": "شُكْرًا",
 "あざーっした": "شُكْرًا",
 "あざーっす": "شُكْرًا",
 "あざ笑う": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "あし": "سَيِّئ, وحش / قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام) / رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "あしあと": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "あしい": "سَيِّئ, وحش",
 "あしおき": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "あしおと": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي) / خطوة, وقع الأقدام (صوت خطوة شخص يمشي) / خطوة (المسافة التي تغطيها خطوة)\nمثال: سمع وقع أقدام على الشرفة",
 "あしおとをしのばせて": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "あしか": "فقمة ذات أذنين (ثديي زعنفي الأقدام له سديلات أذن خارجية وأطراف خلفية تُستخدم للحركة على الأرض؛ يُقدر لفروه السفلي الناعم)",
 "あしかけ": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "あしかせ": "غُلّ, أَغْلال",
 "あしからず": "أَنَا آسِف, أَنَا آسِفَة",
 "あしかんせつ": "وصلة القدم (في الناي) (وصلة القدم هي القسم الأخير من الأقسام الثلاثة للناي الموسيقي الغربي)\nمثال: تحتوي آلة الناي الموسيقية على ثلاثة أجزاء: وصلة الرأس، والجسم، ووصلة القدم",
 "あしがおもい": "ثقيل الخطى ((للحركة) يفتقر إلى السهولة أو الخفة)\nمثال: مشيته المتعبة ثقيلة الخطى / مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "あしがかり": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "あしがすくむ": "تَجَمَّدَ",
 "あしがせ": "غُلّ, أَغْلال",
 "あしがた": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "あしがため": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "あしがちにつかない": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "あしがもつれる": "هَذَيَان / هَذَى",
 "あしき": "سَيِّئ, وحش",
 "あしきり": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "あしくせ": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "あしくび": "كَاحِل, كَعْب",
 "あしぐせ": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "あしげ": "رمادي مرقط (رمادي بنمط مرقط من علامات رمادية أغمق) / رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "あしげにする": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "あしげり": "رفسة, ركلة (عملية توجيه ضربة بالقدم) / رفس, ركل (حركة دفع إيقاعية للساقين كما في السباحة أو التمارين الرياضية)\nمثال: وجه للكرة ركلة قوية",
 "あしこ": "هُنَاكَ",
 "あしこし": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "あしごしらえ": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "あしさばき": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر) / حركة القدمين (طريقة استخدام القدمين)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب",
 "あしざまに": "بِاسْتِهْجَان, بِسَلْبِيَّة (إظهار عدم الموافقة؛ بطريقة استخفافية)\nمثال: استعرض المسرحية بسلبية",
 "あしざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "あししげく": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "あししげくかよう": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "あした": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما.",
 "あしたず": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "あしだい": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل) / كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "あしだまり": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "あしつぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "あしてがらみ": "عَائِق, عَقَبَة",
 "あしてまとい": "عَائِق, عَقَبَة",
 "あしでまとい": "عَائِق, عَقَبَة",
 "あしどめ": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية / تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "あしどり": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "あしどりひょう": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "あしなえ": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية)) / عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)\nمثال: كاتب مشهور بركاكة حبكاته",
 "あしなが": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "あしながばち": "دبور الورق (أي من عدة دبابير اجتماعية تبني أعشاشاً من مادة تشبه الورق)",
 "あしなしいもり": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "あしなしとかげ": "سحلية عديمة الأرجل (سحلية ضامرة تشبه الدودة تحفر الجحور في كاليفورنيا قريبة الصلة بسحالي القاطور)",
 "あしなみ": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "あしならし": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "あしに": "ثقل الموازنة, صابورة (أي مادة ثقيلة تستخدم لتثبيت سفينة أو منطاد) / كابح, موازن ضوء (جهاز كهربائي لبدء وتنظيم مصابيح الفلورسنت والتفريغ) / كابح, مقاومة الموازنة (مقاومة تدرج في دائرة لتعويض التغييرات (مثل تلك الناشئة عن تقلبات درجات الحرارة)) / ثبات, رزانة (سمة تميل لإعطاء الاستقرار في الشخصية والأخلاق؛ شيء يثبت العقل أو المشاعر)",
 "あしぬけ": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "あしのこう": "مشط القدم (جزء الحذاء أو الجورب الذي يغطي قوس القدم) / قوس القدم, مشط القدم (قوس القدم)",
 "あしのせ": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "あしのせだい": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "あしのつけね": "مَفْصِل اَلْوَرْكِ",
 "あしのふみばもない": "جَمِيع أَنْحَاء, كُلّ",
 "あしのべん": "تيسر الوصول, سهولة المعشر (سمة كونه سهلاً للقاء أو التعامل معه) / إِتَاحَة, تَوَفُّر (صفة كون الشيء في المتناول عند الحاجة)",
 "あしのゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "あしはくせん": "سِعْفَة القَدَم, القَدَم الرِيَاضِي",
 "あしはこび": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "あしはらのなかつくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "あしば": "سِقَالَة, إِسْقَالَة / ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "あしばや": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "あしばやい": "خَفِيفُ القَدَم, سَرِيعُ الخُطَى (ذُو أَقْدَامٍ سَرِيعَةِ الحَرَكَةِ)",
 "あしばやに": "بخفَة",
 "あしひれ": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام)",
 "あしび": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "あしぶえ": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "あしぶみ": "مَرْعَى, سْتِيب / توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "あしぶみじょうたい": "توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "あしまかせ": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "あしまとい": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "あしまわり": "عفشة السيارة, نظام التعليق (نظام ميكانيكي من النوابض أو ممتصات الصدمات يربط العجلات والمحاور بهيكل المركبة ذات العجلات) / حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "あしもと": "تَحْت الأَقْدَام (تحت القدمين) / فِي الطَّرِيق (في الطريق ويعيق التقدم)\nمثال: داس الفاصوليا تحت الأقدام / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "あしもとからとりがたつ": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة",
 "あしゃ": "أَخْرَس, أَبْكَم ((أَخْرَسَت) الأَرْض: لم تصلح للزِّرَاعَة؛ (أَخْرَسَ) الله فلَانا: أَصَابَهُ بالخرس) / صَامِت",
 "あしゅ": "نُوَيْع",
 "あしゅう": "آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "あしゅら": "نِصْف إِلٰه",
 "あしゆ": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "あしゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "あしょうさん": "حمض النيتروز (حمض غير عضوي غير مستقر يُعرف فقط في المحلول وكأملاح النتريت)",
 "あしょうさんえん": "نيتريت",
 "あしょうさんアミル": "نترات الأميل (موسع للأوعية الدموية يستخدم أحياناً لعلاج الذبحة الصدرية)",
 "あしょうさんナトリウム": "نيتريت الصوديوم (نيتريت يستخدم لحفظ وتلوين الطعام خاصة في منتجات اللحوم والأسماك؛ متورط في تكوين مواد مسرطنة مشتبه بها)",
 "あしらい": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية. / دعم, مرافقة (جزء موسيقي (صوتي أو آلي) يدعم أو يوفر خلفية لأجزاء موسيقية أخرى)",
 "あしらう": "عَالَجَ / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "あしわ": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "あしわざ": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر) / حركة القدمين (طريقة استخدام القدمين)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب",
 "あしをあらう": "تَخَلَّى عَن, تَوَقَّفَ",
 "あしをすべらす": "اِنْزَلَقَ",
 "あしをすべらせる": "اِنْزَلَقَ",
 "あしをとめる": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "あしをはこぶ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "あしをひきずる": "عَرَجَ",
 "あしをひっぱる": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "あしをふみいれる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "あしヒレ": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام)",
 "あし毛": "رمادي مرقط (رمادي بنمط مرقط من علامات رمادية أغمق)",
 "あじ": "بَهَار / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / ماكريل الحصان (سمكة طعام كبيرة ممدودة ومضغوطة تعيش في مياه المحيط الأطلسي لأوروبا) / تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية) / رئيس, زعيم (قائد مجموعة من الناس) / زعيم قبيلة, شيخ قبيلة (رئيس قبيلة أو عشيرة)\nمثال: من أقطاب الصناعة",
 "あじあい": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / نكهة ((فيزياء) الأنواع الستة للكواركات) / روح, شعور (الجو العام لمكان أو موقف وتأثيره على الناس)\nمثال: أثاره شعور المدينة / مَعْنًى / الْمَعْنَى",
 "あじあう": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "あじかげん": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "あじがする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "あじがでる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "あじきある": "مُشَوِّق, ممتع",
 "あじきき": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق. / مُتَذَوِّق",
 "あじきない": "مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "あじけない": "مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "あじさし": "خَرْشَنَة",
 "あじざけ": "مُرْتَفِع الدَّرَجَة",
 "あじたま": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب",
 "あじたまご": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب",
 "あじつけ": "بَهَار, تَابِل",
 "あじつけたまご": "مَسْلُوقٌ بِنِصْفِ نُضْج ((عَنِ البَيْض) لَا يَزَالُ الصَّفَارُ سَائِلًا) / رقيق القلب, طيب القلب (سهل التأثر بالشفقة أو الحزن)\nمثال: قاضٍ رقيق القلب",
 "あじな": "شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "あじのある": "مُشَوِّق, ممتع",
 "あじのもと": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "あじみ": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "あじもそっけもない": "كَلِيل",
 "あじゃじゃしたー": "شُكْرًا, تِسْلَم",
 "あじゃぱあ": "قِف, قِفِي",
 "あじゃら": "دعابة خفيفة, ملاطفة (ملاحظة مقبولة أو مسلية)\nمثال: يتبادلون الملاطفات",
 "あじゃり": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة / بَادَرَ / عُضْو جَدِيد, مُنْتَسِب (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "あじゃれ": "دعابة خفيفة, ملاطفة (ملاحظة مقبولة أو مسلية)\nمثال: يتبادلون الملاطفات",
 "あじろ": "خوص, غصن الصفصاف (عمل مصنوع من أغصان رفيعة متشابكة (خاصة أغصان الصفصاف))",
 "あじわい": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / نكهة ((فيزياء) الأنواع الستة للكواركات) / روح, شعور (الجو العام لمكان أو موقف وتأثيره على الناس)\nمثال: أثاره شعور المدينة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "あじわいしる": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "あじわいぶかい": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي) / تثقيفي, تنويري (يميل لزيادة المعرفة أو تبديد الجهل)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "あじわい深い": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي) / تثقيفي, تنويري (يميل لزيادة المعرفة أو تبديد الجهل)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "あじわう": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "あじをつける": "مَوْسِم / مَوْسِم, جُزْء",
 "あじをととのえる": "بَهَار",
 "あじをみる": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "あじん": "دُونَ المُسْتَوَى البَشَرِيّ (غَيْرُ صَالِحٍ لِلْبَشَرِ) / أقل من البشر, دون المستوى البشري (أقل من البشر أو لا يليق بالإنسان)\nمثال: عامل السكان الأصليين كأنهم دون البشر / أرجنتيني (من أو يتعلق بالأرجنتين أو شعبها أو يميزهم) / أرجنتيني (مواطن أو ساكن في الأرجنتين)\nمثال: تانغو أرجنتيني / أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "あじフライ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "あすこ": "هُنَاكَ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "あすぶ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / تَسَكَّعَ / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "あすら": "نِصْف إِلٰه",
 "あずかり": "حراسة, حفظ (مسؤولية الوصي أو الحارس)\nمثال: ترك سيارته في حفظي / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "あずかりきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "あずかりしょ": "غرفة المعاطف, غرفة الملابس (غرفة يمكن ترك المعاطف والأشياء الأخرى فيها مؤقتاً) / استراحة الأعضاء (صالة خاصة ملحقة بقاعة تشريعية)",
 "あずかりじょ": "غرفة المعاطف, غرفة الملابس (غرفة يمكن ترك المعاطف والأشياء الأخرى فيها مؤقتاً) / استراحة الأعضاء (صالة خاصة ملحقة بقاعة تشريعية)",
 "あずかる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / اِهْتَمَّ, اِعْتَنَى / اِحْتَفَظَ / كتم",
 "あずきいろ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "あずきぞうむし": "فاصولياء الأزوكي, لوبياء زاوية (نبات حولي كثيف يزرع على نطاق واسع في الصين واليابان للدقيق المصنوع من بذوره)",
 "あずきアイス": "بُوظَة, آيْس كِرِيم",
 "あずき色": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "あずけ": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس.",
 "あずけいれ": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "あずけぬし": "مودع (شخص أودع مالاً في بنك أو مؤسسة مماثلة)",
 "あずける": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "あずさ": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "あずま": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "あずまごと": "عَرَبَة",
 "あずましい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "あずまや": "عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "あずま屋": "عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "あせ": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق. / رُطُوبَة / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あせい": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "あせおさえ": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "あせしらず": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "あせする": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "あせつ": "شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل)",
 "あせどめ": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "あせび": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "あせぶ": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "あせぼ": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء) / حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "あせも": "حمو النيل, طفح حراري (انسداد القنوات العرقية أثناء الحرارة العالية والرطوبة)",
 "あせり": "نَفَاد صَبْر",
 "あせる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / خَسَّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "あせをかく": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "あせをながす": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "あせんやく": "سنط الكادي, كاث هندي (شجرة شائكة من جزر الهند الشرقية لها أوراق ريشية مزدوجة وزهور صفراء تليها قرون مسطحة؛ مصدر للكاث الأسود) / كاتشو أسود (مستخلص من قلب خشب شجر السنط الكادي يستخدم للصباغة والدباغة وحفظ شباك الصيد والأشرعة؛ كان يستخدم طبياً في السابق)",
 "あぜ": "جسر, طريق مرتفع (طريق مرفوع فوق الماء أو المستنقعات أو الرمال)",
 "あぜん": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "あそ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "あそこ": "هُنَاكَ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "あそばす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "あそび": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / مُتْعَة, لَذَّة / مُرُونة / الورقة الحرة, بطانة الغلاف (ورقة فارغة في مقدمة أو مؤخرة الكتاب)",
 "あそびあいて": "رفيق اللعب (رفيق في اللعب)",
 "あそびあるく": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "あそびがみ": "الورقة الحرة, بطانة الغلاف (ورقة فارغة في مقدمة أو مؤخرة الكتاب)",
 "あそびぎ": "زي رياضي نسائي, ملابس لعب (زي رياضي للنساء أو الأطفال؛ يتكون عادة من شورت وبلوزة) / بليزر, سترة رياضية (سترة خفيفة الوزن أحادية الصدر؛ غالباً ما تكون مخططة بألوان نادٍ أو مدرسة)",
 "あそびぐるま": "بكرة شد, بكرة وسيطة (بكرة على عمود تضغط على حزام التوجيه لتوجيهه أو شده)",
 "あそびごころ": "متعة, مرح (أنشطة ممتعة أو مسلية) / لعب, مرح (الميل لإيجاد (أو صنع) أسباب للتسلية) / عبث, مرح (شعور احتفالي بهيج)\nمثال: أفعل ذلك من أجل المتعة / تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "あそびごと": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس.",
 "あそびじかん": "وقت اللعب (وقت مخصص للعب أو التسلية)",
 "あそびずき": "دَاعِب, لَعُوب / باحث عن اللذة, متعي (شخص تحفزه الرغبة في الملذات الحسية)",
 "あそびたわむれる": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "あそびともだち": "رفيق اللعب (رفيق في اللعب)",
 "あそびどうぐ": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "あそびなかま": "رفيق اللعب (رفيق في اللعب)",
 "あそびにん": "مُسْتَهْتَر / مُقَامِر / مُغَامِر / عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "あそびば": "مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "あそびめ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "あそびゴコロ": "متعة, مرح (أنشطة ممتعة أو مسلية) / لعب, مرح (الميل لإيجاد (أو صنع) أسباب للتسلية) / عبث, مرح (شعور احتفالي بهيج)\nمثال: أفعل ذلك من أجل المتعة / تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "あそび女": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "あそび心": "متعة, مرح (أنشطة ممتعة أو مسلية) / لعب, مرح (الميل لإيجاد (أو صنع) أسباب للتسلية) / عبث, مرح (شعور احتفالي بهيج)\nمثال: أفعل ذلك من أجل المتعة / تصور, خيال (تكوين صورة ذهنية لشيء لا يُدرك على أنه حقيقي وليس حاضرًا للحواس)\nمثال: خلق الخيال الشعبي عالمًا من الشياطين",
 "あそぶ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / تَسَكَّعَ / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "あぞく": "جنس فرعي, جنيس ((في الأحياء) مجموعة تصنيفية بين الجنس والنوع) / زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "あた": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / ضَرَّ أَضَرَّ",
 "あたい": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / قِيمَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あたいする": "اِسْتَحَقَّ",
 "あたいせんきん": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى)",
 "あたいりく": "شِبْه قارَة",
 "あたうかぎり": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "あたう限り": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "あたえ": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "あたえたまう": "أَنْعَمَ",
 "あたえたもう": "أَنْعَمَ",
 "あたえぬし": "مُعْطٍ",
 "あたえる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تعيين شخص لعمل ما / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "あたおか": "مَجْنُون, مَخْبُول",
 "あたかも": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "あたかもよし": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "あたかも好し": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "あたくし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あたし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あたしたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "あたしゃ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あたし達": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "あたする": "ضَرَرٌ / ضَرَّ أَضَرَّ / غَزَا, اِجْتاحَ / عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "あたたか": "دَافِئ / دَفِيء",
 "あたたかい": "دَافِئ / دَفِيء / مراعٍ, مهتم بالآخرين (يظهر اهتماماً بحقوق ومشاعر الآخرين)\nمثال: أصدقاء مراعون بما يكفي ليتركونا وحدنا",
 "あたたかさ": "دفاء",
 "あたたかみ": "دفاء",
 "あたたまる": "اِسْتَدْفَأَ / دَفَّأَ, أَدْفَأَ (دَفَّأَ الَجريحَ: أَدْفَأَهُ)",
 "あたためる": "دَافِئ / دَفِيء / احتفظ بكل شيء لنسفه / جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "あたふた": "مُسْتَعْجِل",
 "あたぼう": "طَبِيعِيّ",
 "あたま": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / قَائِد, زَعِيم",
 "あたまいい": "لَامِع, نَيِّر / مُسْتَنِير",
 "あたまうち": "هَضْبَة",
 "あたまおかしい": "مَجْنُون, مَخْبُول",
 "あたまかざり": "خوذة, غطاء رأس (ملابس للرأس)",
 "あたまかず": "تَعْدَاد الأَشْخَاص, عَدَد الأَفْرَاد (عدد الأشخاص في مجموعة معينة)",
 "あたまかぶ": "شَيْخ, قَائِد",
 "あたまから": "بشكل قاطع, بشكل مطلق (بطريقة غير مشروطة)\nمثال: نفى التهم بشكل قاطع / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً / جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "あたまからつまさきまで": "مِن الرَّأْس إِلَى القَدَم (في جميع النقاط من الرأس إلى القدمين)\nمثال: كان مسلحاً من رأسه إلى أخمص قدميه",
 "あたまがいい": "لَامِع, نَيِّر / مُسْتَنِير",
 "あたまがおかしい": "مَجْنُون, مَخْبُول",
 "あたまがかたい": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "あたまがさがる": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "あたまがひくい": "مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "あたまがふるい": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "あたまがへん": "مَجْنُون, مَخْبُول",
 "あたまがまっしろになる": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "あたまがまわらない": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "あたまがやわらかい": "مَرِن",
 "あたまがよい": "لَامِع, نَيِّر / مُسْتَنِير",
 "あたまがわるい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "あたまきん": "دفعة أولى, عربون (دفعة جزئية تُدفع وقت الشراء؛ والباقي يُدفع لاحقاً)",
 "あたまくだし": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "あたまごし": "تَجَاهَلَ, طَنَّش",
 "あたまごなし": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "あたまじらみ": "قملة الرأس (تغزو رأس وجسم البشر)",
 "あたまだし": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / إعلام مسبق, تنبيه (رسالة تحذيرية)\nمثال: أرسل تنبيهاً للمدعي العام / كُو",
 "あたまつき": "تَصْفِيفَة, تَسْرِيحَة",
 "あたまでっかち": "ثَقِيل الأَعْلَى, مُثْقَل مِنَ الأَعْلَى (غير مستقر بسبب الحمل الزائد في الجزء العلوي)",
 "あたまにいれる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "あたまにおく": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "あたまにはいる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "あたまのいい": "لَامِع, نَيِّر / مُسْتَنِير",
 "あたまのいたい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "あたまのおかしい": "مَجْنُون, مَخْبُول",
 "あたまのかいてん": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "あたまのかいてんがおそい": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "あたまのかいてんがはやい": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "あたまのかいてんのはやい": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "あたまのかたい": "مُتَعَنِّت, عَنِيد",
 "あたまのくろいねずみ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "あたまのくろいネズミ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "あたまのたかい": "مُتَعَالٍ, الْمُتَعَالِي",
 "あたまのたりない": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "あたまのにぶい": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "あたまのやわらかい": "مَرِن",
 "あたまのよい": "لَامِع, نَيِّر / مُسْتَنِير",
 "あたまのよわい": "ثقيل الظل, شخص ممل (شخص يبعث على الملل) / أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "あたまのわるい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "あたまひとつ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "あたまひも": "رِبَاط",
 "あたまよい": "لَامِع, نَيِّر / مُسْتَنِير",
 "あたまわるい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "あたまをさげる": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِعْتَذَرَ, اِسْتَعْذَرَ / عَجَبَ",
 "あたまをたてにふる": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "あたまをはたらかせる": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "あたら": "وَا حَسْرَتَاه, وَاهًا",
 "あたらしい": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "あたらしく": "حديثاً, طازجاً (مؤخراً جداً)\nمثال: متزوجان حديثاً",
 "あたらずさわらず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "あたり": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / نَجَاح / خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\". / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / بِالْقُرْب, قُرْبَ / مَوْجُود (الذي له وجود)\nمثال: رقصنا حول النار. / على سبيل المثال, مثلاً (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذ الثعابين الشريطية على سبيل المثال (يفيد الاستعلاء؛ يفيد التعليل)",
 "あたりいちめん": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "あたりいったい": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あたりかまわず": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "あたりき": "بُوضُوح",
 "あたりきしゃりき": "بُوضُوح",
 "あたりきょうげん": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "あたりぎ": "مِدَقَّة, يَد",
 "あたりさわらず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "あたりさわり": "عَقَبَة, حَاجِز",
 "あたりさわりのない": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "あたりはずれ": "تَرَاوُح, اِخْتِلَاف",
 "あたりばち": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "あたりぼう": "مِدَقَّة, يَد",
 "あたりまえ": "طَبِيعِيّ / عَادِيّ",
 "あたりめえ": "طَبِيعِيّ / عَادِيّ",
 "あたりめー": "طَبِيعِيّ / عَادِيّ",
 "あたりや": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "あたりをつける": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "あたり一帯": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "あたり一面": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "あたり鉢": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "あたる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته. / لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "あたん": "فحم بني / عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / ضَرَّ أَضَرَّ",
 "あだ": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / ضَرَّ أَضَرَّ / سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة) / جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "あだうち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "あだおろそか": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "あだざくら": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "あだする": "ضَرَرٌ / ضَرَّ أَضَرَّ / غَزَا, اِجْتاحَ / عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "あだっきゅう": "خلع جزئي (إزاحة جزئية لمفصل أو عضو)",
 "あだっぽい": "جذاب, فاتن (يميل إلى إغراء شخص للقيام بعمل أو حالة مرغوبة)",
 "あだとなる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "あだな": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "あだなす": "اِنْتَقَمَ",
 "あだになる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "あだびと": "آخَرُون\nمثال: 彼女はもっと他人の言うことを聞くべきだ。 — ينبغي لها أن تستمع إلى آراء الآخرين أكثر.",
 "あだやおろそか": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "あだをなす": "اِنْتَقَمَ",
 "あだん": "شجرة المظلة, ماغنوليا ثلاثية البتلات (شجرة صغيرة متساقطة الأوراق في شرق أمريكا الشمالية ذات زهور بيضاء كريمية وأوراق كبيرة في تشكيلات تشبه المظلات عند أطراف الفروع) / شجرة المظلة, شفليرا (شجيرة دائمة الخضرة منتصبة أو شجرة صغيرة من أستراليا وشمال غينيا الجديدة ذات أوراق مركبة كفية)",
 "あだ名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "あだ討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "あち": "هُنَاك, هُنَالِك / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هُنَاكَ",
 "あちぃ": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "あちい": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "あちき": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あちこち": "هُنَا وَهُنَاكَ / مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "あちさん": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / سَمِيك, غَلِيظ / غَلِيظ",
 "あちち": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "あちゃ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あちゃあ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あちゃー": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あちら": "هُنَاك, هُنَالِك / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هُنَاكَ",
 "あちらこちら": "هُنَا وَهُنَاكَ / مُخْتَلِط, مُشَوَّش الذِّهْن (مرتبك وغامض التفكير؛ يُقال خاصّة عن طريقة التفكير)",
 "あちらご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "あちら語": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "あぢぃ": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あぢい": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あぢー": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / شَغُوف, مُتَحَمِّس / مُهْتَمّ",
 "あっ": "آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "あっか": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة)",
 "あっかい": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "あっかん": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه / مُشَاغِب / إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت) / لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / صَاعِق, مُذْهِل (يسبب أو قادر على التسبب في الذهول أو الصدمة أو فقدان الوعي) / مُذْهِل, مُصْعِق (يُسبب ذهولًا وحيرة شديدين) / عَجَّبَ",
 "あっかんじょう": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه",
 "あっき": "روح شريرة (روح تميل لإحداث الضرر) / زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ)",
 "あっけい": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "あっけない": "غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "あっけらかん": "بلا مبالاة (بطريقة غير مبالية)\nمثال: كانت الحرب تندلع في أوروبا، لكنها خططت لقضاء عطلة بلا مبالاة / بِذُهُول, بِفَرَاغ (بطريقة فارغة وغير مستوعبة)\nمثال: حدقت فيه بذهول",
 "あっこ": "هُنَاكَ",
 "あっこう": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي) / تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "あっこん": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "あっさい": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "あっさいき": "آلة تجليخ, جلاخة (أداة آلية تلمع المعدن) / طاحونة, مطحنة (آلات تعالج المواد عن طريق الطحن أو السحق) / رحى, ضرس (سن طاحنة ذات تاج عريض؛ تقع خلف الضواحك) / سابمارين, سندويتش غواصة (شطيرة كبيرة مصنوعة من لفافة خبز طويلة مقسومة طولياً ومحشوة باللحوم والجبن (والطماطم والبصل والخس والتوابل))",
 "あっさく": "ضَغْط",
 "あっさくき": "ضاغط (جهاز ميكانيكي يضغط الغازات) / ضاغط (جهاز إلكتروني يقلل النطاق الديناميكي لإشارة صوتية)",
 "あっさくくうき": "هَوَاء مَضْغُوط (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "あっさつ": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "あっさり": "بِسُهُولَة / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "あっし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "あっしゅく": "ضغط, كبس (تطبيق الضغط) / ضغط, ضغط البيانات (تشفير المعلومات مع تقليل النطاق الترددي أو البتات المطلوبة) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً) / تصلب, تكثيف (زيادة في كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد / تكثيف, تكميد (فعل زيادة كثافة شيء ما)",
 "あっしゅくき": "ضاغط (جهاز ميكانيكي يضغط الغازات) / ضاغط (جهاز إلكتروني يقلل النطاق الديناميكي لإشارة صوتية)",
 "あっしゅくくうき": "هَوَاء مَضْغُوط (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "あっしゅくくうききかい": "هَوَاء مَضْغُوط (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "あっしゅくせい": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل)",
 "あっしゅくぶくろ": "كيس الغبار, كيس المكنسة (كيس يتم شفط الأوساخ إليه بواسطة المكنسة الكهربائية)",
 "あっしゅくりつ": "إسفنجية, قابلية الانضغاط (خاصية القدرة على شغل حيز أقل)",
 "あっしん": "إحساس بالضغط, ضغط (الإحساس الجسدي الناتج عن تطبيق قوة على منطقة من الجلد)\nمثال: كانت حساسية جلده للضغط والحرارة طبيعية",
 "あっしんき": "ضاغط ممدد (نظام لتحسين نسبة الإشارة إلى الضوضاء لإشارة عند جهاز إرسال أو مسجل عن طريق ضغط نطاق حجم الإشارة أولاً ثم استعادته إلى مستوى السعة الأصلي عند جهاز…)",
 "あっす": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / اِسْتَضْعَفَ, قَهَرَ",
 "あっする": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / اِسْتَضْعَفَ, قَهَرَ",
 "あっせい": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / اِسْتِبْدَاد, ظُلْم (مصدر الفعل \"اسْتَبَدَّ\"؛ الحزم وعدم التردد في اتخاذ القرار وتنفيذه)",
 "あっせいしゃ": "ظَالِم",
 "あっせいてき": "طُغْيَانِيّ, قَمْعِيّ (يَتَّسِم بِقَسْوَة ظَالِمَة أَوْ سُلُوك تَعَسُّفِيّ) / خانِق, كابِت (يُثْقِل كاهِل النَّفْس والحَواسّ بِشِدَّة)",
 "あっせん": "خدمات (أداء واجبات أو توفير مساحة ومعدات مفيدة للآخرين)\nمثال: حاول العمدة الحفاظ على خدمات المدينة / وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "あっせんいん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
