 "あり得べき": "مُمْكِن / مُفَضَّل, أَفْضَل",
 "あり得る": "مُمْكِن",
 "あり方": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "あり様": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "あり荷": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "ある": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث. / وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى))\nمثال: وجد ياني هاتفه.",
 "あるいは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / رُبَّمَا, مِن اَلْمُمْكِن",
 "あるかぎり": "كُلّ, جَمِيع",
 "あるがまま": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "あるき": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "あるきだす": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "あるく": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "あるしゅ": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "あるじ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "あるたけ": "كَامِل / كُلّ",
 "あるだけ": "كَامِل / كُلّ",
 "あるとき": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "あるに": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "あるは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "あるひ": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟",
 "あるひと": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "あるべき": "مِثَالِيّ",
 "ある人": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "ある日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟",
 "ある時": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "ある種": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "ある限り": "كُلّ, جَمِيع",
 "あれ": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛ / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "あれい": "دُمْبِل",
 "あれえ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "あれくるう": "جُنَّ (أَظْلَمَ أو غَطَّى بظلام؛ سَتَرَ أو غَطَّى شيئًا) / حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "あれた": "مُتَوَحِّش / بَرِّيّ",
 "あれち": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "あれっ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "あれどめ": "مَرْهَم, زَبْدَة",
 "あれの": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "あれへん": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "あれもよう": "عَاصِف",
 "あれよあれよ": "فَجْأَةً",
 "あれら": "أُولَٰئِكَ, تِلْكَ / هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "あれー": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "あわ": "فُقَّاعَة",
 "あわい": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / مُدَّة / بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "あわがたつ": "فُقَّاعَة",
 "あわく": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / أَهْمَلَ / إِهْمَال",
 "あわさる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "あわす": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "あわせ": "ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "あわせいた": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "あわせて": "إِضَافَةً عَلى ذٰلِكَ",
 "あわせめ": "مُشْتَرَك / مِفْصَل",
 "あわせる": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "あわただしい": "مَشْغُول / سَرِيع",
 "あわたてき": "مِخْفَقَة",
 "あわだち": "رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة.",
 "あわだつ": "فُقَّاعَة",
 "あわだてき": "مِخْفَقَة",
 "あわだてる": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "あわだてクリーム": "قِشْدَة مَخْفُوقة",
 "あわてふためく": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "あわてる": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر. / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "あわひめ": "عامل بالجنس, عاملة بالجنس (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "あわび": "أُذُن اَلْبَحْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "あわぶく": "فُقَّاعَة",
 "あわぶろ": "جَاكُوزِي",
 "あわや": "تَقْرِيبًا",
 "あわよい": "مُنَاسِب, مُلَائِم",
 "あわれ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / بَائِس / وَا حَسْرَتَاه, وَاهًا",
 "あわれがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "あわれげ": "حَزِين, زعلان / مُحْزِنٌ",
 "あわれみ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "あわれむ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "あん": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "あんあん": "غَامِق, دَاكِن",
 "あんあんのうちに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "あんあんり": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "あんい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "あんうつ": "سَوْدَاوِيَّة",
 "あんえい": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "あんおん": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "あんか": "رَخِيص / ضَحِل",
 "あんかん": "اِسْتَرْخَى / غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "あんがい": "مُفَاجِئ",
 "あんがと": "شُكْرًا",
 "あんがとう": "شُكْرًا",
 "あんがど": "شُكْرًا",
 "あんき": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "あんきりょく": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "あんぎゃ": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "あんぐ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "あんけつ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "あんけん": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية. / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / إِيذَان, إِعْلَان",
 "あんこ": "مَلَأَ / تَبْطِين",
 "あんこう": "مُغَفَّل, أَحْمَق",
 "あんこく": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
