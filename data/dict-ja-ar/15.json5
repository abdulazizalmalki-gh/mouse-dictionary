 "ほうえんこう": "غَالِينَا",
 "ほうおう": "بَابَا\nمثال: لا تكتب بالحبر. / بُوذَا, بُدّ",
 "ほうおうけん": "البابوية (حكومة الكنيسة الرومانية الكاثوليكية)",
 "ほうおうざ": "فِينِيكْس, فُقْنُس",
 "ほうおうちょう": "الكوريا, الكوريا الرومانية ((الكنيسة الرومانية الكاثوليكية) الإدارة المركزية التي تحكم الكنيسة الرومانية…)",
 "ほうおうぼく": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق…)",
 "ほうおう座": "فِينِيكْس, فُقْنُس",
 "ほうおん": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ:…)\nمثال: شكر ياني أسرته. / تفضل, خدمة (عمل يتسم باللطف والتفضل)\nمثال: كانت النتيجة في صالحه",
 "ほうか": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟ / إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر / فَنَار / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون) / رَدْب / خَلِيَّة, قَفِير / مُحَامٍ, مُحَامِيَة / التزام حرفي بالقانون, قانونية حرفية (الامتثال الصارم لحرفية القانون بدلاً من روحه) / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / كُرْسِيّ, قَنْدَاق (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي. / لفافة (ضمادة مغلفة)",
 "ほうかい": "اِنْهَار\nمثال: يوشك الجسر على الانهيار. / نَخْر / مَرْفَأ, مَرْسَى / كَوْن, الْكَوْن / إبادة, محق (تدمير شامل)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية",
 "ほうかいせき": "كالسيت (معدن شائع يتكون من كربونات الكالسيوم المتبلورة؛ مكون رئيسي للحجر الجيري)",
 "ほうかいむえん": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "ほうかがく": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ほうかきょう": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "ほうかく": "زَائِر / هَائِم",
 "ほうかざい": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ほうかしきえん": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار…)",
 "ほうかしょう": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "ほうかだいがくいん": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "ほうかつ": "إدراج, تضمين (عملية التضمين)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ほうかつてき": "شَامِل, شَامِلَة",
 "ほうかはん": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ほうかはんにん": "مفتعل حرائق (مجرم يشعل النار في الممتلكات بشكل غير قانوني)",
 "ほうかへき": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "ほうかま": "مَهْوُوس بِإِشْعال الحَرائِق (شخص لديه هوس بإشعال النيران في الأشياء)",
 "ほうかん": "زَوْرَق مِدْفَعِيَّة / ديادم / دَلِيل, كُتَيِّب / قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / كُومِيدْيَان",
 "ほうかんがいこう": "دبلوماسية الزوارق الحربية, سياسة القوة (دبلوماسية تهدد فيها الدول باستخدام القوة لتحقيق أهدافها)",
 "ほうが": "تَبَرُّع, هِبَة / اِنْتَاش / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "ほうがい": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "ほうがき": "وَصْفَة طِبِّيَّة, وَصْفَة",
 "ほうがく": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة / طَرِيقَة, مِنْهَج / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうがくし": "بكالوريوس في القانون (درجة في القانون مدتها ثلاث سنوات)",
 "ほうがくしゃ": "حاكم, قاضي (مسؤول عام مخول بالفصل في المسائل المعروضة على محكمة العدل)",
 "ほうがくぶ": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "ほうがこうしん": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ほうがん": "مُفَتِّش, مُفَتِّشَة / إدراج, تضمين (عملية التضمين)\nمثال: جسم احتوائي في سيتوبلازم الخلية / كرة مدفع (مقذوف صلب كان يُطلق في العصور القديمة من مدفع) / طَلَقَة, طَلَق / شَبَك, شَبَكَة",
 "ほうがんし": "ورق رسم بياني (ورق يحتوي على خطوط للسماح برسم الرسوم البيانية)",
 "ほうがんてき": "جامع, شامل (يشمل الكثير أو كل شيء؛ ويشمل بشكل خاص الحدود المذكورة)\nمثال: شكل فني شامل",
 "ほうがんなげ": "رَمْيُ الجُلَّة",
 "ほうき": "هِجْرَان, هُجْرَان / تَشْرِيع\nمثال: ما معنى كلمة \"شريعة\"؟ / مِكْنَسَة, مِقْشَة / ثَوْرَة, عِصْيَان",
 "ほうきぎ": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف)",
 "ほうきぐさ": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف)",
 "ほうきせい": "تَنْظِيم",
 "ほうきたけ": "وَرْدِيُّ الطَّرَف ((لِلوَرَقَةِ) ذَاتُ طَرَفٍ وَرْدِيِّ اللَّوْن)",
 "ほうきぼし": "مُذَنَّب",
 "ほうきむし": "دودة حدوية (حيوان خنثوي يشبه الدودة يعيش في طين قاع البحر)",
 "ほうきゃく": "زَائِر",
 "ほうきゅう": "رَاتِب, أَجْر / اِنْتِقَام / ثَوْل (بدا فيه الجنون)",
 "ほうきゅうせいかつしゃ": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "ほうきょう": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "ほうき星": "مُذَنَّب",
 "ほうぎゅう": "بقر الهند, زيبو (ثور مستأنس له سنام على الظهر وقرون طويلة ولبب كبير؛ يستخدم بشكل رئيسي كحيوان جر…)",
 "ほうぎょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مَحْفُوظ بِالمِلْح, مُمَلَّح ((خَاصَّةً عَنِ اللُّحُوم) مَحْفُوظ فِي المِلْح)",
 "ほうぎょく": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ほうけい": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة) / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "ほうけいさんえん": "بوروسيليكات (ملح لأحماض البوريك والسيليسيليك)",
 "ほうけいしゅじゅつ": "خِتَان",
 "ほうけん": "إِقْطَاعِيَّة / تَفَانٍ",
 "ほうけんしゅぎ": "إِقْطَاعِيَّة",
 "ほうけんしょう": "طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله)",
 "ほうけんせい": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع…)",
 "ほうけんせいど": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع…)",
 "ほうけんてき": "إِقْطَاعِيّ",
 "ほうけんりょうしゅ": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "ほうげ": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه)",
 "ほうげい": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "ほうげき": "بومباردون (مزمار كبير؛ عضو الباس في عائلة المزمار)",
 "ほうげん": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "ほうげんがく": "عِلْم اللَّهْجَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ほうこ": "خَزِينَة\nمثال: インターネットはこの上なく貴重な情報の宝庫だ。 — الإنترنت مصدرُ معلوماتٍ لا يقدر بثمن. / كنز مكتشف (أي مجموعة من الأشياء الثمينة التي يتم اكتشافها)\nمثال: كان كتابها كنزاً من الأفكار الجديدة",
 "ほうこう": "خدمة عامة, وظيفة حكومية (التوظيف ضمن نظام حكومي (خاصة في الخدمة المدنية)) / اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / أَرِيج, عَبِير\nمثال: هذا العطر يجعلني أشعر بالمرض. / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خَيَّاط, خَيَّاطَة / مِدْفَعِيّة",
 "ほうこうかんかく": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "ほうこうかんねん": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "ほうこうきん": "عضلة خياطية (عضلة في الفخذ تساعد على تدوير الساق في وضع الجلوس الذي يتخذه الخياط؛ أطول عضلة…)",
 "ほうこうざい": "أَرِيج, عَبِير",
 "ほうこうしじき": "إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "ほうこうせい": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / اتجاهية (خاصية كون الشيء موجهاً أو يحافظ على اتجاه معين)\nمثال: اتجاهية الكتابة الإنجليزية من اليسار إلى اليمين / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ほうこうぞくかごうぶつ": "مركب عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات)",
 "ほうこうぞくせい": "عطرية (خاصية امتلاك أريج)",
 "ほうこうぞくたんかすいそ": "هيدروكربون عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات…)",
 "ほうこうたんちき": "محدد الاتجاه (راديو؛ يحدد اتجاه موجات الراديو القادمة)",
 "ほうこうだ": "دَفَّة, سُكَّان",
 "ほうこうづけ": "إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً)",
 "ほうこうづける": "مُبَاشِر\nمثال: تبدو شاحب الوجه.",
 "ほうこうてんかん": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "ほうこうにん": "خَادِم, خَادِمَة",
 "ほうこうへんい": "تَذَبذُب, تَقَلُّب",
 "ほうこうゆ": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "ほうこうりょうほう": "علاج بالروائح (الاستخدام العلاجي للمستخلصات النباتية العطرية والزيوت الأساسية في الحمامات أو…)",
 "ほうこく": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي. / وَطَنِيَّة, مَحَبَّةْ وَطَن / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "ほうこくかい": "استخلاص معلومات, تقرير مهمة (تقرير عن مهمة أو واجب)",
 "ほうこくかん": "مقرر (مسجل تعينه لجنة لإعداد تقارير الاجتماعات)",
 "ほうこくしゃ": "مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "ほうこくしょ": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "ほうこくしょぎょう": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ほうこん": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "ほうご": "يَابَانِيّ",
 "ほうごう": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / تَصْرِيف, تَصْرِيف فِعْل / اِحْتَضَنَ, عَانَقَ",
 "ほうごうし": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً)",
 "ほうごうたい": "مَقْرُون, مُتَرَافِق ((فِي الكِيمِيَاء العُضْوِيَّة) يَحْتَوِي عَلَى رَابِطَتَيْن مُزْدَوِجَتَيْن…)",
 "ほうさく": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "ほうさん": "حمض البوريك (أي من الأحماض المختلفة التي تحتوي على البورون والأكسجين) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ほうさんえん": "بورات (ملح أو إستر لحمض البوريك)",
 "ほうさんちゅう": "شعاعي (أوالي ذات أجسام تشبه الأميبا وأقدام كاذبة خيطية شعاعية)",
 "ほうし": "خِدْمَة / أُقْنُوم / بوغ (جسم تكاثري لاجنسي صغير عادة ما يكون وحيد الخلية تنتجه العديد من النباتات غير…)\nمثال: يتكون البوغ الجنسي بعد اندماج الأمشاج / إِحْسَان / إِبَاحِيّ / مِدْحَة, إِثْنَاء / سَاحِر / حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا…)",
 "ほうしかつどう": "عمل تطوعي محبب (عمل منتج يتم إنجازه طوعاً دون مكافأة مادية أو تعويض)",
 "ほうしき": "صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうししゃ": "خَادِم, خَادِمَة / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "ほうししょくぶつ": "بَوْغِيّ, حَامِلٌ لِلْأَبْوَاغِ (يَحْمِلُ الأَبْوَاغَ بَدَلًا مِنْ إِنْتَاجِ البُذُورِ)",
 "ほうしたい": "طور بوغي, نابت بوغي (الفرد أو الطور المنتج للأبواغ في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "ほうしだんたい": "نادي الخدمة العسكرية (مركز ترفيهي لرجال الخدمة العسكرية)",
 "ほうしっこう": "إنفاذ القانون (ضمان طاعة القوانين)",
 "ほうしのう": "كيس الأبواغ, محفظة بوغية (عضو يحتوي على الأبواغ أو ينتجها)",
 "ほうしのうぐん": "بثرة بوغية, كويمة بوغية (مجموعة من الحوافظ البوغية عادة على الجانب السفلي لسعفة السرخس)",
 "ほうしめ": "شماسة (امرأة برتبة شماس)",
 "ほうしゃ": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / كُرْسِيّ, قَنْدَاق (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي. / أَجْر, مُكَافَأَة (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة. / بَوْرَق",
 "ほうしゃあつ": "ضغط الإشعاع (الضغط الدقيق الذي يمارس على سطح عمودي على اتجاه انتشار الموجة)",
 "ほうしゃかいへん": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "ほうしゃかがく": "كيمياء إشعاعية, كيمياء نووية (كيمياء المواد المشعة)",
 "ほうしゃきん": "أكتينوميسيس, شعية (رميات تعيش في التربة وطفيليات نباتية وحيوانية مسببة للأمراض)",
 "ほうしゃく": "صك الإقطاع (في ظل النظام الإقطاعي، الصك الذي بموجبه يُمنح الشخص أرضاً مقابل تعهد بالخدمة)",
 "ほうしゃけい": "راديومتر, مقياس الإشعاع (مقياس للكشف عن الطاقة الإشعاعية وقياسها (كهرومغناطيسية أو صوتية))",
 "ほうしゃじょう": "شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك)\nمثال: حرارة إشعاعية",
 "ほうしゃせい": "مُشِعّ (يظهر أو ناتج عن النشاط الإشعاعي)\nمثال: نظير مشع",
 "ほうしゃせいたんそ": "كربون 14, كربون مشع (نظير مشع للكربون)",
 "ほうしゃせいたんそねんだいそくてい": "تأريخ بالكربون المشع (تَسْجِيْل التَارِيْخ)",
 "ほうしゃせいたんそねんだいそくていほう": "تأريخ بالكربون المشع (تَسْجِيْل التَارِيْخ)",
 "ほうしゃせいどういかく": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "ほうしゃせいどういげんそ": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "ほうしゃせいどういたい": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "ほうしゃせいはいきぶつ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "ほうしゃせいぶっしつ": "مادة مشعة (مادة ذات نشاط إشعاعي)",
 "ほうしゃせいほうかい": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "ほうしゃせいほうかいけいれつ": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "ほうしゃせん": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ほうしゃせんいがく": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو…)",
 "ほうしゃせんかい": "طَبِيب أَشِعَّة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "ほうしゃせんかんじゅせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "ほうしゃせんがく": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو…)",
 "ほうしゃせんぎし": "مصور أشعة (شخص يقوم بعمل صور الأشعة)",
 "ほうしゃせんせいぶつがく": "بيولوجيا إشعاعية (فرع علم الأحياء الذي يدرس تأثيرات الإشعاع على الكائنات الحية)",
 "ほうしゃせんそくていき": "كاشف الجسيمات (حجرة يمكن فيها جعل الجسيمات مرئية)",
 "ほうしゃせんちりょう": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "ほうしゃせんびょう": "داء الإشعاع, متلازمة الإشعاع (متلازمة ناتجة عن التعرض للإشعاع المؤين (مثل التعرض للمواد الكيميائية المشعة أو…)\nمثال: كان يعاني من الإشعاع",
 "ほうしゃせんぶんかい": "تحلل إشعاعي (تفكك جزيئي ناتج عن الإشعاع)",
 "ほうしゃせんりょうほう": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "ほうしゃそうしょう": "تناظر شعاعي (خاصية التناظر حول محور)\nمثال: نجم البحر يوضح التناظر الشعاعي",
 "ほうしゃのう": "إشعاع, نشاط إشعاعي (الانبعاث التلقائي لتيار من الجسيمات أو الأشعة الكهرومغناطيسية في الاضمحلال…) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / مادة مشعة (مادة ذات نشاط إشعاعي)",
 "ほうしゃのうひょうしき": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "ほうしゃのうマーク": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "ほうしゃエネルギー": "طاقة إشعاعية (طاقة تنتقل في شكل إشعاع (كهرومغناطيسي)؛ طاقة توجد في غياب المادة)",
 "ほうしゅ": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية) / حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "ほうしゅう": "أَجْر, مُكَافَأَة (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة.",
 "ほうしゅく": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "ほうしゅつ": "إصدار, انبعاث (فعل الإصدار؛ التسبب في التدفق للخارج)\nمثال: خروج الصديد / أَطْلَقَ سَرَاح, حَرَّرَ / بزوغ السن (ظهور السن عند اختراقه اللثة)\nمثال: اندلاع الأعمال العدائية",
 "ほうしゅつおん": "صوت قذفي (نوع من الصوامت في بعض اللغات، مثل الهوسا، يُنتج عن طريق الإطلاق المفاجئ للضغط…)",
 "ほうしゅん": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة.",
 "ほうしょ": "تَذْكار",
 "ほうしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء. / إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم / سَلِيبَة / عِلَاوَة / إِطْرَائِيّ, ثَنَائِيّ (مَلِيء بالثناء أو يُقَدِّم المديح) / مُكَافَأَة, ثَوَاب / مِدْحَة, إِثْنَاء",
 "ほうしょうきん": "مُكَافَأَة, ثَوَاب / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة)",
 "ほうしょうひ": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة)",
 "ほうしょく": "أُخْدُود (أخْدُودُ) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة…)",
 "ほうしょくてん": "جوهرجي, صائغ (شخص يعمل في مجال بيع المجوهرات)",
 "ほうしょくひん": "حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة…)",
 "ほうしりょう": "رسم الخدمة (نسبة مئوية من الفاتورة (كما في فندق أو مطعم) تضاف كدفع للخدمة)",
 "ほうしん": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية) / رَاحَة, تَخْفِيف / سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة. / إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى…) / حَلَأ, هِرْبِس (حلأ الجلد: قشره؛ حلأ: ضرب) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح) / تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي)",
 "ほうしんじょうたい": "تحديق في النجوم (مراقبة النجوم)",
 "ほうじ": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة / مِدْحَة, إِثْنَاء / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما)\nمثال: قبل تبليغ الاستدعاء / سَاحِر",
 "ほうじしんごう": "إشارة الوقت (إشارة (خاصة إلكترونية أو لاسلكية) تشير إلى الوقت الصحيح بدقة)",
 "ほうじゅう": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم",
 "ほうじゅつ": "المدفعية, علم المدفعية (المدافع مجتمعة) / طَرِيقَة, مِنْهَج / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "ほうじゅつか": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية)",
 "ほうじゅん": "وافِر, وَفِير / برخامة, بنعومة (بطريقة رخيمة)",
 "ほうじょ": "مُسَاعَدَة, إِمْدَاد / تحريض, حث (الفعل اللفظي للحث)",
 "ほうじょう": "خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل. / حويصلي (من أو يتعلق بالحويصلات أو يتضمنها)\nمثال: تنفس حويصلي طبيعي / مَعْبَد",
 "ほうじょうきたい": "حمل عنقودي, رحى عدارية (شذوذ أثناء الحمل؛ تتحلل الزغابات المشيمية حول الجنين وتشكل عناقيد من أكياس…)",
 "ほうじょうのつの": "قرن الوفرة (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة…)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "ほうじょどうし": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو…)",
 "ほうじる": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / أَطَاعَ / شَوَى, صَلَى / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "ほうじん": "كرش (مصطلحات عامية للكرش أو البطن البارز) / مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "ほうじんか": "إدماج, دمج (التضمين عن طريق الدمج)",
 "ほうじんそしきにする": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "ほうすい": "تَصْرِيف / خُرْطُوم مَاءٍ, خُرْطُوم / ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته) / هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها) / هَايْدْرَات",
 "ほうすいかん": "أنبوب صرف, أنبوب نفايات (أنبوب يتم من خلاله نقل السوائل بعيداً)",
 "ほうすいき": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار…)",
 "ほうすいけい": "هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها)",
 "ほうすいしゃ": "شاحنة مياه (شاحنة صهريج تستخدم لنقل وتوزيع المياه)",
 "ほうすいじゅう": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض…)",
 "ほうすいじょ": "قَادِس",
 "ほうすいほう": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض…)",
 "ほうすいクロラール": "هيدرات الكلورال (دواء بلوري عديم اللون يستخدم كمهدئ؛ يهيج المعدة ويمكن أن يسبب الإدمان)",
 "ほうする": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "ほうず": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "ほうずき": "حرنكش, كرز أرضي",
 "ほうずる": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / أَطَاعَ / شَوَى, صَلَى / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "ほうせい": "تَشْرِيع\nمثال: ما معنى كلمة \"شريعة\"؟ / استقامة, نزاهة (الصلاح الناتج عن كون الشخص شريفاً وصادقاً) / خِيَاطَة, حِيَاكَة / مُعَالَجَة",
 "ほうせいか": "تشريع, سن القوانين (عملية سن أو تشريع القوانين)",
 "ほうせいしんぎかい": "مجلس تشريعي (هيئة تشريعية مكونة من مجلس واحد)",
 "ほうせいど": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ほうせいび": "تَشْرِيع\nمثال: ما معنى كلمة \"شريعة\"؟",
 "ほうせき": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ほうせきしょう": "صَائِغ, صَائِغَة",
 "ほうせきてん": "تاجر مجوهرات, متجر مجوهرات (شركة تبيع وتشتري المجوهرات)",
 "ほうせきばこ": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى)",
 "ほうせつ": "إدراج, تضمين (عملية التضمين)\nمثال: جسم احتوائي في سيتوبلازم الخلية / إدراج, تضمين (دمج شيء ما تحت فئة أكثر عمومية)",
 "ほうせん": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ほうせんか": "بَلْسَم, مَرْهَم",
 "ほうせんきん": "أكتينوميسيت, شعية (أي بكتيريا (بعضها ممرض للإنسان والحيوان) تنتمي إلى رتبة الشعيات)",
 "ほうせんきんしょう": "داء الشعيات (مرض يصيب الماشية ويمكن أن ينتقل إلى البشر؛ ينتج عن العدوى بالشعيات؛ يتميز…)",
 "ほうせんちゅう": "مِسَلَّة",
 "ほうそ": "بُورُون / تَذْكار",
 "ほうそう": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء / إِذَاعَة / مهنة المحاماة, نقابة المحامين (مجموعة الأفراد المؤهلين لممارسة القانون في ولاية قضائية معينة)\nمثال: تم قبوله في نقابة المحامين في نيو جيرسي / جُدَرِيّ / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر) / خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل)",
 "ほうそうい": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو…)\nمثال: كان زيري يرتدي قلنسوة.",
 "ほうそういん": "مُذِيع, مُذِيعَة",
 "ほうそうえん": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار…)",
 "ほうそうきょく": "محطة بث (محطة مجهزة لبث البرامج الإذاعية أو التلفزيونية)",
 "ほうそうげき": "دراما إذاعية, مسرح إذاعي (أداء درامي صوتي بحت يبث على الراديو)",
 "ほうそうし": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "ほうそうしきえん": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار…)",
 "ほうそうしつ": "إِسْتُودِيُو",
 "ほうそうしゃ": "إِذَاعَة",
 "ほうそうじかん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "ほうそうだいがく": "تعليم مستمر (برنامج تعليمي مصمم بشكل أساسي للطلاب البالغين الذين يشاركون بدوام جزئي) / الجامعة المفتوحة (جامعة بريطانية مفتوحة للأشخاص الذين ليس لديهم مؤهلات أكاديمية رسمية ويكون…)",
 "ほうそうようじんこうえいせい": "سيزيوم (عنصر فلزي ناعم فضي أبيض قابل للسحب (سائل في درجات الحرارة العادية))",
 "ほうそうわく": "فترة زمنية, فسحة زمنية (وقت مخصص في جدول أو أجندة)\nمثال: البرنامج التلفزيوني لديه موعد بث جديد",
 "ほうそく": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうそくせい": "اطِّرَاد, انْتِظَام (صفة الاتصاف بمبدأ ثابت أو معدل ثابت)\nمثال: كان مشهوراً بانتظام عاداته",
 "ほうぞう": "اِحْتَوَى, تَضَمَّنَ / بيت الكنز (مستودع للكنوز)",
 "ほうたい": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية / ضِمَادَة, عِصَابَة",
 "ほうたいけい": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ほうたん": "جرأة, لفت للنظر (صفة البروز بقوة وبشكل مميز)\nمثال: لم أصدق وقاحتها",
 "ほうだい": "ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "ほうだて": "قائم النافذة (شريط رأسي غير هيكلي بين مصاريع أو ألواح النافذة (أو ألواح الشاشة))",
 "ほうだん": "صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة.",
 "ほうち": "مَعْلُومَات, مَعْلُومَة / أَهْمَلَ / إقْطَاعَة",
 "ほうちき": "إِنْذَار",
 "ほうちく": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "ほうちしゃかい": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "ほうちしゅぎ": "دستورية (الدعوة لنظام حكم وفقاً لمبادئ دستورية)",
 "ほうちゃく": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "ほうちゅう": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو…)\nمثال: سامي في المطبخ. / كيسة مائية (كيس مملوء بسائل؛ يتشكل نتيجة لغزو يرقات الديدان الشريطية)",
 "ほうちゅうしょう": "داء المشوكات, كيسات عذرية (الإصابة بيرقات المشوكات (الديدان الشريطية))",
 "ほうちょう": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "ほうちょうし": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "ほうちょうじゃ": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "ほうちょうにん": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "ほうっておく": "تَجَاهَلَ, طَنَّش",
 "ほうっと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً)\nمثال: شعروا بالخسارة بعمق",
 "ほうづえ": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل)\nمثال: كان يرتدي دعامة على ركبته",
 "ほうてい": "قَانُونِيّ / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / إِرَاءَة",
 "ほうていがいこうきょうぶつ": "ممتلكات عامة (ممتلكات تملكها الحكومة)",
 "ほうていきゅうじつ": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "ほうていごうかん": "مُجَامَعَة قَاصِر",
 "ほうていしき": "مُعَادَلَة (المُوَازَنَة؛ في الرِيَاضِيَّات: هي مسألة مُتَوَازِنَة فيها طرفين كل واحد منهما…)",
 "ほうていじゅんびりつ": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على…)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "ほうていすいていそうぞくにん": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ほうていそうぞくにん": "وريث شرعي (الشخص المخول قانوناً بوراثة ممتلكات شخص يموت دون وصية)",
 "ほうていだいりにん": "ممثل قانوني (ممثل شخصي ذو صفة قانونية (مثل التوكيل الرسمي أو منفذ الوصية))",
 "ほうていつうか": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "ほうていでんせんびょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "ほうていねんれい": "السن القانوني, سن الرشد (السن الذي يعتبر فيه الأشخاص مؤهلين لإدارة شؤونهم الخاصة)",
 "ほうていぶじょく": "اِزْدِرَاء المَحْكَمَة (عدم احترام قواعد محكمة قانونية)",
 "ほうていぶじょくざい": "اِزْدِرَاء المَحْكَمَة (عدم احترام قواعد محكمة قانونية)",
 "ほうてき": "قَانُونِيّ / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "ほうてきこうい": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق…)",
 "ほうてきそち": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق…)",
 "ほうてきてつづき": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية)",
 "ほうてきぶんしょ": "سند, صك قانوني ((في القانون) وثيقة تنص على علاقة تعاقدية أو تمنح حقاً ما)",
 "ほうてん": "دَلِيل, كُتَيِّب",
 "ほうでん": "إطلاق نار (فعل إطلاق النار من بندقية) / تفريغ كهربائي (تفريغ للكهرباء) / قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "ほうでんかこう": "تفريغ كهربائي (تفريغ للكهرباء)",
 "ほうでんとう": "مصباح تفريغ (مصباح يولد الضوء عن طريق تفريغ كهربائي بين قطبين في غاز)",
 "ほうと": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "ほうとう": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران)",
 "ほうとうか": "فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً)",
 "ほうとうむすこ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "ほうとうもの": "فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً)",
 "ほうど": "حَيِّز / إقْطَاعَة / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط)\nمثال: هواوي جنة على الأرض.",
 "ほうどう": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي. / إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "ほうどうかんけいしゃ": "الصحافة, وسائل الإعلام الإخبارية (الصحف والمجلات مجتمعة)",
 "ほうどうきかん": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "ほうどうきしゃ": "صَحَفِيّ, صَحَفِيَّة\nمثال: لن أنس مراسلة أمي.",
 "ほうどうし": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو…)",
 "ほうどうじん": "فيلق صحفي, مجموعة صحفية (مجموعة من الصحفيين يمثلون منشورات مختلفة يغطون جميعاً نفس المواضيع)\nمثال: الفيلق الصحفي للبيت الأبيض / مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "ほうどうのじゆう": "حُرِّيَّة اَلصِّحَافَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "ほうどうはん": "فيلق صحفي, مجموعة صحفية (مجموعة من الصحفيين يمثلون منشورات مختلفة يغطون جميعاً نفس المواضيع)\nمثال: الفيلق الصحفي للبيت الأبيض",
 "ほうどうばんぐみ": "برنامج إخباري, نشرة أخبار (برنامج مخصص للأحداث الجارية، غالباً ما يستخدم المقابلات والتعليقات)\nمثال: نشاهد أخبار الساعة السابعة كل ليلة",
 "ほうにょう": "تبول (إخراج البول) / خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل.",
 "ほうにん": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "ほうねつ": "تبديد الحرارة (تبديد الحرارة)",
 "ほうねつき": "مِشْعاع",
 "ほうねつせい": "تبديد الحرارة (تبديد الحرارة)",
 "ほうねつばん": "مبدد حراري (موصل معدني مصمم خصيصاً لتوصيل (وإشعاع) الحرارة)",
 "ほうのあみ": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうのう": "تَفَانٍ",
 "ほうのき": "مَغْنُولِيَة",
 "ほうのしはい": "سيادة القانون (حالة من النظام تتوافق فيها الأحداث مع القانون)",
 "ほうのもとのびょうどう": "المساواة أمام القانون (الحق في الحماية المتساوية للقوانين)",
 "ほうの木": "مَغْنُولِيَة",
 "ほうはい": "عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / أريمة (مرحلة مبكرة من الجنين تنتج عن انقسام البويضة؛ كرة مملوءة بالسائل يتكون جدارها…) / حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط)",
 "ほうはいくう": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "ほうはいこう": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "ほうはく": "دكتوراه في القانون (درجة قانون فخرية) / لاندغريف (كونت كان له ولاية قضائية على منطقة كبيرة في ألمانيا في العصور الوسطى)",
 "ほうばい": "رَفِيق, رَفِيقَة",
 "ほうひ": "قَلْفَة, غُرْلَة / إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "ほうひせつだん": "خِتَان",
 "ほうび": "مُكَافَأَة, ثَوَاب",
 "ほうびょう": "زَهْرِيَّة",
 "ほうふ": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / وافِر, وَفِير",
 "ほうふく": "اِنْتِقَام / روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "ほうふくかんぜい": "تعريفة انتقامية (تعريفة تفرض على كيان تجاري أجنبي كشكل من أشكال الرد الانتقامي)",
 "ほうふくしゅぎ": "اِنْتِقَامِيَّة",
 "ほうふくそち": "عَمَل اِنْتِقَامِيّ (عمل انتقامي ضد عدو في زمن الحرب)",
 "ほうふつ": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "ほうふん": "مُسَطَّح القِمَّة (له سطح علوي مسطح أو مُستوٍ)",
 "ほうぶつ": "قَطْعِيّ مُكَافِئ (ذو شكل القَطْع المكافئ)",
 "ほうぶつせん": "قَطْعٌ مُكَافِئ, شَلْجَمِيّ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "ほうぶつめん": "مجسم قطع مكافئ (سطح له مقاطع مكافئة موازية لمحور إحداثي واحد ومقاطع بيضاوية متعامدة مع ذلك…)",
 "ほうぶる": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "ほうぶん": "يَابَانِيّ",
 "ほうぶんか": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي)",
 "ほうへい": "مِدْفَعِيّة",
 "ほうへいきゅう": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ほうへん": "نَقْد, اِنْتِقَاد",
 "ほうべん": "أَطْلَقَ سَرَاح, حَرَّرَ / طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية)\nمثال: وسيلة للسيطرة",
 "ほうほう": "طَرِيقَة, مِنْهَج / بِارْتِبَاك, بِتَشَوُّش (بطريقة مرتبكة)\nمثال: كتبت له الملكة أوغوستا رسالة هستيرية تعاطفت معه فيها بارتباك",
 "ほうほうがく": "مَنْهَج",
 "ほうほうてき": "إِجْرَائِيّ, شَكْلِيّ (يتعلق بممارسة المحكمة والإجراءات بدلاً من مبادئ القانون)\nمثال: القانون الإجرائي",
 "ほうほうのてい": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة)",
 "ほうほうの体": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة)",
 "ほうほうろん": "مَنْهَج",
 "ほうぼう": "هُنَا وَهُنَاكَ\nمثال: 観光名所をほうぼう訪ね歩いたので、すっかり疲れ果ててしまった。 — زيارة جميع المعالم السياحية حقاً ترهقني كثيراً . / السمكة الطيارة, روبن البحر (غرنار أمريكي؛ يوجد غالباً في الخلجان ومصبات الأنهار) / خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل)",
 "ほうぼく": "حشيش, كلأ (طعام ضخم الحجم مثل العشب أو التبن للخيول أو الماشية التي ترعى)",
 "ほうぼくじょう": "مَرْعًى, مَسْرَح",
 "ほうぼくち": "أرض رعي, مرعى (حقل مغطى بالعشب أو النباتات وصالح لرعي الماشية)",
 "ほうまく": "غِشاءُ البَوْغ, غِطَاء (غشاء يحيط بالأبواغ النامية ويحميها، خاصة ذلك الذي يغطي البثرات البوغية في السرخس)",
 "ほうまつ": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "ほうまつがいしゃ": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "ほうまつてき": "مُؤَقَّت, سَريع الزوال",
 "ほうまつむげん": "مُؤَقَّت, سَريع الزوال",
 "ほうまん": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي / شَبَع",
 "ほうむかん": "قاضٍ عسكري, محامٍ عسكري (ضابط أركان يعمل كمستشار قانوني لقائد عسكري) / بريتور, قاضٍ روماني (قاضٍ منتخب سنوياً في الجمهورية الرومانية القديمة)",
 "ほうむそうかん": "محامٍ عام للقضاء العسكري (المستشار القانوني الأقدم لفرع من فروع الجيش)",
 "ほうむり": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "ほうむる": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "ほうめい": "أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "ほうめん": "أَطْلَقَ سَرَاح, حَرَّرَ / اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "ほうめんたい": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة…)\nمثال: هل كان في الجيش.",
 "ほうもう": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうもち": "قُرْبَان",
 "ほうもつ": "كَنْز / قُرْبَان",
 "ほうもつこ": "بيت الكنز (مستودع للكنوز)",
 "ほうもつでん": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "ほうもん": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / مَزْغَل",
 "ほうもんかんご": "الرِعَايَة المَنْزِلِيَّة",
 "ほうもんきゃく": "طَازَج (طَازَج وَجَدِيد)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "ほうもんぎ": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "ほうもんさき": "وِجْهَة, وُجْهَة",
 "ほうもんしゃ": "زَائِر",
 "ほうもんち": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ほうもんはんばい": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "ほうもんナース": "ممرضة زائرة (ممرضة تتقاضى أجراً لزيارة المرضى في منازلهم)",
 "ほうゆう": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / إدراج, تضمين (عملية التضمين)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ほうゆうぶつ": "إدراج, تضمين (عملية التضمين)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ほうよう": "تَحَمُّل / إدراج, تضمين (عملية التضمين)\nمثال: جسم احتوائي في سيتوبلازم الخلية / اِحْتَضَنَ, عَانَقَ / صَقَارَة / قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها)",
 "ほうようりょく": "تَحَمُّل",
 "ほうよく": "خُصُوبَة",
 "ほうらい": "تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان.",
 "ほうらいしだ": "شعر الزهرة, كزبرة البئر (سرخس كزبرة البئر الرقيق بسيقان أوراق سوداء لامعة رفيعة؛ عالمي الانتشار)",
 "ほうらいしょう": "جبنة سويسرية",
 "ほうらく": "اِنْهَار\nمثال: يوشك الجسر على الانهيار. / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع))\nمثال: الإبحار هو هوايتها المفضلة",
 "ほうらくせん": "مُغَلَّف, لِفَافَة",
 "ほうらつ": "إِبَاحِيّ",
 "ほうらん": "حِضَانَة, تَفْرِيخ / بيض السمك, سرء (كتلة البيض التي تضعها الأسماك أو البرمائيات أو الرخويات) / أَوْجٌ, ذُرْوَةٌ",
 "ほうり": "مبدأ قانوني, مبدأ قضائي ((قانون) مبدأ يقوم عليه صياغة الفقه القانوني) / أَنَانَاس",
 "ほうりがく": "إجْتِهَاد, فِقْه",
 "ほうりこみ": "رَمْيَةُ تَمَاسّ",
 "ほうりこむ": "رَمْيَةُ تَمَاسّ",
 "ほうりだす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا! / طَرَدَ, أَقَالَ",
 "ほうりっぱなし": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "ほうりつ": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうりつあん": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "ほうりつか": "مُحَامٍ, مُحَامِيَة",
 "ほうりつがく": "إجْتِهَاد, فِقْه",
 "ほうりつがくしゃ": "مُحَامٍ, مُحَامِيَة",
 "ほうりつこうい": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق…)",
 "ほうりつこん": "شَرْعًا, قَانُونِيًّا (بموجب القانون؛ مطابق للقانون)\nمثال: نحن متزوجان قانونياً الآن",
 "ほうりつじむしょ": "شركة محاماة, مكتب محاماة (شركة من المحامين)",
 "ほうりつじょう": "قَانُونِيّ",
 "ほうりつせいど": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ほうりつてき": "قَانُونِيّ",
 "ほうりなげる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "ほうりゃく": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "ほうりゅう": "إطلاق نار (فعل إطلاق النار من بندقية) / إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما)\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "ほうりょう": "مُرَبَّعُ الشَّكْلِ (على هيئة المربّع)",
 "ほうりんこう": "فَالُون غُونْغ, فَالُون دَافَا",
 "ほうる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / أَهْمَلَ",
 "ほうるい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ほうれい": "قانون تشريعي, نظام أساسي (قانون تم تمريره من قبل هيئة تشريعية) / غَنِيّ / الْجَمَاهِير, العَامَّةُ / تبريد, نظام تبريد (آلية للحفاظ على برودة شيء ما)\nمثال: كان التبريد عبارة عن مراوح سقفية",
 "ほうれいじゅんしゅ": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "ほうれいせん": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية)",
 "ほうれい線": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية)",
 "ほうれつ": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ)\nمثال: مركب عضوي عطري / ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "ほうれつかんぱん": "سطح المدافع (سابقاً أي سطح غير السطح المكشوف يحتوي على مدافع من أوله لآخره)",
 "ほうれんそう": "سَبَانِخ, إِسْفَانَاخ",
 "ほうれん草": "سَبَانِخ, إِسْفَانَاخ",
 "ほうろう": "تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به / مِينَاء",
 "ほうろうしつ": "مِينَاء",
