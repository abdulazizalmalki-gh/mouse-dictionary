{
 "びらん性": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ…)",
 "びらん性ガス": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد)",
 "びり": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "びりけつ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "びりっと": "شَاقّ, مُمَزِّق (يُشْبِه صَوْت تَمْزِيق عَنِيف كَصَوْت البَرْق المُشَقِّق لِلسَّمَاء)",
 "びりびり": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد)\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "びりゅう": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد) / حبيبة (حبة صغيرة جداً)",
 "びりゅうし": "خلية دم, كريّة دم (أي من نوعي الخلايا (خلايا الدم الحمراء والبيضاء) وأحياناً تشمل الصفائح الدموية)",
 "びりょうげんそ": "عنصر زهيد, عنصر نزر (عنصر يوجد بكميات صغيرة جداً في الجسم ولكنه مهم للعديد من العمليات البيولوجية) / عناصر زهيدة, مغذيات دقيقة (مادة يحتاجها الجسم بكميات صغيرة فقط للقيام بوظائفه الطبيعية (مثل الفيتامينات أو…)",
 "びりょうようそ": "عناصر زهيدة, مغذيات دقيقة (مادة يحتاجها الجسم بكميات صغيرة فقط للقيام بوظائفه الطبيعية (مثل الفيتامينات أو…)",
 "びりを蹴る": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)",
 "びるいかん": "قناة أنفية دمعية (قناة تحمل الدموع من الكيس الدمعي إلى التجويف الأنفي)",
 "びれい": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "びろう": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة / ثر أنفي, سيلان الأنف (إفراز مخاطي مائي مستمر من الأنف (كما في نزلات البرد))",
 "びろく": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "びろびろ": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "びわ": "بَشْمَلَة, أَسْكِيدُنْيَا",
 "びわくせい": "كُوَيْكِب أَوْلِيّ (واحد من العديد من الأجرام السماوية الصلبة الصغيرة التي يعتقد أنها كانت موجودة…)",
 "びわほうし": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية)",
 "びん": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل)\nمثال: سرقوا زجاجة نبيذي! / طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر. / بَرِيد / فُرْصَة / سَرِيع\nمثال: ينبح كلب في الحي.",
 "びんいり": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل)\nمثال: سرقوا زجاجة نبيذي!",
 "びんかつ": "سرعة (معدل سريع)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "びんかん": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "びんがた": "قَارُورِيّ الشَّكْل (على شكل قارورة)",
 "びんぎ": "مُلَاءَمَة, مُنَاسَبَة",
 "びんぎゅう": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "びんご": "بينغو, لوتو (لعبة يتم فيها سحب كرات مرقمة عشوائياً ويغطي اللاعبون الأرقام المقابلة على…)",
 "びんごおもて": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "びんさつ": "تَعَاطُف",
 "びんざさら": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "びんしょう": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة) / سَرِيع\nمثال: ينبح كلب في الحي.",
 "びんしょうせい": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "びんしょうりょく": "براعة يدوية, خفة يد (البراعة في استخدام اليدين)",
 "びんじょうしゃ": "مسافر متطفل (شخص يسافر بالحصول على رحلات مجانية من السيارات المارة)",
 "びんじょうしゅぎしゃ": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان)",
 "びんせん": "ورق كتابة (مادة ورقية مصنعة في شكل أوراق رقيقة بحجم مناسب لتقبل الحبر؛ تستخدم لكتابة…)",
 "びんぜん": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "びんそく": "سرعة (معدل سريع)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "びんた": "صَفْعَة, لَطْمَة\nمثال: صفع المدرس مؤخرتي.",
 "びんちょう": "مُرْتَفِع الدَّرَجَة / باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً…)",
 "びんちょうずみ": "مُرْتَفِع الدَّرَجَة",
 "びんちょうたん": "مُرْتَفِع الدَّرَجَة",
 "びんつけ": "مَرْهَم, بُومَادَة",
 "びんつけあぶら": "مَرْهَم, بُومَادَة",
 "びんづめ": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل)\nمثال: سرقوا زجاجة نبيذي!",
 "びんなが": "باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً…)",
 "びんびん": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "びんべん": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "びんぼう": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "びんぼうくさい": "بَالٍ",
 "びんぼうくじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه…)\nمثال: عندي ابنا خالة.",
 "びんぼうにん": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "びんぼうひまなし": "هُنَاكَ, يُوجَدُ",
 "びんぼうゆすり": "تَمَلْمَلَ",
 "びんぼうゆるぎ": "تَمَلْمَلَ",
 "びんめい": "رَقْمَ الرِحْلةِ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "びんらん": "دَلِيل, كُتَيِّب / اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "びんりょう": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "びんろう": "فوفل, نخيل التنبول (نخيل من جنوب شرق آسيا يحمل مكسرات التنبول (فاكهة قرمزية أو برتقالية وحيدة…) / فَوْفَل",
 "びんろうじ": "جوز الأريكا, جوز التنبول (بذرة نخيل التنبول؛ تمضغ مع أوراق فلفل التنبول والجير كمنشط هضمي ومخدر في جنوب…) / فَوْفَل",
 "びんろうじゅ": "فوفل, نخيل التنبول (نخيل من جنوب شرق آسيا يحمل مكسرات التنبول (فاكهة قرمزية أو برتقالية وحيدة…) / فَوْفَل",
 "びんわん": "قُدْرَة, مَقْدِرَة",
 "びん乱": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "びカタル": "غَمَص",
 "ぴいちくぱあちく": "تَغْرِيدَة / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "ぴいぴい": "اختلاس النظر, تلصص (نظرة سرية) / فَقِير / إِسْهَال / نَاي",
 "ぴえん": "أَحْزَنَ ((أَحْزَنَ) الْمَكَان: حزن وَيُقَال: أَحْزَن بهم الْمنزل: نبا بهم؛ (أَحْزَنَ)…)",
 "ぴかいち": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "ぴかっと": "بتألق, بسطوع\nمثال: تألقت النجوم بسطوع",
 "ぴかどん": "قُنْبُلَة ذَرِّيَّة",
 "ぴかぴか": "نَظِيف",
 "ぴかぴかひかる": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع)\nمثال: كان في عينيه بريق",
