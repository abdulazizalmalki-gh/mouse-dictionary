 "ふどうさんかんてい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんがいしゃ": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんぎょう": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんぎょうかい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんぎょうしゃ": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "ふどうさんしゅとくぜい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんたんぽしょうけん": "ورقة مالية مدعومة بالرهن العقاري (ورقة مالية تنشأ عند تجميع مجموعة من القروض العقارية وبيع السندات لمؤسسات أخرى أو للجمهور؛ يتلقى المستثمرون جزءاً من مدفوعات الفائدة على القروض…)",
 "ふどうさんとうき": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんとうきほう": "أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "ふどうさんほけん": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんや": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "ふどうしょうすうてんすう": "عَدَد بِفَاصِلَة عَيْمَة, عَدَد حَقِيقِيّ عائِم (عدد ممثل بتدوين الفاصلة العائمة)",
 "ふどうしん": "برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: أدى برباطة جأش المخضرمين",
 "ふどうたい": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "ふどうとく": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "ふどうのどうしゃ": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "ふどうり": "سَخَافَة",
 "ふどし": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "ふな": "شبوط كروشي (شبوط أوروبي يشبه إلى حد كبير السمكة الذهبية البرية)",
 "ふなあか": "ماء الآسن (الماء المتجمع في قاع السفينة)",
 "ふなあし": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "ふなあそび": "إبحار باليخوت, ركمجة (السفر المائي للمتعة)",
 "ふないくさ": "معركة بحرية (معركة ضارية بين أساطيل بحرية) / بَحْرِيَّة / كُحْلِيّ",
 "ふなうた": "أغنية المراكبي, باركارول (أغنية قوارب يغنيها جندوليو البندقية)",
 "ふなおさ": "ربان, قبطان (الضابط البحري الذي يتولى قيادة سفينة عسكرية) / ربان, قبطان (ضابط مرخص له بقيادة سفينة تجارية) / طالب متغيب (طالب يفشل في حضور الفصول الدراسية) / مراكبي (رجل يقود أو يركب قارباً)",
 "ふなか": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "ふなかた": "مراكبي (رجل يقود أو يركب قارباً)",
 "ふながかり": "أَنْكُورِيج",
 "ふながた": "زَوْرَقِيّ الشَّكْل (على شكل زَورق) / عظم زورقي (أكبر عظام الرسغ على جانب الإبهام)",
 "ふなくいむし": "دودة السفن (ذوات صدفتين بحرية تشبه الدودة تحفر في الأرصفة الخشبية والسفن بواسطة أصداف تشبه المثقاب)",
 "ふなくらべ": "سباق القوارب (سباق بين أشخاص يجدفون أو يقودون القوارب)",
 "ふなぐら": "مرفأ قوارب (سقيفة على حافة نهر أو بحيرة؛ تستخدم لتخزين القوارب) / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "ふなけん": "سباق القوارب (سباق بين أشخاص يجدفون أو يقودون القوارب)",
 "ふなごや": "مرفأ قوارب (سقيفة على حافة نهر أو بحيرة؛ تستخدم لتخزين القوارب)",
 "ふなじ": "رِحْلَة",
 "ふなそこ": "جَمَّة, إِنْكِلِيَّة",
 "ふなぞこ": "جَمَّة, إِنْكِلِيَّة",
 "ふなたび": "رِحْلَة",
 "ふなだいく": "بناء السفن, نجار سفن (نجار يساعد في بناء وإطلاق السفن الخشبية)",
 "ふなだな": "تبليط بالألواح الخشبية (عمل تغطية منطقة بألواح خشبية) / أرضية خشبية, تبليط خشبي ((بحرياً) غطاء أو أرضية مصنوعة من الألواح الخشبية (كما في السفينة)) / ألواح خشبية (الألواح الخشبية بشكل جماعي؛ كمية من الألواح)",
 "ふなだまり": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة) / رسوم الرسو (رسم للإرساء)",
 "ふなちん": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "ふなつき": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "ふなつきば": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "ふなづみ": "بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "ふなどめ": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "ふなに": "حُمُولَة, شِحْنَة",
 "ふなにしょうけん": "بُولِيصَةُ شَحْنٍ",
 "ふなぬし": "مالك السفينة (شخص يمتلك سفينة أو حصة في سفينة)",
 "ふなのり": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "ふなはし": "جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "ふなば": "رَصِيف",
 "ふなばし": "جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "ふなばた": "حافة المركب, طراد (اللوح العلوي لجانب القارب؛ أعلى ألواح السفينة الخشبية)",
 "ふなばら": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "ふなびと": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "ふなびん": "بريد سطحي, بريد عادي (بريد يتم إرساله عن طريق البر أو البحر)",
 "ふなべり": "حافة المركب, طراد (اللوح العلوي لجانب القارب؛ أعلى ألواح السفينة الخشبية)",
 "ふなまんじゅう": "مُنْخَفِض الدَّرَجَة",
 "ふなやど": "وكيل شحن بحري (وكيل مالك السفينة)",
 "ふなよい": "دُوَار اَلْبَحْر, مَيْد (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "ふなれ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "ふなわたし": "مُعَدِّيَة, عَبَّارَة / سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "ふにあい": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "ふにおちない": "غير مقنع, واهٍ (ليس مقنعاً) / غَيْر مُقْنِع, مُسْتَبْعَد (ذو احتمالية منخفضة جداً لا تبعث على التصديق)\nمثال: حجة واهية",
 "ふにおちる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "ふにく": "جِيفة, فَطِيسَة",
 "ふにふに": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ふにゃっ": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "ふにゃふにゃ": "ترهل, رخاوة (ليونة مترهلة) / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام)",
 "ふにゃり": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "ふにょう": "خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل. / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / ثراء لوني, غنى (حيوية عميقة وقوية للون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: عظمة العمارة",
 "ふにん": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "ふにんか": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "ふにんき": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "ふにんしゅじゅつ": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "ふにんしょう": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "ふにんじょう": "فَظَاظَة, قَسْوَة (الافتقار إلى التعاطف)",
 "ふにんせい": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "ふぬけ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "ふね": "سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة. / فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة",
 "ふねっしん": "لَامُبَالَاة",
 "ふねをこぐ": "نَامَ عَلَى نَفْسِهِ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "ふねんせい": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "ふねんぶつ": "غَيْر قَابِل لِلاِحْتِرَاق (غير قادر على الاشتعال والاحتراق)",
 "ふのう": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب / مُسْتَحِيل / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / عَنَانَة, عُنَّة / طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية) / نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم",
 "ふのうしゃ": "عاجز, عديم القوة (يفتقر للقوة أو القدرة) / عاجز جنسياً, عنين ((للذكر) غير قادر على الجماع)\nمثال: التكنولوجيا بلا أخلاق همجية؛ والأخلاق بلا تكنولوجيا عاجزة",
 "ふのうしょう": "عَنَانَة, عُنَّة",
 "ふのしょとくぜい": "صُغْبَة",
 "ふのすう": "عَدَد سَالِب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ふのでんか": "شحنة سالبة (وجود فائض من الإلكترونات؛ وجود جهد كهربائي أقل)",
 "ふのれんさ": "تأثير الدومينو",
 "ふのスパイラル": "حلقة مفرغة, دور منطقي (حجة تفترض صحة ما يراد إثباته) / حلقة مفرغة, دائرة خبيثة (مشكلة تؤدي إلى أخرى تفاقم الأولى)",
 "ふはい": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة / تحليل المتجهات (تحليل حقل المتجهات) / تحلل, تعفن (الظاهرة العضوية للتعفن) / تحلل, تعفن ((في البيولوجيا) عملية التحلل الناجمة عن الفعل البكتيري أو الفطري) / تحلل, تفاعل تحلل ((في الكيمياء) فصل مادة إلى مادتين أو أكثر قد تختلف عن بعضها وعن المادة الأصلية) / فَسَاد",
 "ふはいせい": "إنتاني, متقيح (يحتوي على كائنات مسببة للأمراض أو ناتج عنها) / إنتاني, تعفني (من أو يتعلق بالتعفن أو ناتج عنه)\nمثال: التهاب حلق إنتاني",
 "ふはいそう": "خزان تحليل, خزان صرف صحي (خزان كبير يتم فيه تفكيك المواد الصلبة أو مياه الصرف الصحي بواسطة البكتيريا)",
 "ふはいだらく": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / تزييف, غش (الخلط بمادة غريبة؛ ناتج الغش)",
 "ふはいぼうし": "تطهير, تعقيم (عملية تثبيط نمو وتكاثر الكائنات الحية الدقيقة) / تعقيم, خلو من الجراثيم ((للأشياء غير الحية) حالة الخلو من الكائنات الحية المسببة للأمراض)",
 "ふはく": "تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة / قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء. / متغيب, متهرب (شخص يتهرب من الواجب) / متخلف عن الحضور (ضيف يفشل في إبلاغ الفندق أو المطعم عند إلغاء الحجز)",
 "ふはつ": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ)) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث)",
 "ふはつにおわる": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ)) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث)",
 "ふばいうんどう": "قَاطَعَ / مُقَاطَعَة",
 "ふばいどうめい": "قَاطَعَ / مُقَاطَعَة",
 "ふばつ": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "ふばらい": "تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: تهربه من جميع دائنيه",
 "ふばん": "تَرْقِيم",
 "ふひ": "هدر المال (المال الذي ينفق مقابل عائد غير كاف)\nمثال: قال السناتور إن المشروع كان هدراً للمال",
 "ふひつよう": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ふひょう": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول) / شَمَنْدُورَة / عَوَّامَة / طَاقَم, طَاقِم / زَقِيطَة / طوف جليدي (كتلة مسطحة من الجليد (أصغر من الحقل الجليدي) تطفو في البحر) / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / طفو (فعل الشخص الذي يطفو على الماء) / عَائِم, مُتَنَقِّل (يَمِيلُ إِلَى التَّنَقُّلِ مِنْ مَكَانٍ لِآخَر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "ふひょうばん": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول)",
 "ふひんこう": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "ふび": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر) / سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا. / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "ふびゅうせい": "عصمة البابا (معتقد الكنيسة الكاثوليكية بأن الله يحمي البابا من الخطأ عندما يتحدث عن العقيدة أو الأخلاق)",
 "ふびょうどう": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل) / مُتَبَايِنَة\nمثال: عليك عدم الخوف.",
 "ふびん": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب) / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما) / فَقِير / مِسْكِين / فُقَرَاء",
 "ふふく": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها / سُجُود",
 "ふふくじゅう": "تَمَرُّد, عَدَم خُضُوع (فعل يتسم بالتمرد وعدم الخضوع) / تمرد, عدم انصياع (تحدي السلطة)",
 "ふふくじゅううんどう": "عِصْيان مَدَنيّ",
 "ふふごう": "نَاقَص",
 "ふふん": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ふぶき": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "ふぶん": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / شَفَهِيّ, غَيْرُ مَكْتُوب (يستخدم الكلام بدلًا من الكتابة) / عرفي, غير مدون (قائم على العرف بدلاً من التوثيق)\nمثال: قانون عرفي / أُمِّيّ",
 "ふぶんかつ": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "ふぶんほう": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "ふぶんめい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام / مُظْلِم",
 "ふぶんりつ": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "ふへい": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "ふへいこう": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ふへき": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض) / تصوينة, درابزين سور (جدار منخفض على طول حافة السطح أو الشرفة) / دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "ふへん": "نَزَاهَة, حِيَاد / أَبَدِيّ\nمثال: これ不変の真理なり。 — هذه حقيقة لا تتغير. / ثَابِت, لَا يَتَغَيَّر (لَا يَتَبَدَّلُ فِي طَبِيعَتِه) / ثَابِتٌ تَحْتَ التَّحْوِيل, مُطَّرِد (غَيْرُ مُتَأَثِّرٍ بِعَمَلِيَّةٍ أَوْ تَحْوِيلٍ مُحَدَّد) / ثابت, لامتغير (سمة (كمية أو خاصية أو دالة) تظل دون تغيير عند تطبيق تحويل معين عليها) / كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / قطعة قماش, قطعة مادة (جزء منفصل يتكون من القماش)",
 "ふへんか": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "ふへんかし": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "ふへんせい": "ثَبَات, لَا تَبَايُن (طبيعة كمية أو خاصية أو دالة تظل دون تغيير عند تطبيق تحويل معين عليها) / ثَبَات, عَدَم تَغَيُّر (صفة مقاومة التباين) / شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان)",
 "ふへんてき": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "ふへんひよう": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "ふへんふとう": "نَزَاهَة, حِيَاد",
 "ふへんりょう": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "ふべん": "إزعاج, إقلاق (صعوبة تسبب القلق) / إِزْعَاج, عَدَم رَاحَة (صفة كون الشيء غير مفيد أو غير مريح) / إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "ふべんきょう": "بطالة, تسكع (عدم القيام بعمل أو وظيفة) / بطالة, تراخ (سمة كون المرء عاطلاً بسبب العزوف عن العمل) / بُطْلَان, لَا أَسَاس (صفة الافتقار إلى الجوهر أو القيمة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "ふほ": "تَأْمِين",
 "ふほう": "غير قانوني, محظور (مخالف لـأو محظور بموجب القانون) / غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / ظَالِم, غَيْر شَرْعِيّ (لا أَساسَ لَه في القانون؛ مُخالِف لِلعَدالَة) / حَرَام, غَيْر جَائِز (غير صحيح أخلاقيًّا أو غير مسموح به)\nمثال: إجراءات غير قانونية / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / نَعْي",
 "ふほうかんきん": "احتجاز غير قانوني, حبس زائف ((قانون) الحبس بدون سلطة قانونية)",
 "ふほうこうい": "الضرر في القانون",
 "ふほうしょじ": "حيازة غير قانونية (حيازة مواد خاضعة للرقابة)",
 "ふほうしんにゅう": "انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن) / تعد على الممتلكات (تدخل غير مشروع في حيازة الممتلكات (المنقولة والعقارية)، أو الإجراء القانوني المتخذ لاسترداد التعويضات)",
 "ふほうしんにゅうしゃ": "دخيل, متطفل (شخص يقتحم خصوصية أو ممتلكات آخر دون إذن)",
 "ふほうせんきょ": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "ふほうせんきょしゃ": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "ふほうにゅうきょしゃ": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "ふほうわ": "غَيْر مُشَبَّع ((للألوان) غير نقي لونيًا؛ مخفف) / غير مشبع (يستخدم لمركب (خاصة الكربون) يحتوي على ذرات تشترك في أكثر من رابط تكافؤ واحد) / غير مشبع (ليس مشبعاً؛ قادر على إذابة المزيد من المادة عند درجة حرارة معينة)\nمثال: أحمر غير مشبع",
 "ふほうわかごうぶつ": "مركب غير مشبع (مركب كيميائي يحتوي على روابط كربون-كربون مزدوجة أو ثلاثية، مثل تلك الموجودة في الألكينات أو الألكاينات على التوالي)\nمثال: المركبات المشبعة وغير المشبعة لا تتكون بالضرورة فقط من سلسلة ذرات كربون",
 "ふほうわしぼうさん": "حمض دهني غير مشبع (حمض دهني يمكن لسلسلة الكربون الخاصة به امتصاص ذرات هيدروجين إضافية)",
 "ふほんい": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "ふほんいながら": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "ふぼ": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "ふぼう": "تَشْهِير, اِفْتِرَاء",
 "ふぼく": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "ふぼん": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "ふま": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "ふまえる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "ふまじめ": "تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "ふまん": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "ふまんぞく": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "ふまんてん": "شِكَايَة, شَكْوَى",
 "ふまんぶんし": "سَاخِط, مُتَمَرِّد (غَيْرُ رَاضٍ تُجَاهَ السُّلْطَةِ) / سَاخِط, مُتَذَمِّر (شخص غير راضٍ أو مشمئز)",
 "ふみ": "كراهية, نفور (شعور بالكراهية الشديدة) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "ふみあと": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ふみあらす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "ふみあるく": "تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / سفينة شحن متجولة (باخرة تجارية للإيجار؛ ليس لها جدول زمني منتظم) / دوس, وقع أقدام ثقيلة (وقع أقدام ثقيل) / رحالة, متجول (مسافر على الأقدام؛ شخص يذهب في نزهة طويلة (للمتعة))\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "ふみいし": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "ふみいた": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / دَوَّاسَة / قَدَمِيّ",
 "ふみいる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "ふみいれる": "دَخَلَ عَلَى (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "ふみきり": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات) / خط البداية (خط يشير إلى موقع بدء سباق أو لعبة) / عَزِيمَة",
 "ふみきりしゃだんき": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "ふみきりばん": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "ふみきる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه. / قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "ふみぐるま": "طاحونة الدوس (طاحونة تعمل بقوة الرجال أو الحيوانات الذين يمشون على حزام دائري أو يتسلقون درجات)",
 "ふみこえる": "هَزَمَ, غَلَبَ",
 "ふみこたえる": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "ふみこみ": "ركن, مقصورة (تجويف صغير يفتح على غرفة أكبر)",
 "ふみこむ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "ふみしだく": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "ふみた": "تَذْكِرَة / تذكرة / مُلْصَق, بِطَاقَة / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / وَرَقَة لَعْب, وَرَقَة",
 "ふみたおす": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "ふみたてる": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "ふみだい": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "ふみだす": "يقرب / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "ふみだん": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "ふみちがえる": "عثرة, كبوة (خطأ غير مقصود ولكنه محرج)\nمثال: تلا القصيدة كاملة دون عثرة واحدة",
 "ふみつぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "ふみつけ": "مَرْعَى, سْتِيب / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "ふみつける": "تَجَاهَلَ, طَنَّش",
 "ふみつぶす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "ふみづら": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "ふみとどまる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ふみなり": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "ふみびと": "شَاعِر, شَاعِرَة",
 "ふみふみ": "اِعْتِجَان",
 "ふみまよう": "ضَلَّ",
 "ふみめん": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "ふみもち": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "ふみやぶる": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء) / اِجْتَازَ, عَبَرَ",
 "ふみん": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "ふみんしょう": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "ふみんふきゅう": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم الْعَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ふむ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "ふむき": "غير لائق بدنياً, معتل (ليس في حالة جسدية أو عقلية جيدة؛ فاقد للياقة) / غير صالح, غير لائق (دون المعايير المطلوبة لغرض ما) / سَقيم, مَعيب (غَيْر سَليم جَسَدِيًّا؛ مُصاب بِعِلَّة)\nمثال: سمين وغير لائق بدنياً جداً",
 "ふめい": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة / مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "ふめいかく": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "ふめいよ": "خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار",
 "ふめいよじょたい": "تسريح غير مشرف, طرد من الخدمة (تسريح من القوات المسلحة بسبب جريمة خطيرة (مثل التخريب أو التجسس أو الجبن أو القتل))",
 "ふめいりょう": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "ふめいろう": "اكتئاب, تجهم (صفة الحزن المفرط والكآبة) / قتامة, كآبة (شعور بتوجس كئيب) / تجهم, قتامة (جو من الاكتئاب والحزن) / تجهم, عبوس (خاصية المظهر العابس أو المتجهم)\nمثال: سادت الكآبة المكتب / قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ) / مريب, مشكوك فيه (عرضة للتساؤل والشك)\nمثال: دوافع مشكوك فيها",
 "ふめつ": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "ふめん": "وَرَقَة اَلْمُوسِيقَى, قِطْعَة مُوسِيقِيَّة",
 "ふめんだい": "حامل النوتة الموسيقية (حامل خفيف لحمل أوراق الموسيقى المطبوعة)",
 "ふめんぼく": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "ふめんもく": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "ふもう": "خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما) / عَاقِر (لَا يُنْجِب ذُرِّيَّة؛ غَيْر قَادِر عَلَى الإِنْجَاب) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / أرض بور, أرض قاحلة (برية غير مأهولة لا تصلح للزراعة)\nمثال: الأراضي القاحلة في وسط أفريقيا / غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة / تَشْهِير, اِفْتِرَاء",
 "ふもうのち": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "ふもと": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "ふもん": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "ふもんにふす": "تَجَاهَلَ, طَنَّش",
 "ふもんにふする": "تَجَاهَلَ, طَنَّش",
 "ふやかす": "اِبْتَلَّ",
 "ふやし": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ふやす": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ふゆ": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات الحَرَارَة)\nمثال: ولد في فصل الشتاء.",
 "ふゆう": "غَنِيّ / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / طفو (فعل الشخص الذي يطفو على الماء) / عَائِم, مُتَنَقِّل (يَمِيلُ إِلَى التَّنَقُّلِ مِنْ مَكَانٍ لِآخَر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / ذُبَابَة مَايُو, ذُبَاب مَايُو (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / زوال سريع, قصر الأمد (خاصية الاستمرار لفترة قصيرة جداً)",
 "ふゆうせいぶつ": "عَوَالِق",
 "ふゆうせんこう": "تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم) / طفو (ظاهرة الطفو (البقاء على سطح السائل دون الغرق))",
 "ふゆうそう": "غَنِيّ",
 "ふゆうほう": "تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم) / طفو (ظاهرة الطفو (البقاء على سطح السائل دون الغرق))",
 "ふゆかい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "ふゆがた": "ضغط جوي / شتوي (مميز لـأو يحدث في الشتاء)\nمثال: عانى من طقس شتوي قاسي",
 "ふゆがたきあつはいち": "ضغط جوي",
 "ふゆき": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ふゆきとどき": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "ふゆごし": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات الحَرَارَة)\nمثال: ولد في فصل الشتاء.",
 "ふゆごもり": "إِسْبَات",
 "ふゆざくら": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء الزخرفية الوفيرة ولكن السامة بحجم الكرز) / فانوس صيني, كرز الشتاء (نبات معمر من العالم القديم يزرع لكأسه الورقي البرتقالي المحمر المنفوخ الزخرفي)",
 "ふゆそうび": "خربق أسود, وردة عيد الميلاد (نبات أوروبي دائم الخضرة ذو أزهار شتوية بيضاء أو أرجوانية تشبه الورد)",
 "ふゆそでん": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "ふゆねぎ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ふゆのじだい": "أوقات عصيبة (وقت تسوده الصعوبات)",
 "ふゆば": "شتاء (أبرد فصول السنة)",
 "ふゆばら": "خربق أسود, وردة عيد الميلاد (نبات أوروبي دائم الخضرة ذو أزهار شتوية بيضاء أو أرجوانية تشبه الورد)",
 "ふよ": "تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه / مَنَحَ / مِنْحة / منحة وقفية, وقف (فعل منح مصدر دخل دائم) / ملكة, موهبة (قدرات أو صفات طبيعية) / صندوق وقفي, وقف (رأس المال الذي يوفر الدخل لمؤسسة)\nمثال: جاء وقفه السخي للمختبر في الوقت المناسب تماماً",
 "ふよう": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / طفو (فعل الشخص الذي يطفو على الماء) / عَائِم, مُتَنَقِّل (يَمِيلُ إِلَى التَّنَقُّلِ مِنْ مَكَانٍ لِآخَر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُتَقَادِم, مُهْمَل (لم يعد قيد الاستعمال) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عشبة القطن, فيلاغو (أي نبات من جنس فيلاغو له عناقيد رأسية من رؤوس زهور صوفية صغيرة) / ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل؛ تزرع على نطاق واسع؛ متوطنة في جنوب شرق الولايات المتحدة) / مُسْتَعْصٍ (بلا أمل في إيجاد حلّ) / غير قابل للذوبان ((للمادة) غير قادر على الذوبان) / غير قابل للحل, مستعصٍ (لا يقبل الحل أو التفسير)\nمثال: شك غير قابل للحل / تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "ふようい": "غير مجهز, غير مستعد (دون إعداد؛ غير مستعد لـ)\nمثال: ملاحظات مرتجلة / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ふようしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "ふようじょう": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "ふようじょうほう": "زُبَالَة / نُفَايَات (بقيَّة؛ ما زاد على الحاجة) / قُمَامَة / مُخَلَّفَات\nمثال: توم عامل نفايات.",
 "ふようじん": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر) / غير آمن, محفوف بالمخاطر (يفتقر إلى الأمن أو السلامة) / غَيْرُ آمِن, مُعَرَّضٌ لِلخَطَر (غَيْرُ مَحْمِيٍّ مِنَ الهُجُوم)\nمثال: مجرم خطير",
 "ふようせい": "عدم القابلية للذوبان (خاصية عدم القابلية للذوبان وصعوبة الانحلال في السائل) / استحالة الحل, عدم قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من المستحيل حلها)",
 "ふようど": "الدبال",
 "ふようふきゅう": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ふようぶつ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ふようほう": "جَبَل فُوجِي, فُوجِي (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "ふようりょう": "نَفَقَة",
 "ふようりょく": "طَفْو, طُفُوّ",
 "ふようろん": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "ふよく": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "ふらく": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "ふらす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "ふらせる": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "ふらち": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة) / خَارِج عَن القَانُون, فَوْضَوِيّ (عاصٍ للقانون أو متمرّد عليه) / بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين)",
 "ふらちせんばん": "مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد)",
 "ふらちもの": "فَاسِق",
 "ふらっと": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "ふらつき": "خفة عقل, دوار (نقص طائش في التعقل) / دوار, دوخة (إحساس بالدوران؛ شعور بأنك على وشك السقوط)",
 "ふらつきかん": "خفة عقل, دوار (نقص طائش في التعقل) / دوار, دوخة (إحساس بالدوران؛ شعور بأنك على وشك السقوط)",
 "ふらつき感": "خفة عقل, دوار (نقص طائش في التعقل) / دوار, دوخة (إحساس بالدوران؛ شعور بأنك على وشك السقوط)",
 "ふらつく": "تَرَنُّح / تَرَنَّحَ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه / بوتر, مضرب الإسقاط (المضرب الحديدي المستخدم عادة في المنطقة الخضراء للإسقاط) / لاعب الضربة القصيرة",
 "ふらふら": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة)\nمثال: مشى مترنحاً نحو المخرج / مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل) / تَذَبْذُب, تَقَلُّب (صفة كون الشيء غير ثابت وخاضع للتغيرات) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: احتفظ بسجل لتقلبات الأسعار / بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "ふらり": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "ふらん": "حِضَانَة, تَفْرِيخ / تحليل المتجهات (تحليل حقل المتجهات) / تحلل, تعفن (الظاهرة العضوية للتعفن) / تحلل, تعفن ((في البيولوجيا) عملية التحلل الناجمة عن الفعل البكتيري أو الفطري) / تحلل, تفاعل تحلل ((في الكيمياء) فصل مادة إلى مادتين أو أكثر قد تختلف عن بعضها وعن المادة الأصلية)",
 "ふらんき": "حَاضِنَة",
 "ふらー": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)",
 "ふり": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / ادعاء, تصنع (فعل إعطاء مظهر زائف) / حجة, ذريعة (مظهر مصطنع أو مقلد) / ادِّعَاء, تَظَاهُر (صفة زائفة أو لا يمكن دعمها) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان امتثاله مجرد تظاهر / وَضْعِيَّة / سَيِّئَة / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / مطر, هطول مطري (ماء يسقط في قطرات من بخار متكثف في الغلاف الجوي) / تَنَازُلِيّ / كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "ふりあい": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ふりあおぐ": "بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "ふりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "ふりあてる": "تعيين شخص لعمل ما",
 "ふりうごかす": "هَزَّ",
 "ふりうり": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور) / بائع متجول (شخص يتجول لبيع بضائعه (كما في الشوارع أو الكرنفالات))",
 "ふりえき": "سَيِّئَة",
 "ふりおとす": "اِنْتَفَضَ",
 "ふりかえ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "ふりかえきゅうじつ": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ふりかえゆそう": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "ふりかえる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / اِلْتَفَتَ, اِسْتَدَارَ",
 "ふりかかる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "ふりかけき": "قبعة القندس (قبعة مصنوعة من فرو القندس (أو مادة مماثلة)) / عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة)",
 "ふりかけ器": "قبعة القندس (قبعة مصنوعة من فرو القندس (أو مادة مماثلة)) / عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة)",
 "ふりかざす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية.",
 "ふりかぶる": "إشهار, تلويح (فعل التلويح)",
 "ふりがな": "فُورِيغَانَا",
 "ふりきゅう": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ふりきる": "اِنْتَفَضَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ふりこ": "نُوَاس / رَقَّاص / بَنْدُول",
 "ふりこう": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "ふりこどけい": "ساعة بندولية (ساعة يتم تنظيمها بواسطة بندول)",
 "ふりすてる": "اِنْتَفَضَ",
 "ふりそそぐ": "وَابِل, مَطَر غَزِير",
 "ふりたてる": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "ふりだし": "نقطة البداية (أقرب نقطة حدية) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "ふりだしぐすり": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "ふりだす": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "ふりつ": "محافظي, ولائي (من أو متعلق بمحافظة أو ولاية (إدارية))\nمثال: متحف الولاية",
 "ふりつけ": "تَصْمِم الرَّقْص",
 "ふりつけか": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "ふりつけし": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "ふりとばす": "اِنْتَفَضَ",
 "ふりはば": "سعة, مدى (عِظَم المقدار) / جود, سعة (خاصية الوفرة الغزيرة) / سعة ((في الفيزياء) أقصى إزاحة لموجة دورية) / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ふりはらう": "اِنْتَفَضَ",
 "ふりふり": "ذُو كَشَاكِش, مُكَشْكَش (ذو كشاكش أو حواشٍ زخرفية)",
 "ふりまく": "نَثَرَ, تَفَرَّقَ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة)",
 "ふりまぜる": "هَزَّ",
 "ふりまわす": "مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية. / إِظْهَار, عَرْض / شَاشَة / تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ふりまわる": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "ふりむく": "اِلْتَفَتَ, اِسْتَدَارَ",
 "ふりむける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / مُنَاسِب / لَائِق",
 "ふりゅう": "أَنَاقَة / انجراف, تسكع (تجوال بلا هدف من مكان لآخر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "ふりょ": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب) / أَسِير الْحَرْب, أَسِير (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "ふりょう": "سَيِّئ, وحش / مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد) / مُقَصِّر, مُهْمِل (يُخِلّ بِمَا يَقْتَضِيه الوَاجِب) / جَانِح, مُخَالِف (مذنب بارتكاب مخالفة أو جُنحة) / جانح, حدث جانح (مذنب شاب)",
 "ふりょうか": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / اتضاع, انحطاط (حالة متدنية أو منكسرة)\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "ふりょうかしつけ": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "ふりょうけん": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "ふりょうこうい": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه",
 "ふりょうこういしょうねん": "جانح, حدث جانح (مذنب شاب)",
 "ふりょうさいけん": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "ふりょうしょうじょ": "جانح, حدث جانح (مذنب شاب)",
 "ふりょうしょうねん": "جانح, حدث جانح (مذنب شاب)",
 "ふりょうどうたい": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "ふりょく": "أَمْوَال, ثَرْوَة / طَفْو, طُفُوّ",
 "ふりょしゅうようじょ": "مخيم اعتقال, معسكر أسرى الحرب (معسكر لأسرى الحرب)",
 "ふりわけ": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "ふりわける": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "ふりをする": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "ふりん": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "ふりんあいて": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "ふりんざい": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "ふり仮名": "فُورِيغَانَا",
 "ふる": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة. / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة / رش, نثر (فعل رش أو طرطشة الماء) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ふるい": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة. / طَوِيل / مِنْ زَمَن بَعِيد (ينتمي إلى زمن غابر ومضى) / بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت / رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "ふるいおこす": "تجنيد إجباري, خدمة إلزامية (الخدمة العسكرية الإلزامية) / تجمع عسكري, طابور (تجمع للأفراد العسكريين للخدمة)\nمثال: أُلقي به في السجن لتغيبه عن التجمع",
 "ふるいおとす": "اِنْتَفَضَ",
 "ふるいかん": "أنبوب غربالي (أنبوب يتكون من خلايا متصلة من طرف لآخر تتدفق من خلالها العناصر الغذائية في النباتات الزهرية والطحالب البنية)",
 "ふるいつく": "اِحْتِضَان, حَضْن / عَانَقَ, اِحْتَضَنَ",
 "ふるいにかける": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "ふるいに掛ける": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "ふるいぶ": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية)",
 "ふるいわける": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "ふるい分ける": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "ふるい落す": "اِنْتَفَضَ",
 "ふるい落とす": "اِنْتَفَضَ",
 "ふるい起こす": "تجنيد إجباري, خدمة إلزامية (الخدمة العسكرية الإلزامية) / تجمع عسكري, طابور (تجمع للأفراد العسكريين للخدمة)\nمثال: أُلقي به في السجن لتغيبه عن التجمع",
 "ふるう": "اِرْتَجَفَ, اِقْشَعَّرَ / تجنيد إجباري, خدمة إلزامية (الخدمة العسكرية الإلزامية) / تجمع عسكري, طابور (تجمع للأفراد العسكريين للخدمة)\nمثال: أُلقي به في السجن لتغيبه عن التجمع / تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / تَمْرِين, تَدْرِيب / تَمَرَّنَ / جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق / غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / اِخْتَارَ",
 "ふるえ": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)",
 "ふるえあがる": "هَزَّ",
 "ふるえおん": "تَكْرِير",
 "ふるえる": "اِرْتَجَفَ, اِقْشَعَّرَ",
 "ふるえ音": "تَكْرِير",
 "ふるかぶ": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "ふるがね": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "ふるき": "سَمُّور / قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "ふるきず": "نَدْبَة, نَدْب",
 "ふるきつね": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "ふるきよきじだい": "الزَّمَن الجَمِيل",
 "ふるぎつね": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "ふるぎや": "عَقْرَب ثَوَانِي",
 "ふるく": "في العصور القديمة, قديماً (في الأزمنة القديمة؛ منذ زمن بعيد)\nمثال: اهتمام بما قد حدث قديماً / أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "ふるくさい": "بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "ふるさと": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / خَرَاب, خَرَابَة / دَمَّرَ",
 "ふるだぬき": "مُحَارِب قَدِيم",
 "ふるった": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "ふるって": "بحيوية, بنشاط (بطريقة نشطة)",
 "ふるつわもの": "مُحَارِب قَدِيم",
 "ふるづか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "ふるて": "بَالٍ / مُحَارِب قَدِيم / قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "ふるてつ": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "ふるとし": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "ふるどうぐ": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "ふるびと": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "ふるふる": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "ふるぼけた": "بَالٍ",
 "ふるまい": "سُلُوك, تَصَرُّف / تَرْفِيه, تَسْلِيَة",
 "ふるまう": "تَصَرَّفَ / تَصَرَّفَ بِشَكْل, مُؤَدَّب",
 "ふるめかしい": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "ふるもの": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "ふるものいち": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "ふるわす": "هَزَّ",
 "ふるわせる": "هَزَّ",
 "ふるわない": "كَلِيل",
 "ふれ": "مَنْسُور, مُنَادَاة / لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "ふれあい": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "ふれあいどうぶつえん": "حديقة حيوانات أليفة (مجموعة من الحيوانات الأليفة مخصصة للأطفال لملاطفتها وإطعامها)",
 "ふれあいひろば": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "ふれあい動物園": "حديقة حيوانات أليفة (مجموعة من الحيوانات الأليفة مخصصة للأطفال لملاطفتها وإطعامها)",
 "ふれあい広場": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "ふれあう": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "ふれい": "تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه / مَنْسُور, مُنَادَاة",
 "ふれこむ": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "ふれさせる": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "ふれとり": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "ふれはば": "سعة, مدى (عِظَم المقدار) / جود, سعة (خاصية الوفرة الغزيرة) / سعة ((في الفيزياء) أقصى إزاحة لموجة دورية) / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ふれまわる": "تَلْفَزَة, إِذَاعَة / أَذَاعَ, بَثَّ",
 "ふれる": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة) / ذَكَرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / اِنْتَهَكَ / تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة",
 "ふれんぞく": "مُتَقَطِّع",
 "ふれんぞくせい": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "ふれんぞくせん": "جَبْهَة / أَمَامِيّ",
 "ふれんぞくてん": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "ふれ合い": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "ふれ回る": "تَلْفَزَة, إِذَاعَة / أَذَاعَ, بَثَّ",
 "ふろ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟ / حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "ふろう": "غير مستحق, غير مكتسب (لم يتم الحصول عليه عن طريق الجدارة أو العمل أو الخدمة)\nمثال: قبل المكافآت غير المكتسبة التي جاءت في طريقه وكذلك النقد غير المستحق / تسكع, تشرد (حالة التجوال من مكان إلى آخر؛ عدم وجود منزل دائم أو وسيلة للعيش) / كَابِر / بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله) / خَمَان",
 "ふろうしゃ": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "ふろうしょとく": "إيراد غير مكتسب ((محاسبة) دخل تم استلامه ولكن لم يتم اكتسابه بعد (يعتبر عادة التزاماً حالياً في الميزانية العمومية للشركة)) / دخل غير مكتسب (دخل شخصي لم تكسبه (على سبيل المثال، أرباح الأسهم أو الفوائد أو دخل الإيجار))",
 "ふろうじ": "طفل شوارع (طفل يقضي معظم وقته في الشوارع خاصة في المناطق العشوائية)",
 "ふろうせん": "نبع الشباب (نبع يوصف في الحكايات الشعبية بأنه قادر على إعادة الشباب للناس)\nمثال: اكتشف بونس دي ليون فلوريدا أثناء بحثه عن نبع الشباب",
 "ふろうにん": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "ふろうふし": "خُلُود",
