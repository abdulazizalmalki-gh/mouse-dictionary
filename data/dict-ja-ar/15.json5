{
 "びらん性": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / تَآكُلِيّ, حَاتّ (يُزِيلُ المَوَادَّ بِالِاحْتِكَاكِ التَّدْرِيجِيِّ)",
 "びらん性ガス": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "びり": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "びりけつ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "びりっと": "شَاقّ, مُمَزِّق (يُشْبِه صَوْت تَمْزِيق عَنِيف كَصَوْت البَرْق المُشَقِّق لِلسَّمَاء) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "びりびり": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / إرباً, قطعاً (إلى أجزاء أو قطع) / بعيداً عن بعض, متباعدين (منفصلين أو على مسافة في المكان أو الزمان) / التمييز بينهما, عن بعضهما (واحداً عن الآخر)\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "びりゅう": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد) / حبيبة (حبة صغيرة جداً)",
 "びりゅうし": "خلية دم, كريّة دم (أي من نوعي الخلايا (خلايا الدم الحمراء والبيضاء) وأحياناً تشمل الصفائح الدموية) / ذرة, هباءة ((الاستخدام غير التقني) قطعة صغيرة جداً من أي شيء)",
 "びりょうげんそ": "عنصر زهيد, عنصر نزر (عنصر يوجد بكميات صغيرة جداً في الجسم ولكنه مهم للعديد من العمليات البيولوجية) / عناصر زهيدة, مغذيات دقيقة (مادة يحتاجها الجسم بكميات صغيرة فقط للقيام بوظائفه الطبيعية (مثل الفيتامينات أو المعادن))",
 "びりょうようそ": "عناصر زهيدة, مغذيات دقيقة (مادة يحتاجها الجسم بكميات صغيرة فقط للقيام بوظائفه الطبيعية (مثل الفيتامينات أو المعادن))",
 "びりを蹴る": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)",
 "びるいかん": "قناة أنفية دمعية (قناة تحمل الدموع من الكيس الدمعي إلى التجويف الأنفي)",
 "びれい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "びろう": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة / ثر أنفي, سيلان الأنف (إفراز مخاطي مائي مستمر من الأنف (كما في نزلات البرد))",
 "びろく": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "びろびろ": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "びわ": "بَشْمَلَة, أَسْكِيدُنْيَا",
 "びわくせい": "كُوَيْكِب أَوْلِيّ (واحد من العديد من الأجرام السماوية الصلبة الصغيرة التي يعتقد أنها كانت موجودة في مرحلة مبكرة من تطور النظام الشمسي)",
 "びわほうし": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية) / مؤدي عروض المنستريل, منشد متجول (مؤدٍ في عروض المنستريل (عروض موسيقية وكوميدية قديمة))",
 "びん": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي! / طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر. / بَرِيد / بريد / فُرْصَة / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "びんいり": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "びんかつ": "سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "びんかん": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "びんがた": "قَارُورِيّ الشَّكْل (على شكل قارورة)",
 "びんぎ": "مُلَاءَمَة, مُنَاسَبَة",
 "びんぎゅう": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "びんご": "بينغو, لوتو (لعبة يتم فيها سحب كرات مرقمة عشوائياً ويغطي اللاعبون الأرقام المقابلة على بطاقاتهم)",
 "びんごおもて": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "びんさつ": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "びんざさら": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "びんしょう": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة) / رَشِيق الذِّهْن, سَرِيعُ الْبَدِيهَة (سريع الفهم والاستيعاب ذهنيًّا) / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "びんしょうせい": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "びんしょうりょく": "براعة يدوية, خفة يد (البراعة في استخدام اليدين)",
 "びんじょうしゃ": "مسافر متطفل (شخص يسافر بالحصول على رحلات مجانية من السيارات المارة)",
 "びんじょうしゅぎしゃ": "انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان) / انتهازي, وصولي (شخص يفضل المصلحة الشخصية والوسائل النفعية على المبادئ)",
 "びんせん": "ورق كتابة (مادة ورقية مصنعة في شكل أوراق رقيقة بحجم مناسب لتقبل الحبر؛ تستخدم لكتابة المراسلات والمخطوطات)",
 "びんぜん": "مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "びんそく": "سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "びんた": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "びんちょう": "مُرْتَفِع الدَّرَجَة / باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً ولها زعانف صدرية طويلة؛ توجد في جميع أنحاء العالم في المياه الاستوائية…) / الباكور, تونة بيضاء (تونة صغيرة نسبياً ذات لحم أبيض فاخر؛ مصدر رئيسي للتونة المعلبة)",
 "びんちょうずみ": "مُرْتَفِع الدَّرَجَة",
 "びんちょうたん": "مُرْتَفِع الدَّرَجَة",
 "びんつけ": "مَرْهَم, بُومَادَة",
 "びんつけあぶら": "مَرْهَم, بُومَادَة",
 "びんづめ": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "びんなが": "باكور, تونة بيضاء (تونة كبيرة تعيش في عرض البحر وهي مصدر معظم التونة المعلبة؛ تصل إلى 93 رطلاً ولها زعانف صدرية طويلة؛ توجد في جميع أنحاء العالم في المياه الاستوائية…) / الباكور, تونة بيضاء (تونة صغيرة نسبياً ذات لحم أبيض فاخر؛ مصدر رئيسي للتونة المعلبة)",
 "びんびん": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "びんべん": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "びんぼう": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "びんぼうくさい": "بَالٍ",
 "びんぼうくじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "びんぼうにん": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "びんぼうひまなし": "هُنَاكَ, يُوجَدُ",
 "びんぼうゆすり": "تَمَلْمَلَ",
 "びんぼうゆるぎ": "تَمَلْمَلَ",
 "びんめい": "رَقْمَ الرِحْلةِ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "びんらん": "دَلِيل, كُتَيِّب / اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "びんりょう": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "びんろう": "فوفل, نخيل التنبول (نخيل من جنوب شرق آسيا يحمل مكسرات التنبول (فاكهة قرمزية أو برتقالية وحيدة البذرة بقشرة ليفية)) / فَوْفَل",
 "びんろうじ": "جوز الأريكا, جوز التنبول (بذرة نخيل التنبول؛ تمضغ مع أوراق فلفل التنبول والجير كمنشط هضمي ومخدر في جنوب شرق آسيا) / فَوْفَل",
 "びんろうじゅ": "فوفل, نخيل التنبول (نخيل من جنوب شرق آسيا يحمل مكسرات التنبول (فاكهة قرمزية أو برتقالية وحيدة البذرة بقشرة ليفية)) / فَوْفَل",
 "びんわん": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "びん乱": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "びカタル": "غَمَص / رَمَص ((رَمِصَتِ) العينُ: اجتمع في مُوقِها وَسَخٌ أبيضُ. ويقال: (رَمِصَ) فلانٌ فهو أرْمَصُ، وهي رَمْصاءُ. والجمع: رُمْصٌ)",
 "ぴいちくぱあちく": "تَغْرِيدَة / غَرَّدَ / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "ぴいぴい": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير) / فَقِير / مِسْكِين / فُقَرَاء / إِسْهَال / نَاي / أُخْدُود (أخْدُودُ)",
 "ぴえん": "أَحْزَنَ ((أَحْزَنَ) الْمَكَان: حزن وَيُقَال: أَحْزَن بهم الْمنزل: نبا بهم؛ (أَحْزَنَ) فُلَان: صَار فِي الْحزن)",
 "ぴかいち": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "ぴかっと": "بتألق, بسطوع\nمثال: تألقت النجوم بسطوع",
 "ぴかどん": "قُنْبُلَة ذَرِّيَّة",
 "ぴかぴか": "نَظِيف / نضيف / نَظَّفَ",
 "ぴかぴかひかる": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع) / بريق, لمعان (المرح المعبر عنه ببريق أو لمعان أو حيوية في الوجه) / تألق, تلألؤ (حدوث وميض صغير أو شرارة)\nمثال: كان في عينيه بريق",
 "ぴかぴか光る": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع) / بريق, لمعان (المرح المعبر عنه ببريق أو لمعان أو حيوية في الوجه) / تألق, تلألؤ (حدوث وميض صغير أو شرارة)\nمثال: كان في عينيه بريق",
 "ぴかり": "بتألق, بسطوع\nمثال: تألقت النجوم بسطوع",
 "ぴか一": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "ぴくつく": "زِيَار",
 "ぴくぴく": "ارتعاش, نفضة (تشنج عضلي مفاجئ؛ خاصة الناتج عن حالة عصبية)",
 "ぴくぴくうごく": "رَعَشَة / يرتعش / يهز",
 "ぴくぴく動く": "رَعَشَة / يرتعش / يهز",
 "ぴこぴこ": "بِاخْتِصَار",
 "ぴしっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم / بِدِقَّة",
 "ぴしゃっぴしゃっ": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ぴしゃぴしゃ": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ぴしゃり": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح)",
 "ぴしゃん": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح)",
 "ぴたっと": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / بِالضَّبْط, تَمَامًا / بِالْضَبْط / فَجْأَةً",
 "ぴたぴた": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف / عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / سطوة, سيادة (تأثير مسيطر)",
 "ぴたり": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / بِالضَّبْط, تَمَامًا / بِالْضَبْط / فَجْأَةً / بِإِتْقَان, تَمَامًا",
 "ぴちっと": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام",
 "ぴちぴち": "جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / جَسُور, شُجَاع (يُظهر شجاعة وإقدامًا وروحًا قتاليّة) / انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "ぴちゃっ": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "ぴちゃぴちゃ": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح)",
 "ぴちゃん": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي) / خبطة, صفقة (ارتطام قوي يصدر صوتاً عالياً) / ارتطام, صفع (الضجيج الناتج عن الارتطام القوي لجسمين) / اكتساح, سلام (الفوز بجميع الحيل أو جميعها باستثناء واحدة في لعبة البريدج)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "ぴっ": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / حقيبة مستندات (حقيبة أوراق مستطيلة وضحلة) / ملحق (متخصص معين ضمن طاقم بعثة دبلوماسية)",
 "ぴっかぴか": "نَظِيف / نضيف / نَظَّفَ",
 "ぴっしり": "بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً / بشكل كاف (إلى درجة كافية)\nمثال: كانت طليقة بشكل كاف في الماندرين",
 "ぴったし": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / بِالضَّبْط, تَمَامًا / بِالْضَبْط / فَجْأَةً / بِإِتْقَان, تَمَامًا",
 "ぴったり": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / بِالضَّبْط, تَمَامًا / بِالْضَبْط / فَجْأَةً / بِإِتْقَان, تَمَامًا",
 "ぴっちぴち": "جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / جَسُور, شُجَاع (يُظهر شجاعة وإقدامًا وروحًا قتاليّة) / انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "ぴっちぴっち": "جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / جَسُور, شُجَاع (يُظهر شجاعة وإقدامًا وروحًا قتاليّة) / انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران",
 "ぴっちり": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام",
 "ぴっとり": "بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً",
 "ぴゅう": "أزيز (صوت طنين أو هسهسة كما لشيء ينتقل بسرعة عبر الهواء) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)\nمثال: سمع أزيز الرصاص قرب رأسه",
 "ぴゅっ": "بَخَّ, نَضَحَ (بلل بدفقة من السائل) / بخ, دفق (حدوث تصريف مفاجئ (لسائل))\nمثال: بخ الجدار بالماء / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "ぴゅん": "أزيز (صوت طنين أو هسهسة كما لشيء ينتقل بسرعة عبر الهواء) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)\nمثال: سمع أزيز الرصاص قرب رأسه",
 "ぴょこぴょこ": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس / بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "ぴょん": "بخفة, برشاقة (بطريقة رشيقة وسريعة)\nمثال: يتسلق برشاقة بوابة حديدية",
 "ぴょーん": "بخفة, برشاقة (بطريقة رشيقة وسريعة)\nمثال: يتسلق برشاقة بوابة حديدية",
 "ぴよぴよなく": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير)",
 "ぴよぴよ鳴く": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير)",
 "ぴらぴら": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "ぴりから": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين) / حِرِّيف, حَارّ\nمثال: الجو حار اليوم.",
 "ぴりっと": "دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة)",
 "ぴりっとくる": "جَارِح, لَاذِع (قادر على إيلام المشاعر وجرحها) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "ぴりぴり": "بتوتر, بقلق (بطريقة عصبية وقلقة) / باضطراب, بنزق (بإثارة عصبية)\nمثال: راقبنا سوق الأسهم بتوتر",
 "ぴりり": "دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة)",
 "ぴり辛": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين) / حِرِّيف, حَارّ\nمثال: الجو حار اليوم.",
 "ぴんと": "بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام / فَوْقَ, فَوْق / لِأَعْلَى / بالبديهة, حدسياً (بطريقة حدسية)\nمثال: يبدو أن المخترعين اختاروا حدسياً مزيجاً من الأصوات المتفجرة والعدوانية كإشارات تحذير لاستخدامها في السيارات",
 "ぴんとくる": "نَقْرَة / نَقَرَ",
 "ぴんとはる": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "ぴんと張る": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "ぴんと立てる": "ديك (طائر ذكر بالغ) / ديك (ذكر الدجاج البالغ) / ديك, مطرقة (جزء من قفل البندقية يضرب كبسولة القدح عند سحب الزناد) / صنبور, محبس (صنبور يتكون من جهاز دوار لتنظيم تدفق السائل)",
 "ぴんはね": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / تهرب ضريبي بإخفاء الدخل (عدم التصريح عن الدخل لتجنب دفع الضرائب عليه) / قشط (عملية إزالة المواد الطافية من سطح سائل) / تصفح سريع, قراءة سريعة (القراءة أو إلقاء نظرة سريعة)",
 "ぴんぴん": "دَجِر / بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "ぴーちくぱーちく": "تَغْرِيدَة / غَرَّدَ / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "ぴーぴー": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير) / فَقِير / مِسْكِين / فُقَرَاء / إِسْهَال / نَاي / أُخْدُود (أخْدُودُ)",
 "ぴーまん": "فِلْفِل حُلْو, فِلْفِل رُومِيّ (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "ふ": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة. / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء. / سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي. / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / علم الأنساب (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَصِيدَة, شِعْر / سَرْدِي / قِصَّة, حِكَايَة / سَرْدِيَّة, رِوَايَة / مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى. / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / مَهَمَّة / حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم) / امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج) / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / غلوتين القمح (غلوتين محضر من القمح) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِخْتَرَقَ, نَفَذَ / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / هَاوَاي / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "ふぁぼ": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "ふあたり": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "ふあん": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ふあんかん": "كَرَب, كَآبَة (كَرَبَهُ الغَمُّ وَالهَمُّ: اشتدَّا عليه، أثقلا عليه؛ كَرَبَتْهُ المشاكِلُ: صَعُبَتْ عليه)\nمثال: كانت أسرة سامي تنتظر في كرب.",
 "ふあんげ": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "ふあんしょう": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد عرضاً بارزاً)",
 "ふあんしょうがい": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد عرضاً بارزاً)",
 "ふあんしん": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "ふあんしんけいしょう": "عصاب القلق (يتميز بقلق منتشر وغالباً مظاهر جسدية للخوف)",
 "ふあんてい": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ふあんていか": "زعزعة الاستقرار (فعل زعزعة الاستقرار؛ جعل الشيء أقل استقرارًا (خاصة الحكومة أو البلد أو الاقتصاد)) / زعزعة الاستقرار, فقدان التوازن (حدث يسبب فقدان التوازن (كما في السفينة أو الطائرة))",
 "ふあんない": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "ふい": "مُبَاغِت, مُفَاجِئ / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ふいうち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "ふいく": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "ふいご": "مِنْفَاخ",
 "ふいち": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "ふいちょう": "إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات)",
 "ふいっち": "تَضَارُب, تَنَاقُض",
 "ふいつ": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "ふいと": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة",
 "ふいに": "فَجْأَةً",
 "ふいにする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "ふいり": "أَرْقَش",
 "ふいん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / عُنُوسَة",
 "ふいんき": "جَو, غِلَاف جَوِّيّ / جَو / حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "ふう": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة. / فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / عَادَة, عُرْف / أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية. / حنق, غضبة (حالة من التهيج أو الانزعاج)",
 "ふうあい": "مَلْمَس",
 "ふういん": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / أَنَاقَة",
 "ふうう": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "ふううん": "طَبِيعَة, طبيعة / حَالَة, وَضْع",
 "ふううんじ": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "ふうえん": "رياح الفون, فون (رياح دافئة وجافة تهب أسفل المنحدرات الشمالية لجبال الألب)",
 "ふうか": "طَقْس, جَوّ / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت / إزهار, تزهير (رواسب مسحوقية على سطح ما) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / طفح جلدي (أي طفح أحمر على الجلد) / أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "ふうかい": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / طفح جلدي (أي طفح أحمر على الجلد) / أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "ふうかく": "شَخْصِيَّة",
 "ふうかさよう": "طَقْس, جَوّ",
 "ふうかん": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "ふうかんはがき": "رسالة مطوية (بطاقة بريدية تُطوى بحيث تكون الرسالة في الداخل)",
 "ふうが": "أَنَاقَة",
 "ふうがわり": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "ふうき": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ふうきぐさ": "فربيون ياباني (شجيرة يابانية دائمة الخضرة بطيئة النمو لها سنابل طرفية من الزهور البيضاء؛ تزرع كغطاء أرضي)",
 "ふうきょう": "جُنُون / عَارِف, عَارِفَة / أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "ふうきり": "الْعَرْضُ ٱلْأَوَّل",
 "ふうきる": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "ふうきん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / جِهَاز, جَهَاز / أُرْغُن ((أَرْغَنَ): أطاع؛ (أَرْغَنَ) إليه: رغن)\nمثال: اذكر كل عضو باسمه.",
 "ふうぎ": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "ふうぎる": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "ふうけい": "مَشْهَد, مَنْظَر طَبِيعِيّ / مَنْظَر, مَشْهَد / مَشْهَد",
 "ふうけいが": "فن المناظر الطبيعية (نوع فني يتعامل مع تصوير المناظر الطبيعية)",
 "ふうけいがか": "منسق حدائق, مهندس مناظر طبيعية (شخص يقوم بترتيب ميزات المناظر الطبيعية أو الحديقة بشكل جذاب) / رسام مناظر طبيعية (شخص يرسم المناظر الطبيعية)",
 "ふうこう": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "ふうこうめいび": "ذُو مَنَاظِر خَلَّابَة (يوصف به الأماكن؛ ذو مناظر طبيعية جميلة) / مسرحي, مشهدي (مكون من أو متعلق بالمسرح أو المناظر المسرحية)\nمثال: تصميم مشهدي",
 "ふうさ": "حِصَار, مُحَاصَرَة / تجمد, تجميد (سحب الحرارة لتحويل شيء من سائل إلى صلب)",
 "ふうさい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "ふうさいがあがらない": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "ふうさつ": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة / إخراج قسري, فورس آوت (إخراج عداء قاعدة مطلوب منه الركض)\nمثال: أمسك لاعب الشورت ستوب بالعداء عند الثانية في لعبة إجبارية",
 "ふうし": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / كُونْفُوشِيُوس / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / هِجَاء, هَجْو / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "ふうしが": "كَارِيكَاتِير, كَارِيكَاتُور",
 "ふうしこう": "جلبان, قنة (راتنج صمغي عطري مر يشبه الحلتيت)",
 "ふうしてき": "تَهَكُّمِيّ, هَجَائِيّ (يفضح حماقة البشر ويعرّضها للسخرية)",
 "ふうしゃ": "ثري, غني (شخص يمتلك ثروة مادية كبيرة) / طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق)",
 "ふうしゃごや": "طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق)",
 "ふうしゅ": "أَنَاقَة",
 "ふうしゅう": "عَادَة, عُرْف",
 "ふうしょう": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "ふうしょうばい": "بِغَاءٌ, دَعَارَة",
 "ふうしん": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "ふうしんし": "خزامى, ياسنت (أي من الأعشاب المعمرة البصلية المتعددة) / زركون أحمر, هياسينث (نوع شفاف أحمر من الزركون يستخدم كحجر كريم)",
 "ふうしんしせき": "زِرْكُون, زَرْقُون",
 "ふうじ": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "ふうじこめ": "احتواء (فعل الاحتواء؛ منع شيء ما من الانتشار) / احتواء ((في الفيزياء) نظام مصمم لمنع الإطلاق العرضي للمواد المشعة من المفاعل) / احتواء (سياسة إنشاء تحالفات استراتيجية للحد من توسع قوة أو أيديولوجية معادية أو لإجبارها على التفاوض سلمياً)\nمثال: احتواء وباء الإيدز",
 "ふうじこめる": "فَخّ, مِصْيَدَة / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "ふうじぶくろ": "مُغَلَّف, لِفَافَة / غِلَاف",
 "ふうじめ": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "ふうじゃ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "ふうじゅ": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "ふうじょう": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / ثراء لوني, غنى (حيوية عميقة وقوية للون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: عظمة العمارة",
 "ふうじょしつ": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال) / دهليز (أي من التجاويف الجسدية المختلفة المؤدية إلى تجويف آخر (كما في الأذن أو المهبل))",
 "ふうじる": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "ふうすい": "فِنْغ شُوي",
 "ふうすいせつ": "فِنْغ شُوي",
 "ふうすいらばん": "فِنْغ شُوي",
 "ふうする": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "ふうずる": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "ふうせい": "أيولي (من أو متعلق بأيولس أو شعبها اليوناني القديم) / ريحي, هوائي (متعلق بإله الرياح أيولوس؛ أو يتعلق بالرياح أو ناتج عنها) / الأيوليون (السكان اليونانيون القدماء في أيوليا) / إيولي (عضو في أحد الأقسام اللغوية الأربعة لليونانيين في عصور ما قبل التاريخ)",
 "ふうせつ": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية) / مَشَقَّة, شِدَّة / إِشَاعَة, شَائِعَة",
 "ふうせん": "نُفَّاخَة, بَالُون / مُنْطَاد",
 "ふうせんかずら": "بازلاء القلب, كرمة البالون (نبات متسلق معمر خشبي ذو قرون بذور زينة كبيرة تشبه البالونات؛ الهند الاستوائية وإفريقيا وأمريكا)",
 "ふうせんばくだん": "قنبلة بالونية (قنبلة يحملها بالون)\nمثال: في الحرب العالمية الثانية أطلق اليابانيون قنابل بالونية ضد أمريكا الشمالية",
 "ふうぜつ": "إِشَاعَة, شَائِعَة",
 "ふうそう": "مَشَقَّة, شِدَّة",
 "ふうそくけい": "مِرْيَاح",
 "ふうぞく": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / شجرة الصمغ الحلو, ليكيدامبار (أي شجرة من جنس ليكيدامبار) / صمغ حلو, ليكوييد آمبر (إفراز عطري من شجرة الصمغ الحلو)",
 "ふうぞくうた": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "ふうぞくがふう": "رسم الحياة اليومية, فن النوع (نوع فني يصور الحياة اليومية)",
 "ふうぞくてん": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ふうぞくはん": "جريمة رذيلة (رذيلة تعتبر غير قانونية)",
 "ふうぞくはんざい": "جريمة رذيلة (رذيلة تعتبر غير قانونية)",
 "ふうたい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء / شُرَّابَة",
 "ふうたく": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب الرياح رنينها)",
 "ふうたろう": "عاطل عن العمل (شخص بلا وظيفة) / عامل مياومة (عامل يعمل باليومية؛ مقابل أجر يومي)",
 "ふうち": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "ふうちかん": "غوان (أي من عدة طيور طرائد كبيرة تشبه الديك الرومي من عائلة القرازيات؛ موطنها غابات أمريكا الاستوائية؛ تشبه القراز وتقدر كطعام)",
 "ふうちょう": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / مَيْل, نَزَعَة / طائر الجنة (أي من الطيور العديدة ذات الريش الملون ببراعة في منطقة غينيا الجديدة) / إستريلتزيا, عصفور الجنة (نبات زينة من جنوب أفريقيا الاستوائية وأمريكا الجنوبية له سيقان من الزهور البرتقالية والزرقاء الأرجوانية تشبه الطائر) / بوانسيانا, عصفور الجنة (شجيرة مزهرة استوائية لها زهور برتقالية زاهية أو حمراء؛ تصنف أحياناً في جنس بوانسيانا)",
 "ふうっと": "فَجْأَةً",
 "ふうてい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "ふうてき": "مزمار القربة (آلة نفخ أنبوبية؛ ينفخ العازف الهواء في كيس ويخرجه عبر أنبوب النغمات المستمرة)",
 "ふうてん": "جُنُون / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع) / جسم تائه, شارد (أي شيء يشبه المتشرد في عدم وجود مكان ثابت له) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)\nمثال: كانت سفن القراصنة شوارد البحر",
 "ふうてんびょういん": "مارستان, مستشفى المجانين (مصطلحات تحقيرية لمصحة المجانين)",
 "ふうでい": "عُود (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "ふうとう": "مُغَلَّف, لِفَافَة / غِلَاف / سكر القيقب (سكر مصنوع من عصارة شجرة القيقب السكري)",
 "ふうど": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان) / طبوغرافيا (دراسة تفصيلية دقيقة لسمات سطح منطقة ما) / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "ふうどう": "نفق رياح, نفق هوائي (هيكل يشبه النفق حيث يتم نفخ الهواء بسرعات معروفة لاختبار أجزاء من الطائرات) / خطوط جوية, شركة طيران (مؤسسة تجارية توفر رحلات مجدولة للركاب) / قناة تهوية, مجرى هواء (قناة توفر التهوية (كما في المناجم)) / مجرى التنفس, مسلك تنفسي (الممرات التي يدخل من خلالها الهواء ويخرج من الجسم) / مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "ふうどびょう": "مرض متوطن (مرض موجود باستمرار بدرجة أكبر أو أقل في أشخاص من طبقة معينة أو في أشخاص يعيشون في موقع معين)",
 "ふうにゅう": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر)",
 "ふうにゅうたい": "جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض))\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ふうは": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام) / مَشَقَّة, شِدَّة",
 "ふうはいず": "وردة الرياح (خريطة طقس تظهر تردد وقوة الرياح من اتجاهات مختلفة)",
 "ふうひょう": "إِشَاعَة, شَائِعَة",
 "ふうび": "غَالِب",
 "ふうふ": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "ふうふう": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها / مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "ふうふかん": "زوجي (متعلق بالزواج أو بالعلاقة بين الزوج والزوجة)\nمثال: هناء زوجي",
 "ふうふかんけい": "عَلَاقَة زَوْجِيَّة (العلاقة بين الزوجة والزوج)",
 "ふうふせいかつ": "ممارسة جنسية, نشاط جنسي (الأنشطة المرتبطة بالجماع الجنسي)\nمثال: مارسوا الجنس في المقعد الخلفي",
 "ふうふづれ": "زَوْجَانِ",
 "ふうふともかせぎ": "زَوْجَانِ",
 "ふうふともばたらき": "زَوْجَانِ",
 "ふうふばか": "زَوْجَانِ",
 "ふうふやくそく": "خِطْبَة, خُطُوبَة",
 "ふうふようし": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "ふうふわかれ": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "ふうぶつ": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "ふうぶん": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "ふうぼう": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية) / قَرِيس, قَرِيت / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "ふうぼうガラス": "زُجَاج السَيَّارَة الأَمَامِيّ",
 "ふうみ": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "ふうみゆたか": "ذُو مَذَاقٍ زَاخِر, غَنِيُّ النَّكْهَة (مَلِيءٌ بِالنَّكْهَة)",
 "ふうゆ": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "ふうらい": "خِفَّة, رُعُونَة",
 "ふうらいえき": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "ふうらいじん": "هَائِم",
 "ふうらいぼう": "هَائِم",
 "ふうりゅう": "أَنَاقَة",
 "ふうりょう": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "ふうりょく": "طاقة الرياح (طاقة مستمدة من الرياح (كما في طواحين الهواء)) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "ふうりょくけい": "مِرْيَاح",
 "ふうりょくげんどうき": "توربين رياح, عنفة رياح (توربين يتم تشغيله بواسطة الرياح)",
 "ふうりょくはつでん": "طاقة الرياح (طاقة مستمدة من الرياح (كما في طواحين الهواء))",
 "ふうりょくはつでんき": "طاقة الرياح (طاقة مستمدة من الرياح (كما في طواحين الهواء))",
 "ふうりょくはつでんしょ": "مزرعة ريحية",
 "ふうりょくエネルギー": "طاقة الرياح (طاقة مستمدة من الرياح (كما في طواحين الهواء))",
 "ふうりょくタービン": "توربين رياح, عنفة رياح (توربين يتم تشغيله بواسطة الرياح)",
 "ふうりん": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب الرياح رنينها)",
 "ふうりんそう": "جريس متوسط, كأس وصحن (نبات أوروبي ثنائي الحول يزرع على نطاق واسع لأزهاره الزرقاء أو البنفسجية أو البيضاء) / جرس كانتربري, غلوكسينيا معمرة (عشب من كولومبيا إلى بيرو ذو أزهار أرجوانية شاحبة)",
 "ふうろう": "ختم, شمع الختم (مثبت يتكون من تركيبة راتنجية تكون لينة عندما تكون دافئة؛ تستخدم لختم المستندات والطرود والرسائل)",
 "ふうろそう": "غُرْنُوق / جِيرَانِيُوم",
 "ふうわり": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "ふうん": "مُصِيبَة, شَقْوَة\nمثال: 彼は身の不運を嘆き悲しんだ。 — بكى على سوء حظه. / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ふえ": "نَاي / أُخْدُود (أخْدُودُ) / صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر. / نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم / رُغَامَى, قَصَبَة هَوَائِيَّة / عدم قابلية التدمير (القوة لمقاومة الدمار)",
 "ふえい": "قَصِيدَة, شِعْر",
 "ふえいようか": "إثراء غذائي, تخاصب (المغذيات المفرطة في بحيرة أو مسطح مائي آخر، وعادة ما تنتج عن جريان المغذيات (نفايات الحيوانات، الأسمدة، مياه الصرف الصحي) من الأرض، مما يسبب نموًا…)\nمثال: جادل بأن العامل المتحكم في الإثراء الغذائي ليس النترات بل الفوسفات",
 "ふえき": "اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين) / ثَبَات عَلَى العَهْد, وَفَاء (الإخلاص والاعتمادية في العلاقات الشخصية (خاصة الإخلاص الزوجي)) / ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "ふえこちどり": "زقزاق شادي (زقزاق صغير من شرق أمريكا الشمالية)",
 "ふえつ": "فَأْس",
 "ふえて": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "ふえてもへっても": "حَوَالِي",
 "ふえふき": "عازف فلوت (شخص يعزف على الفلوت)",
 "ふえる": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ふえん": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته. / إسهاب, استفاضة (مناقشة (منطوقة أو مكتوبة) تتوسع في موضوع أو فكرة بإسهاب أو بالتفصيل) / سَرَدَ (الشيء: نَسَجَهُ ليصبح مفهوما؛ الأمر:الحديث يتلوه بإستمرار)\nمثال: يحاول الانفصاليون تطوير سرد زائف من أجل تبرير مشروعهم السياسي. / قَوَّى",
 "ふおう": "جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد) / عَصِيّ, مُمْتَنِع (غير مستجيب مؤقتاً أو غير مستجيب بالكامل لعملية أو محفّز) / عَصِيّ, مُسْتَعْصٍ (لا يستجيب للعلاج) / بطانة الفرن, مادة حرارية (بطانة تتكون من مادة ذات نقطة انصهار عالية؛ تستخدم لتبطين الجدران الداخلية للفرن)",
 "ふおうき": "فترة جموح ((علم الأعصاب) الوقت الذي يلي إطلاق الخلية العصبية أو انقباض الألياف العضلية والذي لن يستثير فيه المحفز استجابة)",
 "ふおん": "مُثِير لِلْقَلَق, مُقْلِق (يسبب عدم الراحة الذهنية) / صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "ふおんとう": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة) / غير لائق, غير مناسب (غير ملائم أو غير صحيح أو غير مناسب) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "ふおんぶんし": "مُنْشَقّ",
 "ふか": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / اختبار الإجهاد (اختبار يقيس كيفية عمل نظام ما عند تعرضه لكميات محددة من الضغط) / تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل) / حِضَانَة, تَفْرِيخ / لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت / خِفَّة, رُعُونَة",
 "ふかあお": "كحلي",
 "ふかい": "عَمِيق, غَوِيط / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ) / كَثِيف, غَلِيظ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما) / تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "ふかいあいじょう": "تَفَرُّغ",
 "ふかいかん": "انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / انزعاج, عدم راحة (حالة التوتر والشعور بالألم)",
 "ふかいかんをあたえる": "مرطبان / جَرَّة (اسم للمَرَّة الواحدة من الجَرّ؛ إناء من خَزَف أو صُلْصَال له بطن كبير وعروتان وفمّ واسع)\nمثال: من ترك الجرة مفتوحة؟",
 "ふかいにゅう": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "ふかかい": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "ふかかちさいはんぎょうしゃ": "فولت-أمبير (وحدة للقدرة الكهربائية في دائرة التيار المتردد تساوي القدرة المبددة عندما ينتج 1 فولت تياراً مقداره 1 أمبير)",
 "ふかかちぜい": "ضريبة القيمة المضافة (ضريبة تعتمد على قيمة السلع التي يحصلها بائع التجزئة النهائي)",
 "ふかかちつうしんもう": "عَرَبَة نَقْل, عربيه نقل",
 "ふかかちネットワーク": "عَرَبَة نَقْل, عربيه نقل",
 "ふかき": "حَاضِنَة",
 "ふかぎゃく": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "ふかぎゃくてき": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "ふかく": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / فِقْدَان اَلْوَعْي, إِغْمَاء / مُنْخَفَض / بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق",
 "ふかくじつ": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد",
 "ふかくじつせい": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: عدم يقين النتيجة",
 "ふかくだい": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "ふかくてい": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد",
 "ふかくていせい": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: عدم يقين النتيجة",
 "ふかくていせいげんり": "مبدأ الريبة, مبدأ عدم اليقين ((نظرية الكم) النظرية القائلة بأنه من المستحيل قياس كل من الطاقة والوقت (أو الموقع والزخم) بدقة كاملة في نفس الوقت)",
 "ふかくていはんてい": "غير حاسم, غير قاطع (غير نهائي؛ لا يضع حداً للشك أو السؤال)\nمثال: رد غير حاسم",
 "ふかくていようそ": "مُتَغَيِّر",
 "ふかけつ": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "ふかけつアミノさん": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "ふかこうりょく": "قضاء وقدر, قوة قاهرة (كارثة طبيعية لا مفر منها تقطع المسار المتوقع للأحداث)\nمثال: اكتشف أن منزله لم يكن مؤمناً ضد القضاء والقدر / قوة قاهرة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "ふかご": "عِصْمَة",
 "ふかさ": "عَمْق",
 "ふかざら": "سلطانية حساء كبيرة, طاسية (طبق تقديم عميق وكبير بغطاء؛ لتقديم الحساء واليخنات)",
 "ふかし": "خفاء, عدم المرئية (صفة عدم إمكانية الإدراك بالعين) / فَضْلَة",
 "ふかしぎ": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا. / غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل) / سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / عميق جداً, لا يسبر غوره (عن العمق؛ غير قادر على أن يسبر أو يقاس)",
 "ふかしょくせんみん": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "ふかしょくみん": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "ふかしん": "عدم الاعتداء (سياسة عدم البدء بالأعمال العدائية)\nمثال: وقعوا ميثاق عدم اعتداء",
 "ふかじょう": "مفقس (مكان يفقس فيه البيض تحت ظروف اصطناعية (خاصة بيض السمك))\nمثال: تدير سلطات الحديقة مفقساً لسمك السلمون المرقط",
 "ふかす": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / دَوْرَة فِي الدَّقِيقَة (معدل دوران المحرك)\nمثال: كان المحرك يقوم بـ 6000 دورة / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء.",
 "ふかぞり": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "ふかち": "غير قابل للمعرفة, مستعصٍ على المعرفة (لا يمكن معرفته)\nمثال: أسرار الحياة التي لا يمكن معرفتها",
 "ふかちてき": "لَاأَدْرِيّ",
 "ふかちろん": "لَاأَدْرِيَّة",
 "ふかちろんしゃ": "لَاأَدْرِيّ",
 "ふかっせい": "خَامِل / خَامِد",
 "ふかっせいか": "تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح)) / إبطال الفعالية, تثبيط (عملية جعل الشيء غير نشط)\nمثال: نظام تعطيل الجينات",
 "ふかっせいきたい": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري) / غَازٌ خَامِل",
 "ふかっせいガス": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري)",
 "ふかって": "إزعاج, إقلاق (صعوبة تسبب القلق) / إِزْعَاج, عَدَم رَاحَة (صفة كون الشيء غير مفيد أو غير مريح) / إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "ふかっぱつ": "كَلِيل",
 "ふかつ": "تفعيل, تنشيط (الجعل نشطاً وفعالاً (مثل القنبلة)) / تفعيل, تنشيط (نشاط التسبب في الحصول على طاقة ونشاط) / تنشيط (تحفيز النشاط في كائن حي أو مادة كيميائية)",
 "ふかつか": "خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "ふかつどう": "جمود, خمول (حالة عدم النشاط)",
 "ふかづめ": "غَائِر, مُنْخَفِض (ذو منطقة غائرة أو منخفضة عن السطح)",
 "ふかで": "جرح قطعي, شرط (قطع كاسح قوي يتم بأداة حادة) / شق, قطع (خندق يشبه الأخدود ناتج عن التعرية أو الحفر) / جرح قطعي, قطع (جرح ناتج عن القطع)\nمثال: وضع ضمادة على الجرح",
 "ふかとく": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "ふかなべ": "قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ふかにゅうせい": "اسْتِعْصَاء, عَمَايَة (عدم القدرة على الفهم بسبب الكثافة الشديدة للمعلومات أو التعقيد) / حَصَانَة, كَتَامَة (صفة كون الشيء غير قابل للاختراق (من قبل الناس أو الضوء أو القذائف وما إلى ذلك))",
 "ふかのう": "مُسْتَحِيل",
 "ふかのうじ": "مُسْتَحِيل",
 "ふかのうせい": "مُسْتَحِيل",
 "ふかはんのう": "تفاعل إضافة (تفاعل كيميائي يضاف فيه جزيء إلى آخر)",
 "ふかひ": "حَتْمِيّ",
 "ふかふか": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ふかぶん": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)\nمثال: 健康は運動と節制と不可分の関係にある。 — الصحة الجيدة لا يمكن فصل العلاقة بينها وبين الرياضة والاعتدال في كل شيء.",
 "ふかま": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "ふかまる": "تَعَمَّقَ",
 "ふかみ": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / عَمْق",
 "ふかめる": "تَعَمَّقَ",
 "ふかりつ": "عَامِل الحِمْل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "ふかん": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "ふかんさつえい": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "ふかんしへい": "نقد ورقي إلزامي, نقود إلزامية (نقود تعلن الحكومة أنها عملة قانونية رغم عدم إمكانية تحويلها إلى عملة معدنية قياسية)",
 "ふかんしょう": "اِمْتِنَاع, إِمْسَاك / انْعِدَام الإِحْسَاس, تَبَلُّد (العجز عن الاستجابة للتغيرات الوجدانية في البيئة الشخصية)",
 "ふかんず": "مَنْظُور عَيْن الْطَائِر",
 "ふかんぜん": "ناقص-غير كامل",
 "ふかんぜんこっせつ": "كسر غير كامل (كسر لا يمتد عبر كامل عرض العظم)",
 "ふかんぜんへんたい": "تحول جزئي, تحول ناقص (تحول غير كامل أو جزئي في الحشرات)",
 "ふかんてき": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "ふかんよう": "ضيق الصدر, عدم الاحتمال (نفاد الصبر مع المضايقات) / تعصب, عدم تسامح (عدم الاستعداد للاعتراف بالاختلافات في الآراء أو المعتقدات واحترامها)\nمثال: عدم احتماله للمقاطعات",
 "ふかテスト": "اختبار الإجهاد (اختبار يقيس كيفية عمل نظام ما عند تعرضه لكميات محددة من الضغط)",
 "ふが": "حَانَة, بَار",
 "ふがい": "لاعنف",
 "ふがいない": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "ふがく": "جَبَل فُوجِي, فُوجِي (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل. / جَاهِل, غَيْرُ مُتَعَلِّم (غير متعلّم بشكل عامّ؛ يفتقر إلى المعرفة أو الحصافة) / غريزي, غير شرطي (لم يتم تثبيته عن طريق الاشتراط أو التعلم) / قَلِيلُ العِلْم (ليس واسع الاطّلاع أو المعرفة)\nمثال: رد فعل منعكس غير شرطي",
 "ふがくさんじゅうろっけい": "سِتَّة وَثَلَاثُون",
 "ふき": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / حرج, خرق (هيئة شخص تكون حركاته ووضعيته غير رشيقة أو غير أنيقة) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب) / مُفَاجِئ / عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين. / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر / نفخ (معالجة تتضمن نفخ الغاز) / لعب (فعل المشاركة في لعبة أو رياضة أو ترفيه آخر) / عزف (فعل العزف على آلة موسيقية) / أداء, تمثيل (أداء دور في عمل درامي) / مِنْفَاخ / اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب) / مُنَظِّف / مُنَظِّفَة / تَنْظِيف / لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ふきあげ": "نَافُورَة, فَوَّارَة",
 "ふきいた": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "ふきおくる": "راية طويلة (علم طويل؛ غالباً ما يكون مستدق الطرف)",
 "ふきおとす": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ふきかえ": "دَبْلَجَة (دَبْلَجَةُ فِلْمٍ : تَغْيِيرُ لُغَةِ الفِلْمِ الأصْلِيَّةِ إلَى لُغَةٍ أُخْرَى) / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة / إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "ふきかえす": "أَحْيَا",
 "ふきかえる": "اِنْتَسَخَ, نَسَخَ / دَبْلَجَ (في المسرح: أحَلَّ مُمَثِّلاً مَحَلَّ اخَر) / داب",
 "ふきかける": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة) / بَالَغَ",
 "ふきけす": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى",
 "ふきげん": "بوّز, بَرطَمَ",
 "ふきこみ": "تَسْجِيل",
 "ふきこむ": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "ふきすさぶ": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "ふきそうじ": "تَنْظِيف",
 "ふきそく": "شَاذّ, غَيْر مُنْتَظِم",
 "ふきそくぎんが": "مَجَرَة غَيْر مُنْتَظِمَة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "ふきそくどうし": "فِعْل غَيْر مُنْتَظِم, فِعْل شَاذّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "ふきだし": "فقاعة الكلام (في الرسوم المتحركة، مخطط دائري يحتوي على كلمات)\nمثال: تستخدم فقاعات الكلام ليس فقط لتضمين كلمات الشخصية، ولكن أيضاً العواطف ونغمات الصوت واللغة غير المحددة / اِنْدِفَاق, اِنْصِبَاب / تَدَفُّق / نفخ (معالجة تتضمن نفخ الغاز)",
 "ふきだしぐち": "بزبوز, فوهة (فوهة بارزة يتم تصريف السائل منها) / أنف, منقار (مصطلحات غير رسمية للأنف)",
 "ふきだす": "نَبْتَة / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "ふきだまり": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ふきちらす": "نَثَرَ, تَفَرَّقَ",
 "ふきつ": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "ふきつけ": "رش المحاصيل (نثر مبيدات الفطريات أو الحشرات أو الأسمدة على المحاصيل النامية (غالباً من طائرة تحلق على ارتفاع منخفض)) / رش (وضع سائل على شكل جزيئات صغيرة تقذف من بخاخ) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "ふきつける": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "ふきでもの": "بزوغ السن (ظهور السن عند اختراقه اللثة) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ) / اندلاع, تفشي (حدوث تلقائي عنيف ومفاجئ (عادة لحالة غير مرغوب فيها)) / ثوران, ثوران بركاني (الحدوث المفاجئ لتفريغ عنيف للبخار والمواد البركانية)\nمثال: اندلاع الأعمال العدائية",
 "ふきとおし": "تَهْوِيَة / بَالَغَ",
 "ふきとばす": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)",
 "ふきとぶ": "اِحْتَجَبَ, إخْتَفَى (وضع أمامه حجابا فلم يُعَد يُرى؛ وضع له حاجبا)",
 "ふきとる": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ふきどおし": "بَالَغَ",
 "ふきながし": "كم الرياح, مخروط الرياح (مخروط قماشي مبتور مثبت على صارية؛ يستخدم (على سبيل المثال، في المطارات) لإظهار اتجاه الرياح)",
 "ふきながす": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "ふきならす": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "ふきぬき": "عَمُود السُّلَّم / بَثَّاث",
 "ふきぬけ": "أُذَيْن / احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة) / انفجار, عطل مفاجئ (عطل مفاجئ في جزء أو جهاز) / اكتساح, فوز سهل (انتصار سهل)\nمثال: انفجر الإطار الأمامي الأيمن / مُعَرَّض لِلتَّيَّارَات (غير محكم الإغلاق تجاه الهواء)",
 "ふきね": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "ふきの": "منشفة أطباق (منشفة لتجفيف الأطباق)",
 "ふきのの": "منشفة أطباق (منشفة لتجفيف الأطباق)",
 "ふきはつせいか": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "ふきはつせいきおくそうち": "تخزين غير متطاير (تخزين حاسوبي لا يُفقد عند إيقاف تشغيل الطاقة)",
 "ふきばり": "خزاقة",
 "ふきふき": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "ふきぶり": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "ふきまわし": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ふきもの": "آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "ふきや": "سبطانة / خزاقة",
 "ふきやづつ": "سبطانة",
 "ふきゅう": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / شيء ثانوي, غير ضروري (أي شيء ليس أساسياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل. / نَخْر / اضمحل / تضعضع",
 "ふきゅうふめつ": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "ふきょう": "مُنْخَفَض / استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما) / توليد, مضاعفة (فعل إنتاج النسل أو المضاعفة من خلال هذا الإنتاج) / ترويج, نشر (نشر شيء (معتقد أو ممارسة) في مناطق جديدة) / انتشار (حركة موجة عبر وسط)",
 "ふきょうし": "مُبَشِّر, مُنَصِّر",
 "ふきょうしゃ": "مُبَشِّر, مُنَصِّر",
 "ふきょうわ": "تنافر, نشاز (أصوات غير متوافقة أو مزعجة) / ضجيج, ضوضاء (التجربة السمعية لصوت يفتقر إلى الجودة الموسيقية؛ صوت يمثل تجربة سمعية مزعجة) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: الموسيقى الحديثة مجرد ضجيج بالنسبة لي",
 "ふきょうわおん": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "ふきょく": "مِصْعَد / أَنُود / مُؤَلَّف, مُصَنَّف / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ふきょふくせい": "جَمِيع اَلْحُقُوق مَحْفُوظَة, كَافَّة اَلْحُقُوق مَحْفُوظَة",
 "ふきよせ": "مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة) / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ふきよせる": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ふきりつ": "شَاذّ, غَيْر مُنْتَظِم",
 "ふきりょう": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "ふきわける": "ذَرَّى, نَسَفَ (ذَرَتِ الريحُ التُّرابَ: فَرَّقَتْهُ وَأَطَارَتْهُ؛ ذَرَى القمحَ: نَقَّاهُ فِي الرِّيحِ) / ذَرَّايَة, مِذْرَاة",
 "ふきん": "جِوَار, قُرْب / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جِوَار\nمثال: ينبح كلب في الحي. / منشفة أطباق (منشفة لتجفيف الأطباق) / فَأْس",
 "ふきんいつ": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم) / غير متجانس, متباين (يتكون من عناصر ليست من نفس النوع أو الطبيعة)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "ふきんこう": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ふきんしつ": "خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم) / غير متجانس, متباين (يتكون من عناصر ليست من نفس النوع أو الطبيعة)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "ふきんしつせい": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "ふきんしん": "طَائِش, مُتَهَوِّر (يَفْتَقِر إِلَى ضَبْط النَّفْس الحَكِيم) / غير حكيم, متهور (ليس حكيماً أو عاقلاً)\nمثال: تهور كبير من والدتها أن تشجعها على مثل هذه الأفكار الرومانسية السخيفة",
 "ふきんせい": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "ふきんとう": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "ふき取る": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ふき寄せ": "مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة) / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "ふぎ": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد / خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "ふぎみっつう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "ふぎょう": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "ふぎょうぎ": "سوء أدب (قلة أدب ناتجة عن الجهل)",
 "ふぎょうじょう": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "ふぎょうせき": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "ふぎり": "خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار",
 "ふく": "فوغو (سمكة منتفخة تحظى بتقدير كبير كطعام شهي في اليابان ولكنها خطيرة جداً لأن الجلد والأعضاء سامة) / مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / نَفَثَ, أَصْدَرَ / نَبْتَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / مُسْتَنْسَخ, مُكَرَّر (منسوخ بشكل مطابق عن الأصل) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً) / بديل احتياطي, نسخة إضافية (شيء إضافي من نفس النوع)\nمثال: صنع نسخة للملفات / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف. / مَلَابِس, ثِيَاب / حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة. / مُرَكَّب (هو مَرْكَبَة للبحر، أكبر من القَارِب وأصغر السَفِينَة)\nمثال: أطلقت الشرطة النار على إطارات مركبة توم. / زوجي (التنس التي تُلعب بلاعبين في كل جانب) / زوجي (تنس الريشة التي تُلعب بلاعبين في كل جانب) / رهان المركز (رهان على أن الحصان سينهي السباق في المركز الثاني على الأقل) / سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف. / طُومَار / إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "ふくい": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / فُوكُوي",
 "ふくいく": "رَيًّا, عَبِق",
 "ふくいん": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل / إِنْجِيل / عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / تسريح (فعل التحول من أساس الحرب إلى أساس السلم بما في ذلك حل القوات أو تسريحها)",
 "ふくいんしか": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "ふくいんしゅぎ": "إنجيلية (تؤكد على أهمية التحول الشخصي والإيمان كوسيلة للخلاص) / تبشير بالإنجيل (التبشير الحماسي والدعوة للإنجيل)",
 "ふくいんしょ": "إنجيل, الأناجيل (الكتب الأربعة في العهد الجديد (متى ومرقس ولوقا ويوحنا) التي تروي قصة حياة المسيح وتعاليمه)",
 "ふくいんでんどう": "تبشير بالإنجيل (التبشير الحماسي والدعوة للإنجيل)",
 "ふくいんでんどうしゃ": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "ふくいんは": "تَبْشِيرِيّ, دَعَوِيّ (يتّسم بحماسة متّقدة لقضيّة ما) / إنجيلي (متعلق بالإنجيل المسيحي أو متوافق معه، خاصة كما في الكتب الأربعة الأولى من العهد الجديد) / إنجيلي (متعلق بكنيسة مسيحية تؤمن بالتحول الشخصي وعصمة الكتاب المقدس وخاصة الأناجيل الأربعة)\nمثال: المسيحية الإنجيلية",
 "ふくえき": "خِدْمَةٌ عَسْكَرِيَّة / عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "ふくえきしゅう": "أَدَانَ / سَجِين, مُدَان",
 "ふくえん": "صُلْح, مُصَالَحَة / ملح مزدوج (محلول لملحين بسيطين يشكل مادة واحدة عند التبلور) / بزوغ, ظهور (فعل الظهور أو الخروج) / بزوغ, خروج ((في علم الفلك) عودة ظهور جرم سماوي بعد الكسوف أو الاحتجاب)",
 "ふくおう": "نَائِب",
 "ふくおうきん": "مستعرضة بطنية (عضلة مسطحة بألياف مستعرضة تشكل الجدران الأمامية والجانبية لتجويف البطن)",
 "ふくおか": "فُوكُوُكَا",
 "ふくかいちょう": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "ふくかく": "غَمَس / غَمَر (الغَمْرُ: الماء الكثير؛ الغَمْرُ من الماء: خِلاف الضَّحْل، وهو الذي يعلو مَن يدخله ويغطِّيه، وفي الحديث) / غَطَسَ",
 "ふくかん": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية) / مرافق عسكري, مساعد (ضابط يعمل كمساعد عسكري لضابط أعلى رتبة)",
 "ふくがん": "عين مركبة (في الحشرات وبعض القشريات: تتكون من العديد من العناصر الحساسة للضوء تشكل كل منها جزءاً من الصورة)",
 "ふくがんてき": "مُتَشَعِّب, مُتَعَدِّدُ الجَوَانِب (ذُو جَوَانِبَ أَوْ صِفَاتٍ كَثِيرَة)",
 "ふくきゃく": "رجل عائمة, قدم سباحة (واحدة من الزوائد البطنية المزدوجة لبعض القشريات المائية التي تعمل بشكل أساسي لحمل البيض عند الإناث وتتكيف عادة للسباحة)",
 "ふくきゅう": "عَمَل اِنْتِقَامِيّ (عمل انتقامي ضد عدو في زمن الحرب)",
 "ふくきん": "عضلة بطنية (عضلات البطن) / تمرين الجلوس من الرقود (تمرين للبطن يجلس فيه الشخص من وضع الاستلقاء دون استخدام الذراعين للرافعة)",
 "ふくぎょう": "هواية (نشاط إضافي أو جانبي) / خط جانبي, نشاط فرعي (خط بضائع إضافي أو مساعد) / خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "ふくくう": "بطن, تجويف بطني (التجويف الذي يحتوي على الأحشاء الرئيسية؛ في الثدييات يفصله عن الصدر الحجاب الحاجز)",
 "ふくくうきょう": "مِنْظَار الْبَطْن",
 "ふくくうきょうけんさ": "تنظير البطن",
 "ふくくうきょうしゅじゅつ": "تنظير البطن",
 "ふくくうせんし": "بزل البطن (بزل البطن لإزالة السائل للتشخيص)",
 "ふくくっせつ": "انكسار مزدوج (انقسام شعاع إلى شعاعين متوازيين مستقطبين بشكل عمودي)",
 "ふくけん": "إِعَادَةُ تَأْهِيل",
 "ふくげき": "كَمين / كَمِين",
 "ふくげん": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "ふくげんさぎょう": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "ふくげんひん": "تَكَاثُر",
 "ふくげんりょく": "اِسْتِقْرَار",
 "ふくこう": "بطن, تجويف بطني (التجويف الذي يحتوي على الأحشاء الرئيسية؛ في الثدييات يفصله عن الصدر الحجاب الحاجز)",
 "ふくこうかんしんけいけい": "الجهاز العصبي الباراسمبثاوي, الجهاز العصبي اللاودي (ينشأ في جذع الدماغ والجزء السفلي من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية للجهاز العصبي الودي: يحفز الإفرازات الهضمية؛ يبطئ القلب؛ يقبض حدقة…)",
 "ふくこうがん": "بَرْبَخ",
 "ふくこうがんえん": "التهاب البربخ (التهاب مؤلم في البربخ)",
 "ふくこうきょう": "مِنْظَار الْبَطْن",
 "ふくこうきょうけんさ": "تنظير البطن",
 "ふくこうきょうしゅじゅつ": "تنظير البطن",
 "ふくこうしん": "سَعْفَة, قَرَع",
 "ふくこうじょうせん": "غدة جار درقية, غدة جارات الدرقية (أي واحدة من أربع غدد صماء تقع فوق أو داخل الغدة الدرقية)",
 "ふくこうじょうせんきのうこうしんしょう": "فرط نشاط جارات الدرقية (إفراز مفرط لهرمون الغدة الجار درقية يؤدي إلى مستويات عالية غير طبيعية من الكالسيوم في الدم؛ يمكن أن يؤثر على العديد من أجهزة الجسم (خاصة التسبب في…)",
 "ふくこうじょうせんきのうていかしょう": "قصور الدريقية, قصور جارات الدرقية (إفراز غير كافٍ لهرمون الغدة الجار درقية يؤدي إلى مستويات منخفضة غير طبيعية من الكالسيوم في الدم)",
 "ふくこうじょうせんホルモン": "باراثورمون, هرمون الغدة الجار درقية (هرمون يتم تصنيعه وإطلاقه في مجرى الدم بواسطة الغدد الجار درقية؛ ينظم الفوسفور والكالسيوم في الجسم)",
 "ふくこん": "تَعَدُّدُ الأَزْوَاج",
 "ふくごう": "مُؤَلَّف, مُرَكَّب (يَتَكَوَّن مِنْ أَجْزَاء مُنْفَصِلَة مُتَرَابِطَة) / مركب (من أو متعلق بـ أو ينتمي إلى الفصيلة النباتية المركبة) / مجمع, مركب (كل مفاهيمي مكون من أجزاء معقدة ومترابطة) / نبات مركب, نجميات (تعتبر النباتات ثنائية الفلقة الأكثر تطوراً، وتتميز بزهيرات مرتبة في رؤوس كثيفة تشبه الزهور المفردة)\nمثال: أنشأ مجمع مراكز التسوق والمنازل والطرق مدينة جديدة / فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "ふくごうか": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "ふくごうき": "جهاز فك التشفير (آلة تحول النص المشفر إلى لغة عادية) / حال الشفرة, مفكك الرموز (نوع من المثقفين يقوم بتحويل الرسائل من صيغة مشفرة إلى نص عادي)",
 "ふくごうきぎょう": "تَجْمِيعِيّ, مُتَكَتِّل (مؤلف من عناصر متباينة مجتمعة في كتلة واحدة) / تكتل شركات, مجموعة شركات (مجموعة من الشركات المتنوعة تحت ملكية مشتركة وتدار كمنظمة واحدة) / تكتلات صخرية, كونغلوميريت (صخر مركب يتكون من جزيئات متفاوتة الحجم)",
 "ふくごうげんじつ": "سيد (صيغة خطاب للرجل)",
 "ふくごうご": "كلمة مركبة, مركب (كلمة تتكون من أي مجموعة متنوعة من الكلمات أو الصيغ التركيبية أو اللواحق)",
 "ふくごうざいりょう": "مادة مركبة (مادة خفيفة الوزن وقوية تم تطويرها في المختبر؛ يتم فيها ربط ألياف من أكثر من نوع معاً كيميائياً)",
 "ふくごうしせつ": "مَعْقِد / عُقْدَة",
 "ふくごうせいきょくしょとうつうしょうこうぐん": "بروتين سي التفاعلي (منتج ثانوي للالتهاب؛ غلوبولين يوجد في الدم في بعض حالات الالتهاب الحاد)",
 "ふくごうぜんちし": "حرف جر مركب (حرف جر يتكون من مجموعة كلمات تعمل كوحدة واحدة)",
 "ふくごうたい": "مَعْقِد / عُقْدَة",
 "ふくごうたんぱくしつ": "بروتين مركب, بروتين مقترن (معقد بروتيني يجمع بين الأحماض الأمينية ومواد أخرى)",
 "ふくごうばいたい": "اَلْوَسَائِط اَلْمُتَعَدِّدَة",
 "ふくごうめいれいセットコンピューター": "حاسوب بمجموعة تعليمات معقدة, سيسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على عدد كبير من التعليمات المرمزة في شريحة المعالج المركزي) / دائرة الاستخبارات الجنائية الكندية (وكالة تابعة للحكومة الكندية توحد وحدات الاستخبارات التابعة لوكالات إنفاذ القانون الكندية)",
 "ふくごうタンパクしつ": "بروتين مركب, بروتين مقترن (معقد بروتيني يجمع بين الأحماض الأمينية ومواد أخرى)",
 "ふくさ": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)",
 "ふくさい": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "ふくさよう": "أَثَر جَانِبِيّ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ふくさんぶつ": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "ふくざ": "سيارة رودستر (سيارة مكشوفة لها مقعد أمامي ومقعد خلفي إضافي)",
 "ふくざいじょうみゃく": "وريد صافن (أي من وريدين سطحيين رئيسيين في الساق يصرفان الدم من القدم)",
 "ふくざき": "سيارة رودستر (سيارة مكشوفة لها مقعد أمامي ومقعد خلفي إضافي)",
 "ふくざつ": "مَعْقِد / عُقْدَة",
 "ふくざつか": "تَعْقِيد / مُضَاعَفَة\nمثال: 現代の社会問題はますます複雑化する傾向がある。 — تميل مشكلات يومنا الاجتماعية إلى التعقيد أكثر فأكثر.",
 "ふくざつこっせつ": "كسر مركب, كسر مفتوح (كسر عظمي مصحوب بتهتك في الأنسجة الرخوة أو جرح مفتوح)",
 "ふくざつさ": "تَعْقِيد",
 "ふくざつせい": "تَعْقِيد / مَعْقِد / عُقْدَة",
 "ふくざつそしょうけいたい": "دعوى جماعية (دعوى قضائية يرفعها عضو ممثل لمجموعة كبيرة من الناس نيابة عن جميع أعضاء المجموعة)",
 "ふくざつたき": "شَائِك, مُعَقَّد (بَالِغ التَّعْقِيد أَوِ التَّشَابُك وَأَحْيَانًا مُخَادِع) / مُتَاهِيّ, مُتَعَرِّج (يُشْبِه المَتَاهَة فِي الشَّكْل أَوِ التَّعْقِيد) / تيهي (يتعلق بالأذن الداخلية (التيه) أو يؤثر عليها أو ينشأ فيها)\nمثال: صمم تيهي",
 "ふくざつめいれいセットコンピュータ": "حاسوب بمجموعة تعليمات معقدة, سيسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على عدد كبير من التعليمات المرمزة في شريحة المعالج المركزي)",
 "ふくし": "ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف. / رَفَاهَة, خَيْر / رؤية مزدوجة, شفع (ضعف بصري يُرى فيه الجسم كجسمين)\nمثال: غالباً ما يختفي الشفع عند تغطية إحدى العينين / رجل عائمة, قدم سباحة (واحدة من الزوائد البطنية المزدوجة لبعض القشريات المائية التي تعمل بشكل أساسي لحمل البيض عند الإناث وتتكيف عادة للسباحة) / جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "ふくしあい": "زوجي (التنس التي تُلعب بلاعبين في كل جانب) / زوجي (تنس الريشة التي تُلعب بلاعبين في كل جانب)",
 "ふくしきこきゅう": "تنفس بطني (تنفس يتم فيه بذل معظم الجهد التنفسي بواسطة عضلات البطن)\nمثال: يمارس المغنون التنفس البطني",
 "ふくしきぼき": "قيد مزدوج (يقوم كاتب الحسابات بخصم المعاملة من حساب وإضافتها إلى آخر)",
 "ふくしこっか": "دولة الرفاهية (حكومة تتحمل المسؤولية عن رفاهية مواطنيها من خلال برامج في الصحة العامة والإسكان العام والمعاشات التقاعدية وتعويض البطالة وما إلى ذلك)",
 "ふくしし": "أخصائي اجتماعي, باحث اجتماعي (شخص يعمل لتقديم الخدمات الاجتماعية (خاصة للمحرومين))",
 "ふくしじぎょう": "خدمة اجتماعية, عمل خيري (نشاط منظم لتحسين ظروف المحرومين في المجتمع)",
 "ふくしじむしょ": "ضمان اجتماعي (برنامج رعاية اجتماعية في الولايات المتحدة؛ يشمل تأمين الشيخوخة والورثة وبعض تأمينات البطالة ومساعدات كبار السن)",
 "ふくしせいさく": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "ふくしてき": "ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف.",
 "ふくしま": "فُوكُوشِيمَا",
 "ふくしゃ": "نسخ (فعل النسخ) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / مُبَارَك",
 "ふくしゃき": "نَاسِخَة, نَاسِخَة ضَوْئِيَّة",
 "ふくしゃく": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي)",
 "ふくしゃせん": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ふくしゃエネルギー": "طاقة إشعاعية (طاقة تنتقل في شكل إشعاع (كهرومغناطيسي)؛ طاقة توجد في غياب المادة)",
 "ふくしゅ": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "ふくしゅう": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / تفتيش, معاينة (فحص رسمي أو حكومي) / تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة) / مراجعة ((قانون) إعادة فحص قضائي لإجراءات محكمة (خاصة من قبل محكمة استئناف))\nمثال: وقفت الفصيلة جاهزة للتفتيش / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر. / فُوجُو",
 "ふくしゅうしゃ": "منتقم (شخص يأخذ بالثأر)",
 "ふくしゅせき": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "ふくしょ": "توقيع مصادقة (توقيع تأكيد ثانٍ يصادق على وثيقة موقعة بالفعل) / نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "ふくしょう": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "ふくしょうぐん": "فريق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "ふくしょうしき": "رهان المركز (رهان على أن الحصان سينهي السباق في المركز الثاني على الأقل)",
 "ふくしょく": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له) / إعادة اعتبار, إعادة للوظيفة (فعل إعادة شخص ما إلى منصب سابق) / إعادة, إعادة تعيين (حالة الإعادة إلى المنصب)\nمثال: أصررنا على إعادة العقيد لمنصبه / زي, لباس (ملابس ذات طراز مميز أو لمناسبة خاصة)",
 "ふくしょくてん": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "ふくしょくひん": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "ふくしょくぶつ": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "ふくしょくみほん": "لوحة أزياء (لوحة توضح أحدث صيحات الموضة في الملابس) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "ふくしん": "حكم مساعد, مراقب الخط (حكم (في التنس، كرة القدم، إلخ) يساعد الحكم الرئيسي بطريقة ما (خاصة بمراقبة خروج الكرة أو التسلل)) / مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى معينة قانونياً أو مراجعة محكمة استئناف لقرار محكمة ابتدائية)",
 "ふくしんけい": "عصب إضافي, عصب قحفي حادي عشر (ينشأ من مجموعتين من الجذور (قحفية وشوكية) تتحد لتشكل العصب)",
 "ふくしんのとも": "أمين سر, خليل (شخص يُؤتمن على الأمور الخاصة)",
 "ふくしんのぶか": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "ふくじ": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء. / ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "ふくじてき": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "ふくじぶんか": "ثقافة فرعية (مجموعة اجتماعية داخل ثقافة وطنية لها أنماط مميزة من السلوك والمعتقدات)",
 "ふくじゅう": "طَاعَة, إِطَاعَة",
 "ふくじゅうしん": "إذعان, خضوع (سمة الاستعداد للخضوع لإرادة شخص آخر أو قوة عليا وما إلى ذلك)",
 "ふくじん": "غُدَّة كَظَرِيَّة",
 "ふくじんずいしつ": "نخاع الغدة الكظرية (نخاع الغدة الكظرية؛ يفرز الإبينفرين)",
 "ふくじんひしつ": "قشرة الغدة الكظرية (قشرة الغدة الكظرية؛ تفرز الكورتيكوستيرون والهرمونات الجنسية)",
 "ふくじんひしつしげきホルモン": "هرمون موجه لقشر الكظر (هرمون تنتجه الغدة النخامية الأمامية يحفز قشرة الغدة الكظرية)",
 "ふくじんひしつホルモン": "قشرة الغدة الكظرية (قشرة الغدة الكظرية؛ تفرز الكورتيكوستيرون والهرمونات الجنسية)",
 "ふくす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / أَطَاعَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَاحَظَ, رَاقَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "ふくすい": "اِسْتِسْقَاء / تكثيف, تكميد (فعل زيادة كثافة شيء ما) / تكثيف ((التحليل النفسي) عملية لاواعية تتحد فيها فكرتان أو صورتان في رمز واحد؛ خاصة في الأحلام) / إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "ふくすいき": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / مكثف ضوئي (عدسة تستخدم لتركيز الضوء على جسم ما) / مكثف (ملف مجوف يقوم بالتكثيف عن طريق سحب الحرارة) / مكثف (جهاز يحول البخار إلى سائل)",
 "ふくすいぼんにかえらず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "ふくすう": "الْجَمْع / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ふくすうけい": "جمع, صيغة الجمع (صيغة الكلمة المستخدمة للدلالة على أكثر من واحد)",
 "ふくすうこ": "جماهير, جموع (عامة الناس بشكل عام) / جمهور, حشد كبير (تجمع كبير للناس) / جموع, حشد (كمية كبيرة غير محددة)\nمثال: افصل المحاربين عن الجموع",
 "ふくすけ": "كَبير الرَّأْس (ذو رَأْس كَبير الحَجْم)",
 "ふくする": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم) / أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / أَطَاعَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَاحَظَ, رَاقَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "ふくせい": "تَكَاثُر / نَجْم مُتَعَدِّد (نظام مكون من ثلاثة نجوم أو أكثر مرتبطة بالجاذبية) / منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً) / اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد))",
 "ふくせいせいぶつ": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "ふくせいひん": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "ふくせいぶつ": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "ふくせん": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح) / إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً) / تَحْضِير, إِعْدَاد / احتكار ثنائي",
 "ふくせんこう": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "ふくぜい": "كَمين / كَمِين",
 "ふくぜつ": "اِزْدِوَاجِيَّة لُغَوِيَّة, دِيجْلُوسْيَا",
 "ふくそ": "مَعْقِد / عُقْدَة",
 "ふくそう": "زي, لباس (ملابس ذات طراز مميز أو لمناسبة خاصة) / اِحْتِقَان / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب)) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر) / تَقَارُب (اقتراب متسلسلة لا نهائية من حد محدود) / التقاء, تقارب (حدوث التقاء شيئين أو أكثر)\nمثال: لم يكن هناك تداخل بين مقترحاتهم",
 "ふくそうきてい": "قواعد اللباس (مجموعة من القواعد تحدد الطريقة الصحيحة للملبس أثناء التواجد في مباني المؤسسة (أو تحدد ما هو ممنوع من الملابس))",
 "ふくそうさい": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "ふくそうじゅうし": "مساعد طيار (طيار مساعد على متن طائرة)",
 "ふくそうじょうたい": "اِحْتِقَان",
 "ふくそうとうさく": "تخنث, لبيسة الجنس الآخر (ممارسة اعتماد ملابس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "ふくそうとうさくしゃ": "لبيس (للجنس الآخر), متشبه بالجنس الآخر (يحصل على إشباع جنسي من ارتداء ملابس الجنس الآخر) / لابس لملابس الجنس الآخر (شخص يتبنى لباس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "ふくそかん": "حلقة غير متجانسة, مركب حلقي غير متجانس (حلقة من ذرات من أكثر من نوع؛ خاصة حلقة من ذرات الكربون تحتوي على ذرة واحدة على الأقل ليست كربوناً) / مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "ふくそかんしきかごうぶつ": "مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "ふくそく": "بَطْنِيّ, مُتَّجِه نَحْو المِحْوَر (الأقرب إلى أو المتجه نحو محور عضو أو كائن حي) / بَطْنِيّ (نحو أو على أو بالقرب من البطن (أمام الرئيسيات أو السطح السفلي لحيوان أدنى))\nمثال: يُعرف الجانب العلوي للورقة بالسطح البطني",
 "ふくそくるい": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات)",
 "ふくそすう": "عَدَد عَقَدِيّّ, عَدَد مُرَكِّب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ふくそへいめん": "المستوى المركب (تمثيل هندسي للأعداد المركبة يتكون من المحور الحقيقي والمحور التخيلي المتعامد)",
 "ふくぞう": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ふくぞうなく": "بِصَراحة",
 "ふくぞく": "تَابِع / مُتَابِع",
 "ふくたい": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / مَعْقِد / عُقْدَة",
 "ふくだい": "عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "ふくだいとうりょう": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "ふくだいとうりょうこうほ": "نائب رئاسي (يتعلق بنائب الرئيس أو بمنصب نائب الرئيس)\nمثال: مناظرات نواب الرئيس",
 "ふくち": "رَفَاهَة, خَيْر",
 "ふくちじ": "نائب الحاكم (مسؤول منتخب يعمل كنائب لحاكم ولاية أمريكية)",
 "ふくちゃ": "السَّنَة الْجَدِيدَة",
 "ふくちゅう": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "ふくちょう": "شِفَاء, تَعَافِي / إزالة التضمين, استخلاص الإشارة ((إلكترونيات) استقبال إشارة عن طريق استخراجها من الموجة الحاملة) / ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "ふくちょうき": "كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "ふくちょうそうち": "كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "ふくつ": "إِلْحَاح",
 "ふくつう": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "ふくつふとう": "عدم كلل (تصميم لا يكل)",
 "ふくとう": "استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "ふくとく": "ثَرْوَة",
 "ふくはんのう": "أَثَر جَانِبِيّ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ふくひょう": "تَجَمُّد مُجَدَّد, عُودَة التَّجَمُّد",
 "ふくびき": "يَانَصِيب",
 "ふくびくう": "جيب أنفي, جيب جانب أنفي (أي من الجيوب المزدوجة في عظام الوجه المجاورة للتجويف الأنفي والمبطنة بغشاء مخاطي متصل ببطانة تجاويف الأنف)",
 "ふくびくうえん": "التهاب الجيوب الأنفية (التهاب أحد الجيوب الأنفية)",
 "ふくびくうきかんししょうこうぐん": "بكالوريوس العلوم (درجة البكالوريوس في العلوم) / أنتيمون, إثمد (عنصر فلزي له أربعة أشكال تآصلية؛ يستخدم في مجموعة واسعة من السبائك)",
 "ふくびこう": "جيب أنفي, جيب جانب أنفي (أي من الجيوب المزدوجة في عظام الوجه المجاورة للتجويف الأنفي والمبطنة بغشاء مخاطي متصل ببطانة تجاويف الأنف)",
 "ふくびこうえん": "التهاب الجيوب الأنفية (التهاب أحد الجيوب الأنفية)",
 "ふくぶ": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "ふくぶくろ": "كيس الحظ (حاوية يسحب منها الشخص غرضاً مغلفاً بشكل عشوائي دون معرفة المحتويات) / حقيبة مفاجآت (تشكيلة من عناصر متنوعة عشوائية)",
 "ふくぶだいどうみゃくりゅう": "تمدد الشريان الأورطي البطني (تمدد الأوعية الدموية في الشريان الأورطي البطني المرتبط بالشيخوخة وارتفاع ضغط الدم)",
 "ふくぶつきあげほう": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "ふくぶん": "جملة مركبة, جملة معقدة (جملة تتكون من جملة رئيسية واحدة وجملة تابعة واحدة على الأقل) / إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / جملة تابعة, جملة ثانوية (جملة في جملة معقدة لا يمكن أن تقف وحدها كجملة كاملة وتعمل داخل الجملة كاسم أو صفة أو ظرف)",
 "ふくぶんかい": "تبادل مزدوج, تحلل مزدوج",
 "ふくへい": "كَمين / كَمِين",
 "ふくへき": "جدار البطن / إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "ふくへきのうよう": "جدار البطن",
 "ふくへきはんしゃ": "جدار البطن",
 "ふくべ": "فوغو (سمكة منتفخة تحظى بتقدير كبير كطعام شهي في اليابان ولكنها خطيرة جداً لأن الجلد والأعضاء سامة) / قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "ふくほうせい": "ثُنَائِيّ المِنْوَال (للتوزيع؛ لديه أو يحدث بمنوالين)",
 "ふくほん": "تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / مُسْتَنْسَخ, مُكَرَّر (منسوخ بشكل مطابق عن الأصل) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً) / بديل احتياطي, نسخة إضافية (شيء إضافي من نفس النوع)\nمثال: صنع نسخة للملفات",
 "ふくほんい": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "ふくほんいせい": "نظام المعدنين (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكميات محددة من معدنين (عادة الذهب والفضة) مع تحديد قيم بنسبة محددة مسبقاً)",
 "ふくぼいん": "مُصَوِّت مُزْدَوِج",
 "ふくぼく": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "ふくぼくし": "راعي, قس (شخص مخول لإقامة الشعائر الدينية)\nمثال: يُطلق عادة على رجال الدين لقب قسيس في الكنائس البروتستانتية",
 "ふくまく": "صِفَاق",
 "ふくまくえん": "التهاب البريتوان, التهاب الصفاق (التهاب الصفاق (الغشاء البريتوني))",
