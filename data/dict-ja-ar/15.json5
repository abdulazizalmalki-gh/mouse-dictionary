 "ふへいこう": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "ふへき": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض) / دعامة ساندة (دعامة عادة من الحجر أو الطوب؛ تدعم جدار المبنى)",
 "ふへん": "نَزَاهَة, حِيَاد / أَبَدِيّ\nمثال: これ不変の真理なり。 — هذه حقيقة لا تتغير. / ثَابِت, لَا يَتَغَيَّر (لَا يَتَبَدَّلُ فِي طَبِيعَتِه) / كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / قطعة قماش, قطعة مادة (جزء منفصل يتكون من القماش)",
 "ふへんか": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "ふへんかし": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "ふへんせい": "ثَبَات, لَا تَبَايُن (طبيعة كمية أو خاصية أو دالة تظل دون تغيير عند تطبيق تحويل معين عليها) / شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان)",
 "ふへんてき": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "ふへんひよう": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن…)",
 "ふへんふとう": "نَزَاهَة, حِيَاد",
 "ふへんりょう": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "ふべん": "إزعاج, إقلاق (صعوبة تسبب القلق)",
 "ふべんきょう": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "ふほ": "تَأْمِين",
 "ふほう": "غير قانوني, محظور (مخالف لـأو محظور بموجب القانون)\nمثال: إجراءات غير قانونية / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / نَعْي",
 "ふほうかんきん": "احتجاز غير قانوني, حبس زائف ((قانون) الحبس بدون سلطة قانونية)",
 "ふほうこうい": "الضرر في القانون",
 "ふほうしょじ": "حيازة غير قانونية (حيازة مواد خاضعة للرقابة)",
 "ふほうしんにゅう": "انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن)",
 "ふほうしんにゅうしゃ": "دخيل, متطفل (شخص يقتحم خصوصية أو ممتلكات آخر دون إذن)",
 "ふほうせんきょ": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من…)",
 "ふほうせんきょしゃ": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني)",
 "ふほうにゅうきょしゃ": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني)",
 "ふほうわ": "غَيْر مُشَبَّع ((للألوان) غير نقي لونيًا؛ مخفف)\nمثال: أحمر غير مشبع",
 "ふほうわかごうぶつ": "مركب غير مشبع (مركب كيميائي يحتوي على روابط كربون-كربون مزدوجة أو ثلاثية، مثل تلك الموجودة في…)\nمثال: المركبات المشبعة وغير المشبعة لا تتكون بالضرورة فقط من سلسلة ذرات كربون",
 "ふほうわしぼうさん": "حمض دهني غير مشبع (حمض دهني يمكن لسلسلة الكربون الخاصة به امتصاص ذرات هيدروجين إضافية)",
 "ふほんい": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "ふほんいながら": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "ふぼ": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "ふぼう": "تَشْهِير, اِفْتِرَاء",
 "ふぼく": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "ふぼん": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "ふま": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "ふまえる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "ふまじめ": "تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "ふまん": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "ふまんぞく": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "ふまんてん": "شِكَايَة, شَكْوَى",
 "ふまんぶんし": "سَاخِط, مُتَمَرِّد (غَيْرُ رَاضٍ تُجَاهَ السُّلْطَةِ)",
 "ふみ": "كراهية, نفور (شعور بالكراهية الشديدة) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم.",
 "ふみあと": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "ふみあらす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…)",
 "ふみあるく": "تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "ふみいし": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "ふみいた": "لَوْحَة, خَشَبَة / خُطْوَة, خَطْوَة / دَوَّاسَة",
 "ふみいる": "أَدْخَلَ\nمثال: دخل توم المبنى.",
 "ふみいれる": "دَخَلَ عَلَى (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "ふみきり": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات) / خط البداية (خط يشير إلى موقع بدء سباق أو لعبة) / عَزِيمَة",
 "ふみきりしゃだんき": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "ふみきりばん": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "ふみきる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه. / قَرَّرَ, صَمَّمَ",
 "ふみぐるま": "طاحونة الدوس (طاحونة تعمل بقوة الرجال أو الحيوانات الذين يمشون على حزام دائري أو يتسلقون درجات)",
 "ふみこえる": "هَزَمَ, غَلَبَ",
 "ふみこたえる": "تَحَمَّلَ, صَبَرَ",
 "ふみこみ": "ركن, مقصورة (تجويف صغير يفتح على غرفة أكبر)",
 "ふみこむ": "مُدَاهَمَة",
 "ふみしだく": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…)",
 "ふみた": "تَذْكِرَة / مُلْصَق, بِطَاقَة / لافِتَة\nمثال: توم وقع و أصيب. / وَرَقَة لَعْب, وَرَقَة",
 "ふみたおす": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "ふみたてる": "خُطْوَة, خَطْوَة",
 "ふみだい": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / حجر أساس, نقطة انطلاق (أي وسيلة للتقدم)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "ふみだす": "يقرب / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "ふみだん": "خُطْوَة, خَطْوَة",
 "ふみちがえる": "عثرة, كبوة (خطأ غير مقصود ولكنه محرج)\nمثال: تلا القصيدة كاملة دون عثرة واحدة",
 "ふみつぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "ふみつけ": "مَرْعَى, سْتِيب / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "ふみつける": "تَجَاهَلَ, طَنَّش",
 "ふみつぶす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…)",
 "ふみづら": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…)",
 "ふみとどまる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة…)\nمثال: الباقي ليس مهم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ふみなり": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "ふみびと": "شَاعِر, شَاعِرَة",
 "ふみふみ": "اِعْتِجَان",
 "ふみまよう": "ضَلَّ",
 "ふみめん": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…)",
 "ふみもち": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "ふみやぶる": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ:…) / اِجْتَازَ, عَبَرَ",
 "ふみん": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "ふみんしょう": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "ふみんふきゅう": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "ふむ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان. / تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "ふむき": "غير لائق بدنياً, معتل (ليس في حالة جسدية أو عقلية جيدة؛ فاقد للياقة)\nمثال: سمين وغير لائق بدنياً جداً",
 "ふめい": "غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة / مَجْهُول, مُبْهَم / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "ふめいかく": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "ふめいよ": "خزي, عار (الافتقار إلى الشرف أو النزاهة)\nمثال: استسلم لحياة العار",
 "ふめいよじょたい": "تسريح غير مشرف, طرد من الخدمة (تسريح من القوات المسلحة بسبب جريمة خطيرة (مثل التخريب أو التجسس أو الجبن أو…)",
 "ふめいりょう": "غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "ふめいろう": "اكتئاب, تجهم (صفة الحزن المفرط والكآبة)\nمثال: سادت الكآبة المكتب / قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ)\nمثال: دوافع مشكوك فيها",
 "ふめつ": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "ふめん": "وَرَقَة اَلْمُوسِيقَى, قِطْعَة مُوسِيقِيَّة",
 "ふめんだい": "حامل النوتة الموسيقية (حامل خفيف لحمل أوراق الموسيقى المطبوعة)",
 "ふめんぼく": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "ふめんもく": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "ふもう": "خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما)\nمثال: الأراضي القاحلة في وسط أفريقيا / غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة / تَشْهِير, اِفْتِرَاء",
 "ふもうのち": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "ふもと": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "ふもん": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "ふもんにふす": "تَجَاهَلَ, طَنَّش",
 "ふもんにふする": "تَجَاهَلَ, طَنَّش",
 "ふやかす": "اِبْتَلَّ",
 "ふやし": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا.",
 "ふやす": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد)\nمثال: زاد السياح عددا.",
 "ふゆ": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات…)\nمثال: ولد في فصل الشتاء.",
 "ふゆう": "غَنِيّ / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به / ذُبَابَة مَايُو, ذُبَاب مَايُو (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / زوال سريع, قصر الأمد (خاصية الاستمرار لفترة قصيرة جداً)",
 "ふゆうせいぶつ": "عَوَالِق",
 "ふゆうせんこう": "تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم)",
 "ふゆうそう": "غَنِيّ",
 "ふゆうほう": "تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم)",
 "ふゆかい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "ふゆがた": "ضغط جوي / شتوي (مميز لـأو يحدث في الشتاء)\nمثال: عانى من طقس شتوي قاسي",
 "ふゆがたきあつはいち": "ضغط جوي",
 "ふゆき": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ふゆきとどき": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "ふゆごし": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات…)\nمثال: ولد في فصل الشتاء.",
 "ふゆごもり": "إِسْبَات",
 "ふゆざくら": "كرز الشتاء, كرز القدس (شجيرة صغيرة من أمريكا الجنوبية تزرع كنبات منزلي لثمارها الحمراء أو الصفراء…)",
 "ふゆそうび": "خربق أسود, وردة عيد الميلاد (نبات أوروبي دائم الخضرة ذو أزهار شتوية بيضاء أو أرجوانية تشبه الورد)",
 "ふゆそでん": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "ふゆねぎ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ふゆのじだい": "أوقات عصيبة (وقت تسوده الصعوبات)",
 "ふゆば": "شتاء (أبرد فصول السنة)",
 "ふゆばら": "خربق أسود, وردة عيد الميلاد (نبات أوروبي دائم الخضرة ذو أزهار شتوية بيضاء أو أرجوانية تشبه الورد)",
 "ふよ": "تثاقل, تردد (درجة معينة من عدم الرغبة)\nمثال: ممانعة في إلزام نفسه / مَنَحَ / منحة وقفية, وقف (فعل منح مصدر دخل دائم)\nمثال: جاء وقفه السخي للمختبر في الوقت المناسب تماماً",
 "ふよう": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُتَقَادِم, مُهْمَل (لم يعد قيد الاستعمال) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / عشبة القطن, فيلاغو (أي نبات من جنس فيلاغو له عناقيد رأسية من رؤوس زهور صوفية صغيرة) / مُسْتَعْصٍ (بلا أمل في إيجاد حلّ)\nمثال: شك غير قابل للحل / تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ:…)",
 "ふようい": "غير مجهز, غير مستعد (دون إعداد؛ غير مستعد لـ)\nمثال: ملاحظات مرتجلة / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ふようしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة)\nمثال: مساعدي الذي لا يقدر بثمن",
 "ふようじょう": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم",
 "ふようじょうほう": "زُبَالَة\nمثال: توم عامل نفايات.",
 "ふようじん": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر)\nمثال: مجرم خطير",
 "ふようせい": "عدم القابلية للذوبان (خاصية عدم القابلية للذوبان وصعوبة الانحلال في السائل)",
 "ふようど": "الدبال",
 "ふようふきゅう": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ふようぶつ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ふようほう": "جَبَل فُوجِي, فُوجِي (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "ふようりょう": "نَفَقَة",
 "ふようりょく": "طَفْو, طُفُوّ",
 "ふようろん": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "ふよく": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "ふらく": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "ふらす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "ふらせる": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "ふらち": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة)",
 "ふらちせんばん": "مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد)",
 "ふらちもの": "فَاسِق",
 "ふらっと": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "ふらつき": "خفة عقل, دوار (نقص طائش في التعقل)",
 "ふらつきかん": "خفة عقل, دوار (نقص طائش في التعقل)",
 "ふらつき感": "خفة عقل, دوار (نقص طائش في التعقل)",
 "ふらつく": "تَرَنُّح / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه / بوتر, مضرب الإسقاط (المضرب الحديدي المستخدم عادة في المنطقة الخضراء للإسقاط)",
 "ふらふら": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة)\nمثال: مشى مترنحاً نحو المخرج / مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل)\nمثال: احتفظ بسجل لتقلبات الأسعار / بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "ふらり": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "ふらん": "حِضَانَة, تَفْرِيخ / تحليل المتجهات (تحليل حقل المتجهات)",
 "ふらんき": "حَاضِنَة",
 "ふらー": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)",
 "ふり": "تَأَرْجَحَ / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / ادعاء, تصنع (فعل إعطاء مظهر زائف)\nمثال: كان امتثاله مجرد تظاهر / وَضْعِيَّة / سَيِّئَة / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / مطر, هطول مطري (ماء يسقط في قطرات من بخار متكثف في الغلاف الجوي) / تَنَازُلِيّ / كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد)",
 "ふりあい": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ふりあおぐ": "بَحَثَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "ふりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "ふりあてる": "تعيين شخص لعمل ما",
 "ふりうごかす": "هَزَّ",
 "ふりうり": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور)",
 "ふりえき": "سَيِّئَة",
 "ふりおとす": "اِنْتَفَضَ",
 "ふりかえ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "ふりかえきゅうじつ": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "ふりかえゆそう": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "ふりかえる": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / اِلْتَفَتَ, اِسْتَدَارَ",
 "ふりかかる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "ふりかけき": "قبعة القندس (قبعة مصنوعة من فرو القندس (أو مادة مماثلة))",
 "ふりかけ器": "قبعة القندس (قبعة مصنوعة من فرو القندس (أو مادة مماثلة))",
 "ふりかざす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية.",
 "ふりかぶる": "إشهار, تلويح (فعل التلويح)",
 "ふりがな": "فُورِيغَانَا",
 "ふりきゅう": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "ふりきる": "اِنْتَفَضَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ふりこ": "نُوَاس",
 "ふりこう": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور)\nمثال: خسر المباراة بالتغيب",
 "ふりこどけい": "ساعة بندولية (ساعة يتم تنظيمها بواسطة بندول)",
 "ふりすてる": "اِنْتَفَضَ",
 "ふりそそぐ": "وَابِل, مَطَر غَزِير",
 "ふりたてる": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك)\nمثال: تم إهدار التمريرة",
 "ふりだし": "نقطة البداية (أقرب نقطة حدية) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة)\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "ふりだしぐすり": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة)\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "ふりだす": "عَدَد (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ふりつ": "محافظي, ولائي (من أو متعلق بمحافظة أو ولاية (إدارية))\nمثال: متحف الولاية",
 "ふりつけ": "تَصْمِم الرَّقْص",
 "ふりつけか": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "ふりつけし": "مُصَمِّمُ رَقْصٍ, مُصَمِّمَةُ رَقْصٍ",
 "ふりとばす": "اِنْتَفَضَ",
 "ふりはば": "سعة, مدى (عِظَم المقدار) / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد)\nمثال: اختلال هرموني",
 "ふりはらう": "اِنْتَفَضَ",
 "ふりふり": "ذُو كَشَاكِش, مُكَشْكَش (ذو كشاكش أو حواشٍ زخرفية)",
 "ふりまく": "نَثَرَ, تَفَرَّقَ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "ふりまぜる": "هَزَّ",
 "ふりまわす": "مَارَسَ (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية. / إِظْهَار, عَرْض / تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "ふりまわる": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "ふりむく": "اِلْتَفَتَ, اِسْتَدَارَ",
 "ふりむける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار. / مُنَاسِب",
 "ふりゅう": "أَنَاقَة / انجراف, تسكع (تجوال بلا هدف من مكان لآخر)",
 "ふりょ": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب) / أَسِير الْحَرْب, أَسِير (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب.",
 "ふりょう": "سَيِّئ, وحش / مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد)",
 "ふりょうか": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً))\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "ふりょうかしつけ": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "ふりょうけん": "زلة, هفوة (إساءة بسيطة)",
 "ふりょうこうい": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر)\nمثال: ورث جنوحه عن أبيه",
 "ふりょうこういしょうねん": "جانح, حدث جانح (مذنب شاب)",
 "ふりょうさいけん": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "ふりょうしょうじょ": "جانح, حدث جانح (مذنب شاب)",
 "ふりょうしょうねん": "جانح, حدث جانح (مذنب شاب)",
 "ふりょうどうたい": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "ふりょく": "أَمْوَال, ثَرْوَة / طَفْو, طُفُوّ",
