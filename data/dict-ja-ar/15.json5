 "へいめんこうさ": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "へいめんじゅうてん": "تبليط, ترصيع بالفسيفساء (فعل التزيين بالفسيفساء) / رصف فسيفسائي (المجاورة الدقيقة للأشكال في نمط)\nمثال: رصف من الأشكال السداسية",
 "へいめんず": "مخطط الطابق الأرضي (مسقط أفقي للمستوى الأرضي لمبنى)",
 "へいめんずけい": "شكل ثنائي الأبعاد, شكل مستو (شكل ثنائي الأبعاد)",
 "へいめんてき": "مُسَطَّح / سَطْحِيّ",
 "へいもんちっきょ": "إِقَامَة جَبْرِيَّة",
 "へいや": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "へいやぶ": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "へいゆ": "شِفَاء, تَعَافِي",
 "へいよう": "مُتَوَسِّط, مُعَدَّل",
 "へいらっしゃい": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)",
 "へいらん": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب.",
 "へいり": "بَالٍ",
 "へいりゃく": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "へいりょく": "قوة عسكرية, وحدة عسكرية (وحدة تكون جزءًا من خدمة عسكرية ما)\nمثال: أرسل لقيصر قوة قوامها ستة آلاف رجل",
 "へいれつ": "مُوَازٍ / مُتَوَازٍ",
 "へいれつかいろ": "دائرة توازي (دائرة مغلقة ينقسم فيها التيار إلى مسارين أو أكثر قبل إعادة الاتحاد لإكمال الدائرة)",
 "へいれつしょり": "معالجة متعددة, معالجة متوازية (معالجة متزامنة بواسطة وحدتي معالجة أو أكثر)",
 "へいろ": "فرن المجمرة المكشوفة (فرن لصنع الصلب يوضع فيه الصلب على مجمرة ضحلة وتمر فوقه ألسنة لهب الغاز المحترق والهواء الساخن) / دائرة مغلقة (دائرة كهربائية كاملة يتدفق حولها التيار أو تدور فيها إشارة)",
 "へいろほう": "طريقة الموقد المفتوح (عملية لصنع الصلب باستخدام فرن الموقد المفتوح)",
 "へいわ": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "へいわいじ": "حِفْظ سَلَام (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "へいわきょうそん": "تَعَايُش سِلْمِيّ",
 "へいわきょうぞん": "تَعَايُش سِلْمِيّ",
 "へいわこっか": "مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)",
 "へいわしそう": "سَلَامِيَّة, سِلْمِيَّة",
 "へいわしゅぎ": "سَلَامِيَّة, سِلْمِيَّة",
 "へいわしゅぎしゃ": "مُسَالِم / مُسَالِمَة",
 "へいわじょうやく": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "へいわてき": "سِلْمِيّ / مُسَالِم",
 "へいわぶたい": "فيلق السلام (منظمة مدنية ترعاها حكومة الولايات المتحدة تساعد الناس في البلدان النامية)",
 "へいわり": "سلمي, مسالم (غير مضطرب بالنزاع أو الاضطراب أو الحرب) / مَيَّالٌ لِلسَّلَام, مُسَالِم (يَمِيلُ إِلَى السَّلَامِ أَوْ ذُو طَبِيعَةٍ سِلْمِيَّة) / مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)\nمثال: أمة مسالمة",
 "へいわろんしゃ": "مُسَالِم / مُسَالِمَة",
 "へい死": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "へうっぼ": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "へえ": "مَفْهُوم",
 "へえこら": "تَمَلَّقَ, تَبَصْبَصَ",
 "へが": "رَوْث",
 "へき": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط / حَاجِز / عَقَبَة, حَاجِز / عَادَة / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / زَائِف, بَاطِل / كَاذِب / بزموت (عنصر فلزي ثلاثي التكافؤ ثقيل هش ومضاد للمغناطيسية) / مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ)",
 "へきうん": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "へきえき": "تألم, جفل (استجابة انعكاسية لألم مفاجئ) / تقطيب الألم, جفول (تعبير الوجه عن ألم مفاجئ)",
 "へきえん": "بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "へきかい": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "へきが": "تصوير جصي, فريسكو (طريقة متينة للرسم على الحائط باستخدام الألوان المائية على الجص الرطب) / أفرسكو, تصوير جصي (جدارية تُنفذ بالألوان المائية على الجص الرطب)",
 "へきがい": "خارجي (يتم تنفيذه خارج حدود مؤسسة أو مجتمع)\nمثال: رياضات خارجية",
 "へきがん": "تجويف, كوة (فجوة أو انحسار في الجدار) / تجويف, ركن (تقعر صغير) / تخصص بيئي, مكانة بيئية ((علم البيئة) وضع الكائن الحي داخل بيئته ومجتمعه (الذي يؤثر على بقائه كنوع)) / تخصص دقيق, مكانة مناسبة (منصب مناسب تماماً للشخص أو المنظمة التي تشغله)\nمثال: وجد مكانه المناسب في العالم الأكاديمي",
 "へきがんこうもう": "غَرْبِيّ",
 "へきぎょく": "يَشْب / يَشْم",
 "へきくう": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "へきぐう": "زَاوِيَة, رُكْن",
 "へきけん": "إِجْحَاف, تَحَامُل",
 "へきしょく": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "へきち": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "へきとう": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "へきとうだいいち": "أساساً, في المقام الأول (ذو أهمية أولية) / أصلاً, في المقام الأول (قبل الآن)\nمثال: هذه مسألة اقتصادية في المقام الأول",
 "へきれき": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "へき地": "أحراش, منطقة نائية (منطقة نائية وغير متطورة)",
 "へき開": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "へぎいた": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "へぎ板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "へくち": "أَتْشُو",
 "へくちっ": "أَتْشُو",
 "へこ": "شاب (مراهق أو شاب بالغ ذكر)",
 "へこき": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "へこたれる": "يَئِسَ, أُحْبِطَ",
 "へこへこ": "بتذلل, بملق (بطريقة متذللة)\nمثال: تتصرف بتذلل تجاه رئيسها",
 "へこます": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تأثير ملحوظ, نقص (عاقبة ملحوظة (خاصة التقليل)) / حز, خدش (انخفاض مخدوش أو محفور في سطح)\nمثال: أحدث نقصاً في حسابي المصرفي",
 "へこませる": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تأثير ملحوظ, نقص (عاقبة ملحوظة (خاصة التقليل)) / حز, خدش (انخفاض مخدوش أو محفور في سطح)\nمثال: أحدث نقصاً في حسابي المصرفي",
 "へこみ": "أَجْوَف\nمثال: 後ろのドアにへこみができた。 — لديهم بعجة في الباب الخلفي .",
 "へこむ": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "へさき": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "へしあう": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "へしおる": "كَسَّرَ / تَكَسَّرَ",
 "へしおれる": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / إمساك, التقاط (فعل التقاط شيء باليدين) / فرقعة الأصابع (فعل فرقعة الأصابع؛ حركة إصبع من الطرف إلى قاعدة الإبهام في نفس اليد) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "へしまげる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "へしむくれ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "へし折る": "كَسَّرَ / تَكَسَّرَ",
 "へし折れる": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / إمساك, التقاط (فعل التقاط شيء باليدين) / فرقعة الأصابع (فعل فرقعة الأصابع؛ حركة إصبع من الطرف إلى قاعدة الإبهام في نفس اليد) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "へし曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "へす": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تأثير ملحوظ, نقص (عاقبة ملحوظة (خاصة التقليل)) / حز, خدش (انخفاض مخدوش أو محفور في سطح)\nمثال: أحدث نقصاً في حسابي المصرفي",
 "へそ": "سُرَّة / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / بَكَرَة",
 "へそいのしし": "بِيكَارْيَة",
 "へそのお": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "へその緒": "حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "へそまがり": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "へそみかん": "برتقال أبو سرة (برتقال بدون بذور يحيط بثمرة ثانوية صغيرة عند القمة)",
 "へそピ": "سُرة, سُرة البطن (ندبة حيث كان الحبل السري متصلاً)\nمثال: لم يكن من المفترض أن تظهر سرتك على التلفزيون",
 "へそピアス": "سُرة, سُرة البطن (ندبة حيث كان الحبل السري متصلاً)\nمثال: لم يكن من المفترض أن تظهر سرتك على التلفزيون",
 "へそ曲がり": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "へそ曲り": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "へた": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي) / غشاء الخيشوم, غطاء الخيشوم (سديلة صلبة تعمل كغطاء (أ) لشقوق الخياشيم في الأسماك أو (ب) لفتحة الصدفة في بعض بطنيات القدم عند انكماش الجسم)",
 "へたい": "رَدِيء, مُتَخَبِّط (منفَّذ بشكل سيّئ ورديء)",
 "へたうま": "لِلْوَهْلَة اَلْأُولَى",
 "へたくそ": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "へたっぴ": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "へたのながだんぎ": "خَيْرُ الكَلَامِ مَا قَلَّ وَدَلَّ ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض)\nمثال: يبدو زيري بخير.",
 "へたばる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / يَئِسَ, أُحْبِطَ",
 "へたへた": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "へたれ": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "へたをうつ": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "へだたり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "へだつ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "へだて": "تَقْسِيم / تَفْرِيق / تَمْيِيز / اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "へだてごころ": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "へだてる": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "へちむくり": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "へちむくれ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "へちゃむくれ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "へちゃもくれ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "へっくち": "أَتْشُو",
 "へっくちっ": "أَتْشُو",
 "へっちゃら": "غير مبالٍ, غير مكترث (يفتقر إلى الاهتمام أو الرعاية أو الشعور) / غَيْرُ مُنْشَغِل, غَيْرُ مُهْتَمّ (لَيْسَ مُنْشَغِلًا أَوْ مُنْخَرِطًا فِي أَمْرٍ مَا) / غَيْرُ مُبَالٍ, غَيْرُ مُكْتَرِث (مرتاح النفس؛ غير قلق) / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "へっつい": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "へっぴり": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "へっぴりごし": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "へっぴりむし": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "へっぴり腰": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "へっぽこ": "اِخْتَرَقَ / حيلة",
 "へつらい": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "へつらう": "تَمَلَّقَ, تَبَصْبَصَ",
 "へて": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "へでもない": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "へと": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
 "へとかじはもとからさわぐ": "الْمُخْتَار, الْمُخْتَارَة",
 "へとへと": "مُسْتَنْزَف, مُنْهَك (بالغ الإرهاق والتعب الشديد)",
 "へど": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "へどがでる": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "へどが出る": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "へどもど": "تاتاة, تلعثم (اضطراب في الكلام ينطوي على تردد وتكرار لا إرادي لأصوات معينة)",
 "へどろ": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / رُسَابَة",
 "へな": "طِين, صَلْصَال",
 "へなちょこ": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / مبتدئ (شخص دخل في رهبنة دينية لكنه لم يأخذ النذور النهائية بعد)",
 "へなつち": "طِين, صَلْصَال",
 "へなへな": "بضعف (بطريقة ضعيفة أو واهنة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية)\nمثال: وافق بضعف على حل وسط / ضَعِيف",
 "へな猪口": "شخص غير ماهر, عامل غير مدرب (شخص يفتقر إلى التدريب الفني)",
 "へのかっぱ": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "へのこ": "بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية. / قَضِيب, ذَكَر",
 "へのつっぱりにもならない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "へひり": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "へひりむし": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "へび": "ثُعْبَان, حَنَش / ثُعْبَان / حَنَش (حَنَشَ (حنشه) الحنش حنشا: لدغه؛ حَنَشَ (حنشه): ساقه وطرده ويقال حنش الصيد صاده) / حَيَّة / أَفْعَى",
 "へびがみ": "إله الثعبان, زومبي (إله في طوائف الفودو ذات الأصل الأفريقي، يُعبد خاصة في جزر الهند الغربية)",
 "へびくいわし": "كَاتِب (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "へびざ": "الْحَيَّة",
 "へびつかい": "حاوي الثعابين, مروض الثعابين (فنان يستخدم الحركات والموسيقى للسيطرة على الثعابين)",
 "へびつかいざ": "الْحَوَّاء",
 "へびつかい座": "الْحَوَّاء",
 "へびとんぼ": "ذبابة دوبسون (حشرة كبيرة ناعمة الجسم لها فكوك نحيلة طويلة في الذكر؛ تستخدم اليرقات المائية غالباً كطعم)",
 "へびどく": "زعاف الثعبان, سم الأفعى (سم تفرزه بعض الثعابين)",
 "へびのなまごろし": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو الصالحة (مثل الرضع والأفراد الفاضلين)) / إهمال, نسيان (مكان خيالي للأشياء المفقودة أو المهملة) / طي الكتمان, نسيان (حالة كونه مهملاً أو منسياً)",
 "へび座": "الْحَيَّة",
 "へぶし": "أَتْشُو",
 "へぶしっ": "أَتْشُو",
 "へへ": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "へべれけ": "بلوتو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "へぼ": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة) / جودة منخفضة, دونية (جودة متدنية)",
 "へぼい": "أَخْرَق",
 "へま": "خطأ فادح, زلة (خطأ محرج) / أَخْرَق اليَدَيْن, ثَقِيل اليَد (يفتقر إلى مهارات الحركة الجسدية وخاصة في استخدام اليدين) / أَخْرَق, غَيْرُ كُفْء (يُظهر افتقارًا إلى المهارة أو الكفاءة)",
 "へみ": "ثُعْبَان, حَنَش / ثُعْبَان / حَنَش (حَنَشَ (حنشه) الحنش حنشا: لدغه؛ حَنَشَ (حنشه): ساقه وطرده ويقال حنش الصيد صاده) / حَيَّة / أَفْعَى",
 "へや": "فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / شَقَّة (نِصْف الشيء إذا شُقَّ؛ القطعة المَشْقُوقَة بشكل مستطيل من الثَوْب أو العَصَا)\nمثال: فتش ياني الشقة. / حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "へやぎ": "ملابس استرخاء (ملابس مناسبة للاسترخاء)",
 "へやご": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "へやずみ": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "へやばき": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف) / خُفّ (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "へら": "مِلْعَقَةُ الصَيْدَلِيِّ, محراك (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "へらさぎ": "أبو ملعقة الشائع (أبو ملعقة أبيض نقي ذو عرف من جنوب أوراسيا وشمال شرق أفريقيا)",
 "へらじか": "مُوظ",
 "へらす": "ضَعُفّ / أْضْعَفّ",
 "へらずぐち": "أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة) / القول الفصل (بيان موثوق ونهائي) / الكلمة الأخيرة (البيان النهائي في جدال لفظي)\nمثال: طبيبي له القول الفصل في الأدوية التي أتناولها",
 "へらへら": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء / بتهور, دون تحفظ (بدون تقدير أو حكمة أو ضبط للنفس)\nمثال: استفسرت دون تحفظ عن حالته الصحية / رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "へらり": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "へり": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / حافة, شفة (الحافة العليا لوعاء أو حاوية أخرى) / حافة بارزة, شفة (نتوء يستخدم للتقوية أو للتثبيت بجسم آخر) / إطار العجلة, جنط (الجزء الخارجي من العجلة الذي يثبت عليه الإطار) / حلقة السلة ((في كرة السلة) الطوق الذي تتدلى منه الشبكة)\nمثال: اصطدمت الكرة بالحلقة وارتدت / تزيين الحواف, حاشية (حدود تتكون من أي شيء يوضع على الحافة لإنهاء شيء ما (مثل الأهداب على الملابس أو السجاد))",
 "へりいし": "ضبط, كبح (فعل تقييد القوة أو العمل أو الحد من التجاوز) / حافة الرصيف (حافة بين الرصيف والطريق تتكون من خط من أحجار الرصيف (عادة ما تشكل جزءاً من المزراب)) / شكيمة كبح, لجام بالسلسلة (شكيمة حصان بسلسلة أو حزام ملحق لكبح الحصان)\nمثال: حسه السليم هو لجام لمزاجه السريع",
 "へりかめむし": "بق الأرجل الورقية, كوريد (بق حقيقي)",
 "へりくつ": "سَفْسَطَة, مُغَالَطَة",
 "へりくつや": "سَفْسَطِيّ, سَفْسَطَائِيّ",
 "へりつき": "خَشِن الحَوَافّ (ذو حافة خشنة غير مستوية؛ يوصف به الورق اليدوي أو ما يشبهه)",
 "へりとり": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "へる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِخْتَرَقَ, نَفَذَ / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "へろへろ": "مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)",
 "へをこく": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "へをひってしりすぼめ": "هُنَاكَ, يُوجَدُ",
 "へをひってしりつぼめ": "هُنَاكَ, يُوجَدُ",
 "へをひる": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "へん": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / مُفَاجِئ / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / حَادِث, حَادِثَة / تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / جَانِب / صَفْحَة / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "へんあい": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز) / محاباة, محسوبية (الميل لتفضيل شخص أو مجموعة على حساب الآخرين)",
 "へんあつ": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "へんあつき": "مُحَوِّل / محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "へんい": "إِزَاحَة, نُزُوح / إِزَاحَة / تَرَاوُح, اِخْتِلَاف / طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى) / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / إِنْحِرَاف / نَوْبَة",
 "へんいかぶ": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "へんいき": "مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟ / مدى, قدرة / مَدَى",
 "へんいけい": "تَرَاوُح, اِخْتِلَاف",
 "へんいげん": "مُطَفِّر",
 "へんいたい": "حيوان متحول, طافر (حيوان خضع لطفرة جينية) / طافر, متحول (يميل للخضوع لطفرة أو ناتج عنها) / طافر, طفرة ((في علم الأحياء) كائن حي له خصائص ناتجة عن تغيير كروموسومي)\nمثال: جين طافر",
 "へんえい": "ذرة, نقطة صغيرة (بقعة صغيرة جداً) / ذرة, رشة (كمية طفيفة ولكن محسوسة) / ذرة, هباءة ((الاستخدام غير التقني) قطعة صغيرة جداً من أي شيء)\nمثال: كانت الطائرة مجرد نقطة في السماء",
 "へんえき": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "へんえん": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "へんえんけい": "جهاز حوفي (نظام من الهياكل العصبية المرتبطة وظيفياً في الدماغ والتي تشارك في السلوك العاطفي)",
 "へんおんどうぶつ": "ذوات الدم البارد, كائن متغير الحرارة (حيوان تتغير درجة حرارة جسمه مع درجة حرارة محيطه؛ أي حيوان باستثناء الطيور والثدييات)",
 "へんか": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / اِخْتِلَاف / تنغيم, عروض (أنماط الضغط والتنغيم في اللغة) / تعديل الصوت (طريقة في التحدث يتم فيها تعديل جهارة أو حدة أو نبرة الصوت) / انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / إِعْرَاب, تَصْرِيف (تغيير في شكل الكلمة (عادة بإضافة لاحقة) للإشارة إلى تغيير في وظيفتها النحوية)",
 "へんかい": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "へんかきゅう": "رمية منحنية, كرة مقوسة (رمية كرة بيسبول يتم رميها بدوران بحيث ينحني مسارها عند اقترابها من الضارب)",
 "へんかく": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي) / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / مِيل / جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "へんかくかつよう": "فِعْل غَيْر مُنْتَظِم, فِعْل شَاذّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "へんかけい": "تَرَاوُح, اِخْتِلَاف",
 "へんかりょう": "تَرَاوُح, اِخْتِلَاف",
 "へんかん": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "へんかんき": "محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "へんかんし": "تحميل, نقل (فعل أخذ الركاب أو البضائع على متن المركبة) / التقاط, جمع (فعل أو عملية الالتقاط أو الجمع من أماكن مختلفة) / خرطوشة, لاقط (محول كهروصوتي وهو جزء من ذراع مشغل الأسطوانات الذي يحمل الإبرة ويكون قابلاً للإزالة) / بيك أب, شاحنة بيك أب (شاحنة خفيفة بجسم مفتوح وجوانب منخفضة وباب خلفي)\nمثال: جمع القمامة يتم في أيام الاثنين والخميس",
 "へんかんずみ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "へんがん": "شيست (أي صخر متحول يمكن شقه إلى طبقات رقيقة)",
 "へんき": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "へんきごう": "مُسَطَّح",
 "へんきゃく": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "へんきょう": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة) / انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة) / تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "へんきょうはく": "مركيز (نبيل (في بلدان مختلفة) برتبة أعلى من كونت)",
 "へんきょく": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية. / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "へんきょくか": "معد موسيقي, موزع موسيقي (موسيقي يقوم بتكييف مقطوعة موسيقية لأصوات أو آلات معينة أو لأسلوب أداء آخر) / مرتب, منظم (شخص يحقق النظام والتنظيم في مؤسسة ما)\nمثال: كانت هي منظمة الاجتماع",
 "へんきょくしゃ": "معد موسيقي, موزع موسيقي (موسيقي يقوم بتكييف مقطوعة موسيقية لأصوات أو آلات معينة أو لأسلوب أداء آخر) / مرتب, منظم (شخص يحقق النظام والتنظيم في مؤسسة ما)\nمثال: كانت هي منظمة الاجتماع",
 "へんきん": "إِعَادَة مَال",
 "へんくつ": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "へんけい": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / اِخْتِلَاف",
 "へんけいきん": "عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "へんけいせいかんせつしょう": "فُصَال عَظْمِيّ",
 "へんけいたい": "بلازموديوم, متصورة (أوالي طفيلي من جنس المتصورة يسبب الملاريا لدى البشر) / بلازموديوم (طبقة متعددة الأنوية من السيتوبلازم تميز بعض مراحل الكائنات الحية مثل العفن الغروي)",
 "へんけいちゅうるい": "أَمِيبَا, مُتَحَوِّلَة",
 "へんけいどうぶつ": "دُودَة مُسَطَّحَة",
 "へんけいどうぶつもん": "دودة مفلطحة (ديدان طفيلية أو حرة المعيشة لها جسم مسطح)",
 "へんけいぶんぽう": "النحو التوليدي (القصد؛ المثال)\nمثال: لا أجيد قواعد النحو.",
 "へんけん": "إِجْحَاف, تَحَامُل",
 "へんげ": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر) / الحُلُول / التَّجَسُّد, التَّأَنُّس / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / اِحْتَقَرَ / استنكف / استخف",
 "へんげん": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "へんげんじざい": "سُرْيَالِيّ, فَانْتَاسْمَاغُورِيّ (يتّسم بصور خيالية غريبة وتجاورات غير متوقّعة)",
 "へんげんせいしゃ": "بالجانب العريض, بكامل الجانب (بجانب يواجه شيئاً ما) / رماية جانبية (إطلاق النار المتزامن لجميع الأسلحة على جانب واحد من سفينة حربية) / عَرْضِيّ (باتجاه الجانب الكامل؛ على عرض الشيء) / جانب السفينة (الجانب الكامل للسفينة من المقدمة إلى المؤخرة)\nمثال: صدم القطار الشاحنة من جانبها العريض",
 "へんげんせきご": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "へんこ": "مُتَعَنِّت, عَنِيد / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "へんこう": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية) / ميل / اِنْحِيَاز / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / مُتَغَيِّر",
 "へんこうかのう": "قَابِل لِلتَّعْدِيل (قادر على أن يُعدل في الشكل أو الشخصية أو القوة (خاصة بجعله أقل تطرفاً))\nمثال: إيقاع الوقت الفسيولوجي غير قابل للتعديل إلا عن طريق التدخل في عمليات أساسية معينة",
 "へんこうせい": "نَجْم مُتَغَيِّر (نجم يتغير سطوعه بشكل ملحوظ)",
 "へんこうてき": "مُتَحَيِّز",
 "へんこうふのう": "ثَابِت, غَيْر قَابِل لِلتَّغْيِير (غير قابل للتغيير أو الخضوع للتغيير)\nمثال: جزء ثابت وغير قابل للتغيير من البلازما الجرثومية",
 "へんごく": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو الصالحة (مثل الرضع والأفراد الفاضلين)) / إهمال, نسيان (مكان خيالي للأشياء المفقودة أو المهملة) / طي الكتمان, نسيان (حالة كونه مهملاً أو منسياً)",
 "へんさ": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحراف (حركة مؤشر أو قلم أداة قياس من موضع الصفر الخاص به) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "へんさい": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام) / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "へんさち": "إِنْحِرَاف",
 "へんさん": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "へんさんしゃ": "مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد) / مُحَرِّر, مُحَرِّرَة (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
 "へんざい": "وجود في كل مكان, وجود كلي (حالة الوجود في كل مكان في آن واحد (أو ما يبدو كذلك)) / خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "へんし": "قتل, موت عنيف (حدث يتسبب في موت شخص ما) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "へんしつ": "تَحَيُّز / تَغَيُّر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟ / تحريف, قلب الحقائق (فعل تحريف الشيء (تحويله لاستخدام خاطئ)) / انحراف جنسي, شذوذ (ممارسة جنسية شاذة) / التواء عكسي (منحنى يعكس اتجاه شيء ما)\nمثال: كان ذلك تحريفاً للعدالة",
 "へんしつきょう": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "へんしつしゃ": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "へんしつしょう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "へんしつしょうかんじゃ": "بَارَانُويِيّ",
 "へんしつてき": "بَارَانُويِيّ",
 "へんしゃ": "التواء, انحراف (صفة الميل وعدم الاستقامة في المسار) / انحراف, ميلان (خاصية عدم التوازي أو التعامد، بل التواجد بزاوية مائلة) / مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد) / مُحَرِّر, مُحَرِّرَة (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
 "へんしゅ": "اِخْتِلَاف / غَشَّ, جَدَعَ",
 "へんしゅう": "تَحَيُّز / سكيف, قارب صغير (أي من القوارب الصغيرة المتنوعة التي تدفع بالمجاديف أو الأشرعة أو المحرك) / تحرير, تنقيح (وضع شيء ما (مثل عمل أدبي) في شكل مقبول)",
 "へんしゅうきょう": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
