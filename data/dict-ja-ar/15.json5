 "べいこくくうぐんしかんがっこう": "أكاديمية القوات الجوية الأمريكية (مدرسة لتدريب الرجال والنساء ليصبحوا ضباطاً في القوات الجوية الأمريكية)",
 "べいこくぐんせいふ": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいこくげかがっかい": "تيار متردد (تيار كهربائي يعكس اتجاهه بشكل جيبي)\nمثال: في الولايات المتحدة، معظم التيار المنزلي هو تيار متردد بتردد 60 دورة في الثانية",
 "べいこくこうけつあつがっかい": "رَمَاد, سَكَن",
 "べいこくじん": "أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "べいこくせいしょきょうかい": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة…)",
 "べいこくちしつがっかい": "إدارة الخدمات العامة (وكالة إدارة مركزية تضع السياسة الفيدرالية للمشتريات الفيدرالية وإدارة الممتلكات…)",
 "べいこくちゅうさいきょうかい": "تمدد الشريان الأورطي البطني (تمدد الأوعية الدموية في الشريان الأورطي البطني المرتبط بالشيخوخة وارتفاع ضغط…)",
 "べいこくちりがっかい": "فضة (عنصر معدني أبيض ناعم وثمين وأحادي التكافؤ له أعلى موصلية كهربائية وحرارية من أي…)",
 "べいこくどあんぜんほしょうしょう": "وزارة الأمن الداخلي (الإدارة الفيدرالية التي تدير جميع المسائل المتعلقة بالأمن الداخلي)",
 "べいこくべんごしきょうかい": "قماش العباءة (قماش منسوج من شعر الماعز وشعر الإبل)",
 "べいこくみん": "أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "べいこくみんせいふ": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいこくゆうせいこうしゃ": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا…)",
 "べいこくゆしゅつにゅうぎんこう": "إكسابايت, إكسبي بايت (وحدة معلومات تساوي 1024 بيبي بايت أو 2 أس 60 بايت)",
 "べいご": "اَلْإِنْجِلِيزِيَّة اَلْأَمْرِيكِيَّة",
 "べいごま": "دُوَّامَة, بُلْبُل",
 "べいしきしゅうきゅう": "كُرَة الْقَدَم الْأَمْرِيكِيَّة, الكُرة الأَمْرِيكِيّة",
 "べいしゅう": "أَمْرِيكَا, أَمِيرِكَا",
 "べいしゅうきこう": "منظمة الدول الأمريكية (رابطة تضم معظم البلدان في نصف الكرة الغربي؛ أنشئت عام 1948 لتعزيز التعاون…)",
 "べいしゅうれんごう": "اتحاد عموم أمريكا (الوكالة الإدارية لمنظمة الدول الأمريكية)",
 "べいじゅう": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "べいじょういん": "مجلس الشيوخ الأمريكي (المجلس الأعلى في الكونغرس الأمريكي)",
 "べいじん": "أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "べいすぎ": "أرز أحمر (خشب محمر عطري لأي من أشجار الأرز الأحمر المختلفة)",
 "べいせいふ": "الولايات المتحدة, حكومة الولايات المتحدة (الفروع التنفيذية والتشريعية والقضائية للحكومة الفيدرالية للولايات المتحدة)",
 "べいぞく": "اَلْإِنْجِلِيزِيَّة اَلْأَمْرِيكِيَّة",
 "べいだいとうりょう": "الرئيس, رئيس الولايات المتحدة (منصب رئيس دولة الولايات المتحدة)\nمثال: يتم انتخاب الرئيس كل أربع سنوات",
 "べいちゅう": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいちょう": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいつが": "تسوغا غربية (شجرة دائمة الخضرة طويلة من غرب أمريكا الشمالية؛ شجرة خشب مهمة تجارياً)",
 "べいとうぶじかん": "توقيت المنطقة الشرقية (التوقيت القياسي في المنطقة الزمنية الخامسة غرب غرينتش، يحسب عند خط الطول 75…)",
 "べいどく": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいばく": "غَلَّة",
 "べいふつ": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいふん": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "べいぼくせんそう": "أمريكي مكسيكي (مكسيكي (أو شخص من أصل مكسيكي) يعيش في الولايات المتحدة)",
 "べいりくぐん": "الجيش الأمريكي (جيش الولايات المتحدة الأمريكية؛ الوكالة التي تنظم وتدرب الجنود للحرب البرية)",
 "べいるり": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "べいろ": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べいトン": "طن أمريكي, طن قصير (وحدة وزن أمريكية تعادل 2000 رطل)",
 "べいドル": "دُولَار أَمْرِيكِيّ",
 "べいロ": "الْوِلَايَاتُ الْمُتَّحِدَة",
 "べえごま": "دُوَّامَة, بُلْبُل",
 "べからざる": "عَجَزَ, لَا يَسْتَطِيع",
 "べからず": "عَجَزَ, لَا يَسْتَطِيع",
 "べかりけり": "يَنْبَغِي أَنْ\nمثال: يا لها من جملة!",
 "べき": "يَنْبَغِي أَنْ\nمثال: يا لها من جملة! / أُسّ",
 "べききゅうすう": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "べきこん": "جَذْريّ",
 "べきしすう": "أُسّ",
 "べきじょう": "أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة)",
 "べきじょうそく": "قانون القوة, قانون ستيفنز ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع قوة…)",
 "べきすう": "أُسّ",
 "べきとう": "عَدِيم الأَثَر الذَّاتِيّ (لا تتغيّر قيمته عند ضربه بنفسه)",
 "べきべき": "تلاطم, موجة عارمة (موجة بحرية كبيرة)",
 "べきれい": "معدوم القوى (يساوي صفراً عند رفعه لقوة معينة)",
 "べき乗": "أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة)",
 "べき乗則": "قانون القوة, قانون ستيفنز ((فيزياء نفسية) المفهوم القائل بأن حجم الإحساس الذاتي يزداد بما يتناسب مع قوة…)",
 "べき指数": "أُسّ",
 "べき根": "جَذْريّ",
 "べき級数": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "べき零": "معدوم القوى (يساوي صفراً عند رفعه لقوة معينة)",
 "べく": "لِكَي, لِ / وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "べくして": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "べこ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "べこべこ": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))\nمثال: أحدث نقصاً في حسابي المصرفي / سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "べし": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه. / إرَادَة",
 "べそべそ": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "べた": "جَمِيع أَنْحَاء, كُلّ / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / طباعة بالتلامس (مطبوعة مصنوعة عن طريق تعريض سطح حساس للضوء للتلامس المباشر مع سلبية فوتوغرافية)",
 "べたあし": "قدم مسطحة (قدم مصابة بهبوط القوس؛ مسطحة ومنبسطة بشكل غير طبيعي)",
 "べたうち": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى…)",
 "べたっと": "مَعًا, سَوِيًّا / تَحْتَ, تَحْت (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "べたべた": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / جَمِيع أَنْحَاء, كُلّ / تَمَسَّكَ",
 "べたぼれ": "بتهور, رأساً على عقب (في عجلة مضطربة)",
 "べたやき": "طباعة بالتلامس (مطبوعة مصنوعة عن طريق تعريض سطح حساس للضوء للتلامس المباشر مع سلبية فوتوغرافية)",
 "べた足": "قدم مسطحة (قدم مصابة بهبوط القوس؛ مسطحة ومنبسطة بشكل غير طبيعي)",
 "べち": "تَمْيِيْز / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / اِسْتِثْنَاء / طِبْقًا لِـ, وَفْقًا لِـ",
 "べちだん": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "べちゃべちゃ": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود))",
 "べちょべちょ": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود))",
 "べっかく": "خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "べっかん": "توسعة, جناح (إضافة توسع المبنى الرئيسي)",
 "べっき": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "べっきょ": "تَفْرِقَة",
 "べっけん": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "べっけんこん": "عالم آخر, عالم الغيب (عالم روحي مجرد يقع خارج حدود الواقع الدنيوي)",
 "べっこ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "べっこう": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "べっこうあめ": "مُلَبَّسَة",
 "べっこういろ": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد…)",
 "べっこう飴": "مُلَبَّسَة",
 "べっこん": "أُلْفَة",
 "べっさつ": "ملحق",
 "べっし": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / اِحْتِقَار, اِزْدِرَاء",
 "べっしつ": "سُرِّيَة",
 "べっして": "خُصُوصًا, خَاصَّةً",
 "べっしょう": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو…)\nمثال: الانفصالي مرادف للعاهرة. / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "べっせい": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "べっそう": "منزل عطلات (مسكن (منزل ثانٍ) تعيش فيه أثناء العطلة) / سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "べった": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "べったこ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "べったり": "غُصَيْن\nمثال: لا تمسك العصا من الوسط. / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب. / جَمِيع أَنْحَاء, كُلّ",
 "べっちん": "مخمل قطني (قماش عادة ما يكون قطنياً بوبر قصير يقلد المخمل)",
 "べってい": "منزل عطلات (مسكن (منزل ثانٍ) تعيش فيه أثناء العطلة)",
 "べってん": "مَوَدَّة\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "べっと": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "べっとう": "مَبْنى خَارِجِيّ (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى. / سَائِس / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "べっとり": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "べっ甲": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "べつ": "تَمْيِيْز / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / اِسْتِثْنَاء / طِبْقًا لِـ, وَفْقًا لِـ / سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة)",
 "べつぎょう": "فِيلَا, دَارَة",
 "べつげんすれば": "وَبِعِبَارَة أُخْرَى",
 "べつじ": "حادث مؤسف, نحس (حالة من سوء الحظ)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق",
 "べつじたて": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب)",
 "べつじょ": "احتقار, ازدراء (شعور بالكراهية المصحوبة بالاحتقار)",
 "べつじょう": "حادث مؤسف, نحس (حالة من سوء الحظ)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق",
 "べつずり": "نبذة – مقتطفات من",
 "べつだん": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "べつとして": "غَيْر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "べつなく": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "べつに": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع)\nمثال: كان دقيقاً بشكل خاص حول التهجئة / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "べつにいいけど": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "べつはいたつ": "تسليم خاص (بريد يتم تسليمه بواسطة ناقل خاص (مقابل رسوم إضافية))",
 "べつべつ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "べつべつに": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "べつみょう": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو…)\nمثال: الانفصالي مرادف للعاهرة. / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "べつむね": "مَبْنى خَارِجِيّ (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: دخل توم المبنى.",
 "べつめい": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو…)\nمثال: الانفصالي مرادف للعاهرة. / المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "べつもの": "اِسْتِثْنَاء",
 "べつやく": "تَرَاوُح, اِخْتِلَاف",
 "べつよう": "مُخْتَلِف\nمثال: أرني مثالا آخر.",
 "べつり": "فِرَاقٌ",
 "べつわく": "إِضَافِيّ (إِضافيّ : ما يُضاف ، ما يُزاد؛ ما يُتْبَع شيئاً آخر ، ما يُلْحَق به ، ما يُزاد…)\nمثال: ستعطيني بطانية إضافية.",
 "べつアカ": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "べとびょう": "بياض زغبي, بياض كاذب (أي من الفطريات المختلفة من فصيلة بيرونوسبوراسيا تتطفل على العنب والبطاطس…)",
 "べとべと": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "べと病": "بياض زغبي, بياض كاذب (أي من الفطريات المختلفة من فصيلة بيرونوسبوراسيا تتطفل على العنب والبطاطس…)",
 "べに": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين)",
 "べにいも": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "べにいろ": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "べにうちわ": "أنتوريوم, زهرة الفلامنغو (أي من النباتات الأمريكية الاستوائية المتنوعة التي تُزرع لأوراقها وأزهارها…)",
 "べにおしろい": "مَاكْيَاج, بُنْيَة",
 "べにがい": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة)",
 "べにぎょくずい": "عقيق أحمر, كارنيليان (نوع أحمر أو برتقالي نصف شفاف من الكالسيدوني)",
 "べにさしゆび": "بِنْصِر",
 "べにざけ": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام…)",
 "べにじゃけ": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام…)",
 "べにづる": "بَشْرُوش, نُحَام",
 "べにてんぐたけ": "أمانيت مسكاري, فطر الذباب (فطر غابات سام (ولكن نادراً ما يكون قاتلاً) له قبعة قرمزية مع ثآليل بيضاء…)",
 "べにはこべ": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "べにばすもも": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "べにばな": "مُرِّيق, مُرَّيْق",
 "べにばないんげん": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا)",
 "べにばなゆ": "زيت العصفر (زيت مستخرج من بذور نبات العصفر)",
 "べにます": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام…)",
 "べにみょうれんじ": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد…)",
 "べにむらさき": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "べに花油": "زيت العصفر (زيت مستخرج من بذور نبات العصفر)",
 "べべ": "مَلَابِس, ثِيَاب / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "べべた": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "べら": "لبروسية (أسماك بحرية استوائية بشكل رئيسي ذات شفاه لحمية وأسنان قوية؛ عادة ما تكون زاهية…)",
 "べらべら": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / رَفِيع, رَقِيق",
 "べらぼう": "الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / عَبَثِيّ, سَخِيف / مُغَفَّل, أَحْمَق",
 "べらやす": "لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)",
 "べらんめい": "طُوكْيَوِيّ",
 "べらんめえ": "طُوكْيَوِيّ",
 "べりべり": "بإسهاب, بثرثرة (بطريقة ثرثارة)",
 "べろ": "لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان.",
 "べろちゅう": "قُبْلَة فَرَنْسِيَّة",
 "べろっと": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)\nمثال: كانت هزيمة بفارق ضئيل",
 "べろべろ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)\nمثال: كانت هزيمة بفارق ضئيل / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "べろり": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "べろんべろん": "ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد)",
 "べん": "مُلَاءَمَة, مُنَاسَبَة / إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم) / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / بِنْتُو / بَتَلَة, تُوَيْجَة",
 "べんえき": "مُلَاءَمَة, مُنَاسَبَة",
 "べんかい": "تَفْسِير, شَرْح",
 "べんがく": "ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس.",
 "べんき": "حوض المرحاض (حوض المرحاض الذي يمكن شطفه بالماء)",
 "べんきょう": "ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس. / اِجْتِهَاد / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "べんきょうになる": "تثقيفي, تنويري (تنويري أو رافع للمعنويات بما يشجع على التحسن الفكري أو الأخلاقي)\nمثال: اللوحات في الكنيسة خدمت غرضاً تهذيبياً حتى لأولئك الذين لا يستطيعون القراءة",
 "べんきょうねっしん": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "べんぎ": "مُلَاءَمَة, مُنَاسَبَة",
 "べんぎしゅぎ": "انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "べんぎてき": "مُنَاسِب, مُلَائِم",
 "べんけい": "تَفَقُّد",
 "べんけいごうし": "ترتان, قماش كاروهات (قماش ذو تصميم متقاطع)",
 "べんけいじま": "تَفَقُّد",
 "べんけいそう": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "べんけいのなきどころ": "عَقِب أَخِيل, كَعْب أَخِيل",
 "べんこう": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "べんご": "دِفَاع, حِمَايَة",
 "べんごいらいにん": "زَبُون, مُشْتَرٍ\nمثال: سامي عميل فدرالي.",
 "べんごがわ": "دفاع (فعل الدفاع عن شخص أو شيء ضد هجوم أو إصابة)\nمثال: الملاكم الجيد يحتاج إلى دفاع جيد",
 "べんごし": "مُحَامٍ, مُحَامِيَة",
 "べんごしひよう": "أتعاب قانونية (رسم يُدفع مقابل خدمة قانونية)",
 "べんごしゃ": "دَاعِم, مُؤَيِّد",
 "べんごだん": "الدفاع, فريق الدفاع (المتهم ومستشاروه القانونيون مجتمعين)\nمثال: طلب الدفاع بطلان المحاكمة",
 "べんごにん": "شُورَى\nمثال: نصح مناد بباية.",
 "べんさい": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة…) / استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً)",
 "べんさいるい": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين…)",
 "べんざ": "مَقْعَد الْمِرْحَاض (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "べんし": "مُحَاضِر, مُحَاضِرَة",
 "べんしゃ": "خَطِيب, مُتَكَلِّم",
 "べんしゅつ": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "べんしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة)",
 "べんしょうがく": "دِفَاعِيَّات",
 "べんしょうきん": "إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ)\nمثال: كيف يمكنني التكفير عن خطئي",
 "べんしょうほう": "جدلية",
 "べんしょうほうてき": "جدلية",
 "べんしょうほうてきゆいぶつろん": "مادية جدلية (الفلسفة المادية لكارل ماركس وفريدريك إنجلز)",
 "べんしょうろん": "دِفَاعِيَّات",
 "べんしんろん": "ثيوديسيا, عدالة الإله (فرع اللاهوت الذي يدافع عن صلاح الله وعدله في مواجهة وجود الشر)",
 "べんじょ": "مِرْحَاض, تواليت",
 "べんじる": "رَضَّى / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "べんずる": "رَضَّى / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "べんせんけつ": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل)",
 "べんぜつ": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "べんそ": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "べんたつ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "べんだ": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب)",
 "べんち": "جُسْأَة",
 "べんちたい": "جسم ثفني (مسلك عصبي مستعرض عريض يربط نصفي الكرة المخية)",
 "べんつう": "حركة الأمعاء (تعبير مهذب للتبرز)\nمثال: كان لديه حركة أمعاء",
 "べんとう": "بِنْتُو",
 "べんなん": "استنكار, تنديد (فعل علني للتنديد)",
 "べんねい": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "べんばく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "べんぱく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "べんぱつ": "ضَفِيرَة صَغِيرَة (جديلة من الشعر المضفر)",
 "べんぴ": "إِمْسَاك",
 "べんぴしょう": "إِمْسَاك",
 "べんべつ": "تَمْيِيْز",
 "べんべついき": "عتبة الفارق, عتبة تفاضلية (أصغر تغيير في التحفيز يمكن للشخص اكتشافه)",
 "べんべつそせい": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "べんべつてき": "مُمَيَّز, نَمُوذَجِيّ (خاصّ بسمة تساعد في التمييز بين الأشخاص أو الأشياء)",
 "べんべつてきそせい": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "べんべつてきとくちょう": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "べんべら": "بَالٍ",
 "べんべん": "مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز) / باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "べんべんだらり": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
