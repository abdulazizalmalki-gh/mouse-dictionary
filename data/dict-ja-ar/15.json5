 "ほじょきおくそうち": "تخزين خارجي, تخزين مساعد (جهاز تخزين بيانات ليس الذاكرة الرئيسية للحاسوب)",
 "ほじょきかん": "محرك مساعد ((بحري) محرك صغير (مثل الذي يستخدم على متن السفن لتشغيل الرافعة))",
 "ほじょきん": "إِعَانَة مَالِيَّة",
 "ほじょけん": "قَسِيمَة",
 "ほじょしゃ": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "ほじょそうち": "معدات غير متصلة, معدات مساعدة (معدات إلكترونية ليست في اتصال مباشر (أو تحت سيطرة) وحدة المعالجة المركزية)",
 "ほじょつうか": "عملة كسرية (عملة ورقية بفئات أقل من الوحدة النقدية الأساسية)",
 "ほじょていり": "سُدَّة, لِيمَّا",
 "ほじょてき": "إِضَافِيّ, تَكْمِيلِيّ (يعمل في صفة داعمة ومساندة) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / مساعد (شخص يعمل كمساعد)",
 "ほじょどうし": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "ほじょひ": "إِعَانَة مَالِيَّة",
 "ほじょもとちょう": "دفتر أستاذ مساعد (تفاصيل حساب تدعم المبلغ المذكور في دفتر الأستاذ العام)",
 "ほじょよく": "جنيح (سطح انسيابي يتحكم في الحركة الجانبية)",
 "ほじょりん": "مثبت, موازن (جهاز لجعل شيء ما مستقراً) / مثبت (سطح انسيابي يتكون من جهاز لتثبيت الطائرة) / مادة مثبتة, مثبت (مادة كيميائية تضاف إلى محلول أو خليط أو معلق للحفاظ عليه في حالة مستقرة أو غير متغيرة)",
 "ほじる": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "ほす": "هَوَاء (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ) / جَوّ / نَغَم\nمثال: أخرجي الهواء من فمك. / بَالُوعَة",
 "ほすいざい": "حافظ للرطوبة, مادة مرطبة (أي مادة تضاف إلى مادة أخرى للحفاظ على رطوبتها)",
 "ほすう": "عُمْدَة",
 "ほすうけい": "مقياس الخطوات (أداة قياس لتسجيل عدد الخطوات المقطوعة في المشي)",
 "ほする": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء. / تعيين شخص لعمل ما",
 "ほせい": "تَصْحِيح",
 "ほせき": "حَجَر رَصْف (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "ほせん": "اِنْتِخَابَات تَكْمِيلِيَّة",
 "ほぜん": "مُحَافَظَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "ほぜんかい": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "ほぜんがいしゃ": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "ほぜんせい": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "ほそ": "نَحِيف, أَهْيَف / ضَيْق",
 "ほそい": "رَفِيع, رَقِيق / ضعيف, ضعيفة / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "ほそいと": "فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "ほそう": "تبليط, رصف (فعل وضع مواد الرصف على منطقة ما) / رصيف (السطح المرصوف لطريق عام) / رصف, مادة رصف (مادة تستخدم لرصف منطقة ما)",
 "ほそうきかい": "آلة رصف (آلة لرصف الطرق)",
 "ほそえだ": "غُصَّيْن",
 "ほそく": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / اعتقال, قبض (فعل القبض (خاصة القبض على مجرم)) / إدراك, استيعاب (الحالة المعرفية لشخص يفهم) / تخوف, توجس (توقع مؤلم أو شعور بالقلق من المستقبل) / توجس, خشية (توقع أو تحسب خائف)\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم / ملحق / مُكَمِّل",
 "ほそくざい": "نَبَّاش, قَمَّام",
 "ほそくてき": "تَكْمِيلِيّ, مُكَمِّل (يعمل كمُكمِّل لشيء يُتمِّم الكلّ) / تَكَامُلِيّ ((للكلمات أو القضايا) مترابطة بحيث كل منها نفي للآخر) / لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "ほそくびごみむし": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "ほそじま": "مُخَطَّط بِخُطُوط رَفِيعَة (ذو خطوط رفيعة جدًّا)",
 "ほそっこい": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "ほそつ": "جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "ほそなわ": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "ほそね": "جذير (جذر صغير أو انقسام للجذر)",
 "ほそびき": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "ほそぼそ": "فَقِير / مِسْكِين / فُقَرَاء",
 "ほそまる": "ضَيِّق",
 "ほそみ": "ضَيِّق / نَحِيف, أَهْيَف",
 "ほそむぎ": "زوان إنجليزي, زوان معمر (عشبة أوروبية معمرة تزرع على نطاق واسع للمراعي والتبن وكعشبة مروج)",
 "ほそめに": "قَلِيلًا",
 "ほぞ": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي) / سُرَّة / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / لسان, نقر (نتوء في نهاية قطعة من الخشب يُشكل ليتناسب مع نقر (فتحة) لتكوين وصلة تعشيق)",
 "ほぞあな": "نقر (ثقب مربع مصنوع لاستقبال اللسان وتشكيل وصلة)",
 "ほぞう": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "ほぞをかためる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "ほぞを固める": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "ほぞん": "مُحَافَظَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة. / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "ほぞんこ": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "ほぞんざい": "مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ほぞんしょり": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "ほぞんじょうたい": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "ほぞんてき": "مُحَافِظ",
 "ほぞんりょう": "مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ほぞ穴": "نقر (ثقب مربع مصنوع لاستقبال اللسان وتشكيل وصلة)",
 "ほた": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "ほたい": "ميزاب حركي (إحدى المناطق الخمس على السطح السفلي لشوكيات الجلد التي توجد عليها الأقدام الأنبوبية) / عُمْدَة",
 "ほたえる": "اِسْتَغَلَّ",
 "ほたぎ": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "ほたら": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "ほたる": "يَرَاعَة, حُبَاحِب",
 "ほたるいし": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
