 "ふっころんしゃ": "رجعي",
 "ふっさん": "حمض الهيدروفلوريك (حمض سائل سام ضعيف؛ يتكون من ذوبان فلوريد الهيدروجين في الماء)",
 "ふっせき": "زيوليت (أي من عائلة المعادن الزجاجية المشابهة للفلدسبار والتي تحتوي على سيليكات…)",
 "ふっそ": "فُلُور",
 "ふったりやんだり": "أحياناً, بشكل متقطع (ليس بانتظام)\nمثال: يهاتفان بعضهما بشكل متقطع",
 "ふっつり": "فَجْأَةً",
 "ふってい": "عَجْز, نَقْص",
 "ふってわいた": "فَجْأَةً, عَلَى حِينِ غِرَّةٍ",
 "ふってん": "احتقان, نقطة الغليان (أن يكون المرء غاضباً جداً أو منفعلاً؛ جاهز للانفجار)\nمثال: بعد ساعة من الانتظار كنت عند نقطة الغليان",
 "ふっと": "فَجْأَةً",
 "ふっとう": "غَلَيَان / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً)\nمثال: تطلع إلى إثارة اليوم / طيران شراعي (نشاط الطيران بطائرة شراعية)",
 "ふっとうすいがたげんしろ": "مفاعل الماء المغلي (مفاعل نووي يستخدم الماء كمبرد ومهدئ؛ يغلي الماء في قلب المفاعل ويمكن للبخار…)",
 "ふっとうてん": "احتقان, نقطة الغليان (أن يكون المرء غاضباً جداً أو منفعلاً؛ جاهز للانفجار)\nمثال: بعد ساعة من الانتظار كنت عند نقطة الغليان",
 "ふっとばす": "طَرَدَ",
 "ふっとぶ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / اِنْدَفَعَ, أَسْرَعَ",
 "ふっ飛ぶ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / اِنْدَفَعَ, أَسْرَعَ",
 "ふつ": "فَرَنْجَة\nمثال: نساء فرنسا جميلات.",
 "ふつう": "يُعَلِّق / عَادِيّ / عَادَةً\nمثال: 彼女は普通９時に寝る。 — عادة ما تخلد إلى السرير الساعة التاسعة.",
 "ふつうか": "مُشَاة, بِيَادَة",
 "ふつうかぶ": "أسهم عادية (أسهم غير الأسهم الممتازة؛ تمنح المالك حصة من أرباح الشركة وحصة من قوة التصويت…)",
 "ふつうかんぼう": "زُكَام",
 "ふつうきせき": "أوجيت (معدن زجاجي أخضر داكن إلى أسود من مجموعة البيروكسين يحتوي على كميات كبيرة من…)",
 "ふつうぎんこう": "بنك تجاري, مصرف تجاري (مؤسسة مالية تقبل الودائع تحت الطلب وتقدم القروض وتوفر خدمات أخرى للجمهور)",
 "ふつうこぎって": "صَكّ عَلَى بَيَاضٍ, شَيْك عَلَى بَيَاضٍ",
 "ふつうし": "وَرَق عَادِيّ (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "ふつうしふくしゃき": "وَرَق عَادِيّ (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "ふつうしゃ": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "ふつうしゃさい": "بكالوريوس العلوم (درجة البكالوريوس في العلوم)",
 "ふつうしゅ": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "ふつうせんきょ": "اقتراع عام (حق التصويت لجميع البالغين الذين لا تحرمهم قوانين البلاد من ذلك)",
 "ふつうに": "عَادَةً / بشكل كاف (إلى درجة كافية)\nمثال: كانت طليقة بشكل كاف في الماندرين / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "ふつうほう": "سابقة قضائية, قانون السوابق القضائية ((القانون المدني) قانون تم إنشاؤه من خلال اتباع قرارات قضائية سابقة)\nمثال: نشأ القانون العام في القوانين غير المكتوبة في إنجلترا وتم تطبيقه لاحقاً في الولايات المتحدة",
 "ふつうめいし": "اِسْم الجِنْس (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "ふつうよきん": "حِسَابُ تَوْفِير, حِسَابُ إِيدَاع (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن…)\nمثال: الحساب لو سمحت.",
 "ふつかよい": "خُمَار (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ…)\nمثال: اعتنقت ليلى الإسلام و بدأت ترتدي الخمار.",
 "ふつぎょう": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "ふつくしい": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "ふつこく": "فَرَنْجَة\nمثال: نساء فرنسا جميلات.",
 "ふつご": "الفَرَنْسِيَّة, اللُّغَة الفَرَنْسِيَّة",
 "ふつごう": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ / مُخْطِئ\nمثال: نحن نرفض الظلم.",
 "ふつじん": "فرنسي (شخص يحمل الجنسية الفرنسية)",
 "ふつぜん": "ساخط, ساخطة",
 "ふつつか": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "ふつつかもの": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "ふつつか者": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "ふつふつ": "غليان هادئ (درجة حرارة أقل بقليل من نقطة الغليان)\nمثال: بقي الحساء يغلي بهدوء لساعات",
 "ふつぶん": "الفَرَنْسِيَّة, اللُّغَة الفَرَنْسِيَّة",
 "ふつべい": "أمريكي فرنسي (أمريكي ولد في فرنسا أو من أجداد فرنسيين)",
 "ふつま": "رُقْيَة",
 "ふつまし": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "ふつり": "فَجْأَةً",
 "ふつりあい": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "ふつりょうギアナ": "غِيَانَا اَلْفَرَنْسِيَّة, غَيانا اَلْفَرَنْسِيَّة",
 "ふつトン": "طُنّ مِتْرِيّ",
 "ふてい": "خِيَانَة / عَنِيد, مُسْتَعْصٍ (يَتَّسِمُ بِالمُقَاوَمَةِ العَنِيدَةِ لِلسُّلْطَة) / غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد)\nمثال: نمط حياة غير مستقر / غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ)\nمثال: من عمر غير محدد",
 "ふていかんし": "أَدَاةُ تَنْكِير, أَدَاةُ نَكِرَة",
 "ふていき": "شَاذّ, غَيْر مُنْتَظِم",
 "ふていけい": "غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم)",
 "ふていけいし": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "ふていげん": "غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ)\nمثال: من عمر غير محدد",
 "ふていさい": "خدش للحياء, فعل غير لائق (فعل غير لائق أو خادش للحياء)",
 "ふていし": "مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "ふていしょう": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد') / عَامّ",
 "ふていせきぶん": "تَكَامُل غَيْر مُحَدَّد",
 "ふていだいめいし": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد')",
 "ふていのやから": "عِصَابَة",
 "ふてき": "جَرِيء, جَسُور / عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية)\nمثال: عدم كفاية إعانات البطالة",
 "ふてきかく": "إِقْصَاء",
 "ふてきかくしゃ": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "ふてきごう": "عاصٍ, متحدٍ (مقاوم بجرأة للسلطة أو لقوة معارضة)\nمثال: تربى ليكون عدوانياً ومتحدياً",
 "ふてきせい": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "ふてきせつ": "غَيْرُ لَائِق, غَيْرُ مَرْغُوب (غير جدير بالاختيار خاصة كشريك زواج)",
 "ふてきとう": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية)\nمثال: عدم كفاية إعانات البطالة",
 "ふてきにん": "عَدَم أَهْلِيَّة, عَدَم صَلَاحِيَّة (صفة كون الشيء غير مناسب)\nمثال: اتفق القضاة على عدم أهليته للتعيين",
 "ふてきよう": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ふてぎわ": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً))",
 "ふてくされ": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء)\nمثال: بقي في المنزل في حالة حرد",
 "ふてっかく": "إِقْصَاء",
 "ふてってい": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "ふてぶてしい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "ふてん": "القبة السماوية, سماء (السطح الظاهري للكرة الوهمية التي تبدو الأجرام السماوية مسقطة عليها) / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك)\nمثال: صف من النقاط",
 "ふて腐れ": "تجهم, عبوس (طبع عبوس ومتقلب المزاج ومستاء)\nمثال: بقي في المنزل في حالة حرد",
 "ふで": "فُرْشَاة الطِلَاء / الخط, فن الخط (الكتابة اليدوية الجميلة) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "ふであと": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة…)",
 "ふでい": "حمأة عضوية, سابروبيل (حمأة (غنية بالمواد العضوية) تتراكم في قاع البحيرات أو المحيطات)",
 "ふでいれ": "مِقْلَمَة",
 "ふでがしら": "رَئِيس, رَئِيسَة",
 "ふでき": "خطأ فادح, زلة (خطأ محرج)",
 "ふでつき": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "ふでづかい": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "ふでばこ": "مِقْلَمَة",
 "ふでや": "صَانِعُ الْفُرَش (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "ふでをおく": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "ふでをとる": "زَرِيبَة, حَظِيرَة\nمثال: ارسم بقلم رصاص.",
 "ふでんきょく": "كاثود, مهبط (قطب كهربائي سالب الشحنة وهو مصدر الإلكترونات التي تدخل جهازاً كهربائياً)",
 "ふと": "فَجْأَةً / بُوذَا, بُدّ / سْتُوبَا / سَمِين, بَدِين\nمثال: توم بدهن غرفته. / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز)",
 "ふとい": "سَمِين, بَدِين\nمثال: توم بدهن غرفته. / عَمِيق, غَوِيط / جَرِيء, جَسُور",
 "ふとう": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة) / خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة) / ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة / عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ) / رَصِيف / لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "ふとういつ": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء)",
 "ふとうえき": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "ふとうおう": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "ふとうかい": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "ふとうこう": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة) / تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "ふとうこうじ": "مُتَغَيِّب",
 "ふとうざい": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "ふとうしき": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "ふとうひょうじ": "تحريف, تزييف (تحريف متعمد للحقائق)",
 "ふとうふくつ": "إصرار, دأب (تصميم مستمر)",
 "ふとうへんさんかくけい": "أخمعي (مكون من أو متعلق بأي من العضلات الأخمعية)",
 "ふとうへんさんかっけい": "أخمعي (مكون من أو متعلق بأي من العضلات الأخمعية)",
 "ふとうへんしへんけい": "مُنْحَرِف, شِكْل مُنْحَرِف",
 "ふとうめい": "أَكْمَد / إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "ふとうめいかん": "تذبذب, عجز عن الحسم (سمة التردد؛ نقص في صلابة الشخصية أو الغرض)\nمثال: تسبب تردد الملك غير القابل للشفاء في اضطراب في بلاطه",
 "ふとうめいすいさい": "جواش (لوحة مائية منفذة بألوان مائية معتمة ممزوجة بالصمغ)",
 "ふとうめいせい": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء)",
 "ふとうめいど": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء)",
 "ふとうれんばい": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "ふときゃく": "باذخ, منفق كبير (شخص ينفق ببذخ وتفاخر على الترفيه)\nمثال: آخر المنفقين الكبار",
 "ふとく": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "ふとくかん": "عصا الراعي, محجن (عصا طويلة ذات طرف على شكل خطاف)\nمثال: منعطف في الطريق",
 "ふとくぎ": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "ふとくさく": "عدم جدوى, عدم ملاءمة (صفة عدم الملاءمة للهدف المنشود)",
 "ふとくてい": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "ふとくのいたすところ": "اعْتِرَاف بِالْخَطَأ, مِيَا كُولْبَا (إقرار بخطئك أو ذنبك)",
 "ふとくようりょう": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "ふところ": "ثَدْي / بَلَغَ / قَلْب, فُؤَاد / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "ふところがさびしい": "مَضِيق, مُعْسِر (لا يملك ما يكفي من المال لسدّ الحاجات الأساسية)",
 "ふところがたな": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / أمين سر, خليل (شخص يُؤتمن على الأمور الخاصة)",
 "ふところがふかい": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك)\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "ふところぜに": "مَصْرُوف جَيْب, مَصْرُوف",
 "ふところで": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "ふところにする": "مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "ふところにはいる": "تَمَلَّقَ",
 "ふところのふかい": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك)\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "ふところ手": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "ふとした": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي)",
 "ふとじ": "بولد, خط عريض (نمط خط ذو خطوط سميكة وثقيلة)",
 "ふとせん": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))",
 "ふとった": "سمين",
 "ふとっちょ": "دسم, دهني (يحتوي على أو يتكون من الدهون)\nمثال: طعام دسم",
 "ふとっぱら": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "ふとつごう": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "ふとどき": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "ふとどきしごく": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "ふとどきせんばん": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "ふとどきもの": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "ふとばら": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "ふとましい": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "ふとめ": "سمين",
 "ふともじ": "بولد, خط عريض (نمط خط ذو خطوط سميكة وثقيلة)",
 "ふともの": "ستارة, سِتر (قماش معلق يستخدم كحاجز (خاصة للنافذة))",
 "ふともも": "فَخِذ, فَخْذ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / تفاح الورد, جامبو (فاكهة استوائية صفراء بيضاوية عطرية تستخدم في الهلام والحلويات)",
 "ふとりぎみ": "سمين",
 "ふとりじし": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "ふとりすぎ": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل…)",
 "ふとる": "اِزْدَادَ وَزْنًا, اِكْتَسَبَ وَزْنًا",
 "ふとん": "فُوتُون, فُوتُون يَابَانِيّ",
 "ふとんがわ": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن)",
 "ふとんたたき": "مضرب السجاد, منفضة السجاد (أداة لضرب الغبار لإخراجه من السجاد)",
 "ふどう": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل) / فَرْق, اِخْتِلَاف / طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بربرية, همجية (فعل همجي وحشي بربري)",
 "ふどうい": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "ふどうさん": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんかいはつ": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんかいはつぎょうしゃ": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんかんてい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんがいしゃ": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんぎょう": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんぎょうかい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんぎょうしゃ": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "ふどうさんしゅとくぜい": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんたんぽしょうけん": "ورقة مالية مدعومة بالرهن العقاري (ورقة مالية تنشأ عند تجميع مجموعة من القروض العقارية وبيع السندات لمؤسسات أخرى…)",
 "ふどうさんとうき": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんとうきほう": "أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "ふどうさんほけん": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "ふどうさんや": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "ふどうしょうすうてんすう": "عَدَد بِفَاصِلَة عَيْمَة, عَدَد حَقِيقِيّ عائِم (عدد ممثل بتدوين الفاصلة العائمة)",
 "ふどうしん": "برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: أدى برباطة جأش المخضرمين",
 "ふどうたい": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "ふどうとく": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "ふどうのどうしゃ": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "ふどうり": "سَخَافَة",
 "ふどし": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "ふな": "شبوط كروشي (شبوط أوروبي يشبه إلى حد كبير السمكة الذهبية البرية)",
 "ふなあか": "ماء الآسن (الماء المتجمع في قاع السفينة)",
 "ふなあし": "مُسْوَدَّة",
