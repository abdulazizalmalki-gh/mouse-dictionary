 "へぶしっ": "أَتْشُو",
 "へへ": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "へべれけ": "بلوتو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "へぼ": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة) / جودة منخفضة, دونية (جودة متدنية)",
 "へぼい": "أَخْرَق",
 "へま": "خطأ فادح, زلة (خطأ محرج) / أَخْرَق اليَدَيْن, ثَقِيل اليَد (يفتقر إلى مهارات الحركة الجسدية وخاصة في استخدام اليدين)",
 "へみ": "ثُعْبَان, حَنَش / ثُعْبَان",
 "へや": "فَضاء (فَضَاء)\nمثال: الفضاء مليئ بالغموض. / شَقَّة (نِصْف الشيء إذا شُقَّ؛ القطعة المَشْقُوقَة بشكل مستطيل من الثَوْب أو العَصَا)\nمثال: فتش ياني الشقة. / حَظِيرَة, اِسْطَبْل\nمثال: الشاحنة غير ثابتة.",
 "へやぎ": "ملابس استرخاء (ملابس مناسبة للاسترخاء)",
 "へやご": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "へやずみ": "مُتَوَقِّفْ, مُعْتَمِدْ",
 "へやばき": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف…)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "へら": "مِلْعَقَةُ الصَيْدَلِيِّ, محراك (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "へらさぎ": "أبو ملعقة الشائع (أبو ملعقة أبيض نقي ذو عرف من جنوب أوراسيا وشمال شرق أفريقيا)",
 "へらじか": "مُوظ",
 "へらす": "ضَعُفّ",
 "へらずぐち": "أَنَاقَة عَصْرِيَّة, شِيَاكَة (الأناقة بحكم مسايرة الموضة)\nمثال: طبيبي له القول الفصل في الأدوية التي أتناولها",
 "へらへら": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء / بتهور, دون تحفظ (بدون تقدير أو حكمة أو ضبط للنفس)\nمثال: استفسرت دون تحفظ عن حالته الصحية / رَفِيع, رَقِيق",
 "へらり": "بحماقة, بغباء (دون حس سليم أو حكم جيد)\nمثال: تصرف بحماقة عندما وافق على المجيء",
 "へり": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق / حافة, شفة (الحافة العليا لوعاء أو حاوية أخرى)\nمثال: اصطدمت الكرة بالحلقة وارتدت / تزيين الحواف, حاشية (حدود تتكون من أي شيء يوضع على الحافة لإنهاء شيء ما (مثل الأهداب على الملابس أو…)",
 "へりいし": "ضبط, كبح (فعل تقييد القوة أو العمل أو الحد من التجاوز)\nمثال: حسه السليم هو لجام لمزاجه السريع",
 "へりかめむし": "بق الأرجل الورقية, كوريد (بق حقيقي)",
 "へりくつ": "سَفْسَطَة, مُغَالَطَة",
 "へりくつや": "سَفْسَطِيّ, سَفْسَطَائِيّ",
 "へりつき": "خَشِن الحَوَافّ (ذو حافة خشنة غير مستوية؛ يوصف به الورق اليدوي أو ما يشبهه)",
 "へりとり": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "へる": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / اِخْتَرَقَ, نَفَذَ / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "へろへろ": "مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)",
 "へをこく": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في…)",
 "へをひってしりすぼめ": "هُنَاكَ, يُوجَدُ",
 "へをひってしりつぼめ": "هُنَاكَ, يُوجَدُ",
 "へをひる": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في…)",
 "へん": "غَرِيب, عَجِيب / مُفَاجِئ / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / حَادِث, حَادِثَة / تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟ / مِسَاحَة\nمثال: غزة منطقة مكشوفة. / جَانِب / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "へんあい": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز)",
 "へんあつ": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "へんあつき": "مُحَوِّل / محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "へんい": "إِزَاحَة, نُزُوح / تَرَاوُح, اِخْتِلَاف / طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى) / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / إِنْحِرَاف / نَوْبَة",
 "へんいかぶ": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "へんいき": "مَجَال إِنْتَرْنَت\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟ / مدى, قدرة",
 "へんいけい": "تَرَاوُح, اِخْتِلَاف",
 "へんいげん": "مُطَفِّر",
 "へんいたい": "حيوان متحول, طافر (حيوان خضع لطفرة جينية)\nمثال: جين طافر",
 "へんえい": "ذرة, نقطة صغيرة (بقعة صغيرة جداً)\nمثال: كانت الطائرة مجرد نقطة في السماء",
 "へんえき": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "へんえん": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة…)",
 "へんえんけい": "جهاز حوفي (نظام من الهياكل العصبية المرتبطة وظيفياً في الدماغ والتي تشارك في السلوك العاطفي)",
 "へんおんどうぶつ": "ذوات الدم البارد, كائن متغير الحرارة (حيوان تتغير درجة حرارة جسمه مع درجة حرارة محيطه؛ أي حيوان باستثناء الطيور…)",
 "へんか": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / اِخْتِلَاف / تنغيم, عروض (أنماط الضغط والتنغيم في اللغة)",
 "へんかい": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "へんかきゅう": "رمية منحنية, كرة مقوسة (رمية كرة بيسبول يتم رميها بدوران بحيث ينحني مسارها عند اقترابها من الضارب)",
 "へんかく": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / مِيل / جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: (…)\nمثال: لا جدال في ذلك.",
 "へんかくかつよう": "فِعْل غَيْر مُنْتَظِم, فِعْل شَاذّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "へんかけい": "تَرَاوُح, اِخْتِلَاف",
 "へんかりょう": "تَرَاوُح, اِخْتِلَاف",
 "へんかん": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "へんかんき": "محوّل (جهاز لتغيير مادة أو شكل أو حالة إلى أخرى)",
 "へんかんし": "تحميل, نقل (فعل أخذ الركاب أو البضائع على متن المركبة)\nمثال: جمع القمامة يتم في أيام الاثنين والخميس",
 "へんかんずみ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "へんがん": "شيست (أي صخر متحول يمكن شقه إلى طبقات رقيقة)",
 "へんき": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "へんきごう": "مُسَطَّح",
 "へんきゃく": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "へんきょう": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة) / انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة) / تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "へんきょうはく": "مركيز (نبيل (في بلدان مختلفة) برتبة أعلى من كونت)",
 "へんきょく": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات)",
 "へんきょくか": "معد موسيقي, موزع موسيقي (موسيقي يقوم بتكييف مقطوعة موسيقية لأصوات أو آلات معينة أو لأسلوب أداء آخر)\nمثال: كانت هي منظمة الاجتماع",
 "へんきょくしゃ": "معد موسيقي, موزع موسيقي (موسيقي يقوم بتكييف مقطوعة موسيقية لأصوات أو آلات معينة أو لأسلوب أداء آخر)\nمثال: كانت هي منظمة الاجتماع",
 "へんきん": "إِعَادَة مَال",
 "へんくつ": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية)\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "へんけい": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / اِخْتِلَاف",
 "へんけいきん": "عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "へんけいせいかんせつしょう": "فُصَال عَظْمِيّ",
 "へんけいたい": "بلازموديوم, متصورة (أوالي طفيلي من جنس المتصورة يسبب الملاريا لدى البشر)",
 "へんけいちゅうるい": "أَمِيبَا, مُتَحَوِّلَة",
 "へんけいどうぶつ": "دُودَة مُسَطَّحَة",
 "へんけいどうぶつもん": "دودة مفلطحة (ديدان طفيلية أو حرة المعيشة لها جسم مسطح)",
 "へんけいぶんぽう": "النحو التوليدي (القصد؛ المثال)\nمثال: لا أجيد قواعد النحو.",
 "へんけん": "إِجْحَاف, تَحَامُل",
 "へんげ": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر) / الحُلُول / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / اِحْتَقَرَ",
 "へんげん": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "へんげんじざい": "سُرْيَالِيّ, فَانْتَاسْمَاغُورِيّ (يتّسم بصور خيالية غريبة وتجاورات غير متوقّعة)",
 "へんげんせいしゃ": "بالجانب العريض, بكامل الجانب (بجانب يواجه شيئاً ما)\nمثال: صدم القطار الشاحنة من جانبها العريض",
 "へんげんせきご": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "へんこ": "مُتَعَنِّت, عَنِيد / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "へんこう": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / ميل / اِنْحِيَاز / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / مُتَغَيِّر",
 "へんこうかのう": "قَابِل لِلتَّعْدِيل (قادر على أن يُعدل في الشكل أو الشخصية أو القوة (خاصة بجعله أقل تطرفاً))\nمثال: إيقاع الوقت الفسيولوجي غير قابل للتعديل إلا عن طريق التدخل في عمليات أساسية معينة",
 "へんこうせい": "نَجْم مُتَغَيِّر (نجم يتغير سطوعه بشكل ملحوظ)",
 "へんこうてき": "مُتَحَيِّز",
 "へんこうふのう": "ثَابِت, غَيْر قَابِل لِلتَّغْيِير (غير قابل للتغيير أو الخضوع للتغيير)\nمثال: جزء ثابت وغير قابل للتغيير من البلازما الجرثومية",
 "へんごく": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو…)",
 "へんさ": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك))\nمثال: تحويل عن الطريق السريع الرئيسي",
 "へんさい": "حَادِث\nمثال: لا تدعها للصدفة. / استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "へんさち": "إِنْحِرَاف",
 "へんさん": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "へんさんしゃ": "مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
 "へんざい": "وجود في كل مكان, وجود كلي (حالة الوجود في كل مكان في آن واحد (أو ما يبدو كذلك)) / خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "へんし": "قتل, موت عنيف (حدث يتسبب في موت شخص ما) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "へんしつ": "تَحَيُّز / تَغَيُّر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟ / تحريف, قلب الحقائق (فعل تحريف الشيء (تحويله لاستخدام خاطئ))\nمثال: كان ذلك تحريفاً للعدالة",
 "へんしつきょう": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "へんしつしゃ": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "へんしつしょう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "へんしつしょうかんじゃ": "بَارَانُويِيّ",
 "へんしつてき": "بَارَانُويِيّ",
 "へんしゃ": "التواء, انحراف (صفة الميل وعدم الاستقامة في المسار) / مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
 "へんしゅ": "اِخْتِلَاف / غَشَّ, جَدَعَ",
 "へんしゅう": "تَحَيُّز / سكيف, قارب صغير (أي من القوارب الصغيرة المتنوعة التي تدفع بالمجاديف أو الأشرعة أو المحرك) / تحرير, تنقيح (وضع شيء ما (مثل عمل أدبي) في شكل مقبول)",
