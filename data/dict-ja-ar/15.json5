 "ぶだん": "عَسْكَرِيَّة",
 "ぶだんしゅぎ": "عَسْكَرِيَّة",
 "ぶだんせいじ": "حكم عسكري, حكومة عسكرية (الحكم بواسطة الجيش والقوات المسلحة)",
 "ぶだんてき": "عَسْكَرِتَارِيّ, نَزَّاعٌ إِلَى التَّسَلُّح (مُشْبَعٌ بِالنَّزْعَةِ العَسْكَرِيَّة)",
 "ぶち": "أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية / سَوْط\nمثال: هذا حزام من الجلد. / غُصَيْن\nمثال: لا تمسك العصا من الوسط. / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ぶちあける": "فَارِغ",
 "ぶちあげ": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "ぶちあたる": "أَصَابَ\nمثال: تلقى مناد ضربة. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "ぶちくだく": "كَسَّرَ",
 "ぶちげ": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء…)\nمثال: دخل نمر مخيمنا.",
 "ぶちこむ": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "ぶちころす": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ぶちこわし": "تَدْمِير, هَدْم / إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به)\nمثال: كان إفسادها لثوبي متعمداً",
 "ぶちこわす": "دَمَّرَ / خَرَاب, خَرَابَة",
 "ぶちたてがみいぬ": "ضبع ضاحك, ضبع مرقط (ضبع أفريقي يشتهر بعوائه المميز)",
 "ぶちぬく": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / نَقَلَ\nمثال: لا أزال عطشانا. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "ぶちのめす": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "ぶちはなす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ぶちまける": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد.",
 "ぶちやぶる": "دَمَّرَ",
 "ぶちょうづき": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "ぶちょうほう": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / خطأ فادح, زلة (خطأ محرج)",
 "ぶちょうほうもの": "شخص أخرق (شخص ذو تنسيق حركي ضعيف) / عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة)",
 "ぶちる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "ぶちわる": "انفصل",
 "ぶちハイエナ": "ضبع ضاحك, ضبع مرقط (ضبع أفريقي يشتهر بعوائه المميز)",
 "ぶち壊し": "تَدْمِير, هَدْم / إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به)\nمثال: كان إفسادها لثوبي متعمداً",
 "ぶち壊す": "دَمَّرَ / خَرَاب, خَرَابَة",
 "ぶち当たる": "أَصَابَ\nمثال: تلقى مناد ضربة. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "ぶち抜く": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / نَقَلَ\nمثال: لا أزال عطشانا. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "ぶち明ける": "فَارِغ",
 "ぶち殺す": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ぶち破る": "دَمَّرَ",
 "ぶち空ける": "فَارِغ",
 "ぶち込む": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "ぶち開ける": "فَارِغ",
 "ぶっか": "اَلنِّرْفَانَا / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ぶっかけ": "بُوكَاكِيه",
 "ぶっかける": "شَحْطَة",
 "ぶっかしすう": "مؤشر الأسعار (مؤشر يتتبع التغيرات النسبية في سعر سلعة فردية (أو سلة سوق من السلع) بمرور الوقت)",
 "ぶっかじょうしょう": "ارتفاع السعر, زيادة السعر (زيادة في السعر)",
 "ぶっかじょうしょうりつ": "ارتفاع السعر, زيادة السعر (زيادة في السعر)",
 "ぶっかすいじゅん": "مؤشر الأسعار (مؤشر يتتبع التغيرات النسبية في سعر سلعة فردية (أو سلة سوق من السلع) بمرور الوقت)",
 "ぶっかだか": "تَضَخُّم (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "ぶっかつろん": "أرواحية",
 "ぶっかとうせい": "ضبط الأسعار, مراقبة الأسعار (قيد على الحد الأقصى للأسعار تضعه الحكومة وتحافظ عليه (كما في فترات الحرب أو…)",
 "ぶっき": "حِدَاد\nمثال: هو ذئب في ثوب حمل.",
 "ぶっきょう": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…) / مَجْنُون",
 "ぶっきょうか": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "ぶっきょうと": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "ぶっきらぼう": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "ぶっきら棒": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "ぶっきれる": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ぶっけん": "مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "ぶっこ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ぶっこしゃ": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ぶっこぬく": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "ぶっこみ": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة)\nمثال: اشترته للارتداء اليومي / سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد…)",
 "ぶっこみづり": "سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد…)",
 "ぶっこみ釣り": "سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد…)",
 "ぶっこむ": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "ぶっころす": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ぶっこわす": "دَمَّرَ / خَرَاب, خَرَابَة",
 "ぶっこ抜く": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "ぶっさいく": "أَخْرَق / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "ぶっさく": "تمزيق, شق (عملية شق أو تمزيق شيء ما)\nمثال: قام بتمزيق الظرف بقوة",
 "ぶっさん": "مُنْتَج",
 "ぶっし": "بَضَائِع, سِلَع / بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…) / بَشَرِيَّة, الْجِنْس الْبَشَرِيّ / بُودِيسَاتْفَا",
 "ぶっしつ": "مَادِّيّ\nمثال: لا أحب مادة العلوم. / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ぶっしつしゅぎ": "مَادِّيَّة",
 "ぶっしつしゅぎしゃ": "مادي (شخص يعتقد أنه لا يوجد شيء سوى المادة الفيزيائية)",
 "ぶっしつたいしゃ": "أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ)",
 "ぶっしつてき": "مَادِّيّ\nمثال: لا أحب مادة العلوم.",
 "ぶっしつろん": "مَادِّيَّة",
 "ぶっしゃ": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "ぶっしゅかん": "يد بوذا (فاكهة كبيرة تشبه الليمون مقسمة إلى أقسام تشبه الأصابع؛ معظم الأصناف لا تحتوي…)",
 "ぶっしょう": "عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف.",
 "ぶっしょく": "بحث بصري, نظر (فعل البحث بصرياً)",
 "ぶっしんしゅう": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "ぶっしんすうはい": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير…)",
 "ぶっせい": "خاصية فيزيائية (أي خاصية تستخدم لتوصيف المادة والطاقة وتفاعلاتهما)",
 "ぶっせいち": "خاصية فيزيائية (أي خاصية تستخدم لتوصيف المادة والطاقة وتفاعلاتهما)",
 "ぶっそう": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "ぶっそうげ": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة…)",
 "ぶったい": "عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف.",
 "ぶったおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "ぶったおれる": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "ぶったぎる": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء)\nمثال: سأضربه على فكه",
 "ぶったくり": "سَرِقَة, لُصُوصِيَّة / زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "ぶったくる": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "ぶったたく": "نَبْض\nمثال: ضرب سامي زوجته.",
 "ぶった切る": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء)\nمثال: سأضربه على فكه",
 "ぶった斬る": "كرة قافزة (كرة أرضية ترتد عالياً في الهواء)\nمثال: سأضربه على فكه",
 "ぶっだ": "بُوذَا, بُدّ",
 "ぶっち": "إحاطة بكل شيء, علم مطلق (حالة العلم بكل شيء؛ امتلاك معرفة لا نهائية)",
 "ぶっちぎり": "انطلاق, انفلات (المغادرة بسرعة أو عجل)\nمثال: كان هناك انشقاق من قبل الأعضاء الساخطين",
 "ぶっちゃけ": "بِصَراحة / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "ぶっちょう": "جفاء, غلظة (أسلوب فظ مفاجئ)",
 "ぶっちょうづら": "بوّز, بَرطَمَ",
 "ぶっつかる": "أَصَابَ\nمثال: تلقى مناد ضربة. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا. / تَصَادُم",
 "ぶっつけ": "ارتجالياً, دون تحضير (بدون إعداد مسبق)\nمثال: أدلى المرشح بتصريح ارتجالي / صريح, غير متحفظ (غير حذر أو متحفظ)\nمثال: سلوك غير متحفظ / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "ぶっつけほんばん": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)",
 "ぶっつける": "أَصَابَ\nمثال: تلقى مناد ضربة. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "ぶっつづけ": "مُتَوَاصِل, مُتَّصِل",
 "ぶっつぶす": "كَسَّرَ / خَرَاب, خَرَابَة",
 "ぶっつり": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة)",
 "ぶってき": "مَادِّيّ\nمثال: لا أحب مادة العلوم.",
 "ぶってん": "سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية)",
 "ぶっと": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "ぶっとい": "سَمِين, بَدِين\nمثال: توم بدهن غرفته.",
 "ぶっとう": "سْتُوبَا",
 "ぶっとおし": "مُتَوَاصِل, مُتَّصِل\nمثال: 販売係の職員は全部一週間昼夜ぶっ通しで働いた。 — لقد عمل موظفي المبيعات على مدار الساعة لمدة أسبوع.",
 "ぶっとばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / طَرَدَ",
 "ぶっとび": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ)",
 "ぶっとぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "ぶっぱなす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ぶっぴょう": "دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "ぶっぴん": "بَضَائِع, سِلَع",
 "ぶっぴんぜい": "ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "ぶっぽう": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "ぶっぽうそう": "كرة متدحرجة (كرة أرضية تتدحرج على طول الملعب الداخلي)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً",
 "ぶっ倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "ぶっ倒れる": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "ぶっ切れる": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ぶっ叩く": "نَبْض\nمثال: ضرب سامي زوجته.",
 "ぶっ壊す": "دَمَّرَ / خَرَاب, خَرَابَة",
 "ぶっ掛け": "بُوكَاكِيه",
 "ぶっ掛ける": "شَحْطَة",
 "ぶっ放す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ぶっ殺す": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ぶっ潰す": "كَسَّرَ / خَرَاب, خَرَابَة",
 "ぶっ続け": "مُتَوَاصِل, مُتَّصِل",
 "ぶっ込み": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة)\nمثال: اشترته للارتداء اليومي / سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد…)",
 "ぶっ込み釣り": "سمك القاع (الأسماك التي تعيش في قاع البحر (خاصة أسماك القد المهمة تجارياً مثل القد…)",
 "ぶっ込む": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "ぶっ通し": "مُتَوَاصِل, مُتَّصِل\nمثال: 販売係の職員は全部一週間昼夜ぶっ通しで働いた。 — لقد عمل موظفي المبيعات على مدار الساعة لمدة أسبوع.",
 "ぶっ飛ばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / طَرَدَ",
 "ぶっ飛び": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ)",
 "ぶっ飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "ぶつ": "أَصَابَ\nمثال: تلقى مناد ضربة. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / قِمَار / بُوذَا, بُدّ / بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…) / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل. / بَضَائِع, سِلَع",
 "ぶつかり": "تَصَادُّم, اِصْطِدَام / وَجْهًا لِوَجْه",
 "ぶつかりあい": "تَصَادُّم, اِصْطِدَام",
 "ぶつかりあう": "اِصْطَدَمَ",
 "ぶつかりげいこ": "وَجْهًا لِوَجْه",
 "ぶつかり合い": "تَصَادُّم, اِصْطِدَام",
 "ぶつかり合う": "اِصْطَدَمَ",
 "ぶつかり稽古": "وَجْهًا لِوَجْه",
 "ぶつかる": "أَصَابَ\nمثال: تلقى مناد ضربة. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا. / تَصَادُم",
 "ぶつぎ": "مناقشة عامة (مناقشة حرة ومفتوحة (أو جدال) حول مسألة ذات اهتمام عام)\nمثال: مثل هذا الاقتراح يستحق مناقشة عامة شاملة",
 "ぶつぎり": "تكتل, كتلة (كتلة متماسكة)\nمثال: أصابته كرة من الطين في كتفه",
 "ぶつくさ": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض)\nمثال: سمعوا هدير الرعد",
 "ぶつける": "أَصَابَ\nمثال: تلقى مناد ضربة. / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "ぶつだ": "بُوذَا, بُدّ",
 "ぶつてきしげん": "مورد مادي (أصول في شكل ممتلكات مادية)",
 "ぶつでし": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "ぶつど": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط)\nمثال: هواوي جنة على الأرض.",
 "ぶつどう": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "ぶつぶつ": "ناخر (أسماك غذائية بحرية استوائية متوسطة الحجم تصدر أصوات نخر عند صيدها) / بَثْرَة, بَثْر / سلق, غلي (الطهي في سائل تم غليه)",
 "ぶつぶつこうかん": "مُقَايَضَة",
 "ぶつもん": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "ぶつり": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية. / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة)",
 "ぶつりかがく": "كيمياء فيزيائية (فرع الكيمياء الذي يتعامل مع الخصائص الفيزيائية للمواد الكيميائية) / خصائص فيزيائية, فيزياء (الخصائص الفيزيائية والظواهر والقوانين لشيء ما)\nمثال: درس فيزياء الإشعاع",
 "ぶつりがく": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "ぶつりがくしゃ": "فِيزِيَائِيّ, فِيزِيَائِيَّة",
 "ぶつりげんしょう": "ظاهرة فيزيائية (ظاهرة طبيعية تنطوي على الخواص الفيزيائية للمادة والطاقة)",
 "ぶつりしゅぎ": "فيزيائية, مادية ((فلسفة) النظرية الفلسفية القائلة بأن المادة هي الواقع الوحيد)",
 "ぶつりてき": "مَادِّيّ, مَلْمُوس",
 "ぶつりてきげんしょう": "ظاهرة فيزيائية (ظاهرة طبيعية تنطوي على الخواص الفيزيائية للمادة والطاقة)",
 "ぶつりてきはいたつ": "بالاديوم (عنصر فلزي فضي-أبيض من مجموعة البلاتين يشبه البلاتين)",
 "ぶつりてきはいたつシステム": "بالاديوم (عنصر فلزي فضي-أبيض من مجموعة البلاتين يشبه البلاتين)",
 "ぶつりゅう": "سَوْقِيَّات, لُوجِسْتِيَّة",
 "ぶつりょう": "عِلَاج طَبِيعِيّ",
 "ぶつりりょう": "كَمِّيَّة فِيزِيَائِيَّة",
 "ぶつりりょうほう": "عِلَاج طَبِيعِيّ",
 "ぶつりフォーマット": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "ぶつ切り": "تكتل, كتلة (كتلة متماسكة)\nمثال: أصابته كرة من الطين في كتفه",
 "ぶと": "ذبابة سوداء (ذبابة لاسعة صغيرة مسودة ممتلئة الجسم لها يرقات مائية؛ تمتص دماء الطيور وكذلك…) / مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "ぶとう": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص. / غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى) / غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بربرية, همجية (فعل همجي وحشي بربري)",
 "ぶとうか": "رَاقِص, رَاقِصَة",
 "ぶとうかい": "ضَرَّة",
 "ぶとうきょく": "موسيقى الرقص (موسيقى للرقص عليها)",
 "ぶとうは": "مُقَاتِل, مُحَارِب (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة…)",
 "ぶとうびょう": "داء الرقص, رقص (أي من الاضطرابات العصبية التنكسية المتعددة التي تتميز بحركات تشنجية للجسم…)",
 "ぶとく": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "ぶどう": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن. / عِنَب / غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بربرية, همجية (فعل همجي وحشي بربري)",
