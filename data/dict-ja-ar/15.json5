 "ぺーぺー": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "ほ": "شِرَاع / أَبْحَرَ (غالبا ما يستخدم كجمع قلّة)\nمثال: أبحر زيري في الاتجاه المعاكس للنهر. / دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان. / خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي / مُو",
 "ほあかり": "ضوء المصباح (الضوء الصادر من مصباح)",
 "ほあん": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "ほあんいん": "حارِس أَمْن, مُراقِب (حارس يقوم بالمراقبة)",
 "ほあんかん": "رَجُل شُرْطَة, رَجُل قانُون (موظف مكلف بتطبيق القانون)\nمثال: 保安官は、その町の秩序を確立した。 — أَسَّسَ اْلشَّرِيفُ النَّاظِمَ فِي اْلبَلْدَةِ.",
 "ほあんがかり": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "ほあんせつび": "جهاز أمان, واقي (جهاز مصمم لمنع الإصابة أو الحوادث)",
 "ほあんちょう": "أَمْن وَطَنِيّ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "ほあんぶ": "أمن, قسم الأمن (قسم مسؤول عن أمن ممتلكات المؤسسة والعاملين فيها)\nمثال: كان رئيس الأمن شرطيًا سابقًا",
 "ほい": "ملحق / مُكَمِّل / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل) / آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة! / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ほいきた": "جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "ほいく": "تنشئَة, تَرْبِيَة / تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "ほいくえん": "حَضَانَة, رَوْضَة",
 "ほいくき": "حَاضِنَة",
 "ほいくさんかん": "حَضَانَة, رَوْضَة",
 "ほいくし": "حَضَانَة, رَوْضَة",
 "ほいくしつ": "حَضَانَة, رَوْضَة",
 "ほいくしゃ": "مُقَدِّم رِعَايَة (شخص مسؤول عن تلبية احتياجات طفل أو شخص بالغ معال) / أخصائي صحي, مقدم رعاية صحية (شخص يساعد في تحديد أو منع أو علاج المرض أو الإعاقة)",
 "ほいくしょ": "حَضَانَة, رَوْضَة",
 "ほいくじょ": "حَضَانَة, رَوْضَة",
 "ほいたら": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "ほいだら": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほいっぽ": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "ほいつ": "كرة فائتة (رمية كان يجب على الماسك التقاطها لكنه لم يفعل؛ مما يسمح للعداء بالتقدم لقاعدة)",
 "ほいと": "تَسَوُّل",
 "ほいとう": "تَسَوُّل",
 "ほいない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه) / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "ほいほい": "باستهتار, بتهور (بطريقة متهورة) / بتسامح, بتساهل (بطريقة متساهلة)\nمثال: نُصحت بتساهل بأن أعطي الأطفال ما يريدون ما لم أرغب في أن يتم نبذ ابني اجتماعياً / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟ / مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / مبتدئ (شخص دخل في رهبنة دينية لكنه لم يأخذ النذور النهائية بعد)",
 "ほいろ": "مجفف (جهاز يقوم بإزالة الرطوبة) / عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "ほいんし": "تميم, عامل مرافق (مادة (مثل الإنزيم المساعد) يجب أن تتحد مع مادة أخرى لإنتاج نتيجة معينة)",
 "ほいんしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "ほう": "رَاتِب, أَجْر / مَعْلُومَات, مَعْلُومَة / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / جَانِب / صَفْحَة / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / طَرِيقَة, مِنْهَج / مَزَاج / دَارْمَا / مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها) / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة) / زمير (نفخة بوق) / مَصْدُوم, مَهُول (أصابه الخوف أو الهلع أو الذهول)",
 "ほうあん": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ほうあんしんぎ": "مُنَاقَشَة, بَحْث",
 "ほうい": "حِصَار, مُحَاصَرَة / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة / رداء كهنوتي (ثوب (وخاصة الملابس الاحتفالية) يرتديه رجال الدين) / خَلَاص / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل) / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / جِنائِيّ",
 "ほういかく": "سَمْت ((سَمَتَ) سمتا: حسن سمته؛ (سَمَتَ): سار على الطريق بالظن)\nمثال: سمت ابنتها ماري.",
 "ほういがく": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ほういき": "قَضَاء / اِخْتِصَاص",
 "ほういけい": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "ほういじしゃく": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "ほういじしん": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "ほういせん": "حِصَار, مُحَاصَرَة",
 "ほういそくていき": "محدد الاتجاه (راديو؛ يحدد اتجاه موجات الراديو القادمة)",
 "ほういつ": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم",
 "ほういもう": "تطويق, حصار (إجراء حربي يعزل منطقة ذات أهمية للعدو)",
 "ほういん": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / قَصِيدَة, شِعْر",
 "ほうう": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "ほうえ": "رداء كهنوتي (ثوب (وخاصة الملابس الاحتفالية) يرتديه رجال الدين) / خَلَاص",
 "ほうえい": "تَلْفَزَ / قَصِيدَة, شِعْر",
 "ほうえつ": "نَشْوَة",
 "ほうえん": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية) / ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "ほうえんこう": "غَالِينَا",
 "ほうおう": "بَابَا / حَبْر أَعْظَم ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / حَبْر ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه) / الْبَابَا, الْأَب\nمثال: لا تكتب بالحبر. / بُوذَا, بُدّ",
 "ほうおうけん": "البابوية (حكومة الكنيسة الرومانية الكاثوليكية)",
 "ほうおうざ": "فِينِيكْس, فُقْنُس",
 "ほうおうちょう": "الكوريا, الكوريا الرومانية ((الكنيسة الرومانية الكاثوليكية) الإدارة المركزية التي تحكم الكنيسة الرومانية الكاثوليكية)",
 "ほうおうぼく": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "ほうおう座": "فِينِيكْس, فُقْنُس",
 "ほうおん": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته. / تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "ほうか": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟ / إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر / فَنَار / مَنَار / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة. / كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون) / رَدْب / خَلِيَّة, قَفِير / مُحَامٍ, مُحَامِيَة / التزام حرفي بالقانون, قانونية حرفية (الامتثال الصارم لحرفية القانون بدلاً من روحه) / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه) / كُرْسِيّ, قَنْدَاق (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي. / لفافة (ضمادة مغلفة) / غلاف, غلاف خارجي (الغطاء (عادة من الورق أو السلوفان) الذي يُلف فيه شيء ما)",
 "ほうかい": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / نَخْر / اضمحل / تضعضع / مَرْفَأ, مَرْسَى / كَوْن, الْكَوْن / إبادة, محق (تدمير شامل) / اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تفتت, تفكك (في حالة متحللة)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية",
 "ほうかいせき": "كالسيت (معدن شائع يتكون من كربونات الكالسيوم المتبلورة؛ مكون رئيسي للحجر الجيري)",
 "ほうかいむえん": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "ほうかがく": "طِبّ شَرْعِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "ほうかきょう": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "ほうかく": "زَائِر / زَائِر, سَائِح / هَائِم",
 "ほうかざい": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ほうかしきえん": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "ほうかしょう": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "ほうかだいがくいん": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "ほうかつ": "إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ほうかつてき": "شَامِل, شَامِلَة",
 "ほうかはん": "حَرِيق مُتَعَمَّد (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "ほうかはんにん": "مفتعل حرائق (مجرم يشعل النار في الممتلكات بشكل غير قانوني)",
 "ほうかへき": "بيرومانيا, هوس إشعال الحرائق (رغبة لا يمكن السيطرة عليها لإشعال النار في الأشياء)",
 "ほうかま": "مَهْوُوس بِإِشْعال الحَرائِق (شخص لديه هوس بإشعال النيران في الأشياء)",
 "ほうかん": "زَوْرَق مِدْفَعِيَّة / ديادم / دَلِيل, كُتَيِّب / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / كُومِيدْيَان",
 "ほうかんがいこう": "دبلوماسية الزوارق الحربية, سياسة القوة (دبلوماسية تهدد فيها الدول باستخدام القوة لتحقيق أهدافها)",
 "ほうが": "تَبَرُّع, هِبَة / اِنْتَاش / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "ほうがい": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "ほうがき": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "ほうがく": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة / طَرِيقَة, مِنْهَج / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうがくし": "بكالوريوس في القانون (درجة في القانون مدتها ثلاث سنوات)",
 "ほうがくしゃ": "حاكم, قاضي (مسؤول عام مخول بالفصل في المسائل المعروضة على محكمة العدل) / حقوقي, فقيه قانوني (باحث قانوني متمكن في القانون المدني أو قانون الأمم)",
 "ほうがくぶ": "كلية الحقوق, كلية القانون (كلية دراسات عليا تقدم دراسة تؤدي إلى درجة في القانون)",
 "ほうがこうしん": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ほうがん": "مُفَتِّش, مُفَتِّشَة / إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية / كرة مدفع (مقذوف صلب كان يُطلق في العصور القديمة من مدفع) / طَلَقَة, طَلَق / رَمْيَة / لَقْطَة / حُقْنَة, حَقْن / شَبَك, شَبَكَة / شَبَكَة كَهْرُبَاء / شَبَك",
 "ほうがんし": "ورق رسم بياني (ورق يحتوي على خطوط للسماح برسم الرسوم البيانية)",
 "ほうがんてき": "جامع, شامل (يشمل الكثير أو كل شيء؛ ويشمل بشكل خاص الحدود المذكورة)\nمثال: شكل فني شامل",
 "ほうがんなげ": "رَمْيُ الجُلَّة",
 "ほうき": "هِجْرَان, هُجْرَان / تَشْرِيع / شَرِيعَة, قَانُون (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟ / مِكْنَسَة, مِقْشَة / ثَوْرَة, عِصْيَان",
 "ほうきぎ": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / العليقة المشتعلة ((العهد القديم) الشجيرة التي اشتعلت دون أن تحترق والتي كلم الله موسى منها)",
 "ほうきぐさ": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / العليقة المشتعلة ((العهد القديم) الشجيرة التي اشتعلت دون أن تحترق والتي كلم الله موسى منها)",
 "ほうきせい": "تَنْظِيم",
 "ほうきたけ": "وَرْدِيُّ الطَّرَف ((لِلوَرَقَةِ) ذَاتُ طَرَفٍ وَرْدِيِّ اللَّوْن)",
 "ほうきぼし": "مُذَنَّب",
 "ほうきむし": "دودة حدوية (حيوان خنثوي يشبه الدودة يعيش في طين قاع البحر)",
 "ほうきゃく": "زَائِر / زَائِر, سَائِح",
 "ほうきゅう": "رَاتِب, أَجْر / اِنْتِقَام / ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "ほうきゅうせいかつしゃ": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "ほうきょう": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "ほうき星": "مُذَنَّب",
 "ほうぎゅう": "بقر الهند, زيبو (ثور مستأنس له سنام على الظهر وقرون طويلة ولبب كبير؛ يستخدم بشكل رئيسي كحيوان جر في الهند وشرق آسيا)",
 "ほうぎょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مَحْفُوظ بِالمِلْح, مُمَلَّح ((خَاصَّةً عَنِ اللُّحُوم) مَحْفُوظ فِي المِلْح)",
 "ほうぎょく": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ほうけい": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة) / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ほうけいさんえん": "بوروسيليكات (ملح لأحماض البوريك والسيليسيليك)",
 "ほうけいしゅじゅつ": "خِتَان / طهور",
 "ほうけん": "إِقْطَاعِيَّة / تَفَانٍ / إِهْدَاء",
 "ほうけんしゅぎ": "إِقْطَاعِيَّة",
 "ほうけんしょう": "طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله) / جمع التبرعات, عطاء المصلين (تقدمات المصلين في خدمة دينية)",
 "ほうけんせい": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع محميين من قبل اللوردات الذين كان عليهم خدمتهم في الحرب)",
 "ほうけんせいど": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع محميين من قبل اللوردات الذين كان عليهم خدمتهم في الحرب)",
 "ほうけんてき": "إِقْطَاعِيّ",
 "ほうけんりょうしゅ": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "ほうげ": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "ほうげい": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "ほうげき": "بومباردون (مزمار كبير؛ عضو الباس في عائلة المزمار)",
 "ほうげん": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "ほうげんがく": "عِلْم اللَّهْجَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ほうこ": "خَزِينَة\nمثال: インターネットはこの上なく貴重な情報の宝庫だ。 — الإنترنت مصدرُ معلوماتٍ لا يقدر بثمن. / كنز مكتشف (أي مجموعة من الأشياء الثمينة التي يتم اكتشافها) / كنز دفين (كنز مجهول المالك وجد مخبأ (عادة في الأرض))\nمثال: كان كتابها كنزاً من الأفكار الجديدة",
 "ほうこう": "خدمة عامة, وظيفة حكومية (التوظيف ضمن نظام حكومي (خاصة في الخدمة المدنية)) / خدمة عامة, خدمة مجتمعية (خدمة يتم أداؤها لصالح الجمهور أو مؤسساته) / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / خَيَّاط, خَيَّاطَة / مِدْفَعِيّة",
 "ほうこうかんかく": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "ほうこうかんねん": "إحساس بالاتجاه (وعي بتوجهك في المكان)",
 "ほうこうきん": "عضلة خياطية (عضلة في الفخذ تساعد على تدوير الساق في وضع الجلوس الذي يتخذه الخياط؛ أطول عضلة في جسم الإنسان)",
 "ほうこうざい": "أَرِيج, عَبِير",
 "ほうこうしじき": "إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "ほうこうせい": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / اتجاهية (خاصية كون الشيء موجهاً أو يحافظ على اتجاه معين) / اتجاهية, توجيهية (خاصية الميكروفون أو الهوائي بكونه أكثر حساسية في اتجاه واحد من الآخر)\nمثال: اتجاهية الكتابة الإنجليزية من اليسار إلى اليمين / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَرْمًى / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَجَّلَ هَدَفًا (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: لقد أخطأ الهدف.",
 "ほうこうぞくかごうぶつ": "مركب عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات)",
 "ほうこうぞくせい": "عطرية (خاصية امتلاك أريج)",
 "ほうこうぞくたんかすいそ": "هيدروكربون عطري (هيدروكربون يحتوي على حلقة بنزين واحدة أو أكثر تميز سلسلة البنزين من المركبات العضوية)",
 "ほうこうたんちき": "محدد الاتجاه (راديو؛ يحدد اتجاه موجات الراديو القادمة)",
 "ほうこうだ": "دَفَّة, سُكَّان / سُكَّان, دَفَّة",
 "ほうこうづけ": "إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً)",
 "ほうこうづける": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "ほうこうてんかん": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "ほうこうにん": "خَادِم, خَادِمَة",
 "ほうこうへんい": "تَذَبذُب, تَقَلُّب",
 "ほうこうゆ": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "ほうこうりょうほう": "علاج بالروائح (الاستخدام العلاجي للمستخلصات النباتية العطرية والزيوت الأساسية في الحمامات أو التدليك)",
 "ほうこく": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / وَطَنِيَّة, مَحَبَّةْ وَطَن / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "ほうこくかい": "استخلاص معلومات, تقرير مهمة (تقرير عن مهمة أو واجب)",
 "ほうこくかん": "مقرر (مسجل تعينه لجنة لإعداد تقارير الاجتماعات)",
 "ほうこくしゃ": "مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "ほうこくしょ": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "ほうこくしょぎょう": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ほうこん": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "ほうご": "يَابَانِيّ",
 "ほうごう": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / غرزة, قطبة جراحية (درزة أو وصلة تستخدم في الجراحة) / درز (مفصل غير متحرك (خاصة بين عظام الجمجمة)) / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "ほうごうし": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / غرزة, قطبة جراحية (درزة أو وصلة تستخدم في الجراحة) / درز (مفصل غير متحرك (خاصة بين عظام الجمجمة))",
 "ほうごうたい": "مَقْرُون, مُتَرَافِق ((فِي الكِيمِيَاء العُضْوِيَّة) يَحْتَوِي عَلَى رَابِطَتَيْن مُزْدَوِجَتَيْن أَوْ أَكْثَر يَفْصِلُ بَيْنَهُمَا رَابِطَة أُحَادِيَّة) / مُتَّحِد, مُقْتَرِن (مُتَكَوِّن مِنِ اتِّحَاد مُرَكَّبَيْن) / مُقْتَرِن ((عن الوريقة الريشيّة) ذو زوج واحد فقط من الوريقات) / مُزْدَوِج, مُقْتَرِن (مُتَّصل ببعضه خاصة في أزواج)",
 "ほうさく": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ほうさん": "حمض البوريك (أي من الأحماض المختلفة التي تحتوي على البورون والأكسجين) / حمض الأرثوبوريك, حمض البوريك (مادة صلبة بيضاء أو عديمة اللون حمضية قليلاً قابلة للذوبان في الماء والإيثانول؛ تستخدم في صناعة الزجاج والورق والمواد اللاصقة وفي المنظفات وكمطهر…) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ほうさんえん": "بورات (ملح أو إستر لحمض البوريك)",
 "ほうさんちゅう": "شعاعي (أوالي ذات أجسام تشبه الأميبا وأقدام كاذبة خيطية شعاعية)",
 "ほうし": "خِدْمَة / أُقْنُوم / فَرْد / بوغ (جسم تكاثري لاجنسي صغير عادة ما يكون وحيد الخلية تنتجه العديد من النباتات غير الزهرية والفطريات وبعض البكتيريا والأوالي، وهو قادر على التطور إلى فرد…)\nمثال: يتكون البوغ الجنسي بعد اندماج الأمشاج / إِحْسَان / إِبَاحِيّ / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / سَاحِر / حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "ほうしかつどう": "عمل تطوعي محبب (عمل منتج يتم إنجازه طوعاً دون مكافأة مادية أو تعويض)",
 "ほうしき": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "ほうししゃ": "خَادِم, خَادِمَة / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "ほうししょくぶつ": "بَوْغِيّ, حَامِلٌ لِلْأَبْوَاغِ (يَحْمِلُ الأَبْوَاغَ بَدَلًا مِنْ إِنْتَاجِ البُذُورِ)",
 "ほうしたい": "طور بوغي, نابت بوغي (الفرد أو الطور المنتج للأبواغ في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "ほうしだんたい": "نادي الخدمة العسكرية (مركز ترفيهي لرجال الخدمة العسكرية) / نادي خدمة (نادي من المهنيين أو رجال الأعمال منظم لتنسيقهم ونشط في الخدمات العامة)",
 "ほうしっこう": "إنفاذ القانون (ضمان طاعة القوانين)",
 "ほうしのう": "كيس الأبواغ, محفظة بوغية (عضو يحتوي على الأبواغ أو ينتجها)",
 "ほうしのうぐん": "بثرة بوغية, كويمة بوغية (مجموعة من الحوافظ البوغية عادة على الجانب السفلي لسعفة السرخس) / بثرة (بنية منتجة للأبواغ في بعض الأشنات والفطريات)",
 "ほうしめ": "شماسة (امرأة برتبة شماس)",
 "ほうしゃ": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / كُرْسِيّ, قَنْدَاق (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي. / أَجْر, مُكَافَأَة (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / أَجْر, رَاتِب (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة. / بَوْرَق",
 "ほうしゃあつ": "ضغط الإشعاع (الضغط الدقيق الذي يمارس على سطح عمودي على اتجاه انتشار الموجة)",
 "ほうしゃかいへん": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "ほうしゃかがく": "كيمياء إشعاعية, كيمياء نووية (كيمياء المواد المشعة)",
 "ほうしゃきん": "أكتينوميسيس, شعية (رميات تعيش في التربة وطفيليات نباتية وحيوانية مسببة للأمراض)",
 "ほうしゃく": "صك الإقطاع (في ظل النظام الإقطاعي، الصك الذي بموجبه يُمنح الشخص أرضاً مقابل تعهد بالخدمة)",
 "ほうしゃけい": "راديومتر, مقياس الإشعاع (مقياس للكشف عن الطاقة الإشعاعية وقياسها (كهرومغناطيسية أو صوتية))",
 "ほうしゃじょう": "شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك) / إشعاعي (صادر في أشعة من مركز مشترك؛ أو متعلق بأشعة الضوء) / نصف قطري (متعلق بنصف القطر أو يتحرك على طوله أو في اتجاهه) / كعبري (متعلق بعظم الكعبرة أو بالقرب منه)\nمثال: حرارة إشعاعية",
 "ほうしゃせい": "مُشِعّ (يظهر أو ناتج عن النشاط الإشعاعي)\nمثال: نظير مشع",
 "ほうしゃせいたんそ": "كربون 14, كربون مشع (نظير مشع للكربون)",
 "ほうしゃせいたんそねんだいそくてい": "تأريخ بالكربون المشع (تَسْجِيْل التَارِيْخ)",
 "ほうしゃせいたんそねんだいそくていほう": "تأريخ بالكربون المشع (تَسْجِيْل التَارِيْخ)",
 "ほうしゃせいどういかく": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "ほうしゃせいどういげんそ": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "ほうしゃせいどういたい": "نظير مشع (نظير مشع لعنصر ما؛ ينتج إما طبيعياً أو صناعياً)",
 "ほうしゃせいはいきぶつ": "نفايات مشعة (مواد مشعة عديمة الفائدة تتبقى بعد اكتمال عملية مخبرية أو تجارية)",
 "ほうしゃせいぶっしつ": "مادة مشعة (مادة ذات نشاط إشعاعي)",
 "ほうしゃせいほうかい": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "ほうしゃせいほうかいけいれつ": "اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين)",
 "ほうしゃせん": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ほうしゃせんいがく": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو غيرها من الإشعاعات المخترقة) / علم الأشعة (فرع العلوم الطبية المعني بالاستخدام الطبي للأشعة السينية أو الإشعاعات المخترقة الأخرى)",
 "ほうしゃせんかい": "طَبِيب أَشِعَّة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "ほうしゃせんかんじゅせい": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "ほうしゃせんがく": "تنظير إشعاعي, علم الأشعة ((علم الأشعة) فحص الهيكل الداخلي للأشياء المعتمة باستخدام الأشعة السينية أو غيرها من الإشعاعات المخترقة) / علم الأشعة (فرع العلوم الطبية المعني بالاستخدام الطبي للأشعة السينية أو الإشعاعات المخترقة الأخرى)",
 "ほうしゃせんぎし": "مصور أشعة (شخص يقوم بعمل صور الأشعة)",
 "ほうしゃせんせいぶつがく": "بيولوجيا إشعاعية (فرع علم الأحياء الذي يدرس تأثيرات الإشعاع على الكائنات الحية)",
 "ほうしゃせんそくていき": "كاشف الجسيمات (حجرة يمكن فيها جعل الجسيمات مرئية)",
 "ほうしゃせんちりょう": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "ほうしゃせんびょう": "داء الإشعاع, متلازمة الإشعاع (متلازمة ناتجة عن التعرض للإشعاع المؤين (مثل التعرض للمواد الكيميائية المشعة أو للانفجارات النووية)؛ الجرعات المنخفضة تسبب الإسهال والغثيان والقيء…)\nمثال: كان يعاني من الإشعاع",
 "ほうしゃせんぶんかい": "تحلل إشعاعي (تفكك جزيئي ناتج عن الإشعاع)",
 "ほうしゃせんりょうほう": "علاج إشعاعي ((طب) علاج المرض (خاصة السرطان) عن طريق التعرض لمادة مشعة)",
 "ほうしゃそうしょう": "تناظر شعاعي (خاصية التناظر حول محور)\nمثال: نجم البحر يوضح التناظر الشعاعي",
 "ほうしゃのう": "إشعاع, نشاط إشعاعي (الانبعاث التلقائي لتيار من الجسيمات أو الأشعة الكهرومغناطيسية في الاضمحلال النووي) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / مادة مشعة (مادة ذات نشاط إشعاعي)",
 "ほうしゃのうひょうしき": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "ほうしゃのうマーク": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "ほうしゃエネルギー": "طاقة إشعاعية (طاقة تنتقل في شكل إشعاع (كهرومغناطيسي)؛ طاقة توجد في غياب المادة)",
 "ほうしゅ": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية) / رامي, مسلح (شخص يطلق النار بمسدس (فيما يتعلق بقدرته)) / حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "ほうしゅう": "أَجْر, مُكَافَأَة (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / أَجْر, رَاتِب (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة.",
 "ほうしゅく": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "ほうしゅつ": "إصدار, انبعاث (فعل الإصدار؛ التسبب في التدفق للخارج) / انبعاث, خروج (حدوث تدفق للماء (كما من أنبوب)) / إفراز, انبعاث (أي من العمليات الجسدية العديدة التي تخرج بموجبها المواد من الجسم) / انبعاث (إطلاق الإلكترونات من الذرات الأم)\nمثال: خروج الصديد / أَطْلَقَ سَرَاح, حَرَّرَ / بزوغ السن (ظهور السن عند اختراقه اللثة) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ) / اندلاع, تفشي (حدوث تلقائي عنيف ومفاجئ (عادة لحالة غير مرغوب فيها)) / ثوران, ثوران بركاني (الحدوث المفاجئ لتفريغ عنيف للبخار والمواد البركانية)\nمثال: اندلاع الأعمال العدائية",
 "ほうしゅつおん": "صوت قذفي (نوع من الصوامت في بعض اللغات، مثل الهوسا، يُنتج عن طريق الإطلاق المفاجئ للضغط من المزمار)",
 "ほうしゅん": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "ほうしょ": "تَذْكار",
 "ほうしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء. / إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / عِلَاوَة / إِطْرَائِيّ, ثَنَائِيّ (مَلِيء بالثناء أو يُقَدِّم المديح) / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほうしょうきん": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "ほうしょうひ": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "ほうしょく": "أُخْدُود (أخْدُودُ) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة (أو المقلدة))",
 "ほうしょくてん": "جوهرجي, صائغ (شخص يعمل في مجال بيع المجوهرات) / جواهري, صائغ (شخص يصنع المجوهرات)",
 "ほうしょくひん": "حلي, مجوهرات (زينة (كالسوار أو الخاتم أو العقد) مصنوعة من معادن ثمينة ومرصعة بالأحجار الكريمة (أو المقلدة))",
 "ほうしりょう": "رسم الخدمة (نسبة مئوية من الفاتورة (كما في فندق أو مطعم) تضاف كدفع للخدمة) / رسوم الخدمات (رسم يُدفع لمالك مبنى سكني مقابل الكهرباء والمصاعد والصيانة وما إلى ذلك)",
 "ほうしん": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية) / رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر) / سَنَد تَأْمِين ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً)\nمثال: عاد إلى السياسة. / إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى اتجاه القطب المغناطيسي للأرض) / حَلَأ, هِرْبِس (حلأ الجلد: قشره؛ حلأ: ضرب) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح) / تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي)",
 "ほうしんじょうたい": "تحديق في النجوم (مراقبة النجوم)",
 "ほうじ": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء / سَاحِر",
 "ほうじしんごう": "إشارة الوقت (إشارة (خاصة إلكترونية أو لاسلكية) تشير إلى الوقت الصحيح بدقة)",
 "ほうじゅう": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم",
 "ほうじゅつ": "المدفعية, علم المدفعية (المدافع مجتمعة) / طَرِيقَة, مِنْهَج / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "ほうじゅつか": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية) / رامي, مسلح (شخص يطلق النار بمسدس (فيما يتعلق بقدرته))",
 "ほうじゅん": "وافِر, وَفِير / برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "ほうじょ": "مُسَاعَدَة, إِمْدَاد / تحريض, حث (الفعل اللفظي للحث)",
 "ほうじょう": "خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل. / حويصلي (من أو يتعلق بالحويصلات أو يتضمنها)\nمثال: تنفس حويصلي طبيعي / مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "ほうじょうきたい": "حمل عنقودي, رحى عدارية (شذوذ أثناء الحمل؛ تتحلل الزغابات المشيمية حول الجنين وتشكل عناقيد من أكياس مملوءة بسائل؛ يرتبط عادة بموت الجنين)",
 "ほうじょうのつの": "قرن الوفرة (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "ほうじょどうし": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو الضرورة)",
 "ほうじる": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / أَطَاعَ / شَوَى, صَلَى / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほうじん": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما) / مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "ほうじんか": "إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "ほうじんそしきにする": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "ほうすい": "تَصْرِيف / خُرْطُوم مَاءٍ, خُرْطُوم / ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته) / هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها) / هَايْدْرَات",
 "ほうすいかん": "أنبوب صرف, أنبوب نفايات (أنبوب يتم من خلاله نقل السوائل بعيداً)",
 "ほうすいき": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ほうすいけい": "هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها)",
 "ほうすいしゃ": "شاحنة مياه (شاحنة صهريج تستخدم لنقل وتوزيع المياه)",
 "ほうすいじゅう": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "ほうすいじょ": "قَادِس",
 "ほうすいほう": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "ほうすいクロラール": "هيدرات الكلورال (دواء بلوري عديم اللون يستخدم كمهدئ؛ يهيج المعدة ويمكن أن يسبب الإدمان)",
 "ほうする": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "ほうず": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "ほうずき": "حرنكش, كرز أرضي",
 "ほうずる": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / أَطَاعَ / شَوَى, صَلَى / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほうせい": "تَشْرِيع / شَرِيعَة, قَانُون (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟ / استقامة, نزاهة (الصلاح الناتج عن كون الشخص شريفاً وصادقاً) / خِيَاطَة, حِيَاكَة / مُعَالَجَة",
 "ほうせいか": "تشريع, سن القوانين (عملية سن أو تشريع القوانين)",
 "ほうせいしんぎかい": "مجلس تشريعي (هيئة تشريعية مكونة من مجلس واحد)",
 "ほうせいど": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ほうせいび": "تَشْرِيع / شَرِيعَة, قَانُون (النهج والتبيين؛ العتبة)\nمثال: ما معنى كلمة \"شريعة\"؟",
 "ほうせき": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ほうせきしょう": "صَائِغ, صَائِغَة",
 "ほうせきてん": "تاجر مجوهرات, متجر مجوهرات (شركة تبيع وتشتري المجوهرات)",
 "ほうせきばこ": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى) / تابوت, نعش (صندوق يدفن فيه الميت أو يُحرق)",
 "ほうせつ": "إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية / إدراج, تضمين (دمج شيء ما تحت فئة أكثر عمومية) / مقدمة صغرى (مقدمة القياس المنطقي التي تحتوي على الحد الأصغر (الذي هو موضوع النتيجة))",
 "ほうせん": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "ほうせんか": "بَلْسَم, مَرْهَم",
 "ほうせんきん": "أكتينوميسيت, شعية (أي بكتيريا (بعضها ممرض للإنسان والحيوان) تنتمي إلى رتبة الشعيات)",
 "ほうせんきんしょう": "داء الشعيات (مرض يصيب الماشية ويمكن أن ينتقل إلى البشر؛ ينتج عن العدوى بالشعيات؛ يتميز بتورمات صلبة تفرز القيح عبر جيوب طويلة)",
 "ほうせんちゅう": "مِسَلَّة",
 "ほうそ": "بُورُون / بُور / تَذْكار",
 "ほうそう": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء / إِذَاعَة / مهنة المحاماة, نقابة المحامين (مجموعة الأفراد المؤهلين لممارسة القانون في ولاية قضائية معينة)\nمثال: تم قبوله في نقابة المحامين في نيو جيرسي / جُدَرِيّ / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر) / خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل) / حشد مزدحم, خلية (حشد يعج بالنشاط) / خَلِيَّةُ نَحْل (هيكل يوفر مسكناً طبيعياً للنحل؛ كما في شجرة مجوفة)",
 "ほうそうい": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "ほうそういん": "مُذِيع, مُذِيعَة",
 "ほうそうえん": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "ほうそうきょく": "محطة بث (محطة مجهزة لبث البرامج الإذاعية أو التلفزيونية)",
 "ほうそうげき": "دراما إذاعية, مسرح إذاعي (أداء درامي صوتي بحت يبث على الراديو)",
 "ほうそうし": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "ほうそうしきえん": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "ほうそうしつ": "إِسْتُودِيُو",
 "ほうそうしゃ": "إِذَاعَة / مُذِيع, مُذِيعَة",
 "ほうそうじかん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "ほうそうだいがく": "تعليم مستمر (برنامج تعليمي مصمم بشكل أساسي للطلاب البالغين الذين يشاركون بدوام جزئي) / الجامعة المفتوحة (جامعة بريطانية مفتوحة للأشخاص الذين ليس لديهم مؤهلات أكاديمية رسمية ويكون التدريس فيها بالمراسلة أو البث أو المدرسة الصيفية)",
 "ほうそうようじんこうえいせい": "سيزيوم (عنصر فلزي ناعم فضي أبيض قابل للسحب (سائل في درجات الحرارة العادية))",
 "ほうそうわく": "فترة زمنية, فسحة زمنية (وقت مخصص في جدول أو أجندة)\nمثال: البرنامج التلفزيوني لديه موعد بث جديد",
 "ほうそく": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうそくせい": "اطِّرَاد, انْتِظَام (صفة الاتصاف بمبدأ ثابت أو معدل ثابت) / انتظام, انتظام هندسي (خاصية للمضلعات: خاصية امتلاك أضلاع متساوية وزوايا متساوية)\nمثال: كان مشهوراً بانتظام عاداته",
 "ほうぞう": "اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى / بيت الكنز (مستودع للكنوز)",
 "ほうたい": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / ضِمَادَة, عِصَابَة",
 "ほうたいけい": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ほうたん": "جرأة, لفت للنظر (صفة البروز بقوة وبشكل مميز) / جبروت, وقاحة (عدوانية وقحة) / إقدام, جرأة (سمة الاستعداد للقيام بأمور تنطوي على مخاطرة أو خطر)\nمثال: لم أصدق وقاحتها",
 "ほうだい": "ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "ほうだて": "قائم النافذة (شريط رأسي غير هيكلي بين مصاريع أو ألواح النافذة (أو ألواح الشاشة))",
 "ほうだん": "صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة.",
 "ほうち": "مَعْلُومَات, مَعْلُومَة / أَهْمَلَ / إِهْمَال / إقْطَاعَة",
 "ほうちき": "إِنْذَار",
 "ほうちく": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "ほうちしゃかい": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "ほうちしゅぎ": "دستورية (الدعوة لنظام حكم وفقاً لمبادئ دستورية) / دستورية (نظام حكم دستوري (عادة بوجود دستور مكتوب))",
 "ほうちゃく": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "ほうちゅう": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ. / كيسة مائية (كيس مملوء بسائل؛ يتشكل نتيجة لغزو يرقات الديدان الشريطية)",
 "ほうちゅうしょう": "داء المشوكات, كيسات عذرية (الإصابة بيرقات المشوكات (الديدان الشريطية))",
 "ほうちょう": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "ほうちょうし": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "ほうちょうじゃ": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "ほうちょうにん": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "ほうっておく": "تَجَاهَلَ, طَنَّش",
 "ほうっと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق",
 "ほうづえ": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "ほうてい": "قَانُونِيّ / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / إِرَاءَة / إِهْدَاء, مَنْح",
 "ほうていがいこうきょうぶつ": "ممتلكات عامة (ممتلكات تملكها الحكومة)",
 "ほうていきゅうじつ": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "ほうていごうかん": "مُجَامَعَة قَاصِر",
 "ほうていしき": "مُعَادَلَة (المُوَازَنَة؛ في الرِيَاضِيَّات: هي مسألة مُتَوَازِنَة فيها طرفين كل واحد منهما يعادل الآخر فيها مَجْهُول أو أكثر يُرَادُ استخراجه)",
 "ほうていじゅんびりつ": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على دفع عدد كبير غير عادي من عمليات السحب عند الطلب إذا حدث ذلك)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "ほうていすいていそうぞくにん": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "ほうていそうぞくにん": "وريث شرعي (الشخص المخول قانوناً بوراثة ممتلكات شخص يموت دون وصية)",
 "ほうていだいりにん": "ممثل قانوني (ممثل شخصي ذو صفة قانونية (مثل التوكيل الرسمي أو منفذ الوصية))",
 "ほうていつうか": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "ほうていでんせんびょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "ほうていねんれい": "السن القانوني, سن الرشد (السن الذي يعتبر فيه الأشخاص مؤهلين لإدارة شؤونهم الخاصة)",
 "ほうていぶじょく": "اِزْدِرَاء المَحْكَمَة (عدم احترام قواعد محكمة قانونية)",
 "ほうていぶじょくざい": "اِزْدِرَاء المَحْكَمَة (عدم احترام قواعد محكمة قانونية)",
 "ほうてき": "قَانُونِيّ / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "ほうてきこうい": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "ほうてきそち": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "ほうてきてつづき": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية)",
 "ほうてきぶんしょ": "سند, صك قانوني ((في القانون) وثيقة تنص على علاقة تعاقدية أو تمنح حقاً ما)",
 "ほうてん": "دَلِيل, كُتَيِّب",
 "ほうでん": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج) / تفريغ كهربائي (تفريغ للكهرباء) / قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "ほうでんかこう": "تفريغ كهربائي (تفريغ للكهرباء)",
 "ほうでんとう": "مصباح تفريغ (مصباح يولد الضوء عن طريق تفريغ كهربائي بين قطبين في غاز)",
 "ほうと": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ほうとう": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران)",
 "ほうとうか": "فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً)",
 "ほうとうむすこ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "ほうとうもの": "فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً)",
 "ほうど": "حَيِّز / إقْطَاعَة / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "ほうどう": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "ほうどうかんけいしゃ": "الصحافة, وسائل الإعلام الإخبارية (الصحف والمجلات مجتمعة)",
 "ほうどうきかん": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "ほうどうきしゃ": "صَحَفِيّ, صَحَفِيَّة / مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "ほうどうし": "فعل الكيفية, فعل ناقص (فعل مساعد (مثل 'يمكن' أو 'سوف') يُستخدم للتعبير عن الاحتمالية أو الإمكانية أو الضرورة)",
 "ほうどうじん": "فيلق صحفي, مجموعة صحفية (مجموعة من الصحفيين يمثلون منشورات مختلفة يغطون جميعاً نفس المواضيع)\nمثال: الفيلق الصحفي للبيت الأبيض / مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "ほうどうのじゆう": "حُرِّيَّة اَلصِّحَافَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "ほうどうはん": "فيلق صحفي, مجموعة صحفية (مجموعة من الصحفيين يمثلون منشورات مختلفة يغطون جميعاً نفس المواضيع)\nمثال: الفيلق الصحفي للبيت الأبيض",
 "ほうどうばんぐみ": "برنامج إخباري, نشرة أخبار (برنامج مخصص للأحداث الجارية، غالباً ما يستخدم المقابلات والتعليقات)\nمثال: نشاهد أخبار الساعة السابعة كل ليلة",
 "ほうにょう": "تبول (إخراج البول) / خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل.",
 "ほうにん": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "ほうねつ": "تبديد الحرارة (تبديد الحرارة)",
 "ほうねつき": "مِشْعاع",
 "ほうねつせい": "تبديد الحرارة (تبديد الحرارة)",
 "ほうねつばん": "مبدد حراري (موصل معدني مصمم خصيصاً لتوصيل (وإشعاع) الحرارة)",
 "ほうのあみ": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうのう": "تَفَانٍ / إِهْدَاء",
 "ほうのき": "مَغْنُولِيَة",
 "ほうのしはい": "سيادة القانون (حالة من النظام تتوافق فيها الأحداث مع القانون)",
 "ほうのもとのびょうどう": "المساواة أمام القانون (الحق في الحماية المتساوية للقوانين)",
 "ほうの木": "مَغْنُولِيَة",
 "ほうはい": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / أريمة (مرحلة مبكرة من الجنين تنتج عن انقسام البويضة؛ كرة مملوءة بالسائل يتكون جدارها من طبقة واحدة من الخلايا) / حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً)",
 "ほうはいくう": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "ほうはいこう": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "ほうはく": "دكتوراه في القانون (درجة قانون فخرية) / لاندغريف (كونت كان له ولاية قضائية على منطقة كبيرة في ألمانيا في العصور الوسطى)",
 "ほうばい": "رَفِيق, رَفِيقَة",
 "ほうひ": "قَلْفَة, غُرْلَة / إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "ほうひせつだん": "خِتَان / طهور",
 "ほうび": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "ほうびょう": "زَهْرِيَّة",
 "ほうふ": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل. / وافِر, وَفِير",
 "ほうふく": "اِنْتِقَام / روب أكاديمي, روب القضاة (رداء يرتديه الأكاديميون أو القضاة)",
 "ほうふくかんぜい": "تعريفة انتقامية (تعريفة تفرض على كيان تجاري أجنبي كشكل من أشكال الرد الانتقامي)",
 "ほうふくしゅぎ": "اِنْتِقَامِيَّة",
 "ほうふくそち": "عَمَل اِنْتِقَامِيّ (عمل انتقامي ضد عدو في زمن الحرب)",
 "ほうふつ": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "ほうふん": "مُسَطَّح القِمَّة (له سطح علوي مسطح أو مُستوٍ)",
 "ほうぶつ": "قَطْعِيّ مُكَافِئ (ذو شكل القَطْع المكافئ) / أمثولي, رمزي (يشبه الأمثال أو يعبر عنه بها)",
 "ほうぶつせん": "قَطْعٌ مُكَافِئ, شَلْجَمِيّ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "ほうぶつめん": "مجسم قطع مكافئ (سطح له مقاطع مكافئة موازية لمحور إحداثي واحد ومقاطع بيضاوية متعامدة مع ذلك المحور)",
 "ほうぶる": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "ほうぶん": "يَابَانِيّ",
 "ほうぶんか": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي) / دستور, مدونة (مجموعة من القواعد أو المبادئ أو القوانين (وخاصة المكتوبة منها))",
 "ほうへい": "مِدْفَعِيّة",
 "ほうへいきゅう": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ほうへん": "نَقْد, اِنْتِقَاد",
 "ほうべん": "أَطْلَقَ سَرَاح, حَرَّرَ / طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة",
 "ほうほう": "طَرِيقَة, مِنْهَج / بِارْتِبَاك, بِتَشَوُّش (بطريقة مرتبكة)\nمثال: كتبت له الملكة أوغوستا رسالة هستيرية تعاطفت معه فيها بارتباك",
 "ほうほうがく": "مَنْهَج",
 "ほうほうてき": "إِجْرَائِيّ, شَكْلِيّ (يتعلق بممارسة المحكمة والإجراءات بدلاً من مبادئ القانون) / إجرائي (من أو متعلق بالإجراءات)\nمثال: القانون الإجرائي",
 "ほうほうのてい": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "ほうほうの体": "فتحة, كوة (مدخل مجهز بغطاء؛ خاصة الممرات بين طوابق السفينة) / دلو الفحم, سطل الفحم (حاوية للفحم؛ مشكلة لتسمح بصب الفحم في النار)",
 "ほうほうろん": "مَنْهَج",
 "ほうぼう": "هُنَا وَهُنَاكَ\nمثال: 観光名所をほうぼう訪ね歩いたので、すっかり疲れ果ててしまった。 — زيارة جميع المعالم السياحية حقاً ترهقني كثيراً . / السمكة الطيارة, روبن البحر (غرنار أمريكي؛ يوجد غالباً في الخلجان ومصبات الأنهار) / خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل) / حشد مزدحم, خلية (حشد يعج بالنشاط) / خَلِيَّةُ نَحْل (هيكل يوفر مسكناً طبيعياً للنحل؛ كما في شجرة مجوفة)",
 "ほうぼく": "حشيش, كلأ (طعام ضخم الحجم مثل العشب أو التبن للخيول أو الماشية التي ترعى) / حشائش, كلأ (الغطاء النباتي العشبي العصاري في أراضي الرعي)",
 "ほうぼくじょう": "مَرْعًى, مَسْرَح",
 "ほうぼくち": "أرض رعي, مرعى (حقل مغطى بالعشب أو النباتات وصالح لرعي الماشية)",
 "ほうまく": "غِشاءُ البَوْغ, غِطَاء (غشاء يحيط بالأبواغ النامية ويحميها، خاصة ذلك الذي يغطي البثرات البوغية في السرخس)",
 "ほうまつ": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا) / كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "ほうまつがいしゃ": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "ほうまつてき": "مُؤَقَّت, سَريع الزوال",
 "ほうまつむげん": "مُؤَقَّت, سَريع الزوال",
 "ほうまん": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن) / تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم) / خاطرة غريبة, شطحة (فكرة غريبة أو خيالية أو متقلبة)\nمثال: أيأس من تقلب ونزوة ذاكرتي / شَبَع",
 "ほうむかん": "قاضٍ عسكري, محامٍ عسكري (ضابط أركان يعمل كمستشار قانوني لقائد عسكري) / محامٍ عسكري (ضابط معين في مكتب المحامي العام للقضاء العسكري) / بريتور, قاضٍ روماني (قاضٍ منتخب سنوياً في الجمهورية الرومانية القديمة)",
 "ほうむそうかん": "محامٍ عام للقضاء العسكري (المستشار القانوني الأقدم لفرع من فروع الجيش)",
 "ほうむり": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "ほうむる": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "ほうめい": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "ほうめん": "أَطْلَقَ سَرَاح, حَرَّرَ / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "ほうめんたい": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "ほうもう": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうもち": "قُرْبَان",
 "ほうもつ": "كَنْز / قُرْبَان",
 "ほうもつこ": "بيت الكنز (مستودع للكنوز)",
 "ほうもつでん": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "ほうもん": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / مَزْغَل",
 "ほうもんかんご": "الرِعَايَة المَنْزِلِيَّة",
 "ほうもんきゃく": "طَازَج (طَازَج وَجَدِيد) / بَارِد عَلِيل, مُنْعِش ((عامّيّة اسكتلنديّة) يمنح البرودة والانتعاش) / زائر, ضيف (زائر اجتماعي أو للعمل) / متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "ほうもんぎ": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "ほうもんさき": "وِجْهَة, وُجْهَة",
 "ほうもんしゃ": "زَائِر / زَائِر, سَائِح",
 "ほうもんち": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ほうもんはんばい": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "ほうもんナース": "ممرضة زائرة (ممرضة تتقاضى أجراً لزيارة المرضى في منازلهم)",
 "ほうゆう": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ほうゆうぶつ": "إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "ほうよう": "تَحَمُّل / تَسَامُح / إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق / صَقَارَة / قِنَّابَة (ورقة متحورة أو جزء يشبه الورقة يقع أسفل النورة الزهرية ويحميها)",
 "ほうようりょく": "تَحَمُّل / تَسَامُح",
 "ほうよく": "خُصُوبَة",
 "ほうらい": "تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان.",
 "ほうらいしだ": "شعر الزهرة, كزبرة البئر (سرخس كزبرة البئر الرقيق بسيقان أوراق سوداء لامعة رفيعة؛ عالمي الانتشار)",
 "ほうらいしょう": "جبنة سويسرية",
 "ほうらく": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع))\nمثال: الإبحار هو هوايتها المفضلة",
 "ほうらくせん": "مُغَلَّف, لِفَافَة / غِلَاف",
 "ほうらつ": "إِبَاحِيّ",
 "ほうらん": "حِضَانَة, تَفْرِيخ / بيض السمك, سرء (كتلة البيض التي تضعها الأسماك أو البرمائيات أو الرخويات) / أَوْجٌ, ذُرْوَةٌ",
 "ほうり": "مبدأ قانوني, مبدأ قضائي ((قانون) مبدأ يقوم عليه صياغة الفقه القانوني) / أَنَانَاس",
 "ほうりがく": "إجْتِهَاد, فِقْه",
 "ほうりこみ": "رَمْيَةُ تَمَاسّ",
 "ほうりこむ": "رَمْيَةُ تَمَاسّ",
 "ほうりだす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / طَرَدَ, أَقَالَ",
 "ほうりっぱなし": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي) / غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ) / جامد المشاعر, غير مبال (غير منفعل عاطفياً) / بكر, غير ملموس (لم يحدث بينه وبين شيء آخر تلامس)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "ほうりつ": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほうりつあん": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "ほうりつか": "مُحَامٍ, مُحَامِيَة",
 "ほうりつがく": "إجْتِهَاد, فِقْه",
 "ほうりつがくしゃ": "مُحَامٍ, مُحَامِيَة",
 "ほうりつこうい": "إجراء قانوني, دعوى قانونية (إجراء قضائي يرفعه طرف ضد آخر؛ يقاضي طرف طرفاً آخر بسبب خطأ ارتكب أو لحماية حق أو لمنع خطأ)",
 "ほうりつこん": "شَرْعًا, قَانُونِيًّا (بموجب القانون؛ مطابق للقانون) / بحكم القانون, شرعي (بحق؛ وفقاً للقانون)\nمثال: نحن متزوجان قانونياً الآن",
 "ほうりつじむしょ": "شركة محاماة, مكتب محاماة (شركة من المحامين)",
 "ほうりつじょう": "قَانُونِيّ",
 "ほうりつせいど": "نظام قانوني (نظام لتفسير وإنفاذ القوانين)",
 "ほうりつてき": "قَانُونِيّ",
 "ほうりなげる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "ほうりゃく": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ほうりゅう": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج) / إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "ほうりょう": "مُرَبَّعُ الشَّكْلِ (على هيئة المربّع)",
 "ほうりんこう": "فَالُون غُونْغ, فَالُون دَافَا",
 "ほうる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / أَهْمَلَ / إِهْمَال",
 "ほうるい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ほうれい": "قانون تشريعي, نظام أساسي (قانون تم تمريره من قبل هيئة تشريعية) / غَنِيّ / الْجَمَاهِير, العَامَّةُ / تبريد, نظام تبريد (آلية للحفاظ على برودة شيء ما) / تبريد, خفض درجة الحرارة (عملية التحول إلى البرودة؛ انخفاض درجة الحرارة)\nمثال: كان التبريد عبارة عن مراوح سقفية",
 "ほうれいじゅんしゅ": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "ほうれいせん": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "ほうれい線": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "ほうれつ": "أَرِيج, عَطِر (ذُو رَائِحَةٍ طَيِّبَةٍ قَوِيَّةٍ) / أروماتي, عطري ((كيمياء) من أو متعلق بـ أو يحتوي على حلقة بنزين واحدة أو أكثر)\nمثال: مركب عضوي عطري / ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "ほうれつかんぱん": "سطح المدافع (سابقاً أي سطح غير السطح المكشوف يحتوي على مدافع من أوله لآخره)",
 "ほうれんそう": "سَبَانِخ, إِسْفَانَاخ",
 "ほうれん草": "سَبَانِخ, إِسْفَانَاخ",
 "ほうろう": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / مِينَاء",
 "ほうろうしつ": "مِينَاء",
 "ほうろうしゃ": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)\nمثال: 放浪者は、金持ちならば観光客と称せられる。 — الشخص الجوال هو عندما يسمى الغني سائحاً.",
 "ほうろうへき": "هوس الترحال, ولع بالسفر (اندفاع قوي جداً أو لا يقاوم للسفر والترحال)",
 "ほうろう質": "مِينَاء",
 "ほうろく": "رَاتِب, أَجْر",
 "ほうろん": "إجْتِهَاد, فِقْه",
 "ほうわ": "إشباع, تشبيع (عملية النقع بالكامل بسائل) / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تشبع, تشرب (عملية إشباع شيء ما تماماً بمادة ما) / تشبع (حالة لا تستجيب فيها كمية ما لتأثير خارجي)\nمثال: تشريب الخشب بمادة حافظة",
 "ほうわしぼうさん": "حمض دهني مشبع (حمض دهني لا تستطيع سلسلة الكربون الخاصة به امتصاص أي ذرات هيدروجين أخرى؛ يوجد بشكل رئيسي في الدهون الحيوانية)",
 "ほうわじょうたい": "إشباع, تشبيع (عملية النقع بالكامل بسائل) / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تشبع, تشرب (عملية إشباع شيء ما تماماً بمادة ما) / تشبع (حالة لا تستجيب فيها كمية ما لتأثير خارجي)\nمثال: تشريب الخشب بمادة حافظة",
 "ほうわてん": "نقطة التشبع ((كيمياء) المرحلة التي لن تستقبل فيها المادة المزيد من مادة أخرى في محلول أو بخار)",
 "ほう助": "مُسَاعَدَة, إِمْدَاد / تحريض, حث (الفعل اللفظي للحث)",
 "ほう素": "بُورُون / بُور",
 "ほう酸": "حمض البوريك (أي من الأحماض المختلفة التي تحتوي على البورون والأكسجين) / حمض الأرثوبوريك, حمض البوريك (مادة صلبة بيضاء أو عديمة اللون حمضية قليلاً قابلة للذوبان في الماء والإيثانول؛ تستخدم في صناعة الزجاج والورق والمواد اللاصقة وفي المنظفات وكمطهر…)",
 "ほえい": "دِفَاع, حِمَايَة / دِفاع",
 "ほえごえ": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "ほえざる": "العواء, سعدان العواء (قرد يعيش في غابات أمريكا الجنوبية الاستوائية، يتميز بصيحات عواء عالية)",
 "ほえたてる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "ほえだす": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "ほえる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء / عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "ほえ立てる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "ほお": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "ほおあか": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "ほおい": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "ほおえみ": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "ほおえむ": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "ほおがゆるむ": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "ほおげた": "وَجْنَة, عَظْم وَجْنِيّ",
 "ほおじろ": "قِرْش أَبْيَض عَظِيم",
 "ほおじろざめ": "قِرْش أَبْيَض عَظِيم",
 "ほおずき": "حرنكش, كرز أرضي",
 "ほおずきがい": "عضدي الأرجل (حيوان بحري ذو صدفة ذات مصراعين وله زوج من الأذرع تحمل مجسات لالتقاط الطعام)",
 "ほおそめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "ほおっておく": "تَجَاهَلَ, طَنَّش",
 "ほおづえ": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "ほおづき": "حرنكش, كرز أرضي",
 "ほおのき": "مَغْنُولِيَة",
 "ほおひげ": "لِحْيَة (الشعر النامي على الجزء السفلي من وجه الرجل)",
 "ほおぶくろ": "جيب شدقي (جيب غشائي داخل فم العديد من القوارض (مثل الغوفر))",
 "ほおべに": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أمانيت محمر, فطر محمر (غاريقون مصفر صالح للأكل يتحول عادة إلى اللون الأحمر عند لمسه)",
 "ほおぼね": "وَجْنَة, عَظْم وَجْنِيّ",
 "ほおをこうちょうさせる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "ほおをそめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "ほおんせい": "عزل حراري (تقليل انتقال الحرارة بين الأجسام المتلامسة حرارياً أو في نطاق التأثير الإشعاعي)\nمثال: هناك عدد من المنتجات المتاحة المصممة لتحسين العزل الحراري للمنازل، بما في ذلك الزجاج الحراري مثل بلانيثيرم",
 "ほお紅": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أمانيت محمر, فطر محمر (غاريقون مصفر صالح للأكل يتحول عادة إلى اللون الأحمر عند لمسه)",
 "ほか": "آخَر, غَيْرُهُ (أيّ بديل من بدائل شتّى؛ شيء آخر) / آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ) / أَقْصَى / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / فَوْق / فَوْقَ\nمثال: أبعد صورتها عني. / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "ほかい": "أشواط إضافية (اللعب الإضافي حتى يتقدم فريق واحد في نهاية الشوط؛ مثل البيسبول)",
 "ほかく": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "ほかくがん": "دَخِيلَة صَخْرِيَّة ((جيولوجيا) قطعة من الصخر من أصل مختلف عن الصخر الناري الذي توجد فيه)",
 "ほかくゆ": "دوبين (شحم ممزوج بالزيت؛ يُستخدم لجعل الجلد ناعماً ومقاوماً للماء)",
 "ほかけぶね": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "ほかげ": "ضوء النار (ضوء النار (خاصة في الموقد))",
 "ほかす": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "ほかぜ": "رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة)",
 "ほかっておく": "تَجَاهَلَ, طَنَّش",
 "ほかでもない": "لم يعد (ليس الآن) / ليس, ليس أكثر (إشارة إلى الدرجة التي توجد بها صفة معينة)\nمثال: لم تعد موجودة",
 "ほかない": "هُنَاكَ, يُوجَدُ\nمثال: 私たちはそこへ行くよりほかなかった。 — لم يكن لدينا خيار إلا الذهاب إلى هناك.",
 "ほかに": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "ほかにほうほうがない": "هُنَاك, يُوجَد",
 "ほかにほうほうはない": "هُنَاك, يُوجَد",
 "ほかにも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "ほかに方法がない": "هُنَاك, يُوجَد",
 "ほかに方法はない": "هُنَاك, يُوجَد",
 "ほかはない": "هُنَاكَ, يُوجَدُ",
 "ほかほか": "مُتَوَهِّج",
 "ほかん": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / تَوْزِيع تَكَامُلِيّ ((اللغويات) توزيع أصوات أو أشكال الكلام ذات الصلة بطريقة تجعلها تظهر فقط في سياقات مختلفة) / تَتْمِيم, تَكْمِلَة (العلاقة النحوية لكلمة أو عبارة بمسند) / إقحام, اعتراض (فعل إقحام أو إدراج إجراء أو ملاحظة تقاطع الحديث) / إقحام داخلي, استكمال ((رياضيات) حساب قيمة دالة بين القيم المعروفة بالفعل) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / ملحق / مُكَمِّل",
 "ほかんいがく": "طب تكميلي (ممارسة الطب التي تجمع بين الطب التقليدي والطب البديل)",
 "ほかんいりょう": "طب تكميلي (ممارسة الطب التي تجمع بين الطب التقليدي والطب البديل)",
 "ほかんがいしゃ": "صندوق ودائع آمن (صندوق معدني مقاوم للحريق (عادة في البنك) لتخزين الأشياء الثمينة)",
 "ほかんこ": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "ほかんじょ": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "ほかんにん": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "ほかんばしょ": "مخزن, مستودع (منشأة يمكن فيها إيداع الأشياء للتخزين أو الحفظ)",
 "ほかんほう": "إقحام, اعتراض (فعل إقحام أو إدراج إجراء أو ملاحظة تقاطع الحديث) / إقحام داخلي, استكمال ((رياضيات) حساب قيمة دالة بين القيم المعروفة بالفعل) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية",
 "ほがいほう": "استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة) / إقحام خارجي, استقراء ((رياضيات) حساب قيمة دالة خارج نطاق القيم المعروفة)",
 "ほがらか": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / لَامِع, نَيِّر / مُسْتَنِير",
 "ほき": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ほきだす": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ / زَفَرَ (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق) / أَنْفَقَ, صَرَفَ / قَضَى / مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "ほきゅう": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة / ضربة أرضية, كرة أرضية ((بيسبول) ضربة تسير على الأرض)",
 "ほきゅうしょく": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "ほきゅうせん": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات) / سفينة تموين (سفينة توفر عادة الإمدادات لسفن أخرى)",
 "ほきゅうろ": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "ほきょう": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "ほきょうしょうこ": "إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "ほきんしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "ほくおう": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "ほくおうしょこく": "دولة إسكندنافية (أي دولة من الدول التي تشغل إسكندنافيا)",
 "ほくおうしんわ": "الأساطير الإسكندنافية (أساطير الدول الإسكندنافية (التي تشترك فيها جزئيًا بريطانيا وألمانيا) حتى تغلغل المسيحية)",
 "ほくおうじん": "إسكندنافي, نورسي (من أو يتعلق بإسكندنافيا أو شعوبها أو ثقافاتها) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا) / إسكندنافي (أحد سكان إسكندنافيا)\nمثال: الملاحم النورسية",
 "ほくせい": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة) / حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "ほくせいぶ": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "ほくせん": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "ほくそ": "وَرْيَة نَار, رِيَّة",
 "ほくそえむ": "شَمِتَ",
 "ほくそく": "الجانب الشمالي (الجانب الذي يقع في الشمال)",
 "ほくそ笑む": "شَمِتَ",
 "ほくち": "وَرْيَة نَار, رِيَّة",
 "ほくちばこ": "علبة الصوان, علبة القدح (صندوق لحفظ مادة سريعة الاشتعال (الصوفان) لإشعال النار) / برميل بارود, وضع قابل للانفجار (حالة خطيرة؛ وضع يمثل مصدراً محتملاً للعنف)\nمثال: البلقان هي برميل بارود أوروبا",
 "ほくと": "بَنَاتُ نَعْشٍ الكُبْرَى / كِيُوتُو",
 "ほくとう": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "ほくとうぶ": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "ほくとしちせい": "بَنَاتُ نَعْشٍ الكُبْرَى",
 "ほくとせい": "بَنَاتُ نَعْشٍ الكُبْرَى",
 "ほくどう": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ほくひょうよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほくび": "سنبلة",
 "ほくふう": "رياح شمالية (رياح تهب من الشمال)",
 "ほくぶ": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ほくぶちいき": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ほくぶどうめい": "التحالف الشمالي, الجبهة المتحدة (تحالف متعدد الأعراق في أفغانستان يمارسون شكلاً معتدلاً من الإسلام ومتحدون في معارضتهم لطالبان)",
 "ほくべい": "أَمْرِيكَا الشَّمَالِيَّة",
 "ほくべいがっしゅうこく": "الْوِلَايَات الْمُتَّحِدَة الْأَمْرِيكِيَّة, الْوِلَايَات الْمُتَّحِدَة",
 "ほくべいたいりく": "أمريكي شمالي (متعلق بقارة أمريكا الشمالية أو دولها أو شعوبها أو مميز لها) / أمريكي شمالي (مواطن أو ساكن في أمريكا الشمالية)",
 "ほくべいどじん": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "ほくほく": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب)",
 "ほくほくせい": "باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "ほくほくとう": "باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)"
}
