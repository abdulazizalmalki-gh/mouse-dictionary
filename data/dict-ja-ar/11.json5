 "ちゃら男": "مَرِح, مُعَاشِر (مشغول بمتع الصُّحْبَة الطيّبة أو مُولَع بها)",
 "ちゃり": "دَرَّاجَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص)) / بسْكليت / بِسِكْليت / بِسْكْلات\nمثال: كين يريد دراجة.",
 "ちゃりき": "دَرَّاجَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص)) / بسْكليت / بِسِكْليت / بِسْكْلات\nمثال: كين يريد دراجة.",
 "ちゃりょう": "مَطْعَم",
 "ちゃりんこ": "دَرَّاجَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص)) / بسْكليت / بِسِكْليت / بِسْكْلات\nمثال: كين يريد دراجة.",
 "ちゃわかい": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي)",
 "ちゃわん": "فنجان شاي (كوب يشرب منه الشاي) / ملء فنجان شاي (بقدر ما يستوعبه فنجان شاي)",
 "ちゃをにごす": "لَفَّ وَدَارَ",
 "ちゃん": "بَابَا",
 "ちゃんこ": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "ちゃんこい": "صَغِير, صغير",
 "ちゃんころ": "نَقْد, نُقُود",
 "ちゃんちゃらおかしい": "سَخِيف, مَسْخَرَة",
 "ちゃんちゃら可笑しい": "سَخِيف, مَسْخَرَة",
 "ちゃんちゃん": "بانتظام, بشكل منتظم (بطريقة منتظمة دون تباين) / بانتظام, بصفة منتظمة (بأسلوب منتظم ومتكرر) / بشكل متناسق, بشكل منتظم (ما كان له شكل منتظم هندسياً)\nمثال: حاول أن تتنفس بانتظام",
 "ちゃんちゃんばらばら": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "ちゃんと": "بِجِدّ / بِإِتْقَان, تَمَامًا / بشكل كاف (إلى درجة كافية)\nمثال: كانت طليقة بشكل كاف في الماندرين / بِسُرْعَة, عَاجِلًا",
 "ちゃんとかん": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "ちゃんとした": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "ちゃんと感": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "ちゃんねる": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "ちゃんぽん": "خَلِيط",
 "ちゃんぽんに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب / كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: تم تجميعهم كلهم معاً",
 "ちやほや": "دَلَّلَ, دَلَّعَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ)\nمثال: دلل سامي صديقته.",
 "ちゅう": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل. / صَرِير / صَرَّ ((صَرَّ) يَصْرِرِ صَريرًا: صوَّتَ. يقال: (صَرَّ) العصفورُ والجُندُبُ، و(صَرَّ) القلم، و(صَرَّ) البابُ؛ (صَرَّتِ) الأُذنُ: كان لها طنين)\nمثال: لدى مايوكو حاسة بصر حادة. / تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال / مُتَوَسِّط / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي. / خِلَالَ, فِي / حَالِيًّا / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة / طْرُول / مُتَصَيِّد, طْرُول / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / أُسْطُوَانَة / وَفَاء, إِخْلَاص / إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام. / مَعْنًى / الْمَعْنَى / مَوْقِف, مَوْقِف سَيَّارَات",
 "ちゅうあい": "وَفَاء, إِخْلَاص",
 "ちゅうい": "مُتَوَسِّط / ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ) / اِهْتِمَام, اِنْتِبَاه / اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / نَصِيحَة, مَشُورَة / إِنْذَار, تَحْذِير (توبيخ حازم)",
 "ちゅういかんき": "يَقِظ",
 "ちゅういがき": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "ちゅういき": "قِطَاع",
 "ちゅういけっかんしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういけっかんたどうしょう": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういけっかんたどうしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういけっかんたどうせいしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういけつじょたどうしょう": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういけつじょたどうしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういけつじょたどうせいしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういさんまん": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "ちゅういしゅうちゅう": "تَرْكِيز",
 "ちゅういしょ": "إرشادات",
 "ちゅういじこう": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "ちゅういすう": "وَسِيط",
 "ちゅういち": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "ちゅういと": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅういどこうあつたい": "عروض الخيل (أي من الحزامين أو المنطقتين بالقرب من 30 درجة شمالاً أو 30 درجة جنوباً؛ تتميز بهدوء ورياح خفيفة محيرة)",
 "ちゅういぶかい": "مُنْتَبِه",
 "ちゅういぶかく": "بانتباه (مع اهتمام)\nمثال: استمع بانتباه",
 "ちゅういほう": "اسْتِشَارِيّ, نَاصِح (يقدم النصح والمشورة) / تحذير, نشرة تحذيرية (إعلان ينصح عادة أو يحذر الجمهور من تهديد ما)\nمثال: تحذير من الصقيع",
 "ちゅういりょく": "انتباه, يقظة (سمة كون المرء ملاحظاً ومنتبهاً) / انتباه, مراعاة (سمة مراعاة الآخرين والتفكير فيهم) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين))\nمثال: يقظته لرغباتها",
 "ちゅういりょくけつじょしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういりょくさんまん": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "ちゅういをかんきする": "يَقِظ",
 "ちゅういをそそぐ": "أَعَارَ اِنْتِبَاه",
 "ちゅういをはらう": "أَعَارَ اِنْتِبَاه\nمثال: 彼は私の忠告に全く注意を払わなかった。 — لم يعر أي اهتمام لنصيحتي.",
 "ちゅういんふごう": "بُوبُومُوفُو",
 "ちゅうえい": "ظهير نصفي, هاف باك ((كرة قدم أمريكية) مركز ظهير في فريق كرة القدم، عموماً أصغر حجماً من الظهير الكامل) / ظهير نصف ((في كرة القدم الأمريكية) الظهير الراكض الذي يلعب مركز الظهير النصف الهجومي) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "ちゅうえいご": "إِنْجْلِيزِيَّة وُسْطَى (مُؤَنَّثُ إِنْجْلِيزِيّ، ٌ مُؤَنَّثَةٌ إِلَى ٱلْإِنجليزِ؛ اَللُّغَةُ ٱلْإِنجليزِيَّةُ: وَهي اللغَة الأكثَر ٱستعمَالًا (كلغة ثانية) في هذَا العصر…)\nمثال: تحدث بالإنجليزية!",
 "ちゅうおう": "مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / رَأْسْمَال, رَأْس مَال / تَاج العَمُود / أُورُوبَا الْوَسَطَى (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "ちゅうおうえんざんしょりそうち": "وحدَة المعالجَة المَرْكَزِيَّة",
 "ちゅうおうぎんこう": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "ちゅうおうぎんこうデジタルつうか": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "ちゅうおうけいば": "سباق الخيل (رياضة سباق الخيول)",
 "ちゅうおうしょりそうち": "وحدَة المعالجَة المَرْكَزِيَّة",
 "ちゅうおうじょうほうきょく": "سي آي إيه, وكالة الاستخبارات المركزية (وكالة مستقلة تابعة لحكومة الولايات المتحدة مسؤولة عن جمع وتنسيق أنشطة الاستخبارات والاستخبارات المضادة في الخارج من أجل المصلحة الوطنية؛ يرأسها مدير…)",
 "ちゅうおうせん": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "ちゅうおうそろえ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ちゅうおうぞろえ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ちゅうおうち": "وَسِيط",
 "ちゅうおうひょうじゅんじ": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "ちゅうおうぶ": "مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك",
 "ちゅうおうぶんりたい": "وَسِيط",
 "ちゅうおうよせ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ちゅうおうアジア": "آسِيَا الْوُسْطَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "ちゅうおうアフリカ": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "ちゅうおうアフリカきょうわこく": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "ちゅうおうアメリカ": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "ちゅうおうホール": "أُذَيْن",
 "ちゅうおうヨーロッパ": "أُورُوبَا الْوَسَطَى (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "ちゅうおん": "وسطى ((موسيقى) النغمة الثالثة في سلم دياتوني؛ تقع في المنتصف بين نغمة الأساس والنغمة المهيمنة) / بَارِيتُون (أخفض من مدى التينور وأعلى من الباص) / باريتون (ثاني أدنى آلة نفخ نحاسية) / باريتون (ثاني أدنى صوت غنائي للذكور البالغين) / باريتون (مغنٍ ذكر بطبقة صوتية متوسطة)",
 "ちゅうおんふごう": "بُوبُومُوفُو",
 "ちゅうか": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / قيظ / اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً) / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة) / قيظ / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "ちゅうかい": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / بَرِيق / سبيكة",
 "ちゅうかいぎょうしゃ": "سِمْسَار, وَسِيط",
 "ちゅうかいしゃ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / شارح, معلّق نصي (معلّق يكتب ملاحظات توضيحية لنص ما)",
 "ちゅうかいぶつ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうかいやく": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうかがい": "حَيّ صِينِي, تْشَايْنَاتَاوْن (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "ちゅうかく": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين) / حاجز (فاصل أو جدار خاصة في المبيض) / نَوَاة",
 "ちゅうかけい": "صِينِيّ",
 "ちゅうかじんみんきょうわこく": "جُمْهُورِيَّةُ الصِّينِ الشَّعْبِيَّةُ",
 "ちゅうかなべ": "وُوك",
 "ちゅうかひ": "الغِلاف المُتَوَسِّط, اللُّبّ (الطبقة الوسطى من غلاف الثمرة)",
 "ちゅうかみんこく": "جُمْهُورِيَّة الصِّين",
 "ちゅうかりょうりてんしょうこうぐん": "متلازمة المطعم الصيني (صداع وشعور بالوخز أو الحرق وتعرق ناتج عن تناول طعام يحتوي على غلوتامات أحادية الصوديوم)",
 "ちゅうかん": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط) / انْتِقَالِيّ, مَرْحَلِيّ (يخدم خلال فترة زمنيّة وسيطة) / أثناء ذلك, فترة مؤقتة (الوقت بين حدث أو عملية أو فترة وأخرى)\nمثال: في غضون ذلك، يدير الاشتراكيون الحكومة / نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "ちゅうかんえき": "محطة توقف صغيرة (محطة سكة حديد صغيرة بين المحطات الرئيسية أو محطة يتوقف فيها القطار فقط عند الإشارة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: هناك توقف لتغيير الطائرات في شيكاغو",
 "ちゅうかんぎょうしゃ": "وسيط تجاري (رجل يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من العملاء النهائيين) / مؤدي الوسط (مؤدٍ ذكر في وسط صف المنشدين يشارك الآخرين في الحديث) / وسيط (شخص ذكر في وضع يسمح له بتقديم مساعدة خاصة لك)",
 "ちゅうかんけん": "غلاف أوسط, ميزوسفير (طبقة الغلاف الجوي بين الستراتوسفير والثيرموسفير)",
 "ちゅうかんげんご": "لغة تفاهم مشترك, لغة مشتركة (لغة مشتركة يستخدمها متحدثو لغات مختلفة)\nمثال: كانت لغة الكوينيه لهجة من اليونانية القديمة التي كانت اللغة المشتركة لإمبراطورية الإسكندر الأكبر",
 "ちゅうかんこうさ": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "ちゅうかんこく": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "ちゅうかんさくしゅ": "رشوة تجارية, عمولة غير مشروعة (رشوة تجارية يدفعها البائع لوكيل الشراء لحث الوكيل على الدخول في المعاملة)",
 "ちゅうかんし": "مِيزُون (جسيم أولي مسؤول عن القوى في النواة الذرية؛ هادرون ذو عدد باريوني 0)",
 "ちゅうかんしけん": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "ちゅうかんしゅうはすう": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "ちゅうかんしゅくしゅ": "عائل وسيط (عائل يستخدمه الطفيلي في سياق دورة حياته)",
 "ちゅうかんしょうにん": "وسيط تجاري (رجل يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من العملاء النهائيين) / مؤدي الوسط (مؤدٍ ذكر في وسط صف المنشدين يشارك الآخرين في الحديث) / وسيط (شخص ذكر في وضع يسمح له بتقديم مساعدة خاصة لك)",
 "ちゅうかんせいかぶつ": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "ちゅうかんせつ": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "ちゅうかんせん": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "ちゅうかんそう": "طَبَقَة وُسْطَى",
 "ちゅうかんたい": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "ちゅうかんは": "محايد (مدافع عن الحياد في الشؤون الدولية)",
 "ちゅうかんはいせんばん": "الْجَيْش الْإِسْرَائِيلِيّ, الْجَيْش الدِّفَاع الْإِسْرَائِيلِيّ",
 "ちゅうかんぱん": "السطح الرئيسي (أعلى سطح مغطى يمتد على طول السفينة الكبيرة بالكامل)",
 "ちゅうかんぶ": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "ちゅうかんシステム": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ちゅうがえり": "شقلبة, شقلبة هوائية (حركة بهلوانية تدور فيها القدمان فوق الرأس (إما للأمام أو للخلف) ثم تعودان للأرض)",
