 "ちゅうどくせいひょうひえしゆうかいしょう": "عَشَرَة, عَشْرَة",
 "ちゅうなる": "مُخْلِص, وَفِيّ (شديد الإخلاص والمودّة والتفاني)",
 "ちゅうに": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ…)",
 "ちゅうにかい": "طابق مسروق, ميزانين (طابق متوسط يقع فوق الطابق الأرضي مباشرة)",
 "ちゅうにゅう": "مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "ちゅうにん": "خَاطِب, خَاطِبَة / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうねん": "كهولة, منتصف العمر (الفترة العمرية بين الشباب والشيخوخة (مثلاً، بين 40 و 60 سنة))",
 "ちゅうねんおとこ": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "ちゅうねんおんな": "كَهْل",
 "ちゅうねんぶとり": "كَهْل",
 "ちゅうねんもの": "كَهْل",
 "ちゅうのう": "دماغ متوسط (الجزء الأوسط من الدماغ) / مِن الطَّبَقَة المُتَوَسِّطَة (يحتل مكانة اجتماعية واقتصادية متوسطة بين الطبقات الدنيا والأثرياء)",
 "ちゅうは": "موجة متوسطة (موجة راديوية بطول موجي بين 100 و 1000 متر (تردد بين 300 كيلو هرتز و 3000 كيلو…)",
 "ちゅうはいよう": "أديم متوسط, الأديم الأوسط (الطبقة المنتشة الوسطى التي تتطور لتشكل العضلات والعظام والغضاريف والدم والنسيج…)",
 "ちゅうはちょう": "موجة متوسطة (موجة راديوية بطول موجي بين 100 و 1000 متر (تردد بين 300 كيلو هرتز و 3000 كيلو…)",
 "ちゅうはん": "مُنْتَصَف, وَسَط / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "ちゅうばん": "مركز, منتصف (نقطة متساوية البعد عن نهايات خط أو أطراف شكل ما) / خط الوسط, وسط الملعب ((رياضة) الجزء الأوسط من ملعب اللعب (كما في كرة القدم))",
 "ちゅうひ": "ظهارة متوسطة (ظهارة تنشأ في الأديم المتوسط الجنيني؛ تبطن تجويف الجسم البدائي)",
 "ちゅうひしゅ": "ورم الظهارة المتوسطة (شكل من أشكال سرطانة الظهارة المتوسطة المبطنة للرئتين أو البطن أو القلب؛ يرتبط…)",
 "ちゅうびゅう": "مُتَشَابِك, مُتَلَبِّد (مُلتَفّ ومتشابك في كتلة واحدة) / مَأْلُوف",
 "ちゅうびん": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうふ": "شَلَل, كَسَح / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "ちゅうふう": "شَلَل, كَسَح",
 "ちゅうふく": "سفح الجبل (جانب أو منحدر الجبل)\nمثال: تغطي غابات الصنوبريات السفح الشرقي",
 "ちゅうぶ": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / شَلَل, كَسَح",
 "ちゅうぶう": "شَلَل, كَسَح",
 "ちゅうぶじかん": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90…)",
 "ちゅうぶとり": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "ちゅうぶひょうじゅんじ": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90…)",
 "ちゅうぶらりん": "تعليق, دندلة (فعل تعليق شيء ما (تعليقه من الأعلى بحيث يتحرك بحرية))\nمثال: كان هناك حفل صغير لتعليق الصورة / قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "ちゅうぶる": "مُسْتَعْمَل (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل.",
 "ちゅうぶん": "تذييل, تعليق (عملية إضافة ملاحظات)\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "ちゅうぶアメリカ": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "ちゅうへん": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم) / بَلَاط / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ちゅうへんしょうせつ": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم)",
 "ちゅうべい": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "ちゅうほ": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية)",
 "ちゅうほしゃ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうぼう": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو…)\nمثال: سامي في المطبخ. / طْرُول",
 "ちゅうみせ": "مِن الطَّبَقَة المُتَوَسِّطَة (يحتل مكانة اجتماعية واقتصادية متوسطة بين الطبقات الدنيا والأثرياء)",
 "ちゅうみつ": "كَثِيف, غَلِيظ",
 "ちゅうもうしょう": "عشى, عمى نهاري (عدم القدرة على الرؤية بوضوح في الضوء الساطع)",
 "ちゅうもく": "لَاحَظَ",
 "ちゅうもくかぶ": "أسهم ساخنة, إصدار ساخن (أسهم صادرة حديثاً عليها طلب عام كبير)",
 "ちゅうもくど": "حُدُود خَارِجِيَّة",
 "ちゅうもくのまと": "محور, مركز اهتمام (الشيء الذي يركز عليه الاهتمام والانتباه)\nمثال: قصصه جعلته محور الحفلة",
 "ちゅうもり": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうもん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "ちゅうもんがおおい": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "ちゅうもんしゃ": "منظم, منهجي (منظم يضع الأشياء في ترتيب)\nمثال: كان أرسطو منظماً عظيماً للأفكار",
 "ちゅうもんしょ": "نموذج طلب (نموذج يستخدم عند تقديم طلب شراء)",
 "ちゅうもんじゅうたく": "مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "ちゅうもんせいさん": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب)",
 "ちゅうもんでんぴょう": "نموذج طلب (نموذج يستخدم عند تقديم طلب شراء)",
 "ちゅうもんとり": "بَيَّاع, بَيَّاعَة",
 "ちゅうもんのおおい": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "ちゅうもんふく": "مخصص, مفصل حسب الطلب (مصنوع وفقاً لمواصفات الفرد)",
 "ちゅうもんをつける": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "ちゅうや": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل. / انقلاب شتوي (22 ديسمبر، عندما تكون الشمس في أقصى نقطة جنوبية لها)",
 "ちゅうやく": "اَلطِّبّ اَلصِّينِيّ",
 "ちゅうやけんこう": "دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع)",
 "ちゅうやをとわず": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "ちゅうやをわかたず": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "ちゅうゆ": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "ちゅうよう": "عَنَى, قَصَدَ",
 "ちゅうようすい": "مُلْحَق",
 "ちゅうようとっき": "زائدة, زائدة دودية (نتوء أثري يمتد من الطرف السفلي للمصران الأعور ويشبه جيباً صغيراً)",
 "ちゅうようとっきえん": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "ちゅうりきこ": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ちゅうりく": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل…)\nمثال: محكم عليه بالإعدام.",
 "ちゅうりつ": "حِيَاد",
 "ちゅうりつしゅぎ": "حياد (سياسة الحياد أو عدم الانحياز في الشؤون الدولية)",
 "ちゅうりつせい": "حِيَاد",
 "ちゅうりつちたい": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "ちゅうりつてき": "مُحَايِد\nمثال: هذه هي نقطة ضعفه.",
 "ちゅうりゃく": "إِغْفَال",
 "ちゅうりゅう": "طَبَقَة وُسْطَى / إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ちゅうりゅうかいきゅう": "طَبَقَة وُسْطَى",
 "ちゅうりゅうしゃかい": "طَبَقَة وُسْطَى",
 "ちゅうりん": "مَوْقِف, مَوْقِف سَيَّارَات / مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうりんじょう": "مرآب, موقف سيارات (قطعة أرض تُوقف فيها السيارات)",
 "ちゅうる": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما)\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "ちゅうろう": "كهولة, منتصف العمر (الفترة العمرية بين الشباب والشيخوخة (مثلاً، بين 40 و 60 سنة)) / وصيفة الشرف (سيدة تُعين لخدمة ملكة أو أميرة)",
 "ちゅうろく": "عرق وسطي (العرق الموجود في وسط الورقة)",
 "ちゅうわ": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق)\nمثال: تحييد بلجيكا",
 "ちゅうわざい": "مُحَايِد, مُضَادّ (يُعارِض أو يُحايِد أو يُخفِّف من أثرٍ بفعل مضادّ)",
 "ちゅうわはんのう": "تعادل, تفاعل التعادل (تفاعل كيميائي يتفاعل فيه حمض وقاعدة لتكوين ملح؛ ومع الأحماض والقواعد القوية…)",
 "ちゅうボス": "نائب الزعيم (مساعد أو الرجل الثاني لرئيس (خاصة في عصابات الجريمة))",
 "ちゅう事": "وَبِعِبَارَة أُخْرَى",
 "ちゅきぴ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "ちゅけいるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "ちゅっぱら": "غَضَب",
 "ちゅら": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "ちゅらさん": "جَمَال, زَيْن",
 "ちゅるちゅる": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / نُودَلْز, شَعْرِيَّة",
 "ちゅん": "تَغْرِيدَة, تَغْرِيد",
 "ちゅんちゅん": "تَغْرِيدَة, تَغْرِيد",
 "ちゅー": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / صَرِير\nمثال: لدى مايوكو حاسة بصر حادة.",
 "ちゆ": "شِفَاء",
 "ちゆう": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ちょ": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / بِجَانِب, جنب (بجانب)\nمثال: زيري بجانب الحوض. / صَفَاء, نَقَاء (صفة الماء الصافي)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / يَاه, اسمع",
 "ちょい": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً",
 "ちょいちょい": "كَثِيرًا, غَالِبًا / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب)\nمثال: أخذ الأمر باستخفاف / بِسُهُولَة",
 "ちょいと": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً / بِسُهُولَة",
 "ちょいやく": "دور ثانوي, دور صغير (دور صغير)",
 "ちょい役": "دور ثانوي, دور صغير (دور صغير)",
 "ちょう": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة…)\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية. / لافِتَة\nمثال: توم وقع و أصيب. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / سُلَالَة / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / مِعًى / فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة! / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / طَبْعًا / فَوْقَ\nمثال: أجب على السؤال. / رَئِيس, رَئِيسَة / جَدَارَة / تَفَوُّق / رَائِد / زِرّ / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / مِقْيَاس\nمثال: هبطت على البحر. / مَعْرُوف / خراج, دمل (قرحة مؤلمة ذات لب صلب مملوء بالقيح) / لافِتَة\nمثال: توم وقع و أصيب. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي…)\nمثال: أولاً عليك ملء طلب الصرف / مَدِينَة, قَرْيَة / شَارِع, زَنَقَة",
 "ちょうあい": "مَعْرُوف / جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع",
 "ちょうあくだま": "شرير خارق (شرير يتمتع بقوى خارقة)",
 "ちょうい": "تَأْسِيَة / رداء احتفالي, روب (ملابس خارجية تتكون من ثوب طويل منسدل يستخدم في المناسبات الرسمية أو الاحتفالية)",
 "ちょういき": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض)\nمثال: إنه حي ودود",
 "ちょういちりゅう": "بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "ちょういん": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "ちょういんしゃ": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "ちょうえいじゅうたく": "مساكن شعبية, مشروع إسكان عام (مجمع سكني ممول ومُدار حكومياً للأسر ذات الدخل المنخفض)",
 "ちょうえきけい": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "ちょうえつ": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة)",
 "ちょうえつしゅぎ": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "ちょうえつすう": "عَدَد مُتَسَامٍ (عدد غير نسبي ليس جبرياً (لا يمكن أن يكون حلاً لمعادلة جبرية))",
 "ちょうえつすうろん": "عَدَد مُتَسَامٍ (عدد غير نسبي ليس جبرياً (لا يمكن أن يكون حلاً لمعادلة جبرية))",
 "ちょうえつてき": "متسام",
 "ちょうえつろんてき": "متسام",
 "ちょうえつろんてつがく": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "ちょうえん": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…) / إِهْلِيلَج, قَطْعٌ نَاقِص",
 "ちょうえんしんき": "جهاز طرد مركزي فائق (جهاز طرد مركزي عالي السرعة يستخدم لتحديد الكتل الجزيئية النسبية للجزيئات…)",
 "ちょうおおもの": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "ちょうおん": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى…) / تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة)\nمثال: التعبير عن مشاعري / توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي) / سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا.",
 "ちょうおんかい": "سلم الماجور, سلم كبير (سلم دياتوني تفصل بين نغماته نغمات كاملة باستثناء بين الثالثة والرابعة والسابعة…)",
 "ちょうおんきごう": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ちょうおんてん": "مَخْرَج",
 "ちょうおんぱ": "الْمَوْجَات فَوْقَ الصَّوْتِيَّة",
 "ちょうおんぱけんさ": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم…)",
 "ちょうおんぱけんさほう": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم…)",
 "ちょうおんぱしんだん": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم…)",
 "ちょうおんふごう": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ちょうおんぶい": "مَخْرَج",
 "ちょうおんぷ": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ちょうか": "رِثَاء, مَرْثِيَة / إفراط في التدليل (التدليل المفرط)\nمثال: أفسد الطفل بسبب الإفراط في التدليل / لُقْطَة\nمثال: كنت أمسك بالكرة. / جزمة مطاطية (حذاء طويل مصنوع من المطاط)",
 "ちょうかい": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ちょうかいきょう": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "ちょうかいしょぶん": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "ちょうかいぞう": "زاوية مجسمة, ستيراديان (وحدة الزاوية المجسمة المعتمدة في النظام الدولي للوحدات)",
 "ちょうかいふく": "تعويض مفرط (تعويض زائد عن الحد)",
 "ちょうかがく": "فَائِض",
 "ちょうかきんむ": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "ちょうかく": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا. / زاوية رأسية, زاوية متقابلة بالرأس (إحدى زاويتين متساويتين ومتقابلتين ناتجتين عن تقاطع خطين مستقيمين) / تكساس لونغ هورن, لونغ هورن (ماشية لحم طويلة القرون كانت شائعة سابقاً في جنوب غرب الولايات المتحدة)",
 "ちょうかくか": "خَرْدَلَة, قَرْنَة (كبسولة بذور ضيقة ومستطيلة تميز الفصيلة الصليبية)",
 "ちょうかくかびん": "احتداد السمع (حدة سمع غير طبيعية بسبب زيادة تهيج الآلية العصبية الحسية)",
 "ちょうかくぎゅう": "تكساس لونغ هورن, لونغ هورن (ماشية لحم طويلة القرون كانت شائعة سابقاً في جنوب غرب الولايات المتحدة)",
 "ちょうかくけい": "الجهاز السمعي (الجهاز الحسي للسمع)",
 "ちょうかくし": "هَيْبِرُون (أي باريون ليس نيوكليوناً؛ جسيم غير مستقر ذو كتلة أكبر من النيوترون)",
 "ちょうかくしょうがい": "اضطراب السمع, ضعف السمع (قصور في حاسة السمع)",
 "ちょうかくしょうがいしゃ": "ثَقِيلُ السَّمْعِ, ضَعِيفُ السَّمْعِ (لديه فقدان جزئي في السمع)",
 "ちょうかくしんけい": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "ちょうかくちゅうすう": "مركز سمعي (جزء الدماغ (في طية من القشرة المخية للفص الصدغي على جانبي الدماغ) الذي يستقبل…)",
 "ちょうかそうしん": "بَرْبَرَة, ثَرْثَرَة سَرِيعَة (كلام سريع وغير واضح)",
 "ちょうかぶん": "فَائِض",
 "ちょうかん": "سِكْرِتِير, سِكْرِتِيرَة / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / قَنَاة هَضْمِيَّة",
 "ちょうかんかくてきちかく": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "ちょうかんず": "مَنْظُور عَيْن الْطَائِر",
 "ちょうかんたい": "منطقة المد والجزر (منطقة خاضعة لتأثير المد والجزر)",
 "ちょうかんてき": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "ちょうかんまく": "مِسْرَاق",
 "ちょうが": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ちょうがい": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "ちょうがく": "عَلِمَ الطَائِر, عَلِم الطُيُور (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ちょうがた": "فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "ちょうがたべん": "صمام فراشة (صمام في المكربن يتكون من قرص يدور ويعمل كخانق)",
 "ちょうがつく": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "ちょうき": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها) / منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "ちょうきか": "إطالة, تمديد (فعل إطالة مدة شيء ما)\nمثال: كان هناك تمديد غير محدد لمحادثات السلام",
 "ちょうきかしつけきん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうききおく": "ذاكرة طويلة المدى (مخزونك العام من المعلومات المتذكرة)",
 "ちょうききんり": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきけいかく": "بَعِيد المَدَى (مُناسِب لِلوُصول إلى مَسافات بَعيدَة)",
 "ちょうきこくさい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきさい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきしゃっかん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきしよう": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきしんようぎんこう": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきせん": "مُطَوَّل, مُمْتَدّ ((عَنِ الكَلَام) يُنْطَق بِبُطْء مَعَ مَدّ الحُرُوف المُتَحَرِّكَة)",
 "ちょうきせんりゃく": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきそく": "قاعدة عليا, قاعدة وصفية (قاعدة تصف كيفية استخدام القواعد الأخرى (كما في الذكاء الاصطناعي))",
 "ちょうきたいさく": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきたいざい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきたいざいしゃ": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきてがた": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきてき": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきにゅういん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきふきょう": "مُنْخَفَض",
 "ちょうきほぞん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきゃくるい": "أورنيثوبود (ديناصور عشبي يسير على قدمين)",
 "ちょうきゅう": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي. / قوس طويل (قوس خشبي قوي يُسحب باليد؛ يبلغ طوله عادة 5-6 أقدام؛ استخدم في إنجلترا في العصور…) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "ちょうきゆうりょうじゅうたく": "طَوِيل الصَّلَاحِيَة ((في السلع القابلة للتلف) مُعالَج لِيَبْقى طازَجًا لِفَتْرَة أَطْوَل)",
 "ちょうきょ": "تَصْرِيح, سَمَاح",
 "ちょうきょう": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب.",
 "ちょうきょうし": "مدرب حيوانات (شخص يدرب الحيوانات أو يعرضها)",
 "ちょうきょせい": "عِمْلَاق عَظِيم (نجم شديد السطوع ذو قطر كبير جداً وكثافة منخفضة)",
 "ちょうきょり": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى / بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりいぞん": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりがいしゃ": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "ちょうきょりきょうそう": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりしぜんほどう": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりそう": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりそうしゃ": "عداء ماراثون, عداء مسافات طويلة (شخص يشارك في سباقات المسافات الطويلة (خاصة في الماراثون))",
 "ちょうきょりだしゃ": "ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب)",
 "ちょうきょりでんしゃ": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりでんわ": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "ちょうきょりでんわがいしゃ": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりでんわじぎょう": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "ちょうきょりほう": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりゆそう": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりれっしゃ": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりキャリア": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "ちょうきよほう": "بَعِيد المَدَى (مُناسِب لِلوُصول إلى مَسافات بَعيدَة)",
 "ちょうきん": "طَارَدَ / وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "ちょうきんか": "مشروب تعقيب (مشروب يؤخذ مباشرة بعد مشروب آخر)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "ちょうきんし": "مشروب تعقيب (مشروب يؤخذ مباشرة بعد مشروب آخر)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "ちょうぎ": "المجلس الخاص (مجلس استشاري للحاكم (خاصة للتاج البريطاني))",
 "ちょうぎょ": "صَيْد سَمَك, صَيْد",
 "ちょうぎん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうくうどう": "خَاوٍ, فَارِغ (لَا يَحْتَوِي عَلَى شَيْء)\nمثال: فراغات الصحراء الشاسعة",
 "ちょうぐみ": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "ちょうけい": "المحور الأكبر (أطول محور للقطع الناقص أو المجسم الإهليلجي؛ يمر عبر البؤرتين) / فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "ちょうけいこつ": "عظم وتدي (عظم على شكل فراشة عند قاعدة الجمجمة)",
 "ちょうけし": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما)",
 "ちょうけん": "تَكْوِين\nمثال: العدالة مضمونة في الدستور. / عَقْرَب دَقَائِق",
 "ちょうげん": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "ちょうげんじつ": "سُرْيَالِيَّة",
 "ちょうげんじつしゅぎ": "سُرْيَالِيَّة",
 "ちょうげんじつてき": "سُرْيَالِيّ, فَانْتَاسْمَاغُورِيّ (يتّسم بصور خيالية غريبة وتجاورات غير متوقّعة)",
 "ちょうこう": "مُقطِّع اللحم (شخص يقوم بتقطيع اللحم) / اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها. / تدقيق, مراجعة (فحص منهجي أو مراجعة لحالة أو وضع)\nمثال: أجرى تدقيقاً لجميع النباتات في ممتلكاته / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / لافِتَة\nمثال: توم وقع و أصيب. / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / مَعْرُوف / مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة) / قَرَنْفُل / رَادِيكَالِيّ, مُتَطَرِّف ((لِلآرَاءِ وَالأَفْعَال) بَعِيدٌ جِدًّا عَنِ المِعْيَارِ المَقْبُول)",
 "ちょうこうき": "مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة)",
 "ちょうこうし": "عَطَّار, عَطَّارَة",
 "ちょうこうせい": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة)",
 "ちょうこうぜつ": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "ちょうこうそう": "شاهق, ناطح للسحاب (تستخدم للمباني ذات الطوابق المتعددة المجهزة بمصاعد؛ طويل)\nمثال: شوارع تصطف على جانبيها مبانٍ سكنية شاهقة",
 "ちょうこうそうけんちく": "نَاطِحَة سَحَاب",
 "ちょうこうそうビル": "نَاطِحَة سَحَاب",
 "ちょうこうそくどさつえい": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة)",
 "ちょうこかん": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "ちょうこく": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / هَزَمَ, غَلَبَ",
 "ちょうこくおうはん": "لوحة نحاسية (نقص يتكون من صفيحة ملساء من النحاس تم حفرها أو نقشها)",
 "ちょうこくか": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة)",
 "ちょうこくぐざ": "إِزْمِيل",
 "ちょうこくし": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة)",
 "ちょうこくしつざ": "نَحَّات, مَثَّال (من يمتهن النَّحْتَ، وهو فَنَّان يصنع التماثيل من الحجارة أو الخشب؛ كثير…)",
 "ちょうこくしつ座": "نَحَّات, مَثَّال (من يمتهن النَّحْتَ، وهو فَنَّان يصنع التماثيل من الحجارة أو الخشب؛ كثير…)",
 "ちょうこくじゅつ": "تِمْثَال, مَنْحُوتَة\nمثال: من علمك نحت الخشب.",
 "ちょうこくとう": "إِزْمِيل",
 "ちょうこくばん": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ちょうこくぶつ": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ちょうこっかしゅぎ": "تَعَصُّب وَطَنِيّ, شُوفِينِيَّة (وطنية متعصبة)",
 "ちょうこっかてき": "شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "ちょうこつ": "حرقفة (الجزء العلوي والأعرض من العظام الثلاثة المكونة لعظم الورك) / عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "ちょうこつどうみゃく": "شريان حرقفي (واحد من الشرايين الكبيرة التي تغذي الحوض والساقين بالدم)",
 "ちょうごう": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / توقيع المفتاح, دليل المفتاح (علامات الرفع (الدييز) أو الخفض (البيمول) التي تتبع المفتاح وتشير إلى السلم…)",
 "ちょうごうか": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "ちょうごうざい": "خَلِيط",
 "ちょうさ": "تَحْقِيق / تْشَانْغ شَا, تْشَانْغْشَا",
 "ちょうさいん": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ…)\nمثال: تحدث ياني مع محقق.",
 "ちょうさかん": "فاحص, مفتش (محقّق يراقب ويدقق بعناية)\nمثال: بحث الفاحص عن أدلة",
 "ちょうさけっか": "تَسَبَّب",
 "ちょうさしぼうさん": "طويل السلسلة (للجزيئات التي تحتوي على سلاسل طويلة نسبياً من الذرات)",
 "ちょうさしょ": "نُسْخَة",
 "ちょうさひょう": "اِسْتِبَانَة",
 "ちょうさぶんせき": "تَشْخِيص",
 "ちょうさほうこく": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "ちょうさやく": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "ちょうさんかぶつ": "أَنْيُون السُّوبَر أُوكْسِيد, فَوْق أُكْسِيد",
 "ちょうさんりし": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "ちょうざいし": "موزع (حاوية مصممة بحيث يمكن استخدام المحتويات بكميات محددة)",
 "ちょうざいしさい": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران)",
 "ちょうざいやっきょく": "مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "ちょうざめ": "حَفْش (دخل في شيءٍ بسرعة أو اقتحمَه بطريقة مفاجئة؛ عمل شيئًا بسرعة أو دون تدقيق)",
 "ちょうざん": "خَرِب, مُنْتَهٍ (أُوصِلَ إِلَى الخَرَاب)",
 "ちょうし": "تَأْبِين, أُمْدُوحَة / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / وَرِيد, عِرْق / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة)\nمثال: الدفعة المفاجئة أسقطته أرضاً / دورق, قنينة (زجاجة ذات سدادة؛ لتقديم النبيذ أو الماء) / مِلْقَط صَغِير, مِلْقَط / رِثَاء, مَرْثِيَة",
 "ちょうしがいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "ちょうしがよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "ちょうししゃ": "مُشَاهِد, مَشَاهِدَة",
 "ちょうしぜん": "تَنْجِيمِيَّة",
 "ちょうしぜんしゅぎ": "خَوَارِقِيَّة, فَوْق طَبِيعِيَّة (صفة كون الشيء منسوباً لقوة تبدو وكأنها تنتهك أو تتجاوز القوى الطبيعية)",
 "ちょうしぜんしゅぎしゃ": "خارقي, فوق طبيعي (متعلق بالاعتقاد بالخوارق (ما وراء الطبيعة))\nمثال: معتقدات خارقة للطبيعة",
 "ちょうしぜんてき": "خَارِق, مِيتَافِيزِيقِيّ (الشيء)\nمثال: ذلك خارق للعادة.",
 "ちょうしぜんろんしゃ": "خارقي, فوق طبيعي (متعلق بالاعتقاد بالخوارق (ما وراء الطبيعة))\nمثال: معتقدات خارقة للطبيعة",
 "ちょうしっかん": "اعتلال معوي (مرض يصيب القناة المعوية)",
 "ちょうしっぱずれ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "ちょうしつざい": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "ちょうしのいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "ちょうしのよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "ちょうしはずれ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "ちょうしぶえ": "أنبوب النغمة (أنبوب صغير يصدر نغمة بتردد قياسي؛ يستخدم لتحديد نغمة البداية للغناء غير المصحوب…)",
 "ちょうしゃ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / جَاسُوس / مُسْتَمِع, مُسْتَمِعَة",
 "ちょうしゃく": "طَوِيل",
 "ちょうしゅ": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا. / اِسْتِمَاع",
 "ちょうしゅう": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جُمْهُور, نَظَّارَة / تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية)",
 "ちょうしゅしゃ": "مُسْتَمِع, مُسْتَمِعَة",
 "ちょうしゅりつ": "جمهور المستمعين, مستمعون (جميع المستمعين لبرنامج إذاعي أو محطة معينة أو هيئة إذاعية بشكل جماعي)\nمثال: في عام 2012، زادت حصة مستمعي الراديو عبر الهواتف المحمولة بنسبة 10٪ مقارنة بعام 2009",
 "ちょうしゅん": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة…) / تْشَانْج شُون, تْشَانْجْشُون",
 "ちょうしゅんか": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة…)",
 "ちょうしょ": "بْرُوتُوكُول / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "ちょうしょう": "صُور / تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى…) / دَعْوَة, عزيمة / لافِتَة\nمثال: توم وقع و أصيب.",
 "ちょうしょく": "إِفْطَار, فَطُور\nمثال: وجدت بعض الفطر. / نَغْمَة, نَغْم",
 "ちょうしょくばん": "باليتة, لوحة ألوان (لوح يوفر سطحاً مستوياً يخلط عليه الفنانون الطلاء ومجموعة الألوان المستخدمة)",
 "ちょうしりつ": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما)\nمثال: وضع تقييماً عالياً للصداقة",
 "ちょうしん": "عَقْرَب دَقَائِق / رجل حاشية (مرافق في بلاط الحاكم) / تَحْضِير, إِعْدَاد / تَسَمُّع (تَكَلَّفَ السمع)\nمثال: هل تسمع أي صوت؟",
 "ちょうしんき": "سَمَّاعَةُ الطَّبِيب, سَمَّاعَة",
 "ちょうしんぎん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうしんけい": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "ちょうしんせい": "مُسْتَعِر أَعْظَم",
 "ちょうしんりがく": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن…)",
 "ちょうしんるこつ": "تفكير شاق, كدح ذهني (تفكير شاق ومجهد)",
 "ちょうじ": "قَرَنْفُل / تَأْبِين, أُمْدُوحَة / إيقاف, توقف (فعل إيقاف شيء ما)\nمثال: إيقافه للتدفق أدى إلى فيضان / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / يُعَلِّق / حَبِيب, حَبِيبَة / جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "ちょうじあぶら": "زيت القرنفل (زيت عطري يتم الحصول عليه من القرنفل ويُستخدم لتنكيه الأدوية)",
 "ちょうじかん": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر / إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب)",
 "ちょうじが": "الْأَنَا الْعُلْيَا, الْأَنَا الْأَعْلَى",
 "ちょうじく": "المحور الأكبر (أطول محور للقطع الناقص أو المجسم الإهليلجي؛ يمر عبر البؤرتين)",
 "ちょうじゃ": "مِلْيُونِير / جَاسُوس",
 "ちょうじゃく": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار / طَوِيل",
 "ちょうじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة / دَائِم, طَوِيل الأَمَد (مَوْجود مُنْذُ فَتْرَة طَويلَة وَيَسْتَمِرّ)",
 "ちょうじゅう": "اَلْحَيَاة اَلْبَرِّيَّة / مساكن شعبية, مشروع إسكان عام (مجمع سكني ممول ومُدار حكومياً للأسر ذات الدخل المنخفض)",
 "ちょうじゅうげんそ": "عنصر ما بعد اليورانيوم (أي عنصر له عدد ذري أكبر من 92 (وهو العدد الذري لليورانيوم)؛ وجميعها مشعة)",
 "ちょうじゅうせき": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات…)\nمثال: انغماد الأريمة",
 "ちょうじゅうせきしょう": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات…)\nمثال: انغماد الأريمة",
 "ちょうじゆ": "زيت القرنفل (زيت عطري يتم الحصول عليه من القرنفل ويُستخدم لتنكيه الأدوية)",
 "ちょうじょう": "تراكب, تطابق (وضع شيء فوق شيء آخر) / مُمْتَاز, فَاخِر / قِمَّة / سُور اَلصِّين اَلْعَظِيم",
 "ちょうじょうてき": "خَارِق, مِيتَافِيزِيقِيّ (الشيء)\nمثال: ذلك خارق للعادة.",
 "ちょうじり": "اِتِّسَاق",
 "ちょうじりがあう": "رَصِيد",
 "ちょうじる": "نَمَى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "ちょうじん": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سُوبَرْمَان / رجل خارق, نصف إله (شخص ذو قوى وقدرات عظيمة) / طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "ちょうじんてき": "خارق للبشر, فائق للطبيعة البشرية (فوق أو أبعد من البشر أو يتطلب قوة أو قدرة تحمل أكثر من البشرية)\nمثال: كائنات خارقة للبشر",
 "ちょうすう": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ちょうすうがく": "ما وراء الرياضيات (التحليل المنطقي للاستدلال الرياضي)",
 "ちょうする": "نَدَبَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / تَفَقُّد / يَسْتَحْضِر, يَسْتَدْعِي",
 "ちょうずば": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها…)\nمثال: كان في المغسلة. / مِرْحَاض, تواليت",
 "ちょうずばち": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها…)\nمثال: كان في المغسلة.",
 "ちょうずる": "نَمَى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "ちょうせい": "ضَبْط / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة / حياة أبدية, خلود (حياة بلا بداية أو نهاية) / سلم, مفتاح (أي من 24 سلماً دياتونياً كبيراً أو صغيراً توفر الإطار النغمي لمقطوعة موسيقية)",
 "ちょうせいかのう": "قَابِل لِلتَّعْدِيل, قَابِل لِلضَّبْط (يمكن تنظيمه أو ضبطه)",
 "ちょうせいざい": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "ちょうせいじょう": "خَارِق لِلْعَادَة, فَوْق طَبِيعِيّ (يتجاوز نطاق ما هو طبيعي أو قابل للتفسير علميًّا)",
 "ちょうせいち": "حوض احتباس (موقع تخزين مشابه لحوض الاحتجاز لكن المياه المخزنة تُمنع بشكل دائم من التدفق…)",
 "ちょうせいやく": "مُنَسِّق",
 "ちょうせき": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار / مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / فلسبار / حَصَاة مِعَوِيَّة (حصاة تحدث في الأمعاء)",
 "ちょうせぞくてき": "غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها)\nمثال: كان زاهداً ولم يفتقد المكافآت الدنيوية كثيراً",
 "ちょうせつ": "تَنْظِيم",
 "ちょうせついでんし": "جين تنظيمي (جين ينتج مادة كابتة تمنع الجين المشغل)",
 "ちょうせつき": "مُنَظِّم",
 "ちょうせつしょうがい": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ちょうせん": "تَحَدٍّ, التَّحَدِّي / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا. / خيط معوي, وتر جراحي (حبل قوي مصنوع من أمعاء الأغنام ويستخدم في الجراحة)",
 "ちょうせんあさがお": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "ちょうせんあざみ": "أرضي شوكي, خرشوف (رأس زهرة يشبه الشوك بأوراق وقلب لحمي صالح للأكل)",
 "ちょうせんご": "كُورِيّ",
 "ちょうせんしゃ": "خصم, غريم (المتسابق الذي تأمل في هزيمته)\nمثال: كان يحترم خصومه",
 "ちょうせんじょう": "تَحَدٍّ, التَّحَدِّي",
 "ちょうせんたまいれ": "باتشينكو (لعبة بينبول يابانية تُلعب على لوحة عمودية)",
 "ちょうせんてき": "تَحَدٍّ, طَمُوح (يَتَطَلَّب اسْتِخْدَام كَامِل القُدُرَات أَوِ المَوَارِد)",
 "ちょうせんはんとう": "شِبْه الْجَزِيرَةِ الْكُورِيَّة",
 "ちょうせんみんしゅしゅぎじんみんきょうわこく": "جُمْهُورِيَّة كُورِيَا اَلدِّيمُقْرَاطِيَّة اَلشَّعْبِيَّة",
 "ちょうせんもじ": "هَانْغُول",
 "ちょうせんもんじ": "هَانْغُول",
 "ちょうせんろうどうとう": "حزب العمال (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ:…)\nمثال: التحقت بذلك الحزب.",
 "ちょうぜい": "تحصيل الضرائب, جباية الضرائب (جمع الضرائب)",
 "ちょうぜいり": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "ちょうぜつ": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "ちょうぜつしゅぎ": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "ちょうぜつてき": "متسام",
 "ちょうぜん": "مُسْتَقِلّ, مُنْفَصِل (يستخدم للمباني؛ قائمة بمعزل عن غيرها)\nمثال: منازل منفصلة / خَائِب الأَمَل",
 "ちょうそ": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "ちょうそう": "دفن سماوي (طقس جنائزي تيبتي تقليدي تُعرض فيه الجثة في الهواء الطلق لتأكلها النسور المقدسة) / بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على…)",
 "ちょうそくき": "مُحَافِظ, حَاكِم",
 "ちょうそじゅつ": "فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "ちょうぞう": "تِمْثال, دُمْيَة / تَأْسِيس",
 "ちょうぞく": "انعزال, تحفظ (الميل لكون المرء بعيداً وغير متعاطف في أسلوبه)\nمثال: مسافة عاطفية",
 "ちょうたい": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "ちょうたいこく": "قُوَى عُظْمَى",
 "ちょうたいさく": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)\nمثال: قدموا عرضاً ضخماً في عيد الميلاد",
 "ちょうたいしょうせい": "تتناظر فائق ((فيزياء) نظرية تحاول الربط بين القوى الأساسية الأربع)",
 "ちょうたいしょうりろん": "تتناظر فائق ((فيزياء) نظرية تحاول الربط بين القوى الأساسية الأربع)",
 "ちょうたつ": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / طلاقة, فصاحة (جودة السهولة في الكلام والكتابة)\nمثال: جذبت فصاحته حشداً كبيراً",
 "ちょうたつさき": "مُزَوِّد, مُزَوِّدَة",
 "ちょうたん": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ちょうたんぱ": "تَرَدُّد عَالٍ جِدّاً (30 إلى 300 ميجاهرتز)",
 "ちょうだい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز)",
 "ちょうだいもの": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "ちょうだつ": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة)",
 "ちょうだん": "ارتداد, وثبة (ارتداد جانبي)",
 "ちょうちゃく": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)",
 "ちょうちょ": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "ちょうちょう": "سلم كبير (سلم يعتمد انسجامه على السلم الكبير) / فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة! / مُتَصَادِم, مُتَنَافِر (متنافر بشكل حادّ وقاسٍ) / بِتَمَلُّق, بِلَبَاقَة مُصْطَنَعَة (بمعقولية سطحية)\nمثال: تحدث بطلاقة سطحية",
 "ちょうちょうは": "تَرَدُّد مُنْخَفِض لِلغَايَة (3 إلى 30 كيلوهرتز)",
 "ちょうちょうはっし": "بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً)\nمثال: صمت كسره نباح الكلاب بشراسة",
 "ちょうちょうむすび": "قَوْس, قوس",
 "ちょうちょむすび": "قَوْس, قوس",
 "ちょうちょ結び": "قَوْس, قوس",
 "ちょうちん": "فانوس صيني (فانوس ورقي قابل للطي بألوان زاهية؛ يستخدم لأغراض الزينة)",
 "ちょうちんもち": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "ちょうつがい": "مِقْبَض / مُشْتَرَك",
 "ちょうつけ": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية) / مُحَاسِب, مُحَاسِبَة",
 "ちょうつじ": "رَئِيس, رَئِيسَة",
 "ちょうづけ": "تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات)\nمثال: استخدم نظام الخطابة في المستشفى للمناداة / مسك الدفاتر (نشاط تسجيل المعاملات التجارية) / مُحَاسِب, مُحَاسِبَة",
 "ちょうづめ": "سُجُق, نَقَانِق",
 "ちょうづめきん": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "ちょうてい": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء)\nمثال: كانت هناك فترة وجيزة من المصالحة لكن القتال سرعان ما استؤنف / سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً)",
 "ちょうていしゃ": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "ちょうていしゅうはおん": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها)",
 "ちょうてつ": "صَفَاء, نَقَاء (صفة الماء الصافي)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "ちょうてん": "يَافُوخ / قِمَّة / أَوْجٌ, ذُرْوَةٌ / شَحْطَة",
 "ちょうでんどう": "موصلية فائقة (اختفاء المقاومة الكهربائية عند درجات حرارة منخفضة جداً)",
 "ちょうとう": "تطاول الرأس (صفة تطاول الجمجمة أو الرأس (طول الرأس كبير بالنسبة لعرضه))",
 "ちょうとうは": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "ちょうとつ": "تَحْرِير",
 "ちょうど": "بِالضَّبْط, تَمَامًا\nمثال: 私達はちょうど食事を終えた所です。 — لقد أنهينا أكل طعام الفطور للتو. / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل…)\nمثال: يصنع قطعة أثاث خشبية. / قَوْس وَسَهْم / اِتِّسَاق",
 "ちょうどいい": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "ちょうどいま": "آنِفاً",
 "ちょうどう": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "ちょうどかちさい": "فارق ملحوظ بالكاد ((في الفيزياء النفسية) الفرق بين محفزين الذي يتم اكتشافه بنفس قدر عدم اكتشافه…)",
 "ちょうどきゅう": "دَرَجَة فَائِقَة",
 "ちょうどひん": "تأثيث (عملية تزويد منزل أو غرفة بالأثاث وغيرها من العناصر القابلة للإزالة مثل الرفوف…)",
 "ちょうどよい": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "ちょうど今": "آنِفاً",
 "ちょうど良い": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "ちょうな": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / قَدُوم (قُدُوْم؛ قَدُوْم)\nمثال: بإمكانك القدوم معي.",
 "ちょうない": "جِوَار, قُرْب\nمثال: ينبح كلب في الحي. / مَعَوِيّ",
 "ちょうないさいきんそう": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد…)",
 "ちょうないせんじょう": "غسيل القولون (حقنة شرجية مائية تعطى لتنظيف القولون)",
 "ちょうないフローラ": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد…)",
 "ちょうなんもう": "زُغابَة, زَغْبَة",
 "ちょうにく": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر)",
 "ちょうにん": "أهل البلدة, سكان البلدة (الناس الذين يعيشون في بلدية أصغر من المدينة)\nمثال: هتفت البلدة بأكملها للفريق",
 "ちょうねじ": "صامولة فراشة, صامولة مجنحة (صامولة مسننة ذات نتوءات تشبه الأجنحة لتدويرها بالإبهام والسبابة)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "ちょうねんてん": "انفتال (التواء غير طبيعي للأمعاء (عادة في منطقة اللفائفي أو القولون السيني) مما يؤدي…)",
 "ちょうのうりょく": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس) / تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "ちょうのすけそう": "أفنس الجبل, درياس ثماني البتلات (شجيرة زاحفة دائمة الخضرة بزهور بيضاء كبيرة؛ واسعة الانتشار في الأجزاء الشمالية…)",
 "ちょうのつく": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "ちょうは": "موجة طويلة (موجة راديوية بطول موجي أطول من كيلومتر واحد (تردد أقل من 300 كيلو هرتز)) / مُتَوافِق, مُنْسَجِم (مُتَناغِم ومُتَّسِق في التَّوْليفَة الصَّوْتِيَّة)\nمثال: دقة التغيير التوافقي والنغمية",
 "ちょうはつ": "إِثَارَة, اِسْتِفْزَاز (إِثَارَة: يُجمع على إثارات)\nمثال: كف عن إثارة غضبي. / حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي…)\nمثال: أولاً عليك ملء طلب الصرف / تَجْنِيد إِجْبَارِيّ / حَلَاقَة",
 "ちょうはつてき": "مُسْتَفِز / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش)",
 "ちょうはん": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة) / جِنَايَة / جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "ちょうはんばくち": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "ちょうば": "اِسْتِقْبَال / حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز) / تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "ちょうばいたい": "وسائط فائقة, وسائط متعددة تفاعلية (نظام وسائط متعددة يتم فيه ربط عناصر المعلومات ذات الصلة ويمكن تقديمها معاً)",
 "ちょうばえ": "ذبابة الرمل (أي من الذباب الصغير ثنائي الأجنحة المتنوع؛ يمكن للإناث الماصة للدماء نقل حمى…)",
 "ちょうばく": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…)",
 "ちょうばじょう": "بادوك, مضمار الاستعراض (حظيرة يتم فيها إسراج خيول السباق واستعراضها قبل السباق)",
 "ちょうばつ": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ちょうばつてき": "تأديبي, عقابي (يفرض عقوبة)\nمثال: عدالة عقابية",
 "ちょうばつてきそんがいばいしょう": "تعويضات رادعة, تعويضات عقابية ((قانون) تعويض يزيد عن الأضرار الفعلية (شكل من أشكال العقاب الممنوح في حالات سوء…)",
 "ちょうばつぼう": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "ちょうばん": "مِقْبَض",
 "ちょうび": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / خُرْطُوم",
 "ちょうびさい": "فَائِقُ الدِّقَّة (بَالِغُ الدِّقَّةِ أَوِ الرِّقَّةِ فِي القِيَاس)",
 "ちょうびるい": "خرطوميات (ثدييات عاشبة ضخمة لها أنياب وخرطوم طويل)",
 "ちょうふ": "أَلْصَقَ",
 "ちょうふく": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما)\nمثال: هذا النوع من الازدواجية هو هدر",
 "ちょうふくかんせん": "عدوى إضافية (عدوى تحدث أثناء العلاج من عدوى أخرى)",
 "ちょうふざい": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "ちょうふんせき": "جوانو, ذرق الطيور (فضلات الطيور البحرية؛ تستخدم كسماد)",
 "ちょうぶ": "هِكْتَار",
 "ちょうぶく": "رُقْيَة",
 "ちょうぶつ": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا)",
 "ちょうぶん": "تَأْبِين, أُمْدُوحَة",
 "ちょうぶんめん": "هَايْبَرْتِكْسْت",
 "ちょうへい": "تَجْنِيد إِجْبَارِيّ",
 "ちょうへいきひしゃ": "متهرب من التجنيد (شخص يتم استدعاؤه للتجنيد ويرفض الخدمة بشكل غير قانوني)",
 "ちょうへいけんさ": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني.",
 "ちょうへいせい": "تَجْنِيد إِجْبَارِيّ",
 "ちょうへいせいど": "تَجْنِيد إِجْبَارِيّ",
 "ちょうへいそく": "انسداد معوي (انسداد الأمعاء (خاصة اللفائفي) الذي يمنع محتويات الأمعاء من المرور إلى الأمعاء…)",
 "ちょうへいれい": "مُسْوَدَّة",
 "ちょうへん": "مُسْتَجِدّ",
 "ちょうへんえいが": "فيلم رئيسي, فيلم روائي طويل (الفيلم الرئيسي (طويل) في برنامج دار سينما)\nمثال: الفيلم الرئيسي الليلة هو 'كازابلانكا'",
 "ちょうへんしょうせつ": "مُسْتَجِدّ",
 "ちょうほう": "مُنَاسِب, مُلَائِم / كَنْز / جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "ちょうほういん": "جَاسُوس",
 "ちょうほうきかん": "وَكَالَةْ اِسْتِخْبَار",
 "ちょうほうきてき": "خَارِج عَن القَضَاء (يَتِمّ خارِج نِطاق السُّلْطَة القَضائِيَّة)",
 "ちょうほうけい": "مُسْتَطِيل",
 "ちょうほうたい": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "ちょうほうもう": "شبكة تجسس (شبكة من الجواسيس)",
 "ちょうほしゅてき": "بَالِغُ المُحَافَظَةِ, مُتَطَرِّفٌ فِي المُحَافَظَةِ (مُحَافِظٌ إِلَى أَقْصَى حَدٍّ)",
 "ちょうほんにん": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ちょうぼ": "دَفْتَر حِسَابَات / تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية))",
 "ちょうぼいん": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى…)",
 "ちょうぼう": "مَنْظَر, مَشْهَد",
 "ちょうぼかかく": "قيمة دفتريّة (القيمة التي يُسجل بها الأصل في الميزانية العمومية؛ تساوي التكلفة ناقص الاستهلاك…)",
 "ちょうぼん": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ちょうまい": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية)\nمثال: مركز للتميز الصناعي",
