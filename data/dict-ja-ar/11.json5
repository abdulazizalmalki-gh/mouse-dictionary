 "とうひきゅうすう": "مُتَسَلْسِلَة هَنْدَسِيَّة (متتالية هندسية مكتوبة كمجموع)",
 "とうひすうれつ": "مُتَتَالِيَة هَنْدَسِيَّة",
 "とうひてき": "حالم, هروبي (شخص يهرب إلى عالم من الخيال)",
 "とうひょう": "تَصْوِيت",
 "とうひょうかんりしゃ": "رئيس الجلسة, ضابط الجلسة (قائد اجتماع لمجموعة ما)",
 "とうひょうき": "آلة تصويت (جهاز ميكانيكي لتسجيل وعد الأصوات آلياً)",
 "とうひょうけん": "حق التصويت (الحق في التصويت؛ وخاصة حق المساهم العادي في التصويت شخصيًا أو بالوكالة في شؤون الشركة)",
 "とうひょうしゃ": "مُصَوِّت, نَاخِب",
 "とうひょうしょ": "مركز اقتراع (مكان يذهب إليه الناخبون للإدلاء بأصواتهم في الانتخابات)",
 "とうひょうじょ": "مركز اقتراع (مكان يذهب إليه الناخبون للإدلاء بأصواتهم في الانتخابات)",
 "とうひょうせいど": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "とうひょうばこ": "صندوق الاقتراع (صندوق يودع فيه الناخبون أوراق اقتراعهم)",
 "とうひょうび": "يوم الاقتراع, يوم الانتخابات (اليوم المحدد للانتخابات؛ في الولايات المتحدة هو أول ثلاثاء بعد أول اثنين في نوفمبر)",
 "とうひょうようし": "وَرَقَةُ اِقْتِرَاع",
 "とうひょうりつ": "أصوات المقترعين, نسبة المشاركة (العدد الإجمالي للناخبين الذين شاركوا)\nمثال: يتوقعون عددًا كبيرًا من الأصوات",
 "とうひん": "نَهَبَ",
 "とうび": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "とうびょう": "لَقَاح / مِرْسَاة, أَنْجَر / مُذِيع, مُذِيعَة / رَسَا ((رَسَا) الشيءُ يَرْسُو رَسْواً، ورُسُوّاً: ثَبَتَ؛ رَسا الجبلُ: ثَبَتَ أصَله في الأَرض)",
 "とうふ": "تُوفُو, توفو",
 "とうふう": "رياح شرقية (رياح تهب من الشرق)",
 "とうふく": "إِقَامَة",
 "とうふくかくせん": "خط تساوي الميل (خط تساوي يربط نقاط الميل المغناطيسي المتساوي)",
 "とうふっかくせん": "خط تساوي الميل (خط تساوي يربط نقاط الميل المغناطيسي المتساوي)",
 "とうふにかすがい": "هدر الجهد (جهد لا طائل منه)",
 "とうぶ": "شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "とうぶしまりす": "صيدناني شرقي (سنجاب أمريكي شرقي صغير مخطط شبه أرضي ذو جيوب خدية)",
 "とうぶじかん": "توقيت المنطقة الشرقية (التوقيت القياسي في المنطقة الزمنية الخامسة غرب غرينتش، يحسب عند خط الطول 75؛ يستخدم في شرق الولايات المتحدة)",
 "とうぶせんこう": "نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك طلبا للمهرب ولا يشترط؛ عن الشيء: فحصه فحصا دقيقا ليعرف تفاصيله)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "とうぶはくせん": "سَعْفَة, قَرَع",
 "とうぶひょうじゅんじ": "توقيت المنطقة الشرقية (التوقيت القياسي في المنطقة الزمنية الخامسة غرب غرينتش، يحسب عند خط الطول 75؛ يستخدم في شرق الولايات المتحدة)",
 "とうぶん": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "とうぶんのあいだ": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "とうぶんのかん": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "とうへき": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "とうへん": "شقفة فخار (كسرة من الفخار)",
 "とうへんかくせん": "خط تساوي الانحراف (خط وهمي يربط بين النقاط على سطح الأرض حيث يكون الانحراف المغناطيسي متساوياً)",
 "とうへんさんかくけい": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "とうへんさんかっけい": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "とうへんついほう": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "とうへんぼく": "أبله, أجلف (شخص أخرق وغبي)",
 "とうべん": "استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "とうべんしゃ": "رَادّ, مُجِيب (يقوم بالرد أو الإجابة) / مجيب (شخص يستجيب) / المدعى عليه (المتهم المشارك (خاصة في إجراءات الطلاق) المتهم بالزنا مع الشريك في الزنا)",
 "とうべんしょ": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "とうほう": "المشرق, نصف الكرة الشرقي (نصف الكرة الذي يشمل أوراسيا وأفريقيا وأستراليا) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مُتَمَاثِل المَنَاحِي, مُتَنَاحٍِ",
 "とうほうきいつきょうかい": "الكنيسة الكاثوليكية الشرقية, الكنيسة الموحدة (أي من عدة كنائس في أوروبا الشرقية أو الشرق الأوسط تعترف بالسلطة البابوية ولكنها تحتفظ بطقوسها الخاصة)",
 "とうほうきょうかい": "الكنيسة البيزنطية, الكنيسة الشرقية (الكنيسة الكاثوليكية كما كانت موجودة في الإمبراطورية البيزنطية) / الكنيسة الأرثوذكسية, الكنيسة الأرثوذكسية الشرقية (مشتقة من الكنيسة البيزنطية وتلتزم بالطقوس البيزنطية)",
 "とうほうじん": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "とうほうせい": "تماثل الخواص, توحد الخواص ((فيزياء) خاصية كون الشيء متماثل الخواص؛ له نفس القيمة عند قياسه في اتجاهات مختلفة)",
 "とうほうせいきょうかい": "أُرْثُوذُكْسِيَّة شَرْقِيَّة (أرثوذكسيَّة)",
 "とうほうてき": "مُتَمَاثِل المَنَاحِي, مُتَنَاحٍِ",
 "とうほうのさんはかせ": "مَجُوس",
 "とうほく": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي)",
 "とうほくだいがくりゅうたいかがくけんきゅうじょ": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "とうほくとう": "الشَّرْق الشَّمَالِيّ الشَّرْقِيّ, شَرْق شَمَال شَرْق (نقطة البوصلة في منتصف المسافة بين الشمال الشرقي والشرق)",
 "とうほん": "نُسْخَة / ليانا, نبات معترش خشبي (نبات متسلق خشبي استوائي عادة)",
 "とうぼう": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "とうぼうしゃ": "آبِق",
 "とうぼうちゅう": "بإسهاب, بشكل عام (بطريقة عامة)\nمثال: تحدث بإسهاب عن خططه",
 "とうぼうはん": "هارب من العدالة (شخص مطلوب من قبل ضباط القانون؛ شخص يحاول التهرب من العدالة)",
 "とうぼうはんざいにん": "هارب من العدالة (شخص مطلوب من قبل ضباط القانون؛ شخص يحاول التهرب من العدالة)",
 "とうまつそろえ": "مُبَرَّر",
 "とうみつ": "دِبْس, عَسَل أَسْوَد (دبسه:ستره وواراه.1؛ الخف: رقعه.1) / شَرَاب, قَطْر",
 "とうみん": "إِسْبَات / جَزَرِيّ, جَزَرِيَّة",
 "とうめい": "شَفَّاف",
 "とうめいかん": "شَفَّافِيَّة",
 "とうめいしつ": "جبلة شفافة, هيالوبلازم (الجزء الشفاف غير الحبيبي من سيتوبلازم الخلية)",
 "とうめいすいさい": "ألوان مائية (فن أو تقنية الرسم بالألوان المائية) / لوحة مائية (لوحة منتجة بالألوان المائية) / ألوان مائية (طلاء مائي (بأصباغ قابلة للذوبان في الماء)؛ يستخدمه الفنانون) / لون مائي (خضاب قابل للذوبان في الماء)",
 "とうめいせい": "شَفَّافِيَّة",
 "とうめいたい": "منطقة شفافة (غشاء سميك حول بويضة الثدييات؛ يمكن اختراقه بواسطة حيوان منوي واحد في عملية الإخصاب؛ يبقى عادة حول البويضة المخصبة حتى يتم زرعها في جدار الرحم)",
 "とうめいど": "شَفَّافِيَّة",
 "とうめつ": "دَمَّرَ",
 "とうめん": "الجانب الشرقي (الجانب الذي يقع في الشرق) / تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة. / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى. / الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "とうめんのあいだ": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "とうもく": "شَيْخ, قَائِد",
 "とうもろこし": "غَلَّة",
 "とうもろこしこ": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "とうもろこしばたけ": "حقل ذرة (حقل مزروع بالذرة)",
 "とうもろこし畑": "حقل ذرة (حقل مزروع بالذرة)",
 "とうもろこし粉": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "とうや": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / هٰذَا الْمَسَاء, اللَّيْلَ / اَللَّيْلَة",
 "とうやく": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "とうやくりょう": "جرعة (كمية محددة من الدواء تؤخذ في وقت واحد) / جرعة (كمية العامل النشط (مادة أو إشعاع) التي يتم تناولها أو امتصاصها في وقت واحد)",
 "とうゆ": "زيت التونغ (زيت أصفر يتم الحصول عليه من بذور شجرة التونغ) / كِيرُوسِين",
 "とうよ": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "とうよう": "شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة. / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "とうようがく": "اِسْتِشْراق",
 "とうようく": "شَرْقِيّ",
 "とうようしゅぎ": "اِسْتِشْراق",
 "とうようじん": "شَرْقِيّ",
 "とうようつう": "مُسْتَشْرِق",
 "とうようふう": "شَرْقِيّ",
 "とうよりょう": "جُرْعَة",
 "とうらい": "وُصُول, وِفَادَة / آخِرَة",
 "とうらいもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "とうらく": "تَذَبذُب, تَقَلُّب / تَسَبَّب / نَتِيجَة / لِجَام, صُرْع",
 "とうり": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "とうりつ": "وقوف على اليدين (فعل دعم النفس باليدين فقط في وضع مقلوب)",
 "とうりゃく": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة. / سرقة, لصوصية (فعل أخذ شيء من شخص ما بشكل غير قانوني) / تسلل, خلسة (تجنب الكشف عن طريق التحرك بحذر)\nمثال: اللصوصية فظيعة في مطار كينيدي الدولي",
 "とうりゅう": "مَكَثَ, بَقِيَ / إِقَامَة",
 "とうりゅうきゃく": "مقيم مؤقت (ساكن مؤقت)",
 "とうりょう": "عمود / شَيْخ, قَائِد / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / قُنْصُل / مُعَادِل / اِسْتِقَالَة, اِسْتِعْفَاء",
 "とうりん": "بستان خوخ (بستان من أشجار الخوخ)",
 "とうるい": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / سكريات, كربوهيدرات (مكون هيكلي أساسي للخلايا الحية ومصدر للطاقة للحيوانات؛ تشمل السكريات البسيطة ذات الجزيئات الصغيرة وكذلك المواد الجزيئية الكبيرة)",
 "とうろ": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "とうろう": "فَرَس اَلنَّبِيّ (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "とうろく": "تَسْجِيل",
 "とうろくき": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "とうろくきんし": "قَائِمَة سَوْدَاء",
 "とうろくしゃ": "مُسَجَّل (شخص مسجل رسمياً (مع آخرين) في سجل (ويحصل على حقوق معينة بذلك))",
 "とうろくしゃすう": "تَسْجِيل",
 "とうろくずみ": "مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة المَطْلُوبَة) / مسجل (مدرج أو مسجل رسمياً) / مسجل ((للحيوانات) مسجل رسمياً أو معتمد لدى جمعية سلالة معترف بها؛ خاصة في سجل الأنساب)\nمثال: يتم تسجيل 'البريد المسجل' في كل نقطة على مساره لضمان التسليم الآمن",
 "とうろくばんごう": "رقم التسجيل, رقم الرخصة (الرقم الموجود على لوحة الترخيص والذي يحدد السيارة التي تحمله)",
 "とうろくぼ": "دليل (قائمة أبجدية بالأسماء والعناوين) / دليل ((علوم الكمبيوتر) قائمة بالملفات المخزنة في الذاكرة (عادة على قرص صلب))",
 "とうろん": "مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "とうろんかい": "مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
