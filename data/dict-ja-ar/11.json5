 "ゆうひょうき": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "ゆうび": "غريس",
 "ゆうびょうりつ": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "ゆうびん": "بَرِيد / بريد",
 "ゆうびんうけ": "صُنْدُوق بَرِيد, صَنْدُوق بَرِيد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "ゆうびんきって": "طَابِع, طَابِع بَرِيدِيّ",
 "ゆうびんきょく": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "ゆうびんこづつみ": "رِزْمَة, رُزْمَة",
 "ゆうびんしゅうはいにん": "سَاعِيّ بَرِيد",
 "ゆうびんせいど": "عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "ゆうびんはいたつ": "سَاعِيّ بَرِيد",
 "ゆうびんはいたつにん": "سَاعِيّ بَرِيد",
 "ゆうびんはいたつふ": "سَاعِيّ بَرِيد",
 "ゆうびんはがき": "كَرْت بَرِيدِيّ",
 "ゆうびんぶつ": "بَرِيد / بريد",
 "ゆうびんや": "سَاعِيّ بَرِيد",
 "ゆうふ": "بَطَلَة",
 "ゆうふく": "غَنِيّ",
 "ゆうふくそう": "غَنِيّ",
 "ゆうぶ": "شَجَاعَة",
 "ゆうへい": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "ゆうへん": "تُحْفَة, رَائِعَة",
 "ゆうべ": "مَسَاء / اَلْبَارِحَةَ",
 "ゆうべん": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "ゆうべんか": "خَطِيب, خَطِيبَة",
 "ゆうべんじゅつ": "مُصَلًّى (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد) / خِطَابَة",
 "ゆうべんはぎん、ちんもくはきん": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "ゆうほ": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "ゆうほう": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ゆうぼう": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "ゆうぼくみん": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "ゆうまい": "بُطُولِيّ",
 "ゆうまでもない": "بَدِيهِيّ, بَدَهِيّ",
 "ゆうまでもなく": "بُوضُوح",
 "ゆうみょう": "جَرِيء, جَسُور",
 "ゆうみん": "مُتَبَطِّل, مُتَبَطِّلَة",
 "ゆうめい": "شُهْرَة",
 "ゆうめいあいへだてる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ゆうめいかい": "هَادِيس",
 "ゆうめいさかいをことにする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ゆうめいじん": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "ゆうめし": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ゆうもう": "جَرِيء, جَسُور",
 "ゆうもん": "بَوَّاب",
 "ゆうやく": "مِينَاء",
 "ゆうやみ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ゆうゆう": "صَامِت, هَادِئ / بِسُهُولَة / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "ゆうよ": "تَمْدِيد / تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "ゆうよう": "هَادِئ / طَمْأَنَ",
 "ゆうようせまらぬ": "هَادِئ / طَمْأَنَ",
 "ゆうようびせいぶつぐん": "إِم",
 "ゆうよきかん": "فترة السماح",
 "ゆうよく": "رِحْلَة بَحْرِيَّة",
 "ゆうらく": "تَسْلِيَة",
 "ゆうらん": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة",
 "ゆうらんきゃく": "سَائِح, سَائِحَة",
 "ゆうらんち": "مُنْتَجَع",
 "ゆうり": "تَفْرِقَة / أَطْلَقَ سَرَاح, حَرَّرَ",
 "ゆうりょ": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ゆうりょう": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "ゆうりょく": "شَجَاعَة, جَسَارَة",
 "ゆうれい": "شَبَح, خَيَال\nمثال: その家には幽霊が出るといわれる。 — يُقال أن ذاك المنزل مسكون.",
 "ゆうれいやしき": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ゆうれき": "رِحْلَة / جَوْلَة",
 "ゆうれつ": "جَدَارَة",
 "ゆうれつをつける": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "ゆうろう": "سُطُوع",
 "ゆうわ": "تَسْوِيَة",
 "ゆうわく": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "ゆうわくてき": "أَغْوَى, أَغْرَى / أَغْرَى",
 "ゆえ": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / بِسَبَب, بِحُكْم",
 "ゆえき": "نَقْل اَلدَّم, إِصْفَاق",
 "ゆえつ": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "ゆえなしとしない": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ゆえに": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "ゆえん": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "ゆおう": "كِبْرِيتِيّ",
 "ゆか": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "ゆかい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "ゆかざい": "أَرْضِيَّة (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية.",
 "ゆかしい": "جَدِير بِالْإِعْجَاب / فُضُولِيّ",
 "ゆかめん": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "ゆかり": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "ゆかりのいろ": "بَنَفْسَج (نبات عطري) / بَنَفْسَجِيّ",
 "ゆが": "يُوغَا, يُوجَا",
 "ゆがみ": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / لَوَى, بَرَمَ",
 "ゆがむ": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "ゆがめる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "ゆき": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "ゆきあし": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "ゆきあたりばったり": "عَشْوَائِيّ",
 "ゆきあたる": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "ゆきあらし": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "ゆきおとこ": "يَتِي",
 "ゆきかい": "مُرُور",
 "ゆきかえり": "ذهاب وعودة",
 "ゆきかきしゃ": "كَاسِحَةُ ثُلُوج",
 "ゆきかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきがかり": "حَالَة, ظَرْف",
 "ゆきき": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきさき": "وِجْهَة, وُجْهَة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "ゆきしな": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきしまき": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "ゆきじろ": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "ゆきずり": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / مُؤَقَّت, سَريع الزوال",
 "ゆきだま": "كُرَةُ الثَّلْج",
 "ゆきだるま": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
