 "ちほうこうむいん": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "ちほうさい": "سند بلدي (سند تصدره حكومة ولاية أو حكومة محلية)",
 "ちほうざいせい": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "ちほうざいせいほう": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "ちほうしゅっしん": "خَشِن, رِيفِيُّ النَّشْأَةِ (فظّ وغير مهذّب؛ نشأ في الريف)",
 "ちほうしょう": "خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف)",
 "ちほうしょくいんきょうさいくみあい": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "ちほうじ": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "ちほうじちたい": "سلطة محلية (وحدة إدارية للحكومة المحلية)",
 "ちほうぜい": "ضريبة المجلس البلدي (ضريبة تفرضها السلطات المحلية على الأسر المعيشية؛ وتعتمد على القيمة المقدرة…)",
 "ちほうびょう": "مرض متوطن (مرض موجود باستمرار بدرجة أكبر أو أقل في أشخاص من طبقة معينة أو في أشخاص يعيشون…)",
 "ちぼ": "نَشَّال",
 "ちぼう": "براعة, ذكاء (خاصية كون الشخص بارعاً)\nمثال: حبكة ذات براعة كبيرة / تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان)",
 "ちぼしん": "إلهة الأرض (إلهة الخصوبة والنباتات)",
 "ちまい": "صَغِير, صغير",
 "ちまた": "عَلَنِيّ, عَامّ / شَارِع, زَنَقَة / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث. / قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "ちまちま": "صَغِير, صغير",
 "ちまつり": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…)",
 "ちまつりにあげる": "عَذَاب",
 "ちまなこ": "نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "ちまみれ": "مُلَطَّخ بِالدِّمَاء (مغطى بالدم)",
 "ちまめ": "فقاعة دموية (بثرة تحتوي على دم أو مصل دموي عادة ما تسببها إصابة)",
 "ちみ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ちみち": "وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ…)\nمثال: وعاء السکر فارغ.",
 "ちみつ": "غَرَامَة / مَضْبُوط, دَقِيق",
 "ちみどろ": "مُدَمَّى, مُخَضَّب بِالدِّمَاء / يَائِس, قَانِط",
 "ちみゃく": "عرق معدني (طبقة من الخام بين طبقات الصخور)",
 "ちめい": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ) / اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / مُمِيت, قَاتِل",
 "ちめいがく": "علم أسماء الأماكن (فرع علم المعجم الذي يدرس أسماء الأماكن لمنطقة أو لغة)",
 "ちめいじてん": "قَامُوس جُغْرَافِيّ (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟",
 "ちめいてき": "مُمِيت, قَاتِل",
 "ちめいど": "شَعْبِيَّة",
 "ちも": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك…)",
 "ちもう": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "ちもなみだもない": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني)",
 "ちもん": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان) / جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "ちもんがく": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "ちゃ": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك. / بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة))\nمثال: توم من بني البشر. / اِسْتِهْزَاء / إِنْ (يفيد التوكيد)\nمثال: إن شاء الله ؛ / وَاحِدًا تِلْوَ الآخَرِ",
 "ちゃあ": "إِنْ (يفيد التوكيد)\nمثال: إن شاء الله ؛ / وَاحِدًا تِلْوَ الآخَرِ",
 "ちゃあちゃん": "مُومِيَاء / جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة.",
 "ちゃいます": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ちゃいろ": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة))\nمثال: توم من بني البشر.",
 "ちゃいろい": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "ちゃいろっぽい": "بُنِّيّ (بلون مشابه للخشب أو التراب)",
 "ちゃう": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ちゃか": "استجمام, ترويح عن النفس (نشاط يجدد النشاط ويرفه؛ نشاط يجدد صحتك وروحك بالمتعة والاسترخاء)\nمثال: وقت للراحة والاستجمام بجانب المسبح / مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس.",
 "ちゃかい": "حفل شاي (حفلة أو استقبال يتم فيه تقديم الشاي) / سَادُو, طُقُوس اَلشَّاي",
 "ちゃかす": "سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا:…)\nمثال: سخر المدرس من جسمي.",
 "ちゃかちゃか": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "ちゃかつやく": "تي إن تي, ثلاثي نتروتولوين (مادة متفجرة تتكون من مركب بلوري أصفر وهو مشتق سام وقابل للاشتعال من التولوين)",
 "ちゃかん": "علبة شاي (علبة لتخزين الشاي)",
 "ちゃがし": "كعكة الشاي (أي من الكعك الصغير أو البسكويت الذي يقدم عادة مع الشاي)",
 "ちゃがま": "غَلَّايَة",
 "ちゃき": "متعة, مرح (أنشطة ممتعة أو مسلية)\nمثال: أفعل ذلك من أجل المتعة",
 "ちゃきぐみ": "طقم الشاي (مجموعة من الخزف أو الفضيات لتقديم الشاي)",
 "ちゃきちゃき": "أَصْلِيّ / قَادِر (الذي له قُدْرَة أو مقدرة؛ القويّ المتمكن؛ الذي يَقْدُر الأمور أي يقيسها ويُهيأها)\nمثال: سامي قادر على هذا. / بخفَة",
