 "ていこうき": "مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "ていこうせい": "مُقَاوَمَة",
 "ていこうへんあつき": "محول خفض الجهد (محول يقلل الجهد)",
 "ていこうりつ": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "ていこうりょく": "مُقَاوَمَة",
 "ていこく": "جَدْوَل مَوَاعِيد, جَدْوَل / إِمْبِرَاطُورِيَّة",
 "ていこくぎかい": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها)",
 "ていこくしゅぎ": "إِمْبِرْيَالِيَّة, اِسْتِعْمَارِيَّة",
 "ていこくしゅぎしゃ": "إِمْبَرِيَالِيّ",
 "ていこくしゅぎてき": "إمبريالي, استعماري (من أو متعلق بالإمبريالية)\nمثال: حروب إمبريالية",
 "ていこくどおり": "عَلَى الْمَوْعَدِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ていご": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "ていさ": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر.",
 "ていさい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / تنسيق, شكل (المظهر العام لمنشور)",
 "ていさいよく": "بذوق رفيع (بذوق؛ بطريقة تنم عن ذوق)\nمثال: كان المنزل مزيناً بذوق رفيع",
 "ていさつ": "استكشاف (الاستكشاف من أجل الحصول على معلومات)\nمثال: الاستكشاف في أراضي العدو خطير جداً",
 "ていさつえいせい": "قمر تجسس (قمر صناعي مزود بأجهزة استشعار للكشف عن الانفجارات النووية أو المراقبة)",
 "ていさつき": "طائرة استطلاع (طائرة عسكرية تستخدم للحصول على معلومات عن العدو)",
 "ていさつたい": "دَوْرِيَّة, خَفْر",
 "ていさんそしょう": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "ていざいは": "موجة راكدة, موجة موقوفة (موجة (كموجة صوتية في غرفة أو موجة كهرومغناطيسية في خط نقل) لا تتغير فيها نسبة…)",
 "ていし": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض) / إيقاف, توقف (فعل إيقاف شيء ما)\nمثال: إيقافه للتدفق أدى إلى فيضان / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / يُعَلِّق / تِلْمِيذ, تِلْمِيذَة / وَقْف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / أَحْوَل, مُحَوِّل (ذو عينين نصف مغلقتين من أجل الرؤية بشكل أفضل) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / سَلَالِم",
 "ていしえき": "حمام إيقاف (حمام حمضي يستخدم لإيقاف عمل المظهر في التحميض الفوتوغرافي)",
 "ていしき": "اختيار الألوان, تلوين (اختيار واستخدام الألوان (كما يفعل الفنان))\nمثال: تلوينها الصحي / صِيغَة",
 "ていしきか": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا)\nمثال: وصف الطبيب مستحضراً تجارياً للدواء",
 "ていしきかん": "فترة التعطيل",
 "ていしげき": "مِن غَيْر المُرَجَّح أَن يُسَبِّب حَسَاسِيَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ていししんごう": "إشارة المرور, ضوء المرور (إشارة بصرية للتحكم في تدفق حركة المرور عند التقاطعات)",
 "ていしせい": "توارٍ عن الأنظار, ظهور منخفض (حالة من قلة الظهور يتم فيها تجنب لفت انتباه الجمهور)\nمثال: لم يكن أبداً ممن يفضلون التواري عن الأنظار",
 "ていしっち": "سَلْخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ていしつ": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها)",
 "ていしつち": "سَلْخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "ていしぼうぎゅうにゅう": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "ていしぼうにゅう": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "ていしゃ": "ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً",
 "ていしゃえき": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ていしゃじょう": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ていしゃば": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ていしゅ": "سَيِّد\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / قَوْس, قوس",
 "ていしゅう": "جِينْغْجُو",
 "ていしゅうは": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها)",
 "ていしゅうははっしんき": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها)",
 "ていしゅく": "عِفَّة, طَهَارَة",
 "ていしゅつ": "إِرَاءَة / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "ていしゅつきげん": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "ていしゅつしゃ": "مانح, متبرع (شخص يقدم هدية أو هبة من ممتلكاته)",
 "ていしゅつび": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "ていしょ": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "ていしょう": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / مِعْطَاء / محاماة",
 "ていしょうしゃ": "دَاعِم, مُؤَيِّد",
 "ていしょく": "اختيار الألوان, تلوين (اختيار واستخدام الألوان (كما يفعل الفنان))\nمثال: تلوينها الصحي / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / مِسَاس / صِرَاع, نِزَاع / تَصَادُّم, اِصْطِدَام / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو)\nمثال: زراعة الذرة عمل شاق",
 "ていしょとくしゃいりょうふじょ": "رعاية طبية للمحتاجين, ميديكيد (رعاية صحية للمحتاجين؛ برنامج ممول فيدرالياً ومن الولاية (في الولايات المتحدة))",
 "ていしん": "رجل حاشية (مرافق في بلاط الحاكم) / اتصالات, علوم الاتصال (التخصص الذي يدرس مبادئ نقل المعلومات وطرق إيصالها (مثل المطبوعات أو الراديو أو…)\nمثال: الاتصالات هي مجال دراسته الرئيسي / مُتَطَوِّع, مُتَطَوِّعَة",
 "ていしんしゅうしゅじゅつ": "ذَات أَقَل تَدَخُّل جِرَاحِيّ, بِأَقَل تَدَخُّل جِرَاحِيّ",
 "ていしんたい": "قوة عسكرية, وحدة عسكرية (وحدة تكون جزءًا من خدمة عسكرية ما)\nمثال: أرسل لقيصر قوة قوامها ستة آلاف رجل",
 "ていじ": "إِرَاءَة / عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / بالدور, على التوالي (في ترتيب أو تسلسل مناسب)\nمثال: تحدث إلى كل طفل بدوره / تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "ていじげん": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "ていじせい": "بدوام جزئي (ينطوي على وقت أقل من الوقت القياسي أو المعتاد لنشاط ما)\nمثال: موظفون بدوام جزئي / انضباط, دقة المواعيد (صفة أو عادة الالتزام بالوقت المحدد)",
 "ていじせいこうこう": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "ていじつ": "وَفِيّ, مُخْلِص\nمثال: هو غبي وغير أمين.",
 "ていじぶ": "مَعْرِض",
 "ていじほう": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح…)\nمثال: أدرس علم النفس.",
 "ていじゅう": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "ていじゅうか": "سكن مؤقت (أماكن معيشة مؤقتة)",
 "ていじゅうしゃ": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ていじゅん": "طَاعَة, إِطَاعَة",
 "ていじょう": "مِعْطَاء / عَادِيّ",
 "ていじょうは": "موجة راكدة, موجة موقوفة (موجة (كموجة صوتية في غرفة أو موجة كهرومغناطيسية في خط نقل) لا تتغير فيها نسبة…)",
 "ていす": "مُخَاطَرة\nمثال: أنا ذاهب للخطر. / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ",
 "ていすいじゅん": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب)",
 "ていすいじゅんげんご": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "ていすう": "نِصَاب / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / لَفْظِيّ, حَرْفِيّ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / قَاعِدَة",
 "ていすうぜせい": "إعادة تخصيص, إعادة تقسيم (تقسيم جديد (خاصة تقسيم جديد لمقاعد الكونغرس في الولايات المتحدة على أساس نتائج…)",
 "ていする": "مُخَاطَرة\nمثال: أنا ذاهب للخطر. / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ / صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك.",
 "ていずいえきあつしょうこうぐん": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "ていせい": "هَمْس / كيفي, نوعي (يتضمن تمييزات مبنية على الصفات أو الخصائص)\nمثال: تغيير نوعي / تَصْحِيح / إِمْبِرْيَالِيَّة, اِسْتِعْمَارِيَّة / قاعي (من أو متعلق بـ أو يحدث في القاع تحت جسم مائي) / بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "ていせいせいぶつ": "بينثوس, قاعيات (كائنات (نباتات وحيوانات) تعيش في أو بالقرب من قاع بحر أو بحيرة أو نهر أو جدول)",
 "ていせいてき": "كيفي, نوعي (يتضمن تمييزات مبنية على الصفات أو الخصائص)\nمثال: تغيير نوعي",
 "ていせいぶんせき": "تحليل كيميائي, تحليل نوعي (فعل تفكيك مادة إلى عناصرها المكونة)",
 "ていせきぶん": "تكامل محدود (تكامل دالة على فترة محددة)",
 "ていせつ": "عِفَّة, طَهَارَة / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / وِلَادَة قَيْصَرِيَّة",
 "ていせん": "هُدْنَة\nمثال: この停戦が世界平和に役立つことを私達はみな望んでいる。 — نأمل جميعًا أن يأتي وقف إطلاق النار هذا بسلام عالمي. / تَوْقِيف / خط الساحل, شاطئ (خط الحدود بين اليابسة والماء)",
 "ていせんきょうてい": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "ていせんごうい": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "ていせんりつ": "كانتوس فيرموس, لحن ثابت (لحن موجود مسبقاً يستخدم كأساس لتكوين متعدد الأصوات؛ مستمد أصلاً من الترتيل…)",
 "ていぜん": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان.",
 "ていそう": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / عِفَّة, طَهَارَة / إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً",
 "ていそうおん": "صَامِت, هَادِئ",
 "ていそうけんご": "عَفِيف, زَكِيّ",
 "ていそうじゅうきょせんようちいき": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع",
 "ていそうじゅうりん": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب.",
 "ていそく": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ていそくしゃ": "بَطِيء الحَرَكَة (يَتَحَرَّك بِبُطْء)",
 "ていそくすう": "نِصَاب",
 "ていそくギヤ": "الترس الأول, السرعة الأولى (أدنى نسبة تروس أمامية في صندوق تروس المركبة؛ تستخدم لبدء تحرك السيارة)",
 "ていそにん": "مُدَّعٍ, الْمُدَّعِي",
 "ていぞく": "بَذِيء",
 "ていたい": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / رُكُود / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة)",
