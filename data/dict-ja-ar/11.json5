 "ちのあめ": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "ちのう": "جِهَاز الْمُخَابَرَات, مُخَابَرَات / قوى عقلية, مدارك (القوة البشرية الأساسية للتفكير الذكي والإدراك)\nمثال: استخدم ذكاءه للتقدم",
 "ちのうけんさ": "اختبار ذكاء (اختبار نفسي لقياس الذكاء)\nمثال: اعتادوا الاعتقاد بأن الذكاء هو ما يختبره اختبار الذكاء",
 "ちのうしすう": "مُعَدَّل ذَكَاء (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير…)\nمثال: انخفض معدل الجريمة.",
 "ちのうてき": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "ちのうねんれい": "عمر عقلي (مستوى التطور الفكري كما يقاس باختبار الذكاء)",
 "ちのうはん": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "ちのうテスト": "اختبار ذكاء (اختبار نفسي لقياس الذكاء)\nمثال: اعتادوا الاعتقاد بأن الذكاء هو ما يختبره اختبار الذكاء",
 "ちのかよった": "بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق.",
 "ちのけ": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى…)\nمثال: تبرع توم بالدم.",
 "ちのけがおおい": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "ちのけがない": "بَاهِت, شَاحِب",
 "ちのけのおおい": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "ちのけのない": "بَاهِت, شَاحِب",
 "ちのつながった": "مُتَعَلَّق",
 "ちのでるよう": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "ちのにじむよう": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "ちのみご": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ちのみち": "وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ…)\nمثال: وعاء السکر فارغ.",
 "ちのめぐり": "اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم",
 "ちのめぐりがわるい": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "ちのめぐりのわるい": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "ちのり": "ينطح",
 "ちはあらそえない": "الْوَلَدُ سُرّ أَبِيهِ",
 "ちはい": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري.",
 "ちはちからなり": "اَلْمَعْرِفَة قُوَّة",
 "ちはつ": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة)",
 "ちはつせい": "مُتَأَخِّر (لم يبلغ المستوى الطبيعي من التطور)",
 "ちはつせいウイルス": "فيروس بطيء (فيروس يظل خاملاً في الجسم لفترة طويلة قبل ظهور الأعراض)\nمثال: مرض كورو يسببه فيروس بطيء",
 "ちはつせいジスキネジア": "خلل الحركة المتأخر (دوران لا إرادي لللسان وارتعاش في الوجه أو الجذع أو الأطراف؛ يحدث غالباً في مرضى…)",
 "ちば": "تْشِيبَا",
 "ちばけんりつちゅうおうはくぶつかん": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "ちばなれ": "فطام (عملية استبدال حليب الأم بطعام آخر في النظام الغذائي للطفل أو الثدييات الصغيرة)",
 "ちばん": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة. / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / دائرة انتخابية, ناخبون (هيئة الناخبين الذين ينتخبون ممثلاً لمنطقتهم)",
 "ちひろ": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "ちび": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال / قَزَم / ضئيل الجسم, قزم (مصطلحات مهينة للأشخاص صغار الحجم)",
 "ちびすけ": "قَزَم",
 "ちびちび": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة)\nمثال: حركوه بوصة بوصة",
 "ちびっこ": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "ちびっこい": "صَغِير, صغير",
 "ちびっと": "قَلِيلًا",
 "ちびっ子": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "ちびふくろももんが": "فأر طائر (كسكس طائر صغير جداً)",
 "ちびふで": "بَالٍ",
 "ちびょう": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري.",
 "ちびりちびり": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة)\nمثال: حركوه بوصة بوصة",
 "ちびる": "كَلِيل",
 "ちび助": "قَزَم",
 "ちぶ": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "ちぶくろ": "ثَدْي, بز\nمثال: تلقى ياني طلقة في الصدر.",
 "ちぶさ": "ثَدْي, بز\nمثال: تلقى ياني طلقة في الصدر.",
 "ちぶささつえい": "تصوير الثدي بالأشعة (إجراء تشخيصي للكشف عن أورام الثدي باستخدام الأشعة السينية)",
 "ちぶつ": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "ちぶん": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان)",
 "ちへい": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق. / مجال بصر",
 "ちへいせん": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "ちべたい": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "ちほ": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "ちほう": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف) / غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد…)\nمثال: ما تقترحه غباء.",
 "ちほうかん": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "ちほうかんちょう": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
