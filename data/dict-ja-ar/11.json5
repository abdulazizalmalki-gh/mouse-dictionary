 "ちょうほうたい": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "ちょうほうもう": "شبكة تجسس (شبكة من الجواسيس)",
 "ちょうほしゅてき": "بَالِغُ المُحَافَظَةِ, مُتَطَرِّفٌ فِي المُحَافَظَةِ (مُحَافِظٌ إِلَى أَقْصَى حَدٍّ) / رجعي, يميني متطرف (محافظ متطرف؛ معارض للتقدم أو الليبرالية)",
 "ちょうほんにん": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ちょうぼ": "دَفْتَر حِسَابَات / تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية)) / فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "ちょうぼいん": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى ضعف الطول))",
 "ちょうぼう": "مَنْظَر, مَشْهَد",
 "ちょうぼかかく": "قيمة دفتريّة (القيمة التي يُسجل بها الأصل في الميزانية العمومية؛ تساوي التكلفة ناقص الاستهلاك المتراكم)",
 "ちょうぼん": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ちょうまい": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "ちょうまめ": "بازلاء الفراشة, سينتروسيما (كرمة كبيرة الزهر ضعيفة الالتفاف أو منبسطة من نيو جيرسي إلى شرق أمريكا الشمالية الاستوائية، تزرع أحياناً لزهورها الأرجوانية والبيضاء) / بازلاء الفراشة, كليتوريا ماريانا (كرمة برية ملتفة كبيرة الزهر في جنوب شرق ووسط الولايات المتحدة لها أزهار زرقاء شاحبة) / بازلاء الفراشة, بازلاء زرقاء (كرمة من آسيا الاستوائية لها أوراق ريشية وأزهار زرقاء زاهية بمراكز صفراء)",
 "ちょうまん": "تطبل البطن (انتفاخ البطن الناجم عن تراكم الغازات في الأمعاء أو التجويف البريتوني)",
 "ちょうまんいん": "مُحْتَقِن (مُمْتَلِئ بِإِفْرَاط كَمَا بِالدَّم)",
 "ちょうみ": "بَهَار, تَابِل",
 "ちょうみつ": "كَثِيف, غَلِيظ",
 "ちょうみりょう": "بَهَار, تَابِل",
 "ちょうみん": "مَدِينِيّ",
 "ちょうむすび": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "ちょうめん": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "ちょうめんづら": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "ちょうもく": "نَقْد, نُقُود",
 "ちょうもつ": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان أَلِيف (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "ちょうもと": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / مُؤَلِّف, كَتَّاب / مُرَاهِن",
 "ちょうもん": "اِسْتِمَاع",
 "ちょうもんかい": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "ちょうもんそう": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران) / معترف (شخص يعترف (يكشف معلومات تضر بنفسه))",
 "ちょうやく": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "ちょうやくきょり": "مسافة القفز (أقصر مسافة تسمح لإشارات الراديو (بتردد معين) بالانتقال من المرسل إلى المستقبل عن طريق الانعكاس من الأيونوسفير)",
 "ちょうゆう": "مَدَنِيّ",
 "ちょうよう": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية) / صياغة, كتابة مسودة (كتابة نسخة أولية ليتم استكمالها وتنقيحها لاحقًا) / رسم (إنشاء صور فنية أو مخططات)\nمثال: تعلم الرسم من والده / شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "ちょうよはなよ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "ちょうらい": "مُنْذُ / سُجُود",
 "ちょうらく": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ちょうらんがく": "علم البيض (فرع علم الحيوان الذي يدرس البيض (خاصة بيض الطيور وحجمه وشكله ولونه وعدده))",
 "ちょうり": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ. / إِتَا",
 "ちょうりきぐ": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "ちょうりしつ": "قَادِس",
 "ちょうりしゃ": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "ちょうりだい": "طاولة المطبخ (طاولة توضع في المطبخ)",
 "ちょうりつ": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي) / مَدَنِيّ",
 "ちょうりついじょう": "اِضْطِرَاب نَظْم القَلْب",
 "ちょうりつし": "مدوزن البيانو (شخص يضبط البيانو)",
 "ちょうりどうぐ": "آنية مطبخ, أداة مطبخ (أداة تستخدم في إعداد الطعام)",
 "ちょうりにん": "طَاهٍ, طَاهِي",
 "ちょうりば": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ.",
 "ちょうりほう": "وَصْفَة",
 "ちょうりゃく": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "ちょうりゅう": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / مَيْل, نَزَعَة",
 "ちょうりょう": "هَيْمَنَة, سَيْطَرَة",
 "ちょうりょうばっこ": "هَيْمَنَة, سَيْطَرَة",
 "ちょうりょく": "تَوَتُّر / شَدّ / جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ちょうりょくけい": "مقياس التوتر السطحي (أداة قياس لقياس التوتر السطحي لسائل) / مقياس الشد (أداة قياس لقياس الشد في سلك أو ليف أو عارضة) / مقياس رطوبة التربة (أداة قياس لقياس محتوى الرطوبة في التربة) / مقياس السمع (أداة تستخدم لقياس حساسية السمع)",
 "ちょうりんかい": "فَوْقَ حَرِج ((خاصة في المواد الانشطارية) قادر على استدامة تفاعل متسلسل بحيث يزداد معدل التفاعل)",
 "ちょうるい": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "ちょうるいがく": "عَلِمَ الطَائِر, عَلِم الطُيُور (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ちょうるいがくしゃ": "عَالِم طُيُور, خَبِير فِي عِلْمِ الطُّيُور (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "ちょうれん": "تدريب عسكري (التدريب على المسير واستخدام الأسلحة)",
 "ちょうれんけつし": "اِرْتِبَاط تَشَعُّبِيّ",
 "ちょうろ": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "ちょうろう": "كَابِر / بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله) / خَمَان / عميد (إداري مسؤول عن قسم في جامعة أو كلية) / عميد مجمع الكرادلة ((الكنيسة الكاثوليكية الرومانية) رئيس مجمع الكرادلة) / عَمِيد (رجل هو العضو الأقدم في مجموعة ما)\nمثال: هو عميد المراسلين الأجانب / اِحْتَقَرَ / استنكف / استخف",
 "ちょうろうきょうかい": "الكنيسة المشيخية (الطائفة البروتستانتية الملتزمة بآراء جون كالفن)",
 "ちょうろうせい": "غَيْرُونْتُوقْرَاطِيَّة",
 "ちょうろうせいじ": "غَيْرُونْتُوقْرَاطِيَّة",
 "ちょうろうは": "الكنيسة المشيخية (الطائفة البروتستانتية الملتزمة بآراء جون كالفن)",
 "ちょうろうはきょうかい": "الكنيسة المشيخية (الطائفة البروتستانتية الملتزمة بآراء جون كالفن)",
 "ちょうわ": "اِنْسِجَام, تَوَافُق",
 "ちょうわすうれつ": "متتالية توافقية ((رياضيات) متتالية من الحدود تشكل مقلوباتُها متتالية حسابية)",
 "ちょうわへいきん": "وسط توافقي",
 "ちょうアクチノイドげんそ": "ما بعد الأكتينيدات (متعلق بالعناصر ذات الأعداد الذرية الأكبر من 103) / عنصر ما بعد الأكتينيدات (أي من العناصر المنتجة صناعياً ذات الأعداد الذرية الأكبر من 103)",
 "ちょうウランげんそ": "عنصر ما بعد اليورانيوم (أي عنصر له عدد ذري أكبر من 92 (وهو العدد الذري لليورانيوم)؛ وجميعها مشعة)",
 "ちょうカタル": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)",
 "ちょうチフス": "الْحُمَّى التِّيفِيَّة",
 "ちょうチフスきん": "سالمونيلا تيفية, عصوية التيفوئيد (شكل من أشكال السالمونيلا يسبب حمى التيفوئيد)",
 "ちょうドきゅう": "دَرَجَة فَائِقَة",
 "ちょうネクタイ": "بابيون, ربطة عنق فراشة (ربطة عنق رجالية تُربط على شكل فيونكة)",
 "ちょうロ": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "ちょう度": "اِتِّسَاق",
