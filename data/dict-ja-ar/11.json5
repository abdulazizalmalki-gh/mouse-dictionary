 "とっ捕まえる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "とつ": "مُحَدَّب",
 "とつえん": "تحدب (الخاصية التي يمتلكها الشكل المحدب) / تحدب, شكل محدب (شكل ينحني أو يبرز إلى الخارج)",
 "とつおいつ": "بِتَرَدُّد (الافتقار إلى التصميم أو الحسم)",
 "とつおう": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "とつがく": "بروز الفك, فقم (حالة بروز الفك نحو الأمام)",
 "とつがた": "تحدب (الخاصية التي يمتلكها الشكل المحدب) / تحدب, شكل محدب (شكل ينحني أو يبرز إلى الخارج)",
 "とつぎ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "とつくに": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "とつぐ": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "とつけい": "مُحَدَّب",
 "とつげき": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "とつげきいちばん": "عَازِل ذَكَرِيّ / وَاقٍ ذَكَرِيّ / كُونْدُوم / كَانْدُوم / عَازِل طِبِّيّ",
 "とつげきじゅう": "بُنْدُقِيَّة هُجُومِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "とつげきたい": "كتيبة العاصفة (ميليشيا نازية أنشأها هتلر عام 1921 ساعدته في الوصول إلى السلطة ولكن طغت عليها القوات الخاصة بعد عام 1943) / قوات الصدمة (جنود مدربون ومسلحون بشكل خاص لقيادة هجوم)",
 "とつげきたいいん": "جندي العاصفة (عضو في القوات شبه العسكرية النازية)",
 "とつげきほう": "مدفع هجومي (مركبة مدرعة بهيكل دبابة (ولكن بدون برج) ومدفع كبير؛ تستخدم كسلاح مضاد للدبابات ولدعم المشاة) / بندقية اقتحام, بندقية هجومية (أي من البنادق الآلية أو نصف الآلية ذات مخازن الذخيرة الكبيرة المصممة للاستخدام العسكري)",
 "とつごう": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "とつじょ": "فَجْأَةً",
 "とつじょう": "نَاتِئَة",
 "とつじょとして": "فَجْأَةً",
 "とつする": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "とつぜん": "مُبَاغِت, مُفَاجِئ",
 "とつぜんし": "مَوْت الفَجْأَة (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "とつぜんへんい": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "とつぜんへんいたい": "حيوان متحول, طافر (حيوان خضع لطفرة جينية) / طافر, متحول (يميل للخضوع لطفرة أو ناتج عنها) / طافر, طفرة ((في علم الأحياء) كائن حي له خصائص ناتجة عن تغيير كروموسومي)\nمثال: جين طافر",
 "とつたかくけい": "مضلع محدب (مضلع بحيث إذا مُد أي ضلع لا يقطع أي ضلع أو رأس آخر)",
 "とつとして": "فَجْأَةً",
 "とつとつ": "نَقْرَة / نَقَرَ / بِسُخْط, بِغَضَب (بطريقة تعبر عن الغضب)\nمثال: أنكر الاتهام بغضب / مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "とつにゅう": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "とつめん": "مُحَدَّب",
 "とつる": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / رِسَالَة, خَبَر",
 "とつレンズ": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "とて": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "とてい": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "とていせいど": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "とてつもない": "مُسْرِف / ضَخْم, هَائِل",
 "とても": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / أبداً",
 "とてもかくても": "مَهْمَا",
 "とてもじゃない": "أبداً",
 "とてもとても": "أبداً",
 "とでもない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "とと": "كرة الريشة (أداة في لعبة الريشة الطائرة تتكون من كرة من الفلين أو المطاط مع تاج من الريش) / بِيرْدِي / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "ととう": "متآمر (عضو في مؤامرة)",
 "ととのえ": "تَحْضِير, إِعْدَاد",
 "ととのえる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / ضَبَطَ",
 "ととのった": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "とともに": "بشكل مشترك, جماعياً (بالاشتراك مع؛ مجتمعين)\nمثال: رواتبنا مجتمعة لا تستطيع دفع ثمن الضرر",
 "とど": "أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ) / أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "とどうけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "とどうふけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "とどく": "بَلَغَ / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / ضَرَرٌ / ضَرَّ أَضَرَّ",
 "とどけ": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどけいで": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどけがき": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどけさき": "وِجْهَة, وُجْهَة",
 "とどけしょ": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどけずみ": "مُبَلَّغ عَنْه, مُقَرَّر (تم جعله معروفاً أو التحدث عنه؛ خاصة تقديمه في حساب رسمي)\nمثال: رأيه المبلغ عنه (المنقول)",
 "とどけで": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどけでる": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどけもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "とどける": "نَقَلَ / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "とどこおり": "رُكُود / ركود اقتصادي",
 "とどこおりなく": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "とどのつまり": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "とどまる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "とどめなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "とどめる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / دَبُّوس / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "とどろ": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر)) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان)) / دوي, رعد (ضجيج عميق طويل وعالٍ)\nمثال: ثمل بشدة",
 "とどろかす": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "とどろき": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "とどろきわたる": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "とどろく": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "となえ": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "となえる": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا. / محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "となかい": "رَنَة",
 "となり": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "となりきんじょ": "جار, مجاور (جسم قريب من نفس النوع) / جَار (شخص يسكن (أو يقع) بالقرب من آخر)\nمثال: فورت وورث جارة لدالاس",
 "となりぐみ": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "となる": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / جار, مجاور (جسم قريب من نفس النوع) / جَار (شخص يسكن (أو يقع) بالقرب من آخر)\nمثال: فورت وورث جارة لدالاس",
 "とに": "مُبَاغِت, مُفَاجِئ",
 "とにかく": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "とにつく": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "とにもかくにも": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "とにやすんずる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "とね": "كَاهِن, قِسِّيس",
 "とねりこばのかえで": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "とねりこ葉の楓": "قيقب مانيتوبا, قيقب مراني الأوراق (شجرة ظل شائعة في شرق ووسط الولايات المتحدة)",
 "との": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم) / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "とのかた": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / حمام الرجال (مرحاض عام للرجال)",
 "とのがた": "نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / حمام الرجال (مرحاض عام للرجال)",
 "とのさま": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "とのさまげい": "الهواية, مبدأ الهواية (القناعة بوجوب ممارسة الرياضة كهواية (للمتعة) وليس من أجل المال)",
 "とのさまばった": "جراد مهاجر (جراد من العالم القديم يسافر في أسراب ضخمة يجرد مساحات واسعة من الغطاء النباتي)",
 "とのたち": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة / زَائِر / زَائِر, سَائِح",
 "とのちゃ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "とのばら": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "とは": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي.",
 "とはい": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "とはいえ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "とはべつに": "بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "とはもうせ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "とはん": "تسلق (الصعود بواسطة سلم أو ما شابه) / تدريج, قياس (فعل القياس أو الترتيب أو التعديل وفقًا لمقياس) / تدرج, تصنيف (فعل الترتيب في سلسلة متدرجة)",
 "とは別に": "بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "とは申せ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "とは言え": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "とば": "بيت قمار, وكر قمار (مبنى عام يمكن فيه لعب مجموعة متنوعة من ألعاب الحظ (يُدار كعمل تجاري))",
 "とばく": "قِمَار, مُقَامَرَة",
 "とばくし": "مُقَامِر / مُغَامِر",
 "とばくじょう": "نَادِي الْقِمَار",
 "とばくだい": "طاولة الألعاب, طاولة القمار (طاولة تستخدم للمقامرة؛ قد تكون مجهزة بلوحة ألعاب وفتحات للرقائق)",
 "とばくち": "دُخُول / مَدْخَل / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "とばしり": "عَدَّاء / عَدَّاءَة",
 "とばしる": "طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "とばす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن الأرض في آن واحد) / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "とばっちり": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "とばり": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس) / حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "とばん": "سَبُّورَة, لَوْح",
 "とば口": "دُخُول / مَدْخَل / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "とひ": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "とひと": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد)",
 "とひとま": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد)",
 "とび": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف) / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار) / بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر) / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير) / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "とびあがる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "とびいし": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "とびいた": "منطلق",
 "とびいり": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "とびいろ": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "とびうお": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "とびうおざ": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "とびうお座": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "とびかける": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "とびきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "とびぐち": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "とびけら": "ذباب كاديس, ذبابة القمص (حشرة صغيرة تشبه العثة لها زوجان من الأجنحة الغشائية المشعرة ويرقات مائية)",
 "とびげり": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة ملامستها للأرض)",
 "とびこう": "أَصَحّ, أَلْيَق (متحسن في الصحة أو اللياقة البدنية) / خياط قياس, فني تركيب (شخص يقوم بضبط الملابس لتناسب شخصاً معيناً)",
 "とびこえる": "شَفَّاف / وَاضِح / قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "とびこし": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "とびこみ": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "とびこみえいぎょう": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "とびこみだい": "لوح الغطس (لوح قفز يمكن للسباحين الغطس منه)",
 "とびこむ": "غَاصَ / غَطْسَ, يقفز الى الماء",
 "とびさる": "نَثَرَ, تَفَرَّقَ",
 "とびしょうぎ": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "とびしょく": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / إِطْفَائِيّ",
 "とびしょくにん": "متسلق الأبراج (شخص يبني أو يصون الهياكل العالية جداً)",
 "とびだしナイフ": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "とびだす": "نَفِدَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "とびだすえほん": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "とびち": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "とびちる": "نَثَرَ, تَفَرَّقَ",
 "とびっきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "とびっ切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "とびでる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "とびとかげ": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "とびとび": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "とびどうぐ": "سِلَاح نَارِيّ",
 "とびぬけて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "とびねずみ": "جَرْبُوع, يَرْبُوع",
 "とびのもの": "إِطْفَائِيّ / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "とびはぜ": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على اليابسة باستخدام زعانف صدرية قوية)",
 "とびはねる": "نَقْز / نَقَزَ",
 "とびばこ": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "とびばった": "جَرَادَة",
 "とびむし": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية خاصة تسمح بنمط القفز المميز شبه الدائم؛ توجد في التربة الغنية بالحطام…)",
 "とびら": "أَبْوَاب, بَاب / صفحة العنوان (صفحة في كتاب تعرض العنوان والمؤلف والناشر)",
 "とびらえ": "صفحة العنوان المقابلة (رسم توضيحي أمامي يواجه صفحة العنوان في كتاب) / واجهة مزخرفة (واجهة مبنى مزخرفة)",
 "とびらぐち": "باب, فتحة الباب (المدخل (الحيز في الجدار) الذي تدخل أو تخرج منه من غرفة أو مبنى؛ الحيز الذي يمكن للباب إغلاقه)\nمثال: أطل برأسه من فتحة الباب",
 "とびりょうど": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "とび出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "とび口": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "とび工": "أَصَحّ, أَلْيَق (متحسن في الصحة أو اللياقة البدنية) / خياط قياس, فني تركيب (شخص يقوم بضبط الملابس لتناسب شخصاً معيناً)",
 "とび職": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / إِطْفَائِيّ",
 "とび職人": "متسلق الأبراج (شخص يبني أو يصون الهياكل العالية جداً)",
 "とび色": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "とふ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "とふぎょ": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه عريضة)",
 "とふく": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "とふけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "とふざい": "دَلُوك",
 "とぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "とぶつ": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ / رِهَان, مُرَاهَنَة",
 "とぶとり": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "とぶらい": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة / تَعْزِيَة / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "とべ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "とべないとり": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "とほ": "مُتَجَسِّد / مَشْي (السَيْر على رجلين؛ السير عامّة)\nمثال: مشي توم مع ماري.",
 "とほう": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "とほうもない": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "とほきょうそう": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "とぼける": "تَصَرَّفَ بِغَبَاء",
 "とぼし": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "とぼしい": "شَحِيح, ضَئِيل (ناقص في الكمية أو الجودة أو المدى)\nمثال: موارد شحيحة",
 "とぼしき": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "とぼす": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "とぼそ": "أَبْوَاب, بَاب",
 "とぼとぼ": "سير شاق (مشي طويل وصعب)",
 "とまく": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "とます": "أَثْرَى",
 "とまつ": "دَهَنَ (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / لَوَّثَ\nمثال: توم بدهن غرفته.",
 "とまどい": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "とまり": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / مَكَثَ, بَقِيَ / إِقَامَة / خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / أَنْكُورِيج",
 "とまりきゃく": "ضيف المنزل (ضيف يتم استقباله في منزلك)",
 "とまりぎ": "فرخ (أي من الأسماك العديدة شائكة الزعانف من فصائل مختلفة من رتبة الفرخيات) / فرخ (أسماك غذائية ورياضية شائكة الزعانف تعيش في المياه العذبة) / مجثم (دعامة تتكون من فرع أو قضيب يعمل كمكان للراحة (خاصة للطائر)) / سمك الفرخ, فرخ (أي من العديد من أسماك أمريكا وأوروبا)",
 "とまりこむ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "とまりちん": "تَعَارِيف, تَعْرِفَة / تَعَارِيف",
 "とまる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "とまれ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "とまれかくまれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "とみ": "ثروة, غنى (وفرة من الممتلكات والموارد المادية) / مَوْرِد / يَانَصِيب / مُبَاغِت, مُفَاجِئ",
 "とみに": "فَجْأَةً",
 "とみん": "طُوكْيَوِيّ",
 "とむ": "كَثُر, تَوَفَر (غَلَبَ فِي ٱلْكَثْرَةِ، فَاقَ فِي ٱلْعَدَدِ؛ كاثَرُوهمْ فكثَرُوهمْ: غالَبوهُم فَغلَبوهُ)\nمثال: عندي أصدقاء كثر",
 "とむらい": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة / تَعْزِيَة",
 "とめ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد) / خَمْسَة وَأَرْبَعُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "とめおき": "تَوْقِيف",
 "とめおく": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "とめおとこ": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "とめかなぐ": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "とめがね": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "とめぎ": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو سلسلة أو كابل لتثبيته بشيء ما (مثل حبل أو سلسلة أو كابل آخر)) / مفتاح تبديل, مفتاح قلاب (مفتاح مفصلي يمكن أن يتخذ أحد وضعين) / أمر تبديل, مفتاح تبديل (أي تعليمة تعمل بطريقة ما أولاً ثم بطريقة أخرى؛ فهي تشغّل شيئاً ما في المرة الأولى لاستخدامها ثم توقفه في المرة التالية)",
 "とめくぎ": "توجل, مسمار تثبيت (مثبت يتكون من وتد أو مسمار أو قطعة عرضية يتم إدخالها في عروة في نهاية حبل أو سلسلة أو كابل لتثبيته بشيء ما (مثل حبل أو سلسلة أو كابل آخر)) / مفتاح تبديل, مفتاح قلاب (مفتاح مفصلي يمكن أن يتخذ أحد وضعين) / أمر تبديل, مفتاح تبديل (أي تعليمة تعمل بطريقة ما أولاً ثم بطريقة أخرى؛ فهي تشغّل شيئاً ما في المرة الأولى لاستخدامها ثم توقفه في المرة التالية)",
 "とめぐ": "زِلاَج, ضَبَّة",
 "とめだて": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "とめつぎ": "تاج الأسقف (غطاء رأس طقسي يرتديه الأساقفة في المناسبات الرسمية) / سطح الشطب (سطح الطرف المشطوب لقطعة حيث يتم عمل وصلة مشطوبة) / وصلة زاوية, وصلة مشطوبة (وصلة تشكل زاوية؛ عادة ما يتم شطب كلا الجانبين بزاوية 45 درجة لتشكيل زاوية 90 درجة)\nمثال: غطى سطح الشطب بالغراء قبل عمل الوصلة",
 "とめど": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "とめどない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "とめどなく": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "とめにはいる": "تَدَخَّلَ",
 "とめばり": "دَبُّوس",
 "とめやく": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "とめる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / وَقَّفَ, صَفَّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: ليس لدينا حديقة. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / غَلِقَ (ق. (فعل: ثلاثي لازم). غَلِقَ، يَغْلَقُ، مصدر غَلَقٌ؛ غلِقَ يَغلَق، غَلَقًا، فهو غَلِق)\nمثال: أعاد زيري غلق الخيمة. / غَنِيّ",
 "とも": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / مُصَاحَبَة / صَارِم, مُتَشَدِّد / مُؤَخَّرَة / بشكل مشترك, جماعياً (بالاشتراك مع؛ مجتمعين)\nمثال: رواتبنا مجتمعة لا تستطيع دفع ثمن الضرر / نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ / كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات / أَيْضًا, كَذٰلِكَ / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "ともあれ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "ともあれかくもあれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ともえせん": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة)) / اشتباك جوي, معركة جوية قريبة (اشتباك جوي بين الطائرات المقاتلة) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / صراع عنيف, قتال شرس (منافسة متنازع عليها بضراوة)\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "ともかく": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "ともかくも": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "ともがき": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともがら": "رَفِيق, رَفِيقَة",
 "ともぐい": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "ともこ": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともざ": "سطح الكوثل (سطح مكشوف جزئي على البنية الفوقية لمؤخرة السفينة)",
 "ともし": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "ともしい": "شَحِيح, ضَئِيل (ناقص في الكمية أو الجودة أو المدى)\nمثال: موارد شحيحة",
 "ともしび": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "ともす": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "ともせん": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام) / مانع, ورقة حاكمة ((في البريدج) ورقة لعب ذات قيمة عالية تكفي لضمان الفوز بالجولة في نقش معين) / قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم",
 "ともぜい": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "ともだち": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともだちづきあい": "عَلَاقَة اجْتِمَاعِيَّة (علاقة بين الكائنات الحية (وخاصة بين الناس))",
 "ともつひと": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ともづな": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "ともども": "مَعًا, سَوِيًّا",
 "ともどもに": "مَعًا, سَوِيًّا",
 "ともない": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ともなう": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ともなく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "ともなしに": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "ともなり": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام المنطوقة) / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / رنين (اهتزاز ذو سعة كبيرة ينتج عن اهتزاز صغير نسبياً بالقرب من نفس تردد الاهتزاز مثل التردد الطبيعي للنظام الرنان) / رنين (حالة مثارة لجسيم مستقر تسبب حداً أقصى حاداً في احتمالية امتصاص الإشعاع الكهرومغناطيسي) / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "ともに": "مَعًا, سَوِيًّا / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "ともにする": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "とものかい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "ともびと": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ともまわり": "بطانة, حاشية (المجموعة التي تتبع وتخدم شخصاً مهماً)",
 "ともらい": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\" / تَأْسِيَة / تَعْزِيَة",
 "とも座": "سطح الكوثل (سطح مكشوف جزئي على البنية الفوقية لمؤخرة السفينة)",
 "とも無く": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "とも無しに": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "とや": "خم دجاج, قن دجاج (مبنى مزرعة لإيواء الدواجن)",
 "とやかくいう": "اِنْتَقَدَ / نَقَدَ",
 "とやかく言う": "اِنْتَقَدَ / نَقَدَ",
 "とやま": "تُويَامَا",
 "とやら": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "とゆ": "فِنْطَاس / تدهين, مسح بالزيت (فعل وضع الزيت أو سائل زيتي)",
 "とゆう": "مَدِينَة, بَلَد / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "とゆうところ": "على الأكثر, كحد أقصى (ليس أكثر من)\nمثال: أنفق 20 دولاراً على الغداء كحد أقصى",
 "とゆうより": "بَدَلًا مِن / أَكْثَر مِن, عَنّ",
 "とゆうわけ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "とゆう所": "على الأكثر, كحد أقصى (ليس أكثر من)\nمثال: أنفق 20 دولاراً على الغداء كحد أقصى",
 "とよ": "فِنْطَاس",
 "とよあしはら": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "とよあしはらのみずほのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "とよあしわら": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "とよもす": "هَزَّ",
 "とら": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / بَبْر (حيوان ضخم مخطط من السّنوريّات. والببر يَختلف عن النَمِر، فالببر مخطط والنمر مرقّط) / نمر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا. / سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "とらい": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "とらえかた": "تَفْسِير",
 "とらえどころ": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "とらえどころのない": "متملص, مراوغ",
 "とらえる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / قَبْضَة / أَخَذَ, أَسَرَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "とらえ方": "تَفْسِير",
 "とらかん": "زِرّ",
 "とらがら": "مُخَطَّط",
 "とらがらパンツ": "مُخَطَّط كَالنَّمِر (ذو خطوط تُشبه خطوط النمر)",
 "とらげ": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "とらす": "مَنَحَ / مِنْحة",
 "とらねこ": "قط عتابي, قط مخطط (قط ذو معطف رمادي أو أسمر مبقع بالأسود)",
 "とらのお": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "とらのおをふむ": "لَعِبَ بِالنَّار (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "とらのこ": "جرو النمر, فزر (نمر صغير)",
 "とらのまき": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / كريبج (لعبة ورق (عادة للاعبين اثنين) يتم فيها توزيع ست أوراق لكل لاعب ويتخلص من ورقة أو اثنتين) / المهملات (البطاقات التي يتخلص منها اللاعبون في لعبة الكريبج) / سرير أطفال, مهد (سرير أطفال ذو جوانب عالية مصنوعة من شرائح خشبية أو قضبان) / صومعة صغيرة, مخزن حبوب (صندوق أو مخزن لتخزين الحبوب)",
 "とらの尾を踏む": "لَعِبَ بِالنَّار (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "とらばさみ": "فخ فولاذي (فخ مصنوع من الفولاذ بنابض قوي وبروزات حادة تشبه الأسنان للإمساك بالفريسة) / ذكاء حاد, عقل حاد (ذكاء حاد (تشبيه يعتمد على حدة المصائد الفولاذية المعروفة))\nمثال: إنه حاد الذكاء كالمصيدة الفولاذية",
 "とらふ": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "とらふずく": "بومة أذناء",
 "とらぶち": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "とらわれ": "أَسْر, سَبْي (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "とらわれのみ": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "とらわれびと": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "とらパン": "مُخَطَّط كَالنَّمِر (ذو خطوط تُشبه خطوط النمر)",
 "とら猫": "قط عتابي, قط مخطط (قط ذو معطف رمادي أو أسمر مبقع بالأسود)",
 "とり": "دَجَاج, لَحْم دَجَاج\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل. / مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة) / دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام) / دِيك (ذكر الدَجَاج؛ ذكر أي طير داجن يشبه الدجاج كالقَبَج وغيره)\nمثال: لديك بعض الكتب. / غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب. / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة",
 "とりあい": "تَهَافَتَ",
 "とりあう": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "とりあえず": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "とりあげ": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / قَبَالَة",
 "とりあげる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / تَبَنَّى / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / صَادَرَ",
 "とりあつかい": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "とりあつかいしゃ": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "とりあつかいしょ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "とりあつかいじょ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "とりあつかいせつめいしょ": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "とりあつかいてん": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "とりあつかいてんぽ": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "とりあつかいにん": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "とりあつかう": "مِقْبَض / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / عَالَجَ / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "とりあつめ": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "とりあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "とりあわせ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "とりいそぎ": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "とりいそぐ": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "とりいはいかん": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "とりいる": "تَمَلَّقَ",
 "とりいれ": "جني, حصاد (جمع المحصول الناضج)",
 "とりいれぐち": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس) / ابتلاع, استهلاك (عملية إدخال الطعام إلى الجسم عن طريق الفم (مثل الأكل)) / مأخذ, مدخل (فتحة يتم من خلالها إدخال السائل إلى أنبوب أو حاوية)",
 "とりいれる": "تَبَنَّى / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "とりうち": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام)",
 "とりうちぼう": "قبعة قماشية, قبعة مسطحة (قبعة صوفية مسطحة بحافة صلبة)",
 "とりえ": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة / بذور الطيور, طعام الطيور (طعام يقدم للطيور؛ عادة ما يكون خليطاً من البذور)",
 "とりおき": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "とりおく": "مُرَبًّى / حَافَظَ / مَسَكَ, مسك",
 "とりおこなう": "مَسَكَ, مسك",
 "とりおさえる": "إِسْتَوْلَى عَلَى / طَوَّعَ, تَغَلَّبَ عَلَى",
 "とりおとす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "とりおどし": "فَزَّاعَة",
 "とりおろす": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "とりかい": "تَرْبِيَة الطُيُور",
 "とりかえ": "مُبَادَلَة",
 "とりかえし": "شِفَاء, تَعَافِي",
 "とりかえす": "شُفِيَ, بَرِئَ",
 "とりかえっこ": "مُبَادَلَة",
 "とりかえる": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "とりかかる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "とりかこむ": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "とりかご": "قفص طيور (قفص يمكن حفظ طائر فيه)",
 "とりかじ": "مِينَاء, مينا / مَنْفَذ / كَيَّفَ, غَيَّرَ",
 "とりかた": "شرطي (عضو ذكر في قوة الشرطة)",
 "とりかぶと": "بِيش",
 "とりからあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "とりかわす": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "とりがらスープ": "مرق الدجاج (مرق مصنوع من الدجاج)",
 "とりき": "طَبَقَة",
 "とりきめ": "قَرَار, تَصْمِيم",
 "とりきめる": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "とりきる": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "とりく": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "とりくいぐも": "رُتَيْل",
 "とりくずす": "هَدَمَ (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "とりくち": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "とりくみ": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / جولة قتال, نزال (مسابقة أو قتال (خاصة بين الملاكمين أو المصارعين)) / نوبة مرضية, وعكة (فترة من المرض) / جولة, دور ((رياضة) قسم من اللعبة يكون خلاله فريق واحد في وضع الهجوم)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام",
 "とりくむ": "عَالَجَ",
 "とりけし": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "とりけす": "أَلْغَى, أَبْطَلَ",
 "とりげ": "رَخْت",
 "とりこ": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / ضَحِيَّة / أُضْحِيَّة",
 "とりこしくろう": "فرط القلق, قلق مفرط (قلق زائد عن الحد)\nمثال: 君はいつも取り越し苦労をしている。 — دائماً ما تتوقع حدوث المشاكل.",
 "とりこしぐろう": "فرط القلق, قلق مفرط (قلق زائد عن الحد)\nمثال: 君はいつも取り越し苦労をしている。 — دائماً ما تتوقع حدوث المشاكل.",
 "とりこみ": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك. / استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية)",
 "とりこみごと": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "とりこみさぎ": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "とりこむ": "تَبَنَّى / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / غَشَّ, جَدَعَ",
 "とりこめる": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "とりこわし": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "とりこわす": "هَدَمَ (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "とりごや": "بيت الطيور, قفص الطيور الكبير (مبنى تُحفظ فيه الطيور) / خم دجاج, قن دجاج (مبنى مزرعة لإيواء الدواجن)",
 "とりさげ": "اِنْسِحَاب",
 "とりさげる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "とりさばく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "とりさる": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "とりざた": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "とりしきる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "とりしずめる": "صَامِت, هَادِئ",
 "とりしまり": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "とりしまりやく": "عُضْو مَجْلِس إِدارَة (عضو في مجلس حاكم أو إدارة)",
 "とりしまりやくかい": "مَجْلِس إِدَارَة",
 "とりしまりやくしゃちょう": "مدير (شخص يتحكم في الموارد والنفقات)",
 "とりしまる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / ضَبَطَ",
 "とりしらべ": "تَحْقِيق",
 "とりしらべかん": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "とりしらべしつ": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود) / زنزانة ضيقة (زنزانة صغيرة أو ضيقة)",
 "とりしらべる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "とりしろ": "جُزْء",
 "とりすてる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "とりせつ": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "とりそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "とりそこねる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "とりそろえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "とりたて": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / طَازَج, طَازَة / عَذْب",
 "とりたてて": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "とりたてる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / شَدَّدَ (الشيءَ: قَوَّاه وجعله شديدًا؛ في الأمر: بالغ فيه)",
 "とりだしぐち": "فتحة إدخال (شق صغير (لإدخال عملة معدنية أو إيداع البريد)) / آلة القمار, سلوت (آلة قمار تستخدم للمقامرة) / شق, فتحة ((حاسوب) مقبس في الحاسوب المصغر يقبل لوحة دوائر إضافية) / خَانَة, مَوْقِع نَحْوِيّ (موقع في بناء لغوي نحوي يمكن فيه تبادل مجموعة متنوعة من الوحدات البديلة)\nمثال: وضع ربع دولار في الفتحة",
 "とりだしボタン": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "とりだす": "أَخْرَجَ / جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "とりちがえ": "التباس, خلط (خطأ ناتج عن اعتبار شيء مكان شيء آخر)\nمثال: غير اسمه لتجنب الخلط مع الخارج عن القانون سيئ السمعة / سُوء فَهْم",
 "とりちがえる": "أَسَاءَ الْفَهْم",
 "とりつ": "مُطْرَان, مِطْرَان",
 "とりつぎ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَادّ, مُجِيب (يقوم بالرد أو الإجابة) / وَسِيلَةُ النَّقْل"
}
