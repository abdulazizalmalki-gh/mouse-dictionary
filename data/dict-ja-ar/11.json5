 "ちょき": "مِقَصّ, مِقْرَاض",
 "ちょきちょき": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "ちょきん": "تحويشة العمر, مدخرات (صندوق من المال يتم ادخاره كاحتياطي)",
 "ちょきんがく": "تحويشة العمر, مدخرات (صندوق من المال يتم ادخاره كاحتياطي)",
 "ちょきんつうちょう": "دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "ちょきんばこ": "حَصَّالَة",
 "ちょく": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / نَزِيه, صَادِق / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ) / النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً)) / مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "ちょくえん": "قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "ちょくきん": "عضلة مستقيمة (أي من العضلات المستقيمة المختلفة)",
 "ちょくげんこじ": "شخص مستقيم, نزيه (شخص صريح وصادق)",
 "ちょくさ": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة)",
 "ちょくさい": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / حاسم, حاسمة",
 "ちょくさいかんめい": "صَرِيح, مُسْتَقِيم",
 "ちょくさいてき": "صَرِيح, مُسْتَقِيم",
 "ちょくしゃ": "رمي مباشر, نيران مباشرة (نيران توجه لهدف مرئي للشخص الذي يصوب)",
 "ちょくしるい": "مستقيمات الأجنحة (أي من الحشرات المختلفة التي لها أجنحة أمامية جلدية وأجنحة خلفية غشائية وأجزاء فم ماضغة)",
 "ちょくしんせい": "غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر) / استقامة, حسن نية (امتلاك نوايا صادقة) / استقامة, مباشرة (صحة المسار نحو الهدف) / استقامة (الخلو من الانحناءات أو المنعطفات أو الزوايا)\nمثال: تصرف بحسن نية",
 "ちょくじ": "تَنْضِيد / إشارية (وظيفة الإشارة أو التحديد من منظور مشارك في فعل الكلام أو الكتابة)",
 "ちょくじてんびん": "ميزان تحليلي, ميزان كيميائي (ميزان ذو عارضة عالي الدقة يستخدم في التحليل الكيميائي الكمي)",
 "ちょくじゃく": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "ちょくじょう": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة) / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / صراحة (سمة كون المرء صريحاً ومباشراً) / صدق, صراحة (صفة كون الشخص صادقاً ومباشراً في الموقف والكلام)",
 "ちょくじょうけいこう": "بَرِيء, شَفَّاف (خالٍ من المكر والخداع)",
 "ちょくじょうてき": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي) / مِزَاجِيّ, نَزَوِيّ (مُحَدَّدٌ بِالصُّدْفَةِ أَوِ النَّزْوَةِ لَا بِالضَّرُورَةِ أَوِ العَقْل) / دَافِع, مُحَرِّك (له قوّة الدفع أو التحريك) / انْدِفَاعِيّ, مُتَهَوِّر (بدون تفكير مسبق أو ترَوٍّ)",
 "ちょくせい": "مستقيم البويضة ((عن بويضة النبات) مستقيمة تماماً حيث يكون النقير في القمة)",
 "ちょくせつ": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / حاسم, حاسمة",
 "ちょくせつかんめい": "صَرِيح, مُسْتَقِيم",
 "ちょくせつこうどう": "عَمَل مُبَاشِر (عمل احتجاجي تقوم به مجموعات عمالية أو أقليات للحصول على مطالبهم)",
 "ちょくせつしえん": "دعم مباشر (مهمة تتطلب من قوة دعم قوة محددة أخرى وتفويضها بالرد مباشرة على طلب المساعدة من القوة المدعومة)",
 "ちょくせつしはい": "هُوَ",
 "ちょくせつしょうこ": "دليل مباشر (دليل (عادة شهادة شاهد) يرتبط مباشرة بالواقعة المتنازع عليها)",
 "ちょくせつしょうじゅんしゃげき": "رمي مباشر, نيران مباشرة (نيران توجه لهدف مرئي للشخص الذي يصوب)",
 "ちょくせつじんもん": "استجواب مباشر ((قانون) الاستجواب الأولي للشاهد من قبل الطرف الذي استدعاه)",
 "ちょくせつぜい": "ضريبة مباشرة (ضريبة يدفعها مباشرة الشخص أو المؤسسة المفروضة عليها)",
 "ちょくせつたいわ": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "ちょくせつてき": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / صَرِيح, مُسْتَقِيم",
 "ちょくせつひ": "تكلفة مباشرة (التكاليف التي يمكن ربطها بسهولة بهدف تكلفة معين)",
 "ちょくせつほう": "مَرْفُوع",
 "ちょくせつもくてきご": "مَفعول بِهِ (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: جواز سفر ساري المفعول.",
 "ちょくせつわほう": "كَلَام مُبَاشِر, مُقْتَبَس",
 "ちょくせん": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة) / خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم",
 "ちょくせんせい": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "ちょくせんせき": "أنثوفيليت (معدن بني غامق من مجموعة الأمفيبول؛ سيليكات المغنيسيوم والحديد)",
 "ちょくせんてき": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري / صَرِيح, مُسْتَقِيم",
 "ちょくせんコース": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "ちょくぜい": "ضريبة مباشرة (ضريبة يدفعها مباشرة الشخص أو المؤسسة المفروضة عليها)",
 "ちょくちょう": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "ちょくちょうえん": "التهاب المستقيم (التهاب المستقيم؛ يتميز ببراز دموي ورغبة متكررة في التبرز؛ يرتبط بشكل متكرر بمرض كرون أو التهاب القولون التقرحي)",
 "ちょくちょく": "كَثِيرًا, غَالِبًا",
 "ちょくつうびん": "رحلة مباشرة (رحلة مع توقف وسيط واحد أو أكثر ولكن بدون تغيير الطائرة)",
 "ちょくていすう": "لَفْظِيّ, حَرْفِيّ",
 "ちょくでん": "رقم التليفون, رقم الهاتف (الرقم المستخدم للاتصال بهاتف معين)\nمثال: لديه رقم غير مدرج في الدليل",
 "ちょくひ": "شَخْصِيّ",
 "ちょくほうたい": "قَائِمُ الزَّاوِيَة (يُشكِّل زاوية قائمة أو يحتوي على زاوية قائمة أو أكثر)",
 "ちょくめん": "مُوَاجَهَة, مُجَابَهَة / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "ちょくゆ": "تَشْبِيه",
 "ちょくりゅう": "تَيَّار مُسْتَمِر / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "ちょくる": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "ちょくれい": "مَرْسُوم",
 "ちょくれつ": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة / مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات) / تَتَابُعِيّ, تَسَلْسُلِيّ (يتعلق بالتنفيذ المتتابع لعمليات متعددة) / تسلسلي (يخص أو يحدث في أو ينتج سلسلة) / تسلسلي (يخص أو مؤلف بتقنية تسلسلية (في الموسيقى))\nمثال: زواج أحادي متسلسل",
 "ちょくれつか": "نشر متسلسل (النشر في شكل متسلسل)",
 "ちょくれつかいろ": "دائرة متسلسلة (دائرة تكون أجزاؤها متصلة بشكل متسلسل)",
 "ちょくわ": "مجموع مباشر (اتحاد مجموعتين منفصلتين حيث يكون كل عنصر هو مجموع عنصر من كل من المجموعات المنفصلة)",
 "ちょくわしゅうごう": "مجموع مباشر (اتحاد مجموعتين منفصلتين حيث يكون كل عنصر هو مجموع عنصر من كل من المجموعات المنفصلة)",
 "ちょける": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "ちょげん": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "ちょこざい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "ちょこちょこ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / كَثِيرًا, غَالِبًا",
 "ちょこちょこあるき": "تهادي, مشية البطة (المشي بخطوات قصيرة مع ميل الوزن من قدم لأخرى)\nمثال: البط يمشي بتهادٍ",
 "ちょこちょこ歩き": "تهادي, مشية البطة (المشي بخطوات قصيرة مع ميل الوزن من قدم لأخرى)\nمثال: البط يمشي بتهادٍ",
 "ちょこっと": "قَلِيلًا",
 "ちょこなん": "قَلِيلًا",
 "ちょこまか": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "ちょこん": "قَلِيلًا",
 "ちょさい": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب) / خشب ميت (فرع أو جزء من شجرة ميت)",
 "ちょさく": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "ちょさくか": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "ちょさくけん": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "ちょさくけんしようりょう": "مَلَكِيَّة",
 "ちょさくけんしんがい": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "ちょさくけんしんがいそしょう": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "ちょさくしゃ": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "ちょさくしゅう": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "ちょさくぶつ": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "ちょざい": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب) / خشب ميت (فرع أو جزء من شجرة ميت) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ちょしゃ": "مُؤَلِّف, مُصَنِّف / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "ちょしょ": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "ちょしょく": "اِكْتِنَاز",
 "ちょじゅつ": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "ちょじゅつか": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "ちょす": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)",
 "ちょすいじょう": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "ちょすいそう": "خزان المرحاض, سيفون (خزان يحمل الماء المستخدم في شطف المرحاض)",
 "ちょすいち": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "ちょすいとう": "خَزَّانُ مَاء",
 "ちょぞう": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / اِكْتِنَاز",
 "ちょぞうこ": "مخزن, مستودع (مستودع للبضائع)\nمثال: بُنيت المستودعات بالقرب من الأرصفة",
 "ちょぞうしつ": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "ちょぞうひん": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "ちょぞうぶつ": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "ちょぞうタンク": "خزان, صهريج (وعاء كبير (معدني عادة) لحفظ الغازات أو السوائل)",
 "ちょちく": "تحويشة العمر, مدخرات (صندوق من المال يتم ادخاره كاحتياطي)",
 "ちょちくぎんこう": "مَصْرِفُ اِدِّخَار, بَنْكُ اِدِّخَار (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات)\nمثال: عدن إلى المصرف.",
 "ちょちくさいけん": "سند ادخار (سند حكومي غير قابل للتداول؛ لا يمكن شراؤه وبيعه بمجرد الشراء الأصلي)",
 "ちょちょい": "بِسُهُولَة",
 "ちょちょいのちょい": "بَسِيطَة, لُقْمَة سَائِغَة",
 "ちょっ": "يَاه, اسمع / هَلَا",
 "ちょっかい": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة) / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "ちょっかく": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ) / زَاوِيَة قَائِمَة",
 "ちょっかくさんかくけい": "مثلث قائم الزاوية (مثلث به زاوية قائمة واحدة)",
 "ちょっかくさんかっけい": "مثلث قائم الزاوية (مثلث به زاوية قائمة واحدة)",
 "ちょっかくしゅぎ": "حدسية ((فلسفة) المذهب القائل بأن المعرفة تُكتسب في المقام الأول عن طريق الحدس)",
 "ちょっかくてき": "بَدِيهِيٌّ",
 "ちょっかつしょくみんち": "مستعمرة التاج (مستعمرة بريطانية يسيطر عليها التاج البريطاني، يمثلها حاكم)",
 "ちょっかん": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ) / اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "ちょっかんしゅぎ": "حدسية ((فلسفة) المذهب القائل بأن المعرفة تُكتسب في المقام الأول عن طريق الحدس)",
 "ちょっかんてき": "بَدِيهِيٌّ",
 "ちょっかんりょく": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ)",
 "ちょっきゅう": "مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "ちょっきゅうしょうぶ": "معاملة عادلة (معاملة منصفة)",
 "ちょっきょ": "مرسوم ملكي, ميثاق ملكي (ميثاق ممنوح من قبل السيادة (خاصة في بريطانيا العظمى))",
 "ちょっきり": "بِالضَّبْط, تَمَامًا / بِالْضَبْط / قصاصة, قُصاصة (عملية القص أو القصقصة) / قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "ちょっきん": "آخِرُ مَا صَدَرَ, أَحْدَث (مواكب للحاضر المباشر؛ الأكثر حداثة) / رَائِج, عَلَى المُوضَة (وَفْقًا لِلمُوضَة أَوِ الأُسْلُوب السَّائِد حَالِيًّا) / آخر الأخبار, مستجدات (أحدث الأخبار أو التطورات)\nمثال: هل سمعت آخر الأخبار؟ / عضلة مستقيمة (أي من العضلات المستقيمة المختلفة)",
 "ちょっくら": "قَلِيلًا",
 "ちょっけい": "قُطْر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر.",
 "ちょっこう": "قَائِمُ الزَّوَايَا, مُتَعَامِد (لَهُ مَجْمُوعَةُ مَحَاوِرَ مُتَعَامِدَة؛ يَلْتَقِي بِزَوَايَا قَائِمَة) / مُتَعَامِدٌ إِحْصَائِيًّا (غير مرتبط إحصائياً) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث)",
 "ちょっこうざひょう": "إِحْدَاثِيّ دِيكَارْتِيّ (أحد الإحداثيات في نظام يحدد نقطة في مستوى أو فراغ عبر بعدها عن خطين أو ثلاثة مستويات على التوالي؛ الخطان أو تقاطعات المستويات الثلاثة هي محاور…)",
 "ちょっこうせい": "قَائِمُ الزَّوَايَا, مُتَعَامِد (لَهُ مَجْمُوعَةُ مَحَاوِرَ مُتَعَامِدَة؛ يَلْتَقِي بِزَوَايَا قَائِمَة) / مُتَعَامِدٌ إِحْصَائِيًّا (غير مرتبط إحصائياً) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث)",
 "ちょっこうびん": "رحلة مباشرة (رحلة مع توقف وسيط واحد أو أكثر ولكن بدون تغيير الطائرة)",
 "ちょっこり": "قَلِيلًا",
 "ちょっこん": "جِذْر وَتَدِيّ, جَذْر وَتَدِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ちょっち": "قَلِيلًا",
 "ちょっと": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بِسُهُولَة",
 "ちょっとした": "طَفِيف / كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "ちょっとずつ": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة",
 "ちょっとみ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "ちょっとむずかしい": "قَلِيلًا",
 "ちょっとやそっと": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "ちょっと見": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "ちょっと難しい": "قَلِيلًا",
 "ちょっぱや": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)\nمثال: أنهت المهمة في لمح البصر",
 "ちょっぱる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ちょと": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بِسُهُولَة",
 "ちょとう": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ちょとうそう": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ちょとつ": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "ちょびっと": "قَلِيلًا",
 "ちょびと": "قَلِيلًا",
 "ちょぼ": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط",
 "ちょぼくじょう": "ساحة أخشاب, مستودع أخشاب (مكان عمل يتم فيه تخزين الأخشاب للبيع)",
 "ちょぼちょぼ": "بشكل متناثر, بكثافة قليلة (بطريقة متفرقة وغير كثيفة)\nمثال: مأهولة بشكل متناثر",
 "ちょま": "قُنَّبُ سِيَام",
 "ちょめい": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\") / مَشْهُور (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور. / صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "ちょめいじん": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "ちょめちょめ": "بيب, صفير (نغمة عالية قصيرة تصدر كإشارة أو تحذير)",
 "ちょゆう": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "ちょりっす": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / مَفْهُوم",
 "ちょりゅう": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة)",
 "ちょりーす": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / مَفْهُوم",
 "ちょりーっす": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / مَفْهُوم",
 "ちょれー": "غَبِيّ / غَبِيّ, أَحْمَق",
 "ちょろい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ちょろちょろ": "تقاطر, تنقيط (التدفق على شكل قطرات؛ تشكل وسقوط قطرات من السائل)\nمثال: هناك تقاطر عبر السقف / خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "ちょろっと": "بِسُرْعَة, عَاجِلًا / باندفاع, بتهور (بطريقة متسرعة ومتهورة)\nمثال: وقع في حب ابنة عمه باندفاع",
 "ちょろまかす": "جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "ちょろり": "بِسُرْعَة, عَاجِلًا / باندفاع, بتهور (بطريقة متسرعة ومتهورة)\nمثال: وقع في حب ابنة عمه باندفاع",
 "ちょろん": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "ちょろイン": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة) / سَطْحِيُّ التَّفْكِير (يفتقر إلى الدقّة والبصيرة في الفهم)",
 "ちょん": "تَصْفِيق / صَفَّق / صَفَّقَ / النِهاية / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط",
 "ちょんぎる": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "ちょんちょん": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "ちょんになる": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "ちょんのま": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت. / ترقيع سريع, حل مؤقت (إصلاح متعجل) / قَلِيلًا",
 "ちょんの間": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت. / ترقيع سريع, حل مؤقت (إصلاح متعجل) / قَلِيلًا",
 "ちょんぼ": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "ちょん切る": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "ちょー": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "ちょーだい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "ちよ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ちよよろずよ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ちらし": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة) / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "ちらす": "نَثَرَ, تَفَرَّقَ / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / أَلْهَى",
 "ちらちら": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب) / لمحة, نظرة خاطفة (نظرة سريعة) / بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ちらっとみる": "لمحة, نظرة خاطفة (نظرة سريعة) / لمحة, نظرة خاطفة (رؤية موجزة أو غير كاملة) / لمحة (إشارة غامضة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "ちらっと見る": "لمحة, نظرة خاطفة (نظرة سريعة) / لمحة, نظرة خاطفة (رؤية موجزة أو غير كاملة) / لمحة (إشارة غامضة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "ちらつかせる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "ちらつき": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "ちらつく": "وَمِيض, وَمْضَة / طَرْفَة, وَمْضَة / رَفْرَفَ, خفَقَ",
 "ちらばら": "هُنَا وَهُنَاكَ",
 "ちらほら": "هُنَا وَهُنَاكَ / أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "ちらり": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
 "ちらりほらり": "هُنَا وَهُنَاكَ / أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً / دُوَّامَة",
 "ちり": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة. / زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات / جُغْرَافِيَا (هو عِلْم يدرس الأرض والظواهر الطبيعية والبشرية عليها والعلاقات بينهم؛ معتمدا على مناهج علمية كالوصف والتفسير والتعميم)\nمثال: كانت لديهم معارف محدودة في الجغرافيا. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "ちりあくた": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها)",
 "ちりがく": "جُغْرَافِيَا (هو عِلْم يدرس الأرض والظواهر الطبيعية والبشرية عليها والعلاقات بينهم؛ معتمدا على مناهج علمية كالوصف والتفسير والتعميم)\nمثال: كانت لديهم معارف محدودة في الجغرافيا.",
 "ちりがくしゃ": "جُغْرَافِيّ, جُغْرَافِيَّة",
 "ちりがみ": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "ちりくうかん": "جيومكانيّ / جيومكانيَّة",
 "ちりし": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "ちりじょうほうシステム": "نظام المعلومات الجغرافية (نظام معلومات للمعلومات الجغرافية)\nمثال: تم تطبيق هذا المشغل على تطبيق نظم المعلومات الجغرافية للهواتف المحمولة",
 "ちりじり": "مُتَفَرِّق",
 "ちりちり": "شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / بشكل مؤلم, بشكل محزن (بشكل غير سار) / بألم, بوجع (في حالة ألم أو كما لو كان متألماً)\nمثال: كان جهله واضحاً بشكل مؤلم",
 "ちりぢり": "مُتَفَرِّق",
 "ちりつく": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد) / نَمِلَ\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "ちりづか": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "ちりてき": "جغرافي (محدد بواسطة الجغرافيا) / جغرافي (من أو يتعلق بعلم الجغرافيا)\nمثال: القطبان الجغرافيان الشمالي والجنوبي",
 "ちりとり": "مِجْرَفَة, مَجْرُود",
 "ちりはらい": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "ちりばめる": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها)",
 "ちりほこり": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "ちりほど": "قَلِيلًا",
 "ちりめん": "كريب (قماش خفيف ناعم ورقيق ذو سطح مجعد) / فطيرة فرنسية رقيقة, كريب (فطيرة صغيرة رقيقة جداً) / ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "ちりめんがみ": "ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "ちりめん紙": "ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "ちりゃく": "إدارة, حكم (فعل الحكم؛ ممارسة السلطة) / إدارة, المؤسسة (الأشخاص (أو اللجان أو الأقسام وما إلى ذلك) الذين يشكلون هيئة لغرض إدارة شيء ما)\nمثال: لوائح لحكم سجون الولاية / مَوْرِد",
 "ちりょ": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "ちりょう": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "ちりょうしゃ": "المعالج",
 "ちりょうてきりゅうざん": "إجهاض علاجي (إجهاض مفتعل قانونياً لأسباب طبية (مثل تهديد حياة الأم))",
 "ちりょうてきクローニング": "استنساخ طبي حيوي, استنساخ علاجي (زرع نووي لخلايا المريض نفسه لصنع خلية بيضية يمكن منها استخلاص خلايا متوافقة مناعياً (خاصة الخلايا الجذعية) للزرع)",
 "ちりょうひ": "نفقة طبية (المبلغ المنفق لتشخيص أو علاج أو الوقاية من المشاكل الطبية)",
 "ちりょうふかのう": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ちりょうふのう": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ちりょうほう": "شِفَاء / شَفَى",
 "ちりょうやく": "عِلَاج, تِرْيَاق / تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "ちりょく": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "ちりんちりん": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن) / خشخشة, رنين (صوت معدني)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "ちり取り": "مِجْرَفَة, مَجْرُود",
 "ちり払い": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "ちり紙": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "ちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / نَثَرَ, تَفَرَّقَ / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "ちるい": "كتلة ناتئة, هورست (حيد من القشرة الأرضية تم دفعه للأعلى بين صدعين ويكون أعلى من الأرض المحيطة)",
 "ちれきせい": "أَسْفَلْت, زِفْت",
 "ちろちろ": "وَمِيض, وَمْضَة / طَرْفَة, وَمْضَة / رَفْرَفَ, خفَقَ / تقاطر, تنقيط (التدفق على شكل قطرات؛ تشكل وسقوط قطرات من السائل)\nمثال: هناك تقاطر عبر السقف",
 "ちわ": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "ちわっ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "ちわっす": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "ちわぶみ": "رِسَالَةُ حُبٍّ",
 "ちわー": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "ちをながす": "سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "ちん": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / رنين (صوت رنين) / صوت الإوز, فحيح (صوت الإوزة (أو أي صوت يشبه هذا)) / مَوْجَة الْمَيْكْرُووِيف, مَوْجَة دَقِيقَة / قَضِيب, ذَكَر / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / نَادِر / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / سبانييل ياباني (سلالة من كلاب الزينة نشأت في اليابان لها معطف حريري أسود وأبيض أو أحمر وأبيض) / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / مَدِينَة, قَرْيَة / عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة / أَجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / اِسْتَخْدَمَ, شَغَّلَ (عَمِلَ بالشيء، اِسْتَعْمَلَه؛ اِتَّخَذَ الشخصَ خَادِمًا عنده)\nمثال: ركبت سيارة أجرة.",
 "ちんあげ": "زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب)\nمثال: حصل على علاوة بنسبة 3٪",
 "ちんあつ": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة",
 "ちんうつ": "سَوْدَاوِيَّة",
 "ちんか": "غَرَق / إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "ちんかこう": "عمل بالقطعة (عمل يُدفع أجره وفقاً للكمية المنتجة)",
 "ちんがい": "مضاد للسعال (أي دواء يستخدم لقمع أو تخفيف السعال)",
 "ちんがし": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول)",
 "ちんがり": "استئجار (فعل الدفع مقابل استخدام شيء ما (مثل شقة أو منزل أو سيارة))",
 "ちんき": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي / ثَمِين",
 "ちんきん": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "ちんぎん": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ちんぎんとうけつ": "تجميد الأجور (تجميد الأجور عند مستوى معين)",
 "ちんぎんりつ": "معدل الأجر (مبلغ المال المستلم لكل وحدة زمنية)\nمثال: معدل أجور النساء أقل من الرجال",
 "ちんぎんろうどうしゃ": "كاسب, متكسب (شخص يكسب أجراً مقابل عمله)",
 "ちんくしゃ": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "ちんけ": "تَافِه, رَخِيص (رديء الجودة جدًا؛ هَشّ)",
 "ちんけい": "حَل التشنج (استرخاء أو تخفيف تشنجات العضلات) / حال للتشنج, مضاد للتشنج (دواء يستخدم لتخفيف أو منع التشنجات (خاصة العضلات الملساء))",
 "ちんけいざい": "دواء مضاد للاختلاج, مضاد اختلاج (دواء يستخدم لعلاج أو منع التشنجات (كما في الصرع))",
 "ちんけいやく": "دواء مضاد للاختلاج, مضاد اختلاج (دواء يستخدم لعلاج أو منع التشنجات (كما في الصرع))",
 "ちんげ": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "ちんこ": "قَضِيب, ذَكَر / تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "ちんこう": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى) / انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته) / ترسب, ترييح (غوص تدريجي إلى مستوى أدنى) / انحسار, هجوع (انخفاض في الشدة أو الدرجة (كما في أعراض المرض))\nمثال: سرطانه في حالة هجوع",
 "ちんこつ": "سندان (عظم صغير في الأذن الوسطى يقع بين المطرقة والركاب)",
 "ちんころ": "سبانييل ياباني (سلالة من كلاب الزينة نشأت في اليابان لها معطف حريري أسود وأبيض أو أحمر وأبيض) / رمية البداية (فعل بدء لعبة كرة السلة بكرة قفز) / إخبارية, معلومة سرية (معلومات داخلية بأن شيئاً ما سيحدث)",
 "ちんこんか": "ريكويم, قداس الموتى (قداس يقام للموتى) / ريكويم, قداس الموتى (إعداد موسيقي لقداس الاحتفال بالموتى) / جنائزية, رثاء (أغنية أو ترنيمة حداد تؤلف أو تؤدى كذكرى لشخص ميت)",
 "ちんこんきょく": "ريكويم, قداس الموتى (قداس يقام للموتى) / ريكويم, قداس الموتى (إعداد موسيقي لقداس الاحتفال بالموتى) / جنائزية, رثاء (أغنية أو ترنيمة حداد تؤلف أو تؤدى كذكرى لشخص ميت)",
 "ちんこんきょくか": "ريكويم, قداس الموتى (قداس يقام للموتى) / ريكويم, قداس الموتى (إعداد موسيقي لقداس الاحتفال بالموتى) / جنائزية, رثاء (أغنية أو ترنيمة حداد تؤلف أو تؤدى كذكرى لشخص ميت)",
 "ちんご": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "ちんさ": "رَاسِب / إقدام, عزيمة (الثبات والتصميم) / جريت, حجر رملي خشن (حجر رملي سيليسي خشن الحبيبات صلب)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "ちんさい": "طقس ديني, مراسم دينية (احتفال ذو معنى ديني)",
 "ちんさげ": "خفْض الراتب (عملية تقليل الراتب)",
 "ちんざ": "أَقَامَ, سَكَنَ (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "ちんし": "تَفَكُّر / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / مَدِينَة, قَرْيَة",
 "ちんしごと": "عمل بالقطعة (عمل يُدفع أجره وفقاً للكمية المنتجة)",
 "ちんしゃ": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير / أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "ちんしゃく": "استئجار (فعل الدفع مقابل استخدام شيء ما (مثل شقة أو منزل أو سيارة))",
 "ちんしゃくにん": "رئيس, مسؤول التوظيف (شخص مسؤول عن توظيف العمال)\nمثال: وظف الرئيس ثلاثة رجال آخرين للعمل الجديد",
 "ちんしょうえん": "حديقة غائرة (حديقة تقع تحت مستوى الأرض المحيطة بها)",
 "ちんじ": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "ちんじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "ちんじゅつ": "تَصْرِيح, بَيَان",
 "ちんじゅつしょ": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "ちんじょう": "عَرِيضَة, طَلَب",
 "ちんじょうしゃ": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / طالب الانتصاف, مقدم الالتماس (شخص يلتمس من المحكمة رفع مظلمة أو استرداد حق)\nمثال: مستعطف لرضاها",
 "ちんじょうしょ": "عَرِيضَة, طَلَب",
 "ちんじょうだん": "جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من خلال الضغط)",
 "ちんじょうようがん": "لابة وسادية (حمم تصلبت في أشكال مستديرة توحي بالوسائد؛ يعتقد أنها ناتجة عن ثورات تحت الماء)",
 "ちんする": "مَوْجَة الْمَيْكْرُووِيف, مَوْجَة دَقِيقَة",
 "ちんせい": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل / تخدير, تهدئة (إعطاء مهدئ أو دواء مخدر) / تخدير, تهدئة (حالة من انخفاض الإثارة أو القلق يتم تحفيزها عن طريق إعطاء عامل مهدئ) / زُحَل (سادس كوكب في المجموعة الشمسية) / سَاتُورْن\nمثال: زحل كوكب كبير جدا.",
 "ちんせいざい": "مُهَدِّئ, مُسَكِّن",
 "ちんせき": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى) / أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "ちんせきがん": "صَخْر رُسُوبِيّ",
 "ちんせきぶつ": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "ちんせん": "تَفَكُّر / جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "ちんたい": "رُكُود / ركود اقتصادي / عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول)",
 "ちんたいしゃく": "استئجار (فعل الدفع مقابل استخدام شيء ما (مثل شقة أو منزل أو سيارة))",
 "ちんたいしゃくけいやく": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول)",
 "ちんたいにん": "مؤجّر (شخص يمنح عقد إيجار)",
 "ちんたいりょう": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "ちんたいりょうきん": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "ちんたら": "ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء / لَا تَهْتَم (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ちんだい": "حَامِيَة",
 "ちんだん": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "ちんちくりん": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "ちんちゃく": "اتزان, رباطة جأش (ثبات العقل تحت الضغط)\nمثال: تقبل مشاكلهم برباطة جأش وهي باتزان / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "ちんちゃこい": "صَغِير, صغير",
 "ちんちゅうのちん": "عُمْلَة نَادِرَة, نَادِرَة (شخص نادر أو فريد من نوعه)",
 "ちんちょう": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / عُمْلَة نَادِرَة, نَادِرَة (شخص نادر أو فريد من نوعه)",
 "ちんちろりん": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ",
 "ちんちん": "قَضِيب, ذَكَر / غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي) / حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف. / صَامِت, سَاكِت",
 "ちんちんかも": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "ちんちんかもかも": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي)",
 "ちんちんでんしゃ": "تْرَام, تْرَامْوَاي",
 "ちんちんなる": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن) / خشخشة, رنين (صوت معدني)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "ちんちん電車": "تْرَام, تْرَامْوَاي",
 "ちんちん鳴る": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن) / خشخشة, رنين (صوت معدني)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "ちんつう": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري. / تسكين الألم",
 "ちんつうざい": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "ちんつうせい": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "ちんつうやく": "مسكن ألم (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "ちんてい": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "ちんでい": "غَرِين",
 "ちんでん": "تَسَاقُط, هُطُول / تَرَسُّب / عجلة",
 "ちんでんざい": "مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ) / مادة مرسبة, مرسب (عامل يسبب تشكل راسب)",
 "ちんでんぶつ": "رَاسِب",
 "ちんと": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "ちんとう": "جانب السرير (المساحة بجانب السرير (خاصة سرير المريض أو المحتضر))\nمثال: وقف الطبيب بجانب سريرها / بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "ちんどう": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "ちんどうぐ": "جِهَاز",
 "ちんなん": "حَلَزُون",
 "ちんにゅう": "تَطَفُّل, مُدَاخَلَة",
 "ちんにゅうしゃ": "مُقْتَحِم, دَخِيل",
 "ちんば": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية)) / عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)\nمثال: كاتب مشهور بركاكة حبكاته",
 "ちんぴら": "بلطجي, سفاح (مجرم شاب عدواني وعنيف) / ثَانَوِيّ, صَغِير (ذو أهمّيّة ضئيلة) / براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "ちんぴん": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "ちんぶ": "تَهْدِئَة, مُكَافَحَة التَمَرُّد (إجراءات تتخذها الحكومة لهزيمة التمرد) / تسكين, تهدئة (فعل استرضاء شخص ما أو جعله أكثر ميلاً للموافقة) / سلام, معاهدة سلام (معاهدة لوقف الأعمال العدائية)\nمثال: حل السلام في 11 نوفمبر",
 "ちんぶんかん": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل)",
 "ちんぷ": "بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "ちんぷか": "بطلان, تقادم (عملية التحول إلى شيء عفا عليه الزمن؛ الوقوع في طي الإهمال أو التقادم)\nمثال: سياسة التقادم المخطط له",
 "ちんぷんかん": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل)",
 "ちんぷんかんぷん": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل)",
 "ちんべん": "دِفَاع, حِمَايَة / دِفاع",
 "ちんぼ": "قَضِيب, ذَكَر",
 "ちんぼこ": "قَضِيب, ذَكَر",
 "ちんぼつ": "غَرَق",
 "ちんぽ": "قَضِيب, ذَكَر",
 "ちんぽこ": "قَضِيب, ذَكَر",
 "ちんまり": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام",
 "ちんみ": "خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها",
 "ちんみょう": "كْوِير",
 "ちんむるい": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "ちんもく": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري)",
 "ちんもくかげん": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "ちんもくはきんゆうべんはぎん": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "ちんりつ": "معدل الأجر (مبلغ المال المستلم لكل وحدة زمنية)\nمثال: معدل أجور النساء أقل من الرجال",
 "ちんりょう": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "ちんれつ": "مَعْرِض",
 "ちんれつしつ": "صالة عرض, معرض (منطقة يمكن فيها عرض البضائع (مثل السيارات))",
 "ちんれつだな": "خزانة عرض, فاترينة (حاوية زجاجية تستخدم لتخزين وعرض العناصر في متجر أو متحف أو منزل)",
 "ちんれつとう": "مَعْرِض, صَالَةُ عَرْض",
 "ちんれつひん": "مَعْرُوض",
 "ちんれつまど": "شُبَّاك, فَاتْرِينَة",
 "ちん入": "تَطَفُّل, مُدَاخَلَة",
 "ちん毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "ちーっす": "يَاه, اسمع / هَلَا",
 "ちーん": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / رنين (صوت رنين) / صوت الإوز, فحيح (صوت الإوزة (أو أي صوت يشبه هذا)) / مَوْجَة الْمَيْكْرُووِيف, مَوْجَة دَقِيقَة",
 "ぢ": "بَاسُور / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ぢゅう": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق. / دَاخِل / في غضون (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / فِي خِلَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / جَمِيع أَنْحَاء, كُلّ / كُلّ, جَمِيع",
 "ぢょうし": "مِلْقَط صَغِير, مِلْقَط",
 "ぢょうじゃく": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "ぢりぢり": "بِبُطْء / بفارغ الصبر, بنافذ الصبر (مع نفاد صبر؛ بطريقة غير صبورة)\nمثال: أجابها بفارغ الصبر / أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة)",
 "っきゃ": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "っきり": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُنْذُ / لِأَنَّ / باستمرار",
 "っけ": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "っこ": "مُسَابَقَة",
 "っす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ったい": "وَدَّ (تمنى ورجا؛ أراد شيئا)\nمثال: السيدة وود طباخة جيدة.",
 "ったら": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛ / لِمَ لَا (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "っちゅう": "مَعْنًى / الْمَعْنَى",
 "っつ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "っつう": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "っつー": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "って": "طَبْعًا",
 "っていう": "مَعْنًى / الْمَعْنَى",
 "ってぇ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "ってえ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "ってことは": "أي, تحديداً (كما يلي (تستخدم للتفصيل))",
 "ってのは": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة",
 "ってば": "على فِكْرَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "って言う": "مَعْنًى / الْمَعْنَى",
 "っぱ": "ذهاب, رحيل (فعل المغادرة) / باستمرار",
 "っぱぐれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "っぱなし": "ذهاب, رحيل (فعل المغادرة) / باستمرار",
 "っぷり": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "っぽい": "ـِيّ",
 "っぽち": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / قَلِيلًا",
 "っ放し": "ذهاب, رحيل (فعل المغادرة) / باستمرار",
 "っ気": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "つ": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة) / تْسُو / مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع) / مُعَدِّيَة, عَبَّارَة / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "つい": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً / عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري. / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / أَبَدًا",
 "ついえる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "ついおく": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "ついか": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ついかい": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة",
 "ついかがく": "إكسسوار, تكملة (مكون إضافي يحسن القدرة أو الأداء) / إضافة, تحسين (مكون يضاف إلى شيء لتحسينه) / إضافة برمجية, مكون إضافي (وحدة برمجية تعمل على توسيع أو تعزيز قدرات تطبيق موجود)\nمثال: كانت إضافة الحمام تحسيناً كبيراً",
 "ついかさくじょ": "تَنْقِيح / تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "ついかせっしゅ": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى)",
 "ついかてき": "إِضَافِيّ (إِضافيّ : ما يُضاف ، ما يُزاد؛ ما يُتْبَع شيئاً آخر ، ما يُلْحَق به ، ما يُزاد على الأصل)\nمثال: ستعطيني بطانية إضافية.",
 "ついかんこうきょうさく": "قناة شوكية, قناة فقرية (القناة في الفقرات المتعاقبة التي يمر عبرها الحبل الشوكي)",
 "ついかんばん": "ديسك, قرص بين الفقرات (قرص غضروفي ليفي يعمل كوسادة بين فقرات العمود الفقري)",
 "ついき": "مُلَاحَظَة / إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ついきゅう": "تَحْقِيق / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه)\nمثال: كانت تقود بشكل جيد لكن تجاوزها المتهور لكل سيارة على الطريق أخافني / مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "ついく": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "ついけい": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "ついげき": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "ついこう": "مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص) / تسلية, هواية (ترفيه يشغل وقت المرء وأفكاره (عادة بشكل ممتع)) / هواية (نشاط إضافي أو جانبي) / بحث, سعي (بحث عن بديل يلبي معايير معرفية)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "ついこつ": "فَقَرَة / عُظيمة المطرقة",
 "ついこつどうみゃく": "شريان فقري (الفرع الأول للشريان تحت الترقوة؛ مقسم إلى أربعة أجزاء)",
 "ついご": "عَكْس / نَقِيض",
 "ついごう": "اقتران, تشابك (الاقتران جنباً إلى جنب للكروموسومات المتماثلة للأم والأب في بداية الانقسام المنصف) / التفاف, انطواء (عملية لف شيء ما) / أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة) / اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "ついさっき": "آنِفاً",
 "ついし": "إعادة إنتاج, استنساخ (فعل عمل نسخ) / تكرار التجربة (تكرار تجربة لاختبار صحة استنتاجها) / مجسم, نسخة مطابقة (نسخة ليست الأصل؛ شيء تم نسخه) / تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير",
 "ついしゅつ": "إفراز, انبعاث (أي من العمليات الجسدية العديدة التي تخرج بموجبها المواد من الجسم)\nمثال: خروج الصديد",
 "ついしょう": "تملق, نفاق (ثناء مفرط أو غير صادق) / طَارَدَ",
 "ついしょうしゃ": "ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "ついしょうめつ": "إِفْنَاء, تَدْمِير / إِفْنَاء",
 "ついしん": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "ついじゅう": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ついじゅうしゃ": "تَابِع / مُتَابِع",
 "ついじゅく": "انقطاع الطمث, سن اليأس (الوقت في حياة المرأة الذي تنتهي فيه الدورة الشهرية) / إياس, سن اليأس للرجال (فترة في حياة الرجل تقابل سن اليأس)",
 "ついす": "مَاثَلَ / راسَلَ",
 "ついずい": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ついずいしゃ": "شماس مساعد, مساعد الكاهن (شخص يساعد الكاهن أو القس في الخدمة الليتورجية؛ رجل دين مرسوم في أعلى الرتب الصغرى في الكنيسة الكاثوليكية الرومانية)",
 "ついずいせい": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "ついずいをゆるさない": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "ついせいせい": "إنتاج الزوج (تحول فوتون أشعة جاما إلى إلكترون وبوزيترون عندما يمر الفوتون بالقرب من نواة ذرية)",
 "ついせき": "طَارَدَ / تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما) / رسم تتبعي, شف (فعل رسم مخطط أو تصميم أو مسودة عن طريق الشف) / رسم شفاف, شف (رسم تم إنشاؤه بوضع ورقة نصف شفافة على الصورة الأصلية ونسخ خطوط الصورة الأصلية عليها)\nمثال: تتبع الأنساب",
 "ついせきしゃ": "مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد) / سَاعٍ, طَالِب (شخص يسعى وراء خطة أو هدف)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "ついせきちょうさ": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "ついせきプログラム": "برنامج تتبع (برنامج خدمي يعرض تسلسل ونتائج تنفيذ التعليمات في برنامج آخر)",
 "ついそう": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استرجاع, تذكر (القدرة على استدعاء الأحداث الماضية) / استذكار, ذكرى مستعادة (شيء تم استدعاؤه إلى الذهن)\nمثال: لديه استدعاء كامل للحلقة / طَارَدَ",
 "ついぞ": "أَبَدًا",
 "ついちょう": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "ついちょうきん": "رسم إضافي (رسم إضافي (كما هو الحال بالنسبة للعناصر التي تم حذفها سابقاً أو كعقوبة لعدم ممارسة الحذر العام أو المهارة العامة))",
 "ついつい": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "ついていく": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ついていける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "ついている": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "ついてくる": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "ついては": "التَّالِي فِي التَّسَلْسُل, فِي الدَّوْر (يأتي تاليًا في تسلسل الخلافة أو التوالي) / بالصف, في طابور (واحد خلف الآخر في خط أو طابور) / عَلَى قَائِمَةِ الِانْتِظَار, فِي الطَّابُور (في انتظار شيء ما؛ خاصة شيء مستحقّ)\nمثال: انتظروا في طابور للتذاكر",
 "ついてまわる": "تَمَسَّكَ",
 "ついてゆく": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ついてる": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "ついて回る": "تَمَسَّكَ",
 "ついて行く": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ついで": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / فُرْصَة / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "ついでながら": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "ついでに": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ついと": "فَجْأَةً",
 "ついとう": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل.",
 "ついとうのじ": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "ついとうひ": "نُصْب / نُصْب تَذْكَارِيّ",
 "ついどう": "نَفَق",
 "ついに": "أَخِيراً / أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "ついにん": "إبرام, تصديق (جعل الشيء ساري المفعول عن طريق التصديق عليه أو تأكيده رسميًا)\nمثال: المصادقة على المعاهدة",
 "ついはく": "مُلَاحَظَة",
 "ついび": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ついふくきょく": "الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد",
 "ついほ": "ملحق / مُكَمِّل",
 "ついほう": "نَفْي, تَبْعِيد / نَفَى / حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "ついほうしゃ": "نَفْي, تَبْعِيد / نَفَى",
 "ついまつ": "مَشْعَل / شُعْلَة",
 "ついまひ": "شلل سفلي (شلل النصف السفلي من الجسم)",
 "ついやす": "أَنْفَقَ, صَرَفَ / قَضَى / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / توفر على, صرف همته إلى",
 "ついらく": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "ついれん": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "ついろく": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "つう": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة. / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / قدرة سحرية (القدرة على أداء السحر) / أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟ / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "つううん": "نَقْل, نَقْلِيَّات",
 "つうえんバス": "حَضَانَة, رَوْضَة",
 "つうか": "عُمْلَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة. / مُرُور / عُبُور / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "つうかい": "مُبْهِج, مُنْعِش (يُضفي الحيوية والبهجة) / مُبْهِج, مُحَفِّز (يجعل النفس حيّة ومبتهجة) / تَفْسِير, شَرْح / توبة, ندامة (الأسى على الخطيئة الناشئ عن الخوف من العقاب)",
 "つうかきょうきゅうりょう": "الكتلة النقدية, عرض النقود (إجمالي مخزون المال في الاقتصاد؛ العملة التي يحتفظ بها الجمهور بالإضافة إلى الأموال في الحسابات المصرفية)",
 "つうかぎれい": "طَقْس الْعُبُور",
 "つうかくいきち": "عتبة الألم (أقل شدة للتحفيز التي يتم عندها الشعور بالألم)\nمثال: يتمتع بعض الناس بعتبات ألم أعلى بكثير من غيرهم",
 "つうかしゃ": "مَارّ, مَارَّة",
 "つうかしゅくしょう": "انْكِماش (ثَوْبٌ سَرِيعُ الانْكِمَاشِ : سَرِيعُ الالْتِوَاءِ؛ اِنْكِمَاشُ مَخَالِبِ الأسَدِ : دُخولُها)",
 "つうかたんい": "عملة, وحدة نقدية (وحدة للمال)",
 "つうかてん": "حَاجِز, نُقْطَة تَفْتِيش",
 "つうかはっこうえき": "رسم سك العملة (رسم تفرضه الحكومة لسك السبائك)",
 "つうかはんてい": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
