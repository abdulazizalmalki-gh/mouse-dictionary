 "ていりつせん": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "ていりゅう": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني)",
 "ていりゅうこうがん": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "ていりゅうしょ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ていりゅうじょ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ていりゅうじょう": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ていりゅうせいそう": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "ていりゅうそち": "تَوْقِيف",
 "ていりょうてき": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس)\nمثال: تصدير القمح دون قيود كمية",
 "ていりょうぶんせき": "تحليل كمي, تحليل كيميائي كمي (تحليل كيميائي لتحديد كميات كل عنصر في المادة)",
 "ていれ": "اِهْتِمَام / مُدَاهَمَة",
 "ていれい": "عَادِيّ / سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)\nمثال: افتقد لزوجته السابقة.",
 "ていれつ": "جودة منخفضة, دونية (جودة متدنية)",
 "ていれん": "رَخِيص",
 "ていカリウムけつしょう": "نقص بوتاسيوم الدم (مستوى منخفض بشكل غير طبيعي للبوتاسيوم في الدم المتداول مما يؤدي إلى الضعف…)",
 "ていレベル": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "ていレベルほうしゃせいはいきぶつ": "نفايات مشعة منخفضة المستوى ((طب) نفايات مشعة تتكون من أشياء تعرضت للإشعاع لفترة وجيزة (كما في بعض الفحوصات…)",
 "てうす": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "てうち": "صُلْح, مُصَالَحَة / طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "てえ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "ておい": "جَرِيح",
 "ておけ": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى)",
 "ておしぐるま": "عربة دفع, عربة يدوية (مركبة بعجلات يمكن دفعها بواسطة شخص؛ قد يكون لها عجلة واحدة أو عجلتان أو أربع…)\nمثال: استخدم عربة يدوية لنقل الصخور بعيداً",
 "ておち": "سهو, غفلة (خطأ ناتج عن عدم الانتباه)",
 "ておの": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / قَدُوم (قُدُوْم؛ قَدُوْم)\nمثال: بإمكانك القدوم معي.",
 "ており": "مَنْسُوجٌ يَدَوِيًّا (منسوج على نول يدوي)",
 "てか": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "てかがみ": "نَمُوذَج",
 "てかけ": "مِقْبَض / سَيِّدَة",
 "てかけおんな": "سَيِّدَة",
 "てかげん": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "てかご": "سلة (حاوية عادة ما تكون منسوجة ولها مقابض)",
 "てかし": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار",
 "てかず": "مُشْكِلَة, مَتاعِب",
 "てかせ": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار",
 "てかせあしかせ": "أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "てかてか": "بَرَّاق, مُتَأَلِّق (يَلْمَع بِبَرِيقٍ ثَابِتٍ وَلَكِنْ هَادِئ)",
 "てかり": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "てかる": "بريق, بصيص (مظهر لضوء منعكس)",
 "てがかり": "خيط دليل, قرينة (دليل يساعد على حل مشكلة) / مقبض, موطئ يد (ملحق للإمساك به)",
 "てがき": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / مَكْتُوبٌ بِخَطِّ اليَد (كُتِب باليد لا بالطباعة)",
 "てがける": "مِقْبَض / خَلْفِيّ",
 "てがし": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار",
 "てがせ": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار",
 "てがた": "مُسْوَدَّة / أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "てがたい": "سليم\nمثال: اقرأ بصوت عالي. / ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "てがたこうかんじょ": "غرفة المقاصة (مكان مركزي للتجميع حيث تتبادل البنوك الشيكات أو الحوالات؛ ويحتفظ المشاركون…)",
 "てがたちどり": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة)",
 "てがつけられない": "منفلت من عقاله",
 "てがでる": "لَكْمَة أَمَامِيَّة",
 "てがはなせない": "مَشْغُول",
 "てがみ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "てがみばくだん": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "てがら": "إِنْجَاز",
 "てがる": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "てがるい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "てがわるい": "فَقِير / عديم الضمير, متجرد من المبادئ (بلا وازع أو مبادئ أخلاقية)\nمثال: السياسيون عديمو الضمير الذين يسعدهم بيع بلادهم من أجل السلطة",
 "てき": "ـِيّ\nمثال: その女性は非常に協力的である。 — النساء داعِمات جدًّا. / كَـ / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / بِاتِّجاه, مَع\nمثال: يا لها من جملة! / قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة / خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…) / تَهْدِيد",
 "てきい": "عَدَاوَة, عَدَاء",
 "てきおう": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "てきおうしょうがい": "سوء التكيف (حالة عدم القدرة على التكيف بشكل صحيح مع بيئتك مما يؤدي إلى عدم استقرار عاطفي)",
 "てきおうせい": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "てきおうど": "لِيَاقَة, صِحَّة (مصدر من لَاقَ)\nمثال: كان زيري يتمتع باللياقة البدنية.",
 "てきおうのうりょく": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "てきおうほうさん": "تشعب تكيفي (تطور أشكال مختلفة عديدة من مجموعة كائنات متجانسة أصلاً أثناء ملئها لمنافذ بيئية…)",
 "てきおうりょく": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "てきか": "قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر.",
 "てきかく": "مَضْبُوط\nمثال: ساعتي غير دقيقة. / مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "てきかくである": "مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "てきがいしん": "عَدَاوَة, عَدَاء",
 "てきき": "مَهَارَة",
 "てきぎ": "مُنَاسِب, مُلَائِم / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "てきご": "الكلمة المناسبة (الكلمة أو التعبير المناسب)",
 "てきごう": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "てきごうけんさ": "امتثال, توافق (التطابق في الشكل أو المظهر)",
 "てきごうせい": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم)",
 "てきごうりつ": "إِحْكَام, دِقَّة (صفة القابلية للتكرار في الكمية أو الأداء)\nمثال: تعامل معها بدقة آلة أوتوماتيكية",
 "てきさない": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "てきし": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ)\nمثال: شكرا على الشرح.",
 "てきした": "كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى)\nمثال: خسر كافة ممتلكاته.",
 "てきしゃ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "てきしゃせいぞん": "انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة)",
 "てきしゅ": "جني, قطف (فعل قطف (المحاصيل أو الفاكهة أو القفزات، إلخ))\nمثال: أرسل أول قطاف من التوت إلى السوق / مُنَافِس",
 "てきしゅつ": "تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث / تعريض (فعل تعريض شخص ما لتجربة مؤثرة)\nمثال: نددت بتعريض الأطفال للمواد الإباحية / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "てきしん": "تخفيف, مزج (عملية تخفيف شيء ما)\nمثال: تخفيف الويسكي بالماء",
 "てきじ": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "てきじょ": "تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "てきじん": "عَدُوّ, عَدُوَّة (ركض أو جري)\nمثال: عدو عدوي صديقي. / مُنَافِس",
 "てきす": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "てきする": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "てきず": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "てきせい": "اِسْتِعْدَاد, مَوْهِبَة / مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "てきせつ": "مُنَاسِب",
 "てきたい": "عَدَاوَة, عَدَاء",
 "てきたいしゃ": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "てきたいせいりょく": "خَصْم, مُقَاوِم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "てきたいてき": "مُعَادِي",
 "てきたいてきばいしゅう": "استحواذ عدائي (استحواذ تقاومه إدارة الشركة المستهدفة)",
 "てきだん": "قُنْبُلَة, قُنْبُلَة يَدَوِيَّة",
 "てきだんとう": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "てきだんはっしゃとう": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "てきだんへい": "جرينادير, ذيل الجرذ (سمكة أعماق ذات رأس وجسم كبيرين وذيل طويل مستدق)",
 "てきちゅう": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "てきちょく": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه / أزاليا (أي من شجيرات الزينة العديدة التي تُزرع لزهورها المبهرجة ذات الألوان المختلفة)",
 "てきてい": "مُعَايَرَة (المُعايرَةُ :  تقدير الشيء بالوزن أو الحجم حسب معايير قياسية معروفة…)",
 "てきていりょう": "تيتر, عيار (تركيز محلول كما يحدد بالمعايرة)",
 "てきてき": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً",
 "てきとう": "مُنَاسِب, مُلَائِم / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "てきど": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "てきにまわる": "اِنْقَلَبَ عَلَى",
 "てきにん": "كَفُوء, مُلَائِم (كافٍ لكنّه ليس متميّزًا أو استثنائيًّا)\nمثال: طابع كفء / عَدُوّ, عَدُوَّة (ركض أو جري)\nمثال: عدو عدوي صديقي. / مُنَافِس",
 "てきにんしゃ": "كُفْءٌ تَمَامًا, مُؤَهَّلٌ جِدًّا (مؤهّل أكثر من الحدّ الكافي)",
 "てきはつ": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "てきはほんのうじにあり": "هُنَاك, يُوجَد",
 "てきばき": "بخفَة",
