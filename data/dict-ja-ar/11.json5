 "ちゅうどうせいとう": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة)",
 "ちゅうどうは": "مُحَايِد\nمثال: هذه هي نقطة ضعفه.",
 "ちゅうどうろせん": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة)",
 "ちゅうどく": "تَسْمِيم / إِدْمَان",
 "ちゅうどくがく": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ちゅうどくしゃ": "مُدْمِن, مُدْمِنَة",
