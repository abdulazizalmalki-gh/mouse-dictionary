 "つうじん": "شخص راق, شخص محنك (شخص حكيم دنيوياً)",
 "つうすい": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "つうずる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)\nمثال: すべての道はローマに通ず。 — كل الطرق تؤدي إلى روما. / تَدَفُّق / تَدَفَّقَ, سَالَ / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / تَآمَرَ, اِئْتَمَرَ",
 "つうせつ": "سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "つうせん": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "つうそうていおん": "باص مرقم, باص مستمر (جزء باص مكتوب بالكامل ومصحوب بأرقام للإشارة إلى الكوردات التي سيتم عزفها)",
 "つうぞく": "مَحْبُوب",
 "つうぞくか": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / تبسيط, تعميم (تفسير يسهل فهمه وقبوله)",
 "つうぞくてき": "مَحْبُوب",
 "つうたつ": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "つうだつ": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "つうち": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "つうちしょ": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "つうちじょう": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "つうちひょう": "التقرير المدرسي عن الطالب",
 "つうちぼ": "التقرير المدرسي عن الطالب",
 "つうちょう": "دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة) / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "つうっと": "بِسُرْعَة, عَاجِلًا",
 "つうつう": "سالك, غير مسدود (خالٍ من العوائق أو الانسداد)\nمثال: رؤية غير محجوبة",
 "つうてい": "كَامِن, مُتَأَصِّل (في طبيعة الشيء وإن لم يكن ظاهراً للعيان) / أَسَاسِيّ, جَذْرِيّ (يتعلّق بالحقائق أو المبادئ الأساسية أو يتضمّنها) / سُفْلِيّ, كَامِن تَحْت (يقع تحت أو أسفل شيء آخر)",
 "つうでんしょうけつほう": "تَيَّار كَهْرَبَائِيّ / تَيَّار كَهْرُبَائِيّ",
 "つうと": "بِسُرْعَة, عَاجِلًا",
 "つうはん": "تِجَارَة إِلِكْتْرُونِيَّة",
 "つうば": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "つうふう": "رَثْيَة / نِقْرِس / تَهْوِيَة",
 "つうふうき": "مِرْوَحَة",
 "つうふうこう": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "つうへい": "صدع عادي (صدع مائل يبدو فيه أن الجدار المعلق قد انزلق لأسفل بالنسبة للجدار السفلي)",
 "つうべん": "تَفْسِير",
 "つうほう": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / رِسَالَة, خَبَر / عُمْلَة (أُجْرَة العَمَل؛ النُقُود عامة لأنها تعطى أجرة للعمل)\nمثال: دعونا نقلب العملة.",
 "つうほうしゃ": "مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "つうぼう": "تَوَاطُؤ",
 "つうめい": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "つうやく": "تَفْسِير / مُتَرْجِم, مُتَرْجِمَة / نَقْص",
 "つうやくあんないし": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "つうやくし": "مُتَرْجِم, مُتَرْجِمَة",
 "つうやくしゃ": "مُتَرْجِم, مُتَرْجِمَة",
 "つうやくにん": "مُتَرْجِم, مُتَرْجِمَة",
 "つうゆう": "اشْتِرَاك, قَوَاسِم مُشْتَرَكَة (مشاركة سمات مشتركة) / الدهماء, العامة (طبقة تتكون من أشخاص يفتقرون إلى رتبة دينية أو نبيلة)",
 "つうよう": "عذاب نفسي, كرب عقلي (ألم عاطفي مستمر ومضجر) / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "つうようぐち": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "つうようもん": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "つうり": "عَقْلَانِيَّة (صفة الاتساق مع المنطق أو الاستناد إليه) / رجاحة عقل, عقلانية (حالة امتلاك الحس السليم والحكم الصائب)\nمثال: ربما تكون عقلانيته قد تضررت",
 "つうりゅう": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "つうれい": "عَادَة, عُرْف / عَادَةً, الاَكْثِرْ",
 "つうれつ": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "つうろ": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "つうろがわ": "ممر (ممر بين مناطق الجلوس كما في قاعة المحاضرات أو مركبة الركاب أو بين مناطق رفوف البضائع كما في المتاجر) / رواق كنيسة, ممر جانبي (جزء من الكنيسة مفصول جانبياً عن الصحن الرئيسي بصفوف من الأعمدة أو السواري) / ممر (ممر ضيق طويل (كما في كهف أو غابة))",
 "つうろん": "لَخَّصَ, اِخْتَصَرَ",
 "つうわ": "مُكَالَمَة / مُكَالَمَة هَاتِفِيَّة, مُحَادَثَة تِلِفُونِيَّة",
 "つうわひょう": "أبجدية صوتية (أبجدية من الرموز تهدف إلى تمثيل أصوات الكلام المحددة)",
 "つうんと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة) / بحدة, بشكل لاذع (بحدة؛ بطريقة لاذعة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "つえ": "بُوص, قَصَبَة (فتح فمه أو فمه بشكل غير طبيعي؛ تشتت الكلام أو الصوت بشكل غير واضح)\nمثال: عرض الثلاجة 24 بوصة فقط. إنها تناسب الشقق الصغيرة.",
 "つか": "تَبَخْتَر / سَمَاكَة / عرض اليد (أي وحدة للطول تعتمد على عرض يد الإنسان) / بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي / تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ) / قائمة حجرية, منهير (ميغاليث عمودي طويل؛ يوجد بشكل أساسي في إنجلترا وشمال فرنسا) / مَقْبَض",
 "つかあさい": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "つかあな": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "つかい": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية) / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة) / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "つかいあるき": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "つかいかた": "اِسْتِخْدَام / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "つかいかって": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "つかいがって": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "つかいきり": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "つかいきる": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "つかいこなす": "مِقْبَض",
 "つかいこみ": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "つかいこむ": "غَلَّ, اِخْتَلَسَ",
 "つかいごろ": "فِي مُتَنَاوَل اليَد, قَرِيب (سهل الوصول إليه وقريب) / صَنَاعِيّ, مَاهِر اليَدَيْن (ماهر في العمل اليدوي) / عَمَلِيّ, مُفِيدٌ وَمُلَائِم (مُفِيدٌ وَمُرِيح)",
 "つかいすぎ": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "つかいすて": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "つかいずて": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "つかいだす": "جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "つかいっぱ": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "つかいっぱしり": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "つかいて": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / مُسْرِف",
 "つかいどころ": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "つかいならす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "つかいのこし": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "つかいのこり": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "つかいのもの": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "つかいはしり": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "つかいばしり": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "つかいばん": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "つかいふるし": "بَالٍ",
 "つかいま": "روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة)",
 "つかいまわす": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "つかいみち": "هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف.",
 "つかいめ": "خادمة (عاملة منزلية)",
 "つかいもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "つかいものにならない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "つかいもん": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "つかいりょう": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "つかう": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "つかえ": "عَقَبَة, حَاجِز",
 "つかえつかえ": "بتردد, بتلعثم (بطريقة مترددة)\nمثال: تحدث بتلعثم",
 "つかえまつる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "つかえめ": "خادمة (عاملة منزلية)",
 "つかえる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ) / إيقاف, تجميد (مقاطعة أو تعليق مؤقت للتقدم أو الحركة) / توقف, وقوف (حدث انتهاء شيء ما) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: وقف سباق التسلح",
 "つかがしら": "مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / قربوس السرج, مقدم السرج (مقبض يد يتشكل من الجزء الأمامي المرتفع للسرج) / مقبض حصان الحلق (مقبض يستخدمه لاعب الجمباز عند أداء التمارين على حصان الحلق)",
 "つかさ": "مَهَمَّة / شَيْخ, قَائِد / بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي",
 "つかさどる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "つかさびと": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "つかす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "つかたり": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "つかつか": "بتصميم, بعزم (مع تصميم؛ بطريقة مصممة) / بِطُمُوح (مع الطموح؛ بطريقة طموحة وحيوية)\nمثال: تشبث بالماضي بتصميم",
 "つかつくり": "شقبان (طيور كبيرة الأقدام قصيرة الأجنحة من أسترالاسيا؛ تبني أكواماً من النباتات المتحللة لاحتضان البيض)",
 "つかねる": "إِبَالَة, حُزْمَة / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / طَوَى / طَيَّة",
 "つかのま": "عَزْم / لَحْظَة, دَقِيقَة",
 "つかの間": "عَزْم / لَحْظَة, دَقِيقَة",
 "つかまえる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / مَسَكَ / قَبَضَ (أَخَذَ الشيءَ بِيَدِه؛ أَمْسَكَ الشيءَ) / مَسْك, قَبْض\nمثال: لقد قبض على توم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "つかませる": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "つかまつる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "つかまる": "قَبْضَة / وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "つかみ": "مَقْبِض",
 "つかみあう": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "つかみだす": "أَخْرَجَ",
 "つかみとる": "قَبْضَة",
 "つかみどころ": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / مَسَكَ, مسك",
 "つかみどころがない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "つかみどころのない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "つかみ出す": "أَخْرَجَ",
 "つかみ取る": "قَبْضَة",
 "つかみ合う": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "つかみ所": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / مَسَكَ, مسك",
 "つかみ所がない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "つかみ所のない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "つかむ": "إِسْتَوْلَى عَلَى / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟ / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "つからかす": "إِرْهَاق, تَعَب / تَعِبَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "つからす": "تَعِبَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "つかれ": "إِرْهَاق, تَعَب",
 "つかれた": "بَالٍ",
 "つかれる": "تَعِبَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب. / تَضَوَّرَ",
 "つかわす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / أَنْعَمَ",
 "つかーさい": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "つがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / مُشْتَرَك / مِفْصَل",
 "つがいめ": "مُشْتَرَك / مِفْصَل",
 "つがい目": "مُشْتَرَك / مِفْصَل",
 "つがう": "صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / صَلَّحَ / أَصْلَحَ",
 "つがざくら": "خلنج الجبل (شجيرة صغيرة بأوراق دائمة الخضرة وزهور وردية أو أرجوانية؛ القمم الألبية والأراضي المرتفعة في آسيا وأوروبا والولايات المتحدة)",
 "つき": "مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب. / قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام. / ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / شَامِل / اِنْطِبَاع, أَثَر / تَقْلِيد / حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ) / بَخْت\nمثال: لقد حالفني الحظ. / اجتماعية (الميل للاختلاط بالآخرين وتكوين مجموعات اجتماعية)\nمثال: الثدييات كفئة ليست قوية في الاجتماعيات",
 "つきあい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "つきあいきれない": "اِكتَفَى, مُكتَفٍ",
 "つきあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "つきあかり": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "つきあげる": "رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي / ضَغْط",
 "つきあたり": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "つきあわせ": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "つきあわせつぎて": "وصلة تقابل, وصلة تناكبية (وصلة تُصنع عن طريق تثبيت الأطراف معاً دون تداخل)",
 "つきあわせる": "قَارَنَ / شَبَّهَ",
 "つきいた": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "つきうごかす": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن. / مِهْمَاز",
 "つきうす": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "つきうま": "أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "つきかえす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "つきかげ": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "つきぎめちゅうしゃじょう": "مَوْقِف سَيَّارَات, مَوْقِف",
 "つきぎり": "مِخْرَز, إِشْفَى",
 "つきくずす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق) / كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "つきくだく": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "つきぐあい": "اِلْتِصَاق",
 "つきげ": "بالومينو (حصان لونه أسمر فاتح أو ذهبي مع عرف وذيل بلون الكريم أو الأبيض)",
 "つきこむ": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض / أَشَارَ / رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "つきこもり": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "つきごと": "شَهْرِيّ / شَهْرِيًّا",
 "つきごめ": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "つきごもり": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "つきささる": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "つきさす": "طَعْن / طَعْنَة / طَعَنَ",
 "つきしたがう": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "つきしろ": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "つきせかい": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض)",
 "つきせぬ": "أَبَدِيّ",
 "つきそい": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "つきそいしゃ": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم)",
 "つきそいにん": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "つきそいやく": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "つきそう": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "つきたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "つきたつ": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "つきたてる": "طَعْن / طَعْنَة / طَعَنَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "つきだし": "نَاتِئَة / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "つきだす": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "つきちゃくりく": "هُبُوط عَلَى الْقَمَر",
 "つきちゃくりくせん": "مركبة الهبوط على القمر, وحدة قمرية (مركبة فضائية تحمل رواد الفضاء من وحدة القيادة إلى سطح القمر والعودة)",
 "つきづき": "شَهْرِيّ / شَهْرِيًّا",
 "つきでた": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "つきでる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "つきとおす": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "つきとおる": "اِخْتَرَقَ",
 "つきとめる": "تَيَقَّنَ, تَثَبَّتَ",
 "つきない": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "つきなみ": "مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام)",
 "つきぬきにんどう": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية)",
 "つきぬく": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "つきのいり": "سُدْفَة, فَحْمَة",
 "つきのさわり": "حيض, دورة شهرية (الإفراز الشهري للدم من رحم النساء غير الحوامل من سن البلوغ حتى سن اليأس)\nمثال: كانت النساء مريضات وعرضة للحيض المفرط",
 "つきのつるぎ": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "つきので": "شَفَق, غَسَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "つきのもの": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "つきのわ": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "つきはなす": "هَجَرَ (ضد الوصل، الصرم والقطع. مصدره هَجْر وهِجران؛ ترك وابعد وتباعد. مصدره هَجْر)\nمثال: هجر ياني زوجته.",
 "つきひ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "つきびと": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "つきべつ": "شَهْرِيّ / شَهْرِيًّا",
 "つきぼう": "مِدَكّ / مهماز, مهيج (أداة مدببة تستخدم للحث على الحركة) / تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: النكز المستمر أثار أعصابه",
 "つきましては": "التَّالِي فِي التَّسَلْسُل, فِي الدَّوْر (يأتي تاليًا في تسلسل الخلافة أو التوالي) / بالصف, في طابور (واحد خلف الآخر في خط أو طابور) / عَلَى قَائِمَةِ الِانْتِظَار, فِي الطَّابُور (في انتظار شيء ما؛ خاصة شيء مستحقّ)\nمثال: انتظروا في طابور للتذاكر",
 "つきまとう": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "つきもどす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "つきもの": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم / مُلْحَق / روح شريرة (روح تميل لإحداث الضرر)",
 "つきやく": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "つきやぶる": "اِخْتَرَقَ",
 "つきよにかまをぬかれる": "خطأ فادح, زلة (خطأ محرج)",
 "つきよみ": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "つき倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "つき具合": "اِلْتِصَاق",
 "つき出し": "نَاتِئَة / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "つき出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "つき合い": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "つき合わせる": "قَارَنَ / شَبَّهَ",
 "つき物": "مُلْحَق / روح شريرة (روح تميل لإحداث الضرر)",
 "つき砕く": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "つき臼": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "つき返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "つぎ": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / مَرْحَلَة / مُنَصَّة, مَسْرَح / مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع) / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "つぎあて": "باتشوورك, ترقيع (خياطة تتكون من قطع من مواد مختلفة مخيطة معاً في نمط) / لحاف مرقع (لحاف مصنوع عن طريق خياطة رقع من خامات مختلفة معاً) / خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "つぎからつぎと": "وَاحِدًا تِلْوَ الآخَرِ",
 "つぎからつぎに": "وَاحِدًا تِلْوَ الآخَرِ",
 "つぎからつぎへと": "وَاحِدًا تِلْوَ الآخَرِ",
 "つぎき": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "つぎぎれ": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع)",
 "つぎくち": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "つぎぐち": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "つぎたし": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / إعادة ملء, تجديد (الملء مرة أخرى عن طريق توفير ما تم استهلاكه)",
 "つぎたて": "سِبَاق تَتَابُع",
 "つぎだい": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "つぎつぎ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا\nمثال: 彼らは次々と出発した。 — بدأوا واحداً تلو الآخر.",
 "つぎつぎに": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "つぎつぎはんばい": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "つぎて": "قارنة, وصلة (جهاز ميكانيكي يعمل على توصيل نهايات الأجسام المتجاورة) / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "つぎなる": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "つぎに": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "つぎのないかく": "حكومة الظل (مجموعة من كبار أعضاء الحزب السياسي الذي هو خارج السلطة؛ من المحتمل أن يتولى هؤلاء الأعضاء مناصب مقابلة كوزراء في مجلس الوزراء البريطاني إذا تم انتخاب…)",
 "つぎのま": "غُرْفَة الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "つぎのように": "كَمَا يَلِي",
 "つぎは": "تَاج, إِكْلِيل",
 "つぎはぎ": "ترقيع (فعل إصلاح ثقب في ثوب بخياطة رقعة عليه) / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "つぎば": "تَاج, إِكْلِيل",
 "つぎほ": "سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "つぎぼ": "سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "つぎめ": "مُشْتَرَك / مِفْصَل",
 "つぎめなし": "سَلِس, مُتَنَاغِم (متسق ومتماسك تماماً بلا انقطاع) / بِلَا تَجَاعِيد, بِلَا خُطُوط (أملس وناعم خاصّة في وصف البشرة) / سلس, غير موصول بدرزة (ليس لديه درزة أو غير متصل بدرزات)\nمثال: جوارب بدون درزات",
 "つぎ木": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "つく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / صَعِد / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس. / بَلَغَ / اِشْتَعَلَ / تَنَفَّسَ / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / تَقَيَّأَ, قَاءَ / تَقَيُّؤ / زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / حَمْلَة / هَاجَمَ / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / نَدْبَة, نَدْب / دُبّ / دُبَّة / اِحْتَمَلَ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة) / بومة قرناء (بوم كبير له خصلات أذن بارزة)",
 "つくえ": "مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "つくす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "つくずく": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "つくだ": "أرز مزروع (ينتج الغذاء الأساسي لـ 50 في المائة من سكان العالم)",
 "つくつく": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "つくづく": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "つくとり": "بومة قرناء (بوم كبير له خصلات أذن بارزة)",
 "つくなむ": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "つくねん": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "つくばう": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "つくばだいがくでんしとしょかん": "لَعْلَع / تُولِيب",
 "つくばねあさがお": "بيتونيا (أي من الأعشاب الاستوائية العديدة ذات الزهور المخددة على شكل قمع)",
 "つくばる": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "つくよみ": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "つくり": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / سَاشِيمِي / يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "つくりあげる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / اِفْتَرَى, اِخْتَلَقَ",
 "つくりかえす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "つくりかえる": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "つくりかざる": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "つくりかた": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / وَصْفَة",
 "つくりかわ": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "つくりがお": "مُخْتَلَق",
 "つくりこみ": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة",
 "つくりこむ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "つくりごと": "فَبْرَكَة",
 "つくりじ": "مُخْتَلَق",
 "つくりたてる": "زَيَّنَ, زَخْرَفَ (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "つくりだす": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / اِخْتَرَعَ",
 "つくりつけ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "つくりつける": "صَلَّحَ / أَصْلَحَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "つくりて": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / فَلَّاح, فَلَّاحَة",
 "つくりな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "つくりなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "つくりなき": "تخيل, تمثيل (تجسيد للتظاهر) / تَمْثِيلِيّ, مُتَظَاهِر (مُتَخَيَّل كما في اللعب أو التمثيل) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان مجرد تمثيل",
 "つくりぬし": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "つくりばな": "زهرة اصطناعية (تقليد مصنوع يدوياً لزهرة)",
 "つくりばなし": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "つくりもの": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / زينة / مَحْصُول / حَوْصَلة",
 "つくりもん": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / زينة / مَحْصُول / حَوْصَلة",
 "つくる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "つくろい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها)",
 "つくろう": "أَصْلَحَ / صَلَّحَ / عَالَجَ",
 "つぐ": "نَجَحَ / مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع) / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "つぐない": "مُكَافَأَة, بَدَل",
 "つぐなう": "مُكَافَأَة, بَدَل",
 "つぐのう": "مُكَافَأَة, بَدَل",
 "つぐみ": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة) / وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "つぐむ": "صَمَتَ",
 "つけ": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / حبة, قرص (جرعة من الدواء على شكل قرص صغير) / شريط, لسان (شريط قصير من مادة متصل بشيء أو بارز منه لتسهيل فتحه أو تحديده أو التعامل معه) / مفتاح الجدولة (المفتاح الموجود في الآلة الكاتبة أو معالج النصوص الذي يسبب جدولة) / صحافة التابلويد, صحافة صفراء (صحافة تعتمد على الإثارة والمبالغة)\nمثال: اسحب اللسان لفتح العلبة / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / مُؤَثِّر صَوْتِيّ",
 "つけあわせ": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "つけあわせる": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / قَارَنَ / شَبَّهَ",
 "つけうま": "أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "つけおき": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً",
 "つけかえ": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "つけかえる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "つけかけ": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "つけがみ": "زَقِيطَة / شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "つけくわえ": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "つけくわえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "つけくわえると": "بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "つけぐすり": "مَرْهَم, دَهُون",
