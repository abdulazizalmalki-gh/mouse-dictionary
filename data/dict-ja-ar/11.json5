 "つっぱしる": "سُرْعَة\nمثال: 違反のスピードを出して、突っ走っていた車がブレーキをかけたが、空回りして、運転手があっというまもなく、トラックの背後に、もろにぶつかった。 — تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جداً .",
 "つっぱねる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "つっぱり": "سِنَاد, عِمَاد\nمثال: ياني هنا لدعم ريمة. / إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة)\nمثال: شعر بانقباض في صدرها / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر)\nمثال: ورث جنوحه عن أبيه",
 "つっぱる": "شَدَّ, ضَيَّقَ / ثَابَرَ / خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "つっぺ": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم / حَانَة, بَار",
 "つっ立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "つつ": "مُدَّة\nمثال: جون في عمر أخي. / بِالرَغْم مِن / أُنْبُوبَة / سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح) / مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس. / ذُعْرَة, هَزَّاز الذَّنَب",
 "つつうらうら": "جَمِيع أَنْحَاء, كُلّ",
 "つつがた": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "つつがない": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "つつがむし": "بق الحصاد, سوس الحصاد (يرقة سوس تمتص دم الفقاريات بما في ذلك البشر مسببة تهيجاً شديداً)",
 "つつがむしびょう": "تيفوس الأجمة, مرض تسوتسوغاموشي (ينقله يرقات العث وينتشر في آسيا)",
 "つつき": "نَقَّرَ, نَقَرَ",
 "つつきのじゅんい": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "つつきの順位": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "つつく": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "つつさき": "بزبوز, فوهة (فوهة بارزة يتم تصريف السائل منها)",
 "つつしみ": "تَوَاضُع",
 "つつしみぶかい": "مُتْوَاضِع",
 "つつしむ": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "つつしんで": "بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟",
 "つつしんでもうしあげます": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "つつじょう": "أُسْطُوَانِيّ (ذو شكل الأسطوانة)",
 "つつましい": "مُتْوَاضِع / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر)",
 "つつましやか": "مُتْوَاضِع",
 "つつみ": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات…)\nمثال: عدن إلى المصرف. / حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا. / إِبَالَة, حُزْمَة",
 "つつみかくし": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً)\nمثال: وفر ستار من الأشجار الخصوصية",
 "つつみかくす": "أَخْفَى",
 "つつみがみ": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "つつみなく": "بِصَراحة",
 "つつみもの": "إِبَالَة, حُزْمَة",
 "つつむ": "حُزْمَة, عُبُوَّة\nمثال: حزم ياني أمتعته. / غِطَاء / أَخْفَى / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / عَاقَ, عَرْقَلَ",
 "つつも": "بِالرَغْم مِن",
 "つつやき": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح)\nمثال: 私語をやめて話を聞け。 — اسكت و اسمعني.",
 "つづいて": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "つづうらうら": "جَمِيع أَنْحَاء, كُلّ",
 "つづき": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / تَدَفُّق / تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "つづきあい": "عَلَاقَة",
 "つづきがら": "عَلَاقَة, مُنَاسَبَة",
 "つづきへや": "غرفة مجاورة (غرفة فندق تشترك في جدار مع غرفة فندق أخرى)",
 "つづきべや": "غرفة مجاورة (غرفة فندق تشترك في جدار مع غرفة فندق أخرى)",
 "つづきもの": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)\nمثال: زواج أحادي متسلسل",
 "つづく": "تَابَعَ, اِسْتَمَرَّ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان. / اِحْتَفَظَ, أَبْقَى",
 "つづけさま": "مُتَتَابِع, مُتَتَالٍ",
 "つづけざま": "مُتَتَابِع, مُتَتَالٍ",
 "つづけて": "بالدور, على التوالي (في ترتيب أو تسلسل مناسب)\nمثال: تحدث إلى كل طفل بدوره",
 "つづける": "تَابَعَ, اِسْتَمَرَّ",
 "つづしる": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)",
 "つづまやか": "وَجِيز, مُوجَز / مُتَوَاضِع\nمثال: لقد أزمت الوضع. / مُتْوَاضِع",
 "つづまる": "كِمادة (وسادة قماشية أو ضمادة (مع دواء أو بدونه) توضع بإحكام على جزء من الجسم (لتخفيف…)",
 "つづみ": "سَاعَاتِيّ الشَّكْل (على شكل ساعة رمليّة) / طَبْل (الضَرْب على الطَبْل؛ آلة موسيقية تشبه الإسطوانة المغطاة فتحتها بالجلد تستخدم…)",
 "つづめる": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "つづら": "كودزو (كرمة سريعة النمو من شرق آسيا لها جذور نشوية درنية وأوراق ثلاثية مشعرة وعناقيد…)",
 "つづらおり": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "つづら折": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "つづら折り": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "つづり": "عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / مِلَفّ",
 "つづりかた": "عمل أدبي, مؤلف أدبي (كتابة إبداعية أو خيالية) / عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "つづりじ": "عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "つづり字": "عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "つづり方": "عمل أدبي, مؤلف أدبي (كتابة إبداعية أو خيالية) / عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "つづる": "تَعْوِيذَة / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "つづれ": "خِرْقَة / تابيستري, نسيج مزخرف (معلقة حائطية من قماش ثقيل منسوج يدوياً غالباً بتصاميم تصويرية)\nمثال: نسيج التاريخ الأوروبي",
 "つづれおり": "تابيستري, نسيج مزخرف (معلقة حائطية من قماش ثقيل منسوج يدوياً غالباً بتصاميم تصويرية)\nمثال: نسيج التاريخ الأوروبي",
 "つづれにしき": "إِسْتَبْرَق (إستَبرَق)",
 "つづれ織り": "تابيستري, نسيج مزخرف (معلقة حائطية من قماش ثقيل منسوج يدوياً غالباً بتصاميم تصويرية)\nمثال: نسيج التاريخ الأوروبي",
 "つづれ錦": "إِسْتَبْرَق (إستَبرَق)",
 "つて": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / صِلَة, صُلَة",
 "つてこと": "رِسَالَة, خَبَر / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "つと": "بِسُرْعَة, عَاجِلًا / بهدوء (برباطة جأش (خاصة في أوقات التوتر))\nمثال: تحدث بهدوء للطلاب المشاغبين / بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان / تَذْكار",
 "つとめ": "خِدْمَة",
 "つとめがえり": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "つとめぐち": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "つとめさき": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)",
 "つとめて": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "つとめにん": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "つとめぶり": "اجتهاد, انكباب (اجتهاد وانتباه عظيم ومستمر)",
 "つとめぼうこう": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "つとめる": "مُحَاوَلَة, غَايَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء…)\nمثال: كف عن المحاولة. / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس. / مَلَأَ",
 "つど": "مَتَى, مَتَى مَا",
 "つどい": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "つどう": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "つな": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "つながり": "صِلَة, صُلَة",
 "つながる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه. / رَصَاص / مَدَّدَ",
 "つなぎ": "وَصْلَة / حشوة (التبغ المستخدم لتشكيل لب السيجار)\nمثال: بعض العناصر في المجموعة مجرد تكملة / مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف / تحوط, مراوغة (بيان غير ملزم أو غامض عمداً)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "つなぎあわせる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه.",
 "つなぎうり": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "つなぎとめる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "つなぎふく": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط)",
 "つなぎめ": "مُشْتَرَك",
 "つなぎ合わせる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه.",
 "つなぎ売り": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "つなぎ服": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط)",
 "つなぎ目": "مُشْتَرَك",
 "つなぐ": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / حَافَظَ / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة)",
