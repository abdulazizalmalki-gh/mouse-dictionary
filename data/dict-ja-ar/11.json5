 "ていねんれい": "صَغِير, حَدَث",
 "ていのう": "حماقة, غباء (خطأ سخيف) / بلاهة (تخلف عقلي أشد من البله ولكن ليس بشدة العته)",
 "ていのうしゃ": "أَبْلَه, مَعْتُوه (ذو عمر عقلي يتراوح بين ثلاث وسبع سنوات) / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "ていはく": "أَنْكُورِيج",
 "ていはくち": "أَنْكُورِيج",
 "ていはつ": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "ていばい": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "ていばいき": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "ていばん": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي / باثوليت",
 "ていひれいのほうそく": "قانون النسب الثابتة ((كيمياء) قانون ينص على أن كل مادة نقية تحتوي دائمًا على نفس العناصر مجتمعة بنفس النسب بالوزن)",
 "ていひんしつ": "جودة منخفضة, دونية (جودة متدنية)",
 "ていひんど": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها) / تَرَدُّد مُنْخَفِض (30 إلى 300 كيلوهرتز)",
 "ていぶ": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "ていへん": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "ていへんそう": "الطَّبَقَاتُ الدُّنْيَا",
 "ていほん": "كتاب مصادر (مجموعة من الوثائق المهمة تاريخياً منشورة معاً ككتاب) / مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "ていぼう": "مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف.",
 "ていぼく": "شُجَيْرَة / شَرَاب",
 "ていぼくそう": "أشجار الطبقة السفلى",
 "ていまい": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "ていみつ": "رقة, ندرة (جودة التخلخل (قلة الكثافة))\nمثال: رقة الغلاف الجوي العلوي",
 "ていみつどリポたんぱく": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "ていみつどリポたんぱくしつ": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "ていみつどリポタンパク": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "ていめい": "حَامَ (دار أو طاف حول شيء؛ اقترب من شيء دون الوصول إليه) / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "ていめん": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "ていもう": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "ていやちん": "إيجار رمزي (إيجار منخفض جداً أو اسمي)",
 "ていゆ": "مجاز مرسل (استبدال مصطلح أكثر شمولاً بآخر أقل شمولاً أو العكس)",
 "ていよう": "خُلَاصَة, مُلَخَّص / كَبْش",
 "ていようえん": "التهاب الصفيحة (التهاب الأنسجة الصفائحية التي تربط الحافر بقدم الحصان)",
 "ていよく": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق) / بِاحْتِشَام, بِشَكْل لَائِق (بطريقة لائقة)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "ていよさん": "مَحْدُود المِيزَانِيَّة (مصنوع أو مناسب لميزانية محدودة)",
 "ていらく": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "ていらず": "غَيْر مُتَأَثِّر, غَيْر مُنْقَاد (لم يتأثر أو لم ينقد لتأثير خارجي) / غَيْر مَمْسُوس, كَامِل (لَا يَزَالُ مَمْلُوءًا وَلَمْ يُمَسّ) / جامد المشاعر, غير مبال (غير منفعل عاطفياً) / بكر, غير ملموس (لم يحدث بينه وبين شيء آخر تلامس)\nمثال: بدا دائماً غير متأثر تماماً ورابط الجأش",
 "ていり": "مُبَرْهَنَة / مَأْمُور",
 "ていりきん": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "ていりきんゆう": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "ていりしきん": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "ていりつ": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا) / أُطْرُوحَة",
 "ていりつせん": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "ていりゅう": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني) / تيار تحتي (تيار تحت سطح سائل)",
 "ていりゅうこうがん": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "ていりゅうしょ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ていりゅうじょ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ていりゅうじょう": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ていりゅうせいそう": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "ていりゅうそち": "تَوْقِيف",
 "ていりょうてき": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس) / كمي ((للشعر) له نظام متري يعتمد على المدة النسبية للمقاطع) / كمي (يتعلق بقياس الكمية)\nمثال: تصدير القمح دون قيود كمية",
 "ていりょうぶんせき": "تحليل كمي, تحليل كيميائي كمي (تحليل كيميائي لتحديد كميات كل عنصر في المادة)",
 "ていれ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "ていれい": "عَادِيّ / مُنْتَظِمٌ / سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "ていれつ": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "ていれん": "رَخِيص",
 "ていカリウムけつしょう": "نقص بوتاسيوم الدم (مستوى منخفض بشكل غير طبيعي للبوتاسيوم في الدم المتداول مما يؤدي إلى الضعف وتشوهات القلب؛ يرتبط بأورام الغدة الكظرية أو الجوع أو تناول مدرات البول)",
 "ていレベル": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ていレベルほうしゃせいはいきぶつ": "نفايات مشعة منخفضة المستوى ((طب) نفايات مشعة تتكون من أشياء تعرضت للإشعاع لفترة وجيزة (كما في بعض الفحوصات الطبية))",
 "てうす": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر) / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "てうち": "صُلْح, مُصَالَحَة / طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "てえ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "ておい": "جَرِيح / مَجْرُوح",
 "ておけ": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / ملء دلو (الكمية المحتواة في دلو)",
 "ておしぐるま": "عربة دفع, عربة يدوية (مركبة بعجلات يمكن دفعها بواسطة شخص؛ قد يكون لها عجلة واحدة أو عجلتان أو أربع عجلات)\nمثال: استخدم عربة يدوية لنقل الصخور بعيداً",
 "ておち": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "ておの": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية) / قَدُوم (قُدُوْم؛ قَدُوْم)\nمثال: بإمكانك القدوم معي.",
 "ており": "مَنْسُوجٌ يَدَوِيًّا (منسوج على نول يدوي)",
 "てか": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "てかがみ": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "てかけ": "مِقْبَض / سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "てかけおんな": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "てかげん": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "てかご": "سلة (حاوية عادة ما تكون منسوجة ولها مقابض)",
 "てかし": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار / قَيْد",
 "てかず": "مُشْكِلَة, مَتاعِب",
 "てかせ": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار / قَيْد",
 "てかせあしかせ": "أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "てかてか": "بَرَّاق, مُتَأَلِّق (يَلْمَع بِبَرِيقٍ ثَابِتٍ وَلَكِنْ هَادِئ) / بريق, بصيص (مظهر لضوء منعكس) / بريق خافت, بصيص (وميض من الضوء (خاصة الضوء المنعكس))",
 "てかり": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "てかる": "بريق, بصيص (مظهر لضوء منعكس) / بريق خافت, بصيص (وميض من الضوء (خاصة الضوء المنعكس))",
 "てがかり": "خيط دليل, قرينة (دليل يساعد على حل مشكلة) / تلميح, دليل (إشارة طفيفة) / مقبض, موطئ يد (ملحق للإمساك به)",
 "てがき": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / مَكْتُوبٌ بِخَطِّ اليَد (كُتِب باليد لا بالطباعة)",
 "てがける": "مِقْبَض / خَلْفِيّ",
 "てがし": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار / قَيْد",
 "てがせ": "أَصْفَاد, أَغْلَال / تَقْيِيد, اِقْتِصَار / قَيْد",
 "てがた": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً) / أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي?",
 "てがたい": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "てがたこうかんじょ": "غرفة المقاصة (مكان مركزي للتجميع حيث تتبادل البنوك الشيكات أو الحوالات؛ ويحتفظ المشاركون بحساب يتم فيه تسجيل الدائن والمدين)",
 "てがたちどり": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة)",
 "てがつけられない": "منفلت من عقاله",
 "てがでる": "لَكْمَة أَمَامِيَّة",
 "てがはなせない": "مَشْغُول",
 "てがみ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "てがみばくだん": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "てがら": "إِنْجَاز",
 "てがる": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "てがるい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "てがわるい": "فَقِير / مِسْكِين / فُقَرَاء / عديم الضمير, متجرد من المبادئ (بلا وازع أو مبادئ أخلاقية)\nمثال: السياسيون عديمو الضمير الذين يسعدهم بيع بلادهم من أجل السلطة",
 "てき": "ـِيّ\nمثال: その女性は非常に協力的である。 — النساء داعِمات جدًّا. / كَـ / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال. / بِاتِّجاه, مَع / مِن جِهة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة / خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / تَهْدِيد",
 "てきい": "عَدَاوَة, عَدَاء",
 "てきおう": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "てきおうしょうがい": "سوء التكيف (حالة عدم القدرة على التكيف بشكل صحيح مع بيئتك مما يؤدي إلى عدم استقرار عاطفي)",
 "てきおうせい": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "てきおうど": "لِيَاقَة, صِحَّة (مصدر من لَاقَ)\nمثال: كان زيري يتمتع باللياقة البدنية.",
 "てきおうのうりょく": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "てきおうほうさん": "تشعب تكيفي (تطور أشكال مختلفة عديدة من مجموعة كائنات متجانسة أصلاً أثناء ملئها لمنافذ بيئية مختلفة)",
 "てきおうりょく": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "てきか": "قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر.",
 "てきかく": "مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة. / مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "てきかくである": "مؤهل, مستحق (مؤهل لـ أو مسموح له أو يستحق أن يتم اختياره)\nمثال: مؤهل للترشح للمنصب",
 "てきがいしん": "عَدَاوَة, عَدَاء",
 "てきき": "مَهَارَة",
 "てきぎ": "مُنَاسِب, مُلَائِم / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "てきご": "الكلمة المناسبة (الكلمة أو التعبير المناسب)",
 "てきごう": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / امتثال, توافق (التطابق في الشكل أو المظهر) / امْتِثَال, تَحَجُّر (تقليدية متصلبة) / امتثال, مسايرة (الالتزام بالمعايير التقليدية في الأفكار والمعتقدات)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "てきごうけんさ": "امتثال, توافق (التطابق في الشكل أو المظهر)",
 "てきごうせい": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "てきごうりつ": "إِحْكَام, دِقَّة (صفة القابلية للتكرار في الكمية أو الأداء)\nمثال: تعامل معها بدقة آلة أوتوماتيكية",
 "てきさない": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "てきし": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ) / فَسَّرَ / أَبَانَ\nمثال: شكرا على الشرح.",
 "てきした": "كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى)\nمثال: خسر كافة ممتلكاته.",
 "てきしゃ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "てきしゃせいぞん": "انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة)",
 "てきしゅ": "جني, قطف (فعل قطف (المحاصيل أو الفاكهة أو القفزات، إلخ)) / حصاد, قطاف (كمية المحصول التي يتم حصادها)\nمثال: أرسل أول قطاف من التوت إلى السوق / مُنَافِس",
 "てきしゅつ": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث / تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "てきしん": "تخفيف, مزج (عملية تخفيف شيء ما)\nمثال: تخفيف الويسكي بالماء",
 "てきじ": "فِي الوَقْت المُنَاسِب (في وقت ملائم) / فِي أَوَانِه, فِي الوَقْت المُنَاسِب (يحدث أو يتم في الوقت الملائم أو المناسب) / فِي الوَقْتِ المُنَاسِب (قبل انتهاء المهلة الزمنية المحدّدة)\nمثال: وصلت رسالتك في الوقت المناسب",
 "てきじょ": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "てきじん": "عَدُوّ, عَدُوَّة (ركض أو جري) / عَدُوّ (ركض أو جري) / عَدَائِيّ\nمثال: عدو عدوي صديقي. / مُنَافِس",
 "てきす": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "てきする": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "てきず": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "てきせい": "اِسْتِعْدَاد, مَوْهِبَة / مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "てきせつ": "مُنَاسِب / لَائِق",
 "てきたい": "عَدَاوَة, عَدَاء",
 "てきたいしゃ": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "てきたいせいりょく": "خَصْم, مُقَاوِم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "てきたいてき": "مُعَادِي",
 "てきたいてきばいしゅう": "استحواذ عدائي (استحواذ تقاومه إدارة الشركة المستهدفة)",
 "てきだん": "قُنْبُلَة, قُنْبُلَة يَدَوِيَّة",
 "てきだんとう": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "てきだんはっしゃとう": "بندقية قاذفة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "てきだんへい": "جرينادير, ذيل الجرذ (سمكة أعماق ذات رأس وجسم كبيرين وذيل طويل مستدق) / رامي القنابل, غرينادير (جندي مشاة مجهز بقنابل يدوية)",
 "てきちゅう": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "てきちょく": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / أزاليا (أي من شجيرات الزينة العديدة التي تُزرع لزهورها المبهرجة ذات الألوان المختلفة)",
 "てきてい": "مُعَايَرَة (المُعايرَةُ :  تقدير الشيء بالوزن أو الحجم حسب معايير قياسية معروفة؛ المُعايرَةُ : ( و) التقدير بالحجم بمحاليلَ قياسيةٍ معروفةٍ قُوَّتُها)",
 "てきていりょう": "تيتر, عيار (تركيز محلول كما يحدد بالمعايرة)",
 "てきてき": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً",
 "てきとう": "مُنَاسِب, مُلَائِم / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / شَكْلِيّ, صُورِيّ (يُؤَدَّى أَوْ يُنْتَجُ كَإِجْرَاءٍ شَكْلِيٍّ فَحَسْبُ)",
 "てきど": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "てきにまわる": "اِنْقَلَبَ عَلَى",
 "てきにん": "كَفُوء, مُلَائِم (كافٍ لكنّه ليس متميّزًا أو استثنائيًّا) / كفء, مؤهل (مؤهل بشكل صحيح أو كافٍ أو قادر أو فعال) / ذو أهلية قانونية, مختص (مؤهل قانونياً أو كافٍ من الناحية القانونية)\nمثال: طابع كفء / عَدُوّ, عَدُوَّة (ركض أو جري) / عَدُوّ (ركض أو جري) / عَدَائِيّ\nمثال: عدو عدوي صديقي. / مُنَافِس",
 "てきにんしゃ": "كُفْءٌ تَمَامًا, مُؤَهَّلٌ جِدًّا (مؤهّل أكثر من الحدّ الكافي)",
 "てきはつ": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "てきはほんのうじにあり": "هُنَاك, يُوجَد",
 "てきばき": "بخفَة",
 "てきぱき": "بخفَة",
 "てきひ": "أدب, صواب (السلوك الصحيح أو المناسب)",
 "てきびしい": "خَشِن, قَاسٍ (كريه بشكل حادّ وصارم) / صارِم, قاسٍ (شَديد القَسْوَة (عَن العُقوبَة أو الحُكْم)) / خَشِن, غَلِيظ (قاسٍ أو وقح أو غير مهذّب) / خَشِن, قَاسٍ (صارم بشكل غير سارّ)",
 "てきふてき": "مُلَاءَمَة, مُنَاسَبَة (صفة امتلاك الخصائص الصحيحة لغرض معين)\nمثال: مطلب مهم هو الملاءمة للرحلات الطويلة",
 "てきへい": "عَدُوّ, عَدُوَّة (ركض أو جري) / عَدُوّ (ركض أو جري) / عَدَائِيّ\nمثال: عدو عدوي صديقي.",
 "てきほう": "قَانُونِيّ",
 "てきほうせい": "قَانُونِيَّة, مَشْرُوعِيَّة",
 "てきほうてつづき": "ضَمَان الحُقُوق (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "てきめん": "فَوْرِيّ",
 "てきや": "بائع متجول لبضائع رديئة (بائع لبضائع رديئة) / كاتب إعلانات (شخص يكتب إعلانات الراديو أو التلفزيون)",
 "てきやく": "خَصْم, شَخْص سَيِّئ (أي شخص ليس في صفك)",
 "てきよう": "خُلَاصَة, مُلَخَّص / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "てきようがい": "مُعْفًى",
 "てきようぎょうむ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "てきようじょがい": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة) / إعفاء (خصم مسموح به لدافع الضرائب بسبب وضعه (وجود معالين معينين أو كونه كفيفاً أو تجاوز سن 65 إلخ)) / إعفاء, تحرر (الحصانة من التزام أو واجب)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "てきようせい": "قَابِلِيَّة التَّطْبِيق, مُلَاءَمَة (الصلة بحكم كون الشيء قابلاً للتطبيق على الموضوع المطروح)",
 "てきようはんい": "حَيِّز",
 "てきれい": "تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال)",
 "てきろく": "خُلَاصَة, مُلَخَّص",
 "てきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "てき弾": "قُنْبُلَة, قُنْبُلَة يَدَوِيَّة",
 "てき面": "فَوْرِيّ",
 "てぎれきん": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "てぎわ": "مَهَارَة / أَدَاء / مَسْرَحِيَّة",
 "てぎわよく": "بِفَعَّالِيَّة, بِكَفَاءَة (مع الكفاءة؛ بطريقة فعالة)\nمثال: يعمل بكفاءة",
 "てく": "تَابَعَ, اِسْتَمَرَّ",
 "てくだ": "خدعة, مكيدة (مناورة خادعة (خاصة لتجنب الأسر)) / دَلَال",
 "てくてく": "بإمعان, بتركيز (بانتباه متوتر أو متلهف)\nمثال: استمع بإمعان",
 "てくばり": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "てくび": "مِعْصَم, رُسْغ",
 "てぐさり": "أَصْفَاد, أَغْلَال",
 "てぐち": "روتين, طريقة عمل (طريقة أو إجراء ثابت أو معتاد)",
 "てぐり": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية. / شبكة",
 "てぐりあみ": "شبكة",
 "てぐるま": "عربة دفع, عربة يدوية (مركبة بعجلات يمكن دفعها بواسطة شخص؛ قد يكون لها عجلة واحدة أو عجلتان أو أربع عجلات)\nمثال: استخدم عربة يدوية لنقل الصخور بعيداً",
 "てげ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "てこ": "مُخْل / مُحْل (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه) / عَتَلَة / رَافِعَة\nمثال: أغلق دان المحل. / فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "てこいれ": "إسناد, تدعيم (فعل التدعيم بالدعامات) / تَلَاعُب, تَعْدِيل",
 "てこき": "استمناء, جلك (مصطلحات عامية للاستمناء)",
 "てこぎ": "تَجْدِيف",
 "てこぎボート": "زَوْرَق",
 "てこでもうごかない": "عَنِيد, لَا يَلِين (لَا يَتَأَثَّرُ بِالتَّوَسُّلَاتِ أَوِ الإِقْنَاعِ أَوِ المُنَاشَدَاتِ أَوِ المَنْطِقِ) / ألماس (كربون بلوري طبيعي صلب جداً يُثمن كحجر كريم)",
 "てこでも動かない": "عَنِيد, لَا يَلِين (لَا يَتَأَثَّرُ بِالتَّوَسُّلَاتِ أَوِ الإِقْنَاعِ أَوِ المُنَاشَدَاتِ أَوِ المَنْطِقِ) / ألماس (كربون بلوري طبيعي صلب جداً يُثمن كحجر كريم)",
 "てこね": "اِعْتِجَان",
 "てこもり": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "てこ入れ": "إسناد, تدعيم (فعل التدعيم بالدعامات) / تَلَاعُب, تَعْدِيل",
 "てこ盛り": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "てごころ": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة",
 "てごころをくわえる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "てごたえ": "مُقَاوَمَة / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "てごと": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
 "てごね": "اِعْتِجَان",
 "てごめ": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "てごろ": "فِي مُتَنَاوَل اليَد, قَرِيب (سهل الوصول إليه وقريب) / صَنَاعِيّ, مَاهِر اليَدَيْن (ماهر في العمل اليدوي) / عَمَلِيّ, مُفِيدٌ وَمُلَائِم (مُفِيدٌ وَمُرِيح) / مُنَاسِب, مُلَائِم",
 "てごわい": "صَعْب",
 "てさき": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "てさぎょう": "عمل يدوي (العمل المنجز بالأيدي)",
 "てさぐり": "أَخْرَق, غَيْرُ كُفْء (يُظهر افتقارًا إلى المهارة أو الكفاءة)",
 "てさげ": "حَقِيبَةُ يَد, مَثْبَنَة",
 "てさげかご": "سلة (حاوية عادة ما تكون منسوجة ولها مقابض)",
 "てさげかばん": "حَقِيبَةُ يَد, مَثْبَنَة",
 "てさげぶくろ": "حَقِيبَةُ يَد, مَثْبَنَة",
 "てさげカバン": "حَقِيبَةُ يَد, مَثْبَنَة",
 "てさげバッグ": "حَقِيبَةُ يَد, مَثْبَنَة",
 "てさつ": "بَرِيد / بريد",
 "てさばき": "تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء",
 "てざいく": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "てざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "てしお": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "てしごと": "حرفة يدوية, شغل يدوي (عمل منتج بالعمل اليدوي)",
 "てした": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "てしょく": "حِرْفَة يَدَوِيَّة",
