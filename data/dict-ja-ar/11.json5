 "つもる": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "つや": "بَرِيق / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام / فَائِدَة / رُومَانْسِيَّة / طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "つやけし": "مَصْنَفَر, مُجَمَّد (ذو سطح خشن يشبه الصقيع؛ يُقال عن الزجاج) / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "つやごと": "عَلَاقَة غَرَامِيَّة",
 "つやだし": "رَزَّزَ ((رَزَّزَه): ثَبَّتَه؛ (رَزَّزَه) وطأه ومهده يُقَال: رززت أَمرك عِنْد فلَان ورززت لَك الْأَمر)",
 "つやだね": "عَلَاقَة غَرَامِيَّة",
 "つやっぽい": "رُومَانْسِيّ",
 "つやつや": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "つやつやしい": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "つやめく": "لَمَعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "つやもの": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "つややか": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / مَصْقُول, مُلَمَّع ((عن الورق والقماش والجلد) ذو سطح أملس ولامع خاصة بالضغط بين الأسطوانات) / بَرَّاق, خَدَّاع (قَائِم عَلَى التَّظَاهُر؛ خَادِع المَظْهَر)",
 "つや出し": "رَزَّزَ ((رَزَّزَه): ثَبَّتَه؛ (رَزَّزَه) وطأه ومهده يُقَال: رززت أَمرك عِنْد فلَان ورززت لَك الْأَمر)",
 "つや消し": "مَصْنَفَر, مُجَمَّد (ذو سطح خشن يشبه الصقيع؛ يُقال عن الزجاج) / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "つゆ": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟ / صَلْصَة, مَرَق / نَدَى, طَلّ / بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل / بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "つゆいささかも": "أَبَدًا",
 "つゆしも": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "つゆじも": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "つゆだく": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / حَسَائِيّ (ذُو قِوَامٍ وَمَظْهَرٍ يُشْبِهُ الحَسَاء)",
 "つゆどき": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "つゆにぬれた": "مُبَلَّل بِالنَّدَى, مُنَدًّى (مبلَّل بالندى)",
 "つゆのま": "لَحْظَة",
 "つゆはらい": "راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "つゆほど": "قَلِيلًا",
 "つよい": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / متين (القوّي الشديد الصلب؛ الغليظ القوي)\nمثال: هذا السلم (الدرج) متين للغاية. / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "つよいそうごさよう": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات؛ يتوسطه غلوونات)",
 "つよいちから": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات؛ يتوسطه غلوونات)",
 "つよいところ": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "つよがり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "つよがる": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "つよき": "وَاثِق / مُتَأَكِّد / صُعُودِيّ (يتوقع ارتفاعاً في الأسعار)",
 "つよきしじょう": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "つよきそうば": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "つよさ": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "つよつよ": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "つよふくみしきょう": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "つよみ": "بصوت عالٍ, بقوة (توجيه في الموسيقى؛ للعزف بقوة وصوت عالٍ نسبي) / فورتي, قوي ((تستخدم بشكل رئيسي كتوجيه أو وصف في الموسيقى) تشير إلى أن المقطع المذكور يجب أن يعزف بصوت عالٍ) / الجزء القوي (الجزء الأقوى من نصل السيف بين المقبض والجزء الضعيف) / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: مقاطع الفورتي (القوية) في المقطوعة",
 "つよめ": "تعزيز, تقوية (عملية زيادة قوة شيء ما) / تعزيز, تقوية (أن يصبح الشيء أقوى)",
 "つよめる": "قَوَّى, عَزَّزَ",
 "つら": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "つらあてがましい": "اِنْتِقَامِيّ, حَقُود (يُظهر سوء نية خبيثة ورغبة في الإيذاء؛ مدفوع بالحقد)",
 "つらい": "أَلِيم, مُؤْلِم / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "つらがまえ": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "つらく": "بخشونة, بصرير (بطريقة قاسية ومزعجة للأذن) / بحدة, بخشونة (بطريقة قاسية أو غير لطيفة)\nمثال: وقع صوتها بصرير على آذاننا",
 "つらさ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "つらたん": "أَلِيم, مُؤْلِم / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "つらつき": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "つらつら": "بِعِنَايَة",
 "つらなり": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "つらなる": "مَدَّدَ / اِمْتَدَّ / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "つらにくい": "مُغِيظ, مُهَيِّج (يتسبّب في الغضب أو الاستياء أو يميل إلى ذلك)",
 "つらぬきとおす": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "つらぬき通す": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "つらぬく": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / اِخْتَرَقَ, نَفَذَ / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "つらねる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / وَصْلَة",
 "つらのかわがあつい": "وَقِح, صَفِيق",
 "つらみ": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "つらよごし": "عَار, خِزْي",
 "つらら": "دَلَاة جَلِيدِيَّة / جَلِيد, ثَلْج",
 "つり": "صَيْد سَمَك, صَيْد / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء) / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / مِقْلَاع / حَمَّالَة",
 "つりあい": "رَصِيد",
 "つりあう": "رَصِيد / بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "つりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته. / رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "つりあぶ": "ذبابة النحل (ذبابة مشعرة آكلة للرحيق تشبه النحلة؛ يرقاتها طفيلية على يرقات النحل والحشرات ذات الصلة)",
 "つりいと": "خيط الصيد, سنارة (طول من الحبل يُربط به القائد والعوامة والثقالة والخطاف)",
 "つりうき": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "つりえ": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "つりえさ": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "つりかご": "سلة صيد السمك (سلة خوص يستخدمها الصيادون لحفظ السمك) / غندول, جندول",
 "つりかわ": "رِبَاط",
 "つりがき": "كَاكَا / كَاكِي / بِرْسِيمُون",
 "つりがねがた": "جرس, شكل جرسي (شكل الجرس)",
 "つりがねずみ": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "つりがねそう": "جريس, زهرة الجرس",
 "つりがねどう": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "つりがね型": "جرس, شكل جرسي (شكل الجرس)",
 "つりぐ": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "つりこむ": "اِجْتَذَبَ, جَذَبَ",
 "つりさがる": "دَلَّى",
 "つりさげる": "عَلَّقَ",
 "つりざお": "قَصْبَة صَيْد",
 "つりし": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "つりせん": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "つりて": "علاقة (أي شيء يمكن تعليق شيء منه) / معلّق (عامل يعلق شيئاً ما) / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "つりどうぐ": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "つりどこ": "أُرْجُوحَة شَبَكِيَّة / نقاط الحذف (واحدة من سلسلة من النقاط ('؛') تشير إلى أن شيئاً ما قد تم حذفه أو أن الجملة غير مكتملة)",
 "つりはし": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つりばし": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つりばしこうか": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つりひも": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "つりびと": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "つりふね": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً) / قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
 "つりふねそう": "ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة بأشواك منحنية ولها وريقات خضراء رمادية ناعمة حساسة تطوى وتتدلى في الليل…) / فقوس الحمار, قثاء الحمار (كرمة متوسطية ذات ثمار مستطيلة تطرد بذورها وعصيرها بعنف عند النضج عند لمسها) / بلسم البرتقال, قرط السيدة (نبات حولي في أمريكا الشمالية بأزهار صفراء أو برتقالية عادة؛ ينمو بشكل رئيسي في التربة الرطبة والحمضية نوعاً ما)",
 "つりぶね": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً) / قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
 "つりわ": "حلق, حلقات (جهاز جمباز يتكون من زوج من الحلقات المعدنية الثقيلة (مغطاة عادة بالجلد) معلقة بحبال؛ تستخدم لتمارين الجمباز)\nمثال: تتطلب الحلقات قوة جسدية علوية كبيرة",
 "つりランプ": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "つり上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته. / رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي",
 "つり下げる": "عَلَّقَ",
 "つり合う": "رَصِيد / بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "つり床": "أُرْجُوحَة شَبَكِيَّة",
 "つり橋": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つり橋効果": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つり輪": "حلق, حلقات (جهاز جمباز يتكون من زوج من الحلقات المعدنية الثقيلة (مغطاة عادة بالجلد) معلقة بحبال؛ تستخدم لتمارين الجمباز)\nمثال: تتطلب الحلقات قوة جسدية علوية كبيرة",
 "つり銭": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "つり革": "رِبَاط",
 "つる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / تجعد, كشكشة (طية غير منتظمة في سطح مستوٍ خلاف ذلك (كما في القماش)) / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت / أَغْوَى, أَغْرَى / أَغْرَى / كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تَشَنُّج, شَدٌّ عَضَلِيّ / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / كَفَالَة / كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما) / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "つるあしるい": "بَرْنَقِيل",
 "つるうめもどき": "حلوة مرة يابانية, سيلاستروس ياباني (كرمة زينة آسيوية بثمار برتقالية صفراء مبهرجة مع غلاف قرمزي؛ مستوطنة في أمريكا الشمالية)",
 "つるぎ": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "つるくさ": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つるくび": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "つるこけもも": "توت بري أوروبي, كرانبيري صغير (توت بري زاحف ذو ثمار حمراء صغيرة من المناطق القطبية والباردة في نصف الكرة الشمالي)",
 "つるざ": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "つるし": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "つるしあげ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته. / وَشَى",
 "つるしあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "つるしがき": "كَاكَا / كَاكِي / بِرْسِيمُون",
 "つるしぜめ": "تعليق من الخلف, سترابادو (شكل من أشكال التعذيب حيث تُربط يدا الشخص خلف ظهره ويُرفع عن الأرض بحبل مربوط بمعصميه، ثم يُترك ليسقط حتى يتم وقف سقوطه فجأة بواسطة الحبل)",
 "つるしょくぶつ": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つるし上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته. / وَشَى",
 "つるし上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "つるす": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "つるせい": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "つるせいしょくぶつ": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "つるだち": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "つるっぱげ": "أَقْرَع / أَصْلَع / أَجْرَد",
 "つるつる": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / زَلِق",
 "つるな": "سبانخ نيوزيلاندي (نبات أسترالاسي خشن مترامي الأطراف بأزهار حمراء أو صفراء؛ يزرع لبراعمه الصغيرة الصالحة للأكل وأوراقه العصارية)",
 "つるのこ": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "つるはし": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "つるばみ": "بَلُّوط, بَلُّوطَة",
 "つるまきばね": "زنبرك حلزوني, نابض لولبي (نابض على شكل ملف)",
 "つるむ": "جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "つるり": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "つるれいし": "قَاوُون",
 "つるわれびょう": "ذبول فيوزاريومي (ذبول تسببه فطريات من جنس الفيوزاريوم)",
 "つるん": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "つる割病": "ذبول فيوزاريومي (ذبول تسببه فطريات من جنس الفيوزاريوم)",
 "つる座": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "つる性": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "つる性植物": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "つる植物": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つる草": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つる鋸": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "つる首": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "つれ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "つれあう": "تَزَوَّجَ",
 "つれこ": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "つれこむ": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "つれご": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "つれさり": "اِخْتِطَاف",
 "つれさる": "يَخْطِفّ",
 "つれづれ": "سأم, ضجر (الشعور بالملل من شيء مضجر)",
 "つれて": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "つれていく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "つれてゆく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "つれて行く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "つれない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "つれ込む": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "つわもの": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "つわる": "بُرْعُم / روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, مسار عجل (أخدود أو شق (خاصة في الأرض اللينة الناتج عن العجلات)) / دورة الشبق, شبق (ينطبق على الثدييات غير البشرية: حالة أو فترة من الإثارة الجنسية والنشاط المتزايد)\nمثال: وقعوا في روتين محادثة ممل",
 "つんけん": "بانعزال, بشكل غير اجتماعي (بطريقة غير اجتماعية)\nمثال: يتصرف الجيران الجدد بانعزال شديد",
 "つんざく": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "つんだす": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "つんっと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة) / بحدة, بشكل لاذع (بحدة؛ بطريقة لاذعة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "つんつるてん": "قِصَر (ضد الطول؛ غير تام، غير كامل)",
 "つんつん": "بَعِيدًا عَنّ, بِمَعْزِل عَن / بشدة, بقوة (بقوة أو بطريقة قوية) / بشدة, بقوة (بطريقة قوية)\nمثال: يجادل بقوة لاقتراحه / حَادّ الذُّرْوَة, مُدَبَّب النَّبْرَة (ذو نقاط عالية النبرة بشكل خاصّ أو كأنَّه كذلك) / نكز, وكز (إيماءة يد حادة (تشبه الضربة))\nمثال: حذرني بنكزة بإصبعه",
 "つんと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة) / بحدة, بشكل لاذع (بحدة؛ بطريقة لاذعة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "つんとくる": "جَارِح, لَاذِع (قادر على إيلام المشاعر وجرحها) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "つんとすまして": "بتأنق مفرط, بتزمت (بطريقة متزمتة وأنيقة بشكل مبالغ فيه)\nمثال: المعلمة الجديدة تنفر الأطفال بتصرفها بتزمت",
 "つんと来る": "جَارِح, لَاذِع (قادر على إيلام المشاعر وجرحها) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "つんと澄まして": "بتأنق مفرط, بتزمت (بطريقة متزمتة وأنيقة بشكل مبالغ فيه)\nمثال: المعلمة الجديدة تنفر الأطفال بتصرفها بتزمت",
 "つんなめ": "حَلَزُون",
 "つんぼ": "صَمَم",
 "つーんと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة) / بحدة, بشكل لاذع (بحدة؛ بطريقة لاذعة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "づかれ": "إرهاق, إعياء (فقدان مؤقت للقوة والطاقة ناتج عن عمل بدني أو عقلي شاق)\nمثال: أدخل المستشفى بسبب الإعياء الشديد",
 "づき": "شَامِل / اِنْطِبَاع, أَثَر / تَقْلِيد / حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ) / بَخْت\nمثال: لقد حالفني الحظ. / اجتماعية (الميل للاختلاط بالآخرين وتكوين مجموعات اجتماعية)\nمثال: الثدييات كفئة ليست قوية في الاجتماعيات",
 "づく": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "づくめ": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "づくり": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "づけ": "بَائِد, مُؤَرَّخ (يَحْمِل سِمَات المَاضِي القَرِيب الَّذِي عَادَةً مَا يُسْتَهَان بِه) / مُخَلَّل, كَبِيس",
 "づたい": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "づつ": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات / في آن واحد, في المرة الواحدة (بشكل متزامن)\nمثال: أخذ ثلاث كعكات في المرة الواحدة",
 "づばいもも": "دُرَّاق",
 "づめ": "اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "づら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "づるづる": "بِبُطْء / بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / فَضْفَاض, واسِع",
 "づれ": "بشكل جماعي, معاً (الجميع معاً)\nمثال: خرج الطلاب بشكل جماعي",
 "づれる": "اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة",
 "づんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة / دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "て": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / كف أمامي (الكف الأمامي؛ مناظر لليد البشرية) / مِقْبَض / مُشْكِلَة, مَتاعِب / طَبْعًا / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛ / لِأَنَّ / هكذا, بلا سبب / عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "てあい": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "てあいわり": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "てあかのついた": "بَالٍ",
 "てあき": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط) / غَيْر مَشْغُول, فَارِغ (غَيْر مُنْشَغِل؛ حُرّ ومُتَاح) / خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "てあげ": "جَمِيع أَنْحَاء, كُلّ",
 "てあし": "طَرَف, عُضْو\nمثال: 手足がむくんでいます。 — تورمت قدميّ و يديّ.",
 "てあしをのばす": "مَدَّدَ / اِمْتَدَّ",
 "てあそび": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به) / قِمَار, مُقَامَرَة",
 "てあたりしだい": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "てあつい": "دَافِئ / دَفِيء",
 "てあて": "رَاتِب, أَجْر / رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة)",
 "てあみ": "تريكو, حياكة (صنع الملابس المحاكة) / تريكو, حياكة (أشغال إبرة يتم إنشاؤها عن طريق تشابك الغزل في سلسلة من الحلقات المتصلة باستخدام إبر مستقيمة بلا عيون أو بواسطة آلة)",
 "てあら": "عَنِيف",
 "てあらい": "حُجْرَة التُوَالِيت, حَمَّام (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة. / عَنِيف",
 "てあらいき": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "てあらいだい": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "てあらいば": "دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام)) / مِرْحَاض, تواليت",
 "てあらいばち": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "てあわせ": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس.",
 "てい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها) / الدَّنْمَارْك (دولة تقع في إسكندنافيا في شمال قارة أوروبا، اسمها الرسمي مملكة الدانمارك وعاصمتها كوبنهاغن) / أَخ الْأَصْغَر, أَخ الصَّغِير / تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / عِفَّة, طَهَارَة / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / قَارِب, مَرْكَب (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن / حَزين / خافِت, مُنْخَفِض",
 "ていあん": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ていあんしゃ": "دَاعِم, مُؤَيِّد",
 "ていあんしょ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ていい": "تَاج, إِكْلِيل / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "ていいかぶ": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "ていいち": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "ていいん": "حِصَّة, سَهْم / حِصَّة, نَصِيب مُقَرَّر / سِعَة / مُوَظَّف, مُوَظَّفَة",
 "ていいんわく": "حِصَّة, سَهْم / حِصَّة, نَصِيب مُقَرَّر",
 "ていいんオーバー": "مُحَمَّل فَوْقَ طَاقَتِه (مُحَمَّل بِأَكْثَر مِنْ طَاقَتِه)",
 "ていうか": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "ていえいよう": "سوء التغذية, نقص التغذية (عدم الحصول على ما يكفي من الغذاء للنمو أو العمل بشكل طبيعي)",
 "ていえん": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان.",
 "ていおう": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "ていおうせっかい": "وِلَادَة قَيْصَرِيَّة",
 "ていおうせっかいじゅつ": "وِلَادَة قَيْصَرِيَّة",
 "ていおん": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / انخفاض درجة الحرارة, برد (غياب الحرارة)\nمثال: جعلت البرودة أنفاسنا مرئية / غيتار البيس",
 "ていおんせいぶつがく": "علم الأحياء البردي (فرع علم الأحياء الذي يدرس تأثيرات درجات الحرارة المنخفضة على الأنسجة الحية أو الأعضاء أو الكائنات الحية)",
 "ていおんどうぶつ": "ذوات الدم الحار, كائن ثابت الحرارة (حيوان لديه درجة حرارة جسم ثابتة نسبياً ومستقلة عن درجة حرارة البيئة)",
 "ていおんぶきごう": "مفتاح الباص, مفتاح فا (مفتاح)\nمثال: بحث عن المفتاح.",
 "ていおんぶつりがく": "علم فيزياء درجات الحرارة المتدنية, كرايوجينيك (فرع الفيزياء الذي يدرس الظواهر التي تحدث عند درجات حرارة منخفضة جداً)",
 "ていおんぷ": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "ていか": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / السعر المعلن, سعر القائمة (سعر بيع شيء ما كما هو مذكور في كتالوج أو قائمة أسعار؛ غالباً ما يخضع للخصومات)\nمثال: حصلت عليه بخصم 30% من سعر القائمة",
 "ていかい": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / تأجيل, رفع الجلسة (فعل التأجيل إلى وقت أو مكان آخر)",
 "ていかいはつこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "ていかかくか": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ていかひょう": "قَائِمَةُ أَسْعَار",
 "ていかりつ": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ていかん": "النظام الأساسي للشركة, عقد التأسيس (وثيقة قانونية تنشئ شركة؛ يتم تقديمها إلى الولاية من قبل مؤسسي الشركة وتحكمها قوانين الولاية) / ديادم / اِسْتِقَالَة, اِسْتِعْفَاء / ساق (الساق الخشبية للنخيل وسراخس الأشجار) / أصل, جذع (ساق سميكة مستمرة لنبات معمر عشبي)",
 "ていかんし": "أَدَاةُ تَعْرِيف, أَدَاةُ مَعْرِفَة",
 "ていがくれき": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ていき": "عَادِيّ / مُنْتَظِمٌ / عقد مستقبلي, عقود آجلة (اتفاقية لشراء أو بيع كمية محددة من سلعة أو أداة مالية بسعر معين في تاريخ مستقبلي محدد؛ يمكن بيع العقد قبل تاريخ التسوية) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / مَعْهَد (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم إذا انتأَوا عنهُ رجعوا إليه. الجمع مَعَاهِد. استخدام قديم) / أنشأ (أَوْجَدَ، خَلَقَ؛ بَدَأَ)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا",
 "ていきあつ": "غَيْر ضَاغِط, هَادِئ (ليس قسرياً أو ضاغطاً) / حدة المزاج, سوء المزاج (حالة مزاجية غاضبة مستمرة)",
 "ていきかんこうぶつ": "دوري (يحدث أو يتكرر على فترات منتظمة) / دورية (منشور يظهر في فترات زمنية محددة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "ていきけん": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "ていきこうどく": "اِشْتِرَاك",
 "ていきじょうしゃけん": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "ていきせん": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب) / باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم)) / بطانة (قطعة قماش تستخدم كسطح داخلي للثوب) / بطانة (غطاء واقٍ يحمي سطحاً داخلياً)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "ていきてき": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر) / دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "ていきとりひき": "عقد مستقبلي, عقود آجلة (اتفاقية لشراء أو بيع كمية محددة من سلعة أو أداة مالية بسعر معين في تاريخ مستقبلي محدد؛ يمكن بيع العقد قبل تاريخ التسوية)",
 "ていきどう": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ていきほけん": "تأمين مؤقت (تأمين منخفض التكلفة صالح فقط لفترة زمنية محددة وليس له قيمة استرداد نقدي أو قيمة قرض)",
 "ていきほしゅ": "صيانة دورية, صيانة مجدولة (صيانة في وقت محدد بانتظام)",
 "ていきほぜん": "صيانة دورية, صيانة مجدولة (صيانة في وقت محدد بانتظام)",
 "ていきゅう": "مُنْخَفِض الدَّرَجَة / تَنِس, تِنِس / صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير) / انتفاخ, بصيلة (جزء مستدير من أداة أسطوانية (عادة في أحد الطرفين)) / لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء) / بَصَلَة (اتساع أو تمدد مستدير في قناة أو وعاء أو عضو) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي)\nمثال: بصيلة المحقنة / بُكَاء",
 "ていきゅうげんご": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ていきゅうじょう": "مَلْعَب التِّنِس (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "ていきょう": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة. / رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "ていきょうがわ": "مُرْسِل, مُرْسِلَة",
 "ていきょうしゃ": "مُتَبَرِّع",
 "ていきょうもと": "موفر, مُعِيل (شخص يوفر سبل العيش) / مُزوّد, مُورّد (شخص عمله هو توريد خدمة أو سلعة معينة)",
 "ていきよきん": "وديعة لأجل (شهادة إيداع لا يمكن السحب منها إلا بعد إشعار مسبق أو في تاريخ مستقبلي محدد)",
 "ていきん": "كَمَان",
 "ていきんりせいさく": "ائتمان منخفض الفائدة, مال رخيص (ائتمان متاح بأسعار فائدة منخفضة)",
 "ていぎ": "تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ていぎいき": "مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "ていぎかのう": "قَابِلٌ لِلتَّعْرِيف (يُمْكِنُ تَعْرِيفُهُ أَوْ تَحْدِيدُهُ أَوْ شَرْحُه)",
 "ていぎずみ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ていぎずみへんすう": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ていぎん": "دندنة (فعل الغناء بشفاه مغلقة) / دندنة, همهمة (صوت همهمة)\nمثال: همهمة حركة المرور البعيدة",
 "ていくうひこう": "مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً)",
 "ていけい": "تَعَاوُن / عظم منحرف (عظم الرسغ الواقع بين العظم المربعي والعظم الكبير) / شبه منحرف (شكل رباعي له ضلعان متوازيان)",
 "ていけいこうしょう": "توقف, جمود (انقطاع النشاط الطبيعي) / ارتباط, انتساب (علاقة اجتماعية أو تجارية)\nمثال: انتساب مالي قيم",
 "ていけいてき": "نَمُوذَجِيّ, مِثَالِيّ",
 "ていけいぶん": "قَالَب, قالِب",
 "ていけっとう": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء التغذية)",
 "ていけっとうしょう": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء التغذية)",
 "ていけつ": "عِفَّة, طَهَارَة / نَتِيجَة / إحكام, إرفاق (عملية تثبيت الأشياء ببعضها البعض) / أداة تثبيت, مثبت (قيد يربط بشيء ما أو يثبت شيئاً في مكانه) / تَعَاوُن",
 "ていけつあつしょう": "انخفاض ضغط الدم, هبوط الضغط (انخفاض غير طبيعي في ضغط الدم)",
 "ていけん": "سلطة عليا, سيادة مطلقة (السلطة العليا أو الحكم المطلق) / إمبراطورية (المجال الذي يحكمه إمبراطور أو إمبراطورة؛ المنطقة التي تمارس عليها السيادة الإمبراطورية)",
 "ていげん": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ていげんてき": "غَيْرُ مَشْرُوط, قَاطِع (غير مقيّد بتحفّظات أو استثناءات) / تصنيفي, فئوي (يتعلق بـ أو مدرج في فئة أو فئات)",
 "ていげんてきめいほう": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "ていげんてきめいれい": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "ていげんめいほう": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "ていこう": "مُقَاوَمَة\nمثال: 無駄な抵抗はやめなさい。 — لن تستفيد من المقاومة فلا تحاول. / تثاقل, تردد (درجة معينة من عدم الرغبة) / ممانعة مغناطيسية ((في الفيزياء) ممانعة للفيض المغناطيسي (مناظرة للمقاومة الكهربائية))\nمثال: ممانعة في إلزام نفسه / مُقَاوَمَة / مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي) / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "ていこうかん": "مشاعر مناهضة",
 "ていこうき": "مقاومة (جهاز كهربائي يقاوم تدفق التيار الكهربائي)",
 "ていこうせい": "مُقَاوَمَة",
 "ていこうへんあつき": "محول خفض الجهد (محول يقلل الجهد)",
 "ていこうりつ": "مقاومة, مقاومة كهربائية (ممانعة المادة لتدفق التيار الكهربائي؛ تقاس بالأوم)",
 "ていこうりょく": "مُقَاوَمَة",
 "ていこく": "جَدْوَل مَوَاعِيد, جَدْوَل / إِمْبِرَاطُورِيَّة",
 "ていこくぎかい": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها)",
 "ていこくしゅぎ": "إِمْبِرْيَالِيَّة, اِسْتِعْمَارِيَّة",
 "ていこくしゅぎしゃ": "إِمْبَرِيَالِيّ / إِمْبَرِيَالِيّ, إِمْبِرْيالِيَّة",
 "ていこくしゅぎてき": "إمبريالي, استعماري (من أو متعلق بالإمبريالية)\nمثال: حروب إمبريالية",
 "ていこくどおり": "عَلَى الْمَوْعَدِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ていご": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / خلاف, عدم اتفاق (الفعل الكلامي المتمثل في الاختلاف أو الجدال أو النزاع) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: تباين متزايد في الآراء",
 "ていさ": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "ていさい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "ていさいよく": "بذوق رفيع (بذوق؛ بطريقة تنم عن ذوق)\nمثال: كان المنزل مزيناً بذوق رفيع",
 "ていさつ": "استكشاف (الاستكشاف من أجل الحصول على معلومات)\nمثال: الاستكشاف في أراضي العدو خطير جداً",
 "ていさつえいせい": "قمر تجسس (قمر صناعي مزود بأجهزة استشعار للكشف عن الانفجارات النووية أو المراقبة)",
 "ていさつき": "طائرة استطلاع (طائرة عسكرية تستخدم للحصول على معلومات عن العدو)",
 "ていさつたい": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "ていさんそしょう": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "ていざいは": "موجة راكدة, موجة موقوفة (موجة (كموجة صوتية في غرفة أو موجة كهرومغناطيسية في خط نقل) لا تتغير فيها نسبة سعتها اللحظية عند نقطة واحدة إلى تلك الموجودة عند أي نقطة أخرى بمرور…)",
 "ていし": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض) / إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / يُعَلِّق / تَعْلِيق / تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / وَقْف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / أَحْوَل, مُحَوِّل (ذو عينين نصف مغلقتين من أجل الرؤية بشكل أفضل) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / سَلَالِم",
 "ていしえき": "حمام إيقاف (حمام حمضي يستخدم لإيقاف عمل المظهر في التحميض الفوتوغرافي)",
 "ていしき": "اختيار الألوان, تلوين (اختيار واستخدام الألوان (كما يفعل الفنان)) / اصطباغ, تلوين (المظهر فيما يتعلق باللون) / لون صوتي (جرس الصوت الموسيقي)\nمثال: تلوينها الصحي / صِيغَة",
 "ていしきか": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / تعبير, صياغة (أسلوب التعبير عن النفس) / تركيبة, مستحضر (مادة محضرة وفقاً لصيغة محددة)\nمثال: وصف الطبيب مستحضراً تجارياً للدواء",
 "ていしきかん": "فترة التعطيل",
 "ていしげき": "مِن غَيْر المُرَجَّح أَن يُسَبِّب حَسَاسِيَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ていししんごう": "إشارة المرور, ضوء المرور (إشارة بصرية للتحكم في تدفق حركة المرور عند التقاطعات) / ضوء التوقف, ضوء الفرامل (ضوء أحمر في الجزء الخلفي من المركبة يشير إلى استخدام الفرامل للإبطاء أو التوقف)",
 "ていしせい": "توارٍ عن الأنظار, ظهور منخفض (حالة من قلة الظهور يتم فيها تجنب لفت انتباه الجمهور)\nمثال: لم يكن أبداً ممن يفضلون التواري عن الأنظار",
 "ていしっち": "سَلْخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة) / اِنْسَلَخَ, سَلَخَ\nمثال: سلخ زيري ذلك الغزال.",
 "ていしつ": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / رُسَابَة",
 "ていしつち": "سَلْخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة) / اِنْسَلَخَ, سَلَخَ\nمثال: سلخ زيري ذلك الغزال.",
 "ていしぼうぎゅうにゅう": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "ていしぼうにゅう": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "ていしゃ": "ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة) / حشوة, شريط لحام (مثبت يتكون من شريط ضيق من المعدن الملحوم يستخدم لربط الأعضاء الفولاذية)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً",
 "ていしゃえき": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "ていしゃじょう": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ていしゃば": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ていしゅ": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "ていしゅう": "جِينْغْجُو",
 "ていしゅうは": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها) / تَرَدُّد مُنْخَفِض (30 إلى 300 كيلوهرتز)",
 "ていしゅうははっしんき": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها) / تَرَدُّد مُنْخَفِض (30 إلى 300 كيلوهرتز)",
 "ていしゅく": "عِفَّة, طَهَارَة",
 "ていしゅつ": "إِرَاءَة / إِهْدَاء, مَنْح / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "ていしゅつきげん": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "ていしゅつしゃ": "مانح, متبرع (شخص يقدم هدية أو هبة من ممتلكاته) / راعٍ, مُقدِّم (مدافع يقدم شخصًا (كما في جائزة أو درجة علمية أو مقدمة إلخ)) / مقدّم (شخص يقدم رسالة من نوع ما (مثل عريضة أو خطاب أو شيك أو نصب تذكاري إلخ))",
 "ていしゅつび": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "ていしょ": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "ていしょう": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / مِعْطَاء / محاماة / تَأْييد / مُنَاصَرَة",
 "ていしょうしゃ": "دَاعِم, مُؤَيِّد",
 "ていしょく": "اختيار الألوان, تلوين (اختيار واستخدام الألوان (كما يفعل الفنان)) / اصطباغ, تلوين (المظهر فيما يتعلق باللون) / لون صوتي (جرس الصوت الموسيقي)\nمثال: تلوينها الصحي / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / مِسَاس / صِرَاع, نِزَاع / تَصَادُّم, اِصْطِدَام / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "ていしょとくしゃいりょうふじょ": "رعاية طبية للمحتاجين, ميديكيد (رعاية صحية للمحتاجين؛ برنامج ممول فيدرالياً ومن الولاية (في الولايات المتحدة))",
 "ていしん": "رجل حاشية (مرافق في بلاط الحاكم) / اتصالات, علوم الاتصال (التخصص الذي يدرس مبادئ نقل المعلومات وطرق إيصالها (مثل المطبوعات أو الراديو أو التلفزيون وما إلى ذلك))\nمثال: الاتصالات هي مجال دراسته الرئيسي / مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "ていしんしゅうしゅじゅつ": "ذَات أَقَل تَدَخُّل جِرَاحِيّ, بِأَقَل تَدَخُّل جِرَاحِيّ",
 "ていしんたい": "قوة عسكرية, وحدة عسكرية (وحدة تكون جزءًا من خدمة عسكرية ما)\nمثال: أرسل لقيصر قوة قوامها ستة آلاف رجل",
 "ていじ": "إِرَاءَة / إِهْدَاء, مَنْح / عِلْم اَلْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / بالدور, على التوالي (في ترتيب أو تسلسل مناسب)\nمثال: تحدث إلى كل طفل بدوره / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ていじげん": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ていじせい": "بدوام جزئي (ينطوي على وقت أقل من الوقت القياسي أو المعتاد لنشاط ما)\nمثال: موظفون بدوام جزئي / انضباط, دقة المواعيد (صفة أو عادة الالتزام بالوقت المحدد)",
 "ていじせいこうこう": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "ていじつ": "وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ていじぶ": "مَعْرِض",
 "ていじほう": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب) / عِلْم الْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ていじゅう": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "ていじゅうか": "سكن مؤقت (أماكن معيشة مؤقتة)",
 "ていじゅうしゃ": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ていじゅん": "طَاعَة, إِطَاعَة",
 "ていじょう": "مِعْطَاء / عَادِيّ / مُنْتَظِمٌ",
 "ていじょうは": "موجة راكدة, موجة موقوفة (موجة (كموجة صوتية في غرفة أو موجة كهرومغناطيسية في خط نقل) لا تتغير فيها نسبة سعتها اللحظية عند نقطة واحدة إلى تلك الموجودة عند أي نقطة أخرى بمرور…)",
 "ていす": "مُخَاطَرة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / خَاطَرَ\nمثال: أنا ذاهب للخطر. / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ",
 "ていすいじゅん": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب)",
 "ていすいじゅんげんご": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ていすう": "نِصَاب / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / لَفْظِيّ, حَرْفِيّ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "ていすうぜせい": "إعادة تخصيص, إعادة تقسيم (تقسيم جديد (خاصة تقسيم جديد لمقاعد الكونغرس في الولايات المتحدة على أساس نتائج التعداد))",
 "ていする": "مُخَاطَرة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / خَاطَرَ\nمثال: أنا ذاهب للخطر. / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "ていずいえきあつしょうこうぐん": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "ていせい": "هَمْس / هَمَسَ, وَسْوَسَ / كيفي, نوعي (يتضمن تمييزات مبنية على الصفات أو الخصائص) / نوعي (يتعلق بالمقارنات القائمة على الصفات أو يتضمنها)\nمثال: تغيير نوعي / تَصْحِيح / إِمْبِرْيَالِيَّة, اِسْتِعْمَارِيَّة / قاعي (من أو متعلق بـ أو يحدث في القاع تحت جسم مائي) / بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "ていせいせいぶつ": "بينثوس, قاعيات (كائنات (نباتات وحيوانات) تعيش في أو بالقرب من قاع بحر أو بحيرة أو نهر أو جدول) / النطاق القاعي, منطقة القاع (منطقة تشمل قاع البحر والمناطق الساحلية)",
 "ていせいてき": "كيفي, نوعي (يتضمن تمييزات مبنية على الصفات أو الخصائص) / نوعي (يتعلق بالمقارنات القائمة على الصفات أو يتضمنها)\nمثال: تغيير نوعي",
 "ていせいぶんせき": "تحليل كيميائي, تحليل نوعي (فعل تفكيك مادة إلى عناصرها المكونة)",
 "ていせきぶん": "تكامل محدود (تكامل دالة على فترة محددة)",
 "ていせつ": "عِفَّة, طَهَارَة / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / وِلَادَة قَيْصَرِيَّة",
 "ていせん": "هُدْنَة / هُدْنَة, وَقْفُ نَار\nمثال: この停戦が世界平和に役立つことを私達はみな望んでいる。 — نأمل جميعًا أن يأتي وقف إطلاق النار هذا بسلام عالمي. / تَوْقِيف / خط الساحل, شاطئ (خط الحدود بين اليابسة والماء)",
 "ていせんきょうてい": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "ていせんごうい": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "ていせんりつ": "كانتوس فيرموس, لحن ثابت (لحن موجود مسبقاً يستخدم كأساس لتكوين متعدد الأصوات؛ مستمد أصلاً من الترتيل البسيط، ولكن لاحقاً من مصادر أخرى)",
 "ていぜん": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان.",
 "ていそう": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية) / عِفَّة, طَهَارَة / إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى) / ترويج, تعزيز (النهوض بمشروع ما)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً",
 "ていそうおん": "صَامِت, هَادِئ",
 "ていそうけんご": "عَفِيف, زَكِيّ",
 "ていそうじゅうきょせんようちいき": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع",
 "ていそうじゅうりん": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "ていそく": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ていそくしゃ": "بَطِيء الحَرَكَة (يَتَحَرَّك بِبُطْء)",
 "ていそくすう": "نِصَاب",
 "ていそくギヤ": "الترس الأول, السرعة الأولى (أدنى نسبة تروس أمامية في صندوق تروس المركبة؛ تستخدم لبدء تحرك السيارة)",
 "ていそにん": "مُدَّعٍ, الْمُدَّعِي",
 "ていぞく": "بَذِيء",
 "ていたい": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / رُكُود / ركود اقتصادي / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة)",
