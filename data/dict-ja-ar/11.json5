 "ちゅういぶかく": "بانتباه (مع اهتمام)\nمثال: استمع بانتباه",
 "ちゅういほう": "اسْتِشَارِيّ, نَاصِح (يقدم النصح والمشورة)\nمثال: تحذير من الصقيع",
 "ちゅういりょく": "انتباه, يقظة (سمة كون المرء ملاحظاً ومنتبهاً)\nمثال: يقظته لرغباتها",
 "ちゅういりょくけつじょしょうがい": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "ちゅういりょくさんまん": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "ちゅういをかんきする": "يَقِظ",
 "ちゅういをそそぐ": "أَعَارَ اِنْتِبَاه",
 "ちゅういをはらう": "أَعَارَ اِنْتِبَاه\nمثال: 彼は私の忠告に全く注意を払わなかった。 — لم يعر أي اهتمام لنصيحتي.",
 "ちゅういんふごう": "بُوبُومُوفُو",
 "ちゅうえい": "ظهير نصفي, هاف باك ((كرة قدم أمريكية) مركز ظهير في فريق كرة القدم، عموماً أصغر حجماً من الظهير…) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة)",
 "ちゅうえいご": "إِنْجْلِيزِيَّة وُسْطَى (مُؤَنَّثُ إِنْجْلِيزِيّ، ٌ مُؤَنَّثَةٌ إِلَى ٱلْإِنجليزِ؛ اَللُّغَةُ…)\nمثال: تحدث بالإنجليزية!",
 "ちゅうおう": "مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / رَأْسْمَال, رَأْس مَال / أُورُوبَا الْوَسَطَى (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة.",
 "ちゅうおうえんざんしょりそうち": "وحدَة المعالجَة المَرْكَزِيَّة",
 "ちゅうおうぎんこう": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "ちゅうおうぎんこうデジタルつうか": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "ちゅうおうけいば": "سباق الخيل (رياضة سباق الخيول)",
 "ちゅうおうしょりそうち": "وحدَة المعالجَة المَرْكَزِيَّة",
 "ちゅうおうじょうほうきょく": "سي آي إيه, وكالة الاستخبارات المركزية (وكالة مستقلة تابعة لحكومة الولايات المتحدة مسؤولة عن جمع وتنسيق أنشطة…)",
 "ちゅうおうせん": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "ちゅうおうそろえ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ちゅうおうぞろえ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ちゅうおうち": "وَسِيط",
 "ちゅうおうひょうじゅんじ": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90…)",
 "ちゅうおうぶ": "مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك",
 "ちゅうおうぶんりたい": "وَسِيط",
 "ちゅうおうよせ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "ちゅうおうアジア": "آسِيَا الْوُسْطَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "ちゅうおうアフリカ": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "ちゅうおうアフリカきょうわこく": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "ちゅうおうアメリカ": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "ちゅうおうホール": "أُذَيْن",
 "ちゅうおうヨーロッパ": "أُورُوبَا الْوَسَطَى (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة.",
 "ちゅうおん": "وسطى ((موسيقى) النغمة الثالثة في سلم دياتوني؛ تقع في المنتصف بين نغمة الأساس والنغمة…) / بَارِيتُون (أخفض من مدى التينور وأعلى من الباص)",
 "ちゅうおんふごう": "بُوبُومُوفُو",
 "ちゅうか": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم. / قيظ / اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / قيظ / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم. / رَأْسْمَال, رَأْس مَال",
 "ちゅうかい": "فَاعِلِيَّة\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / بَرِيق / سبيكة",
 "ちゅうかいぎょうしゃ": "سِمْسَار, وَسِيط",
 "ちゅうかいしゃ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / شارح, معلّق نصي (معلّق يكتب ملاحظات توضيحية لنص ما)",
 "ちゅうかいぶつ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうかいやく": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうかがい": "حَيّ صِينِي, تْشَايْنَاتَاوْن (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "ちゅうかく": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين) / نَوَاة",
 "ちゅうかけい": "صِينِيّ",
 "ちゅうかじんみんきょうわこく": "جُمْهُورِيَّةُ الصِّينِ الشَّعْبِيَّةُ",
 "ちゅうかなべ": "وُوك",
 "ちゅうかひ": "الغِلاف المُتَوَسِّط, اللُّبّ (الطبقة الوسطى من غلاف الثمرة)",
 "ちゅうかみんこく": "جُمْهُورِيَّة الصِّين",
 "ちゅうかりょうりてんしょうこうぐん": "متلازمة المطعم الصيني (صداع وشعور بالوخز أو الحرق وتعرق ناتج عن تناول طعام يحتوي على غلوتامات أحادية…)",
 "ちゅうかん": "مُنْتَصَف, وَسَط / وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / انْتِقَالِيّ, مَرْحَلِيّ (يخدم خلال فترة زمنيّة وسيطة)\nمثال: في غضون ذلك، يدير الاشتراكيون الحكومة / نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل!",
 "ちゅうかんえき": "محطة توقف صغيرة (محطة سكة حديد صغيرة بين المحطات الرئيسية أو محطة يتوقف فيها القطار فقط عند…)\nمثال: هناك توقف لتغيير الطائرات في شيكاغو",
 "ちゅうかんぎょうしゃ": "وسيط تجاري (رجل يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من العملاء النهائيين)",
 "ちゅうかんけん": "غلاف أوسط, ميزوسفير (طبقة الغلاف الجوي بين الستراتوسفير والثيرموسفير)",
 "ちゅうかんげんご": "لغة تفاهم مشترك, لغة مشتركة (لغة مشتركة يستخدمها متحدثو لغات مختلفة)\nمثال: كانت لغة الكوينيه لهجة من اليونانية القديمة التي كانت اللغة المشتركة لإمبراطورية الإسكندر الأكبر",
 "ちゅうかんこうさ": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "ちゅうかんこく": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "ちゅうかんさくしゅ": "رشوة تجارية, عمولة غير مشروعة (رشوة تجارية يدفعها البائع لوكيل الشراء لحث الوكيل على الدخول في المعاملة)",
 "ちゅうかんし": "مِيزُون (جسيم أولي مسؤول عن القوى في النواة الذرية؛ هادرون ذو عدد باريوني 0)",
 "ちゅうかんしけん": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "ちゅうかんしゅうはすう": "إِنْ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "ちゅうかんしゅくしゅ": "عائل وسيط (عائل يستخدمه الطفيلي في سياق دورة حياته)",
 "ちゅうかんしょうにん": "وسيط تجاري (رجل يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من العملاء النهائيين)",
 "ちゅうかんせいかぶつ": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "ちゅうかんせつ": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "ちゅうかんせん": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "ちゅうかんそう": "طَبَقَة وُسْطَى",
 "ちゅうかんたい": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "ちゅうかんは": "محايد (مدافع عن الحياد في الشؤون الدولية)",
 "ちゅうかんはいせんばん": "الْجَيْش الْإِسْرَائِيلِيّ, الْجَيْش الدِّفَاع الْإِسْرَائِيلِيّ",
 "ちゅうかんぱん": "السطح الرئيسي (أعلى سطح مغطى يمتد على طول السفينة الكبيرة بالكامل)",
 "ちゅうかんぶ": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين)",
 "ちゅうかんシステム": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "ちゅうがえり": "شقلبة, شقلبة هوائية (حركة بهلوانية تدور فيها القدمان فوق الرأس (إما للأمام أو للخلف) ثم تعودان للأرض)",
 "ちゅうがく": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "ちゅうがくせい": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "ちゅうがたけん": "مُتَوَسِّطُ الْحَجْمِ (متوسط في الحجم)",
 "ちゅうがたトラック": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうがっこう": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "ちゅうがっこうく": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "ちゅうき": "شَلَل, كَسَح / تذييل, تعليق (عملية إضافة ملاحظات)\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "ちゅうきこくさいファンド": "حد أوسط (الحد في القياس المنطقي المشترك بين المقدمتين والمستبعد من النتيجة)",
 "ちゅうきょう": "نَاغُويَا",
 "ちゅうきん": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / وَفَاء, إِخْلَاص / مَمْنُوع اَلمَوْقِف / وردية نهارية (عمال يعملون أثناء النهار (مثل من 8 صباحًا إلى 4 مساءً))",
 "ちゅうぎ": "وَفَاء, إِخْلَاص",
 "ちゅうぎく": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうぎん": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "ちゅうくう": "أَجْوَف / جَوّ / هَوَاء (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ)\nمثال: أخرجي الهواء من فمك.",
 "ちゅうくらい": "مُتَوَسِّط",
