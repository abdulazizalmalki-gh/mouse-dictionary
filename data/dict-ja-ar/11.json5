 "もみしだく": "جَعْدَة / تَجَعُّد, جَعْدَة / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみじ": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "もみじどり": "أَيِّل",
 "もみたてる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "もみほぐす": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみもみ": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "もみりょうじ": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみ上げ": "سَوَالِف, سَالِف اَلشَّعْر",
 "もみ合い": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "もみ殻": "هَشِيم",
 "もみ療治": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみ込む": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もむ": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ جلدَه : فركه بأظفاره)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ) / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "もめ": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "もめごと": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "もめる": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "もめん": "قُطْن, قُطُن / قُطْنِي, قطن",
 "もめ事": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "もも": "خَوْخ / خَوْخَة / دُرَّاق / فِرْسِك",
 "ももいろ": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "ももち": "آلافٌ مُؤَلَّفَة (إحدى فئات الأَعْدَاد، وهي الأعداد التي يكون إلى يَسَارها ثلاثة أعداد أخرى. أكبر من المِئَات وأصغر من المَلايِيين)\nمثال: سيكلفك ذلك عشرة آلاف ين.",
 "ももとせ": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "ももにく": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "ももよ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ももんじいや": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ももんじい屋": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ももんじや": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ももんじ屋": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "もも肉": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "もや": "سَدِيم",
 "もやい": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "もやいづな": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "もやい綱": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "もやう": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "もやくや": "مُشْكِلَة, مَتاعِب / مُنْخَفَض",
 "もやす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "もやもや": "ضَبَابِيّ",
 "もゆるつち": "فَحْم حَجَرِيّ / فَحْم / فحم / فَحَم",
 "もよう": "نُمُوذَج, نَمَط / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "もようしもの": "تَرْفِيه, تَسْلِيَة",
 "もよおし": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "もよおしもの": "تَرْفِيه, تَسْلِيَة",
 "もよおす": "مَسَكَ, مسك / تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "もらい": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "もらいうける": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "もらいて": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "もらいもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "もらいもん": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "もらい受ける": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "もらい手": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "もらい物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "もらう": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "もらす": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "もらたす": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "もり": "حَاضِنَة, مُرَبِّيَة / حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "もりあがる": "اِنْتَفَخَ, وَرِمَ",
 "もりおか": "مُورْيُوكَا",
 "もりかえす": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "もりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "もりたてる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もりだくさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "もりつち": "مَلَأَ",
 "もりど": "مَلَأَ",
 "もりのバター": "أَفُوكَادُو",
 "もりもり": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "もりやく": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "もり立てる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مَلَأَ / وَصَفَ / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "もれ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / إِغْفَال / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "もれきく": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "もれる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "もろ": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / مَعًا, سَوِيًّا",
 "もろい": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "もろがみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "もろくも": "بِسُرْعَة, عَاجِلًا",
 "もろこし": "ذُرَة, سرغوم",
 "もろち": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "もろてをあげて": "قَلْبًا وَقَالَبًا",
 "もろとも": "مَعًا, سَوِيًّا",
 "もろに": "تَمَامًا",
 "もろはのけん": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "もろはのつるぎ": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "もろひと": "الْجَمِيع, كُلّ شَخْص",
 "もろびと": "الْجَمِيع, كُلّ شَخْص",
 "もろみ": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "もろ刃の剣": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "もん": "أُقْنُوم / فَرْد",
 "もんいん": "إِمْبِرَاطُورَة الأُمّ",
 "もんえい": "بَوَّاب, حَاجِب",
 "もんか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "もんかせい": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "もんがいかん": "هَاوٍ, هَاوِيَة",
 "もんがまえ": "بَوَّابَة",
 "もんきりがた": "صُورَة نَمَطِيَّة",
 "もんく": "شِكَايَة, شَكْوَى / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "もんくなく": "بِإِتْقَان, تَمَامًا",
 "もんくなし": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "もんくをいう": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "もんくをつける": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "もんけん": "مَعْلُومَات, مَعْلُومَة",
 "もんげん": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "もんこ": "أَبْوَاب, بَاب",
 "もんごん": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "もんざい": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "もんし": "قَاطِعَة",
 "もんしょう": "شِعَار نَبَالَة (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "もんしょうがく": "عِلْم شِعَارات النَبَالَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もんしん": "مُقَابَلَة",
 "もんじ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "もんじょ": "وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "もんじょう": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "もんじょかん": "أَرْشِيف",
 "もんじるし": "شِعَار نَبَالَة (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "もんじん": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "もんせい": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "もんせき": "لَوْم, مَلَامَة",
 "もんせきけつぎ": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "もんぞう": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "もんだい": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال. / تَمْرِين / جَدَل (الجَدْل: شِدَّة الفَتْل؛ جَدَلَ الشيءَ يَجْدُلُهُ ويَجْدِلُهُ جَدْلًا أَحكم فَتْله)\nمثال: الحصانة البرلمانية قضية مثيرة للجدل. / مُشْكِلَة, مَتاعِب",
 "もんだいいしき": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "もんだいがい": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "もんだいてん": "تَمْرِين / مَسْأَلَة",
 "もんだいない": "عَفْوًا",
 "もんだいナッシング": "عَفْوًا",
 "もんだから": "لِأَنَّ / هكذا, بلا سبب",
 "もんち": "دَرَجَة",
 "もんちゃく": "مُشْكِلَة, مَتاعِب",
 "もんちゅう": "رَصِيف",
 "もんぢゃく": "مُشْكِلَة, مَتاعِب",
 "もんてい": "حَوَارِيّ, تِلْمِيذ",
 "もんで": "لِأَنَّ / هكذا, بلا سبب",
 "もんですか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "もんと": "تَابِع / مُتَابِع",
 "もんどう": "حِوَار, مُحَادَثَة / حِوَار",
 "もんどうほう": "جدلية",
 "もんなし": "فقير",
 "もんばん": "بَوَّاب, حَاجِب",
 "もんび": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "もんぴ": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "もんもう": "أُمِّيَّة / أُمِّيّ",
 "もんもん": "مِحْنَة / أَقْرَن",
 "もんよう": "نُمُوذَج, نَمَط",
 "もー": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / قَرِيبًا, سَرْعَانَ مَا / أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني. / غِي, جِي",
 "もーもー": "خُوَار / خَارَ (صوت حيوان البقر خاصة؛ في : نطقٌ يحدث من الحلق، أي الصوت الذي يصدر من الحلق بشكل مستمر) / مُو\nمثال: السحابة هي كتلة بخار في السماء.",
 "も一つ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "や": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "やあさん": "يَاكُوزَا",
 "やあた": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "やあやあ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / يَاه, اسمع / هَلَا / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "やい": "يَاه, اسمع / هَلَا",
 "やいなや": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "やいのやいの": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "やいば": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان.",
 "やえ": "ثُنَائِيّ / ضِعْف",
 "やえい": "تَخْيِيم",
 "やお": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة",
 "やおい": "يَاوِي",
 "やおもてにたつ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "やおや": "بَقَّال / جاك لجميع المهن",
 "やおら": "بِبُطْء / فَجْأَةً",
 "やかた": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / زِمْلِك, خُصّ / قَمَرَة, قَمْرَة",
 "やかましい": "صَارِخ, صاخِب / زَعْلَان / صَارِم / خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "やかましや": "مُتَصَيِّد الإِخْطَاء",
 "やかまし屋": "مُتَصَيِّد الإِخْطَاء",
 "やから": "طَرَف / حَفْلَة, اِحْتِفَال",
 "やかん": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة.",
 "やかんがいしゅつきんしれい": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "やがい": "خَارِج, بره / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "やがいげき": "اِسْتِعْرَاض",
 "やがて": "قَرِيبًا, سَرْعَانَ مَا / تَقْرِيبًا, عَلَى وَشْك / أَخِيراً",
 "やき": "شَوَى, صَلَى / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "やきあげる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "やきあみ": "شواية / مُصَبَّع / مِشْوَاة / شِوَاء / مَشْوِيَّات / شَوَى, يَشْوِي",
 "やきいれ": "أَنْقَعَ",
 "やきいん": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきいんをおす": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきがた": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "やきがね": "مِيسَم",
 "やきがま": "فُرْن, تَنُّور",
 "やきぐし": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "やきごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきつき": "إِسْتَوْلَى عَلَى",
 "やきつけ": "طِبَاعَة / خَبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "やきつける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خَبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ. / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ. / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "やきなおし": "يتكيف مع",
 "やきなおす": "جَدَّدَ, صقل (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد.",
 "やきなべ": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "やきにく": "شواية / مُصَبَّع / مِشْوَاة / شِوَاء / مَشْوِيَّات / شَوَى, يَشْوِي",
 "やきめ": "لَفَحَ (أَحْرَقَ جِلدًا: غَيَّر لَوْن البَشَرة وأَصابها بالاسْمِرار)",
 "やきめをつける": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر.",
 "やきもち": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やきもの": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "やきゅう": "بَيْسْبُول",
 "やきゅうじょう": "تَقْرِيبِيّ",
 "やきをいれる": "تَعْذِيب / عَذَاب / عَذَّبَ",
