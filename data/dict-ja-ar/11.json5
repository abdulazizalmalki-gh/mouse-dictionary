 "ちょん": "تَصْفِيق / النِهاية / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك)\nمثال: صف من النقاط",
 "ちょんぎる": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ちょんちょん": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "ちょんになる": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "ちょんのま": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت. / ترقيع سريع, حل مؤقت (إصلاح متعجل) / قَلِيلًا",
 "ちょんの間": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت. / ترقيع سريع, حل مؤقت (إصلاح متعجل) / قَلِيلًا",
 "ちょんぼ": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "ちょん切る": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ちょー": "أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "ちょーだい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "ちよ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "ちよよろずよ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "ちらし": "شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / بعثرة, نثر (عملية البعثرة)",
 "ちらす": "نَثَرَ, تَفَرَّقَ / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل. / أَلْهَى",
 "ちらちら": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب) / لمحة, نظرة خاطفة (نظرة سريعة) / بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "ちらっとみる": "لمحة, نظرة خاطفة (نظرة سريعة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "ちらっと見る": "لمحة, نظرة خاطفة (نظرة سريعة)\nمثال: من النافذة استطاع أن يلمح البحيرة لمحة سريعة",
 "ちらつかせる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "ちらつき": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "ちらつく": "وَمِيض, وَمْضَة",
 "ちらばら": "هُنَا وَهُنَاكَ",
 "ちらほら": "هُنَا وَهُنَاكَ / أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "ちらり": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
 "ちらりほらり": "هُنَا وَهُنَاكَ / أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً / دُوَّامَة",
 "ちり": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة. / زُبَالَة, نُفَايَات / جُغْرَافِيَا (هو عِلْم يدرس الأرض والظواهر الطبيعية والبشرية عليها والعلاقات بينهم؛ معتمدا…)\nمثال: كانت لديهم معارف محدودة في الجغرافيا. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / بعثرة, نثر (عملية البعثرة)",
 "ちりあくた": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها)",
 "ちりがく": "جُغْرَافِيَا (هو عِلْم يدرس الأرض والظواهر الطبيعية والبشرية عليها والعلاقات بينهم؛ معتمدا…)\nمثال: كانت لديهم معارف محدودة في الجغرافيا.",
 "ちりがくしゃ": "جُغْرَافِيّ, جُغْرَافِيَّة",
 "ちりがみ": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "ちりくうかん": "جيومكانيّ",
 "ちりし": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "ちりじょうほうシステム": "نظام المعلومات الجغرافية (نظام معلومات للمعلومات الجغرافية)\nمثال: تم تطبيق هذا المشغل على تطبيق نظم المعلومات الجغرافية للهواتف المحمولة",
 "ちりじり": "مُتَفَرِّق",
 "ちりちり": "شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / بشكل مؤلم, بشكل محزن (بشكل غير سار)\nمثال: كان جهله واضحاً بشكل مؤلم",
 "ちりぢり": "مُتَفَرِّق",
 "ちりつく": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "ちりづか": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "ちりてき": "جغرافي (محدد بواسطة الجغرافيا)\nمثال: القطبان الجغرافيان الشمالي والجنوبي",
 "ちりとり": "مِجْرَفَة, مَجْرُود",
 "ちりはらい": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "ちりばめる": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما)",
 "ちりほこり": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "ちりほど": "قَلِيلًا",
 "ちりめん": "كريب (قماش خفيف ناعم ورقيق ذو سطح مجعد)",
 "ちりめんがみ": "ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "ちりめん紙": "ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "ちりゃく": "إدارة, حكم (فعل الحكم؛ ممارسة السلطة)\nمثال: لوائح لحكم سجون الولاية / مَوْرِد",
 "ちりょ": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل)",
 "ちりょう": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري.",
 "ちりょうしゃ": "المعالج",
 "ちりょうてきりゅうざん": "إجهاض علاجي (إجهاض مفتعل قانونياً لأسباب طبية (مثل تهديد حياة الأم))",
 "ちりょうてきクローニング": "استنساخ طبي حيوي, استنساخ علاجي (زرع نووي لخلايا المريض نفسه لصنع خلية بيضية يمكن منها استخلاص خلايا متوافقة…)",
 "ちりょうひ": "نفقة طبية (المبلغ المنفق لتشخيص أو علاج أو الوقاية من المشاكل الطبية)",
 "ちりょうふかのう": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ちりょうふのう": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ちりょうほう": "شِفَاء",
 "ちりょうやく": "عِلَاج, تِرْيَاق",
 "ちりょく": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "ちりんちりん": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "ちり取り": "مِجْرَفَة, مَجْرُود",
 "ちり払い": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "ちり紙": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "ちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / نَثَرَ, تَفَرَّقَ / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "ちるい": "كتلة ناتئة, هورست (حيد من القشرة الأرضية تم دفعه للأعلى بين صدعين ويكون أعلى من الأرض المحيطة)",
 "ちれきせい": "أَسْفَلْت, زِفْت",
 "ちろちろ": "وَمِيض, وَمْضَة / تقاطر, تنقيط (التدفق على شكل قطرات؛ تشكل وسقوط قطرات من السائل)\nمثال: هناك تقاطر عبر السقف",
 "ちわ": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها / آلُو, آلُوْ",
 "ちわっ": "آلُو, آلُوْ",
 "ちわっす": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "ちわぶみ": "رِسَالَةُ حُبٍّ",
 "ちわー": "آلُو, آلُوْ",
 "ちをながす": "سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "ちん": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / صوت الإوز, فحيح (صوت الإوزة (أو أي صوت يشبه هذا)) / مَوْجَة الْمَيْكْرُووِيف, مَوْجَة دَقِيقَة / قَضِيب, ذَكَر / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / نَادِر / غَرِيب, عَجِيب / سبانييل ياباني (سلالة من كلاب الزينة نشأت في اليابان لها معطف حريري أسود وأبيض أو أحمر وأبيض) / وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / مَدِينَة, قَرْيَة / عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة / أَجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل)\nمثال: ركبت سيارة أجرة.",
 "ちんあげ": "زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب)\nمثال: حصل على علاوة بنسبة 3٪",
 "ちんあつ": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة)\nمثال: قمع الهرطقة",
 "ちんうつ": "سَوْدَاوِيَّة",
 "ちんか": "غَرَق / إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "ちんかこう": "عمل بالقطعة (عمل يُدفع أجره وفقاً للكمية المنتجة)",
 "ちんがい": "مضاد للسعال (أي دواء يستخدم لقمع أو تخفيف السعال)",
 "ちんがし": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد)",
 "ちんがり": "استئجار (فعل الدفع مقابل استخدام شيء ما (مثل شقة أو منزل أو سيارة))",
 "ちんき": "غَرِيب, عَجِيب / غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي / ثَمِين",
 "ちんきん": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "ちんぎん": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ちんぎんとうけつ": "تجميد الأجور (تجميد الأجور عند مستوى معين)",
 "ちんぎんりつ": "معدل الأجر (مبلغ المال المستلم لكل وحدة زمنية)\nمثال: معدل أجور النساء أقل من الرجال",
 "ちんぎんろうどうしゃ": "كاسب, متكسب (شخص يكسب أجراً مقابل عمله)",
 "ちんくしゃ": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "ちんけ": "تَافِه, رَخِيص (رديء الجودة جدًا؛ هَشّ)",
 "ちんけい": "حَل التشنج (استرخاء أو تخفيف تشنجات العضلات) / حال للتشنج, مضاد للتشنج (دواء يستخدم لتخفيف أو منع التشنجات (خاصة العضلات الملساء))",
 "ちんけいざい": "دواء مضاد للاختلاج, مضاد اختلاج (دواء يستخدم لعلاج أو منع التشنجات (كما في الصرع))",
 "ちんけいやく": "دواء مضاد للاختلاج, مضاد اختلاج (دواء يستخدم لعلاج أو منع التشنجات (كما في الصرع))",
 "ちんげ": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
