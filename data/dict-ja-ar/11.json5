 "つめみずむし": "سعفة الأظافر (عدوى فطرية في الأظافر (خاصة أظافر القدمين))",
 "つめみだし": "دليل القص, فهرس الإبهام (واحدة من سلسلة من الثلمات المستديرة في الحافة الأمامية للكتاب للإشارة إلى…)",
 "つめもの": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه / حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد)",
 "つめよる": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "つめる": "مُرَبًّى / قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ / زَاوِيَة, رُكْن / قَرَصَ",
 "つめ見出し": "دليل القص, فهرس الإبهام (واحدة من سلسلة من الثلمات المستديرة في الحافة الأمامية للكتاب للإشارة إلى…)",
 "つめ車": "سقاطة (جهاز ميكانيكي يتكون من عجلة مسننة أو رف متشابك مع لسان يسمح له بالتحرك في اتجاه…)",
 "つもり": "قَصْد, إِرَادَة / اِعْتِقَاد / تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "つもりつもる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة.",
 "つもりである": "تَعَمَّدَ, نَوَى / بلا شك, مما لا شك فيه (باستدراك أو تسليم)\nمثال: مما لا شك فيه، هو ليس أينشتاين",
 "つもりでいう": "عَنَى, قَصَدَ",
 "つもりで言う": "عَنَى, قَصَدَ",
 "つもりになる": "تَخَيَّلَ, تَصَوَّرَ",
 "つもる": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "つや": "بَرِيق / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام / فَائِدَة / رُومَانْسِيَّة / طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "つやけし": "مَصْنَفَر, مُجَمَّد (ذو سطح خشن يشبه الصقيع؛ يُقال عن الزجاج) / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "つやごと": "عَلَاقَة غَرَامِيَّة",
 "つやだし": "رَزَّزَ ((رَزَّزَه): ثَبَّتَه؛ (رَزَّزَه) وطأه ومهده يُقَال: رززت أَمرك عِنْد فلَان…)",
 "つやだね": "عَلَاقَة غَرَامِيَّة",
 "つやっぽい": "رُومَانْسِيّ",
 "つやつや": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة)",
 "つやつやしい": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة)",
 "つやめく": "لَمَعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "つやもの": "قصة حب, قصة غرامية (قصة تتناول موضوع الحب)",
 "つややか": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة)",
 "つや出し": "رَزَّزَ ((رَزَّزَه): ثَبَّتَه؛ (رَزَّزَه) وطأه ومهده يُقَال: رززت أَمرك عِنْد فلَان…)",
 "つや消し": "مَصْنَفَر, مُجَمَّد (ذو سطح خشن يشبه الصقيع؛ يُقال عن الزجاج) / تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "つゆ": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء)\nمثال: هل مذاق الشوربة جيد؟ / صَلْصَة, مَرَق / نَدَى, طَلّ / بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل / بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "つゆいささかも": "أَبَدًا",
 "つゆしも": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما)\nمثال: أيام الملك الأخيرة",
 "つゆじも": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما)\nمثال: أيام الملك الأخيرة",
 "つゆだく": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "つゆどき": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار…)",
 "つゆにぬれた": "مُبَلَّل بِالنَّدَى, مُنَدًّى (مبلَّل بالندى)",
 "つゆのま": "لَحْظَة",
 "つゆはらい": "راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "つゆほど": "قَلِيلًا",
 "つよい": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / متين (القوّي الشديد الصلب؛ الغليظ القوي)\nمثال: هذا السلم (الدرج) متين للغاية. / بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "つよいそうごさよう": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات…)",
 "つよいちから": "تفاعل قوي, قوة نووية قوية ((في الفيزياء) التفاعل الذي يربط البروتونات والنيوترونات معاً في أنوية الذرات…)",
 "つよいところ": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "つよがり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "つよがる": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "つよき": "وَاثِق / صُعُودِيّ (يتوقع ارتفاعاً في الأسعار)",
 "つよきしじょう": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "つよきそうば": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "つよさ": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "つよつよ": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "つよふくみしきょう": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "つよみ": "بصوت عالٍ, بقوة (توجيه في الموسيقى؛ للعزف بقوة وصوت عالٍ نسبي)\nمثال: مقاطع الفورتي (القوية) في المقطوعة",
 "つよめ": "تعزيز, تقوية (عملية زيادة قوة شيء ما)",
 "つよめる": "قَوَّى, عَزَّزَ",
 "つら": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك…)\nمثال: قبلتني على الخد.",
 "つらあてがましい": "اِنْتِقَامِيّ, حَقُود (يُظهر سوء نية خبيثة ورغبة في الإيذاء؛ مدفوع بالحقد)",
 "つらい": "أَلِيم, مُؤْلِم / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "つらがまえ": "تَعْبِير",
 "つらく": "بخشونة, بصرير (بطريقة قاسية ومزعجة للأذن)\nمثال: وقع صوتها بصرير على آذاننا",
 "つらさ": "أَلَمٌ (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "つらたん": "أَلِيم, مُؤْلِم / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "つらつき": "تَعْبِير",
 "つらつら": "بِعِنَايَة",
 "つらなり": "سِلْسِلَة, مَجْمُوعَة",
 "つらなる": "مَدَّدَ / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "つらにくい": "مُغِيظ, مُهَيِّج (يتسبّب في الغضب أو الاستياء أو يميل إلى ذلك)",
 "つらぬきとおす": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "つらぬき通す": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "つらぬく": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / اِخْتَرَقَ, نَفَذَ / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "つらねる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / وَصْلَة",
 "つらのかわがあつい": "وَقِح, صَفِيق",
 "つらみ": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "つらよごし": "عَار, خِزْي",
 "つらら": "دَلَاة جَلِيدِيَّة / جَلِيد, ثَلْج",
 "つり": "صَيْد سَمَك, صَيْد / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / صيد بالجر (الصيد عن طريق سحب خط به طعم عبر الماء) / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / مِقْلَاع",
 "つりあい": "رَصِيد",
 "つりあう": "رَصِيد / بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "つりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "つりあぶ": "ذبابة النحل (ذبابة مشعرة آكلة للرحيق تشبه النحلة؛ يرقاتها طفيلية على يرقات النحل والحشرات…)",
 "つりいと": "خيط الصيد, سنارة (طول من الحبل يُربط به القائد والعوامة والثقالة والخطاف)",
 "つりうき": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "つりえ": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "つりえさ": "طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "つりかご": "سلة صيد السمك (سلة خوص يستخدمها الصيادون لحفظ السمك) / غندول, جندول",
 "つりかわ": "رِبَاط",
 "つりがき": "كَاكَا",
 "つりがねがた": "جرس, شكل جرسي (شكل الجرس)",
 "つりがねずみ": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "つりがねそう": "جريس, زهرة الجرس",
 "つりがねどう": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس)",
 "つりがね型": "جرس, شكل جرسي (شكل الجرس)",
 "つりぐ": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "つりこむ": "اِجْتَذَبَ, جَذَبَ",
 "つりさがる": "دَلَّى",
 "つりさげる": "عَلَّقَ",
 "つりざお": "قَصْبَة صَيْد",
 "つりし": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "つりせん": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "つりて": "علاقة (أي شيء يمكن تعليق شيء منه) / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "つりどうぐ": "معدات صيد الأسماك (معدات تستخدم في صيد الأسماك)",
 "つりどこ": "أُرْجُوحَة شَبَكِيَّة / نقاط الحذف (واحدة من سلسلة من النقاط ('؛') تشير إلى أن شيئاً ما قد تم حذفه أو أن الجملة غير…)",
 "つりはし": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つりばし": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つりばしこうか": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つりひも": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط.",
 "つりびと": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة)",
 "つりふね": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً) / قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
 "つりふねそう": "ست المستحية, ميموزا خجولة (شجيرة فرعية مفترشة أو شبه منتصبة من أمريكا الاستوائية وأستراليا؛ مسلحة بشدة…)",
 "つりぶね": "سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً) / قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
 "つりわ": "حلق, حلقات (جهاز جمباز يتكون من زوج من الحلقات المعدنية الثقيلة (مغطاة عادة بالجلد) معلقة…)\nمثال: تتطلب الحلقات قوة جسدية علوية كبيرة",
 "つりランプ": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "つり上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي",
 "つり下げる": "عَلَّقَ",
 "つり合う": "رَصِيد / بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "つり床": "أُرْجُوحَة شَبَكِيَّة",
 "つり橋": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つり橋効果": "جِسْر مُعَلَّق (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "つり輪": "حلق, حلقات (جهاز جمباز يتكون من زوج من الحلقات المعدنية الثقيلة (مغطاة عادة بالجلد) معلقة…)\nمثال: تتطلب الحلقات قوة جسدية علوية كبيرة",
 "つり銭": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "つり革": "رِبَاط",
 "つる": "عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة. / تجعد, كشكشة (طية غير منتظمة في سطح مستوٍ خلاف ذلك (كما في القماش)) / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت / أَغْوَى, أَغْرَى / كُرْكِيّ, غُرْنُوق\nمثال: رفع سامي نظارته. / تَشَنُّج, شَدٌّ عَضَلِيّ / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…) / كَفَالَة / كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما) / قَوْس, قوس / صِلَة, صُلَة",
 "つるあしるい": "بَرْنَقِيل",
 "つるうめもどき": "حلوة مرة يابانية, سيلاستروس ياباني (كرمة زينة آسيوية بثمار برتقالية صفراء مبهرجة مع غلاف قرمزي؛ مستوطنة في أمريكا…)",
 "つるぎ": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "つるくさ": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つるくび": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "つるこけもも": "توت بري أوروبي, كرانبيري صغير (توت بري زاحف ذو ثمار حمراء صغيرة من المناطق القطبية والباردة في نصف الكرة…)",
 "つるざ": "كُرْكِيّ, غُرْنُوق\nمثال: رفع سامي نظارته.",
 "つるし": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "つるしあげ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / وَشَى",
 "つるしあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "つるしがき": "كَاكَا",
 "つるしぜめ": "تعليق من الخلف, سترابادو (شكل من أشكال التعذيب حيث تُربط يدا الشخص خلف ظهره ويُرفع عن الأرض بحبل مربوط…)",
 "つるしょくぶつ": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つるし上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / وَشَى",
 "つるし上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "つるす": "عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة.",
 "つるせい": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة…)",
 "つるせいしょくぶつ": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "つるだち": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة…)",
 "つるっぱげ": "أَقْرَع",
 "つるつる": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / زَلِق",
 "つるな": "سبانخ نيوزيلاندي (نبات أسترالاسي خشن مترامي الأطراف بأزهار حمراء أو صفراء؛ يزرع لبراعمه الصغيرة…)",
 "つるのこ": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "つるはし": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "つるばみ": "بَلُّوط, بَلُّوطَة",
 "つるまきばね": "زنبرك حلزوني, نابض لولبي (نابض على شكل ملف)",
 "つるむ": "جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "つるり": "بسلاسة (بدون مشاكل أو صعوبات)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "つるれいし": "قَاوُون",
 "つるわれびょう": "ذبول فيوزاريومي (ذبول تسببه فطريات من جنس الفيوزاريوم)",
 "つるん": "بسلاسة (بدون مشاكل أو صعوبات)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "つる割病": "ذبول فيوزاريومي (ذبول تسببه فطريات من جنس الفيوزاريوم)",
 "つる座": "كُرْكِيّ, غُرْنُوق\nمثال: رفع سامي نظارته.",
 "つる性": "تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة…)",
 "つる性植物": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "つる植物": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つる草": "كرمة, نبات متسلق (نبات ذو ساق ضعيفة يستمد الدعم من التسلق أو الالتفاف أو الزحف على سطح ما)",
 "つる鋸": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "つる首": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "つれ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "つれあう": "تَزَوَّجَ",
 "つれこ": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "つれこむ": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "つれご": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "つれさり": "اِخْتِطَاف",
 "つれさる": "يَخْطِفّ",
 "つれづれ": "سأم, ضجر (الشعور بالملل من شيء مضجر)",
 "つれて": "كَـ, مِثْل\nمثال: قصدته مثل نكتة.",
 "つれていく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "つれてゆく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "つれて行く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "つれない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "つれ込む": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "つわもの": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي. / سَيِّد\nمثال: يبدو زيري أحسن.",
 "つわる": "بُرْعُم / روتين ممل (روتين ثابت ورتيب يصعب الهروب منه)\nمثال: وقعوا في روتين محادثة ممل",
 "つんけん": "بانعزال, بشكل غير اجتماعي (بطريقة غير اجتماعية)\nمثال: يتصرف الجيران الجدد بانعزال شديد",
 "つんざく": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "つんだす": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "つんっと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "つんつるてん": "قِصَر (ضد الطول؛ غير تام، غير كامل)",
 "つんつん": "بَعِيدًا عَنّ, بِمَعْزِل عَن / بشدة, بقوة (بقوة أو بطريقة قوية)\nمثال: يجادل بقوة لاقتراحه / حَادّ الذُّرْوَة, مُدَبَّب النَّبْرَة (ذو نقاط عالية النبرة بشكل خاصّ أو كأنَّه كذلك) / نكز, وكز (إيماءة يد حادة (تشبه الضربة))\nمثال: حذرني بنكزة بإصبعه",
 "つんと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "つんとくる": "جَارِح, لَاذِع (قادر على إيلام المشاعر وجرحها)",
 "つんとすまして": "بتأنق مفرط, بتزمت (بطريقة متزمتة وأنيقة بشكل مبالغ فيه)\nمثال: المعلمة الجديدة تنفر الأطفال بتصرفها بتزمت",
 "つんと来る": "جَارِح, لَاذِع (قادر على إيلام المشاعر وجرحها)",
 "つんと澄まして": "بتأنق مفرط, بتزمت (بطريقة متزمتة وأنيقة بشكل مبالغ فيه)\nمثال: المعلمة الجديدة تنفر الأطفال بتصرفها بتزمت",
 "つんなめ": "حَلَزُون",
 "つんぼ": "صَمَم",
 "つーんと": "بتحفظ شديد, بتكبر (بطريقة متحفظة وبعيدة)\nمثال: بتحفظ شديد، رفض الدعوة لحفلة المكتب / بشكل لاذع, بنفاذية (بطعم أو رائحة نفاذة)\nمثال: كان الحساء منكهاً بشكل نفاذ / فرقعة (صوت انفجاري حاد كما هو الحال عند إطلاق النار أو سحب الفلين)",
 "づかれ": "إرهاق, إعياء (فقدان مؤقت للقوة والطاقة ناتج عن عمل بدني أو عقلي شاق)\nمثال: أدخل المستشفى بسبب الإعياء الشديد",
 "づき": "شَامِل / اِنْطِبَاع, أَثَر / حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ)\nمثال: لقد حالفني الحظ. / اجتماعية (الميل للاختلاط بالآخرين وتكوين مجموعات اجتماعية)\nمثال: الثدييات كفئة ليست قوية في الاجتماعيات",
 "づく": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "づくめ": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "づくり": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "づけ": "بَائِد, مُؤَرَّخ (يَحْمِل سِمَات المَاضِي القَرِيب الَّذِي عَادَةً مَا يُسْتَهَان بِه) / مُخَلَّل, كَبِيس",
 "づたい": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "づつ": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات / في آن واحد, في المرة الواحدة (بشكل متزامن)\nمثال: أخذ ثلاث كعكات في المرة الواحدة",
 "づばいもも": "دُرَّاق",
 "づめ": "اِحْتَوَى, تَضَمَّنَ",
 "づら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "づるづる": "بِبُطْء / بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة)\nمثال: حركوه بوصة بوصة / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / فَضْفَاض, واسِع",
 "づれ": "بشكل جماعي, معاً (الجميع معاً)\nمثال: خرج الطلاب بشكل جماعي",
 "づれる": "اِنْزَلَقَ, تَزَحْلَقَ",
 "づんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة / دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "て": "يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض)\nمثال: ليس باليد حيلة. / كف أمامي (الكف الأمامي؛ مناظر لليد البشرية) / مِقْبَض / مُشْكِلَة, مَتاعِب / طَبْعًا / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛ / لِأَنَّ / عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "てあい": "مُنَافَسَة, مُبَارَاة",
 "てあいわり": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز)\nمثال: إعاقة القراءة",
 "てあかのついた": "بَالٍ",
 "てあき": "حُرّ, غَيْر مَخْطُوب (لم يُعطِ وعدًا بالزواج؛ غير مرتبط) / خُلُو مِن اَلْعَمَل",
 "てあげ": "جَمِيع أَنْحَاء, كُلّ",
 "てあし": "طَرَف, عُضْو\nمثال: 手足がむくんでいます。 — تورمت قدميّ و يديّ.",
 "てあしをのばす": "مَدَّدَ",
 "てあそび": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به) / قِمَار, مُقَامَرَة",
 "てあたりしだい": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "てあつい": "دَافِئ",
 "てあて": "رَاتِب, أَجْر / رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة)",
 "てあみ": "تريكو, حياكة (صنع الملابس المحاكة)",
 "てあら": "عَنِيف",
 "てあらい": "حُجْرَة التُوَالِيت, حَمَّام (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه…)\nمثال: قعدنا في وسط الحجرة. / عَنِيف",
 "てあらいき": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها…)\nمثال: كان في المغسلة.",
 "てあらいだい": "غَطَسَ",
 "てあらいば": "دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام)) / مِرْحَاض, تواليت",
 "てあらいばち": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها…)\nمثال: كان في المغسلة.",
 "てあわせ": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "てい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها) / الدَّنْمَارْك (دولة تقع في إسكندنافيا في شمال قارة أوروبا، اسمها الرسمي مملكة الدانمارك…) / أَخ الْأَصْغَر, أَخ الصَّغِير / تِلْمِيذ, تِلْمِيذَة / عِفَّة, طَهَارَة / قَاعِدَة / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / قَارِب, مَرْكَب (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن / حَزين",
 "ていあん": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "ていあんしゃ": "دَاعِم, مُؤَيِّد",
 "ていあんしょ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "ていい": "تَاج, إِكْلِيل / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "ていいかぶ": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "ていいち": "مَنْشَأ",
 "ていいん": "حِصَّة, سَهْم / سِعَة / مُوَظَّف, مُوَظَّفَة",
 "ていいんわく": "حِصَّة, سَهْم",
 "ていいんオーバー": "مُحَمَّل فَوْقَ طَاقَتِه (مُحَمَّل بِأَكْثَر مِنْ طَاقَتِه)",
 "ていうか": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "ていえいよう": "سوء التغذية, نقص التغذية (عدم الحصول على ما يكفي من الغذاء للنمو أو العمل بشكل طبيعي)",
 "ていえん": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان.",
 "ていおう": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "ていおうせっかい": "وِلَادَة قَيْصَرِيَّة",
 "ていおうせっかいじゅつ": "وِلَادَة قَيْصَرِيَّة",
 "ていおん": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة. / انخفاض درجة الحرارة, برد (غياب الحرارة)\nمثال: جعلت البرودة أنفاسنا مرئية / غيتار البيس",
 "ていおんせいぶつがく": "علم الأحياء البردي (فرع علم الأحياء الذي يدرس تأثيرات درجات الحرارة المنخفضة على الأنسجة الحية أو…)",
 "ていおんどうぶつ": "ذوات الدم الحار, كائن ثابت الحرارة (حيوان لديه درجة حرارة جسم ثابتة نسبياً ومستقلة عن درجة حرارة البيئة)",
 "ていおんぶきごう": "مفتاح الباص, مفتاح فا (مفتاح)\nمثال: بحث عن المفتاح.",
 "ていおんぶつりがく": "علم فيزياء درجات الحرارة المتدنية, كرايوجينيك (فرع الفيزياء الذي يدرس الظواهر التي تحدث عند درجات حرارة منخفضة جداً)",
 "ていおんぷ": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "ていか": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / السعر المعلن, سعر القائمة (سعر بيع شيء ما كما هو مذكور في كتالوج أو قائمة أسعار؛ غالباً ما يخضع للخصومات)\nمثال: حصلت عليه بخصم 30% من سعر القائمة",
 "ていかい": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع)",
 "ていかいはつこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "ていかかくか": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ていかひょう": "قَائِمَةُ أَسْعَار",
 "ていかりつ": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ていかん": "النظام الأساسي للشركة, عقد التأسيس (وثيقة قانونية تنشئ شركة؛ يتم تقديمها إلى الولاية من قبل مؤسسي الشركة وتحكمها…) / ديادم / اِسْتِقَالَة, اِسْتِعْفَاء / ساق (الساق الخشبية للنخيل وسراخس الأشجار)",
 "ていかんし": "أَدَاةُ تَعْرِيف, أَدَاةُ مَعْرِفَة",
 "ていがくれき": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية)",
 "ていき": "عَادِيّ / عقد مستقبلي, عقود آجلة (اتفاقية لشراء أو بيع كمية محددة من سلعة أو أداة مالية بسعر معين في تاريخ…) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / مَعْهَد (محضر ا لناس ومشهدهم؛ المَوْضِع أو الدَار المعهود بهِ الشيءُ والذي لا يزال القوم…)\nمثال: ويعد هذا المعهد من أفضل المعاهد دوليا",
 "ていきあつ": "غَيْر ضَاغِط, هَادِئ (ليس قسرياً أو ضاغطاً) / حدة المزاج, سوء المزاج (حالة مزاجية غاضبة مستمرة)",
 "ていきかんこうぶつ": "دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "ていきけん": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "ていきこうどく": "اِشْتِرَاك",
 "ていきじょうしゃけん": "تذكرة اشتراك, تذكرة موسمية (تذكرة صالحة لعدة رحلات أو لحضور موسم من الفعاليات الترفيهية؛ تباع بسعر مخفض)",
 "ていきせん": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "ていきてき": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "ていきとりひき": "عقد مستقبلي, عقود آجلة (اتفاقية لشراء أو بيع كمية محددة من سلعة أو أداة مالية بسعر معين في تاريخ…)",
 "ていきどう": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ていきほけん": "تأمين مؤقت (تأمين منخفض التكلفة صالح فقط لفترة زمنية محددة وليس له قيمة استرداد نقدي أو…)",
 "ていきほしゅ": "صيانة دورية, صيانة مجدولة (صيانة في وقت محدد بانتظام)",
 "ていきほぜん": "صيانة دورية, صيانة مجدولة (صيانة في وقت محدد بانتظام)",
 "ていきゅう": "مُنْخَفِض الدَّرَجَة / تَنِس, تِنِس / صراخ, عويل (صرخات عالية أثناء البكاء) / انتفاخ, بصيلة (جزء مستدير من أداة أسطوانية (عادة في أحد الطرفين))\nمثال: بصيلة المحقنة / بُكَاء",
