 "つくねん": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "つくばう": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "つくばだいがくでんしとしょかん": "لَعْلَع",
 "つくばねあさがお": "بيتونيا (أي من الأعشاب الاستوائية العديدة ذات الزهور المخددة على شكل قمع)",
 "つくばる": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "つくよみ": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف. / تْسُوكُويُومِي",
 "つくり": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب. / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / سَاشِيمِي / يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "つくりあげる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / اِفْتَرَى, اِخْتَلَقَ",
 "つくりかえす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "つくりかえる": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "つくりかざる": "اِدَّعَى\nمثال: تظاهر بأنه طبيب.",
 "つくりかた": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / وَصْفَة",
 "つくりかわ": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "つくりがお": "مُخْتَلَق",
 "つくりこみ": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة",
 "つくりこむ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "つくりごと": "فَبْرَكَة",
 "つくりじ": "مُخْتَلَق",
 "つくりたてる": "زَيَّنَ, زَخْرَفَ (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "つくりだす": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / اِخْتَرَعَ",
 "つくりつけ": "مَبْنِيّ, مُدْمَج",
 "つくりつける": "صَلَّحَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "つくりて": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / فَلَّاح, فَلَّاحَة",
 "つくりな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "つくりなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "つくりなき": "تخيل, تمثيل (تجسيد للتظاهر)\nمثال: كان مجرد تمثيل",
 "つくりぬし": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "つくりばな": "زهرة اصطناعية (تقليد مصنوع يدوياً لزهرة)",
 "つくりばなし": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "つくりもの": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / زينة / مَحْصُول",
 "つくりもん": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / زينة / مَحْصُول",
 "つくる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه…)\nمثال: جهز زيري حقائبه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "つくろい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل)",
 "つくろう": "أَصْلَحَ / صَلَّحَ / عَالَجَ",
 "つぐ": "نَجَحَ / مُصَحِّح / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه. / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "つぐない": "مُكَافَأَة, بَدَل",
 "つぐなう": "مُكَافَأَة, بَدَل",
 "つぐのう": "مُكَافَأَة, بَدَل",
 "つぐみ": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة) / وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "つぐむ": "صَمَتَ",
 "つけ": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة. / حبة, قرص (جرعة من الدواء على شكل قرص صغير)\nمثال: اسحب اللسان لفتح العلبة / مَوَدَّة\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / مُؤَثِّر صَوْتِيّ",
