 "ちゅうしゅこつ": "مُشْط الْيَد (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "ちゅうしゅつ": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة))\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع / اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق",
 "ちゅうしゅつぶつ": "مُقْتَطَف",
 "ちゅうしゅつほう": "أخذ عينات, معاينة ((إحصاء) اختيار عينة مناسبة للدراسة)",
 "ちゅうしょう": "تَشْهِير, اِفْتِرَاء / تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "ちゅうしょうか": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "ちゅうしょうかいが": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "ちゅうしょうがいねん": "تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة)",
 "ちゅうしょうげいじゅつ": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "ちゅうしょうせい": "تَجْرِيد, مَعْنَوِيَّة (صفة النظر إلى الشيء بمعزل عن مثال أو كائن محدد)",
 "ちゅうしょうてき": "مُلَخَّص, حاصِل",
 "ちゅうしょうひょうげんしゅぎ": "تعبيرية تجريدية, رسم حركي (مدرسة رسم في نيويورك تتميز بالتجريدات التي تم إنشاؤها بحرية؛ أول مدرسة مهمة…)",
 "ちゅうしょうびじゅつ": "تجريدية, فن تجريدي (نوع تجريدي من الفن؛ يعتمد المحتوى الفني على الشكل الداخلي بدلاً من التمثيل…)",
 "ちゅうしょうめいし": "اِسْم مَعْنًى (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "ちゅうしょく": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "ちゅうしょくかい": "اجتماع غداء, غداء عمل (اجتماع على الغداء؛ عادة لإجراء الأعمال أثناء تناول الطعام)",
 "ちゅうしょくき": "آلة تنضيد الحروف (طابعة تضبط المواد النصية في شكل حروف)",
 "ちゅうしょしょう": "أمانة عامة, سكرتارية (وحدة إدارية مسؤولة عن حفظ السجلات والواجبات الكتابية الأخرى؛ خاصة للمنظمات…)",
 "ちゅうしん": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / مَعْلُومَات, مَعْلُومَة / الإِيمَان / وَفَاء, إِخْلَاص",
 "ちゅうしんか": "نقرة, نقرة مركزية (منطقة تتكون من انخفاض صغير في الشبكية يحتوي على مخاريط وحيث تكون الرؤية أكثر حدة)",
 "ちゅうしんかく": "نِوَاة",
 "ちゅうしんがい": "الشَارِع الرَئِيسِيّ",
 "ちゅうしんぐら": "سَبْعَة وَأَرْبَعُون",
 "ちゅうしんしがいち": "مركز المدينة, وسط المدينة (الجزء المركزي من المدينة)",
 "ちゅうしんしょうたい": "مريكز (إحدى زوج من عضيات خلوية أسطوانية صغيرة قرب النواة في الخلايا الحيوانية؛ تتكون…)",
 "ちゅうしんじんぶつ": "قَائِد, زَعِيم",
 "ちゅうしんせん": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "ちゅうしんたい": "جسيم مركزي (منطقة صغيرة من السيتوبلازم مجاورة للنواة؛ تحتوي على المريكزات وتعمل على تنظيم…)",
 "ちゅうしんち": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "ちゅうしんちゅう": "لَوْحَة تِذْكَارِيَّة",
 "ちゅうしんてき": "مَرْكَزِيّ",
 "ちゅうしんてん": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "ちゅうしんとし": "مركز المدينة, وسط المدينة (الجزء المركزي من المدينة)",
 "ちゅうしんぶ": "قَلْب, فُؤَاد",
 "ちゅうじ": "أذن وسطى, تجويف طبلي (التجويف الرئيسي للأذن؛ بين طبلة الأذن والأذن الداخلية)",
 "ちゅうじえん": "اِلْتِهَاب الأُذُن الوُسْطَى",
 "ちゅうじき": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "ちゅうじく": "مِحْوَر",
 "ちゅうじつ": "وَفِيّ, مُخْلِص\nمثال: هو غبي وغير أمين.",
 "ちゅうじつど": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "ちゅうじてん": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうじゅん": "اِنْتِمَاء",
 "ちゅうじょう": "فريق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / طَاقَم, طَاقِم",
 "ちゅうじん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / مِن الطَّبَقَة المُتَوَسِّطَة (يحتل مكانة اجتماعية واقتصادية متوسطة بين الطبقات الدنيا والأثرياء) / طَاهٍ, طَاهِي",
 "ちゅうすい": "مُلْحَق / علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح…)",
 "ちゅうすいえん": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "ちゅうすいせつじょじゅつ": "اِسْتِئْصَال الزَائِدَة الدُودِيَّة",
 "ちゅうすう": "عَنَى, قَصَدَ / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "ちゅうすうしんけいけい": "الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "ちゅうすうしんけいけいとう": "الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "ちゅうすうせい": "مَرْكَزِيّ",
 "ちゅうせい": "الْعُصُور الْوُسْطَى, الْقُرُون الْوُسْطَى / حِيَاد / لا جنسية (عدم وجود جنس واضح أو أعضاء جنسية) / نَزَاهَة, حِيَاد / وَفَاء, إِخْلَاص",
 "ちゅうせいし": "نْيُوتْرُون, نُوتْرُون",
 "ちゅうせいしせい": "نَجْم نْيُوتْرُونِيّ (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "ちゅうせいしそく": "فَيْض نِيُوتْرُونِيّ (معدل تدفق النيوترونات؛ عدد النيوترونات المارة عبر وحدة المساحة في وحدة الزمن)",
 "ちゅうせいしばくだん": "قُنْبُلَة نْيُوتْرُونِيَّة",
 "ちゅうせいしぼう": "تريغليسريد, دهن ثلاثي (غليسريد يوجد طبيعياً في الأنسجة الحيوانية والنباتية؛ يتكون من ثلاثة أحماض دهنية…)",
 "ちゅうせいしん": "وَفَاء, إِخْلَاص",
 "ちゅうせいてき": "خناثي, خنثوي (لديه خصائص الذكور والإناث معاً)",
 "ちゅうせいびし": "نْيُتْرِينُو",
 "ちゅうせいをつくす": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "ちゅうせいラテンご": "لاتينية العصور الوسطى (اللاتينية المستخدمة للأغراض الدينية خلال العصور الوسطى)",
 "ちゅうせき": "رسوبي, طمي (من أو يتعلق بالطمي (الترسبات النهرية)) / عمود",
 "ちゅうせきそう": "طَمْي, إِبْلِيز",
 "ちゅうせきど": "تربة طميية (تربة خصبة ناعمة الحبيبات ترسبها المياه المتدفقة فوق سهول الفيضانات أو في قيعان…)",
 "ちゅうせきへいや": "سهل طمي (أرض منبسطة ناتجة عن رواسب متكررة من المواد الطميية بواسطة المياه الجارية)",
 "ちゅうせっきじだい": "حجري متوسط, ميزوليثي (من أو متعلق بفترة متوسطة من العصر الحجري (تلي العصر الحجري القديم))",
 "ちゅうせつ": "وَفَاء, إِخْلَاص",
 "ちゅうせん": "يَانَصِيب / وَسِيط",
 "ちゅうせんかい": "يَانَصِيب",
 "ちゅうせんきょくせい": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "ちゅうぜつ": "خِدَاج, إِجْهَاض / إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "ちゅうぜつせいこう": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "ちゅうぜつやく": "حبوب الإجهاض, ميفيبريستون",
 "ちゅうそ": "تَعْلِيق / قاعدة (دعامة أو قاعدة معمارية (كما لعمود أو تمثال))",
 "ちゅうそう": "مُتَوَسِّطُ الْحَجْمِ (متوسط في الحجم) / مِدَكّ",
 "ちゅうそくこつ": "مُشْط اَلْقَدَم (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "ちゅうそっこつ": "مُشْط اَلْقَدَم (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "ちゅうそつ": "مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "ちゅうぞう": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم)",
 "ちゅうぞうしょ": "مسبك, معمل صهر (مصنع يتم فيه إنتاج المسبوكات المعدنية)",
 "ちゅうたい": "سَرِيَّة / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…) / أُسْطُوَانَة",
 "ちゅうだい": "مِصْمَال",
 "ちゅうだいのうどうみゃく": "شريان مخي أوسط (أحد فرعي الشريان السباتي الباطن؛ ينقسم إلى ثلاثة فروع)",
 "ちゅうだん": "مُقَاطَعَة / هُبُوط / خط الوسط, وسط الملعب ((رياضة) الجزء الأوسط من ملعب اللعب (كما في كرة القدم))",
 "ちゅうち": "حشو, داخلة (زائدة يتم إدخالها داخل الكلمة)",
 "ちゅうちゅう": "صَرِير\nمثال: لدى مايوكو حاسة بصر حادة. / فَأْرَة, فَأْر",
 "ちゅうちょ": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "ちゅうちょう": "الْعُصُور الْوُسْطَى, الْقُرُون الْوُسْطَى",
 "ちゅうっぱら": "غَضَب",
 "ちゅうづりぎかい": "برلمان معلق",
 "ちゅうていど": "مُتَوَسِّط",
 "ちゅうてつ": "حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل…)",
 "ちゅうてつかん": "صَلْبٌ كَالحَدِيد (شديد المتانة والصلابة)",
 "ちゅうてつしょ": "مسبك حديد (مسبك يتم فيه إنتاج الحديد الزهر)",
 "ちゅうてん": "جَوّ",
 "ちゅうと": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط",
 "ちゅうとう": "الشَّرْق الْأَوْسَط, مَشْرِق / مُتَوَسِّط, مُعَدَّل / رَأْسْمَال, رَأْس مَال / مِيسَم / سَرِقَة, سَرَقَة / لِصّ, لِصَّة",
 "ちゅうとうがっこう": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "ちゅうとうきょういく": "تعليم ثانوي (التعليم بعد المراحل الابتدائية؛ تقدمه مدرسة ثانوية أو مدرسة تحضيرية للكلية)",
 "ちゅうとうこきゅうきしょうこうぐん": "إنفلونزا الإبل, فيروس كورونا المسبب لمتلازمة الشرق الأوسط التنفسية",
 "ちゅうとうし": "مستخرج الخرطوش (آلية في سلاح ناري تسحب غلاف القذيفة الفارغ من الغرفة وتمرره إلى اللافظ)",
 "ちゅうとうしょこく": "الشَّرْق الْأَوْسَط, مَشْرِق",
 "ちゅうとうぶ": "مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "ちゅうとし": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうとはんぱ": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط",
 "ちゅうとん": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ちゅうとんぐん": "حَامِيَة",
 "ちゅうとんじょ": "عَارِضَة, عَارْضَة\nمثال: نشر توم الغسيل.",
 "ちゅうとんち": "حَامِيَة",
 "ちゅうど": "اِتِّسَاق / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ちゅうどう": "وَسَطِيَّة / مُنْتَصَف, وَسَط",
 "ちゅうどうさは": "يَسَارِيّ (يؤمن بمبادئ اليسار السياسي أو يدعمها)",
