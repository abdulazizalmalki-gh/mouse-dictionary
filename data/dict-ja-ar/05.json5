 "げんしりん": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط…)",
 "げんしろ": "كومة ذرية, مفاعل ذري (مفاعل نووي يستخدم الانشطار النووي المتحكم فيه لتوليد الطاقة)",
 "げんしろたてや": "مُفَاعِل نَوَوِيّ",
 "げんしろん": "ذرية, نظرية ذرية ((كيمياء) أي نظرية تتكون فيها كل المادة من جسيمات صغيرة منفصلة ومحددة وغير قابلة…)",
 "げんしん": "الحُلُول",
 "げんしんクロック": "سَاعَة ذُرِّيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "げんしエネルギー": "طاقة ذرية, طاقة نووية (الطاقة المنبعثة من تفاعل نووي)",
 "げんしプログラム": "برنامج المصدر, كود المصدر (برنامج مكتوب بلغة تُترجم منها التعليمات إلى لغة الآلة)",
 "げんじ": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة. / إزالة المغناطيسية, زوال المغناطيسية (عملية إزالة التمغنط) / الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "げんじつ": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك / شمس كاذبة, شمس وهمية (بقعة ساطعة على الدائرة الشمسية؛ ناتجة عن انكسار الضوء بواسطة بلورات الجليد)\nمثال: عادة ما تُرى شمسين وهميتين أو أكثر في وقت واحد",
 "げんじつか": "تَحْقِيق",
 "げんじつかい": "عَالَم وَاقِعِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "げんじつかん": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "げんじつしゃかい": "عَالَم وَاقِعِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "げんじつしゅぎ": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية)",
 "げんじつしゅぎしゃ": "وَاقِعِيّ",
 "げんじつせい": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً)\nمثال: وصف واقعي",
 "げんじつせいじ": "وَاقِعِيَّة سِيَاسِيَّة (مؤنث وَاقِعيّ، المنسوبة إلى الوَاقِع، حَقِيقِيَّة؛ اسم لحالة الموصوف بأنه…)\nمثال: يجب أن نكون أكثر واقعية؛",
 "げんじつてき": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً)\nمثال: وصف واقعي",
 "げんじつとうひ": "هُرُوب مِن الوَاقِعِ, تَهْرُبِيَّة",
 "げんじつは": "وَاقِعِيّ",
 "げんじつばなれ": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي)",
 "げんじつみ": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "げんじまめ": "مُسَكَّر, مُغَلَّف بِالسُّكَّر (مُغَطّى بطبقة من السكر أو الشراب المركز)",
 "げんじゃく": "نَقْص",
 "げんじゅう": "صَارِم",
 "げんじゅうしょ": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "げんじゅうちゅうい": "عَزْر",
 "げんじゅうみん": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)\nمثال: الأمريكيون الأصليون",
 "げんじゅうるい": "وحشيات أولية (ثدييات بدائية تبيض توجد فقط في أستراليا وتاسمانيا وغينيا الجديدة)",
 "げんじゅつ": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر. / خِطَاب",
 "げんじょう": "صَارِم / مَنْظَر, مَشْهَد / الوَضْع الرَاهِن",
 "げんじょうふざいしょうめい": "دَفْع بِالْغَائِبَة, حُجَّة غِيَاب (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "げんじょうゆうし": "كَمَا هُوَ, كَمَا هِيَ",
 "げんじる": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / قَلَّلَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "げんじん": "سَاحِر",
 "げんす": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "げんすい": "عَقِيْد / تخفيف, وهن (خاصية الشيء الذي تم إضعافه أو تقليل سمكه أو كثافته)\nمثال: توهين في حجم الصوت",
 "げんすいき": "مخفف, موهن (جهاز كهربائي لتخفيف قوة الإشارة الكهربائية)",
 "げんすいりつ": "تخفيف, وهن (خاصية الشيء الذي تم إضعافه أو تقليل سمكه أو كثافته)\nمثال: توهين في حجم الصوت",
 "げんすいりょう": "تخفيف, وهن (خاصية الشيء الذي تم إضعافه أو تقليل سمكه أو كثافته)\nمثال: توهين في حجم الصوت",
 "げんすう": "مَطْرُوح (العدد الذي يراد طرحه من المطروح منه)",
 "げんすうぶんれつ": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده))\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "げんずる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / قَلَّلَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "げんせい": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية) / صَارِم / خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد) / تَقْيِيد, اِقْتِصَار",
 "げんせいいでん": "محدد بالجنس (متعلق بالخصائص التي يتم التعبير عنها بشكل مختلف في الجنسين)",
 "げんせいせいぶつ": "بروتيست, طلائعي (كائنات حرة المعيشة أو مستعمرة ذات أنماط تغذية وتكاثر متنوعة)",
 "げんせいち": "بَرِّيَّة / مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "げんせいどうぶつ": "أوالي, حيوان أولي (أي من الكائنات الدقيقة المتنوعة غير الخلوية أو وحيدة الخلية التي عادة لا تقوم…)",
 "げんせいりん": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط…)",
 "げんせき": "رِكَاز, خَامَة / تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه / مَغْنَاطِيس",
 "げんせきち": "مأوى, مسكن (سكن يعيش فيه شخص ما)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "げんせつ": "التفات, ملاحظة (انتباه صريح)\nمثال: مر الأمر دون ملاحظة / تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "げんせん": "غَوَّاصَة نَوَوِيَّة / مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / خيط معوي, وتر جراحي (حبل قوي مصنوع من أمعاء الأغنام ويستخدم في الجراحة)",
 "げんせんかけながし": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "げんせんしょとくぜい": "ضَرِيبَة اَلدَّخْل",
 "げんせんぜい": "حجز ضريبي, ضريبة الاستقطاع (ضريبة دخل تُستقطع من أجور الموظفين وتدفع مباشرة للحكومة من قبل صاحب العمل)",
 "げんせんちょうしゅうぜいがく": "حجز ضريبي, ضريبة الاستقطاع (ضريبة دخل تُستقطع من أجور الموظفين وتدفع مباشرة للحكومة من قبل صاحب العمل)",
 "げんぜいせいさく": "خفْض الضرائب (عملية تقليل الضرائب)\nمثال: كان التخفيض الضريبي الكبير للإدارة الجديدة مثيراً للجدل للغاية",
 "げんぜん": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري. / وَحِيد, مُنْفَرِد",
 "げんそ": "عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / مَنْشَأ",
 "げんそう": "خَيَال (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / فتحة إطلاق النار, كوة (فتحة (في جدار أو سفينة أو مركبة مدرعة) لإطلاق النار من خلالها)",
 "げんそうきょく": "خَيَال (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "げんそうてき": "رَائِع",
 "げんそく": "مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / من حيث المبدأ (فيما يتعلق بالأساسيات وإن لم يكن فيما يتعلق بالتفاصيل)\nمثال: نحن متفقون من حيث المبدأ / تَباطُؤ / بالجانب العريض, بكامل الجانب (بجانب يواجه شيئاً ما)\nمثال: صدم القطار الشاحنة من جانبها العريض",
 "げんそくざい": "مُشْرِف",
 "げんそくそうち": "ترس تخفيض السرعة (تروس تقلل سرعة الدخل إلى سرعة خرج أبطأ)",
 "げんそくてき": "عَامّ",
 "げんそくとして": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام",
 "げんそしゅうきひょう": "الْجَدْوَلُ الدَّوْرِيّ",
 "げんそしゅうきりつ": "الْجَدْوَلُ الدَّوْرِيّ",
 "げんそしゅうきりつひょう": "القانون الدوري, قانون مندليف ((كيمياء) المبدأ القائل بأن الخواص الكيميائية للعناصر هي دوال دورية لأعدادها…)",
 "げんそん": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "げんぞう": "سَرَاب, شَبَح / إِعْمَار, تَعْمِير",
 "げんぞく": "عَلْمَنَة",
 "げんぞん": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي",
 "げんたい": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "げんたん": "نَقْص",
 "げんたんい": "شِدَّة",
 "げんだい": "الْيَوْمَ, النهارده / العصر الحديث (الأوقات الحالية أو الحديثة) / السلالة المغولية, سلالة يوان (السلالة الإمبراطورية للصين من 1279 إلى 1368)",
 "げんだいか": "تَحْدِيث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره…)\nمثال: تم تحديث القاموس.",
 "げんだいしゅぎ": "حداثة, عصرنة (ممارسات نموذجية للحياة أو الفكر المعاصر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "げんだいっこ": "ابْن شَوَارِع, مُتَمَرِّس (يملك الحيلة والدهاء اللازمَيْن للنجاة في البيئة الحضريّة)",
 "げんだいてき": "عَصْرِيّ, حَدِيث",
 "げんだいふう": "حداثة, عصرية (صفة كونه حالياً أو من الحاضر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "げんだいぶよう": "رقص حديث (أسلوب من الرقص المسرحي ليس مقيداً مثل الباليه الكلاسيكي؛ حيث تكون الحركات معبرة…)",
 "げんだいようご": "مُوَلَّدَة",
 "げんち": "بُقْعَة / التزام",
 "げんちか": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء)",
 "げんちご": "لغة أصلية, لغة محلية (لغة نشأت في مكان محدد ولم يتم جلبها إلى ذلك المكان من مكان آخر)",
 "げんちじかん": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "げんちじん": "أَصْلِيّ",
 "げんちちゅうざいいん": "مُغْتَرِب",
 "げんちちょうさ": "عمل ميداني (تحقيق يتم إجراؤه في الميدان بدلاً من المختبر أو المقر الرئيسي)",
 "げんちゅう": "أوالي, حيوان أولي (أي من الكائنات الدقيقة المتنوعة غير الخلوية أو وحيدة الخلية التي عادة لا تقوم…)",
 "げんちょう": "صَارِم / هلوسة سمعية (إدراك سمعي وهمي لأصوات غريبة غير لفظية) / السلالة المغولية, سلالة يوان (السلالة الإمبراطورية للصين من 1279 إلى 1368) / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / معي بدائي (التجويف المركزي للمعيدة؛ يصبح التجويف المعوي أو الهضمي)",
 "げんちょうはい": "معيدة (مرحلة مزدوجة الجدار للجنين ناتجة عن انغماد الأريمة)",
 "げんちょしゃ": "مُؤَلِّف, مُصَنِّف\nمثال: ألف شكر على لطفك.",
 "げんつき": "سْكُوتَر",
 "げんつきバイク": "سْكُوتَر",
 "げんてい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / جسر مؤقث (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "げんていし": "مُحَدِّدَة / مُقَيِّدٌ",
 "げんていせんそう": "حرب محدودة (حرب هدفها أقل من الهزيمة غير المشروطة للعدو)",
