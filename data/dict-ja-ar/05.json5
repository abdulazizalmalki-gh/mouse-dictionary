 "ここいちばん": "لحظة الحقيقة (لحظة حاسمة يعتمد عليها الكثير)",
 "ここいら": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "ここう": "مصباح قوسي (مصباح ينتج الضوء عند تدفق تيار كهربائي عبر فجوة بين قطبين) / كَفَاف / سُكَّان / بَعِيدًا عَنّ, بِمَعْزِل عَن / مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام)",
 "ここうちょうさ": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "ここうもく": "مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق)",
 "ここかしこ": "هُنَا وَهُنَاكَ",
 "ここち": "شُعُور, إِحْسَاس",
 "ここちいい": "مُرِيح, وَثِير",
 "ここちよい": "مُرِيح, وَثِير",
 "ここつ": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ここであったがひゃくねんめ": "أَخِيرًا",
 "ここで会ったが百年目": "أَخِيرًا",
 "ここで逢ったが百年目": "أَخِيرًا",
 "ここに": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة / الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "ここにおいて": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن. / وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "ここにきて": "مُؤَخَّرًا",
 "ここに来て": "مُؤَخَّرًا",
 "ここの": "تِسْعَة, تسعة",
 "ここのえ": "تسعة أضعاف (بمعامل تسعة)\nمثال: زاد استثماري تسعة أضعاف / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "ここのおびアルマジロ": "مدرع تساعي الأحزمة (له تسعة أحزمة مفصلية من الصفائح العظمية؛ يمتد نطاقه من تكساس إلى باراغواي)",
 "ここのこえをあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "ここのつ": "تِسْعَة, تسعة",
 "ここのつどき": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "ここのところ": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ここの所": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ここまできたら": "بِمَا أَنّ, أَمَا وَأَنّ",
 "ここまで来たら": "بِمَا أَنّ, أَمَا وَأَنّ",
 "ここもと": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "ここら": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "ここらあたり": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "ここらへん": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "ここら辺": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "ここら辺り": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "こころ": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "こころあたり": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "こころあたりのない": "مُفَاجِئ",
 "こころあて": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "こころある": "عَمِيق اَلتَّفْكِير / حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول / ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد)\nمثال: ناقد فطن",
 "こころいき": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "こころいわい": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "こころうつり": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "こころえ": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي / استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب / نَائِب, نَائِبَة",
 "こころえちがい": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "こころえる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こころおきなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "こころおくれ": "تردد, عدم الثقة بالنفس (انعدام الثقة بالنفس)",
