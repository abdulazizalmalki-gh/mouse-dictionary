 "こころだのみ": "اتكال, اعتماد (يقين مبني على الخبرة السابقة)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "こころづかい": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "こころづく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "こころづくし": "إِحْسَان",
 "こころづけ": "مكافأة تقديرية (مكافأة (كما في الخدمة الجديرة بالتقدير) تُعطى دون مطالبة أو التزام)",
 "こころづもり": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "こころづよい": "بَاعِثٌ لِلأَمَل, مُبَشِّر (يُشجِّع بطريقة تبعث البهجة والأمل)",
 "こころない": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين)\nمثال: سلوك مستهتر بشكل صادم / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "こころなし": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "こころなしか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "こころならずも": "دُونَ رَغْبَة, عَلَى مَضَض (بطريقة غير راغبة)\nمثال: لقد أخطأ بحقها كرهاً",
 "こころにえがく": "تَخَيَّلَ, تَصَوَّرَ",
 "こころにかける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころにくい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "こころにそむ": "بَذْلَة, بَدْلَة\nمثال: تمثال الحرية رمز لأمريكا.",
 "こころにとどめる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころにとめる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころにひめる": "احتفظ بكل شيء لنسفه",
 "こころにもない": "زائف, غير مخلص (يفتقر إلى الإخلاص)\nمثال: امرأة ساحرة ولكنها غير مخلصة تماماً",
 "こころね": "قَلْب, فُؤَاد / طَبِيعَة, طبيعة",
 "こころのいたみ": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "こころのいろ": "إِحْسَان",
 "こころのかて": "غذاء للفكر, مادة للتفكير (أي شيء يوفر حافزاً عقلياً للتفكير)",
 "こころのきんせん": "أوتار القلب, شغاف القلب (أعمق مشاعر الحب والرحمة لديك)\nمثال: العديد من حالات التبني تلامس شغاف القلب",
 "こころのこり": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "こころのささえ": "دعم معنوي (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "こころのせまい": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية)\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "こころのたいら": "مُعْتَدِل المِزَاج, هَادِئ الطَّبْع (لا يُستثار بسهولة؛ رَزين وثابت المزاج)",
 "こころのどこかで": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "こころのひろい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "こころのびょうき": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "こころのぶつかりあい": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "こころのまずしい": "بخيل, شحيح (غير راغب في إنفاق (المال، الوقت، الموارد، إلخ))\nمثال: تمارس الاقتصاد دون أن تكون بخيلة",
 "こころのやさしい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "こころのやまい": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "こころのりろん": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "こころばえ": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة. / طَبِيعَة, طبيعة",
 "こころばかり": "صَغِير, صغير",
 "こころひそかに": "دَاخِلِيًّا, فِي السِّرّ (فيما يتعلق بالمشاعر الخاصة)\nمثال: داخلياً، كانت تغلي غضباً",
 "こころぼそい": "عَاجِز",
 "こころまち": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "こころみ": "حَاوَلَ (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا! / جهد, محاولة (نشاط جاد وواعي يهدف إلى فعل أو إنجاز شيء ما)\nمثال: بذل جهدًا لتغطية جميع مواد القراءة",
 "こころみる": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا!",
 "こころむ": "حَاوَلَ (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا!",
 "こころもち": "شُعُور, إِحْسَاس / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / إلى حد ما, باعتدال (إلى حد أو درجة معينة)\nمثال: كبير جداً",
 "こころもとない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَصَبِيّ / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "こころやさしい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "こころやすい": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "こころやすだて": "صراحة (سمة كون المرء صريحاً ومباشراً)",
 "こころやすめ": "مُوَاسَاة",
 "こころやすらか": "هَادِئ",
 "こころやぶれ": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "こころやり": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "こころよい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "こころよく": "بارتياح, برغد (في راحة مالية)\nمثال: يعيشون برغد / طَوْعًا, طَوَاعِيَةً",
 "こころより": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "こころよわい": "حَسَّاس, رَقِيقُ القَلْب (يتأثّر بسهولة بمعاناة الآخرين وضيقهم)",
 "こころをいたす": "كَرَّسَ, قَدَّمَ",
 "こころをいためる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "こころをいれかえる": "إِصْلَاح",
 "こころをうごかす": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "こころをうつ": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "こころをくだく": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "こころをくばる": "أَعَارَ اِنْتِبَاه",
 "こころをこめて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "こころをとらえる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "こころをゆるす": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء.",
 "ここをせんどと": "باتقاد, بحرارة (بحماس وعاطفة متقدة)\nمثال: كل من المؤيدين والمعارضين مقتنعون بحرارة أنهم يتحدثون باسم الغالبية العظمى من الناس",
 "ここを先途と": "باتقاد, بحرارة (بحماس وعاطفة متقدة)\nمثال: كل من المؤيدين والمعارضين مقتنعون بحرارة أنهم يتحدثون باسم الغالبية العظمى من الناس",
 "ここんとこ": "مُؤَخَّرًا",
 "ここん所": "مُؤَخَّرًا",
 "ここ一番": "لحظة الحقيقة (لحظة حاسمة يعتمد عليها الكثير)",
 "こご": "أركايك, تعبير قديم (استخدام تعبير قديم)",
 "こごう": "مُحَارِب قَدِيم",
 "こごえ": "هَمْس",
 "こごえる": "تَجَمَّدَ",
 "こごし": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "こごしゅうい": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "こごと": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة) / شِكَايَة, شَكْوَى",
 "こごまる": "قَوْس, قوس",
 "こごみ": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "こごむ": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "こごめぐさ": "عَرْقُون",
 "こごめる": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل)",
 "こごらす": "تَجَمَّدَ / تَفَكَّرَ, فَكَّرَ",
 "こごらせる": "تَجَمَّدَ",
 "こごり": "تجمّد, تخثر (عملية التجمد؛ التصلب عن طريق (أو كما لو كان عن طريق) التجميد)",
 "こごる": "تَجَمَّدَ",
 "こごろし": "قتل الرضيع, وأد (قتل طفل رضيع)",
 "こさい": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / براعة, ذكاء (خاصية كون الشخص بارعاً)\nمثال: حبكة ذات براعة كبيرة",
 "こさいきん": "بكتيريا قديمة, عتائق (تُعتبر أشكال حياة قديمة تطورت بشكل منفصل عن البكتيريا والطحالب الخضراء المزرقة)",
 "こさえる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه…)\nمثال: جهز زيري حقائبه. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "こさぎ": "بلشون أبيض صغير (بلشون من العالم القديم)",
 "こさくにん": "إِرِّيس",
 "こさじ": "مِلْعَقَة شَاي, مِلْعَقَة صَغِيرَة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "こさっぱりした": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة)",
 "こさつ": "قتل خطأ, قتل غير متعمد (قتل دون سبق إصرار وترصد)",
 "こさむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة)",
 "こさめ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ)\nمثال: 昨日は小雨だった。 — أمطرت مطراً خفيفاً البارحة.",
 "こさん": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير",
 "こさんしゃ": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير",
 "こさんへい": "مُحَارِب قَدِيم",
 "こざい": "أَلْصَقَ",
 "こざかしい": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء) / مَاكِر",
 "こざかな": "قَلَى",
 "こざっぱり": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة)",
 "こし": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / مُسْتَدَقّ الظَّهْر / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول) / حَمَّالَة, مِحَفَّة",
 "こしあて": "صخب, ضجة (اضطراب نشط وسريع) / واقي ورك (ملابس واقية تتكون من وسادة يرتديها لاعبو كرة القدم والهوكي) / واقي الفخذ العلوي (واحدة من قطعتين من الدرع الصفيحي تتدليان من تنورة الدرع لحماية الفخذين العلويين)",
 "こしあん": "دَقِيقُ الْحُبَيْبَاتِ, مُتَرَاصّ (كثيف أو متراصّ البنية كخشب مؤلّف من خلايا صغيرة القطر)",
 "こしいれ": "عُرْس, زِفَاف",
 "こしお": "مد المحاق, مد ناقص (مد أقل من المتوسط يحدث في الربعين الأول والثالث للقمر)",
 "こしおび": "كورسيه, مشد (رداء داخلي نسائي ضيق ومشكّل)",
 "こしおれ": "مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / تعطيل, مماطلة (تكتيك يستخدم للتضليل أو التأخير)",
 "こしおれやね": "سقف جامبريل, سقف جملوني مزدوج الميل (سقف جملوني له ميلان على كل جانب ويكون الميل السفلي أكثر انحداراً)",
 "こしかけ": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "こしかけだい": "بِنْش",
 "こしかける": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "こしかた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "こしかべ": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "こしがある": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "こしがかるい": "مُتَسَرِّع",
 "こしがき": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "こしがくだける": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "こしがつよい": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "こしがひくい": "مُتَوَاضِع\nمثال: لقد أزمت الوضع.",
 "こしがひける": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "こしがみ": "ورق ترشيح (ورق مسامي غير معالج يستخدم للترشيح)",
 "こしき": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة…) / مِصْفَاة / صرة, محور العجلة (الجزء المركزي لعجلة السيارة (أو المروحة ونحوها) الذي يمر من خلاله العمود أو…)\nمثال: الملعب هو محور إشراف الوالدين",
 "こしきゆかしい": "تَقْلِيدِيّ",
 "こしぎんちゃく": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "こしけ": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "こした": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "こしたんたん": "بحذر, بيقظة (بطريقة يقظة)",
 "こしだ": "الْعَالَم الْقَدِيم",
 "こしだか": "مُتَسَلِّط",
 "こしつ": "أَحَادِيّ\nمثال: رأيت واحدة مرة. / مَعْلِف, مُرَاح / أذن وسطى, تجويف طبلي (التجويف الرئيسي للأذن؛ بين طبلة الأذن والأذن الداخلية) / التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين)\nمثال: الالتزام بأجندة رسمية",
 "こしつき": "مشية (طريقة مشي الشخص)",
 "こしづよ": "عَنِيد / لَزِج",
 "こしなわ": "رِبَاط",
 "こしぬけ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こしぬの": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "こしのある": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "こしのくびれ": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "こしのつよい": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "こしのひくい": "مُتَوَاضِع\nمثال: لقد أزمت الوضع.",
 "こしばい": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "こしばき": "مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف)",
 "こしばめ": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "こしばり": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة)",
 "こしぼね": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة) / ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "こしまき": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "こしみの": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
