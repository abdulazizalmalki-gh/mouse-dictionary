 "しょはつ": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "しょはん": "مُخْتَلِف, مُتَنَوَّع",
 "しょば": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "しょばつ": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "しょびく": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "しょぶん": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "しょほ": "أَسَاسِيّ",
 "しょほう": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "しょほうせん": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "しょほてき": "أَسَاسِيّ",
 "しょぼい": "بَالٍ",
 "しょぼう": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس. / مَكْتَبَة",
 "しょぼくれる": "يَئِسَ, أُحْبِطَ",
 "しょぼしょぼ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "しょぼつく": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "しょみん": "الْجَمَاهِير, العَامَّةُ",
 "しょみんいん": "مَجْلِس عُمُوم",
 "しょみんぎんこう": "مرهن",
 "しょみんてき": "مَحْبُوب",
 "しょむ": "مَهَمَّة / عَمَل, وَظِيفَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "しょめい": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "しょめいしゃ": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "しょめん": "وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "しょもう": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "しょもつ": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "しょゆう": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "しょゆうけん": "مُلْكِيَّة",
 "しょゆうざいさん": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "しょゆうしゃ": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "しょゆうち": "مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "しょゆうぬし": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "しょゆうぶつ": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "しょよ": "بَيَانَات, مَعْلُومَات",
 "しょよう": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "しょり": "مُعَالَجَة",
 "しょりかてい": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "しょりきこう": "مُعَالِج",
 "しょりけい": "تَنْفِيذ",
 "しょりずみ": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "しょりそうち": "مُعَالِج",
 "しょりぶ": "مُعَالِج",
 "しょりょう": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "しょりょく": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "しょりん": "مَكْتَبَة",
 "しょるい": "وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しょるいかばん": "حَقِيبَة, مِحْفَظَة",
 "しょるいしごと": "أَوْرَاق",
 "しょるいじむ": "أَوْرَاق",
 "しょるいカバン": "حَقِيبَة, مِحْفَظَة",
 "しょれつ": "أَوَّلِيّ / خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "しょろう": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "しょろん": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "しょわけ": "تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "しょをさける": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "しょんどい": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "しょんべん": "بَوْل",
 "しょんべんをする": "تَبَوَّلَ, بَالَ",
 "しょんべんをたれる": "بَوْل / بَوَّلَ / بِيه, پِي",
 "しょーがない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مُزْعِج",
 "しょーもない": "غَبِيّ / غَبِيّ, أَحْمَق",
 "しょ引く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "しょ糖": "سكروز",
 "しよ": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "しよう": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مُوَاصَفَة",
 "しよういき": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "しようかのう": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "しようかのうせい": "تَوَفُّر",
 "しようがき": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ / مُوَاصَفَة",
 "しようがない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مُزْعِج",
 "しようきげん": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しようきょか": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "しようけん": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "しようしゃ": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "しようしょ": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ / مُوَاصَفَة",
 "しようじょうけん": "ضَرُورَة / مَطْلَب, طَلَب",
 "しようずみ": "مُسْتَعْمَل (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "しようちゅう": "مَحْجُوز / مَشْغُول / مُحْتَلّ",
 "しようにん": "مُوَظَّف, مُوَظَّفَة",
 "しようのない": "عَنِيد / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "しようふか": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "しようほう": "إرشادات",
 "しようほうほう": "إرشادات",
 "しようもない": "غَبِيّ / غَبِيّ, أَحْمَق",
 "しようりょう": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "しよく": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "しら": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / بِدِقَّة / نَزِيه, صَادِق",
 "しらかべ": "تُوفُو, توفو",
 "しらかみ": "خَرْبَشَ",
 "しらがまじり": "شائِب",
 "しらく": "فَصْد",
 "しらくぼ": "سَعْفَة, قَرَع",
 "しらくも": "سَعْفَة, قَرَع",
 "しらけ": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "しらげる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "しらこ": "أَمْهَق",
 "しらこい": "شَفَّاف",
 "しらこばと": "فَاخِتَة",
 "しらしら": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "しらしらあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "しらじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "しらじら": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "しらじらあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "しらじらしい": "شَفَّاف",
 "しらす": "أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しらずしらず": "لَاشُعُورِيًّا",
 "しらせ": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة. / فَأل, نَذِيْر",
 "しらせる": "أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "しらた": "خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "しらたえ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "しらちゃ": "شَاي أَبْيَض (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "しらちゃけた": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "しらつち": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "しらとり": "تَمّ, قُقْنُس",
 "しらない": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しらなみ": "لِصّ, لِصَّة",
 "しらぬかお": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "しらぬがほとけ": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "しらはたけ": "بُهَاق",
 "しらはだ": "بُهَاق",
 "しらはだけ": "بُهَاق",
 "しらびと": "هَاوٍ, هَاوِيَة",
 "しらびょうし": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "しらべ": "تَحْقِيق / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "しらべおび": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "しらべもの": "تَحْقِيق",
 "しらべる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "しらみ": "قَمْلَة, قَمْل / قِمْلَة",
 "しらみつぶしに": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "しらむ": "بَيَّضَ, اِبْيَضَّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض. / بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "しらゆきひめ": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "しられざる": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض",
 "しらん": "مَوْهِبَة",
 "しらんかお": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "しり": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن. / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / عَاقِبَة / نَتِيجَة",
 "しりあい": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "しりあがり": "تَحْسِين",
 "しりあげむし": "شَوَّالَة",
 "しりあな": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "しりいん": "مُوَظَّف, مُوَظَّفَة",
 "しりえ": "خَلْفِيّ",
 "しりお": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب. / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "しりおし": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / مُحَرِّض, مُحَرِّضَة",
 "しりおも": "كَسُول, مِكْسَال",
 "しりがい": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "しりがおもい": "كَسْلَان / أَخْرَق",
 "しりがかるい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "しりがる": "فَضْفَاض, واسِع / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / طَفْح, طَفْح جِلْدِيّ",
 "しりくせ": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ)",
 "しりこそばゆい": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しりこぶた": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "しりしよく": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "しりぞく": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / اِسْتَقَالَ",
 "しりぞける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / طَرَدَ",
 "しりたたき": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "しりたぶ": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "しりたぶら": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "しりっぽ": "خَلْفِيّ / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "しりつ": "مَدَنِيّ",
 "しりにしく": "سَيْطَرَ",
 "しりのあな": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "しりびと": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "しりぺんぺん": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "しりめ": "إِهْمال",
 "しりめにかける": "تَرَفَّعَ",
 "しりゅう": "رَافِد",
 "しりょ": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "しりょう": "أَرْشِيف",
 "しりょうかん": "أَرْشِيف",
 "しりょく": "بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "しりょくしょうがい": "عَمًى",
 "しりょぶかい": "حَرِيص, حَكِيم / حَرِيص",
 "しりをあげる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "しりをすえる": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "しりをたたく": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "しりをまくる": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "しる": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟",
 "しるか": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しるけ": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "しるし": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا. / شَارَة / دَلِيل, بُرْهَان / دَلِيل",
 "しるしばた": "بِطَاقَة هُوِيَّة",
 "しるす": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة) / ذَكَرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "しるひと": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / عَاشِق, عَاشِقَة / مُغْرَم",
 "しるべ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "しるもの": "شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟",
 "しれい": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "しれいかん": "قَائِد, قُمَنْدَان",
 "しれいちょうかん": "رَئِيس أَرْكَان",
 "しれいとう": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / قَائِد, زَعِيم",
 "しれいぶ": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "しれごと": "هُرَاء, لَغْو",
 "しれた": "بَدِيهِيّ, بَدَهِيّ / تافِه",
 "しれつ": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "しれつきょうせいき": "مُقَوَّم أَسْنَان",
 "しれもの": "مُغَفَّل, أَحْمَق",
 "しれわたる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "しれん": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "しろ": "قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "しろあり": "أَرَضَة",
 "しろい": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة. / بَرِيء, بَرِيئَة / بَرِيء / لَامِع, نَيِّر / مُسْتَنِير",
 "しろいし": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "しろいたち": "اِبْنُ مِقْرَض (الولد الذكر)\nمثال: هو له ابن صغير.",
 "しろいもの": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "しろいろ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "しろうんも": "مُوسْكُوفِيّ",
 "しろえりはげわし": "نسر أسمر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "しろかね": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "しろかび": "تَعَفُّن, عُفُونَة",
 "しろがね": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "しろがらし": "خَرْدَل أَبْيَض",
 "しろく": "أَرْبَعَة وَعِشْرُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "しろくじちゅう": "على مدار اليوم (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "しろくま": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "しろげ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "しろこ": "أَمْهَق",
 "しろしめす": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "しろじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "しろた": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "しろたえ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "しろちゃ": "شَاي أَبْيَض (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "しろてん": "قَاقِم",
 "しろという": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "しろとり": "تَمّ, قُقْنُس",
 "しろと言う": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
