 "ずする": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "ずず": "مِسْبَحَة, سُبْحَة",
 "ずせつ": "مُخَطَط, رَسْم إِيضَاحِيّ / رَسْم بَيَانِيّ, مُخَطَط (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずそ": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "ずぞう": "قُونَة, أَيْقُونَة / أَيْقُونَة",
 "ずぞうがく": "علم رسم الأيقونات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ずたぶくろ": "كِيس",
 "ずた袋": "كِيس",
 "ずだ": "كِيس",
 "ずだぶくろ": "كِيس",
 "ずだ袋": "كِيس",
 "ずっこい": "خَبِيث, مَاكِر",
 "ずっこけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / غَبِيّ / غَبِيّ, أَحْمَق",
 "ずっと": "باستمرار / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "ずっぽし": "تَمَامًا",
 "ずっぽり": "تَمَامًا",
 "ずつ": "كُلّ",
 "ずつう": "صُدَاع",
 "ずつうがっかい": "آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "ずどり": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずにん": "سَجِين, سَجِينَة",
 "ずのう": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / عَقْل, فِطْنَة (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "ずのうしゅうだん": "خَلِيَّة تَفْكِير",
 "ずのうりゅうしゅつ": "هِجْرَةُ الأَدْمِغَة, هِجْرَةُ العُقُول (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "ずはん": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "ずばいもも": "دُرَّاق",
 "ずばっと": "بِصَراحة",
 "ずばなるまい": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ずばぬける": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ずばり": "إِلَى الأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / بِدِقَّة",
 "ずば抜ける": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ずひょう": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "ずぶ": "تَمَامًا",
 "ずぶずぶ": "بَلَّلَ, نَقَعَ",
 "ずぶずぶっ": "بَلَّلَ, نَقَعَ",
 "ずぶとい": "جَرِيء, جَسُور",
 "ずぶぬれ": "مَنْقُوع",
 "ずぶの": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "ずぶ濡れ": "مَنْقُوع",
 "ずべらぼう": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ずべら坊": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ずほう": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずぼし": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "ずぼっと": "خَارِج",
 "ずぼん": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "ずみ": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "ずめん": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "ずらかる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "ずらす": "نَوْبَة / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "ずり": "جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "ずりせん": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "ずる": "غَشَّ",
 "ずるい": "خَبِيث, مَاكِر",
 "ずるがしこい": "مَاكِر\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "ずるける": "تَسَرَّبَ",
 "ずるずる": "بِبُطْء / شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / فَضْفَاض, واسِع",
 "ずるっこい": "خَبِيث, مَاكِر",
 "ずる賢い": "مَاكِر\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "ずれ": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "ずれる": "اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة",
 "ずろう": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ずわい": "مِقْلَاد",
 "ずわえ": "مِقْلَاد",
 "ずん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ずんずん": "بِسُرْعَة, عَاجِلًا",
 "ずんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "ずんど": "مُسْتَطِيل",
 "ずんどう": "مُسْتَطِيل",
 "ずんべらぼう": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ずんべら坊": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ずんべら棒": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ずーずーしい": "وَقِح, صَفِيق\nمثال: よくずうずうしくそんな事が言えるね。 — كيف تجرء على قول شيءٍ كهذا؟",
 "ずーっと": "باستمرار / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "せ": "ضَحِل / سَرِيع / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / فُرْصَة",
 "せい": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "せいあい": "إِيرُوس",
 "せいあつ": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "せいあん": "شِيَان, شِيئَان",
 "せいい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "せいいき": "مدى, قدرة / مَدَى",
 "せいいく": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "せいいたいしょうぐん": "شُوغُون",
 "せいいつ": "مُسَاوَاة / تَسَاوٍ",
 "せいいぶつ": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / ذَخِيرَة\nمثال: اختفى فلم ير له أثر.",
 "せいいん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "せいうけい": "بَارُومِتْر, مِقْياس ضَغْط جَوِّيّ",
 "せいうん": "رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "せいえい": "نُخْبَة",
 "せいえき": "مَنِيّ",
 "せいえつ": "تَوَسَّلَ (إتخذ وسيلة. أي طريقة أو اسلوب؛ رَجَا بشدة وذل) / اِلْتَمَسَ\nمثال: توقف زيري عن التوسل.",
 "せいえん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "せいおう": "أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة. / غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "せいおうか": "تَغْرِيب",
 "せいおうじん": "غَرْبِيّ",
 "せいおん": "هُدُوء",
