 "けげん": "حَائِر, مُتَحَيِّر (مليء بالحيرة والارتباك) / الحُلُول",
 "けこみ": "قائمة الدرجة (عضو هيكلي يتكون من الجزء الرأسي لدرج أو خطوة)\nمثال: هو عادة ناهض متأخر",
 "けご": "دُودَة اَلْقَزّ",
 "けごろも": "معطف فرو (معطف مصنوع من الفرو)",
 "けさがた": "هٰذَا الصَّبَاح",
 "けし": "خَشْخَاش الْأَفْيُون / نَقْص",
 "けしいん": "خَتْم بَرِيدِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "けしかける": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على…)\nمثال: هو حرض على الشغب.",
 "けしからぬ": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "けしからん": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "けしき": "لافِتَة\nمثال: توم وقع و أصيب. / مَشْهَد, مَنْظَر طَبِيعِيّ",
 "けしこみ": "صُلْح, مُصَالَحَة",
 "けしごむ": "مِمْحَاة",
 "けしさる": "تَخَلَّصَ ؛ مِن",
 "けしずみ": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ:…)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "けしつぶ": "خشخاش بَذْرَة",
 "けして": "يَوْمًا",
 "けしとめる": "أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "けしのみ": "خشخاش بَذْرَة",
 "けしの実": "خشخاش بَذْرَة",
 "けしょう": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر) / تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي / زينة",
 "けしょうぎ": "رُوب, ثَوْب نَوْم (مصدر للفعل رَابَ؛ اللبن المروب وهو ما يُخَضُّ ويخرج زبده كالرائب)\nمثال: أخبرني روب بالخبر السعيد.",
 "けしょうした": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "けしょうしたじ": "كِتَاب تَمْهِيدِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "けしょうしつ": "مِرْحَاض, تواليت",
 "けしょうせっけん": "صابون التواليت, صابون الوجه (صابون يستخدم للنظافة الشخصية)",
 "けしょうだい": "مِزْيَنَة, مِنْضَدَة زِينَة",
 "けしょうだち": "تزيين (فعل إضافة الزينة)\nمثال: كان يجب أن يكون الأطفال في السرير قبل أن يحين وقت تزيين الشجرة",
 "けしょうだんさい": "تزيين (فعل إضافة الزينة)\nمثال: كان يجب أن يكون الأطفال في السرير قبل أن يحين وقت تزيين الشجرة",
 "けしょうどうぐ": "أدوات الزينة, مستلزمات النظافة (الأدوات المستخدمة في العناية الشخصية (الغسيل والعناية بالجسم))",
 "けしょうなおし": "تَجْدِيد, إِحْيَاء",
 "けしょうのもの": "شَبَح, شَبْح",
 "けしょうばり": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "けしょうひん": "مُسْتَحْضَرَاتُ التَّجْمِيل",
 "けしょうべや": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره)\nمثال: شغل بعض الماء في المغسلة ورشه على وجهه",
 "けしょうみず": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء.",
 "けしょうよううちこ": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "けしょうりょう": "مَهْر",
 "けしん": "الحُلُول / أَفَاتَار",
 "けしゴム": "مِمْحَاة",
 "けじめ": "تَمْيِيْز / كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم…)\nمثال: ياني لديه الكفاءة لذلك. / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
