 "げじ": "مئوية أرجل المنزل (مئوية أرجل طويلة الأرجل شائعة في الأماكن الرطبة مثل الأقبية) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "げじげじ": "مئوية أرجل المنزل (مئوية أرجل طويلة الأرجل شائعة في الأماكن الرطبة مثل الأقبية) / ظَرِبَان (حيوان صغير بحجم القط)",
 "げじょ": "خادمة (عاملة منزلية)",
 "げじょう": "تَرَجَّل (تَرَجَّلَ: نَزَلَ من مَرْكُوبه؛ تَرَجَّلَت المرأةُ: اسْتَرْجَلَت)",
 "げじょげなん": "خَادِم, خَادِمَة",
 "げじん": "صَحْن (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "げす": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي) / فَلَّاح, فَلَّاحَة / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "げすい": "تَصْرِيف / مياه الصرف الصحي, مياه المجاري (مواد النفايات التي يتم نقلها في المجاري أو المصارف)",
 "げすいこう": "قناة تصريف (خندق لتصريف المياه الزائدة أو الصرف الصحي)",
 "げすいしょぶん": "تصريف مياه الصرف الصحي (التخلص من مياه الصرف الصحي)",
 "げすいどう": "بَالُوعَة / خَيَّاط",
 "げすやろう": "فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ) / بَوْش\nمثال: انظر من الفتحة.",
 "げせない": "غامِض, غَلِق",
 "げせる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "げせわ": "بَذِيء",
 "げせん": "نزول (عملية نزول الركاب والطاقم من سفينة أو طائرة) / مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة)",
 "げそく": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "げた": "حذاء خشبي, قبقاب (حذاء عادة ما يكون نعله خشبياً) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / شَبَكَة, شبكة",
 "げたい": "كَسَل",
 "げたのゆき": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "げたばき": "طائرة طافية, طائرة عائمة (طائرة مائية مجهزة بعوامات للهبوط أو الإقلاع من الماء)",
 "げたをはかせる": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "げだい": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "げだげだ": "بمرح صاخب (بطريقة مرحة وخالية من الهموم)\nمثال: كانت سعيدة بمرح صاخب",
 "げだん": "سرير سفلي, مضجع سفلي (السرير السفلي من بين سريرين (أحدهما فوق الآخر))",
 "げち": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "げぢ": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "げっ": "يَع",
 "げっか": "تشديد, تكثيف (إجراء يجعل الشيء أقوى أو أكثر حدة) / تكثيف (عملية زيادة تباين (الفيلم الفوتوغرافي))",
 "げっかこう": "مسك الروم (عشب مكسيكي درني له أوراق تشبه العشب ويزرع لسنابله من الزهور البيضاء الشمعية التي تشبه الزنبق وشديدة العطرية)",
 "げっかすいこう": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "げっかひょうじん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "げっかびじん": "شمعية ليلية الإزهار (أي من الصباريات المتعددة من جنس الشمعية) / شمعية ليلية الإزهار (أي من الصباريات المتعددة من جنس هيلوسيريوس) / شمعية ليلية الإزهار (أي من الصباريات الليلية الإزهار المتعددة من جنس سيلينيسيريوس)",
 "げっかろうじん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "げっかん": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "げっきゅうどろぼう": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "げっきゅうび": "يوم الدفع, يوم الراتب (اليوم الذي تتلقى فيه أجراً عن عملك)",
 "げっけい": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…) / غَار / قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / عَالِيّ الرُتْبَة / إبرة الإطلاق (مطرقة تشعل الشحنة بضرب الكبسولة)",
 "げっけいかた": "حيض, طمث (تدفق الدم من الرحم؛ يحدث على فترات شهرية تقريباً خلال سنوات الإنجاب للمرأة)",
 "げっけいかん": "إِكْلِيل الْغَار",
 "げっけいこんなんしょう": "عسر الطمث (حيض مؤلم)",
 "げっけいしゅうき": "حيض, دورة شهرية (دورة متكررة (تبدأ عند البلوغ وتنتهي عند انقطاع الطمث) تستعد فيها بطانة الرحم للحمل؛ وإذا لم يحدث حمل، تتساقط البطانة أثناء الحيض)\nمثال: متوسط الدورة الشهرية هو 28 يوماً",
 "げっけいじゅ": "غَار",
 "げっけいぜん": "سابق للحيض (مكون من أو متعلق بـ أو يحدث خلال الوقت الذي يسبق الحيض مباشرة)",
 "げっけいぜんしょうこうぐん": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "げっけいたい": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "げっけいへいしき": "إِيَاس",
 "げっけいまえ": "سابق للحيض (مكون من أو متعلق بـ أو يحدث خلال الوقت الذي يسبق الحيض مباشرة)",
 "げっけいまえしょうこうぐん": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "げっけん": "مُبَارَزَة",
 "げっこう": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "げっし": "قَارِض, قَوَارِض",
 "げっしどうぶつ": "قَارِض, قَوَارِض",
 "げっしょく": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / خُسُوف اَلْقَمَر",
 "げっしるい": "قَارِض, قَوَارِض",
 "げっせかい": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "げっそう": "طور القمر, منزلة القمر (وقت يقدم فيه القمر مظهراً متكرراً معيناً)",
 "げっそり": "فَجْأَةً",
 "げったん": "تَعْلِيق",
 "げったんひょう": "تَعْلِيق",
 "げっちょうせき": "حَجَرُ ٱلْقَمْر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "げっとう": "زنجبيل الصدفة, زهرة الصدفة (يزرع لأوراقه المستطيلة اللامعة وعناقيده المقوسة من الزهور البيضاء ذات الظلال الوردية والشفاه الصفراء المجعدة ذات الخطوط الأرجوانية المبرقشة)",
 "げっぱく": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "げっぷ": "تَجَشَّأَ / تَجَشُّؤ",
 "げっぺい": "كَعْكَة اَلْقَمَر (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "げっ歯動物": "قَارِض, قَوَارِض",
 "げっ歯類": "قَارِض, قَوَارِض",
 "げつ": "الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "げつえい": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "げつかすいもくきん": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "げつげつかすいもくきんきん": "لِمُدَّة أُسْبُوع (يَسْتَمِرّ أُسبوعًا كامِلًا)",
 "げつじ": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "げつじょうこつ": "عظم هلالي (أحد عظام الرسغ الصغيرة الثمانية)",
 "げつめい": "ضَوْء قَمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "げつめんちゃくりく": "هُبُوط عَلَى الْقَمَر",
 "げつよう": "الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "げつようび": "الْاِثْنَيْن, يَوْم الْاِثْنَيْن",
 "げつりん": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "げつれい": "شَهْرِيّ / شَهْرِيًّا",
 "げてん": "أبوكريفا, الأسفار المنحولة (كتب من العهد القديم مضمنة في الفولجاتا ولكنها محذوفة في النسخ اليهودية والبروتستانتية للكتاب المقدس)",
 "げでん": "بَالٍ / أبوكريفا, الأسفار المنحولة (كتب من العهد القديم مضمنة في الفولجاتا ولكنها محذوفة في النسخ اليهودية والبروتستانتية للكتاب المقدس)",
 "げどう": "بِدْعَة, خُرُوج عَن المَأْلُوف (صفة كون الشيء غير أرثوذكسي أو مخالفاً للمعتقد السائد) / خروج عن المألوف, مروق (أي آراء أو مذاهب تتعارض مع الموقف الرسمي أو التقليدي) / شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "げどく": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان)",
 "げどくざい": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "げどくやく": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "げなん": "خادم رجل (خادم من الرجال)",
 "げに": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "げにん": "وَضِيع",
 "げねつざい": "خافض للحرارة",
 "げねつやく": "خافض للحرارة",
 "げのげ": "أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية) / في أدنى مستوى (في أدنى وضع؛ الأقرب إلى الأرض)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى",
 "げはい": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "げば": "تَرَجَّل (تَرَجَّلَ: نَزَلَ من مَرْكُوبه؛ تَرَجَّلَت المرأةُ: اسْتَرْجَلَت)",
 "げばひょう": "إِشَاعَة, شَائِعَة",
 "げひん": "بَذِيء",
 "げび": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "げふんげふん": "نحنحة (إصدار صوت مشابه لتنظيف الحلق؛ يهدف لجذب الانتباه، أو التعبير عن التردد، أو ملء وقفة، أو إخفاء الإحراج، أو تحذير صديق، إلخ)",
 "げぶつ": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "げほう": "بِدْعَة, خُرُوج عَن المَأْلُوف (صفة كون الشيء غير أرثوذكسي أو مخالفاً للمعتقد السائد) / خروج عن المألوف, مروق (أي آراء أو مذاهب تتعارض مع الموقف الرسمي أو التقليدي)",
 "げほげほ": "بِعُنْف",
 "げほっげほっ": "بِعُنْف",
 "げほんげほん": "بِعُنْف",
 "げぼ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "げぼく": "خادم رجل (خادم من الرجال)",
 "げみん": "الْجَمَاهِير, العَامَّةُ / الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي)",
 "げめん": "خَارِج, بره",
 "げや": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "げやく": "مُلَيّن",
 "げら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "げらく": "إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين",
 "げらげら": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "げらげらわらう": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "げらげら笑う": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "げり": "إِسْهَال",
 "げりしょう": "إِسْهَال",
 "げりどめ": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "げりピー": "إِسْهَال",
 "げれつ": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "げろ": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ / اِعْتَرَفَ, أَقَرَّ / بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "げろう": "خَادِم, خَادِمَة",
 "げろうことば": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "げろげろ": "قَيْءُ, اِسْتِفْرَاغ / نقيق (تلفظ أجش خشن (كما للضفدع))",
 "げろげろはく": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "げろげろ吐く": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "げろぶくろ": "كيس دوار الجو, كيس قيء (كيس يتوفر في الطائرة للركاب الذين يعانون من دوار الجو ويحتاجون للتقيؤ)",
 "げろをはく": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "げろを吐く": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "げろ袋": "كيس دوار الجو, كيس قيء (كيس يتوفر في الطائرة للركاب الذين يعانون من دوار الجو ويحتاجون للتقيؤ)",
 "げん": "أَصْلِيّ / صَارِم / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / نَقْص / طَرْح (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا. / مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / يُوَان / دُولَار / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / وَتَر, اِئْتِلَاف نَغَمَات (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / وَتَر, ضِلْع مُتَوَتِّر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / سِكْرِتِير, سِكْرِتِيرَة / فَأل, نَذِيْر / تَأْثِير, أَثَر / حافة المركب, طراد (اللوح العلوي لجانب القارب؛ أعلى ألواح السفينة الخشبية)",
 "げんあつ": "تخفيف الضغط (تخفيف الضغط (خاصة إعادة شخص مضغوط تدريجياً إلى الضغط الجوي)) / فك الضغط (استعادة المعلومات المضغوطة إلى شكلها الطبيعي للاستخدام أو العرض)",
 "げんあつしょう": "انسداد وعائي غازي, داء الغواص (ألم ناتج عن تغير سريع في الضغط الجوي)",
 "げんあん": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "げんいん": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "げんいんきん": "مسببات الأمراض",
 "げんいんけっか": "سَبَبِيَّة, عليَة",
 "げんいんちょうさ": "تَحْقِيق",
 "げんいんぶんせき": "تَشْخِيص",
 "げんうん": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "げんえい": "سَرَاب, شَبَح",
 "げんえいし": "طرف وهمي (الوهم بأن طرفاً لا يزال موجوداً بعد بتره)",
 "げんえん": "غِيبُون, جِبَّوْن",
 "げんえんしょく": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع ضغط الدم أو الوذمة أو اضطرابات أخرى)",
 "げんえんるい": "رئيسيات بدائية, لواحق الأنف (رئيسيات بدائية لها آذان وعيون كبيرة وتتميز بعادات ليلية)",
 "げんおん": "ترطيب, تندية (فعل جعل الشيء رطباً قليلاً) / مُتَنَاقِص (يصبح أصغر أو أقلّ أو يبدو كذلك)",
 "げんか": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع) / سعر الشراء (السعر الذي يتم شراء شيء ما به فعلياً) / تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع) / تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة. / بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "げんかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي)) / تجلي, مظهر (دلالة واضحة لوجود أو حضور أو طبيعة شخص أو شيء ما) / انعكاس, تعبير (تعبير بدون كلمات) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "げんかいこうよう": "منفعة حدية ((اقتصاد) المقدار الذي تزداد به المنفعة مع زيادة وحدة واحدة من سلعة أو خدمة اقتصادية)",
 "げんかいてん": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "げんかいひよう": "تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "げんかいれい": "حُكْم عُرْفِيّ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "げんかく": "صَارِم / هَلْوَسَة, وَهْم / هَلْوَسَة",
 "げんかくさよう": "مُهَلْوِس (قادر على إحداث هلوسات)",
 "げんかくざい": "عقار مهلوس, مهلوس (عقار ذو تأثير نفسي يحفز الهلاوس أو تجارب حسية متغيرة)",
 "げんかくしょう": "حالة هلوسة, هلاس (حالة عقلية يعاني فيها الشخص من هلوسات مستمرة)",
 "げんかくしょうじょう": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "げんかくせいぶつ": "بِدَائِيَّات النَّوَى",
 "げんかくやく": "عقار مهلوس, مهلوس (عقار ذو تأثير نفسي يحفز الهلاوس أو تجارب حسية متغيرة)",
 "げんかけいさん": "محاسبة التكاليف (تتبع تكاليف العناصر في الإنتاج)",
 "げんかしょうきゃく": "إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين",
 "げんかん": "دُخُول / مَدْخَل / إزالة التحسس (عملية تقليل الحساسية)\nمثال: تتحسر على عدم اكتراث المجتمع التدريجي لفظائع كراهية الأجانب",
 "げんかんぐち": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى) / بوابة, مدخل (مدخل يمكن إغلاقه ببوابة)",
 "げんかんさき": "دُخُول / مَدْخَل",
 "げんかんばん": "بَوَّاب, بَوَّابَة",
 "げんかんホール": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "げんかんマット": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول) / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "げんがい": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه) / إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "げんがいけんびきょう": "مجهر فوقي",
 "げんがいに": "ضمناً (بدون التعبير عن ذلك بوضوح) / بشكل مطلق, ثقة عمياء (دون شك أو تساؤل)\nمثال: يفترض ضمناً أنك تعرف الإجابة",
 "げんがいにほのめかす": "اِنْطَوَى",
 "げんがいのいみ": "تَلَازُم",
 "げんがく": "نَقْص / تحذلق (عرض متباه وغير مناسب للمعرفة)",
 "げんがくごじゅうそうきょく": "خماسي وتري (مجموعة من خمسة عازفين على الآلات الوترية)",
 "げんがくしじゅうそう": "رباعي وتري (رباعي آلات موسيقية مع كمانين وفيولا وتشيلو)",
 "げんがくしじゅうそうきょく": "رباعي وتري (رباعي آلات موسيقية مع كمانين وفيولا وتشيلو)",
 "げんがくしじゅうそうだん": "رباعي وتري (رباعي آلات موسيقية مع كمانين وفيولا وتشيلو)",
 "げんがくしゃ": "مُتَشَدِّق / مُتَحَذْلِق",
 "げんがくしゅみ": "تحذلق (عرض متباه وغير مناسب للمعرفة)",
 "げんがくてき": "أَكَادِيمِيّ, مُتَحَذْلِق (يتّسم بالتركيز الضيّق على المعرفة وعرضها خاصّة جوانبها التافهة)",
 "げんがっき": "آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "げんき": "دَجِر / صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي. / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء) / تَصَنُّع, تَكَلُّف / امتصاص الحرارة (عند نقطة التحول) (ظاهرة تحدث عند تسخين معدن ويحدث تباطؤ مفاجئ في معدل ارتفاع درجة الحرارة؛ التباطؤ ناتج عن تغيير في البنية البلورية الداخلية للمعدن) / عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / بدائية, منشأ (عضو في مرحلته المبكرة من التطور؛ الأساس للتطور اللاحق) / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "げんきかいふく": "تجديد الشباب (فعل الاستعادة لحالة أكثر شباباً) / استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "げんきづけ": "طمأنة (فعل الطمأنة؛ استعادة ثقة شخص ما)",
 "げんきでね": "تَوَخَّى اَلْحِذْر",
 "げんきひゃくばい": "دَجِر",
 "げんきもの": "شُعْلَة نَشَاط, مُتَحَمِّس (شخص يقظ ونشيط للغاية)",
 "げんきもん": "شُعْلَة نَشَاط, مُتَحَمِّس (شخص يقظ ونشيط للغاية)",
 "げんきゃく": "نَقْص",
 "げんきゅう": "مَرْجِع / خفْض الراتب (عملية تقليل الراتب)",
 "げんきょ": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة. / باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "げんきょう": "رأس المدبرين, زعيم عصابة (شخص يقود الآخرين (خاصة في الأنشطة غير المشروعة)) / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "げんきょうゆうし": "كَمَا هُوَ, كَمَا هِيَ",
 "げんきょく": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "げんきょくせい": "مَحَلِّيّ, مُوَجَّه مَحَلِّيًّا (جُعِل محلياً أو وُجِّه نحو النطاق المحلي) / مَحَلِّيّ, مَوْضِعِيّ (مَحْصور أَوْ مُقْتَصِر عَلى مَوْضِع مُعَيَّن)",
 "げんきょくせいかいちょうえん": "التهاب الأمعاء الناحي, داء كرون (التهاب مزمن وخطير ومتفاقم في اللفائفي يسبب نوبات متكررة من الإسهال مع آلام البطن والغثيان والحمى وفقدان الوزن)",
 "げんきょくせいちょうえん": "التهاب الأمعاء الناحي, داء كرون (التهاب مزمن وخطير ومتفاقم في اللفائفي يسبب نوبات متكررة من الإسهال مع آلام البطن والغثيان والحمى وفقدان الوزن)",
 "げんきよく": "بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك",
 "げんきをつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "げんきん": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ) / حَظْر ((حَظَّرَ): بالغ في الحظر) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: حرم الإسلام الترويع / نَقْد, نُقُود / مُرْتَزِق, مُؤْجِر",
 "げんきんか": "نَقْد, نُقُود",
 "げんきんじどうあずけいれしはらいき": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "げんきんじどうあずけばらいき": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "げんきんじどうしはらいき": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "げんきんじどうしゅつにゅうき": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "げんきんじどうとりひきそうち": "مَاكِينَةُ الصَّرَّافِ الْآلِي, آلَةْ صَرَّاف الْآلِيّ",
 "げんきんじどうよきんしはらいき": "صراف آلي (آلة غير مراقبة (خارج بعض البنوك) تصرف النقود عند استخدام بطاقة مشفرة شخصية)",
 "げんきんせいか": "السعر الفوري, سعر النقد (سعر التسليم الحالي لسلعة يتم تداولها في السوق الفورية)",
 "げんきんとりひきいちば": "السوق الفورية, سوق السلع الحاضرة (سوق يتم فيها شراء أو بيع سلعة للتسليم الفوري أو التسليم في المستقبل القريب جدًا)",
 "げんきんぶそく": "عُسْر مَالِيّ, نَقْص السُّيُولَة (حالة انعدام السيولة؛ صعوبة في بيع الأصول)",
 "げんきんゆそうしゃ": "سيارة مصفحة (مركبة قتالية عسكرية على عجلات ذات درع خفيف (وعادة مدفع رشاش)) / سيارة نقل الأموال المصفحة (شاحنة مصفحة بأبواب وأقفال قوية تستخدم لنقل الأموال أو الأشياء الثمينة)\nمثال: تم تسليم اللوحات إلى المتحف في سيارة مصفحة مكيفة",
 "げんぎ": "غَيْشَا",
 "げんぎゅう": "أُرْخُص (أَرْخَصَ السِّعرَ: جعله رخيصًا؛ وأَرْخَصَ الشيءَ: وجده رخيصًا أو اشتراه رخيصًا)\nمثال: أظنني سأشتري الأرخص.",
 "げんぎょう": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "げんぎょうしょく": "عُمَّالِيّ, مِن الطَّبَقَة العَامِلَة (ينتمي إلى من يعملون بأجر خاصة العمال اليدويين أو الصناعيين) / ذو الياقات الزرقاء, عمالي (من أو يحدد العمل الصناعي اليدوي أو العمال)",
