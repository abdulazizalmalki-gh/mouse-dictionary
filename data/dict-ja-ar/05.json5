 "こぐちもくはん": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات)",
 "こぐま": "دَيْسَم (ابن الدُبّ؛ قد يُطلع على جُرْو الثَعْلَب)",
 "こぐまざ": "بَنَاتُ نَعْشٍ الصُّغْرَى, الدُّب الْأَصْغَر",
 "こぐまのプーさん": "ويني-ذا-بوه, ويني الدبدوب",
 "こぐま座": "بَنَاتُ نَعْشٍ الصُّغْرَى, الدُّب الْأَصْغَر",
 "こぐらい": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها)",
 "こけ": "أُشْنَة, طُحْلُب / مِقْيَاس\nمثال: هم يريدون السلم. / حماقة, طيش (سلوك أحمق أو لا معنى له)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "こけい": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب. / قَوْس, مُنْحَنَى",
 "こけいしょく": "طَعَام, غِذَاء صُلْب (أيّ مادّة صلبة تُستخدَم مصدرًا للتغذية، في مقابل السوائل)",
 "こけいせっけん": "قطعة صابون (صابون على شكل قطعة صلبة)",
 "こけいぶつ": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "こけいブイヨン": "مكعب مرقة (مكعب من مستخلص اللحم المتبل والمبخر)",
 "こけおどし": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "こけこっこ": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけこっこう": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけこっこー": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけしょくぶつ": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "こけっこう": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけつ": "عَرِين الْأُسُود (اِسْمٌ لِمَاْوَى الأَسَد) / تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً))\nمثال: تصلب الخرسانة",
 "こけむし": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "こけむしるい": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "こけめのう": "عقيق طحلبي (عقيق يشبه الطحالب بعلامات بنية أو سوداء أو خضراء)",
 "こけもも": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر)",
 "こけら": "مِقْيَاس\nمثال: هم يريدون السلم.",
 "こけらぶき": "تركيب القرميد الخشبي (عملية تركيب القرميد الخشبي (للسقف أو الجدران))\nمثال: تركيب القرميد الخشبي حرفة تختلف تماماً عن النجارة",
 "こけら葺き": "تركيب القرميد الخشبي (عملية تركيب القرميد الخشبي (للسقف أو الجدران))\nمثال: تركيب القرميد الخشبي حرفة تختلف تماماً عن النجارة",
 "こける": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / تماماً, مباشرة (بشكل كامل)\nمثال: سقط مباشرة على وجهه",
 "こけるい": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "こけん": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة…)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "こげ": "بشكل حارق, بلهيب (قادر على إحداث حروق (تستخدم عادة لوصف شدة الحرارة))\nمثال: كان الجو حاراً بشكل حارق",
 "こげあと": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "こげき": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ)…)",
 "こげちゃ": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "こげちゃいろ": "بني زيتوني (درجة من البني مشوبة بالأخضر)\nمثال: 彼はこげ茶色の髪をしていた。 — كانَ لديه شعرٌ بُنِّيٌّ غامق.",
 "こげつき": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "こげめ": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "こげる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "こげーな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "こげ茶": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "こげ茶色": "بني زيتوني (درجة من البني مشوبة بالأخضر)\nمثال: 彼はこげ茶色の髪をしていた。 — كانَ لديه شعرٌ بُنِّيٌّ غامق.",
