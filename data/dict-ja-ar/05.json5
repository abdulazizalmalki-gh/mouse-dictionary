 "こきみよい": "بَهِيج",
 "こきゃく": "زَبُون, عَمِيل",
 "こきゃくそう": "دائرة انتخابية, ناخبون (هيئة الناخبين الذين ينتخبون ممثلاً لمنطقتهم)",
 "こきゃくサービス": "خِدْمَة اَلْعُمَلَاء",
 "こきゅう": "تَنَفُس, نَفَس / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / اِنْسِجَام, تَوَافُق",
 "こきゅうがあう": "انسجم, تفاهم (التمتع بعلاقات طيبة وسلسة مع الآخرين)\nمثال: أنا ورئيسي نتفاهم بشكل جيد للغاية",
 "こきゅうき": "عضو تنفسي (أي عضو يشارك في عملية التنفس)",
 "こきゅうきかん": "عضو تنفسي (أي عضو يشارك في عملية التنفس)",
 "こきゅうきかんせん": "التهاب الجهاز التنفسي, عدوى الجهاز التنفسي (أي عدوى تصيب الجهاز التنفسي)",
 "こきゅうきけい": "جِهَاز تَنَفُّسِيّ",
 "こきゅうきしっかん": "اضطراب تنفسي, مرض تنفسي (مرض يصيب الجهاز التنفسي)",
 "こきゅうきゅうはくしょうこうぐん": "متلازمة الضائقة التنفسية (مرض رئوي حاد يصيب حديثي الولادة (خاصة الخدج))",
 "こきゅうこん": "جذر هوائي (جذر مملوء بالهواء (مغمور أو مكشوف) يمكن أن يعمل كعضو تنفسي لنبات المستنقعات)",
 "こきゅうこんなん": "ضيق النفس, عسر التنفس (تنفس صعب أو مجهد)\nمثال: 標高がぐんと高くなると呼吸困難を感じる。 — في الأعالي، يصعب على الناس التنفس.",
 "こきゅうちゅうすう": "مركز تنفسي (المركز في النخاع المستطيل والجسر الذي يدمج المعلومات الحسية حول مستوى الأكسجين…)",
 "こきゅうてん": "حُرِيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "こきょう": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد…)\nمثال: دفنت في مسقط رأسها.",
 "こきょうぼうじがたし": "هُنَاكَ, يُوجَدُ",
 "こきよう": "مَاهِر, حَاذِق",
 "こきろく": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "こきんめふくろう": "بُومَة صَغِيرَة",
 "こき下ろす": "وَشَى",
 "こき落とす": "دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "こぎ": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس…) / شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ:…)\nمثال: إنها بلا شك محقة.",
 "こぎいた": "مِدَقّ, مِدَقَّة (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "こぎく": "وَرَقَة",
 "こぎたない": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة)",
 "こぎだす": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "こぎって": "شِيك",
 "こぎってちょう": "دفتر شيكات (دفتر يصدر لأصحاب الحسابات الجارية)",
 "こぎつける": "بَلَغَ",
 "こぎつね": "جَرْو ثَعْلَب (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "こぎつねざ": "الثعلب",
 "こぎつね座": "الثعلب",
 "こぎて": "مجدّف (شخص يجدف قارباً)",
 "こぎゃん": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)",
 "こぎよう": "مَاهِر, حَاذِق",
 "こぎり": "مخراز, مخراز المسامير (مخراز لعمل ثقوب صغيرة للمسامير الصغيرة أو البراغي الصغيرة)",
 "こぎれい": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة)",
 "こぎ出す": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "こぎ着ける": "بَلَغَ",
 "こく": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / اِنْتِصَار, نَصْر / حزم, صرامة (عزم لا هوادة فيه) / جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / طَرَدَ, نَفَى / نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / صرة, محور العجلة (الجزء المركزي لعجلة السيارة (أو المروحة ونحوها) الذي يمر من خلاله العمود أو…)\nمثال: الملعب هو محور إشراف الوالدين / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر)\nمثال: عظمة العمارة / تَمّ, قُقْنُس / إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة.",
 "こくあく": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "こくあん": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "こくいん": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "こくえい": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "こくえいか": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة)",
 "こくえん": "غَرَافِيت",
 "こくおう": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / تَاج, إِكْلِيل",
 "こくおうごろし": "قتل الملك (فعل قتل الملك)",
 "こくおうさつがい": "قتل الملك (فعل قتل الملك)",
 "こくがい": "فِي الْخَارِج, اِلَى الْخَارِج (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "こくがいたいきょ": "طَرْد",
 "こくがいちゅうざい": "مُغْتَرِب",
 "こくがいついほう": "طَرْد",
 "こくがく": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "こくがん": "إوز أسود, برنت (إوز داكن صغير يتكاثر في الشمال ويهاجر جنوباً)",
 "こくぎょく": "مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "こくくじら": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "こくぐう": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "こくぐら": "مَخْزَن الْحُبُوب, شُونَة",
 "こくげん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "こくご": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون) / لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "こくごか": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "こくごきょういく": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "こくさい": "دَيْن سِيَادِيّ, دَيْن عَامّ (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق. / دُوَلِيّ",
 "こくさいうちゅうステーション": "مَحَطَّةُ الفَضَاءِ الدُّوَلِيَّة",
 "こくさいおんせいきごう": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "こくさいおんせいじぼ": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "こくさいおんどめもり": "هُوَ, هِيَ",
 "こくさいか": "تَدْوِيل",
 "こくさいかいじきかん": "المنظمة البحرية الدولية (وكالة الأمم المتحدة المعنية بالأنشطة البحرية الدولية)",
