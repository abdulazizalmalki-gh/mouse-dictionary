 "こえをのむ": "صَمَتَ",
 "こえをはげます": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "こえをはりあげる": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "こえー": "مُجَفِّل",
 "こおう": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "こおうして": "بالتنسيق, معاً (بخطط مشتركة)\nمثال: العمل بالتنسيق",
 "こおに": "بيكسي, عفريت ((فلكلور) جنيات تميل للمشاغبة) / شقي, عفريت (شخص مؤذٍ بمرح)",
 "こおらす": "تَجَمَّدَ",
 "こおり": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / قيادة, منصب القائد (منصب أو مكتب القائد) / جَلِيد, ثَلْج",
 "こおりがし": "تحلية مجمدة (أي من الحلويات المتنوعة التي تُحضر بالتجميد)",
 "こおりざとう": "حلوى صخرية, سكر نبات (سكر على شكل بلورات صلبة كبيرة وشفافة على خيط) / حلوى الروك (عصا حلوى صلبة زاهية الألوان (عادة بنكهة النعناع))",
 "こおりすべり": "تزلج على الجليد (التزلج على الجليد)",
 "こおりつく": "تَجَمَّدَ",
 "こおりばこ": "برّاد, ثلاجة (من السلع البيضاء التي يُحفظ فيها الطعام في درجات حرارة منخفضة)",
 "こおりばさみ": "ملقط ثلج (ملقط لرفع كتل الثلج)",
 "こおりぶくろ": "كمادة ثلج, كيس ثلج (كيس مقاوم للماء مملوء بالثلج؛ يوضع على الجسم لتبريده أو تقليل التورم)",
 "こおりみず": "ماء مثلج (ماء يُقدم بارداً جداً أو مع الثلج)\nمثال: 私はビニール袋にワインを注ぎ、それからそれを氷水に付けた。 — سكبت النبيذ في كيس و بعدها غمسته في مياه مجمدة.",
 "こおる": "تَجَمَّدَ\nمثال: 道が凍っているから気を付けなさい。 — الطريق متجمد، لذا انتبه.",
 "こおれえぐす": "نَبَات فُلْفُل (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / فُلَيْفِلَة\nمثال: هذا النبات مهدد بالانقراض.",
 "こおろぎ": "جُدْجُد / صُرْصُر / صُرْصُور / كْرِيكِت",
 "こおんな": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "こか": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة / ضوء المشعل (ضوء صادر عن مشعل أو مشاعل) / مَشْعَل / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "こかく": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / زَبُون, عَمِيل / نِدَاء",
 "こかくそう": "دائرة انتخابية, ناخبون (هيئة الناخبين الذين ينتخبون ممثلاً لمنطقتهم)",
 "こかげ": "عريشة (هيكل يدعم النباتات المتسلقة)\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة / ركن, زاوية (زاوية داخلية تتشكل من التقاء جدارين) / ركن منعزل, زاوية (مكان محمي ومنعزل)\nمثال: كان البيانو في إحدى زوايا الغرفة",
 "こかす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "こかた": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "こかつ": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "こかん": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
