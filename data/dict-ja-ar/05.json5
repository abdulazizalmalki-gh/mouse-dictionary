 "こきゅうきけい": "جِهَاز تَنَفُّسِيّ",
 "こきゅうきしっかん": "اضطراب تنفسي, مرض تنفسي (مرض يصيب الجهاز التنفسي)",
 "こきゅうきゅうはくしょうこうぐん": "متلازمة الضائقة التنفسية (مرض رئوي حاد يصيب حديثي الولادة (خاصة الخدج))",
 "こきゅうこん": "جذر هوائي (جذر مملوء بالهواء (مغمور أو مكشوف) يمكن أن يعمل كعضو تنفسي لنبات المستنقعات)",
 "こきゅうこんなん": "ضيق النفس, عسر التنفس (تنفس صعب أو مجهد)\nمثال: 標高がぐんと高くなると呼吸困難を感じる。 — في الأعالي، يصعب على الناس التنفس.",
 "こきゅうちゅうすう": "مركز تنفسي (المركز في النخاع المستطيل والجسر الذي يدمج المعلومات الحسية حول مستوى الأكسجين وثاني أكسيد الكربون في الدم ويحدد الإشارات التي سيتم إرسالها إلى عضلات…)",
 "こきゅうてん": "حُرِيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "こきょう": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "こきよう": "مَاهِر, حَاذِق",
 "こきんめふくろう": "بُومَة صَغِيرَة",
 "こき下ろす": "وَشَى",
 "こき落とす": "دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "こぎ": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة) / شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "こぎいた": "مِدَقّ, مِدَقَّة (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "こぎたない": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / مُتَرَبِّب, وَسِخ جِدًّا (مُغطّى بطبقة سميكة من الأوساخ أو السُّخام المتراكم) / كَدِر, مُعَكَّر ((في اللون) تغيّر بسبب الشوائب؛ غير ساطع أو صافٍ)",
 "こぎだす": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "こぎって": "شِيك",
 "こぎってちょう": "دفتر شيكات (دفتر يصدر لأصحاب الحسابات الجارية)",
 "こぎつける": "بَلَغَ",
 "こぎつね": "جَرْو ثَعْلَب (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "こぎつねざ": "الثعلب",
 "こぎつね座": "الثعلب",
 "こぎて": "مجدّف (شخص يجدف قارباً)",
 "こぎよう": "مَاهِر, حَاذِق",
 "こぎり": "مخراز, مخراز المسامير (مخراز لعمل ثقوب صغيرة للمسامير الصغيرة أو البراغي الصغيرة)",
 "こぎれい": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "こぎ出す": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "こぎ着ける": "بَلَغَ",
 "こく": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / اِنْتِصَار, نَصْر / حزم, صرامة (عزم لا هوادة فيه) / حزم, صرامة (انتباه حي الضمير للقواعد والتفاصيل) / جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / طَرَدَ, نَفَى / نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / صرة, محور العجلة (الجزء المركزي لعجلة السيارة (أو المروحة ونحوها) الذي يمر من خلاله العمود أو المحور) / محور, مركز نشاط (مركز للنشاط أو الاهتمام أو التجارة أو النقل؛ نقطة محورية تدور حولها الأحداث)\nمثال: الملعب هو محور إشراف الوالدين / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / ثراء لوني, غنى (حيوية عميقة وقوية للون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: عظمة العمارة / تَمّ, قُقْنُس / إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة.",
 "こくあく": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "こくあん": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "こくいん": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "こくえい": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "こくえいか": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تأميم (عملية إضفاء الطابع الوطني) / تَأْسِيس قَوْمِيّ, تَحَوُّل إِلَى أُمَّة (فعل تشكيل أو أن تصبح أمة)",
 "こくえん": "غَرَافِيت",
 "こくおう": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / تَاج, إِكْلِيل",
 "こくおうごろし": "قتل الملك (فعل قتل الملك) / قاتل الملك (شخص يرتكب جريمة قتل الملك)",
 "こくおうさつがい": "قتل الملك (فعل قتل الملك) / قاتل الملك (شخص يرتكب جريمة قتل الملك)",
 "こくがい": "فِي الْخَارِج, اِلَى الْخَارِج (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / فِي اَلْخَارِج (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "こくがいたいきょ": "طَرْد",
 "こくがいちゅうざい": "مُغْتَرِب",
 "こくがいついほう": "طَرْد",
 "こくがく": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "こくがん": "إوز أسود, برنت (إوز داكن صغير يتكاثر في الشمال ويهاجر جنوباً)",
 "こくぎょく": "مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة) / دفق (دَفَقَ: صَبَّهُ، وَهُوَ ماءٌ دافِقٌ، دَفَقَ اللهُ رُوحَه أَي: أَماتَهُ، ودَفَقَ الكُوزَ: بَدَّدَ مَا فِيه بمَرَّةِ)\nمثال: المحرك لا يعمل.",
 "こくくじら": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "こくぐう": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "こくぐら": "مَخْزَن الْحُبُوب, شُونَة",
 "こくげん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "こくご": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون) / لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "こくごか": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "こくさい": "دَيْن سِيَادِيّ, دَيْن عَامّ (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق. / دُوَلِيّ / الدولية",
 "こくさいうちゅうステーション": "مَحَطَّةُ الفَضَاءِ الدُّوَلِيَّة",
 "こくさいおんせいきごう": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "こくさいおんせいじぼ": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "こくさいおんどめもり": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "こくさいか": "تَدْوِيل",
 "こくさいかいじきかん": "المنظمة البحرية الدولية (وكالة الأمم المتحدة المعنية بالأنشطة البحرية الدولية)",
 "こくさいかんけい": "عَلَاقَات دَوْلِيَّة",
 "こくさいきかん": "منظمة دولية",
 "こくさいきこう": "منظمة دولية",
 "こくさいきぼ": "المقياس المئوي, مقياس سيلسيوس (مقياس درجة حرارة يحدد نقطة تجمد الماء عند 0 درجة ونقطة غليان الماء عند 100 درجة)",
 "こくさいきょうてい": "تَفَاهُم",
 "こくさいぎょうむ": "شؤون دولية, شؤون عالمية (الشؤون بين الأمم)\nمثال: لا يمكنك حقاً مواكبة الشؤون العالمية من خلال مشاهدة التلفزيون",
 "こくさいぎんこうかんつうしんきょうかい": "خُطَّاف",
 "こくさいくうこう": "مَطَار دُوَلِيّ (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "こくさいけいさつきょうかい": "أصد ((أَصَّدَ) الثَّوْب: جعله أُصدة؛ (أَصَّدَ) الْجَارِيَة وَنَحْوهَا: ألبسها الأصدة)",
 "こくさいけいじけいさつきこう": "الإنتربول (وكالة استخبارات دولية تسمح بالتعاون بين وكالات الاستخبارات في جميع أنحاء العالم)",
 "こくさいけいじさいばんしょ": "محكمة الجنائية الدولية (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "こくさいけっさいぎんこう": "بزموت (عنصر فلزي ثلاثي التكافؤ ثقيل هش ومضاد للمغناطيسية)",
 "こくさいげんしじ": "تايلاندي, سيامي (من أو متعلق بتايلاند) / تاي, تايلاندي (من أو متعلق بلغات الشعب التايلاندي) / تايلاندي, سيامي (من أو متعلق أو مميز لتايلاند أو شعبها) / لغات تاي (أكثر عائلات لغات كاداي انتشارًا وشهرة)\nمثال: الحدود التايلاندية مع لاوس",
 "こくさいげんしりょくきかん": "الوكالة الدولية للطاقة الذرية (وكالة الأمم المتحدة المعنية بالطاقة الذرية)",
 "こくさいしほう": "قَانُون دُوَلِيّ خَاصّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "こくさいしほうさいばんしょ": "مَحْكَمَة الْعَدْلَ الدُّوَلِيَّةِ (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "こくさいしゃかい": "المُجْتَمَع الدُّوَلِيّ",
 "こくさいしゅぎ": "أُمَمِيَّة",
 "こくさいしゅわ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "こくさいしょうぎょうかいぎしょ": "لجنة التجارة بين الولايات (وكالة فيدرالية مستقلة سابقة كانت تشرف وتحدد الأسعار للناقلين الذين ينقلون البضائع والأشخاص بين الولايات؛ تم إنهاؤها في عام 1995)\nمثال: تأسست لجنة التجارة بين الولايات عام 1887 كأول وكالة فيدرالية",
 "こくさいじん": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "こくさいじんぞうがっかい": "شبكة العلاقات الدولية والأمن (شبكة المعلومات السويسرية للدراسات الأمنية والدفاعية وأبحاث السلام والصراع والعلاقات الدولية)",
 "こくさいすいいき": "أعالي البحار, مياه دولية (البحار المفتوحة في العالم خارج المياه الإقليمية لأي دولة)",
 "こくさいせい": "أُمَمِيَّة",
 "こくさいそしき": "منظمة دولية",
 "こくさいたんい": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة (كيلوجرام) والوقت (ثانية) والتيار الكهربائي (أمبير) ودرجة الحرارة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "こくさいたんいけい": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة (كيلوجرام) والوقت (ثانية) والتيار الكهربائي (أمبير) ودرجة الحرارة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "こくさいつうかききん": "صُنْدُوق اَلنَّقْد اَلدُّوَلِيّ (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "こくさいてき": "دُوَلِيّ / الدولية",
 "こくさいはくらんかい": "مَعْرِض عَالَمِيّ",
 "こくさいほう": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "こくさいほじょご": "لغة مساعدة دولية (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "こくさいれんごう": "الْأُمَم الْمُتَّحِدَة",
 "こくさいれんごうきょういくかがくぶんかきかん": "يُونِسْكُو (مُنَظّمة الأمم المتحدة للتَّربية والعلوم والثَّقافة، والمقرّ الرَّئيسيّ لها باريس…)",
 "こくさいれんごうしょくりょうのうぎょうきかん": "الفاو, منظمة الأغذية والزراعة (وكالة الأمم المتحدة المعنية بالتنظيم الدولي للأغذية والزراعة)",
 "こくさいれんごうじどうききん": "اليونيسف, منظمة الأمم المتحدة للطفولة (وكالة تابعة للأمم المتحدة مسؤولة عن برامج دعم التعليم وصحة الأطفال والأمهات في البلدان النامية)",
 "こくさいれんごうじむきょく": "الأمانة العامة للأمم المتحدة (الذراع الإداري للأمم المتحدة)",
 "こくさいれんごうそうかい": "الْجَمْعِيَّةُ الْعَامَّةُ لِلْأُمَمِ الْمُتَّحِدَةِ",
 "こくさいれんたいうんどう": "عقيدة, فلسفة (معتقد (أو نظام معتقدات) مقبول كسلطة من قبل مجموعة أو مدرسة ما)",
 "こくさいれんめい": "عُصْبَةْ اَلْأُمَم",
 "こくさいろうどうきかん": "منظمة العمل الدولية (وكالة الأمم المتحدة المعنية بمصالح العمل والعمال)",
 "こくさいオリンピックいいんかい": "اللجنة الأولمبية الدولية (المنظمة المسؤولة عن تنظيم الألعاب الأولمبية الحديثة)",
 "こくさいクリケットひょうぎかい": "لجنة التجارة بين الولايات (وكالة فيدرالية مستقلة سابقة كانت تشرف وتحدد الأسعار للناقلين الذين ينقلون البضائع والأشخاص بين الولايات؛ تم إنهاؤها في عام 1995)\nمثال: تأسست لجنة التجارة بين الولايات عام 1887 كأول وكالة فيدرالية",
 "こくさいスピードゆうびん": "إِم",
 "こくさいテロ": "إرهاب دولي (إرهاب يمارس في بلد أجنبي من قبل إرهابيين ليسوا من مواطني ذلك البلد)",
 "こくさん": "مَنْزَلِيّ",
 "こくし": "وَطَنِيّ, وَطَنِيَّة / اِسْتِغْلَال (استخدام الموارد أو الظروف أو الفرص بشكل مثمر أو للحصول على فائدة؛ استغلال شخص أو موقف بشكل غير عادل لتحقيق مكاسب شخصية)\nمثال: يبدو أن رئيس القسم يحب استغلال سلطته. / مَبْعُوث, وَزِير مُفَوَّض / نمش (بقعة بنية صغيرة (من صبغة الميلانين) على الجلد)",
 "こくしつ": "أبنوسي, أسود حالك (أسود داكن جداً) / غُلّ, أَغْلال / مَادَّة سَوْدَاء (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "こくしびょう": "طَاعُون",
 "こくしゅ": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "こくしょう": "شِعَار وَطَنِيّ (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "こくしょく": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "こくしょくかやく": "بارود أسود (شكل بسيط من البارود، يتكون من خليط من نترات البوتاسيوم والفحم والكبريت؛ اختُرع في القرن التاسع في الصين)\nمثال: يُعزى انتشار البارود الأسود عبر آسيا من الصين على نطاق واسع إلى المغول",
 "こくしょくしゅ": "ميلانوما, ورم ميلانيني (أي من الأورام الخبيثة المتعددة (عادة في الجلد) التي تتكون من الخلايا الصبغية (الميلانينية))",
 "こくしょくじんしゅ": "العرق الأسود, زنوج (عرق ذو بشرة داكنة)",
 "こくしょくひょうひしゅ": "شواك أسود (مرض جلدي يتميز ببقع داكنة تشبه الثآليل في ثنايا الجسم)",
 "こくじ": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / كَانَا / الختم العظيم (الختم الرئيسي للحكومة، يرمز للسلطة أو السيادة)",
 "こくじきこう": "سَاعَة, ساعة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "こくじばん": "لَوْحَة إِعْلَانَات",
 "こくじゅじゅつ": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "こくじら": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "こくじん": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا)) / بائعة هوى",
 "こくじんえいご": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "こくじんれいか": "أغنية روحية, سبيرتشوال (نوع من الأغاني الدينية نشأ عن السود في جنوب الولايات المتحدة)",
 "こくじんれきしげっかん": "أمريكي إفريقي, أمريكية إفريقية",
 "こくすいしゅぎ": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "こくすいてき": "قَوْمِيّ, نَزْعَة قَوْمِيَّة (إخلاص لمصالح أو ثقافة أمة معينة بما في ذلك تعزيز مصالحها) / شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "こくすいねつ": "حمى البول الأسود (ملاريا شديدة وغالباً مميتة تتميز بتلف الكلى مما يؤدي إلى بول داكن)",
 "こくする": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "こくせい": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "こくせいじゅつ": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "こくせいちょうさ": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "こくせき": "جِنْسِيَّة (مؤنث الجنسي، المنتسبة إلى الجنس؛ حالة الجنس أو ماهيته)\nمثال: لديه الجنسية الأوكرانية.",
 "こくせきしゅとく": "تعريب, توطين (تغيير نطق كلمة مستعارة لتتوافق مع صوتيات المقترضين) / أقلمة, توطين (إدخال الحيوانات أو النباتات إلى أماكن تزدهر فيها ولكنها ليست موطناً أصلياً لها) / تجنيس (الإجراء الذي يتم بموجبه منح الأجنبي الجنسية) / تَأَقْلُم, تَطْبِيع (صفة الجلب إلى التوافق مع الطبيعة)\nمثال: توطين العديد من الكلمات الإيطالية في اللغة الإنجليزية",
 "こくせきそうしつ": "نزوح, هجرة خارجية (الهجرة من مكان (خاصة الهجرة من بلدك الأصلي للاستقرار في بلد آخر)) / تغريب, نفي (فعل طرد شخص من وطنه)\nمثال: الرجال في المنفى يحلمون بالأمل",
 "こくせきふめい": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى) / مَجْهُول الهُوِيَّة (لم تُحدَّد هويته بعد)",
 "こくせん": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "こくそ": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "こくそう": "مَخْزَن الْحُبُوب, شُونَة",
 "こくそにん": "شَاكٍ",
 "こくぞく": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "こくたい": "جِسْم أَسْوَد (جسم افتراضي قادر على امتصاص كل الإشعاع الكهرومغناطيسي الساقط عليه)\nمثال: الجسم الأسود المحافظ على درجة حرارة ثابتة هو مشع كامل عند تلك الدرجة لأن الإشعاع الواصل إليه والمغادر له يجب أن يكون في توازن",
 "こくたいふくしゃ": "إشعاع الجسم الأسود (الإشعاع الكهرومغناطيسي الذي يشع من جسم أسود مثالي؛ يعتمد توزيع الطاقة في الطيف المشع للجسم الأسود فقط على درجة الحرارة ويحدده قانون بلانك للإشعاع)",
 "こくたいほうしゃ": "إشعاع الجسم الأسود (الإشعاع الكهرومغناطيسي الذي يشع من جسم أسود مثالي؛ يعتمد توزيع الطاقة في الطيف المشع للجسم الأسود فقط على درجة الحرارة ويحدده قانون بلانك للإشعاع)",
 "こくたつ": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "こくたん": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن) / آبَنُوس",
 "こくだか": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "こくち": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "こくちばん": "لَوْحَة إِعْلَانَات",
 "こくちょう": "تَمّ أَسْوَد",
 "こくちバス": "قاروص صغير الفم (نوع من القاروص الأسود؛ تقع زاوية الفك أسفل العين) / باس صغير الفم (لحم سمكة الباس صغير الفم)",
 "こくつぶ": "نَوَاة",
 "こくてい": "وَطَنِيّ, قَوْمِيّ",
 "こくてん": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات) / بقعة شمسية, كلف الشمس (بقعة داكنة أكثر برودة تظهر بشكل دوري على الغلاف الضوئي للشمس؛ مرتبطة بمجال مغناطيسي قوي)",
 "こくてんし": "قُبَّرَة",
 "こくと": "عَاصِمَة (اسم فاعل؛ مؤنث عَاصِم؛ اسم؛ المَدِينَة الكبيرة) / حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: باريس عاصمة فرنسا.",
 "こくとう": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "こくど": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة. / شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا))",
 "こくどあんぜんほしょうしょう": "وزارة الأمن الداخلي (الإدارة الفيدرالية التي تدير جميع المسائل المتعلقة بالأمن الداخلي)",
 "こくどう": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "こくない": "مَنْزَلِيّ",
 "こくないしょう": "كُمْنَة",
 "こくないしょうひぜい": "ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "こくないせい": "مَنْزَلِيّ",
 "こくないそうせいさん": "نَاتِج مَحَلِّيّ إِجْمَالِيّ",
 "こくないてき": "داخلي (يحدث أو ينشأ أو يقع ضمن بعض الحدود أو خاصة السطح) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / دَاخِلِيّ, وَطَنِيّ (دَاخِلَ حُدُودِ البَلَدِ) / دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)\nمثال: أعضاء داخلية",
 "こくないテロ": "إرهاب محلي (إرهاب يمارس في بلدك ضد شعبك)\nمثال: كان تفجير المبنى الفيدرالي في أوكلاهوما سيتي عام 1995 مثالاً على الإرهاب المحلي",
 "こくねつびょう": "داء الليشمانيات (تقرحات ناتجة عن عدوى استوائية بطفيليات من جنس الليشمانيا) / كالا أزار, ليشمانيا حشوية (ليشمانيا تصيب الأحشاء)",
 "こくのある": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "こくはく": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة) / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "こくはくむじょう": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "こくはくろく": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "こくはつ": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما) / اتهام, لائحة اتهام (اتهام بارتكاب مخالفات)\nمثال: الكتاب هو لائحة اتهام للفلسفة الحديثة",
 "こくはつしゃ": "شَاكٍ",
 "こくはつじょう": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما)",
 "こくはん": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "こくばん": "سَبُّورَة, لَوْح",
 "こくばんけし": "طلاّسة, ممحاة السبورة (ممحاة تزيل علامات الطباشير من السبورة)",
 "こくばんふき": "طلاّسة, ممحاة السبورة (ممحاة تزيل علامات الطباشير من السبورة)",
 "こくひしょう": "تصبغ, قتام (حالة تتميز برواسب غير طبيعية من الميلانين)",
 "こくひょう": "تهجم لاذع, هجوم عنيف (هجوم لفظي صاعق)",
 "こくび": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "こくびゃく": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "こくふ": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "こくふく": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "こくふん": "طَحِين, دَقِيق",
 "こくぶ": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "こくぶんじ": "مَدْعُوم حُكُومِيًّا (مدعوم ومُشغَّل من قِبَل حكومة الدولة)",
 "こくへん": "تسويد, تعتيم (التغيير إلى لون أغمق)",
 "こくべつ": "وَدَاع / فِرَاق, وَدَاع / وَدَاعًا (تقال للمسافر؛ تقال قبل الانصراف. (تعميم))\nمثال: قال زيري وداعا.",
 "こくほうきゅう": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "こくぼ": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "こくぼうかいぎ": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية والعسكرية والأمن القومي؛ تشرف على وكالة الاستخبارات المركزية)",
 "こくぼうしょう": "البنتاغون, وزارة الدفاع (الإدارة الفيدرالية المسؤولة عن حماية الأمن القومي للولايات المتحدة؛ أنشئت عام 1947)",
 "こくぼうしょく": "كَاكِي, خَاكِي",
 "こくぼうじょうほうきょく": "وكالة استخبارات الدفاع (وكالة استخبارات أمريكية في وزارة الدفاع؛ مسؤولة عن توفير الاستخبارات لدعم التخطيط والعمليات العسكرية وحيازة الأسلحة)",
 "こくぼうそうしょう": "البنتاغون, وزارة الدفاع (الإدارة الفيدرالية المسؤولة عن حماية الأمن القومي للولايات المتحدة؛ أنشئت عام 1947)",
 "こくまい": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "こくみ": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "こくみん": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "こくみんがっこう": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "こくみんぎかい": "الْجَمْعِيَّةُ الْوَطَنِيَّة",
 "こくみんこっか": "دَوْلَة قَوْمِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "こくみんしゃかいしゅぎ": "نَازِيَّة",
 "こくみんしょく": "طعام الراحة, طعام المواساة (طعام يتم إعداده ببساطة ويمنح شعوراً بالرفاهية؛ عادة ما يحتوي على نسبة عالية من السكر أو الكربوهيدرات ويرتبط بالطفولة أو الطهي المنزلي)",
 "こくみんしょとく": "دخل قومي (القيمة الإجمالية لجميع الدخل في أمة (الأجور والأرباح والفوائد والإيجارات ومدفوعات المعاشات التقاعدية) خلال فترة معينة (عادة سنة واحدة))",
 "こくみんじゅんふくし": "الشَّمَال الشَّمَالِيّ الغَرْبِيّ, شَمَال شَمَال غَرْب (نقطة البوصلة التي تقع في منتصف المسافة بين الشمال والشمال الغربي)",
 "こくみんそうせいさん": "مقاييس الدخل والإنتاج القومي",
 "こくみんてき": "وَطَنِيّ, قَوْمِيّ",
 "こくみんとう": "الكومينتانغ (الحزب السياسي الذي أسسه صن يات صن عام 1911؛ حكم الصين تحت قيادة شيانغ كاي شيك من عام 1928 حتى عام 1949 عندما تولى الشيوعيون السلطة وأصبح فيما بعد…)",
 "こくみんのしゅくじつ": "عُطْلَة رَسْمِيَّة, إِجَازَة عَامَّة",
 "こくみんへい": "رجل ميليشيا (عضو ذكر في الميليشيا؛ يخدم فقط أثناء الطوارئ)",
 "こくむしょう": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "こくむだいじん": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء) / وزير في الحكومة (شخص عضو في مجلس الوزراء)",
 "こくむちょうかん": "وزير الخارجية (منصب رئيس وزارة الخارجية) / وزير الخارجية (وزير حكومي للعلاقات الخارجية) / وزير الخارجية (الشخص الذي يشغل منصب وزير وزارة الخارجية)\nمثال: تأسس منصب وزير الخارجية عام 1789",
 "こくめい": "مُفَصَّل / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "こくもつ": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "こくゆうか": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تأميم (عملية إضفاء الطابع الوطني) / تَأْسِيس قَوْمِيّ, تَحَوُّل إِلَى أُمَّة (فعل تشكيل أو أن تصبح أمة)",
 "こくようがん": "سَبَج",
 "こくようせき": "سَبَج",
 "こくらがり": "خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "こくり": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / فَجْأَةً / عَمِيق, غَوِيط",
 "こくりつ": "وَطَنِيّ, قَوْمِيّ",
 "こくりついやくひんしょくひんえいせいけんきゅうじょ": "المعاهد الوطنية للصحة (وكالة في وزارة الصحة والخدمات الإنسانية مهمتها توظيف العلم في السعي وراء المعرفة لتحسين صحة الإنسان؛ وهي الوكالة الرئيسية للبحوث الطبية الحيوية…)",
 "こくりつぎんこう": "بنك وطني (بنك تجاري مرخص من قبل الحكومة الفيدرالية)",
 "こくりつこうえん": "حَدِيقَة وَطَنِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "こくりゅう": "نَوَاة",
 "こくるい": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "こくれつ": "صَرَامَة",
 "こくれん": "الْأُمَم الْمُتَّحِدَة",
 "こくれんあんぜんほしょうりじかい": "مَجْلِس الْأَمْن الْأُمَم الْمُتَّحِدَة",
 "こくれんきねんび": "24 أكتوبر, يوم الأمم المتحدة (يوم للاحتفال بتأسيس الأمم المتحدة)",
 "こくれんしょくりょうのうぎょうきかん": "الفاو, منظمة الأغذية والزراعة (وكالة الأمم المتحدة المعنية بالتنظيم الدولي للأغذية والزراعة)",
 "こくれんじどうききん": "اليونيسف, منظمة الأمم المتحدة للطفولة (وكالة تابعة للأمم المتحدة مسؤولة عن برامج دعم التعليم وصحة الأطفال والأمهات في البلدان النامية)",
 "こくれんじむきょく": "الأمانة العامة للأمم المتحدة (الذراع الإداري للأمم المتحدة)",
 "こくれんそうかい": "الْجَمْعِيَّةُ الْعَامَّةُ لِلْأُمَمِ الْمُتَّحِدَةِ",
 "こくろん": "رَأْي عَامّ",
 "こくわ": "أكتينيديا حادة, كيوي هاردي (كرمة آسيوية متسلقة لها أوراق طويلة مسننة بدقة وعناقيد من الزهور البيضاء تليها ثمار صفراء مخضرة صالحة للأكل)",
 "こく味": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "こぐ": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎. / دَوَّاسَة / قَدَمِيّ / تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "こぐすり": "بُودْرَة",
 "こぐち": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / المقطع العرضي ((فيزياء) احتمال حدوث تفاعل معين (مثل الأسر أو التأين) بين الجسيمات؛ يقاس بالبارن) / عينة تمثيلية, قطاع عرضي (عينة يقصد بها أن تكون ممثلة لمجتمع بأكمله) / مقطع عرضي (مقطع ناتج عن قطع مستوى لجسم صلب عمودياً على محوره الأطول)",
 "こぐちぎり": "تقطيع لشرائح (عملية التقطيع إلى شرائح) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "こぐちげんきん": "مصروفات نثرية (صندوق نقدي صغير تحتفظ به الشركة لدفع المصاريف العرضية)",
 "こぐちもくはん": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "こぐま": "دَيْسَم (ابن الدُبّ؛ قد يُطلع على جُرْو الثَعْلَب)",
 "こぐまざ": "بَنَاتُ نَعْشٍ الصُّغْرَى, الدُّب الْأَصْغَر",
 "こぐまのプーさん": "ويني-ذا-بوه, ويني الدبدوب",
 "こぐま座": "بَنَاتُ نَعْشٍ الصُّغْرَى, الدُّب الْأَصْغَر",
 "こぐらい": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها) / شَفَقِيّ, مُتَلَأْلِئ بِنُور الغُرُوب (مُضَاء بِنُور الشَّفَق أَوْ كَأَنَّهُ كَذَلِك)",
 "こけ": "أُشْنَة, طُحْلُب / مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم. / حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "こけい": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب. / قَوْس, مُنْحَنَى",
 "こけいしょく": "طَعَام, غِذَاء صُلْب (أيّ مادّة صلبة تُستخدَم مصدرًا للتغذية، في مقابل السوائل)",
 "こけいせっけん": "قطعة صابون (صابون على شكل قطعة صلبة)",
 "こけいぶつ": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "こけいブイヨン": "مكعب مرقة (مكعب من مستخلص اللحم المتبل والمبخر)",
 "こけおどし": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "こけこっこ": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけこっこう": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけこっこー": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけしょくぶつ": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "こけっこう": "كُوكُوكُوكُو / دُيك (ديك منزلي صغير؛ لا يتجاوز عمره سنة واحدة)",
 "こけつ": "عَرِين الْأُسُود (اِسْمٌ لِمَاْوَى الأَسَد) / تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً)) / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور) / تحجر, تصلب (تصلب أو تغلظ غير طبيعي للأنسجة)\nمثال: تصلب الخرسانة",
 "こけむし": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "こけむしるい": "حيوان طحلبي, مرجانيات (حيوان مائي لاطئ يشكل مستعمرات طحلبية من سلائل صغيرة)",
 "こけめのう": "عقيق طحلبي (عقيق يشبه الطحالب بعلامات بنية أو سوداء أو خضراء)",
 "こけもも": "عنب الثور (توت أحمر لاذع يشبه التوت البري الأمريكي ولكنه أصغر) / توت البقر, توت الجبل الأحمر (شجيرة منخفضة دائمة الخضرة من المناطق المعتدلة الشمالية العالية في أوروبا وآسيا وأمريكا تحمل توتاً أحمر صالحاً للأكل)",
 "こけら": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "こけらぶき": "تركيب القرميد الخشبي (عملية تركيب القرميد الخشبي (للسقف أو الجدران)) / رواسب متراكبة ((جيولوجيا) رواسب تكون فيها الحصى المسطحة مائلة بشكل موحد في نفس الاتجاه)\nمثال: تركيب القرميد الخشبي حرفة تختلف تماماً عن النجارة",
 "こけら葺き": "تركيب القرميد الخشبي (عملية تركيب القرميد الخشبي (للسقف أو الجدران)) / رواسب متراكبة ((جيولوجيا) رواسب تكون فيها الحصى المسطحة مائلة بشكل موحد في نفس الاتجاه)\nمثال: تركيب القرميد الخشبي حرفة تختلف تماماً عن النجارة",
 "こける": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / تماماً, مباشرة (بشكل كامل) / انهيار, سقوط (فعل رمي نفسك للأسفل؛ الانهيار؛ الغوص) / بصوت ارتطام, سقوطاً (مع صوت ارتطام) / إخفاق تام, فشل ذريع (فشل كامل)\nمثال: سقط مباشرة على وجهه",
 "こけるい": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "こけん": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "こげ": "بشكل حارق, بلهيب (قادر على إحداث حروق (تستخدم عادة لوصف شدة الحرارة)) / حَارِق, لَافِح (شديد الحرارة والجفاف بما يكفي لحرق السطح أو تجفيفه)\nمثال: كان الجو حاراً بشكل حارق",
 "こげあと": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "こげき": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "こげちゃ": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "こげちゃいろ": "بني زيتوني (درجة من البني مشوبة بالأخضر)\nمثال: 彼はこげ茶色の髪をしていた。 — كانَ لديه شعرٌ بُنِّيٌّ غامق.",
 "こげつき": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "こげめ": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "こげる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "こげーな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "こげ茶": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "こげ茶色": "بني زيتوني (درجة من البني مشوبة بالأخضر)\nمثال: 彼はこげ茶色の髪をしていた。 — كانَ لديه شعرٌ بُنِّيٌّ غامق.",
 "ここ": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / تِسْعَة, تسعة / فَرْد, شَخْص",
 "ここいちばん": "لحظة الحقيقة (لحظة حاسمة يعتمد عليها الكثير) / لحظة الحقيقة (اللحظة في مصارعة الثيران التي يقتل فيها المصارع الثور)",
 "ここいら": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "ここう": "مصباح قوسي (مصباح ينتج الضوء عند تدفق تيار كهربائي عبر فجوة بين قطبين) / كَفَاف / سُكَّان / سُكَّانِيَّة / بَعِيدًا عَنّ, بِمَعْزِل عَن / مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام)) / ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام)",
 "ここうちょうさ": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "ここうもく": "مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق)",
 "ここかしこ": "هُنَا وَهُنَاكَ",
 "ここち": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس",
 "ここちいい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "ここちよい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "ここつ": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ここに": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "ここにおいて": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "ここにきて": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "ここに来て": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "ここの": "تِسْعَة, تسعة",
 "ここのえ": "تسعة أضعاف (بمعامل تسعة) / تُسَاعِيّ (ذو تسع وحدات أو مكوّنات)\nمثال: زاد استثماري تسعة أضعاف / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "ここのおびアルマジロ": "مدرع تساعي الأحزمة (له تسعة أحزمة مفصلية من الصفائح العظمية؛ يمتد نطاقه من تكساس إلى باراغواي)",
 "ここのこえをあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "ここのつ": "تِسْعَة, تسعة",
 "ここのつどき": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "ここのところ": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ここの所": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "ここもと": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ここら": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "こころ": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "こころあたり": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "こころあたりのない": "مُفَاجِئ",
 "こころあて": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "こころある": "عَمِيق اَلتَّفْكِير / حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول / ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد) / حَاذِق, مُمَيِّز (قَادِر عَلَى إِدْرَاك الفُرُوقَات الدَّقِيقَة؛ حَسَّاس) / سَرِيعُ الفَهْم, فَطِن (سَرِيعُ الإِدْرَاكِ وَالاسْتِيعَاب) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: ناقد فطن",
 "こころいき": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "こころいわい": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "こころうつり": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "こころえ": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي / استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب / نَائِب, نَائِبَة",
 "こころえちがい": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "こころえる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس.",
 "こころおきなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "こころおくれ": "تردد, عدم الثقة بالنفس (انعدام الثقة بالنفس)",
 "こころおだやか": "هَادِئ / طَمْأَنَ",
 "こころおぼえ": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "こころから": "بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "こころがおれる": "يَئِسَ, أُحْبِطَ",
 "こころがけ": "مَوْقِف, سُلُوك",
 "こころがける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころがこめられた": "كُلِّيّ الإِخْلَاص, مُخْلِص (بِتَفَانٍ وَحَمَاسَة غَيْر مَشْرُوطَيْن)",
 "こころがせまい": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "こころがひろい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "こころがまえ": "استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب",
 "こころがら": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة)",
 "こころがわり": "انقلاب, تراجع (قرار بعكس قرار سابق) / جُنُون",
 "こころくばり": "اِهْتِمَام, اِنْتِبَاه",
 "こころぐせ": "استعداد مسبق, تأهب (استعداد مسبق للتفاعل بطريقة معينة) / استعداد مسبق, تهيؤ (ميل مسبق لتفسير الأمور بطريقة معينة) / حساسية, قابلية الإصابة (القابلية للإصابة بمسببات الأمراض)",
 "こころぐみ": "تَحْضِير, إِعْدَاد",
 "こころぐるしい": "أَلِيم, مُؤْلِم",
 "こころここにあらず": "مُشتَّت",
 "こころさびしい": "وَحِيد, مُوحِش",
 "こころざし": "إرَادَة / رَغْبَة, إرَادَة / إِحْسَان / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "こころざす": "تَعَمَّدَ, نَوَى",
 "こころしずか": "هَادِئ / طَمْأَنَ",
 "こころして": "بِعِنَايَة",
 "こころじょうぶ": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "こころす": "تَوَخَّى اَلْحِذْر",
 "こころする": "تَوَخَّى اَلْحِذْر",
 "こころずくし": "إِحْسَان",
 "こころぜわしい": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "こころぞえ": "نَصِيحَة, مَشُورَة",
 "こころだて": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "こころだのみ": "اتكال, اعتماد (يقين مبني على الخبرة السابقة) / اتكال, اعتماد (حالة الاعتماد على شيء ما)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "こころづかい": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "こころづく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "こころづくし": "إِحْسَان",
 "こころづけ": "مكافأة تقديرية (مكافأة (كما في الخدمة الجديرة بالتقدير) تُعطى دون مطالبة أو التزام) / إكرامية, بقشيش (مبلغ صغير نسبياً من المال يُعطى مقابل الخدمات المقدمة (كما من قبل نادل))",
 "こころづもり": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "こころづよい": "بَاعِثٌ لِلأَمَل, مُبَشِّر (يُشجِّع بطريقة تبعث البهجة والأمل)",
 "こころない": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "こころなし": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "こころなしか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "こころならずも": "دُونَ رَغْبَة, عَلَى مَضَض (بطريقة غير راغبة)\nمثال: لقد أخطأ بحقها كرهاً",
 "こころにえがく": "تَخَيَّلَ, تَصَوَّرَ",
 "こころにかける": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころにくい": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "こころにそむ": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "こころにとどめる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころにとめる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "こころにひめる": "احتفظ بكل شيء لنسفه",
 "こころにもない": "زائف, غير مخلص (يفتقر إلى الإخلاص)\nمثال: امرأة ساحرة ولكنها غير مخلصة تماماً",
 "こころね": "قَلْب, فُؤَاد / قَلْب / كُبَّا / طَبِيعَة, طبيعة",
 "こころのいたみ": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "こころのいろ": "إِحْسَان",
 "こころのかて": "غذاء للفكر, مادة للتفكير (أي شيء يوفر حافزاً عقلياً للتفكير)",
 "こころのきんせん": "أوتار القلب, شغاف القلب (أعمق مشاعر الحب والرحمة لديك)\nمثال: العديد من حالات التبني تلامس شغاف القلب",
 "こころのこり": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "こころのささえ": "دعم معنوي (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "こころのせまい": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "こころのたいら": "مُعْتَدِل المِزَاج, هَادِئ الطَّبْع (لا يُستثار بسهولة؛ رَزين وثابت المزاج)",
 "こころのどこかで": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "こころのひろい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "こころのびょうき": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "こころのぶつかりあい": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "こころのまずしい": "بخيل, شحيح (غير راغب في إنفاق (المال، الوقت، الموارد، إلخ)) / غير كريم, لئيم (يفتقر إلى الشهامة والنبل)\nمثال: تمارس الاقتصاد دون أن تكون بخيلة",
 "こころのやさしい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "こころのやまい": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "こころのりろん": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "こころばえ": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / طَبِيعَة, طبيعة",
 "こころばかり": "صَغِير, صغير",
 "こころひそかに": "دَاخِلِيًّا, فِي السِّرّ (فيما يتعلق بالمشاعر الخاصة)\nمثال: داخلياً، كانت تغلي غضباً",
 "こころぼそい": "عَاجِز",
 "こころまち": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "こころみ": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا! / جهد, محاولة (نشاط جاد وواعي يهدف إلى فعل أو إنجاز شيء ما) / مسعى, مشروع (مشروع هادف أو كادح (خاصة المشروع الذي يتطلب جهداً أو جرأة))\nمثال: بذل جهدًا لتغطية جميع مواد القراءة",
 "こころみる": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "こころむ": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "こころもち": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً",
 "こころもとない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً / غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَصَبِيّ / غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "こころやさしい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "こころやすい": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "こころやすだて": "صراحة (سمة كون المرء صريحاً ومباشراً) / صدق, صراحة (صفة كون الشخص صادقاً ومباشراً في الموقف والكلام)",
 "こころやすめ": "مُوَاسَاة",
 "こころやすらか": "هَادِئ / طَمْأَنَ",
 "こころやぶれ": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "こころやり": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / تفكير, روية (سمة التفكير بعناية قبل التصرف) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / تأمل, تفكر (تفكير هادئ ومطول ومركّز)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "こころよい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "こころよく": "بارتياح, برغد (في راحة مالية) / بارتياح (براحة نفسية؛ دون توتر) / براحة (براحة جسدية)\nمثال: يعيشون برغد / طَوْعًا, طَوَاعِيَةً",
 "こころより": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "こころよわい": "حَسَّاس, رَقِيقُ القَلْب (يتأثّر بسهولة بمعاناة الآخرين وضيقهم) / رَقِيقُ القَلْب (سريع التأثر بالحب)",
 "こころをいたす": "كَرَّسَ, قَدَّمَ / توفر",
 "こころをいためる": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "こころをいれかえる": "إِصْلَاح",
 "こころをうごかす": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "こころをうつ": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "こころをくだく": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "こころをくばる": "أَعَارَ اِنْتِبَاه",
 "こころをこめて": "قَلْبًا وَقَالَبًا\nمثال: ２人は何年ぶりかで会ったように、心をこめて握手していた。 — كانا يتصافحان بصميمية وكأنهما لم يريا بعضهما لسنوات.",
 "こころをとらえる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "こころをゆるす": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "ここをせんどと": "باتقاد, بحرارة (بحماس وعاطفة متقدة)\nمثال: كل من المؤيدين والمعارضين مقتنعون بحرارة أنهم يتحدثون باسم الغالبية العظمى من الناس",
 "ここを先途と": "باتقاد, بحرارة (بحماس وعاطفة متقدة)\nمثال: كل من المؤيدين والمعارضين مقتنعون بحرارة أنهم يتحدثون باسم الغالبية العظمى من الناس",
 "ここんとこ": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "ここん所": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "ここ一番": "لحظة الحقيقة (لحظة حاسمة يعتمد عليها الكثير) / لحظة الحقيقة (اللحظة في مصارعة الثيران التي يقتل فيها المصارع الثور)",
 "こご": "أركايك, تعبير قديم (استخدام تعبير قديم)",
 "こごう": "مُحَارِب قَدِيم",
 "こごえ": "هَمْس / هَمَسَ, وَسْوَسَ",
 "こごえる": "تَجَمَّدَ",
 "こごし": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "こごと": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة) / شِكَايَة, شَكْوَى",
 "こごまる": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "こごみ": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "こごむ": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس) / انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "こごめぐさ": "عَرْقُون",
 "こごめる": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس)",
 "こごらす": "تَجَمَّدَ / تَفَكَّرَ, فَكَّرَ",
 "こごらせる": "تَجَمَّدَ",
 "こごり": "تجمّد, تخثر (عملية التجمد؛ التصلب عن طريق (أو كما لو كان عن طريق) التجميد)",
 "こごろし": "قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "こさい": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "こさいきん": "بكتيريا قديمة, عتائق (تُعتبر أشكال حياة قديمة تطورت بشكل منفصل عن البكتيريا والطحالب الخضراء المزرقة)",
 "こさえる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "こさぎ": "بلشون أبيض صغير (بلشون من العالم القديم)",
 "こさくにん": "إِرِّيس",
 "こさじ": "مِلْعَقَة شَاي, مِلْعَقَة صَغِيرَة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "こさっぱりした": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "こさつ": "قتل خطأ, قتل غير متعمد (قتل دون سبق إصرار وترصد)",
 "こさむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "こさめ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة\nمثال: 昨日は小雨だった。 — أمطرت مطراً خفيفاً البارحة.",
 "こさん": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "こさんしゃ": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "こさんへい": "مُحَارِب قَدِيم",
 "こざい": "أَلْصَقَ",
 "こざかしい": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء) / مَاكِر",
 "こざかな": "قَلَى",
 "こざっぱり": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "こし": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم) / مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام)) / مُسْتَدَقّ الظَّهْر / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول) / حَمَّالَة, مِحَفَّة",
 "こしあて": "صخب, ضجة (اضطراب نشط وسريع) / إطار التنورة, بستل (هيكل يُلبس في الخلف أسفل الخصر لإعطاء امتلاء لتنورة المرأة) / واقي ورك (ملابس واقية تتكون من وسادة يرتديها لاعبو كرة القدم والهوكي) / واقي الفخذ العلوي (واحدة من قطعتين من الدرع الصفيحي تتدليان من تنورة الدرع لحماية الفخذين العلويين)",
 "こしあん": "دَقِيقُ الْحُبَيْبَاتِ, مُتَرَاصّ (كثيف أو متراصّ البنية كخشب مؤلّف من خلايا صغيرة القطر) / مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "こしいれ": "عُرْس, زِفَاف",
 "こしお": "مد المحاق, مد ناقص (مد أقل من المتوسط يحدث في الربعين الأول والثالث للقمر)",
 "こしおび": "كورسيه, مشد (رداء داخلي نسائي ضيق ومشكّل) / حزام, زنار (شريط من مادة حول الخصر يقوي التنورة أو البنطال) / حزام (بنية مطوقة أو حلقية الشكل)",
 "こしおれ": "مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / وتري قوسي, يعزف بالقوس (عن آلة وترية؛ يصدر صوتاً عن طريق التمرير بالقوس) / أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / قَنْطَرِيّ, مُقَوَّس (يشكل قوسًا أو يشبهه) / تعطيل, مماطلة (تكتيك يستخدم للتضليل أو التأخير)",
 "こしおれやね": "سقف جامبريل, سقف جملوني مزدوج الميل (سقف جملوني له ميلان على كل جانب ويكون الميل السفلي أكثر انحداراً)",
 "こしかけ": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "こしかけだい": "بِنْش",
 "こしかける": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "こしかた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "こしかべ": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "こしがある": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "こしがかるい": "مُتَسَرِّع",
 "こしがき": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "こしがくだける": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "こしがつよい": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "こしがひくい": "مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "こしがひける": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "こしがみ": "ورق ترشيح (ورق مسامي غير معالج يستخدم للترشيح)",
 "こしき": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة) / مِصْفَاة / صرة, محور العجلة (الجزء المركزي لعجلة السيارة (أو المروحة ونحوها) الذي يمر من خلاله العمود أو المحور) / محور, مركز نشاط (مركز للنشاط أو الاهتمام أو التجارة أو النقل؛ نقطة محورية تدور حولها الأحداث)\nمثال: الملعب هو محور إشراف الوالدين",
 "こしきゆかしい": "تَقْلِيدِيّ",
 "こしぎんちゃく": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "こしけ": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "こした": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "こしたんたん": "بحذر, بيقظة (بطريقة يقظة)",
 "こしだか": "مُتَسَلِّط",
 "こしつ": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة. / مَعْلِف, مُرَاح / بَسْطة / أذن وسطى, تجويف طبلي (التجويف الرئيسي للأذن؛ بين طبلة الأذن والأذن الداخلية) / التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية",
 "こしつき": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "こしづよ": "عَنِيد / لَزِج",
 "こしなわ": "رِبَاط",
 "こしぬけ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こしぬの": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "こしのある": "غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "こしのくびれ": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "こしのつよい": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "こしのひくい": "مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "こしばい": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "こしばめ": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "こしばり": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة) / تلبيسة خشبية, وزرة جدارية (جدار مغطى بألواح (عادة خشبية) في جزئه السفلي)",
 "こしぼね": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة) / ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "こしまき": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "こしみの": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
 "こしゃ": "مَكْفوف",
 "こしゃく": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)",
 "こしゃほん": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "こしやね": "فَانُوس",
 "こしゅ": "تَمَسَّكَ / طبال (شخص يعزف على الطبل)",
 "こしゅう": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "こしゅく": "جُمُود, صَلَابَة (صفة كون الشخص جامداً وشديد الصرامة) / جسوءة, صلابة (الخاصية الفيزيائية لكون الشيء صلباً ومقاوماً للثني)",
 "こしゅちょう": "عصوي, قائد فرقة استعراضية (قائد فرقة موسيقية استعراضية أو فرقة طبول)",
 "こしゆ": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "こしょ": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي",
 "こしょう": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة. / تَمْرِين / مَسْأَلَة / اِعْتَرَاض / اِعْتِرَاض / بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة. / فِلْفِل, فُلْفُل (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار. / تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم) / صَفْحَة, صفحة / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "こしょういれ": "رجاجة فلفل, فلفلة (رجاجة ذات غطاء مثقوب لرش الفلفل المطحون)",
 "こしょうがく": "علم المسطحات المائية الداخلية (الدراسة العلمية للمسطحات المائية العذبة لخصائصها البيولوجية والفيزيائية والجيولوجية)",
 "こしょうしゃ": "مُعَطَّل",
 "こしょうそう": "رشاد مزروع (رشاد يزرع للسلطات والزينة)",
 "こしょうちゅう": "مُعَطَّل",
 "こしょう入れ": "رجاجة فلفل, فلفلة (رجاجة ذات غطاء مثقوب لرش الفلفل المطحون)",
 "こしょくぶつがく": "علم النباتات القديمة (دراسة النباتات الأحفورية)",
 "こしょこしょばなし": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "こしょこしょ話": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "こしょたいがく": "عِلْم الكِتَابَات القَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こしょばい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / مُحْرَج, بِٱلْحَرَج",
 "こしらえ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "こしらえごと": "فَبْرَكَة",
 "こしらえもの": "مُزَيَّف",
 "こしらえる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "こしをあげる": "قَامَ, نَهَضَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه.",
 "こしをおちつける": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "こしをおる": "قَاطَعَ",
 "こしをおろす": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "こしをかがめる": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس)",
 "こしをかける": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "こしをすえる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "こし器": "مِصْفَاة",
 "こし紙": "ورق ترشيح (ورق مسامي غير معالج يستخدم للترشيح)",
 "こし餡": "دَقِيقُ الْحُبَيْبَاتِ, مُتَرَاصّ (كثيف أو متراصّ البنية كخشب مؤلّف من خلايا صغيرة القطر) / مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "こじ": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية / يَتِيم / يَتِيمَة / تَقْلِيد / استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً / جرو النمر, فزر (نمر صغير) / كَلْبَتَان",
 "こじいん": "دَار الْأَيْتَام, مَيْتَم (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "こじか": "شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "こじき": "سَائِل / فَقِير / تَسَوُّل",
 "こじきこんじょう": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "こじし": "شبل (أسد صغير)",
 "こじつけ": "تحريف, تشويه (خطأ تحريف الحقائق) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / تحريف, تشويه (تغيير للأسوأ) / تشوه, زيغ (ظاهرة بصرية ناتجة عن فشل عدسة أو مرآة في إنتاج صورة جيدة)",
 "こじつける": "شَوَّهَ",
 "こじてきしょうひ": "استهلاك تفاخري (شراء خدمات ومنتجات باهظة الثمن من أجل التباهي بالثروة)",
 "こじま": "جُزَيِّرَة",
 "こじゃれた": "أَنِيق",
 "こじゃれる": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "こじゅう": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "こじゅうと": "أُخْت زَوْجَة (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه) / سِلْفَة / أُخْت زَوْج (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم / شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "こじゅうとめ": "أُخْت زَوْجَة (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه) / سِلْفَة / أُخْت زَوْج (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "こじょうれっとう": "هِلَالِيُّ الشَّكْلِ, هِلَالِيّ (ذو شكل يشبه الهلال)",
 "こじょく": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً) / حَوَارِيّ, تِلْمِيذ",
 "こじらいれき": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "こじらす": "تَعَقَّدَ, عَقَّدَ",
 "こじらせる": "تَعَقَّدَ, عَقَّدَ",
 "こじる": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "こじれ": "تَعْقِيد / مُضَاعَفَة",
 "こじわ": "تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "こじん": "فَرْد, شَخْص / مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم / صُغْدِيّ",
 "こじんえいぎょう": "عيادة خاصة, ممارسة خاصة (ممارسة مهنة بشكل مستقل وليس كموظف)\nمثال: يُدرس في كلية الطب لكن ثروته جاءت من عيادته الخاصة",
 "こじんかん": "بَيْنَ شَخْصِيّ (يحدث بين عدّة أشخاص أو يشملهم)",
 "こじんこうこく": "شَخْصِيّ",
 "こじんこじん": "فَرْد, شَخْص",
 "こじんご": "لَهْجَةٌ شَخْصِيَّة, كتبة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "こじんごさ": "فُرُوق فَرْدِيَّة, مُعَادَلَة شَخْصِيَّة (التباين المنسوب للفروق الفردية)",
 "こじんさ": "فُرُوق فَرْدِيَّة, مُعَادَلَة شَخْصِيَّة (التباين المنسوب للفروق الفردية)",
 "こじんしどう": "مدرب, معلم خاص (شخص يعطي تعليمات خاصة (كما في الغناء أو التمثيل، إلخ))",
 "こじんしゅぎ": "فردانية / أَنَانِيَّة",
 "こじんしゅぎしゃ": "ذُو طَابَعٍ فَرْدِيّ, فَرْدَانِيّ (يتسم بالفردانية أو يعبّر عنها) / فرداني, مستقل (شخص يتبع فكراً أو عملاً مستقلاً) / أناني, متمركز حول ذاته (شخص يركز على ذاته ولا يقيم وزناً للآخرين) / أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "こじんしょとく": "دخل شخصي (الدخل الذي يتلقاه فرد واحد)",
 "こじんじぎょう": "أمور شخصية, شأن خاص (مسائل ذات اهتمام شخصي)\nمثال: رتب أموره الشخصية",
 "こじんじぎょうしゃ": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "こじんじむしょ": "عيادة خاصة, ممارسة خاصة (ممارسة مهنة بشكل مستقل وليس كموظف)\nمثال: يُدرس في كلية الطب لكن ثروته جاءت من عيادته الخاصة",
 "こじんじょうほうせっとう": "سرقة الهوية (الاستيلاء على المعلومات الشخصية لشخص آخر (مثل الاسم، رقم الضمان الاجتماعي، رقم بطاقة الائتمان، جواز السفر) دون علم ذلك الشخص والاستخدام الاحتيالي…)",
 "こじんじょうほうとうなん": "سرقة الهوية (الاستيلاء على المعلومات الشخصية لشخص آخر (مثل الاسم، رقم الضمان الاجتماعي، رقم بطاقة الائتمان، جواز السفر) دون علم ذلك الشخص والاستخدام الاحتيالي…)",
 "こじんじょうほうのせっとう": "سرقة الهوية (الاستيلاء على المعلومات الشخصية لشخص آخر (مثل الاسم، رقم الضمان الاجتماعي، رقم بطاقة الائتمان، جواز السفر) دون علم ذلك الشخص والاستخدام الاحتيالي…)",
 "こじんじょうほうのとうなん": "سرقة الهوية (الاستيلاء على المعلومات الشخصية لشخص آخر (مثل الاسم، رقم الضمان الاجتماعي، رقم بطاقة الائتمان، جواز السفر) دون علم ذلك الشخص والاستخدام الاحتيالي…)",
 "こじんじょうほうほごほうしん": "سياسة الخصوصية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "こじんすうはい": "عِبَادَة شَخْصِيَّة",
 "こじんせい": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً) / تفرد, فردية (صفة كون المرء فرداً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش",
 "こじんたいしょくきんつみたてけいかく": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "こじんたいしょくこうざ": "حساب تقاعد فردي (خطة تقاعد تسمح لك بالمساهمة بمبلغ سنوي محدود للتقاعد؛ ويتم تأجيل الضرائب على الفوائد المكتسبة في الحساب)",
 "こじんつうしんサービス": "حاسوب شخصي (حاسوب رقمي صغير يعتمد على معالج دقيق ومصمم ليستخدمه شخص واحد في كل مرة)",
 "こじんてき": "شَخْصِيّ",
 "こじんびょういん": "عِيَادَة, مَصَحَّة",
 "こじんまり": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام",
 "こじんるいがく": "أنثروبولوجيا قديمة, علم الحفريات البشرية (الدراسة العلمية للحفريات البشرية)",
 "こじんコミュニケーションサービス": "حاسوب شخصي (حاسوب رقمي صغير يعتمد على معالج دقيق ومصمم ليستخدمه شخص واحد في كل مرة)",
 "こじんチャット": "رِسَالَة خَاصَّة",
 "こじんローン": "قرض استهلاكي, قرض شخصي (قرض يؤسس ائتماناً استهلاكياً يُمنح للاستخدام الشخصي؛ عادة ما يكون غير مضمون ويعتمد على نزاهة المقترض وقدرته على الدفع)",
 "こす": "فَاقَ, تَجَاوَزَ / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / مِصْفَايَة / فِلْتَر / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "こすい": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة. / إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / حَمَاسِيّ, مُحَفِّز (يحثّ على النشاط أو يُصَعِّد الفعل كأنّه يَحْفِز ويَدْفَع) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: الهدف من الفن هو إثارة العواطف / محاماة / تَأْييد / مُنَاصَرَة / خَبِيث, مَاكِر / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل. / كُزْبَرَة, قُسْبَرَة",
 "こすいしゃ": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "こすう": "كَمِّيَّة, مِقْدَار",
 "こすからい": "خَبِيث, مَاكِر",
 "こすっからい": "خَبِيث, مَاكِر",
 "こすみつけ": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "こすみつける": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "こすり": "احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / طبع بالفرك (تمثيل يتكون من نسخة (كما لنقش) مصنوعة بوضع ورقة فوق شيء ما وفركها بالفحم) / احتكاك (المقاومة التي يتم مواجهتها عند تحريك جسم متلامس مع آخر)",
 "こすりつける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "こすり付ける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "こする": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ جلدَه : فركه بأظفاره)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب / خلطة علفية, هريس (خليط من أعلاف الحيوانات المطحونة) / نقيع الشعير, هريس (خليط من حبوب الشعير المهروسة والماء الساخن؛ يستخدم في التخمير) / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "こすれあう": "إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / التهاب بالاحتكاك, سحجة (ألم ودفء ناتج عن الاحتكاك)\nمثال: كان لديه سحجة سيئة على ركبته / نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "こずえ": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "こずかい": "مَصْرُوف جَيْب, مَصْرُوف",
 "こせい": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً) / تفرد, فردية (صفة كون المرء فرداً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / ديكسترين (أي من السكريات المتعددة المختلفة التي يتم الحصول عليها عن طريق التحلل المائي للنشا؛ مادة صمغية عديمة الطعم والرائحة تُستخدم كعامل تكثيف وفي المواد…)",
 "こせいしょくぶつがく": "علم النباتات القديمة (دراسة النباتات الأحفورية)",
 "こせいたいがく": "بيئة قديمة (فرع علم البيئة الذي يدرس البيئة القديمة)",
 "こせいてき": "فَرْد, شَخْص",
 "こせいぶつがく": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "こせいぶつがくしゃ": "عالم حفريات, عالم مستحاثات (متخصص في علم الحفريات)",
 "こせがれ": "بَانْك",
 "こせき": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "こせこせ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "こせん": "قَوْس, مُنْحَنَى",
 "こせんがく": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "こせんがくしゃ": "جامع عملات, عالم عملات (جامع ودارس للنقود (والعملات المعدنية بشكل خاص))",
 "こせんきょう": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "こぜに": "فُرَاطَة",
 "こぜりあい": "مُنَاوَشَة / شِجَار / شَاجَرَ",
 "こそ": "بِدِقَّة / رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "こそあれ": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "こそう": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "こそうきん": "عصوية رقيقة (نوع من العصويات يوجد في التربة والمواد العضوية المتحللة؛ تنتج بعض سلالاتها مضادات حيوية)",
 "こそうねつ": "حمى القش (التهاب أنف موسمي ناتج عن رد فعل تحسسي لحبوب اللقاح)",
 "こそく": "مُتَسَلِّل, مُحْتَال (يتسم بالخداع والمراوغة) / من أسفل الذراع (مع تقديم اليد ورفعها من تحت مستوى الكتف)\nمثال: رمية من أسفل الذراع / بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "こそぐったい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة)",
 "こそぐる": "دَغْدَغَة",
 "こそこそ": "خلسة, سراً (بطريقة سرية)\nمثال: كان يراقبها خلسة وهي تنتظر في ردهة الفندق",
 "こそこそどろぼう": "لص متسلل (لص يسرق دون استخدام العنف)",
 "こそこそばなし": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "こそこそ泥棒": "لص متسلل (لص يسرق دون استخدام العنف)",
 "こそこそ話": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "こそすれ": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "こそだて": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "こそっと": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "こそどろ": "لص متسلل (لص يسرق دون استخدام العنف)",
 "こそばい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / مُحْرَج, بِٱلْحَرَج",
 "こそばゆい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / مُحْرَج, بِٱلْحَرَج",
 "こそ泥": "لص متسلل (لص يسرق دون استخدام العنف)",
 "こぞ": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "こぞう": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال / ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "こぞっこ": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "こぞって": "كُلّ, جَمِيع",
 "こたい": "فَرْد, شَخْص / خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "こたいかがく": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "こたいぐん": "سُكَّان / سُكَّانِيَّة",
 "こたいさつぞうデバイス": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "こたいすう": "سُكَّان / سُكَّانِيَّة",
 "こたいせい": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً) / تفرد, فردية (صفة كون المرء فرداً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش",
 "こたいち": "تغذية وريدية (إعطاء المغذيات عبر الوريد) / أَرْبَعَة (يَدُلُّ عَلَى العَدَد 4) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "こたいはっせい": "تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "こたいはっせいろん": "تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "こたいわくせい": "كَوْكَب أَرْضِيّ, كَوْكَب صَخْرِيّ (كوكب له سطح صخري صلب مثل سطح الأرض؛ الكواكب الأربعة الداخلية في النظام الشمسي)",
 "こたいレーザ": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "こたいロケット": "صاروخ بالوقود الصلب, محرك صاروخي بالوقود الصلب (محرك صاروخي كيميائي يستخدم الوقود الدافع في الحالة الصلبة)",
 "こたう": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "こたえ": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "こたえられない": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "こたえる": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد. / دُبّ / دُبَّة / اِحْتَمَلَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / سَامَحَ / غَفَرَ",
 "こたか": "صَقَارَة",
 "こたかがり": "صَقَارَة",
 "こたにわたり": "سرخس الشريط الفلوريدي, سرخس لسان البقر (سرخس هوائي أو أرضي أحياناً شائع ذو أوراق شريطية خضراء مصفرة شاحبة؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى أوروغواي) / سرخس لسان الأيل, لسان الأيل (سرخس أوراسي بسعف رمحي بسيط) / أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "こたび": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "こだい": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟ / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "こだいし": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "こだいじん": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط الإمبراطورية الرومانية في أوروبا الغربية))",
 "こだいせんでん": "تَهْوِيل, دِعَايَة صَاخِبَة (ترويج صارخ أو مثير)",
 "こだいまい": "أرز بري (حبوب عشب مائي من أمريكا الشمالية) / أرز بري (عشبة مائية معمرة في أمريكا الشمالية تحمل حبوباً تستخدم للغذاء)",
 "こだいむらさき": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "こだいもうそう": "جنون العظمة, ميغالومانيا (حالة نفسية تتميز بأوهام العظمة)",
 "こだいもうそうきょう": "جنون العظمة, ميغالومانيا (حالة نفسية تتميز بأوهام العظمة)",
 "こだいエジプト": "مِصْر اَلْقَدِيمَة (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "こだいギリシア": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "こだいギリシアご": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "こだいギリシャ": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "こだいギリシャご": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "こだいローマ": "رُومَا الْقَدِيمَة (ولاية إيطالية؛ مدينة هي عاصمة ولاية روما الإيطالية)\nمثال: روما مدينة قديمة.",
 "こだかいおか": "أكمة, رابية (تل طبيعي صغير)",
 "こだから": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "こだき": "انهيمار, وابل (هطول مفاجئ (للدموع أو الشرر وما إلى ذلك) يشبه زخات المطر) / تتالي, سلسلة مترابطة (تتابع لمراحل أو عمليات أو وحدات) / سلسلة شلالات, شلال صغير (شلال صغير أو سلسلة من الشلالات الصغيرة)\nمثال: وابل صغير من بتلات الورد",
 "こだち": "بستان, غابة صغيرة (حديقة تتكون من خشب مزروع صغير بدون شجيرات سفلية) / أيكة, بستان (نمو صغير للأشجار بدون شجيرات تحتية)",
 "こだて": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / مَجْلِس",
 "こだね": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / نُطْفَة, حَيَوَان مَنَوِيّ (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / نُطْفَة, مَنْي (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ)",
 "こだま": "صَدًى / قطرة, كرية (كرة صغيرة)",
 "こだら": "سمك الحدوق, سمك القد (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "こだわり": "هَوَس / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ) / اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني) / خاصية, سمة مميزة (سمة مميزة) / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "こだわる": "صخب, ضجة (اضطراب نشط وسريع) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة) / إزعاج, جلبة (اضطراب غاضب) / اضطراب, حيرة (حالة من الهياج المثار)\nمثال: لم يرد إثارة جلبة / أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "こち": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / مسطحة الرأس (سمكة غذائية في المنطقة الإندونيسية من المحيط الهادئ؛ تشبه الغرنار) / رياح شرقية (رياح تهب من الشرق)",
 "こちかぜ": "رياح شرقية (رياح تهب من الشرق)",
 "こちこち": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "こちごちし": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "こちとら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "こちゃく": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية / تَمَسَّكَ",
 "こちゃくかんねん": "هَوَس",
 "こちゅう": "حييوان, فرد مستعمرة (أحد الأفراد المتميزين الذين يشكلون حيواناً مستعمراً مثل الحيوانات الطحلبية أو الهيدرية) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こちょう": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة. / نَفْخ, نَفْخَة (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ / فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "こちょうげんぼう": "يؤيؤ",
 "こちょうほう": "مُبَالَغَةٌ (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "こちょうらん": "أوركيد العثة, فالاينوبسيس (أي من بساتين الفاكهة المختلفة من جنس فالاينوبسيس ذات أوراق بيضاوية أو بيضاوية مقلوبة عريضة لامعة متدلية غالباً خضراء داكنة مشوبة بالأرجواني أو مرقطة…)",
 "こちょぐったい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة)",
 "こちょこちょ": "دغدغة (فعل الدغدغة) / دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "こちょばい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / مُحْرَج, بِٱلْحَرَج",
 "こちら": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "こちりがく": "جغرافيا قديمة (دراسة جغرافيا العصور القديمة أو الحقب القديمة)",
 "こちんこちん": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / مُتَأَهِّب, مُسْتَثَار (أُوصِلَ إِلَى حَالَةِ تَوَتُّرٍ شَدِيد)",
 "こぢんまり": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام",
 "こっか": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / نَشِيد وَطَنِيّ\nمثال: イギリスに１７４５年以前に国歌がなかったという事実は、それ自体はほとんどたいしたことではない。 — ان حقيقة بريطانيا كانت لا تملك نشيداً وطنياً قبل ١٧٤٥ هي بحد ذاتها شأن يذكر. / تَعَظُّم / تسويد, تعتيم (التغيير إلى لون أغمق)",
 "こっかあんぜんほしょうかいぎ": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية والعسكرية والأمن القومي؛ تشرف على وكالة الاستخبارات المركزية)",
 "こっかあんぜんほしょうきょく": "وكالة الأمن القومي (منظمة التشفير الأمريكية التي تنسق وتوجه الأنشطة عالية التخصص لحماية أنظمة المعلومات الأمريكية وإنتاج معلومات استخباراتية أجنبية)",
 "こっかい": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها) / الْبَحْر الْأَسْوَد, بَحْرُ نِيطَش / رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة الخزف العظمي) / إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "こっかいぎいん": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "こっかいぎじどう": "كَابِيتُول الوِلَايَات المُتَّحِدَة",
 "こっかいし": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران) / معترف (شخص يعترف (يكشف معلومات تضر بنفسه))",
 "こっかいじき": "خزف عظمي (بورسلين فاخر يحتوي على رماد العظام)",
 "こっかいじょう": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "こっかきみつ": "سِرّ دَوْلَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "こっかく": "هَيْكَل عَظْمِيّ, هَيْكَل / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "こっかくきん": "عضلة مخططة, عضلة هيكلية (عضلة متصلة في أحد طرفيها أو كليهما بعظم وبالتالي تحرك أجزاء من الهيكل العظمي؛ عضلة تتميز بخطوط عرضية)",
 "こっかげんしゅふじん": "السيدة الأولى (زوجة الرئيس التنفيذي) / سيدة أولى (المرأة الرائدة في فن أو مهنة)",
 "こっかしどうしゃ": "رجل دولة, قائد وطني (شخص يعد قائداً محترماً في الشؤون الوطنية أو الدولية)",
 "こっかしほんしゅぎ": "رأسمالية الدولة (نظام اقتصادي رأسمالي في المقام الأول ولكن مع وجود درجة من الملكية الحكومية لوسائل الإنتاج)",
 "こっかしゃかいしゅぎ": "اشتراكية الدولة (نظام اقتصادي تمتلك فيه الحكومة معظم وسائل الإنتاج ولكن يُسمح ببعض درجات الرأسمالية الخاصة) / نَازِيَّة",
 "こっかしゅぎ": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "こっかしゅぎしゃ": "قَوْمِيّ, قَوْمِيَّة",
 "こっかしゅせき": "رَئِيس دَوْلَة",
 "こっかそんぼう": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "こっかてき": "وَطَنِيّ, قَوْمِيّ",
 "こっかてんぷく": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها) / إفساد, تخريب (تدمير أمانة شخص (أو مجموعة) أو ولائهم؛ تقويض النزاهة الأخلاقية)\nمثال: إفساد قاصر",
 "こっかのいぬ": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "こっかはんぎゃくざい": "خِيَانَة عُظْمَى",
 "こっかん": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "こっき": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / علم وطني (شعار يُرفع كرمز للجنسية) / منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "こっきょう": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "こっきょうけいびたい": "حرس الحدود (مجموعة من الضباط الذين يقومون بدوريات على حدود الدولة)",
 "こっきょうけいびへい": "حَرْس الْحُدُود (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "こっきょうせん": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "こっきょうちたい": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "こっきょく": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "こっきり": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "こっくり": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / فَجْأَةً / عَمِيق, غَوِيط",
 "こっくん": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "こっけい": "مُضْحِك, هَزْلِيّ / سَخِيف, مَسْخَرَة / يَوْم وَطَنِيّ (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "こっけいが": "كَارِيكَاتِير, كَارِيكَاتُور",
 "こっけいしゃ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "こっけいしゃだつ": "بَلِيغ الدُّعَابَة, حَاضِر البَدِيهَة (يجمع بين الفكرة الذكيّة والتعبير الطريف)",
 "こっけい者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "こっこさいけん": "سندات الخزانة (أداة دين بآجال استحقاق تبلغ 10 سنوات أو أكثر)",
 "こっし": "لُبّ / دهن العظام (مادة دهنية في العظام تُستخرج بالمذيبات أو بالغليان أو بالبخار؛ تُستخدم بشكل رئيسي في الشموع والصابون الرخيص وشحوم التزييت)",
 "こっしゅ": "ورم عظمي (ورم حميد بطيء النمو يتكون من نسيج عظمي؛ عادة على الجمجمة أو الفك السفلي)",
 "こっせつ": "مُشْتَرَك / مِفْصَل",
 "こっそ": "تَسَوُّس",
 "こっそう": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "こっそうがく": "علم فراسة الدماغ, فرينولوجيا (دراسة مهجورة الآن لشكل الجمجمة كمؤشر على قوى الملكات العقلية المختلفة)",
 "こっそうがくしゃ": "أخصائي فراسة الدماغ (شخص يدعي القدرة على قراءة شخصيتك من شكل جمجمتك)",
 "こっそり": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "こった": "مُفَصَّل / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "こったん": "أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "こっち": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / فَجْأَةً",
 "こっちとら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "こっちゃ": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "こっちょう": "اِرْتِفَاع",
 "こってり": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "こっとう": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / صَلَع",
 "こっとういち": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "こっとうひん": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "こっぱ": "شَظِيَّة",
 "こっぱい": "رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة الخزف العظمي) / وَرَقَة لَعْب, وَرَقَة",
