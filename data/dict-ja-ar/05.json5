 "こつずいきゅう": "خلية نخاعية (خلية دم بيضاء غير ناضجة توجد عادة في نخاع العظم)",
 "こつずいしゅ": "ورم نقوي (ورم في نخاع العظم (عادة ما يكون خبيثًا) يتكون من خلايا توجد عادة في نخاع العظم)",
 "こつずいせんいしょう": "تليف نقي العظم (تليف نخاع العظم)",
 "こつぜん": "مُبَاغِت, مُفَاجِئ / شَاهِق / سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "こつそしょうしょう": "هَشَاشَةُ العِظَام",
 "こつぞうしょくたい": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "こつどう": "مستودع العظام, مقبرة العظام (قبو أو مبنى تُودع فيه الجثث أو العظام)",
 "こつなんかしょう": "لين العظام (تلين غير طبيعي للعظام بسبب نقص الفوسفور أو الكالسيوم أو فيتامين د)",
 "こつなんこつしゅ": "ورم عظمي غضروفي (ورم حميد يحتوي على كل من العظام والغضاريف؛ يحدث عادة بالقرب من نهاية العظام الطويلة)",
 "こつにく": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر) / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "こつにくしゅ": "ساركومة عظمية (ورم عظمي خبيث؛ أكثر شيوعًا عند الأطفال والشباب حيث يميل إلى التأثير على عظم الفخذ)",
 "こつにくそうしょく": "اِنْتِقَام, ثَأْر دَمَوِيّ (عداء يقتل فيه أعضاء الأطراف المتعارضة بعضهم البعض)",
 "こつねんれい": "عمر عظمي (عمر الشخص مقاساً بمطابقة نمو عظامه (كما يظهر في الأشعة السينية) مع نمو عظام شخص متوسط من عمر زمني معروف)",
 "こつばい": "رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة الخزف العظمي)",
 "こつばん": "حَوْض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "こつばんい": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "こつばんたい": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف الخلفية أو الأجزاء المماثلة في الفقاريات الأخرى)",
 "こつぶ": "صَغِير, صغير / مَحْدُود",
 "こつまく": "سِمْحَاق",
 "こつめいろ": "تِيه عَظْمِيّ (تجويف في الجزء الصخري من العظم الصدغي يحتوي على التيه الغشائي)",
 "こつゆ": "زيت العظام (زيت داكن اللون كريه الرائحة يتم الحصول عليه بتفحيم العظام؛ يُستخدم خاصة في محاليل تغطيس الأغنام وفي تغيير طبيعة الكحول) / زيت العظام (الجزء السائل من دهن العظام؛ يُستخدم كمواد تشحيم وفي صناعة الجلود)",
 "こつりつ": "شَاهِق",
 "こつをつかむ": "أَتْقَنَ, بَرَعَ (أن يصبح بارعاً أو ماهراً تماماً في شيء ما)\nمثال: أتقنت اليابانية في أقل من عامين",
 "こつを掴む": "أَتْقَنَ, بَرَعَ (أن يصبح بارعاً أو ماهراً تماماً في شيء ما)\nمثال: أتقنت اليابانية في أقل من عامين",
 "こつ然": "مُبَاغِت, مُفَاجِئ",
 "こづかい": "مَصْرُوف جَيْب, مَصْرُوف / بَوَّاب",
 "こづかいせん": "مَصْرُوف جَيْب, مَصْرُوف",
 "こづかいぜに": "مَصْرُوف جَيْب, مَصْرُوف",
 "こづきまわす": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "こづき回す": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "こづく": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "こづち": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار الرصف أو للتكسير أو الضرب أو التسطيح أو التنعيم) / عصا الإيقاع, مطرقة الطبل (عصا طبل خفيفة ذات رأس مستدير تستخدم لضرب الآلات الإيقاعية مثل الأجراس والطبول) / صولجان, مطرقة رياضية (أداة رياضية ذات مقبض طويل ورأس يشبه المطرقة؛ تستخدم في الألعاب الرياضية (البولو أو الكروكيت) لضرب الكرة)",
 "こづつみ": "رِزْمَة, رُزْمَة",
 "こづつみばくだん": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "こづつみゆうびんぶつ": "رِزْمَة, رُزْمَة",
 "こづめ": "حلية هلالية (حلية معدنية على شكل هلال من العصر البرونزي) / ظفرة, هلالية الظفر (المنطقة الهلالية الشكل عند قاعدة ظفر الإنسان)",
 "こづらにくい": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "こて": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى) / عقاب الممر (شكل من أشكال العقاب يُجبر فيه الشخص على الركض بين صفين من الرجال يواجهون بعضهم البعض ومسلحين بهراوات أو سياط لضرب الضحية) / قفاز طويل (قفاز بكم طويل) / قفاز مدرع (قفاز من الجلد المدرع؛ يحمي اليد) / تحدي, قفاز التحدي (عرض أو قبول تحد)\nمثال: رمى قفاز التحدي / قُفَّاز, كَفّ / سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة. / مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / لفافة شعر, مجعد شعر (جهاز ميكانيكي يتكون من أنبوب أسطواني يُلف حوله الشعر لتجعيده) / مجند بالإكراه (شخص يخدع الرجال أو يجبرهم على الخدمة كبحارة أو جنود) / أداة كبس, زرادية كبس (أداة يدوية تستخدم لربط قطعتين من المعدن أو مادة أخرى قابلة للطرق (عادة سلك وصفيحة معدنية) عن طريق تشويه أحدهما أو كليهما لتثبيت الآخر)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً / مِجْرَفَة, مَالَج / مَالَج",
 "こてい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / إخصاء, تعقيم الحيوانات (تعقيم الحيوان) / أداة تثبيت, مثبت (قيد يربط بشيء ما أو يثبت شيئاً في مكانه)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان) / دَافِئ, مُرِيح (يوفر دفئاً مريحاً ومأوى خاصة في مكان صغير) / مُحْكَم البِنَاء (مبنيّ بإحكام ومتانة) / مُحْكَم, مُلائِم (ضَيِّق وَمُلائِم لِلجِسْم بِشَكْل مُريح) / آمِن, مُحْتَمٍ (يوفّر الأمان؛ محميّ أو مخبَّأ بشكل جيّد)",
 "こていか": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان) / تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة) / تثبيت, شل حركة (تثبيت جزء من الجسم (كما هو الحال بجبيرة الجبس) لتعزيز الشفاء السليم)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "こていかんねん": "صُورَة نَمَطِيَّة",
 "こていきおくそうち": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "こていきゃく": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "こていざい": "مثبت (ورنيش مذاب في الكحول ويرش على الصور لمنع التلطخ) / مثبت (مركب (مثل الإيثانول أو الفورمالديهايد) يثبت الأنسجة والخلايا للدراسة المجهرية)",
 "こていし": "عضو ثابت (جهاز ميكانيكي يتكون من الجزء الثابت من محرك أو مولد يدور فيه أو حوله الدوار)",
 "こていしさんぜい": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "こていしょうすうてんひょうじほう": "تدوين النقطة الثابتة (نظام عد جذري يُحدد فيه موقع الفاصلة العشرية بالاتفاق)",
 "こていそうば": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف الثابت لا يتغير وفقاً لظروف السوق)",
 "こていち": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "こていはばフォント": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "こていひ": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "こていひよう": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "こていディスク": "قُرْص صُلْب",
 "こていビットレート": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "こてこて": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / تماماً, كلياً (عبر النطاق بالكامل)\nمثال: تبلل تماماً في المطر",
 "こてさき": "رَخِيص",
 "こてしらべ": "تجربة أداء (اختبار لمدى ملاءمة فنان أو مؤدٍ) / اختبار, تجربة (تجربة شيء ما لمعرفة المزيد عنه)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام",
 "こてん": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي / فَجْأَةً",
 "こてんおんがく": "مُوسِيقَى كْلَاسِيكِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "こてんがく": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "こてんがくしゃ": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي) / باحث كلاسيكي, كلاسيكي (طالب أو باحث في اللغتين اليونانية واللاتينية القديمة)",
 "こてんこだい": "اَلْعُصُورُ ٱلْكلَاسِيكِيَّةُ ٱلْقَدِيمَةُ",
 "こてんこてん": "تَمَامًا",
 "こてんしゅぎ": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت العقلانية وضبط النفس والأشكال الصارمة)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "こてんしゅぎしゃ": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي) / باحث كلاسيكي, كلاسيكي (طالب أو باحث في اللغتين اليونانية واللاتينية القديمة)",
 "こてんてき": "تَقْلِيدِيّ, كْلَاسِيكِيّ",
 "こてんてきじょうけんづけ": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء حدثت الاستجابة الشرطية أم لا حتى يأتي المحفز المحايد في النهاية لإثارة…)",
 "こてんぱ": "تَمَامًا",
 "こてんぱん": "تَمَامًا",
 "こてんりきがく": "ميكانيكا كلاسيكية, ميكانيكا نيوتنية (فرع الميكانيكا القائم على قوانين نيوتن للحركة)",
 "こてんギリシアご": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "こてんギリシャご": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "こてんラテンご": "لَاتِينِيَّة كْلَاسِيكِيَّة (المنسوبة إلى المنطقة المحيطة بمدينة روما والتي كانت تسمى لَاتِيْن في عصر الروم وأصبحت الآن تسمى لَازِيُو؛ المنسوبة إلى اللَاتِيْن، وهم دول أمريكا الشمالية والوسطى الذين يتحدثون لغات من أصل لاتينيّ، خصوصا الإِسْبَانِيَّة والبُرْتُغَالِيَّة)\nمثال: أعرف اللاتينية.",
 "こでん": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "こと": "كوتو (آلة وترية يابانية تشبه الزيثير؛ لها لوحة صوت خشبية مستطيلة وعادة 13 وتراً حريرياً يتم نقرها بالأصابع) / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / حَادِث, حَادِثَة / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "ことあげ": "إِعْلَان, بَيَان",
 "ことあたらしい": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "ことあたらしく": "مَرَّة ثَانِيَة (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ことあらためて": "مَرَّة ثَانِيَة (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "ことう": "مصباح قوسي (مصباح ينتج الضوء عند تدفق تيار كهربائي عبر فجوة بين قطبين)",
 "ことかく": "نَقْص, عَدَم وُجُود",
 "ことがら": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم.",
 "こときれる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ことこと": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "ことこまか": "مُفَصَّل",
 "ことこまかい": "مُفَصَّل",
 "ことこまかに": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "ことこまやか": "مُفَصَّل",
 "ことごころ": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "ことごと": "كُلّ شَيْء",
 "ことごとく": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "ことごとしい": "طَنَّان, مُنْتَفِخ (مُتعالٍ ومُتكلَّف في الأسلوب بشكل استعراضي)",
 "ことさら": "عَمْدًا / خُصُوصًا, خَاصَّةً",
 "ことざ": "كِنَّارَة",
 "ことじたい": "نَفْسُهُ, نَفْسُهَا",
 "ことたりる": "كَفَى",
 "ことたる": "كَفَى",
 "ことづけ": "رِسَالَة, خَبَر / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "ことづける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "ことづて": "رِسَالَة, خَبَر",
 "ことてん": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "こととて": "لِأَنَّ / هكذا, بلا سبب",
 "ことどころ": "في مكان آخر (في أو إلى مكان آخر)\nمثال: ذهب إلى مكان آخر / بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "ことども": "أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت",
 "ことなく": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "ことなし": "خالٍ من الأحداث, رتيب (يتميز بعدم وجود أحداث جديرة بالملاحظة أو هامة)\nمثال: حياة خالية من الأحداث / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ことなる": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "ことに": "خُصُوصًا, خَاصَّةً / بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "ことにする": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "ことにすると": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "ことによって": "بِوَاسِطَة, عَن طَرِيق / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)",
 "ことにより": "بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض.",
 "ことによる": "بِسَبَب, مِنْ جَرَّاء",
 "ことによると": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / بِأَيّ حَال, بِإِمْكَان (إلى درجة يمكن تحقيقها أو بوسائل ممكنة)\nمثال: ربما ستتصل غداً",
 "ことのえ": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "ことのしだい": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ことのは": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "ことのほか": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "ことのほったん": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "ことの発端": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "ことば": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة. / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "ことばあそび": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "ことばえらび": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "ことばがき": "مُقَدِّمَة",
 "ことばじり": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "ことばすくな": "وجيز",
 "ことばずくな": "وجيز",
 "ことばずけな": "وجيز",
 "ことばたくみ": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "ことばだくみ": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "ことばつき": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ことばづかい": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ことばてん": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "ことばどおり": "حَرْفًا بِحَرْفٍ, حَرْفِيًّا",
 "ことばにあらわせない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات) / جَلَّ عَنِ الوَصْفِ, لَا يُنْطَق (أقدس من أن يُنطَق به أو يُذكَر)",
 "ことばにする": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "ことばのあや": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "ことばのかべ": "حاجز لغوي (حاجز أمام التواصل ناتج عن التحدث بلغات مختلفة)",
 "ことばのサラダ": "سَلَطَة كَلِمَات (خليط من الكلام غير المترابط كما يُسمع أحياناً في الفصام)",
 "ことばをかえす": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا. / معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "ことばをかける": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ことばをきる": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "ことばをつぐ": "تَابَعَ, اِسْتَمَرَّ",
 "ことばをのこす": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "ことばをのむ": "صَمَتَ",
 "ことばをはく": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "ことば典": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "ことば巧み": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "ことば選び": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "ことぶき": "مُبَارَك, مَبْرُوك / أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "ことぶく": "هَنَّأَ, يُهَنِّئُ",
 "ことほき": "مُبَارَك, مَبْرُوك",
 "ことほぎ": "مُبَارَك, مَبْرُوك",
 "ことほぐ": "هَنَّأَ, يُهَنِّئُ",
 "ことほどさように": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "ことほど左様に": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "ことめずらし": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "こともなげに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "ことゆえ": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ことよろ": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "ことり": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "ことわざ": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "ことわり": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / تَصْرِيح, سَمَاح / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "ことわりをいれる": "بَلَّغَ, أَبْلَغَ",
 "ことわる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / بَلَّغَ, أَبْلَغَ",
 "ことをなす": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "ことをはこぶ": "اِنْطَلَقَ / اِنْبَثَق",
 "ことを運ぶ": "اِنْطَلَقَ / اِنْبَثَق",
 "ことん": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "こと切れる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "こと座": "كِنَّارَة",
 "こと無く": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "こと細か": "مُفَصَّل",
 "こと細かい": "مُفَصَّل",
 "こと細かに": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "こと細やか": "مُفَصَّل",
 "こと自体": "نَفْسُهُ, نَفْسُهَا",
 "こと足りる": "كَفَى",
 "こどう": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "こどうきょう": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "こどうぐ": "جِهَاز / مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه. / تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "こどうぐかた": "مسؤول الإكسسوارات المسرحية (عضو في طاقم المسرح مسؤول عن الممتلكات والإكسسوارات)",
 "こどうぶつがく": "علم الحيوانات القديمة (دراسة الحيوانات الأحفورية)",
 "こどうみゃく": "شريان فخذي (الشريان الرئيسي للفخذ؛ وهو استمرار للشريان الحرقفي الظاهر)",
 "こどく": "عُزْلَة",
 "こどくかん": "اِنْفِرَاد / عُزْلَة / وَحْدَة",
 "こども": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "こどもあそび": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "こどもぎゃくたい": "إِسَاءَة مُعَامَلَة لِلْأَطْفَال, إِسَاءَة مُعَامَلَة الْأَطْفَال",
 "こどもしつ": "غرفة طفل (غرفة نوم للطفل)",
 "こどもしゅう": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "こどもじだい": "طُفُولَة",
 "こどもじみた": "طُفُولِيّ",
 "こどもたち": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "こどもだまし": "تافِه",
 "こどもっぽい": "طُفُولِيّ",
 "こどものつかい": "سعي عبثي, مهمة حمقاء (مهمة غير مثمرة)",
 "こどもべや": "غرفة طفل (غرفة نوم للطفل)",
 "こどもらしい": "طُفُولِيّ",
 "こな": "طَحِين, دَقِيق / هِيرُويْن",
 "こない": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي. / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "こないだ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "こなおしろい": "بودرة الوجه (مسحوق تجميلي للوجه)",
 "こなぐすり": "بُودْرَة",
 "こなごなにする": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "こなさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "こなざとう": "سكر بودرة, سكر ناعم (سكر محبب إلى مسحوق ناعم)",
 "こなし": "عَرَبَة / أَبْتَر ((أَبْتَرَه) بَتَرَه؛ (أَبْتَرَ) الله فلَاناً: أعقَمَه)",
 "こなじょう": "مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "こなじらみ": "ذبابة بيضاء (حشرة دقيقة تتغذى على عصارة النباتات؛ قريبة من الحشرات القشرية)",
 "こなす": "هَضَمَ / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "こなせっけん": "مسحوق الصابون (صابون في شكل مسحوق مخلوط بمواد قلوية)",
 "こなた": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / هُوَ / مُنْذُ / لِأَنَّ / ـنِي, ـنِيَ / ـِي, ـِيَ",
 "こなたさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "こなっぽい": "بُودْرِيّ, مَسْحُوقِيّ (ذو مظهر ناعم كالبودرة في اللون) / مَسْحُوق, مُسَحَّق (يتكوّن من جزيئات دقيقة ناعمة)",
 "こなひき": "طَحَّان, طَحَّانَة",
 "こなまいき": "صَفَاقَة, وَقَاحَة",
 "こなみ": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / تموج ((في الإلكترونيات) تذبذب ذو سعة صغيرة مفروض فوق قيمة ثابتة)",
 "こなや": "طَحَّان, طَحَّانَة / مَطْحَنَة, رحى / طَحَن (طَحَنَ؛ طِحْنٌ)",
 "こなら": "بلوط الغار (بلوط كبير شبه دائم الخضرة تقريباً من جنوب شرق الولايات المتحدة؛ يزدهر في التربة الرطبة) / بلوط المستنقعات, بلوط دبوسي (شجرة متساقطة الأوراق هرمية سريعة النمو متوسطة إلى كبيرة من شمال شرق الولايات المتحدة وجنوب شرق كندا لها أوراق ريشية عميقة تتحول إلى الأحمر الساطع في…)",
 "こなれ": "هَضْم / طَبِيعِيَّة, وَاقِعِيَّة (مماثلة التمثيل للشيء الممثل) / طَبِيعِيَّة, عَفْوِيَّة (صفة كون الشيء طبيعياً أو قائماً على مبادئ طبيعية) / بَرَاءَة, عَفْوِيَّة (صفة السذاجة البريئة)\nمثال: سعى المهندسون لزيادة طبيعية الموسيقى المسجلة",
 "こなれる": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / نَاضِج, رَاشِد",
 "こなコーヒー": "تَنْوَة",
 "こなミルク": "حَلِيب مُجَفَّف (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب / صِيغَة",
 "こにくらしい": "مُغِيظ, مُهَيِّج (يتسبّب في الغضب أو الاستياء أو يميل إلى ذلك) / حَبِيب, حَبِيبَة",
 "こにし": "كُزْبَرَة, قُسْبَرَة",
 "こにちは": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "こにちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "こにもつ": "رِزْمَة, رُزْمَة",
 "こぬかあめ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "こぬか雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "こぬすびと": "لص متسلل (لص يسرق دون استخدام العنف)",
 "こぬれ": "غُصَّيْن",
 "こねあわせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "こねかえす": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن.",
 "こねくりかえす": "عَبِثَ (لعب بما لا يعنيه؛ عَمَلَ بلا هدف أو فائدة)\nمثال: انه لهو عبث ان نناقش.",
 "こねくりまわす": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن.",
 "こねくり回す": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن.",
 "こねくり返す": "عَبِثَ (لعب بما لا يعنيه؛ عَمَلَ بلا هدف أو فائدة)\nمثال: انه لهو عبث ان نناقش.",
 "こねこ": "قُطَيْط, قُطَيْطَة / عَجِين, عَجِينَة",
 "こねばち": "مَاجُور",
 "こねまわす": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن.",
 "こねる": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن. / جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "こねーな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "こね回す": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن.",
 "こね粉": "عَجِين, عَجِينَة",
 "こね返す": "عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن.",
 "こね鉢": "مَاجُور",
 "この": "تِسْعَة, تسعة / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "このあいだ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "このあと": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "このいと": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "このうえ": "أَكْثَر / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "このうえとも": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "このうえない": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "このうえなく": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "このうえもなく": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "このうち": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "このうれ": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "このおやにしてこのこあり": "الْوَلَدُ سُرّ أَبِيهِ",
 "このかた": "مُنْذُ / لِأَنَّ",
 "このかみ": "اَلْأَخ اَلْأَكْبَر",
 "このかん": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "このきみ": "خَيْزَرَان, خَيْزُرَان",
 "このくれ": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "このけっか": "بِٱلتَّالِي, وَعَلَيْهِ فَإِنَّ",
 "このころ": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "このご": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "このごろ": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "このごろよう": "عَصْرِيّ, حَدِيث",
 "このさい": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "このさき": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "このじゅう": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "このせつ": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "このたび": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "このちちにしてこのこあり": "الْوَلَدُ سُرّ أَبِيهِ",
 "このつぎ": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "このつぎから": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "このところ": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "このなか": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "こののち": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "このは": "وَرَقَة, وَرَقة / صَحِيفَة",
 "このはどり": "طائر أزرق خرافى (طائر مغرد آكل للفاكهة ذو لون أزرق لامع غالباً من جزر الهند الشرقية)",
 "このはむし": "حشرة ورقية (حشرة استوائية لها جسم مفلطح يشبه الورقة؛ شائعة في جنوب آسيا وجزر الهند الشرقية)",
 "このひと": "هُوَ",
 "このほう": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "このほか": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "このほど": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "このまえ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "このましい": "حَسَّن, لَطِيف (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "このましからざる": "غَيْرُ مُرَحَّب بِه (غير مرحَّب به ولا مُتمنَّى) / غير مرحب به, غير مرغوب فيه (غير مرحب به؛ لا يعطي متعة أو لا يتم استقباله بمتعة)\nمثال: دعاية غير مرحب بها",
 "このましからざるじんぶつ": "شَخْص غَيْر مَرْغُوب فِيهِ (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "このまま": "كَمَا هُوَ, كَمَا هِيَ\nمثال: 私たちはこのままやっていくより仕方がない。 — ليس لدينا أي خيار آخر غير المواصلة.",
 "このまれる": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "このみ": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة / أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "このむ": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "このめ": "برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور))",
 "このもしい": "حَسَّن, لَطِيف (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "このゆえに": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "このよのものともおもえない": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / رُوحَانِيّ, رُوحِيّ (مُتَعَلِّقٌ بِالرُّوحِ أَوِ النَّفْسِ أَوْ مُؤَثِّرٌ فِيهِمَا)",
 "このよのものともおもえぬ": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / رُوحَانِيّ, رُوحِيّ (مُتَعَلِّقٌ بِالرُّوحِ أَوِ النَّفْسِ أَوْ مُؤَثِّرٌ فِيهِمَا)",
 "このよをさる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "このり": "بندقية قديمة, مسكيت (بندقية كتف تلقم من الفوهة ذات ماسورة طويلة؛ كان يستخدمها المشاة قديماً)",
 "この上": "أَكْثَر / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "この上とも": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "この上ない": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "この上なく": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "この上もなく": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "この上も無く": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "この上無く": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "この世のものとも思えない": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / رُوحَانِيّ, رُوحِيّ (مُتَعَلِّقٌ بِالرُّوحِ أَوِ النَّفْسِ أَوْ مُؤَثِّرٌ فِيهِمَا)",
 "この世のものとも思えぬ": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / رُوحَانِيّ, رُوحِيّ (مُتَعَلِّقٌ بِالرُّوحِ أَوِ النَّفْسِ أَوْ مُؤَثِّرٌ فِيهِمَا)",
 "この世の物とも思えない": "خَارِق, غَرِيب (يوحي بعمل قوى خارقة للطبيعة) / رُوحَانِيّ, رُوحِيّ (مُتَعَلِّقٌ بِالرُّوحِ أَوِ النَّفْسِ أَوْ مُؤَثِّرٌ فِيهِمَا)",
 "この世を去る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "この中": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "この人": "هُوَ",
 "この先": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "この前": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "この外": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "この度": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "この後": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "この所": "حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "この故に": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "この方": "مُنْذُ / لِأَنَّ / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "この期": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "この次": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "この次から": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "この父にしてこの子あり": "الْوَلَدُ سُرّ أَبِيهِ",
 "この程": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "この節": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "この結果": "بِٱلتَّالِي, وَعَلَيْهِ فَإِنَّ",
 "この親にしてこの子あり": "الْوَلَدُ سُرّ أَبِيهِ",
 "この間": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "この際": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "この頃": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "この頃様": "عَصْرِيّ, حَدِيث",
 "こはく": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "こはくいろ": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "こはくさん": "حمض السكسينيك, حمض الكهرمان (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "こはくちょう": "تم التندرا (بجعة تعشش في مناطق التندرا في العالم الجديد والقديم)",
 "こはぜ": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "こはだ": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "こはな": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "こはば": "صَغِير, صغير",
 "こはるびより": "صَيْف هِنْدِيّ (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "こはん": "شاطئ البحيرة (شاطئ بحيرة)",
 "こば": "شَظِيَّة",
 "こばい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "こばいけいそう": "خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)",
 "こばいしゃ": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "こばか": "مُغَفَّل, أَحْمَق",
 "こばかにする": "تَرَفَّعَ",
 "こばく": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / جَالِد, سَائِق (يَحُثُّ بِعُنْفٍ بِالسَّوْطِ أَوِ الجَلْد) / تحزيم, ربط (حبل يستخدم لربط شيء بشيء آخر)\nمثال: كانت القوارب مربوطة ببعضها البعض بالحبال",
 "こばこ": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى) / تابوت, نعش (صندوق يدفن فيه الميت أو يُحرق)",
 "こばしちどり": "زقزاق أوراسي (زقزاق نادر من المناطق المرتفعة في أوراسيا)",
 "こばしら": "عمود صغير, عُميد (عمود صغير (أو هيكل يشبه العمود) يمثل جزءاً من نبات أو حيوان)",
 "こばしり": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "こばち": "دبور كالسيد, ذبابة كالسيد (أي من الحشرات الدقيقة المتنوعة التي تتطفل يرقاتها على بيض ويرقات الحشرات الأخرى؛ والعديد منها مفيد في القضاء على الحشرات الضارة)",
 "こばと": "زُغْلُول, جَوْزَل",
 "こばな": "مَنْخَر",
 "こばなし": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "こばねう": "قَصِير الأَجْنِحَة ((عن بعض الحشرات خاصّة) ذو أجنحة قصيرة جدًّا أو أثريّة)",
 "こばむ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "こばら": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "こばん": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "こばんがた": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "こばんざめ": "ريمورا, سمكة مصاصة (أسماك بحرية ذات جسم ممدود مسطح وقرص ماص على الرأس للالتصاق بالأسماك الكبيرة أو الأجسام المتحركة) / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "こひざ": "رُكْبَة",
 "こひしつ": "قشرة عتيقة (القشرة الشمية للمخ)",
 "こひつじ": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ) / لَحْم اَلضَّأْن, خَرُوف (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: حمل سامي سلاحه.",
 "こひょう": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "こび": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "こびき": "خنفساء ناشرة (أي من الخنافس المتعددة التي تحفر يرقاتها ثقوباً في الأشجار الميتة أو المحتضرة وخاصة الصنوبريات) / نشّار (شخص يتم توظيفه لنشر الخشب)",
 "こびきだい": "حامل النشر (هيكل لحمل الخشب الذي يتم نشره)",
 "こびじゅつ": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "こびじゅつしょう": "أثري, جامع تحف (خبير أو جامع للآثار والتحف القديمة)",
 "こびじゅつひん": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "こびと": "قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ",
 "こびとしょう": "تقزم (خلل جيني يؤدي إلى قصر القامة)",
 "こびへつらう": "تَمَلَّقَ, تَبَصْبَصَ",
 "こびゃくしょう": "فَلَّاح, فَلَّاحَة",
 "こびょうりがく": "علم الأمراض القديمة (دراسة أمراض العصور السابقة (المستنتجة من الأدلة الأحفورية))",
 "こびる": "تَمَلَّقَ, تَبَصْبَصَ / غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "こびをうる": "رجل لعوب, متغزل (رجل مغر يستخدم جاذبيته لاستغلال النساء) / تَمَلَّقَ, تَبَصْبَصَ",
 "こぴっと": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "こふ": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "こふう": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "こふく": "سَعَادَة, فَرَح",
 "こふん": "برويطة, عربة يدوية بعجلة واحدة (عربة لحمل الأحمال الصغيرة؛ لها مقابض وعجلة واحدة أو أكثر) / تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ) / ملء عربة يدوية (الكمية التي تستوعبها العربة اليدوية)",
 "こぶ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع) / خبطة, ضربة (ارتطام (كما هو الحال في التصادم)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, ورم (كتلة في الجسم ناتجة عن ضربة)\nمثال: الخبطة ألقته عن الدراجة / عشب البحر, كيلب (أعشاب بحرية بنية كبيرة لها سعف جلدي متموج)",
 "こぶうし": "بقر الهند, زيبو (ثور مستأنس له سنام على الظهر وقرون طويلة ولبب كبير؛ يستخدم بشكل رئيسي كحيوان جر في الهند وشرق آسيا)",
 "こぶくろ": "رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه.",
 "こぶげきれい": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "こぶし": "قَبْضَة / سَامُورَاي / مُحَارِب قَدِيم",
 "こぶた": "خِنَّوْص",
 "こぶつ": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / فَرْد, شَخْص",
 "こぶとり": "سمين",
 "こぶね": "قارب صغير (قارب صغير الحجم)",
 "こぶはくちょう": "تَمّ أَخْرَس",
 "こぶら": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "こぶり": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما) / رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة\nمثال: 我々は雨が小降りになったとき出発した。 — سوف ننطلق عندما يخفّ هطول المطر.",
 "こぶん": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "こぶんがく": "عِلْم الكِتَابَات القَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こぶんしょ": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "こへい": "مُحَارِب قَدِيم",
 "こべつ": "فَرْد, شَخْص / مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "こべつか": "تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)",
 "こべつしどう": "تعليمي, دروس خصوصية (من أو متعلق بالمعلمين الخصوصيين أو التدريس الخصوصي) / حصة توجيهية, درس خصوصي (جلسة تعليم مكثف يقدمها معلم لفرد أو لعدد صغير من الطلاب)\nمثال: جلسات تعليمية",
 "こべつてき": "فَرْد, شَخْص",
 "こべつはんばい": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "こべつほうもん": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "こべや": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "こほこほ": "سعال, كحة (طرد مفاجئ ومزعج للهواء من الرئتين يطهر ممرات الهواء؛ عرض شائع لعدوى الجهاز التنفسي العلوي أو التهاب الشعب الهوائية أو الالتهاب الرئوي أو السل) / مُدَوٍّ, هَائِل (كبير أو مُثير للإعجاب بشكل استثنائيّ) / مُدَوٍّ, مُرْعِد (يُصْدِر صوتًا كالرعد)",
 "こほつ": "دَمَّرَ",
 "こほん": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "こぼうず": "شقي, عفريت (شخص مؤذٍ بمرح)",
 "こぼしばなし": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "こぼしや": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "こぼし屋": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "こぼし話": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "こぼす": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / قَمْقَمَ",
 "こぼつ": "دَمَّرَ",
 "こぼれ": "ثلم, حز (قطع صغير) / سجن ((عامية بريطانية) سجن) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))\nمثال: هو في السجن / دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / ذهاب, رحيل (فعل المغادرة)",
 "こぼれおちる": "نَثَرَ, تَفَرَّقَ",
 "こぼれざいわい": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / ثمرة ساقطة, سقط الشجر (الفاكهة التي سقطت من الشجرة)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "こぼれだす": "فَيَضَان / فَاضَ",
 "こぼれだね": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こぼれだま": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "こぼればなし": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "こぼれる": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "こぼれダネ": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こぼれ幸い": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / ثمرة ساقطة, سقط الشجر (الفاكهة التي سقطت من الشجرة)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "こぼれ球": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "こぼれ種": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こぼれ落ちる": "نَثَرَ, تَفَرَّقَ",
 "こぼれ話": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "こぼんのう": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "こぽこぽ": "غَرْغَرَ, بَقْبَقَ",
 "こま": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / دُوَّامَة, بُلْبُل / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / مَنْظَر, مَشْهَد / مَشْهَد / كُورِيّ",
 "こまあみ": "غرزة حشو, غرزة كروشيه مفردة (غرزة الكروشيه الأساسية)",
 "こまい": "شريحة خشبية (شريط رفيع ضيق من الخشب يستخدم كدعم للجص أو لعمل الشبكات الخشبية) / صَغِير, صغير / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "こまおち": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "こまか": "صَغِير, صغير",
 "こまかい": "صَغِير, صغير / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "こまかいおかね": "فُرَاطَة",
 "こまかいかね": "فُرَاطَة",
 "こまかいこと": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "こまかく": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "こまがた": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع)",
 "こまぎれ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "こまく": "طَبْلَة اَلْأُذْن",
 "こまくえん": "التهاب الأذن الداخلية, التهاب الطبلة (التهاب الأذن الداخلية)",
 "こまごま": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "こまごましい": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة. / مُزْعِج / مُفَصَّل",
 "こまごました": "مُخْتَلِف, مُتَنَوَّع",
 "こまごまとした": "مُخْتَلِف, مُتَنَوَّع",
 "こまざ": "مهر (ذكر حصان صغير يقل عمره عن أربع سنوات) / مسدس كولت (نوع من المسدسات الدوارة)",
 "こます": "أَغْرَى, أَغْوَى / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "こまた": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "こまち": "حسناء (شابة هي الأكثر سحراً وجمالاً بين عدة منافسات)\nمثال: كانت حسناء الحفل",
 "こまちむすめ": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "こまっこう": "حوت العنبر القزم (حوت عنبر صغير يعيش في المياه الدافئة لكلا ساحلي أمريكا الشمالية)",
 "こまった": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / صعب المراس, مستعصٍ (يصعب التحكم فيه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه) / ثقيل, صعب الاستخدام (صعب الاستخدام أو التعامل معه أو إدارته بسبب الحجم أو الوزن أو الشكل)\nمثال: طفل صعب المراس / غير مناسب, في غير وقته (غير مناسب من حيث التوقيت)\nمثال: وصل في ساعة غير مناسبة للغاية / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب)",
 "こまったこと": "مُشْكِلَة, مَتاعِب",
 "こまったことに": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "こまったちゃん": "إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة)\nمثال: إزعاج بسيط",
 "こまったひと": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "こまった事": "مُشْكِلَة, مَتاعِب",
 "こまった人": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "こまつぐみ": "أبو الحناء الأمريكي (سمنة أمريكية كبيرة ذات صدر وبطن أحمر صدئ)",
 "こまづかい": "خَادِمَة, خَدامَة",
 "こまど": "قمرية, نافذة هلالية (فتحة بيضاوية أو دائرية؛ للسماح بدخول الضوء إلى قبة أو قبو)",
 "こまむすび": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "こまめ": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "こまもの": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "こまものや": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال) / خردوات, مستلزمات ملابس رجالية (السلع الجافة (كالملابس الرجالية أو أدوات الخياطة) التي يبيعها الخردواتي)",
 "こまものやをひらく": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "こまやか": "طَرِيّ, غَضّ ((عَنِ النَّبَاتَاتِ) غَيْرُ مُقَاوِم؛ يَسْهُلُ أَنْ يَمُوتَ بِظُرُوفِ النُّمُوِّ السَّيِّئَة) / حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما) / طَرِيّ, غَضّ (صغير السنّ وغير ناضج) / حَسَّاس, مُؤْلِم (يُؤْلِمُ عِنْدَ اللَّمْس) / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل) / عَمِيق, غَوِيط",
 "こまゆみ": "شجرة المغزل, غدب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "こまらせる": "أَخْجَلَ (أَخْجَلَ (النباتُ): خَجِلَ؛ أَخْجَلَ (فلانًا): جعله يخجل)\nمثال: أخجل من تصرف ولدي.",
 "こまりごと": "تَمْرِين / مَسْأَلَة",
 "こまりもの": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له) / إِزْعَاج",
 "こまわり": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "こま切れ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "こま結び": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "こみ": "كُومِي",
 "こみあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "こみあげる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "こみいった": "دَقِيق, مُتْقَن (ذُو عَنَاصِرَ كَثِيرَة مُرَتَّبَة بِشَكْل مُعَقَّد؛ مُفَصَّل)",
 "こみこみ": "شَامِل كُلّ شَيْء / مُزْدَحِم",
 "こみだし": "عنوان فرعي (عنوان لقسم فرعي من نص) / مدخل فرعي (مدخل، مثل مدخل في حساب أو مرجع، يتم تضمينه ضمن مدخل رئيسي)\nمثال: يتم إعطاء الجذر الأوسط لمعظم الأفعال المتعدية كمدخل فرعي (بخط مائل) تحت مدخل الفعل المتعدي (بخط غامق) / كُومِي",
 "こみち": "طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "こみみずく": "قَصِيرُ الأُذُنَيْن (له أذنان قصيرتان)",
 "こみら": "ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "こみ上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "こみ上げる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "こみ入った": "دَقِيق, مُتْقَن (ذُو عَنَاصِرَ كَثِيرَة مُرَتَّبَة بِشَكْل مُعَقَّد؛ مُفَصَّل)",
 "こむ": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "こむぎ": "قَمْح, حِنْطَة",
 "こむぎいろ": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "こむぎこ": "دقيق القمح, طحين القمح (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "こむぎはいが": "جنين القمح (جنين حبة القمح؛ يُزال قبل الطحن ويؤكل كمصدر للفيتامينات)",
 "こむぎばたけ": "حقل قمح (حقل مزروع بالقمح)",
 "こむぎグルテン": "غلوتين القمح (غلوتين محضر من القمح)",
 "こむし": "هاموش (ذبابة دقيقة ذات جناحين تشبه البعوض تفتقر إلى أجزاء الفم القارضة؛ تظهر في أسراب راقصة خاصة بالقرب من الماء)",
 "こむすめ": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "こむずかしい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "こむつかしい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "こむら": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد) / عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري. / هَامْلِت",
 "こむろ": "صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ / هَالَة",
 "こめ": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز / أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / سلع أساسية (سلعة ضرورية يكون الطلب عليها ثابتاً) / دبوس دباسة / مسمار مشبك (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم) / تَعْلِيق, مَلْحُوظَة / عَلَّقَ / إِلَى أَقْصَى حَدٍّ, اَلنُّونِيّ (الأخير أو الأعظم في سلسلة كبيرة غير محددة)",
 "こめかみ": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "こめくいどり": "ممراح",
 "こめくいむし": "سوسة الأرز (سوسة بنية تغزو الحبوب المخزنة وخاصة الأرز) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "こめこ": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "こめつきばった": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "こめつきむし": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "こめねずみ": "جرذ الأرز (جرذ رشيق قوي التحمل يعيش في المستنقعات العشبية في المكسيك وجنوب شرق الولايات المتحدة)",
 "こめびつ": "مُعِيل, عَائِل",
 "こめもの": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء / أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية.",
 "こめる": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / تضمن / كفن",
 "こも": "سَائِل / فَقِير",
 "こもう": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "こもかぶり": "سَائِل / فَقِير",
 "こもごも": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "こもじ": "حرف صغير (الأحرف التي كانت تُحفظ سابقاً في النصف السفلي من صندوق حروف الطباعة) / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / طَحِين, دَقِيق",
 "こもち": "أبوة أو أمومة, والدية (حالة كونه والداً)\nمثال: لمفاجأة الجميع، أصلحت الأبوة الرجل",
 "こもちかんらん": "كُرُنْب بْرُوكْسِل",
 "こもの": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري. / صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / خَادِم, خَادِمَة",
 "こもり": "مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل)",
 "こもりうた": "تَهْوِيدَة",
 "こもりがえる": "علجوم سورينام (علجوم من أمريكا الجنوبية؛ يحضن صغاره في حفر في جلد ظهره)",
 "こもりぐま": "كُوَالَا",
 "こもりぐも": "عَنْكَبُوت ذِئْبِيّ",
 "こもりざめ": "قرش حاضن (قرش صغير يعيش في القاع في المياه الضحلة الدافئة على كلا ساحلي أمريكا الشمالية والجنوبية ومن جنوب شرق آسيا إلى أستراليا)",
 "こもる": "مَسَكَ, مسك",
 "こもん": "مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم / باب صغير, بويب (بوابة أو باب صغير (خاصة الذي يكون جزءاً من باب أكبر)) / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "こもんかん": "عُضْو مَجْلِس, مُسْتَشار (عضو في مجلس (بلدي أو إداري))",
 "こもんじょ": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "こもんじょがく": "علم الوثائق (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こもんだん": "خَلِيَّة تَفْكِير",
 "こや": "كُوخ, تَخْشِيبَة / خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "こやうら": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل غالبا ما يكون سقفها منخفضا وتشرف على السَطْح)\nمثال: عادوا إلى العلية.",
 "こやかましい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "こやぎ": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "こやし": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "こやす": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "こやすがい": "ودع",
 "こやつ": "هُوَ / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "こやね": "بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه)",
 "こやま": "تَلّ, أَكَمَة (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: لقد تسلقت تل طويل",
 "こやみ": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "こゆ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "こゆい": "عَمِيق, غَوِيط / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / سَمِيك, غَلِيظ / غَلِيظ",
 "こゆう": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "こゆうじゅよう": "إدراك الوضعية, استقبال الحس العميق (القدرة على استشعار موضع ومكان واتجاه وحركة الجسم وأجزائه)",
 "こゆうち": "قيمة ذاتية, قيمة مميزة ((رياضيات) أي عدد بحيث أن مصفوفة مربعة معينة مطروحًا منها ذلك العدد مضروبًا في مصفوفة الوحدة يكون لها محدد صفري)",
 "こゆうひょうげん": "الشَّمَال الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الشمال والشرق؛ عند 45 درجة) / نيون (عنصر غازي عديم اللون والرائحة يعطي توهجاً أحمر في أنبوب التفريغ؛ أحد الغازات الخاملة الستة)",
 "こゆうめいし": "عَلَم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "こゆうめいしがく": "علم الأسماء (فرع علم المعجم الذي يدرس أشكال وأصول الأسماء العلم)",
 "こゆび": "خِنْصِر\nمثال: 小指がはれました。 — اصبعي الصغير متورم / خنصر القدم (الإصبع الخامس الأصغر والأكثر تطرفاً في القدم)",
 "こよい": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "こよう": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟ / تبول (إخراج البول)",
 "こようかのうじんこう": "قُوَّة عَمَل (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "こようしゃ": "مُوَظَّف, مُوَظَّفَة / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "こようじ": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "こようたい": "محلول جامد, محلول صلب (مادة صلبة متجانسة يمكن أن توجد عبر نطاق من المكونات الكيميائية؛ مكون من السبائك يتشكل عندما تندمج ذرات عنصر في بلورات معدن)",
 "こようとうけつ": "تجميد التوظيف (تجميد عمليات التوظيف الجديدة)",
 "こようぬし": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "こよない": "أَفْضَل",
 "こよなく": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "こよなし": "أَفْضَل",
 "こよみ": "تَقْوِيم",
 "こらえしょう": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "こらえる": "دُبّ / دُبَّة / اِحْتَمَلَ / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / سَامَحَ / غَفَرَ",
 "こらえ性": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "こらしめ": "تأنيب, توبيخ (عقاب لفظي) / تَأْدِيب, تَقْوِيم (توبيخ لارتكاب خطأ)",
 "こらしめる": "عَاقَبَ, قَاصَصَ",
 "こらす": "رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري. / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ) / عَاقَبَ, قَاصَصَ",
 "こらふ": "جَزَر, جزر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "こり": "غَشَّاش, خَدَّاع / بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بالة, حزمة كبيرة (حزمة كبيرة مربوطة للتخزين أو النقل)",
 "こりかたまり": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "こりかたまる": "تَجَلَّطَ, تَخَثَّرَ / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "こりくつ": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "こりこう": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "こりこり": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ) / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب",
 "こりごり": "اِكتَفَى, مُكتَفٍ",
 "こりしょう": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "こりつ": "تَوَحُّد",
 "こりつか": "تَوَحُّد",
 "こりつかん": "تَوَحُّد",
 "こりつがいねん": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "こりつしゅぎ": "اِنْعِزَالِيَّة",
 "こりない": "مُتَعَنِّت, عَنِيد",
 "こりや": "كَمَالِيّ",
 "こりゅう": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "こりょ": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة. / أَجْنَبِيّ, أَجْنَبِيَّة",
 "こりょうりや": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "こりようかい": "المخادع (كائن خارق للطبيعة مؤذٍ موجود في فلكلور العديد من الشعوب البدائية؛ يتميز أحياناً بدوافع بيولوجية هائلة وأجزاء جسدية مبالغ فيها) / غشاش, محتال (شخص يجعلك تعتقد شيئاً غير حقيقي) / صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "こる": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "これ": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / يَاه, اسمع / هَلَا",
 "これい": "تَقْلِيد",
 "これいじょう": "بعد الآن, مرة أخرى (في الوقت الحاضر أو من الآن فصاعداً؛ تستخدم عادة مع النفي)\nمثال: أليس لا تعيش هنا بعد الآن",
 "これから": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "これからさき": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "これから先": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "これきり": "أبداً, ليس بعد الآن (في أي وقت فيما بعد)\nمثال: قال الغراب: أبداً!",
 "これぎり": "أبداً, ليس بعد الآن (في أي وقت فيما بعد)\nمثال: قال الغراب: أبداً!",
 "これこそ": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "これしき": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "これしゃ": "مُقَامِر / مُغَامِر",
 "これぞ": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "これっきり": "أبداً, ليس بعد الآن (في أي وقت فيما بعد)\nمثال: قال الغراب: أبداً!",
 "これっばかり": "أبداً",
 "これで": "إِلَى هُنَا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "これでもかというほど": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "これでもかという程": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "これでもかとゆうほど": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "これでもかと言うほど": "إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "これという": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "これといった": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "これと言う": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "これと言った": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "これなら": "هٰذَا",
 "これにより": "بِمُوجِب هَذَا ((رسمي) بواسطة هذا)\nمثال: أعلنكما الآن زوجاً وزوجة",
 "これはと": "بشكل لافت (بطريقة مدهشة أو لافتة)\nمثال: تم إثبات ذلك بشكل لافت",
 "こればかり": "أبداً",
 "これほど": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "これまた": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "これまで": "حَتَّى الْآنَ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "これまでで": "حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "これまでに": "حَتَّى الْآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "これみよがし": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "これもの": "يَاكُوزَا / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "これもん": "يَاكُوزَا / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "これより": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "これよりさき": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / سابقاً, في وقت سابق (في وقت أبكر؛ سابقاً) / أصلاً, في المقام الأول (قبل الآن) / فِي وَقْت أَبْكَر (صيغ مقارنة لـ 'قريباً' أو 'مبكراً') / أَبْكَر, أَسْبَق ((صيغة تفضيل لـ 'مُبَكِّر') أكثر أو أشدّ تبكيراً)\nمثال: كنت أعرفها من قبل",
 "これより先": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / سابقاً, في وقت سابق (في وقت أبكر؛ سابقاً) / أصلاً, في المقام الأول (قبل الآن) / فِي وَقْت أَبْكَر (صيغ مقارنة لـ 'قريباً' أو 'مبكراً') / أَبْكَر, أَسْبَق ((صيغة تفضيل لـ 'مُبَكِّر') أكثر أو أشدّ تبكيراً)\nمثال: كنت أعرفها من قبل",
 "これら": "هٰذِهِ, هٰؤُلَاءِ",
 "これ以上": "بعد الآن, مرة أخرى (في الوقت الحاضر أو من الآن فصاعداً؛ تستخدم عادة مع النفي)\nمثال: أليس لا تعيش هنا بعد الآن",
 "これ程": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "これ等": "هٰذِهِ, هٰؤُلَاءِ",
 "これ見よがし": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "ころ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول / دُبَّاء / كرة متدحرجة (كرة أرضية تتدحرج على طول الملعب الداخلي) / حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض) / شقراق (طائر من العالم القديم يتقلب أو يتدحرج في الطيران؛ مرتبط بالرفراف) / لفافة شعر, مجعد شعر (جهاز ميكانيكي يتكون من أنبوب أسطواني يُلف حوله الشعر لتجعيده)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً",
 "ころあい": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة / أدب, صواب (السلوك الصحيح أو المناسب)",
 "ころう": "عجوز, كبير السن (شخص متقدم في السن) / انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "ころうがんめい": "مُتَعَنِّت, عَنِيد",
 "ころおい": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "ころがし": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة",
 "ころがす": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / قَلَبَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ころがりこむ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "ころがりでる": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "ころがる": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "ころく": "جَعْبَة",
 "ころげる": "سقطة, وقعة (سقوط مفاجئ من وضعية الوقوف) / دحرجة, شقلبة (حركة بهلوانية تتضمن التدحرج أو الدوران)\nمثال: تعرض لسقطة سيئة على الجليد",
 "ころころ": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال. / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / وَاحِدًا تِلْوَ الآخَرِ",
 "ころし": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ころしもんく": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "ころしや": "قاتل مأجور, مسلح (قاتل محترف ذكر يستخدم مسدساً)",
 "ころじくうけ": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "ころす": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / طَابُوقَة / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية) / أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "ころっと": "بِسُهُولَة / فَجْأَةً / تَمَامًا / غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات)",
 "ころばす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "ころばぬさきのつえ": "اَلْوِقَايَةُ خَيْرٌ مِنَ الْعِلَاجِ",
 "ころび": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / منخفض, هابط (يصبح أقل أو أصغر في الدرجة أو القيمة) / مُتَرَاجِع, هَابِط (يتناقص في الكمّيّة أو الدرجة)\nمثال: سوق هابطة / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / رِدَّة, اِرْتِدَاد / عجين سائل (خليط سائل أو شبه سائل، مثل الدقيق والبيض والحليب، يستخدم في الطهي) / ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب)",
 "ころびね": "غفوة, نعاس (نوم خفيف متقطع)",
 "ころぶ": "اِرْتَدَّ (عن كذا: رجع عنه مردودا؛ عن الاسلام: رجع إلى الكفر بعد أن أسلم)\nمثال: ارتد سترة، فالجو بارد. / دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "ころも": "مَلَابِس, ثِيَاب / رِدَاء (ما يُلبَس فوق الثياب كالجُبَّة والعَبَاءَة؛ الثوب يستر الجزء الأعلى من الجسم فوق الإِزَار)\nمثال: تبدو جميلة في هذا الرداء. / تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "ころもがえ": "تَجْدِيد, إِحْيَاء",
 "ころもじらみ": "قملة الجسم (قملة طفيلية تغزو جسم البشر)",
 "ころもで": "كُمّ, رُدْن",
 "ころり": "بِسُهُولَة",
 "ころんころん": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال. / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / وَاحِدًا تِلْوَ الآخَرِ",
 "ころ軸受": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "ころ軸受け": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "こわ": "مُجَفِّل, مُخِيف",
 "こわい": "مُجَفِّل / مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / صلب, غير مرن (مقاوم للانحناء) / صارم, غير مرن (غير قابل للتغيير) / صارم, لا هوادة فيه (لا يقدم تنازلات) / جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)\nمثال: قضيب حديدي غير مرن / مُتْعَب, تَعْبَان",
 "こわいけん": "اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "こわいものしらず": "طَائِش, مُتَهَوِّر (يتسم بتجاهل متحدٍّ للخطر أو العواقب)",
 "こわいろ": "نبرة, نبرة الصوت (جودة صوت الشخص)\nمثال: بدأ بنبرة حوارية / مُشَاكهَة",
 "こわがり": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こわがる": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "こわき": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده)",
 "こわく": "انْبِهَار, سِحْر (القدرة على جذب اهتمام شديد) / افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / افتتان, انبهار (حالة الاهتمام الشديد بشيء ما (كما في الرهبة أو الإعجاب أو الرعب))\nمثال: سحر الأطفال بحيل سحرية وفتن أخرى",
 "こわくてき": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا) / آسِر, شَائِق (قادر على جذب الانتباه والاستحواذ عليه)",
 "こわけ": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً) / شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل) / جزء, فرع (جزء قائم بذاته من عمل أكبر (مكتوب أو موسيقي)) / شُعبة, فرع (قسم من منظمة أكبر أو أكثر تعقيدًا)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "こわごわ": "بخوف (مع شعور بالخوف) / برعب, بشكل مخيف (بطريقة مثيرة للقلق)\nمثال: هرعت أسفل الدرج بخوف",
 "こわしや": "مُدَمِّر",
 "こわす": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / تَصَادُّم",
 "こわだか": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "こわっぱ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "こわね": "نبرة, نبرة الصوت (جودة صوت الشخص)\nمثال: بدأ بنبرة حوارية",
 "こわばり": "شدة, صرامة (صرامة مفرطة) / ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / جمود, صلابة (حزم ثابت في الغرض أو الرأي أو العمل) / تشنج, تصلب (خاصية التحرك بألم أو صعوبة)\nمثال: صرامة الشخصية",
 "こわばる": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "こわもてだんぱん": "حَازِم, مُتَشَدِّد (صَارِمٌ وَلَا يَقْبَلُ التَّسْوِيَةَ)",
 "こわらべ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "こわらわ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "こわれもの": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف) / قابل للكسر (صنف هش وسهل الكسر)\nمثال: الفخار الخزفي قابل للكسر",
 "こわれやすい": "هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت)",
 "こわれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "こん": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / كُحْلِيّ / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / مُثَابَرَة / جَذْريّ / رَادِيكَالِيّ / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت / عواء حاد, نباح حاد (صيحة حادة عالية النبرة (خاصة من قبل كلب)) / اِحْتِقَان / نَدْبَة, نَدْب / زَوَاج, نِكَاح / زَوَاج / عُرْس, زِفَاف / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "こんい": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة. / إِحْسَان",
 "こんいになる": "تَعَرَّفَ",
 "こんいろ": "كُحْلِيّ",
 "こんいん": "زَوَاج, نِكَاح / زَوَاج / عُرْس, زِفَاف",
 "こんいんかんけい": "عَلَاقَة زَوْجِيَّة (العلاقة بين الزوجة والزوج)",
 "こんおん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "こんかい": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "こんかく": "صيد جانبي, صيد عرضي (كائنات بحرية غير مرغوب فيها يتم صيدها في الشباك أثناء صيد أنواع أخرى)\nمثال: تقتل الآلاف من الدلافين وخنازير البحر والحيتان كجزء من الصيد العرضي كل عام",
 "こんかん": "إكليل (الحافة الواقعة بين جلد الرسغ وقرن الحافر) / إكليل, تاج صغير (تاج صغير؛ يشير عادة إلى رتبة عالية ولكن أقل من رتبة السيادة) / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / قلنسوة الجذر (كتلة من الخلايا على شكل قمع تغطي وتحمي الطرف النامي للجذر) / قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "こんが": "برعم مختلط (برعم ينتج أوراقًا وزهورًا معًا)",
 "こんがい": "خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج)",
 "こんがいこうしょう": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "こんがいし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "こんがいせいこう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "こんがり": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "こんがん": "مُرَافَعَة",
 "こんき": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / جَذْريّ / رَادِيكَالِيّ",
 "こんきづよい": "دَؤُوب, مُثَابِر (يُوَاظِبُ بِهُدُوءٍ وَثَبَاتٍ خَاصَّةً فِي التَّفَاصِيلِ وَالدِّقَّة)",
 "こんきゃく": "ارتباك, حيرة (مشكلة أو ارتباك ناتج عن التعقيد)",
 "こんきゅう": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "こんきゅうしゃ": "فَقِير / مِسْكِين / فُقَرَاء",
 "こんきょ": "قَاعِدَة, أَسَاس / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "こんきょち": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "こんきょのない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "こんきょはくじゃく": "غَيْر مُؤَيَّد بِأَدِلَّة, غَيْر مُوَثَّق (غير مدعوم بأدلة أخرى)",
 "こんきよく": "بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل",
 "こんぎ": "زفاف, عقد قران (الحدث الاجتماعي الذي تُجرى فيه مراسم الزواج)",
 "こんぎょう": "هٰذَا الصَّبَاح",
 "こんく": "حرمان (فعل حرمان شخص ما من الطعام أو المال أو الحقوق) / حرمان, عوز (حالة من الفقر المدقع)",
 "こんくらべ": "ماراثون, مسابقة التحمل (أي مشروع طويل وشاق)",
 "こんけい": "جذمور (ساق نبات أفقية ذات براعم فوق وجذور تحت تعمل كهيكل تكاثري)",
 "こんけつじん": "مُوَلَّد, مِسْتِيزُو (شخص من أصل عرقي مختلط (خاصة من أصل أوروبي وأمريكي أصلي مختلط))",
 "こんげん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "こんげんてき": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)",
 "こんこう": "خَلِيط / تَلْوِيث, تَلَوُّث / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "こんこつ": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "こんこん": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء / بثقل, بشكل كبير (بدرجة كبيرة) / بإفراط, بشراهة (الانغماس بإفراط) / بثقل, بصعوبة (بطريقة مجهدة) / بثقل (ببطء كما لو كان مثقلاً بوزن كبير)\nمثال: اعتمد بشكل كبير على بيانات الآخرين / ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب. / بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة / جَدِّي, جَادّ / عَرْبُون",
 "こんこんちき": "شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "こんご": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こんごう": "فاجرا (صاعقة إندرا) / صَاعِقَة / علامة الجذر (علامة تشير إلى استخراج الجذر) / خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / تَمَازُج الأَجْنَاسِ / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "こんごういんこ": "مكاو (ببغاء طويل الذيل زاهي الألوان من أمريكا الوسطى وأمريكا الجنوبية؛ من بين أكبر الببغاوات وأكثرها بهرجة)",
 "こんごうかやく": "خليط متفجر (خليط كيميائي له خصائص انفجارية)",
 "こんごうき": "خَلَّاط, خَفَّاقَة",
 "こんごうけいざい": "اقتصاد مختلط (نظام اقتصادي يجمع بين المؤسسات الخاصة والحكومية)",
 "こんごうけんご": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "こんごうご": "رطانة, لغة بدجنية (لغة مصطنعة تستخدم للتجارة بين متحدثي لغات مختلفة)",
 "こんごうしゃ": "سُنْبَاذَج",
 "こんごうしゅ": "كُوكْتَيْل, كُوكْتِيل",
 "こんごうしょ": "فاجرا (صاعقة إندرا)",
 "こんごうせき": "مَاس, أَلْمَاسَة / اَلدِّينَارِيّ",
 "こんごうたい": "خَلِيط",
 "こんごうのうぎょう": "زراعة مختلطة (زراعة المحاصيل والأعلاف والماشية كلها في نفس المزرعة)",
 "こんごうひりょう": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "こんごうふえ": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "こんごうぶつ": "خَلِيط",
 "こんごうやく": "علاج مضاد للفيروسات القهقرية عالي النشاط, كوكتيل دوائي (مزيج من مثبطات البروتياز تؤخذ مع مثبطات المنتسخة العكسية؛ يستخدم في علاج الإيدز وفيروس نقص المناعة البشرية)",
 "こんごとも": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "こんさい": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين / خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "こんさいるい": "محصول جذري (محصول يزرع لجذوره المتضخمة: مثل البنجر والبطاطس واللفت)",
 "こんざい": "خَلِيط",
 "こんざつ": "اِحْتِقَان / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "こんし": "صَدَاق",
 "こんしき": "عُرْس, زِفَاف",
 "こんしゅつよう": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "こんしろう": "قُنْصُل",
 "こんしん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة. / تشويش, تشويش إلكتروني (إشعاع أو عكس متعمد للطاقة الكهرومغناطيسية لغرض تعطيل استخدام العدو للأجهزة أو الأنظمة الإلكترونية)",
 "こんしんかい": "حدث اجتماعي, حفل (تجمع اجتماعي رسمي أو احتفال للناس)\nمثال: كانت الحفلة حدثاً مهماً حقاً",
 "こんじ": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "こんじき": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبِي\nمثال: ذهب إلى الدكان.",
 "こんじつ": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار",
 "こんじょう": "حب المساعدة, طيبة (ود يتضح من خلال طبع طيب ومحب للمساعدة) / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / أزرق بروسي (لون أزرق مخضر داكن) / أزرق بروسي, أزرق حديدي (أي من الأصباغ الزرقاء المختلفة)",
 "こんじょういろ": "أزرق بروسي (لون أزرق مخضر داكن) / أزرق بروسي, أزرق حديدي (أي من الأصباغ الزرقاء المختلفة)",
 "こんじょうなし": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "こんじょうのすわった": "جريء, جريئة",
 "こんじょうまがり": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "こんじょうやき": "حرق سيجارة (أثر حرق تركته سيجارة مشتعلة)\nمثال: حرق سيجارة على حافة الطاولة",
 "こんじょうわる": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "こんすい": "غَيْبُوبَة / نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "こんせい": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / مُخْتَلِط / مُتَزَامِن الوُجُود, مُتَعَايِش (موجود في نفس الوقت)",
 "こんせいきょく": "مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة)",
 "こんせいご": "رطانة, لغة بدجنية (لغة مصطنعة تستخدم للتجارة بين متحدثي لغات مختلفة) / لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "こんせいぶつ": "خَلِيط",
 "こんせいよう": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "こんせき": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر. / الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "こんせつ": "مراعٍ, مهتم بالآخرين (يظهر اهتماماً بحقوق ومشاعر الآخرين)\nمثال: أصدقاء مراعون بما يكفي ليتركونا وحدنا / الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "こんせん": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / تداخل الإشارات (وجود إشارة غير مرغوب فيها عبر اقتران عرضي) / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "こんぜつ": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "こんぜん": "كَامِل / كُلّ / ما قبل الزواج (يتعلق بالأحداث التي تسبق الزواج)\nمثال: اتفاق ما قبل الزواج",
 "こんぜんけいやく": "اتفاق ما قبل الزواج (عقد يُبرم قبل الزواج أو الاتحاد المدني)",
 "こんぜんけいやくしょ": "اتفاق ما قبل الزواج (عقد يُبرم قبل الزواج أو الاتحاد المدني)",
 "こんた": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "こんたん": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)",
 "こんだく": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "こんだくえき": "مُسْتَحْلَب",
 "こんだて": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "こんだてひょう": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة",
 "こんだんかい": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / حلقة نقاش, ندوة (خطاب في اجتماع أكاديمي أو ندوة) / حَلَقَة نِقَاشِيَّة, مُؤْتَمَر عِلْمِيّ (اجتماع أكاديمي أو ندوة يقودها عادة محاضر مختلف وتتناول موضوعاً مختلفاً في كل اجتماع)",
 "こんち": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار"
}
