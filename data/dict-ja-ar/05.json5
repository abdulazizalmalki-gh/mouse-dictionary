 "せいじんだんし": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "せいじんだんせい": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "せいじんねんれい": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "せいじんむけ": "بَالِغ, رَاشِد",
 "せいす": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "せいすい": "أَنَاقَة",
 "せいすう": "عَدَد صَحِيح (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "せいする": "لِجَام, صُرْع / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "せいず": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "せいずい": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "せいせい": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "せいせいき": "مُوَلِّد / مُوَلِّد كَهْرَبَائِيّ",
 "せいせいきそく": "إِنْتَاج",
 "せいせいじょ": "مِصْفَاة",
 "せいせき": "تَسَبَّب / نَتِيجَة",
 "せいせきひょう": "التقرير المدرسي عن الطالب",
 "せいせつ": "مُمَاسّ",
 "せいせん": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "せいせんてきじょ": "إِخْصَاء",
 "せいぜい": "على أفضل تقدير (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "せいぜつ": "عَنِيف",
 "せいぜん": "عَادِيّ / مُنْتَظِمٌ",
 "せいそ": "مُنَظَّم, نَظِيف",
 "せいそう": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "せいそういん": "مُنَظِّف / مُنَظِّفَة",
 "せいそうけん": "سْتْرَاتُوسْفِير",
 "せいそうさぎょういん": "جَامِع الْمُخَلَّفَات, جَامِعَة الْمُخَلَّفَات (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "せいそうじょうたい": "بَرْبَخ",
 "せいそく": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك. / عَكُوْسَة",
 "せいそくかんきょう": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "せいそくち": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "せいぞう": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "せいぞうき": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞうぎょうしゃ": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞうしゃ": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞうしょ": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうじょ": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうじょう": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうば": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうぶつ": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "せいぞうもと": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞく": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せいぞろい": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "せいぞん": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "せいたい": "كَائِن حَيّ",
 "せいたいかんきょう": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいたいがく": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいたいけい": "نِظَام بِيئِي (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "せいたいてき": "بِيئِيّ, إِيكُولُوجِيّ",
 "せいたいはいりょう": "تَنَاوُل (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه) / أَفْخَارِسْتِيَا\nمثال: تناول سامي سما.",
 "せいたかしぎ": "كُرْسُوع, أَبُو الْمَغَازِل",
 "せいたく": "مَذْبَح, هَيْكَل",
 "せいたけ": "اِرْتِفَاع",
 "せいたん": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "せいたんさい": "الْكْرِيسْمَاس, الْمِيلَاد",
 "せいだい": "إِنْصَاف (أخْذُ نِصْف الشيء أو وصول النصف؛ العَدْل والتَقْسِيم بالتساوي بدون أن يظلم أي من الطرفين)",
 "せいだいきんようび": "الْجُمْعَة الْعَظِيمَة, جُمْعَة الْآلَام",
 "せいだん": "مَذْبَح, هَيْكَل",
 "せいち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "せいちか": "تَكْرِير",
 "せいちゅう": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / نَزَاهَة, حِيَاد",
 "せいちょう": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "せいつうしゃ": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "せいてい": "تَأْسِيس / مُؤَسَّسَة",
 "せいてき": "جِنْسِيّ (المنسوب إلى الجِنْس؛ في : علاقة قانونية تربط فردا معينا بدولة معينة، قد تكون أصيلة أو مكتسبة)\nمثال: تعرض للتحرش الجنسي.",
 "せいてきいたずら": "إِسَاءَة جِنْسِيَّة",
 "せいてきいやがらせ": "تَحَرُّش جِنْسِيّ",
 "せいてきぎゃくたい": "إِسَاءَة جِنْسِيَّة",
 "せいてきしこう": "تَوَجُّه جِنْسِيّ, مَيْل جِنْسِيّ (فعل مطاوعة لوَجَّهَ؛ وجهته فتوجه؛ نحو كذا: أدار وجهه نحوه)\nمثال: توجه فاضل جنوبا.",
 "せいてきしょうどう": "غَرِيزَة جِنْسِيَّة",
 "せいてきとうさく": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "せいてきどれい": "الاستعباد الجنسي",
 "せいてきひがい": "إِسَاءَة جِنْسِيَّة",
 "せいてきふのう": "عَنَانَة, عُنَّة",
 "せいてきぼうこう": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "せいてきみりょく": "اِنْجِذَاب جِنْسِيّ, جَاذِبِيَّة جِنْسِيَّة",
 "せいてきよくぼう": "شَهْوَة",
 "せいてはことを": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せいてはことをしそんじる": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せいてはことをしそんずる": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せいてんかんしゃ": "مُتَحَوِّل جِنْسِيّ, مُتَحَوِّلَة جِنْسِيَّة",
