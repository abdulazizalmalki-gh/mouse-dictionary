 "四顧": "جِوَار, قُرْب / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جِوَار\nمثال: ينبح كلب في الحي.",
 "四駆": "اَلدَّفْع اَلرَّبَاعِيّ",
 "回": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / شوط ((بيسبول) واحد من تسعة أقسام للعب يكون لكل فريق خلالها دور في الضرب) / حَادِثَة, وَاقِعَة / حَلْقَة, حَلَقَة / هُوَي",
 "回々教": "الْإِسْلَام",
 "回し": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد. / وِشَاح / اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "回し引き鋸": "منشار ترددي, منشار صابر (منشار آلي محمول بشفرة ترددية؛ يمكن استخدامه مع مجموعة متنوعة من الشفرات حسب التطبيق ونوع القطع؛ يحتوي عموماً على لوحة تركب على السطح الذي يتم قطعه)",
 "回し文": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "回し者": "جَاسُوس / تَجَسَّسَ / طُعم, مروّج مخادع (طُعم يتصرف كزبون متحمس من أجل تحفيز مشاركة الآخرين)",
 "回し車": "عَجَلَة / عجلة / رويضة",
 "回す": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "回り": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / تَأْثِير, أَثَر / بِوَاسِطَة, عَن طَرِيق / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)",
 "回りくどい": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / غَيْر مُبَاشِر, مُلْتَوٍ (يَتَّسِم بِالمُوَارَبَة أَوْ عَدَم المُبَاشَرَة فِي الكَلَام أَوِ السُّلُوك)",
 "回りまわって": "أَخِيرًا, فِي اَلْآخِرْ",
 "回り合せ": "ثَرْوَة",
 "回り合わせ": "ثَرْوَة",
 "回り回って": "أَخِيرًا, فِي اَلْآخِرْ",
 "回り縁": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "回り込み": "رداء ملفوف (رداء (مثل فستان أو معطف) بفتحة كاملة الطول؛ يُضبط على الجسم بلفه حوله)",
 "回り道": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "回り遠い": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "回る": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "回を重ねる": "يقرب",
 "回付": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة)",
 "回内": "كب (تدوير اليدين والساعدين بحيث تتجه راحة اليد لأسفل)",
 "回内筋": "عضلة كابة (عضلة تنتج أو تساعد في الكب)",
 "回分": "دفعة, مجموعة (مجموعة من الأشياء أو الأشخاص يتم التعامل معهم معًا) / خبزة, دفعة خبز (جميع أرغفة الخبز المخبوزة في نفس الوقت) / الكثير, دفعة (عدد كبير أو كمية أو مدى كبير (وغالباً ما تتبعها كلمة 'من'))\nمثال: دفعة من الرسائل / مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "回勅": "تَعْمِيمِيّ, دَوْرِيّ (مُعَدٌّ لِلتَّوْزِيعِ الوَاسِعِ) / رسالة بابوية (رسالة من البابا ترسل إلى جميع الأساقفة الكاثوليك في جميع أنحاء العالم)",
 "回収": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "回収金": "شِفَاء, تَعَافِي",
 "回回教": "الْإِسْلَام",
 "回報": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "回外": "استلقاء, بسط الراحة (تدوير اليدين والساعدين بحيث تتجه راحة اليد لأعلى)",
 "回外筋": "عضلة استلقائية (عضلة (خاصة في الساعد) تنتج أو تساعد في الاستلقاء)",
 "回帰": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / ارتداد, تراجع (العودة إلى حالة سابقة) / انحدار, انحدار إحصائي / نكوص ((في الطب النفسي) آلية دفاع تهرب فيها من الواقع عن طريق افتراض حالة أكثر طفولية) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "回帰係数": "معامل الانحدار (عندما يكون خط الانحدار خطياً، فإن معامل الانحدار هو الثابت الذي يمثل معدل تغير متغير واحد كدالة للتغيرات في المتغير الآخر؛ وهو ميل خط الانحدار)",
 "回帰分析": "تحليل الانحدار (استخدام الانحدار لعمل تنبؤات كمية لمتغير واحد من قيم متغير آخر)",
 "回帰年": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "回帰式": "معادلة الانحدار (المعادلة التي تمثل العلاقة بين قيم مختارة لمتغير واحد (س) والقيم المرصودة للآخر (ص)؛ تسمح بالتنبؤ بالقيم الأكثر احتمالاً لـ (ص))",
 "回帰熱": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز بنوبات من الحمى العالية والقشعريرة والصداع وآلام العضلات والغثيان التي…)",
 "回帰的": "عَوْدِيّ",
 "回帰線": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة. / خط الانحدار, منحنى الانحدار (منحنى أملس يتم تركيبه على مجموعة من البيانات المزدوجة في تحليل الانحدار)",
 "回廊": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق.",
 "回廊地帯": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق.",
 "回復": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل / شِفَاء, تَعَافِي",
