 "声声": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "声帯": "اَوْتَار صَوْتِيَّة, أَحْبَال صَوْتِيَّة",
 "声帯炎": "التهاب الحبال الصوتية (التهاب الحبال الصوتية) / التهاب الحبل (التهاب الحبل المنوي أو الحبال الصوتية أو الطيات الصوتية)",
 "声掛け": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية.",
 "声援": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "声援を送る": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "声明": "إِعْلَان, بَيَان",
 "声明文": "مَنْسُور, مُنَادَاة",
 "声明書": "تَصْرِيح, بَيَان",
 "声望": "شُهْرَة",
 "声楽": "غناء, موسيقى صوتية (موسيقى يتم أداؤها بالصوت (على عكس الموسيقى الآلية)) / غناء, موسيقى صوتية (موسيقى مخصصة للأداء بواسطة مغنٍ واحد أو أكثر، عادة مع مرافقة آلية)",
 "声楽家": "مطرب, مغنٍ (شخص يغني)",
 "声楽曲": "غناء, موسيقى صوتية (موسيقى يتم أداؤها بالصوت (على عكس الموسيقى الآلية)) / غناء, موسيقى صوتية (موسيقى مخصصة للأداء بواسطة مغنٍ واحد أو أكثر، عادة مع مرافقة آلية)",
 "声母": "أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "声紋": "بصمة صوتية (تحديد هوية بيومتري عن طريق تسجيل صوت الشخص وتمثيله بيانياً إلكترونياً)\nمثال: البصمات الصوتية مميزة بشكل فريد للمتحدثين الأفراد",
 "声色": "نبرة, نبرة الصوت (جودة صوت الشخص)\nمثال: بدأ بنبرة حوارية / مُشَاكهَة",
 "声誉": "سُمْعَة, شُهْرَة",
 "声調": "نَغْمَة, نَغْم",
 "声調言語": "لغة نغمية (لغة تميز فيها النغمات المختلفة بين المعاني المختلفة)",
 "声部": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ",
 "声量": "حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟",
 "声門": "مزمار (الجهاز الصوتي للحنجرة؛ الحبال الصوتية الحقيقية والفراغ بينهما حيث تتولد نغمة الصوت)",
 "声門破裂音": "همزة قطع, وقفة حنجرية (صامت وقفي يُنطق عن طريق تحرير الضغط عند المزمار)",
 "声門閉鎖音": "همزة قطع, وقفة حنجرية (صامت وقفي يُنطق عن طريق تحرير الضغط عند المزمار)",
 "声門音": "حَنْجَرِيّ",
 "声音": "نبرة, نبرة الصوت (جودة صوت الشخص)\nمثال: بدأ بنبرة حوارية",
 "声音文字": "رمز صوتي (حرف مكتوب يُستخدم في النسخ الصوتي لتمثيل صوت كلام معين)",
 "声高": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "壱": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / أَفْضَل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "壱与": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "壱拾萬": "مِائَة أَلْف",
 "壱智村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "壱百萬": "مِلْيُون, ١٠٠٠٠٠٠ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "売り": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض / ميزة تنافسية, نقطة بيع (خاصية تجعل الشيء المعروض للبيع جذابًا للعملاء) / بَائِع, بَائِعَة / بِغَاءٌ, دَعَارَة",
 "売りつなぎ": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً) / تحوط (أي تقنية مصممة لتقليل أو القضاء على المخاطر المالية؛ على سبيل المثال، اتخاذ موقفين يعوض كل منهما الآخر إذا تغيرت الأسعار)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "売りどころ": "ميزة تنافسية, نقطة بيع (خاصية تجعل الشيء المعروض للبيع جذابًا للعملاء) / عَدَّاد",
 "売り上げ": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "売り上げ税": "ضريبة المبيعات (ضريبة تعتمد على تكلفة السلعة المشتراة وتُحصل مباشرة من المشتري)",
 "売り上げ金": "دَخْل (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "売り上げ高": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "売り主": "بَائِع, بَائِعَة",
 "売り付け": "بَيْع, بُيُوع / مَهَارَة البَيْع, مَهَارَات البَيْع",
 "売り値": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "売り出し": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "売り出し中": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "売り切り": "إذن, تصريح (إذن بالمضي قدماً) / خُلُوص, مَسَافَة فَاصِلَة (المسافة التي يتجاوز بها شيء شيئاً آخر؛ الحيز بينهما) / اِرْتِفَاع خَالِص, مِسَاحَة عُلْوِيَّة (المساحة الرأسية المتاحة للسماح بالمرور السهل تحت شيء ما)\nمثال: أعطيت الطائرة تصريحاً بالهبوط / بَيْع, بُيُوع / مَهَارَة البَيْع, مَهَارَات البَيْع",
