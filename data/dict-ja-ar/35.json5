 "地異": "كارثة طبيعية",
 "地盤": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة. / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / دائرة انتخابية, ناخبون (هيئة الناخبين الذين ينتخبون ممثلاً لمنطقتهم)",
 "地矢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "地租": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "地税": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "地積": "رقعة أرض, مساحة أرض (مساحة من الأرض تستخدم لغرض معين (مثل البناء أو الزراعة))\nمثال: أراد بعض المساحة من الأرض للبناء عليها",
 "地竜": "طب الأعشاب (استخدام الأعشاب الطبية للوقاية من الأمراض أو علاجها أو تعزيز الصحة) / دواء عشبي (دواء مصنوع من النباتات ويستخدم للوقاية من المرض أو علاجه أو تعزيز الصحة)",
 "地続き": "مُبَاشِر, مُتَّصِل (قريب جداً أو متصل في المكان أو الزمان) / مُتَاخِم, مُجَاوِر (لَهُ حُدُودٌ أَوْ حَوَافٌّ مُشْتَرَكَةٌ؛ مُلَاصِقٌ وَمُلَامِسٌ) / مُتَلَاصِق, مُتَّصِل (مُتَّصِلٌ دُونَ انْقِطَاعٍ؛ ضِمْنَ حُدُودٍ مُشْتَرَكَةٍ) / مُتَوَاصِل, مُتَّصِل",
 "地縁集団": "جَمَاعَة اجْتِمَاعِيَّة, فِئَة اجْتِمَاعِيَّة (أشخاص تجمعهم علاقة اجتماعيّة مشتركة)",
 "地肌": "مَلْمَس / فَرْوَة اَلرَّأْس",
 "地胆": "خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "地脈": "عرق معدني (طبقة من الخام بين طبقات الصخور)",
 "地腫れ": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "地膚": "مَلْمَس / فَرْوَة اَلرَّأْس",
 "地色": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة.",
 "地薄": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "地虫": "جعران (أي من الأنواع العديدة من الخنافس ممتلئة الجسم ذات رؤوس بقرون قرنية)",
 "地蛍": "يَرَاع, حَبَاحِب",
 "地衣": "أُشْنَة, حَزَاز",
 "地衣植物": "أُشْنَة, حَزَاز",
 "地衣類": "أُشْنَة, حَزَاز",
 "地表": "سطح, سطح الأرض (المستوى الخارجي لليابسة أو البحر)",
 "地誌": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان) / طبوغرافيا (دراسة تفصيلية دقيقة لسمات سطح منطقة ما)",
 "地誌学": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان) / طبوغرافيا (دراسة تفصيلية دقيقة لسمات سطح منطقة ما)",
 "地謡前": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "地謡座前": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "地貌": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان) / طبوغرافيا (دراسة تفصيلية دقيقة لسمات سطح منطقة ما)",
 "地財法": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "地質学": "جِيُولُوجِيَا, عِلْم اَلْأَرْض (عِلْم الطَبَقَات الأَرْض)\nمثال: درس توم الجيولوجيا.",
 "地質学者": "جِيُولُوجِيّ",
 "地質年代": "زمن جيولوجي (زمن التكوين المادي وتطور الأرض (خاصة قبل التاريخ البشري))",
 "地質時代": "حقبة (قسم رئيسي من الزمن الجيولوجي؛ تنقسم الحقبة عادة إلى فترتين أو أكثر)",
 "地車": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "地道": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "地金": "سبيكة / معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "地鉄": "حديد ألفا (تآصل مغناطيسي للحديد؛ مستقر تحت 906 درجة مئوية) / فيريت (محلول جامد يكون فيه حديد ألفا هو المذيب)",
 "地銭": "حشيشة الكبد (أي من النباتات اللاوعائية الخضراء الصغيرة العديدة من طائفة الكبدية تنمو في الأماكن الرطبة وتشبه الأعشاب البحرية الخضراء أو الحزازيات الورقية)",
 "地階": "قَبْوْ / سِرْدَاب / بَدْرُوم / بَدْرُون",
 "地際": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "地雷": "لَغْم, لَغْم أَرْضِيّ / زِنَاد / شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "地雷原": "حَقْلُ أَلْغَام (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "地雷火": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "地震": "زَلْزَال, زِلْزال (فِي : ظاهرة طبيعية وهو اهتزاز أو سلسلة من الاهتزازات الارتجاجية المتتالية لسطح تحدث في وقت لا يتعدى ثواني معدودة…)\nمثال: دمر زلزال عيادة سامي.",
 "地震学": "عِلْم اَلزَّلَازِل (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "地震学者": "عالم زلازل (جيوفيزيائي يدرس الزلازل والخصائص الميكانيكية للأرض)",
 "地震津波": "تْسُونَامِي",
 "地震計": "جهاز قياس الزلازل, سيسموجراف (أداة قياس للكشف عن وقياس شدة واتجاه ومدة حركات الأرض (مثل الزلزال))",
 "地震記象": "سيزموجرام, مخطط زلزالي (السجل البياني لهزة أرضية تم إجراؤه باستخدام جهاز قياس الزلازل)",
 "地面": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة. / بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "地面効果": "تأثير أرضي (زيادة ظاهرية في الرفع الديناميكي الهوائي تختبرها الطائرة عند طيرانها بالقرب من الأرض)",
 "地響き": "رعشة أرضية, زلزال صغير (زلزال صغير)",
 "地頭": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "地頭方": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "地鳥": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "地鳴り": "عِرَاك عِصَابَات (قتال بين عصابات متنافسة من المراهقين) / مقعد خلفي (مقعد خادم (أو حجرة أمتعة) في مؤخرة عربة) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)",
 "地鶏": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "地鼠": "زَبَابَة",
 "圷": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "圸": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)",
 "坂": "مُنْحَدَر / مَيْل / حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات) / إنجاز مرحلي, حدث بارز (حدث مهم في حياتك (أو في مشروع))",
 "坂上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "坂下": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
