 "嘘泣き": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "嘘発見器": "جهاز كشف الكذب (جهاز بوليغراف يسجل التغيرات الجسدية المرتبطة أحياناً بالكذب)",
 "嘘臭い": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "嘘言": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "嘯く": "تَبَاهَى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "嘱す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "嘱する": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "嘱目": "مراعٍ, منتبه (يأخذ الحذر؛ يعطي اهتماماً وثيقاً وعميقاً) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين))\nمثال: منتبه للتحذيرات",
 "嘱託": "عُمُولَة / وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "嘲う": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "嘲けり": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "嘲り": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "嘲る": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "嘲弄": "اِحْتَقَرَ / استنكف / استخف",
 "嘲笑": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "嘲笑う": "تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "嘲罵": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "嘴": "مِنْقَار",
 "嘴が黄色い": "غِرّ, نَاشِئ (صغير السن وعديم الخبرة) / فرخ طائر (طائر صغير اكتسى بالريش للتو أو أصبح قادراً على الطيران) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "嘴をはさむ": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "嘴を入れる": "قَاطَعَ",
 "嘴を挟む": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا)",
 "嘴太海烏": "مور غليظ المنقار (نوع من طائر المور)",
 "嘴広鸛": "أبو مركوب",
 "嘴白啄木鳥": "نقار الخشب عاجي المنقار (نقار خشب كبير أسود وأبيض من جنوب الولايات المتحدة وكوبا له منقار عاجي؛ شبه منقرض)",
 "嘴細烏": "نسر أسود أمريكي (نسر أمريكي أصغر من النسر الرومي)",
 "嘴細鴉": "نسر أسود أمريكي (نسر أمريكي أصغر من النسر الرومي)",
 "嘶き": "صَهِيل / صَهَلَ (صَهَلَ: (فعل)صهَلَ يَصهَل ويَصهِل ، صَهيلاً وصُهالاً ، فهو صاهِل صَهَلَ الْفَرَسُ : صَوَّتَ؛ ل. (فعل: ثلاثي لازم). صَهَلَ، يَصْهَلُ، مصدر صُهَالٌ، صَهِيلٌ.صَهَلَ الْفَرَسُ :صَوَّتَ)",
 "嘶く": "صَهِيل / صَهَلَ (صَهَلَ: (فعل)صهَلَ يَصهَل ويَصهِل ، صَهيلاً وصُهالاً ، فهو صاهِل صَهَلَ الْفَرَسُ : صَوَّتَ؛ ل. (فعل: ثلاثي لازم). صَهَلَ، يَصْهَلُ، مصدر صُهَالٌ، صَهِيلٌ.صَهَلَ الْفَرَسُ :صَوَّتَ)",
 "噁噁": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ",
 "噂": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "噂話": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "噎せっぽい": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ) / اختناق, غصة (حالة ناتجة عن انسداد الممرات الهوائية المؤدية إلى الرئتين (كما هو الحال مع الطعام أو تورم الحنجرة))\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "噎せる": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "噎せ返る": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "噎び泣き": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "噓": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "噓っぽい": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "噛ます": "اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "噛ませる": "اِتِّفَاقِيَّة / جَرَّ, سَحَبَ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "噛ませ犬": "تاجر جملة (شخص يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من المستهلكين النهائيين)",
 "噛み": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "噛みこなす": "هَضَمَ",
 "噛みしだく": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة",
 "噛みしめる": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / هَضَمَ",
 "噛みつく": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "噛み付き亀": "سلحفاة نهاشة (سلحفاة مياه عذبة كبيرة عدوانية ذات فكوك قوية)",
 "噛み付く": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "噛み傷": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "噛み分ける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "噛み合う": "شَبَكَة",
 "噛み合わせ": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إِطْبَاق, إِطْبَاق الأَسْنَان ((طب الأسنان) العلاقة المكانية الطبيعية للأسنان عندما يكون الفكان مغلقين) / جبهة محبوسة, جبهة مقفلة ((في الأرصاد الجوية) جبهة مركبة عندما يحيط الهواء البارد بكتلة من الهواء الدافئ ويجبرها على الارتفاع)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "噛み合わせる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي / أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ / وَفَّقَ",
 "噛み殺す": "خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "噛み砕く": "جَرَشَ (جَرَشَ الحَبَّ فِي المِهْرَازِ: طَحَنَهُ فُتَاتًا، طَحْنًا غَيْرَ نَاعِمٍ؛ جَرَشَ رَأْسَهُ بِالْمُشْطِ: حَكَّهُ حَكًّا شَدِيدًا حَتَّى أَثَارَ قِشْرَتَهُ، وَسَخَهُ) / قَرْمَشَة",
 "噛み締める": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / هَضَمَ",
 "噛む": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / مَضَغَ / تاتاة, تلعثم (اضطراب في الكلام ينطوي على تردد وتكرار لا إرادي لأصوات معينة) / شَبَكَة",
 "噛り付き": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "噛る": "نَخَرَ, قَضَمَ",
 "噛付亀": "سلحفاة نهاشة (سلحفاة مياه عذبة كبيرة عدوانية ذات فكوك قوية)",
 "噛分ける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "噤む": "صَمَتَ",
 "噦く": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "噦り": "حَازُوقَة / فُوَاق / فَوَاقَ",
 "噦る": "حَازُوقَة / فُوَاق / فَوَاقَ",
 "器": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة / قُدْرَة, مَقْدِرَة / مَوْهِبَة / أَدَاة, جِهَاز / وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ. / قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "器が大きい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / حَلِيم, صَبُور (مُتَسَامِحٌ وَصَفُوحٌ عِنْدَ الِاسْتِفْزَازِ) / مُتَسَامِح, مُحْتَمِل (يُظْهِرُ قُدْرَةً عَلَى التَّحَمُّل) / مُتَحَمِّل, مُقَاوِم (قادر على تحمل الظروف البيئية أو الإجهاد الفسيولوجي)",
 "器が小さい": "غَيْر مُتَسَامِح, مُتَعَصِّب (ضَيِّق التَّفْكِير بِشَأْن آرَائِه الرَّاسِخَة) / غير متسامح, متعصب (غير راغب في تحمل اختلاف الرأي)",
 "器の大きい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / حَلِيم, صَبُور (مُتَسَامِحٌ وَصَفُوحٌ عِنْدَ الِاسْتِفْزَازِ) / مُتَسَامِح, مُحْتَمِل (يُظْهِرُ قُدْرَةً عَلَى التَّحَمُّل) / مُتَحَمِّل, مُقَاوِم (قادر على تحمل الظروف البيئية أو الإجهاد الفسيولوجي)",
 "器の小さい": "غَيْر مُتَسَامِح, مُتَعَصِّب (ضَيِّق التَّفْكِير بِشَأْن آرَائِه الرَّاسِخَة) / غير متسامح, متعصب (غير راغب في تحمل اختلاف الرأي)",
 "器具": "آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل))",
 "器具類": "الة موسيقية / آلَة (الفارسية: ماشين؛ الأوردية: مشين) / أَدَاة\nمثال: نسى زيري الآلة.",
 "器官": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / جِهَاز, جَهَاز / أُرْغُن ((أَرْغَنَ): أطاع؛ (أَرْغَنَ) إليه: رغن)\nمثال: اذكر كل عضو باسمه.",
 "器械": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / الة موسيقية / آلَة (الفارسية: ماشين؛ الأوردية: مشين) / أَدَاة\nمثال: نسى زيري الآلة.",
 "器械運動": "جُمْبَاز",
 "器楽": "موسيقى آلية (موسيقى تُنتج عن طريق العزف على آلة موسيقية) / موسيقى آلية (موسيقى مخصصة للأداء بآلة موسيقية أو مجموعة من الآلات)",
 "器機": "أَدَاة, جِهَاز",
 "器物": "حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية) / آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل)) / أموال منقولة, ممتلكات شخصية (الممتلكات المنقولة (لتمييزها عن العقارات)) / جودة, عيار (درجة أو مرتبة من التميز أو القيمة) / عيار, قُطْر داخلي (قُطر أنبوب أو ماسورة سلاح ناري)\nمثال: ارتفعت جودة الطلاب",
 "器用": "مَاهِر, حَاذِق / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "器皿": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "器財": "أَدَاة",
 "器質": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور.",
 "器質性": "عُضْوِيّ",
 "器質的": "عُضْوِيّ",
 "器量": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / قُدْرَة, مَقْدِرَة / مَوْهِبَة / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "器量よし": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "器量好し": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "器量良し": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "噪音": "ضَوْضَاء, ضَجِيج",
 "噫気": "تَجَشَّأَ / تَجَشُّؤ",
 "噯": "تَجَشَّأَ / تَجَشُّؤ",
 "噯気": "تَجَشَّأَ / تَجَشُّؤ",
 "噴き上げ": "نَافُورَة, فَوَّارَة",
 "噴き出す": "نَبْتَة / نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "噴く": "نَفَثَ, أَصْدَرَ",
 "噴上げ": "نَافُورَة, فَوَّارَة",
 "噴出": "فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة) / مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "噴射": "مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة) / دفق (دَفَقَ: صَبَّهُ، وَهُوَ ماءٌ دافِقٌ، دَفَقَ اللهُ رُوحَه أَي: أَماتَهُ، ودَفَقَ الكُوزَ: بَدَّدَ مَا فِيه بمَرَّةِ)\nمثال: المحرك لا يعمل. / دفع صاروخي (دفع نفاث يستخدم الأكسجين المخزن للاحتراق؛ يستخدم في الأماكن التي لا يوجد فيها أكسجين جوي كافٍ)",
 "噴射式": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "噴気": "غَاز",
 "噴気孔": "فتحة تهوية, منفس (ثقب لهروب الغاز أو الهواء) / ثقب النفث (متنفس الحيتانيات الواقع بعيداً في الخلف على الجمجمة)",
 "噴水": "سبيل ماء, نافورة شرب (نافورة عامة لتوفير تيار من مياه الشرب)",
 "噴水井戸": "بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "噴水孔": "متنفس (فتحة تنفسية)",
 "噴泉": "نَافُورَة, فَوَّارَة",
 "噴流": "مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة) / دفق (دَفَقَ: صَبَّهُ، وَهُوَ ماءٌ دافِقٌ، دَفَقَ اللهُ رُوحَه أَي: أَماتَهُ، ودَفَقَ الكُوزَ: بَدَّدَ مَا فِيه بمَرَّةِ)\nمثال: المحرك لا يعمل.",
