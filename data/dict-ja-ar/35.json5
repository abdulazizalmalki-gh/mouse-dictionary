 "回転楕円体": "شبه كرة, كرواني (شكل يتولد عن تدوير قطع ناقص حول أحد محاوره)",
 "回転率": "دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)",
 "回転競技": "تَزَلُّجٌ مُتَعَرِّج",
 "回転翼": "جناح دوار, شفرة دوارة (السطح الانسيابي الطويل الذي يدور لتوفير الرفع الذي يدعم طائرة الهليكوبتر في الهواء)",
 "回転計": "تاكومتر, مقياس سرعة الدوران (أداة قياس للإشارة إلى سرعة الدوران)",
 "回転資金": "صندوق متجدد (صندوق يهدف، في حال الاقتراض منه أو استخدامه، إلى تجديده ليتم إقراضه أو إنفاقه بشكل متكرر)",
 "回転速度計": "تاكومتر, مقياس سرعة الدوران (أداة قياس للإشارة إلى سرعة الدوران)",
 "回転運動": "دوران حلزوني (عملية الدوران في دائرة أو حلزون) / دوران, دورة (دورة كاملة واحدة (محورية أو مدارية))\nمثال: قامت الطائرة بثلاث دورات قبل أن تتحطم",
 "回転鮨": "حِزَام نَاقِل (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "回送": "إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى) / ترويج, تعزيز (النهوض بمشروع ما)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً / رحلة فارغة, مركبة فارغة (قطار أو حافلة أو سيارة أجرة تسافر فارغة (بدون ركاب أو حمولة)) / شخص غير منتج, عالة (شخص غير مبادر لا يغطي تكاليفه)",
 "回送店": "وكيل شحن بحري (وكيل مالك السفينة)",
 "回送車": "رحلة فارغة, مركبة فارغة (قطار أو حافلة أو سيارة أجرة تسافر فارغة (بدون ركاب أو حمولة)) / شخص غير منتج, عالة (شخص غير مبادر لا يغطي تكاليفه)",
 "回送電車": "رحلة فارغة, مركبة فارغة (قطار أو حافلة أو سيارة أجرة تسافر فارغة (بدون ركاب أو حمولة)) / شخص غير منتج, عالة (شخص غير مبادر لا يغطي تكاليفه)",
 "回遊": "جَوْلَة, نُزْهَة",
 "回遊性": "صلاحية الملاحة (صفة الملاءمة لمرور السفن أو الطائرات)",
 "回避": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / تنحٍّ, رد القاضي ((قانون) استبعاد قاضٍ أو هيئة محلفين بسبب التحيز أو تضارب المصالح)",
 "回避不能": "حَتْمِيّ",
 "回避的": "مُتَهَرِّب, مُرَاوِغ (غامض أو ملتبس عمداً) / تَهَرُّبِيّ, مُرَاوِغ (يتفادى أو يهرب من الصعوبة أو الخطر خاصة نيران العدوّ)",
 "回避策": "تَحَاشٍ / تَجَنُّب (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "回音": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "回頭": "تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "回顧": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ)\nمثال: ليلى تذكر سامي.",
 "回顧展": "متعلِّق بالماضي, رَجْعِيّ",
 "回顧的": "متعلِّق بالماضي, رَجْعِيّ",
 "回顧談": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "回顧録": "مُذَكَّرَات, مُذَكِّرَات",
 "回鶻": "الخط الأويغوري (الخط (المشتق من الآرامية) المستخدم لكتابة اللغة الأويغورية) / الأويغورية (اللغة التركية التي يتحدث بها ما يقرب من 7,000,000 من الأويغور في أقصى شمال غرب الصين) / إيغوري (عضو في شعب يتحدث الإيغورية ويعيش في شينجيانغ والمناطق المجاورة)",
 "因": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "因った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "因って来たる": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "因って来る": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "因に": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "因み": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية. / تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "因みに": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "因りて": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "因をなす": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "因を成す": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "因子": "عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "因子分析": "تحليل عاملي (أي من عدة طرق لاختزال بيانات الارتباط إلى عدد أصغر من الأبعاد أو العوامل)",
 "因幡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "因循": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "因数": "عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "因数分解": "تحليل العوامل, تفكيك ((رياضيات) تحليل تعبير رياضي إلى عوامل بحيث يعطي ضربها معاً التعبير الأصلي)",
 "因果": "سَبَبِيَّة, عليَة / كَارْمَا / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "因果因縁": "كَارْمَا",
 "因果応報": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "因果性": "سَبَبِيَّة, عليَة",
 "因果的": "سَبَبِيّ, عِلِّيّ (يتضمّن أو يشكّل سببًا؛ مُسبِّب)",
 "因果関係": "سَبَبِيَّة, عليَة",
 "因業": "عديم الرحمة, قاسي القلب (يفتقر إلى الشعور أو الشفقة أو الدفء) / فَاقِدُ الشَّجَاعَة (خالٍ من الشجاعة أو الحماس)",
 "因由": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "因縁": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / صِلَة, صُلَة / عَلَاقَة, صِلَة / ذَرِيعَة, عُذْر",
 "因習": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "因習的": "عُرْفِيّ",
 "因襲": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "団": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "団の精神": "تضامن, روح الجماعة (روح الجماعة التي تجعل الأعضاء يرغبون في نجاح المجموعة)",
 "団らん": "اِنْسِجَام, تَوَافُق",
 "団亀": "سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة)",
 "団交": "مفاوضة جماعية (تفاوض بين صاحب العمل والنقابة العمالية)",
 "団体": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "団体交渉": "مفاوضة جماعية (تفاوض بين صاحب العمل والنقابة العمالية)",
 "団体保険": "تأمين جماعي (تأمين تشتريه مجموعة (مثل موظفي شركة) عادة بسعر مخفض للأعضاء الأفراد في المجموعة)",
 "団体協約": "اتفاقية جماعية, عقد عمل جماعي (عقد بين العمال والإدارة ينظم الأجور والمزايا وظروف العمل)",
 "団体競技": "رياضة جماعية (رياضة تتضمن المنافسة بين فرق من اللاعبين)\nمثال: البيسبول رياضة جماعية لكن الغولف ليس كذلك",
 "団体精神": "تضامن, روح الجماعة (روح الجماعة التي تجعل الأعضاء يرغبون في نجاح المجموعة)",
 "団地族": "مساكن شعبية, مشروع إسكان عام (مجمع سكني ممول ومُدار حكومياً للأسر ذات الدخل المنخفض)",
 "団塊": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء. / عُقَيدَة (عقدة صغيرة) / عُقَيـْدَة ((في علم المعادن) كتلة معدنية صغيرة مستديرة (عادة ما تكون أصلب من الصخور أو الرواسب المحيطة)) / درينة, عقيدة (نتوء صغير مستدير يشبه الثالول على النبات) / جيل طفرة المواليد (الجيل الأكبر من المتوقع في الولايات المتحدة الذي ولد بعد وقت قصير من الحرب العالمية الثانية)",
 "団塊の世代": "جيل طفرة المواليد (الجيل الأكبر من المتوقع في الولايات المتحدة الذي ولد بعد وقت قصير من الحرب العالمية الثانية)",
 "団子": "دَامْبْلِنْغ / كُرَوِيّ (ذو شكل الكرة أو المجال) / كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "団子状": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "団子虫": "قملة الخشب المكورة (متماثل أرجل أرضي صغير ذو جسم مقسم محدب يمكنه الالتفاف على شكل كرة)",
 "団子魚": "سمكة الكتل (سمكة خرقاء ناعمة سميكة الجسم في شمال المحيط الأطلسي مع زعانف حوضية ملتحمة في ممص؛ يستخدم بطرخها الصالح للأكل للكافيار)",
 "団子鼻": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "団栗": "بَلُّوط, بَلُّوطَة",
 "団栗南瓜": "قرع البلوط (قرع صغير مضلع أخضر داكن أو أصفر ذو لب أصفر إلى برتقالي) / قرع البلوط (نبات قرع يحمل ثماراً صغيرة على شكل بلوط لها لب أصفر وقشرة خضراء داكنة أو صفراء مع تلال طولية)",
 "団栗眼": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "団欒": "اِنْسِجَام, تَوَافُق",
 "団結": "وَحْدَة, اِتِّحَاد",
 "団結力": "وَحْدَة, اِتِّحَاد",
 "団結心": "تضامن, روح الجماعة (روح الجماعة التي تجعل الأعضاء يرغبون في نجاح المجموعة)",
 "囮": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / طُعم, مستدرج (مخادع يقود شخصاً ما إلى الخطر (عادة كجزء من مؤامرة))",
 "囮商法": "إغراء واستبدال (طريقة خادعة للبيع تتضمن الإعلان عن منتج بسعر منخفض جداً لجذب العملاء ثم إقناعهم بالتحول إلى منتج أكثر تكلفة)",
 "囮捜査": "عملية سرية, كمين (عملية مصممة للقبض على شخص يرتكب فعلاً إجرامياً) / عملية إيقاع, كمين للشرطة (لعبة ثقة معقدة مخطط لها ومنفذة بعناية كبيرة (خاصة عملية ينفذها عملاء سريون للقبض على المجرمين))\nمثال: نفذت الشرطة عملية سرية",
 "困った": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / صعب المراس, مستعصٍ (يصعب التحكم فيه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه) / ثقيل, صعب الاستخدام (صعب الاستخدام أو التعامل معه أو إدارته بسبب الحجم أو الوزن أو الشكل)\nمثال: طفل صعب المراس / غير مناسب, في غير وقته (غير مناسب من حيث التوقيت)\nمثال: وصل في ساعة غير مناسبة للغاية / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب)",
 "困ったこと": "مُشْكِلَة, مَتاعِب",
 "困ったことに": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "困ったちゃん": "إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة)\nمثال: إزعاج بسيط",
 "困ったひと": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "困った事": "مُشْكِلَة, مَتاعِب",
 "困った事に": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "困った人": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "困らせる": "أَخْجَلَ (أَخْجَلَ (النباتُ): خَجِلَ؛ أَخْجَلَ (فلانًا): جعله يخجل)\nمثال: أخجل من تصرف ولدي.",
 "困りごと": "تَمْرِين / مَسْأَلَة",
 "困りもの": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له) / إِزْعَاج",
 "困り事": "تَمْرِين / مَسْأَلَة",
 "困り物": "إِزْعَاج",
 "困り者": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "困却": "ارتباك, حيرة (مشكلة أو ارتباك ناتج عن التعقيد)",
 "困厄": "مِحْنَة",
 "困惑": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "困憊": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد)",
 "困窮": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "困窮者": "فَقِير / مِسْكِين / فُقَرَاء",
 "困苦": "حرمان (فعل حرمان شخص ما من الطعام أو المال أو الحقوق) / حرمان, عوز (حالة من الفقر المدقع)",
 "困阨": "مِحْنَة",
 "困難": "صُعُوبَة / اسْتِحَالَة, عَدَم جَدْوَى (صفة كون الشيء غير قابل للقيام به)",
 "囲": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)",
 "囲い": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)\nمثال: 家の周りには囲いがしてある。 — هناك سياج حول المنزل. / إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / سَيِّدَة / خَلِيلَة, عَشِيقَة / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "囲い女": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "囲い者": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "囲い込み": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "囲い込む": "حظيرة أبقار, زريبة بقر (حظيرة للأبقار)",
 "囲う": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين. / اِحْتَفَظَ, أَبْقَى / خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "囲にょう": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "囲み": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي) / حِصَار, مُحَاصَرَة",
 "囲み記事": "عَمُود / خَانَة",
 "囲む": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / حَاصَرَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "囲炉裏端": "منزل, موقد (المنزل يرمز له كجزء من الموقد) / جوار الموقد, موقد (منطقة بالقرب من الموقد (عادة ما تكون مرصوفة وتمتد داخل الغرفة))\nمثال: طردوا من ديارهم ومنازلهم",
 "囲碁": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "囲繞": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "囲障": "سُور / سِيَاج",
 "図": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / مَشْهَد / مَنْظَر",
 "図々しい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)\nمثال: よくずうずうしくそんな事が言えるね。 — كيف تجرء على قول شيءٍ كهذا؟",
 "図がない": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "図が無い": "لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "図った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "図らず": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)",
 "図らずも": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "図る": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه. / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "図上演習": "لُعْبَة حَرْب (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "図体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "図像": "قُونَة, أَيْقُونَة / أَيْقُونَة",
 "図像学": "علم رسم الأيقونات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "図化": "رسم الخرائط الجينية ((علم الوراثة) عملية تحديد مواقع الجينات على الكروموسوم) / تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة)) / رسم الخرائط (عملية صنع الخرائط)\nمثال: رسم خرائط مفصل لبنية الصخور",
 "図取り": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "図図しい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)\nمثال: よくずうずうしくそんな事が言えるね。 — كيف تجرء على قول شيءٍ كهذا؟",
 "図太い": "جَرِيء, جَسُور",
 "図子": "زُقَاق / مُفْتَرَق, تَقَاطُع",
 "図学": "رُسُومِيَّات",
 "図工": "حرف يدوية, فنون وحرف (فنون التصميم الزخرفي والحرف اليدوية)\nمثال: رعوا الفنون والحرف اليدوية لتشجيع الحرفية في عصر الإنتاج الضخم",
 "図師": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "図式": "مُخَطَط, رَسْم إِيضَاحِيّ / رَسْم بَيَانِيّ, مُخَطَط (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "図式的": "تَبْسِيطِيّ, سَاذَج (يتَّسم بالبساطة المُفرطة والمُضلِّلة أحيانًا)",
 "図形": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "図形処理": "جرافيكس الكمبيوتر, رسوم حاسوبية (التمثيل التصويري ومعالجة البيانات بواسطة الكمبيوتر)",
 "図形幾何学": "هندسة إسقاطية, هندسة وصفية (هندسة الخصائص التي تظل ثابتة تحت الإسقاط)",
 "図形記号": "حرف, رمز كتابي (رمز مكتوب يُستخدم لتمثيل الكلام)\nمثال: الأبجدية اليونانية تحتوي على 24 حرفاً",
 "図形記述子": "بالاديوم (عنصر فلزي فضي-أبيض من مجموعة البلاتين يشبه البلاتين)",
 "図心": "مركز هندسي, نقطة مركزية (مركز كتلة جسم ذو كثافة منتظمة)",
 "図星": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "図書": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "図書係": "أَمِين مَكْتَبَة, أَمِينَةْ مَكْتَبَة (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "図書券": "قسيمة كتب (قسيمة هدية يمكن استبدالها بكتب تصل قيمتها إلى المبلغ المذكور على القسيمة)",
 "図書室": "مَكْتَبَة, مكتبة",
 "図書目録": "فهرس البطاقات, كتالوج البطاقات (قائمة أبجدية للعناصر (مثل الكتب في المكتبة) مع بطاقة منفصلة لكل عنصر) / فهرس البطاقات (فهرس مكتبة يتم فيه وصف كل منشور على بطاقة ملف منفصلة)",
 "図書館": "مَكْتَبَة, مكتبة\nمثال: 私たちの学校には立派な図書館があります。 — لدينا مكتبة مدرسية جميلة.",
 "図書館カード": "بطاقة استعارة, بطاقة مكتبة (بطاقة تثبت حق حاملها في استخدام المكتبة)",
 "図書館員": "أَمِين مَكْتَبَة, أَمِينَةْ مَكْتَبَة (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "図書館学": "علم المكتبات (دراسة مبادئ وممارسات إدارة المكتبات)",
 "図柄": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "図案": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "図案化": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "図案家": "مُصَمِّم, مُصَمِّمَة",
 "図法": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "図法幾何学": "هندسة إسقاطية, هندسة وصفية (هندسة الخصائص التي تظل ثابتة تحت الإسقاط)",
 "図版": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "図画": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "図画工作": "حرف يدوية, فنون وحرف (فنون التصميم الزخرفي والحرف اليدوية)\nمثال: رعوا الفنون والحرف اليدوية لتشجيع الحرفية في عصر الإنتاج الضخم",
 "図絵": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "図表": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "図解": "مُخَطَط, رَسْم إِيضَاحِيّ / رَسْم بَيَانِيّ, مُخَطَط (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "図解法": "علم رسم الأيقونات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "図説": "رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم) / عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / رسم توضيحي (عمل فني يساعد على جعل شيء ما واضحاً أو جذاباً)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "図録": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "図鑑": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "図面": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "囹圄": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)",
 "固い": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب. / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "固さ": "ثَبَات",
 "固し": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "固まり": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / تَجَسَّد",
 "固まる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / تَجَمَّدَ",
 "固め": "تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً)) / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور) / تحجر, تصلب (تصلب أو تغلظ غير طبيعي للأنسجة)\nمثال: تصلب الخرسانة / تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء. / دِفَاع, حِمَايَة / دِفاع",
 "固める": "تَجَمَّدَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / قَوَّى",
 "固ゆで": "مَسْلُوقٌ تَمَامًا ((عَنِ البَيْض) مَسْلُوقٌ حَتَّى تَمَاسُكِ الصَّفَار) / عَديم الإحْساس, مُتَقَسٍّ (أصبَح قاسِيًا بِفِعْل التَّجْرِبَة؛ لا تُؤَثِّر فيه المَشاعِر) / عَنِيد, مُتَجَلِّد (قاسٍ وغليظ بفعل الخبرة والتجربة)",
 "固ゆで卵": "بيض مسلوق جيداً (بيضة مغلية برفق حتى يتصلب البياض والصفار)",
 "固より": "لَا شَكَّ, لَا جَرَمَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)",
 "固体": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "固体レーザ": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "固体ロケット": "صاروخ بالوقود الصلب, محرك صاروخي بالوقود الصلب (محرك صاروخي كيميائي يستخدم الوقود الدافع في الحالة الصلبة)",
 "固体化学": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "固体惑星": "كَوْكَب أَرْضِيّ, كَوْكَب صَخْرِيّ (كوكب له سطح صخري صلب مثل سطح الأرض؛ الكواكب الأربعة الداخلية في النظام الشمسي)",
 "固体撮像デバイス": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "固体物理学": "حالة صلبة, صلابة (الحالة التي لا تميل فيها المادة للتدفق تحت إجهاد معتدل؛ وتقاوم القوى (مثل الضغط) التي تميل لتشويهها؛ وتحتفظ بحجم وشكل محددين)",
 "固化": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "固型": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "固執": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية",
 "固守": "تَمَسَّكَ",
 "固定": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / إخصاء, تعقيم الحيوانات (تعقيم الحيوان) / أداة تثبيت, مثبت (قيد يربط بشيء ما أو يثبت شيئاً في مكانه)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "固定ディスク": "قُرْص صُلْب",
 "固定ディスクドライブ": "قرص صلب (قرص مغناطيسي صلب مثبت بشكل دائم في وحدة محرك أقراص)",
 "固定ビットレート": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "固定値": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "固定剤": "مثبت (ورنيش مذاب في الكحول ويرش على الصور لمنع التلطخ) / مثبت (مركب (مثل الإيثانول أو الفورمالديهايد) يثبت الأنسجة والخلايا للدراسة المجهرية)",
 "固定化": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان) / تعطيل, شل الحركة (فعل الحد من الحركة أو جعل الشيء غير قادر على الحركة) / تثبيت, شل حركة (تثبيت جزء من الجسم (كما هو الحال بجبيرة الجبس) لتعزيز الشفاء السليم)\nمثال: تسببت العاصفة في شلل تام لفريق الإنقاذ",
 "固定子": "عضو ثابت (جهاز ميكانيكي يتكون من الجزء الثابت من محرك أو مولد يدور فيه أو حوله الدوار)",
 "固定客": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "固定小数点表示法": "تدوين النقطة الثابتة (نظام عد جذري يُحدد فيه موقع الفاصلة العشرية بالاتفاق)",
 "固定幅フォント": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "固定為替相場制": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف الثابت لا يتغير وفقاً لظروف السوق)",
 "固定相場": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف الثابت لا يتغير وفقاً لظروف السوق)",
 "固定相場制": "سعر صرف ثابت (سعر صرف لعملة حيث قررت الحكومة ربط القيمة بسلعة ثمينة مثل الذهب؛ سعر الصرف الثابت لا يتغير وفقاً لظروف السوق)",
 "固定観念": "صُورَة نَمَطِيَّة",
 "固定記憶装置": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "固定費": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "固定費用": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "固定資産税": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "固形": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "固形ブイヨン": "مكعب مرقة (مكعب من مستخلص اللحم المتبل والمبخر)",
 "固形物": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "固形石鹸": "قطعة صابون (صابون على شكل قطعة صلبة)",
 "固形食": "طَعَام, غِذَاء صُلْب (أيّ مادّة صلبة تُستخدَم مصدرًا للتغذية، في مقابل السوائل)",
 "固持": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية",
 "固有": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "固有値": "قيمة ذاتية, قيمة مميزة ((رياضيات) أي عدد بحيث أن مصفوفة مربعة معينة مطروحًا منها ذلك العدد مضروبًا في مصفوفة الوحدة يكون لها محدد صفري)",
 "固有受容": "إدراك الوضعية, استقبال الحس العميق (القدرة على استشعار موضع ومكان واتجاه وحركة الجسم وأجزائه)",
 "固有名詞": "عَلَم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "固有名詞学": "علم الأسماء (فرع علم المعجم الذي يدرس أشكال وأصول الأسماء العلم)",
 "固有肝動脈": "شريان كبدي (شرايين تغذي الكبد)",
 "固有表現": "الشَّمَال الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الشمال والشرق؛ عند 45 درجة) / نيون (عنصر غازي عديم اللون والرائحة يعطي توهجاً أحمر في أنبوب التفريغ؛ أحد الغازات الخاملة الستة)",
 "固油": "مَرْهَم, بُومَادَة",
 "固溶体": "محلول جامد, محلول صلب (مادة صلبة متجانسة يمكن أن توجد عبر نطاق من المكونات الكيميائية؛ مكون من السبائك يتشكل عندما تندمج ذرات عنصر في بلورات معدن)",
 "固焼": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "固焼き": "مَخْبُوزٌ حَتَّى التَّصَلُّب (خُبِزَ حَتَّى أَصْبَحَ صَلْبًا)",
 "固着": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية",
 "固着観念": "هَوَس",
 "固結": "تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً)) / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور) / تحجر, تصلب (تصلب أو تغلظ غير طبيعي للأنسجة)\nمثال: تصلب الخرسانة",
 "固結び": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "固縛": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / جَالِد, سَائِق (يَحُثُّ بِعُنْفٍ بِالسَّوْطِ أَوِ الجَلْد) / تحزيم, ربط (حبل يستخدم لربط شيء بشيء آخر)\nمثال: كانت القوارب مربوطة ببعضها البعض بالحبال",
 "固縮": "جُمُود, صَلَابَة (صفة كون الشخص جامداً وشديد الصرامة) / جسوءة, صلابة (الخاصية الفيزيائية لكون الشيء صلباً ومقاوماً للثني)",
 "固茹で": "مَسْلُوقٌ تَمَامًا ((عَنِ البَيْض) مَسْلُوقٌ حَتَّى تَمَاسُكِ الصَّفَار) / عَديم الإحْساس, مُتَقَسٍّ (أصبَح قاسِيًا بِفِعْل التَّجْرِبَة؛ لا تُؤَثِّر فيه المَشاعِر) / عَنِيد, مُتَجَلِّد (قاسٍ وغليظ بفعل الخبرة والتجربة)",
 "固陋": "انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "固陋頑迷": "مُتَعَنِّت, عَنِيد",
 "国": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة. / مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى.",
 "国々": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "国じゅう": "جَمِيع أَنْحَاء, كُلّ",
 "国の母": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "国もと": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "国中": "جَمِيع أَنْحَاء, كُلّ",
 "国主": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "国人": "مَحَلِّيّ",
 "国会": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها)",
 "国会議事堂": "كَابِيتُول الوِلَايَات المُتَّحِدَة",
 "国会議員": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "国使": "مَبْعُوث, وَزِير مُفَوَّض",
 "国側": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "国債": "دَيْن سِيَادِيّ, دَيْن عَامّ (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "国債先物": "سند حكومي (سند يعتبر وثيقة دين على وزارة الخزانة الأمريكية؛ يعتبر الورقة المالية الأكثر أماناً في عالم الاستثمار)",
 "国債発行": "سند حكومي (سند يعتبر وثيقة دين على وزارة الخزانة الأمريكية؛ يعتبر الورقة المالية الأكثر أماناً في عالم الاستثمار)",
 "国元": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "国内": "مَنْزَلِيّ",
 "国内テロ": "إرهاب محلي (إرهاب يمارس في بلدك ضد شعبك)\nمثال: كان تفجير المبنى الفيدرالي في أوكلاهوما سيتي عام 1995 مثالاً على الإرهاب المحلي",
 "国内消費税": "ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "国内的": "داخلي (يحدث أو ينشأ أو يقع ضمن بعض الحدود أو خاصة السطح) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / دَاخِلِيّ, وَطَنِيّ (دَاخِلَ حُدُودِ البَلَدِ) / دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)\nمثال: أعضاء داخلية",
 "国内総生産": "نَاتِج مَحَلِّيّ إِجْمَالِيّ",
 "国内製": "مَنْزَلِيّ",
 "国処": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "国分": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国分寺": "مَدْعُوم حُكُومِيًّا (مدعوم ومُشغَّل من قِبَل حكومة الدولة)",
 "国務大臣": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء) / وزير في الحكومة (شخص عضو في مجلس الوزراء)",
 "国務省": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "国務長官": "وزير الخارجية (منصب رئيس وزارة الخارجية) / وزير الخارجية (وزير حكومي للعلاقات الخارجية) / وزير الخارجية (الشخص الذي يشغل منصب وزير وزارة الخارجية)\nمثال: تأسس منصب وزير الخارجية عام 1789",
 "国勢調査": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "国司": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国君": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "国営化": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تأميم (عملية إضفاء الطابع الوطني) / تَأْسِيس قَوْمِيّ, تَحَوُّل إِلَى أُمَّة (فعل تشكيل أو أن تصبح أمة)",
 "国国": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف",
 "国土": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "国土安全保障省": "وزارة الأمن الداخلي (الإدارة الفيدرالية التي تدير جميع المسائل المتعلقة بالأمن الداخلي)",
 "国土庁長官": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "国坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国堺": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "国境": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "国境地帯": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "国境線": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "国境警備兵": "حَرْس الْحُدُود (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "国境警備隊": "حرس الحدود (مجموعة من الضباط الذين يقومون بدوريات على حدود الدولة)",
 "国士": "وَطَنِيّ, وَطَنِيَّة",
 "国外": "فِي الْخَارِج, اِلَى الْخَارِج (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / فِي اَلْخَارِج (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "国外追放": "طَرْد",
 "国外退去": "طَرْد",
 "国外駐在": "مُغْتَرِب",
 "国字": "كَانَا",
 "国学": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "国安": "أَمْن وَطَنِيّ (وَثِقَ به وأرْكَنَ إليه)",
 "国定": "وَطَنِيّ, قَوْمِيّ",
 "国定公園": "حَدِيقَة وَطَنِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "国宝級": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "国家": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "国家の犬": "خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين))",
 "国家主席": "رَئِيس دَوْلَة",
 "国家主義": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "国家主義的": "قَوْمِيّ, نَزْعَة قَوْمِيَّة (إخلاص لمصالح أو ثقافة أمة معينة بما في ذلك تعزيز مصالحها) / شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "国家主義者": "قَوْمِيّ, قَوْمِيَّة",
 "国家元首": "رَئِيس دَوْلَة",
 "国家元首夫人": "السيدة الأولى (زوجة الرئيس التنفيذي) / سيدة أولى (المرأة الرائدة في فن أو مهنة)",
 "国家反逆罪": "خِيَانَة عُظْمَى",
 "国家存亡": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "国家安全保障会議": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية والعسكرية والأمن القومي؛ تشرف على وكالة الاستخبارات المركزية)",
 "国家安全保障局": "وكالة الأمن القومي (منظمة التشفير الأمريكية التي تنسق وتوجه الأنشطة عالية التخصص لحماية أنظمة المعلومات الأمريكية وإنتاج معلومات استخباراتية أجنبية)",
 "国家憲兵": "دَرَك, جَنْدَرْمَة (درك المطرُ وغيره:تَتَابَعَ كأنّه يدرك بعضه بعضاً؛ الدّرَك:التَّبِعَة وأقصى قَعْر الشّيء)",
 "国家指導者": "رجل دولة, قائد وطني (شخص يعد قائداً محترماً في الشؤون الوطنية أو الدولية)",
 "国家機密": "سِرّ دَوْلَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "国家的": "وَطَنِيّ, قَوْمِيّ",
 "国家社会主義": "اشتراكية الدولة (نظام اقتصادي تمتلك فيه الحكومة معظم وسائل الإنتاج ولكن يُسمح ببعض درجات الرأسمالية الخاصة) / نَازِيَّة",
 "国家総力戦": "الحَرْب الشَّامِلَة",
 "国家資本主義": "رأسمالية الدولة (نظام اقتصادي رأسمالي في المقام الأول ولكن مع وجود درجة من الملكية الحكومية لوسائل الإنتاج)",
 "国家転覆": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها) / إفساد, تخريب (تدمير أمانة شخص (أو مجموعة) أو ولائهم؛ تقويض النزاهة الأخلاقية)\nمثال: إفساد قاصر",
 "国岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国府": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "国庫債権": "سندات الخزانة (أداة دين بآجال استحقاق تبلغ 10 سنوات أو أكثر)",
 "国慶": "يَوْم وَطَنِيّ (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "国所": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "国手": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "国政": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "国政術": "حنكة سياسية (الحكمة في إدارة الشؤون العامة)",
 "国旗": "علم وطني (شعار يُرفع كرمز للجنسية)",
 "国有化": "تأميم (تحويل شيء ما من الملكية الخاصة أو السيطرة الخاصة إلى ملكية الدولة) / تأميم (عملية إضفاء الطابع الوطني) / تَأْسِيس قَوْمِيّ, تَحَوُّل إِلَى أُمَّة (فعل تشكيل أو أن تصبح أمة)",
 "国本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国枝": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国歌": "نَشِيد وَطَنِيّ\nمثال: イギリスに１７４５年以前に国歌がなかったという事実は、それ自体はほとんどたいしたことではない。 — ان حقيقة بريطانيا كانت لا تملك نشيداً وطنياً قبل ١٧٤٥ هي بحد ذاتها شأن يذكر.",
 "国母": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "国民": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / الحزب الديمقراطي (الأقدم من بين الحزبين السياسيين الرئيسيين في الولايات المتحدة)",
 "国民の祝日": "عُطْلَة رَسْمِيَّة, إِجَازَة عَامَّة",
 "国民党": "الكومينتانغ (الحزب السياسي الذي أسسه صن يات صن عام 1911؛ حكم الصين تحت قيادة شيانغ كاي شيك من عام 1928 حتى عام 1949 عندما تولى الشيوعيون السلطة وأصبح فيما بعد…)",
 "国民兵": "رجل ميليشيا (عضو ذكر في الميليشيا؛ يخدم فقط أثناء الطوارئ)",
 "国民国家": "دَوْلَة قَوْمِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "国民学校": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "国民所得": "دخل قومي (القيمة الإجمالية لجميع الدخل في أمة (الأجور والأرباح والفوائد والإيجارات ومدفوعات المعاشات التقاعدية) خلال فترة معينة (عادة سنة واحدة))",
 "国民投票": "اِسْتِفْتاء (طلب رأي أو حكم من جهة مختصة في قضية أو أمر معين؛ سؤال أو أكثر يوجه إلى عدد من الناس للإجابة عنه لمعرفة آرائهم أو موافقتهم حول أمر معيّن)",
 "国民民主党": "الحزب الديمقراطي (الأقدم من بين الحزبين السياسيين الرئيسيين في الولايات المتحدة)",
 "国民的": "وَطَنِيّ, قَوْمِيّ",
 "国民社会主義": "نَازِيَّة",
 "国民純福祉": "الشَّمَال الشَّمَالِيّ الغَرْبِيّ, شَمَال شَمَال غَرْب (نقطة البوصلة التي تقع في منتصف المسافة بين الشمال والشمال الغربي)",
 "国民総生産": "مقاييس الدخل والإنتاج القومي",
 "国民議会": "الْجَمْعِيَّةُ الْوَطَنِيَّة",
 "国民食": "طعام الراحة, طعام المواساة (طعام يتم إعداده ببساطة ويمنح شعوراً بالرفاهية؛ عادة ما يحتوي على نسبة عالية من السكر أو الكربوهيدرات ويرتبط بالطفولة أو الطهي المنزلي)",
 "国法": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)",
 "国満": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "国王": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / تَاج, إِكْلِيل",
 "国王殺し": "قتل الملك (فعل قتل الملك) / قاتل الملك (شخص يرتكب جريمة قتل الملك)",
 "国王殺害": "قتل الملك (فعل قتل الملك) / قاتل الملك (شخص يرتكب جريمة قتل الملك)",
 "国璽": "الختم العظيم (الختم الرئيسي للحكومة، يرمز للسلطة أو السيادة)",
 "国産": "مَنْزَلِيّ",
 "国界": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "国立": "وَطَنِيّ, قَوْمِيّ",
 "国立公園": "حَدِيقَة وَطَنِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "国立医薬品食品衛生研究所": "المعاهد الوطنية للصحة (وكالة في وزارة الصحة والخدمات الإنسانية مهمتها توظيف العلم في السعي وراء المعرفة لتحسين صحة الإنسان؛ وهي الوكالة الرئيسية للبحوث الطبية الحيوية…)",
 "国立銀行": "بنك وطني (بنك تجاري مرخص من قبل الحكومة الفيدرالية)",
 "国章": "شِعَار وَطَنِيّ (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "国籍": "جِنْسِيَّة (مؤنث الجنسي، المنتسبة إلى الجنس؛ حالة الجنس أو ماهيته)\nمثال: لديه الجنسية الأوكرانية.",
 "国籍不明": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى) / مَجْهُول الهُوِيَّة (لم تُحدَّد هويته بعد)",
 "国籍取得": "تعريب, توطين (تغيير نطق كلمة مستعارة لتتوافق مع صوتيات المقترضين) / أقلمة, توطين (إدخال الحيوانات أو النباتات إلى أماكن تزدهر فيها ولكنها ليست موطناً أصلياً لها) / تجنيس (الإجراء الذي يتم بموجبه منح الأجنبي الجنسية) / تَأَقْلُم, تَطْبِيع (صفة الجلب إلى التوافق مع الطبيعة)\nمثال: توطين العديد من الكلمات الإيطالية في اللغة الإنجليزية",
 "国籍喪失": "نزوح, هجرة خارجية (الهجرة من مكان (خاصة الهجرة من بلدك الأصلي للاستقرار في بلد آخر)) / تغريب, نفي (فعل طرد شخص من وطنه)\nمثال: الرجال في المنفى يحلمون بالأمل",
 "国籍旗": "مِشْوَال, رَافِعَة / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)",
 "国粋主義": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "国粋的": "قَوْمِيّ, نَزْعَة قَوْمِيَّة (إخلاص لمصالح أو ثقافة أمة معينة بما في ذلك تعزيز مصالحها) / شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "国者": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "国言葉": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا) / لغة دارجة (الكلام اليومي للناس (تمييزاً عن اللغة الأدبية)) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "国許": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "国詞": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا) / لغة دارجة (الكلام اليومي للناس (تمييزاً عن اللغة الأدبية)) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "国語": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون) / لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "国語教育": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
