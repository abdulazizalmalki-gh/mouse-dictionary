 "売り手市場": "سوق البائعين (سوق يكون فيه عدد الأشخاص الذين يريدون الشراء أكثر ممن يريدون البيع)",
 "売り捌き": "بَيْع, بُيُوع / مَهَارَة البَيْع, مَهَارَات البَيْع",
 "売り掛け債権": "حِسَاب مَدِين (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "売り掛け勘定": "حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "売り文句": "خِطَاب الْبَيْع, عَرْض تَرْوِيجِيّ (ترويج عن طريق الحجة والبرهان)",
 "売り方": "بَائِع, بَائِعَة",
 "売り時": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "売り歩く": "صَقْر, بَاز",
 "売り渡し": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "売り渡し証": "سند بيع, فاتورة بيع (صك ينقل الممتلكات الشخصية)",
 "売り渡し証書": "سند بيع, فاتورة بيع (صك ينقل الممتلكات الشخصية)",
 "売り物": "قُرْبَان / اِخْتِصَاص, تَخَصُّص / لِلبَيع",
 "売り物にする": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "売り玉": "حساب البيع على المكشوف (مجموع المبيعات القصيرة في سوق مفتوحة) / حساب بيع على المكشوف (حساب وساطة لشخص يبيع على المكشوف (يبيع أوراقاً مالية لا يملكها))",
 "売り繋ぎ": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً) / تحوط (أي تقنية مصممة لتقليل أو القضاء على المخاطر المالية؛ على سبيل المثال، اتخاذ موقفين يعوض كل منهما الآخر إذا تغيرت الأسعار)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "売り薬": "دواء مسجل براءة اختراع (دواء محمي ببراءة اختراع ومتاح بدون وصفة طبية من الطبيب)",
 "売り言葉に買い言葉": "وَاحِدَة بِوَاحِدَة (مكافئ يُعطى في المقابل)",
 "売り買い": "تِجَارَة",
 "売り込み": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "売り込む": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "売り高": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "売る": "بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله. / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "売るほど": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "売れっ子": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "売れる": "بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "売れ口": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "売れ残り": "الْبَقَايَا / عَانِس",
 "売れ行き": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "売れ足": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "売れ高": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
