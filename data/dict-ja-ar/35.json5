 "坊ん様": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "坊主": "قَصَّة قَصِيرَة جِدّاً (قصة شعر قصيرة جداً؛ عادة للرجال أو الأولاد) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "坊主くさい": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "坊主臭い": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "坊様": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "坊野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "坊間": "جَمِيع أَنْحَاء, كُلّ",
 "坎": "كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / حُفْرَة",
 "坎為水": "كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "坐す": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "坐すかり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "坐すがり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "坐する": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "坐そかり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "坐そがり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "坐り": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة / اِسْتِقْرَار",
 "坐作進退": "تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "坐剤": "تَحْمِيلَة, لَبُوس",
 "坐洲": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "坐薬": "تَحْمِيلَة, لَبُوس",
 "坐骨": "إسك, عظم الإسك (أحد الأقسام الثلاثة لعظم الورك؛ يقع أسفل الحرقفة)",
 "坐骨神経": "عصب النسا",
 "坐骨神経痛": "عِرْق النَّسَا, النَّسَا (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "坑": "حُفْرَة",
 "坑井": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "坑口": "رأس البئر, مدخل المنجم (مدخل منجم الفحم)",
 "坑夫": "عامل منجم (عامل يعمل في منجم)",
 "坑道": "نَفَق",
 "坤": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة)",
 "坤輿": "تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "坦々": "مُسْتَوًى / مَرْحَلَة / خالٍ من الأحداث, رتيب (يتميز بعدم وجود أحداث جديرة بالملاحظة أو هامة)\nمثال: حياة خالية من الأحداث",
 "坦坦": "مُسْتَوًى / مَرْحَلَة / خالٍ من الأحداث, رتيب (يتميز بعدم وجود أحداث جديرة بالملاحظة أو هامة)\nمثال: حياة خالية من الأحداث",
 "坦懐": "صراحة (سمة كون المرء صريحاً ومباشراً) / صدق, صراحة (صفة كون الشخص صادقاً ومباشراً في الموقف والكلام)",
 "坩堝": "بُوتَقة / مِحْنَة, اِخْتِبَار قَاسٍ / قِدْر صَهْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "坩堝炉": "فرن البوتقة (فرن لتسخين شحنة المعدن الموجودة في بوتقات حرارية)",
 "坪庭": "فِنَاء, حَوْش",
 "坪数": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "坪木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "垂": "صَلْصَة, مَرَق / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / شجرة النير, نير (أي من الأشجار أو الشجيرات المتعددة من جنس النير)",
 "垂げ": "إنزال, خفْض (عملية التسبب في تحرك شيء ما إلى مستوى أدنى) / تنزيل, خفض (عملية التسبب في أن يصبح الشيء أقل) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد) / إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين / نُكْتَة",
 "垂づ": "عَلَّقَ / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)",
 "垂らし": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً",
 "垂らす": "رَاوَغ / عَلَّقَ",
 "垂れ": "صَلْصَة, مَرَق / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "垂れる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر. / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "垂れ下がる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "垂れ下げる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "垂れ幕": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "垂れ流し": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ) / إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج)",
 "垂れ流す": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج المدينة توضع فيه الأزبال والنفايات)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "垂れ絹": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "垂れ耳": "مُتَدَلِّي الأُذُنَيْن (له أذنان مُنحنيتان أو متدلّيتان)",
 "垂れ込み": "رمية البداية (فعل بدء لعبة كرة السلة بكرة قفز) / إخبارية, معلومة سرية (معلومات داخلية بأن شيئاً ما سيحدث)",
 "垂れ込む": "بَلَّغَ, أَبْلَغَ",
 "垂れ飾り": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "垂んとす": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "垂んとする": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "垂乳女": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "垂乳根": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "垂井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "垂幕": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "垂教": "مَعْلُومَات, مَعْلُومَة",
 "垂木": "رافدة سقف (واحدة من عدة عوارض مائلة متوازية تدعم السقف) / راكب الطوافة (شخص يسافر بواسطة طوافة (رمث))",
 "垂柳": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "垂楊": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "垂水": "شَلَّال",
 "垂涎": "تَوْق, تَشَوُّق / أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "垂準": "مِطْمَار, مِطْمَر",
 "垂直": "عَمُودِيّ / رَأْسِيّ / عَمُودِيّ, رَأْسِيّ",
 "垂直圏": "دائرة راسية (دائرة عظمى على الكرة السماوية تمر عبر السمت وتكون عمودية على الأفق)",
 "垂直尾翼": "زعنفة ذيلية (ذيل الأسماك وبعض الفقاريات المائية الأخرى) / زعنفة السيارة (واحدة من زوج من الزينات البارزة فوق الرفارف الخلفية للسيارة) / زعنفة الذيل, مثبت عمودي (مثبت يعد جزءاً من هيكل الذيل العمودي للطائرة)",
 "垂直的統合": "تكامل رأسي (الاستيعاب في شركة واحدة لعدة شركات تعمل في جميع جوانب تصنيع المنتج من المواد الخام إلى التوزيع)",
 "垂直統合": "تكامل رأسي (الاستيعاب في شركة واحدة لعدة شركات تعمل في جميع جوانب تصنيع المنتج من المواد الخام إلى التوزيع)",
 "垂示": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "垂耳": "مُتَدَلِّي الأُذُنَيْن (له أذنان مُنحنيتان أو متدلّيتان)",
 "垂訓": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "型": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر. / قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن. / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "型どおり": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "型にはめる": "صُورَة نَمَطِيَّة",
 "型に嵌める": "صُورَة نَمَطِيَّة",
 "型付け": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "型式": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "型抜き": "قطاعة البسكويت (أداة مطبخ تستخدم لقطع ورقة من عجين البسكويت إلى الأشكال المطلوبة قبل الخبز)",
 "型押し": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "型持ち": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة)",
 "型枠": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب)",
 "型破り": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "型紙": "رَوْسَم",
 "型落ち": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "型通り": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "垢": "تُرْبَة, تُرَاب / بُقْعَة, قَذَارَة",
 "垢抜け": "تَكْرِير",
 "垢膩": "قَذَارَة",
 "垣": "سُور / سِيَاج / حَاجِز / عَقَبَة, حَاجِز",
 "垣内": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "垣根": "وَشِيع, سِيَاج نَبَاتِيّ / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "垣牆": "وَشِيع, سِيَاج نَبَاتِيّ",
 "垣間": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "垤": "مَسْكَن نَمْل (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "垰": "ممر, ممر جبلي (موقع في سلسلة جبال لتكوين جيولوجي يكون أقل ارتفاعاً من القمم المحيطة)",
 "垳": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)",
 "埃": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة. / مِصْر, مصر (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "埃くさい": "بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً) / مُتَرِّب, مُغْبَرّ (مغطى بطبقة من الغبار)",
 "埃っぽい": "بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً) / مُتَرِّب, مُغْبَرّ (مغطى بطبقة من الغبار)",
 "埃よけ": "غطاء الغبار (غطاء واقٍ بلاستيكي قابل للإزالة لقطعة من المعدات) / غطاء غبار (قطعة كبيرة من القماش تستخدم لتغطية الأثاث الذي لا يستخدم لفترة طويلة) / غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)",
 "埃臭い": "بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً) / مُتَرِّب, مُغْبَرّ (مغطى بطبقة من الغبار)",
 "埃除け": "غطاء الغبار (غطاء واقٍ بلاستيكي قابل للإزالة لقطعة من المعدات) / غطاء غبار (قطعة كبيرة من القماش تستخدم لتغطية الأثاث الذي لا يستخدم لفترة طويلة) / غلاف الكتاب الورقي (غلاف ورقي للكتاب؛ غلاف تطبع عليه عادة معلومات ترويجية)",
 "埋ける": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته. / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف.",
 "埋け込む": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "埋まる": "فَيَضَان / فَاضَ",
 "埋めもどし": "إعادة دفن (فعل الدفن مرة أخرى)",
 "埋めもどす": "عبوة إعادة تعبئة, غيار (منتج تجاري يملأ حاوية بمحتوياتها المناسبة) / إعادة صرف, تجديد وصفة (دواء بوصفة طبية يتم توفيره مرة أخرى)\nمثال: حصل على عبوة حبر لقلمه الجاف",
 "埋める": "غِطَاء / غِلَاف / غَطَّى / مَلَأَ / دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته. / مَلَأَ / قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / غِطَاء / غِلَاف / غَطَّى",
 "埋め合わす": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "埋め合わせ": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "埋め合わせる": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "埋め尽くす": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "埋め戻し": "إعادة دفن (فعل الدفن مرة أخرى)",
 "埋め戻す": "عبوة إعادة تعبئة, غيار (منتج تجاري يملأ حاوية بمحتوياتها المناسبة) / إعادة صرف, تجديد وصفة (دواء بوصفة طبية يتم توفيره مرة أخرى)\nمثال: حصل على عبوة حبر لقلمه الجاف",
 "埋め立て": "مَرْدَم",
 "埋め立てる": "مَلَأَ",
 "埋め草": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "埋め込": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "埋め込み": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "埋め込む": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "埋もれ木": "تِين, بَلَس",
 "埋れ木": "تِين, بَلَس",
 "埋伏": "ارتطام, اصطدام (اصطدام حاد ناتج عن الضرب أو الاندفاع ضد شيء ما) / انحشار السن, سن منطمر (اضطراب يكون فيه السن مزدحماً جداً في تجويفه بحيث لا يمكنه البزوغ بشكل طبيعي) / انحشار البراز (اضطراب ينحشر فيه البراز في القولون السفلي) / انحشار, انضغاط (حالة الانضغاط والالتصاق الوثيق والثبات بقوة)",
 "埋伏歯": "انحشار السن, سن منطمر (اضطراب يكون فيه السن مزدحماً جداً في تجويفه بحيث لا يمكنه البزوغ بشكل طبيعي)",
 "埋却": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "埋戻し": "إعادة دفن (فعل الدفن مرة أخرى)",
 "埋戻す": "عبوة إعادة تعبئة, غيار (منتج تجاري يملأ حاوية بمحتوياتها المناسبة) / إعادة صرف, تجديد وصفة (دواء بوصفة طبية يتم توفيره مرة أخرى)\nمثال: حصل على عبوة حبر لقلمه الجاف",
 "埋没原価": "تَكْلِفَة غارِقَة",
 "埋没毛": "شعر غائر (شعرة لا تخرج من الجريب ولكنها تظل مغروسة في الجلد (مما يسبب عادة التهاباً))",
 "埋没費用": "تَكْلِفَة غارِقَة",
 "埋芻": "سيلاج, علف مخمر (علف يتم حصاده وهو أخضر ويحفظ رطباً عن طريق التخمير الجزئي كما في الصومعة)",
 "埋草": "سيلاج, علف مخمر (علف يتم حصاده وهو أخضر ويحفظ رطباً عن طريق التخمير الجزئي كما في الصومعة)",
 "埋葬": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "埋葬地": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "埋蔵": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة) / موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "埋蔵物": "كنز مكتشف (أي مجموعة من الأشياء الثمينة التي يتم اكتشافها) / كنز دفين (كنز مجهول المالك وجد مخبأ (عادة في الأرض))\nمثال: كان كتابها كنزاً من الأفكار الجديدة",
 "埋蔵量": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "埋設": "دفن (إخفاء شيء تحت الأرض)",
 "埋込": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "埋込み": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "城": "قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "城下の盟": "اِسْتِسْلَام",
 "城下の盟い": "اِسْتِسْلَام",
 "城主": "حَاكِم قَلْعَة, حَاكِم قِلْعَة (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)",
 "城之内": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "城代": "حاجب, رئيس التشريفات (ضابط يدير منزل ملك أو نبيل) / أمين خزانة البلدية (أمين صندوق مؤسسة بلدية)",
 "城南": "سْيُونْغْنَام",
 "城塁": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "城塞": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "城壁": "مِتْرَاس",
 "城島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "城平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "城府": "مَدِينَة, قَرْيَة",
 "城戸": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "城田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "城砦": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "城郭": "قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "城野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "埒": "حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "埒もない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "埒も無い": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "埒外": "خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "埓": "حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "埓もない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "埓も無い": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "埜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "埜口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "域": "مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "埠頭": "رَصِيف",
 "埤益": "فَائِدَة, جَدْوَى",
 "埴": "طِين, صَلْصَال",
 "埴原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "埴土": "طِين, صَلْصَال",
 "埴猪口": "شخص غير ماهر, عامل غير مدرب (شخص يفتقر إلى التدريب الفني)",
 "埴生の宿": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "執": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "執よう": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "執り成し": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "執り成す": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "執り行う": "مَسَكَ, مسك",
 "執り行なう": "مَسَكَ, مسك",
 "執る": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "執事": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / مندوب عمالي (عضو نقابة يُنتخب لتمثيل زملائه العمال في التفاوض مع الإدارة) / ناظر, وكيل (شخص يدير الممتلكات أو الشؤون الأخرى لشخص آخر) / مضيف, مضيف طيران (مرافق على متن طائرة) / شَمَّاس",
 "執刀医": "جَرَّاح, جَرَّاحَة",
 "執務": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "執務室": "مَهَمَّة",
 "執心": "تَفَرُّغ / معشوق, مفتون به (موضوع لشغف مفرط وقصير الأمد) / افتتان, ولع (شغف أو حب أو إعجاب أحمق وعادة ما يكون مفرطاً) / إعجاب عابر, حب المراهقة (حب مؤقت لمراهق)",
 "執念": "إصرار, دأب (تصميم مستمر)",
 "執念い": "عَنِيد",
 "執念深い": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ",
 "執拗": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "執拗い": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / مُتَطَلِّب, مُلِحّ (يَسْتَدْعِي الانْتِبَاهَ فَوْرًا) / دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "執政": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / قُنْصُل",
 "執政官": "قُنْصُل",
 "執着": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "執着心": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "執筆": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "執筆者": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "執行": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "執行人": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية.",
 "執行吏": "مَأْمُور",
 "執行官": "شَرِيف",
 "執行役": "ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "執行猶予": "وقف تنفيذ الحكم (أمر يمنع تنفيذ الحكم لفترة زمنية محددة)",
 "執行者": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية. / إِجْرَائِيّ",
 "執行部": "إِجْرَائِيّ",
 "執達吏": "مَأْمُور",
 "培う": "بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "培地": "وسط استنبات, وسط زرع ((علم الجراثيم) مادة مغذية (صلبة أو سائلة) تستخدم لزراعة الكائنات الحية الدقيقة)",
 "培植": "تَهْذِيب",
 "培殖": "تَهْذِيب",
 "培養": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة. / تَهْذِيب",
 "培養土": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "培養基": "مُتَوَسِّط",
 "培養士": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "培養液": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "基": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جَذْريّ / رَادِيكَالِيّ",
 "基く": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "基づく": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
