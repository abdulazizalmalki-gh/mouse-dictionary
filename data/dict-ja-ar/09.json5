 "びよう": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / تَجْمِيل",
 "びよういん": "صَالُون تَجْمِيل, مَحَلّ تَجْمِيل (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "びようえき": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "びようし": "مُزَيِّن, كْوَافِير",
 "びようしつ": "صَالُون تَجْمِيل, مَحَلّ تَجْمِيل (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "びようしょ": "صَالُون تَجْمِيل, مَحَلّ تَجْمِيل (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "びようせいけいげか": "جِرَاحَةْ تَجْمِيل",
 "びようてん": "صَالُون تَجْمِيل, مَحَلّ تَجْمِيل (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "びよく": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "びら": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "びらん": "مُوجِع, مُؤْلِم / سَعْفَة / فَسَاد",
 "びり": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "びりけつ": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "びりっと": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "びりびり": "فَوْقَ, فَوْق / لِأَعْلَى / اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "びりゅう": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث)) / جُسَيْم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "びれい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "びろう": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "びろく": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "びわ": "بَشْمَلَة, أَسْكِيدُنْيَا",
 "びん": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "びんいり": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "びんかん": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "びんぎ": "مُلَاءَمَة, مُنَاسَبَة",
 "びんぎゅう": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "びんさつ": "تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "びんしょう": "رَشِيق, خَفِيف اَلْحَرَكَة / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "びんせん": "قِرْطَاسِيَّة",
 "びんぜん": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "びんそく": "نَشَاط",
 "びんた": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "びんつけ": "مَرْهَم, بُومَادَة",
 "びんつけあぶら": "مَرْهَم, بُومَادَة",
 "びんづめ": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "びんびん": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "びんべん": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "びんぼう": "فَقِير / مِسْكِين / فُقَرَاء",
 "びんぼうくさい": "بَالٍ",
 "びんぼうくじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "びんぼうにん": "فَقِير / مِسْكِين / فُقَرَاء",
 "びんぼうゆすり": "تَمَلْمَلَ",
