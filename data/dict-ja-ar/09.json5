 "すっぽかす": "أَهْمَلَ",
 "すっぽぬける": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "すっぽり": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب",
 "すっぽん": "سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة) / باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف) / مضخة الآسن (مضخة لإزالة مياه الآسن (المياه المتجمعة في قاع السفينة))",
 "すっぽんたけ": "فطر القرن النتن الشائع (فطر شائع كان يستخدم سابقاً في تحضير مرهم للروماتيزم)",
 "すっぽんぽん": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "すっぽ抜ける": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "すっ裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "すっ飛ばす": "سُرْعَة",
 "すっ飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / اِحْتَجَبَ, إخْتَفَى (وضع أمامه حجابا فلم يُعَد يُرى؛ وضع له حاجبا)",
 "すつ": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا! / تَنَازَلَ",
 "すていし": "تَضْحِيَة, قُرْبَان",
 "すていん": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "すてうり": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "すておく": "تَجَاهَلَ, طَنَّش",
 "すてき": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً)",
 "すてご": "لَقِيط, مَلْقُوط",
 "すてごま": "تَضْحِيَة, قُرْبَان",
 "すてさる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "すてば": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "すてばち": "يَائِس, قَانِط",
 "すてふだ": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / لَوْحَة إِعْلَانَات",
 "すてみ": "تمثيل انفعالي, تنفيس حركي ((طب نفسي) عرض المشاعر المكبوتة سابقاً (غالباً في أفعال بدلاً من كلمات)؛ يعتبر…)",
 "すてる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا! / تَنَازَلَ / تَضْحِيَة, قُرْبَان",
 "すてるかみあればひろうかみあり": "هُنَاك, يُوجَد",
 "すで": "بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "すでで": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه)",
 "すでに": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا. / قَبْلًا, قَبْل / بلا ريب, مما لا يمكن إنكاره (إلى درجة لا يمكن إنكارها أو بطريقة لا تقبل الإنكار)\nمثال: هي بلا ريب الطالبة الأكثر موهبة في الصف",
 "すでにして": "في غضون ذلك, في هذه الأثناء (خلال الوقت الفاصل)\nمثال: في غضون ذلك لن أفكر في المشكلة",
 "すでのこと": "تَقْرِيبًا, عَلَى وَشْك",
 "すどうふ": "مُنَصِّبٌ نَفْسَهُ (يصف نفسه بصفة ما دون تأييد من الآخرين)",
 "すどおし": "شَفَّاف",
 "すどり": "دجاجة حاضنة, دجاجة راقدة (دجاجة منزلية مستعدة للرقاد على البيض)",
 "すな": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل. / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "すなあらし": "عَاصِفَة رَمْلِيَّة / ضَوْضَاء, ضَجِيج",
 "すないろ": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل.",
 "すなお": "مُطِيع, مُذْعِن / نَزِيه, صَادِق\nمثال: 思っていることを素直に言うのは悪いことではありません。 — قول ما تفكر فيه بصراحة ليس أمرًا سيئًا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم. / مِعْيَارِيّ",
 "すなかぶり": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "すなかぶりせき": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "すながみ": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "すなぎも": "قَانِصَة",
 "すなけしゴム": "ممحاة حبر (ممحاة تزيل علامات الحبر)",
 "すなご": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في…) / رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة…)\nمثال: وصلت شاحنة الرمل.",
 "すなどけい": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "すなどり": "صَيْد سَمَك, صَيْد / صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "すなどりねこ": "قِطّ صَيَّاد السَمَك, قِطّ سَمَاك (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "すなどる": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "すなねこ": "قط الرمال (قط بري صحراوي)",
 "すなのみ": "برغوث الرمل, شيغوة (برغوث استوائي صغير؛ تحفر الأنثى المخصبة تحت جلد العائل بما في ذلك البشر)",
 "すなはら": "صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة…)\nمثال: عاد إلى الصحراء.",
 "すなば": "صندوق الرمل (لعبة تتكون من كومة من الرمل أو صندوق مملوء بالرمل ليلعب فيه الأطفال)",
 "すなばち": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق…) / تنسيق الزهور (ترتيب زخرفي للزهور)",
 "すなふき": "تيار رملي, سفح رملي (هبة رياح محملة بالرمال)",
 "すなぶくろ": "كيس رمل (كيس مملوء بالرمل؛ يستخدم كسلاح أو لبناء الجدران أو كثقل موازن) / قَانِصَة",
 "すなぼこり": "سيروكو, عاصفة رملية (عاصفة ريحية ترفع سحباً من الغبار أو الرمل)\nمثال: كانت نوعاً من العواصف الغبارية لم نشهده منذ سنوات",
 "すなやま": "كَثِيب, غُرْد",
 "すなわち": "يَعْنِي, أَي / بِدِقَّة / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "すなをかむよう": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي)",
 "すね": "قَصَبَة",
 "すねあて": "واقي ساق (ملابس واقية صلبة يرتديها لاعبو الهوكي أو الماسك في البيسبول لحماية السيقان) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية)",
 "すねかじり": "طُفَيْلِيّ, عالَة (تابع يلتصق بمضيف (دون فائدة للمضيف) أملاً في الكسب أو الميزة)",
 "すねにく": "عُرْقُوب",
 "すねもの": "كَلْبِيّ",
 "すねる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "すね当て": "واقي ساق (ملابس واقية صلبة يرتديها لاعبو الهوكي أو الماسك في البيسبول لحماية السيقان) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية)",
 "すね肉": "عُرْقُوب",
 "すのこ": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "すはだか": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "すはだし": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله)\nمثال: وقف على حافة الجرف.",
 "すはまそう": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة)",
 "すばこ": "بيت الطيور (مأوى للطيور) / خَلِيَّة, قَفِير",
 "すばしこい": "سَرِيع\nمثال: ينبح كلب في الحي. / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "すばしっこい": "سَرِيع\nمثال: ينبح كلب في الحي. / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "すばやい": "سَرِيع\nمثال: ينبح كلب في الحي.",
 "すばらしい": "عَجِيب / فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة)",
 "すばらしき": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "すばらしさ": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد…)\nمثال: المجد لأوكرانيا",
 "すばる": "الثُّرَيَّا",
 "すばるぼし": "الثُّرَيَّا",
 "すぱっと": "تَمَامًا / بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب",
 "すぱり": "تَمَامًا / بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب",
 "すひな": "فَرْخ",
 "すびき": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "すびな": "فَرْخ",
 "すべ": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "すべあわせる": "اِتَّحَدَ, أَلَّفَ",
 "すべからく": "مطلقا, على الإطلاق / كُلّ, جَمِيع",
 "すべく": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب) / وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "すべすべ": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "すべた": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "すべて": "كُلّ شَيْء / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "すべてにおいて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "すべてのみちはローマにつうず": "كُلُّ الطُّرُقِ تُؤَدِّي إِلَى رُومَا",
 "すべての道はローマに通ず": "كُلُّ الطُّرُقِ تُؤَدِّي إِلَى رُومَا",
 "すべなし": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "すべら": "إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "すべらか": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "すべらす": "اِنْزَلَقَ, تَزَحْلَقَ",
 "すべらせる": "اِنْزَلَقَ, تَزَحْلَقَ",
 "すべり": "اِنْسِيَابِيّ, مُنْزَلِق (يتحرّك بحركة سلسة ومستمرة) / اِنْزَلَقَ, تَزَحْلَقَ",
 "すべりこみ": "اِنْسِيَابِيّ, مُنْزَلِق (يتحرّك بحركة سلسة ومستمرة)",
 "すべりじゃく": "مِسْطَرَة حَاسِبَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة.",
 "すべりだい": "اِنْزَلَقَ, تَزَحْلَقَ / مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو…)",
 "すべりだし": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "すべりだす": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "すべりでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "すべりひゆ": "رِجْل, فَرْفَحِين (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "すべりめ": "غرزة لقط, غرزة مخفية (غرزة فضفاضة تلتقط خيطاً أو خيطين فقط من القماش؛ مصممة لتكون غير مرئية من الجانب…)",
 "すべりやすい": "دُهْنِيّ",
 "すべり台": "اِنْزَلَقَ, تَزَحْلَقَ / مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو…)",
 "すべる": "اِنْزَلَقَ, تَزَحْلَقَ / اِنْزَلَقَ / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض. / فَقَدَ\nمثال: خسر توم وظيفته. / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / اِتَّحَدَ, أَلَّفَ",
 "すぼまる": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "すぼむ": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "すぼめる": "أَغْلَقَ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "すぼらしい": "بَخْس, تَافِه (ضئيل المقدار بشكل يبعث على الازدراء)",
 "すぽっと": "بإحكام (بشكل ملائم تماماً (للملابس))\nمثال: ناسقت السترة بإحكام / بُوب, مُوسِيقَى شَعْبِيَّة",
 "すぽり": "بإحكام (بشكل ملائم تماماً (للملابس))\nمثال: ناسقت السترة بإحكام / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "すぽん": "بإحكام (بشكل ملائم تماماً (للملابس))\nمثال: ناسقت السترة بإحكام / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "すま": "زَاوِيَة, رُكْن",
 "すまい": "سُومُو / مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن / مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "すまいて": "سَاكِن, سَاكِنَة",
 "すまいとり": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "すまいびと": "مصارع (مقاتل يحاول طرح الخصم أرضاً)",
