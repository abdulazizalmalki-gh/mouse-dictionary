 "せきたんかりょくはつでんしょ": "يَعْمَل بِالفَحْم (يُشغَّل بحرق الفحم)",
 "せきたんがら": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "せきたんさん": "فِينُول, أَسْفَنِيك / فِينُول",
 "せきたんさんじゅし": "راتنج فينولي (راتنج متصلب بالحرارة)",
 "せきたんのそう": "طبقة فحم, عرق فحم (طبقة من الفحم)",
 "せきたんばい": "رماد متطاير",
 "せきたんガス": "غاز الفحم (خليط غازي ينتج عن تقطير الفحم القاري ويستخدم للتدفئة والإضاءة)",
 "せきたんガラ": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "せきちく": "قرنفل صيني, قرنفل قوس قزح (قرنفل صيني بزهور وردية ليلكية مسننة بعمق مع عين أرجوانية؛ يزرع عادة كنبات سنوي)",
 "せきちゅう": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره",
 "せきちゅうかん": "قناة شوكية, قناة فقرية (القناة في الفقرات المتعاقبة التي يمر عبرها الحبل الشوكي)",
 "せきちゅうかんきょうさくしょう": "قناة شوكية, قناة فقرية (القناة في الفقرات المتعاقبة التي يمر عبرها الحبل الشوكي)",
 "せきちゅうこうわんしょう": "حُدَاب",
 "せきちゅうぜんわんしょう": "قَعَس",
 "せきちゅうそくわんしょう": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "せきちん": "سُرْعَة التَّثَفُّل, مُعَدَّل تَثَفُّل كُرَيَات الدَّم الحَمْرَاء (المعدل الذي تترسب به خلايا الدم الحمراء في أنبوب دم تحت ظروف قياسية؛ يشير المعدل المرتفع عادة إلى وجود التهاب)",
 "せきつい": "عَمُود فَقْرِيّ / فَقَرَة",
 "せきついえん": "التهاب الفقار (التهاب مفصل فقري؛ يتميز بالألم والتصلب)",
 "せきついこつ": "فَقَرَة",
 "せきついそくわんしょう": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "せきついどうぶつ": "فَقَارِيّ, فَقَارِيَّة",
 "せきついはかい": "السنسنة المشقوقة, الصلب المشقوق (عيب خلقي غير نادر تتشوه فيه فقرة؛ ما لم تتأثر عدة فقرات أو يكون هناك قيلة نخاعية سحائية، تكون الأعراض قليلة؛ يمكن تشخيصه عن طريق بزل السلى)",
 "せきついますい": "تخدير شوكي, تخدير نصفي (تخدير النصف السفلي من الجسم؛ ناتج عن إصابة الحبل الشوكي أو عن طريق حقن مخدر تحت الغشاء العنكبوتي المحيط بالحبل الشوكي)",
 "せきついカリエス": "داء بوت (سل العمود الفقري مع تدمير الفقرات مما يؤدي إلى انحناء العمود الفقري)",
 "せきてい": "حديقة صخرية (حديقة تتميز بالصخور؛ وعادة النباتات الألبية) / قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "せきてっこう": "حَجَر الدَّم, شَاذَنْج (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "せきとう": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "せきとく": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "せきとした": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "せきとして": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "せきとめる": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "せきどう": "خَطُّ الاِسْتِوَاء (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "せきどうけいしゃかく": "تضليل, خداع (صفة كون الشيء أو الشخص مخادعًا) / تلازم غير متزامن, ميلان رأس الجنين (ظهور رأس الجنين أثناء المخاض بزاوية غير طبيعية)",
 "せきどうこう": "كوبريت (معدن يتكون من أكسيد النحاسوز وهو مصدر للنحاس)",
 "せきどうむふうたい": "ركود استوائي (حزام من الهدوء والرياح الخفيفة بين الرياح التجارية الشمالية والجنوبية في المحيط الأطلسي والهادئ) / جمود, ركود (حالة من الخمول (في الأعمال التجارية أو الفن وما إلى ذلك))\nمثال: النمو الاقتصادي الأقل من 1% سنوياً يعتبر ركوداً اقتصادياً",
 "せきどうギニア": "غِينِيَا اَلاِسْتِوَائِيَّة",
 "せきどうギニアきょうわこく": "جُمْهُورِيَّة غِينِيَا الاِسْتِوَائِيَّة",
 "せきどめ": "أَدْوِيَةُ السُعَال",
 "せきにん": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب. / عائق, عبء (صفة كون الشيء معيقًا) / التزام مالي, دين (التزام بدفع المال لطرف آخر) / التزام, مسؤولية (حالة الالتزام والمسؤولية القانونية)",
 "せきにんかん": "شعور بالمسؤولية (وعي بالتزاماتك)",
 "せきにんしゃ": "مُشْرِف, مُشْرِفَة",
 "せきにんついせき": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "せきにんほけん": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "せきにんをもって": "بمسؤولية (بطريقة مسؤولة)\nمثال: يجب أن نتصرف بمسؤولية",
 "せきねつ": "احمرار, توهج (حرارة أو لون النار)",
 "せきねん": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة / عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة) / أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "せきのうゆ": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "せきばく": "وَحِيد, مُوحِش",
 "せきばらい": "كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "せきばん": "آلة طباعة حجرية (ناسخة تطبع بالطباعة الحجرية؛ حيث يعالج سطح مستو (من الحجر أو المعدن) لامتصاص الحبر أو صده بالنمط المطلوب) / طباعة حجرية, ليثوغرافيا (مطبوعة منتجة بالطباعة الحجرية) / أَرْدْوَاز",
 "せきばんいんさつ": "الطباعة الحجرية",
 "せきばんが": "آلة طباعة حجرية (ناسخة تطبع بالطباعة الحجرية؛ حيث يعالج سطح مستو (من الحجر أو المعدن) لامتصاص الحبر أو صده بالنمط المطلوب) / طباعة حجرية, ليثوغرافيا (مطبوعة منتجة بالطباعة الحجرية)",
 "せきばんずり": "الطباعة الحجرية",
 "せきばんせき": "أَرْدْوَاز",
 "せきひつ": "قلم حجر, قلم لوح (قلم من الأردواز الناعم (أو الحجر الصابوني) يستخدم للكتابة على لوح) / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "せきぶん": "مُكَامَلَة / صَحِيح / تَكَامُلِيّ",
 "せきぶんがく": "حساب التكامل (جزء التفاضل والتكامل الذي يتعامل مع التكامل وتطبيقه في حل المعادلات التفاضلية وتحديد المساحات أو الأحجام)",
 "せきぶんき": "مقياس المساحة, مكامل (أداة قياس لقياس مساحة شكل مستوٍ غير منتظم)",
 "せきぶんほう": "مُكَامَلَة",
 "せきへい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "せきへき": "جدار حجري (سياج مبني من الحجارة الخشنة؛ يستخدم لفصل الحقول)",
 "せきほうへんい": "انزياح أحمر ((في علم الفلك) انزياح في أطياف المجرات البعيدة جداً نحو أطوال موجية أطول (نحو الطرف الأحمر من الطيف)؛ يفسر عموماً كدليل على أن الكون يتوسع)",
 "せきぼく": "غَرَافِيت",
 "せきむ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "せきめん": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها. / إحْرَاج / أَسْبِسْتُوس, أَسْبِسْت",
 "せきめんしょう": "داء الأسبست, سحار أسبستي (مرض رئوي ناجم عن استنشاق جزيئات الأسبستوس)",
 "せきめんちんちゃくしょう": "داء الأسبست, سحار أسبستي (مرض رئوي ناجم عن استنشاق جزيئات الأسبستوس)",
 "せきゆ": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت. / كِيرُوسِين",
 "せきゆかがくせいひん": "بتروكيميائي (أي مركب يتم الحصول عليه من البترول أو الغاز الطبيعي)",
 "せきゆがいしゃ": "شركة نفط (شركة تبيع النفط)",
 "せきゆぎょうしゃ": "عامل نفط (عامل ذكر ينتج أو يبيع البترول) / رجل نفط (شخص ذكر يمتلك أو يدير آبار نفط)",
 "せきゆけつがん": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "せきゆさんぎょう": "صناعة النفط, قطاع النفط (صناعة تنتج وتوزع النفط ومنتجاته)",
 "せきゆゆしゅつこくきこう": "اُوبِك, اُوبِيك",
 "せきゆガスぜい": "غَاز طَبِيعِيّ",
 "せきゆストーブ": "سخان كيروسين, مدفأة زيت (سخان يحرق الزيت (مثل الكيروسين) للتدفئة أو الطهي)",
 "せきゆタンカー": "نَاقِلَةُ نِفْط, نَاقِلَةُ نَفْط",
 "せきゆプラットフォーム": "جهاز حفر, منصة نفط (جهاز يستخدم في الحفر عن النفط أو الغاز)",
 "せきゆランプ": "مِصْبَاح زَيْتِيّ (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي يُسْتَضَاءُ بِه، مِصْبَاح كَهْرَبَائِيّ)\nمثال: ليس كل مصباح سحريا.",
 "せきよう": "مَسَاء",
 "せきら": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / بِلَا رَتْوَشَة, عَلَى حَقِيقَتِه (خَالٍ مِنْ أَيّ مُحَاوَلَة لِلتَّلْطِيف أَوِ الإِخْفَاء) / غَيْرُ مَصْبُوغ, غَيْرُ مُلَمَّع (لَيْسَ عَلَيْهِ طَبَقَةُ صَبْغٍ أَوْ وَرْنِيش)",
 "せきらら": "عُرْيَان, عَارٍ / بِلَا رَتْوَشَة, عَلَى حَقِيقَتِه (خَالٍ مِنْ أَيّ مُحَاوَلَة لِلتَّلْطِيف أَوِ الإِخْفَاء) / غَيْرُ مَصْبُوغ, غَيْرُ مُلَمَّع (لَيْسَ عَلَيْهِ طَبَقَةُ صَبْغٍ أَوْ وَرْنِيش)",
 "せきらんうん": "ركام مزني, سحابة رعدية (سحابة داكنة ذات امتداد عمودي كبير مشحونة بالكهرباء؛ ترتبط بالعواصف الرعدية)",
 "せきり": "زُحَار / مَلْمَس",
 "せきりきん": "شيغيلا (بكتيريا معوية عصوية سالبة الجرام؛ بعضها ممرض للحيوانات ذوات الدم الحار؛ يمكن استخدامها سلاحاً بيولوجياً)",
 "せきりつ": "عَزْم / لَحْظَة, دَقِيقَة",
 "せきりつそうかんけいすう": "معامل ارتباط العزم, معامل ارتباط بيرسون للعزم (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين المتغيرات المرتبطة خطياً)",
 "せきりゅう": "دُودَة الْأَرْض, خُرْطُون",
 "せきりょう": "اِنْفِرَاد / عُزْلَة / وَحْدَة / رسم الدخول, رسم خدمة المطعم (رسم ثابت يفرضه مطعم أو ملهى ليلي بالإضافة إلى رسوم الطعام والشراب) / سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال / عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره / سِحْلِيَّة, ضَبّ / دُودَة الْأَرْض, خُرْطُون",
 "せきりょく": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / استهجان, نفور شديد (نفور شديد) / تنافر, قوة تنافر (القوة التي تتنافر بها الأجسام عن بعضها البعض)",
 "せきりん": "حَصَاة كُلْوِيَّة",
 "せきれい": "ذُعْرَة, هَزَّاز الذَّنَب",
 "せきれき": "خرطوش, طلقة (قذيفة صلبة تطلق من سلاح ناري) / حبة, كرية (كتلة مستديرة صغيرة من مادة ما)\nمثال: أزت الطلقة بجانب أذنه",
 "せきろう": "زيت الكاز, كيروسين ((الاستخدام البريطاني) الكيروسين) / ألكان, برافين / شمع البارافين (من البترول الخام؛ يُستخدم للشموع وللطبقات الحافظة أو المقاومة للماء)",
 "せきをきる": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "せきを切る": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "せき板": "قماش الملاءات (قماش تصنع منه ملاءات السرير)",
 "せき止め": "أَدْوِيَةُ السُعَال",
 "せき止める": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "せき立てる": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "せぎょう": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "せぎれ": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "せぎん": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "せく": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه) / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت. / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة. / كَحَّ, سَعَلَ / سَعَلَ (سَعِلَ يَسْعَلَ سَعَلاً: نَشِطَ) / سُعْلَة, سُعَال\nمثال: سعل زيري مرة أخرى.",
 "せぐろうみへび": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "せぐろかもめ": "نورس الرنجة (نورس كبير يعيش في نصف الكرة الشمالي)",
 "せぐろジャッカル": "ابن آوى أسود الظهر (ابن آوى موطنه أفريقيا ذو ظهر أسود)",
 "せけん": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せけんいっぱん": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "せけんさま": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せけんしゅうち": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "せけんずれ": "مُتَطَوِّر, مُتَقَدِّم (متقدِّم في التطوُّر؛ معقَّد أو دقيق) / رَاقٍ, مُتَطَوِّر (جذاب فكريًّا ومتطور) / حنِك, راقٍ (يمتلك أو يجذب أولئك الذين لديهم معرفة دنيوية وتهذيب وكياسة)\nمثال: شبان اجتماعيون راقون",
 "せけんてい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "せけんてき": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "せけんなみ": "عَادِيّ, مَأْلُوف",
 "せけんのくち": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "せけんのみなさま": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "せけんのめ": "أَضْوَاء",
 "せけんばなし": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "せこ": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد) / حَبِيب, حَبِيبَة / رَفِيق, رَفِيقَة",
 "せこい": "تَافِه / فَقِير / مِسْكِين / فُقَرَاء",
 "せこう": "إنفاذ, تطبيق (فعل الإنفاذ؛ ضمان الامتثال أو الطاعة لـ) / بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "せこせこ": "ببخل, بتقتير (بطريقة بخيلة)\nمثال: عاملهم عمهم الغني ببخل",
 "せこ場": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)",
 "せご": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد)",
 "せごう": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "せさい": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "せし": "ضَيِّق",
 "せしめる": "غَشَّ / فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "せしゅ": "مُتَبَرِّع / زَبُون, مُشْتَرٍ / عَمِيل (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "せしゅう": "إرث جيني, وراثة (مجموع الصفات الموروثة) / وراثة (العملية البيولوجية التي تنتقل بها العوامل الوراثية من جيل إلى جيل)",
 "せしゅうざいさん": "إرث, ميراث (الخلافة الوراثية للقب أو منصب أو ممتلكات) / إرث, ميراث (أي سمة أو ممتلكات غير مادية موروثة من الأسلاف) / تراث (الممارسات المتوارثة من الماضي عن طريق التقليد) / تراث, تركة (ما يتم توريثه؛ لقب أو ممتلكات أو عقار ينتقل بموجب القانون إلى الوريث عند وفاة المالك)\nمثال: كان ميراثي الوحيد بركة أمي",
 "せしゅうてき": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "せじ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "せじにうとい": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "せじもの": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "せじゅつ": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / جراحة, عملية جراحية (إجراء طبي يتضمن شقاً بالأدوات؛ يتم إجراؤه لإصلاح تلف أو وقف مرض في جسم حي)\nمثال: سيحددون موعد العملية بمجرد توفر غرفة عمليات",
 "せじゅつしゃ": "مُمَارِس",
 "せじょう": "إقفال, إيصاد (فعل قفل شيء ما لحمايته) / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "せじん": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "せすじ": "عَمُود فَقْرِيّ",
 "せずに": "بِدُونِ, بِلَا",
 "せせこましい": "ضَيِّق / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط)",
 "せせらぎ": "جدول صغير (جدول صغير) / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
 "せせらぐ": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل)",
 "せせらわらう": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "せせら笑う": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "せせる": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "せそう": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せぞく": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せぞくか": "عَلْمَنَة",
 "せぞくしゅぎ": "عَلْمَانِيَّة, لَائِكِيَّة",
 "せぞくしん": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "せぞくてき": "دُنْيَوِيّ",
 "せぞくてきヒューマニズム": "إنسانية, إنسانية علمانية (المذهب الذي يؤكد قدرة الشخص على تحقيق ذاته من خلال العقل؛ يرفض الدين والخوارق)",
 "せたい": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "せたいぬし": "صاحب منزل, مالك المنزل (شخص يمتلك منزلاً)",
 "せたけ": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "せだい": "جِيل, نَسْل / جِيل",
 "せだいこうたい": "تعاقب الأجيال, تولد متباين (تناوب شكلين مختلفين أو أكثر في دورة حياة نبات أو حيوان)",
 "せち": "إقدام, عزيمة (الثبات والتصميم) / بديهة, حس سليم (حكم عملي سليم)\nمثال: لم يكن لديه الجرأة لتجربتها / مَوْسِم / مَوْسِم, جُزْء",
 "せちがい": "مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "せちがらい": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "せちぶ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "せちぶるまい": "السَّنَة الْجَدِيدَة",
 "せちぶん": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "せちょう": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "せっか": "مُتَحَجِّرَة (صخرة نشأت بالتحجر؛ جسم عضوي تخللته مادة معدنية وحُفظ في شكله الأصلي) / تحجر, تصخر (عملية تحويل بعض المواد النباتية إلى حجر عن طريق التشبع بالماء المحمل بالجزيئات المعدنية دون تغيير الشكل الأصلي) / البَرْق / رُقَاقَةُ الثَّلْج, نُدْفَةُ الثَّلْج",
 "せっかい": "جِير (طلاه بالجير؛ جيَّر الحوض: قعَّره) / لَيْم, بَنْزَهِير\nمثال: طليت الحاىءط بالجير. / شَقّ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم. / تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة) / حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "せっかいか": "تَكَلُّس",
 "せっかいがん": "حَجَر جِيرِيّ, حَجَر كِلْسِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "せっかいしつ": "جيري, طباشيري (مكون من أو يحتوي على أو يشبه كربونات الكالسيوم أو الكالسيت أو الطباشير)",
 "せっかいしゅじゅつ": "جراحة, عملية جراحية (إجراء طبي يتضمن شقاً بالأدوات؛ يتم إجراؤه لإصلاح تلف أو وقف مرض في جسم حي)\nمثال: سيحددون موعد العملية بمجرد توفر غرفة عمليات",
 "せっかいすい": "ماء الجير (محلول هيدروكسيد الكالسيوم في الماء يستخدم كمضاد للحموضة)",
 "せっかいせき": "حَجَر جِيرِيّ, حَجَر كِلْسِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "せっかいにゅう": "لبن الجير (معلق مائي لهيدروكسيد الكالسيوم، يستخدم في الدباغة كعامل قاعدي)\nمثال: بعد النقع، تؤخذ الجلود لعملية التجيير: المعالجة بلبن الجير (عامل قاعدي)",
 "せっかく": "نَادِر / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "せっかせっこう": "مرمر",
