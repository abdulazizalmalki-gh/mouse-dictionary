 "せいゆじょ": "مِصْفَاة نِفْط, مِصْفَاة نَفْط",
 "せいよ": "سُمْعَة, شُهْرَة",
 "せいよう": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب. / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "せいようあぶらな": "بذور السلجم (بذرة نباتات السلجم؛ مصدر لزيت صالح للأكل)",
 "せいようおとぎりそう": "حَشِيشَة الْقَلْب, دَاذِيّ",
 "せいようか": "تَغْرِيب",
 "せいようかぼちゃ": "قرع الزبدة (قرع أسطواني الشكل ذو قشرة خضراء داكنة معلمة باللون الفضي أو الرمادي) / قرع الحوذان (نبات يحمل ثماراً تشبه الطبل نوعاً ما ذات قشرة خضراء داكنة بعلامات رمادية)",
 "せいようかりん": "مُشْمُلَة / إِسْكِدُنْيَا / زُعْرُور / مُصَع",
 "せいようきぬやなぎ": "أوزير, صفصاف سلالين (أي من أنواع الصفصاف المختلفة ذات الأغصان المرنة المستخدمة في صناعة السلال والأثاث) / صفصاف سلالين (غصن مرن لشجرة الصفصاف)",
 "せいようこてんがく": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "せいようご": "الدامة, لعبة الداما (لعبة لوحية للاعبين اثنين يملك كل منهما 12 قطعة؛ الهدف هو القفز فوق قطع الخصم والاستيلاء عليها)",
 "せいようさくらそう": "الربيعية, بريملة",
 "せいようし": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء.",
 "せいようしみ": "السمكة الفضية (نوع فضي من السمك الذهبي) / سمكة الفضة (حشرة فضية رمادية غير مجنحة توجد في المنازل وتتغذى على أغلفة الكتب والملابس المنشاة)",
 "せいようしょうぎ": "شَطْرَنْج, شِطْرَنْج (طريقة هجاء بديلة لـ\"شِطْرَنْج\")\nمثال: لعب زيري الشطرنج.",
 "せいようしょうろ": "كَمْأَة",
 "せいようじん": "غَرْبِيّ",
 "せいようすぐり": "عِنَب الثَعْلَب",
 "せいようすのき": "عنبية (توت أزرق مسود يشبه التوت الأزرق الأمريكي)",
 "せいようすもも": "برقوق شائع (أي من أنواع البرقوق المختلفة واسعة الانتشار التي تزرع في المناطق المعتدلة الباردة)",
 "せいようたんぽぽ": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات للسلطة ولصنع النبيذ)",
 "せいようとちのき": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل) / كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "せいようとねりこ": "مران أوروبي, مران عالي (مران طويل من أوروبا إلى القوقاز له أوراق خضراء داكنة لامعة من الأعلى وشاحبة زغبية من الأسفل)",
 "せいようななかまど": "غُبَيْرَاء, غُبَيْرَاء أُورُوبِّيَّة (تصغير غَبْرَاء، وهي الأرض ومؤنث أغْبَر ووأنثى الحجل؛ نبات أو ثمرته)",
 "せいようにんじん": "جنسنغ أمريكي (عشب الغابات في أمريكا الشمالية يشبه الجنسنغ الصيني ويستخدم كبديل له)",
 "せいようねぎ": "كُرَّاث / ثُوم مُعَمَّر",
 "せいようねず": "عرعر شائع (شجيرة كثيفة التفرع أو شجرة صغيرة لها توت أزرق لاذع يستخدم لنكهة الجن؛ واسعة الانتشار في نصف الكرة الشمالي؛ الصنوبرية الوحيدة على سواحل أيسلندا…)",
 "せいようのこぎりそう": "قَيْصُوم",
 "せいようはこやなぎ": "حور لومباردي (يتميز بشكله العمودي المتسامي وفروعه المنتصبة)",
 "せいようはっか": "نَعْنَاع فِلْفِلِيّ",
 "せいようふうちょうそう": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة؛ تزرع لأزهارها طويلة الأمد التي تشبه العنكبوت بيضاء إلى وردية أرجوانية)",
 "せいようぶんめい": "الثقافة الغربية, الحضارة الغربية (الثقافة الحديثة لأوروبا الغربية وأمريكا الشمالية)",
 "せいようみざくら": "كرز حلو (أي من عدة فواكه لأشجار الكرز المزروعة التي لها لحم حلو) / كرز حلو (شجرة أوراسية كبيرة تنتج فاكهة مرة داكنة صغيرة في البرية ولكن فاكهة حلوة صالحة للأكل عند الزراعة)",
 "せいようやまはっか": "بَاذَرُوج, تُرُنْجَان",
 "せいようりんご": "تُفَّاحَة / تُفَّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاح (شجر فاكهة من الفصيلة الوردية؛ ثمر شجر التفاح) / تفّاحة\nمثال: هذه تفاحة أيضا.",
 "せいようわさび": "فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "せいようカボチャ": "قرع الزبدة (قرع أسطواني الشكل ذو قشرة خضراء داكنة معلمة باللون الفضي أو الرمادي) / قرع الحوذان (نبات يحمل ثماراً تشبه الطبل نوعاً ما ذات قشرة خضراء داكنة بعلامات رمادية)",
 "せいようタンポポ": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات للسلطة ولصنع النبيذ)",
 "せいよく": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "せいらい": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "せいらん": "تدرج أرغوس (تدرج كبير ذو أنماط رائعة من جزر الهند الشرقية)",
 "せいらんしょく": "مُسْتَشِيط غَضَبًا (غاضب غضبًا عارمًا لا يُطاق) / بَاهِت, شَاحِب الإِضَاءَة ((عَنِ الضَّوْء) يُضْفِي لَمَعَانًا شَاحِبًا كَلَمَعَان المَوْت) / شَاحِب, مُمْتَقَع (شاحب اللون كأنّه فاقد الدم؛ ذو مظهر مريض) / مَكْدُوم, مُزْرَقّ (تغيّر لونه بسبب تجمع الدم تحت الجلد)",
 "せいり": "تصنيف, فرز (التجميع حسب الفئة أو النوع أو الحجم) / تصنيف, تويب (العملية المعرفية الأساسية للترتيب في فئات أو أصناف) / تصنيف, فرز (عملية تفصل العناصر إلى مجموعات وفقاً لمعيار محدد)\nمثال: عنق الزجاجة في تسليم البريد هو عملية الفرز / تَصْفِية / تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي) / تحصين داخلي (خندق يتكون من تحصين داخلي إضافي لإطالة أمد الدفاع) / فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "せいりがく": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "せいりがくけんきゅうじょ": "عضة صغيرة, قرصة (عضة صغيرة حادة) / لذعة, نكهة حادة (جودة حارة ولاذعة) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل) / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)\nمثال: برودة الصباح الباكر",
 "せいりがつく": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "せいりきがく": "إستاتيكا, علم السكون (فرع الميكانيكا المعني بالقوى في حالة توازن)",
 "せいりきのう": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "せいりしょくえんすい": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "せいりぜんしょうこうぐん": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "せいりだんす": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "せいりつ": "تَشَكُّل / تَشْكِيلَة / نَتِيجَة / إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "せいりてき": "فَسْلَجِي, فِسْيُولُوجِي / حَدْسِيّ, غَرِيزِيّ (مُكْتَسَب بِالحَدْس لا بِالتَّفْكير أَوْ المُلاحَظَة) / حشوي (متعلق بالأحشاء أو يؤثر فيها)\nمثال: نزيف حشوي",
 "せいりてきしょくえんすい": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "せいりとうごう": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "せいりまえしょうこうぐん": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "せいりゃく": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "せいりゃくけっこん": "زَوَاج مَصْلَحَة",
 "せいりゅう": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تصحيح, تعديل (فعل تقديم تحسين لاستبدال خطأ؛ تقويم) / تقويم (تحويل التيار المتردد إلى تيار مباشر) / تقطير, تكرير ((في الكيمياء) عملية تكرير أو تنقية مادة ما عن طريق التقطير) / تَكْرِير",
 "せいりゅうかん": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "せいりゅうき": "مقوم تيار (جهاز كهربائي يحول التيار المتردد إلى تيار مستمر) / مُصَحِّح, مُقَوِّم (شخص يصحح أو يُقوّم الأمور)\nمثال: مصحح للتحيزات",
 "せいりゅうし": "مبدل كهربائي (مفتاح لعكس اتجاه التيار الكهربائي)",
 "せいりゅうとう": "سيف معقوف (سيف قصير عريض محدب قليلاً من العصور الوسطى بنقطة حادة)",
 "せいりゅうばん": "مقوم تيار (جهاز كهربائي يحول التيار المتردد إلى تيار مستمر) / مُصَحِّح, مُقَوِّم (شخص يصحح أو يُقوّم الأمور)\nمثال: مصحح للتحيزات",
 "せいりょう": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "せいりょういんりょう": "مَشْرُوب غَازِيّ",
 "せいりょういんりょうすい": "مَشْرُوب غَازِيّ",
 "せいりょうざい": "استجمام, ترويح عن النفس (نشاط يجدد النشاط ويرفه؛ نشاط يجدد صحتك وروحك بالمتعة والاسترخاء) / ضيافة, مرطبات (وجبات خفيفة ومشروبات تقدم كوجبة خفيفة)\nمثال: وقت للراحة والاستجمام بجانب المسبح / مُنَبِّه, مُنْعِش (يبثّ الحيوية والطاقة) / منبور, نغمي ((للمقاطع) تحمل النبرة الرئيسية، وعادة ما تكون مصحوبة بتغيير في طبقة الصوت) / أَسَاسِيّ نَغْمِيّ (متعلق بالنغمة الأساسية في السلم الكبير أو الصغير أو كائنها) / نغمي (يستخدم تنوعات في طبقة الصوت لتمييز معاني الكلمات المتشابهة)\nمثال: المقطع النغمي يحمل النبرة الرئيسية في الكلمة",
 "せいりょく": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "せいりょくかんけい": "توازن القوى",
 "せいりょくきんこう": "توازن القوى",
 "せいりょくけん": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "せいりょくざい": "مثير للشهوة, مقو للباه (محفز للرغبة الجنسية) / منشط جنسي (عقار أو عامل آخر يحفز الرغبة الجنسية)",
 "せいりょくしょく": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء) / أخضر مزرق, فيروزي غامق (لون أو صبغة زرقاء مخضرة)\nمثال: طلوها بدرجة فاتحة من الأزرق المخضر",
 "せいりょくず": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "せいりょくてき": "نَشِيط",
 "せいりょくはんい": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "せいりようナプキン": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "せいりんし": "حذاء المكبح, قماش الفرامل (قيد يتم توفيره عندما يتم تحريك بطانات الفرامل هيدروليكياً ضد أسطوانة الفرامل لإبطاء دوران العجلة)",
 "せいりんしん": "لجنة الأخلاقيات (لجنة معينة للنظر في القضايا الأخلاقية)",
 "せいるい": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما)",
 "せいれい": "تَنْظِيم / اِجْتِهَاد / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / الرُّوح الْقُدُس\nمثال: 聖霊がある方の上に下って、その上にとどまられるのが見えたなら、その方こそ聖霊によってバプテスマを授ける方である。 — الذي ترى الروح نازلا ومستقرا عليه فهذا هو الذي يعمد بالروح القدس. / نَظِيف / نضيف / نَظَّفَ / روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً / بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب",
 "せいれいかっきん": "اجتهاد, انكباب (اجتهاد وانتباه عظيم ومستمر)",
 "せいれいこうりんさい": "شافوت, عيد الأسابيع ((اليهودية) يوم مقدس يهودي يُحتفل به في السادس من سيفان للاحتفال بتلقي موسى للوصايا العشر) / أحد العنصرة, عيد العنصرة (الأحد السابع بعد عيد الفصح؛ يحيي ذكرى حلول الروح القدس على الرسل؛ يوم ربع سنوي في اسكتلندا)",
 "せいれいしゅぎ": "روحانية (الاهتمام بأمور الروح)",
 "せいれいしんこう": "أرواحية",
 "せいれいすうはい": "روحانية (الاهتمام بأمور الروح)",
 "せいれき": "الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين)\nمثال: في عام 200 من الحقبة العامة",
 "せいれつ": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة) / مَصْفُوفَة / عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة) / صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة",
 "せいれん": "نَزِيه, صَادِق / تكرير, تنقية (عملية إزالة الشوائب (كما هو الحال من الزيت أو المعادن أو السكر، إلخ)) / تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / تمشيط (التحرك عبر منطقة للبحث عن شيء ما)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء / تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / تكرير, تنقية (عملية إزالة الشوائب (كما هو الحال من الزيت أو المعادن أو السكر، إلخ))",
 "せいれんけっぱく": "استقامة, نزاهة (الصلاح الناتج عن كون الشخص شريفاً وصادقاً) / تَعَامُد, رَأْسِيَّة (الوضع بزاوية قائمة مع الأفق) / استقامة, انتصاب (خاصية كون الجسم منتصباً في الوضعية)",
 "せいれんしょ": "مِصْفَاة",
 "せいれんじょ": "مِصْفَاة",
 "せいろ": "استقامة, بر (التمسك بالمبادئ الأخلاقية) / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せいろう": "شَفَّاف / وَاضِح",
 "せいろうどうしゃ": "عامل بالجنس, عاملة بالجنس (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "せいろくめんたい": "سداسي سطوح منتظم, مكعب (سداسي سطوح له ستة مربعات متساوية كأوجه)",
 "せいろん": "رَأْي عَامّ",
 "せいをうける": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "せいニコラス": "القِدِّيس نِقُولَا",
 "せいホルモン": "ستيرويد, هرمون ستيرويدي (أي هرمون يؤثر على نمو وتطور الأعضاء الجنسية)",
 "せえ": "عَاقِبَة / نَتِيجَة",
 "せおとう": "جورب أزرق, مثقفة (امرأة لديها اهتمامات أدبية أو فكرية)",
 "せおよぎ": "سباحة الظهر (طريقة سباحة تشبه الزحف (السباحة الحرة) إلا أن السباح يستلقي على ظهره)",
 "せかい": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / فَلْكَة / كُرَة / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض.",
 "せかいいっしゅう": "طواف حول العالم (السفر حول شيء ما (بالسفينة أو الطائرة))\nمثال: أثبت طواف ماجلان حول الأرض أنها كروية",
 "せかいかん": "رُؤْيَةٌ كَوْنِيَّة, رُؤْيَةُ الْعَالَم / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "せかいきしょうきかん": "المنظمة العالمية للأرصاد الجوية (وكالة الأمم المتحدة المعنية بالجمع الدولي لبيانات الأرصاد الجوية)",
 "せかいきょうかいうんどう": "الحركة المسكونية (حركة تهدف إلى تعزيز التفاهم والتعاون بين الكنائس المسيحية؛ تهدف في النهاية إلى الوحدة المسيحية العالمية)",
 "せかいきょうかいきょうぎかい": "مجلس الكنائس العالمي (منظمة مسكونية للكنائس البروتستانتية والشرقية؛ تهدف إلى تعزيز الوحدة والتعاون في الشؤون الدينية والعلمانية)",
 "せかいきりすときょうとういつしんれいきょうかい": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "せかいきろく": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
 "せかいぎんこう": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "せかいさんぎょうろうどうくみあい": "عمال الصناعة في العالم (نقابة عمالية دولية سابقة وحركة عمالية راديكالية في الولايات المتحدة؛ تأسست في شيكاغو عام 1905 وكرست للإطاحة بالرأسمالية؛ انخفضت عضويتها بعد الحرب…)",
 "せかいしゅぎ": "الْمُوَاطَنَة الْعَالَمِيَّة",
 "せかいじ": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "せかいじょうせい": "شؤون دولية, شؤون عالمية (الشؤون بين الأمم)\nمثال: لا يمكنك حقاً مواكبة الشؤون العالمية من خلال مشاهدة التلفزيون",
 "せかいじん": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "せかいせい": "شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان)",
 "せかいせん": "عَالَم مُوَازِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せかいたいせん": "حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "せかいだいきょうこう": "الْكَسَاد الْعَظِيم",
 "せかいちず": "خَرِيطَةُ الْعَالَمِ (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "せかいちつじょ": "نِظَام عَالَمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "せかいてき": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ / أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "せかいにほこる": "أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "せかいのななふしぎ": "عجائب الدنيا السبع, عجائب الدنيا السبع القديمة (آثار ونصب مثيرة للإعجاب تم إنشاؤها في العالم القديم وكان يُنظر إليها برهبة وإجلال)",
 "せかいのはて": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "せかいへいわれんごう": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "せかいほけんきかん": "مُنَظَّمَة الصِّحَّة الْعَالَمِيَّة",
 "せかいぼうえききかん": "مُنَظَّمَة اَلتِّجَارَة اَلْعَالَمِيَّة",
 "せかいをぶたいに": "دولياً, عالمياً (على مستوى العالم) / عالمياً (فيما يتعلق بالأرض كلها)\nمثال: هي معروفة دولياً",
 "せかす": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "せかせか": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "せかせる": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "せかっこう": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "せからしか": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "せがたかい": "طَوِيل",
 "せがひくい": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "せがむ": "غُرَيْر",
 "せがれ": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / بَانْك / قَضِيب, ذَكَر",
