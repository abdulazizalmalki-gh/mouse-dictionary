 "ずぶの": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "ずぶ濡れ": "مَنْقُوع",
 "ずべら": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)",
 "ずべらぼう": "بَسِيط\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずべら坊": "بَسِيط\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずほう": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずほうきかがく": "هندسة إسقاطية, هندسة وصفية (هندسة الخصائص التي تظل ثابتة تحت الإسقاط)",
 "ずぼし": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ずぼっと": "خَارِج",
 "ずぼら": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)",
 "ずぼり": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ずぼん": "بإحكام (بشكل ملائم تماماً (للملابس))\nمثال: ناسقت السترة بإحكام / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "ずみ": "مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين)\nمثال: قطع الشطرنج المرتبة بعناية",
 "ずめん": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ずらかる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "ずらす": "نَوْبَة / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور.",
 "ずり": "جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ…)\nمثال: طلبت من توم جز عشبنا. / دَاعِرَة, بَغِيَّة",
 "ずりせん": "عَادَة سِرِّيَّة",
 "ずりでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "ずりやま": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "ずり出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "ずり山": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "ずる": "غدر, لعب قذر (سلوك غير عادل أو غير نزيه (يتضمن العنف خاصة)) / غَشَّ / اِنْزَلَقَ, تَزَحْلَقَ / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "ずるい": "خَبِيث, مَاكِر",
 "ずるがしこい": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم)\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "ずるける": "تَسَرَّبَ",
 "ずるずる": "بِبُطْء / بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة)\nمثال: حركوه بوصة بوصة / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / فَضْفَاض, واسِع",
 "ずるっこい": "خَبِيث, مَاكِر",
 "ずる賢い": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم)\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "ずれ": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية / فَرْق, اِخْتِلَاف / جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ…)\nمثال: طلبت من توم جز عشبنا.",
 "ずれる": "اِنْزَلَقَ, تَزَحْلَقَ",
 "ずろう": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ずろく": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "ずわい": "مِقْلَاد",
 "ずわえ": "مِقْلَاد",
 "ずん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ずんずん": "بسرعة, سريعاً\nمثال: يعمل بسرعة / جَهْوَرِيّ, مُجَلْجِل ((للصوت) عميق ورنّان)",
 "ずんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة / دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "ずんど": "أُسْطُوَانِيّ (ذو شكل الأسطوانة) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم) / قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ずんどう": "أُسْطُوَانِيّ (ذو شكل الأسطوانة) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم) / قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ずんどうなべ": "قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ずんべらぼう": "بَسِيط\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずんべら坊": "بَسِيط\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずんべら棒": "بَسِيط\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずーずーしい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)\nمثال: よくずうずうしくそんな事が言えるね。 — كيف تجرء على قول شيءٍ كهذا؟",
 "ずーっと": "باستمرار / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "せ": "ضَحِل / سَرِيع / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث. / فُرْصَة / الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة) / خَلْفِيّ\nمثال: عنده حقيبة ظهر. / عَكَسَ / اِرْتِفَاع / سلسلة جبال / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / ضَيْق / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "せあかりすざる": "أمريكي وسطي (من أو يتعلق بدول أو ثقافات أو شعوب أمريكا الوسطى)",
 "せい": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة. / قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / طَبِيعَة, طبيعة / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى…)\nمثال: أنا مثلي الجنس. / ـُونَ, ـِينَ / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل…)\nمثال: الأستاذ على حق. / أَصْلِيّ / مُوجَب / أُطْرُوحَة / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة…)\nمثال: طلب بطاقة اعتماد. / مَنِيّ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / اِرْتِفَاع / عَاقِبَة / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / مُقَدَّس / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / طَالِب, طَالِبَة / سِنْغَافُورَة (دولة مدينة تقع في جنوب شرق قارة آسيا البحري جنوب شبه جزيرة ملايو وشمال مضيق…) / عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / إِسْبَانِيَة, إِسْبَانِيَا / عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / طاقة تشي, كي (طاقة الحياة المتداولة التي يعتقد في الفلسفة الصينية أنها كامنة في كل شيء؛ في…) / سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن)\nمثال: سكون الليل / صَامِت, هَادِئ",
 "せいあい": "حياة عاطفية, غرام (الأنشطة الجنسية (التي تشمل غالباً الجماع) بين شخصين)\nمثال: طريقته في ممارسة الحب أثارت اشمئزازها",
 "せいあく": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "せいあくせつ": "سخرية مريرة, كلبية (شعور ساخر بعدم الثقة)",
 "せいあつ": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة)\nمثال: قمع الهرطقة / فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "せいあつしゃげき": "نيران إخماد, نيران قمعية (نيران على أو حول نظام أسلحة لتقليل أدائه إلى ما دون المستوى المطلوب لتحقيق…)",
 "せいあん": "شِيَان, شِيئَان",
 "せいい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / زي عسكري (زي تعريف محدد للجنود) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "せいいき": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…) / مدى, قدرة",
 "せいいく": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / وضع, ولادة (عملية الولادة)",
 "せいいたいしょうぐん": "رَئِيس أَرْكَان / شُوغُون",
 "せいいつ": "شرف, عفة (فضيلة المرأة أو عفتها) / اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل))",
 "せいいぶつ": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "せいいん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه. / مَنْشَأ",
 "せいう": "رِيشَة مُحِيطِيَّة (ريش يغطي جسم الطائر البالغ ويحدد شكله)",
 "せいうけい": "بَارُومِتْر, مِقْياس ضَغْط جَوِّيّ",
 "せいうん": "رَائِج, مُتَدَاوَل / سَدِيم / مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي:…)\nمثال: أنا بطل المجرة. / اِزْدِهَار, رَخَاء / زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء / تبحر, سعة اطلاع (معرفة علمية عميقة)",
