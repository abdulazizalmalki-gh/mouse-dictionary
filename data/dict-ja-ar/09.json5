 "ずつうのたね": "إزعاج, مصدر إزعاج (شيء أو شخص يسبب المتاعب؛ مصدر للتعاسة)\nمثال: إزعاج بسيط",
 "ずつき": "نَطْحَة / نَطَحَ",
 "ずつなし": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "ずどり": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずどん": "فَرْقَعَة",
 "ずにん": "سَجِين, سَجِينَة",
 "ずのう": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / عَقْل, فِطْنَة (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "ずのうしゅうだん": "خَلِيَّة تَفْكِير",
 "ずのうせん": "خط الرأس (تجعد في راحة اليد يقال إنه يمثل عقل الشخص وطريقة عمله، بما في ذلك أسلوب التعلم والتواصل والثقافة)\nمثال: غالباً ما يلتقي خط الرأس مع خط الحياة في بدايته / مَعْرَكَة دَهَاء (مسابقة يستخدم فيها الذكاء بدلاً من العنف)",
 "ずのうりゅうしゅつ": "هِجْرَةُ الأَدْمِغَة, هِجْرَةُ العُقُول (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "ずのうろうどうしゃ": "عامل ذهني (شخص تنطوي مهنته على استخدام عقله لحل المشكلات)",
 "ずはん": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "ずばいもも": "دُرَّاق",
 "ずばずば": "بشكل مباشر, بصراحة (بحزم وقناعة؛ بدون مساومة)\nمثال: وقف بصلابة من أجل الحرية الدينية والتسامح",
 "ずばっと": "بِصَراحة / قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "ずばなるまい": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ずばぬける": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ずばり": "بِشَكْل حَاسِم, بِشَكْل قَاطِع (بدرجة لا تقبل الجدل) / بِتَبْت, بِشَكْل نِهَائِيّ (مع النهائية؛ بشكل قاطع) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: قانون فيشر لعام 1918 رفع بشكل حاسم وضعهم وأجورهم / بِدِقَّة",
 "ずば抜ける": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ずひょう": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "ずぶ": "تَمَامًا",
 "ずぶずぶ": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / غَارِق, مُشْبَع (مغطى أو مُمَوَّن بوفرة؛ يُستخدم غالباً في التركيب) / بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ずぶずぶっ": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / غَارِق, مُشْبَع (مغطى أو مُمَوَّن بوفرة؛ يُستخدم غالباً في التركيب) / بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ずぶとい": "جَرِيء, جَسُور",
 "ずぶぬれ": "مَنْقُوع",
 "ずぶの": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "ずぶ濡れ": "مَنْقُوع",
 "ずべら": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي) / فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض) / مُبَعْثَر (يَفْتَقِرُ إِلَى التَّرْتِيبِ وَالنِّظَام)",
 "ずべらぼう": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずべら坊": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずほう": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずほうきかがく": "هندسة إسقاطية, هندسة وصفية (هندسة الخصائص التي تظل ثابتة تحت الإسقاط)",
 "ずぼし": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ずぼっと": "خَارِج",
 "ずぼら": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي) / فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض) / مُبَعْثَر (يَفْتَقِرُ إِلَى التَّرْتِيبِ وَالنِّظَام)",
 "ずぼり": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ずぼん": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "ずみ": "مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين) / مُدَبَّر, مُرَتَّب (منظم أو مخطط له مسبقاً) / مرتب, منسق (موضع أو مرتب بنوع معين من النظام)\nمثال: قطع الشطرنج المرتبة بعناية",
 "ずめん": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "ずら": "شَعْر مُسْتَعَار, بَارُوكَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ずらかる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "ずらす": "نَوْبَة / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "ずり": "جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا. / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ずりせん": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "ずりでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "ずりやま": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "ずり出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "ずり山": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "ずる": "غدر, لعب قذر (سلوك غير عادل أو غير نزيه (يتضمن العنف خاصة)) / غَشَّ / اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "ずるい": "خَبِيث, مَاكِر",
 "ずるがしこい": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مُخَاتِل, مُرَاوِغ (يتسم بالرياء أو الخداع؛ مراوغ ومتملص)\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "ずるける": "تَسَرَّبَ",
 "ずるずる": "بِبُطْء / بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / فَضْفَاض, واسِع",
 "ずるっこい": "خَبِيث, مَاكِر",
 "ずる賢い": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مُخَاتِل, مُرَاوِغ (يتسم بالرياء أو الخداع؛ مراوغ ومتملص)\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "ずれ": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "ずれる": "اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة",
 "ずろう": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ずろく": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "ずわい": "مِقْلَاد",
 "ずわえ": "مِقْلَاد",
 "ずん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ずんずん": "بسرعة, سريعاً\nمثال: يعمل بسرعة / جَهْوَرِيّ, مُجَلْجِل ((للصوت) عميق ورنّان) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "ずんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة / دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "ずんど": "أُسْطُوَانِيّ (ذو شكل الأسطوانة) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم) / قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ずんどう": "أُسْطُوَانِيّ (ذو شكل الأسطوانة) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم) / قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ずんどうなべ": "قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "ずんべらぼう": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずんべら坊": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずんべら棒": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ずーずーしい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / صَفِيق, وَقِح (يتسم بعدم الاحترام العَرَضيّ)\nمثال: よくずうずうしくそんな事が言えるね。 — كيف تجرء على قول شيءٍ كهذا؟",
 "ずーっと": "باستمرار / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "せ": "ضَحِل / سَرِيع / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / فُرْصَة / الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة) / سيلينيوم (عنصر لافلزي سام مرتبط بالكبريت والتيلوريوم؛ يوجد في عدة أشكال تآصلية) / خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / عَكَسَ / اِرْتِفَاع / سلسلة جبال / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / ضَيْق / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "せあかりすざる": "أمريكي وسطي (من أو يتعلق بدول أو ثقافات أو شعوب أمريكا الوسطى) / أمريكي وسطي (مواطن أو ساكن في أمريكا الوسطى)",
 "せい": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / طَبِيعَة, طبيعة / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس. / جِندر, هَوِيَّة جِنْسِيَّة\nمثال: أنا مثلي الجنس. / ـُونَ, ـِينَ / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق. / أَصْلِيّ / مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة / أُطْرُوحَة / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد. / مَنِيّ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / اِرْتِفَاع / عَاقِبَة / نَتِيجَة / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / مُقَدَّس / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / طَالِب, طَالِبَة / سِنْغَافُورَة (دولة مدينة تقع في جنوب شرق قارة آسيا البحري جنوب شبه جزيرة ملايو وشمال مضيق سنغافورة، اسمها الرسمي جمهورية سنغافورة) / عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / إِسْبَانِيَة, إِسْبَانِيَا / عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / طاقة تشي, كي (طاقة الحياة المتداولة التي يعتقد في الفلسفة الصينية أنها كامنة في كل شيء؛ في الطب الصيني التقليدي يعتبر توازن الأشكال السلبية والإيجابية في الجسم…) / سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل / صَامِت, هَادِئ",
 "せいあい": "حياة عاطفية, غرام (الأنشطة الجنسية (التي تشمل غالباً الجماع) بين شخصين) / حب جنسي, عشق (شعور عميق بالرغبة الجنسية والانجذاب)\nمثال: طريقته في ممارسة الحب أثارت اشمئزازها",
 "せいあく": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "せいあくせつ": "سخرية مريرة, كلبية (شعور ساخر بعدم الثقة)",
 "せいあつ": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة / فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "せいあつしゃげき": "نيران إخماد, نيران قمعية (نيران على أو حول نظام أسلحة لتقليل أدائه إلى ما دون المستوى المطلوب لتحقيق أهداف مهمته)",
 "せいあん": "شِيَان, شِيئَان",
 "せいい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / زي عسكري (زي تعريف محدد للجنود) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "せいいき": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة) / مدى, قدرة / مَدَى",
 "せいいく": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / وضع, ولادة (عملية الولادة)",
 "せいいたいしょうぐん": "رَئِيس أَرْكَان / شُوغُون",
 "せいいつ": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة) / اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل)) / اتِّسَاق, انْتِظَام (حالة يكون فيها كل شيء منتظماً وغير متغير)",
 "せいいぶつ": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / ذَخِيرَة\nمثال: اختفى فلم ير له أثر.",
 "せいいん": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / عُضُو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه. / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "せいう": "رِيشَة مُحِيطِيَّة (ريش يغطي جسم الطائر البالغ ويحدد شكله)",
 "せいうけい": "بَارُومِتْر, مِقْياس ضَغْط جَوِّيّ",
 "せいうん": "رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل / سَدِيم / مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة. / اِزْدِهَار, رَخَاء / زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء / تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "せいうんせつ": "فرضية سديمية ((علم الكونيات) النظرية القائلة بأن النظام الشمسي تطور من سديم غازي ساخن)",
 "せいえい": "نُخْبَة / صُورَة / بُورْتْرِيَّة / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "せいえき": "مَنِيّ",
 "せいえつ": "ضارع, متوسل (يقوم بالتوسل أو الاستجداء)",
 "せいえん": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "せいえんそう": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "せいえんをおくる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "せいおう": "أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة. / غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب. / بمحاذاة المنتصف (بزوايا قائمة لطول سفينة أو طائرة)",
 "せいおうか": "تَغْرِيب",
 "せいおうじん": "غَرْبِيّ",
 "せいおうぶんめい": "الثقافة الغربية, الحضارة الغربية (الثقافة الحديثة لأوروبا الغربية وأمريكا الشمالية)",
 "せいおうぼ": "الْمَلِكَة الْأُمّ",
 "せいおん": "سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / سكون, طمأنينة (حالة من السلام والهدوء) / سكينة, هدوء (حالة خالية من المتاعب والاضطرابات) / صَامِت, سَاكِت / تجويد الصوت, ضبط النغمة (فعل تعديل أنبوب الأرغن (أو آلة النفخ) ليتوافق مع معايير النغمة والطبقة واللون)",
 "せいおんか": "رُطُوبة",
 "せいおんせい": "انعدام الصوت, هدوء (خاصية عدم إصدار أي صوت) / سكون, طمأنينة (حالة من السلام والهدوء)",
 "せいおんもじ": "رمز صوتي (حرف مكتوب يُستخدم في النسخ الصوتي لتمثيل صوت كلام معين)",
 "せいおんパソコン": "كَمْبْيُوتَر شَخْصِيّ",
 "せいか": "تَسَبَّب / نَتِيجَة / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة) / تَرْتِيلَة, تَرْنِيمَة / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / إِيكِيبَانَا / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / سُمْعَة, شُهْرَة / قيظ / تنسيق الزهور (ترتيب زخرفي للزهور) / دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير. / كعكة عيد الميلاد (كعكة فواكه غنية (مغطاة عادة بالتزيين والمرزبان) وتؤكل في عيد الميلاد) / تقديس (حفل ديني يتم فيه جعل شيء مقدسًا)",
 "せいかい": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "せいかいしょく": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "せいかがい": "خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج) / خَارِج نِطَاق العَمَل (خارج المهام الاعتيادية للوظيفة أو المهنة) / خَارِج المِنْهَاج, لَا مَنْهَجِيّ (خارج المنهج الدراسي الأكاديمي المعتاد) / اِعْتِدَاء جِنْسِيّ",
 "せいかがく": "كِيمِيَاء حَيَوِيَّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء. / طِبّ جِنْسِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "せいかがくしゃ": "عَالِم اَلْجِنْس (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せいかきゅう": "عُمُولَة",
 "せいかぎょうしゃ": "حَلْوَانِيّ",
 "せいかく": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة. / مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة. / ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل) / دِبَاغَة / سِيَاسِيّ, سِيَاسِيَّة / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً / حَالَة اَلْمُضَاف إِلَيْهِ, مَجْرُور",
 "せいかくいじょう": "اضطراب الشخصية (أنماط سلوكية غير مرنة وغير متكيفة)",
 "せいかくがいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "せいかくがよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "せいかくがわるい": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "せいかくけんさ": "اختبار شخصية (أي اختبار يهدف إلى تقييم الشخصية)",
 "せいかくしょうがい": "اضطراب الشخصية (أنماط سلوكية غير مرنة وغير متكيفة)",
 "せいかくしんだん": "استبيان الشخصية, تقييم الشخصية (استبيان يفترض أن يقدم وصفًا لسمات شخصية الفرد)\nمثال: استبيان الشخصية هو اختبار مباشر للشخصية، على عكس الاختبار الإسقاطي",
 "せいかくせい": "دِقَّة",
 "せいかくてき": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "せいかくど": "دِقَّة",
 "せいかくにいうと": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "せいかくにいえば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "せいかくはいゆう": "ممثل أدوار مساعدة, ممثل شخصيات (ممثل يتخصص في لعب الأدوار الداعمة)",
 "せいかくはんべつ": "استبيان الشخصية, تقييم الشخصية (استبيان يفترض أن يقدم وصفًا لسمات شخصية الفرد)\nمثال: استبيان الشخصية هو اختبار مباشر للشخصية، على عكس الاختبار الإسقاطي",
 "せいかくびょうしゃ": "تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / تشخيص, توصيف (فعل وصف الخصائص المميزة أو السمات الأساسية) / تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: توصيف الإعلام لآل جور بأنه مهووس",
 "せいかくぶんせき": "استبيان الشخصية, تقييم الشخصية (استبيان يفترض أن يقدم وصفًا لسمات شخصية الفرد)\nمثال: استبيان الشخصية هو اختبار مباشر للشخصية، على عكس الاختبار الإسقاطي",
 "せいかくわるい": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "せいかじゅう": "ثقل ساكن, وزن ميت (وزن ثقيل لا يتحرك) / عبء ثقيل (عائق قمعي أو ثقيل)",
 "せいかぞく": "اَلْعائِلةُ ٱلْمُقَدَّسةُ",
 "せいかたい": "خُورُس, جَوْقَة",
 "せいかたんでん": "الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "せいかっこう": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "せいかつ": "قَاطِع / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / مَعِيشَة, مَعَاش",
 "せいかつかん": "دورة حياة (سلسلة من المراحل التي يمر بها الكائن الحي بين تكرار مرحلة أساسية) / دورة حياة (مسار التغيرات التطورية في كائن حي من الزيجوت المخصب إلى النضج حيث يمكن إنتاج زيجوت آخر)",
 "せいかつきゅう": "أجر المعيشة, حد الكفاف (أجر كافٍ للعامل وعائلته للعيش براحة)",
 "せいかつきょうどうくみあい": "تَعَاوُنِيّ",
 "せいかつくうかん": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "せいかつけん": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود",
 "せいかつご": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "せいかつし": "دورة حياة (سلسلة من المراحل التي يمر بها الكائن الحي بين تكرار مرحلة أساسية) / دورة حياة (مسار التغيرات التطورية في كائن حي من الزيجوت المخصب إلى النضج حيث يمكن إنتاج زيجوت آخر)",
 "せいかつしえん": "صِيَانَة",
 "せいかつしゃ": "مُسْتَهْلِك / مُسْتَنْفِد",
 "せいかつしゅうかん": "نَمَط الحَيَاة",
 "せいかつすいじゅん": "مُسْتَوَى اَلْمَعِيشَة",
 "せいかつたいど": "نَمَط الحَيَاة",
 "せいかつねんれい": "عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً",
 "せいかつのしつ": "جَوْدَة الْحَيَاة",
 "せいかつひつじゅひん": "ضَرُورَة, حَاجَة",
 "せいかつぶり": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "せいかつほう": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "せいかつほご": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "せいかつほごほう": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "せいかつりょく": "تدفق, حيوية (أسلوب نشيط) / حيوية, نشاط (خاصية القدرة على البقاء والنمو) / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية) / حيوية, طاقة (قدرة صحية على النشاط القوي)\nمثال: حيوية البذرة",
 "せいかつスタイル": "نَمَط الحَيَاة",
 "せいかつパターン": "نَمَط الحَيَاة",
 "せいかてん": "بَقَّال",
 "せいかぶつ": "سيانيد (ملح شديد السمية لحمض الهيدروسيانيك) / نتريل / دكان خضري, محل خضار (متجر بقالة لبيع الخضار والفواكه) / خضار, خضروات وفاكهة (سلع البقالة التي يبيعها بائع الخضار) / جاهز للتسليم, قابل للتسليم (مناسب أو جاهز للتسليم) / تسليمات, مُخرَج (شيء يمكن تقديمه كمنتج لعملية التطوير)\nمثال: بموجب هذا العقد تشمل التسليمات كلاً من البرامج والأجهزة",
 "せいかほう": "عملية السيانيد (عملية صناعية لاستخراج الذهب والفضة عن طريق معالجة الخام بمحلول سيانيد الصوديوم)",
 "せいかん": "بَاقٍ, نَاجٍ (لا يزال في الوجود ولم ينقرض) / سِلْمِيّ / مُسَالِم / رَجُولِيّ, فُحُولِيّ (من سمات الرجل وصفاته) / فحل, قوي جنسياً ((للذكر) قادر على الجماع) / فَتِيّ, مَلِيء بِالحَيَوِيَّة (يتسم بالطاقة والحيوية والنشاط) / قَنَاة مَنَوِيَّة / حاسوب شخصي (حاسوب رقمي صغير يعتمد على معالج دقيق ومصمم ليستخدمه شخص واحد في كل مرة) / بين النجوم (يقع بين أو وسط النجوم)\nمثال: كثافة الهيدروجين في الفضاء بين الكواكب وبين النجوم / كَوْكَبَة / حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / ممرضة مسجلة (ممرضة خريجة اجتازت امتحانات التسجيل) / دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير.",
 "せいかんくうかん": "الفضاء بين النجوم, فضاء بين نجمي (الفضاء الموجود بين النجوم)",
 "せいかんけっさつじゅつ": "قطع القناة المنوية (إجراء جراحي يزيل كل أو جزء من الأسهر (عادة كوسيلة للتعقيم)؛ وأحياناً تكون قابلة للعكس)",
 "せいかんごし": "ممرضة مسجلة (ممرضة خريجة اجتازت امتحانات التسجيل)",
 "せいかんざい": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "せいかんしゃ": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "せいかんせい": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "せいかんせんしょう": "دَاء مَنْقُول جِنْسِيًّا",
 "せいかんたい": "مِنْطَقَة اَلشَّهْوَة اَلْجِنْسِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "せいかんぱん": "السطح الرئيسي (أعلى سطح مغطى يمتد على طول السفينة الكبيرة بالكامل)",
 "せいかんエステ": "صالون, صالون تجميل (محل يعمل فيه مصففو الشعر وأخصائيو التجميل)",
 "せいかランナー": "حامل الشعلة, رائد (قائد في حملة أو حركة ما)",
 "せいが": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: درب على يد خبير. / رَشِيق, ظَرِيف",
 "せいがく": "غناء, موسيقى صوتية (موسيقى يتم أداؤها بالصوت (على عكس الموسيقى الآلية)) / غناء, موسيقى صوتية (موسيقى مخصصة للأداء بواسطة مغنٍ واحد أو أكثر، عادة مع مرافقة آلية) / فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك. / موسيقى دينية, موسيقى كنسية (نوع من الموسيقى المؤلفة للأداء كجزء من الاحتفالات الدينية) / طِبّ جِنْسِيّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "せいがくか": "مطرب, مغنٍ (شخص يغني)",
 "せいがくきょく": "غناء, موسيقى صوتية (موسيقى يتم أداؤها بالصوت (على عكس الموسيقى الآلية)) / غناء, موسيقى صوتية (موسيقى مخصصة للأداء بواسطة مغنٍ واحد أو أكثر، عادة مع مرافقة آلية)",
 "せいがぞう": "قُونَة, أَيْقُونَة / أَيْقُونَة",
 "せいがん": "الضِّفَّة الْغَرْبِيَّة / نَذْر / نَذَرَ / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ / عَرِيضَة, طَلَب / مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "せいがんぐ": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "せいがんしゃ": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / طالب الانتصاف, مقدم الالتماس (شخص يلتمس من المحكمة رفع مظلمة أو استرداد حق)\nمثال: مستعطف لرضاها",
 "せいがんしょ": "عَرِيضَة, طَلَب",
 "せいがんちく": "الضِّفَّة الْغَرْبِيَّة",
 "せいき": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن. / حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / عَادِيّ / مُنْتَظِمٌ / حُدُوث / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "せいきか": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "せいきかとうえいざひょうけい": "مركز منع الانتشار (وكالة تعمل كنقطة محورية لجميع أنشطة مجتمع الاستخبارات المتعلقة بمنع انتشار أسلحة الدمار الشامل وأنظمة إطلاق الصواريخ الخاصة بها)",
 "せいきぐん": "جيش, قوات برية (منظمة دائمة للقوات البرية العسكرية لأمة أو دولة)",
 "せいきこう": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي) / ناشر الصوت (حاجز يوزع الموجات الصوتية بالتساوي)",
 "せいきさん": "مكتمل الحمل (حُمل به طوال مدة الحمل الطبيعي)\nمثال: طفل مكتمل الحمل وبصحة جيدة",
 "せいきぶんぷ": "تَوْزِيع طَبِيعِيّ",
 "せいきへい": "عَادِيّ / مُنْتَظِمٌ",
 "せいきまつ": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "せいきまつてき": "مُتَرَفّ, مُنْحَطّ (مُنغمس في التنعّم والتدليل بإسراف) / آفِل, مُنْحَطّ (يَتَّسِمُ بِالإِسْرَافِ فِي مُتَعِ الذَّاتِ وَالانْحِلَالِ الأَخْلَاقِيّ) / منحل (شخص سقط في حالة انحطاط (أخلاقياً أو فنياً))",
 "せいきゃく": "سِيَاسِيّ, سِيَاسِيَّة",
 "せいきゅう": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / مُتَسَرِّع / دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "せいきゅうきごう": "رقم الاستدعاء, رقم الطلب (علامة تتكون من أحرف مكتوبة على كتاب؛ تستخدم للإشارة إلى موقعه على الرف)",
 "せいきゅうこう": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "せいきゅうしょ": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "せいきゅうすう": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "せいきゅうりょく": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "せいきょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "せいきょう": "أُرْثُوذُكْسِيَّة (أرثوذكسيَّة) / تعاونية, جمعية تعاونية (مؤسسة تجارية مملوكة بشكل مشترك (ينظمها عادة المزارعون أو المستهلكون) تنتج وتوزع السلع والخدمات وتدار لصالح مالكيها) / نَجَاح / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / كُونْفُوشِيَّة, كُونْفُشْيُوسِيَة / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية. / بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد) / سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية) / إِنْجِيل",
 "せいきょういく": "تَرْبِيَة جِنْسِيَّة",
 "せいきょうかい": "أُرْثُوذُكْسِيَّة شَرْقِيَّة (أرثوذكسيَّة)",
 "せいきょうじゅ": "أستاذ كامل, أستاذ كرسي (أستاذ من أعلى رتبة)",
 "せいきょうと": "متزمت (شخص يهتم بشكل مفرط باللياقة والأعراف) / بيوريتاني, متزمت (شخص يلتزم بمبادئ دينية صارمة؛ شخص يعارض الملذات الحسية) / بيوريتاني, تطهيري (عضو في مجموعة من البروتستانت الإنجليز في القرنين السادس عشر والسابع عشر اعتقدوا أن الإصلاح البروتستانتي في عهد إليزابيث كان غير مكتمل ودعوا لتبسيط…)",
 "せいきょく": "كاثود, مهبط (قطب كهربائي سالب الشحنة وهو مصدر الإلكترونات التي تدخل جهازاً كهربائياً) / قطب موجب, كاثود (الطرف الموجب الشحنة لخلية فولتية أو بطارية تخزين يوفر التيار) / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "せいきろん": "حيوية ((فلسفة) مذهب يرى أن الحياة مبدأ حيوي متميز عن الفيزياء والكيمياء)",
 "せいきん": "اِجْتِهَاد / ركود جرثومي, كبح البكتيريا (تثبيط نمو البكتيريا)",
 "せいきんようび": "الْجُمْعَة الْعَظِيمَة, جُمْعَة الْآلَام",
 "せいぎ": "عَدْل, إِنْصَاف (عَدْل) / عَدْل, عَدَالَة (عَدْل) / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "せいぎかん": "حس أخلاقي, ضمير (دافع نابع منطقياً من مبادئ أخلاقية تحكم أفكار الشخص وتصرفاته)",
 "せいぎのみかた": "بَطَل, بَطَلَة",
 "せいぎゃくたい": "إِسَاءَة جِنْسِيَّة",
 "せいぎょ": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "せいぎょいでんし": "جين تنظيمي (جين ينتج مادة كابتة تمنع الجين المشغل)",
 "せいぎょう": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / مَعِيشَة, مَعَاش",
 "せいぎょかいろ": "دائرة تحكم, دائرة تغذية راجعة سلبية (دائرة تغذية راجعة تطرح من المدخلات)",
 "せいぎょき": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "せいぎょきのう": "عملية تحكم (عملية تتحكم في تسجيل أو معالجة أو إرسال أو تفسير البيانات)\nمثال: بدأت عملية تحكم بمعالجة البيانات",
 "せいぎょく": "أَزْرَق يَاقُوتِيّ (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا) / يَاقُوت, زَفِير\nمثال: هذا البناء أزرق.",
 "せいぎょけい": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "せいぎょけん": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "せいぎょげんご": "لغة الأوامر, لغة الاستعلام (لغة مصدر تتكون من مشغلات إجرائية تستدعي وظائف ليتم تنفيذها)",
 "せいぎょこうがく": "هَنْدَسَة التَّكَكُّمَ (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "せいぎょしつ": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "せいぎょそうち": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "せいぎょたく": "وَاسَى, عَزَّى",
 "せいぎょてん": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر) / كوريوم (عنصر فلزي مشع ما بعد اليورانيوم؛ ينتج بقصف البلوتونيوم بنوى الهيليوم)",
 "せいぎょばん": "لَوْحَةُ التَّحَكُّم",
 "せいぎょふのう": "منفلت من عقاله",
 "せいぎょぶ": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "せいぎょぼう": "قضيب تحكُّم (قضيب من الفولاذ أو الألومنيوم يمكن تحريكه لأعلى أو لأسفل للتحكم في معدل التفاعل النووي)",
 "せいぎょもじ": "شَخْص (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "せいぎょりょういき": "كالسيوم (عنصر فلزي أبيض يحترق بضوء ساطع؛ خامس أكثر العناصر وفرة في القشرة الأرضية)",
 "せいぎょシステム": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "せいぎマン": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "せいく": "اِصْطِلَاح, مُصْطَلَح / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "せいくうけん": "تفوق جوي",
 "せいぐ": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "せいぐん": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة",
 "せいけい": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب) / جراحة العظام, طب العظام (فرع العلوم الطبية المعني باضطرابات أو تشوهات العمود الفقري والمفاصل) / نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / مَعِيشَة, مَعَاش / نِظَام نَجْمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية) / إِنْجِيل / الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد / نُزُول / اَصْل / شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "せいけいき": "آلة التسدية, آلة السداء (آلة نسيج تستخدم لتسدية أي خيوط طبيعية أو صناعية)",
 "せいけいげか": "جراحة العظام, طب العظام (فرع العلوم الطبية المعني باضطرابات أو تشوهات العمود الفقري والمفاصل) / جِرَاحَةْ تَجْمِيل",
 "せいけいげかい": "جراح تجميل (جراح يقوم بتجميل الجسم (خاصة الوجه))",
 "せいけいしつ": "خاصية جنسية, صفة جنسية (تلك الخصائص (التشريحية والنفسية) التي ترتبط بقوة بجنس واحد مقارنة بالآخر)",
 "せいけいしゃ": "كاسب, متكسب (شخص يكسب أجراً مقابل عمله)",
 "せいけいしゅじゅつ": "جِرَاحَةْ تَجْمِيل",
 "せいけいたん": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود)",
 "せいけいひしすう": "تكاليف المعيشَة",
 "せいけいをたてる": "اِرْتَزَقَ",
 "せいけつ": "نَظِيف / نضيف / نَظَّفَ / صَافٍ, اَلصَّافِي",
 "せいけつかん": "نَظَافَة",
 "せいけん": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / خَزْعَة",
 "せいけんこうたい": "تَغْيِير اَلْنِظَام",
 "せいけんこうやく": "بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "せいけんとう": "حِزْب, حِزْب سِيَاسِيّ (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "せいけんをにぎる": "تَوَلَّى السُلْطَة, جَاءَ إِلَى السُلْطَة",
 "せいげん": "تَقْيِيد, اِقْتِصَار / قَيْد / جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب. / قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "せいげんきょくせん": "منحنى الجيب",
 "せいげんこうそ": "إنزيم الاقتطاع, إنزيم القصر (أي من الإنزيمات التي تقطع الحمض النووي في مواقع اقتطاع محددة وتنتج شظايا اقتطاع؛ يتم الحصول عليها من البكتيريا (حيث تعطل الغزاة الفيروسيين)؛ تُستخدم…)",
 "せいげんじかん": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "せいげんじこう": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "せいげんせんそう": "حرب محدودة (حرب هدفها أقل من الهزيمة غير المشروطة للعدو)",
 "せいげんそくど": "حَدّ اَلسُّرْعَة اَلْأُقْصَى, حَدّ اَلسُّرْعَة (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "せいげんつき": "مَحْدُود",
 "せいげんなし": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / صَرِيح, مُطْلَق (بلا تحفّظ أو استثناء)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "せいげんは": "موجة جيبية (موجة يشبه شكلها منحنى الجيب)",
 "せいげんようほう": "تَقْيِيدِيّ",
 "せいこう": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / انحناء, ميل (فعل الانحناء؛ الميل إلى الأمام) / ميل, نزعة (احتمالية مميزة أو استعداد طبيعي تجاه حالة أو طابع أو تأثير معين) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: أشار انحناء رأسه إلى موافقته / نَجَاح / نَجَحَ / إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً / مُفَصَّل / خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / أَسِير الْحَرْب, أَسِير (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد. / رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري. / ضوء النجوم (ضوء النجوم)",
 "せいこうい": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "せいこういかんせんしょう": "دَاء مَنْقُول جِنْسِيًّا",
 "せいこうかい": "الكنيسة الإنجليكانية, كنيسة إنجلترا (الكنيسة الوطنية لإنجلترا (وجميع الكنائس الأخرى في بلدان أخرى تشاركها معتقداتها)؛ مقرها في كانتربري والملك هو رئيسها الزمني)",
 "せいこうぎょう": "صناعة الصلب (الصناعة التي تنتج الصلب ومنتجات الصلب)",
 "せいこうしゃ": "نَجَاح",
 "せいこうしょ": "مصنع صلب, معمل صلب (مصنع يتم فيه صنع الصلب)",
 "せいこうしょう": "اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "せいこうじょ": "مصنع صلب, معمل صلب (مصنع يتم فيه صنع الصلب)",
 "せいこうたいい": "وَضْع جِنْسِيّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "せいこうつう": "عُسْر جِمَاع, علم جماع (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "せいこうとう": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "せいこうとうつう": "عُسْر جِمَاع, علم جماع (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "せいこうどう": "ممارسة جنسية, نشاط جنسي (الأنشطة المرتبطة بالجماع الجنسي)\nمثال: مارسوا الجنس في المقعد الخلفي",
 "せいこうどういねんれい": "سن الرشد القانوني, سن الموافقة (الحد الأدنى للسن للزواج دون موافقة الوالدين أو الحد الأدنى للسن للعلاقات الجنسية بالتراضي)",
 "せいこうどうぶつ": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها مظهر الفول السوداني)",
 "せいこうふのう": "عَنَانَة, عُنَّة",
 "せいこうほう": "إجراء تشغيلي قياسي, إجراء قياسي (إجراء مقرر يجب اتباعه بشكل روتيني)\nمثال: الحفظ عن ظهر قلب كان الإجراء التشغيلي القياسي للمعلمين لقرون",
 "せいこうほうしゅう": "أتعاب مشروطة (أتعاب تُدفع فقط إذا كانت النتيجة ناجحة (كما هو الحال بالنسبة لخدمات المحامي))",
 "せいこうり": "نَجَاح",
 "せいこく": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً / إعلان, بلاغ (بيان عام رسمي) / 25 مارس, عيد البشارة (مهرجان يحيي ذكرى إعلان التجسد من قبل الملاك جبرائيل للسيدة العذراء مريم؛ يوم ربع سنوي في إنجلترا وويلز وأيرلندا)\nمثال: أصدرت الحكومة إعلاناً حول التغييرات في الحرب على المخدرات",
 "せいこくもじ": "هِيرُوغْلِيفِيَّة",
 "せいこつし": "مقوم العظام (معالج يعالج الهيكل العظمي والعضلات)",
 "せいこつばこ": "ذخيرة مقدسة, وعاء الذخائر (حاوية تُحفظ فيها الآثار الدينية أو تُعرض (خاصة آثار القديسين))",
 "せいこん": "زَوَاج, نِكَاح / زَوَاج / عُرْس, زِفَاف / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة. / آثار الجروح, وصمات (علامات تشبه الجروح على جسد المسيح المصلوب)",
 "せいご": "دِقَّة / تَصْحِيح / تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها) / إِسْبَانِيّ / إسبانية",
 "せいごう": "ضَبْط / عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / فحل",
 "せいごうせい": "أَمَانَة, نَزَاهَة / سَلَامَة / تخليق حيوي, نشوء حيوي (إنتاج مركب كيميائي بواسطة كائن حي)",
 "せいごかくけい": "خماسي منتظم, مخمس منتظم (مخمس تكون فيه جميع الزوايا متساوية وجميع الأضلاع متساوية)",
 "せいごひょう": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "せいごん": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "せいさ": "تَدْقِيق",
 "せいさい": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل) / أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تنوع, حيوية (الاهتمام والتنوع والشدة في الطابع)\nمثال: كانت الحقبة البيوريتانية تفتقر إلى الحيوية / صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / نَجْمِيَّة / ضوء النجوم (ضوء النجوم)",
 "せいさいかん": "نُبيب منوي (أي من النبيبات الطويلة الملتوية العديدة في الخصية والتي تعد مواقع نضوج الحيوانات المنوية)",
 "せいさいぼう": "خلية تناسلية, خلية جرثومية (حيوان منوي أو بويضة؛ خلية مسؤولة عن نقل الحمض النووي للجيل القادم) / أرومة نطفية, طليعة منوية (مشيج غير ناضج تنتجه الخلية المنوية؛ يتطور إلى حيوان منوي)",
 "せいさく": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / إِنْتَاج / سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر) / سَنَد تَأْمِين ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً)\nمثال: عاد إلى السياسة. / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / إِنْتَاج / حبل منوي (بنية تشبه الحبل تعلق الخصية داخل كيس الصفن وتحتوي على الأسهر وأوعية وأعصاب أخرى) / حبل التثبيت التلقائي, حبل ثابت (حبل يستخدم بدلاً من حبل الفتح لفتح المظلة؛ يُربط أحد طرفيه بالطائرة والآخر بحقيبة المظلة، ويفتح المظلة بعد قفز المظلي من الطائرة)",
 "せいさくかんちょう": "مَعْنِيّ بِرَسْم السِّيَاسَات (يهتم بالسياسات العامة لا بالإدارة التنفيذية)",
 "せいさくけっていかてい": "مَعْنِيّ بِرَسْم السِّيَاسَات (يهتم بالسياسات العامة لا بالإدارة التنفيذية)",
 "せいさくけっていしゃ": "صَانِعُ سِيَاسَة (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいさくけんきゅうだいがくいんだいがく": "مَقْبِض",
 "せいさくしつ": "إِسْتُودِيُو",
 "せいさくしゃ": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / مُنْتِج",
 "せいさくしょ": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "せいさくじょ": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "せいさくじょうみゃくりゅう": "دوالي الخصية, قيلة دوالية (توسع الأوردة المرتبطة بالحبل المنوي في الخصيتين)",
 "せいさくひ": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "せいさくほうしん": "خط مشترك (خط هاتف يخدم مشتركين اثنين أو أكثر) / خط الحزب (سياسة مجموعة سياسية)\nمثال: فاز في تصويت على أساس خطوط الحزب",
 "せいさくりつあんしゃ": "صانع القرار, واضع السياسات (شخص يضع الخطة التي تتبعها حكومة أو شركة وما إلى ذلك)\nمثال: غالباً ما يتخذ صناع القرار القرار الصحيح لسبب خاطئ",
 "せいさつ": "اِنْعِكَاس, عَكْس",
 "せいさつよだつ": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "せいさべつ": "تمييز جنسي (التمييز (عادة في التوظيف) الذي يستبعد جنساً واحداً (عادة النساء) لصالح الجنس الآخر)",
 "せいさん": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / قَبْرِيّ, مَشْؤُوم (يوحي بشكل مروّع بالموت أو الأموات) / وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت. / مُسْتَعْمَرَة, مُسْتَوْطَنَة / تَصْفِية / إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية / إِنْتَاج / ضَبْط / تَنَاوُل, إِفْخَارِيسْتِيَا (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: تناول سامي سما. / حمض البروسيك, حمض الهيدروسيانيك (محلول لسيانيد الهيدروجين في الماء؛ تستخدم المحاليل الضعيفة في التبخير وفي تخليق المركبات العضوية) / صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا.",
 "せいさんかくけい": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "せいさんかじょう": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "せいさんかっけい": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "せいさんかんりこうがく": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "せいさんがわひどうきてつづき": "مُنْتِج",
 "せいさんげんば": "أرضية المصنع, صالة الإنتاج (مكان عمل يتكون من جزء من المصنع يضم الآلات)\nمثال: يتم العمل الإنتاجي في أرضية المصنع",
 "せいさんこうがく": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "せいさんこく": "أرض الوطن, البلد الأم (البلد الذي ولدت فيه)",
 "せいさんしき": "تَنَاوُل, إِفْخَارِيسْتِيَا (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: تناول سامي سما.",
 "せいさんしゃ": "مُنْتِج",
 "せいさんしゃぶっかしすう": "مؤشر أسعار الجملة, مؤشر أسعار المنتجين (مؤشر للتغيرات في أسعار الجملة)",
 "せいさんしゅだん": "وَسَائِل الْإِنْتَاج",
 "せいさんしょ": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "せいさんせい": "إنْتَاجِيَّة",
 "せいさんだか": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "せいさんちゅうし": "إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "せいさんちゅうどく": "تسمم بالسيانيد (تسمم بسبب تناول أو استنشاق السيانيد؛ شائع في الدخان الناتج عن الحرائق والمواد الكيميائية الصناعية)",
 "せいさんてき": "خَصِب, غَنِيّ (يَتَّسِمُ بِالخُصُوبَة الشَّدِيدَة وَالإِنْتَاجِيَّة العَالِيَة) / خصب, مثمر (ينتج أو قادر على الإنتاج (خاصة بغزارة)) / إنتاجي, توليدي (لديه القدرة على الإنتاج أو الابتكار) / مُثْمِر, مُنْتِج (يُسفِر عن نتائج إيجابية)\nمثال: أرض زراعية منتجة / إيجابي, بناء (يبني أو يميل إلى البناء أو التحسين أو تعزيز التنمية) / بَنَّاء (يركز على ما هو جدير بالثناء أو مبعث على الأمل أو في مصلحة الخير)\nمثال: نقد بناء",
 "せいさんとりひき": "حساب مفتوح (طلب ائتماني غير مدفوع) / حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "せいさんにん": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة) / حارس قضائي, مُصَفٍّ ((قانون) شخص (يعين عادة من قبل محكمة) يقوم بتسييل الأصول أو الحفاظ عليها لصالح الأطراف المتضررة) / قاتل (مجرم يرتكب جريمة قتل (من يقوم بالقتل المتعمد غير المشروع لإنسان آخر))",
 "せいさんはんばいざいこ": "پْسِي, بْسِي",
 "せいさんひ": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "せいさんひん": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "せいさんぶつ": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "せいさんやく": "عامل قلوي, مضاد للحموضة (عامل يقاوم أو يعادل الحموضة (خاصة في المعدة))",
 "せいさんりょく": "إنْتَاجِيَّة",
 "せいさんカリ": "سيانيد البوتاسيوم",
 "せいさんカリウム": "سيانيد البوتاسيوم",
 "せいさんコスト": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "せいさんライン": "خط إنتاج, خط تجميع (نظام ميكانيكي في مصنع يتم بموجبه نقل السلعة عبر مواقع يتم فيها إجراء عمليات متتالية عليها)",
 "せいざ": "كَوْكَبَة / برج, برج فلكي ((علم التنجيم) واحدة من 12 منطقة متساوية تنقسم إليها دائرة البروج) / اَلْكُرْسِيّ اَلرَّسُولِيّ",
 "せいざい": "مِنْشَار / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل. / تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / تعبير, صياغة (أسلوب التعبير عن النفس) / تركيبة, مستحضر (مادة محضرة وفقاً لصيغة محددة)\nمثال: وصف الطبيب مستحضراً تجارياً للدواء",
 "せいざいこうじょう": "مَنْشَرَة",
 "せいざいしょ": "مَنْشَرَة",
 "せいざず": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء)",
 "せいざとうえいき": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية) / قبة فلكية (جهاز بصري لعرض صور الأجرام السماوية والظواهر الفلكية الأخرى على السطح الداخلي لقبة نصف كروية) / بلانيتاريوم, قبة فلكية (مبنى يضم أداة لعرض مواقع الكواكب على سقف مقبب)",
 "せいざん": "بقاء (شيء ينجو ويبقى) / انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة) / بقاء, نجاة (حالة البقاء على قيد الحياة) / تَنَاوُل, إِفْخَارِيسْتِيَا (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: تناول سامي سما. / قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري. / ولادة حية (ولادة جنين حي (بغض النظر عن مدة الحمل))",
 "せいざんしゃ": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "せいざんじ": "ولادة حية (ولادة جنين حي (بغض النظر عن مدة الحمل))",
 "せいざんりつ": "ولادة حية (ولادة جنين حي (بغض النظر عن مدة الحمل))",
 "せいし": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد)) / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر) / تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى) / بصر سوي, سواء البصر ((طب العيون) الحالة الانكسارية الطبيعية للعين حيث يوجد تركيز واضح للضوء على الشبكية) / نُطْفَة, حَيَوَان مَنَوِيّ (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / نُطْفَة, مَنْي (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل / صناعة الورق (حرفة صنع الورق) / نَذْر / نَذَرَ / غزل (صنع الخيوط) / تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟ / تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة) / تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / اِنْعِكَاس, عَكْس / سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة ويمكن أن تستمر حتى الشيخوخة) / حبل منوي (بنية تشبه الحبل تعلق الخصية داخل كيس الصفن وتحتوي على الأسهر وأوعية وأعصاب أخرى)",
 "せいしいん": "صوت مهموس (صامت يُنتج بدون صوت من الحبال الصوتية)",
 "せいしがん": "بصر سوي, سواء البصر ((طب العيون) الحالة الانكسارية الطبيعية للعين حيث يوجد تركيز واضح للضوء على الشبكية)",
 "せいしき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / حمام إسفنجي (غسل الجسم بإسفنجة أو قطعة قماش مبللة بدلاً من الغمر في حوض الاستحمام)",
 "せいしきどう": "مدار ثابت بالنسبة للأرض (مدار متزامن مع الأرض ثابت بالنسبة لموقع على الأرض)",
 "せいしけいせい": "تَكَوُّن اَلْحَيَوَانَات اَلْمَنَوِّيَّة",
 "せいしげき": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "せいしこうじょう": "مصنع ورق (طاحونة يتم فيها تصنيع الورق) / بكرة غزل الحرير (بكرة تستخدم في غزل الحرير إلى خيوط)",
 "せいしさい": "أحد الشعانين (الأحد الذي يسبق عيد الفصح)",
 "せいしさいぼう": "أرومة نطفية, طليعة منوية (مشيج غير ناضج تنتجه الخلية المنوية؛ يتطور إلى حيوان منوي)",
 "せいししつりょう": "كتلة السكون ((في الفيزياء) كتلة الجسم عند قياسها عندما يكون الجسم في حالة سكون بالنسبة للمراقب، وهي خاصية متأصلة في الجسم)",
 "せいしすう": "تعداد الحيوانات المنوية (عملية تقدير عدد الحيوانات المنوية في القذف) / تَعْدَاد الحَيَوَانَات المَنَوِيَّة, عَدّ النِّطَاف (عدد الحيوانات المنوية في القذف)\nمثال: يستخدم تعداد الحيوانات المنوية كمؤشر لخصوبة الذكر",
 "せいしつ": "طَبِيعَة, طبيعة / نَوْعِيَّة, جَوْدَة / وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "せいしでんい": "جهد الراحة (فرق الجهد بين جانبي غشاء خلية عصبية عندما لا تقوم الخلية بتوصيل نبضة)",
 "せいしふめい": "مَفْقُود",
 "せいしめんたい": "رباعي سطوح منتظم (رباعي سطوح ذو أربعة أوجه مثلثة متساوية الأضلاع)",
 "せいしゃ": "ضربة طائرة (رد تنس يتم بضرب الكرة قبل ارتدادها) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية)\nمثال: فاجأتهم رشقنا من الجناح الأيسر / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "せいしゃいん": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せいしゃく": "صُوَاع",
 "せいしゅう": "أسبوع الآلام, الأسبوع المقدس (الأسبوع الذي يسبق عيد الفصح)",
 "せいしゅく": "صَامِت, سَاكِت / كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "せいしゅくに": "بِهُدُوء",
 "せいしゅん": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "せいしゅんき": "مُرَاهَقَة",
 "せいしょ": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة) / إِنْجِيل\nمثال: 君は聖書に手をのせて誓うべきだ。 — ينبغي أن تقسم ويدك على الإنجيل. / كراسة إجابة زرقاء (كتيب أزرق يستخدم في الجامعات لكتابة الامتحانات) / الدليل الاجتماعي (سجل للأشخاص البارزين اجتماعياً) / كتاب أزرق (تقرير تنشره الحكومة البريطانية؛ يغلف عادة بغلاف أزرق) / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "せいしょう": "اِنْتِصَار, نَصْر / صحة جيدة, عافية (حالة التمتع بالنشاط والخلو من الأمراض الجسدية أو العقلية) / إِجَّامَة / نَجْمَة",
 "せいしょうどう": "جنس, غريزة جنسية (مجموع المشاعر الناتجة عن الرغبة في إشباع الدوافع الجنسية)\nمثال: أراد حياة جنسية أفضل",
 "せいしょうねん": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "せいしょかいしゃくがく": "تأويلي, تفسيري (متعلق بالتفسير (خاصة للنصوص الدينية))",
 "せいしょく": "لون أساسي (أي من ثلاثة ألوان يمكن الحصول منها على جميع الألوان الأخرى عن طريق المزج) / تَكَاثُر / حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / احْتِجَاب / الغَيْبَة / وِزَارَة / حياكة, نسيج (صنع القماش) / حمام إسفنجي (غسل الجسم بإسفنجة أو قطعة قماش مبللة بدلاً من الغمر في حوض الاستحمام)",
 "せいしょくいりょう": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "せいしょくき": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "せいしょくきかん": "عضو تناسلي, عضو جنسي (أي عضو يشارك في التكاثر الجنسي)",
 "せいしょくさいぼう": "خلية تناسلية, خلية جرثومية (حيوان منوي أو بويضة؛ خلية مسؤولة عن نقل الحمض النووي للجيل القادم)",
 "せいしょくしゃ": "قِسِّيس, كَاهِن (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / عامل بالجنس, عاملة بالجنس (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "せいしょくしょう": "زرقة",
 "せいしょくせん": "غُدَّة تَناسُلِيَّة",
 "せいしょくせんしげきホルモン": "غونادوتروبين, موجهة الغدد التناسلية (هرمون تفرزه الغدة النخامية الأمامية والمشيمة؛ يحفز الغدد التناسلية ويتحكم في النشاط الإنجابي)",
 "せいしょくのうりょく": "خُصُوبَة",
 "せいしょくほじょいりょう": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "せいしょくほじょぎじゅつ": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "せいしょっき": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "せいしょほう": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب) / عِلْم الْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいしょり": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "せいしん": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / مَوْقِف, سُلُوك / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / طَازَج, طَازَة / عَذْب / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم / سيش, موجة راكدة (موجة على سطح بحيرة أو خليج غير ساحلي؛ ناجمة عن اضطرابات جوية أو زلزالية)",
 "せいしんあんていざい": "عقار مهدئ, مهدئ أعصاب (دواء يستخدم لتقليل التوتر أو الشد العصبي دون تقليل الوضوح العقلي)",
 "せいしんあんていやく": "عقار مهدئ, مهدئ أعصاب (دواء يستخدم لتقليل التوتر أو الشد العصبي دون تقليل الوضوح العقلي)",
 "せいしんいがく": "الطِّبّ النَّفْسِيّ",
 "せいしんいがくしゃ": "طَبِيب نَفْسَانِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "せいしんいじょう": "اضطراب نفسي",
 "せいしんいじょうしゃ": "مَجْنُون, مَخْبُول",
 "せいしんうんどう": "نفسي حركي (متعلق بالأحداث العقلية التي لها نتائج حركية أو العكس)",
 "せいしんえいせい": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "せいしんえいせいがく": "الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "せいしんえいせいほう": "الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "せいしんか": "الطِّبّ النَّفْسِيّ",
 "せいしんかい": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية) / طَبِيب نَفْسَانِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "せいしんかいし": "طَبِيب نَفْسَانِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "せいしんかびょういん": "مستشفى الأمراض العقلية, مصح نفسي (مستشفى للأشخاص غير المتزنين عقلياً)",
 "せいしんかんのう": "تَخَاطُر",
 "せいしんきょう": "الْإِسْلَام",
 "せいしんげか": "جراحة نفسية (جراحة دماغ على مرضى بشريين تهدف إلى تخفيف مشاكل عقلية أو سلوكية حادة ومستعصية)",
 "せいしんさくらん": "ارتباك, تشوش (حالة عقلية تتميز بنقص في وضوح الفكر والسلوك ونظامهما)\nمثال: تشوش في الانطباعات",
 "せいしんしっかん": "اضطراب نفسي",
 "せいしんしゅぎ": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "せいしんしゅぎしゃ": "روحاني (متعلق بالروحانية أو متصل بها) / وسيط روحي (شخص يعمل كوسيط بين الأحياء والأموات)\nمثال: استشار العديد من الوسطاء",
 "せいしんしょうがい": "اضطراب نفسي",
 "せいしんしんけい": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي) / عُصابِيّ, مَرِيض نَفْسِيّ (شخص يعاني من العصاب)",
 "せいしんしんけいか": "طب النفس العصبي (فرع الطب المعني بالاضطرابات العقلية المنسوبة لأمراض الجهاز العصبي)",
 "せいしんしんけいしょう": "عصاب, عصاب نفسي (اضطراب عقلي أو في الشخصية لا يعزى إلى أي خلل عصبي أو عضوي معروف)",
 "せいしんしんけいしょうかんじゃ": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي) / عُصابِيّ, مَرِيض نَفْسِيّ (شخص يعاني من العصاب)",
 "せいしんじ": "مَسْجِد, جَامِع (هو مكان السُجُوْد، بناء كان أم لا، عاما كان أم خاصا؛ المُصَلَّى)\nمثال: دخل إلى المسجد.",
 "せいしんじょうたい": "حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "せいしんせい": "رُوحَانِيَّة, رَوْحَانِيَّة",
 "せいしんせいい": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "せいしんせかい": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "せいしんそくていがく": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "せいしんちたい": "تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية)",
 "せいしんてき": "عَقْلِيّ",
 "せいしんてきくつう": "عذاب نفسي, كرب عقلي (ألم عاطفي مستمر ومضجر)",
 "せいしんてきしどうしゃ": "زعيم ديني, قائد روحي (قائد في الشؤون الدينية أو المقدسة)",
 "せいしんねんれい": "عمر عقلي (مستوى التطور الفكري كما يقاس باختبار الذكاء)",
 "せいしんはったつ": "نشوء نفسي (مصطلح عام لأصل وتطور أي جانب من جوانب العقل تقريبًا) / منشأ نفسي (تطور اضطراب ما في حياة الفرد ناتج عن عوامل نفسية بدلاً من عوامل فسيولوجية)",
 "せいしんはったつがく": "تكويني نفسي (متعلق بأصل وتطور العقل) / نفسي المنشأ (متعلق بالسبب النفسي للاضطراب)",
 "せいしんはったつちたい": "تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية)",
 "せいしんびょう": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "せいしんびょうい": "طَبِيب نَفْسَانِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "せいしんびょういん": "مُسْتَشْفَى الأَمْرَاض النَفْسِيَّة (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "せいしんびょうしつ": "اعتلال نفسي, مرض عقلي (أي مرض يصيب العقل؛ الحالة النفسية لشخص يعاني من مشاكل عاطفية أو سلوكية خطيرة بما يكفي لتطلب تدخل الطب النفسي)",
 "せいしんびょうしつしゃ": "سِيكُوباتِيّ, مُعْتَلّ اجْتِماعِيّاً (شخص ذو شخصية معادية للمجتمع)",
 "せいしんびょうしゃ": "مَجْنُون, مَخْبُول",
 "せいしんびょうせい": "ذُو اعْتِلَالٍ نَفْسِيّ, سِيكُوبَاتِيّ (يعاني من اضطراب نفسيّ غير مُشخَّص)",
 "せいしんびょうりがく": "طب نفسي (فرع الطب المعني بتشخيص وعلاج الاضطرابات العقلية) / علم النفس المرضي, علم النفس غير السوي (فرع علم النفس المعني بالسلوك غير الطبيعي)",
 "せいしんぶつりがく": "فيزياء نفسية (فرع علم النفس المعني بالعلاقات الكمية بين المحفزات الفيزيائية وتأثيراتها النفسية)",
 "せいしんぶんせき": "تحليل نفسي, علم نفس الأعماق (مجموعة من التقنيات لاستكشاف الدوافع الكامنة وطريقة لعلاج الاضطرابات العقلية المختلفة؛ تستند إلى نظريات سيغموند فرويد)\nمثال: أوصى طبيبه بالتحليل النفسي",
 "せいしんぶんせきい": "محلل نفسي (ممارس مرخص للتحليل النفسي)",
 "せいしんぶんせきがく": "تحليل نفسي, علم نفس الأعماق (مجموعة من التقنيات لاستكشاف الدوافع الكامنة وطريقة لعلاج الاضطرابات العقلية المختلفة؛ تستند إلى نظريات سيغموند فرويد)\nمثال: أوصى طبيبه بالتحليل النفسي",
 "せいしんぶんせきがくしゃ": "محلل نفسي (ممارس مرخص للتحليل النفسي)",
 "せいしんぶんれつしょう": "فُصَام, الْفِصَام الذُّهَانِيّ",
 "せいしんぶんれつびょう": "فُصَام, الْفِصَام الذُّهَانِيّ",
 "せいしんぶんれつびょうかんじゃ": "فُصَامِيّ (مصاب بنوع من أنواع الفصام) / شيزودي, فصامي (من أو متعلق بـ أو مميز للفصام) / فُصامِيّ, مُصاب بِالفُصام (شخص مصاب بالفصام (شيزوفرينيا))",
 "せいしんほけん": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "せいしんほけんしんぱんいん": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "せいしんほけんふくしほう": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "せいしんほけんほう": "صِحَّة نَفْسِيَّة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "せいしんやくりがく": "علم الأدوية النفسية (دراسة الأدوية التي تؤثر على العقل)",
 "せいしんりきがく": "ديناميكا نفسية (فرع علم النفس الاجتماعي الذي يتعامل مع العمليات والعواطف التي تحدد النفسية والدافع) / دِينَامِيكِيَّة نَفْسِيَّة (الترابط بين العمليات والعواطف الواعية وغير الواعية التي تحدد الشخصية والدوافع)",
 "せいしんりきどう": "ديناميكا نفسية (فرع علم النفس الاجتماعي الذي يتعامل مع العمليات والعواطف التي تحدد النفسية والدافع) / دِينَامِيكِيَّة نَفْسِيَّة (الترابط بين العمليات والعواطف الواعية وغير الواعية التي تحدد الشخصية والدوافع)",
 "せいしんりょうほう": "علاج نفسي (علاج المشاكل العقلية أو العاطفية بوسائل نفسية) / الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "せいしんりょうほうか": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "せいしんろん": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "せいしエネルギー": "طاقة السكون (الطاقة المكافئة لكتلة جسيم في حالة سكون في إطار مرجعي قصوري؛ تساوي كتلة السكون مضروبة في مربع سرعة الضوء)",
 "せいしバンク": "بَنْكُ الْمَنِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "せいじ": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة. / أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها) / متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "せいじうんどう": "حملة انتخابية (حملة المرشح ليتم انتخابه) / حملة, حملة سياسية (سباق بين المرشحين لمنصب منتخب)\nمثال: أدرت حملته لمنصب الحاكم",
 "せいじか": "سِيَاسِيّ, سِيَاسِيَّة",
 "せいじがく": "عُلُوم سِيَاسِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "せいじがくしゃ": "عَالِم سِيَاسِيّ, عَالِمَة سِيَاسِيَّة (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せいじきょく": "مَكْتَب سِيَاسِيّ (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "せいじけいざいがく": "اقتصاد, علم الاقتصاد (فرع العلوم الاجتماعية الذي يتعامل مع إنتاج وتوزيع واستهلاك السلع والخدمات وإدارتها)",
 "せいじけんきん": "تبرع سياسي (مساهمة تُقدم لسياسي أو حملة سياسية أو حزب سياسي)",
 "せいじこうどういいんかい": "لجنة العمل السياسي (لجنة تشكلها مجموعة مصالح خاصة لجمع الأموال لمرشحيها السياسيين المفضلين)",
 "せいじしゅう": "سَجِين سِيَاسِيّ, مُعْتَقَل سِيَاسِيّ",
 "せいじじょう": "سِيَاسِيّ / سياسياً (فيما يتعلق بالحكومة) / سياسياً (فيما يتعلق بالعلاقات الاجتماعية التي تنطوي على السلطة)\nمثال: وحدات منظمة سياسياً",
 "せいじせいど": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "せいじたいせい": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "せいじつ": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص / عطلة دينية, يوم مقدس (يوم محدد للاحتفال الديني) / عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "せいじてき": "سِيَاسِيّ",
 "せいじてきしどうしゃ": "سياسي (شخص نشط في السياسة الحزبية)",
 "せいじてきにただしい": "صائب سياسيا (يظهر الصواب السياسي)",
 "せいじとカネ": "كْلِيبْتُقْرَاطِيَّة",
 "せいじにん": "هُوِيَّة جَنْدَرِيَّة",
 "せいじはん": "سَجِين سِيَاسِيّ, مُعْتَقَل سِيَاسِيّ",
 "せいじほう": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب) / عِلْم الْإِمْلَاء, هِجَاء (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいじほご": "لُجُوء سِيَاسِيّ",
 "せいじぼうめい": "لُجُوء سِيَاسِيّ",
 "せいじゃ": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "せいじゃく": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "せいじゃくしゅぎ": "سكونية (شكل من أشكال التصوف الديني يتطلب الانسحاب من كل جهد بشري والتأمل السلبي في الله)",
 "せいじや": "سِيَاسِيّ, سِيَاسِيَّة",
 "せいじゅ": "شَجَرَةُ الْمِيلَادِ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "せいじゅうにめんたい": "اثنا عشري سطوح منتظم (اثنا عشري سطوح ذو اثني عشر مخمساً منتظماً كأوجه)",
 "せいじゅく": "نَضْج",
 "せいじゅくき": "مُرَاهَقَة",
 "せいじゅくど": "نَضْج",
 "せいじゅくぶんれつ": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده)) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "せいじゅん": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة) / قَانُونِيّ, مُعْتَمَد (يتوافق مع القواعد الأرثوذكسية أو المعترف بها) / أَسَاسِيّ, قَانُونِيّ (مُختزَل إلى أبسط شكل وأكثره دلالة دون فقدان العمومية) / قانوني كنسي (من أو يتعلق بالقانون الكنسي أو مطلوب بموجبه) / قانوني مقدس (يظهر في قانون كتابي مقدس)\nمثال: كتاب قانوني من العهد الجديد المسيحي",
 "せいじょ": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "せいじょう": "عَادِيّ / طَبِيعِيّ / صَافٍ, اَلصَّافِي / قَيْصَر, إِمْبْرَاطُور / طَبِيعَة, طبيعة / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "せいじょうか": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "せいじょうき": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "せいじょうきしんぶん": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "せいじょうたい": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "せいじょうど": "نَظَافَة",
 "せいじょうひしゅ": "سرطان الخصية, ورم منوي (ورم خبيث في الخصية؛ يحدث عادة عند الرجال الأكبر سنًا)",
 "せいじょうむく": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "せいじょうめん": "قطن طبي, قطن ماص (قطن أصبح ماصاً عن طريق إزالة الشمع الطبيعي)",
 "せいじょすう": "جُزْء قَاسِم, قَاسِم تَامّ (عدد صحيح هو قاسم تام لكمية معينة)\nمثال: 4 هو قاسم تام لـ 12",
 "せいじようこう": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "せいじりろん": "أيديولوجيا, توجه سياسي (توجه يميز تفكير مجموعة أو أمة)",
 "せいじん": "بَالِغ, رَاشِد\nمثال: その映画は成人しかみられない。 — هذا الفيلم للكبار فقط. / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "せいじんき": "بلوغ, سن الرشد (حالة (ومسؤوليات) الشخص الذي بلغ النضج) / رشد, سن البلوغ (الفترة الزمنية في حياتك بعد توقف نموك الجسدي واكتمال تطورك)",
 "せいじんきょういく": "تعليم الكبار (دورة (عبر محاضرات أو بالمراسلة) للبالغين غير المنخرطين في دراسة رسمية)",
 "せいじんきょういくきょうかい": "تعليم الكبار (دورة (عبر محاضرات أو بالمراسلة) للبالغين غير المنخرطين في دراسة رسمية)",
 "せいじんくんし": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "せいじんじょせい": "أنثى بالغة, امرأة (شخص بالغ أنثى (مقابل الرجل))\nمثال: كانت المرأة تدير المنزل بينما كان الرجل يصطاد",
 "せいじんだんし": "ذكر بالغ, رجل (شخص بالغ ذكر (مقابل المرأة))\nمثال: كان هناك امرأتان وستة رجال في الحافلة",
 "せいじんだんせい": "ذكر بالغ, رجل (شخص بالغ ذكر (مقابل المرأة))\nمثال: كان هناك امرأتان وستة رجال في الحافلة",
 "せいじんねんれい": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "せいじんむけ": "بَالِغ, رَاشِد",
 "せいじシステム": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة)",
 "せいす": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "せいすい": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة) / أَنَاقَة / رَفَاهَة, خَيْر / شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة) / مَاء مُقَدَّس (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء. / بَوْل",
 "せいすいばん": "حوض الماء المقدس (حوض للماء المقدس) / كوب شرب قديم (وعاء شرب قديم)",
 "せいすう": "عَدَد صَحِيح (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / عَدَد مُوجَب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "せいする": "لِجَام, صُرْع / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "せいず": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء) / رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية) / صياغة, كتابة مسودة (كتابة نسخة أولية ليتم استكمالها وتنقيحها لاحقًا) / رسم (إنشاء صور فنية أو مخططات)\nمثال: تعلم الرسم من والده",
 "せいずい": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "せいずか": "رسام خرائط (شخص يصنع الخرائط)",
 "せいずしつ": "غرفة الاستقبال الرسمية, غرفة الصالون (غرفة رسمية يمكن فيها استقبال الزوار والترفيه عنهم) / غرفة صالون, مقصورة قطار خاصة (مقصورة خاصة في عربة النوم بها ثلاثة أسرّة ومرحاض)",
 "せいずばん": "لوحة رسم هندسي (لوح أملس يوضع عليه الورق لعمل الرسومات)",
 "せいずようし": "ورق رسم (ورق معد خصيصاً للاستخدام في الرسم الهندسي أو الفني)",
 "せいせい": "الغَرْب (نقطة البوصلة الأصلية التي تكون عند 270 درجة) / خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / تكرير, تنقية (عملية إزالة الشوائب (كما هو الحال من الزيت أو المعادن أو السكر، إلخ)) / مَضْبُوط / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة. / مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين) / مُدَبَّر, مُرَتَّب (منظم أو مخطط له مسبقاً) / مرتب, منسق (موضع أو مرتب بنوع معين من النظام)\nمثال: قطع الشطرنج المرتبة بعناية / دَجِر / حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً) / حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية)) / عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / قُدْسِيَّة",
 "せいせいかつ": "ممارسة جنسية, نشاط جنسي (الأنشطة المرتبطة بالجماع الجنسي)\nمثال: مارسوا الجنس في المقعد الخلفي",
 "せいせいき": "مُوَلِّد / مُوَلِّد كَهْرَبَائِيّ",
 "せいせいきそく": "إِنْتَاج",
 "せいせいじょ": "مِصْفَاة",
 "せいせいとう": "سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "せいせいぶんぽう": "نحو توليدي ((لسانيات) نوع من النحو يصف التركيب من خلال مجموعة من القواعد المنطقية التي يمكن أن تولد كل الجمل النحوية في لغة ما وتعطيها الوصف الهيكلي الصحيح)",
 "せいせき": "تَسَبَّب / نَتِيجَة / إِنْجَاز",
 "せいせきひょう": "التقرير المدرسي عن الطالب",
 "せいせつ": "مُمَاسّ",
 "せいせん": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة) / حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / طَازَج, طَازَة / عَذْب / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / غُدَّة تَناسُلِيَّة / نزوح جماعي, هجرة (رحلة لمجموعة كبيرة للهروب من بيئة معادية) / حديد غفل (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "せいせんしげきホルモン": "غونادوتروبين, موجهة الغدد التناسلية (هرمون تفرزه الغدة النخامية الأمامية والمشيمة؛ يحفز الغدد التناسلية ويتحكم في النشاط الإنجابي)",
 "せいせんしゅ": "أَسَاسِيّ فِي الفَرِيق (عضو دائم وأساسيّ في الفريق) / أَسَاسِيّ, مِنَ الصَّفِّ الْأَوَّلِ (من أعضاء الفريق الأساسيين؛ ليس بديلاً)",
 "せいせんしょくたい": "كْرُومُوسُوم جِنْسِيّ ((علم الوراثة) كروموسوم يحدد جنس الفرد)\nمثال: تمتلك الثدييات عادة اثنين من الكروموسومات الجنسية",
 "せいせんしょくひん": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "せいせんしょくりょうひん": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "せいせんてきじょ": "إِخْصَاء",
 "せいぜい": "على الأكثر, كحد أقصى (ليس أكثر من)\nمثال: أنفق 20 دولاراً على الغداء كحد أقصى / قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "せいぜつ": "مُتَوَهِّج بِحُمْرَة (يَلْمَع بِتَوَهُّجٍ أَحْمَرَ غَيْرِ طَبِيعِيّ كَالنَّار خِلَال الدُّخَان) / كَامِد, مُصْفَرّ (ذو لون شاحب مريض ومُنفِّر) / صَادِم, فَظِيع (صارخ الوضوح والتصوير؛ يتسم بالإثارة المبالغ فيها) / فَظِيع, مُرَوِّع (مُرْعِبٌ فِي ضَرَاوَتِهِ أَوْ وَحْشِيَّتِه)",
 "せいぜん": "منضبط, منظم (خالٍ من العنف أو الاضطراب) / مُنَظَّم, نَظِيف (نَظِيفٌ أَوْ مُنَظَّمٌ بِشَكْلٍ جَيِّد) / تمرجي, ساعي المستشفى (مرافق مستشفى ذكر لديه واجبات عامة لا تشمل العلاج الطبي للمرضى) / جندي مراسلة, مراسل (جندي يعمل كمساعد لضابط أعلى رتبة)\nمثال: حشد منظم واجه الرئيس",
 "せいそ": "مُنَظَّم, نَظِيف",
 "せいそう": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة / بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال) / تَنْظِيف / بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية. / مُنْعِش / دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة) / تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات) / تراصف, تطبقات (فعل أو عملية ترتيب الأشخاص في طبقات أو شرائح اجتماعية) / تطبق (تكوين طبقي) / ترسب طبقي, تطبّق (التشكيل أو الترسيب في طبقات) / سَخِيف, مُثِير لِلشَّفَقَة (يُثِير شَفَقَةً مَشُوبَةً بِالاِزْدِرَاء) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء)",
 "せいそういん": "مُنَظِّف / مُنَظِّفَة",
 "せいそうえん": "التهاب الخصية (التهاب إحدى الخصيتين أو كلتيهما؛ يتميز بالألم والتورم)",
 "せいそうけん": "سْتْرَاتُوسْفِير",
 "せいそうさぎょういん": "جَامِع الْمُخَلَّفَات, جَامِعَة الْمُخَلَّفَات (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "せいそうしゃ": "شاحنة القمامة (شاحنة لجمع النفايات المنزلية)",
 "せいそうしゅよう": "سرطان الخصية, ورم منوي (ورم خبيث في الخصية؛ يحدث عادة عند الرجال الأكبر سنًا)",
 "せいそうじょうたい": "بَرْبَخ",
 "せいそうじょうたいえん": "التهاب البربخ (التهاب مؤلم في البربخ)",
 "せいそうふ": "عامل نظافة الشوارع, كنّاس الشوارع (عامل يعمل لتنظيف الشوارع (خاصة من يعمل لدى قسم الصرف الصحي في البلدية))",
 "せいそく": "صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك. / عَكُوْسَة / أَقَام, قَطَن (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "せいそくか": "تسوية, تنظيم (فعل تحقيق التوحيد؛ جعله منتظماً) / تسوية, تنظيم (حالة ما تم جعله نظامياً (أو أكثر انتظاماً))",
 "せいそくかんきょう": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "せいそくち": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "せいそんぽ": "تَأْمِين عَلَى اَلْحَيَاة",
 "せいぞう": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة / صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / قُونَة, أَيْقُونَة / أَيْقُونَة / التِّبِت, تُبَّت",
 "せいぞうき": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞうぎょうしゃ": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞうこうじょう": "مصنع, معمل (منشأة تتكون من مبنى واحد أو أكثر بمرافق للتصنيع)",
 "せいぞうしゃ": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞうしょ": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうしょこゆうきごう": "مصنع, معمل (منشأة تتكون من مبنى واحد أو أكثر بمرافق للتصنيع)",
 "せいぞうじょ": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうじょう": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうはんばい": "تكامل رأسي (الاستيعاب في شركة واحدة لعدة شركات تعمل في جميع جوانب تصنيع المنتج من المواد الخام إلى التوزيع)",
 "せいぞうば": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "せいぞうぶつ": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "せいぞうもと": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "せいぞく": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せいぞろい": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "せいぞん": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "せいぞんきかん": "حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "せいぞんけん": "حق الحياة (الحق في العيش) / مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "せいぞんしゃ": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "せいぞんりょく": "حيوية, قابلية الحياة ((للكائنات الحية) القدرة على النمو والتطور الطبيعي) / جَدْوَى, قَابِلِيَّة التَّطْبِيق (القدرة على الإنجاز بطريقة عملية ومفيدة)",
 "せいた": "لوح إسناد, لوح ظهر (لوح يستخدم لدعم ظهر شخص أو شيء ما) / لوحة السلة (لوحة رأسية مرتفعة مثبت بها سلة؛ تستخدم للعب كرة السلة)\nمثال: ارتدت الكرة من اللوحة",
 "せいたい": "شكل الحكومة, نظام سياسي (أعضاء منظمة اجتماعية الذين هم في السلطة) / كَائِن حَيّ / عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / اَوْتَار صَوْتِيَّة, أَحْبَال صَوْتِيَّة / حَبْل سُرِّيّ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير. / سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد / بَالِغ, رَاشِد / مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا. / كحلي",
 "せいたいえん": "التهاب الحبال الصوتية (التهاب الحبال الصوتية) / التهاب الحبل (التهاب الحبل المنوي أو الحبال الصوتية أو الطيات الصوتية)",
 "せいたいかいぼう": "تشريح الأحياء (فعل إجراء عمليات على الحيوانات الحية (خاصة في البحث العلمي))",
 "せいたいかんきょう": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいたいがく": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいたいけい": "نِظَام بِيئِي (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "せいたいこうがく": "البيونيك, الهندسة الحيوية (تطبيق المبادئ البيولوجية على دراسة وتصميم الأنظمة الهندسية (خاصة الأنظمة الإلكترونية))",
 "せいたいじ": "حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "せいたいじこせいぎょ": "ارتجاع بيولوجي (برنامج تدريبي يُعطى فيه الشخص معلومات حول العمليات الفسيولوجية (مثل معدل ضربات القلب) بهدف التحكم الواعي بها)",
 "せいたいてき": "بِيئِيّ, إِيكُولُوجِيّ",
 "せいたいてきちい": "تخصص بيئي, مكانة بيئية ((علم البيئة) وضع الكائن الحي داخل بيئته ومجتمعه (الذي يؤثر على بقائه كنوع))",
 "せいたいにんしょう": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)",
 "せいたいはいりょう": "تَنَاوُل (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه) / أَفْخَارِسْتِيَا\nمثال: تناول سامي سما.",
 "せいたか": "طول القامة (خاصية كونه أطول من متوسط القامة) / ارتفاع, طُول (البعد الرأسي للامتداد؛ المسافة من قاعدة الشيء إلى قمته)",
 "せいたかくけい": "مضلع منتظم (مضلع جميع أضلاعه وجميع زواياه متساوية)",
 "せいたかしぎ": "أبو مغازل أسود الجناح (أبو مغازل من أوروبا وأفريقيا وآسيا ذو ريش أبيض في الغالب ولكن بأجنحة سوداء) / كُرْسُوع, أَبُو الْمَغَازِل",
 "せいたく": "إغواء للرذيلة, استدراج (فعل إغراء شخص للقيام بشيء خاطئ (مثل عرض الجنس مقابل المال)) / اسْتِجْدَاء, الْتِمَاس (طلب مبلغ من المال) / التماس (توسل موجه إلى شخص ذي مكانة أعلى)\nمثال: مناشدة لجمع المال للأطفال الجياع / مَذْبَح, هَيْكَل",
 "せいたけ": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "せいためんたい": "متعدد سطوح منتظم, مجسم أفلاطوني (أي واحد من خمسة مجسمات أوجهها مضلعات منتظمة متطابقة وزواياها متعددة السطوح متطابقة)",
 "せいたん": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / الجانب الغربي (الجانب الذي يقع في الغرب)",
 "せいたんさい": "الْكْرِيسْمَاس, الْمِيلَاد",
 "せいだい": "إِنْصَاف (أخْذُ نِصْف الشيء أو وصول النصف؛ العَدْل والتَقْسِيم بالتساوي بدون أن يظلم أي من الطرفين) / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد) / حَازِم, قَاطِع (قويّ وحاسم في التعبير أو الفعل) / حازم, فعال (يتميز بـ أو مليء بالقوة أو الشدة (غالباً ولكن ليس بالضرورة جسدياً))\nمثال: متحدث قوي",
 "せいだいきんようび": "الْجُمْعَة الْعَظِيمَة, جُمْعَة الْآلَام",
 "せいだん": "مَذْبَح, هَيْكَل",
 "せいだんそう": "صدع عادي (صدع مائل يبدو فيه أن الجدار المعلق قد انزلق لأسفل بالنسبة للجدار السفلي)",
 "せいち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف) / رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / دَقِيقٌ, رَقِيقٌ (بالغ الدقة والرهافة في التطوير)\nمثال: مقطع كمان رقيق / اَلْأَرْض اَلْمُقَدَّسَة / مَنْزِلَة, مَكَانَة / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "せいちか": "تَكْرِير",
 "せいちしき": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل)",
 "せいちしゅぎ": "حق الإقليم, حق المولد (المبدأ القائل بأن جنسية الشخص عند الولادة تتحدد بمكان ولادته)",
 "せいちせい": "عَدَم قَابِلِيَّة الدَّحْض, قَطْعِيَّة (صفة كون الشيء غير قابل للإنكار ولا يستحق الجدال حوله) / إيجابية (كمية أكبر من الصفر) / إِيجَابِيَّة, مُوَاتَاة (صفة كون الشيء مشجعاً أو مبشراً بنتيجة ناجحة) / إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "せいちゅう": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / نَزَاهَة, حِيَاد / إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية / تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة / حشرة كاملة, يافعة (حشرة بالغة ناتجة بعد التحول) / إيماجو, صورة الوالد ((في التحليل النفسي) صورة مثالية لشخص (عادة أحد الوالدين) تشكلت في الطفولة) / حيوان منوي, نطفة (الخلية التناسلية الذكرية؛ المشيج الذكري)\nمثال: الحيوان المنوي عبارة عن نواة محاطة بالقليل من المواد الخلوية الأخرى / وَفَاء, إِخْلَاص",
 "せいちょう": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / شَفَّاف / وَاضِح / اِهْتِمَام, اِنْتِبَاه / خاصية جنسية, صفة جنسية (تلك الخصائص (التشريحية والنفسية) التي ترتبط بقوة بجنس واحد مقارنة بالآخر) / نَغْمَة, نَغْم / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي) / تَنْظِيم / سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ / غريس",
 "せいちょういんし": "عامل نمو (بروتين يشارك في تمايز الخلايا ونموها)",
 "せいちょうかぶ": "أسهم نمو (أسهم شركة حققت مكاسب أسرع من المتوسط في الأرباح ومن المتوقع أن تستمر في ذلك)",
 "せいちょうき": "موسم النمو (الموسم الذي ينمو فيه المحصول بشكل أفضل)",
 "せいちょうげんご": "لغة نغمية (لغة تميز فيها النغمات المختلفة بين المعاني المختلفة)",
 "せいちょうさんぎょう": "صناعة نامية (صناعة تنمو بسرعة)",
 "せいちょうせき": "أرثوكلاز (فلسبار أحادي الميل أبيض أو ملون)",
 "せいちょうつう": "صعوبات البداية, مشاكل النمو (المشاكل التي تنشأ عند توسيع مؤسسة (خاصة في المراحل المبكرة)) / آلام النمو, معاناة النضج (ضيق عاطفي ينشأ خلال فترة المراهقة) / آلام النمو (ألم في العضلات أو المفاصل يعاني منه الأطفال أحياناً وغالباً ما يُعزى إلى النمو السريع)",
 "せいちょうりつ": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "せいちょうホルモン": "سوماتروبين, هرمون النمو (هرمون تنتجه الغدة النخامية الأمامية؛ يعزز النمو عند البشر)",
 "せいつうしゃ": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "せいてい": "تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / إقرار, سن (تمرير قانون من قبل هيئة تشريعية) / تشريع, قانون (وثيقة قانونية تدون نتيجة مداولات لجنة أو جمعية أو هيئة تشريعية)",
 "せいていほう": "تشريع, قانون تشريعي (قانون تم سنه من قبل هيئة تشريعية)",
 "せいてき": "جِنْسِيّ (المنسوب إلى الجِنْس؛ في : علاقة قانونية تربط فردا معينا بدولة معينة، قد تكون أصيلة أو مكتسبة)\nمثال: تعرض للتحرش الجنسي. / سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد / رَفَاهِيَة",
 "せいてきいたずら": "إِسَاءَة جِنْسِيَّة",
 "せいてきいやがらせ": "تَحَرُّش جِنْسِيّ",
 "せいてきかんけい": "اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "せいてきぎゃくたい": "إِسَاءَة جِنْسِيَّة",
 "せいてきこうふん": "استثارة جنسية (إثارة الرغبات الجنسية استعداداً للسلوك الجنسي)",
 "せいてきさべつ": "تمييز جنسي (التمييز (عادة في التوظيف) الذي يستبعد جنساً واحداً (عادة النساء) لصالح الجنس الآخر)",
 "せいてきしこう": "تَوَجُّه جِنْسِيّ, مَيْل جِنْسِيّ (فعل مطاوعة لوَجَّهَ؛ وجهته فتوجه؛ نحو كذا: أدار وجهه نحوه)\nمثال: توجه فاضل جنوبا.",
 "せいてきしょうどう": "جنس, غريزة جنسية (مجموع المشاعر الناتجة عن الرغبة في إشباع الدوافع الجنسية)\nمثال: أراد حياة جنسية أفضل",
 "せいてきとうさく": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "せいてきどれい": "الاستعباد الجنسي",
 "せいてきひがい": "إِسَاءَة جِنْسِيَّة",
 "せいてきふのう": "عَنَانَة, عُنَّة",
 "せいてきぼうこう": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "せいてきみりょく": "اِنْجِذَاب جِنْسِيّ, جَاذِبِيَّة جِنْسِيَّة",
 "せいてきよくぼう": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "せいてつ": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "せいてつしょ": "مصنع حديد (مكان العمل الذي يتم فيه صهر الحديد أو صنع المنتجات الحديدية)",
 "せいてつじょ": "مصنع حديد (مكان العمل الذي يتم فيه صهر الحديد أو صنع المنتجات الحديدية)",
 "せいてはことを": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せいてはことをしそんじる": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せいてはことをしそんずる": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せいてん": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية) / أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء / الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد / دليل جنسي (دليل يحتوي على تعليمات في التقنيات الجنسية؛ يهدف إلى تعزيز الحياة الجنسية للقارئ)",
 "せいてんか": "إعلان القداسة (فعل قبول شخص متوفى في قائمة القديسين)",
 "せいてんかん": "تغيير الجنس (تغيير في الخصائص الجنسية الجسدية للشخص (عن طريق الجراحة والعلاجات الهرمونية))",
 "せいてんかんしゃ": "مُتَحَوِّل جِنْسِيّ, مُتَحَوِّلَة جِنْسِيَّة",
 "せいてんかんしゅじゅつ": "تغيير الجنس (تغيير في الخصائص الجنسية الجسدية للشخص (عن طريق الجراحة والعلاجات الهرمونية))",
 "せいてんかんしょう": "التحول الجنسي (حالة يتماهى فيها الشخص مع جنس مختلف عن جنسه الجسدي)",
 "せいてんはくじつき": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "せいてんらんきりゅう": "اضطراب الهواء الصافي, مطب هوائي (اضطراب قوي في منطقة خالية من السحب يعرض الطائرات لتيارات صاعدة أو هابطة عنيفة)",
 "せいでん": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة) / إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية) / تَقْلِيد / كهرباء ساكنَة / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد / قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "せいでんいんじそうち": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "せいでんか": "شحنة موجبة (وجود نقص في الإلكترونات؛ وجود جهد كهربائي أعلى)",
 "せいでんき": "شحنة موجبة (وجود نقص في الإلكترونات؛ وجود جهد كهربائي أعلى) / كهرباء ساكنَة",
 "せいでんきょく": "مِصْعَد / أَنُود",
 "せいでんきプリンタ": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "せいでんたんい": "وحدة كهروستاتيكية (أي من وحدات الكهرباء المختلفة القائمة على قوى التفاعل بين الشحنات الكهربائية)",
 "せいでんば": "مجال كهروستاتيكي, مجال كهروسكوني (مجال كهربائي مرتبط بشحنات كهربائية ساكنة)",
 "せいでんようりょう": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / سعة كهربائية, مواسعة (ظاهرة كهربائية يتم فيها تخزين شحنة كهربائية)",
 "せいでんプリンタ": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "せいと": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / بعثة, حملة (رحلة منظمة لغرض معين) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: العديد من النزهات الصيفية إلى الشاطئ / إِجَّامَة / نَجْمَة / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)\nمثال: زيري صهيوني مسيحي. / المدينة السماوية, المدينة المقدسة (عبارات تستخدم للإشارة إلى الجنة)\nمثال: كانت المدينة السماوية هدف كريستيان في رواية 'رحلة الحاج' لبونيان / شِينْغْدُو, تْشِينْغْدُو",
 "せいとう": "حِزْب, حِزْب سِيَاسِيّ (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب. / الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة) / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / قَانُونِيّ / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل) / إخضاع, غزو (فعل الغزو) / إخضاع, ظلم (فعل الإخضاع بالقسوة) / إخضاع, خضوع (الخضوع القسري لسيطرة الآخرين)\nمثال: قمع الطاغية للشعب / سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة) / جورب أزرق, مثقفة (امرأة لديها اهتمامات أدبية أو فكرية) / تْشِينْغْدَاو / حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
