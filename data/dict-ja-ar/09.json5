 "すぎたこと": "سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق)\nمثال: دع ما فات يموت",
 "すぎたるはおよばざるがごとし": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "すぎたるはなおおよばざるがごとし": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "すぎな": "ذيل الحصان الحقلي, ذيل الحصان الشائع (من أوراسيا وجرينلاند وأمريكا الشمالية)",
 "すぎゆく": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق.",
 "すぎょう": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب.",
 "すぎる": "اِخْتَرَقَ, نَفَذَ / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "すく": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج. / رَفِيع, رَقِيق / مِحْرَاث\nمثال: حرث المزارع أرضه.",
 "すくい": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / خَلَاص, تَطْهِير اَلنَّفْس / مِغْرَفَة",
 "すくいだす": "كَفَالَة / أَنْقَذَ, خَلَّصَ",
 "すくいぬし": "مُخَلِّص, مُنْقِذ (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص / مَسِيح",
 "すくいのて": "مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "すくいようのない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "すくい出す": "كَفَالَة",
 "すくう": "مِغْرَفَة / أَنْقَذَ, خَلَّصَ / أَنْقَذَ, أَنْجَى\nمثال: حفظ رقم هاتفها. / عُشّ\nمثال: كان دوري كي أنظف المسكن / تَسَكَّعَ / غَلِقَ (ق. (فعل: ثلاثي لازم). غَلِقَ، يَغْلَقُ، مصدر غَلَقٌ؛ غلِقَ يَغلَق، غَلَقًا، فهو…)\nمثال: أعاد زيري غلق الخيمة.",
 "すくすく": "بِسُرْعَة, عَاجِلًا",
 "すくない": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すくなからず": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "すくなからぬ": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "すくなくとも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "すくなくなる": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "すくなくも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "すくなげ": "شح, ندرة (كمية صغيرة وغير كافية)",
 "すくね": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "すくみ": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "すくむ": "تَجَمَّدَ",
 "すくめる": "هَزَّ كَتِفَيْن",
 "すくわれない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "すぐ": "فَوْرًا, حَالًا / قَرِيبًا, سَرْعَانَ مَا / بِسُهُولَة / يَمِين, يمين\nمثال: أجب على السؤال. / اِخْتَرَقَ, نَفَذَ / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "すぐさま": "فَوْرًا, حَالًا",
 "すぐそこ": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "すぐそば": "بِالْقُرْب مِن, بِجَانِب",
 "すぐち": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "すぐと": "فَوْرًا, حَالًا / مُبَاشَرَةً",
 "すぐに": "فَوْرًا, حَالًا",
 "すぐにでも": "فَوْرًا, حَالًا",
 "すぐにも": "فَوْرًا, حَالًا",
 "すぐり": "عِنَب الثَعْلَب",
 "すぐる": "اِخْتَارَ",
 "すぐれた": "رَائِع, عَظِيم\nمثال: الصين بلد عظيم.",
 "すぐれて": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "すぐれない": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض)",
 "すぐれる": "فَاقَ, تَجَاوَزَ",
 "すぐろはげこう": "جابيرو",
 "すぐ側": "بِالْقُرْب مِن, بِجَانِب",
 "すぐ様": "فَوْرًا, حَالًا",
 "すけ": "كَاهِن, قِسِّيس / مُسَاعَدَة, إِمْدَاد / رضيع, طفل (طفل صغير جداً (من الولادة إلى سنة واحدة) لم يبدأ بعد في المشي أو الكلام)\nمثال: بدأ الطفل في البكاء مرة أخرى",
 "すけかん": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "すけこまし": "زير نساء (رجل يحب العديد من النساء ويقيم علاقات جنسية قصيرة معهن)",
 "すけすけ": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "すけぜい": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "すけだち": "مُسَاعَدَة, إِمْدَاد / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "すけっと": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "すけて": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "すけべ": "شَبَق",
 "すけべいこんじょう": "فَحْشَاء, فِسْق / جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "すけべえ": "شَبَق",
 "すけべえこんじょう": "فَحْشَاء, فِسْق / جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "すけべこんじょう": "فَحْشَاء, فِسْق / جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "すけん": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر)",
 "すげ": "سعد, عشبة السعد (نبات يشبه العشب أو الأسل ينمو في الأماكن الرطبة وله سيقان صلبة وأوراق ضيقة تشبه…)",
 "すげい": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "すげぇ": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "すげえ": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "すげかえる": "تَبْدِيل, تَبَادُل",
 "すげない": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "すげる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "すげー": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "すげ替える": "تَبْدِيل, تَبَادُل",
 "すこ": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة",
 "すこし": "قَلِيلًا",
 "すこしあいだをおいて": "قَلِيلًا",
 "すこしく": "قَلِيلًا",
 "すこしずつ": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة)\nمثال: حركوه بوصة بوصة",
 "すこしづつ": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة)\nمثال: حركوه بوصة بوصة",
 "すこしでも": "على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم ولو قليلاً؟",
 "すこしでもはやく": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "すこしまをおいて": "قَلِيلًا",
 "すこしも": "أبداً",
 "すこぶる": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "すこぶるつき": "الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "すこぶる付き": "الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ.",
 "すこやか": "حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط)",
 "すご": "حِمَايَة",
 "すご〜い": "فَظِيع / مُدْهِش, مُذْهِل / بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين / بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "すごい": "فَظِيع / مُدْهِش, مُذْهِل / بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين / بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "すごうで": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه)\nمثال: تمكن جيد من الفرنسية / طَمُوح, مُثَابِر (شخص يتقدم مساره المهني بسرعة؛ شخص ذو همة عالية)",
 "すごく": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "すごす": "أَنْفَقَ, صَرَفَ / شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "すごすご": "بِإِحْبَاط, بِاكْتِئَاب (بطريقة مكتئبة)\nمثال: عندما عادت كانت صوفي وإستر تجلسان باكتئاب في المطبخ",
 "すごみ": "بَشَاعَة, شَنَاعَة (صفة كون الشيء مروعاً أو بشعاً) / تَرْهِيب, تَخْوِيف",
 "すごみをきかす": "هَدَّدَ",
 "すごみをきかせる": "هَدَّدَ",
 "すごむ": "هَدَّدَ",
 "すごもり": "عُشّ\nمثال: كان دوري كي أنظف المسكن",
 "すごもりじゅよう": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "すごもる": "عُشّ\nمثال: كان دوري كي أنظف المسكن",
 "すごーい": "فَظِيع / مُدْهِش, مُذْهِل / بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين / بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "すさのお": "سُوسَانُو",
 "すさび": "تَسْلِيَة",
 "すさまじい": "فَظِيع / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / مُذْهِل, مُفْزِع (يسبب الذعر والفزع)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "すし": "سُوشِي",
 "すしおけ": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "すしづめ": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "すしや": "بار السوشي (حانة أو منصة يُقدم فيها السوشي)",
 "すし屋": "بار السوشي (حانة أو منصة يُقدم فيها السوشي)",
 "すし詰め": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "すじ": "عَضَلَة\nمثال: توم شعر بالقوة. / وَرِيد, عِرْق / ليف مقوى (مادة تشبه الجلد مصنوعة بضغط طبقات من الورق أو القماش)\nمثال: يهدف التعليم إلى تكوين الشخصية / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "すじあい": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "すじおし": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "すじかい": "مَائِل, قُطْرِيّ",
 "すじがき": "مُلَخَّص / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "すじがねいり": "رَاسِخ, صَامِد (ثَابِتٌ وَمَوْثُوقٌ خَاصَّةً فِي الوَلَاءِ)",
 "すじぐも": "سحاب رقيق, سمحاق (سحابة بيضاء رقيقة (عادة من بلورات جليدية دقيقة) على ارتفاع عالٍ (4 إلى 8 أميال))",
 "すじじょう": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة)\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "すじだて": "حَبْكَة",
 "すじちがい": "تَشَنُّج, شَدٌّ عَضَلِيّ / سَخَافَة / مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / فِي غَيْر مَوْضِعِه (ضائِع مُؤَقَّتًا؛ وُضِع في مَكان غَيْر مُعْتاد)",
 "すじなわ": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم)\nمثال: كل سلالته كانت محاربين",
 "すじのとおった": "عَقْلَانِيّ",
 "すじのとおらない": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة)",
 "すじばった": "قَوِيّ البُنْيَة, مَفْتُول العَضَلَات ((للشخص) يمتلك قوة بدنية ووزنًا؛ متين وجبار)",
 "すじぼね": "بنية, قوام (تكوين الجسم البشري)\nمثال: درس ليوناردو جسم الإنسان / غُضْرُوف (مادة قاسية مرنة تُكوِّن هياكل أو أجزاء من هياكل الفقاريات. تُشكل غالبية هياكل…)",
 "すじまき": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول)",
 "すじみち": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / طَرِيقَة, مِنْهَج",
 "すじみちのとおった": "مُتَّسِقٌ ذَاتِيًّا (لَا يُنَاقِضُ نَفْسَهُ)",
 "すじめ": "طَوَى / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم)\nمثال: كل سلالته كانت محاربين / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / عَلَاقَة",
 "すじもの": "يَاكُوزَا",
 "すじもん": "يَاكُوزَا",
 "すじょう": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ / وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / مُطَابَقَة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "すじ違い": "تَشَنُّج, شَدٌّ عَضَلِيّ / سَخَافَة / مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / فِي غَيْر مَوْضِعِه (ضائِع مُؤَقَّتًا؛ وُضِع في مَكان غَيْر مُعْتاد)",
 "すじ雲": "سحاب رقيق, سمحاق (سحابة بيضاء رقيقة (عادة من بلورات جليدية دقيقة) على ارتفاع عالٍ (4 إلى 8 أميال))",
 "すす": "سُخَام",
 "すすぎ": "شطف (إزالة الصابون بالماء النظيف في المرحلة النهائية من الغسيل)",
 "すすぐ": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن…)",
