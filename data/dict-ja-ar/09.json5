 "せつめいしょ": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "せつめいせきにん": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "せつめいてき": "إِيضَاحِيّ, تَفْسِيرِيّ (يهدف إلى الشرح أو التوضيح)",
 "せつめいぶん": "تَفْسِير, شَرْح",
 "せつめん": "مساحة, منطقة (امتداد سطح ثنائي الأبعاد محصور داخل حدود)\nمثال: مساحة المستطيل",
 "せつもん": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "せつやく": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "せつやくか": "مُخَلِّص, مُنْقِذ (شخص ينقذ شيئاً أو شخصاً من خطر أو عنف) / مُدَّخِر (شخص يدخر (وخاصة المال))",
 "せつゆ": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "せつよう": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "せつよく": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "せつり": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / بروفيدنس / مُشْتَرَك / مِفْصَل / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "せつりつ": "تَأْسِيس / مُؤَسَّسَة\nمثال: わが校は１９００年に設立されました。 — تأسست مدرستنا عام ۱۹۹۰م. / إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "せつりつしゃ": "مُؤَسِّس, مُؤَسِّسَة",
 "せつりつしゅいしょ": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "せつれい": "مكلل بالثلوج ((عن الجبال) مغطى قمتها بطبقة من الثلج)",
 "せつれつ": "أَخْرَق",
 "せつわ": "حِكَايَة, قِصَّة",
 "せでん": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "せと": "مَضِيق, مُخْتَنَق (البَحْر حين يضيق لإقتراب البرَ من الجهتين)",
 "せとぎわ": "حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / حافة الهاوية, شفا (حافة مكان شديد الانحدار) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء",
 "せとぎわせいさく": "سياسة حافة الهاوية (سياسة دفع موقف خطير إلى حافة الكارثة (إلى حدود الأمان))",
 "せとないかい": "بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "せとびき": "مِينَاء",
 "せともの": "خزف مسامي, فخار (أواني خزفية مصنوعة من طين مسامي محروق بحرارة منخفضة) / أواني خزفية, خزفيات (أواني مصنوعة من مادة السيراميك)",
 "せとやき": "أواني خزفية, خزفيات (أواني مصنوعة من مادة السيراميك)",
 "せど": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "せどり": "تعامل, صفقة (فعل التعامل داخل أو بين المجموعات (كالقيام بأنشطة تجارية)) / تعامل (طريقة أو أسلوب السلوك فيما يتعلق بالآخرين)\nمثال: لا يمكن إجراء أي معاملات بدونه",
 "せどりぶね": "قارب صغير (قارب صغير الحجم)",
 "せな": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "せなか": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
