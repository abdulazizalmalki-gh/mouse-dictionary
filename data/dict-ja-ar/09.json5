 "せいどか": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق)",
 "せいどかんり": "مُرَاقَبَةُ الْجَوْدَة",
 "せいどく": "أَلْمَانِيَا الْغَرْبِيَّة (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "せいどてき": "نِظَامِيّ",
 "せいどようび": "سبت النور (السبت الذي يسبق عيد الفصح؛ اليوم الأخير من الصوم الكبير)",
 "せいどれい": "الاستعباد الجنسي",
 "せいなる": "مُقَدَّس",
 "せいなん": "الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة) / باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "せいにく": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / لحم نيء (لحم غير مطبوخ)",
 "せいにくしょう": "جَزَّار, قَصَّاب\nمثال: ضع الجزر في القدر.",
 "せいにじゅうめんたい": "عشروني سطوح منتظم (عشروني سطوح ذو عشرين مثلثاً متساوي الأضلاع كأوجه)",
 "せいにゅう": "حليب خام (حليب غير مبستر)",
 "せいねい": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / شِينِينْغ",
 "せいねん": "غَالِبِيَّة, أَغْلَبِيّة / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي. / شَبَاب / أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها) / سنة مقدسة ((الكنيسة الكاثوليكية) فترة غفران من الخطايا (تُمنح عادة كل 25 سنة))",
 "せいねんがっぴ": "تَارِيخُ الْمِيلَادِ, تَارِيخُ مِيلَادِ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "せいねんき": "شَبَاب",
 "せいねんしゃ": "بَالِغ, رَاشِد",
 "せいねんじだい": "شَبَاب",
 "せいねんねんれい": "سِنّ الرُّشْد ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "せいねんトルコじんかくめい": "تُرْكِيَة الفَتَاة",
 "せいの": "كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي)\nمثال: تم تجميعهم كلهم معاً",
 "せいのう": "قُدْرَة, مَقْدِرَة\nمثال: この車はあの車より性能がよい。 — أداء هذه السيارة أفضل من تلك. / حُوَيْصِلَة مَنَوِيَّة",
 "せいのすう": "عَدَد مُوجَب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "せいのたいしょう": "أَدَاة لِلْمُتْعَة الْجِنْسِيَّة, مَوْضُوع جِنْسِيّ (أي شخص يُنظر إليه ببساطة كأداة للإشباع الجنسي)",
 "せいは": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / انتصار, فوز (النجاح بعد صعوبة كبيرة)\nمثال: الفوز ليس كل شيء",
 "せいはい": "شَرِيك, شَرِيكَة / صُوَاع",
 "せいはく": "تكرير, تنقية (عملية إزالة الشوائب (كما هو الحال من الزيت أو المعادن أو السكر، إلخ))",
 "せいはくとう": "سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "せいはくまい": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "せいはちほうたい": "تسراكت, مكعب فائق (النظير رباعي الأبعاد للمكعب)",
 "せいはちめんたい": "ثماني سطوح منتظم (ثماني سطوح ذو ثمانية مثلثات متساوية الأضلاع كأوجه)",
 "せいはつ": "تصفيف شعر, عناية بالشعر (العناية بالشعر: نشاط غسل أو قص أو تجعيد أو ترتيب الشعر)",
 "せいはつざい": "تصفيف شعر, عناية بالشعر (العناية بالشعر: نشاط غسل أو قص أو تجعيد أو ترتيب الشعر)",
 "せいはん": "طَابُوقَة / تكامل رأسي (الاستيعاب في شركة واحدة لعدة شركات تعمل في جميع جوانب تصنيع المنتج من المواد…)",
 "せいはんざい": "إساءة جنسية, اعتداء جنسي (جريمة تشريعية تنص على أنه من الجريمة التسبب عمداً في انخراط شخص آخر في فعل جنسي…)\nمثال: استبدلت معظم الولايات تعريف القانون العام للاغتصاب بقوانين تحدد الاعتداء الجنسي / پْسِي, بْسِي",
 "せいはんざいしゃ": "مجرم جنسي (شخص أدين بجريمة جنسية)",
 "せいはんしょ": "مَنْشَرَة",
 "せいはんのう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "せいばい": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر. / قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "せいばつ": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / تأنيب, توبيخ (عقاب لفظي)",
 "せいばんじょ": "مَنْشَرَة",
 "せいばんもろこし": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب…)",
 "せいひ": "نَتِيجَة / ملكة قرينة (زوجة الملك الحاكم)",
 "せいひがい": "إِسَاءَة جِنْسِيَّة",
 "せいひがいしゃ": "إِسَاءَة جِنْسِيَّة",
 "せいひつ": "إِغْفَال / سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / تَابُوت اَلْعَهْد (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل) / كنيس, معبد يهودي ((اليهودية) مكان العبادة لجماعة يهودية)",
 "せいひょうき": "صانعة ثلج (جهاز مُدمج في بعض الثلاجات الكهربائية لصنع مكعبات الثلج) / عداد (آلة حاسبة تحتفظ بسجل لعدد المرات التي يحدث فيها شيء ما)",
 "せいひょうげん": "تَعْبِير جَنْدَرِي",
 "せいひょうしゃ": "زامبوني (العلامة التجارية لآلة تسوي الجليد في حلبة التزلج على الجليد)",
 "せいひょうじょ": "نبات الثلج, نبات الجليد (نبات سنوي من العالم القديم متوطن على نطاق واسع في المناطق الدافئة ذو زهور بيضاء…)",
 "せいひん": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / مُنْتَج",
 "せいひんかいしゅう": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "せいひんぐん": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "せいひんライン": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "せいび": "صِيَانَة / إِعْمَار, تَعْمِير / تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين / إتقان, جمال فائق (جمال فائق من نوع دقيق) / مُفَصَّل",
 "せいびいん": "حارس الحديقة, مسؤول الملاعب (شخص يحافظ على الأراضي (في عقار أو حديقة أو ملعب رياضي))",
 "せいびき": "بحث (عملية تحدد ما إذا كان عنصر واحد أو أكثر من مجموعة عناصر يمتلك خاصية محددة)\nمثال: كتبوا برنامجاً للبحث في الجدول",
 "せいびこう": "مِيكَانِيكِيّ",
 "せいびこうじょう": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "せいびし": "مِيكَانِيكِيّ",
 "せいびしつ": "مَهَمَّة",
 "せいびせい": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "せいびへい": "طاقم أرضي (طاقم الفنيين والميكانيكيين الذين يخدمون الطائرات على الأرض)",
 "せいびょう": "دَاء مَنْقُول جِنْسِيًّا",
 "せいふ": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "せいふう": "رياح غربية (رياح تهب من الغرب إلى الشرق) / متنفس, نسمة هواء عليل (ارتياح مرحب به)\nمثال: كانت الإدارة الجديدة بمثابة نسمة هواء عليل / تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين)",
 "せいふうぞく": "بِغَاءٌ, دَعَارَة",
 "せいふうぞくてん": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "せいふきかん": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "せいふく": "زَيّ, زِي\nمثال: 私たちの学校では制服を着る。 — نحن ترتدي الزي الرسمي في مدرستنا. / فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / هَزَمَ, غَلَبَ / شَرْعِيَّة / سَعَادَة, فَرَح / إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "せいふくし": "أخصائي في العلاج الطبيعي, أخصائية في العلاج الطبيعي",
 "せいふくしゃ": "غَازٍ",
 "せいふごう": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "せいふざい": "مُعَقِّمٌ",
 "せいふん": "تخريش الحافة (الحافة المموجة لعملة معدنية)",
 "せいふんき": "آلة تفريز (أداة آلية يتم فيها تغذية المعدن المثبت على عربة ضد قواطع دوارة تشكله)",
 "せいふんしょ": "طاحونة دقيق (طاحونة لطحن الحبوب وتحويلها إلى دقيق)",
 "せいふんじょ": "طاحونة دقيق (طاحونة لطحن الحبوب وتحويلها إلى دقيق)",
 "せいぶ": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة…)\nمثال: تغرب الشمس في الغرب.",
 "せいぶげき": "غَرْبِيّ",
 "せいぶつ": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما) / عِلْم اَلْأَحْيَاء, بِيُولُوجِيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "せいぶつかい": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "せいぶつかいようがく": "علم الأحياء البحرية (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいぶつかがく": "كِيمِيَاء حَيَوِيَّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء.",
 "せいぶつかがくてきさんそようきゅうりょう": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "せいぶつが": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "せいぶつがく": "عِلْم اَلْأَحْيَاء, بِيُولُوجِيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいぶつがくしゃ": "أَحْيَائِي (إلى أَحْيَاء؛ الأحيائي أو عالم الأحياء هو الشخص المتخصص في علم الأحياء، والذي…)\nمثال: هو عالم أحيائي.",
 "せいぶつがくしゅぎ": "بيولوجية, تفسير بيولوجي (استخدام المبادئ البيولوجية في تفسير السلوك البشري وخاصة الاجتماعي)",
 "せいぶつがくてき": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつがくてきせいざい": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつがくてきたようせい": "تَنَوُّع البِيُولُوجِيّ",
 "せいぶつぐんしゅう": "مجتمع حيوي ((في علم البيئة) مجموعة من الكائنات الحية المترابطة التي تسكن نفس المنطقة…)",
 "せいぶつけい": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつけん": "غلاف حيوي, محيط حيوي (مناطق سطح الأرض وغلافها الجوي (أو كوكب آخر) حيث توجد الكائنات الحية)",
 "せいぶつけんてい": "مقايسة حيوية (تقييم النشاط البيولوجي لمادة ما عن طريق اختبار تأثيرها على كائن حي ومقارنة…)",
 "せいぶつこうがく": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين…)\nمثال: أنتجت التكنولوجيا الحيوية بكتيريا معدلة وراثياً حلت المشكلة",
 "せいぶつざい": "خطر بيولوجي, عامل بيولوجي (أي بكتيريا أو فيروس أو سم يمكن استخدامه في الحرب البيولوجية)",
 "せいぶつせん": "حرب بيولوجية, هجوم بيولوجي (استخدام البكتيريا أو الفيروسات أو السموم لتدمير البشر والحيوانات أو الغذاء)",
 "せいぶつそう": "الحياة البيولوجية, كائنات حية (جميع الكائنات الحية النباتية والحيوانية في منطقة معينة)",
 "せいぶつそくていがく": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)",
 "せいぶつたい": "كَائِن حَيّ",
 "せいぶつたようせい": "تَنَوُّع البِيُولُوجِيّ",
 "せいぶつちりがく": "جغرافيا حيوية (التعامل مع التوزيع الجغرافي للحيوانات والنباتات)",
 "せいぶつてき": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつとうけいがく": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)",
 "せいぶつどけい": "سَاعَة بَيُولُوجِيَّة (آلية فطرية في الكائنات الحية تتحكم في دورية العديد من الوظائف الفسيولوجية)",
 "せいぶつはっこう": "ضيائية حيوية (ضيائية تنتجها عمليات فسيولوجية (كما في اليراع))",
 "せいぶつぶつりがく": "فيزياء حيوية (الفيزياء كما تطبق على المشاكل البيولوجية)",
 "せいぶつへいき": "سلاح بيولوجي (أي سلاح يمكن استخدامه في الحرب البيولوجية)\nمثال: خشوا من استخدام فيروس الجدري كسلاح بيولوجي",
 "せいぶつテロ": "إرهاب بيولوجي (الإرهاب باستخدام أسلحة الحرب البيولوجية)",
 "せいぶん": "مُقَوِّم / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "せいぶんか": "تصنيف, تقنين (فعل التقنين؛ الترتيب في نظام منهجي)",
 "せいぶんかいせい": "قَابِل لِلتَّحَلُّل البِيُولُوجِيّ (قابل للتحلّل بفعل البكتيريا ونحوها)",
 "せいぶんちょうせいぎゅうにゅう": "حليب متجانس (حليب تم تكسير جزيئات الدهون فيه وتوزيعها بانتظام حتى لا تطفو القشدة على السطح)",
 "せいぶんほう": "قانون تشريعي (مجموعة القوانين التي تنشئها التشريعات البرلمانية)",
 "せいぶんりつ": "تشريع, قانون تشريعي (قانون تم سنه من قبل هيئة تشريعية)",
 "せいへき": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد / هَوَس, وَلَع مَرَضِيّ (تفاني مفرط أو غير عقلاني لنشاط ما)\nمثال: جعل من النظافة هوساً",
 "せいべつ": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى…)\nمثال: أنا مثلي الجنس. / تكريس (تقديس شيء ما عن طريق تخصيصه (عادة بطقوس دينية) لله)\nمثال: حضر الكاردينال تكريس الكنيسة",
 "せいべついこう": "عُبُور جِنْدَرِيّ, تَحَوُّل جِنْدَرِيّ",
 "せいべついわ": "اِنْزِعَاج جَنْدَرِي",
 "せいべつてきごうしゅじゅつ": "جِرَاحَة إِعَادَة تَحْدِيد الجِنْس",
 "せいほ": "تَأْمِين عَلَى اَلْحَيَاة / رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "せいほう": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / وَصْفَة / حقيقة, صحة (المطابقة للواقع أو الفعليّة)\nمثال: ناقشوا صحة الاقتراح / عُلُوم سِيَاسِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "せいほうきょうかい": "الكاثوليكية الرومانية, الكنيسة الرومانية الكاثوليكية (الكنيسة المسيحية التي مقرها الفاتيكان ويرأسها البابا وتسلسل هرمي أسقفي)",
 "せいほうぎょうれつ": "مَصْفُوفَة مُرَبَّعَة",
 "せいほうけい": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "せいほく": "الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة) / باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي)",
 "せいほん": "أَصْلِيّ / تجليد",
 "せいほんき": "صَحَّاف",
 "せいほんしょ": "ورشة تجليد كتب (ورشة المجلد؛ مكان لتجليد الكتب)",
 "せいほんや": "صَحَّاف",
 "せいぼ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام / مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة…)\nمثال: مريم طرقت الباب. / أَوَّلِيّ, أَوَّل\nمثال: لم تكن أول مرة.",
 "せいぼう": "شُهْرَة",
 "せいぼく": "بَالِغ, مُكْتَمِلُ النُّمُوّ ((للحيوانات) مكتمل النمو والتطور)",
 "せいぼさいぼう": "خلية منوية (خلية مشيجية ذكرية تتطور إلى أربع طلائع منوية)",
 "せいぼし": "مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة…)\nمثال: مريم طرقت الباب.",
 "せいぼひしょうてん": "15 أغسطس, عيد الانتقال (احتفال في الكنيسة الكاثوليكية بانتقال السيدة العذراء مريم إلى السماء عند انتهاء…)",
 "せいぼマリア": "مَرْيَم اَلْعَذْرَاء ((في الديانات الإبراهيمية) مريم بنت عمران، وهي أم النبي عِيسَى، والمرأة الوحيدة…)\nمثال: مريم طرقت الباب.",
 "せいまい": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "せいまく": "إنتاج سينمائي, صناعة الأفلام (إنتاج الأفلام السينمائية) / تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "せいみつ": "مَضْبُوط, دَقِيق",
 "せいみょう": "بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن)",
 "せいむ": "احتلام (حلم جنسي (عادة في الليل) مصحوب بقذف (ليلي) للمني)",
 "せいめい": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / مِهْنَة, مسار مهني / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون…) / سُمْعَة, شُهْرَة / إِعْلَان, بَيَان",
 "せいめいいじそうち": "نظام دعم الحياة (معدات طبية تساعد أو تحل محل وظائف جسدية مهمة وبالتالي تمكن المريض من العيش…)\nمثال: المريض على أجهزة دعم الحياة",
 "せいめいかがく": "بيولوجيا, علوم الحياة (أي فرع من فروع العلوم الطبيعية يتعامل مع بنية وسلوك الكائنات الحية)",
 "せいめいけい": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل…)\nمثال: محكم عليه بالإعدام.",
 "せいめいけん": "حق الحياة (الحق في العيش)",
 "せいめいこうがく": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين…)\nمثال: أنتجت التكنولوجيا الحيوية بكتيريا معدلة وراثياً حلت المشكلة",
 "せいめいしゅくじつ": "يَوْم اِسْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "せいめいしょ": "تَصْرِيح, بَيَان",
 "せいめいせん": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق)\nمثال: وفر الجسر الجوي شريان حياة لبرلين / خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)",
 "せいめいたい": "شَكْل حَيَوِيّ (الشكل الجسدي المميز لكائن حي ناضج)",
 "せいめいふしょう": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى)",
 "せいめいぶん": "مَنْسُور, مُنَادَاة",
 "せいめいほけん": "تَأْمِين عَلَى اَلْحَيَاة",
 "せいめいほけんがいしゃ": "تَأْمِين عَلَى اَلْحَيَاة",
 "せいめいほけんきょうかい": "تَأْمِين عَلَى اَلْحَيَاة",
 "せいめいほけんしょうしょ": "تَأْمِين عَلَى اَلْحَيَاة",
 "せいめいりょく": "تدفق, حيوية (أسلوب نشيط)\nمثال: حيوية البذرة",
 "せいめいりんり": "أخلاقيات علم الأحياء (فرع الأخلاق الذي يدرس القيم الأخلاقية في العلوم الطبية الحيوية)",
 "せいめいりんりがく": "أخلاقيات علم الأحياء (فرع الأخلاق الذي يدرس القيم الأخلاقية في العلوم الطبية الحيوية)",
 "せいもう": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "せいもくようび": "الخميس المقدس, خميس العهد (الخميس الذي يسبق عيد الفصح؛ يحيي ذكرى العشاء الأخير)",
 "せいもん": "بصمة صوتية (تحديد هوية بيومتري عن طريق تسجيل صوت الشخص وتمثيله بيانياً إلكترونياً)\nمثال: البصمات الصوتية مميزة بشكل فريد للمتحدثين الأفراد / مزمار (الجهاز الصوتي للحنجرة؛ الحبال الصوتية الحقيقية والفراغ بينهما حيث تتولد نغمة…)",
 "せいもんはれつおん": "همزة قطع, وقفة حنجرية (صامت وقفي يُنطق عن طريق تحرير الضغط عند المزمار)",
 "せいもんへいさおん": "همزة قطع, وقفة حنجرية (صامت وقفي يُنطق عن طريق تحرير الضغط عند المزمار)",
 "せいや": "24 ديسمبر, ليلة عيد الميلاد (اليوم السابق لعيد الميلاد)",
 "せいやく": "تحديد, تقييد (فعل الحد أو التقييد (كما هو الحال عن طريق التنظيم))\nمثال: إنها خطة جيدة لكن لها محدوديات خطيرة / قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "せいやくがいしゃ": "شركة أدوية, شركة صيدلانية (شركة تقوم بتصنيع وبيع المستحضرات الصيدلانية)",
 "せいやくしょ": "مِيثَاق, عَهْد",
 "せいやくじょうけん": "متطلب",
 "せいやくわり": "دور النوع الاجتماعي, دور جندري (التعبير العلني عن المواقف التي تشير للآخرين درجة الذكورة أو الأنوثة)\nمثال: دورك الجندري هو التعبير العام عن هويتك الجندرية",
 "せいゆ": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات) / زيت مقدس, ميرون (مرهم مكرس يتكون من خليط من الزيت والبلسم)",
 "せいゆう": "جَوْلَة, نُزْهَة",
 "せいゆうき": "سَعْدَان, قِرْد",
 "せいゆかん": "قَنَاة مَنَوِيَّة",
 "せいゆしょ": "مِصْفَاة نِفْط, مِصْفَاة نَفْط",
 "せいゆじょ": "مِصْفَاة نِفْط, مِصْفَاة نَفْط",
 "せいよ": "سُمْعَة, شُهْرَة",
 "せいよう": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة…)\nمثال: تغرب الشمس في الغرب. / رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "せいようあぶらな": "بذور السلجم (بذرة نباتات السلجم؛ مصدر لزيت صالح للأكل)",
 "せいようおとぎりそう": "حَشِيشَة الْقَلْب, دَاذِيّ",
 "せいようか": "تَغْرِيب",
 "せいようかぼちゃ": "قرع الزبدة (قرع أسطواني الشكل ذو قشرة خضراء داكنة معلمة باللون الفضي أو الرمادي)",
 "せいようかりん": "مُشْمُلَة",
 "せいようきぬやなぎ": "أوزير, صفصاف سلالين (أي من أنواع الصفصاف المختلفة ذات الأغصان المرنة المستخدمة في صناعة السلال…)",
 "せいようこてんがく": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "せいようご": "الدامة, لعبة الداما (لعبة لوحية للاعبين اثنين يملك كل منهما 12 قطعة؛ الهدف هو القفز فوق قطع الخصم…)",
 "せいようさくらそう": "الربيعية, بريملة",
 "せいようし": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "せいようしみ": "السمكة الفضية (نوع فضي من السمك الذهبي)",
 "せいようしょうぎ": "شَطْرَنْج, شِطْرَنْج (طريقة هجاء بديلة لـ\"شِطْرَنْج\")\nمثال: لعب زيري الشطرنج.",
 "せいようしょうろ": "كَمْأَة",
 "せいようじん": "غَرْبِيّ",
 "せいようすぐり": "عِنَب الثَعْلَب",
 "せいようすのき": "عنبية (توت أزرق مسود يشبه التوت الأزرق الأمريكي)",
 "せいようすもも": "برقوق شائع (أي من أنواع البرقوق المختلفة واسعة الانتشار التي تزرع في المناطق المعتدلة…)",
 "せいようたんぽぽ": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات…)",
 "せいようとちのき": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور…)",
 "せいようとねりこ": "مران أوروبي, مران عالي (مران طويل من أوروبا إلى القوقاز له أوراق خضراء داكنة لامعة من الأعلى وشاحبة…)",
 "せいようななかまど": "غُبَيْرَاء, غُبَيْرَاء أُورُوبِّيَّة (تصغير غَبْرَاء، وهي الأرض ومؤنث أغْبَر ووأنثى الحجل؛ نبات أو ثمرته)",
 "せいようにんじん": "جنسنغ أمريكي (عشب الغابات في أمريكا الشمالية يشبه الجنسنغ الصيني ويستخدم كبديل له)",
 "せいようねぎ": "كُرَّاث / ثُوم مُعَمَّر",
 "せいようねず": "عرعر شائع (شجيرة كثيفة التفرع أو شجرة صغيرة لها توت أزرق لاذع يستخدم لنكهة الجن؛ واسعة…)",
 "せいようのこぎりそう": "قَيْصُوم",
 "せいようはこやなぎ": "حور لومباردي (يتميز بشكله العمودي المتسامي وفروعه المنتصبة)",
 "せいようはっか": "نَعْنَاع فِلْفِلِيّ",
 "せいようふうちょうそう": "زهرة العنكبوت (موطنها أمريكا الجنوبية ولكنها متوطنة في الأجزاء الدافئة من الولايات المتحدة…)",
 "せいようぶんめい": "الثقافة الغربية, الحضارة الغربية (الثقافة الحديثة لأوروبا الغربية وأمريكا الشمالية)",
 "せいようみざくら": "كرز حلو (أي من عدة فواكه لأشجار الكرز المزروعة التي لها لحم حلو)",
 "せいようやまはっか": "بَاذَرُوج, تُرُنْجَان",
 "せいようりんご": "تُفَّاحَة\nمثال: هذه تفاحة أيضا.",
 "せいようわさび": "فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل…)",
 "せいようカボチャ": "قرع الزبدة (قرع أسطواني الشكل ذو قشرة خضراء داكنة معلمة باللون الفضي أو الرمادي)",
 "せいようタンポポ": "هندباء شائعة (نبات أوراسي متوطن على نطاق واسع كعشبة ضارة في أمريكا الشمالية؛ يستخدم كخضروات…)",
 "せいよく": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "せいらい": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "せいらん": "تدرج أرغوس (تدرج كبير ذو أنماط رائعة من جزر الهند الشرقية)",
 "せいらんしょく": "مُسْتَشِيط غَضَبًا (غاضب غضبًا عارمًا لا يُطاق)",
 "せいり": "تصنيف, فرز (التجميع حسب الفئة أو النوع أو الحجم)\nمثال: عنق الزجاجة في تسليم البريد هو عملية الفرز / تَصْفِية / تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي) / فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…)",
 "せいりがく": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "せいりがくけんきゅうじょ": "عضة صغيرة, قرصة (عضة صغيرة حادة)\nمثال: برودة الصباح الباكر",
 "せいりがつく": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "せいりきがく": "إستاتيكا, علم السكون (فرع الميكانيكا المعني بالقوى في حالة توازن)",
 "せいりきのう": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "せいりけん": "تذكرة حافلة (تذكرة صالحة لركوب الحافلة)",
 "せいりしょくえんすい": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "せいりぜんしょうこうぐん": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "せいりだんす": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "せいりつ": "تَشَكُّل / نَتِيجَة / إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما)\nمثال: تلك القبعة ملكي / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "せいりてき": "فَسْلَجِي, فِسْيُولُوجِي / حَدْسِيّ, غَرِيزِيّ (مُكْتَسَب بِالحَدْس لا بِالتَّفْكير أَوْ المُلاحَظَة)\nمثال: نزيف حشوي",
 "せいりてきしょくえんすい": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "せいりとうごう": "تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين",
 "せいりまえしょうこうぐん": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "せいりゃく": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة.",
 "せいりゃくけっこん": "زَوَاج مَصْلَحَة",
 "せいりや": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "せいりゅう": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تَكْرِير",
