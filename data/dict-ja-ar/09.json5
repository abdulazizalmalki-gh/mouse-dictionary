 "せゆう": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "せよ": "بِالرَغْم مِن / مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "せよという": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "せよと言う": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "せられる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "せり": "تَنَافَسَ, تَبَارَى / مَزَاد, مُزَايَدَة",
 "せりあい": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "せりあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "せりいし": "حجر العقد, صنجة (كتلة بناء حجرية إسفينية الشكل تستخدم في بناء القوس أو القبو)",
 "せりうり": "مَزَاد, مُزَايَدَة",
 "せりおとす": "زَايَدَ / صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "せりだい": "دعامة جسر (دعامة حجرية تلامس وتتلقى مباشرة دفع أو ضغط القوس أو الجسر) / دعامة, نقطة التماس (نقطة تلامس بين جسمين أو جزأين)",
 "せりだす": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "せりて": "مُزَايِد",
 "せりばいばい": "مَزَاد, مُزَايَدَة",
 "せりばんご": "عدد ترتيبي (الرقم الذي يعين المكان في تسلسل مرتب)",
 "せりもち": "قَوْس",
 "せりもと": "حجر الارتكاز (أدنى حجر في القوس الذي يبدأ منه القوس) / جمارك, مكوس (الأموال المحصلة بموجب التعريفة الجمركية)",
 "せり出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "せる": "تَنَافَسَ, تَبَارَى / عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة. / فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "せろ": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せろっぽう": "جوليان (حساء صافي مزين بخضروات مقطعة شرائح رفيعة (جوليان)) / جوليان, خضار مقطع شرائح (خضار مقطع إلى شرائح رفيعة)",
 "せろん": "رَأْي عَامّ",
 "せろんちょうさ": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "せわ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / مُشْكِلَة, مَتاعِب / تَوْصِيَة / حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "せわがかり": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "せわがない": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "せわしい": "مَشْغُول / غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "せわしない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "せわた": "قَنَاة هَضْمِيَّة",
 "せわにん": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر. / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "せわのやける": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "せわやき": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "せわやく": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "せわをやく": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / أزْعَجَ / يَزْعَجْ, يُضَايِقْ",
 "せん": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / سحر, عبقرية (قدرة إبداعية استثنائية) / سَابِق / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ / لَخَّصَ, اِخْتَصَرَ / مُسْتَوًى / مَرْحَلَة / غُدَّة / سن (وحدة نقدية كسرية لليابان وإندونيسيا وكمبوديا؛ تساوي واحداً من المائة من الين أو الروبية أو الرييل) / جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي) / سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام) / مانع, ورقة حاكمة ((في البريدج) ورقة لعب ذات قيمة عالية تكفي لضمان الفوز بالجولة في نقش معين) / قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم / تَنَصَّتَ / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / مُبَارَاة / شَحّاطَة, شَخَّاطَة / تَجْمِيعَة, دِيوَان / ضعة, مكانة متدنية (موقف ذو مكانة أدنى؛ منخفض في المقام أو الرتبة أو الثروة أو التقدير) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم) / اِنْزَلَقَ / زَقِيطَة / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا. / مَغْص, قُولَنْج / مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة) / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / تَأْثِير, أَثَر / سِيَام / سَجَّادَة, بِسَاط / طُوبَة, لَبِنَة / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة. / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "せんあえんこう": "بلند الزنك, سفاليريت (خام يعد المصدر الرئيسي للزنك؛ يتكون إلى حد كبير من كبريتيد الزنك البلوري)",
 "せんい": "لِيف / تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل / رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها)",
 "せんいがさいぼう": "أرومة ليفية (خلية يتطور منها النسيج الضام)",
 "せんいがん": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "せんいき": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "せんいこうがく": "ألياف بصرية (نقل الإشارات الضوئية عبر ألياف زجاجية)",
 "せんいこうじょう": "مصنع نسيج (مصنع لصنع المنسوجات)",
 "せんいしゅ": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "せんいしょう": "تليف (تطور النسيج الضام الليفي الزائد في عضو ما)",
 "せんいじょう": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "せんいせい": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "せんいせんしゅ": "ورم غدي ليفي (ورم حميد ومتحرك وصلب وغير مؤلم في الثدي؛ شائع لدى الشابات ويسببه ارتفاع مستويات هرمون الاستروجين)",
 "せんいそ": "سِلْيُولُوز / فيبرين (بروتين ليفي أبيض غير قابل للذوبان يتكون بفعل الثرومبين على الفيبرينوجين عند تخثر الدم)",
 "せんいそく": "حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية)) / كراسة, ملزمة (جزء من عمل مطبوع)",
 "せんいそげん": "فيبرينوجين (بروتين موجود في بلازما الدم؛ يتحول إلى فيبرين عندما يتجلط الدم)",
 "せんいそしき": "نسيج ليفي (نسيج يتكون من أو يحتوي على ألياف في كل من الحيوانات والنباتات)",
 "せんいち": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده",
 "せんいちやものがたり": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "せんいつ": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده",
 "せんいばん": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في أوراق صلبة)",
 "せんいん": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "せんいガラス": "ألياف زجاجية (مادة تغطية مصنوعة من ألياف زجاجية في راتنجات)",
 "せんうん": "نذر الحرب (علامة مشؤومة تهدد بالحرب)",
 "せんえい": "جَذْريّ / رَادِيكَالِيّ / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "せんえいか": "تشديد, تكثيف (إجراء يجعل الشيء أقوى أو أكثر حدة) / تكثيف (عملية زيادة تباين (الفيلم الفوتوغرافي)) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "せんえいど": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها",
 "せんえき": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "せんえつ": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "せんえん": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / مِلْح, ملح / مَلَّحَ",
 "せんおう": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "せんおく": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "せんか": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / مادة اختيارية, مقرر اختياري (دورة يمكن للطالب اختيارها من بين البدائل) / هَادِيس / قِرْش, عُمْلَة / مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو إصلاحها)",
 "せんかい": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "せんかがく": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "せんかく": "رَائِد / كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "せんかくしゃ": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل) / رائٍ, مشاهد (مراقب يدرك بصرياً) / رائي, صاحب بصيرة (شخص لديه قوى غير عادية لاستشراف المستقبل)\nمثال: مشاهد مدمن للأفلام",
 "せんかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "せんかたない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "せんかん": "بارجة (سفينة حربية كبيرة ومدرعة بشدة) / صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء) / صندوق ذخيرة (صندوق لحفظ الذخيرة) / عربة ذخيرة (مركبة عسكرية بعجلتين تحمل ذخيرة المدفعية) / لوحة غائرة (لوحة غائرة زخرفية في سقف أو قبة) / غَرْغَرَ, بَقْبَقَ / غَوَّاصَة",
 "せんかんすいいき": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "せんかんびょう": "انسداد وعائي غازي, داء الغواص (ألم ناتج عن تغير سريع في الضغط الجوي)",
 "せんが": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "せんがい": "غير مختار (لم يتم اختياره) / خارجي (يقع بعيداً عن خط الوسط لسفينة أو طائرة) / محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير) / قارب بمحرك خارجي (قارب آلي بمحرك خارجي)\nمثال: القسم الخارجي من الجناح",
 "せんがいかさく": "تنويه شرفي, ذكر مشرف (اعتراف رسمي بالاستحقاق)\nمثال: على الرغم من أنه لم يفز بالجائزة، إلا أنه حصل على تنويه خاص",
 "せんがいき": "محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير)",
 "せんがいモーター": "محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير)",
 "せんがふとい": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "せんがほそい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "せんがん": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "せんがんざい": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "せんがんやく": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "せんき": "راية المعركة (علم يقود القوات إلى المعركة) / إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة. / مَغْص, قُولَنْج",
 "せんきゃく": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "せんきゅうひゃくねんだい": "عقد 1900 (العقد من 1900 إلى 1909)",
 "せんきょ": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / اِنْتِخَاب, اِنْتِخَابَات / ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم / تَوْصِيَة",
 "せんきょう": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا)) / جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "せんきょうし": "مُبَشِّر, مُنَصِّر",
 "せんきょうんどう": "حملة انتخابية (حملة المرشح ليتم انتخابه) / حملة, حملة سياسية (سباق بين المرشحين لمنصب منتخب)\nمثال: أدرت حملته لمنصب الحاكم",
 "せんきょがく": "علم الانتخابات (فرع علم الاجتماع الذي يدرس اتجاهات الانتخابات)",
 "せんきょく": "دائرة إدارية, قِسم (منطقة في مدينة أو بلدة محددة لأغراض إدارية)",
 "せんきょけん": "اقتراع, حق الانتخاب (حق قانوني يكفل التصويت في الانتخابات)\nمثال: حصلت النساء الأمريكيات على حق التصويت في عام 1920",
 "せんきょけんねんれい": "سن الانتخاب, سن التصويت (السن الذي يكون فيه الشخص كبيراً بما يكفي للتصويت في الانتخابات العامة)",
 "せんきょせいど": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "せんきょにん": "مُصَوِّت, نَاخِب",
 "せんきょにんだん": "مجمع انتخابي (هيئة الناخبين الذين ينتخبون رسمياً رئيس الولايات المتحدة ونائب الرئيس)",
 "せんきょび": "يوم الاقتراع, يوم الانتخابات (اليوم المحدد للانتخابات؛ في الولايات المتحدة هو أول ثلاثاء بعد أول اثنين في نوفمبر)",
 "せんきょぼたい": "الهيئة الناخبة, ناخبون (هيئة المواطنين الذين يحق لهم التصويت)",
 "せんきょみん": "مُصَوِّت, نَاخِب",
 "せんぎ": "مُبَادَرَة / مُنَاقَشَة, بَحْث / تَحْقِيق / بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんぎょ": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "せんぎょう": "اِخْتِصَاص, تَخَصُّص",
 "せんぎょうしゅふ": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんぎょうのうか": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんぎょうふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "せんぎょてん": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "せんく": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / رَائِد, سَابِق (أي شيء يسبق شيئًا مشابهًا في الوقت)\nمثال: كان علم فراسة الدماغ سابقة لعلم الأعصاب الحديث / راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / خط حافلات (منظمة مسؤولة عن تشغيل نظام نقل بالحافلات) / مَسْرَح حَرْب",
 "せんくしゃ": "رَائِد",
 "せんくつ": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / تمشيط (التحرك عبر منطقة للبحث عن شيء ما)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء",
 "せんくてき": "رَائِد",
 "せんくん": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "せんぐ": "راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "せんぐん": "معركة بحرية (معركة ضارية بين أساطيل بحرية) / بَحْرِيَّة / كُحْلِيّ",
 "せんけい": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري / قِطَاع / زَوْرَقِيّ الشَّكْل (على شكل زَورق) / عظم زورقي (أكبر عظام الرسغ على جانب الإبهام) / لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة)",
 "せんけいかいき": "انحدار خطي (العلاقة بين المتغيرات عندما تكون معادلة الانحدار خطية)",
 "せんけいかんすう": "دَالَّة خَطِّيَّة (دالة رياضية يكون رسمها البياني (في الإحداثيات الديكارتية بمقاييس موحدة) خطاً مستوياً)",
 "せんけいけいかくほう": "برمجة خطية (تقنية رياضية تستخدم في الاقتصاد؛ تجد الحد الأقصى أو الأدنى للدوال الخطية في العديد من المتغيرات الخاضعة لقيود)",
 "せんけいさようそ": "مُؤَثِّر خَطِّيّ (مؤثر يطيع قانون التوزيع)",
 "せんけいじゅんじょ": "أسطوانة طويلة التشغيل (أسطوانة فونوغراف طويلة التشغيل؛ مصممة للتشغيل بسرعة 33.3 دورة في الدقيقة)",
 "せんけいせい": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "せんけいだいすう": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "せんけいだいすうがく": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "せんけいどうぶつ": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "せんけいほうていしき": "معادلة خطية (معادلة متعددة الحدود من الدرجة الأولى)",
 "せんけいコンジローマ": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "せんけいコンジローム": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "せんけつ": "غَرْبِيّ",
 "せんけん": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / مَنْظَر, مَشْهَد / رَشِيق, ظَرِيف",
 "せんけんしゃ": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل) / رائٍ, مشاهد (مراقب يدرك بصرياً) / رائي, صاحب بصيرة (شخص لديه قوى غير عادية لاستشراف المستقبل)\nمثال: مشاهد مدمن للأفلام",
 "せんけんせい": "استبصار, علم بالغيب (القدرة على التنبؤ بالمستقبل)",
 "せんけんてき": "متسام",
 "せんけんてつがく": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "せんけんのめ": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "せんけんのめい": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "せんけんぶたい": "طَلِيعَة",
 "せんけんろん": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "せんげ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "せんげつ": "هِلَال",
 "せんげん": "إِعْلَان, بَيَان / فصل, قطع الاتصال (عملية قطع الاتصال) / انفصال, تفكك (حالة الانفصال) / هُرَاء, لَغْو",
 "せんげんかんけつぶん": "جملة تقريرية, جملة خبرية (جملة (في صيغة الإخبار) تقوم بإعلان أو تصريح)",
 "せんげんがた": "خَبَرِيّ",
 "せんげんしょ": "إِعْلَان, بَيَان",
 "せんげんてき": "خَبَرِيّ / انفصالي, فصلي (يخدم أو يميل إلى التقسيم أو الفصل)",
 "せんげんはっぴょう": "إِعْلَان, بَيَان",
 "せんげんぶぶん": "خَبَرِيّ",
 "せんこ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد. / مرفأ قوارب (سقيفة على حافة نهر أو بحيرة؛ تستخدم لتخزين القوارب)",
 "せんこう": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / مُطَارِد / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / البَرْق / شِيلَر / تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل)) / تثقيب, خط ثقوب (خط من الثقوب الصغيرة للتمزيق في مكان معين) / تثقيب, خرق (ثقب مصنوع في شيء ما)\nمثال: ثقب في طبلة الأذن / سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات / استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة) / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / تَفْضِيل, أَفْضَلِيَّة / غَطس / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح) / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "せんこうい": "طبيب مقيم (طبيب يعيش في المستشفى ويعتني بالمرضى المقيمين تحت إشراف الطاقم الطبي للمستشفى)\nمثال: كان الطبيب المقيم يتلقى تدريباً سريرياً خاصاً في المستشفى",
 "せんこうえき": "غَسُولُ فَمّ",
 "せんこうき": "مثقاب عمودي, مكبس حفر (أداة آلية ذات حامل عمودي منفصل؛ يتم ضغط المثقاب الكهربائي في العمل تلقائياً أو برافعة يدوية)",
 "せんこうきこう": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "せんこうし": "سَابِق (يسبق في الوقت أو الترتيب) / سَابِق (مرجع الجناس؛ عبارة أو جملة يشار إليها بضمير عائد) / سابقة, مقدمة (حدث أو سبب أو واقعة سابقة) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد))",
 "せんこうしすう": "مؤشر استباقي, مؤشر رائد (واحد من 11 مؤشراً لقطاعات مختلفة من الاقتصاد؛ تستخدمه وزارة التجارة للتنبؤ بالاتجاهات الاقتصادية في المستقبل القريب)",
 "せんこうずみカード": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "せんこうそう": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن) / قفص حيوانات صغيرة, قفص خشبي (قفص (يُصنع عادة من الخشب وشبكة سلكية) للحيوانات الصغيرة)",
 "せんこうそうち": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "せんこうてい": "غَوَّاصَة",
 "せんこうでんきゅう": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "せんこうはなび": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر) / ألماس (قطع الألماس (مصطلح عامي))\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "せんこうほんやくき": "مُتَرْجِم, مُتَرْجِمَة",
 "せんこうカード": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "せんこうテープ": "شريط ورقي (شريط طويل ضيق من الورق)",
 "せんこく": "آنِفاً / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / إِعْلَان, بَيَان / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة)",
 "せんこつ": "عَجُزِ",
 "せんこふま": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "せんこふめつ": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "せんご": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح) / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "せんさい": "أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل) / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله. / قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "せんさく": "مُتَطَفِّل, مُتَلَصِّص (فضولي بطريقة مُسِيئة ومتطفلة) / تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك) / سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون / تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "せんさくずき": "فُضُول / فُضُولِيّ",
 "せんさばんべつ": "مُتَعَدِّد, مُتَنَوِّع",
 "せんさまんべつ": "مُتَعَدِّد, مُتَنَوِّع",
 "せんざい": "مُطَهِّر, مُنَظِّف / إمكانية, قابلية (استعداد يمكن تطويره) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود) / غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق الغليان) / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان. / سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن. / إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة / أَلْفِيَّة",
 "せんざいいしき": "عقل باطن, لاوعي (حالة ذهنية غير متاحة للوعي المباشر)",
 "せんざいいちぐう": "ذَهَبِيّ",
 "せんざいえき": "منظف سائل (منظف في شكل سائل)",
 "せんざいせいそう": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "せんざいてき": "كَامِن, دَفِين",
 "せんざいのうりょく": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "せんざいふま": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "せんざいもの": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "せんざいりょく": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "せんざく": "سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "せんざんこう": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل للتغذى على النمل والنمل الأبيض)",
 "せんし": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / بزل البطن (بزل البطن لإزالة السائل للتشخيص) / تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات) / عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / صمة (جسيم غير طبيعي (مثل فقاعة هواء أو جزء من جلطة) يدور في مجرى الدم)",
 "せんしがく": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "せんしきめん": "سطح مسطر (سطح يتولد عن طريق خط مستقيم متحرك بحيث يمكن رسم خط يقع بالكامل في السطح من خلال كل نقطة على السطح)\nمثال: في الهندسة الجبرية، تم تعريف الأسطح المسطرة في الأصل على أنها أسطح إسقاطية في الفضاء الإسقاطي تحتوي على خط مستقيم يمر عبر أي نقطة معطاة",
 "せんしじだい": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "せんしつ": "غرفة فاخرة, قمرة خاصة (قمرة للضيوف) / يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "せんしつけんりょうりしつ": "مطبخ صغير (مطبخ أو مخزن سفينة صغيرة)",
 "せんしゃ": "عَرَّاف, عَرَّافَة / فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة / عَرَبَة",
 "せんしゅ": "اِسْتِغْرَاق, اِنْهِمَاك / مالك السفينة (شخص يمتلك سفينة أو حصة في سفينة) / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / لَاعِب / مَشْغَل, جِهَاز / مَشْغَل / مُقَامِر / غَاصِب, مُبْتَزّ / غَصْب / ورم غدي (ورم ظهاري حميد من أصل غدي)",
 "せんしゅう": "اَلْبِدَايَة / اَلْأُسْبُوع السّابِق / اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني) / تخصص (فعل التخصص؛ جعل الشيء مناسباً لغرض خاص) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: تخصصه هو أمراض الجهاز الهضمي / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / تْشْيُوَانْتْشُو, تْشْيُوَانْجُو",
 "せんしゅうい": "طبيب مقيم (طبيب يعيش في المستشفى ويعتني بالمرضى المقيمين تحت إشراف الطاقم الطبي للمستشفى)\nمثال: كان الطبيب المقيم يتلقى تدريباً سريرياً خاصاً في المستشفى",
 "せんしゅうかもく": "رَائِد",
 "せんしゅけん": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "せんしゅけんほじしゃ": "نَصِير, نَصِيرَة",
 "せんしゅせい": "طُغْيَان, اِسْتِبْدَاد",
 "せんしゅぞう": "تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية) / واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "せんしゅだん": "فَرِيق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "せんしゅつ": "اِنْتِخَاب, اِنْتِخَابَات / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "せんしゅばんよう": "مُتَعَدِّد, مُتَنَوِّع",
 "せんしゅろう": "عنبر البحارة (أماكن معيشة تتكون من بنية فوقية في مقدمة السفينة التجارية حيث يتم إيواء الطاقم)",
 "せんしょ": "تَجْمِيعَة, دِيوَان",
 "せんしょう": "اِنْتِصَار, نَصْر / ادِّعَاء, تَظَاهُر (صفة زائفة أو لا يمكن دعمها) / ادِّعَاء, تَبَجُّح (صفة الادعاء (التصرف أو التحدث بطريقة تخلق مظهراً زائفاً للأهمية أو القيمة العظيمة)) / ادعاء, زعم حق (تقديم مطالبة أو ادعاء بحق ما)\nمثال: ادعاؤه بالحق في التاج / جُرْأَة, وَقَاحَة / تَوْصِيَة / صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "せんしょうしゃ": "غالب, منتصر (مقاتل قادر على هزيمة المنافسين) / فائز, منتصر (المتسابق الذي يفوز بالمسابقة)",
 "せんしょうせき": "لَعْل, إِسْبِينِل (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: لعل المجتهد ينجح.",
 "せんしょく": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم) / تصبيغ, تلوين مجهري ((علم الأنسجة) استخدام صبغة لتلوين العينات للدراسة المجهرية) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "せんしょくしつ": "صبغين, كروماتين",
 "せんしょくたい": "كْرُومُوسُوم, صِبْغِيّ",
 "せんしょくたいいじょう": "خلل كروموسومي, شذوذ صبغي (أي تغيير في البنية الطبيعية أو عدد الكروموسومات؛ غالباً ما يؤدي إلى تشوهات جسدية أو عقلية)",
 "せんしょくたいとつぜんへんい": "طفرة, طفرة جينية ((في علم الوراثة) أي حدث يغير البنية الجينية؛ أي تغيير في تسلسل الحمض النووي الموروث للنمط الجيني للكائن الحي)",
 "せんしょくぶんたい": "كروماتيد (أحد الخيطين المتطابقين اللذين ينقسم إليهما الكروموسوم أثناء الانقسام الفتيلي)",
 "せんしん": "مُتَقَدِّم / أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول) / تَرْكِيز / تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / حكم الخط (حكم كرة قدم يساعد الحكم الرئيسي من خلال تتبع الوقت الرسمي خلال المباراة)",
 "せんしんいちい": "بتركيز وحيد الهدف, بتصميم (بطريقة تركز على هدف واحد)",
 "せんしんこく": "دَوْلَة مُتَقَدِّمَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "せんしんてき": "مُتَقَدِّم",
 "せんじ": "زَمَن الْحَرْب, وَقْت الْحَرْب / كمون (حالة كونه غير ظاهر أو نشط بعد) / كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له) / كمون الدوران ((في علم الحاسوب) الوقت الذي يستغرقه كتلة بيانات محددة على مسار البيانات للدوران نحو رأس القراءة/الكتابة)",
 "せんじきょうさんしゅぎ": "شُيُوعِيَّةُ الْحَرْب",
 "せんじぐすり": "غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق الغليان)",
 "せんじこくさいほう": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "せんじつ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "せんじつめると": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せんじはんざい": "جَرِيمَةْ حَرْب",
 "せんじゃ": "عَرَّاف, عَرَّافَة / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / مُؤَلِّف, مُصَنِّف / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "せんじゃく": "دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف) / رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / دَقِيقٌ, رَقِيقٌ (بالغ الدقة والرهافة في التطوير)\nمثال: مقطع كمان رقيق",
 "せんじゅう": "اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية) / أصلي, من السكان الأصليين (مميز لـ أو يتعلق بالسكان الذين يقطنون منطقة منذ البداية) / ابن البلد, من السكان الأصليين (شخص من السكان الأصليين ولد في مكان معين)\nمثال: الأمريكيون الأصليون",
 "せんじゅうしゃ": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんじゅうみん": "سَاكِن أَصْلِيّ",
 "せんじゅうみんぞく": "سَاكِن أَصْلِيّ",
 "せんじゅつ": "سحر, عبقرية (قدرة إبداعية استثنائية) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "せんじゅつか": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "せんじゅらん": "حربة إسبانية, يوكا ألوفوليا (يوكا صلبة بجذع قصير؛ توجد في جنوب الولايات المتحدة وأمريكا الاستوائية؛ لها أوراق صلبة مدببة بشوكة وعناقيد من الزهور البيضاء)",
 "せんじょ": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة / جِنِّيَّة, سَاحِرَة",
 "せんじょう": "سَاحَة حَرْب, سَاحَة مَعْرَكَة / تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة) / حسية ((فلسفة) المذهب الأخلاقي القائل بأن الشعور هو المعيار الوحيد لما هو جيد) / إثارة, تهويل (الاستخدام الصحفي لموضوع يروق للأذواق المبتذلة) / إِثَارَة, صِحَافَة الْإِثَارَة (موضوع مصمم لإثارة وإرضاء الأذواق المبتذلة) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / غسيل, ملابس للغسيل (الملابس أو المنسوجات البيضاء التي يمكن تنظيفها بالغسيل) / تنظيف (فعل جعل الشيء نظيفاً) / مُطَهِّر, مُنَقٍّ (يعمل كمضادّ للعدوى؛ ذو أثر تطهيريّ) / تَطَهُّرِيّ, وُضُوئِيّ (يُنظّف الجسد بالغسل؛ خاصّة الغسل الطقوسيّ للأيدي)\nمثال: قام بتنظيف حذائه جيداً / جُرْأَة, وَقَاحَة / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً) / تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري / تحزيز, ششخانة (قطع أخاديد حلزونية داخل ماسورة سلاح ناري) / عَلَى مَتْن (على سفينة أو قطار أو طائرة أو مركبة أخرى) / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "せんじょうき": "غِسَالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات) / حَلْقَة\nمثال: تعطلت الغسالة مجددا.",
 "せんじょうざい": "مُطَهِّر, مُنَظِّف",
 "せんじょうたい": "جسم مخطط (كتلة مخططة من المادة البيضاء والرمادية تقع أمام المهاد في كل نصف كرة مخية؛ تتكون من النواة المذنبة والنواة العدسية)",
 "せんじょうち": "مخروط طميي, مروحة رسوبية (رواسب على شكل مروحة حيث يستوي مجرى مائي سريع التدفق)",
 "せんじょうてき": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / ضجة, مثير (يسبب اهتمامًا شديدًا أو فضولًا أو عاطفة قوية) / حسي (متعلق بـ أو معني بالإحساس)\nمثال: القشرة الحسية / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "せんじる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "せんじん": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة)) / طَلِيعَة / عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام / سَاحَة حَرْب, سَاحَة مَعْرَكَة / مُحَارِب, مُقَاتِل",
 "せんじんのたに": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "せんじんをきる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "せんす": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "せんすい": "نَافُورَة, فَوَّارَة / غَطس",
 "せんすいかん": "غَوَّاصَة",
 "せんすいさぎょういん": "غَطَّاسٌ, غَوَّاصٌ",
 "せんすいてい": "غَطَّاسَة, غَاطِسَة",
 "せんすいびょう": "انسداد وعائي غازي, داء الغواص (ألم ناتج عن تغير سريع في الضغط الجوي)",
 "せんすいふ": "غَطَّاسٌ, غَوَّاصٌ",
 "せんすいふく": "بدلة غوص (رداء مزود بالهواء ومحكم الإغلاق ومثقل؛ يرتديه الغواصون تحت الماء)",
 "せんすばら": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "せんすべ": "طَرِيقَة, مِنْهَج",
 "せんする": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده. / اِخْتَارَ / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / تجميع (مصدر جَمَّعَ)",
 "せんず": "مُخَطَط, رَسْم إِيضَاحِيّ / رَسْم بَيَانِيّ, مُخَطَط (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "せんずり": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "せんずる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "せんずるところ": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せんせい": "انْطِلَاقَة مُبَكِّرَة, بَادِرَة (الأفضلية المكتسبة بالبدء مبكراً (كما في السباق))\nمثال: مع انطلاقة مبكرة بساعة سيكون من الصعب اللحاق به / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / مُدَرِّب / قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / اِسْتِبْدَاد, ظُلْم (مصدر الفعل \"اسْتَبَدَّ\"؛ الحزم وعدم التردد في اتخاذ القرار وتنفيذه) / مُتَنَحٍّ / أُوتُوقْرَاطِيَّة, اِسْتِبْدَاد / تَنْجِيم",
 "せんせいがく": "تَنْجِيم",
 "せんせいがた": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "せんせいきょうじゅつしょ": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "せんせいくんしゅ": "طَاغٍ, الطَاغِي",
 "せんせいこうげき": "ضربة أولى (الاستخدام الأولي للأسلحة النووية لمهاجمة بلد يمتلك أيضاً أسلحة نووية)\nمثال: وعد الرئيس الباكستاني بعدم توجيه ضربة أولى ضد الهند",
 "せんせいしゅぎ": "مطلقية (عقيدة الكائن المطلق، وترتبط غالباً بالمثالية في الفلسفة) / حكم مطلق, شمولية (معتقد أيديولوجي في السلطة الكاملة وغير المقيدة للحكومة) / استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / استبداد, حكم مطلق (الهيمنة من خلال التهديد بالعقاب والعنف)",
 "せんせいしょ": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "せんせいじゅつ": "تَنْجِيم",
 "せんせいじゅつし": "مُنَجِّم, مُنَجِّمَة",
 "せんせいじん": "شَاهِد بِقَسَم, مُقِرّ بِالْقَسَم (شخص يقدم إفادة خطية مشفوعة بيمين)",
 "せんせいせいじ": "أُوتُوقْرَاطِيَّة, اِسْتِبْدَاد",
 "せんせいりょく": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "せんせき": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "せんせん": "جَبْهَة / أَمَامِيّ / غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون) / بَرَّاق, مُتَأَلِّق (يلمع بنقاط ضوء ساطعة كالنجوم) / تلألؤ, وميض (تغير سريع في السطوع؛ شرارة قصيرة أو وميض)\nمثال: نبيذ فوار / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "せんせんきょうきょう": "بتوتر, بقلق (بطريقة عصبية وقلقة) / باضطراب, بنزق (بإثارة عصبية)\nمثال: راقبنا سوق الأسهم بتوتر",
 "せんせんけんしゃ": "ساكن, قاطن (شخص يعيش في مكان معين لفترة طويلة أو ولد هناك)",
 "せんせんだい": "الْمُخْتَار, الْمُخْتَارَة",
 "せんせー": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "せんぜい": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "せんそ": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش)) / حق الدخول, دخول (الحق في الدخول) / إذعان, انضمام (الموافقة على أو القبول بـ (غالبًا على مضض)) / إضافة, مُقتنى جديد (شيء يضاف إلى ما تمتلكه بالفعل)\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "せんそう": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / صِرَاع / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية. / فتحة إطلاق النار, كوة (فتحة (في جدار أو سفينة أو مركبة مدرعة) لإطلاق النار من خلالها) / كوة (نافذة في سفينة أو طائرة)",
 "せんそうが": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / ألوان الحرب, زينة الحرب (الملابس والمراسم الاحتفالية الكاملة (مجازياً)) / طلاء الحرب (زينة تتكون من طلاء يوضع على الوجه والجسم لدى بعض المحاربين الهنود الحمر قبل المعركة)",
 "せんそうしんけいしょう": "إرهاق المعركة, صدمة القصف (اضطراب عقلي ناتج عن إجهاد الحرب النشطة)",
 "せんそうじょうたい": "حالة حرب, حرب (حالة قانونية تنشأ بإعلان الحرب وتنتهي بإعلان رسمي تسري خلالها القواعد الدولية للحرب)\nمثال: أعلنت الحرب في نوفمبر لكن القتال الفعلي لم يبدأ حتى الربيع التالي",
 "せんそうちょうはつ": "عُدْوَان / عِدْوَان",
 "せんそうはんざい": "جَرِيمَةْ حَرْب",
 "せんそうはんざいにん": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "せんそうみぼうじん": "أرملة الحرب (امرأة توفي زوجها في الحرب)",
 "せんそうや": "مُحَرِّض حَرْب, مُحَرِّضَة حَرْب",
 "せんそく": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف. / صمة (جسيم غير طبيعي (مثل فقاعة هواء أو جزء من جلطة) يدور في مجرى الدم) / حنف القدم, قدم حنفاء (تشوه خلقي في القدم يتميز عادةً بشكل ملتوي أو وضعية ملتوية للكاحل والكعب وأصابع القدم)",
 "せんそくどいってい": "مِئَة وَخَمْسَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 155)",
 "せんそくわたし": "متلازمة الكحول الجنينية (حالة طبية خلقية يحدث فيها تشوه في الجسم أو ضعف في تطور الوجه أو القدرة العقلية لأن الأم كانت تشرب الكحول أثناء الحمل)",
 "せんそつ": "مدرسة صناعية, مدرسة مهنية (مدرسة ثانوية تُعلّم الحرف الماهرة)",
 "せんぞ": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "せんぞがえり": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / ارتداد, تراجع (العودة إلى حالة سابقة) / ارتداد, انعكاس (التحول في الاتجاه المعاكس) / ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة)",
 "せんぞく": "حَصْرِيّ",
 "せんぞだいだい": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / جدي, سلفي (من أو ينتمي إلى أو موروث من سلف)",
 "せんぞでんしょう": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "せんぞでんらい": "عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "せんたい": "سرب طيران ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي) / أُشْنَة, طُحْلُب / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة) / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف. / مُقَدِّمَة الْحَيَوَانِ الْمَنَوِيِّ",
 "せんたいしょくぶつ": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "せんたいばんじょう": "اخْتِلَاف, تَعَدُّدِيَّة (عدم تجانس ملحوظ)\nمثال: تنوع في الاحتمالات",
 "せんたく": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / غسيل, ملابس للغسيل (الملابس أو المنسوجات البيضاء التي يمكن تنظيفها بالغسيل) / اِسْتِرْخَاءْ / اِخْتِيَار, خِيَار",
 "せんたくいた": "لوح منع الرذاذ (غطاء واقٍ يتكون من لوح عريض على طول حافة القارب لمنع الماء من التناثر فوق الجانب) / لوح غسيل (جهاز يتكون من سطح مموج لفرك الملابس عليه)",
 "せんたくかご": "سلة غسيل (سلة توضع فيها الملابس المتسخة لغسلها أو الملابس المبللة لتجفيفها)",
 "せんたくき": "غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "せんたくけん": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "せんたくこ": "مُطَهِّر, مُنَظِّف",
 "せんたくこうもく": "اِخْتِيَار, خِيَار",
 "せんたくし": "مفتاح اختيار (مفتاح يستخدم للاختيار بين البدائل) / مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي) / اِخْتِيَار, خِيَار",
 "せんたくしゃ": "مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "せんたくせっけん": "مُطَهِّر, مُنَظِّف",
 "せんたくそう": "غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "せんたくちゅう": "مختار, منتقى (تم اختياره تفضيلاً على غيره)",
 "せんたくてき": "اِنْتِقَائِيّ",
 "せんたくてきセロトニンさいとりこみそがいやく": "مثبط استرداد السيروتونين الانتقائي (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد السيروتونين بحيث يتوفر المزيد من السيروتونين للعمل على المستقبلات في الدماغ)",
 "せんたくのじゆう": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة",
 "せんたくば": "غرفة غسيل (مبنى أو ملحق حيث يتم غسيل الملابس)",
 "せんたくばさみ": "مشبك غسيل (مشبك من الخشب أو البلاستيك؛ لتثبيت الملابس على حبل الغسيل)",
 "せんたくもの": "غَسِيل, غَسْل / مَصْبَغَة, مَغْسَلَة / مَغْسَلَة (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "せんたくもん": "غَسِيل, غَسْل / مَصْبَغَة, مَغْسَلَة / مَغْسَلَة (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "せんたくや": "غَسِيل, غَسْل / مَصْبَغَة, مَغْسَلَة / مَغْسَلَة (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "せんたくバサミ": "مشبك غسيل (مشبك من الخشب أو البلاستيك؛ لتثبيت الملابس على حبل الغسيل)",
 "せんたっき": "غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "せんたん": "إِكْسِير / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / طَلِيعَة",
 "せんたんいりょうぎじゅつ": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "せんたんきょだいしょう": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "せんたんてき": "فَائِقُ الحَدَاثَة (حَدِيثٌ لِأَقْصَى دَرَجَة)",
 "せんだ": "قارب مجنح, قارب محلق (زورق سريع مجهز بهياكل تشبه الأجنحة ترفعه بحيث ينزلق فوق الماء بسرعات عالية) / طائرة مائية (طائرة يمكنها الهبوط أو الإقلاع من الماء)\nمثال: يضم المتحف نسخة طبق الأصل من القارب المجنح النفاث الذي حطم الرقم القياسي",
 "せんだい": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة)) / مقطرة (أداة عقاب سابقة تتكون من إطار خشبي ثقيل بفتحات يمكن فيها قفل قدمي (وأحياناً يدي) المخالف) / ملقط تثبيت الحيوانات (إطار لتقييد الحيوان أثناء تلقيه رعاية بيطرية أو أثناء وضع حدوة له) / دعامات بناء السفن (إطار يدعم قارباً أثناء البناء) / سِنْدَاي",
 "せんだく": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / غسيل, ملابس للغسيل (الملابس أو المنسوجات البيضاء التي يمكن تنظيفها بالغسيل) / اِسْتِرْخَاءْ / اِخْتِيَار, خِيَار",
 "せんだち": "قَائِد, زَعِيم / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "せんだって": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "せんだつ": "قَائِد, زَعِيم / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "せんだん": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي) / جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا. / أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل؛ تم توطينها في جنوب الولايات المتحدة كشجرة ظل) / أزدرخت, زنزلخت (شجرة دائمة الخضرة في أمريكا الاستوائية ذات ثمار لبية تحتوي على الصابونين الذي كان يستخدم كصابون من قبل السكان الأصليين) / تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي)) / تنبؤ, توقع (بيان يصدر حول المستقبل) / بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "せんだんき": "جَزّاز, قاص الصوف (عامل ماهر يقوم بجز الصوف عن الأغنام أو الحيوانات الأخرى) / جزّاز (عامل يستخدم المقصات لقطع الجلد أو المعدن أو المنسوجات)",
 "せんち": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / جَبْهَة / أَمَامِيّ / مِرْحَاض, تواليت / مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "せんちゃ": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "せんちゅう": "عَلَى مَتْن (على سفينة أو قطار أو طائرة أو مركبة أخرى) / نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "せんちゅうるい": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "せんちょう": "ربان, قبطان (الضابط البحري الذي يتولى قيادة سفينة عسكرية) / ربان, قبطان (ضابط مرخص له بقيادة سفينة تجارية) / طالب متغيب (طالب يفشل في حضور الفصول الدراسية)",
 "せんつい": "فقرة عجزية (واحدة من 5 فقرات في العمود الفقري البشري تلتحم عند البلوغ لتشكل العجز)",
 "せんつう": "اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها) / مَغْص, قُولَنْج",
 "せんて": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية) / سنتي (100 سنتي تساوي 1 لوتي في ليسوتو)",
 "せんてい": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات) / جَمَّة, إِنْكِلِيَّة / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة.",
 "せんていき": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم الأشجار الصغيرة) / مقلّم الأشجار (عامل يخفف ويشذب الأشجار والشجيرات)\nمثال: لم يمسها فأس مقلّم الأشجار",
 "せんていばさみ": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "せんてつ": "حديد غفل (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "せんてひっしょう": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "せんてをうつ": "تَوَقَّعَ, اِرْتَقَبَ",
 "せんてん": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / مُتَأَصِّل / نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي)) / حدبة الأسنان, شرفة (ارتفاع صغير على سطح طحن الأسنان) / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "せんてんいじょう": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "せんてんせい": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "せんてんせいいじょう": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "せんてんてき": "فِطْرِيّ, وِلَادِيّ (مَوْجُودٌ بِشَكْلٍ طَبِيعِيٍّ مُنْذُ الوِلَادَةِ) / خِلْقِيّ, وِلَادِيّ (موجود منذ الولادة لكن ليس بالضرورة وراثيًّا؛ مكتسب أثناء النمو الجنيني) / مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام) / مُسَبَّق\nمثال: سامي مسلم سابق.",
 "せんてんてきしょうがい": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "せんてんびょう": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "せんでき": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / غسيل, ملابس للغسيل (الملابس أو المنسوجات البيضاء التي يمكن تنظيفها بالغسيل)",
 "せんでん": "علانية, عمومية (صفة كون الشيء مفتوحاً للأنظار العامة أو متاحاً للجمهور) / إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: علانية قاعة المحكمة",
 "せんでんいん": "مسؤول دعاية (شخص يقوم بالدعاية)",
 "せんでんがかり": "مسؤول دعاية (شخص يقوم بالدعاية)",
 "せんでんざいりょう": "إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة",
 "せんでんちらし": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "せんでんぶ": "إدارة الدعاية والإعلان, قسم الإعلانات (قسم في مؤسسة تجارية مسؤول عن الإعلانات)",
 "せんでんぶん": "تَقْرِيظ",
 "せんでんチラシ": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "せんでんビラ": "مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "せんと": "بِدُونِ, بِلَا / إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "せんといて": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "せんとう": "رامٍ أساسي ((في البيسبول) الرامي الذي يبدأ المباراة) / مَعْرَكَة / حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / مِقَصّ, مِقْرَاض / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة في الأعلى) / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك طلبا للمهرب ولا يشترط؛ عن الشيء: فحصه فحصا دقيقا ليعرف تفاصيله)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "せんとういん": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "せんとうかん": "بارجة, سفينة حربية (سفينة حكومية متاحة لشن الحرب)",
 "せんとうき": "مُبَارِز, مُقَاتِل / مُحَارِب, مُقَاتِل / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "せんとうぎせいしゃ": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "せんとうしょうめんはば": "واجهة المبنى (وجه أو مقدمة مبنى) / واجهة (امتداد الأرض المحاذية لشارع أو ماء) / وَاجِهَة (الاتجاه الذي يواجهه شيء ما (مثل مبنى))",
 "せんとうじゅつ": "نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك طلبا للمهرب ولا يشترط؛ عن الشيء: فحصه فحصا دقيقا ليعرف تفاصيله)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "せんとうてき": "مُقَاتِل, مُحَارِب (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "せんとうにんむ": "مهمة قتالية (مهمة للاستيلاء على شيء أو الدفاع عنه)\nمثال: アメリカ軍はイラクでの戦闘任務を完了することを発表した。 — أعلنت القوات الأمريكية انتهاء مهمتها في العراق.",
 "せんとうふく": "زَيّ, زِي",
 "せんとうふのう": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "せんとうぶたい": "طَلِيعَة",
 "せんとうよういん": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل)",
 "せんとうアーチ": "قوس مدبب (قوس بقمة مدببة؛ سمة من سمات العمارة القوطية)",
 "せんとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "せんど": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / تَفَرْطُح / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً / ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف / جودة ممتازة, دقة (جودة كون الشيء جيداً جداً بالفعل) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / دقة, نعومة (امتلاك ملمس دقيق جداً) / دِقّة, رِقّة (خاصية كون الشيء ضيقاً جداً أو رقيقاً)\nمثال: يتميز النزل بدقة مأكولاته",
 "せんどう": "درب جبلي (مسار عبر منطقة جبلية) / إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / تَحْرِيض / اِهْتِزَاز / اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة) / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار. / مراكبي (رجل يقود أو يركب قارباً)",
 "せんどうおん": "تَكْرِير",
 "せんどうか": "زَعِيم الدهماء, دَهْمَاوِيّ",
 "せんどうしゃ": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / مثير للفتن, محرض (شخص يقوم بالتحريض؛ مثير للقلاقل السياسية)",
 "せんどうせい": "قِيَادَة",
 "せんない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / داخلي (يقع داخل الهيكل أو الأقرب لخط الوسط لسفينة أو طائرة)\nمثال: القلابات الداخلية على الجناح",
 "せんないつうわそうち": "إنتركم, اتصال داخلي (نظام اتصالات يربط بين غرف مختلفة داخل مبنى أو سفينة وما إلى ذلك)",
 "せんなり": "عُنْقُود, عُنْقُود نَجْمِيّ / قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "せんなりうり": "شَايُوت",
 "せんなりびょうたん": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "せんに": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "せんにち": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "せんにちこう": "قطيفة كروية, مدنة (عشب أمريكي استوائي له زهور وردية إلى حمراء أو أرجوانية يمكن تجفيفها دون أن تفقد لونها)",
 "せんにちそう": "قطيفة كروية, مدنة (عشب أمريكي استوائي له زهور وردية إلى حمراء أو أرجوانية يمكن تجفيفها دون أن تفقد لونها)",
 "せんにゅ": "جِنِّيَّة, سَاحِرَة",
 "せんにゅう": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة / تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة",
 "せんにゅうかん": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "せんにゅうけん": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "せんにゅうこうさく": "عملية تخفي, عملية سرية (عملية تنطوي على عمل سري داخل مجتمع أو مؤسسة)",
 "せんにゅうしゃ": "مُقْتَحِم, دَخِيل",
 "せんにゅうしゅ": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "せんにょ": "جِنِّيَّة, سَاحِرَة",
 "せんにん": "رجل الحدود (رجل يعيش على الحدود البرية) / أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول) / بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل / تَعْيِين, تَرْشِيح",
 "せんにんこうし": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんにんこく": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب)",
 "せんにんしょう": "صَبَّار",
 "せんぬき": "فَتَّاحَة (التي تكثر الفَتْح) / فَتَّاحَة زُجَاجَات (التي تكثر الفَتْح)",
 "せんねつ": "حرارة التحول, حرارة كامنة (حرارة ممتصة أو مشعة أثناء تغير الطور عند درجة حرارة وضغط ثابتين) / داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "せんねつちくねつ": "حرارة التحول, حرارة كامنة (حرارة ممتصة أو مشعة أثناء تغير الطور عند درجة حرارة وضغط ثابتين)",
 "せんねん": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / أَلْفِيَّة / اِمْتِصَاص",
 "せんねんおうこく": "أَلْفِيَّة",
 "せんねんおうこくせつ": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "せんねんき": "أَلْفِيَّة",
 "せんねんせつ": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "せんのう": "غَسِيل دِمَاغ, غَسِيل مُخّ / صائدة الذباب, ليخنيس (أعشاب معمرة في الغالب بسيقان لزجة تمسك بالحشرات؛ واسعة الانتشار في المنطقة المعتدلة الشمالية)",
 "せんのふとい": "حاسم, حاسمة",
 "せんば": "حصان مخصي (حصان ذكر مخصي) / حصان حرب (حصان يستخدم في الحرب) / عمل كلاسيكي مكرر (عمل فني (مقطوعة أو دراما) جزء من الذخيرة القياسية ولكنه أصبح مبتذلاً من كثرة التكرار) / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
