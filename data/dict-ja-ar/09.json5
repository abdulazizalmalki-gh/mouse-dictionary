 "せちょう": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "せっか": "مُتَحَجِّرَة (صخرة نشأت بالتحجر؛ جسم عضوي تخللته مادة معدنية وحُفظ في شكله الأصلي) / البَرْق / رُقَاقَةُ الثَّلْج, نُدْفَةُ الثَّلْج",
 "せっかい": "جِير (طلاه بالجير؛ جيَّر الحوض: قعَّره)\nمثال: طليت الحاىءط بالجير. / شَقّ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو…)\nمثال: اكشف عن الشق العلوي من الجسم. / تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "せっかいか": "تَكَلُّس",
 "せっかいがん": "حَجَر جِيرِيّ, حَجَر كِلْسِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "せっかいしつ": "جيري, طباشيري (مكون من أو يحتوي على أو يشبه كربونات الكالسيوم أو الكالسيت أو الطباشير)",
 "せっかいしゅじゅつ": "جراحة, عملية جراحية (إجراء طبي يتضمن شقاً بالأدوات؛ يتم إجراؤه لإصلاح تلف أو وقف مرض في جسم حي)\nمثال: سيحددون موعد العملية بمجرد توفر غرفة عمليات",
 "せっかいすい": "ماء الجير (محلول هيدروكسيد الكالسيوم في الماء يستخدم كمضاد للحموضة)",
 "せっかいせき": "حَجَر جِيرِيّ, حَجَر كِلْسِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "せっかいにゅう": "لبن الجير (معلق مائي لهيدروكسيد الكالسيوم، يستخدم في الدباغة كعامل قاعدي)\nمثال: بعد النقع، تؤخذ الجلود لعملية التجيير: المعالجة بلبن الجير (عامل قاعدي)",
 "せっかく": "نَادِر / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "せっかせっこう": "مرمر",
 "せっかそう": "شيجياتشوانج, شِيجْيَاجْوَانْغ",
 "せっかち": "مُتَسَرِّع",
 "せっかっしょく": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "せっかん": "نَاوُوس / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار))\nمثال: خطاب تحذير حول مخاطر الفسق / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / تأنيب, توبيخ (عقاب لفظي)",
 "せっき": "راية حمراء, نذير خطر (شيء يثير الغضب أو يتطلب إجراءً فوريًا)\nمثال: القيام بذلك يشبه التلويح بخرقة حمراء أمام ثور / أَبْيَض نَاصِع (بلون أبيض نقي صافٍ) / مُذَنَّب / فخار حجري (أواني خزفية يتم حرقها في حرارة عالية وتكون مزججة وغير مسامية) / الكتلة الأساسية, المصفوفة الصخرية ((جيولوجيا) مصفوفة من مادة بلورية ناعمة الحبيبات تكون البلورات الأكبر مغمورة فيها) / شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ…)\nمثال: العجلة من الشيطان. / زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة)",
 "せっきじだい": "الْعَصْر الْحَجَرِيّ, عَصْر حَجَرِيّ",
 "せっきばらい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "せっきぶんか": "الْعَصْر الْحَجَرِيّ, عَصْر حَجَرِيّ",
 "せっきゃく": "اِسْتِقْبَال",
 "せっきゃくぎょう": "صناعة الخدمات (صناعة تقدم خدمات بدلاً من سلع ملموسة)",
 "せっきゃくふ": "مُضِيفَة",
 "せっきょう": "مَوْعِظَة, خُطْبَة / اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "せっきょうくさい": "مُتَنَطِّع, وَعْظِيّ (يميل إلى الوعظ الأخلاقي الممل أو يتّسم به)",
 "せっきょうし": "وَاعِظ",
 "せっきょうしゃ": "وَاعِظ",
 "せっきょく": "نَشِيط, عَامِل\nمثال: لقد أوقفنا حركة المرور. / مِصْعَد",
 "せっきょくかかん": "عُدْوَانِيّ",
 "せっきょくこうどうしゅぎ": "نَشَاطِيَّة",
 "せっきょくこうどうしゅぎしゃ": "نَاشِط, نَاشِطَة",
 "せっきょくせい": "تَوْكِيد الذَّات, حَزْم (ثقة بالنفس عدوانية؛ الميل إلى تقديم تأكيدات جريئة)",
 "せっきょくてき": "مُوجَب",
 "せっきょくろん": "إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "せっきん": "اقتراب, دنو (فعل الاقتراب مكانياً من شيء ما)\nمثال: اقتراب الصياد شتت الإوز",
 "せっく": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "せっくつ": "كهف كبير, مغارة (كهف كبير أو غرفة كبيرة داخل كهف)\nمثال: كانت عيناه كهوفاً مظلمة",
 "せっけい": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه. / إسفين, وتد (أي شكل مقطعه العرضي مثلث) / مُطَّلَعً مُسْتَقِيم",
 "せっけいしゃ": "مُصَمِّم, مُصَمِّمَة",
 "せっけいず": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "せっけいめいさいしょ": "نظارة ((جمع) أداة بصرية تتكون من إطار يحمل زوجاً من العدسات لتصحيح الرؤية المعيبة)",
 "せっけいもじ": "مِسْمَارِيَّة",
 "せっけっきゅう": "كُرَيَّةُ دَمٍ ُحَمْرَاء, خَلِيَّةُ دَمٍ حَمْرَاءُ",
 "せっけっきゅうぎょうしゅう": "تراص دموي, تلازن دموي (تراص خلايا الدم الحمراء)",
 "せっけっきゅうせいせいそくしんいんし": "إريثروبويتين (بروتين سكري تفرزه الكلى يحفز إنتاج خلايا الدم الحمراء)",
 "せっけっきゅうぞうかしょう": "احمرار الدم, كثرة الحمر (اضطراب يتميز بزيادة غير طبيعية في عدد خلايا الدم الحمراء في الدم)",
 "せっけっきゅうちんこうそくど": "سُرْعَة التَّثَفُّل, مُعَدَّل تَثَفُّل كُرَيَات الدَّم الحَمْرَاء (المعدل الذي تترسب به خلايا الدم الحمراء في أنبوب دم تحت ظروف قياسية؛ يشير…)",
 "せっけつ": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "せっけん": "صَابُون, صابونة / جُمْهُور, نَظَّارَة / اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد. / كنس (فعل التنظيف بالمكنسة) / سَيْفِيّ الشَّكْل (على شكل نصل السيف)",
 "せっけんいれ": "صحن صابون (تجهيزات حمام أو مطبخ لحمل قطعة الصابون)",
 "せっけんおき": "صحن صابون (تجهيزات حمام أو مطبخ لحمل قطعة الصابون)",
 "せっけんせき": "حجر صابوني, ستيتيت (نوع مضغوط ثقيل وناعم من التلك ذو ملمس صابوني؛ يستخدم لصنع المواقد وأسطح…)",
 "せっけんだい": "صحن صابون (تجهيزات حمام أو مطبخ لحمل قطعة الصابون)",
 "せっけんだま": "فُقَّاعَةُ صَابُون",
 "せっけんのあわ": "رغوة الصابون (الرغوة التي ينتجها الصابون أو المنظفات)",
 "せっけんばこ": "صحن صابون (تجهيزات حمام أو مطبخ لحمل قطعة الصابون)",
 "せっこう": "كَشَّاف / بَنَّاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / مِلَاط, جِبْس",
 "せっこうたい": "كَشَّاف",
 "せっこうへい": "كَشَّاف",
 "せっこうボード": "جبس بورد, لوح جصي (لوح جداري بقلب من الجص الجبسي مرتبط بطبقات من الورق أو الألواح الليفية؛ يستخدم…)",
 "せっこく": "دَنْدَرُوب",
 "せっこくぶん": "علم النقوش (دراسة النقوش القديمة)",
 "せっこつい": "مقوم العظام (معالج يعالج الهيكل العظمي والعضلات)",
 "せっこつぼく": "بيلسان أحمر أمريكي (شجيرة أو شجرة صغيرة شائعة في أمريكا الشمالية)",
 "せっこん": "ثلم, حز (قطع صغير)\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "せっさ": "تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "せっさく": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه. / قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "せっさくこうぐ": "أداة قطع, قاطعة (أداة للقطع)",
 "せっさん": "هِمَالِيَة, هِيمَالَايَا",
 "せっし": "قَاطِعَة / صرير الأسنان / سِيلْزْيُوس, سَلْسْيُوس / مِلْقَط صَغِير, مِلْقَط",
 "せっしかた": "مَوْقِف, سُلُوك",
 "せっししょう": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو…)",
 "せっしゃ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو…)",
 "せっしゃリング": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو…)",
 "せっしゅ": "تَلْقِيح / استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس) / اِمْتِصَاص / سَرِقَة, سَرَقَة / تعديل, تلطيف (عملية التلطيف أو المزج المعتدل)",
 "せっしゅう": "حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي…)\nمثال: أولاً عليك ملء طلب الصرف",
 "せっしゅりょう": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس)",
 "せっしょう": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا. / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / وِصَايَة / مُفَاوَضَات, مُذَاكَرَات",
 "せっしょく": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي! / مُلَامَسَة, لَمْسَة / تلامس, نقطة تلامس ((إلكترونيات) نقطة اتصال حيث تتلامس الأشياء (مثل موصلين كهربائيين))\nمثال: نسوا لحام نقاط التلامس / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "せっしょくがめん": "شَاشَة لَمْس",
 "せっしょくしき": "مُلَامَسَة, لَمْسَة",
 "せっしょくしゃ": "خَطِر, مُحْفُوفٌ بِالمَخَاطِر (غير آمن ماليًّا؛ ينطوي على مضاربة ومخاطرة عالية)",
 "せっしょくしょうがい": "اضطراب الأكل (اضطراب في روتين الأكل الطبيعي)",
 "せっしょくじこ": "خَمَشَ ((خَمَّشَ): خَدَشَ، وخَمَّشَ وَجْهَهُ تَخْمِيشًا: خَدَشَه؛ (خَمَّشَه): خمشه أى…)",
 "せっしょくせん": "خَطّ اِتِّصَال, خَطّ الْاِتِّصَال (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "せっしょくでんせん": "سريان, عدوى (انتقال موقف أو حالة عاطفية بين عدد من الناس)\nمثال: عدوى من المرح",
 "せっしょくへんせいたい": "إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس)",
 "せっしる": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي! / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "せっしん": "تَرْكِيز",
 "せっすい": "حفظ المياه (الحفاظ على موارد المياه)",
 "せっする": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي! / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا. / أَنْقَذَ, أَنْجَى\nمثال: حفظ رقم هاتفها.",
 "せっせ": "بِجِدّ",
 "せっせい": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله…)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة. / مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف…)",
 "せっせいほう": "عِلْم الصِّحَّة, عِلْم حِفْظ الصِّحَّة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せっせと": "بِجِدّ",
 "せっせん": "خط الثلج (الخط على الجبل الذي يوجد فوقه ثلج وجليد دائم) / رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة / هِمَالِيَة, هِيمَالَايَا",
 "せっせんしゅう": "وِلَايَة مُتَأَرْجِحَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما…)\nمثال: كان زيري من ولاية أخرى.",
 "せっそう": "أَمَانَة, نَزَاهَة / إِيقَاع",
 "せっそうがない": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "せっそく": "عَمَلِيّ, فَعَّالٌ وَإِنْ بَسِيط (بسيط لكنّه فعّال للغرض المطلوب)",
 "せっそくしゅぎ": "عَمَلِيّ, فَعَّالٌ وَإِنْ بَسِيط (بسيط لكنّه فعّال للغرض المطلوب)",
 "せっそくどうぶつ": "مفصلي, مفصلي الأرجل (حيوان لا فقاري له أطراف مفصلية وجسم مقسم مع هيكل خارجي مصنوع من الكيتين)",
