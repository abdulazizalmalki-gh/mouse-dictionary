 "せんけつ": "غَرْبِيّ",
 "せんけん": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / مَنْظَر, مَشْهَد / رَشِيق, ظَرِيف",
 "せんけんしゃ": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل)\nمثال: مشاهد مدمن للأفلام",
 "せんけんせい": "استبصار, علم بالغيب (القدرة على التنبؤ بالمستقبل)",
 "せんけんてき": "متسام",
 "せんけんてつがく": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "せんけんのめ": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل)",
 "せんけんのめい": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل)",
 "せんけんぶたい": "طَلِيعَة",
 "せんけんろん": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "せんげ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "せんげつ": "هِلَال",
 "せんげん": "إِعْلَان, بَيَان / فصل, قطع الاتصال (عملية قطع الاتصال) / هُرَاء, لَغْو",
 "せんげんかんけつぶん": "جملة تقريرية, جملة خبرية (جملة (في صيغة الإخبار) تقوم بإعلان أو تصريح)",
 "せんげんがた": "خَبَرِيّ",
 "せんげんしょ": "إِعْلَان, بَيَان",
 "せんげんてき": "خَبَرِيّ / انفصالي, فصلي (يخدم أو يميل إلى التقسيم أو الفصل)",
 "せんげんはっぴょう": "إِعْلَان, بَيَان",
 "せんげんぶぶん": "خَبَرِيّ",
 "せんこ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد. / مرفأ قوارب (سقيفة على حافة نهر أو بحيرة؛ تستخدم لتخزين القوارب)",
 "せんこう": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في…)\nمثال: سبق و رأيت ذلك. / مُطَارِد / اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق / البَرْق / شِيلَر / تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل))\nمثال: ثقب في طبلة الأذن / سِقِلَّاتِيّ, قِرْمِزِيّ / استخلاص المعادن, معالجة الخامات (سحق الخامات وفصلها إلى مواد قيمة أو نفايات باستخدام أي من التقنيات المتنوعة) / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / تَفْضِيل, أَفْضَلِيَّة / غَطس / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / عكس, قلب (عملية القلب من الداخل إلى الخارج) / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود)",
 "せんこうい": "طبيب مقيم (طبيب يعيش في المستشفى ويعتني بالمرضى المقيمين تحت إشراف الطاقم الطبي للمستشفى)\nمثال: كان الطبيب المقيم يتلقى تدريباً سريرياً خاصاً في المستشفى",
 "せんこうえき": "غَسُولُ فَمّ",
 "せんこうき": "مثقاب عمودي, مكبس حفر (أداة آلية ذات حامل عمودي منفصل؛ يتم ضغط المثقاب الكهربائي في العمل تلقائياً أو…)",
 "せんこうきこう": "لَكْمَة\nمثال: لكم اشتقت إليك!",
 "せんこうし": "سَابِق (يسبق في الوقت أو الترتيب)",
 "せんこうしすう": "مؤشر استباقي, مؤشر رائد (واحد من 11 مؤشراً لقطاعات مختلفة من الاقتصاد؛ تستخدمه وزارة التجارة للتنبؤ…)",
 "せんこうずみカード": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "せんこうそう": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "せんこうそうち": "لَكْمَة\nمثال: لكم اشتقت إليك!",
 "せんこうてい": "غَوَّاصَة",
 "せんこうでんきゅう": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "せんこうはなび": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر)\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "せんこうほんやくき": "مُتَرْجِم, مُتَرْجِمَة",
 "せんこうカード": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "せんこうテープ": "شريط ورقي (شريط طويل ضيق من الورق)",
 "せんこく": "آنِفاً / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / إِعْلَان, بَيَان / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة)",
 "せんこつ": "عَجُزِ",
 "せんこふま": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "せんこふめつ": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "せんご": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / عكس, قلب (عملية القلب من الداخل إلى الخارج) / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود)",
 "せんさい": "أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله. / قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "せんさく": "مُتَطَفِّل, مُتَلَصِّص (فضولي بطريقة مُسِيئة ومتطفلة) / سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون / تحول (فعل التغيير في الممارسة أو العادة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين",
 "せんさくずき": "فُضُول / فُضُولِيّ",
 "せんさばんべつ": "مُتَعَدِّد, مُتَنَوِّع",
 "せんさまんべつ": "مُتَعَدِّد, مُتَنَوِّع",
 "せんざい": "مُطَهِّر, مُنَظِّف / إمكانية, قابلية (استعداد يمكن تطويره) / غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق…) / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان. / سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ :…)\nمثال: هذا السلك ساخن. / إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة / أَلْفِيَّة",
 "せんざいいしき": "عقل باطن, لاوعي (حالة ذهنية غير متاحة للوعي المباشر)",
 "せんざいいちぐう": "ذَهَبِيّ",
 "せんざいえき": "منظف سائل (منظف في شكل سائل)",
 "せんざいせいそう": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "せんざいてき": "كَامِن, دَفِين",
 "せんざいのうりょく": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية)\nمثال: مشكلة محتملة",
 "せんざいふま": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "せんざいもの": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "せんざいりょく": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية)\nمثال: مشكلة محتملة",
 "せんざく": "سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "せんざんこう": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل…)",
 "せんし": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي. / بزل البطن (بزل البطن لإزالة السائل للتشخيص) / تقليم (عملية تشذيب النبات) / عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / صمة (جسيم غير طبيعي (مثل فقاعة هواء أو جزء من جلطة) يدور في مجرى الدم)",
 "せんしがく": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "せんしきめん": "سطح مسطر (سطح يتولد عن طريق خط مستقيم متحرك بحيث يمكن رسم خط يقع بالكامل في السطح من خلال…)\nمثال: في الهندسة الجبرية، تم تعريف الأسطح المسطرة في الأصل على أنها أسطح إسقاطية في الفضاء الإسقاطي تحتوي على خط مستقيم يمر عبر أي نقطة معطاة",
 "せんしじだい": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "せんしつ": "غرفة فاخرة, قمرة خاصة (قمرة للضيوف) / يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "せんしつけんりょうりしつ": "مطبخ صغير (مطبخ أو مخزن سفينة صغيرة)",
 "せんしゃ": "عَرَّاف, عَرَّافَة / فِنْطَاس, صِهْرِيج / عَرَبَة",
 "せんしゅ": "اِسْتِغْرَاق, اِنْهِمَاك / مالك السفينة (شخص يمتلك سفينة أو حصة في سفينة) / قَوْس, قوس / لَاعِب / غَاصِب, مُبْتَزّ / غَصْب / ورم غدي (ورم ظهاري حميد من أصل غدي)",
 "せんしゅう": "اَلْبِدَايَة / اَلْأُسْبُوع السّابِق / اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني)\nمثال: تخصصه هو أمراض الجهاز الهضمي / اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة. / تْشْيُوَانْتْشُو, تْشْيُوَانْجُو",
 "せんしゅうい": "طبيب مقيم (طبيب يعيش في المستشفى ويعتني بالمرضى المقيمين تحت إشراف الطاقم الطبي للمستشفى)\nمثال: كان الطبيب المقيم يتلقى تدريباً سريرياً خاصاً في المستشفى",
 "せんしゅうかもく": "رَائِد",
 "せんしゅけん": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "せんしゅけんほじしゃ": "نَصِير, نَصِيرَة",
 "せんしゅせい": "طُغْيَان, اِسْتِبْدَاد",
 "せんしゅぞう": "تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية)",
 "せんしゅだん": "فَرِيق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "せんしゅつ": "اِنْتِخَاب, اِنْتِخَابَات / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "せんしゅばんよう": "مُتَعَدِّد, مُتَنَوِّع",
 "せんしゅろう": "عنبر البحارة (أماكن معيشة تتكون من بنية فوقية في مقدمة السفينة التجارية حيث يتم إيواء الطاقم)",
 "せんしょ": "تَجْمِيعَة, دِيوَان",
 "せんしょう": "اِنْتِصَار, نَصْر / ادِّعَاء, تَظَاهُر (صفة زائفة أو لا يمكن دعمها)\nمثال: ادعاؤه بالحق في التاج / جُرْأَة, وَقَاحَة / تَوْصِيَة / صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)\nمثال: افتقد لزوجته السابقة.",
 "せんしょうしゃ": "غالب, منتصر (مقاتل قادر على هزيمة المنافسين)",
 "せんしょうせき": "لَعْل, إِسْبِينِل (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: لعل المجتهد ينجح.",
 "せんしょく": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم) / تصبيغ, تلوين مجهري ((علم الأنسجة) استخدام صبغة لتلوين العينات للدراسة المجهرية)",
 "せんしょくしつ": "صبغين, كروماتين",
 "せんしょくたい": "كْرُومُوسُوم, صِبْغِيّ",
 "せんしょくたいいじょう": "خلل كروموسومي, شذوذ صبغي (أي تغيير في البنية الطبيعية أو عدد الكروموسومات؛ غالباً ما يؤدي إلى تشوهات…)",
 "せんしょくたいとつぜんへんい": "طفرة, طفرة جينية ((في علم الوراثة) أي حدث يغير البنية الجينية؛ أي تغيير في تسلسل الحمض النووي…)",
 "せんしょくぶんたい": "كروماتيد (أحد الخيطين المتطابقين اللذين ينقسم إليهما الكروموسوم أثناء الانقسام الفتيلي)",
 "せんしん": "مُتَقَدِّم / أقدمية, طول العمر (خاصية العيش طويلاً) / تَرْكِيز / تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة)\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / حكم الخط (حكم كرة قدم يساعد الحكم الرئيسي من خلال تتبع الوقت الرسمي خلال المباراة)",
 "せんしんいちい": "بتركيز وحيد الهدف, بتصميم (بطريقة تركز على هدف واحد)",
 "せんしんこく": "دَوْلَة مُتَقَدِّمَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "せんしんてき": "مُتَقَدِّم",
 "せんじ": "زَمَن الْحَرْب, وَقْت الْحَرْب / كمون (حالة كونه غير ظاهر أو نشط بعد)",
 "せんじきょうさんしゅぎ": "شُيُوعِيَّةُ الْحَرْب",
 "せんじぐすり": "غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق…)",
 "せんじこくさいほう": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "せんじつ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "せんじつめると": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せんじはんざい": "جَرِيمَةْ حَرْب",
 "せんじゃ": "عَرَّاف, عَرَّافَة / قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / مُؤَلِّف, مُصَنِّف\nمثال: ألف شكر على لطفك.",
 "せんじゃく": "دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف)\nمثال: مقطع كمان رقيق",
 "せんじゅう": "اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها…) / اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق / أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية)\nمثال: الأمريكيون الأصليون",
 "せんじゅうしゃ": "بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "せんじゅうみん": "سَاكِن أَصْلِيّ",
 "せんじゅうみんぞく": "سَاكِن أَصْلِيّ",
 "せんじゅつ": "سحر, عبقرية (قدرة إبداعية استثنائية) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك…) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة. / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "せんじゅつか": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "せんじゅらん": "حربة إسبانية, يوكا ألوفوليا (يوكا صلبة بجذع قصير؛ توجد في جنوب الولايات المتحدة وأمريكا الاستوائية؛ لها…)",
 "せんじょ": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة / جِنِّيَّة, سَاحِرَة",
 "せんじょう": "سَاحَة حَرْب, سَاحَة مَعْرَكَة / تجريبية, حسية ((فلسفة) المذهب القائل بأن المعرفة تُستمد من التجربة) / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً)\nمثال: تطلع إلى إثارة اليوم / غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / تنظيف (فعل جعل الشيء نظيفاً)\nمثال: قام بتنظيف حذائه جيداً / جُرْأَة, وَقَاحَة / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل)\nمثال: جهاز تناظري / تحزيز, ششخانة (قطع أخاديد حلزونية داخل ماسورة سلاح ناري) / عَلَى مَتْن (على سفينة أو قطار أو طائرة أو مركبة أخرى) / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "せんじょうき": "غِسَالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة…)\nمثال: تعطلت الغسالة مجددا.",
 "せんじょうざい": "مُطَهِّر, مُنَظِّف",
 "せんじょうたい": "جسم مخطط (كتلة مخططة من المادة البيضاء والرمادية تقع أمام المهاد في كل نصف كرة مخية…)",
 "せんじょうち": "مخروط طميي, مروحة رسوبية (رواسب على شكل مروحة حيث يستوي مجرى مائي سريع التدفق)",
 "せんじょうてき": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره)\nمثال: القشرة الحسية / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش)",
 "せんじる": "دُمَّل, خُرَاج",
 "せんじん": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / طَلِيعَة / عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام / سَاحَة حَرْب, سَاحَة مَعْرَكَة / مُحَارِب, مُقَاتِل",
 "せんじんのたに": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "せんじんをきる": "رَصَاص",
 "せんす": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "せんすい": "نَافُورَة, فَوَّارَة / غَطس",
 "せんすいかん": "غَوَّاصَة",
 "せんすいさぎょういん": "غَطَّاسٌ, غَوَّاصٌ",
 "せんすいてい": "غَطَّاسَة, غَاطِسَة",
 "せんすいびょう": "انسداد وعائي غازي, داء الغواص (ألم ناتج عن تغير سريع في الضغط الجوي)",
 "せんすいふ": "غَطَّاسٌ, غَوَّاصٌ",
 "せんすいふく": "بدلة غوص (رداء مزود بالهواء ومحكم الإغلاق ومثقل؛ يرتديه الغواصون تحت الماء)",
 "せんすばら": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل…)\nمثال: محكم عليه بالإعدام.",
 "せんすべ": "طَرِيقَة, مِنْهَج",
 "せんする": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده. / اِخْتَارَ / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / تجميع (مصدر جَمَّعَ)",
 "せんず": "مُخَطَط, رَسْم إِيضَاحِيّ\nمثال: واصل زيري الرسم.",
 "せんずり": "عَادَة سِرِّيَّة",
 "せんずる": "دُمَّل, خُرَاج",
 "せんずるところ": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "せんせい": "انْطِلَاقَة مُبَكِّرَة, بَادِرَة (الأفضلية المكتسبة بالبدء مبكراً (كما في السباق))\nمثال: مع انطلاقة مبكرة بساعة سيكون من الصعب اللحاق به / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / مُدَرِّب / قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / اِسْتِبْدَاد, ظُلْم (مصدر الفعل \"اسْتَبَدَّ\"؛ الحزم وعدم التردد في اتخاذ القرار وتنفيذه) / مُتَنَحٍّ / أُوتُوقْرَاطِيَّة, اِسْتِبْدَاد / تَنْجِيم",
 "せんせいがく": "تَنْجِيم",
 "せんせいがた": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "せんせいきょうじゅつしょ": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة…)",
 "せんせいくんしゅ": "طَاغٍ, الطَاغِي",
 "せんせいこうげき": "ضربة أولى (الاستخدام الأولي للأسلحة النووية لمهاجمة بلد يمتلك أيضاً أسلحة نووية)\nمثال: وعد الرئيس الباكستاني بعدم توجيه ضربة أولى ضد الهند",
 "せんせいしゅぎ": "مطلقية (عقيدة الكائن المطلق، وترتبط غالباً بالمثالية في الفلسفة)",
 "せんせいしょ": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "せんせいじゅつ": "تَنْجِيم",
 "せんせいじゅつし": "مُنَجِّم, مُنَجِّمَة",
 "せんせいじん": "شَاهِد بِقَسَم, مُقِرّ بِالْقَسَم (شخص يقدم إفادة خطية مشفوعة بيمين)",
 "せんせいせいじ": "أُوتُوقْرَاطِيَّة, اِسْتِبْدَاد",
 "せんせいりょく": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية)\nمثال: مشكلة محتملة",
 "せんせき": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة.",
 "せんせん": "جَبْهَة / غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون)\nمثال: نبيذ فوار / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "せんせんきょうきょう": "بتوتر, بقلق (بطريقة عصبية وقلقة)\nمثال: راقبنا سوق الأسهم بتوتر",
 "せんせんけんしゃ": "ساكن, قاطن (شخص يعيش في مكان معين لفترة طويلة أو ولد هناك)",
 "せんせんだい": "الْمُخْتَار, الْمُخْتَارَة",
 "せんせー": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "せんぜい": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "せんそ": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش))\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "せんそう": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / صِرَاع / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية. / فتحة إطلاق النار, كوة (فتحة (في جدار أو سفينة أو مركبة مدرعة) لإطلاق النار من خلالها)",
 "せんそうが": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)",
 "せんそうしんけいしょう": "إرهاق المعركة, صدمة القصف (اضطراب عقلي ناتج عن إجهاد الحرب النشطة)",
 "せんそうじょうたい": "حالة حرب, حرب (حالة قانونية تنشأ بإعلان الحرب وتنتهي بإعلان رسمي تسري خلالها القواعد الدولية…)\nمثال: أعلنت الحرب في نوفمبر لكن القتال الفعلي لم يبدأ حتى الربيع التالي",
 "せんそうちょうはつ": "عُدْوَان",
 "せんそうはんざい": "جَرِيمَةْ حَرْب",
 "せんそうはんざいにん": "مُجْرِم حَرْب, مُجْرِمَة حَرْب",
 "せんそうみぼうじん": "أرملة الحرب (امرأة توفي زوجها في الحرب)",
 "せんそうや": "مُحَرِّض حَرْب, مُحَرِّضَة حَرْب",
 "せんそく": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله)\nمثال: وقف على حافة الجرف. / صمة (جسيم غير طبيعي (مثل فقاعة هواء أو جزء من جلطة) يدور في مجرى الدم) / حنف القدم, قدم حنفاء (تشوه خلقي في القدم يتميز عادةً بشكل ملتوي أو وضعية ملتوية للكاحل والكعب وأصابع…)",
 "せんそくどいってい": "مِئَة وَخَمْسَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 155)",
 "せんそくわたし": "متلازمة الكحول الجنينية (حالة طبية خلقية يحدث فيها تشوه في الجسم أو ضعف في تطور الوجه أو القدرة العقلية…)",
 "せんそつ": "مدرسة صناعية, مدرسة مهنية (مدرسة ثانوية تُعلّم الحرف الماهرة)",
 "せんぞ": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "せんぞがえり": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى)",
 "せんぞく": "حَصْرِيّ",
 "せんぞだいだい": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث)",
 "せんぞでんしょう": "أُسْطُورَة\nمثال: بحث عن المفتاح.",
 "せんぞでんらい": "عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "せんたい": "سرب طيران ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات:…) / أُشْنَة, طُحْلُب / بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات…)\nمثال: عدن إلى المصرف. / مُقَدِّمَة الْحَيَوَانِ الْمَنَوِيِّ",
 "せんたいしょくぶつ": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "せんたいばんじょう": "اخْتِلَاف, تَعَدُّدِيَّة (عدم تجانس ملحوظ)\nمثال: تنوع في الاحتمالات",
 "せんたく": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / اِسْتِرْخَاءْ / اِخْتِيَار, خِيَار",
 "せんたくいた": "لوح منع الرذاذ (غطاء واقٍ يتكون من لوح عريض على طول حافة القارب لمنع الماء من التناثر فوق الجانب)",
 "せんたくかご": "سلة غسيل (سلة توضع فيها الملابس المتسخة لغسلها أو الملابس المبللة لتجفيفها)",
 "せんたくき": "غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة…)\nمثال: تعطلت الغسالة مجددا.",
 "せんたくけん": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "せんたくこ": "مُطَهِّر, مُنَظِّف",
 "せんたくこうもく": "اِخْتِيَار, خِيَار",
 "せんたくし": "مفتاح اختيار (مفتاح يستخدم للاختيار بين البدائل) / اِخْتِيَار, خِيَار",
 "せんたくしゃ": "مُخْتَار, مُنْتَقٍ (شخص يختار أو ينتقي)",
 "せんたくせっけん": "مُطَهِّر, مُنَظِّف",
 "せんたくそう": "غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة…)\nمثال: تعطلت الغسالة مجددا.",
 "せんたくちゅう": "مختار, منتقى (تم اختياره تفضيلاً على غيره)",
 "せんたくてき": "اِنْتِقَائِيّ",
 "せんたくてきセロトニンさいとりこみそがいやく": "مثبط استرداد السيروتونين الانتقائي (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد السيروتونين بحيث يتوفر المزيد من…)",
 "せんたくのじゆう": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة",
 "せんたくば": "غرفة غسيل (مبنى أو ملحق حيث يتم غسيل الملابس)",
 "せんたくばさみ": "مشبك غسيل (مشبك من الخشب أو البلاستيك؛ لتثبيت الملابس على حبل الغسيل)",
 "せんたくもの": "غَسِيل, غَسْل\nمثال: كان في المغسلة.",
 "せんたくもん": "غَسِيل, غَسْل\nمثال: كان في المغسلة.",
 "せんたくや": "غَسِيل, غَسْل\nمثال: كان في المغسلة.",
 "せんたくバサミ": "مشبك غسيل (مشبك من الخشب أو البلاستيك؛ لتثبيت الملابس على حبل الغسيل)",
 "せんたっき": "غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة…)\nمثال: تعطلت الغسالة مجددا.",
 "せんたん": "إِكْسِير / طَرَف / طَلِيعَة",
 "せんたんいりょうぎじゅつ": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "せんたんきょだいしょう": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات…)",
 "せんたんてき": "فَائِقُ الحَدَاثَة (حَدِيثٌ لِأَقْصَى دَرَجَة)",
 "せんだ": "قارب مجنح, قارب محلق (زورق سريع مجهز بهياكل تشبه الأجنحة ترفعه بحيث ينزلق فوق الماء بسرعات عالية)\nمثال: يضم المتحف نسخة طبق الأصل من القارب المجنح النفاث الذي حطم الرقم القياسي",
 "せんだい": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / مقطرة (أداة عقاب سابقة تتكون من إطار خشبي ثقيل بفتحات يمكن فيها قفل قدمي (وأحياناً…) / سِنْدَاي",
 "せんだく": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون)) / اِسْتِرْخَاءْ / اِخْتِيَار, خِيَار",
 "せんだち": "قَائِد, زَعِيم / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "せんだって": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "せんだつ": "قَائِد, زَعِيم / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "せんだん": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات:…) / جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ…)\nمثال: طلبت من توم جز عشبنا. / أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل…) / تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي))\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "せんだんき": "جَزّاز, قاص الصوف (عامل ماهر يقوم بجز الصوف عن الأغنام أو الحيوانات الأخرى)",
 "せんち": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / جَبْهَة / مِرْحَاض, تواليت / مَوْضِع\nمثال: هنا موقع الحادث.",
 "せんちゃ": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "せんちゅう": "عَلَى مَتْن (على سفينة أو قطار أو طائرة أو مركبة أخرى) / نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "せんちゅうるい": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "せんちょう": "ربان, قبطان (الضابط البحري الذي يتولى قيادة سفينة عسكرية)",
 "せんつい": "فقرة عجزية (واحدة من 5 فقرات في العمود الفقري البشري تلتحم عند البلوغ لتشكل العجز)",
 "せんつう": "اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها) / مَغْص, قُولَنْج",
 "せんて": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية) / سنتي (100 سنتي تساوي 1 لوتي في ليسوتو)",
 "せんてい": "اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق / تقليم (عملية تشذيب النبات) / جَمَّة, إِنْكِلِيَّة / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "せんていき": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم…)\nمثال: لم يمسها فأس مقلّم الأشجار",
 "せんていばさみ": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "せんてつ": "حديد غفل (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "せんてひっしょう": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "せんてをうつ": "تَوَقَّعَ, اِرْتَقَبَ",
 "せんてん": "ثَوْرَة, اِنْقِلَاب\nمثال: خضع زيد لدورة مكثفة / مُتَأَصِّل / نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي))",
 "せんてんいじょう": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "せんてんせい": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث)",
 "せんてんせいいじょう": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "せんてんてき": "فِطْرِيّ, وِلَادِيّ (مَوْجُودٌ بِشَكْلٍ طَبِيعِيٍّ مُنْذُ الوِلَادَةِ) / مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "せんてんてきしょうがい": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "せんてんびょう": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "せんでき": "غسل, غسيل (عمل التنظيف (عادة بالماء والصابون))",
 "せんでん": "علانية, عمومية (صفة كون الشيء مفتوحاً للأنظار العامة أو متاحاً للجمهور)\nمثال: علانية قاعة المحكمة",
 "せんでんいん": "مسؤول دعاية (شخص يقوم بالدعاية)",
 "せんでんがかり": "مسؤول دعاية (شخص يقوم بالدعاية)",
 "せんでんざいりょう": "إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة",
 "せんでんちらし": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "せんでんぶ": "إدارة الدعاية والإعلان, قسم الإعلانات (قسم في مؤسسة تجارية مسؤول عن الإعلانات)",
 "せんでんぶん": "تَقْرِيظ",
 "せんでんチラシ": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "せんでんビラ": "مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "せんと": "بِدُونِ, بِلَا / إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "せんといて": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "せんとう": "رامٍ أساسي ((في البيسبول) الرامي الذي يبدأ المباراة) / مَعْرَكَة / حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / مِقَصّ, مِقْرَاض / رَئِيس, رَئِيسَة / برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة…) / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك…)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "せんとういん": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة…)",
 "せんとうかん": "بارجة, سفينة حربية (سفينة حكومية متاحة لشن الحرب)",
 "せんとうき": "مُبَارِز, مُقَاتِل / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "せんとうぎせいしゃ": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية)",
 "せんとうしょうめんはば": "واجهة المبنى (وجه أو مقدمة مبنى)",
 "せんとうじゅつ": "نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك…)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "せんとうてき": "مُقَاتِل, مُحَارِب (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة…)",
 "せんとうにんむ": "مهمة قتالية (مهمة للاستيلاء على شيء أو الدفاع عنه)\nمثال: アメリカ軍はイラクでの戦闘任務を完了することを発表した。 — أعلنت القوات الأمريكية انتهاء مهمتها في العراق.",
 "せんとうふく": "زَيّ, زِي",
 "せんとうふのう": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "せんとうぶたい": "طَلِيعَة",
 "せんとうよういん": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة…)",
 "せんとうアーチ": "قوس مدبب (قوس بقمة مدببة؛ سمة من سمات العمارة القوطية)",
 "せんとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "せんど": "مُسْتَقْبَل / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس / تَفَرْطُح / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً / ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف / جودة ممتازة, دقة (جودة كون الشيء جيداً جداً بالفعل)\nمثال: يتميز النزل بدقة مأكولاته",
