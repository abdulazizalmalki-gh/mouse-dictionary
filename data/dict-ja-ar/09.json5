 "せめ": "حَمْلَة / هَاجَمَ / قِمَّة / قصف مركز, وابل (النار الكثيفة للمدفعية لإشباع منطقة بدلاً من ضرب هدف محدد) / تدفق, وابل (التدفق السريع والمستمر للتواصل اللغوي (المنطوق أو المكتوب))\nمثال: أطلقوا وابلاً من النيران أمام القوات المتقدمة / مَسْؤُولِيَّة / تَعْذِيب / عَذَاب / عَذَّبَ",
 "せめいる": "غَزَا, اِجْتاحَ",
 "せめおとす": "اِعْتِدَاء, حَمْلَة / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "せめぎあい": "صِرَاع, نِزَاع",
 "せめぎ合い": "صِرَاع, نِزَاع",
 "せめく": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "せめぐ": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع. / أداة تعذيب (أداة عقاب مصممة ومستخدمة لإلحاق التعذيب بالشخص المحكوم عليه)",
 "せめこむ": "غَزَا, اِجْتاحَ",
 "せめさいなむ": "تَعْذِيب / عَذَاب / عَذَّبَ",
 "せめたてる": "لَوْم, مَلَامَة / حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح.",
 "せめて": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / جنحة, مخالفة (تجاوز يشكل انتهاكاً لما يُحكم بأنه حق) / عملية هجومية, هجوم (عمل مهاجمة العدو) / إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / إهانة, استياء (شعور بالغضب ناتج عن التعرض للإهانة)\nمثال: لقد شعر بالاستياء من سؤالي",
 "せめても": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / أدنى, حد أدنى (أقل ما يمكن) / حد أدنى, نهاية صغرى (النقطة على المنحنى حيث يتغير المماس من سالب على اليسار إلى موجب على اليمين) / حد أدنى (أصغر كمية ممكنة)\nمثال: الحاجة لفرض معايير دنيا",
 "せめてもの": "أدنى, حد أدنى (أقل ما يمكن) / حد أدنى, نهاية صغرى (النقطة على المنحنى حيث يتغير المماس من سالب على اليسار إلى موجب على اليمين) / حد أدنى (أصغر كمية ممكنة)\nمثال: الحاجة لفرض معايير دنيا",
 "せめとる": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "せめる": "حَمْلَة / هَاجَمَ / تَحَدٍّ, التَّحَدِّي / لَوْم, مَلَامَة / حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح. / تَعْذِيب / عَذَاب / عَذَّبَ",
 "せもたれ": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "せもつ": "صَدَقَة, خَيْر",
 "せやかて": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "せやから": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "せやな": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "せゆう": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "せよ": "بِالرَغْم مِن / مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "せよという": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "せよと言う": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه) / أَلَحَّ\nمثال: أصر على الأفضل.",
 "せられる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "せり": "تَنَافَسَ, تَبَارَى / مَزَاد, مُزَايَدَة",
 "せりあい": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "せりあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "せりいし": "حجر العقد, صنجة (كتلة بناء حجرية إسفينية الشكل تستخدم في بناء القوس أو القبو)",
 "せりうり": "مَزَاد, مُزَايَدَة",
 "せりおとす": "زَايَدَ / صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "せりだい": "دعامة جسر (دعامة حجرية تلامس وتتلقى مباشرة دفع أو ضغط القوس أو الجسر) / دعامة, نقطة التماس (نقطة تلامس بين جسمين أو جزأين)",
 "せりだす": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "せりて": "مُزَايِد",
 "せりばいばい": "مَزَاد, مُزَايَدَة",
 "せりばんご": "عدد ترتيبي (الرقم الذي يعين المكان في تسلسل مرتب)",
 "せりもち": "قَوْس",
 "せりもと": "حجر الارتكاز (أدنى حجر في القوس الذي يبدأ منه القوس) / جمارك, مكوس (الأموال المحصلة بموجب التعريفة الجمركية)",
 "せり出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "せる": "تَنَافَسَ, تَبَارَى / عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "せろ": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "せろっぽう": "جوليان (حساء صافي مزين بخضروات مقطعة شرائح رفيعة (جوليان)) / جوليان, خضار مقطع شرائح (خضار مقطع إلى شرائح رفيعة)",
 "せろん": "رَأْي عَامّ",
 "せろんちょうさ": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "せわ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / مُشْكِلَة, مَتاعِب / تَوْصِيَة / حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "せわがかり": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "せわがない": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "せわしい": "مَشْغُول / غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "せわしない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "せわにん": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر. / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "せわのやける": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "せわやき": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "せわやく": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "せわをやく": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / أزْعَجَ / يَزْعَجْ, يُضَايِقْ",
 "せん": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / سحر, عبقرية (قدرة إبداعية استثنائية) / سَابِق / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ / لَخَّصَ, اِخْتَصَرَ / مُسْتَوًى / مَرْحَلَة / غُدَّة / سن (وحدة نقدية كسرية لليابان وإندونيسيا وكمبوديا؛ تساوي واحداً من المائة من الين أو الروبية أو الرييل) / جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي) / سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام) / مانع, ورقة حاكمة ((في البريدج) ورقة لعب ذات قيمة عالية تكفي لضمان الفوز بالجولة في نقش معين) / قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم / تَنَصَّتَ / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / مُبَارَاة / شَحّاطَة, شَخَّاطَة / تَجْمِيعَة, دِيوَان / ضعة, مكانة متدنية (موقف ذو مكانة أدنى؛ منخفض في المقام أو الرتبة أو الثروة أو التقدير) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم) / اِنْزَلَقَ / زَقِيطَة / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / غَسَّالَة (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا. / مَغْص, قُولَنْج / مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة) / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / تَأْثِير, أَثَر / سِيَام / سَجَّادَة, بِسَاط / طُوبَة, لَبِنَة / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة. / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "せんあえんこう": "بلند الزنك, سفاليريت (خام يعد المصدر الرئيسي للزنك؛ يتكون إلى حد كبير من كبريتيد الزنك البلوري)",
 "せんい": "لِيف / تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش. / تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل / رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها)",
 "せんいがさいぼう": "أرومة ليفية (خلية يتطور منها النسيج الضام)",
 "せんいがん": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "せんいき": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "せんいこうがく": "ألياف بصرية (نقل الإشارات الضوئية عبر ألياف زجاجية)",
 "せんいこうじょう": "مصنع نسيج (مصنع لصنع المنسوجات)",
 "せんいしゅ": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "せんいしょう": "تليف (تطور النسيج الضام الليفي الزائد في عضو ما)",
 "せんいじょう": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "せんいせい": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "せんいせんしゅ": "ورم غدي ليفي (ورم حميد ومتحرك وصلب وغير مؤلم في الثدي؛ شائع لدى الشابات ويسببه ارتفاع مستويات هرمون الاستروجين)",
 "せんいそ": "سِلْيُولُوز / فيبرين (بروتين ليفي أبيض غير قابل للذوبان يتكون بفعل الثرومبين على الفيبرينوجين عند تخثر الدم)",
 "せんいそく": "حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية)) / كراسة, ملزمة (جزء من عمل مطبوع)",
 "せんいそげん": "فيبرينوجين (بروتين موجود في بلازما الدم؛ يتحول إلى فيبرين عندما يتجلط الدم)",
 "せんいそしき": "نسيج ليفي (نسيج يتكون من أو يحتوي على ألياف في كل من الحيوانات والنباتات)",
 "せんいち": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده",
 "せんいつ": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده",
 "せんいばん": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في أوراق صلبة)",
 "せんいん": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "せんいガラス": "ألياف زجاجية (مادة تغطية مصنوعة من ألياف زجاجية في راتنجات)",
 "せんうん": "نذر الحرب (علامة مشؤومة تهدد بالحرب)",
 "せんえい": "جَذْريّ / رَادِيكَالِيّ / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "せんえいか": "تشديد, تكثيف (إجراء يجعل الشيء أقوى أو أكثر حدة) / تكثيف (عملية زيادة تباين (الفيلم الفوتوغرافي)) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "せんえいど": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها",
 "せんえき": "حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "せんえつ": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "せんえん": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / مِلْح, ملح / مَلَّحَ",
 "せんおう": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "せんおく": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "せんか": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / مادة اختيارية, مقرر اختياري (دورة يمكن للطالب اختيارها من بين البدائل) / هَادِيس / قِرْش, عُمْلَة / مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو إصلاحها)",
 "せんかい": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / تحول (فعل التغيير في الممارسة أو العادة) / انعطاف, دوران (عملية تغيير أو عكس اتجاه المسار) / خراطة (نشاط تشكيل شيء ما على المخرطة) / خراطة, مشغولات مخرطة (المنتج النهائي الذي تم إنشاؤه بتشكيل شيء ما على مخرطة)\nمثال: اتخذ القانون العديد من التحولات على مر السنين / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "せんかがく": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "せんかく": "رَائِد / كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "せんかくしゃ": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل) / رائٍ, مشاهد (مراقب يدرك بصرياً) / رائي, صاحب بصيرة (شخص لديه قوى غير عادية لاستشراف المستقبل)\nمثال: مشاهد مدمن للأفلام",
 "せんかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "せんかたない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "せんかん": "بارجة (سفينة حربية كبيرة ومدرعة بشدة) / صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء) / صندوق ذخيرة (صندوق لحفظ الذخيرة) / عربة ذخيرة (مركبة عسكرية بعجلتين تحمل ذخيرة المدفعية) / لوحة غائرة (لوحة غائرة زخرفية في سقف أو قبة) / غَرْغَرَ, بَقْبَقَ / غَوَّاصَة",
 "せんかんすいいき": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "せんかんびょう": "انسداد وعائي غازي, داء الغواص (ألم ناتج عن تغير سريع في الضغط الجوي)",
 "せんが": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "せんがい": "غير مختار (لم يتم اختياره) / خارجي (يقع بعيداً عن خط الوسط لسفينة أو طائرة) / محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير) / قارب بمحرك خارجي (قارب آلي بمحرك خارجي)\nمثال: القسم الخارجي من الجناح",
 "せんがいかさく": "تنويه شرفي, ذكر مشرف (اعتراف رسمي بالاستحقاق)\nمثال: على الرغم من أنه لم يفز بالجائزة، إلا أنه حصل على تنويه خاص",
 "せんがいき": "محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير)",
 "せんがいモーター": "محرك خارجي (محرك احتراق داخلي يركب في مؤخرة القارب الصغير)",
 "せんがふとい": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "せんがほそい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "せんがん": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "せんがんざい": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "せんがんやく": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "せんき": "راية المعركة (علم يقود القوات إلى المعركة) / إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة. / مَغْص, قُولَنْج",
 "せんきゃく": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "せんきゅうひゃくねんだい": "عقد 1900 (العقد من 1900 إلى 1909)",
 "せんきょ": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / اِنْتِخَاب, اِنْتِخَابَات / ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم / تَوْصِيَة",
 "せんきょう": "أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا)) / جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر.",
 "せんきょうし": "مُبَشِّر, مُنَصِّر",
 "せんきょうんどう": "حملة انتخابية (حملة المرشح ليتم انتخابه) / حملة, حملة سياسية (سباق بين المرشحين لمنصب منتخب)\nمثال: أدرت حملته لمنصب الحاكم",
 "せんきょがく": "علم الانتخابات (فرع علم الاجتماع الذي يدرس اتجاهات الانتخابات)",
 "せんきょく": "دائرة إدارية, قِسم (منطقة في مدينة أو بلدة محددة لأغراض إدارية)",
 "せんきょけん": "اقتراع, حق الانتخاب (حق قانوني يكفل التصويت في الانتخابات)\nمثال: حصلت النساء الأمريكيات على حق التصويت في عام 1920",
 "せんきょけんねんれい": "سن الانتخاب, سن التصويت (السن الذي يكون فيه الشخص كبيراً بما يكفي للتصويت في الانتخابات العامة)",
 "せんきょせいど": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "せんきょにん": "مُصَوِّت, نَاخِب",
 "せんきょにんだん": "مجمع انتخابي (هيئة الناخبين الذين ينتخبون رسمياً رئيس الولايات المتحدة ونائب الرئيس)",
 "せんきょび": "يوم الاقتراع, يوم الانتخابات (اليوم المحدد للانتخابات؛ في الولايات المتحدة هو أول ثلاثاء بعد أول اثنين في نوفمبر)",
 "せんきょぼたい": "الهيئة الناخبة, ناخبون (هيئة المواطنين الذين يحق لهم التصويت)",
 "せんきょみん": "مُصَوِّت, نَاخِب",
 "せんぎ": "مُبَادَرَة / مُنَاقَشَة, بَحْث / تَحْقِيق / بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんぎょ": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "せんぎょう": "اِخْتِصَاص, تَخَصُّص",
 "せんぎょうしゅふ": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんぎょうのうか": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "せんぎょうふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "せんぎょてん": "سَمَّاك, بَائِع سَمَك",
 "せんく": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / رَائِد, سَابِق (أي شيء يسبق شيئًا مشابهًا في الوقت)\nمثال: كان علم فراسة الدماغ سابقة لعلم الأعصاب الحديث / راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / خط حافلات (منظمة مسؤولة عن تشغيل نظام نقل بالحافلات) / مَسْرَح حَرْب",
 "せんくしゃ": "رَائِد",
 "せんくつ": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / تمشيط (التحرك عبر منطقة للبحث عن شيء ما)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء",
 "せんくてき": "رَائِد",
 "せんくん": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "せんぐ": "راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "せんぐん": "معركة بحرية (معركة ضارية بين أساطيل بحرية) / بَحْرِيَّة / كُحْلِيّ",
 "せんけい": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري / قِطَاع / زَوْرَقِيّ الشَّكْل (على شكل زَورق) / عظم زورقي (أكبر عظام الرسغ على جانب الإبهام) / لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة)",
 "せんけいかいき": "انحدار خطي (العلاقة بين المتغيرات عندما تكون معادلة الانحدار خطية)",
 "せんけいかんすう": "دَالَّة خَطِّيَّة (دالة رياضية يكون رسمها البياني (في الإحداثيات الديكارتية بمقاييس موحدة) خطاً مستوياً)",
 "せんけいけいかくほう": "برمجة خطية (تقنية رياضية تستخدم في الاقتصاد؛ تجد الحد الأقصى أو الأدنى للدوال الخطية في العديد من المتغيرات الخاضعة لقيود)",
 "せんけいさようそ": "مُؤَثِّر خَطِّيّ (مؤثر يطيع قانون التوزيع)",
 "せんけいじゅんじょ": "أسطوانة طويلة التشغيل (أسطوانة فونوغراف طويلة التشغيل؛ مصممة للتشغيل بسرعة 33.3 دورة في الدقيقة)",
 "せんけいせい": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
