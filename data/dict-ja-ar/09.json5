 "そでのした": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "そでをとおす": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "そと": "خَارِج, بره / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "そといわし": "سمكة العظم (سمكة بحرية فضية نحيلة توجد في المسطحات الطينية الاستوائية وبحيرات المانغروف)",
 "そとうば": "سْتُوبَا",
 "そとうみ": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "そとがき": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "そとがこい": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "そとがまえ": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي",
 "そとがわ": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي",
 "そとぎらい": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ) / مَيَّالٌ لِلِانْطِوَاء (يميل إلى الانطواء بعض الشيء) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)",
 "そとぐに": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "そとごはん": "نُزْهَة / مَهَمَّة سَهْلَة",
 "そとづけ": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "そとづら": "خَارِج, بره / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "そとで": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "そとなる": "خَارِجِيّ (يقع على السطح الخارجي للجسم أو باتجاهه) / خَارِجِيّ (يقع في الخارج ويتعلق بالواقع المادي)",
 "そとば": "سْتُوبَا",
 "そとばこ": "إطار (الإطار المحيط بفتحة باب أو نافذة) / غلاف الإطار (الغطاء الخارجي للإطار الهوائي) / غلاف, هيكل خارجي (المبيت أو الغطاء الخارجي لشيء ما)\nمثال: تعفنت الأطر وكان لا بد من استبدالها",
 "そとまわり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "そとみ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "そとめ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "そとわく": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "そどく": "حمى عضة الجرذ, سودوكو (شكل من أشكال حمى عضة الجرذ يحدث في الشرق الأقصى)",
 "そない": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هَٰكَذَا, كَذَا",
 "そなえ": "قُرْبَان / تَحْضِير, إِعْدَاد / دِفَاع, حِمَايَة / دِفاع / تشكيل عسكري (تشكيل من القوات)",
 "そなえつけ": "مُعَدَّات, تَجْهِيزَات",
 "そなえつける": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "そなえもの": "قُرْبَان",
 "そなえる": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "そなた": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そにどり": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "そにん": "خاطب, طالب الزواج (رجل يتودد لامرأة (بغرض الزواج))",
 "そに鳥": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "そねみ": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "そねむ": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "その": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان. / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "そのあしで": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "そのあたり": "في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "そのあと": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのいっぽう": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "そのう": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان.",
 "そのうえ": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "そのうえで": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "そのうち": "قَرِيبًا, سَرْعَانَ مَا",
 "そのうちに": "قَرِيبًا, سَرْعَانَ مَا",
 "そのおり": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのかみ": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "そのかわり": "بَدَلاً مِن",
 "そのくせ": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "そのけ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "そのこと": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "そのころ": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのご": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのじつ": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そのすじ": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / يَاكُوزَا",
 "そのた": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのたおおぜい": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "そのため": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "そのとき": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのなか": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そののち": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのはず": "طَبْعًا",
 "そのはんめん": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そのば": "هُنَاكَ / فوراً, في الحال (دون تأخير أو حالاً) / في الموقع, في عين المكان (في المكان المعني؛ هناك) / في مأزق, في موقف محرج (في موقف صعب)\nمثال: وظفناها في الحال",
 "そのばかぎり": "مُؤَقَّت",
 "そのばしのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "そのばのがれ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "そのひそのひ": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)\nمثال: その日その日で天気は変わる。 — يتغيّر الجوّ من يوم إلى آخر.",
 "そのぶん": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / بناءً على ذلك, نتيجة لذلك ((روابط الجمل) بسبب السبب المذكور) / وفقاً لذلك (بما يتوافق مع)\nمثال: نتيجة لذلك، لم يفعل ذلك",
 "そのへん": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "そのほう": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そのほか": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのほかに": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "そのまさかだ": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "そのまま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのまんま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのみち": "عَلَاقَة غَرَامِيَّة",
 "そのもと": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そのもの": "نَفْسُهُ, نَفْسُهَا",
 "そのよう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そのわりには": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "そのケ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "その一方": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "その上": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "その上で": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "その中": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "その事": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "その他": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "その他に": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "その他大勢": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "その代り": "بَدَلاً مِن",
 "その代わり": "بَدَلاً مِن",
 "その儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "その内": "قَرِيبًا, سَرْعَانَ مَا",
 "その内に": "قَرِيبًا, سَرْعَانَ مَا",
 "その分": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / بناءً على ذلك, نتيجة لذلك ((روابط الجمل) بسبب السبب المذكور) / وفقاً لذلك (بما يتوافق مع)\nمثال: نتيجة لذلك، لم يفعل ذلك",
 "その割には": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "その割りには": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "その半面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "その反面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "その場": "هُنَاكَ / فوراً, في الحال (دون تأخير أو حالاً) / في الموقع, في عين المكان (في المكان المعني؛ هناك) / في مأزق, في موقف محرج (في موقف صعب)\nمثال: وظفناها في الحال",
 "その場かぎり": "مُؤَقَّت",
 "その場しのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "その場のがれ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "その場凌ぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "その場逃れ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "その場限り": "مُؤَقَّت",
 "その外": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "その実": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "その後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "その折": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その折り": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その方": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "その日その日": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)\nمثال: その日その日で天気は変わる。 — يتغيّر الجوّ من يوم إلى آخر.",
 "その時": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "その気": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "その為": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "その物": "نَفْسُهُ, نَفْسُهَا",
 "その癖": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "その筈": "طَبْعًا",
 "その筋": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / يَاكُوزَا",
 "その足で": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "その辺": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "その辺り": "في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "その道": "عَلَاقَة غَرَامِيَّة",
 "その頃": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そはい": "صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "そば": "جَانِب / صَفْحَة / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "そばかす": "نَمَش",
 "そばから": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "そばきり": "سُوبَا",
 "そばだつ": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そばだてる": "سُلَالَة",
 "そばちかく": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "そばづかえ": "خادمَة",
 "そばにょうぼう": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "そばはら": "خَاصِرَة, كَشْح / جِنَاح / جَانِب",
 "そばみち": "طريق جانبي (طريق فرعي يتفرع من طريق رئيسي)",
 "そばむ": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "そばむぎ": "حِنْطَة سَوْدَاء",
 "そばめ": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "そば切り": "سُوبَا",
 "そば近く": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "そびえる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そびやかす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そびょう": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / لَخَّصَ, اِخْتَصَرَ",
 "そびら": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "そふ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そふぼ": "جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そぶ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そぶつ": "مَلَابِس, ثِيَاب",
 "そぶり": "سُلُوك, تَصَرُّف",
 "そへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "そほう": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そほん": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "そぼ": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "そぼう": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そぼく": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "そぼくじつざいろん": "واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها)",
 "そぼそぼ": "رَذَاذِيّ ((عن المَطَر) يَتَسَاقَطُ خَفِيفًا فِي قَطَرَاتٍ دَقِيقَةٍ جِدًّا)",
 "そぼふる": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "そぼろ": "مُحَطَّم, مُمَزَّق (خَرِبٌ أَوْ مُتَمَزِّق) / مُمَزَّق, مُهَلْهَل (بَالٍ حَتَّى صَارَ أَشْلَاءً؛ أَوْ يَرْتَدِي ثِيَابًا مُمَزَّقَةً) / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "そぼ降る": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "そまつ": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そまつにあつかう": "بَهْدَلَ",
 "そまつにする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "そまびと": "حَطَّاب",
 "そまむぎ": "حِنْطَة سَوْدَاء",
 "そまん": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)",
 "そむく": "عَصَى",
 "そめ": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "そめい": "تَفْسِير, شَرْح",
 "そめいだす": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめこ": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめこむ": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめし": "صَبَّاغ, صَبَّاغَة",
 "そめだす": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめつけ": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "そめつける": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめもの": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "そめものや": "صَبَّاغ, صَبَّاغَة",
 "そめる": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そも": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そもうし": "صوف ممشط, ورستد (قماش صوفي بسطح محكم صلب وبدون وبر؛ منسوج من خيوط صوفية ممشطة) / غزل صوفي ممشط (خيط صوفي مجدول بإحكام مغزول من الصوف طويل التيلة)\nمثال: ارتدى بدلة من الصوف الممشط",
 "そもじ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そもそも": "أساساً, في المقام الأول (ذو أهمية أولية) / أصلاً, في المقام الأول (قبل الآن)\nمثال: هذه مسألة اقتصادية في المقام الأول / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "そや": "رَيْفِيّ, قَرَوِيّ / سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "そやから": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そやす": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "そやつ": "هُوَ\nمثال: そいつをつかまえて！ — أمسكه!",
 "そゆ": "أَصْطَرَك, أَسْطَرَك",
 "そよう": "تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "そようちょう": "سُخْرَة (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر) / سُخْرَة, كُوج (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر)",
 "そよかぜ": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "そよぐ": "حَفِيف",
 "そよそよ": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "そよ風": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "そら": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / طَقْس, جَوّ / قَصِيّ, نَائٍ جِدًّا (بعيد جدّاً في المكان أو الزمان) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة) / يَعْنِي, أَي",
 "そらあい": "طَقْس, جَوّ",
 "そらいろ": "سَمَاوِيّ, أَسْمَانْجُونِيّ",
 "そらおそろしい": "مُتَوَتِّر",
 "そらおぼえ": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらきた": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "そらごと": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُزَيَّف",
 "そらす": "أَزْعَجَ / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "そらせる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "そらぞらしい": "زَائِف, بَاطِل / كَاذِب",
 "そらでおぼえる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらで覚える": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらとぶえんばん": "طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "そらなみだ": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "そらにことば": "شِبْه نَظِير",
 "そらね": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "そらねんぶつ": "خِطَابَة جَوْفَاء, كَلَام مُنَمَّق (كلام صاخب ومشوش وفارغ)\nمثال: مجرد خطاب منمق",
 "そらのげんかん": "مَطَار (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "そらのたび": "سفر جوي, طيران (السفر عبر الطائرات)\nمثال: السفر الجوي ينطوي على الكثير من الانتظار في المطارات",
 "そらのびん": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "そらびき": "مِنْسَج",
 "そらびきばた": "مِنْسَج",
 "そらまめ": "فُول, بَاقِلَّاء",
 "そらみみ": "صَمَم",
 "そらめ": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "そらもよう": "طَقْس, جَوّ\nمثال: 空模様から判断すると、雪が降りそうだ。 — يظهر من شكل السماء أن الثلج سيتساقط. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "そらをつかう": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "そらんじる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらんずる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そら恐ろしい": "مُتَوَتِّر",
 "そら来た": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "そら涙": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "そら覚え": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そら豆": "فُول, بَاقِلَّاء",
 "そり": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / منحنى / زلاجة (مركبة مثبتة على زحافات وتجرها الخيول أو الكلاب؛ للنقل فوق الثلج)",
 "そりあと": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "そりかえり": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "そりかえる": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "そりじたおん": "مُرْتَدّ",
 "そりすべり": "تقدم, سير الأمور (التقدم نحو هدف ما) / تزلج بالمزلاجة (رياضة ركوب الزلاجة)\nمثال: كان إقناعه أمراً سهلاً",
 "そりたつ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そりゃ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "そりゃあ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "そりゃく": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そりゃそうだ": "طَبْعًا",
 "そりゅう": "خَشِنُ الْحُبَيْبَاتِ (ليس ذا قوام ناعم؛ كبير الحبيبات) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "そりゅうし": "جُسَيْم أَوَّلِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "そりゅうしかそくき": "مُعَجِّل جُسَيْمَات",
 "そりゅうしのそうごさよう": "تفاعل, تفاعل أساسي ((في الفيزياء) نقل الطاقة بين الجسيمات الأولية أو بين جسيم أولي ومجال أو بين المجالات؛ يتوسطه بوزونات قياس)",
 "そりゅうしぶつりがく": "فيزياء الجسيمات (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "そりゅうど": "خَشِنُ الْحُبَيْبَاتِ (ليس ذا قوام ناعم؛ كبير الحبيبات) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "そり滑り": "تقدم, سير الأمور (التقدم نحو هدف ما) / تزلج بالمزلاجة (رياضة ركوب الزلاجة)\nمثال: كان إقناعه أمراً سهلاً",
 "そり立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そり舌音": "مُرْتَدّ",
 "そり跡": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "そる": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "それ": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: 万一それが起これば、君はどうしますか。 — إن حصل هذا لأي سبب، فماذا ستفعل؟ / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛ / هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "それいけ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それいじょう": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "それいらい": "مُنْذُ",
 "それが": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "それがし": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "それきた": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "それきり": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "それぎり": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "それこそ": "خُصُوصًا, خَاصَّةً / بِالتَّأْكِيد / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "それしき": "تافِه",
 "それしゃ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / غَيْشَا",
 "それじしん": "نَفْسُهُ, نَفْسُهَا",
 "それじたい": "لذاته وعينه",
 "それじゃ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それじゃあ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それそうおう": "مُنَاسِب / لَائِق",
 "それそれ": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "それぞれ": "كُلّ",
 "それだから": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それだけのかちがある": "جَدِير, مُسْتَحِقّ ((يُسْتَخْدَمُ أَحْيَانًا بِسُخْرِيَةٍ) جَدِيرٌ بِأَنْ يُعَامَلَ بِطَرِيقَةٍ مُعَيَّنَةٍ)",
 "それだけの価値がある": "جَدِير, مُسْتَحِقّ ((يُسْتَخْدَمُ أَحْيَانًا بِسُخْرِيَةٍ) جَدِيرٌ بِأَنْ يُعَامَلَ بِطَرِيقَةٍ مُعَيَّنَةٍ)",
 "それっきり": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "それっぽい": "هَٰكَذَا, كَذَا / واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "それで": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それでは": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それでも": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "それでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "それと": "أَيْضًا, كَذٰلِكَ",
 "それとて": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それとなく": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "それとなしに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "それとはなしに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "それとも": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "それとわかる": "مَحْسُوس, مَكْشُوف (يسهل رؤيته أو اكتشافه) / قَابِلٌ لِلْكَشْف, مُلَاحَظ (يُمْكِنُ كَشْفُهُ أَوِ اكْتِشَافُه)",
 "それと分かる": "مَحْسُوس, مَكْشُوف (يسهل رؤيته أو اكتشافه) / قَابِلٌ لِلْكَشْف, مُلَاحَظ (يُمْكِنُ كَشْفُهُ أَوِ اكْتِشَافُه)",
 "それどころか": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それな": "بِالضَّبْط, تَمَامًا / بِالْضَبْط",
 "それならそうと": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それならそれで": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それなり": "لذاته وعينه",
 "それなりに": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "それに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "それにしても": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "それにつけても": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それにひきかえて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それにもかかわらず": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それにも拘わらず": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それにも関わらず": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それに引き替えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それは": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "それはそうと": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそうとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそれとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそれは": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "そればかり": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それほど": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それまで": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それみたことか": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それもこれも": "كُلّ, جَمِيع",
 "それもそのはず": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "それゆえ": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それゆえに": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "それゆけ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それよか": "بَدَلاً مِن",
 "それよりも": "بَدَلاً مِن",
 "それら": "أُولَٰئِكَ, تِلْكَ",
 "それらしい": "هَٰكَذَا, كَذَا / واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "それる": "شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "それを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それ以上": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "それ以来": "مُنْذُ",
 "それ式": "تافِه",
 "それ故": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それ故に": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "それ来た": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "それ相応": "مُنَاسِب / لَائِق",
 "それ程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それ自体": "لذاته وعينه",
 "それ自身": "نَفْسُهُ, نَفْسُهَا",
 "それ行け": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それ見たことか": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それ見た事か": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それ迄": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "そろ": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "そろい": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "そろいぶみ": "تَشْكِيلَة",
 "そろい踏み": "تَشْكِيلَة",
 "そろう": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / مُبَارَاة / شَحّاطَة, شَخَّاطَة / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "そろえ": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "そろえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "そろそろ": "قَرِيبًا, سَرْعَانَ مَا / بِبُطْء / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "そろって": "كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: تم تجميعهم كلهم معاً",
 "そろっと": "قَرِيبًا, سَرْعَانَ مَا",
 "そろばん": "مِعَد, مِعْدَاد / نَاصِيَة (منبت شعر الغرّة الذي يقع فوق الجبهة مباشرة؛ عن شعر الغرّة) / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "そろばんがあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "そろばんが合う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "そろばんずく": "مُرْتَزِق, مُؤْجِر",
 "そろばんだかい": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "そろばんづく": "مُرْتَزِق, مُؤْجِر",
 "そろばん高い": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "そろり": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "そろりそろり": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "そろわない": "غَيْر كَافٍ, غَيْر مُلَائِم (لفتقار إلى الصفات أو الموارد اللازمة لتلبية مهمة ما) / غير متساوٍ, متفاوت (سيء التوازن أو التوافق في الكمية أو القيمة أو القياس)\nمثال: تدريب غير كافٍ",
 "そわか": "لَا فُضَّ فُوكَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "そわせる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "そわそわ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "そん": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / سَيِّئَة / قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ) / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين / حَفِيد, حَفِيدَة",
 "そんい": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "そんえい": "صُورَة / بُورْتْرِيَّة",
 "そんえき": "حساب الأرباح والخسائر (حساب يتم تجميعه في نهاية الفترة المحاسبية لإظهار الربح أو الخسارة الإجمالية والصافية)",
 "そんえきかんじょう": "حساب الأرباح والخسائر (حساب يتم تجميعه في نهاية الفترة المحاسبية لإظهار الربح أو الخسارة الإجمالية والصافية)",
 "そんかい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんかん": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "そんがい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがいばいしょう": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إرجاع الحالة, رد الحقوق (فعل إعادة شيء إلى حالته الأصلية) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "そんがいをあたえる": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがん": "مَلَامِح",
 "そんき": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة. / سَيِّئَة",
 "そんきょ": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "そんきん": "خسارة مالية (خسارة المال أو انخفاض في القيمة المالية)",
 "そんけい": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんけいしん": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんげん": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / متناقص (يصبح أقل أو أصغر) / متخافت (موسيقى) ((موسيقى) يتناقص في السرعة و/أو الحجم)",
 "そんこう": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "そんざい": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そんざいいぎ": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいかち": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいかん": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "そんざいしゃ": "إِن (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "そんざいりゆう": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいりょう": "كَثْرَة, غَزَارَة / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "そんざいろん": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "そんし": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "そんしつ": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "そんしつがく": "خسائر, خسائر المقامرة (شيء مفقود (خاصة المال المفقود في المقامرة))",
 "そんしゃ": "جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَهِيب, وَقُور (مثير للإعجاب والتبجيل بسبب عراقته وقِدَمه)",
 "そんしょう": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة. / قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そんしょく": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "そんしん": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "そんじ": "اِنْزَلَقَ",
 "そんじゃ": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そんじゃあ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そんじょそこら": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / شَائِع",
 "そんじる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "そんすう": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "そんする": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / ضَرَرٌ / ضَرَّ أَضَرَّ / وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى))\nمثال: وجد ياني هاتفه. / تَكَوَّنَ / تَأَلَّفَ (فعل مطاوعة من ألَّفَ؛ من كذا: تكّون من هذه الأجزاء، يستخدم للأجزاء الغير منفصلة والتي يكون مجموعها هو الشيء المتألف) / أَبْقَى / أَدَامَ / بَقَّى / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / رَعَى / صانَ\nمثال: حفظ رقم هاتفها.",
 "そんずる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "そんそ": "طَرَف / حَفْلَة, اِحْتِفَال",
 "そんぞく": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / استمرار, مدة (خاصية البقاء أو الاستمرار في الزمن) / استمرارية, فترة بقاء (الفترة الزمنية التي يستمر خلالها شيء ما) / مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / صَاعِد, مُتَصَاعِد (يَمِيلُ أَوْ يَتَّجِهُ نَحْوَ الأَعْلَى) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد)) / صعود, هيمنة (موقف أو حالة الهيمنة أو السيطرة)\nمثال: تلك الفكرة كانت في صعود",
 "そんぞくさつ": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "そんぞくさつじん": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "そんたい": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "そんたく": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة) / احترام, توقير (تعبير مهذب (بالقول أو الفعل) عن التقدير) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين) / احترام, توقير (مراعاة مهذبة لمشاعر الناس)\nمثال: كان توقيره لرغباتها ممتعاً للغاية",
 "そんだい": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / مُتَعَالٍ, الْمُتَعَالِي",
 "そんだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "そんち": "حَافَظَ",
 "そんちょう": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんで": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そんでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そんとくなし": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "そんな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そんななか": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そんなに": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そんなふうに": "هَٰكَذَا, كَذَا",
 "そんなもの": "هكذا الدنيا",
 "そんなもん": "هكذا الدنيا",
 "そんなわけで": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "そんな中": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そんな訳で": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "そんな風に": "هَٰكَذَا, كَذَا",
 "そんのうか": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "そんのうとう": "إِمْبَرِيَالِيّ / إِمْبَرِيَالِيّ, إِمْبِرْيالِيَّة",
 "そんばい": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إرجاع الحالة, رد الحقوق (فعل إعادة شيء إلى حالته الأصلية) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "そんぱい": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そんぴ": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "そんぼう": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そんぼうのきき": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "そんみん": "قَرَوِيّ, قَرَوِيَّة",
 "そんもう": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "そんもうじんいん": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "そんゆう": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そんらく": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そんりつ": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف ! / قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そーいう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そーっと": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة / بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "そーゆー": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そーれっ": "اندفاع, هفير (الضجيج الناتج عن الاندفاع المفاجئ لسائل (غاز أو سائل))",
 "そ求": "فِدَاء / خَلَاص",
 "そ知らぬ": "مُتَصَنَّع, مُصْطَنَع (غَيْر حَقِيقِيّ؛ مُفْتَعَل)",
 "そ首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "ぞい": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "ぞう": "فِيل, فيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل. / صُورَة / اِنْطِبَاع, سُمْعَة / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية / أحشاء, أمعاء (الأعضاء الداخلية مجتمعة (خاصة تلك الموجودة في تجويف البطن)) / مُفَتِّش, مُفَتِّشَة / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / التِّبِت, تُبَّت / مُتَفَرِّقات",
 "ぞうあく": "مُتَدَهْوِر, نَحْو الأَسْوَأ (يتغير للأسوأ) / إساءة, تدهور (تغيير شيء ما بحيث يصبح أسوأ) / تدهور, تردي (عملية التغير إلى حالة أدنى)\nمثال: قلق من العاصفة المتدهورة (تزداد سوءاً)",
 "ぞうあざらし": "فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه الخرطوم)",
 "ぞうえい": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "ぞうえいざい": "مادة تباين, وسط تباين (مادة معتمة للأشعة السينية؛ عند إعطائها تسمح لأخصائي الأشعة بفحص العضو أو الأنسجة التي تملؤها)",
 "ぞうえいぶつ": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "ぞうえき": "زائد, متزايد (أصبح أكبر في الحجم أو الكمية أو الدرجة)",
 "ぞうえん": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً / تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "ぞうお": "بُغْض, كَرَاهِيَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "ぞうおはんざい": "جَرِيمَة كَرَاهِيَّة",
 "ぞうか": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / زهرة اصطناعية (تقليد مصنوع يدوياً لزهرة) / خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "ぞうかぶん": "زيادة, علاوة (المقدار الذي يزداد به الشيء) / تصاعد, زيادة (عملية التحول إلى أكبر أو أطول أو أكثر عدداً أو أهمية)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "ぞうかりょう": "زيادة, علاوة (المقدار الذي يزداد به الشيء) / تصاعد, زيادة (عملية التحول إلى أكبر أو أطول أو أكثر عدداً أو أهمية)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "ぞうかん": "تحسيس (جعل كائن حي حساسًا لمصل عن طريق سلسلة من الحقن) / تحسيس, توعية ((في علم النفس) عملية أن يصبح الشخص حساساً للغاية تجاه أحداث أو مواقف معينة (خاصة الأحداث أو المواقف العاطفية)) / تحسس (حالة الحساسية (كما في المستضدات))",
 "ぞうがく": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ぞうがめ": "سلحفاة عملاقة (سلاحف كبيرة جداً من جزر غالاباغوس وسيشيل)",
 "ぞうがん": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها)",
 "ぞうき": "حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم)",
 "ぞうきいしょく": "زِرَاعَة اَلْأَعْضَاء",
 "ぞうきていきょうしゃ": "متبرع بالأعضاء (شخص يؤخذ منه عضو لزرعه)",
 "ぞうきばやし": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ぞうきゅう": "زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب)\nمثال: حصل على علاوة بنسبة 3٪",
 "ぞうきょう": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "ぞうきんかけ": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ぞうきんがけ": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "ぞうきんずり": "إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "ぞうけい": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة) / بلوغ, وصول (الوصول إلى مرحلة جديدة) / إدراك, تحقيق (عملية تحقيق هدف أو غاية) / إنجاز, اكتساب (قدرة تم اكتسابها عن طريق التدريب)\nمثال: تأخر بلوغه سن الرشد بسبب سوء التغذية",
 "ぞうけいふかい": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "ぞうけいぶかい": "أكاديمي, بحثي (من سمات العلماء أو البحث العلمي)\nمثال: أعمال بحثية",
 "ぞうけつ": "تكون الدم, تكون الكريات (تكوين خلايا الدم في الجسم الحي (خاصة في نخاع العظم))",
 "ぞうけつかんさいぼう": "خلية جذعية مكونة للدم (خلايا جذعية مكونة للدم في نخاع العظم؛ تنشأ منها الخلايا التائية والبائية)",
 "ぞうけつざい": "مكون للدم (متعلق بتكوين الدم أو خلايا الدم)\nمثال: خلايا جذعية مكونة للدم في نخاع العظم",
 "ぞうげ": "عَاج (مادة ثمينة تُصنع من أنياب الفيل، وتتواجد غالبًا في قارة إفريقيا، وبعض دول شرق آسيا؛ حاليًّا، يُمنع اصطياد الفيلة من أجل أنيابها في معظم الدول) / عَاجِيّ / عَاجِيَّة",
 "ぞうげかいがん": "كُوت دِيفْوَار, كُوت دِيڤْوَار",
 "ぞうげしつ": "عاج (عظم (نسيج متكلس) يحيط بتجويف لب السن) / دنتين, عاج الأسنان (مادة كلسية أصلب وأكثر كثافة من العظم تشكل الجزء الأكبر من السن)",
 "ぞうげのとう": "برج عاجي (حالة ذهنية تُناقش وكأنها مكان (منعزل عن الواقع))\nمثال: عاش في البرج العاجي للتأملات",
 "ぞうげやし": "نخيل العاج (نخلة عديمة الساق من البرازيل وبيرو تحمل مكسرات العاج)",
 "ぞうげん": "قَبَاحَة / تَذَبذُب, تَقَلُّب / ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "ぞうこ": "تاجر, صاحب متجر (تاجر ذكر يمتلك أو يدير متجراً)",
 "ぞうこくだか": "خَمَّرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "ぞうご": "اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً) / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة) / قَبَاحَة",
 "ぞうごしょう": "مُوَلَّدَة / تَوْلِيد",
 "ぞうごん": "قَبَاحَة",
 "ぞうさ": "مُشْكِلَة, مَتاعِب / كَرَم, إِكْرَام / ضِيَافَة",
 "ぞうさく": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء. / تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة) / لَائِق, مُنَاسِب (مطابق تماماً وصحيح) / مَعْقُول, مُلَائِم (يتناغم مع روح الأشخاص أو المناسبة المعنيّة) / تجهيزات, مستلزمات ((عادة بصيغة الجمع) المفروشات والمعدات (خاصة لسفينة أو فندق))",
 "ぞうさつ": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "ぞうさない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ぞうさなく": "بِسُهُولَة",
 "ぞうさもない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ぞうさもなく": "بِسُهُولَة",
 "ぞうざんうんどう": "تَكَوُّنُ الجِبَالِ",
 "ぞうしゅ": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / راعي; حامي; وصي; سيد; و / حريف; زبون",
 "ぞうしゅうわい": "رَشْوَة / رشوة",
 "ぞうしょ": "مَكْتَبَة, مكتبة",
 "ぞうしょいん": "إكس ليبريس, ملصق ملكية الكتاب (ملصق يحدد مالك الكتاب الذي تم لصقه فيه)",
 "ぞうしょう": "وزير المالية (الوزير المسؤول عن مالية الدولة)",
 "ぞうしょく": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ぞうしょくいんし": "عامل نمو (بروتين يشارك في تمايز الخلايا ونموها)",
 "ぞうしょくせい": "خَصِب, غَنِيّ (يَتَّسِمُ بِالخُصُوبَة الشَّدِيدَة وَالإِنْتَاجِيَّة العَالِيَة) / خصب, مثمر (ينتج أو قادر على الإنتاج (خاصة بغزارة)) / إنتاجي, توليدي (لديه القدرة على الإنتاج أو الابتكار) / مُثْمِر, مُنْتِج (يُسفِر عن نتائج إيجابية)\nمثال: أرض زراعية منتجة",
 "ぞうしょくろ": "مفاعل استيلاد (مفاعل نووي ينتج مواد انشطارية أكثر مما يستهلك)",
 "ぞうしょひょう": "إكس ليبريس, ملصق ملكية الكتاب (ملصق يحدد مالك الكتاب الذي تم لصقه فيه)",
 "ぞうしん": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "ぞうじ": "عَزْم / لَحْظَة, دَقِيقَة",
 "ぞうじてんぱい": "عَزْم / لَحْظَة, دَقِيقَة",
 "ぞうじょうまん": "ثقة مفرطة, يقين مطلق (اليقين التام أو اليقين الأكبر مما تبرره الظروف)",
 "ぞうすい": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته) / تَقْطِير, إِعْذَاب",
 "ぞうする": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "ぞうせい": "إِعْمَار, تَعْمِير / تَمَدُّد / تَوَسُّع",
 "ぞうせいき": "مئبرية, معفر (العضو الجنسي الذكري للنباتات المنتجة للأبواغ؛ ينتج الحيوانات المنوية النباتية؛ يعادل المئبر في الزهور)",
 "ぞうせつ": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / تصوّر, فكرة (فكرة مجردة أو عامة مستنتجة أو مشتقة من حالات محددة)",
 "ぞうせつりつ": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "ぞうせん": "بناء السفن (عملية بناء وصناعة السفن)",
 "ぞうせんか": "باني سفن (عمل تجاري يبني ويصلح السفن) / باني سفن (شخص يبني السفن كعمل تجاري) / بناء السفن, نجار سفن (نجار يساعد في بناء وإطلاق السفن الخشبية)",
 "ぞうせんぎょう": "صناعة بناء السفن (صناعة تقوم ببناء السفن)",
 "ぞうせんしょ": "ترسانة بحرية, حوض بناء السفن (مكان عمل يتم فيه بناء السفن أو إصلاحها)",
 "ぞうせんじょ": "ترسانة بحرية, حوض بناء السفن (مكان عمل يتم فيه بناء السفن أو إصلاحها)",
 "ぞうせんだい": "طريق سفن, قناة ملاحية (قناة كبيرة بما يكفي للسفن المبحرة في المحيطات) / مدرج السفن, منزلق السفن (هيكل يتكون من طريق منحدر لأسفل إلى الماء من المكان الذي يتم فيه بناء السفن أو إصلاحها)",
 "ぞうたい": "إخصاء, تعقيم الحيوانات (تعقيم الحيوان)\nمثال: أخذوه إلى الطبيب البيطري للإخصاء",
 "ぞうだい": "تَوْسِيع",
 "ぞうち": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "ぞうちょう": "متزايد, متنامٍ (يصبح أكبر أو أضخم) / متصاعد (موسيقى) ((موسيقى) يتزايد في السرعة و/أو الحجم)\nمثال: أسعار متزايدة / طائر الفيل (طائر ضخم (يصل إلى 9 أقدام) منقرض لا يطير من مدغشقر)",
 "ぞうちょうてんぐ": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "ぞうてい": "إِرَاءَة / إِهْدَاء, مَنْح",
 "ぞうていしゃ": "مُتَبَرِّع",
 "ぞうていひん": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "ぞうとうひん": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "ぞうとく": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "ぞうにん": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ぞうねんざい": "مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف",
 "ぞうは": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "ぞうはん": "ثَوْرَة, تَمَرُّد / حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "ぞうはんしゃ": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "ぞうひびょう": "داء الفيل (تضخم أجزاء معينة من الجسم (عادة الساقين وكيس الصفن)؛ المرحلة النهائية لمرض داء الفيلاريات)",
 "ぞうひょう": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة / صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "ぞうひん": "بَنْد",
 "ぞうび": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ぞうふ": "فَرَث",
 "ぞうふく": "تضخيم ((إلكترونيات) عملية زيادة الجهد أو الطاقة أو التيار) / تفصيل, توضيح (إضافة مواد إضافية أو توضيح أو تفاصيل شارحة) / تضخيم, كسب (مقدار الزيادة في طاقة الإشارة أو الجهد أو التيار معبراً عنه كنسبة المخرجات إلى المدخلات)\nمثال: بضع ملاحظات أضيفت كتوضيح ودفاع / تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع) / تَكْبِير (نسبة حجم الصورة إلى حجم الشيء)",
 "ぞうふくき": "مضخم إلكتروني",
 "ぞうぶつ": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "ぞうぶつしゅ": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "ぞうぶん": "زيادة, علاوة (المقدار الذي يزداد به الشيء) / تصاعد, زيادة (عملية التحول إلى أكبر أو أطول أو أكثر عدداً أو أهمية)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "ぞうへい": "اشتقاق جديد, كلمة مستحدثة (فعل اختراع كلمة أو عبارة جديدة) / كلمة مستحدثة, لفظ مولد (كلمة أو عبارة مخترعة حديثاً) / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة)",
 "ぞうへいきょく": "نَعْنَاع, نعناع",
 "ぞうへいしょう": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "ぞうほ": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "ぞうほう": "زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب)\nمثال: حصل على علاوة بنسبة 3٪",
 "ぞうほうたい": "طور بوغي, نابت بوغي (الفرد أو الطور المنتج للأبواغ في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "ぞうほかいてい": "إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى)",
 "ぞうほん": "تجليد",
 "ぞうむし": "سوسة (أي من عدة فصائل من الخنافس الصغيرة غالباً التي تتغذى على النباتات والمنتجات النباتية؛ وخاصة خنافس الخطم وخنافس البذور)",
 "ぞうもつ": "فَرَث",
 "ぞうよ": "تَبَرُّع, هِبَة",
 "ぞうよう": "عَمَلٌ رُوتِينِيّ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "ぞうよしゃ": "مُتَبَرِّع",
 "ぞうよしょうしょ": "شهادتي (مكون من أو متعلق بـ أو يشكل شهادة) / تقديري, تكريمي (معبر عن الإعجاب أو التقدير) / شهادة (شيء يخدم كدليل) / تزكية, توصية (شيء يوصي (أو يعبر عن الثناء على) شخص أو شيء على أنه جدير أو مرغوب فيه)\nمثال: عشاء تكريمي",
 "ぞうよぜい": "ضريبة الهدايا (ضريبة تفرض على نقل الممتلكات عن طريق الهبة خلال حياة الواهب)",
 "ぞうらんき": "أرشيجونة, عضو التأنيث (عضو جنسي أنثوي يوجد في الحزازيات والسراخس ومعظم عاريات البذور)",
 "ぞうり": "زوري (صندل يثبت في القدم بواسطة شريط فوق الأصابع)",
 "ぞうりつ": "إقامة, انتصاب (فعل البناء أو الرفع لأعلى)",
 "ぞうりゅう": "إقامة, انتصاب (فعل البناء أو الرفع لأعلى)",
 "ぞうりょうざい": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "ぞうりん": "تشجير (تحويل الأراضي الجرداء أو المزروعة إلى غابة (أصلاً لغرض الصيد))",
 "ぞうりんがく": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "ぞうわい": "رَشْوَة / رشوة",
 "ぞく": "شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً) / شَائِع / بَذِيء / قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة. / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / لِصّ, لِصَّة / مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس. / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تتمة, تكملة (شيء يتبع شيئاً آخر) / دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن) / ملَة, مل\nمثال: دخن زيري سيجارة.",
 "ぞくあく": "بَذِيء",
 "ぞくえん": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "ぞくおん": "سَائِد / سَائِد, شَائِع",
 "ぞくがい": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "ぞくがいこん": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "ぞくがく": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "ぞくがら": "عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "ぞくがん": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "ぞくき": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "ぞくぎ": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "ぞくぐ": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "ぞくけ": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "ぞくげん": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "ぞくご": "عَامِّيَّة, دَارِجَة",
 "ぞくざい": "كَفَّارَة",
 "ぞくし": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "ぞくしゅう": "عَادَة, عُرْف / ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "ぞくしゅうふんぷん": "بَذِيء",
 "ぞくしん": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "ぞくじん": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً) / شَخْصِيّ",
 "ぞくじんか": "تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)",
 "ぞくせい": "صِفَة, خُصُوصِيَّة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت) / نَسَبَ\nمثال: محاسبة النفس صفة حميدة. / محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة) / عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "ぞくせけん": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "ぞくせつ": "فُولْكْلُور, فُولْكُلُور",
 "ぞくぞく": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى) / مُتَقَلْقِل, مُرْتَعِد (يهتز بعنف أو بشكل تشنجي) / مُبْتَهِج, مُنْتَشٍ (يشعر بإثارة ممتعة شديدة) / بالدور, على التوالي (في ترتيب أو تسلسل مناسب)\nمثال: تحدث إلى كل طفل بدوره / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "ぞくち": "إِقْلِيمِيّ",
 "ぞくちょう": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى. / بَطْرِيَرْك, بَطْرَك / شَيْخ, بَطْرِيَرْك",
 "ぞくっぽい": "بَذِيء",
 "ぞくと": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "ぞくないこん": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون)",
 "ぞくなる": "بَذِيء",
 "ぞくに": "غالبا, عَادَةً",
 "ぞくにいう": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "ぞくねん": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "ぞくはい": "أرضي, من سكان الأرض (أحد سكان الأرض) / دُنْيَوِيّ (شخص مستغرق في هموم ومصالح وملذات العالم الحالي (الدنيا))",
 "ぞくはつ": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "ぞくぶつ": "مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "ぞくぶつこんじょう": "خيلاء اجتماعي, عجرفة (سمة التعالي على من هم في مكانة اجتماعية أدنى)",
 "ぞくぶつてき": "بُرْجُوَازِيّ, مَادِّيّ (يتوافق مع معايير وأعراف الطبقة الوسطى) / مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "ぞくへん": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تتمة, تكملة (شيء يتبع شيئاً آخر)",
 "ぞくほう": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / متابعة (نشاط يواصل شيئاً قد بدأ بالفعل أو يكرر شيئاً تم القيام به بالفعل) / عمل لاحق, متابعة (قطعة عمل تستغل أو تبني على عمل سابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "ぞくむき": "مَحْبُوب",
 "ぞくよう": "بَالَاد",
 "ぞくりゅう": "جُمْهُور, جَمَاهِير",
 "ぞくりゅうけっかく": "سل دخني (سل حاد يتميز بظهور درنات صغيرة جدًا على عضو واحد أو أكثر من الجسم (يُفترض أنه ناتج عن انتشار عصيات السل في مجرى الدم))",
 "ぞくりゅうねつ": "مرض التعرق (وباء انتشر في القرنين الخامس عشر والسادس عشر وتميز بالتعرق الغزير والوفيات المرتفعة)",
 "ぞくりょう": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / ابتذال (فعل جعل الشيء خشناً وغير مهذب)",
 "ぞくるい": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "ぞくろん": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "ぞくわ": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة / حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "ぞくラテンご": "اللاتينية العامية (لهجات لاتينية غير كلاسيكية كان يتم التحدث بها في الإمبراطورية الرومانية؛ مصدر اللغات الرومانسية)",
 "ぞっか": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / ابتذال (فعل جعل الشيء خشناً وغير مهذب) / أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "ぞっかい": "استئناف, عودة (البدء مرة أخرى)",
 "ぞっかく": "حَالَة اَلْمُضَاف إِلَيْهِ, مَجْرُور",
 "ぞっかん": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "ぞっき": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "ぞっきぼん": "بَقِيَّة",
 "ぞっきょく": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "ぞっき本": "بَقِيَّة",
 "ぞっけ": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "ぞっこう": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / إطالة, تمديد (نتيجة إطالة المدة) / الاستمرارية الجيدة, قانون الاستمرارية (مبدأ تنظيم غيشتالتي ينص على وجود ميل فطري لإدراك الخط كاستمرار لاتجاهه المحدد) / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تتمة, تكملة (شيء يتبع شيئاً آخر)",
 "ぞっこく": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "ぞっこん": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ / من القلب, من صميم القلب (بصدق شديد)\nمثال: تحدث من القلب",
 "ぞっと": "مُتَقَلْقِل, مُرْتَعِد (يهتز بعنف أو بشكل تشنجي)",
 "ぞめく": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "ぞろぞろ": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به / بَطِيءٌ مُجْهِد, مُتَثَاقِل (يتّسم بأسلوب بطيء ومُتعِب بشكل مؤلم)",
 "ぞろっぺい": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "ぞろめ": "دبلت, صدرية ضيقة (سترة رجالية ضيقة؛ كانت تلبس خلال عصر النهضة)",
 "ぞろやく": "دواء جنيس (نسخ من الأدوية يمكن عرضها للبيع بعد انتهاء حماية براءة الاختراع للدواء ذي العلامة التجارية بموافقة الجهات المختصة)\nمثال: الأدوية الجنيسة عادة ما تكون أرخص من الأدوية ذات العلامات التجارية",
 "ぞろ目": "دبلت, صدرية ضيقة (سترة رجالية ضيقة؛ كانت تلبس خلال عصر النهضة)",
 "ぞろ薬": "دواء جنيس (نسخ من الأدوية يمكن عرضها للبيع بعد انتهاء حماية براءة الاختراع للدواء ذي العلامة التجارية بموافقة الجهات المختصة)\nمثال: الأدوية الجنيسة عادة ما تكون أرخص من الأدوية ذات العلامات التجارية",
 "ぞわぞわ": "بشكل غير مريح (بانزعاج جسدي)\nمثال: استلقت على الأريكة وجسمها ملتوي بشكل غير مريح",
 "ぞわり": "بشكل غير مريح (بانزعاج جسدي)\nمثال: استلقت على الأريكة وجسمها ملتوي بشكل غير مريح",
 "ぞんい": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "ぞんがい": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "ぞんざい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "ぞんじ": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد)",
 "ぞんじあげる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "ぞんじる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "ぞんずる": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "ぞんち": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد)",
 "ぞんねん": "رَأْي, نَظَر",
 "ぞんぶん": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "ぞんぶんに": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "た": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر. / جَاهِز, نَاضِج (مَطْهُوٌّ حَتَّى أَصْبَحَ جَاهِزًا لِلتَّقْدِيم) / فَارِغ, مُنْتَهٍ (أَنْهَى المَهَمَّةَ أَوْ بَلَغَ مَرْحَلَةَ الِاكْتِمَالِ) / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي.",
 "たあ": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي.",
 "たあい": "إِيثَار, غَيْرِيَّة",
 "たあいない": "سَخِيف",
 "たあいのない": "سَخِيف",
 "たあいもない": "سَخِيف",
 "たあけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "たい": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / فِي مُقَابِل, ضِِدَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى اَلْعَكْس, ضِِدَّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي. / أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟ / ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر. / فِرْقَة, فرقة / فِرْقَة / أسبور, دنيس / سمك الدنيس (لحم أي نوع من أسماك المياه المالحة المختلفة من فصيلة الأسبورية أو فصيلة البراميداي) / طَرَف / حَفْلَة, اِحْتِفَال / سَرِيَّة / شَرِكَة / تَايْلَانْد, تَايْلَنْد (دولة تقع في جنوب شرق آسيا، تحدها ميانمار ولاوس وكمبوديا وماليزيا)\nمثال: بانكوك هي عاصمة تايلاند. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه. / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان. / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف. / كَوْم / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "たいい": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / وَضْعِيَّة / تنازل عن العرش (فعل التنازل عن العرش) / تنازل عن العرش, تنحي (استقالة رسمية وتنازل عن السلطات) / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار. / مُلَخَّص / إِرَاءَة / إِهْدَاء, مَنْح",
 "たいいき": "فِرْقَة, فرقة / فِرْقَة / عرض النطاق الترددي (معدل نقل البيانات؛ أقصى قدر من المعلومات (بايت/ثانية) يمكن نقلها عبر قناة)",
 "たいいきてき": "عَالَمِيّ",
 "たいいきはば": "عرض النطاق الترددي (معدل نقل البيانات؛ أقصى قدر من المعلومات (بايت/ثانية) يمكن نقلها عبر قناة)",
 "たいいく": "تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "たいいくか": "رِيَاضِيّ, رِيَاضِيَّة",
 "たいいくかん": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "たいいくさい": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق) / يوم حافل, يوم ممتع (وقت من المتعة والنجاح غير المعتاد) / يوم رياضي (يوم للمنافسات الرياضية الخارجية) / يوم مناورات ((عسكرية) يوم للتدريبات والعروض العسكرية)",
 "たいいほう": "طباق, كونتربوينت (شكل موسيقي يتضمن الصوت المتزامن للحنين أو أكثر)",
 "たいいん": "قُوَّات, عَسْكَرِيَّة / قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / تَقَاعُد",
 "たいいんげつ": "شهر قمري (الفترة بين قمرين جديدين متتاليين (29.531 يوماً))\nمثال: 太陰月はカレンダーのひと月より短い。 — الشهر القمري أقصر من الشهر الشمسي.",
 "たいいんたいようれき": "تقويم قمري شمسي (تقويم يعتمد على كل من الدورات القمرية والشمسية)",
 "たいいんれき": "تقويم قمري شمسي (تقويم يعتمد على كل من الدورات القمرية والشمسية)",
 "たいう": "وَابِل, مَطَر غَزِير",
 "たいえい": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "たいえいしゅぎ": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "たいえいてき": "مُحَافِظ",
 "たいえき": "سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / مَنِيّ",
 "たいえきぐんじん": "جندي سابق, محارب قديم (شخص ذكر خدم في القوات المسلحة)",
 "たいえんせい": "مُقَاوِم لِلَّهَب (مقاوم لالتقاط النار)",
 "たいおう": "مُرَاسَلَة / مُلَاءَمَة, مُنَاسَبَة (صفة امتلاك الخصائص الصحيحة لغرض معين)\nمثال: مطلب مهم هو الملاءمة للرحلات الطويلة / تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء / انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "たいおうこうどう": "سُلُوك, تَصَرُّف",
 "たいおうさく": "إجراء مضاد (إجراء يُتخذ لتعويض أو مواجهة إجراء آخر)",
 "たいおうしゃ": "مجيب (شخص يستجيب) / نَظِير",
 "たいおうしょく": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "たいおうづける": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "たいおうふか": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "たいおん": "درجة حرارة الجسم (درجة حرارة الجسم؛ عادة 37 درجة مئوية في البشر)\nمثال: 看護婦が彼の体温を計った。 — قاست الممرضة حرارته.",
 "たいおんき": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "たいおんけい": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "たいか": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار) / انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط) / انحطاط, تدهور (عملية التراجع من مستوى أعلى إلى مستوى أدنى من القوة الفعالة أو الحيوية أو الجودة الأساسية) / انحلال, تدهور (حالة كونه منحطاً في الصفات العقلية أو الأخلاقية) / ارتداد, تراجع (العودة إلى حالة سابقة) / انحدار, انحدار إحصائي / نكوص ((في الطب النفسي) آلية دفاع تهرب فيها من الواقع عن طريق افتراض حالة أكثر طفولية) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة) / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / حُوَيْصِلَة",
 "たいかい": "اِنْسِحَاب / تَجَمُّع جَمَاهِيرِيّ, مَهْرَجَان خِطَابِيّ (تجمع كبير من الناس يهدف إلى إثارة الحماس) / بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة) / مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "たいかいいってき": "غيض من فيض, نقطة في بحر (جهد أو فعل له تأثير ضئيل جداً بشكل عام، خاصة بالمقارنة مع مشكلة ضخمة)\nمثال: إن التبرع بمبلغ 100 دولار من فرد هو أمر كريم، لكنه نقطة في بحر مقارنة بهدف جمع التبرعات البالغ 500,000 دولار",
 "たいかく": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / حالة النصب (حالة الأسماء التي تعمل كمفعول به مباشر للفعل) / مَائِل, قُطْرِيّ / خزانة, دولاب (قطعة أثاث تشبه الخزانة ذات أبواب وأرفف وأدراج؛ للتخزين أو العرض) / خزانة الجهاز, كونسول (مبيت للأدوات الإلكترونية، مثل الراديو أو التلفزيون) / خزانة, دولاب (مقصورة تخزين للملابس والأشياء الثمينة؛ عادة ما يكون لها قفل) / حكومة, مجلس الوزراء (أشخاص يعينهم رئيس الدولة لرئاسة الإدارات التنفيذية للحكومة والعمل كمستشارين رسميين)",
 "たいかくか": "تحويل قطري, قطرنة (تغيير مصفوفة مربعة إلى شكل قطري (مع وجود جميع العناصر غير الصفرية على القطر الرئيسي))",
 "たいかくぎょうれつ": "مَصْفُوْفَة قُطْرِيَّة",
 "たいかくけんさ": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "たいかくせん": "مَائِل, قُطْرِيّ",
 "たいかけんちくぶつ": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "たいかじすう": "بطلان, حكم بالبطلان (شيء باطل (خاصة تشريع ليس له شرعية قانونية)) / عدم, لاشيء (حالة عدم الوجود)",
 "たいかぶつ": "جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد) / عَصِيّ, مُمْتَنِع (غير مستجيب مؤقتاً أو غير مستجيب بالكامل لعملية أو محفّز) / عَصِيّ, مُسْتَعْصٍ (لا يستجيب للعلاج) / بطانة الفرن, مادة حرارية (بطانة تتكون من مادة ذات نقطة انصهار عالية؛ تستخدم لتبطين الجدران الداخلية للفرن)",
 "たいかれんが": "طوب حراري (طوب مصنوع من الطين الناري؛ يستخدم لتبطين الأفران والمداخن)",
 "たいかん": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / مَخَاض / مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين. / عَالِيّ الرُتْبَة / جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟ / تَتْوِيج / خَصِيّ, مَخْصِيّ / ذهاب, رحيل (فعل المغادرة)",
 "たいかんしき": "تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "たいが": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات) / جَنِين / بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "たいがい": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية. / عُمُومًا / بِوَجْهٍ عَامّ / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / لُبّ / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "たいがいえんじょ": "معونة خارجية (مساعدة (مثل المساعدة الاقتصادية أو العسكرية) تقدمها دولة لأخرى)",
 "たいがいかんけい": "عَلَاقَات دَوْلِيَّة",
 "たいがいせいさく": "سياسة خارجية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "たいがいてき": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "たいがいりだつ": "تجربة الخروج من الجسد (التجربة الانفصالية لمراقبة الذات من منظور خارجي كما لو أن العقل أو الروح قد غادر الجسد ويقوم بمراقبته)",
 "たいがく": "إِقَالَة",
 "たいがくしょぶん": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "たいがん": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / مَطْمَح",
 "たいき": "حَجْر صِحِّيّ, عَزْل (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر. / جَو, غِلَاف جَوِّيّ / جَو / سَمْح, كَرِيم النَّفْس (سخي ومتفهم ومتسامح) / شَهْم, كَرِيم النَّفْس (نبيل وكريم في الروح والطبع)",
 "たいきあつ": "ضغط جوي",
 "たいきおせん": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "たいきおん": "صوت مهموس, هاء (صامت يُنطق مع نَفَس مسموع) / تفخيم, صوت مصحوب بنفخ (صوت كلامي يرافقه نفخة مسموعة من النفس، مثل الصوامت الوقفية الأولية)",
 "たいきけん": "جَو, غِلَاف جَوِّيّ / جَو",
 "たいきけんがい": "فَضَاء خَارِجِيّ (فَضَاء)\nمثال: الفضاء مليئ بالغموض.",
 "たいきしつ": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "たいきそくど": "سُرْعَة جَوِّيَّة (سرعة الطائرة بالنسبة للهواء الذي تطير فيه)",
 "たいきてき": "انتخابي, منتخب (خاضع لانتخاب شعبي) / اخْتِيَارِيّ (غير إجباري؛ يُمكن اختياره بحرّية) / مادة اختيارية, مقرر اختياري (دورة يمكن للطالب اختيارها من بين البدائل)\nمثال: مسؤول منتخب",
 "たいきべや": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "たいきゃく": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "たいきゅう": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء / دَايْغُو",
 "たいきゅうざい": "سلع استهلاكية معمرة, سلع معمرة (سلع استهلاكية لا تتلف أو تُستهلك بمجرد الاستخدام)",
 "たいきゅうせい": "مَتَانَة",
 "たいきゅうりょく": "مَتَانَة",
 "たいきょ": "رَحِيل, مُغَادَرَة / تَرَاجُع / وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير) / سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "たいきょう": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "たいきょきょうせい": "طَرْد",
 "たいきょく": "لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / الأنتيبود, نقطة مقابلة (أي مكانين أو منطقتين على جانبين متقابلين تماماً من الأرض)\nمثال: القطب الشمالي والقطب الجنوبي متقابلان / ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "たいきょくけん": "تاي تشي (نظام صيني للتمارين البدنية التأملية البطيئة المصممة للاسترخاء والتوازن والصحة)",
 "たいきょくしゃ": "لَاعِب / مَشْغَل, جِهَاز / مَشْغَل / مُقَامِر",
 "たいきょくず": "يِين وَيَانْغ",
 "たいきょくてき": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / صَرِيح, فَجّ (يفتقر إلى الدقّة والخفاء؛ واضح وسافر) / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / عَرِيض, غَيْر مُفَصَّل (غير مفصل أو دقيق؛ يتناول الخطوط العامة فقط)",
 "たいきょくどけい": "ساعة الشطرنج (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "たいきん": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "たいぎ": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن. / عَدْل, إِنْصَاف (عَدْل) / عَدْل, عَدَالَة (عَدْل) / عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / شَاقّ, مُضْنٍ (يتّسم بجهد يصل إلى حدّ الإنهاك؛ خاصة الجهد البدني)",
 "たいぎご": "عَكْس / نَقِيض",
 "たいぎそうに": "بإعياء, بتعب (بطريقة متعبة)\nمثال: مشى بتعب",
 "たいぎめいぶん": "ذَرِيعَة, عُذْر / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "たいぎゃく": "خِيَانَة عُظْمَى",
 "たいぎゃくざい": "خِيَانَة عُظْمَى",
 "たいぎゃくひどう": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "たいぎゃくむどう": "شَنِيع, فَاحِش (بَالِغُ الشَّرِّ؛ إِجْرَامِيٌّ فِي أَعْمَاقِه)",
 "たいぎょう": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "たいぎょうせんじゅつ": "تَبَاطُؤ فِي العَمَل (شكل من أشكال الاحتجاج العمالي يتباطأ فيه العمال عمداً للتسبب في مشاكل لأصحاب العمل)",
 "たいく": "تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "たいくう": "جوف, سيلوم (تجويف في الأديم المتوسط للجنين يؤدي في البشر إلى التجويف الجنبي وتجويف التامور والتجويف البريتوني) / مُضَادّ لِلطَّائِرَات (مصمَّم للدفاع من موقع أرضيّ ضدّ الهجمات الجوّيّة) / مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات)",
 "たいくうほうか": "مدفع مضاد للطائرات (مدفعية مصممة لإطلاق النار لأعلى باتجاه الطائرات) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / مروج إعلامي, مسؤول علاقات عامة (متحدث بارع يمكنه تحويل أي انتقاد لصالح صاحب العمل)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "たいくかん": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "たいくっきょく": "مُرُونة",
 "たいくつ": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "たいくん": "عَاهِل / شُوغُون",
 "たいぐう": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / رَاتِب, أَجْر",
 "たいけい": "عُقُوبَةٌ بَدَنِيَّة / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية / نمط الجسم (فئة من البنية الجسدية) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / لَخَّصَ, اِخْتَصَرَ / اَلْأَخ اَلْأَكْبَر / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "たいけいか": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق)",
 "たいけいがく": "علم التصنيف (علم التصنيف المنهجي)",
 "たいけいせいせい": "كشمي (من أو متعلق بالكشم (فقدان التمايز الخلوي))",
 "たいけいだった": "منظم, مهيكل (لديه هيكل محدد ومنظم للغاية) / مُتَكَامِل, مُهَيْكَل (يُشبه الكائن الحي في التنظيم أو التطور)\nمثال: بيئة منظمة",
 "たいけいてき": "مُمَنْهَج",
 "たいけつ": "مُوَاجَهَة, مُجَابَهَة",
 "たいけん": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / دائرة عظمى (خط دائري على سطح الكرة يتشكل بتقاطعها مع مستوى يمر عبر المركز) / سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف. / حَكَم, فيصل (شخص لديه السلطة لتسوية الأمور حسب إرادته)\nمثال: كانت هي الحكم النهائي في جميع مسائل الموضة",
 "たいけんがくしゅう": "تَطْبِيقِيّ, مُبَاشِر (ينطوي على مشاركة فعليّة ومباشرة)",
 "たいけんしゃ": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "たいけんだん": "سَرْدِي / قِصَّة, حِكَايَة / سَرْدِيَّة, رِوَايَة",
 "たいげ": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "たいげん": "تَجْسِيد / عجرفة, غطرسة (تفاخر فارغ ومغرور) / تاي يونا, تاييونا",
 "たいげんしゃ": "تَجَسَّد",
 "たいげんそうご": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "たいこ": "طَبْل (الضَرْب على الطَبْل؛ آلة موسيقية تشبه الإسطوانة المغطاة فتحتها بالجلد تستخدم بأن يضرب وجهها إما باليد أو بعصا) / طَبْلَة / صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "たいこう": "جوف, سيلوم (تجويف في الأديم المتوسط للجنين يؤدي في البشر إلى التجويف الجنبي وتجويف التامور والتجويف البريتوني) / مُقَابِلٌ, مُنَاظِرٌ (مُصَاحِب ومُلازم) / مُطَابِق, مُمَاثِل (مُتَوافِق من كلّ وجه) / مُنَاظِر, مُوَازٍ (متشابه خاصّة في الموقع أو الوظيفة) / مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / أَرْشِيدُوق / وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية. / أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات / لَخَّصَ, اِخْتَصَرَ / ارتداد, تراجع (العودة إلى حالة سابقة) / انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط) / إِقَالَة / إِمْبِرَاطُورَة الأُمّ / اِرْتِفَاع",
 "たいこういしき": "تَنَافُس, مُنَافَسَة (فعل التنافس من أجل الربح أو الجائزة)\nمثال: كانت الفرق في تنافس شرس على المركز الأول",
 "たいこうこく": "غْرَانْدُوقِيَّة",
 "たいこうさく": "إجراء مضاد (إجراء يُتخذ لتعويض أو مواجهة إجراء آخر)",
 "たいこうしょく": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية. / أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "たいこうしょぶん": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "たいこうじあい": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "たいこうせい": "تَنَكُّسِيّ ((عن المرض) يتّسم بتدهور تدريجيّ في الأعضاء والخلايا مع فقدان الوظيفة)",
 "たいこうせつ": "بزوغ, قدوم (وصول كان منتظراً (خاصة لشيء مهم)) / مجيء (الموسم الذي يتضمن أيام الأحد الأربعة التي تسبق عيد الميلاد)\nمثال: قدوم الحاسوب",
 "たいこうせん": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "たいこうそち": "إجراء مضاد (إجراء يُتخذ لتعويض أو مواجهة إجراء آخر)",
 "たいこうば": "مُنَافِس",
 "たいこうぶんか": "ثقافة مضادة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "たいこうぼう": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / صياد بالسنارة (صياد يستخدم الخطاف والخيط) / صياد الفرص, مخادع (شخص متآمر؛ شخص يخطط للحصول على ميزة)",
 "たいこうるい": "فكيات الأرجل (تستخدم في بعض التصنيفات؛ تشمل رتب سيفيات الذيل وعقارب البحر)",
 "たいこく": "قُوَّة عُظْمَى (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "たいこばら": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "たいこばん": "خاتم الموافقة, ختم (مؤشر على الحالة المعتمدة أو المتفوقة)",
 "たいこびょう": "دبوس رسم, دبوس ضغط (دبوس لتثبيت الأوراق على لوحة إعلانات أو لوحة رسم)",
 "たいこもち": "كُومِيدْيَان / مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "たいご": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / عَكْس / نَقِيض / مُحَادَثَة / مُكَالَمَة / حِوَار / مُذَاكَرَة / مُحَاوَرَة / تَكَلُّم (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / تَنْوِير / تَايْوَانِيّ",
 "たいごう": "اقتران, تشابك (الاقتران جنباً إلى جنب للكروموسومات المتماثلة للأم والأب في بداية الانقسام المنصف) / التفاف, انطواء (عملية لف شيء ما) / أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة) / اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "たいごく": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "たいさ": "عَقِيد, زَعِيم",
 "たいさい": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز. / كُرُنْب صِينِيّ, بُوك تْشُوي",
 "たいさいぼう": "خلية إنباتية, خلية جسدية (أي من خلايا النبات أو الحيوان باستثناء الخلايا التناسلية؛ خلية لا تشارك في إنتاج الأمشاج)\nمثال: تنتج الخلايا الجسدية من خلايا موجودة مسبقاً",
 "たいさく": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير) / تُحْفَة, رَائِعَة",
 "たいさくほんぶ": "فريق عمل عسكري, قوة واجب (وحدة عسكرية مؤقتة تُشكل لتحقيق هدف معين) / فريق عمل, مجموعة عمل (وحدة شبه دائمة تم إنشاؤها لتنفيذ مهمة مستمرة)",
 "たいさくチーム": "فريق عمل عسكري, قوة واجب (وحدة عسكرية مؤقتة تُشكل لتحقيق هدف معين) / فريق عمل, مجموعة عمل (وحدة شبه دائمة تم إنشاؤها لتنفيذ مهمة مستمرة)",
 "たいさん": "تشتت, نثر (عملية تشتيت أو نشر شيء ما)\nمثال: تشتت القوات / فرار, هروب (فعل المغادرة (بدون إذن) للمكان الذي من المتوقع أن تكون فيه)",
 "たいさんぼく": "ماغنوليا جنوبية, ماغنوليا كبيرة الأزهار (شجرة دائمة الخضرة في جنوب الولايات المتحدة ذات أوراق لامعة صلبة كبيرة وزهور بيضاء ضخمة حلوة الرائحة)",
 "たいざ": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "たいざい": "مَكَثَ, بَقِيَ / إِقَامَة / خطيئة مميتة, كبيرة من الكبائر (خطيئة لا تغتفر تستوجب فقدان النعمة الإلهية تماماً)\nمثال: يدرج اللاهوتيون سبع خطايا مميتة",
 "たいざいきゃく": "ضَيْف, زَائِر / زَبُون",
 "たいざんほくと": "عَلَم, نجم لامع (مشهور يمثل إلهاماً للآخرين)\nمثال: استضاف تجمعاً كبيراً من النجوم اللامعة",
 "たいし": "سَفِير, سَفِيرَة (السَّفير: ما سقط من ورق الشجر وتَحَاتَّ)\nمثال: طموحها هو أن تصبح سفيرة. / مَطْمَح / وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / طلاء دهني, فيرنيكس كازيوزا (مادة وقائية بيضاء تشبه الجبن تغطي جلد الجنين)",
 "たいしかん": "سِفَارَة (سَفَارَة = سِفَارَة)\nمثال: أين السفارة اليابانية؟",
 "たいした": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "たいしたことではない": "تافِه",
 "たいしたことない": "تافِه",
 "たいしつ": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "たいしつかいぜん": "إِصْلَاح",
 "たいしつてき": "بُنْيَوِيّ / دُسْتُورِيّ",
 "たいして": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "たいしゃ": "اِسْتِقَالَة, اِسْتِعْفَاء / أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ) / تَمْثِيل غِذَائِيّ / اِسْتِقْلَاب (يُشير مُعجم مُفردات كلمة \"قلَب\" إلى معانٍ متعددة تدور حول فكرة التغيير و التحويل، سواءً كان ذلك بتغيير مكان شيء ما (كإفراغ قدر أو عكس شيء)…؛ يُشير الفعل \"قلب\" إلى معانٍ تتراوح بين الحركة المادية لعكس اتجاه أو وضع شيء ما (كقلب كأس أو صفحة)…) / تَجْدِيد / عَفْو / أماكن معيشة, مساكن (سكن متاح للناس للعيش فيه)\nمثال: وجد مسكناً لعائلته",
 "たいしゃいじょう": "اضطراب استقلابي, اضطراب الأيض (اضطراب أو خلل في التمثيل الغذائي)",
 "たいしゃく": "قَرْض, إِعَارَة",
 "たいしゃくたいしょうひょう": "الميزانية العمومية (سجل للوضع المالي لمؤسسة ما في تاريخ معين من خلال سرد أصولها والمطالبات المترتبة على تلك الأصول)",
 "たいしゃさんぶつ": "مستقلب, ناتج أيضي (أي مادة تشارك في عملية التمثيل الغذائي (سواء كمنتج للأيض أو ضرورية له))",
 "たいしゃしょうこうぐん": "مُتَلَازِمَة الأَيْض, المُتَلَازِمَة الاِسْتِقْلَابِيَّة",
 "たいしゃせき": "حجر تعليم أحمر, مغرة حمراء (خام حديد أحمر يستخدم في الصباغة ووضع العلامات)",
 "たいしゃぶっしつ": "مستقلب, ناتج أيضي (أي مادة تشارك في عملية التمثيل الغذائي (سواء كمنتج للأيض أو ضرورية له))",
 "たいしゃぶつ": "مستقلب, ناتج أيضي (أي مادة تشارك في عملية التمثيل الغذائي (سواء كمنتج للأيض أو ضرورية له))",
 "たいしゅ": "نَائِب / خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / خمر مقطر, مشروب روحي (مشروب كحولي يتم تقطيره بدلاً من تخميره)",
 "たいしゅう": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام) / عَامَّة اَلنَّاس / قَارَّة",
 "たいしゅうおんがく": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "たいしゅうか": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / تبسيط, تعميم (تفسير يسهل فهمه وقبوله)",
 "たいしゅうかい": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "たいしゅうしゃ": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "たいしゅうしゅぎ": "شَعْبَوِيَّة",
 "たいしゅうしょうせつ": "لب (الجزء الداخلي الرخو للسن) / مجلة إثارة, مجلة رخيصة (مجلة غير مكلفة مطبوعة على ورق رديء الجودة) / عَصِيدَة, لُبّ (أي كتلة ناعمة أو رطبة) / لب, لحم الفاكهة (جزء طري رطب من الفاكهة)\nمثال: سحقه حتى أصبح لباً",
 "たいしゅうしょくどう": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "たいしゅうせい": "شَعْبِيَّة",
 "たいしゅうてき": "مَحْبُوب",
 "たいしゅうぶんか": "ثقافة جماهيرية (الثقافة التي تنتشر على نطاق واسع عبر وسائل الإعلام)",
 "たいしゅうむけ": "مَحْبُوب",
 "たいしゅうやく": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "たいしゅか": "سكير, شارب الخمر (شخص يشرب المشروبات الكحولية (خاصة بإفراط))",
 "たいしゅく": "ارتداد, تراجع (العودة إلى حالة سابقة) / انحدار, انحدار إحصائي / نكوص ((في الطب النفسي) آلية دفاع تهرب فيها من الواقع عن طريق افتراض حالة أكثر طفولية) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "たいしゅつ": "ذهاب, رحيل (فعل المغادرة) / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "たいしょ": "متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة / ذهاب, رحيل (فعل المغادرة)",
 "たいしょう": "تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / صَرِيح, مُحَدَّد بِدِقَّة (مذكور صراحة أو بالتفصيل) / خاص, محدد (ينطبق على أو يتميز بـأو يميز شيئاً معيناً أو خاصاً أو فريداً) / محدد, نوعي (كونه مرضاً أو يؤثر على مرض ناتج عن كائن دقيق أو حالة معينة؛ يستخدم أيضاً للأصباغ المستخدمة في إعداد الشرائح المجهرية) / نوعي (يتعلق بالنوع التصنيفي أو يميزه أو يشكله)\nمثال: قواعد ذات تطبيق محدد / تَنَاظُر / مُخَاطَب / دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف. / عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / مَقْطُورَة\nمثال: الكلاب تنبح، والقافلة تسير. / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "たいしょうか": "تجسيم, تشييء (فعل تمثيل فكرة مجردة كشيء مادي) / تجسيد, تشخيص (تمثيل ملموس لفكرة أو مبدأ مجرد)",
 "たいしょうがい": "مُعْفًى",
 "たいしょうぐん": "رَئِيس أَرْكَان",
 "たいしょうしゃ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "たいしょうじっけん": "تجربة ضابطة (تجربة مصممة للتحكم في المتغيرات التي تؤثر على نتائج تجربة أخرى)",
 "たいしょうせい": "تَنَاظُر",
 "たいしょうたい": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "たいしょうてき": "مُتَنَاظِر, مُتَمَاثِل / تَبَايُنِيّ, تَقَابُلِيّ (يُنْشِئُ نَحْوِيًّا عَلَاقَةَ تَبَايُنٍ بَيْنَ الجُمَلِ أَوْ عَنَاصِرِهَا) / تَبَايُنِيّ, مُتَبَايِن (مختلف بشكل لافت؛ يميل إلى المقارنة والتباين) / تَبَايُنِيّ, مُتَعَارِض ((للكلمات) مترابطة بحيث تتباين إحداها مع الأخرى) / مُؤَقَّت / سَطْحِيّ",
 "たいしょうはんい": "حَيِّز",
 "たいしょうやど": "خان, كاروانسراي (نزل في بعض الدول الشرقية مع فناء كبير يوفر الإقامة للقوافل)",
 "たいしょうりょうほう": "طب الوباتى, طب تقليدي (الطريقة المعتادة لعلاج المرض بعلاجات تنتج تأثيرات مختلفة عن تلك التي ينتجها المرض نفسه) / ارتجال, حل مرتجل (وسيلة غير مخطط لها)",
 "たいしょく": "تَقَاعُد / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت / نَهَم, شَرَه / مُقَاوِم لِلتَّآكُل (محصَّن ضدّ التآكل والصدأ) / لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "たいしょくか": "أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "たいしょくかん": "أَكَّال, شَرَه",
 "たいしょくきゅうふ": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "たいしょくきんせいど": "خطة تقاعد, نظام تقاعد (خطة لتخصيص الأموال لإنفاقها بعد التقاعد)",
 "たいしょくさいぼう": "بَالِعَة, مَاكْرُوفَاج",
 "たいしょくしゃ": "متقاعد (شخص تقاعد من العمل النشط)",
 "たいしょくとどけ": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "たいしょくねんきん": "مَعَاش / بَنْسِيُون",
 "たいしょち": "الأنتيبود, نقطة مقابلة (أي مكانين أو منطقتين على جانبين متقابلين تماماً من الأرض)\nمثال: القطب الشمالي والقطب الجنوبي متقابلان",
 "たいしょてき": "متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة",
 "たいしょてん": "الأنتيبود, نقطة مقابلة (أي مكانين أو منطقتين على جانبين متقابلين تماماً من الأرض)\nمثال: القطب الشمالي والقطب الجنوبي متقابلان",
 "たいしょほう": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "たいしょほうほう": "تَحَاشٍ / تَجَنُّب (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "たいしん": "مُوَاجَهَة, مُجَابَهَة / متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة",
 "たいしんいん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "たいしんてき": "متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة",
 "たいじ": "مُوَاجَهَة, مُجَابَهَة / جَنِين / إبادة\nمثال: 彼はありを退治しようと思った。 — حاول أن يتخلص من النمل. / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "たいじかし": "ضائقة جنينية (حالة غير طبيعية للجنين؛ تكتشف عادة أثناء الحمل وتتميز بضربات قلب غير طبيعية)",
 "たいじく": "مِحْوَرِيّ (واقِع عَلى المِحْوَر أَوْ في اتِّجاهِه) / محوري (من أو متعلق بـ أو يشبه محور الدوران) / محوري (يتعلق بـ أو متصل بالمحور)\nمثال: زاوية محورية",
 "たいじせいがん": "سرطانة جنينية (ورم خبيث في الخصية)",
 "たいじせいアルコールしょうこうぐん": "متلازمة الكحول الجنينية (حالة طبية خلقية يحدث فيها تشوه في الجسم أو ضعف في تطور الوجه أو القدرة العقلية لأن الأم كانت تشرب الكحول أثناء الحمل)",
 "たいじつしょう": "توهج معاكس (بقعة خافتة من الضوء في سماء الليل تظهر مباشرة مقابل موقع الشمس؛ انعكاس لضوء الشمس بواسطة مادة نيزكية دقيقة في الفضاء)",
 "たいじゅ": "سيكويا عملاقة (شجرة دائمة الخضرة شاهقة الارتفاع في الطرف الجنوبي من التلال الغربية لسييرا نيفادا في كاليفورنيا؛ أكبر كائن حي)",
 "たいじゅう": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "たいじゅうけい": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "たいじゅんかん": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "たいじょう": "رَجْعِيّ, مُتَحَجِّر ((ازدرائيًّا) قَدِيم الطِّرَاز وَمُتَخَلِّف عَنِ العَصْر) / مُطَحْلَب (مُكتسٍ بالطحلب بشكل مفرط) / ذهاب, رحيل (فعل المغادرة) / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / حِزَامِيّ الشَّكْل (على شكل حزام) / كِيسِيّ الشَّكْل (على شكل كيس)",
 "たいじょうかい": "تلفيف حزامي (بنية منحنية طويلة على السطح الإنسي لنصفي الكرة المخية؛ الجزء القشري من الجهاز الحوفي)",
 "たいじょうほうしん": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "たいじん": "اِسْتِقَالَة, اِسْتِعْفَاء / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / شَخْصِيّ / مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / عِمْلَاق / بَالِغ, رَاشِد",
 "たいじんかんけい": "عَلَاقَة شَخْصِيَّة (علاقة بين الأشخاص)",
 "たいじんきょうふしょう": "اِضْطِرَاب الْقَلَقِ الاِجْتِمَاعِي",
 "たいす": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "たいすい": "طَارِد لِلْمَاء, مُقَاوِم لِلْمَاء (يمنع نفاذ الماء)",
 "たいすいそう": "طَبَقَة ٱلْمِيَاهِ ٱلْجَوْفِيَّةِ",
 "たいすう": "أَسِيس, لُوغَارِثْم",
 "たいすうしゃく": "مقياس لوغاريتمي (مقياس تكون فيه المسافات الفعلية من الأصل متناسبة مع لوغاريتمات أرقام المقياس المقابلة)",
 "たいすうじゃく": "مقياس لوغاريتمي (مقياس تكون فيه المسافات الفعلية من الأصل متناسبة مع لوغاريتمات أرقام المقياس المقابلة)",
 "たいすうてき": "لوغاريتمي (من أو يتعلق باللوغاريتمات أو يستخدمها)\nمثال: دالة لوغاريتمية",
 "たいすうのほうそく": "قانون الأعداد الكبيرة ((إحصاء) قانون ينص على أن عددًا كبيرًا من العناصر المأخوذة عشوائيًا من مجتمع إحصائي سيكون له (في المتوسط) إحصائيات المجتمع)",
 "たいすうめもり": "مقياس لوغاريتمي (مقياس تكون فيه المسافات الفعلية من الأصل متناسبة مع لوغاريتمات أرقام المقياس المقابلة)",
 "たいする": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "たいせい": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَأْسِيس / مُؤَسَّسَة / تَشْرِيح / مَوْقِف, سُلُوك / المغرب, نصف الكرة الغربي (نصف الكرة الذي يشمل أمريكا الشمالية وأمريكا الجنوبية) / ولود (ينتج صغارًا أحياء (وليس بيضًا)) / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / وَضْعِيَّة",
 "たいせいかんかく": "إحساس جسدي, حس جسدي (إدراك الأحاسيس اللمسية أو استقبال الحس العميق أو الأحاسيس الحشوية)\nمثال: اعتمد على الحس الجسدي لتحذيره من تغيرات الضغط",
 "たいせいがく": "علم الأجنة (فرع علم الأحياء الذي يدرس تكوين وتطور الكائنات الحية في مراحلها المبكرة)",
 "たいせいがくしゃ": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "たいせいがわ": "تَأْسِيس / مُؤَسَّسَة",
 "たいせいしっこ": "فلمينات (ملح أو إستر لحمض الفلمينيك)",
 "たいせいじゅんのう": "امتثال, مسايرة (الالتزام بالمعايير التقليدية في الأفكار والمعتقدات)",
 "たいせいよう": "الْمُحِيط الْأَطْلَسِيّ, الْأَطْلَسِيّ",
 "たいせいようさけ": "سلمون أطلسي (يوجد في المياه الساحلية الشمالية للمحيط الأطلسي أو روافده؛ لا يموت البالغون بعد وضع البيض) / سلمون أطلسي (لحم وردي دهني لسمكة من الساحل الشمالي للأطلسي؛ يسوق عادة طازجاً)",
 "たいせいようたら": "قد أطلسي (واحدة من أهم الأسماك التجارية في العالم)",
 "たいせいようにしん": "رنجة أطلسية (سمكة طعام مهمة؛ توجد في أسراب ضخمة في شمال المحيط الأطلسي)",
 "たいせいようひょうじゅんじ": "توقيت الأطلسي (التوقيت القياسي في المنطقة الزمنية الرابعة غرب غرينتش، يحسب عند خط الطول 60؛ يستخدم في بورتوريكو وجزر العذراء وبرمودا والمقاطعات البحرية الكندية)",
 "たいせき": "سِعَة / ركام جليدي, مورين (تربة وحجارة متراكمة ترسبها الأنهار الجليدية) / تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة) / ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى) / جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها) / تِنِّين / متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة",
 "たいせきがん": "صَخْر رُسُوبِيّ",
 "たいせきさよう": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى)",
 "たいせきだんせいりつ": "مُعَامِل الْمُرُونَة الْحَجْمِيّ (نسبة التغير في الضغط المؤثر على حجم ما إلى التغير النسبي في الحجم)",
 "たいせきち": "الأنتيبود, نقطة مقابلة (أي مكانين أو منطقتين على جانبين متقابلين تماماً من الأرض)\nمثال: القطب الشمالي والقطب الجنوبي متقابلان",
 "たいせきてき": "متقابل قطرياً, نقيضي (يتعلق بالنقاط المتقابلة قطرياً على الكرة الأرضية أو يقع في جوانب متقابلة) / تَقَابُل قُطْرِيّ (علاقة التقابل على طول القطر)\nمثال: خطوط العرض المتقابلة",
 "たいせきてん": "الأنتيبود, نقطة مقابلة (أي مكانين أو منطقتين على جانبين متقابلين تماماً من الأرض)\nمثال: القطب الشمالي والقطب الجنوبي متقابلان",
 "たいせきぶつ": "رَاسِب",
 "たいせち": "مُهِمّ / ثَمِين / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "たいせつ": "مُهِمّ / ثَمِين / حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك. / عظم الفخذ, فخذ (أطول وأسمك عظم في الهيكل العظمي البشري؛ يمتد من الحوض إلى الركبة) / جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل) / جُزْء, فَلْقَة (أحد الأجزاء التي ينقسم إليها الشيء بشكل طبيعي)\nمثال: قسم من صنارة الصيد",
 "たいせつせい": "تجزئة, تقسيم (عملية التقسيم أو التجزئة؛ الفصل عن طريق إنشاء حدود تقسم أو تبقي الأشياء متباعدة) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة)",
 "たいせつどうぶつ": "تَلَفَّظَ",
 "たいせつなひと": "النصف الآخر",
 "たいせつに": "بِعِنَايَة",
 "たいせつにする": "كَنْز / اِهْتَمَّ, اِعْتَنَى",
 "たいせん": "صِرَاع / أُشْنَة, حَزَاز / اَلْحَرْب الْعُظْمَى / حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / مُضَادّ لِلْغَوَّاصَات (دفاعيّ ضدّ غوّاصات العدوّ)",
 "たいせんあいて": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "たいせんかくとうゲーム": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / فَرْدِيّ, وَجْهًا لِوَجْه (بين شخصين مباشرةً)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "たいせんしゃしゃりょう": "مدمرة الدبابات (مركبة مدرعة مجهزة بمدفع مضاد للدبابات وقادرة على التحرك بسرعات عالية)",
 "たいせんすいかん": "مُضَادّ لِلْغَوَّاصَات (دفاعيّ ضدّ غوّاصات العدوّ)",
 "たいせんカード": "اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج) / اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "たいぜん": "هَادِئ / طَمْأَنَ",
 "たいぜんじじゃく": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "たいそ": "مُؤَسِّس, مُؤَسِّسَة",
 "たいそう": "جُمْبَاز / تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم. / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُبَالَغٌ فِيه (مُصَوَّرٌ عَلَى أَنَّهُ أَكْبَرُ مِمَّا هُوَ فِي الحَقِيقَة) / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / عُنَّاب",
 "たいそうじょう": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "たいそうせんしゅ": "لاعب جمباز (رياضي ماهر في الجمباز)",
 "たいぞう": "اِكْتِنَاز",
 "たいだ": "كَسْلَان",
 "たいだいし": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة) / غير لائق, غير مناسب (غير ملائم أو غير صحيح أو غير مناسب) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "たいだん": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / ذهاب, رحيل (فعل المغادرة)",
 "たいだんしゃ": "مُحَاوِر, مُتَحَاوِر",
 "たいち": "تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة. / حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "たいちこうげき": "هجوم بري (هجوم تشنه القوات البرية)",
 "たいちどうききどう": "مدار متزامن مع الأرض (مدار دائري حول الأرض فترته 24 ساعة)",
 "たいちょ": "مجلد ضخم (كتاب كبير وعلمي (عادة)) / تُحْفَة, رَائِعَة",
 "たいちょう": "حَالَة بَدَنِيَّة, حَالَة فِسْيُولُوجِيَّة (حالة الجسم أو وظائفه الحيويّة)\nمثال: 最近あまり体調が良くないの。 — أنا لا أشعر بالراحة مؤخرا. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "たいちょうかく": "زاوية رأسية, زاوية متقابلة بالرأس (إحدى زاويتين متساويتين ومتقابلتين ناتجتين عن تقاطع خطين مستقيمين)",
 "たいちょうかんり": "رِعَايَة صِحِّيَّة",
 "たいちょうふりょう": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "たいちょうをくずす": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "たいてい": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عَادِيّ, مَأْلُوف",
 "たいてき": "عَدُوّ لَدُود (ركض أو جري)\nمثال: عدو عدوي صديقي. / أعمال عدائية, حرب (القتال؛ أعمال الحرب العلنية)\nمثال: اندلاع الأعمال العدائية",
 "たいてん": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / اِنْسِحَاب",
 "たいでん": "إمداد بالكهرباء, كهربة (فعل توفير الكهرباء) / إثارة, تهييج (نشاط إثارة أو تحميس شخص أو مجموعة بشكل ملحوظ)\nمثال: كهربة ريف تينيسي",
 "たいと": "عَلَم, نجم لامع (مشهور يمثل إلهاماً للآخرين)\nمثال: استضاف تجمعاً كبيراً من النجوم اللامعة / حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "たいとう": "مُسَاوَاة / تَسَاوٍ / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / اضمحلال (نُقْصَان؛ انحطاط؛ عَجْز)",
 "たいとく": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية / كَاهِن, قِسِّيس / ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "たいど": "مَوْقِف, سُلُوك / شهامَة",
 "たいどう": "حركة الجنين (حركة الجنين داخل الرحم (تُكتشف عادة بحلول الأسبوع السادس عشر من الحمل)) / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "たいどがおおきい": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "たいない": "مَنْزَلِيّ",
 "たいないどけい": "سَاعَة بَيُولُوجِيَّة (آلية فطرية في الكائنات الحية تتحكم في دورية العديد من الوظائف الفسيولوجية)",
 "たいなん": "بَلَاء, بُؤْس",
 "たいにちしょう": "توهج معاكس (بقعة خافتة من الضوء في سماء الليل تظهر مباشرة مقابل موقع الشمس؛ انعكاس لضوء الشمس بواسطة مادة نيزكية دقيقة في الفضاء)",
 "たいにっしょう": "توهج معاكس (بقعة خافتة من الضوء في سماء الليل تظهر مباشرة مقابل موقع الشمس؛ انعكاس لضوء الشمس بواسطة مادة نيزكية دقيقة في الفضاء)",
 "たいにん": "تَقَاعُد",
 "たいにんてん": "متعلِّق بالماضي, رَجْعِيّ",
 "たいねつこう": "مَانِع لِلْحَرَارة",
 "たいねつごうきん": "مَانِع لِلْحَرَارة",
 "たいねつざいりょう": "مَانِع لِلْحَرَارة",
 "たいねつガラス": "مَانِع لِلْحَرَارة",
 "たいのう": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "たいは": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "たいはい": "نَخْر / اضمحل / تضعضع / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "たいはいてき": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "たいはく": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي. / سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "たいはくざとう": "سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "たいはくせい": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي.",
 "たいはん": "غَالِبِيَّة, أَغْلَبِيّة / إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "たいばつ": "عُقُوبَةٌ بَدَنِيَّة",
 "たいばん": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "たいばんけいせい": "توضع المشيمي, وضع المشيمة (ترتيب البويضات في المشيمة وترتيب المشيمات في المبيض) / تشكل المشيمة (تكون المشيمة في الرحم)",
 "たいばんそうきはくり": "انفصال المشيمة المبكر (اضطراب في الحمل تنفصل فيه المشيمة قبل الأوان عن جدار الرحم)",
 "たいひ": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد) / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة / اِرْتِبَاط / إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها) / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / نسخة احتياطية ((علوم الكمبيوتر) نسخة من ملف أو دليل على جهاز تخزين منفصل) / دعم, مرافقة (جزء موسيقي (صوتي أو آلي) يدعم أو يوفر خلفية لأجزاء موسيقية أخرى) / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين / قَرْض, إِعَارَة",
 "たいひか": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "たいひごう": "مخبأ محصن, ملجأ (حجرة (غالباً تحت الأرض) محصنة ضد القصف ومزودة بالطعام ومرافق المعيشة؛ تُستخدم أثناء الغارات الجوية)",
 "たいひじょ": "دوران للخارج ((باليه) الدوران الخارجي لساق الراقص من الورك) / إِقْبَال (الحضور لحدث أو غرض معين (كما في التصويت في الانتخابات)) / طقم ملابس, هندام (مجموعة متناسقة من الملابس (مع الإكسسوارات)) / إنتاج, مخرجات (ما يتم إنتاجه في فترة زمنية معينة)\nمثال: الإقبال على التجمع / مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "たいひせん": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / كساء خارجي (مادة تطبق على السطح الخارجي للمبنى لجعله مقاومًا للعوامل الجوية)",
 "たいひてき": "تَبَايُنِيّ, تَقَابُلِيّ (يُنْشِئُ نَحْوِيًّا عَلَاقَةَ تَبَايُنٍ بَيْنَ الجُمَلِ أَوْ عَنَاصِرِهَا) / تَبَايُنِيّ, مُتَبَايِن (مختلف بشكل لافت؛ يميل إلى المقارنة والتباين) / تَبَايُنِيّ, مُتَعَارِض ((للكلمات) مترابطة بحيث تتباين إحداها مع الأخرى)",
 "たいび": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "たいふう": "تَايْفُون, إِعْصَار / ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "たいふく": "زَيّ, زِي",
 "たいぶ": "مُتَطَاوِل, مُطَوَّل (طَويل نِسْبِيًّا في المُدَّة؛ مُمْتَدّ بِشَكْل مُمِلّ) / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "たいぶつレンズ": "عدسة شيئية (العدسة أو نظام العدسات في التلسكوب أو المجهر الأقرب إلى الجسم الذي يتم عرضه)",
 "たいぶんすう": "عَدَد مُرَكَّب الْوَحَدَات, كَمِّيَّة مُرَكَّبَة (كمية يُعَبَّر عنها بوحدتين مختلفتين)\nمثال: كمية مركبة مثل 'ساعة وعشر دقائق'",
 "たいへい": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "たいへいしゅう": "أُوقِيَانُوسِيَا",
 "たいへいよう": "الْمُحِيط الْهَادِئ",
 "たいへいようじかん": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "たいへいようにんていきかんきょうりょくきこう": "لجنة العمل السياسي (لجنة تشكلها مجموعة مصالح خاصة لجمع الأموال لمرشحيها السياسيين المفضلين)",
 "たいへいようひょうじゅんじ": "توقيت المحيط الهادئ (التوقيت القياسي في المنطقة الزمنية الثامنة غرب غرينتش، يحسب عند خط الطول 120 غرباً؛ يستخدم في الولايات الغربية البعيدة بالولايات المتحدة)",
 "たいへいらく": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "たいへき": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "たいへん": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عِمْلاق / جِدِّيّ / جَدِّيّ, جَادّ / صَعْب",
 "たいべん": "عقي",
 "たいべんきゅういんしょうこうぐん": "مَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "たいほ": "ارتداد, تراجع (العودة إلى حالة سابقة) / انتكاس, تدهور (الانتقال من شكل بيولوجي أكثر تعقيداً إلى شكل أبسط) / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "たいほう": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس. / دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة) / قوة عالمية, قوة عظمى (دولة قوية بما يكفي للتأثير على الأحداث في جميع أنحاء العالم)",
 "たいほういん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "たいほく": "تَايْبِيه, تَايْبِي (عاصمة دولة تايوان)",
 "たいほじょう": "أمر قبض, مذكرة توقيف (مذكرة تخول مسؤولي إنفاذ القانون بالقبض على الجاني وإحضاره إلى المحكمة)",
 "たいほれいじょう": "أمر قبض, مذكرة توقيف (مذكرة تخول مسؤولي إنفاذ القانون بالقبض على الجاني وإحضاره إلى المحكمة)",
 "たいほれき": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "たいほん": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "たいぼ": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "たいぼう": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل. / تَقَشُّف",
 "たいま": "قِنَّب / قِنَّب هِنْدِيّ",
 "たいまい": "سلحفاة صقرية المنقار (سلحفاة بحرية استوائية عدوانية ذات منقار يشبه الصقر؛ مصدر للغذاء وأفضل أنواع صدف السلاحف)",
 "たいまく": "غشاء جنيني (أي غشاء يعمل لحماية أو تغذية أو تنفس أو إخراج الجنين النامي)",
 "たいまし": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "たいまじゅし": "راتنج القنب, قنبين (راتنج يتم الحصول عليه من نبات القنب؛ يعتقد أنه العامل المخدر النشط في الماريجوانا)",
 "たいまそう": "قِنَّب",
 "たいまつばな": "شاي أوسويغو, مونردة مزدوجة (عشب عطري معمر من شرق أمريكا الشمالية له زهور أنبوبية بألوان مختلفة في رؤوس بارزة كثيفة)",
 "たいまん": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "たいめ": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "たいめん": "شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف / تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "たいめんじゅぎょう": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "たいめんはんばい": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "たいもう": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل. / شَعْرُ الجِسْم (شعر قصير ينمو على جسم الإنسان)",
 "たいもん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "たいやく": "بَلَاء, بُؤْس",
 "たいよ": "قَرْض, إِعَارَة",
 "たいよう": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / خُلَاصَة, مُلَخَّص / مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / مَتَانَة / اِحْتَمَلَ",
 "たいようぎ": "مقياس الشمس (أداة تستخدم لقياس الفصل الزاوي بين نجمين متباعدين جداً بحيث لا يمكن تضمينهما في مجال رؤية تلسكوب عادي)",
 "たいようけい": "منظومة شمسية",
 "たいようけいがいわくせい": "كَوْكَب خَارِج الْمَجْمُوعَة الشَّمْسِيَّة ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "たいようけいぎ": "أُورُرِي, أُورُورِي",
 "たいようこう": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "たいようこうせん": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "たいようこうはつでん": "طاقة شمسية, قدرة شمسية (طاقة من الشمس يتم تحويلها إلى طاقة حرارية أو كهربائية)\nمثال: يتم تحديد كمية الطاقة الساقطة على الأرض بواسطة الثابت الشمسي، ولكن لم يتم الاستفادة إلا قليلاً جداً من الطاقة الشمسية",
 "たいようこうパネル": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "たいようこくてん": "بقعة شمسية, كلف الشمس (بقعة داكنة أكثر برودة تظهر بشكل دوري على الغلاف الضوئي للشمس؛ مرتبطة بمجال مغناطيسي قوي)",
 "たいようしゅう": "أُوقِيَانُوسِيَا",
 "たいようしん": "إله الشمس (إله يجسد الشمس أو يرتبط بها بشكل ما)",
 "たいようしんけいそう": "ضفيرة زلاقية, ضفيرة شمسية (ضفيرة كبيرة من الأعصاب الودية في البطن خلف المعدة)",
 "たいようじ": "توقيت شمسي (حساب لمرور الوقت بناءً على موقع الشمس في السماء)",
 "たいようじつ": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "たいようちゅう": "حيوان شمسي (أوالي ذات أجسام كروية وأقدام كاذبة شعاعية صلبة)",
 "たいようでんち": "خلية شمسية, خلية كهروضوئية (خلية تحول الطاقة الشمسية إلى طاقة كهربائية)",
 "たいようでんちパネル": "بطارية شمسية, مصفوفة شمسية (جهاز كهربائي يتكون من مصفوفة كبيرة من الخلايا الشمسية المتصلة)",
 "たいようとう": "مصباح شمسي (مصباح بخار الزئبق يستخدم في العلاجات الطبية أو التجميلية)",
 "たいようねん": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "たいようはぐるま": "ترس شمسي (الترس المركزي في مجموعة التروس التداويرية)",
 "たいようふう": "رِيح شَمْسِيَّة",
 "たいようふくしゃ": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "たいようほうしゃ": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "たいようぼうえんきょう": "تلسكوب شمسي (تلسكوب مصمم لرصد الشمس)",
 "たいようれき": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "たいようろ": "طبق شمسي, مجمع شمسي (مرآة مقعرة تركز أشعة الشمس؛ يمكن أن تنتج درجات حرارة عالية)",
 "たいようエネルギー": "طاقة شمسية, قدرة شمسية (طاقة من الشمس يتم تحويلها إلى طاقة حرارية أو كهربائية)\nمثال: يتم تحديد كمية الطاقة الساقطة على الأرض بواسطة الثابت الشمسي، ولكن لم يتم الاستفادة إلا قليلاً جداً من الطاقة الشمسية",
 "たいようフレア": "اِنْفِجَار شَمْسِيّ",
 "たいよく": "طَمَع, شُحُّ",
 "たいら": "مُسَطَّح / هَادِئ / طَمْأَنَ / مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً / هَضْبَة",
 "たいらか": "مُسْتَوًى / مَرْحَلَة",
 "たいらげる": "اِسْتَعْبَدَ, قَهَرَ",
 "たいらん": "ثَوْرَة, تَمَرُّد",
 "たいりく": "قَارَّة",
 "たいりくおうだん": "عَابِر لِلْقَارَّة (يمتد عبر القارة أو يعبرها أو يقع على الجانب الآخر منها)",
 "たいりくおおかみ": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "たいりくかい": "كراتون, كُتْلَة قَارِّيَّة (الجزء المستقر من القارة الذي يشكل الكتلة المركزية لها؛ عادة من عصر ما قبل الكمبري)",
 "たいりくかいぎ": "الكُونْغَرِس القَارِّيّ (الجمعية التشريعية المكونة من مندوبين من المستعمرات المتمردة الذين اجتمعوا خلال وبعد الثورة الأمريكية؛ أصدروا إعلان الاستقلال وصاغوا مواد الكونفدرالية)",
 "たいりくかんだんどうだん": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "たいりくかんだんどうミサイル": "صاروخ باليستي عابر للقارات (صاروخ باليستي قادر على السفر من قارة إلى أخرى)",
 "たいりくせい": "قَارِّيّ",
 "たいりくだな": "رصيف قاري (قاع البحر الضحل نسبياً (حتى 200 متر) المحيط بالقارة)",
 "たいりくてき": "قَارِّيّ / هَادِئ / طَمْأَنَ",
 "たいりくほう": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "たいりつ": "مُوَاجَهَة, مُجَابَهَة",
 "たいりついでんし": "بَدِيل وِرَاثِيّ",
 "たいりつかんけい": "تضاد حيوي ((كيمياء حيوية) تداخل في أو تثبيط العمل الفسيولوجي لمادة كيميائية بواسطة أخرى لها بنية مماثلة) / تضاد, عداء (شعور معبر عنه بوضوح بالكراهية والعداء) / تَضَادّ, تَنَافُر (العلاقة بين مبادئ أو قوى أو عوامل متعارضة) / بغضاء, خصومة (حالة من الضغينة العميقة)\nمثال: التنافر المتأصل بين الرأسمالية والاشتراكية",
 "たいりつがいねん": "تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً",
 "たいりつきょうこう": "بابا مزيف, بابا مضاد (شخص يُنتخب بابا في معارضة لشخص آخر يُعتبر منتخباً بشكل قانوني)\nمثال: أقام الباباوات المزيفون في أفينيون خلال الانشقاق العظيم",
 "たいりつしゃ": "خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "たいりゃく": "لَخَّصَ, اِخْتَصَرَ / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة",
 "たいりゅう": "رُكُود / ركود اقتصادي / مَكَثَ, بَقِيَ / إِقَامَة / حمل حراري (انتقال الحرارة عبر مائع (سائل أو غاز) ناتج عن حركة الجزيئات) / حمل حراري ((في الأرصاد الجوية) الحركة العمودية للحرارة أو غيرها من الخصائص عن طريق حركة الكتل داخل الغلاف الجوي)",
 "たいりゅうけん": "تروبوسفير, غلاف متقلب (أدنى طبقة في الغلاف الجوي؛ من 4 إلى 11 ميلاً ارتفاعاً (حسب خط العرض))",
 "たいりゅうけんかいめん": "تروبوبوز (منطقة الانقطاع بين التروبوسفير والستراتوسفير)",
 "たいりょう": "وزن الجسم (وزن جسم الشخص) / ضَخْم, هائِل الكُتْلَة (ذو كُتْلَة كَبيرَة؛ يَحْتَوي عَلى كَمِّيَّة هائِلَة مِن المادَّة) / صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة) / هَائِل, وَاسِع (مهيب في النطاق أو المدى أو الدرجة أو القوة) / مُتَجَانِس, مُصْمَت (مؤلَّف من المادّة نفسها في جميع أجزائه)",
 "たいりょうぎゃくさつ": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "たいりょうさつがい": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)",
 "たいりょうさつじん": "قَتْل جَمَاعِيّ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "たいりょうさつじんしゃ": "قاتل جماعي (شخص مسؤول عن وفاة العديد من الضحايا في حادث واحد)",
 "たいりょうしゅっけつ": "نَزِيف, نَزْف",
 "たいりょうせいさん": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "たいりょうそうしん": "بريد بالجملة (بريد يتكون من أعداد كبيرة من العناصر المتطابقة (منشورات أو إعلانات) ترسل إلى عناوين فردية بأسعار أقل من الدرجة الأولى وتدفع في دفعة واحدة)",
 "たいりょうちゅうもん": "مطلب صعب, مهمة شاقة (مهمة أو متطلب هائل)\nمثال: كان الانتهاء في الوقت المحدد مطلباً صعباً لكننا فعلنا ذلك",
 "たいりょうはかいへいき": "سِلَاح دَمَار شَامِل",
 "たいりょうはっこう": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "たいりょく": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "たいりょくかべ": "جدار حامل (أي جدار يدعم أرضية أو سقف مبنى)",
 "たいりょくてき": "مَادِّيّ, مَلْمُوس",
 "たいりょくへき": "جدار حامل (أي جدار يدعم أرضية أو سقف مبنى)",
 "たいるい": "حشيشة الكبد (أي من النباتات اللاوعائية الخضراء الصغيرة العديدة من طائفة الكبدية تنمو في الأماكن الرطبة وتشبه الأعشاب البحرية الخضراء أو الحزازيات الورقية)",
 "たいれい": "عمر الحمل, عمر جنيني (عمر الجنين محسوباً من وقت الإخصاب)",
 "たいれいふく": "زي تشريفات كامل (الزي البحري أو العسكري المحدد باللوائح للارتداء في المناسبات الاحتفالية)",
 "たいれつ": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "たいれん": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "たいろ": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "たいわ": "حِوَار, مُحَادَثَة / حِوَار",
 "たいわがた": "تآزري, تفاعلي (يستخدم بشكل خاص للأدوية أو العضلات التي تعمل معاً بحيث يكون التأثير الكلي أكبر من مجموع الاثنين (أو أكثر)) / تَفَاعُلِيّ (قادر على التأثير المتبادل)",
 "たいわしき": "تآزري, تفاعلي (يستخدم بشكل خاص للأدوية أو العضلات التي تعمل معاً بحيث يكون التأثير الكلي أكبر من مجموع الاثنين (أو أكثر)) / تَفَاعُلِيّ (قادر على التأثير المتبادل)",
 "たいわしゃ": "مُحَاوِر, مُتَحَاوِر",
 "たいわてき": "تآزري, تفاعلي (يستخدم بشكل خاص للأدوية أو العضلات التي تعمل معاً بحيث يكون التأثير الكلي أكبر من مجموع الاثنين (أو أكثر)) / تَفَاعُلِيّ (قادر على التأثير المتبادل)",
 "たいわん": "تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان.",
 "たいわんご": "تَايْوَانِيّ",
 "たいわんはげ": "صَلَع, فقدان الشعر",
 "たいわんやまいも": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "たいわんドル": "دولار تايواني (وحدة المال الأساسية في تايوان)",
 "たいわんハゲ": "صَلَع, فقدان الشعر",
 "たいをかわす": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "たいをひらく": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "たいん": "عطش مفرط, نهام للسوائل (عطش مفرط (كما في حالات السكري أو خلل وظائف الكلى)) / شَهْوَة",
 "たい肥": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "たうりん": "غَابَة اِسْتِوَائِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "たえ": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "たえいる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "たえうる": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "たえがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "たえきれる": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "たえざる": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "たえしのぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "たえしのぶ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "たえず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "たえだえ": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / خَافِت, وَاهِن (ضعيف في قوته أو حيويته) / سَقِيم, وَاهٍ (يفتقر بشكل مُثير للشفقة إلى القوة أو الفاعلية)",
 "たえない": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "たえなる": "بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن) / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "たえま": "فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "たえまない": "مُسْتَمِرّ, مُتَوَاصِل",
 "たえまなく": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "たえる": "دُبّ / دُبَّة / اِحْتَمَلَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِنْقَرَضَ\nمثال: いまはもうこの種のちょうは絶えてしまっている。 — الفراشات من هذا النوع قد انقرضت. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "たえることなく": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "たおす": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته) / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / أَطَاحَ / غَشَّ",
 "たおやか": "رَشِيق, ظَرِيف",
 "たおやめ": "حورية الهواء, سيلف (كائن عنصري يعتقد أنه يسكن الهواء) / حسناء رشيقة (شابة رشيقة ونحيلة)",
 "たおる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "たおれ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "たおれこむ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "たおれる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "たおんじ": "حرف متعدد الأصوات (حرف له نطقان أو أكثر)",
 "たおんせつ": "كلمة متعددة المقاطع (كلمة تتكون من أكثر من ثلاثة مقاطع)",
 "たおんせつご": "كلمة متعددة المقاطع (كلمة تتكون من أكثر من ثلاثة مقاطع)",
 "たか": "دَرَجَة / صَقْر, بَاز / كَمِّيَّة, مِقْدَار / تعدد التكافؤ ((علم السموم) حالة القدرة على مواجهة أكثر من سم أو مستضد أو نوع من الكائنات الحية الدقيقة) / تعدد التكافؤ ((كيمياء) حالة امتلاك تكافؤ أكبر من اثنين)",
 "たかあし": "كُرْسُوع, أَبُو الْمَغَازِل",
 "たかい": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال / غَالٍ, الْغَالِي / عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "たかいそう": "متعدد المستويات (مبنى له أكثر من مستوى)",
 "たかうきぼり": "نقش بارز عالي (نحت بارز تبرز فيه الأشكال من الخلفية لنصف عمقها على الأقل)",
 "たかが": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "たかがり": "صَقَارَة",
 "たかきび": "ذُرَة, سرغوم",
 "たかく": "مُتَعَدِّد الأَطْرَاف, مُتَعَدِّد الجَوَانِب (لديه أجزاء أو جوانب متعددة) / مُتَعَدِّد الأَوْجُه (ذو جوانب وألوان متعدّدة ومتنوّعة) / مُتَشَعِّب, مُتَعَدِّدُ الجَوَانِب (ذُو جَوَانِبَ أَوْ صِفَاتٍ كَثِيرَة)",
 "たかくか": "تَنْوِيع",
 "たかくけい": "مُضَلَّع",
 "たかくけいえい": "تَنْوِيع",
 "たかくてき": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف. / مُتَعَدِّد الأَطْرَاف, مُتَعَدِّد الجَوَانِب (لديه أجزاء أو جوانب متعددة)",
 "たかごえ": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "たかさ": "اِرْتِفَاع",
 "たかさご": "تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان.",
 "たかさアクセント": "نبر نغمي (تأكيد ينتج عن الحدة بدلاً من الجهارة)",
 "たかじゅせい": "إثراء متبادل, تلاقح فكري (التبادل بين ثقافات مختلفة أو طرق تفكير مختلفة بشكل مثمر ومفيد للطرفين) / إخصاب خلطي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من فردين مختلفين من نفس النوع)\nمثال: الإثراء المتبادل بين العلم والفنون الإبداعية",
 "たかじゅふん": "تبادل التأثير, تلاقح الأفكار (تأثير محفز بين عناصر متنوعة) / تلقيح خلطي (إخصاب عن طريق نقل حبوب اللقاح من مئبر زهرة إلى ميسم زهرة أخرى)\nمثال: تلاقح الفنون",
 "たかじょう": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور)",
 "たかす": "عش (أي مسكن على ارتفاع شاهق (مثل عش النسر)) / وَكْر (العش المرتفع لطائر جارح (مثل الصقر أو النسر))",
 "たかせ": "ضَحِل / صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "たかせぶね": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "たかたかゆび": "وُسْطَى",
 "たかだい": "أرضية عليا, تفوق (موقف تفوق على الخصوم أو المنافسين)",
 "たかだか": "عالياً, في الأعالي (على ارتفاع كبير)\nمثال: تسلق عالياً على السلم / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "たかちょうし": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها)",
 "たかっけい": "مُضَلَّع",
 "たかつか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "たかづか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "たかとび": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / قفز عالي, وثب عالي (فعل القفز لأعلى ارتفاع ممكن فوق عارضة أفقية) / القفز العالي, الوثب العالي (مسابقة تتضمن القفز لأعلى ارتفاع ممكن فوق عارضة أفقية)",
 "たかな": "أوراق الخردل, خردل (أوراق تؤكل مطبوخة) / خردل صيني, خردل هندي (خردل آسيوي يستخدم كعشب وعائي)",
 "たかなり": "جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / تقديم الخاتم (إعطاء خاتم كرمز للخطوبة) / دق الجرس, رنين (صوت رنين الجرس)\nمثال: الرنين المميز لجرس الكنيسة",
 "たかなる": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "たかね": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "たかの": "صَقَارَة",
 "たかのしれた": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "たかの知れた": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "たかは": "صَقْر, بَاز",
 "たかひく": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "たかびしゃ": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "たかふほうわしぼうさん": "حمض دهني متعدد غير مشبع (حمض دهني غير مشبع تحتوي سلسلة الكربون الخاصة به على أكثر من رابطة تكافؤ مزدوجة أو ثلاثية لكل جزيء؛ يوجد بشكل رئيسي في السمك وزيت الذرة وزيت فول…)",
 "たかぶり": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "たかまき": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "たかまつ": "تَاكَامَاتْسُو",
 "たかまり": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "たかまる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "たかみ": "اِرْتِفَاع",
 "たかむな": "برعم الخيزران (براعم الخيزران الصغيرة الصالحة للأكل)",
 "たかめ": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "たかめる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "たかやすどうみゃくえん": "التهاب الشرايين تاكاياسو, مرض انعدام النبض (اضطراب يتميز بغياب النبض في كلا الذراعين وفي الشرايين السباتية)",
 "たから": "كَنْز",
 "たからか": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "たからがい": "ودع",
 "たからくじ": "يَانَصِيب",
 "たからさかっているときはさかってでる": "حَرَام, غَيْر مَشْرُوع (مُكْتَسَب بِطُرُق غَيْر مَشْروعَة أَوْ غَيْر نَزيهَة)",
 "たからさがし": "البحث عن الكنز (لعبة يحاول فيها اللاعبون العثور على أغراض مخفية باستخدام سلسلة من الأدلة) / اختيار عشوائي (اختيار أو قرار عشوائي بحت) / سحب الحظ (لعبة يتم فيها إخفاء جوائز (مثل الحلوى أو العملات المعدنية) في وعاء ويمكن للاعب مقابل مبلغ صغير أن يسحب واحدة عشوائياً)\nمثال: بدا نظام توظيفهم للأشخاص وكأنه نوع من الاختيار العشوائي",
 "たからのやま": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه)",
 "たからばこ": "صندوق كنز (صندوق مملوء بالأشياء الثمينة)",
 "たからぶね": "سفينة كنز (سفينة من القرن السادس عشر محملة بالكنوز)",
 "たからもの": "كَنْز",
 "たかり": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / مبتز (مجرم يبتز المال من شخص ما بتهديده بفضح معلومات محرجة عنه)",
 "たかりや": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "たかり屋": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "たかる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / إِسْفَنْج / سَفِنْج",
 "たかをくくる": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "たかん": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "たかんしょう": "فرط التعرق (تعرق مفرط وغزير)",
 "たかんせつ": "مَفْصِلِيّ (يتكون من أجزاء متماسكة بواسطة مفاصل)",
 "たかんな": "برعم الخيزران (براعم الخيزران الصغيرة الصالحة للأكل)",
 "たかビー": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "たかピー": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "たかーい": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال / غَالٍ, الْغَالِي / عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "たが": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات) / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية. / لِمَن / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / اَللَّوَاتِي / مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / الأنا الآخر, توأم الروح (صديق مقرب جداً وموثوق يبدو وكأنه جزء من نفسك)",
 "たがい": "بَعْضُهُ الْبَعْض",
 "たがいちがい": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "たがいちがいに": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "たがいに": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "たがいにそ": "لَا تَقَاطُعَ بَيْنَهُمَا, مُنْفَصِل (ليس بينهما عناصر مشتركة)",
 "たがう": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "たがえる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "たがく": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "たがね": "إِزْمِيل / منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش) / مهماز (نخاس حاد مثبت في كعب الراكب ويستخدم لحث الحصان على التقدم) / اضطراب القلق العام (اضطراب قلق يتميز بقلق مزمن غير محدد وأعراض مثل التوتر أو التعرق أو الارتجاف أو الدوار أو التهيج وما إلى ذلك، والتي استمرت لأكثر من ستة أشهر)\nمثال: يعرف رعاة البقر ألا يجلسوا القرفصاء وهم يرتدون مهاميزهم / حَلْوَى",
 "たがやす": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "たがらし": "حوذان سام, حوذان كرفسي الأوراق (عشب حولي ينمو في الأماكن السبخة)",
 "たがをはめる": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "たき": "اِرْتِفَاع / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / كُلّ, جَمِيع / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً)\nمثال: عظمة العمارة / مُتَنَوِّع / شَلَّال / سَرِيع",
 "たきあげる": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "たきおとし": "جَمْرَة",
 "たきがわ": "سَرِيع",
 "たきぎ": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)\nمثال: もう少し火にまきをくべなさい。 — زد بعض الحطب إلى النار.",
 "たきぎごや": "سقيفة الحطب (سقيفة لتخزين حطب الوقود أو أدوات الحديقة)",
 "たきぐち": "أَبْوَاب, بَاب",
 "たきたて": "بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً",
 "たきたよう": "مُتَنَوِّع, وَاسِع النِّطَاق (مُخْتَلِف اخْتِلَافًا كَبِيرًا) / شَامِل, وَاسِع التَّنَوُّع (يتضمّن الكثير ومتنوّع)",
 "たきつけ": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "たきつける": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "たきのう": "مُتَعَدِّدُ الأَغْرَاض (ذُو اسْتِخْدَامَاتٍ مُتَعَدِّدَة)",
 "たきのうけいたいでんわ": "هَاتِف ذَكِيّ, سِمَارْت فُون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "たきび": "مَشْعَل",
 "たきびだい": "حفرة نار (حفرة أرضيتها من الحمم المتوهجة)\nمثال: حفرة النار في الفوهة",
 "たきもの": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ؛ حَطَبُوه: قَطَعُوه)\nمثال: بحث زيري عن الحطب. / بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "たきょう": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "たき口": "أَبْوَاب, بَاب",
 "たき木": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)\nمثال: もう少し火にまきをくべなさい。 — زد بعض الحطب إلى النار.",
 "たき火": "مَشْعَل",
 "たき落とし": "جَمْرَة",
 "たぎご": "متعدد المعاني, مشترك لفظي (كلمة لها أكثر من معنى)",
 "たぎせい": "اِلْتِبَاس / إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "たぎてき": "غَامِض",
 "たぎらす": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "たぎる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة. / فَيَضَان / فَاضَ",
 "たく": "جَدْوَل / مَجْلِس\nمثال: ワシントン市の友人宅に泊まります。 — سأبيت في بيت أحد أصدقائي في مدينة واشنطن. / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر. / دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / إمساك, التقاط (فعل التقاط شيء باليدين) / فرقعة الأصابع (فعل فرقعة الأصابع؛ حركة إصبع من الطرف إلى قاعدة الإبهام في نفس اليد) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: أسقط لاعب الوسط الكرة عند السحب / حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…) / ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "たくいつ": "تَقَدُّم",
 "たくいつてき": "بَدِيلِيّ, تَخْيِيرِيّ (يَسْتَلْزِمُ الِاخْتِيَارَ بَيْنَ احْتِمَالَاتٍ مُتَنَافِيَةٍ) / بَدِيل (يَتَعَلَّقُ بِخِيَارَاتٍ غَيْرِ تَقْلِيدِيَّة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بديل, خيار (واحد من عدد من الأشياء التي يمكن اختيار واحد منها فقط)\nمثال: ما الخيار الذي كان لدي؟",
 "たくいつもんだい": "متعدد الخيارات (يقدم عدة إجابات بديلة يجب اختيار الإجابة الصحيحة منها)\nمثال: أسئلة متعددة الخيارات",
 "たくえつ": "تَقَدُّم",
 "たくえつした": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "たくえつふう": "رياح سائدة (اتجاه الرياح الغالب)\nمثال: الرياح السائدة هي من الجنوب الغربي",
 "たくかかく": "جرمانيوم (عنصر بلوري رمادي هش وهو شبه فلز شبه موصل (يشبه السيليكون) يستخدم في الترانزستورات؛ يوجد في الجرمانيت والأرجيروديت)",
 "たくけい": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "たくけいぞう": "وضعية الصليب (تمرين جمباز يُؤدى على الحلقات عندما يدعم لاعب الجمباز نفسه بذراعين ممدودتين أفقياً) / الصليب المصلوب, الصليب المقدس (تمثيل للصليب الذي مات عليه يسوع)",
 "たくげん": "ذَرِيعَة, عُذْر / رِسَالَة, خَبَر",
 "たくさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "たくし": "جَدْوَل / صُحَيْفَة, طَبَق فِنْجَان",
 "たくしき": "اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "たくしゅつ": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "たくしょく": "اِسْتِعْمَار",
 "たくじ": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "たくじしつ": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "たくじしょ": "مأوى اللقطاء, مستشفى اللقطاء (مستشفى يتم فيه استقبال اللقطاء (الأطفال الرضع مجهولي الوالدين) ورعايتهم) / مغارة الميلاد (تمثيل لميلاد المسيح في الإسطبل في بيت لحم)",
 "たくじょう": "سَطْح الْمَكْتَب (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "たくじょうがたコンピュータ": "حاسوب مكتبي (حاسوب شخصي صغير بما يكفي ليوضع بشكل ملائم في مساحة عمل فردية)",
 "たくじょうしゅっぱん": "نشر مكتبي ((علم الحاسوب) استخدام الحواسيب الصغيرة ذات القدرات الرسومية لإنتاج مواد مطبوعة)",
 "たくじょうち": "هضبة (أرض مرتفعة مستوية نسبياً)",
 "たくじょうでんわ": "هاتف مكتبي (جهاز هاتف يوضع على مكتب أو طاولة)",
 "たくす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / صُحَيْفَة, طَبَق فِنْجَان",
 "たくする": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "たくせん": "كَاهِن, عَرَّاف / إِلْهَام",
 "たくぜつ": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "たくぜん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "たくそう": "إرسالية, شحنة (تسليم البضائع للبيع أو التصرف فيها) / إيداع (الفعل الرسمي لإرسال شخص للحبس (كما في سجن أو مستشفى للأمراض العقلية)) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "たくちゅう": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "たくはいしゃ": "شاحنة توصيل (شاحنة مغلقة مناسبة لتسليم البضائع أو الخدمات للعملاء)",
 "たくはいにん": "عامل توصيل (رجل موظف للقيام بالتوصيل)",
 "たくばつ": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "たくび": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "たくほん": "احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / طبع بالفرك (تمثيل يتكون من نسخة (كما لنقش) مصنوعة بوضع ورقة فوق شيء ما وفركها بالفحم) / احتكاك (المقاومة التي يتم مواجهتها عند تحريك جسم متلامس مع آخر)",
 "たくぼく": "نَقَّار الخَشَب",
 "たくぼくちょう": "نَقَّار الخَشَب",
 "たくま": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "たくまざる": "طَبِيعِيّ",
 "たくましい": "ضَخْمُ البِنْيَة, مَفْتُول (عضليّ وثقيل البنية) / عَصِيّ, لَا يُرْوَض (مُسْتَحِيلُ الإِخْضَاعِ أَوِ التَّطْوِيعِ) / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "たくまずして": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "たくまぬ": "طَبِيعِيّ",
 "たくみ": "مَاهِر, حَاذِق / حِرْفَة, صَنْعَة / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى. / حِرْفَة, صَنْعَة / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "たくむ": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "たくよう": "مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب. / أذينة (نمو ورقي صغير عند قاعدة ورقة أو ساقها؛ عادة ما يحدث في أزواج ويسقط قريباً) / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "たくらみ": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "たくらむ": "مَكِيدَة",
 "たくりつ": "شَهِير (معروف على نطاق واسع؛ معروف تحديدًا بسبب شيء سلبي)\nمثال: أصبحت ريمة شهيرة.",
 "たくりゅう": "نَفْي, تَبْعِيد / نَفَى",
 "たくわえ": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "たくわえる": "خَزَنَ (حفظ، إدخر، أودع في مخزن) / طَوَّرَ / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "たぐい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل",
 "たぐいする": "مُنَافِس",
 "たぐいない": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "たぐいまれ": "نَادِر",
 "たぐえる": "قَارَنَ / شَبَّهَ",
 "たぐり": "شبكة",
 "たぐりだす": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "たぐりよせる": "اِجْتَذَبَ, جَذَبَ",
 "たぐり出す": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "たぐり寄せる": "اِجْتَذَبَ, جَذَبَ",
 "たぐる": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "たけ": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل. / قمة جبل (ذروة الجبل) / اِرْتِفَاع / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / كُلّ, جَمِيع / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً)\nمثال: عظمة العمارة / خَيْزَرَان, خَيْزُرَان / مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "たけい": "تعدد الأشكال ((في علم الأحياء) وجود شكلين أو أكثر من الأفراد ضمن نفس النوع الحيواني (بشكل مستقل عن الفروق الجنسية)) / تعدد الأشكال, تعدد الأشكال البلورية ((في الكيمياء) وجود أنواع مختلفة من البلورات لنفس المركب الكيميائي) / تعدد الأشكال الجينية ((في علم الوراثة) التباين الوراثي داخل مجتمع ما الذي يمكن للانتقاء الطبيعي أن يعمل عليه)",
 "たけいせい": "تعدد الأشكال ((في علم الأحياء) وجود شكلين أو أكثر من الأفراد ضمن نفس النوع الحيواني (بشكل مستقل عن الفروق الجنسية)) / تعدد الأشكال, تعدد الأشكال البلورية ((في الكيمياء) وجود أنواع مختلفة من البلورات لنفس المركب الكيميائي) / تعدد الأشكال الجينية ((في علم الوراثة) التباين الوراثي داخل مجتمع ما الذي يمكن للانتقاء الطبيعي أن يعمل عليه)",
 "たけうま": "كُرْسُوع, أَبُو الْمَغَازِل",
 "たけき": "بَاسِل, مَغْوَار (يَمْتَلِك أَوْ يُظْهِر بَسَالَةً وإِقْدَامًا)",
 "たけくらべ": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "たけし": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً) / قَوِيّ, قَادِر (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "たけだけしい": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس / جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة) / صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب)",
 "たけっしょうせい": "مُتَعَدِّد البَلُّورَات (مُكَوَّن مِنْ تَجَمُّعَات بَلُّورِيَّة مُتَعَدِّدَة)",
 "たけつ": "استبشار, ثقة (الشعور بالاستبشار؛ تفاؤل مرح وواثق)",
 "たけつかん": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "たけつしょう": "احمرار الدم, كثرة الحمر (اضطراب يتميز بزيادة غير طبيعية في عدد خلايا الدم الحمراء في الدم)",
 "たけなが": "طَوِيل",
 "たけなわ": "اِرْتِفَاع",
 "たけにぐさ": "بوكونيا, خشخاش الريش (عشبة من الصين واليابان تزرع على نطاق واسع لعناقيدها الريشية من الزهور البيضاء الكريمية)",
 "たけのこ": "برعم الخيزران (براعم الخيزران الصغيرة الصالحة للأكل)",
 "たけりくるう": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "たけりたつ": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ / عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "たけり狂う": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "たけり立つ": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ / عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "たける": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ / يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ) / أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "たけをつめる": "قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "たけをわったよう": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن) / جَلِيّ, وَاضِح (وَاضِح وَمُتَمَيِّز لِلحَوَاسّ؛ سَهْل الإِدْرَاك) / مَقْطُوع الأَشْجَار كُلِّيًّا (أُزيلت جميع أشجاره دفعة واحدة) / نَزِيه, صَادِق",
 "たげい": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "たげいたさい": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "たげり": "أبو طيط, زقزاق شامي (زقزاق متوج كبير من العالم القديم له دلايات ومهاميز)",
 "たげん": "تعددية وظيفية (ممارسة شخص واحد لشغل أكثر من منصب ديني في وقت واحد) / تعددية (المذهب القائل بأن الواقع يتكون من عدة مواد أو عناصر أساسية) / تعددية (تنظيم اجتماعي يتم فيه التسامح مع تنوع الجماعات العرقية أو الدينية أو الإثنية أو الثقافية) / ثرثرة (صفة الإطناب وكثرة الكلام) / أَفْشَى",
 "たげんうちゅう": "كون متعدد",
 "たげんご": "مُتَعَدِّد اللُّغَات, أَلْسُنِيّ / أَلْسُنِيّ, لِسانجيّ",
 "たげんごか": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "たげんし": "متعدد الذرات (متعلق بجزيء يتكون من أكثر من ذرتين)",
 "たげんしか": "تعدد التكافؤ ((كيمياء) حالة امتلاك تكافؤ أكبر من اثنين)",
 "たげんてき": "تعددي (من أو يتعلق بمذهب التعددية الفلسفي)\nمثال: ثقافة تعددية",
 "たげんぶんかろん": "اَلتَّعَدُّدِيَّةُ اَلثَّقَافِيَّة",
 "たげんろん": "تعددية وظيفية (ممارسة شخص واحد لشغل أكثر من منصب ديني في وقت واحد) / تعددية (المذهب القائل بأن الواقع يتكون من عدة مواد أو عناصر أساسية) / تعددية (تنظيم اجتماعي يتم فيه التسامح مع تنوع الجماعات العرقية أو الدينية أو الإثنية أو الثقافية)",
 "たこ": "جُسْأَة / الكالس النباتات / طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة. / أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه) / مُغَفَّل, أَحْمَق",
 "たこう": "مَسَامِّيّ",
 "たこうかん": "اِبْتِهَاج, نَشْوَة (البَهْجَةُ: الحُسْنُ يُقَال: رَجُلٌ ذُو بَهْجَةٍ؛ وَيُقَال: هُوَ حُسْنُ لَونِ الشيْءِ ونَضَارَتُه، وَقيل: هُوَ فِي النّباتِ النضَارَةُ…؛ (بَهُجَ، ككَرُمَ) بَهْجَةً و (بَهاجَةً) وبَهَجَاناً (فَهُوَ بَهِيجٌ، و) امرأَةٌ بَهِجَةٌ: مُبْتَهِجَةٌ، وَقد بَهُجَتْ بَهْجَةً، و (هِيَ مِبْهَاجٌ)…) / مبتهج, منتشٍ (شعور مبالغ فيه بالرفاهية أو الابتهاج)",
 "たこうしき": "متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود",
 "たこうしつ": "مَسَامِّيّ",
 "たこうしょう": "اِبْتِهَاج, نَشْوَة (البَهْجَةُ: الحُسْنُ يُقَال: رَجُلٌ ذُو بَهْجَةٍ؛ وَيُقَال: هُوَ حُسْنُ لَونِ الشيْءِ ونَضَارَتُه، وَقيل: هُوَ فِي النّباتِ النضَارَةُ…؛ (بَهُجَ، ككَرُمَ) بَهْجَةً و (بَهاجَةً) وبَهَجَاناً (فَهُوَ بَهِيجٌ، و) امرأَةٌ بَهِجَةٌ: مُبْتَهِجَةٌ، وَقد بَهُجَتْ بَهْجَةً، و (هِيَ مِبْهَاجٌ)…) / مبتهج, منتشٍ (شعور مبالغ فيه بالرفاهية أو الابتهاج)",
 "たこうせい": "مَسَامِّيَّة",
 "たこうな": "برعم الخيزران (براعم الخيزران الصغيرة الصالحة للأكل)",
 "たこうもく": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "たこく": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "たこくかん": "مُتَعَدِّد الأَطْرَاف, مُتَعَدِّد الجَوَانِب (لديه أجزاء أو جوانب متعددة)",
 "たこくじん": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "たこくせき": "عَابِر لِلْأُمَم, مُتَعَدِّد الجِنْسِيَّات (يشمل أو يعمل في عدة دول أو جنسيات)",
 "たこくせきげんご": "مُتَعَدِّد اللُّغَات, أَلْسُنِيّ / أَلْسُنِيّ, لِسانجيّ",
 "たこくもの": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "たこつぼ": "حفرة فردية (خندق صغير به حفرة للمأوى الفردي ضد نيران العدو) / فُقَّاعَة",
 "たこにゅうどう": "أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه)",
 "たこべや": "مخيم عمل قسري, معسكر عمل (مؤسسة عقابية للسجناء السياسيين الذين يستخدمون كعمالة قسرية)",
 "たこやき": "تاكوياكي (وجبة خفيفة يابانية على شكل كرة مصنوعة من عجين أساسه دقيق القمح وتطهى في مقلاة مقولبة خاصة)",
 "たこ入道": "أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه)",
 "たこ焼き": "تاكوياكي (وجبة خفيفة يابانية على شكل كرة مصنوعة من عجين أساسه دقيق القمح وتطهى في مقلاة مقولبة خاصة)",
 "たこ部屋": "مخيم عمل قسري, معسكر عمل (مؤسسة عقابية للسجناء السياسيين الذين يستخدمون كعمالة قسرية)",
 "たごさく": "فَلَّاح, فَلَّاحَة",
 "たごん": "أَفْشَى",
 "たごんむよう": "السر في بئر",
 "たさい": "زَاهِي الأَلْوَان, مُلَوَّن (لديه لون أو لون معين؛ تستخدم أحياناً في التركيب) / زَاهِي الأَلْوَان, مُلَوَّن (لديه الكثير من الألوان أو ألوان متنوعة) / حَيَوِيّ, مُثِير (لافت للنظر في التنوع والاهتمام)\nمثال: ورق كريب ملون / مُخْتَلِف, مُتَنَوَّع / موهوب (وهبه الله موهبة أو مواهب)\nمثال: كاتب موهوب / تَعَدُّدُ الأَزْوَاج",
 "たさいぼう": "مُتَعَدِّد الخَلَايَا (يتكوّن من خلايا عديدة)",
 "たさく": "غَزِير النَّسْل, وَلُود (يُنْجِبُ بِوَفْرَة، خَاصَّةً فِيمَا يَتَعَلَّقُ بِالذُّرِّيَّة) / خَصْب الذِّهْن, غَزِير الإِنْتَاج (منتج فكريًّا بغزارة)",
 "たさつ": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "たさん": "إِثْمَار, خُصُوبَة (صفة الشيء الذي يسبب أو يساعد على النمو الصحي) / خصوبة فكرية, غزارة الإنتاج (الإنتاجية الفكرية للمخيلة المبدعة) / خصوبة (حالة كون الكائن خصباً؛ قادراً على إنتاج النسل)",
 "たざんのいし": "عِبْرَة, مِثَال رَادِع (عقوبة يقصد بها أن تكون تحذيراً للآخرين)\nمثال: قرروا أن يجعلوه عبرة",
 "たし": "ملحق / مُكَمِّل / كَثْرَة اَلْأَصَابِع",
 "たしか": "أَكِيد / مُتَأَكِّد / طَبْعًا, أَكِيد / مَوْثُوق",
 "たしかなものにする": "قَوَّى, عَزَّزَ",
 "たしかに": "بِالتَّأْكِيد",
 "たしかめ": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "たしかめる": "تَأَكَّدَ",
 "たしからしい": "رَاجِح, مُحْتَمَل (يُرَجَّح حُدوثُه أَوْ وُقوعُه) / محتمل, مرجح (مرجح ولكن ليس مؤكداً أن يكون حقيقياً أو واقعياً) / مرشح مرجح (متقدم من المرجح أن يتم اختياره)\nمثال: نتيجة محتملة",
 "たしからしさ": "أَرْجَحِيَّة, احْتِمَالِيَّة (صفة كون الشيء محتملاً؛ حدث محتمل أو الحدث الأكثر احتمالاً) / احتمال, فرصة (مقياس لمدى احتمالية وقوع حدث ما؛ رقم يعبر عن نسبة الحالات المواتية إلى العدد الكلي للحالات الممكنة)\nمثال: لفترة من الوقت بدا التمرد احتمالاً وارداً",
 "たしけし": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب."
}
