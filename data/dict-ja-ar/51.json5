 "闇々のうちに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "闇ブローカー": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇ルート": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇値": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇取り引き": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇取引": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇商人": "تاجر سوق سوداء (شخص يشارك بشكل غير قانوني في تجارة السلع النادرة أو الخاضعة للرقابة)",
 "闇夜の灯火": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "闇夜の礫": "لعب النرد (لعب الكرابس)\nمثال: أصبح القبول في الكلية التي تختارها مجازفة غير مضمونة",
 "闇夜の鉄砲": "لعب النرد (لعب الكرابس)\nمثال: أصبح القبول في الكلية التي تختارها مجازفة غير مضمونة",
 "闇将軍": "صانع الملوك (شخص مهم يمكنه إيصال القادة إلى السلطة من خلال ممارسة النفوذ السياسي)\nمثال: كان إيرل وارويك أول صانع للملوك",
 "闇屋": "تاجر سوق سوداء (شخص يشارك بشكل غير قانوني في تجارة السلع النادرة أو الخاضعة للرقابة)",
 "闇市": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "闇市場": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "闇然": "غَامِق, دَاكِن / أَسِيف, حَزِين (مليء بالحزن أو يثيره)",
 "闇物資": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇相場": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇穴": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "闇米": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇者": "دَاعِرَة, بَغِيَّة / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "闇討": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "闇討ち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "闇金": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇金融": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "闇闇": "بِسُهُولَة / غَامِق, دَاكِن",
 "闇闇のうちに": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "闇雲": "مُتَهَوِّر",
 "闊歩": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً'))\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "闊葉樹": "عَرِيض الأَوْرَاق (ذو أوراق عريضة نسبياً بدلاً من الإبرية أو الحرشفية)",
 "闊達": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك)\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "闊達自在": "مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك)\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "闋": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "闌れる": "صَعَقَ",
 "闌干": "درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / بتألق, بسطوع\nمثال: تألقت النجوم بسطوع / إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها",
 "闕ける": "تفتيت, شطف (عملية شطف جزء من شيء ما) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "闕下": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "闕所": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية",
 "闕文": "كِتَابَة, مَادَّة مَكْتُوبَة (عمل الكاتب؛ أيّ شيء يُعبَّر عنه بحروف الأبجديّة)",
 "闕望": "خَيْبَة أَمَل",
 "闖入": "تَطَفُّل, مُدَاخَلَة",
 "闖入者": "مُقْتَحِم, دَخِيل",
 "闘い": "مَعْرَكَة / عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / مُسَابَقَة",
 "闘う": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / تَنَافَسَ, تَبَارَى / كِفَاح, نِضَال",
 "闘わす": "تَنَافَسَ, تَبَارَى / مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "闘争": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / كِفَاح, نِضَال",
 "闘争心": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
 "闘場": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "闘士": "مُبَارِز, مُقَاتِل",
 "闘志": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء.",
 "闘技": "مُنَافَسَة, مُبَارَاة",
 "闘技場": "صَالَة, حَلْبَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ…)\nمثال: حجزت الصالة يوم الخميس.",
 "闘牛": "مُصَارَعَة ثِيرَانٍ",
 "闘牛場": "حلبة مصارعة الثيران (ملعب تقام فيه مصارعة الثيران)",
 "闘牛士": "مُصارِع ثِيرَانٍ, مُصَارِعَة ثِيرانٍ (مَن يقوم بالمُصارعة؛ محترف المُصارعة)",
 "闘犬": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة))\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "闘球": "رَغْبِي, رَجْبِي",
 "闘諍": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء.",
 "闘鶏": "مصارعة الديوك",
 "關": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "闡明": "تَوْضِيح",
 "闥": "بَوَّابَة",
 "阜": "بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها)\nمثال: لعب في كل مركز باستثناء الرامي",
 "阡": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن…)\nمثال: ألف شكر على لطفك.",
 "阪": "مُنْحَدَر / حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات) / أُوسَاكَا",
 "阪元": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "阪口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "阪本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "阪田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "阪路": "منحدر (سطح مائل يربط بين مستويين)",
 "防ぎ": "دِفَاع, حِمَايَة",
 "防ぎ止める": "مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "防ぐ": "مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "防備": "دِفَاع, حِمَايَة",
 "防具": "حَارِس\nمثال: كان لدى سامي حرس شخصي.",
 "防塁": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "防塞": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "防壁": "حَاجِز",
 "防寒帽": "قبعة بحرية صوفية (قبعة صوفية زرقاء داكنة محبوكة يرتديها البحارة في الطقس البارد أو العاصف)",
 "防寨": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "防弾": "مُضَادّ لِلرَّصَاص, وَاقٍ مِن الرَّصَاص (لا تخترقه الرصاصات)",
 "防弾チョッキ": "صَدْرِيَّة ضِدَّ الرَّصَاص, سُتْرَة وَاقِيَة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي…)",
 "防弾ベスト": "صَدْرِيَّة ضِدَّ الرَّصَاص, سُتْرَة وَاقِيَة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي…)",
 "防御": "دِفَاع, حِمَايَة",
 "防御率": "معدل الركض المكتسب ((بيسبول) مقياس لفعالية الرامي)",
 "防撓材": "دعك, مادة مقوية (مادة تستخدم لتصلب شيء ما)",
 "防材": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "防染糊": "طَارِد, مُقَاوِم (غير قادر على الامتصاص أو الاختلاط)",
 "防止": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "防止剤": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "防毒マスク": "قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "防毒面": "قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "防水": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "防水シート": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "防水ズボン": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "防水加工": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "防水帆布": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "防水長靴": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "防汚塗料": "طلاء مانع للحشف (طلاء يستخدم للحماية من تراكم البرنقيل وما إلى ذلك على الأسطح المغمورة تحت الماء)",
 "防波堤": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ) / حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "防波壁": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "防浸": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "防湿剤": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "防潮堤": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "防火": "إدارة النيران, التحكم في الرمي (التحضير لإيصال القذائف إلى الهدف)",
 "防火塗料": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "防火壁": "جِدَار ناريّ, فَايْرْوُول",
 "防火戸": "باب حريق (باب مقاوم للحريق يمكن إغلاقه لوقف انتشار الحريق)",
 "防火扉": "باب حريق (باب مقاوم للحريق يمكن إغلاقه لوقف انتشار الحريق)",
 "防火線": "خط النار, مانع النار (حقل ضيق تم تنظيفه للحد من انتشار حرائق البراري أو الغابات)",
 "防火訓練": "تدريب إخلاء, مناورة حريق (تمرين يهدف إلى تدريب الناس على الواجبات وإجراءات الهروب الواجب اتباعها في حالة…)",
 "防燃": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "防犯": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "防犯システム": "نظام أمان (جهاز كهربائي يطلق إنذاراً عندما يحاول شخص ما الاقتحام)",
