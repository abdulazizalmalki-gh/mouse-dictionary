 "金印": "الجذر الأصفر, خاتم الذهب (عشب معمر في شمال شرق الولايات المتحدة له ساق جذري أصفر سميك وعقدي وأوراق…)",
 "金原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "金口": "ذَهَبِيّ اللَّوْن (ذو لون الذَّهب)",
 "金味": "فلزي, معدني (يحتوي على معدن أو مصنوع منه أو يشبهه أو يتسم بخصائصه)\nمثال: مركب معدني / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة…)\nمثال: لن نصل إلى أي مكان.",
 "金員": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "金器": "طلاء بالذهب (طبقة رقيقة من الذهب على شيء ما)",
 "金土竜": "خلد ذهبي (خلد من جنوب أفريقيا ذو شعر حماية قزحي اللون مختلط بالفراء السفلي)",
 "金坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "金坑": "منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "金型": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / قَالِب\nمثال: هم في نفس السن.",
 "金城": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "金城鉄壁": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "金壺眼": "سكاد كبير العين (من المياه الساحلية الأطلسية؛ تستخدم عادة كطعم)",
 "金太郎あめ": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "金太郎アメ": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "金太郎飴": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
