 "開き口": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة)",
 "開き戸": "أَبْوَاب, بَاب",
 "開き癖": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة)",
 "開く": "مَفْتُوح\nمثال: فتح الباب آليا. / إزهار, تزهير (رواسب مسحوقية على سطح ما)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور / مَسَكَ, مسك / أَسَّسَ",
 "開け": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل…)\nمثال: الحضارة الامازيغية عظيمة.",
 "開けた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "開けっぴろげ": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / إِفْرَنْجِيّ",
 "開けっ広げ": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / إِفْرَنْجِيّ",
 "開けっ放し": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "開ける": "مَفْتُوح\nمثال: فتح الباب آليا. / فَارِغ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة. / تَفَرَّقَ (تفرق الشَّيْء تفَرقا وتفراقا تبدد وَالرجلَانِ ذهب كل مِنْهُمَا فِي طَرِيق…)\nمثال: أتستطيع أن تفرق توم من أخيه؟ / حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / طَوَّرَ / مَفْتُوح\nمثال: فتح الباب آليا. / مَفْتُوح\nمثال: فتح الباب آليا. / تَمَدَّدَ",
 "開け口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開け広げ": "غَيْر مُتَيَقِّظ, مَكْشُوف (لا يُبدي أيّ حذر أو احتراس)",
 "開け払う": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "開け放し": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "開催": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما)\nمثال: تلك القبعة ملكي",
 "開催中": "قَيْد التَّنْفِيذ, قَيْد الحَرَكَة (في حالة حركة؛ بدأ في التحرك)\nمثال: تحركت السفينة",
 "開催地": "دائرة الاختصاص المكاني, مكان الانعقاد (في القانون: الولاية القضائية التي ستُعقد فيها المحاكمة)",
 "開催日": "تَمْرَة, تَمْر\nمثال: ما تاريخ اليوم؟",
 "開先": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه)\nمثال: وقعوا في روتين محادثة ممل",
 "開削": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "開創器": "مبعد (أداة جراحية تمسك حواف الشق الجراحي للخلف)",
 "開化": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل…)\nمثال: الحضارة الامازيغية عظيمة.",
 "開区間": "فترة مفتوحة (فترة لا تتضمن نقطتي نهايتها)",
 "開口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / مَفْتُوح\nمثال: فتح الباب آليا.",
 "開口一番": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "開口部": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة)",
 "開回路": "دائرة مفتوحة (دائرة كهربائية غير مكتملة لا يتدفق فيها تيار)",
 "開基": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ / قَاعِدَة",
 "開場": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / تَنْصِيب",
 "開墾": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل)",
 "開墾地": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "開始": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "開始価格": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "開始時刻": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "開室": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開封": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開局": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開帳": "إِظْهَار, عَرْض / فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا)\nمثال: نظرة كاشفة / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開幕": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開幕戦": "فَتَّاحَة, مِفَكّ (التي تكثر الفَتْح)",
 "開度": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "開廷": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "開張": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي)",
 "開心術": "جراحة القلب المفتوح (جراحة قلب يتم فيها فتح القفص الصدري، وإيقاف القلب، وتحويل الدم عبر جهاز القلب…)",
 "開悟": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
