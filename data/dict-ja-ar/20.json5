 "クオータリー": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر) / في أرباع الشعار (في أرباع متقابلة قطرياً من الشعار (في علم الشعارات)) / ربع سنوي (من أو يتعلق بربع (فترة زمنية) أو يتكون منه) / ربع سنوية, فصلية (دورية تصدر كل ربع سنة (أو أربعة أعداد في السنة))\nمثال: الفائدة مركبة ربع سنوياً",
 "クオーター": "رُبُع (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه) / حَارَة\nمثال: الساعة السادسة و الربع مساء.",
 "クオーターバック": "ظهير ربعي, كوارترباك ((كرة قدم أمريكية) مركز لاعب كرة القدم في الخلفية الذي يوجه اللعب الهجومي لفريقه) / ظهير ربعي, كوارترباك ((في كرة القدم الأمريكية) الشخص الذي يلعب في مركز الظهير الربعى ويقود الهجوم)\nمثال: الكوارترباك هو أهم مركز في الفريق",
 "クオーターマスター": "ضابط التموين, مسؤول الإمداد والتموين (ضابط جيش يوفر الملابس والإعاشة للقوات)",
 "クオーツ": "مَرْو, كَوَارْتْز",
 "クオーテーション": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "クオーテーションマーク": "عَلَامَات اِقْتِبَاس",
 "クオーテーション・マーク": "عَلَامَات اِقْتِبَاس",
 "クオート": "رُبَع غَالُون (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه)\nمثال: الساعة السادسة و الربع مساء. / اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ. / قطع ربعي (حجم كتاب تُصنع صفحاته بطي ورقة مرتين لتكوين أربع ورقات)",
 "クギ": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "クギづけ": "مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "ククク": "قَرْقَرَة, مُنَاغَاة / هَدَلَ",
 "ククリ": "كُوكْرِي",
 "ククー": "وَقْوَاق, وَقْوَاقِيَّة",
 "クサイ": "كْسِي (لَبِسَ الثوب، اِكْتَسَى به؛ اِكْتَسَى)",
 "クサカゲロウ": "شبكية الأجنحة الخضراء (ذبابة شبكية الأجنحة خضراء شاحبة كريهة الرائحة لها يرقات آكلة للحوم)",
 "クサソテツ": "رأس الكمان, سرخس النعامة (سرخس طويل من المناطق المعتدلة الشمالية له سعف مقوس رشيق وأبواغ تشبه ريش النعام)",
 "クサビ": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "クサフジ": "بيقية الطيور, بيقية معنقدة (متسلق معمر شائع في المناطق المعتدلة من أوراسيا وأمريكا الشمالية له عناقيد طويلة كثيفة من الزهور)",
 "クサボケ": "سفرجل مزهر, سفرجل ياباني (شجيرة زينة آسيوية ذات فروع شائكة وأزهار وردية أو حمراء)",
 "クサリヘビ": "أَفْعًى",
 "クサレ": "تحلل, تعفن ((في البيولوجيا) عملية التحلل الناجمة عن الفعل البكتيري أو الفطري) / فَاسِد",
 "クサレダマ": "ليسيماكيا الحدائق, ليسيماكيا صفراء (تعتبر في كثير من الأحيان عشبة ضارة؛ أوروبا وآسيا)",
 "クシ": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "クシェット": "كوشيت, مقصورة نوم (مقصورة في قطار ركاب أوروبي؛ تحتوي على 4 إلى 6 أسرّة للنوم) / سرير مقصورة, كوشيت (مضجع للنوم في مقصورة قطار مجهزة بأسرة (كوشيت))",
 "クシクラゲ": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "クシクラゲるい": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "クシクラゲ類": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "クシャっと": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "クシャクシャ": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج) / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "クシャッと": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "クシャトリヤ": "كشاتريا (عضو في الطبقة الهندوسية الملكية أو المحاربة)",
 "クシャミ": "عَطَسَ / عُطَاس, عَطْسَة",
 "クシー": "كْسِي (لَبِسَ الثوب، اِكْتَسَى به؛ اِكْتَسَى)",
 "クシ目": "تسريح, تمشيط (فعل تمرير المشط خلال الشعر)\nمثال: كان شعره بحاجة إلى تمشيط",
 "クジ": "يَانَصِيب",
 "クジャク": "طَاوُوس",
 "クジャクソウ": "آذَرْيُون, كَحْلَاء / قَطِيفَة, آذَرْيُون",
 "クジャクチョウ": "فراشة الطاووس (فراشة أوروبية لها أجنحة بنية محمرة كل منها معلم ببقعة عينية أرجوانية)",
 "クジラ": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "クジラ漁": "صَيْد اَلْحِيتَان",
 "クス": "شجرة الكافور (شجرة كبيرة دائمة الخضرة في المناطق الدافئة ينتج خشبها العطري الكافور)",
 "クスクス": "كُسْكُس / إِهْلَاس / كسكس (جرابي شجري يشبه القرد ذو شعر صوفي من غينيا الجديدة وشمال أستراليا)",
 "クスクスわらう": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "クスクス笑う": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "クスッと": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "クスノキ": "شجرة الكافور (شجرة كبيرة دائمة الخضرة في المناطق الدافئة ينتج خشبها العطري الكافور)",
 "クスリ": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب. / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة) / مُخَدِّر / عَقَّار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "クスン": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "クズ": "كودزو (كرمة سريعة النمو من شرق آسيا لها جذور نشوية درنية وأوراق ثلاثية مشعرة وعناقيد من الزهور الأرجوانية تليها قرون مشعرة طويلة تحتوي على العديد من البذور؛…) / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / رغوة شوائب, زَبَد (طبقة من الشوائب أو النباتات التي يمكن أن تتشكل على سطح السائل) / أراذل, حثالة (أشخاص عديمو القيمة)",
 "クズいれ": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "クズてつ": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "クズアナゴ": "بَطِّيّ المِنْقَار (ذو منقار يشبه منقار البطة)",
 "クズイモ": "فاصوليا اليام, هيكاما (نبات ملتف من أمريكا الوسطى بجذور وقرون صالحة للأكل؛ تؤكل الدرنات الكبيرة نيئة أو مطبوخة خاصة عندما تكون صغيرة ويجب طهي القرون الصغيرة جيداً؛ تنتج…) / فاصوليا البطاطس, فاصوليا اليام (نبات ملتف في حوض الأمازون له جذور كبيرة صالحة للأكل)",
 "クズウコン": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت) / أروروت, أروروت أمريكي (نبات أبيض الزهر من جزر الهند الغربية ينتج جذره نشا الأروروت) / أروروت (نشا مغذٍ يتم الحصول عليه من جذر نبات الأروروت)",
 "クズカゴ": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "クズリ": "شَرِه, وُلْفِيرِين ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "クズ入れ": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "クズ肉": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "クズ鉄": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "クセ": "عَادَة / تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / خاصية, سمة مميزة (سمة مميزة) / خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية) / خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "クセだま": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "クセに": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "クセノン": "إِكْسِينُون, زِينُون",
 "クセモノ": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "クセ球": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "クソ": "لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة / بِرَاز, سَلْح / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "クソあま": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "クソどきょう": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "クソばばあ": "عَجُوز",
 "クソばばー": "عَجُوز",
 "クソほど": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "クソまじめ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "クソアマ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "クソガキ": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
