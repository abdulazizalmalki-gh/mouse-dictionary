 "口を封じる": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "口を尖らす": "بوّز, بَرطَمَ",
 "口を尖らせる": "بوّز, بَرطَمَ",
 "口を掛ける": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "口を添える": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "口ゲンカ": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口マネ": "مُشَاكهَة",
 "口上": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "口争い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口付き": "فَم, بق / مَبْسَم",
 "口付け": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口付ける": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口元": "فَم, بق",
 "口元が緩む": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "口先": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / شَفَة, شفة",
 "口先だけ": "فَارِغ / فَرَغَ",
 "口入れ人": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "口入れ屋": "وَكَالَة تَوْظِيف",
 "口入屋": "وَكَالَة تَوْظِيف",
 "口八丁": "فَصِيح, فُصْحَى",
 "口内": "فَمَوِيّ / شَفَهِيّ / شَفَوِيّ / مَنْطُوق",
 "口内性交": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "口出し": "تَدَاخُل",
 "口切り": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "口利き": "تَدَخُّل, تَطَفُّل / بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口前": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "口取": "سَائِس / هَندَم / مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "口取り": "سَائِس / هَندَم / مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "口可笑": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "口吸い": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口吻": "شَفَة, شفة",
 "口吻をもらす": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "口吻を洩らす": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "口吻を漏らす": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "口味": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "口唇": "شَفَة, شفة",
 "口喧しい": "النقد / ثَرْثَار",
 "口喧嘩": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口回し": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "口外": "كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد.",
 "口実": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "口寄": "قَنَاة",
 "口寄せ": "قَنَاة",
 "口封じ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "口小言": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "口峡炎": "اِلْتِهَاب حَلْق",
 "口幅ったい": "مَغْرُور, مُتَعَصِّب",
 "口座": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "口弁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口当たり": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "口径": "أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "口忠実": "ثَرْثَار",
 "口惜しい": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "口才": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口承文芸": "فُولْكْلُور, فُولْكُلُور",
 "口抜き": "بَرِّيمة",
 "口拭き": "مَنْدِيل, مَنْدِيل مَائِدَة",
 "口数": "سُكَّان / سُكَّانِيَّة",
 "口数が多い": "ثَرْثَار",
 "口数の多い": "ثَرْثَار",
 "口早": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "口明け": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "口書": "مُقَدِّمَة",
 "口書き": "مُقَدِّمَة",
 "口枷": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "口止め": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "口気": "بَخَر ((الْبَخَرُ) بِفَتْحَتَيْنِ نَتَنُ الْفَمِ فَهُوَ (أَبْخَرُ))",
 "口汚い": "بَذِيء اللِّسَان / طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "口淫": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "口添え": "تَوْصِيَة",
 "口渇": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش.",
 "口火": "فَتِيل / مُنْصَهِرَة, مصهر / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "口煩い": "شَبُّوط",
 "口癖": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "口真似": "مُشَاكهَة",
 "口碑": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "口端": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "口笛": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "口笛を吹く": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "口篭もる": "غَمْغَمَة",
 "口篭る": "غَمْغَمَة",
 "口籠もる": "غَمْغَمَة",
 "口籠る": "غَمْغَمَة",
 "口糧": "حِصَّة / قَنَّنَ (قلل الكمية واقتصد بها؛ وضع الشيء في قَنَانِي)",
 "口紅": "أَحْمَر شِفَاه (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "口綺麗": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "口腔": "فَم, بق",
 "口腔カンジダ症": "داء المبيضات الفموي",
 "口腔乾燥症": "جفاف الحلق",
 "口腔性交": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "口腔衛生": "صِحَّة الفَمّ (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "口腹": "شَهِيَّة",
 "口臭": "بَخَر ((الْبَخَرُ) بِفَتْحَتَيْنِ نَتَنُ الْفَمِ فَهُوَ (أَبْخَرُ))",
 "口舌": "هَذَى",
 "口舌の争い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口荒く": "بِعُنْف",
 "口蓋": "حَنَك ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "口蓋垂": "لَهَاة",
 "口蓋垂音": "لَهَوِيّ",
 "口蓋音": "غَارِيّ",
 "口角を上げる": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "口触り": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "口言葉": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "口許": "فَم, بق",
 "口詞": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "口語表現": "عَامِّيَّة, دَارِجَة",
 "口誦": "تِلَاوَة",
 "口説": "هَذَى",
 "口説き": "رَجَا (رَجَا يرْجُو رَجْوًا ورَجاءً ورَجاةً ورَجاءةً ورَجاوةً ومَرْجاةً: رجاه أملًا به؛ ورَجَاه: ناشده وتوسّل إليه)",
 "口説き文句": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "口説き落す": "أَقْنَعَ",
 "口説き落とす": "أَقْنَعَ",
 "口説く": "أَقْنَعَ / أَغْرَى, أَغْوَى",
 "口調": "نَغْمَة, نَغْم",
 "口論": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口蹄疫": "حَمَّى قُلَاعِيَّة (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "口車に乗る": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "口軽": "ثَرْثَار",
 "口輪": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "口辯": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口述": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب)",
 "口過ぎ": "مَعِيشَة, مَعَاش",
 "口達者": "فَصِيح, فُصْحَى",
 "口部分": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "口重": "حَرِيص, حَكِيم / حَرِيص",
 "口重い": "حَرِيص, حَكِيم / حَرِيص",
 "口金": "قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / مَبْسَم / مَقْبِس",
 "口銭": "عُمُولَة",
 "口開け": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "口頭": "فَمَوِيّ / شَفَهِيّ / شَفَوِيّ / مَنْطُوق",
 "口頭試問": "مُقَابَلَة",
 "口髭": "شَارِب",
 "古": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "古い": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة. / طَوِيل / ثَقِيل الظَِلّ, سَخِيف",
 "古き": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "古き良き時代": "الزَّمَن الجَمِيل",
 "古く": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "古だぬき": "مُحَارِب قَدِيم",
 "古ぼけた": "بَالٍ",
 "古る": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "古事": "تَقْلِيد",
 "古代": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "古代エジプト": "مِصْر اَلْقَدِيمَة (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "古代ギリシア": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "古代ギリシア語": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古代ギリシャ": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "古代ギリシャ語": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古代ローマ": "رُومَا الْقَدِيمَة (ولاية إيطالية؛ مدينة هي عاصمة ولاية روما الإيطالية)\nمثال: روما مدينة قديمة.",
 "古伝": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "古例": "تَقْلِيد",
