 "グシャっと": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "グシャグシャ": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / عَجينِيّ, غَيْر مُخْتَمِر (ذو قِوام العَجين بِسَبَب قِلَّة التَّخْمير أو سوء الطَّبْخ) / مُسْتَنْقَعِيّ, وَحِل ((عن التربة) ليّنة ومشبَعة بالماء) / مَكْسُور, مُذَلَّل (خاضع أو مُنزَل إلى حالة أو مكانة متدنّية) / مَهْرُوس, مُجَعَّد (مضغوط أو مجعّد السطح) / فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "グシャッと": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "グショグショ": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً",
 "グジ": "تايلفيش (سمكة غذائية بنفسجية مرقطة بالأصفر تعيش في المياه العميقة الدافئة) / بلانكيلو (أسماك غذائية بحرية مهمة)",
 "グジャラートご": "اللُّغَة الْكُجَرَاتِيَّة, الْكُجَرَاتِيَّة",
 "グジャラート語": "اللُّغَة الْكُجَرَاتِيَّة, الْكُجَرَاتِيَّة",
 "グスグス": "شَهَّاق, نَشَّاج (يميل إلى الشهقة والنشيج من البكاء)",
 "グスベリー": "عِنَب الثَعْلَب",
 "グスン": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "グズ": "ثقيل الظل, شخص ممل (شخص يبعث على الملل) / أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "グズグズ": "بِبُطْء / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ) / غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد) / غير مستقر (غير مستقر أو مؤسس) / غير محسوم, معلق (لا يزال موضع شك) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: نمط حياة غير مستقر / فَضْفَاض, واسِع",
 "グタグタ": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل / باسترخاء, بكسل (بطريقة خاملة) / بكسل (بطريقة بطيئة وكسولة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "グタリ": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "グダグダ": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل / باسترخاء, بكسل (بطريقة خاملة) / بكسل (بطريقة بطيئة وكسولة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "グチ": "قَمْقَمَ",
 "グチっぽい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "グチる": "قَمْقَمَ",
 "グチグチ": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام)",
 "グチャグチャ": "طَرِيّ, لُبِّيّ (يُشْبِهُ اللُّبَّ أَوِ الثَّمَرَ المُفْرِطَ النُّضْجِ؛ لَا يَتَّسِمُ بِالصَّلَابَةِ) / غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / مُفْرِطُ العَاطِفَة (عاطفيّ بشكل مُفرط أو غير طبيعي) / فَضْفَاض, وَاسِع (غَيْر مُحْكَم؛ يَتَدَلَّى بِشَكْل فَضْفاض) / مُبَعْثَر (يَفْتَقِرُ إِلَى التَّرْتِيبِ وَالنِّظَام)",
 "グチョグチョ": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً",
 "グッと": "فَجْأَةً / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم / تَمَامًا",
 "グッスリ": "بشكل جيد, بقوة (كلياً وبالكامل) / بثقل, بعمق (بعمق أو بشكل كامل)\nمثال: هُزم شر هزيمة",
 "グッズ": "بَضَائِع, سِلَع",
 "グッタペルカ": "جتا بركا (مطاط مبيض مشتق من اللاتكس الحليبي المتخثر لأشجار الجتا بركا؛ يستخدم لعزل الكابلات الكهربائية)",
 "グッタリ": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة",
 "グッツ": "بَضَائِع, سِلَع",
 "グット": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "グットイブニング": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "グットタイミング": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
