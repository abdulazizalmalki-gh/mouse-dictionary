 "オール・オア・ナッシング": "كُلٌّ أَوْ لَا شَيْء (يحدث بالكامل أو لا يحدث على الإطلاق)",
 "オーレオマイシン": "أوريوميسين, كلورتيتراسايكلين (مضاد حيوي بلوري أصفر (الاسم التجاري أوريوميسين) يستخدم لعلاج بعض الأمراض البكتيرية والريكتسية)",
 "オーロックス": "أُرْخُص (أَرْخَصَ السِّعرَ: جعله رخيصًا؛ وأَرْخَصَ الشيءَ: وجده رخيصًا أو اشتراه رخيصًا)\nمثال: أظنني سأشتري الأرخص.",
 "オーロラ": "شَفَق قُطْبِيّ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "オーロラのかなたへ": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "オーロン": "أورلون (ألياف أكريليك أو القماش الخفيف الوزن المقاوم للتجاعيد المصنوع من خيوط الأورلون)",
 "オーヴン": "فُرْن, تَنُّور",
 "オー・エイチ": "إعادة تأهيل, تجديد (فعل التحسين عن طريق التجديد والاستعادة) / عمرة, فحص وإصلاح شامل (صيانة دورية لسيارة أو آلة)\nمثال: إنهم يتابعون برنامجاً عاماً لتجديد العقار بأكمله",
 "オー・エス": "نِظَام تَشْغِيل (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "オー・エス・エス": "مَفْتُوح الْمَصْدَرِ",
 "オー・エル": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / مِلَاحَة",
 "オー・エル・イー・ディー": "صمام ثنائي عضوي باعث للضوء (صمام ثنائي ذاتي الإضاءة (يتوهج عند تطبيق مجال كهربائي على الأقطاب) لا يتطلب إضاءة خلفية أو ناشرات)",
 "オー・ジェー・ティー": "أثناء العمل, وظيفي (متعلق بـ أو مرتبط بوظيفة أو توظيف)\nمثال: تدريب أثناء العمل",
 "オー・ジー": "خريجة (شخص أنثى حصلت على درجة علمية من مدرسة (ثانوية أو كلية أو جامعة))",
 "オー・ティー": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / اَلْعَهْد اَلْقَدِيم",
 "オー・ティー・シー": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "オー・ディー": "جُرْعَة زَائِدَة / عين يمنى (العين اليمنى) / دكتوراه في البصريات (درجة الدكتوراه في البصريات) / سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "オー・デ・コロン": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "オー・ド・コロン": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "オー・ド・トワレ": "ماء تواليت (سائل معطر أخف تركيزاً من الكولونيا)",
 "オー・ビー": "عجوز نشيط (رجل مسن مفعم بالحيوية) / خريج قديم (تلميذ سابق لمدرسة) / صديق قديم (مصطلح مألوف لمخاطبة رجل) / خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "オー・ピー": "شارة مُوسِيقِيّة / طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "オー・ペア": "أو بير, جليس أطفال أجنبي (شاب أجنبي يعيش مع عائلة مقابل القيام بأعمال منزلية خفيفة)",
 "オー・マイ・ガッ": "يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "オー・マイ・ガー": "يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "オー・マイ・ゴッド": "يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "カ": "بَعُوضَة, نَامُوسَة",
 "カアバ": "الْكَعْبَة, الْكَعْبَةُ ٱلْمُشَرَّفَة ((في الإسلام) قبلة المسلمين في صلواتهم؛ موقعها في المسجد الحرام في مكة، وهي أقدس شعائر الإسلام)\nمثال: الكعبة بيت الله.",
 "カイ": "خِي / تْشِي, كِي",
 "カイアシるい": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها وفير في العوالق والبعض الآخر طفيلي على الأسماك)",
 "カイアシ類": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها وفير في العوالق والبعض الآخر طفيلي على الأسماك)",
 "カイウ": "زنبق الكالا, كالا (نبات من جنوب إفريقيا يزرع على نطاق واسع لقنابته البيضاء النقية البارزة وطلعه الأصفر)",
 "カイエンヌ": "كَايِين",
 "カイエンヌペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "カイエンヌ・ペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "カイエンペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "カイエン・ペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "カイカイデ": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "カイカイデー": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "カイガラムシ": "حشرة قشرية (حشرة صغيرة من رتبة متشابهات الأجنحة تعيش وتتغذى عادة على النباتات وتفرز غطاء شمعياً واقياً)",
 "カイギュウ": "بقر البحر (أي من فصيلتين من الثدييات المائية العاشبة الكبيرة ذات ذيول مجدافية الشكل وأطراف أمامية تشبه الزعانف ولا أطراف خلفية)",
 "カイコ": "دُودَة اَلْقَزّ",
 "カイコガ": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير) / عثة دودة القز العملاقة (أي عثة دودة قز من فصيلة ساتورنيداي)",
 "カイザー": "قَيْصَر",
 "カイザーロール": "خبز كايزر, لفافة القيصر (لفافة مستديرة مخمرة تعلوها بذور الخشخاش مصنوعة من قطعة مربعة من العجين بطي الزوايا إلى المركز)",
 "カイザー・ロール": "خبز كايزر, لفافة القيصر (لفافة مستديرة مخمرة تعلوها بذور الخشخاش مصنوعة من قطعة مربعة من العجين بطي الزوايا إلى المركز)",
 "カイゼル": "قَيْصَر",
 "カイソウ": "إشْقِيل, بَصَل الفَأْر",
 "カイチュウ": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة ولكن بعضها طفيلي)",
 "カイツブリ": "غطاس صغير (غطاس أوروبي صغير) / غطاس (طائر مائي صغير مدمج الجسم بالكامل تقريباً يبني أعشاشاً عائمة؛ يشبه الغواص ولكنه أصغر وله أقدام مفصصة بدلاً من مكففة)",
 "カイト": "طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "カイドウ": "تفاح سيبيري بري (تفاح بري آسيوي يزرع في العديد من الأصناف لفاكهته الحمراء الصغيرة الحمضية عادة المستخدمة للحفظ)",
 "カイパーベルト": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "カイパー・ベルト": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "カイマン": "كَيَامِن, كَيْمَن",
 "カイモグラフ": "راسم التموج, كيموجراف (أداة علمية تتكون من أسطوانة دوارة تحمل ورقاً يتتبع عليه قلم تسجيلاً مستمراً (مثل التنفس أو ضغط الدم))",
 "カイリ": "مِيل بَحْرِيّ",
 "カイリックス": "كيليكس",
 "カイロ": "الْقَاهِرَة (مدينة تقع في مِصر، وهي عاصمتها وأكبر مدنها؛ جمهورية القاهرة، وهي الجمهورية التي تقع فيها المدينة)\nمثال: أسكن في القاهرة.",
 "カイロウドウケツ": "سلة زهرة فينوس (إسفنج بحري في المياه العميقة له هيكل أسطواني من شبكة زجاجية معقدة)",
 "カイロテック": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل الظهر أو حتى الصداع أو ارتفاع ضغط الدم)",
 "カイロプラクター": "مُقَوِّم اَلْعِظَام",
 "カイロプラクチック": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل الظهر أو حتى الصداع أو ارتفاع ضغط الدم)",
 "カイロプラクティック": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل الظهر أو حتى الصداع أو ارتفاع ضغط الدم)",
 "カイロプラター": "مُقَوِّم اَلْعِظَام",
 "カインド": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "カウ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "カウチ": "فِرَاش, أَرِيكَة",
 "カウチポテト": "خَامِل",
 "カウチ・ポテト": "خَامِل",
 "カウハイド": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر) / جلد البقر (إهاب البقرة) / جلد بقري (جلد مصنوع من إهاب البقرة)",
 "カウパー": "مَذْي",
 "カウパーえき": "مَذْي",
 "カウパーせん": "غُدَّة كَوْبَر",
 "カウパーせんえき": "مَذْي",
 "カウパー液": "مَذْي",
 "カウパー腺": "غُدَّة كَوْبَر",
 "カウパー腺液": "مَذْي",
 "カウベル": "جرس البقر (جرس يعلق حول رقبة البقرة بحيث يمكن تحديد مكانها بسهولة)",
 "カウボーイ": "رَاعِي بَقَر, رَعَوِيّ الْبَقَر",
 "カウボーイハット": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "カウボーイブーツ": "حذاء رعاة البقر (حذاء ذو قوس مرتفع وخياطة مزخرفة؛ يرتديه رعاة البقر الأمريكيون)",
 "カウボーイ・ハット": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "カウボーイ・ブーツ": "حذاء رعاة البقر (حذاء ذو قوس مرتفع وخياطة مزخرفة؛ يرتديه رعاة البقر الأمريكيون)",
 "カウリング": "غطاء المحرك (غطاء واقٍ يتكون من جزء معدني يغطي المحرك)\nمثال: توجد محركات قوية تحت أغطية السيارات الجديدة",
 "カウル": "قلنسوة الراهب (غطاء رأس فضفاض أو رداء بغطاء رأس (كما يرتديه الراهب)) / غطاء المحرك (غطاء واقٍ يتكون من جزء معدني يغطي المحرك)\nمثال: توجد محركات قوية تحت أغطية السيارات الجديدة",
 "カウンシル": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "カウンセラー": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة) / مرشد, ناصح (شخص يقدم المشورة بشأن المشكلات) / مشرف مخيم (شخص لديه واجبات إشرافية في مخيم صيفي)",
 "カウンセリング": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل)",
 "カウンタ": "عَدَّاد / هُجُوم مُضَادّ",
 "カウンター": "عَدَّاد / هُجُوم مُضَادّ",
 "カウンターインテリジェンス": "مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات الاستخبارات المعادية أو الأفراد المنخرطون في التجسس أو التخريب أو التخريب…)",
 "カウンターウェイト": "ثقل موازن (وزن يوازن وزناً آخر)",
 "カウンターウエイト": "ثقل موازن (وزن يوازن وزناً آخر)",
 "カウンターオファー": "عَرْض مُضَادّ, عَرْض مُقَابِل (عرض يقدمه شخص رفض عرضاً سابقاً)",
 "カウンターカルチャー": "ثقافة مضادة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "カウンターテナー": "كَاونْتِر تِينُور (أعلى صوت ذكوريّ؛ ذو مدى فوق طبقة التينور) / كونترتينور (أعلى صوت غنائي للذكور البالغين) / كونتر تينور (مغنٍ ذكر بصوت أعلى من التينور)",
 "カウンターテノール": "كَاونْتِر تِينُور (أعلى صوت ذكوريّ؛ ذو مدى فوق طبقة التينور) / كونترتينور (أعلى صوت غنائي للذكور البالغين) / كونتر تينور (مغنٍ ذكر بصوت أعلى من التينور)",
 "カウンターパンチ": "صد, لكمة مضادة (لكمة رد (خاصة من قبل ملاكم))",
 "カウンターパート": "نَظِير",
 "カウンターブロウ": "ضربة مضادة (ضربة رد؛ ضربة انتقامية)",
