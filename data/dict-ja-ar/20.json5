 "叶える": "مَنَحَ / مِنْحة",
 "叶わぬ": "مُسْتَحِيل",
 "号": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / مَقَاس, قِيَاس",
 "号する": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "号令": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "号泣": "بُكَاء",
 "号碼": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "号笛": "سِيرَانَة / صَفّارَة",
 "号音": "إِشَارَة",
 "司": "مَهَمَّة / شَيْخ, قَائِد",
 "司る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "司令": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "司令塔": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / قَائِد, زَعِيم",
 "司令官": "قَائِد, قُمَنْدَان",
 "司令部": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "司令長官": "رَئِيس أَرْكَان",
 "司会": "رَئِيس",
 "司会役": "مُشْرِف",
 "司会者": "رَئِيس",
 "司厨士": "طَاهٍ, طَاهِي",
 "司教": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "司教区": "أَبْرَشِيَّة",
 "司教座教会": "كَاتِدْرَائِيَّة",
 "司教座聖堂": "كَاتِدْرَائِيَّة",
 "司書": "أَمِين مَكْتَبَة, أَمِينَةْ مَكْتَبَة (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "司法の場": "قَاعَةُ مَحْكَمَة, قَاعَةُ الْمَحْكَمَة",
 "司法権": "قَضَاء / اِخْتِصَاص",
 "司法長官": "نَائِب عَامّ",
 "司直": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "司祭": "كَاهِن, قِسِّيس",
 "吃り": "تَلَجْلَجَ, تَلَعْثَمَ / أَرَتُّ ((أَرَتَّه) الله: جعل فِي لِسَانه رُتَّة)\nمثال: أرت لي ألبومها.",
 "吃る": "تَلَجْلَجَ, تَلَعْثَمَ",
 "吃水": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "吃音": "تَلَجْلَجَ, تَلَعْثَمَ",
 "吃音症": "تَأْتَأَة, تَمْتَمَة",
 "吃驚": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "吃驚仰天": "مَذْهُول",
 "各": "كُلّ",
 "各々": "كُلّ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "各人に彼のものを": "كل شخص حرّ في ذوقه",
 "各位": "الْجَمِيع, كُلّ شَخْص",
 "各個": "كُلّ",
 "各別": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / خُصُوصًا, خَاصَّةً",
 "各各": "كُلّ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "各自": "كُلّ",
 "各般": "كُلّ, جَمِيع",
 "合": "مَعًا, سَوِيًّا / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / ـِيّ",
 "合い": "مَعًا, سَوِيًّا / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / ـِيّ",
 "合いの子": "خِلَاسِيّ / هَجِين",
 "合いの手": "حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "合いの手を入れる": "قَاطَعَ",
 "合いの手を打つ": "قَاطَعَ",
 "合いの楔": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "合い口": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "合い札": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "合い言葉": "كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "合う": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "合さる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "合す": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合する": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "合せて": "إِضَافَةً عَلى ذٰلِكَ",
 "合せる": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合せ目": "مُشْتَرَك / مِفْصَل",
 "合の子": "خِلَاسِيّ / هَجِين",
 "合の楔": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "合わさる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "合わす": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合わせ": "ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "合わせて": "إِضَافَةً عَلى ذٰلِكَ",
 "合わせる": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合わせ板": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "合わせ目": "مُشْتَرَك / مِفْصَل",
 "合コン": "خَلَّاط, خَفَّاقَة",
 "合一": "تَوْحِيد",
