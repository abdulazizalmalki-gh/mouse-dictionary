 "クレッセンド": "كْرِيشِنْدُو ((في الموسيقى) يتصاعد تدريجيًّا في شدّة الصوت) / تصعيد, كريشيندو ((موسيقى) زيادة تدريجية في الجهارة)",
 "クレディビリティ": "مِصْدَاقِيّة",
 "クレディビリティー": "مِصْدَاقِيّة",
 "クレド": "دستور إيمان, عقيدة (أي نظام من المبادئ أو المعتقدات)",
 "クレバス": "شق عميق, صدع جليدي ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "クレバー": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "クレフ": "مِفْتَاح مُوسِيقِيّ (مفتاح)\nمثال: بحث عن المفتاح.",
 "クレブスかいろ": "دورة حمض الستريك, دورة كريبس (في جميع النباتات والحيوانات: سلسلة من التفاعلات الإنزيمية في الميتوكوندريا تتضمن الأيض التأكسدي لمركبات الأسيتيل لإنتاج مركبات الفوسفات عالية الطاقة…)",
 "クレブス回路": "دورة حمض الستريك, دورة كريبس (في جميع النباتات والحيوانات: سلسلة من التفاعلات الإنزيمية في الميتوكوندريا تتضمن الأيض التأكسدي لمركبات الأسيتيل لإنتاج مركبات الفوسفات عالية الطاقة…)",
 "クレプトクラシー": "كْلِيبْتُقْرَاطِيَّة",
 "クレプトマニア": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "クレマチス": "ظَيَّان",
 "クレマティス": "ظَيَّان",
 "クレムリン": "الْكْرِمْلِين",
 "クレヤボヤンス": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "クレヨン": "قلم تلوين شمعي, قلم شمع (أداة كتابة تتكون من عصا ملونة من الشمع المركب تستخدم للكتابة والرسم)",
 "クレリック": "قِسِّيس, كَاهِن (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "クレンザー": "مادة تنظيف, منظف (مستحضر يستخدم في تنظيف شيء ما)",
 "クレンジング": "تنظيف (فعل جعل الشيء نظيفاً) / مُطَهِّر, مُنَقٍّ (يعمل كمضادّ للعدوى؛ ذو أثر تطهيريّ) / تَطَهُّرِيّ, وُضُوئِيّ (يُنظّف الجسد بالغسل؛ خاصّة الغسل الطقوسيّ للأيدي)\nمثال: قام بتنظيف حذائه جيداً",
 "クレンジングミルク": "حليب منظف (منظف للوجه يشبه في قوامه الحليب المكثف)",
 "クレンジング・ミルク": "حليب منظف (منظف للوجه يشبه في قوامه الحليب المكثف)",
 "クレンメ": "مَشْبَك",
 "クレー": "طِين, صَلْصَال",
 "クレージー": "مَجْنُون, مَخْبُول",
 "クレータ": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "クレーター": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "クレートトレーニング": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "クレート・トレーニング": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "クレード": "زمرة, فَرْع حَيَوِي (مجموعة من الأصناف البيولوجية أو الأنواع التي تشترك في سمات موروثة من سلف مشترك)",
 "クレードル": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "クレーピジョン": "حمامة الطين, طبق الرماية (هدف يستخدم في رماية السكيت أو رماية الأطباق)",
 "クレーム": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية. / شِكَايَة, شَكْوَى",
 "クレームをだす": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "クレームを出す": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "クレームブリュレ": "كريم بروليه (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "クレーム・ブリュレ": "كريم بروليه (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "クレーン": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "クレーンしゃ": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "クレーン車": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "クレー・ピジョン": "حمامة الطين, طبق الرماية (هدف يستخدم في رماية السكيت أو رماية الأطباق)",
 "クロアゲハ": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "クロアシアホウドリ": "قطرس أسود الرجلين (نوع من القطرس ذو أقدام سوداء)",
 "クロアシイタチ": "نمس أسود الأقدام (ثديي من العرسيات في مناطق البراري بالولايات المتحدة؛ مهدد بالانقراض تقريباً)",
 "クロアチア": "كُرُوَاتِيَا",
 "クロアチアきょうわこく": "جُمْهُورِيَّة كُرُوَاتِيَا",
 "クロアチアご": "كرواتي (فرد من الشعب السلافي الذي يعيش في كرواتيا)",
 "クロアチアじん": "كرواتي (فرد من الشعب السلافي الذي يعيش في كرواتيا)",
 "クロアチア人": "كرواتي (فرد من الشعب السلافي الذي يعيش في كرواتيا)",
 "クロアチア共和国": "جُمْهُورِيَّة كُرُوَاتِيَا",
 "クロアチア語": "كرواتي (فرد من الشعب السلافي الذي يعيش في كرواتيا)",
 "クロイスター": "رواق الدير, ممشى مسقوف (فناء ذو ممرات مسقوفة (كما في المؤسسات الدينية)) / دير, سكن ديني (سكن يكون مكاناً للعزلة الدينية (مثل الدير))",
 "クロイツフェルトヤコブびょう": "مرض كروتزفيلد جاكوب (مرض دماغي نادر (قاتل عادة) (يحدث عادة في منتصف العمر) يسببه فيروس بطيء غير محدد؛ يتميز بخرف تدريجي وفقدان تدريجي للتحكم العضلي)",
 "クロイツフェルトヤコブ病": "مرض كروتزفيلد جاكوب (مرض دماغي نادر (قاتل عادة) (يحدث عادة في منتصف العمر) يسببه فيروس بطيء غير محدد؛ يتميز بخرف تدريجي وفقدان تدريجي للتحكم العضلي)",
 "クロウ": "غُرَاب, زَاغ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "クロウタドリ": "شُحْرُور",
 "クロウラー": "زَحَّافَة",
 "クロカン": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد / سيارة رياضية متعددة الأغراض (سيارة دفع رباعي عالية الأداء مبنية على هيكل شاحنة)",
 "クロガモ": "بط أسود شائع (نوع من البط الأسود)",
 "クロガラシ": "خردل أسود (نبات حولي أوراسي واسع الانتشار يزرع لبذوره النفاذة؛ مصدر رئيسي لخردل المائدة)",
 "クログワイ": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "クロケット": "كروكيت (لعبة يضرب فيها اللاعبون كرة خشبية عبر سلسلة من الأطواق؛ والفائز هو أول من يجتاز جميع الأطواق ويضرب وتداً) / كروكيت (لحوم مطبوخة مفرومة (أو خضروات) في صلصة بيضاء كثيفة؛ تغطى بالبقسماط وتقلى في زيت غزير)",
 "クロケー": "كروكيت (لعبة يضرب فيها اللاعبون كرة خشبية عبر سلسلة من الأطواق؛ والفائز هو أول من يجتاز جميع الأطواق ويضرب وتداً)",
 "クロコショウ": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "クロコダイル": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر.",
 "クロサイ": "وحيد القرن الأسود",
 "クロシェ": "كُرُوشِيه",
 "クロシェット": "كُرُوشِيه",
 "クロシュ": "قبعة جرسية, قبعة كلوش (قبعة نسائية محكمة القياس تشبه الخوذة) / غطاء نباتي, ناقوس زجاجي للنبات (غطاء شفاف منخفض يوضع فوق النباتات الصغيرة لحمايتها من البرد)",
 "クロシロエリマキキツネザル": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "クロス": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة) / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء. / غِطَاء مَائِدَة, غِطَاء الْمَائِدَة / وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "クロスせき": "جداء اتجاهي, ضرب اتجاهي (متجه هو نتاج متجهين آخرين)",
 "クロスエグザミネーション": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر)",
 "クロスオーバー": "معبر, ممر عبور (مسار (غالباً ما يكون محدداً) حيث يمكن عبور شيء ما (مثل شارع أو سكة حديد) للوصول من جانب إلى آخر) / أسلوب كروس أوفر, دمج الأنواع (تبني أسلوب جديد (خاصة في الموسيقى الشعبية) من خلال الجمع بين عناصر من أنواع مختلفة لجذب جمهور أوسع) / ناخب متجاوز للحزب (ناخب مسجل كعضو في حزب سياسي ولكنه يصوت في الانتخابات التمهيدية لحزب آخر) / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)\nمثال: ألبوم يجمع بين الجاز والموسيقى الكلاسيكية",
 "クロスカット": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد) / طريق مختصر, قطع عرضي (مسار قطري)",
 "クロスカントリー": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "クロスカントリースキー": "تزلج اختراق الضاحية, تزلج ريفي (رياضة التزلج عبر الريف (بدلاً من المنحدرات))",
 "クロスカントリーレース": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "クロスカントリー・スキー": "تزلج اختراق الضاحية, تزلج ريفي (رياضة التزلج عبر الريف (بدلاً من المنحدرات))",
 "クロスカントリー・レース": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "クロスグリ": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "クロススティッチ": "تطريز متقاطع, غرزة إكس (تطريز يتم بأزواج من الغرز تتقاطع مع بعضها البعض) / غرزة إكس, غرزة متقاطعة",
 "クロスステッチ": "تطريز متقاطع, غرزة إكس (تطريز يتم بأزواج من الغرز تتقاطع مع بعضها البعض) / غرزة إكس, غرزة متقاطعة",
 "クロストリジウム": "كلوستريديوم, مِطَثِّيَّة (خلية بكتيرية مغزلية الشكل خاصة تلك المنتفخة في المركز بواسطة بوغ داخلي)",
 "クロストーク": "تداخل الإشارات (وجود إشارة غير مرغوب فيها عبر اقتران عرضي)",
