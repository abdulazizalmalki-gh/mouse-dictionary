 "エス・イー・オー": "مُحَرِّك بَحْث (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "エス・エス": "محطة خدمة (محطة يتم فيها بيع البنزين والزيت وتتوفر فيها مرافق لإصلاح أو صيانة السيارات) / التوقف القصير, شورت ستوب (مركز اللعب للاعب في فريق البيسبول المتمركز بين القاعدة الثانية والثالثة) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء. / خِدْمَة سِرِّيَّة",
 "エス・エス・ディー": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها)",
 "エス・エス・ピー・イー": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال…)",
 "エス・エヌ・エス": "خدمة شبكات اجتماعية, موقع تواصل اجتماعي (منصة لبناء شبكات اجتماعية أو علاقات اجتماعية بين الأشخاص الذين يتشاركون…)\nمثال: تستخدم خدمات الشبكات الاجتماعية بشكل متزايد في التحقيقات القانونية والجنائية",
 "エス・エヌ・ピー": "تعدد أشكال النوكليوتيدات المفردة ((في علم الوراثة) تباين وراثي في تسلسل الحمض النووي يحدث عندما يتغير نيوكليوتيد…)",
 "エス・エフ": "خَيَال عِلْمِيّ (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "エス・エフ・エックス": "عنصر الإبهار (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي.",
 "エス・エフ・エー": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "エス・エム": "ماجستير العلوم (درجة الماجستير في العلوم) / مجمع تجاري, مركز تسوق (مؤسسة تجارية تتكون من مجمع من المحلات التجارية منسقة بعناية؛ تشمل عادة مطاعم…)\nمثال: يجب أن يحتوي مركز التسوق الجيد على دار سينما",
 "エス・エム・エス": "رِسَالَة, رِسَالَة إِس إِم إِس",
 "エス・エル": "قِطَار بُخَارِيّ",
 "エス・エル・イー": "ذِئْبَة حَمْرَاء, ذِئْبَة حَمَامِيَّة مَجْمُوعِيَّة",
 "エス・エー": "استراحة, منطقة خدمات (مكان على الطريق السريع يوفر خدمات المرآب ومرافق تناول الطعام والمراحيض)",
 "エス・エー・ティー": "السبت, يوم السبت (اليوم السابع والأخير من الأسبوع؛ يوم السبت عند اليهود)",
 "エス・オー・エス": "إشارة استغاثة, سوس (إشارة استغاثة معترف بها دولياً في شفرة الراديو)",
 "エス・オー・エックス": "أكسيد الكبريت (أي من أكاسيد الكبريت المتعددة)",
 "エス・キュー・エル": "إِس كْيُو إِل, إسْ كْيُو إلْ",
 "エス・シー・エル": "غرفة صغيرة (غرفة صغيرة كبيرة بما يكفي للسماح بالدخول)\nمثال: غرفة الطوارئ كانت مكتظة بالزائرين دون موعد",
 "エス・ジー・エム・エル": "لغة الترميز القياسية العامة ((علوم الحاسوب) لغة موحدة للترميز الوصفي للمستندات؛ مجموعة من القواعد لاستخدام…)",
 "エス・ティー・ディー": "دَاء مَنْقُول جِنْسِيًّا",
 "エス・ディー・ジーズ": "تَنْمِيَة مُسْتَدَامَة (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "エス・ピー": "خَاصّ, خُصُوصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / دورية الشاطئ, شرطة البحرية (الشرطة العسكرية للبحرية) / تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات) / هَاتِف ذَكِيّ, سِمَارْت فُون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "エス・ピー・エフ": "عامل الحماية من الشمس (الدرجة التي يحمي بها واقي الشمس البشرة من أشعة الشمس المباشرة)",
 "エス・ユー・ブイ": "سيارة رياضية متعددة الأغراض (سيارة دفع رباعي عالية الأداء مبنية على هيكل شاحنة)",
 "エス・ユー・ヴィ": "سيارة رياضية متعددة الأغراض (سيارة دفع رباعي عالية الأداء مبنية على هيكل شاحنة)",
 "エス語": "إِسْبِرَانْتُو",
 "エズラき": "عِزْرَا",
 "エズラ記": "عِزْرَا",
 "エセ": "زَائِف, بَاطِل",
 "エセかがく": "علم زائف (نشاط يشبه العلم ولكنه يعتمد على افتراضات مغلوطة)",
 "エセー": "مَقَالَة, بَحْث",
 "エセ科学": "علم زائف (نشاط يشبه العلم ولكنه يعتمد على افتراضات مغلوطة)",
 "エゼキエル": "حِزْقِيَال",
 "エゼキエルしょ": "حِزْقِيَال",
 "エゼキエル書": "حِزْقِيَال",
 "エソ": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "エソロジー": "علم سلوك الحيوان (فرع علم الحيوان الذي يدرس سلوك الحيوانات في بيئاتها الطبيعية)",
 "エゾキスゲ": "زنبق الليمون (زنبق نهاري بزهور صفراء)",
 "エゾギク": "أستر صيني (نبات يُقدّر لزهوره الجميلة ذات الألوان الزاهية والنقية المتنوعة؛ يُزرع بشكل…)",
 "エゾゼンテイカ": "زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل…)",
 "エゾネギ": "ثوم معمر (أوراق أسطوانية تستخدم طازجة كتابل خفيف بنكهة البصل)",
 "エゾノウワミズザクラ": "كرز الطيور (أي من عدة أشجار كرز صغيرة الثمار تتردد عليها الطيور أو تتغذى عليها)",
 "エタ": "إِتَا",
 "エタクリンさん": "حمض الإيثاكرينيك (مدر للبول (الاسم التجاري إيديكرين) يستخدم لعلاج الوذمة)",
 "エタクリン酸": "حمض الإيثاكرينيك (مدر للبول (الاسم التجاري إيديكرين) يستخدم لعلاج الوذمة)",
 "エタニティ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "エタニティー": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "エタノール": "إِيثَانُول",
 "エタン": "إيثان (غاز ألكاني عديم اللون والرائحة يُستخدم كوقود)",
 "エタンジオール": "إيثيلين غليكول, غليكول (سائل شرابي حلو ولكنه سام يستخدم كمضاد للتجمد ومذيب)",
 "エターナル": "أَبَدِيّ",
 "エターニティ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "エダツノレイヨウ": "ظبي أمريكي, وعل شوكي القرون (مجتر سريع يشبه الظبي من سهول غرب أمريكا الشمالية ذو قرون صغيرة متفرعة)",
 "エダムチーズ": "إِيدَام",
 "エダム・チーズ": "إِيدَام",
 "エチい": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "エチエチ": "جَذَّاب, جِنْسِيّ / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى…)\nمثال: أنا مثلي الجنس.",
 "エチオピア": "أَثِيُوبِيَا (طريقة هجاء بديلة لإثيوبيا)",
 "エチオピアく": "إثيوبي (من أو متعلق أو مميز لإثيوبيا أو شعبها أو لغاتها)\nمثال: مهاجرون إثيوبيون",
 "エチオピアじん": "إثيوبي (من أو متعلق أو مميز لإثيوبيا أو شعبها أو لغاتها)\nمثال: مهاجرون إثيوبيون",
 "エチオピアれんぽうみんしゅきょうわこく": "جُمْهُورِيَّة أَثْيُوبِيَا الْفِدْرَالِيَّة الدِّيمُقْرَاطِيَّة",
 "エチオピア人": "إثيوبي (من أو متعلق أو مميز لإثيوبيا أو شعبها أو لغاتها)\nمثال: مهاجرون إثيوبيون",
 "エチオピア区": "إثيوبي (من أو متعلق أو مميز لإثيوبيا أو شعبها أو لغاتها)\nمثال: مهاجرون إثيوبيون",
 "エチオピア連邦民主共和国": "جُمْهُورِيَّة أَثْيُوبِيَا الْفِدْرَالِيَّة الدِّيمُقْرَاطِيَّة",
 "エチケット": "أَدَب (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما…)\nمثال: زيري يحب الأدب. / مُلْصَق, بِطَاقَة",
 "エチケットぶくろ": "كيس دوار الجو, كيس قيء (كيس يتوفر في الطائرة للركاب الذين يعانون من دوار الجو ويحتاجون للتقيؤ)",
 "エチケット袋": "كيس دوار الجو, كيس قيء (كيس يتوفر في الطائرة للركاب الذين يعانون من دوار الجو ويحتاجون للتقيؤ)",
 "エチモロジー": "اِشْتِقَاق, تَأْثِيل",
 "エチュード": "إيتود, دراسة موسيقية (تأليف قصير لآلة منفردة؛ يهدف كتمرين أو لإظهار البراعة التقنية) / ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس.",
 "エチル": "إيثيل, شق إيثيل",
 "エチルアルコール": "إِيثَانُول",
 "エチルエーテル": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "エチル・アルコール": "إِيثَانُول",
 "エチル・エーテル": "إيثر (سائل متطاير عديم اللون وشديد الاشتعال كان يستخدم سابقاً كمخدر استنشاقي)",
 "エチレン": "إيثيلين, إيثين (غاز ألكيني عديم اللون قابل للاشتعال؛ يُستخرج من البترول والغاز الطبيعي ويُستخدم…)",
 "エチレンけいたんかすいそ": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "エチレングリコール": "إيثيلين غليكول, غليكول (سائل شرابي حلو ولكنه سام يستخدم كمضاد للتجمد ومذيب)",
 "エチレンジアミンしさくさん": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم…)",
 "エチレンジアミンテトラさくさん": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم…)",
 "エチレンジアミンテトラ酢酸": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم…)",
 "エチレンジアミン四酢酸": "إيثيلين ثنائي الأمين رباعي حمض الأسيتيك (جزيء معقد يستخدم طبياً لإزالة أيونات المعادن (الاستخلاب) في حالات التسمم…)",
 "エチレン・グリコール": "إيثيلين غليكول, غليكول (سائل شرابي حلو ولكنه سام يستخدم كمضاد للتجمد ومذيب)",
 "エチレン系炭化水素": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "エチン": "أسيتيلين, إيثاين (غاز عديم اللون قابل للاشتعال يستخدم بشكل رئيسي في اللحام وفي التخليق العضوي)",
 "エックス": "س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف…) / كمية مجهولة, مجهول (متغير تكون قيمه حلولاً لمعادلة)\nمثال: لا أعرف ماذا سيفعل الرجل الجديد؛ لا يزال عاملاً مجهولاً",
 "エックスこうせん": "أَشِعَّة إِكْس, أَشِعَّة سِينِيَّة",
 "エックスせだい": "الجيل إكس",
 "エックスせん": "أَشِعَّة إِكْس, أَشِعَّة سِينِيَّة",
 "エックスせんかいせつ": "حيود الأشعة السينية (تشتت الأشعة السينية بواسطة ذرات البلورة؛ يظهر نمط الحيود بنية البلورة)",
 "エックスせんけんさ": "أَشِعَّة إِكْس, أَشِعَّة سِينِيَّة",
 "エックスせんさつえい": "تصوير بالأشعة السينية (التصوير الشعاعي الذي يستخدم الأشعة السينية لإنتاج صورة شعاعية)",
