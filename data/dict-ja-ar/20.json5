 "エーピー": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص / إقامة كاملة, خطة أمريكية (خطة فندقية تشمل ثلاث وجبات يومياً)",
 "エーピーアイ": "وَاجِهَة بَرْمَجَة اَلتَّطْبِيقَات",
 "エーピーエル": "لُغَة بَرْمَجَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "エーブイ": "سمعي بصري (يتضمن كلاً من السمع والرؤية (يتعلق عادةً بالوسائل التعليمية))\nمثال: القسم السمعي البصري بالمدرسة",
 "エープリルフール": "يَوْم كَذْبَة أَبْرِيل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل. / كِذْبَةُ أَبْرِيل",
 "エープリル・フール": "يَوْم كَذْبَة أَبْرِيل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل. / كِذْبَةُ أَبْرِيل",
 "エーユー": "وحدة فلكية (وحدة طول تستخدم للمسافات داخل النظام الشمسي؛ تساوي متوسط المسافة بين الأرض…)",
 "エーライン": "ملابس بقصة واسعة (ملابس نسائية لها جزء علوي ضيق وتنورة واسعة تكون أعرض ما يمكن عند الحاشية)",
 "エーリアン": "غَرِيب, غَرِيبَة",
 "エール": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح. / مِزْر",
 "エールをおくる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "エールを送る": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "エーログラム": "رسالة جوية (رسالة ترسل بالبريد الجوي)",
 "エーロゾル": "هَبَاء جَوِّيّ, أَيْرُوسُول",
 "エー・アイ": "ذَكَاء اِصْطِنَاعِيّ",
 "エー・アール・ディー・エス": "رئة رطبة, متلازمة الضائقة التنفسية الحادة (إصابة رئوية حادة تتميز بالسعال والخرخرة؛ التهاب في الرئتين اللتين تصبحان صلبتين…)",
 "エー・イー": "مدير حساب عميل, مسؤول حسابات (شخص مسؤول عن حساب العميل لدى وكالة إعلانات أو شركة وساطة أو غيرها من الأعمال…)",
 "エー・エス": "كَـ, مِثْل\nمثال: قصدته مثل نكتة. / أَنْجْلُوسَكْسُونِيّ",
 "エー・エス・エム・アール": "إيسمار, استجابة الزوال الحسية الذاتية (تجربة مبتهجة تتميز بإحساس بالوخز يشبه الكهرباء الساكنة على الجلد يبدأ عادةً في…)",
 "エー・エス・エー・ピー": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "エー・エス・ディー": "اِضْطِرَاب طَيْف التَّوَحُّد / توحد ((طب نفس) انشغال غير طبيعي بالذات؛ يتميز باضطرابات التواصل وقصر مدى الانتباه…) / عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "エー・エス・ピー": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت)",
 "エー・エフ": "تركيز تلقائي (جهاز بصري لتركيز الكاميرا أو أداة أخرى تلقائياً) / تَرَدُّد صَوْتِيّ (تردد موجة صوتية مسموعة) / سِلَاح طَيَرَان / جِمَاع شَرَجِيّ (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "エー・エム・ディー": "تنكس بقعي مرتبط بالعمر (تنكس بقعي مرتبط بالتقدم في العمر)",
 "エー・エム・ピー": "أدينوسين أحادي الفوسفات",
 "エー・エル・イー": "مِزْر",
 "エー・エル・エス": "التَّصَلُّب الضُّمُورِي الْجَانِبِي",
 "エー・エル・ティー": "اِرْتِفَاع, عُلُوّ (المسافة الزاوية فوق الأفق (خاصة لجرم سماوي))",
 "エー・シー": "تَيَّار مُتَرَدِّد / حاسوب تناظري (حاسوب يمثل المعلومات بكميات متغيرة (مثل المواضع أو الفولتية)) / متوسط التكلفة (إجمالي تكلفة جميع الوحدات المشتراة (أو المنتجة) مقسوماً على عدد الوحدات)",
 "エー・ジー・エー": "صَلَع",
 "エー・ティー": "ناقل حركة أوتوماتيكي (ناقل حركة يغير التروس تلقائياً وفقاً لسرعة السيارة)",
 "エー・ティー・エム": "صَرَّافَة, صَرَّاف آلِيّ / وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت…)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "エー・ティー・ピー": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة…)",
 "エー・ディー": "حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / مدير فني (المخرج المسؤول عن الجوانب الفنية لإنتاج مسرحي (الأزياء والمناظر والإضاءة)) / حِقْبَة عَامَّة, بَعْدَ الْمِيلَاد (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "エー・ディー・エイチ": "الهرمون المضاد لإدرار البول, فازوبريسين (هرمون تفرزه الغدة النخامية الخلفية؛ يؤثر على ضغط الدم ويقلل تدفق البول)",
 "エー・ディー・エイチ・ディー": "اضطراب فرط الحركة ونقص الانتباه, اضطراب نقص الانتباه (حالة (تغلب عند الأولاد) تتميز باضطرابات سلوكية وصعوبات في التعلم)",
 "エー・ディー・ピー": "أدينوسين ثنائي الفوسفات",
 "エー・ビー・エム": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "エー・ビー・シー": "حُرُوف هِجَاء, أَبْجَد (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / أبجدية, ألفباء (مجموعة رموز تتضمن حروفاً وتُستخدم لكتابة لغة ما)",
 "エー・ピー": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص / إقامة كاملة, خطة أمريكية (خطة فندقية تشمل ثلاث وجبات يومياً)",
 "エー・ピー・アイ": "وَاجِهَة بَرْمَجَة اَلتَّطْبِيقَات",
 "エー・ピー・エル": "لُغَة بَرْمَجَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "エー・ブイ": "سمعي بصري (يتضمن كلاً من السمع والرؤية (يتعلق عادةً بالوسائل التعليمية))\nمثال: القسم السمعي البصري بالمدرسة",
 "オア": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "オアかいろ": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "オアゲート": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "オアシス": "وَاحَة, غُوطَة (بقعة خضراء في الصحراء أو في أرض قاحلة، وأصبحت كذلك بسبب وجود مصدر ماء بقربها)",
 "オア回路": "بوابة أو (دائرة بوابة في الكمبيوتر تعمل عندما يعمل أي من مدخلاتها)",
 "オイシイ": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / جَذَّاب",
 "オイスター": "مَحَار",
 "オイスターバー": "بار المحار (حانة (كما في مطعم) تتخصص في تقديم المحار المعد بطرق مختلفة)",
 "オイスター・バー": "بار المحار (حانة (كما في مطعم) تتخصص في تقديم المحار المعد بطرق مختلفة)",
 "オイタ": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / شَأْن",
 "オイタナシー": "قَتْلٌ رَحِيم (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "オイタナジー": "قَتْلٌ رَحِيم (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "オイッス": "يَاه, اسمع / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "オイニー": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح…)\nمثال: شم تلك الرائحة.",
 "オイプシロン": "أُبْسِلُون, أُبْسِيلُون",
 "オイラル": "أيرير (100 أيرير تساوي 1 كرونا في آيسلندا)",
 "オイラーすう": "إِي, إِيه (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى…)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "オイラーのこうしき": "صِيغَة أُويْلِر",
 "オイラーの公式": "صِيغَة أُويْلِر",
 "オイラー数": "إِي, إِيه (بمعنى نَعَم ولا يأتي إلا وبعده قَسَم؛ في : يستخدم بدلا من نعم في كل الحالات حتى…)\nمثال: يجب على توم عدم إعطاء إي إهتمام لما قالته ماري.",
 "オイリュトミー": "حركات إيقاعية, يوريثميكس (التفسير بحركات جسدية متناغمة لإيقاع المؤلفات الموسيقية؛ يستخدم لتعليم الفهم…)",
 "オイリー": "زَيْتِيّ, دُهْنِيّ",
 "オイル": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت. / كِيرُوسِين",
 "オイルこうかん": "تغيير الزيت (استبدال الزيت المتسخ بآخر نظيف)",
 "オイルご": "الفرنسية القديمة (أقدم شكل للغة الفرنسية؛ من القرن التاسع إلى الخامس عشر)",
 "オイルカラー": "زيت, لون زيتي (طلاء زيتي يحتوي على صبغة يستخدمه الفنانون) / طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイルクロス": "مُشَمَّع",
 "オイルクロース": "مُشَمَّع",
 "オイルシェール": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "オイルスキン": "معطف مشمع (معطف ماكنتوش مصنوع من قماش قطني معالج بالزيت والصبغة لجعله مقاوماً للماء)",
 "オイルステイン": "بقعة زيت (بقعة ناتجة عن الزيت)",
 "オイルストーン": "مسن زيتي (حجر شحذ للاستخدام مع الزيت)",
 "オイルバーナー": "حارق نفط, فرن نفطي (فرن يحرق النفط)",
 "オイルフィルター": "مرشح زيت (مرشح يزيل الشوائب من الزيت المستخدم لتزييت محرك الاحتراق الداخلي)",
 "オイルペインティング": "لَوْحَة زَيْتِيَة",
 "オイルペイント": "طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイルポンプ": "مضخة زيت (مضخة تحافظ على إمداد الزيت للأجزاء المتحركة)",
 "オイルランプ": "مِصْبَاح زَيْتِيّ (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي…)\nمثال: ليس كل مصباح سحريا.",
 "オイル・カラー": "زيت, لون زيتي (طلاء زيتي يحتوي على صبغة يستخدمه الفنانون) / طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイル・クロス": "مُشَمَّع",
 "オイル・クロース": "مُشَمَّع",
 "オイル・シェール": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "オイル・ステイン": "بقعة زيت (بقعة ناتجة عن الزيت)",
 "オイル・バーナー": "حارق نفط, فرن نفطي (فرن يحرق النفط)",
 "オイル・フィルター": "مرشح زيت (مرشح يزيل الشوائب من الزيت المستخدم لتزييت محرك الاحتراق الداخلي)",
 "オイル・ペインティング": "لَوْحَة زَيْتِيَة",
 "オイル・ペイント": "طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "オイル・ポンプ": "مضخة زيت (مضخة تحافظ على إمداد الزيت للأجزاء المتحركة)",
 "オイル・ランプ": "مِصْبَاح زَيْتِيّ (كل ما يستضاء به، منه الفانوس والقنديل والنبراس والسراج والمشكاة؛ جهاز كهربائي…)\nمثال: ليس كل مصباح سحريا.",
 "オイル交換": "تغيير الزيت (استبدال الزيت المتسخ بآخر نظيف)",
 "オイル語": "الفرنسية القديمة (أقدم شكل للغة الفرنسية؛ من القرن التاسع إلى الخامس عشر)",
 "オウ": "أُوه ((أَوَّهَ): آه)",
 "オウギガイ": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "オウギバショウ": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من…)",
 "オウギヤシ": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد…)",
 "オウギワシ": "عقاب هاربي (عقاب كبيرة سوداء وبيضاء متوجة من أمريكا الاستوائية)",
 "オウサマペンギン": "بطريق ملك (بطريق كبير في الجزر المحاذية للدائرة القطبية الجنوبية)",
 "オウシュウアカマツ": "صنوبر اسكتلندي, صنوبر بري (صنوبر متوسط الكبر ثنائي الإبر من شمال أوروبا وآسيا له لحاء أحمر بني متقشر)",
 "オウシュウシラカンバ": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "オウシュウトウヒ": "تنوب نرويجي (تنوب هرمي طويل موطنه شمال أوروبا له أوراق خضراء داكنة على فروع منتشرة بغصينات…)",
 "オウシュウナラ": "بلوط شائع, سنديان إنجليزي (سنديان أوروبي نفضي متوسط إلى كبير الحجم، له أوراق ناعمة ذات فصوص مستديرة؛ ينتج…)",
 "オウバイ": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في…)",
 "オウム": "بَبَّغَاء (طائر من فصيلة كبيرة من الطيور ذوات ألوان زاهية قادرة على تقليد صوت كلام الإنسان…)",
 "オウムガイ": "نوتي (رأسيات الأرجل في المحيطين الهندي والهادئ لها صدفة حلزونية ذات حواجز لؤلؤية شاحبة)",
 "オウム病": "حمى الببغاء, داء الببغائية (التهاب رئوي لانمطي يسببه كائن دقيق من الريكيتسيا وينتقل إلى البشر من الطيور…)",
 "オウラフィン": "ألكين, أوليفين (أي هيدروكربون أليفاتي غير مشبع)",
 "オウル": "قِرْش, عُمْلَة",
 "オウレン": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر…)",
 "オウロ": "قِرْش, عُمْلَة",
 "オウンゴール": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "オウン・ゴール": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "オオアメリカモモンガ": "سنجاب طائر شمالي (سنجاب طائر كبير؛ بشكل رئيسي من كندا)",
 "オオアリクイ": "آكل النمل العملاق (آكل نمل كبير أشعث الشعر وعديم الأسنان ذو لسان طويل ومخالب قوية؛ من أمريكا…)",
 "オオアルマジロ": "مدرع عملاق (يبلغ طوله حوالي ثلاثة أقدام باستثناء الذيل)",
 "オオアワガエリ": "تِيمُوثَاوُس",
 "オオイヌノフグリ": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "オオイヌフグリ": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "オオウミガラス": "أوك عظيم (طائر أوك كبير لا يطير من الجزر الصخرية قبالة سواحل شمال الأطلسي؛ منقرض)",
 "オオカバマダラ": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى…)",
 "オオカミ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة. / ذِئْبٌ فِي ثَوْبِ حَمَلٍ (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة.",
 "オオカミ男": "مُسْتَذْئِب, مُسْتَذْئِبَة",
 "オオカンガルー": "كنغر رمادي شرقي, كنغر عملاق (كنغر أسترالي بني رمادي كبير جداً كان وفيراً سابقاً في المناطق المشجرة المفتوحة)",
 "オオキンケイギク": "أشرفية, بذر القراد",
 "オオクチバス": "قاروص كبير الفم (قاروص أسود كبير؛ تقع زاوية الفك خلف العين)",
 "オオクログワイ": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "オオグチバス": "قاروص كبير الفم (قاروص أسود كبير؛ تقع زاوية الفك خلف العين)",
 "オオケタデ": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق…)",
 "オオコウモリ": "خفاش الفاكهة (خفاش كبير من العالم القديم في المناطق الدافئة والاستوائية يتغذى على الفاكهة)",
 "オオジカ": "مُوظ",
 "オオジュリン": "درسة القصب (طائر درسة أوروبي يسكن المناطق المستنقعية)",
 "オオタカ": "باز شمالي / صَقَارَة",
 "オオチョウザメ": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ)",
 "オオツチグモ": "رُتَيْل",
 "オオツノヒツジ": "الضأن كبير القرون, كباش الجبال الصخرية (خروف بري في المناطق الجبلية بغرب أمريكا الشمالية له قرون ضخمة ملتوية)",
 "オオトカゲ": "وَرَل",
 "オオトリテエ": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف…)\nمثال: هو متعطش للسلطة.",
 "オオノガイ": "محار ناعم الصدفة (محار صالح للأكل بصدفة رقيقة بيضاوية الشكل يوجد في المناطق الساحلية للولايات…)",
 "オオハクチョウ": "تم ناعق (بجعة شائعة في العالم القديم تشتهر بندائها الناعق)",
 "オオハシ": "طُوقَان",
 "オオハシウミガラス": "موسوي المنقار (طائر أوك أسود وأبيض من شمال الأطلسي ذو منقار مضغوط حاد الحواف)",
 "オオバコ": "لِسَان الْحَمَل, لِسَان الْخَرُوف (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان.",
 "オオバン": "غُرَّة (بياض في جبهة الفرس فوق العينين أو بينهما وتحت الأذنين. انظر الصورة؛ أول يوم في…)",
 "オオフクロモモンガ": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
