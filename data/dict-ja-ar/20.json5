 "エボルーション": "تَطَوُّر",
 "エポキシ": "إيبوكسي, راتنج الإيبوكسي (راتنج متصلب بالحرارة؛ يُستخدم بشكل رئيسي في المواد اللاصقة القوية والطلاء…)",
 "エポキシじゅし": "إيبوكسي, راتنج الإيبوكسي (راتنج متصلب بالحرارة؛ يُستخدم بشكل رئيسي في المواد اللاصقة القوية والطلاء…)",
 "エポキシ樹脂": "إيبوكسي, راتنج الإيبوكسي (راتنج متصلب بالحرارة؛ يُستخدم بشكل رئيسي في المواد اللاصقة القوية والطلاء…)",
 "エポック": "عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "エポックメイキング": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "エポックメーキング": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "エポック・メイキング": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "エポック・メーキング": "تَارِيخِيّ, حِقْبِيّ (بالغ الأهمّيّة خاصّةً في إحداث أو تمييز بداية حقبة أو عصر جديد)",
 "エポニム": "اسم منسوب لشخص (الاسم المشتق من شخص (حقيقي أو خيالي))\nمثال: متلازمة داون هي اسم منسوب للطبيب الإنجليزي جون داون",
 "エポレット": "كَتَّافَة (زينة تتكون من وسادة قماشية مزخرفة توضع على الكتف)",
 "エマジェンシー": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "エマルション": "مُسْتَحْلَب",
 "エマルジオン": "مُسْتَحْلَب",
 "エマルジョン": "مُسْتَحْلَب",
 "エマンシペーション": "تحرير من الوصاية, عتق (تحرير شخص من سيطرة آخر؛ خاصة تخلي الوالد عن السلطة والسيطرة على طفل قاصر)",
 "エマージェンシー": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "エマージェンシーランディング": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "エマージェンシー・ランディング": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "エマージング": "بَارِز, نَاشِئ (يظهر إلى الوجود؛ في طَوْر التكوُّن)",
 "エミグラント": "مُهَاجِر, مُهَاجِرَة",
 "エミグレーション": "هِجْرَة, نُزُوح (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال…)\nمثال: الهجرة النبوية.",
 "エミッション": "إصدار, انبعاث (فعل الإصدار؛ التسبب في التدفق للخارج)\nمثال: خروج الصديد",
 "エミッター": "باعث (القطب الكهربائي في الترانزستور الذي تنشأ منه الإلكترونات)",
 "エミネント": "بَارِز",
 "エミュ": "مُحَاكٍ",
 "エミュレイト": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر)",
 "エミュレーション": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر)",
 "エミュレータ": "مُحَاكٍ",
 "エミュレーター": "مُحَاكٍ",
 "エミュレート": "اقتداء, محاكاة (الجهد المبذول لمساواة أو التفوق على آخر)",
 "エミュー": "دُرْمِيس أُسْتُرَالِيّ",
 "エム": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / مِتْر (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ…)\nمثال: أنا أقل بقليل من 150 سنتي متر. / مَاسُوشِيّ, مَازُوخِيّ / ذَكَرِيّ\nمثال: قتله ذكر زرافة.",
 "エムせだい": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "エムりろん": "ْنَظَرِيَّة-إَم",
 "エムアイエス": "مِي (الفتاة البِكْر؛ اسم من أسماء الخَمْر، يطلق غالبًا على الخمر الجديد الذي لم…) / ذَات أَقَل تَدَخُّل جِرَاحِيّ, بِأَقَل تَدَخُّل جِرَاحِيّ / استخبارات عسكرية (معلومات حول القوات المسلحة لبلد آخر تكون مفيدة في التخطيط وإجراء السياسة…)",
 "エムアール": "سيد (صيغة خطاب للرجل) / أبحاث التسويق (البحث الذي يجمع ويحلل المعلومات حول نقل البضائع أو الخدمات من المنتج إلى…)",
 "エムアールアイ": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "エムアールエヌエー": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض…)",
 "エムアールエー": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "エムイー": "إلكترونيات دقيقة (فرع الإلكترونيات الذي يتعامل مع المكونات المصغرة) / الشَّرْق الْأَوْسَط, مَشْرِق / إِنْجْلِيزِيَّة وُسْطَى (مُؤَنَّثُ إِنْجْلِيزِيّ، ٌ مُؤَنَّثَةٌ إِلَى ٱلْإِنجليزِ؛ اَللُّغَةُ…)\nمثال: تحدث بالإنجليزية! / ـنِي, ـنِيَ",
 "エムエフ": "تَرَدُّد مُتَوَسِّط (300 إلى 3000 كيلوهرتز)",
 "エムエフエー": "ماجستير الفنون الجميلة (درجة الماجستير في الفنون الجميلة)",
 "エムエル": "سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "エムエルエス": "ماجستير علم المكتبات (درجة الماجستير في علم المكتبات)",
 "エムオー": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه)\nمثال: انتظر لحظة فقط",
 "エムシー": "عريف الحفل, مذيع الربط (شخص يعمل كمضيف في المناسبات الرسمية (يلقي خطابات تمهيدية ويقدم المتحدثين…) / مركز تشغيل آلي, مركز خراط (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / تكلفة تزايدية, تكلفة حدية (الزيادة أو النقصان في التكاليف نتيجة لوحدة إنتاج واحدة أكثر أو أقل)",
 "エムティー": "ترجمة آلية (استخدام الحواسيب للترجمة من لغة إلى أخرى) / ميغا طن (مقياس للقوة التفجيرية (لسلاح نووي) يساوي قوة مليون طن من مادة تي إن تي) / شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل…)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "エムティージー": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "エムティービー": "دَرَّاجَة لِلْجِبَال (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة…)\nمثال: كين يريد دراجة.",
 "エムディー": "دكتور في الطب (درجة الدكتوراه في الطب)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي / قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين…) / إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات)",
 "エムディーエムエー": "إكستاسي, إم دي إم إيه (عقار منشط مرتبط كيميائياً بالميسكالين والأمفيتامين ويستخدم بشكل غير مشروع…)\nمثال: غالباً ما يستخدم الإكستاسي في الحفلات لأنه يمكن رواد الحفلات من البقاء نشطين لفترات طويلة من الزمن",
 "エムビー": "مِيغَابَايْت",
 "エムビーエー": "ماجستير في إدارة الأعمال (درجة الماجستير في الأعمال)",
 "エムピー": "الشرطة العسكرية (فيلق عسكري يفرض الانضباط ويحرس السجناء) / شُرْطَة عَسْكَرِيَّة, الشُّرْطَة الْعَسْكَرِيَّة / عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "エムピースリー": "إِم بِي ثْرِي, إم بي 3",
 "エムピースリープレーヤー": "مُشَغِّل إِم بِي ثْرِي, مشغل 3",
 "エムブイピー": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "エムブレム": "شِعَار, رَمْز (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "エムペグ": "مبيغ (مجموعة من المعايير لضغط الفيديو الرقمي والبيانات الصوتية)",
 "エムユーディー": "طِين, وَحْل",
 "エムルション": "مُسْتَحْلَب",
 "エム・アイ・エス": "مِي (الفتاة البِكْر؛ اسم من أسماء الخَمْر، يطلق غالبًا على الخمر الجديد الذي لم…) / ذَات أَقَل تَدَخُّل جِرَاحِيّ, بِأَقَل تَدَخُّل جِرَاحِيّ / استخبارات عسكرية (معلومات حول القوات المسلحة لبلد آخر تكون مفيدة في التخطيط وإجراء السياسة…)",
 "エム・アール": "سيد (صيغة خطاب للرجل) / أبحاث التسويق (البحث الذي يجمع ويحلل المعلومات حول نقل البضائع أو الخدمات من المنتج إلى…)",
