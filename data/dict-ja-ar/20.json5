 "啀み合い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "啄木": "نَقَّار الخَشَب",
 "啄木鳥": "نَقَّار الخَشَب",
 "商": "خَارِج قِسْمَة, خَارِج / شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "商い": "تِجَارَة / بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "商い屋": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "商う": "بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "商人": "تَاجِر, تَاجِرَة",
 "商会": "سَرِيَّة / شَرِكَة",
