 "吹飛ばす": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)",
 "吹鳴": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "吹鳴らす": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "吻": "خُرْطُوم",
 "吻合": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "吼えたてる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "吼える": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء / عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "吼え声": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "吼え立てる": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "吼く": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "吾": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾が": "ـِي, ـي",
 "吾が身": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَفْسِي",
 "吾が輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "吾主": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾人": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "吾儕": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾兄": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾妹": "حَبِيب, حَبِيبَة",
 "吾妹子": "حَبِيب, حَبِيبَة",
 "吾妻": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "吾妻しい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "吾妻琴": "عَرَبَة",
 "吾嬬": "الْمِنْطَقَة الشَرْقِيَّة, الشَرْقِيَّة / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / عَرَبَة",
 "吾曹": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "吾殿": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "吾輩": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "呆": "صَدْمَة / صَعْقَة / صَعَقَ",
 "呆け": "مُغَفَّل, أَحْمَق / خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف)",
 "呆然自失": "ترانس",
 "呈す": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ",
 "呈する": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / اِفْتَرَضَ",
 "呈上": "مِعْطَاء",
 "呈出": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "呈示": "إِرَاءَة / إِهْدَاء, مَنْح",
 "呈色": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "呉": "وُو",
 "呉の母": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "呉る": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "呉れ手": "مُتَبَرِّع",
 "呉服": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء.",
 "呉服屋": "بَزَّاز",
 "呉服物": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "告ぐ": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "告げる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "告げ口": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "告別": "وَدَاع / فِرَاق, وَدَاع / وَدَاعًا (تقال للمسافر؛ تقال قبل الانصراف. (تعميم))\nمثال: قال زيري وداعا.",
 "告発": "مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة",
 "告発者": "شَاكٍ",
 "告白": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "告白録": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "告知": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "告知板": "لَوْحَة إِعْلَانَات",
 "告示": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "告示板": "لَوْحَة إِعْلَانَات",
 "告解": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "告訴": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "告訴人": "شَاكٍ",
 "告達": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "呑み": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / تَنَصَّتَ",
 "呑み助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑み口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "呑み屋": "حَانَة, بَار",
 "呑み師": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑み行為": "دَلْو, سَطْل",
 "呑み込み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "呑み込む": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "呑む": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "呑んでかかる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "呑んで掛かる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "呑兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "呑師": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑気者": "مُتَفَائِل",
 "呟き": "لَغَط, طَبْطَبَة / غَمْغَمَ, تَغَمْغَمَ / تَغْرِيدَة / غَرَّدَ",
 "呟く": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ / تَغْرِيدَة / غَرَّدَ",
 "呦々": "بَاكٍ / بُكَاء",
 "呦呦": "بَاكٍ / بُكَاء",
 "周": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周り": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周到": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "周回": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة. / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周回軌道": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "周囲": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周囲長": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周圏": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周密": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "周旋人": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "周旋屋": "سِمْسَار, وَسِيط",
 "周旋料": "عُمُولَة",
 "周旋業者": "سِمْسَار, وَسِيط",
 "周期": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "周期表": "الْجَدْوَلُ الدَّوْرِيّ",
 "周波": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "周波数": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "周知徹底": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "周章": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "周章狼狽": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "周縁": "هُدْب (هُدْبُ العين ما نبت من الشعر على أشفارها) / هُدُب (هُدْبُ العين ما نبت من الشعر على أشفارها)",
 "周縁部": "هَامِش",
 "周転円": "فَلَك التَّدوِير (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "周辺": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "周辺機器": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "周遊": "رِحْلَة / جَوْلَة",
 "周長": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "呪": "تَعْوِيذَة / هَجَّى, تَهَجَّى / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "呪い": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "呪う": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "呪り": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪文": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "呪法": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
