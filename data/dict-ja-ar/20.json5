 "カワイソス": "يَا خَسَارَة, يَا لَلْأَسَف (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "カワイルカ": "دلفين نهري (أي من عدة دلافين طويلة الخطم تعيش عادة في المياه العذبة في أمريكا الجنوبية وجنوب آسيا)",
 "カワウソ": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "カワカマス": "بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على نطاق واسع في الأجزاء الباردة من نصف الكرة الشمالي) / أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة) / رمح (سلاح من العصور الوسطى يتكون من رأس رمح مثبت على عمود طويل؛ حل محله الحربة) / سنان (نقطة حادة (كما في نهاية الرمح))",
 "カワゲラ": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات الخياشيم لاحمة وتعيش تحت الحجارة)",
 "カワセミ": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "カワハギ": "سلخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "カワマス": "تروتة الجدول (تروتة المياه العذبة في أمريكا الشمالية؛ أُدخلت إلى أوروبا) / تراوت الجدول (سمكة طعام لذيذة من المياه العذبة)",
 "カワメンタイ": "بربوط (قد مياه عذبة ممدود في شمال أوروبا وآسيا وأمريكا الشمالية له زوائد حول فمه)",
 "カワラバト": "حَمَام طُورَانِيّ, حَمَام أَزْرَق (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "カワラフジノキ": "خروب العسل, غلاديتشية ثلاثية الأشواك (شجرة أمريكية شمالية طويلة عادة ما تكون شائكة لها زهور بيضاء مخضرة صغيرة في عناقيد متدلية تليها قرون بذور طويلة ملتوية؛ تنتج خشباً بنياً محمراً متيناً…)",
 "カワラマツバ": "جويسئة السيدة العذراء, جويسئة صفراء (جويسئة معمرة شائعة ذات زهور صفراء؛ أمريكا الشمالية وأوروبا وآسيا)",
 "カン": "قَدَرَ, اِسْتَطَاعَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / اِسْتَطَاعَ, مُمْكِن (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ) / صَفِيحَة, علبة\nمثال: خذ قدر ما تريد. / أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب)",
 "カンカン": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة) / بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً) / بِحِدَّة, بِعُنْف (بطريقة عنيفة عاطفياً)\nمثال: صمت كسره نباح الكلاب بشراسة / بابتهاج, بسعادة (بطريقة مبهجة)\nمثال: صاحوا بسعادة",
 "カンカン帽": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح) / راكب القارب, ملاح (شخص يقود أو يركب قارباً)",
 "カンガルー": "كَنْغَر",
 "カンガルーねずみ": "كنغر جرذي (أي من عدة كنغر أسترالي يشبه الجرذ بحجم الأرنب) / جرذ الصحراء, جرذ كنغري (أي من القوارض القافزة المتنوعة في المناطق الصحراوية في أمريكا الشمالية والمكسيك؛ أكبر أعضاء فصيلة الفئران المتغايرة)",
 "カンガルーネズミ": "كنغر جرذي (أي من عدة كنغر أسترالي يشبه الجرذ بحجم الأرنب) / جرذ الصحراء, جرذ كنغري (أي من القوارض القافزة المتنوعة في المناطق الصحراوية في أمريكا الشمالية والمكسيك؛ أكبر أعضاء فصيلة الفئران المتغايرة)",
 "カンガルー鼠": "كنغر جرذي (أي من عدة كنغر أسترالي يشبه الجرذ بحجم الأرنب) / جرذ الصحراء, جرذ كنغري (أي من القوارض القافزة المتنوعة في المناطق الصحراوية في أمريكا الشمالية والمكسيك؛ أكبر أعضاء فصيلة الفئران المتغايرة)",
 "カンザクラ": "زهرة الربيع الصينية (زهرة ربيع آسيوية مزروعة)",
 "カンザス": "كَانْسَاس",
 "カンジキ": "حذاء ثلجي (جهاز يساعدك على المشي فوق الثلج العميق؛ إطار خفيف الوزن يشبه المضرب مقوى بقطع عرضية ويحتوي على شبكة من السيور؛ يلبس واحد في كل قدم)",
 "カンジキウサギ": "أرنب حذاء الثلج (أرنب بري كبير ذو أقدام كبيرة من أمريكا الشمالية؛ أبيض في الشتاء)",
 "カンジタ": "كانديدا, مبيضات (أي من الفطريات الناقصة الشبيهة بالخميرة من جنس كانديدا)",
 "カンジダ": "كانديدا, مبيضات (أي من الفطريات الناقصة الشبيهة بالخميرة من جنس كانديدا)",
 "カンジダしょう": "داء المبيضات, سفاد (عدوى تسببها فطريات من جنس المبيضات (خاصة المبيضة البيضاء))",
 "カンジダ症": "داء المبيضات, سفاد (عدوى تسببها فطريات من جنس المبيضات (خاصة المبيضة البيضاء))",
 "カンズメ": "أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب)",
 "カンゾウ": "زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل وزهور تشبه الزنبق صفراء عادة تتفتح ليوم واحد فقط)",
 "カンゾウタケ": "فطر شريحة اللحم (فطر صالح للأكل شائع بقبعة بلون الكبد أو اللحم النيئ؛ وفير في جنوب شرق الولايات المتحدة)",
 "カンタス": "كَانْتَاس",
 "カンタループ": "شمام كوز العسل, كنتالوب (ثمرة كرمة الكنتالوب؛ شمام صغير إلى متوسط الحجم ذو لحم مصفر) / شمام, كانتالوب (صنف من كرمة الشمام ذو ثمار بقشرة سمراء ولحم برتقالي)",
 "カンタロープ": "شمام كوز العسل, كنتالوب (ثمرة كرمة الكنتالوب؛ شمام صغير إلى متوسط الحجم ذو لحم مصفر) / شمام, كانتالوب (صنف من كرمة الشمام ذو ثمار بقشرة سمراء ولحم برتقالي)",
 "カンター": "ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "カンタータ": "أوراتوريو, كانتاتا (تأليف موسيقي للأصوات والأوركسترا مبني على نص ديني)",
 "カンタービレ": "انْسِيَابِيّ, سَلِس (سَلِسُ الأَدَاءِ وَمُتَدَفِّقٌ بِسُهُولَة)",
 "カンチョウ": "حُقْنَة شَرَجِيَّة, حُقْنَة",
 "カンチレバー": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "カンツリー": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "カンヅメ": "أغذية معلبة, طعام معلب (طعام محفوظ بالتعليب)",
 "カンテ": "سلسلة جبال",
 "カンティレバー": "دعمة, كابول (عارضة أفقية بارزة مثبتة من طرف واحد فقط)",
 "カンテラ": "فَانُوس",
 "カンデラ": "شمعة, شمعة معيارية (الوحدة الأساسية لشدة الإضاءة المعتمدة في النظام الدولي للوحدات؛ تساوي 1/60 من شدة الإضاءة لكل سنتيمتر مربع لجسم أسود يشع عند درجة حرارة 2046 كلفن)",
 "カント": "حافة مائلة, شطب (سطحان يلتقيان بزاوية تختلف عن 90 درجة) / كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي) / كلام معسول, نفاق (حديث غير صادق عن الدين أو الأخلاق) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "カントゥア": "بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / ملامح عامة, هيئة (ميزة (أو ترتيب الميزات) لأي شيء له هيكل معقد) / خط الكنتور, خط المناسيب (خط مرسوم على خريطة يربط بين النقاط المتساوية الارتفاع)\nمثال: بالكاد استطاع تمييز أشكالهم",
 "カントゥアー": "بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / ملامح عامة, هيئة (ميزة (أو ترتيب الميزات) لأي شيء له هيكل معقد) / خط الكنتور, خط المناسيب (خط مرسوم على خريطة يربط بين النقاط المتساوية الارتفاع)\nمثال: بالكاد استطاع تمييز أشكالهم",
 "カントカ": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "カントリー": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "カントリーアンドウェスタン": "موسيقى الريف الأمريكي, موسيقى الكانتري (نمط بسيط من الموسيقى الشعبية يسمع غالباً في جنوب الولايات المتحدة؛ يُعزف عادة على الآلات الوترية)",
 "カントリーアンドウエスタン": "موسيقى الريف الأمريكي, موسيقى الكانتري (نمط بسيط من الموسيقى الشعبية يسمع غالباً في جنوب الولايات المتحدة؛ يُعزف عادة على الآلات الوترية)",
 "カントリークラブ": "كانتري كلوب, نادي ريفي (نادي في الضواحي للترفيه والتواصل الاجتماعي)",
 "カントリーハウス": "منزل ريفي (منزل (عادة كبير ومثير للإعجاب) في عزبة في الريف)",
 "カントリーミュージック": "كانتري, موسيقى الكانتري",
 "カントリー・アンド・ウェスタン": "موسيقى الريف الأمريكي, موسيقى الكانتري (نمط بسيط من الموسيقى الشعبية يسمع غالباً في جنوب الولايات المتحدة؛ يُعزف عادة على الآلات الوترية)",
 "カントリー・クラブ": "كانتري كلوب, نادي ريفي (نادي في الضواحي للترفيه والتواصل الاجتماعي)",
 "カントリー・ハウス": "منزل ريفي (منزل (عادة كبير ومثير للإعجاب) في عزبة في الريف)",
 "カントリー・ミュージック": "كانتري, موسيقى الكانتري",
 "カントリー＆ウェスタン": "موسيقى الريف الأمريكي, موسيقى الكانتري (نمط بسيط من الموسيقى الشعبية يسمع غالباً في جنوب الولايات المتحدة؛ يُعزف عادة على الآلات الوترية)",
 "カントン": "كْوَنْغْدُنْغ, غْوَانْغْدُونْغ / قْوَانْغْتْشُو, غْوَانْغْجُو",
 "カントンご": "كَانْتُونِيّ, كَنْتُونِيّ / كَانْتُونِيَّة, كَنْتُونِيَّة",
 "カントンしょう": "كانتون, مقاطعة (تقسيم إداري صغير في دولة ما (كما في سويسرا))",
 "カンナ": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "カンナがけ": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "カンナダご": "اَلْكَانَادَا",
 "カンナダ語": "اَلْكَانَادَا",
 "カンナ掛け": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "カンニング": "تحايل, غش (خداع من أجل الربح الشخصي)",
 "カンノーリ": "كَانُّولِي",
 "カンバス": "خيش, قماش القنب (قماش ثقيل منسوج بإحكام) / أرضية الحلبة (البساط الذي يشكل أرضية الحلبة التي يتنافس فيها الملاكمون أو المصارعون المحترفون) / كانفاس, لوحة قماشية (لوحة زيتية على نسيج القنب (الكانفاس)) / خيمة قماشية (خيمة مصنوعة من نسيج القماش)\nمثال: نهض الملاكم عن أرضية الحلبة",
 "カンバセーション": "مُحَادَثَة / مُكَالَمَة / حِوَار / مُذَاكَرَة / مُحَاوَرَة / تَكَلُّم (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "カンパ": "تَبَرُّع, هِبَة / حَمْلَة",
 "カンパニア": "حَمْلَة",
 "カンパニュラ": "جريس, زهرة الجرس",
 "カンパニー": "سَرِيَّة / شَرِكَة",
 "カンパニーユニオン": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "カンパニー・ユニオン": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "カンパラ": "كَمْبَالَا",
 "カンファタブル": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "カンファレンシング": "مُؤْتَمَر",
 "カンファレンス": "مُؤْتَمَر",
 "カンファー": "كَافُور",
 "カンフォタブル": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "カンフル": "كَافُور / مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل)",
