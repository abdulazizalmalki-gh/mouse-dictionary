 "キャビティー": "تَجْوِيف",
 "キャビネット": "خزانة, دولاب (قطعة أثاث تشبه الخزانة ذات أبواب وأرفف وأدراج؛ للتخزين أو العرض) / خزانة الجهاز, كونسول (مبيت للأدوات الإلكترونية، مثل الراديو أو التلفزيون) / خزانة, دولاب (مقصورة تخزين للملابس والأشياء الثمينة؛ عادة ما يكون لها قفل) / حكومة, مجلس الوزراء (أشخاص يعينهم رئيس الدولة لرئاسة الإدارات التنفيذية للحكومة والعمل كمستشارين رسميين)",
 "キャビン": "زِمْلِك, خُصّ / قَمَرَة, قَمْرَة",
 "キャビンアテンダント": "مُضِيف, مُضِيفَة (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "キャビン・アテンダント": "مُضِيف, مُضِيفَة (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "キャピキャピ": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "キャピタリスト": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "キャピタリズム": "رَأْسْمَالِيَّة (الرَّسُمالبَّة : نظامٌ اقتصاديّ تكون فيه وسائل الانتاج مُلْكً لأَصحاب ِ الأَموال المُوَظَّفة؛ مجْموعُ الرَّأْسماايِّين أو البلدان الرَّأْسماليَّة)",
 "キャピタル": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "キャピタルゲイン": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "キャピタルゲインかぜい": "ضريبة الأرباح الرأسمالية (ضريبة تفرض على الأرباح الرأسمالية)\nمثال: لقد تجنب ضريبة الأرباح الرأسمالية عن طريق البيع على المكشوف",
 "キャピタルゲイン課税": "ضريبة الأرباح الرأسمالية (ضريبة تفرض على الأرباح الرأسمالية)\nمثال: لقد تجنب ضريبة الأرباح الرأسمالية عن طريق البيع على المكشوف",
 "キャピタルレター": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "キャピタルロス": "خسارة رأسمالية (المبلغ الذي يتجاوز به سعر شراء الأصل سعر البيع؛ تتحقق الخسارة عند بيع الأصل)",
 "キャピタル・ゲイン": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "キャピタル・レター": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "キャピタル・ロス": "خسارة رأسمالية (المبلغ الذي يتجاوز به سعر شراء الأصل سعر البيع؛ تتحقق الخسارة عند بيع الأصل)",
 "キャピトル": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود / كَابِيتُول الوِلَايَات المُتَّحِدَة",
 "キャピラリ": "شُعَيْرَة دَمَوِيَّة",
 "キャピラリー": "شُعَيْرَة دَمَوِيَّة",
 "キャフェ": "مَقْهًى, كَافِيه (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "キャフェテリア": "مَقْصَف, كَافِتِيرِيَا (خوان يستخدف في غرف الطعام لحفظ أدوات المائدة، وقد يوضع عليه الطعام استعدادا لنقله إلى المائدة؛ مكان اللهو في لعب وأكل وشرب)",
 "キャブ": "مَازِج / تاكسي, سيارة أجرة (سيارة يقودها شخص وظيفته نقل الركاب إلى حيث يريدون مقابل المال) / عربة كابريوليه (عربة صغيرة بعجلتين تجرها الخيول؛ بمقعدين وغطاء قابل للطي) / قمرة القيادة, كابينة السائق (مقصورة في مقدمة مركبة آلية أو قاطرة حيث يجلس السائق)",
 "キャブレター": "مَازِج",
 "キャプ": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "キャプション": "تعليق (وصف موجز مصاحب لرسم توضيحي) / ترجمة مرئية, سطر ترجمة (ترجمة الحوار الأجنبي لفيلم أو برنامج تلفزيوني؛ تُعرض عادة في أسفل الشاشة) / اعتراض تافه, مماحكة (إبداء اعتراض؛ خاصة المراوغة المبنية على حجة خادعة) / عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "キャプスタン": "رحوية, ملفاف (رافعة تدور في مستوى أفقي حول محور عمودي؛ تستخدم على السفن لرفع المرساة أو الأشرعة الثقيلة)",
 "キャプチャ": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "キャプチャー": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "キャプティブ": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "キャプテン": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "キャベジ": "مَلْفُوف, كُرُنْب",
 "キャベツ": "مَلْفُوف, كُرُنْب",
 "キャペリン": "كبلين (سمكة شمالية صغيرة جداً؛ غذاء للطيور البحرية والثدييات البحرية والأسماك الأخرى)",
 "キャミ": "قميص نوم قصير, نيجليجيه قصير (نيجليجيه قصير) / بروتيل, قميص داخلي نسائي (رداء داخلي قصير بلا أكمام للنساء)",
 "キャミソール": "قميص نوم قصير, نيجليجيه قصير (نيجليجيه قصير) / بروتيل, قميص داخلي نسائي (رداء داخلي قصير بلا أكمام للنساء)",
 "キャム": "حدبة, كامة (قرص دوار مُشكّل لتحويل الحركة الدائرية إلى حركة خطية)",
 "キャムコーダ": "كَامِيرَا فِيدِيُو (آلة تصوير، لصور ثابتة أو متحركة (فيديو). وتستخدم عدة عدسات في تركيب الكاميرا. وأول وصف لآلة التصوير عن ابن الهيثم في سياق دراسته علم البصريات وذلك في…)\nمثال: أريد هذه الكاميرا.",
 "キャムコーダー": "كَامِيرَا فِيدِيُو (آلة تصوير، لصور ثابتة أو متحركة (فيديو). وتستخدم عدة عدسات في تركيب الكاميرا. وأول وصف لآلة التصوير عن ابن الهيثم في سياق دراسته علم البصريات وذلك في…)\nمثال: أريد هذه الكاميرا.",
 "キャメラ": "كَمِرَة, كَامِيرَا\nمثال: おじさんがぼくにカメラをくれました。 — أعطاني عمي كاميرا.",
 "キャメル": "جَمَل, نَاقَة (حَسُنَ)\nمثال: يا لها من جملة!",
 "キャメルケース": "نسق الجمل (رتب أو نظم شيئًا بطريقة متناسقة؛ ضبط الأمور لتحقيق انسجام أو تناغم)",
 "キャメル・ケース": "نسق الجمل (رتب أو نظم شيئًا بطريقة متناسقة؛ ضبط الأمور لتحقيق انسجام أو تناغم)",
