 "カバー曲": "أغنية مقلدة, نسخة غلاف (تسجيل لأغنية تم تسجيلها أو اشتهرت لأول مرة بواسطة شخص آخر)\nمثال: قاموا بعمل نسخة مقلدة لأغنية لفرقة البيتلز",
 "カパー": "نُحَاس, نحاس (في : عنصرْ فِلزيّ قابل للطَّرْق ، يوصَف عادة بالأحمر لقرب لونه من الحمرة؛ ما سقَط من شرر الصُّفْر أو الحدود إِذا طُرق)\nمثال: هي تصهر النحاس.",
 "カビ": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "カビくさい": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "カビア": "كافيار (بطارخ مملحة لسمك الحفش أو أسماك كبيرة أخرى؛ يقدم عادة كمقبلات)",
 "カビ止め": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها)",
 "カビ臭い": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "カピカピ": "جَافّ المُعَامَلَة, خَشِن (فظ وعابس ومُنفِّر في التعامل) / ذُو قِشْرَة صُلْبَة, مُتَقَشِّر (ذو قشرة صلبة كغطاء)",
 "カピタル": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "カピタン": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "カピチュレーション": "اِسْتِسْلَام",
 "カピバラ": "خِنْزِير الْمَاء",
 "カピパラ": "خِنْزِير الْمَاء",
 "カフィエ": "كُوفِيَّة, شُمَاغ",
 "カフィーア": "كُوفِيَّة, شُمَاغ",
 "カフィーヤ": "كُوفِيَّة, شُمَاغ",
 "カフェ": "مَقْهًى, كَافِيه (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "カフェイン": "كَافِيِين",
 "カフェテリア": "مَقْصَف, كَافِتِيرِيَا (خوان يستخدف في غرف الطعام لحفظ أدوات المائدة، وقد يوضع عليه الطعام استعدادا لنقله إلى المائدة؛ مكان اللهو في لعب وأكل وشرب)",
 "カフェノワール": "قَهْوَة سَوْدَاء (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "カフェラッテ": "لَاتَيه",
 "カフェラテ": "لَاتَيه",
 "カフェロワイヤル": "كافيه رويال (قهوة سوداء مع الكونياك وقشر الليمون والسكر)",
 "カフェ・ノワール": "قَهْوَة سَوْدَاء (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "カフェ・ラッテ": "لَاتَيه",
 "カフェ・ラテ": "لَاتَيه",
 "カフェ・ロワイヤル": "كافيه رويال (قهوة سوداء مع الكونياك وقشر الليمون والسكر)",
 "カフェー": "مَقْهًى, كَافِيه (مكان عام تُقدَّم فيه المشروبات كالقهوة والشاي، وأحياناً الأطعمة الخفيفة؛ مكانٌ عامٌّ تقدم فيه القهوةُ ونحُوها من الأَشربة)\nمثال: هذا المقهى مريح.",
 "カフス": "ثنية الكم, كُفّة (طية تتكون من حاشية مقلوبة للخلف تطوق نهاية الكم أو الساق) / أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "カフスボタン": "كَبَكْ, وِثَاق اَلْكُفَّة",
 "カフタン": "قفطان (عباءة (من القطن أو الحرير) بأكمام كاملة ووشاح تصل إلى الكاحلين؛ يرتديها الرجال في بلاد الشام) / قفطان نسائي (طراز فستان نسائي يقلد عباءات القفطان التي يرتديها الرجال في الشرق الأدنى)",
 "カブ": "هِجْرِس, جَرْو (الثَعْلَب أو القِرْد أو ولده؛ كل ما يعسعس بالليل من الحيوان مما هو بين الثعلب واليربوع) / لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج. / تِسْعَة, تسعة",
 "カブスカウト": "شبل الكشافة (كشاف صغير)",
 "カブトウオ": "كَبير الرَّأْس (ذو رَأْس كَبير الحَجْم)",
 "カブトエビ": "روبيان الشرغوف (نوع من القشريات غلصميات الأرجل)",
 "カブトガニ": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "カブトムシ": "خنفساء وحيد القرن (أي من خنافس كبيرة استوائية بشكل رئيسي متنوعة لها قرون على الرأس؛ آفة على جوز الهند)",
 "カブナ": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "カブラ": "لِفْت ((لَوَاهُ) علَى غيرِ جِهَتِه؛ الصَّرْفُ)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "カブリオレ": "عربة كابريوليه (عربة صغيرة بعجلتين تجرها الخيول؛ بمقعدين وغطاء قابل للطي)",
 "カブ・スカウト": "شبل الكشافة (كشاف صغير)",
 "カブール": "كَابُل",
 "カプ": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "カプサイシン": "كابسيسين (مركب بلوري لاذع عديم اللون مشتق من الفليفلة؛ مصدر حرارة الفلفل الحار)",
 "カプセル": "كَبْسُولة\nمثال: 食後に２カプセル飲みなさい。 — خذ حبتين بعد الأكل.",
 "カプセルか": "تغليف, كبسلة (عملية التغليف (كما في كبسولة)) / تغليف, تكبسيل (حالة الانغلاق (كما في كبسولة))\nمثال: تغليف الأوتار في أغلفة غشائية",
 "カプセル化": "تغليف, كبسلة (عملية التغليف (كما في كبسولة)) / تغليف, تكبسيل (حالة الانغلاق (كما في كبسولة))\nمثال: تغليف الأوتار في أغلفة غشائية",
 "カプチーノ": "كَابُتْشِينُو, كَابُّتْشِينُو",
