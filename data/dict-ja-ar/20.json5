 "可愛らしい": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "可憐": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "可搬型": "مَحْمُول (اسم مفعول للفعل حَمَلَ)\nمثال: فقد حاسوبه المحمول.",
 "可搬式": "مَحْمُول (اسم مفعول للفعل حَمَلَ)\nمثال: فقد حاسوبه المحمول.",
 "可撓": "مَرِن",
 "可撓性": "مُرُونة",
 "可汗": "خَان (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "可決": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "可溶片": "فَتِيل / مُنْصَهِرَة, مصهر",
 "可用": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "可用性": "تَوَفُّر",
 "可祝": "اَلْمُخْلِص",
 "可笑しい": "مُضْحِك, هَزْلِيّ / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / مُريب, مَشبوه",
 "可笑しな": "مُضْحِك, هَزْلِيّ\nمثال: 先週の日曜日におかしな映画を見た。 — شاهدنا فلماً مضحكاً يوم الأحد الماضي. / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / مُريب, مَشبوه",
 "可算": "مَعْدُود",
 "可聴": "مسموع",
 "可能": "مُمْكِن",
 "可能な限り": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "可能にする": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "可能性": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل يتردد في النسبة بينهما، ويراد به الإمكان الذهني») / إِمْكَانِيَّة\nمثال: هناك احتمال أن لا ينجح. / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "可能性が低い": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "可能性の低い": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "可視": "رُؤْيَة",
 "可視化": "تَسْجِيل",
