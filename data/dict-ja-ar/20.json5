 "エッグシェイプ": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي)",
 "エッグノグ": "شراب البيض",
 "エッグノッグ": "شراب البيض",
 "エッグプラント": "بَاذِنْجَان, بَادِنْجَان",
 "エッグベネディクト": "بيض بينيديكت (مافن إنجليزي محمص مغطى بلحم وخنزير وبيضة مسلوقة (بدون قشر) وصلصة هولنديز)",
 "エッグ・ベネディクト": "بيض بينيديكت (مافن إنجليزي محمص مغطى بلحم وخنزير وبيضة مسلوقة (بدون قشر) وصلصة هولنديز)",
 "エッケホモ": "إيكه هومو, هذا هو الرجل (تمثيل (صورة أو نحت) ليسوع يرتدي إكليلاً من الشوك)",
 "エッケ・ホモ": "إيكه هومو, هذا هو الرجل (تمثيل (صورة أو نحت) ليسوع يرتدي إكليلاً من الشوك)",
 "エッジ": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "エッジのきいた": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "エッジの利いた": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "エッジの効いた": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال)",
 "エッジワースカイパーベルトてんたい": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "エッジワースカイパーベルト天体": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "エッジング": "تزيين الحواف, حاشية (حدود تتكون من أي شيء يوضع على الحافة لإنهاء شيء ما (مثل الأهداب على الملابس أو…)",
 "エッジー": "حَسَّاسُ الأَعْصَاب, عَصَبِيّ (فِي حَالَةِ تَوَتُّرٍ وَانْفِعَال) / مُتَطَوِّر, مُوَاكِب لِلعَصْر (مُتَوَافِق مَعَ أَحْدَث الأَفْكَار أَوِ الأَنْمَاط العَصْرِيَّة)",
 "エッセィ": "مَقَالَة, بَحْث",
 "エッセイ": "مَقَالَة, بَحْث",
 "エッセイスト": "أديب, كاتب مقالات (كاتب للأعمال الأدبية والمقالات)",
 "エッセン": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة.",
 "エッセンシャル": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي",
 "エッセンシャルオイル": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "エッセンシャル・オイル": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "エッセンス": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "エッセー": "مَقَالَة, بَحْث",
 "エッダ": "إيدا (أي من العملين المتميزين في اللغة الأيسلندية القديمة اللذين يعود تاريخهما إلى…)",
 "エッチ": "إنثالبي, محتوى حراري (كمية ديناميكية حرارية تساوي الطاقة الداخلية للنظام زائد حاصل ضرب حجمه وضغطه)\nمثال: المحتوى الحراري هو مقدار الطاقة في النظام القادر على القيام بعمل ميكانيكي / بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة / جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى…)\nمثال: أنا مثلي الجنس. / مُنْحَرِف, مُنْحَرِفَة",
 "エッチい": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "エッチアイブイ": "الإيدز, فيروس نقص المناعة البشرية (الفيروس الذي يسبب متلازمة نقص المناعة المكتسب (الإيدز)؛ يتكاثر في الخلايا…)",
 "エッチアール": "غرفة الصف الرئيسي (فصل دراسي يجتمع فيه جميع الطلاب في صف معين (أو في قسم من صف) في أوقات معينة تحت…) / إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً / ساعة (فترة زمنية تعادل 1/24 من اليوم)\nمثال: ستستغرق المهمة أكثر من ساعة / مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "エッチェホモ": "إيكه هومو, هذا هو الرجل (تمثيل (صورة أو نحت) ليسوع يرتدي إكليلاً من الشوك)",
 "エッチェ・ホモ": "إيكه هومو, هذا هو الرجل (تمثيل (صورة أو نحت) ليسوع يرتدي إكليلاً من الشوك)",
 "エッチエス": "هاسيوم (عنصر مشع ما بعد اليورانيوم، عدده الذري 108)",
 "エッチエスブイ": "الهربس البسيط, فيروس الهربس البسيط (فيروس هربس يصيب الجلد والجهاز العصبي)",
 "エッチエヌ": "اِسْم مُسْتَخْدِم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "エッチエフシー": "هيدروفلوروكربون (فلوروكربون ينبعث كمنتج ثانوي للتصنيع الصناعي)",
 "エッチシーエフシー": "هيدروكلوروفلوروكربون (فلوروكربون يحل محل الكلوروفلوروكربون كمبرد ووقود في علب الرش؛ يُعتبر أقل…)",
 "エッチティーエムエル": "إِتْش.تِي.إِم.إِل",
 "エッチディー": "قُرْص صُلْب / غسيل الكلى الدموي (غسيل الدم لإزالة المواد السامة أو النفايات الأيضية من مجرى الدم؛ يستخدم في حالة…) / شديد التحمل, للمهام الشاقة (مصمم للعمل الشاق)\nمثال: منظف للمهام الشاقة / إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما)\nمثال: تلك القبعة ملكي",
 "エッチディーエルシー": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / بروتين دهني عالي الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من نسبة عالية من البروتين وقليل…)",
 "エッチディーティーブイ": "تلفزيون عالي الوضوح (نظام تلفزيوني يحتوي على عدد أكبر من الخطوط لكل إطار بحيث تظهر صوره تفاصيل أكثر)",
 "エッチディーテレビ": "تلفزيون عالي الوضوح (نظام تلفزيوني يحتوي على عدد أكبر من الخطوط لكل إطار بحيث تظهر صوره تفاصيل أكثر)",
 "エッチディーディー": "قُرْص صُلْب",
 "エッチピー": "صَفْحَة رَئِيسِيَّة / حِصَان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "エッチピーブイ": "فيروس الورم الحليمي البشري (أي من مجموعة فيروسات بابوفا المرتبطة بالسرطانات التناسلية أو الفموية أو مجموعة…)",
 "エッチング": "حفر, نقش (عمل لوحات محفورة أو منقوشة وطباعة التصاميم منها)",
 "エッチ・アール": "غرفة الصف الرئيسي (فصل دراسي يجتمع فيه جميع الطلاب في صف معين (أو في قسم من صف) في أوقات معينة تحت…) / إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً / ساعة (فترة زمنية تعادل 1/24 من اليوم)\nمثال: ستستغرق المهمة أكثر من ساعة / مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "エッヂ": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "エッフェルとう": "بُرْج إِيفِل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "エッフェル塔": "بُرْج إِيفِل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "エッヘン": "نحنحة (إصدار صوت مشابه لتنظيف الحلق؛ يهدف لجذب الانتباه، أو التعبير عن التردد، أو ملء…)",
 "エティモロジー": "اِشْتِقَاق, تَأْثِيل",
 "エテ公": "سَعْدَان, قِرْد",
 "エディケーション": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "エディション": "طَبْعَة",
 "エディタ": "مُحَرِّر نُصُوص (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور. / مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
