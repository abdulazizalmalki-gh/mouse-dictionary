 "キリスト論": "علم المسيح, كريستولوجيا (فرع من اللاهوت يهتم بشخص وصفات وأعمال المسيح) / علم المسيح, كريستولوجيا (عقيدة أو نظرية دينية تستند إلى يسوع أو تعاليم يسوع)",
 "キリスト降誕祭": "الْكْرِيسْمَاس, الْمِيلَاد",
 "キリトリせん": "خط منقط (خط مكون من نقاط أو شرطات؛ يستخدم غالباً للإشارة إلى المكان الذي يجب التوقيع فيه على عقد (أو مستندات أخرى))\nمثال: فقط وقع على الخط المنقط",
 "キリトリ線": "خط منقط (خط مكون من نقاط أو شرطات؛ يستخدم غالباً للإشارة إلى المكان الذي يجب التوقيع فيه على عقد (أو مستندات أخرى))\nمثال: فقط وقع على الخط المنقط",
 "キリノミタケ": "نجمة تكساس (نبات حولي من تكساس بأوراق ريشية خشنة؛ يُزرع لرؤوس أزهاره الصفراء الشعاعية المبهرجة) / ساباتيا البراري, نجمة تكساس (عشب براري بزهور أرجوانية فاتحة منفردة)",
 "キリバス": "كِيرِيبَاتِي, كٍيرٍيبَاس",
 "キリバスご": "كِيرِيبَاتِي, كٍيرٍيبَاس",
 "キリバス語": "كِيرِيبَاتِي, كٍيرٍيبَاس",
 "キリモミ": "انحدار لولبي, سقوط مغزلي (هبوط سريع لطائرة في دوامة حادة) / انهيار عاطفي, تدهور سريع (فقدان السيطرة العاطفية مما يؤدي غالباً إلى انهيار عاطفي) / إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "キリル": "سِرِيلِيّ",
 "キリルもじ": "الأبجدية السيريلية, السيريلية (أبجدية مشتقة من الأبجدية اليونانية وتُستخدم لكتابة اللغات السلافية (الروسية، البلغارية، الصربية، الأوكرانية، وبعض اللغات السلافية الأخرى))",
 "キリル文字": "الأبجدية السيريلية, السيريلية (أبجدية مشتقة من الأبجدية اليونانية وتُستخدم لكتابة اللغات السلافية (الروسية، البلغارية، الصربية، الأوكرانية، وبعض اللغات السلافية الأخرى))",
 "キリン": "زَرَافَة (حيوان عشبي يتميز بالعنق الطويل)\nمثال: قتله ذكر زرافة.",
 "キリング": "مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "キリンレイヨウ": "جرنوق (ظبي شرق أفريقي نحيل ذو رقبة رفيعة وقرون منحنية للخلف)",
 "キル": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "キルギス": "قِيرْغِيزِسْتَان, قِرْغِيزْسْتَان",
 "キルギスきょうわこく": "الجمهورية القيرغيزية",
 "キルギスご": "قِيرْغِيزِيّ, قِيرْغِيزِيَّة",
 "キルギスじん": "قِيرْغِيزِيّ, قِيرْغِيزِيَّة",
 "キルギスタン": "قِيرْغِيزِسْتَان, قِرْغِيزْسْتَان",
 "キルギス人": "قِيرْغِيزِيّ, قِيرْغِيزِيَّة",
 "キルギス共和国": "الجمهورية القيرغيزية",
 "キルギス語": "قِيرْغِيزِيّ, قِيرْغِيزِيَّة",
 "キルク": "فِلِّينَة, فَدَام",
 "キルケ": "سيرسي ((الأساطير اليونانية) ساحرة احتجزت أوديسيوس في جزيرتها وحولت رجاله إلى خنازير)",
 "キルケー": "سيرسي ((الأساطير اليونانية) ساحرة احتجزت أوديسيوس في جزيرتها وحولت رجاله إلى خنازير)",
 "キルシュ": "كيرش (مشروب من عصير كرز موريلو الأسود المخمر)",
 "キルティング": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن) / تنجيد, خياطة اللحف (خياطة عبر طبقات من القماش والحشو لإنشاء تصميم)",
 "キルト": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / إزار اسكتلندي, كيلت (تنورة ترتان ذات طيات تصل للركبة يرتديها الرجال كجزء من الزي التقليدي في مرتفعات شمال اسكتلندا)",
 "キルヒホッフのほうそく": "قانونا كيرشوف ((فيزياء) قانونان يحكمان الشبكات الكهربائية التي تتدفق فيها تيارات ثابتة: مجموع كل التيارات عند نقطة هو صفر ومجموع مكاسب الجهد وهبوطه حول أي دائرة…)",
 "キルヒホッフの法則": "قانونا كيرشوف ((فيزياء) قانونان يحكمان الشبكات الكهربائية التي تتدفق فيها تيارات ثابتة: مجموع كل التيارات عند نقطة هو صفر ومجموع مكاسب الجهد وهبوطه حول أي دائرة…)",
 "キレる": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / إمساك, التقاط (فعل التقاط شيء باليدين) / فرقعة الأصابع (فعل فرقعة الأصابع؛ حركة إصبع من الطرف إلى قاعدة الإبهام في نفس اليد) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "キレイ": "جَمِيل, لَطِيف (حَسَن)\nمثال: طقس اليوم جميل. / نَظِيف / نضيف / نَظَّفَ / تَمَامًا",
 "キレイごと": "تستر, تلميع (تبرئة مخادعة تحاول التغطية على الإخفاقات والعيوب) / جير, طلاء جيري (غسول يتكون من الجير والغراء في الماء؛ يستخدم لتبييض الجدران والأسطح الأخرى) / هزيمة نظيفة (هزيمة يفشل فيها الشخص أو الفريق الخاسر في التسجيل)",
 "キレイさっぱり": "إِلَى الأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / بلا شائبة, بنظافة تامة (بطريقة خالية من البقع)\nمثال: نظيف تماماً",
 "キレイメ": "محترف الغش في الورق (لاعب ورق محترف يكسب عيشه عن طريق الغش في ألعاب الورق)",
 "キレイ好き": "هِنْدَام",
 "キレイ目": "محترف الغش في الورق (لاعب ورق محترف يكسب عيشه عن طريق الغش في ألعاب الورق)",
 "キレキレ": "رَشِيق, خَفِيف اَلْحَرَكَة",
