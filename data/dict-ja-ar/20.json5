 "クダクラゲ": "سحاريات (مستعمرة محيطية عائمة أو سابحة من السلائل غالباً ما تكون شفافة أو زاهية الألوان)",
 "クダモノトケイソウ": "ثَمَرَة زَهْرَة اَلْآلَام, فَاكِهَة زَهْرَة اَلْآلَام",
 "クダ狐": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "クチクラ": "بُشَيْرَة",
 "クチコミ": "تناقل الأخبار, كلمة الفم (انتشار القيل والقال عن طريق التواصل المنطوق)\nمثال: انتشر خبر علاقتهم عن طريق التناقل الشفهي",
 "クチジロジカ": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "クチナシ": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "クチバシ": "مِنْقَار",
 "クチャクチャ": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج) / فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "クチュリエ": "مصمم أزياء, مصمم ملابس (شخص متخصص في تصميم الملابس والموضة)",
 "クチン": "كوتين ((كيمياء حيوية) مادة شمعية شفافة توجد في بشرة النباتات وتتكون من استرات الأحماض الدهنية عالية البلمرة)",
 "クッ": "يَع",
 "クッと": "عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري. / بِسُرْعَة, عَاجِلًا",
 "クッカー": "إناء طهي, طباخ (أداة للطهي)",
 "クッキリ": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "クッキング": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "クッキー": "كُعَيْكَة / كُوكِي / بَسْكَوِيت",
 "クック": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "クックしょとう": "جُزُر كُوك (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "クックックッ": "قَرْقَرَة, مُنَاغَاة / هَدَلَ",
 "クックー": "وَقْوَاق, وَقْوَاقِيَّة",
 "クック諸島": "جُزُر كُوك (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "クッション": "وِسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وَسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وُسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / نُمْرُقَة / نِمْرِقَة / نَمْرَقَة\nمثال: غطى توم رأسه بوسادة.",
 "クッシングしょうこうぐん": "متلازمة كوشينغ (اضطراب غدي ناتج عن زيادة الكورتيزول)",
 "クッシングびょう": "فرط نشاط القشر الكظري, مرض كوشينغ",
 "クッシング病": "فرط نشاط القشر الكظري, مرض كوشينغ",
 "クッシング症候群": "متلازمة كوشينغ (اضطراب غدي ناتج عن زيادة الكورتيزول)",
 "クッソ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "クッバ": "كِبَّة, كُبَّة (المرة الواحدة من الانكباب؛ والأصح أن يُقال كَبَّة؛ جنس من طعام يُصنع غالبا من البُرْغُل وقد يكون من عجين الرُزّ ويُحشى باللحم وقد يقلى أو يشوى أو يطبخ مع اللبن أو غيره من الطعام)",
 "クッベ": "كِبَّة, كُبَّة (المرة الواحدة من الانكباب؛ والأصح أن يُقال كَبَّة؛ جنس من طعام يُصنع غالبا من البُرْغُل وقد يكون من عجين الرُزّ ويُحشى باللحم وقد يقلى أو يشوى أو يطبخ مع اللبن أو غيره من الطعام)",
 "クドい": "تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية / ثَقِيل / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / وليمة احتفالية ((في بريطانيا) وليمة احتفالية أو ترفيهية تقام في الكلية)",
 "クナクナ": "بترهل, برخاوة (بدون صلابة)\nمثال: كانت الجثة تتدلى برخاوة من الشجرة / بِدَلَال, بِغُنْج (بطريقة مغازلة)\nمثال: ابتسمت بغنج",
 "クネクネ": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "クパクパ": "نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: يبدو أن النبضات قادمة من نجم / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "クビ": "رَقَبَة, عُنُق / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / إِقَالَة",
 "クビにする": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "クビを切る": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "クビワペッカリー": "بيكاري مطوق (بيكاري رمادي داكن ذو طوق أبيض غير واضح؛ من المناطق شبه الصحراوية في المكسيك وجنوب غرب الولايات المتحدة)",
 "クピド": "كْيُوبِيد",
 "クピードー": "كْيُوبِيد",
 "クフィーヤ": "كُوفِيَّة, شُمَاغ",
 "クプレ": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "クマ": "دُبّ / دُبَّة / اِحْتَمَلَ / زَاوِيَة, رُكْن / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة)",
 "クマネズミ": "جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم)",
 "クマノミ": "سَمَكَة المُهَرِّج (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "クマバチ": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في دُبُرِها)",
 "クマムシ": "بطيء الخطو, دب الماء (مفصلي من شعبة بطيئات الخطو)",
 "クマンバチ": "دَبُّور, زُنْبُور (حشرة تشبه النحل إلا أنها أكبر ولا تنتج عسلا، لها قرصة مؤذية بواسطة إبرة في دُبُرِها)",
 "クミス": "كوميس (مشروب كحولي مصنوع من حليب الفرس المخمر؛ صنعه أصلاً بدو آسيا الوسطى)",
 "クミン": "كَمُّون",
 "クメールご": "لُغَة خِمِيرِيَّة, خِمِيرِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "クメールルージュ": "الْخَمِير الْحُمْر",
 "クメール・ルージュ": "الْخَمِير الْحُمْر",
 "クメール語": "لُغَة خِمِيرِيَّة, خِمِيرِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "クモ": "عَنْكَبُوت, شَبَث",
 "クモがたるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "クモの巣": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "クモるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
