 "オールド・ガード": "الحرس القديم (فصيل غير راغب في قبول أفكار جديدة)",
 "オールド・ファッション": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "オールド・ボーイ": "عجوز نشيط (رجل مسن مفعم بالحيوية)",
 "オールド・ミス": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق…)",
 "オールド・ローズ": "وردي عتيق (لون وردي رمادي)",
 "オールナイト": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "オールパーパス": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "オールボアール": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "オールボワール": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "オールマイティ": "كُلِّيّ القُدْرة, جَبّار / ورقة جوكر, ورقة حرة (ورقة لعب يمكن تحديد قيمتها من قبل الشخص الذي يحملها)\nمثال: كان الطقس عاملاً لا يمكن التنبؤ به",
 "オールマイティー": "كُلِّيّ القُدْرة, جَبّار / ورقة جوكر, ورقة حرة (ورقة لعب يمكن تحديد قيمتها من قبل الشخص الذي يحملها)\nمثال: كان الطقس عاملاً لا يمكن التنبؤ به",
 "オールラウンダー": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات",
 "オールヴォワール": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "オール・インクルーシブ": "شَامِل كُلّ شَيْء",
 "オール・オア・ナシング": "كُلٌّ أَوْ لَا شَيْء (يحدث بالكامل أو لا يحدث على الإطلاق)",
 "オール・オア・ナッシング": "كُلٌّ أَوْ لَا شَيْء (يحدث بالكامل أو لا يحدث على الإطلاق)",
 "オーレオマイシン": "أوريوميسين, كلورتيتراسايكلين (مضاد حيوي بلوري أصفر (الاسم التجاري أوريوميسين) يستخدم لعلاج بعض الأمراض…)",
 "オーロックス": "أُرْخُص (أَرْخَصَ السِّعرَ: جعله رخيصًا؛ وأَرْخَصَ الشيءَ: وجده رخيصًا أو اشتراه رخيصًا)\nمثال: أظنني سأشتري الأرخص.",
 "オーロラ": "شَفَق قُطْبِيّ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه:…)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "オーロラのかなたへ": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "オーロン": "أورلون (ألياف أكريليك أو القماش الخفيف الوزن المقاوم للتجاعيد المصنوع من خيوط الأورلون)",
 "オーヴン": "فُرْن, تَنُّور",
 "オー・エイチ": "إعادة تأهيل, تجديد (فعل التحسين عن طريق التجديد والاستعادة)\nمثال: إنهم يتابعون برنامجاً عاماً لتجديد العقار بأكمله",
 "オー・エス": "نِظَام تَشْغِيل (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "オー・エス・エス": "مَفْتُوح الْمَصْدَرِ",
 "オー・エル": "تراكب, طية (لسان يقع فوق جزء آخر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / مِلَاحَة",
 "オー・エル・イー・ディー": "صمام ثنائي عضوي باعث للضوء (صمام ثنائي ذاتي الإضاءة (يتوهج عند تطبيق مجال كهربائي على الأقطاب) لا يتطلب…)",
 "オー・ジェー・ティー": "أثناء العمل, وظيفي (متعلق بـ أو مرتبط بوظيفة أو توظيف)\nمثال: تدريب أثناء العمل",
 "オー・ジー": "خريجة (شخص أنثى حصلت على درجة علمية من مدرسة (ثانوية أو كلية أو جامعة))",
 "オー・ティー": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / اَلْعَهْد اَلْقَدِيم",
 "オー・ティー・シー": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "オー・ディー": "جُرْعَة زَائِدَة / عين يمنى (العين اليمنى) / سحب على المكشوف (سحب يتجاوز الرصيد الدائن)",
 "オー・デ・コロン": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "オー・ド・コロン": "كولونيا, ماء الكولونيا (سائل معطر مصنوع من الزيوت الأساسية والكحول)",
 "オー・ド・トワレ": "ماء تواليت (سائل معطر أخف تركيزاً من الكولونيا)",
 "オー・ビー": "عجوز نشيط (رجل مسن مفعم بالحيوية) / خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "オー・ピー": "شارة مُوسِيقِيّة / طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "オー・ペア": "أو بير, جليس أطفال أجنبي (شاب أجنبي يعيش مع عائلة مقابل القيام بأعمال منزلية خفيفة)",
 "オー・マイ・ガッ": "يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "オー・マイ・ガー": "يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "オー・マイ・ゴッド": "يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "カ": "بَعُوضَة, نَامُوسَة",
 "カアバ": "الْكَعْبَة, الْكَعْبَةُ ٱلْمُشَرَّفَة ((في الإسلام) قبلة المسلمين في صلواتهم؛ موقعها في المسجد الحرام في مكة، وهي أقدس…)\nمثال: الكعبة بيت الله.",
 "カイ": "خِي",
 "カイアシるい": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها…)",
 "カイアシ類": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها…)",
 "カイウ": "زنبق الكالا, كالا (نبات من جنوب إفريقيا يزرع على نطاق واسع لقنابته البيضاء النقية البارزة وطلعه…)",
 "カイエンヌ": "كَايِين",
 "カイエンヌペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً)",
 "カイエンヌ・ペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً)",
 "カイエンペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً)",
 "カイエン・ペッパー": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً)",
 "カイカイデ": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "カイカイデー": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "カイガラムシ": "حشرة قشرية (حشرة صغيرة من رتبة متشابهات الأجنحة تعيش وتتغذى عادة على النباتات وتفرز غطاء…)",
 "カイギュウ": "بقر البحر (أي من فصيلتين من الثدييات المائية العاشبة الكبيرة ذات ذيول مجدافية الشكل وأطراف…)",
 "カイク": "نعت مهين لليهودي ((إهانة عرقية) مصطلح مهين لليهودي)",
 "カイコ": "دُودَة اَلْقَزّ",
 "カイコガ": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير)",
 "カイザー": "قَيْصَر",
 "カイザーロール": "خبز كايزر, لفافة القيصر (لفافة مستديرة مخمرة تعلوها بذور الخشخاش مصنوعة من قطعة مربعة من العجين بطي…)",
 "カイザー・ロール": "خبز كايزر, لفافة القيصر (لفافة مستديرة مخمرة تعلوها بذور الخشخاش مصنوعة من قطعة مربعة من العجين بطي…)",
 "カイゼル": "قَيْصَر",
 "カイソウ": "إشْقِيل, بَصَل الفَأْر",
 "カイチュウ": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة…)",
 "カイツブリ": "غطاس صغير (غطاس أوروبي صغير) / غطاس (طائر مائي صغير مدمج الجسم بالكامل تقريباً يبني أعشاشاً عائمة؛ يشبه الغواص ولكنه…)",
 "カイト": "طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة.",
 "カイドウ": "تفاح بري جنوبي (شجرة صغيرة أو شجيرة من جنوب شرق الولايات المتحدة؛ تزرع للزينة لأزهارها الوردية…) / تفاح سيبيري بري (تفاح بري آسيوي يزرع في العديد من الأصناف لفاكهته الحمراء الصغيرة الحمضية عادة…)",
 "カイパーベルト": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "カイパー・ベルト": "حزام كايبر (منطقة على شكل قرص من الكواكب الصغيرة خارج مدار نبتون)",
 "カイマン": "كَيَامِن, كَيْمَن",
 "カイモグラフ": "راسم التموج, كيموجراف (أداة علمية تتكون من أسطوانة دوارة تحمل ورقاً يتتبع عليه قلم تسجيلاً مستمراً…)",
 "カイリ": "مِيل بَحْرِيّ",
 "カイリックス": "كيليكس",
 "カイロ": "الْقَاهِرَة (مدينة تقع في مِصر، وهي عاصمتها وأكبر مدنها؛ جمهورية القاهرة، وهي الجمهورية التي…)\nمثال: أسكن في القاهرة.",
 "カイロウドウケツ": "سلة زهرة فينوس (إسفنج بحري في المياه العميقة له هيكل أسطواني من شبكة زجاجية معقدة)",
 "カイロテック": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل…)",
 "カイロプラクター": "مُقَوِّم اَلْعِظَام",
 "カイロプラクチック": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل…)",
 "カイロプラクティック": "تقويم العمود الفقري, كايروبراكتيك (طريقة للعلاج تقوم بمعالجة هياكل الجسم (خاصة العمود الفقري) لتخفيف آلام أسفل…)",
 "カイロプラター": "مُقَوِّم اَلْعِظَام",
 "カイン": "قَابِيل, قَايِين ((في الإسلام) أحد أبناء النبي آدم، يُعرف بأول من سنَّ القتل، حيث قتل أخاه هَابِيل)",
 "カインド": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "カウ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "カウガール": "راعية بقر (امرأة تعمل في رعي البقر)",
 "カウチ": "فِرَاش, أَرِيكَة",
 "カウチソファ": "مَضْجَع",
 "カウチソファー": "مَضْجَع",
 "カウチポテト": "خَامِل",
 "カウチ・ソファ": "مَضْجَع",
 "カウチ・ソファー": "مَضْجَع",
 "カウチ・ポテト": "خَامِل",
 "カウハイド": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر)",
 "カウパー": "مَذْي",
 "カウパーえき": "مَذْي",
 "カウパーせん": "غُدَّة كَوْبَر",
 "カウパーせんえき": "مَذْي",
 "カウパー液": "مَذْي",
 "カウパー腺": "غُدَّة كَوْبَر",
 "カウパー腺液": "مَذْي",
 "カウベル": "جرس البقر (جرس يعلق حول رقبة البقرة بحيث يمكن تحديد مكانها بسهولة)",
 "カウボーイ": "رَاعِي بَقَر, رَعَوِيّ الْبَقَر",
 "カウボーイハット": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "カウボーイブーツ": "حذاء رعاة البقر (حذاء ذو قوس مرتفع وخياطة مزخرفة؛ يرتديه رعاة البقر الأمريكيون)",
 "カウボーイ・ハット": "قبعة رعاة البقر (قبعة بحافة واسعة وتاج ناعم؛ يرتديها عمال المزارع الأمريكية)",
 "カウボーイ・ブーツ": "حذاء رعاة البقر (حذاء ذو قوس مرتفع وخياطة مزخرفة؛ يرتديه رعاة البقر الأمريكيون)",
 "カウリング": "غطاء المحرك (غطاء واقٍ يتكون من جزء معدني يغطي المحرك)\nمثال: توجد محركات قوية تحت أغطية السيارات الجديدة",
 "カウル": "قلنسوة الراهب (غطاء رأس فضفاض أو رداء بغطاء رأس (كما يرتديه الراهب))\nمثال: توجد محركات قوية تحت أغطية السيارات الجديدة",
 "カウンシル": "مَجْلِس\nمثال: كان سامي يعيش في مجمع مسور.",
 "カウンセラー": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة)",
 "カウンセリング": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل)",
