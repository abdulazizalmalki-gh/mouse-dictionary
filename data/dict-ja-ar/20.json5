 "エコノミカル": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي",
 "エコノミクス": "عِلْم الاِقْتِصَاد (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "エコノミスト": "اِقْتِصَادِيّ",
 "エコノミック": "اِقْتِصَادِيّ",
 "エコノミックス": "عِلْم الاِقْتِصَاد (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "エコノミー": "اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد. / خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "エコノミークラス": "درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة…)",
 "エコノミークラスしょうこうぐん": "درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة…)",
 "エコノミークラス症候群": "درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة…)",
 "エコノミー・クラス": "درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة…)",
 "エコノメトリックス": "اقتصاد قياسي (تطبيق الرياضيات والإحصاء لدراسة البيانات الاقتصادية والمالية)",
 "エコファーマー": "صَدِيق لِلْبِيئَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "エコロケーション": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "エコロジ": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / حماية البيئة (نشاط حماية البيئة من التلوث أو الدمار)",
 "エコロジカル": "بِيئِيّ, إِيكُولُوجِيّ",
 "エコロジスト": "عالم بيئة (عالم أحياء يدرس العلاقة بين الكائنات الحية وبيئتها)",
 "エコロジー": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / حماية البيئة (نشاط حماية البيئة من التلوث أو الدمار)",
 "エコー": "صَدًى / الْمَوْجَات فَوْقَ الصَّوْتِيَّة",
 "エコーけんさ": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم…)",
 "エコーグラフィー": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم…)",
 "エコーチェンバー": "غُرْفَة الصَّدَى (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "エコール": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "エコールーム": "غُرْفَة الصَّدَى (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "エコーロケーション": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "エコー・チェンバー": "غُرْفَة الصَّدَى (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "エコー・ルーム": "غُرْفَة الصَّدَى (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "エコー検査": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم…)",
 "エゴ": "اَلْأَنَا / أَنَانِيَّة / أناني, متمركز حول ذاته (شخص يركز على ذاته ولا يقيم وزناً للآخرين)",
 "エゴい": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "エゴイスチック": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "エゴイスティック": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "エゴイスト": "أناني, متمركز حول ذاته (شخص يركز على ذاته ولا يقيم وزناً للآخرين)",
 "エゴイズム": "أَنَانِيَّة",
 "エゴチスト": "أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "エゴチスム": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات)",
 "エゴティスト": "أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "エゴティスム": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات)",
 "エゴティズム": "أنانية, حب الذات (رأي مبالغ فيه حول أهمية الذات)",
 "エゴノキ": "إصطرك ياباني, جرس الثلج الياباني (شجرة شجيرية في الصين والياباني)",
 "エサ": "أَطْعَمَ, غَذَّى / طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "エサやり": "إِطْعَام",
 "エシェリキア": "إشريكية قولونية (نوع من البكتيريا يوجد عادة في القناة المعوية للبشر والحيوانات الأخرى؛ ممرضة…)",
 "エシェリヒア": "إشريكية قولونية (نوع من البكتيريا يوجد عادة في القناة المعوية للبشر والحيوانات الأخرى؛ ممرضة…)",
 "エシカル": "أَخْلَاقِيّ",
 "エシックス": "أَخْلَاق, أَدَب",
 "エシャロット": "كراث أندلسي",
 "エジブト": "مِصْر, مصر (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر…)\nمثال: ولد سامي في مصر.",
 "エジプト": "مِصْر, مصر (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر…)\nمثال: ولد سامي في مصر.",
 "エジプトがく": "عِلْم اَلْمِصْرِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "エジプトご": "مِصْرِيّ",
 "エジプトじん": "مِصْرِيّ",
 "エジプトアラブきょうわこく": "جُمْهُورِيَّة مِصْر الْعَرَبِيَّة",
 "エジプトアラブ共和国": "جُمْهُورِيَّة مِصْر الْعَرَبِيَّة",
 "エジプトコブラ": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت)",
 "エジプトマングース": "نمس مصري (نمس من شمال أفريقيا؛ كان يُعتقد في العصور القديمة أنه يلتهم بيض التماسيح)",
 "エジプト・アラブ共和国": "جُمْهُورِيَّة مِصْر الْعَرَبِيَّة",
 "エジプト・コブラ": "صِل, كوبرا مصرية (كوبرا استخدمها الفراعنة كرمز لقوتهم على الحياة والموت)",
 "エジプト・マングース": "نمس مصري (نمس من شمال أفريقيا؛ كان يُعتقد في العصور القديمة أنه يلتهم بيض التماسيح)",
 "エジプト人": "مِصْرِيّ",
 "エジプト学": "عِلْم اَلْمِصْرِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "エジプト語": "مِصْرِيّ",
 "エジュケーション": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "エジンバラ": "إِدِنْبُرَة, إِدِنْبْرَة",
 "エス": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد…)\nمثال: كان عيسى يهوديا. / إنتروبيا, اعتلاج (كمية ديناميكية حرارية تمثل مقدار الطاقة في النظام التي لم تعد متاحة للقيام بعمل…)\nمثال: تزداد الإنتروبيا مع تحلل المادة والطاقة في الكون إلى حالة نهائية من التماثل الخامل / جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب. / كِبْرِيتِيّ / صَغِير, صغير",
 "エスきゅう": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ)",
 "エスご": "إِسْبِرَانْتُو",
 "エスじけっちょう": "قولون سيني",
 "エスじょうけっちょう": "قولون سيني",
 "エスアイ": "النظام الدولي للوحدات (نظام متري كامل لوحدات القياس للعلماء؛ الكميات الأساسية هي الطول (متر) والكتلة…)\nمثال: اليوم الولايات المتحدة هي الدولة الوحيدة في العالم غير الملتزمة كلياً بالنظام الدولي للوحدات",
 "エスアイシー": "غرفة صغيرة (غرفة صغيرة كبيرة بما يكفي للسماح بالدخول)\nمثال: غرفة الطوارئ كانت مكتظة بالزائرين دون موعد",
 "エスアイティー": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا. / جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من…)",
 "エスアイディーエス": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "エスイー": "مُؤَثِّر صَوْتِيّ",
 "エスイーエス": "مُحَرِّك بَحْث (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل. / الجَنُوب الشَّرْقِيّ (نقطة البوصلة في منتصف المسافة بين الجنوب والشرق؛ عند 135 درجة)",
 "エスイーエム": "مُحَرِّك بَحْث (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "エスイーオー": "مُحَرِّك بَحْث (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "エスエス": "محطة خدمة (محطة يتم فيها بيع البنزين والزيت وتتوفر فيها مرافق لإصلاح أو صيانة السيارات) / التوقف القصير, شورت ستوب (مركز اللعب للاعب في فريق البيسبول المتمركز بين القاعدة الثانية والثالثة) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء. / خِدْمَة سِرِّيَّة",
 "エスエスディー": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها)",
 "エスエスピーイー": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال…)",
 "エスエヌエス": "خدمة شبكات اجتماعية, موقع تواصل اجتماعي (منصة لبناء شبكات اجتماعية أو علاقات اجتماعية بين الأشخاص الذين يتشاركون…)\nمثال: تستخدم خدمات الشبكات الاجتماعية بشكل متزايد في التحقيقات القانونية والجنائية",
 "エスエヌピー": "تعدد أشكال النوكليوتيدات المفردة ((في علم الوراثة) تباين وراثي في تسلسل الحمض النووي يحدث عندما يتغير نيوكليوتيد…)",
 "エスエフ": "خَيَال عِلْمِيّ (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "エスエフえいが": "خَيَال عِلْمِيّ (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "エスエフエックス": "عنصر الإبهار (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي.",
 "エスエフエー": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "エスエム": "ماجستير العلوم (درجة الماجستير في العلوم) / مجمع تجاري, مركز تسوق (مؤسسة تجارية تتكون من مجمع من المحلات التجارية منسقة بعناية؛ تشمل عادة مطاعم…)\nمثال: يجب أن يحتوي مركز التسوق الجيد على دار سينما",
 "エスエムエス": "رِسَالَة, رِسَالَة إِس إِم إِس",
 "エスエル": "قِطَار بُخَارِيّ",
 "エスエルイー": "ذِئْبَة حَمْرَاء, ذِئْبَة حَمَامِيَّة مَجْمُوعِيَّة",
 "エスエー": "استراحة, منطقة خدمات (مكان على الطريق السريع يوفر خدمات المرآب ومرافق تناول الطعام والمراحيض)",
 "エスエーエス": "القوة الجوية الخاصة (فوج متخصص في الجيش البريطاني مدرب على تقنيات حرب الكوماندوز ويستخدم في العمليات…)",
 "エスエーティー": "السبت, يوم السبت (اليوم السابع والأخير من الأسبوع؛ يوم السبت عند اليهود)",
 "エスオーエス": "إشارة استغاثة, سوس (إشارة استغاثة معترف بها دولياً في شفرة الراديو)",
 "エスオーエックス": "أكسيد الكبريت (أي من أكاسيد الكبريت المتعددة)",
 "エスカッション": "تروسة, درع الشعار (ترس؛ خاصة ذلك الذي يعرض شعار النبالة)",
 "エスカベーシュ": "سِكْبَاج أَنْدَلُسِيّ",
 "エスカルゴ": "حَلَزُون",
 "エスカレ": "تَصْعِيد",
 "エスカレーション": "تَصْعِيد",
 "エスカレータ": "دَرَج مُتَحَرِّك, سُلَّم مُتَحَرِّك (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "エスカレータがっこう": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
