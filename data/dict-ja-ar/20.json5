 "国際博覧会": "مَعْرِض عَالَمِيّ",
 "国際司法裁判所": "مَحْكَمَة الْعَدْلَ الدُّوَلِيَّةِ (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "国際宇宙ステーション": "مَحَطَّةُ الفَضَاءِ الدُّوَلِيَّة",
 "国際性": "أُمَمِيَّة",
 "国際手話": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "国際機構": "منظمة دولية",
 "国際機関": "منظمة دولية",
 "国際法": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "国際温度目盛": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "国際的": "دُوَلِيّ / الدولية",
 "国際社会": "المُجْتَمَع الدُّوَلِيّ",
 "国際私法": "قَانُون دُوَلِيّ خَاصّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "国際空港": "مَطَار دُوَلِيّ (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "国際組織": "منظمة دولية",
 "国際補助語": "لغة مساعدة دولية (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "国際警察協会": "أصد ((أَصَّدَ) الثَّوْب: جعله أُصدة؛ (أَصَّدَ) الْجَارِيَة وَنَحْوهَا: ألبسها الأصدة)",
 "国際通貨基金": "صُنْدُوق اَلنَّقْد اَلدُّوَلِيّ (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "国際連合": "الْأُمَم الْمُتَّحِدَة",
 "国際連合児童基金": "يونيسيف",
 "国際連合教育科学文化機関": "يُونِسْكُو (مُنَظّمة الأمم المتحدة للتَّربية والعلوم والثَّقافة، والمقرّ الرَّئيسيّ لها باريس…)",
 "国際連合総会": "الْجَمْعِيَّةُ الْعَامَّةُ لِلْأُمَمِ الْمُتَّحِدَةِ",
 "国際連盟": "عُصْبَةْ اَلْأُمَم",
 "国際銀行間通信協会": "خُطَّاف",
