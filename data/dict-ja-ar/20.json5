 "カセット・テープ": "شريط كاسيت (علبة تحتوي على شريط مغناطيسي)",
 "カセット・デッキ": "كاسيت ديك, مشغل كاسيت (منفصل) (سطح شريط لتشغيل وتسجيل أشرطة الكاسيت)",
 "カセット・プレーヤー": "مشغل كاسيت (جهاز إلكتروني لتشغيل الكاسيتات)",
 "カセット・レコーダー": "مسجل كاسيت (مسجل لتسجيل أو تشغيل الكاسيتات)",
 "カセドラル": "كَاتِدْرَائِيَّة",
 "カセロール": "كَسْرُول, طَاجِن",
 "カゼ": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "カゼイン": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "カゼクサ": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "カソック": "ثوب الكاهن (رداء أسود يصل إلى الكاحلين؛ يرتديه الكهنة أو المنشدون)",
 "カソリック": "كَاثُولِيكِيّ, جَاثَلِيقِيّ",
 "カソード": "كاثود, مهبط (قطب كهربائي سالب الشحنة وهو مصدر الإلكترونات التي تدخل جهازاً كهربائياً) / قطب موجب, كاثود (الطرف الموجب الشحنة لخلية فولتية أو بطارية تخزين يوفر التيار)",
 "カタをつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "カタカタ": "قَعْقَعَ",
 "カタカナ": "كَاتَاكَانَا (ٱلْأَحْرُفَ ٱلْمُشَابِهَةَ لِلْهِيرَاغَانَا، ٱلَّتِي تُسْتَخْدَمُ لِكِتَابَةِ كَلِمَاتٍ غَيْرِ يَابَانِيَّةٍ وَأَسْمَاءٍ أَجْنَبِيَّةٍ…)",
 "カタギ": "نَزِيه, صَادِق",
 "カタクリ": "بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "カタコト": "بَقَّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا. / طقطقة (سلسلة من النقرات)",
 "カタコンブ": "سرداب الموتى (نفق تحت الأرض به تجاويف حيث كانت تُدفن الجثث (كما في روما القديمة))",
 "カタコンベ": "سرداب الموتى (نفق تحت الأرض به تجاويف حيث كانت تُدفن الجثث (كما في روما القديمة))",
 "カタストロフ": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "カタストロフィ": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "カタストロフィー": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "カタツムリ": "حَلَزُون",
 "カタトニー": "فصام تخشبي, فصام جامودي (شكل من أشكال الفصام يتميز بالميل للبقاء في حالة ذهول ثابتة لفترات طويلة؛ قد يفسح الجمود المجال لفترات قصيرة من الهياج الشديد) / جامود, كاتاتونيا (توتر مفرط؛ تصلب عضلي؛ عرض شائع في الفصام الجامودي)",
 "カタヌキ": "قطاعة البسكويت (أداة مطبخ تستخدم لقطع ورقة من عجين البسكويت إلى الأشكال المطلوبة قبل الخبز)",
 "カタバかぜ": "رياح هابطة (رياح ناتجة عن الحركة الهابطة للهواء البارد)",
 "カタバチックかぜ": "رياح هابطة (رياح ناتجة عن الحركة الهابطة للهواء البارد)",
 "カタバチック風": "رياح هابطة (رياح ناتجة عن الحركة الهابطة للهواء البارد)",
 "カタバ風": "رياح هابطة (رياح ناتجة عن الحركة الهابطة للهواء البارد)",
 "カタパルト": "مَنْجَنِيق, مِرْجَام",
 "カタピラ": "جنزير, مسار كاتربيلر (حزام معدني لا نهائي تتحرك عليه المركبات المجنزرة فوق الأرض)",
 "カタピラー": "جنزير, مسار كاتربيلر (حزام معدني لا نهائي تتحرك عليه المركبات المجنزرة فوق الأرض)",
 "カタプルト": "مَنْجَنِيق, مِرْجَام",
 "カタマラン": "طوف, كاتاماران (قارب ذو بدنين متوازيين مرتبطين ببعضهما بسطح واحد)",
 "カタランご": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "カタラン語": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "カタラーゼ": "كاتالاز (إنزيم يوجد في معظم الخلايا النباتية والحيوانية يعمل كمحفز مؤكسد؛ يحلل بيروكسيد الهيدروجين إلى أكسجين وماء)",
 "カタリは": "الألبيجان, الكاثار (طائفة دينية مسيحية في جنوب فرنسا في القرنين الثاني عشر والثالث عشر)",
 "カタリ派": "الألبيجان, الكاثار (طائفة دينية مسيحية في جنوب فرنسا في القرنين الثاني عشر والثالث عشر)",
 "カタル": "نَزْلَة",
 "カタルせい": "نزلي (من أو متعلق بالنزلات (التهاب الأغشية المخاطية))\nمثال: الحمى النزلية هي أي من عدة أمراض تنفسية أو فموية للماشية مثل اللسان الأزرق في الخيول والأغنام",
 "カタルシス": "تَنْفِيس",
 "カタルニャ": "كَاتَالُونِيَا / كَتَلُونِيَا / قَطَلُونِيَة",
 "カタルーニャ": "كَاتَالُونِيَا / كَتَلُونِيَا / قَطَلُونِيَة",
 "カタルーニャご": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "カタルーニャ語": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "カタル性": "نزلي (من أو متعلق بالنزلات (التهاب الأغشية المخاطية))\nمثال: الحمى النزلية هي أي من عدة أمراض تنفسية أو فموية للماشية مثل اللسان الأزرق في الخيول والأغنام",
 "カタレプシー": "تَخَشُّب",
 "カタログ": "فهرس, كتالوج (كتاب أو كتيب يحتوي على حصر للأشياء) / فهرس, كتالوج (قائمة كاملة بالأشياء؛ عادة ما تكون مرتبة بشكل منهجي)\nمثال: وجده في كتالوج سيرز",
 "カタロニア": "كَاتَالُونِيَا / كَتَلُونِيَا / قَطَلُونِيَة",
 "カタロニアご": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "カタロニア語": "كَاتَالَانِيّ, كَاتَالَانِيَّة",
 "カタンのかいたくしゃたち": "مُسْتَوْطِن, مُسْتَعْمِر",
 "カタンの開拓者たち": "مُسْتَوْطِن, مُسْتَعْمِر",
 "カタール": "قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر.",
 "カタールこく": "دولة قطر (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "カタール国": "دولة قطر (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "カダベリン": "كادافيرين",
 "カダヤシ": "سمكة البعوض (سمكة فضية ذات صفوف من البقع السوداء تعيش في أمريكا الشمالية الاستوائية وجزر الهند الغربية؛ مهمة في مكافحة البعوض)",
 "カチこみ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "カチっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "カチオン": "أَيُون مُوجَب, كَاتْيُون (أيون موجب الشحنة)",
 "カチカチ": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "カチコチ": "تيك تاك (صوت تكتكة متكرر ثابت كما تصدره الساعة) / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني) / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ)",
 "カチコミ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "カチッと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "カチャカチャ": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "カチューシャ": "طَوْق شَعَر (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / كَاتْيُوشَا",
 "カチン": "حبس, سجن (مؤسسة إصلاحية تستخدم لاحتجاز الأشخاص الموجودين في الحجز القانوني للحكومة (إما متهمين ينتظرون المحاكمة أو مدانين يقضون عقوبة)) / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "カチンご": "كاشين",
 "カチンカチン": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "カチンコ": "كلاكيت, لوحة التصفيق (معدات تصوير فوتوغرافي تستخدم لمزامنة الصوت والصورة المتحركة؛ لوحات تضرب معاً أمام كاميرا الفيلم)",
 "カチンコチン": "تحطم, رنين (ضجيج رنان عالٍ ومتكرر)\nمثال: كان بإمكانه سماع رنين الأجراس البعيدة",
 "カチン語": "كاشين",
 "カチ割る": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "カチ込み": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "カッとなる": "اِنْدَلَعَ",
 "カッキリ": "بِالضَّبْط, تَمَامًا / بِالْضَبْط / بانتظام, في الموعد (في الوقت المتوقع أو المناسب)\nمثال: تصل دائماً في الموعد",
 "カッケェ": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "カッケー": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "カッコ": "شَرِيحَة / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / مُنَاسِب, مُلَائِم",
 "カッコいい": "جَذَّاب",
 "カッコつき": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟ / شَرِيحَة",
 "カッコよい": "جَذَّاب",
 "カッコイイ": "جَذَّاب",
 "カッコ付き": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟ / شَرِيحَة",
 "カッコ内": "شَرِيحَة",
 "カッコ悪い": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "カッタウェイ": "معطف ذيل, معطف مشطوف (معطف رجالي مقصوص بشكل قطري من الخصر إلى خلف الركبتين) / رسم مقطعي (تمثيل (رسم أو نموذج) لشيء ما يتم فيه حذف الجزء الخارجي للكشف عن الأجزاء الداخلية)",
 "カッタウエイ": "معطف ذيل, معطف مشطوف (معطف رجالي مقصوص بشكل قطري من الخصر إلى خلف الركبتين) / رسم مقطعي (تمثيل (رسم أو نموذج) لشيء ما يتم فيه حذف الجزء الخارجي للكشف عن الأجزاء الداخلية)",
 "カッター": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس)) / مِشْرَط",
