 "風鈴": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب…)",
 "風鈴草": "جريس متوسط, كأس وصحن (نبات أوروبي ثنائي الحول يزرع على نطاق واسع لأزهاره الزرقاء أو البنفسجية أو…)",
 "風鐸": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب…)",
 "風間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "風防": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية) / قَرِيس, قَرِيت",
 "風防ガラス": "زُجَاج السَيَّارَة الأَمَامِيّ",
 "風除け": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "風除室": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "風雅": "أَنَاقَة",
 "風雨": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "風雪": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية) / مَشَقَّة, شِدَّة",
 "風雲": "طَبِيعَة, طبيعة / حَالَة, وَضْع",
 "風雲児": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "風雷益": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "風霜": "مَشَقَّة, شِدَّة",
 "風露草": "غُرْنُوق",
 "風靡": "غَالِب",
 "風韻": "أَنَاقَة",
 "風鳥": "طائر الجنة (أي من الطيور العديدة ذات الريش الملون ببراعة في منطقة غينيا الجديدة)",
 "颯々": "سرقة الماشية (سرقة الماشية)",
 "颯爽": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل)",
 "颯颯": "سرقة الماشية (سرقة الماشية)",
 "颶風": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء…)\nمثال: السطح دمر من قبل الإعصار.",
 "颺言": "مِهْنَة\nمثال: ما وظيفة زوجتك؟",
 "飄": "زَوْبَعَة / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة)",
 "飄々": "صفير (فعل الصفير بلحن)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير)",
 "飄然": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين / مُسْتَقِلّ, مُنْفَصِل (يستخدم للمباني؛ قائمة بمعزل عن غيرها)\nمثال: منازل منفصلة",
 "飄逸": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير)",
 "飄零": "تجوال, هيام (السفر دون وجهة واضحة)\nمثال: تبعته في ترحاله واعتنت به",
 "飄飄": "صفير (فعل الصفير بلحن)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير)",
 "飛": "غُدَاف\nمثال: هو يعيش في قلعة. / فلاي بول, كرة طائرة ((بيسبول) ضربة تطير عالياً في الهواء)",
 "飛ばし携帯": "جَوَّال, هَاتِف مَحْمُول (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)",
 "飛ばす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن…) / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم)\nمثال: رشقة من الرصاص / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "飛び": "طيران (حالة السفر جواً)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته…) / سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…) / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "飛びっきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛びっ切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛びぬけて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "飛びはねる": "نَقْز",
 "飛び上がる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "飛び入り": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "飛び出しナイフ": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "飛び出す": "نَفِدَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَتَأَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "飛び出す絵本": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند…)",
 "飛び出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "飛び切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛び去る": "نَثَرَ, تَفَرَّقَ",
 "飛び地": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛び子": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "飛び将棋": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "飛び抜けて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "飛び散る": "نَثَرَ, تَفَرَّقَ",
 "飛び板": "منطلق",
 "飛び石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "飛び移る": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)",
 "飛び立つ": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)",
 "飛び翔る": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "飛び蝗虫": "جَرَادَة",
 "飛び越える": "شَفَّاف / قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "飛び越し": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "飛び跳ねる": "نَقْز",
 "飛び蹴り": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة…)",
 "飛び込み": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "飛び込み台": "لوح الغطس (لوح قفز يمكن للسباحين الغطس منه)",
 "飛び込み営業": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "飛び込む": "غَاصَ",
 "飛び道具": "سِلَاح نَارِيّ",
 "飛び領土": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛び飛び": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "飛び魚": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "飛び魚の子": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة\nمثال: أسرع و إلا تأخرت.",
 "飛ぶ火": "ضوء الإشارة, نار الإشارة (نار تُشعل كإشارة)",
 "飛ぶ鳥": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "飛べない鳥": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام…)",
 "飛んで": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته…) / طيران (حالة السفر جواً)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "飛地": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛子": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "飛将棋": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "飛揚": "طيران (حالة السفر جواً)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "飛散": "بعثرة, نثر (عملية البعثرة)",
 "飛散る": "نَثَرَ, تَفَرَّقَ",
 "飛散防止": "مُضَادٌّ لِلتَّشَظِّي, مُقَاوِمٌ لِلتَّحَطُّم (مُقَاوِمٌ لِلتَّحَطُّمِ أَوِ التَّشَظِّي)",
 "飛板": "منطلق",
 "飛沫": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم)\nمثال: رشقة من الرصاص / رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / قُطَيْرَة",
 "飛泉": "شَلَّال",
 "飛燕草": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور…)",
 "飛球": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "飛田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飛留間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飛石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "飛礫": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "飛竜": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه…)",
 "飛節": "عرقوب (المفصل الرصغي للساق الخلفية للثدييات ذوات الحوافر؛ يقابل الكاحل البشري)",
 "飛翔": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "飛翔体": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام)",
 "飛脚": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "飛蜥蜴": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه…)",
 "飛蝗": "جَرَادَة",
 "飛螻蛄": "ذباب كاديس, ذبابة القمص (حشرة صغيرة تشبه العثة لها زوجان من الأجنحة الغشائية المشعرة ويرقات مائية)",
 "飛行": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "飛行の三鈷": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "飛行体": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة.",
 "飛行便": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "飛行場": "مَهْبِط, مَدْرَج",
 "飛行士": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "飛行家": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "飛行機": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة.",
 "飛行機酔い": "داء الجو, دوار الجو (دوار الحركة الذي يحدث أثناء السفر بالطائرة (خاصة أثناء الاضطرابات الجوية))",
 "飛行機雲": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح…)",
 "飛行甲板": "سطح الطيران (السطح العلوي لحاملة طائرات؛ يستخدم كمدرج)",
 "飛行禁止空域": "مِنْطَقَةُ حَظْرِ الطَّيَرَان (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "飛行船": "سفينة هوائية, منطاد موجه (طائرة ذاتية الدفع قابلة للتوجيه)",
 "飛行艇": "قارب طائر (طائرة مائية كبيرة تطفو ببدنها في الماء بدلاً من استخدام عوامات)",
 "飛行隊": "سِلَاح طَيَرَان",
 "飛行雲": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح…)",
 "飛語": "نَمِيمَة, إِشَاعَة",
 "飛越": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل)",
 "飛越し": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "飛距離": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "飛跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "飛跳ねる": "نَقْز",
 "飛躍": "وَثَبَ (طَفَرَ أو قَفَزَ وهو يجري)",
 "飛躍的": "عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة)",
 "飛車": "غُدَاف\nمثال: هو يعيش في قلعة.",
 "飛輪": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…) / حَدَّافَة",
 "飛込み": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة…)\nمثال: قفز من النافذة.",
 "飛道具": "سِلَاح نَارِيّ",
 "飛雪": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "飛魚": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "飛魚座": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي…)",
 "飛鳥": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "飛鼠": "وَطْوَاط, خُفَّاش",
 "飛龍": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه…)",
 "飜": "أُسْرَة هَان",
 "飜って": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "食": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / كُسُوف, خُسُوف",
 "食あたり": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食い": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / عَضَّ, قَضَمَ",
 "食いしばる": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "食いしん坊": "أَكَّال, شَرَه",
 "食いすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食いつき": "عَضَّ, قَضَمَ",
 "食いつく": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى",
 "食いで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食い下がる": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا…)\nمثال: كان الكلب ميتا.",
 "食い付き": "عَضَّ, قَضَمَ",
 "食い付く": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى",
 "食い入るように": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "食い出": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食い合わす": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "食い合わせ": "تَعْشِيقَة\nمثال: أغاني العشق تحرك مشاعري.",
 "食い尽くし系": "أَكَّال, شَرَه",
 "食い意地": "نَهَم, شَرَه",
 "食い戻し": "اجترار",
 "食い摘み": "السَّنَة الْجَدِيدَة",
 "食い止める": "تَفَقُّد",
 "食い残し": "الْبَقَايَا",
 "食い殺す": "اِلْتَهَمَ",
 "食い気": "شَهِيَّة",
 "食い気味": "قَاطَعَ",
 "食い物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / فَرِيسَة",
 "食い物屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食い積み": "السَّنَة الْجَدِيدَة",
 "食い締める": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "食い縛る": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "食い荒す": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "食い荒らす": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد)\nمثال: من سرق التفاحة؟",
 "食い足りない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)",
 "食い込み": "توغل, غارة (تعدٍ أو اقتحام)\nمثال: قاموا بتوغلات في سوق الولايات المتحدة / عَجْز / حذاء وتدي (حذاء بكعب وتدي متصل)",
 "食い込む": "اِخْتَلَسَ, أَزْعَجَ",
 "食い過ぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食い道楽": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "食い違い": "فَرْق, اِخْتِلَاف",
 "食い違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر…)\nمثال: أنا اختلف معك في الرأي.",
 "食い違った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "食う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي. / عَضَّ, قَضَمَ / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "食えない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ)\nمثال: إنها حاذقة الذكاء. / غير صالح للأكل (غير مناسب كطعام)",
 "食す": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "食する": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "食った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "食ってかかる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "食って掛かる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "食べかす": "الْبَقَايَا",
 "食べきれない": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "食べごたえ": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食べた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "食べで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べどころ": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べにくい": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "食べる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "食べカス": "الْبَقَايَا",
 "食べ処": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べ出": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べ切れない": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "食べ合わせ": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد)",
 "食べ応え": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べ残し": "الْبَقَايَا",
 "食べ比べる": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "食べ滓": "الْبَقَايَا",
 "食べ物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食べ物屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べ粕": "الْبَقَايَا",
 "食べ過ぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食べ難い": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "食み": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "食み出す": "نَتَأَ / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "食み出る": "نَتَأَ / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "食み物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)",
 "食む": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "食らいつく": "قَضَمَ",
 "食らい付く": "قَضَمَ",
 "食らう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "食らわす": "اِتِّفَاقِيَّة",
 "食らわせる": "اِتِّفَاقِيَّة",
 "食わす": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "食わせる": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "食わせ物": "مُزَيَّف / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "食わせ者": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "食を断つ": "عميق\nمثال: صام ياني رمضان.",
 "食パン": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو…)\nمثال: هذا الخبز لذيذ.",
 "食中り": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食中毒": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食事": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / حِمْيَة, حِمْيَة غِذَائِيَّة",
 "食事会": "حفل عشاء, عزومة عشاء (حفلة يجتمع فيها الناس لتناول العشاء معاً)\nمثال: يجب ألا يتأخر الضيوف عن حفل العشاء أبداً",
 "食事処": "مَطْعَم",
 "食事券": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة)",
 "食事時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "食事療法学": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "食人": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "食人族": "غُول, آكِلُ لُحُوم البَشْر",
 "食人種": "غُول, آكِلُ لُحُوم البَشْر",
 "食付き": "عَضَّ, قَضَمَ",
 "食作用": "بلعمة (عملية تقوم فيها الخلايا البلعمية بابتلاع وهضم الكائنات الحية الدقيقة والحطام…)",
 "食俸": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "食傷": "إفراط في الأكل, تخمة (الأكل حتى الامتلاء المفرط) / اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食処": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食券": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة)",
