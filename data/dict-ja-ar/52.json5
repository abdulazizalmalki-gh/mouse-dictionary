 "高岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高岩": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高嶺": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高巣": "عش (أي مسكن على ارتفاع شاهق (مثل عش النسر)) / وَكْر (العش المرتفع لطائر جارح (مثل الصقر أو النسر))",
 "高巻": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "高市": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高師": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高帯域ネットワーク": "شبكة واسعة النطاق, وان (شبكة كمبيوتر تغطي مساحة أوسع مما تغطيه الشبكة المحلية)",
 "高年": "شَيْخُوخَة, عُجُوز",
 "高年齢": "مُعَتَّق ((عَنِ التَّبْغ) مُعَتَّق كَعَمَلِيَّة حِفْظ) / مُعَتَّق, نَاضِج (بلغ الحالة المرغوبة أو النهائية (للنبيذ أو الفاكهة أو الجبن)) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / مُتَآكِل, هَرِم (فِي مَرْحَلَةٍ مُتَقَدِّمَةٍ مِنَ التَّعْرِيَةِ)",
 "高年齢化": "آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة) / تقدم في السن, شيخوخة (العملية العضوية للتقدم في العمر وظهور آثار زيادة السن) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت)",
 "高度": "اِرْتِفَاع / مُرْتَفِع الدَّرَجَة",
 "高度交通システム": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "高度化": "تَرْقِيَة",
 "高度技術": "تكنولوجيا متطورة, عالي التقنية (يشبه أو يستخدم تكنولوجيا أو أجهزة متقدمة للغاية)",
 "高度計": "ألتيمتر, مقياس الارتفاع (أداة تقيس الارتفاع فوق الأرض؛ تستخدم في الملاحة)",
 "高度通信システム相互接続": "قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "高度道路交通システム": "هُوَ, هِيَ / ـهُ (الحرف السادس والعشرون من الأحرف الهجائية؛ يسبقه \"ن\"، ويتلوه \"و\"؛ اختصارًا لـ\"لِلْهِجْرَة\"، تُكتب بعد التاريخ لتدل على أنه في التقويم الهجري)",
 "高座": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "高徳": "قداسة (صفة التشبه بالقديس)",
 "高忠実度": "دقة عالية (إعادة إنتاج الصوت مع قليل من التشويه أو بدونه)",
 "高性能": "عَالِي الأَدَاء (مُعدَّل لتقديم أداء متفوق)",
 "高性能爆薬": "مادة شديدة الانفجار, متفجرات قوية (مادة كيميائية متفجرة قوية تنتج غازاً بمعدل مرتفع جداً)",
 "高感度": "ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد) / حَاذِق, مُمَيِّز (قَادِر عَلَى إِدْرَاك الفُرُوقَات الدَّقِيقَة؛ حَسَّاس) / سَرِيعُ الفَهْم, فَطِن (سَرِيعُ الإِدْرَاكِ وَالاسْتِيعَاب) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: ناقد فطن",
 "高慢": "مُتَعَالٍ, الْمُتَعَالِي",
 "高慢ちき": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية. / مُتَعَالٍ, المُتَعَالِي",
 "高成長": "صعود سريع, نمو سريع (ارتفاع سريع)",
 "高所": "أرضية عليا, تفوق (موقف تفوق على الخصوم أو المنافسين)",
 "高所恐怖症": "رهاب المرتفعات (خوف مرضي من المرتفعات الشاهقة)",
 "高所病": "داء المرتفعات (آثار (مثل نزيف الأنف أو الغثيان) نقص الأكسجين في الدم والأنسجة على ارتفاعات عالية)",
 "高承": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "高捲き": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "高揚": "منسوب",
 "高揚感": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله)) / سرب قُبَّرَات (سرب من طيور القُبَّرَة (خاصة أثناء الطيران)) / شرف (موقع كوكب في دائرة البروج يُعتقد أنه يمارس فيه أقصى تأثير له) / انخطاف, طرب (حالة من الانجراف وراء عاطفة غامرة)\nمثال: الاستماع إلى الموسيقى العذبة في نشوة تامة",
 "高春": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高松": "تَاكَامَاتْسُو",
 "高架": "مُرْتَفِع (ازداد في الكمّية أو الدرجة) / مُرْتَفِع عَنِ الأَرْض (مرفوع فوق سطح الأرض) / رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه) / سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "高架橋": "جسر طويل, جسر قناطر (جسر يتكون من سلسلة من الأقواس المدعومة بأرصفة يستخدم لحمل طريق (أو سكة حديد) فوق وادٍ)",
 "高架線": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "高架鉄道": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "高架駅": "سكة حديد معلقة, قطار معلق (سكة حديد تعمل بالكهرباء وتسير على مسار مرتفع فوق مستوى الشارع)",
 "高柳": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高校": "مدرسة ثانوية, مدرسة ثانوية عليا (مدرسة ثانوية عامة تشمل عادة الصفوف من 9 إلى 12)\nمثال: يذهب إلى المدرسة الثانوية في الحي",
 "高校卒業生": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "高校生": "مدرسة ثانوية, مدرسة ثانوية عليا (مدرسة ثانوية عامة تشمل عادة الصفوف من 9 إلى 12)\nمثال: يذهب إلى المدرسة الثانوية في الحي",
 "高梁": "كوليانغ (سورغم الصين ومنشوريا له حبوب بيضاء أو بنية صغيرة (تستخدم للغذاء) وسيقان لبية جافة (تستخدم للعلف والوقود والتسقيف))",
 "高梨": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高森": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高楼": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "高機能": "عَالِي الأَدَاء (مُعدَّل لتقديم أداء متفوق)",
 "高機能携帯電話": "هَاتِف ذَكِيّ, سِمَارْت فُون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "高欄": "درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / سياج, مادة الدرابزين (مادة لصنع القضبان أو الحواجز بشكل جماعي) / مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "高次": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / رَفِيع المُسْتَوَى (في مستوى مرتفع من الرتبة أو الأهمية)",
 "高次言語": "لغة واصفة, ميتالغة (لغة يمكن استخدامها لوصف اللغات)",
 "高殿": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高気圧": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "高水準言語": "لغة عالية المستوى (لغة موجهة للمشاكل تتطلب معرفة قليلة بالحاسوب الذي ستعمل عليه)",
 "高浮き彫り": "نقش بارز عالي (نحت بارز تبرز فيه الأشكال من الخلفية لنصف عمقها على الأقل)",
 "高浮彫": "نقش بارز عالي (نحت بارز تبرز فيه الأشكال من الخلفية لنصف عمقها على الأقل)",
