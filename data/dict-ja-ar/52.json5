 "高速鉄道": "سِكَّةٌ حَدِيدِيَّةٌ فَائِقَةُ السُّرْعَةِ",
 "高進": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "高遠": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "高邁": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "高配": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "高野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高野槇": "صنوبر المظلة الياباني (شجرة طويلة دائمة الخضرة ذات تاج منتشر متماثل وإبر تنمو في دوامات تشبه المظلات عند أطراف الأغصان)",
 "高野槙": "صنوبر المظلة الياباني (شجرة طويلة دائمة الخضرة ذات تاج منتشر متماثل وإبر تنمو في دوامات تشبه المظلات عند أطراف الأغصان)",
 "高野豆腐": "مُجَفَّف بِالتَّجْمِيد (مَحْفُوظ بِالتَّجْمِيد ثُمَّ التَّجْفِيف فِي الفَرَاغ) / مُجَفَّف تَجْمِيدِيًّا ((عَنِ الأَنْسِجَة أَوِ الدَّم أَوِ الأَمْصَال) مُجَفَّف بِالتَّجْمِيد فِي فَرَاغ عَالٍ)",
 "高鉄": "سِكَّةٌ حَدِيدِيَّةٌ فَائِقَةُ السُّرْعَةِ",
 "高陵土": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "高階": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高雄": "كَاوْشْيُونْغ, غَاوْشْيُونْغ",
 "高雅": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "高電位": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الجُهْد (يعمل على جهد كهربائي مرتفع أو يُشغَّل به)",
 "高電圧": "الفُوُلطِيَةُ مُرتَفِعَةٌ",
 "高音": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "高音部": "سُوبْرَانُو (ذو مدى صوتيّ عالٍ أو يدلّ عليه) / ذُو وَجْهَيْنِ, مُتَعَدِّدُ الْأَوْجُهِ (له أكثر من جانب أو صفة مختلفة بوضوح) / ثُلَاثِيّ (ذو ثلاث وحدات أو مكوّنات أو عناصر) / ثَلَاثَةُ أَضْعَافٍ (ثلاثة أمثال الكمية أو العدد)",
 "高音部記号": "مفتاح الثلاثي, مفتاح صول (مفتاح)\nمثال: بحث عن المفتاح.",
 "高須": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高頻度": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها) / تَرَدُّد عَالٍ (3 إلى 30 ميجاهرتز)",
 "高飛び": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "高飛車": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "高騰": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "高高": "عالياً, في الأعالي (على ارتفاع كبير)\nمثال: تسلق عالياً على السلم / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "高高度飛行": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه)",
 "高高指": "وُسْطَى",
 "高鳴り": "جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / تقديم الخاتم (إعطاء خاتم كرمز للخطوبة) / دق الجرس, رنين (صوت رنين الجرس)\nمثال: الرنين المميز لجرس الكنيسة",
 "高鳴る": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "高麗": "غُورْيُو / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / كُورِيّ",
 "高麗エビ": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "高麗海老": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "高麗胡椒": "نَبَات فُلْفُل (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / فُلَيْفِلَة\nمثال: هذا النبات مهدد بالانقراض.",
 "高麗芝": "عشبة المروج الكورية, عشبة المروج اليابانية (عشبة مروج شائعة في الصين واليابان؛ تزرع أيضاً في الولايات المتحدة)",
 "高麗雉": "تدرج مطوق (تدرج شائع ذو ريش زاهي وحلقة عنق بيضاء)",
 "高黍": "ذُرَة, سرغوم",
 "高鼾": "نَوْم عَمِيق (بكافة معانيه)",
 "高齢": "شَيْخُوخَة, عُجُوز",
 "高齢化": "شَيْخُوخَة, هَرَم",
 "高齢者": "عجوز, كبير السن (شخص متقدم في السن)",
 "高１": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "高２": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "高３": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "髙橋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "髢": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة) / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "髣髴": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "髪": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "髪かたち": "تَصْفِيفَة, تَسْرِيحَة",
 "髪の毛": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "髪をとかす": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "髪を梳かす": "مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "髪切り": "خنفساء طويلة القرون (خنفساء طويلة الجسم لها قرون استشعار طويلة جداً) / مخلوق أسطوري, وحش أسطوري (وحش مشهور في الفولكلور والأسطورة)",
 "髪型": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "髪床": "حَلَّاق / حلاقَة",
 "髪形": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "髪文字": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة) / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "髪毛": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "髪油": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "髪留め": "مشبك شعر (دبوس لتثبيت شعر النساء في مكانه)",
 "髪結": "مُزَيِّن, كْوَافِير",
 "髪結い": "مُزَيِّن, كْوَافِير",
 "髪膚": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "髪頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "髭": "شَارِب / لِحْيَة (الشعر النامي على الجزء السفلي من وجه الرجل) / ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
