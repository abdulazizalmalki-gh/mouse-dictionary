 "馬屋": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "馬幇": "قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / مَقْطُورَة\nمثال: الكلاب تنبح، والقافلة تسير.",
 "馬房": "مَعْلِف, مُرَاح / بَسْطة",
 "馬手": "سَائِس / هَندَم / يَمِين, يُمْنَى",
 "馬栗": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل) / كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "馬楝": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "馬橇": "مجرور بالخيول (يسحب بواسطة حصان)\nمثال: عربة تجرها الخيول",
 "馬毛": "قماش شعر الخيل (قماش مصنوع من الألياف المأخوذة من عرف أو ذيل الخيل؛ يستخدم للتنجيد) / شعر الخيل (الشعر المأخوذ من عرف أو ذيل الحصان)",
 "馬渕": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "馬着": "لَبَّادَة, لُبَّادَة",
 "馬糞塚": "كومة روث, مزبلة (كومة من الروث أو القمامة) / مزبلة (حالة قذرة أو متدهورة)",
 "馬糞紙": "مُنْخَفِض الدَّرَجَة",
 "馬糞塚": "كومة روث, مزبلة (كومة من الروث أو القمامة) / مزبلة (حالة قذرة أو متدهورة)",
 "馬肉": "لَحْم حِصَان (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "馬肥": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "馬肥やし": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "馬脚形": "حَوْذَان",
 "馬脾風": "خُنَاق",
 "馬草": "عَلَف",
 "馬虻": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "馬蝿": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "馬蠅": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "馬術": "فروسية (المهارة في التعامل مع الخيول وركوبها)",
 "馬越": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "馬足形": "حَوْذَان",
 "馬跳び": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "馬蹄形アーチ": "قوس حدوة الحصان, قوس مغاربي (قوس مستدير يتسع قبل أن يدور)",
 "馬蹄石": "سَبَج",
 "馬車": "عَرَبَة / مُدَرِّب, مُدَرِّبَة / حافلة السفر, حافلة النقل الخارجي (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "馬軍": "فَارِس, سِلَاح الفُرْسَان (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "馬連": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "馬酔木": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "馬鈴草": "زَرَاوَنْد",
 "馬鈴薯": "بَطَاطَا / بَطَاطِس",
 "馬銜": "بِت (انقطع؛ قَطَع)",
 "馬鍬": "جَرّافَة, كَاسِحَة",
 "馬陸": "دُودَة أَلْفِيَّة, ذات الألف قدم",
 "馬革": "جلد الحصان (جلد مصنوع من إهاب الحصان)",
 "馬鞍": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "馬飛び": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "馬鹿": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)",
 "馬鹿げた": "عَبَثِيّ, سَخِيف",
 "馬鹿たれ": "أحمق, غبي (شخص غبي وغير كفء)",
 "馬鹿ちん": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "馬鹿っぽい": "غَبِيّ / غَبِيّ, أَحْمَق",
 "馬鹿でかい": "ضَخْم, هَائِل",
 "馬鹿でもチョンでも": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "馬鹿と天才は紙一重": "هُنَاكَ, يُوجَدُ",
 "馬鹿な真似": "حماقة, طيش (سلوك أحمق أو لا معنى له)",
 "馬鹿に": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "馬鹿にする": "سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "馬鹿につける薬はない": "هُنَاكَ, يُوجَدُ",
 "馬鹿みたい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "馬鹿も休み休み言え": "أَعْطِنِي",
 "馬鹿よけ": "مُحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "馬鹿らしい": "عَبَثِيّ, سَخِيف",
 "馬鹿を言え": "أَعْطِنِي",
 "馬鹿チョンカメラ": "كاميرا صوّب والتقط, كاميرا مدمجة (كاميرا تصوير خفيفة الوزن ذات تركيز تلقائي)",
 "馬鹿チン": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "馬鹿人": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "馬鹿当たり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية))",
 "馬鹿発見器": "تَغْرِيد",
 "馬鹿笑い": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "馬鹿者": "مُغَفَّل, أَحْمَق",
 "馬鹿臭い": "عَبَثِيّ, سَخِيف",
 "馬鹿話": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "馬鹿野郎": "أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)\nمثال: 俺は人事課の馬鹿野郎にあごで指図されるつもりはない。 — لن يحكمني غبي من قسم الموارد البشرية.",
 "馬鹿馬鹿しい": "عَبَثِيّ, سَخِيف",
 "馬鹿騒ぎ": "مزاح خشن (لعب صاخب أو خشن)",
 "馬鹿鮫": "قرش متشمس (قرش شمالي كبير غير ضار يتغذى على العوالق؛ غالباً ما يسبح ببطء أو يطفو على سطح البحر)",
 "馬鹿鳥": "قَطْرَس (طائر بحري كبير)",
 "馬鼻疽": "رُعَام",
 "馬齢": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "馭者": "حوذي (رجل يقود عربة خيول)",
 "馭者座": "سائق العربة الحربية (سائق العربة)",
 "馳": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "馳せる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "馳走": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "馴らし手": "مُرَوِّض",
 "馴らす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "馴れた": "أَلِيف",
 "馴れ合い": "تَوَاطُؤ / زواج عرفي, مساكنة (علاقة زواج تنشأ عن طريق الاتفاق والمساكنة بدلاً من المراسم)",
 "馴れ合う": "تَآمَرَ, اِئْتَمَرَ",
 "馴れ馴れしい": "مُتَجَاوِز لِلحُدُود (يأخذ حريات غير لائقة في التعامل مع الآخرين)",
 "馴化": "أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة))",
 "馴染": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / ألفة, حميمية (صداقة وثيقة أو دافئة) / أُلْفَة, دِرَايَة (الاعتيادية بحكم كون الشيء مألوفاً أو معروفاً جيداً) / تلقائية, عفوية (أسلوب عفوي)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "馴染ませる": "يتكيف مع",
 "馴染み": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / ألفة, حميمية (صداقة وثيقة أو دافئة) / أُلْفَة, دِرَايَة (الاعتيادية بحكم كون الشيء مألوفاً أو معروفاً جيداً) / تلقائية, عفوية (أسلوب عفوي)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "馴染み客": "عَادِيّ / مُنْتَظِمٌ",
 "馴染み深い": "مَأْلُوف",
 "馴染む": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "馴致": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "馴鹿": "رَنَة",
 "駁": "أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "駁する": "دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق) / كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "駁撃": "حَمْلَة / هَاجَمَ",
 "駁毛": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / نَمِر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / فَهْد\nمثال: دخل نمر مخيمنا.",
 "駁論": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "駃騠": "نَغْل, نَغْلَة",
 "駄": "فَقِير / مِسْكِين / فُقَرَاء / حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / حصان حمل (حصان عمل يستخدم كحيوان حمل)",
 "駄々をこねる": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "駄々を捏ねる": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "駄作": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها)",
 "駄弁": "هُرَاء, لَغْو",
 "駄弁る": "بَرْبَرَة, ثَرْثَرَة سَرِيعَة (كلام سريع وغير واضح)",
 "駄文": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)",
 "駄法螺": "خُرَافَة, قِصَّة مُبَالَغ فِيهَا (قصة غير محتملة (غير عادية أو لا تصدق أو خيالية))",
 "駄津": "سمكة أنبوبية, سمكة الإبرة (سمكة ذات خطم أنبوبي طويل وجسم نحيل مغطى بصفائح عظمية) / خرم, سمك الإبرة (أسماك أوروبية مفترسة تعيش على السطح ذات أجسام ممدودة وفكوك طويلة مسننة؛ وفيرة في المياه الساحلية)",
 "駄物": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "駄犬": "هَجِين",
 "駄獣": "حيوان حمل, دابة حمل (حيوان (مثل البغل أو الحمار أو الحصان) يستخدم لحمل الأحمال)",
 "駄目": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / عَجَزَ, لَا يَسْتَطِيع",
 "駄目で元々": "هُنَاكَ, يُوجَدُ",
 "駄目になる": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "駄目を押す": "تَأَكَّدَ",
 "駄目人間": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "駄目出し": "اِنْتَقَدَ / نَقَدَ",
 "駄目女": "بِلَا رَصِيد, مَرْفُوض ((عن الشيكات) مُعاد لعدم كفاية الرصيد) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "駄目男": "بِلَا رَصِيد, مَرْفُوض ((عن الشيكات) مُعاد لعدم كفاية الرصيد) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "駄菓子屋": "ثَانَوِيّ, صَغِير (ذو أهمّيّة ضئيلة)",
 "駄賃": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "駄辯": "هُرَاء, لَغْو",
 "駄馬": "حصان حمل (حصان عمل يستخدم كحيوان حمل)",
 "駅": "مَحَطَّة السِّكَك الْحَدِيدِيَّة, مَحَطَّة",
 "駅スタンプ": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "駅伝": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة / ستيج كوتش, عربة البريد والركاب (عربة كبيرة تجرها أربعة خيول كانت تستخدم سابقاً لنقل الركاب والبريد على طرق منتظمة بين المدن)\nمثال: خرجنا من المدينة معاً في عربة البريد لحوالي عشرة أو اثني عشر ميلاً",
 "駅伝競走": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "駅前": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "駅務": "مَحَطَّة السِّكَك الْحَدِيدِيَّة, مَحَطَّة",
 "駅家": "محطة البريد, نزل البريد (نزل لتبادل خيول البريد واستيعاب الفرسان)",
 "駅弁大学": "ثَانَوِيّ, صَغِير (ذو أهمّيّة ضئيلة)",
 "駅舎": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "駅路": "طريق البريد (طريق يتم نقل البريد عبره)",
 "駅逓": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم",
 "駅逓局": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "駅長": "مدير المحطة, ناظر المحطة (الشخص المسؤول عن محطة السكك الحديدية)",
 "駅頭": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "駅馬": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "駅馬車": "ستيج كوتش, عربة البريد والركاب (عربة كبيرة تجرها أربعة خيول كانت تستخدم سابقاً لنقل الركاب والبريد على طرق منتظمة بين المدن)\nمثال: خرجنا من المدينة معاً في عربة البريد لحوالي عشرة أو اثني عشر ميلاً",
 "駆け": "ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "駆けくらべ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "駆けっこ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "駆けっ競": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "駆けつける": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "駆けぬける": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "駆けのぼる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "駆ける": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن الأرض في آن واحد) / يقرب / تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء) / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "駆け上る": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "駆け付ける": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "駆け出し": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / مبتدئ (شخص دخل في رهبنة دينية لكنه لم يأخذ النذور النهائية بعد) / فرار, هروب (فعل المغادرة (بدون إذن) للمكان الذي من المتوقع أن تكون فيه)",
 "駆け出し者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "駆け出す": "نَفِدَ",
 "駆け引き": "مساومة (التفاوض على شروط صفقة أو اتفاقية) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "駆け抜ける": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "駆け比べ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "駆け登る": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "駆け競": "سباق جري, عدو (سباق يتم الجري فيه على الأقدام)\nمثال: حطمت الرقم القياسي في سباق النصف ميل",
 "駆け競べ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "駆け落ち": "فرار مع الحبيب (فعل الهروب مع عشيق (عادةً للزواج))",
 "駆け足": "بِخُطْوَة سَرِيعَة, بِسُرْعَة مُضَاعَفَة (بسرعة أكبر) / أجر مضاعف (أجر مضاعف (للعمل الإضافي)) / خَطْوَة مُزْدَوِجَة (وتيرة مسير سريعة (180 خطوة/دقيقة) أو هرولة بطيئة)\nمثال: الآن دعونا نعزف القطعة مرة أخرى بسرعة مضاعفة / راكض, مخب (يركب بمشية بين الخبب والعدو (الخبب السريع))\nمثال: الجنود المخبون",
 "駆け込み": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "駆け込み寺": "مَلْجَأ, مَلَاذ",
 "駆け通し": "شَحْطَة / شَرْطَة",
 "駆った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "駆り出す": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "駆り立てる": "طَرَدَ / قَادَ, سَاقَ / سَاقَ",
 "駆り集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "駆る": "قَادَ, سَاقَ / سَاقَ",
 "駆体": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "駆動": "قَادَ, سَاقَ / سَاقَ",
 "駆動機": "قَادَ, سَاقَ / سَاقَ",
 "駆動輪": "عجلة القيادة, عجلة دافعة (عجلة تحرك مركبة (تحول عزم الدوران إلى قوة سحب))",
 "駆動部": "قَادَ, سَاقَ / سَاقَ",
 "駆抜ける": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "駆歩": "ركض خفيف (مشية سلسة ثلاثية الضربات؛ بين الخبب والعدو)",
 "駆競べ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "駆虫剤": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "駆虫薬": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية) / طارد الحشرات (مادة كيميائية تطرد الحشرات)",
 "駆込み": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "駆込み寺": "مَلْجَأ, مَلَاذ",
 "駆逐": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "駆逐戦車": "مدمرة الدبابات (مركبة مدرعة مجهزة بمدفع مضاد للدبابات وقادرة على التحرك بسرعات عالية)",
 "駆逐艦": "مُدَمِّر",
