 "音響測深": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "音響測深儀": "سونار, مسبار الصدى (أداة قياس ترسل نبضة صوتية في الماء وتقيس المسافات من حيث الوقت الذي يستغرقه صدى النبضة للعودة)",
 "音響測深機": "سونار, مسبار الصدى (أداة قياس ترسل نبضة صوتية في الماء وتقيس المسافات من حيث الوقت الذي يستغرقه صدى النبضة للعودة)",
 "音響調整卓": "خَلَّاط, خَفَّاقَة",
 "音頭": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "音頭をとる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "音頭を取る": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "音頭取り": "قِيَادَة",
 "音飛び": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات",
 "音高": "زِفْت",
 "韻": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "韻を踏む": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "韻尾": "خَاتِمَة",
 "韻律": "مِتْر (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر. / عَرُوض, عِلْمُ العَرُوض",
 "韻律論": "عَرُوض, عِلْمُ العَرُوض",
 "韻文": "نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء.",
 "韻母": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "韻脚": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "韻致": "أَنَاقَة",
 "響": "صَدًى / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "響き": "جلبة, صخب (فعل إحداث اضطراب صاخب) / جلبة, دوامة (حركة مضطربة) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: كان عالقاً في دوامة من العمل / صَدًى / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "響きわたる": "صَدًى",
 "響き渡る": "صَدًى",
 "響く": "هَزَّ / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "響めき": "جلبة, صخب (فعل إحداث اضطراب صاخب) / جلبة, دوامة (حركة مضطربة) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: كان عالقاً في دوامة من العمل",
 "響もす": "هَزَّ",
 "響動めき": "جلبة, صخب (فعل إحداث اضطراب صاخب) / جلبة, دوامة (حركة مضطربة) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: كان عالقاً في دوامة من العمل",
 "響板": "لوحة الرنين, لوحة الصوت (رنان موسيقي يتكون من لوح رقيق تعزز اهتزازاته صوت الآلة)",
 "響胴": "جسم الآلة, صندوق الصوت (حجرة رنين في آلة موسيقية (مثل جسم الكمان))",
 "頁": "صَفْحَة, صفحة",
 "頁付け": "تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات)",
 "頁岩": "طفل صفحي (صخر رسوبي تشكل عن طريق ترسيب طبقات متعاقبة من الطين)",
 "頁岩油": "زيت صخري (زيت يُستخرج من الصخر الزيتي بالتسخين)",
 "頂": "تَاج, إِكْلِيل",
 "頂き": "تَاج, إِكْلِيل",
 "頂きます": "شُكْرًا, تِسْلَم",
 "頂きマンモス": "شُكْرًا, تِسْلَم",
 "頂き物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "頂く": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "頂けない": "غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به) / غَيْرُ مَقْبُول (لا يكفي لتحقيق الرضا) / غَيْر مَقْبُول, مَرْفُوض (لا يتوافق مع الاستخدام اللغوي المعياري) / غَيْرُ مَقْبُول, مُسْتَحِيل ((يوصف به الأشخاص أو سلوكهم) غير مقبول أو معقول)\nمثال: كلمة غير مقبولة في المجتمع المهذب",
 "頂上": "قِمَّة",
 "頂戴": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "頂戴物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "頂板": "مِعَد, مِعْدَاد / نَاصِيَة (منبت شعر الغرّة الذي يقع فوق الجبهة مباشرة؛ عن شعر الغرّة)",
 "頂点": "يَافُوخ / قِمَّة / أَوْجٌ, ذُرْوَةٌ",
 "頂礼": "سُجُود",
 "頂角": "زاوية رأسية, زاوية متقابلة بالرأس (إحدى زاويتين متساويتين ومتقابلتين ناتجتين عن تقاطع خطين مستقيمين)",
 "頂辺": "قِمَّة / فَرْوَة اَلرَّأْس",
 "頃": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فصل, موسم (إحدى الفترات الطبيعية التي تنقسم إليها السنة)\nمثال: التتابع المنتظم للفصول / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "頃おい": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "頃合": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة / أدب, صواب (السلوك الصحيح أو المناسب)",
 "頃合い": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة / أدب, صواب (السلوك الصحيح أو المناسب)",
 "頃日": "مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "項": "قَفًا / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / بَنْد\nمثال: يا لها من جملة! / جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك. / اِصْطِلَاح, مُصْطَلَح / قَفًا",
 "項に分かつ": "فِقْرَة, بَنْد",
 "項目": "بَنْد / كلمة بادئة (كلمة توضع في بداية سطر أو فقرة (كما في مدخل القاموس)) / كلمة رئيسية (كلمة محتوى يمكن تقييدها بواسطة مُعدِّل (صفة أو غيرها))",
 "項部": "قَفًا / اقتراع, تصويت (عد الأصوات (كما في الانتخابات)) / ببغاء أليف (ببغاء مروض) / قذال (جزء الرأس بين الأذنين) / قمة الرأس, هام (أعلى الرأس)",
 "項領": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "順": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / مُطِيع, مُذْعِن",
 "順々": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
