 "風物": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "風狂": "جُنُون / عَارِف, عَارِفَة",
 "風琴": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / جِهَاز, جَهَاز / أُرْغُن ((أَرْغَنَ): أطاع؛ (أَرْغَنَ) إليه: رغن)\nمثال: اذكر كل عضو باسمه.",
 "風疹": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "風症候群": "زُكَام",
 "風穴": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "風窓": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "風立つ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "風笛": "مزمار القربة (آلة نفخ أنبوبية؛ ينفخ العازف الهواء في كيس ويخرجه عبر أنبوب النغمات المستمرة)",
 "風箱": "مِنْفَاخ",
 "風紀": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "風紀委員": "حاكم إداري, محافظ (كبير الضباط أو كبير القضاة)",
 "風習": "عَادَة, عُرْف",
 "風聞": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "風致": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "風船": "نُفَّاخَة, بَالُون / مُنْطَاد",
 "風船爆弾": "قنبلة بالونية (قنبلة يحملها بالون)\nمثال: في الحرب العالمية الثانية أطلق اليابانيون قنابل بالونية ضد أمريكا الشمالية",
 "風船葛": "بازلاء القلب, كرمة البالون (نبات متسلق معمر خشبي ذو قرون بذور زينة كبيرة تشبه البالونات؛ الهند الاستوائية وإفريقيا وأمريكا)",
 "風草": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "風薬": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "風袋": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "風見": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات)",
 "風見鶏": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات) / مُتَذَبْذِب, مُحَايِد (شخص لا يتخذ موقفاً مع أي طرف في نزاع)",
 "風解": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / طفح جلدي (أي طفح أحمر على الجلد) / أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "風評": "إِشَاعَة, شَائِعَة",
 "風説": "إِشَاعَة, شَائِعَة",
 "風諭": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "風貌": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "風趣": "أَنَاقَة",
 "風車": "طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق) / دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة) / دولاب الهواء (لعبة تتكون من ريش من الورق الملون أو البلاستيك مثبتة بدبوس على عصا وتدور عندما توجه نحو الرياح) / عجلة الدبابيس (لعبة) (عجلة بها العديد من الدبابيس المثبتة بزوايا قائمة على حافتها) / أيونيم هاورثي, دولاب الهواء (شجيرة معمرة في تينيريفي ذات أوراق في وريدات تشبه دواليب الهواء)\nمثال: أدار عجلة الدبابيس وتوقفت والمؤشر على 'انطلق'",
 "風車小屋": "طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق)",
 "風通し": "تَهْوِيَة / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "風速計": "مِرْيَاح",
 "風道": "خطوط جوية, شركة طيران (مؤسسة تجارية توفر رحلات مجدولة للركاب) / قناة تهوية, مجرى هواء (قناة توفر التهوية (كما في المناجم)) / مجرى التنفس, مسلك تنفسي (الممرات التي يدخل من خلالها الهواء ويخرج من الجسم) / مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "風邪": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "風邪ひく": "أُصِيبَ بِبَرْدٍ",
 "風邪をひく": "أُصِيبَ بِبَرْدٍ",
 "風邪を引く": "أُصِيبَ بِبَرْدٍ",
 "風邪引く": "أُصِيبَ بِبَرْدٍ",
 "風邪症候群": "زُكَام",
 "風邪薬": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "風配図": "وردة الرياح (خريطة طقس تظهر تردد وقوة الرياح من اتجاهات مختلفة)",
 "風采": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "風采があがらない": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "風采が上がらない": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "風量": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "風鈴": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب الرياح رنينها)",
 "風鈴草": "جريس متوسط, كأس وصحن (نبات أوروبي ثنائي الحول يزرع على نطاق واسع لأزهاره الزرقاء أو البنفسجية أو البيضاء) / جرس كانتربري, غلوكسينيا معمرة (عشب من كولومبيا إلى بيرو ذو أزهار أرجوانية شاحبة)",
 "風鐸": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب الرياح رنينها)",
 "風間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "風防": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية) / قَرِيس, قَرِيت",
 "風防ガラス": "زُجَاج السَيَّارَة الأَمَامِيّ",
 "風除け": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "風除室": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال) / دهليز (أي من التجاويف الجسدية المختلفة المؤدية إلى تجويف آخر (كما في الأذن أو المهبل))",
 "風雅": "أَنَاقَة",
 "風雨": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "風雪": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية) / مَشَقَّة, شِدَّة",
 "風雲": "طَبِيعَة, طبيعة / حَالَة, وَضْع",
 "風雲児": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "風雷益": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "風霜": "مَشَقَّة, شِدَّة",
 "風露草": "غُرْنُوق / جِيرَانِيُوم",
 "風靡": "غَالِب",
 "風韻": "أَنَاقَة",
 "風鳥": "طائر الجنة (أي من الطيور العديدة ذات الريش الملون ببراعة في منطقة غينيا الجديدة) / إستريلتزيا, عصفور الجنة (نبات زينة من جنوب أفريقيا الاستوائية وأمريكا الجنوبية له سيقان من الزهور البرتقالية والزرقاء الأرجوانية تشبه الطائر) / بوانسيانا, عصفور الجنة (شجيرة مزهرة استوائية لها زهور برتقالية زاهية أو حمراء؛ تصنف أحياناً في جنس بوانسيانا)",
 "颯々": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "颯爽": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "颯颯": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "颶風": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء. زَوْبَعَة؛ دوّامات هوائيّة شديدة السرعة تدور حول مراكزٍ من الهواء عالي الضغط، سواء كانت فوق الأرض أو فوق الماء. [])\nمثال: السطح دمر من قبل الإعصار.",
 "颺言": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "飄": "زَوْبَعَة / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / تسام, تعال (حالة من الوجود فوق حدود التجربة المادية وخارجها)",
 "飄々": "صفير (فعل الصفير بلحن) / تصفير, صفير (فعل الإشارة (مثل الاستدعاء) عن طريق التصفير أو النفخ في صافرة) / صفير (الصوت الناتج عن شيء يتحرك بسرعة أو بخار يخرج من فتحة صغيرة)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "飄然": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين / مُسْتَقِلّ, مُنْفَصِل (يستخدم للمباني؛ قائمة بمعزل عن غيرها) / غَيْرُ مُنْخَرِطٍ, مُنْفَصِلٌ عَاطِفِيًّا (يُظْهِرُ عَدَمَ انْخِرَاطٍ عَاطِفِيٍّ) / مَفْصُول, مُنْفَصِل (لَمْ يَعُدْ مُتَّصِلًا أَوْ مُلْتَحِمًا) / طَلِيق, مُنْفَصِل (غَيْر مُثَبَّت فِي مَوْضِعِه)\nمثال: منازل منفصلة",
 "飄逸": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "飄零": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "飄飄": "صفير (فعل الصفير بلحن) / تصفير, صفير (فعل الإشارة (مثل الاستدعاء) عن طريق التصفير أو النفخ في صافرة) / صفير (الصوت الناتج عن شيء يتحرك بسرعة أو بخار يخرج من فتحة صغيرة)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "飛": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / فلاي بول, كرة طائرة ((بيسبول) ضربة تطير عالياً في الهواء)",
 "飛ばし携帯": "جَوَّال, هَاتِف مَحْمُول (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)",
 "飛ばす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن الأرض في آن واحد) / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "飛び": "طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير) / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛びっきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛びっ切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛びぬけて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "飛びはねる": "نَقْز / نَقَزَ",
 "飛び上がる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "飛び入り": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "飛び出しナイフ": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "飛び出す": "نَفِدَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "飛び出す絵本": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "飛び出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "飛び切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛び去る": "نَثَرَ, تَفَرَّقَ",
 "飛び地": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛び子": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛び将棋": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "飛び抜けて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "飛び散る": "نَثَرَ, تَفَرَّقَ",
 "飛び板": "منطلق",
 "飛び石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "飛び移る": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار",
 "飛び立つ": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ",
 "飛び翔る": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "飛び蝗虫": "جَرَادَة",
 "飛び越える": "شَفَّاف / وَاضِح / قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "飛び越し": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛び跳ねる": "نَقْز / نَقَزَ",
 "飛び蹴り": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة ملامستها للأرض)",
 "飛び込み": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛び込み台": "لوح الغطس (لوح قفز يمكن للسباحين الغطس منه)",
 "飛び込み営業": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "飛び込む": "غَاصَ / غَطْسَ, يقفز الى الماء",
 "飛び道具": "سِلَاح نَارِيّ",
 "飛び領土": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛び飛び": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "飛び魚": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛び魚の子": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "飛ぶ火": "ضوء الإشارة, نار الإشارة (نار تُشعل كإشارة)",
 "飛ぶ鳥": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "飛べない鳥": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "飛んで": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "飛地": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛子": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛将棋": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "飛揚": "طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "飛散": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "飛散る": "نَثَرَ, تَفَرَّقَ",
 "飛散防止": "مُضَادٌّ لِلتَّشَظِّي, مُقَاوِمٌ لِلتَّحَطُّم (مُقَاوِمٌ لِلتَّحَطُّمِ أَوِ التَّشَظِّي)",
 "飛板": "منطلق",
 "飛沫": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / قُطَيْرَة",
 "飛泉": "شَلَّال",
 "飛燕草": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "飛球": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "飛田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飛留間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飛石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "飛礫": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "飛竜": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "飛節": "عرقوب (المفصل الرصغي للساق الخلفية للثدييات ذوات الحوافر؛ يقابل الكاحل البشري) / نبيذ الراين, هوك (أي من أنواع النبيذ الأبيض المتعددة من وادي نهر الراين في ألمانيا)",
 "飛翔": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "飛翔体": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام) / قذيفة, مقذوف (سلاح يُرمى أو يُقذف بقوة على الأهداف ولكنه ليس ذاتي الدفع) / صاروخ, مركبة صاروخية (أي مركبة ذاتية الدفع بواسطة محرك صاروخي)",
 "飛脚": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "飛蜥蜴": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "飛蝗": "جَرَادَة",
 "飛螻蛄": "ذباب كاديس, ذبابة القمص (حشرة صغيرة تشبه العثة لها زوجان من الأجنحة الغشائية المشعرة ويرقات مائية)",
 "飛行": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "飛行の三鈷": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "飛行体": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "飛行便": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "飛行場": "مَهْبِط, مَدْرَج",
 "飛行士": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "飛行家": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "飛行機": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / طَيَّارَة (هي الطَائِرَة؛ هي الطائرة الورقية)\nمثال: لقد وصلت الطائرة.",
 "飛行機酔い": "داء الجو, دوار الجو (دوار الحركة الذي يحدث أثناء السفر بالطائرة (خاصة أثناء الاضطرابات الجوية))",
 "飛行機雲": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "飛行甲板": "سطح الطيران (السطح العلوي لحاملة طائرات؛ يستخدم كمدرج)",
 "飛行禁止空域": "مِنْطَقَةُ حَظْرِ الطَّيَرَان (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "飛行船": "سفينة هوائية, منطاد موجه (طائرة ذاتية الدفع قابلة للتوجيه)",
 "飛行艇": "قارب طائر (طائرة مائية كبيرة تطفو ببدنها في الماء بدلاً من استخدام عوامات)",
 "飛行隊": "سِلَاح طَيَرَان",
 "飛行雲": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "飛語": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "飛越": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "飛越し": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛距離": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "飛跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مِضْمَار\nمثال: اختفى فلم ير له أثر.",
 "飛跳ねる": "نَقْز / نَقَزَ",
 "飛躍": "وَثَبَ (طَفَرَ أو قَفَزَ وهو يجري)",
 "飛躍的": "عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "飛車": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "飛輪": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / حَدَّافَة",
 "飛込み": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛道具": "سِلَاح نَارِيّ",
 "飛雪": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "飛魚": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛魚座": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛鳥": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "飛鼠": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "飛龍": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "飜": "أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "飜って": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "食": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / كُسُوف, خُسُوف",
 "食あたり": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食い": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食いしばる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食いしん坊": "أَكَّال, شَرَه",
 "食いすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食いつき": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食いつく": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "食いで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食い下がる": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "食い付き": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食い付く": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "食い入るように": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "食い出": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食い合わす": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食い合わせ": "تَعْشِيقَة / عَشَّقَ (فرط الحب حتى لا يستطيع العاشق الابتعاد عن المعشوق) / اِنْسَجَمَ مَعَ, رَكَّبَ\nمثال: أغاني العشق تحرك مشاعري.",
 "食い尽くし系": "أَكَّال, شَرَه",
 "食い意地": "نَهَم, شَرَه",
 "食い戻し": "اجترار",
 "食い摘み": "السَّنَة الْجَدِيدَة",
 "食い止める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "食い残し": "الْبَقَايَا",
 "食い殺す": "اِلْتَهَمَ",
 "食い気": "شَهِيَّة",
 "食い気味": "قَاطَعَ",
 "食い物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / فَرِيسَة / غَنِيمَة",
 "食い物屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食い積み": "السَّنَة الْجَدِيدَة",
 "食い締める": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食い縛る": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食い荒す": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "食い荒らす": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "食い足りない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "食い込み": "توغل, غارة (تعدٍ أو اقتحام) / توغل, غارة (غزو أو هجوم عدائي)\nمثال: قاموا بتوغلات في سوق الولايات المتحدة / عَجْز / حذاء وتدي (حذاء بكعب وتدي متصل)",
 "食い込む": "اِخْتَلَسَ, أَزْعَجَ",
 "食い過ぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食い道楽": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "食い違い": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "食い違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "食い違った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "食う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "食えない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء. / غير صالح للأكل (غير مناسب كطعام)",
 "食す": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "食する": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "食った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "食ってかかる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "食って掛かる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "食べかす": "الْبَقَايَا",
 "食べきれない": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "食べごたえ": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食べた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "食べで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べどころ": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べにくい": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "食べる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "食べカス": "الْبَقَايَا",
 "食べ処": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べ出": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べ切れない": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "食べ合わせ": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة))",
 "食べ応え": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べ残し": "الْبَقَايَا",
 "食べ比べる": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "食べ滓": "الْبَقَايَا",
 "食べ物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食べ物屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べ粕": "الْبَقَايَا",
 "食べ過ぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食べ難い": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "食み": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "食み出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "食み出る": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "食み物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)",
 "食む": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "食らいつく": "قَضَمَ",
 "食らい付く": "قَضَمَ",
 "食らう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "食らわす": "اِتِّفَاقِيَّة",
 "食らわせる": "اِتِّفَاقِيَّة",
 "食わす": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "食わせる": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "食わせ物": "مُزَيَّف / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "食わせ者": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "食を断つ": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "食パン": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "食中り": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食中毒": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食事": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / حِمْيَة, حِمْيَة غِذَائِيَّة / حِمْيَة, نِظَام غِذَائِيّ / بَرْلَمَان, مَجْلِس",
 "食事会": "حفل عشاء, عزومة عشاء (حفلة يجتمع فيها الناس لتناول العشاء معاً)\nمثال: يجب ألا يتأخر الضيوف عن حفل العشاء أبداً",
 "食事処": "مَطْعَم",
 "食事券": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة) / مصدر دخل (مصدر للدخل أو الرزق)",
 "食事時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "食事療法学": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "食人": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "食人族": "غُول, آكِلُ لُحُوم البَشْر",
 "食人種": "غُول, آكِلُ لُحُوم البَشْر",
 "食付き": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食作用": "بلعمة (عملية تقوم فيها الخلايا البلعمية بابتلاع وهضم الكائنات الحية الدقيقة والحطام الخلوي؛ دفاع مهم ضد العدوى)",
 "食俸": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "食傷": "إفراط في الأكل, تخمة (الأكل حتى الامتلاء المفرط) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار) / إفراط, تخمة (حالة الامتلاء بأكثر من اللازم) / اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食処": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食券": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة) / مصدر دخل (مصدر للدخل أو الرزق)",
 "食刻": "حفر, نقش (عمل لوحات محفورة أو منقوشة وطباعة التصاميم منها) / لوحة محفورة (لوحة محفورة باستخدام الحمض) / تنميش, حفر كيميائي (طبعة مصنوعة من لوح محفور)",
 "食前酒": "أبيرتيف, فاتح للشهية (مشروب كحولي يؤخذ قبل الوجبة لفتح الشهية)",
 "食卓": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "食卓塩": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "食味": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "食品": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食品メーカー": "شركة أغذية, شركة غذائية (شركة تقوم بمعالجة وبيع المواد الغذائية)",
 "食品ロス": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "食品中毒": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食品会社": "شركة أغذية, شركة غذائية (شركة تقوم بمعالجة وبيع المواد الغذائية)",
 "食品医薬品局": "إدارة الغذاء والدواء (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية تأسست لتنظيم إصدار الأطعمة الجديدة والمنتجات المتعلقة بالصحة)",
 "食品店": "بِقَالَة, حَانُوت بَقَّال",
 "食品添加物": "مادة مضافة للطعام, مضاف غذائي (مادة تضاف للطعام لتحسين نكهته أو مظهره أو فترة صلاحيته)",
 "食器": "أواني المائدة (أدوات للاستخدام على المائدة (أطباق وأدوات فضية وأواني زجاجية))",
