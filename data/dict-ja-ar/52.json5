 "飢死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢死に": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢渇": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢餓": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢餓感": "رَغْبَة, تَعَطُّش\nمثال: جاع الرجل العجوز حتى الموت.",
 "飢饉": "مَجَاعَة",
 "飣餖": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)",
 "飯": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / مَعِيشَة, مَعَاش / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "飯ごう": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "飯の種": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "飯を喰う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "飯を食う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "飯ウマ": "شَمَاتَة",
 "飯倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飯切": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "飯切り": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "飯原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飯台": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "飯塚": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飯屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "飯島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飯時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "飯桐": "إديسيا (شجرة آسيوية مستديرة الرأس نفضية تزرع على نطاق واسع في المناخات المعتدلة كزينة…)",
 "飯沼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飯炊き": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "飯田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飯盒": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "飯盛り": "خادمة (عاملة منزلية)",
 "飯米": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "飯粒": "ثُؤْلُول",
 "飯野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "飲": "شُرْب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "飲ます": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "飲ませる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "飲み": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "飲みくだす": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه)",
 "飲みで": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "飲みにくい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك)\nمثال: موقف بغيض",
 "飲み下す": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه)",
 "飲み出": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "飲み助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲み口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "飲み屋": "حَانَة, بَار",
 "飲み師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "飲み干す": "بَالُوعَة",
 "飲み抜け": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲み歩き": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "飲み水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء.",
 "飲み物": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "飲み薬": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة…)",
 "飲み込み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "飲み込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "飲み込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "飲み込む": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ",
 "飲む": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / دُخَان, دخان\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
