 "黄ばむ": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "黄み": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "黄みがかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄人": "شَرْقِيّ",
 "黄体": "جسم أصفر (نسيج صم أصفر يتكون في جريب جراف الممزق بعد إطلاق البويضة؛ يضمر بعد بضعة أيام ما…)",
 "黄体ホルモン": "بروجستوجين, بروجستين (أي من مجموعة الهرمونات الستيرويدية التي لها تأثير البروجسترون)",
 "黄体形成ホルモン": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث…)",
 "黄体期": "المرحلة الأصفرية, المرحلة الإفرازية (النصف الثاني من الدورة الشهرية بعد الإباضة؛ يفرز الجسم الأصفر البروجسترون الذي…)",
 "黄信号": "ضوء أصفر (إشارة للمضي قدماً بحذر)",
 "黄前": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "黄化": "اصفرار, شحوب ((علم النبات) فعل جعل النبات ينمو بدون كلوروفيل عن طريق زراعته دون التعرض لأشعة…)\nمثال: اصفرار الكرفس",
 "黄化病": "صفار, يرقان (اصفرار الجلد وبياض العينين الناتج عن تراكم صبغة الصفراء (البيليروبين) في الدم…)",
 "黄口": "ساذج, غر (شاب أخرق وقليل الخبرة)",
 "黄味がかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄土": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / مغرة صفراء (صبغة تتكون من الليمونيت الممزوج بالطين والسيليكا) / هَادِيس",
 "黄土色": "مَغْرِيّ اللَّوْن (بلون برتقالي مصفر معتدل كلون المغرة)",
 "黄塵": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "黄壌": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / هَادِيس",
 "黄変": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "黄巴旦": "كوكاتو كبريتي العرف (كوكاتو أبيض ذو عرف أصفر قابل للانتصاب)",
 "黄帯矢毒蛙": "ذُو أَشْرِطَة صَفْرَاء (عليه أشرطة صفراء اللون)",
 "黄斑": "لطخة جلدية (رقعة من الجلد متغيرة اللون ولكنها غير مرتفعة عادة؛ تسببها أمراض مختلفة)",
 "黄旗": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع…)",
 "黄昏": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟ / سَوْدَاوِيَّة",
 "黄昏る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "黄昏れる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "黄昏時": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "黄朽葉": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة)",
 "黄枇": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "黄梅": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في…)",
 "黄櫨染": "بُنِّيّ ذَهَبِيّ (بني مع مسحة ذهبية)",
 "黄櫨蝋": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "黄水": "صَفْرَاء (مؤنث أَصْفَر؛ صفة ما كان لونها الصفار؛ الغُدّة الصفراء: غدة في الكبد، تسمى أيضا…)\nمثال: هذه وردة صفراء.",
 "黄水仙": "جونكيل, نرجس مؤنث (نبات زينة يزرع على نطاق واسع موطنه جنوب أوروبا ولكنه متوطن في أماكن أخرى له…)",
 "黄水晶": "سيترين (كوارتز أصفر شبه كريم يشبه التوباز)",
 "黄沙": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة…)\nمثال: عاد إلى الصحراء.",
 "黄河": "اَلنَّهْر اَلْأَصْفَر, خْوَانْغْخِي",
 "黄河文明": "اَلنَّهْر اَلْأَصْفَر, خْوَانْغْخِي",
 "黄泉": "هَادِيس",
 "黄泉の国": "هَادِيس",
 "黄泉国": "هَادِيس",
 "黄泉路": "هَادِيس",
 "黄海": "الْبَحْر الْأَصْفَر",
 "黄熱": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "黄熱病": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "黄玉": "تُوبَاز",
 "黄玉石": "تُوبَاز",
 "黄瓜": "خِيَار (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)",
 "黄疸": "صُفَار, يَرَقَان",
 "黄癬": "سففة, قرعة (عدوى فطرية معدية في فروة الرأس؛ تحدث بشكل رئيسي في أفريقيا والشرق الأوسط)",
 "黄白": "رَشْوَة",
 "黄白色": "أَبْيَض مُصْفَرّ (أبيض مع مسحة صفراء)",
 "黄皮木": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "黄砂": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة…)\nمثال: عاد إلى الصحراء.",
 "黄碧玉": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "黄禍": "الخطر الأصفر (التهديد للحضارة الغربية الذي يُقال إنه ينشأ من قوة الشعوب الآسيوية)",
 "黄禍論": "الخطر الأصفر (التهديد للحضارة الغربية الذي يُقال إنه ينشأ من قوة الشعوب الآسيوية)",
 "黄粱": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي…)",
 "黄素馨": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية…)",
 "黄経": "خط طول سماوي, مطلع مستقيم ((علم الفلك) الإحداثي الاستوائي الذي يحدد الزاوية، مقاسة شرقاً على طول خط…)\nمثال: ساعة واحدة من المطلع المستقيم تساوي خمس عشرة درجة",
 "黄緑": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "黄緑色": "أَخْضَر مُصْفَرّ (بلون متوسط بين الأصفر والأخضر)",
 "黄緯": "خط عرض سماوي, ميل ((علم الفلك) المسافة الزاوية لجرم سماوي شمال أو جنوب خط الاستواء السماوي؛ يعبر…)",
 "黄肌": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "黄肌鮪": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "黄色": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "黄色い": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر. / حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد)",
 "黄色い声": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد)",
 "黄色がかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色っぽい": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色みがかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色人種": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "黄色味がかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色植物": "الطحالب الذهبية, قسم الطحالب الذهبية (طحالب حقيقية النواة تعيش غالباً في المياه العذبة ويحجب فيها صبغة بنية أو صفراء…)",
 "黄色組合": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "黄色腫": "ورم أصفر (مشكلة جلدية تتميز بتطور عقيدات صفراء غير منتظمة)",
 "黄色雀蜂": "دبور أصفر, سترة صفراء (دبور اجتماعي صغير معلم بالأصفر يعشش عادة في الأرض)",
 "黄花": "أُقْحُوَان",
 "黄花清白": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "黄花蘿蔔": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "黄菖蒲": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع…)",
 "黄葉": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "黄蓮": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر…)",
 "黄血塩": "فيروسيانيد البوتاسيوم (مركب سيانيد يتم تحضيره بتفاعل سيانيد البوتاسيوم مع أملاح الحديدوز؛ يستخدم عادة…)",
 "黄褐色": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "黄身": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)\nمثال: 私の娘は卵の黄身が好きです。 — ابنتي تحب صفار البيض.",
 "黄連": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر…)",
 "黄連雀": "جناح الشمع البوهيمي (جناح شمع كبير من شمال أمريكا الشمالية؛ يشبه جناح الشمع العادي ولكنه أكبر)",
 "黄道": "مَسَارُ الشَّمْسِ (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول…)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "黄道光": "اَلْفَجْر اَلْكَاذِب",
 "黄道帯": "أَبْرَاجُ السَّمَاء",
 "黄金": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / ذَهَبِيّ / نُقُود, مَال\nمثال: أريد بعض المال.",
 "黄金の山": "منجم ذهب (منجم يُعثر فيه على خام الذهب)",
 "黄金世界": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "黄金分割": "النِّسْبَة الذَّهَبِيَّة (العلاقة التناسبية بين قسمين من خط أو بُعدين لشكل مستوٍ بحيث تكون النسبة بين…)",
 "黄金千貫": "بَطَاطَا حُلْوَة",
 "黄金国": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في…)",
 "黄金律": "القاعدة الذهبية (أمر يستند إلى كلمات يسوع في الموعظة على الجبل)\nمثال: فكل ما تريدون أن يفعل الناس بكم افعلوا هكذا أنتم أيضاً بهم",
 "黄金時代": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "黄金期": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "黄金比": "الرَقْم الذَهَبِيّ",
 "黄金率": "الرَقْم الذَهَبِيّ",
 "黄金色": "ذَهَبِيّ",
 "黄金色植物": "الطحالب الذهبية, قسم الطحالب الذهبية (طحالب حقيقية النواة تعيش غالباً في المياه العذبة ويحجب فيها صبغة بنية أو صفراء…)",
 "黄金虫": "جعران (أي من الأنواع العديدة من الخنافس ممتلئة الجسم ذات رؤوس بقرون قرنية)",
 "黄金術": "اَلْخِيمِيَاء, خِيمِيَاء",
 "黄金郷": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في…)",
 "黄鉄鉱": "بايرايت الحديد, بايريت (معدن شائع (ثنائي كبريتيد الحديد) لونه أصفر شاحب)",
 "黄鉛": "أصفر الكروم (أي من الأصباغ الصفراء المتعددة التي تتكون من كرومات الرصاص العادية ومركبات…)",
 "黄鉛鉱": "ولفينيت (معدن أصفر إلى برتقالي أو بني يستخدم كخام للموليبدينوم)",
 "黄銅": "شَبَه\nمثال: بدأ سامي من نقطة الصفر.",
 "黄銅鉱": "بايريت النحاس, كالكوبيريت",
 "黄錫鉱": "بايريت القصدير, ستانيت (معدن رمادي غامق بلمعان معدني يعد مصدراً للقصدير)",
 "黄門": "خَصِيّ, مَخْصِيّ",
 "黄雀": "عصفور الشجر (عصفور شائع في الشتاء في شمال الولايات المتحدة)",
 "黄鶏": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "黄麻": "جوت",
 "黄麻布": "خيش (قماش الجوت الخشن)",
