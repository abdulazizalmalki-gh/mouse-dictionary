 "魔": "شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ…)\nمثال: العجلة من الشيطان. / الْأَلَدُّ الْخَصِم / رَهِيب, مَهُول (يسبب الخوف أو الرعب أو الهلع)",
 "魔の手": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "魔よけ": "طِلَسْم, طِلَّسْم",
 "魔人": "سَاحِر",
 "魔剤": "مَشْرُوب الطَّاقَة",
 "魔力": "قدرة سحرية (القدرة على أداء السحر)",
 "魔女": "سَاحِرَة",
 "魔女の一撃": "مُسْتَدَقّ الظَّهْر",
 "魔女狩り": "مُطَارَدَةُ السَّاحِرَاتِ",
 "魔導": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر. / الجحيم, العالم السفلي ((الأديان) عالم الموتى)\nمثال: لا أحد يذهب إلى هاديس بكل ثروته الهائلة",
 "魔導士": "سَاحِر",
 "魔導師": "سَاحِر",
 "魔導書": "غريموار, كتاب تعاويذ (دليل للسحر الأسود (لاستحضار الأرواح والشياطين))",
 "魔弾": "دواء ناجع, رصاصة سحرية (علاج (دواء أو علاج أو وقائي) يشفي أو يمنع المرض)\nمثال: لا توجد رصاصة سحرية ضد السرطان",
 "魔性": "بِشَيْطَنَة, بِمَكْر شَدِيد (بطريقة شيطانية لعوبة)\nمثال: الاشتراكيون يواجهون عائقاً إضافياً إذا اعتقدوا أن الرأسماليين ليسوا أشراراً فحسب بل أذكياء بشيطنة أيضاً",
 "魔方陣": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "魔方陣行列": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "魔書": "غريموار, كتاب تعاويذ (دليل للسحر الأسود (لاستحضار الأرواح والشياطين))",
 "魔法": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "魔法のじゅうたん": "بِسَاط سِحْرِيّ, بِسَاط الرِّيح",
 "魔法の杖": "عَصًا, مِخْصَرَة (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "魔法の絨毯": "بِسَاط سِحْرِيّ, بِسَاط الرِّيح",
 "魔法びん": "ترمس (قارورة مفرغة تحفظ درجة حرارة المشروبات الساخنة أو الباردة)",
