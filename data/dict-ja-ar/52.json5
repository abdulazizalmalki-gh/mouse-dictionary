 "額づく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額を寄せ合う": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "額を突く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)",
 "額を集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "額付き": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "額入り": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "額田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "額突く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額突虫": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "額縁": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ)\nمثال: دهنت أطر النافذة بالأصفر. / عارضة (الجزء السفلي من السطح المعمد؛ يرتكز مباشرة على تيجان الأعمدة)",
 "額衝く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額装": "تأطير, صياغة (صياغة الخطط والتفاصيل الهامة)\nمثال: صياغة المراسيم القضائية",
 "額角": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس)",
 "額賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "額際": "خط الشعر, منبت الشعر (الحد الطبيعي الذي يشكله الشعر على الرأس)",
 "額面": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية)",
 "額面どおり": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / حَرْفِيًّا, كَلِمَة بِكَلِمَة (باستخدام نفس الكلمات تماماً)\nمثال: كرر ملاحظاتها حرفياً",
 "額面価格": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية)",
 "額面株": "قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة…)",
 "額面超過額": "إصدار مُكَلف",
 "額面通り": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / حَرْفِيًّا, كَلِمَة بِكَلِمَة (باستخدام نفس الكلمات تماماً)\nمثال: كرر ملاحظاتها حرفياً",
 "額髪": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين)",
 "顎": "فَكّ / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم' / ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل…) / خَيْشُوم, نَخْشُوش",
 "顎で使う": "هَذَى",
 "顎の骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "顎下腺": "غدة تحت الفك السفلي (غدة لعابية داخل الفك السفلي على كلا الجانبين تنتج معظم اللعاب الليلي؛ تفرغ…)",
 "顎割れ": "طَابَع اَلْحُسْن",
 "顎動脈": "شريان فكي علوي (أي من شريانين يتفرعان من الشريان السباتي الظاهر ويغذيان تراكيب الوجه)",
 "顎紐": "حزام الذقن (شريط متصل بقبعة؛ يمر تحت الذقن ويثبت القبعة في مكانها)",
 "顎脚": "رجل فكية, قدم فكية (واحدة من مجموعة من ثلاثة زوائد مزدوجة على صدر القشريات عشاريات الأرجل، تقع خلف…)\nمثال: الزائدة المعدلة للمساعدة في التغذية تعرف بالرجل الفكية",
 "顎門": "ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل…) / خَيْشُوم, نَخْشُوش",
 "顎関節": "مفصل صدغي فكي, مفصل فكي (المفصل بين رأس عظم الفك السفلي والعظم الصدغي)",
 "顎関節症": "مفصل صدغي فكي, مفصل فكي (المفصل بين رأس عظم الفك السفلي والعظم الصدغي)",
 "顎骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "顎髭": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "顎鬚": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "顎鬚海豹": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط…)",
 "顏": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "顔": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف. / نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / مَلَامِح / شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "顔かたち": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "顔がほころぶ": "خَشَبَة",
 "顔が綻ぶ": "خَشَبَة",
 "顔が見える": "قابل للتعرف عليه, ممكن تحديد هويته (يمكن التعرف عليه أو تحديده)",
 "顔きき": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "顔つき": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "顔つなぎ": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي.",
 "顔ない": "مُحْرَج, بِٱلْحَرَج",
 "顔なじみ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔に紅葉を散らす": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "顔ばせ": "مَلَامِح",
 "顔ぶれ": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "顔をしかめる": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔をたてる": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "顔をゆがめる": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔を合わす": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "顔を合わせる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "顔を歪める": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔を立てる": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "顔を赤らめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "顔を顰める": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔アップ": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو…)",
 "顔パンツ": "قناع الوجه (قناع يوفر غطاءً واقياً للوجه في رياضات مثل البيسبول أو كرة القدم أو الهوكي)",
 "顔中": "جَمِيع أَنْحَاء, كُلّ",
 "顔付き": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "顔写真": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "顔出し": "تَزَاوُر, زِيَارَة (نشاط القيام بالزيارات)\nمثال: كان الغرض هو الترويج للمنازل والنوادي والتزاور والخدمات الأخرى / حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "顔利き": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "顔合せ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج)\nمثال: الاقتران العرضي للمراهقين / مباراة, مواجهة (المزاوجة بين الناس أو الأشياء للمقارنة أو المنافسة)\nمثال: كانت مباراة جيدة لكن الفريق المضيف فاز",
 "顔合わせ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج)\nمثال: الاقتران العرضي للمراهقين / مباراة, مواجهة (المزاوجة بين الناس أو الأشياء للمقارنة أو المنافسة)\nمثال: كانت مباراة جيدة لكن الفريق المضيف فاز",
 "顔合わせる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "顔容": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "顔射": "تنظيف بشرة, علاج الوجه (عناية بالوجه تتضمن عادةً التنظيف والتدليك ووضع الكريمات التجميلية)\nمثال: تدليك وجهي",
 "顔形": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "顔役": "رَئِيس, رَئِيسَة",
 "顔文字": "رمز تعبيري (تمثيل لتعبير وجهي (مثل الابتسامة أو العبوس) يتم إنشاؤه بكتابة سلسلة من الأحرف…)\nمثال: -( و :-) رموز تعبيرية",
 "顔料": "دهان, طلاء (مادة تستخدم كطلاء لحماية أو تزيين سطح (خاصة خليط من صبغة معلقة في سائل)؛ تجف…) / دِهَان\nمثال: ما هو لون شعرك؟",
 "顔映し": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود)",
 "顔本": "فَيْس بُوك, فِيس بُوك",
 "顔立ち": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "顔立て": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "顔筋": "عضلة وجهية (أي من العضلات الهيكلية للوجه)",
 "顔繋ぎ": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي.",
 "顔色": "بَشْرَة / مَلَامِح",
 "顔見知り": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔触れ": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "顔認識": "التعرف على الوجه, التمييز الوجهي (تحديد هوية بيومتري عن طريق مسح وجه الشخص ومطابقته مع مكتبة من الوجوه المعروفة)\nمثال: استخدموا التعرف على الوجه لرصد الإرهابيين المعروفين",
 "顔貌": "مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "顔面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "顔面潮紅": "هِبَّة الْحَرَارَة, وَمْضَة سَاخِنَة",
 "顔面神経": "عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)",
 "顔面神経痛": "ألم العصب الثلاثي التوائم (ألم عصبي انتيابي شديد على طول العصب الثلاثي التوائم)",
 "顔面神経麻痺": "عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)",
 "顔面筋": "عضلة وجهية (أي من العضلات الهيكلية للوجه)",
 "顔馴染": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔馴染み": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔黒": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "顕": "مَكْشُوف, مُعَرَّض / عَلَنِيّ, عَامّ / تعريض (فعل تعريض شخص ما لتجربة مؤثرة)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "顕す": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا)\nمثال: كشف كارل المزيد. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "顕る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
