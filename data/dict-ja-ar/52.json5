 "鳥肌": "قشعريرة, منعكس محرك للشعر (انتصاب انعكاسي لشعر الجلد استجابة للبرد أو الضغط العاطفي أو تهيج الجلد)",
 "鳥胸肉": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "鳥脚類": "أورنيثوبود (ديناصور عشبي يسير على قدمين)",
 "鳥葬": "دفن سماوي (طقس جنائزي تيبتي تقليدي تُعرض فيه الجثة في الهواء الطلق لتأكلها النسور المقدسة)",
 "鳥観": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "鳥谷部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳥越": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳥頭": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "鳥類": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "鳥類学": "عَلِمَ الطَائِر, عَلِم الطُيُور (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "鳥類学者": "عَالِم طُيُور, خَبِير فِي عِلْمِ الطُّيُور (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "鳥食い蜘蛛": "رُتَيْل",
 "鳥食蜘蛛": "رُتَيْل",
 "鳥飯": "دجاج وأرز (أرز ودجاج مطبوخان معاً مع أو بدون مكونات أخرى ومتبلة بشكل متنوع)",
 "鳥飼い": "تَرْبِيَة الطُيُور",
 "鳥餌": "بذور الطيور, طعام الطيور (طعام يقدم للطيور؛ عادة ما يكون خليطاً من البذور)",
 "鳥黐": "دبق (مادة لاصقة لزجة تدهن على الأغصان الصغيرة لاصطياد الطيور الصغيرة)",
 "鳩": "حَمَامَة",
 "鳩ぽっぽ": "حَمَامَة",
 "鳩合": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "鳩小屋": "برج الحمام (بيت لطيور الحمام)",
 "鳩尾": "الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "鳩山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳩座": "الْحَمَامة",
 "鳩時計": "ساعة الوقواق (ساعة تعلن عن الساعات بصوت يشبه نداء طائر الوقواق)",
 "鳩派": "يَمَام, حَمَام",
 "鳩目": "حلقة معدنية, عروة (مثبت يتكون من حلقة معدنية لتبطين ثقب صغير للسماح بربط الحبال أو الخيوط) / ثقب صغير, عيينة (ثقب صغير (عادة ما يكون مستديراً ومنتهياً حول الحواف) في القماش أو الجلد لمرور حبل أو خطاف أو قضيب) / أيلت, قماش مخرم (قماش مزين بثقوب صغيرة ذات حواف مخيطة بدقة تشكل نمطاً زخرفياً) / حَمَامِيّ / حَمَامِيَّة",
 "鳩羽色": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "鳩胸": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "鳩舎": "برج الحمام (بيت لطيور الحمام)",
 "鳩麦": "دَمْع أَيُّوب (فعل ثلاثي؛ سال دمعه)\nمثال: شكرت جميل صنعكم بدمعي، ودمع العين مقياس الشعور.",
 "鳰": "غطاس صغير (غطاس أوروبي صغير)",
 "鳰鳥": "غطاس صغير (غطاس أوروبي صغير)",
 "鳳": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳳仙花": "بَلْسَم, مَرْهَم",
 "鳳凰": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳳凰座": "فِينِيكْس, فُقْنُس",
 "鳳凰木": "بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "鳳梨": "أَنَانَاس",
 "鳴いた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "鳴かず飛ばず": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)",
 "鳴き声": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "鳴き鳥": "طائر مغرد (أي طائر له نداء موسيقي)",
 "鳴く": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "鳴った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "鳴らす": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "鳴り": "جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / تقديم الخاتم (إعطاء خاتم كرمز للخطوبة) / دق الجرس, رنين (صوت رنين الجرس)\nمثال: الرنين المميز لجرس الكنيسة",
 "鳴りとどろく": "صَدًى",
 "鳴りはためく": "صَدًى",
 "鳴りを潜める": "تَوَارَى عَنْ الْأَنْظَار",
 "鳴りを静める": "تَوَارَى عَنْ الْأَنْظَار",
 "鳴り物": "آلَة مُوسِيقِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "鳴り物入り": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / بهرجة, تباهي (عرض خارجي مبهرج)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "鳴り轟く": "صَدًى",
 "鳴り響く": "صَدًى",
 "鳴る": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "鳴る神": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "鳴兎": "بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية)",
 "鳴動": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "鳴声": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "鳴子": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "鳴子百合": "خاتم سليمان, نجمة داود (نجمة سداسية مكونة من مثلثين متساويي الأضلاع)",
 "鳴戸": "دَوَّامَة",
 "鳴海": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳴物": "آلَة مُوسِيقِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "鳴物入り": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / بهرجة, تباهي (عرض خارجي مبهرج)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "鳴白鳥": "تم بواق (بجعة برية بيضاء نقية كبيرة من غرب أمريكا الشمالية لها صرخة رنانة)",
 "鳴神": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "鳴禽": "طائر مغرد (أي طائر له نداء موسيقي)",
 "鳴禽類": "طائر مغرد (طائر جاثم له جهاز صوتي متخصص) / شادي, غريد (من أو متعلق بالطيور المغردة)",
 "鳴管": "مصفار",
 "鳴門": "دَوَّامَة / نَارُوتُو",
 "鳴門巻き": "آت",
 "鳴門金時": "بَطَاطَا حُلْوَة",
 "鳴鳥": "طائر مغرد (أي طائر له نداء موسيقي)",
 "鳶": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف) / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار) / بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "鳶の者": "إِطْفَائِيّ / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "鳶一": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鳶口": "مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار)",
 "鳶尾": "زهرة الزنبق ((شعارات النبالة) شحنة تتكون من تمثيل تقليدي لزهرة السوسن) / زنبق السيف, سوسن (نباتات ذات أوراق تشبه السيف وسيقان منتصبة تحمل أزهاراً زاهية الألوان تتكون من ثلاث بتلات وثلاث سبلات متدلية)",
 "鳶工": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها)",
 "鳶職": "عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / إِطْفَائِيّ",
 "鳶職人": "متسلق الأبراج (شخص يبني أو يصون الهياكل العالية جداً)",
 "鳶色": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "鴇": "حُبَارَى",
 "鴇崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鴇色": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "鴇色コンドル": "نسر الملك (نسر كبير أسود وأبيض من أمريكا الجنوبية والوسطى؛ له زوائد لحمية ملونة ونتوءات تشبه الثآليل على الرأس والرقبة)",
 "鴇草": "بوجونيا (أي أوركيد مستنقعات قوي التحمل من جنس بوجونيا: بساتين فاكهة أرضية ذات جذامير نحيلة وسيقان منتصبة تحمل ورقة واحدة أو بضع أوراق وزهرة طرفية وحيدة)",
 "鴉": "غُرَاب, زَاغ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "鴉髻": "فَحْمِيّ",
 "鴎": "نَوْرَس",
 "鴗": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "鴛海": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鴛鴦": "بطة الماندرين (بطة آسيوية متوجة مبهرجة؛ غالباً ما تُستأنس)",
 "鴟": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف) / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار) / بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "鴨": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة. / فريسة سهلة, هدف سهل (ضحية بلا دفاع)",
 "鴨にする": "يخدع",
 "鴨る": "غَشَّ, جَدَعَ",
 "鴨嘴": "خُلْدُ ٱلْمَاء, مِنْقَارُ ٱلْبَطّ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)",
 "鴨嘴竜": "ديناصور بطي المنقار, هادروصور (أي من العديد من الديناصورات الكبيرة التي تسير على قدمين ولها منقار قرني يشبه منقار البط وأقدام مكففة؛ ربما كانت مائية جزئياً)",
 "鴨場": "صيد البط (صيد البط)",
 "鴨居": "عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة)",
 "鴨志田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鴨打ち": "صيد البط (صيد البط)",
 "鴨撃ち": "صيد البط (صيد البط)",
 "鴨猟": "صيد البط (صيد البط)",
 "鴨目": "إِوَزِّيّ / إِوَزِّيَّة",
 "鴨肉": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "鴨脚樹": "جنكة, شجرة كزبرة البئر (شجرة صينية ثنائية المسكن نفضية لها أوراق مروحية الشكل وبذور صفراء لحمية؛ توجد بشكل حصري تقريباً في الزراعة خاصة كشجرة زينة في الشوارع)",
 "鴨茅": "إصبعية متكتلة, عشب البساتين (عشب قش ومرعى قوي من العالم القديم يُزرع على نطاق واسع)",
 "鴫": "دُرَّيْجَة",
 "鴫駝鳥": "تنام (طائر صيد ثقيل الجسم صغير الجناحين من أمريكا الجنوبية يشبه الطيور الدجاجية ولكنه قريب من الطيور المسطحة الصدر)",
 "鴬張り": "عَنْدَلِيب, بلبل",
 "鴬色": "أخضر زيتوني (لون أفتح وأكثر خضرة من الزيتوني)",
 "鴴": "زقزاق (أي من طيور شاطئية عديدة ذات بنية مدمجة نسبياً ومناقير مستقيمة وأجنحة مدببة كبيرة؛ قريبة الصلة بطيور الطيطوي)",
 "鴻大": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "鴻鵠": "بَطَل, بَطَلَة",
 "鴾毛": "بالومينو (حصان لونه أسمر فاتح أو ذهبي مع عرف وذيل بلون الكريم أو الأبيض)",
 "鴿": "حَمَامَة",
 "鵄": "حدأة سوداء (حدأة داكنة من العالم القديم تتغذى بشكل رئيسي على الجيف) / عامل بناء (عامل ماهر في بناء المكاتب أو المساكن وغيرها) / مِحْراك النار (قضيب معدني بمقبض؛ يستخدم لتحريك النار) / بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "鵆": "زقزاق (أي من طيور شاطئية عديدة ذات بنية مدمجة نسبياً ومناقير مستقيمة وأجنحة مدببة كبيرة؛ قريبة الصلة بطيور الطيطوي)",
 "鵐": "درسة (أي من الطيور المغردة آكلة البذور العديدة في أوروبا أو أمريكا الشمالية) / قماش الأعلام (قماش فضفاض النسج يستخدم للأعلام، إلخ)",
 "鵜": "غَاقِيَات",
 "鵜呑み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "鵜呑みにする": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "鵜殿": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鵜澤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鵜飼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鵝口瘡": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "鵝毛": "زَغَبُ الإِوَزّ (زغب الإوز)",
 "鵞ペン": "ريشة (قلم مصنوع من ريش الطيور)",
 "鵞口瘡": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "鵞口瘡菌": "كانديدا, مبيضات (أي من الفطريات الناقصة الشبيهة بالخميرة من جنس كانديدا)",
 "鵞毛": "زَغَبُ الإِوَزّ (زغب الإوز)",
 "鵠": "تَمّ, قُقْنُس / تَمّ, قُقْنُس / إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة.",
 "鵰": "عُقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)",
 "鵲": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鵲笛鴉": "عقعق أسترالي (طيور مغردة سوداء وبيضاء تشبه العقعق)",
 "鵲豆": "لَبْلَاب",
 "鵺": "مخلوق أسطوري, وحش أسطوري (وحش مشهور في الفولكلور والأسطورة) / لُغْز, غَامِضَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "鵺的": "غَامِض",
 "鶇": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "鶉": "سُمَّان, سَلْوَى",
 "鶉水鶏": "مرعة الغيط (طائر مرعة أوراسي شائع يتردد على حقول الحبوب)",
 "鶉秧鶏": "مرعة الغيط (طائر مرعة أوراسي شائع يتردد على حقول الحبوب)",
 "鶏": "دَجَاج, لَحْم دَجَاج\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل. / مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة) / دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام)",
 "鶏から揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "鶏がらスープ": "مرق الدجاج (مرق مصنوع من الدجاج)",
 "鶏むね肉": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "鶏ガラスープ": "مرق الدجاج (مرق مصنوع من الدجاج)",
 "鶏冠": "عرف (العرف اللحمي الأحمر على رأس الدجاج الداجن وغيره من الطيور الداجنة) / قبعة المهرج (قبعة يرتديها مهرجو البلاط؛ مزينة بشريط أحمر) / متأنق مغرور (متأنق مغرور معجب جداً بإنجازاته الخاصة) / عرف الديك (نبات حولي للحدائق ذو سنابل تشبه الريش من الزهور الحمراء أو الصفراء)",
 "鶏冠木": "قَيْقَب",
 "鶏冠石": "رَهَج اَلْغَار",
 "鶏唐揚": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "鶏唐揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "鶏姦": "جنس شرجي, لواط (الجماع عبر فتحة الشرج، يرتكبه رجل مع رجل أو امرأة)",
 "鶏小屋": "خم دجاج, قن دجاج (مبنى مزرعة لإيواء الدواجن)",
 "鶏眼": "غَلَّة",
 "鶏肉": "دَجَاج, لَحْم دَجَاج",
 "鶏胸肉": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "鶏足": "ساق دجاجة (المفصل السفلي لساق الدجاجة)",
 "鶏飯": "دجاج وأرز (أرز ودجاج مطبوخان معاً مع أو بدون مكونات أخرى ومتبلة بشكل متنوع)",
 "鶏鳴": "بزوغ الفجر, شروق (ضوء النهار الأول)\nمثال: استيقظنا قبل الفجر",
 "鶚": "عُقَاب نُسَارِيّ, عُقَاب نُسَارِيَّة (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "鶫": "دُجّ (دب وأسرع وتجر؛ يُقَال مَا حج وَلَكِن دج لم يقْصد النّسك بل قصد التِّجَارَة)",
 "鶯": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶯張り": "عَنْدَلِيب, بلبل",
 "鶯色": "أخضر زيتوني (لون أفتح وأكثر خضرة من الزيتوني)",
 "鶲": "صائد الذباب (العالم القديم) (أي من مجموعة كبيرة من الطيور المغردة الصغيرة التي تتغذى على الحشرات التي يتم اصطيادها أثناء الطيران)",
 "鶴": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "鶴喰": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶴嘴": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "鶴岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶴座": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "鶴沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶴澤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶴田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶴見": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鶴頚": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "鶴頸": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "鶴首": "أَتْلَع ((أَتْلَعَ) الْحَيَوَانُ وَالْإِنْسَانُ: تَلَعَ؛ (أَتْلَعَ) الرجلُ: مد عُنُقه)",
 "鶴首して待つ": "اِشْتَاقَ",
 "鶺鴒": "ذُعْرَة, هَزَّاز الذَّنَب",
 "鷂": "بَاشِق",
 "鷓鴣": "دُرَّاج / حَجَل, قبج (طَائِرٌ مِنْ فَصيلَةِ التَّدْرُجِيَّاتِ، مِنْ رُتْبَةِ الدَّجاجِيّاتِ، رَمادِيُّ اللَّوْنِ، أَحْمَرُ المِنْقارِ والسَّاقَيْنِ…؛ حَجَلُ: الذَّكَرُ من القَبَجِ، الواحدةُ: حَجَلَةٌ)\nمثال: إن الإسم \"سكورة\" مشتق من كلمة \"تاسكورت\" الذي يعني حجلة بالأمازيغية.",
 "鷙禽": "طَيْر جَارِح",
 "鷙鳥": "طَيْر جَارِح",
 "鷦鷯": "صَعْو / وَصْع",
 "鷭": "دجاجة الماء (أنثى طائر الطيهوج الأحمر) / دجاجة الماء (دجاجة ماء سوداء تسكن البرك والبحيرات)",
 "鷲": "عُقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "鷲座": "الْعُقَاب",
 "鷲津": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鷲獅子": "نسر أسمر (نسر كبير من جنوب أوروبا وشمال أفريقيا ذو ريش شاحب وأجنحة سوداء) / غريفون (سلالة من الكلاب متوسطة الحجم طويلة الرأس ذات طبقة تحتية زغبية وطبقة خارجية خشنة سلكية؛ نشأت في هولندا ولكن طورت بشكل كبير في فرنسا) / غريفون, غريفون بروكسل (سلالة من الكلاب الصغيرة جداً المدمجة ذات الشعر السلكي من أصل بلجيكي ولها خطم ملتح قصير) / غريفين, فتخاء (وحش مجنح برأس نسر وجسم أسد)",
 "鷲谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鷲鼻": "أَنْف مَعْقُوف (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "鷸": "دُرَّيْجَة",
 "鷸駝鳥": "تنام (طائر صيد ثقيل الجسم صغير الجناحين من أمريكا الجنوبية يشبه الطيور الدجاجية ولكنه قريب من الطيور المسطحة الصدر)",
 "鷹": "صَقْر, بَاز",
 "鷹匠": "بازيار, صقار (شخص يربي ويدرب الصقور ويمارس رياضة الصيد بالصقور)",
 "鷹司": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鷹岬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鷹揚": "خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن",
 "鷹梨": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鷹派": "صَقْر, بَاز",
 "鷹狩": "صَقَارَة",
 "鷹狩り": "صَقَارَة",
 "鷹野": "صَقَارَة",
 "鷺": "مَالِكُ الحَزِين, بَلَشُون (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "鷺笛": "سمكة قناصة (سمكة صغيرة تعيش في قاع البحار الدافئة ذات جسم مضغوط وخطم طويل وفم عديم الأسنان)",
 "鷺草": "أوركيد مهدب (أي من عدة بساتين فاكهة أمريكية تزهر صيفاً تتميز بشفة مهدبة أو ممزقة)",
 "鸊鷉": "غطاس (طائر مائي صغير مدمج الجسم بالكامل تقريباً يبني أعشاشاً عائمة؛ يشبه الغواص ولكنه أصغر وله أقدام مفصصة بدلاً من مكففة)",
 "鸙野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鸚鵡": "بَبَّغَاء (طائر من فصيلة كبيرة من الطيور ذوات ألوان زاهية قادرة على تقليد صوت كلام الإنسان دون القدرة على التواصل بالكلام)",
 "鸚鵡貝": "نوتي (رأسيات الأرجل في المحيطين الهندي والهادئ لها صدفة حلزونية ذات حواجز لؤلؤية شاحبة)",
 "鹵獲": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "鹵獲品": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته واستولت عليه)\nمثال: لقد سلب مني كل شيء.",
 "鹵石": "هَالِيت",
 "鹸化": "تصبن (تفاعل كيميائي يتم فيه تسخين إستر مع مادة قلوية (خاصة التحلل المائي القلوي للدهون أو الزيوت لصنع الصابون))",
 "鹹味": "مُلُوْحَة",
 "鹹塩": "مِلْح, ملح / مَلَّحَ / مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "鹹水": "أُجَاج, صِير (أُجاجاً الماء الشديد الملوحة والمرارة؛ الصوت الحاصل من اختلاط الكلام و حفيف المشي)",
 "鹹水魚": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "鹹湖": "بُحَيْرَة مِلْحَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "鹽花": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "鹿": "أَيِّل / مُتَوَحِّش / صَيْد / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / أَيِّل",
 "鹿の子": "أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان) / شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "鹿の子斑": "أَبْرَش (مِن على جلده نقط بيضاء، أو نقط يختلف لونها عن لون الجلد، فيُقال فَرَسٌ أَبْرَش؛ يُقال مَكَانٌ أَبْرَش أي كثير النبات مختلف الألوان)",
 "鹿の子編み": "بيكيه (قماش منسوج بإحكام مع أضلاع بارزة) / فورة غضب, هيجان (نوبة مفاجئة من الغضب)\nمثال: اشتعل غضبه كالحطب الجاف",
 "鹿の角": "قَرْن الْأَيِّل (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "鹿児島": "كَاغُوشِيمَا",
 "鹿垣": "حِظَار",
 "鹿子": "أَيِّل",
 "鹿寨": "حِظَار",
 "鹿島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鹿柴": "حِظَار",
 "鹿毛": "غَزَالِيّ اللَّوْن (بلون الغزال؛ بني فاتح مصفر)",
 "鹿爪らしい": "بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)",
 "鹿狩り": "صَيْد",
 "鹿猪": "بَابِيرُوسَة",
 "鹿田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鹿皮": "جلد الغزال (جلد مصنوع من إهاب الغزال)",
 "鹿砦": "حِظَار",
 "鹿肉": "لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / أَيِّل",
 "鹿野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鹿革": "جلد الغزال (جلد مصنوع من إهاب الغزال)",
 "麁": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "麁物": "مَلَابِس, ثِيَاب",
 "麇": "يَحْمُور, يَأْمُور",
 "麋": "مُوظ",
 "麒麟": "زَرَافَة (حيوان عشبي يتميز بالعنق الطويل)\nمثال: قتله ذكر زرافة.",
 "麒麟児": "طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة.",
 "麒麟座": "زَرَافَة (حيوان عشبي يتميز بالعنق الطويل)\nمثال: قتله ذكر زرافة.",
 "麒麟竭": "دم الأخوين, دم التنين (مادة راتنجية حمراء داكنة مشتقة من أشجار مختلفة وتستخدم في النقش الضوئي)",
 "麒麟羚羊": "جرنوق (ظبي شرق أفريقي نحيل ذو رقبة رفيعة وقرون منحنية للخلف)",
 "麒麟血": "دم الأخوين, دم التنين (مادة راتنجية حمراء داكنة مشتقة من أشجار مختلفة وتستخدم في النقش الضوئي)",
 "麓": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "麕": "يَحْمُور, يَأْمُور",
 "麗々": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "麗々しい": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "麗しい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل. / دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "麗しの": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل. / دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "麗ら": "لَامِع, نَيِّر / مُسْتَنِير",
