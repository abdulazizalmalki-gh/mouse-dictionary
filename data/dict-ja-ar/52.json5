 "黒焼け": "شار",
 "黒熊": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني)",
 "黒熱病": "داء الليشمانيات (تقرحات ناتجة عن عدوى استوائية بطفيليات من جنس الليشمانيا)",
 "黒犀": "وحيد القرن الأسود",
 "黒猩々": "شِمْبَانْزِي",
 "黒猩猩": "شِمْبَانْزِي",
 "黒猫": "القطة السوداء",
 "黒玉": "تِلْمِيذ, تِلْمِيذَة / مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "黒田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "黒白": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود)",
 "黒皮症": "تصبغ, قتام (حالة تتميز برواسب غير طبيعية من الميلانين)",
 "黒盗賊鴎": "كركر طفيلي, كركر قطبي (نوع من الكركر)",
 "黒目豆": "لُوبِيَاء, لُوبِيَا",
 "黒眼鏡": "نَظَّارَة شَمْسِيَّة, نَظَّارَة شَمْس",
 "黒石": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان…)\nمثال: لديه قميص أسود.",
 "黒砂糖": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "黒種子草": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة)",
 "黒種草": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة)",
 "黒穂": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة…)",
 "黒穂病": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة…)",
 "黒穂菌": "تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس)",
 "黒竜江": "هِيلُونْغْجْيَانْغ, خِيلُونْغْجْيَانْغ",
 "黒竹": "خيزران أسود (خيزران صغير له سيقان خضراء رقيقة تتحول إلى اللون الأسود اللامع)",
 "黒米": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "黒糖": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "黒糖焼酎": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "黒翳": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "黒胡椒": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته…)\nمثال: نحب الفلفل الحار.",
 "黒色": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان…)\nمثال: لديه قميص أسود.",
 "黒色人種": "العرق الأسود, زنوج (عرق ذو بشرة داكنة)",
 "黒色火薬": "بارود أسود (شكل بسيط من البارود، يتكون من خليط من نترات البوتاسيوم والفحم والكبريت؛ اختُرع…)\nمثال: يُعزى انتشار البارود الأسود عبر آسيا من الصين على نطاق واسع إلى المغول",
 "黒色腫": "ميلانوما, ورم ميلانيني (أي من الأورام الخبيثة المتعددة (عادة في الجلد) التي تتكون من الخلايا الصبغية…)",
 "黒色表皮腫": "شواك أسود (مرض جلدي يتميز ببقع داكنة تشبه الثآليل في ثنايا الجسم)",
 "黒芥子": "خردل أسود (نبات حولي أوراسي واسع الانتشار يزرع لبذوره النفاذة؛ مصدر رئيسي لخردل المائدة)",
 "黒茶": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "黒茶色": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "黒葦毛": "رمادي فولاذي (رمادي داكن يميل قليلاً للأرجواني أو الأزرق)",
 "黒藻": "هيدريلا (نبات مغمور بأوراق رمحية محيطية وأزهار إبطية منعزلة؛ نبات من العالم القديم…)",
 "黒虫": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً…)",
 "黒蛇": "ثعبان أسود, متسابق أسود (ثعبان متسابق مسود من شرق الولايات المتحدة ينمو حتى ستة أقدام)",
 "黒蜜": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "黒蠅": "ذبابة الزجاجة (ذبابة كبيرة عادة ما تكون مشعرة ذات لون أزرق أو أخضر معدني؛ تضع البيض في الجيف…)",
 "黒衣": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي) / خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "黒谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "黒豆の木": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "黒豆木": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "黒豹": "نَمِر أَسْوَد (عضو في حزب الفهود السود السياسي)",
 "黒貂": "سَمُّور",
 "黒質": "مَادَّة سَوْدَاء (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "黒足カコミスル": "أمريكي وسطي (من أو يتعلق بدول أو ثقافات أو شعوب أمريكا الوسطى)",
 "黒足信天翁": "قطرس أسود الرجلين (نوع من القطرس ذو أقدام سوداء)",
 "黒足鼬": "نمس أسود الأقدام (ثديي من العرسيات في مناطق البراري بالولايات المتحدة؛ مهدد بالانقراض تقريباً)",
 "黒金": "حَدِيد (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "黒金剛石": "ألماس أسود, كربونادو (ألماس داكن أقل جودة يستخدم صناعياً للحفر والتلميع)",
 "黒鉛": "غَرَافِيت",
 "黒闇": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما…)\nمثال: لدي خوف من الظلام.",
 "黒隠元豆": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "黒雁": "إوز أسود, برنت (إوز داكن صغير يتكاثر في الشمال ويهاجر جنوباً)",
 "黒雲母": "بيوتيت (ميكا بنية داكنة إلى سوداء توجد في الصخور النارية والمتحولة)",
 "黒雷鳥": "طيهوج أسود (طيهوج يكون الذكر فيه أسود مزرق)",
 "黒電気石": "شورل (تورمالين أسود)",
 "黒駁": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "黒魔法": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "黒魔術": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "黒鳥": "تَمّ أَسْوَد",
 "黒鳳蝶": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "黒鳶色": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "黒鴨": "بط أسود شائع (نوع من البط الأسود)",
 "黒麦": "سُلْت, شَيْلَم",
 "黔首": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "黔黎": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "黙々": "صَامِت, سَاكِت",
 "黙す": "صَمَتَ, سَكَتَ / إِهْمال",
 "黙する": "صَمَتَ, سَكَتَ",
 "黙り": "صَمْت, سُكُوت",
 "黙る": "صَمَتَ, سَكَتَ",
 "黙劇": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات)",
 "黙坊": "أبكم, صامت (شخص لا يتكلم)",
 "黙従": "إذعان, قبول (الموافقة على بيان أو اقتراح للقيام بشيء ما)\nمثال: أبدى موافقته بحماس",
 "黙想": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة)\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "黙殺": "تَجَاهَلَ, طَنَّش",
 "黙然": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "黙示": "اِنْطَوَى / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ…)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "黙示的": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "黙示録": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ…)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "黙約": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور)\nمثال: خسر المباراة بالتغيب",
 "黙考": "تَفَكُّر",
 "黙許": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "黙認": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "黙諾": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "黙黙": "صَامِت, سَاكِت",
 "黛": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "黝い": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "黝輝石": "سبودومين (معدن بيروكسين يتكون من سيليكات الليثيوم والألمنيوم؛ مصدر لليثيوم)",
 "點穴": "نقطة ضغط (منطقة على الجلد حساسة للغاية للضغط)\nمثال: يجب أن تعرف نقاط الضغط لكي تمارس شياتسو",
 "黥": "وَشْم",
 "黯然": "غَامِق, دَاكِن / أَسِيف, حَزِين (مليء بالحزن أو يثيره)",
 "黴": "قَالِب\nمثال: هم في نفس السن.",
 "黴臭い": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "黴菌": "جُرْثُومَة / خَشَاش, هَامَّة",
 "黽勉": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "黿": "سلحفاة خضراء (سلحفاة استوائية كبيرة ذات لحم مخضر يُستخدم في حساء السلاحف)"
}
