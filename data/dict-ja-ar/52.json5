 "驥足": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "骨": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / عَظْم / عضم / عَظْمَة / عضمة / رَمَاد, سَكَن / دَرْدَار / عَظْم / عضم / عَظْمَة / عضمة / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / لَخَّصَ, اِخْتَصَرَ / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "骨々し": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "骨っぽい": "عَظْمِيّ, كَثِير العِظَام (لديه عظام خاصة عظام كثيرة أو بارزة) / نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال) / عظمي (مكون من أو يحتوي على عظم)\nمثال: فيليه شاد (نوع سمك) مليء بالعظام",
 "骨っ節": "مُشْتَرَك / مِفْصَل / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "骨つき": "الجهاز الهيكلي, هيكل عظمي (الهيكل الصلب (العظام والغضاريف) الذي يوفر إطارًا لجسم الحيوان)",
 "骨と皮": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "骨なし": "بِلَا عِظَام, رَخْو (بدون عظم أو عظام)\nمثال: قنديل البحر بلا عظام / عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "骨になる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "骨に成る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "骨のある": "رَاسِخ, صَامِد (ثَابِتٌ وَمَوْثُوقٌ خَاصَّةً فِي الوَلَاءِ)",
 "骨の折れる": "شَاقّ, مُضْنٍ (يتّسم بجهد يصل إلى حدّ الإنهاك؛ خاصة الجهد البدني)",
 "骨付き": "الجهاز الهيكلي, هيكل عظمي (الهيكل الصلب (العظام والغضاريف) الذي يوفر إطارًا لجسم الحيوان)",
 "骨休め": "اِسْتِرْخَاءْ",
 "骨切り": "قطع العظم (قطع جراحي للعظم)",
 "骨化": "تَعَظُّم",
 "骨堂": "مستودع العظام, مقبرة العظام (قبو أو مبنى تُودع فيه الجثث أو العظام)",
 "骨増殖体": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "骨太": "عَرِيضُ العِظَام (ذو هيكل عظمي ضخم مقارنة بالجسم) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "骨太い": "عَرِيضُ العِظَام (ذو هيكل عظمي ضخم مقارنة بالجسم) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "骨太の方針": "عَرِيضُ العِظَام (ذو هيكل عظمي ضخم مقارنة بالجسم)",
 "骨子": "لُبّ",
 "骨学": "علم العظام (فرع التشريح الذي يدرس عظام الهيكل العظمي الفقاري)",
 "骨学者": "أخصائي علم العظام, عالم عظام (عالم تشريح ماهر في علم العظام)",
 "骨年齢": "عمر عظمي (عمر الشخص مقاساً بمطابقة نمو عظامه (كما يظهر في الأشعة السينية) مع نمو عظام شخص متوسط من عمر زمني معروف)",
 "骨幹": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "骨形成不全症": "تكون العظم الناقص, عظم زجاجي (اضطراب وراثي سائد في النسيج الضام يتميز بعظام هشة تنكسر بسهولة)",
 "骨惜しみ": "كَسَل",
 "骨折": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "骨折り": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "骨抜き": "عَظْم / عضم / عَظْمَة / عضمة / تَخْفِيف / إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف)",
 "骨材": "إِجْمَالِيّ, مَجْمُوع / سْكَانْدَا",
 "骨柄": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "骨格": "هَيْكَل عَظْمِيّ, هَيْكَل / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "骨格筋": "عضلة مخططة, عضلة هيكلية (عضلة متصلة في أحد طرفيها أو كليهما بعظم وبالتالي تحرك أجزاء من الهيكل العظمي؛ عضلة تتميز بخطوط عرضية)",
 "骨棘": "نابتة عظمية (نتوء عظمي غير طبيعي صغير)",
 "骨油": "زيت العظام (زيت داكن اللون كريه الرائحة يتم الحصول عليه بتفحيم العظام؛ يُستخدم خاصة في محاليل تغطيس الأغنام وفي تغيير طبيعة الكحول) / زيت العظام (الجزء السائل من دهن العظام؛ يُستخدم كمواد تشحيم وفي صناعة الجلود)",
 "骨法": "براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "骨灰": "رماد العظام (الرماد المتبقي عند حرق العظام؛ غني بفوسفات الكالسيوم؛ يستخدم كسماد وفي صناعة الخزف العظمي)",
 "骨灰磁器": "خزف عظمي (بورسلين فاخر يحتوي على رماد العظام)",
 "骨炎": "التهاب العظم (التهاب العظم نتيجة لعدوى أو صدمة أو تنكس)",
 "骨炭": "أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "骨無し": "بِلَا عِظَام, رَخْو (بدون عظم أو عظام)\nمثال: قنديل البحر بلا عظام / عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "骨片": "شويكة (هيكل مدبب صغير يعمل كعنصر هيكلي في مختلف اللافقاريات البحرية والمياه العذبة مثل الإسفنج والمرجان)",
 "骨牌": "وَرَقَة لَعْب, وَرَقَة",
 "骨牌函": "وَرَقَة لَعْب, وَرَقَة",
 "骨牌税": "وَرَقَة لَعْب, وَرَقَة",
 "骨疽": "تَسَوُّس",
 "骨盤": "حَوْض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "骨盤位": "ولادة مقعدية (ولادة يظهر فيها قدم الرضيع أو أردافه أولاً)",
 "骨盤帯": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف الخلفية أو الأجزاء المماثلة في الفقاريات الأخرى)",
 "骨相": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "骨相学": "علم فراسة الدماغ, فرينولوجيا (دراسة مهجورة الآن لشكل الجمجمة كمؤشر على قوى الملكات العقلية المختلفة)",
 "骨相学者": "أخصائي فراسة الدماغ (شخص يدعي القدرة على قراءة شخصيتك من شكل جمجمتك)",
 "骨節": "مُشْتَرَك / مِفْصَل",
 "骨粗しょう症": "هَشَاشَةُ العِظَام",
 "骨粗鬆症": "هَشَاشَةُ العِظَام",
 "骨細": "نَحِيف, أَهْيَف",
 "骨細胞": "خلية عظمية (خلية عظمية ناضجة)",
 "骨組": "هيكل, هيكل عظمي (هيكل الدعم الداخلي الذي يعطي القطعة الأثرية شكلها)\nمثال: المبنى له هيكل فولاذي / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / لَخَّصَ, اِخْتَصَرَ",
 "骨組み": "هيكل, هيكل عظمي (هيكل الدعم الداخلي الذي يعطي القطعة الأثرية شكلها)\nمثال: المبنى له هيكل فولاذي / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / لَخَّصَ, اِخْتَصَرَ",
 "骨肉": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر) / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "骨肉相食": "اِنْتِقَام, ثَأْر دَمَوِيّ (عداء يقتل فيه أعضاء الأطراف المتعارضة بعضهم البعض)",
 "骨肉腫": "ساركومة عظمية (ورم عظمي خبيث؛ أكثر شيوعًا عند الأطفال والشباب حيث يميل إلى التأثير على عظم الفخذ)",
 "骨脂": "دهن العظام (مادة دهنية في العظام تُستخرج بالمذيبات أو بالغليان أو بالبخار؛ تُستخدم بشكل رئيسي في الشموع والصابون الرخيص وشحوم التزييت)",
 "骨腫": "ورم عظمي (ورم حميد بطيء النمو يتكون من نسيج عظمي؛ عادة على الجمجمة أو الفك السفلي)",
 "骨膜": "سِمْحَاق",
 "骨芽細胞": "أرومة عظمية, خلية بانية للعظم (خلية يتطور منها العظم)",
 "骨芽細胞腫": "ورم أرومي عظمي (ورم حميد في العظام والأنسجة الليفية؛ يحدث في الفقرات أو عظم الفخذ أو الساق أو عظام الذراع (خاصة عند الشباب))",
 "骨董": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "骨董品": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "骨董市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "骨身を惜しまず": "صَارِم, لَا يَرْحَم (عديم الشفقة والرحمة؛ قاسٍ لا يتساهل) / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "骨身を惜しまない": "صَارِم, لَا يَرْحَم (عديم الشفقة والرحمة؛ قاسٍ لا يتساهل) / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "骨軟化症": "لين العظام (تلين غير طبيعي للعظام بسبب نقص الفوسفور أو الكالسيوم أو فيتامين د)",
 "骨軟骨腫": "ورم عظمي غضروفي (ورم حميد يحتوي على كل من العظام والغضاريف؛ يحدث عادة بالقرب من نهاية العظام الطويلة)",
 "骨迷路": "تِيه عَظْمِيّ (تجويف في الجزء الصخري من العظم الصدغي يحتوي على التيه الغشائي)",
 "骨関節炎": "فُصَال عَظْمِيّ",
 "骨関節症": "فُصَال عَظْمِيّ",
 "骨頂": "اِرْتِفَاع",
 "骨骨し": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "骨髄": "نُخَاع, نُخَاع العَظْم",
 "骨髄バンク": "نُخَاع, نُخَاع العَظْم",
 "骨髄抑制": "نُخَاع, نُخَاع العَظْم",
 "骨髄炎": "اِلْتِهَاب العَظْم والنَّقِيّ",
 "骨髄球": "خلية نخاعية (خلية دم بيضاء غير ناضجة توجد عادة في نخاع العظم)",
 "骨髄異形成症候群": "دكتور في الطب (درجة الدكتوراه في الطب) / طبيب (ممارس طبي مرخص) / مندليفيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الأينشتاينيوم بجسيمات ألفا)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "骨髄移植": "نُخَاع, نُخَاع العَظْم",
 "骨髄線維症": "تليف نقي العظم (تليف نخاع العظم)",
 "骨髄腫": "ورم نقوي (ورم في نخاع العظم (عادة ما يكون خبيثًا) يتكون من خلايا توجد عادة في نخاع العظم)",
 "骨髄芽球": "أرومة نخاعية (سلف لخلايا الدم البيضاء يوجد عادة فقط في نخاع العظم)",
 "骭": "قَصَبَة / شِين",
 "骰子": "زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام عشوائية)",
 "骸": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "骸炭": "كُولَا",
 "骸骨": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "髀臼": "تجويف حقي, حُق (التجويف الكأسي الشكل في عظم الورك الذي يستقبل رأس الفخذ لتشكيل مفصل كروي وحقي)",
 "髄": "لب, نخاع (الجزء الداخلي لعضو أو هيكل في النبات أو الحيوان) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي) / مايلين, نخاعين (مادة دهنية بيضاء تشكل غمداً نخاعياً حول المحور العصبي لبعض الألياف العصبية)\nمثال: النخاع المستطيل هو الجزء الأكثر حيوية في الدماغ لأنه يحتوي على مراكز تتحكم في التنفس ووظائف القلب / نِقْيُ ٱلْعَظْم, مُخُّ ٱلْعَظْم / كُوسَا / دِمَاغ / مخ (دِمَاغ) / نفوخ / دِماغ / مُخ (دِمَاغ)",
 "髄液": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "髄脳": "دماغ بصلي (الجزء الخلفي من الدماغ الخلفي في الفقاريات النامية؛ يشكل النخاع المستطيل في البالغين)",
 "髄膜": "الأَغْشِيَة السِحَائِيَّة",
 "髄膜炎": "اِلْتِهَاب سَحَايَا",
 "髄膜炎菌性髄膜炎": "التهاب السحايا الدماغي الشوكي, حمى مخية شوكية (التهاب سحايا تسببه البكتيريا وغالبًا ما يكون مميتًا)",
 "髄膜腫": "ورم سحائي (ورم ينشأ في السحايا التي تحيط بالدماغ والحبل الشوكي)",
 "髄虫": "ثاقبة الخشب, حفار الخشب (أي من الحشرات أو اليرقات أو الرخويات المختلفة التي تحفر في الخشب) / ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "髄質": "لب, نخاع (الجزء الداخلي لعضو أو هيكل في النبات أو الحيوان) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي) / مايلين, نخاعين (مادة دهنية بيضاء تشكل غمداً نخاعياً حول المحور العصبي لبعض الألياف العصبية)\nمثال: النخاع المستطيل هو الجزء الأكثر حيوية في الدماغ لأنه يحتوي على مراكز تتحكم في التنفس ووظائف القلب",
 "髄鞘": "الغِمْدُ المَيَالِينيّ",
 "髐骨": "هَيْكَل عَظْمِيّ, هَيْكَل / ضمور (انخفاض في حجم عضو ناتج عن مرض أو عدم الاستخدام)",
 "髑髏": "جُمْجُمَة",
 "高": "كَمِّيَّة, مِقْدَار / عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال / مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "高々": "عالياً, في الأعالي (على ارتفاع كبير)\nمثال: تسلق عالياً على السلم / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "高々度飛行": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه)",
 "高い": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال / غَالٍ, الْغَالِي / عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "高が": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "高さ": "اِرْتِفَاع",
 "高さアクセント": "نبر نغمي (تأكيد ينتج عن الحدة بدلاً من الجهارة)",
 "高じる": "طَوَّرَ",
 "高ずる": "طَوَّرَ",
 "高の知れた": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "高ぶり": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "高まり": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "高まる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "高み": "اِرْتِفَاع",
 "高め": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "高める": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "高らか": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "高をくくる": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "高を括る": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "高アルドステロン症": "الألدوستيرونية, فرط الألدوستيرونية (حالة ناتجة عن الإنتاج المفرط للألدوستيرون)",
 "高カリウム血症": "فرط بوتاسيوم الدم (مستويات البوتاسيوم في الدم المتداول أعلى من الطبيعي؛ يرتبط بالفشل الكلوي أو أحياناً باستخدام الأدوية المدرة للبول)",
 "高カルシウム尿症": "فرط كالسيوم البول (وجود مستويات عالية بشكل غير طبيعي من الكالسيوم في البول؛ عادة ما يكون نتيجة لامتصاص العظام المفرط في فرط نشاط جارات الدرق أو هشاشة العظام)",
 "高カルシウム血症": "فَرْط كَالْسِيُوم الدَّم, فَرْط كَالْسِيُوم فِي الدَّم",
 "高カロリー輸液": "تغذية وريدية كاملة (إعطاء محلول كافٍ غذائياً عبر قسطرة في الوريد الأجوف)",
 "高コレステロール血症": "فرط كوليسترول الدم (وجود كمية غير طبيعية من الكوليسترول في خلايا وبلازما الدم؛ يرتبط بخطر تصلب الشرايين)",
 "高ナトリウム血症": "فرط صوديوم الدم (كميات مفرطة من الصوديوم في الدم؛ ربما تشير إلى مرض السكري الكاذب)",
 "高ビリルビン血症": "فرط بيليروبين الدم (كميات عالية بشكل غير طبيعي من صبغة الصفراء (البيليروبين) في الدم)",
 "高ビー": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "高ピー": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "高フルクトースコーンシロップ": "هيدروفلوروكربون (فلوروكربون ينبعث كمنتج ثانوي للتصنيع الصناعي)",
 "高フルクトース・コーン・シロップ": "هيدروفلوروكربون (فلوروكربون ينبعث كمنتج ثانوي للتصنيع الصناعي)",
 "高リスク": "خَطِر, مُحْفُوفٌ بِالمَخَاطِر (غير آمن ماليًّا؛ ينطوي على مضاربة ومخاطرة عالية)",
 "高リポ蛋白血症": "فرط بروتينات الدم الشحمية (أي من الاضطرابات المختلفة لاستقلاب البروتين الدهني والكوليسترول والتي تؤدي إلى مستويات عالية من البروتين الدهني والكوليسترول في الدم المتنقل)",
 "高一": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "高三": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "高下": "تَذَبذُب, تَقَلُّب / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "高中": "مدرسة ثانوية, مدرسة ثانوية عليا (مدرسة ثانوية عامة تشمل عادة الصفوف من 9 إلى 12)\nمثال: يذهب إلى المدرسة الثانوية في الحي",
 "高久": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高二": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "高二酸化炭素血症": "فرط ثنائي أكسيد الكربون في الدم",
 "高井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高位": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة.",
 "高位株": "ثَمِين, غَالٍ (ذو سعر مرتفع)",
 "高低": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "高低アクセント": "نبر نغمي (تأكيد ينتج عن الحدة بدلاً من الجهارة)",
 "高体温": "فرط الحرارة (درجة حرارة الجسم عالية بشكل غير طبيعي؛ يتم تحفيزها أحياناً (كما في علاج بعض أشكال السرطان))",
 "高体温症": "فرط الحرارة (درجة حرارة الجسم عالية بشكل غير طبيعي؛ يتم تحفيزها أحياناً (كما في علاج بعض أشكال السرطان))",
 "高価": "غَالٍ, الْغَالِي",
 "高倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高僧": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "高処": "بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي",
 "高分子": "جزيء ضخم, جزيء كبير (أي جزيء معقد كبير جداً؛ يوجد فقط في النباتات والحيوانات)",
 "高分子材料": "بُولِيمَر",
 "高分子物質": "بُولِيمَر",
 "高分子電解質": "إلكتروليت مبلمر, بولي إلكتروليت (إلكتروليت ذو وزن جزيئي عالي)",
 "高利貸し": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "高卒": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "高原": "هضبة (أرض مرتفعة مستوية نسبياً)",
 "高収量品種": "عَالِي الإِنْتَاجِيَّة (يُنْتِجُ كَمِّيَّة كَبِيرَة مِنَ المُنْتَجَات الزِّرَاعِيَّة أَوِ الصِّنَاعِيَّة)",
 "高口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高台": "أرضية عليا, تفوق (موقف تفوق على الخصوم أو المنافسين)",
 "高名": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\") / مَشْهُور (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "高吟": "قَصِيدَة, شِعْر",
 "高周波": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها) / تَرَدُّد عَالٍ (3 إلى 30 ميجاهرتز)",
 "高周波数": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها) / تَرَدُّد عَالٍ (3 إلى 30 ميجاهرتز)",
 "高品位": "مُرْتَفِع الدَّرَجَة",
 "高品位テレビ": "تلفزيون عالي الوضوح (نظام تلفزيوني يحتوي على عدد أكبر من الخطوط لكل إطار بحيث تظهر صوره تفاصيل أكثر)",
 "高品位テレビジョン": "تلفزيون عالي الوضوح (نظام تلفزيوني يحتوي على عدد أكبر من الخطوط لكل إطار بحيث تظهر صوره تفاصيل أكثر)",
 "高品質": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "高圧": "الفُوُلطِيَةُ مُرتَفِعَةٌ",
 "高圧ガス": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "高圧水": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "高圧洗浄機": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "高圧的": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "高圧線": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الجُهْد (يعمل على جهد كهربائي مرتفع أو يُشغَّل به)",
 "高圧蒸気滅菌": "ضَاغِط, عَنِيف الإِقْنَاع (مُقنِع بإلحاح وعدوانية)",
 "高圧電流": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الجُهْد (يعمل على جهد كهربائي مرتفع أو يُشغَّل به)",
 "高圧電線": "جَبَّار, عَالِي الطَّاقَة (شديد النشاط أو القوّة) / عَالِي الجُهْد (يعمل على جهد كهربائي مرتفع أو يُشغَّل به)",
 "高地": "أرضية عليا, تفوق (موقف تفوق على الخصوم أو المنافسين)",
 "高地トレーニング": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه)",
 "高地ドイツ語": "الألمانية العليا, اللغة الألمانية (اللغة الألمانية القياسية؛ تطورت تاريخيًا من الجرمانية الغربية)",
 "高坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高城": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高域": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها) / تَرَدُّد عَالٍ (3 إلى 30 ميجاهرتز)",
 "高堂": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "高塔": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高塚": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "高声": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "高大": "شَاهِق / مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "高天": "سَمَاوَات",
 "高姿勢": "صيت ذائع, مكانة بارزة (موقف يجذب الكثير من الاهتمام والدعاية)",
 "高学歴": "تعليم عالي (التعليم الذي تقدمه كلية أو جامعة)",
 "高学歴者": "أَكَادِيمِيّ / أستاذ, جامعي (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "高安": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高安動脈炎": "التهاب الشرايين تاكاياسو, مرض انعدام النبض (اضطراب يتميز بغياب النبض في كلا الذراعين وفي الشرايين السباتية)",
 "高官協議": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / رَفِيع المُسْتَوَى (في مستوى مرتفع من الرتبة أو الأهمية)",
 "高宜": "إِحْسَان",
 "高実子": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "高尚": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
