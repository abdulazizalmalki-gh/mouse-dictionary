{
 "静物": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "静物画": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "静的": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "静穏": "سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / سكون, طمأنينة (حالة من السلام والهدوء) / سكينة, هدوء (حالة خالية من المتاعب والاضطرابات)",
 "静粛": "صَامِت, سَاكِت",
 "静粛に": "بِهُدُوء",
 "静索": "حبل التثبيت التلقائي, حبل ثابت (حبل يستخدم بدلاً من حبل الفتح لفتح المظلة؛ يُربط أحد طرفيه بالطائرة والآخر بحقيبة المظلة، ويفتح المظلة بعد قفز المظلي من الطائرة)",
 "静置": "مَنْزِلَة, مَكَانَة / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "静脈": "وَرِيد, عِرْق",
 "静脈内": "داخل الوريد, وريدي (داخل الوريد أو عن طريقه)\nمثال: التهاب وريدي",
 "静脈圧": "ضغط وريدي (الضغط الممارس على جدران الأوردة بواسطة الدم الدائر)",
 "静脈注射": "حقن وريدي (حقنة في الوريد)",
 "静脈洞": "جيب وريدي (قناة واسعة تحتوي على الدم؛ ليس لها غطاء مثل الأوعية الدموية العادية)",
 "静脈炎": "التهاب الوريد (التهاب الوريد (عادة في الساقين))",
 "静脈瘤": "دوالي (وعاء دموي أو وعاء لمفاوي متضخم أو ملتوي بشكل غير طبيعي)",
 "静脈穿刺": "بزل الوريد, فصد ((طب) ثقب الوريد عبر الجلد لسحب الدم للتحليل أو لبدء تقطير وريدي أو لحقن الدواء)",
 "静脈血": "دم وريدي (الدم الموجود في الأوردة)\nمثال: باستثناء الوريد الرئوي، يكون الدم الوريدي غنياً بثاني أكسيد الكربون وفقيراً بالأكسجين",
 "静脈血栓症": "تخثر وريدي (تخثر الوريد دون التهاب سابق للوريد؛ يرتبط ببطء تدفق الدم (كما في الراحة الطويلة في الفراش أو الحمل أو الجراحة) أو بتخثر سريع للدم)",
 "静脈麻酔薬": "مخدر وريدي (مخدر ينتج التخدير عند حقنه في الدورة الدموية)",
 "静荷重": "ثقل ساكن, وزن ميت (وزن ثقيل لا يتحرك) / عبء ثقيل (عائق قمعي أو ثقيل)",
 "静菌": "ركود جرثومي, كبح البكتيريا (تثبيط نمو البكتيريا)",
 "静謐": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "静電": "كهرباء ساكنَة / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "静電プリンタ": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "静電単位": "وحدة كهروستاتيكية (أي من وحدات الكهرباء المختلفة القائمة على قوى التفاعل بين الشحنات الكهربائية)",
 "静電印字装置": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "静電場": "مجال كهروستاتيكي, مجال كهروسكوني (مجال كهربائي مرتبط بشحنات كهربائية ساكنة)",
 "静電容量": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / سعة كهربائية, مواسعة (ظاهرة كهربائية يتم فيها تخزين شحنة كهربائية)",
 "静電気": "كهرباء ساكنَة",
 "静電気プリンタ": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "静静": "بِهُدُوء",
 "静音": "صَامِت, سَاكِت",
 "静音パソコン": "كَمْبْيُوتَر شَخْصِيّ",
 "静音化": "رُطُوبة",
 "静音性": "انعدام الصوت, هدوء (خاصية عدم إصدار أي صوت) / سكون, طمأنينة (حالة من السلام والهدوء)",
 "静養": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "非": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "非ざる": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "非ず": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "非ずんば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "非と": "إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ)",
 "非の打ちどころ": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "非の打ち所": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "非の打ち所がない": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "非の打ち所が無い": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "非の打ち所のない": "مَعْصُوم, كَامِل / مَعْصُوم",
 "非アクティブ化": "إبطال مفعول, تعطيل (فعل التعطيل أو جعل الشيء غير فعال (مثل القنبلة)) / تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح))",
 "非イオン系合成洗剤": "منظف أنيوني, منظف لا أيوني (فئة من المنظفات الاصطناعية التي لا تتأين جزيئاتها في المحاليل المائية)",
 "非シールド": "غَيْر مُدَرَّع ((خاصة عن الآلات) غير محميّ بدرع واقٍ)",
 "非ステロイド性抗炎症薬": "مضاد التهاب غير ستيرويدي (دواء مضاد للالتهاب لا يحتوي على الستيرويدات)\nمثال: مضادات الالتهاب غير الستيرويدية تثبط نشاط كل من إنزيمات كوكس-1 وكوكس-2",
 "非ナチ化": "اِجْتِثَاث النَّازِيَّة",
 "非フレーム形式": "غير مؤطر (غير مزود بإطار)\nمثال: صور غير مؤطرة",
 "非モテ": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "非ユークリッド幾何学": "هندسة لاإقليدية ((رياضيات) هندسة قائمة على بديهيات تختلف عن بديهيات إقليدس)",
 "非上場": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "非主要": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "非人情": "عديم الرحمة, قاسي القلب (يفتقر إلى الشعور أو الشفقة أو الدفء) / فَاقِدُ الشَّجَاعَة (خالٍ من الشجاعة أو الحماس)",
 "非人格化": "تجريد من الشخصية, تشييء (تمثيل إنسان كشيء مادي مجرد من الصفات الشخصية أو الفردية) / اختلال الإنية, تبدد الشخصية ((في الوجودية) فقدان الهوية الشخصية؛ شعور الفرد بأنه ترس مجهول في آلة اجتماعية غير شخصية) / اضطراب تبدد الشخصية, تبدد الشخصية (اضطراب انشقاقي عاطفي يحدث فيه فقدان للاتصال بالواقع الشخصي للفرد مصحوباً بمشاعر اللاواقعية والغرابة)\nمثال: وفقًا لماركس، فإن معاملة العمل كسلعة تجسد تشييء الفرد",
 "非人道": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "非人道性": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "非人道的": "غير إنساني, وحشي (يفتقر ويعكس الافتقار إلى الشفقة أو الرحمة)\nمثال: البشر غير إنسانيين فطرياً؛ هذا يفسر الكثير من البؤس والمعاناة في العالم",
 "非人間化": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "非人間的": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非公式": "غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "非公認": "غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)\nمثال: نوع من العمدة غير الرسمي",
 "非公開": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "非凡": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "非凡人": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "非力": "ضَعِيف, عَاجِز / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "非効率": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "非効率的": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "非協力的": "غَيْر مُتَعَاوِن (غير متعاون عَمْدًا) / غير متعاون (غير راغب في التعاون)\nمثال: شاهد غير متعاون",
 "非友好": "عدائي, غير ودود (غير ميال للصداقة أو الود) / صعب الاستخدام, غير صديق للمستخدم (ليس سهلاً في الفهم أو الاستخدام) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً) / غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)\nمثال: برود في التصرف غير ودود",
 "非可分": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "非可干渉的": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "非合法": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非合法化": "حظر, منع (حظر رسمي أو مرسوم ضد شيء ما)",
 "非合理": "لَا مَنْطِقِيَّة (استدلال غير صالح أو غير صحيح)",
 "非合理的": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة)",
 "非同期": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "非同期式": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "非同期転送モード": "وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "非同盟": "عدم الانحياز (شعب (أو دول) غير متحالفين مع آخرين في حلف أو معاهدة)",
 "非営利": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "非営利団体": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "非営利的": "غَيْرُ رِبْحِيّ, غَيْرُ هَادِفٍ لِلرِّبْحِ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非営利組織": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "非器": "عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما)",
 "非国営化": "خصخصة (تحويل شيء ما من ملكية الدولة أو سيطرتها إلى الملكية الخاصة)",
 "非国教徒": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "非国民": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "非圧縮": "غير قابل للانضغاط (غير قابل للضغط؛ يقاوم الانضغاط)\nمثال: أكوام من القمامة غير القابلة للانضغاط",
 "非婚": "أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "非嫡出子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "非宗教主義": "عَلْمَانِيَّة, لَائِكِيَّة",
 "非定型": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر. / غَيْر مُنْتَظِم, لَا نَمَطِيّ (ينحرف عن التوقعات الطبيعية؛ غريب أو شاذ بعض الشيء) / شاذ, غير نمطي (لا يمثل مجموعة أو فئة أو نوعًا)\nمثال: فئة من الطحالب غير النموذجية",
 "非定型肺炎": "التهاب رئوي لانمطي (مرض تنفسي حاد يتميز بحمى عالية وسعال)",
 "非定形動詞": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "非実際的": "غير عملي (ليس عملياً؛ غير قابل للتطبيق أو لا يهتم بالأمور العملية) / خَيَالِيّ, غَيْرُ وَاقِعِيّ (غَيْرُ عَمَلِيٍّ وَلَا قَابِلٍ لِلتَّحْقِيق؛ تَأَمُّلِيّ)\nمثال: تعويم السفينة ثبت أنه غير عملي بسبب التكلفة",
 "非対応": "غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "非対称": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "非対称的": "غَيْر مُتَمَاثِل, غَيْر مُتَمَاثِلَة (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)",
 "非居住者": "غير مقيم (لا يعيش في مكان معين أو مملوك لمقيمين دائمين) / غَيْر مُقِيم (شخص لا يعيش في مكان معين)\nمثال: طلاب غير مقيمين يتنقلون إلى الفصول",
 "非常": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "非常に": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "非常ブレーキ": "مكبح الطوارئ, مكبح يدوي (مكبح يعمل باليد؛ يعمل عادة عن طريق وصلة ميكانيكية)",
 "非常ベル": "جرس الإنذار, ناقوس الخطر (صوت إنذار (عادة جرس))",
 "非常信号": "إِنْذَار",
 "非常勤": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "非常勤講師": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "非常口": "مخرج طوارئ\nمثال: その建物には非常口がない。 — ليس لهذه البناية مخرج للطوارئ.",
 "非常時": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "非常線": "شريط زينة, وشاح (زينة تتكون من شريط أو حبل مزخرف) / شريط, وشاح (حبل أو شريط يلبس كشارة شرف أو رتبة) / طوق, كردون (سلسلة من الحراس أو المراكز العسكرية تحيط أو تحرس مكاناً أو شيئاً ما)",
 "非常識": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "非常階段": "مخرج طوارئ",
 "非常駐": "مُؤَقَّت, سَريع الزوال",
 "非干渉的": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "非循環的": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة) / لاحلقي, لاسواري (غير حلقي؛ خاصة وجود أجزاء مرتبة في لوالب بدلاً من دوارات)",
 "非性愛": "لَاجِنْسِيَّة",
 "非情": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد",
 "非戦論": "سَلَامِيَّة, سِلْمِيَّة",
 "非戦論者": "مُسَالِم / مُسَالِمَة",
 "非戦闘員": "مَدَنِيّ / مَدَنِيَّة",
 "非手指動作": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "非才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "非承認": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "非拘束名簿式比例代表制": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "非排水": "غير مُجفف, غير مُصرَّف (لم يتم تصريف محتواه)\nمثال: الحفاظ على الأراضي الرطبة: إبقاؤها غير مجففة",
 "非推奨": "استنكار, تشويه سمعة (فعل التعبير عن الرفض (خاصة تجاه الذات) أو الانتقاص) / استعاذة, دعاء دفع البلاء (صلاة لدرء أو إزالة شر أو كارثة)",
 "非政府組織": "مُنَظَّمَة غَيْر حُكُومِيَّة",
 "非政治的": "لَا سِيَاسِيّ, مُحَايِد سِيَاسِيًّا (محايد من الناحية السياسية)",
 "非数": "خبز النان (خبز مخمر يخبز في فرن طيني في الهند؛ عادة ما يكون على شكل دمعة) / جدة (والدة أبيك أو أمك) / جدة (جدتك (مصطلح غير رسمي))",
 "非日常": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "非日常性": "اسْتِثْنَائِيَّة, غَرَابَة (صفة كون الشيء استثنائياً وغير مألوف)",
 "非日常的": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "非晶質": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "非暴力": "لاعنف",
 "非暴力・不服従": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "非暴力不服従": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "非暴力抵抗": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "非有界": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "非核武装": "سِلَاح نَوَوِيّ",
 "非業の最期": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "非業の死": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "非構造制約集合": "عشوائي, غير مهيكل (يفتقر لهيكل محدد أو تنظيم) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)\nمثال: وضع غير منظم بلا مسؤول",
 "非正則行列": "مصفوفة منفردة (مصفوفة مربعة يساوي محددها صفراً)",
 "非正式": "غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)",
 "非正規": "شَاذّ, غَيْر مُنْتَظِم / دُون الطَّبِيعِيّ (أقل من المستوى الطبيعي أو المتوسط) / دون الطبيعي (شخص ذكاؤه أقل من الطبيعي)",
 "非正規労働者": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "非武装": "أَعْزَل",
 "非武装地帯": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "非毀": "تَشْهِير, بُهْتَان",
 "非民主": "غير ديمقراطي (لا يتفق مع أو لا يتوافق مع العقيدة أو الممارسة أو المثل الديمقراطية)\nمثال: قطعت النقابة علاقتها بإجراءاتها غير الديمقراطية السابقة",
 "非活動": "خَامِد",
 "非活性": "خَامِد",
 "非浸潤性乳管がん": "مدير الاستخبارات المركزية (رئيس مجتمع الاستخبارات الأمريكي ومدير وكالة المخابرات المركزية)",
 "非点収差": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "非熱処理": "غير مبستر (لم يخضع للبسترة)",
 "非特異性": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "非特異的": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "非現実": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "非現実性": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "非現実的": "غير واقعي (ليس واقعياً)\nمثال: توقعات غير واقعية",
 "非球面": "لَاكُرَوِيّ (يختلف قليلاً عن الشكل الكروي التامّ)",
 "非理": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "非生産的": "غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "非直結": "غَيْر مُتَّصِل, غَيْر مُتَوَاجِد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非礼": "قلة أدب, وقاحة (أسلوب غير مهذب يتجاهل العرف الاجتماعي المقبول)",
 "非社交的": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "非神話化": "عقلنة, نزع الأسطورة (إعادة صياغة رسالة (دينية مثلاً) بمصطلحات عقلانية)",
 "非科学的": "غير علمي (لا يتسق مع أساليب أو مبادئ العلم)\nمثال: افتقار غير علمي للموضوعية",
 "非競合的": "غير تنافسي (لا ينطوي على منافسة أو روح تنافسية)\nمثال: وظائف غير تنافسية",
 "非結晶性": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "非結晶質": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "非線型": "غير خطي (يصف أو يتضمن معادلة تكون حدودها ليست من الدرجة الأولى)",
 "非線形": "غير خطي (يصف أو يتضمن معادلة تكون حدودها ليست من الدرجة الأولى)",
 "非能率": "عدم كفاءة (نقص المهارة الناتج عن نقص الكفاءة)",
 "非良心的": "عديم الضمير, متجرد من المبادئ (بلا وازع أو مبادئ أخلاقية)\nمثال: السياسيون عديمو الضمير الذين يسعدهم بيع بلادهم من أجل السلطة",
 "非芸術的": "عَدِيم الذَّوْق الفَنِّيّ (يفتقر إلى الحس الجمالي)",
 "非行": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه",
 "非行少年": "جانح, حدث جانح (مذنب شاب)",
 "非衛生": "غير صحي, ملوث (ليس صحيًا أو نظيفًا)\nمثال: مجاري مفتوحة غير صحية",
 "非表示": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "非課税": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "非課税品": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "非調和": "مُتَنَافِر",
 "非論理的": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة)",
 "非識字": "أُمِّيَّة",
 "非議": "نَقْد, اِنْتِقَاد",
 "非負整数": "عَدَد صَحِيح (أي من الأعداد الطبيعية (الموجبة أو السالبة) أو الصفر)\nمثال: العدد الصحيح هو عدد ليس كسراً",
 "非買同盟": "قَاطَعَ / مُقَاطَعَة",
 "非軍事": "غَيْر عَسْكَرِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非連続": "مُتَقَطِّع",
 "非連続性": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "非連続的": "مُتَقَطِّع",
 "非運": "مُصِيبَة, شَقْوَة",
 "非道": "ظَالِم, جَائِر",
 "非道徳的": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "非違": "لَا قَانُونِيَّة, مُخَالَفَة القَانُون (عدم المشروعية بحكم انتهاك قانون تشريعي ما)",
 "非適用": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "非配偶者間人工授精": "تلقيح صناعي (إدخال السائل المنوي إلى قناة فالوب أو الرحم بوسيلة غير الجماع الجنسي)",
 "非金属": "لا فلزي, لا معدني (لا يحتوي على معدن ولا يشبهه ولا يتسم بخصائصه) / لا فلز (عنصر كيميائي يفتقر إلى الخصائص الفلزية النموذجية)\nمثال: عناصر لا فلزية",
 "非開示合意": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "非難": "نَقْد, اِنْتِقَاد",
 "非難がましい": "تَأْدِيبِيّ, عَتَابِيّ (يُعَبِّر عَنِ التَّوْبِيخ أَوِ اللَّوْم خَاصَّةً بِغَرَض التَّصْحِيح)",
 "非難を浴びせる": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "非零": "غَيْرُ صِفْرِيّ (لَا يَتَضَمَّنُ الصِّفْرَ)",
 "靡かす": "أَغْرَى, أَغْوَى",
 "靡かせる": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "靡く": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / أَطَاعَ",
 "面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / صَفْحَة, صفحة",
 "面々": "اَلْجَمِيع, كُلّ شَخْص",
 "面する": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)",
 "面つき": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面と向かって": "وَجْهًا لِوَجْه",
 "面の皮が厚い": "وَقِح, صَفِيق",
 "面はゆい": "مُحْرَج, بِٱلْحَرَج",
 "面もち": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面ファスナー": "فِيلْكْرُو",
 "面付": "فَرْض",
 "面付き": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面付け": "فَرْض",
 "面会": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "面会人": "زَائِر / زَائِر, سَائِح",
 "面会権": "حق الزيارة (الحق الذي تمنحه المحكمة لأحد الوالدين (أو قريب آخر) المحروم من حضانة الطفل لزيارة الطفل بانتظام)",
 "面会者": "زَائِر / زَائِر, سَائِح",
 "面体": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "面倒": "إزعاج, إقلاق (صعوبة تسبب القلق) / إِزْعَاج, عَدَم رَاحَة (صفة كون الشيء غير مفيد أو غير مريح) / إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "面倒がらず": "بِجِدّ",
 "面倒くさい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "面倒っちい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "面倒を見る": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "面倒臭い": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "面倒見がいい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "面倒見がよい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "面倒見が良い": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "面倒見のいい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "面倒見のよい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "面倒見の良い": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "面具": "شبكة الخوذة, واقي الوجه (قناع للوجه يتكون من شبكة سلكية قوية في مقدمة خوذات كرة القدم)",
 "面出": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "面前": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "面割": "بِطَاقَة هُوِيَّة",
 "面割り": "بِطَاقَة هُوِيَّة",
 "面取り": "حافة مائلة, شطب (سطحان يلتقيان بزاوية تختلف عن 90 درجة)",
 "面向不背": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "面子": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / كاناستا (شكل من أشكال الرومي يستخدم رزمتين من الأوراق وأربعة جوكر؛ الجوكر والاثنين هما أوراق حرة؛ الهدف هو تشكيل مجموعات من نفس الرتبة) / تَشْكِيلَة / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "面子がたつ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "面子が立つ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "面子を立てる": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "面容": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "面差": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "面差し": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "面布": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "面当てがましい": "اِنْتِقَامِيّ, حَقُود (يُظهر سوء نية خبيثة ورغبة في الإيذاء؛ مدفوع بالحقد)",
 "面影": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / أثر, بقية (دلالة على أن شيئاً ما كان موجوداً)\nمثال: لم يكن هناك أي أثر لدليل على الادعاء",
 "面憎い": "مُغِيظ, مُهَيِّج (يتسبّب في الغضب أو الاستياء أو يميل إلى ذلك)",
 "面懸": "عِذَار",
 "面持": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面持ち": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面掛": "عِذَار",
 "面接": "مُقَابَلَة",
 "面接交渉権": "حق الزيارة (الحق الذي تمنحه المحكمة لأحد الوالدين (أو قريب آخر) المحروم من حضانة الطفل لزيارة الطفل بانتظام)",
 "面接受験者": "المستجوَب, ضيف المقابلة (شخص تُجرى معه مقابلة)",
 "面接員": "مُجري المقابلة (شخص يجري مقابلة)",
 "面接官": "مُجري المقابلة (شخص يجري مقابلة)",
 "面接者": "مُجري المقابلة (شخص يجري مقابلة) / المستجوَب, ضيف المقابلة (شخص تُجرى معه مقابلة)",
 "面接試験": "مُقَابَلَة",
 "面接試験官": "مُجري المقابلة (شخص يجري مقابلة)",
 "面映い": "مُحْرَج, بِٱلْحَرَج",
 "面映ゆい": "مُحْرَج, بِٱلْحَرَج",
 "面晤": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "面杖": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "面梟": "بومة الحظيرة, بومة المصابيح (بومة مرقطة باللونين الأصفر الشاحب والأبيض تسكن غالباً الحظائر والهياكل الأخرى؛ مهمة في مكافحة القوارض)",
 "面構": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面構え": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面汚し": "عَار, خِزْي",
 "面白": "مُمْتِع",
 "面白い": "مُشَوِّق, ممتع / مُمْتِع / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "面白いように": "بِسُهُولَة",
 "面白おかしい": "طريف, فکاهي (مليء بـأو يتميز بالفكاهة)\nمثال: قصص فكاهية / مُمْتِع",
 "面白がる": "اِسْتَمْتَعَ, تَمَتَّعَ / حَظِيَ (نَعِمَ بِشَيْءٍ أَو نَالَ حَظًّا مِنْهُ؛ نَالَ مَكَانَةً وَمَنْزِلَةً عِنْدَ شَخْصٍ)\nمثال: من حسن حظي أن صرت صديقه.",
 "面白さ": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة) / طَرَافَة, فُكَاهَة (صفة كون الشيء مضحكا) / سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / خلط ((في العصور الوسطى) أحد السوائل الأربعة في الجسم التي كان يعتقد أن توازنها يحدد الحالة العاطفية والجسدية)\nمثال: لم تقدر فكاهتي / مَرَح, تَرْفِيه / مَرِح, مُسَلٍّ",
 "面白み": "فَائِدَة",
 "面白ネタ": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "面白半分": "على سبيل المزاح, للمرح (غير مقصود بجدية؛ يعني مزحة)\nمثال: كان كل ذلك للمرح",
 "面白可笑しい": "طريف, فکاهي (مليء بـأو يتميز بالفكاهة)\nمثال: قصص فكاهية / مُمْتِع",
 "面皮": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "面皰": "بَثْرَة, بَثْر",
 "面目": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "面目がたつ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "面目が立つ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "面目ない": "خَجْلَان, خَجُول",
 "面目次第": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "面目無い": "خَجْلَان, خَجُول",
 "面相": "مَلَامِح",
 "面積": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "面積計": "مقياس المساحة, مكامل (أداة قياس لقياس مساحة شكل مستوٍ غير منتظم)",
 "面立ち": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "面綱": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "面繋": "عِذَار",
 "面罵罵倒": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "面舵": "يَمِينِيُّ السَّفِينَة (واقع على الجانب الأيمن من السفينة أو الطائرة) / الجانب الأيمن, الميمنة (الجانب الأيمن لسفينة أو طائرة لشخص على متنها ويواجه المقدمة أو الأنف)",
 "面色": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "面角": "زاوية الوجه (الزاوية المتكونة من حافتين لزاوية متعددة السطوح)",
 "面詰": "عَزْر / توبيخ ;تقريع",
 "面談": "مُقَابَلَة",
 "面識": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "面貌": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "面輪": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "面通": "تَشْكِيلَة",
 "面通し": "تَشْكِيلَة",
 "面部": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "面長": "طَوِيل الوَجْه (ذو وجه أطول من المعتاد)",
 "面開発": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "面面": "اَلْجَمِيع, كُلّ شَخْص",
 "面頬": "شبكة الخوذة, واقي الوجه (قناع للوجه يتكون من شبكة سلكية قوية في مقدمة خوذات كرة القدم)",
 "面黒い": "مُشَوِّق, ممتع / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "靨": "نُقْرَة / غَمّازة",
 "革": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "革ひも": "زنوبَة, شِبْشِب",
 "革まる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "革む": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "革命": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "革命児": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "革命家": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "革命派": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "革命的": "ثَوْرِيّ / ثَوْرِيّ, ثَوْرِيَّة",
 "革命返し": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "革多": "إِتَا",
 "革工場": "مدبغة (مكان عمل يتم فيه دباغة الجلود)",
 "革新": "إِصْلَاح",
 "革新主義": "تقدمية (التوجه السياسي لمن يفضلون التقدم نحو ظروف أفضل في الحكومة والمجتمع)",
 "革新政党": "الحزب التقدمي, حزب بول موس (حزب سياسي سابق في الولايات المتحدة؛ أسسه ثيودور روزفلت خلال الحملة الرئاسية لعام 1912؛ كان شعاره صورة لحيوان الموظ)",
 "革新的": "اِبْتِكارِيّ, مُبْتَكَر / رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / تحرري, ليبرالي (متسامح مع التغيير؛ غير مقيد بالسلطوية أو الأرثوذكسية أو التقاليد) / حُرّ, مُتَصَرِّف (غير حرفيّ في الترجمة أو التفسير) / جَوَاد, سَخِيّ اليَد (يُعطي أو يُمنح بسخاء وبلا تردد)",
 "革新系": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / تحرري, ليبرالي (متسامح مع التغيير؛ غير مقيد بالسلطوية أو الأرثوذكسية أو التقاليد) / حُرّ, مُتَصَرِّف (غير حرفيّ في الترجمة أو التفسير) / جَوَاد, سَخِيّ اليَد (يُعطي أو يُمنح بسخاء وبلا تردد)",
 "革新者": "رائد, سبّاق (شخص يساعد في فتح مجال جديد للبحث أو التكنولوجيا أو الفن)",
 "革田": "إِتَا",
 "革紐": "زنوبَة, شِبْشِب",
 "革細工": "مصنوعات جلدية (عمل مصنوع من الجلد)",
 "革製": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "革質": "جِلْدِيّ, مُتَجَلِّد (يشبه الجلد أو مصنوع ليشبهه؛ صلب لكنه مرن)",
 "靫": "جَعْبَة",
 "靫葛": "سراسينية, نبات الإبريق (أي من الأعشاب الآكلة للحشرات المتعددة من رتبة السراسنيات)",
 "靫蔓": "سراسينية, نبات الإبريق (أي من الأعشاب الآكلة للحشرات المتعددة من رتبة السراسنيات)",
 "靭帯": "رِبَاط",
 "靭性": "شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "靭皮": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية) / ألياف اللحاء, لحاء (ألياف خشبية قوية يتم الحصول عليها خاصة من اللحاء الداخلي لنباتات مختلفة)",
 "靱": "جَعْبَة",
 "靱帯": "رِبَاط",
 "靱性": "شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "靱皮": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية) / ألياف اللحاء, لحاء (ألياف خشبية قوية يتم الحصول عليها خاصة من اللحاء الداخلي لنباتات مختلفة)",
 "靴": "حِذَاء, نَعْل (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "靴のひも": "شِرَاك, رِبَاط الْحِذَاء",
 "靴の木型": "قالب حذاء (جهاز تثبيت على شكل قدم بشرية يستخدم لتشكيل أو إصلاح الأحذية)",
 "靴の紐": "شِرَاك, رِبَاط الْحِذَاء",
 "靴ひも": "شِرَاك, رِبَاط الْحِذَاء",
 "靴べら": "قَرْن (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "靴みがき": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "靴クリーム": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "靴ベラ": "قَرْن (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "靴下": "جَوْرَب",
 "靴下止め": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "靴下留": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "靴下留め": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "靴型": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ",
 "靴墨": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "靴屋": "متجر أحذية, محل أحذية (متجر تباع فيه الأحذية)",
 "靴底": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "靴拭き": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول) / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "靴直し": "إِسْكَاف (اَلْخَرَّاز، صَانِعُ الْأَحْذِيَةِ وَمُصْلِحُهَا)",
 "靴磨": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "靴磨き": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "靴箱": "علبة أحذية (صندوق مستطيل (عادة من الكرتون) مصمم لحفظ زوج من الأحذية) / علبة أحذية (هيكل يشبه علبة الأحذية (كمبنى مستطيل أو غرفة ضيقة أو مقصورة))",
 "靴篦": "قَرْن (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)",
 "靴紐": "شِرَاك, رِبَاط الْحِذَاء",
 "靴脱ぎ石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "靴裏": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "靴足袋": "جَوْرَب",
 "靴革": "جلد الأحذية (جلد يستخدم لصنع الأحذية)",
 "靴音": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي) / خطوة, وقع الأقدام (صوت خطوة شخص يمشي) / خطوة (المسافة التي تغطيها خطوة)\nمثال: سمع وقع أقدام على الشرفة",
 "鞄": "كِيس, چيس",
 "鞄持": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع)) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "鞄持ち": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع)) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "鞄語": "لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "鞅": "عارضة الدولفين (عارضة تحت الصاري المائل لمركب شراعي) / لجام الصدر, مارتنجال (شريط سرج يربط قطعة الأنف بالحزام البطني؛ يمنع الحصان من رفع رأسه للخلف)",
 "鞅々": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "鞅鞅": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "鞍": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "鞍ずれ": "قرحة السرج (قرحة تصيب راكب الخيل بسبب احتكاك السرج) / قرحة السرج (قرحة مفتوحة على ظهر الحصان ناتجة عن سرج غير مناسب أو معدل بشكل سيء)",
 "鞍下": "سيرلوين (جزء من الخاصرة (وخاصة في البقر) يقع أمام الكفل مباشرة)",
 "鞍尻": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "鞍山": "آنْشَان, أَنْشَان",
 "鞍擦れ": "قرحة السرج (قرحة تصيب راكب الخيل بسبب احتكاك السرج) / قرحة السرج (قرحة مفتوحة على ظهر الحصان ناتجة عن سرج غير مناسب أو معدل بشكل سيء)",
 "鞍敷": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "鞍敷き": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "鞍替え": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "鞍褥": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "鞍部": "فجوة جبلية, ممر (ممر بين قمم الجبال؛ مصطلح جيومورفولوجي لأدنى نقطة على حيد جبلي بين قمتين)",
 "鞍馬": "حصان الحلق (حصان جمباز بجسم أسطواني مغطى بالجلد ومقابض قائمة (حلقات) بالقرب من المركز؛ مثبت بواسطة دعامتين فولاذيتين)",
 "鞏皮症": "تصلب الجلد (مرض مناعي ذاتي يصيب الأوعية الدموية والنسيج الضام)",
 "鞏膜": "مُقْلَة, بَيَاض اَلْعَيْن",
 "鞏膜炎": "التهاب الصلبة (التهاب صلبة العين)",
 "鞐": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "鞘": "غِمْد, غِلَاف / قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / هَامِش / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "鞘取り": "مراجحة (نوع من الاستثمار المحوط يهدف إلى الاستفادة من الفروق الطفيفة في السعر؛ عندما يكون هناك فرق في سعر شيء ما في سوقين مختلفين، يقوم المراجح بالشراء…) / بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "鞘翅類": "خُنْفُسَاء",
 "鞠": "ضَرَّة",
 "鞠問": "تَحْقِيق مَعَ, اِسْتِجْوَاب",
 "鞠川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "鞠躬如": "مُبَجِّلٌ, مُوَقِّرٌ (يُظهر التوقير والاحترام)",
 "鞣": "دِبَاغَة",
 "鞣す": "حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ)",
 "鞦": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "鞫問": "تَحْقِيق مَعَ, اِسْتِجْوَاب",
 "鞭": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "鞭ち": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري) / جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "鞭をくれる": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "鞭入れ": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "鞭打": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "鞭打ち": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري) / جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "鞭打ち症": "جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "鞭打つ": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "鞭撻": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "鞭毛": "سَوْط",
 "鞭毛虫": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى) / سوطي (له سوط أو يشبهه)",
 "鞭毛虫類": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى) / سوطي (له سوط أو يشبهه)",
 "鞴": "مِنْفَاخ",
 "鞺鞳": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / استعجال, اندفاع (فعل التحرك بعجلة وبطريقة غير مبالية) / اندفاع, هجوم ((كرة القدم الأمريكية) محاولة لتقديم الكرة عن طريق الركض في الخط)\nمثال: في عجلته للمغادرة نسي كتابه",
 "韋駄天": "خَفِيفُ القَدَم, سَرِيعُ الخُطَى (ذُو أَقْدَامٍ سَرِيعَةِ الحَرَكَةِ)",
 "韓": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / جُمْهُورِيَة كُورِيَا / أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "韓半島": "شِبْه الْجَزِيرَةِ الْكُورِيَّة",
 "韓国": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "韓国のり": "كِيم",
 "韓国人": "كوري جنوبي (من أو يتعلق بكوريا الجنوبية أو شعبها أو يميزهم) / كوري جنوبي (كوري من كوريا الجنوبية)",
 "韓国海苔": "كِيم",
 "韓国街": "كوريا تاون, كورياتاون (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "韓国語": "كُورِيّ",
 "韓国軍": "جُمْهُورِيَة كُورِيَا",
 "韓日": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "韓民族": "كُورِيّ",
 "韓米": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "韓紅": "قِرْمِز (القِرْمِزُ: صِبْغ أرمني أَحمر يقال إِنه من عُصارة دود يكون في آجامهم (في الصخور)، فارسي معرب؛ صبغ لونه احمر قانٍ يصنع من حشرة القرمز الجافة والمسحوقة) / قِرْمِزِيّ",
 "韓語": "صِينِيّ / كُورِيّ",
 "韛": "مِنْفَاخ",
 "韜晦": "انزواء, تواري (الانسحاب إلى الخلفية؛ جعل النفس غير ملحوظة)",
 "韜略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "韭": "ثوم معمر صيني (أوراق مسطحة كبيرة تستخدم كما يستخدم الثوم المعمر) / ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "韮": "ثوم معمر صيني (أوراق مسطحة كبيرة تستخدم كما يستخدم الثوم المعمر) / ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "韮井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "音": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة / شُهْرَة",
 "音いろ": "جرس الصوت, خامة الصوت ((موسيقى) الخاصية المميزة لصوت مركب (صوت بشري أو ضجيج أو صوت موسيقي))\nمثال: كان جرس صوت السوبرانو الخاص بها غنياً وجميلاً",
 "音さ": "شوكة رنانة (أداة معدنية ذات شعبتين تصدر نغمة ثابتة عند طرقها؛ تستخدم لضبط الآلات الموسيقية)",
 "音とび": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات",
 "音なし": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "音の壁": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة الصوت)",
 "音もなく": "بِهُدُوء",
 "音を上げる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "音位転換": "قَلْب مَكَانِيّ",
 "音価": "قيمة النغمة, قيمة زمنية ((موسيقى) المدة النسبية لنغمة موسيقية)",
 "音便": "موسيقى, نغم عذب (أي أصوات مقبولة (مستساغة ومتناغمة))\nمثال: غفا على وقع موسيقى أجراس الرياح",
 "音信": "مُرَاسَلَة",
 "音写": "نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "音列": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "音割れ": "قُلَامَة / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "音叉": "شوكة رنانة (أداة معدنية ذات شعبتين تصدر نغمة ثابتة عند طرقها؛ تستخدم لضبط الآلات الموسيقية)",
 "音取": "تسجيل صوتي (تسجيل للإشارات الصوتية)",
 "音取り": "تسجيل صوتي (تسجيل للإشارات الصوتية)",
 "音合せ": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "音合わせ": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "音吐": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "音喜多": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "音圧": "ضغط الصوت (الفرق بين الضغط اللحظي عند نقطة في مجال صوتي والضغط المتوسط عند تلك النقطة)",
 "音圧レベル": "قدرة صوتية, مستوى ضغط الصوت (الشدة الفيزيائية للصوت)",
 "音圧レベル計": "ضغط الصوت (الفرق بين الضغط اللحظي عند نقطة في مجال صوتي والضغط المتوسط عند تلك النقطة)",
 "音型": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "音域": "مدى, قدرة / مَدَى",
 "音声": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / تَلْفَنَ / سَمْعِيّ, أُودْيُو",
 "音声トラック": "مسار الصوت (تسجيل صوتي على شريط ضيق من فيلم سينمائي)",
 "音声ファイルフォーマット": "ملف صوتي",
 "音声メール": "بَرِيد صَوْتِيّ",
 "音声合成装置": "مركب كلام (جهاز يستخدم للإنتاج الاصطناعي للكلام البشري)\nمثال: يتم الحكم على جودة مركب الكلام من خلال تشابهه مع الصوت البشري وقدرته على أن يكون مفهوماً بوضوح",
 "音声器官": "عضو نطق (أي من الأعضاء المشاركة في إنتاج الكلام)",
 "音声学": "صَوْتِيَات",
