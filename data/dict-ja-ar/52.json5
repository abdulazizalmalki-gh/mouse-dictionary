 "領域": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "領域確保": "تجزئة, تقسيم (عملية التقسيم أو التجزئة؛ الفصل عن طريق إنشاء حدود تقسم أو تبقي الأشياء متباعدة) / تصنيف, تقسيم (تحليل إلى فئات متنافية)",
 "領家": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "領導": "قِيَادَة",
 "領巾": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها)",
 "領得": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / سَرِقَة, سَرَقَة",
 "領得罪": "استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "領掌": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "領有": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "領有権": "دومينيون (واحدة من الدول ذاتية الحكم في الكومنولث البريطاني) / إِقْلِيم إِدَارِيّ, مُقَاطَعَة (منطقة محدّدة لأغراض إداريّة أو غيرها) / حكم, سلطان (الهيمنة أو السلطة من خلال السلطة القانونية)\nمثال: احتفظت فرنسا بحكم لا جدال فيه على مناطق شاسعة من أفريقيا",
 "領水": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "領海": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "領略": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "領空": "مَجَال جَوِّيّ",
 "領置": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / ذَاكِرَة / أُسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: حفظ رقم هاتفها.",
 "領袖": "قَائِد, زَعِيم",
 "領野": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "頚動脈": "شريان سباتي (أحد الشريانين الرئيسيين في الرقبة والرأس؛ يتفرع من الأبهر)",
 "頚動脈小体": "جسم سباتي (مستقبل كيميائي يقع بالقرب من تفرعات الشرايين السباتية؛ يراقب محتوى الأكسجين في الدم ويساعد في التحكم في التنفس)",
 "頚動脈狭窄症": "شريان سباتي (أحد الشريانين الرئيسيين في الرقبة والرأس؛ يتفرع من الأبهر)",
 "頚神経叢": "ضفيرة عنقية (ضفيرة عصبية تقع تحت العضلة القصية الترقوية الخشائية)",
 "頚部": "رَقَبَة, عُنُق",
 "頚静脈": "وَدَج, حَبْل الوَرِيد",
 "頡頏": "تَنَافُس, مُنَافَسَة (فعل التنافس من أجل الربح أو الجائزة)\nمثال: كانت الفرق في تنافس شرس على المركز الأول",
 "頤": "فَكّ / ثَرْثَار",
 "頬": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "頬がゆるむ": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "頬が緩む": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "頬っぺた": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "頬ひげ": "لِحْيَة (الشعر النامي على الجزء السفلي من وجه الرجل)",
 "頬を染める": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "頬を紅潮させる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "頬側": "فموي (متعلق بالفم أو منطقة الفم أو السطح الذي يقع عليه الفم) / شدقي (من أو متعلق بـ أو باتجاه الخد)\nمثال: التجويف الفموي",
 "頬動脈": "شريان شدقي (فرع من الشريان الفكي العلوي يغذي العضلة المبوقة والخد بالدم)",
 "頬嚢": "جيب شدقي (جيب غشائي داخل فم العديد من القوارض (مثل الغوفر))",
 "頬杖": "تقوية, دعامة (عضو إنشائي يستخدم لتقوية إطار العمل) / مثقاب يدوي, مِلفاف (أداة نجار لها مقبض تدوير ومقبس لتثبيت ريشة الثقب) / تقويم أسنان (جهاز يصحح عدم انتظام الأسنان) / دعامة (دعامة تثبت أو تقوي شيئاً آخر)\nمثال: كان يرتدي دعامة على ركبته",
 "頬染める": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "頬桁": "وَجْنَة, عَظْم وَجْنِيّ",
 "頬白": "قِرْش أَبْيَض عَظِيم",
 "頬白鮫": "قِرْش أَبْيَض عَظِيم",
 "頬筋": "عضلة مبوقة (عضلة تسطح الخد وتسحب زاوية الفم)",
 "頬紅": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أمانيت محمر, فطر محمر (غاريقون مصفر صالح للأكل يتحول عادة إلى اللون الأحمر عند لمسه)",
 "頬袋": "جيب شدقي (جيب غشائي داخل فم العديد من القوارض (مثل الغوفر))",
 "頬赤": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "頬骨": "وَجْنَة, عَظْم وَجْنِيّ",
 "頬髭": "لِحْيَة (الشعر النامي على الجزء السفلي من وجه الرجل)",
 "頬髯": "لِحْيَة (الشعر النامي على الجزء السفلي من وجه الرجل)",
 "頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / قَائِد, زَعِيم",
 "頭いい": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭おかしい": "مَجْنُون, مَخْبُول",
 "頭から": "بشكل قاطع, بشكل مطلق (بطريقة غير مشروطة)\nمثال: نفى التهم بشكل قاطع / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً / جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "頭からつま先まで": "مِن الرَّأْس إِلَى القَدَم (في جميع النقاط من الرأس إلى القدمين)\nمثال: كان مسلحاً من رأسه إلى أخمص قدميه",
 "頭から爪先まで": "مِن الرَّأْس إِلَى القَدَم (في جميع النقاط من الرأس إلى القدمين)\nمثال: كان مسلحاً من رأسه إلى أخمص قدميه",
 "頭がいい": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭がおかしい": "مَجْنُون, مَخْبُول",
 "頭がかたい": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "頭がまわらない": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "頭がよい": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭がわるい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "頭が下がる": "تَحِيَّة (فعل التحية بكلمات وإيماءات ودية مثل الانحناء أو رفع القبعة) / تَحِيَّة عَسْكَرِيَّة (إيماءة عسكرية رسمية للاحترام) / تحية, سلام (فعل تكريم أو اعتراف مهذب)\nمثال: تحية موسيقية للملحن في عيد ميلاده",
 "頭が低い": "مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "頭が古い": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "頭が回らない": "أَبْلَه, مُخَبَّل (غبيّ ومشوّش الذهن)",
 "頭が固い": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "頭が変": "مَجْنُون, مَخْبُول",
 "頭が悪い": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "頭が柔らかい": "مَرِن",
 "頭が真っ白になる": "ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "頭が硬い": "بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم)",
 "頭が良い": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭が高い": "مُتَعَالٍ, الْمُتَعَالِي",
 "頭くだし": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "頭ごし": "تَجَاهَلَ, طَنَّش",
 "頭ごなし": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "頭じらみ": "قملة الرأس (تغزو رأس وجسم البشر)",
 "頭だし": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / إعلام مسبق, تنبيه (رسالة تحذيرية)\nمثال: أرسل تنبيهاً للمدعي العام / كُو",
 "頭つき": "تَصْفِيفَة, تَسْرِيحَة",
 "頭でっかち": "ثَقِيل الأَعْلَى, مُثْقَل مِنَ الأَعْلَى (غير مستقر بسبب الحمل الزائد في الجزء العلوي)",
 "頭にいれる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "頭におく": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "頭に入る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "頭に入れる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "頭のいい": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭のいたい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "頭のおかしい": "مَجْنُون, مَخْبُول",
 "頭のかたい": "مُتَعَنِّت, عَنِيد",
 "頭のよい": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭の可笑しい": "مَجْنُون, مَخْبُول",
 "頭の回転": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "頭の回転が早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "頭の回転が速い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "頭の回転が遅い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "頭の回転が鈍い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "頭の回転の早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "頭の回転の速い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "頭の固い": "مُتَعَنِّت, عَنِيد",
 "頭の弱い": "ثقيل الظل, شخص ممل (شخص يبعث على الملل) / أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "頭の悪い": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "頭の柔らかい": "مَرِن",
 "頭の痛い": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُثِير لِلْجُنُون, مُسْتَفِزّ (مزعج أو مثير للاستياء بشكل شديد)",
 "頭の良い": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭の足りない": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "頭の鈍い": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "頭の高い": "مُتَعَالٍ, الْمُتَعَالِي",
 "頭の黒いねずみ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "頭の黒いネズミ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "頭の黒い鼠": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "頭ひとつ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "頭ひも": "رِبَاط",
 "頭よい": "لَامِع, نَيِّر / مُسْتَنِير",
 "頭を下げる": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِعْتَذَرَ, اِسْتَعْذَرَ / عَجَبَ",
 "頭を働かせる": "فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "頭を回らす": "اِلْتَفَتَ, اِسْتَدَارَ",
 "頭を垂れる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "頭を縦に振る": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "頭一つ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "頭上": "فَوْق الرَّأْس (أعلى الرأس) / عَالِيًا, فِي السَّمَاء (فوق رأسك؛ في السماء) / سماش, ضربة ساحقة (رد قوي بضرب كرة التنس فوق رأسك) / علوي, فوقي (يقع أو ينشأ من الأعلى)\nمثال: اجمع الساقين معاً فوق الرأس",
 "頭下し": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "頭付き": "تَصْفِيفَة, تَسْرِيحَة",
 "頭光": "هَالَة",
 "頭出し": "مُتَيَقِّظ تَمَامًا (في حالة يقظة وانتباه كاملين) / إعلام مسبق, تنبيه (رسالة تحذيرية)\nمثال: أرسل تنبيهاً للمدعي العام / كُو",
 "頭分": "رَئِيس, رَئِيسَة",
 "頭取": "قَائِد, زَعِيم / رَئِيس, رَئِيسَة",
 "頭垢": "قِشْرَة الرَّأْس",
