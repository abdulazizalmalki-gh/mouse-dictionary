 "飢死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢死に": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢渇": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢餓": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢餓感": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "飢饉": "مَجَاعَة",
 "飣餖": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)",
 "飯": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / مَعِيشَة, مَعَاش / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "飯ごう": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "飯の種": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "飯を喰う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "飯を食う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "飯ウマ": "شَمَاتَة",
 "飯倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飯切": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "飯切り": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "飯原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飯台": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "飯塚": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飯屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "飯島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飯時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "飯桐": "إديسيا (شجرة آسيوية مستديرة الرأس نفضية تزرع على نطاق واسع في المناخات المعتدلة كزينة لأوراقها القلبية وأزهارها الصفراء الخضراء العطرة تليها عناقيد متدلية من…)",
 "飯沼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飯炊き": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "飯田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飯盒": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "飯盛り": "خادمة (عاملة منزلية)",
 "飯米": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "飯粒": "ثُؤْلُول",
 "飯野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "飲": "شُرْب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "飲ます": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "飲ませる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "飲み": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سدادة حنفية, صنبور (سدادة لفتحة البرميل في برميل خشبي) / سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "飲みくだす": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "飲みで": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "飲みにくい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك) / غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بَغِيض, كَرِيه المُعَاشَرَة (غير سار في التعامل معه)\nمثال: موقف بغيض",
 "飲み下す": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "飲み出": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "飲み助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲み口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "飲み屋": "حَانَة, بَار",
 "飲み師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "飲み干す": "بَالُوعَة",
 "飲み抜け": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲み歩き": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "飲み水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "飲み物": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "飲み薬": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "飲み込み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "飲み込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "飲み込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "飲み込む": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "飲む": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "飲めや歌え": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "飲んだくれ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲ん兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲下す": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "飲兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "飲師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "飲抜け": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲料": "شَرَاب, مَشْرُوب",
 "飲料水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "飲水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "飲物": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "飲用": "شُرْب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "飲薬": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "飲酒": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب",
 "飲酒家": "شَارِب",
 "飲酒店": "حَانَة, بَار",
 "飲酒検知器": "جهاز فحص الكحول, مقياس الكحول بالنفس (جهاز يقيس المواد الكيميائية (خاصة محتوى الكحول) في زفير الشخص)",
 "飲酒癖": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "飲食店": "مَطْعَم",
 "飴": "حَلْوَى, حَلْوَى سُكَّرِيَّة / كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "飴ちゃん": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "飴と鞭": "الْعَصَا وَٱلْجَزَرَة",
 "飴ん棒": "مصاصة",
