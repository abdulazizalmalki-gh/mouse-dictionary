 "停留精巣": "اختفاء الخصية, الخصية الهاجرة (فشل إحدى الخصيتين أو كلتيهما في التحرك إلى كيس الصفن أثناء نمو الجنين الذكر)",
 "停船": "تَوْقِيف",
 "停車": "ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة) / حشوة, شريط لحام (مثبت يتكون من شريط ضيق من المعدن الملحوم يستخدم لربط الأعضاء الفولاذية)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً",
 "停車場": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "停車駅": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "停電": "انقطاع التيار الكهربائي, انقطاع الكهرباء (فشل المعدات الناتج عند انقطاع مصدر الطاقة)\nمثال: تسببت العاصفة الثلجية في انقطاع التيار الكهربائي",
 "停音": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "停音符": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "停頓": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "停頓状態": "توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "健か者": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "健やか": "حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً)",
 "健保": "تَأْمِين صِحِّيّ",
 "健全": "صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "健全化": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "健勝": "صحة جيدة, عافية (حالة التمتع بالنشاط والخلو من الأمراض الجسدية أو العقلية)",
 "健啖": "نَهَم, شَرَه",
 "健啖家": "أَكَّال, شَرَه",
 "健実": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "健常": "سَلِيمُ الجَسَد, قَوِيُّ البُنْيَة (ذُو جَسَدٍ قَوِيٍّ وَصَحِيحٍ)",
 "健常者": "سَلِيمُ الجَسَد, قَوِيُّ البُنْيَة (ذُو جَسَدٍ قَوِيٍّ وَصَحِيحٍ)",
 "健康": "صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "健康にいい": "صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "健康によい": "صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "健康に良い": "صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "健康上": "صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "健康保険": "تَأْمِين صِحِّيّ",
 "健康医療団体": "منظمة الحفاظ على الصحة (تأمين جماعي يمنح الأعضاء حق الاستفادة من خدمات المستشفيات والعيادات والأطباء المشاركين)",
 "健康問題": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "健康的": "صِحِّيّ, وِقَائِيّ (يميل إلى تعزيز الصحة أو الحفاظ عليها)",
 "健康管理": "رِعَايَة صِحِّيَّة",
 "健康被害": "خطر صحي (خطر على صحة المعرضين له)",
 "健康補助品": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "健康補助食品": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "健康観察": "فحص طبي, كشف طبي (فحص بدني شامل؛ يتضمن مجموعة متنوعة من الاختبارات حسب العمر والجنس وصحة الشخص)",
 "健康診断": "فحص طبي, كشف طبي (فحص بدني شامل؛ يتضمن مجموعة متنوعة من الاختبارات حسب العمر والجنس وصحة الشخص)",
 "健康診査": "فحص طبي, كشف طبي (فحص بدني شامل؛ يتضمن مجموعة متنوعة من الاختبارات حسب العمر والجنس وصحة الشخص)",
 "健康食品": "طعام صحي (أي طعام طبيعي أو محضر يعتقد شعبياً أنه يعزز الصحة الجيدة)",
 "健忘": "كثرة النسيان, نسيان (الميل للنسيان) / سهو, نسيان (عدم الوعي الناجم عن الإهمال أو الفشل في التذكر)\nمثال: ازداد سهوه مع تقدمه في السن / فِقْدَان ذَاكِرَة",
 "健忘症": "فِقْدَان ذَاكِرَة",
 "健気": "جَدِير بِالْإِعْجَاب",
 "健祥": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "健者": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "健胃剤": "معدي (متعلق بـ أو ينطوي على المعدة)\nمثال: قرحة معدية",
 "健胃薬": "معدي (متعلق بـ أو ينطوي على المعدة)\nمثال: قرحة معدية",
 "健診": "فحص طبي, كشف طبي (فحص بدني شامل؛ يتضمن مجموعة متنوعة من الاختبارات حسب العمر والجنس وصحة الشخص)",
 "偲ふ": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ)\nمثال: ليلى تذكر سامي. / تَخَيَّلَ, تَصَوَّرَ",
 "偲ぶ": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ)\nمثال: ليلى تذكر سامي. / تَخَيَّلَ, تَصَوَّرَ / عَجَبَ",
 "側": "جَانِب / صَفْحَة / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / جَانِب / صَفْحَة / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية. / جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "側から": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "側てる": "سُلَالَة",
 "側の者": "تِرْب, قَرِين (أصبح في حالة تربٍ، أي وضع في التراب أو اشتمل عليه؛ في : يُقال \"تَرَبَ\" على سبيل الاستعارة للمجيء بالراحة أو الهدوء بعد تعب)",
 "側む": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "側ら": "جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "側仕え": "خادمَة",
 "側位": "مِلْعَقَة, معلقة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "側女": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "側女房": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "側妻": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "側宙": "جَوِّيّ, هَوَائِيّ",
 "側室": "سُرِّيَة",
 "側廊": "ممر (ممر بين مناطق الجلوس كما في قاعة المحاضرات أو مركبة الركاب أو بين مناطق رفوف البضائع كما في المتاجر) / رواق كنيسة, ممر جانبي (جزء من الكنيسة مفصول جانبياً عن الصحن الرئيسي بصفوف من الأعمدة أو السواري) / ممر (ممر ضيق طويل (كما في كهف أو غابة))",
 "側彎症": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "側方": "جَانِب / صَفْحَة",
 "側板": "عارضة طولية, وتر (عارضة خشبية أفقية طويلة لربط القوائم) / عارضة طولية (دعامة تتكون من عضو طولي لتقوية جسم الطائرة أو الهيكل) / ناظم الخيوط (عامل ينظم الأشياء في خيوط) / لاعب في التشكيلة (عضو في تشكيلة الفريق)\nمثال: ناظم الخرز",
 "側桁": "عارضة طولية, وتر (عارضة خشبية أفقية طويلة لربط القوائم) / عارضة طولية (دعامة تتكون من عضو طولي لتقوية جسم الطائرة أو الهيكل) / ناظم الخيوط (عامل ينظم الأشياء في خيوط) / لاعب في التشكيلة (عضو في تشكيلة الفريق)\nمثال: ناظم الخرز",
 "側湾症": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "側溝": "مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "側生動物": "إسفنج, إسفنجيات (حيوان بحري بدائي متعدد الخلايا يدعم جسمه المسامي هيكل ليفي؛ يوجد عادة في مستعمرات لاطئة)",
 "側線": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / خط جانبي (أعضاء حسية للأسماك والبرمائيات؛ يُعتقد أنها تكتشف تغيرات الضغط في الماء)",
 "側背": "خَاصِرَة, كَشْح / جِنَاح / جَانِب",
 "側腹": "خَاصِرَة, كَشْح / جِنَاح / جَانِب",
 "側路": "طريق خدمات (طريق محلي يمتد بموازاة طريق سريع ويسمح لحركة المرور المحلية بالوصول إلى الممتلكات)",
 "側転": "العجلة البشرية, شقلبة جانبية (دوران بهلواني للجسم جانبيًا مع مد الذراعين والساقين مثل مكابح العجلة) / عجلة العربة (عجلة ذات قضبان خشبية وحافة معدنية) / دولار فضي (دولار مصنوع من الفضة)",
 "側辺": "زَاوِيَة, رُكْن",
 "側近": "حَاشِيَة",
 "側近く": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "側近政治": "حكومة الظل, مجموعة المستشارين (دائرة داخلية من المستشارين غير الرسميين لرئيس الحكومة)",
 "側道": "طريق خدمات (طريق محلي يمتد بموازاة طريق سريع ويسمح لحركة المرور المحلية بالوصول إلى الممتلكات) / طريق جانبي (طريق فرعي يتفرع من طريق رئيسي)",
 "側部": "جَانِب / صَفْحَة",
 "側面": "جَانِب / صَفْحَة / تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / جانب, ناحية (خاصية أو جانب يجب أخذه بعين الاعتبار) / جانب, وجه (ميزة أو عنصر متميز في مشكلة ما) / إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: تعبير حزين",
 "側面図": "منظر جانبي (رؤية للشيء من جانبه)",
 "側面観": "منظر جانبي (رؤية للشيء من جانبه)",
 "側面音": "سَاكِن, جَانِبِيّ",
 "側頭筋": "عضلة صدغية (عضلة تمتد من الحفرة الصدغية إلى الناتئ المنقاري للفك السفلي؛ تعمل على رفع الفك السفلي وإغلاق الفكين)",
 "側頭葉": "فص صدغي",
 "側頭骨": "عظم صدغي (عظم سميك يشكل جانب القحف البشري ويغلف الأذن الداخلية)",
 "偵察": "استكشاف (الاستكشاف من أجل الحصول على معلومات)\nمثال: الاستكشاف في أراضي العدو خطير جداً",
 "偵察機": "طائرة استطلاع (طائرة عسكرية تستخدم للحصول على معلومات عن العدو)",
 "偵察衛星": "قمر تجسس (قمر صناعي مزود بأجهزة استشعار للكشف عن الانفجارات النووية أو المراقبة)",
 "偵察隊": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "偵知": "اِكْتَشَفَ",
 "偶": "عَرَضِيّ / عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "偶さか": "بالصدفة, تزامناً (الحدوث في نفس الوقت) / قَلِيلًا, قَلِيلًا مَا",
 "偶に": "أَحْيَانًا",
 "偶人": "دُمْيَة",
 "偶像": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "偶像化": "تقديس أعمى, عبادة الأصنام (فعل العبادة بشكل أعمى ومفرط) / تبجيل, عشق (فعل الإعجاب بشدة)",
 "偶像崇拝": "وَثَنِيَّة",
 "偶像崇拝者": "عابد الأصنام, وثني (شخص يعبد الأصنام)",
 "偶像教": "وَثَنِيَّة",
 "偶像教徒的": "مُتَعَبِّد, مُتَفَانٍ (مخلص أو مُعجَب بشكل أعمى أو مفرط) / عبادي للأصنام, وثني (يتعلق بعبادة الأصنام أو يمارسها)\nمثال: عبادة وثنية",
 "偶像破壊": "أيقونية, تحطيم المعتقدات التقليدية (توجه يهدف إلى مهاجمة المعتقدات أو المؤسسات الراسخة)",
 "偶像礼拝": "وَثَنِيَّة",
 "偶像視": "تقديس أعمى, عبادة الأصنام (فعل العبادة بشكل أعمى ومفرط) / تبجيل, عشق (فعل الإعجاب بشدة)",
 "偶力": "زَوْجَانِ / بَعْضُ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "偶奇性": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / تكافؤ, حفظ التكافؤ ((فيزياء) التكافؤ محفوظ في كون تكون فيه قوانين الفيزياء هي نفسها في نظام إحداثيات يمني كما في نظام يساري) / بت التدقيق, بت التكافؤ ((علم الحاسوب) بت يُستخدم في إجراء كشف الأخطاء حيث يُضاف 0 أو 1 إلى كل مجموعة من البتات ليكون مجموع الآحاد فرديًا أو زوجيًا) / تَمَاثُل, زَوْجِيَّة ((الرياضيات) علاقة بين زوج من الأعداد الصحيحة: إذا كان كلاهما فردياً أو كلاهما زوجياً فلهما نفس الزوجية)",
 "偶成": "ارتجالياً, بشكل عفوي (بدون تحضير مسبق) / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما) / ارتجال (خطاب أو ملاحظة مرتجلة) / إمبرومبتو, مرتجلة (مقطع موسيقي قصير يبدو وكأنه صُنع بعفوية دون تحضير مسبق)\nمثال: تحدث ارتجالياً",
 "偶数": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "偶数羽状複葉": "زَوْجِيّ التَّرِيُّش ((عن شكل الورقة) ريشيّ بزوج من الوريقات عند القمّة)",
 "偶有性": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "偶然": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "偶然にも": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "偶然の一致": "صُدْفَة, مُصَادَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "偶然性": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "偶発": "عَرْضِيّ",
 "偶発債務": "التزام طارئ, خصوم محتملة (التزامات قد تتكبدها المنشأة اعتماداً على نتيجة حدث مستقبلي غير مؤكد مثل قضية قضائية)\nمثال: تشمل أمثلة الالتزامات الطارئة الدعاوى القضائية المعلقة وضمان المنتج والمطالبات ضد الشركة التي لم يتم الاعتراف بها كديون",
 "偶発性": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "偶発時用手続き": "إجراء طوارئ (بديل للإجراء العادي؛ يتم تفعيله إذا نشأ موقف غير عادي ولكنه متوقع)",
 "偶発的": "عَرْضِيّ",
 "偶語": "مُحَادَثَة / مُكَالَمَة / حِوَار / مُذَاكَرَة / مُحَاوَرَة / تَكَلُّم (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "偶蹄類": "شفعيات الأصابع, مزدوجات الأصابع (ثدييات مشيمية لها حوافر بعدد زوجي من الأصابع الوظيفية في كل قدم) / شفعي الأصابع (من أو متعلق بـ أو ينتمي إلى الثدييات من رتبة مزدوجات الأصابع)",
 "偸盗": "سَرِقَة, سَرَقَة / لِصّ, لِصَّة",
 "偽": "تَقْلِيد / زائف / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر) / بطلان, زيف (حالة كون الشيء زائفاً أو غير صحيح)\nمثال: الجدل لم يستطع تحديد صدقه أو زيفه / بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "偽り": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "偽り者": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "偽り言": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "偽る": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب. / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "偽作": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "偽典": "الكتابات المنحولة, سوديبيجرافا (52 نصاً كُتبت بين 200 قبل الميلاد و200 ميلادي ولكن نُسبت إلى أنبياء وملوك مختلفين في الكتب المقدسة العبرية)",
 "偽医者": "بَطْبَطَة, زَبْط / زَبَطَ",
 "偽名": "اسم مستعار (اسم تم انتحاله)",
 "偽君子": "مُرَاءٍ, مُنَافِق",
 "偽善": "رِيَاء, نِفَاق",
 "偽善売教": "صنعة الكاهن, كهنوت (المهارات المتضمنة في عمل الكاهن) / كهنوتية (إشارة مهينة للكهنة الذين يستخدمون نفوذهم للسيطرة على الشؤون العلمانية أو السياسية)",
 "偽善的": "مُرَائِي, مُنَافِق (يَدَّعِي مَشَاعِرَ أَوْ فَضَائِلَ لَا يَمْلِكُهَا)",
 "偽善者": "مُرَاءٍ, مُنَافِق",
 "偽妊娠": "حَمْل كَاذِب (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "偽性": "زَائِف المَظْهَر, شِبْه ((غالباً يُستخدم في التركيبات) غير حقيقي لكنه يحمل مظهر الحقيقي) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "偽情報": "مَعْلُومَات مُضَلِّلَة",
 "偽書": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "偽本": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "偽果": "ثمرة تفاحية (فاكهة لحمية (تفاح أو كمثرى أو فواكه ذات صلة) تحتوي على غرف بذور وجزء خارجي لحمي)",
 "偽物": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "偽球茎": "بصلة كاذبة (تضخم صلب يشبه البصلة في ساق بعض بساتين الفاكهة)",
 "偽科学": "علم زائف (نشاط يشبه العلم ولكنه يعتمد على افتراضات مغلوطة)",
 "偽筆": "اِنْتِحال",
 "偽者": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "偽花": "رأس زهري (عنقود مضغوط قصير من الزهور مرتب بحيث يعطي الكل تأثير زهرة واحدة كما في البرسيم أو أفراد الفصيلة المركبة)",
 "偽薬": "بلاسيبو (صلاة الغروب في مكتب الموتى بالكنيسة الكاثوليكية) / بلاسيبو, دواء وهمي (دواء غير ضار أو خامل؛ يعطى كمهدئ أو للمجموعة الضابطة في التجارب حول فعالية الدواء)",
 "偽薬効果": "تأثير البلاسيبو, تأثير الدواء الوهمي (أي تأثير يبدو أنه نتيجة لإعطاء دواء وهمي؛ التغيير عادة ما يكون مفيداً ويفترض أنه ناتج عن إيمان الشخص بالعلاج أو أفكاره المسبقة عما كان من المفترض أن…)",
 "偽装": "تَمْوِيه / ذريعة",
 "偽装工作": "تَنَكُّر / تَنَكَّرَ",
 "偽装表示": "إِعْلَان كَاذِب",
 "偽製": "زَائِف المَظْهَر, شِبْه ((غالباً يُستخدم في التركيبات) غير حقيقي لكنه يحمل مظهر الحقيقي) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "偽言": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "偽証": "شَهَادَة زُور",
 "偽証者": "حانث باليمين, شاهد زور (شخص يدلي بشهادة كاذبة عمداً)",
 "偽誓": "شَهَادَة زُور",
 "偽足": "قدم كاذبة (نتوء مؤقت تستخدمه بعض الكائنات الحية الدقيقة كعضو للتغذية أو الحركة)",
 "偽造": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "偽造品": "مُزَيَّف",
 "偽造罪": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "偽鱗茎": "بصلة كاذبة (تضخم صلب يشبه البصلة في ساق بعض بساتين الفاكهة)",
 "偽黒筋銀宝": "سَيْفِيّ الأَنْيَاب (له أسنان تشبه السيوف)",
 "傀儡": "دُمْيَة / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "傀儡国家": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "傀儡女": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "傀儡子": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "傀儡師": "محرك الدمى (شخص يحرك الدمى أو الماريونيت)",
 "傀儡政府": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "傀儡政権": "حكومة دمية, حكومة صورية (حكومة يتم تعيينها وتوجيه شؤونها من قبل سلطة خارجية قد تفرض صعوبات على المحكومين)",
 "傅": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "傅く": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "傅育": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "傍": "جَانِب / صَفْحَة / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "傍から": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "傍の者達": "متفرج (شخص ينظر ويراقب)",
 "傍ら": "جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "傍らに": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "傍人": "مُتَفَرِّج",
 "傍受": "اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "傍役": "دور ثانوي, دور صغير (دور صغير)",
 "傍注": "مُلَاحَظَة هَامِشِيَّة",
 "傍流": "فَرْع, غُصْن",
 "傍焼き": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "傍白": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً",
 "傍系": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى) / عُضْو مُنْتَسِب, مُنْتَسِب (زميل مرؤوس أو فرعي؛ شخص ينتسب لآخر أو لمنظمة)\nمثال: الجهات التابعة للشبكة",
 "傍線": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))",
 "傍聴": "اِسْتِمَاع",
 "傍聴人": "متفرج",
 "傍聴料": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "傍聴者": "متفرج",
