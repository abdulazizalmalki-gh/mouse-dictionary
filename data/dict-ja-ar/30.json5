 "人道主義": "إِنْسَانِيَّة",
 "人道主義者": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (من أو يتعلق بالمذهب الإنساني أو يميزه) / إنساني (مدافع عن مبادئ الإنسانية؛ شخص مهتم بمصالح البشر ورفاهيتهم) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: مساعدات إنسانية",
 "人道回廊": "مَمَرّ إِنْسَانِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "人道橋": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "人道犯罪": "جَرِيمَة ضِدَّ الْإِنْسَانِيَّةَ",
 "人道的": "إِنْسَانِيّ",
 "人達": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "人里": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "人里はなれた": "وَحِيد, مُوحِش",
 "人里離れた": "وَحِيد, مُوحِش",
 "人間": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "人間のくず": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "人間のクズ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "人間の堕落": "السقوط, الهبوط ((الميثولوجيا اليهودية المسيحية) عندما أكل آدم وحواء من ثمر شجرة معرفة الخير والشر، فعاقبهما الله بإخراجهما من جنة عدن إلى العالم حيث يخضعان للمرض…)",
 "人間の屑": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "人間の盾": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "人間らしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "人間中心主義": "مركزية بشرية (الميل لتقييم الواقع حصرياً من حيث القيم البشرية)",
 "人間中心的": "متمركز حول الإنسان (يتمحور حول الإنسان)\nمثال: نظرتنا للعالم التي تتمركز حول الإنسان",
 "人間力": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة) / دهاء, سعة الحيلة (القدرة على التعامل بدهاء مع المشاكل غير العادية)\nمثال: رجل ذو دهاء عظيم",
