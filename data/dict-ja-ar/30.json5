 "邦国": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "邦土": "حَيِّز",
 "邦家": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "邦文": "يَابَانِيّ",
 "邦語": "يَابَانِيّ",
 "邪": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "邪宗": "هَرْطَقَة, بِدْعَة / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "邪悪": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "邪教": "هَرْطَقَة, بِدْعَة",
 "邪気": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "邪法": "هَرْطَقَة, بِدْعَة / سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "邪淫": "شَبَق",
 "邪眼": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "邪術": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "邪視": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "邪道": "هَرْطَقَة, بِدْعَة",
 "邪険": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "邪鬼": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "邪魔": "عَقَبَة, حَاجِز / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "邪魔っけ": "إِزْعَاج",
 "邪魔っ気": "إِزْعَاج",
 "邪魔を入れる": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "邪魔ッけ": "إِزْعَاج",
 "邪魔ッ気": "إِزْعَاج",
 "邪魔物": "عَقَبَة, حَاجِز / إِزْعَاج",
 "邪魔者": "عَقَبَة, حَاجِز / إِزْعَاج",
 "邸": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "邸内": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة.",
 "邸宅": "مَجْلِس",
 "郊外": "ضَاحِيَة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "郎": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "郎党": "تَابِع / مُتَابِع",
 "郎君": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "郎女": "صبية",
 "郎子": "شَابّ, فَتًى",
 "郎等": "تَابِع / مُتَابِع",
 "郡": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "郡部": "كونتِيّة / مُحَافَظَة, مُقَاطَعَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "部": "قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / نَادٍ لَيْلِيّ, اَلنَّادِي اَللَّيْلِيّ / سِبَاتِي\nمثال: لا تمسك العصا من الوسط. / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "部会": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "部位": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
