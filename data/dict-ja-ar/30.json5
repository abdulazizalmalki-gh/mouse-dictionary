 "偏微分方程式": "معادلة تفاضلية جزئية (معادلة تفاضلية تتضمن دوال لأكثر من متغير واحد)",
 "偏心": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "偏性嫌気性菌": "لاهوائي إجباري (كائن لا يمكنه النمو في وجود الأكسجين)",
 "偏愛": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز) / محاباة, محسوبية (الميل لتفضيل شخص أو مجموعة على حساب الآخرين)",
 "偏斜": "التواء, انحراف (صفة الميل وعدم الاستقامة في المسار) / انحراف, ميلان (خاصية عدم التوازي أو التعامد، بل التواجد بزاوية مائلة)",
 "偏析": "عَزْل, فَصْل (فعل الفصل أو العزل) / عزل, فصل عنصري (نظام اجتماعي يوفر مرافق منفصلة لمجموعات الأقليات) / انفصال ((علم الوراثة) انفصال الأليلات المزدوجة أثناء الانقسام المنصف بحيث تظهر أعضاء كل زوج من الأليلات في أمشاج مختلفة)\nمثال: عزل هيئة المحلفين",
 "偏極": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "偏波": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "偏流": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "偏狂": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "偏狭": "انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "偏癖": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "偏移": "نَوْبَة",
 "偏西風": "غَرْبِيًّا, مِن الغَرْب (من الغرب) / بِاتِّجَاه الغَرْب (في اتجاه الغرب) / مُتَّجِهٌ غَرْباً (يتحرّك نحو الغرب) / غَرْبِيّ (قادم من الغرب؛ يُستخدم عن الرياح)\nمثال: هبت الرياح غربياً",
 "偏見": "إِجْحَاف, تَحَامُل",
 "偏角": "مِيل / جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "偏走": "انحراف, زيغان (انحراف غير منتظم عن المسار المقصود)",
 "偏辺": "زَاوِيَة, رُكْن",
 "偏針": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحراف (حركة مؤشر أو قلم أداة قياس من موضع الصفر الخاص به) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "偏頗": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز) / محاباة, محسوبية (الميل لتفضيل شخص أو مجموعة على حساب الآخرين)",
 "偏頭痛": "شَقِيقَة, صُدَاع نِصْفِي (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق؛ مؤنث الشَقِيْق، وهو الأَخ من نفس الأُمّ والأبّ)\nمثال: هي أختي غير الشقيقة.",
 "偕老同穴": "سلة زهرة فينوس (إسفنج بحري في المياه العميقة له هيكل أسطواني من شبكة زجاجية معقدة)",
 "做す": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "停める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / وَقَّفَ, صَفَّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: ليس لدينا حديقة. / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / دَبُّوس / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "停会": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / تأجيل, رفع الجلسة (فعل التأجيل إلى وقت أو مكان آخر)",
 "停年": "حَدّ السِّنّ, شَرْط السِّنّ (لائحة تحدد الحد الأقصى (أو الأدنى) للسن للقيام بشيء ما أو شغل منصب ما) / تَقَاعُد",
 "停戦": "هُدْنَة / هُدْنَة, وَقْفُ نَار\nمثال: この停戦が世界平和に役立つことを私達はみな望んでいる。 — نأمل جميعًا أن يأتي وقف إطلاق النار هذا بسلام عالمي.",
 "停戦協定": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "停戦合意": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "停止": "إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / يُعَلِّق / تَعْلِيق",
 "停止信号": "إشارة المرور, ضوء المرور (إشارة بصرية للتحكم في تدفق حركة المرور عند التقاطعات) / ضوء التوقف, ضوء الفرامل (ضوء أحمر في الجزء الخلفي من المركبة يشير إلى استخدام الفرامل للإبطاء أو التوقف)",
 "停止期間": "فترة التعطيل",
 "停止液": "حمام إيقاف (حمام حمضي يستخدم لإيقاف عمل المظهر في التحميض الفوتوغرافي)",
 "停泊": "أَنْكُورِيج",
