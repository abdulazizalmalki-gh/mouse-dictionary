 "餌食": "فَرِيسَة / غَنِيمَة / ضَحِيَّة / أُضْحِيَّة",
 "餐": "ليتعشى, لاجل العشاء",
 "餓え": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "餓える": "تَضَوَّرَ",
 "餓え死に": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "餓死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "餓莩": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "餓鬼": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "餘": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر. / فَوْقَ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "餘り": "بَقِيَّة / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط) / نِصْف نِصْف, نُصّ نُصّ\nمثال: مصيري بين يديك.",
 "餘地": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض.",
 "餝る": "حِلْيَة / إِظْهَار, عَرْض / شَاشَة / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "餡": "مَلَأَ",
 "餡こ": "مَلَأَ / تَبْطِين",
 "餡子": "مَلَأَ / تَبْطِين",
 "館": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "館主": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "館長": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "饂飩": "وُونْتُون, وَانْتَان",
 "饐える": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "饑い": "جَائِع, جَوْعَان",
 "饑死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "饑渇": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "饒舌家": "ثَرْثَار",
 "饕餮": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "饗す": "عَالَجَ",
 "饗する": "عَالَجَ",
 "饗宴": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "首": "رَقَبَة, عُنُق / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / إِقَالَة",
 "首かせ": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "首っ玉": "رَقَبَة, عُنُق",
 "首にする": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "首をしめる": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "首をつる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "首をはねる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を切る": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を刎ねる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を吊る": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "首を斬る": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته."
}
