 "不使用": "إهمال, عدم استخدام (حالة الشيء الذي لم يستخدم وتم إهماله)\nمثال: كان المنزل في حالة إهمال رهيبة",
 "不例": "تثاقل, تردد (درجة معينة من عدم الرغبة)\nمثال: ممانعة في إلزام نفسه",
 "不侵略": "عدم الاعتداء (سياسة عدم البدء بالأعمال العدائية)\nمثال: وقعوا ميثاق عدم اعتداء",
 "不便": "إزعاج, إقلاق (صعوبة تسبب القلق)",
 "不信": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين) / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "不信仰": "جحود, عدم إيمان (رفض الاعتقاد أو الإيمان)",
 "不信実": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "不信心": "جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "不信感": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين)",
 "不信用": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين)",
 "不信義": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "不倒": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "不倒翁": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "不倫": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "不倫相手": "سَيِّدَة",
 "不倫罪": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "不倶戴天": "لا يمكن التوفيق بينه (مستحيل التوفيق بينه)\nمثال: خلافات لا يمكن التوفيق بينها",
 "不倶戴天の敵": "عدو لدود (عدو يريد قتلك)",
 "不偏": "نَزَاهَة, حِيَاد",
 "不偏不党": "نَزَاهَة, حِيَاد",
 "不健全": "مَرْضِيّ",
 "不健康": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "不備": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "不充分": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "不党": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "不全": "جُزْئِيّ",
 "不全骨折": "كسر غير كامل (كسر لا يمتد عبر كامل عرض العظم)",
 "不公平": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر…)\nمثال: نحن نرفض الظلم.",
 "不公正": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر…)\nمثال: نحن نرفض الظلم.",
 "不具": "تَشَوُّه شَكْلِيّ",
 "不具合": "عَيْبٌ / غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "不具者": "ذو احتياجات خاصة, معاق (شخص لديه حالة تحد بشكل ملحوظ من قدرته على العمل جسدياً أو عقلياً أو اجتماعياً)",
 "不凍": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "不凍剤": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "不凍海": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "不凍液": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "不凍港": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "不凡": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "不出": "حراسة, حفظ (مسؤولية الوصي أو الحارس)\nمثال: ترك سيارته في حفظي",
 "不出来": "خطأ فادح, زلة (خطأ محرج)",
 "不分割": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "不分明": "مُظْلِم",
 "不利": "سَيِّئَة",
 "不利益": "سَيِّئَة",
 "不労": "غير مستحق, غير مكتسب (لم يتم الحصول عليه عن طريق الجدارة أو العمل أو الخدمة)\nمثال: قبل المكافآت غير المكتسبة التي جاءت في طريقه وكذلك النقد غير المستحق",
 "不労所得": "إيراد غير مكتسب ((محاسبة) دخل تم استلامه ولكن لم يتم اكتسابه بعد (يعتبر عادة التزاماً حالياً في…)",
 "不勉強": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "不動": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل)",
 "不動の動者": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "不動心": "برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: أدى برباطة جأش المخضرمين",
 "不動産": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産会社": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産保険": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産取得税": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産屋": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "不動産担保証券": "ورقة مالية مدعومة بالرهن العقاري (ورقة مالية تنشأ عند تجميع مجموعة من القروض العقارية وبيع السندات لمؤسسات أخرى…)",
 "不動産業": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産業界": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産業者": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "不動産登記": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産登記法": "أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "不動産鑑定": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産開発": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産開発業者": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不勝手": "إزعاج, إقلاق (صعوبة تسبب القلق)",
 "不勢": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "不十分": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "不協和": "تنافر, نشاز (أصوات غير متوافقة أو مزعجة)\nمثال: الموسيقى الحديثة مجرد ضجيج بالنسبة لي",
 "不協和音": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "不即不離": "مُحَايِد\nمثال: هذه هي نقطة ضعفه.",
 "不参": "غِيَاب",
 "不参加": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "不可": "مُخْطِئ\nمثال: نحن نرفض الظلم.",
 "不可侵": "عدم الاعتداء (سياسة عدم البدء بالأعمال العدائية)\nمثال: وقعوا ميثاق عدم اعتداء",
 "不可入性": "اسْتِعْصَاء, عَمَايَة (عدم القدرة على الفهم بسبب الكثافة الشديدة للمعلومات أو التعقيد)",
 "不可分": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)\nمثال: 健康は運動と節制と不可分の関係にある。 — الصحة الجيدة لا يمكن فصل العلاقة بينها وبين الرياضة والاعتدال في كل شيء.",
 "不可得": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "不可思議": "سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل)",
 "不可抗力": "قضاء وقدر, قوة قاهرة (كارثة طبيعية لا مفر منها تقطع المسار المتوقع للأحداث)\nمثال: اكتشف أن منزله لم يكن مؤمناً ضد القضاء والقدر / قوة قاهرة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "不可欠": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "不可欠アミノ酸": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "不可知": "غير قابل للمعرفة, مستعصٍ على المعرفة (لا يمكن معرفته)\nمثال: أسرار الحياة التي لا يمكن معرفتها",
 "不可知的": "لَاأَدْرِيّ",
 "不可知論": "لَاأَدْرِيَّة",
 "不可知論者": "لَاأَدْرِيّ",
 "不可算名詞": "اسم الجنس, اسم غير معدود (اسم لا يُجمع عادة)",
 "不可能": "مُسْتَحِيل",
 "不可能事": "مُسْتَحِيل",
 "不可能性": "مُسْتَحِيل",
 "不可視": "خفاء, عدم المرئية (صفة عدم إمكانية الإدراك بالعين)",
 "不可解": "غامض, غير مفهوم (صعب الفهم)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "不可触民": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "不可触賎民": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "不可触賤民": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "不可誤": "عِصْمَة",
 "不可逆": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "不可逆的": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "不可避": "حَتْمِيّ",
 "不合格": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不合格品": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "不合理": "غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه)\nمثال: مخاوف غير عقلانية",
 "不合理推論": "مغالطة لا يتبع ((منطق) استنتاج لا يتبع من المقدمات)",
 "不合理結論": "مغالطة لا يتبع ((منطق) استنتاج لا يتبع من المقدمات)",
 "不吉": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع)",
 "不同": "فَرْق, اِخْتِلَاف",
 "不同意": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "不名誉": "خزي, عار (الافتقار إلى الشرف أو النزاهة)\nمثال: استسلم لحياة العار",
 "不名誉除隊": "تسريح غير مشرف, طرد من الخدمة (تسريح من القوات المسلحة بسبب جريمة خطيرة (مثل التخريب أو التجسس أو الجبن أو…)",
 "不向き": "غير لائق بدنياً, معتل (ليس في حالة جسدية أو عقلية جيدة؛ فاقد للياقة)\nمثال: سمين وغير لائق بدنياً جداً",
 "不告知": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً)\nمثال: وفر ستار من الأشجار الخصوصية",
 "不味": "كراهية, نفور (شعور بالكراهية الشديدة)",
 "不味い": "سَيِّئ, وحش / فَقِير / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ)",
 "不味る": "خطأ فادح, زلة (خطأ محرج)",
 "不和": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "不和反目": "إِقْطَاعَة",
 "不品行": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不問": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "不問に付す": "تَجَاهَلَ, طَنَّش",
 "不問に付する": "تَجَاهَلَ, طَنَّش",
 "不善": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "不器": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً))",
 "不器用": "أَخْرَق / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "不器用者": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة)",
 "不器量": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "不在": "غِيَاب / إِهْمال",
 "不在着信": "مُكَالِمَةٌ فَائِتَةٌ",
 "不在者": "غائب (شخص غائب أو غير مقيم)",
 "不在者投票": "ورقة اقتراع غيابي ((في الانتخابات) ورقة اقتراع يتم الإدلاء بها أثناء الغياب (عادة ما ترسل بالبريد…)",
 "不在証明": "دَفْع بِالْغَائِبَة, حُجَّة غِيَاب (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "不均一": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "不均斉": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不均等": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن)",
 "不均衡": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "不均質": "خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "不均質性": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "不埒": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة)",
 "不埒千万": "مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد)",
 "不埒者": "فَاسِق",
 "不堪": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "不壊": "عدم قابلية التدمير (القوة لمقاومة الدمار)",
 "不変": "أَبَدِيّ\nمثال: これ不変の真理なり。 — هذه حقيقة لا تتغير. / ثَابِت, لَا يَتَغَيَّر (لَا يَتَبَدَّلُ فِي طَبِيعَتِه)",
 "不変化": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "不変化詞": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "不変性": "ثَبَات, لَا تَبَايُن (طبيعة كمية أو خاصية أو دالة تظل دون تغيير عند تطبيق تحويل معين عليها)",
 "不変費用": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن…)",
 "不変量": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "不够本": "مُسْتَحِيل / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "不妊": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل…)",
 "不妊性": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل…)",
 "不妊手術": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى…)",
 "不妊症": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل…)",
 "不始末": "إِغْفَال / شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق)",
 "不存在": "غِيَاب",
 "不学": "جَاهِل, غَيْرُ مُتَعَلِّم (غير متعلّم بشكل عامّ؛ يفتقر إلى المعرفة أو الحصافة)\nمثال: رد فعل منعكس غير شرطي",
 "不安": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "不安げ": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "不安定": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد)\nمثال: اختلال هرموني",
 "不安定化": "زعزعة الاستقرار (فعل زعزعة الاستقرار؛ جعل الشيء أقل استقرارًا (خاصة الحكومة أو البلد أو الاقتصاد))",
 "不安心": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون)",
 "不安感": "كَرَب, كَآبَة (كَرَبَهُ الغَمُّ وَالهَمُّ: اشتدَّا عليه، أثقلا عليه؛ كَرَبَتْهُ المشاكِلُ:…)\nمثال: كانت أسرة سامي تنتظر في كرب.",
 "不安気": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "不安症": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد…)",
 "不安神経症": "عصاب القلق (يتميز بقلق منتشر وغالباً مظاهر جسدية للخوف)",
 "不安障害": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد…)",
 "不完全": "ناقص-غير كامل",
 "不完全変態": "تحول جزئي, تحول ناقص (تحول غير كامل أو جزئي في الحشرات)",
 "不完全骨折": "كسر غير كامل (كسر لا يمتد عبر كامل عرض العظم)",
 "不定": "غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد)\nمثال: نمط حياة غير مستقر / غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ)\nمثال: من عمر غير محدد / تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة)\nمثال: عدم يقين النتيجة",
 "不定代名詞": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد')",
 "不定元": "غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ)\nمثال: من عمر غير محدد",
 "不定冠詞": "أَدَاةُ تَنْكِير, أَدَاةُ نَكِرَة",
 "不定型詩": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "不定形": "غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم)",
 "不定期": "شَاذّ, غَيْر مُنْتَظِم",
 "不定称": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد') / عَامّ",
 "不定積分": "تَكَامُل غَيْر مُحَدَّد",
 "不定詞": "مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "不実": "خِيَانَة, غَدْر (خيانة الأمانة)",
 "不宣": "المخلص, تفضلوا بقبول فائق الاحترام (صيغة مكتوبة لإنهاء الرسالة)",
 "不害": "لاعنف",
 "不寛容": "ضيق الصدر, عدم الاحتمال (نفاد الصبر مع المضايقات)\nمثال: عدم احتماله للمقاطعات",
 "不寝番": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "不審": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ:…)\nمثال: إنها بلا شك محقة.",
 "不導体": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "不尽": "المخلص, تفضلوا بقبول فائق الاحترام (صيغة مكتوبة لإنهاء الرسالة)",
 "不尽根数": "مهموس (يُنتج دون اهتزاز الحبال الصوتية)\nمثال: الحروف الساكنة المهموسة مثل 'ب' و 'ك' و 'س'",
 "不屈": "إِلْحَاح",
 "不屈不撓": "عدم كلل (تصميم لا يكل)",
 "不届き": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "不届き千万": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "不届き者": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "不届き至極": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "不届千万": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "不履行": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور)\nمثال: خسر المباراة بالتغيب",
 "不帰": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "不干渉": "اِمْتِنَاع, إِمْسَاك",
 "不平": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "不平等": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不平衡": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "不幸": "تعاسة, حزن (العواطف التي يتم اختبارها عندما لا يكون الشخص في حالة رفاهية) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "不幸せ": "تعاسة, حزن (العواطف التي يتم اختبارها عندما لا يكون الشخص في حالة رفاهية)",
 "不幸にして": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "不幸にも": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "不幸の手紙": "رسالة متسلسلة (رسالة ترسل بالتتابع إلى عدة أشخاص)",
 "不幸中の幸い": "بصيص أمل, جانب مضيء (جانب مواسٍ لموقف صعب)\nمثال: كل سحابة لها جانب مضيء",
 "不彀本": "مُسْتَحِيل / رنين معدني, طقطقة (صوت معدني خفيف قصير)",
 "不当": "ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة",
 "不当たり": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不当り": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不当廉売": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "不当表示": "تحريف, تزييف (تحريف متعمد للحقائق)",
 "不従順": "عِصْيَان",
 "不得手": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "不得策": "عدم جدوى, عدم ملاءمة (صفة عدم الملاءمة للهدف المنشود)",
 "不得要領": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم)",
 "不徳": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "不徳の致すところ": "اعْتِرَاف بِالْخَطَأ, مِيَا كُولْبَا (إقرار بخطئك أو ذنبك)",
 "不徳の致す所": "اعْتِرَاف بِالْخَطَأ, مِيَا كُولْبَا (إقرار بخطئك أو ذنبك)",
 "不徳漢": "عصا الراعي, محجن (عصا طويلة ذات طرف على شكل خطاف)\nمثال: منعطف في الطريق",
 "不徳義": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "不徹底": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "不心得": "زلة, هفوة (إساءة بسيطة)",
 "不必要": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不忍": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "不応": "جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد)",
 "不応期": "فترة جموح ((علم الأعصاب) الوقت الذي يلي إطلاق الخلية العصبية أو انقباض الألياف العضلية…)",
 "不忠": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "不忠実": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "不快": "استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما) / تثاقل, تردد (درجة معينة من عدم الرغبة)\nمثال: ممانعة في إلزام نفسه",
 "不快感": "انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق)",
 "不快感を与える": "مرطبان\nمثال: من ترك الجرة مفتوحة؟",
 "不思議": "عَجِيب / بشكل غريب, بشكل لا يمكن تفسيره (بطريقة تختلف عن المعتاد أو المتوقع)\nمثال: كان لديه صوت أجش بشكل مثير للفضول",
 "不思議がる": "عَجَب\nمثال: قطة؟ تساءل الرجل العجوز.",
 "不思議なくらい": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "不思議なほど": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز)\nمثال: صوتها منضبط بشكل رائع",
 "不思議な縁": "ضربة حظ, فرصة سعيدة (قطعة غير متوقعة من الحظ السعيد)\nمثال: حصل أخيراً على فرصته الكبيرة",
 "不急": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "不恰好": "غير متناسق, مشوه القوام (ليس متناسقًا أو ممتعًا في الشكل)\nمثال: امرأة بدينة غير متناسقة القوام / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ)",
 "不愉快": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "不意": "مُبَاغِت, مُفَاجِئ",
 "不意に": "فَجْأَةً",
 "不意打ち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "不意気": "بَذِيء",
 "不感症": "انْعِدَام الإِحْسَاس, تَبَلُّد (العجز عن الاستجابة للتغيرات الوجدانية في البيئة الشخصية)",
 "不慣れ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "不慮": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "不憫": "فَقِير",
 "不成功": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不成立": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不成績": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不戦勝": "انحناء خلفي مع الوقوف على اليدين, شقلبة ماشية (دمج بين الانحناء الخلفي والوقوف على اليدين)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "不戦敗": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور)\nمثال: خسر المباراة بالتغيب",
 "不所存": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "不手際": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً))",
 "不才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "不払い": "تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال)\nمثال: تهربه من جميع دائنيه",
 "不承": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة)\nمثال: عبر عن معارضته في رأي مخالف",
 "不承不承": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "不承知": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة)\nمثال: عبر عن معارضته في رأي مخالف",
 "不承認": "إدانة, استهجان (فعل الاستهجان أو الإدانة)",
 "不承諾": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة)\nمثال: عبر عن معارضته في رأي مخالف",
 "不抜": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "不拡大": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء)",
 "不挨拶": "خشونة, قلة ذوق (قلة أدب متعمدة)",
 "不振": "ثلامة, كليل (انعدام الحدة أو وضوح الحافة أو الطرف)\nمثال: ثلامة القلم الرصاص جعلت كتابته غير مقروءة",
 "不採用": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "不採算": "خسارة, عدم ربحية (صفة عدم تحقيق مكسب أو فائدة أو ربح)",
 "不揃い": "غَيْرُ مُنْتَظِمٍ, مُتَفَاوِت (يَفْتَقِرُ إِلَى الِاتِّسَاقِ وَالِانْتِظَامِ)\nمثال: لون غير منتظم",
 "不換紙幣": "نقد ورقي إلزامي, نقود إلزامية (نقود تعلن الحكومة أنها عملة قانونية رغم عدم إمكانية تحويلها إلى عملة معدنية…)",
 "不揮発性化": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في…)",
 "不揮発性記憶装置": "تخزين غير متطاير (تخزين حاسوبي لا يُفقد عند إيقاف تشغيل الطاقة)",
 "不摂生": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم",
 "不撓": "جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)",
 "不撓不屈": "إصرار, دأب (تصميم مستمر)",
 "不支持": "إدانة, استهجان (فعل الاستهجان أو الإدانة)",
 "不敏": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء)",
 "不敗": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "不敬": "عدم احترام (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不敬罪": "خيانة الوطن, خيانة عظمى (جريمة تقوض حكومة الجاني)",
 "不敬虔": "جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "不整": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق)",
 "不整合": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء)",
 "不整合人": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "不整脈": "اِضْطِرَاب نَظْم القَلْب",
 "不敵": "جَرِيء, جَسُور",
 "不文": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة)\nمثال: قانون عرفي / أُمِّيّ",
 "不文律": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "不文明": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "不文法": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "不斉": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق)",
 "不料簡": "زلة, هفوة (إساءة بسيطة)",
 "不断": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / تذبذب, عجز عن الحسم (سمة التردد؛ نقص في صلابة الشخصية أو الغرض)\nمثال: تسبب تردد الملك غير القابل للشفاء في اضطراب في بلاطه / عَادِيّ",
 "不断草": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة)",
 "不明": "غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة / مَجْهُول, مُبْهَم / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "不明朗": "اكتئاب, تجهم (صفة الحزن المفرط والكآبة)\nمثال: سادت الكآبة المكتب / قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ)\nمثال: دوافع مشكوك فيها",
 "不明瞭": "غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "不明確": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "不易": "اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "不時": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "不時着": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "不時着陸": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "不景気": "أوقات عصيبة (وقت تسوده الصعوبات) / فَقِير / كَئِيب, مُوحِش",
 "不智": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "不服": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不服従": "تَمَرُّد, عَدَم خُضُوع (فعل يتسم بالتمرد وعدم الخضوع)",
 "不服従運動": "عِصْيان مَدَنيّ",
 "不期": "مُفَاجِئ",
 "不本意": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "不本意ながら": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "不朽": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "不朽不滅": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "不束": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "不束者": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "不条理": "عَبَثِيّ, سَخِيف / سَخَافَة",
 "不条理主義": "عَبَثِيَّة",
 "不格好": "غير متناسق, مشوه القوام (ليس متناسقًا أو ممتعًا في الشكل)\nمثال: امرأة بدينة غير متناسقة القوام / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ)",
 "不案内": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "不様": "كَرِيه المَنْظَر (غير سار للنظر)",
 "不機嫌": "بوّز, بَرطَمَ",
 "不次": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق)",
 "不正": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر…)\nمثال: نحن نرفض الظلم.",
 "不正アクセス": "اِخْتَرَقَ",
 "不正アプリ": "حِصَان طَرْوَادَة (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "不正コピー": "قَرْصَنَة",
 "不正事件": "فَضِيحَة",
 "不正使用": "إساءة استعمال, سوء استخدام (استخدام غير لائق أو مفرط)\nمثال: إساءة استعمال الكحول",
 "不正出血": "نزيف رحمي (نزيف من الرحم لا يعود إلى الحيض)",
 "不正咬合": "سوء إطباق الأسنان ((طب الأسنان) حالة لا تتشابك فيها الأسنان المتقابلة بشكل طبيعي)",
 "不正常": "شُذُوذ",
 "不正指令電磁的記録": "فيروس, فيروس حاسوبي (برنامج قادر على نسخ نفسه وعادة ما يكون قادراً على إلحاق ضرر كبير بالملفات أو…)\nمثال: لا يمكن للفيروس الحقيقي الانتشار إلى حاسوب آخر دون مساعدة بشرية",
 "不正流用": "اختلاس, سوء استخدام (استعارة غير مشروعة)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "不正直": "خداع, عدم أمانة (افتقار للصدق؛ أفعال الكذب أو الغش أو السرقة)",
 "不正確": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "不正者": "مرتكب مخالفة (شخص مذنب بارتكاب مخالفة)",
 "不正行為": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不正規": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق)",
 "不正規軍": "فِدائِيّ, فِدائِيَّة\nمثال: بوتين مجرم حرب.",
 "不死": "خُلُود",
 "不死性": "خُلُود",
 "不死身": "حصانة, منعة (خاصية كون الشخص محصناً؛ خاصية عدم القدرة على التعرض للأذى (جسدياً أو عاطفياً))",
 "不死鳥": "فِينِيكْس, فُقْنُس",
 "不殺生": "أهيمسا, اللاعنف (عقيدة بوذية وهندوسية وخاصة جاينية ترى أن جميع أشكال الحياة مقدسة وتحث على تجنب…)",
 "不毛": "خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما)\nمثال: الأراضي القاحلة في وسط أفريقيا / غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "不毛の地": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "不気味": "عَجِيب, غَرِيب",
 "不気味の谷": "وَادٍ غَرِيب (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "不決定": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "不決断": "تردد, خور (سمة كون المرء متردداً؛ يفتقر إلى ثبات الغرض)\nمثال: كان تردده لحظياً فقط ولكن الفرصة ضاعت",
 "不沈": "غير قابل للغرق (لا يمكن إغراقه)\nمثال: ظنوا أن التيتانيك غير قابلة للغرق",
 "不治": "اسْتِعْصَاء (عدم القدرة على التغيير في الطباع أو العادات)\nمثال: استعصاء تفاؤله على التغيير",
 "不況": "مُنْخَفَض",
 "不泊": "متغيب, متهرب (شخص يتهرب من الواجب)",
 "不法": "غير قانوني, محظور (مخالف لـأو محظور بموجب القانون)\nمثال: إجراءات غير قانونية / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "不法侵入": "انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن)",
 "不法侵入者": "دخيل, متطفل (شخص يقتحم خصوصية أو ممتلكات آخر دون إذن)",
 "不法入居者": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني)",
 "不法占拠": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من…)",
 "不法占拠者": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني)",
 "不法所持": "حيازة غير قانونية (حيازة مواد خاضعة للرقابة)",
 "不法監禁": "احتجاز غير قانوني, حبس زائف ((قانون) الحبس بدون سلطة قانونية)",
 "不法行為": "الضرر في القانون",
 "不注意": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "不活動": "جمود, خمول (حالة عدم النشاط)",
 "不活化": "خمول, ركود (حالة عدم النشاط أو قلة النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "不活性": "خَامِل / خَامِد",
 "不活性ガス": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري)",
 "不活性化": "تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح))\nمثال: نظام تعطيل الجينات",
 "不活性気体": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري) / غَازٌ خَامِل",
 "不活溌": "كَلِيل",
 "不活発": "كَلِيل",
 "不浄": "قَذِر, مُتَّسِخ (متسخ أو من المحتمل أن يتسخ بالأوساخ أو القذارة)\nمثال: أرصفة قذرة غير مكنوسة / حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…) / بِرَاز, سَلْح",
 "不浄場": "مِرْحَاض, تواليت",
 "不消化": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "不淫": "عُنُوسَة",
 "不渡り": "خزي, عار (الافتقار إلى الشرف أو النزاهة)\nمثال: استسلم لحياة العار",
 "不測": "مُفَاجِئ",
 "不測の事態": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة)",
 "不満": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不満分子": "سَاخِط, مُتَمَرِّد (غَيْرُ رَاضٍ تُجَاهَ السُّلْطَةِ)",
 "不満点": "شِكَايَة, شَكْوَى",
 "不満足": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不溶": "مُسْتَعْصٍ (بلا أمل في إيجاد حلّ)\nمثال: شك غير قابل للحل",
 "不溶性": "عدم القابلية للذوبان (خاصية عدم القابلية للذوبان وصعوبة الانحلال في السائل)",
 "不滅": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "不潔": "قَذِر, مُتَّسِخ (متسخ أو من المحتمل أن يتسخ بالأوساخ أو القذارة)\nمثال: أرصفة قذرة غير مكنوسة / بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "不潔恐怖症": "رهاب القذارة, وسواس النظافة (خوف مرضي من الأوساخ أو التلوث)",
 "不為": "ضَارّ, غَيْر مُفِيد (ينطوي على أو يخلق ظروفاً تضر بالنجاح أو الفعالية)\nمثال: نتيجة غير مواتية",
 "不熟練": "عدم مهارة, نقص الحذق (نقص المهارة المعرفية)",
 "不熱心": "لَامُبَالَاة",
 "不燃物": "غَيْر قَابِل لِلاِحْتِرَاق (غير قادر على الاشتعال والاحتراق)",
 "不特定": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "不理": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "不生産的": "غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "不用": "مُتَقَادِم, مُهْمَل (لم يعد قيد الاستعمال) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "不用心": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر)\nمثال: مجرم خطير",
 "不用意": "غير مجهز, غير مستعد (دون إعداد؛ غير مستعد لـ)\nمثال: ملاحظات مرتجلة / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不甲斐ない": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "不甲斐無い": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "不発": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ))",
 "不発に終わる": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ))",
 "不登校": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "不登校児": "مُتَغَيِّب",
 "不相応": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "不真面目": "تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "不眠": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "不眠不休": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "不眠症": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "不知": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام. / بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد)\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / أَنَا أَعْرِفُ",
 "不知火": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "不破": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "不確か": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "不確定": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي))\nمثال: مستقبل غير مؤكد",
 "不確定判定": "غير حاسم, غير قاطع (غير نهائي؛ لا يضع حداً للشك أو السؤال)\nمثال: رد غير حاسم",
 "不確定性": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة)\nمثال: عدم يقين النتيجة",
 "不確定性原理": "مبدأ الريبة, مبدأ عدم اليقين ((نظرية الكم) النظرية القائلة بأنه من المستحيل قياس كل من الطاقة والوقت (أو…)",
 "不確定要素": "مُتَغَيِّر",
 "不確実": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي))\nمثال: مستقبل غير مؤكد",
 "不確実性": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة)\nمثال: عدم يقين النتيجة",
 "不磨": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "不祥": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه)",
 "不祥事": "فَضِيحَة",
 "不祥事件": "فَضِيحَة",
 "不稔性": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل…)",
 "不穏": "مُثِير لِلْقَلَق, مُقْلِق (يسبب عدم الراحة الذهنية)",
 "不穏分子": "مُنْشَقّ",
 "不穏当": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "不突合": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
 "不等": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不等式": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不等辺三角形": "أخمعي (مكون من أو متعلق بأي من العضلات الأخمعية)",
 "不等辺四辺形": "مُنْحَرِف, شِكْل مُنْحَرِف",
 "不節制": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم",
 "不粋": "بَذِيء / غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "不精": "بُطْء",
 "不精巧": "أَخْرَق",
 "不精者": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "不精髭": "شُعَيْرَات اللِّحْيَة",
 "不納": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور)\nمثال: خسر المباراة بالتغيب",
 "不純": "غَيْر طَاهِر, نَجِس (لديه شائبة جسدية أو أخلاقية تجعله غير نقي وفقاً للقوانين الغذائية أو الاحتفالية)\nمثال: أفكار غير طاهرة",
 "不純物": "شوائب, عدم نقاء (حالة كونه غير نقي)\nمثال: كانت هناك شوائب في الماء",
 "不細工": "أَخْرَق / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "不経済": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "不結果": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不統一": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء)",
 "不縁": "طَلَاق, تَطْلِيق\nمثال: طلق زيري زوجته.",
 "不羇": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "不羈": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "不義": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد / خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "不義密通": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "不義理": "خزي, عار (الافتقار إلى الشرف أو النزاهة)\nمثال: استسلم لحياة العار",
 "不老不死": "خُلُود",
 "不老不死の霊薬": "إكسير الحياة (مادة افتراضية يعتقد أنها تحافظ على الحياة إلى أجل غير مسمى؛ كان يسعى إليها…)",
 "不老泉": "نبع الشباب (نبع يوصف في الحكايات الشعبية بأنه قادر على إعادة الشباب للناس)\nمثال: اكتشف بونس دي ليون فلوريدا أثناء بحثه عن نبع الشباب",
 "不耐": "ضيق الصدر, عدم الاحتمال (نفاد الصبر مع المضايقات)\nمثال: عدم احتماله للمقاطعات",
 "不肖": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)\nمثال: طرد طالب يعتبر سلوكه غير جدير / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء)\nمثال: تحول مؤسف للأحداث",
 "不肖わたくし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "不肖私": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "不胎化": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى…)",
 "不能": "مُسْتَحِيل / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عَنَانَة, عُنَّة",
 "不能症": "عَنَانَة, عُنَّة",
 "不能者": "عاجز, عديم القوة (يفتقر للقوة أو القدرة)\nمثال: التكنولوجيا بلا أخلاق همجية؛ والأخلاق بلا تكنولوجيا عاجزة",
 "不臣": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "不自然": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع)\nمثال: موت غير طبيعي",
 "不自由": "انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق)\nمثال: 大変ご不自由をおかけして申し訳ございません。 — أعتذر عن ما سببته لك من متاعب. / فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة. / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء)",
 "不興": "استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما)",
 "不良": "سَيِّئ, وحش / مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد)",
 "不良債権": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "不良化": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً))\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "不良導体": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "不良少女": "جانح, حدث جانح (مذنب شاب)",
 "不良少年": "جانح, حدث جانح (مذنب شاب)",
 "不良行為": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر)\nمثال: ورث جنوحه عن أبيه",
 "不良行為少年": "جانح, حدث جانح (مذنب شاب)",
 "不良貸し付け": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "不落": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "不虞": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "不行き届き": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "不行儀": "سوء أدب (قلة أدب ناتجة عن الجهل)",
 "不行届き": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف)",
 "不行状": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不行跡": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不裁可": "نَقْضْ (هَدَمَ أو أَبْطَلَ؛ خَالَفَ أو تَرَاجَعَ في الوعد أو العهد)\nمثال: لقد نقض الاتفاق.",
 "不要": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不要不急": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不要情報": "زُبَالَة\nمثال: توم عامل نفايات.",
 "不要物": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "不要論": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "不見識": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "不規則": "شَاذّ, غَيْر مُنْتَظِم",
 "不規則動詞": "فِعْل غَيْر مُنْتَظِم, فِعْل شَاذّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "不規則銀河": "مَجَرَة غَيْر مُنْتَظِمَة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي:…)\nمثال: أنا بطل المجرة.",
 "不規律": "شَاذّ, غَيْر مُنْتَظِم",
 "不覚": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا. / فِقْدَان اَلْوَعْي, إِغْمَاء",
 "不親切": "فَظَاظَة, قَسْوَة (الافتقار إلى التعاطف)",
 "不言": "صَمْت, سُكُوت",
 "不言不語": "صَمْت, سُكُوت",
 "不許複製": "جَمِيع اَلْحُقُوق مَحْفُوظَة, كَافَّة اَلْحُقُوق مَحْفُوظَة",
 "不評": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول)",
 "不評判": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول)",
 "不詳": "مَجْهُول, مُبْهَم",
 "不認可": "إدانة, استهجان (فعل الاستهجان أو الإدانة)",
 "不語": "صَمْت, سُكُوت",
 "不誠実": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "不誠意": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "不調": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "不調和": "عدم انسجام, نشاز (افتقار للتناغم)",
 "不調法": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / خطأ فادح, زلة (خطأ محرج)",
 "不調法者": "شخص أخرق (شخص ذو تنسيق حركي ضعيف) / عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة)",
 "不謬性": "عصمة البابا (معتقد الكنيسة الكاثوليكية بأن الله يحمي البابا من الخطأ عندما يتحدث عن العقيدة…)",
 "不謹慎": "طَائِش, مُتَهَوِّر (يَفْتَقِر إِلَى ضَبْط النَّفْس الحَكِيم)\nمثال: تهور كبير من والدتها أن تشجعها على مثل هذه الأفكار الرومانسية السخيفة",
 "不貞": "خِيَانَة",
 "不貞腐れる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)",
 "不買同盟": "قَاطَعَ",
 "不買運動": "قَاطَعَ",
 "不賛成": "إدانة, استهجان (فعل الاستهجان أو الإدانة)",
 "不起": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "不足": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ)\nمثال: عدم كفاية إعانات البطالة / استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不足を言う": "تَذَمَّرَ, اِشْتَكَى",
 "不足分": "عَجْز, نَقْص",
 "不足前": "عَجْز",
 "不身持ち": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不躾": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "不軌": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不輸租田": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "不退": "عَزِيمَة",
 "不退転": "عَزِيمَة",
 "不透明": "أَكْمَد / إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / غَامِض, غَيْر وَاضِح (غير واضح للعقل)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "不透明度": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء)",
 "不透明性": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء)",
 "不透明感": "تذبذب, عجز عن الحسم (سمة التردد؛ نقص في صلابة الشخصية أو الغرض)\nمثال: تسبب تردد الملك غير القابل للشفاء في اضطراب في بلاطه",
 "不透明水彩": "جواش (لوحة مائية منفذة بألوان مائية معتمة ممزوجة بالصمغ)",
 "不通": "يُعَلِّق",
 "不逞": "عَنِيد, مُسْتَعْصٍ (يَتَّسِمُ بِالمُقَاوَمَةِ العَنِيدَةِ لِلسُّلْطَة)",
 "不逞の輩": "عِصَابَة",
 "不連続": "مُتَقَطِّع",
 "不連続性": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "不連続点": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "不連続線": "جَبْهَة",
 "不逮捕特権": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين…)",
 "不遇": "مُصِيبَة, شَقْوَة",
 "不運": "مُصِيبَة, شَقْوَة\nمثال: 彼は身の不運を嘆き悲しんだ。 — بكى على سوء حظه.",
 "不道": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بربرية, همجية (فعل همجي وحشي بربري)",
 "不道徳": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "不道理": "سَخَافَة",
 "不遜": "مُتَعَالٍ, الْمُتَعَالِي",
 "不遠慮": "فَظّ",
 "不適": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية)\nمثال: عدم كفاية إعانات البطالة",
 "不適任": "عَدَم أَهْلِيَّة, عَدَم صَلَاحِيَّة (صفة كون الشيء غير مناسب)\nمثال: اتفق القضاة على عدم أهليته للتعيين",
 "不適切": "غَيْرُ لَائِق, غَيْرُ مَرْغُوب (غير جدير بالاختيار خاصة كشريك زواج)",
 "不適合": "عاصٍ, متحدٍ (مقاوم بجرأة للسلطة أو لقوة معارضة)\nمثال: تربى ليكون عدوانياً ومتحدياً",
 "不適当": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية)\nمثال: عدم كفاية إعانات البطالة",
 "不適格": "إِقْصَاء",
 "不適格者": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "不適正": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "不適用": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "不都合": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ / مُخْطِئ\nمثال: نحن نرفض الظلم.",
 "不量見": "زلة, هفوة (إساءة بسيطة)",
 "不釣り合い": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "不釣合": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "不釣合い": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "不銹鋼": "فُولَاذ مُقَاوِم لِلصَّدَأ",
 "不錆鋼": "فُولَاذ مُقَاوِم لِلصَّدَأ",
 "不間": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً))",
 "不随": "شَلَل, فَالَج",
 "不随意": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة)\nمثال: قتل غير عمد (لا إرادي)",
 "不随意筋": "عضلة لا إرادية, عضلة ملساء (عضلة تنقبض دون تحكم واعي وتوجد في جدران الأعضاء الداخلية مثل المعدة والأمعاء…)",
 "不面目": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "不順": "شَاذّ, غَيْر مُنْتَظِم",
 "不風流": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "不食": "صَوْم, صِيَام",
 "不飽和": "غَيْر مُشَبَّع ((للألوان) غير نقي لونيًا؛ مخفف)\nمثال: أحمر غير مشبع",
 "不飽和化合物": "مركب غير مشبع (مركب كيميائي يحتوي على روابط كربون-كربون مزدوجة أو ثلاثية، مثل تلك الموجودة في…)\nمثال: المركبات المشبعة وغير المشبعة لا تتكون بالضرورة فقط من سلسلة ذرات كربون",
 "不飽和脂肪酸": "حمض دهني غير مشبع (حمض دهني يمكن لسلسلة الكربون الخاصة به امتصاص ذرات هيدروجين إضافية)",
 "不養生": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو…)\nمثال: تطرف لغتهم",
 "不首尾": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا. / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة)\nمثال: هو في حالة سخط من الملك (مغضوب عليه)",
 "不鮮明": "غَشَّى, غَبَّش / ضَبَابِيّ, مُغَبَّش (غير واضح في الشكل أو التعبير)",
 "与え": "هَدِيَّة, هدية",
 "与えたもう": "أَنْعَمَ",
 "与える": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تعيين شخص لعمل ما / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "与え主": "مُعْطٍ",
 "与え給う": "أَنْعَمَ",
 "与え賜う": "أَنْعَمَ",
 "与かる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "与しやすい": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات)\nمثال: عقول شابة طيعة",
 "与し易い": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات)\nمثال: عقول شابة طيعة",
 "与する": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "与る": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "与件": "مُسَلَّم ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "与信": "اِئْتِمَان",
 "与党": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "与党議員": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "与力": "رَقِيب شُرْطَة (رجل قانون برتبة رقيب)",
 "与国": "حَلِيف, حَلِيفَة",
 "与太者": "دَمَوِيّ, سَفَّاح",
 "与太話": "خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط.",
 "与太郎": "كَذَّاب, كَذَّابَة / ضَجَعَ, تَمَدَّدَ\nمثال: اتهمتني بالكذب.",
 "与座": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "与格": "حَالَة الْمَفْعُول لَهُ, حَالَة مِنْ حَالَات النُّصْب",
 "与田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "与那原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "与那国蚕": "عثة الأطلس (عثة عملاقة واسعة الانتشار في آسيا؛ تُربى أحياناً من أجل الحرير)",
 "与那嶺": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "丐児": "سَائِل",
 "丑": "ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور…)\nمثال: حرث ما حرث الثور. / باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "丑三つ": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل",
 "丑三つ時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل",
 "丑寅": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي)",
 "且": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "且つ": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "且つ又": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "且又": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "丕顕": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين)",
 "世": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "世にいう": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "世にも": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "世に出る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "世に言う": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "世のならい": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "世の中": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع.",
 "世の常": "عَادِيّ, مَأْلُوف",
 "世の習い": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "世の覚え": "سُمْعَة, شُهْرَة",
 "世も末": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "世を去る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "世を渡る": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "世上": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世事に疎い": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "世人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "世代": "جِيل, نَسْل",
 "世代交代": "تعاقب الأجيال, تولد متباين (تناوب شكلين مختلفين أو أكثر في دورة حياة نبات أو حيوان)",
 "世伝": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث)",
 "世俗": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世俗主義": "عَلْمَانِيَّة, لَائِكِيَّة",
 "世俗化": "عَلْمَنَة",
 "世俗心": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "世俗的": "دُنْيَوِيّ",
 "世俗的ヒューマニズム": "إنسانية, إنسانية علمانية (المذهب الذي يؤكد قدرة الشخص على تحقيق ذاته من خلال العقل؛ يرفض الدين والخوارق)",
 "世嗣": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世子": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世帯": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "世帯主": "صاحب منزل, مالك المنزل (شخص يمتلك منزلاً)",
 "世情": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "世才": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "世捨て人": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "世捨人": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "世智": "إقدام, عزيمة (الثبات والتصميم)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "世柄": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "世渡り": "كَفَاف",
 "世渡り上手": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "世界": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / فَلْكَة / فَرَاغ, مَكَان\nمثال: الفضاء مليئ بالغموض.",
 "世界に誇る": "أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "世界の七不思議": "عجائب الدنيا السبع, عجائب الدنيا السبع القديمة (آثار ونصب مثيرة للإعجاب تم إنشاؤها في العالم القديم وكان يُنظر إليها برهبة…)",
 "世界の果て": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "世界を舞台に": "دولياً, عالمياً (على مستوى العالم)\nمثال: هي معروفة دولياً",
 "世界一周": "طواف حول العالم (السفر حول شيء ما (بالسفينة أو الطائرة))\nمثال: أثبت طواف ماجلان حول الأرض أنها كروية",
 "世界主義": "الْمُوَاطَنَة الْعَالَمِيَّة",
 "世界人": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
