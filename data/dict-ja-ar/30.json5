 "中夏": "قيظ / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "中夜": "انقلاب شتوي (22 ديسمبر، عندما تكون الشمس في أقصى نقطة جنوبية لها)",
 "中大脳動脈": "شريان مخي أوسط (أحد فرعي الشريان السباتي الباطن؛ ينقسم إلى ثلاثة فروع)",
 "中天": "جَوّ",
 "中太り": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "中央": "مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "中央アジア": "آسِيَا الْوُسْطَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "中央アフリカ": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "中央アフリカ共和国": "جُمْهُورِيَّة أَفْرِيقِيَا الْوُسْطَى",
 "中央アメリカ": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "中央ホール": "أُذَيْن",
 "中央ヨーロッパ": "أُورُوبَا الْوَسَطَى (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "中央値": "وَسِيط",
 "中央処理装置": "وحدَة المعالجَة المَرْكَزِيَّة",
 "中央分離帯": "وَسِيط",
 "中央寄せ": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "中央情報局": "سي آي إيه, وكالة الاستخبارات المركزية (وكالة مستقلة تابعة لحكومة الولايات المتحدة مسؤولة عن جمع وتنسيق أنشطة الاستخبارات والاستخبارات المضادة في الخارج من أجل المصلحة الوطنية؛ يرأسها مدير…)",
 "中央揃え": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "中央標準時": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
