 "個体数": "سُكَّان / سُكَّانِيَّة",
 "個体発生": "تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "個体発生論": "تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال",
 "個体群": "سُكَّان / سُكَّانِيَّة",
 "個個": "فَرْد, شَخْص",
 "個個に": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "個別": "فَرْد, شَخْص",
 "個別化": "تفريد, تمييز الفرد (تمييز الفرد عن المجموعة العامة أو النوع)",
 "個別指導": "تعليمي, دروس خصوصية (من أو متعلق بالمعلمين الخصوصيين أو التدريس الخصوصي) / حصة توجيهية, درس خصوصي (جلسة تعليم مكثف يقدمها معلم لفرد أو لعدد صغير من الطلاب)\nمثال: جلسات تعليمية",
 "個別的": "فَرْد, شَخْص",
 "個別販売": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "個室": "أَحَادِيّ / وَاحِد (في وَ: العدد واحد العدد الاول) / أَعْزَب, غَيْر مُتَزَوِّج / إصدار منفرد, أغنية منفردة / عَزَب\nمثال: رأيت واحدة مرة. / مَعْلِف, مُرَاح / بَسْطة",
 "個性": "هوية, هوية شخصية (الشخصية المتميزة للفرد باعتبارها كياناً مستمراً) / تفرد, فردية (صفة كون المرء فرداً)\nمثال: يمكن أن تفقد هويتك عند الانضمام للجيش",
 "個性的": "فَرْد, شَخْص",
 "個所": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "個数": "كَمِّيَّة, مِقْدَار",
 "個条": "بَنْد",
 "個条書き": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "個物": "فَرْد, شَخْص",
 "個目": "إِلَى أَقْصَى حَدٍّ, اَلنُّونِيّ (الأخير أو الأعظم في سلسلة كبيرة غير محددة)",
 "個虫": "حييوان, فرد مستعمرة (أحد الأفراد المتميزين الذين يشكلون حيواناً مستعمراً مثل الحيوانات الطحلبية أو الهيدرية)",
 "倍": "ثُنَائِيّ / ضِعْف / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "倍々": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "倍する": "ثُنَائِيّ / ضِعْف / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "倍にする": "ثُنَائِيّ / ضِعْف",
 "倍倍": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "倍力": "مؤازر آلي (من أو ينطوي على آليات مؤازرة (سيرفو)) / آلية مؤازرة, سيرفو (نظام تحكم يحول حركة ميكانيكية صغيرة إلى حركة تتطلب طاقة أكبر بكثير؛ قد يتضمن نظام تغذية مرتدة سلبية)",
 "倍加": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "倍増": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "倍増し": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "倍数": "متعدد / مُضَاعَف",
 "倍数体": "متعدد الصيغة الصبغية (لخلية أو كائن حي يحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات) / متعدد الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات)\nمثال: خلية متعددة الصيغة الصبغية",
 "倍数性": "تعدد الصيغة الصبغية (حالة كون الكائن متعدد الصيغة الصبغية)",
 "倍数比例の法則": "قانون النسب المتضاعفة ((كيمياء) قانون ينص على أنه عندما يمكن لعنصرين أن يتحدوا لتكوين أكثر من مركب واحد، فإن كميات أحدهما التي تتحد مع كمية ثابتة من الآخر ستظهر علاقة…)",
 "倍旧": "مُضَاعَف (ازداد كثيراً في الشدّة أو الحجم أو الكمّية)",
 "倍率": "تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع) / تَكْبِير (نسبة حجم الصورة إلى حجم الشيء)",
 "倍良": "لبروسية (أسماك بحرية استوائية بشكل رئيسي ذات شفاه لحمية وأسنان قوية؛ عادة ما تكون زاهية الألوان)",
 "倍音": "نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي) / إِيحَاء, نَبْرَة خَفِيَّة ((عادة الجمع) معنى أو جودة ضمنية خفية)\nمثال: إيحاءات اليأس",
 "倒": "عَكَسَ / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / عَكْسِيّ, مُعَاكِس (معكوس في الترتيب أو الطبيعة أو الأثر) / عكسي (معاكس في الطبيعة أو التأثير أو العلاقة بكمية أخرى) / مَعْكُوس (شيء معكوس في التسلسل أو الطابع أو التأثير)\nمثال: يكون الحد في تناسب عكسي مع حد آخر إذا زاد (أو نقص) بنقصان (أو زيادة) الآخر",
 "倒かす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "倒ける": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / تماماً, مباشرة (بشكل كامل) / انهيار, سقوط (فعل رمي نفسك للأسفل؛ الانهيار؛ الغوص) / بصوت ارتطام, سقوطاً (مع صوت ارتطام) / إخفاق تام, فشل ذريع (فشل كامل)\nمثال: سقط مباشرة على وجهه",
 "倒さ": "معكوس البويضة, منقلب البويضة ((عن بويضة النبات) مقلوبة تماماً؛ منعطفة للخلف بزاوية 180 درجة على سويقتها) / رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "倒す": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته) / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / أَطَاحَ / غَشَّ / صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "倒る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "倒れ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "倒れこむ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "倒れる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "倒れ込む": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "倒伏": "إِقَامَة",
 "倒壊": "تَدْمِير, هَدْم",
 "倒影": "اِنْعِكَاس, عَكْس",
 "倒産": "إِفْلَاس",
 "倒立": "وقوف على اليدين (فعل دعم النفس باليدين فقط في وضع مقلوب)",
 "倒置": "عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "倒置法": "تقديم وتأخير, قلب (عكس الترتيب الطبيعي للكلمات)",
 "倒錯": "تحريف, قلب الحقائق (فعل تحريف الشيء (تحويله لاستخدام خاطئ)) / انحراف جنسي, شذوذ (ممارسة جنسية شاذة) / التواء عكسي (منحنى يعكس اتجاه شيء ما)\nمثال: كان ذلك تحريفاً للعدالة / عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح)",
 "倒錯症": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "倒錯的": "فَاسِقٌ, مُنْحَرِف (يَنْحَرِفُ عَمَّا يُعْتَبَرُ أَخْلَاقِيًّا أَوْ صَحِيحًا أَوْ لَائِقًا) / شَارِد, عَنِيد (مقاوم للتوجيه أو الانضباط) / شَاذّ, عِنَادِيّ (يتميز بالميل إلى المعارضة والمناقضة)",
 "倒錯者": "مُنْحَرِف, مُنْحَرِفَة",
 "倘佯": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "候": "مَوْسِم / مَوْسِم, جُزْء / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "候ふ": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "候処": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "候所": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "候補": "مُرَشَّح / مُرَشَّحَة / حملة انتخابية (حملة المرشح ليتم انتخابه)",
 "候補生": "تِمْلِيذ عَسْكَرِيّ, تِمْلِيذَة عَسْكَرِيَّة",
 "候補者": "مُرَشَّح / مُرَشَّحَة",
