 "一人で": "وَحِيد, مُنْفَرِد",
 "一人につき": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "一人ひとり": "كُلّ",
 "一人ぼっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "一人ぽっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "一人も": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "一人エッチ": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "一人一人": "كُلّ",
 "一人前": "بَالِغ, رَاشِد\nمثال: 彼女も一人前の女になった。 — لقد اصبحت امرأة بالغة. / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "一人前になる": "بَلَغَ رُشْدَهُ",
 "一人勝手": "أَنَانِيّ",
 "一人占め": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "一人天狗": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "一人当たり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "一人残らず": "كُلّ, جَمِيع",
 "一人決め": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "一人物": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "一人用": "على سبيل المثال لا الحصر, من جهة (كواحد معين من عدة احتمالات)\nمثال: أنا على سبيل المثال ممتن جداً",
 "一人称": "مُتَكَلِّم",
 "一人親方": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "一人部屋": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "一介": "تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "一仕事": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "一代": "جِيل, نَسْل / جِيل",
 "一代分限": "مُحْدَث اَلنَّعْمَة",
 "一代記": "سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ",
 "一件": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم.",
 "一件書類": "مِلَفّ",
 "一休み": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "一位": "طقسوس ياباني (شجيرة دائمة الخضرة قوية من الصين واليابان لها أوراق خضراء داكنة لامعة؛ تزرع في شرق الولايات المتحدة)",
 "一佐": "عَقِيد, زَعِيم",
 "一体": "بحق السماء, في الدنيا (تستخدم مع كلمات الاستفهام للتعبير عن الدهشة)\nمثال: ما الذي تفعله بحق السماء؟ / عُمُومًا / بِوَجْهٍ عَامّ / حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "一体に": "عُمُومًا / بِوَجْهٍ عَامّ",
 "一体化": "تَوْحِيد",
 "一体型モニタ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "一体型モニター": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "一体性": "وَحْدَانِيَّة, وحدَة",
 "一体感": "بِطَاقَة هُوِيَّة",
 "一体的": "صَحِيح / تَكَامُلِيّ",
 "一例": "مِثَال, مَثَل / مِثَال",
 "一価不飽和脂肪酸": "حمض دهني أحادي غير مشبع (حمض دهني غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أو ثلاثية واحدة لكل جزيء؛ يوجد بشكل رئيسي في زيت الزيتون والدجاج واللوز)",
 "一価関数": "تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة))",
 "一個": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "一個あたり": "كُلّ",
 "一個一個": "فَرْد, شَخْص",
 "一個人": "فَرْد, شَخْص",
 "一個当たり": "كُلّ",
 "一個当り": "كُلّ",
 "一倍": "أَكْثَر / ثُنَائِيّ / ضِعْف",
 "一倍体": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات)",
 "一偏": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / نِيَّة / غَيْرُ مُتَوَازِن (المدين والدائن ليسا متساويين) / غير متوازن, مختل التوازن (كونه خارج التوازن أو تم إخراجه عن التوازن) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ)",
 "一儀": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "一億": "مئة مليون",
 "一億個": "مئة مليون",
 "一元": "مركزي, موحد (يتميز بـأو يشكل شكلاً من أشكال الحكم تكون فيه السلطة بيد سلطة مركزية واحدة) / وَاحِد, وَحْدَوِيّ (له طابع الوحدة غير القابلة للتجزئة) / وحدوي (متعلق باستخدام الوحدات أو يعتمد عليها (في الرياضيات والقياس)) / توحيدي, وحدوي (متعلق بالوحدة أو يهدف إليها أو يتميز بها)\nمثال: شكل موحد للحكومة في مقابل الشكل الفيدرالي",
 "一元化": "تَوْحِيد",
 "一元的": "أحادي (من أو يتعلق بمذهب الواحدية الفلسفي)\nمثال: المدرسة الأحادية تعتبر القانون الوطني والقانون الدولي كلاً متكاملاً",
 "一元論": "مونية, وحدوية (المذهب القائل بأن الواقع يتكون من مادة أو عنصر أساسي واحد)",
 "一元配置分散分析": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "一先": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "一先ず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "一党優位政党制": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一党支配": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一党独裁": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一党独裁体制": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一入": "خُصُوصًا, خَاصَّةً",
 "一八": "ثَمَانِيَةَ عَشَرَ / زهرة الزنبق ((شعارات النبالة) شحنة تتكون من تمثيل تقليدي لزهرة السوسن) / زنبق السيف, سوسن (نباتات ذات أوراق تشبه السيف وسيقان منتصبة تحمل أزهاراً زاهية الألوان تتكون من ثلاث بتلات وثلاث سبلات متدلية) / لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "一六": "سِتَّةَ عَشَرَ / سَرِقَة, لُصُوصِيَّة",
 "一六勝負": "قِمَار, مُقَامَرَة / مُخَاطَرة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / خَاطَرَ\nمثال: أنا ذاهب للخطر.",
 "一六銀行": "مرهن",
 "一兵卒": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "一円": "طَوَال",
 "一円を笑う者は一円に泣く": "تَوَخَّى اَلْحِذْر",
 "一再": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "一再ならず": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "一処": "مَعًا, سَوِيًّا",
 "一刀": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "一分": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي) / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "一分の隙もない": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / مَانِع لِلْمَاء (لا يسمح بمرور الماء دخولاً أو خروجاً)",
 "一分一厘": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "一分野": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "一切": "كُلّ, جَمِيع / مطلقا, على الإطلاق",
 "一切り": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "一切れ": "شريحة / قَطَّعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "一切合切": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "一切合財": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "一列": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎.",
 "一別": "فِرَاقٌ",
 "一刹那": "عَزْم / لَحْظَة, دَقِيقَة",
 "一刻": "عَزْم / لَحْظَة, دَقِيقَة / عَنِيد",
 "一刻の猶予もない": "هُنَاكَ, يُوجَدُ",
 "一刻み": "فَائِق, مُمْتَاز (من أعلى مستويات الجودة)",
 "一刻も早く": "فَوْرًا, حَالًا",
 "一刻一刻": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة) / سَاعِيّ (يحدث كل ساعة أو يُدفع بالساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "一刻千金": "اَلْوَقْتُ مِنْ ذَهَبٍ",
 "一割": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "一助": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "一匹": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "一匹オオカミ": "منعزل, وحيد (شخص يتجنب رفقة أو مساعدة الآخرين)",
 "一匹狼": "منعزل, وحيد (شخص يتجنب رفقة أو مساعدة الآخرين)",
 "一区": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "一区切り": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "一千": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "一半": "نِصْف, نُصْف",
 "一卵性": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة) / قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ) / مُتَمَاثِل (ذو خصائص بقيم موحّدة على طول جميع المحاور) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: التوائم المتطابقة هي أحادية البويضة",
 "一卵性双生児": "توأم متطابق (أحد توأمين تطورا من نفس البويضة المخصبة (لهما نفس المادة الوراثية))",
 "一双": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "一反": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "一叢": "أجمة, دغل (نمو كثيف للشجيرات)",
 "一口": "لُقْمَة / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / بِاخْتِصَار",
 "一口話": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "一句": "جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "一号": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء الشخصية أولاً) / الأول, رقم واحد (العنصر الأول في سلسلة قابلة للعد) / الأول, رقم واحد (الأول أو الأعلى في ترتيب أو سلسلة)\nمثال: الأول من الشهر",
 "一号園児": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "一合": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "一名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "一向": "تَمَامًا / أبداً / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه / مَدْفُوع, مُصَمِّم (شديد الدافعية نحو النجاح) / محدد, معلوم (تم معرفته أو العثور عليه أو تحديده خاصة عن طريق التحقيق) / مُصَمِّمٌ (يتميز بتصميم وعزيمة كبيرة) / مَحْسُوم, مُحَدَّد (تمّ تحديده أو البتّ فيه من قِبَل سلطة مختصّة)",
 "一向に": "تَمَامًا / أبداً / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "一吹き": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "一呑み": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / مَصَّة, رَشْفَة / مَزّ, كَرَع",
 "一周回って": "مَرَّة أُخْرَى (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "一周期": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "一味": "عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر) / مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان) / تابل, مطيب (شيء يضاف للطعام أساساً من أجل النكهة التي يضفيها)",
 "一味もふた味も": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "一味も二味も": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "一味唐辛子": "فلفل حريف, فلفل كايين (فلفل أحمر حار طويل وملتوي غالباً) / فلفل أحمر, فلفل حريف (قرون وبذور مطحونة للفلفل الأحمر اللاذع) / فلفل تشيلي, فلفل حريف (نبات يحمل فلفلاً طويلاً حاراً جداً ومستدقاً بدقة؛ عادة ما يكون أحمر)",
 "一命": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)",
 "一品": "بَنْد / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَبَق (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: هذا الطبق لذيذ.",
 "一喝": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "一四": "أَرْبَعَةَ عَشَرَ (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "一回": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "一回り": "دَارَة (لا جمع له)",
 "一回分": "جُرْعَة",
 "一回生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "一団": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "一国": "عَنِيد",
 "一国一党主義": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一国一城の主": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "一型糖尿病": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "一堪りもなく": "بِسُهُولَة",
 "一堪りも無く": "بِسُهُولَة",
 "一報": "مَعْلُومَات, مَعْلُومَة",
 "一場": "في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة",
 "一塁": "قاعدة أولى, مرحلة أولى (المرحلة الأولية في إنجاز شيء ما) / القاعدة الأولى (مركز اللعب للاعب في فريق البيسبول المتمركز عند القاعدة الأولى في الملعب الداخلي) / القاعدة الأولى (القاعدة التي يجب أن يلمسها عداء القاعدة أولاً في البيسبول)\nمثال: لم نصل إلى المرحلة الأولى بهذا النهج / لاعب القاعدة الأولى ((بيسبول) رجل يلعب في القاعدة الأولى)",
 "一塁手": "لاعب القاعدة الأولى ((بيسبول) رجل يلعب في القاعدة الأولى)",
 "一塩基": "أحادي الذرة (متعلق بعنصر يتكون من ذرة واحدة)\nمثال: الهيليوم والأرجون غازات أحادية الذرة",
 "一塩基多型": "تعدد أشكال النوكليوتيدات المفردة ((في علم الوراثة) تباين وراثي في تسلسل الحمض النووي يحدث عندما يتغير نيوكليوتيد واحد في الجينوم؛ وتعتبر عادة طفرات نقطية كانت ناجحة تطورياً بما يكفي…)",
 "一塩基酸": "حمض أحادي القاعدية (حمض يحتوي على ذرة هيدروجين واحدة قابلة للاستبدال في كل جزيء)",
 "一士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "一声": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "一変": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / دوران للخلف (فعل الدوران 180 درجة، خاصة في التشكيل العسكري)\nمثال: تحول تام في السياسة الخارجية",
 "一夕話": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "一夜": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "一夜大尽": "مِنَ الْفَقْرِ إِلَى الثَّرَاءِ, مِنَ الْفَقْرِ الْمُطْلَقِ إِلَى غِنَى الْفَاحِشِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "一夜妻": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "一夜漬": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "一夜漬け": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "一夜造り": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "一夢": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "一天": "رَقِيع, سماء",
 "一天万乗": "قَيْصَر, إِمْبْرَاطُور",
 "一天四海": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "一天地六": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "一夫一妻": "زواج أحادي (ممارسة أو حالة وجود زوج واحد فقط في المرة الواحدة)",
 "一夫一婦": "زواج أحادي (ممارسة أو حالة وجود زوج واحد فقط في المرة الواحدة)",
 "一夫一婦制": "زواج أحادي (ممارسة أو حالة وجود زوج واحد فقط في المرة الواحدة)",
 "一夫多妻": "تَعَدُّدُ الأَزْوَاج",
 "一夫多妻制": "تَعَدُّد اَلزَّوْجَات",
 "一失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "一如": "وَحْدَانِيَّة, وحدَة",
 "一妻多夫": "تَعَدُّد اَلْأَزْوَاج",
 "一字": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "一字一句": "حَرْفِيًّا, كَلِمَة بِكَلِمَة (باستخدام نفس الكلمات تماماً)\nمثال: كرر ملاحظاتها حرفياً",
 "一字半句": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "一安心": "سَكِينَة, طُمَأْنِينَة",
 "一宗": "فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني.",
 "一定": "صَلَّحَ / أَصْلَحَ / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / حقاً, يقيناً (في الحقيقة؛ بالتأكيد)\nمثال: أعتقد ذلك حقاً / أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "一定ビットレート": "إشعاع الخلفية الكونية ((في علم الكونيات) البقايا المبردة للانفجار العظيم الحار التي تملأ الكون بأسره ويمكن رصدها اليوم بمتوسط درجة حرارة حوالي 2.725 كلفن)",
 "一定不変": "ثابت, غير متغير (غير عرضة لـ أو غير قابل للتغيير) / ثابت, كمية ثابتة (كمية لا تتغير)\nمثال: درجة حرارة ثابتة",
 "一実": "الْمُخْتَار, الْمُخْتَارَة",
 "一宮": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "一家": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / عِصَابَة",
 "一寝入り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "一寸した": "طَفِيف / كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "一寸先は闇": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "一寸法師": "قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ",
 "一寸見": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "一寸逃れ": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "一対": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "一対一": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "一対一の写像": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "一対一の通信": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "一対一対応": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "一封": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "一将": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "一尉": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "一層": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض / بِالْأَحْرَى",
 "一層の事": "بِالْأَحْرَى",
 "一山": "كَوْم / سَنَام / حَدَبَة, سَنَام / مُمِيت, قَاتِل / قَتْل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "一山いくら": "بَخْس الثَّمَن, رَخِيص جِدّاً (رخيص للغاية؛ شبه مجاني) / لُوط",
 "一山幾ら": "بَخْس الثَّمَن, رَخِيص جِدّاً (رخيص للغاية؛ شبه مجاني) / لُوط",
 "一工夫": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "一己": "شَخْصِيّ",
 "一巻の終り": "النِهاية",
 "一巻の終わり": "النِهاية",
 "一帖": "رَزْمَة صَغِيرَة, مَلْزَمَة وَرَق (كمية من الورق؛ 24 أو 25 ورقة)",
 "一席": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "一帯": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "一幅": "طُومَار",
 "一幕": "مَنْظَر, مَشْهَد / مَشْهَد",
 "一幕もの": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "一幕物": "مسرحية الفصل الواحد (مسرحية قصيرة تتكون من فصل واحد)",
 "一年": "سنة شمسية, سنة فلكية (الوقت اللازم للأرض لعمل دورة واحدة حول الشمس، مقاسة بين اعتدالين ربيعيين)",
 "一年氷": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "一年生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ)) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ. / سَنَوِيّ",
 "一年生植物": "سَنَوِيّ",
 "一年草": "سَنَوِيّ",
 "一度": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "一度ならず": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "一度に": "بغتة, فجأة (بشكل مفاجئ) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: فجأة، بدأ بالصراخ",
 "一度も": "يَوْمًا",
 "一座": "طَرَف / حَفْلَة, اِحْتِفَال / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة / وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت. / فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "一庵": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "一廉": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة / بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "一廓": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "一式": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / كُلّ, جَمِيع",
 "一弾指": "لَحْظَة",
 "一役": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "一役買う": "شَارَكَ, سَاهَمَ",
 "一往": "حَوَالِي / بشكل مؤقت, مبدئياً (بطريقة مؤقتة أو غير نهائية)\nمثال: اتفقنا مبدئياً على موعد للعشاء / تَحَسُبًا / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "一律": "زَيّ, زِي",
 "一律に": "بِانْتِظَام, بِتَجَانُس (بطريقة موحدة)\nمثال: سطح مشرق بانتظام",
 "一得": "جَدَارَة",
 "一徳": "فَضِيلَة / عِفَّة, طَهَارَة",
 "一徹": "مُتَعَنِّت, عَنِيد",
 "一徹者": "تقليدي (من يلتزم بالآراء التقليدية)",
 "一心": "إخلاص, صدق عزيمة (التزام كامل أو حماس غير متحفظ) / إخلاص قلبي, حرارة (صفة الإخلاص القلبي الحار)",
 "一心に": "قَلْبًا وَقَالَبًا",
 "一心不乱": "قَلْبًا وَقَالَبًا",
 "一応": "حَوَالِي / بشكل مؤقت, مبدئياً (بطريقة مؤقتة أو غير نهائية)\nمثال: اتفقنا مبدئياً على موعد للعشاء / تَحَسُبًا / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "一思いに": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "一息": "تَوَقَّفَ / تَوَقُّف, وَقْف / قَلِيلًا",
 "一悶着": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "一意": "قَلْبًا وَقَالَبًا / فَرِيد, فَذّ",
 "一意名": "مُعَرِّف",
 "一意専心": "بتركيز وحيد الهدف, بتصميم (بطريقة تركز على هدف واحد)",
 "一意性": "تميز, فرادة (صفة كون الشيء فريداً من نوعه)",
 "一意的": "فَرِيد, فَذّ",
 "一戦": "مَعْرَكَة",
 "一戸": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "一戸建": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "一戸建て": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "一所": "مَعًا, سَوِيًّا",
 "一所不住": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "一手": "اِحْتِكَار, اِنْحِصَار / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص. / سَرِيَّة / شَرِكَة",
 "一手に": "بجهد فردي, بمفرده (دون مساعدة)\nمثال: بنيت هذا المنزل بمفردي",
 "一才": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "一打": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "一把": "إِبَالَة, حُزْمَة",
 "一抱え": "حِضن, ملء الذراعين (الكمية التي يمكن احتواؤها بين الذراعين)",
 "一抹": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي! / دَهَنَ (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / لَوَّثَ\nمثال: توم بدهن غرفته.",
 "一押し": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن.",
 "一括": "بيان ختامي, خلاصة نهائية (ملخص ختامي (كما في عرض قضية أمام محكمة قانونية))",
 "一括処理": "معالجة دفعية (التنفيذ التسلسلي لبرامج الكمبيوتر)",
 "一指当たり": "شِبْر",
 "一挨一拶": "حوار, محاورة (مؤلف أدبي في شكل محادثة بين شخصين) / حوار (السطور التي تتحدث بها الشخصيات في الدراما أو الخيال) / حوار, ديالوغ (محادثة بين شخصين)\nمثال: قرأ محاورات أفلاطون باليونانية الأصلية",
 "一掃": "تطهير, تنقية (فعل الإزالة عن طريق التنظيف؛ التخلص من الرواسب أو العناصر الأخرى غير المرغوب فيها) / تبرئة, تطهير (فعل تبرئة نفسك (أو شخص آخر) من وصمة عار أو تهمة) / تطهيري, تكفيري (يخدم في التطهير أو التخلص من الخطيئة)\nمثال: طقوس تطهيرية",
 "一掴み": "حَفْنَة / جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "一揆": "ثَوْرَة, عِصْيَان",
 "一握": "حَفْنَة",
 "一握り": "حَفْنَة / جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "一摘み": "قَرَصَ / قَرْصَة",
 "一撃": "تزرير, صفيحة عزل (صفيحة معدنية مشكلة ومثبتة على سطح لتقويته وحمايته من العوامل الجوية) / بريق, ومضة (تجربة حية قصيرة)\nمثال: اجتاحته ومضة من المشاعر",
 "一撫で": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "一撮": "قَرَصَ / قَرْصَة",
 "一撮み": "قَرَصَ / قَرْصَة",
 "一攫千金を夢見る男": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "一文": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / كِتَابَة, مَادَّة مَكْتُوبَة (عمل الكاتب؛ أيّ شيء يُعبَّر عنه بحروف الأبجديّة) / بِنْس",
 "一文なし": "فقير",
 "一文字": "خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم / بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "一文惜しみ": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "一文惜み": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "一文無し": "فقير",
 "一斉": "مُتَزَامِن",
 "一斉に": "فِي وَقْت وَاحِد, مَعًا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "一斉射撃": "رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية)\nمثال: فاجأتهم رشقنا من الجناح الأيسر",
 "一斉攻撃": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "一斑": "جُزْء",
 "一新": "إِصْلَاح",
 "一新紀元": "العَصْر الجَدِيد",
 "一方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة / عِنْدَمَا / عَادِيّ, مَأْلُوف",
 "一方そのころ": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "一方その頃": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "一方ならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "一方ならぬ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "一方交通": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "一方向": "أُحَادِيّ الاِتِّجَاه (يعمل أو يتحرك أو يسمح بالحركة في اتجاه واحد فقط)\nمثال: تدفق أحادي الاتجاه",
 "一方向性関数": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "一方的": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "一方通行": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "一族": "فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "一旗": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "一日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "一日も早い": "سَرِيع الإِنْجَاز, عَاجِل (يُنْجَز بِسُرْعَة وَبِدُون تَأْخِير) / خَفِيف, سَرِيع الحَرَكَة (يَتَّسِم بِالسُّرْعَة؛ يَتَحَرَّك أَوْ قَادِر عَلَى التَّحَرُّك بِسُرْعَة عَالِيَة)",
 "一日も早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "一日一夜": "طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "一日一日": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "一日三秋": "بفارغ الصبر, بنافذ الصبر (مع نفاد صبر؛ بطريقة غير صبورة)\nمثال: أجابها بفارغ الصبر",
 "一日中": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "一日千秋": "بفارغ الصبر, بنافذ الصبر (مع نفاد صبر؛ بطريقة غير صبورة)\nمثال: أجابها بفارغ الصبر",
 "一日増しに": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "一旦": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / بِاِخْتِصَار",
 "一昔": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "一昔前": "قَدِيماً",
 "一昨日": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / قَبْلَ أَمْس, أَمْس الْأَوَّل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: لم تكن أول مرة.",
 "一時": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في إحدى المرات, مرة (في مناسبة واحدة)\nمثال: قابلتها مرة / اَلسَّاعَة اَلْوَاحِدَة / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "一時しのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "一時に": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "一時のがれ": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "一時代": "حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "一時休戦": "هُدْنَة, وَقْفُ نَار",
 "一時休止": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / تأجيل, رفع الجلسة (فعل التأجيل إلى وقت أو مكان آخر)",
 "一時保育": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "一時停止": "يُعَلِّق / تَعْلِيق / ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة) / حشوة, شريط لحام (مثبت يتكون من شريط ضيق من المعدن الملحوم يستخدم لربط الأعضاء الفولاذية)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً",
 "一時凌ぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "一時期": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "一時的": "مُؤَقَّت",
 "一時解雇": "تسريح, تسريح العمالة (فعل تسريح موظف أو قوة عاملة)",
 "一時逃れ": "جدل بيزنطي, مماحكة (التهرب من نقطة الجدال عن طريق إثارة تمييزات أو اعتراضات غير ذات صلة)",
 "一時金": "حدث لمرة واحدة (حدث يقع مرة واحدة فقط ولا يتكرر) / عِلَاوَة",
 "一時預け": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "一時預所": "غرفة المعاطف, غرفة الملابس (غرفة يمكن ترك المعاطف والأشياء الأخرى فيها مؤقتاً) / استراحة الأعضاء (صالة خاصة ملحقة بقاعة تشريعية)",
 "一晩": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "一暴れ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "一曲": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "一曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "一月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "一服": "زفر, نفخ (زفير قوي عن طريق الأنف أو الفم) / سحبة, شفطة (استنشاق بطيء (كما في دخان التبغ)) / مُكَوَّر, مُنْتَفِخ (مجموع بحيث يبرز بامتلاء) / بف, مقعد عثماني (وسادة سميكة تستخدم كمقعد)\nمثال: أعطى أنفه نفخة قوية / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "一服を盛る": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "一服盛る": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "一朝": "مُؤَقَّتًا",
 "一期": "شوط أول, فترة أولى (القسم الأول الذي ينقسم إليه لعب المباراة)",
 "一期末代": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "一本": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / غَيْشَا / أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "一本とられた": "مَلْمُوس",
 "一本とる": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "一本グソ": "نَقَانِقِيُّ الشَّكْل (على شكل النقانق)",
 "一本化": "تَوْحِيد",
 "一本取られた": "مَلْمُوس",
 "一本取る": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "一本指": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "一本気": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "一本立ち": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "一本糞": "نَقَانِقِيُّ الشَّكْل (على شكل النقانق)",
 "一本背負い": "أَحَادِيّ الذِّرَاع (ذو ذراع واحدة فقط)",
 "一本調子": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة) / رتيب, مطرد (عن التسلسل أو الدالة؛ تتزايد باستمرار ولا تتناقص أبداً أو تتناقص باستمرار ولا تتزايد أبداً في القيمة) / رتابة, صوت رتيب (تنغيم غير متغير) / نغمة رتيبة, نغمة واحدة (نغمة واحدة تتكرر بكلمات مختلفة أو إيقاعات مختلفة (خاصة في أداء النصوص الليتورجية))",
 "一札": "وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "一朶": "فَرْع, غُصْن",
 "一村": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "一束": "مِئَة (يَدُلُّ عَلَى العَدَد 100)",
 "一条": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "一条の光": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "一条縞蚊": "بعوضة النمر الآسيوية (موطنها اليابان ومخططة، تزدهر في جنوب غرب ووسط غرب الولايات المتحدة وتنتشر إلى منطقة البحر الكاريبي؛ ناقل محتمل لأمراض خطيرة)",
 "一杯": "كوب, ملء كوب (الكمية التي يستوعبها كوب)\nمثال: شرب كوباً من القهوة / مُمْتَلِئ, مَلِيء / شِبَع, شبعان / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "一杯々々": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "一杯一杯": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "一杯機嫌": "سكران قليلاً (من شرب الخمر حتى سَكِرَ)\nمثال: تبدو كأنها سكرانة.",
 "一杯食わす": "غَشَّ",
 "一杯食わせる": "غَشَّ",
 "一枚": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَرَقَة, وَرَقة / صَحِيفَة",
 "一枚岩": "مُونُولِيث / وَحْدَة, اِتِّحَاد",
 "一枚看板": "ديفا, مغنية أوبرا رئيسية (مغنية أوبرا متميزة؛ نجمة أوبرا أنثى) / شخصية مغرورة (شخص مغرور ومتقلب المزاج)",
 "一枚貝": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات) / أحادي الصدفة (يستخدم للرخويات، خاصة بطنيات القدم، مثل القواقع وغيرها)",
 "一案": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "一條": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "一概に": "بشكل قاطع, بشكل مطلق (بطريقة غير مشروطة) / بِلَا شُرُوط, دُونَ قَيْد (غير خاضع لشرط)\nمثال: نفى التهم بشكل قاطع",
 "一構え": "خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة)) / تجمع, حزمة (تجمع لعدد من الأشياء المتشابهة) / تكتل, كتلة (كتلة متماسكة)\nمثال: مجموعة من الأشجار",
 "一様": "زَيّ, زِي / شَائِع",
 "一樹": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "一欠けら": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / خرقة, رقعة (قطعة صغيرة من القماش) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "一欠片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / خرقة, رقعة (قطعة صغيرة من القماش) / ذرة, مثقال ذرة (كمية صغيرة جداً أو نادرة الوجود)",
 "一次": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَوَّلِيّ / تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري",
 "一次コイル": "ملف ابتدائي (ملف يشكل جزءاً من دائرة كهربائية بحيث يؤدي تغيير التيار فيه إلى حث تيار في دائرة مجاورة)\nمثال: التيار عبر الملف الابتدائي يحث تياراً في الملف الثانوي",
 "一次元配列": "أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / أحادي البعد, سطحي (يتعلق ببعد أو جانب واحد؛ ليس له عمق أو نطاق)",
 "一次回": "أَوَّلِيّ, أَوَّل / أَوَّل (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / حَرْف أَوَّلِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: لم تكن أول مرة.",
 "一次性": "أَوَّلِيّ",
 "一次方程式": "معادلة خطية (معادلة متعددة الحدود من الدرجة الأولى)",
 "一次線輪": "ملف ابتدائي (ملف يشكل جزءاً من دائرة كهربائية بحيث يؤدي تغيير التيار فيه إلى حث تيار في دائرة مجاورة)\nمثال: التيار عبر الملف الابتدائي يحث تياراً في الملف الثانوي",
 "一次関数": "دَالَّة خَطِّيَّة (دالة رياضية يكون رسمها البياني (في الإحداثيات الديكارتية بمقاييس موحدة) خطاً مستوياً)",
 "一次電池": "خلية أولية, خلية جلفانية (خلية كهربائية تولد قوة دافعة كهربائية عن طريق تحويل غير عكسي للطاقة الكيميائية إلى طاقة كهربائية؛ ولا يمكن إعادة شحنها)",
 "一歩": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة\nمثال: もう一歩も歩けないよ。 — لا يمكنني المشي خطوة أخرى. / مُسْتَوًى / مَرْحَلَة",
 "一歩ずつ": "بشكل متدرج, خطوة بخطوة (المضي في خطوات) / تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)\nمثال: تم زيادة الجهد بشكل متدرج",
 "一歩一歩": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "一歳": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "一死": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "一段": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني. / عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "一毛": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "一毫": "بِت (انقطع؛ قَطَع)",
 "一気に": "فَجْأَةً",
 "一水": "تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "一決": "عَلَى وِفَاق, مُتَّفِق (متحد بالاتفاق في الرأي)",
 "一河の流れを汲むも他生の縁": "أمر غير محسوم, احتمالية متساوية (ظاهرة لا يمكن التنبؤ بها)\nمثال: إنه أمر غير محسوم ما إذا كان سيفوز أم يخسر",
 "一泡": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "一泡吹かせる": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "一泳ぎ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "一流": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "一流ホテル": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "一流企業": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "一流大学": "بشكل ممتاز, على ما يرام (بشكل جيد جداً) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "一渉り": "عُمُومًا / بِوَجْهٍ عَامّ",
 "一渡り": "عُمُومًا / بِوَجْهٍ عَامّ",
 "一溜まりもなく": "بِسُهُولَة",
 "一溜まりも無く": "بِسُهُولَة",
 "一点": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "一点張り": "إِلْحَاح",
 "一点機": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "一点突破": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "一片": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / إِيُوتَا / وَرَقَة, وَرَقة / صَحِيفَة",
 "一版": "طَبْعَة",
 "一物": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / قَضِيب, ذَكَر / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "一献": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "一理": "مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "一環": "وَصْلَة",
 "一生": "حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "一生を終える": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "一生消えない": "دَائِم",
 "一生涯": "حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "一生面": "اِبْتِكَار",
 "一男": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "一番": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء الشخصية أولاً) / الأول, رقم واحد (العنصر الأول في سلسلة قابلة للعد) / الأول, رقم واحد (الأول أو الأعلى في ترتيب أو سلسلة)\nمثال: الأول من الشهر / أَفْضَل / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية. / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "一番上": "في الأعلى (في أو إلى أعلى موضع) / في الصدارة, في المقدمة (في أو إلى الموضع الأبرز، كما في الذهن) / الأَعْلَى, فِي أَقْصَى القِمَّة (في القمة أو أقرب ما يكون إليها)\nمثال: اتجه النصل للأعلى",
 "一番手": "مُتَكَلِّم",
 "一番星": "نَجْمَة الْمَسَاء",
 "一番目": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "一番端": "زائدة, طرف (جزء خارجي من الجسم يبرز منه) / طرف قاصي (ذلك الجزء من الطرف الأبعد عن الجذع) / حد أقصى, طرف (المنطقة أو النقطة الخارجية أو الأبعد) / أقصى درجات, غاية (أعظم أو أقصى درجة)\nمثال: من المهم الحفاظ على دفء الأطراف",
 "一瘤駱駝": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "一癖": "صِفَة, شِيْمَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "一発": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة) / إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "一発かます": "أَخَافَ, أَرْعَبَ",
 "一発噛ます": "أَخَافَ, أَرْعَبَ",
 "一発屋": "فَقَّاعَة صابُون, نَجاح عابِر (شخص يحقق نجاحاً مؤقتاً سريعاً ثم يفشل) / كُلٌّ أَوْ لَا شَيْء (يحدث بالكامل أو لا يحدث على الإطلاق) / ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب) / ملاكم قوي اللكمات (ملاكم مشهور بقدرته على توجيه لكمات قوية)",
 "一発抜く": "قَذَفَ الْمَنْي (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "一発放つ": "ضَرَطَ",
 "一発芸": "نُكْتَة السَّطْر الْوَاحِد (نكتة مكونة من سطر واحد)",
 "一皮": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "一皮むける": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "一皮剥ける": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "一盃": "كوب, ملء كوب (الكمية التي يستوعبها كوب)\nمثال: شرب كوباً من القهوة / مُمْتَلِئ, مَلِيء / شِبَع, شبعان / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "一盛り": "كَوْم",
 "一目": "لمحة, نظرة خاطفة (نظرة سريعة) / مَنْظُور عَيْن الْطَائِر / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "一目ぼれ": "اَلْحُبّ مِن اَلنَّظْرَة اَلْأُولَى\nمثال: 一目惚れなの。 — كان حبًّا من أوّل نظرة.",
 "一目惚れ": "اَلْحُبّ مِن اَلنَّظْرَة اَلْأُولَى\nمثال: 一目惚れなの。 — كان حبًّا من أوّل نظرة.",
 "一目瞭然": "بَدِيهِيّ, بَدَهِيّ",
 "一直線": "خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم",
 "一眠り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "一着": "ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي",
 "一睡": "غَفَا / غَفْوَة",
 "一睡り": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "一瞥": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "一瞬": "لَحْظَة",
 "一瞬にして": "حالاً, على الفور (بدون أي تأخير) / الآن, حالاً (بدون تأخير أو تردد؛ بدون وقت فاصل)\nمثال: قُتل على الفور",
 "一瞬絶句": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "一瞬間": "عَزْم / لَحْظَة, دَقِيقَة",
 "一矢": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "一矢を報いる": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "一矢報いる": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "一神教": "تَوْحِيد",
 "一神論": "تَوْحِيد",
 "一種": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / إلى حد ما, نسبياً (إلى حد (كبير أو صغير) ما)\nمثال: كان الجو بارداً نوعاً ما",
 "一種独得": "فَرِيد, فَذّ",
 "一種独特": "فَرِيد, فَذّ",
 "一種異様": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "一稼ぎ": "كَسَبَ",
 "一穴": "حوض المرحاض (حوض المرحاض الذي يمكن شطفه بالماء)",
 "一突き": "طَعْن / طَعْنَة / طَعَنَ",
 "一端": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "一笑": "ضَحْكَة / ضَحِكَ, ضحك (أثار الضحك أو جعل شخصًا يضحك بشيء مضحك أو طريف؛ سلّى أو أبهج شخصًا بجعل الأجواء مرحة)\nمثال: ضحك الجميع علي.",
 "一筆": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى. / رِزْمَة, رُزْمَة",
 "一等": "بالدرجة الأولى (بواسطة وسائل نقل من الدرجة الأولى؛ مع إقامة من الدرجة الأولى) / درجة أولى (أغلى أماكن الإقامة على متن سفينة أو قطار أو طائرة) / درجة أولى (أعلى رتبة في التصنيف) / بريد الدرجة الأولى (بريد يشمل الرسائل والبطاقات البريدية والطرود المختومة ضد التفتيش)\nمثال: نسافر دائماً بالدرجة الأولى / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "一等兵": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "一等兵曹": "رئيس ضباط الصف (شخص يحمل أعلى رتبة لضابط صف بحري)",
 "一等国": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "一等最初": "أولاً, في المقام الأول (قبل أي شيء آخر)\nمثال: أولاً يجب أن نعتبر ثعبان الرباط",
 "一等海佐": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "一等空佐": "عَقِيد, زَعِيم",
 "一等空曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "一等航海士": "مساعد القبطان (الضابط الذي يلي القبطان في الرتبة على سفينة تجارية)",
 "一等賞": "ميدالية ذهبية (كأس مصنوعة من الذهب (أو لها مظهر الذهب) تمنح عادة للفائز بالمركز الأول في المسابقة)",
 "一等車": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "一等陸佐": "عَقِيد, زَعِيم",
 "一等陸士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "一等陸曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "一筋": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "一筋縄": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "一筋縞蚊": "بعوضة النمر الآسيوية (موطنها اليابان ومخططة، تزدهر في جنوب غرب ووسط غرب الولايات المتحدة وتنتشر إلى منطقة البحر الكاريبي؛ ناقل محتمل لأمراض خطيرة)",
 "一策": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "一箇": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء",
 "一節": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)",
 "一篇": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "一籌": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "一糸": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "一糸まとわぬ": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "一糸もまとわず": "بِلَا خَيْط وَاحِد (بدون أي ملابس على الإطلاق)",
 "一糸も纏わず": "بِلَا خَيْط وَاحِد (بدون أي ملابس على الإطلاق)",
 "一糸纏わぬ": "عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "一級": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "一級品": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "一統": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "一続き": "سِلْسِلَة",
 "一緒": "مَعًا, سَوِيًّا / نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "一緒くた": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة) / كعكة جامبل (كعكة أو بسكويت صغير مسطح على شكل حلقة) / خليط, ركام (مجموعة مشوشة من الأشياء)",
 "一緒に": "مَعًا, سَوِيًّا / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "一緒にする": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح. / أَرْبَكَ",
 "一緒になる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / تَزَوَّجَ",
 "一線": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / طَلِيعَة",
 "一線を退く": "تَقَاعَدَ / اِعْتَزَلَ",
 "一線級": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "一編": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "一縷": "قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما) / دَقِيقَة, شَظِيَّة (قطعة صغيرة رفيعة وحادة من الخشب أو الزجاج أو المعدن)\nمثال: دخلت شظية في إصبعه",
 "一繋がり": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "一纏": "إِبَالَة, حُزْمَة",
 "一纏め": "إِبَالَة, حُزْمَة",
 "一群": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "一群れ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "一義": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "一義的": "صريح, قاطع (لا يقبل الشك أو سوء الفهم؛ له معنى أو تفسير واحد فقط ويؤدي إلى استنتاج واحد فقط) / قَاطِع, لَا لَبْس فِيه (مُحَدَّد أو مُصَاغ بوضوح تام)\nمثال: دليل قاطع / رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "一羽": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "一翼": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "一考": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "一脈": "وَرِيد, عِرْق",
 "一腹": "مِحَفَّة / بَعْثَرَ / بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "一膳": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "一膳飯屋": "مطعم العربة (مطعم يشبه عربة الطعام) / عربة طعام (عربة ركاب يتم فيها تقديم الطعام أثناء النقل) / ضيف المطعم, متناول الطعام (شخص يتناول وجبة (خاصة في مطعم))",
 "一臂": "قَلِيلًا",
 "一致": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "一致ゲート": "تَطَابُق, عُنْصُر مُحَايِد (مؤثر يترك العنصر الذي يعمل عليه دون تغيير)\nمثال: المحايد في الضرب العددي هو 1",
 "一致判定": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "一致協力": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية.",
 "一致団結": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية.",
 "一致素子": "تَطَابُق, عُنْصُر مُحَايِد (مؤثر يترك العنصر الذي يعمل عليه دون تغيير)\nمثال: المحايد في الضرب العددي هو 1",
 "一致結束": "اتحاد, التقاء (عملية الانضمام معاً ككيان واحد) / اِجْتِمَاع, اِلْتِقَاء (الفعل الاجتماعي المتمثل في التجمع لغرض مشترك)\nمثال: حدث اندماج المجموعتين بسرعة",
 "一興": "تَسْلِيَة",
 "一舐め": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة / غِلَاف",
 "一般": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / عَادِيّ, مَأْلُوف / نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "一般に": "عُمُومًا / بِوَجْهٍ عَامّ",
 "一般化": "تَعْمِيم",
 "一般医": "طَبِيب عَامّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "一般名詞": "اِسْم الجِنْس (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "一般向き": "مَحْبُوب",
 "一般大衆": "عَامَّة اَلنَّاس",
