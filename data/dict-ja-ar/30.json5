 "作用機序": "آلية عمل, حركة (الجزء التشغيلي الذي ينقل الطاقة إلى آلية)\nمثال: كان للبيانو حركة صلبة جداً",
 "作用素": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "作用角": "مُدَّة",
 "作男": "مُسْتَأْجِر",
 "作略": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "作者": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "作者不明": "مَجْهُول",
 "作者未詳": "مَجْهُول",
 "作興": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "作製": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا.",
 "作詞家": "كاتب كلمات الأغاني, مؤلف الأغاني (شخص يكتب كلمات الأغاني)",
 "作詞者": "كاتب كلمات الأغاني, مؤلف الأغاني (شخص يكتب كلمات الأغاني)",
 "作詩": "عروض, نظم الشعر (فن أو ممارسة كتابة الشعر) / عروض, نظم (الشكل أو التركيب المتري للقصيدة) / نظم شعري (اقتباس موزون لشيء ما (على سبيل المثال، لنص نثري))",
 "作詩法": "عروض, نظم الشعر (فن أو ممارسة كتابة الشعر) / عروض, نظم (الشكل أو التركيب المتري للقصيدة) / نظم شعري (اقتباس موزون لشيء ما (على سبيل المثال، لنص نثري))",
 "作話": "اختلاق الذاكرة, تخريف ((في الطب النفسي) ذكرى معقولة ولكنها متخيلة تملأ الفجوات فيما يتم تذكره) / حديث ودي, دردشة (محادثة غير رسمية)",
 "作譜": "خَشَبَة",
 "作風": "أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "佝僂": "كُسَاح / أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري)",
 "佞": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "佞む": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / زَنَى (مَارَسَ الزِّنَى)",
 "佞人": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "佞奸": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "佞姦": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "佞弁": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "佞悪": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "佞智": "خديعة, دهاء (صفة الدهاء والمكر) / خبث, خديعة (الدهاء الذي يظهر من خلال المهارة في الخداع)",
 "佞臣": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "你好": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "佩用": "ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي",
 "佰": "مِٱئَة, مِئَة",
 "佳": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "佳き": "خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / خَيْر, صَلَاح ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض)\nمثال: يبدو زيري بخير. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "佳人": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "佳例": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "佳品": "تُحْفَة, رَائِعَة",
 "佳境": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "佳日": "نَهَارَك سَعِيد, مَسَاء اَلْخَيْر",
 "佳肴": "خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها",
 "佳良": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "佳言": "أخبار سارة, بشارة (أخبار جيدة) / تزكية, توصية (شيء يوصي (أو يعبر عن الثناء على) شخص أو شيء على أنه جدير أو مرغوب فيه)",
 "佳話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "佳賞": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "佳麗": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "併せて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار / إِضَافَةً عَلى ذٰلِكَ",
 "併せる": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "併催": "مُشْتَرَك / مِفْصَل",
 "併合": "اِنْدِمَاج",
 "併呑": "ضَمّ, إِلْحَاق (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "併存": "تَعَايُش",
 "併殺": "إخراج مزدوج, لعبة مزدوجة (فعل إخراج لاعبين اثنين في لعبة واحدة)",
 "併発": "تَزَامُن, تَوَافُق (العمل معاً، كوكلاء أو ظروف أو أحداث) / تزامن, تصادف (الخاصية الزمنية لحدوث شيئين في نفس الوقت) / تزامن, توافق (اتفاق النتائج أو الآراء) / تلاقى الأفكار, توافق (حالة من التعاون)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "併発症": "تَعْقِيد / مُضَاعَفَة",
 "併結": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر) / قارنة, وصلة (جهاز ميكانيكي يعمل على توصيل نهايات الأجسام المتجاورة) / مقرن, وصلة ربط (وصلة (مثل المشبك أو الملزمة) بين شيئين بحيث يتحركان معاً)\nمثال: الاقتران العرضي للمراهقين",
 "併置": "مجاورة, مقارنة (فعل التموضع بالقرب (أو جنباً إلى جنب)) / تجاور (موضع جنباً إلى جنب)\nمثال: إنه نتيجة تجاور الألوان المتباينة",
 "併設": "مجاورة, مقارنة (فعل التموضع بالقرب (أو جنباً إلى جنب)) / تجاور (موضع جنباً إلى جنب)\nمثال: إنه نتيجة تجاور الألوان المتباينة",
 "佶屈": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى) / غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب) / غير مفهوم, مبهم (ملفوظ أو منطوق بشكل سيء، أو طغت عليه الضوضاء)\nمثال: كلام غير مفهوم / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب",
 "使": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "使い": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية) / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة) / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使いかって": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "使いがって": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "使いきる": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "使いこなす": "مِقْبَض",
 "使いこむ": "غَلَّ, اِخْتَلَسَ",
 "使いすぎ": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "使いっぱ": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "使いっ走り": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "使いどころ": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使いの者": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "使い出す": "جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "使い切り": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "使い切る": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "使い勝手": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "使い古し": "بَالٍ",
 "使い慣らす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "使い所": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使い手": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / مُسْرِف",
 "使い捨": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "使い捨て": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز) / مَنْشُور, نَشْرَة إِعْلَانِيَّة (إعلان (عادة ما يطبع على صفحة أو في نشرة) معد للتوزيع على نطاق واسع) / طفل شوارع, متشرد ((أحياناً مهين) صبي بلا مأوى تم التخلي عنه ويجوب الشوارع)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "使い料": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使い方": "اِسْتِخْدَام / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "使い歩き": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "使い残し": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "使い残り": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "使い物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "使い物にならない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "使い番": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "使い走り": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "使い込み": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "使い込む": "غَلَّ, اِخْتَلَسَ",
 "使い過ぎ": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "使い道": "هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف.",
 "使い頃": "فِي مُتَنَاوَل اليَد, قَرِيب (سهل الوصول إليه وقريب) / صَنَاعِيّ, مَاهِر اليَدَيْن (ماهر في العمل اليدوي) / عَمَلِيّ, مُفِيدٌ وَمُلَائِم (مُفِيدٌ وَمُرِيح)",
 "使い魔": "روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة)",
 "使う": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使わす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / أَنْعَمَ",
 "使丁": "خَادِم, خَادِمَة",
 "使令": "خَادِم, خَادِمَة",
 "使命": "مُهِمَّة, مَأْمُورِيَّة / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "使命感": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "使命者": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "使嗾": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "使女": "خادمة (عاملة منزلية)",
 "使役": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟ / عِلِّيّ, مُسَبِّب (ينتج تأثيراً)\nمثال: الفقر كعامل مسبب للجريمة",
 "使役動物": "حيوان جر (حيوان يستخدم لسحب الأحمال الثقيلة)",
 "使役犬": "كلب عمل (أي من عدة سلالات من الكلاب القوية الكبيرة عادة التي يتم تربيتها للعمل كحيوانات جر وكلاب حراسة وإرشاد)",
 "使徒": "رَسُول (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "使徒承伝": "خِلَافَة رَسُولِيَّة, تَسَلْسُل رَسُولِيّ",
 "使徒継承": "خِلَافَة رَسُولِيَّة, تَسَلْسُل رَسُولِيّ",
 "使徒行伝": "أَعْمَال الرُّسُل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "使徒言行録": "أَعْمَال الرُّسُل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "使用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使用不可": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "使用中": "قَيْدَ الاِسْتِخْدَام (يُسْتَخْدَمُ حَالِيًّا)",
 "使用人": "مُوَظَّف, مُوَظَّفَة",
 "使用可能": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "使用可能性": "تَوَفُّر",
 "使用域": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "使用感": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)",
 "使用料": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "使用方法": "إرشادات",
 "使用期限": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "使用条件": "ضَرُورَة / مَطْلَب, طَلَب",
 "使用権": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "使用法": "إرشادات",
 "使用済み": "مُسْتَعْمَل (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "使用済み燃料プール": "عامل الحماية من الشمس (الدرجة التي يحمي بها واقي الشمس البشرة من أشعة الشمس المباشرة)",
 "使用率": "مُعَدَّل الإِشْغَال (النسبة المئوية لجميع الوحدات المؤجرة (كما في الفنادق) التي تكون مشغولة أو مؤجرة في وقت معين)",
 "使用者": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "使用許可": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "使用量": "اِسْتِخْدَام",
