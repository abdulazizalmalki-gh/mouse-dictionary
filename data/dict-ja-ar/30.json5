 "伊邪那美命": "إِزَانَامِي",
 "伍": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / سَرِيَّة / شَرِكَة / فرقة جنود (مجموعة من الجنود) / سرية خيالة (وحدة سلاح الفرسان المقابلة لسرية المشاة) / سرب, فوج (حشد منظم) / فرقة كشافة (وحدة من الكشافة)\nمثال: فوج من الأطفال",
 "伍つ": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / اَلسَّاعَة اَلثَّامِنَة",
 "伍長": "ذُو كَيَان, مُتَجَسِّد (يَمْتَلِكُ أَوْ يُوجَدُ فِي شَكْلٍ جَسَدِيّ) / بَدَنِيّ, جَسَدِيّ (يؤثّر في الجسم أو يتّصف به بخلاف العقل أو الروح) / عريف (ضابط صف في الجيش أو القوات الجوية أو المارينز)",
 "伎女": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "伎芸": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "伏して": "بتواضع (بطريقة متواضعة) / ببخل, بتقتير (بطريقة بخيلة)\nمثال: خفض رأسه بتواضع",
 "伏し浮き": "طفو الميت (وضع طفو مع الوجه لأسفل والذراعين ممدودتين للأمام)",
 "伏す": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / قَلَبَ / أَخْفَى",
 "伏する": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم) / أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "伏せる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / قَلَبَ / أَخْفَى / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "伏せ勢": "كَمين / كَمِين",
 "伏せ字": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "伏せ屋": "كُوخ, تَخْشِيبَة",
 "伏せ籠": "قُنّ, خُمّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "伏せ長": "ذهاب, رحيل (فعل المغادرة) / تقدم, سير الأمور (التقدم نحو هدف ما) / رحيل, فقدان (تعبيرات ملطفة للموت)\nمثال: كان إقناعه أمراً سهلاً",
 "伏兎": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "伏兵": "كَمين / كَمِين",
 "伏勢": "كَمين / كَمِين",
 "伏在静脈": "وريد صافن (أي من وريدين سطحيين رئيسيين في الساق يصرفان الدم من القدم)",
 "伏字": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "伏屋": "كُوخ, تَخْشِيبَة",
 "伏撃": "كَمين / كَمِين",
 "伏線": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح) / إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً) / تَحْضِير, إِعْدَاد",
 "伏角": "غَمَس / غَمَر (الغَمْرُ: الماء الكثير؛ الغَمْرُ من الماء: خِلاف الضَّحْل، وهو الذي يعلو مَن يدخله ويغطِّيه، وفي الحديث) / غَطَسَ",
 "伏貝": "قلب المحار, كوكل (رخوي ذو صدفتين أوروبي شائع صالح للأكل وحفار له صدفة قوية مستديرة ذات أضلاع مشعة) / بكلويز, كوكل (ذوات الصدفتين الأوروبية الصالحة للأكل والشائعة)",
 "伏長": "ذهاب, رحيل (فعل المغادرة) / تقدم, سير الأمور (التقدم نحو هدف ما) / رحيل, فقدان (تعبيرات ملطفة للموت)\nمثال: كان إقناعه أمراً سهلاً",
 "伏魔殿": "بُؤْرَة",
 "伐つ": "حَمْلَة / هَاجَمَ",
 "伐倒": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "伐採": "حطابة, قطع الأشجار (عمل قطع الأشجار للحصول على الأخشاب)",
 "伐木": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "休す": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "休する": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "休ませる": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "休まる": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / راحة بال, سلام (غياب التوتر العقلي أو القلق)\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "休み": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / عُطْلَة, إِجَازَة / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / سبات, سكون (حالة من الخمول الهادئ (ولكن ربما المؤقت))\nمثال: ثار البركان بعد قرون من الخمول",
 "休みどころ": "اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "休みなく": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "休み中": "مُغْلَق",
 "休み所": "اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "休み時間": "رَدْب",
 "休み無く": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "休む": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / تَقَاعَدَ / اِعْتَزَلَ",
 "休める": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "休らい": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / مُتَحَيِّر, مُتَرَدِّد (يفتقر إلى حسم الشخصية؛ عاجز عن الفعل أو القرار بسرعة أو حزم)",
 "休らう": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "休会": "رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / تأجيل, رفع الجلسة (فعل التأجيل إلى وقت أو مكان آخر)",
 "休場": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / غِيَاب / عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "休心": "سَكِينَة, طُمَأْنِينَة",
 "休怠": "كَسَل",
 "休息": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "休息所": "رَدْهَة",
 "休息時間": "رَدْب",
 "休意": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "休憩": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "休憩室": "صَالَة, قَاعَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "休憩所": "اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "休憩時間": "استراحة, راحة (توقف للاسترخاء)\nمثال: ينجز الناس في الواقع المزيد عندما يأخذون وقتاً لراحات قصيرة",
 "休戚": "رَفَاهَة, خَيْر",
 "休戦": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "休戦協定": "هدنة, وقف إطلاق النار (حالة سلام يتفق عليها الخصوم حتى يتمكنوا من مناقشة شروط السلام)",
 "休戦地帯": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "休戦記念日": "11 نوفمبر, يوم المحاربين القدامى (عطلة قانونية في الولايات المتحدة؛ كانت تسمى سابقًا يوم الهدنة ولكن سميت يوم المحاربين القدامى منذ عام 1954)",
 "休日": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "休暇": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
