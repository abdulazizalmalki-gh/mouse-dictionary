 "世界各地": "جَمِيع أَنْحَاء, كُلّ",
 "世界地図": "خَرِيطَةُ الْعَالَمِ (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "世界基督教統一神霊協会": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر…)",
 "世界大恐慌": "الْكَسَاد الْعَظِيم",
 "世界大戦": "حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "世界平和連合": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر…)",
 "世界征服": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "世界性": "شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان)",
 "世界恐慌": "الْكَسَاد الْعَظِيم",
 "世界情勢": "شؤون دولية, شؤون عالمية (الشؤون بين الأمم)\nمثال: لا يمكنك حقاً مواكبة الشؤون العالمية من خلال مشاهدة التلفزيون",
 "世界教会協議会": "مجلس الكنائس العالمي (منظمة مسكونية للكنائس البروتستانتية والشرقية؛ تهدف إلى تعزيز الوحدة والتعاون في…)",
 "世界教会運動": "الحركة المسكونية (حركة تهدف إلى تعزيز التفاهم والتعاون بين الكنائس المسيحية؛ تهدف في النهاية إلى…)",
 "世界新": "الْعَالَم الْجَدِيد",
 "世界新記録": "الْعَالَم الْجَدِيد",
 "世界時": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "世界比較教育学会": "مجلس عالمي (مجلس يضم ممثلين من دول مختلفة)",
 "世界気象機関": "المنظمة العالمية للأرصاد الجوية (وكالة الأمم المتحدة المعنية بالجمع الدولي لبيانات الأرصاد الجوية)",
 "世界産業労働組合": "عمال الصناعة في العالم (نقابة عمالية دولية سابقة وحركة عمالية راديكالية في الولايات المتحدة؛ تأسست في…)",
 "世界的": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ / أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "世界秩序": "نِظَام عَالَمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "世界線": "عَالَم مُوَازِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世界観": "رُؤْيَةٌ كَوْنِيَّة, رُؤْيَةُ الْعَالَم / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "世界記録": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
 "世界記録保持者": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
 "世界語": "لغة مساعدة دولية (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)",
 "世界貿易機関": "مُنَظَّمَة اَلتِّجَارَة اَلْعَالَمِيَّة",
 "世界銀行": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات…)",
 "世界銀行東京事務所": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات…)",
 "世相": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "世知": "إقدام, عزيمة (الثبات والتصميم)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "世知辛い": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "世系": "نُزُول / شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "世紀": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة…)\nمثال: هذه الشجرة عمرها أكثر من قرن. / حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "世紀末": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "世紀末的": "مُتَرَفّ, مُنْحَطّ (مُنغمس في التنعّم والتدليل بإسراف)",
 "世継": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世継ぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世襲": "إرث جيني, وراثة (مجموع الصفات الموروثة)",
 "世襲的": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث)",
 "世襲財産": "إرث, ميراث (الخلافة الوراثية للقب أو منصب أو ممتلكات)\nمثال: كان ميراثي الوحيد بركة أمي",
 "世評": "سُمْعَة, شُهْرَة",
 "世話": "اِهْتِمَام / مُشْكِلَة, مَتاعِب / تَوْصِيَة / حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "世話がない": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "世話のやける": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "世話の焼ける": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "世話をする": "تَوَخَّى اَلْحِذْر",
 "世話をやく": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / أزْعَجَ",
 "世話を焼く": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / أزْعَجَ",
 "世話人": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر. / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "世話係": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "世話係り": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "世話役": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "世話焼": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "世話焼き": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "世論": "رَأْي عَامّ",
 "世論調査": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "世諺": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "世路": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
