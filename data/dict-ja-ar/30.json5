 "上層雲": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه)",
 "上山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "上州": "غُونْمَا",
 "上帝": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "上席": "أقدمية, طول العمر (خاصية العيش طويلاً)",
 "上底": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "上座部": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال…)",
 "上座部仏教": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال…)",
 "上弦": "التربيع الأوّل, التربيع المتزايد",
 "上弦の月": "التربيع الأوّل, التربيع المتزايد",
 "上張り": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "上役": "أعلى مرتبة, رئيس (شخص ذو رتبة أو مكانة أو جودة أعلى)",
 "上後鋸筋": "منشارية خلفية علوية (عضلة رباعية رقيقة في الجزء العلوي والظهري من الصدر؛ تعمل على رفع الأضلاع العلوية)",
 "上御一人": "قَيْصَر, إِمْبْرَاطُور",
 "上忍": "عَالِيّ الرُتْبَة",
 "上意": "إرَادَة",
 "上意下達": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "上意討ち": "تَنْفِيذ\nمثال: محكم عليه بالإعدام.",
 "上戸": "شَارِب / مِرْوَحَة, مروحة",
 "上手": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق) / يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور) / مَاهِر, حَاذِق",
 "上手い": "مَاهِر, حَاذِق / لَذِيذ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "上手い具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "上手く": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "上手をいく": "فَاقَ, تَجَاوَزَ",
 "上手を行く": "فَاقَ, تَجَاوَزَ",
 "上手者": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "上拍": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "上振れ": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上掛": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / مِعْطَف فَضْفَاض",
 "上掛け": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / مِعْطَف فَضْفَاض / مِنَ الدَّرَجَة الأُولَى (ممتاز؛ أفضل ما يمكن)",
 "上掲": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上提": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي.",
 "上敷": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "上敷き": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
