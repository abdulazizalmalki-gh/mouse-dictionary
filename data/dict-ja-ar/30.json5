 "下請会社": "مقاول",
 "下請負": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "下貼り": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "下賎": "مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة)",
 "下賜": "مَنَحَ / مِنْحة",
 "下賤": "مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة)",
 "下足": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "下輩": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "下辺": "مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "下道": "مجاني (لا تفرض عليه رسوم استخدام)\nمثال: طريق مجاني",
 "下郎": "خَادِم, خَادِمَة",
 "下郎言葉": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "下部": "أساس (أدنى دعامة لهيكل ما) / أساس, بنية تحتية (الهيكل الأساسي أو ميزات نظام أو منظمة)\nمثال: بُني على أساس من الصخر الصلب / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / خَادِم, خَادِمَة",
 "下部構造": "أساس (أدنى دعامة لهيكل ما) / أساس, بنية تحتية (الهيكل الأساسي أو ميزات نظام أو منظمة)\nمثال: بُني على أساس من الصخر الصلب",
 "下部組織": "أساس (أدنى دعامة لهيكل ما) / أساس, بنية تحتية (الهيكل الأساسي أو ميزات نظام أو منظمة)\nمثال: بُني على أساس من الصخر الصلب",
 "下野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下関": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "下降": "نُزُول / اَصْل",
 "下降期": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "下降気流": "تيار هابط (تيار هوائي هابط قوي)",
 "下限": "حد جنوبي, حد سفلي (الحد الموجود على الجانب السفلي (أو الجنوبي) لشيء ما) / حد أدنى (أصغر كمية ممكنة)",
 "下限価格": "حد أدنى للسعر (أرضية لا يُسمح للأسعار بالانخفاض دونها)\nمثال: استخدمت الحكومة دعم الأسعار للحفاظ على الحد الأدنى للسعر",
 "下院": "مَجْلِس أَدْنَى",
 "下院議": "مَجْلِس أَدْنَى",
 "下院議員": "عضو كونغرس (عضو ذكر في مجلس النواب الأمريكي)",
 "下面": "أسفل, جانب سفلي (الجانب السفلي من أي شيء)",
 "下面発酵": "تخمر سفلي (نوع بطيء من التخمر الكحولي في درجة حرارة منخفضة بما يكفي لغرق خلايا الخميرة في قاع السائل المتخمر؛ يستخدم في إنتاج جعة اللاغر)",
 "下須崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下顎": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "下顎骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "下馬": "تَرَجَّل (تَرَجَّلَ: نَزَلَ من مَرْكُوبه؛ تَرَجَّلَت المرأةُ: اسْتَرْجَلَت)",
 "下馬評": "إِشَاعَة, شَائِعَة",
 "下馴し": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "下駄": "حذاء خشبي, قبقاب (حذاء عادة ما يكون نعله خشبياً) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / شَبَكَة, شبكة",
 "下駄の雪": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "下駄を履かせる": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "下駄履き": "طائرة طافية, طائرة عائمة (طائرة مائية مجهزة بعوامات للهبوط أو الإقلاع من الماء)",
 "下魚": "مُنْخَفِض الدَّرَجَة",
 "不コ本": "مُسْتَحِيل / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني)",
 "不一": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "不一致": "تَضَارُب, تَنَاقُض",
 "不世出": "نَادِر",
 "不乙": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "不乱": "اتزان, رباطة جأش (ثبات العقل تحت الضغط)",
 "不了簡": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "不了見": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "不予": "تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه",
 "不二": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "不人情": "فَظَاظَة, قَسْوَة (الافتقار إلى التعاطف)",
 "不人気": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "不仁": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين)",
 "不介入": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "不仲": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "不似合": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "不似合い": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "不体裁": "خدش للحياء, فعل غير لائق (فعل غير لائق أو خادش للحياء) / خدش للحياء, فحش (جودة كون الشيء غير محتشم)",
 "不作": "فشل المحصول (فشل المحاصيل في إنتاج فائض قابل للتسويق) / جودة منخفضة, دونية (جودة متدنية)",
 "不作法": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "不作法者": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "不作為": "حِلْم (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "不使用": "إهمال, عدم استخدام (حالة الشيء الذي لم يستخدم وتم إهماله)\nمثال: كان المنزل في حالة إهمال رهيبة",
 "不例": "تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه",
 "不侵略": "عدم الاعتداء (سياسة عدم البدء بالأعمال العدائية)\nمثال: وقعوا ميثاق عدم اعتداء",
 "不便": "إزعاج, إقلاق (صعوبة تسبب القلق) / إِزْعَاج, عَدَم رَاحَة (صفة كون الشيء غير مفيد أو غير مريح) / إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "不信": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين) / توجس, ريبة (شك في نزاهة شخص ما) / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "不信仰": "جحود, عدم إيمان (رفض الاعتقاد أو الإيمان)",
 "不信実": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "不信心": "جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "不信感": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين) / توجس, ريبة (شك في نزاهة شخص ما)",
 "不信用": "ارتياب, عدم ثقة (سمة عدم الثقة في الآخرين) / توجس, ريبة (شك في نزاهة شخص ما)",
 "不信義": "تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "不倒": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ) / عَصِيٌّ عَلَى الهَزِيمَة, لَا يُقْهَر (يصعب التغلّب عليه أو هزيمته)",
 "不倒翁": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض) / قدح, كوب (كوب ذو قاع مسطح ولكن بدون مقبض أو ساق) / ريشة القفل (عائق متحرك في القفل يجب ضبطه على وضع معين (كما بواسطة مفتاح) قبل التمكن من تحريك اللسان) / بهلوان شقلبة (لاعب جمباز يؤدي دحرجات وشقلبات والتواءات)",
 "不倫": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "不倫相手": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "不倫罪": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "不倶戴天": "لا يمكن التوفيق بينه (مستحيل التوفيق بينه)\nمثال: خلافات لا يمكن التوفيق بينها",
 "不倶戴天の敵": "عدو لدود (عدو يريد قتلك)",
 "不偏": "نَزَاهَة, حِيَاد",
 "不偏不党": "نَزَاهَة, حِيَاد",
 "不健全": "مَرْضِيّ",
 "不健康": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "不備": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "不充分": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "不党": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "不全": "جُزْئِيّ",
 "不全骨折": "كسر غير كامل (كسر لا يمتد عبر كامل عرض العظم)",
 "不公平": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "不公正": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "不具": "تَشَوُّه شَكْلِيّ",
 "不具合": "عَيْبٌ / غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "不具者": "ذو احتياجات خاصة, معاق (شخص لديه حالة تحد بشكل ملحوظ من قدرته على العمل جسدياً أو عقلياً أو اجتماعياً)",
 "不凍": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "不凍剤": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "不凍海": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "不凍液": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "不凍港": "خَالٍ مِنَ الجَلِيد (خَالٍ مِنَ الجَلِيد وَمَفْتُوح لِلْمُلَاحَة)",
 "不凡": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "不出": "حراسة, حفظ (مسؤولية الوصي أو الحارس)\nمثال: ترك سيارته في حفظي",
 "不出来": "خطأ فادح, زلة (خطأ محرج)",
 "不分割": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "不分明": "مُظْلِم",
 "不利": "سَيِّئَة",
 "不利益": "سَيِّئَة",
 "不労": "غير مستحق, غير مكتسب (لم يتم الحصول عليه عن طريق الجدارة أو العمل أو الخدمة)\nمثال: قبل المكافآت غير المكتسبة التي جاءت في طريقه وكذلك النقد غير المستحق",
 "不労所得": "إيراد غير مكتسب ((محاسبة) دخل تم استلامه ولكن لم يتم اكتسابه بعد (يعتبر عادة التزاماً حالياً في الميزانية العمومية للشركة)) / دخل غير مكتسب (دخل شخصي لم تكسبه (على سبيل المثال، أرباح الأسهم أو الفوائد أو دخل الإيجار))",
 "不勉強": "بطالة, تسكع (عدم القيام بعمل أو وظيفة) / بطالة, تراخ (سمة كون المرء عاطلاً بسبب العزوف عن العمل) / بُطْلَان, لَا أَسَاس (صفة الافتقار إلى الجوهر أو القيمة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "不動": "رَاسِخ, غَيْرُ قَابِلٍ لِلتَّحْرِيك (لَا يُمْكِنُ تَحْرِيكُهُ أَوْ لَا يُقْصَدُ بِهِ أَنْ يُنْقَل) / أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "不動の動者": "السبب الأول, المحرك الأول (عامل هو سبب كل الأشياء ولكن ليس له سبب في حد ذاته)\nمثال: الله هو السبب الأول",
 "不動心": "برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: أدى برباطة جأش المخضرمين",
 "不動産": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産会社": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産保険": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産取得税": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産屋": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "不動産担保証券": "ورقة مالية مدعومة بالرهن العقاري (ورقة مالية تنشأ عند تجميع مجموعة من القروض العقارية وبيع السندات لمؤسسات أخرى أو للجمهور؛ يتلقى المستثمرون جزءاً من مدفوعات الفائدة على القروض…)",
 "不動産業": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産業界": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産業者": "سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "不動産登記": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産登記法": "أملاك عقارية, عقار (ممتلكات تتكون من منازل وأراضٍ)",
 "不動産鑑定": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産開発": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不動産開発業者": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "不勝手": "إزعاج, إقلاق (صعوبة تسبب القلق) / إِزْعَاج, عَدَم رَاحَة (صفة كون الشيء غير مفيد أو غير مريح) / إزعاج, عدم ملاءمة (انزعاج غير مريح)",
 "不勢": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "不十分": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "不協和": "تنافر, نشاز (أصوات غير متوافقة أو مزعجة) / ضجيج, ضوضاء (التجربة السمعية لصوت يفتقر إلى الجودة الموسيقية؛ صوت يمثل تجربة سمعية مزعجة) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: الموسيقى الحديثة مجرد ضجيج بالنسبة لي",
 "不協和音": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "不即不離": "مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "不参": "غِيَاب",
 "不参加": "عَدَم الاِنْخِرَاط, عَدَم المُشَارَكَة (الانسحاب من أنشطة المجموعة)",
 "不可": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "不可侵": "عدم الاعتداء (سياسة عدم البدء بالأعمال العدائية)\nمثال: وقعوا ميثاق عدم اعتداء",
 "不可入性": "اسْتِعْصَاء, عَمَايَة (عدم القدرة على الفهم بسبب الكثافة الشديدة للمعلومات أو التعقيد) / حَصَانَة, كَتَامَة (صفة كون الشيء غير قابل للاختراق (من قبل الناس أو الضوء أو القذائف وما إلى ذلك))",
 "不可分": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)\nمثال: 健康は運動と節制と不可分の関係にある。 — الصحة الجيدة لا يمكن فصل العلاقة بينها وبين الرياضة والاعتدال في كل شيء.",
 "不可得": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "不可思議": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا. / غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل) / سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / عميق جداً, لا يسبر غوره (عن العمق؛ غير قادر على أن يسبر أو يقاس)",
 "不可抗力": "قضاء وقدر, قوة قاهرة (كارثة طبيعية لا مفر منها تقطع المسار المتوقع للأحداث)\nمثال: اكتشف أن منزله لم يكن مؤمناً ضد القضاء والقدر / قوة قاهرة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "不可欠": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه) / ضروري, لا غنى عنه (لا يمكن الاستغناء عنه؛ أساسي) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "不可欠アミノ酸": "حمض أميني أساسي (حمض أميني تحتاجه الحيوانات ولكن لا يمكنها تصنيعه؛ يجب توفيره في النظام الغذائي)",
 "不可知": "غير قابل للمعرفة, مستعصٍ على المعرفة (لا يمكن معرفته)\nمثال: أسرار الحياة التي لا يمكن معرفتها",
 "不可知的": "لَاأَدْرِيّ",
 "不可知論": "لَاأَدْرِيَّة",
 "不可知論者": "لَاأَدْرِيّ",
 "不可算名詞": "اسم الجنس, اسم غير معدود (اسم لا يُجمع عادة)",
 "不可能": "مُسْتَحِيل",
 "不可能事": "مُسْتَحِيل",
 "不可能性": "مُسْتَحِيل",
 "不可視": "خفاء, عدم المرئية (صفة عدم إمكانية الإدراك بالعين)",
 "不可解": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "不可触民": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "不可触賎民": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "不可触賤民": "بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه) / لَا يُمَسّ, مَنْبُوذ (ينتمي إلى أدنى طبقة في المعتقد الهندوسيّ التقليديّ ويُعَدّ نجساً) / لَا يُمَسّ, مَحْظُور اللَّمْس (ممنوع لمسه أو الاقتراب منه) / لَا يُمَسّ, لَا يُنَال (يَسْتَحِيلُ الاِعْتِدَاءُ عَلَيْه)",
 "不可誤": "عِصْمَة",
 "不可逆": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "不可逆的": "غير قابل للعكس, لا رجعة فيه (لا يمكن عكسه)\nمثال: زخم لا رجعة فيه نحو الثورة",
 "不可避": "حَتْمِيّ",
 "不合格": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不合格品": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "不合理": "غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه) / أصم, غير نسبي (حقيقي ولكن لا يمكن التعبير عنه كحاصل قسمة عددين صحيحين) / عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))\nمثال: مخاوف غير عقلانية",
 "不合理推論": "مغالطة لا يتبع ((منطق) استنتاج لا يتبع من المقدمات) / استنتاج غير منطقي, كلام غير مترابط (رد ليس له صلة بما سبقه)",
 "不合理結論": "مغالطة لا يتبع ((منطق) استنتاج لا يتبع من المقدمات) / استنتاج غير منطقي, كلام غير مترابط (رد ليس له صلة بما سبقه)",
 "不吉": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "不同": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "不同意": "تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / خلاف, عدم اتفاق (الفعل الكلامي المتمثل في الاختلاف أو الجدال أو النزاع) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)\nمثال: تباين متزايد في الآراء",
 "不名誉": "خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار",
 "不名誉除隊": "تسريح غير مشرف, طرد من الخدمة (تسريح من القوات المسلحة بسبب جريمة خطيرة (مثل التخريب أو التجسس أو الجبن أو القتل))",
 "不向き": "غير لائق بدنياً, معتل (ليس في حالة جسدية أو عقلية جيدة؛ فاقد للياقة) / غير صالح, غير لائق (دون المعايير المطلوبة لغرض ما) / سَقيم, مَعيب (غَيْر سَليم جَسَدِيًّا؛ مُصاب بِعِلَّة)\nمثال: سمين وغير لائق بدنياً جداً",
 "不告知": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "不味": "كراهية, نفور (شعور بالكراهية الشديدة)",
 "不味い": "سَيِّئ, وحش / فَقِير / مِسْكِين / فُقَرَاء / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "不味る": "خطأ فادح, زلة (خطأ محرج)",
 "不和": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "不和反目": "إِقْطَاعَة",
 "不品行": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不問": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "不問に付す": "تَجَاهَلَ, طَنَّش",
 "不問に付する": "تَجَاهَلَ, طَنَّش",
 "不善": "شِرِّير, شَرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ) / شَرّ, سَوْء (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف) / شَرّ (ضد الخَيْر؛ السوء والفساد والرذائل والخطايا وقيل الشرّ يضم كل الرذائل؛ اسم تفضيل، الأكثر شَرّا، أصله أشرّ وحذفت الألف)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "不器": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / حرج, خرق (هيئة شخص تكون حركاته ووضعيته غير رشيقة أو غير أنيقة) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب)",
 "不器用": "أَخْرَق / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "不器用者": "أخرق, فاشل (شخص يرتكب أخطاء بسبب عدم الكفاءة)",
 "不器量": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "不在": "غِيَاب / إِهْمال",
 "不在着信": "مُكَالِمَةٌ فَائِتَةٌ",
 "不在者": "غائب (شخص غائب أو غير مقيم)",
 "不在者投票": "ورقة اقتراع غيابي ((في الانتخابات) ورقة اقتراع يتم الإدلاء بها أثناء الغياب (عادة ما ترسل بالبريد قبل يوم الانتخابات))",
 "不在証明": "دَفْع بِالْغَائِبَة, حُجَّة غِيَاب (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: دفع زيري الثمن.",
 "不均一": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم) / غير متجانس, متباين (يتكون من عناصر ليست من نفس النوع أو الطبيعة)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "不均斉": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不均等": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "不均衡": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "不均質": "خَارِجِيّ المَنْشَأ, غَيْر مُتَجَانِس (ناشئ خارج الجسم) / غير متجانس, متباين (يتكون من عناصر ليست من نفس النوع أو الطبيعة)\nمثال: سكان الولايات المتحدة شاسعون وغير متجانسين",
 "不均質性": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "不埒": "فَوْضَوِيّ, لَا قَانُونِيّ (بِلَا قَانُونٍ أَوْ سَيْطَرَة) / خَارِج عَن القَانُون, فَوْضَوِيّ (عاصٍ للقانون أو متمرّد عليه) / بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين)",
 "不埒千万": "مَذْمُوم, مُسْتَنْكَر (يستحقّ التوبيخ أو اللوم الشديد)",
 "不埒者": "فَاسِق",
 "不堪": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "不壊": "عدم قابلية التدمير (القوة لمقاومة الدمار)",
 "不変": "أَبَدِيّ\nمثال: これ不変の真理なり。 — هذه حقيقة لا تتغير. / ثَابِت, لَا يَتَغَيَّر (لَا يَتَبَدَّلُ فِي طَبِيعَتِه) / ثَابِتٌ تَحْتَ التَّحْوِيل, مُطَّرِد (غَيْرُ مُتَأَثِّرٍ بِعَمَلِيَّةٍ أَوْ تَحْوِيلٍ مُحَدَّد) / ثابت, لامتغير (سمة (كمية أو خاصية أو دالة) تظل دون تغيير عند تطبيق تحويل معين عليها)",
 "不変化": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "不変化詞": "مَبْنِيٌّ, غَيْرُ مُتَمَكِّنٍ",
 "不変性": "ثَبَات, لَا تَبَايُن (طبيعة كمية أو خاصية أو دالة تظل دون تغيير عند تطبيق تحويل معين عليها) / ثَبَات, عَدَم تَغَيُّر (صفة مقاومة التباين)",
 "不変費用": "تكلفة ثابتة, رسم ثابت (رسم دوري لا يتغير مع حجم الأعمال (مثل التأمين أو الإيجار أو مدفوعات الرهن العقاري وغيرها))",
 "不変量": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "不够本": "مُسْتَحِيل / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني)",
 "不妊": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "不妊性": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "不妊手術": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "不妊症": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "不始末": "إِغْفَال / شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "不存在": "غِيَاب",
 "不学": "جَاهِل, غَيْرُ مُتَعَلِّم (غير متعلّم بشكل عامّ؛ يفتقر إلى المعرفة أو الحصافة) / غريزي, غير شرطي (لم يتم تثبيته عن طريق الاشتراط أو التعلم) / قَلِيلُ العِلْم (ليس واسع الاطّلاع أو المعرفة)\nمثال: رد فعل منعكس غير شرطي",
 "不安": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "不安げ": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "不安定": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "不安定化": "زعزعة الاستقرار (فعل زعزعة الاستقرار؛ جعل الشيء أقل استقرارًا (خاصة الحكومة أو البلد أو الاقتصاد)) / زعزعة الاستقرار, فقدان التوازن (حدث يسبب فقدان التوازن (كما في السفينة أو الطائرة))",
 "不安心": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "不安感": "كَرَب, كَآبَة (كَرَبَهُ الغَمُّ وَالهَمُّ: اشتدَّا عليه، أثقلا عليه؛ كَرَبَتْهُ المشاكِلُ: صَعُبَتْ عليه)\nمثال: كانت أسرة سامي تنتظر في كرب.",
 "不安気": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "不安症": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد عرضاً بارزاً)",
 "不安神経症": "عصاب القلق (يتميز بقلق منتشر وغالباً مظاهر جسدية للخوف)",
 "不安障害": "اضطراب القلق (مصطلح شامل لمجموعة متنوعة من الاضطرابات النفسية التي يكون فيها القلق الشديد عرضاً بارزاً)",
 "不完全": "ناقص-غير كامل",
 "不完全変態": "تحول جزئي, تحول ناقص (تحول غير كامل أو جزئي في الحشرات)",
 "不完全骨折": "كسر غير كامل (كسر لا يمتد عبر كامل عرض العظم)",
 "不定": "غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد) / غير مستقر (غير مستقر أو مؤسس) / غير محسوم, معلق (لا يزال موضع شك) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: نمط حياة غير مستقر / غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ) / غَيْرُ مُحَدَّد ((عَنْ كَمِّيَّةٍ) لَيْسَ لَهَا قِيمَةٌ مُحَدَّدَة؛ كَمُعَادَلَةٍ لَا يُمْكِنُ حَلُّهَا) / غير محدد, غير مقرر (غير محدد أو مقرر بدقة؛ غير ثابت أو معروف مسبقاً) / غير محدود النمو ((في النبات) لديه قدرة على الاستمرار في النمو عند القمة)\nمثال: من عمر غير محدد / تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: عدم يقين النتيجة",
 "不定代名詞": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد')",
 "不定元": "غَيْرُ مُحَدَّدٍ, مُبْهَم (لَا يُفْضِي إِلَى نِهَايَةٍ أَوْ نَتِيجَةٍ حَاسِمَةٍ) / غَيْرُ مُحَدَّد ((عَنْ كَمِّيَّةٍ) لَيْسَ لَهَا قِيمَةٌ مُحَدَّدَة؛ كَمُعَادَلَةٍ لَا يُمْكِنُ حَلُّهَا) / غير محدد, غير مقرر (غير محدد أو مقرر بدقة؛ غير ثابت أو معروف مسبقاً) / غير محدود النمو ((في النبات) لديه قدرة على الاستمرار في النمو عند القمة)\nمثال: من عمر غير محدد",
 "不定冠詞": "أَدَاةُ تَنْكِير, أَدَاةُ نَكِرَة",
 "不定型詩": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "不定形": "غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم)",
 "不定期": "شَاذّ, غَيْر مُنْتَظِم",
 "不定称": "ضمير مبهم ((نحو) ضمير ليس له مرجع محدد، مثل 'شخص ما' أو 'أي أحد') / عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "不定積分": "تَكَامُل غَيْر مُحَدَّد",
 "不定詞": "مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "不実": "خِيَانَة, غَدْر (خيانة الأمانة)",
 "不宣": "المخلص, تفضلوا بقبول فائق الاحترام (صيغة مكتوبة لإنهاء الرسالة)",
 "不害": "لاعنف",
 "不寛容": "ضيق الصدر, عدم الاحتمال (نفاد الصبر مع المضايقات) / تعصب, عدم تسامح (عدم الاستعداد للاعتراف بالاختلافات في الآراء أو المعتقدات واحترامها)\nمثال: عدم احتماله للمقاطعات",
 "不寝番": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "不審": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "不導体": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "不尽": "المخلص, تفضلوا بقبول فائق الاحترام (صيغة مكتوبة لإنهاء الرسالة)",
 "不尽根数": "مهموس (يُنتج دون اهتزاز الحبال الصوتية) / صوت مهموس (صامت يُنتج بدون صوت من الحبال الصوتية)\nمثال: الحروف الساكنة المهموسة مثل 'ب' و 'ك' و 'س'",
 "不屈": "إِلْحَاح",
 "不屈不撓": "عدم كلل (تصميم لا يكل)",
 "不届き": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "不届き千万": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "不届き者": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "不届き至極": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "不届千万": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "不履行": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "不帰": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "不干渉": "اِمْتِنَاع, إِمْسَاك",
 "不平": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "不平等": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل) / مُتَبَايِنَة\nمثال: عليك عدم الخوف.",
 "不平衡": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "不幸": "تعاسة, حزن (العواطف التي يتم اختبارها عندما لا يكون الشخص في حالة رفاهية) / تعاسة, شقاء (حالة تتميز بمشاعر تتراوح من السخط الخفيف إلى الحزن العميق) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "不幸せ": "تعاسة, حزن (العواطف التي يتم اختبارها عندما لا يكون الشخص في حالة رفاهية) / تعاسة, شقاء (حالة تتميز بمشاعر تتراوح من السخط الخفيف إلى الحزن العميق)",
 "不幸にして": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "不幸にも": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "不幸の手紙": "رسالة متسلسلة (رسالة ترسل بالتتابع إلى عدة أشخاص)",
 "不幸中の幸い": "بصيص أمل, جانب مضيء (جانب مواسٍ لموقف صعب)\nمثال: كل سحابة لها جانب مضيء",
 "不彀本": "مُسْتَحِيل / رنين معدني, طقطقة (صوت معدني خفيف قصير) / شق ضيق (فتحة ضيقة كما بين الألواح في الجدار) / صيني (مصطلح مسيء) ((إهانة عرقية) مصطلح مسيء لشخص من أصل صيني)",
 "不当": "ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة",
 "不当たり": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不当り": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不当廉売": "إغراق (بيع البضائع في الخارج بسعر أقل من السعر المفروض في السوق المحلية)",
 "不当表示": "تحريف, تزييف (تحريف متعمد للحقائق) / تضليل, خداع (كذب مضلل)",
 "不従順": "عِصْيَان",
 "不得手": "نقطة ضعف (صفة غير كافية أو ناقصة)",
 "不得策": "عدم جدوى, عدم ملاءمة (صفة عدم الملاءمة للهدف المنشود)",
 "不得要領": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "不徳": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "不徳の致すところ": "اعْتِرَاف بِالْخَطَأ, مِيَا كُولْبَا (إقرار بخطئك أو ذنبك)",
 "不徳の致す所": "اعْتِرَاف بِالْخَطَأ, مِيَا كُولْبَا (إقرار بخطئك أو ذنبك)",
 "不徳漢": "عصا الراعي, محجن (عصا طويلة ذات طرف على شكل خطاف) / جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة) / التواء, انعطاف (جزء دائري من منحنى)\nمثال: منعطف في الطريق",
 "不徳義": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "不徹底": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ) / غير متسق, متناقض (يظهر نقصاً في الاتساق) / غَيْرُ مُتَّسِقٍ, مُتَنَاقِضٌ (لا يمكن جعله متسقاً أو منسجماً)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "不心得": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "不必要": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不忍": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "不応": "جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد) / عَصِيّ, مُمْتَنِع (غير مستجيب مؤقتاً أو غير مستجيب بالكامل لعملية أو محفّز) / عَصِيّ, مُسْتَعْصٍ (لا يستجيب للعلاج) / بطانة الفرن, مادة حرارية (بطانة تتكون من مادة ذات نقطة انصهار عالية؛ تستخدم لتبطين الجدران الداخلية للفرن)",
 "不応期": "فترة جموح ((علم الأعصاب) الوقت الذي يلي إطلاق الخلية العصبية أو انقباض الألياف العضلية والذي لن يستثير فيه المحفز استجابة)",
 "不忠": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "不忠実": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "不快": "استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما) / تثاقل, تردد (درجة معينة من عدم الرغبة) / توعك (مرض خفيف)\nمثال: ممانعة في إلزام نفسه",
 "不快感": "انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / انزعاج, عدم راحة (حالة التوتر والشعور بالألم)",
 "不快感を与える": "مرطبان / جَرَّة (اسم للمَرَّة الواحدة من الجَرّ؛ إناء من خَزَف أو صُلْصَال له بطن كبير وعروتان وفمّ واسع)\nمثال: من ترك الجرة مفتوحة؟",
 "不思議": "عَجِيب / بشكل غريب, بشكل لا يمكن تفسيره (بطريقة تختلف عن المعتاد أو المتوقع) / بتساؤل, بفضول\nمثال: كان لديه صوت أجش بشكل مثير للفضول",
 "不思議がる": "عَجَب / تَسَاءَلَ (القوم: سَألوأ بعضهم بعضا؛ المرء: سَألَ نفسه مرة بعد مرة)\nمثال: قطة؟ تساءل الرجل العجوز.",
 "不思議なくらい": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "不思議なほど": "بشكل رائع, بشكل مذهل ((يستخدم للمبالغة) بشكل ممتاز) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف)\nمثال: صوتها منضبط بشكل رائع",
 "不思議な縁": "ضربة حظ, فرصة سعيدة (قطعة غير متوقعة من الحظ السعيد)\nمثال: حصل أخيراً على فرصته الكبيرة",
 "不急": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / شيء ثانوي, غير ضروري (أي شيء ليس أساسياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "不恰好": "غير متناسق, مشوه القوام (ليس متناسقًا أو ممتعًا في الشكل)\nمثال: امرأة بدينة غير متناسقة القوام / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "不愉快": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "不意": "مُبَاغِت, مُفَاجِئ",
 "不意に": "فَجْأَةً",
 "不意打ち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "不意気": "بَذِيء",
 "不感症": "انْعِدَام الإِحْسَاس, تَبَلُّد (العجز عن الاستجابة للتغيرات الوجدانية في البيئة الشخصية)",
 "不慣れ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "不慮": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "不憫": "فَقِير / مِسْكِين / فُقَرَاء",
 "不成功": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不成立": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不成績": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不戦勝": "انحناء خلفي مع الوقوف على اليدين, شقلبة ماشية (دمج بين الانحناء الخلفي والوقوف على اليدين) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "不戦敗": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "不所存": "حماقة, سفاهة (نقص الحذر في الشؤون العملية)",
 "不手際": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / حرج, خرق (هيئة شخص تكون حركاته ووضعيته غير رشيقة أو غير أنيقة) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب)",
 "不才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "不払い": "تهرب, عدم الدفع (الفعل المتعمد لعدم دفع المال) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: تهربه من جميع دائنيه",
 "不承": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة) / مخالفة في الرأي, معارضة (اختلاف في الرأي) / رأي مخالف ((قانون) اختلاف رأي أحد القضاة عن رأي الأغلبية)\nمثال: عبر عن معارضته في رأي مخالف",
 "不承不承": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "不承知": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة) / مخالفة في الرأي, معارضة (اختلاف في الرأي) / رأي مخالف ((قانون) اختلاف رأي أحد القضاة عن رأي الأغلبية)\nمثال: عبر عن معارضته في رأي مخالف",
 "不承認": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "不承諾": "اِحْتِجَاج, اِعْتِرَاض (فعل الاحتجاج؛ تعبير عام (غالباً ما يكون منظماً) عن المعارضة) / مخالفة في الرأي, معارضة (اختلاف في الرأي) / رأي مخالف ((قانون) اختلاف رأي أحد القضاة عن رأي الأغلبية)\nمثال: عبر عن معارضته في رأي مخالف",
 "不抜": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "不拡大": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "不挨拶": "خشونة, قلة ذوق (قلة أدب متعمدة)",
 "不振": "ثلامة, كليل (انعدام الحدة أو وضوح الحافة أو الطرف) / بَلَادَة, فُتُور (نقص في الحساسية) / خفوت, قتامة (نقص في السطوع البصري) / ضَجَر, مَلَل (صفة الافتقار إلى ما يثير الاهتمام)\nمثال: ثلامة القلم الرصاص جعلت كتابته غير مقروءة",
 "不採用": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "不採算": "خسارة, عدم ربحية (صفة عدم تحقيق مكسب أو فائدة أو ربح)",
 "不揃い": "غَيْرُ مُنْتَظِمٍ, مُتَفَاوِت (يَفْتَقِرُ إِلَى الِاتِّسَاقِ وَالِانْتِظَامِ) / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم) / غير مستوٍ, متفاوت (غير مستوٍ أو غير منتظم كما في الشكل أو الملمس) / فردي (لا يقبل القسمة على اثنين)\nمثال: لون غير منتظم",
 "不換紙幣": "نقد ورقي إلزامي, نقود إلزامية (نقود تعلن الحكومة أنها عملة قانونية رغم عدم إمكانية تحويلها إلى عملة معدنية قياسية)",
 "不揮発性化": "تثبيت ((علم الأنسجة) حفظ عينة الأنسجة وتصلبها للاحتفاظ بنفس العلاقات التي كانت لها في الجسم الحي قدر الإمكان) / تثبيت (نشاط تثبيت شيء ما بإحكام في موضعه) / تثبيت, هوس (انشغال قهري وغير صحي بشيء أو شخص ما) / تثبيت, توقف النمو (حالة غير طبيعية يتوقف فيها النمو قبل الأوان)",
 "不揮発性記憶装置": "تخزين غير متطاير (تخزين حاسوبي لا يُفقد عند إيقاف تشغيل الطاقة)",
 "不摂生": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "不撓": "جَامِد, صَارِم (غَيْرُ قَادِرٍ عَلَى التَّكَيُّفِ أَوِ التَّغَيُّرِ لِمُوَاجَهَةِ الظُّرُوفِ)",
 "不撓不屈": "إصرار, دأب (تصميم مستمر)",
 "不支持": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "不敏": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب) / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما)",
 "不敗": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "不敬": "عدم احترام (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不敬罪": "خيانة الوطن, خيانة عظمى (جريمة تقوض حكومة الجاني)",
 "不敬虔": "جحود, عدم تقوى (الفسوق بحكم الافتقار إلى احترام الإله)",
 "不整": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "不整合": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "不整合人": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "不整脈": "اِضْطِرَاب نَظْم القَلْب",
 "不敵": "جَرِيء, جَسُور",
 "不文": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / شَفَهِيّ, غَيْرُ مَكْتُوب (يستخدم الكلام بدلًا من الكتابة) / عرفي, غير مدون (قائم على العرف بدلاً من التوثيق)\nمثال: قانون عرفي / أُمِّيّ",
 "不文律": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "不文明": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "不文法": "قانون عرفي, قانون غير مكتوب (قانون قائم على السلوك العرفي)",
 "不斉": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "不料簡": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "不断": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / تذبذب, عجز عن الحسم (سمة التردد؛ نقص في صلابة الشخصية أو الغرض) / تردد, عدم حزم (شك يتعلق ببديلين أو أكثر من البدائل أو مسارات العمل الممكنة)\nمثال: تسبب تردد الملك غير القابل للشفاء في اضطراب في بلاطه / عَادِيّ",
 "不断草": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة) / سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "不明": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة / مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "不明朗": "اكتئاب, تجهم (صفة الحزن المفرط والكآبة) / قتامة, كآبة (شعور بتوجس كئيب) / تجهم, قتامة (جو من الاكتئاب والحزن) / تجهم, عبوس (خاصية المظهر العابس أو المتجهم)\nمثال: سادت الكآبة المكتب / قَابِلٌ لِلتَّفْنِيد, قَابِلٌ لِلدَّحْض (يُمْكِنُ دَحْضُهُ أَوْ تَفْنِيدُهُ) / مريب, مشكوك فيه (عرضة للتساؤل والشك)\nمثال: دوافع مشكوك فيها",
 "不明瞭": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "不明確": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "不易": "اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين) / ثَبَات عَلَى العَهْد, وَفَاء (الإخلاص والاعتمادية في العلاقات الشخصية (خاصة الإخلاص الزوجي)) / ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "不時": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "不時着": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "不時着陸": "هبوط اضطراري (هبوط غير مجدول للطائرة يتم في ظروف خارجة عن سيطرة الطيار)",
 "不景気": "أوقات عصيبة (وقت تسوده الصعوبات) / فَقِير / مِسْكِين / فُقَرَاء / كَئِيب, مُوحِش",
 "不智": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "不服": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不服従": "تَمَرُّد, عَدَم خُضُوع (فعل يتسم بالتمرد وعدم الخضوع) / تمرد, عدم انصياع (تحدي السلطة)",
 "不服従運動": "عِصْيان مَدَنيّ",
 "不期": "مُفَاجِئ",
 "不本意": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "不本意ながら": "رَغْمًا عَنْه, قَسْرًا (ضد إرادة المرء أو دون تفكير واعي)\nمثال: احتجز قسراً رغماً عنه",
 "不朽": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "不朽不滅": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "不束": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "不束者": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "不条理": "عَبَثِيّ, سَخِيف / سَخَافَة",
 "不条理主義": "عَبَثِيَّة",
 "不格好": "غير متناسق, مشوه القوام (ليس متناسقًا أو ممتعًا في الشكل)\nمثال: امرأة بدينة غير متناسقة القوام / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "不案内": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "不様": "كَرِيه المَنْظَر (غير سار للنظر)",
 "不機嫌": "بوّز, بَرطَمَ",
 "不次": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "不正": "ظُلْم, جَوْر (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "不正アクセス": "اِخْتَرَقَ / حيلة",
 "不正アプリ": "حِصَان طَرْوَادَة (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "不正コピー": "قَرْصَنَة / تَزْوِير",
 "不正事件": "فَضِيحَة",
 "不正使用": "إساءة استعمال, سوء استخدام (استخدام غير لائق أو مفرط)\nمثال: إساءة استعمال الكحول",
 "不正出血": "نزيف رحمي (نزيف من الرحم لا يعود إلى الحيض)",
 "不正咬合": "سوء إطباق الأسنان ((طب الأسنان) حالة لا تتشابك فيها الأسنان المتقابلة بشكل طبيعي)",
 "不正常": "شُذُوذ / عَيْب خِلْقِيّ",
 "不正指令電磁的記録": "فيروس, فيروس حاسوبي (برنامج قادر على نسخ نفسه وعادة ما يكون قادراً على إلحاق ضرر كبير بالملفات أو البرامج الأخرى على نفس الحاسوب)\nمثال: لا يمكن للفيروس الحقيقي الانتشار إلى حاسوب آخر دون مساعدة بشرية",
 "不正流用": "اختلاس, سوء استخدام (استعارة غير مشروعة) / اختلاس, استيلاء (الاستيلاء الاحتيالي على أموال أو ممتلكات معهود بها لرعايتك ولكنها مملوكة فعلياً لشخص آخر)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "不正直": "خداع, عدم أمانة (افتقار للصدق؛ أفعال الكذب أو الغش أو السرقة) / خيانة, عدم أمانة (صفة كون الشخص غير أمين)",
 "不正確": "خَاطِئ, غَيْر دَقِيق (يحتوي على أخطاء)\nمثال: ترجمة غير دقيقة",
 "不正者": "مرتكب مخالفة (شخص مذنب بارتكاب مخالفة)",
 "不正行為": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / إثم, جنحة (الخروج عما هو مقبول أخلاقياً)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不正規": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "不正規軍": "فِدائِيّ, فِدائِيَّة / حَرْب فِدائِيَّة, حَرْب عِصَابَات (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "不死": "خُلُود",
 "不死性": "خُلُود",
 "不死身": "حصانة, منعة (خاصية كون الشخص محصناً؛ خاصية عدم القدرة على التعرض للأذى (جسدياً أو عاطفياً)) / حصانة, منعة (امتلاك القوة لمقاومة الهجوم)",
 "不死鳥": "فِينِيكْس, فُقْنُس",
 "不殺生": "أهيمسا, اللاعنف (عقيدة بوذية وهندوسية وخاصة جاينية ترى أن جميع أشكال الحياة مقدسة وتحث على تجنب العنف)",
 "不毛": "خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما) / عَاقِر (لَا يُنْجِب ذُرِّيَّة؛ غَيْر قَادِر عَلَى الإِنْجَاب) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / أرض بور, أرض قاحلة (برية غير مأهولة لا تصلح للزراعة)\nمثال: الأراضي القاحلة في وسط أفريقيا / غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "不毛の地": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "不気味": "عَجِيب, غَرِيب",
 "不気味の谷": "وَادٍ غَرِيب (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "不決定": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "不決断": "تردد, خور (سمة كون المرء متردداً؛ يفتقر إلى ثبات الغرض) / تردد, عدم حزم (شك يتعلق ببديلين أو أكثر من البدائل أو مسارات العمل الممكنة)\nمثال: كان تردده لحظياً فقط ولكن الفرصة ضاعت",
 "不沈": "غير قابل للغرق (لا يمكن إغراقه)\nمثال: ظنوا أن التيتانيك غير قابلة للغرق",
 "不治": "اسْتِعْصَاء (عدم القدرة على التغيير في الطباع أو العادات) / استعصاء على العلاج, عدم قابلية الشفاء (عدم إمكانية الشفاء أو العلاج)\nمثال: استعصاء تفاؤله على التغيير",
 "不況": "مُنْخَفَض",
 "不泊": "متغيب, متهرب (شخص يتهرب من الواجب) / متخلف عن الحضور (ضيف يفشل في إبلاغ الفندق أو المطعم عند إلغاء الحجز)",
 "不法": "غير قانوني, محظور (مخالف لـأو محظور بموجب القانون) / غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / ظَالِم, غَيْر شَرْعِيّ (لا أَساسَ لَه في القانون؛ مُخالِف لِلعَدالَة) / حَرَام, غَيْر جَائِز (غير صحيح أخلاقيًّا أو غير مسموح به)\nمثال: إجراءات غير قانونية / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "不法侵入": "انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن) / تعد على الممتلكات (تدخل غير مشروع في حيازة الممتلكات (المنقولة والعقارية)، أو الإجراء القانوني المتخذ لاسترداد التعويضات)",
 "不法侵入者": "دخيل, متطفل (شخص يقتحم خصوصية أو ممتلكات آخر دون إذن)",
 "不法入居者": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "不法占拠": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "不法占拠者": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "不法所持": "حيازة غير قانونية (حيازة مواد خاضعة للرقابة)",
 "不法監禁": "احتجاز غير قانوني, حبس زائف ((قانون) الحبس بدون سلطة قانونية)",
 "不法行為": "الضرر في القانون",
 "不注意": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد)",
 "不活動": "جمود, خمول (حالة عدم النشاط)",
 "不活化": "خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "不活性": "خَامِل / خَامِد",
 "不活性ガス": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري)",
 "不活性化": "تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح)) / إبطال الفعالية, تثبيط (عملية جعل الشيء غير نشط)\nمثال: نظام تعطيل الجينات",
 "不活性気体": "غاز خامل, غاز نبيل (أي من العناصر الغازية الخاملة كيميائياً في مجموعة الهيليوم في الجدول الدوري) / غَازٌ خَامِل",
 "不活溌": "كَلِيل",
 "不活発": "كَلِيل",
 "不浄": "قَذِر, مُتَّسِخ (متسخ أو من المحتمل أن يتسخ بالأوساخ أو القذارة) / غَيْر طَاهِر, نَجِس (لديه شائبة جسدية أو أخلاقية تجعله غير نقي وفقاً للقوانين الغذائية أو الاحتفالية)\nمثال: أرصفة قذرة غير مكنوسة / حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…) / بِرَاز, سَلْح",
 "不浄場": "مِرْحَاض, تواليت",
 "不消化": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "不淫": "عُنُوسَة",
 "不渡り": "خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار",
 "不測": "مُفَاجِئ",
 "不測の事態": "احتمالية, طارئ (حدث أو واقعة أو نتيجة محتملة) / احتمال, طوارئ (حالة كون الشيء مشروطاً بشيء آخر)",
 "不満": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不満分子": "سَاخِط, مُتَمَرِّد (غَيْرُ رَاضٍ تُجَاهَ السُّلْطَةِ) / سَاخِط, مُتَذَمِّر (شخص غير راضٍ أو مشمئز)",
 "不満点": "شِكَايَة, شَكْوَى",
 "不満足": "استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不溶": "مُسْتَعْصٍ (بلا أمل في إيجاد حلّ) / غير قابل للذوبان ((للمادة) غير قادر على الذوبان) / غير قابل للحل, مستعصٍ (لا يقبل الحل أو التفسير)\nمثال: شك غير قابل للحل",
 "不溶性": "عدم القابلية للذوبان (خاصية عدم القابلية للذوبان وصعوبة الانحلال في السائل) / استحالة الحل, عدم قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من المستحيل حلها)",
 "不滅": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "不潔": "قَذِر, مُتَّسِخ (متسخ أو من المحتمل أن يتسخ بالأوساخ أو القذارة) / غَيْر طَاهِر, نَجِس (لديه شائبة جسدية أو أخلاقية تجعله غير نقي وفقاً للقوانين الغذائية أو الاحتفالية)\nمثال: أرصفة قذرة غير مكنوسة / بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "不潔恐怖症": "رهاب القذارة, وسواس النظافة (خوف مرضي من الأوساخ أو التلوث)",
 "不為": "ضَارّ, غَيْر مُفِيد (ينطوي على أو يخلق ظروفاً تضر بالنجاح أو الفعالية)\nمثال: نتيجة غير مواتية",
 "不熟練": "عدم مهارة, نقص الحذق (نقص المهارة المعرفية)",
 "不熱心": "لَامُبَالَاة",
 "不燃物": "غَيْر قَابِل لِلاِحْتِرَاق (غير قادر على الاشتعال والاحتراق)",
 "不特定": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "不理": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "不生産的": "غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "不用": "مُتَقَادِم, مُهْمَل (لم يعد قيد الاستعمال) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "不用心": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر) / غير آمن, محفوف بالمخاطر (يفتقر إلى الأمن أو السلامة) / غَيْرُ آمِن, مُعَرَّضٌ لِلخَطَر (غَيْرُ مَحْمِيٍّ مِنَ الهُجُوم)\nمثال: مجرم خطير",
 "不用意": "غير مجهز, غير مستعد (دون إعداد؛ غير مستعد لـ)\nمثال: ملاحظات مرتجلة / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不甲斐ない": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "不甲斐無い": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "不発": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ)) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث)",
 "不発に終わる": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ)) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث)",
 "不登校": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "不登校児": "مُتَغَيِّب",
 "不相応": "غَيْرُ مُتَوَافِق, مُتَنَافِر (ليس من السهل الجمع بينها بانسجام)",
 "不真面目": "تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "不眠": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "不眠不休": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم الْعَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "不眠症": "أرق, سهاد (حالة مؤقتة تكون فيها غير قادر (أو غير راغب) في النوم)\nمثال: تقبل أرقك ومن المرجح أن يأتي النوم بطريقته المعاكسة",
 "不知": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام. / بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / أَنَا أَعْرِفُ",
 "不知火": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "不破": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "不確か": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة",
 "不確定": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد",
 "不確定判定": "غير حاسم, غير قاطع (غير نهائي؛ لا يضع حداً للشك أو السؤال)\nمثال: رد غير حاسم",
 "不確定性": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: عدم يقين النتيجة",
 "不確定性原理": "مبدأ الريبة, مبدأ عدم اليقين ((نظرية الكم) النظرية القائلة بأنه من المستحيل قياس كل من الطاقة والوقت (أو الموقع والزخم) بدقة كاملة في نفس الوقت)",
 "不確定要素": "مُتَغَيِّر",
 "不確実": "غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد",
 "不確実性": "تَزَعْزُع, شَكّ (كون الشيء غير مستقر أو مشكوك فيه أو معتمد على الصدفة) / ارتياب, شك (حالة عدم التأكد من شيء ما)\nمثال: عدم يقين النتيجة",
 "不磨": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "不祥": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / فَاضِح, مُخْزٍ (يُسِيءُ إِلَى الحِسِّ الأَخْلَاقِيِّ وَيَضُرُّ بِالسُّمْعَة)",
 "不祥事": "فَضِيحَة",
 "不祥事件": "فَضِيحَة",
 "不稔性": "عقم (حالة عدم القدرة على إنتاج النسل؛ عند المرأة هو عدم القدرة على الحمل؛ عند الرجل هو عدم القدرة على التلقيح)",
 "不穏": "مُثِير لِلْقَلَق, مُقْلِق (يسبب عدم الراحة الذهنية)",
 "不穏分子": "مُنْشَقّ",
 "不穏当": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة) / غير لائق, غير مناسب (غير ملائم أو غير صحيح أو غير مناسب) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "不突合": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات)",
 "不等": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل) / مُتَبَايِنَة\nمثال: عليك عدم الخوف.",
 "不等式": "عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل) / مُتَبَايِنَة\nمثال: عليك عدم الخوف.",
 "不等辺三角形": "أخمعي (مكون من أو متعلق بأي من العضلات الأخمعية) / مختلف الأضلاع (لمثلث له ثلاثة أضلاع بأطوال مختلفة)",
 "不等辺四辺形": "مُنْحَرِف, شِكْل مُنْحَرِف",
 "不節制": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "不粋": "بَذِيء / غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "不精": "بُطْء",
 "不精巧": "أَخْرَق",
 "不精者": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "不精髭": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "不納": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "不純": "غَيْر طَاهِر, نَجِس (لديه شائبة جسدية أو أخلاقية تجعله غير نقي وفقاً للقوانين الغذائية أو الاحتفالية) / غير طاهر, فاسد ((يستخدم للأشخاص أو السلوكيات) غير أخلاقي أو فاحش) / غير نقي, مشوب (مختلط بعناصر دخيلة)\nمثال: أفكار غير طاهرة",
 "不純物": "شوائب, عدم نقاء (حالة كونه غير نقي) / خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها)\nمثال: كانت هناك شوائب في الماء",
 "不細工": "أَخْرَق / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "不経済": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "不結果": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不統一": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "不縁": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "不羇": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "不羈": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "不義": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد / خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "不義密通": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "不義理": "خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار",
 "不老不死": "خُلُود",
 "不老不死の霊薬": "إكسير الحياة (مادة افتراضية يعتقد أنها تحافظ على الحياة إلى أجل غير مسمى؛ كان يسعى إليها الخيميائيون)",
 "不老泉": "نبع الشباب (نبع يوصف في الحكايات الشعبية بأنه قادر على إعادة الشباب للناس)\nمثال: اكتشف بونس دي ليون فلوريدا أثناء بحثه عن نبع الشباب",
 "不耐": "ضيق الصدر, عدم الاحتمال (نفاد الصبر مع المضايقات) / تعصب, عدم تسامح (عدم الاستعداد للاعتراف بالاختلافات في الآراء أو المعتقدات واحترامها)\nمثال: عدم احتماله للمقاطعات",
 "不肖": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / غير جدير, لا يستحق (يفتقر إلى القيمة أو الاستحقاق) / غَيْرُ مُسْتَحِقٍّ (لَا يَسْتَحِقُّ التَّقْدِيرَ أَوِ المُكَافَأَةَ)\nمثال: طرد طالب يعتبر سلوكه غير جدير / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "不肖わたくし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "不肖私": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "不胎化": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "不能": "مُسْتَحِيل / عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / عَنَانَة, عُنَّة",
 "不能症": "عَنَانَة, عُنَّة",
 "不能者": "عاجز, عديم القوة (يفتقر للقوة أو القدرة) / عاجز جنسياً, عنين ((للذكر) غير قادر على الجماع)\nمثال: التكنولوجيا بلا أخلاق همجية؛ والأخلاق بلا تكنولوجيا عاجزة",
 "不臣": "خِيَانَة, عَدَم وَلَاء (صفة كون الشخص غير موالٍ)",
 "不自然": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "不自由": "انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / انزعاج, عدم راحة (حالة التوتر والشعور بالألم)\nمثال: 大変ご不自由をおかけして申し訳ございません。 — أعتذر عن ما سببته لك من متاعب. / فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة. / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما)",
 "不興": "استياء, عدم رضا (الشعور بعدم الرضا أو الانزعاج من شخص أو شيء ما)",
 "不良": "سَيِّئ, وحش / مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد) / مُقَصِّر, مُهْمِل (يُخِلّ بِمَا يَقْتَضِيه الوَاجِب) / جَانِح, مُخَالِف (مذنب بارتكاب مخالفة أو جُنحة) / جانح, حدث جانح (مذنب شاب)",
 "不良債権": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "不良化": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / اتضاع, انحطاط (حالة متدنية أو منكسرة)\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "不良導体": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "不良少女": "جانح, حدث جانح (مذنب شاب)",
 "不良少年": "جانح, حدث جانح (مذنب شاب)",
 "不良行為": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه",
 "不良行為少年": "جانح, حدث جانح (مذنب شاب)",
 "不良貸し付け": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "不落": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "不虞": "غَيْر مَنْظُور, غَيْر مُتَوَقَّع (لم يكن في الحسبان ولم يُتَرَقَّب)",
 "不行き届き": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "不行儀": "سوء أدب (قلة أدب ناتجة عن الجهل)",
 "不行届き": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "不行状": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不行跡": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不裁可": "نَقْضْ (هَدَمَ أو أَبْطَلَ؛ خَالَفَ أو تَرَاجَعَ في الوعد أو العهد)\nمثال: لقد نقض الاتفاق.",
 "不要": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不要不急": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "不要情報": "زُبَالَة / نُفَايَات (بقيَّة؛ ما زاد على الحاجة) / قُمَامَة / مُخَلَّفَات\nمثال: توم عامل نفايات.",
 "不要物": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "不要論": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "不見識": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "不規則": "شَاذّ, غَيْر مُنْتَظِم",
 "不規則動詞": "فِعْل غَيْر مُنْتَظِم, فِعْل شَاذّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "不規則銀河": "مَجَرَة غَيْر مُنْتَظِمَة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "不規律": "شَاذّ, غَيْر مُنْتَظِم",
 "不覚": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / فِقْدَان اَلْوَعْي, إِغْمَاء",
 "不親切": "فَظَاظَة, قَسْوَة (الافتقار إلى التعاطف)",
 "不言": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "不言不語": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "不許複製": "جَمِيع اَلْحُقُوق مَحْفُوظَة, كَافَّة اَلْحُقُوق مَحْفُوظَة",
 "不評": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول)",
 "不評判": "عدم الشعبية, قلة الرواج (صفة الافتقار إلى الموافقة العامة أو القبول)",
 "不詳": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض",
 "不認可": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "不語": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "不誠実": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "不誠意": "رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "不調": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "不調和": "عدم انسجام, نشاز (افتقار للتناغم)",
 "不調法": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / خطأ فادح, زلة (خطأ محرج)",
 "不調法者": "شخص أخرق (شخص ذو تنسيق حركي ضعيف) / عَازِف عَنِ الْكُحُول, مُمْتَنِع (شخص يمتنع عن شرب المشروبات المسكرة)",
 "不謬性": "عصمة البابا (معتقد الكنيسة الكاثوليكية بأن الله يحمي البابا من الخطأ عندما يتحدث عن العقيدة أو الأخلاق)",
 "不謹慎": "طَائِش, مُتَهَوِّر (يَفْتَقِر إِلَى ضَبْط النَّفْس الحَكِيم) / غير حكيم, متهور (ليس حكيماً أو عاقلاً)\nمثال: تهور كبير من والدتها أن تشجعها على مثل هذه الأفكار الرومانسية السخيفة",
 "不貞": "خِيَانَة",
 "不貞腐れる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)",
 "不買同盟": "قَاطَعَ / مُقَاطَعَة",
 "不買運動": "قَاطَعَ / مُقَاطَعَة",
 "不賛成": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "不起": "لَا رَجَاء مِن شِفَائِه (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "不足": "عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / قُصُور ((في علم الأمراض) عجز جزء من الجسم أو عضو عن العمل بشكل طبيعي) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة / استياء, عدم رضا (الشعور بعدم الرضا والسخط)\nمثال: لم يكن يتردد أبداً في التعبير عن عدم رضاه عن الخدمة التي تلقاها",
 "不足を言う": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "不足分": "عَجْز, نَقْص",
 "不足前": "عَجْز",
 "不身持ち": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "不躾": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "不軌": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "不輸租田": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "不退": "عَزِيمَة",
 "不退転": "عَزِيمَة",
 "不透明": "أَكْمَد / إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى) / عتامة (ظاهرة عدم السماح بمرور الإشعاع الكهرومغناطيسي) / غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "不透明度": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى) / عتامة (ظاهرة عدم السماح بمرور الإشعاع الكهرومغناطيسي)",
 "不透明性": "إِعْتَام, قَتَامَة (صفة كون الشيء معتماً لدرجة ما؛ الدرجة التي يمنع بها الشيء مرور الضوء) / إِبْهَام, غُمُوض (عدم القدرة على الفهم الناتج عن غموض المعنى) / عتامة (ظاهرة عدم السماح بمرور الإشعاع الكهرومغناطيسي)",
 "不透明感": "تذبذب, عجز عن الحسم (سمة التردد؛ نقص في صلابة الشخصية أو الغرض) / تردد, عدم حزم (شك يتعلق ببديلين أو أكثر من البدائل أو مسارات العمل الممكنة)\nمثال: تسبب تردد الملك غير القابل للشفاء في اضطراب في بلاطه",
 "不透明水彩": "جواش (لوحة مائية منفذة بألوان مائية معتمة ممزوجة بالصمغ) / جواش (ألوان مائية غير شفافة محضرة بالصمغ)",
 "不通": "يُعَلِّق / تَعْلِيق",
 "不逞": "عَنِيد, مُسْتَعْصٍ (يَتَّسِمُ بِالمُقَاوَمَةِ العَنِيدَةِ لِلسُّلْطَة) / جَمُوح, مُتَمَرِّد (يقاوم السلطة أو السيطرة بعناد شديد)",
 "不逞の輩": "عِصَابَة",
 "不連続": "مُتَقَطِّع",
 "不連続性": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "不連続点": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "不連続線": "جَبْهَة / أَمَامِيّ",
 "不逮捕特権": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين الدبلوماسيين في بلد أجنبي)",
 "不遇": "مُصِيبَة, شَقْوَة",
 "不運": "مُصِيبَة, شَقْوَة\nمثال: 彼は身の不運を嘆き悲しんだ。 — بكى على سوء حظه.",
 "不道": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / بربرية, همجية (فعل همجي وحشي بربري) / شَنَاعَة, فَظَاعَة (صفة كون الفعل قاسياً بشكل مروع وغير إنساني)",
 "不道徳": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "不道理": "سَخَافَة",
 "不遜": "مُتَعَالٍ, الْمُتَعَالِي",
 "不遠慮": "فَظّ",
 "不適": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية) / عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة",
 "不適任": "عَدَم أَهْلِيَّة, عَدَم صَلَاحِيَّة (صفة كون الشيء غير مناسب) / عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / ترهل, عدم لياقة (حالة بدنية سيئة؛ عدم تناسق الجسم أو فقدان اللياقة (بسبب حياة الراحة والرفاهية))\nمثال: اتفق القضاة على عدم أهليته للتعيين",
 "不適切": "غَيْرُ لَائِق, غَيْرُ مَرْغُوب (غير جدير بالاختيار خاصة كشريك زواج) / غَيْرُ مُلَائِم (لَيْسَ مُعَدًّا أَوْ مُكَيَّفًا لِغَرَضٍ مُعَيَّنٍ) / غَيْر مُلَائِم (لا يُساعد على التنشئة الأخلاقية السليمة) / غَيْرُ قَابِلٍ لِلتَّطْبِيقِ (لا يمكن تطبيقه)",
 "不適合": "عاصٍ, متحدٍ (مقاوم بجرأة للسلطة أو لقوة معارضة) / عَنِيد, مُمَانِع (شخص يرفض الامتثال)\nمثال: تربى ليكون عدوانياً ومتحدياً",
 "不適当": "عَدَم كِفَايَة, نَقْص (عدم الإرضاء بسبب عدم الكفاية) / عدم كفاية, قصور (الافتقار إلى كمية أو عدد كافٍ) / عدم كفاءة, قصور (نقص الكفاءة)\nمثال: عدم كفاية إعانات البطالة",
 "不適格": "إِقْصَاء",
 "不適格者": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "不適正": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة) / غير لائق, غير مناسب (غير ملائم أو غير صحيح أو غير مناسب) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "不適用": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "不都合": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ / مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "不量見": "زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "不釣り合い": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "不釣合": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "不釣合い": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "不銹鋼": "فُولَاذ مُقَاوِم لِلصَّدَأ",
 "不錆鋼": "فُولَاذ مُقَاوِم لِلصَّدَأ",
 "不間": "ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / حرج, خرق (هيئة شخص تكون حركاته ووضعيته غير رشيقة أو غير أنيقة) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب)",
 "不随": "شَلَل, فَالَج",
 "不随意": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة) / لا إرادي (يتم التحكم فيه بواسطة الجهاز العصبي اللاإرادي؛ دون تحكم واعي)\nمثال: قتل غير عمد (لا إرادي)",
 "不随意筋": "عضلة لا إرادية, عضلة ملساء (عضلة تنقبض دون تحكم واعي وتوجد في جدران الأعضاء الداخلية مثل المعدة والأمعاء والمثانة والأوعية الدموية (باستثناء القلب))",
 "不面目": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "不順": "شَاذّ, غَيْر مُنْتَظِم",
 "不風流": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "不食": "صَوْم, صِيَام",
 "不飽和": "غَيْر مُشَبَّع ((للألوان) غير نقي لونيًا؛ مخفف) / غير مشبع (يستخدم لمركب (خاصة الكربون) يحتوي على ذرات تشترك في أكثر من رابط تكافؤ واحد) / غير مشبع (ليس مشبعاً؛ قادر على إذابة المزيد من المادة عند درجة حرارة معينة)\nمثال: أحمر غير مشبع",
 "不飽和化合物": "مركب غير مشبع (مركب كيميائي يحتوي على روابط كربون-كربون مزدوجة أو ثلاثية، مثل تلك الموجودة في الألكينات أو الألكاينات على التوالي)\nمثال: المركبات المشبعة وغير المشبعة لا تتكون بالضرورة فقط من سلسلة ذرات كربون",
 "不飽和脂肪酸": "حمض دهني غير مشبع (حمض دهني يمكن لسلسلة الكربون الخاصة به امتصاص ذرات هيدروجين إضافية)",
 "不養生": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "不首尾": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / استهجان, سخط (حالة فقدان الحظوة أو الرضا)\nمثال: هو في حالة سخط من الملك (مغضوب عليه)",
 "不鮮明": "غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء) / ضَبَابِيّ, مُغَبَّش (غير واضح في الشكل أو التعبير) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "与え": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "与えたもう": "أَنْعَمَ",
 "与える": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تعيين شخص لعمل ما / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "与え主": "مُعْطٍ",
 "与え給う": "أَنْعَمَ",
 "与え賜う": "أَنْعَمَ",
 "与かる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "与しやすい": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات) / سهل الانقياد, طَيِّع (سهل الإدارة (التحكم أو التعليم أو التشكيل))\nمثال: عقول شابة طيعة",
 "与し易い": "سَلِس, مُذْعِن (يستجيب للاقتراحات والتأثيرات) / سهل الانقياد, طَيِّع (سهل الإدارة (التحكم أو التعليم أو التشكيل))\nمثال: عقول شابة طيعة",
 "与する": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "与る": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "与件": "مُسَلَّم ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "与信": "اِئْتِمَان",
 "与党": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "与党議員": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "与力": "رَقِيب شُرْطَة (رجل قانون برتبة رقيب)",
 "与国": "حَلِيف, حَلِيفَة",
 "与太者": "دَمَوِيّ, سَفَّاح",
 "与太話": "خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "与太郎": "كَذَّاب, كَذَّابَة / ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "与座": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "与格": "حَالَة الْمَفْعُول لَهُ, حَالَة مِنْ حَالَات النُّصْب",
 "与田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "与那原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "与那国蚕": "عثة الأطلس (عثة عملاقة واسعة الانتشار في آسيا؛ تُربى أحياناً من أجل الحرير)",
 "与那嶺": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "丐児": "سَائِل / فَقِير",
 "丑": "ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة)\nمثال: حرث ما حرث الثور. / باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "丑三つ": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "丑三つ時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "丑寅": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "且": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "且つ": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "且つ又": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "且又": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "丕顕": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "世": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "世にいう": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "世にも": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "世に出る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "世に言う": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "世のならい": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "世の中": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "世の常": "عَادِيّ, مَأْلُوف",
 "世の習い": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "世の覚え": "سُمْعَة, شُهْرَة",
 "世も末": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "世を去る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "世を渡る": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "世上": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世事に疎い": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "世人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "世代": "جِيل, نَسْل / جِيل",
 "世代交代": "تعاقب الأجيال, تولد متباين (تناوب شكلين مختلفين أو أكثر في دورة حياة نبات أو حيوان)",
 "世伝": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "世俗": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世俗主義": "عَلْمَانِيَّة, لَائِكِيَّة",
 "世俗化": "عَلْمَنَة",
 "世俗心": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "世俗的": "دُنْيَوِيّ",
 "世俗的ヒューマニズム": "إنسانية, إنسانية علمانية (المذهب الذي يؤكد قدرة الشخص على تحقيق ذاته من خلال العقل؛ يرفض الدين والخوارق)",
 "世嗣": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世子": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世帯": "أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا",
 "世帯主": "صاحب منزل, مالك المنزل (شخص يمتلك منزلاً)",
 "世情": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "世才": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "世捨て人": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "世捨人": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "世智": "إقدام, عزيمة (الثبات والتصميم) / بديهة, حس سليم (حكم عملي سليم)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "世柄": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "世渡り": "كَفَاف",
 "世渡り上手": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "世界": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / فَلْكَة / كُرَة / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض.",
 "世界に誇る": "أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "世界の七不思議": "عجائب الدنيا السبع, عجائب الدنيا السبع القديمة (آثار ونصب مثيرة للإعجاب تم إنشاؤها في العالم القديم وكان يُنظر إليها برهبة وإجلال)",
 "世界の果て": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "世界を舞台に": "دولياً, عالمياً (على مستوى العالم) / عالمياً (فيما يتعلق بالأرض كلها)\nمثال: هي معروفة دولياً",
 "世界一周": "طواف حول العالم (السفر حول شيء ما (بالسفينة أو الطائرة))\nمثال: أثبت طواف ماجلان حول الأرض أنها كروية",
 "世界主義": "الْمُوَاطَنَة الْعَالَمِيَّة",
 "世界人": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "世界保健機関": "مُنَظَّمَة الصِّحَّة الْعَالَمِيَّة",
 "世界各地": "جَمِيع أَنْحَاء, كُلّ",
 "世界地図": "خَرِيطَةُ الْعَالَمِ (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "世界基督教統一神霊協会": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "世界大恐慌": "الْكَسَاد الْعَظِيم",
 "世界大戦": "حَرْب عَالَمِيَّة, الْحَرْب الْعَالَمِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "世界平和連合": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "世界征服": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "世界性": "شُمُولِيَّة, عَالَمِيَّة (صفة كون الشيء عالمياً؛ موجوداً في كل مكان)",
 "世界恐慌": "الْكَسَاد الْعَظِيم",
 "世界情勢": "شؤون دولية, شؤون عالمية (الشؤون بين الأمم)\nمثال: لا يمكنك حقاً مواكبة الشؤون العالمية من خلال مشاهدة التلفزيون",
 "世界教会協議会": "مجلس الكنائس العالمي (منظمة مسكونية للكنائس البروتستانتية والشرقية؛ تهدف إلى تعزيز الوحدة والتعاون في الشؤون الدينية والعلمانية)",
 "世界教会運動": "الحركة المسكونية (حركة تهدف إلى تعزيز التفاهم والتعاون بين الكنائس المسيحية؛ تهدف في النهاية إلى الوحدة المسيحية العالمية)",
 "世界新": "الْعَالَم الْجَدِيد",
 "世界新記録": "الْعَالَم الْجَدِيد",
 "世界時": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "世界比較教育学会": "مجلس عالمي (مجلس يضم ممثلين من دول مختلفة)",
 "世界気象機関": "المنظمة العالمية للأرصاد الجوية (وكالة الأمم المتحدة المعنية بالجمع الدولي لبيانات الأرصاد الجوية)",
 "世界産業労働組合": "عمال الصناعة في العالم (نقابة عمالية دولية سابقة وحركة عمالية راديكالية في الولايات المتحدة؛ تأسست في شيكاغو عام 1905 وكرست للإطاحة بالرأسمالية؛ انخفضت عضويتها بعد الحرب…)",
 "世界的": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ / أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "世界秩序": "نِظَام عَالَمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "世界線": "عَالَم مُوَازِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世界観": "رُؤْيَةٌ كَوْنِيَّة, رُؤْيَةُ الْعَالَم / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "世界記録": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
 "世界記録保持者": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
 "世界語": "لغة مساعدة دولية (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)",
 "世界貿易機関": "مُنَظَّمَة اَلتِّجَارَة اَلْعَالَمِيَّة",
 "世界銀行": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "世界銀行東京事務所": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "世相": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "世知": "إقدام, عزيمة (الثبات والتصميم) / بديهة, حس سليم (حكم عملي سليم)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "世知辛い": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "世系": "نُزُول / اَصْل / شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "世紀": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن. / حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر.",
 "世紀末": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "世紀末的": "مُتَرَفّ, مُنْحَطّ (مُنغمس في التنعّم والتدليل بإسراف) / آفِل, مُنْحَطّ (يَتَّسِمُ بِالإِسْرَافِ فِي مُتَعِ الذَّاتِ وَالانْحِلَالِ الأَخْلَاقِيّ) / منحل (شخص سقط في حالة انحطاط (أخلاقياً أو فنياً))",
 "世継": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世継ぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "世襲": "إرث جيني, وراثة (مجموع الصفات الموروثة) / وراثة (العملية البيولوجية التي تنتقل بها العوامل الوراثية من جيل إلى جيل)",
 "世襲的": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "世襲財産": "إرث, ميراث (الخلافة الوراثية للقب أو منصب أو ممتلكات) / إرث, ميراث (أي سمة أو ممتلكات غير مادية موروثة من الأسلاف) / تراث (الممارسات المتوارثة من الماضي عن طريق التقليد) / تراث, تركة (ما يتم توريثه؛ لقب أو ممتلكات أو عقار ينتقل بموجب القانون إلى الوريث عند وفاة المالك)\nمثال: كان ميراثي الوحيد بركة أمي",
 "世評": "سُمْعَة, شُهْرَة",
 "世話": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / مُشْكِلَة, مَتاعِب / تَوْصِيَة / حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "世話がない": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "世話のやける": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "世話の焼ける": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "世話をする": "تَوَخَّى اَلْحِذْر",
 "世話をやく": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / أزْعَجَ / يَزْعَجْ, يُضَايِقْ",
 "世話を焼く": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / أزْعَجَ / يَزْعَجْ, يُضَايِقْ",
 "世話人": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر. / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "世話係": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "世話係り": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "世話役": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "世話焼": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "世話焼き": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "世論": "رَأْي عَامّ",
 "世論調査": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "世諺": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "世路": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世辞": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "世辞者": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "世迷い言": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "世迷言": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "世途": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世過ぎ": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "世銀": "البنك الدولي, البنك الدولي للإنشاء والتعمير (وكالة تابعة للأمم المتحدة أنشئت لمساعدة الدول النامية بقروض تضمنها الحكومات الأعضاء)",
 "世間": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世間さま": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世間ずれ": "مُتَطَوِّر, مُتَقَدِّم (متقدِّم في التطوُّر؛ معقَّد أو دقيق) / رَاقٍ, مُتَطَوِّر (جذاب فكريًّا ومتطور) / حنِك, راقٍ (يمتلك أو يجذب أولئك الذين لديهم معرفة دنيوية وتهذيب وكياسة)\nمثال: شبان اجتماعيون راقون",
 "世間なみ": "عَادِيّ, مَأْلُوف",
 "世間の口": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "世間の皆様": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "世間の目": "أَضْوَاء",
 "世間ばなし": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "世間一般": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "世間並": "عَادِيّ, مَأْلُوف",
 "世間並み": "عَادِيّ, مَأْلُوف",
 "世間体": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "世間周知": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "世間擦れ": "مُتَطَوِّر, مُتَقَدِّم (متقدِّم في التطوُّر؛ معقَّد أو دقيق) / رَاقٍ, مُتَطَوِّر (جذاب فكريًّا ومتطور) / حنِك, راقٍ (يمتلك أو يجذب أولئك الذين لديهم معرفة دنيوية وتهذيب وكياسة)\nمثال: شبان اجتماعيون راقون",
 "世間様": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "世間的": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "世間話": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "丘": "تَلّ, أَكَمَة (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: لقد تسلقت تل طويل / بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي",
 "丘上": "قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة",
 "丘疹": "بَثْرَة, بَثْر",
 "丘葦鴨": "بط سماري ((بَطَّ) الْقُرْحَةَ شَقَّهَا)\nمثال: ذهب لاصطياد البط.",
 "丘虎の尾": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "丘陵": "تَلّ, أَكَمَة (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: لقد تسلقت تل طويل / سَفْح (لها معانٍ متعددة تتعلق بالانصباب والسكب؛ أراقَ دمًا أو ماءً)\nمثال: كان ذلك الحوض في سفح الجبل.",
 "丙": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار) / بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "丙種": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار) / بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "丞相": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "両": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / تايل (وحدة وزن مستخدمة في شرق آسيا تساوي تقريبًا 1.3 أوقية) / اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة. / سَامُورَاي",
 "両々": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "両両": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "両個": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة. / سَامُورَاي",
 "両凸": "عَدَسِيّ, مُحَدَّبُ الوَجْهَيْنِ (مُحَدَّب مِنْ كِلَا الجانِبَيْنِ؛ بِشَكْلِ العَدَسَة)",
 "両刀": "مزدوج الميل الجنسي",
 "両刀使い": "مزدوج الميل الجنسي",
 "両刀論法": "مُعْضِلَة / مِحْنَة",
 "両刀遣い": "مزدوج الميل الجنسي",
 "両刃": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "両刃の剣": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "両刃鋸": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "両利き": "براعة يدوية مزدوجة, مهارة كلتا اليدين (خاصية المهارة المتساوية بكلتا اليدين)",
 "両前": "مزدوج الصدر ((عن الملابس) يغلق بلف حافة واحدة من الأمام جيداً فوق الأخرى عادةً بصف مزدوج من الأزرار)\nمثال: سترة مزدوجة الصدر",
 "両取": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "両取り": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة.",
 "両口": "زَوْجَانِ / بَعْضُ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "両唇音": "شَفَتَانِيّ",
 "両国間": "ثُنَائِيّ",
 "両川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "両建て": "اِمْتَطَى",
 "両形": "ثنائية الشكل ((في علم الأحياء) وجود شكلين من الأفراد ضمن نفس النوع الحيواني (بشكل مستقل عن الفروق الجنسية)) / ثنائية الشكل ((في الكيمياء) خاصية بعض المواد التي تمكنها من الوجود في شكلين بلوريين متميزين)",
 "両性": "أَمْفُوتِيرِيّ, مُتَرَدِّد (له خصائص كل من الحمض والقاعدة وقادر على التفاعل كأي منهما)",
 "両性具有": "خناثي, خنثوي (لديه خصائص الذكور والإناث معاً) / خنثوي (يتعلق بـ أو يظهر أعضاء جنسية ذكرية وأنثوية معاً ولكن بمظهر أنثوي غالب)",
 "両性愛": "ازدواجية الميول الجنسية (النشاط الجنسي مع كل من الرجال والنساء) / ازدواجية الجنس, خنوثة (إظهار خصائص كلا الجنسين)",
 "両性愛者": "مزدوج الميل الجنسي",
 "両性的": "خناثي, خنثوي (لديه خصائص الذكور والإناث معاً) / خنثوي (يتعلق بـ أو يظهر أعضاء جنسية ذكرية وأنثوية معاً ولكن بمظهر أنثوي غالب)",
 "両手": "عَشَرَة, عَشْرَة",
 "両手利き": "براعة يدوية مزدوجة, مهارة كلتا اليدين (خاصية المهارة المتساوية بكلتا اليدين)",
 "両断": "تنصيف (التقسيم إلى جزأين متساويين)",
 "両方": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "両方とも": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "両方共": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "両方向": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "両替": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "両替屋": "صِرَافَة اَلْعُمْلَات, مَكْتَب صِرَافَة",
 "両替所": "صِرَافَة اَلْعُمْلَات, مَكْتَب صِرَافَة",
 "両本位制": "نظام المعدنين (معيار نقدي يتم بموجبه تعريف الوحدة الأساسية للعملة بكميات محددة من معدنين (عادة الذهب والفضة) مع تحديد قيم بنسبة محددة مسبقاً)",
 "両棲": "بَرْمَائِيّ (يعمل أو يعيش على اليابسة وفي الماء) / برمائي (متعلق بحيوانات طائفة البرمائيات أو مميز لها)\nمثال: مركبات برمائية",
 "両棲類": "بَرْمَائِيّ / بَرْمَائِيّ, قَازِب",
 "両次": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "両生": "بَرْمَائِيّ (يعمل أو يعيش على اليابسة وفي الماء) / برمائي (متعلق بحيوانات طائفة البرمائيات أو مميز لها)\nمثال: مركبات برمائية",
 "両生類": "بَرْمَائِيّ / بَرْمَائِيّ, قَازِب",
 "両眼視": "رؤية بكلتا العينين, رؤية ثنائية (الرؤية التي تنطوي على استخدام كلتا العينين)",
 "両眼鏡": "مِنْظَار",
 "両立": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "両端揃え": "تَبْرِير",
 "両者": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "両脚規": "فِرْجَار, بِرْكَار",
 "両舌": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "両親": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "両面コピー": "ثُنَائِيّ الجَانِب (ذو جانبين أو جزأين) / ذو وجهين, قابل للقلب (يمكن قلبه أو استخدامه على أي من الجانبين)\nمثال: سترة ذات وجهين",
 "両面作戦": "ثُنَائِيُّ الشُّعَب (ذُو شُعْبَتَيْن)",
 "両面価値": "ازدواجية المشاعر, تناقض وجداني (مشاعر أو عواطف مختلطة)",
 "両面羊歯": "رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "両頭政治": "حكم ثنائي (شكل من أشكال الحكم بوجود حاكمين مشتركين)",
 "両鬢": "سَوَالِف, سَالِف اَلشَّعْر",
 "並": "مُتَوَسِّط, مُعَدَّل / كُلّ",
