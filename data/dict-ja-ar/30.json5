 "万国国際音標文字": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "万国標準時": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "万国音標文字": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "万場": "كُلّ, جَمِيع",
 "万寿": "أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "万寿菊": "قطيفة فرنسية (نبات سنوي كثيف قوي الرائحة برؤوس زهور برتقالية أو صفراء معلمة باللون الأحمر…)",
 "万尋の谷": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "万屋": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً…)",
 "万年": "عَشَرَة آلَاف / أَبَدِيّ, سَرْمَدِيّ",
 "万年暦": "تقويم دائم (مخطط أو جهاز ميكانيكي يشير إلى أيام الأسبوع المقابلة لأي تاريخ معين على مدى…)",
 "万年筆": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "万年茸": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "万年草": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
