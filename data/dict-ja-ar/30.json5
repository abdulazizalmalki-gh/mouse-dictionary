 "下ぶれ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "下らない": "تافِه / غَبِيّ",
 "下らぬ": "تافِه / غَبِيّ",
 "下らん": "تافِه / غَبِيّ",
 "下り": "مُتَّجِهٌ لِلْأَسْفَل (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا نُزُولًا) / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "下りる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / تَقَاعَدَ / صُورَة, شَكْل\nمثال: اجلس بشكل مريح.",
 "下り勾配": "مَنْزَل, مُنْحَدَر هَابِط (الخاصية التي يمتلكها منحدر أو سطح ينخفض للأسفل)",
 "下り口": "قِمَّة",
 "下り坂": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
