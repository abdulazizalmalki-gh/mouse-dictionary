 "上半": "شوط أول (الأول من شوطين للعب)",
 "上半期": "شوط أول (الأول من شوطين للعب)",
 "上原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上古史": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "上司": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "上合": "اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "上向": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上向き": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上向く": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "上品": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة. / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上唇": "جَاضِم",
 "上噛合わせ": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان السفلية)",
 "上回る": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "上園": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上地": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上場": "إدراج, سرد (فعل عمل قائمة بالعناصر) / قائمة (قاعدة بيانات تحتوي على مصفوفة مرتبة من العناصر (أسماء أو موضوعات)) / أَدَاء / مَسْرَحِيَّة",
 "上場投信": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "上塗": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "上塗り": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "上士": "عَالِيّ الرُتْبَة / بُودِيسَاتْفَا",
 "上大静脈": "وريد أجوف علوي (يتلقى الدم من الرأس والذراعين والصدر ويصب في الأذين الأيمن للقلب؛ يتكون من الوريد الفرد وكلا الوريدين العضديين الرأسيين)",
 "上天": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / صُعُود, اِرْتِقَاء",
 "上客": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له)",
 "上家": "سَقِيفَة",
 "上宿": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上将": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / أَمِيرُ البَحْر, أَدْمِيرَال",
 "上屋": "سَقِيفَة",
 "上層土": "تربة سطحية (طبقة التربة الموجودة على السطح)",
 "上層建築": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "上層語": "لغة فوقية (لغة شعب غازٍ لاحق تُفرض على السكان الأصليين وتساهم بخصائص في لغتهم) / طبقة علوية, طبقة فوقية (أي طبقة توضع فوق أخرى)",
 "上層部": "القيادة العليا, كبار المسؤولين (أهم الأشخاص في هيئة حاكمة)",
 "上層階級": "الطَّبَقَة الْعُلْيَا",
 "上層雲": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / رَفِيع المُسْتَوَى (في مستوى مرتفع من الرتبة أو الأهمية)",
 "上山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上州": "غُونْمَا",
 "上帝": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "上席": "أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "上底": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "上座部": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "上座部仏教": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "上弦": "التربيع الأوّل, التربيع المتزايد",
 "上弦の月": "التربيع الأوّل, التربيع المتزايد",
 "上張り": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "上役": "أعلى مرتبة, رئيس (شخص ذو رتبة أو مكانة أو جودة أعلى)",
 "上後鋸筋": "منشارية خلفية علوية (عضلة رباعية رقيقة في الجزء العلوي والظهري من الصدر؛ تعمل على رفع الأضلاع العلوية)",
 "上御一人": "قَيْصَر, إِمْبْرَاطُور",
 "上忍": "عَالِيّ الرُتْبَة",
 "上意": "إرَادَة / رَغْبَة, إرَادَة",
 "上意下達": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "上意討ち": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "上戸": "شَارِب / مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة",
 "上手": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق) / يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور) / مَاهِر, حَاذِق",
 "上手い": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "上手い具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "上手く": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "上手をいく": "فَاقَ, تَجَاوَزَ",
 "上手を行く": "فَاقَ, تَجَاوَزَ",
 "上手者": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "上拍": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "上振れ": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上掛": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / غِلَاف / غَطَّى / مِعْطَف فَضْفَاض",
 "上掛け": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / غِلَاف / غَطَّى / مِعْطَف فَضْفَاض / مِنَ الدَّرَجَة الأُولَى (ممتاز؛ أفضل ما يمكن) / زينة علوية, طبقة علوية (إضافة ذات نكهة توضع فوق طبق الطعام)",
 "上掲": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上提": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "上敷": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "上敷き": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "上文": "تخلٍّ, تنازل (فعل التنازل؛ التضحية أو التخلي عن (ممتلكات أو حق أو لقب أو امتياز، إلخ))",
 "上新粉": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "上昇": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "上昇期": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上昇気流": "تيار صاعد (تيار هوائي صاعد قوي)",
 "上昇限度": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "上映": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "上映時間": "مدة العرض, وقت التشغيل (طول الوقت الذي يستمر فيه فيلم أو عرض تلفزيوني)",
 "上映館": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "上景気": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "上書": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "上書き": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "上服": "رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى)",
 "上期": "شوط أول (الأول من شوطين للعب)",
 "上木": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "上杉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上板": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "上梓": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "上様": "قَيْصَر, إِمْبْرَاطُور / زَوْجَة, اِمْرَأَة",
 "上機嫌": "انشراح, روقان (مزاج مبتهج ومقبول)",
 "上段": "سطح علوي (سطح مرتفع) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "上気": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض) / خِيَانَة / كُفْر, زَنْدَقَة (مصدر للفعل \"كَفَرَ\")",
 "上気道": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "上気道炎": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "上水": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "上水道": "كُلْوَة, كُلْيَة",
 "上波": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "上流": "ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار) / ضد التيار, عكس التيار (في الاتجاه المعاكس لتيار النهر) / الطَّبَقَة الْعُلْيَا",
 "上流社会": "الطَّبَقَة الْعُلْيَا",
 "上流階級": "الطَّبَقَة الْعُلْيَا",
 "上海": "شَانْغْهَاي, شَانْغْخَاي\nمثال: この前中国へ行ったとき、上海を訪れた。 — زرتُ شانغهاي لَمَّا زرتُ الصين المرة الأخيرة.",
 "上海証券取引所": "الجَنُوب الجَنُوبِيّ الشَّرْقِيّ, جَنُوب جَنُوب شَرْق (نقطة البوصلة في منتصف المسافة بين الجنوب والجنوب الشرقي)",
 "上海語": "لغة وو, لهجة شنغهاي (لهجة صينية يتم التحدث بها في دلتا اليانغتسي)",
 "上清": "رَائِق, طَافٍ ((للسوائل) يطفو على السطح فوق الراسب أو الرُّسابة) / سائل طافٍ (السائل الصافي الذي يطفو فوق الرواسب أو المواد المترسبة)",
 "上湯": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "上滑り": "سَطْحِيّ / تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "上演": "أَدَاء / مَسْرَحِيَّة",
 "上潮": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة / طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "上物": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تجهيزات, تركيبات (جسم مثبت بإحكام في مكانه (خاصة في المنزل)) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / زبون معتاد, مرتاد دائم (راعٍ منتظم لمكان ما)\nمثال: مرتاد دائم لمضمار السباق",
 "上玉": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "上生菓子": "مُرْتَفِع الدَّرَجَة",
 "上田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上甲": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上甲板": "سطح علوي (سطح مرتفع)",
 "上申書": "تقرير, تقرير مكتوب (وثيقة مكتوبة تصف نتائج فرد أو مجموعة ما)\nمثال: هذا يتفق مع الدراسة الحديثة التي أجراها هيل وديل",
 "上界": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة)",
 "上白": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上白糖": "سكر ناعم الحبيبات (سكر ناعم الحبيبات جداً كان يرش قديماً من وعاء خاص)",
 "上皮": "بُشَيْرَة / نَسِيج طِلَائِيّ",
 "上皮細胞": "خلية طلائية, خلية ظهارية (واحدة من الخلايا المتراصة التي تشكل النسيج الطلائي)",
 "上皮組織": "ظهارة, نسيج طلائي (نسيج غشائي يغطي الأعضاء الداخلية والأسطح الداخلية الأخرى للجسم)",
 "上盤": "الجدار المعلق (الجدار العلوي لصدع مائل)",
 "上目": "فوق رتبة ((في الأحياء) مجموعة تصنيفية تقع فوق الرتبة وتحت الطائفة أو الطويئفة)",
 "上直筋": "مستقيمة علوية (عضلة العين التي يدير انقباضها مقلة العين لأعلى وللداخل)",
 "上着": "مِعْطَف / قِمَّة",
 "上祭服": "رداء القداس (رداء طويل بلا أكمام يرتديه الكاهن عند الاحتفال بالقداس)",
 "上科": "فوق فصيلة ((في الأحياء) مجموعة تصنيفية تقع تحت الرتبة ولكن فوق الفصيلة)",
 "上程": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "上積み": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "上空": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "上端": "قِمَّة",
 "上等": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "上等兵": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "上等兵曹": "رئيس ضباط الصف (شخص يحمل أعلى رتبة لضابط صف بحري)",
 "上等品": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上米": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / عُمُولَة / ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "上糝粉": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "上納": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "上紙": "غِلَاف",
 "上級副社長": "نائب رئيس أول (نائب الرئيس الأعلى رتبة في شركة لديها أكثر من نائب رئيس)",
 "上級国民": "نُخْبَة",
 "上級曹長": "سمكة الرقيب, سمكة العريف (سمكة قعيسية كبيرة زرقاء رمادية مخططة بالأسود؛ توجد في جميع أنحاء العالم تقريباً) / رقيب ميجر, مساعد أول (ضابط صف يعمل ككبير المسؤولين الإداريين لوحدة مقر الجيش)",
 "上級裁判所": "محكمة عليا (أي محكمة لها اختصاص أعلى من محكمة أدنى)",
 "上綱": "فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "上肢": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "上肢帯": "حزام صدري (دعامة هيكلية ترتبط بها الأطراف الأمامية للفقاريات)",
 "上背": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "上腕": "عَضُد (مُعِين؛ قُوَّة)",
 "上腕三頭筋": "عضدية ثلاثية الرؤوس (العضلة الهيكلية ذات الثلاثة مناشئ التي تمد الساعد عند انقباضها)",
 "上腕二頭筋": "عضدية ثنائية الرؤوس (عضلة تثني وتكب الساعد)",
 "上腕動脈": "شريان عضدي (الشريان الرئيسي للذراع العلوي؛ استمرار للشريان الإبطي؛ يتفرع إلى الشرايين الكعبرية والزندية عند المرفق)",
 "上腕骨": "عَضُد (مُعِين؛ قُوَّة)",
 "上腸間膜動脈閉鎖症": "شريان مساريقي علوي (ينشأ من الجزء العلوي للأبهر ويغذي الأمعاء الدقيقة والأعور والقولون)",
 "上腹部": "شرسوف, منطقة فوق المعدة (المنطقة الواقعة على أو فوق المعدة (أسفل عظم القص مباشرة))",
 "上腹部圧迫法": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "上腿": "فَخِذ, فَخْذ",
 "上膊": "عَضُد (مُعِين؛ قُوَّة)",
 "上臈": "سيدة نبيلة, ليدي (امرأة من طبقة النبلاء في بريطانيا)",
 "上草履": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف) / خُفّ (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "上荷船": "قارب صغير (قارب صغير الحجم)",
 "上蓋": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف) / غِطَاء",
 "上薬": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "上行大動脈": "أبهر صاعد (الجزء الصاعد من الأبهر عند خروجه من البطين الأيسر)",
 "上行結腸": "قولون صاعد (جزء الأمعاء الغليظة الذي يصعد من الأعور إلى القولون المستعرض)",
 "上衣": "مِعْطَف / قِمَّة",
 "上表紙": "غِطَاء / غِلَاف / غَطَّى",
 "上西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上覆": "غِطَاء / غِلَاف / غَطَّى",
 "上記": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上訴": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "上調子": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها)",
 "上貼り": "طبقة نهائية, وجه أخير (الطلاء النهائي (مثل الدهان أو الجص أو الورنيش، إلخ))\nمثال: لا يمكننا الطلاء حتى يضعوا الطبقة النهائية",
 "上越": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上足": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上辺": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب",
 "上辺を飾る": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "上述": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上進": "تَقَدُّم",
 "上達": "تَحْسِين\nمثال: 君の英語は上達している。 — إنجليزيتك تتحسن.",
 "上達部": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "上部": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "上部字幕": "ترجمة علوية (ترجمة كلمات أوبرا أجنبية (أو عمل كورالي) تُعرض على شاشة فوق المسرح)",
 "上部構造": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "上酒": "رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر)",
 "上野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "上長": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "上門": "فوق شعبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة وتحت الطائفة أو الطويئفة)",
 "上限": "حد شمالي, حد علوي (الحد الموجود على الجانب العلوي (أو الشمالي) لشيء ما) / حد أقصى, ذروة (أكبر كمية ممكنة)",
 "上限値": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة)",
 "上院": "مَجْلِس عُلْوِيّ",
 "上院議会": "مَجْلِس الشُّيُوخ",
 "上院議員": "سِنَاتُور, سِنَاتُورَة",
 "上陸": "هُبُوط / بَسْطَة",
 "上陸休暇": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "上陸用舟艇": "سفينة إنزال, مركبة إنزال (مركبة بحرية مصممة لإنزال القوات والمعدات على الشاطئ)",
 "上陸許可": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "上面": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِمَّة",
 "上靴": "حذاء فوقي (حذاء يحمي حذاءك الأصلي من الماء أو الثلج أو البرد)",
 "上音": "نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي) / إِيحَاء, نَبْرَة خَفِيَّة ((عادة الجمع) معنى أو جودة ضمنية خفية)\nمثال: إيحاءات اليأس",
 "上頚": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "上頸": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "上顆": "فوق اللقمة, لقيمة (نتوء على عظم فوق اللقمة يعمل كمرتكز للعضلات والأربطة)",
 "上顎": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "上顎骨": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "上首": "شَيْخ, قَائِد",
 "上首尾": "نَاجِح, فَائِز",
 "上駒": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "上騰": "يقرب",
 "上﨟": "سيدة نبيلة, ليدي (امرأة من طبقة النبلاء في بريطانيا)",
 "下": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة. / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / تَحْت (أَقَلَّ) / أَسْفَل\nمثال: أنا تحت الشجرة. / جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى) / تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / جَانِب / صَفْحَة / انخفاض (درجة منخفضة أو صغيرة من أي جودة (كمية أو قوة أو حرارة إلخ)) / انخفاض (صفة كون الشيء منخفضاً؛ الافتقار للارتفاع) / تثبيط, هبوط المعنويات (شعور بانخفاض المعنويات) / ضعة, مكانة متدنية (موقف ذو مكانة أدنى؛ منخفض في المقام أو الرتبة أو الثروة أو التقدير)\nمثال: استفاد من انخفاض أسعار الفائدة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / بِرَاز, سَلْح / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "下々": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "下あご": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "下がり": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / الْبَقَايَا / ذهاب, رحيل (فعل المغادرة) / قَلِيلًا",
 "下がり目": "فترة, فترة زمنية (مقدار من الزمن)",
 "下がり花": "نِسَائِيّ حَصْرِيّ (يُستخدم للأنشطة التنافسية التي تشارك فيها النساء فقط)",
 "下がる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "下ぐ": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)",
 "下げ": "إنزال, خفْض (عملية التسبب في تحرك شيء ما إلى مستوى أدنى) / تنزيل, خفض (عملية التسبب في أن يصبح الشيء أقل) / مُتَجَهِّم, مُكْفَهِرّ (مُعتم بالغيوم مع إيحاء بالتهديد) / إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين / نُكْتَة",
 "下げる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / شَفَّاف / وَاضِح",
 "下げわたす": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "下げ幕": "ستارة خلفية, ستارة منسدلة (ستارة يمكن إنزالها ورفعها على المسرح من الأعلى؛ غالباً ما تستخدم كمنظر خلفي)",
 "下げ弓": "سحبة قوس لأسفل (ضربة لأسفل من كعب القوس إلى طرفه)",
 "下げ振り": "مِطْمَار, مِطْمَر",
 "下げ札": "زَقِيطَة",
 "下げ渡す": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "下げ緒": "عقدة السيف (شرابة زخرفية على مقبض السيف)",
 "下げ足": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "下げ髪": "ضَفِيرَة صَغِيرَة (جديلة من الشعر المضفر)",
 "下ごしらえ": "تَحْضِير, إِعْدَاد",
 "下さい": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "下さる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "下し": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
 "下しあ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "下し薬": "مُلَيّن",
 "下す": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "下って": "بتواضع (بطريقة متواضعة) / ببخل, بتقتير (بطريقة بخيلة)\nمثال: خفض رأسه بتواضع / فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض.",
 "下っぱ": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / تَافِه",
 "下っ放れ": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "下っ端": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / تَافِه",
 "下っ腹": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "下つき": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "下に見る": "تَرَفَّعَ",
 "下の下": "أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية) / في أدنى مستوى (في أدنى وضع؛ الأقرب إلى الأرض)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى",
 "下の人": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "下の名前": "اسم أول, اسم شخصي (الاسم الذي يسبق اللقب)",
 "下の毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "下ばき": "سِرْوَال (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)\nمثال: هذا السروال يناسبني.",
 "下ぶくれ": "مُسْتَدِير الوَجْه (ذو وجه مستدير)",
 "下ぶれ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "下らない": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "下らぬ": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "下らん": "تافِه / غَبِيّ / غَبِيّ, أَحْمَق",
 "下り": "مُتَّجِهٌ لِلْأَسْفَل (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا نُزُولًا) / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "下りる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / تَقَاعَدَ / اِعْتَزَلَ / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "下り勾配": "مَنْزَل, مُنْحَدَر هَابِط (الخاصية التي يمتلكها منحدر أو سطح ينخفض للأسفل)",
 "下り口": "قِمَّة",
 "下り坂": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "下り場": "انخفاض, تراجع (تغير نحو الأسفل) / جرف, منحدر صخري (واجهة صخرية شديدة الانحدار والمرتفع) / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "下り物": "إفراز مهبلي (إفرازات من غدد عنق الرحم للمهبل؛ عادة ما تكون صافية أو بيضاء) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…) / خَلَاص",
 "下り腹": "إسهال (حركات أمعاء متكررة ومائية؛ يمكن أن تكون عرضاً لعدوى أو تسمم غذائي أو التهاب القولون أو ورم في الجهاز الهضمي)",
 "下る": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "下ろし": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / مِبْشَرَة",
 "下ろしたて": "جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر)",
 "下ろし薬": "سَقْط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله)\nمثال: أصيب عندما سقط.",
 "下ろし金": "مِبْشَرَة",
 "下ろす": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "下エジプト": "اَلدِّلْتَا اَلْوَجْهُ ٱلْبَحْرِيُّ",
 "下ネタ": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "下ル": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة.",
 "下下": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "下世話": "بَذِيء",
 "下中音": "تحت الوسطى ((موسيقى) النغمة السادسة في سلم كبير أو صغير (أو الثالثة تحت نغمة الأساس))",
 "下乗": "تَرَجَّل (تَرَجَّلَ: نَزَلَ من مَرْكُوبه؛ تَرَجَّلَت المرأةُ: اسْتَرْجَلَت)",
 "下人": "وَضِيع",
 "下仕事": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "下付": "مَنَحَ / مِنْحة",
 "下付き": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "下付き文字": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "下付き添え字": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "下付き添字": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "下付金": "إِعَانَة مَالِيَّة",
 "下位グループ": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "下位互換性": "توافقية مستقبلية",
 "下位分類": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "下位文化": "ثقافة فرعية (مجموعة اجتماعية داخل ثقافة وطنية لها أنماط مميزة من السلوك والمعتقدات)",
 "下位群": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "下位語": "اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)",
 "下側": "أسفل, جانب سفلي (الجانب السفلي من أي شيء)",
 "下働き": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / خَادِم, خَادِمَة",
 "下僕": "خادم رجل (خادم من الرجال)",
 "下僚": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "下刈り": "عُشْبَة ضَارَّة / بانْجو, حَشيش",
 "下制筋": "خافض (أداة يستخدمها الطبيب للضغط على جزء ما لأسفل أو جانباً) / عصب خافض (أي عصب يميل نشاطه إلى تقليل نشاط أو توتر جزء الجسم الذي يخدمه) / عضلة خافضة (أي عضلة هيكلية تسحب جزءاً من الجسم لأسفل)",
 "下剋上": "عِصْيَان, تَمَرُّد",
 "下剤": "مُلَيّن",
 "下劣": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "下半期": "شوط ثاني (الثاني من شوطين للعب)",
 "下半身": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "下取り": "استبدال, مقايضة (عنصر من الممتلكات يتم تقديمه كجزء من الدفع مقابل عنصر جديد)",
 "下口": "قِمَّة",
 "下司": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي) / فَلَّاح, فَلَّاحَة",
 "下合": "اقتران سفلي ((في علم الفلك) محاذاة الأرض وكوكب على نفس الجانب من الشمس)",
 "下名": "التَّالِي ذِكْرُهُ, المَذْكُور أَدْنَاه (على وشك أن يُذكَر أو يُحدَّد فيما يلي)",
 "下向き": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "下命": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "下品": "بَذِيء",
 "下唇動脈": "شريان شفوي سفلي (شريان هو فرع من الشريان الوجهي يغذي الشفة السفلى)",
 "下問": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "下四半期": "التربيع الثاني, التربيع المتناقص",
 "下回り": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / أسفل, جانب سفلي (الجانب السفلي من أي شيء)",
 "下園": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下土": "تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "下地": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات / انحناء, ميل (فعل الانحناء؛ الميل إلى الأمام) / ميل, نزعة (احتمالية مميزة أو استعداد طبيعي تجاه حالة أو طابع أو تأثير معين) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: أشار انحناء رأسه إلى موافقته / فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل) / صَلْصَةْ اَلصُّويَا",
 "下坂": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة",
 "下垂": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل) / مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف) / خَائِرُ القُوَى (ضَعِيفٌ مِنْ شِدَّةِ الإِنْهَاك)",
 "下垂体": "الغُدَّة النُخَامِيَّة",
 "下塗り": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "下士": "ضابط صفّ",
 "下士官": "ضابط صفّ",
 "下士官兵": "مجند (فرد ذكر مجند في القوات المسلحة)",
 "下士官学校": "صف ضابط, ضابط صف (ضابط عسكري يتم تعيينه من المجندين)",
 "下大静脈": "وريد أجوف سفلي (يتلقى الدم من الأطراف السفلية وأعضاء البطن ويصب في الجزء الخلفي من الأذين الأيمن للقلب؛ يتكون من اتحاد الوريدين الحرقفيين)",
 "下女": "خادمة (عاملة منزلية)",
 "下女下男": "خَادِم, خَادِمَة",
 "下婢": "فتاة خادمة (فتاة تعمل كخادمة)",
 "下家": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط) / يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "下宿": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح) / بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "下宿人": "مُسْتَأجِر",
 "下宿先": "إِقَامَة",
 "下宿屋": "بيت مفروش, نزل (منزل يتم فيه تأجير الغرف)",
 "下宿生": "طالب داخلي (تلميذ يعيش في المدرسة خلال الفصل الدراسي) / مقتحم السفينة, مهاجم (شخص يشق طريقه بالقوة للصعود على متن سفينة) / ساكن, نزيل (مستأجر في منزل شخص آخر)\nمثال: استعدوا لصد المقتحمين",
 "下屋": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "下属音": "تحت المهيمنة ((موسيقى) النغمة الرابعة في السلم الدياتوني)",
 "下層土": "تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "下層社会": "سِجِّين, عَالَم سُفْلِيّ",
 "下層階級": "بْرُولِيتَارِيَا",
 "下層雲": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "下山": "نُزُول / اَصْل",
 "下川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下帯": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "下座": "يمين المسرح (جزء المسرح الواقع على يمين الممثل عندما يواجه الجمهور)",
 "下座音楽": "دعم, مرافقة (جزء موسيقي (صوتي أو آلي) يدعم أو يوفر خلفية لأجزاء موسيقية أخرى)",
 "下弦": "التربيع الثاني, التربيع المتناقص",
 "下弦の月": "التربيع الثاني, التربيع المتناقص",
 "下張": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "下張り": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "下役": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "下御": "تَرَجَّل (تَرَجَّلَ: نَزَلَ من مَرْكُوبه؛ تَرَجَّلَت المرأةُ: اسْتَرْجَلَت)",
 "下愚": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "下手": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية / رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / يمين المسرح (جزء المسرح الواقع على يمين الممثل عندما يواجه الجمهور) / رَدِيء, مُتَخَبِّط (منفَّذ بشكل سيّئ ورديء) / طَائِش, مُتَهَوِّر (يَفْتَقِر إِلَى ضَبْط النَّفْس الحَكِيم) / غير حكيم, متهور (ليس حكيماً أو عاقلاً)\nمثال: تهور كبير من والدتها أن تشجعها على مثل هذه الأفكار الرومانسية السخيفة",
 "下手い": "رَدِيء, مُتَخَبِّط (منفَّذ بشكل سيّئ ورديء)",
 "下手くそ": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "下手っぴ": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "下手の長談義": "خَيْرُ الكَلَامِ مَا قَلَّ وَدَلَّ ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض)\nمثال: يبدو زيري بخير.",
 "下手をすると": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)",
 "下手を打つ": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "下手上手": "لِلْوَهْلَة اَلْأُولَى",
 "下手人": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "下手糞": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "下押し": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "下押す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "下拍": "نبرة هابطة, نقر قوي (النقر الأول في المقياس الموسيقي (مع حركة ذراع المايسترو للأسفل))",
 "下拵え": "تَحْضِير, إِعْدَاد",
 "下振れ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "下支え": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "下放れ": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "下敷": "بطانة السجاد (لبادة توضع تحت السجادة) / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "下敷き": "بطانة السجاد (لبادة توضع تحت السجادة) / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "下方": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下方に": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة.",
 "下書": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "下書き": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "下期": "شوط ثاني (الثاني من شوطين للعب)",
 "下木": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "下本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下条": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下染": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "下染め": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "下柳": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下検分": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "下様": "الطَّبَقَاتُ الدُّنْيَا",
 "下段": "سرير سفلي, مضجع سفلي (السرير السفلي من بين سريرين (أحدهما فوق الآخر))",
 "下民": "الْجَمَاهِير, العَامَّةُ / الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي)",
 "下気道": "المسلك التنفسي السفلي (الشعب الهوائية والرئتين)",
 "下水": "تَصْرِيف / مياه الصرف الصحي, مياه المجاري (مواد النفايات التي يتم نقلها في المجاري أو المصارف)",
 "下水処分": "تصريف مياه الصرف الصحي (التخلص من مياه الصرف الصحي)",
 "下水溝": "قناة تصريف (خندق لتصريف المياه الزائدة أو الصرف الصحي)",
 "下水道": "بَالُوعَة / خَيَّاط",
 "下沖": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下流": "مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / الطَّبَقَاتُ الدُّنْيَا",
 "下流社会": "الطَّبَقَاتُ الدُّنْيَا",
 "下渋り": "انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "下湯": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "下準備": "تَحْضِير, إِعْدَاد",
 "下火": "متناقص (للقمر) ((للقمر) يتعلق بالفترة التي يتناقص فيها السطح المرئي للقمر) / أفول, اضمحلال (انخفاض تدريجي في الحجم أو المدى)\nمثال: بعد البدر يأتي القمر المتناقص",
 "下火になる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "下物": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "下生え": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "下田": "بَالٍ",
 "下男": "خادم رجل (خادم من الرجال)",
 "下町": "مُنْخَفِض الوَضْع (ذو ارتفاع صغير فوق سطح الأرض أو الأفق أو مستوى البحر) / عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "下町言葉": "عُمَّالِيّ, مِن الطَّبَقَة العَامِلَة (ينتمي إلى من يعملون بأجر خاصة العمال اليدويين أو الصناعيين) / بِأَجْر سَاعِيّ, عُمَّالِيّ (يعمل بأجر ساعيّ بدلًا من راتب ثابت)",
 "下界": "حد أدنى ((رياضيات) عدد يساوي أو أقل من أي عدد آخر في مجموعة معطاة)",
 "下疳": "شانكر, قرحة صلبة (عقيدة صغيرة صلبة غير مؤلمة في موقع دخول مسبب المرض (مثل الزهري))",
 "下痢": "إِسْهَال",
 "下痢ピー": "إِسْهَال",
 "下痢止め": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "下痢症": "إِسْهَال",
 "下盤": "الجدار السفلي (الجدار السفلي لصدع مائل)",
 "下目": "رُتْبَة سُفْلَى (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "下直": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)",
 "下直筋": "مستقيمة سفلية (عضلة العين التي يدير انقباضها مقلة العين لأسفل وللداخل)",
 "下相談": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "下着": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "下着類": "ثياب داخلية, ملابس داخلية (رداء داخلي يلبس مباشرة على الجلد وتحت الملابس الخارجية)",
 "下知": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "下種": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي) / فَلَّاح, فَلَّاحَة",
 "下種野郎": "فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ) / بَوْش\nمثال: انظر من الفتحة.",
 "下稽古": "بَرُوفَة",
 "下積み": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "下穿": "سِرْوَال (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)\nمثال: هذا السروال يناسبني.",
 "下穿き": "سِرْوَال (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)\nمثال: هذا السروال يناسبني.",
 "下窪": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "下端": "باطن القوس, سقف سفلي (الجانب السفلي لجزء من مبنى (مثل قوس أو بروز أو عارضة))",
 "下等": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "下糸入れ": "مَكُّوك / مَكُوك",
 "下紐": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "下級": "لِلشَّبَاب, لِلنَّاشِئَة (يشمل الأشخاص اليافعين أو مُعَدّ لهم) / أدنى رتبة, أصغر سناً (أصغر سنًا؛ أدنى رتبة؛ أقصر في مدة الولاية أو الخدمة) / الأَصْغَر, الاِبْن (يُستخدم للأصغر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الابن عن أبيه) / أَصْغَر سِنّاً (الشخص الأصغر سناً بين اثنين)\nمثال: هي أصغر مني بسنتين",
 "下級審": "محكمة أدنى, محكمة ابتدائية (أي محكمة يمكن استئناف قراراتها أمام محكمة أعلى)",
 "下級生": "طالب مبتدئ (طالب جامعي ليس في السنة النهائية بعد)",
 "下級裁判所": "محكمة أدنى, محكمة ابتدائية (أي محكمة يمكن استئناف قراراتها أمام محكمة أعلى)",
 "下絵": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "下緒": "عقدة السيف (شرابة زخرفية على مقبض السيف)",
 "下線": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة))\nمثال: 下線のある文を訳しなさい。 — ترجم ما تحته خط.",
 "下縫い": "سقي اللحم (ترطيب الشواء أثناء طهيه) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً)",
 "下職": "مقاول",
 "下肢": "استمرارية, طول نفس (قوة البقاء والاستمرار)\nمثال: تلك المسرحية القديمة في برودواي لديها استمرارية حقاً",
 "下肢帯": "حزام حوضي, حوض (بنية الهيكل العظمي للفقاريات التي تدعم الأطراف السفلية في البشر والأطراف الخلفية أو الأجزاء المماثلة في الفقاريات الأخرى)",
 "下肥": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "下脚": "استمرارية, طول نفس (قوة البقاء والاستمرار)\nمثال: تلك المسرحية القديمة في برودواي لديها استمرارية حقاً",
 "下脹れ": "مُسْتَدِير الوَجْه (ذو وجه مستدير)",
 "下腕": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "下腸間膜動脈": "شريان مساريقي سفلي (ينشأ بالقرب من النهاية السفلية للأبهر ويغذي الأمعاء الغليظة)",
 "下腹": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "下腹部": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "下腿": "عُرْقُوب",
 "下膊": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "下膨れ": "مُسْتَدِير الوَجْه (ذو وجه مستدير)",
 "下船": "نزول (عملية نزول الركاب والطاقم من سفينة أو طائرة)",
 "下草": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "下落": "إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين",
 "下葺き": "مَأْهُول, مَبْنِيّ (مملوء بالسكّان والمستوطنين)",
 "下薬": "مُلَيّن",
 "下衆": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي) / فَلَّاح, فَلَّاحَة",
 "下衆野郎": "فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ) / بَوْش\nمثال: انظر من الفتحة.",
 "下行": "تَنَازُلِيّ",
 "下行大動脈": "أبهر نازل (الجزء النازل من الأبهر الذي يتفرع إلى الأبهر الصدري والأبهر البطني)",
 "下行結腸": "قولون نازل (جزء الأمعاء الغليظة الذي ينزل من القولون المستعرض إلى القولون السيني)",
 "下衣": "ملابس داخلية (رداء يلبس تحت ملابس أخرى)",
 "下見": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / كساء خارجي (مادة تطبق على السطح الخارجي للمبنى لجعله مقاومًا للعوامل الجوية)",
 "下見板": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / كساء خارجي (مادة تطبق على السطح الخارجي للمبنى لجعله مقاومًا للعوامل الجوية)",
 "下記": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "下読": "تَحْضِير, إِعْدَاد",
