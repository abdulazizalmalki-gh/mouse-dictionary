 "修旅": "جَوْلَة, نُزْهَة",
 "修景": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية) / تنسيق حدائق (حديقة مصممة لتأثير جمالي)\nمثال: أنفقوا قدراً كبيراً من المال على تنسيق الحدائق",
 "修業": "تمحيص, دراسة (القراءة بعناية بقصد التذكر)",
 "修正": "تَعْدِيل",
 "修正プログラム": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع)",
 "修正主義": "تَعْدِيلِيَّة",
 "修正法": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تصحيح, تعديل (فعل تقديم تحسين لاستبدال خطأ؛ تقويم) / تقويم (تحويل التيار المتردد إلى تيار مباشر) / تقطير, تكرير ((في الكيمياء) عملية تكرير أو تنقية مادة ما عن طريق التقطير)",
 "修正液": "مُصَحِّح",
 "修正論": "تَعْدِيلِيَّة",
 "修煉": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "修理": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة",
 "修理人": "عامل صيانة, مصلح (عامل ماهر ذكر وظيفته إصلاح الأشياء)",
 "修理屋": "مُسْتَوْدَع, مِرْآب / مَرْأَب, وَرْشَة / عامل صيانة, مصلح (عامل ماهر ذكر وظيفته إصلاح الأشياء)",
 "修理工場": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "修理店": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "修築": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة",
 "修練": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "修練者": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "修繕": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة\nمثال: この椅子は修繕する必要がある。 — هذا الكرسي يحتاج إلى الإصلاح.",
 "修繕工場": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "修羅": "نِصْف إِلٰه / صِرَاع / مطرقة ثقيلة, مِهدَّة (مطرقة ثقيلة طويلة المقبض تستخدم لدق الأوتاد أو الأسافين) / زلاجة (مركبة مثبتة على زحافات وتجرها الخيول أو الكلاب؛ للنقل فوق الثلج) / مجرى مائل, مزلقة (قناة مائلة يمكن للأشياء أن تنحدر عبرها) / مظلة (معدات إنقاذ تتكون من جهاز يمتلئ بالهواء ويبطئ سقوطك)",
 "修羅場": "صُعُوبَة",
 "修習": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "修行": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "修補": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة",
 "修覆": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "修訂": "تَصْحِيح",
 "修身": "أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "修辞": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "修辞学": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "修辞技法": "أداة بلاغية, محسن بديعي (استخدام للغة يخلق تأثيراً أدبياً (ولكن غالباً دون اعتبار للمعنى الحرفي))",
 "修辞法": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "修辞疑問": "اِسْتِفْهَام مَجَازِيّ",
 "修造": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة",
 "修道": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "修道会": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "修道僧": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "修道制度": "رهبانية (زهد كشكل من أشكال الحياة الدينية؛ يمارس عادة في مجتمع تحت قاعدة مشتركة ويتميز بالعزوبية والفقر والطاعة)",
 "修道士": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "修道女": "رَاهِبَة / نُون, ن",
 "修道尼": "رَاهِبَة / نُون, ن",
 "修道服": "عَادَة",
 "修道生活": "رهبانية (زهد كشكل من أشكال الحياة الدينية؛ يمارس عادة في مجتمع تحت قاعدة مشتركة ويتميز بالعزوبية والفقر والطاعة)",
 "修道者": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "修道院": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
