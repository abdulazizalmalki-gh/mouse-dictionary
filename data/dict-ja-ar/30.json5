 "保合": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "保合い": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "保合う": "رَصِيد / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "保命": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "保因者": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "保存": "مُحَافَظَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة. / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "保存処理": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "保存剤": "مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "保存庫": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "保存料": "مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "保存状態": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "保存的": "مُحَافِظ",
 "保守": "صِيَانَة / سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
