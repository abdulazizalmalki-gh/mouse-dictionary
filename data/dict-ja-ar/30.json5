 "会館": "قاعة اجتماعات, قاعة تجميع (قاعة يمكن لعدد كبير من الناس التجمع فيها)",
 "伜": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / بَانْك / قَضِيب, ذَكَر",
 "伝": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / صِلَة, صُلَة / عَلَاقَة, صِلَة / أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح. / سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ / طَرِيقَة, مِنْهَج",
 "伝い": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "伝い歩き": "رِحْلَة بَحْرِيَّة",
 "伝う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "伝え": "نقل الملكية العقارية (فعل نقل سند ملكية العقار من شخص لآخر) / رِسَالَة, خَبَر / تَقْلِيد",
 "伝えあう": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "伝える": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي.",
 "伝え合う": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "伝え漏れ": "إِغْفَال",
 "伝え話": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "伝わる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / صَادَفَ (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا. / سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "伝令": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "伝令兵": "عَدَّاء / عَدَّاءَة",
 "伝令者": "بَشِير, مُبَشِّر",
 "伝令ＲＮＡ": "حمض نووي ريبوزي رسول (القالب لتخليق البروتين؛ شكل الحمض النووي الريبوزي الذي يحمل المعلومات من الحمض النووي في النواة إلى مواقع الريبوسوم لتخليق البروتين في الخلية)",
 "伝助賭博": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه)) / احتيال, تلاعب (تضليل لفظي يهدف إلى استغلالك بطريقة ما)",
 "伝動": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ)",
 "伝唱": "تَقْلِيد",
 "伝声器": "أنبوب التحدث (أنبوب لنقل صوت الكلام من غرفة إلى أخرى)",
 "伝声管": "أنبوب التحدث (أنبوب لنقل صوت الكلام من غرفة إلى أخرى)",
 "伝奇的": "أُسْطُورِيّ",
 "伝家": "إرث عائلي, تحفة متوارثة (شيء كان موجوداً في العائلة لأجيال) / إرث عائلي, تحفة متوارثة ((قانون) أي ممتلكات يعتبرها القانون أو العرف غير قابلة للفصل عن الميراث وتورث معه)",
 "伝家の宝刀": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "伝導": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "伝導体": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "伝導度": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "伝導性": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "伝導率": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "伝手": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "伝承": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "伝授": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "伝搬": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ)",
 "伝播": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ)",
 "伝教": "عمل تبشيري, مهمة تبشيرية (العمل المنظم للمبشر الديني)",
 "伝書鳩": "حَمامَةٌ زاجِلة, حَمامٌ زاجِلٌ",
 "伝来": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ)",
 "伝来語": "دَخِيل, لَفْظ دَخِيل",
 "伝染": "سريان, عدوى (انتقال موقف أو حالة عاطفية بين عدد من الناس) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ) / عدوى, مرض معد (أي مرض ينتقل بسهولة عن طريق الاتصال)\nمثال: عدوى من المرح",
 "伝染す": "أَعْدَى",
 "伝染性": "مُعْدٍ",
 "伝染性単核球症": "داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "伝染性単核症": "داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "伝染性軟属腫": "مليساء معدية (مرض فيروسي يصيب الجلد يتميز بتورمات بيضاء مستديرة؛ ينتقل من شخص لآخر (غالبًا عند الأطفال أو البالغين الذين يعانون من ضعف في وظائف المناعة))",
 "伝染毒": "فِيرُوس, فَيْرُوس",
 "伝染病": "عدوى, مرض معد (أي مرض ينتقل بسهولة عن طريق الاتصال)",
 "伝法": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / نحاسي أصفر (مصنوع من النحاس الأصفر أو يشبهه (في اللون أو الصلابة)) / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "伝法肌": "تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / بِلَا قَوَاعِد, عَنِيف (يتسم بالفوضى في الفعل وتجاهل القواعد)",
 "伝票": "شيك الحساب, فاتورة الحساب (الفاتورة في مطعم) / فتاة وقحة (مصطلح ازدرائي لفتاة غير ناضجة أو تفتقر إلى الاحترام)\nمثال: طلب من النادل الحساب",
 "伝統": "تَقْلِيد",
 "伝統ある": "تَقْلِيدِيّ",
 "伝統中国医学": "اَلطِّبّ اَلصِّينِيّ",
 "伝統主義": "تقليدية, تمسك بالتقاليد (الالتزام بالتقاليد (خاصة في المسائل الثقافية أو الدينية)) / تَقْلِيدِيَّة, تَمَسُّك بِالتَّقَالِيد (الالتزام الصارم بالأساليب أو التعاليم التقليدية) / تقليدية (المذهب القائل بأن كل المعرفة مستمدة أصلاً من الوحي الإلهي وأنها تنتقل عن طريق التقاليد)",
 "伝統主義者": "ضَيِّقُ الأُفُقِ, مُتَزَمِّت (مُحَافِظٌ بِعِنَادٍ وَضَيِّقُ التَّفْكِيرِ) / تقليدي (من يلتزم بالآراء التقليدية)",
 "伝統的": "تَقْلِيدِيّ",
 "伝線": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "伝習": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "伝聞": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "伝言": "رِسَالَة, خَبَر / رِسَالَة, خَبَر / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "伝言ゲーム": "هَاتِف عَرَبِيّ, هَاتِف لَاسِلْكِيّ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "伝記": "سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ",
 "伝記作家": "كاتب سيرة (شخص يكتب سرداً لحياة شخص آخر)",
 "伝記作者": "كاتب سيرة (شخص يكتب سرداً لحياة شخص آخر)",
 "伝誦": "تَقْلِيد",
 "伝説": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "伝説上": "أُسْطُورِيّ",
 "伝説的": "أُسْطُورِيّ",
 "伝送": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ)",
 "伝送先": "وِجْهَة, وُجْهَة",
 "伝送制御プロトコル": "بْرُوتُوكُول التَّحَكُّم بِالنَّقْل (بروتوكول تم تطويره للإنترنت لنقل البيانات من جهاز شبكة إلى آخر)\nمثال: يستخدم بروتوكول التحكم بالنقل استراتيجية إعادة الإرسال لضمان عدم ضياع البيانات أثناء الإرسال",
 "伝送制御拡張": "ذئبة حمامية قرصية (مرض جلدي مزمن يتميز بطفح جلدي من آفات حمراء على الخدين وجسر الأنف)",
 "伝送経路遅延": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "伝送路": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "伝送速度": "بود ((علم الحاسوب) معدل نقل البيانات (بايت/ثانية) للمودم)",
 "伝道": "عمل تبشيري, مهمة تبشيرية (العمل المنظم للمبشر الديني)",
 "伝道師": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "伝道者": "مُبَشِّر / إِنْجِيلِيّ, بَشِير",
 "伝達": "إرسال, بث (فعل إرسال رسالة؛ التسبب في نقل رسالة) / ناقل الحركة, نظام النقل (التروس التي تنقل الطاقة من محرك السيارة عبر عمود الإدارة إلى المحور الحي) / إرسال, بث (التواصل عن طريق الإشارات المرسلة) / انتقال العدوى, عدوى (حادثة ينتقل فيها مرض معدٍ)",
 "伝音性難聴": "فقدان السمع التوصيلي (فقدان السمع بسبب مشاكل في عظام الأذن الوسطى)",
 "伝音難聴": "فقدان السمع التوصيلي (فقدان السمع بسبب مشاكل في عظام الأذن الوسطى)",
 "伝馬": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "伯": "عَدَّ / كُونْت / الْبَرَازِيل",
 "伯人": "بَرَازِيلِيّ",
 "伯叔": "أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "伯国": "الْبَرَازِيل / كونتِيّة / مُحَافَظَة, مُقَاطَعَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "伯夫人": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "伯母": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "伯母さん": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "伯母ちゃん": "خالة, عمة (أخت الأب أو الأم؛ زوجة العم أو الخال)",
 "伯爵": "عَدَّ / كُونْت",
 "伯爵夫人": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "伯父": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "伯父さん": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم. / شَيْخ, عَجُوز",
 "伯父ちゃん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "伯父上": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "伯父御": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "伯父者人": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "伯父貴": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "伴": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "伴い": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "伴う": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "伴なう": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "伴侶": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "伴侶動物": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان أَلِيف (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "伴天連宗": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "伴奏": "مُصَاحَبَة",
 "伴奏者": "مصاحب موسيقي (شخص يقدم مصاحبة موسيقية (عادة على البيانو))",
 "伴奏部": "مُصَاحَبَة",
 "伴性遺伝": "مرتبط بالجنس",
 "伴走": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "伶人": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية) / مؤدي عروض المنستريل, منشد متجول (مؤدٍ في عروض المنستريل (عروض موسيقية وكوميدية قديمة))",
 "伸し": "تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / إطالة, تمدد (تمرين مصمم لمد الأطراف والعضلات إلى أقصى حد لها) / سباحة جانبية (طريقة سباحة تتحرك فيها الذراعان للأمام والخلف بينما تقوم الساقان بركلة المقص)",
 "伸し上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "伸し上げる": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "伸し台": "لوح العجن, لوح المعجنات (لوح خشبي كبير يستخدم لعجن العجين)",
 "伸し板": "لوح العجن, لوح المعجنات (لوح خشبي كبير يستخدم لعجن العجين)",
 "伸し棒": "مِرْقَاق, فَرَّادَة",
 "伸す": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط / صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "伸ばし棒": "مِرْقَاق, فَرَّادَة",
 "伸ばす": "طَوَّلَ, أَطَالَ (قُدرة؛ غنى أو فضل) / طَالَ\nمثال: قاس طول السرير. / اِسْتَقَامَ (أَقَامَ نفسه) / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "伸び": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / إطالة, تمدد (تمرين مصمم لمد الأطراف والعضلات إلى أقصى حد لها) / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / إطالة (عملية تطويل شيء ما) / إطالة, تمديد (إضافة إلى طول شيء ما) / استطالة (صفة كون الشيء مستطيلاً أو ممدوداً)",
 "伸びしろ": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "伸びやか": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "伸びる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَدَّدَ / اِمْتَدَّ / طَوَّرَ",
 "伸びをする": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "伸び上がる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "伸び代": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "伸び伸び": "بارتياح, برغد (في راحة مالية) / بارتياح (براحة نفسية؛ دون توتر) / براحة (براحة جسدية)\nمثال: يعيشون برغد / بِسُرْعَة, عَاجِلًا",
 "伸び広がる": "مَدَّدَ / اِمْتَدَّ",
 "伸び率": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "伸び縮み": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "伸べる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "伸べ広げる": "مَدَّدَ / اِمْتَدَّ",
 "伸子": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "伸展": "تَمَدُّد / تَوَسُّع",
 "伸度": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "伸張": "تَمَدُّد / تَوَسُّع",
 "伸筋": "عضلة باسطة (عضلة هيكلية يمد انقباضها أو يبسط جزءاً من الجسم)",
 "伸縮": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "伸縮包帯": "رباط ضاغط مرن (ضمادة تحتوي على مادة قابلة للتمدد يمكنها تطبيق ضغط موضعي)",
 "伸縮性": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "伸縮法": "سلم متحرك للأجور (سلم أجور يتقلب استجابة لمؤشر تكلفة المعيشة)",
 "伸縮自在": "مَرِن",
 "伸長": "تَمَدُّد / تَوَسُّع",
 "伸開線": "مُلْتَفّ بِإِحْكَام ((لبعض الأصداف) ملتفّ بإحكام بحيث يختفي المحور) / مَطْوِيّ لِلدَّاخِل, مُنْدَلِق (خاصة لبتلات الأزهار أو الأوراق في البرعم؛ حوافه ملفوفة إلى الداخل)",
 "伺": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "伺い": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "伺いごと": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "伺い事": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "伺い知る": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "伺う": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / رَجَا (رَجَا يرْجُو رَجْوًا ورَجاءً ورَجاةً ورَجاءةً ورَجاوةً ومَرْجاةً: رجاه أملًا به؛ ورَجَاه: ناشده وتوسّل إليه)",
 "似げない": "مُخْتَلِف / عَلَى عَكْس, بِخِلَاف (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "似せる": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "似たもの同士": "قريب بعيد (قريب بعيد نوعاً ما؛ مألوف بما يكفي ليتم تحيته بقبلة)",
 "似たり": "مُزَيَّف / صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "似た者同士": "قريب بعيد (قريب بعيد نوعاً ما؛ مألوف بما يكفي ليتم تحيته بقبلة)",
 "似つかわしい": "مُنَاسِب, مُلَائِم",
 "似て非なる": "زَائِف, مَنْحُول (كاذب أو مُقلَّد؛ ليس كما يبدو عليه) / لَقِيط, نَغْل (وُلِدَ خارِج إِطار الزَّواج الشَّرْعِيّ) / زَائِف, مُضَلِّل (يبدو معقولًا لكنه كاذب في حقيقته) / زَائِف, مُزَيَّف (يَبْدُو صَحِيحًا ظَاهِرِيًّا لَكِنَّهُ غَيْرُ صَحِيحٍ فِعْلِيًّا)",
 "似る": "شَبِهَ / مَاثَلَ",
 "似合い": "صَيْرُورَة",
 "似合う": "بَذْلَة, بَدْلَة / رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات) / نَاسَبَ\nمثال: تمثال الحرية رمز لأمريكا.",
 "似合しい": "مُنَاسِب, مُلَائِم",
 "似合わしい": "مُنَاسِب, مُلَائِم",
 "似姿": "تمثال رمزي, دمية (تمثيل لشخص (خاصة في شكل نحت))\nمثال: تحمل العملة صورة لينكولن",
 "似寄り": "تَشَابُه, شَبَه",
 "似寄る": "شَبِهَ / مَاثَلَ",
 "似気ない": "مُخْتَلِف / عَلَى عَكْس, بِخِلَاف (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "似気無い": "مُخْتَلِف / عَلَى عَكْس, بِخِلَاف (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "似非": "زَائِف, بَاطِل / كَاذِب",
 "似非理屈": "سفسطة (حجة غير صحيحة عمدًا تظهر البراعة في التفكير على أمل خداع شخص ما)",
 "似非科学": "علم زائف (نشاط يشبه العلم ولكنه يعتمد على افتراضات مغلوطة)",
 "似非笑い": "إِهْلَاس",
 "似非者": "زَائِف, مُتَظَاهَر بِه (مُتَّخَذ بغرض الخداع والتضليل) / زائف, مزيف (شيء هو تزييف؛ ليس كما يبدو) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "似顔": "صُورَة / بُورْتْرِيَّة",
 "似顔書き": "رسام بورتريه, مصور وجوه (رسام أو راسم للصور الشخصية (البورتريه))",
 "似顔絵": "صُورَة / بُورْتْرِيَّة",
 "伽": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "伽芝居": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات)",
 "伽藍": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "伽藍堂": "فَارِغ / فَرَغَ",
 "伽藍鳥": "بَجَع",
 "但し": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "但し付き": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "但し書": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "但し書き": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "但書": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "但書き": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "佇い": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "佇まい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "佇み": "مَعِيشَة, مَعَاش",
 "位": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / دَرَجَة / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: سجلت رقم هاتفه.",
 "位する": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "位の高い": "عَالِيّ الرُتْبَة",
 "位付け": "ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "位取り": "دَرَجَة",
 "位取り表現法": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة الحرف على موضعه)",
 "位取り表記法": "تدوين موضعي, نظام تمثيل موضعي (نظام عد يتم فيه تمثيل العدد الحقيقي بمجموعة مرتبة من الأحرف حيث تعتمد قيمة الحرف على موضعه)",
 "位取る": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "位数": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "位格": "أُقْنُوم / حالة الظرفية المكانية, حالة المكان (حالة تستخدم للإشارة إلى المكان، أو المكان الذي يحدث فيه الشيء)",
 "位相": "مَرْحَلَة / طوبولوجيا / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "位相変調": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / بَعْد الظُّهْر, مَسَاءً (بين الظهر ومنتصف الليل) / تضمين الطور (تضمين طور الموجة الحاملة) / رئيس الوزراء البريطاني (الشخص الذي يشغل منصب رئيس الحكومة في المملكة المتحدة)\nمثال: لنلتقي في الساعة 8 مساءً",
 "位相変調方式": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / بَعْد الظُّهْر, مَسَاءً (بين الظهر ومنتصف الليل) / تضمين الطور (تضمين طور الموجة الحاملة) / رئيس الوزراء البريطاني (الشخص الذي يشغل منصب رئيس الحكومة في المملكة المتحدة)\nمثال: لنلتقي في الساعة 8 مساءً",
 "位相幾何学": "طوبولوجيا",
 "位相空間": "فضاء الطور ((الفيزياء) فضاء مثالي تمثل فيه الأبعاد الإحداثية المتغيرات المطلوبة لوصف نظام أو مادة)\nمثال: فضاء طور متعدد الأبعاد / فضاء رياضي, فضاء طوبولوجي ((الرياضيات) أي مجموعة من النقاط تحقق مجموعة من المسلمات من نوع ما)\nمثال: افترض أن الفضاء الطوبولوجي محدود الأبعاد",
 "位相速度": "سرعة الطور",
 "位置": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "位置づけ": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "位置づける": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "位置どり": "تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / مُحَاذٍ, مُوَضِّع (يجعل الأشياء تنتظم في صف أو في موضعها)",
 "位置エネルギー": "طاقة وضع (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "位置付け": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "位置付ける": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "位置取り": "تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / مُحَاذٍ, مُوَضِّع (يجعل الأشياء تنتظم في صف أو في موضعها)",
 "位置合わせ": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "位置感覚": "إدراك الوضعية, استقبال الحس العميق (القدرة على استشعار موضع ومكان واتجاه وحركة الجسم وأجزائه)",
 "位置揃え": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "位置決め": "تَسْجِيل / تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / مُحَاذٍ, مُوَضِّع (يجعل الأشياء تنتظم في صف أو في موضعها)",
 "位置決め時間": "وقت البحث ((في علم الحاسوب) الوقت الذي يستغرقه رأس القراءة/الكتابة للانتقال إلى مسار بيانات محدد)",
 "位置調整": "تَبْرِير / تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / مُحَاذٍ, مُوَضِّع (يجعل الأشياء تنتظم في صف أو في موضعها)",
 "低": "حَزين / خافِت, مُنْخَفِض",
 "低い": "حَزين / خافِت, مُنْخَفِض / قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / عَمِيق, غَوِيط",
 "低まる": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "低み": "مُنْخَفِض الوَضْع (ذو ارتفاع صغير فوق سطح الأرض أو الأفق أو مستوى البحر) / عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "低め": "حَزين / خافِت, مُنْخَفِض",
 "低める": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "低カリウム血症": "نقص بوتاسيوم الدم (مستوى منخفض بشكل غير طبيعي للبوتاسيوم في الدم المتداول مما يؤدي إلى الضعف وتشوهات القلب؛ يرتبط بأورام الغدة الكظرية أو الجوع أو تناول مدرات البول)",
 "低レベル": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低レベル放射性廃棄物": "نفايات مشعة منخفضة المستوى ((طب) نفايات مشعة تتكون من أشياء تعرضت للإشعاع لفترة وجيزة (كما في بعض الفحوصات الطبية))",
 "低下": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "低予算": "مَحْدُود المِيزَانِيَّة (مصنوع أو مناسب لميزانية محدودة)",
 "低位株": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "低体温": "انخفاض حرارة الجسم",
 "低体温症": "انخفاض حرارة الجسم",
 "低価格化": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "低俗": "بَذِيء",
 "低利資金": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "低利金": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "低利金融": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "低刺激": "مِن غَيْر المُرَجَّح أَن يُسَبِّب حَسَاسِيَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "低劣": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "低吟": "دندنة (فعل الغناء بشفاه مغلقة) / دندنة, همهمة (صوت همهمة)\nمثال: همهمة حركة المرور البعيدة",
 "低周波": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها) / تَرَدُّد مُنْخَفِض (30 إلى 300 كيلوهرتز)",
 "低品質": "جودة منخفضة, دونية (جودة متدنية)",
 "低唱": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "低地": "مُنْخَفَض",
 "低地ドイツ語": "الألمانية السفلى, بلات دويتش (لهجة ألمانية يتم التحدث بها في شمال ألمانيا)",
 "低地帯": "مُنْخَفِض الوَضْع (ذو ارتفاع صغير فوق سطح الأرض أو الأفق أو مستوى البحر) / عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "低声": "هَمْس / هَمَسَ, وَسْوَسَ",
 "低姿勢": "توارٍ عن الأنظار, ظهور منخفض (حالة من قلة الظهور يتم فيها تجنب لفت انتباه الجمهور)\nمثال: لم يكن أبداً ممن يفضلون التواري عن الأنظار",
 "低学歴": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低家賃": "إيجار رمزي (إيجار منخفض جداً أو اسمي)",
 "低密": "رقة, ندرة (جودة التخلخل (قلة الكثافة))\nمثال: رقة الغلاف الجوي العلوي",
 "低密度リポタンパク": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "低密度リポ蛋白": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "低密度リポ蛋白質": "بروتين دهني منخفض الكثافة (بروتين دهني ينقل الكوليسترول في الدم؛ يتكون من كمية معتدلة من البروتين وكمية كبيرة من الكوليسترول؛ يُعتقد أن المستويات العالية منه ترتبط بزيادة خطر…)",
 "低層": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低層住居専用地域": "منخفض الارتفاع (تستخدم للمباني المكونة من طابق واحد أو بضعة طوابق وعادة لا يوجد مصعد؛ منخفض)\nمثال: يطل على أسطح مبانٍ سكنية منخفضة الارتفاع",
 "低年齢": "صَغِير, حَدَث",
 "低廉": "رَخِيص",
 "低所得者医療扶助": "رعاية طبية للمحتاجين, ميديكيد (رعاية صحية للمحتاجين؛ برنامج ممول فيدرالياً ومن الولاية (في الولايات المتحدة))",
 "低木": "شُجَيْرَة / شَرَاب",
 "低木層": "أشجار الطبقة السفلى",
 "低栄養": "سوء التغذية, نقص التغذية (عدم الحصول على ما يكفي من الغذاء للنمو أو العمل بشكل طبيعي)",
 "低次": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低次元": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低気圧": "غَيْر ضَاغِط, هَادِئ (ليس قسرياً أو ضاغطاً) / حدة المزاج, سوء المزاج (حالة مزاجية غاضبة مستمرة)",
 "低水準": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب)",
 "低水準言語": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低減": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "低温": "انخفاض درجة الحرارة, برد (غياب الحرارة)\nمثال: جعلت البرودة أنفاسنا مرئية",
 "低温物理学": "علم فيزياء درجات الحرارة المتدنية, كرايوجينيك (فرع الفيزياء الذي يدرس الظواهر التي تحدث عند درجات حرارة منخفضة جداً)",
 "低温生物学": "علم الأحياء البردي (فرع علم الأحياء الذي يدرس تأثيرات درجات الحرارة المنخفضة على الأنسجة الحية أو الأعضاء أو الكائنات الحية)",
 "低湿地": "سَلْخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة) / اِنْسَلَخَ, سَلَخَ\nمثال: سلخ زيري ذلك الغزال.",
 "低潮": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "低炭素鋼": "صلب طري, فولاذ لين (فولاذ يحتوي على أقل من 0.15% كربون)",
 "低空飛行": "مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً)",
 "低級": "مُنْخَفِض الدَّرَجَة",
 "低級言語": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "低置": "حَزين / خافِت, مُنْخَفِض",
 "低能": "حماقة, غباء (خطأ سخيف) / بلاهة (تخلف عقلي أشد من البله ولكن ليس بشدة العته)",
 "低能者": "أَبْلَه, مَعْتُوه (ذو عمر عقلي يتراوح بين ثلاث وسبع سنوات) / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "低脂肪乳": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "低脂肪牛乳": "حليب قليل الدسم (حليب تم تقليل محتواه من الدهون)",
 "低落": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "低血圧症": "انخفاض ضغط الدم, هبوط الضغط (انخفاض غير طبيعي في ضغط الدم)",
 "低血糖": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء التغذية)",
 "低血糖症": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء التغذية)",
 "低語": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "低調": "خَامِد",
 "低資": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "低軌道": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "低迷": "حَامَ (دار أو طاف حول شيء؛ اقترب من شيء دون الوصول إليه)",
 "低速ギヤ": "الترس الأول, السرعة الأولى (أدنى نسبة تروس أمامية في صندوق تروس المركبة؛ تستخدم لبدء تحرك السيارة)",
 "低速車": "بَطِيء الحَرَكَة (يَتَحَرَّك بِبُطْء)",
 "低酸素症": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "低開発国": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "低音": "غيتار البيس",
 "低音部記号": "مفتاح الباص, مفتاح فا (مفتاح)\nمثال: بحث عن المفتاح.",
 "低頻度": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها) / تَرَدُّد مُنْخَفِض (30 إلى 300 كيلوهرتز)",
 "低騒音": "صَامِت, هَادِئ",
 "住": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل.",
 "住い": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "住す": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "住する": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "住まい": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "住まい手": "سَاكِن, سَاكِنَة",
 "住まう": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "住みか": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد)",
 "住みつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "住みにくい": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "住みやすい": "مُنَاسِب, مُلَائِم",
 "住み分け": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تجزئة, تقسيم نفسي (حالة خفيفة من التفكك النفسي)",
 "住み分ける": "فَرَّقَ",
 "住み心地": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "住み所": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "住み手": "مُسْتَأْجِر",
 "住み易い": "مُنَاسِب, مُلَائِم",
 "住み替え": "مُتَحَرِّك / مُؤَثِّر",
 "住み着く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "住み込む": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "住み難い": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "住む": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "住人": "ساكن, قاطن (شخص يسكن في مكان معين) / مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "住処": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد)",
 "住宅": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "住宅ローン": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "住宅団地": "مجمع سكني, مشروع سكني (منطقة سكنية تضم مساكن متشابهة بناها مطورون عقاريون وتخضع عادة لإدارة واحدة)\nمثال: يعيشون في المجمع السكني الجديد",
 "住宅地": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住宅地区": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住宅産業": "صناعة الإسكان, صناعة البناء والتشييد (صناعة تقوم ببناء المساكن)",
 "住宅用火災警報器": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "住宅街": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住宅設備": "أداة منزلية, جهاز منزلي (جهاز يؤدي وظيفة محددة في المنزل)",
 "住家": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد) / مَجْلِس",
 "住居": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل.",
 "住居侵入罪": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "住居地域": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住屋": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور كلَّ ليلة في أَحدها)\nمثال: لقد هدأ المنزل.",
 "住所": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "住所地": "مأوى, مسكن (سكن يعيش فيه شخص ما) / مقر إقامة, موطن قانوني ((في القانون) المسكن الذي يوجد به منزلك الدائم أو مؤسستك الرئيسية وإليه تنوي العودة كلما تغيبت؛ يُلزم كل شخص بأن يكون له موطن واحد فقط في كل مرة)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "住所録": "قَائِمَة بَرِيدِيَّة",
 "住替え": "مُتَحَرِّك / مُؤَثِّر",
 "住民": "سَاكِن, سَاكِنَة",
 "住民投票": "اِسْتِفْتَاء عَام (تصويت من قبل الناخبين لتحديد الرأي العام حول مسألة ذات أهمية وطنية)",
 "住環境": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "住着く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "住空間": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "住職": "رَئِيس الدَّيْر, أَبَاتِي",
 "住血吸虫": "بلهارسيا, منشقة (ديدان مفلطحة تتطفل في الأوعية الدموية للثدييات)",
 "住血吸虫症": "بلهارسيا, داء البلهارسيات (عدوى طفيلية تسببها طفيليات من جنس البلهارسيا؛ شائعة في المناطق الاستوائية والشرق الأقصى)",
 "住設": "أداة منزلية, جهاز منزلي (جهاز يؤدي وظيفة محددة في المنزل)",
 "住警器": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "佐官": "ضابط ميداني (ضابط يحمل رتبة رائد أو مقدم أو عقيد)",
 "佐賀": "مَلحَمَة",
 "佑助": "مُسَاعَدَة, إِمْدَاد",
 "体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / جِذْع, جِسْم (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "体が弱い": "رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / ضَعِيف, قَابِل لِلْخَطَأ (يفتقر إلى القوّة الأخلاقيّة أو الشجاعة؛ له صفات بشريّة مقابل الكائنات الإلهيّة) / ضعيف, واهن (ضعيف جسدياً) / سلة فواكه مجففة, قفة (سلة لحفظ الفاكهة المجففة (خاصة الزبيب أو التين))\nمثال: جسد المريض الواهن",
 "体ごと": "جَسَدِيّ, بَدَنِيّ",
 "体じゅう": "جَمِيع أَنْحَاء, كُلّ",
 "体たらく": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "体つき": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "体づくり": "كَمَال أَجْسَام",
 "体に悪い": "غَيْر صِحِّيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "体の不自由": "مُعَوَّق",
 "体の弱い": "رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / ضَعِيف, قَابِل لِلْخَطَأ (يفتقر إلى القوّة الأخلاقيّة أو الشجاعة؛ له صفات بشريّة مقابل الكائنات الإلهيّة) / ضعيف, واهن (ضعيف جسدياً) / سلة فواكه مجففة, قفة (سلة لحفظ الفاكهة المجففة (خاصة الزبيب أو التين))\nمثال: جسد المريض الواهن",
 "体よく": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق) / بِاحْتِشَام, بِشَكْل لَائِق (بطريقة لائقة)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "体をかわす": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "体を交える": "ضَاجَعَ, جَامَعَ",
 "体を起こす": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "体を躱す": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "体を開く": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "体中": "جَمِيع أَنْحَاء, كُلّ",
 "体付き": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "体位": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / وَضْعِيَّة",
 "体作り": "كَمَال أَجْسَام",
 "体内時計": "سَاعَة بَيُولُوجِيَّة (آلية فطرية في الكائنات الحية تتحكم في دورية العديد من الوظائف الفسيولوجية)",
 "体刑": "عُقُوبَةٌ بَدَنِيَّة",
 "体制": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَأْسِيس / مُؤَسَّسَة / تَشْرِيح",
 "体制側": "تَأْسِيس / مُؤَسَّسَة",
 "体力": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "体力的": "مَادِّيّ, مَلْمُوس",
 "体勢": "وَضْعِيَّة",
 "体型": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية / نمط الجسم (فئة من البنية الجسدية)",
 "体外離脱": "تجربة الخروج من الجسد (التجربة الانفصالية لمراقبة الذات من منظور خارجي كما لو أن العقل أو الروح قد غادر الجسد ويقوم بمراقبته)",
 "体幹": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "体形": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "体得": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية",
 "体循環": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "体性感覚": "إحساس جسدي, حس جسدي (إدراك الأحاسيس اللمسية أو استقبال الحس العميق أو الأحاسيس الحشوية)\nمثال: اعتمد على الحس الجسدي لتحذيره من تغيرات الضغط",
 "体感": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "体技": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "体操": "جُمْبَاز / تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "体操場": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "体操選手": "لاعب جمباز (رياضي ماهر في الجمباز)",
 "体文": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "体格": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "体格検査": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "体様": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "体毛": "شَعْرُ الجِسْم (شعر قصير ينمو على جسم الإنسان)",
 "体況": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "体液": "سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / مَنِيّ",
 "体温": "درجة حرارة الجسم (درجة حرارة الجسم؛ عادة 37 درجة مئوية في البشر)\nمثال: 看護婦が彼の体温を計った。 — قاست الممرضة حرارته.",
 "体温器": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "体温計": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "体現": "تَجْسِيد",
 "体現者": "تَجَسَّد",
 "体積": "سِعَة",
 "体積弾性率": "مُعَامِل الْمُرُونَة الْحَجْمِيّ (نسبة التغير في الضغط المؤثر على حجم ما إلى التغير النسبي في الحجم)",
 "体節": "جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل) / جُزْء, فَلْقَة (أحد الأجزاء التي ينقسم إليها الشيء بشكل طبيعي)\nمثال: قسم من صنارة الصيد",
 "体節制": "تجزئة, تقسيم (عملية التقسيم أو التجزئة؛ الفصل عن طريق إنشاء حدود تقسم أو تبقي الأشياء متباعدة) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة)",
 "体節動物": "تَلَفَّظَ",
 "体系": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "体系だった": "منظم, مهيكل (لديه هيكل محدد ومنظم للغاية) / مُتَكَامِل, مُهَيْكَل (يُشبه الكائن الحي في التنظيم أو التطور)\nمثال: بيئة منظمة",
 "体系化": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق)",
 "体系学": "علم التصنيف (علم التصنيف المنهجي)",
 "体系的": "مُمَنْهَج",
 "体系立った": "منظم, مهيكل (لديه هيكل محدد ومنظم للغاية) / مُتَكَامِل, مُهَيْكَل (يُشبه الكائن الحي في التنظيم أو التطور)\nمثال: بيئة منظمة",
 "体細胞": "خلية إنباتية, خلية جسدية (أي من خلايا النبات أو الحيوان باستثناء الخلايا التناسلية؛ خلية لا تشارك في إنتاج الأمشاج)\nمثال: تنتج الخلايا الجسدية من خلايا موجودة مسبقاً",
 "体罰": "عُقُوبَةٌ بَدَنِيَّة",
 "体育": "تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "体育家": "رِيَاضِيّ, رِيَاضِيَّة",
 "体育祭": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق) / يوم حافل, يوم ممتع (وقت من المتعة والنجاح غير المعتاد) / يوم رياضي (يوم للمنافسات الرياضية الخارجية) / يوم مناورات ((عسكرية) يوم للتدريبات والعروض العسكرية)",
 "体育館": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "体腔": "جوف, سيلوم (تجويف في الأديم المتوسط للجنين يؤدي في البشر إلى التجويف الجنبي وتجويف التامور والتجويف البريتوني)",
 "体臭": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام)",
 "体良く": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق) / بِاحْتِشَام, بِشَكْل لَائِق (بطريقة لائقة)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "体色": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "体菜": "كُرُنْب صِينِيّ, بُوك تْشُوي",
 "体裁": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / تنسيق, شكل (المظهر العام لمنشور) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "体裁よく": "بذوق رفيع (بذوق؛ بطريقة تنم عن ذوق)\nمثال: كان المنزل مزيناً بذوق رفيع",
 "体裁良く": "بذوق رفيع (بذوق؛ بطريقة تنم عن ذوق)\nمثال: كان المنزل مزيناً بذوق رفيع",
 "体調": "حَالَة بَدَنِيَّة, حَالَة فِسْيُولُوجِيَّة (حالة الجسم أو وظائفه الحيويّة)\nمثال: 最近あまり体調が良くないの。 — أنا لا أشعر بالراحة مؤخرا.",
 "体調を崩す": "مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "体調不良": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "体調管理": "رِعَايَة صِحِّيَّة",
 "体貌": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "体質": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "体質改善": "إِصْلَاح",
 "体質的": "بُنْيَوِيّ / دُسْتُورِيّ",
 "体躯": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "体軀": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "体軸": "مِحْوَرِيّ (واقِع عَلى المِحْوَر أَوْ في اتِّجاهِه) / محوري (من أو متعلق بـ أو يشبه محور الدوران) / محوري (يتعلق بـ أو متصل بالمحور)\nمثال: زاوية محورية",
 "体重": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "体重計": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "体量": "وزن الجسم (وزن جسم الشخص)",
 "体長": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "体面": "شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "体験": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "体験学習": "تَطْبِيقِيّ, مُبَاشِر (ينطوي على مشاركة فعليّة ومباشرة)",
 "体験者": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "体験談": "سَرْدِي / قِصَّة, حِكَايَة / سَرْدِيَّة, رِوَايَة",
 "体高": "اِرْتِفَاع",
 "何": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / مَا اِسْمَهُ (انظر مَا)\nمثال: هلا! ما الجديد؟ / قَضِيب, ذَكَر / أبداً / يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / كَم / كَمْ\nمثال: ここの家、何匹猫がいるの？ — كم عدد القطط الموجودة في هذا المنزل ؟ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "何々": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "何か": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何かしら": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "何かと": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "何から何まで": "مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何から何迄": "مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何か別": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "何か月も": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "何か無しに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "何か物": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何か知ら": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "何があっても": "مَهْمَا",
 "何があろうと": "مَهْمَا",
 "何がし": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何がな": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "何が何だか": "طُرَّةٌ أَم نَقْشٌ, طُرَّةٌ أَو نَقْشٌ",
 "何が何でも": "بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "何が何やら": "طُرَّةٌ أَم نَقْشٌ, طُرَّةٌ أَو نَقْشٌ",
 "何が悲しくて": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد. / لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "何げなく": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "何ごと": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / كُلّ شَيْء",
 "何ごとか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "何ごとも": "كُلّ شَيْء / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "何さま": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / مطلقا, على الإطلاق",
 "何しろ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / لِأَنَّ / هكذا, بلا سبب",
 "何じゃ": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "何するものぞ": "تافِه",
 "何せ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "何ぞ": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "何ぞや": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "何たって": "مَهْمَا",
 "何たる": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "何だ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة",
 "何だか": "صَغِير, صغير / قَلِيلاً, قَلِيل",
 "何だって": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何ちゅう": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "何つったって": "مَهْمَا",
 "何てこった": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "何てことない": "عَادِيّ, مَأْلُوف",
 "何てことのない": "عَادِيّ, مَأْلُوف",
 "何てったって": "مَهْمَا",
 "何て言っても": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "何であれ": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى.",
 "何でかと言うと": "لِأَنَّ / هكذا, بلا سبب",
 "何でも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何でもかでも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "何でもかんでも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "何でもない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "何でも屋": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات / متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "何でも彼でも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "何でも無い": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "何と": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة) / بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: كان ودوداً بشكل مفاجئ / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "何という": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "何といっても": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "何とか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何とかかんとか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何とかして": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "何とか彼とか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何としてでも": "بِأَيِّ ثَمَنٍ",
 "何としても": "بِأَيِّ ثَمَنٍ",
 "何とぞ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "何とでも": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى.",
 "何となく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何となし": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何となれば": "لِأَنَّ / هكذا, بلا سبب",
 "何とも": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا . / أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何ともいえない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "何ともない": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "何ともはや": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "何とも無い": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "何とも言えない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "何とやら": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "何と無し": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何と言う": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "何と言うか": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "何と言ったって": "مَهْمَا",
 "何と言っても": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "何なら": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "何なり": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何なりと": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何なりとも": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何にしても": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "何にしろ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "何にせよ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "何にでも": "كُلّ شَيْء",
 "何にも": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / كُلّ شَيْء",
 "何にもならない": "عَقِيم",
 "何によらず": "أَيّ (واحد أو بعض أو كلّ دون تحديد؛ مُبهَم الدلالة)",
 "何に依らず": "أَيّ (واحد أو بعض أو كلّ دون تحديد؛ مُبهَم الدلالة)",
 "何の": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "何のあたり": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "何のこった": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "何のこと": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "何のことはない": "تافِه",
 "何のことは無い": "تافِه",
 "何の事": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "何の事はない": "تافِه",
 "何の事は無い": "تافِه",
 "何の変哲もない": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "何の変哲も無い": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "何の役にも立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "何の様に": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ\nمثال: あなたはどのようにしてその問題を解いたのですか。 — كيف تخلصت من المشكلة؟",
 "何の気なしに": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "何はさておき": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "何はともあれ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "何ひとつ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "何びと": "مَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何ぶん": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "何べんも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "何ほど": "كَمْ",
 "何ぼ": "كَمْ / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "何ぼう": "كَمْ / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "何も": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / أبداً",
 "何もの": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何ものか": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "何やつ": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何やら": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "何ゆえ": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "何より": "الأهم, قبل كل شيء (فوق كل اعتبار آخر) / أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً / أَفْضَل",
 "何よりもまず": "بَادِئَ ذِي بَدْءٍ",
 "何よりも先ず": "بَادِئَ ذِي بَدْءٍ",
 "何ら": "أبداً",
 "何らか": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "何らかの形で": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何れ": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَما / اَلَّذِي\nمثال: لم تقصد أي أذى. / كُلّ, جَمِيع / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "何れか": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "何れにしても": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "何れにしろ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "何れにせよ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "何れにも": "لَا أَحَد (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "何れも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何れも此れも": "كُلّ, جَمِيع",
 "何を": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "何ヵ月も": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "何ヶ月も": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "何一つ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "何事": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / كُلّ شَيْء",
 "何事か": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "何事も": "كُلّ شَيْء / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "何事もなく": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "何事も無く": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "何人": "مَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何人も": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ)",
 "何何": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "何兆": "بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة الأمريكية)) / تِرِيلِيُون / تِرِيلِْيُون\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية.",
 "何処": "أَيْن, فين / حَيْثُ\nمثال: あなたはどこでテレビを見ますか。 — أين تشاهد التلفاز؟ / كَمْ",
 "何処いら": "أَيْن, فين / حَيْثُ",
 "何処から何処まで": "جَمِيع أَنْحَاء, كُلّ",
 "何処だって": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "何処でも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "何処となく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何処ともなく": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何処とも無く": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何処にでも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان",
 "何処にでもある": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / عَادِيّ تَمَامًا, مُبْتَذَل (عادي تماماً ولا يستحق الملاحظة) / مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "何処にでもいる": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / عَادِيّ تَمَامًا, مُبْتَذَل (عادي تماماً ولا يستحق الملاحظة) / مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "何処にも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "何処にも彼処にも": "جَمِيع أَنْحَاء, كُلّ",
 "何処へも": "فِي لَا مَكَان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "何処までも": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث / بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار / باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة",
 "何処も": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي لَا مَكَان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "何処もかも": "جَمِيع أَنْحَاء, كُلّ",
 "何処も彼処も": "جَمِيع أَنْحَاء, كُلّ",
 "何処やら": "مَكَان مَا (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何処ら": "أَيْن, فين / حَيْثُ",
 "何処を如何": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "何処何処": "كَذَا وَكَذَا, كَذَا",
 "何処其処": "كَذَا وَكَذَا, كَذَا",
 "何処吹く風": "لَا مُبَالٍ, مُتَهَتِّك (يَتَّسِمُ بِعَدَمِ المُبَالَاةِ بِالأَعْرَافِ أَوْ بِسُوءِ السُّمْعَة) / طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "何処迄も": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث / بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار / باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة",
 "何分": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "何分にも": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "何十": "عَشَرَة, عَشْرَة",
 "何卒": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "何回でも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "何回も": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "何奴": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何年": "كَم وَقْتًا, إِلَى مَتَى",
 "何度となく": "طورا بعد طور",
 "何度も": "كَثِيرًا, غَالِبًا",
 "何彼と": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "何心ない": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "何心無い": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "何所": "أَيْن, فين / حَيْثُ\nمثال: あなたはどこでテレビを見ますか。 — أين تشاهد التلفاز؟ / كَمْ",
 "何所やら": "مَكَان مَا (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何故": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "何故か": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何故かと言うと": "لِأَنَّ / هكذا, بلا سبب",
 "何故だか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "何故なら": "لِأَنَّ / هكذا, بلا سبب",
 "何故ならば": "لِأَنَّ / هكذا, بلا سبب",
 "何故に": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "何方": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَيْن, فين / حَيْثُ / مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何方か": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "何方付かず": "غَيْرُ مُلْتَزِم, مُتَحَفِّظ (يَرْفُضُ الالْتِزَامَ بِمَوْقِفٍ أَوْ مَسَارِ عَمَلٍ مُعَيَّن)",
 "何方道": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "何時": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "何時か": "في وقت ما, يوماً ما (في وقت غير محدد أو غير مصرح به)\nمثال: دعنا نجتمع يوماً ما",
 "何時かしら": "غير ملحوظ (لم يتم ملاحظته)\nمثال: أمل أن يكون رحيله قد مر دون أن يلاحظه أحد",
 "何時かは": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "何時から": "كَم وَقْتًا, إِلَى مَتَى",
 "何時しか": "غير ملحوظ (لم يتم ملاحظته)\nمثال: أمل أن يكون رحيله قد مر دون أن يلاحظه أحد",
 "何時ぞや": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "何時でも": "دَائِمًا, أَبَدًا / مَتَى, مَتَى مَا / كُلَّمَا",
 "何時なりと": "مَتَى, مَتَى مَا / كُلَّمَا",
 "何時にない": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "何時になく": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "何時にも増して": "خُصُوصًا, خَاصَّةً",
 "何時に無い": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "何時に無く": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "何時の日か": "يَوْمًا مَا",
 "何時の日にか": "يَوْمًا مَا",
 "何時の間に": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "何時の間にか": "غير ملحوظ (لم يتم ملاحظته)\nمثال: أمل أن يكون رحيله قد مر دون أن يلاحظه أحد",
 "何時の間にやら": "على حين غرة, في موقف حرج (في وضع غير موات أو مفاجئ) / على حين غرة, فجأة (فجأة وبشكل غير متوقع) / دون قصد, عن غير عمد (بدون تفكير مسبق أو خطة؛ سهواً)\nمثال: أُخذت على حين غرة (نفد ما لدي)",
 "何時までも": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "何時も": "دَائِمًا, أَبَدًا\nمثال: 彼はいつも学校に遅れる。 — دائماً يتأخر عن المدرسة. / أَبَدًا / عَادِيّ",
 "何時ものごとく": "كَالْعَادَة, كَالْمُعْتَاد",
 "何時もの通りに": "كَالْعَادَة, كَالْمُعْتَاد",
 "何時何分": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "何時何時": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "何時何時までも": "إلى أجل غير مسمى (إلى حد غير محدد؛ لفترة غير محددة)\nمثال: يمكن أن يستمر هذا إلى أجل غير مسمى",
 "何時何時迄も": "إلى أجل غير مسمى (إلى حد غير محدد؛ لفترة غير محددة)\nمثال: يمكن أن يستمر هذا إلى أجل غير مسمى",
 "何某": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何様": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / مطلقا, على الإطلاق",
 "何気ない": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / عَادِيّ, مَأْلُوف",
 "何気なく": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "何気に": "عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري. / بِصِدْقٍ",
 "何気無い": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / عَادِيّ, مَأْلُوف",
 "何気無く": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "何物": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "何百": "مِٱئَة, مِئَة",
 "何程": "كَمْ",
 "何等": "أبداً",
 "何等か": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "何者": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "何者か": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "何處": "أَيْن, فين / حَيْثُ\nمثال: あなたはどこでテレビを見ますか。 — أين تشاهد التلفاز؟ / كَمْ",
 "何遍も": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "佗人": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "余": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر. / فَوْقَ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "余す": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "余すことなく": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل",
 "余すところなく": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل",
 "余す所なく": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل",
 "余す所無く": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل",
 "余り": "بَقِيَّة / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "余りと言えば": "بإفراط, بشكل مبالغ فيه (لدرجة تتجاوز الحدود الطبيعية أو المناسبة)\nمثال: كبير جداً",
 "余りに": "أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ",
 "余りにも": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "余り物": "الْبَقَايَا",
 "余り者": "دخيل, متطفل (شخص يقتحم خصوصية أو ممتلكات آخر دون إذن)",
 "余る": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "余事": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "余人": "آخَرُون",
 "余儀ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "余儀なく": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "余儀なくさせる": "أَكْرَهَ, أَجْبَرَ",
 "余儀無くさせる": "أَكْرَهَ, أَجْبَرَ",
 "余光": "أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره",
 "余党": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي)",
 "余分": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "余切": "ظِلّ اَلتَّمَام (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "余剰": "فَائِض",
 "余割": "قَاطِعُ تَمَام",
 "余効": "أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية) / أثر تال, أثر لاحق (تأثير متأخر لدواء أو علاج)\nمثال: كان للدواء آثار تالية غير متوقعة",
 "余勢": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "余因子": "تميم, عامل مرافق (مادة (مثل الإنزيم المساعد) يجب أن تتحد مع مادة أخرى لإنتاج نتيجة معينة)",
 "余地": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض.",
 "余塵": "أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية) / أثر تال, أثر لاحق (تأثير متأخر لدواء أو علاج)\nمثال: كان للدواء آثار تالية غير متوقعة",
 "余弊": "أثر باق, بقية (شيء نجا وبقي من الماضي) / الباقي في المنصب (مسؤول يبقى في منصبه بعد انتهاء ولايته)\nمثال: بقية من الستينيات",
 "余弦": "جَيْب تَمَام (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "余得": "عائد الوظيفة, مكافأة المنصب (تعويض يتم تلقيه بحكم شغل منصب أو وظيفة (عادة في شكل أجور أو رسوم))",
 "余念なく": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "余念もなく": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "余念も無く": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "余念無く": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "余情": "إِيحَائِيَّة (حالة أو صفة الامتلاء بالإيحاءات وتحفيز الفكر)",
 "余慶": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "余憤": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "余所": "خَارِج, بره / تَجَاهَلَ, طَنَّش",
 "余所ながら": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "余所にする": "أَهْمَلَ / إِهْمَال",
 "余所の人": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "余所乍ら": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "余所様": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "余所者": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "余所聞き": "سُمْعَة, شُهْرَة",
 "余所行き": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "余技": "هواية (نشاط إضافي أو جانبي)",
 "余接": "ظِلّ اَلتَّمَام (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "余数": "بَقِيَّة / عُمْدَة",
 "余暇": "خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "余業": "هواية (نشاط إضافي أو جانبي)",
 "余業なく": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "余業無く": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "余水吐": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "余水吐き": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "余水路": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "余沢": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "余波": "أَعْقَاب",
 "余滴": "عصارة اللحم (الدهن الذي ينضح من اللحم ويقطر أثناء شوائه أو قليه)",
 "余瀝": "مَعْرُوف / أَنْعَمَ",
 "余燼": "جَمْرَة",
 "余病": "تَعْقِيد / مُضَاعَفَة",
 "余白": "فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص",
 "余白注": "مُلَاحَظَة هَامِشِيَّة",
 "余程": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / تَقْرِيبًا, عَلَى وَشْك",
 "余等": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "余聞": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "余興": "أَدَاء / مَسْرَحِيَّة",
 "余色": "لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "余裕": "فَائِض / اتزان, رباطة جأش (ثبات العقل تحت الضغط)\nمثال: تقبل مشاكلهم برباطة جأش وهي باتزان",
 "余裕のよっちゃん": "عَفْوًا",
 "余計": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "余計者": "الصنيَة",
 "余話": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "余説": "تَعْلِيق",
 "余談": "انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "余論": "رأي عارض, ملاحظة قضائية عارضة (رأي يبديه قاضٍ حول نقطة قانونية لا تؤثر بشكل مباشر على القضية المعنية وبالتالي ليست ملزمة) / رأي عارض, ملاحظة عابرة (ملاحظة عرضية)",
 "余輩": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "余録": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "余集合": "عُمْدَة",
 "余震": "هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ",
 "余韻": "تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية) / أصداء, تداعيات (عاقبة بعيدة أو غير مباشرة لإجراء ما)\nمثال: كانت تستطيع سماع أصداء خطواتها / طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / إِيحَائِيَّة (حالة أو صفة الامتلاء بالإيحاءات وتحفيز الفكر)",
 "余響": "صَدًى",
 "余齢": "مَأْمُول اَلْحَيَاة, مُتَوَسِّط العُمْر المُتَوَقَّع",
 "佚": "باعث على الاسترخاء, مريح (يوفر راحة جسدية أو عقلية)\nمثال: قضت ليلة مريحة في المنزل",
 "佚遊": "مُتْعَة, لَذَّة",
 "佛": "بُوذَا, بُدّ / مَيِّت",
 "佛國": "فَرَنْجَة / فرنسا (أوروبية تقع في الجزء الجنوبي الغربي من قارة أوروبا. كانت تسمى بلاد الإِفْرَنْجَ أو الفَرَنْجَة)\nمثال: نساء فرنسا جميلات.",
 "佛教": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "作": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "作す": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "作する": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "作り": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / سَاشِيمِي / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "作りこむ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "作りつけ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "作りつける": "صَلَّحَ / أَصْلَحَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "作り上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / اِفْتَرَى, اِخْتَلَقَ",
 "作り事": "فَبْرَكَة",
 "作り付け": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "作り付ける": "صَلَّحَ / أَصْلَحَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "作り出す": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / اِخْتَرَعَ",
 "作り名": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "作り変える": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "作り字": "مُخْتَلَق",
 "作り手": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / فَلَّاح, فَلَّاحَة",
 "作り方": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / وَصْفَة",
 "作り替える": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "作り泣き": "تخيل, تمثيل (تجسيد للتظاهر) / تَمْثِيلِيّ, مُتَظَاهِر (مُتَخَيَّل كما في اللعب أو التمثيل) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان مجرد تمثيل",
 "作り物": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / زينة / مَحْصُول / حَوْصَلة",
 "作り皮": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "作り直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "作り立てる": "زَيَّنَ, زَخْرَفَ (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "作り話": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "作り込み": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة",
 "作り込む": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "作り返す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "作り顔": "مُخْتَلَق",
 "作り飾る": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "作る": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "作中人物": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "作付": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "作付け": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "作劇術": "فنون مسرحية, مسرح (فن كتابة وإنتاج المسرحيات)",
 "作動": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة",
 "作動中": "قَيْدَ الاِسْتِخْدَام (يُسْتَخْدَمُ حَالِيًّا)",
 "作動装置": "محرك ميكانيكي, مشغل (آلية تضع شيئاً ما في حالة عمل تلقائي)",
 "作品": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "作品名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "作品集": "تَجْمِيعَة, دِيوَان",
 "作図": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "作図装置": "رسامة (أداة (عادة ما يتم تشغيلها بواسطة حاسوب) لرسم الرسوم البيانية أو الصور) / متآمر (عضو في مؤامرة) / رسام خرائط بيانية (كاتب يحدد البيانات على رسم بياني) / متآمر, مُدَبِّر (مخطط يضع خطة عمل شخصية)",
 "作土": "تربة سطحية (طبقة التربة الموجودة على السطح)",
 "作場": "مَزْرَعَة",
 "作字": "مُخْتَلَق",
 "作家": "مُؤَلِّف, مُصَنِّف / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "作庭": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "作意": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "作成": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط",
 "作成者": "مُؤَلِّف, مُصَنِّف / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "作戦": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / عملية, عملية عسكرية (نشاط تقوم به قوة عسكرية أو بحرية (كمناورة أو حملة))\nمثال: كانت عملية مشتركة بين القوات البحرية والجوية",
 "作戦上": "عَامِل, قَيْدَ التَّشْغِيل (في حالة تنفيذ أو تشغيل) / تشغيلي, عملياتي ((عسكري) متعلق أو مخصص أو مشارك في العمليات العسكرية) / جَاهِز لِلْعَمَل, صَالِح لِلاسْتِعْمَال (مناسب وجاهز للاستخدام أو الخدمة) / تشغيلي, عملياتي (يخص عملية أو سلسلة من الإجراءات لتحقيق نتيجة)\nمثال: صعوبات تشغيلية",
 "作文": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "作曲": "مُؤَلَّف, مُصَنَّف",
 "作曲家": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "作曲者": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "作柄": "مَحْصُول / حَوْصَلة / نَوْعِيَّة, جَوْدَة",
 "作業": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "作業グループ": "مجموعة عمل (مجموعة من الأشخاص يعملون معًا مؤقتًا حتى يتم تحقيق هدف ما)\nمثال: كان من المفترض أن تقدم مجموعة العمل تقريرًا في غضون أسبوعين",
 "作業スペース": "مِسَاحةُ عَمَل",
 "作業台": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "作業員": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "作業唄": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "作業場": "مَشْغَل, وَرْشَة",
 "作業服": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "作業歌": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "作業班": "طاقم عمل, فرقة عمال (مجموعة منظمة من العمال)",
 "作業現場": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "作業療法": "علاج بالعمل, علاج وظيفي (علاج يعتمد على المشاركة في أنشطة ذات مغزى من الحياة اليومية، لتمكين المشاركة في مثل هذه الأنشطة على الرغم من القصور أو القيود في الوظائف الجسدية أو…)",
 "作業着": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "作業者": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "作業衣": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
