 "交絡": "تَرَابُط, عَلَاقَة مُتَبَادَلَة (علاقة متبادلة أو ارتباط متبادل)\nمثال: العلاقات المتبادلة بين بنية الحيوان ووظيفته",
 "交誼": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "交譲": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة",
 "交趾": "دجاج كوشين (سلالة آسيوية من الدجاج الكبير ذو ريش كثيف وأرجل مغطاة بالريش)",
 "交通": "مُرُور / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر / حِوَار / جِمَاع (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "交通信号": "إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة",
 "交通手段": "مواصلات, نظام نقل (منشأة تتكون من الوسائل والمعدات اللازمة لحركة الركاب أو البضائع)",
 "交通整理": "تنظيم السير, مراقبة المرور (السيطرة على تدفق حركة المرور)",
 "交通標識": "لَافِتَة مُرُور, عَلَامَة طَرِيق",
 "交通機関": "نَقْل, نَقْلِيَّات",
 "交通渋滞": "اِزْدِحَام الْمُرُور, اِخْتِنَاق مُرُورِيّ",
 "交通規制": "تنظيم السير, مراقبة المرور (السيطرة على تدفق حركة المرور)",
 "交通費": "أجرة الحافلة (الأجرة المفروضة لركوب حافلة أو ترام)",
 "交通遮断": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إعاقة, انسداد (الحالة المادية لسد أو ملء ممر بعائق)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "交通量": "مُرُور",
 "交連": "صوار (حزمة من الألياف العصبية تمر من جانب إلى آخر من الدماغ أو الحبل الشوكي)",
 "交遊": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "交配": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "交配種": "هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار",
 "交錯": "خَلِيط",
 "交附": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "交際": "سَرِيَّة / شَرِكَة / اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "交際上手": "ألفة, حب الاختلاط (الميل النسبي أو الاستعداد ليكون المرء اجتماعياً أو يختلط بأقرانه)",
 "交際好き": "أَنِيس, اجْتِمَاعِيّ (وَدُودٌ وَلَطِيفٌ فِي المُعَامَلَةِ) / أليف, أنيس (يميل إلى الرفقة مع الآخرين أو يؤدي إليها) / تجمع اجتماعي, لقاء تعارفي (حفلة تجمع الناس لتعزيز الروابط الاجتماعية والنشاط الجماعي)\nمثال: مناسبة اجتماعية",
 "交際嫌い": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "交際官": "دِبْلُومَاسِيّ, دِبْلُومَاسِيَّة",
 "交際法": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن)\nمثال: أكره ذوق الكحول.",
 "交際相手": "النصف الآخر",
 "交際社会": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "交雑": "تَهْجِين / خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "交雑種": "هَجِين",
 "交霊": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "交霊会": "جلسة تحضير الأرواح, جلسة روحانية (اجتماع للروحانيين)\nمثال: عُقدت جلسة تحضير الأرواح في غرفة الوسيط",
 "交霊術": "نِكْرُومَانْسِيَّة",
 "交響": "تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية) / أصداء, تداعيات (عاقبة بعيدة أو غير مباشرة لإجراء ما)\nمثال: كانت تستطيع سماع أصداء خطواتها",
 "交響曲": "سِيمْفُونِيَّة, سِيمْفُونِي",
 "交響楽": "سيمفونية (سوناتا طويلة ومعقدة للأوركسترا السيمفونية)",
