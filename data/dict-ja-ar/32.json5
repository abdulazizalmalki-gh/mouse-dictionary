 "充溢": "فَيَضَان / فَاضَ",
 "充牣": "مَلَأَ",
 "充盈": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "充血": "اِحْتِقَان",
 "充足": "كِفَايَة",
 "充電": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "充電器": "شَاحِن (تُستخدم لشحن أو إعادة شحن بطارية ما)\nمثال: أنا أسوق شاحنة.",
 "充電式": "قَابِل لِإِعَادَة الشَّحْن (يمكن إعادة شحنه واستخدامه مجدّدًا)",
 "兆": "بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة الأمريكية)) / تِرِيلِيُون / تِرِيلِْيُون\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "兆し": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "兆す": "بُرْعُم",
 "兆候": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "兇人": "وَغْد, نَذْل",
 "兇変": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "兇害": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "兇徒": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "兇悍": "شَنَاعَة, فَظَاعَة (صفة كون الفعل قاسياً بشكل مروع وغير إنساني)",
 "兇手": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / حَشَّاش\nمثال: بيتي قاتلة أمك.",
 "兇漢": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "兇状": "جَرِيمَة, جِنَايَة / جَرِيمَة",
 "兇猛": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "兇行人": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية) / همجي, وحش (شخص قاسي وجشع)",
 "兇賊": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "先": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / سَابِق / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)",
 "先々代": "الْمُخْتَار, الْمُخْتَارَة",
 "先き": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا",
 "先ごろ": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先ず": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / حَوَالِي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "先ずは": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / حَوَالِي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "先ずもって": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "先ず以て": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "先ず第一に": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "先だって": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先っちょ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "先っぽ": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "先つ祖": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "先どり": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "先に": "قَبْلًا, قَبْل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "先に立つ": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "先の日": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先の祖": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "先べん": "مُبَادَرَة",
 "先ほど": "آنِفاً",
 "先を急ぐ": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "先を続ける": "تَابَعَ, اِسْتَمَرَّ",
 "先んじる": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "先んずる": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "先んずれば人を制す": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "先人": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "先付": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "先付け": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "先代": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "先任": "أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "先住": "أَزَلِيّ, بِدْئِيّ (موجود منذ البداية؛ في أبكر مرحلة أو حالة أصلية) / أصلي, من السكان الأصليين (مميز لـ أو يتعلق بالسكان الذين يقطنون منطقة منذ البداية) / ابن البلد, من السكان الأصليين (شخص من السكان الأصليين ولد في مكان معين)\nمثال: الأمريكيون الأصليون",
 "先住民": "سَاكِن أَصْلِيّ",
 "先住民族": "سَاكِن أَصْلِيّ",
 "先体": "مُقَدِّمَة الْحَيَوَانِ الْمَنَوِيِّ",
 "先例": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "先先代": "الْمُخْتَار, الْمُخْتَارَة",
 "先入": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "先入れ先出し": "ما يرد أولاً يصرف أولاً (محاسبة المخزون التي يُفترض فيها أن العناصر الأقدم (التي تم شراؤها أولاً) هي التي تباع أولاً)",
 "先入れ先出しリスト": "طابُور, صَفّ (وَحْدة عسكريَّة تضمّ عِدَّة سَرايا) / وَقَفَ فِي الصَّفّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: كانا واقفين في طابور.",
 "先入主": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "先入見": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "先入観": "حكم مسبق, فكرة مسبقة (رأي تم تشكيله مسبقاً دون أدلة كافية) / انحياز, تحامل (تحيز يمنع النظر بموضوعية في قضية أو موقف)\nمثال: لم يحاول حتى التأكد من أفكاره المسبقة",
 "先公": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "先兵": "طَلِيعَة",
 "先出": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "先制": "انْطِلَاقَة مُبَكِّرَة, بَادِرَة (الأفضلية المكتسبة بالبدء مبكراً (كما في السباق))\nمثال: مع انطلاقة مبكرة بساعة سيكون من الصعب اللحاق به",
 "先制攻撃": "ضربة أولى (الاستخدام الأولي للأسلحة النووية لمهاجمة بلد يمتلك أيضاً أسلحة نووية)\nمثال: وعد الرئيس الباكستاني بعدم توجيه ضربة أولى ضد الهند",
 "先刻": "آنِفاً / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "先割れスプーン": "سبورك, ملعقة شوكية (علامة تجارية لأداة أكل بلاستيكية لها أسنان وتجويف مثل الملعقة)",
 "先占権者": "ساكن, قاطن (شخص يعيش في مكان معين لفترة طويلة أو ولد هناك)",
 "先取": "اِسْتِغْرَاق, اِنْهِمَاك / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "先取り": "تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "先史": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "先史学": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "先史時代": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "先君": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "先回": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "先回り": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية)",
 "先夜": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "先天": "مُتَأَصِّل",
 "先天性": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "先天性異常": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "先天異常": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "先天病": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "先天的": "فِطْرِيّ, وِلَادِيّ (مَوْجُودٌ بِشَكْلٍ طَبِيعِيٍّ مُنْذُ الوِلَادَةِ) / خِلْقِيّ, وِلَادِيّ (موجود منذ الولادة لكن ليس بالضرورة وراثيًّا؛ مكتسب أثناء النمو الجنيني) / مُسَلَّم بِه, لَا يُحْتَاجُ إِثْبَاتَة إِلَى تَجْرِبَة ((للأشخاص) متبع دين الإِسْلَام) / مُسَبَّق\nمثال: سامي مسلم سابق.",
 "先天的障害": "تشوه خلقي, عيب خلقي (عيب موجود عند الولادة)",
 "先太": "هِرَاوِيّ الشَّكْل (على شكل هِراوة تكون أعرض عند أحد طرفيها) / نَفَلِيّ الشَّكْل (على شكل ورقة النَّفَل السوداء في أوراق اللعب)",
 "先太り": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / مُتَمَوِّج, مُنْتَشِر (يتدفق أو يمتد كما لو كان في تيار هوائي)",
 "先導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "先導性": "قِيَادَة",
 "先導者": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "先年": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "先度": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先延ばし": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "先延ばしにする": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "先後": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / عكس, قلب (عملية القلب من الداخل إلى الخارج) / قلب, نكْس (القلب رأساً على عقب؛ الوضع على النهاية) / انقلاب جنسي (مصطلح كان يستخدم سابقاً ليعني تقمص دور الجنس الآخر) / عكس, قلب ((طباق) تنويع للحن أو جزء منه تُستبدل فيه المسافات الصاعدة بمسافات هابطة والعكس صحيح) / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "先手": "خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية) / سنتي (100 سنتي تساوي 1 لوتي في ليسوتو)",
 "先手を打つ": "تَوَقَّعَ, اِرْتَقَبَ",
 "先手必勝": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "先払い": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / رَائِد, سَابِق (أي شيء يسبق شيئًا مشابهًا في الوقت)\nمثال: كان علم فراسة الدماغ سابقة لعلم الأعصاب الحديث",
 "先投": "رامٍ أساسي ((في البيسبول) الرامي الذي يبدأ المباراة)",
 "先方": "أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / وِجْهَة, وُجْهَة",
 "先日": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先晩": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "先棒": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع))",
 "先渡": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "先渡し": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "先潜り": "استباق, تحاشي (فعل منع شيء ما عن طريق توقعه والتخلص منه بفعالية)",
 "先物": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "先物市場": "سوق العقود الآجلة (بورصة سلع يتم فيها تداول العقود الآجلة)",
 "先物買い": "تَكَهُّنٌ / مُضَارَبَة",
 "先生": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / مُدَرِّب / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "先生方": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "先番": "أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم)) / أسبقية, أولوية (السبق في الزمن) / أسبقية, أولوية (مكانة محددة بترتيب الأهمية أو الإلحاح)\nمثال: أسبقيتها كشركة رائدة عالمياً في تصنيع الأدوية",
 "先発": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "先発投手": "رامٍ أساسي ((في البيسبول) الرامي الذي يبدأ المباراة)",
 "先知": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "先祖": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "先祖がえり": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / ارتداد, تراجع (العودة إلى حالة سابقة) / ارتداد, انعكاس (التحول في الاتجاه المعاكس) / ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة)",
 "先祖代々": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / جدي, سلفي (من أو ينتمي إلى أو موروث من سلف)",
 "先祖代代": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / جدي, سلفي (من أو ينتمي إلى أو موروث من سلف)",
 "先祖伝承": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "先祖伝来": "عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "先祖返り": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / ارتداد, تراجع (العودة إلى حالة سابقة) / ارتداد, انعكاس (التحول في الاتجاه المعاكس) / ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة)",
 "先程": "آنِفاً",
 "先立ち": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "先立って": "قَبْل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先立つ": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "先立つもの": "إمكانيات, موارد ضرورية (الوسائل الضرورية (خاصة الوسائل المالية))",
 "先立つ物": "إمكانيات, موارد ضرورية (الوسائل الضرورية (خاصة الوسائل المالية))",
 "先端": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / طَلِيعَة",
 "先端医療技術": "بِأَحْدَث التِّقْنِيَّات (على أعلى مستوى من التطوّر في وقت معيّن (خاصة الوقت الحالي))",
 "先端巨大症": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "先端的": "فَائِقُ الحَدَاثَة (حَدِيثٌ لِأَقْصَى دَرَجَة)",
 "先細り": "آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل) / تضاؤل, تناقص (أن يصبح الشيء أقل تدريجياً)\nمثال: ليس هناك حزن أكبر من تضاؤل العائلة / تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً) / مُتَدَرِّج الضِّيق, مُسْتَدَقّ (يضيق تدريجيًّا نحو أحد الأطراف)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "先般": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先行": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / مُطَارِد",
 "先行き": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "先行指数": "مؤشر استباقي, مؤشر رائد (واحد من 11 مؤشراً لقطاعات مختلفة من الاقتصاد؛ تستخدمه وزارة التجارة للتنبؤ بالاتجاهات الاقتصادية في المستقبل القريب)",
 "先行詞": "سَابِق (يسبق في الوقت أو الترتيب) / سَابِق (مرجع الجناس؛ عبارة أو جملة يشار إليها بضمير عائد) / سابقة, مقدمة (حدث أو سبب أو واقعة سابقة) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد))",
 "先見": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "先見の明": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "先見の目": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "先見の眼": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "先見性": "استبصار, علم بالغيب (القدرة على التنبؤ بالمستقبل)",
 "先見者": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل) / رائٍ, مشاهد (مراقب يدرك بصرياً) / رائي, صاحب بصيرة (شخص لديه قوى غير عادية لاستشراف المستقبل)\nمثال: مشاهد مدمن للأفلام",
 "先覚": "رَائِد",
 "先覚者": "متنبئ, نبي (شخص ذو سلطة يتنبأ بالمستقبل) / رائٍ, مشاهد (مراقب يدرك بصرياً) / رائي, صاحب بصيرة (شخص لديه قوى غير عادية لاستشراف المستقبل)\nمثال: مشاهد مدمن للأفلام",
 "先触れ": "بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "先読み": "تَوَقَّعَ",
 "先議": "مُبَادَرَة",
 "先買": "استباق, حق الشفعة (الاستيلاء المسبق على شيء ما) / أولوية الشراء, حق الشفعة (الحق في شراء شيء ما قبل الآخرين) / استيلاء, حق الشفعة (حق الحكومة في الاستيلاء على شيء ما أو تخصيصه (مثل الممتلكات)) / أسبقية, استباق (المبدأ القضائي الذي يؤكد سيادة التشريع الفيدرالي على تشريع الولاية في نفس الموضوع)\nمثال: استيلاء المصالح التجارية على عرض النطاق الترددي",
 "先買い": "استباق, حق الشفعة (الاستيلاء المسبق على شيء ما) / أولوية الشراء, حق الشفعة (الحق في شراء شيء ما قبل الآخرين) / استيلاء, حق الشفعة (حق الحكومة في الاستيلاء على شيء ما أو تخصيصه (مثل الممتلكات)) / أسبقية, استباق (المبدأ القضائي الذي يؤكد سيادة التشريع الفيدرالي على تشريع الولاية في نفس الموضوع)\nمثال: استيلاء المصالح التجارية على عرض النطاق الترددي",
 "先買権": "استباق, حق الشفعة (الاستيلاء المسبق على شيء ما) / أولوية الشراء, حق الشفعة (الحق في شراء شيء ما قبل الآخرين) / استيلاء, حق الشفعة (حق الحكومة في الاستيلاء على شيء ما أو تخصيصه (مثل الممتلكات)) / أسبقية, استباق (المبدأ القضائي الذي يؤكد سيادة التشريع الفيدرالي على تشريع الولاية في نفس الموضوع)\nمثال: استيلاء المصالح التجارية على عرض النطاق الترددي",
 "先走り": "فَأل, نَذِيْر / بَشِير, مُبَشِّر / جندي مشاة, سائر (شخص يقاتل سيراً على الأقدام بأسلحة خفيفة) / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / مَذْي",
 "先走り汁": "مَذْي",
 "先走り液": "مَذْي",
 "先蹤": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "先蹴": "اَلْبِدَايَة",
 "先輩": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "先込め": "تلقيم فوهي ((عن الأسلحة النارية) تستقبل القذيفة أو الخرطوشة عبر الفوهة)",
 "先込め銃": "بندقية تلقيم من الفوهة (سلاح ناري قديم كان يتم تلقيمه من خلال الفوهة)",
 "先述": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "先送り": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "先途": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "先週": "اَلْأُسْبُوع السّابِق",
 "先進": "مُتَقَدِّم / أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "先進国": "دَوْلَة مُتَقَدِّمَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "先進的": "مُتَقَدِّم",
 "先達": "قَائِد, زَعِيم / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "先遣部隊": "طَلِيعَة",
 "先金": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "先鋒": "طَلِيعَة",
 "先鋭": "جَذْريّ / رَادِيكَالِيّ",
 "先鋭化": "تشديد, تكثيف (إجراء يجعل الشيء أقوى أو أكثر حدة) / تكثيف (عملية زيادة تباين (الفيلم الفوتوغرافي)) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)",
 "先附": "مَزَّة, مُشَهْي (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "先陣": "طَلِيعَة",
 "先陣を切る": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "先隣": "فِي الجِوَار, فِي المَنْزِل المُجَاوِر (في أو إلى المسكن المجاور)\nمثال: كان المجرم يعيش في المنزل المجاور طوال هذا الوقت",
 "先鞭": "مُبَادَرَة",
 "先頃": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "先頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "先頭部隊": "طَلِيعَة",
 "先駆": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / رَائِد, سَابِق (أي شيء يسبق شيئًا مشابهًا في الوقت)\nمثال: كان علم فراسة الدماغ سابقة لعلم الأعصاب الحديث / راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب)",
 "先駆け": "رَائِد",
 "先駆的": "رَائِد",
 "先駆者": "رَائِد",
 "先験哲学": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "先験的": "متسام",
 "先験論": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "光": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / إِضَاءَة / سَعَادَة, فَرَح / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "光と影": "بصيص أمل, جانب مضيء (جانب مواسٍ لموقف صعب)\nمثال: كل سحابة لها جانب مضيء",
 "光の速さ": "سرعَة الضوء",
 "光らす": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "光り物": "لَامِع, نَيِّر / مُسْتَنِير",
 "光り輝く": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "光る": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "光る棒": "عصا مضيئة (أنبوب بلاستيكي صغير يحتوي على مواد كيميائية تنتج ضوءاً عند كسرها)",
 "光を当てる": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "光ケーブル": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "光ディスク": "قرص ضوئي (قرص مطلي بالبلاستيك يمكنه تخزين البيانات الرقمية كحفر صغيرة محفورة في السطح؛ يقرأ بواسطة ليزر يمسح السطح)",
 "光ファイバ": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "光ファイバー": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "光ファイバーケーブル": "ليفي بصري (مكون من أو متعلق بالألياف البصرية)",
 "光一": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "光井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "光伝導": "موصلية ضوئية (تغير في الموصلية الكهربائية لمادة نتيجة لامتصاص الإشعاع الكهرومغناطيسي)",
 "光冠": "كورونا (سيجار طويل بنهايات غير حادة) / إِكْلِيل ((في التشريح) أي بنية تشبه التاج في شكلها) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي) / هالة (دائرة واحدة أو أكثر من الضوء تُرى حول جسم مضيء)",
 "光化学": "كيمياء ضوئية (فرع الكيمياء الذي يتعامل مع التأثير الكيميائي للضوء)",
 "光化学反応": "تفاعل كيميائي ضوئي (تفاعل كيميائي ينتج عن تأثير الضوء)",
 "光原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "光合成": "تَمْثِيل ضَوْئِيّ / تَرْكِيب ضَوْئِيّ (اسم للشيء الذي يُرَّكبُ بالعادة)",
 "光圀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "光圧": "ضغط الإشعاع (الضغط الدقيق الذي يمارس على سطح عمودي على اتجاه انتشار الموجة)",
 "光塔": "مَنَارَة, مِئْذَنَة (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن)",
 "光子": "فُوتُون",
 "光学": "بَصَرِيَّات (علم البصريات: هو العلم الذي يبحث في سُلُوك الطَيْف البصري المرئي والظَوَاهِر المتعلقة به)",
 "光学器械": "أداة بصرية (أداة مصممة للمساعدة في الرؤية)",
 "光学式": "بصري (متعلق بالضوء أو البصريات أو ينطوي عليهما) / بصري, مرئي (متعلق بالبصر أو يستخدمه) / رمدي, عيني (متعلق بالعين أو يشبهها)\nمثال: مستلزمات بصرية",
 "光学式スキャナ": "ماسح ضوئي (جهاز طرفي للحاسوب يتيح مسح المواد المطبوعة، بما في ذلك الأحرف والرسوم البيانية، وتحويلها إلى شكل يمكن تخزينه في الحاسوب)",
 "光学式走査器": "ماسح ضوئي (جهاز طرفي للحاسوب يتيح مسح المواد المطبوعة، بما في ذلك الأحرف والرسوم البيانية، وتحويلها إلى شكل يمكن تخزينه في الحاسوب)",
 "光学機械": "أداة بصرية (أداة مصممة للمساعدة في الرؤية)",
 "光学異性体": "مُتَصَاوِغ اِنْعِكَاسِيّ, مُتَصَاوِغ مِرْآتِيّ",
 "光学素子": "جهاز بصري (جهاز لإنتاج الضوء أو التحكم فيه)",
 "光学繊維": "ألياف بصرية, ألياف زجاجية (ألياف رقيقة جداً مصنوعة من الزجاج تعمل كدليل موجي للضوء؛ تستخدم في حزم لنقل الصور)",
 "光学軸": "محور بصري, محور رئيسي (خط يمر عبر مركز انحناء العدسة بحيث لا ينعكس الضوء ولا ينكسر) / محور بصري (في البلورة مزدوجة الانكسار، الخط الذي لا يحدث في اتجاهه انكسار مزدوج)\nمثال: في العين الطبيعية، المحور البصري هو الاتجاه الذي تُرى فيه الأشياء بوضوح أكبر",
 "光山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "光岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "光年": "سنة ضوئية (المسافة التي يقطعها الضوء في الفراغ خلال سنة واحدة؛ حوالي 9.46 تريليون كيلومتر)",
 "光度": "سطوع, ضياء (صفة كون الشيء مضيئاً؛ انبعاث أو انعكاس الضوء)",
 "光度計": "مقياس الضوء (معدات تصوير فوتوغرافي تقيس شدة الضوء) / فوتومتر, مقياس الضوء (أداة قياس لقياس الشدة الضوئية لمصدر بمقارنته (بصرياً أو كهروضوئياً) بمصدر قياسي)",
 "光弾": "كرة طائرة قصيرة ((بيسبول) كرة طائرة تضرب لمسافة قصيرة في الملعب الخارجي) / تمريرة جانبية (تمريرة أمامية قصيرة لظهير يركض نحو الخطوط الجانبية) / شعلة ضوئية, مشعل (جهاز ينتج ضوءاً ساطعاً للتحذير أو الإضاءة أو تحديد الهوية) / توهج, وميض (انفجار ضوئي يستخدم للتواصل أو الإضاءة)",
 "光彩": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية",
 "光彩陸離": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "光感受性": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "光明": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "光明丹": "أكسيد الرصاص الأحمر, الرصاص الأحمر",
 "光景": "مَنْظَر, مَشْهَد / مَشْهَد",
 "光札": "لَامِع, نَيِّر / مُسْتَنِير",
 "光束": "تَدَفُّق ضَوْئِيّ, فَيْض ضَوْئِيّ (معدل تدفق الطاقة الضوئية) / قَلَم رَصَاص, قَلَم (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "光条": "تخطيط شريطي, تريط (شريط أو أشرطة ذات لون مغاير) / تحزز, تخطط (أي من الأخاديد المتوازية الدقيقة مثل: الخدوش التي يتركها نهر جليدي على الصخور أو الخطوط في الأنسجة العضلية)\nمثال: تظهر الكروموسومات شرائط مميزة",
 "光柱": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "光栄": "شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "光桃": "دُرَّاق",
 "光機": "أداة بصرية (أداة مصممة للمساعدة في الرؤية)",
 "光沢": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية",
 "光沢機": "مَاكِينَة صَقْل اَلْوَرَق / صَقَلَ",
 "光源": "ضوء, مصدر ضوء (أي جهاز يعمل كمصدر للإضاءة)\nمثال: أوقف السيارة وأطفأ الأضواء",
 "光源状態": "ضوء, مصدر ضوء (أي جهاز يعمل كمصدر للإضاءة)\nمثال: أوقف السيارة وأطفأ الأضواء",
 "光照": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة) / بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً) / لَامِع, مُشْرِق (يتميز بجدارة استثنائية)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "光物": "لَامِع, نَيِّر / مُسْتَنِير",
 "光球": "غلاف ضوئي, فوتوسفير (السطح المضيء بشكل مكثف للنجم (وخاصة الشمس))",
 "光環": "كورونا (سيجار طويل بنهايات غير حادة) / إِكْلِيل ((في التشريح) أي بنية تشبه التاج في شكلها) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي) / هالة (دائرة واحدة أو أكثر من الضوء تُرى حول جسم مضيء)",
 "光田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "光療法": "علاج ضوئي (استخدام الضوء القوي لعلاج حب الشباب أو فرط بيليروبين الدم لدى حديثي الولادة)",
 "光磁気": "موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "光線": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "光線恐怖症": "ألم العين الضوئي, رهاب الضوء (ألم في العين ناتج عن التعرض للضوء الساطع (غالباً ما يرتبط بالمهق)) / رهاب الضوء (خوف مرضي من الضوء)",
 "光線束": "قَلَم رَصَاص, قَلَم (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "光線療法": "علاج ضوئي (استخدام الضوء القوي لعلاج حب الشباب أو فرط بيليروبين الدم لدى حديثي الولادة)",
 "光耀": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة) / بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً) / لَامِع, مُشْرِق (يتميز بجدارة استثنائية)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "光背": "هَالَة",
 "光臨": "وُصُول, وِفَادَة",
 "光芒": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "光茸蝿": "يَرَاع, حَبَاحِب",
 "光行差": "اِنْزِيَاغ / زَيْغ (زَيَّغَ (زيغه): عوجه وأقام زيغه وأصلح عوجه)",
 "光跡": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مَسْلَك (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: اضطررت إلى جر سامي.",
 "光軸": "محور بصري, محور رئيسي (خط يمر عبر مركز انحناء العدسة بحيث لا ينعكس الضوء ولا ينكسر) / محور بصري (في البلورة مزدوجة الانكسار، الخط الذي لا يحدث في اتجاهه انكسار مزدوج)\nمثال: في العين الطبيعية، المحور البصري هو الاتجاه الذي تُرى فيه الأشياء بوضوح أكبر",
 "光輝": "سُطُوع",
 "光輝く": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "光輪": "هَالَة",
 "光速": "سرعَة الضوء",
 "光速度": "سرعَة الضوء",
 "光過敏性": "حساسية إشعاعية, حساسية للضوء (الحساسية لتأثير الطاقة المشعة)",
 "光量子": "فُوتُون",
 "光量計": "أكتينومتر, مقياس الإشعاع الكيميائي (أداة لقياس شدة الإشعاع الكهرومغناطيسي (عادة عن طريق التأثير الكيميائي الضوئي))",
 "光陰": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "光陰極": "كاثود ضوئي (كاثود يبعث إلكترونات عند إضاءته)",
 "光陰矢のごとし": "الْوَقْتُ يَمْضِي",
 "光陰矢の如し": "الْوَقْتُ يَمْضِي",
 "光電": "كهرضوئي (متعلق بالكهرباء الضوئية)\nمثال: التأثير الكهرضوئي",
 "光電子": "فُوتُوإِلِكْتْرُون (إلكترون ينبعث من ذرة أو جزيء بواسطة فوتون ساقط)",
 "光電導": "موصلية ضوئية (تغير في الموصلية الكهربائية لمادة نتيجة لامتصاص الإشعاع الكهرومغناطيسي)",
 "光電池": "خلية شمسية, خلية كهروضوئية (خلية تحول الطاقة الشمسية إلى طاقة كهربائية)",
 "光頭": "أَصْلَع (يفتقر إلى الشعر على كل أو معظم فروة الرأس)",
 "光風霽月": "سَكِينَة اَلرُّوح, صَفَاء",
 "光鹵石": "كارناليت (معدن أبيض أو محمر يتكون من كلوريدات البوتاسيوم والمغنيسيوم المائية؛ يستخدم كسماد وكمصدر للبوتاسيوم والمغنيسيوم)",
 "克く": "بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / شُكْرًا, تِسْلَم / لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَا أَعْرِف (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَسْتُ أَدْرِي / لَا أَدْرِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "克己": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / ضبط النفس (سمة التحكم الحازم في سلوك المرء)",
 "克復": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "克明": "مُفَصَّل / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "克服": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا.",
 "克鯨": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "兌換": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "免": "إِقَالَة",
 "免じる": "طَرَدَ, أَقَالَ / مُعْفًى",
 "免ずる": "طَرَدَ, أَقَالَ / مُعْفًى",
 "免れる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف. / تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "免停": "رخصة قيادة (رخصة تخول حاملها قيادة مركبة آلية)",
 "免官": "إِقَالَة",
 "免状": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة / شَهَادَة, دِبْلُوم",
 "免疫": "حَصَانَة, مَنَاعَة",
 "免疫グロブリン": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "免疫システム": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "免疫不全": "عوز مناعي, نقص المناعة (اضطراب مناعي يكون فيه جزء من الجهاز المناعي للجسم غير كافٍ وتنخفض المقاومة للأمراض المعدية)",
 "免疫体": "جِسْم مُضَادّ (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "免疫力": "حَصَانَة, مَنَاعَة",
 "免疫化学": "كيمياء مناعية (مجال الكيمياء المعني بالعمليات الكيميائية في علم المناعة (مثل الدراسات الكيميائية للمستضدات والأجسام المضادة))",
 "免疫原性": "استمناع, مولدية للمناعة (خاصية إثارة استجابة مناعية)",
 "免疫学": "علم المناعة (فرع العلوم الطبية الذي يدرس الجهاز المناعي للجسم)",
 "免疫学者": "عالم مناعة (عالم طبي يتخصص في علم المناعة)",
 "免疫応答": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "免疫応答遺伝子": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "免疫性": "حَصَانَة, مَنَاعَة",
 "免疫抑制剤": "دواء مثبط للمناعة, مثبط للمناعة (دواء يقلل من الاستجابة المناعية الطبيعية للجسم)",
 "免疫機構": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "免疫源": "عامل تحصين, مولد المناعة (أي مادة أو كائن حي يثير استجابة مناعية (ينتج مناعة) عند إدخاله في الجسم)",
 "免疫療法": "علاج مناعي (علاج مصمم لإنتاج مناعة ضد مرض أو لتعزيز مقاومة الجهاز المناعي)",
 "免疫系": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "免租地": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "免税品": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "免税店": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "免税所得": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "免税率": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "免税表": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "免罪": "تَبْرِئَة / صَكّ غُفْرَان",
 "免罪符": "صَكّ غُفْرَان / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "免職": "إِقَالَة",
 "免許": "رُخْصَة, تَصْرِيح / رُخْصَة / رُخْصَةُ سِيَاقَة, رُخْصَةُ قِيَادَة",
 "免許停止": "رخصة قيادة (رخصة تخول حاملها قيادة مركبة آلية)",
 "免許料": "رسم الترخيص (رسم يُدفع للحكومة مقابل امتياز الترخيص للقيام بشيء ما (مثل بيع الخمور أو ممارسة الطب))",
 "免許状": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "免許番号": "رقم التسجيل, رقم الرخصة (الرقم الموجود على لوحة الترخيص والذي يحدد السيارة التي تحمله)",
 "免許証": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة",
 "免訴": "تَبْرِئَة",
 "免責事項": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ) / تنازل ((قانون) تنصل طوعي عن مطالبة قانونية لشخص ما بشيء ما)",
 "免責条項": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ) / تنازل ((قانون) تنصل طوعي عن مطالبة قانونية لشخص ما بشيء ما)",
 "免責特権": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين الدبلوماسيين في بلد أجنبي)",
 "免責金額": "قابل للخصم (مقبول كخصم (خاصة كخصم ضريبي)) / القيمة المقتطعة, مبلغ التحمل (بند في بوليصة التأمين يعفي شركة التأمين من مسؤولية دفع الخسارة الأولية حتى مبلغ محدد) / مبلغ قابل للخصم ((ضرائب) مبلغ يمكن خصمه (خاصة لأغراض حساب ضريبة الدخل))",
 "免責額": "قابل للخصم (مقبول كخصم (خاصة كخصم ضريبي)) / القيمة المقتطعة, مبلغ التحمل (بند في بوليصة التأمين يعفي شركة التأمين من مسؤولية دفع الخسارة الأولية حتى مبلغ محدد) / مبلغ قابل للخصم ((ضرائب) مبلغ يمكن خصمه (خاصة لأغراض حساب ضريبة الدخل))",
 "免除": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة) / إعفاء (خصم مسموح به لدافع الضرائب بسبب وضعه (وجود معالين معينين أو كونه كفيفاً أو تجاوز سن 65 إلخ)) / إعفاء, تحرر (الحصانة من التزام أو واجب)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "免黜": "إِقَالَة",
 "兎": "أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب.",
 "兎も角も": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / بأي طريقة, كيفما كان (بأي طريقة كانت)\nمثال: على أي حال، هو ميت الآن",
 "兎口": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "兎唇": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "兎小屋": "قفص أرانب (قفص مخصص للأرانب)",
 "兎座": "قُوَاع, أَرْنَب بَرِّيَّة",
 "兎眼": "عين أرنبية, لاقوفثالموس (حالة غير طبيعية لا يمكن فيها إغلاق العين تماماً)",
 "兎結び": "عقدة حلقية (أي من العقد المختلفة المستخدمة لعمل حلقة ثابتة في حبل)",
 "兎耳": "نَمَّام, نَمَّامة",
 "兎角": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن / مُخْتَلِف, مُتَنَوَّع",
 "兎馬": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "児": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / صَغِير, حَدَث / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "児ポ": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "児子": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "児孫": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "児島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "児嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "児玉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "児童": "سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / شبابي, صبياني (متعلق بالأطفال أو الشباب أو مميز لهم أو مناسب لهم) / حدث, قاصر (شخص صغير السن لم يكتمل نموه بعد)\nمثال: سكري الأحداث",
 "児童ポルノ": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "児童会": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "児童保護": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "児童労働": "عمالة الأطفال (مؤنث عَمَّال بمعنى صيغة مبالغة في العَمَل؛ في : هم العُمَّال؛ جمع عَامِل، وقد يكون جمع عَمَّال)",
 "児童心理学": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "児童性愛": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "児童性愛者": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "児童性的虐待": "إِسَاءَة جِنْسِيَّة لِلْأَطْفَال",
 "児童虐待": "إِسَاءَة مُعَامَلَة لِلْأَطْفَال, إِسَاءَة مُعَامَلَة الْأَطْفَال",
 "児童遊園": "مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "児童遊園地": "مَدِينَة تَرْفِيهِيَّة, مَدِينَة الْمَلْهَى",
 "児童養護施設": "دَار الْأَيْتَام, مَيْتَم (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "児鯨": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "党": "طَرَف / حَفْلَة, اِحْتِفَال / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / مَرْكَز شُرْطَة, مَرْكِز شُرْطَة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "党の枠": "خط مشترك (خط هاتف يخدم مشتركين اثنين أو أكثر) / خط الحزب (سياسة مجموعة سياسية)\nمثال: فاز في تصويت على أساس خطوط الحزب",
 "党争": "فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "党人": "حزبي (عضو ذكر في حزب سياسي يتبع بصرامة خط الحزب)",
 "党員集会": "اِجْتِمَاع حِزْبِيّ مُغْلَق, مُؤْتَمَر حِزْبِيّ (اجتماع سياسي مغلق)",
 "党官僚": "أباراتشيك, موظف حزبي (شيوعي كان عضواً في النظام الإداري لحزب شيوعي) / أباراتشيك, بيروقراطي حزبي (مصطلح فكاهي ولكنه ازدرائي لمسؤول في منظمة كبيرة (خاصة منظمة سياسية))\nمثال: أباراتشيك ديمقراطيون",
 "党派": "فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "党派根性": "تحيز, محازبة (الميل لتفضيل مجموعة أو وجهة نظر أو رأي على البدائل)",
 "兜": "خُوذَة, بَيْضَة",
 "兜を脱ぐ": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "兜海老": "روبيان الشرغوف (نوع من القشريات غلصميات الأرجل)",
 "兜蝦": "روبيان الشرغوف (نوع من القشريات غلصميات الأرجل)",
 "兜蟹": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "兜頭巾": "خُوذِيُّ الشَّكْلِ (لَهُ شَكْلٌ مُحَدَّبٌ كَالخُوذَةِ)",
 "兜魚": "كَبير الرَّأْس (ذو رَأْس كَبير الحَجْم)",
 "入": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى / دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "入り": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى / دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "入りきる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "入りこむ": "اِخْتَرَقَ",
 "入りまじる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "入りよう": "حَاجَة, ضَرُورَة / اِحْتَاجَ / أتعاب التقاضي, تكاليف قانونية (تعويض مالي للطرف الرابح عن نفقات التقاضي)",
 "入り交じる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "入り会い": "مشاع, ملكية شائعة (ممتلكات محتفظ بها كملكية عامة أو مشتركة)",
 "入り切る": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "入り口": "دُخُول / مَدْخَل",
 "入り数": "كَمِّيَّة, مِقْدَار",
 "入り江": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه)",
 "入り海": "خَلِيج, شَرْم",
 "入り浸り": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء)",
 "入り浸る": "تَسَكَّعَ / اِبْتَلَّ",
 "入り混じる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "入り用": "حَاجَة, ضَرُورَة / اِحْتَاجَ / أتعاب التقاضي, تكاليف قانونية (تعويض مالي للطرف الرابح عن نفقات التقاضي)",
 "入り目": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "入り相": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "入り角": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "入り込む": "اِخْتَرَقَ",
 "入り隅": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "入る": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / أَصَابَ / أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "入れ": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد. / أَدْخَلَ",
 "入れなおす": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد. / إِعَادَة التَّشْغِيل / أَعَادَ تَشْغِيل (كَرَّرَ؛ أَرْجَعَ، رَدَّ)\nمثال: أعاد توم كتابته.",
 "入れぼくろ": "وَشْم / وَشَمَ, وَشَّمَ",
 "入れる": "أَعْتَرَفَ / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / تضمن / دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "入れ交ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "入れ代り": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "入れ代る": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "入れ代わり": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "入れ代わり立ち代わり": "وَاحِدًا تِلْوَ الآخَرِ",
 "入れ代わる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "入れ墨": "وَشْم / وَشَمَ, وَشَّمَ",
 "入れ子": "عُشّ / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار) / مُنْتَجَع / مَعْقَل (الملجأ والجبل المرتفع) / عَشَّشَ\nمثال: كان دوري كي أنظف المسكن",
 "入れ子にする": "عُشّ / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار) / مُنْتَجَع / مَعْقَل (الملجأ والجبل المرتفع) / عَشَّشَ\nمثال: كان دوري كي أنظف المسكن",
 "入れ掛け": "يُعَلِّق / تَعْلِيق",
 "入れ換え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "入れ換える": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "入れ替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "入れ替える": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "入れ替り": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "入れ替る": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "入れ替わり": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "入れ替わり立ち替わり": "وَاحِدًا تِلْوَ الآخَرِ",
 "入れ替わる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "入れ札": "عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "入れ歯": "بدلة سنية, طقم أسنان (جهاز سني يستبدل الأسنان المفقودة بشكل صناعي)",
 "入れ毛": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "入れ混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "入れ物": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "入れ直す": "جَدَّدَ (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد) / جَدِد (الشيء: رممه أو أصلحه حتى صار كالجَدِيد؛ الكلام: أعاده من جديد)\nمثال: تعرف على أناس جدد. / إِعَادَة التَّشْغِيل / أَعَادَ تَشْغِيل (كَرَّرَ؛ أَرْجَعَ، رَدَّ)\nمثال: أعاد توم كتابته.",
 "入れ知恵": "اِقْتِرَاح, مُقْتَرَح",
 "入れ籠": "عُشّ / مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار) / مُنْتَجَع / مَعْقَل (الملجأ والجبل المرتفع) / عَشَّشَ\nمثال: كان دوري كي أنظف المسكن",
 "入れ質": "جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "入れ髪": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "入れ黒子": "وَشْم / وَشَمَ, وَشَّمَ",
 "入会": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة / مشاع, ملكية شائعة (ممتلكات محتفظ بها كملكية عامة أو مشتركة)",
 "入会地": "الطبقة الثالثة, عامة الشعب (عامة الناس) / الدهماء, العامة (طبقة تتكون من أشخاص يفتقرون إلى رتبة دينية أو نبيلة) / أرض مشاع, مشاع (مرعى خاضع للاستخدام المشترك) / حديقة عامة, متنزه (قطعة أرض مفتوحة للاستخدام الترفيهي في منطقة حضرية)\nمثال: ذهبوا في نزهة في الحديقة",
 "入会者": "مُشَارِك / دَاخِل, وَافِد",
 "入会金": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "入伸": "إِلْهَام, وَحْي / عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "入來": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "入冦": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان.",
 "入出力": "آيُّو",
 "入出力プロセッサ": "ضغط داخل العين (الضغط الذي تمارسه السوائل داخل مقلة العين؛ ينظم بواسطة مقاومة التدفق الخارجي للخلط المائي)\nمثال: يمكن أن ينتج الجلوكوما عن زيادة الضغط داخل العين",
