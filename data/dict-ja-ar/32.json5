 "務長官": "سِكْرِتِير, سِكْرِتِيرَة",
 "勝": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / بشكل سائد, في الغالب (أكبر بكثير في العدد أو التأثير)\nمثال: المرضى في الغالب من السكان الأصليين",
 "勝ちとる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち上がる": "يقرب",
 "勝ち取る": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち得る": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "勝ち戦": "اِنْتِصَار, نَصْر",
 "勝ち抜き": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "勝ち抜き戦": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "勝ち星": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝ち気": "إرَادَة / رَغْبَة, إرَادَة",
 "勝ち点": "مَفْصِل, مِفْتَاح",
 "勝ち目": "فُرْصَة",
 "勝ち組": "فَائِز, فَائِزَة",
 "勝ち組み": "فَائِز, فَائِزَة",
 "勝ち虫": "يَعْسُوب",
 "勝ち誇る": "نصر (نصر بمعنى: أعان، نصره الله: أعانه)\nمثال: هذا النصر هو نصركم.",
 "勝ち軍": "اِنْتِصَار, نَصْر",
 "勝ち馬": "فَائِز, فَائِزَة",
 "勝つ": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝つる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝てば官軍": "التاريخ يكتبه المنتصرون",
 "勝てば官軍、負ければ賊軍": "التاريخ يكتبه المنتصرون",
 "勝る": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل) / ثَقَلَ (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "勝利": "اِنْتِصَار, نَصْر",
 "勝利を収める": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "勝利者": "فَائِز, فَائِزَة",
 "勝勢": "أَرْجَحِيَّة, فُرْصَة (احتمالية حدوث شيء بدلاً من عدم حدوثه) / أَرْجَحِيَّة, اِحْتِمَالَات الفَوْز (النسبة التي يزيد بها رهان مقامر على آخر)\nمثال: عرض احتمالات اثنين إلى واحد",
 "勝地": "حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة)",
 "勝得る": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "勝戦": "اِنْتِصَار, نَصْر",
 "勝手": "أَنَانِيَّة / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / مُلَاءَمَة, مُنَاسَبَة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "勝手に": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "勝手にしやがれ": "مَبْهُور, لَاهِث",
 "勝手口": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "勝手向き": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "勝手気まま": "أَهْوَج, ذَاتِيّ الإِرَادَة (ميّال بطبعه إلى العصيان والمعارضة)",
 "勝抜き": "بطولة, دورة (منافسة رياضية يلعب فيها المتسابقون سلسلة من الألعاب لتحديد الفائز) / بطولة مبارزة, مبارزة (سلسلة من المبارزات بين الفرسان للتنافس على جائزة)",
 "勝敗": "نَتِيجَة",
 "勝気": "إرَادَة / رَغْبَة, إرَادَة",
 "勝点": "مَفْصِل, مِفْتَاح",
 "勝組": "فَائِز, فَائِزَة",
 "勝絶": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "勝者": "فَائِز, فَائِزَة",
 "勝訴": "اِنْتِصَار, نَصْر",
 "勝負": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "勝負どころ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "勝負なし": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "勝負事": "قِمَار, مُقَامَرَة",
 "勝負師": "مُقَامِر / مُغَامِر / مغامر, مُخاطر (شخص يخاطر بالخسارة أو الإصابة أملاً في الكسب أو الإثارة)",
 "勝負所": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "勝馬": "فَائِز, فَائِزَة",
 "募る": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة)) / مجند جديد, مستجد (جندي تم تجنيده حديثاً)",
 "募入": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "募兵": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة)) / مجند جديد, مستجد (جندي تم تجنيده حديثاً)",
 "募金": "تَبَرَّعَ",
 "募集": "تَعْبِئَة / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم) / طفو (ظاهرة الطفو (البقاء على سطح السائل دون الغرق))",
 "募集人": "المنجد",
 "勢": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "勢い": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "勢いよく": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "勢い良く": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "勢ぞろい": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "勢ふ": "تَنَافَسَ, تَبَارَى",
 "勢み車": "حَدَّافَة",
 "勢力": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "勢力図": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "勢力圏": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "勢力均衡": "توازن القوى",
 "勢力範囲": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "勢力関係": "توازن القوى",
 "勢威": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "勢子": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد)",
 "勢揃い": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "勢車": "حَدَّافَة",
 "勢運": "رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "勤め": "خِدْمَة",
 "勤める": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "勤め人": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "勤め口": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "勤め奉公": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "勤め振り": "اجتهاد, انكباب (اجتهاد وانتباه عظيم ومستمر)",
 "勤倹": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "勤労": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "勤労者": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "勤労階級": "اَلطَّبَقَة الْعَامِلَة",
 "勤勉": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "勤勉家": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "勤務": "خِدْمَة\nمثال: その警備員は一晩中勤務だった。 — حرس الحارس الليل بطوله.",
 "勤務員": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "勤務地": "محل عمل, مكان عمل (منشأة (مصنع أو متجر أو مستودع، إلخ) حيث تدار الأعمال، أو تُصنع البضائع أو تُخزن أو تُعالج، أو تُقدم الخدمات)",
 "勤務場所": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "勤務者": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "勤行": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "勤行時報係": "مُؤَذِّن",
 "勧め": "تَوْصِيَة",
 "勧める": "وَصَّى, أَوْصَى / يوصي يقترح, نصح / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "勧告": "نَصِيحَة, مَشُورَة",
 "勧告案": "تَوْصِيَة",
 "勧告者": "مستشار, ناصح (خبير يقدم المشورة)\nمثال: ساعد مستشار الطلاب في اختيار دوراتهم",
 "勧善懲悪": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط والإنْصَاف)\nمثال: يريدون العدالة.",
 "勧善懲悪劇": "مسرحية أخلاقية (مسرحية رمزية شاعت في القرنين الخامس عشر والسادس عشر؛ حيث تجسد الشخصيات الفضائل والرذائل)",
 "勧奨": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "勧工場": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "勧業": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "勧誘": "دَعْوَة, عزيمة / إِغْرَاء",
 "勧誘員": "جامع الأصوات (شخص يأخذ أو يعد الأصوات) / منظم استطلاعات الرأي (شخص يجري دراسات استقصائية للرأي العام) / فاحص الأصوات (شخص يفحص الأصوات في الانتخابات) / جامع تبرعات, مستجدي (ملتمس يطلب مساهمات أو تجارة أو أصوات)\nمثال: منظم الاستطلاعات يجري استطلاعات الرأي العام",
 "勧説": "استعجال, حث (فعل الدعم أو التشجيع بجدية) / إلحاح (طلب وتوسل بإصرار) / تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: لم يترك لي إلحاحه بديلاً سوى الموافقة",
 "勧進元": "داعم مالي, ممول (شخص يقدم الدعم المالي لمشروع ما)",
 "勲": "إِنْجَاز / جَدَارَة",
 "勲し": "إِنْجَاز / شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح. / فَاضِل, جَدِير",
 "勲功": "جَدَارَة",
 "勲章": "زينة",
 "勲等": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "勾引": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران. / مُخْتَطِف",
 "勾引し": "مُخْتَطِف",
