 "十字路": "مُفْتَرَق, تَقَاطُع",
 "十字軍": "حَمْلَة صَلِيبِيَّة / حَرْب صَلِيبِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "十年": "عَقْد (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "十年選手": "مُحَارِب قَدِيم",
 "十徳ナイフ": "سِكِّين سْوِيسِرِيّ (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ)\nمثال: أحتاج الى سكين.",
 "十戒": "الْوَصَايَا الْعَشْر",
 "十文字": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "十文字に": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض) / بِشَكْل مُعَاكِس, عَلَى نَحْو مُخَالِف (ليس بالطريقة المقصودة) / صَلِيبِيّ, مُتَقَاطِع (على شكل صليب أو قطعة أفقيَّة منه) / عرضي (يقع أو يمتد عبر طول الشيء أو في اتجاه متقاطع)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "十方": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "十時": "اَلسَّاعَة اَلْعَاشِرَة",
 "十月": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "十本": "عَشَرَة, عَشْرَة",
 "十柱戯": "بولينغ ذو عشرة دبابيس (البولينغ في مسار نحو هدف مكون من عشرة دبابيس خشبية)",
 "十死一生": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم)",
 "十種競技": "عشاري, مسابقة العشاري (مسابقة رياضية تتكون من عشر فعاليات مختلفة)",
 "十腕類": "عشاريات الأرجل (رأسيات الأرجل التي لها ثمانية مجسات قصيرة بالإضافة إلى اثنين طويلين) / عشاريات الأرجل (قشريات تتميز بوجود خمسة أزواج من الزوائد الحركية كل منها متصل بقطعة من الصدر)",
 "十角形": "عشاري الأضلاع, معشر (مضلع له 10 أضلاع و10 زوايا)",
 "十辺形": "عشاري الأضلاع, معشر (مضلع له 10 أضلاع و10 زوايا)",
 "十進": "عَشْرِيّ",
 "十進制": "النظام العشري, نظام العد العشري (نظام عد موضعي يستخدم أرقاماً عشرية وأساساً هو العشرة)",
 "十進小数": "كَسْر عَشْرِيّ (كسر حقيقي مقامه قوة للعدد 10)",
 "十進小数点": "فَاصِل عَشْرِيّ",
 "十進数": "عَشْرِيّ",
 "十進法": "النظام العشري, نظام العد العشري (نظام عد موضعي يستخدم أرقاماً عشرية وأساساً هو العشرة)",
 "十進表記": "تدوين عشري (أي تدوين يستخدم 10 أحرف مختلفة (عادة الأرقام من 0 إلى 9))",
 "十部門分類法": "تصنيف ديوي العشري (نظام تستخدمه المكتبات لتصنيف المنشورات غير الروائية إلى فئات موضوعية)",
 "十重": "عَشَرَة أَضْعَاف (بمقدار عشر مرات) / عُشَارِيّ (يحتوي على عشرة أو عشرة أجزاء)\nمثال: زاد عدد السكان عشرة أضعاف",
 "十重二十重": "جماهير, جموع (عامة الناس بشكل عام) / جمهور, حشد كبير (تجمع كبير للناس) / جموع, حشد (كمية كبيرة غير محددة)\nمثال: افصل المحاربين عن الجموع",
 "十面体": "عشاري السطوح (أي متعدد سطوح له عشرة أوجه مستوية)",
 "千": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "千々": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "千万": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل",
 "千万無量": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "千万長者": "مِلْيَارْدِير",
 "千三屋": "سِمْسَار, وَسِيط",
 "千世": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "千両役者": "إِجَّامَة / نَجْمَة",
 "千九百年代": "عقد 1900 (العقد من 1900 إلى 1909)",
 "千代": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "千代万代": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "千仭の谷": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "千倍": "ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف",
 "千億": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "千六本": "جوليان (حساء صافي مزين بخضروات مقطعة شرائح رفيعة (جوليان)) / جوليان, خضار مقطع شرائح (خضار مقطع إلى شرائح رفيعة)",
 "千分": "جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي)",
 "千切る": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "千千": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "千古": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "千古不滅": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "千古不磨": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "千寿蘭": "حربة إسبانية, يوكا ألوفوليا (يوكا صلبة بجذع قصير؛ توجد في جنوب الولايات المتحدة وأمريكا الاستوائية؛ لها أوراق صلبة مدببة بشوكة وعناقيد من الزهور البيضاء)",
 "千尋": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "千尋の谷": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "千島": "جُزُر اَلْكُورِيل (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "千島列島": "جُزُر اَلْكُورِيل (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "千島鵜烏": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود) / خَجُول, مُحْمَرُّ الوَجْه (محمرّ الوجه من الحرج أو الخجل أو الانفعال)",
 "千島鵜鴉": "مُتَوَرِّد, مُحْمَرّ ((خاصة للوجه) محمر أو مشبع بالدم من الانفعال أو المجهود) / خَجُول, مُحْمَرُّ الوَجْه (محمرّ الوجه من الحرج أو الخجل أو الانفعال)",
 "千差万別": "مُتَعَدِّد, مُتَنَوِّع",
 "千年": "أَلْفِيَّة",
 "千年期": "أَلْفِيَّة",
 "千年王国": "أَلْفِيَّة",
 "千年王国説": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "千年紀": "أَلْفِيَّة",
 "千年説": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "千度": "ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف",
 "千態万状": "اخْتِلَاف, تَعَدُّدِيَّة (عدم تجانس ملحوظ)\nمثال: تنوع في الاحتمالات",
 "千成り": "عُنْقُود, عُنْقُود نَجْمِيّ / قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "千成瓜": "شَايُوت",
 "千成瓢箪": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "千振": "ذبابة ألدر (حشرة داكنة اللون لها يرقات مائية مفترسة)",
 "千日紅": "قطيفة كروية, مدنة (عشب أمريكي استوائي له زهور وردية إلى حمراء أو أرجوانية يمكن تجفيفها دون أن تفقد لونها)",
 "千日草": "قطيفة كروية, مدنة (عشب أمريكي استوائي له زهور وردية إلى حمراء أو أرجوانية يمكن تجفيفها دون أن تفقد لونها)",
 "千枚張り": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "千枚通し": "مِخْرَز, إِشْفَى",
 "千歳": "أَلْفِيَّة",
 "千歳鳥": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "千生り": "عُنْقُود, عُنْقُود نَجْمِيّ / قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "千生瓢箪": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة)",
 "千番": "ألف ضعف (بمقدار ثلاثة درجات أسية (ألف مرة))\nمثال: هذا السم أكثر سمية بألف ضعف",
 "千種": "مُخْتَلِف, مُتَنَوَّع",
 "千種万様": "مُتَعَدِّد, مُتَنَوِّع",
 "千篇一律": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "千編一律": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "千般": "اِخْتِلَاف",
 "千葉": "تْشِيبَا",
 "千載": "أَلْفِيَّة",
 "千載一遇": "ذَهَبِيّ",
 "千載不磨": "خَالِد (الخلود)\nمثال: خالد هو مواطن كويتي.",
 "千里": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "千里眼": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس) / اِسْتِبْصَارِيّ, بَصِير (يستشرف المستقبل ويتوقّعه) / بَصِير, ذُو رُؤْيَة خَارِقَة (يدرك أشياء تتجاوز نطاق الحواسّ الطبيعية) / عرّاف, مستبصر (شخص لديه قوة الاستبصار)",
 "千里鏡": "تِلِسْكُوب, مِقْرَاب",
 "千鳥": "زقزاق (أي من طيور شاطئية عديدة ذات بنية مدمجة نسبياً ومناقير مستقيمة وأجنحة مدببة كبيرة؛ قريبة الصلة بطيور الطيطوي)",
 "千鳥がけ": "تطريز متقاطع, غرزة إكس (تطريز يتم بأزواج من الغرز تتقاطع مع بعضها البعض) / غرزة إكس, غرزة متقاطعة",
 "千鳥掛け": "تطريز متقاطع, غرزة إكس (تطريز يتم بأزواج من الغرز تتقاطع مع بعضها البعض) / غرزة إكس, غرزة متقاطعة",
 "千鳥柄": "كاروهات مسننة, نمط سن الكلب (نسيج بنمط مربعات صغيرة مكسورة أو خشنة)",
 "千鳥格子": "كاروهات مسننة, نمط سن الكلب (نسيج بنمط مربعات صغيرة مكسورة أو خشنة)",
 "千鳥草": "أوركيد عطري (أوركيد أوروبي ذو سنابل كثيفة من زهور وردية أو ليلكية أو حمراء عطرة بمهاميز بارزة) / عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "卄": "عِشْرُونَ",
 "升": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟",
 "升形": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "升目": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟",
 "午": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان. / جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب. / ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "午刻": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "午前": "صَبَاح / غُدْوة / صُبْح (أَشْرَقَ، أَضَاءَ) / صباح / صُبُح (أَشْرَقَ، أَضَاءَ)\nمثال: كان يريد أن بصبح حاخاما.",
 "午前零時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "午後": "بَعْد الظُّهْر, بَعْدَ الزَّوَال (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "午後零時": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "午睡": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة",
 "午飯": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "午餐": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "半": "نِصْف, نُصْف / عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "半々": "مُنَاصَفَةً, بِالنِّصْف",
 "半そで": "كم قصير, نصف كم (كم يمتد من الكتف إلى الكوع)",
