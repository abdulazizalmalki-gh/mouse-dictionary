 "信": "أمانة, صدق (صفة كون الشخص صادقاً) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية) / ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / إِيمَان, مُعْتَقَد / إِيمَان, دِين",
 "信じがたい": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "信じきる": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信じようと信じまいと": "صدق أو لا تصدق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "信じられない": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "信じる": "صَدَّقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / ظَنَّ, آمَنَ (عَلِمَ بغير يقين؛ عَلِمَ بيقين) / آمَنَ بِـ (وَثِقَ وصَدَّقَ؛ جعله في مأمن، بمفعول، وقد يتعدى بمفعول ثاني بمن)\nمثال: صدق سامي كل شيء.",
 "信じ切る": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信じ難い": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "信ずべき": "ثِقَةٌ",
 "信ずる": "صَدَّقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / ظَنَّ, آمَنَ (عَلِمَ بغير يقين؛ عَلِمَ بيقين) / آمَنَ بِـ (وَثِقَ وصَدَّقَ؛ جعله في مأمن، بمفعول، وقد يتعدى بمفعول ثاني بمن)\nمثال: صدق سامي كل شيء.",
 "信仰": "إِيمَان, مُعْتَقَد / إِيمَان, دِين\nمثال: キリスト教を信仰していますか。 — هل تؤمن بالمسيحية؟",
 "信仰の自由": "حُرِّيَّة اَلدِّين, حُرِّيَّة اَلْمُعْتَقَد (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "信仰心": "تَقْوَى / بِرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "信仰深い": "مُتَدَيِّن",
 "信仰的": "دِينِيّ / مُتَدَيِّنٌ, دَيِّنٌ",
 "信仰者": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "信任": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信任投票": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "信任状": "اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة)",
 "信任票": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "信倚": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信切る": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信受": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان",
 "信号": "إِشَارَة / إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة",
 "信号塔": "برج الإشارات, صندوق الإشارات (مبنى يتم من خلاله إرسال الإشارات للتحكم في حركة القطارات)",
 "信号対ノイズ比": "نِسْبَة الإِشَارَة إِلَى الضَّجِيج (نسبة كثافة الإشارة إلى كثافة الضجيج)",
 "信号強度": "القوات الخاصة, شوتزشتافل (قوة شرطة خاصة في ألمانيا النازية تأسست كحرس شخصي لأدولف هتلر عام 1925؛ أدارت القوات الخاصة معسكرات الاعتقال) / الخدمة السرية الأمريكية (وكالة الاستخبارات الأمريكية التي تحمي الرؤساء ونواب الرئيس الحاليين والسابقين وعائلاتهم المباشرة وتحمي الزوار الأجانب المتميزين؛ تكشف وتقبض على مزوري…)",
 "信号拳銃": "مسدس إشارة, مسدس فيري (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ)\nمثال: كان عند زيري مسدس.",
 "信号旗": "راية إشارة, علم (قطعة مستطيلة من القماش تستخدم كجهاز للإشارة)",
 "信号検出": "كشف الإشارة (الكشف عن استقبال إشارة)",
 "信号機": "إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة / إِشَارَة",
 "信号灯": "ضوء الإشارة, نار الإشارة (نار تُشعل كإشارة) / إشارة بصرية, سيمافور (جهاز للإشارات البصرية باستخدام الأضواء أو الأذرع المتحركة ميكانيكياً)",
 "信号炎管": "بادئ إشعال, فتيل (أي مشعل يستخدم لبدء حرق الوقود الدافع) / عود ثقاب مقاوم للرياح (عود ثقاب احتكاكي برأس كبير يظل مشتعلاً في الرياح) / شعلة تحذير (شعلة ملونة تستخدم كإشارة تحذير من قبل الشاحنات والقطارات) / فيوزي, محرك فيوزي (عمود دوران ذو أخدود حلزوني في الساعة يعمل على موازنة القوة المتناقصة للنابض الرئيسي أثناء انبساطه)",
 "信号符字": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "信号雑音比": "نِسْبَة الإِشَارَة إِلَى الضَّجِيج (نسبة كثافة الإشارة إلى كثافة الضجيج)",
 "信号電波": "خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "信士": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "信天翁": "قَطْرَس (طائر بحري كبير)",
 "信夫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "信奉": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان\nمثال: 開拓民たちはキリスト教を信奉した。 — أعتنق المستوطنون الديانة المسيحيّىة.",
 "信奉者": "لَاصِق, مُلْتَصِق (ملتصق بإحكام) / تابِع, تِلْمِيذ (شخص يؤمن بمذهب شخص آخر ويساعد في نشره)",
 "信女": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "信実": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "信州": "نَاغَانُو",
 "信徒": "شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً)",
 "信心": "إِيمَان, مُعْتَقَد / إِيمَان, دِين",
 "信心家": "متعصب ديني, مهووس بالدين (شخص مدمن على الدين أو متعصب ديني)",
 "信心深い": "مُتَدَيِّن",
 "信念": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان",
 "信愛": "أُلْفَة",
 "信憑": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信憑性": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها)",
 "信教": "إيمان, دين (اعتقاد قوي بقوة أو قوى خارقة للطبيعة تتحكم في المصير البشري)\nمثال: فقد إيمانه ولكن ليس أخلاقه",
 "信教の自由": "حُرِّيَّة اَلدِّين, حُرِّيَّة اَلْمُعْتَقَد (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "信書": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "信望": "ثِقَة",
 "信条": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول)",
 "信濃胡桃": "جوز إنجليزي, جوز فارسي (جوز أوراسي يقدر لجوزه الكبير الصالح للأكل وخشبه الصلب الغني بالنقوش؛ يزرع على نطاق واسع)",
 "信用": "ثِقَة / اِئْتِمَان",
 "信用リスク": "مَخَاطِر الاِئْتِمَان",
 "信用借り": "دين شرف (التزام، خاصة ديون المقامرة القائمة على وعد شفهي، لا يكون ملزماً قانونياً ولكنه يعتبر مضموناً بالنزاهة الأخلاقية للمدين)\nمثال: يجب أن أوفر له المال - إنه دين شرف",
 "信用協同組合": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "信用危機": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة مرتفعة)",
 "信用収縮": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة مرتفعة)",
 "信用性": "مِصْدَاقِيّة",
 "信用格付け": "تصنيف ائتماني, جدارة ائتمانية (تقدير، بناءً على تعاملات سابقة، لقدرة شخص أو منظمة على الوفاء بالتزاماتهم المالية)",
 "信用格付機関": "تصنيف ائتماني, جدارة ائتمانية (تقدير، بناءً على تعاملات سابقة، لقدرة شخص أو منظمة على الوفاء بالتزاماتهم المالية)",
 "信用状": "خطاب اعتماد (وثيقة يصدرها بنك تضمن دفع حوالة العميل؛ تستبدل ائتمان البنك بائتمان العميل)",
 "信用組合": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "信用組合全国協会": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "信用詐欺": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "信用金庫": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "信疑": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها)",
 "信管": "فَتِيل / مُنْصَهِرَة, مصهر",
 "信約": "نَذْر / نَذَرَ",
 "信組": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "信経": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول)",
 "信義": "إِيمَان, مُعْتَقَد / إِيمَان, دِين",
 "信者": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد. / معجب مهووس (معجب ذكر مهووس بموضوع معين (خاصة شخص أو شيء في وسائل الترفيه الشعبية))",
 "信藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "信託": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信託会社": "شركة أمينة, شركة ائتمان (منظمة (عادة مع بنك تجاري) تعمل كوصي أو وكيل ائتماني في التعامل مع صناديق الائتمان أو التركات أو ترتيبات الحفظ أو تحويلات الأسهم أو الخدمات ذات الصلة)",
 "信託基金": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "信託統治": "أمانة, وصاية (منصب الوصي أو عضو مجلس الأمناء) / إقليم خاضع للوصاية (بلد تابع؛ يُدار بواسطة بلد آخر تحت إشراف الأمم المتحدة)",
 "信託統治理事会": "مجلس الوصاية (مجلس دائم للأمم المتحدة يكلف دولة (أو دول) بتولي إدارة إقليم ما)",
 "信託証書": "سند الوصاية, صك الائتمان (صك مكتوب ينقل الملكية قانوناً إلى وصي يستخدم غالباً لتأمين التزام مثل الرهن العقاري أو السند الإذني)",
 "信託資金": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "信証": "دَلِيل, بُرْهَان / دَلِيل",
 "信認": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "信金": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "信頼": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "信頼に足る": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه) / صَحِيح, مَوْثُوق (مطابق للحقائق وبالتالي جدير بالتصديق)",
 "信頼のおける": "مَوْثُوق",
 "信頼の於ける": "مَوْثُوق",
