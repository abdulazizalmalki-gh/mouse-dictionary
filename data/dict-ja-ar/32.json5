 "内戦": "حَرْب أَهْلِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "内所": "سِرِّيَّة / مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ.",
 "内挿": "إقحام, اعتراض (فعل إقحام أو إدراج إجراء أو ملاحظة تقاطع الحديث) / إقحام داخلي, استكمال ((رياضيات) حساب قيمة دالة بين القيم المعروفة بالفعل) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية",
 "内接": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "内攻": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة)",
 "内政干渉": "تَدَخُّل, تَطَفُّل",
 "内教": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "内斜視": "حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف)",
 "内方": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي. / زَوْجَة, اِمْرَأَة",
 "内旋": "التفاف, انطواء (عملية لف شيء ما) / أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة) / اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "内村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "内果皮": "الغِلاف الدَّاخِلِيّ, عَجْمَة (الطبقة الداخلية الصلبة (عادة خشبية) لغلاف الثمرة في بعض الفواكه (كالخوخ أو البرقوق أو الكرز أو الزيتون) والتي تحتوي على البذرة)\nمثال: يجب إزالة النوى من البرقوق قبل الطهي",
 "内毒素": "ذيفان داخلي (ذيفان محصور داخل الكائنات الدقيقة ولا يتم إطلاقه إلا عند تحلل الكائنات الدقيقة أو موتها)",
 "内気": "خَجُول, خَجِل / خَجُول",
 "内水": "مياه إقليمية (المياه المحيطة بدولة ما وأقاليمها والتي تمارس تلك الدولة سيادة قضائية عليها)",
 "内洋": "بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "内海": "بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة.",
 "内湾": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه)",
 "内火艇": "أَطْلَقَ, قَذَفَ",
 "内燃": "احتراق داخلي (احتراق الوقود داخل أسطوانة (كما في محرك الاحتراق الداخلي))",
 "内燃機関": "مُحَرِّك اِحْتِرَاق دَاخِلِيّ (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "内猫": "قط, قط أليف (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "内玄関": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "内生": "عملية داخلية المنشأ, نشاط داخلي (ظاهرة جيولوجية تحدث تحت سطح الأرض)",
 "内生的": "داخلي المنشأ (مشتق أو ناشئ داخلياً) / داخلي المنشأ (متعلق بالنباتات داخلية النمو أو يشبهها)",
 "内生胞子": "بوغ داخلي (بوغ لاجنسي صغير ينمو داخل خلية بعض البكتيريا والطحالب)",
 "内用": "أمور شخصية, شأن خاص (مسائل ذات اهتمام شخصي)",
 "内田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "内申書": "نُسْخَة",
 "内発的": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / تلقائي, عفوي (يحدث أو ينشأ دون سبب خارجي ظاهر)\nمثال: ضحك عفوي",
 "内的": "داخلى",
 "内的要因": "عامل داخلي (مادة ينتجها الغشاء المخاطي للمعدة والأمعاء ضرورية لامتصاص فيتامين ب 12)\nمثال: نقص العامل الداخلي يمكن أن يؤدي إلى فقر الدم الخبيث",
 "内皮": "بِطَانَة",
 "内省": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "内省的": "تَأَمُّلِيّ, تَفَكُّرِيّ (مُكرَّس للشؤون الفكرية والعقلية) / عاكس (قادر على عكس الضوء أو الصوت فيزيائياً) / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)\nمثال: سطح عاكس",
 "内眼角贅皮": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "内着": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "内破": "انحباس صوتي, انطباق (المرحلة الانحباسية الأولية للصامت الانفجاري) / انفجار داخلي, انكماش (انهيار مفاجئ نحو الداخل)\nمثال: انفجار المصباح الكهربائي نحو الداخل",
 "内科": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "内科医": "طَبِيب, طَبِيبة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "内科学": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "内積": "جُدَاء قِيَاسِيّ, ضَرْب نُقَطِيّ (عدد حقيقي (كمية قياسية) هو حاصل ضرب متجهين)",
 "内約": "خِطْبَة, خُطُوبَة",
 "内緒": "سِرِّيَّة",
 "内緒ごと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "内緒事": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "内縁": "بحكم الأمر الواقع",
