 "入口": "دُخُول / مَدْخَل",
 "入営": "تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية)) / فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "入団": "اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة",
 "入国者": "مُشَارِك / دَاخِل, وَافِد",
 "入園料": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "入園者": "مُشَارِك / دَاخِل, وَافِد",
 "入城料": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "入域": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب",
 "入場": "دُخُول / مَدْخَل",
 "入場口": "دُخُول / مَدْخَل",
 "入場料": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "入場者": "زَائِر / زَائِر, سَائِح",
 "入学": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "入学考査": "امتحان القبول (امتحان لتحديد استعداد المرشح لدورة دراسية)",
 "入学試験": "امتحان القبول (امتحان لتحديد استعداد المرشح لدورة دراسية)",
 "入定": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "入寂": "اَلنِّرْفَانَا",
 "入寇": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان.",
 "入射": "سقوط, ورود (اصطدام شعاع ضوئي بسطح ما) / مُعَدَّل الحُدُوث, نِسْبَة الوُقُوع (التكرار النسبي لحدوث شيء ما)\nمثال: قاس زاوية سقوط الضوء المنعكس",
 "入射角": "زاوية السقوط, زاوية الورود (الزاوية التي يصنعها خط مع خط عمودي على السطح عند نقطة السقوط)",
 "入居": "إشغال, احتلال (فعل شغل أو الاستيلاء على مبنى)\nمثال: إشغال مبنى بدون شهادة إشغال غير قانوني",
 "入居者": "مُسْتَأْجِر",
 "入山料": "تسلق الجبال (نشاط تسلق الجبال)",
 "入庫": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "入念": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "入所": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "入所者": "سَاكِن, سَاكِنَة",
 "入手": "اِكْتِسَاب",
 "入手不可": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "入手不可能": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "入手先": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "入手可能": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "入掛": "يُعَلِّق / تَعْلِيق",
 "入換": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "入換え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "入数": "كَمِّيَّة, مِقْدَار",
 "入替": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "入替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "入木": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "入札": "عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "入札価格": "سِعْر عَطاء, سِعْر عَرْض (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "入札者": "مُزَايِد",
 "入来": "وُصُول, وِفَادَة",
 "入来田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "入来院": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "入校": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "入格": "اسْتِدْلَالِيّ (يُعبّر عن استنتاج أو يسبقه) / اسْتِنْتَاجِيّ (يُشبه الاستنتاج أو يعتمد عليه أو يُتوصّل إليه بالاستدلال) / استدلالي, استنتاجي (متعلق بـ أو له طبيعة الاستدلال أو الاستنتاج)\nمثال: الملكة الاستدلالية للعقل",
 "入植": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "入植地": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "入植者": "مُسْتَوْطِن, مُسْتَعْمِر",
 "入構": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب",
 "入歯": "بدلة سنية, طقم أسنان (جهاز سني يستبدل الأسنان المفقودة بشكل صناعي)",
 "入水": "غَرِقَ / أَغْرَقَ",
 "入江": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه)",
 "入浴": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام)",
 "入海": "خَلِيج, شَرْم",
 "入湯税": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "入滅": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "入牢": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "入物": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "入獄": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)",
 "入用": "حَاجَة, ضَرُورَة / اِحْتَاجَ / أتعاب التقاضي, تكاليف قانونية (تعويض مالي للطرف الرابح عن نفقات التقاضي) / حَاجَة, ضَرُورَة / اِحْتَاجَ / صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "入監": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "入目": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "入相": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "入神": "إِلْهَام, وَحْي",
 "入祭唱": "إنتويت, مقدمة دينية (تكوين من الموسيقى الصوتية مناسب لافتتاح الخدمات الكنسية)",
 "入航": "دُخُول / مَدْخَل",
 "入船": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "入角": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "入試": "امتحان القبول (امتحان لتحديد استعداد المرشح لدورة دراسية)",
 "入費": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "入賞": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "入質": "جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "入超": "عجز الميزان التجاري, عجز تجاري (زيادة الواردات على الصادرات)",
 "入車": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "入道": "كَاهِن, قِسِّيس / أَصْلَع (يفتقر إلى الشعر على كل أو معظم فروة الرأس)",
 "入道雲": "ركام مزني, سحابة رعدية (سحابة داكنة ذات امتداد عمودي كبير مشحونة بالكهرباء؛ ترتبط بالعواصف الرعدية)",
 "入選": "انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "入金": "إيراد إجمالي, مقبوضات (المبلغ الكامل للدخل قبل إجراء أي خصومات) / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "入鋏": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "入門": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "入門書": "كِتَاب تَمْهِيدِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "入門者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "入院": "استشفاء, رعاية في المستشفى (الوضع تحت الرعاية الطبية في المستشفى) / تأمين دخول المستشفى (تأمين يدفع كل أو جزء من نفقات المستشفى للمريض) / استشفاء, تنويم في المستشفى (حالة تلقي العلاج كمريض داخل المستشفى) / إقامة بالمستشفى, استشفاء (فترة زمنية تكون فيها محتجزاً في المستشفى للعلاج)\nمثال: كان يأمل تجنب نفقات الاستشفاء",
 "入隅": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "入隊": "تَجَنُّد, تَطَوُّع (فعل التطوع (كما في الخدمة العسكرية)) / فترة تجنيد, فترة خدمة (فترة زمنية تقضى في الخدمة العسكرية)",
 "入館": "إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل",
 "入館料": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "入館者": "زَائِر / زَائِر, سَائِح",
 "入魂": "أُلْفَة",
 "全": "كُلّ, جَمِيع / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "全い": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "全う": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "全うする": "أَدَّى",
 "全か無かの法則": "قانون الكل أو لا شيء ((في الفسيولوجيا العصبية) نبضة عصبية ناتجة عن محفز ضعيف تكون قوية تمامًا مثل نبضة عصبية ناتجة عن محفز قوي)",
 "全き": "كَمَال, إتقان",
 "全く": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا . / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "全くする": "أَدَّى",
 "全くと言っていいほど": "أبداً",
 "全くのところ": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "全くの所": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "全くもって": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "全て": "كُلّ شَيْء / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "全てにおいて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "全てに於いて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "全ての道はローマに通ず": "كُلُّ الطُّرُقِ تُؤَدِّي إِلَى رُومَا",
 "全クリ": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم)",
 "全タイ": "لَاصِق بِالجِلْد (ضَيِّق جِدًّا بِحَيْث يَلْتَصِق بِالجِلْد)",
 "全一": "وَحْدَة, اِتِّحَاد",
 "全世界的": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ",
 "全乳": "حَلِيب كَامِل الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "全人": "وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "全人代": "مركز منع الانتشار (وكالة تعمل كنقطة محورية لجميع أنشطة مجتمع الاستخبارات المتعلقة بمنع انتشار أسلحة الدمار الشامل وأنظمة إطلاق الصواريخ الخاصة بها)",
