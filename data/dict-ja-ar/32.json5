 "内縁の妻": "بحكم الأمر الواقع",
 "内縁関係": "بحكم الأمر الواقع",
 "内罐": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "内義": "سِرِّيَّة",
 "内耳": "أذن داخلية, تيه (نظام معقد من التجاويف المترابطة؛ معني بالسمع والتوازن)",
 "内耳炎": "التهاب الأذن الداخلية, التهاب التيه (التهاب الأذن الداخلية؛ يمكن أن يسبب الدوار والقيء)",
 "内耳神経": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "内聞": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "内職": "وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "内肛動物": "داخلي الشرج (أي من الحيوانات المائية المختلفة التي تشبه الطحالب وتشكل عادة مستعمرات متفرعة)",
 "内股": "أروح, حنف القدم (ذو قدمين تتجهان نحو الداخل)",
 "内股に": "أروح, حنف القدم (ذو قدمين تتجهان نحو الداخل)",
 "内股膏薬": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "内胚乳": "سويداء (نسيج مغذٍ يحيط بالجنين داخل بذور النباتات الزهرية)",
 "内胚葉": "أديم باطن, الأرومة الباطنة (الطبقة المنتشة الداخلية التي تتطور لتشكل بطانة الجهاز الهضمي والتنفسي)",
 "内腔": "لُومِن",
 "内臓": "حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم)",
 "内臓逆位": "انقلاب الأحشاء, تبدل الموضع (أي وضع غير طبيعي لأعضاء الجسم)",
 "内臓逆位症": "انقلاب الأحشاء, تبدل الموضع (أي وضع غير طبيعي لأعضاء الجسم)",
 "内臓錯位": "انقلاب الأحشاء, تبدل الموضع (أي وضع غير طبيعي لأعضاء الجسم)",
 "内蒙": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "内蒙古": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "内蒙古自治区": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "内蔵": "داخلي (يحدث أو ينشأ أو يقع ضمن بعض الحدود أو خاصة السطح) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / دَاخِلِيّ, وَطَنِيّ (دَاخِلَ حُدُودِ البَلَدِ) / دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)\nمثال: أعضاء داخلية / غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "内蔵装置": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "内藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "内衣嚢": "جيب داخلي (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "内装": "هَنْدَسَةُ دِيكُور (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "内見": "عرض خاص, عرض مسبق (عرض لجمهور مختار قبل الإصدار للجمهور العام) / عَرْض تَرْوِيجِيّ, مَقْطَع دِعَائِيّ (إعلان يتكون من مشاهد قصيرة من فيلم سينمائي سيظهر في المستقبل القريب)",
 "内規": "قَانُون دَاخِلِيّ, لَائِحَة دَاخِلِيَّة (قاعدة تعتمدها منظمة لتنظيم شؤونها الخاصة وسلوك أعضائها)",
 "内視鏡": "منظار داخلي (أداة طبية رفيعة وطويلة لفحص الجزء الداخلي من عضو جسدي أو إجراء جراحة بسيطة)",
 "内視鏡検査": "تنظير داخلي (فحص بصري لداخل عضو مجوف في الجسم باستخدام منظار داخلي)",
 "内覧": "عرض خاص, عرض مسبق (عرض لجمهور مختار قبل الإصدار للجمهور العام) / عَرْض تَرْوِيجِيّ, مَقْطَع دِعَائِيّ (إعلان يتكون من مشاهد قصيرة من فيلم سينمائي سيظهر في المستقبل القريب)",
 "内覧会": "عرض تجريبي (عرض مسبق لاختبار ردود فعل الجمهور)",
 "内観": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك) / تَلَازُم",
 "内角": "زاوية داخلية (الزاوية داخل ضلعين متجاورين لمضلع)",
 "内訳": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "内証": "سِرِّيَّة",
 "内証話": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "内語": "لغة أصلية, لغة أم (اللغة التي يتحدث بها الشخص منذ طفولته المبكرة)",
 "内議": "سِرِّيَّة",
 "内質": "إندوبلازم, جبلة داخلية (الجزء الداخلي من سيتوبلازم الخلية)",
 "内軟骨腫": "ورم غضروفي باطني (ورم حميد بطيء النمو يتكون من خلايا غضروفية في نهايات العظام الأنبوبية (خاصة في اليدين والقدمين))",
 "内転": "تقريب ((فسيولوجيا) تحريك جزء من الجسم نحو المحور المركزي للجسم)",
 "内転筋": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "内輪": "الدرجة الثالثة, الشرفة الثانية (المنطقة الخلفية أو العلوية في الشرفة التي تحتوي على أرخص المقاعد) / مُحَافِظ",
 "内輪同志": "مطلع (ضابط في شركة أو غيرهم ممن لديهم حق الوصول إلى معلومات خاصة حول عمليات الشركة)",
 "内辺": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "内通": "تَوَاطُؤ / خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "内通者": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة. / زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "内道": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "内部": "جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه) / جَوَّانِيّ, دَاخِلِيّ (في الداخل وباتجاه المركز) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / داخلي (يقع في أو مناسب لداخل مبنى)\nمثال: مشهد داخلي",
 "内部仕様": "قُوَّة كَامِنَة, مَوْرِد دَاخِلِيّ (مورد يوفره العقل أو القدرات الشخصية للفرد)\nمثال: امتلاك مورد داخلي ضد الوحدة",
 "内部原形質": "إندوبلازم, جبلة داخلية (الجزء الداخلي من سيتوبلازم الخلية)",
 "内部告発者": "كاشف الفساد, مُبلِّغ عن المخالفات (مخبر يكشف المخالفات داخل منظمة على أمل إيقافها)\nمثال: يعطي القانون حماية قليلة للمبلغين عن المخالفات الذين يشعرون أن للجمهور الحق في معرفة ما يحدث",
 "内部抗争": "التحام قريب (الملاكمة من مسافة قريبة) / اِقْتِتَال دَاخِلِيّ (صراع بين أعضاء نفس المنظمة (عادة ما يكون مخفياً عن الغرباء))",
 "内部犯行": "سوء استغلال الوظيفَة",
 "内部的": "داخلي (يحدث أو ينشأ أو يقع ضمن بعض الحدود أو خاصة السطح) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / دَاخِلِيّ, وَطَنِيّ (دَاخِلَ حُدُودِ البَلَدِ) / دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)\nمثال: أعضاء داخلية",
 "内部監査人": "مدقق داخلي (مدقق يعمل موظفاً في الشركة التي يتم تدقيق سجلاتها ويقدم المعلومات للإدارة ومجلس الإدارة)",
 "内部統制": "رقابة داخلية (إجراء أو نظام محاسبي مصمم لتعزيز الكفاءة أو ضمان تنفيذ سياسة أو حماية الأصول)",
 "内部者取引": "تداول المطلعين, تداول من الداخل (شراء أو بيع أسهم الشركة من قبل مسؤول في الشركة أو مطلع آخر بناءً على معلومات لم يتم الإعلان عنها ويفترض أن تظل سرية)",
 "内部詳細": "داخلي (يحدث أو ينشأ أو يقع ضمن بعض الحدود أو خاصة السطح) / بَاطِنِيّ, دَاخِلِيّ (يقع في الداخل ويتعلق بالعالم النفسي والعقلي) / دَاخِلِيّ, وَطَنِيّ (دَاخِلَ حُدُودِ البَلَدِ) / دَاخِلِيّ (يحدث داخل مؤسسة أو مجتمع واحد)\nمثال: أعضاء داخلية",
 "内野": "ساحة البيسبول الداخلية (منطقة ملعب البيسبول المحاطة بالقواعد الثلاث واللوحة الرئيسية)",
 "内野手": "لاعب الدفاع الداخلي",
 "内金": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "内釜": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "内閣": "خزانة, دولاب (قطعة أثاث تشبه الخزانة ذات أبواب وأرفف وأدراج؛ للتخزين أو العرض) / خزانة الجهاز, كونسول (مبيت للأدوات الإلكترونية، مثل الراديو أو التلفزيون) / خزانة, دولاب (مقصورة تخزين للملابس والأشياء الثمينة؛ عادة ما يكون لها قفل) / حكومة, مجلس الوزراء (أشخاص يعينهم رئيس الدولة لرئاسة الإدارات التنفيذية للحكومة والعمل كمستشارين رسميين)",
 "内閣総理大臣": "رَئِيس وُزَرَاء, رَئِيسَة وُزَرَاء",
 "内閣総辞職": "بشكل جماعي, معاً (الجميع معاً)\nمثال: خرج الطلاب بشكل جماعي",
 "内陣": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج أو درابزين) / ملاذ, ملجأ (مأوى من الخطر أو المصاعب) / مزار, مقدس (مكان مكرس تُحفظ فيه الأشياء المقدسة)",
 "内陸": "بَرًّا, نَحْو الدَّاخِل (نحو أو داخل منطقة) / دَاخِلِيّ (يقع بعيداً عن ساحل المنطقة أو حدودها)\nمثال: المدينة تقع على بعد خمسة أميال للداخل",
 "内隠し": "جيب داخلي (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "内面": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "内面の自由": "حرية الفكر (الحق في اعتناق أفكار غير شائعة)",
 "内面化": "استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "内面的": "داخلى",
 "内頚動脈": "شريان سباتي باطن (فرع الشريان السباتي الذي يغذي الدماغ والعينين والأجزاء الداخلية من الرأس بالدم)",
 "内頸動脈": "شريان سباتي باطن (فرع الشريان السباتي الذي يغذي الدماغ والعينين والأجزاء الداخلية من الرأس بالدم)",
 "内骨格": "هيكل داخلي (الهيكل العظمي الداخلي؛ البنية العظمية والغضروفية (خاصة للفقاريات))",
 "内鰐": "أَرْوَح, مُتَلَاصِقُ الرُّكْبَتَيْن (ذُو رُكْبَتَيْنِ مُتَقَارِبَتَيْنِ بِشَكْلٍ غَيْرِ طَبِيعِيٍّ مَعَ تَبَاعُدِ الكَاحِلَيْنِ)",
 "円": "يَن\nمثال: 私はそのレコードを買うのに３０００円かかった。 — دفعت 3000 ين لشراء التسجيل. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / كَافَّة, تَمَام / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة)",
 "円い": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / مُنْثَنٍ / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "円か": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "円く": "وُدِّيًّا (بطريقة ودية)\nمثال: انفصلا ودياً",
 "円すい形": "شكل مخروطي, مخروط (شكل قاعدته دائرة وتستدق جوانبه لتصل إلى نقطة)",
 "円み": "استدارة, امتلاء (الخاصية الجسدية المتمثلة في الامتلاء والاستدارة) / استدارة (الخاصية التي يمتلكها خط أو سطح منحنٍ وغير ذي زوايا) / تقريب (صفة كون الأرقام مقربة (أعداد صحيحة)) / استدارة, رخامة (امتلاء نبرة الصوت)\nمثال: أعطانا النتائج بأرقام تقريبية / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "円グラフ": "مخطط دائري (مخطط دائري مقسم إلى مناطق مثلثة تتناسب مع نسب الكل)",
 "円タク": "تَاكْسِي, سَيَّارَةُ أُجْرَة",
 "円丁": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "円丘": "أكمة, رابية (تل طبيعي صغير)",
 "円光": "هَالَة",
 "円卓": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "円卓会議": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "円口類": "دائريات الفم (فقاري مائي بدائي)",
 "円周": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "円周率": "بِي, پِي / ط, بَاي (الحرف السادس عشر في الترتيب الهجائي العربي والتاسع في ترتيب الأبجدية العربية؛ يسبقه \"ض\" ويتبعه \"ظ\"؛ عدد غير نسبي يمثل محيط الدائرة إلى قُطْرِهَا)",
 "円味": "استدارة, امتلاء (الخاصية الجسدية المتمثلة في الامتلاء والاستدارة) / استدارة (الخاصية التي يمتلكها خط أو سطح منحنٍ وغير ذي زوايا) / تقريب (صفة كون الأرقام مقربة (أعداد صحيحة)) / استدارة, رخامة (امتلاء نبرة الصوت)\nمثال: أعطانا النتائج بأرقام تقريبية / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "円唇": "مُدَوَّر (اسم فاعل من دَوَّرَ، الشخص الذي يُدَوِّر)\nمثال: هناك طاولة مدورة في غرفة الضيوف.",
 "円唇母音": "صائت مدور, صائت مضموم ((لغويات) صائت يتم نطقه مع ضم الشفتين وتشكيل فتحة دائرية)",
 "円型": "شكل مستدير (شكل منحني وبدون زوايا حادة)",
 "円子": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "円寂": "اَلنِّرْفَانَا",
 "円屋根": "قُبَّة",
 "円山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "円弾": "كرة مدفع (مقذوف صلب كان يُطلق في العصور القديمة من مدفع)",
 "円形": "شكل مستدير (شكل منحني وبدون زوايا حادة)",
 "円形交差点": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "円形劇場": "مدرج (ملعب بيضاوي كبير بصفوف مقاعد متدرجة؛ ساحة تقام فيها المسابقات والعروض) / مدرج (رواق مائل بمقاعد للمشاهدين (كما في غرفة العمليات أو المسرح))",
 "円形脱毛症": "ثعلبة بقعية (صلع متقطع (على شكل بقع))",
 "円月": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "円材": "ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم) / صارية, عارضة (عمود قوي مستدير من الخشب أو المعدن يستخدم لدعم الحبال والأشرعة) / سبار, فلسبار (أي من المعادن اللافلزية المختلفة (الكالسيت أو الفلسبار) فاتحة اللون وشفافة أو نصف شفافة وقابلة للانفصام)",
 "円板": "قُرْص / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / أُسْطُوَانَة\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "円板クラッチ": "قابض قرصي (قابض احتكاكي تكون فيه أسطح الاحتكاك عبارة عن أقراص)",
 "円板状エリテマトーデス": "ذئبة حمامية قرصية (مرض جلدي مزمن يتميز بطفح جلدي من آفات حمراء على الخدين وجسر الأنف)",
 "円柱": "عَمُود / خَانَة",
 "円柱形": "أُسْطُوَانَة",
 "円柱状": "أُسْطُوَانَة",
 "円満": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "円滑": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "円滑にする": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "円滑化": "تسهيل, تيسير (فعل المساعدة أو جعل تقدم شيء ما أو تحسينه أسهل) / تسهيل, تسهيل عصبي ((في الفسيولوجيا العصبية) ظاهرة تحدث عندما تتحد نبضتان عصبيتان أو أكثر لا تكفي إحداهما وحدها لإثارة استجابة في عصبون، لتؤدي معاً إلى إثارة جهد الفعل) / تسهيل, تيسير (حالة جعل الشيء سهلاً (أو أسهل))\nمثال: التيسير الاجتماعي هو حالة تكيفية",
 "円点": "بشكل متقطع, ستاكاتو (فصل النغمات؛ في الموسيقى) / ستاكاتو, متقطع ((موسيقى) يتميز بـ أو يتألف من أجزاء أو أصوات غير متصلة؛ مقطوعة بحدة)",
 "円熟": "نضج (حالة كونه ناضجاً (للثمار))",
 "円熟した": "برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "円熟味": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "円環": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما)",
 "円環面": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "円盤": "قُرْص / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / أُسْطُوَانَة\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "円盤状": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "円盾": "تُرْس ((تَرَّسَ): توقى بالترس)",
 "円石": "حَصَاة",
 "円窓": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "円筒": "أُسْطُوَانَة",
 "円筒形": "أُسْطُوَانِيّ (ذو شكل الأسطوانة)",
 "円背": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري)",
 "円舞": "فَالْس, رَقْصَة الْفَالْس",
 "円舞曲": "فَالْس, رَقْصَة الْفَالْس",
 "円花蜂": "طَنَّانَة, نَحْلَة",
 "円蓋": "قُبَّة",
 "円蓋状": "قُبَيْعِيّ, كُؤَيْسِيّ (على شكل قُبيعة أو كُؤيس أو يحملها)",
 "円規": "فِرْجَار, بِرْكَار",
 "円転": "فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / طَنَّان, مُنْتَفِخ (مُتعالٍ ومُتكلَّف في الأسلوب بشكل استعراضي)",
 "円転滑脱": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ) / أَنِيقٌ, وَسِيمٌ (يتمتع بسحر رفيع وأناقة) / حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "円錐": "مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير ويرتفع مستدقا حتى ينتهي إلى نُقْطةٍ أَو سطحٍ أصْغرَ من قاعِدَته)",
 "円錐体": "مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير ويرتفع مستدقا حتى ينتهي إلى نُقْطةٍ أَو سطحٍ أصْغرَ من قاعِدَته)",
 "円錐台": "مخروط ناقص (جذع مُشكل من مخروط)",
 "円錐図法": "إسقاط مخروطي (إسقاط خرائطي للكرة الأرضية على مخروط تقع رأسه فوق أحد قطبي الأرض)",
 "円錐形": "شكل مخروطي, مخروط (شكل قاعدته دائرة وتستدق جوانبه لتصل إلى نقطة)",
 "円錐曲線": "قطاع مخروطي ((هندسة) منحنى ناتج عن تقاطع مستوى مع مخروط دائري)",
 "円錐角膜": "القرنية المخروطية (بروز مخروطي غير طبيعي لقرنية العين؛ يمكن علاجه برأب القرنية الفوقي)",
 "円鑿": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "円関数": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "円陣": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما)",
 "円頂": "قُبَّة",
 "円顱": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "円館": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "冊": "حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟",
 "冊子": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "冊子体": "مورفيم مقيد",
 "冊立": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات)) / مرفق, منشأة (مبنى أو مكان يوفر خدمة معينة أو يستخدم لصناعة معينة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "再": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "再々": "كَثِيرًا, غَالِبًا",
 "再び": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "再び導入": "إعادة تقديم (فعل تجديد التقديم)",
 "再エネ": "الطاقة الخضراء",
 "再ブレイク": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "再三": "مِرَارًا وَتِكْرَارًا",
 "再三再四": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "再上映": "إعادة عرض, حلقة مُعادة (برنامج يتم بثه مرة أخرى)\nمثال: تحب مشاهدة الإعادة لمسلسل 'أنا أحب لوسي'",
 "再下付": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "再交付": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "再会": "لَم شَمْل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "再体験": "استعادة التجربة, معايشة مجددة (تكرار لتجربة سابقة (شعورياً))\nمثال: استعادة العاطفة القوية يمكن أن يكون علاجياً",
 "再使用型": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "再保険": "إِعَادَةُ تَأْمِين",
 "再入": "دخول مجدد (فعل الدخول مرة أخرى)",
 "再入可能": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "再再": "كَثِيرًا, غَالِبًا",
 "再出": "عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى) / ظهور مجدد, عودة ظهور (حدث ظهور شيء ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة",
 "再出発": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "再分配": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "再刊": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "再判定": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي أصدرت المحكمة حكماً أو قراراً بشأنها من قبل نفس المحكمة؛ يحدث عندما يتبين…)",
 "再利用": "إِعَادَةْ تَدْوِير",
 "再利用可能": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "再割当": "إعادة تعيين, إعادة تكليف (التعيين في واجب مختلف)",
 "再創造": "اِسْتِجْمَام",
 "再吟味": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / تفتيش, معاينة (فحص رسمي أو حكومي) / تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة) / مراجعة ((قانون) إعادة فحص قضائي لإجراءات محكمة (خاصة من قبل محكمة استئناف))\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "再命名": "تسمية استدراكية, مصطلح رجعي (كلمة تم تقديمها لأن المصطلح الحالي أصبح غير كافٍ)\nمثال: لم يسمع أحد عن 'الساعات التناظرية' حتى أصبحت الساعات الرقمية شائعة، لذا فإن 'ساعة تناظرية' هي مصطلح رجعي / أنابابتيست, تجديد العماد (حركة بروتستانتية في القرن السادس عشر آمنت بأولوية الكتاب المقدس، وعمدت المؤمنين فقط وليس الأطفال، وآمنت بالفصل التام بين الكنيسة والدولة)",
 "再商品化": "إِعَادَةْ تَدْوِير",
 "再始動": "اِسْتَأْنَفَ",
 "再婚": "إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى)",
 "再嫁": "إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى)",
 "再定義": "إعادة تعريف (فعل إعطاء تعريف جديد)\nمثال: الكلمات مثل 'محافظ' تتطلب إعادة تعريف دورية",
 "再審": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي أصدرت المحكمة حكماً أو قراراً بشأنها من قبل نفس المحكمة؛ يحدث عندما يتبين…) / فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / تفتيش, معاينة (فحص رسمي أو حكومي) / تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة) / مراجعة ((قانون) إعادة فحص قضائي لإجراءات محكمة (خاصة من قبل محكمة استئناف))\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "再審裁判": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي أصدرت المحكمة حكماً أو قراراً بشأنها من قبل نفس المحكمة؛ يحدث عندما يتبين…)",
 "再導入": "إعادة تقديم (فعل تجديد التقديم)",
 "再工事": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى) / إعادة بناء, ذاكرة بنائية (الاستدعاء الذي يُفترض أنه يعمل عن طريق تخزين سمات مجردة تُستخدم بعد ذلك لبناء الذاكرة أثناء الاستدعاء) / إعادة بناء (تفسير يتكون من تجميع أجزاء من الأدلة معاً)",
 "再帰": "تكرار, عودة (الحدوث مرة أخرى (خاصة على فترات منتظمة))\nمثال: عودة الربيع / عَوْدِيَّة / انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "再帰代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "再帰動詞": "فعل مطاوع, فعل منعكس (فعل يقوم فيه الفاعل بعمل موجه نحو نفسه)\nمثال: جملة 'اغتسل' تحتوي على فعل منعكس",
 "再帰性": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "再帰熱": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز بنوبات من الحمى العالية والقشعريرة والصداع وآلام العضلات والغثيان التي…)",
 "再帰用法": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه) / اِنْعِكَاسِيّ, تِلْقَائِيّ (بِدُونِ إِرَادَةٍ أَوْ تَحَكُّمٍ وَاعٍ) / ضمير انعكاسي (ضمير شخصي يدل على أن فعل الفاعل يؤثر على الفاعل نفسه)",
 "再帰的": "عَوْدِيّ / اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه) / اِنْعِكَاسِيّ, تِلْقَائِيّ (بِدُونِ إِرَادَةٍ أَوْ تَحَكُّمٍ وَاعٍ) / ضمير انعكاسي (ضمير شخصي يدل على أن فعل الفاعل يؤثر على الفاعل نفسه)",
 "再帰的定義": "تعريف تكراري ((رياضيات) تعريف لدالة يمكن من خلاله حساب قيم الدالة في عدد محدود من الخطوات)",
 "再度": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "再度確認": "تحقق إضافي, فحص مزدوج (شيء يتحقق من صحة فحص سابق)",
 "再建": "إعادة بناء (البناء مرة أخرى)",
 "再建外科": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "再建手術": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "再建築": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى) / إعادة بناء, ذاكرة بنائية (الاستدعاء الذي يُفترض أنه يعمل عن طريق تخزين سمات مجردة تُستخدم بعد ذلك لبناء الذاكرة أثناء الاستدعاء) / إعادة بناء (تفسير يتكون من تجميع أجزاء من الأدلة معاً)",
 "再従兄弟": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "再従姉妹": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "再循環": "إِعَادَةْ تَدْوِير",
 "再思": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً) / إعادة نظر (النظر في موضوع (كما في اجتماع) بهدف تغيير قرار سابق)\nمثال: أعاد النظر في مشترياته",
 "再戦": "إعادة اللعب, مباراة عودة (شيء (خاصة لعبة) يتم لعبه مرة أخرى)"
}
