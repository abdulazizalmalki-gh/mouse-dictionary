 "北方領土": "مُقَاطَعَة شَمَالِيَّة",
 "北朝鮮": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "北東": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "北東部": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "北栗鼠": "سنجاب أحمر (سنجاب بني محمر شائع في أوروبا وأجزاء من آسيا) / سنجاب أحمر أمريكي (من شمال الولايات المتحدة وكندا)",
 "北極": "اَلْقُطْب اَلشَّمَالِيّ\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي. / قُطْبِيّ شَمَالِيّ",
 "北極光": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "北極圏": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي.",
 "北極地方": "قُطْبِيّ شَمَالِيّ",
 "北極岩魚": "شار قطبي (ترويت صغير في المياه الشمالية؛ توجد مجموعات حبيسة في كيبيك وشمال نيو إنجلاند)",
 "北極星": "الجُدَيّ, نَجْم الشَمَال",
 "北極洋": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "北極海": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "北極点": "اَلْقُطْب اَلشَّمَالِيّ",
 "北極熊": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "北極狐": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "北極狼": "ذئب أبيض, ذئب قطبي (ذئب من القطب الشمالي لأمريكا الشمالية ذو فرو أبيض وذيل أسود الطرف)",
 "北極線": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة",
 "北極野兎": "أرنب قطبي (أرنب بري كبير من شمال أمريكا الشمالية؛ يكون أبيض بالكامل تقريباً في الشتاء)",
 "北極鯨": "حوت مقوس الرأس (حوت قطبي كبير الفم)",
 "北欧": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "北欧人": "إسكندنافي, نورسي (من أو يتعلق بإسكندنافيا أو شعوبها أو ثقافاتها) / الجرمانية الشمالية, اللغات الإسكندنافية (العائلة الشمالية من اللغات الجرمانية التي يتم التحدث بها في الدول الإسكندنافية وأيسلندا) / إسكندنافي (أحد سكان إسكندنافيا)\nمثال: الملاحم النورسية",
 "北欧神話": "الأساطير الإسكندنافية (أساطير الدول الإسكندنافية (التي تشترك فيها جزئيًا بريطانيا وألمانيا) حتى تغلغل المسيحية)",
 "北欧諸国": "دولة إسكندنافية (أي دولة من الدول التي تشغل إسكندنافيا)",
 "北氷洋": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "北海": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / هُوكَايْدُو, هُكَّايْدُو",
 "北海道": "هُوكَايْدُو, هُكَّايْدُو",
 "北海道犬": "هُوكَايْدُو, هُكَّايْدُو",
 "北米": "أَمْرِيكَا الشَّمَالِيَّة",
 "北米合衆国": "الْوِلَايَات الْمُتَّحِدَة الْأَمْرِيكِيَّة, الْوِلَايَات الْمُتَّحِدَة",
 "北米土人": "اللغة الأمرندية, لغة السكان الأصليين للأمريكيتين (أي من اللغات التي يتحدث بها السكان الأصليون للأمريكيتين (الهنود الحمر))",
 "北西": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "北西部": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "北赤道海流": "التيار الاستوائي الشمالي (تيار استوائي يتدفق غرباً عبر المحيط الهادئ شمال خط الاستواء مباشرة)",
 "北部": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "北部同盟": "التحالف الشمالي, الجبهة المتحدة (تحالف متعدد الأعراق في أفغانستان يمارسون شكلاً معتدلاً من الإسلام ومتحدون في معارضتهم لطالبان)",
 "北部地域": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "北都": "كِيُوتُو",
 "北面": "الجانب الشمالي (الجانب الذي يقع في الشمال)",
 "北韓": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "北風": "رياح شمالية (رياح تهب من الشمال)",
 "北鮮": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "匙": "مِلْعَقَة, معلقة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "匙を投げる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "匙加減": "جُرْعَة / مَهَارَة",
 "匠": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "匠人": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "匠気": "تَصَنُّع, تَكَلُّف",
 "匡救": "إغاثة, غوث (المساعدة في وقت الشدة أو الصعوبة)\nمثال: قدمت التبرعات بعض الإغاثة للضحايا",
 "匡正": "تَصْحِيح",
 "匪徒": "قَاطِع طَرِيق",
 "匪石之心": "ثبات, صمود (عزم راسخ) / ثَبَات, رَبَاطَة جَأْش (الولاء في مواجهة المتاعب والصعوبات)",
 "匪賊": "قَاطِع طَرِيق",
 "匪躬": "إِيثَارِيّ, مُضَحٍّ بِنَفْسِه (مستعدّ لحرمان نفسه من أجل الآخرين)",
 "匹偶": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "匹儔": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل",
 "匹夫": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "匹敵": "مُنَافِس",
 "匹耦": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "区": "جَنَاح / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "区々": "مُخْتَلِف, مُتَنَوَّع / تَافِه",
 "区処": "تَقْسِيم",
 "区分": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب. / تَصْنِيف",
 "区分け": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "区分建物": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة بشكل فردي) / شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)",
 "区分所有建物": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة بشكل فردي) / شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)",
 "区切り": "تَوَقَّفَ / تَوَقُّف, وَقْف / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "区切り記号": "جهاز طرد مركزي, فراز (جهاز يستخدم قوة الطرد المركزي لفصل الجزيئات عن المعلق)",
 "区切る": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "区別": "تَمْيِيْز",
 "区別立て": "تفاضل (العملية الرياضية للحصول على مشتق دالة) / اختلاف, تمايز (التمييز بين الأشياء على أنها مختلفة ومتميزة بناءً على خصائصها أو سماتها) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "区割り": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي) / تخم, حد (حدود منطقة معينة)\nمثال: هناك خط رفيع بين العقل والجنون",
 "区区": "مُخْتَلِف, مُتَنَوَّع / تَافِه",
 "区域": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "区外": "خَارِج, بره",
 "区市町村": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "区役所": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "区画": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "区画図": "خريطة مساحية, مخطط أرض (خريطة تظهر الميزات المخططة أو الفعلية لمنطقة (شوارع وقطع أراضي بناء وما إلى ذلك))",
 "区画整理": "تخطيط حضري, تخطيط مدن (تحديد ووضع خطط للترتيب المادي المستقبلي وحالة المجتمع السكني)",
 "区立": "جَنَاح",
 "区間": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة",
 "医": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "医する": "شِفَاء / شَفَى",
 "医事": "ممارسة الطب (مزاولة مهنة الطب)",
 "医務官": "ضابط طبي (ممارس طبي في القوات المسلحة)",
