 "取引先": "زَبُون, عَمِيل",
 "取引制限": "تقييد التجارة (أي فعل يميل إلى منع المنافسة الحرة في الأعمال التجارية)",
 "取引所": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "取引日": "يَوْم تَدَاوُل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "取引材料": "وَرَقَة تَفَاوُض, وَرَقَة مُسَاوَمَة (نفوذ في شكل إغراء أو تنازل مفيد في المفاوضات الناجحة)",
 "取引業者": "سِمْسَار, وَسِيط",
 "取引者": "القائم بالمعاملة, مفاوض (شخص يدير أو يقوم بأعمال تجارية أو مفاوضات)",
 "取引高": "انقلاب, قلب (عملية قلب شيء ما) / إجمالي العائدات, حجم التداول (الحجم المقاس بالدولار) / تيرن أوفر, فطيرة مطوية (طبق يُصنع بطي قطعة من العجين فوق الحشوة) / دَوَرَان المُوَظَّفِين, مُعَدَّل الدَّوَرَان (نسبة عدد العمال الذين تم استبدالهم في فترة زمنية معينة إلى متوسط عدد العمال)\nمثال: أصيب برضوض شديدة بسبب انقلاب زلاجته بسرعة عالية",
 "取得": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه)\nمثال: متى حصل الحادث؟",
 "取得者": "بنك تجاري, بنك مكتسب (بنك يعالج بطاقات الائتمان؛ حيث يتلقى التجار ائتمانًا لإيصالات بطاقات الائتمان مخصومًا منها رسوم المعالجة) / بنك مكتسب, جهة مكتسبة (المؤسسة المالية التي تصرف النقود في أجهزة الصراف الآلي وتحصل رسوماً من البنك الذي أصدر بطاقة الائتمان) / شركة مستحوذة, مستحوذ (شركة تحصل على سيطرة مالية على شركة أخرى أو مؤسسة مالية من خلال الدفع نقداً أو تبادل الأسهم) / مقتنٍ, مكتسب (شخص يكتسب شيئاً (عادة بشكل دائم))",
 "取急ぐ": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "取所": "جَدَارَة",
 "取手": "مِقْبَض / مُسْتَلِم, مُسْتَلِمَة",
 "取払い": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取扱": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "取扱い": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "取扱い店": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取扱い店舗": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取扱い所": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取扱人": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "取扱店": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取扱店舗": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取扱所": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取扱者": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "取扱説明書": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "取拉ぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "取持ち": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / تَرْفِيه, تَسْلِيَة",
 "取捌く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "取捨": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "取捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "取捨選択": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "取替": "مُبَادَلَة",
 "取替えっこ": "مُبَادَلَة",
 "取木": "طَبَقَة",
 "取材": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "取材源": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "取材現場": "مَنْظَر, مَشْهَد / مَشْهَد",
 "取材相手": "المستجوَب, ضيف المقابلة (شخص تُجرى معه مقابلة)",
 "取材者": "مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "取材記者": "فَيْج",
 "取材陣": "فيلق صحفي, مجموعة صحفية (مجموعة من الصحفيين يمثلون منشورات مختلفة يغطون جميعاً نفس المواضيع)\nمثال: الفيلق الصحفي للبيت الأبيض",
 "取柄": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة",
 "取極める": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "取次": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَادّ, مُجِيب (يقوم بالرد أو الإجابة) / وَسِيلَةُ النَّقْل",
 "取次ぎ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَادّ, مُجِيب (يقوم بالرد أو الإجابة) / وَسِيلَةُ النَّقْل",
 "取次ぐ": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي. / بَلَّغَ, أَبْلَغَ / مِقْبَض",
 "取次店": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取止め": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "取水口": "خَوْخَة",
 "取決め": "قَرَار, تَصْمِيم",
 "取決める": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "取沙汰": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "取消": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "取消し": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "取消す": "أَلْغَى, أَبْطَلَ",
 "取混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "取留め": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "取留める": "تَيَقَّنَ, تَثَبَّتَ",
 "取直し": "إعادة اللعب, مباراة عودة (شيء (خاصة لعبة) يتم لعبه مرة أخرى)",
 "取立て": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / طَازَج, طَازَة / عَذْب",
 "取立てる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / شَدَّدَ (الشيءَ: قَوَّاه وجعله شديدًا؛ في الأمر: بالغ فيه)",
 "取組": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / جولة قتال, نزال (مسابقة أو قتال (خاصة بين الملاكمين أو المصارعين)) / نوبة مرضية, وعكة (فترة من المرض) / جولة, دور ((رياضة) قسم من اللعبة يكون خلاله فريق واحد في وضع الهجوم)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام",
 "取組み": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / جولة قتال, نزال (مسابقة أو قتال (خاصة بين الملاكمين أو المصارعين)) / نوبة مرضية, وعكة (فترة من المرض) / جولة, دور ((رياضة) قسم من اللعبة يكون خلاله فريق واحد في وضع الهجوم)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام",
 "取組む": "عَالَجَ",
 "取結ぶ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "取締": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "取締まる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / ضَبَطَ",
 "取締り": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "取締る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / ضَبَطَ",
 "取締役": "عُضْو مَجْلِس إِدارَة (عضو في مجلس حاكم أو إدارة)",
 "取締役会": "مَجْلِس إِدَارَة",
 "取締役社長": "مدير (شخص يتحكم في الموارد والنفقات)",
 "取繕う": "أَصْلَحَ",
 "取纏める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "取置": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "取舵": "مِينَاء, مينا / مَنْفَذ / كَيَّفَ, غَيَّرَ",
 "取落とす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "取計らう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "取説": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "取調": "تَحْقِيق",
 "取調べ": "تَحْقِيق",
 "取調べる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "取調べ官": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "取調官": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "取調室": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود) / زنزانة ضيقة (زنزانة صغيرة أو ضيقة)",
 "取込み詐欺": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "取込詐欺": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "取返し": "شِفَاء, تَعَافِي",
 "取返す": "شُفِيَ, بَرِئَ",
 "取違え": "التباس, خلط (خطأ ناتج عن اعتبار شيء مكان شيء آخر)\nمثال: غير اسمه لتجنب الخلط مع الخارج عن القانون سيئ السمعة / سُوء فَهْم",
 "取鎮める": "صَامِت, هَادِئ",
 "取集": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "取集め": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "取集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "取離す": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "受かる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "受く": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受け": "شَعْبِيَّة / دِفَاع, حِمَايَة / دِفاع / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "受けがいい": "مَحْبُوب",
 "受けがよい": "مَحْبُوب",
 "受けが悪い": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "受けが良い": "مَحْبُوب",
 "受けつぐ": "وَرَثَ",
 "受けつける": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / دُبّ / دُبَّة / اِحْتَمَلَ",
 "受けとめる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "受けのいい": "مَحْبُوب",
 "受けのよい": "مَحْبُوب",
 "受けの良い": "مَحْبُوب",
 "受けやすい": "مُعَرَّض\nمثال: 日本は非常に地震の害を受けやすい。 — اليابان معرضة للزلازل بشدة.",
 "受ける": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَبْقَى / عَالَ, يَعُولُ (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "受け人": "كَافِل",
 "受け付け": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال / إِيصَال",
 "受け付ける": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / دُبّ / دُبَّة / اِحْتَمَلَ",
 "受け付け係": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "受け入れ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受け入れる": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "受け入れ先": "مُسْتَلِم, مُسْتَلِمَة",
 "受け取り": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受け取り通知": "آر",
 "受け取る": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "受け口": "مَقْبِس",
 "受け合い": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات) / تأكيد, طمأنة (بيان يهدف إلى إلهام الثقة) / تَعَهُّد, ضَمَان (التزام ملزم بالقيام بشيء أو إعطائه أو الامتناع عنه) / تأمين (بريطاني) (مصطلح بريطاني لبعض أنواع التأمين)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "受け合う": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "受け売り": "تجارة التجزئة (الأنشطة المتعلقة ببيع السلع مباشرة للمستهلكين) / إعادة, تكرار (فعل القيام بالشيء أو أدائه مرة أخرى)",
 "受け壺": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / راعٍ, مَسْؤُول (شخص مسؤول عن رعاية أشخاص آخرين)\nمثال: هل أنا حارس لأخي؟",
 "受け戻し": "فِدَاء / خَلَاص",
 "受け戻す": "فِدْيَة / اِفْتَدَى, فَدَى",
 "受け手": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "受け持ち": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "受け易い": "مُعَرَّض\nمثال: 日本は非常に地震の害を受けやすい。 — اليابان معرضة للزلازل بشدة.",
 "受け木": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "受け止める": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "受け流す": "يَدْرَأ",
 "受け渡し": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "受け渡す": "نَقَلَ",
 "受け皿": "صُحَيْفَة, طَبَق فِنْجَان / حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "受け皿となる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受け答え": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "受け継ぐ": "وَرَثَ",
 "受け身": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه) / تَبْرِيرِيّ, دِفَاعِيّ (يسعى إلى التبرير أو الدفاع قولاً أو كتابةً) / موقف دفاعي (موقف يتسم بالدفاع عن النفس)\nمثال: أسلحة دفاعية / سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية) / مَبْنِيٌّ لِلْمَجْهُول",
 "受け身形": "صِيغَة مَجْهُول / مَبْنِي مَجْهُول",
 "受付": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال / إِيصَال",
 "受付ける": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / دُبّ / دُبَّة / اِحْتَمَلَ",
 "受付係": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "受付嬢": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "受信": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受信人": "مُسْتَلِم, مُسْتَلِمَة",
 "受信側": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "受信側エンティティ": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "受信器": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "受信専用": "رو (لغة مصطنعة للاستخدام الدولي ترفض جميع الكلمات الموجودة وتعتمد بدلاً من ذلك على تحليل مجرد للأفكار)",
 "受信料": "رسم الترخيص (رسم يُدفع للحكومة مقابل امتياز الترخيص للقيام بشيء ما (مثل بيع الخمور أو ممارسة الطب))",
 "受信機": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "受信相手": "مُسْتَلِم, مُسْتَلِمَة",
 "受信箱": "صُنْدُوق الوَارِد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / صُنْدُوق الوَارِد, عُلْبَة الوَارِد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "受信者": "مُسْتَلِم, مُسْتَلِمَة",
 "受信装置": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "受信通知": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "受信音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "受像": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "受像機": "تلفاز, جهاز تلفزيون (جهاز إلكتروني يستقبل إشارات التلفزيون ويعرضها على شاشة)\nمثال: この工場ではテレビ受像機を製造しています。 — هم يصنعون التلافز في هذا المصنع.",
 "受入": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受入れ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "受刑": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "受刑者": "سَجِين, سَجِينَة",
 "受動": "سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية)",
 "受動免疫": "مناعة سلبية (شكل غير دائم من المناعة المكتسبة يتم فيه اكتساب الأجسام المضادة للمرض بشكل طبيعي (كما عبر المشيمة للجنين) أو اصطناعياً (كحقن المصل))",
 "受動喫煙": "تَدْخِين سَلْبِيّ",
 "受動性": "سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية)",
 "受動態": "صِيغَة مَجْهُول / مَبْنِي مَجْهُول",
