 "史的唯物論": "مادية تاريخية",
 "史的現在": "المضارع التاريخي (استخدام صيغة المضارع لوصف أحداث أو حالات في الماضي)",
 "史籍": "حَوْلِيَّات",
 "右": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / يَمِين, يُمْنَى / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "右に出る": "فَاقَ, تَجَاوَزَ",
 "右に同じ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "右へならえ": "تَقْلِيد",
 "右へ倣え": "تَقْلِيد",
 "右バッター": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "右上がり": "زراعي, نمو (متعلق أو مناسب للنمو) / تنمية البلورات ((إلكترونيات) إنتاج بلورات (شبه موصلة) عن طريق التبلور البطيء من الحالة المنصهرة) / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: موسم زراعة الذرة",
 "右上り": "زراعي, نمو (متعلق أو مناسب للنمو) / تنمية البلورات ((إلكترونيات) إنتاج بلورات (شبه موصلة) عن طريق التبلور البطيء من الحالة المنصهرة) / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: موسم زراعة الذرة",
 "右上手": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "右下がり": "متناقص (يصبح أقل أو أصغر) / متخافت (موسيقى) ((موسيقى) يتناقص في السرعة و/أو الحجم)",
 "右側": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "右党": "يَمِينِيّ",
 "右利き": "أيمنية, تيامن (تفضيل استخدام اليد اليمنى)",
 "右回り": "دوران باتجاه عقارب الساعة, دوران يميني (دوران إلى اليمين)",
 "右奥": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "右室": "بطين أيمن (الحجرة على الجانب الأيمن من القلب التي تتلقى الدم الوريدي من الأذين الأيمن وتضخه في الجذع الرئوي)",
 "右巻": "بِإِتِّجَاه عَقَارِب السَّاعَة",
 "右巻き": "بِإِتِّجَاه عَقَارِب السَّاعَة",
 "右心室": "بطين أيمن (الحجرة على الجانب الأيمن من القلب التي تتلقى الدم الوريدي من الأذين الأيمن وتضخه في الجذع الرئوي)",
 "右心房": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "右房": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "右手": "يَمِين, يُمْنَى / يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "右手の法則": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "右手座標系": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "右打者": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "右旋性": "يَمِينِيّ الدَّوَرَان (يدور باتّجاه عقارب الساعة؛ يُقال عن المواد التي تحرف مستوى الضوء المستقطَب يميناً)",
 "右旋糖": "ديكستروز, سكر العنب (متصاوغ للجلوكوز يوجد في العسل والفواكه الحلوة)",
 "右派": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين يعتقدون أن الأمور أفضل إذا تركت دون تغيير)",
 "右筆": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "右翼": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين يعتقدون أن الأمور أفضل إذا تركت دون تغيير) / الحقل الأيمن (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأيمن من الملعب الخارجي) / يمين الملعب (قطعة الأرض في المنطقة الخارجية على يمين الماسك)",
 "右翼団体": "يَمِينِيّ",
 "右翼手": "لاعب الدفاع الأيمن (الشخص الذي يلعب في الجانب الأيمن من الملعب الخارجي)",
 "右翼運動": "يَمِينِيّ",
 "右肩上がり": "زراعي, نمو (متعلق أو مناسب للنمو) / تنمية البلورات ((إلكترونيات) إنتاج بلورات (شبه موصلة) عن طريق التبلور البطيء من الحالة المنصهرة) / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: موسم زراعة الذرة",
 "右肩下がり": "متناقص (يصبح أقل أو أصغر) / متخافت (موسيقى) ((موسيقى) يتناقص في السرعة و/أو الحجم)",
 "右胃動脈": "شريان معدي أيمن (فرع من الشريان الكبدي يغذي الجزء البوابي من المعدة عند الانحناء الصغير)",
 "右胸心": "القلب اليميني (حالة غير طبيعية يقع فيها القلب باتجاه الجانب الأيمن من الصدر)",
 "右脳": "الدماغ الأيمن, نصف الكرة الأيمن (نصف الكرة المخية إلى يمين الجسم الثفني الذي يتحكم في النصف الأيسر من الجسم)",
 "右腕": "مساعد أيمن (المساعد الذكر الأكثر فائدة) / رامٍ أيمن ((في البيسبول) رامٍ يرمي الكرة باليد اليمنى)",
 "右舷": "يَمِينِيُّ السَّفِينَة (واقع على الجانب الأيمن من السفينة أو الطائرة) / الجانب الأيمن, الميمنة (الجانب الأيمن لسفينة أو طائرة لشخص على متنها ويواجه المقدمة أو الأنف)",
 "右記": "سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "右辺": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية) / روديوم (عنصر فلزي صلب أبيض من مجموعة البلاتين ويوجد في خامات البلاتين) / العامل الرايزيسي, عامل ريزوس (مستضد فصيلة الدم يمتلكه الأشخاص إيجابيو العامل الرايزيسي)",
 "右顧左眄": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "叶える": "مَنَحَ / مِنْحة",
 "叶わぬ": "مُسْتَحِيل",
 "号": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف / مَقَاس, قِيَاس",
 "号する": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "号令": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "号令一下": "مَنْقُول, مُتَوَارَث (اِنْتَقَلَ مِنْ جِيلٍ إِلَى جِيل)",
 "号哭": "صراخ, عويل (صرخات عالية أثناء البكاء) / عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير)",
 "号泣": "صراخ, عويل (صرخات عالية أثناء البكاء) / بُكَاء",
 "号碼": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "号笛": "سِيرَانَة / صَفّارَة",
 "号音": "إِشَارَة",
 "司": "مَهَمَّة / شَيْخ, قَائِد",
 "司る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "司令": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "司令塔": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / قَائِد, زَعِيم / صانع ألعاب (لاعب في رياضة جماعية يقود الهجمات أو المناورات بطريقة تمكن زميله من التسجيل)",
 "司令官": "ضابط قائد, قائد (ضابط يتولى قيادة وحدة عسكرية)",
 "司令室": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "司令船": "وحدة القيادة (وحدة فضائية يمكن لرواد الفضاء العيش فيها والتحكم في المركبة الفضائية والتواصل مع الأرض)",
 "司令部": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "司令長官": "رَئِيس أَرْكَان",
 "司会": "رئاسة (منصب الرئيس (لمجلس أو هيئة)) / رَئِيس",
 "司会役": "مُشْرِف",
 "司会者": "رَئِيس",
 "司厨士": "طَاهٍ, طَاهِي",
 "司式": "تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً",
 "司式者": "القائم بالطقوس, المحتفل (رجل دين يدير احتفالاً دينياً أو خدمة دينية)",
 "司教": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "司教区": "أَبْرَشِيَّة",
 "司教座教会": "كَاتِدْرَائِيَّة",
 "司教座聖堂": "كَاتِدْرَائِيَّة",
 "司書": "أَمِين مَكْتَبَة, أَمِينَةْ مَكْتَبَة (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "司法": "قضاء, منصب القاضي (منصب القاضي) / إقامة العدل, قضاء (فعل تطبيق العدالة وفقاً للقانون) / سلطة قضائية, قضاء (نظام المحاكم القانونية التي تدير العدالة وتشكل الفرع القضائي للحكومة) / محكمة, هيئة قضائية (جمعية (تضم قاضياً واحداً أو أكثر) لإجراء الأعمال القضائية)",
 "司法の場": "قَاعَةُ مَحْكَمَة, قَاعَةُ الْمَحْكَمَة",
 "司法判断": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "司法取引": "صفقة الإقرار بالذنب, مساومة قضائية ((القانون الجنائي) تفاوض يوافق فيه المدعى عليه على الاعتراف بالذنب في تهمة أقل وتوافق النيابة على إسقاط تهمة أكثر خطورة)\nمثال: اعترافه كان جزءاً من صفقة إقرار بالذنب مع المدعي العام",
 "司法妨害": "إعاقة العدالة, عرقلة سير العدالة (إعاقة أولئك الذين يسعون لتحقيق العدالة في المحكمة (مثل محاولة التأثير على المحلفين أو الشهود))",
 "司法審査": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى معينة قانونياً أو مراجعة محكمة استئناف لقرار محكمة ابتدائية)",
 "司法権": "قَضَاء / اِخْتِصَاص",
 "司法機関": "السلطة القضائية (فرع حكومة الولايات المتحدة المسؤول عن إدارة العدالة)",
 "司法省": "وزارة العدل (الإدارة الفيدرالية الأمريكية المسؤولة عن إنفاذ القوانين الفيدرالية (بما في ذلك إنفاذ جميع تشريعات الحقوق المدنية)؛ أنشئت عام 1870)",
 "司法解剖": "بِأَمْرِ المَحْكَمَة (صادِر بِأَمْرٍ مِن مَحْكَمَة قَضائِيَّة)",
 "司法試験": "اختبار النقابة, امتحان المحاماة (امتحان يجرى على فترات منتظمة لتحديد ما إذا كان المرشح مؤهلاً لممارسة القانون في ولاية قضائية معينة)\nمثال: اجتاز امتحان النقابة في محاولته الثالثة",
 "司法長官": "نَائِب عَامّ",
 "司直": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "司祭": "كَاهِن, قِسِّيس",
 "司試": "اختبار النقابة, امتحان المحاماة (امتحان يجرى على فترات منتظمة لتحديد ما إذا كان المرشح مؤهلاً لممارسة القانون في ولاية قضائية معينة)\nمثال: اجتاز امتحان النقابة في محاولته الثالثة",
 "吃り": "تَلَجْلَجَ, تَلَعْثَمَ / متلعثم (شخص يتحدث بوقفات وتكرارات لا إرادية)",
 "吃る": "تَلَجْلَجَ, تَلَعْثَمَ",
 "吃水": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "吃水線": "خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن السفينة)",
 "吃音": "تَلَجْلَجَ, تَلَعْثَمَ",
 "吃音症": "تَأْتَأَة, تَمْتَمَة",
 "吃驚": "دَهْشَة, تَعَجُّب / بَاغَتَ / فَاجَأَ / دَهِشَ",
 "吃驚仰天": "مَذْهُول",
 "各": "كُلّ / كُلّ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "各々": "كُلّ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "各人に彼のものを": "كل شخص حرّ في ذوقه",
 "各位": "الْجَمِيع, كُلّ شَخْص",
 "各個": "كُلّ",
 "各別": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك. / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "各各": "كُلّ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "各方面": "ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر)\nمثال: الفائدة مركبة ربع سنوياً",
 "各自": "كُلّ",
 "各般": "كُلّ, جَمِيع",
 "各論": "خاص, فردي (كائن أو مميز لشيء واحد أو شخص واحد)\nمثال: قطرات فردية من المطر",
 "各週": "أسبوعياً, كل أسبوع (دون تفويت أسبوع)\nمثال: زارت عمتها أسبوعياً",
 "合": "مَعًا, سَوِيًّا / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / ـِيّ / عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية) / حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / مَجْمُوع / مَبْلَغ / تَرْكِيب (اسم للشيء الذي يُرَّكبُ بالعادة) / اِصْطِنَاع, اِصْطِنَاع كِيمِيَائِيّ",
 "合い": "مَعًا, سَوِيًّا / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / ـِيّ",
 "合いくぎ": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合いの子": "هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار / هَجِين",
 "合いの手": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / فاصل, فترة بينية (فترة أو حلقة فاصلة) / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "合いの手を入れる": "قَاطَعَ",
 "合いの手を打つ": "قَاطَعَ",
 "合いの楔": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "合い判": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "合い印": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "合い口": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة) / زفرة, طعم سمك (طعم يتكون من سمك مقطع وزيوت سمك يتم إلقاؤها في البحر لجذب الأسماك) / رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم) / خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "合い札": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "合い標": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "合い言葉": "كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "合い釘": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合い鍵": "ماستر كي, مفتاح رئيسي (مفتاح يؤمن الدخول في كل مكان)",
 "合う": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "合くぎ": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合さる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "合す": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ / ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "合する": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "合せくぎ": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合せて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار / إِضَافَةً عَلى ذٰلِكَ",
 "合せる": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合せ目": "مُشْتَرَك / مِفْصَل",
 "合せ釘": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合の子": "هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار / هَجِين",
 "合の楔": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "合わさる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "合わす": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合わせ": "ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "合わせくぎ": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合わせて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار / إِضَافَةً عَلى ذٰلِكَ",
 "合わせる": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قَارَنَ / شَبَّهَ",
 "合わせ板": "خَشَب رَقَائِقِيّ, خَشَب مُعَاكِس (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "合わせ目": "مُشْتَرَك / مِفْصَل",
 "合わせ釘": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "合コン": "خَلَّاط, خَفَّاقَة",
 "合ドラ": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات عقار محظور؛ تم تعديل القانون في عام 1986 لحظر العقاقير المصممة)",
 "合一": "تَوْحِيد",
 "合体": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي! / تَصْرِيف, تَصْرِيف فِعْل / اِقْتِرَان, تَصْرِيف فِعْل / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "合体字": "ربط, عقد (عملية ربط أو توثيق الأشياء ببعضها البعض) / رابط, موثق (شيء يستخدم للربط أو التوثيق) / خيط ربط, رباط جراحي (خيط يستخدمه الجراحون لربط وعاء دموي (لتضييق تدفق الدم)) / رباط (شريط معدني يستخدم لربط الريشة بقطعة الفم في الكلارينيت أو الساكسفون)",
 "合作": "تَعَاوُن مُشْتَرَك, عَمَل مُشْتَرَك (فعل العمل المشترك) / تَوَاطُؤ, عَمَالَة (فعل التعاون الخياني مع عدو يحتل بلدك)\nمثال: عملوا إما بشكل تعاوني أو بشكل مستقل",
 "合併": "اِنْدِمَاج",
 "合併症": "تَعْقِيد / مُضَاعَفَة",
 "合併集合": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "合切袋": "حقيبة سفر, شنطة (حاوية مستطيلة محمولة لحمل الملابس)\nمثال: حمل حقيبته الصغيرة معه إلى الطائرة",
 "合判": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "合力": "مُسَاعَدَة, إِمْدَاد / تَبَرُّع, هِبَة",
 "合印": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "合口": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة) / زفرة, طعم سمك (طعم يتكون من سمك مقطع وزيوت سمك يتم إلقاؤها في البحر لجذب الأسماك) / رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم) / خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "合同": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة)) / متحد, مشترك (مصنوع أو منضم أو متحد في واحد) / تطابق, توافق (صفة الاتفاق والملاءمة)",
 "合同コンパ": "خَلَّاط, خَفَّاقَة",
 "合同行為": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "合否": "تَسَبَّب / نَتِيجَة",
 "合唱": "كَوْرَس, كُورَس / لَازِمَة, قَرَار",
 "合唱団": "خُورُس, جَوْقَة",
 "合唱曲": "كَوْرَس, كُورَس / لَازِمَة, قَرَار",
 "合唱部": "خُورُس, جَوْقَة",
 "合唱隊": "كَوْرَس, كُورَس / لَازِمَة, قَرَار",
 "合図": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "合奏": "فِرْقَة, جَوْق / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "合奏協奏曲": "كونشرتو جروسو (تأليف باروكي للأوركسترا ومجموعة من الآلات المنفردة)",
 "合奏団": "فِرْقَة, جَوْق / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "合奏調": "دوزان الحفلات, طبقة الحفلات"
}
