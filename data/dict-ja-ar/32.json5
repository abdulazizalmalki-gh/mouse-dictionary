 "半畳": "تشويش, مقاطعة (الصياح لمقاطعة خطاب لا توافق عليه)",
 "半畳を入れる": "قَاطَعَ",
 "半畳を打つ": "قَاطَعَ",
 "半盲症": "عَمًى",
 "半直線": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "半神": "نِصْف إِلٰه",
 "半神半人": "نِصْف إِلٰه",
 "半端": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي) / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط / غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "半端じゃない": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "半端ない": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "半端物": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "半端者": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "半経験的": "شِبْهُ تَجْرِيبِيّ (يعتمد إلى حدّ ما على الملاحظة أو التجربة)",
 "半纏木": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "半股引き": "يصل للركبة (يمتد إلى الركبة) / مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "半自動小銃": "ذَاتِيّ التَّعْبِئَة, نِصْف آلِيّ ((للأسلحة النارية) قادر على التعبئة والإطلاق المتواصل آلياً) / نِصْف آلِيّ (آلي جزئياً) / مسدس نصف آلي (مسدس عبارة عن سلاح ناري نصف آلي قادر على التحميل والإطلاق بشكل مستمر)",
 "半蔀": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "半衿": "قطعة رقبة (قطعة من الملابس تلبس حول الرقبة)",
 "半袖": "كم قصير, نصف كم (كم يمتد من الكتف إلى الكوع)",
 "半装軌車": "نِصْف مُجَنْزَر (له جنازير في الخلف وعجلات في الأمام)",
 "半裸体": "شِبْه عَارٍ (مكسوّ جزئياً فقط)",
 "半規管": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض؛ معنية بالتوازن)",
 "半諧音": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "半身不随": "شلل نصفي (شلل جانب واحد من الجسم)",
 "半身像": "مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "半身浴": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "半身麻痺": "شلل نصفي (شلل جانب واحد من الجسم)",
 "半輪": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "半農": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "半透明": "شِبْه شَفَّاف (يسمح بمرور الضوء بشكل منتشر دون أن يكون شفّافاً تماماً)",
 "半透膜": "غشاء شبه منفذ (غشاء (مثل غشاء الخلية) يسمح لبعض الجزيئات بالمرور من خلاله دون غيرها)",
 "半途": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "半通夜": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "半過去": "مستمر (زمن للأفعال يُستخدم في وصف حدث مستمر)",
 "半道": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "半道海豚": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "半金属": "شِبْهُ فِلِزِّيّ (عُنْصُرٌ لَا فِلِزِّيٌّ لَهُ بَعْضُ خَصَائِصِ الفِلِزَّات)",
 "半鐘": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان) / إنذار الحريق (صيحة أو جرس للتحذير من اندلاع حريق)",
 "半長靴": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات) / بسطار",
 "半間": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "半陰影": "شِبْه ظِلّ",
 "半陰陽": "خُنْثَى / خُنْثَوِيّ",
 "半面": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز / نِصْف, نُصْف",
 "半靴": "محل, مكان (وضع معين)\nمثال: لو كنت مكاني ماذا كنت ستفعل؟",
 "半音": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "半音階": "سلم كروماتيكي, سلم لوني (سلم مكون من 12 نغمة يتضمن جميع أشباه النغمات في الأوكتاف)",
 "半順序集合": "فِئَةٌ مُرَتَّبَةٌ جُزْئِيًّا (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة) / مَجْمُوعَةٌ مُرَتَّبَةٌ جُزْئِيًّا (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "半魚人": "غرانق الماء",
 "卌": "أَرْبَعُونَ",
 "卍": "صَلِيب مَعْقُوف / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "卍字": "صَلِيب مَعْقُوف",
 "卑しい": "من أصل متواضع, وضيع النسب (من مولد أو أصول متواضعة)\nمثال: مجتمع مقلوب رأساً على عقب من الأغنياء وضيعي النسب والفقراء ذوي الدماء الزرقاء / بَذِيء / بَالٍ / طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "卑しい生まれ": "من أصل متواضع, وضيع النسب (من مولد أو أصول متواضعة)\nمثال: مجتمع مقلوب رأساً على عقب من الأغنياء وضيعي النسب والفقراء ذوي الدماء الزرقاء",
 "卑しからぬ": "مُحْتَرَم",
 "卑しみ": "اِحْتِقَار, اِزْدِرَاء",
 "卑しむ": "اِحْتَقَرَ, أَهَانَ",
 "卑しむべき": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)",
 "卑しめる": "اِحْتَقَرَ, أَهَانَ",
 "卑しん坊": "نَهِم, شَرِه / جَشِع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "卑わい": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "卑下": "إماتة الشهوات, كفارة (عقاب ذاتي طوعي للتكفير عن خطأ ما)",
 "卑人": "ريفيون, قرويون (الناس الذين نشأوا أو يعيشون في بيئة ريفية) / أبناء الوطن, مواطنون (الناس الذين يعيشون في نفس البلد) / الطبقة الدنيا, الطبقة المسحوقة (الطبقة الاجتماعية الأدنى في التسلسل الهرمي الاجتماعي)",
 "卑俗": "بَذِيء",
 "卑劣": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "卑劣漢": "تَسَلَّلَ",
 "卑小": "تَافِه",
 "卑屈": "خانع, ذليل (خاضع أو متملق في الموقف أو السلوك)\nمثال: تحدث بنبرة خانعة",
 "卑怯": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان. / ظالم, غير عادل (غير عادل؛ يتميز بالظلم أو التحيز أو الخداع)\nمثال: استخدم أساليب غير عادلة",
 "卑怯者": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "卑猥": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "卑罵語": "تَقْرِيع, سِبَاب (لغة مسيئة أو سامة تستخدم للتعبير عن اللوم أو الاستهجان أو الضغينة العميقة)",
 "卑言": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "卑語": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "卑賤": "مُتَوَاضِع الأَصْل, وَضِيع (من أصل متواضع أو مكانة دنيا) / ثَانَوِيّ, وَضِيع الرُّتْبَة (أدنى في الرتبة أو المكانة) / مُتَوَاضِع, وَضِيع (يُوصَف به العمل غير الماهر خاصّة الأعمال المنزلية) / مُتَوَاضِع, وَضِيع (منخفض أو متدنٍّ في المكانة أو الجودة)",
 "卑近": "شَائِع",
 "卑金属": "معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "卑陋": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "卒": "تَخَرُّج / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "卒す": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "卒する": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "卒アル": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "卒中": "جلطة, سكتة دماغية (فقدان مفاجئ للوعي ناتج عن تمزق أو انسداد الأوعية الدموية مما يؤدي إلى نقص الأكسجين في الدماغ)",
 "卒乳": "فطام (عملية استبدال حليب الأم بطعام آخر في النظام الغذائي للطفل أو الثدييات الصغيرة)",
 "卒伍": "الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش)) / القواعد, عامة الأعضاء (الناس الذين يشكلون الجسم الرئيسي لأي مجموعة)\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "卒倒": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "卒去": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
