 "共時性": "تَزَامُن (العلاقة التي توجد عندما تحدث الأشياء في نفس الوقت)\nمثال: ينتج الدواء تزامنًا متزايدًا لموجات الدماغ",
 "共時的": "تزامني (معني بالظواهر (خاصة اللغة) في فترة معينة دون النظر إلى السوابق التاريخية) / تواقتي, متزامن (يحدث أو يوجد في نفس الوقت أو له نفس الفترة أو المرحلة) / تَزَامُنِيّ ((للأصنوفات) يقع في نفس الحقبة الجيولوجية)\nمثال: علم اللغة التزامني",
 "共時言語学": "لسانيات تزامنية (دراسة لغة دون الرجوع إلى سياقها التاريخي)",
 "共有": "إِقْتِسَام, مُقَاسَمَة",
 "共有地": "شَائِع",
 "共有結合": "رابطة تساهمية (رابطة كيميائية تنطوي على مشاركة زوج من الإلكترونات بين الذرات في جزيء)",
 "共有財産": "ملكية مشتركة (الممتلكات والدخل المملوك بشكل مشترك للزوجين)",
 "共栓": "سدادة (انسداد يتكون من جسم مصمم لسد حفرة بإحكام) / مانع, ورقة حاكمة ((في البريدج) ورقة لعب ذات قيمة عالية تكفي لضمان الفوز بالجولة في نقش معين) / قاطع الحديث, مفحم (ملاحظة لا يوجد عليها رد مهذب في المحادثة) / فقرة مذهلة (عرض مذهل أو مثير للإعجاب لدرجة أن العرض يجب أن يتأخر حتى يهدأ الجمهور)\nمثال: إذا كان شريكي يملك ورقة بستوني حاكمة يمكنني المراهنة بـ بلا حكم",
 "共済": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "共済事業": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "共済組合": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "共点": "تَزَامُن, تَوَافُق (العمل معاً، كوكلاء أو ظروف أو أحداث) / تزامن, توافق (اتفاق النتائج أو الآراء)",
 "共犯": "تواطؤ (الذنب كشريك في جريمة أو مخالفة)",
 "共犯者": "شَرِيك فِي جَرِيمَة",
 "共犯証言": "دليل الادعاء, شاهد ملك (دليل للادعاء في الإجراءات الجنائية)",
 "共犯関係": "تواطؤ (الذنب كشريك في جريمة أو مخالفة)",
 "共生": "تَعَايُش / تَكَافُل",
 "共産": "شُيُوعِيَّة / الحزب الشيوعي (حزب سياسي يدعو بنشاط إلى شكل شيوعي للحكومة؛ في الدول الشيوعية هو الحزب السياسي الوحيد للدولة)",
 "共産主義": "شُيُوعِيَّة",
 "共産主義者": "شُيُوعِيّ, شُيُوعِيَّة",
 "共産党": "الحزب الشيوعي (حزب سياسي يدعو بنشاط إلى شكل شيوعي للحكومة؛ في الدول الشيوعية هو الحزب السياسي الوحيد للدولة)",
 "共産党宣言": "الحزب الشيوعي (حزب سياسي يدعو بنشاط إلى شكل شيوعي للحكومة؛ في الدول الشيوعية هو الحزب السياسي الوحيد للدولة)",
 "共産党政治局": "مَكْتَب سِيَاسِيّ (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "共産圏": "سِتَار حَدِيدِيّ, السِتَار الحَدِيدِي / السِتَار الحَدِيدِي, سِتَار حَدِيدِيّ",
 "共用": "إِقْتِسَام, مُقَاسَمَة",
 "共用プログラム": "أداة مساعدة, برنامج خدمي ((علم الحاسوب) برنامج مصمم للدعم العام لعمليات الحاسوب)\nمثال: يوفر نظام الحاسوب برامج خدمية لأداء المهام التي يحتاجها معظم المستخدمين",
 "共用ルーチン": "روتين خدمي (روتين يمكن استخدامه حسب الحاجة)",
 "共用体": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي!",
 "共立": "مُشْتَرَك / مِفْصَل",
 "共聴": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / مِلَّة\nمثال: سامي خطر للمجتمع.",
 "共著": "تَعَاوُن مُشْتَرَك, عَمَل مُشْتَرَك (فعل العمل المشترك) / تَوَاطُؤ, عَمَالَة (فعل التعاون الخياني مع عدو يحتل بلدك)\nمثال: عملوا إما بشكل تعاوني أو بشكل مستقل",
 "共著者": "شَرِيك, مُتَعاوِن (شريك في نشاط أو مسعى أو مجال ذي اهتمام مشترك) / متعاون مع العدو (شخص يتعاون مع قوة احتلال معادية) / متآمر, متواطئ (شخص يساعد في مؤامرة)\nمثال: كان الموسيقي وكاتب الليبريتو متعاونين",
 "共融": "خليط أصهري, يوتكتيك (خليط من المواد له الحد الأدنى من نقطة الانصهار)",
 "共観福音書": "الأناجيل الإزائية, الأناجيل المتناظرة (الأناجيل الثلاثة الأولى التي تصف أحداث حياة المسيح من وجهة نظر متشابهة)",
 "共謀": "دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "共謀罪": "دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "共謀者": "متآمر (عضو في مؤامرة)",
 "共起": "تزامن, تصادف (الخاصية الزمنية لحدوث شيئين في نفس الوقت) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "共通": "شَائِع",
 "共通化": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار)) / تطبيع, تقييس (فرض المعايير أو اللوائح) / تقييس, توحيد قياسي (الحالة التي يتم فيها إنشاء معيار بنجاح)\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "共通因数": "عَامِل مُشْتَرَك, قَاسِم مُشْتَرَك (عدد صحيح يقسم عددين (أو أكثر) آخرين بالتساوي)",
 "共通性": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / مِلَّة\nمثال: سامي خطر للمجتمع.",
 "共通感覚": "اَلْحِسّ السَّلِيم",
 "共通言語": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "共通認識": "اَلْحِسّ السَّلِيم",
 "共通語": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة. / معيرة لغة",
 "共通部分": "مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "共通集合": "مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "共通項": "قاسم مشترك (سمة مشتركة بين جميع أعضاء فئة ما) / مَقَام مُشْتَرَك (عدد صحيح هو مضاعف مشترك لمقامات كسرين أو أكثر)",
 "共重合体": "بوليمر مشترك (بوليمر يتكون من اثنين أو أكثر من المونومرات المختلفة)",
 "共食い": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "共鳴": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام المنطوقة) / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / رنين (اهتزاز ذو سعة كبيرة ينتج عن اهتزاز صغير نسبياً بالقرب من نفس تردد الاهتزاز مثل التردد الطبيعي للنظام الرنان) / رنين (حالة مثارة لجسيم مستقر تسبب حداً أقصى حاداً في احتمالية امتصاص الإشعاع الكهرومغناطيسي) / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "共鳴り": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام المنطوقة) / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / رنين (اهتزاز ذو سعة كبيرة ينتج عن اهتزاز صغير نسبياً بالقرب من نفس تردد الاهتزاز مثل التردد الطبيعي للنظام الرنان) / رنين (حالة مثارة لجسيم مستقر تسبب حداً أقصى حاداً في احتمالية امتصاص الإشعاع الكهرومغناطيسي) / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "共鳴器": "رنان, مرنان (أي نظام يحدث له رنين) / دائرة رنين, رنان (دائرة كهربائية تجمع بين السعة والمحاثة بطريقة تجعل التذبذب الكهربائي الدوري يصل إلى أقصى سعة) / حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "共鳴板": "رنان, مرنان (أي نظام يحدث له رنين) / دائرة رنين, رنان (دائرة كهربائية تجمع بين السعة والمحاثة بطريقة تجعل التذبذب الكهربائي الدوري يصل إلى أقصى سعة) / حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "共鳴者": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح) / متعاطف, مواسٍ (شخص يواسي شخصًا تعرض لمصيبة)",
 "共鳴音": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام المنطوقة) / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / رنين (اهتزاز ذو سعة كبيرة ينتج عن اهتزاز صغير نسبياً بالقرب من نفس تردد الاهتزاز مثل التردد الطبيعي للنظام الرنان) / رنين (حالة مثارة لجسيم مستقر تسبب حداً أقصى حاداً في احتمالية امتصاص الإشعاع الكهرومغناطيسي) / مُذَكِّرٌ, مُسْتَحْضِرٌ (يستحضر الذاكرة ويثير في الذهن صوراً أو معاني) / رَنَّان, مُتَرَنِّم (يتميّز بالرنين والطنين)",
 "兵": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / قُوَّات, عَسْكَرِيَّة / جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش. / حرب, قتال (شن صراع مسلح ضد عدو) / حَرْب (صراع نشط بين كيانات متنافسة)\nمثال: قُتل آلاف الأشخاص في الحرب / جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي.",
 "兵乱": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب.",
 "兵仗": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "兵児": "شاب (مراهق أو شاب بالغ ذكر)",
 "兵六玉": "أحمق, مغفل (شخص غبي وأحمق)",
 "兵力": "قوة عسكرية, وحدة عسكرية (وحدة تكون جزءًا من خدمة عسكرية ما)\nمثال: أرسل لقيصر قوة قوامها ستة آلاف رجل",
 "兵匪": "قَاطِع طَرِيق",
 "兵卒": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "兵員": "قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة",
 "兵営": "ثُكْنَة, قَشْلَة",
 "兵器": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "兵器工": "صانع أسلحة (مُصنِّع للأسلحة النارية) / صانع أسلحة, مسؤول تسليح (جندي مجند مسؤول عن صيانة الأسلحة الصغيرة والمدافع الرشاشة وما إلى ذلك) / صانع الأسلحة, صانع الدروع (عامل ماهر في صنع الدروع أو الأسلحة)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير",
 "兵器工場": "تِرْسَانَة",
 "兵器庫": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "兵器廠": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "兵団": "فيلق (وحدة جيش تتكون عادة من فرقتين أو أكثر ودعمهم)",
 "兵士": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "兵学": "علوم عسكرية (التخصص الذي يتعامل مع مبادئ الحرب)",
 "兵学校": "أَكَادِيمِيَّةٌ عَسْكَرِيَّة",
 "兵学者": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "兵家": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "兵庫": "هْيُوغُو / ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة) / ترسانة, مخزن أسلحة (هيكل عسكري حيث تُخزن الأسلحة والذخيرة والمعدات العسكرية الأخرى ويتم التدريب على استخدام الأسلحة) / ترسانة (جميع الأسلحة والمعدات التي تمتلكها دولة ما) / ترسانة, جعبة (مجموعة من الموارد)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "兵式体操": "تدريب عسكري (التدريب على المسير واستخدام الأسلحة)",
 "兵役": "خِدْمَةٌ عَسْكَرِيَّة",
 "兵役法": "خِدْمَةٌ عَسْكَرِيَّة",
 "兵戈": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "兵曹長": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)",
 "兵法": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "兵法家": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "兵法者": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "兵火": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا",
 "兵甲": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / مَعْرَكَة",
 "兵略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "兵站": "سَوْقِيَّات, لُوجِسْتِيَّة",
 "兵站学": "سَوْقِيَّات, لُوجِسْتِيَّة",
 "兵站線": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "兵站部": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "兵端": "أعمال عدائية, حرب (القتال؛ أعمال الحرب العلنية)\nمثال: اندلاع الأعمال العدائية",
 "兵粮": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "兵糧": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "兵舎": "ثُكْنَة, قَشْلَة",
 "兵船": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "兵藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "兵術": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "兵装": "تَسْلِيح",
 "兵長": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "兵隊": "قُوَّات مُسَلَّحَة, قُوَّات / جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "兵隊人形": "جندي لعبة (دمية تشبه الجندي)",
 "兵隊勘定": "تقاسم الحساب, عشاء هولندي (عشاء حيث يدفع كل شخص ثمن طعامه)",
 "兵革": "مَعْرَكَة / درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "兵馬": "قُوَّات, عَسْكَرِيَّة / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب.",
 "其": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هُوَ",
 "其々": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "其とはなしに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "其のため": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "其のまま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "其の儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "其の実": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "其の後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "其の日暮し": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "其の日暮らし": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "其の時": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "其の様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "其の為": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "其の物": "نَفْسُهُ, نَفْسُهَا",
 "其の癖": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "其の許": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "其の足で": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "其の辺": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "其の道": "عَلَاقَة غَرَامِيَّة",
 "其の際": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "其れこそ": "خُصُوصًا, خَاصَّةً / بِالتَّأْكِيد / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "其れだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其れと": "إِضَافَةً عَلى ذٰلِكَ",
 "其れと無しに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "其れに引き替えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "其れはそうと": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "其れはそうとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "其れまで": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "其れも其のはず": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "其れ丈": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其れ故": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "其れ故に": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "其れ程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其れ等": "أُولَٰئِكَ, تِلْكَ",
 "其れ者": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / غَيْشَا",
 "其れ自体": "لذاته وعينه",
 "其れ自身": "نَفْسُهُ, نَفْسُهَا",
 "其れ迄": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "其儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "其其": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "其処な": "هُنَاكَ",
 "其処許": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "其後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "其文字": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "其田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "其程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其者": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / غَيْشَا",
 "其許": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "其迄": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "具": "أَدَاة / مُقَوِّم",
 "具す": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "具する": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "具だくさん": "حَمِيم, عَمِيق (عميق الإحساس وصادق المشاعر) / جَلْد, قَوِيّ (ذو صِحَّة قَوِيَّة وطاقَة عالِيَة) / فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / حَارّ, صَادِق (يُظهر ودًّا حارًّا وصادقًا نابعًا من القلب)",
 "具に": "بِالتَّفْصِيل, تَفْصِيلًا",
 "具体": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "具体化": "تَجَسَّد",
 "具体性": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "具体的": "مَادِّيّ / خَرَسَانَة",
 "具備": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "具合": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / حَالَة, ظَرْف",
 "具合が悪い": "عَلِيل, مُتَوَعِّك (يعاني من وعكة صحّيّة خفيفة أو معرَّض للمرض) / مُعَطَّل / غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ / غَيْر مُرِيح (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "具慈": "تايلفيش (سمكة غذائية بنفسجية مرقطة بالأصفر تعيش في المياه العميقة الدافئة) / بلانكيلو (أسماك غذائية بحرية مهمة)",
 "具有": "استعداد, تأهب (حالة الجاهزية أو الاستعداد للاستخدام أو العمل (خاصة العمل العسكري))\nمثال: وضعهم في حالة تأهب",
 "具材": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "具沢山": "حَمِيم, عَمِيق (عميق الإحساس وصادق المشاعر) / جَلْد, قَوِيّ (ذو صِحَّة قَوِيَّة وطاقَة عالِيَة) / فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / حَارّ, صَادِق (يُظهر ودًّا حارًّا وصادقًا نابعًا من القلب)",
 "具現": "الحُلُول / التَّجَسُّد, التَّأَنُّس",
 "具現化": "تَجَسَّد",
 "具眼": "ثاقب النظر, فطن (يمتلك أو يكشف عن بصيرة حادة وحكم جيد) / حَاذِق, مُمَيِّز (قَادِر عَلَى إِدْرَاك الفُرُوقَات الدَّقِيقَة؛ حَسَّاس) / سَرِيعُ الفَهْم, فَطِن (سَرِيعُ الإِدْرَاكِ وَالاسْتِيعَاب) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: ناقد فطن",
 "具象": "عِيَانِيَّة, مَلْمُوسِيَّة (صفة كون الشيء ملموساً (وليس مجرداً))",
 "具象化": "إبراز, تجسيد خارجي (التجسيد في شكل خارجي)",
 "具象名詞": "اِسْمُ ذَاتٍ (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "具象的": "مَادِّيّ / خَرَسَانَة",
 "具足": "اكْتِمَال, تَمَام ((منطق) سمة لنظام منطقي مكون بحيث ينشأ تناقض إذا تم إدخال أي قضية لا يمكن اشتقاقها من بديهيات النظام) / تمام, كمال (حالة كونه كاملاً وتاماً؛ امتلاك كل ما هو مطلوب) / دِرْع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "典": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا. / السُّوَيْد (دولة تقع في إسكندنافيا في شمال قارة أوروبا، اسمها الرسمي مملكة السويد وعاصمتها ستوكهولم)\nمثال: أعيش في شمال السويد. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / مُنْحَدَر / مَيْل",
 "典侍": "وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف)",
 "典則": "تَنْظِيم",
 "典型": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "典型的": "نَمُوذَجِيّ, مِثَالِيّ",
 "典子": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "典憲": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "典拠": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "典礼": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "典範": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "典籍": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "典雅": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "典麗": "رَشِيق, ظَرِيف",
 "兼": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "兼々": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "兼ねて": "قَبْلًا, قَبْل",
 "兼ねてより": "قَبْلًا, قَبْل",
 "兼ね兼ね": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "兼ね合い": "اِتِّزَان, تَوَازُن",
 "兼ね言": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "兼併": "اتحاد, توحيد (عملية صنع أو صيرورة الشيء وحدة واحدة) / اندماج, دمج (اتحاد شركتين تجاريتين أو أكثر)\nمثال: اتحاد الفصائل المتعارضة",
 "兼兼": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "兼合い": "اِتِّزَان, تَوَازُن",
 "兼城": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "兼帯": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة))",
 "兼業主婦": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "兼業農家": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "兼用": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة))",
 "兼行": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم الْعَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "兼言": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "兼重": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "冀う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "内": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي. / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي.",
 "内々": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "内なる": "داخلى",
 "内のやつ": "زَوْجَة, اِمْرَأَة",
 "内の奴": "زَوْجَة, اِمْرَأَة",
