 "係": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "係り": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "係り受け": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "係り合い": "عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "係る": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "係わり": "عَلَاقَة",
 "係わり合い": "عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "係わる": "شَارَكَ, سَاهَمَ / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "係争": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "係受け": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "係合": "خِطْبَة, خُطُوبَة",
 "係員": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "係属": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "係属中": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "係数": "مُعَامِل (في : هو قِيمَة تبيّن دَرَجَة وجود صِفَة أو علاقة في موقف معلوم؛ في : هو العَدَد الذي يسبق المُتَغَيِّر (الحَرْف) في ذات الحد)\nمثال: أساء توم معاملة ماري.",
 "係柱": "عمود حاجز, مربط (عمود قوي (كما في رصيف الميناء أو السفينة لربط حبال الإرساء))\nمثال: أغلق الطريق أمام حركة المركبات باستخدام الأعمدة الحاجزة",
 "係止": "إقفال, إيصاد (فعل قفل شيء ما لحمايته)",
 "係留": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)",
 "係留施設": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة) / رسوم الرسو (رسم للإرساء)",
 "係累": "مُتَوَقِّفْ, مُعْتَمِدْ / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / ثقل, حمل (اهتمام شاق أو صعب) / رهن, عبء (حق للغير على الممتلكات (مثل حق الحجز أو الرهن العقاري))\nمثال: عبء المسؤولية",
 "係船柱": "عمود حاجز, مربط (عمود قوي (كما في رصيف الميناء أو السفينة لربط حبال الإرساء))\nمثال: أغلق الطريق أمام حركة المركبات باستخدام الأعمدة الحاجزة",
 "促す": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح. / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "促成": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)",
 "促成栽培": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "促進": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "促進剤": "مُنَشِّط, مُنَبِّه",
 "俄": "مُبَاغِت, مُفَاجِئ / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "俄か": "مُبَاغِت, مُفَاجِئ / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "俄かに": "فَجْأَةً\nمثال: にわかに雨が降ってきた。 — فجأة هطل المطر. / بسرعة, على الفور (بطريقة دقيقة في المواعيد) / بسهولة, بيسر (دون صعوبة كبيرة)\nمثال: أدى واجبه المنزلي بسرعة",
 "俄か仕立て": "اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)",
 "俄か仕込み": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "俄か雨": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "俄に": "فَجْأَةً\nمثال: にわかに雨が降ってきた。 — فجأة هطل المطر. / بسرعة, على الفور (بطريقة دقيقة في المواعيد) / بسهولة, بيسر (دون صعوبة كبيرة)\nمثال: أدى واجبه المنزلي بسرعة",
 "俄仕立て": "اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)",
 "俄仕込み": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "俄作り": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "俄然": "فَجْأَةً / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "俄狂言": "فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة) / حشوة مفرومة, فورس ميت (خليط من الدجاج النيئ المفروم والفطر مع الفستق والكمأة والبصل والبقدونس والكثير من الزبدة ويربط بالبيض)",
 "俄羅斯": "رُوسِيَا (دولة يقع جزء منها في شمال شرق أوروبا، والجزء الأكبر في شمال آسيا؛ اسمها الرسمي الاتحاد الروسي، وعاصمتها موسكو، وهي أكبر دولة في العالم من حيث المساحة)",
 "俄造り": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "俄雨": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "俊": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "俊傑": "بَطَل, بَطَلَة",
 "俊士": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "俊才": "أُعْجُوبَة / نَابِغَة",
 "俊抜": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "俊敏": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "俊秀": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "俊英": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "俊豪": "مَوْهِبَة",
 "俊逸": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "俎": "لوح تقطيع (لوح خشبي يمكن تقطيع اللحوم أو الخضروات عليه)",
 "俎板": "لوح تقطيع (لوح خشبي يمكن تقطيع اللحوم أو الخضروات عليه)",
 "俗": "شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً) / شَائِع / بَذِيء",
 "俗っぽい": "بَذِيء",
 "俗なる": "بَذِيء",
 "俗に": "غالبا, عَادَةً",
 "俗に言う": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "俗ラテン語": "اللاتينية العامية (لهجات لاتينية غير كلاسيكية كان يتم التحدث بها في الإمبراطورية الرومانية؛ مصدر اللغات الرومانسية)",
 "俗世間": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "俗了": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / ابتذال (فعل جعل الشيء خشناً وغير مهذب)",
 "俗人": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "俗化": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / ابتذال (فعل جعل الشيء خشناً وغير مهذب)",
 "俗向き": "مَحْبُوب",
 "俗念": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "俗悪": "بَذِيء",
 "俗曲": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "俗楽": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "俗歌": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "俗気": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "俗流": "جُمْهُور, جَمَاهِير",
 "俗物": "مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "俗物根性": "خيلاء اجتماعي, عجرفة (سمة التعالي على من هم في مكانة اجتماعية أدنى)",
 "俗物的": "بُرْجُوَازِيّ, مَادِّيّ (يتوافق مع معايير وأعراف الطبقة الوسطى) / مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "俗眼": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "俗累": "دُنْيَوِيَّة (الانشغال بالشؤون الدنيوية مع إهمال الاحتياجات الروحية) / حنكة, خبرة دنيوية (صفة أو طابع الرقي الفكري والخبرة الدنيوية المكتسبة من خلال الثقافة أو التجربة أو خيبات الأمل)\nمثال: كان يكره دنيوية العديد من الأساقفة من حوله",
 "俗習": "عَادَة, عُرْف",
 "俗臭": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "俗臭紛々": "بَذِيء",
 "俗臭紛紛": "بَذِيء",
 "俗臭芬々": "بَذِيء",
 "俗臭芬芬": "بَذِيء",
 "俗衆": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "俗話": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة / حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "俗語": "عَامِّيَّة, دَارِجَة",
 "俗説": "فُولْكْلُور, فُولْكُلُور",
 "俗調": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "俗論": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "俗諺": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "俗謡": "بَالَاد",
 "俗議": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "俗輩": "أرضي, من سكان الأرض (أحد سكان الأرض) / دُنْيَوِيّ (شخص مستغرق في هموم ومصالح وملذات العالم الحالي (الدنيا))",
 "俗間": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "俘囚": "سَجِين, سَجِينَة",
 "俘虜": "أَسِير الْحَرْب, أَسِير (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / ضَحِيَّة / أُضْحِيَّة",
 "俘虜収容所": "مخيم اعتقال, معسكر أسرى الحرب (معسكر لأسرى الحرب)",
 "俚俗": "ابْتِذَال, سُوقِيَّة (صفة الافتقار إلى الذوق والتهذيب)",
 "俚言": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / عَامِّيَّة, دَارِجَة",
 "俚語": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / عَامِّيَّة, دَارِجَة",
 "俚諺": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "俚謡": "بَالَاد",
 "保する": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "保ちつづける": "حَافَظَ",
 "保ち合い": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "保ち合う": "رَصِيد / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "保ち続ける": "حَافَظَ",
 "保つ": "اِحْتَفَظَ, أَبْقَى / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "保井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "保佐人": "قَيِّم, وصي (شخص تعينه المحكمة لتولي مسؤولية مصالح قاصر أو شخص فاقد للأهلية) / أَمِين المَتْحَف, أَمِين المَكْتَبَة (الوصي على مجموعة مقتنيات (كما في متحف أو مكتبة))",
 "保修": "صِيَانَة",
 "保健": "عِلْم الصِّحَّة, عِلْم حِفْظ الصِّحَّة (أَدْرَكَ حقيقة الشيء) / نَظَافَة, حِفْظ الصِّحَّة\nمثال: أدرس علم النفس.",
 "保健制度": "الصِّحَّة العَامَّة",
 "保健医療": "رِعَايَة صِحِّيَّة",
 "保健士": "الصِّحَّة العَامَّة",
 "保健婦": "الصِّحَّة العَامَّة",
 "保健室": "مُسْتَشْفًى, مَشْفًى (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "保健師": "الصِّحَّة العَامَّة",
 "保健所": "رِعَايَة صِحِّيَّة",
 "保健衛生": "عِلْم الصِّحَّة, عِلْم حِفْظ الصِّحَّة (أَدْرَكَ حقيقة الشيء) / نَظَافَة, حِفْظ الصِّحَّة\nمثال: أدرس علم النفس.",
 "保全": "مُحَافَظَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "保全会": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "保全会社": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "保全性": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "保冷剤": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد) / مادة تبريد, وسيط تبريد (أي مادة تستخدم للتبريد (كما في الثلاجة))",
 "保合": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "保合い": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "保合う": "رَصِيد / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "保命": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "保因者": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "保坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "保存": "مُحَافَظَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة. / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "保存処理": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "保存剤": "مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "保存庫": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "保存料": "مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "保存状態": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "保存的": "مُحَافِظ",
 "保守": "صِيَانَة / سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "保守主義": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "保守党": "حزب المحافظين (حزب سياسي (خاصة في بريطانيا العظمى أو أستراليا) يؤمن بأهمية الاقتصاد الرأسمالي مع الملكية الخاصة بدلاً من سيطرة الدولة)",
 "保守性": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "保守派": "مُحَافِظ",
 "保守的": "مُحَافِظ",
 "保守系": "مُحَافِظ",
 "保安": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن. / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "保安係": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "保安係り": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "保安員": "حارِس أَمْن, مُراقِب (حارس يقوم بالمراقبة)",
 "保安官": "رَجُل شُرْطَة, رَجُل قانُون (موظف مكلف بتطبيق القانون)\nمثال: 保安官は、その町の秩序を確立した。 — أَسَّسَ اْلشَّرِيفُ النَّاظِمَ فِي اْلبَلْدَةِ.",
 "保安庁": "أَمْن وَطَنِيّ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "保安設備": "جهاز أمان, واقي (جهاز مصمم لمنع الإصابة أو الحوادث)",
 "保安部": "أمن, قسم الأمن (قسم مسؤول عن أمن ممتلكات المؤسسة والعاملين فيها)\nمثال: كان رئيس الأمن شرطيًا سابقًا",
 "保持": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / ذَاكِرَة / أُسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: حفظ رقم هاتفها.",
