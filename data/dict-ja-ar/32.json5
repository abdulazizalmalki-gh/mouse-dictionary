 "占有": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "占有率": "إشغال, احتلال (فعل شغل أو الاستيلاء على مبنى) / إشغال, استئجار (فعل كون المرء مستأجراً أو شاغلاً لعقار)\nمثال: إشغال مبنى بدون شهادة إشغال غير قانوني",
 "占有者": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "占法": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "占用": "اِحْتِكَار",
 "占筮": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "占算": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط)",
 "占者": "عَرَّاف, عَرَّافَة",
 "占術": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "占領": "اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها)\nمثال: この机は場所を占領しすぎる。 — هذا المكتب يأخذ مساحة كبيرة. / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "占領者": "مُحْتَلّ",
 "卦体": "فَرْدِيّ",
 "卦算": "ثقالة ورق (وزن يستخدم لتثبيت كومة من الأوراق)",
 "卦辞": "تَعْلِيق",
 "卯": "أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب. / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق.",
 "卯の花": "دوتزية (أي من الشجيرات المختلفة من جنس دوتزية ذات أوراق متقابلة مسننة عادة ولحاء مقشر وزهور بيضاء أو وردية في عناقيد طرفية فضفاضة)",
 "卯木": "دوتزية (أي من الشجيرات المختلفة من جنس دوتزية ذات أوراق متقابلة مسننة عادة ولحاء مقشر وزهور بيضاء أو وردية في عناقيد طرفية فضفاضة)",
 "印": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / مودرا (حركة يد طقسية في الدين أو الرقص الديني، خاصة في الهندوسية أو البوذية) / الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا. / شَارَة / دَلِيل, بُرْهَان / دَلِيل",
 "印す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "印する": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "印判": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "印判屋": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "印刷": "طِبَاعَة",
 "印刷インキ": "حبر الطباعة (حبر شبه صلب سريع الجفاف مصنوع خصيصاً للاستخدام في الطباعة)",
 "印刷人": "طَابِعَة",
 "印刷媒体": "الصحافة المطبوعة, وسائل الإعلام المطبوعة (وسيط ينشر المواد المطبوعة)",
 "印刷屋": "طَابِعَة",
 "印刷工": "عامل مطبعة (رجل مهنته الطباعة) / صحفي (صحفي ذكر موظف لتقديم القصص الإخبارية للصحف أو وسائل الإعلام)",
 "印刷所": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "印刷業": "شركة طباعة, مطبعة تجارية (شركة تقوم بالطباعة التجارية)",
 "印刷機": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "印刷社": "شركة طباعة, مطبعة تجارية (شركة تقوم بالطباعة التجارية)",
 "印刷者": "طَابِعَة",
 "印刷術": "طِبَاعَة\nمثال: 印刷術はいつ発明されましたか。 — متى اخترعت الطباعة؟",
 "印刷装置": "طَابِعَة",
 "印刻": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "印加": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع.",
 "印契": "مودرا (حركة يد طقسية في الدين أو الرقص الديني، خاصة في الهندوسية أو البوذية)",
 "印字": "طِبَاعَة",
 "印字位置": "عَمُود / خَانَة",
 "印字出力": "نسخة مطبوعة, نسخة ورقية ((في علم الحاسوب) مادة محفوظة في كمبيوتر ومكتوبة أو مطبوعة على ورق)\nمثال: طبع نسخة ورقية من التقرير",
 "印字機": "آلَة كَاتِبَة, مِكْتَاب (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "印字装置": "طَابِعَة",
 "印度教": "هِنْدُوسِيَّة (المفرد المؤنث من \"هِنْدُوسِيّ\")\nمثال: أفهم الإسلام بشكل جيد ولكنني أدري قليلا عن الهندوسية وثقافتها.",
 "印度菩提樹": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "印形": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "印書": "طباعة, كتابة على الآلة الكاتبة (الكتابة التي تتم باستخدام آلة كاتبة)",
 "印欧": "هِنْدُوأُورُوبِّيَّة",
 "印欧語": "اللغات الهندية الأوروبية (عائلة اللغات التي كان يتم التحدث بها بحلول عام 1000 قبل الميلاد في جميع أنحاء أوروبا وفي أجزاء من جنوب غرب وجنوب آسيا)",
 "印欧語族": "اللغات الهندية الأوروبية (عائلة اللغات التي كان يتم التحدث بها بحلول عام 1000 قبل الميلاد في جميع أنحاء أوروبا وفي أجزاء من جنوب غرب وجنوب آسيا)",
 "印環": "خاتم الختم (خاتم يحمل ختماً)",
 "印画": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "印画紙": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "印相": "مودرا (حركة يد طقسية في الدين أو الرقص الديني، خاصة في الهندوسية أو البوذية)",
 "印税": "مَلَكِيَّة",
 "印章": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "印紙": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "印紙税": "رسوم الطوابع, ضريبة الدمغة (ضريبة تُحصل عن طريق اشتراط شراء طابع ولصقه (عادة على المستندات أو المنشورات))",
 "印肉": "محبرة ختم, وسادة حبر (كتلة من مادة ماصة مشبعة بالحبر؛ تستخدم لنقل الحبر بالتساوي إلى ختم مطاطي)",
 "印行": "طِبَاعَة",
 "印象": "اِنْطِبَاع, أَثَر / تَقْلِيد",
 "印象づける": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "印象主義": "انطباعية (مدرسة للرسامين الفرنسيين في أواخر القرن التاسع عشر صورت المظاهر بضربات من الألوان غير الممزوجة لإعطاء انطباع بالضوء المنعكس)",
 "印象主義者": "انطباعي (متعلق بـ أو مميز للانطباعية) / انطباعي, فنان انطباعي (فنان يتبع نظريات الانطباعية)\nمثال: موسيقى انطباعية",
 "印象付ける": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "印象派": "انطباعي (متعلق بـ أو مميز للانطباعية) / انطباعي, فنان انطباعي (فنان يتبع نظريات الانطباعية)\nمثال: موسيقى انطباعية",
 "印象派美術": "انطباعية (مدرسة للرسامين الفرنسيين في أواخر القرن التاسع عشر صورت المظاهر بضربات من الألوان غير الممزوجة لإعطاء انطباع بالضوء المنعكس)",
 "印象深い": "جَدِيرٌ بِالتَّذَكُّر, لَافِت (يَسْتَحِقُّ أَنْ يُتَذَكَّرَ)",
 "印象的": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "印鑑": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "印顆": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "危": "خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "危うい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / غَيْرُ مُسْتَقِرّ, هَشّ (لا يوفّر راحة أو طمأنينة) / مَحْفُوفٌ بِالخَطَر, وَخِيم (مليء بالأخطار والمهالك) / مُتَزَعْزِع, هَشّ (غير آمن؛ محفوف بالصعوبات)",
 "危うく": "بِٱلْكَاد / تَقْرِيبًا, عَلَى وَشْك",
 "危ない": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فِي خَطَرٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / غَيْر مُحَدَّد (غامض (يُستخدم خاصة في صيغة النفي)) / غَيْر مُؤَكَّد, مَشْكُوك فِيه (غير ثابت بما لا يدع مجالاً للشك؛ لا يزال غير مقرر أو غير معروف) / غَيْر وَاثِق, مُتَرَدِّد (يفتقر إلى أو يشير إلى نقص الثقة أو الاطمئنان) / غَيْر مُؤَكَّد (غير مؤكد الحدوث؛ ليس حتمياً)\nمثال: مستقبل غير مؤكد / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "危なかしい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "危ながる": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "危なく": "تَقْرِيبًا",
 "危なげ": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "危なげない": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "危なっかしい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "危な危な": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "危な気": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "危ぶむ": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "危める": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "危地": "خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "危害": "جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
