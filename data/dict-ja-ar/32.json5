 "化学工場": "مصنع كيميائي (منشأة صناعية يتم فيها إنتاج المواد الكيميائية)",
 "化学工学": "هندسة كيميائية (نشاط تطبيق الكيمياء لحل المشكلات العملية) / هندسة كيميائية (فرع الهندسة المعني بتصميم وبناء وتشغيل المصانع والآلات المستخدمة في العمليات الكيميائية الصناعية)",
 "化学工業": "الصناعات الكيماوية (مصنعو المواد الكيميائية باعتبارهم مجموعة)",
 "化学工業協会": "سِي أَي إِي",
 "化学平衡": "اتزان كيميائي, توازن كيميائي (تفاعل كيميائي يجري فيه التفاعل ومكافئه العكسي بمعدلات متساوية)",
 "化学式": "صيغة, صيغة كيميائية (تمثيل لمادة باستخدام رموز لعناصرها المكونة)",
 "化学戦": "حرب كيميائية (حرب تستخدم عوامل كيميائية لقتل أو إصابة أو شل العدو)",
 "化学物質": "كيماوي, مادة كيميائية (مادة تُنتج أو تُستخدم في تفاعل ينطوي على تغييرات في الذرات أو الجزيئات)",
 "化学物質過敏症": "عريف الحفل, مذيع الربط (شخص يعمل كمضيف في المناسبات الرسمية (يلقي خطابات تمهيدية ويقدم المتحدثين الآخرين)) / مِيجَاهَرْتز (مليون دورة في الثانية)",
 "化学療法": "عِلَاج كِيمِيَائِيّ",
 "化学的": "كِيمَاوِيّ, كِيمِيَائِيّ",
 "化学的性質": "خاصية كيميائية (خاصية تستخدم لتوصيف المواد في التفاعلات التي تغير هويتها)",
 "化学的酸素要求量": "غَادُس / قُدّ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / مُورَة / بَقَلَة\nمثال: قد أثلجت كثيرا.",
 "化学結合": "رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)",
 "化学線": "إشعاع أكتيني, إشعاع كيميائي ضوئي (إشعاع كهرومغناطيسي يمكن أن يحدث تفاعلات كيميائية ضوئية)",
 "化学繊維": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "化学者": "كِيمِيَائِيّ",
 "化学薬品": "كِيمَاوِيّ, كِيمِيَائِيّ",
 "化学量論": "سْتُويكُيُومِتْرِيّ, قِيَاس اِتِّحَادِيّ ((الكيمياء) العلاقة بين كميات المواد التي تشارك في تفاعل أو تكون مركباً (عادة ما تكون نسبة من أعداد صحيحة))",
 "化工": "هندسة كيميائية (نشاط تطبيق الكيمياء لحل المشكلات العملية) / هندسة كيميائية (فرع الهندسة المعني بتصميم وبناء وتشغيل المصانع والآلات المستخدمة في العمليات الكيميائية الصناعية)",
 "化成": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "化成工業": "الصناعات الكيماوية (مصنعو المواد الكيميائية باعتبارهم مجموعة)",
 "化物": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "化物屋敷": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "化現": "الحُلُول / التَّجَسُّد, التَّأَنُّس",
 "化生": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "化生の者": "شَبَح, شَبْح",
 "化療": "عِلَاج كِيمِيَائِيّ",
 "化石": "مُسْتَحَاثَة, أُحْفُورَة / مُتَحَجِّرَة (صخرة نشأت بالتحجر؛ جسم عضوي تخللته مادة معدنية وحُفظ في شكله الأصلي) / تحجر, تصخر (عملية تحويل بعض المواد النباتية إلى حجر عن طريق التشبع بالماء المحمل بالجزيئات المعدنية دون تغيير الشكل الأصلي)",
 "化石学": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "化石燃料": "وَقُود أُحْفُورِيّ",
 "化粧": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي / زينة",
 "化粧下": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "化粧下地": "كِتَاب تَمْهِيدِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "化粧台": "مِزْيَنَة, مِنْضَدَة زِينَة",
 "化粧品": "مُسْتَحْضَرَاتُ التَّجْمِيل",
 "化粧室": "مِرْحَاض, تواليت",
 "化粧張り": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "化粧料": "مَهْر",
 "化粧断ち": "تزيين (فعل إضافة الزينة) / تشذيب, تقليم (القص وصولاً للحجم أو الشكل المطلوب) / تزيين الأطراف, حاشية (زينة أو زخرفة عادة ما تكون على حافة الملابس)\nمثال: كان يجب أن يكون الأطفال في السرير قبل أن يحين وقت تزيين الشجرة",
 "化粧断裁": "تزيين (فعل إضافة الزينة) / تشذيب, تقليم (القص وصولاً للحجم أو الشكل المطلوب) / تزيين الأطراف, حاشية (زينة أو زخرفة عادة ما تكون على حافة الملابس)\nمثال: كان يجب أن يكون الأطفال في السرير قبل أن يحين وقت تزيين الشجرة",
 "化粧用打ち粉": "بودرة التلك, تلك (بودرة تجميل مصنوعة من التلك المنقى وعادة ما تكون معطرة؛ تمتص الرطوبة الزائدة)",
 "化粧直し": "تَجْدِيد, إِحْيَاء",
 "化粧着": "رُوب, ثَوْب نَوْم (مصدر للفعل رَابَ؛ اللبن المروب وهو ما يُخَضُّ ويخرج زبده كالرائب)\nمثال: أخبرني روب بالخبر السعيد.",
 "化粧石鹸": "صابون التواليت, صابون الوجه (صابون يستخدم للنظافة الشخصية)",
 "化粧裁ち": "تزيين (فعل إضافة الزينة) / تشذيب, تقليم (القص وصولاً للحجم أو الشكل المطلوب) / تزيين الأطراف, حاشية (زينة أو زخرفة عادة ما تكون على حافة الملابس)\nمثال: كان يجب أن يكون الأطفال في السرير قبل أن يحين وقت تزيين الشجرة",
 "化粧道具": "أدوات الزينة, مستلزمات النظافة (الأدوات المستخدمة في العناية الشخصية (الغسيل والعناية بالجسم))",
 "化粧部屋": "مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره) / حمام, دورة مياه (غرفة أو مبنى مجهز بمرحاض واحد أو أكثر) / مغسلة (حوض حمام مثبت بشكل دائم ومتصل بمصدر للمياه وأنبوب تصريف؛ حيث يمكنك غسل يديك ووجهك)\nمثال: شغل بعض الماء في المغسلة ورشه على وجهه",
 "化繊": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "化育": "تَطَوُّر",
 "化膿": "صديد, قيح (منتج سائل للالتهاب) / تقيح, تكون الصديد ((طب) تكوّن مادة مرضية في خراج أو حويصلة وخروج القيح)\nمثال: 傷が化膿しました。 — تَكَوّنَ الصديد في الجرح.",
 "化膿性": "مقيح, مولد للقيح (منتج للقيح)",
 "化膿止め": "مُضَادّ حَيَوِيّ",
 "化身": "الحُلُول / التَّجَسُّد, التَّأَنُّس / أَفَاتَار",
 "化骨": "تَعَظُّم",
 "北": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / رياح شمالية (رياح تهب من الشمال)",
 "北々東": "باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "北々西": "باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "北の方": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / زَوْجَة, اِمْرَأَة",
 "北アイルランド": "أِيرْلَنْدَا الشَّمَالِيَّة (جزيرة تقع في شمال المحيط الأطلسي، تحدها جزيرة بريطانيا العظمى من الشرق؛ دولة في شمال غرب قارة أوروبا؛ اسمها الرسمي جمهورية أيرلندا، وعاصمتها دبلن)",
 "北アフリカ": "شَمَال إِفْرِيقِيَا, شَمَال أَفْرِيقِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "北アメリカ": "أَمْرِيكَا الشَّمَالِيَّة",
 "北キプロス": "قُبْرُص الشَّمَالِيَّة (دولة تحكمها جمهورية قبرص، وهي عضو من الاتحاد الأوروبي منذ 2004، ولكنها لا تسيطر على قبرص الشمالية منذ 1974…)\nمثال: كانت قبرص محمية بريطانية.",
 "北マケドニア": "مَقِدُونِيَا الشَّمَالِيَّة",
 "北マケドニア共和国": "جُمْهُورِيَّة شَمَالِ مَقْدُونِيَا",
 "北ヨーロッパ": "أُورُوبَا الشَّمَالِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "北京": "بِكِين / پِكِين / كِيُوتُو",
 "北京人": "بِكِينِيّ, بِكِينِيَّة",
 "北京原人": "إنسان بكين (أحافير عُثر عليها بالقرب من بكين، الصين؛ فُقدت خلال الحرب العالمية الثانية)",
 "北京語": "الصينية الفصحى, الماندرين (لهجة صينية يتم التحدث بها في بكين وتم اعتمادها كلغة رسمية للصين بأكملها)",
 "北側": "الجانب الشمالي (الجانب الذي يقع في الشمال)",
 "北光": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "北入": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "北入ル": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "北北東": "باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي)",
 "北北西": "باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "北半球": "نِصْف اَلْكُرَة الْأَرْضِيَّة الشَّمَالِيّ",
 "北回帰線": "مَدَار السَّرَطَان (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "北国": "الأراضي الشمالية, الشمال (أي منطقة تقع في الشمال أو باتجاهه)",
 "北国人": "شمالي (أحد سكان الشمال) / شمالي, يانكي (أمريكي يعيش في الشمال (خاصة خلال الحرب الأهلية الأمريكية))",
 "北堂": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "北大西洋条約機構": "مُنَظَّمَة حِلْف شَمَال اَلْأَطْلَسِيّ, اَلْحِلْف اَلْأَطْلَسِيّ",
 "北寄り": "شَمَالًا (في اتجاه الشمال) / شَمَالِيّ المَصْدَر (قادم من الشمال؛ يوصف به خاصة الرياح) / شَمَالِيّ الاتِّجَاه (موجَّه نحو الشمال) / رياح شمالية (رياح تهب من الشمال)\nمثال: يكسبون أكثر في الشمال",
 "北斗": "بَنَاتُ نَعْشٍ الكُبْرَى",
