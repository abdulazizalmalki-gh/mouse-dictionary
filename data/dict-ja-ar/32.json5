 "元帥": "عَقِيْد",
 "元帳": "دفتر أستاذ, دفتر يومية (دفتر يومية محاسبي كشيء مادي) / دفتر الأستاذ, دفتر الحسابات (سجل تُدون فيه الحسابات التجارية)\nمثال: اشترى دفتر يومية جديداً",
 "元彼": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "元手": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود / رَصِيد, مَكْسَب (صفة مفيدة أو ذات قيمة)",
 "元払": "دفع مسبق (الدفع مقدماً)",
 "元払い": "دفع مسبق (الدفع مقدماً)",
 "元方": "تَاجِر جُمْلَة / رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "元日": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "元旦": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "元旦那": "زوج سابق, طليق (رجل كان زوجاً لامرأة معينة سابقاً)",
 "元朝": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / السلالة المغولية, سلالة يوان (السلالة الإمبراطورية للصين من 1279 إلى 1368)",
 "元期": "عَصْر, عُصُور (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "元木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "元本": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "元来": "أَصْلًا / أساساً, في المقام الأول (ذو أهمية أولية) / أصلاً, في المقام الأول (قبل الآن)\nمثال: هذه مسألة اقتصادية في المقام الأول",
 "元栓": "مِحْبَس",
 "元正": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "元気": "دَجِر / صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "元気づけ": "طمأنة (فعل الطمأنة؛ استعادة ثقة شخص ما)",
 "元気でね": "تَوَخَّى اَلْحِذْر",
 "元気よく": "بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك",
 "元気をつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "元気を付ける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "元気付け": "طمأنة (فعل الطمأنة؛ استعادة ثقة شخص ما)",
 "元気回復": "تجديد الشباب (فعل الاستعادة لحالة أكثر شباباً) / استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "元気百倍": "دَجِر",
