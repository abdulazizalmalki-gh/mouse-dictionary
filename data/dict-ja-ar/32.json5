 "叙する": "حَكَى, رَوَى (رَوَى قِصَّةً أَو حَدِيثًا؛ حكَى الشَّيءَ : شابَهَه)\nمثال: حكى لنا قصة شيقة. / أَفْضَلَ, مَنَحَ / تَآمَرَ",
 "叙事": "حِكَايَة",
 "叙事文": "حِكَايَة",
 "叙事的": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "叙事詩": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "叙任": "تنصيب, تولية (العمل الرسمي المتمثل في إلباس شخص ما شارة منصب؛ الترقية الرسمية لشخص إلى منصب أو رتبة) / تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "叙位": "تنصيب, تولية (العمل الرسمي المتمثل في إلباس شخص ما شارة منصب؛ الترقية الرسمية لشخص إلى منصب أو رتبة) / تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "叙品": "رِسامة",
 "叙実法": "مَرْفُوع",
 "叙情": "شاعريّة, عاطفة جياشة (حماس مفرط وغير مقيد) / شاعرية, غنائية (خاصية الملاءمة للغناء)",
 "叙情的": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة) / غِنَائِيّ, وِجْدَانِيّ (مُنَاسِبٌ لِلْغِنَاءِ أَوْ يُوحِي بِه)",
 "叙情詩": "غِنَائِيّ, وِجْدَانِيّ (يعبّر عن عاطفة عميقة) / غنائي (تستخدم لمغنٍ أو صوت غنائي خفيف الحجم ومتواضع النطاق) / غنائي, وجداني (متعلق بفئة من الشعر تعبر عن العاطفة (غالباً بطريقة شبيهة بالأغنية)) / أوبرالي, غنائي (متعلق بالدراما الموسيقية)\nمثال: سوبرانو غنائي",
 "叙想法": "حالَةُ النَّصْبِ",
 "叙景": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "叙法": "مَزَاج",
 "叙法性": "نمط علاجي, وسيلة علاجية (طريقة للعلاج تتضمن علاجاً علاجياً فيزيائياً أو كهربائياً) / نمط حسي (حاسة معينة) / أُسْلُوب, صِيغَة الفِعْل (تصريفات الفعل التي تعبر عن كيفية تصور المتحدث للفعل أو الحالة) / جِهَة, مُوَجِّه (تصنيف للقضايا على أساس ما إذا كانت تدعي الضرورة أو الإمكانية أو الاستحالة)",
 "叙説": "تَفْسِير, شَرْح",
 "叙述": "وَصْف, تَوْصِيف / إِسْنَادِيّ, خَبَرِيّ (للصفات؛ تتعلق بـ أو تحدث داخل خبر الجملة)",
 "叙述用法": "إِسْنَادِيّ, خَبَرِيّ (للصفات؛ تتعلق بـ أو تحدث داخل خبر الجملة)",
 "叙階": "رِسامة",
 "叛く": "عَصَى",
 "叛乱": "انتفاضة",
 "叛乱者": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "叛徒": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "叛賊": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "叛軍": "مُتَمَرِّد, ثَائِر",
 "叛骨の精神": "عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "叟": "شَيْخ, عَجُوز",
 "叡智": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "叡知": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "叢": "حَشِيش, عُشْب / حَشِيش / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / ضَفِيرَة",
 "叢書": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "叢氷": "طوف جليدي, كتل جليدية (مساحة كبيرة من الجليد العائم)",
 "口": "فَم, بق / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بَوَّابَة / كَلَام, تَكَلُّم",
 "口々に": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "口あんぐり": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "口うるさい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "口かせ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "口がうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口がうるさい": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "口がきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口がわるい": "ساخر",
 "口が上手い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口が利けない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口が多い": "ثَرْثَار",
 "口が巧い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口が悪い": "ساخر",
 "口が煩い": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "口が裂けても": "مَهْمَا",
 "口が重い": "انطوائي, غير تواصلي (لا يميل إلى التحدث أو إعطاء المعلومات أو التعبير عن الآراء)",
 "口きき": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口ぐせ": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "口げんか": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口ごたえ": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "口ごもる": "غَمْغَمَة",
 "口さがない": "ثَرْثَار, نَمَّام (يميل إلى الدردشة غير الرسمية ونقل الأخبار والقيل والقال)",
 "口ずから": "مُبَاشَرَةً",
 "口ずさむ": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "口つき": "فَم, بق / مَبْسَم",
 "口づけ": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口づける": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口にする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "口にのぼせる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "口に上せる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "口に入る": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "口に出す": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "口に掛ける": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "口に運ぶ": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "口のうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口のかるい": "ثَرْثَار",
 "口のきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口のわるい": "ساخر",
 "口の上手い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口の利けない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口の悪い": "ساخر",
 "口の端": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "口の軽い": "ثَرْثَار",
 "口の達者": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口はばったい": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "口ひげ": "شَارِب",
 "口ぶえ": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "口ぶり": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / إِشَارَة, تَلْمِيح (اقتراح غير مباشر)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "口べた": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口まね": "مُشَاكهَة",
 "口まめ": "ثَرْثَار",
 "口もと": "فَم, بق",
 "口やかましい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء) / ثَرْثَار",
 "口をかける": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "口をきく": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث. / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "口をきる": "فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح.",
 "口をきわめて": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "口をだす": "قَاطَعَ",
 "口をついて出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "口をつく": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "口をつぐむ": "صَمَتَ",
 "口をつける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "口をとがらす": "بوّز, بَرطَمَ",
 "口をとがらせる": "بوّز, بَرطَمَ",
 "口をわる": "اِعْتَرَفَ, أَقَرَّ",
 "口を付ける": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "口を出す": "قَاطَعَ",
 "口を切る": "فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح.",
 "口を利く": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث. / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "口を割る": "اِعْتَرَفَ, أَقَرَّ",
 "口を噤む": "صَمَتَ",
 "口を封じる": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "口を尖らす": "بوّز, بَرطَمَ",
 "口を尖らせる": "بوّز, بَرطَمَ",
 "口を掛ける": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "口を極めて": "بحدة بالغة, بشكل لاذع (بطريقة قاسية وناقدة بحدة دون هوادة)\nمثال: انتقدته بشكل لاذع",
 "口を添える": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "口を突いて出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "口ゲンカ": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口コミ": "تناقل الأخبار, كلمة الفم (انتشار القيل والقال عن طريق التواصل المنطوق)\nمثال: انتشر خبر علاقتهم عن طريق التناقل الشفهي",
 "口マネ": "مُشَاكهَة",
 "口三味線": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "口上": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / برولوج, فاتحة مسرحية (مقدمة لمسرحية)",
 "口上手": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "口下手": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口不調法": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口中": "تجويف فموي, فم (الفتحة التي يتم من خلالها تناول الطعام وخروج الأصوات)\nمثال: حشا فمه بالحلوى",
 "口争い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口付き": "فَم, بق / مَبْسَم",
 "口付け": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口付ける": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口供": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "口供書": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "口元": "فَم, بق",
 "口元が緩む": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "口先": "مجاملة كاذبة, نفاق (تعبير عن الموافقة غير مدعوم بقناعة حقيقية) / شَفَة, شفة",
 "口先だけ": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري)",
 "口入れ人": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "口入れ屋": "وَكَالَة تَوْظِيف",
 "口入屋": "وَكَالَة تَوْظِيف",
 "口八丁": "ثرثار, طليق اللسان (يتميز بتدفق جاهز للكلام)\nمثال: هي شابة ثرثارة للغاية تنخرط في مناجاة النفس وليس المحادثات",
 "口内": "فَمَوِيّ / شَفَهِيّ / شَفَوِيّ / مَنْطُوق",
 "口内性交": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "口内炎": "التهاب الفم (التهاب الغشاء المخاطي للفم)",
 "口出し": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "口分け": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "口切り": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "口利き": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口前": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "口取": "سَائِس / هَندَم / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "口取り": "سَائِس / هَندَم / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "口口に": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "口可笑": "مَزَّاح, هَزْلِيّ (يتّسم بالمُزاح وحُسن الدعابة)",
 "口吸い": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل.",
 "口吻": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / إِشَارَة, تَلْمِيح (اقتراح غير مباشر)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث / شَفَة, شفة",
 "口吻をもらす": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "口吻を洩らす": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "口吻を漏らす": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "口味": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "口唇": "شَفَة, شفة",
 "口唇ヘルペス": "قرحة البرد, هربس فموي",
 "口唇動脈": "شريان شفوي (شريان هو فرع من الشريان الوجهي يغذي شفاه الفم)",
 "口唇期": "المرحلة الفموية ((التحليل النفسي) المرحلة الجنسية والاجتماعية الأولى لنمو الرضيع؛ الفم هو بؤرة الليبيدو ويأتي الرضا من الرضاعة والمضغ والعض)",
 "口唇炎": "التهاب الشفة (التهاب وتشقق جلد الشفتين)",
 "口唇裂": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "口喧しい": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء) / ثَرْثَار",
 "口喧嘩": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口回し": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "口固い": "رزين, كتوم (يتميز بالحكمة أو التواضع وضبط النفس الحكيم) / مُتَحَرِّز, مُتَحَفِّظ (ينتبه للعواقب المحتملة ويتوخّى الحذر) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: مساعده الكتوم الموثوق به",
 "口堅い": "رزين, كتوم (يتميز بالحكمة أو التواضع وضبط النفس الحكيم) / مُتَحَرِّز, مُتَحَفِّظ (ينتبه للعواقب المحتملة ويتوخّى الحذر) / حَصِيف, فَطِن (ذو إدراك خفي ومتعاطف)\nمثال: مساعده الكتوم الموثوق به",
 "口外": "فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا) / فاضح, كاشف (يُظهر أو يُعرف بالشيء) / إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)\nمثال: نظرة كاشفة",
 "口実": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "口寄": "قَنَاة",
 "口寄せ": "قَنَاة",
 "口封じ": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "口小言": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "口尻": "صوار (حزمة من الألياف العصبية تمر من جانب إلى آخر من الدماغ أو الحبل الشوكي)",
 "口峡炎": "اِلْتِهَاب حَلْق",
 "口巧者": "بَلِيغ, طَلِيق اللِّسَان (يُعبِّر عن نفسه بسهولة ووضوح وفعاليّة)",
 "口幅ったい": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "口座": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "口座係": "راوٍ, قاص (شخص يحكي قصة) / أمين صندوق, صراف بنك (موظف في بنك يستلم ويدفع الأموال) / عداد, فارز الأصوات (مسؤول معين لعد الأصوات (خاصة في الجمعية التشريعية))",
 "口弁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口当たり": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "口径": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما)",
 "口径食": "رسم مصغر (رسم توضيحي صغير (كما يوضع أحياناً في بداية الفصول في الكتب)) / صورة متلاشية الحواف, فينيت (صورة تتلاشى حوافها تدريجياً) / رسم أدبي, لمحة وصفية (وصف أدبي موجز)",
 "口忠実": "ثَرْثَار",
 "口惜しい": "مَهْزُوم, مُحْبَط (فاشل بشكل مخيّب للآمال)",
 "口才": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口承文芸": "فُولْكْلُور, فُولْكُلُور",
 "口抜き": "بَرِّيمة",
 "口拭き": "مَنْدِيل, مَنْدِيل مَائِدَة",
 "口振り": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / إِشَارَة, تَلْمِيح (اقتراح غير مباشر)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "口数": "سُكَّان / سُكَّانِيَّة",
 "口数が多い": "ثَرْثَار",
 "口数が少ない": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "口数の多い": "ثَرْثَار",
 "口数の少ない": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "口早": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "口明け": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "口書": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "口書き": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "口枷": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "口止め": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "口止め料": "شراء الصمت, مال السكوت (رشوة تُدفع لشخص لضمان بقاء شيء سراً)",
 "口気": "بَخَر ((الْبَخَرُ) بِفَتْحَتَيْنِ نَتَنُ الْفَمِ فَهُوَ (أَبْخَرُ))",
 "口汚い": "بَذِيء اللِّسَان / طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "口淫": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "口添え": "تَوْصِيَة",
 "口渇": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش.",
 "口演": "إلقاء, تحدث علني (إلقاء خطاب لجمهور عام)\nمثال: جاء الناس لرؤية المرشحين وسماع الخطب",
 "口火": "فَتِيل / مُنْصَهِرَة, مصهر / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "口炎": "التهاب الفم (التهاب الغشاء المخاطي للفم)",
 "口煩い": "كَثِير التَّذَمُّر, نَوَّاح (دائم الشكوى والتذمر وتصيد الأخطاء)",
 "口琴": "هارمونيكا (آلة صغيرة مستطيلة ذات قصبات حرة تحتوي على صف من القصبات الحرة مثبتة في ثقوب هوائية وتُعزف بالنفخ في الثقب المطلوب)",
 "口癖": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "口白鹿": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "口直し": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / إنترميزو, فاصل موسيقي (قطعة قصيرة من الموسيقى الآلية مؤلفة للأداء بين فصول الدراما أو الأوبرا) / إنترميزو (حركة قصيرة تأتي بين الأقسام الرئيسية للسيمفونية)",
 "口真似": "مُشَاكهَة",
 "口碑": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "口端": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "口笛": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "口笛を吹く": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "口答え": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "口篭もる": "غَمْغَمَة",
 "口篭る": "غَمْغَمَة",
 "口籠もる": "غَمْغَمَة",
 "口籠る": "غَمْغَمَة",
 "口糧": "حِصَّة / قَنَّنَ (قلل الكمية واقتصد بها؛ وضع الشيء في قَنَانِي)",
 "口紅": "أَحْمَر شِفَاه (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "口紐": "خيط زم, رباط سحب (رباط يتكون من حبل يمر عبر درزة حول فتحة)\nمثال: سحب خيط الزم وأغلق الحقيبة",
 "口細": "باراكودا, عقام",
 "口絵": "صفحة العنوان المقابلة (رسم توضيحي أمامي يواجه صفحة العنوان في كتاب) / واجهة مزخرفة (واجهة مبنى مزخرفة)",
 "口綺麗": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "口縁": "مُحِيط الفَم (المنطقة المحيطة بالفم في مختلف اللافقاريات) / فم العلبة, محيط الفم ((في علم النبات) طوق من الزوائد التي تشبه الأسنان تحيط بفم علبة الحزاز)",
 "口腔": "تجويف فموي, فم (الفتحة التي يتم من خلالها تناول الطعام وخروج الأصوات)\nمثال: حشا فمه بالحلوى",
 "口腔がん": "سرطان الفم (ورم خبيث في الشفاه أو الفم؛ أكثر شيوعًا لدى الرجال فوق سن الستين)",
 "口腔カンジダ症": "داء المبيضات الفموي",
 "口腔ガン": "سرطان الفم (ورم خبيث في الشفاه أو الفم؛ أكثر شيوعًا لدى الرجال فوق سن الستين)",
 "口腔乾燥症": "جفاف الفم (جفاف غير طبيعي للفم ناتج عن انخفاض إفراز اللعاب)",
 "口腔外科": "جراحة الأسنان (فرع طب الأسنان الذي يشمل الإجراءات الجراحية)",
 "口腔性交": "جِنْس فَمَوِيّ (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "口腔灼熱症候群": "حركة الأمعاء (تعبير مهذب للتبرز) / براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء)\nمثال: كان لديه حركة أمعاء",
 "口腔癌": "سرطان الفم (ورم خبيث في الشفاه أو الفم؛ أكثر شيوعًا لدى الرجال فوق سن الستين)",
 "口腔衛生": "صِحَّة الفَمّ (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك.",
 "口腹": "شَهِيَّة",
 "口臭": "بَخَر ((الْبَخَرُ) بِفَتْحَتَيْنِ نَتَنُ الْفَمِ فَهُوَ (أَبْخَرُ))",
 "口舌": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / صرصرة, طقطقة (سلسلة سريعة من الضوضاء التي تصدرها أجزاء الآلة) / إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "口舌の争い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口荒く": "بِعُنْف",
 "口蓋": "حَنَك ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "口蓋垂": "لَهَاة",
 "口蓋垂音": "لَهَوِيّ",
 "口蓋裂": "حنك مشقوق (شق خلقي في الحنك الصلب)",
 "口蓋音": "غَارِيّ",
 "口蓋骨": "عظم حنكي (أي من عظمين غير منتظمي الشكل يشكلان مؤخرة الحنك الصلب ويساعدان في تكوين التجويف الأنفي وأرضية محاجر العين)",
 "口裂": "تجويف فموي, فم (الفتحة التي يتم من خلالها تناول الطعام وخروج الأصوات)\nمثال: حشا فمه بالحلوى / فم خلوي (فم الحيوان الأولي)",
 "口角を上げる": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "口触り": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "口言葉": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً / لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "口許": "فَم, بق",
 "口詞": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً / لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "口話法": "قراءة الشفاه (إدراك ما يقوله الشخص بمراقبة حركات الشفاه)",
 "口語": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "口語表現": "عَامِّيَّة, دَارِجَة",
 "口誦": "تِلَاوَة",
 "口説": "ثرثرة, صياح (الضجيج المستمر عالي النبرة الذي تصدره الحيوانات (الطيور أو القرود)) / صرصرة, طقطقة (سلسلة سريعة من الضوضاء التي تصدرها أجزاء الآلة)",
 "口説き": "استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال",
 "口説き文句": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "口説き落す": "أَقْنَعَ",
 "口説き落とす": "أَقْنَعَ",
 "口説く": "أَقْنَعَ / أَغْرَى, أَغْوَى",
 "口調": "نَغْمَة, نَغْم",
 "口論": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "口蹄疫": "حَمَّى قُلَاعِيَّة (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "口車": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "口車に乗る": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "口軽": "ثَرْثَار",
 "口輪": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "口辯": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "口返答": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "口述": "إِمْلَاء (الاسم من قراءة الشيء على أحد ما حتى يكتبه كما قُرِأ؛ الأمر بأشياء بدون السماح للمأمور بالمخالفة كأنه يُمْلِي عليه شيئا ليكتب)",
 "口述書": "إقرار مشفوع بيمين, شهادة خطية بقسم (إعلان مكتوب تحت القسم؛ بيان مكتوب يقسم على صحته أمام شخص مخول قانوناً بإدارة القسم)",
 "口述試験": "امتحان شفهي (امتحان يجرى عن طريق التواصل المنطوق)",
 "口過ぎ": "مَعِيشَة, مَعَاش",
 "口達者": "فَصِيح, فُصْحَى",
 "口部分": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "口重": "حَرِيص, حَكِيم / حَرِيص",
 "口重い": "حَرِيص, حَكِيم / حَرِيص",
 "口金": "قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي / مَبْسَم / مَقْبِس",
 "口針": "قلم, مرود (زائدة صغيرة تشبه الإبرة؛ خاصة عضو التغذية في بطيئات المشية)",
 "口銭": "عُمُولَة",
 "口開け": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "口音": "صامت فموي (صوت صامت في الكلام يصدر عن طريق السماح للهواء بالخروج من الفم، على عكس الأنف)",
 "口頭": "فَمَوِيّ / شَفَهِيّ / شَفَوِيّ / مَنْطُوق",
 "口頭試問": "امتحان شفهي (امتحان يجرى عن طريق التواصل المنطوق)",
 "口頭語": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "口髭": "شَارِب",
 "古": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟ / قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "古い": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة. / طَوِيل / مِنْ زَمَن بَعِيد (ينتمي إلى زمن غابر ومضى) / بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "古き": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "古き良き時代": "الزَّمَن الجَمِيل",
 "古く": "في العصور القديمة, قديماً (في الأزمنة القديمة؛ منذ زمن بعيد)\nمثال: اهتمام بما قد حدث قديماً / أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "古くさい": "بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "古だぬき": "مُحَارِب قَدِيم",
 "古ぼけた": "بَالٍ",
 "古めかしい": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "古る": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "古ノルド語": "النوردية القديمة (اللغة الجرمانية المنقرضة لإسكندنافيا وأيسلندا في العصور الوسطى من حوالي 700 إلى 1350)",
 "古事": "تَقْلِيد",
 "古人類学": "أنثروبولوجيا قديمة, علم الحفريات البشرية (الدراسة العلمية للحفريات البشرية)",
 "古代": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "古代エジプト": "مِصْر اَلْقَدِيمَة (تقع في أقصى شمال شرق إفريقيا وجنوب غرب آسيا؛ اسمها الرسمي جُمْهُورِيَّة مِصْر الْعَرَبِيَّة، وعاصمتها الْقَاهِرَة؛ الحَاجِز بين الشيئين، والحَدُّ بين الأرضَيْن (جمعها مُصُور))\nمثال: ولد سامي في مصر.",
 "古代ギリシア": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "古代ギリシア語": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古代ギリシャ": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها أَثِينَا)\nمثال: أنا من اليونان.",
 "古代ギリシャ語": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古代ローマ": "رُومَا الْقَدِيمَة (ولاية إيطالية؛ مدينة هي عاصمة ولاية روما الإيطالية)\nمثال: روما مدينة قديمة.",
 "古代人": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط الإمبراطورية الرومانية في أوروبا الغربية))",
 "古代史": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "古代米": "أرز بري (حبوب عشب مائي من أمريكا الشمالية) / أرز بري (عشبة مائية معمرة في أمريكا الشمالية تحمل حبوباً تستخدم للغذاء)",
 "古代紫": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "古伝": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "古体": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "古例": "تَقْلِيد",
 "古傷": "نَدْبَة, نَدْب",
 "古兵": "سَامُورَاي / مُحَارِب قَدِيم",
 "古典": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي",
 "古典ギリシア語": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "古典ギリシャ語": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "古典ラテン語": "لَاتِينِيَّة كْلَاسِيكِيَّة (المنسوبة إلى المنطقة المحيطة بمدينة روما والتي كانت تسمى لَاتِيْن في عصر الروم وأصبحت الآن تسمى لَازِيُو؛ المنسوبة إلى اللَاتِيْن، وهم دول أمريكا الشمالية والوسطى الذين يتحدثون لغات من أصل لاتينيّ، خصوصا الإِسْبَانِيَّة والبُرْتُغَالِيَّة)\nمثال: أعرف اللاتينية.",
 "古典主義": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت العقلانية وضبط النفس والأشكال الصارمة)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "古典主義者": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي) / باحث كلاسيكي, كلاسيكي (طالب أو باحث في اللغتين اليونانية واللاتينية القديمة)",
 "古典力学": "ميكانيكا كلاسيكية, ميكانيكا نيوتنية (فرع الميكانيكا القائم على قوانين نيوتن للحركة)",
 "古典古代": "اَلْعُصُورُ ٱلْكلَاسِيكِيَّةُ ٱلْقَدِيمَةُ",
 "古典学": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "古典学者": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي) / باحث كلاسيكي, كلاسيكي (طالب أو باحث في اللغتين اليونانية واللاتينية القديمة)",
 "古典的": "تَقْلِيدِيّ, كْلَاسِيكِيّ",
 "古典的条件づけ": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء حدثت الاستجابة الشرطية أم لا حتى يأتي المحفز المحايد في النهاية لإثارة…)",
 "古典的条件付け": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء حدثت الاستجابة الشرطية أم لا حتى يأتي المحفز المحايد في النهاية لإثارة…)",
 "古典音楽": "مُوسِيقَى كْلَاسِيكِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "古写本": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "古動物学": "علم الحيوانات القديمة (دراسة الحيوانات الأحفورية)",
 "古参": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "古参兵": "مُحَارِب قَدِيم",
 "古参者": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "古史": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "古器": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "古地理学": "جغرافيا قديمة (دراسة جغرافيا العصور القديمة أو الحقب القديمة)",
 "古塚": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "古墳": "برويطة, عربة يدوية بعجلة واحدة (عربة لحمل الأحمال الصغيرة؛ لها مقابض وعجلة واحدة أو أكثر) / تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ) / ملء عربة يدوية (الكمية التي تستوعبها العربة اليدوية)",
 "古希": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古式": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "古式ゆかしい": "تَقْلِيدِيّ",
 "古式床しい": "تَقْلِيدِيّ",
 "古強者": "سَامُورَاي / مُحَارِب قَدِيم",
 "古手": "بَالٍ / مُحَارِب قَدِيم / قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "古文": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "古文字": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "古文学": "عِلْم الكِتَابَات القَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "古文書": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك))",
 "古文書学": "علم الوثائق (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "古書": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي",
 "古書体学": "عِلْم الكِتَابَات القَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "古期": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "古株": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "古格": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "古植物学": "علم النباتات القديمة (دراسة النباتات الأحفورية)",
 "古武士": "سَامُورَاي / مُحَارِب قَدِيم",
 "古気候学": "علم المناخ القديم (دراسة مناخ العصور الماضية)",
 "古泉学": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "古流": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة وتباين قليل بين الخطوط الخفيفة والثقيلة)",
 "古物": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "古物市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "古狐": "عجوز, مخضرم / محارب قديم, مخضرم (شخص ذو خبرة مر بالعديد من المعارك؛ أو شخص قدم خدمة طويلة)",
 "古狸": "مُحَارِب قَدِيم",
 "古生態学": "بيئة قديمة (فرع علم البيئة الذي يدرس البيئة القديمة)",
 "古生植物学": "علم النباتات القديمة (دراسة النباتات الأحفورية)",
 "古生物学": "بليونتولوجيا, علم الأحافير (علم الأرض الذي يدرس الكائنات الحية الأحفورية والبقايا ذات الصلة)",
 "古生物学者": "عالم حفريات, عالم مستحاثات (متخصص في علم الحفريات)",
 "古病理学": "علم الأمراض القديمة (دراسة أمراض العصور السابقة (المستنتجة من الأدلة الأحفورية))",
 "古皮質": "قشرة عتيقة (القشرة الشمية للمخ)",
 "古稀": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古細菌": "بكتيريا قديمة, عتائق (تُعتبر أشكال حياة قديمة تطورت بشكل منفصل عن البكتيريا والطحالب الخضراء المزرقة)",
 "古美術": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "古美術品": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "古美術商": "أثري, جامع تحف (خبير أو جامع للآثار والتحف القديمة)",
 "古老": "عجوز, كبير السن (شخص متقدم في السن)",
 "古臭い": "بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "古英語": "إِنْجْلِيزِيَّة عَتِيقَة (مُؤَنَّثُ إِنْجْلِيزِيّ، ٌ مُؤَنَّثَةٌ إِلَى ٱلْإِنجليزِ؛ اَللُّغَةُ ٱلْإِنجليزِيَّةُ: وَهي اللغَة الأكثَر ٱستعمَالًا (كلغة ثانية) في هذَا العصر…)\nمثال: تحدث بالإنجليزية!",
 "古語": "أركايك, تعبير قديم (استخدام تعبير قديم)",
 "古豪": "مُحَارِب قَدِيم",
 "古道具": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "古里": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / خَرَاب, خَرَابَة / دَمَّرَ",
 "古金": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "古鉄": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "古銭学": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "古銭学者": "جامع عملات, عالم عملات (جامع ودارس للنقود (والعملات المعدنية بشكل خاص))",
 "古雅": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "古風": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "句": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة! / نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء. / هَايْكُو",
 "句動詞": "فعل مركب (فعل إنجليزي يتبعه حرف أو أكثر حيث يتصرف المزيج كوحدة نحوية ودلالية)",
 "句法": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "句点": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "句読": "عَلَامَة تَرْقِيم, تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "句読点": "عَلَامَة تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "叩き": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة / خبطة, ضربة قوية (ضربة قوية) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)\nمثال: الضربة المفاجئة طرحته أرضاً / سَرِقَة, لُصُوصِيَّة / مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "叩きつける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "叩きのめす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩きを掛ける": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "叩き上げ": "عِصَامِيّ",
 "叩き付ける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "叩き伏せる": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩き出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "叩き切る": "اِخْتَرَقَ / حيلة",
 "叩き割る": "كَسَّرَ / تَكَسَّرَ",
 "叩き台": "قرمة, لوح التقطيع (كتلة خشبية ثابتة يمكن تقطيع الطعام أو تقطيعه إلى مكعبات عليها أو شق الخشب عليها)",
 "叩き合う": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "叩き斬る": "اِخْتَرَقَ / حيلة",
 "叩き潰す": "كَسَّرَ / تَكَسَّرَ / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "叩き落す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩き落とす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩く": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته. / حَمْلَة / هَاجَمَ / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة. / صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "叩っ斬る": "اِخْتَرَقَ / حيلة",
 "叩打": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "叩解": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "叩頭": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "叩頭く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "叩頭虫": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "叩首": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "只ならない": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي / غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن مقارنتها)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "只に": "بِالْكَاد",
 "只の人": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "只中": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "只今": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / آنِفاً / حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "只言": "كَلَام مُبَاشِر, مُقْتَبَس",
 "叫び": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "叫び声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "叫ぶ": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة. / جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس) / جلبة, صخب (ضجيج عالٍ خشن أو حاد)\nمثال: تجاهل صخب الحشد",
 "叫る": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "叫喚": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "叫声": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "召される": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "召し": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "召し上がりもの": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "召し上がり物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "召し上がる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "召し上げる": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / مَسْلُوب, مُصَادَر (تمّت مصادرته كعقوبة) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد / يَسْتَحْضِر, يَسْتَدْعِي",
 "召し上り物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "召し使い": "خَادِم, خَادِمَة",
 "召し使う": "وَظَّفَ",
 "召し出す": "يَسْتَحْضِر, يَسْتَدْعِي",
 "召し取る": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "召し抱える": "وَظَّفَ",
 "召し捕る": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "召し物": "مَلَابِس, ثِيَاب",
 "召し連れる": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "召す": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "召ずる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "召上げる": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / مَسْلُوب, مُصَادَر (تمّت مصادرته كعقوبة) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد / يَسْتَحْضِر, يَسْتَدْعِي",
 "召使": "خَادِم, خَادِمَة",
 "召使い": "خَادِم, خَادِمَة",
 "召使う": "وَظَّفَ",
 "召募": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "召命": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "召喚": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له. / استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى)",
 "召喚状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "召天": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "召抱える": "وَظَّفَ",
 "召致": "اِسْتِدْعَاء, دَعْوَة لِلْاِجْتِمَاع (عملية دعوة الناس للتجمع)",
