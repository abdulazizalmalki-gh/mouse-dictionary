 "反乱": "انتفاضة",
 "反乱分子": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "反乱者": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "反体制": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "反体制側": "مناهض للمؤسسة (معارض للمؤسسة الحاكمة)\nمثال: ظهرت وجوه شابة وجديدة في أعضاء المجلس الجديد، مع تنحي السياسيين المخضرمين في كل من المعسكر المناهض للمؤسسة والموالي لبكين",
 "反体制派": "مُنْشَقّ",
 "反作用": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "反例": "مِثَال مُعَاكِس, مِثَال مُضَادّ",
 "反別": "رقعة أرض, مساحة أرض (مساحة من الأرض تستخدم لغرض معين (مثل البناء أو الزراعة))\nمثال: أراد بعض المساحة من الأرض للبناء عليها",
 "反則": "مُخَالَفَة / اِنْتِهَاك",
 "反則プレー": "خطأ ((بيسبول) فشل لاعب مدافع في إخراج الخصم عندما كان اللعب العادي كافياً لذلك)",
 "反則負け": "إِقْصَاء",
 "反則金": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "反力": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "反動": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "反動タービン": "توربين تفاعلي, عنفة رد الفعل (توربين بشفرات مرتبة لتوليد عزم الدوران من الانخفاض التدريجي لضغط البخار من المدخل إلى المخرج)",
 "反動主義": "رجعية (التوجه السياسي للرجعيين)",
 "反動主義者": "رجعي",
 "反動家": "رجعي",
 "反動形成": "تكوين عكسي ((في الطب النفسي) آلية دفاع يطور فيها الشخص بغير وعي مواقف وسلوكاً معاكساً للرغبات والدوافع المكبوتة غير المقبولة وتعمل على إخفائها)\nمثال: أخلاقه الصارمة هي مجرد تكوين عكسي لإخفاء دافعه الجنسي",
 "反動減": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "反動的": "رجعي",
 "反動革命": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "反古にする": "خُرْدَة / يتخلى, نبذ / شجار / مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "反古籠": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "反吐": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "反吐が出る": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "反問": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر)",
 "反定立": "تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً",
 "反対": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / عَكَسَ",
 "反対側": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "反対尋問": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر)",
 "反対弁論": "رد المدعى عليه الثاني (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تفنيد, نقض (الفعل الكلامي للدحض عن طريق تقديم حجة أو ادعاء معاكس)\nمثال: اليوم هناك برد.",
 "反対意見": "رأي مخالف (رأي يختلف مع تصرف المحكمة في القضية)",
 "反対投票": "استبعاد, حظر (فعل استبعاد شخص ما عن طريق تصويت سلبي أو حق النقض)",
 "反対票": "بَل (أصابه ماء كثير أو سائل آخر مشابه للماء؛ الشخصُ الشيءَ: صبّ عليه ماء كثير أو غمس الشيء في الماء)\nمثال: ليس أنا ، بل أنت!",
 "反対給付": "واحدة بواحدة",
 "反対者": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه",
 "反対訊問": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر)",
 "反対語": "عَكْس / نَقِيض",
 "反対貿易風": "رياح عكسية تجارية (رياح تهب من الغرب إلى الشرق وتقع فوق الرياح التجارية في المناطق المدارية)",
 "反対陣営": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "反射": "اِنْعِكَاس, عَكْس / مُنْعَكَس",
 "反射代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "反射作用": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "反射性": "تأمل, تفكر (القدرة على التفكير الهادئ أو التأمل) / انعكاس, انعكاسية (القدرة على عكس الأشعة) / اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما) / انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "反射指示": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه) / انْعِكَاسِيَّة (العلاقة الإحالية بين ضمير انعكاسي ومرجعه)",
 "反射指示代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "反射望遠鏡": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反射材": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反射板": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反射波": "صَدًى",
 "反射炉": "فرن عاكس (فرن يتم فيه تسخين المواد المعالجة بشكل غير مباشر بواسطة اللهب الموجه إلى سقف وجدران الفرن)",
 "反射率": "اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما)",
 "反射療法": "ريفلعكسولوجي, علم المنعكسات (تدليك لتخفيف التوتر عن طريق ضغط الأصابع؛ يعتمد على الاعتقاد بوجود نقاط انعكاسية على القدمين واليدين والرأس متصلة بكل جزء من الجسم) / علم المنعكسات (دراسة الفعل المنعكس وعلاقته بسلوك الكائنات الحية)",
 "反射的": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه) / اِنْعِكَاسِيّ, تِلْقَائِيّ (بِدُونِ إِرَادَةٍ أَوْ تَحَكُّمٍ وَاعٍ) / ضمير انعكاسي (ضمير شخصي يدل على أن فعل الفاعل يؤثر على الفاعل نفسه)",
 "反射的に": "انعكاسياً, بشكل لا إرادي (بطريقة انعكاسية؛ بواسطة ردود الفعل)\nمثال: أجابت بشكل لا إرادي",
 "反射神経": "مُنْعَكَس",
 "反射能": "البَيَاض, القُدْرَة العَاكِسَة (نسبة الضوء المنعكس إلى الضوء الساقط)",
 "反射角": "زاوية الانعكاس (الزاوية بين شعاع منعكس وخط عمودي على السطح العاكس عند نقطة السقوط)",
 "反射運動": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "反射鏡": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة العينية) / عاكس (جهاز يعكس الإشعاع)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反徒": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "反復": "تَكْرَار, إِعَادَة / إعادة إنتاج, استنساخ (فعل عمل نسخ) / تكرار التجربة (تكرار تجربة لاختبار صحة استنتاجها) / مجسم, نسخة مطابقة (نسخة ليست الأصل؛ شيء تم نسخه) / تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير / عَوْدِيَّة",
 "反復性": "تكرار (إطناب ناتج عن التكرار المفرط) / مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية",
 "反復的": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية",
 "反応": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "反応中間体": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "反応性": "استجابة, تفاعلية (الاستجابة للتحفيز) / تفاعلية, نشاط كيميائي (القابلية السريعة للتغير الكيميائي)",
 "反応時間": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "反応炉": "مُفَاعِل",
 "反意語": "عَكْس / نَقِيض",
 "反感": "مشاعر مناهضة",
 "反戦主義": "سَلَامِيَّة, سِلْمِيَّة",
 "反戦主義者": "مُسَالِم / مُسَالِمَة",
 "反戦運動": "حركة مناهضة للحرب (حملة ضد دخول الحرب أو استمرارها)",
 "反抗": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "反抗的": "عَاصٍ",
 "反撃": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "反攻": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة من قوة مهاجمة)",
 "反故にする": "خُرْدَة / يتخلى, نبذ / شجار / مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "反故籠": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "反数": "نَظِير جَمْعِيّ ((الرياضيات) أحد زوجين من الأعداد مجموعهما صفر؛ النظير الجمعي لـ -5 هو +5)",
 "反映": "اِنْعِكَاس, عَكْس / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "反時計回り": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "反様": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "反流": "تَيَّار مُعَاكِس (أفعال معاكسة لنشاط المجموعة الرئيسي) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)\nمثال: عطلت التيارات السياسية المعاكسة المؤتمر",
 "反照": "اِنْعِكَاس, عَكْس",
 "反照代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "反物": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "反物質": "مَادَّة مُضَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "反発": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "反発作用": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / استهجان, نفور شديد (نفور شديد) / تنافر, قوة تنافر (القوة التي تتنافر بها الأجسام عن بعضها البعض)",
 "反発力": "رجوعية, مرونة (الخاصية الفيزيائية للمادة التي تمكنها من العودة إلى شكلها أو موضعها الأصلي بعد تشوه لا يتجاوز حد المرونة) / رجوعية, مرونة (حدوث ارتداد أو رجوع للخلف)",
 "反目": "عَدَاوَة",
 "反省": "اِنْعِكَاس, عَكْس / نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "反磁性": "دايامغناطيسية, مغناطيسية معاكسة (ظاهرة تظهرها مواد مثل النحاس أو البزموت التي تصبح ممغنطة في مجال مغناطيسي بقطبية معاكسة للقوة المغناطيسية؛ وعلى عكس الحديد يتم نفرها قليلاً بواسطة…)",
 "反社": "جَرِيمة مُنَظَّمة",
 "反社会": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها) / مُعَادٍ لِلاخْتِلَاط (يتجنّب الاتّصال بالآخرين وينفر منه)",
 "反社会性パーソナリティ症": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "反社会性パーソナリティ障害": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "反社会性人格障害": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة دون شعور بالذنب)",
 "反社会的": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها) / مُعَادٍ لِلاخْتِلَاط (يتجنّب الاتّصال بالآخرين وينفر منه)",
 "反社会的勢力": "جَرِيمة مُنَظَّمة",
 "反米": "معاد لأمريكا (يعارض الولايات المتحدة وسياساتها) / مُعَادٍ لِأَمْرِيكَا (شخص يعارض الولايات المتحدة وسياساتها)",
 "反粒子": "جُسَيْم مُضَادّ (جسيم له نفس كتلة جسيم آخر ولكن له قيم معاكسة لخصائصه الأخرى؛ يؤدي تفاعل الجسيم وجسيمه المضاد إلى الفناء وإنتاج طاقة إشعاعية)",
 "反義語": "عَكْس / نَقِيض",
 "反舌音": "مُرْتَدّ",
 "反芻": "اجترار / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "反芻動物": "مُجْتَرّ / مُجْتَرّ, مُجْتَرَّات",
 "反芻類": "مُجْتَرّ / مُجْتَرّ, مُجْتَرَّات",
 "反英雄": "بطل مزيف, بطلة مزيفة",
 "反覆": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / عَكَسَ / تَكْرَار, إِعَادَة",
 "反訳": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / كَرْشَنَة, نَقْصَوَة",
 "反訴": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق)",
 "反証": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما)",
 "反語": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء / اِسْتِفْهَام مَجَازِيّ",
 "反語的": "سَاخِر, مُفَارِق (يَتَّسِمُ بِالتَّبَايُنِ بَيْنَ مَا هُوَ مُتَوَقَّعٌ وَمَا يَحْدُثُ فِعْلًا) / تَهَكُّمِيّ, سَاخِر (فكاهيّ بأسلوب ساخر أو هازئ)",
 "反論": "اِعْتَرَاض / اِعْتِرَاض",
 "反賊": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "反足細胞": "نَقِيض (المقابل المباشر)\nمثال: الهدوء: نقيض الانشغال المركز",
 "反跳": "ارتداد, انعكاس (حركة العودة من الارتطام) / ارتداد (الرجوع الخلفي المفاجئ للبندقية عند إطلاقها)",
 "反軍": "مُتَمَرِّد, ثَائِر",
 "反転": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية",
 "反転攻勢": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة من قوة مهاجمة)",
 "反逆": "خِيَانَة",
 "反逆人": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "反逆分子": "مُرْتَدّ, مُنْشَقّ (تَخَلَّى عَنْ قَضِيَّة أَوْ مَبْدَأ) / خَائِن, مُرْتَدّ (شخص غير مخلص يخون أو يتخلى عن قضيته أو دينه أو حزبه السياسي أو صديقه، إلخ) / مرتد, منشق (شخص يتمرد ويصبح خارجاً عن القانون)",
 "反逆罪": "خِيَانَة",
 "反逆者": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "反間": "مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات الاستخبارات المعادية أو الأفراد المنخرطون في التجسس أو التخريب أو التخريب…)",
 "反陽子": "نَقِيض البُرُوتُون (بروتون غير مستقر سالب الشحنة؛ الجسيم المضاد للبروتون)",
 "反面": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَكَسَ",
 "反面に": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "反革命": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "反響": "صَدًى / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "反響定位": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "反響言語": "ترديد مرضي, مصاداة ((طب نفسي) تكرار ميكانيكي وبلا معنى لكلمات شخص آخر (كما في الفصام)) / إيكولاليا, محاكاة لفظية (تكرار الرضيع للأصوات التي ينطق بها الآخرون)",
 "反駁": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "反骨の精神": "عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "収まり": "نَتِيجَة / رَصِيد",
 "収まりが悪い": "فِي غَيْرِ مَحَلِّهِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "収まる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / أَهْدَأَ, هَدَّأَ / رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "収む": "كَرَّسَ, قَدَّمَ / توفر / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة / خَزَنَ (حفظ، إدخر، أودع في مخزن) / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "収め": "النِهاية",
 "収める": "وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / تضمن / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "収れん": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم) / تجميع, جمع (فعل جمع شيء ما معاً) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب)) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر) / تَقَارُب (اقتراب متسلسلة لا نهائية من حد محدود) / التقاء, تقارب (حدوث التقاء شيئين أو أكثر)\nمثال: لم يكن هناك تداخل بين مقترحاتهم",
 "収れん剤": "مُقَلِص",
 "収入": "دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "収入印紙": "طابع إيرادات, طابع مالي (قطعة صغيرة من الورق اللاصق توضع على شيء لإظهار أنه تم دفع ضريبة حكومية)",
 "収入関税": "تعريفة إيرادية (تعريفة تفرض لزيادة الإيرادات)",
 "収去": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "収取": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "収受": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "収奪": "سَالِب, نَاهِب (يأخذ ما يريده بالقوّة) / سلب, نهب (فعل سرقة أشياء ثمينة من مكان ما)\nمثال: نهب البارثينون",
 "収容": "إِقَامَة / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "収容力": "سِعَة",
 "収容所": "مُعَسْكَر اِعْتِقَال",
 "収容者": "سَاكِن, سَاكِنَة",
 "収容能力": "سِعَة",
 "収容設備": "إِقَامَة",
 "収差": "اِنْزِيَاغ / زَيْغ (زَيَّغَ (زيغه): عوجه وأقام زيغه وأصلح عوجه)",
 "収得": "اكتساب, حصول (فعل الحصول على شيء ما)\nمثال: حسدت موهبته في الاكتساب",
 "収拾": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "収拾がつかない": "خارج السيطرة (خرج عن نطاق السيطرة)\nمثال: خرجت أعمال الشغب عن السيطرة",
 "収拾が付かない": "خارج السيطرة (خرج عن نطاق السيطرة)\nمثال: خرجت أعمال الشغب عن السيطرة",
 "収攬": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "収斂": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم) / تجميع, جمع (فعل جمع شيء ما معاً) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب)) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر) / تَقَارُب (اقتراب متسلسلة لا نهائية من حد محدود) / التقاء, تقارب (حدوث التقاء شيئين أو أكثر)\nمثال: لم يكن هناك تداخل بين مقترحاتهم",
 "収斂剤": "مُقَلِص",
 "収束": "نَتِيجَة / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب)) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر) / تَقَارُب (اقتراب متسلسلة لا نهائية من حد محدود) / التقاء, تقارب (حدوث التقاء شيئين أو أكثر)\nمثال: لم يكن هناك تداخل بين مقترحاتهم / تبيؤر, تركيز البؤرة (عملية وضع الشيء في البؤرة) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "収束レンズ": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "収獲": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "収率": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "収用": "نزع الملكية (الإخراج من يد المالك (خاصة أخذ الممتلكات من قبل السلطة العامة))",
 "収益": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً",
 "収益化": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "収益報告": "بيان الدخل, تقرير الأرباح (بيان مالي يعطي نتائج التشغيل لفترة محددة)",
 "収益性": "مَرْدُودِيَّة",
 "収益率": "مُعَدَّل العَائِد (المبلغ المُعاد لكل وحدة زمنية معبراً عنه كنسبة مئوية من التكلفة)",
 "収益金": "دَخْل (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "収監": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "収着": "امتزاز, تشارب (العملية التي تأخذ فيها مادة مادة أخرى أو تمسك بها (سواء عن طريق الامتصاص أو الامتزاز))",
 "収税": "تحصيل الضرائب, جباية الضرائب (جمع الضرائب)",
 "収税人": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "収税吏": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "収穫": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "収穫感謝祭": "عيد الشكر (عيد يحتفل به في أمريكا الشمالية كشكر للنعم والحصاد)",
 "収穫期": "حصاد, موسم الحصاد (الموسم المخصص لجمع المحاصيل)",
 "収穫物": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "収穫逓減の法則": "قانون تناقص العوائد (قانون يؤكد أن الاستمرار بعد الوصول إلى مستوى معين من الأداء سيؤدي إلى انخفاض في الفعالية)",
 "収穫高": "مَحْصُول / حَوْصَلة",
 "収納": "إيداع, تخزين (الإيداع في مستودع) / تخزين (فعل تخزين شيء ما) / تخزين (المشروع التجاري لتخزين البضائع والمواد) / ذاكرة, ذاكرة حاسوب (جهاز ذاكرة إلكتروني)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / إِيصَال / جني, حصاد (جمع المحصول الناضج)",
 "収納スペース": "مساحة تخزين (المنطقة في أي هيكل توفر مساحة للتخزين)",
 "収納室": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "収納家具": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "収納容器": "صُرَّة, طَرْد / رِزْمَة",
 "収納庫": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "収納箱": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "収縮": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "収縮期": "اِنْقِبَاض",
 "収縮筋": "ثعبان عاصر (أي من الثعابين الكبيرة غير السامة المتنوعة التي تقتل فريستها عن طريق سحقها في لفائفها)",
 "収蔵": "صومعة, مخزن حبوب (مستودع للحبوب المدروسة أو علف الحيوانات)",
 "収蔵品": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "収蔵庫": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "収覧": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "収賄罪": "رَشْوَة / رشوة",
 "収載": "شَامِل",
 "収量": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "収金": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "収録": "تَسْجِيل",
 "収集": "تجميع, جمع (فعل جمع شيء ما معاً) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / جمع القمامة, رفع النفايات (جمع وإزالة القمامة)\nمثال: 私たちのゴミは週３回収集されます。 — تُجمع القمامة ثلاثة مرات في الأسبوع.",
 "収集品": "مُسْتَحَقّ التَّحْصِيل, وَاجِب الدَّفْع (خاضع للدفع أو يستلزمه حسب ما هو محدَّد) / مقتنيات (أشياء تعتبر جديرة بالجمع (ليس بالضرورة أن تكون قيمة أو أثرية))",
 "収集家": "مجمّع (القطب الكهربائي في الترانزستور الذي يغادر من خلاله التدفق الأساسي للحاملات المنطقة بين الأقطاب) / فوهة تجميع (فوهة جمعت مواد كونية ارتطمت بالأرض) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب)) / جامع, مُجَمِّع (شخص يجمع الأشياء)",
 "叔母": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "叔母さん": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "叔母ちゃん": "خالة, عمة (أخت الأب أو الأم؛ زوجة العم أو الخال)",
 "叔父": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "叔父さん": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم. / شَيْخ, عَجُوز",
 "叔父ちゃん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "叔父上": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "叔父御": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "叔父様": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "叔父者人": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "叔父貴": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "取": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة / استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "取っ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "取っかえ引っかえ": "وَاحِدًا تِلْوَ الآخَرِ",
 "取っつきにくい": "صَعْب المَنَال, يَتَعَذَّر الوُصُول إِلَيْه (لا يمكن الوصول إليه إلا بصعوبة كبيرة أو لا يمكن الوصول إليه إطلاقاً) / بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "取っつきやすい": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه) / سَهْل التَّعَامُل, وَدُود (يسهل التعامل معه أو التحدّث إليه؛ ودود ومُؤانس) / سَهْل المَنَال (يمكن الحصول عليه بسهولة) / سَهْلُ القِرَاءَة, مَيْسُورُ الفَهْم (يمكن قراءته وفهمه بسهولة)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っつき易い": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه) / سَهْل التَّعَامُل, وَدُود (يسهل التعامل معه أو التحدّث إليه؛ ودود ومُؤانس) / سَهْل المَنَال (يمكن الحصول عليه بسهولة) / سَهْلُ القِرَاءَة, مَيْسُورُ الفَهْم (يمكن قراءته وفهمه بسهولة)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っつく": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "取っておき": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取ってくる": "جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取ってつけたよう": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "取って付けたよう": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "取って付けた様": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع) / غير طبيعي, مخالف للطبيعة (غير متوافق مع الطبيعة أو محدد بها؛ مخالف للطبيعة) / شاذ, غير طبيعي (ليس طبيعياً؛ ليس نموذجياً أو معتاداً أو منتظماً أو مطابقاً لمعيار)\nمثال: موت غير طبيعي",
 "取って代わる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "取って参る": "جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取って来る": "جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取って置き": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取って返す": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "取って食う": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "取っとき": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取っ付き": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "取っ付きにくい": "صَعْب المَنَال, يَتَعَذَّر الوُصُول إِلَيْه (لا يمكن الوصول إليه إلا بصعوبة كبيرة أو لا يمكن الوصول إليه إطلاقاً) / بَعِيد المَنَال, مُتَعَذَّر الحُصُول عَلَيْه (لا يمكن الحصول عليه أو الوصول إليه)",
 "取っ付きやすい": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه) / سَهْل التَّعَامُل, وَدُود (يسهل التعامل معه أو التحدّث إليه؛ ودود ومُؤانس) / سَهْل المَنَال (يمكن الحصول عليه بسهولة) / سَهْلُ القِرَاءَة, مَيْسُورُ الفَهْم (يمكن قراءته وفهمه بسهولة)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っ付き易い": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه) / سَهْل التَّعَامُل, وَدُود (يسهل التعامل معه أو التحدّث إليه؛ ودود ومُؤانس) / سَهْل المَنَال (يمكن الحصول عليه بسهولة) / سَهْلُ القِرَاءَة, مَيْسُورُ الفَهْم (يمكن قراءته وفهمه بسهولة)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っ付く": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "取っ手": "مِقْبَض",
 "取っ払う": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取っ捕まえる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "取っ掛かり": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "取っ換え引っ換え": "وَاحِدًا تِلْوَ الآخَرِ",
 "取っ替え引っ替え": "وَاحِدًا تِلْوَ الآخَرِ",
 "取っ組み合い": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة",
 "取っ組む": "عَالَجَ",
 "取っ置き": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取らす": "مَنَحَ / مِنْحة",
 "取り": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة",
 "取りあえず": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "取りかかる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "取りこめる": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "取りさばく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "取りさる": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取りざた": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "取りそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "取りそろえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "取りたて": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / طَازَج, طَازَة / عَذْب",
 "取りつく": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة / بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "取りつぶす": "تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "取りとめる": "تَيَقَّنَ, تَثَبَّتَ",
 "取りなし": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "取りなす": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "取りにくい": "صَعْب",
 "取りのける": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取りまとめ": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "取りまとめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "取りも直さず": "أي, تحديداً (كما يلي (تستخدم للتفصيل))",
 "取りやめ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "取りやめる": "أَلْغَى, أَبْطَلَ",
 "取り上げ": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / قَبَالَة",
 "取り上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / تَبَنَّى / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / صَادَرَ",
 "取り下げ": "اِنْسِحَاب",
 "取り下げる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه.",
 "取り下ろす": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "取り交わす": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "取り仕切る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "取り付く": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق) / غارفة محارية (دلو جرف بمفاصل تشبه صدفة المحار) / خُطَّاف إرساء, مرساة خطافية (أداة تتكون من عدة خطافات للإمساك والتشبث؛ غالباً ما تُرمى بحبل)\nمثال: كان بينهما مصارعة عنيفة / بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "取り付く島がない": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه) / صَعْب المِرَاس, مُتَحَفِّظ (لا يشجع على الألفة؛ متحفظ)\nمثال: مدير تنفيذي يصعب الوصول إليه (متحفظ)",
 "取り付く島もない": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه) / صَعْب المِرَاس, مُتَحَفِّظ (لا يشجع على الألفة؛ متحفظ)\nمثال: مدير تنفيذي يصعب الوصول إليه (متحفظ)",
 "取り付け": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات)) / مرفق, منشأة (مبنى أو مكان يوفر خدمة معينة أو يستخدم لصناعة معينة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: استغرق تركيب الهاتف بضع دقائق فقط / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "取り付ける": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "取り付け工事": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات)) / مرفق, منشأة (مبنى أو مكان يوفر خدمة معينة أو يستخدم لصناعة معينة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "取り付け騒ぎ": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "取り代": "جُزْء",
 "取り入る": "تَمَلَّقَ",
 "取り入れ": "جني, حصاد (جمع المحصول الناضج)",
 "取り入れる": "تَبَنَّى / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "取り入れ口": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس) / ابتلاع, استهلاك (عملية إدخال الطعام إلى الجسم عن طريق الفم (مثل الأكل)) / مأخذ, مدخل (فتحة يتم من خلالها إدخال السائل إلى أنبوب أو حاوية)",
 "取り出しボタン": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "取り出し口": "فتحة إدخال (شق صغير (لإدخال عملة معدنية أو إيداع البريد)) / آلة القمار, سلوت (آلة قمار تستخدم للمقامرة) / شق, فتحة ((حاسوب) مقبس في الحاسوب المصغر يقبل لوحة دوائر إضافية) / خَانَة, مَوْقِع نَحْوِيّ (موقع في بناء لغوي نحوي يمكن فيه تبادل مجموعة متنوعة من الوحدات البديلة)\nمثال: وضع ربع دولار في الفتحة",
 "取り出す": "أَخْرَجَ / جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取り分け": "خُصُوصًا, خَاصَّةً\nمثال: とりわけ子供たちは愛情を必要とする。 — و فوق كل شيء، يحتاج الأطفال إلى الحب.",
 "取り分けて": "خُصُوصًا, خَاصَّةً",
 "取り分ける": "وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "取り切る": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "取り前": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "取り去る": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取り取り": "مُخْتَلِف, مُتَنَوَّع",
 "取り口": "أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "取り合い": "تَهَافَتَ",
 "取り合う": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "取り合わせ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "取り回し": "تداول باليد, معالجة (فعل اللمس باليدين (أو الاستخدام الماهر لليدين) أو باستخدام وسائل ميكانيكية) / مناولة (الحمل أو النقل أو التسليم اليدوي (أو الميكانيكي) أو العمل مع شيء ما) / تعامل, معالجة (إدارة شخص ما أو شيء ما)\nمثال: التعامل مع السجناء / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "取り回す": "مِقْبَض",
 "取り囲む": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "取り壊し": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "取り壊す": "هَدَمَ (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "取り外し": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "取り外し可能": "قَابِلٌ لِلطَّمْس (يمكن محوه أو إزالته بالكامل) / قابل للإزالة, قابل للعزل (يمكن إزالته أو أخذه بعيداً أو صرفه)\nمثال: سلك قابل للفك",
 "取り寄せる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "取り崩す": "هَدَمَ (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "取り巻き": "أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "取り巻き連中": "شَرِيك, شَرِيكَة",
 "取り巻く": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "取り広げる": "كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "取り引き": "محضر, مداولات (وصف مكتوب لما دار في اجتماع ما)",
 "取り引き先": "زَبُون, عَمِيل",
 "取り得": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة / كَسَبَ",
 "取り急ぎ": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "取り急ぐ": "عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "取り憑く": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "取り成し": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "取り成す": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "取り戻す": "شُفِيَ, بَرِئَ",
 "取り所": "جَدَارَة",
 "取り手": "مُسْتَلِم, مُسْتَلِمَة",
 "取り払い": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取り払う": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / هَدَمَ (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "取り扱い": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "取り扱い店": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取り扱い店舗": "قَاسِم / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取り扱い所": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "取り扱い説明書": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "取り扱う": "مِقْبَض / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / عَالَجَ / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "取り押さえる": "إِسْتَوْلَى عَلَى / طَوَّعَ, تَغَلَّبَ عَلَى",
 "取り拉ぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "取り持ち": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / تَرْفِيه, تَسْلِيَة",
 "取り持つ": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر / عَالَجَ",
 "取り捌く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "取り捨てる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "取り掛かる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "取り揃える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "取り換える": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "取り損なう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "取り損ねる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "取り敢えず": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "取り替え": "مُبَادَلَة",
 "取り替えっこ": "مُبَادَلَة",
 "取り替える": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "取り木": "طَبَقَة",
 "取り柄": "مَاثَلَ / اِسْتَحَقَّ, اِسْتَأْهَلَ / اِسْتَحَقَّ / قِيمَة",
 "取り極める": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "取り次ぎ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَادّ, مُجِيب (يقوم بالرد أو الإجابة) / وَسِيلَةُ النَّقْل",
 "取り次ぐ": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي. / بَلَّغَ, أَبْلَغَ / مِقْبَض",
 "取り止め": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال) / اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "取り止める": "أَلْغَى, أَبْطَلَ",
 "取り決め": "قَرَار, تَصْمِيم",
 "取り決める": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "取り沙汰": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "取り消し": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "取り消す": "أَلْغَى, أَبْطَلَ",
 "取り混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "取り潰す": "تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "取り留め": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "取り留めのない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "取り留めもない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "取り留める": "تَيَقَّنَ, تَثَبَّتَ",
 "取り直し": "إعادة اللعب, مباراة عودة (شيء (خاصة لعبة) يتم لعبه مرة أخرى)",
 "取り立て": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / طَازَج, طَازَة / عَذْب",
 "取り立てて": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "取り立てる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / شَدَّدَ (الشيءَ: قَوَّاه وجعله شديدًا؛ في الأمر: بالغ فيه)",
 "取り組": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / جولة قتال, نزال (مسابقة أو قتال (خاصة بين الملاكمين أو المصارعين)) / نوبة مرضية, وعكة (فترة من المرض) / جولة, دور ((رياضة) قسم من اللعبة يكون خلاله فريق واحد في وضع الهجوم)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام",
 "取り組み": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد . / حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / جولة قتال, نزال (مسابقة أو قتال (خاصة بين الملاكمين أو المصارعين)) / نوبة مرضية, وعكة (فترة من المرض) / جولة, دور ((رياضة) قسم من اللعبة يكون خلاله فريق واحد في وضع الهجوم)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام",
 "取り組む": "عَالَجَ",
 "取り結ぶ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "取り締まり": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "取り締まる": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / ضَبَطَ",
 "取り繕う": "أَصْلَحَ",
 "取り纏め": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "取り纏める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "取り置き": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "取り置く": "مُرَبًّى / حَافَظَ / مَسَكَ, مسك",
 "取り舵": "مِينَاء, مينا / مَنْفَذ / كَيَّفَ, غَيَّرَ",
 "取り落とす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "取り計らい": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "取り計らう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "取り説": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "取り調べ": "تَحْقِيق",
 "取り調べる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "取り調べ官": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "取り越し苦労": "فرط القلق, قلق مفرط (قلق زائد عن الحد)\nمثال: 君はいつも取り越し苦労をしている。 — دائماً ما تتوقع حدوث المشاكل.",
 "取り込み": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك. / استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية)",
 "取り込み事": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "取り込み詐欺": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "取り込む": "تَبَنَّى / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / غَشَّ, جَدَعَ",
 "取り返し": "شِفَاء, تَعَافِي",
 "取り返す": "شُفِيَ, بَرِئَ",
 "取り逃がす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "取り逃す": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "取り違え": "التباس, خلط (خطأ ناتج عن اعتبار شيء مكان شيء آخر)\nمثال: غير اسمه لتجنب الخلط مع الخارج عن القانون سيئ السمعة / سُوء فَهْم",
 "取り違える": "أَسَاءَ الْفَهْم",
 "取り鎮める": "صَامِت, هَادِئ",
 "取り除く": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取り除ける": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "取り集め": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "取り集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "取り離す": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "取り難い": "صَعْب",
 "取る": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف. / تَبَنَّى",
 "取るに足らない": "تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "取るに足りない": "تافِه",
 "取れたて": "طَازَج, طَازَة / عَذْب",
