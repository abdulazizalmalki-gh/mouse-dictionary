 "共聴": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع.",
 "共著": "تَعَاوُن مُشْتَرَك, عَمَل مُشْتَرَك (فعل العمل المشترك)\nمثال: عملوا إما بشكل تعاوني أو بشكل مستقل",
 "共著者": "شَرِيك, مُتَعاوِن (شريك في نشاط أو مسعى أو مجال ذي اهتمام مشترك)\nمثال: كان الموسيقي وكاتب الليبريتو متعاونين",
 "共融": "خليط أصهري, يوتكتيك (خليط من المواد له الحد الأدنى من نقطة الانصهار)",
 "共観福音書": "الأناجيل الإزائية, الأناجيل المتناظرة (الأناجيل الثلاثة الأولى التي تصف أحداث حياة المسيح من وجهة نظر متشابهة)",
 "共謀": "دَسِيسَة",
 "共謀罪": "دَسِيسَة",
 "共謀者": "متآمر (عضو في مؤامرة)",
 "共起": "تزامن, تصادف (الخاصية الزمنية لحدوث شيئين في نفس الوقت)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "共通": "شَائِع",
 "共通化": "توحيد المعايير, معايرة (فعل فحص أو تعديل دقة أداة قياس (بالمقارنة مع معيار))\nمثال: احتاج مقياس الحرارة إلى معايرة",
 "共通因数": "عَامِل مُشْتَرَك, قَاسِم مُشْتَرَك (عدد صحيح يقسم عددين (أو أكثر) آخرين بالتساوي)",
 "共通性": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة…)\nمثال: سامي خطر للمجتمع.",
 "共通感覚": "اَلْحِسّ السَّلِيم",
 "共通言語": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "共通認識": "اَلْحِسّ السَّلِيم",
 "共通語": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة. / معيرة لغة",
 "共通部分": "مُفْتَرَق, تَقَاطُع",
 "共通集合": "مُفْتَرَق, تَقَاطُع",
 "共通項": "قاسم مشترك (سمة مشتركة بين جميع أعضاء فئة ما)",
 "共重合体": "بوليمر مشترك (بوليمر يتكون من اثنين أو أكثر من المونومرات المختلفة)",
 "共食い": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "共鳴": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام…) / تَعَاطُف",
 "共鳴り": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام…) / تَعَاطُف",
 "共鳴器": "رنان, مرنان (أي نظام يحدث له رنين)",
 "共鳴板": "رنان, مرنان (أي نظام يحدث له رنين)",
 "共鳴者": "مؤيد, متعاطف (شخص يشاركك مشاعرك أو آرائك ويأمل أن تنجح)",
 "共鳴音": "رنين, صويت (الجودة التي تضفيها غرف الرنين في الحلق والفم والتجاويف الأنفية على أصوات الكلام…) / مُذَكِّرٌ, مُسْتَحْضِرٌ (يستحضر الذاكرة ويثير في الذهن صوراً أو معاني)",
 "兵": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / قُوَّات, عَسْكَرِيَّة / جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي. / جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة…)\nمثال: هل كان في الجيش. / حرب, قتال (شن صراع مسلح ضد عدو)\nمثال: قُتل آلاف الأشخاص في الحرب / جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي. / سَيِّد\nمثال: يبدو زيري أحسن. / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "兵乱": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "兵仗": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "兵児": "شاب (مراهق أو شاب بالغ ذكر)",
 "兵六玉": "أحمق, مغفل (شخص غبي وأحمق)",
 "兵力": "قوة عسكرية, وحدة عسكرية (وحدة تكون جزءًا من خدمة عسكرية ما)\nمثال: أرسل لقيصر قوة قوامها ستة آلاف رجل",
 "兵匪": "قَاطِع طَرِيق",
 "兵卒": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "兵員": "قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)\nمثال: واجهنا جيشًا ذا قوة كبيرة",
 "兵営": "ثُكْنَة, قَشْلَة",
 "兵器": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "兵器工": "صانع أسلحة (مُصنِّع للأسلحة النارية)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير",
 "兵器工場": "تِرْسَانَة",
 "兵器庫": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "兵器廠": "ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "兵団": "فيلق (وحدة جيش تتكون عادة من فرقتين أو أكثر ودعمهم)",
 "兵士": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "兵学": "علوم عسكرية (التخصص الذي يتعامل مع مبادئ الحرب)",
 "兵学校": "أَكَادِيمِيَّةٌ عَسْكَرِيَّة",
 "兵学者": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "兵家": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي.",
 "兵庫": "هْيُوغُو / ترسانة, مخزن أسلحة (مكان يتم فيه تصنيع الأسلحة)\nمثال: غرف من ترسانته الفكرية ليجد إجابة",
 "兵式体操": "تدريب عسكري (التدريب على المسير واستخدام الأسلحة)",
 "兵役": "خِدْمَةٌ عَسْكَرِيَّة",
 "兵役法": "خِدْمَةٌ عَسْكَرِيَّة",
 "兵戈": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "兵曹長": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)",
 "兵法": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة…)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "兵法家": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "兵法者": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "兵火": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)",
 "兵甲": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي. / مَعْرَكَة",
 "兵略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة…)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "兵站": "سَوْقِيَّات, لُوجِسْتِيَّة",
 "兵站学": "سَوْقِيَّات, لُوجِسْتِيَّة",
 "兵站線": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "兵站部": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "兵端": "أعمال عدائية, حرب (القتال؛ أعمال الحرب العلنية)\nمثال: اندلاع الأعمال العدائية",
 "兵粮": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "兵糧": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "兵舎": "ثُكْنَة, قَشْلَة",
 "兵船": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "兵藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "兵術": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة…)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "兵装": "تَسْلِيح",
 "兵長": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "兵隊": "قُوَّات مُسَلَّحَة, قُوَّات / جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في…)\nمثال: غادر ذلك الجندي. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "兵隊人形": "جندي لعبة (دمية تشبه الجندي)",
 "兵隊勘定": "تقاسم الحساب, عشاء هولندي (عشاء حيث يدفع كل شخص ثمن طعامه)",
 "兵革": "مَعْرَكَة / درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "兵馬": "قُوَّات, عَسْكَرِيَّة / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "其": "لِكَيْ, أَنْ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / لِكَيْ, أَنْ / هُوَ",
 "其々": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "其とはなしに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "其のため": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "其のまま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "其の儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "其の実": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "其の後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "其の日暮し": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "其の日暮らし": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "其の時": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "其の様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "其の為": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "其の物": "نَفْسُهُ, نَفْسُهَا",
 "其の癖": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "其の許": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "其の足で": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "其の辺": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "其の道": "عَلَاقَة غَرَامِيَّة",
 "其の際": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "其れこそ": "خُصُوصًا, خَاصَّةً / بِالتَّأْكِيد / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "其れだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其れと": "إِضَافَةً عَلى ذٰلِكَ",
 "其れと無しに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "其れに引き替えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "其れはそうと": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "其れはそうとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "其れまで": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "其れも其のはず": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "其れ丈": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其れ故": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "其れ故に": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "其れ程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "其れ等": "أُولَٰئِكَ, تِلْكَ",
 "其れ者": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير. / غَيْشَا",
 "其れ自体": "لذاته وعينه",
 "其れ自身": "نَفْسُهُ, نَفْسُهَا",
 "其れ迄": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "其儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "其其": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "其処な": "هُنَاكَ",
 "其処許": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "其後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "其文字": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "其田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
