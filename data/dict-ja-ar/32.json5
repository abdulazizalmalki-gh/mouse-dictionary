 "受難日": "الْجُمْعَة الْعَظِيمَة, جُمْعَة الْآلَام",
 "受難節": "الصَّوْم الْأَرْبَعِينِيّ / اَلصَّوْم اَلْكَبِير",
 "受難者": "شُهَدَاء, شَهِيد",
 "受難週": "أسبوع الآلام, الأسبوع المقدس (الأسبوع الذي يسبق عيد الفصح)",
