 "再上映": "إعادة عرض, حلقة مُعادة (برنامج يتم بثه مرة أخرى)\nمثال: تحب مشاهدة الإعادة لمسلسل 'أنا أحب لوسي'",
 "再下付": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "再交付": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "再会": "لَم شَمْل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "再体験": "استعادة التجربة, معايشة مجددة (تكرار لتجربة سابقة (شعورياً))\nمثال: استعادة العاطفة القوية يمكن أن يكون علاجياً",
 "再使用型": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "再保険": "إِعَادَةُ تَأْمِين",
 "再入": "دخول مجدد (فعل الدخول مرة أخرى)",
 "再入可能": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "再再": "كَثِيرًا, غَالِبًا",
 "再出": "عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة",
 "再出発": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "再分配": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "再刊": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "再判定": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي…)",
 "再利用": "إِعَادَةْ تَدْوِير",
 "再利用可能": "قَابِلٌ لِإِعَادَةِ الاِسْتِخْدَام, قَابِلٌ لِلتَّدْوِير (يُمْكِنُ اسْتِخْدَامُهُ مَرَّةً أُخْرَى)",
 "再割当": "إعادة تعيين, إعادة تكليف (التعيين في واجب مختلف)",
 "再創造": "اِسْتِجْمَام",
 "再吟味": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "再命名": "تسمية استدراكية, مصطلح رجعي (كلمة تم تقديمها لأن المصطلح الحالي أصبح غير كافٍ)\nمثال: لم يسمع أحد عن 'الساعات التناظرية' حتى أصبحت الساعات الرقمية شائعة، لذا فإن 'ساعة تناظرية' هي مصطلح رجعي / أنابابتيست, تجديد العماد (حركة بروتستانتية في القرن السادس عشر آمنت بأولوية الكتاب المقدس، وعمدت المؤمنين…)",
 "再商品化": "إِعَادَةْ تَدْوِير",
 "再始動": "اِسْتَأْنَفَ",
 "再婚": "إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى)",
 "再嫁": "إعادة الزواج, زواج ثان (فعل الزواج مرة أخرى)",
 "再定義": "إعادة تعريف (فعل إعطاء تعريف جديد)\nمثال: الكلمات مثل 'محافظ' تتطلب إعادة تعريف دورية",
 "再審": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي…) / فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "再審裁判": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي…)",
 "再導入": "إعادة تقديم (فعل تجديد التقديم)",
 "再工事": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "再帰": "تكرار, عودة (الحدوث مرة أخرى (خاصة على فترات منتظمة))\nمثال: عودة الربيع / عَوْدِيَّة / انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه)",
 "再帰代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "再帰動詞": "فعل مطاوع, فعل منعكس (فعل يقوم فيه الفاعل بعمل موجه نحو نفسه)\nمثال: جملة 'اغتسل' تحتوي على فعل منعكس",
 "再帰性": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه)",
 "再帰熱": "حمى راجعة, حمى ناكسة (تتميز بحمى عالية متكررة وتنتقل عن طريق لدغة القمل أو القراد المصاب؛ تتميز…)",
 "再帰用法": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه)",
 "再帰的": "عَوْدِيّ / اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه)",
 "再帰的定義": "تعريف تكراري ((رياضيات) تعريف لدالة يمكن من خلاله حساب قيم الدالة في عدد محدود من الخطوات)",
 "再度": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "再度確認": "تحقق إضافي, فحص مزدوج (شيء يتحقق من صحة فحص سابق)",
 "再建": "إعادة بناء (البناء مرة أخرى)",
 "再建外科": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "再建手術": "جراحة تجميلية, جراحة ترميمية (جراحة تعنى بالإصلاح العلاجي أو التجميلي للأنسجة)",
 "再建築": "إعادة إعمار, إعادة بناء (نشاط بناء شيء ما مرة أخرى)",
 "再従兄弟": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "再従姉妹": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "再循環": "إِعَادَةْ تَدْوِير",
