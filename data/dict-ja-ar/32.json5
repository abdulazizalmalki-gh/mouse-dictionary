 "免許停止": "رخصة قيادة (رخصة تخول حاملها قيادة مركبة آلية)",
 "免許料": "رسم الترخيص (رسم يُدفع للحكومة مقابل امتياز الترخيص للقيام بشيء ما (مثل بيع الخمور أو ممارسة…)",
 "免許状": "رُخْصَة, تَصْرِيح",
 "免許番号": "رقم التسجيل, رقم الرخصة (الرقم الموجود على لوحة الترخيص والذي يحدد السيارة التي تحمله)",
 "免許証": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة",
 "免訴": "تَبْرِئَة",
 "免責事項": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ)",
 "免責条項": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ)",
 "免責特権": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين…)",
 "免責金額": "قابل للخصم (مقبول كخصم (خاصة كخصم ضريبي))",
 "免責額": "قابل للخصم (مقبول كخصم (خاصة كخصم ضريبي))",
 "免除": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "免黜": "إِقَالَة",
 "兎": "أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى…)\nمثال: زيري لديه أرنب.",
 "兎も角も": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن",
 "兎口": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "兎唇": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "兎小屋": "قفص أرانب (قفص مخصص للأرانب)",
 "兎座": "قُوَاع, أَرْنَب بَرِّيَّة",
 "兎眼": "عين أرنبية, لاقوفثالموس (حالة غير طبيعية لا يمكن فيها إغلاق العين تماماً)",
 "兎結び": "عقدة حلقية (أي من العقد المختلفة المستخدمة لعمل حلقة ثابتة في حبل)",
 "兎耳": "نَمَّام, نَمَّامة",
 "兎角": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً)\nمثال: على أي حال، هو ميت الآن / مُخْتَلِف, مُتَنَوَّع",
 "兎馬": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه…)\nمثال: هن بحاجة لحمار.",
 "児": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / صَغِير, حَدَث / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "児ポ": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "児子": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "児孫": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "児島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "児嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "児玉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "児童": "سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج)\nمثال: سكري الأحداث",
 "児童ポルノ": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "児童会": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "児童保護": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "児童労働": "عمالة الأطفال (مؤنث عَمَّال بمعنى صيغة مبالغة في العَمَل؛ في : هم العُمَّال؛ جمع عَامِل، وقد…)",
 "児童心理学": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "児童性愛": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "児童性愛者": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "児童性的虐待": "إِسَاءَة جِنْسِيَّة لِلْأَطْفَال",
