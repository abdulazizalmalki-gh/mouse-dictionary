 "佳麗": "جَمَال, زَيْن",
 "併せて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار / إِضَافَةً عَلى ذٰلِكَ",
 "併せる": "مُبَارَاة / اِتَّحَدَ, أَلَّفَ / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / قَارَنَ",
 "併催": "مُشْتَرَك",
 "併合": "اِنْدِمَاج",
 "併呑": "ضَمّ, إِلْحَاق (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "併存": "تَعَايُش",
 "併殺": "إخراج مزدوج, لعبة مزدوجة (فعل إخراج لاعبين اثنين في لعبة واحدة)",
 "併発": "تَزَامُن, تَوَافُق (العمل معاً، كوكلاء أو ظروف أو أحداث)\nمثال: الفاصل الزمني الذي يحدد بوابة التزامن قابل للتعديل",
 "併発症": "تَعْقِيد",
 "併結": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "併置": "مجاورة, مقارنة (فعل التموضع بالقرب (أو جنباً إلى جنب))\nمثال: إنه نتيجة تجاور الألوان المتباينة",
 "併設": "مجاورة, مقارنة (فعل التموضع بالقرب (أو جنباً إلى جنب))\nمثال: إنه نتيجة تجاور الألوان المتباينة",
 "佶屈": "ثني, حني (عملية ثني شيء ما) / غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب)\nمثال: كلام غير مفهوم / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب",
 "使": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله.",
 "使い": "قضاء حاجة, مشوار (رحلة قصيرة تُتخذ لأداء مهمة ضرورية) / رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله. / روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة) / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使いかって": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "使いがって": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "使いきる": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "使いこなす": "مِقْبَض",
 "使いこむ": "غَلَّ, اِخْتَلَسَ",
 "使いすぎ": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "使いっぱ": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "使いっ走り": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "使いどころ": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使いの者": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله.",
 "使いまわす": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "使い出す": "جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "使い分けた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "使い切り": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "使い切る": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "使い勝手": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "使い古し": "بَالٍ",
 "使い古す": "هاكني (سلالة مدمجة من خيول العربات)",
 "使い回す": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "使い慣らす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل.",
 "使い所": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使い手": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل. / سَيِّد\nمثال: يبدو زيري أحسن. / مُسْرِف",
 "使い捨": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "使い捨て": "جملة عرضية, كلام عابر (كلمات منطوقة بطريقة عارضة مع تقليل متعمد في التركيز)\nمثال: أرسل المنشور بالبريد إلى جميع المشتركين",
 "使い料": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使い方": "اِسْتِخْدَام / مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري.",
 "使い歩き": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "使い残し": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه)",
 "使い残り": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه)",
 "使い物": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "使い物にならない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "使い番": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله.",
 "使い走り": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "使い込み": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "使い込む": "غَلَّ, اِخْتَلَسَ",
 "使い過ぎ": "استغلال مفرط, استنزاف (الاستغلال إلى حد تناقص العوائد)",
 "使い道": "هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "使い頃": "فِي مُتَنَاوَل اليَد, قَرِيب (سهل الوصول إليه وقريب)",
 "使い魔": "روح مألوفة, قرين (روح (عادة في شكل حيواني) تعمل كمساعد لساحر أو ساحرة)",
 "使う": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使わす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / أَنْعَمَ",
 "使丁": "خَادِم, خَادِمَة",
 "使令": "خَادِم, خَادِمَة",
 "使命": "مُهِمَّة, مَأْمُورِيَّة / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "使命感": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "使命者": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله.",
 "使嗾": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "使女": "خادمة (عاملة منزلية)",
 "使役": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / عِلِّيّ, مُسَبِّب (ينتج تأثيراً)\nمثال: الفقر كعامل مسبب للجريمة",
 "使役動物": "حيوان جر (حيوان يستخدم لسحب الأحمال الثقيلة)",
 "使役犬": "كلب عمل (أي من عدة سلالات من الكلاب القوية الكبيرة عادة التي يتم تربيتها للعمل كحيوانات…)",
 "使徒": "رَسُول (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله.",
 "使徒承伝": "خِلَافَة رَسُولِيَّة, تَسَلْسُل رَسُولِيّ",
 "使徒継承": "خِلَافَة رَسُولِيَّة, تَسَلْسُل رَسُولِيّ",
 "使徒行伝": "أَعْمَال الرُّسُل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال.",
 "使徒言行録": "أَعْمَال الرُّسُل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال.",
 "使用": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使用不可": "غير متوفر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "使用中": "قَيْدَ الاِسْتِخْدَام (يُسْتَخْدَمُ حَالِيًّا)",
 "使用人": "مُوَظَّف, مُوَظَّفَة",
 "使用可能": "مُتَاح (ممكن، مسموح)\nمثال: يجب أن تكون نتائج البحث متاحة للجميع.",
 "使用可能性": "تَوَفُّر",
 "使用域": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "使用感": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)",
 "使用料": "أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة.",
 "使用方法": "إرشادات",
 "使用期限": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "使用条件": "ضَرُورَة",
 "使用権": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "使用法": "إرشادات",
 "使用済み": "مُسْتَعْمَل (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل.",
 "使用済み燃料プール": "عامل الحماية من الشمس (الدرجة التي يحمي بها واقي الشمس البشرة من أشعة الشمس المباشرة)",
 "使用率": "مُعَدَّل الإِشْغَال (النسبة المئوية لجميع الوحدات المؤجرة (كما في الفنادق) التي تكون مشغولة أو مؤجرة…)",
 "使用者": "مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل. / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "使用許可": "رُخْصَة, تَصْرِيح",
 "使用量": "اِسْتِخْدَام",
 "使節": "مَبْعُوث, وَزِير مُفَوَّض",
 "使節団": "مُهِمَّة, مَأْمُورِيَّة",
 "使者": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في…)\nمثال: محمد رسول الله.",
 "使臣": "مَبْعُوث, وَزِير مُفَوَّض",
 "侃々諤々": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "侃侃諤諤": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار)",
 "例": "مِثَال, مَثَل / سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)\nمثال: افتقد لزوجته السابقة. / عَادَة, عُرْف",
 "例え": "مِثَال, مَثَل / تَشْبِيه",
 "例えて言うと": "إن جازَ التَعْبِير (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "例えば": "مَثَلاً, عَلَى سَبِيل الْمِثَال",
 "例えようもない": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن…)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "例える": "شَبَّهَ",
 "例えるなら": "مَثَلاً, عَلَى سَبِيل الْمِثَال",
 "例え様もない": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن…)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "例え様も無い": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن…)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "例え話": "تَمْثِيل",
 "例がない": "هُنَاكَ, يُوجَدُ",
 "例し": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية…)\nمثال: افتقد لزوجته السابقة.",
 "例になく": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "例によって": "كَالْعَادَة, كَالْمُعْتَاد",
 "例に無く": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "例の": "عَادِيّ / السَّابِقُ ذِكْرُهُ\nمثال: もう例の手紙の返事を書いたかい。 — هل رددت على تلك الرسالة بعد؟",
