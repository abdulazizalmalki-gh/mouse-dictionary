 "劣等": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "劣等感": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "劣等複合": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض للإهانة)",
 "劣者": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "助": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / مُسَاعَدَة, إِمْدَاد / رضيع, طفل (طفل صغير جداً (من الولادة إلى سنة واحدة) لم يبدأ بعد في المشي أو الكلام)\nمثال: بدأ الطفل في البكاء مرة أخرى",
 "助かる": "نَجَا",
 "助く": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "助け": "مُسَاعَدَة, إِمْدَاد",
 "助けになる": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "助ける": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها. / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / سَهَّلَ (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "助け上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "助け出す": "أَنْقَذَ, خَلَّصَ / إِنْقَاذ",
 "助け合い": "تَعَاوُن",
 "助け合う": "تَعَاوَنَ",
 "助け守る": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "助け手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "助け舟": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "助け船": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "助っ人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "助兵衛": "شَبَق",
 "助兵衛根性": "فَحْشَاء, فِسْق / جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "助剤": "مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / عامل مساعد, مادة مساعدة (مادة مضافة تعزز فعالية العلاج الطبي)",
 "助力": "مُسَاعَدَة, إِمْدَاد",
