 "双樹": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "双殻類": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / ثنائي الصدفة (يستخدم للرخويات التي لها صدفتان (مثل المحار وغيرها))",
 "双球菌": "مكورة مزدوجة (بكتيريا موجبة الجرام توجد عادة في أزواج)",
 "双璧をなす": "مُنَافِس",
 "双璧を成す": "مُنَافِس",
 "双生": "بلورات توأمية, توائم بلورية ((في علم المعادن) بلورتان متداخلتان تشكل كل منهما صورة مرآة للأخرى)",
 "双生児": "بلورات توأمية, توائم بلورية ((في علم المعادن) بلورتان متداخلتان تشكل كل منهما صورة مرآة للأخرى)",
 "双眸": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "双眼": "بكلتا العينين, ثنائي العينية (متعلق بكلتا العينين)\nمثال: رؤية بكلتا العينين",
 "双眼鏡": "مِنْظَار",
 "双紙": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "双線型": "ثُنَائِيّ الخَطِّيَّة (خَطِّيّ بِالنِّسْبَة لِكُلّ مِن مُتَغَيِّرَيْن أَوْ مَوْضِعَيْن)",
 "双線形": "ثُنَائِيّ الخَطِّيَّة (خَطِّيّ بِالنِّسْبَة لِكُلّ مِن مُتَغَيِّرَيْن أَوْ مَوْضِعَيْن)",
 "双翅類": "ثنائيات الأجنحة (حشرات لها عادة زوج واحد من الأجنحة الوظيفية (الزوج الأمامي) مع اختزال الزوج الخلفي إلى هياكل صغيرة تشبه المقبض وأجزاء فم مهيأة للمص أو اللعق أو الثقب)",
 "双肩": "كَتِف, كِتْف",
 "双胎": "تَوْأَم",
 "双胴船": "طوف, كاتاماران (قارب ذو بدنين متوازيين مرتبطين ببعضهما بسطح واحد)",
 "双臀": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "双葉": "فلقة (ورقة جنينية في النباتات البذرية)",
 "双葉柿": "مجناح الثمر (شجرة من العائلة مجناحية الثمر)",
 "双蹄": "حافر مشقوق, ظلف (حافر مقسم إلى جزأين عند طرفه القاصي (كما في المجترات أو الخنازير)) / حافر مشقوق (علامة الشيطان)",
 "双蹄獸": "مشقوق الحافر, مشقوق الظلف (من أو متعلق بالأظلاف المشقوقة للمجترات أو الخنازير)",
 "双輪車": "ثنائي العجلات, ذو عجلتين (متعلق بالمركبات ذات العجلتين)\nمثال: عربة ذات عجلتين",
 "双魚宮": "بُرْج اَلْحُوت, اَلْحُوت (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "反": "ضِدّ, مُضَادّ / تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً",
 "反し": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم'",
 "反すう動物": "مُجْتَرّ / مُجْتَرّ, مُجْتَرَّات",
 "反する": "نَاقَضَ / اِنْتَهَكَ / عَصَى",
 "反って": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "反ばく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "反らす": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "反らせる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "反り": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / منحنى / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا. / طَيَّة",
 "反り立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "反り舌音": "مُرْتَدّ",
 "反り返り": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "反り返る": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "反る": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / قَلَبَ",
 "反キリスト": "ضِدّ الْمَسِيح, الدَّجَّال",
 "反セム": "مُعَادَاة السَّامِيَّة",
 "反セム主義": "مُعَادَاة السَّامِيَّة",
 "反トラスト法": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "反ファシズム": "مُعَادَاة الْفَاشِيَّة",
 "反ユダヤ主義": "مُعَادَاة السَّامِيَّة",
 "反ユダヤ主義者": "مُعَادٍ لِلسَّامِيَّةِ",
 "反中性子": "نَقِيض النِّيُوتْرُون (الجسيم المضاد للنيوترون)",
 "反中性微子": "نَقِيض النِّيُوتْرِينُو (الجسيم المضاد للنيوترينو)",
