 "見合わす": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / قَارَنَ / شَبَّهَ",
 "見合わせ": "يُعَلِّق / تَعْلِيق",
 "見合わせる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / قَارَنَ / شَبَّهَ",
 "見合結婚": "زَوَاج مُدَبَّر",
 "見向く": "تَلَفَّتَ",
 "見咎める": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "見回す": "تَلَفَّتَ",
 "見回り": "حَارِس",
 "見回る": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "見地": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "見場": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見境": "تَمْيِيْز",
 "見境ない": "مُتَهَوِّر",
 "見境無い": "مُتَهَوِّر",
 "見失う": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "見学": "تَفَقُّد",
 "見学者": "زَائِر / زَائِر, سَائِح",
 "見守る": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "見定める": "تَيَقَّنَ, تَثَبَّتَ",
 "見届ける": "تَيَقَّنَ, تَثَبَّتَ",
 "見廻り": "حَارِس",
 "見廻る": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "見張り": "سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "見張り台": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "見張り所": "نَاطُور",
 "見張り番": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "見張る": "حا َسـِب",
 "見張所": "نَاطُور",
 "見当": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\". / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / حَوَالَيْ, تَقْرِيبًا",
 "見当ちがい": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "見当はずれ": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "見当外れ": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "見当違い": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "見忘れる": "نَسِيَ (لَمْ يَتَذَكَّرْ؛ غَابَ عَنْ الذِهْن)\nمثال: لقد نسي صديقتك.",
 "見性": "وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "見所": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "見抜く": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "見掛ける": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "見損なう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見放す": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "見方": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "見易い": "جَذَّاب",
 "見晴す": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見晴らし": "مَنْظَر, مَشْهَد / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見晴らす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見本": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "見果てぬ": "مُسْتَحِيل",
 "見栄坊": "اِنْتَفَخَ, وَرِمَ",
 "見棄てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "見極める": "تَيَقَّنَ, تَثَبَّتَ",
 "見様": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "見比べる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "見渡し": "مَنْظَر, مَشْهَد",
 "見渡す": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "見渡す限り": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "見澄ます": "تَأَكَّدَ",
 "見物": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة / مُشَاهِد, رَاءٍ",
 "見物人": "مُشَاهِد, رَاءٍ",
 "見物客": "مُشَاهِد, رَاءٍ",
 "見目": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見目形": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見目良い": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "見目麗しい": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "見直し": "تَنْقِيح",
 "見直す": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "見知らぬ": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "見知り": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "見知る": "تَعَرَّفَ",
 "見破る": "اِكْتَشَفَ",
 "見積もり書": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "見積り価格": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "見積り書": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "見積価格": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "見積書": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "見立て": "اِخْتِيَار, خِيَار / تَشْخِيص / رَأْي, نَظَر / مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "見立てる": "اِخْتَارَ / شَخَّصَ (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / شَبَّهَ",
 "見端": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見紛う": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "見縊る": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "見習": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "見習い": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "見習い工": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "見習う": "قَلَّدَ / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "見習工": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "見聞": "مَعْلُومَات, مَعْلُومَة",
 "見聞き": "مَعْلُومَات, مَعْلُومَة",
 "見聞く": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "見舞": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "見舞い": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "見舞う": "حَمْلَة / هَاجَمَ",
 "見舞われる": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "見苦しい": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "見落": "إِغْفَال",
 "見落し": "إِغْفَال",
 "見落す": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見落とし": "إِغْفَال",
 "見落とす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見覚え": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "見覚えがある": "تَعَرَّفَ",
 "見覚えのある": "مَأْلُوف",
 "見覚えのない": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "見覚える": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "見解": "رَأْي, نَظَر",
 "見詰めなおす": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "見詰め直す": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "見誤る": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "見識": "مَنْظَر, مَشْهَد / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "見越す": "تَوَقَّعَ, اِرْتَقَبَ",
 "見辛い": "مُظْلِم",
 "見込み": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / تَنَبَّأَ / تَوَقُّع",
 "見込む": "تَوَقَّعَ, اِرْتَقَبَ / ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "見返": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "見返し": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "見返す": "اِلْتَفَتَ, اِسْتَدَارَ",
 "見返り": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "見返る": "اِلْتَفَتَ, اِسْتَدَارَ",
 "見送る": "مُرَافَقَة / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "見逃し": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見逃す": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見透かす": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "見通し": "مَنْظُور, نَظْرَة / تَنَبَّأَ / تَوَقُّع / نظرة ثاقبة",
 "見通す": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة. / تَوَقَّعَ",
 "見逸れる": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "見遁し": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見過ごす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見過す": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "見違う": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "見違える": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "見遣る": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "見開き": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "見附": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "見附け": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "見限る": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "見離す": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "見難い": "مُظْلِم",
 "見高": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "規制": "تَنْظِيم",
 "規則": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "規則を守る": "خَلَدَ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك) / يَبْقَى\nمثال: خلد ياني إلى النوم.",
 "規則動詞": "فِعْل مُنْتَظِم, فِعْل عَادِيّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "規則正い": "عَادِيّ / مُنْتَظِمٌ",
 "規則正しい": "عَادِيّ / مُنْتَظِمٌ",
 "規則的": "مُمَنْهَج",
 "規定": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم / عَادِيّ / طَبِيعِيّ / إِجْبَارِيّ, إِلْزَامِيّ",
 "規定度": "الحَالَة الطَبِيعِيَّة",
 "規定濃度": "الحَالَة الطَبِيعِيَّة",
 "規定種目": "إِجْبَارِيّ, إِلْزَامِيّ",
 "規律": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "規律正しい": "مُمَنْهَج",
 "規整": "تَنْظِيم",
 "規格": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "規格外": "شَاذّ / اِسْتِثْنَائِيّ",
 "規模": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "規正": "تَصْحِيح",
 "規準": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "規矩": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "規範": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "規約": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "視る": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني. / اِهْتَمَّ, اِعْتَنَى / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "視力": "بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "視力障害": "عَمًى",
 "視姦": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة.",
 "視察": "تَفَقُّد",
 "視察員": "مُفَتِّش, مُفَتِّشَة",
 "視床": "مِهَاد",
 "視床下部": "تَحْت اَلْمِهَاد, وِطَاء (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "視度": "رُؤْيَة",
 "視点": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "視界": "ساحة بصرية",
 "視程": "رُؤْيَة",
 "視線を注ぐ": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "視聴": "مَنْظَر, مَشْهَد / اِهْتِمَام, اِنْتِبَاه / اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "視聴者": "مُشَاهِد, مَشَاهِدَة",
 "視覚": "مَشْهَد / مَنْظَر",
 "視覚的": "بَصَرِيّ",
 "視覚芸術": "فُنُون بَصَرِيَّة (بمعنى الضرب من الشيء والنوع؛ بمعنى بعض الصناعات الراقية التي تحتاج إلى مهارة يحكمها الذوق والمواهب)\nمثال: زيري يحب الفنون.",
 "視認": "مَشْهَد / مَنْظَر",
 "視認性": "رُؤْيَة",
 "視野": "ساحة بصرية",
 "視野に入れる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "視野移動": "طُومَار",
 "覗かせる": "البَرْق",
 "覗き穴": "مَنْوَر, كُوَّة",
 "覗き窓": "مَنْوَر, كُوَّة",
 "覗き魔": "مُتَلَصِّص",
 "覗く": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "覚": "ساتوري",
 "覚え": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "覚えこむ": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "覚えず": "لَاشُعُورِيًّا",
 "覚える": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها. / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم. / تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "覚え書き": "مُذَكِرَة",
 "覚え込む": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "覚せい剤": "مُنَشِّط, مُنَبِّه",
 "覚ます": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "覚めやらぬ": "تَابَعَ, اِسْتَمَرَّ",
 "覚める": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "覚め遣らぬ": "تَابَعَ, اِسْتَمَرَّ",
 "覚悟": "عَزْم, عُزْم / دِقَّة / اِسْتِقَالَة, اِسْتِعْفَاء",
