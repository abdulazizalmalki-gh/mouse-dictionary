 "蘿": "أُشْنَة, طُحْلُب",
 "蘿蔔": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "虎": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / بَبْر (حيوان ضخم مخطط من السّنوريّات. والببر يَختلف عن النَمِر، فالببر مخطط والنمر مرقّط) / نمر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا. / سَكْرَان, ثَمِل (من شرب الخمر حتى سَكِرَ) / سِكِّير, خِمِّير\nمثال: تبدو كأنها سكرانة.",
 "虎の尾を踏む": "لَعِبَ بِالنَّار (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "虎の巻": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / زِرّ",
 "虎子": "قَعَادَة",
 "虎巻": "زِرّ",
 "虎斑木菟": "بومة أذناء",
 "虎柄": "مُخَطَّط",
 "虎疫": "كُولِيرَا, هَيْضَة",
 "虎穴": "عَرِين الْأُسُود (اِسْمٌ لِمَاْوَى الأَسَد)",
 "虎落": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "虎豹": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "虐げられた人々": "مَظْلُوم",
 "虐げられた人人": "مَظْلُوم",
 "虐げる": "اِسْتَضْعَفَ, قَهَرَ",
 "虐め": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا) / تَنَمُّر (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)\nمثال: الإنفصاليون مثل الإرهاب.",
 "虐める": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "虐待": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "虐政": "طُغْيَان, اِسْتِبْدَاد",
 "虐殺": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "虐遇": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "虔しみ": "تَوَاضُع / حِشْمَة",
 "虔み": "تَوَاضُع / حِشْمَة",
 "虔む": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "虚": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / طَقْس, جَوّ / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "虚け": "مُغَفَّل, أَحْمَق",
 "虚け者": "مُغَفَّل, أَحْمَق",
 "虚しい": "فَارِغ / فَرَغَ / عَقِيم",
 "虚しく": "عَبَثًا, سُدًى",
 "虚しくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "虚ろ": "تَجْوِيف / أَجْوَف",
 "虚事": "مُزَيَّف",
 "虚仮": "مُغَفَّل, أَحْمَق",
 "虚偽": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "虚像": "ذريعة",
 "虚妄": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚弱": "ضَعْف",
 "虚心": "مُنْفَتِح",
 "虚心坦懐": "إِفْرَنْجِيّ",
 "虚栄": "غُرُور",
 "虚栄心": "غُرُور",
 "虚構": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "虚無主義": "عَدَمِيَّة",
 "虚脱": "خُمُول / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "虚血": "نقص التروية",
 "虚血性心疾患": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "虚言": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚語": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "虚辞": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚飾": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "虜": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / ضَحِيَّة / أُضْحِيَّة",
 "虜囚": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "號": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / مَقَاس, قِيَاس",
 "虫": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية. / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / تَوَتُّر",
 "虫がいい": "أَنَانِيّ",
 "虫が好かない": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "虫が良い": "أَنَانِيّ",
 "虫けら": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
