 "マタタビ": "أكتينيديا مضلعة, كرمة فضية (كرمة زينة من شرق آسيا لها ثمار صفراء صالحة للأكل وأوراق ذات علامات بيضاء فضية)",
 "マタドール": "قاتل الثور, ماتادور (مصارع الثيران الرئيسي الذي يتم تعيينه للقيام بالتمريرات النهائية وقتل الثور)",
 "マタニティ": "أُمُومَة, حَنَان (صفة امتلاك أو إظهار الحنان والدفء والعاطفة التي تليق بالأم) / أُمُومَة (علاقة القرابة بين النسل والأم) / حمل (حالة الحمل؛ الفترة من الإخصاب حتى الولادة عندما تحمل المرأة جنيناً نامياً في رحمها)\nمثال: أمومة الفتاة جعلتها لا تقدر بثمن في رعاية الأطفال",
 "マタニティー": "أُمُومَة, حَنَان (صفة امتلاك أو إظهار الحنان والدفء والعاطفة التي تليق بالأم) / أُمُومَة (علاقة القرابة بين النسل والأم) / حمل (حالة الحمل؛ الفترة من الإخصاب حتى الولادة عندما تحمل المرأة جنيناً نامياً في رحمها)\nمثال: أمومة الفتاة جعلتها لا تقدر بثمن في رعاية الأطفال",
 "マター": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم.",
 "マターリ": "غَنِيّ / رَائِق, هَادِئُ الطَّبْع (غَيْرُ مُسْتَعْجِلٍ وَمُسْتَرْخٍ)",
 "マダ": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "マダイ": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "マダガスカル": "مَدَغَشْقَر (دولة وجزيرة قبالة ساحل إِفْرِيقِيَا الشرقي؛ اسمها الرسمي: جُمْهُورِيَّة مَدَغَشْقَر، وعاصمتها: أَنْتَانَانَارِيفُو)",
 "マダガスカルご": "الْمَلَغَاسِيَّة الْمَلْغَاسِيَّة, الْمَلَغَاشِيَّة الْمَلْغَاشِيَّة",
 "マダガスカルバタフライフィッシュ": "الْمُحِيط الْهِنْدِيّ",
 "マダガスカル語": "الْمَلَغَاسِيَّة الْمَلْغَاسِيَّة, الْمَلَغَاشِيَّة الْمَلْغَاشِيَّة",
 "マダケ": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "マダニ": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "マダミス": "لغز جريمة قتل (سرد حول جريمة قتل وكيفية اكتشاف القاتل)",
 "マダム": "سَيِّدَة, سَيِّدَتِي / مالكة (امرأة مالكة)",
 "マダラ": "قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي)",
 "マダラシミ": "سمكة النار (تعيش في المناطق الرطبة الدافئة مثل حول الأفران)",
 "マダラタルミ": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "マダラトビエイ": "لخمة النسر المرقطة (لخمة ظهرها مغطى ببقع بيضاء أو صفراء؛ واسعة الانتشار في البحار الدافئة)",
 "マチ": "رقعة, وصلة تقوية (قطعة من المادة تستخدم لتقوية أو توسيع الثوب) / صفيحة تقوية (صفيحة معدنية تستخدم لتقوية الرافدة) / رقعة زردية, وصلة درعية (قطعة من الزرد تغطي مكاناً غير محمي بالدرع الصفائحي)",
 "マチェット": "مِحَشّ",
 "マチェテ": "مِحَشّ",
 "マチェーテ": "مِحَشّ",
 "マチエール": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "マチスモ": "فحولة مفرطة (ذكورة مبالغ فيها)",
 "マチズモ": "فحولة مفرطة (ذكورة مبالغ فيها)",
 "マチネ": "حفلة نهارية, ماتينيه (عرض مسرحي يُقام خلال النهار (خاصة بعد الظهر))",
 "マチネー": "حفلة نهارية, ماتينيه (عرض مسرحي يُقام خلال النهار (خاصة بعد الظهر))",
 "マチュア": "نَاضِج, رَاشِد",
 "マチュピチュ": "ماتْشو بيتْشو",
 "マヂ": "جِدِّيّ / جَدِّيّ, جَادّ",
 "マッカ": "مَكَّة, مَكَّةُ الْمُكَرَّمَة (مدينة مقدسة لدى المسلمين، بها المسجد الحرام، والكعبة التي تعد قبلة المسلمين في صلاتهم. تقع غرب السُّعُودِيَّة…)\nمثال: حلمي الاستقرار في مكة.",
 "マッカーシズム": "مكارثية (اتهام الناس بعدم الولاء بشكل عديم الضمير (كما بقول أنهم شيوعيون))",
 "マッキントッシュ": "أَبْل مَاكِنْتُوش, مَاكِنْتُوش (أَبَلَ الرجل عن امرأته، أي امْتَنَع عن غِشيانها) / معطف ماكنتوش (معطف واق من المطر مصنوع من قماش معالج بالمطاط) / ماكينتوش (قماش خفيف الوزن مقاوم للماء (عادة ما يكون معالجاً بالمطاط)) / تفاح ماكنتوش (تفاح مبكر النضج شائع في شمال شرق الولايات المتحدة؛ يؤكل نيئًا بشكل أساسي ولكنه مناسب لصلصة التفاح)",
 "マック": "مَاكْدُونَالْدْز / معطف ماكنتوش (معطف واق من المطر مصنوع من قماش معالج بالمطاط)",
 "マックス": "إكستاسي سائل, غوب (أسماء دارجة لـ جاما هيدروكسي بيوتيريت) / مجمع إشارات, ملتيبلكسر (جهاز يمكنه تداخل نشاطين أو أكثر)",
 "マックスウェル": "ماكسويل (وحدة في نظام سنتيمتر-غرام-ثانية للتدفق المغناطيسي تساوي التدفق العمودي على مساحة 1 سنتيمتر مربع في مجال مغناطيسي قدره 1 غاوس)",
 "マックレーカー": "مشوه للسمعة, نابش في الفضائح (من ينشر فضائح حقيقية أو مزعومة عن شخص آخر (عادة لمصلحة سياسية))",
 "マッグ": "كُوب, قَعْب (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "マッコウクジラ": "حُوتُ الْعَنْبَر (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "マッサージ": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "マッサージき": "مدلك (شخص يفرك أو يعجن أجزاء من الجسم لتنشيط الدورة الدموية وتعزيز الاسترخاء)",
 "マッサージし": "مُدَلِّكَة",
 "マッサージ器": "مدلك (شخص يفرك أو يعجن أجزاء من الجسم لتنشيط الدورة الدموية وتعزيز الاسترخاء)",
 "マッサージ師": "مُدَلِّكَة",
 "マッサージ機": "مدلك (شخص يفرك أو يعجن أجزاء من الجسم لتنشيط الدورة الدموية وتعزيز الاسترخاء)",
 "マッシブ": "ضَخْم, هائِل الكُتْلَة (ذو كُتْلَة كَبيرَة؛ يَحْتَوي عَلى كَمِّيَّة هائِلَة مِن المادَّة) / صَرْحِيّ, ضَخْم (مهيب في الحجم أو الكتلة أو الصلابة) / هَائِل, وَاسِع (مهيب في النطاق أو المدى أو الدرجة أو القوة) / مُتَجَانِس, مُصْمَت (مؤلَّف من المادّة نفسها في جميع أجزائه)",
 "マッシャー": "هراسة (أداة مطبخ تستخدم للهرس (مثل البطاطس)) / زير نساء, ملاحق النساء (رجل عدواني في التودد للنساء وملاحقتهن)",
 "マッシュ": "خلطة علفية, هريس (خليط من أعلاف الحيوانات المطحونة) / نقيع الشعير, هريس (خليط من حبوب الشعير المهروسة والماء الساخن؛ يستخدم في التخمير)",
 "マッシュドポテト": "بطاطس مهروسة, بوريه بطاطس (بطاطس تم تقشيرها وسلقها ثم هرسها)",
 "マッシュド・ポテト": "بطاطس مهروسة, بوريه بطاطس (بطاطس تم تقشيرها وسلقها ثم هرسها)",
 "マッシュポテト": "بطاطس مهروسة, بوريه بطاطس (بطاطس تم تقشيرها وسلقها ثم هرسها)",
 "マッシュ・ポテト": "بطاطس مهروسة, بوريه بطاطس (بطاطس تم تقشيرها وسلقها ثم هرسها)",
 "マッシー": "حديد خمسة, ماشي (مضرب حديدي للمسافات المتوسطة)",
 "マッス": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء.",
 "マッスル": "عَضَلَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "マッタリ": "غَنِيّ / رَائِق, هَادِئُ الطَّبْع (غَيْرُ مُسْتَعْجِلٍ وَمُسْتَرْخٍ)",
 "マッチ": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / مُبَارَاة / شَحّاطَة, شَخَّاطَة / مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "マッチばこ": "علبة كبريت (علبة لحفظ أعواد الثقاب)",
 "マッチぼう": "شَحّاطَة, شَخَّاطَة",
 "マッチアップ": "مباراة, مواجهة (المزاوجة بين الناس أو الأشياء للمقارنة أو المنافسة)\nمثال: كانت مباراة جيدة لكن الفريق المضيف فاز",
 "マッチプレイ": "لعب بالحفر (حساب نقاط الغولف عن طريق الحفر التي تم الفوز بها)",
 "マッチプレー": "لعب بالحفر (حساب نقاط الغولف عن طريق الحفر التي تم الفوز بها)",
 "マッチポイント": "نقطة المباراة ((تنس) النقطة الأخيرة اللازمة للفوز بالمباراة (خاصة في التنس))",
 "マッチメーカー": "خَاطِب, خَاطِبَة",
 "マッチョ": "خَشِن, فَحْل (يُوصف بالرجال؛ ذكوري بشكل لافت في المظهر أو السلوك) / رجل مفتول العضلات, فحل (ذكر يظهر أو يتسم بالرجولة المفرطة)",
 "マッチング": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / شَبَكَة",
 "マッチ・プレー": "لعب بالحفر (حساب نقاط الغولف عن طريق الحفر التي تم الفوز بها)",
 "マッチ・ポイント": "نقطة المباراة ((تنس) النقطة الأخيرة اللازمة للفوز بالمباراة (خاصة في التنس))",
 "マッチ棒": "شَحّاطَة, شَخَّاطَة",
 "マッチ箱": "علبة كبريت (علبة لحفظ أعواد الثقاب)",
 "マッツォ": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "マッツォー": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "マット": "حَصِيرَة / خيش, قماش القنب (قماش ثقيل منسوج بإحكام) / أرضية الحلبة (البساط الذي يشكل أرضية الحلبة التي يتنافس فيها الملاكمون أو المصارعون المحترفون) / كانفاس, لوحة قماشية (لوحة زيتية على نسيج القنب (الكانفاس)) / خيمة قماشية (خيمة مصنوعة من نسيج القماش)\nمثال: نهض الملاكم عن أرضية الحلبة / غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان) / خليط كبريتيدي خام, مات (خليط من الكبريتيدات يتشكل عند صهر خامات المعادن الكبريتيدية)",
 "マットプレイ": "ممارسة جنسية, نشاط جنسي (الأنشطة المرتبطة بالجماع الجنسي)\nمثال: مارسوا الجنس في المقعد الخلفي",
 "マットレス": "فِرَاش, مَرْتَبَة",
 "マット・プレイ": "ممارسة جنسية, نشاط جنسي (الأنشطة المرتبطة بالجماع الجنسي)\nمثال: مارسوا الجنس في المقعد الخلفي",
 "マッド": "طِين, وَحْل / مَجْنُون",
 "マッドネス": "جُنُون",
 "マッハすう": "رَقَم مَاخ (نسبة سرعة جسم متحرك إلى سرعة الصوت)",
 "マッハ数": "رَقَم مَاخ (نسبة سرعة جسم متحرك إلى سرعة الصوت)",
 "マッパ": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "マッピ": "مَبْسَم",
 "マッピング": "رسم الخرائط الجينية ((علم الوراثة) عملية تحديد مواقع الجينات على الكروموسوم) / تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة)) / رسم الخرائط (عملية صنع الخرائط)\nمثال: رسم خرائط مفصل لبنية الصخور",
 "マッフィン": "مَافِن",
 "マップ": "خَرِيطَة (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "マッポ": "شُرْطِيّ, شُرَطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "マツ": "شجرة الصنوبر, صنوبر (شجرة صنوبرية)",
 "マツダイ": "ثلاثية الذيل (سمكة غذائية كبيرة في المياه الدافئة حول العالم لها زعانف شرجية وظهرية طويلة توحي مع الزعنفة الذيلية بذيل ثلاثي الفصوص)",
 "マツノキヒワ": "حسون الصنوبر (عصفور صغير يعيش في الغابات الصنوبرية بأمريكا الشمالية)",
 "マツバラン": "سرخس الخفاقة (نباتات تشكل كتلاً استوائية بشكل رئيسي ذات مظهر هيكلي يشبه مكانس الخفق؛ تفتقر إلى الجذور)",
 "マツムシソウ": "جربن, سكابيوسا (أي من نباتات متنوعة من جنس سكابيوسا)",
 "マツユキソウ": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "マツヨイグサ": "أخدرية, زهرة الربيع المسائية",
 "マツリ": "فُلّ (فَلُّ السَّيْفِ: كَسْرٌ فِي حَدِّهِ؛ فَلُّ الْحَدِيدِ أَوِ الفِضَّةِ أَوِ الذَّهَبِ أَوِ النَّارِ : مَا تَنَاثَرَ مِنْ ذَلِكَ)",
 "マテ": "صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "マテちゃ": "مَتَة",
 "マティア": "متيا",
 "マティエール": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "マティリアリティ": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً؛ مكوناً من مادة) / أَهَمِّيَّة, جَوْهَرِيَّة (صلة تتطلب دراسة متأنية)",
 "マティリアル": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "マティーニ": "مارتيني (كوكتيل مصنوع من الجن (أو الفودكا) مع فيرموث جاف)",
 "マテガイ": "محار الموس (محار بحري له صدفة رقيقة منحنية ضيقة طويلة)",
 "マテハン": "مناولة المواد (فعل تحميل وتفريغ ونقل البضائع داخل مصنع مثلاً، خاصة باستخدام أجهزة ميكانيكية)",
 "マテリアリスト": "مادي (شخص يعتقد أنه لا يوجد شيء سوى المادة الفيزيائية) / مادي (شخص لديه اهتمام كبير بالممتلكات المادية)",
 "マテリアリズム": "مَادِّيَّة",
 "マテリアル": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "マテ茶": "مَتَة",
 "マテ貝": "محار الموس (محار بحري له صدفة رقيقة منحنية ضيقة طويلة)",
 "マディソン": "مَادِيسُون",
 "マデイラ": "ماديرا",
 "マトウダイ": "ضوري مذهب",
 "マトリクス": "مَصْفُوفَة",
 "マトリックス": "مَصْفُوفَة",
 "マトン": "لَحْم اَلضَّأْن (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "マドガイ": "محار النافذة (ذوات صدفتين بحرية شائعة في المياه الساحلية الفلبينية تتميز بصدفة شفافة مسطحة رقيقة كبيرة)",
 "マドネス": "جُنُون",
 "マドモアゼル": "فرخ فضي (سمكة طبل فضية صغيرة غالباً ما يُخطأ بينها وبين الفرخ الأبيض؛ توجد على طول سواحل الولايات المتحدة من نيويورك إلى المكسيك)",
 "マドモワゼル": "فرخ فضي (سمكة طبل فضية صغيرة غالباً ما يُخطأ بينها وبين الفرخ الأبيض؛ توجد على طول سواحل الولايات المتحدة من نيويورك إلى المكسيك)",
 "マドラサ": "مَدْرَسَة إِسْلَامِيَّة, مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "マドラス": "مَدْرَاس",
 "マドラー": "عود تحريك المشروبات (عصا صغيرة تستخدم لتحريك المشروبات المختلطة)",
 "マドリガル": "مادريجال (أغنية متعددة الأجزاء غير مصحوبة بآلات لصوتين أو ثلاثة؛ تتبع شكلاً شعرياً صارماً)",
 "マドリット": "مَدْرِيد, مَجْرِيط (المدينة العاصمة في إسبانيا)\nمثال: هل يعود من مدريد ؟",
 "マドリッド": "مَدْرِيد, مَجْرِيط (المدينة العاصمة في إسبانيا)\nمثال: هل يعود من مدريد ؟",
 "マドリード": "مَدْرِيد, مَجْرِيط (المدينة العاصمة في إسبانيا)\nمثال: هل يعود من مدريد ؟",
 "マドロス": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "マドンナリリー": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "マドンナ・リリー": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "マナ": "مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "マナガツオ": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي) / سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة) / سمك الزبدة (أي من العديد من أسماك الطعام الصغيرة المفلطحة الأطلسية ذات الجلد الناعم)",
 "マナグア": "مَنَاغُوَة",
 "マナティー": "خَرُوف البَحْر",
 "マナト": "مَنَاة",
 "マナマ": "الْمَنَامَة",
 "マナリズム": "رَتِيب, مُمِلّ (مكرّر بشكل مملّ أو يفتقر إلى التنوّع) / رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / رَتَابَة, مَلَل (صفة الثبات المرهق والروتين ونقص التنوع)\nمثال: لم يعتد أبداً على رتابة عمله",
 "マナー": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "マナーいはん": "زلة اجتماعية, فو با (فعل محرج اجتماعياً أو غير لبق)",
 "マナーのわるい": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "マナーの悪い": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "マナーマ": "الْمَنَامَة",
 "マナー違反": "زلة اجتماعية, فو با (فعل محرج اجتماعياً أو غير لبق)",
 "マニきょう": "مَانَوِيَّة",
 "マニぐるま": "عجلة الصلاة (أسطوانة على محور مكتوب عليها أو ملفوف حولها صلوات، تستخدم خاصة من قبل البوذيين في التبت)",
 "マニア": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما) / شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "マニアック": "مَهْوُوس, مَهْوُوسَة",
 "マニアル": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "マニエリスム": "تصنع, تكلف (تظاهر متعمد أو عرض مبالغ فيه) / خصوصية, سمة شخصية غريبة (سمة سلوكية مميزة وخاصة بالفرد) / تكلف, مانييريزم (أسلوب فني في أواخر القرن السادس عشر في أوروبا يتميز بالتنافر المكاني والاستطالة المفرطة للشخصيات البشرية)\nمثال: يفضل المانييريزم التوتر التركيبي وعدم الاستقرار بدلاً من التوازن والوضوح في رسم عصر النهضة المبكر",
 "マニオク": "بفرة, كسافا مرة (كسافا ذات جذور درنية طويلة صالحة للأكل وسيقان هشة ناعمة؛ تستخدم خاصة لصنع الكاسيري (مشروب مسكر) والتابيوكا) / كاسافا, مانيوك (جذر الكاسافا يؤكل كغذاء أساسي بعد التجفيف والنقع؛ مصدر للتابيوكا) / بفرة, كسافا (نشا يُصنع عن طريق نقع وتجفيف جذر نبات الكسافا؛ مصدر التابيوكا؛ غذاء أساسي في المناطق الاستوائية)",
 "マニキュア": "مَانِيكِير, تَجْمِيل الْيَدَيْن / مَنَاكِير",
 "マニキュア液": "مَنَاكِير",
 "マニッシュ": "رِجَالِيّ (من خصائص الرجل بما يميّزه عن المرأة) / مُسْتَرْجِل (يشبه أو يُقلِّد أو يوحي بالرجل أكثر من المرأة)",
 "マニトバ": "مَانِيتُوبَا",
 "マニトール": "مانيتول (مدر للبول (الاسم التجاري أوزميترول) يستخدم لتعزيز إخراج البول)",
 "マニピュレーション": "تَلَاعُب, تَعْدِيل",
 "マニピュレータ": "مُعَالِج يَدَوِيّ, مُنَاوِل (شخص يعالج الأشياء أو يتعامل معها يدوياً) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة)\nمثال: مشغل لوحة المفاتيح",
 "マニピュレーター": "مُعَالِج يَدَوِيّ, مُنَاوِل (شخص يعالج الأشياء أو يتعامل معها يدوياً) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة)\nمثال: مشغل لوحة المفاتيح",
 "マニファクチャ": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا.",
 "マニファクチャラー": "صَانِع, مُصَنِّع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "マニファクチャリング": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة",
 "マニファクチャー": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا.",
 "マニファクチュア": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا.",
 "マニフェスト": "بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "マニフェストデスティニー": "القدر المتجلي (سياسة إمبريالية تُبرر على أنها حتمية (كما لو كانت ممنوحة من الله))",
 "マニフェスト・デスティニー": "القدر المتجلي (سياسة إمبريالية تُبرر على أنها حتمية (كما لو كانت ممنوحة من الله))",
