 "ヴェルディッキオ": "فيرديكيو (نبيذ إيطالي أبيض جاف مصنوع من عنب فيرديكيو) / فيرديكيو (نوع من عنب النبيذ الأبيض يزرع في إيطاليا)",
 "ヴェルミチェッリ": "إِطْرِيَة, شُعَيْرِيَّة",
 "ヴェルモット": "إِسْفِنْط, فِيرْمُوت",
 "ヴェルヴェット": "مُخْمَل, قَطِيفَة",
 "ヴェロキラプトル": "فيلوسيرابتور (آكل لحوم صغير نشط ربما كان يتغذى على البروتوسيراتوبس؛ ربما يرتبط بالطيور بشكل أوثق من الديناصورات الأخرى)",
 "ヴェロシティ": "سُرْعَة, سُرْعَة مُتَّجِهَة (المسافة المقطوعة لكل وحدة زمنية)",
 "ヴェロシティー": "سُرْعَة, سُرْعَة مُتَّجِهَة (المسافة المقطوعة لكل وحدة زمنية)",
 "ヴェロナール": "باربيتال, فيرونال (باربيتورات يستخدم كمنوم)",
 "ヴェンダ": "بَائِع, بَيَّاع / آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "ヴェンダー": "بَائِع, بَيَّاع / آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "ヴェンチャー": "مجازفة, مغامرة (أي مشروع ينطوي على مغامرة خاصة المشروع ذو النتيجة غير المؤكدة) / مشروع مجازف, مغامرة تجارية (مشروع تجاري يخاطر بالخسارة لكنه يعد بالربح) / مضاربة, مغامرة تجارية (استثمار محفوف بالمخاطر ولكنه قد يدر أرباحاً كبيرة)\nمثال: كان يعلم أن السهم كان مضاربة عندما اشتراه",
 "ヴェンティ": "عِشْرُونَ",
 "ヴェーダ": "الأدب الفيدي, الفيدا (أي من أقدم الكتابات المقدسة للهندوسية المكتوبة بالسنسكريتية المبكرة)",
 "ヴェートーベン": "بِيتْهُوفَن",
 "ヴェール": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "ヴォイシング": "تجويد الصوت, ضبط النغمة (فعل تعديل أنبوب الأرغن (أو آلة النفخ) ليتوافق مع معايير النغمة والطبقة واللون)",
 "ヴォイス": "صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي.",
 "ヴォイスメッセージ": "رِسَالَة صَوْتِيَّة",
 "ヴォイスメール": "بريد صوتي (نظام محوسب للرد على المكالمات الهاتفية وتوجيهها؛ يمكن تسجيل الرسائل الهاتفية وتخزينها ونقلها)",
 "ヴォキャブラリー": "مُفْرَدَات, ذَخِيرَة لُغَوِيَّة / مَسْرَد, مَسارِد / مَفْرَدَات",
 "ヴォケ": "مُغَفَّل, أَحْمَق / خرف, هرم (الضعف العقلي نتيجة لكبر السن) / خَارِج السِّيَاق, غَيْر مُلِمّ (غافل نتيجة عدم الاطلاع على المعلومات) / فَاقِدُ الإِحْسَاسِ, مُغْمًى عَلَيْهِ (لَا يَسْتَجِيبُ لِلتَّنْبِيهِ أَوِ المُؤَثِّرَاتِ) / مُسْتَبْعَد, مُهَمَّش (مُقصًى من نشاط أو مجموعة اجتماعية)",
 "ヴォッカ": "فُودْكَا",
 "ヴォドカ": "فُودْكَا",
 "ヴォラピュク": "فُولَابُوك",
 "ヴォラピューク": "فُولَابُوك",
 "ヴォランタリー": "إرادي, تطوعي (بمحض إرادتك أو تصميمك؛ تم بالاختيار؛ غير مجبر أو مكره) / إرادي (يتم التحكم فيه بواسطة الإرادة الفردية) / عزف حر, مقطوعة تطوعية (تأليف (غالباً ما يكون مرتجلاً) لآلة منفردة (خاصة الأرغن) وليس جزءاً منتظماً من الخدمة الدينية أو الأداء الموسيقي) / متطوع, متطوع عسكري ((عسكرياً) شخص يتطوع بحرية للخدمة)\nمثال: الإنسان فاعل مختار",
 "ヴォリューム": "حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / مقياس الجهد الانزلاقي",
 "ヴォルケーノ": "بُرْكَان, جَبَلُ النَّار (فَتْحَةُ أَوْ فَوْهَةُ انْفجارٍ حَلَزونِيَّةُ الشَّكْلِ، تَكونُ في مَواقِعَ جَبَلِيَّةٍ تَقْذِفُ نيراناً مُلْتَهِبَةً)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "ヴォルト": "فولْت, ڤولْت",
 "ヴォルヴォ": "فُولْفُو, ڤُولْڤُو",
 "ヴォーカリスト": "مطرب, مغنٍ (شخص يغني)",
 "ヴォーカル": "صَوْتِيّ / مطرب, مغنٍ (شخص يغني)",
 "ヴォールト": "قَبْو",
 "ヴュー": "مَنْظَر, مَشْهَد",
 "ヴューポイント": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "ヴルスト": "سُجُق, نَقَانِق",
 "ヴードゥー": "تميمة سحرية, سحر (تميمة يُعتقد بخرافة أنها تجسد قوى سحرية) / فودو (طائفة دينية تمارس بشكل رئيسي في دول الكاريبي (خاصة هايتي)؛ تنطوي على السحر وآلهة أرواحية) / الفودو ((هايتي) أتباع ديانة تتضمن السحر والآلهة الروحانية)",
 "ヶ": "فَرْد, شَخْص / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال. / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "一": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / أَفْضَل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "一々": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل",
 "一〇": "عَشَرَة, عَشْرَة",
 "一〇〇": "مِٱئَة, مِئَة",
 "一〇〇〇": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "一〇〇〇〇": "عَشَرَة آلَاف",
 "一〇〇〇〇〇": "مِائَة أَلْف",
 "一〇〇倍": "مائة ضعف (بمعامل مائة)\nمثال: زادت أموالهم مائة ضعف",
 "一〇月": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "一から": "من الصفر (من البداية، خاصة دون الاعتماد على موارد أو مزايا أخرى)\nمثال: خبز الكعكة من الصفر",
 "一から十まで": "مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "一こま": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "一ころ": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "一しきり": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "一すじ": "جَدِّي, جَادّ / عَرْبُون / عَادِيّ, مَأْلُوف",
 "一たび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "一っ走り": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "一っ風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "一っ飛び": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "一つ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "一つがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "一つずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "一つづつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "一つとして": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "一つながり": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "一つひとつ": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "一つまた一つ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "一つも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "一つ一つ": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "一つ二つ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "一つ又一つ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "一つ家": "مسكن مستقل, منزل منفصل (منزل يقف بمفرده)",
 "一つ心": "إخلاص, صدق عزيمة (التزام كامل أو حماس غير متحفظ) / إخلاص قلبي, حرارة (صفة الإخلاص القلبي الحار)",
 "一つ星": "نَجْمَة الْمَسَاء",
 "一つ書き": "بَنْد",
 "一つ目": "أَعْوَر, عَوْرَاء / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "一つ目小僧": "أَعْوَر, عَوْرَاء",
 "一つ目滑車": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "一つ穴": "عِصَابَة",
 "一つ穴のむじな": "عِصَابَة",
 "一つ穴の狢": "عِصَابَة",
 "一つ穴の貉": "عِصَابَة",
 "一つ置き": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "一つ置きに": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "一つ話": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "一とたび": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "一と先ず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "一なめ": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / مُغَلَّف, لِفَافَة / غِلَاف",
 "一に": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده / إِقْتِسَام, مُقَاسَمَة",
 "一の腕": "عَضُد (مُعِين؛ قُوَّة)",
 "一まず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "一まとまり": "حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة.",
 "一まとめ": "إِبَالَة, حُزْمَة",
 "一も二もなく": "دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "一も二も無く": "دون تردد (بلا تردد)\nمثال: قالت نعم دون تردد",
 "一わたり": "عُمُومًا / بِوَجْهٍ عَامّ",
 "一コマ": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "一ミリ": "بُوصَة, شِبْر",
 "一一": "أَحَد عَشَر, إِحْدَى عَشْرَةَ (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / مِشْوَال, رَافِعَة / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار. / بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل",
 "一一〇番": "مِئَة وَعَشَرَة (يَدُلُّ عَلَى العَدَد 110) / أُطْلُب الشُّرْطَة, نَاد الشُّرْطَة",
 "一一月": "نُوفِمْبِر, نُوفَمْبِر (الشهر الحادي عشر في السنة الميلادية)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "一丁": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "一丁前": "بَالِغ, رَاشِد / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "一丁噛み": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة) / فُضُولِيّ",
 "一丁目一番地": "بَادِئَ ذِي بَدْءٍ",
 "一七": "سَبْعَةَ عَشَرَ",
 "一万": "عَشَرَة آلَاف",
 "一三": "ثَلَاثَةَ عَشَرَ (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "一世": "جِيل, نَسْل / جِيل / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "一世紀": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "一丸となって": "مُتَّحِد",
 "一九": "تِسْعَةَ عَشَرَ",
 "一九日": "مُغَفَّل, أَحْمَق",
 "一二": "اِثْنَا عَشَرَ / مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة. / زَوْجَانِ / بَعْضُ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "一二に及ばず": "فَوْرًا, حَالًا",
 "一二月": "دِيسِمْبِر, دِيسَمْبِر (الشهر الثاني عشر في السنة الروميّة)\nمثال: أنا في إضراب من 8 إلى 12 ديسمبر.",
 "一五": "خَمْسَةَ عَشَرَ (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "一人": "لوحد / لحال / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "一人あたり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "一人ごちる": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "一人ごつ": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "一人ずつ": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "一人で": "وَحِيد, مُنْفَرِد",
 "一人につき": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "一人ひとり": "كُلّ",
 "一人ぼっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "一人ぽっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "一人も": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "一人エッチ": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "一人一人": "كُلّ",
 "一人前": "بَالِغ, رَاشِد\nمثال: 彼女も一人前の女になった。 — لقد اصبحت امرأة بالغة. / كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "一人前になる": "بَلَغَ رُشْدَهُ",
 "一人勝手": "أَنَانِيّ",
 "一人占め": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "一人天狗": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "一人当たり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "一人残らず": "كُلّ, جَمِيع",
 "一人決め": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "一人物": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "一人称": "مُتَكَلِّم",
 "一人親方": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "一人部屋": "غُرْفَة لِشَخْص وَاحِد (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "一介": "تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "一仕事": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "一代": "جِيل, نَسْل / جِيل",
 "一代分限": "مُحْدَث اَلنَّعْمَة",
 "一代記": "سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ",
 "一件": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم.",
 "一件書類": "مِلَفّ",
 "一休み": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "一位": "طقسوس ياباني (شجيرة دائمة الخضرة قوية من الصين واليابان لها أوراق خضراء داكنة لامعة؛ تزرع في شرق الولايات المتحدة)",
 "一佐": "عَقِيد, زَعِيم",
 "一体": "بحق السماء, في الدنيا (تستخدم مع كلمات الاستفهام للتعبير عن الدهشة)\nمثال: ما الذي تفعله بحق السماء؟ / عُمُومًا / بِوَجْهٍ عَامّ / حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "一体に": "عُمُومًا / بِوَجْهٍ عَامّ",
 "一体化": "تَوْحِيد",
 "一体型モニタ": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "一体型モニター": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "一体性": "وَحْدَانِيَّة, وحدَة",
 "一体感": "بِطَاقَة هُوِيَّة",
 "一体的": "صَحِيح / تَكَامُلِيّ",
 "一例": "مِثَال, مَثَل / مِثَال",
 "一価不飽和脂肪酸": "حمض دهني أحادي غير مشبع (حمض دهني غير مشبع تحتوي سلسلة الكربون الخاصة به على رابطة تكافؤ مزدوجة أو ثلاثية واحدة لكل جزيء؛ يوجد بشكل رئيسي في زيت الزيتون والدجاج واللوز)",
 "一価関数": "تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة))",
 "一個": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "一個あたり": "كُلّ",
 "一個一個": "فَرْد, شَخْص",
 "一個人": "فَرْد, شَخْص",
 "一個当たり": "كُلّ",
 "一個当り": "كُلّ",
 "一倍": "أَكْثَر / ثُنَائِيّ / ضِعْف",
 "一倍体": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات)",
 "一偏": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / نِيَّة / غَيْرُ مُتَوَازِن (المدين والدائن ليسا متساويين) / غير متوازن, مختل التوازن (كونه خارج التوازن أو تم إخراجه عن التوازن) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ)",
 "一儀": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "一億": "مئة مليون",
 "一元": "مركزي, موحد (يتميز بـأو يشكل شكلاً من أشكال الحكم تكون فيه السلطة بيد سلطة مركزية واحدة) / وَاحِد, وَحْدَوِيّ (له طابع الوحدة غير القابلة للتجزئة) / وحدوي (متعلق باستخدام الوحدات أو يعتمد عليها (في الرياضيات والقياس)) / توحيدي, وحدوي (متعلق بالوحدة أو يهدف إليها أو يتميز بها)\nمثال: شكل موحد للحكومة في مقابل الشكل الفيدرالي",
 "一元化": "تَوْحِيد",
 "一元的": "أحادي (من أو يتعلق بمذهب الواحدية الفلسفي)\nمثال: المدرسة الأحادية تعتبر القانون الوطني والقانون الدولي كلاً متكاملاً",
 "一元論": "مونية, وحدوية (المذهب القائل بأن الواقع يتكون من مادة أو عنصر أساسي واحد)",
 "一元配置分散分析": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "一先": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "一先ず": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / بشكل ما, نوعاً ما (إلى حد ما؛ ليس بشكل جيد جداً)\nمثال: يتحدث الفرنسية نوعاً ما",
 "一党優位政党制": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一党支配": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一党独裁": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一党独裁体制": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "一入": "خُصُوصًا, خَاصَّةً",
 "一八": "ثَمَانِيَةَ عَشَرَ / زهرة الزنبق ((شعارات النبالة) شحنة تتكون من تمثيل تقليدي لزهرة السوسن) / زنبق السيف, سوسن (نباتات ذات أوراق تشبه السيف وسيقان منتصبة تحمل أزهاراً زاهية الألوان تتكون من ثلاث بتلات وثلاث سبلات متدلية)",
 "一六": "سِتَّةَ عَشَرَ / سَرِقَة, لُصُوصِيَّة",
 "一六勝負": "قِمَار, مُقَامَرَة / مُخَاطَرة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / خَاطَرَ\nمثال: أنا ذاهب للخطر.",
 "一六銀行": "مرهن",
 "一兵卒": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك. / تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "一円": "طَوَال",
 "一再": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "一再ならず": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "一処": "مَعًا, سَوِيًّا"
}
