 "マネジメントシステム": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "マネジメント・コンサルタント": "مستشار إداري (مستشار للشركات بشأن ممارسات الإدارة الفعالة)",
 "マネジメント・システム": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "マネジャー": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "マネタイズ": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "マネタイゼーション": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "マネタリスト": "نقديّ (مدافع عن النظرية القائلة بأن التقلبات الاقتصادية ناتجة عن الزيادات أو النقصان في عرض النقود)",
 "マネタリズム": "نقدوية (نظرية اقتصادية ترى أن التغيرات في البطالة ومعدل التضخم عادة ما تكون ناجمة عن التغيرات في المعروض النقدي)",
 "マネタリー": "نَقْدِيّ, مَالِيّ",
 "マネロン": "غَسِيل أَمْوَال, غَسْل أَمْوَال",
 "マネー": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "マネーサプライ": "الكتلة النقدية, عرض النقود (إجمالي مخزون المال في الاقتصاد؛ العملة التي يحتفظ بها الجمهور بالإضافة إلى الأموال في الحسابات المصرفية)",
 "マネージ": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "マネージメント": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "マネージメントコンサルタント": "مستشار إداري (مستشار للشركات بشأن ممارسات الإدارة الفعالة)",
 "マネージメントシステム": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "マネージメント・コンサルタント": "مستشار إداري (مستشار للشركات بشأن ممارسات الإدارة الفعالة)",
 "マネージメント・システム": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "マネージャ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "マネージャー": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "マネービル": "كسب المال (فعل جني المال (وتراكم الثروة)) / مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا)",
 "マネーマーケット": "سُوق الْمَال (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "マネーメイカー": "بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال) / صانع ثروة, كاسب المال (شخص ناجح في جمع الثروة)",
 "マネーメーカー": "بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال) / صانع ثروة, كاسب المال (شخص ناجح في جمع الثروة)",
