 "マリナー": "بحار (رجل يخدم كبحار)",
 "マリナーラ": "مارينارا (صلصة للمعكرونة؛ تحتوي على طماطم وثوم وأعشاب)",
 "マリネ": "تَتْبِيلَة",
 "マリネード": "تَتْبِيلَة",
 "マリファナ": "مَارِهْوَانَا, حَشِيش",
 "マリフアナ": "مَارِهْوَانَا, حَشِيش",
 "マリリンとアインシュタイン": "تفاهة, ضآلة الشأن (صفة وجود القليل من الأهمية أو انعدامها)",
 "マリワナ": "مَارِهْوَانَا, حَشِيش",
 "マリン": "بَحْرِيّ",
 "マリンバ": "إكسيليفون, ماريمبا (آلة إيقاعية ذات قضبان خشبية مضبوطة لإنتاج سلم لوني ومعها رنانات؛ تُلعب بمطارق صغيرة)",
 "マリンパーク": "حَوْض اَلسَّمَك, أَكْوَارِيُوم (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / حَوْض اَلسَّمَك, مَعْرِضُ الْأَحْيَاءِ الْمَائِيَّةِ (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "マリンブルー": "أَزْرَق لَازَوَرْدِيّ (بلون أزرق صافٍ زاهٍ إلى أزرق أرجواني) / أزرق فاقع, أزرق ما وراء البحار (لون أزرق زاهٍ إلى أزرق أرجواني) / ألترامارين, لازوردي (خضاب أزرق مصنوع من اللازورد المسحوق)",
 "マリン・パーク": "حَوْض اَلسَّمَك, أَكْوَارِيُوم (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / حَوْض اَلسَّمَك, مَعْرِضُ الْأَحْيَاءِ الْمَائِيَّةِ (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "マリン・ブルー": "أَزْرَق لَازَوَرْدِيّ (بلون أزرق صافٍ زاهٍ إلى أزرق أرجواني) / أزرق فاقع, أزرق ما وراء البحار (لون أزرق زاهٍ إلى أزرق أرجواني) / ألترامارين, لازوردي (خضاب أزرق مصنوع من اللازورد المسحوق)",
 "マリー": "مالي (أي من عدة أنواع من الأوكالبتوس منخفض النمو في أستراليا)",
 "マリーゴールド": "آذَرْيُون, كَحْلَاء / قَطِيفَة, آذَرْيُون",
 "マリーシア": "براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "マリーナ": "مارينا",
 "マリーン": "بَحْرِيّ / مُشَاة البَحْرِيَّة",
 "マリーンパーク": "حَوْض اَلسَّمَك, أَكْوَارِيُوم (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / حَوْض اَلسَّمَك, مَعْرِضُ الْأَحْيَاءِ الْمَائِيَّةِ (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "マリーン・パーク": "حَوْض اَلسَّمَك, أَكْوَارِيُوم (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / حَوْض اَلسَّمَك, مَعْرِضُ الْأَحْيَاءِ الْمَائِيَّةِ (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "マル": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / كَافَّة, تَمَام / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة)",
 "マルざい": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "マルひ": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "マルゆう": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "マルウェア": "برنامج ضار (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "マルウエア": "برنامج ضار (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
