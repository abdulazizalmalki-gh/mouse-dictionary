 "ワーオ": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "ワーカホリック": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "ワーカー": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "ワーカーホリック": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "ワーキング": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "ワーキングウーマン": "امرأة عاملة, عاملة (موظفة أنثى تؤدي عملاً يدوياً أو صناعياً)",
 "ワーキンググループ": "مجموعة عمل (مجموعة من الأشخاص يعملون معًا مؤقتًا حتى يتم تحقيق هدف ما)\nمثال: كان من المفترض أن تقدم مجموعة العمل تقريرًا في غضون أسبوعين",
 "ワーキングドッグ": "كلب عمل (أي من عدة سلالات من الكلاب القوية الكبيرة عادة التي يتم تربيتها للعمل كحيوانات جر وكلاب حراسة وإرشاد)",
 "ワーキングメモリー": "ذَاكِرَة عَامِلَة",
 "ワーキング・ウーマン": "امرأة عاملة, عاملة (موظفة أنثى تؤدي عملاً يدوياً أو صناعياً)",
 "ワーキング・グループ": "مجموعة عمل (مجموعة من الأشخاص يعملون معًا مؤقتًا حتى يتم تحقيق هدف ما)\nمثال: كان من المفترض أن تقدم مجموعة العمل تقريرًا في غضون أسبوعين",
 "ワーキング・ドッグ": "كلب عمل (أي من عدة سلالات من الكلاب القوية الكبيرة عادة التي يتم تربيتها للعمل كحيوانات جر وكلاب حراسة وإرشاد)",
 "ワーキング・メモリー": "ذَاكِرَة عَامِلَة",
 "ワーク": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "ワークとりつけだい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تجهيزات, تركيبات (جسم مثبت بإحكام في مكانه (خاصة في المنزل)) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / زبون معتاد, مرتاد دائم (راعٍ منتظم لمكان ما)\nمثال: مرتاد دائم لمضمار السباق",
 "ワークアウト": "تمرين, تمرين بدني (نشاط بذل الجهد العضلي بطرق مختلفة للحفاظ على اللياقة)\nمثال: أوصى الطبيب بممارسة الرياضة بانتظام",
 "ワークアラウンド": "تَحَاشٍ / تَجَنُّب (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "ワークショップ": "مَشْغَل, وَرْشَة",
 "ワークショプ": "مَشْغَل, وَرْشَة",
 "ワークシート": "ورقة عمل (ورقة ذات أعمدة متعددة؛ يستخدمها المحاسب لتجميع الأرقام للبيانات المالية) / ورقة عمل (ورقة تسجل العمل المخطط له أو المنجز في مشروع ما)",
 "ワークス": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "ワークステーション": "مَحَطَّة عَمَل",
 "ワークスペース": "مِسَاحةُ عَمَل",
 "ワークソング": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "ワークハウス": "إصلاحية عمل, دار تشغيل (سجن محلي يحتجز السجناء لفترات تصل إلى 18 شهراً) / ملجأ تشغيل الفقراء (ملجأ للفقراء حيث يُجبر الفقراء القادرون على العمل على العمل)",
 "ワークフロー": "تدفق العمل, سير العمل (التقدم (أو معدل التقدم) في العمل المنجز)",
 "ワークブック": "كراسة تمارين, كراسة عمل (كتاب أو كتيب للطالب يحتوي على مسائل مع مساحات لحلها)",
 "ワークベンチ": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "ワークマン": "جهاز ستيريو محمول, ووكمان ((علامة تجارية) نظام ستيريو بحجم الجيب مع سماعات أذن خفيفة الوزن)",
 "ワークロード": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "ワーク・ソング": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "ワーク・フロー": "تدفق العمل, سير العمل (التقدم (أو معدل التقدم) في العمل المنجز)",
 "ワーク取り付け台": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تجهيزات, تركيبات (جسم مثبت بإحكام في مكانه (خاصة في المنزل)) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / زبون معتاد, مرتاد دائم (راعٍ منتظم لمكان ما)\nمثال: مرتاد دائم لمضمار السباق",
 "ワーゲン": "فولكس واجن",
 "ワーシップ": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "ワースト": "الأسوأ (لأقصى درجة من الرداءة أو السوء) / أسوأ جهد (أضعف جهد أو أفقر إنجاز يمكن للمرء القيام به) / أَسْوَأ ((صيغة التفضيل من 'سيء') الأكثر نقصاً في الجودة أو القيمة أو الحالة) / أسوأ ما يمكن (أقصى درجات الضرر أو الشر التي يقدر عليها المرء)\nمثال: عانت الأسوأ من بينهم جميعاً",
 "ワーディング": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "ワーデン": "آمِر سِجْن",
 "ワートホッグ": "خَنْزِير بَرِّيّ",
 "ワード": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / جَنَاح",
 "ワードサラダ": "سَلَطَة كَلِمَات (خليط من الكلام غير المترابط كما يُسمع أحياناً في الفصام)",
 "ワードプロセッサ": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى طابعة)",
 "ワードプロセッサー": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى طابعة)",
 "ワードプロセッシング": "معالجة الكلمات, معالجة النصوص (معالجة سريعة وفعالة (تخزين وطباعة) للبيانات اللغوية من أجل الإنشاء والتحرير)",
 "ワードロービング": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "ワードローブ": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "ワード・サラダ": "سَلَطَة كَلِمَات (خليط من الكلام غير المترابط كما يُسمع أحياناً في الفصام)",
 "ワード・プロセッサ": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى طابعة)",
 "ワード・プロセッサー": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى طابعة)",
 "ワード・プロセッシング": "معالجة الكلمات, معالجة النصوص (معالجة سريعة وفعالة (تخزين وطباعة) للبيانات اللغوية من أجل الإنشاء والتحرير)",
 "ワーニング": "تَحْذِير, إِنْذار",
 "ワーファリン": "كومادين, وارفارين (مضاد للتخثر (الاسم التجاري كومادين) يستخدم لمنع وعلاج الجلطة أو الانصمام)",
 "ワープ": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "ワープロ": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى طابعة)",
 "ワーホリ": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "ワーム": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "ワームホール": "ثَقْب دُودِيّ, مَمَرّ دُودِيّ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "ワールド": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "ワールドカップ": "كَأْس عَالَم, كَأْس الْعَالَم (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟",
 "ワールドクラス": "أَوَّل, مِن الطِّرَاز الأَوَّل (يتصدر جميع الآخرين في الترتيب)",
 "ワールドシリーズ": "بطولة العالم للبيسبول, وورلد سيريس (سلسلة تشكل التصفيات النهائية لبطولة البيسبول)\nمثال: شاهدنا بطولة العالم للبيسبول على التلفاز",
 "ワールドプレミア": "عرض عالمي أول ((موسيقى) أول عرض عام (لعمل درامي أو موسيقي) في أي مكان في العالم)",
 "ワールドミュージック": "موسيقى العالم (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "ワールドレコード": "رقم قياسي عالمي (أفضل سجل في العالم كله)",
