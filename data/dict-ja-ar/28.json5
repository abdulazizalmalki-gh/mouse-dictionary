 "自臭症": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "自若": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "自虐": "مَاسُوشِيَّة, مَازُوخِيَّة",
 "自衛": "دِفَاع عَنِ النَّفْسِ",
 "自裁": "مُنْتَحِر, مُنْتَحِرَة",
 "自製": "مَنْزِلِيّ",
 "自覚": "وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "自負": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自負心": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自販機": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "自身": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自転": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "自転車": "دَرَّاجَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص)) / بسْكليت / بِسِكْليت / بِسْكْلات\nمثال: كين يريد دراجة.",
 "自転車をこぐ": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "自転車を漕ぐ": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "自重": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "自閉": "تَوَحُّد, مَرَض التَّوَحُّد",
 "自閉スペクトラム症": "اِضْطِرَاب طَيْف التَّوَحُّد",
 "自閉症": "تَوَحُّد, مَرَض التَّوَحُّد",
 "自閉症スペクトラム症": "اِضْطِرَاب طَيْف التَّوَحُّد",
 "自閉症スペクトラム障害": "اِضْطِرَاب طَيْف التَّوَحُّد",
 "自閉症協会": "آسا",
 "自首": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "自鳴琴": "صندوق موسيقي (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "臭い": "نَتُنَ, نَتِنَ / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / أَخْرَق / ـِيّ",
 "臭いがする": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة.",
 "臭い消し": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "臭う": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة. / نَتُنَ, نَتِنَ / أَشَعَّ ((أَشَعَّتِ) الشمسُ: نَشَرَتْ شْعاعها؛ أَشَعَّتِ النارُ: أَرسلت ضوءها وحرارتها)\nمثال: أشع الإسبرانتو!",
 "臭み": "تَصَنُّع, تَكَلُّف",
 "臭わす": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "臭わせる": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
