 "ムクムク": "شَاهِق / سمين / تحريك, تقليب (تحريك سائل باستخدام أداة) / إلهام, تحريك المشاعر (الاستنهاض لعاطفة أو فعل معين) / مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة / أَشْعَث",
 "ムグンファ": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "ムコたとう": "عديد السكاريد المخاطي (سكريات متعددة معقدة تحتوي على مجموعة أمينية؛ توجد بشكل رئيسي كمكونات للنسيج الضام)",
 "ムコたとうしょう": "داء عديد السكاريد المخاطي (أي من مجموعة الاضطرابات الوراثية التي تنطوي على خلل في استقلاب عديد السكاريد المخاطي)",
 "ムコたとうるい": "عديد السكاريد المخاطي (سكريات متعددة معقدة تحتوي على مجموعة أمينية؛ توجد بشكل رئيسي كمكونات للنسيج الضام)",
 "ムコようし": "زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ムコ多糖": "عديد السكاريد المخاطي (سكريات متعددة معقدة تحتوي على مجموعة أمينية؛ توجد بشكل رئيسي كمكونات للنسيج الضام)",
 "ムコ多糖症": "داء عديد السكاريد المخاطي (أي من مجموعة الاضطرابات الوراثية التي تنطوي على خلل في استقلاب عديد السكاريد المخاطي)",
 "ムコ多糖類": "عديد السكاريد المخاطي (سكريات متعددة معقدة تحتوي على مجموعة أمينية؛ توجد بشكل رئيسي كمكونات للنسيج الضام)",
 "ムコ養子": "زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ムゴい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مَأْسَاوِيّ, تْرَاجِيدِيّ",
 "ムサい": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "ムサイ": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "ムサカ": "مُسَقَّعَة, مُصَقَّعَة",
 "ムシカリ": "أُفلُوس, رِبَاط",
 "ムシクイ": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "ムシケラ": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "ムシコブ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "ムシヒキアブ": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "ムシムシ": "حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ムシャクシャ": "زَعْلَان / أَشْعَث",
 "ムシャムシャ": "قضم, مضغ (قضمة كبيرة)\nمثال: حاول التحدث بين قضمات الشطيرة / أَشْعَث",
 "ムシュリク": "مُشْرِك",
 "ムショ": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "ムシロ": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "ムジナ": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "ムジナモ": "الدرواندة, نبات طاحونة الماء (نبات مائي آكل للحوم معمر وطافٍ من وسط وجنوب أوروبا وإفريقيا وآسيا وأستراليا، له دوارات من 6 إلى 9 أوراق تنتهي بفصوص مفصلية لاصطياد براغيث الماء مثلاً)",
 "ムジャーヒディーン": "مجاهدين (قوة عسكرية من المحاربين المسلمين المشاركين في الجهاد)\nمثال: يسمي البعض المجاهدين محاربين دوليين لكن آخرين يسمونهم إرهابيين",
 "ムスっと": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "ムスカリ": "ياسنت العنب (أي من الياسنت الربيعي المبكر المتنوع موطنه أوراسيا ذو سنابل كثيفة من الزهور الزرقاء المستديرة تشبه عناقيد العنب الصغيرة)",
 "ムスク": "مِسْك",
 "ムスコ": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "ムスタッシュ": "شَارِب (نمو للشعر غير المحلوق على الشفة العليا)\nمثال: بدا أصغر سناً بعد أن حلق شاربه",
 "ムスタング": "موستانج (حصان مراعي قوي صغير في السهول الغربية ينحدر من الخيول التي جلبها الإسبان)",
 "ムスッと": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "ムスリム": "مُسْلِم, مُسْلِمَة ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "ムズい": "صَعْب",
 "ムズムズ": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
 "ムダ": "عَبَث, لَا طَائِل (عدم الجدوى كنتيجة لعدم وجود نتيجة عملية)",
 "ムダ口": "هَذَى",
 "ムチ": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "ムチっ": "سمين",
 "ムチをくれる": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "ムチッ": "سمين",
 "ムチムチ": "سمين",
 "ムチャクチャ": "لَا مَعْقُول, هُرَائِيّ (لا يحمل أي معنى مفهوم) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية) / بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً / اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ムチャムチャ": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً",
 "ムチン": "موسين (مادة نيتروجينية توجد في الإفرازات المخاطية؛ مادة مزلقة تحمي أسطح الجسم)",
 "ムチンさん": "حمض الميوسيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ムチン酸": "حمض الميوسيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ムッと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "ムッキムキ": "عَضَلِيّ",
 "ムッシュ": "سيد, مسيو (يستخدم كلقب مجاملة فرنسي؛ يعادل 'سيد' في الإنجليزية)",
 "ムッシュー": "سيد, مسيو (يستخدم كلقب مجاملة فرنسي؛ يعادل 'سيد' في الإنجليزية)",
 "ムッスリ": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "ムッソリーニ": "مُوسُولِينِي",
 "ムッチムチ": "سمين",
 "ムッチリ": "سمين",
 "ムッツリ": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "ムツゴロウ": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على اليابسة باستخدام زعانف صدرية قوية)",
 "ムトン": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "ムナジロテン": "دلق الحجر (دلق أوراسي ذو معطف بني مع صدر وحلق شاحب)",
 "ムニムニ": "إسْفَنْجِيّ, طَرِيّ مَطَّاطِيّ (ذو قِوام إسْفَنْجِيّ؛ لَيِّن ومَليء بالمَسامّ)",
 "ムニュ": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة",
 "ムネアカコウカンチョウ": "بيرولوكسيا (طائر رمادي وأحمر ذو عرف يعيش في جنوب غرب الولايات المتحدة والمكسيك)",
 "ムハッラム": "مُحَرَّم ((اسم) المُحَرَّمُ: الشهر الأول من السنة القمرية أو التقويم الهجري؛ (صفة) المحرٌَمُ: ما ثبت النهي فيه بلا عارض، وحكمه الثواب بالترك لله تعالى، والعقاب بالفعل والكفر بالاستحلال، في المتفق) / ذِكْرَى مُحَرَّم",
 "ムハンマド": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا) / سورة محمد\nمثال: محمد رسول الله.",
 "ムババネ": "مْبَابَانِي",
 "ムババーネ": "مْبَابَانِي",
 "ムフティー": "مُفْتٍ, مُفْتِي",
 "ムラ": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر)",
 "ムラっ気": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "ムラなく": "بالتساوي, بانتظام (بطريقة مستوية ومنتظمة) / بالتساوي, بالمناصفة (بكميات أو حصص متساوية؛ بطريقة متوازنة أو محايدة)\nمثال: فصل دراسي مقسم بالتساوي بين الفتيات والفتيان",
 "ムラサキ": "بَنَفْسَجِيّ / أُرْجُوَانِيّ / صَلْصَةْ اَلصُّويَا",
 "ムラサキウマゴヤシ": "فَصْفَص",
 "ムラサキクンシラン": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "ムラサキゴテン": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "ムラサキツバメ": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "ムラサキハシドイ": "لَيْلَك / لَيْلَكِيّ",
 "ムラサキハナマメ": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "ムラサキベンケイソウ": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "ムラサキマシコ": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "ムラッ気": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "ムラムラ": "بِشَكْل سَاحِق, بِقُوَّة قَاهِرَة (بشكل لا يمكن مقاومته)\nمثال: بدت الحلوى مرغوبة بشكل ساحق للرجل الذي يتبع حمية",
 "ムラート": "خِلَاسِيّ",
 "ムラ気": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "ムラ無く": "بالتساوي, بانتظام (بطريقة مستوية ومنتظمة) / بالتساوي, بالمناصفة (بكميات أو حصص متساوية؛ بطريقة متوازنة أو محايدة)\nمثال: فصل دراسي مقسم بالتساوي بين الفتيات والفتيان",
 "ムラ社会": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "ムリ": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / مُسْتَحِيل / بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة) / مُفْرِط, زَائِد",
