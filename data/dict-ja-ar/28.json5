 "マンネンロウ": "إِكْلِيل الْغَار, إِكْلِيل الْجَبَل",
 "マンハッタン": "مانهاتن (كوكتيل مصنوع من الويسكي والفيرموث الحلو مع قليل من البيترز)",
 "マンハッタンけいかく": "مشروع مانهاتن (وكالة تنفيذية أمريكية سابقة كانت مسؤولة عن تطوير القنابل الذرية خلال الحرب العالمية الثانية)",
 "マンハッタン計画": "مشروع مانهاتن (وكالة تنفيذية أمريكية سابقة كانت مسؤولة عن تطوير القنابل الذرية خلال الحرب العالمية الثانية)",
 "マンハント": "بحث منظم, مطارده (بحث منظم (من قبل الشرطة) عن شخص (متهم بجريمة))",
 "マンバ": "مامبا (ثعبان شجري من وسط وجنوب أفريقيا عضته غالباً ما تكون قاتلة)",
 "マンパワー": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "マンファ": "كوري جنوبي (من أو يتعلق بكوريا الجنوبية أو شعبها أو يميزهم) / كوري جنوبي (كوري من كوريا الجنوبية)",
 "マンホール": "فتحة صيانة, منهول (ثقب (عادة بغطاء مستو) يمكن للشخص من خلاله الوصول إلى هيكل تحت الأرض)",
 "マンボ": "مَامْبُو",
 "マンボウ": "سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف ظهرية وشرجية عالية وزعنفة ذيلية مختزلة إلى فص يشبه الدفة؛ توجد…)",
 "マンマンデ": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "マンマンデー": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "マンモグラフィ": "تصوير الثدي بالأشعة (إجراء تشخيصي للكشف عن أورام الثدي باستخدام الأشعة السينية)",
 "マンモグラフィー": "تصوير الثدي بالأشعة (إجراء تشخيصي للكشف عن أورام الثدي باستخدام الأشعة السينية)",
 "マンモス": "مَامُوث / ضَخْم, هَائِل",
 "マンモスぞう": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "マンモスゾウ": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "マンモス像": "ماموث شمالي, ماموث صوفي (ماموث كثيف الشعر كان شائعاً في المناطق الباردة من نصف الكرة الشمالي)",
 "マンモン": "المال (كإله), المامون (الثروة باعتبارها تأثيراً شريراً)",
 "マンリョウ": "توت التوابل, توت المرجان (شجيرة ذات توت أحمر مرجاني؛ اليابان إلى شمال الهند) / توت المرجان, كشمش هندي (شجيرة نفضية من أمريكا الشمالية تزرع لعناقيدها الغزيرة من الثمار الحمراء المرجانية الشبيهة بالتوت)",
 "マン・イーター": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر) / آكل لحوم البشر (شخص يأكل اللحم البشري)",
 "マン島": "جَزِيرَة مَانْ",
 "マン島語": "قط مانكس (سلالة قصيرة الشعر عديمة الذيل يعتقد أنها نشأت في جزيرة مان) / مانكسي (من أو متعلق بجزيرة مان أو سكانها أو لغتهم) / المانكية, لغة مانكس (الغيلية القديمة التي كان يتم التحدث بها سابقًا في جزيرة مان؛ تُستخدم اللغة أحيانًا في المناسبات الاحتفالية)\nمثال: صناعة صيد الأسماك المانكسية",
 "マン毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "マン肉": "فَرْج, حِرّ",
 "マーカ": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما) / قلم تخطيط, قلم علّام (أداة كتابة لعمل علامة) / علامة, مؤشر (رمز مميز)\nمثال: كانت العوامات علامات للقناة المائية / مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة)",
 "マーカンティリズム": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات)) / مذهب تجاري, مركنتيلية (نظام اقتصادي (أوروبا في القرن الثامن عشر) لزيادة ثروة الأمة عن طريق التنظيم الحكومي لجميع المصالح التجارية للأمة)",
 "マーカンヒリズム": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات)) / مذهب تجاري, مركنتيلية (نظام اقتصادي (أوروبا في القرن الثامن عشر) لزيادة ثروة الأمة عن طريق التنظيم الحكومي لجميع المصالح التجارية للأمة)",
 "マーカー": "علامة, مؤشر (جسم بارز يُستخدم لتمييز أو تحديد شيء ما) / قلم تخطيط, قلم علّام (أداة كتابة لعمل علامة) / علامة, مؤشر (رمز مميز)\nمثال: كانت العوامات علامات للقناة المائية / مسجل النقاط (مسؤول يسجل النتيجة أثناء سير المباراة)",
 "マーカーペン": "قَلَم لَبَدِيّ, قَلَم تَحْدِيد (قَطَعَ جزءا من شيء لتزيينه وتحسينه)",
 "マーガリン": "سَمْن نَبَاتِيّ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "マーガレット": "أقحوان المارغريت, أقحوان شجيري (شجيرة معمرة من جزر الكناري لها زهور تشبه الأقحوان صفراء شاحبة عادة؛ تُصنف غالباً ضمن جنس الأقحوان) / أقحوان أبيض, أقحوان المروج (نبات أوراسي معمر طويل الساق ومورق بزهور بيضاء؛ متوطن على نطاق واسع)",
 "マーキュリー": "زِئْبَق, زَاؤُوق / حُلْبُوب",
 "マーキュロ": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "マーキュロクロム": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "マーキュロクローム": "ميربرومين, ميركوروكروم (مركب زئبقي يطبق موضعياً كمطهر؛ ميركوروكروم هي العلامة التجارية)",
 "マーキング": "تعليم, وضع علامات (فعل عمل علامة مرئية على سطح) / تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة) / علامة, وسم (نمط من العلامات) / علامة, مؤشر (رمز مميز)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "マーキングペン": "قَلَم لَبَدِيّ, قَلَم تَحْدِيد (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "マーキング・ペン": "قَلَم لَبَدِيّ, قَلَم تَحْدِيد (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "マーキーズ": "سرادق, مظلة المدخل (مظلة دائمة فوق مدخل فندق أو ما شابه) / ماركيزة (امرأة نبيلة رتبتها أقل من دوقة وأعلى من كونتيسة)",
 "マーク": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / مراعٍ, منتبه (يأخذ الحذر؛ يعطي اهتماماً وثيقاً وعميقاً) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين))\nمثال: منتبه للتحذيرات / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "マークアップ": "تَرْمِيز, تَعْلِيمَات التَّنْسِيق (تعليمات نمطية مفصلة لتنضيد الحروف لشيء سيتم طباعته؛ عادة ما يتم كتابة الترميز اليدوي على النسخة (مثل وضع خط تحت الكلمات التي سيتم تعيينها بخط مائل)) / زيادة السعر, هامش الربح (المبلغ المضاف إلى التكلفة لتحديد سعر البيع)",
 "マークアップげんご": "لغَة رقم (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "マークアップ言語": "لغَة رقم (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "マーケ": "تَسْوِيق",
 "マーケター": "بائع, مروّج (شخص يروج أو يتبادل البضائع أو الخدمات مقابل المال)",
 "マーケッティング": "تَسْوِيق",
 "マーケット": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "マーケットアナリシス": "تحليل السوق (أبحاث تسويقية تسفر عن معلومات حول السوق)",
