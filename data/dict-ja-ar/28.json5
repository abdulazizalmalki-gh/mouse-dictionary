 "メトロノーム": "مِيتْرُونُوم, مِسْرَع",
 "メトロポリス": "حَاضِرَة (خلاف البَادِيَة، وهي الأرض التي فيها عمران وزرع مثل المدن والقرى والضياع؛ المَدِينَة الكبيرة، العَاصِمَة أو المِصْر. أكثر الاستخدامات شيوعا)\nمثال: الصين حاضرة في إفريقيا.",
 "メトロポリタン": "مُطْرَان, مِطْرَان",
 "メトロポリタンエリアネットワーク": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "メトロポリタン・エリア・ネットワーク": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "メド": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "メドがたつ": "هُنَاكَ, يُوجَدُ",
 "メドが立たず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "メドが立つ": "هُنَاكَ, يُوجَدُ",
 "メドゥサ": "مَدُوزَة",
 "メドゥーサ": "مَدُوزَة",
 "メドック": "ميدوك (نبيذ بوردو الأحمر من منطقة ميدوك بجنوب غرب فرنسا)",
 "メドハギ": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "メドレー": "مزيج موسيقي, ميدلي (تأليف موسيقي يتكون من سلسلة من الأغاني أو القطع الموسيقية الأخرى من مصادر مختلفة)",
 "メナジェリー": "حديقة حيوان (المنشأة التي تُؤوي الحيوانات البرية للعرض) / مجموعة حيوانات, معرض حيوانات (مجموعة من الحيوانات الحية للدراسة أو العرض)",
 "メニエールびょう": "داء مينيير (مرض في الأذن الداخلية يتميز بنوبات من الدوخة وطنين الأذن وفقدان السمع التدريجي)",
 "メニエール病": "داء مينيير (مرض في الأذن الداخلية يتميز بنوبات من الدوخة وطنين الأذن وفقدان السمع التدريجي)",
 "メニスカス": "هِلَالَة",
 "メニュー": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة / جَدْوَل, جَدْوَل أَعْمَال",
 "メヌエット": "مينويت (رقصة بلاط فخمة في القرن السابع عشر) / مينويت (قطعة موسيقية مهيبة مؤلفة لرقص المينويت؛ غالباً ما تُدمج في سوناتا أو متتالية)",
 "メネジ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "メネジメント": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "メノウ": "عقيق",
 "メノナイト": "مينوني (عضو في حركة تجديدية العماد في هولندا تشتهر ببساطة الحياة)",
 "メノポーズ": "إِيَاس",
 "メノモッソ": "أقل سرعة, مينو موسو (يعزف بسرعة مخفضة؛ أقل سرعة)",
 "メノラー": "مَنَارَة (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن) / مِنُورَة / الشَّمْعَدَان السَّبَاعِيّ / مِينُورَاه",
 "メノルカ島": "مَنُورَقَة",
 "メノ・モッソ": "أقل سرعة, مينو موسو (يعزف بسرعة مخفضة؛ أقل سرعة)",
 "メノーラー": "مَنَارَة (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن) / مِنُورَة / الشَّمْعَدَان السَّبَاعِيّ / مِينُورَاه",
 "メバチコ": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "メヒコ": "الْمَكْسِيك, الميكسيك (دولة في الشطر الجنوبي من قارة أمريكا الشمالية؛ اسمها الرسمي الولايات المتحدة المكسيكية، وعاصمتها مدينة مكسيكو)\nمثال: قامت ثورة في المكسيك.",
 "メビバイト": "ميبي بايت, ميغابايت (وحدة معلومات تساوي 1024 كيبي بايت أو 2 أس 20 (1,048,576) بايت)"
}
