 "ミスティフィケーション": "تضليل, تعمية (نشاط حجب فهم الناس وتركهم في حيرة أو ارتباك) / أحجية, شيء مُحيّر (شيء مصمم لإثارة الحيرة أو الإرباك) / ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "ミスティー": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم) / ضَبَابِيّ (مبلَّل بالضباب الخفيف)",
 "ミステイク": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "ミステリ": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "ミステリアス": "غَامِض",
 "ミステリィ": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "ミステリー": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "ミステリーかまきり": "فَرَس اَلنَّبِيّ (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "ミステリーしょうせつ": "رواية بوليسية, رواية غموض (رواية يُتحدى فيها القارئ لحل لغز قبل أن يشرحه المحقق في النهاية)",
 "ミステリー小説": "رواية بوليسية, رواية غموض (رواية يُتحدى فيها القارئ لحل لغز قبل أن يشرحه المحقق في النهاية)",
 "ミステーク": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "ミスディレクション": "تشتيت, صرف الانتباه (عملية التشتيت؛ صرف انتباه شخص ما عن شيء ما) / سوء إدارة (إدارة مهملة أو غير فعالة) / تَضْلِيل, تَوْجِيه خَاطِئ (توجيهات أو تعليمات غير صحيحة) / توجيه خاطئ (توجيه غير صحيح لهيئة المحلفين يقدمه القاضي)\nمثال: السحرة خبراء في صرف الانتباه",
 "ミスト": "سَدِيم",
 "ミストラル": "رياح الميسترال (رياح شمالية قوية تهب في فرنسا خلال الشتاء)",
 "ミストレス": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "ミスファイア": "إخفاق, طيش (الفشل في إصابة الهدف (أو المقابلة أو الإيجاد، إلخ)) / فشل الاشتعال, كبوة (انفجار يفشل في الحدوث)",
 "ミスフォーチュン": "مُصِيبَة, شَقْوَة",
 "ミスプリ": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "ミスプリント": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "ミスプレー": "خطأ ((بيسبول) فشل لاعب مدافع في إخراج الخصم عندما كان اللعب العادي كافياً لذلك)",
 "ミスマッチ": "غير متطابق, غير متكافئ (تطابق سيء أو غير مناسب)",
 "ミスミソウ": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…)",
 "ミスリーディング": "مُضَلِّل",
 "ミスリード": "مُضَلِّل",
 "ミス・コンテスト": "مُسَابَقَة اَلْجَمَال",
 "ミス・スペリング": "تهجئة خاطئة, خطأ إملائي (تهجئة غير صحيحة)",
 "ミズ": "سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية)) / مخطوطة (شكل العمل الأدبي المقدم للنشر) / ماجستير العلوم (درجة الماجستير في العلوم) / تصلب متعدد (اضطراب عصبي تدريجي مزمن ينطوي على فقدان غمد المايلين حول ألياف عصبية معينة)",
 "ミズカマキリ": "عقرب الماء (حشرة مائية طويلة الأرجل لها أرجل أمامية مهيأة للإمساك بالفريسة وبطن ممتد بأنبوب تنفس طويل)",
 "ミズガルズ": "ميدغارد ((الأساطير الإسكندنافية) مسكن البشر في الأساطير الإسكندنافية)",
 "ミズキ": "شجرة القرانيا, قرانيا (شجرة أو شجيرة من جنس قرانيا غالباً ما يكون لها قنابات مبهرجة تشبه الزهور) / خشب القرانيا (خشب صلب قوي لأي قرانيا من جنس كورنوس؛ يشبه خشب البقس)",
 "ミズゴケ": "سفاغنوم, طحلب الخث (أي من الحزازيات الشاحبة أو الرمادية المختلفة من جنس سفاغنوم التي تشكل بقاياها المتحللة الخث)",
 "ミズスマシ": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "ミズナギドリ": "نوء (طائر صغير نسبياً طويل الجناحين أنبوبي الأنف يطير بعيداً عن اليابسة)",
 "ミズブカ": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "ミズメ": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "ミズワラビ": "جنية الماء (جنية تسكن الماء) / سرخس عائم, عفريت الماء (سرخس مائي في أمريكا الاستوائية يستخدم غالباً في أحواض السمك)",
 "ミズーリ": "مِيزُورِي",
 "ミセク": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "ミセス": "سَيِّدَة, مَدَام",
 "ミセズ": "سَيِّدَة, مَدَام",
