 "リアタイ": "زَمَن حَقِيقِيّ",
 "リアトリス": "ريشة غاي, ليآتريس (أي من نباتات أمريكا الشمالية المتنوعة من جنس ليآتريس ذات نورات عنقودية أو عثكولية من رؤوس الزهور القرصية الصغيرة) / نجمة ساطعة (نبات ثنائي الحول من جنوب غرب الولايات المتحدة له سيقان بيضاء وأوراق مسننة يُزرع لزهوره الصفراء الشاحبة الكبيرة التي تتفتح في الصباح الباكر)",
 "リアライズ": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "リアリスティック": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "リアリスト": "وَاقِعِيّ",
 "リアリズム": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "リアリティ": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / وَاقِع (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "リアリティばんぐみ": "تِلِفِزْيُون الْوَاقِع (تِلْفَاز)\nمثال: لنشاهد التلفزيون.",
 "リアリティー": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / وَاقِع (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "リアリティーばんぐみ": "تِلِفِزْيُون الْوَاقِع (تِلْفَاز)\nمثال: لنشاهد التلفزيون.",
