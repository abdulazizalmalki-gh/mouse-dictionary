 "良くある質問": "أَسِئْلَة مُكَرَّرَة",
 "良くする": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "良くできました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "良くないね": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "良くなる": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "良く出来ました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "良く考えたら": "فِعْلًا",
 "良さ": "جَدَارَة",
 "良し": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "良しとする": "قِيمَة",
 "良しなに": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "良し悪し": "نَوْعِيَّة, جَوْدَة",
 "良人": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "良化": "تَحْسِين",
 "良好": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "良心": "ضَمِير (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر) / طَوِيَّة / وِجْدَان\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "良心の囚人": "سَجِين الرَأْي",
 "良心的": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "良性": "كَرِيم, لَطِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "良知": "حَدْس (الحَدْس: الوَطْءُ، وَقد حَدَسَ برِجلِه الشيءَ، إِذا وَطِئَه؛ الحَدْس: الغَلَبَةُ فِي الصِّراعِ، يُقَال: حَدَسَ بالرجُلِ يَحْدِسُه حَدْسَاً : صَرَعَه وضَرَبَ بِهِ الأرضَ)",
 "艱苦": "مَشَقَّة, شِدَّة",
 "艱難": "مَشَقَّة, شِدَّة",
 "艱難苦労": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "艱難辛苦": "مَشَقَّة, شِدَّة",
 "色": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟ / بَشْرَة / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "色々": "مُخْتَلِف, مُتَنَوَّع",
 "色あせる": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
