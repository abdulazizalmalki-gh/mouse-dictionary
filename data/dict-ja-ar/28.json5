 "ホログラフィ": "تصوير مجسم, هولوغرافيا (فرع البصريات الذي يتعامل مع استخدام الضوء المتماسك من الليزر لعمل صورة ثلاثية…)",
 "ホログラフィック": "هُولُوغْرَافِيّ (مكتوب بالكامل بخطّ يد المُوَقِّع)\nمثال: وثيقة بخط اليد",
 "ホログラフィー": "تصوير مجسم, هولوغرافيا (فرع البصريات الذي يتعامل مع استخدام الضوء المتماسك من الليزر لعمل صورة ثلاثية…)",
 "ホログラム": "صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة…)",
 "ホロコースト": "مُحْرَقَة",
 "ホロスコープ": "خَرِيطَةُ الْبُرُوج, أَبْرَاج (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "ホロドモール": "هُولُودُومُور",
 "ホロムイイチゴ": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "ホロー": "أَجْوَف",
 "ホロ苦い": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية…)\nمثال: الكعكة حلوة جدا",
 "ホワイ": "لِمَاذَا\nمثال: لم يساعدني أحد.",
 "ホワイエ": "بَهْو",
 "ホワイティング": "بياض",
 "ホワイト": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض. / مُصَحِّح",
 "ホワイトアウト": "بياض شامل, تعتيم ثلجي (حالة جوية قطبية بوجود سحب فوق الثلج تنتج بياضاً موحداً وتصعب رؤية الأشياء؛ تحدث…)",
 "ホワイトカラー": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "ホワイトゴールド": "ذهب أبيض (سبيكة شاحبة اللون من الذهب عادة مع البلاتين أو النيكل أو البلاديوم)",
 "ホワイトシャツ": "قَمِيص (المَشِيْمَة؛ ثَوْب بكمين مخيط غير مفرج يلبس تحت الثياب ولا يكون إلا من القطن أو…)\nمثال: لديه قميص أسود.",
 "ホワイトソース": "صلصة البشاميل, صلصة بيضاء (حليب مكثف بمزيج من الزبدة والدقيق (رو))",
 "ホワイトタイ": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال)",
 "ホワイトチョコレート": "شوكولاتة بيضاء (مزيج من زبدة الكاكاو ومواد صلبة من الحليب والسكر والفانيليا؛ تستخدم في ألواح…)",
 "ホワイトティップバタフライフィッシュ": "جَزِيرَة عِيد اَلْفِصْح, جَزِيرَة الْفِصْح",
 "ホワイトナイト": "الفارس الأبيض (شركة تكون مستحوذاً ودوداً في عملية استحواذ)",
 "ホワイトニング": "تبييض, تفتيح (التغيير إلى لون أفتح)",
 "ホワイトノイズ": "ضوضاء بيضاء (ضوضاء ناتجة عن محفز يحتوي على جميع ترددات الاهتزاز المسموعة)\nمثال: الضوضاء البيضاء عامل حجب جيد",
 "ホワイトハウス": "الْبَيْت الْأَبْيَض\nمثال: لنعد إلى البيت.",
 "ホワイトハッカー": "هَاكِر",
 "ホワイトハット": "هَاكِر",
 "ホワイトハットハッカー": "هَاكِر",
 "ホワイトバックラッシュ": "رد فعل البيض العنيف (رد فعل عنيف من قبل العنصريين البيض ضد تقدم الحقوق المدنية للسود)",
 "ホワイトペッパー": "فلفل أبيض (فلفل يطحن من حبوب الفلفل المقشرة)",
 "ホワイトページ": "الصفحات البيضاء (دليل هاتف أو قسم من دليل (مطبوع عادة على ورق أبيض) حيث يتم سرد أسماء الأشخاص…)",
 "ホワイトペーパー": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "ホワイトボード": "سَبُورَة بَيْضَاء",
 "ホワイトミート": "صدر, لحم أبيض (اللحم المقطع من صدر الطائر)",
 "ホワイトメタル": "معدن أبيض, معدن المحامل (سبيكة (غالباً ما تكون أساسها الرصاص أو القصدير) تستخدم للمحامل)",
