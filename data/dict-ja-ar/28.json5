 "マンション": "مجمع سكني تمليك (إسكان يتكون من مجمع من الوحدات السكنية (كمبنى سكني) تكون فيه كل وحدة مملوكة بشكل فردي) / شقة تمليك (واحدة من الوحدات السكنية في مجمع سكني تمليك)\nمثال: 私のおじはマンションに住んでいる。 — يسكن عمي في شقة.",
 "マンシ語": "الفوغول, المانسي (اللغة الأوغرية (المرتبطة بالمجرية) التي يتحدث بها الفوغول)",
 "マンジュギク": "قطيفة فرنسية (نبات سنوي كثيف قوي الرائحة برؤوس زهور برتقالية أو صفراء معلمة باللون الأحمر؛ المكسيك وغواتيمالا)",
 "マンジュシャゲ": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "マンス": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "マンスリー": "شَهْرِيّ / شَهْرِيًّا",
 "マンズリ": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "マンセー": "بانزاي (هتاف ياباني للحماس أو النصر)",
 "マンタ": "شيطان البحر, مانتا (سمكة راي استوائية ضخمة للغاية تعيش في عرض البحر وتتغذى على العوالق والأسماك الصغيرة؛ عادة ما تكون غير ضارة ولكن حجمها يجعلها خطيرة إذا تم صيدها بالرمح) / مانتا (بطانية تستخدم كعباءة أو شال)",
 "マンダラ": "ماندالا (أي من التصاميم الهندسية المختلفة (عادة دائرية) ترمز للكون؛ تستخدم بشكل رئيسي في الهندوسية والبوذية كأداة مساعدة للتأمل)",
 "マンダリン": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة",
 "マンチェゴ": "مَنْتْشِيغُو",
 "マンチェスター": "مَانْشِسْتِر, مَانْشِسْتَر",
 "マンツーマン": "بصراحة, كرجل لرجل (بشكل مباشر أو صريح) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / أَمِين, صَرِيح (مُبَاشِر وَصَادِق)\nمثال: يجب أن نتحدث كرجل لرجل",
 "マンツーマンディフェンス": "بصراحة, كرجل لرجل (بشكل مباشر أو صريح) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / أَمِين, صَرِيح (مُبَاشِر وَصَادِق)\nمثال: يجب أن نتحدث كرجل لرجل",
 "マンツーマンレッスン": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / فَرْدِيّ, وَجْهًا لِوَجْه (بين شخصين مباشرةً)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "マンツーマン・ディフェンス": "بصراحة, كرجل لرجل (بشكل مباشر أو صريح) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / أَمِين, صَرِيح (مُبَاشِر وَصَادِق)\nمثال: يجب أن نتحدث كرجل لرجل",
 "マンツーマン・レッスン": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / رَجُلٌ لِرَجُل, فَرْدِيّ (نظام لعب يراقب فيه كل لاعب دفاعيّ لاعبًا هجوميًّا بعينه) / فَرْدِيّ, وَجْهًا لِوَجْه (بين شخصين مباشرةً)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "マンティコア": "مانتيكور (وحش أسطوري له رأس إنسان (بقرون) وجسم أسد وذيل عقرب)",
 "マンティス": "فَرَس اَلنَّبِيّ, سُرْعُوف (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "マンティラ": "رداء نسائي قصير, مانتيلا (رداء قصير ترتديه النساء) / مانتيلا (وشاح نسائي من الحرير أو الدانتيل)",
 "マンティーラ": "رداء نسائي قصير, مانتيلا (رداء قصير ترتديه النساء) / مانتيلا (وشاح نسائي من الحرير أو الدانتيل)",
 "マンティーリャ": "رداء نسائي قصير, مانتيلا (رداء قصير ترتديه النساء) / مانتيلا (وشاح نسائي من الحرير أو الدانتيل)",
