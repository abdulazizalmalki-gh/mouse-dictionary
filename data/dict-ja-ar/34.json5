 "反対尋問": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء…)",
 "反対弁論": "رد المدعى عليه الثاني (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "反対意見": "رأي مخالف (رأي يختلف مع تصرف المحكمة في القضية)",
 "反対投票": "استبعاد, حظر (فعل استبعاد شخص ما عن طريق تصويت سلبي أو حق النقض)",
 "反対票": "بَل (أصابه ماء كثير أو سائل آخر مشابه للماء؛ الشخصُ الشيءَ: صبّ عليه ماء كثير أو غمس…)\nمثال: ليس أنا ، بل أنت!",
 "反対給付": "واحدة بواحدة",
 "反対者": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية))\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه",
 "反対訊問": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء…)",
 "反対語": "عَكْس",
 "反対貿易風": "رياح عكسية تجارية (رياح تهب من الغرب إلى الشرق وتقع فوق الرياح التجارية في المناطق المدارية)",
 "反対陣営": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "反射": "اِنْعِكَاس, عَكْس / مُنْعَكَس",
 "反射代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "反射作用": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "反射性": "تأمل, تفكر (القدرة على التفكير الهادئ أو التأمل) / انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه)",
 "反射指示": "انْعِكَاسِيَّة ((المنطق والرياضيات) علاقة تكون قائمة بين العنصر ونفسه)",
 "反射指示代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "反射望遠鏡": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة…)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反射材": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة…)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反射板": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة…)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反射波": "صَدًى",
 "反射炉": "فرن عاكس (فرن يتم فيه تسخين المواد المعالجة بشكل غير مباشر بواسطة اللهب الموجه إلى سقف…)",
 "反射率": "اِنْعِكَاسِيَّة, مُعَامِل الِانْعِكَاس (جزء الطاقة الإشعاعية الذي ينعكس عن سطح ما)",
 "反射療法": "ريفلعكسولوجي, علم المنعكسات (تدليك لتخفيف التوتر عن طريق ضغط الأصابع؛ يعتمد على الاعتقاد بوجود نقاط انعكاسية…)",
 "反射的": "اِنْعِكَاسِيّ, ذَاتِيّ المَرْجِع (يشير ويرجع إلى نفسه)",
 "反射的に": "انعكاسياً, بشكل لا إرادي (بطريقة انعكاسية؛ بواسطة ردود الفعل)\nمثال: أجابت بشكل لا إرادي",
 "反射神経": "مُنْعَكَس",
 "反射能": "البَيَاض, القُدْرَة العَاكِسَة (نسبة الضوء المنعكس إلى الضوء الساقط)",
 "反射角": "زاوية الانعكاس (الزاوية بين شعاع منعكس وخط عمودي على السطح العاكس عند نقطة السقوط)",
 "反射運動": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "反射鏡": "تلسكوب عاكس (تلسكوب بصري يتكون من مرآة مقعرة كبيرة تنتج صورة يتم تكبيرها بواسطة العدسة…)\nمثال: اخترع إسحاق نيوتن التلسكوب العاكس في عام 1668",
 "反徒": "مُتَمَرِّد, مُتَمَرِّدَة",
 "反復": "تَكْرَار, إِعَادَة / إعادة إنتاج, استنساخ (فعل عمل نسخ)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير / عَوْدِيَّة",
 "反復性": "تكرار (إطناب ناتج عن التكرار المفرط) / مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة)\nمثال: حركة تكرارية",
 "反復的": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة)\nمثال: حركة تكرارية",
 "反応": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "反応中間体": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "反応性": "استجابة, تفاعلية (الاستجابة للتحفيز)",
 "反応時間": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
