 "古風": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "古高ドイツ語": "الألمانية العليا القديمة (الألمانية العليا قبل 1200)",
 "句": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة! / نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ…)\nمثال: نظم سامي كل شيء. / هَايْكُو",
 "句動詞": "فعل مركب (فعل إنجليزي يتبعه حرف أو أكثر حيث يتصرف المزيج كوحدة نحوية ودلالية)",
 "句構造文法": "بناء الجملة, نحو (الترتيب النحوي للكلمات في الجمل)",
 "句構造規則": "بناء الجملة, نحو (الترتيب النحوي للكلمات في الجمل)",
 "句法": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "句点": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "句読": "عَلَامَة تَرْقِيم, تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "句読点": "عَلَامَة تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "句調": "أسلوب الكتابة, نوع أدبي (نمط للتعبير عن النفس في الكتابة)",
 "叩いた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "叩き": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة / خبطة, ضربة قوية (ضربة قوية)\nمثال: الضربة المفاجئة طرحته أرضاً / سَرِقَة, لُصُوصِيَّة / مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "叩きつける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "叩きのめす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩きを掛ける": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "叩き上げ": "عِصَامِيّ",
 "叩き付ける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "叩き伏せる": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩き出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "叩き切る": "اِخْتَرَقَ",
 "叩き割る": "كَسَّرَ",
 "叩き台": "قرمة, لوح التقطيع (كتلة خشبية ثابتة يمكن تقطيع الطعام أو تقطيعه إلى مكعبات عليها أو شق الخشب عليها)",
 "叩き合う": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء.",
 "叩き斬る": "اِخْتَرَقَ",
 "叩き潰す": "كَسَّرَ / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "叩き落す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩き落とす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "叩く": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / حَمْلَة / بَاوْنْد / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة. / صَفْعَة, لَطْمَة\nمثال: صفع المدرس مؤخرتي.",
 "叩っ斬る": "اِخْتَرَقَ",
 "叩打": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "叩解": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "叩頭": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "叩頭く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "叩頭虫": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "叩首": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "只ならない": "غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي / غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن…)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "只に": "بِالْكَاد",
 "只の人": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "只中": "مُنْتَصَف, وَسَط / فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "只今": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن. / آنِفاً / حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "只木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "只言": "كَلَام مُبَاشِر, مُقْتَبَس",
 "叫び": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "叫び声": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "叫ぶ": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة. / جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "叫る": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "叫んだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "叫喚": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)\nمثال: صرخ طالبا النجدة.",
 "叫声": "صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "召される": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "召し": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "召し上がりもの": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "召し上がり物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "召し上がる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "召し上げる": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد / يَسْتَحْضِر, يَسْتَدْعِي",
 "召し上り物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "召し使い": "خَادِم, خَادِمَة",
 "召し使う": "وَظَّفَ",
 "召し出す": "يَسْتَحْضِر, يَسْتَدْعِي",
