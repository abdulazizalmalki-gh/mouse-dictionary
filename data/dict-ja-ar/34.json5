 "呼びつける": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びよせる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼びりん": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "呼び付け": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "呼び付ける": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び値": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "呼び入れる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び出し": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه. / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "呼び出し側": "طَازَج (طَازَج وَجَدِيد)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "呼び出し時間": "وقت الوصول ((في علم الحاسوب) الفترة بين طلب البيانات من قبل النظام ووقت توفير البيانات…)\nمثال: وقت الوصول هو مجموع وقت البحث وكمون الدوران ووقت معالجة الأوامر",
 "呼び出し状": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "呼び出し符号": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا.",
 "呼び出し電話": "رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "呼び出し音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "呼び出す": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري) / دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び名": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "呼び声": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び売り": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "呼び子": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "呼び寄せる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び屋": "مُرَوِّج",
 "呼び戻す": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "呼び掛け": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び掛ける": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن…)\nمثال: لا أتحمل البرد. / اِلْتِمَاس, اِسْتِئْنَاف",
 "呼び樋": "كُوع, مِرْفَق",
 "呼び止める": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن…)\nمثال: لا أتحمل البرد.",
 "呼び水": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض)\nمثال: الهدف من الفن هو إثارة العواطف",
 "呼び水式経済政策": "تحضير المضخة (إدخال الماء في المضخة لتحسين الختم وبدء تدفق المياه)",
 "呼び覚ます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق / اِسْتَحْضَارَ, اِسْتَدَعَى",
 "呼び起こす": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び込み": "كلب (مصطلحات غير رسمية للكلاب)",
 "呼び込む": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼び返す": "ٱسْتَدْعى\nمثال: ليلى تذكر سامي.",
 "呼び鈴": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "呼び集める": "اِجْتَمَعَ (ضد تَفَرَّقَ، كانوا جَمِيْع، أو كانوا مع بعض؛ الناس على كذا: ضدّ تَفَرَّقُوْا…)\nمثال: اجتمع الناس في المتنزه.",
 "呼ぶ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / يَسْتَحْضِر, يَسْتَدْعِي / دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "呼ぶ子": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "呼んだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "呼値": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "呼入れる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼出": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه. / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "呼出し": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه. / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "呼出し電話": "رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "呼出し音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "呼出す": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري) / دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
