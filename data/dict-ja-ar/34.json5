 "告ぐ": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "告げる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "告げ口": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)",
 "告別": "وَدَاع\nمثال: قال زيري وداعا.",
 "告別式": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)",
 "告文": "تقرير, تقرير مكتوب (وثيقة مكتوبة تصف نتائج فرد أو مجموعة ما)\nمثال: هذا يتفق مع الدراسة الحديثة التي أجراها هيل وديل",
 "告発": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما)\nمثال: الكتاب هو لائحة اتهام للفلسفة الحديثة",
 "告発状": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما)",
 "告発者": "شَاكٍ",
 "告白": "إِقْرَار, اِعْتِرَاف / مِهْنَة\nمثال: ما وظيفة زوجتك؟",
 "告白録": "إِقْرَار, اِعْتِرَاف",
 "告知": "لَاحَظَ",
 "告知板": "لَوْحَة إِعْلَانَات",
 "告示": "لَاحَظَ",
 "告示板": "لَوْحَة إِعْلَانَات",
 "告解": "إِقْرَار, اِعْتِرَاف",
 "告解場": "كرسي الاعتراف, كشك الاعتراف (كشك يجلس فيه الكاهن لسماع الاعترافات)",
 "告解師": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران)",
 "告訴": "اِتِّهَام",
 "告訴人": "شَاكٍ",
 "告達": "إِشْعَار, إِخْطَار",
 "呑み": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "呑み助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑み口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "呑み屋": "حَانَة, بَار / مُؤَلِّف, كَتَّاب / حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو)",
 "呑み師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "呑み歩き": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "呑み行為": "دَلْو, سَطْل",
 "呑み込み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "呑み込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "呑み込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "呑み込む": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ",
 "呑む": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / دُخَان, دخان\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "呑んでかかる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "呑んで掛かる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "呑兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "呑口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "呑師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "呑気症": "بلع الهواء (ابتلاع الهواء (يتبعه عادة تجشؤ وانزعاج وانتفاخ))",
 "呑気者": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "呑舟の魚は枝流に游がず": "بُطُولِيّ, مَلْحَمِيّ (مهيب ومثير للإعجاب؛ يتجاوز المألوف خاصة في الحجم أو النطاق)",
 "呟き": "لَغَط, طَبْطَبَة / تَغْرِيدَة",
 "呟きサイト": "تدوين مصغر (مدونة يتم فيها تحديد طول التدوينات الفردية (مثل تويتر))",
 "呟きブログ": "تدوين مصغر (مدونة يتم فيها تحديد طول التدوينات الفردية (مثل تويتر))",
 "呟く": "غَمْغَمَة, تَمْتَمة / تَغْرِيدَة",
 "呦々": "بَاكٍ / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "呦呦": "بَاكٍ / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "周": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / تشو, سلالة تشو (السلالة الإمبراطورية للصين من 1122 إلى 221 قبل الميلاد؛ اشتهرت بظهور…)",
 "周り": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "周到": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "周回": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة. / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "周回軌道": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "周囲": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "周囲長": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "周圏": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "周密": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)\nمثال: أرسل المنتجون الأقل نزاهة حزماً كانت مخادعة في مظهرها",
 "周年": "إِلَى أَقْصَى حَدٍّ, اَلنُّونِيّ (الأخير أو الأعظم في سلسلة كبيرة غير محددة)",
 "周旋": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين / مكتب عمل, وكالة توظيف (وكالة تجد أشخاصاً لشغل وظائف معينة أو تجد وظائف للعاطلين عن العمل)",
 "周旋人": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "周旋屋": "سِمْسَار, وَسِيط",
 "周旋料": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله)",
 "周旋業": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله)",
 "周旋業者": "سِمْسَار, وَسِيط",
 "周易": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "周期": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "周期冗長検査": "فحص التكرار الدوري (رمز لتصحيح الخطأ يُسجل في كل قطاع من القرص المغناطيسي ويُستخدم لاكتشاف الأخطاء…)",
 "周期律": "القانون الدوري, قانون مندليف ((كيمياء) المبدأ القائل بأن الخواص الكيميائية للعناصر هي دوال دورية لأعدادها…)",
 "周期性": "دَوْرِيَّة (صفة التكرار على فترات منتظمة) / دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "周期性嘔吐症": "مِئَة وَخَمْسَة (يَدُلُّ عَلَى العَدَد 105)",
 "周期的": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "周期表": "الْجَدْوَلُ الدَّوْرِيّ",
 "周波": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "周波変調": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波帯": "حزمة موجية, نطاق التردد (نطاق من الترددات الراديوية المتجاورة (مثل تلك المخصصة لنقل إشارات الراديو أو…)",
 "周波数": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "周波数変調": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波数変調方式": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波数変調記録": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "周波数帯": "حزمة موجية, نطاق التردد (نطاق من الترددات الراديوية المتجاورة (مثل تلك المخصصة لنقل إشارات الراديو أو…)",
 "周波数特性": "استجابة ترددية ((في الإلكترونيات) منحنى يمثل نسبة المخرجات إلى المدخلات لمحول الطاقة كدالة…)",
 "周産期学": "طب الفترة المحيطة بالولادة (فرع التوليد المعني بتشريح وفسيولوجيا وتشخيص وعلاج اضطرابات الأم والجنين أو…)",
 "周知": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "周知の事実": "أمر معروف للجميع, معلومات عامة (أي شيء معروف عموماً للجميع)",
 "周知徹底": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "周章": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "周章狼狽": "ذعر, فزع (خوف ناتج عن الوعي بالخطر)",
 "周縁": "هُدْب (هُدْبُ العين ما نبت من الشعر على أشفارها)",
 "周縁化": "تهميش (العملية الاجتماعية المتمثلة في التحول إلى هامشي أو جعله هامشياً (خاصة كمجموعة…)\nمثال: تهميش الطبقة الدنيا",
 "周縁部": "أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما)",
 "周航": "طواف حول العالم (السفر حول شيء ما (بالسفينة أو الطائرة))\nمثال: أثبت طواف ماجلان حول الأرض أنها كروية",
 "周転円": "فَلَك التَّدوِير (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "周辺": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية)\nمثال: المقاطعات الطرفية لروسيا",
 "周辺化": "تهميش (العملية الاجتماعية المتمثلة في التحول إلى هامشي أو جعله هامشياً (خاصة كمجموعة…)\nمثال: تهميش الطبقة الدنيا",
 "周辺機器": "طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية)\nمثال: المقاطعات الطرفية لروسيا",
 "周辺装置": "جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية…)\nمثال: محركات الأقراص والطابعات هي أجهزة طرفية مهمة",
 "周辺視覚": "رؤية جانبية, رؤية محيطية (الرؤية عند حواف المجال البصري باستخدام محيط الشبكية فقط)",
 "周辺視野": "رؤية جانبية, رؤية محيطية (الرؤية عند حواف المجال البصري باستخدام محيط الشبكية فقط)",
 "周遊": "رِحْلَة",
 "周長": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "周防": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "呪": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة / تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية…)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا / تَعْوِيذَة",
 "呪い": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
