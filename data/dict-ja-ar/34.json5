 "南アメリカ": "أَمْرِيكَا الْجَنُوبِيَّة, أَمِيرِكَا الْجَنُوبِيَّة",
 "南アランド": "رَانْد",
 "南オポッサム": "أبوسوم شائع (أبوسوم قارت من شرق الولايات المتحدة؛ يشتهر بالتظاهر بالموت عند الخطر؛ يُقدر…)",
 "南オーストラリア": "جُنُوب أُسْتْرَالِيَا, أستراليا الجنوبية (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)",
 "南オーストラリア州": "جُنُوب أُسْتْرَالِيَا, أستراليا الجنوبية (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "南シナ海": "بَحْر الصِّين الْجَنُوبِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "南スーダン": "جَنُوب السُّودَان (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
