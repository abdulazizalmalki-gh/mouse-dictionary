 "呼出符号": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا.",
 "呼出電話": "رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "呼出音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "呼名": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "呼吸": "تَنَفُس, نَفَس / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / اِنْسِجَام, تَوَافُق",
 "呼吸が合う": "انسجم, تفاهم (التمتع بعلاقات طيبة وسلسة مع الآخرين)\nمثال: أنا ورئيسي نتفاهم بشكل جيد للغاية",
 "呼吸中枢": "مركز تنفسي (المركز في النخاع المستطيل والجسر الذي يدمج المعلومات الحسية حول مستوى الأكسجين…)",
 "呼吸器": "عضو تنفسي (أي عضو يشارك في عملية التنفس)",
 "呼吸器官": "عضو تنفسي (أي عضو يشارك في عملية التنفس)",
 "呼吸器感染": "التهاب الجهاز التنفسي, عدوى الجهاز التنفسي (أي عدوى تصيب الجهاز التنفسي)",
 "呼吸器疾患": "اضطراب تنفسي, مرض تنفسي (مرض يصيب الجهاز التنفسي)",
 "呼吸器系": "جِهَاز تَنَفُّسِيّ",
 "呼吸困難": "ضيق النفس, عسر التنفس (تنفس صعب أو مجهد)\nمثال: 標高がぐんと高くなると呼吸困難を感じる。 — في الأعالي، يصعب على الناس التنفس.",
 "呼吸根": "جذر هوائي (جذر مملوء بالهواء (مغمور أو مكشوف) يمكن أن يعمل كعضو تنفسي لنبات المستنقعات)",
 "呼吸点": "حُرِيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "呼吸窮迫症候群": "متلازمة الضائقة التنفسية (مرض رئوي حاد يصيب حديثي الولادة (خاصة الخدج))",
 "呼和浩特": "هُوهِيهُوت, خُوخِيخَاوْتِي",
 "呼声": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼子": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "呼寄せる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼応": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / اِتِّفَاق, تَوَافُق",
 "呼応して": "بالتنسيق, معاً (بخطط مشتركة)\nمثال: العمل بالتنسيق",
 "呼格": "نِدَاء",
 "呼気": "زَفِير",
 "呼水": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض)\nمثال: الهدف من الفن هو إثارة العواطف",
 "呼称": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "呼起": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "呼込み": "كلب (مصطلحات غير رسمية للكلاب)",
 "呼込む": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "呼鈴": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "呼集": "جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع",
 "命": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "命からがら": "للنجاة بحياته (كما لو كانت حياتك على المحك)\nمثال: كان يركض للنجاة بحياته",
 "命が散る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "命じる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "命ずる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "命とり": "مُمِيت, قَاتِل",
 "命の恩人": "طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية)",
 "命の水": "بَاعِث لِلْحَيَاة, مُحْيٍ (يمنح أو يملك القدرة على بثّ الحياة والروح) / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول. / مَنِيّ",
 "命をつなぐ": "نَجَا",
 "命を散らす": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "命を絶つ": "اِنْتَحَرَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "命を繋ぐ": "نَجَا",
 "命中": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "命中弾": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "命令": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "命令コード": "رمز العملية, كود العملية (الجزء من مجموعة أوصاف العمليات الذي يحدد العملية التي سيتم تنفيذها؛ مجموعة…)",
 "命令一下": "مَنْقُول, مُتَوَارَث (اِنْتَقَلَ مِنْ جِيلٍ إِلَى جِيل)",
