 "合氣道": "أيكيدو (فن قتالي ياباني يستخدم مبادئ مشابهة للجودو)",
 "合法": "قَانُونِيّ",
 "合法ドラッグ": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات…)",
 "合法主義": "التزام حرفي بالقانون, قانونية حرفية (الامتثال الصارم لحرفية القانون بدلاً من روحه)",
 "合法化": "إِضْفَاء الشَّرْعِيَّة, تَقْنِين (فعل جعل الشيء قانونياً)",
 "合法性": "قَانُونِيَّة, مَشْرُوعِيَّة (صفة الامتثال للقانون)",
 "合法的": "قَانُونِيّ\nمثال: あなたは合法的手段で行動する方がよい。 — من الأحسن لك أن تسير على الطرق القانونية.",
 "合法鳥": "وَقْوَاق, وَقْوَاقِيَّة",
 "合流": "احتشاد, تجمهر (تجمع الناس معاً)\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا / اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة",
 "合流地点": "احتشاد, تجمهر (تجمع الناس معاً)\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "合流点": "احتشاد, تجمهر (تجمع الناس معاً)\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "合点": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا. / حبل البيض, كلالة (أحد شريطين حلزونيين من الأنسجة يربطان صفار البيض بالغشاء المحيط عند طرفي القشرة)",
 "合点がいく": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "合点が行く": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "合点だ": "مَفْهُوم",
 "合点承知の助": "فَهِمْتَ, فَهِمْتِ",
 "合点承知之助": "فَهِمْتَ, فَهِمْتِ",
 "合理": "عَقْلَانِيَّة (صفة الاتساق مع المنطق أو الاستناد إليه)\nمثال: ربما تكون عقلانيته قد تضررت",
 "合理主義": "عَقْلَانِيَّة",
 "合理主義者": "عَقْلَانِيّ / بَرَاغْمَاتِيّ, عَمَلِيّ (شخص يتبع نهجاً عملياً في المشاكل ويهتم أساساً بنجاح أو فشل أفعاله)",
 "合理化": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق)",
 "合理性": "عَقْلَانِيَّة (صفة الاتساق مع المنطق أو الاستناد إليه)\nمثال: ربما تكون عقلانيته قد تضررت",
 "合理的": "عَقْلَانِيّ",
 "合理論": "عَقْلَانِيَّة",
 "合瓣": "مُلْتَحِم البَتَلَات (ذو تويج مكوَّن من بتلات ملتحمة كلّيًّا أو جزئيًّا على شكل أنبوب أو قمع)",
 "合田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "合目": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "合目的": "غَرَضِيّ, مُوَجَّه نَحْوَ الهَدَف (ذو غاية وهدف محدّد)",
 "合目的性": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع)\nمثال: نهائية الموت",
 "合目的的": "مُنَاسِب تَمَامًا, وَثِيق الصِّلَة (بالغ الملاءمة والصلة بالموضوع بشكل لافت)",
 "合符": "منطقة استلام الأمتعة (منطقة في المطار حيث يمكن للمسافرين القادمين استلام الأمتعة التي تم نقلها في…)",
 "合算": "مَجْمُوع",
 "合繊": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "合肥": "خِفِي, خِيفِي (اختفى أو صار غير مرئي؛ أصبح سريًا أو مجهولًا)\nمثال: كانت لدى سامي حياة خفية.",
 "合胞体": "مُلْتَحِم خَلَوِيّ",
 "合致": "اِتِّفَاق, تَوَافُق",
 "合衆国": "اِتِّحَادِيَّة, فِدِرَالِيَّة / الْوِلَايَات الْمُتَّحِدَة الْأَمْرِيكِيَّة, الْوِلَايَات الْمُتَّحِدَة",
 "合言葉": "كَلِمَةُ سِرّ, كَلِمَةُ مُرُور (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة. / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "合計": "إجمالي, مجموع (الإجمالي النهائي أو الكلي)\nمثال: مجموع كل مشاكلنا لم يعادل البؤس الذي عانوه",
 "合調": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
