 "向かい合わせ": "وجهاً لوجه (في حضور بعضهما البعض)\nمثال: قابلت الرئيس وجهاً لوجه",
 "向かい合わせる": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "向かい波": "بحر معاكس (بحر تجري فيه الأمواج مباشرة عكس مسار السفينة)",
 "向かい火": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "向かい風": "كَوْس, رِيَاح مُضَادَّة",
 "向かう": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "向かうところ敵なし": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "向かうところ敵無し": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "向かう所敵なし": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "向かう所敵無し": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "向かっ腹": "غَضَب",
 "向か腹": "غَضَب",
 "向き": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / مَيْل, نَزَعَة / طَبِيعَة, طبيعة / أُقْنُوم",
 "向き合う": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "向き合った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "向き向き": "مُلَاءَمَة, مُنَاسَبَة (صفة امتلاك الخصائص الصحيحة لغرض معين)\nمثال: مطلب مهم هو الملاءمة للرحلات الطويلة",
 "向く": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "向ける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / لَاحَقَ\nمثال: اتبع قلبك فحسب.",
 "向こう": "هُنَاك, هُنَالِك / وِجْهَة, وُجْهَة / قَادِم\nمثال: زيري بجانب الحوض.",
 "向こうずね": "قَصَبَة",
 "向こうっ気": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
 "向こう意気": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
 "向こう正面": "إسطبل (مبنى مزرعة لإيواء الخيول أو غيرها من الماشية) / الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "向こう気": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
 "向こう脛": "قَصَبَة",
 "向こう見ず": "مُتَهَوِّر",
 "向上": "منسوب",
 "向上心": "مَطْمَح",
 "向井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "向光性": "انتحاء شمسي (استجابة توجيهية للشمس)",
 "向地性": "انتحاء أرضي (استجابة توجيهية للجاذبية)",
 "向後": "فيما بعد, من الآن فصاعداً (بعد هذا في الزمان أو الترتيب أو المكان؛ بعد هذا)\nمثال: من الآن فصاعداً لن تتلقى مصروفاً",
 "向心力": "قوة جذب مركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "向性": "انتحاء",
 "向日性": "انتحاء شمسي (استجابة توجيهية للشمس)",
 "向日葵": "زَهْرَة اَلشَّمْس, دَوَّار اَلشَّمْس",
 "向日葵油": "زيت عباد الشمس (زيت مستخرج من بذور عباد الشمس)",
 "向正面": "إسطبل (مبنى مزرعة لإيواء الخيول أو غيرها من الماشية) / الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "向点": "ذروَة (أعلى كلِّ شيء؛ أعلى نقطة أو أرفع موضع)",
 "向米": "موال لأمريكا (يدعم الولايات المتحدة وسياساتها)",
 "向米的": "موال لأمريكا (يدعم الولايات المتحدة وسياساتها)",
 "向背": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "向腹": "غَضَب",
 "向軸": "بَطْنِيّ, مُتَّجِه نَحْو المِحْوَر (الأقرب إلى أو المتجه نحو محور عضو أو كائن حي)\nمثال: يُعرف الجانب العلوي للورقة بالسطح البطني",
 "君": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَاهِل / هُوَ / سيد (صيغة خطاب للرجل) / سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية)) / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ…)\nمثال: الأستاذ على حق.",
 "君たち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "君ら": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "君主": "عَاهِل",
 "君主主義": "ملكية (الإيمان بالملكية كنظام سياسي والدعوة إليها)",
 "君主制": "مَلِكِيَّة",
 "君主制体": "مَلِكِيَّة",
 "君主国": "مَلِكِيَّة",
 "君主政": "مَلِكِيَّة",
 "君主政体": "مَلِكِيَّة",
 "君国": "مَلِكِيَّة",
 "君子": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "君影草": "زنبق الوادي, كونفالاريا (نبات معمر منخفض النمو له عادة ورقتان كبيرتان مستطيلتان سنانيتان وعنقود من…)",
 "君等": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "君臨": "حَاكِم, سَائِد (يمارس السلطة أو الحكم فعلياً) / مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة)",
 "君達": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "吝い": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "吝かでない": "حَاضِر, مُسْتَعِدّ\nمثال: جهز زيري حقائبه.",
 "吝かではない": "حَاضِر, مُسْتَعِدّ\nمثال: جهز زيري حقائبه.",
 "吝かでは無い": "حَاضِر, مُسْتَعِدّ\nمثال: جهز زيري حقائبه.",
 "吝かで無い": "حَاضِر, مُسْتَعِدّ\nمثال: جهز زيري حقائبه.",
 "吝し": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)",
 "吝ん坊": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "吝嗇": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "吝嗇ん坊": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "吝嗇家": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "吟": "تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "吟じる": "أُهْزُوجَة, أَهَازِيج / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "吟ずる": "أُهْزُوجَة, أَهَازِيج / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "吟味": "فَائِز, فَائِزَة",
 "吟味役": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / فَائِز, فَائِزَة",
 "吟唱": "حَيْثِيَّة",
 "吟詠": "تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "吟誦": "حَيْثِيَّة",
 "吟遊詩人": "تروبادور, مغني شعبي (مغنٍ للأغاني الشعبية والفلكلورية)",
 "吠えたてる": "نَبَحَ, يَنْبَح",
 "吠える": "نَبَحَ, يَنْبَح / عُوَاء\nمثال: كيف لي أن أعرف؟ / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه)\nمثال: سأساعدك يا صاح.",
 "吠え出す": "نَبَحَ, يَنْبَح",
 "吠え声": "نَبَحَ, يَنْبَح",
 "吠え立てる": "نَبَحَ, يَنْبَح",
 "吠猿": "العواء, سعدان العواء (قرد يعيش في غابات أمريكا الجنوبية الاستوائية، يتميز بصيحات عواء عالية)",
 "吠瑠璃": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "否": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "否々乍ら": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "否が応でも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "否が応にも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "否でも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "否でも応でも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "否む": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / نَفَى / كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود.",
 "否めない": "لا جدال فيه, لا يمكن إنكاره (لا يمكن نفيه أو دحضه)",
 "否も応もなく": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "否も応も無く": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "否や": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / اِعْتَرَاض",
 "否否乍ら": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "否定": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد. / نَفْي",
 "否定的": "سَلْبِيّ",
 "否応なし": "إِجْبَارِيّ, إِلْزَامِيّ",
 "否応なしに": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك)\nمثال: هو كذلك بالضرورة",
 "否応無し": "إِجْبَارِيّ, إِلْزَامِيّ",
 "否応無しに": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك)\nمثال: هو كذلك بالضرورة",
 "否決": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "否認": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد.",
 "否運": "مُصِيبَة, شَقْوَة",
 "含ます": "اِبْتَلَّ",
 "含ませる": "اِبْتَلَّ",
 "含み": "تَلَازُم",
 "含みおく": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "含み損": "خسارة غير محققة, خسارة ورقية (خسارة غير محققة في استثمار محسوبة بطرح سعر السوق الحالي من تكلفة المستثمر)",
 "含み益": "ربح غير محقق, ربح ورقي (ربح غير محقق في استثمار محسوب بطرح تكلفة المستثمر من سعر السوق الحالي)",
 "含み笑い": "اِبْتِسَامَة, بَسْمَة",
 "含み置く": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "含む": "اِحْتَوَى, تَضَمَّنَ / ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "含める": "تضمن / لقَّن",
 "含味": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "含嗽": "تَمَضْمَضَ, غَرْغَرَ",
 "含嗽剤": "غَسُولُ فَمّ",
 "含嗽薬": "غَسُولُ فَمّ",
