 "反照": "اِنْعِكَاس, عَكْس",
 "反照代名詞": "ضَمِير اِنْعِكَاسِيّ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة",
 "反物": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "反物質": "مَادَّة مُضَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "反町": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "反発": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "反発作用": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح)",
 "反発力": "رجوعية, مرونة (الخاصية الفيزيائية للمادة التي تمكنها من العودة إلى شكلها أو موضعها الأصلي بعد…)",
 "反目": "عَدَاوَة",
 "反省": "اِنْعِكَاس, عَكْس / نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "反磁性": "دايامغناطيسية, مغناطيسية معاكسة (ظاهرة تظهرها مواد مثل النحاس أو البزموت التي تصبح ممغنطة في مجال مغناطيسي…)",
 "反社": "جَرِيمة مُنَظَّمة",
 "反社会": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها)",
 "反社会性パーソナリティ症": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة…)",
 "反社会性パーソナリティ障害": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة…)",
 "反社会性人格障害": "اضطراب الشخصية المعادية للمجتمع, شخصية سيكوباتية (اضطراب في الشخصية يتميز باللاأخلاقية ونقص العاطفة؛ قادر على ارتكاب أعمال عنيفة…)",
 "反社会的": "مُعَادٍ لِلْمُجْتَمَع (معادٍ للمعايير الاجتماعيّة السليمة أو مخلّ بها)",
 "反社会的勢力": "جَرِيمة مُنَظَّمة",
 "反社会的集団": "جَرِيمة مُنَظَّمة",
 "反米": "معاد لأمريكا (يعارض الولايات المتحدة وسياساتها)",
 "反粒子": "جُسَيْم مُضَادّ (جسيم له نفس كتلة جسيم آخر ولكن له قيم معاكسة لخصائصه الأخرى؛ يؤدي تفاعل الجسيم…)",
 "反義語": "عَكْس",
 "反舌音": "مُرْتَدّ",
 "反芻": "اجترار / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "反芻動物": "مُجْتَرّ",
 "反芻類": "مُجْتَرّ",
 "反英雄": "بطل مزيف, بطلة مزيفة",
 "反覆": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / عَكَسَ / تَكْرَار, إِعَادَة",
 "反訳": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / كَرْشَنَة, نَقْصَوَة",
 "反訴": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق)",
 "反証": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)",
 "反語": "سُخْرِيَة / اِسْتِفْهَام مَجَازِيّ",
 "反語的": "سَاخِر, مُفَارِق (يَتَّسِمُ بِالتَّبَايُنِ بَيْنَ مَا هُوَ مُتَوَقَّعٌ وَمَا يَحْدُثُ فِعْلًا)",
 "反論": "اِعْتَرَاض",
 "反賊": "مُتَمَرِّد, مُتَمَرِّدَة",
 "反足細胞": "نَقِيض (المقابل المباشر)\nمثال: الهدوء: نقيض الانشغال المركز",
 "反跳": "ارتداد, انعكاس (حركة العودة من الارتطام)",
 "反軍": "مُتَمَرِّد, ثَائِر",
 "反転": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية",
 "反転攻勢": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة…)",
 "反逆": "خِيَانَة",
 "反逆人": "مُتَمَرِّد, مُتَمَرِّدَة",
 "反逆分子": "مُرْتَدّ, مُنْشَقّ (تَخَلَّى عَنْ قَضِيَّة أَوْ مَبْدَأ)",
 "反逆罪": "خِيَانَة",
 "反逆者": "مُتَمَرِّد, مُتَمَرِّدَة",
 "反間": "مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات…)",
 "反陽子": "نَقِيض البُرُوتُون (بروتون غير مستقر سالب الشحنة؛ الجسيم المضاد للبروتون)",
 "反面": "مُدَّة\nمثال: جون في عمر أخي. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَكَسَ",
 "反面に": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "反面教師": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "反革命": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "反響": "صَدًى / استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق)\nمثال: رد فعل سيء للدواء",
 "反響定位": "تحديد الموقع بالصدى (تحديد موقع شيء ما عن طريق قياس الوقت الذي يستغرقه الصدى للعودة منه)",
 "反響言語": "ترديد مرضي, مصاداة ((طب نفسي) تكرار ميكانيكي وبلا معنى لكلمات شخص آخر (كما في الفصام))",
 "反駁": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "反骨の精神": "عَمُود فَقْرِيّ",
 "収まり": "نَتِيجَة / رَصِيد",
 "収まりが悪い": "فِي غَيْرِ مَحَلِّهِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "収まる": "هَدَأَ\nمثال: استقر زيري في خيمته. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها…) / أَهْدَأَ, هَدَّأَ / رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا.",
 "収む": "كَرَّسَ, قَدَّمَ / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / خَزَنَ (حفظ، إدخر، أودع في مخزن) / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "収め": "النِهاية",
 "収める": "وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / تضمن / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ…)\nمثال: و أخيرا حقق هدفه. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "収れん": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / تجميع, جمع (فعل جمع شيء ما معاً) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب))\nمثال: لم يكن هناك تداخل بين مقترحاتهم",
 "収れん剤": "مُقَلِص",
 "収入": "دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "収入印紙": "طابع إيرادات, طابع مالي (قطعة صغيرة من الورق اللاصق توضع على شيء لإظهار أنه تم دفع ضريبة حكومية)",
 "収入関税": "تعريفة إيرادية (تعريفة تفرض لزيادة الإيرادات)",
 "収去": "تنحية, عزل (الفصل من منصب رسمي)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "収取": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "収受": "اِسْتِقْبَال",
 "収奪": "سَالِب, نَاهِب (يأخذ ما يريده بالقوّة)\nمثال: نهب البارثينون",
 "収容": "إِقَامَة / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / اِحْتَوَى, تَضَمَّنَ",
 "収容力": "سِعَة",
 "収容所": "مُعَسْكَر اِعْتِقَال",
 "収容者": "سَاكِن, سَاكِنَة",
 "収容能力": "سِعَة",
 "収容設備": "إِقَامَة",
 "収差": "اِنْزِيَاغ",
 "収得": "اكتساب, حصول (فعل الحصول على شيء ما)\nمثال: حسدت موهبته في الاكتساب",
 "収拾": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "収拾がつかない": "خارج السيطرة (خرج عن نطاق السيطرة)\nمثال: خرجت أعمال الشغب عن السيطرة",
 "収拾が付かない": "خارج السيطرة (خرج عن نطاق السيطرة)\nمثال: خرجت أعمال الشغب عن السيطرة",
 "収攬": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "収斂": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / تجميع, جمع (فعل جمع شيء ما معاً) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب))\nمثال: لم يكن هناك تداخل بين مقترحاتهم",
 "収斂剤": "مُقَلِص",
 "収束": "نَتِيجَة / التقاء, تقارب (عملية التقارب (المجيء بشكل أقرب))\nمثال: لم يكن هناك تداخل بين مقترحاتهم / تبيؤر, تركيز البؤرة (عملية وضع الشيء في البؤرة)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "収束レンズ": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "収獲": "لُقْطَة\nمثال: كنت أمسك بالكرة.",
 "収率": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "収用": "نزع الملكية (الإخراج من يد المالك (خاصة أخذ الممتلكات من قبل السلطة العامة))",
 "収益": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات…)\nمثال: دُفعت الأجور نقداً",
 "収益化": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "収益報告": "بيان الدخل, تقرير الأرباح (بيان مالي يعطي نتائج التشغيل لفترة محددة)",
 "収益性": "مَرْدُودِيَّة",
 "収益率": "مُعَدَّل العَائِد (المبلغ المُعاد لكل وحدة زمنية معبراً عنه كنسبة مئوية من التكلفة)",
 "収益金": "دَخْل (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "収監": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "収着": "امتزاز, تشارب (العملية التي تأخذ فيها مادة مادة أخرى أو تمسك بها (سواء عن طريق الامتصاص أو…)",
 "収税": "تحصيل الضرائب, جباية الضرائب (جمع الضرائب)",
 "収税人": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "収税吏": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "収穫": "حِصَاد\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة. / لُقْطَة\nمثال: كنت أمسك بالكرة.",
 "収穫感謝祭": "عيد الشكر (عيد يحتفل به في أمريكا الشمالية كشكر للنعم والحصاد)",
 "収穫期": "حصاد, موسم الحصاد (الموسم المخصص لجمع المحاصيل)",
 "収穫物": "حِصَاد\nمثال: حصد الفلاح القمح.",
 "収穫逓減の法則": "قانون تناقص العوائد (قانون يؤكد أن الاستمرار بعد الوصول إلى مستوى معين من الأداء سيؤدي إلى انخفاض في…)",
 "収穫高": "مَحْصُول",
 "収納": "إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين / إِيصَال / جني, حصاد (جمع المحصول الناضج)",
 "収納スペース": "مساحة تخزين (المنطقة في أي هيكل توفر مساحة للتخزين)",
 "収納室": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "収納家具": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد)\nمثال: اقترب من الخزانة.",
 "収納容器": "صُرَّة, طَرْد",
 "収納庫": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد)\nمثال: اقترب من الخزانة.",
 "収納箱": "خَزِينَة\nمثال: تلقى ياني طلقة في الصدر.",
 "収縮": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق)\nمثال: تقلص الغاز عند التبريد",
 "収縮期": "اِنْقِبَاض",
 "収縮筋": "ثعبان عاصر (أي من الثعابين الكبيرة غير السامة المتنوعة التي تقتل فريستها عن طريق سحقها في…)",
 "収蔵": "صومعة, مخزن حبوب (مستودع للحبوب المدروسة أو علف الحيوانات)",
 "収蔵品": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "収蔵庫": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "収覧": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "収賄罪": "رَشْوَة",
 "収載": "شَامِل",
 "収量": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "収金": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "収録": "تَسْجِيل",
 "収集": "تجميع, جمع (فعل جمع شيء ما معاً) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جمع القمامة, رفع النفايات (جمع وإزالة القمامة)\nمثال: 私たちのゴミは週３回収集されます。 — تُجمع القمامة ثلاثة مرات في الأسبوع.",
 "収集品": "مُسْتَحَقّ التَّحْصِيل, وَاجِب الدَّفْع (خاضع للدفع أو يستلزمه حسب ما هو محدَّد)",
 "収集家": "مجمّع (القطب الكهربائي في الترانزستور الذي يغادر من خلاله التدفق الأساسي للحاملات…)",
 "叔母": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "叔母さん": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة.",
 "叔母ちゃん": "خالة, عمة (أخت الأب أو الأم؛ زوجة العم أو الخال)",
 "叔母上": "عَمَّة, خَالَة (هي أُخْت الأَبّ)",
 "叔父": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "叔父さん": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم. / شَيْخ, عَجُوز",
 "叔父ちゃん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "叔父上": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "叔父御": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "叔父様": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "叔父者人": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "叔父貴": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "取": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام)\nمثال: كانت الغنائم سهلة / استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "取っ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "取っかえ引っかえ": "وَاحِدًا تِلْوَ الآخَرِ",
 "取っつきにくい": "صَعْب المَنَال, يَتَعَذَّر الوُصُول إِلَيْه (لا يمكن الوصول إليه إلا بصعوبة كبيرة أو لا يمكن الوصول إليه إطلاقاً)",
 "取っつきやすい": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っつき易い": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っつく": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني.",
 "取っておき": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取ってくる": "جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取ってつけたよう": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع)\nمثال: موت غير طبيعي",
 "取って付けたよう": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع)\nمثال: موت غير طبيعي",
 "取って付けた様": "مُتَصَنَّع, مُتَكَلَّف (يتحدث أو يتصرف بطريقة مصطنعة لترك انطباع)\nمثال: موت غير طبيعي",
 "取って代わる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "取って参る": "جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取って来る": "جَلَبَ (أَتَى بالشيء، جَاءَ بِهِ)\nمثال: جلب زيري سحلية.",
 "取って置き": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取って返す": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "取って食う": "عَضَّ, قَضَمَ",
 "取っとき": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取っ付き": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "取っ付きにくい": "صَعْب المَنَال, يَتَعَذَّر الوُصُول إِلَيْه (لا يمكن الوصول إليه إلا بصعوبة كبيرة أو لا يمكن الوصول إليه إطلاقاً)",
 "取っ付きやすい": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っ付き易い": "مُتَاح, يُمْكِن الوُصُول إِلَيْه (قابل للوصول إليه)\nمثال: بلدة يمكن الوصول إليها بالقطار",
 "取っ付く": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني.",
 "取っ手": "مِقْبَض",
 "取っ払う": "نَقَلَ\nمثال: لا أزال عطشانا.",
 "取っ捕まえる": "لُقْطَة\nمثال: كنت أمسك بالكرة.",
 "取っ掛かり": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "取っ換え引っ換え": "وَاحِدًا تِلْوَ الآخَرِ",
 "取っ替え引っ替え": "وَاحِدًا تِلْوَ الآخَرِ",
 "取っ組み合い": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة",
 "取っ組む": "عَالَجَ",
 "取っ置き": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / ثَمِين, غَالٍ (يتسم بالمودة الحانية والتقدير العميق) / وَرَقَة رَابِحَة",
 "取らす": "مَنَحَ",
 "取り": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام)\nمثال: كانت الغنائم سهلة",
 "取りあえず": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "取りかかる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "取りこめる": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "取りさばく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "取りさる": "نَقَلَ\nمثال: لا أزال عطشانا.",
 "取りざた": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "取りそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "取りそろえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "取りたて": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / اختيار, انتقاء (فعل الاختيار أو الانتقاء)\nمثال: كان اختيارك للألوان غير موفق / طَازَج, طَازَة",
 "取りつく": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة / بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "取りつぶす": "تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً…)",
 "取りとめる": "تَيَقَّنَ, تَثَبَّتَ",
 "取りなし": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية)",
 "取りなす": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "取りにくい": "صَعْب",
 "取りのける": "نَقَلَ\nمثال: لا أزال عطشانا.",
 "取りまとめ": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "取りまとめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "取りも直さず": "أي, تحديداً (كما يلي (تستخدم للتفصيل))",
 "取りやめ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما)",
 "取りやめる": "أَلْغَى, أَبْطَلَ",
 "取り上げ": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / قَبَالَة",
 "取り上げる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود. / تَبَنَّى / وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي. / صَادَرَ",
 "取り下げ": "اِنْسِحَاب",
 "取り下げる": "سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه.",
 "取り下ろす": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى.",
 "取り交わす": "تَبْدِيل, تَبَادُل",
 "取り仕切る": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "取り付く": "عراك, مصارعة (فعل الانخراط في قتال يدوي وثيق)\nمثال: كان بينهما مصارعة عنيفة / بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "取り付く島がない": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)\nمثال: مدير تنفيذي يصعب الوصول إليه (متحفظ)",
 "取り付く島もない": "بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)\nمثال: مدير تنفيذي يصعب الوصول إليه (متحفظ)",
 "取り付け": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات))\nمثال: استغرق تركيب الهاتف بضع دقائق فقط / رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "取り付ける": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "取り付け工事": "تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات))\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "取り付け騒ぎ": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "取り代": "جُزْء",
 "取り入る": "تَمَلَّقَ",
 "取り入れ": "جني, حصاد (جمع المحصول الناضج)",
 "取り入れる": "تَبَنَّى / حِصَاد\nمثال: حصد الفلاح القمح.",
 "取り入れ口": "استنشاق, شهيق (فعل الشهيق؛ سحب الهواء (أو غازات أخرى) للداخل كما في التنفس)",
 "取り出しボタン": "حِمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
