 "口づける": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "口にする": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "口にのぼせる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "口に上せる": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "口に入る": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "口に出す": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "口に合った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "口に掛ける": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "口に運ぶ": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "口のうまい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "口のかるい": "ثَرْثَار",
 "口のきけない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口のわるい": "ساخر",
 "口の上手い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "口の利けない": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口の悪い": "ساخر",
 "口の端": "نَمِيمَة, إِشَاعَة",
 "口の軽い": "ثَرْثَار",
 "口の達者": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام)",
 "口はばったい": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "口ひげ": "شَارِب",
 "口ぶえ": "صَفَّارَة\nمثال: بدأ سامي من نقطة الصفر.",
 "口ぶり": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "口べた": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "口まね": "مُشَاكهَة",
