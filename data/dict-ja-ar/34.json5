 "古代ギリシア": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها…)\nمثال: أنا من اليونان.",
 "古代ギリシア語": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古代ギリシャ": "الْيُونَان الْقَدِيمَة (دولة في جنوب شرق أوروبا؛ اسمها الرسمي الْجُمْهُورِيَّة الهِيلِينِيَّة، وعاصمتها…)\nمثال: أنا من اليونان.",
 "古代ギリシャ語": "اللُّغَة الْيُونَانِيَّة الْقَدِيمَة, الإِغْرِيقِيَّة",
 "古代ローマ": "رُومَا الْقَدِيمَة (ولاية إيطالية؛ مدينة هي عاصمة ولاية روما الإيطالية)\nمثال: روما مدينة قديمة.",
 "古代人": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط…)",
 "古代史": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية)",
 "古代教会スラヴ語": "سْلَافُونِيَّة كَنِيسَة قَدِيمَة",
 "古代米": "أرز بري (حبوب عشب مائي من أمريكا الشمالية)",
 "古代紫": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "古伝": "أُسْطُورَة\nمثال: بحث عن المفتاح.",
 "古体": "خط النمط القديم (نمط خط (يعتمد على تصميم من القرن الثامن عشر) يتميز بعدم الانتظام وزوائد مائلة…)",
 "古例": "تَقْلِيد",
 "古傷": "نَدْبَة, نَدْب",
 "古兵": "سَامُورَاي / مُحَارِب قَدِيم",
 "古典": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ)\nمثال: فخار صيني كلاسيكي",
 "古典ギリシア語": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "古典ギリシャ語": "الأفلاطونية, الأيونية (لهجة اليونانية القديمة التي كان يتم التحدث بها وكتابتها في أتيكا وأثينا وأيونيا)",
 "古典ラテン語": "لَاتِينِيَّة كْلَاسِيكِيَّة (المنسوبة إلى المنطقة المحيطة بمدينة روما والتي كانت تسمى لَاتِيْن في عصر الروم…)\nمثال: أعرف اللاتينية.",
 "古典主義": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت…)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "古典主義者": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي)",
 "古典力学": "ميكانيكا كلاسيكية, ميكانيكا نيوتنية (فرع الميكانيكا القائم على قوانين نيوتن للحركة)",
 "古典古代": "اَلْعُصُورُ ٱلْكلَاسِيكِيَّةُ ٱلْقَدِيمَةُ",
 "古典学": "كلاسيكيات (دراسة الأعمال الأدبية لليونان وروما القديمة)",
 "古典学者": "فنان كلاسيكي, كلاسيكي (شخص فني يلتزم بالمذهب الكلاسيكي)",
 "古典派": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت…)",
 "古典的": "تَقْلِيدِيّ, كْلَاسِيكِيّ",
 "古典的条件づけ": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء…)",
 "古典的条件付け": "إشراط كلاسيكي (إشراط يقرن محفزاً محايداً بمحفز يثير منعكساً؛ يُعطى المحفز المثير للمنعكس سواء…)",
 "古典音楽": "مُوسِيقَى كْلَاسِيكِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف…)\nمثال: أتعلم الموسيقى.",
 "古内": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
