 "よくかんがえたら": "فِعْلًا",
 "よくきょう": "منظار طبي (أداة طبية لتوسيع ممر أو تجويف جسدي من أجل فحص الداخل) / مرآة معدنية (مرآة (خاصة تلك المصنوعة من المعدن المصقول) للاستخدام في أداة بصرية)",
 "よくけた": "ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم) / صارية, عارضة (عمود قوي مستدير من الخشب أو المعدن يستخدم لدعم الحبال والأشرعة) / سبار, فلسبار (أي من المعادن اللافلزية المختلفة (الكالسيت أو الفلسبار) فاتحة اللون وشفافة أو نصف شفافة وقابلة للانفصام)",
 "よくさん": "إسناد, دعم (فعل تحمل وزن أو تقوية شيء ما) / مُسَانِد, مُشَجِّع (يقدم الدعم والتشجيع)\nمثال: استند على الحائط للدعم",
 "よくし": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "よくしつ": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "よくしゅるい": "خفاش, وطواط (ثديي ليلي يشبه الفأر تحورت أطرافه الأمامية لتشكل أجنحة غشائية ولديه تكيفات تشريحية لتحديد الموقع بالصدى الذي يتنقل بواسطته)",
 "よくしりょく": "رَدْع (رَدَعَه عنه: كَفَّهُ ورَدَّهُ، فارْتَدَعَ؛ رَدَعَ جَيْبَه عنه: فَرَجَه)\nمثال: بما أن إسرائيل خسرت حربا في لبنان عام 2006، شنت العديد من حملات قصف كبيرة في غزة كي تسترجع قدرتها على الردع.",
 "よくしん": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "よくじょう": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف.",
 "よくじょうきん": "عضلة جناحية (عضلة تنحدر من العظم الوتدي إلى الفك السفلي)",
 "よくじょうへん": "ظُفْرَة",
 "よくじん": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "よくす": "اِسْتَحَمَّ, اِغْتَسَلَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "よくする": "اِسْتَحَمَّ, اِغْتَسَلَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "よくせい": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "よくせいざい": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "よくせいせい": "قَمْعِيّ, كَبْتِيّ (يُقيِّد الفعل أو يكبته)",
 "よくそう": "بَانْيُو, مَغْسَل",
 "よくぞ": "بشكل رائع, بشكل ممتاز (بشكل رائع) / بأبهة, بروعة (بطريقة جميلة ومثيرة للإعجاب)\nمثال: أبلى بلاءً حسناً بشكل ممتاز في الامتحان",
 "よくたん": "مقدمة مجنحة (مقدمة حذاء مزخرفة لها طرف يمتد نحو عنق الحذاء) / حذاء بمقدمة مجنحة (حذاء له مقدمة على شكل جناح)",
 "よくち": "وَاحَة, غُوطَة (بقعة خضراء في الصحراء أو في أرض قاحلة، وأصبحت كذلك بسبب وجود مصدر ماء بقربها)",
