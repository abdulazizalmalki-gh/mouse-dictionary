 "ゆびおり": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق)\nمثال: ركبنا في السيارة المتقدمة",
 "ゆびがね": "حَلْقَة",
 "ゆびく": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن)",
 "ゆびさき": "بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة. / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "ゆびさし": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "ゆびざし": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "ゆびざる": "آيْآي",
 "ゆびざわり": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو…)\nمثال: إياك ولمس شطيرتي!",
 "ゆびづかい": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع)",
 "ゆびぬき": "كُشْتُبَان, كُسْتِبَان",
 "ゆびのふし": "بُرْجُمَة, مَفْصِل",
 "ゆびむすび": "أبوسوم (جرابي شجري ليلي له ذيل قابض عارٍ يوجد من جنوب أمريكا الشمالية إلى شمال أمريكا…)",
 "ゆびもじ": "تهجئة بالأصابع (أبجدية من الإشارات اليدوية)",
 "ゆびわ": "حَلْقَة",
 "ゆびをさす": "اِغْتَابَ, أَبَرَ",
 "ゆびサック": "غطاء الإصبع, كشتبان واقٍ (غلاف يلبس لحماية الإصبع)",
 "ゆふ": "معطف مشمع (معطف ماكنتوش مصنوع من قماش قطني معالج بالزيت والصبغة لجعله مقاوماً للماء)",
 "ゆぶね": "بَانْيُو, مَغْسَل",
 "ゆぶろ": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ゆぼけつがん": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "ゆまき": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "ゆまく": "بقعة زيت, بقعة نفطية (طبقة رقيقة من الزيت تطفو على سطح الماء (خاصة النفط الخام المتسرب من السفن))",
 "ゆまり": "بَوْل",
 "ゆみ": "قَوْس, قوس / رِمَايَة",
 "ゆみがた": "قَوْس, مُنْحَنَى / جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل)\nمثال: قسم من صنارة الصيد",
 "ゆみし": "قَوَّاس",
 "ゆみつかい": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ)…)",
 "ゆみづかい": "استخدام القوس (إدارة القوس في العزف على آلة وترية)\nمثال: كان استخدام عازف الكمان للقوس ممتازاً",
 "ゆみづる": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…)",
 "ゆみとり": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ)…)",
 "ゆみなり": "قَوْس, مُنْحَنَى",
 "ゆみなりになる": "قَوْس",
 "ゆみのこ": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "ゆみはり": "تَرْبِيع",
 "ゆみはりづき": "تَرْبِيع",
 "ゆみや": "قَوْس وَسَهْم / سِلَاح, أَسْلِحَة",
 "ゆみをひく": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به)\nمثال: جميع من حضر عارض تلك الخطة.",
 "ゆむろ": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ゆめ": "حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / خِدَاع, ضَلَالَة / أَبَدًا",
 "ゆめうつつ": "ترانس",
 "ゆめうらない": "تفسير الأحلام (التنجيم من خلال تفسير الأحلام)",
 "ゆめおいびと": "حَالِم",
 "ゆめがたり": "أضغاث أحلام, حلم بعيد المنال (أمل خيالي ولكنه عبثي (من التخيلات الناتجة عن تدخين الأفيون))\nمثال: لدي هذا الحلم بعيد المنال بأن أكون إمبراطور الكون",
 "ゆめごこち": "نَشْوَة",
 "ゆめじ": "أرض الأحلام, عالم الأحلام (بلد ممتع موجود فقط في الأحلام أو الخيال)",
 "ゆめにも": "أبداً",
 "ゆめのくに": "أرض الأحلام, عالم الأحلام (بلد ممتع موجود فقط في الأحلام أو الخيال)",
 "ゆめまぼろし": "حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめみがち": "غير واقعي (ليس واقعياً)\nمثال: توقعات غير واقعية",
 "ゆめみぐさ": "زَهْرَة كَرَز",
 "ゆめみどり": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "ゆめみる": "حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめものがたり": "أضغاث أحلام, حلم بعيد المنال (أمل خيالي ولكنه عبثي (من التخيلات الناتجة عن تدخين الأفيون))\nمثال: لدي هذا الحلم بعيد المنال بأن أكون إمبراطور الكون",
 "ゆめゆめ": "بِالتَّأْكِيد / قَلِيلًا / بِجِدّ / حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめをみる": "حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめをむすぶ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "ゆもけつがん": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "ゆゆしい": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "ゆゆしき": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "ゆらい": "مَنْشَأ / أَصْلًا",
 "ゆらいがき": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "ゆらぎ": "جَعْبَة",
 "ゆらく": "مُتْعَة, لَذَّة",
 "ゆらぐ": "تَأَرْجَحَ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "ゆらす": "صَخْرَة, حجر",
 "ゆらめき": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "ゆらめく": "وَمِيض, وَمْضَة",
 "ゆらゆら": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد)",
 "ゆらり": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد)",
 "ゆらりゆらり": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد)",
 "ゆらんかん": "قَنَاةُ الْبَيْض",
 "ゆり": "اِهْتِزَاز",
 "ゆりいす": "كرسي هزاز (كرسي مثبت على زلاجات مقوسة تسمح له بالتأرجح)",
 "ゆりうごかす": "هَزَّ",
 "ゆりうごく": "اِقْشَعَرَّ",
 "ゆりかえし": "هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ",
 "ゆりかご": "مَهْد",
 "ゆりかごからはかばまで": "مِنَ ٱلْمَهْدِ إِلَىٰ ٱللَّحْدِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ゆりかごから墓場まで": "مِنَ ٱلْمَهْدِ إِلَىٰ ٱللَّحْدِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ゆりかもめ": "نورس اسود الرأس",
 "ゆりずいせん": "ألستروميريا (أي من النباتات الأمريكية الجنوبية المختلفة من جنس ألستروميريا التي تقدر…)",
 "ゆりのき": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق…)",
 "ゆりの木": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق…)",
 "ゆりもくば": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب)",
 "ゆりもどし": "هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ",
 "ゆり動かす": "هَزَّ",
 "ゆる": "زَنْبَق, سَوْسَن / هَزَّ",
 "ゆるい": "فَضْفَاض, واسِع / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / مُؤَدَّب / بَطِيء",
 "ゆるか": "فَضْفَاض, واسِع / مُؤَدَّب / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل)",
 "ゆるがす": "هَزَّ",
 "ゆるがせ": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير)",
 "ゆるがせにする": "أَهْمَلَ",
 "ゆるがない": "رَاسِخ, صَارِم",
 "ゆるぎ": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "ゆるぎない": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "ゆるぐ": "هَزَّ",
 "ゆるし": "إِبْرَاء, إِعْفَاء",
 "ゆるしがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "ゆるす": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي? / سَامَحَ / إحالة الدعوى ((قانون) فعل الإحالة (خاصة إحالة قضية قانونية إلى محكمة أخرى))\nمثال: شكلوا مجموعة باختصاص اقتراح طرق لتعزيز الحياة الأسرية / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ:…)\nمثال: شكر ياني أسرته.",
 "ゆるすまじ": "لَا يُغْتَفَرُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "ゆるみ": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة)\nمثال: قام بسحب الجزء المرتخي",
 "ゆるむ": "اِسْتَرْخَى / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "ゆるめる": "أَرْخَى, حَلَّ / اِسْتَرْخَى / قَلَّلَ",
 "ゆるやか": "فَضْفَاض, واسِع / مُؤَدَّب / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل)",
 "ゆるゆる": "بِبُطْء",
 "ゆるり": "بتأن, بدون عجلة (بدون تسرع)\nمثال: مضت بتأن",
 "ゆれ": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد)\nمثال: اختلال هرموني",
 "ゆれうごく": "هَزَّ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "ゆれる": "هَزَّ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "ゆれ動く": "هَزَّ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "ゆわい": "تَهْنِئَة / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "ゆわえつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "ゆわえる": "أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "ゆわかし": "غَلَّايَة",
 "ゆわかしき": "سخان مياه (سخان وخزان تخزين لتوفير المياه الساخنة)",
 "ゆんで": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ゆー": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "よ": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل…)\nمثال: كانت ليلة رائعة. / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / فَوْقَ\nمثال: أجب على السؤال. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام. / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / يَاه, اسمع / أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "よあかし": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "よあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "よあけがた": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة.",
 "よあけのみょうじょう": "نَجْمَة الصَّبَاح",
 "よあそび": "حياة الليل, سهر (نشاط الأشخاص الذين يبحثون عن الترفيه الليلي (كما في المسرح أو الملهى الليلي وما…)\nمثال: في الصيف تنتقل الحياة الليلية إلى نوادي الرقص",
 "よい": "مَسَاء / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر. / دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "よいおとこ": "حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر)\nمثال: صفق المتفرجون للأداء / حَلِيف, شَخْص طَيِّب (أي شخص يكون في صفك) / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "よいお年を": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "よいがさめる": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "よいがまわる": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "よいぐあいに": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "よいころ": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "よいごこち": "ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول))\nمثال: حشد صاخب من البحارة المخمورين",
 "よいごし": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "よいしょ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "よいじかん": "مُتَأَخِّر / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "よいち": "اَلسُّوق اَللَّيْلِيّ",
 "よいっしょ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "よいっぱり": "بومة الليل, ساهر (شخص يحب أن يكون نشطاً في وقت متأخر من الليل) / سَهِرَ ((سَهِرَ) يَسْهَرَ سَهَرًا: لَمْ ينَمْ كلَّ اللَّيْل أَو بَعْضَه؛ (سَهِرَ): أَرِق)\nمثال: إنها معتادة على السهر.",
 "よいてんき": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "よいどれ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "よいのくち": "هُبُوط, غَسَق",
 "よいのみょうじょう": "نَجْمَة الْمَسَاء",
 "よいはなし": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "よいひと": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط / عَاشِق, عَاشِقَة",
 "よいまちぐさ": "أخدرية, زهرة الربيع المسائية",
 "よいや": "يَع",
 "よいやさ": "يَع",
 "よいやみ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "よいやよいや": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "よいよい": "تابس ظهري, رنح حركي (زهري يصيب الحبل الشوكي يتميز بتنكس الخلايا العصبية الحسية وآلام طاعنة في الجذع…)",
 "よいわるい": "نَوْعِيَّة, جَوْدَة",
 "よいをさます": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "よいん": "تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كانت تستطيع سماع أصداء خطواتها / طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / إِيحَائِيَّة (حالة أو صفة الامتلاء بالإيحاءات وتحفيز الفكر)",
 "よいんし": "تميم, عامل مرافق (مادة (مثل الإنزيم المساعد) يجب أن تتحد مع مادة أخرى لإنتاج نتيجة معينة)",
 "よい人": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط / عَاشِق, عَاشِقَة",
 "よい天気": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "よい時間": "مُتَأَخِّر / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "よい頃": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "よう": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر. / شَرِكَة\nمثال: المهم هو العمل. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / إبراز, إخراج (العملية الجسدية لتصريف الفضلات) / فَائِدَة, جَدْوَى\nمثال: 労なくして益なし。 — كل شيء وله ثمن / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال. / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / مُوجَب / يانغ (المبدأ الذكوري الإيجابي المشرق في علم الكونيات المزدوج الصيني)\nمثال: الين واليانغ معًا ينتجان كل ما يأتي إلى الوجود / مَفْتُوح\nمثال: فتح الباب آليا. / بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / كَيْف, ازاي / ضَرُورَة, حَاجَة / غَامِق, دَاكِن / جمرة (عدوى أكبر من الدمل ولها عدة فتحات لتصريف القيح) / تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / إرَادَة / لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد…) / عَجَب\nمثال: قطة؟ تساءل الرجل العجوز. / مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / أَجْنَبِيّ / رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / يَاه, اسمع",
 "ようあん": "تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً…)",
 "ようい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / تَحْضِير, إِعْدَاد / أُمّ التَلَافِيف (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "よういく": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: 医者は概して子供の養育の訓練を受けていない。 — الدكاترة ليسوا قاعدة اساسية في التدريب لتربية الاطفال .",
 "よういどん": "سِبَاق, مُسَابَقَة\nمثال: هذا القميص مبلل بالعرق.",
 "よういにする": "سَهَّلَ (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "よういん": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "よういドン": "سِبَاق, مُسَابَقَة\nمثال: هذا القميص مبلل بالعرق.",
 "ようえい": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "ようえき": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا. / خِدْمَة / حيازة زراعية, سوكاج (حيازة الأرض عن طريق الخدمة الزراعية أو دفع الإيجار؛ غير مثقلة بالخدمة العسكرية)",
 "ようえきさいばい": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "ようえきどこう": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "ようえきぶっけん": "حق الانتفاع (حق قانوني في استخدام وجني الأرباح من ممتلكات تخص شخصًا آخر بشرط عدم الإضرار…)",
 "ようえん": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا) / بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "ようおこし": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "ようおん": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "ようおんぷ": "نَبْرَة حَادَّة",
 "ようか": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه…)",
 "ようかい": "شَبَح, خَيَال / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه…) / أَسْمَنْت / لَخَّصَ, اِخْتَصَرَ / تَدَاخُل",
 "ようかいえき": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال…)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "ようかいごど": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "ようかいせい": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل)",
 "ようかいど": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل)",
 "ようかいりょく": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل)",
 "ようかぎん": "يوديد الفضة (يوديد يُستخدم في التصوير الفوتوغرافي، وفي استمطار السحب، وفي الطب)",
 "ようかすいそ": "يوديد الهيدروجين (غاز عديم اللون ينتج حمض الهيدرويوديك في المحلول المائي)",
 "ようかた": "والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له)",
 "ようかぶつ": "يوديد (ملح أو إستر لحمض الهيدرويوديك)",
 "ようかん": "وَرِك",
 "ようかカリウム": "يوديد البوتاسيوم (ملح بلوري يُستخدم في التخليق العضوي وصنع المستحلبات الفوتوغرافية وفي ملح الطعام…)",
 "ようが": "مُوجَب / جُرْثُومَة / برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور))",
 "ようがい": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ようがいけんご": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "ようがさ": "مِظَلَّة, شَمْسِيَّة",
 "ようがしや": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
