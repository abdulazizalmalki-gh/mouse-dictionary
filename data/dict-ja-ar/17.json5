 "やっか": "صَيْدَلِيَّة",
 "やっかい": "مُشْكِلَة, مَتاعِب / اِهْتِمَام",
 "やっかいごと": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "やっかいもの": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج)) / إِزْعَاج",
 "やっかみ": "حَسَد (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やっかむ": "حَسَد (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やっかん": "اِتِّفَاق, تَوَافُق",
 "やっき": "يَائِس, قَانِط",
 "やっきょく": "صَيْدَلِيَّة\nمثال: 一番近い薬局はどこにありますか。 — أين أقرب صيدلية؟ / مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "やっきょくせい": "صَيْدَلِيّ, صَيْدَلَانِيّ",
 "やっきょくほう": "دستور الأدوية ((علم الأدوية) كتاب يحتوي على تجميع للمنتجات الصيدلانية مع صيغها وطرق تحضيرها)",
 "やっこ": "خَادِم, خَادِمَة / استعباد (فعل اتخاذ الأسرى عبيداً)\nمثال: لذا كل عبد يحمل في يده القوة لإلغاء أسره / هُوَ",
 "やっこい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "やっこさん": "هُوَ",
 "やっさもっさ": "بشكل عشوائي, هرج ومرج (بشكل عشوائي وغير منظم)\nمثال: الكتب مكدسة بشكل عشوائي",
 "やっせんぼ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)",
 "やった": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やったあ": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やったー": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やっちまう": "بهلوان, مهرج (شخص يمتع الآخرين من خلال التصرفات السخيفة والمضحكة) / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "やっつ": "ثَمَانِيَة, تمانية / اَلسَّاعَة اَلثَّانِيَة",
 "やっつける": "نَبْض\nمثال: ضرب سامي زوجته.",
 "やっていく": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "やってのける": "نَجَحَ",
 "やって行く": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "やっと": "أَخِيرًا / بِٱلْكَاد",
 "やっとかめ": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "やっとか目": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "やっとこ": "أَخِيرًا / بِٱلْكَاد / كَلْبَتَان",
 "やっとこさ": "أَخِيرًا / بِٱلْكَاد",
 "やっとこせ": "أَخِيرًا / بِٱلْكَاد",
 "やっとのおもいで": "أَخِيراً",
 "やっとの思いで": "أَخِيراً",
 "やっぱ": "أَيْضًا, كَذٰلِكَ / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة. / رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "やっぱし": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أَيْضًا, كَذٰلِكَ / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "やっぱり": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أَيْضًا, كَذٰلِكَ / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "やっほー": "صيحة تنبيه (صيحة لجذب الانتباه)\nمثال: أطلق صيحة عالية لكن لم يسمعه أحد",
 "やっ付ける": "نَبْض\nمثال: ضرب سامي زوجته.",
 "やつ": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / هُوَ / ثَمَانِيَة, تمانية / اَلسَّاعَة اَلثَّانِيَة",
 "やつあたりに": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "やつおりばん": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "やつがしら": "يَام / هُدْهُد",
 "やつがれ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "やつこ": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب. / وصيف (في العصور الوسطى، شاب يعمل كمرافق لفارس كأول مرحلة في التدريب للفروسية)",
 "やつこらま": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان)",
 "やつどき": "اَلسَّاعَة اَلثَّانِيَة",
 "やつばら": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر. / هُمَا\nمثال: هن يحببن الجاز.",
 "やつめ": "ثَامِن, ثَامِنَة\nمثال: دفع زيري الثمن. / جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص…) / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / هُوَ",
 "やつめうなぎ": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص…)",
 "やつら": "هُمَا\nمثال: هن يحببن الجاز.",
 "やつれ": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض))",
 "やづつ": "جَعْبَة",
 "やと": "قُوَاع, أَرْنَب بَرِّيَّة",
 "やとい": "مُوَظَّف, مُوَظَّفَة",
 "やといいれ": "خِطْبَة, خُطُوبَة",
 "やといいれる": "وَظَّفَ",
 "やといぐち": "مَهَمَّة\nمثال: المهم هو العمل.",
 "やといにん": "مُوَظَّف, مُوَظَّفَة",
 "やといぬし": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "やとう": "مقابلة\nمثال: أغلبية اللجنة كانت معارضة للخطة. / وَظَّفَ / مِيثَاق / قاطع طريق, لص مسلح (لص مسلح يكون (عادة) عضواً في عصابة)",
 "やとうぎいん": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "やとうむし": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى…)",
 "やとびょう": "تولاريميا, حمى الأرانب (مرض شديد العدوى يصيب القوارض (وخاصة الأرانب والسناجب) وينتقل أحيانًا إلى البشر…)",
 "やとらに": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "やとわれ": "عَارِض, مُسْتَأْجَر (مستأجر للاستخدام المؤقت الحصري لمجموعة من المسافرين)\nمثال: طائرة مستأجرة",
 "やど": "إِقَامَة / مَجْلِس / أَبْوَاب, بَاب",
 "やどかり": "سرطان ناسك (قشريات بحرية صغيرة ناعمة الجسم تعيش في أصداف بطنيات القدم المهجورة) / مُسْتَأْجِر",
 "やどす": "مَجْلِس / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "やどちん": "أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة.",
 "やどなし": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "やどぬし": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم)\nمثال: الجزائر العاصمة مدينة مضيفة جدا. / مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "やどや": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "やどり": "إِقَامَة",
 "やどりぎ": "دِبْق, نَبَات طُفَيْلِيّ (لصق أو التصق بشيء؛ التصق بشيء ولم يفارقه) / نبات طفيلي (نبات يعيش على نبات آخر ويحصل منه على الغذاء العضوي)",
 "やどりぎつぐみ": "سمنة الدبق (سمنة أوروبية كبيرة تتغذى على توت الدبق)",
 "やどりばえ": "ذبابة تاشينا (ذبابة شائكة تعيش يرقاتها بشكل طفيلي في اليرقات والحشرات الأخرى؛ مهمة في مكافحة…)",
 "やどりばち": "زِنْبَار طُفَيْلِيّ",
 "やどりバチ": "زِنْبَار طُفَيْلِيّ",
 "やどる": "سَكَنَ, أَقَامَ (قَرَّ وهَدَأ، ضد اِضْطَرَبَ؛ وَطَنَ، يستخدم سكن عند الحديث عن البيت أو الدار…)\nمثال: كان زيري بسكن هناك. / مَكَثَ, بَقِيَ",
 "やどろく": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)",
 "やな": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ)",
 "やなぎ": "صَفْصَاف, غَرَب / صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات…)",
 "やなぎのしたにいつもどじょうはいない": "هُنَاك, يُوجَد",
 "やなぎのしたにいつもどじょうはおらぬ": "هُنَاك, يُوجَد",
 "やなぎはみどり、はなはくれない": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "やなぎらん": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية…)",
 "やに": "رَاتِينَج, صُرْع / قَطْرَان (قَطِرَان: مادة سوداء سائلة لزجة القوام) / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "やにさしがめ": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها…)",
 "やにょうしょう": "تبول في الفراش (سلس البول أثناء النوم؛ شائع بشكل خاص عند الأطفال (الذين عادة ما يتجاوزونه مع…)",
 "やにわに": "فَوْرًا, حَالًا / فَجْأَةً",
 "やぬし": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "やね": "سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "やねいた": "لافتة مهنية (لافتة صغيرة خارج مكتب محامٍ أو طبيب مثلاً)",
 "やねうら": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل…)\nمثال: عادوا إلى العلية.",
 "やねうらべや": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل…)\nمثال: عادوا إلى العلية.",
 "やねまど": "نافذة سقفية (امتداد جملوني مبني من سقف مائل لاستيعاب نافذة عمودية)",
 "やねや": "سقّاف, صانع الأسقف (حرفي يركب أو يصلح الأسقف)",
 "やのね": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "やはぎ": "قذة",
 "やはずえんどう": "وَزْن فَارِغ",
 "やはずもよう": "تعشيق مائل, نمط عظم السمكة (نمط من أعمدة خطوط متوازية قصيرة تميل جميع خطوط العمود الواحد في اتجاه واحد…)",
 "やはり": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أَيْضًا, كَذٰلِكَ / سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "やはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "やば": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "やばい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / مَجْنُون, مَخْبُول",
 "やばす": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً)",
 "やばん": "مُتَوَحِّش / النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "やばんじん": "هَمَجِيّ, مُتَوَحِّش",
 "やひ": "بَذِيء",
 "やぶ": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد) / بَطْبَطَة, زَبْط",
 "やぶい": "بَطْبَطَة, زَبْط",
 "やぶいしゃ": "بَطْبَطَة, زَبْط",
 "やぶかげ": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد)",
 "やぶからぼうに": "فَجْأَةً, عَلَى حِينِ غِرَّةٍ",
 "やぶく": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة.",
 "やぶける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "やぶこぎ": "مُتَرَبِّصٌ فِي كَمِين (يكمن في انتظار الفريسة أو العدوّ)",
 "やぶさか": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام)",
 "やぶさかでない": "حَاضِر, مُسْتَعِدّ\nمثال: جهز زيري حقائبه.",
 "やぶさかではない": "حَاضِر, مُسْتَعِدّ\nمثال: جهز زيري حقائبه.",
 "やぶしらず": "مَتَاهَة",
 "やぶにらみ": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب)",
 "やぶのうさぎ": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "やぶらん": "بيج بلو (قنبلة متشظية موثوقة وفتاكة تزن 15000 رطل تنفجر فوق الأرض مباشرة بنصف قطر كبير…)",
 "やぶる": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة. / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق. / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "やぶれ": "خَسَارَة, فِقْدَان / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة.",
 "やぶれかぶれ": "استماتة, يأس (تهور يائس)\nمثال: كانت سياسة يائسة",
 "やぶれめ": "أُجْرَة, اِسْتَأْجَر\nمثال: ركبت سيارة أجرة.",
 "やぶれる": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة. / اِنْهَار\nمثال: يوشك الجسر على الانهيار. / فَقَدَ\nمثال: خسر توم وظيفته.",
 "やぶん": "مَسَاء",
 "やぶワラビー": "باديميلون (ولب بني محمر صغير يعيش في المناطق الشجرية في أستراليا وغينيا الجديدة)",
 "やぶ医者": "بَطْبَطَة, زَبْط",
 "やべえ": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "やべー": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "やほう": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم…)",
