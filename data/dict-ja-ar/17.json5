 "やじる": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "やじるし": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / فَائِدَة",
 "やじをとばす": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "やじを飛ばす": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "やじん": "رَيْفِيّ, قَرَوِيّ / بلطجي, فتوة (رجل قاسٍ ووحشي) / مَدَنِيّ",
 "やす": "رَخِيص / طَفْح, طَفْح جِلْدِيّ / رُمح ثلاثي الشعب (رمح ذو ثلاث شوكات أو أكثر؛ يستخدم لصيد الأسماك بالرمح (خاصة السلمون))",
 "やすあがり": "رَخِيص",
 "やすい": "رَخِيص / هَادِئ / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "やすうり": "بَيْع",
 "やすき": "سُهُولَة / رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "やすく": "بِثَمَن بَخْس, بِرُخْص (مع القليل من إنفاق المال)\nمثال: اشتريت هذه السيارة بثمن بخس جداً",
 "やすけ": "سُوشِي",
 "やすっぽい": "رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة)",
