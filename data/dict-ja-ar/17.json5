 "ようとして": "تماماً, للغاية (بشكل كامل وبدون تحفظ؛ تستخدم بشكل غير رسمي للتوكيد)\nمثال: لوحة رائعة تماماً",
 "ようとたさい": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات)",
 "ようとのひろい": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات)",
 "ようとん": "حظيرة خنازير, مزرعة خنازير (مزرعة يتم فيها تربية الخنازير أو الاحتفاظ بها)",
 "ようとんじょう": "حظيرة خنازير, مزرعة خنازير (مزرعة يتم فيها تربية الخنازير أو الاحتفاظ بها)",
 "ようど": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال…)\nمثال: أيمكنك صرف خمسين؟ / نُقُود, مَال\nمثال: أريد بعض المال. / يُود",
 "ようどう": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك))\nمثال: تحويل عن الطريق السريع الرئيسي",
 "ような": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "ようなし": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / شَاغِر, غَيْرُ مُؤَجَّر (غير مؤجر أو غير مشغول بمستأجر)\nمثال: كشك هاتف شاغر",
 "ように": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال. / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب / بشكل مرئي (بحيث يكون مرئياً)\nمثال: عرضت العلامة بشكل مرئي",
 "ようにく": "لَحْم اَلضَّأْن (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "ようにたりない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "ようにん": "مُوَظَّف, مُوَظَّفَة / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "ようにんはつおん": "النطق المستلم (النطق المعتمد للإنجليزية البريطانية؛ كان يستند في الأصل إلى إنجليزية الملك كما…)",
 "ようねん": "طُفُولَة",
 "ようねんき": "طُفُولَة",
 "ようねんじだい": "طُفُولَة\nمثال: 一番下の弟は祖母により幼年時代育てられた。 — اخي الاصغر ربته جدتي.",
 "ようのかわ": "قَلْفَة, غُرْلَة",
 "ようのとうざいをとわず": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "ようは": "بِاخْتِصَار",
 "ようはく": "فضة ألمانية, فضة النيكل (سبيكة بيضاء فضية تحتوي على النحاس والزنك والنيكل)",
 "ようば": "شَمْطَاء",
 "ようばい": "قادر على الوفاء, مليء (قادر على الوفاء بالالتزامات المالية)\nمثال: كانوا يحاولون إيجاد حل سلمي",
 "ようばいそう": "زُهَرِيّ, مَرَض فِرَنْجِيّ",
 "ようばいわ": "تذاوب (عملية كيميائية تتحد فيها جزيئات المذيب مع جزيئات أو أيونات المذاب لتكوين مركب)",
 "ようばいわぶつ": "سولفات, مركب مذاب (مركب يتكون عن طريق التذاوب (اتحاد جزيئات المذيب مع جزيئات أو أيونات المذاب))",
 "ようひ": "قَلْفَة, غُرْلَة / ضَرُورَة, حَاجَة / حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة) / رَقّ",
 "ようひいんじゅつ": "تجاهل متعمد (ذكر شيء ما بالقول إنه لن يتم ذكره)",
 "ようひし": "رَقّ",
 "ようひつ": "فُرْشَاة\nمثال: مشط شعرك قبل أن تخرج.",
 "ようひん": "مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "ようび": "يوم من أيام الأسبوع (أي واحد من الأيام السبعة في الأسبوع)",
 "ようびょうき": "ملفاف, ونش (جهاز رفع يتكون من أسطوانة أفقية يتم تدويرها بواسطة كرنك يلتف عليه كابل أو حبل)",
 "ようふ": "أب بالتبني, أب حاضن (رجل هو والد حاضن) / ساحرة (أنثى تمارس السحر) / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "ようふくかけ": "شماعة, علاقة ملابس (علاقة مصممة على شكل أكتاف الشخص وتستخدم لتعليق الملابس عليها)",
 "ようふくがけ": "شماعة, علاقة ملابس (علاقة مصممة على شكل أكتاف الشخص وتستخدم لتعليق الملابس عليها)",
 "ようふくたんす": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "ようふくだんす": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "ようふくてん": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "ようふくや": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال) / خَيَّاط, خَيَّاطَة",
 "ようふぼ": "والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له)",
 "ようぶ": "صُلْب, حَقْو (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "ようぶつ": "فَالُوس / شَبَح, خَيَال",
 "ようぶん": "مُغَذٍّ, المُغَذِّي",
 "ようへい": "مُرْتَزِق, مُؤْجِر / وَظَّفَ / سويقة الورقة, معلاق (الساق النحيلة التي تدعم نصل الورقة) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك…)",
 "ようへいじゅつ": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك…)",
 "ようへき": "جدار استنادي (جدار يُبنى لمقاومة الضغط الجانبي (خاصة الجدار المبني لمنع تقدم كتلة من الأرض))",
 "ようほう": "اِسْتِخْدَام\nمثال: その２語の用法の区別は明瞭である。 — الفرق في الاستخدام بين الكلمتين واضح. / تربية النحل (تربية النحل على نطاق تجاري لإنتاج العسل)",
 "ようほうか": "نَحَّال, عَسَّال",
 "ようほうじょう": "مَنْحَل",
 "ようほうばこ": "خَلِيَّة, قَفِير",
 "ようぼ": "أم بالتبني, أم حاضنة (امرأة تعمل كأم حاضنة وتربي طفل شخص آخر)",
 "ようぼう": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "ようぼく": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "ようま": "شَبَح, خَيَال",
 "ようまく": "سَلى, أَمْنِيُون (جعله يَسْلَو، أي ينسى الهمّ والهجر وغيره مما كان عنده. فرّج همه؛ الشاة ونحوها:…)",
 "ようまくくう": "تجويف سلوي (التجويف المملوء بالسائل الذي يحيط بالجنين النامي)",
 "ようまくこう": "تجويف سلوي (التجويف المملوء بالسائل الذي يحيط بالجنين النامي)",
 "ようまくるい": "حيوان سلوي (أي عضو من السلويات)",
 "ようむ": "شَرِكَة\nمثال: المهم هو العمل. / ببغاء رمادي أفريقي (ببغاء رمادي مدجن شائع بذيل أحمر وأسود ووجه أبيض؛ موطنه أفريقيا الاستوائية)",
 "ようむいん": "بَوَّاب",
 "ようむき": "شَرِكَة\nمثال: المهم هو العمل.",
 "ようめい": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ようもう": "صُوف",
 "ようもうざい": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "ようもうざる": "سَعْدَان صُوفِيّ",
 "ようもく": "برنامج دراسي, منهج دراسي (دورة متكاملة من الدراسات الأكاديمية)\nمثال: تم قبوله في برنامج جديد في الجامعة",
 "ようやく": "أَخِيراً / بِٱلْكَاد / شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / خُلَاصَة, مُلَخَّص\nمثال: その報告を１ページに要約せよ。 — لَخِّص التقرير في صفحة.",
 "ようやくしゃ": "موعود (شخص يتم تقديم وعد له)",
 "ようやくすれば": "بِاخْتِصَار",
 "ようやっと": "أَخِيراً / بِٱلْكَاد",
 "ようゆう": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه…)",
 "ようゆうがたねつてんしゃプリンタ": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "ようよう": "خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن / ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر) / رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / شَاسِع, وَاسِع / أَخِيراً / بِٱلْكَاد / شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / بَاكٍ / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "ようらく": "قِلَادَة",
 "ようらん": "مَهْد / لَخَّصَ, اِخْتَصَرَ / نِيلِيّ",
 "ようらんき": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج)",
 "ようらんのち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "ようり": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "ようりく": "تفريغ (عمل إخراج حمولة من شيء ما من مركبة أو سفينة أو حاوية، إلخ) / هُبُوط",
 "ようりつ": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "ようりゃく": "مَثَال",
 "ようりゅう": "صَفْصَاف, غَرَب",
 "ようりょう": "سِعَة\nمثال: タンクの容量は５０ガロンだ。 — سعة الخزان خمسون جالوناً. / مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / جُرْعَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "ようりょうしょ": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل)",
 "ようりょうぶんせき": "تحليل حجمي (التحليل الكمي باستخدام أحجام محددة من المحاليل القياسية أو الكواشف)",
 "ようりょうよく": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "ようりょうをえない": "عَرَضِيّ",
 "ようりょく": "قدرة سحرية (القدرة على أداء السحر)",
 "ようりょくそ": "كلوروفيل, يخضور (أي مجموعة من الأصباغ الخضراء الموجودة في الكائنات التي تقوم بالتمثيل الضوئي)",
 "ようりょくたい": "بلاستيدة خضراء, صانعة خضراء (بلاستيد يحتوي على اليخضور وأصباغ أخرى؛ في النباتات التي تقوم بعملية التمثيل…)",
 "ようれい": "مِثَال, مَثَل / طُفُولَة / شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "ようれき": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "ようれつ": "مُتَوَسِّط",
 "ようろ": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "ようろうせき": "بيروفيليت (معدن سيليكات ألمنيوم أبيض أو مخضر (يشبه التلك))",
 "ようろうねんきん": "شَيْخُوخَة, عُجُوز",
 "ようろうほけん": "تأمين مختلط, تأمين وقفي (تأمين على الحياة بمبلغ محدد يُدفع للشخص المؤمن عليه عند انقضاء فترة زمنية معينة…)",
 "ようイオン": "أَيُون مُوجَب, كَاتْيُون (أيون موجب الشحنة)",
 "ようダンス": "كُمُودِينُو, أَدْرَاجِيَّة",
 "よお": "يَاه, اسمع",
 "よか": "خُلُو مِن اَلْعَمَل / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَدَلًا مِن / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل)",
 "よかく": "تحَدُّب (عملية ثني نفسك في وضعية محدبة)\nمثال: كان لديه حدس بأن شيئًا ما قد حدث بشكل خاطئ / حَالَة الْمَفْعُول لَهُ, حَالَة مِنْ حَالَات النُّصْب",
 "よかせぎ": "سَطْو",
 "よかつ": "قَاطِعُ تَمَام",
 "よからぬ": "سَيِّئ, وحش",
 "よかれあしかれ": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "よかろう": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "よかん": "بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "よがら": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "よき": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل…)\nمثال: يبدو زيري بخير. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب))",
 "よきしない": "مُفَاجِئ",
 "よきせぬ": "مُفَاجِئ",
 "よきてほん": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "よきにつけあしきにつけ": "إلى الأبد, بشكل دائم (لفترة طويلة دون تغيير جوهري)\nمثال: هو معاق بشكل دائم",
 "よきにはからえ": "تَوَخَّى اَلْحِذْر",
 "よきに計らえ": "تَوَخَّى اَلْحِذْر",
 "よきほど": "بشكل كبير",
 "よきょう": "أَدَاء / صَدًى",
 "よきん": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
