 "めいおう": "هَادِيس / بْلُوتُو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "めいおうせい": "بْلُوتُو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "めいおうだい": "بُلُوتُونِيّ, جَحِيمِيّ (مُتعلق بالجحيم أو العالم السفلي أو من سماته)",
 "めいか": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير. / مَنْطِقِيّ",
 "めいかい": "هَادِيس / شَفَّاف",
 "めいかく": "شَفَّاف",
 "めいかくか": "تَوْضِيح",
 "めいかん": "دليل (قائمة أبجدية بالأسماء والعناوين) / مصفار",
 "めいが": "تُحْفَة, رَائِعَة / عثة بيراليد (عثة استوائية عادة نحيلة الجسم طويلة الأرجل تعتبر يرقاتها آفات للمحاصيل)",
 "めいがら": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / عَدَد (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "めいき": "مُوَاصَفَة / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي.",
 "めいきゅう": "مَتَاهَة / سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / زِنْزَانَة, دَيْمَاس",
 "めいきょく": "تُحْفَة, رَائِعَة",
 "めいきん": "طائر مغرد (أي طائر له نداء موسيقي)",
 "めいきんるい": "طائر مغرد (طائر جاثم له جهاز صوتي متخصص)",
 "めいぎ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / تَبْرِير",
 "めいぎじょう": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "めいけん": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "めいげつ": "قمر الحصاد (القمر المكتمل الأقرب إلى الاعتدال الخريفي (في سبتمبر)) / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ…)",
 "めいげん": "إِعْلَان, بَيَان / دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "めいげんしゅう": "مختارات أدبية, مقتطفات (مجموعة من المقتطفات من عمل أدبي)",
 "めいこう": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "めいこうだい": "صُغْبَة",
 "めいこん": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "めいご": "بِنْتُ أَخٍ, بِنْتُ أُخْتٍ",
 "めいごう": "شُهْرَة",
 "めいさい": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / مُفَصَّل / تَمْوِيه",
 "めいさいしょ": "مُوَاصَفَة",
 "めいさく": "تُحْفَة, رَائِعَة",
 "めいさつ": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة",
 "めいし": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة / نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\". / اِسْم الذَّات (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟",
 "めいしく": "عبارة اسمية (عبارة يمكن أن تعمل كفاعل أو مفعول به لفعل)",
 "めいしこうかんかい": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة",
 "めいしこうかんパーティー": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة",
 "めいしそうとうごく": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي",
 "めいしゃ": "أخصائي عيون, طبيب عيون (طبيب متخصص في تشخيص وعلاج أمراض العين)",
 "めいしゅ": "سَيِّد\nمثال: يبدو زيري أحسن. / قَائِد, زَعِيم",
 "めいしゅや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)\nمثال: لنعد إلى البيت.",
 "めいしょ": "منظار التسديد, موجّه (أداة بصرية لمساعدة العين في التصويب، كما في سلاح ناري أو أداة مسح)",
 "めいしょう": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة) / بُرْهَان, دَلِيل",
 "めいしょし": "رؤية ضوئية, رؤية نهارية (رؤية طبيعية في ضوء النهار؛ رؤية بإضاءة كافية لتنشيط المخاريط وإدراك تدرج اللون)",
 "めいしん": "خُرَافَة",
 "めいしんぶかい": "خُرَافِيّ",
 "めいじ": "إيضاح, تبيان (تفسير يزيل عقبات الفهم)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي / اِصْطِلَاح, مُصْطَلَح",
 "めいじえん": "التهاب الأذن الداخلية, التهاب التيه (التهاب الأذن الداخلية؛ يمكن أن يسبب الدوار والقيء)",
 "めいじつ": "اسمياً فقط, بالاسم (باللقب أو السمعة ولكن ليس في الواقع)\nمثال: هو طبيب بالاسم فقط",
 "めいじてき": "صريح",
 "めいじてきへいれつめいれいコンピューティングぎじゅつ": "مَلْحَمَة",
 "めいじむじゅん": "تناقض, تناقض لفظي ((منطق) بيان كاذب بالضرورة)\nمثال: العبارة 'هو شجاع وهو ليس شجاعاً' هي تناقض",
 "めいじゅんのう": "تأقلم مع الضوء (عملية تكيف العينين مع مستويات عالية نسبياً من الإضاءة؛ تتقلص الحدقة وينشط نظام…)",
 "めいじょう": "وَصْف, تَوْصِيف",
 "めいじょうしがたい": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "めいじる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めいじん": "سَيِّد\nمثال: يبدو زيري أحسن.",
 "めいじんげい": "اتقان, براعة فنية (المهارة الفنية أو الطلاقة أو الأسلوب الذي يظهره الفنان البارع)",
 "めいす": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "めいすう": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر",
 "めいすうほう": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
 "めいする": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "めいずる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めいせい": "شُهْرَة",
 "めいせき": "شَفَّاف / اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد))",
 "めいそう": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة)\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / تَائِه (غَيْر قادِر عَلى إيجاد طَريقِه) / خِدَاع, ضَلَالَة",
 "めいそうしんけい": "عَصَب مُبْهَم",
 "めいた": "فَسْقِيَّة, فِسْقِيَّة",
 "めいたつ": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "めいだい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "めいだいろんり": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط…)",
 "めいだいろんりがく": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط…)",
 "めいち": "حصافة, حكمة (سمة تكوين الآراء عن طريق التمييز والتقييم)",
 "めいちゅう": "أَصَابَ\nمثال: تلقى مناد ضربة. / ثاقبة الخشب, حفار الخشب (أي من الحشرات أو اليرقات أو الرخويات المختلفة التي تحفر في الخشب)",
 "めいちゅうだん": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "めいちょ": "تُحْفَة, رَائِعَة",
 "めいちょう": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / تَوْضِيح / طائر مغرد (أي طائر له نداء موسيقي)",
 "めいちょうし": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة…)",
 "めいっこ": "بِنْتُ أَخٍ, بِنْتُ أُخْتٍ",
 "めいっぱい": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "めいてい": "سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "めいていしゃ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "めいてつ": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "めいてん": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "めいとう": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ) / اِنْتِصَاب",
 "めいとく": "فَضِيلَة",
 "めいど": "سِجِّين, عَالَم سُفْلِيّ / سُطُوع",
 "めいどう": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض)\nمثال: سمعوا هدير الرعد",
 "めいぬ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めいはく": "بَدِيهِيّ, بَدَهِيّ",
 "めいはん": "بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "めいばつ": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "めいばん": "لوحة الاسم (لوحة تحمل اسماً)",
 "めいひん": "تُحْفَة, رَائِعَة",
 "めいび": "بَدِيع المَنْظَر, خَلَّاب (يوحي بأنه مناسب لصورة؛ جميل كاللوحة)",
 "めいびん": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "めいふ": "سِجِّين, عَالَم سُفْلِيّ / جَهَنَّم, جَحِيم",
 "めいぶつ": "اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "めいぶつおとこ": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "めいぶん": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / التزام أخلاقي (التزام ينشأ عن اعتبارات الصواب والخطأ) / تَبْرِير / سُمْعَة, شُهْرَة",
 "めいぶんか": "اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "めいべん": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة",
 "めいほう": "حَلِيف, حَلِيفَة",
 "めいぼ": "دَحْرَجَ, تَدَحْرَجَ\nمثال: 名簿に私の名前も追加してください。 — من فضلك أضف اسمي إلى اللائحة. / خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "めいぼう": "سُمْعَة, شُهْرَة",
 "めいぼく": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "めいぼしきひれいだいひょうせい": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "めいみゃく": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "めいむ": "هَلْوَسَة, وَهْم",
 "めいめい": "تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها / كُلّ\nمثال: 生徒はめいめい自分の机を持っている。 — كل طالب لديه مقعد خاص به. / غَامِق, دَاكِن",
 "めいめいしき": "تسمية في المعمودية (إعطاء اسم مسيحي عند المعمودية)",
 "めいめいしゃ": "مُسَمٍّ (شخص يطلق اسماً أو أسماء)\nمثال: عادة ما يكون المالك هو من يسمي القارب",
 "めいめいのうち": "على حين غرة, في موقف حرج (في وضع غير موات أو مفاجئ)\nمثال: أُخذت على حين غرة (نفد ما لدي)",
 "めいめいび": "يَوْم اِسْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "めいめいほう": "تَسْمِيَة",
 "めいめつ": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "めいもう": "هَلْوَسَة, وَهْم",
 "めいもく": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / ذَرِيعَة, عُذْر",
 "めいもくじょう": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "めいもくてき": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "めいもくろん": "اسمية ((فلسفة) المذهب القائل بأن الأشياء المختلفة التي تحمل نفس المصطلح ليس بينها قاسم…)",
 "めいもんく": "إبيجرام, قول فطن (قول ذكي أو ظريف)",
 "めいやく": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "めいゆ": "تَشْبِيه",
 "めいゆう": "إِجَّامَة",
 "めいよ": "شَرَف, عِزَّة (شَرَف)\nمثال: لا أستحق هذا الشرف. / سُمْعَة\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / فَخْرِيّ",
 "めいよがくい": "درجة فخرية, شهادة فخرية (درجة تُمنح لتكريم المتلقي)",
 "めいよきそん": "تشهير, قذف",
 "めいよきそんざい": "تَشْهِير, بُهْتَان",
 "めいよさつじん": "جريمة شرف, قتل الشرف (تقليد قديم لا يزال يتبع أحياناً؛ حيث يقتل ذكر من الأسرة قريبته بدعوى تلويث سمعة…)",
 "めいよじょたい": "تسريح مشرف (تسريح من القوات المسلحة بسجل محمود)",
 "めいよのさつじん": "جريمة شرف, قتل الشرف (تقليد قديم لا يزال يتبع أحياناً؛ حيث يقتل ذكر من الأسرة قريبته بدعوى تلويث سمعة…)",
 "めいらん": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "めいりゅう": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "めいりょう": "شَفَّاف\nمثال: その２語の用法の区別は明瞭である。 — الفرق في الاستخدام بين الكلمتين واضح.",
 "めいりょうど": "مَفْهُومِيَّة, وُضُوح المَعْنَى (صفة اللغة التي تكون مفهومة) / تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة)\nمثال: التعبير عن مشاعري",
 "めいれい": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "めいれいいっか": "مَنْقُول, مُتَوَارَث (اِنْتَقَلَ مِنْ جِيلٍ إِلَى جِيل)",
 "めいれいがた": "أَسَاسِيّ, ضَرُورِيّ",
 "めいれいがたプログラミング": "برمجة أمرية (نموذج برمجة يصف الحساب من حيث البيانات التي تغير حالة البرنامج)\nمثال: البرمجة الإجرائية هي نوع محدد (أو مجموعة فرعية) من البرمجة الأمرية",
 "めいれいけい": "صِيغَة الأَمْر (صيغة تعبر عن نية للتأثير على سلوك المستمع)",
 "めいれいさいしこう": "إجراء, تنفيذ ((في علم الحاسوب) عملية تنفيذ تعليمة بواسطة الكمبيوتر)",
 "めいれいしょ": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "めいれいほう": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "めいれいコード": "رمز العملية, كود العملية (الجزء من مجموعة أوصاف العمليات الذي يحدد العملية التي سيتم تنفيذها؛ مجموعة…)",
 "めいろ": "مَتَاهَة / أذن داخلية, تيه (نظام معقد من التجاويف المترابطة؛ معني بالسمع والتوازن) / تعبير, ملامح (المشاعر الظاهرة على وجه الشخص)\nمثال: تعبير حزين",
 "めいろう": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / شَفَّاف",
 "めいろどうみゃく": "شريان الأذن الداخلية, شريان تيهي (شريان هو فرع من الشريان القاعدي يغذي التيه (الأذن الداخلية))",
 "めいろん": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس…)",
 "めいわく": "مُشْكِلَة, مَتاعِب",
 "めいわくこうい": "تَحَرُّش",
 "めいわくもの": "إِزْعَاج",
 "めいわくをかける": "أَزْعَجَ",
 "めいわくメール": "بَيَانٌ مُزْعِج, سُخَام (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء…)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "めうえ": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ)",
 "めうし": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "めうじ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض…)\nمثال: زيري لديه بقرة.",
 "めうち": "تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل))\nمثال: ثقب في طبلة الأذن",
 "めうつり": "تشتيت, صرف الانتباه (عملية التشتيت؛ صرف انتباه شخص ما عن شيء ما)\nمثال: السحرة خبراء في صرف الانتباه",
 "めうま": "حِجْر, فَرَس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "めおと": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "めおとづれ": "زَوْجَانِ",
 "めおとばか": "زَوْجَانِ",
 "めおとようし": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "めか": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めかくし": "غَمَّى",
 "めかけ": "سَيِّدَة",
 "めかけばら": "غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون)",
 "めかしや": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة)",
 "めかし屋": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة)",
 "めかじき": "سَمَكَة سَيْف (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "めかず": "عَدَّ",
 "めかた": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "めからうろこのおちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي)",
 "めからウロコのおちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي)",
 "めが": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めがお": "إِشَارَة",
 "めがさめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "めがでる": "بُرْعُم",
 "めがねいれ": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "めがねぐま": "دب أبو نظارة",
 "めがねざる": "تَارْسِير",
 "めがねてん": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "めがねへび": "كوبرا هندية (كوبرا من أفريقيا الاستوائية وآسيا)",
 "めがねや": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "めがねカイマン": "كايمان نظاراتي (كايمان ذو حواف عظمية حول العينين؛ يوجد من جنوب المكسيك إلى الأرجنتين)",
 "めがねケース": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "めがねレンチ": "مفتاح حلقي, مفتاح مغلق (مفتاح ربط بحلقة مغلقة (لقمة) تتناسب فوق صامولة أو رأس مسمار)",
 "めがね入れ": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "めがね店": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "めがみ": "إِلَاهَة, إِلٰهَة",
 "めきき": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين",
 "めきめき": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "めぎ": "باربيريس ياباني (شجيرة نفضية مدمجة لها توت أحمر دائم؛ واسعة الانتشار في الزراعة خاصة للأسوار…)",
 "めぎつね": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めぎみ": "اِبْنَة, بِنْت / زَوْجَة, اِمْرَأَة",
 "めくされ": "غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "めくされがね": "أجر زهيد, مبلغ ضئيل (دفعة غير كافية)\nمثال: يعملون طوال اليوم مقابل مبلغ زهيد",
 "めくそ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "めくばせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "めくら": "عَمًى / أُمِّيَّة / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "めくらいん": "خَتْم مَطَّاطِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めくらうなぎ": "جُرَيْث",
 "めくらぐも": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "めくらせんにんめあきせんにん": "أَلْف (يَدُلُّ عَلَى العَدَد 1000)",
 "めくらながや": "مبنى سكني متهالك, نزل رخيص (مبنى سكني متهالك بالكاد يفي بالمعايير الدنيا)",
 "めくらへび": "ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "めくらまし": "تمويه, ستار دخاني (إجراء يهدف إلى الإخفاء أو الإرباك أو التعتيم)\nمثال: طلب صلاحيات مراقبة جديدة هو مجرد ستار دخاني لإخفاء فشلهم / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "めくらめっぽう": "مُتَهَوِّر",
 "めくら印": "خَتْم مَطَّاطِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めくら滅法": "مُتَهَوِّر",
 "めくら蛇": "ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "めくりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "めくり上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "めくる": "قَلَبَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "めくるめく": "إبهار, إعشاء (سطوع يكفي للتسبب بالعمى الجزئي والمؤقت)",
 "めくわせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "めぐし": "اِتِّهَام, شَكّ",
 "めぐすり": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "めぐみ": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا. / فِرْقَة مَطَافِئ",
 "めぐみのかしら": "فِرْقَة مَطَافِئ",
 "めぐみふかい": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "めぐみぶかい": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "めぐむ": "بُرْعُم / بَارَكَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "めぐらす": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)\nمثال: 彼は家の周りに塀をめぐらした。 — بنى سِياجاً حول بيته. / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك…)\nمثال: اعتبر نفسك محظوظا / أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "めぐり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / رِحْلَة / انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "めぐりあわせ": "ثَرْوَة",
 "めぐり合わせ": "ثَرْوَة",
 "めぐる": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع. / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة.",
 "めぐわせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "めけん": "تَفَقُّد",
 "めこ": "زَوْجَة, اِمْرَأَة / بِنْت\nمثال: أنا أري الفتاة. / مَهْبَل",
 "めこぼし": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "めこぼれ": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "めごい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "めさき": "فَوْرِيّ / بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "めされる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك.",
 "めざし": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "めざとい": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ)",
 "めざまし": "مُنَبِّه, سَاعَة مُنَبِّهَة / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "めざましい": "لافت للنظر",
 "めざましどけい": "مُنَبِّه, سَاعَة مُنَبِّهَة",
 "めざます": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "めざめ": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه)\nمثال: أيام الخطر وليالي اليقظة",
 "めざめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ…)\nمثال: و أخيرا حقق هدفه.",
 "めざわり": "قذى للعين, منظر مؤذٍ للعين (شيء قبيح ومسيء جداً) / إعاقة (الوقوف في طريق شخص ما)\nمثال: عرقلة سير العدالة",
 "めし": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له. / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / مَعِيشَة, مَعَاش",
 "めしあがりもの": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "めしあがる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "めしあげる": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد / يَسْتَحْضِر, يَسْتَدْعِي",
 "めしい": "عَمًى",
 "めしうど": "سَجِين, سَجِينَة",
 "めしうま": "شَمَاتَة",
 "めしか": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めしかかえる": "وَظَّفَ",
 "めした": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "めしたき": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "めしだす": "يَسْتَحْضِر, يَسْتَدْعِي",
 "めしつかい": "خَادِم, خَادِمَة",
 "めしつかう": "وَظَّفَ",
 "めしつれる": "رَافَقَ\nمثال: من صاحب هذه الأرض؟",
 "めしとる": "تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "めしどき": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "めしのたね": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "めしべ": "مِدَقَّة",
 "めしもの": "مَلَابِس, ثِيَاب",
 "めしもり": "خادمة (عاملة منزلية)",
 "めしや": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "めしゅうど": "سَجِين, سَجِينَة",
 "めしをくう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "めし屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "めじ": "مُشْتَرَك / ساحة بصرية",
 "めじか": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めじゃもの": "زَوْجَة, اِمْرَأَة",
 "めじゃ者": "زَوْجَة, اِمْرَأَة",
 "めじるし": "دَرَجَة\nمثال: الصهاينة أشر من النازيين. / مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "めじろおし": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع)) / مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "めじろざめ": "قرش الرمل (أكثر أنواع القرش الرمادي شيوعاً على طول سواحل ولايات وسط المحيط الأطلسي؛ بطيء…)",
 "めじろ押し": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع)) / مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "めす": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في…) / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "めすいぬ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めすしゅう": "جَسَدُ الأُنْثَى (جسد أنثى بشرية)",
 "めすねじ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "めすのきつね": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めすの狐": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めすぶた": "خِنْزِيرَة\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / عَاهِرَة (امرأة تتاجر بجسدها؛ امرأة تقدم خدمات جنسية بمقابل مادي)\nمثال: قتل سامي عاهرة.",
 "めずらか": "نَادِر",
 "めずらしい": "نَادِر / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / غَرَامَة",
 "めせん": "رَنَا ((رَنَا) رنوا ورنوا: أدام النظر في سكون طرف. ويقال رناه ورنا إليه ورنا له…) / وِجْهَة نَظَر, حَيْثِيَّة",
 "めそめそ": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "めたくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めたたく": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "めたて": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "めだか": "كيلي فيش (أسماك صغيرة تعيش في أسراب تشبه الشبوط وتعيش في المياه الدافئة البحرية غالباً…)",
 "めだし": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "めだしぼう": "قناع التزلج (قناع صوفي للوجه لحماية الوجه من البرد أثناء التزلج على الثلج)",
 "めだち": "بُرْعُم",
 "めだちたがり": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "めだちたがりや": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "めだま": "مُقْلَة اَلْعَيْن / قطعة مركزية (شيء يوضع في وسط شيء آخر (كما على الطاولة))\nمثال: كان التعليم الركيزة الأساسية للبرنامج السياسي للحزب الديمقراطي / سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن) / مَقْلِيٌّ مِنْ جَانِبٍ وَاحِد ((عَنِ البَيْض) مَقْلِيٌّ عَلَى جَانِبٍ وَاحِدٍ فَقَط)",
 "めだまがとびでる": "بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "めだましょうひん": "سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن) / جَاذِبٌ لِلنَّظَرِ, لَافِتٌ لِلِانْتِبَاهِ (يَسْتَحْوِذُ عَلَى الِانْتِبَاهِ)",
 "めだまやき": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من…)\nمثال: ياني يحب البيض.",
 "めだまクリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "めちゃ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عَبَثِيّ, سَخِيف / مُفْرِط, زَائِد",
 "めちゃくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めちゃくちゃ": "عَبَثِيّ, سَخِيف / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / غير منضبط, فوضوي (غير منضبط ومشاكس)\nمثال: شباب مشاغبون / بشكل خرافي, بشكل لا يصدق (بشكل مفرط؛ للغاية)\nمثال: تعزف بشكل جيد خرافي",
 "めちゃめちゃ": "غير منضبط, فوضوي (غير منضبط ومشاكس)\nمثال: شباب مشاغبون / عَبَثِيّ, سَخِيف / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めちゃんこ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めちんちん": "فَرْج, حِرّ",
 "めっき": "طلاء معدني (وضع طبقة رقيقة من المعدن (كما هو الحال في التحليل الكهربائي)) / ذريعة",
 "めっきゃく": "تَدْمِير, هَدْم",
 "めっきり": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "めっきん": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى…)",
 "めっきんざい": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم…)",
 "めっけもの": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "めっけもん": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "めっける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "めっさ": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "めっさつ": "إبادة, طمس (التدمير عن طريق إفناء الشيء تماماً)",
 "めっし": "إِيثَار, غَيْرِيَّة",
 "めっしつ": "تَدْمِير, هَدْم",
 "めっす": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / دَمَّرَ",
 "めっする": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / دَمَّرَ",
 "めっそう": "مُسْرِف",
 "めっそうもない": "هُرَاء, لَغْو",
 "めった": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة / عَادِيّ, مَأْلُوف / مُفْرِط, زَائِد",
 "めったくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めったに": "قَلِيلًا, قَلِيلًا مَا",
 "めったにない": "نَادِر",
 "めったにみられない": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "めったに見られない": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو…)\nمثال: طيور غير شائعة",
 "めったやたら": "مُتَهَوِّر",
 "めっちゃ": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "めっちゃくちゃ": "عَبَثِيّ, سَخِيف / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / غير منضبط, فوضوي (غير منضبط ومشاكس)\nمثال: شباب مشاغبون / بشكل خرافي, بشكل لا يصدق (بشكل مفرط؛ للغاية)\nمثال: تعزف بشكل جيد خرافي",
 "めっちゃんこ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めっっちゃ": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "めっっっちゃ": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "めっっっっちゃ": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "めっぱ": "خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "めっぽう": "بشكل استثنائي, بشكل مفرط (لدرجة مفاجئة)\nمثال: كانت ذكية بشكل مفرط / اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "めつ": "تَدْمِير, هَدْم / اَلنِّرْفَانَا / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "めつき": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "めつけ": "رقيب (شخص مخول بقراءة المنشورات أو المراسلات أو مشاهدة العروض المسرحية ومنع أي شيء…)",
 "めつざい": "كَفَّارَة",
 "めつぼう": "دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة)\nمثال: سقوط آل هابسبورغ",
 "めつら": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "めつれつ": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة)\nمثال: عرض منتفخ ومفكك",
 "めづら": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "めて": "يَمِين, يُمْنَى",
 "めでたい": "سَعِيد\nمثال: فرح فاضل كثيرا. / سَاذَج",
 "めでたし": "سَعِيد\nمثال: فرح فاضل كثيرا.",
 "めでる": "حَبِيب, حَبِيبَة\nمثال: لا أحب المدرسة. / عَجَبَ",
 "めとる": "تَزَوَّجَ\nمثال: زوجة ماري طبيبة.",
 "めど": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / توقع, احتمال / ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / عَرَافَة",
 "めどおり": "جُمْهُور, نَظَّارَة",
 "めどがたたず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين)",
 "めどがたたない": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين)",
 "めどがたつ": "هُنَاكَ, يُوجَدُ",
 "めどが立たず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين)",
 "めどが立たない": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين)",
 "めどが立つ": "هُنَاكَ, يُوجَدُ",
 "めどぎ": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "めどはぎ": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "めどめ": "حشوة (التبغ المستخدم لتشكيل لب السيجار)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "めにあう": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "めにうかぶ": "صُورَة, تَصْوِير",
 "めにかかる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري.",
 "めにする": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "めにつく": "لَاحَظَ",
 "めにとどめる": "أَعَارَ اِنْتِبَاه",
 "めにはめを": "الْعَيْنُ بِالْعَيْن",
 "めにみえて": "بشكل مرئي (بحيث يكون مرئياً)\nمثال: عرضت العلامة بشكل مرئي",
 "めにもとまらぬ": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "めぬき": "رَئِيسِيّ\nمثال: زيري هو المدير.",
 "めぬきどおり": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
 "めねじ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "めのあらい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "めのいろ": "لون العين (تصبغ قزحية العين)\nمثال: لا تزال وراثة لون العين، مثل لون الشعر، قيد البحث، ومن الواضح أن عدة جينات يمكن أن تعدل النتيجة النهائية",
 "めのう": "عقيق",
 "めのうえのこぶ": "إِزْعَاج",
 "めのこ": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "めのこまかい": "غَرَامَة",
 "めのさめるよう": "خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت)",
 "めのたま": "مُقْلَة اَلْعَيْن",
 "めのたまがとびでる": "بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "めのつけどころ": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "めのつんだ": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "めのと": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "めのとどかないところ": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء)\nمثال: استلقى متربصاً",
 "めのとどくかぎり": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "めのとどくところに": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "めのどく": "فِتْنَة, إِغْرَاء",
 "めのふじゆう": "عَمًى",
 "めのまえ": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / فَوْرِيّ",
 "めのわらべ": "بِنْت\nمثال: أنا أري الفتاة.",
 "めのわらわ": "بِنْت\nمثال: أنا أري الفتاة.",
 "めはし": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "めはな": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "めはなだち": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "めばえ": "بُرْعُم",
 "めばえる": "بُرْعُم / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "めばたき": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "めばたく": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "めばち": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / مَلِكَة, ملكة (مؤنث مَلِك)\nمثال: ليحفظ الله الملكة.",
 "めばちこ": "خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "めばやい": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ)",
 "めばり": "شريط عزل الطقس (شريط ضيق من المواد لتغطية مفصل الباب أو النافذة لمنع البرد)",
 "めひょう": "أنثى النمر (أنثى النمر)",
 "めぶき": "بُرْعُم",
 "めぶく": "بُرْعُم / طَوَّرَ",
 "めぶた": "خِنْزِيرَة\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "めべり": "خَسَارَة, فِقْدَان / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "めぼ": "خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "めぼうき": "ريحان (أوراق الريحان الشائع؛ تستخدم طازجة أو مجففة)",
 "めぼし": "حَقَّانِيّ, عَقْلَانِيّ\nمثال: لقد أخطأ الهدف.",
 "めぼしい": "مَرْمُوق, بَارِز",
 "めま": "حِجْر, فَرَس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
