 "ものほし": "منشر غسيل (هيكل لتعليق الملابس (كما للتجفيف))",
 "ものほしげ": "طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
 "ものほしざお": "حبل الغسيل (حبل تُعلق عليه الملابس لتجف)",
 "ものほしそう": "تَأَمُّلِيّ, حَنِين (يُظهر حزناً تأمُّلياً وحنيناً هادئاً)",
 "ものほしづな": "حبل الغسيل (حبل تُعلق عليه الملابس لتجف)",
 "ものまね": "تَقْلِيد",
 "ものみ": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة / كَشَّاف / مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものみだかい": "فُضُولِيّ",
 "ものみのとう": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものみの塔": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものみやぐら": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものめずらしい": "فُضُولِيّ",
 "ものめずらしげに": "بشكل غريب, بشكل لا يمكن تفسيره (بطريقة تختلف عن المعتاد أو المتوقع)\nمثال: كان لديه صوت أجش بشكل مثير للفضول",
 "ものもうす": "عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ものもち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "ものものしい": "صَارِم / بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)\nمثال: احتفال مثير للإعجاب",
 "ものもらい": "سَائِل / خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "ものやわらか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ものわかり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "ものわかりがいい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "ものわかりがよい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "ものわかりがわるい": "كَثِيف, غَلِيظ",
 "ものわかりのいい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "ものわかりのよい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس)\nمثال: خيار معقول",
 "ものわすれ": "كثرة النسيان, نسيان (الميل للنسيان)\nمثال: ازداد سهوه مع تقدمه في السن",
 "ものわらい": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ものわらいのたね": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ものを": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "ものをいう": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ものを言う": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
