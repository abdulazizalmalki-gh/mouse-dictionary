 "むらさきがかった": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "むらさきくんしらん": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "むらさきごてん": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "むらさきすいしょう": "جَمَشْت",
 "むらさきずいしょう": "جَمَشْت",
 "むらさきせきえい": "جَمَشْت",
 "むらさきっぽい": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "むらさきつばめ": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "むらさきはしどい": "لَيْلَك / لَيْلَكِيّ",
 "むらさきはなまめ": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "むらさきべんけいそう": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "むらさきましこ": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "むらざと": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "むらしゃかい": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "むらじゅう": "جَمِيع أَنْحَاء, كُلّ",
 "むらっけ": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "むらっ気": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "むらなく": "بالتساوي, بانتظام (بطريقة مستوية ومنتظمة) / بالتساوي, بالمناصفة (بكميات أو حصص متساوية؛ بطريقة متوازنة أو محايدة)\nمثال: فصل دراسي مقسم بالتساوي بين الفتيات والفتيان",
 "むらはちぶ": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "むらびと": "قَرَوِيّ, قَرَوِيَّة",
 "むらむら": "بِشَكْل سَاحِق, بِقُوَّة قَاهِرَة (بشكل لا يمكن مقاومته)\nمثال: بدت الحلوى مرغوبة بشكل ساحق للرجل الذي يتبع حمية / قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "むらやま": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "むら気": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "むり": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً) / مُسْتَحِيل / بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة) / مُفْرِط, زَائِد",
 "むりおうじょう": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "むりおし": "جَرَّفَ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "むりからぬ": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "むりくり": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "むりじい": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "むりすう": "عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))",
 "むりない": "طَبِيعِيّ",
 "むりなく": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "むりのない": "طَبِيعِيّ",
 "むりはない": "طَبِيعِيّ",
 "むりひどう": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / بِلَا وَازِع, عَدِيمُ الضَّمِير (يفتقر إلى الضمير والوازع الأخلاقيّ)",
 "むりもない": "طَبِيعِيّ",
 "むりやり": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "むりょ": "حَوَالَيْ, تَقْرِيبًا",
 "むりょう": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر. / مَلَل, ضَجَر / ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق) / سخط, عدم رضا (توق لشيء أفضل من الوضع الحالي)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة / لَا يُقَاسُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "むりょうつうわ": "مجاني (لا تفرض عليه رسوم استخدام)\nمثال: طريق مجاني",
 "むりょく": "ضَعْف, عَجْز (صفة الافتقار إلى القوة أو القدرة؛ الضعف والوهن)",
 "むるい": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "むれ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "むれる": "كَوْم",
 "むろ": "دَفِيئَة زِرَاعِيّة, دَفِيئَة",
 "むろあじ": "ماكريل سكاد (سمكة فضية صغيرة؛ من نوفا سكوشا إلى البرازيل)",
 "むろつみ": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "むろん": "طَبْعًا",
 "むわっと": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "むわむわ": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "むわりと": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "むわんしょう": "انعدام الذراعين (حالة عدم وجود أذرع)",
 "むんず": "بشدة, بقوة (بقوة أو بطريقة قوية) / بشدة, بقوة (بطريقة قوية)\nمثال: يجادل بقوة لاقتراحه",
 "むんむん": "جَامِد, مُمِلّ (تَقْلِيدِيٌّ بِإِفْرَاطٍ وَيَفْتَقِرُ لِلخَيَالِ مِمَّا يَجْعَلُهُ مُمِلًّا) / خَانِق, مُحْتَقِن (يعاني من إحساس بالانسداد أو الاحتقان) / خَانِق, كَتِيم (يَفْتَقِرُ إِلَى الهَوَاءِ النَّقِيّ)",
 "むリスクきんり": "بِلَا مُخَاطَرَة, خَالٍ مِنَ المَخَاطِر (يُعتَقد أنّه خالٍ من المخاطر)",
 "むーっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "め": "نَبْتَة / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة / مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان / أَصْغَر (صغير نسبةً إلى شيء آخر) / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / زَوْجَة, اِمْرَأَة",
 "めあか": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "めあかし": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "めあきせんにんめくらせんにん": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "めあたらしい": "أَصْلِيّ",
 "めあて": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف. / مَشْهَد / مَنْظَر",
 "めあわせる": "زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "めい": "بِنْتُ أَخٍ, بِنْتُ أُخْتٍ / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر / نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية. / اسم أول, اسم شخصي (الاسم الذي يسبق اللقب) / مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\") / مَشْهُور (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور. / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / اِسْم الذَّات (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟ / سُطُوع / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة / بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة. / تَحَالُف, اِتِّحَاد / عُصْبَة, اِتِّحَاد / دَوْرِيّ (لُفِّي؛ اسْتَدِيرِي)\nمثال: كان دوري كي أنظف المسكن / شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة) / فِنْجَان شَاي (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: صب الشاي لضيفك.",
 "めいあん": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "めいあんきょうかいせん": "مُبِيد (مَادَّةٌ كيميائيَّة سَامَّةٌ تُستخدم لإِبَادَةِ الْحَشَرَاتِ والجراثيم)\nمثال: اشترى ياني مبيد النمل.",
 "めいうつ": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "めいうん": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "めいおう": "هَادِيس / بْلُوتُو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "めいおうせい": "بْلُوتُو (طريقة هجاء بديلة لـ\"بُلُوتُو\")\nمثال: بلوتو مظلم جدا.",
 "めいおうだい": "بُلُوتُونِيّ, جَحِيمِيّ (مُتعلق بالجحيم أو العالم السفلي أو من سماته)",
 "めいか": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / مَنْطِقِيّ",
 "めいかい": "هَادِيس / شَفَّاف / وَاضِح",
 "めいかく": "شَفَّاف / وَاضِح",
 "めいかくか": "تَوْضِيح",
 "めいかん": "دليل (قائمة أبجدية بالأسماء والعناوين) / دليل ((علوم الكمبيوتر) قائمة بالملفات المخزنة في الذاكرة (عادة على قرص صلب)) / مصفار",
 "めいが": "تُحْفَة, رَائِعَة / عثة بيراليد (عثة استوائية عادة نحيلة الجسم طويلة الأرجل تعتبر يرقاتها آفات للمحاصيل)",
 "めいがら": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ. / عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "めいき": "مُوَاصَفَة / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "めいきゅう": "مَتَاهَة / سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا. / زِنْزَانَة, دَيْمَاس",
 "めいきょく": "تُحْفَة, رَائِعَة",
 "めいきん": "طائر مغرد (أي طائر له نداء موسيقي)",
 "めいきんるい": "طائر مغرد (طائر جاثم له جهاز صوتي متخصص) / شادي, غريد (من أو متعلق بالطيور المغردة)",
 "めいぎ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / تَبْرِير",
 "めいぎじょう": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ) / اسْمِيّ, بِاسْم شَخْص مُعَيَّن (مُسَمًّى؛ يحمل اسم شخص محدد) / رَمْزِيّ, شَكْلِيّ (صغير بشكل لا يُذكر؛ مجرد إجراء شكلي ('شَكْلِيّ' غير رسمي)) / اسمي (متعلق بـ أو من سمات مبلغ لم يتم تعديله للتضخم)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "めいけん": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "めいげつ": "قمر الحصاد (القمر المكتمل الأقرب إلى الاعتدال الخريفي (في سبتمبر)) / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "めいげん": "إِعْلَان, بَيَان / دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "めいげんしゅう": "مختارات أدبية, مقتطفات (مجموعة من المقتطفات من عمل أدبي)",
 "めいこう": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "めいこうだい": "صُغْبَة",
 "めいこん": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "めいご": "بِنْتُ أَخٍ, بِنْتُ أُخْتٍ",
 "めいごう": "شُهْرَة",
 "めいさい": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / مُفَصَّل / تَمْوِيه",
 "めいさいしょ": "مُوَاصَفَة",
 "めいさく": "تُحْفَة, رَائِعَة",
 "めいさつ": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "めいし": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة / نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\". / اِسْم الذَّات (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "めいしく": "عبارة اسمية (عبارة يمكن أن تعمل كفاعل أو مفعول به لفعل)",
 "めいしこうかんかい": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة",
 "めいしこうかんパーティー": "بِطَاقَة عَمَل, بِطَاقَة مُؤَسَّسَة",
 "めいしそうとうごく": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / جَوْهَرِيّ, مَوْضُوعِيّ (يتعلّق بالطبيعة الحقيقية أو العناصر الأساسية لشيء ما) / جَوْهَرِيّ, دَسِم (في صلب الموضوع ويحفز التفكير) / اسم جوهر, لفظ اسمي (أي كلمة أو مجموعة كلمات تعمل كاسم)\nمثال: القانون الموضوعي",
 "めいしゃ": "أخصائي عيون, طبيب عيون (طبيب متخصص في تشخيص وعلاج أمراض العين)",
 "めいしゅ": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / قَائِد, زَعِيم",
 "めいしゅや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "めいしょ": "منظار التسديد, موجّه (أداة بصرية لمساعدة العين في التصويب، كما في سلاح ناري أو أداة مسح)",
 "めいしょう": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة) / بُرْهَان, دَلِيل",
 "めいしょし": "رؤية ضوئية, رؤية نهارية (رؤية طبيعية في ضوء النهار؛ رؤية بإضاءة كافية لتنشيط المخاريط وإدراك تدرج اللون)",
 "めいしん": "خُرَافَة",
 "めいしんぶかい": "خُرَافِيّ",
 "めいじ": "إيضاح, تبيان (تفسير يزيل عقبات الفهم) / تبيان, توضيح (فعل الشرح الذي يخدم في إزالة الغموض وإلقاء الضوء)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي / اِصْطِلَاح, مُصْطَلَح",
 "めいじえん": "التهاب الأذن الداخلية, التهاب التيه (التهاب الأذن الداخلية؛ يمكن أن يسبب الدوار والقيء)",
 "めいじつ": "اسمياً فقط, بالاسم (باللقب أو السمعة ولكن ليس في الواقع)\nمثال: هو طبيب بالاسم فقط",
 "めいじてき": "صريح",
 "めいじてきへいれつめいれいコンピューティングぎじゅつ": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "めいじむじゅん": "تناقض, تناقض لفظي ((منطق) بيان كاذب بالضرورة)\nمثال: العبارة 'هو شجاع وهو ليس شجاعاً' هي تناقض",
 "めいじゅんのう": "تأقلم مع الضوء (عملية تكيف العينين مع مستويات عالية نسبياً من الإضاءة؛ تتقلص الحدقة وينشط نظام المخاريط)",
 "めいじょう": "وَصْف, تَوْصِيف",
 "めいじょうしがたい": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "めいじる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めいじん": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "めいじんげい": "اتقان, براعة فنية (المهارة الفنية أو الطلاقة أو الأسلوب الذي يظهره الفنان البارع)",
 "めいす": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "めいすう": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "めいすうほう": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
 "めいする": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "めいずる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めいせい": "شُهْرَة",
 "めいせき": "شَفَّاف / وَاضِح / اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد))",
 "めいそう": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية / تَائِه (غَيْر قادِر عَلى إيجاد طَريقِه) / خِدَاع, ضَلَالَة / غَرُور",
 "めいそうしんけい": "عَصَب مُبْهَم",
 "めいた": "فَسْقِيَّة, فِسْقِيَّة",
 "めいたつ": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "めいだい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية (الفعل اللفظي للتسمية)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "めいだいろんり": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط بينها)",
 "めいだいろんりがく": "منطق القضايا (فرع من المنطق الرمزي يتعامل مع القضايا كوحدات ومع تركيباتها والروابط التي تربط بينها)",
 "めいち": "حصافة, حكمة (سمة تكوين الآراء عن طريق التمييز والتقييم) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)",
 "めいちゅう": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / ثاقبة الخشب, حفار الخشب (أي من الحشرات أو اليرقات أو الرخويات المختلفة التي تحفر في الخشب) / ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "めいちゅうだん": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "めいちょ": "تُحْفَة, رَائِعَة",
 "めいちょう": "رَائِق, سَلِس (واضح وشفّاف في اللغة؛ سهل الفهم) / بِلَّوْرِيّ, رَائِق (ينقل الضوء ويمكن الرؤية من خلاله بوضوح) / مَنْطِقِيّ, مُتَمَاسِك (قادر على التفكير والتعبير بوضوح واتّساق) / صَافِي الذِّهْن, وَاعٍ (ذو عقل صافٍ وواضح الإدراك) / تَوْضِيح / طائر مغرد (أي طائر له نداء موسيقي)",
 "めいちょうし": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "めいっこ": "بِنْتُ أَخٍ, بِنْتُ أُخْتٍ",
 "めいっぱい": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "めいてい": "سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "めいていしゃ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "めいてつ": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "めいてん": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "めいとう": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ) / اِنْتِصَاب",
 "めいとく": "فَضِيلَة / عِفَّة, طَهَارَة",
 "めいど": "سِجِّين, عَالَم سُفْلِيّ / سُطُوع",
 "めいどう": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "めいぬ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "めいはく": "بَدِيهِيّ, بَدَهِيّ",
 "めいはん": "بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "めいばつ": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "めいばん": "لوحة الاسم (لوحة تحمل اسماً)",
 "めいひん": "تُحْفَة, رَائِعَة",
 "めいび": "بَدِيع المَنْظَر, خَلَّاب (يوحي بأنه مناسب لصورة؛ جميل كاللوحة) / بَدِيع, خَلَّاب (جذّاب بصريّاً بألوانه وتفاصيله الحيّة)",
 "めいびん": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "めいふ": "سِجِّين, عَالَم سُفْلِيّ / جَهَنَّم, جَحِيم / جَحِيم, جَهَنَّم",
 "めいぶつ": "اختصاص, تخصص (مجال العمل الخاص الذي اتخذته كمسار مهني) / خاصية, سمة مميزة (سمة مميزة) / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: تخصصه هو أمراض الجهاز الهضمي",
 "めいぶつおとこ": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "めいぶん": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / التزام أخلاقي (التزام ينشأ عن اعتبارات الصواب والخطأ) / تَبْرِير / سُمْعَة, شُهْرَة",
 "めいぶんか": "اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "めいべん": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "めいほう": "حَلِيف, حَلِيفَة",
 "めいぼ": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)\nمثال: 名簿に私の名前も追加してください。 — من فضلك أضف اسمي إلى اللائحة. / خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "めいぼう": "سُمْعَة, شُهْرَة",
 "めいぼく": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "めいぼしきひれいだいひょうせい": "تَمْثِيل نِسْبِيّ (تمثيل جميع الأحزاب بما يتناسب مع تصويتهم الشعبي)",
 "めいみゃく": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "めいむ": "هَلْوَسَة, وَهْم",
 "めいめい": "تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية (الفعل اللفظي للتسمية)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها / كُلّ\nمثال: 生徒はめいめい自分の机を持っている。 — كل طالب لديه مقعد خاص به. / غَامِق, دَاكِن",
 "めいめいしき": "تسمية في المعمودية (إعطاء اسم مسيحي عند المعمودية)",
 "めいめいしゃ": "مُسَمٍّ (شخص يطلق اسماً أو أسماء)\nمثال: عادة ما يكون المالك هو من يسمي القارب",
 "めいめいのうち": "على حين غرة, في موقف حرج (في وضع غير موات أو مفاجئ) / على حين غرة, فجأة (فجأة وبشكل غير متوقع) / دون قصد, عن غير عمد (بدون تفكير مسبق أو خطة؛ سهواً)\nمثال: أُخذت على حين غرة (نفد ما لدي)",
 "めいめいび": "يَوْم اِسْم (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "めいめいほう": "تَسْمِيَة",
 "めいめつ": "خَافِت, مُتَرَجْرِج (يلمع بشكل غير ثابت ومتذبذب)",
 "めいもう": "هَلْوَسَة, وَهْم",
 "めいもく": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / ذَرِيعَة, عُذْر",
 "めいもくじょう": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ) / اسْمِيّ, بِاسْم شَخْص مُعَيَّن (مُسَمًّى؛ يحمل اسم شخص محدد) / رَمْزِيّ, شَكْلِيّ (صغير بشكل لا يُذكر؛ مجرد إجراء شكلي ('شَكْلِيّ' غير رسمي)) / اسمي (متعلق بـ أو من سمات مبلغ لم يتم تعديله للتضخم)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "めいもくてき": "اِسْمِيّ, شَرَفِيّ (لَا يُوجَدُ إِلَّا بِالِاسْمِ فَقَطْ) / اسْمِيّ, بِاسْم شَخْص مُعَيَّن (مُسَمًّى؛ يحمل اسم شخص محدد) / رَمْزِيّ, شَكْلِيّ (صغير بشكل لا يُذكر؛ مجرد إجراء شكلي ('شَكْلِيّ' غير رسمي)) / اسمي (متعلق بـ أو من سمات مبلغ لم يتم تعديله للتضخم)\nمثال: الناتج المحلي الإجمالي الاسمي",
 "めいもくろん": "اسمية ((فلسفة) المذهب القائل بأن الأشياء المختلفة التي تحمل نفس المصطلح ليس بينها قاسم مشترك سوى الاسم)",
 "めいもんく": "إبيجرام, قول فطن (قول ذكي أو ظريف)",
 "めいやく": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "めいゆ": "تَشْبِيه",
 "めいゆう": "إِجَّامَة / نَجْمَة",
 "めいよ": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف. / سُمْعَة / كَرَامَة (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية) / اِعْتِبَار (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / فَخْرِيّ",
 "めいよがくい": "درجة فخرية, شهادة فخرية (درجة تُمنح لتكريم المتلقي)",
 "めいよきそん": "تشهير, قذف",
 "めいよきそんざい": "تَشْهِير, بُهْتَان",
 "めいよさつじん": "جريمة شرف, قتل الشرف (تقليد قديم لا يزال يتبع أحياناً؛ حيث يقتل ذكر من الأسرة قريبته بدعوى تلويث سمعة العائلة)",
 "めいよじょたい": "تسريح مشرف (تسريح من القوات المسلحة بسجل محمود)",
 "めいよのさつじん": "جريمة شرف, قتل الشرف (تقليد قديم لا يزال يتبع أحياناً؛ حيث يقتل ذكر من الأسرة قريبته بدعوى تلويث سمعة العائلة)",
 "めいらん": "ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "めいりゅう": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "めいりょう": "شَفَّاف / وَاضِح\nمثال: その２語の用法の区別は明瞭である。 — الفرق في الاستخدام بين الكلمتين واضح.",
 "めいりょうど": "مَفْهُومِيَّة, وُضُوح المَعْنَى (صفة اللغة التي تكون مفهومة) / تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري",
 "めいれい": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "めいれいいっか": "مَنْقُول, مُتَوَارَث (اِنْتَقَلَ مِنْ جِيلٍ إِلَى جِيل)",
 "めいれいがた": "أَسَاسِيّ, ضَرُورِيّ",
 "めいれいがたプログラミング": "برمجة أمرية (نموذج برمجة يصف الحساب من حيث البيانات التي تغير حالة البرنامج)\nمثال: البرمجة الإجرائية هي نوع محدد (أو مجموعة فرعية) من البرمجة الأمرية",
 "めいれいけい": "صِيغَة الأَمْر (صيغة تعبر عن نية للتأثير على سلوك المستمع)",
 "めいれいさいしこう": "إجراء, تنفيذ ((في علم الحاسوب) عملية تنفيذ تعليمة بواسطة الكمبيوتر)",
 "めいれいしょ": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "めいれいほう": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "めいれいコード": "رمز العملية, كود العملية (الجزء من مجموعة أوصاف العمليات الذي يحدد العملية التي سيتم تنفيذها؛ مجموعة العمليات في الحاسوب)",
 "めいろ": "مَتَاهَة / أذن داخلية, تيه (نظام معقد من التجاويف المترابطة؛ معني بالسمع والتوازن) / تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)\nمثال: تعبير حزين",
 "めいろう": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / شَفَّاف / وَاضِح",
 "めいろどうみゃく": "شريان الأذن الداخلية, شريان تيهي (شريان هو فرع من الشريان القاعدي يغذي التيه (الأذن الداخلية))",
 "めいろん": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "めいわく": "مُشْكِلَة, مَتاعِب",
 "めいわくこうい": "تَحَرُّش",
 "めいわくもの": "إِزْعَاج",
 "めいわくをかける": "أَزْعَجَ",
 "めいわくメール": "بَيَانٌ مُزْعِج, سُخَام (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "めうえ": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "めうし": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "めうじ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "めうち": "تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل)) / تثقيب, خط ثقوب (خط من الثقوب الصغيرة للتمزيق في مكان معين) / تثقيب, خرق (ثقب مصنوع في شيء ما)\nمثال: ثقب في طبلة الأذن",
 "めうつり": "تشتيت, صرف الانتباه (عملية التشتيت؛ صرف انتباه شخص ما عن شيء ما) / إلهاء, تسرية (ترفيه يثير اهتماماً ساراً ويصرف انتباهك عن الهموم والمضايقات) / تشتت, شرود (اضطراب عقلي وتشتت في الانتباه) / إلهاء, تشتيت (عائق يمنع الانتباه)\nمثال: السحرة خبراء في صرف الانتباه",
 "めうま": "حِجْر, فَرَس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "めおと": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "めおとづれ": "زَوْجَانِ",
 "めおとばか": "زَوْجَانِ",
 "めおとようし": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "めか": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めかくし": "غَمَّى",
 "めかけ": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "めかけばら": "غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / غير شرعي (للزواج والنسل؛ غير معترف به كقانوني) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "めかしや": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / يول (سفينة شراعية بصاريتين؛ صارية خلفية صغيرة تقع خلف عمود الدفة) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "めかし屋": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / يول (سفينة شراعية بصاريتين؛ صارية خلفية صغيرة تقع خلف عمود الدفة) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "めかじき": "سَمَكَة سَيْف (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "めかず": "عَدَّ / كُونْت",
 "めかた": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "めからうろこのおちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "めからウロコのおちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "めが": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めがお": "إِشَارَة",
 "めがさめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "めがでる": "بُرْعُم",
 "めがねいれ": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "めがねぐま": "دب أبو نظارة",
 "めがねざる": "تَارْسِير",
 "めがねてん": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "めがねへび": "كوبرا هندية (كوبرا من أفريقيا الاستوائية وآسيا)",
 "めがねや": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "めがねカイマン": "كايمان نظاراتي (كايمان ذو حواف عظمية حول العينين؛ يوجد من جنوب المكسيك إلى الأرجنتين)",
 "めがねケース": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "めがねレンチ": "مفتاح حلقي, مفتاح مغلق (مفتاح ربط بحلقة مغلقة (لقمة) تتناسب فوق صامولة أو رأس مسمار)",
 "めがね入れ": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "めがね店": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "めがみ": "إِلَاهَة, إِلٰهَة / مَعْبُودَة",
 "めきき": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "めきめき": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ) / بشكل لافت, بشكل ملحوظ (بطريقة بارزة أو مميزة)\nمثال: كانت طويلة بشكل غير عادي",
 "めぎ": "باربيريس ياباني (شجيرة نفضية مدمجة لها توت أحمر دائم؛ واسعة الانتشار في الزراعة خاصة للأسوار الحية)",
 "めぎつね": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めぎみ": "اِبْنَة, بِنْت / زَوْجَة, اِمْرَأَة",
 "めくされ": "غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "めくされがね": "أجر زهيد, مبلغ ضئيل (دفعة غير كافية)\nمثال: يعملون طوال اليوم مقابل مبلغ زهيد",
 "めくそ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "めくばせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "めくら": "عَمًى / أُمِّيَّة / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "めくらいん": "خَتْم مَطَّاطِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めくらうなぎ": "جُرَيْث",
 "めくらぐも": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "めくらせんにんめあきせんにん": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "めくらながや": "مبنى سكني متهالك, نزل رخيص (مبنى سكني متهالك بالكاد يفي بالمعايير الدنيا)",
 "めくらへび": "ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "めくらまし": "تمويه, ستار دخاني (إجراء يهدف إلى الإخفاء أو الإرباك أو التعتيم) / ستار دخاني ((عسكرياً) شاشة تتكون من سحابة من الدخان تحجب التحركات)\nمثال: طلب صلاحيات مراقبة جديدة هو مجرد ستار دخاني لإخفاء فشلهم / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "めくらめっぽう": "مُتَهَوِّر",
 "めくら印": "خَتْم مَطَّاطِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "めくら滅法": "مُتَهَوِّر",
 "めくら蛇": "ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "めくりあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "めくり上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "めくる": "قَلَبَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "めくるめく": "إبهار, إعشاء (سطوع يكفي للتسبب بالعمى الجزئي والمؤقت)",
 "めくわせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "めぐし": "اِتِّهَام, شَكّ / اِتِّهَام",
 "めぐすり": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "めぐみ": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا. / فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "めぐみのかしら": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "めぐみふかい": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان) / كَيِّس, لَطِيف (يُظهر الكياسة واللطف في التعامل) / دمث, كريم النفس (يتميز بالسحر والذوق الرفيع وكرم الروح) / رَؤُوف, كَرِيم (يتسم بالطيبة والمجاملة الدافئة خاصة من ملك تجاه رعاياه)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "めぐみぶかい": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان) / كَيِّس, لَطِيف (يُظهر الكياسة واللطف في التعامل) / دمث, كريم النفس (يتميز بالسحر والذوق الرفيع وكرم الروح) / رَؤُوف, كَرِيم (يتسم بالطيبة والمجاملة الدافئة خاصة من ملك تجاه رعاياه)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "めぐむ": "بُرْعُم / بَارَكَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "めぐらす": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)\nمثال: 彼は家の周りに塀をめぐらした。 — بنى سِياجاً حول بيته. / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا / أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "めぐり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / رِحْلَة / جَوْلَة / انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "めぐりあわせ": "ثَرْوَة",
 "めぐり合わせ": "ثَرْوَة",
 "めぐる": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "めぐわせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "めけん": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "めこ": "زَوْجَة, اِمْرَأَة / بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "めこぼし": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما) / تآمر, تواطؤ (الاتفاق على مؤامرة سرية)",
 "めこぼれ": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "めごい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "めさき": "فَوْرِيّ / بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "めされる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "めざし": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "めざとい": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ) / حَادُّ البَصَر, حَادُّ النَّظَر (شَدِيدُ الانْتِبَاهِ وَالإِدْرَاك) / ثَاقِب البَصَر, حَدِيد النَّظَر (ذو بصر حادّ جدًّا)",
 "めざまし": "مُنَبِّه, سَاعَة مُنَبِّهَة / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "めざましい": "لافت للنظر",
 "めざましどけい": "مُنَبِّه, سَاعَة مُنَبِّهَة",
 "めざます": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "めざめ": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه) / صحو, يقظة (حالة البقاء مستيقظاً)\nمثال: أيام الخطر وليالي اليقظة",
 "めざめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "めざわり": "قذى للعين, منظر مؤذٍ للعين (شيء قبيح ومسيء جداً) / إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "めし": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له. / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / مَعِيشَة, مَعَاش",
 "めしあがりもの": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "めしあがる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "めしあげる": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / مَسْلُوب, مُصَادَر (تمّت مصادرته كعقوبة) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد / يَسْتَحْضِر, يَسْتَدْعِي",
 "めしい": "عَمًى",
 "めしうど": "سَجِين, سَجِينَة",
 "めしうま": "شَمَاتَة",
 "めしか": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めしかかえる": "وَظَّفَ",
 "めした": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "めしたき": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "めしだす": "يَسْتَحْضِر, يَسْتَدْعِي",
 "めしつかい": "خَادِم, خَادِمَة",
 "めしつかう": "وَظَّفَ",
 "めしつれる": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "めしとる": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "めしどき": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "めしのたね": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "めしべ": "مِدَقَّة",
 "めしもの": "مَلَابِس, ثِيَاب",
 "めしもり": "خادمة (عاملة منزلية)",
 "めしや": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "めしゅうど": "سَجِين, سَجِينَة",
 "めしをくう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "めし屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "めじ": "مُشْتَرَك / مِفْصَل / ساحة بصرية",
 "めじか": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "めじゃもの": "زَوْجَة, اِمْرَأَة",
 "めじゃ者": "زَوْجَة, اِمْرَأَة",
 "めじるし": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "めじろおし": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع)) / مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "めじろざめ": "قرش الرمل (أكثر أنواع القرش الرمادي شيوعاً على طول سواحل ولايات وسط المحيط الأطلسي؛ بطيء الحركة ويصطاده الصيادون أحياناً) / قرش أسود الطرف (قرش واسع الانتشار في المياه الضحلة، تبدو زعانفه وكأنها مغموسة في الحبر)",
 "めじろ押し": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع)) / مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "めす": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "めすいぬ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "めすしゅう": "جَسَدُ الأُنْثَى (جسد أنثى بشرية)",
 "めすねじ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "めすのきつね": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めすの狐": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めすぶた": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / عَاهِرَة (امرأة تتاجر بجسدها؛ امرأة تقدم خدمات جنسية بمقابل مادي)\nمثال: قتل سامي عاهرة.",
 "めずらか": "نَادِر",
 "めずらしい": "نَادِر / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "めせん": "رَنَا ((رَنَا) رنوا ورنوا: أدام النظر في سكون طرف. ويقال رناه ورنا إليه ورنا له؛ (رَنَا) إلى حديثه: أصغى) / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "めそめそ": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "めたくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めたたく": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "めたて": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "めだか": "كيلي فيش (أسماك صغيرة تعيش في أسراب تشبه الشبوط وتعيش في المياه الدافئة البحرية غالباً؛ تستخدم كطعم أو أسماك أحواض أو في مكافحة البعوض)",
 "めだし": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "めだしぼう": "قناع التزلج (قناع صوفي للوجه لحماية الوجه من البرد أثناء التزلج على الثلج)",
 "めだち": "بُرْعُم",
 "めだちたがり": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "めだちたがりや": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "めだま": "مُقْلَة اَلْعَيْن / قطعة مركزية (شيء يوضع في وسط شيء آخر (كما على الطاولة)) / ركيزة, قطعة مركزية (الميزة المركزية أو الأكثر أهمية)\nمثال: كان التعليم الركيزة الأساسية للبرنامج السياسي للحزب الديمقراطي / سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن) / مَقْلِيٌّ مِنْ جَانِبٍ وَاحِد ((عَنِ البَيْض) مَقْلِيٌّ عَلَى جَانِبٍ وَاحِدٍ فَقَط)",
 "めだまがとびでる": "بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "めだましょうひん": "سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن) / جَاذِبٌ لِلنَّظَرِ, لَافِتٌ لِلِانْتِبَاهِ (يَسْتَحْوِذُ عَلَى الِانْتِبَاهِ)",
 "めだまやき": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "めだまクリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "めちゃ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / عَبَثِيّ, سَخِيف / مُفْرِط, زَائِد",
 "めちゃくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めちゃくちゃ": "عَبَثِيّ, سَخِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / غير منضبط, فوضوي (غير منضبط ومشاكس) / عَشْوَائِيّ, فَوْضَوِيّ (غَيْرُ مُنَظَّمٍ تَمَامًا وَغَيْرُ مُتَوَقَّعٍ وَمُرْبِك) / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)\nمثال: شباب مشاغبون / بشكل خرافي, بشكل لا يصدق (بشكل مفرط؛ للغاية) / بِإِعْجَاز, بِشَكْل لَا يُصَدَّق (ليس من السهل تصديقه)\nمثال: تعزف بشكل جيد خرافي",
 "めちゃめちゃ": "غير منضبط, فوضوي (غير منضبط ومشاكس) / عَشْوَائِيّ, فَوْضَوِيّ (غَيْرُ مُنَظَّمٍ تَمَامًا وَغَيْرُ مُتَوَقَّعٍ وَمُرْبِك) / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)\nمثال: شباب مشاغبون / عَبَثِيّ, سَخِيف / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めちゃんこ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めちんちん": "فَرْج, حِرّ",
 "めっき": "طلاء معدني (وضع طبقة رقيقة من المعدن (كما هو الحال في التحليل الكهربائي)) / طلاء معدني (طبقة رقيقة من المعدن مترسبة على سطح ما) / ذريعة",
 "めっきゃく": "تَدْمِير, هَدْم",
 "めっきり": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ) / بشكل لافت, بشكل ملحوظ (بطريقة بارزة أو مميزة)\nمثال: كانت طويلة بشكل غير عادي",
 "めっきん": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "めっきんざい": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم الأدوات الجراحية)",
 "めっけもの": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "めっけもん": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "めっける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "めっさ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "めっさつ": "إبادة, طمس (التدمير عن طريق إفناء الشيء تماماً) / استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "めっし": "إِيثَار, غَيْرِيَّة",
 "めっしつ": "تَدْمِير, هَدْم",
 "めっす": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / دَمَّرَ",
 "めっする": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / دَمَّرَ",
 "めっそう": "مُسْرِف",
 "めっそうもない": "هُرَاء, لَغْو",
 "めった": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة / عَادِيّ, مَأْلُوف / مُفْرِط, زَائِد",
 "めったくそ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めったに": "قَلِيلًا, قَلِيلًا مَا",
 "めったにない": "نَادِر",
 "めったにみられない": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "めったに見られない": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "めったやたら": "مُتَهَوِّر",
 "めっちゃ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "めっちゃくちゃ": "عَبَثِيّ, سَخِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / غير منضبط, فوضوي (غير منضبط ومشاكس) / عَشْوَائِيّ, فَوْضَوِيّ (غَيْرُ مُنَظَّمٍ تَمَامًا وَغَيْرُ مُتَوَقَّعٍ وَمُرْبِك) / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)\nمثال: شباب مشاغبون / بشكل خرافي, بشكل لا يصدق (بشكل مفرط؛ للغاية) / بِإِعْجَاز, بِشَكْل لَا يُصَدَّق (ليس من السهل تصديقه)\nمثال: تعزف بشكل جيد خرافي",
 "めっちゃんこ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "めっっちゃ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "めっっっちゃ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "めっっっっちゃ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "めっぱ": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "めっぽう": "بشكل استثنائي, بشكل مفرط (لدرجة مفاجئة)\nمثال: كانت ذكية بشكل مفرط / اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "めつ": "تَدْمِير, هَدْم / اَلنِّرْفَانَا / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "めつき": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "めつけ": "رقيب (شخص مخول بقراءة المنشورات أو المراسلات أو مشاهدة العروض المسرحية ومنع أي شيء يعتبر فاحشاً أو غير مقبول سياسياً كلياً أو جزئياً) / لَوَّام, نَاقِد (شخص يلوم أو يدين)",
 "めつざい": "كَفَّارَة",
 "めつぼう": "دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / انهيار, سقوط (تراجع مفاجئ في القوة أو العدد أو الأهمية) / سقوط, هطول (سقوط أي شكل من أشكال الماء على الأرض (مطر أو ثلج أو برد أو صقيع أو رذاذ))\nمثال: سقوط آل هابسبورغ",
 "めつら": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "めつれつ": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "めづら": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "めて": "يَمِين, يُمْنَى",
 "めでたい": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا. / سَاذَج",
 "めでたし": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا.",
 "めでる": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة. / عَجَبَ",
 "めとる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "めど": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً) / ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / عَرَافَة",
 "めどおり": "جُمْهُور, نَظَّارَة",
 "めどがたたず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "めどがたたない": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "めどがたつ": "هُنَاكَ, يُوجَدُ",
 "めどが立たず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "めどが立たない": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "めどが立つ": "هُنَاكَ, يُوجَدُ",
 "めどぎ": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "めどはぎ": "ليسبيديزا حريرية (نبات معمر يزرع على نطاق واسع للعلف وكمحصول قش خاصة في الأراضي الفقيرة)",
 "めどめ": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "めにあう": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "めにうかぶ": "صُورَة, تَصْوِير / صُورَة, صُورَة شَمْسِيَّة",
 "めにかかる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "めにする": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "めにつく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "めにとどめる": "أَعَارَ اِنْتِبَاه",
 "めにはめを": "الْعَيْنُ بِالْعَيْن",
 "めにみえて": "بشكل مرئي (بحيث يكون مرئياً) / بوضوح, عياناً (بطريقة مرئية)\nمثال: عرضت العلامة بشكل مرئي",
 "めにもとまらぬ": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "めぬき": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "めぬきどおり": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "めねじ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "めのあらい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "めのいろ": "لون العين (تصبغ قزحية العين)\nمثال: لا تزال وراثة لون العين، مثل لون الشعر، قيد البحث، ومن الواضح أن عدة جينات يمكن أن تعدل النتيجة النهائية",
 "めのう": "عقيق",
 "めのうえのこぶ": "إِزْعَاج",
 "めのこ": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "めのこまかい": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "めのさめるよう": "خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت) / لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / صَاعِق, مُذْهِل (يسبب أو قادر على التسبب في الذهول أو الصدمة أو فقدان الوعي) / مُذْهِل, مُصْعِق (يُسبب ذهولًا وحيرة شديدين)",
 "めのたま": "مُقْلَة اَلْعَيْن",
 "めのたまがとびでる": "بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "めのつけどころ": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "めのつんだ": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "めのと": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "めのとどかないところ": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء) / بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً) / مَحْجُوب, مَخْفِيّ (غَيْرُ مُتَاحٍ لِلنَّظَر)\nمثال: استلقى متربصاً",
 "めのとどくかぎり": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "めのとどくところに": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "めのどく": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "めのふじゆう": "عَمًى",
 "めのまえ": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / فَوْرِيّ",
 "めのわらべ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "めのわらわ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "めはし": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "めはな": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "めはなだち": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "めばえ": "بُرْعُم",
 "めばえる": "بُرْعُم / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "めばたき": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "めばたく": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "めばち": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن) / مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "めばちこ": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "めばやい": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ) / حَادُّ البَصَر, حَادُّ النَّظَر (شَدِيدُ الانْتِبَاهِ وَالإِدْرَاك) / ثَاقِب البَصَر, حَدِيد النَّظَر (ذو بصر حادّ جدًّا)",
 "めばり": "شريط عزل الطقس (شريط ضيق من المواد لتغطية مفصل الباب أو النافذة لمنع البرد)",
 "めひょう": "أنثى النمر (أنثى النمر)",
 "めぶき": "بُرْعُم",
 "めぶく": "بُرْعُم / طَوَّرَ",
 "めぶた": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "めべり": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "めぼ": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "めぼうき": "ريحان (أوراق الريحان الشائع؛ تستخدم طازجة أو مجففة) / حبق, ريحان (نبات حولي أو معمر من آسيا الاستوائية له سنابل من الزهور البيضاء الصغيرة وأوراق عطرية؛ أحد أهم أعشاب الطهي؛ يستخدم في السلطات والأطعمة والصلصات وبعض…)",
 "めぼし": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "めぼしい": "مَرْمُوق, بَارِز",
 "めま": "حِجْر, فَرَس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "めまい": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "めまぐるしい": "دَائِخ",
 "めまぜ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "めまつ": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "めみえ": "مُقَابَلَة / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "めめしい": "مُخَنَّث",
 "めもあや": "باهِر",
 "めもくれず": "بلامبالاة (مع اللامبالاة؛ بطريقة غير مبالية)\nمثال: هزت كتفيها بلامبالاة",
 "めもくれない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / فَاتِر, لَامُبَالٍ (يتّسم بانعدام الاهتمام) / وَسَطِيّ (لَيْسَ مُفْرِطًا وَلَا قَلِيلًا جِدًّا)",
 "めもと": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "めもり": "تَخَرُّج",
 "めやす": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار) / تَقْرِيب",
 "めやに": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "めりこむ": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "めりはり": "تحوير / تَرَاوُح, اِخْتِلَاف / حيوية, نشاط (النشاط والحركة العامة) / حيوية, روح (الحيوية والطاقة في العمل أو التعبير)\nمثال: كانت مسرحية ثقيلة وحاول الممثلون عبثاً بث الحياة فيها",
 "めりはりのきいた": "دَجِر",
 "めりめり": "تصدع, شرخ (عملية إحداث شقوق في شيء ما) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / تصدع, طرقعة (ضجيج حاد مفاجئ) / تكسير (العملية التي يتم فيها تكسير جزيئات النفتا أو البترول الثقيلة إلى هيدروكربونات ذات وزن جزيئي أقل (خاصة في عملية تكرير النفط))\nمثال: طرقعة سوط",
 "めり込む": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "めろう": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "めろめろ": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "めをうばう": "فَتَنَ",
 "めをかける": "اِهْتَمَّ, اِعْتَنَى",
 "めをくらます": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "めをさます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "めをそむける": "غضّ النظر, غضّ الطرف / إِهْمال / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "めをそらす": "غضّ النظر, غضّ الطرف",
 "めをだす": "نَبْتَة",
 "めをつぶる": "أَغْمَضَ العَيْنَيَنِ عَنْ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "めをつむる": "أَغْمَضَ العَيْنَيَنِ عَنْ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "めをとおす": "مَسَحَ ضَوْئِيًّا (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "めをとじる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "めをとめる": "أَعَارَ اِنْتِبَاه",
 "めをはしらせる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "めをひらく": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "めをふく": "بُرْعُم",
 "めをほそくする": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "めをほそめる": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "めをまわす": "إِغْمَاء / أُغْمِيَ, غُشِيَ / مَذْهُول / أَدَارَ عَيْنَيْهِ, بَرَمَ عَيْنَيْهِ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "めをみる": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "めをやる": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة",
 "めん": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان / إِقَالَة / قُطْن, قُطُن / قُطْنِي, قطن / نُودَلْز, شَعْرِيَّة / طَحِين, دَقِيق / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / صَفْحَة, صفحة / مِيَانْمَار, بُورْمَا",
 "めんう": "زُغَيْبَة (ريش زغبي للطيور الصغيرة؛ يبقى في بعض الطيور البالغة)",
 "めんえき": "حَصَانَة, مَنَاعَة",
 "めんえきおうとう": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "めんえきおうとういでんし": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو عضو مزروع) وينتج أجسامًا مضادة محددة ضد ذلك المولد)",
 "めんえきがく": "علم المناعة (فرع العلوم الطبية الذي يدرس الجهاز المناعي للجسم)",
 "めんえきがくしゃ": "عالم مناعة (عالم طبي يتخصص في علم المناعة)",
 "めんえききこう": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "めんえきけい": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "めんえきげん": "عامل تحصين, مولد المناعة (أي مادة أو كائن حي يثير استجابة مناعية (ينتج مناعة) عند إدخاله في الجسم)",
 "めんえきげんせい": "استمناع, مولدية للمناعة (خاصية إثارة استجابة مناعية)",
 "めんえきせい": "حَصَانَة, مَنَاعَة",
 "めんえきたい": "جِسْم مُضَادّ (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "めんえきふぜん": "عوز مناعي, نقص المناعة (اضطراب مناعي يكون فيه جزء من الجهاز المناعي للجسم غير كافٍ وتنخفض المقاومة للأمراض المعدية)",
 "めんえきよくせいざい": "دواء مثبط للمناعة, مثبط للمناعة (دواء يقلل من الاستجابة المناعية الطبيعية للجسم)",
 "めんえきりょうほう": "علاج مناعي (علاج مصمم لإنتاج مناعة ضد مرض أو لتعزيز مقاومة الجهاز المناعي)",
 "めんえきりょく": "حَصَانَة, مَنَاعَة",
 "めんえきグロブリン": "غلوبولين مناعي (فئة من البروتينات تُنتج في الأنسجة الليمفاوية في الفقاريات وتعمل كأجسام مضادة في الاستجابة المناعية)",
 "めんえきシステム": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "めんか": "قطن (ألياف حريرية ناعمة من نباتات القطن في حالتها الخام)",
 "めんかい": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "めんかいけん": "حق الزيارة (الحق الذي تمنحه المحكمة لأحد الوالدين (أو قريب آخر) المحروم من حضانة الطفل لزيارة الطفل بانتظام)",
 "めんかいしゃ": "زَائِر / زَائِر, سَائِح",
 "めんかいにん": "زَائِر / زَائِر, سَائِح",
 "めんかいはつ": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "めんかく": "زاوية الوجه (الزاوية المتكونة من حافتين لزاوية متعددة السطوح)",
 "めんかやく": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "めんかん": "إِقَالَة",
 "めんきゅう": "كرة قطنية (مرض فطري يصيب التوت البري)",
 "めんきょ": "رُخْصَة, تَصْرِيح / رُخْصَة / رُخْصَةُ سِيَاقَة, رُخْصَةُ قِيَادَة",
 "めんきょしょう": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة",
 "めんきょじょう": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "めんきょていし": "رخصة قيادة (رخصة تخول حاملها قيادة مركبة آلية)",
 "めんきょばんごう": "رقم التسجيل, رقم الرخصة (الرقم الموجود على لوحة الترخيص والذي يحدد السيارة التي تحمله)",
 "めんきょりょう": "رسم الترخيص (رسم يُدفع للحكومة مقابل امتياز الترخيص للقيام بشيء ما (مثل بيع الخمور أو ممارسة الطب))",
 "めんぐ": "شبكة الخوذة, واقي الوجه (قناع للوجه يتكون من شبكة سلكية قوية في مقدمة خوذات كرة القدم)",
 "めんこい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "めんこうふはい": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "めんご": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة / وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "めんごい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "めんざい": "تَبْرِئَة / صَكّ غُفْرَان",
 "めんざいふ": "صَكّ غُفْرَان / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "めんしき": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "めんしょく": "إِقَالَة / تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "めんじつ": "حَبّ القُطْن (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "めんじつゆ": "زيت بذر القطن (زيت صالح للأكل معصور من بذور القطن)",
 "めんじょ": "إعفاء, حصانة (فعل استثناء شخص ما أو منحه الحصانة) / إعفاء (خصم مسموح به لدافع الضرائب بسبب وضعه (وجود معالين معينين أو كونه كفيفاً أو تجاوز سن 65 إلخ)) / إعفاء, تحرر (الحصانة من التزام أو واجب)\nمثال: مُنح حصانة من الملاحقة القضائية",
 "めんじょう": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة / شَهَادَة, دِبْلُوم",
 "めんじる": "طَرَدَ, أَقَالَ / مُعْفًى",
 "めんす": "نُودَلْز, شَعْرِيَّة",
 "めんずる": "طَرَدَ, أَقَالَ / مُعْفًى",
 "めんせき": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "めんせきがく": "قابل للخصم (مقبول كخصم (خاصة كخصم ضريبي)) / القيمة المقتطعة, مبلغ التحمل (بند في بوليصة التأمين يعفي شركة التأمين من مسؤولية دفع الخسارة الأولية حتى مبلغ محدد) / مبلغ قابل للخصم ((ضرائب) مبلغ يمكن خصمه (خاصة لأغراض حساب ضريبة الدخل))",
 "めんせききんがく": "قابل للخصم (مقبول كخصم (خاصة كخصم ضريبي)) / القيمة المقتطعة, مبلغ التحمل (بند في بوليصة التأمين يعفي شركة التأمين من مسؤولية دفع الخسارة الأولية حتى مبلغ محدد) / مبلغ قابل للخصم ((ضرائب) مبلغ يمكن خصمه (خاصة لأغراض حساب ضريبة الدخل))",
 "めんせきけい": "مقياس المساحة, مكامل (أداة قياس لقياس مساحة شكل مستوٍ غير منتظم)",
 "めんせきじこう": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ) / تنازل ((قانون) تنصل طوعي عن مطالبة قانونية لشخص ما بشيء ما)",
 "めんせきじょうこう": "إنكار, تتبرؤ (إنكار أي صلة أو معرفة بـ) / تنازل ((قانون) تنصل طوعي عن مطالبة قانونية لشخص ما بشيء ما)",
 "めんせきとっけん": "حصانة دبلوماسية (الإعفاء من الضرائب أو الإجراءات القانونية العادية الذي يُمنح للموظفين الدبلوماسيين في بلد أجنبي)",
 "めんせつ": "مُقَابَلَة",
 "めんせついん": "مُجري المقابلة (شخص يجري مقابلة)",
 "めんせつかん": "مُجري المقابلة (شخص يجري مقابلة)",
 "めんせつこうしょうけん": "حق الزيارة (الحق الذي تمنحه المحكمة لأحد الوالدين (أو قريب آخر) المحروم من حضانة الطفل لزيارة الطفل بانتظام)",
 "めんせつしけん": "مُقَابَلَة",
 "めんせつしけんかん": "مُجري المقابلة (شخص يجري مقابلة)",
 "めんせつしゃ": "مُجري المقابلة (شخص يجري مقابلة) / المستجوَب, ضيف المقابلة (شخص تُجرى معه مقابلة)",
 "めんせつじゅけんしゃ": "المستجوَب, ضيف المقابلة (شخص تُجرى معه مقابلة)",
 "めんぜいしょとく": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "めんぜいてん": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "めんぜいひょう": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "めんぜいひん": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "めんぜいりつ": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "めんぜん": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "めんそ": "تَبْرِئَة",
 "めんそう": "مَلَامِح",
 "めんそおれ": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "めんそち": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "めんそーれ": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "めんそーれー": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "めんたま": "مُقْلَة اَلْعَيْن",
 "めんだん": "مُقَابَلَة",
 "めんちゃい": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "めんちゅつ": "إِقَالَة",
 "めんつけ": "فَرْض",
 "めんてい": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / رخصة قيادة (رخصة تخول حاملها قيادة مركبة آلية)",
 "めんでん": "بُورْمَا",
 "めんとおし": "تَشْكِيلَة",
 "めんとむかって": "وَجْهًا لِوَجْه",
 "めんとり": "حافة مائلة, شطب (سطحان يلتقيان بزاوية تختلف عن 90 درجة)",
 "めんどい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "めんどう": "مُشْكِلَة, مَتاعِب / اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "めんどうがらず": "بِجِدّ",
 "めんどうくさい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "めんどうみがいい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "めんどうみがよい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "めんどうみのいい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "めんどうみのよい": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "めんどおし": "تَشْكِيلَة",
 "めんどくさい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "めんどっちぃ": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "めんどっちい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "めんどり": "دَجَاجَة, دُجَاجَة (طَيْر من الدواجن، لا يطير ويربيه البشر لبيضه ولحمه وريشه؛ أنثى بعض الطيور من الفصائل التي لا تطير كالقَبَج وغيره)\nمثال: وضعت الدجاجة بيضة.",
 "めんばち": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "めんばばとう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "めんぴ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "めんふくろう": "بومة الحظيرة, بومة المصابيح (بومة مرقطة باللونين الأصفر الشاحب والأبيض تسكن غالباً الحظائر والهياكل الأخرى؛ مهمة في مكافحة القوارض)",
 "めんぶ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "めんぷ": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "めんぼう": "مِرْقَاق, فَرَّادَة / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / عُود أُذُن (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "めんぼお": "شبكة الخوذة, واقي الوجه (قناع للوجه يتكون من شبكة سلكية قوية في مقدمة خوذات كرة القدم)",
 "めんぼく": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "めんぼくしだい": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "めんぼくない": "خَجْلَان, خَجُول",
 "めんぽう": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ. / بَثْرَة, بَثْر",
 "めんぽお": "شبكة الخوذة, واقي الوجه (قناع للوجه يتكون من شبكة سلكية قوية في مقدمة خوذات كرة القدم)",
 "めんみつ": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة.",
 "めんみつしゅうとう": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير) / دقيق, ضميري (لديه وازع؛ ينبع من الشعور بالصواب والخطأ؛ صاحب مبادئ)\nمثال: أرسل المنتجون الأقل نزاهة حزماً كانت مخادعة في مظهرها",
 "めんめ": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "めんめん": "اَلْجَمِيع, كُلّ شَخْص / سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "めんもう": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة.",
 "めんもく": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "めんもくがたつ": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "めんもくない": "خَجْلَان, خَجُول",
 "めんよう": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛ / عَجِيب, غَرِيب / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "めんるい": "نُودَلْز, شَعْرِيَّة",
 "めんわり": "بِطَاقَة هُوِيَّة",
 "めんネル": "فانيلا قطنية (قماش قطني متين ذو وبر على جانب واحد فقط)",
 "めんファスナー": "فِيلْكْرُو",
 "めんフランネル": "فانيلا قطنية (قماش قطني متين ذو وبر على جانب واحد فقط)",
 "めんモスリン": "مَوْصِلِيّ",
 "めん棒": "مِرْقَاق, فَرَّادَة / عُود أُذُن (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "めん羊": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛",
 "めん鉢": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "めキャベツ": "كُرُنْب بْرُوكْسِل",
 "め組": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "め組の頭": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "も": "حِدَاد / ثَوْبُ حِدَاد (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء)\nمثال: هو ذئب في ثوب حمل. / بَلَاء, بُؤْس / طحالب, طحلب (كائنات حقيقية النواة بدائية تحتوي على الكلوروفيل مائية بشكل أساسي تفتقر إلى السيقان والجذور والأوراق الحقيقية) / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / بِالرَغْم مِن / أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "もいか": "زَهْرَة بَرْقُوق",
 "もいちど": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もう": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / قَرِيبًا, سَرْعَانَ مَا / أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني. / غِي, جِي / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام. / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود / مُنْغُولِيَا / شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي) / شَبَكَة / عَمًى",
 "もうあく": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "もうい": "حَنَق, غَيْظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / حَنِق, مُغْتَاظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "もういちど": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もういっかい": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もういっちょ": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もういっちょう": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もういっぺん": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もういっぽう": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر.",
 "もういをふるう": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "もうかざめ": "لِيَّاءٌ",
 "もうかん": "شُعَيْرَة دَمَوِيَّة",
 "もうがくどうぶつ": "دودة سهمية, فكيات (أي دودة من الفكيات؛ دودة بحرية شفافة ذات زعانف جانبية وذيلية أفقية وصف من الأشواك المنحنية المتحركة على كل جانب من الفم)",
 "もうきん": "جارح, طائر جارح (أي من الطيور اللاحمة العديدة التي تصطاد وتقتل الحيوانات الأخرى)",
 "もうきんるい": "جارح, طائر جارح (أي من الطيور اللاحمة العديدة التي تصطاد وتقتل الحيوانات الأخرى)",
 "もうく": "مَسَمّ",
 "もうけ": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / تَحْضِير, إِعْدَاد",
 "もうけもの": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "もうける": "جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء. / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "もうげん": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "もうこ": "مُنْغُولِيَا / مغولي, منغولي (من أو متعلق بمنطقة منغوليا أو شعبها أو لغاتهم أو ثقافاتهم) / مغولي (عضو في الشعوب البدوية في منغوليا)\nمثال: الغزاة المغول",
 "もうこう": "مَسَمّ",
 "もうこうせいかくかしょう": "تقران شعري (تقران يتميز بارتفاعات مخروطية صلبة في فتحات الغدد الدهنية (خاصة في الذراعين والفخذين))",
 "もうこうせいたいせん": "تقران شعري (تقران يتميز بارتفاعات مخروطية صلبة في فتحات الغدد الدهنية (خاصة في الذراعين والفخذين))",
 "もうこご": "مُغُولِيّ",
 "もうこしょう": "المنغولية, متلازمة داون (اضطراب خلقي ناجم عن وجود كروموسوم 21 إضافي؛ يؤدي إلى وجه مسطح وقصر القامة وتخلف عقلي)",
 "もうこじん": "مغولي, منغولي (من أو متعلق بمنطقة منغوليا أو شعبها أو لغاتهم أو ثقافاتهم) / مغولي (عضو في الشعوب البدوية في منغوليا)\nمثال: الغزاة المغول",
 "もうこじんしゅ": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "もうこのうま": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "もうこひだ": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "もうこりた": "إِيثَار, غَيْرِيَّة",
 "もうご": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "もうさいかん": "أنبوب شعري, خاصية شعرية (أنبوب بقطر داخلي صغير؛ يحتفظ بالسائل عن طريق الخاصية الشعرية) / شُعَيْرَة دَمَوِيَّة",
 "もうさいけっかん": "شُعَيْرَة دَمَوِيَّة",
 "もうしあげる": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "もうしあわせ": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "もうしあわせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "もうしいで": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "もうしいれ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "もうしいれしょ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "もうしいれる": "اِقْتَرَحَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / خَطَبَ, طَلَبَ يَد (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد)\nمثال: اقترح سامي المساعدة.",
 "もうしうける": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "もうしおくり": "رِسَالَة, خَبَر / تسليم, تمرير (عملية تمرير شيء ما لشخص آخر)",
 "もうしおくる": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "もうしきかせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "もうしこし": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "もうしこす": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "もうしこみ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "もうしこみしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "もうしこみしょ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "もうしこみじゅん": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "もうしこみにん": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "もうしこみようし": "استمارة طلب, نموذج تقديم (نموذج يستخدم عند تقديم طلب)",
 "もうしこむ": "اِقْتَرَحَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / خَطَبَ, طَلَبَ يَد (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد)\nمثال: اقترح سامي المساعدة.",
 "もうしご": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ إِلَهِيٍّ) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "もうしじょう": "رثاء, عويل (صرخة حزن وأسى) / عريضة دعوى, لائحة شكوى ((المملكة المتحدة) بيان مكتوب بأسباب الشكوى يقدم إلى محكمة قانونية لطلب رفع الظلم)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "もうしそえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "もうしたて": "تَصْرِيح, بَيَان",
 "もうしたてにん": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / طالب الانتصاف, مقدم الالتماس (شخص يلتمس من المحكمة رفع مظلمة أو استرداد حق)\nمثال: مستعطف لرضاها",
 "もうしつかわす": "سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "もうしつける": "لقَّن",
 "もうしつたえる": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي.",
 "もうしで": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "もうしでしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "もうしでにん": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "もうしでる": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "もうしにくい": "أَنَا آسِف, أَنَا آسِفَة",
 "もうしのべる": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "もうしひらき": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "もうしひらく": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ) / فَسَّرَ / أَبَانَ\nمثال: شكرا على الشرح.",
 "もうしぶん": "شِكَايَة, شَكْوَى / دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "もうしぶんない": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "もうしぶんのない": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "もうしゃ": "مَكْفوف",
 "もうしゅう": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "もうしょ": "مَوْجَة اَلْحَرّ",
 "もうしよう": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "もうしわけ": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "もうしわけありません": "أَنَا آسِف, أَنَا آسِفَة / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "もうしわけがたたない": "أَنَا آسِف, أَنَا آسِفَة",
 "もうしわけございません": "أَنَا آسِف, أَنَا آسِفَة\nمثال: 大変ご不自由をおかけして申し訳ございません。 — أعتذر عن ما سببته لك من متاعب. / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "もうしわけていど": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "もうしわけない": "أَنَا آسِف, أَنَا آسِفَة\nمثال: 申し訳ないけど、できません。 — أنا آسف لكن ذلك مستحيل. / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "もうしわけなさそう": "اعتذاري, معتذر (يقدم أو يعبر عن اعتذار)\nمثال: مذكرة اعتذار",
 "もうしわたす": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "もうしん": "تطاول, وقاحة (نوع من الفظاظة في شكل فعل تطاول) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض قانوني, قرينة ((قانون) استدلال لحقيقة واقعة من حقائق أخرى تم إثباتها أو الاعتراف بها أو ملاحظتها قضائياً) / مُسلّمة, مُعطى (افتراض يؤخذ كأمر مسلم به)\nمثال: كان تطاوله لا يطاق / سذاجة, سرعة التصديق (الميل للتصديق بسهولة)",
 "もうじき": "قَرِيبًا, سَرْعَانَ مَا",
 "もうじゃ": "مَيِّت",
 "もうじゅう": "سَبْع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: عمره سبع سنوات.",
 "もうじょう": "شَبِيهٌ بِالشَّبَكَة, نَسِيجِيّ (ذو فراغات مفتوحة أو يشبه نسيج العنكبوت) / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "もうじょうそしき": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "もうじん": "مَكْفوف",
 "もうす": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "もうすぐ": "قَرِيبًا, سَرْعَانَ مَا",
 "もうすこし": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "もうすこしで": "تَقْرِيبًا, عَلَى وَشْك",
 "もうすこしのところで": "تَقْرِيبًا, عَلَى وَشْك",
 "もうすまでもない": "بَدِيهِيّ, بَدَهِيّ",
 "もうすまでもなく": "بُوضُوح",
 "もうせい": "تحليل ذاتي, محاسبة النفس (فحص دقيق لمعتقداتك ودوافعك)",
 "もうせっけっきゅう": "خلية شبكية (خلية دم حمراء غير ناضجة تحتوي على شبكة من الخيوط أو الحبيبات)",
 "もうせつ": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "もうせん": "سَجَّادَة, بِسَاط / قَدِيماً",
 "もうせんをかぶる": "خطأ فادح, زلة (خطأ محرج)",
 "もうぜん": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة) / بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً) / بِحِدَّة, بِعُنْف (بطريقة عنيفة عاطفياً)\nمثال: صمت كسره نباح الكلاب بشراسة",
 "もうそう": "خِدَاع, ضَلَالَة / غَرُور / جريب الشعرة (تجويف أنبوبي صغير يحتوي على جذر الشعرة؛ وترتبط به عضلات صغيرة وغدد دهنية)",
 "もうそうきょう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "もうそうしょう": "بَارَانُويَا, جُنُون اِضْطِهَاد",
 "もうそうせいしょうがい": "اضطراب وهامي (أي اضطراب عقلي تلعب فيه الأوهام دوراً مهماً)",
 "もうそうてき": "تَوَهُّمِيّ, ضَلَالِيّ (يعاني من الأوهام أو يتسم بها)",
 "もうそうびょう": "اضطراب وهامي (أي اضطراب عقلي تلعب فيه الأوهام دوراً مهماً)",
 "もうたい": "فتيل (حزمة من الألياف العصبية الحسية تتجه إلى المهاد)",
 "もうたくさん": "بَلَغَ السَّيْلُ الزُّبَى, طَفَحَ الْكَيْلُ",
 "もうたくとうしそう": "مَاوِيَّة (نظرية شيوعية سميت نسبة إلى ماو تسي تونغ؛ مُسْتَوْطَنَة في اليمنية)",
 "もうたくとうしゅぎ": "مَاوِيَّة (نظرية شيوعية سميت نسبة إلى ماو تسي تونغ؛ مُسْتَوْطَنَة في اليمنية)",
 "もうだしゃ": "ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب) / ملاكم قوي اللكمات (ملاكم مشهور بقدرته على توجيه لكمات قوية)",
 "もうちょい": "قَلِيلًا",
 "もうちょう": "طَيْر جَارِح / أعور (التجويف الذي تبدأ فيه الأمعاء الغليظة والذي يفتح فيه اللفائفي)\nمثال: الزائدة الدودية هي فرع من الأعور / مُلْحَق / الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "もうちょうえん": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "もうちょうえんしゅじゅつ": "اِسْتِئْصَال الزَائِدَة الدُودِيَّة",
 "もうちょっと": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "もうてん": "نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "もうで": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "もうと": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "もうとう": "أبداً, بتاتاً (بأدنى درجة أو بأي حال من الأحوال) / على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم على الإطلاق؟ لا، على الإطلاق",
 "もうどう": "سَفِينَة حَرْبِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "もうどうけん": "كلب مرشد (كلب مدرب لإرشاد المكفوفين)",
 "もうのう": "جريب الشعرة (تجويف أنبوبي صغير يحتوي على جذر الشعرة؛ وترتبط به عضلات صغيرة وغدد دهنية)",
 "もうのうえん": "التهاب الجريبات (التهاب بصيلة الشعر)",
 "もうはつ": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "もうはん": "نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "もうひ": "فَرْو / مِعْطَف, ثَوْبٌ مُفَرًّى / فَرَّى",
 "もうひつ": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "もうひつが": "رسم بالغسل, غسل (لوحة مائية مصنوعة من خلال تطبيق سلسلة من الغسلات أحادية اللون واحدة فوق الأخرى)",
 "もうひとこえ": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "もうひとつ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "もうひとり": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "もうひょうひ": "بُشَيْرَة",
 "もうふ": "لِحَاف, بَطَّانِيَّة",
 "もうふぶき": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "もうほう": "جريب الشعرة (تجويف أنبوبي صغير يحتوي على جذر الشعرة؛ وترتبط به عضلات صغيرة وغدد دهنية)",
 "もうまい": "جَاهِل",
 "もうまいしゅぎ": "إبهام, تعتيم (عمل متعمد يهدف إلى جعل الشيء غامضاً) / ظلامية (سياسة معارضة التنوير أو نشر المعرفة)",
 "もうまく": "شَبَكِيَّة عَيْن, شَبَكِيَّة",
 "もうまくえん": "التهاب الشبكية (التهاب الشبكية)",
 "もうまくがさいぼうしゅ": "ورم أرومي شبكي (ورم عيني خبيث في خلايا الشبكية؛ يحدث عادة قبل السنة الثالثة من العمر؛ يتكون من خلايا شبكية مستديرة صغيرة بدائية)",
 "もうまくしょう": "اعتلال الشبكية (مرض في الشبكية يمكن أن يؤدي إلى فقدان الرؤية)",
 "もうまくはくり": "انفصال الشبكية (ضعف بصري ناتج عن انفصال الشبكية عن المشيمية في الجزء الخلفي من العين)",
 "もうもう": "كَثِيف, غَلِيظ / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / مُسَطَّح / خُوَار / خَارَ (صوت حيوان البقر خاصة؛ في : نطقٌ يحدث من الحلق، أي الصوت الذي يصدر من الحلق بشكل مستمر) / مُو\nمثال: السحابة هي كتلة بخار في السماء. / بقرة (أنثى الماشية المستأنسة)",
 "もうもく": "عَمًى / أَعْمَى, عَمْيَاء\nمثال: 愛は盲目。 — الحب أعمى.",
 "もうもくてき": "أَعْمَى, عَمْيَاء",
 "もうもくてきに": "بشكل أعمى, دون تفكير (بدون تحضير أو تفكير؛ بدون أساس عقلاني) / بشكل أعمى, دون تبصر (دون رؤية أو نظر)\nمثال: اشتروا السيارة بشكل أعمى",
 "もうもくひこう": "طيران آلي (الملاحة بالطائرة اعتمادًا كليًا على الأجهزة)",
 "もうようたい": "جسم هدبي (جزء من غلالة العين يقع بين المشيمية والقزحية)\nمثال: ينتج الجسم الهدبي الخلط المائي / التَكْوِين الشَبَكِيّ",
 "もうようたいふかつけい": "نظام التنشيط الشبكي (الشبكة الموجودة في التكوين الشبكي التي تخدم وظيفة التنبيه أو الاستثارة)",
 "もうら": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "もうらてき": "شَامِل, شَامِلَة",
 "もうらりつ": "تَغْطِيَة (وضع شيء فوق آخر لإخفائه أو حمايته؛ معالجة ونقل أخبار حدث أو موضوع معين ونشره لجمهور أو ما يصطلح عليه بالتغطية الإعلامية)\nمثال: تمت تغطية زيري.",
 "もうる": "دَانْتِيل / شَدَّ, دَمَجَ / لَوَّثَ / بهرج, خيط زينة لامع (خيط ملحق به رقائق معدنية لامعة) / بهرج, زينة لامعة (زينة مبهرجة لا قيمة لها أساساً)\nمثال: كل بهرج الترويج الذاتي / منظف الغليون (أداة تنظيف تتكون من سلك مرن مُشعَّر يستخدم لتنظيف ساق الغليون)",
 "もうれつ": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "もうれつしゃいん": "طَمُوح, مُثَابِر (شخص يتقدم مساره المهني بسرعة؛ شخص ذو همة عالية)",
 "もうろう": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "もうろく": "خرف, هرم (حالة الخرف) / خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "もう一つ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "もう一丁": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もう一人": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "もう一回": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もう一声": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "もう一度": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もう一方": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر.",
 "もう一遍": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もう先": "قَدِيماً",
 "もう少し": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "もう少しで": "تَقْرِيبًا, عَلَى وَشْك",
 "もう少しのところで": "تَقْرِيبًا, عَلَى وَشْك",
 "もう少しの所で": "تَقْرِيبًا, عَلَى وَشْك",
 "もう１つ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "もう１人": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "もう１度": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もえ": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو) / انْبِهَار, سِحْر (القدرة على جذب اهتمام شديد) / افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / افتتان, انبهار (حالة الاهتمام الشديد بشيء ما (كما في الرهبة أو الإعجاب أو الرعب))\nمثال: سحر الأطفال بحيل سحرية وفتن أخرى",
 "もえあがる": "اِنْدَلَعَ",
 "もえうつる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "もえかす": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "もえがら": "جَمْرَة",
 "もえぎ": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ؛ حَطَبُوه: قَطَعُوه)\nمثال: بحث زيري عن الحطب.",
 "もえくさ": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "もえさかる": "سَعِيرَا",
 "もえさし": "جَمْرَة",
 "もえたつ": "نَبْتَة",
 "もえだす": "اِشْتَعَلَ / بُرْعُم",
 "もえつく": "اِشْتَعَلَ",
 "もえでる": "نَبْتَة",
 "もえないごみ": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "もえないゴミ": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "もえのこり": "جَمْرَة",
 "もえひろがる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "もえる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / نَبْتَة",
 "もぉ": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / قَرِيبًا, سَرْعَانَ مَا / أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني. / غِي, جِي",
 "もおすぐ": "قَرِيبًا, سَرْعَانَ مَا",
 "もが": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "もがき": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "もがく": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "もぎ": "تَقْلِيد",
 "もぎさいばん": "محكمة افتراضية, محكمة تدريبية (محكمة صورية حيث يترافع طلاب القانون في قضايا افتراضية)",
 "もぎじっけん": "مُحَاكَاة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "もぎせん": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "もぎてん": "مَطْعَم التَّصَابِير, كُشْك التَّصَابِير",
 "もぎとる": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة) / اِنْتَزَعَ (الشيء من مكانه: بمعنى نَزَعَ وغالبا ما يقصد به الشدة والاجبار)",
 "もぎどう": "وحشية",
 "もぎり": "جامِع التَّذاكِر, قاطِع التَّذاكِر (شخص يتقاضى أجراً للسماح بدخول من اشتروا التذاكر فقط)",
 "もぎる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "もぎ取る": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة) / اِنْتَزَعَ (الشيء من مكانه: بمعنى نَزَعَ وغالبا ما يقصد به الشدة والاجبار)",
 "もく": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / بَنْد / الْخَمِيس, يَوْم الْخَمِيس / خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة. / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "もくきりん": "عنب الثعلب البربادوسي (فاكهة صغيرة صفراء إلى برتقالية لصبار عنب الثعلب البربادوسي) / بيرسكية شائكة, عنب الثعلب البربادوسي (متسلق خشبي من جزر الهند الغربية ذو سيقان شائكة والعديد من الزهور البيضاء العطرة في نورات عنقودية تليها ثمار صفراء إلى برتقالية صغيرة)",
 "もくげ": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "もくげき": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات) / شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "もくげきしゃ": "شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "もくさく": "حمض الخليك الخشبي, خل الخشب (سائل بني محمر يتكون عند تقطير الخشب ويحتوي على حمض الخليك والميثانول والأسيتون وزيوت الخشب والقطران)",
 "もくさつ": "تَجَاهَلَ, طَنَّش",
 "もくさん": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "もくざい": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "もくざいガス": "غاز المولدات, غاز هوائي (غاز يتكون من أول أكسيد الكربون والهيدروجين والنيتروجين؛ يُصنع بمرور الهواء فوق فحم الكوك الساخن)",
 "もくざいパルプ": "لب الخشب (خشب تم طحنه إلى لب؛ يُستخدم في صنع منتجات السليلوز (مثل الرايون أو الورق))",
 "もくし": "اِنْطَوَى / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟ / بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة",
 "もくしつ": "خَشَبِيّ (شَبيه بالخَشَب في الصَّلابَة أو القِوام) / حَرَجِيّ, كَثِير الأَشْجَار (غنيّ بالأشجار ووافرها) / خشبي, ليفي (مصنوع من أو يحتوي على أو يشبه الخشب)\nمثال: نباتات خشبية",
 "もくしつぶ": "نسيج الخشب",
 "もくしてき": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ) / ضمني, مفهوم ضمناً (مفهوم ضمناً وإن لم يتم التعبير عنه مباشرة؛ متأصل في طبيعة الشيء)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "もくしゅく": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "もくしょう": "نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها)",
 "もくしろく": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "もくじ": "فِهْرِس, مُحْتَوَيَات (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "もくじゅう": "إذعان, قبول (الموافقة على بيان أو اقتراح للقيام بشيء ما) / إذعان, رضوخ (القبول دون احتجاج)\nمثال: أبدى موافقته بحماس",
 "もくす": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة. / حمض الخليك الخشبي, خل الخشب (سائل بني محمر يتكون عند تقطير الخشب ويحتوي على حمض الخليك والميثانول والأسيتون وزيوت الخشب والقطران)",
 "もくする": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة. / صَمَتَ, سَكَتَ / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "もくずい": "نُخَاع",
 "もくせい": "اَلْمُشْتَرِي (أحد كَوَاكِب المجموعة الشمسية السَّيَّارَة، وهو أكبرها) / يُوبِيتَر\nمثال: كوكب المشتري متكون من الغاز. / خَشَبِيّ / كحول الخشب, كحول ميثيلي (كحول سائل خفيف متطاير قابل للاشتعال وسام؛ يستخدم كمضاد للتجمد ومذيب ووقود)",
 "もくせいがたわくせい": "عِمْلَاق غَازِيّ, كَوْكَب غَازِيّ (أي من الكواكب الأربعة الخارجية في النظام الشمسي؛ أكبر بكثير من الأرض وغازي الطبيعة (مثل المشتري))",
 "もくせいしだ": "سرخس شجري",
 "もくせいそう": "خزامى, ريزيدا عطرة (نبات حولي خشبي متوسطي يزرع على نطاق واسع لعناقيده الطرفية الكثيفة التي تشبه السنابل من الزهور البيضاء المخضرة أو الصفراء ذات الرائحة الحارة القوية)",
 "もくせいシダ": "سرخس شجري",
 "もくせん": "فِلِّينَة, فَدَام",
 "もくぜん": "دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً) / بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "もくそう": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "もくぞう": "خَشَبِيّ",
 "もくたん": "فَحْم الْخَشَب",
 "もくだく": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "もくちょう": "نحت الخشب (شكل من أشكال العمل على الخشب باستخدام أداة قطع)\nمثال: بعض من أرقى الأمثلة الموجودة لنحت الخشب الأوروبي المبكر تعود إلى العصور الوسطى / مُبَرْقَع, مُرَقَّش (ذو بقع أو رقع من الألوان المتباينة)",
 "もくてき": "هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف.",
 "もくてきいしき": "ذات هدف, هادفة (صفة امتلاك غرض محدد)",
 "もくてきいん": "علة غائية ((في الفلسفة) الغاية أو الغرض من شيء أو عملية)",
 "もくてきかく": "حالة النصب (حالة الأسماء التي تعمل كمفعول به مباشر للفعل)",
 "もくてきげんご": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "もくてきご": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "もくてきせい": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع)\nمثال: نهائية الموت",
 "もくてきせつ": "جملة الغاية, عبارة غائية (جملة تعبر عن غرض أو نية (مثل تلك التي تبدأ بـ 'من أجل' أو 'كي'))",
 "もくてきち": "وِجْهَة, وُجْهَة",
 "もくてきてき": "هَادِف (ذو معنى من خلال وجود غاية) / ذو غرض, هادف (يخدم كـ أو يشير إلى وجود غرض أو هدف)",
 "もくてきぶつ": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "もくてきろん": "غائية",
 "もくてきプログラム": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "もくてんりょう": "أكتينيديا مضلعة, كرمة فضية (كرمة زينة من شرق آسيا لها ثمار صفراء صالحة للأكل وأوراق ذات علامات بيضاء فضية)",
 "もくと": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "もくとう": "زايلوز, سكر الخشب (سكر مستخرج من الخشب أو القش؛ يُستخدم في أطعمة مرضى السكري)",
 "もくとうじゅん": "زايلوز, سكر الخشب (سكر مستخرج من الخشب أو القش؛ يُستخدم في أطعمة مرضى السكري)",
 "もくどう": "ممشى خشبي (ممشى مصنوع من ألواح خشبية؛ عادة على شاطئ البحر)",
 "もくにん": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما) / تآمر, تواطؤ (الاتفاق على مؤامرة سرية)",
 "もくねん": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "もくはんが": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "もくば": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب) / حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز) / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "もくひょう": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَرْمًى / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَجَّلَ هَدَفًا (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: لقد أخطأ الهدف. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "もくひょうげんご": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "もくひょうぶつ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "もくひょうプログラム": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "もくぶ": "نسيج الخشب",
 "もくへん": "طَابُوقَة",
 "もくほん": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "もくほんしょくぶつ": "نبات خشبي (نبات له أنسجة خشبية صلبة، خاصة السيقان)",
 "もくまおう": "خشب اللحم (شجرة تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر المقشر (شجرة أو شجيرة طويلة ذات أوراق لامعة وخيمات من الزهور البيضاء الكريمية العطرة؛ تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر (أي من عدة أشجار أسترالية من جنس كزوارينا تنتج خشباً أحمر صلباً ثقيلاً يستخدم في النجارة) / خشب اللحم (أي من العديد من الأخشاب المحمرة الصلبة الثقيلة الاستوائية بشكل رئيسي؛ يستخدم بعضها للخزائن)",
 "もくめ": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "もくめぬり": "تجزيع, تخشب (ملمس يشبه ملمس الخشب)",
 "もくもう": "قش خشب, نشارة خشب (نشارة خشب مجعد رقيقة تستخدم للتعبئة أو الحشو)",
 "もくもく": "صَامِت, سَاكِت / اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "もくやく": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "もくよう": "الْخَمِيس, يَوْم الْخَمِيس / وَرَقَة, وَرَقة / صَحِيفَة",
 "もくようび": "الْخَمِيس, يَوْم الْخَمِيس",
 "もくよく": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام) / وُضُوء, غُسْل / وَضُوء",
 "もくり": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "もくる": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "もくれい": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل)",
 "もくろう": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "もくろく": "كَتَالُوج, فِهْرِس / مُحْتَوَى, مَضْمُون",
 "もくろみ": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "もくろみしょ": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "もくろむ": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "もぐ": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "もぐさ": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "もぐもぐ": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام) / مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / تلوّي, تململ (عملية التلوّي أو التململ)",
 "もぐら": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "もぐらづか": "تلة الخلد (كومة من التراب يصنعها الخلد أثناء الحفر)",
 "もぐら塚": "تلة الخلد (كومة من التراب يصنعها الخلد أثناء الحفر)",
 "もぐり": "غَطس / غَيْر مُرَخَّص, غَيْر مُعْتَمَد (يفتقر إلى الموافقة الرسمية) / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "もぐりうみつばめ": "نوء غواص (أي من عدة طيور غوص صغيرة في بحار نصف الكرة الجنوبي؛ تشبه طيور الأوك إلى حد ما)",
 "もぐる": "غَاصَ / غَطْسَ, يقفز الى الماء",
 "もけ": "سفرجل ياباني (شجيرة شائكة متساقطة الأوراق موطنها الصين لها أزهار حمراء أو بيضاء) / مُفَاجِئ",
 "もけい": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "もけいか": "عمل نماذج, نمذجة (فعل تمثيل شيء ما (عادة على نطاق أصغر)) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة)",
 "もけいちず": "خريطة تضاريس, خريطة كنتورية (خريطة تحتوي على خطوط كنتور تمر عبر نقاط متساوية الارتفاع)",
 "もけもけ": "حَبَّة دَوَاء (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / قُرْص / حَبّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / حَبَّة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "もこ": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "もこく": "نُشْخَة",
 "もこもこ": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب) / مُتَكَتِّل",
 "もごもご": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام) / مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / تلوّي, تململ (عملية التلوّي أو التململ)",
 "もさ": "بلطجي, رجل قوي (رجل يتنمر على الأشخاص الأضعف) / مُحَارِب قَدِيم / نَشَّال",
 "もさい": "غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)\nمثال: ملابس غير عصرية",
 "もさく": "مُتَخَبِّط, مُتَلَمِّس (يتصرّف بتردّد وعدم ثقة أو يقين) / تَقْلِيد",
 "もさっと": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "もし": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "もしおぐさ": "تَجْمِيعَة, دِيوَان",
 "もしか": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "もしかし": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "もしかしたら": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "もしかして": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة! / إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "もしかしなくても": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "もしかすると": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "もしき": "مَكِيدَة / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "もしきひょうほん": "عينة نمطية, عينة نموذجية (العينة الأصلية التي يتم بناءً عليها وصف نوع جديد (في البيولوجيا))",
 "もしくは": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "もしそうなら": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "もしも": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛ / الأسوأ (لأقصى درجة من الرداءة أو السوء) / أسوأ جهد (أضعف جهد أو أفقر إنجاز يمكن للمرء القيام به) / أَسْوَأ ((صيغة التفضيل من 'سيء') الأكثر نقصاً في الجودة أو القيمة أو الحالة) / أسوأ ما يمكن (أقصى درجات الضرر أو الشر التي يقدر عليها المرء)\nمثال: عانت الأسوأ من بينهم جميعاً",
 "もしもし": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "もしものこと": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "もしものとき": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "もしもの事": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "もしもの時": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "もしゃ": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "もしゃもしゃ": "أَشْعَث, مُنَكَّش (فِي حَالَةِ فَوْضَى شَدِيدَة)",
 "もしや": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "もしょう": "شريط الحداد (شريط أسود يرتديه الرجل (على الذراع أو القبعة) كعلامة على الحداد)",
 "もじ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "もじあわせじょう": "قفل أرقام, قفل مركب (قفل لا يمكن فتحه إلا عن طريق تدوير الأقراص بتسلسل خاص)",
 "もじおこし": "كَرْشَنَة, نَقْصَوَة",
 "もじかん": "تتبع الأثر, ملاحقة (ملاحقة (شخص أو حيوان) باتباع الآثار أو العلامات التي تركوها وراءهم)",
 "もじくみ": "تَنْضِيد",
 "もじげんご": "تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "もじさんしょう": "خطاب مرجعي, شهادة حسن سيرة وسلوك (توصية رسمية من صاحب عمل سابق إلى صاحب عمل مستقبلي محتمل تصف مؤهلات الشخص وموثوقيته)\nمثال: غالباً ما يتم الرد على طلبات خطابات المراجع بشكل مراوغ",
 "もじしき": "متعدد الحدود (لديه طابع متعدد الحدود) / كَثِيرَة الحُدُود, مُتَعَدِّدَة الحُدُود (دالة رياضية هي مجموع عدد من الحدود)\nمثال: تعبير متعدد الحدود",
 "もじしゅうごう": "مجموعة المحارف (قائمة مرتبة من الأحرف التي تستخدم معاً في الكتابة أو الطباعة)",
 "もじすうインチ": "استبيان كاليفورنيا للشخصية / مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "もじつく": "تَمَلْمَلَ",
 "もじどおり": "حَرْفِيًّا / بِٱلْحَرْف / لَفْظِيّ, حَرْفِيّ",
 "もじばけ": "فَسَاد",
 "もじばん": "مُؤَشِّر / مِزْوَل, مُدَرَّجَة / لَوْحَةُ مَفَاتِيح",
 "もじもじ": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "もじゃもじゃ": "أَشْعَث, مُنَكَّش (فِي حَالَةِ فَوْضَى شَدِيدَة)",
 "もじゅせき": "تغصن, زائدة شجرية (ليف قصير ينقل الإشارات نحو جسم الخلية العصبية)",
 "もじり": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة. / لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "もじる": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة. / لَوَى, بَرَمَ",
 "もじセット": "مجموعة المحارف (قائمة مرتبة من الأحرف التي تستخدم معاً في الكتابة أو الطباعة)",
 "もじ付く": "تَمَلْمَلَ",
 "もす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / قَلَّدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "もすそ": "ثنية الكم, كُفّة (طية تتكون من حاشية مقلوبة للخلف تطوق نهاية الكم أو الساق) / أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "もする": "قَلَّدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "もず": "صرد (أي من الطيور العديدة في العالم القديم ذات منقار قوي معقوف تتغذى على الحيوانات الأصغر)",
 "もせい": "نسخ (فعل النسخ)",
 "もそっと": "قَلِيلًا",
 "もそもそ": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / بتردد (مع تردد؛ بطريقة مترددة)\nمثال: قبل أخيراً بتردد",
 "もそり": "بِبُطْء",
 "もぞう": "تَقْلِيد",
 "もぞうがわ": "جلد صناعي (قماش مصنوع ليبدو مثل الجلد)",
 "もぞうしゃ": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر) / منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر)",
 "もぞうひん": "تَقْلِيد",
 "もぞもぞ": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / بتردد (مع تردد؛ بطريقة مترددة)\nمثال: قبل أخيراً بتردد",
 "もたげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もたざる": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "もたざるもの": "فَقِير, مُعْدَم (شخص لديه القليل من الممتلكات أو لا يملك شيئاً)",
 "もたせる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِحْتَفَظَ, أَبْقَى",
 "もたもた": "بِبُطْء",
 "もたらす": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "もたれいす": "كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه)",
 "もたれかかる": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "もたれ椅子": "كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه)",
 "もだえ": "أَلَم (الوَجَع) / اِحْتِضَار\nمثال: ألم أقل لك ذلك؟",
 "もだす": "صَمَتَ, سَكَتَ / إِهْمال",
 "もち": "موتْشِي / دبق (مادة لاصقة لزجة تدهن على الأغصان الصغيرة لاصطياد الطيور الصغيرة) / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / كَتِف, كِتْف / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ) / طَبْعًا",
 "もちあい": "وَحْدَة, اِتِّحَاد / انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "もちあう": "رَصِيد / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "もちあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "もちあげる": "رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تَمَلَّقَ, تَبَصْبَصَ",
 "もちあつかう": "مِقْبَض",
 "もちあわす": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "もちあわせる": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "もちいる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "もちうる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "もちかえり": "سَفَريّ",
 "もちかえる": "أَخْرَجَ / تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "もちかける": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "もちかた": "حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "もちかぶがいしゃ": "شَرِكَة قَابِضَة",
 "もちがいい": "دَائِم طَوِيْلًا",
 "もちがよい": "دَائِم طَوِيْلًا",
 "もちきり": "حديث, حديث المدينة (ثرثرة فارغة أو شائعة)\nمثال: كان هناك حديث عنك مؤخراً",
 "もちこし": "خُمَار (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / خُمَار اَلسُّكْر (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / صُدَاع الخَمْر\nمثال: اعتنقت ليلى الإسلام و بدأت ترتدي الخمار.",
 "もちこす": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "もちこたえる": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "もちこみ": "حقيبة محمولة باليد (في الطائرة) (الأمتعة أو الحقائب التي تؤخذ إلى داخل الطائرة مع الراكب، بدلاً من شحنها)",
 "もちこむ": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "もちじかん": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "もちだか": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "もちだし": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / طنف, كابول ((في العمارة) دعامة مثلثة من الطوب أو الحجر (عادة ما تكون ذات امتداد بسيط))",
 "もちだす": "أَخْرَجَ / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もちっ": "خَفِيف, مَرِن ((عن الحركات) خفيف ونشط بثقة) / مَرِنٌ مُرْتَدّ, نَابِض (مرن ويرتدّ بسهولة)",
 "もちっと": "قَلِيلًا",
 "もちつけ": "أَهْدَأَ, هَدَّأَ",
 "もちつづける": "حَافَظَ",
 "もちづき": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "もちて": "مِقْبَض / حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "もちなおす": "شُفِيَ, بَرِئَ",
 "もちにげ": "مَسْرُوق",
 "もちぬし": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "もちのいい": "دَائِم طَوِيْلًا",
 "もちのつき": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "もちのよい": "دَائِم طَوِيْلًا",
 "もちのろん": "طَبْعًا",
 "もちはこび": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "もちはこぶ": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "もちばな": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "もちびょう": "لفحة الشاي التبثرية (مرض يصيب نباتات الشاي، يتميز بآفات تشبه البثور على الأوراق) / لفحة الصنوبر التبثرية (مرض يصيب الصنوبر الاسكتلندي)",
 "もちびょうきん": "لفحة الشاي التبثرية (مرض يصيب نباتات الشاي، يتميز بآفات تشبه البثور على الأوراق) / لفحة الصنوبر التبثرية (مرض يصيب الصنوبر الاسكتلندي)",
 "もちぶん": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "もちまえ": "طَبِيعِيّ",
 "もちまして": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / بِسَبَب, بِحُكْم / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "もちまわり": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "もちもち": "خَفِيف, مَرِن ((عن الحركات) خفيف ونشط بثقة) / مَرِنٌ مُرْتَدّ, نَابِض (مرن ويرتدّ بسهولة)",
 "もちもの": "أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي / سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "もちょぐったい": "حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة)",
 "もちより": "عشاء مشترك, وليمة مساهمة (ما يتوفر من طعام خاصة عند تقديمه لضيف غير متوقع أو عندما يحضره الضيوف ويتشاركون فيه جميعاً)\nمثال: عشاء مساهمة (كل ضيف يحضر طبقاً)",
 "もちよる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "もちろん": "طَبْعًا",
 "もちろんのこと": "طَبْعًا",
 "もちろんの事": "طَبْعًا",
 "もっか": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "もっかい": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もっかん": "آلَة نَفْخ خَشَبِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "もっかんがっき": "آلَة نَفْخ خَشَبِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "もっきょ": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "もっきりん": "عنب الثعلب البربادوسي (فاكهة صغيرة صفراء إلى برتقالية لصبار عنب الثعلب البربادوسي) / بيرسكية شائكة, عنب الثعلب البربادوسي (متسلق خشبي من جزر الهند الغربية ذو سيقان شائكة والعديد من الزهور البيضاء العطرة في نورات عنقودية تليها ثمار صفراء إلى برتقالية صغيرة)",
 "もっきん": "سِيلُوفُون",
 "もっけ": "مُفَاجِئ",
 "もっけのさいわい": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / ثمرة ساقطة, سقط الشجر (الفاكهة التي سقطت من الشجرة)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "もっけの幸い": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / ثمرة ساقطة, سقط الشجر (الفاكهة التي سقطت من الشجرة)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "もっこう": "تَفَكُّر / أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب) / نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها) / سَعْدَان, قِرْد",
 "もっこうげい": "أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب)",
 "もっこうざいく": "أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب) / مشغولات خشبية, نجارة (عمل مصنوع من الخشب؛ خاصة القوالب أو السلالم أو الأثاث)",
 "もっこうし": "عامل خشب, نجار (شخص يصنع أشياء من الخشب)",
 "もっこうしょ": "مَنْشَرَة",
 "もっこうじょ": "مَنْشَرَة",
 "もっこうじょう": "مَنْشَرَة",
 "もっこうばら": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "もっこうひん": "أعمال خشبية, نجارة (حرفة النجار: صنع الأشياء من الخشب) / مشغولات خشبية, نجارة (عمل مصنوع من الخشب؛ خاصة القوالب أو السلالم أو الأثاث)",
 "もっこうバラ": "ورد بانكسيا (ورد متسلق دائم الخضرة صيني ذو زهور مفردة صفراء أو بيضاء)",
 "もっこく": "قالب خشبي (نقش يتكون من كتلة من الخشب تم قطع تصميم فيها؛ تستخدم لعمل المطبوعات) / كليشيه خشبي, نقش خشبي (مطبوعة مصنوعة من نقش على الخشب)",
 "もっこり": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "もっこん": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "もっさい": "غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)\nمثال: ملابس غير عصرية",
 "もっさり": "بَطِيء / أَبْطَأَ, بَطَّأَ / شُجَيْرِيّ, كَثِيف (يُشْبِهُ الشُّجَيْرَةَ فِي كَثَافَةِ تَفَرُّعِهِ وَانْتِشَارِه) / أَشْعَث, كَثِيفُ الشَّعْر ((لِلشَّعْرِ) كَثِيفٌ وَسَيِّئُ التَّصْفِيف) / غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)\nمثال: ملابس غير عصرية",
 "もっしょくしさん": "حمض العفص, حمض الغاليك (حمض بلوري عديم اللون يتم الحصول عليه من العفص)",
 "もっす": "غَطَسَ / مَجْلَى, مَغْسَلَة / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / صَادَرَ",
 "もっそり": "بِبُطْء / خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "もったい": "مبالغة في التأكيد (تأكيد زائد عن الحد)",
 "もったいない": "مُبَدِّد, مُخَرِّب (يُحْدِثُ الخَرَابَ وَالدَّمَارَ) / مُبَذِّر, مُسْرِف (غير كفء في استخدام الوقت والجهد والموارد) / مبذر, مسرف (يميل إلى التبذير والإهدار) / أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض / آثم, غير تقي (يفتقر للتقوى أو تبجيل الإله) / عَاقّ, غَيْرُ بَارّ (يفتقر إلى الاحترام أو الطاعة الواجبة)",
 "もったり": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى / ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء",
 "もっちり": "خَفِيف, مَرِن ((عن الحركات) خفيف ونشط بثقة) / مَرِنٌ مُرْتَدّ, نَابِض (مرن ويرتدّ بسهولة)",
 "もって": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / بِسَبَب, بِحُكْم / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / إِضَافَةً عَلى ذٰلِكَ",
 "もっていく": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "もってうまれた": "طَبِيعِيّ",
 "もってくる": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "もってこい": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "もってのほか": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "もってゆく": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "もっと": "أَكْثَر",
 "もっとたくさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "もっとも": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "もっともらしい": "قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه / جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك)",
 "もっと沢山": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "もっぱら": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / أساساً, بشكل رئيسي (في الغالب)\nمثال: هو مهتم بشكل رئيسي بالفراشات",
 "もっぺん": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "もつ": "مَسَكَ, مسك / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / حَافَظَ / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / اِحْتَفَظَ, أَبْقَى / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / فَرَث",
 "もつなべ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "もつやく": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "もつれ": "تشابك, متاهة (شيء مختلط أو مشوش) / كُتْلَة مُتَشَابِكَة (كتلة ملتوية ومتشابكة ومتداخلة للغاية)\nمثال: تشابك من اللوائح الحكومية / تَعْقِيد / مُضَاعَفَة",
 "もつれる": "تشابك, متاهة (شيء مختلط أو مشوش) / كُتْلَة مُتَشَابِكَة (كتلة ملتوية ومتشابكة ومتداخلة للغاية)\nمثال: تشابك من اللوائح الحكومية",
 "もつ鍋": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "もて": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "もてあそびもの": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "もてあそび物": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "もてあそぶ": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "もてない": "غَيْرُ مُرَحَّب بِه (غير مرحَّب به ولا مُتمنَّى) / غير مرحب به, غير مرغوب فيه (غير مرحب به؛ لا يعطي متعة أو لا يتم استقباله بمتعة)\nمثال: دعاية غير مرحب بها",
 "もてなし": "كَرَم, إِكْرَام / ضِيَافَة / استجمام, ترويح عن النفس (نشاط يجدد النشاط ويرفه؛ نشاط يجدد صحتك وروحك بالمتعة والاسترخاء) / ضيافة, مرطبات (وجبات خفيفة ومشروبات تقدم كوجبة خفيفة)\nمثال: وقت للراحة والاستجمام بجانب المسبح",
 "もてなす": "عَالَجَ",
 "もてもて": "جَذَّاب, جِنْسِيّ",
 "もてもてメルビン": "إثارة, مداعبة (الملاطفة الجنسية المتبادلة قبل الجماع)",
 "もてる": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ / مجنون, مَلْبُوس / غَنِيّ",
 "もてるもの": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "もと": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / جَانِب / صَفْحَة / سَابِق / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "もとい": "قَاعِدَة, أَسَاس",
 "もといれきん": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "もとうし": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "もとおっと": "زوج سابق, طليق (رجل كان زوجاً لامرأة معينة سابقاً)",
 "もとかた": "تَاجِر جُمْلَة / رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "もとから": "أَصْلًا",
 "もとかれ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "もときん": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير. / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "もとごめ": "خلفي التلقيم ((للبنادق) مصممة لتلقم من المؤخرة)",
 "もとごめじゅう": "بندقية تلقيم خلفي (بندقية يتم تلقيمها من المؤخرة)",
 "もとじめ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / رَئِيس, رَئِيسَة",
 "もとせん": "مِحْبَس",
 "もとだか": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "もとだち": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "もとだんな": "زوج سابق, طليق (رجل كان زوجاً لامرأة معينة سابقاً)",
 "もとちょう": "دفتر أستاذ, دفتر يومية (دفتر يومية محاسبي كشيء مادي) / دفتر الأستاذ, دفتر الحسابات (سجل تُدون فيه الحسابات التجارية)\nمثال: اشترى دفتر يومية جديداً",
 "もとつま": "زوجة سابقة, طليقة (امرأة كانت زوجة لرجل معين سابقاً)\nمثال: كل طليقاته يعشن في تكساس",
 "もとづく": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "もとで": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود / رَصِيد, مَكْسَب (صفة مفيدة أو ذات قيمة)",
 "もとにもどす": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "もとに戻す": "جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "もとね": "سَاوَى, كَلَّفَ / تَكْلِفَة, كُلْفَة",
 "もとねた": "أَصْلِيّ",
 "もとのさやにおさまる": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "もとは": "أَصْلًا",
 "もとばらい": "دفع مسبق (الدفع مقدماً)",
 "もとむ": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "もとむる": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "もとめ": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "もとめる": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "もとも": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "もともと": "أَصْلًا / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "もとよめ": "زوجة سابقة, طليقة (امرأة كانت زوجة لرجل معين سابقاً)\nمثال: كل طليقاته يعشن في تكساس",
 "もとより": "طوال الوقت, منذ البداية (طوال الوقت أو خلال فترة من الزمن)\nمثال: كانت تعرف طوال الوقت / طَبْعًا / نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "もとカレ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "もとダンナ": "زوج سابق, طليق (رجل كان زوجاً لامرأة معينة سابقاً)",
 "もとネタ": "أَصْلِيّ",
 "もどかしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "もどかしげに": "بتبرم, بقلق (بطريقة قلقة ومتذمرة)\nمثال: بتبرم، تقلب الطفل في سريره",
 "もどき": "كَـ / تَقْلِيد / نَقْد, اِنْتِقَاد",
 "もどく": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو. / قَلَّدَ",
 "もどし": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "もどす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / تَقَيَّأَ, قَاءَ / تَقَيُّؤ / شُفِيَ, بَرِئَ",
 "もどってくる": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "もどって来る": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "もどり": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "もどりづゆ": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "もどる": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / شُفِيَ, بَرِئَ / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "もどろ": "أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "もなかのつき": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "もにょもにょ": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة)\nمثال: مشى مترنحاً نحو المخرج",
 "もにょる": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "もぬけ": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "もぬけのから": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "もぬけのカラ": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "もぬけの殻": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "もの": "أُقْنُوم / فَرْد / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت / نَوْعِيَّة, جَوْدَة",
 "ものあんじ": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ものいい": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية / اِعْتَرَاض / اِعْتِرَاض / إِشَاعَة, شَائِعَة",
 "ものいう": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "ものいえばくちびるさむしあきのかぜ": "اَلسُّكُوتُ مِن ذَهَبٍ",
 "ものいり": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟ / ثَمِين, غَالٍ (ذو سعر مرتفع) / بَاهِظ التَّكْلِفَة (ينطوي على خسارة أو تضحية كبيرة)",
 "ものいれ": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد.",
 "ものうい": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط)",
 "ものうげ": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط) / سَوْدَاوِيّ, قَتَامِيّ (وقور أو حتّى كئيب في طبعه) / دَاكِن, قَاتِم (ذو لون كئيب وخافت يفتقر إلى الحيويّة)",
 "ものうり": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "ものおき": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "ものおきべや": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "ものおしみ": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "ものおじ": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "ものおそろしい": "مُخيف, مُخيفة",
 "ものおと": "ضَوْضَاء, ضَجِيج",
 "ものおぼえ": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "ものおもい": "أحلام اليقظة, استغراق (حالة مجردة من الاستغراق) / أحلام اليقظة, سرحان (الحلم بشرود ذهن أثناء اليقظة)",
 "ものおもう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ものおもわしい": "مُفَكِّر, مُتَأَمِّل (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "ものか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / تجسيم, تشييء (فعل تمثيل فكرة مجردة كشيء مادي) / تجسيد, تشخيص (تمثيل ملموس لفكرة أو مبدأ مجرد)",
 "ものかき": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "ものかげ": "غِطَاء / غِلَاف / غَطَّى / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "ものかは": "رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "ものがいえない": "عَاجِز عَن النُّطْق, مَبْهُوت (عاجز مؤقَّتًا عن الكلام بسبب الدهشة أو الصدمة)",
 "ものがたい": "نَزِيه, صَادِق",
 "ものがたり": "قِصَّة, حِكَايَة",
 "ものがたる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "ものがなしい": "حَزِين, زعلان / مُحْزِنٌ",
 "ものが言えない": "عَاجِز عَن النُّطْق, مَبْهُوت (عاجز مؤقَّتًا عن الكلام بسبب الدهشة أو الصدمة)",
 "ものぐさ": "كَسَل",
 "ものぐさい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "ものぐるい": "جُنُون",
 "ものぐるおしい": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه)",
 "ものごい": "سَائِل / فَقِير",
 "ものごころ": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "ものごし": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / تَفْرِقَة",
 "ものごっつ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ものごと": "أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت",
 "ものさし": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة. / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "ものさびしい": "وَحِيد, مُوحِش",
 "ものさわがしい": "صَارِخ, صاخِب",
 "ものしずか": "صَامِت, هَادِئ",
 "ものしらず": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "ものしり": "مُطَّلِع",
 "ものじたい": "شَيْء فِي ذَاتِهِ (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "ものすごい": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / فَظِيع, مُرَوِّع (يثير الرعب والهلع) / مُرَوِّع, مُفْزِع (مُقلِق ومؤلم في أقصى الدرجات) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "ものすっごい": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / فَظِيع, مُرَوِّع (يثير الرعب والهلع) / مُرَوِّع, مُفْزِع (مُقلِق ومؤلم في أقصى الدرجات) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "ものする": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "ものすんごい": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / فَظِيع, مُرَوِّع (يثير الرعب والهلع) / مُرَوِّع, مُفْزِع (مُقلِق ومؤلم في أقصى الدرجات) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "ものずき": "فُضُول / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "ものたち": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "ものたりない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "ものだから": "لِأَنَّ / هكذا, بلا سبب",
 "ものだち": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "ものだね": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "ものっそい": "مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ものつくり": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة / زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "ものづくし": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / ترقيم, قائمة مرقمة (قائمة مرقمة)\nمثال: استمر العد لعدة ساعات",
 "ものづくり": "تصنيع, صناعة (فعل صنع شيء (منتج) من مواد خام)\nمثال: تخليق وتصنيع البلورات المفردة",
 "もので": "لِأَنَّ / هكذا, بلا سبب",
 "ものですか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ものといたげ": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل) / فُضُولِيّ, مُتَطَفِّل (كثير التساؤل أو يبدو كذلك)",
 "ものとする": "اِفْتَرَضَ",
 "ものとり": "لِصّ, لِصَّة",
 "ものども": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "ものにする": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف. / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم. / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "ものににず": "غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن مقارنتها)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "ものの": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / لم يعد (ليس الآن) / ليس, ليس أكثر (إشارة إلى الدرجة التي توجد بها صفة معينة)\nمثال: لم تعد موجودة",
 "もののぐ": "أَدَاة / درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "もののけ": "روح شريرة (روح تميل لإحداث الضرر)",
 "もののふ": "مُحَارِب, مُقَاتِل",
 "もののほん": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "もののみかた": "ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "もののみごとに": "بشكل رائع, بشكل ممتاز (بشكل رائع) / بأبهة, بروعة (بطريقة جميلة ومثيرة للإعجاب)\nمثال: أبلى بلاءً حسناً بشكل ممتاز في الامتحان",
 "もののわかった": "غَيْر مُتَحَيِّز, مُنْصِف (عَنِ الشَّخْص؛ عَادِل وَمُحَايِد؛ لَا يَحْمِل أَحْكَامًا مُسْبَقَة)",
 "もののインターネット": "إِنْتَرْنَت الْأَشْيَاء (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "ものの本": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "ものの見事に": "بشكل رائع, بشكل ممتاز (بشكل رائع) / بأبهة, بروعة (بطريقة جميلة ومثيرة للإعجاب)\nمثال: أبلى بلاءً حسناً بشكل ممتاز في الامتحان",
 "ものび": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "ものほし": "منشر غسيل (هيكل لتعليق الملابس (كما للتجفيف)) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "ものほしげ": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "ものほしざお": "حبل الغسيل (حبل تُعلق عليه الملابس لتجف)",
 "ものほしそう": "تَأَمُّلِيّ, حَنِين (يُظهر حزناً تأمُّلياً وحنيناً هادئاً)",
 "ものほしづな": "حبل الغسيل (حبل تُعلق عليه الملابس لتجف)",
 "ものまね": "تَقْلِيد",
 "ものみ": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة / كَشَّاف / مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものみだかい": "فُضُولِيّ",
 "ものみのとう": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものみの塔": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものみやぐら": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ものめずらしい": "فُضُولِيّ",
 "ものめずらしげに": "بشكل غريب, بشكل لا يمكن تفسيره (بطريقة تختلف عن المعتاد أو المتوقع) / بتساؤل, بفضول\nمثال: كان لديه صوت أجش بشكل مثير للفضول",
 "ものもうす": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ものもち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "ものものしい": "صَارِم / بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "ものもらい": "سَائِل / فَقِير / خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "ものやわらか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ものわかり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "ものわかりがいい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "ものわかりがよい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "ものわかりがわるい": "كَثِيف, غَلِيظ",
 "ものわかりのいい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "ものわかりのよい": "حَسَّاس, فَطِن (مدرك بشكل حدسي أو فكري لشيء محسوس) / مَحْسُوس, مَلْمُوس (يُدْرَكُ بِالحَوَاسِّ بِسُهُولَة) / عاقل, معقول (يظهر العقل أو الحكم الصائب) / حسي, شاعر (قادر على الشعور أو الإدراك)\nمثال: خيار معقول",
 "ものわすれ": "كثرة النسيان, نسيان (الميل للنسيان) / سهو, نسيان (عدم الوعي الناجم عن الإهمال أو الفشل في التذكر)\nمثال: ازداد سهوه مع تقدمه في السن",
 "ものわらい": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ものわらいのたね": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "ものを": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "ものをいう": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "ものを言う": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "もの乞い": "سَائِل / فَقِير",
 "もの化": "تجسيم, تشييء (فعل تمثيل فكرة مجردة كشيء مادي) / تجسيد, تشخيص (تمثيل ملموس لفكرة أو مبدأ مجرد)",
 "もの問いたげ": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل) / فُضُولِيّ, مُتَطَفِّل (كثير التساؤل أو يبدو كذلك)",
 "もの好き": "فُضُول / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "もの寂しい": "وَحِيد, مُوحِش",
 "もの思い": "أحلام اليقظة, استغراق (حالة مجردة من الاستغراق) / أحلام اليقظة, سرحان (الحلم بشرود ذهن أثناء اليقظة)",
 "もの恐ろしい": "مُخيف, مُخيفة",
 "もの悲しい": "حَزِين, زعلان / مُحْزِنٌ",
 "もの憂い": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط)",
 "もの憂げ": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط) / سَوْدَاوِيّ, قَتَامِيّ (وقور أو حتّى كئيب في طبعه) / دَاكِن, قَاتِم (ذو لون كئيب وخافت يفتقر إلى الحيويّة)",
 "もの書き": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "もの柔らか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "もの欲しげ": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "もの欲しそう": "تَأَمُّلِيّ, حَنِين (يُظهر حزناً تأمُّلياً وحنيناً هادئاً)",
 "もの淋しい": "وَحِيد, مُوحِش",
 "もの狂おしい": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة) / مَجْنُون, مَحْمُوم (يَتَّسِمُ بِالإِثَارَةِ أَوِ الانْفِعَالِ غَيْرِ المُسَيْطَرِ عَلَيْه)",
 "もの珍しい": "فُضُولِيّ",
 "もの申す": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "もの知らず": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "もの自体": "شَيْء فِي ذَاتِهِ (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "もの臭い": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "もの覚え": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "もの言う": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "もの静か": "صَامِت, هَادِئ",
 "もはや": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "もはら": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / أساساً, بشكل رئيسي (في الغالب)\nمثال: هو مهتم بشكل رئيسي بالفراشات",
 "もはん": "أُسْوَة (أُسْوَةٌ)",
 "もはんえんぎ": "مَعْرِض",
 "もはんしゅう": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "もはんてき": "نَمُوذَجِيّ / نَمُوذَجِيّ, مِثَالِيّ",
 "もひとつ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "もふもふ": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب) / سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "もふる": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "もほう": "تَقْلِيد",
 "もほうしゃ": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر) / منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر)",
 "もほうひん": "تَقْلِيد",
 "もみ": "حَقْل اَلْأَرُزّ (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / هَشِيم / بوسوم طائر, سنجاب طائر (بوسوم ليلي يتحرك بقفزات انزلاقية باستخدام طيات جلدية تشبه المظلة على طول جانبي الجسم)",
 "もみあい": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみあう": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみあげ": "سَوَالِف, سَالِف اَلشَّعْر",
 "もみかわ": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ) / أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / بني مصفر, كراميل (لون أسمر متوسط إلى داكن) / جِلْد عَارٍ, عُرْي (الجلد العاري)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "もみがら": "هَشِيم",
 "もみくしゃ": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみくた": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみくちゃ": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみけし": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "もみけす": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "もみこむ": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もみしだく": "جَعْدَة / تَجَعُّد, جَعْدَة / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみじ": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "もみじどり": "أَيِّل",
 "もみたてる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "もみほぐす": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみもみ": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "もみりょうじ": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみ上げ": "سَوَالِف, سَالِف اَلشَّعْر",
 "もみ合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみ合う": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみ殻": "هَشِيم",
 "もみ消し": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "もみ消す": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "もみ療治": "تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "もみ皮": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ) / أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / بني مصفر, كراميل (لون أسمر متوسط إلى داكن) / جِلْد عَارٍ, عُرْي (الجلد العاري)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "もみ込む": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もみ革": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ) / أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / بني مصفر, كراميل (لون أسمر متوسط إلى داكن) / جِلْد عَارٍ, عُرْي (الجلد العاري)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "もむ": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ جلدَه : فركه بأظفاره)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ) / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ) / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "もめ": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "もめごと": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "もめる": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "もめん": "قُطْن, قُطُن / قُطْنِي, قطن",
 "もめんばり": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك) / إبرة خياطة (إبرة تستخدم في الخياطة لسحب الخيط عبر القماش)",
 "もめ事": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "もも": "خَوْخ / خَوْخَة / دُرَّاق / فِرْسِك / فَخِذ, فَخْذ / مِٱئَة, مِئَة / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ももいろ": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "ももしおちゃ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "ももぞの": "بستان خوخ (بستان من أشجار الخوخ)",
 "ももち": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "ももちどり": "زقزاق (أي من طيور شاطئية عديدة ذات بنية مدمجة نسبياً ومناقير مستقيمة وأجنحة مدببة كبيرة؛ قريبة الصلة بطيور الطيطوي)",
 "ももとせ": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "ももにく": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "ももひき": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "ももよ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ももんじいや": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ももんじい屋": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ももんじや": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ももんじ屋": "جَزَّار, قَصَّاب / جَزَّار / جَزَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ) / جَزَر, نَحَر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "もも肉": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "もや": "سَدِيم",
 "もやい": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور.",
 "もやいづな": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "もやいむすび": "عقدة البولين, عقدة الخلاص (عقدة أنشوطية لا تنزلق ولا تنحشر)",
 "もやい結び": "عقدة البولين, عقدة الخلاص (عقدة أنشوطية لا تنزلق ولا تنحشر)",
 "もやい綱": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "もやう": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم. / بِرْكَة, سَبْخَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "もやくや": "مُشْكِلَة, مَتاعِب / مُنْخَفَض",
 "もやし": "برعم الفاصولياء, نبتة الفاصولياء (أي من حبوب الفاصولياء المستنبتة المختلفة: خاصة الماش أو العدس أو فول الصويا الصالح للأكل)",
 "もやす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / نَبْتَة",
 "もやもや": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم) / ضَبَابِيّ, مُشَوَّش (غَيْر وَاضِح أَوْ مُبْهَم الخُطُوط)",
 "もゆるつち": "فَحْم حَجَرِيّ / فَحْم / فحم / فَحَم",
 "もゆるみず": "بترول, نفط خام (زيت داكن يتكون أساساً من الهيدروكربونات)",
 "もよう": "نُمُوذَج, نَمَط / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "もようしもの": "تَرْفِيه, تَسْلِيَة",
 "もよおし": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "もよおしもの": "تَرْفِيه, تَسْلِيَة",
 "もよおす": "مَسَكَ, مسك / تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "もより": "الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "もらい": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "もらいうける": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "もらいご": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "もらいちち": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらいぢ": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらいぢち": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらいて": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "もらいもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "もらいもん": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "もらい乳": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらい受ける": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "もらい子": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "もらい手": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "もらい物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "もらう": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "もらす": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "もらたす": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "もらった": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "もり": "مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل) / حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء / مشرط (سكين جراحي بشفرة مدببة ذات حدين؛ يستخدم للثقب والشقوق الصغيرة) / رمح (قضيب طويل مدبب يستخدم كأداة أو سلاح) / حربة صيد, رمح الصيد (أداة ذات عمود ورأس شائك تستخدم لصيد الأسماك) / تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "もりあがり": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "もりあがる": "اِنْتَفَخَ, وَرِمَ",
 "もりあわせ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "もりおか": "مُورْيُوكَا",
 "もりかえす": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "もりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "もりたてる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もりだくさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "もりつち": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "もりど": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "もりのバター": "أَفُوكَادُو",
 "もりばな": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "もりふくろう": "بومة سمراء (بومة أوروبية بنية محمرة لها رأس مستدير وعيون سوداء)",
 "もりもり": "بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله / بحيوية, بنشاط (بطريقة نشطة) / محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "もりやく": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "もりんが": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في عناقيد متدلية وقرون يستخدم لبها طبياً؛ آسيا الاستوائية ووسط وجنوب…)",
 "もり立てる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مَلَأَ / وَصَفَ / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة. / تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "もれ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا. / إِغْفَال / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "もれきく": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "もれなく": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
 "もれる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف. / جَمَّلَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "もろ": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / مَعًا, سَوِيًّا / بشكل بارز, بوضوح (بطريقة بارزة) / بشكل لافت, بوضوح تام (بطريقة تميل إلى جذب الانتباه)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر / تَمَامًا",
 "もろい": "سَرِيعُ الكَسْر, هَشّ (قَلِيلُ المُرُونَة؛ يَسْهُلُ تَشَقُّقُهُ أَوِ انْكِسَارُهُ) / غَيْرُ مُلَدَّن, هَشّ ((لِلْمَعْدَنِ أَوِ الزُّجَاج) لَمْ يُلَدَّنْ وَبِالتَّالِي سَهْلُ التَّشَقُّقِ أَوِ الكَسْر) / جَافّ, قَاسٍ (يفتقر إلى الدفء والسخاء في الروح) / بريتل, توفي (سكر مكرمل مبرد في صفائح رقيقة) / رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "もろがみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "もろくも": "بِسُرْعَة, عَاجِلًا",
 "もろこ": "جودجون (سمكة مياه عذبة أوروبية نحيلة صغيرة غالباً ما يستخدمها الصيادون كطعم) / قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير وجسم مستدق ممدود وتتحور الزعانف البطنية لتعمل كممص)",
 "もろこし": "ذُرَة, سرغوم / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / صِينِيّ",
 "もろち": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "もろてをあげて": "قَلْبًا وَقَالَبًا",
 "もろとも": "مَعًا, سَوِيًّا",
 "もろに": "تَمَامًا",
 "もろは": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "もろはのけん": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "もろはのつるぎ": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "もろばれ": "سر مكشوف (شيء من المفترض أن يكون سرياً ولكنه معروف بشكل عام)\nمثال: كانت علاقة حبهما سراً مكشوفاً",
 "もろひと": "الْجَمِيع, كُلّ شَخْص",
 "もろびと": "الْجَمِيع, كُلّ شَخْص",
 "もろみ": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "もろもろ": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "もろ刃": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "もろ刃の剣": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "もわっと": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "もわもわ": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "もん": "أُقْنُوم / فَرْد / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت / نَوْعِيَّة, جَوْدَة / بَوَّابَة / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / شُعْبَة / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / نُمُوذَج, نَمَط / وَرَقَة لَعْب, وَرَقَة / لغة مون (لغة مون-خمير التي يتحدث بها شعب مون) / مون (عضو في شعب بوذي يعيش في ميانمار والأجزاء المجاورة من تايلاند) / الاثنين, يوم الاثنين (اليوم الثاني من الأسبوع) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين / أَلَم (الوَجَع) / اِحْتِضَار\nمثال: ألم أقل لك ذلك؟",
 "もんいん": "إِمْبِرَاطُورَة الأُمّ",
 "もんえい": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "もんか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "もんかしょう": "مستشارية (مبنى حكومي يضم مكتب المستشار)",
 "もんかせい": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "もんがいかん": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "もんがまえ": "بَوَّابَة",
 "もんきりがた": "قَالَبِيّ, نَمَطِيّ (يَتَّسِمُ بِاتِّبَاعِ صِيغَةٍ أَوْ قَالَبٍ مُعَيَّن)",
 "もんく": "شِكَايَة, شَكْوَى / جُمْلَة, تَعْبِير (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "もんくなく": "بشكل قاطع, بلا جدال (بطريقة لا تقبل الجدل أو النزاع)\nمثال: أنت تكتب كما لو أن هذه الحقيقة، وإن كانت تدينني بلا جدال بالانضمام إلى صفوف البوهيمية، إلا أنها أكسبتني حق الدخول إلى أي رفقة",
 "もんくなし": "بِلَا مُنَازِع, مُسَلَّمٌ بِه (مُتَّفَقٌ عَلَيْهِ عُمُومًا؛ لَا يَخْضَعُ لِلنِّزَاع)",
 "もんくのつけようがない": "بَرِيء, لَا تَشُوبُهُ شَائِبَة (خالٍ من الذنب؛ لا يستحق اللوم)",
 "もんくをいう": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "もんくをつける": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "もんけん": "مَعْلُومَات, مَعْلُومَة",
 "もんげん": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "もんこ": "أَبْوَاب, بَاب",
 "もんこかいほう": "باب مفتوح, حرية الوصول (حرية الوصول) / سياسة الباب المفتوح (سياسة منح فرص تجارية متساوية لجميع البلدان)\nمثال: حافظ على سياسة الباب المفتوح لجميع الموظفين",
 "もんこかいほうせいさく": "باب مفتوح, حرية الوصول (حرية الوصول) / سياسة الباب المفتوح (سياسة منح فرص تجارية متساوية لجميع البلدان)\nمثال: حافظ على سياسة الباب المفتوح لجميع الموظفين",
 "もんごん": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "もんさつ": "لوحة الباب (لوحة اسم مثبتة على باب؛ تشير إلى الشخص الذي يعمل أو يعيش هناك)",
 "もんざい": "اِتِّهَام / اِتِّهَام, تُهْمَة",
 "もんし": "قَاطِعَة",
 "もんしょう": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة)",
 "もんしょうがく": "عِلْم شِعَارات النَبَالَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もんしん": "مُقَابَلَة",
 "もんしんひょう": "سِيرَة مَرْضِيَة",
 "もんじ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "もんじゅうしょ": "المحكمة العليا للولاية, محكمة عليا (أعلى محكمة في معظم ولايات الولايات المتحدة)",
 "もんじょ": "وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "もんじょう": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "もんじょかん": "أَرْشِيف",
 "もんじるし": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / وَرَقَة لَعْب, وَرَقَة",
 "もんじん": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "もんせい": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "もんせき": "لَوْم, مَلَامَة",
 "もんせきけつぎ": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "もんぜん": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "もんぞう": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "もんだい": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال. / تَمْرِين / مناقشة عامة (مناقشة حرة ومفتوحة (أو جدال) حول مسألة ذات اهتمام عام)\nمثال: مثل هذا الاقتراح يستحق مناقشة عامة شاملة / مُشْكِلَة, مَتاعِب",
 "もんだいいしき": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "もんだいがい": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "もんだいさく": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "もんだいしゅう": "كراسة تمارين, كراسة عمل (كتاب أو كتيب للطالب يحتوي على مسائل مع مساحات لحلها)",
 "もんだいてん": "تَمْرِين / مَسْأَلَة",
 "もんだいない": "عَفْوًا",
 "もんだいにならない": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه) / تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "もんだいむきげんご": "لغة موجهة للتطبيق, لغة موجهة للمشكلات (لغة تشبه عباراتها مصطلحات المستخدم)",
 "もんだいようし": "ورقة امتحان (امتحان تحريري)",
 "もんだいナッシング": "عَفْوًا",
 "もんだから": "لِأَنَّ / هكذا, بلا سبب",
 "もんち": "دَرَجَة",
 "もんちゃく": "مُشْكِلَة, مَتاعِب",
 "もんちゅう": "عمود البوابة (أي من العمودين اللذين يحدان البوابة)",
 "もんちゅうじょ": "المحكمة العليا للولاية, محكمة عليا (أعلى محكمة في معظم ولايات الولايات المتحدة)",
 "もんぢゃく": "مُشْكِلَة, مَتاعِب",
 "もんてい": "حَوَارِيّ, تِلْمِيذ",
 "もんで": "لِأَنَّ / هكذا, بلا سبب",
 "もんですか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "もんと": "تَابِع / مُتَابِع",
 "もんどう": "حِوَار, مُحَادَثَة / حِوَار",
 "もんどうほう": "جدلية",
 "もんなし": "فقير",
 "もんばつ": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "もんばん": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "もんび": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "もんぴ": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "もんぴょう": "لوحة الاسم (لوحة تحمل اسماً)",
 "もんみゃく": "وريد بابي, وريد بابي كبدي (وريد قصير يحمل الدم إلى الكبد)",
 "もんもう": "أُمِّيَّة / أُمِّي, غير قارئ (شخص غير قادر على القراءة)",
 "もんもん": "مُتَأَلِّم, مُعَذَّب (يعاني ألماً شديداً خاصة الألم النفسي) / أَقْرَن / وَشْم / وَشَمَ, وَشَّمَ / نُمُوذَج, نَمَط",
 "もんよう": "نُمُوذَج, نَمَط / نَسَب",
 "もー": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / قَرِيبًا, سَرْعَانَ مَا / أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني. / غِي, جِي",
 "もーもー": "خُوَار / خَارَ (صوت حيوان البقر خاصة؛ في : نطقٌ يحدث من الحلق، أي الصوت الذي يصدر من الحلق بشكل مستمر) / مُو\nمثال: السحابة هي كتلة بخار في السماء. / بقرة (أنثى الماشية المستأنسة)",
 "も一つ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "ゃ": "صيغة تركيب (شكل مقيد يستخدم فقط في المركبات)",
 "や": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة) / سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / ثَمَانِيَة, تمانية / ثَمَانِيَةٌ / كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود. / بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / أُوه ((أَوَّهَ): آه)\nمثال: أوه؛ أين هو مكتب البريد؟ / يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان. / مَجْلِس / سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف. / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "やあ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)",
 "やあさん": "يَاكُوزَا",
 "やあた": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "やあやあ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / يَاه, اسمع / هَلَا / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "やい": "يَاه, اسمع / هَلَا",
 "やいし": "بيلمنيت (أحفورة جيرية مخروطية مدببة من طرف ولها تجويف مخروطي في الطرف الآخر، تعود لرخويات منقرضة)",
 "やいた": "خازوق لوحي, ركيزة لوحية (ركيزة في صف من الركائز المدفوعة جنباً إلى جنب لاحتجاز الأرض أو منع التسرب)",
 "やいなや": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "やいのやいの": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "やいば": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها",
 "やいやい": "بإلحاح, بشكل ضاغط (بطريقة ملحة)",
 "やえ": "ثُمَانِيّ (ذو ثماني وحدات أو مكوّنات) / ضِعْفِيّ, مُضَاعَف (ضعف الكمية أو العدد)",
 "やえい": "تَخْيِيم",
 "やえいち": "مخيم, موقع تخييم (موقع يمكن للأشخاص في العطلة نصب خيمة فيه)",
 "やお": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة / جماهير, جموع (عامة الناس بشكل عام) / جمهور, حشد كبير (تجمع كبير للناس) / جموع, حشد (كمية كبيرة غير محددة)\nمثال: افصل المحاربين عن الجموع",
 "やおい": "يَاوِي",
 "やおちょう": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "やおもて": "الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما) / خط النار (الخط الذي يطلق منه الجنود النار)\nمثال: خط المواجهة هو مكان الحدث / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "やおもてにたつ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "やおや": "بَقَّال / جاك لجميع المهن",
 "やおよろず": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل",
 "やおら": "بِبُطْء / فَجْأَةً",
 "やおん": "منصة الفرقة الموسيقية (منصة حيث يمكن لفرقة موسيقية (نحاسية) العزف في الهواء الطلق)",
 "やか": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "やかいそう": "أثمان أبيض, زهرة القمر (متسلق استوائي شامل له زهور ليلية بيضاء عطرة)",
 "やかいふく": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "やかた": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / زِمْلِك, خُصّ / قَمَرَة, قَمْرَة",
 "やかたぶね": "عوامة, منزل عائم (صندل مصمم ومجهز للاستخدام كمسكن)",
 "やかましい": "صَارِخ, صاخِب / زَعْلَان / صَارِم / خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "やかましや": "عياب, متشائم (شخص دائم الانتقاد لنوايا الآخرين)",
 "やかまし屋": "عياب, متشائم (شخص دائم الانتقاد لنوايا الآخرين)",
 "やから": "طَرَف / حَفْلَة, اِحْتِفَال",
 "やかん": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة. / غَلَّايَة",
 "やかんがいしゅつきんしれい": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "やかんがっこう": "مدرسة ليلية (مدرسة تعقد فصولاً في المساء للطلاب الذين لا يستطيعون الحضور أثناء النهار)",
 "やかんちゃくりくくんれん": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "やが": "عثة ليلية (عثة ليلية متوسطة الحجم باهتة اللون عادة؛ اليرقات عادة ما تكون ملساء الجسم وهي آفات زراعية مدمرة)",
 "やがい": "بالخارج, في الخارج (خارج مبنى) / خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: في الصيف نلعب في الخارج / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "やがいおんがくどう": "منصة الفرقة الموسيقية (منصة حيث يمكن لفرقة موسيقية (نحاسية) العزف في الهواء الطلق)",
 "やがいげき": "اِسْتِعْرَاض",
 "やがく": "مدرسة ليلية (مدرسة تعقد فصولاً في المساء للطلاب الذين لا يستطيعون الحضور أثناء النهار)",
 "やがっこう": "مدرسة ليلية (مدرسة تعقد فصولاً في المساء للطلاب الذين لا يستطيعون الحضور أثناء النهار)",
 "やがて": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً / تَقْرِيبًا, عَلَى وَشْك / أَخِيراً",
 "やがら": "سمكة البوق (سمكة استوائية نحيلة ذات خطم أنبوبي طويل وصفائح عظمية بدلاً من القشور)",
 "やき": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات / تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا) / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "やきあげる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "やきあみ": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية) / شواية شبكية (أداة طهي من قضبان معدنية متوازية؛ تستخدم لشواء السمك أو اللحم)",
 "やきいもや": "بَطَاطَا حُلْوَة",
 "やきいれ": "إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "やきいん": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきいんをおす": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきえ": "رسم بالحرق (تصميم يتم إنتاجه عن طريق الحرق على الخشب أو الجلد)",
 "やきがた": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "やきがね": "مِيسَم",
 "やきがま": "فُرْن, تَنُّور",
 "やきぐし": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه)",
 "やきごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきすぎる": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "やきせっこう": "جص, جص باريس (أي من أسمنتات الجبس المختلفة؛ مسحوق أبيض (شكل من أشكال كبريتات الكالسيوم) يشكل عجينة عند خلطه بالماء ويتصلب؛ يستخدم في صنع القوالب والمنحوتات…)",
 "やきつき": "إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / خيط التحزيم (حبال صغيرة تستخدم لربط حبلين أو أكثر معاً)",
 "やきつけ": "طِبَاعَة / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "やきつける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خَبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "やきなおし": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "やきなおす": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "やきなべ": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "やきなまし": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "やきにく": "شواية / مُصَبَّع / مِشْوَاة / شِوَاء / مَشْوِيَّات / شَوَى, يَشْوِي",
 "やきば": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد) / محرقة الجثث (مبنى جنائزي حيث يتم حرق الجثث)",
 "やきふ": "غلوتين القمح (غلوتين محضر من القمح)",
 "やきぶた": "شواء خنزير (قطعة من لحم الخنزير مناسبة للتحمير)",
 "やきめ": "حَارِق, لَاذِع (شديد القسوة في النقد)",
 "やきめし": "أرز صيني مقلي, أرز مقلي (أرز مسلوق مخلوط بالبصل الأخضر ولحم الخنزير المفروم أو الجمبري ومخفوق بسرعة مع البيض)",
 "やきめをつける": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر.",
 "やきもき": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "やきもち": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やきもどし": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / مُعَدِّل, مُهَدِّئ (يُلَطّف ويجعل الأمر أكثر اعتدالًا)",
 "やきもの": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "やきゅう": "بَيْسْبُول",
 "やきゅうじょう": "ملعب بيسبول (ملعب مخصص للعبة البيسبول)",
 "やきゅうじん": "لاعب بيسبول, لاعب كرة القاعدة (رياضي يلعب كرة القاعدة (البيسبول))",
 "やきゅうせんしゅ": "لاعب بيسبول, لاعب كرة القاعدة (رياضي يلعب كرة القاعدة (البيسبول))",
 "やきゅうひじ": "دوري الناشئين (دوري بيسبول برعاية تجارية للاعبين الذين تتراوح أعمارهم بين 8 و 12 عاماً)",
 "やきゅうぶ": "نادي بيسبول (فريق من لاعبي البيسبول المحترفين الذين يلعبون ويسافرون معًا)\nمثال: لعب كل نادٍ ست مباريات على أرضه مع فرق في قسمه الخاص",
 "やきゅうぼう": "قبعة بيسبول, قبعة جوكي (قبعة ذات حاجب)",
 "やきゅうチーム": "فريق بيسبول (فريق يلعب البيسبول)",
 "やきょうしょう": "ذعر ليلي (نوبة عاطفية (عادة عند الأطفال الصغار) يستيقظ فيها الشخص مرعوباً مع شعور بالقلق والخوف دون تذكر الحادث المسبب)",
 "やきょく": "مقطوعة ليلية, نوكتورن (قطعة موسيقية غنائية تأملية (خاصة للبيانو))",
 "やきをいれる": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "やきん": "عِلْم المَعَادِن (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / وردية ليلية (عمال يعملون أثناء الليل (مثل من منتصف الليل إلى 8 صباحًا)) / وردية ليلية (نوبة العمل أثناء الليل (مثل منتصف الليل إلى 8 صباحاً))",
 "やきんがく": "عِلْم المَعَادِن (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "やきんがくしゃ": "خبير معادن, مهندس تعدين (مهندس مدرب على استخراج وتكرير وسبك وتصنيع المعادن)",
 "やぎ": "شجرة الصفصاف, صفصاف (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)",
 "やぎざ": "بُرْج اَلْجَدْي, اَلْجَدْي (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "やぎにゅう": "حَلِيب اَلْمَاعِز (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "やぎひげ": "عُثْنُون",
 "やぎゅう": "جَامُوس, جَامُوسَة",
 "やぎょう": "وردية ليلية (عمال يعملون أثناء الليل (مثل من منتصف الليل إلى 8 صباحًا)) / وردية ليلية (نوبة العمل أثناء الليل (مثل منتصف الليل إلى 8 صباحاً))",
 "やぎミルク": "حَلِيب اَلْمَاعِز (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "やぎ乳": "حَلِيب اَلْمَاعِز (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "やぎ座": "بُرْج اَلْجَدْي, اَلْجَدْي (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "やく": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / شَوَى, صَلَى / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / مُصِيبَة, شَقْوَة / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟ / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة. / حَوَالَيْ, تَقْرِيبًا / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / تقصير (عملية الإنقاص في الطول) / دهن المعجنات, سمن نباتي (دهن مثل الزبدة أو الشحم يُستخدم في المخبوزات)\nمثال: الفستان يحتاج إلى تقصير / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد / فَائِدَة, جَدْوَى\nمثال: 労なくして益なし。 — كل شيء وله ثمن / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / بانجو, عشب (أسماء دارجة للماريجوانا) / أسرار, خفايا (مصطلحات عامية للمعلومات الداخلية) / كولا (مشروب غازي منكه بمستخلص من جوز الكولا) / أحمق, جاهل (شخص جاهل أو أحمق)\nمثال: هل هذه هي الحقيقة المجردة؟ / مِئْبَر / حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ) / حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やくいん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / مَأْمُور / مَسْؤُول / ضَابِط / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "やくうん": "نَحْس, سُوءُ الحَظّ",
 "やくおとし": "رُقْيَة",
 "やくおん": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "やくがく": "صَيْدَلِيَّة / صَيْدَلَة",
 "やくがくしゃ": "عالم صيدلة, فارماكولوجي (شخص مدرب في علم الأدوية (تركيبها واستخداماتها وتأثيراتها))",
 "やくがら": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "やくぎ": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "やくげん": "خُلَاصَة, مُلَخَّص",
 "やくご": "مرادف (يقال عن كلمتين يمكن تبادلهما في سياق ما أنهما مترادفتان بالنسبة لذلك السياق)",
 "やくさい": "بَلَاء, بُؤْس",
 "やくさつ": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / اختناق, انحباس ((علم الأمراض) انقباض جزء من الجسم بحيث يقطع تدفق الدم أو السوائل الأخرى) / اختناق, خنق (حالة توقف التنفس عن طريق ضغط ممر الهواء)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم / تَسْمِيم / تَسَمُّم",
 "やくざ": "يَاكُوزَا / بلطجي, سفاح (مجرم شاب عدواني وعنيف) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "やくざい": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب. / عامل كيميائي, مادة كيميائية فاعلة (عامل ينتج تفاعلات كيميائية)",
 "やくざいがく": "صيدلة (فن وعلم تحضير وصرف الأدوية والعقاقير)",
 "やくざいし": "صَيْدَلِيّ, صَيْدَلَانِيّ",
 "やくざもの": "سَارِق, عُضْو فِي عِصَابَة (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك. / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "やくざ者": "سَارِق, عُضْو فِي عِصَابَة (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك. / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "やくしがたい": "غير قابل للترجمة (غير قادر على التحول إلى شكل أو أسلوب أو لغة أخرى)\nمثال: مصطلح غير قابل للترجمة",
 "やくしつ": "حُجْرَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم) / غُرْفَة, غُرْفَةُ نَوْم (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / مَجْلِس\nمثال: قعدنا في وسط الحجرة.",
 "やくしにくい": "غير قابل للترجمة (غير قادر على التحول إلى شكل أو أسلوب أو لغة أخرى)\nمثال: مصطلح غير قابل للترجمة",
 "やくしゃ": "مُمَثِّل, مُمَثِّلَة / مُتَرْجِم / مُتَرْجِمَة / تُرْجُمَان",
 "やくしゅ": "كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره / مُخَدِّر / عَقَّار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "やくしゅしょう": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "やくしゅつ": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "やくしゅや": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية) / صَيْدَلِيَّة / صَيْدَلَة",
 "やくしょ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "やくしょく": "عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "やくしょことば": "لغة بيروقراطية, لغة رسمية (أسلوب الكتابة المميز لبعض المسؤولين الحكوميين: رسمي وغامض)",
 "やくしょしごと": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع)",
 "やくしん": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "やくじ": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "やくじゅつ": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "やくじょ": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "やくじょう": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "やくじょうずみ": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "やくす": "تَرْجَمَ / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / مَقْبِض",
 "やくすう": "قَاسِم, مَقْسُوم عَلَيْهِ",
 "やくする": "تَرْجَمَ / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / مَقْبِض",
 "やくせん": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "やくそうりょうほう": "طب نباتي, علاج بالأعشاب (استخدام النباتات أو المستخلصات النباتية لأغراض طبية (خاصة النباتات التي ليست جزءاً من النظام الغذائي العادي))",
 "やくそく": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "やくそくごと": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "やくそくされた": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "やくそくてがた": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "やくそくのち": "أَرْض الْمِيعَاد (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "やくそくやぶる": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "やくそくをやぶる": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "やくたい": "جَدْوَى, فَائِدَة (صفة كون الشيء ذا فائدة عملية)",
 "やくたいもない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "やくたたず": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "やくだく": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "やくだな": "خزانة الأدوية, صيدلية منزلية (خزانة تحفظ فيها الأدوية ومستلزمات النظافة الشخصية)",
 "やくちゅう": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "やくつきとりしまりやく": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "やくづくり": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "やくて": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "やくてん": "صَيْدَلِيَّة / صَيْدَلَة / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "やくとう": "غلي, مغلي ((في علم الصيدلة) استخلاص المواد الدوائية القابلة للذوبان في الماء عن طريق الغليان) / خَرْطُوش, خَرْطُوشَة",
 "やくとく": "مِنْحَة, عِلَاوَة",
 "やくど": "رَعَشَة / يرتعش / يهز",
 "やくどう": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "やくどうかん": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة",
 "やくどころ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "やくなん": "بَلَاء, بُؤْس",
 "やくにたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "やくにたてる": "مَأْثُرَة / اِسْتَغَلَّ",
 "やくにもたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "やくにんこんじょう": "بيروقراطية (مسؤولون حكوميون غير منتخبين)",
 "やくに立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "やくはらい": "رُقْيَة",
 "やくば": "بَلَدِيَّة",
 "やくばらい": "رُقْيَة",
 "やくひつ": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "やくひん": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب. / كِيمَاوِيّ, كِيمِيَائِيّ",
 "やくひんがいしゃ": "شركة أدوية, شركة صيدلانية (شركة تقوم بتصنيع وبيع المستحضرات الصيدلانية)",
 "やくび": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "やくびょう": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "やくびょうがみ": "نَحَسَ, جَلَبَ اَلنَّحْس",
 "やくびん": "أُنبوب",
 "やくぶつ": "مُخَدِّر / عَقَّار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "やくぶつがく": "عِلْم اَلصَّيْدَلَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "やくぶつちゅうどく": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "やくぶつちりょう": "دَوَاء",
 "やくぶつとうよ": "دَوَاء",
 "やくぶつどうたい": "حركية الدواء (دراسة عمل الأدوية في الجسم: طريقة ومعدل الإخراج، ومدة التأثير، إلخ)",
 "やくぶつどうたいがく": "حركية الدواء (دراسة عمل الأدوية في الجسم: طريقة ومعدل الإخراج، ومدة التأثير، إلخ)",
 "やくぶつみつばい": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "やくぶつらんよう": "إدمان, تعاطي المخدرات (الاستخدام المفرط للعقاقير)",
 "やくぶつりょうほう": "دَوَاء",
 "やくぶん": "نَقْص / تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "やくほ": "صيدلية (متجر تجزئة تباع فيه الأدوية وسلع أخرى)",
 "やくほう": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم / خَرْطُوش, خَرْطُوشَة",
 "やくまわり": "دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: في أي دور تسكن؟",
 "やくみ": "تَابِل",
 "やくめ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "やくようしゅ": "كحول, مشروب كحولي (سائل أو شراب يحتوي على الكحول كعامل نشط)\nمثال: الكحول (أو الشراب) دمره",
 "やくりがく": "عِلْم اَلصَّيْدَلَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "やくりがくしゃ": "عالم صيدلة, فارماكولوجي (شخص مدرب في علم الأدوية (تركيبها واستخداماتها وتأثيراتها))",
 "やくりょう": "جرعة (كمية محددة من الدواء تؤخذ في وقت واحد) / جرعة (كمية العامل النشط (مادة أو إشعاع) التي يتم تناولها أو امتصاصها في وقت واحد)",
 "やくろう": "خزانة الأدوية, صيدلية منزلية (خزانة تحفظ فيها الأدوية ومستلزمات النظافة الشخصية)",
 "やくわり": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟",
 "やくをおとす": "طَرَدَ",
 "やくをつとめる": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "やぐ": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "やぐら": "برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران) / برج صغير, بريج (برج صغير يمتد فوق مبنى) / سِقَالَات, سِقَالَة / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "やぐるまぎく": "قنطريون عنبري, ورد الذرة (نبات أوراسي حولي يُزرع في أمريكا الشمالية له رؤوس مبهرجة من الزهور الزرقاء أو الأرجوانية أو الوردية أو البيضاء) / أوفولاريا كبيرة الأزهار, زهرة القش (نبات من جنوب وجنوب شرق الولايات المتحدة يزرع لزهوره الصفراء التي يمكن تجفيفها)",
 "やけ": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やけい": "حارس ليلي, ناطور ليلي (حارس ذكر يعمل أثناء الليل) / دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام) / النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "やけいしにみず": "قَطْرَة فِي الْمُحِيط",
 "やけくそ": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やけこげ": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "やけこげる": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة) / لفحة (مرض نباتي ينتج مظهراً بنياً أو محروقاً لأنسجة النبات) / حرق سطحي (حرق في السطح)",
 "やけっぱら": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やけっ腹": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やけつく": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "やけに": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً",
 "やけのやんぱち": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やけばら": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やけひばし": "خَاطِف, سَرِيع جِدًّا (سَرِيع لِلغَايَة؛ قَادِر عَلَى الاسْتِجَابَة السَّرِيعَة وَالسُّرْعَة الفَائِقَة) / مُتَوَهِّج الحُمْرَة (يتوهَّج باللون الأحمر من شدَّة الحرارة) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / سَاخِن, طَازَج جِدًّا (الأحدث والأكثر جدّة)",
 "やけぼくい": "جَمْرَة",
 "やけぼっくい": "جَمْرَة",
 "やける": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "やこうぼく": "ملكة الليل, ياسمين الليل (شجيرة دائمة الخضرة من جزر الهند الغربية لها عناقيد من الزهور البيضاء الصفراء القمعية الشكل التي تكون عطرة في الليل)",
 "やこぜん": "مُتَسَمٍّ, مُدَّعٍ (كما يدّعيه المرء لنفسه في كثير من الأحيان دون مبرّر)",
 "やごう": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة) / اسم فني (الاسم المستعار لممثل) / تَوَاطُؤ",
 "やさ": "مُؤَدَّب",
 "やさい": "نَبَات, بَقْلَة (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / خُضَر, خُضَار (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه) / نَبَاتِيّ / خَضْرَاوِيّ\nمثال: هذا النبات مهدد بالانقراض. / مَارِهْوَانَا, حَشِيش",
 "やさいじる": "حساء الخضروات, مينستروني (حساء مصنوع من مجموعة متنوعة من الخضروات)",
 "やさいばたけ": "بستان تجاري (حديقة تُزرع فيها الفواكه والخضروات لغرض التسويق)",
 "やさいるい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "やさか": "اِزْدِهَار, رَخَاء / حَظًّا مُوَفَّقًاَ ((حَظَا) فلان حظوا: مشى رويدا)\nمثال: حظا سعيدا يا زيري.",
 "やさかい": "لِأَنَّ / هكذا, بلا سبب",
 "やさき": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم) / جُلّ, مُعْظَم / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "やさきに": "بينما, في الوقت الذي (في نفس الوقت الذي)\nمثال: بينما كان يحتضر، تجادلوا حول تركته",
 "やさぐれ": "آبِق / لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "やさぐれる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد",
 "やさしい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / طَرِيّ, غَضّ ((عَنِ النَّبَاتَاتِ) غَيْرُ مُقَاوِم؛ يَسْهُلُ أَنْ يَمُوتَ بِظُرُوفِ النُّمُوِّ السَّيِّئَة) / حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما) / طَرِيّ, غَضّ (صغير السنّ وغير ناضج) / حَسَّاس, مُؤْلِم (يُؤْلِمُ عِنْدَ اللَّمْس)",
 "やさしげ": "مُؤَدَّب",
 "やさん": "دودة قز عملاقة (يرقة عثة ساتورنيد؛ تغزل كمية كبيرة من الحرير القوي في بناء شرنقتها)",
 "やざ": "ساجيتا (أي دودة سهمية من جنس ساجيتا)",
 "やざいく": "قذة",
 "やざま": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام)",
 "やし": "نَخْلَة / جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "やしき": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "やしきまち": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "やしざけ": "لاقبي",
 "やしっこ": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "やしっ子": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "やしない": "تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…) / غِذَاء / إِطْعَام / اِغْتِذَاء / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: لن نستمر في تغذية الانتقامات. / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "やしないおや": "عراب المعمودية (شخص يكفل شخصاً (الطفل الروحي) عند المعمودية)",
 "やしないご": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "やしないそだてる": "بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "やしなう": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تَبَنَّى / طَوَّرَ",
 "やしのき": "نَخْلَة",
 "やしのみ": "جَوْز الْهِنْد (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ) / نَارْجِيل\nمثال: نريد أن نأكل نبات جوز الهند.",
 "やしの木": "نَخْلَة",
 "やしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "やしまくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "やしゅ": "خُشُونَة, رِيفِيَّة (صفة كون الشخص ريفياً أو فجاً) / لاعب ميداني, مدافع (عضو في فريق الكريكيت يقوم بالدفاع (الالتقاط) بدلاً من الضرب) / لاعب ميداني, مدافع (عضو في فريق البيسبول يتواجد في الملعب للدفاع بدلاً من الضرب)",
 "やしゅせんたく": "خيار المدافع (لعبة تتم على كرة أرضية يختار فيها المدافع إخراج عداء متقدم بدلاً من الضارب)",
 "やしゆ": "دُهْن النَارَجِيل, دُهْن جَوْز الْهِنْد (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "やしょく": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / تَعَشَّى (تَنَاوَلَ العَشَاء)\nمثال: هل العشاء جاهز؟",
 "やしろ": "ضَرِيح",
 "やしん": "مَطْمَح / خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "やしんてき": "طَمُوح",
 "やじ": "تَافِه, لَا يُسَاوِي فَلْساً (شيء ذو قيمة قليلة جداً) / نعيق (صيحة خشنة عالية (كما للبومة)) / استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء)\nمثال: وعده لا يساوي فلساً",
 "やじうま": "فضولي, متطفل (شخص يحدق بفضول) / متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "やじうまこんじょう": "تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك)",
 "やじゅう": "حَيَوَان بَرِّيّ, حَيَوَان وَحْشِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "やじゅうしゅぎ": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
 "やじゅうは": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة؛ أثرت على التعبيريين)",
 "やじり": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "やじる": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "やじるし": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / فَائِدَة",
 "やじをとばす": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "やじを飛ばす": "مشط الكتان, مِندَف (مشط لفصل ألياف الكتان)",
 "やじん": "رَيْفِيّ, قَرَوِيّ / بلطجي, فتوة (رجل قاسٍ ووحشي) / مَدَنِيّ / مَدَنِيَّة",
 "やす": "رَخِيص / طَفْح, طَفْح جِلْدِيّ / رُمح ثلاثي الشعب (رمح ذو ثلاث شوكات أو أكثر؛ يستخدم لصيد الأسماك بالرمح (خاصة السلمون))",
 "やすあがり": "رَخِيص",
 "やすい": "رَخِيص / هَادِئ / طَمْأَنَ / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "やすうり": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة",
 "やすき": "سُهُولَة / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "やすく": "بِثَمَن بَخْس, بِرُخْص (مع القليل من إنفاق المال) / بتكلفة زهيدة, بشكل رخيص (بطريقة رخيصة أو مبتذلة)\nمثال: اشتريت هذه السيارة بثمن بخس جداً",
 "やすけ": "سُوشِي",
 "やすっぽい": "رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "やすで": "دُودَة أَلْفِيَّة, ذات الألف قدم",
 "やすぴか": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / صولجان المهرج (صولجان ساخر يحمله مهرج البلاط)",
 "やすませる": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "やすまる": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / راحة بال, سلام (غياب التوتر العقلي أو القلق)\nمثال: أخذ قسطاً من الراحة بجانب المسبح",
 "やすみ": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / عُطْلَة, إِجَازَة / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / سبات, سكون (حالة من الخمول الهادئ (ولكن ربما المؤقت))\nمثال: ثار البركان بعد قرون من الخمول",
 "やすみじかん": "رَدْب",
 "やすみちゅう": "مُغْلَق",
 "やすみどころ": "اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "やすみなく": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "やすむ": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / تَقَاعَدَ / اِعْتَزَلَ",
 "やすめる": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "やすやす": "بِسُهُولَة / بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "やすらい": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / مُتَحَيِّر, مُتَرَدِّد (يفتقر إلى حسم الشخصية؛ عاجز عن الفعل أو القرار بسرعة أو حزم)",
 "やすらう": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "やすらか": "سِلْمِيّ / مُسَالِم",
 "やすらかにおねむりください": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "やすらかにねむれ": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "やすらぎ": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "やすり": "مِلَفّ / مِبْرَد",
 "やすりがけ": "بُرَادَة",
 "やすりめ": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "やすりをかける": "مِلَفّ / مِبْرَد",
 "やすりを掛ける": "مِلَفّ / مِبْرَد",
 "やすり掛け": "بُرَادَة",
 "やすり目": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "やせ": "مُنَحِّف",
 "やせい": "همجية, وحشية (حالة طبيعية بربرية أو غير مهذبة بشكل مستعصٍ) / رعونة, طيش (ميل جامح لفعل ما يحلو للمرء) / ضراوة, عنف (خاصية كون الشيء جامحاً أو مضطرباً) / تحرر, جموح (شعور بحدة عاطفية مفرطة)\nمثال: كان لدى ليزا دائماً ميل للطيش / مُتَوَحِّش / بَرِّيّ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "やせいいぬ": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب المستأنسة لتمييزها عن ابن آوى أو الذئاب)",
 "やせいか": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "やせいせいぶつ": "اَلْحَيَاة اَلْبَرِّيَّة",
 "やせいぜつめつ": "يَع",
 "やせいてき": "مُتَوَحِّش / بَرِّيّ",
 "やせいどうぶつ": "حَيَوَان بَرِّيّ, حَيَوَان وَحْشِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "やせぎす": "نَحِيف",
 "やせざる": "لانغور (قرد آسيوي نحيل طويل الذيل)",
 "やせじし": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض)) / مُتَهَالِك, هَزِيل جِدًّا (شَدِيد النُّحُول خَاصَّةً بِسَبَب المَرَض أَوِ الجُوع أَوِ البَرْد)",
 "やせすぎ": "نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال)",
 "やせた": "رَفِيع, رَقِيق / ضعيف, ضعيفة / خَالٍ, عَدِيم (يفتقر بشكل كامل إلى شيء ما) / عَاقِر (لَا يُنْجِب ذُرِّيَّة؛ غَيْر قَادِر عَلَى الإِنْجَاب) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / أرض بور, أرض قاحلة (برية غير مأهولة لا تصلح للزراعة)\nمثال: الأراضي القاحلة في وسط أفريقيا",
 "やせっぽち": "فَزَّاعَة",
 "やせてもかれても": "بِالرَغْم مِن",
 "やせても枯れても": "بِالرَغْم مِن",
 "やせのおおぐい": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "やせほそる": "فَقَدَ وَزْن",
 "やせみえ": "مُنَحِّف",
 "やせる": "فَقَدَ وَزْن",
 "やせん": "سَاحَة حَرْب, سَاحَة مَعْرَكَة / خيار المدافع (لعبة تتم على كرة أرضية يختار فيها المدافع إخراج عداء متقدم بدلاً من الضارب)",
 "やせんしょく": "جراية ميدانية, حصة ميدانية (حصص غذائية تصرف للقوات العسكرية في الميدان)",
 "やせんとっか": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "やせんびょういん": "مستشفى ميداني (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "やせんほう": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "やせんほうへい": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "やせんりょうしょく": "جراية ميدانية, حصة ميدانية (حصص غذائية تصرف للقوات العسكرية في الميدان)",
 "やせ細る": "فَقَدَ وَزْن",
 "やせ過ぎ": "نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال)",
 "やぜん": "اَلْبَارِحَةَ",
 "やそ": "ثَمَانِينَ, ثَمَانُونَ / عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا. / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية. / فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "やそう": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "やそうきょく": "مقطوعة ليلية, نوكتورن (قطعة موسيقية غنائية تأملية (خاصة للبيانو))",
 "やそかい": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
 "やそきょう": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "やそよろず": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "やた": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "やたい": "عَرَبَةُ نَقْل, عَرَبَة / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / مَجْلِس",
 "やたいぼね": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك) / دعامة, ركن أساسي (مؤيد بارز)\nمثال: الإيمان هو ركيزته",
 "やたいみせ": "مَعْلِف, مُرَاح / بَسْطة",
 "やたいりょうり": "أَكْلُ الشَّارِع (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "やたがらす": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "やたけ": "مُتَوَهِّج كَالنَّار, مُتَّقِد (يَتَوَهَّج أَوْ يَلْمَع كَالنَّار) / حَارّ, مُتَوَقِّد (يتّسم بحماسة شديدة وقويّة) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "やたけに": "باندفاع, بتهور (بطريقة مندفعة أو متهورة؛ دون اتخاذ الحيطة)\nمثال: غالباً ما يتصرف باندفاع ويندم لاحقاً",
 "やたて": "جَعْبَة / ترس محمول (مأوى محمول مضاد للرصاص)",
 "やたのからす": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "やたら": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً / اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل)) / عَشْوَائِيّ, غَيْر مُمَيِّز (يُخْفِق فِي التَّمْيِيز بَيْنَ الأَشْيَاء)\nمثال: عادات قراءة عشوائية",
 "やたらめったら": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "やだ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / يَع",
 "やだま": "ذُخِيرَة",
 "やち": "مُسْتَنْقَع / ثَمَانِيَة آلَاف / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "やちとせ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "やちゅう": "فِي اَللَّيْلَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "やちょ": "خَنْزِير بَرِيّ",
 "やちょうかんさつ": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة)",
 "やちょく": "وردية ليلية (عمال يعملون أثناء الليل (مثل من منتصف الليل إلى 8 صباحًا)) / وردية ليلية (نوبة العمل أثناء الليل (مثل منتصف الليل إلى 8 صباحاً))",
 "やちよ": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / ثَمَانِيَة آلَاف",
 "やちん": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "やっか": "صَيْدَلِيَّة / صَيْدَلَة",
 "やっかい": "مُشْكِلَة, مَتاعِب / اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "やっかいごと": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "やっかいもの": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج)) / إِزْعَاج",
 "やっかみ": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やっかむ": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "やっかん": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "やっき": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "やっきょく": "صَيْدَلِيَّة / صَيْدَلَة\nمثال: 一番近い薬局はどこにありますか。 — أين أقرب صيدلية؟ / مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "やっきょくせい": "صَيْدَلِيّ, صَيْدَلَانِيّ",
 "やっきょくほう": "دستور الأدوية ((علم الأدوية) كتاب يحتوي على تجميع للمنتجات الصيدلانية مع صيغها وطرق تحضيرها)",
 "やっこ": "خَادِم, خَادِمَة / استعباد (فعل اتخاذ الأسرى عبيداً) / أسر, استعباد (حالة كونه عبداً)\nمثال: لذا كل عبد يحمل في يده القوة لإلغاء أسره / هُوَ",
 "やっこい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "やっこさん": "هُوَ",
 "やっさもっさ": "بشكل عشوائي, هرج ومرج (بشكل عشوائي وغير منظم) / فَوْضَوِيّ, مُرْتَبِك (بعجلة مُفرطة وفوضى) / عَشْوَائِيّ, فَوْضَوِيّ (يفتقر لنظام أو تنظيم مرئي)\nمثال: الكتب مكدسة بشكل عشوائي",
 "やっせんぼ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)",
 "やった": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やったあ": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やったー": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やっちまう": "بهلوان, مهرج (شخص يمتع الآخرين من خلال التصرفات السخيفة والمضحكة) / أحمق, غبي (رجل غبي وغير كفء) / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "やっつ": "ثَمَانِيَة, تمانية / ثَمَانِيَةٌ / اَلسَّاعَة اَلثَّانِيَة",
 "やっつける": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "やっていく": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "やってのける": "نَجَحَ",
 "やって行く": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "やっと": "أَخِيرًا / بِٱلْكَاد",
 "やっとかめ": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "やっとか目": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "やっとこ": "أَخِيرًا / بِٱلْكَاد / كَلْبَتَان",
 "やっとこさ": "أَخِيرًا / بِٱلْكَاد",
 "やっとこせ": "أَخِيرًا / بِٱلْكَاد",
 "やっとのおもいで": "أَخِيراً",
 "やっとの思いで": "أَخِيراً",
 "やっぱ": "أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ / سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "やっぱし": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ / سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "やっぱり": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ / سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "やっほー": "صيحة تنبيه (صيحة لجذب الانتباه)\nمثال: أطلق صيحة عالية لكن لم يسمعه أحد",
 "やっ付ける": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "やつ": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / هُوَ / ثَمَانِيَة, تمانية / ثَمَانِيَةٌ / اَلسَّاعَة اَلثَّانِيَة",
 "やつあたりに": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "やつおりばん": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "やつがしら": "يَام / هُدْهُد",
 "やつがれ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "やつこ": "عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي)) / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / وصيف (في العصور الوسطى، شاب يعمل كمرافق لفارس كأول مرحلة في التدريب للفروسية) / أفاق, محتال (شخص مخادع ولا يمكن الوثوق به)",
 "やつこらま": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "やつどき": "اَلسَّاعَة اَلثَّانِيَة",
 "やつばら": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "やつめ": "ثَامِن, ثَامِنَة / ثُمْن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط) / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت / هُوَ",
 "やつめうなぎ": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "やつら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "やつれ": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض))",
 "やづつ": "جَعْبَة",
 "やと": "قُوَاع, أَرْنَب بَرِّيَّة",
 "やとい": "مُوَظَّف, مُوَظَّفَة",
 "やといいれ": "خِطْبَة, خُطُوبَة",
 "やといいれる": "وَظَّفَ",
 "やといぐち": "مَهَمَّة / عَمَل, وَظِيفَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "やといにん": "مُوَظَّف, مُوَظَّفَة",
 "やといぬし": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "やとう": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / وَظَّفَ / مِيثَاق / قاطع طريق, لص مسلح (لص مسلح يكون (عادة) عضواً في عصابة)",
 "やとうぎいん": "عضو برلمان, نائب (عضو منتخب في البرلمان البريطاني: عضو في مجلس العموم)",
 "やとうむし": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى الأرض)",
 "やとびょう": "تولاريميا, حمى الأرانب (مرض شديد العدوى يصيب القوارض (وخاصة الأرانب والسناجب) وينتقل أحيانًا إلى البشر عن طريق القراد أو الذباب أو عن طريق التعامل مع الحيوانات المصابة)",
 "やとらに": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "やとわれ": "عَارِض, مُسْتَأْجَر (مستأجر للاستخدام المؤقت الحصري لمجموعة من المسافرين) / مَأْجُور, مُسْتَأْجَر (تمّ استئجار خدماته مقابل أجر)\nمثال: طائرة مستأجرة",
 "やど": "إِقَامَة / مَجْلِس / أَبْوَاب, بَاب",
 "やどかり": "سرطان ناسك (قشريات بحرية صغيرة ناعمة الجسم تعيش في أصداف بطنيات القدم المهجورة) / مُسْتَأْجِر",
 "やどす": "مَجْلِس / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "やどちん": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "やどなし": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "やどぬし": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا. / مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "やどや": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "やどり": "إِقَامَة",
 "やどりぎ": "دِبْق, نَبَات طُفَيْلِيّ (لصق أو التصق بشيء؛ التصق بشيء ولم يفارقه) / نبات طفيلي (نبات يعيش على نبات آخر ويحصل منه على الغذاء العضوي)",
 "やどりぎつぐみ": "سمنة الدبق (سمنة أوروبية كبيرة تتغذى على توت الدبق)",
 "やどりばえ": "ذبابة تاشينا (ذبابة شائكة تعيش يرقاتها بشكل طفيلي في اليرقات والحشرات الأخرى؛ مهمة في مكافحة الحشرات الضارة)",
 "やどりばち": "زِنْبَار طُفَيْلِيّ",
 "やどりバチ": "زِنْبَار طُفَيْلِيّ",
 "やどる": "سَكَنَ, أَقَامَ (قَرَّ وهَدَأ، ضد اِضْطَرَبَ؛ وَطَنَ، يستخدم سكن عند الحديث عن البيت أو الدار ووطن عن الحديث عن البلاد أو المدينة)\nمثال: كان زيري بسكن هناك. / مَكَثَ, بَقِيَ / إِقَامَة",
 "やどろく": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "やな": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ)",
 "やなぎ": "صَفْصَاف, غَرَب / صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "やなぎのしたにいつもどじょうはいない": "هُنَاك, يُوجَد",
 "やなぎのしたにいつもどじょうはおらぬ": "هُنَاك, يُوجَد",
 "やなぎはみどり、はなはくれない": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "やなぎらん": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية أرجوانية)",
 "やに": "رَاتِينَج, صُرْع / قَطْرَان (قَطِرَان: مادة سوداء سائلة لزجة القوام) / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "やにさしがめ": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها يمتص دماء الثدييات)",
 "やにょうしょう": "تبول في الفراش (سلس البول أثناء النوم؛ شائع بشكل خاص عند الأطفال (الذين عادة ما يتجاوزونه مع النمو))",
 "やにわに": "فَوْرًا, حَالًا / فَجْأَةً",
 "やぬし": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "やね": "سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "やねいた": "لافتة مهنية (لافتة صغيرة خارج مكتب محامٍ أو طبيب مثلاً) / حصى الشاطئ, شينغل (حصى شاطئ خشن من أحجار صغيرة وحصى مصقولة بالماء (أو امتداد من الشاطئ مغطى بهذا الحصى)) / ألواح تسقيف خشبية (مادة بناء تستخدم ككساء أو تسقيف)",
 "やねうら": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل غالبا ما يكون سقفها منخفضا وتشرف على السَطْح)\nمثال: عادوا إلى العلية.",
 "やねうらべや": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل غالبا ما يكون سقفها منخفضا وتشرف على السَطْح)\nمثال: عادوا إلى العلية.",
 "やねまど": "نافذة سقفية (امتداد جملوني مبني من سقف مائل لاستيعاب نافذة عمودية)",
 "やねや": "سقّاف, صانع الأسقف (حرفي يركب أو يصلح الأسقف)",
 "やのね": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "やはぎ": "قذة",
 "やはずえんどう": "وَزْن فَارِغ",
 "やはずもよう": "تعشيق مائل, نمط عظم السمكة (نمط من أعمدة خطوط متوازية قصيرة تميل جميع خطوط العمود الواحد في اتجاه واحد وتميل خطوط الأعمدة المجاورة في الاتجاه الآخر؛ يستخدم في النسيج والبناء…)",
 "やはり": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ / سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "やはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "やば": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "やばい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / مَجْنُون, مَخْبُول",
 "やばす": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف)",
 "やばん": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ / النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "やばんじん": "هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ",
 "やひ": "بَذِيء",
 "やぶ": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد) / بَطْبَطَة, زَبْط / زَبَطَ",
 "やぶい": "بَطْبَطَة, زَبْط / زَبَطَ",
 "やぶいしゃ": "بَطْبَطَة, زَبْط / زَبَطَ",
 "やぶかげ": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد)",
 "やぶからぼうに": "فَجْأَةً, عَلَى حِينِ غِرَّةٍ",
 "やぶく": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "やぶける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "やぶこぎ": "مُتَرَبِّصٌ فِي كَمِين (يكمن في انتظار الفريسة أو العدوّ)",
 "やぶさか": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "やぶさかでない": "حَاضِر, مُسْتَعِدّ / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "やぶさかではない": "حَاضِر, مُسْتَعِدّ / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "やぶしらず": "مَتَاهَة",
 "やぶにらみ": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "やぶのうさぎ": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "やぶらん": "بيج بلو (قنبلة متشظية موثوقة وفتاكة تزن 15000 رطل تنفجر فوق الأرض مباشرة بنصف قطر كبير؛ وهي أكبر قنبلة تقليدية موجودة؛ استخدمت في أفغانستان)",
 "やぶる": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق. / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "やぶれ": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "やぶれかぶれ": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "やぶれめ": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "やぶれる": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "やぶん": "مَسَاء",
 "やぶワラビー": "باديميلون (ولب بني محمر صغير يعيش في المناطق الشجرية في أستراليا وغينيا الجديدة)",
 "やぶ医者": "بَطْبَطَة, زَبْط / زَبَطَ",
 "やべえ": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "やべー": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "やほう": "مدفعية ميدانية (مدفعية متحركة (غير المضادة للطائرات) تستخدمها الجيوش في الميدان (خاصة للدعم المباشر لقوات الخطوط الأمامية))",
 "やほー": "صيحة تنبيه (صيحة لجذب الانتباه)\nمثال: أطلق صيحة عالية لكن لم يسمعه أحد",
 "やぼ": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "やぼう": "مَطْمَح",
 "やぼったい": "غير مواكب للموضة, قديم الطراز (لا يتفق مع أو لا يتبع الموضة الحالية) / خَارِج المُوضَة, غَيْر عَصْرِيّ (غير رائج ويُعتبر غير جذاب أو قديم الطراز)\nمثال: ملابس غير عصرية",
 "やぼてん": "جَلَافَة, غَلَاظَة (انعدام الأناقة بسبب كون الشخص غليظاً وجلفاً) / خشونة, غلظة (أسلوب شخص وقح أو غير حساس)",
 "やま": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل. / لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ / غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة / كَوْمَة",
 "やまあい": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "やまあらし": "نَيْص, دُلْدُل",
 "やまあり": "نمل الخشب (نمل أوروبي بني محمر يعيش عادة في تلال النمل في الغابات)",
 "やまあるき": "تَمَشٍّ, تَنَزُّه",
 "やまい": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / ضَعْف",
 "やまいたち": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "やまいぬ": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب المستأنسة لتمييزها عن ابن آوى أو الذئاب)",
 "やまいのとこ": "سرير المريض, فراش المرض (السرير الذي يرقد عليه المريض)",
 "やまうずら": "حَجَل, قبج (طَائِرٌ مِنْ فَصيلَةِ التَّدْرُجِيَّاتِ، مِنْ رُتْبَةِ الدَّجاجِيّاتِ، رَمادِيُّ اللَّوْنِ، أَحْمَرُ المِنْقارِ والسَّاقَيْنِ…؛ حَجَلُ: الذَّكَرُ من القَبَجِ، الواحدةُ: حَجَلَةٌ)\nمثال: إن الإسم \"سكورة\" مشتق من كلمة \"تاسكورت\" الذي يعني حجلة بالأمازيغية.",
 "やまうるし": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "やまおとこ": "عِمْلَاق",
 "やまかい": "أُخْدُود (أخْدُودُ)",
 "やまかじ": "حريق غابة (حريق غير منضبط في منطقة حرجية)",
 "やまかっこ": "زاوية حديدية, كتيفة زاوية / قوس زاوية (إحدى علامتي الترقيم  المستخدمة في برمجة الكمبيوتر وتستخدم أحياناً لتطويق مادة نصية)",
 "やまかん": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "やまが": "شاليه",
 "やまがた": "يَامَاغَاتَا / شيفرون / شارة الرتبة, شريط رتبة",
 "やまがたそでしょう": "شيفرون / شارة الرتبة, شريط رتبة",
 "やまがたもん": "شيفرون / شارة الرتبة, شريط رتبة",
 "やまがっこ": "زاوية حديدية, كتيفة زاوية / قوس زاوية (إحدى علامتي الترقيم  المستخدمة في برمجة الكمبيوتر وتستخدم أحياناً لتطويق مادة نصية)",
 "やまがらす": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / أَسْمَر",
 "やまくじら": "خَنْزِير بَرِيّ",
 "やまくずれ": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "やまぐち": "يَامَاغُوتْشِي",
 "やまぐるま": "شجرة العجلة, شجرة عجلة النار (شجرة من شرق أستراليا تزرع على نطاق واسع كشجرة ظل ولأوراقها اللامعة وعناقيدها الدائرية من الزهور الحمراء إلى البرتقالية القرمزية المبهرجة)",
 "やまげら": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "やまごもり": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "やまざる": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "やまし": "مُضَارِب / مُغَامِر, مُغَامِرَة / منقّب (شخص يستكشف منطقة بحثاً عن رواسب معدنية)",
 "やましぎ": "دجاجة الأرض الأوراسية (دجاجة أرض مهاجرة من العالم القديم قصيرة الساقين وطويلة المنقار)",
 "やましごと": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "やましまうま": "حمار الزرد الجبلي (حمار زرد ضيق الخطوط شبه منقرض يعيش في جنوب أفريقيا)",
 "やまじお": "ملح صخري, هاليت (كلوريد الصوديوم البلوري الموجود طبيعياً)",
 "やますそ": "سَفْح (لها معانٍ متعددة تتعلق بالانصباب والسكب؛ أراقَ دمًا أو ماءً)\nمثال: كان ذلك الحوض في سفح الجبل.",
 "やまたかぼう": "قبعة بولر, قبعة مستديرة (قبعة لباد مستديرة وصلبة ذات حافة ضيقة)",
 "やまたかぼうし": "قبعة بولر, قبعة مستديرة (قبعة لباد مستديرة وصلبة ذات حافة ضيقة)",
 "やまだし": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "やまだち": "قَاطِع طَرِيق / صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "やまつなみ": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "やまづみ": "كَوْمَة",
 "やまと": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "やまといも": "كرمة القرفة, يام صيني (كرمة صينية قوية التحمل متوطنة في الولايات المتحدة وتزرع كمتسلقة زينة لأوراقها اللامعة على شكل قلب برائحة القرفة وفي المناطق الاستوائية لدرناتها…)",
 "やまとうた": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: الجيش يوحد الشعب.",
 "やまとごと": "عَرَبَة",
 "やまとのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "やまともじ": "كَانَا",
 "やまない": "دَائِمًا, أَبَدًا / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "やまないあめはない": "هُنَاكَ, يُوجَدُ",
 "やまない雨はない": "هُنَاكَ, يُوجَدُ",
 "やまなし": "يَامَانَاشِي",
 "やまなみ": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "やまなり": "مُنْثَنٍ",
 "やまにれ": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات) / دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "やまねこ": "ضَيْوَن",
 "やまねこざ": "وَشَق",
 "やまねこそうぎ": "إِضْرَاب عَشْوَائِيّ, إِضْرَاب غَيْر مُصَرَّح بِه (إضراب يقوم به العمال دون موافقة مسؤولي نقابتهم)",
 "やまねこスト": "إِضْرَاب عَشْوَائِيّ, إِضْرَاب غَيْر مُصَرَّح بِه (إضراب يقوم به العمال دون موافقة مسؤولي نقابتهم)",
 "やまねこ座": "وَشَق",
 "やまねずみ": "جرذ الأرض, مرموط خنزيري (مرموط بني محمر من أمريكا الشمالية)",
 "やまのいただき": "قِمَّة / إِجْتِمَاع قِمَّة",
 "やまのせ": "سلسلة جبال",
 "やまのぼり": "تسلق الجبال (نشاط تسلق الجبال)",
 "やまのよう": "سَخِيّ, غَزِير (يُوفِّر إمدادًا وافرًا وغزيرًا) / كَثِير, مُتَوَافِر (موجود بأعداد أو كمّيّات كبيرة) / غَزِير الإِنْتَاج, وَافِر (يُنْتِجُ بِوَفْرَة وَغَزَارَة)",
 "やまはい": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط",
 "やまははこ": "أناغاليس لؤلؤي (نبات خالد أمريكي له أوراق بشعيرات صوفية ناعمة ورؤوس عذقية بقنابات بيضاء لؤلؤية)",
 "やまば": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "やまばん": "جندي صاعقة, فدائي (عضو في وحدة عسكرية مدربة كقوات اقتحام لشن غارات خاطفة) / حارس الغابات, مكافح حرائق الغابات (مسؤول عن إدارة وحماية منطقة من الغابات) / جَوَّال تِكْساس, حارِس تِكْساس (عضو في دورية الطرق السريعة بولاية تكساس؛ (تاريخياً) رجل قانون يركب الخيل لحفظ النظام على الحدود)",
 "やまびこ": "صَدًى",
 "やまびと": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "やまふじ": "ستارية حريرية, ويستيريا حريرية (ستارية من الصين لها زهور بيضاء)",
 "やまふだ": "ظَهْر, سَطْح (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "やまぶき": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "やまぶきいろ": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "やまべ": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "やまま": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "やままゆ": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني) / بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "やままゆが": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني) / بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "やまみず": "مَنْظَر طَبِيعِيّ, مَنْظَر",
 "やまみち": "درب جبلي (مسار عبر منطقة جبلية)",
 "やまめ": "أَرْمَلَة",
 "やまもと": "لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "やまもも": "آس شمعي (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "やまもり": "جندي صاعقة, فدائي (عضو في وحدة عسكرية مدربة كقوات اقتحام لشن غارات خاطفة) / حارس الغابات, مكافح حرائق الغابات (مسؤول عن إدارة وحماية منطقة من الغابات) / جَوَّال تِكْساس, حارِس تِكْساس (عضو في دورية الطرق السريعة بولاية تكساس؛ (تاريخياً) رجل قانون يركب الخيل لحفظ النظام على الحدود) / كَوْمَة",
 "やまやま": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل. / بشكل كبير / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "やまよりおおきないのししはでぬ": "هُنَاك, يُوجَد",
 "やまよりおおきなししはでぬ": "هُنَاك, يُوجَد",
 "やまる": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "やまわさび": "فُجْل حَارّ (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "やまわろ": "أَعْوَر, عَوْرَاء",
 "やまをかける": "قِمَار / قَامَرَ",
 "やまをはる": "قِمَار / قَامَرَ",
 "やまガール": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "やまビーバー": "قندس الجبل (قارض ليلي ضخم يحفر الجحور في مرتفعات ساحل المحيط الهادئ لأمريكا الشمالية؛ وهو أكثر القوارض الحية بدائية)",
 "やみ": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام. / ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم) / سِرِّيَّة / سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "やみあがり": "نَقَاهَة / نَقَاهَة, فَتْرَةُ نَقَاهَة",
 "やみいち": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "やみいちば": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "やみうち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "やみがたい": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "やみきん": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみきんゆう": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみくも": "مُتَهَوِّر",
 "やみごめ": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみしじょう": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "やみしょうぐん": "صانع الملوك (شخص مهم يمكنه إيصال القادة إلى السلطة من خلال ممارسة النفوذ السياسي)\nمثال: كان إيرل وارويك أول صانع للملوك",
 "やみしょうにん": "تاجر سوق سوداء (شخص يشارك بشكل غير قانوني في تجارة السلع النادرة أو الخاضعة للرقابة)",
 "やみそうば": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみとりひき": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみね": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみぶっし": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみや": "تاجر سوق سوداء (شخص يشارك بشكل غير قانوني في تجارة السلع النادرة أو الخاضعة للرقابة)",
 "やみやみ": "بِسُهُولَة",
 "やみよのつぶて": "لعب النرد (لعب الكرابس) / مجازفة غير مضمونة (مغامرة محفوفة بالمخاطر وغير مؤكدة)\nمثال: أصبح القبول في الكلية التي تختارها مجازفة غير مضمونة",
 "やみよのてっぽう": "لعب النرد (لعب الكرابس) / مجازفة غير مضمونة (مغامرة محفوفة بالمخاطر وغير مؤكدة)\nمثال: أصبح القبول في الكلية التي تختارها مجازفة غير مضمونة",
 "やみよのともしび": "ضَرْبَة حَظّ (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه) / مُصَادَفَة سَعِيدَة / مِنْحَة إِلٰهِيَّة\nمثال: تلقى مناد ضربة.",
 "やみアカ": "وَسَائِل تَوَاصُل اِجْتِمَاعِيّ, سُوشَل مِيدْيَا",
 "やみブローカー": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみルート": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やみ屋": "تاجر سوق سوداء (شخص يشارك بشكل غير قانوني في تجارة السلع النادرة أو الخاضعة للرقابة)",
 "やみ米": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "やむ": "زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / مَرِضَ, أُصِيبَ بِالْمَرَض (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "やむえず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "やむおえない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむかたなし": "هُنَاكَ, يُوجَدُ",
 "やむない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむなく": "اضْطِرَارًا, بِالضَّرُورَة (عن طريق الضرورة؛ بحكم الظروف)",
 "やむなし": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむにやまれず": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "やむにやまれない": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "やむにやまれぬ": "قَاهِر, لَا يُقَاوَم (يميل إلى الإقناع بقوّة البرهان) / دَافِع, قَاهِر (يدفع أو يُرغم بقوة لا تُقاوم)",
 "やむをえず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "やむをえない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむをえぬ": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむをえまい": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむをえません": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむをえん": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむを得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "やむを得ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむを得ぬ": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむを得まい": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむを得ません": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむを得ん": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむ得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "やむ方なし": "هُنَاكَ, يُوجَدُ",
 "やむ終えない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やむ負えない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やめさせる": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "やめておく": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "やめとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "やめにする": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "やめる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / أَلْغَى, أَبْطَلَ / اِسْتَقَالَ / بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / مَرِيض, مُتَأَثِّر بِعُمْق (متأثر تأثرًا عميقًا بشعور قوي) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / أَلِمَ, وَجِعَ (الوَجَع)\nمثال: ذلك سيهيج الجرح.",
 "やもうえない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やもうしょう": "عشى, عشى ليلي (عدم القدرة على الرؤية بوضوح في الضوء الخافت؛ بسبب نقص فيتامين أ أو اضطراب في الشبكية)",
 "やもう得ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "やもお": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "やもしれず": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "やもしれない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "やもしれぬ": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "やもめ": "أَرْمَلَة / أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "やもめぐらし": "ترمل (حالة كون المرأة أرملة لم تتزوج مرة أخرى) / ترمل (فترة حياة المرأة عندما تكون أرملة)",
 "やもめ暮らし": "ترمل (حالة كون المرأة أرملة لم تتزوج مرة أخرى) / ترمل (فترة حياة المرأة عندما تكون أرملة)",
 "やもり": "وَزَغَة",
 "やも知れず": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "やも知れない": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "やも知れぬ": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "やや": "قَلِيلًا / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / يَع / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ややあって": "قَلِيلًا",
 "ややおおきい": "كَبِير نَوْعًا مَا (كبير إلى حدٍّ ما)",
 "ややからくち": "شِبْه جَافّ (جافّ إلى حدٍّ ما)",
 "ややこ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ややこい": "مُعَقَّد, مُرَكَّب",
 "ややこしい": "مُعَقَّد, مُرَكَّب",
 "ややちいさい": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "ややっこしい": "مُعَقَّد, مُرَكَّب",
 "やや大きい": "كَبِير نَوْعًا مَا (كبير إلى حدٍّ ما)",
 "やや小さい": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "やや辛口": "شِبْه جَافّ (جافّ إلى حدٍّ ما)",
 "やゆ": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة)",
 "やゆう": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "やよいじん": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "やよろず": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "やらい": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "やらかい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "やらかす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "やらしい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة / شَهْوَانِيّ, شَبِق",
 "やらす": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "やらずのあめ": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "やらずの雨": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "やらずぶったくり": "سرقة كبرى, نهب (فعل السرقة)",
 "やらずぼったくり": "سرقة كبرى, نهب (فعل السرقة)",
 "やらずもがな": "أَيْضًا",
 "やらせる": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "やり": "رُمْح, حَرْبَة (عُود طَوِيلٌ فِي رَأْسِهِ حَرْبَة يُطعَن بِهَا الْعَدُوُّ، يُجمع جَمْع تَكْسِير على رِمَاح؛ الْفَقْرُ وَالْفَاقَةُ. اسْتِخْدَامٌ قَدِيمٌ)\nمثال: راس الرمح كان مغموسا في سم قاتل. / مِزْرَاق / مشرط (سكين جراحي بشفرة مدببة ذات حدين؛ يستخدم للثقب والشقوق الصغيرة) / رمح (قضيب طويل مدبب يستخدم كأداة أو سلاح) / حربة صيد, رمح الصيد (أداة ذات عمود ورأس شائك تستخدم لصيد الأسماك) / سَاخِر, مُسْتَهْزِئ (يُسيء لفظياً؛ يُعبِّر عن الازدراء أو السخرية) / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية) / لغة بويي (فرع من لغات تاي، يُتحدث به في جنوب وجنوب غرب مقاطعة قويتشو ومقاطعة يونان في الصين)",
 "やりあう": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "やりぃ": "لغة بويي (فرع من لغات تاي، يُتحدث به في جنوب وجنوب غرب مقاطعة قويتشو ومقاطعة يونان في الصين)",
 "やりぃっ": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やりおえる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "やりかえす": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "やりかけ": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "やりかける": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)",
 "やりかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "やりかんな": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "やりがいのある": "جَدِيرٌ بِالاهْتِمَامِ (ذُو قِيمَةٍ كَافِيَةٍ تُبَرِّرُ اسْتِثْمَارَ الوَقْتِ أَوِ الاهْتِمَامِ)",
 "やりがんな": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "やりきれない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "やりくち": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "やりくり": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "やりこい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "やりこなす": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "やりこみ": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "やりこめる": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "やりさき": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "やりすぎ": "إفراط, مبالغة (أي جهد يبدو أنه يذهب أبعد مما هو ضروري لتحقيق هدفه) / إفراط في التسلح, قوة مفرطة (القدرة على تدمير هدف بأسلحة تزيد عن الحاجة (خاصة الأسلحة النووية))",
 "やりすて": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "やりずらい": "صَعْب",
 "やりそこない": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "やりそこなう": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "やりそんじ": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "やりそんじる": "خطأ فادح, زلة (خطأ محرج)",
 "やりそんずる": "خطأ فادح, زلة (خطأ محرج)",
 "やりたいほうだい": "اِنْعِدام مَسْؤُولِيَّة",
 "やりたい放題": "اِنْعِدام مَسْؤُولِيَّة",
 "やりだし": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / صاري المقدمة المائل, عمود المقدمة (صارٍ يبرز من مقدمة السفينة)",
 "やりだす": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "やりだま": "ضَحِيَّة / أُضْحِيَّة",
 "やりちん": "مُسْتَهْتَر",
 "やりっぱなし": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "やりっ放し": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "やりつかい": "رَمَّاح (جمع للاسم رُمْح)",
 "やりづらい": "صَعْب",
 "やりて": "طَمُوح, مُثَابِر (شخص يتقدم مساره المهني بسرعة؛ شخص ذو همة عالية) / فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / مُعْطٍ",
 "やりとおす": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "やりとげる": "أَدَّى",
 "やりとり": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "やりなおしさいばん": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي أصدرت المحكمة حكماً أو قراراً بشأنها من قبل نفس المحكمة؛ يحدث عندما يتبين…)",
 "やりなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "やりなげ": "مِزْرَاق",
 "やりにくい": "صَعْب",
 "やりにげ": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "やりぬく": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "やりのほさき": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "やりはじめる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "やりば": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "やりまん": "عَاهِرَة (امرأة تتاجر بجسدها؛ امرأة تقدم خدمات جنسية بمقابل مادي)\nمثال: قتل سامي عاهرة.",
 "やりみず": "جَدْوَل / تَيَّار / تَدَفّقَ / ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "やりもち": "كومبارس, ممثل إضافي (ممثل ثانوي يظهر في مشاهد الحشود)",
 "やりらふぃ〜": "ساهِر, مُرْتاد الحَفَلات (شخص يحضر حفلة)\nمثال: كانت القاعة مزدحمة بفيض من مرتادي الحفلات",
 "やりらふぃー": "ساهِر, مُرْتاد الحَفَلات (شخص يحضر حفلة)\nمثال: كانت القاعة مزدحمة بفيض من مرتادي الحفلات",
 "やりコン": "لقاء مع غريب, موعد مدبر (موعد غرامي مع شخص غريب) / رفيق موعد أعمى (مشارك في موعد أعمى (شخص تقابله لأول مرة في موعد))\nمثال: هي لا تذهب أبداً في مواعيد مدبرة",
 "やりマン": "عَاهِرَة (امرأة تتاجر بجسدها؛ امرأة تقدم خدمات جنسية بمقابل مادي)\nمثال: قتل سامي عاهرة.",
 "やりー": "لغة بويي (فرع من لغات تاي، يُتحدث به في جنوب وجنوب غرب مقاطعة قويتشو ومقاطعة يونان في الصين)",
 "やり出し": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / صاري المقدمة المائل, عمود المقدمة (صارٍ يبرز من مقدمة السفينة)",
 "やり出す": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "やり切れない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "やり取り": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "やり口": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "やり合う": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "やり場": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "やり始める": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "やり手": "طَمُوح, مُثَابِر (شخص يتقدم مساره المهني بسرعة؛ شخص ذو همة عالية) / فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / مُعْطٍ",
 "やり投": "مِزْرَاق",
 "やり投げ": "مِزْرَاق",
 "やり抜く": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "やり捨て": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "やり損い": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "やり損ない": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "やり損なう": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "やり方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "やり水": "جَدْوَل / تَيَّار / تَدَفّقَ / ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "やり玉": "ضَحِيَّة / أُضْحِيَّة",
 "やり直し裁判": "إعادة المحاكمة (محاكمة جديدة يتم فيها إعادة فحص القضايا التي تم التقاضي بشأنها بالفعل والتي أصدرت المحكمة حكماً أو قراراً بشأنها من قبل نفس المحكمة؛ يحدث عندما يتبين…)",
 "やり直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "やり終える": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "やり繰り": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "やり辛い": "صَعْب",
 "やり込み": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "やり込める": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "やり返す": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "やり逃げ": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "やり通す": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "やり遂げる": "أَدَّى",
 "やり過ぎ": "إفراط, مبالغة (أي جهد يبدو أنه يذهب أبعد مما هو ضروري لتحقيق هدفه) / إفراط في التسلح, قوة مفرطة (القدرة على تدمير هدف بأسلحة تزيد عن الحاجة (خاصة الأسلحة النووية))",
 "やり難い": "صَعْب",
 "やる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / أَدَّى / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "やるき": "إرَادَة / رَغْبَة, إرَادَة",
 "やるせない": "بَائِس",
 "やる気": "إرَادَة / رَغْبَة, إرَادَة",
 "やれ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به) / تلف, فساد (عملية التحول إلى شيء تالف أو فاسد) / الفاسد, تلف (الكمية التي فسدت)\nمثال: كان إفسادها لثوبي متعمداً",
 "やれめ": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "やろ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "やろう": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير. / بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا. / شَيْخ, عَجُوز",
 "やろうども": "اِبْن زِنًى, بِنْت زِنًى (الولد الذكر)\nمثال: هو له ابن صغير.",
 "やわ": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "やわい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / ضَعِيف",
 "やわたしらず": "مَتَاهَة",
 "やわたのやぶしらず": "مَتَاهَة",
 "やわやわ": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "やわら": "جُودُو",
 "やわらか": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "やわらかい": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / مُؤَدَّب / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / مَرِن",
 "やわらかさ": "نُعُومَة",
 "やわらかみ": "نُعُومَة",
 "やわらかめ": "شِبْه لَيِّن, لَيِّن نَوْعًا ما (بَيْن اللِّين والصَّلابَة؛ طَرِيّ إلى حَدٍّ ما)",
 "やわらぎ": "تَخْفِيف / تَسْكِين",
 "やわらぐ": "أَهْدَأَ, هَدَّأَ",
 "やわらげる": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "やん": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "やんごとない": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "やんごとなき": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "やんちゃ": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُشَاغِب / انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه / جَرِيء, جَسُور",
 "やんちゃぼうず": "مُشَاغِب",
 "やんちゃん": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُشَاغِب / انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه / جَرِيء, جَسُور",
 "やんちゃ坊主": "مُشَاغِب",
 "やんま": "رتّاء (شخص يصلح (الملابس) بالرتق) / يَعْسُوب / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "やんや": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "やんややんや": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "やんわり": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "やーい": "يَاه, اسمع / هَلَا",
 "やーさん": "يَاكُوزَا",
 "やーだ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / يَع",
 "やーやー": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / يَاه, اسمع / هَلَا / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "や否や": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "や座": "ساجيتا (أي دودة سهمية من جنس ساجيتا)",
 "ゆ": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ゆあか": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "ゆあつ": "ضغط الزيت (الضغط الذي يحافظ على الزيت على الأجزاء المتحركة لمحرك الاحتراق الداخلي)",
 "ゆあつけい": "ضغط الزيت (الضغط الذي يحافظ على الزيت على الأجزاء المتحركة لمحرك الاحتراق الداخلي) / نظام هيدروليكي (آلية تعمل بالمقاومة أو الضغط المنقول عندما يتم دفع سائل عبر فتحة صغيرة أو أنبوب)",
 "ゆあつけいとう": "نظام هيدروليكي (آلية تعمل بالمقاومة أو الضغط المنقول عندما يتم دفع سائل عبر فتحة صغيرة أو أنبوب)",
 "ゆあつしき": "هيدروليكي (من أو متعلق بدراسة الهيدروليكا (ميكانيكا السوائل)) / هيدروليكي (يتحرك أو يعمل أو يتأثر بواسطة سائل (ماء أو زيت))\nمثال: مهندس هيدروليكي",
 "ゆあつショベル": "حفارة, مجرفة آلية (آلة للحفر)",
 "ゆあつブレーキ": "مكبح هيدروليكي (نظام مكابح تحرك فيه دواسة الفرامل مكبساً في الأسطوانة الرئيسية؛ ثم يطبق سائل الفرامل قوة كبيرة على وسادات الفرامل أو الأحذية)",
 "ゆあつプレス": "مكبس هيدروليكي (مكبس تنتقل فيه القوة المطبقة بواسطة مكبس على مساحة صغيرة عبر الماء إلى مكبس آخر ذي مساحة كبيرة)",
 "ゆあつポンプ": "كبش هيدروليكي, مضخة هيدروليكية (مضخة مياه تستخدم الطاقة الحركية للمياه المتدفقة لدفع جزء صغير من تلك المياه إلى خزان بمستوى أعلى)",
 "ゆあつモーター": "محرك هيدروليكي (مشغل ميكانيكي يحول الضغط والتدفق الهيدروليكي إلى عزم دوران وإزاحة زاوية (دوران))",
 "ゆあみ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "ゆいいつ": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "ゆいいつしん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ゆいいつしんきょう": "تَوْحِيد",
 "ゆいいつふじ": "فَرِيد, فَذّ",
 "ゆいいつむに": "فَرِيد, فَذّ",
 "ゆいいつむひ": "فَرِيد, فَذّ",
 "ゆいかた": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "ゆいがい": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "ゆいがどくそん": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "ゆいがみ": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "ゆいがろん": "وَحْدَة الْأَنَا",
 "ゆいごう": "إرَادَة / رَغْبَة, إرَادَة",
 "ゆいごん": "إرَادَة / رَغْبَة, إرَادَة",
 "ゆいごんしっこうしゃ": "مُنْجِز, مُنَفِّذ / وَصِيّ, وَلِيّ (في : في حال وفاة أحد الوالدين، يتم تعيين الوصي بالإتفاق أو بموجب القانون ليكون مسؤولا عن قاصر أو عن إنسان عاجز غير كفء…؛ في : المؤسسة أو الشخص الذي تَثِقُ فيه وَتُأَمِّنُهُ على أموالك وممتلكاتك، وهو الذي يدير أموال الوصية بعد الوفاة)\nمثال: مات من دون أن يترك وصية.",
 "ゆいごんしゃ": "مُوصٍ (شخص يكتب وصية)",
 "ゆいごんしょ": "إرَادَة / رَغْبَة, إرَادَة",
 "ゆいごんしんたく": "ائتمان وصائي (ائتمان ينشأ بموجب وصية ويصبح نشطاً بعد وفاة المانح)",
 "ゆいごんじょう": "إرَادَة / رَغْبَة, إرَادَة",
 "ゆいごんほそくしょ": "ملحق وصية (ملحق لوصية؛ صك وصية يهدف إلى تغيير وصية تم تنفيذها بالفعل)",
 "ゆいしきは": "يوجاكارا (أحد التقاليد الرئيسية لبوذية الماهايانا؛ يرى أن العقل حقيقي ولكن الأشياء مجرد أفكار أو حالات وعي)",
 "ゆいしょ": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "ゆいしょある": "جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَهِيب, وَقُور (مثير للإعجاب والتبجيل بسبب عراقته وقِدَمه)",
 "ゆいしん": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "ゆいしんてき": "روحاني (متعلق بالروحانية أو متصل بها)",
 "ゆいしんろん": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "ゆいつ": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "ゆいつむに": "فَرِيد, فَذّ",
 "ゆいぶつ": "مَادِّيَّة",
 "ゆいぶつしかん": "مادية تاريخية",
 "ゆいぶつしゅぎ": "مَادِّيَّة",
 "ゆいぶつてき": "بُرْجُوَازِيّ, مَادِّيّ (يتوافق مع معايير وأعراف الطبقة الوسطى) / مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "ゆいぶつべんしょうほう": "مادية جدلية (الفلسفة المادية لكارل ماركس وفريدريك إنجلز)",
 "ゆいぶつろん": "مَادِّيَّة",
 "ゆいぶつろんしゃ": "مادي (شخص يعتقد أنه لا يوجد شيء سوى المادة الفيزيائية) / مادي (شخص لديه اهتمام كبير بالممتلكات المادية)",
 "ゆいぶつろんてき": "بُرْجُوَازِيّ, مَادِّيّ (يتوافق مع معايير وأعراف الطبقة الوسطى) / مَادِّيّ النَّزْعَةِ, نَفْعِيّ (يَتَّسِمُ بِالنَّزْعَةِ المَادِّيَّةِ)",
 "ゆいめ": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "ゆいめいろん": "اسمية ((فلسفة) المذهب القائل بأن الأشياء المختلفة التي تحمل نفس المصطلح ليس بينها قاسم مشترك سوى الاسم)",
 "ゆいりろん": "عَقْلَانِيَّة / عَقْلِيَّة",
 "ゆう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / مُمْتَاز, فَاخِر / تَفَوُّق / مُؤَدَّب / مَاهِر, حَاذِق / شَجَاعَة / وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف ! / مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة / شَرِكَة مَحْدُودَة / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة) / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / رَفِيع, فَائِق (فائق الجودة بشكل استثنائي) / بَاهِر, رَائِع (ذو تميز يفوق الوصف) / مَسَاء / ذَكَرِيّ / ذَكَر, ذكر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي / صَامِت, هَادِئ / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "ゆうあい": "أُخُوَّة / أَخَوِيَّة",
 "ゆうあいかい": "أُخُوَّة / أَخَوِيَّة",
 "ゆうあく": "كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان) / كَيِّس, لَطِيف (يُظهر الكياسة واللطف في التعامل) / دمث, كريم النفس (يتميز بالسحر والذوق الرفيع وكرم الروح) / رَؤُوف, كَرِيم (يتسم بالطيبة والمجاملة الدافئة خاصة من ملك تجاه رعاياه)\nمثال: لطيف حتى مع الزوار غير المتوقعين",
 "ゆうあつかんきせん": "مروحة شفط (مروحة تحرك الهواء خارج مكان مغلق)",
 "ゆうあん": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "ゆうい": "غلبة, هيمنة (صفة كون الشيء أكثر وضوحاً من أي شيء آخر) / سيادة, غلبة (حالة السيادة على الآخرين)\nمثال: أعطت هيمنة اللون الأزرق اللوحة نغمة هادئة / هَامّ (أصابه الهيام)\nمثال: الحضور هام جدا. / عَمْدِيّ, إرَادِيّ / قَادِر (الذي له قُدْرَة أو مقدرة؛ القويّ المتمكن؛ الذي يَقْدُر الأمور أي يقيسها ويُهيأها)\nمثال: سامي قادر على هذا. / عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "ゆういぎ": "هَامّ (أصابه الهيام)\nمثال: الحضور هام جدا.",
 "ゆういせい": "تَفَوُّق / مَعْنَى",
 "ゆういつ": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "ゆういてき": "عَمْدِيّ, إرَادِيّ",
 "ゆういにたつ": "سَيْطَرَ",
 "ゆういん": "تشجيع, حافز (تأثير تحفيزي إيجابي) / حافز, مكافأة (دفعة إضافية (أو مكافأة أخرى) للموظفين كوسيلة لزيادة الإنتاج) / إغراء, إغواء (فعل التأثير عن طريق إثارة الأمل أو الرغبة) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, فتنة (شيء يغوي أو لديه القدرة على الإغواء)\nمثال: كانت إغراءاته وقحة / إِشَارِيّ, بِلُغَةِ الإِشَارَة (متعلّق بلغة إشارة الصُّمّ) / ممهور بتوقيع, موقع (يحمل توقيعًا مكتوبًا بخط اليد)\nمثال: رسالة موقعة",
 "ゆううつ": "مُنْخَفَض",
 "ゆううつしょう": "سَوْدَاوِيَّة",
 "ゆうえい": "سِبَاحَة",
 "ゆうえいし": "رجل عائمة, قدم سباحة (واحدة من الزوائد البطنية المزدوجة لبعض القشريات المائية التي تعمل بشكل أساسي لحمل البيض عند الإناث وتتكيف عادة للسباحة)",
 "ゆうえいしゃ": "سَبَّاح, عَوَّام",
 "ゆうえいせいぶつ": "سوابح, نيكتون (مجموع الحيوانات السابحة بنشاط في جسم مائي تتراوح من الكائنات المجهرية إلى الحيتان)",
 "ゆうえいどうぶつ": "سوابح, نيكتون (مجموع الحيوانات السابحة بنشاط في جسم مائي تتراوح من الكائنات المجهرية إلى الحيتان)",
 "ゆうえき": "مُفِيد",
 "ゆうえつ": "تَفَوُّق",
 "ゆうえつかん": "عقدة التفوق (تقدير مبالغ فيه لقيمة وأهمية المرء)",
 "ゆうえつせい": "تَفَوُّق",
 "ゆうえつふくごう": "عقدة التفوق (تقدير مبالغ فيه لقيمة وأهمية المرء)",
 "ゆうえん": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله) / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب / مُمَلَّح",
 "ゆうえんち": "مَدِينَة تَرْفِيهِيَّة, مَدِينَة الْمَلْهَى",
 "ゆうおう": "رَهَج أَصْفَر",
 "ゆうか": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك. / بَرّ اَلصِّين اَلرَّئِيسِيّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "ゆうかい": "هَادِيس / اِخْتِطَاف / اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة) / مَحْدُود, مُحَدَّد المَعَالِم (تَمَّ تَعْيِينُ حُدُودِهِ أَوْ مَعَالِمِهِ) / شَبَح, خَيَال / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "ゆうかいざい": "اِخْتِطَاف",
 "ゆうかいしゃ": "مُخْتَطِف",
 "ゆうかいじけん": "اِخْتِطَاف",
 "ゆうかいてん": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "ゆうかいねつ": "حرارة الانصهار (حرارة تمتصها وحدة كتلة من مادة صلبة عند نقطة انصهارها لتحويل المادة الصلبة إلى سائل عند نفس درجة الحرارة)\nمثال: حرارة الانصهار تساوي حرارة التجمد",
 "ゆうかいはん": "مُخْتَطِف",
 "ゆうかいはんにん": "مُخْتَطِف",
 "ゆうかく": "أُورْكِيد, سَحْلَب / رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / متجول سياحي, متنزه (سائح يزور المعالم السياحية) / زَاوِيَة مُنْعَكِسَة, زَاوِيَة مَعْكُوسَة",
 "ゆうかぶつ": "قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه، الذي يقوم به ويكون في وِلايَةه)\nمثال: إعطي قيمة لذاتك.",
 "ゆうかん": "شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن. / مُتَرَفِّه, مُتَفَرِّغ (خَالٍ مِنَ الوَاجِبَات أَوِ المَسْؤُولِيَّات) / عُرْوَة, عُقْدَة",
 "ゆうかんさ": "شَجَاعَة",
 "ゆうが": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة. / على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك / تَكْرِير",
 "ゆうがい": "ضَارّ, مُضِرّ / مُغَطًّى",
 "ゆうがいかしゃ": "عربة شحن مغلقة (عربة شحن بسقف وأبواب منزلقة في الجوانب)",
 "ゆうがいせい": "أَذِيَّة, ضَرَر (صفة كون الشيء ضاراً) / إِيذَاء, ضَرَر (التدميرية التي تسبب ضرراً أو أذى)",
 "ゆうがお": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة) / أثمان أبيض, زهرة القمر (متسلق استوائي شامل له زهور ليلية بيضاء عطرة)",
 "ゆうがた": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ゆうき": "شَجَاعَة, جَسَارَة\nمثال: 我々は彼女の勇気に感心する。 — نحب شجاعتها. / شَبَح, خَيَال / عُضْوِيّ / كيمياء عضوية (كيمياء المركبات التي تحتوي على الكربون) / مركب عضوي (أي مركب يتكون من الكربون وعنصر آخر أو شق كيميائي) / استحضار (إعادة خلق خيالية) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات) / استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى)\nمثال: لم يكن استخلاص شهادته سهلاً / مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "ゆうきある": "شجاع (الثعبان)\nمثال: إنك شجاع للغاية.",
 "ゆうきおん": "صوت مهموس, هاء (صامت يُنطق مع نَفَس مسموع) / تفخيم, صوت مصحوب بنفخ (صوت كلامي يرافقه نفخة مسموعة من النفس، مثل الصوامت الوقفية الأولية)",
 "ゆうきかがく": "كيمياء عضوية (كيمياء المركبات التي تحتوي على الكربون)",
 "ゆうきかごうぶつ": "مركب عضوي (أي مركب يتكون من الكربون وعنصر آخر أو شق كيميائي)",
 "ゆうきしつひりょう": "سماد عضوي (سماد مشتق من مواد حيوانية أو نباتية)",
 "ゆうきせき": "سبودومين (معدن بيروكسين يتكون من سيليكات الليثيوم والألمنيوم؛ مصدر لليثيوم)",
 "ゆうきたい": "كَائِن حَيّ",
 "ゆうきづけ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "ゆうきづける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "ゆうきてき": "عُضْوِيّ / مُنَسَّق الحَرَكَة (يتمتع بمهارة في استخدام أكثر من مجموعة حركات عضلية) / مُتَرَابِط, مُنَسَّق (يعمل كوحدة واحدة متناسقة) / مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد)",
 "ゆうきはっこうダイオード": "صمام ثنائي عضوي باعث للضوء (صمام ثنائي ذاتي الإضاءة (يتوهج عند تطبيق مجال كهربائي على الأقطاب) لا يتطلب إضاءة خلفية أو ناشرات)",
 "ゆうきひりょう": "سماد عضوي (سماد مشتق من مواد حيوانية أو نباتية)",
 "ゆうきぶつ": "مركب عضوي (أي مركب يتكون من الكربون وعنصر آخر أو شق كيميائي)",
 "ゆうきゅう": "أَبَدِيّ / موظف براتب, يتقاضى راتباً (يتلقى راتباً) / مَأْجُور, مَدْفُوعُ الأَجْر (يُدْفَعُ مُقَابِلُهُ مَال) / بِرَاتِب, يَتَقَاضَى أَجْرًا (يَتَلَقَّى تَعْوِيضًا مَالِيًّا أَوْ مُؤَهَّلٌ لِذَلِك)\nمثال: أعضاء الموظفين الذين يتقاضون رواتب / إجازة مدفوعة الأجر (إجازة من العمل للموظف مع منح الراتب) / عَاطِل عَن اَلْعَمَل",
 "ゆうきゅうきゅうか": "إجازة مدفوعة الأجر (إجازة من العمل للموظف مع منح الراتب)",
 "ゆうきゅうしょうか": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "ゆうきょ": "صومعة (مسكن الناسك)",
 "ゆうきょう": "عُزْلَة / ابتهاج, احتفال صاخب (احتفال صاخب؛ بهجة ومرح) / مُرُوءَة",
 "ゆうきょくさいぼうがん": "خلية شائكة (خلية في الطبقة المنتشة للجلد (الطبقة الشائكة)؛ لها العديد من الأشواك والنتوءات المشعة)",
 "ゆうきりんりん": "فَيَّاض, مُتَدَفِّق (طافح بالفرح والحيويّة بلا قيود)",
 "ゆうきん": "وردية مسائية (عمال يعملون أثناء المساء (مثل من 4 مساءً إلى منتصف الليل)) / وردية مسائية (وردية العمل خلال المساء (مثل من 4 مساءً إلى منتصف الليل))",
 "ゆうきエルイーディー": "صمام ثنائي عضوي باعث للضوء (صمام ثنائي ذاتي الإضاءة (يتوهج عند تطبيق مجال كهربائي على الأقطاب) لا يتطلب إضاءة خلفية أو ناشرات)",
 "ゆうぎ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة. / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس.",
 "ゆうぎしつ": "غرفة الألعاب, غرفة اللعب (غرفة ترفيه للأنشطة الصاخبة (الحفلات أو لعب الأطفال وما إلى ذلك))",
 "ゆうぎてき": "دَاعِب, لَعُوب",
 "ゆうぎょ": "صيد السمك (فعل شخص يصطاد السمك كتسلية)",
 "ゆうぎょうしゃ": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "ゆうぎりょうほう": "علاج باللعب (شكل من أشكال العلاج النفسي للأطفال يستخدم مواقف اللعب للتشخيص أو العلاج)",
 "ゆうく": "مُشْكِلَة, مَتاعِب / خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "ゆうくん": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ゆうぐ": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ゆうぐう": "كَرَم, إِكْرَام / ضِيَافَة",
 "ゆうぐうそち": "اِمْتِيَاز",
 "ゆうぐれ": "مَسَاء",
 "ゆうけい": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً) / مَسَاء",
 "ゆうけつ": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع) / حسم, قاطع (سمة الحزم كما يتضح من صلابة الشخصية أو الغرض)\nمثال: نهائية الموت",
 "ゆうけん": "طَابِع, طَابِع بَرِيدِيّ / أَهْلِيَّة, اسْتِحْقَاق (صفة أو حالة كون الشخص مؤهلاً)\nمثال: أهلية المرشح للمنصب",
 "ゆうけんしゃ": "مُصَوِّت, نَاخِب / زعيم, شخصية محورية (أهم شخص في مجموعة أو مشروع)",
 "ゆうげ": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / تَعَشَّى (تَنَاوَلَ العَشَاء)\nمثال: هل العشاء جاهز؟",
 "ゆうげき": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ / التوقف القصير, شورت ستوب (مركز اللعب للاعب في فريق البيسبول المتمركز بين القاعدة الثانية والثالثة) / لاعب التوقف القصير",
 "ゆうげきしゅ": "التوقف القصير, شورت ستوب (مركز اللعب للاعب في فريق البيسبول المتمركز بين القاعدة الثانية والثالثة) / لاعب التوقف القصير",
 "ゆうげきせん": "حرب العصابات (القتال باستخدام مجموعات من القوات الخفيفة والمتنقلة وغير النظامية داخل المناطق التي تحتلها قوة معادية، عادة من خلال تكتيكات الكر والفر)\nمثال: بدا أن الانفصاليين يتحصنون لاحتمال حرب عصابات",
 "ゆうげん": "متناهٍ, محدود (مقيد أو محدود في الحجم أو المدى المكاني أو الزماني) / متصرف, محدد ((عن الأفعال) يتعلق بأشكال الفعل المحددة بزمن وتظهر (عادة) توافقاً مع العدد والشخص)",
 "ゆうげんがいしゃ": "شَرِكَة مَحْدُودَة",
 "ゆうげんがいしゃほう": "مسؤولية محدودة (مسؤولية أصحاب الشركة بما لا يتجاوز رأس المال الذي استثمروه فيها)",
 "ゆうげんこ": "مَعْدُود",
 "ゆうげんじっこう": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "ゆうげんせい": "محدودية, نهائية (صفة كون الشيء متناهياً أو محدوداً)",
 "ゆうげんせきにん": "مسؤولية محدودة (مسؤولية أصحاب الشركة بما لا يتجاوز رأس المال الذي استثمروه فيها)",
 "ゆうげんせきにんかいしゃ": "شَرِكَة ذَات مَسْؤُولِيَّة مَحْدُودَة",
 "ゆうげんせきにんがいしゃ": "شَرِكَة ذَات مَسْؤُولِيَّة مَحْدُودَة",
 "ゆうげんせきにんじぎょうくみあい": "مسؤولية محدودة (مسؤولية أصحاب الشركة بما لا يتجاوز رأس المال الذي استثمروه فيها)",
 "ゆうこう": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة. / أَرِيج, عَبِير / جَدَارَة / شَرَعِيّ / تسكع / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / مُثَقَّب (به عدد أو سلسلة من الثقوب) / مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه) / مُوَجَّه (يمكن إدارته من قبل جهة مشرفة) / ذُو اتِّجَاه, مُوَجَّه (ذو اتجاه محدد؛ يُستخدم غالباً في التركيب)",
 "ゆうこうか": "تمكيني, مخوِّل (توفير السلطة القانونية أو العقوبة)\nمثال: قرار تمكيني",
 "ゆうこうかんけい": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "ゆうこうけた": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "ゆうこうけたえんざん": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "ゆうこうこつ": "عظم كلابي (عظم الرسغ المحاذي للإصبعين الرابع والخامس)",
 "ゆうこうすうじ": "رَقَم مَعْنَوِيّ (أي رقم في عدد معروف بدقة؛ أي رقم في عدد يبدأ من أقصى اليسار غير الصفري وينتهي بأقصى اليمين غير الصفري)\nمثال: حسب الجواب لأربعة أرقام معنوية",
 "ゆうこうせい": "صَلَاحِيَّة / قَانُونِيَّة, مَشْرُوعِيَّة",
 "ゆうこうせいぶん": "مَادَّة فَعَّالَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ゆうこうちゅう": "منخربات (كائن دقيق بحري له صدفة كلسية ذات فتحات تبرز منها الأقدام الكاذبة)",
 "ゆうこうてき": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "ゆうこうはんい": "حَيِّز",
 "ゆうこうグラフ": "ثنائي الحرف (حرفان متتاليان (خاصة حرفين يستخدمان لتمثيل صوت واحد))",
 "ゆうこく": "وادٍ ضيق (وادٍ ضيق منعزل (في الجبال)) / مَسَاء",
 "ゆうこん": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "ゆうごう": "إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع) / تراص, تلازن (تكتل البكتيريا أو الخلايا الحمراء عند ربطها معًا بواسطة الأجسام المضادة (الراصات)) / تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر)",
 "ゆうごはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ゆうさいしょく": "لون طيفي, لون لوني (لون له صبغة)",
 "ゆうさん": "صَاحِب أَمْلَاك, مَالِك لِلْعَقَارَات (يَمْلِك أَرَاضِيَ أَوْ أَوْرَاقًا مَالِيَّة كَمَصْدَرٍ رَئِيسِيٍّ لِلدَّخْل)",
 "ゆうさんかいきゅう": "بُرْجُوَازِيَّة",
 "ゆうさんそ": "هَوَائِيّ (يعتمد على الأكسجين الحر أو الهواء) / رِيَاضِيّ هَوَائِيّ, هَوَائِيّ (يعتمد على أو يستخدم مبادئ التمارين الهوائية؛ يعزز كفاءة التنفس والدورة الدموية)\nمثال: تخمر هوائي",
 "ゆうさんそうんどう": "أيروبيكس, تمارين هوائية (تمرين يزيد من الحاجة إلى الأكسجين)",
 "ゆうざい": "ذَنْب, خِطْء (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / نَدَم\nمثال: عذر أقبح من ذنب. / تغير مستمر, تقلب (في تغيير مستمر) / كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة) / تدفق, سيلان (جريان أو تصريف) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)\nمثال: آراؤه في تقلب مستمر",
 "ゆうざいしょうこ": "أدلة الجريمة, جسم الجريمة (مجموعة الأدلة التي تشكل الجريمة؛ الدليل الموضوعي على ارتكاب جريمة (يُعتقد خطأً أحياناً أنه يشير إلى جثة ضحية جريمة قتل))",
 "ゆうし": "بَطَل, بَطَلَة / ثَاكِل, مَفْجُوع (حزين بسبب فقدان أو حرمان) / مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع / اِبْنُ أَخٍ, اِبْنُ أُخْتٍ (الولد الذكر)\nمثال: هو له ابن صغير. / تمويل (عملية التمويل) / هَائِم / تَارِيخِي / خادم عام, موظف حكومي (شخص يشغل منصباً حكومياً (سواء بالانتخاب أو التعيين)) / اجترار / أَثِيرِيّ, شَفَّاف (يَتَّسِمُ بِخِفَّةٍ وَرِقَّةٍ غَيْرِ مَعْهُودَة) / رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء) / خيط العنكبوت, نسيج العنكبوت (خيوط من شبكة نسجها عنكبوت) / جوسامر, قماش شفاف (قماش شاش ذو نسيج ناعم للغاية) / غَالِب",
 "ゆうしいぜん": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "ゆうしかく": "أَهْلِيَّة, اسْتِحْقَاق (صفة أو حالة كون الشخص مؤهلاً)\nمثال: أهلية المرشح للمنصب",
 "ゆうしき": "مُطَّلِع",
 "ゆうしきしゃ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "ゆうしこんちゅう": "جَنَاحِيَّة",
 "ゆうしこんちゅうるい": "جَنَاحِيَّة",
 "ゆうしつどうぶつ": "مشطيات, هلاميات مشطية (حيوانات بحرية خنثوية متناظرة ثنائياً تشبه قناديل البحر ولها ثمانية صفوف من الأهداب مرتبة مثل أسنان المشط للحركة)",
 "ゆうしてっせん": "سِلْك شَائِك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "ゆうしぶんれつ": "انقسام خيطي, انقسام متساوي (انقسام الخلية الذي تنقسم فيه النواة إلى نواتين تحتويان على نفس عدد الكروموسومات)",
 "ゆうしゃ": "بَطَل, بَطَلَة",
 "ゆうしゃく": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي)",
 "ゆうしゅ": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "ゆうしゅう": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / سَوْدَاوِيَّة / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "ゆうしゅうひん": "مُرْتَفِع الدَّرَجَة",
 "ゆうしゅか": "جامع طوابع, هاوي طوابع (جامع ودارس للطوابع البريدية)",
 "ゆうしゅつりょう": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "ゆうしゅどうぶつ": "دودة لحوية (حيوان نحيل له مجسات وغطاء خارجي يشبه الأنبوب؛ يعيش في قاع المحيط العميق)",
 "ゆうしょう": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين / نَعِيم / دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / مخلب الدب (معجنات مخمرة بالخميرة بنكهة اللوز مشكلة في نصف دائرة غير منتظمة تشبه مخلب الدب)",
 "ゆうしょうしゃ": "نَصِير, نَصِيرَة",
 "ゆうしょうじゃくそつ": "هُنَاك, يُوجَد",
 "ゆうしょうせん": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "ゆうしょうのもとにじゃくそつなし": "هُنَاك, يُوجَد",
 "ゆうしょうれっぱい": "انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة)",
 "ゆうしょうカップ": "غَنِيمَة",
 "ゆうしょうテープ": "خط النهاية (خط يشير إلى موقع نهاية السباق)",
 "ゆうしょく": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة / عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟ / مُلَوَّن",
 "ゆうしょくこうか": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "ゆうしょくじ": "وقت العشاء (الساعة المعتادة أو العرفية لتناول وجبة المساء)",
 "ゆうしょくじんしゅ": "ملونون (عرق ذو تصبغ جلدي مختلف عن العرق الأبيض (وخاصة السود))",
 "ゆうしょくたい": "صانعة ملونة, كروموبلاست (بلاستيد يحتوي على أصباغ غير اليخضور عادة ما تكون كاروتينات صفراء أو برتقالية)",
 "ゆうしるい": "جَنَاحِيَّة",
 "ゆうしわく": "سطر الكاتب (سطر يعطي اسم كاتب قصة أو مقال) / حد ائتماني, خط ائتمان (الحد الأقصى للائتمان المسموح به للعميل)",
 "ゆうしん": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل. / أب, فحل (الوالد الذكر لحيوان، خاصة الحيوانات الأليفة مثل الحصان) / جد, سلف (مؤسس العائلة) / مولاي (لقب مخاطبة كان يستخدم سابقاً لرجل ذي رتبة وسلطة)\nمثال: حافظوا على إيمان أجدادنا",
 "ゆうしんぼつぼつ": "طَمُوح",
 "ゆうしんろん": "ألوهية, إيمان بوجود إله (العقيدة أو الإيمان بوجود إله أو آلهة)",
 "ゆうしんろんしゃ": "ألوهي, توحيدي (من أو يتعلق بالإيمان بوجود إله) / مؤله, مؤمن بوجود إله (من يؤمن بوجود إله أو آلهة)",
 "ゆうじ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "ゆうじゃ": "بَطَل, بَطَلَة",
 "ゆうじゃく": "صَامِت, هَادِئ",
 "ゆうじゃくみ": "عُزْلَة",
 "ゆうじゅう": "غَيْر حَاسِم, مُتَرَدِّد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ゆうじゅうふだん": "غَيْر حَاسِم, مُتَرَدِّد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "ゆうじょ": "مُسَاعَدَة, إِمْدَاد / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / مَغْفِرَة, غُفْرَان",
 "ゆうじょう": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "ゆうじょや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ゆうじん": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / مأهول (لديه طاقم)\nمثال: اعتبر القمر الصناعي الأرضي المأهول خطوة بحثية ضرورية / مُسْتَهْتَر",
 "ゆうすい": "مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ) / مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "ゆうすう": "شَهِير (معروف على نطاق واسع؛ معروف تحديدًا بسبب شيء سلبي)\nمثال: أصبحت ريمة شهيرة.",
 "ゆうする": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "ゆうずい": "سَدَاة",
 "ゆうずう": "إعارة, إقراض (التصرف في المال أو الممتلكات مع توقع إعادة نفس الشيء (أو ما يعادله)) / تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "ゆうずうせい": "مُرُونة",
 "ゆうずうむげ": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "ゆうせい": "تَفَوُّق / جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / سيادة (الظاهرة العضوية التي يتم فيها التعبير عن أحد أليلين موجودين في النمط الجيني في النمط الظاهري بينما لا يظهر الأليل الآخر) / تحكم, سيطرة (الحالة التي توجد عندما يكون لشخص أو مجموعة سلطة على أخرى)\nمثال: لديه السلطة لإصدار مذكرات التوقيف / سَائِد / سَائِد, شَائِع / تَحْسِين نَسْل / لَفْظ, نَطْق (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية) / تَشْكِيل\nمثال: هذه الكلمة صعبة اللفظ. / رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ) / كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس) / كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل. / جِنْسِيّ (المنسوب إلى الجِنْس؛ في : علاقة قانونية تربط فردا معينا بدولة معينة، قد تكون أصيلة أو مكتسبة)\nمثال: تعرض للتحرش الجنسي. / رَائِق, هَادِئ (صافٍ وجميل تماماً) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس) / شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما) / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "ゆうせいいでんし": "جين سائد (جين ينتج نفس النمط الظاهري في الكائن الحي سواء كان أليله مطابقاً أم لا)\nمثال: الجين السائد للعيون البنية",
 "ゆうせいおん": "صوت مجهور (صوت كلامي مصحوب بصوت من الحبال الصوتية)",
 "ゆうせいおんか": "لَفْظ, نَطْق (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية) / تَشْكِيل\nمثال: هذه الكلمة صعبة اللفظ.",
 "ゆうせいか": "لَفْظ, نَطْق (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية) / تَشْكِيل\nمثال: هذه الكلمة صعبة اللفظ.",
 "ゆうせいがく": "تَحْسِين نَسْل",
 "ゆうせいじぎょうみんえいか": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم",
 "ゆうせいせいしょく": "تَكَاثُر جِنْسِيّ",
 "ゆうせいはいぐうたい": "مشيج ذكري, نابتة عروسية صغروية (النابتة العروسية الذكرية التي تنتجها البوغة الصغيرة)",
 "ゆうせいはぐるま": "ترس تداويري, ترس كوكبي (ترس خارجي يدور حول ترس شمسي مركزي في مجموعة تروس تداويرية)",
 "ゆうせいはぐるまそうち": "ترس تداويري, ترس كوكبي (ترس خارجي يدور حول ترس شمسي مركزي في مجموعة تروس تداويرية)",
 "ゆうせいらん": "بيضة مخصبة, جنين (كائن حيواني في المراحل المبكرة من النمو والتمايز)",
 "ゆうせき": "غَمّ, حُزْن / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "ゆうせきせい": "مَلُومِيَّة, تَأْثِيم",
 "ゆうせん": "تَفْضِيل, أَفْضَلِيَّة / مَرْبُوط بِسِلْك (مُقيَّد أو مربوط بسلك معدني) / مُتَحَمِّس, مُتَوَقِّد (مُتَوَتِّرٌ بِالحَمَاسِ وَالإِثَارَةِ كَأَنَّهُ فِي انْدِفَاعِ أَدْرِينَالِين) / سلكي, موصول بأسلاك (مجهز بسلك أو أسلاك خاصة للخدمة الكهربائية أو الهاتفية) / مُرَاقَب إِلِكْتِرُونِيًّا (فيه أجهزة تنصّت إلكترونيّة مخفيّة)\nمثال: منزل مجهز جيدًا بالأسلاك / قارب بريد (قارب لنقل البريد) / نَافُورَة, فَوَّارَة / جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / سيادة (الظاهرة العضوية التي يتم فيها التعبير عن أحد أليلين موجودين في النمط الجيني في النمط الظاهري بينما لا يظهر الأليل الآخر) / تحكم, سيطرة (الحالة التي توجد عندما يكون لشخص أو مجموعة سلطة على أخرى)\nمثال: لديه السلطة لإصدار مذكرات التوقيف",
 "ゆうせんかぶ": "سَهْم مُمْتَاز (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "ゆうせんけん": "أَوَّلَِيَّة, أَوْلَوِيَّة",
 "ゆうせんじゅんい": "أَوَّلَِيَّة, أَوْلَوِيَّة",
 "ゆうせんてき": "تَفْضِيلِيّ, تَمْيِيزِيّ (يُظهر تحيزاً أو محاباة)",
 "ゆうせんテレビ": "تلفزيون الدائرة المغلقة (نظام تلفزيوني لا يستخدم للبث العام ولكنه متصل بكابلات بشاشات مراقبة محددة (كما في المصانع أو المسارح))",
 "ゆうぜい": "جولة خطابية (القيام بحملة لشيء ما عن طريق إلقاء الخطب السياسية) / طابع, طابع بريد (رمز لاصق صغير يوضع على رسالة أو طرد للإشارة إلى أن رسوم البريد قد دُفعت) / رسوم بريدية (الرسم لإرسال شيء بالبريد) / خاضع للضريبة ((للسلع أو الأموال) يخضع للضريبة)\nمثال: دخل خاضع للضريبة / ثُؤْلُول",
 "ゆうぜん": "هَادِئ / طَمْأَنَ / بانفعال شديد, بفيض من العاطفة (بطريقة متدفقة المشاعر بشكل مفرط)\nمثال: كاتب غزير الإنتاج بفيض",
 "ゆうそう": "بُطُولِيّ / إرسال بالبريد (إرسال رسالة عبر البريد) / إرسالية بريدية (بريد يرسله المرسل في وقت واحد)\nمثال: يشير ختم البريد إلى وقت الإرسال / هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "ゆうそうし": "بوغ حيواني, بوغ متحرك (بوغ لاجنسي لبعض الطحالب والفطريات يتحرك بواسطة الأسواط)",
 "ゆうそうじん": "تتدلي الكلية, هبوط الكلية (تدلي الكلية)",
 "ゆうそうどうぶつ": "حاملات المخالب, دودة مخملية (أي من الحيوانات آكلة اللحوم العديدة التي تشبه الديدان ذات الجلد المخملي الشائعة في الغابات الاستوائية ولها خصائص كل من المفصليات والديدان الحلقية)",
 "ゆうそうりょう": "طابع, طابع بريد (رمز لاصق صغير يوضع على رسالة أو طرد للإشارة إلى أن رسوم البريد قد دُفعت) / رسوم بريدية (الرسم لإرسال شيء بالبريد)",
 "ゆうたい": "كَرَم, إِكْرَام / ضِيَافَة / مَلْمُوْس / حقيبة بريد (حقيبة كتف يحملها ساعي البريد) / جراب بريد, حقيبة بريد (جراب يستخدم في شحن البريد) / تنازل عن العرش (فعل التنازل عن العرش) / تنازل عن العرش, تنحي (استقالة رسمية وتنازل عن السلطات)",
 "ゆうたいどうぶつ": "جِرَابِيّ, جِرَاب",
 "ゆうたいりだつ": "تجربة الخروج من الجسد (التجربة الانفصالية لمراقبة الذات من منظور خارجي كما لو أن العقل أو الروح قد غادر الجسد ويقوم بمراقبته)",
 "ゆうたいるい": "جِرَابِيّ, جِرَاب",
 "ゆうだ": "بُطْء / ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "ゆうだい": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد)",
 "ゆうだち": "شَتْوَة, مَطْرَة / مِرَشَّة, دُش / اِسْتَحَمَّ, تَحَمَّمَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "ゆうだんしゃ": "حِزَام أَسْوَد (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "ゆうち": "جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب) / جاذبية, عنصر جذب (خاصية توفر المتعة وتجذب) / مَعلم ترفيهي, وسيلة جذب (ترفيه يُقدم للجمهور) / عامل جذب, مصدر جذب (فنان ترفيهي يجذب جماهير غفيرة)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "ゆうちゃく": "اِنْدِمَاج / ذَوَبَان (تحول الجامد إلى سائل) / اِتِّحَاد (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "ゆうちょう": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك / أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "ゆうつうせい": "أَلِيم, مُؤْلِم",
 "ゆうづう": "إعارة, إقراض (التصرف في المال أو الممتلكات مع توقع إعادة نفس الشيء (أو ما يعادله)) / تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "ゆうづうむげ": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "ゆうてい": "مغلاق (كتلة معدنية في الأسلحة النارية التي تُعبأ من الخلف يتم سحبها لإدخال خرطوشة واستبدالها لإغلاق المؤخرة قبل إطلاق النار)",
 "ゆうていどうぶつ": "حيوان ذو حوافر (أي من عدد من الثدييات ذات الحوافر التي تتشابه ظاهرياً ولكنها ليست بالضرورة مرتبطة ارتباطاً وثيقاً من الناحية التصنيفية) / حافري, ذو حوافر (يمتلك أو يشبه الحوافر)\nمثال: الخيول والحيوانات الأخرى ذات الحوافر",
 "ゆうているい": "حيوان ذو حوافر (أي من عدد من الثدييات ذات الحوافر التي تتشابه ظاهرياً ولكنها ليست بالضرورة مرتبطة ارتباطاً وثيقاً من الناحية التصنيفية) / حافري, ذو حوافر (يمتلك أو يشبه الحوافر)\nمثال: الخيول والحيوانات الأخرى ذات الحوافر",
 "ゆうてん": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "ゆうでん": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير / عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "ゆうでんかねつ": "تسخين عازل (تسخين عازل بواسطة مجال كهربائي عالي التردد)",
 "ゆうでんし": "محث (جهاز كهربائي (عادة ملف موصل) يدخل الحث في الدائرة)",
 "ゆうでんたい": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "ゆうでんりつ": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "ゆうとう": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي / مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "ゆうとうこつ": "عظم كبير (عظم الرسغ ذو الرأس المستدير الذي يتمفصل مع العظم السنعي الثالث)",
 "ゆうとうどうぶつ": "حيوان فقاري, فقاري (حيوانات لها هيكل عظمي أو غضروفي مع عمود فقري مقسم ودماغ كبير محاط بجمجمة)",
 "ゆうとく": "فَاضِل",
 "ゆうど": "إِمْكَانِيَّة, احْتِمَال (احتمالية نتيجة محددة)",
 "ゆうどう": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "ゆうどうえんぼく": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "ゆうどうかねつ": "تسخين بالحث (تسخين مادة موصلة ناتج عن تيار كهربائي مستحث فيها)",
 "ゆうどうし": "محث (جهاز كهربائي (عادة ملف موصل) يدخل الحث في الدائرة)",
 "ゆうどうじんもん": "سؤال استدراجي (سؤال مصاغ بطريقة توحي بالإجابة المطلوبة؛ قد يطرح المحامي أسئلة استدراجية في الاستجواب المضاد)",
 "ゆうどうせい": "اسْتِقْرَائِيّ, تَحْرِيضِيّ (يحثّ أو يؤثّر؛ يقود إلى فعلٍ ما) / استقرائي (للاستدلال؛ الانتقال من حقائق جزئية إلى استنتاج عام) / حثي (ناشئ عن الحث (الكهربائي))\nمثال: تفكير استقرائي",
 "ゆうどうたい": "مشتقّ",
 "ゆうどうだん": "صاروخ موجه (صاروخ يعمل بالدفع الصاروخي يمكن التحكم في مساره أثناء الطيران إما عن طريق إشارات الراديو أو عن طريق أجهزة توجيه داخلية)",
 "ゆうどうでんどうき": "محرك تحريضي, محرك حثي (محرك كهربائي يعمل بالتيار المتردد يتم فيه الحصول على التيار الكهربائي في الجزء الدوار اللازم لإنتاج عزم الدوران عن طريق الحث الكهرومغناطيسي من المجال…)",
 "ゆうどうとう": "مخرج طوارئ",
 "ゆうどうろ": "ممر تدريج (سطح مرصوف على شكل شريط؛ تستخدمه الطائرات للتحرك من وإلى المدرج في المطار)",
 "ゆうどうコイル": "ملف حث (ملف لإنتاج جهد عالٍ من مصدر جهد منخفض)",
 "ゆうどうミサイル": "صاروخ موجه (صاروخ يعمل بالدفع الصاروخي يمكن التحكم في مساره أثناء الطيران إما عن طريق إشارات الراديو أو عن طريق أجهزة توجيه داخلية)",
 "ゆうどく": "سَامّ",
 "ゆうどくしょくぶつ": "نبات سام (نبات يمكن أن يكون ضاراً أو مميتاً للكائن الحي عند لمسه أو تناوله بكمية كافية)",
 "ゆうどくぶっしつ": "سم, مادة سامة (أي مادة تسبب إصابة أو مرض أو موت كائن حي)",
 "ゆうどくぶつ": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "ゆうなる": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي) / بَاهِر, رَائِع (ذو تميز يفوق الوصف)",
 "ゆうに": "بِسُهُولَة",
 "ゆうのう": "قَادِر (الذي له قُدْرَة أو مقدرة؛ القويّ المتمكن؛ الذي يَقْدُر الأمور أي يقيسها ويُهيأها)\nمثال: سامي قادر على هذا.",
 "ゆうはつ": "استحثاث, تحفيز (فعل تحقيق نتيجة مرغوبة)\nمثال: استحثاث النوم",
 "ゆうはつざい": "مُحَفِّز, حَاث",
 "ゆうはつでんい": "جهد مستثار (الاستجابة الكهربائية للجهاز العصبي المركزي الناتجة عن محفز خارجي)\nمثال: قاس الجهد المستثار بواسطة مخطط كهربية الدماغ",
 "ゆうはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ゆうひ": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "ゆうひつ": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "ゆうひょう": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي) / مَوْسُوم, مُسْتَهْدَف (مُمَيَّزٌ لِلْمُلَاحَظَةِ وَخَاصَّةً لِمَصِيرٍ وَخِيمٍ) / صَرِيح, وَاضِح (بارز بقوّة؛ سهل الملاحظة) / موسوم, مُعلَّم (لديه أو يبدو وكأن لديه علامة تعريف أو علامة كما هو محدد؛ غالباً ما تستخدم في التركيبات)\nمثال: لعب بأوراق معلمة (مغشوشة)",
 "ゆうひょうえき": "مذيب الجليد, مزيل الصقيع (سخان يزيل الجليد أو الصقيع (كما هو الحال من الزجاج الأمامي أو الثلاجة أو أجنحة الطائرة))",
 "ゆうひょうき": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "ゆうひょうしゃく": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي)",
 "ゆうび": "غريس / خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "ゆうびょうりつ": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "ゆうびるい": "ذوات الذيل (برمائيات تشبه السحالي)",
 "ゆうびん": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم / بَرِيد / بريد",
 "ゆうびんうけ": "صندوق بريد (صندوق خاص لاستلام البريد) / صندوق بريد (صندوق عام لإيداع البريد)",
 "ゆうびんうけばこ": "صندوق بريد (صندوق خاص لاستلام البريد) / صندوق بريد (صندوق عام لإيداع البريد) / صندوق بريد (حجرة مرقمة في مكتب بريد حيث يتم وضع البريد لاستلامه)",
 "ゆうびんきって": "طَابِع, طَابِع بَرِيدِيّ",
 "ゆうびんきょく": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "ゆうびんきょくいん": "موظف بريد (كاتب في مكتب البريد)",
 "ゆうびんぎょうむ": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم",
 "ゆうびんこづつみ": "رِزْمَة, رُزْمَة",
 "ゆうびんさしだしばこ": "صندوق بريد (صندوق عام لإيداع البريد)",
 "ゆうびんししょばこ": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "ゆうびんしゅうはいにん": "سَاعِيّ بَرِيد",
 "ゆうびんじぎょう": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم",
 "ゆうびんせいど": "بريد, خدمة بريدية (النظام الذي يتم بموجبه نقل الرسائل عبر مكتب البريد)\nمثال: يتعامل البريد مع مليارات العناصر كل يوم",
 "ゆうびんせん": "قارب بريد (قارب لنقل البريد)",
 "ゆうびんはいたつ": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "ゆうびんはいたついん": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "ゆうびんはいたつにん": "سَاعِيّ بَرِيد",
 "ゆうびんはいたつふ": "سَاعِيّ بَرِيد",
 "ゆうびんはがき": "كَرْت بَرِيدِيّ",
 "ゆうびんばこ": "صندوق بريد (صندوق خاص لاستلام البريد) / صندوق بريد (صندوق عام لإيداع البريد)",
 "ゆうびんばんごう": "الرمز البريدي (رمز من الحروف والأرقام يُضاف إلى العنوان البريدي للمساعدة في فرز البريد)",
 "ゆうびんぶつ": "بَرِيد / بريد",
 "ゆうびんや": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "ゆうびんりょう": "طابع, طابع بريد (رمز لاصق صغير يوضع على رسالة أو طرد للإشارة إلى أن رسوم البريد قد دُفعت) / رسوم بريدية (الرسم لإرسال شيء بالبريد)",
 "ゆうびんりょうきん": "طابع, طابع بريد (رمز لاصق صغير يوضع على رسالة أو طرد للإشارة إلى أن رسوم البريد قد دُفعت) / رسوم بريدية (الرسم لإرسال شيء بالبريد)",
 "ゆうびんポスト": "صندوق بريد (صندوق عام لإيداع البريد)",
 "ゆうふ": "بَطَلَة",
 "ゆうふう": "نسيم قوي (رياح تتحرك بسرعة 25-31 عقدة؛ 6 على مقياس بوفورت)",
 "ゆうふく": "غَنِيّ",
 "ゆうふくそう": "غَنِيّ",
 "ゆうふんるい": "خنفساء الخطم (سوسة صغيرة لها خطم طويل؛ مدمرة للحبوب والمكسرات وغيرها)",
 "ゆうぶ": "شَجَاعَة",
 "ゆうへい": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "ゆうへん": "تُحْفَة, رَائِعَة",
 "ゆうべ": "مَسَاء / اَلْبَارِحَةَ",
 "ゆうべん": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "ゆうべんか": "خَطِيب, خَطِيبَة",
 "ゆうべんじゅつ": "مُصَلًّى (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد) / خِطَابَة",
 "ゆうべんはぎん、ちんもくはきん": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "ゆうほ": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "ゆうほう": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ゆうほかんぱん": "سطح التنزه, سطح علوي (سطح في أعلى سفينة ركاب)",
 "ゆうほこうはん": "سطح التنزه, سطح علوي (سطح في أعلى سفينة ركاب)",
 "ゆうほじょう": "ساحة, كورنيش (امتداد طويل من الأرض المستوية المفتوحة (معبدة أو عشبية) للمشي بجانب شاطئ البحر)",
 "ゆうほどう": "تجوال, تنزة (مشي متمهل (عادة في مكان عام)) / موكب الافتتاح (مسير لجميع الضيوف في افتتاح رقصة رسمية) / برومناد (شكل في رقص المربعات؛ يسير الأزواج عكس اتجاه عقارب الساعة في دائرة) / متنزه, ممشى (منطقة عامة مخصصة كممشى للمشاة)",
 "ゆうぼう": "مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل) / مُبَشِّر, وَاعِد (يُنْبِئ بِاحْتِمال النَّجاح أَوْ نَتيجَة إيجابِيَّة)",
 "ゆうぼく": "بداوة, ترحال (طريقة حياة الناس الذين ليس لديهم منزل ثابت، ويتنقلون موسمياً بحثاً عن الطعام والماء والرعي إلخ)\nمثال: الرعي البدوي هو شكل من أشكال كسب العيش يتكيف بيئياً عند مستوى معين لاستغلال الموارد الهامشية",
 "ゆうぼくみん": "بَدَوِيّ (إلى البادية؛ الذي يعيش في البَادِيَة؛ الأعرابيّ)",
 "ゆうまい": "بُطُولِيّ",
 "ゆうまでもない": "بَدِيهِيّ, بَدَهِيّ",
 "ゆうまでもなく": "بُوضُوح",
 "ゆうみょう": "جَرِيء, جَسُور",
 "ゆうみん": "عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "ゆうめい": "شُهْرَة / مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\") / مَشْهُور (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور. / شبه ظلام (ظلام جزئي)",
 "ゆうめいあいへだてる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ゆうめいかい": "هَادِيس",
 "ゆうめいさかいをことにする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ゆうめいじん": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "ゆうめいてん": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "ゆうめいどころ": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "ゆうめいむじつ": "اسمياً فقط, بالاسم (باللقب أو السمعة ولكن ليس في الواقع)\nمثال: هو طبيب بالاسم فقط",
 "ゆうめいむめい": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "ゆうめし": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ゆうもう": "جَرِيء, جَسُور",
 "ゆうもん": "بَوَّاب / عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "ゆうもんきょうさく": "تضيق البواب (تضيق العضلة العاصرة البوابية مما يمنع مرور الطعام من المعدة إلى الاثني عشر)",
 "ゆうやく": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "ゆうやけ": "أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره",
 "ゆうやみ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ゆうやろう": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / فاسق, ماجن (شخص منحل؛ عادة رجل غير منضبط أخلاقياً)",
 "ゆうゆう": "صَامِت, هَادِئ / بِسُهُولَة / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / عَمِيق, غَوِيط / بَاكٍ / بُكَاء / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء) / حَزِين, زعلان / مُحْزِنٌ / هَادِئ / طَمْأَنَ / رَشِيق, ظَرِيف / بَرَّاق, لَامِع",
 "ゆうよ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / قَلِيلًا / إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل",
 "ゆうよう": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش) / مُفِيد, نَافِع",
 "ゆうようせい": "جَدْوَى, فَائِدَة (صفة كون الشيء ذا فائدة عملية)",
 "ゆうようせまらず": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "ゆうようせまらぬ": "هَادِئ / طَمْأَنَ",
 "ゆうようびせいぶつぐん": "إِم",
 "ゆうようまくるい": "سلويات (الفقاريات العليا (الزواحف والطيور والثدييات) التي تمتلك سلوي (غشاء جنيني) أثناء التطور)",
 "ゆうよきかん": "فترة السماح",
 "ゆうよく": "رِحْلَة بَحْرِيَّة / طَائِر السُّرْعَة, مُجَنَّح (سَرِيع جِدًّا كَأَنَّ لَه أَجْنِحَة) / مجنح (له أجنحة أو كأن له أجنحة من نوع محدد)\nمثال: أقدام ميركوري المجنحة",
 "ゆうよなく": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "ゆうよねん": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "ゆうらく": "تَسْلِيَة / هَامْلِت",
 "ゆうらん": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة",
 "ゆうらんきゃく": "متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "ゆうらんせん": "طراد مقصورة, يخت ترفيهي (قارب آلي كبير يحتوي على مقصورة وسباكة ووسائل راحة أخرى ضرورية للعيش على متنه)",
 "ゆうらんち": "مُنْتَجَع",
 "ゆうり": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / تَفْرِقَة / تخليص, فك التشابك (عملية التحرير من حالة تشابك أو تعقيد) / مُفِيد, مُوَاتٍ (يمنح ميزة) / مُنَاسِب, مُوَاتٍ (ملائم لتحقيق غاية معينة؛ يُلَمِّح إلى قلة الاكتراث بالعدالة)\nمثال: عقد مفيد لبلدنا / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم / عَقْلَانِيّ",
 "ゆうりか": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق) / ترشيد, عقلنة (تنظيم العمل التجاري وفقاً لمبادئ الإدارة العلمية لزيادة الكفاءة) / إنطاق ((رياضيات) تبسيط تعبير أو معادلة عن طريق إزالة الجذور دون تغيير قيمة التعبير أو جذور المعادلة) / تبرير, عقلنة (العملية المعرفية لجعل شيء ما يبدو متسقاً مع العقل أو قائماً عليه)",
 "ゆうりき": "جذر حر, شق طليق (ذرة أو مجموعة ذرات بها إلكترون واحد غير مزدوج على الأقل؛ في الجسم عادة ما يكون جزيء أكسجين فقد إلكتروناً وسيعمل على استقرار نفسه عن طريق سرقة إلكترون…)\nمثال: الجذور الحرة في الجسم هي جسيمات عالية الطاقة ترتد بعشوائية وتضر بالخلايا",
 "ゆうりしふさい": "مدر للفائدة (للالتزامات المالية التي يُدفع عليها فائدة)",
 "ゆうりすう": "عَدَد كَسْرِيّ, عَدَد نِسْبِيّ (عدد صحيح أو كسر)",
 "ゆうりょ": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ゆうりょう": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / مأجور, مدفوع (يتميز بتلقي أجر) / غَيْر تَرْفِيهِيّ, مَأْجُور (ينطوي على عمل مأجور فيما يُمارَس غالبًا كهواية) / مُجْزٍ, مُدِرّ لِلرِّبْح (يُدرّ ربحًا معقولاً)\nمثال: عمل مأجور / طريق برسوم مرور (طريق سريع يتم تحصيل رسوم مرور عليه) / صَيْد / صيد السمك (فعل شخص يصطاد السمك كتسلية)",
 "ゆうりょうかぶ": "أسهم قيادية, أسهم ممتازة (أسهم عادية لشركة معروفة وطنياً تكون قيمتها وأرباحها موثوقة؛ عادة ما يكون لها سعر مرتفع وعائد منخفض)\nمثال: الأسهم القيادية عادة ما تكون استثمارات آمنة",
 "ゆうりょうきぎょう": "رَفِيعُ القِيمَة, مُمْتَاز (بَالِغُ القِيمَة)",
 "ゆうりょうち": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "ゆうりょうどうろ": "طريق برسوم مرور (طريق سريع يتم تحصيل رسوم مرور عليه)",
 "ゆうりょく": "شَجَاعَة, جَسَارَة / ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية.",
 "ゆうりょくしゃ": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)",
 "ゆうりんるい": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل للتغذى على النمل والنمل الأبيض)",
 "ゆうれい": "شَبَح, خَيَال\nمثال: その家には幽霊が出るといわれる。 — يُقال أن ذاك المنزل مسكون. / ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "ゆうれいかぶ": "أسهم مخففة, أسهم وهمية (أسهم تمثل ملكية أصول مبالغ في قيمتها؛ أسهم شركة تكون قيمتها الإجمالية أقل من رأس مالها المستثمر)",
 "ゆうれいぐも": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "ゆうれいご": "كلمة وهمية (صيغة كلمة دخلت اللغة من خلال استدامة خطأ ما)",
 "ゆうれいやしき": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ゆうれき": "رِحْلَة / جَوْلَة",
 "ゆうれつ": "جَدَارَة / شَجَاعَة",
 "ゆうれつをつける": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "ゆうろう": "سُطُوع",
 "ゆうわ": "تَسْوِيَة / اِنْسِجَام, تَوَافُق",
 "ゆうわく": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "ゆうわくしゃ": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة)",
 "ゆうわくてき": "سَاحِر, فَتَّان (شديد الجاذبية وقادر على إثارة الأمل أو الرغبة)",
 "ゆうわくもの": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "ゆえ": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / بِسَبَب, بِحُكْم / عَائِلَة مَلِكِيَّة (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة وتشمل ثلاث أجيال من جد واحد: الجد والأبناء وأبناء الأبناء)\nمثال: هو طفل العائلة.",
 "ゆえき": "نَقْل اَلدَّم, إِصْفَاق",
 "ゆえつ": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور. / فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "ゆえなしとしない": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ゆえに": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "ゆえん": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / أسود الكربون, سخام (مادة غروانية سوداء تتكون كلياً أو أساساً من الكربون غير المتبلور وتستخدم لصنع الأصباغ والحبر)",
 "ゆおう": "كِبْرِيتِيّ",
 "ゆか": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "ゆかい": "سَارّ, لَطِيف (مَشَى)\nمثال: ها قد أتت سارة.",
 "ゆかいた": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "ゆかざい": "أَرْضِيَّة (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية.",
 "ゆかしい": "جَدِير بِالْإِعْجَاب / حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها) / فُضُولِيّ",
 "ゆかめん": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "ゆかり": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "ゆかりのいろ": "بَنَفْسَج (نبات عطري) / بَنَفْسَجِيّ",
 "ゆかん": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "ゆが": "يُوغَا, يُوجَا",
 "ゆがぎょうは": "يوجاكارا (أحد التقاليد الرئيسية لبوذية الماهايانا؛ يرى أن العقل حقيقي ولكن الأشياء مجرد أفكار أو حالات وعي)",
 "ゆがく": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سلق (حرق ناتج عن سائل ساخن أو بخار)",
 "ゆがみ": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة)) / التواء, تشويه (عملية لي أو تشويه شكل شيء ما (مثل الجسم)) / التواء, تلوّي (شكل أو وضع ملتو ومتعرج)\nمثال: قام البهلوان بالتواءات لا تصدق / خلل بسيط, عقدة (صعوبة أو عيب في خطة أو عملية) / شطحة, فكرة غريبة (فكرة غريبة الأطوار) / شَاذّ, مُنْحَرِف جِنْسِيّاً (شخص ذو ميول جنسية غير عادية) / التواء, عقدة (انحناء حاد في خط ناتج عن سحب خط به حلقة بقوة)\nمثال: لا يزال هناك بعض العقد التي يجب حلها",
 "ゆがむ": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "ゆがめる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "ゆき": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج. / جَعْبَة",
 "ゆきあし": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "ゆきあたりばったり": "عَشْوَائِيّ",
 "ゆきあたる": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "ゆきあらし": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية)",
 "ゆきおとこ": "الرجل الجليدي المقيت, يتي (مخلوق بشري كبير مشعر يقال إنه يعيش في جبال الهيمالايا)",
 "ゆきかい": "مُرُور",
 "ゆきかえり": "ذهاب وعودة",
 "ゆきかきしゃ": "كَاسِحَةُ ثُلُوج",
 "ゆきかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきがかり": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "ゆきがた": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "ゆきき": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきさき": "وِجْهَة, وُجْهَة / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "ゆきしな": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきしまき": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "ゆきじ": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج)",
 "ゆきじろ": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون. / سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "ゆきずり": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار / ذٰلِكَ / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "ゆきだま": "كُرَةُ الثَّلْج",
 "ゆきだまり": "كَثِيب ثَلْجِيّ (كتلة من الثلج كدّستها الرياح)",
 "ゆきだるま": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "ゆきだるましき": "كُرَةُ الثَّلْج",
 "ゆきちがい": "خلاف, صراع (خلاف أو جدال حول أمر مهم)\nمثال: كان لديه نزاع مع زوجته",
 "ゆきちがいになる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "ゆきちがう": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / تَصَادُم / يتصادم",
 "ゆきつく": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "ゆきつけ": "عَادِيّ / مُنْتَظِمٌ",
 "ゆきつける": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء)",
 "ゆきつぶて": "كُرَةُ الثَّلْج",
 "ゆきづまり": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "ゆきとすみ": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "ゆきどけ": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "ゆきどけみず": "ماء ذائب (الثلج أو الجليد المذاب)",
 "ゆきどころ": "وِجْهَة, وُجْهَة",
 "ゆきどまり": "طَرِيق مَسْدُود, طَرِيق غَيْر نَافِذ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / طَرِيق مَسْدُود (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "ゆきなだれ": "تَيْهُور, اِنْهِيَار ثَلْجِيّ",
 "ゆきにんぎょう": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "ゆきのけっしょう": "رُقَاقَةُ الثَّلْج, نُدْفَةُ الثَّلْج",
 "ゆきのした": "غرنوقي الفراولة, كاسر الحجر المتدلي (كاسر حجر آسيوي شرقي بعناقيد من الزهور الحمراء والبيضاء الصغيرة؛ ينتشر عن طريق العديد من السيقان الزاحفة)",
 "ゆきのはな": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "ゆきのはら": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج)",
 "ゆきはだ": "أَبْيَض نَاصِع (بلون أبيض نقي صافٍ) / حَصْرِيٌّ لِلْبِيض (مقتصر على البيض فقط)",
 "ゆきば": "وِجْهَة, وُجْهَة",
 "ゆきばな": "رُقَاقَةُ الثَّلْج, نُدْفَةُ الثَّلْج",
 "ゆきひょう": "نِمْر اَلثُّلُوج (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا.",
 "ゆきひら": "كَسْرُول, طَاجِن",
 "ゆきびさし": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "ゆきふり": "تَسَاقُط ثُلُوج",
 "ゆきぶかい": "ثَلْجِيّ",
 "ゆきほおじろ": "درسة الثلج (طائر درسة قطبي أبيض)",
 "ゆきみち": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج) / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ゆきみどうろう": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "ゆきわたる": "مُبَعْثَر, مُنْتَشِر (مُمْتَدٌّ عَلَى مِسَاحَةٍ وَاسِعَةٍ؛ غَيْرُ مُتَمَرْكِزٍ فِي مَكَانٍ وَاحِدٍ) / فَضْفَاض, مُطَوَّل (يَفْتَقِرُ إِلَى الإِيجَازِ وَالِاخْتِصَارِ) / مشتت, ناعم ((للضوء) ينتقل من مصدر ضوء واسع أو منعكس)",
 "ゆきわりそう": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…) / بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "ゆぎ": "جَعْبَة",
 "ゆぎょう": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "ゆく": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / جَدْوَل / تَيَّار / تَدَفّقَ / غَادَرَ, رَحَلَ (تَرَكَ)\nمثال: غادر سامي للتو. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ゆくえ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / وِجْهَة, وُجْهَة / نَتِيجَة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "ゆくえしれず": "مَفْقُود",
 "ゆくえふめい": "مَفْقُود",
 "ゆくえをくらます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "ゆくかた": "وِجْهَة, وُجْهَة",
 "ゆくさき": "وِجْهَة, وُجْهَة / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "ゆくさきざき": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ゆくすえ": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "ゆくと": "بِبُطْء",
 "ゆくみ": "مِغْرَفَة",
 "ゆくゆく": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ゆくりなく": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "ゆくりなくも": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "ゆぐち": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ゆけつ": "نَقْل دَم",
 "ゆけつがん": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "ゆけむり": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء.",
 "ゆげ": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء.",
 "ゆげをたてておこる": "هَاجَ, غَلَى",
 "ゆげん": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "ゆこく": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "ゆごう": "إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع) / تراص, تلازن (تكتل البكتيريا أو الخلايا الحمراء عند ربطها معًا بواسطة الأجسام المضادة (الراصات)) / تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر)",
 "ゆさい": "لَوْحَة زَيْتِيَة",
 "ゆさぶられっこしょうこうぐん": "بكالوريوس العلوم (درجة البكالوريوس في العلوم) / أنتيمون, إثمد (عنصر فلزي له أربعة أشكال تآصلية؛ يستخدم في مجموعة واسعة من السبائك)",
 "ゆさぶり": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / ارتباك, اضطراب (طبع مشوش أو عصبي ومنزعج)",
 "ゆさぶる": "هَزَّ",
 "ゆさゆさ": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / سطوة, سيادة (تأثير مسيطر)",
 "ゆさん": "جَوْلَة, نُزْهَة",
 "ゆさんじょ": "فرار, هروب (هروب سريع (خاصة من قبل المجرمين)) / انطلاقة, تسارع (سمة القدرة على التسارع السريع)\nمثال: قام اللصوص بفرار ناجح / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "ゆさんぶね": "طراد مقصورة, يخت ترفيهي (قارب آلي كبير يحتوي على مقصورة وسباكة ووسائل راحة أخرى ضرورية للعيش على متنه)",
 "ゆし": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "ゆしゅつ": "صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى لتُبَاع هناك) / تَصْدِير / صَدَّرَ (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: صادرات الجزائر في تزايد. / حَرَكِيّ, صَادِر (للأعصاب والنبضات العصبية؛ تنقل المعلومات بعيداً عن الجهاز العصبي المركزي) / عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد)\nمثال: أعصاب ونبضات صادرة",
 "ゆしゅつぎょうしゃ": "مُصَدِّر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "ゆしゅつしんよう": "ائتمان تصدير (ائتمان يفتحه مستورد مع بنك في بلد المصدر لتمويل عملية تصدير)",
 "ゆしゅつぜい": "رسوم تصدير (رسوم تفرض على الصادرات)",
 "ゆじ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "ゆじょう": "زَيْتِيّ, دُهْنِيّ / زَيْتِيّ",
 "ゆすぎ": "شطف (إزالة الصابون بالماء النظيف في المرحلة النهائية من الغسيل)",
 "ゆすぐ": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / مَضْمَضَ",
 "ゆすぶる": "هَزَّ",
 "ゆすり": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / مبتز (مجرم يبتز المال من شخص ما بتهديده بفضح معلومات محرجة عنه)",
 "ゆする": "هَزَّ / اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "ゆするばち": "دبور حفار (دبور انفرادي يحفر أعشاشاً في التربة ويخزن فيها حشرات مشلولة لليرقات)",
 "ゆすれる": "هَزَّ",
 "ゆずう": "إعارة, إقراض (التصرف في المال أو الممتلكات مع توقع إعادة نفس الشيء (أو ما يعادله)) / تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "ゆずり": "مِيرَاث, إرْثْ",
 "ゆずりあい": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "ゆずりあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "ゆずりうけ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "ゆずりうけにん": "وَكِيل (1.وَكيل: ( اسم )؛ وكيل ( اسم ))",
 "ゆずりうける": "وَرَثَ / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "ゆずりわたし": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "ゆずりわたしにん": "ناقل الملكية ((قانون) شخص ينقل سند ملكية أو ممتلكات إلى آخر)",
 "ゆずりわたす": "سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "ゆずる": "سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ / أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "ゆせい": "بِئْر نَفْط",
 "ゆせいかん": "قَنَاة مَنَوِيَّة / بِئْر نَفْط",
 "ゆせいペンキ": "طلاء زيتي (طلاء يكون الزيت الجاف هو الوسيط فيه)",
 "ゆぜん": "بانفعال شديد, بفيض من العاطفة (بطريقة متدفقة المشاعر بشكل مفرط)\nمثال: كاتب غزير الإنتاج بفيض",
 "ゆそう": "نَقَلَ / نَقْل",
 "ゆそうかん": "خط أنابيب نفط (خط أنابيب يستخدم لنقل النفط) / خَطّ أَنَابِيب (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ゆそうきかん": "نَقَلَ / نَقْل",
 "ゆそうせん": "نَاقِلَةُ نِفْط, نَاقِلَةُ نَفْط / سفينة نقل عسكرية (سفينة لحمل الجنود أو المعدات العسكرية)",
 "ゆそうぼく": "خشب الأنبياء, ليغنوم فايتي (خشب بني مخضر صلب لشجرة خشب الأنبياء وأشجار أخرى من جنس الغاياكوم) / راتنج غاياك (هو مادة تفرزها أنواع كثيرة من الأشجار عند شقها ولا سيّما الأشجار الصنوبرية وتستخرج منها الصموغ وأنواع من الزيوت؛ في مادة هيدروكربونية نباتية لها خصائص مشابهة للراتنج الطبيعي)\nمثال: على ياني ان يقشط الراتنج.",
 "ゆそうりょう": "مُرُور",
 "ゆた": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً / شَامَان, كَاهِن",
 "ゆたか": "وافِر, وَفِير / غَنِيّ / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / سمين",
 "ゆたん": "مُشَمَّع",
 "ゆたんかん": "قَنَاة صَفْرَاء",
 "ゆたんぽ": "قربة ماء ساخن (وعاء ذو سدادة (عادة من المطاط) يملأ بالماء الساخن لتدفئة السرير أو الجسم)",
 "ゆだき": "غَلَيَان",
 "ゆだる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "ゆだん": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "ゆだんなく": "بِيَقَظَة (بطريقة مدركة ومستجيبة عقلياً)\nمثال: اجتازت اليوم بيقظة، رغم تعاطيها للمخدرات",
 "ゆだんならない": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "ゆだんのならない": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)",
 "ゆちゃ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ゆちゃく": "اِلْتِصَاق / تَوَاطُؤ",
 "ゆっくり": "بِبُطْء / بِسُهُولَة / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "ゆったり": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح / فَضْفَاض, واسِع",
 "ゆづら": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "ゆづる": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "ゆで": "غَلَيَان",
 "ゆでじる": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "ゆでたまご": "بَيْضَة مَسْلُوقَة, بَيْض مَسْلُوق (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "ゆでる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "ゆでんくっさくしせつ": "جهاز حفر, منصة نفط (جهاز يستخدم في الحفر عن النفط أو الغاز)",
 "ゆで卵": "بَيْضَة مَسْلُوقَة, بَيْض مَسْلُوق (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "ゆで汁": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "ゆで玉子": "بَيْضَة مَسْلُوقَة, بَيْض مَسْلُوق (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "ゆとり": "تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / انحراف جانبي ((لسفينة أو طائرة) انحراف جانبي) / يُوكَاتَا",
 "ゆどの": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام)",
 "ゆに": "غَلَيَان",
 "ゆにゅう": "وَارِدَات / اِسْتِيرَاد, تَوْرِيد / اِسْتَوْرَدَ, وَرَّدَ (جاء بالوِرْد من مكان آخر؛ اِشْتَرَى البضائع من خارج البلاد وبَاعَها في البلاد) / وَارِد (للأعصاب والنبضات العصبية؛ تنقل المعلومات الحسية من أعضاء الحس إلى الجهاز العصبي المركزي) / عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)\nمثال: أعصاب واردة",
 "ゆにゅうかんせんしょう": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "ゆにゅうかんぜい": "رسوم استيراد (رسوم تفرض على الواردات)",
 "ゆにゅうぎょうしゃ": "مُسْتَوْرِد, مُسْتَوْرِدَة",
 "ゆにゅうこう": "منفذ دخول, ميناء دخول (ميناء في الولايات المتحدة يتمركز فيه مسؤولو الجمارك للإشراف على دخول وخروج الأشخاص والبضائع)",
 "ゆにゅうぜい": "رسوم استيراد (رسوم تفرض على الواردات)",
 "ゆにゅうぶつ": "وَارِدَات / اِسْتِيرَاد, تَوْرِيد / اِسْتَوْرَدَ, وَرَّدَ (جاء بالوِرْد من مكان آخر؛ اِشْتَرَى البضائع من خارج البلاد وبَاعَها في البلاد)",
 "ゆにょうかん": "حَالِب",
 "ゆのし": "مكواة بخار (مكواة ضغط يمكنها نفث البخار)",
 "ゆのみ": "فنجان شاي (كوب يشرب منه الشاي) / ملء فنجان شاي (بقدر ما يستوعبه فنجان شاي)",
 "ゆのみぢゃわん": "فنجان شاي (كوب يشرب منه الشاي) / ملء فنجان شاي (بقدر ما يستوعبه فنجان شاي)",
 "ゆのみねしだ": "سرخس مائي (سراخس تنمو في الماء)",
 "ゆばたけ": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ゆばり": "بَوْل",
 "ゆばりぶくろ": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "ゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "ゆびあな": "ثقب الإصبع (ثقب لإدخال الإصبع) / ثقب العزف (واحد من سلسلة ثقوب في آلة النفخ الخشبية؛ تتغير درجة الصوت عندما يغطيها الإصبع)",
 "ゆびいた": "لوحة الأصابع (شريط ضيق من الخشب على عنق بعض الآلات الوترية (كالكمان أو التشيلو أو الجيتار وغيرها) حيث يتم الضغط على الأوتار ضد الخشب بالأصابع) / لوحة مفاتيح بيانو (مجموعة من المفاتيح على آلة موسيقية) / لوحة أصبعية (عمود إرشادي يشبه اليد بإصبع سبابة يشير للاتجاه) / لوحة حماية الباب (غطاء واقٍ مسطح (على باب أو حائط إلخ) لمنع الاتساخ بالأصابع المتسخة)",
 "ゆびいれ": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "ゆびおり": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "ゆびがね": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "ゆびく": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سلق (حرق ناتج عن سائل ساخن أو بخار)",
 "ゆびさき": "بَنَان, أُنْمُلَة (أَطْرَافُ الأَصَابِعِ)\nمثال: لبنان دولة صغيرة. / إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "ゆびさし": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "ゆびざし": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "ゆびざる": "آيْآي",
 "ゆびざわり": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "ゆびづかい": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "ゆびぬき": "كُشْتُبَان, كُسْتِبَان",
 "ゆびのふし": "بُرْجُمَة, مَفْصِل",
 "ゆびむすび": "أبوسوم (جرابي شجري ليلي له ذيل قابض عارٍ يوجد من جنوب أمريكا الشمالية إلى شمال أمريكا الجنوبية) / أبوسوم, فلنجر (جرابيات شجرية أسترالية صغيرة ذات فراء ولها ذيول طويلة قابضة عادة)",
 "ゆびもじ": "تهجئة بالأصابع (أبجدية من الإشارات اليدوية)",
 "ゆびわ": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "ゆびをさす": "اِغْتَابَ, أَبَرَ",
 "ゆびサック": "غطاء الإصبع, كشتبان واقٍ (غلاف يلبس لحماية الإصبع)",
 "ゆふ": "معطف مشمع (معطف ماكنتوش مصنوع من قماش قطني معالج بالزيت والصبغة لجعله مقاوماً للماء)",
 "ゆぶね": "بَانْيُو, مَغْسَل",
 "ゆぶろ": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس) / مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ゆぼけつがん": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "ゆまき": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "ゆまく": "بقعة زيت, بقعة نفطية (طبقة رقيقة من الزيت تطفو على سطح الماء (خاصة النفط الخام المتسرب من السفن))",
 "ゆまり": "بَوْل",
 "ゆみ": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / رِمَايَة",
 "ゆみがた": "قَوْس, مُنْحَنَى / جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل) / جُزْء, فَلْقَة (أحد الأجزاء التي ينقسم إليها الشيء بشكل طبيعي)\nمثال: قسم من صنارة الصيد",
 "ゆみし": "قَوَّاس",
 "ゆみつかい": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "ゆみづかい": "استخدام القوس (إدارة القوس في العزف على آلة وترية) / مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / انحناء (حني الرأس أو الجسم أو الركبة كعلامة على الاحترام أو الخضوع أو التحية)\nمثال: كان استخدام عازف الكمان للقوس ممتازاً",
 "ゆみづる": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "ゆみとり": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ)",
 "ゆみなり": "قَوْس, مُنْحَنَى",
 "ゆみなりになる": "قَوْس",
 "ゆみのこ": "منشار حديدي (منشار يستخدم بيد واحدة لقطع المعدن)",
 "ゆみはり": "تَرْبِيع",
 "ゆみはりづき": "تَرْبِيع",
 "ゆみや": "قَوْس وَسَهْم / سِلَاح, أَسْلِحَة",
 "ゆみをひく": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "ゆむろ": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "ゆめ": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / خِدَاع, ضَلَالَة / غَرُور / أَبَدًا",
 "ゆめうつつ": "ترانس",
 "ゆめうらない": "تفسير الأحلام (التنجيم من خلال تفسير الأحلام)",
 "ゆめおいびと": "حَالِم / حَالِم, حَالِمَة",
 "ゆめがたり": "أضغاث أحلام, حلم بعيد المنال (أمل خيالي ولكنه عبثي (من التخيلات الناتجة عن تدخين الأفيون))\nمثال: لدي هذا الحلم بعيد المنال بأن أكون إمبراطور الكون",
 "ゆめごこち": "نَشْوَة",
 "ゆめじ": "أرض الأحلام, عالم الأحلام (بلد ممتع موجود فقط في الأحلام أو الخيال)",
 "ゆめにも": "أبداً",
 "ゆめのくに": "أرض الأحلام, عالم الأحلام (بلد ممتع موجود فقط في الأحلام أو الخيال)",
 "ゆめまぼろし": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめみがち": "غير واقعي (ليس واقعياً)\nمثال: توقعات غير واقعية",
 "ゆめみぐさ": "زَهْرَة كَرَز",
 "ゆめみどり": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "ゆめみる": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめものがたり": "أضغاث أحلام, حلم بعيد المنال (أمل خيالي ولكنه عبثي (من التخيلات الناتجة عن تدخين الأفيون))\nمثال: لدي هذا الحلم بعيد المنال بأن أكون إمبراطور الكون",
 "ゆめゆめ": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / قَلِيلًا / بِجِدّ / حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめをみる": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "ゆめをむすぶ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "ゆもけつがん": "سجيل زيتي, طفل صفحي زيتي (طفل صفحي يمكن الحصول منه على النفط بالتسخين)",
 "ゆゆしい": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "ゆゆしき": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "ゆらい": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / أَصْلًا",
 "ゆらいがき": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "ゆらぎ": "جَعْبَة",
 "ゆらく": "مُتْعَة, لَذَّة",
 "ゆらぐ": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "ゆらす": "صَخْرَة, حجر / صَخْرَة / رُوك, مُوسِيقَى اَلرُّوك",
 "ゆらめき": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "ゆらめく": "وَمِيض, وَمْضَة / طَرْفَة, وَمْضَة / رَفْرَفَ, خفَقَ",
 "ゆらゆら": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / سطوة, سيادة (تأثير مسيطر)",
 "ゆらり": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / سطوة, سيادة (تأثير مسيطر)",
 "ゆらりゆらり": "تأرجح, تمايل (الترنح بشكل خطير إلى جانب واحد) / سطوة, سيادة (تأثير مسيطر)",
 "ゆらんかん": "قَنَاةُ الْبَيْض",
 "ゆり": "اِهْتِزَاز",
 "ゆりいす": "كرسي هزاز (كرسي مثبت على زلاجات مقوسة تسمح له بالتأرجح)",
 "ゆりうごかす": "هَزَّ",
 "ゆりうごく": "اِقْشَعَرَّ",
 "ゆりかえし": "هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ",
 "ゆりかご": "مَهْد",
 "ゆりかごからはかばまで": "مِنَ ٱلْمَهْدِ إِلَىٰ ٱللَّحْدِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ゆりかごから墓場まで": "مِنَ ٱلْمَهْدِ إِلَىٰ ٱللَّحْدِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ゆりかもめ": "نورس اسود الرأس",
 "ゆりずいせん": "ألستروميريا (أي من النباتات الأمريكية الجنوبية المختلفة من جنس ألستروميريا التي تقدر لخيماتها الجميلة من الزهور)",
 "ゆりのき": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "ゆりの木": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "ゆりもくば": "حصان خشبي, حصان هزاز (لعبة أطفال تتكون من حصان مقلد مثبت على زلاجات؛ يمتطيه الطفل ويتظاهر بالركوب)",
 "ゆりもどし": "هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ",
 "ゆり動かす": "هَزَّ",
 "ゆる": "زَنْبَق, سَوْسَن / هَزَّ",
 "ゆるい": "فَضْفَاض, واسِع / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة) / مُؤَدَّب / بَطِيء / أَبْطَأَ, بَطَّأَ",
 "ゆるか": "فَضْفَاض, واسِع / مُؤَدَّب / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "ゆるがす": "هَزَّ",
 "ゆるがせ": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "ゆるがせにする": "أَهْمَلَ / إِهْمَال",
 "ゆるがない": "رَاسِخ, صَارِم",
 "ゆるぎ": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "ゆるぎない": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "ゆるぐ": "هَزَّ",
 "ゆるし": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "ゆるしがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "ゆるす": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي? / سَامَحَ / غَفَرَ / إحالة الدعوى ((قانون) فعل الإحالة (خاصة إحالة قضية قانونية إلى محكمة أخرى)) / اختصاص, صلاحية (الموضوع الذي يُتوقع من شخص أو لجنة أو بحث التعامل معه أو لديه سلطة التعامل معه)\nمثال: شكلوا مجموعة باختصاص اقتراح طرق لتعزيز الحياة الأسرية / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "ゆるすまじ": "لَا يُغْتَفَرُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ゆるみ": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي",
 "ゆるむ": "اِسْتَرْخَى / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "ゆるめる": "أَرْخَى, حَلَّ / اِسْتَرْخَى / قَلَّلَ",
 "ゆるやか": "فَضْفَاض, واسِع / مُؤَدَّب / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "ゆるゆる": "بِبُطْء",
 "ゆるり": "بتأن, بدون عجلة (بدون تسرع)\nمثال: مضت بتأن",
 "ゆれ": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه / تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "ゆれうごく": "هَزَّ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "ゆれる": "هَزَّ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "ゆれ動く": "هَزَّ / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "ゆわい": "تَهْنِئَة / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "ゆわえつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "ゆわえる": "أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: إن توم لا يملك أسرة.",
 "ゆわかし": "غَلَّايَة",
 "ゆわかしき": "سخان مياه (سخان وخزان تخزين لتوفير المياه الساخنة)",
 "ゆんで": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ゆー": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "よ": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة. / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر. / فَوْقَ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام. / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / يَاه, اسمع / هَلَا / أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "よあかし": "طَوَالَ اللَّيْل (يَسْتَمِرّ أَوْ يَعْمَل طَوالَ اللَّيْل)",
 "よあけ": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "よあけがた": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "よあけのみょうじょう": "نَجْمَة الصَّبَاح",
 "よあそび": "حياة الليل, سهر (نشاط الأشخاص الذين يبحثون عن الترفيه الليلي (كما في المسرح أو الملهى الليلي وما إلى ذلك)) / حياة ليلية, سهر (الترفيه المتاح للأشخاص الذين يبحثون عن التسلية ليلاً)\nمثال: في الصيف تنتقل الحياة الليلية إلى نوادي الرقص",
 "よい": "مَسَاء / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر. / دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "よいおとこ": "حسناء, فاتنة (امرأة جذابة جداً أو مغرية المظهر) / شاهد, متفرج (مراقب عن كثب؛ شخص ينظر إلى شيء ما (مثل عرض من نوع ما))\nمثال: صفق المتفرجون للأداء / حَلِيف, شَخْص طَيِّب (أي شخص يكون في صفك) / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "よいお年を": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "よいがさめる": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "よいがまわる": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "よいぐあいに": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "よいころ": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "よいごこち": "ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول)) / ثَمِل, نَشْوَان (كأنه تحت تأثير الكحول مجازاً)\nمثال: حشد صاخب من البحارة المخمورين",
 "よいごし": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "よいしょ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "よいじかん": "مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "よいち": "اَلسُّوق اَللَّيْلِيّ",
 "よいっしょ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "よいっぱり": "بومة الليل, ساهر (شخص يحب أن يكون نشطاً في وقت متأخر من الليل) / سَهِرَ ((سَهِرَ) يَسْهَرَ سَهَرًا: لَمْ ينَمْ كلَّ اللَّيْل أَو بَعْضَه؛ (سَهِرَ): أَرِق)\nمثال: إنها معتادة على السهر.",
 "よいてんき": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "よいどれ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "よいのくち": "هُبُوط, غَسَق",
 "よいのみょうじょう": "نَجْمَة الْمَسَاء",
 "よいはなし": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "よいひと": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط / عَاشِق, عَاشِقَة / مُغْرَم",
 "よいまちぐさ": "أخدرية, زهرة الربيع المسائية",
 "よいや": "يَع",
 "よいやさ": "يَع",
 "よいやみ": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "よいやよいや": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "よいよい": "تابس ظهري, رنح حركي (زهري يصيب الحبل الشوكي يتميز بتنكس الخلايا العصبية الحسية وآلام طاعنة في الجذع والساقين ومشية غير مستقرة وسلس وبول وعجز جنسي)",
 "よいわるい": "نَوْعِيَّة, جَوْدَة",
 "よいをさます": "صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "よいん": "تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية) / أصداء, تداعيات (عاقبة بعيدة أو غير مباشرة لإجراء ما)\nمثال: كانت تستطيع سماع أصداء خطواتها / طعم لاحق, مذاق متبق (صورة تلوية (أثر متبق) لمذاق ما) / إِيحَائِيَّة (حالة أو صفة الامتلاء بالإيحاءات وتحفيز الفكر)",
 "よいんし": "تميم, عامل مرافق (مادة (مثل الإنزيم المساعد) يجب أن تتحد مع مادة أخرى لإنتاج نتيجة معينة)",
 "よい人": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط / عَاشِق, عَاشِقَة / مُغْرَم",
 "よい天気": "إشراق, طقس صحو (طقس معتدل؛ مناسب للأنشطة الخارجية)",
 "よい時間": "مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "よい頃": "آن الأوان (الوقت الذي كان ينبغي أن يتم فيه شيء ما)\nمثال: لقد آن الأوان لكي تذهب إلى العمل",
 "よう": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر. / شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / إبراز, إخراج (العملية الجسدية لتصريف الفضلات) / إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم) / فَائِدَة, جَدْوَى\nمثال: 労なくして益なし。 — كل شيء وله ثمن / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال. / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة / يانغ (المبدأ الذكوري الإيجابي المشرق في علم الكونيات المزدوج الصيني)\nمثال: الين واليانغ معًا ينتجان كل ما يأتي إلى الوجود / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ / ضَرُورَة, حَاجَة / غَامِق, دَاكِن / جمرة (عدوى أكبر من الدمل ولها عدة فتحات لتصريف القيح) / كاربنكل, ياقوت جمري (عقيق كابوشون أحمر عميق مقطوع بدون أوجه) / تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية) / إرَادَة / رَغْبَة, إرَادَة / لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / عَجَب / تَسَاءَلَ (القوم: سَألوأ بعضهم بعضا؛ المرء: سَألَ نفسه مرة بعد مرة)\nمثال: قطة؟ تساءل الرجل العجوز. / مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ / رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور) / يَاه, اسمع / هَلَا",
 "ようあん": "تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "ようい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / تَحْضِير, إِعْدَاد / أُمّ التَلَافِيف (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "よういく": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: 医者は概して子供の養育の訓練を受けていない。 — الدكاترة ليسوا قاعدة اساسية في التدريب لتربية الاطفال .",
 "よういどん": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "よういにする": "سَهَّلَ (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "よういん": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "よういドン": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "ようえい": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / اضطراب, قلاقل (ثوران أو صخب غير منظم) / رفرفة (خفقان سريع غير طبيعي للأذينين في القلب (خاصة بنظم منتظم)؛ يمكن أن يؤدي إلى حصار القلب)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "ようえき": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا. / خِدْمَة / حيازة زراعية, سوكاج (حيازة الأرض عن طريق الخدمة الزراعية أو دفع الإيجار؛ غير مثقلة بالخدمة العسكرية)",
 "ようえきさいばい": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "ようえきどこう": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "ようえきぶっけん": "حق الانتفاع (حق قانوني في استخدام وجني الأرباح من ممتلكات تخص شخصًا آخر بشرط عدم الإضرار بالممتلكات نفسها بأي شكل من الأشكال)",
 "ようえん": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا) / آسِر, شَائِق (قادر على جذب الانتباه والاستحواذ عليه) / بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان) / نَاءٍ\nمثال: إنها بعيدة جدا.",
 "ようおこし": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "ようおん": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / شَدِيد\nمثال: عندك ذاكرة حادة.",
 "ようおんぷ": "نَبْرَة حَادَّة",
 "ようか": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "ようかい": "شَبَح, خَيَال / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / انحلال, فجور (انغماس منحل في الملذات الحسية) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة) / أَسْمَنْت / سَمْنَتَ / لَخَّصَ, اِخْتَصَرَ / تَدَاخُل",
 "ようかいえき": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "ようかいごど": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "ようかいせい": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل) / إمكانية الحل, قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من الممكن حلها) / ذَائِبِيَّة, قَابِلِيَّة الذَّوَبَان (كمية مادة معينة يمكن أن تذوب في مذيب معين (لإنتاج محلول مشبع))",
 "ようかいど": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل) / إمكانية الحل, قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من الممكن حلها) / ذَائِبِيَّة, قَابِلِيَّة الذَّوَبَان (كمية مادة معينة يمكن أن تذوب في مذيب معين (لإنتاج محلول مشبع))",
 "ようかいりょく": "ذوبانية, قابلية الذوبان (خاصية القابلية للذوبان وسهولة الانحلال في السائل) / إمكانية الحل, قابلية الحل (الخاصية (لمشكلة أو صعوبة) التي تجعل من الممكن حلها) / ذَائِبِيَّة, قَابِلِيَّة الذَّوَبَان (كمية مادة معينة يمكن أن تذوب في مذيب معين (لإنتاج محلول مشبع))",
 "ようかぎん": "يوديد الفضة (يوديد يُستخدم في التصوير الفوتوغرافي، وفي استمطار السحب، وفي الطب)",
 "ようかすいそ": "يوديد الهيدروجين (غاز عديم اللون ينتج حمض الهيدرويوديك في المحلول المائي)",
 "ようかた": "والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له)",
 "ようかぶつ": "يوديد (ملح أو إستر لحمض الهيدرويوديك)",
 "ようかん": "وَرِك",
 "ようかカリウム": "يوديد البوتاسيوم (ملح بلوري يُستخدم في التخليق العضوي وصنع المستحلبات الفوتوغرافية وفي ملح الطعام المعالج باليود)",
 "ようが": "مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة / جُرْثُومَة / برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور))",
 "ようがい": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ようがいけんご": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "ようがさ": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "ようがしや": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
 "ようがらし": "خَرْدَل",
 "ようがん": "حُمَم بُرْكَانِيَّة, لَابَة (الماء: سَخَّنَه؛ الغلام: بدت لحيته) / مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "ようがんびれい": "جاذبية, عنصر جذب (خاصية توفر المتعة وتجذب)\nمثال: الزهور عنصر جذب للنحل",
 "ようき": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد. / مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك. / طَقْس, جَوّ / أَدَاة / تسامي ((في علم النفس) تعديل التعبير الطبيعي عن دافع أو غريزة (خاصة الجنسية) إلى تعبير مقبول اجتماعياً) / تسامي ((في الكيمياء) تغير مباشر من الحالة الصلبة إلى الغازية دون المرور بالحالة السائلة) / شَبَح, خَيَال",
 "ようきが": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية) / رسم ميكانيكي, رسم هندسي (رسم بمقياس لآلة أو مخطط معماري وما إلى ذلك)",
 "ようきせき": "أكتينوليت (معدن أخضر من مجموعة الأمفيبول؛ سيليكات الكالسيوم والمغنيسيوم والحديد)",
 "ようきゅう": "طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / رِمَايَة",
 "ようきゅうがわ": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "ようきゅうがわエスエスりようしゃ": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "ようきゅうしゃ": "مُدَّعٍ, مُدَّعِيَة",
 "ようきゅうしょ": "حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي تم الاستيلاء عليها من أجله) / طلب صرف, نموذج طلب رسمي (نموذج رسمي يتم فيه تقديم طلب (عادة لمواد أو إمدادات)) / اسْتِيلَاء, طَلَب رَسْمِيّ (طلب رسمي أو مطالبة، خاصة من قبل سلطة عسكرية أو عامة تستولي على شيء (عادة مؤقتاً) للاستخدام العسكري أو العام)\nمثال: أولاً عليك ملء طلب الصرف",
 "ようきゅうじこう": "ضَرُورَة / مَطْلَب, طَلَب",
 "ようきゅうはらいよきん": "وديعة تحت الطلب (وديعة بنكية يمكن السحب منها دون إشعار مسبق)",
 "ようきょく": "مِصْعَد / أَنُود",
 "ようきん": "بِيَانُو, مِعْزَف / تحلل بكتيري (انحلال أو تدمير البكتيريا) / عضلة قطنية (أي من عضلتين في البطن والحوض تثني الجذع وتدير الفخذ)",
 "ようぎ": "اِتِّهَام, شَكّ / اِتِّهَام / سُلُوك, تَصَرُّف / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ようぎしゃ": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "ようぎょ": "قَلَى",
 "ようぎょう": "خزف, فن الخزف (فن صنع وزخرفة الفخار)",
 "ようぎん": "فضة ألمانية, فضة النيكل (سبيكة بيضاء فضية تحتوي على النحاس والزنك والنيكل)",
 "ようぐ": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية) / أَدَاة",
 "ようけ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ようけい": "مدجنة, مزرعة دجاج (مزرعة يتم فيها تربية الدجاج للبيع) / شكل الورقة (أي من الأشكال المتنوعة التي يمكن أن تتخذها أوراق النباتات)",
 "ようけいさいるい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "ようけいじょう": "مدجنة, مزرعة دجاج (مزرعة يتم فيها تربية الدجاج للبيع)",
 "ようけいせいじゅく": "استدامة المرحلة اليرقية, نيوطيني (اتجاه تطوري للولادة المبكرة بحيث يتوقف التطور في مرحلة مبكرة ويتم الاحتفاظ بالخصائص الطفولية لدى البالغين من النوع)",
 "ようけつ": "انحلال الدم, تحلل الدم (تحلل كريات الدم الحمراء مع إطلاق الهيموجلوبين)",
 "ようけつせいにょうどくしょうしょうこうぐん": "هُو, خُو",
 "ようけつせいひんけつ": "فقر الدم الانحلالي (فقر دم ينتج عن تدمير كريات الدم الحمراء)",
 "ようけん": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / ضَرُورَة / مَطْلَب, طَلَب",
 "ようげき": "اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته / كَمين / كَمِين / اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "ようげきき": "طائرة اعتراضية, معترضة (طائرة مقاتلة سريعة وقادرة على المناورة مصممة لاعتراض طائرات العدو)",
 "ようげん": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "ようこう": "أَحْمَر, قِرْمِزِيّ (بلون في نهاية الطيف اللوني قرب البرتقالي؛ يشبه لون الدم أو الكرز أو الياقوت) / أحمر كاردينالي, قرمزي (لون متغير يميل إلى الأحمر الزاهي) / لُبّ / نُور الشَّمْس (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره)\nمثال: نسي أن يطفئ النور.",
 "ようこうろ": "فرن صهر, فرن عالي (فرن لصهر الحديد من خامات أكسيد الحديد؛ حيث يتم تكثيف الاحتراق بواسطة تيار من الهواء)",
 "ようこく": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ようこそ": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "ようこん": "جُذَيْر ((في التشريح) بنية صغيرة تشبه الجذر الصغير (مثل لييفة العصب)) / قَضِيب, ذَكَر",
 "ようご": "اِصْطِلَاح, مُصْطَلَح / ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة. / حِمَايَة",
 "ようごかいせつ": "مَسْرَد",
 "ようごさくいん": "كشاف (فهرس لجميع الكلمات الرئيسية في كتاب مع سياقاتها المباشرة) / انسجام, وئام (اتفاق الآراء) / انسجام, توافق (حالة متناغمة للأشياء بشكل عام وخصائصها (مثل الألوان والأصوات)؛ توافق الأجزاء مع بعضها البعض ومع الكل)",
 "ようごしせつ": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "ようごしゃ": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "ようごしゅう": "مَسْرَد",
 "ようごじてん": "مَسْرَد",
 "ようごほう": "عِلْمُ المُصْطَلَحِ (أَدْرَكَ حقيقة الشيء) / مُصْطَلَح (اسم مفعول من الفعل \"اصْطَلَحَ\"؛ كل كلمة لها دلالة معينة، متفق عليها بين العلماء في علم ما)\nمثال: أدرس علم النفس.",
 "ようごろん": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "ようごホーム": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "ようさい": "خِيَاطَة / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / خابث, خباث",
 "ようさいか": "مَعْقِل (الملجأ والجبل المرتفع)\nمثال: رغم أن إيران مشهورة بأنها معقل الفكر الشيعي في عصرنا، إلا أن معظم أهلها كانوا من السنة حتى القرن الخامس عشر.",
 "ようさいし": "خَيَّاطَة",
 "ようさいるい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "ようさん": "إنتاج الحرير من دودة القز / مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي / حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ようさんか": "مربي دود القز (منتج للحرير الخام)",
 "ようざい": "قادر على الوفاء, مليء (قادر على الوفاء بالالتزامات المالية) / إجابة, حل (بيان يحل مشكلة أو يشرح كيفية حل المشكلة) / مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: كانوا يحاولون إيجاد حل سلمي / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "ようし": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / صحيفة, ورقة (ورق يستخدم للكتابة أو الطباعة) / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / بْرُوتُون / زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / خابث, خباث / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بالتأكيد, بلا شك (بدون شك (تستخدم لتعزيز تأكيد)) / مَقْبُول ((استخدام غير معياريّ) مُرْضٍ)\nمثال: ستبلي حسناً بمفردها / شحم الضأن (شحم من جسم خروف ناضج) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "ようしえんぐみ": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "ようしき": "أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ / مرحاض دافق (مرحاض يتم تنظيفه من الفضلات عن طريق تدفق المياه عبره) / رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "ようしきか": "أسلوبية, تنميط (فعل التنميط؛ الجعل مطابقاً لأسلوب معين)",
 "ようしきび": "عَرِيق, مُوَقَّر بِالقِدَم (محترم بسبب القِدَم أو طول الاستخدام) / عَرِيقٌ, مُتَوَارَثٌ (مقبول منذ زمن طويل أو ذو تاريخ عريق)",
 "ようしつ": "مُذاب (المادة المذابة في محلول؛ مكون المحلول الذي يغير حالته)",
 "ようしつこひ": "صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / حلي تافهة, خردوات (أشياء زخرفية ليس لها قيمة كبيرة)",
 "ようしゃ": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟ / تساهل, لين (تخفيف العقوبة أو الإعفاء من عمل روتيني من قبل القضاة أو الآباء أو المعلمين) / تساهل, تهاون (الميل للاستجابة لرغبات شخص ما) / تَسَاهُل, رَأْفَة (الرحمة كنتيجة لكون الشخص ليناً أو متسامحاً)\nمثال: التهاون المفرط يفسد الطفل / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق / تساهل, لين (تخفيف العقوبة أو الإعفاء من عمل روتيني من قبل القضاة أو الآباء أو المعلمين) / تساهل, تهاون (الميل للاستجابة لرغبات شخص ما) / تَسَاهُل, رَأْفَة (الرحمة كنتيجة لكون الشخص ليناً أو متسامحاً)\nمثال: التهاون المفرط يفسد الطفل / رَضِيع",
 "ようしゃなく": "بقسوة بالغة, بلا رحمة (بدون شفقة؛ بطريقة لا ترحم)\nمثال: تعرض لهزيمة نكراء بلا رحمة من قبل خصمه في المجلس",
 "ようしゅってん": "بِحَاجَةٍ لِمَصْدَرٍ",
 "ようしゅつ": "شطف (عملية استخلاص مادة من أخرى عن طريق الغسل بمذيب لإزالة المادة الممتزة من مادة ماصة)",
 "ようしゅん": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "ようしょ": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "ようしょう": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور) / دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية. / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "ようしょうき": "طُفُولَة",
 "ようしょうじ": "طُفُولَة",
 "ようしょく": "استزراع مائي (تربية الحيوانات المائية أو زراعة النباتات المائية للغذاء) / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / تَأَكُّل",
 "ようしょくじょう": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "ようしょっき": "أواني العشاء (أدوات المائدة (الأطباق وصحون التقديم والأوعية وغيرها) المستخدمة في تقديم الوجبة)",
 "ようしん": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن)) / شَبِيه بِالوَرَقَة (يُشبه الورقة في شكله) / والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له) / حكاك (مرض التهابي مزمن للجلد يتميز بحطاطات تعلوها بثور وحكة شديدة)",
 "ようしんけい": "عصب قطني (أي من خمسة أزواج من الأعصاب الشوكية الخارجة من القسم القطني للحبل الشوكي)",
 "ようしんりゅう": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "ようじ": "طِفْل دَارِج (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة. / طُفُولَة / عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب. / سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه) / فُرْشَاة أَسْنَان / شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / ضَرُورَة / مَطْلَب, طَلَب",
 "ようじうお": "سمكة أنبوبية, سمكة الإبرة (سمكة ذات خطم أنبوبي طويل وجسم نحيل مغطى بصفائح عظمية)",
 "ようじき": "طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "ようじきょういく": "طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "ようじぎゃくたい": "إِسَاءَة مُعَامَلَة لِلْأَطْفَال, إِسَاءَة مُعَامَلَة الْأَطْفَال",
 "ようじく": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي) / محور (محور ورقة مركبة أو نورة مركبة)\nمثال: تسبب السقوط في كسر ظهره",
 "ようじご": "كلام الأطفال (الكلام النامي للطفل الصغير) / محاكاة كلام الأطفال (تقليد شخص بالغ لكلام طفل صغير)",
 "ようじごろし": "قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "ようじしぼうりつ": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "ようじせいあいしゃ": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "ようじとつぜんししょうこうぐん": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "ようじゃ": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "ようじゃく": "سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / شبابي, صبياني (متعلق بالأطفال أو الشباب أو مميز لهم أو مناسب لهم) / حدث, قاصر (شخص صغير السن لم يكتمل نموه بعد)\nمثال: سكري الأحداث",
 "ようじゃくかはんのう": "نشوء أريمي (نظرية تفيد بأن الخصائص الموروثة تنتقل عن طريق البلازما الجرثومية) / تبرعم (تكاثر لاجنسي عن طريق التبرعم)",
 "ようじゅう": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته. / وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "ようじゅえん": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "ようじゅつ": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "ようじゅつし": "سَاحِر",
 "ようじゅつしゃ": "سَاحِر",
 "ようじょ": "طِفْلة / ابنة بالتبني (شخص يتم تربيته كابنة على الرغم من عدم وجود صلة قرابة بالولادة) / ساحرة (أنثى تمارس السحر) / فاتنة, مغوية (امرأة تعتبر مغرية بشكل خطير)",
 "ようじょう": "ناي, ناي مستعرض (آلة نفخ خشبية عالية النبرة؛ أنبوب رفيع مغلق من أحد طرفيه بفتحات للأصابع في أحد طرفيه وفتحة بالقرب من الطرف المغلق يتم نفخ الهواء عبرها) / ناي الحفلات الغربي, ناي بوهيم (ناي الحفلات الغربي (يسمى أيضاً الناي المستعرض أو ناي بوهيم) هو آلة نفخ خشبية تُعزف من الجانب ومصنوعة من المعدن أو الخشب) / تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة) / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة / بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة) / بَحْرِيّ, نَحْو البَحْر ((للرياح) قادمة من اليابسة) / بَعِيد عَن الشَّاطِئ (على مسافة من الشاطئ)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر / شَبِيه بِالوَرَقَة (يُشبه الورقة في شكله)",
 "ようじょうけい": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "ようじょうしょくぶつ": "نبات ثالوسي, نبات مشيجي (أي من مجموعة الكائنات اللازهرية التي تتكون أساساً من مشرة (ثالس) وبالتالي لا تظهر تمايزاً إلى ساق وجذر وأوراق)",
 "ようじょうたい": "ثالوس, مشرة (جسم نباتي بدون سيقان أو جذور أو أوراق حقيقية أو نظام وعائي؛ مميز للنباتات الثالوسية)",
 "ようじょうほう": "حمية, نظام علاجي ((طب) خطة منهجية للعلاج (تشمل غالبًا النظام الغذائي))",
 "ようじょうテープ": "شريط اخفاء, شريط ورقي لاصق (شريط لاصق يستخدم لتغطية جزء من السطح لا ينبغي طلائه)",
 "ようじん": "رجل عامي (شخص ذكر لا يحمل لقباً) / اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)\nمثال: 彼は要人だから、そのように扱わねばならない。 — هو شخصية مهمة و يجب أن نعامله على هذا الأساس.",
 "ようじんぶかい": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "ようじんぼう": "حَرَس خَاصّ, حَرَس (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي. / حَانَة, بَار",
 "ようじポルノ": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "ようす": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / حَاجَة, ضَرُورَة / اِحْتَاجَ",
 "ようすい": "سُخْد, سَائِل سَلْوِيّ",
 "ようすいいけ": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "ようすいき": "مضخة الماء (المضخة في نظام تبريد السيارات التي تسبب دوران الماء)",
 "ようすいせんし": "بزل السلى (استخراج السائل الأمنيوسي من المرأة الحامل (بعد الأسبوع الخامس عشر من الحمل) للمساعدة في تشخيص تشوهات الجنين)",
 "ようすいち": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "ようすいぼり": "قناة ري (خندق لتزويد الأراضي الجافة بالمياه صناعياً)",
 "ようすいろ": "قناة ري (خندق لتزويد الأراضي الجافة بالمياه صناعياً)",
 "ようすう": "عَدَد فَرْدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ようすこうかわいるか": "بَيْجِي",
 "ようすこうわに": "قَاطُور صِينِيّ",
 "ようすみ": "مِسْبَار",
 "ようする": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / حَاجَة, ضَرُورَة / اِحْتَاجَ",
 "ようするに": "بِاخْتِصَار",
 "ようず": "لَخَّصَ, اِخْتَصَرَ",
 "ようせい": "يَرَقَة / جِنِّيَّة, سَاحِرَة / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / بَدِيهِيَّة / مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة / تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / قابل للذوبان ((للمادة) قادر على الذوبان في مذيب ما (عادة الماء)) / قابل للحل (قابل للحل أو التفسير)\nمثال: اللغز قابل للحل",
 "ようせいこう": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "ようせいじょ": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "ようせいテープ": "شريط اخفاء, شريط ورقي لاصق (شريط لاصق يستخدم لتغطية جزء من السطح لا ينبغي طلائه)",
 "ようせき": "سِعَة",
 "ようせきりつ": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "ようせつ": "لَحْم, لِحَام (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / لَخَّصَ, اِخْتَصَرَ",
 "ようせつき": "لَحَّام",
 "ようせつこう": "لَحَّام",
 "ようせつぶ": "لَحَمَ (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "ようせん": "قِرْطَاسِيَّة / قطني عجزي (من أو يتعلق بمنطقة أسفل الظهر والجزء الخلفي من الحوض)",
 "ようせんろ": "قُبَّة",
 "ようそ": "مُكَوِّن, جُزْء / عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / يُود",
 "ようそう": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / جانب, ناحية (خاصية أو جانب يجب أخذه بعين الاعتبار) / جانب, وجه (ميزة أو عنصر متميز في مشكلة ما) / إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: تعبير حزين / نمط علاجي, وسيلة علاجية (طريقة للعلاج تتضمن علاجاً علاجياً فيزيائياً أو كهربائياً) / نمط حسي (حاسة معينة) / أُسْلُوب, صِيغَة الفِعْل (تصريفات الفعل التي تعبر عن كيفية تصور المتحدث للفعل أو الحالة) / جِهَة, مُوَجِّه (تصنيف للقضايا على أساس ما إذا كانت تدعي الضرورة أو الإمكانية أو الاستحالة)",
 "ようそうだん": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر) / قَابِلٌ لِلتَّفَاوُض, مَطْرُوحٌ لِلنِّقَاش (يُمْكِنُ التَّفَاوُضُ بِشَأْنِهِ أَوْ تَسْوِيَتُهُ بِالتَّوَافُقِ) / قَابِلٌ لِلاجْتِيَاز (يُمْكِنُ المُرُورُ عَبْرَهُ أَوْ تَخَطِّيه)",
 "ようそうろんり": "منطق الموجهات (نظام منطقي تشبه خصائصه الشكلية مفاهيم أخلاقية ومعرفية معينة) / منطق موجه (الدراسة المنطقية للضرورة والإمكان)",
 "ようそうろんりがく": "منطق الموجهات (نظام منطقي تشبه خصائصه الشكلية مفاهيم أخلاقية ومعرفية معينة) / منطق موجه (الدراسة المنطقية للضرورة والإمكان)",
 "ようそさん": "حمض اليوديك (حمض بلوري قابل للذوبان؛ يستخدم ككاشف ومطهر)",
 "ようそしょう": "تتدود, نغف (إصابة الجسم بيرقات الذباب (عادة من خلال جرح أو فتحة أخرى) أو أي مرض ناتج عن هذه الإصابة)",
 "ようそつ": "جاهل, غير متعلم (شخص يفتقر للمعرفة)",
 "ようそひゃくさんじゅういち": "يود-131 (نظير مشع ثقيل لليود له عمر نصف 8 أيام؛ يستخدم في ملح الصوديوم لتشخيص أمراض الغدة الدرقية ولعلاج تضخم الغدة الدرقية)",
 "ようそひゃくにじゅうご": "يود-125 (نظير مشع خفيف لليود له عمر نصف 60 يوماً؛ يستخدم كمتتبع في دراسات الغدة الدرقية وكعلاج لفرط نشاط الغدة الدرقية)",
 "ようそべつしょり": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / عنصري (متعلق بـ أو كونه عنصراً (كيميائياً)) / جوهري, عاصف (متعلق بالظروف الجوية القاسية)\nمثال: كبريت عنصري",
 "ようそろ": "مَفْهُوم",
 "ようそろう": "مَفْهُوم",
 "ようそん": "تآكل, حت (تآكل بفعل العمليات الكيميائية) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً) / تآكل, تراجع (انخفاض تدريجي لشيء ما) / تآكل, تعرية (حالة يتآكل فيها سطح الأرض بفعل الماء والرياح)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "ようぞん": "مُذَاب, مُنْحَلّ ((لِلْمَادَّةِ الصُّلْبَة) تَحَوَّلَ إِلَى شَكْلٍ سَائِل) / إذابة, ذوبان (عملية التحول إلى محلول)\nمثال: إذابة الملح في الماء",
 "ようたい": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / زِرّ / مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "ようたし": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ようたつ": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "ようだい": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / أرض الجنيات, عالم الخيال (عالم الجنيات المسحور) / أرض الخيال, عالم خيالي (شيء موجود فقط في الخيال (ولكن غالبًا ما يُخطئ في اعتباره واقعًا))",
 "ようだん": "احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة) / انفجار, عطل مفاجئ (عطل مفاجئ في جزء أو جهاز) / اكتساح, فوز سهل (انتصار سهل)\nمثال: انفجر الإطار الأمامي الأيمن",
 "ようだんす": "كُمُودِينُو, أَدْرَاجِيَّة",
 "ようち": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور) / طُفُولِيّ / مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "ようちえん": "رَوْضَة, رَوْضَة أَطْفَال",
 "ようちえんじ": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "ようちえんせい": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "ようちえんバス": "حافلة مدرسية (حافلة تستخدم لنقل الأطفال من وإلى المدرسة)",
 "ようちゃく": "لَحْم, لِحَام (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "ようちゅう": "يَرَقَة / خَادِرَة, شَرْنَقَة",
 "ようちょう": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً / رَشِيق, ظَرِيف / طائر صغير, فرخ طائر (طائر لا يزال صغيراً)",
 "ようつい": "فَقَرَة قَطَنِيَّة",
 "ようついせんし": "بَزْل قَطَنِيّ",
 "ようつう": "مُسْتَدَقّ الظَّهْر",
 "ようつべ": "يُوتِيُوب, يُوتْيُوب",
 "ようてい": "زِرّ",
