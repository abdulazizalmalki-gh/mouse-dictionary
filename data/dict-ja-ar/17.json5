 "ようぶ": "صُلْب, حَقْو (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "ようぶつ": "فَالُوس / شَبَح, خَيَال",
 "ようぶん": "مُغَذٍّ, المُغَذِّي",
 "ようへい": "مُرْتَزِق, مُؤْجِر / وَظَّفَ / سويقة الورقة, معلاق (الساق النحيلة التي تدعم نصل الورقة) / تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "ようへいじゅつ": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي)",
 "ようへき": "جدار استنادي (جدار يُبنى لمقاومة الضغط الجانبي (خاصة الجدار المبني لمنع تقدم كتلة من الأرض))",
 "ようほう": "اِسْتِخْدَام\nمثال: その２語の用法の区別は明瞭である。 — الفرق في الاستخدام بين الكلمتين واضح. / تربية النحل (تربية النحل على نطاق تجاري لإنتاج العسل)",
 "ようほうか": "نَحَّال, عَسَّال",
 "ようほうじょう": "مَنْحَل",
 "ようほうばこ": "خَلِيَّة, قَفِير",
 "ようぼ": "أم بالتبني, أم حاضنة (امرأة تعمل كأم حاضنة وتربي طفل شخص آخر)",
 "ようぼう": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "ようぼく": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر) / خَشَب!\nمثال: نحن نقطع الخشب.",
 "ようま": "شَبَح, خَيَال",
 "ようまく": "سَلى, أَمْنِيُون (جعله يَسْلَو، أي ينسى الهمّ والهجر وغيره مما كان عنده. فرّج همه؛ الشاة ونحوها: نزهى سلاها)",
 "ようまくくう": "تجويف سلوي (التجويف المملوء بالسائل الذي يحيط بالجنين النامي)",
 "ようまくこう": "تجويف سلوي (التجويف المملوء بالسائل الذي يحيط بالجنين النامي)",
 "ようまくるい": "حيوان سلوي (أي عضو من السلويات)",
 "ようむ": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "ようむいん": "بَوَّاب",
 "ようむき": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "ようめい": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ようもう": "صُوف",
 "ようもうざい": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "ようもうざる": "سَعْدَان صُوفِيّ",
 "ようもく": "برنامج دراسي, منهج دراسي (دورة متكاملة من الدراسات الأكاديمية)\nمثال: تم قبوله في برنامج جديد في الجامعة",
 "ようやく": "أَخِيراً / بِٱلْكَاد / شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / خُلَاصَة, مُلَخَّص\nمثال: その報告を１ページに要約せよ。 — لَخِّص التقرير في صفحة.",
 "ようやくしゃ": "موعود (شخص يتم تقديم وعد له)",
 "ようやくすれば": "بِاخْتِصَار",
 "ようやっと": "أَخِيراً / بِٱلْكَاد",
 "ようゆう": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "ようよう": "خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن / ظَافِر, مُنْتَصِر (يَعِيشُ تَجْرِبَةَ النَّصْرِ وَالظَّفَر) / ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح) / رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / صَرِيح, فَجّ (يفتقر إلى الدقّة والخفاء؛ واضح وسافر) / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / عَرِيض, غَيْر مُفَصَّل (غير مفصل أو دقيق؛ يتناول الخطوط العامة فقط) / شَاسِع, وَاسِع / أَخِيراً / بِٱلْكَاد / شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / بَاكٍ / بُكَاء / شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "ようらく": "قِلَادَة",
 "ようらん": "مَهْد / لَخَّصَ, اِخْتَصَرَ / نِيلِيّ",
 "ようらんき": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "ようらんのち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "ようり": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "ようりく": "تفريغ (عمل إخراج حمولة من شيء ما من مركبة أو سفينة أو حاوية، إلخ) / هُبُوط / بَسْطَة",
 "ようりつ": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "ようりゃく": "مَثَال",
 "ようりゅう": "صَفْصَاف, غَرَب",
 "ようりょう": "سِعَة\nمثال: タンクの容量は５０ガロンだ。 — سعة الخزان خمسون جالوناً. / مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / سعة كهربائية, مواسعة (ظاهرة كهربائية يتم فيها تخزين شحنة كهربائية) / جُرْعَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "ようりょうしょ": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ",
 "ようりょうぶんせき": "تحليل حجمي (التحليل الكمي باستخدام أحجام محددة من المحاليل القياسية أو الكواشف) / تحليل حجمي للغازات (تحديد حجم الغازات (أو التغيرات في حجمها) أثناء التفاعل)",
 "ようりょうよく": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "ようりょうをえない": "عَرَضِيّ",
 "ようりょく": "قدرة سحرية (القدرة على أداء السحر)",
 "ようりょくそ": "كلوروفيل, يخضور (أي مجموعة من الأصباغ الخضراء الموجودة في الكائنات التي تقوم بالتمثيل الضوئي)",
 "ようりょくたい": "بلاستيدة خضراء, صانعة خضراء (بلاستيد يحتوي على اليخضور وأصباغ أخرى؛ في النباتات التي تقوم بعملية التمثيل الضوئي)",
 "ようれい": "مِثَال, مَثَل / مِثَال / طُفُولَة / شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "ようれき": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "ようれつ": "مُتَوَسِّط",
 "ようろ": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "ようろうせき": "بيروفيليت (معدن سيليكات ألمنيوم أبيض أو مخضر (يشبه التلك))",
 "ようろうほけん": "تأمين مختلط, تأمين وقفي (تأمين على الحياة بمبلغ محدد يُدفع للشخص المؤمن عليه عند انقضاء فترة زمنية معينة أو لمستفيد معين فور وفاة المؤمن عليه)",
 "ようイオン": "أَيُون مُوجَب, كَاتْيُون (أيون موجب الشحنة)",
 "ようダンス": "كُمُودِينُو, أَدْرَاجِيَّة",
 "よお": "يَاه, اسمع / هَلَا",
 "よか": "خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَدَلًا مِن / أَكْثَر مِن, عَنّ / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "よかく": "تحَدُّب (عملية ثني نفسك في وضعية محدبة) / حدس, شعور غريزي (انطباع بأن شيئًا ما قد يكون هو الحال)\nمثال: كان لديه حدس بأن شيئًا ما قد حدث بشكل خاطئ / حَالَة الْمَفْعُول لَهُ, حَالَة مِنْ حَالَات النُّصْب",
 "よかせぎ": "سَطْو / لُصُوصِيَّة",
 "よかつ": "قَاطِعُ تَمَام",
 "よからぬ": "سَيِّئ, وحش",
 "よかろう": "تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "よかん": "بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "よがら": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "よき": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / خَيْر, صَلَاح ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض)\nمثال: يبدو زيري بخير. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / سِلْعَة\nمثال: إيمي فتاة حسنة. / بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية)",
 "よきしない": "مُفَاجِئ",
 "よきせぬ": "مُفَاجِئ",
 "よきてほん": "قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "よきほど": "بشكل كبير",
 "よきょう": "أَدَاء / مَسْرَحِيَّة / صَدًى",
 "よきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "よきんこうざ": "حِسَاب مَصْرَفِيّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "よきんしゃ": "مودع (شخص أودع مالاً في بنك أو مؤسسة مماثلة)",
 "よきんつうちょう": "دفتر البنك, دفتر التوفير (سجل للودائع والسحوبات والفوائد يحتفظ به المودعون في بنوك معينة)",
 "よぎ": "هواية (نشاط إضافي أو جانبي)",
 "よぎない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "よぎなく": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "よぎなくさせる": "أَكْرَهَ, أَجْبَرَ",
 "よぎょう": "هواية (نشاط إضافي أو جانبي)",
 "よぎょうなく": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "よぎる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "よく": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع. / جَنَاح / بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "よくあつ": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / قَمْع, كَبْت",
 "よくあるごしつもん": "أَسِئْلَة مُكَرَّرَة",
 "よくあるご質問": "أَسِئْلَة مُكَرَّرَة",
 "よくあるしつもん": "أَسِئْلَة مُكَرَّرَة",
 "よくある質問": "أَسِئْلَة مُكَرَّرَة",
 "よくい": "يُوكَاتَا",
 "よくうつ": "إحباط, انقباض (حالة من الاكتئاب السوداوي) / براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء)",
 "よくうつしょう": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "よくうつしょうがいぐん": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
 "よくうつしょうぐん": "اضطراب اكتئابي, اكتئاب سريري (حالة من الاكتئاب وانعدام التلذذ شديدة لدرجة تتطلب تدخلاً سريرياً)",
