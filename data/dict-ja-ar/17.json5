 "もの問いたげ": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل)",
 "もの好き": "فُضُول / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز)\nمثال: دوائر لامتراكزة",
 "もの寂しい": "وَحِيد, مُوحِش",
 "もの思い": "أحلام اليقظة, استغراق (حالة مجردة من الاستغراق)",
 "もの恐ろしい": "مُخيف, مُخيفة",
 "もの悲しい": "حَزِين, زعلان",
 "もの憂い": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط)",
 "もの憂げ": "خَامِلُ الهِمَّة, فَاتِر (يفتقر إلى الحيوية أو النشاط) / سَوْدَاوِيّ, قَتَامِيّ (وقور أو حتّى كئيب في طبعه)",
 "もの書き": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "もの柔らか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "もの欲しげ": "طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
 "もの欲しそう": "تَأَمُّلِيّ, حَنِين (يُظهر حزناً تأمُّلياً وحنيناً هادئاً)",
 "もの淋しい": "وَحِيد, مُوحِش",
 "もの狂おしい": "مَجْنُون, مَحْمُوم (في حالة هياج مفرط؛ مذهول من الخوف أو العاطفة العنيفة)",
 "もの珍しい": "فُضُولِيّ",
 "もの申す": "عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "もの知らず": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد…)\nمثال: ما تقترحه غباء.",
 "もの自体": "شَيْء فِي ذَاتِهِ (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما.",
 "もの臭い": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "もの覚え": "ذَاكِرَة, حَافِظَة",
 "もの言う": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "もの静か": "صَامِت, هَادِئ",
 "もはや": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا. / لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "もはら": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / أساساً, بشكل رئيسي (في الغالب)\nمثال: هو مهتم بشكل رئيسي بالفراشات",
 "もはん": "أُسْوَة (أُسْوَةٌ)",
 "もはんえんぎ": "مَعْرِض",
 "もはんしゅう": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "もはんてき": "نَمُوذَجِيّ",
 "もひとつ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل)\nمثال: أنت محق تماماً",
 "もふもふ": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب) / سكتة دِمَاغِيَّة",
 "もふる": "سكتة دِمَاغِيَّة",
 "もほう": "تَقْلِيد",
 "もほうしゃ": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر)",
 "もほうひん": "تَقْلِيد",
 "もみ": "حَقْل اَلْأَرُزّ (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / هَشِيم / بوسوم طائر, سنجاب طائر (بوسوم ليلي يتحرك بقفزات انزلاقية باستخدام طيات جلدية تشبه المظلة على طول جانبي…)",
 "もみあい": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみあう": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみあげ": "سَوَالِف, سَالِف اَلشَّعْر",
 "もみかわ": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "もみがら": "هَشِيم",
 "もみくしゃ": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみくた": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみくちゃ": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみけし": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "もみけす": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "もみこむ": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もみしだく": "جَعْدَة / تَدْلِيك, تَمْسِيد",
 "もみじ": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "もみじどり": "أَيِّل",
 "もみたてる": "اِنْهَار\nمثال: يوشك الجسر على الانهيار. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "もみほぐす": "تَدْلِيك, تَمْسِيد",
 "もみもみ": "تَدْلِيك, تَمْسِيد / اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح",
 "もみりょうじ": "تَدْلِيك, تَمْسِيد",
 "もみ上げ": "سَوَالِف, سَالِف اَلشَّعْر",
 "もみ合い": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみ合う": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع))",
 "もみ殻": "هَشِيم",
 "もみ消し": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "もみ消す": "أَطْفَأَ (أطفأ بالسحق أو الضغط)\nمثال: أطفئ سيجارتك الآن / خنق, مفصل الركبة (المفصل بين عظم الفخذ والساق في ذوات الأربع؛ يقابل الركبة البشرية)",
 "もみ療治": "تَدْلِيك, تَمْسِيد",
 "もみ皮": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "もみ込む": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "もみ革": "جِلْدِيّ اللَّوْن (بلون البيج المائل إلى الاصفرار كالجلد المدبوغ)\nمثال: السباحة في العراء تعني السباحة عارياً",
 "もむ": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ…)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / تَدْلِيك, تَمْسِيد / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ) / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل.",
 "もめ": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "もめごと": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "もめる": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "もめん": "قُطْن, قُطُن",
 "もめんばり": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة…)",
 "もめ事": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "もも": "خَوْخ / فَخِذ, فَخْذ / مِٱئَة, مِئَة / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "ももいろ": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ)\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "ももしおちゃ": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "ももぞの": "بستان خوخ (بستان من أشجار الخوخ)",
 "ももち": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "ももちどり": "زقزاق (أي من طيور شاطئية عديدة ذات بنية مدمجة نسبياً ومناقير مستقيمة وأجنحة مدببة…)",
 "ももとせ": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة…)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "ももにく": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "ももひき": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "ももよ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "ももんじいや": "جَزَّار, قَصَّاب\nمثال: ضع الجزر في القدر.",
 "ももんじい屋": "جَزَّار, قَصَّاب\nمثال: ضع الجزر في القدر.",
 "ももんじや": "جَزَّار, قَصَّاب\nمثال: ضع الجزر في القدر.",
 "ももんじ屋": "جَزَّار, قَصَّاب\nمثال: ضع الجزر في القدر.",
 "もも肉": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "もや": "سَدِيم",
 "もやい": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ)\nمثال: إنه رسام مشهور.",
 "もやいづな": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "もやいむすび": "عقدة البولين, عقدة الخلاص (عقدة أنشوطية لا تنزلق ولا تنحشر)",
 "もやい結び": "عقدة البولين, عقدة الخلاص (عقدة أنشوطية لا تنزلق ولا تنحشر)",
 "もやい綱": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه)",
 "もやう": "نَصِيب, حِصَّة\nمثال: لم يصب السهم توم. / بِرْكَة, سَبْخَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "もやくや": "مُشْكِلَة, مَتاعِب / مُنْخَفَض",
 "もやし": "برعم الفاصولياء, نبتة الفاصولياء (أي من حبوب الفاصولياء المستنبتة المختلفة: خاصة الماش أو العدس أو فول الصويا…)",
 "もやす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / نَبْتَة",
 "もやもや": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم)",
 "もゆるつち": "فَحْم حَجَرِيّ",
 "もゆるみず": "بترول, نفط خام (زيت داكن يتكون أساساً من الهيدروكربونات)",
 "もよう": "نُمُوذَج, نَمَط / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / نَمُوذَج / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "もようしもの": "تَرْفِيه, تَسْلِيَة",
 "もよおし": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث…)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "もよおしもの": "تَرْفِيه, تَسْلِيَة",
 "もよおす": "مَسَكَ, مسك / تحسس\nمثال: شعر ماريا طويل.",
 "もより": "الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "もらい": "طَرَف",
 "もらいうける": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "もらいご": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "もらいちち": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらいぢ": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらいぢち": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらいて": "مِذْيَاع, رَادِيُو",
 "もらいもの": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "もらいもん": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "もらい乳": "مرضعة (امرأة تُستأجر لإرضاع طفل شخص آخر)",
 "もらい受ける": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "もらい子": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "もらい手": "مِذْيَاع, رَادِيُو",
 "もらい物": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "もらう": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "もらす": "تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا. / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "もらたす": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "もらった": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "もり": "مجالسة الأطفال (عمل جليس الأطفال؛ رعاية الأطفال عندما لا يكون والداهم في المنزل) / حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا…)\nمثال: مشينا في الغابة / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما)\nمثال: قبل تبليغ الاستدعاء / مشرط (سكين جراحي بشفرة مدببة ذات حدين؛ يستخدم للثقب والشقوق الصغيرة) / تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا.",
 "もりあがり": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي)\nمثال: مشهد فراش الموت هو ذروة المسرحية / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "もりあがる": "اِنْتَفَخَ, وَرِمَ",
 "もりあわせ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "もりおか": "مُورْيُوكَا",
 "もりかえす": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "もりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "もりたてる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もりだくさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "もりつち": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "もりど": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "もりのバター": "أَفُوكَادُو",
 "もりばな": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "もりふくろう": "بومة سمراء (بومة أوروبية بنية محمرة لها رأس مستدير وعيون سوداء)",
 "もりもり": "بحماس, بقلب قوي (بمتعة ودون تحفظ)\nمثال: ألقى الصبي بنفسه بحماس في عمله / بحيوية, بنشاط (بطريقة نشطة) / محدب, ناتئ (منحنٍ أو بارز إلى الخارج)",
 "もりやく": "مُمَرِّض\nمثال: هذا المرض قلبي.",
 "もりんが": "خيار شمبر, شجرة المطر الذهبي (شجرة متساقطة الأوراق أو شبه دائمة الخضرة لها زهور بنية داكنة إلى صفراء معطرة في…)",
 "もり立てる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / أَحْيَا / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "もる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مَلَأَ / وَصَفَ\nمثال: إنه أمر مختلف . / خِرِّيج, خِرِّيجَة\nمثال: حرارتي 38 درجة. / تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا.",
 "もれ": "تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا. / إِغْفَال / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "もれきく": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "もれなく": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
 "もれる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف. / جَمَّلَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "もろ": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية)\nمثال: انا احب كلا منهما / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / مَعًا, سَوِيًّا / بشكل بارز, بوضوح (بطريقة بارزة)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر / تَمَامًا",
 "もろい": "سَرِيعُ الكَسْر, هَشّ (قَلِيلُ المُرُونَة؛ يَسْهُلُ تَشَقُّقُهُ أَوِ انْكِسَارُهُ) / رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "もろがみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "もろくも": "بِسُرْعَة, عَاجِلًا",
 "もろこ": "جودجون (سمكة مياه عذبة أوروبية نحيلة صغيرة غالباً ما يستخدمها الصيادون كطعم)",
 "もろこし": "ذُرَة, سرغوم / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم. / صِينِيّ",
 "もろち": "ثَدْي, بز\nمثال: تلقى ياني طلقة في الصدر.",
 "もろてをあげて": "قَلْبًا وَقَالَبًا",
 "もろとも": "مَعًا, سَوِيًّا",
 "もろに": "تَمَامًا",
 "もろは": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "もろはのけん": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "もろはのつるぎ": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "もろばれ": "سر مكشوف (شيء من المفترض أن يكون سرياً ولكنه معروف بشكل عام)\nمثال: كانت علاقة حبهما سراً مكشوفاً",
 "もろひと": "الْجَمِيع, كُلّ شَخْص",
 "もろびと": "الْجَمِيع, كُلّ شَخْص",
 "もろみ": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "もろもろ": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "もろ刃": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "もろ刃の剣": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "もわっと": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "もわもわ": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "もん": "أُقْنُوم / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / مَسّ, تَلَبُّس / أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت / نَوْعِيَّة, جَوْدَة / بَوَّابَة / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة. / شُعْبَة / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / نُمُوذَج, نَمَط / وَرَقَة لَعْب, وَرَقَة / لغة مون (لغة مون-خمير التي يتحدث بها شعب مون) / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين / أَلَم (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "もんいん": "إِمْبِرَاطُورَة الأُمّ",
 "もんえい": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "もんか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "もんかしょう": "مستشارية (مبنى حكومي يضم مكتب المستشار)",
