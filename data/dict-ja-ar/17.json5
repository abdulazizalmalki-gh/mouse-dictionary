 "れんかばん": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "れんかひん": "فِي المُتَنَاوَل, مَيْسُور التَّكْلِفَة (يمكن تحمل تكلفته مالياً)",
 "れんかん": "صِلَة, صُلَة / عَلَاقَة, صِلَة / ملعب غولف ساحلي (ملعب غولف مبني على أرض رملية بالقرب من الشاطئ)",
 "れんが": "طُوبَة, لَبِنَة",
 "れんがづくり": "أعمال الطوب, بناء بالطوب (بناء يتم باستخدام الطوب والملاط)",
 "れんき": "إدراج, سرد (فعل عمل قائمة بالعناصر) / قائمة (قاعدة بيانات تحتوي على مصفوفة مرتبة من العناصر (أسماء أو موضوعات))",
 "れんきんじゅつ": "اَلْخِيمِيَاء, خِيمِيَاء / بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال) / صانع ثروة, كاسب المال (شخص ناجح في جمع الثروة)",
 "れんきんじゅつし": "خِيمِيَائِيّ",
 "れんぎん": "با دو دو, رقص ثنائي ((في الباليه) رقصة لشخصين (عادة راقصة باليه وراقص نبيل)) / ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً)\nمثال: الخطيبان / بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "れんく": "بيت مزدوج, ثنائية (مقطع يتكون من سطرين متتاليين من الشعر؛ عادة ما يكون مقفى) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)",
 "れんけい": "صِلَة, صُلَة / عَلَاقَة, صِلَة / تَعَاوُن / مُكَامَلَة",
 "れんけいプレー": "عَمَل جَمَاعِيّ (عمل تعاوني يقوم به فريق (خاصة عندما يكون فعالاً))\nمثال: سيتطلب الأمر المال والتخطيط الجيد، وقبل كل شيء، العمل الجماعي / تَعَاوُن",
 "れんけつ": "صِلَة, صُلَة / عَلَاقَة, صِلَة / نَزِيه, صَادِق",
 "れんけつき": "رابط, موصل (أداة تقوم بالربط أو التوصيل)\nمثال: قام بلحام الوصلة",
 "れんけつし": "رَابِطَة, رَابِط",
 "れんけつせい": "اتصال, ترابط (خاصية كون الشيء متصلاً أو الدرجة التي يمتلك بها الشيء اتصالات)",
 "れんけつもう": "ويب",
 "れんけつもうひょうじ": "مَنْظَر, مَشْهَد",
 "れんげざ": "وضع اللوتس, وضعية زهرة اللوتس (وضع جلوس مع تقاطع الساقين؛ يستخدم في اليوغا)",
 "れんげん": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "れんこう": "أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة / تَحَالُف, اِتِّحَاد",
 "れんこん": "علامة تموج (واحدة من سلسلة من الحواف الصغيرة الناتجة في الرمال بواسطة التيارات المائية أو الرياح)",
 "れんご": "كلمة مركبة, مركب (كلمة تتكون من أي مجموعة متنوعة من الكلمات أو الصيغ التركيبية أو اللواحق) / رَابِطَة, رَابِط",
 "れんごう": "اِتِّحَاد, اِتِّفَاق (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…) / زَوَاج\nمثال: عاش الاتحاد السوفيتي! / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "れんごうおうこく": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "れんごうかい": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "れんごうぐん": "الْحُلَفَاء",
 "れんごうこく": "الْحُلَفَاء",
 "れんごうこくぐんさいこうしれいかんそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうこくさいこうしれいかんそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうこくそうしれいぶ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "れんごうさくせん": "عملية مشتركة (عملية عسكرية تنفذ بالتعاون بين دولتين حليفتين أو أكثر أو عملية عسكرية تنفذ بتنسيق القوات البحرية والبرية والجوية)",
 "れんごうたい": "اِتِّحَادِيَّة, فِدِرَالِيَّة",
 "れんごうや": "منطقة الترابط (مناطق قشرية ليست حركية ولا حسية ولكن يُعتقد أنها تشارك في المعالجة العليا للمعلومات)",
 "れんごく": "مَطْهَر",
 "れんさ": "سِلْسِلَة / ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية)",
 "れんさい": "نشر متسلسل (النشر في شكل متسلسل)",
 "れんさいしょうせつ": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات) / تَتَابُعِيّ, تَسَلْسُلِيّ (يتعلق بالتنفيذ المتتابع لعمليات متعددة) / تسلسلي (يخص أو يحدث في أو ينتج سلسلة) / تسلسلي (يخص أو مؤلف بتقنية تسلسلية (في الموسيقى))\nمثال: زواج أحادي متسلسل",
 "れんさきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "れんさきゅうきんせいいんとうえん": "التهاب الحلق العقدي (عدوى في البلعوم الفموي واللوزتين بواسطة المكورات العقدية)",
 "れんさく": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "れんさぐん": "جينات مرتبطة, مجموعة ارتباط (أي زوج من الجينات يميل إلى الانتقال معاً)",
 "れんさじょうきゅうきん": "ستربتوكوكس, مكورة عقدية (بكتيريا كروية موجبة الجرام توجد في أزواج أو سلاسل؛ تسبب أمراضاً مثل الحمى القرمزية والتهاب اللوزتين)",
 "れんさつ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "れんさてき": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)",
 "れんさてん": "متجر ضمن سلسلة (واحد من سلسلة متاجر بيع بالتجزئة تحت نفس الإدارة وتبيع نفس البضائع)",
 "れんさはんのう": "تَفَاعُل مُتَسَلْسِل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)",
 "れんざ": "تَلَازُم",
 "れんざん": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "れんしゅう": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "れんしゅうあいて": "شريك تدريب (ملاكم يتدرب معه ملاكم آخر استعداداً لنزال مهم)",
 "れんしゅうき": "مُدَرِّب, مُدَرِّبَة",
 "れんしゅうきょく": "إيتود, دراسة موسيقية (تأليف قصير لآلة منفردة؛ يهدف كتمرين أو لإظهار البراعة التقنية)",
 "れんしゅうじあい": "مباراة استعراضية, مباراة ودية (مباراة لا يتم تسجيل نتيجتها في الترتيب الرسمي للموسم)",
 "れんしゅうじょ": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "れんしゅうじょう": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "れんしゅうせい": "طَالِب, طَالِبَة",
 "れんしゅうちょう": "دَفْتَر, كُرَّاس",
 "れんしゅうもんだい": "تَمْرِين, تَدْرِيب / تَمَرَّنَ",
 "れんしゅうをつむ": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "れんしゅく": "تَشَنُّج",
 "れんしょう": "سلسلة انتصارات (فترة متصلة من الانتصارات)",
 "れんしょうしき": "تَنَبَّأَ / تَوَقُّع",
 "れんしょうたんしき": "إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "れんじ": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن) / رَابِطَة, رَابِط / شعار, لوغو (شعار أو رمز لشركة)",
 "れんじつ": "يَوْمًا بَعْدَ يَوْم",
 "れんじゃく": "جناح الشمع (طيور مغردة ذات ريش مخملي بني في نصف الكرة الشمالي لها رؤوس متوجة وأطراف أجنحة شمعية حمراء)",
 "れんじゅう": "سَرِيَّة / شَرِكَة / فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "れんじゅく": "إِمْكَان",
 "れんじゅけい": "اللمنيسكات, منحنى الثمانية (أي من المنحنيات الجبرية المستوية التي تكون على شكل الرقم ثمانية)",
 "れんじょう": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة. / داء العشق, لوعة الحب (حنين وشوق لحبيب) / سَنْدْهِي, وَصْل / رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "れんせい": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)",
 "れんせいけい": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "れんせつ": "صِلَة, صُلَة / عَلَاقَة, صِلَة / وَصْلَة",
 "れんせつてき": "مُلْتَحِم, مُتَرَابِط",
 "れんせつとし": "تكتل حضري, تمدد حضري (تجمع أو شبكة متصلة من المجتمعات الحضرية)",
 "れんそう": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية. / دَفْن (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "れんそうはいれつ": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "れんぞく": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / إطالة, تمديد (نتيجة إطالة المدة) / الاستمرارية الجيدة, قانون الاستمرارية (مبدأ تنظيم غيشتالتي ينص على وجود ميل فطري لإدراك الخط كاستمرار لاتجاهه المحدد) / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / مُتَوَاصِل, مُتَّصِل",
 "れんぞくさつじんき": "قَاتِل مُتَسَلْسِل, قَاتِلَة مُتَسَلْسِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة)\nمثال: بيتي قاتلة أمك.",
 "れんぞくさつじんはん": "قَاتِل مُتَسَلْسِل, قَاتِلَة مُتَسَلْسِلَة (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة)\nمثال: بيتي قاتلة أمك.",
 "れんぞくせい": "استمرار, ثبات (خاصية فترة زمنية مستمرة ومتصلة) / الكونتنيويتي, نص التتابع (نص مفصل يستخدم في صنع الأفلام لتجنب الانقطاع بين اللقطات) / استمرارية, تواصل (اتصال أو اتحاد غير منقطع)",
 "れんぞくたい": "استمرارية, متصل (كل مستمر غير مكاني أو مدى أو تتابع لا يكون فيه أي جزء أو قسم متميزاً أو قابلاً للتمييز عن الأجزاء المجاورة)",
 "れんぞくてき": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع) / بِالتَّتَابُع, بِالتَّسَلْسُل (بطريقة تسلسلية) / مُتَتَالٍ, مُتَعَاقِب (مُتَتَابِعٌ دُونَ انْقِطَاع) / مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)\nمثال: رقمنا الأوراق بالتتابع",
 "れんぞくわざ": "فرقة جاز, كومبو (فرقة صغيرة من موسيقيي الجاز)",
 "れんたい": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية. / مُشْتَرَك / مِفْصَل / فَوْج",
 "れんたいかく": "حَالَة اَلْمُضَاف إِلَيْهِ, مَجْرُور",
 "れんたいさいむ": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "れんたいせきにん": "مسؤولية تضامنية, مسؤولية مشتركة (عندما يكون شخصان أو أكثر مسؤولين عن دين أو مطالبة أو حكم قضائي)\nمثال: المسؤولية المشتركة عن الدين هي نتيجة لتقديم طرفين أو أكثر طلباً للحصول على الائتمان كمقترضين مشاركين",
 "れんたつ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "れんたつのし": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "れんたん": "قالب فحم (كتلة مصنوعة من الفحم النباتي أو غبار الفحم وتحرق كوقود) / إكسير الحياة (مادة افتراضية يعتقد أنها تحافظ على الحياة إلى أجل غير مسمى؛ كان يسعى إليها الخيميائيون) / إكزاكتا (رهان على اختيار الفائزين بالمركزين الأول والثاني بالترتيب الصحيح)",
 "れんたんじゅつ": "اَلْخِيمِيَاء, خِيمِيَاء",
 "れんだ": "قصف مركز, وابل (النار الكثيفة للمدفعية لإشباع منطقة بدلاً من ضرب هدف محدد) / تدفق, وابل (التدفق السريع والمستمر للتواصل اللغوي (المنطوق أو المكتوب))\nمثال: أطلقوا وابلاً من النيران أمام القوات المتقدمة",
 "れんちゃく": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "れんちゅう": "سَرِيَّة / شَرِكَة",
 "れんちょく": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "れんぢゅう": "سَرِيَّة / شَرِكَة / فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "れんつう": "اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "れんてつ": "حديد مطاوع (حديد يحتوي على نسبة منخفضة من الكربون وهو متين وقابل للطرق وبالتالي يمكن تشكيله ولحامه)",
 "れんど": "مَهَارَة",
 "れんどうき": "إمساك, قبضة (فعل الإمساك) / دبرياج, قابض (قارنة تربط أو تفصل الأجزاء الدافعة والمدفوعة لآلية القيادة) / دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة) / حقيبة يد صغيرة, كلاتش (حقيبة نسائية بدون حمالات تُحمل في اليد)\nمثال: أرخى قبضته عن ذراعي",
 "れんどうせい": "ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية)",
 "れんどうそうち": "تداخل, تشابك (فعل التشابك أو التداخل) / جهاز منع التشغيل, قفل تعشيق (جهاز يمنع محرك السيارة من البدء)\nمثال: تشابك أذرع الشرطة أبقى الحشد تحت السيطرة",
 "れんにゅう": "حَلِيب مَكْثِف (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "れんねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "れんばんじょう": "عَرِيضَة, طَلَب",
 "れんぱつ": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة / ضربة طائرة (رد تنس يتم بضرب الكرة قبل ارتدادها) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية)\nمثال: فاجأتهم رشقنا من الجناح الأيسر",
 "れんぱつじゅう": "سلاح ناري متكرر الرمي (سلاح ناري يمكنه إطلاق عدة طلقات دون إعادة تلقيم)",
 "れんびん": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة.",
 "れんぶんすう": "كَسْر مُسْتَمِرّ (كسر بسطه عدد صحيح ومقامه عدد صحيح زائد كسر بسطه عدد صحيح ومقامه عدد صحيح زائد كسر وهكذا)",
 "れんぺい": "تدريب عسكري (التدريب على المسير واستخدام الأسلحة)",
 "れんぺいじょう": "ساحة العرض (منطقة لإقامة العروض (خاصة العسكرية))",
 "れんぼ": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "れんぼいん": "مُصَوِّت مُزْدَوِج",
 "れんぽう": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال / اِتِّحَادِيَّة, فِدِرَالِيَّة",
 "れんぽうおうこく": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "れんぽうかんく": "مُقَاطَعَة فِدِرَالِيَّة",
 "れんぽうこうくうかんりきょく": "إدارة الطيران الفيدرالية (وكالة في وزارة النقل مسؤولة عن سلامة الطيران المدني)",
 "れんぽうこっか": "دَوْلَةٌ اِتِّحَادِيَّة, وِلَايَةٌ اِتِّحَادِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "れんぽうさいこうさいばんじょ": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "れんぽうさいばんしょ": "محكمة فيدرالية (محكمة أنشأتها سلطة حكومة فيدرالية)",
 "れんぽうしゅぎ": "اتحادية, فيدرالية (فكرة التنظيم الفيدرالي لوحدات تتمتع بحكم ذاتي إلى حد ما)",
 "れんぽうじゅんびぎんこう": "بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "れんぽうじゅんびせいど": "الاحتياطي الفيدرالي, الفيدرالي (البنك المركزي للولايات المتحدة؛ يضم 12 بنكاً فرعياً للاحتياطي الفيدرالي وجميع البنوك الوطنية والبنوك التجارية المرخصة من الدولة وبعض شركات الائتمان)\nمثال: يسعى الفيدرالي للسيطرة على اقتصاد الولايات المتحدة من خلال رفع وخفض أسعار الفائدة قصيرة الأجل والمعروض النقدي",
 "れんぽうじゅんびせいどりじかい": "مجلس الاحتياطي الفيدرالي (المجلس المكون من سبعة أعضاء الذي يحكم نظام الاحتياطي الفيدرالي)",
 "れんぽうじゅんびりじかい": "مجلس الاحتياطي الفيدرالي (المجلس المكون من سبعة أعضاء الذي يحكم نظام الاحتياطي الفيدرالي)",
 "れんぽうせいど": "اتحادية, فيدرالية (فكرة التنظيم الفيدرالي لوحدات تتمتع بحكم ذاتي إلى حد ما)",
 "れんぽうせいふ": "حُكُومَة اَلاِتِّحَادِيَّة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "れんぽうせいふかんけいきかん": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "れんぽうせいふさいばんしょ": "محكمة فيدرالية (محكمة أنشأتها سلطة حكومة فيدرالية)",
 "れんぽうそうさきょく": "مكتب التحقيقات الفيدرالي (وكالة إنفاذ قانون فيدرالية تعد ذراع التحقيق الرئيسي لوزارة العدل)",
 "れんぽうちょっかつち": "مُقَاطَعَة فِدِرَالِيَّة",
 "れんぽうつうしんいいんかい": "لجنة الاتصالات الفيدرالية (وكالة حكومية مستقلة تنظم الاتصالات بين الولايات والاتصالات الدولية عبر الراديو والتلفزيون والأسلاك والكابلات والأقمار الصناعية)",
 "れんぽうとりひきいいんかい": "لجنة التجارة الفيدرالية (وكالة مستقلة تابعة للحكومة الفيدرالية الأمريكية تحافظ على المنافسة العادلة والحرة؛ تطبق قوانين مكافحة الاحتكار الفيدرالية؛ وتثقف الجمهور حول سرقة…)",
 "れんぽうぼうえきいいんかい": "لجنة التجارة الفيدرالية (وكالة مستقلة تابعة للحكومة الفيدرالية الأمريكية تحافظ على المنافسة العادلة والحرة؛ تطبق قوانين مكافحة الاحتكار الفيدرالية؛ وتثقف الجمهور حول سرقة…)",
 "れんま": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "れんめい": "عُصْبَة, اِتِّحَاد / دَوْرِيّ (لُفِّي؛ اسْتَدِيرِي)\nمثال: كان دوري كي أنظف المسكن",
 "れんめん": "سَلِيم, غَيْر مَكْسُور (غير مكسور؛ كامل وسليم؛ قطعة واحدة) / مَحْفُوظ, مُوفًى بِه ((خاصة للوعود أو العقود) لم يتم انتهاكه أو تجاهله) / غَيْر مُتَقَطِّع, مُتَّصِل (يتميز بامتدا مستمر أو غير منقطع في المكان أو الزمان أو التسلسل) / بور, غير محروث ((للأراضي الزراعية) لم تحرث)\nمثال: لحسن الحظ العدسة الأخرى سليمة",
 "れんらく": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "れんらくいん": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "れんらくじこう": "رِسَالَة, خَبَر",
 "れんらくせん": "مُعَدِّيَة, عَبَّارَة",
 "れんらくつうろ": "دهليز, ممر (ممر بين الغرف أو بين المباني) / ممر (مسار أو قناة أو مجرى يمكن أن يمر عبره أو من خلاله شيء ما)\nمثال: الممرات الأنفية",
 "れんらくどうろ": "طريق فرعي, مدخل طريق (طريق قصير يتيح الوصول إلى طريق سريع)",
 "れんらくをいれる": "مُلَامَسَة, لَمْسَة / اِتِّصَال, عَلَاقَة / اِتَّصَلَ",
 "れんらくをたつ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "れんりつ": "تَحَالُف, اِئْتِلَاف",
 "れんりつほうていしき": "معادلات آنية, نظام معادلات (مجموعة من المعادلات في متغيرين أو أكثر توجد لها قيم يمكن أن تحقق جميع المعادلات في وقت واحد)",
 "れんるい": "تواطؤ (الذنب كشريك في جريمة أو مخالفة)",
 "れんれん": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / مُتَوَاصِل, مُتَّصِل",
 "れんツイ": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "れん乳": "حَلِيب مَكْثِف (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "ろ": "رُوسِيَا (دولة يقع جزء منها في شمال شرق أوروبا، والجزء الأكبر في شمال آسيا؛ اسمها الرسمي الاتحاد الروسي، وعاصمتها موسكو، وهي أكبر دولة في العالم من حيث المساحة)\nمثال: زوجتي من روسيا. / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار. / كانون / فرن (حجرة مغلقة يتم فيها إنتاج الحرارة لتدفئة المباني، أو تدمير النفايات، أو صهر الخامات وتنقيتها، وما إلى ذلك) / صبية, فتاة (فتاة أو شابة غير متزوجة) / سِتَّة / صَارِم, مُتَشَدِّد / مُؤَخَّرَة / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / لوتيشيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "ろあくてき": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "ろう": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة / شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران) / برج صغير, بريج (برج صغير يمتد فوق مبنى) / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت. / شَيْخُوخَة, عُجُوز / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن. / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق. / سبيكة لحام, مادة اللحام (سبيكة (عادة من الرصاص والقصدير) تستخدم عند صهرها لربط سطحين معدنيين) / سِتَّة / ضَيْق / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / صَمَم",
 "ろうあ": "صَمَم / صمم وبكم (صمم خلقي يؤدي إلى عدم القدرة على الكلام)",
 "ろうえい": "تِلَاوَة / تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "ろうえき": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "ろうえん": "فَنَار / مَنَار",
 "ろうおう": "شَيْخ, عَجُوز",
 "ろうおく": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "ろうか": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق. / آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة) / تقدم في السن, شيخوخة (العملية العضوية للتقدم في العمر وظهور آثار زيادة السن) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت) / ضوء الإشارة, نار الإشارة (نار تُشعل كإشارة)",
 "ろうかい": "مَاكِر",
 "ろうかく": "قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ろうかつ": "مَاكِر",
 "ろうかぼうしざい": "مضاد للأكسدة (مادة تمنع الأكسدة أو تمنع التفاعلات التي يعززها الأكسجين أو البيروكسيدات)",
 "ろうかん": "مَرْقَب, بُرْج الْمُرَاقَبَة / نَاسُور",
 "ろうがい": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "ろうがみ": "وَرَق شَمْع, مُهْرَق (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "ろうがん": "قُصُوُّ البَصَرِ الشَيْخُوخِيّ",
 "ろうき": "تذكر, ذاكرة (العمليات المعرفية التي يتم من خلالها تذكر التجارب السابقة)\nمثال: يمكنه فعل ذلك من الذاكرة",
 "ろうきゅう": "ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة)) / كُرَة اَلسَّلَّة",
 "ろうきゅうか": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة)",
 "ろうきゅうしゃ": "بَالٍ",
 "ろうきょ": "تَقَاعُد",
 "ろうきょう": "شَيْخُوخَة, عُجُوز",
 "ろうぎん": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت / تِلَاوَة",
 "ろうく": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "ろうくみ": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "ろうくん": "شاب (مراهق أو شاب بالغ ذكر) / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "ろうけつぞめ": "باتيك",
 "ろうけつ染め": "باتيك",
 "ろうけん": "انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "ろうこ": "مَالُوش, حَالُوش / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "ろうこう": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة) / نَاسُور",
 "ろうこく": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً / سَاعَةٌ مَائِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "ろうこつ": "شَيْخ, عَجُوز",
 "ろうご": "شَيْخُوخَة, عُجُوز",
 "ろうごく": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "ろうさい": "أثناء العمل, وظيفي (متعلق بـ أو مرتبط بوظيفة أو توظيف)\nمثال: تدريب أثناء العمل",
 "ろうさく": "كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "ろうさくうた": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "ろうざいく": "تمثال شمع (تمثال (عادة لشخص مشهور) مصنوع من الشمع) / حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "ろうし": "لَاو تْسِي, لَاو تْزِه / معلم قديم (رسام أوروبي عظيم عاش قبل القرن التاسع عشر) / وَرَق شَمْع, مُهْرَق (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء. / رُونِين / قُصُوُّ البَصَرِ الشَيْخُوخِيّ",
 "ろうしゃ": "أَصَمّ",
 "ろうしゅ": "مُحَارِب قَدِيم",
 "ろうしゅつ": "تَسْرِيب",
 "ろうしょう": "تِلَاوَة / تابس, هزال (هزال الجسم أثناء مرض مزمن)",
 "ろうじつ": "وَفَاء, إِخْلَاص",
 "ろうじゃく": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب / عُنْف, عَنْف / عُنْف",
 "ろうじゅく": "نَضْج",
 "ろうじょう": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية / شُرْفَة",
 "ろうじん": "عجوز, كبير السن (شخص متقدم في السن)",
 "ろうじんいがく": "طب الشيخوخة (فرع العلوم الطبية الذي يتعامل مع الأمراض والمشاكل الخاصة بكبار السن)",
 "ろうじんがく": "طب الشيخوخة (فرع العلوم الطبية الذي يتعامل مع الأمراض والمشاكل الخاصة بكبار السن)",
 "ろうじんせい": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "ろうじんせいしきそはん": "بقعة كبدية (نوع من الأمراض الجلدية يسبب بقعاً بنية على الجلد)",
 "ろうじんせいちほう": "خرف الشيخوخة, ذهان الشيخوخة (خرف يصيب المسنين؛ ينتج عن تنكس الدماغ في غياب الأمراض الوعائية الدماغية)",
 "ろうじんせいちほうしょう": "خرف الشيخوخة, ذهان الشيخوخة (خرف يصيب المسنين؛ ينتج عن تنكس الدماغ في غياب الأمراض الوعائية الدماغية)",
 "ろうじんせいにんちしょう": "خرف الشيخوخة, ذهان الشيخوخة (خرف يصيب المسنين؛ ينتج عن تنكس الدماغ في غياب الأمراض الوعائية الدماغية)",
 "ろうじんせいはくないしょう": "مُرْتَبِطٌ بِالْعُمْرِ (يتغير (زيادة أو نقصاناً) مع تقدم عمر الفرد)",
 "ろうじんはん": "لويحة أميلويد (لويحة تتكون من تشابك بروتين الأميلويد في الأنسجة العصبية (علامة مرضية لمرض الزهايمر)) / بقعة كبدية (نوع من الأمراض الجلدية يسبب بقعاً بنية على الجلد)",
 "ろうじんびょうがく": "طب الشيخوخة (فرع العلوم الطبية الذي يتعامل مع الأمراض والمشاكل الخاصة بكبار السن)",
 "ろうじんふくししせつ": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "ろうじんホーム": "بَيْتُ تَقاعُدٍ, دَار مُسِنِّين (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ろうすい": "خرف, هرم (حالة الخرف) / خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "ろうする": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ / سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي. / أَصَمَّ / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "ろうせい": "نَاضِج, رَاشِد / سَابِقُ النُّضْج, مُبَكِّرُ النُّمُوّ (يظهر أو ينمو في وقت مبكّر) / مبكر النضوج, نابغ (يتميز بالتطور أو النضج المبكر بشكل استثنائي (خاصة في القدرات العقلية))\nمثال: طفل نابغ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / اَلشِّعْرَى, الشِّعْرَى الْيَمَانِيَّة",
 "ろうせずして": "بِسُهُولَة",
 "ろうせつ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "ろうぜき": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب / عُنْف, عَنْف / عُنْف",
 "ろうぜきもの": "مثير للشغب, مشاغب (مثير للمتاعب يشارك في اضطرابات عنيفة تخل بالأمن؛ شخص يتمرد على السلطة القائمة)",
 "ろうそ": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "ろうそう": "ذِئْبَة / زمعة",
 "ろうそうしそう": "طَاوِيَّة",
 "ろうそく": "شَمْعَة, قِنْدِيل (عَمود تُعمَد عليه القَنْطَرة؛ وحدة تُقاس بها القوَّة الكهربائيَّة)\nمثال: أشعل سيسيل شمعة.",
 "ろうそくあし": "شَمْعَدَان, قِنْدِيل",
 "ろうそくたて": "حامل الشموع, شمعدان (حامل ذو تجاويف لتثبيت الشموع)",
 "ろうそくや": "شَمَّاع",
 "ろうそく屋": "شَمَّاع",
 "ろうそく立て": "حامل الشموع, شمعدان (حامل ذو تجاويف لتثبيت الشموع)",
 "ろうぞめ": "باتيك",
 "ろうたける": "نَاضِج, رَاشِد",
 "ろうたし": "فَاتِن, جَذَّاب",
 "ろうだい": "عجوز, كبير السن (شخص متقدم في السن)",
 "ろうだん": "اِحْتِكَار, اِنْحِصَار",
 "ろうちん": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "ろうでん": "دائرة قصر, ماس كهربائي (تلامس عرضي بين نقطتين في دائرة كهربائية يوجد بينهما فرق جهد)",
 "ろうと": "قِمْع",
 "ろうとう": "تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي)",
 "ろうとうはい": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / طرفي, نهائي (كائن أو واقع في النهاية أو الطرف) / دوري, فصلي (متعلق بـ أو يحدث في فصل دراسي أو فترة زمنية محددة)\nمثال: العمود الطرفي",
 "ろうとして": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "ろうどう": "تابِع إِقْطاعِيّ, خادِم (شخص يملك إقطاعية؛ شخص يدين بالولاء والخدمة لسيد إقطاعي) / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة / حزب العمال (حزب سياسي يسار الوسط تم تشكيله لتمثيل مصالح العمال العاديين) / حزب العمال البريطاني (حزب سياسي تشكل في بريطانيا العظمى عام 1900؛ يتميز بتعزيز مصالح العمل وسابقاً تأميم الصناعات الرئيسية)",
 "ろうどううんどう": "حركة النقابات, حركة عمالية (محاولة منظمة من قبل العمال لتحسين وضعهم عن طريق العمل الموحد (خاصة عبر النقابات العمالية))",
 "ろうどうか": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "ろうどうかいきゅう": "اَلطَّبَقَة الْعَامِلَة",
 "ろうどうきせい": "دغريات",
 "ろうどうきょうやく": "اتفاقية جماعية, عقد عمل جماعي (عقد بين العمال والإدارة ينظم الأجور والمزايا وظروف العمل)",
 "ろうどうきょかしょう": "تصريح عمل (وثيقة قانونية تعطي المعلومات المطلوبة لتوظيف أشخاص معينين في بلدان معينة)",
 "ろうどうくみあい": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة",
 "ろうどうけいやく": "اتفاقية جماعية, عقد عمل جماعي (عقد بين العمال والإدارة ينظم الأجور والمزايا وظروف العمل)",
 "ろうどうさい": "عيد العمال (عطلة للاحتفال بالعمال وتكريمهم)",
 "ろうどうしじょう": "سُوق عَمَل, سُوق الْعَمَل (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "ろうどうしゃ": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "ろうどうしゃかいきゅう": "اَلطَّبَقَة الْعَامِلَة",
 "ろうどうしゃとう": "حزب العمال (حزّب القومَ:جعلهم أحزاباً ، قوّاهم ، جعلهم من حزبه؛ حَزَّبْتُ القُرْآنَ: جَعَلْتُه أَحْزَاباً)\nمثال: التحقت بذلك الحزب.",
 "ろうどうしゅうやくてきさんぎょう": "كَثِيفُ العَمَالَة (يتطلّب إنفاقاً كبيراً من العمل البشري دون رأس مال كثير)",
 "ろうどうしゅうようしょ": "مخيم عمل قسري, معسكر عمل (مؤسسة عقابية للسجناء السياسيين الذين يستخدمون كعمالة قسرية)",
 "ろうどうしょうかいじょ": "وَكَالَة تَوْظِيف",
 "ろうどうじんこう": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "ろうどうせつ": "عيد العمال (عطلة للاحتفال بالعمال وتكريمهم)",
 "ろうどうそうぎ": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "ろうどうとう": "حزب العمال (حزب سياسي يسار الوسط تم تشكيله لتمثيل مصالح العمال العاديين) / حزب العمال البريطاني (حزب سياسي تشكل في بريطانيا العظمى عام 1900؛ يتميز بتعزيز مصالح العمل وسابقاً تأميم الصناعات الرئيسية)",
 "ろうどうび": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز) / يَوْم الْعَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ろうどうふく": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "ろうどうほう": "قانون العمل (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ろうどうりょく": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "ろうどうりょくじんこう": "قوى عاملة, يد عاملة (مصدر الأشخاص المدربين الذين يمكن توظيفهم عمالاً)",
 "ろうどく": "تِلَاوَة",
 "ろうどくかい": "حَيْثِيَّة",
 "ろうにゅう": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "ろうにん": "رُونِين / هَائِم",
 "ろうにんぎょう": "تمثال شمع (تمثال (عادة لشخص مشهور) مصنوع من الشمع)",
 "ろうねん": "شَيْخُوخَة, عُجُوز",
 "ろうねんいがく": "طب الشيخوخة (فرع العلوم الطبية الذي يتعامل مع الأمراض والمشاكل الخاصة بكبار السن)",
 "ろうねんがく": "طب الشيخوخة (فرع العلوم الطبية الذي يتعامل مع الأمراض والمشاكل الخاصة بكبار السن)",
 "ろうねんき": "شَيْخُوخَة, عُجُوز",
 "ろうねんちほう": "خرف الشيخوخة, ذهان الشيخوخة (خرف يصيب المسنين؛ ينتج عن تنكس الدماغ في غياب الأمراض الوعائية الدماغية)",
 "ろうねんびょうがく": "طب الشيخوخة (فرع العلوم الطبية الذي يتعامل مع الأمراض والمشاكل الخاصة بكبار السن)",
 "ろうはい": "تدهور, تردي (عملية التغير إلى حالة أدنى) / تدهور, ضعف (علامة على انخفاض الجودة أو القوة) / مُعَتَّق ((عَنِ التَّبْغ) مُعَتَّق كَعَمَلِيَّة حِفْظ) / مُعَتَّق, نَاضِج (بلغ الحالة المرغوبة أو النهائية (للنبيذ أو الفاكهة أو الجبن)) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / مُتَآكِل, هَرِم (فِي مَرْحَلَةٍ مُتَقَدِّمَةٍ مِنَ التَّعْرِيَةِ)",
 "ろうはいぶつ": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "ろうば": "عَجُوز",
 "ろうばい": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك. / بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "ろうばしん": "عِنَايَة, رِعايَة",
 "ろうばん": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "ろうひ": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "ろうひか": "مُسْرِف, مُبَذِّر / مُبَذِّر, مُسْرِف",
 "ろうびき": "تشميع",
 "ろうふ": "عَجُوز / شَيْخ, عَجُوز",
 "ろうふじん": "عَجُوز",
 "ろうほ": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "ろうほう": "بُشْرَى (الخبر السار) / بِشَارَة, إِنْجِيل",
 "ろうまく": "قير (الغطاء اللحمي الشمعي عند قاعدة المنقار العلوي لبعض الطيور)",
 "ろうむ": "شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "ろうむしゃ": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "ろうもう": "خرف, هرم (حالة الخرف) / خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "ろうや": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن. / شَيْخ, عَجُوز",
 "ろうやくにん": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "ろうやぶり": "هروب من السجن (هروب من السجن) / كسر الحماية (إزالة أقفال الأمان من جهاز إلكتروني)\nمثال: تم التخطيط للهروب بعناية",
 "ろうゆう": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "ろうらく": "تملق, مداهنة (فعل الحث عن طريق الملاطفة أو الإطراء)",
 "ろうりょく": "مَخَاض / عَمَلَ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "ろうれい": "شَيْخُوخَة, عُجُوز",
 "ろうれいねんきん": "صندوق التقاعد, معاش التقاعد (دفعة شهرية تُقدم لشخص تقاعد عن العمل)",
 "ろうれつ": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "ろうれん": "اتحاد عمالي, نقابة (منظمة للموظفين تشكلت للتفاوض مع صاحب العمل)\nمثال: عليك الانضمام إلى النقابة للحصول على وظيفة / خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "ろうれんか": "مُحَارِب قَدِيم",
 "ろうろう": "شَفَّاف / وَاضِح / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "ろう引き": "تشميع",
 "ろう染め": "باتيك",
 "ろう管": "نَاسُور",
 "ろう者": "أَصَمّ",
 "ろえい": "مخيم, معسكر (أماكن معيشة مؤقتة بناها الجيش خصيصاً للجنود) / مخيم, موقع تخييم (موقع يمكن للأشخاص في العطلة نصب خيمة فيه)\nمثال: أينما ذهب في المعسكر كان الرجال يتذمرون",
