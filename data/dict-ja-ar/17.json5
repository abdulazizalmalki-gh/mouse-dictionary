 "むね": "خَزِينَة\nمثال: تلقى ياني طلقة في الصدر. / ثَدْي, بز\nمثال: تلقى ياني طلقة في الصدر. / قَلْب, فُؤَاد / رِئَة, سَحَر / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / مرمى, مغزى (المعنى العام أو الفحوى السائد)\nمثال: فهمت المغزى العام للمحادثة / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله) / سلسلة جبال",
 "むねあて": "لَبَب / مِرْيَلَة",
 "むねおどる": "مُثِير",
 "むねかざり": "بْرُوش",
 "むねがわるい": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / غَاضِب, غَضْبَان",
 "むねくそ": "شُعُور, إِحْسَاس / مُقْرِف, مُقَزِّز",
 "むねくそがわるい": "مُقْرِف, مُقَزِّز",
 "むねさんずん": "قَلْب, فُؤَاد",
 "むねざんよう": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له))",
 "むねつぶし": "رابط, موثق (شيء يستخدم للربط أو التوثيق)",
 "むねにいちもつ": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "むねにおさめる": "احتفظ بكل شيء لنسفه",
 "むねにく": "ثَدْي, بز\nمثال: تلقى ياني طلقة في الصدر.",
 "むねにたたむ": "احتفظ بكل شيء لنسفه",
 "むねのすく": "مُنْعِش",
 "むねのたにま": "شطر, فلق (عملية الفلق أو الشق)",
 "むねひも": "طُفُولَة",
 "むねやけ": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "むねわる": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "むねん": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "むねんがる": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "むねんをはらす": "اِنْتَقَمَ",
 "むねポケ": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "むねポケット": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "むね肉": "ثَدْي, بز\nمثال: تلقى ياني طلقة في الصدر.",
 "むのう": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "むのうしゃ": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "むのうやく": "عُضْوِيّ",
 "むのうりょく": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "むのうりょくしゃ": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "むはい": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "むはいりょ": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين)\nمثال: سلوك مستهتر بشكل صادم",
 "むはっこうパン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "むはんのう": "غير متجاوب, غير مستجيب (لا يستجيب لتأثير أو محفز ما)",
 "むばいかい": "فورية, مباشرة (عدم وجود وسيط أو وكالة متداخلة)\nمثال: فورية التغطية التلفزيونية",
 "むばんそう": "منفرداً, وحده (دون أي شخص أو شيء آخر)\nمثال: بقي الطفل في المنزل وحده",
 "むひ": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "むひしょう": "اِنْعِْدَام الطِحَال",
 "むひしょうこうぐん": "اِنْعِْدَام الطِحَال",
 "むひつ": "أُمِّيَّة",
 "むひはん": "أعمى (في الاتباع), غير انتقادي (غير ناقد؛ لا يميل إلى البحث عن الأخطاء أو لفت…)\nمثال: معجب مخلص وتقريباً غير انتقادي (أعمى)",
 "むひょう": "بَرَد (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن…)\nمثال: لا أتحمل البرد. / غير موسوم, غير مُميز (ليس لديه علامة تعريف)\nمثال: أوراق لعب غير معلمة",
 "むひょうはく": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "むび": "نَائِم",
 "むびゅう": "عِصْمَة",
 "むびるい": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز…)",
 "むふう": "بِلَا رِيَاح, سَاكِن الرِّيح (بِدُون رِيَاح أَوْ بِرِيَاحٍ شِبْه مَعْدُومَة) / صَامِت, هَادِئ",
 "むふんべつ": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف)",
 "むへい": "جَالِس, عَدِيم السُّوَيْقَة (متصل مباشرة بالقاعدة؛ ليس له ساق وسيطة)\nمثال: زهور لاطئة",
 "むへん": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء / موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات…)",
 "むへんさい": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "むへんざい": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "むべ": "بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "むべなるかな": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "むほう": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "むほうこっか": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "むほうしゃ": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "むほうしゅう": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "むほうしん": "انعدام الهدف, عبثية (صفة الافتقار إلى أي غرض محدد)",
 "むほうじょうたい": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "むほうもの": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "むほん": "ثَوْرَة, تَمَرُّد",
 "むほんにん": "مُتَمَرِّد, مُتَمَرِّدَة",
 "むぼう": "غَيْر مُغَطًّى, مَكْشُوف (غير مغطى بالملابس) / مُتَهَوِّر",
 "むぼうび": "أَعْزَل",
 "むま": "كَابُوس / جَاثُوم, كَابُوس",
 "むみ": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "むみかんそう": "كَلِيل",
 "むみむしゅう": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ)",
 "むむ": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر) / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "むむじゅんせい": "اِتِّسَاق",
 "むめ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة) / أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى / رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه)",
 "むめい": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى) / مُظْلِم / اتِّفَاقِيّ, بِلَا سَبَب (ليس له سبب أو سبب ظاهر) / غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "むめいこつ": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة)",
 "むめいし": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ) / بِنْصِر",
 "むめいせんし": "الجندي المجهول (جندي غير محدد الهوية يتم تكريم جثمانه كنصب تذكاري)",
 "むめいどうみゃく": "الجذع العضدي الرأسي, شريان لا اسم له (شريان كبير ينشأ من قوس الأبهر وينقسم إلى الشريان تحت الترقوة الأيمن والشريان…)",
 "むもう": "أَجْرَد",
 "むもくてき": "بلا هدف, عبثي (لا يظهر أي غرض أو هدف)",
 "むもん": "سادة, غير منقوش (يفتقر للنقوش خاصة في اللون)",
 "むやく": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "むやちん": "دُونَ إِيجَار, مَجَّانًا (بدون دفع إيجار)\nمثال: يمكنني العيش هنا مجاناً",
 "むやみ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة / مُفْرِط, زَائِد",
 "むやみに": "باستهتار, بلا تفكير (إظهار عدم التفكير)\nمثال: عامل والديه باستهتار / بإفراط, بشكل مبالغ فيه (لدرجة تتجاوز الحدود الطبيعية أو المناسبة)\nمثال: كبير جداً",
 "むやみやたら": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة / مُفْرِط, زَائِد",
 "むゆう": "غير لامع, غير مصقول (ليس له طبقة لامعة)\nمثال: ورق غير مصقول / سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むゆうしょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むゆうびょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むゆうびょうしゃ": "سائر في النوم (شخص يمشي أثناء نومه)",
 "むよう": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / مَحْظُور, مَمْنُوع (غَيْر مَسْموح بِهِ بِمُوجَب القانون)",
 "むようのちょうぶつ": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب)",
 "むよく": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً)",
 "むら": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة. / تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر) / جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع",
 "むらい": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "むらがり": "ثَوْل (بدا فيه الجنون)",
 "むらがる": "ثَوْل (بدا فيه الجنون)",
 "むらき": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "むらきも": "حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم)",
 "むらぎ": "نزوة, هوى (رغبة مفاجئة)\nمثال: اشتراه بدافع نزوة",
 "むらぎも": "حشا, عضو داخلي (عضو رئيسي يقع داخل الجسم)",
 "むらさき": "بَنَفْسَجِيّ / صَلْصَةْ اَلصُّويَا",
 "むらさきいろ": "بَنَفْسَجِيّ",
 "むらさきうまごやし": "فَصْفَص",
 "むらさきがかった": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "むらさきくんしらん": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور…)",
 "むらさきごてん": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "むらさきすいしょう": "جَمَشْت",
 "むらさきずいしょう": "جَمَشْت",
 "むらさきせきえい": "جَمَشْت",
 "むらさきっぽい": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "むらさきつばめ": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "むらさきはしどい": "لَيْلَك",
 "むらさきはなまめ": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا)",
 "むらさきべんけいそう": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "むらさきましこ": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "むらざと": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
