 "らちもない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "らちゅう": "يَرَقَة, دُودَة الْفَرَاشَة",
 "らちる": "اِخْتَطَفَ (أخذ شخصا بالغَصْب وقاده إلى مكان وحَبَسَه عن الرجوع)\nمثال: من اختطف دميتري؟ / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "らっか": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "らっかえだにかえらずはきょうふたたびてらさず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "らっかさん": "بَرَاشُوت, مِظَلّة هُبُوط",
 "らっかさんぶたい": "مظليين (مشاة مدربون ومجهزون للقفز بالمظلات)",
 "らっかさんへい": "مِظَلِّيّ",
 "らっかせい": "فُولٌ سُودَانِيٌّ, فُسْتُقُ العَبِيد",
 "らっかせいゆ": "زيت الفول السوداني (زيت مستخرج من الفول السوداني؛ يُستخدم في الطهي وصنع الصابون)",
 "らっかん": "تَفَاؤُل",
 "らっかんしゅぎ": "تَفَاؤُل",
 "らっかんてき": "مُتَفَائِل",
 "らっかんろん": "تَفَاؤُل",
 "らっかんろんしゃ": "مُتَفَائِل",
 "らっこ": "قضاعة البحر (قضاعة بحرية كبيرة من سواحل شمال المحيط الهادئ ذات فراء بني داكن سميك جداً)",
 "らっしゃる": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "らっち": "اِخْتِطَاف / حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "らっちもない": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "らっぱ": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق. / بَلْطَجِيّ / جَاسُوس / تَجَسَّسَ",
 "らっぱかんえん": "التهاب البوق, التهاب قناة فالوب (التهاب قناة فالوب (عادة نتيجة انتشار العدوى من المهبل أو الرحم) أو قناة استاكيوس)",
 "らっぱしゅ": "تم بواق (بجعة برية بيضاء نقية كبيرة من غرب أمريكا الشمالية لها صرخة رنانة) / بوقي (طائر اجتماعي كبير يشبه الكركي من غابات أمريكا الجنوبية له ريش أسود لامع وصرخة طويلة عالية؛ يسهل تدجينه) / بشير, منادي ((رسمياً) شخص يعلن عن أخبار مهمة) / عازف بوق, عازف كورنيت (موسيقي يعزف على البوق أو الكورنيت)\nمثال: كان لدى الزعيم منادٍ يعلن عن وصوله بالبوق",
 "らっぱすいせん": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "らっぱずいせん": "زنبق أبيض, زنبق مادونا (زنبق شرق البحر الأبيض المتوسط والبلقان بزهور بيضاء عريضة قمعية الشكل)",
 "らっぱふき": "عازف بوق (شخص يعزف على البوق (البيوجل))",
 "らっぱ吹き": "عازف بوق (شخص يعزف على البوق (البيوجل))",
 "らつわん": "حذق, حنكة (الذكاء الذي يظهر من خلال الحنكة (كما في التعاملات التجارية))",
 "らでん": "أم اللؤلؤ, عرق اللؤلؤ (الطبقة الداخلية المتقزحة لصدفة الرخويات)",
 "らでんざいく": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "らに": "جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم سابقاً في الطب الشعبي)",
 "らば": "بَغَل",
 "らばん": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "らふ": "لُوس أَنْجِلِس",
 "らふが": "عَارٍ, عُرْيَان",
 "らふく": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "らほく": "الشَّمَال, الشَّمَال المِغْنَاطِيسِيّ (الاتجاه الذي تشير إليه إبرة البوصلة)",
 "らま": "لَامَا",
 "らまきょう": "بوذية تبتية, لامية (عقيدة بوذية تتضمن عناصر من الهند ليست بوذية وعناصر من الشامانية الموجودة مسبقاً)",
 "らまそう": "لَامَا",
 "らりぱっぱ": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "らりる": "هَذَيَان / هَذَى",
 "られつ": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / ترقيم, قائمة مرقمة (قائمة مرقمة)\nمثال: استمر العد لعدة ساعات",
 "らん": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / دَرَابْزُون / أُورْكِيد, سَحْلَب / هُولَنْدَا, هُولَنْدَة / باهِر / ثَارَ, تَمَرَّدَ (ثارَ يَثُورُ ثَوَرانًا، وثَوْرًا، وثَوْرَةً: هاج وانتَشَرَ؛ يُقال: ثارَ الدُّخانُ والغُبَرُ، وثار الدّم بفلان، وثارت به الحصْبَةُ، وثار به الشَّرُّ والغَضَبُ) / عِصْيَان, تَمَرُّد\nمثال: ثار الفلاحون على الحكومة. / بُيَيْضَة, بُوَيْضَة",
 "らんいしゃいん": "عُمَّالِيّ, مِن الطَّبَقَة العَامِلَة (ينتمي إلى من يعملون بأجر خاصة العمال اليدويين أو الصناعيين) / ذو الياقات الزرقاء, عمالي (من أو يحدد العمل الصناعي اليدوي أو العمال)",
 "らんうん": "مُزْنَة",
 "らんえん": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "らんえんそう": "نافذة بيضوية (نافذة تتصل بها قاعدة الركاب)",
 "らんおう": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)",
 "らんおうのう": "كيس المح (بنية غشائية تحيط بمح البيض في الطيور والزواحف والجرابيات وبعض الأسماك؛ تقوم بتدوير العناصر الغذائية للجنين النامي) / حويصلة سرية, كيس المح (بنية غشائية تعمل كجهاز دوري في أجنة الثدييات حتى يصبح القلب وظيفياً)",
 "らんか": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "らんかく": "قَشْر الْبَيْضِ",
 "らんかつ": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "らんかつこう": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "らんかん": "قَنَاةُ الرَّحِمِ / درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات) / سياج, مادة الدرابزين (مادة لصنع القضبان أو الحواجز بشكل جماعي) / بتألق, بسطوع\nمثال: تألقت النجوم بسطوع / إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل) / إِلَى مَا لَا نِهَايَة (طوال الوقت؛ يبدو بلا توقف) / إلى ما لا نهاية, بلا نهاية ((بالمعنى المكاني) يبدو أنه ليس له حدود)\nمثال: هناك احتمالات لا حصر لها",
 "らんかんえん": "التهاب البوق, التهاب قناة فالوب (التهاب قناة فالوب (عادة نتيجة انتشار العدوى من المهبل أو الرحم) أو قناة استاكيوس)",
 "らんかんせつじょ": "استئصال قناة فالوب (إزالة جراحية لقناة فالوب واحدة أو كلتيهما)",
 "らんかんにんしん": "حمل بوقي (حمل خارج الرحم في قناة فالوب)",
 "らんが": "لَوْحَة زَيْتِيَة",
 "らんがい": "هَامِش",
 "らんきりゅう": "اِضْطِرَاب",
 "らんきん": "عفن مائي (كائنات طفيلية أو رمية تعيش بشكل رئيسي في المياه العذبة أو التربة الرطبة)",
 "らんぎゃく": "ثَوْرَة, تَمَرُّد",
 "らんぎょう": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "らんぎょく": "زبرجد",
 "らんぐん": "شجار",
 "らんけいのう": "قريبة (جيب صغير تفتح فيه القنوات الهلالية)",
 "らんげき": "ثَوْرَة, تَمَرُّد",
 "らんこう": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "らんこうパーティー": "باخاناليا, حفلة مجون (تجمع جامح ينطوي على الإفراط في الشرب والانحلال الجنسي) / طقوس العربدة (طقس سري في عبادات الآلهة اليونانية أو الرومانية القديمة ينطوي على الغناء والرقص والشرب والنشاط الجنسي) / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق",
 "らんこく": "هُولَنْدَا, هُولَنْدَة",
 "らんこん": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "らんご": "هُولَنْدِيّ",
 "らんさいぼう": "بُيَيْضَة, بُوَيْضَة",
 "らんさく": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "らんざつ": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "らんし": "لَابُؤْرِيّة, اللَانُقَطِيَّة / بُيَيْضَة, بُوَيْضَة",
 "らんしゅう": "لَانْغْتْشُو, لَانْغْجُو",
 "らんしょう": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "らんしょうせき": "كيانيت (معدن رمادي أو أزرق مخضر يتكون من سيليكات الألمنيوم البلورية)",
 "らんしょく": "نِيلِيّ",
 "らんしん": "جُنُون / خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "らんしんぞくし": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "らんしんもの": "مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر) / طائش, متهور (شخص متهور مندفع غير مسؤول) / مَجْنُون, مُخْتَلّ عَقْلِيّاً (شخص فاقد للعقل)",
 "らんじょう": "إِهْلِيلَجِيّ, بَيْضَوِيّ (مستدير كالبيضة؛ ذو شكل بيضاوي)",
 "らんじん": "هُولَنْدِيّ",
 "らんすうはっせいき": "مولد أرقام عشوائية (روتين مصمم لإنتاج رقم عشوائي)",
 "らんせつほう": "اختبار الخدش (اختبار لتحديد الحساسية لمواد مختلفة عن طريق تطبيقها على خدوش في الجلد)",
 "らんせん": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس)",
 "らんそ": "دعوى كيدية (تقاضي يتبين أنه تم رفعه بشكل كيدي ودون سبب محتمل)",
 "らんそう": "مِبْيَض, مَبِيض / بكتيريا زرقاء, طحالب خضراء مزرقة (كائنات بدائية النواة تقوم بالتمثيل الضوئي بشكل أساسي وتحتوي على صبغة زرقاء بالإضافة إلى الكلوروفيل؛ توجد منفردة أو في مستعمرات في بيئات متنوعة؛ مهمة…)",
 "らんそうえん": "التهاب المبيض (التهاب المبايض)",
 "らんそうしょくぶつ": "بكتيري زرقي, سيانوبكتيري (متعلق بالبكتيريا الضوئية من طائفة البكتيريا الزرقاء أو ناتج عنها)",
 "らんそうてきしゅつ": "استئصال المبيض (إزالة جراحية لمبيض واحد أو كليهما)",
 "らんそうどうみゃく": "شريان مبيضي (الشريان الذي يتفرع من الأبهر ويغذي المبيضين بالدم)",
 "らんそうのうしゅ": "كيس المبيض (ورم كيسي (حميد عادة) في المبيض)",
 "らんぞう": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "らんだ": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة / بُطْء",
 "らんちきさわぎ": "مِضْرَب, مَضَارِب",
 "らんちょう": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "らんちょうし": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "らんてん": "نِيلِيّ",
 "らんとう": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "らんとうさわぎ": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "らんとうば": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "らんどうこう": "أزوريت (كربونات النحاس الزرقاء؛ ملاكيت أزرق)",
 "らんにゅう": "تَطَفُّل, مُدَاخَلَة",
 "らんにゅうしゃ": "مُقْتَحِم, دَخِيل",
 "らんばい": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "らんばいがっせん": "حَرْب أَسْعَار, مُنَافَسَة سِعْرِيَّة (منافسة شديدة يقوم فيها المتنافسون بخفض أسعار التجزئة لكسب الأعمال)",
 "らんぱく": "بياض البيض, زلال (الجزء الأبيض من البيضة؛ المادة الهلامية المغذية والواقية المحيطة بالصفار وتتكون أساساً من الألبومين المذاب في الماء) / ألبومين, زلال (بروتين بسيط قابل للذوبان في الماء يوجد في العديد من الأنسجة والسوائل الحيوانية)",
 "らんぱくしつ": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية) / بُرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "らんぴ": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "らんぴつ": "خربشة",
 "らんぴつらんぶん": "خربشة",
 "らんほう": "حُوَيْصِلَة",
 "らんほうしげきホルモン": "الهرمون المنبه للجريب (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية ويحفز نمو بصيلات غراف في إناث الثدييات، وينشط الخلايا المكونة للحيوانات المنوية في ذكور…)",
 "らんほうホルモン": "إستروجين, هرمون أنثوي (مصطلح عام للهرمونات الجنسية الستيرويدية الأنثوية التي يفرزها المبيض والمسؤولة عن الخصائص الجنسية الأنثوية النموذجية)",
 "らんぼう": "عُنْف, عَنْف / عُنْف / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "らんぼうもの": "بَلْطَجِيّ",
 "らんぼさいぼう": "خلية بيضية (خلية مشيجية أنثوية تتطور إلى بويضة بعد انقسامين اختزاليين)",
 "らんぽ": "سير عشوائي (عملية عشوائية تتكون من سلسلة من التغييرات التي يتم تحديد خصائص كل منها (مثل الحجم أو الاتجاه) عن طريق الصدفة)",
 "らんぽう": "حُوَيْصِلَة",
 "らんぽうホルモン": "إستروجين, هرمون أنثوي (مصطلح عام للهرمونات الجنسية الستيرويدية الأنثوية التي يفرزها المبيض والمسؤولة عن الخصائص الجنسية الأنثوية النموذجية)",
 "らんま": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه) / نافذة العارضة (نافذة فوق الباب تكون عادة مفصلية بعارضة أفقية فوق الباب) / فَوْضَى, فَوْضَوِيَّة",
 "らんまん": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / عظيم, مجيد (ذو مجد أو يستحق المجد أو يمنحه) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة)\nمثال: مسيرة مهنية طويلة ومجيدة",
 "らんみゃく": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "らんめん": "نودلز بالبيض (شريط ضيق من عجين المكرونة مصنوع بالبيض)",
 "らんよう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "らんようけい": "طَبَقَة",
 "らんらん": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "らんり": "مُتَفَرِّق, مُنْتَشِر (مُوَزَّعٌ أَوْ مُمْتَدٌّ عَلَى رُقْعَةٍ جُغْرَافِيَّةٍ وَاسِعَةٍ)",
 "らんりゅう": "اِضْطِرَاب",
 "らんりん": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "らんる": "خِرْقَة",
 "らーめん": "رَامِن, رَامَن",
 "り": "أَفْضَلِيَّة, فَائِدَة / جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود / جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي) / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / وَاحِد وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 51) / لي (مقياس مسافة صيني؛ حوالي 0.5 كيلومتر) / ليثيوم (عنصر فضي أبيض ناعم أحادي التكافؤ من مجموعة الفلزات القلوية؛ أخف معدن معروف) / مَفْهُوم / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي. / إِسْهَال",
 "りいか": "وَاحِد وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 51) / لي (مقياس مسافة صيني؛ حوالي 0.5 كيلومتر) / ليثيوم (عنصر فضي أبيض ناعم أحادي التكافؤ من مجموعة الفلزات القلوية؛ أخف معدن معروف)",
 "りいん": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "りえき": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / فَائِدَة, جَدْوَى",
 "りえききょうじゅしゃ": "مُسْتَفِيد",
 "りえききょうよ": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "りえきしじょうしゅぎ": "رَأْسْمَالِيَّة (الرَّسُمالبَّة : نظامٌ اقتصاديّ تكون فيه وسائل الانتاج مُلْكً لأَصحاب ِ الأَموال المُوَظَّفة؛ مجْموعُ الرَّأْسماايِّين أو البلدان الرَّأْسماليَّة)",
 "りえきそうはん": "تَضَارُب مَصَالِح",
 "りえきはいとう": "حِصَّة / مَقْسُوم",
 "りえきはば": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "りえきゆうどう": "مشاريع الاسترضاء السياسي (اعتماد تشريعي مصمم لاسترضاء الناخبين وكسب ودهم)",
 "りえん": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "りか": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء) / عِلْم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / زَهْرَة بَرْقُوق / ثمرة تفاحية (فاكهة لحمية (تفاح أو كمثرى أو فواكه ذات صلة) تحتوي على غرف بذور وجزء خارجي لحمي)",
 "りかい": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو / بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / بَحْر قَزْوِين, بَحْر الخَزَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "りかいしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "りかいど": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "りかいりょく": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "りかいをしめす": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "りかく": "تَوَحُّد / إطالة (عملية تطويل شيء ما) / إطالة, تمديد (إضافة إلى طول شيء ما) / استطالة (صفة كون الشيء مستطيلاً أو ممدوداً)",
 "りかけい": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "りかしつ": "مختبر, معمل (مكان عمل لإجراء البحوث العلمية)",
 "りかん": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)",
 "りかんしゃ": "شَهِيد (من يعاني من أجل مبدأ) / عَلِيل, مَرِيض (شخص يعاني من مرض)",
 "りがい": "فَائِدَة",
 "りがいかんけい": "فَائِدَة",
 "りがいかんけいしゃ": "وكيل الضمان (1.وَكيل: ( اسم )؛ وكيل ( اسم ))",
 "りがいとくしつ": "مَحَاسِن وَمَسَاوِئ",
 "りがく": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء) / عِلْم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية. / فَلْسَفَة (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة) / مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / مَبْدَأ, مَذْهَب (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / فَلْسَفَة, مَذْهَب (في : عِلْمُ الفَلْسَفَة: علم يعنى بوجه الإجمال على بيان أسباب الأشياءِ المادّية والغير المادّية أو ذكر الأشياءِ مع أسبابها وهو يدرس المبادئ الأُولى…؛ في : التشبُّه بالإله حسب الطاقة البشريَّة لتحصيل السعادة الأبديَّة)\nمثال: درس الفلسفة الإسلامية.",
 "りがくし": "بكالوريوس العلوم (درجة البكالوريوس في العلوم)",
 "りがくしゃ": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان)) / فَيْلَسُوف (تلميذ للفلسفة)\nمثال: إنك فيلسوف ، أليس ذلك صحيحا؟",
 "りがくしゅうし": "ماجستير العلوم (درجة الماجستير في العلوم)",
 "りがくてき": "مَادِّيّ, مَلْمُوس",
 "りがくはかせ": "دكتوراه في العلوم (درجة فخرية في العلوم)",
 "りがくはくし": "دكتوراه في العلوم (درجة فخرية في العلوم)",
 "りがくりょうほう": "عِلَاج طَبِيعِيّ",
 "りがくりょうほうし": "أخصائي في العلاج الطبيعي, أخصائية في العلاج الطبيعي",
 "りがんりゅう": "تيار ساحب, تيار شاطئي (تيار سطحي قوي يتدفق للخارج من الشاطئ)",
 "りき": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / مُلَاءَمَة, مُنَاسَبَة",
 "りきか": "تيتر, عيار (تركيز محلول كما يحدد بالمعايرة)",
 "りきかん": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "りきがく": "مِيكَانِيكَا, مِيكَانِيكِيَّة",
 "りきがくけい": "نظام ديناميكي ((الفيزياء) فضاء طور جنباً إلى جنب مع تحول لذلك الفضاء)",
 "りきがくてき": "مِيكَانِيكِيّ",
 "りきがくてきエネルギー": "طاقة ميكانيكية (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "りきさく": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية) / كَدْح / تَعِبَ, كَدَحَ (تعِب:ضدّ استراح؛ التَّعَبُ: شدَّةُ العَنَاءِ ضدُّ الراحَة، تَعب يَتْعَبُ تَعَباً: أَعْيَا)\nمثال: شعر توم بالتعب.",
 "りきし": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "りきしょっき": "نول آلي (نول يعمل ميكانيكياً)",
 "りきじ": "مصارع سومو (مصارع يشارك في السومو (شكل ياباني من المصارعة))\nمثال: مصارعو السومو رجال ضخام وثقيلو الوزن",
 "りきせき": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / دفعة, زخم (قوة دافعة) / سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي) / نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "りきせつ": "تأكيد, تشديد (فعل إعطاء أهمية خاصة أو دلالة لشيء ما)",
 "りきせん": "خط القوة, خط المجال (خط وهمي في مجال القوة؛ اتجاه الخط في أي نقطة هو اتجاه القوة عند تلك النقطة)",
 "りきそう": "ركض سريع, عدو سريع (جري سريع)",
 "りきてん": "تَرْكِيز",
 "りきどう": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة) / ديناميكا نفسية (فرع علم النفس الاجتماعي الذي يتعامل مع العمليات والعواطف التي تحدد النفسية والدافع) / دِينَامِيكِيَّة نَفْسِيَّة (الترابط بين العمليات والعواطف الواعية وغير الواعية التي تحدد الشخصية والدوافع)",
 "りきどうかん": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة)",
 "りきどうてき": "حَرَكِيّ ((يستخدم للأفعال والصفات المشتقة) يعبر عن فعل بدلاً من حالة كينونة) / حركي, ديناميكي (يتميز بالعمل أو القوة أو قوة الشخصية) / ديناميكي (من أو يتعلق بالديناميكا) / دينامية, قوة دافعة (حافز فعال أو قوة محركة)\nمثال: سوق ديناميكي",
 "りきば": "حقل, حقل القوة (الحيز حول جسم مشع والذي يمكن لتذبذباته الكهرومغناطيسية أن تمارس قوة على جسم مشابه آخر غير ملامس له)",
 "りきへん": "إنجاز فذ, عمل إعجازي (مأثرة بارعة أو عبقرية)",
 "りきほんせつ": "حيوية, ديناميكية (نشاط شخصية حيوية) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / ديناميكية (أي من النظريات أو المذاهب أو الأنظمة الفلسفية المختلفة التي تحاول تفسير ظواهر الكون بدلالة قوة أو طاقة كامنة)",
 "りきみ": "إجهاد, توتر (مجهود مكثف أو عنيف) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل) / إجهاد مفرط (إجهاد مفرط؛ بذل جهد كبير لدرجة تسبب الانزعاج أو الإصابة) / تبجح, تهديد فارغ (تظاهر بالشجاعة بغطرسة)",
 "りきむ": "سُلَالَة / تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة) / شِيك جِدًّا, فَخْم ((عامّيّة بريطانيّة) أَنِيق لِلغَايَة) / عامل متجول أسترالي (عامل أسترالي متجول يحمل ممتلكاته الشخصية في صرة أثناء سفره بحثاً عن عمل)",
 "りきりょう": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "りきん": "فَائِدَة",
 "りぎょう": "تخلٍّ, تنازل (فعل التنازل؛ التضحية أو التخلي عن (ممتلكات أو حق أو لقب أو امتياز، إلخ)) / تنصل, نبذ (رفض أو تبرؤ أو إنكار الصلاحية) / تخل, نبذ (فعل (منطوق أو مكتوب) يعلن أن شيئاً ما تم التنازل عنه أو التبرؤ منه) / انشقاق, تخلي (حالة نبذ المعتقدات الدينية أو الحزب السياسي أو قضية ما (غالباً لصالح معتقدات أو قضايا معارضة))\nمثال: تنصل الكونغرس من المعاهدة التي تفاوض عليها الرئيس",
 "りく": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "りくあげ": "تفريغ (عمل إخراج حمولة من شيء ما من مركبة أو سفينة أو حاوية، إلخ)",
 "りくかい": "كتلة أرضية, كتلة يابسة (مساحة كبيرة متصلة من الأرض)",
 "りくがめ": "سُلَحْفَاة",
 "りくがわ": "باتجاه البر (نحو اليابسة)\nمثال: باتجاه البر، تذوب أميال من مستنقعات العشب الخشنة في المرتفعات المنخفضة",
 "りくがん": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "りくきょう": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / جسر يابسة (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "りくぐん": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "りくぐんしかんがっこう": "أَكَادِيمِيَّةٌ عَسْكَرِيَّة",
 "りくぐんちゅうじょう": "فريق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "りくぐんびょういん": "مستشفى عسكري (مستشفى للجنود وغيرهم من الأفراد العسكريين)",
 "りくぐんふじんぶたい": "فيلق الجيش النسائي (فيلق جيش تم تنظيمه في الحرب العالمية الثانية ولكنه لم يعد فرعًا منفصلاً للجيش الأمريكي)",
 "りくごう": "كَوْن, الْكَوْن",
 "りくし": "أَكَادِيمِيَّةٌ عَسْكَرِيَّة",
 "りくしょう": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "りくしょうほ": "لواء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "りくじょう": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر. / أَلْعَاب قَوًى",
 "りくじょうきょうぎ": "أَلْعَاب قَوًى",
 "りくじょうきょうぎじょう": "ملعب, ميدان اللعب (قطعة أرض مجهزة لممارسة لعبة ما)\nمثال: هلل الجمهور عندما نزل فريق برينستون إلى الملعب",
 "りくじょうホッケー": "هوكي الحقل",
 "りくす": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "りくすいがく": "علم المسطحات المائية الداخلية (الدراسة العلمية للمسطحات المائية العذبة لخصائصها البيولوجية والفيزيائية والجيولوجية)",
 "りくする": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "りくせい": "أَرْضِيّ",
 "りくそう": "ضابط صفّ",
 "りくそうとう": "مجند (فرد ذكر مجند في القوات المسلحة)",
 "りくぞく": "وَاحِدًا تِلْوَ الآخَرِ",
 "りくだな": "رصيف قاري (قاع البحر الضحل نسبياً (حتى 200 متر) المحيط بالقارة)",
 "りくち": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / بِلَاد, أَرْض / هَبَطَ\nمثال: دخل زيري إلى منطقة ببر.",
 "りくちめんせき": "رقعة أرض, مساحة أرض (مساحة من الأرض تستخدم لغرض معين (مثل البناء أو الزراعة))\nمثال: أراد بعض المساحة من الأرض للبناء عليها",
 "りくつ": "نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية. / جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "りくつっぽい": "مجادل, مشاكس (يميل إلى أو يتميز بالجدل)\nمثال: خطاب جدلي",
 "りくつや": "مُجادِل, مُخاصِم (شخص يجادل؛ شخص يجيد أو يستمتع بالجدل)",
 "りくとうさんりゃく": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "りくのことう": "خَارِجٌ عَنِ المَعْهُود, غَيْرُ مَأْلُوف (استثنائيّ أو غير عاديّ أو جدير بالملاحظة) / تَمَّ التَّعَامُلُ مَعَهُ, مَفْرُوغ مِنْهُ (تَمَّ التَّعَامُلُ مَعَهُ وَالِانْتِهَاءُ مِنْهُ) / شَاذّ, مُسِيء (غير لائق أو حتى مُسيء)",
 "りくひょう": "مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "りくびん": "بريد سطحي, بريد عادي (بريد يتم إرساله عن طريق البر أو البحر)",
 "りくふう": "حَبِيس اليَابِسَة (محاط باليابسة كلياً أو شبه كلي)",
 "りくほう": "رصيف قاري (قاع البحر الضحل نسبياً (حتى 200 متر) المحيط بالقارة)",
 "りくぼうせい": "نجمة سداسية (مضلع منتظم يتكون من مد كل ضلع من أضلاع مسدس منتظم لتشكيل مثلثين متساويي الأضلاع)",
 "りくり": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "りくりょく": "تَعَاوُن",
 "りくりょくきょうしん": "تَضَامُن (التعاون والتكاتف بين أفراد أو جهات لتحقيق هدف مشترك أو دعم بعضهم البعض؛ الشعور بالمسؤولية الجماعية تجاه قضية أو موقف)\nمثال: التضامن اساس الإنسانية.",
 "りくろ": "بَرِّيّ, عَبْر البَرّ (يسافر أو يمرّ عبر اليابسة)",
 "りくガメ": "سُلَحْفَاة",
 "りぐん": "عُزْلَة",
 "りけい": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "りけん": "فَائِدَة",
 "りけんだんたい": "جماعة ضغط, مجموعة مصالح خاصة (مجموعة مصالح تحاول التأثير على المشرعين أو البيروقراطيين للعمل لصالحهم، عادة من خلال الضغط)",
 "りけんや": "إسْتِغْلَالِيّ, اِنْتِهَازِيّ",
 "りけんビジネス": "صاحب امتياز (شخص يحمل أو يدير حق امتياز تجاري)",
 "りげん": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / عَامِّيَّة, دَارِجَة / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "りこ": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين)",
 "りこう": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة) / أَدَاء / مَسْرَحِيَّة",
 "りこしゅぎ": "أَنَانِيَّة",
 "りこしゅぎしゃ": "أناني, متمركز حول ذاته (شخص يركز على ذاته ولا يقيم وزناً للآخرين) / أناني, شخص متمركز حول ذاته (شخص مغرور ومهتم بنفسه فقط)",
 "りこしん": "أَنَانِيَّة",
 "りこてき": "أَنَانِيّ",
 "りこん": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته. / جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "りこんびょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "りご": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / عَامِّيَّة, دَارِجَة",
 "りさい": "مُعَانَاة",
 "りさいしゃ": "ضَحِيَّة / أُضْحِيَّة",
 "りさいみん": "ضَحِيَّة / أُضْحِيَّة",
 "りさつ": "قَسِيمَة / كُوبُون, قَسِيمَة شِرائِيَّة",
 "りさん": "تَشَتُّت",
 "りさんてき": "مُمَيَّز, مُنْفَصِل / مُتَقَطِّع",
 "りざい": "تَمْوِيل, مَالِيَّة / مَوَّل",
 "りざいか": "خبير مالي, ممول (شخص ماهر في المعاملات المالية واسعة النطاق)",
 "りざいがく": "اقتصاد, علم الاقتصاد (فرع العلوم الاجتماعية الذي يتعامل مع إنتاج وتوزيع واستهلاك السلع والخدمات وإدارتها)",
 "りざや": "هَامِش إِجْمَالِيّ, هَامِش الرِّبْح (نسبة إجمالي الأرباح مقسومة على صافي المبيعات)",
 "りし": "فَائِدَة",
 "りしゅう": "روتين, روتين بيروقراطي (إجراء يستهلك وقتاً طويلاً بلا داع) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / أخذ, غنيمة (فعل شخص يلتقط أو يأخذ شيئًا ما)\nمثال: كانت الغنائم سهلة",
 "りしゅうかもく": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "りしょう": "انكماش الهلام, نضْح (انفصال السائل عن الهلام الناتج عن الانكماش (كما في صناعة الجبن)) / دمج الحركات (انكماش حرفين متحركين في إدغام)",
 "りしょくしゃ": "عاطل عن العمل (شخص بلا وظيفة)",
 "りしりつ": "سِعْر الْفَائِدَة (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "りしん": "رُبُوبِيَّة",
 "りしんりつ": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "りしんろん": "رُبُوبِيَّة",
 "りじ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "りじかい": "مَجْلِس إِدَارَة",
 "りじちょう": "مدير (شخص يتحكم في الموارد والنفقات)",
 "りじゅん": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "りじん": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته. / قَرَوِيّ, قَرَوِيَّة",
 "りじんしょう": "تجريد من الشخصية, تشييء (تمثيل إنسان كشيء مادي مجرد من الصفات الشخصية أو الفردية) / اختلال الإنية, تبدد الشخصية ((في الوجودية) فقدان الهوية الشخصية؛ شعور الفرد بأنه ترس مجهول في آلة اجتماعية غير شخصية) / اضطراب تبدد الشخصية, تبدد الشخصية (اضطراب انشقاقي عاطفي يحدث فيه فقدان للاتصال بالواقع الشخصي للفرد مصحوباً بمشاعر اللاواقعية والغرابة)\nمثال: وفقًا لماركس، فإن معاملة العمل كسلعة تجسد تشييء الفرد",
 "りす": "سِنْجَاب",
 "りすい": "سَقْي",
 "りすう": "مَسَافَة بِالمِيل (المسافة المقاسة بالأميال) / بدل الأميال, تعويض المسافة (بدل سفر بمعدل معين لكل ميل مقطوع) / اِسْتِهْلَاك الوَقُود (نسبة عدد الأميال المقطوعة إلى عدد جالونات البنزين المحروقة)",
 "りすざる": "سعدان السنجاب (قرد صغير طويل الذيل يعيش في أمريكا الوسطى والجنوبية، ذو فراء مخضر وخطم أسود)",
 "りすもどき": "زبابيات الشجر (ثديي شجري آكل للحشرات من جنوب شرق آسيا يشبه السنجاب وله عيون كبيرة وخطم حاد طويل)",
 "りする": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / فَائِدَة, جَدْوَى / اِسْتَغَلَّ",
 "りせい": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
