 "やしない": "تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل…)\nمثال: لن نستمر في تغذية الانتقامات. / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "やしないおや": "عراب المعمودية (شخص يكفل شخصاً (الطفل الروحي) عند المعمودية)",
 "やしないご": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "やしないそだてる": "بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "やしなう": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تَبَنَّى / طَوَّرَ",
 "やしのき": "نَخْلَة",
 "やしのみ": "جَوْز الْهِنْد (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "やしの木": "نَخْلَة",
 "やしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "やしまくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "やしゅ": "خُشُونَة, رِيفِيَّة (صفة كون الشخص ريفياً أو فجاً) / لاعب ميداني, مدافع (عضو في فريق الكريكيت يقوم بالدفاع (الالتقاط) بدلاً من الضرب)",
 "やしゅせんたく": "خيار المدافع (لعبة تتم على كرة أرضية يختار فيها المدافع إخراج عداء متقدم بدلاً من الضارب)",
 "やしゆ": "دُهْن النَارَجِيل, دُهْن جَوْز الْهِنْد (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "やしょく": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "やしろ": "ضَرِيح",
 "やしん": "مَطْمَح / خيانة, غدر (فعل خيانة متعمد)",
 "やしんてき": "طَمُوح",
 "やじ": "تَافِه, لَا يُسَاوِي فَلْساً (شيء ذو قيمة قليلة جداً)\nمثال: وعده لا يساوي فلساً",
 "やじうま": "فضولي, متطفل (شخص يحدق بفضول)",
 "やじうまこんじょう": "تطفل, حشرية (فضول مزعج وتدخل فيما لا يعنيك)",
 "やじゅう": "حَيَوَان بَرِّيّ, حَيَوَان وَحْشِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "やじゅうしゅぎ": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة…)",
 "やじゅうは": "الوحشية (حركة فنية انطلقت عام 1905 تميزت أعمالها بألوان زاهية وغير طبيعية وأشكال بسيطة…)",
