{
 "むち": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام. / وَقِح, صَفِيق / سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع) / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "むちいれ": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "むちうち": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري) / جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "むちうちしょう": "جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "むちうつ": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "むちぐまい": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل) / سَاذَج, غَيْرُ مُوَجَّه (يفتقر إلى المعلومات أو التوجيه)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "むちっ": "سمين",
 "むちつじょ": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "むちはこうふく": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "むちむち": "سمين",
 "むちもうまい": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل) / سَاذَج, غَيْرُ مُوَجَّه (يفتقر إلى المعلومات أو التوجيه)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "むちゃ": "عَبَثِيّ, سَخِيف / طَفْح, طَفْح جِلْدِيّ / مُفْرِط, زَائِد / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "むちゃくちゃ": "لَا مَعْقُول, هُرَائِيّ (لا يحمل أي معنى مفهوم) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية) / بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً / اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "むちゃくりく": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة) / بلا توقف (بدون توقف) / دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع) / بِدُون تَوَقُّف ((عَنِ الرِّحْلَات خَاصَّةً الجَوِّيَّة) تَتِمّ بِدُون تَوَقُّفَات)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "むちゃくりくひこう": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "むちゃむちゃ": "بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً",
 "むちゃんこ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "むちゅう": "ذهول, غشاوة (ارتباك يتميز بنقص الوضوح) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: تركه موت والدته في حالة ذهول",
 "むちゅうゆうこうしょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むちょう": "لا نغمية (غياب السلم الموسيقي؛ بديل للنظام الدياتوني)",
 "むちょうかん": "سِكْرِتِير, سِكْرِتِيرَة",
 "むちょうせい": "غَيْر مَضْبُوط, غَيْر مُعَدَّل (لم يتم تغييره ليتناسب مع متطلبات معينة) / غَيْر مُتَكَيِّف (لم يتأقلم مع الظروف الجديدة)\nمثال: رقم غير معدل بنسبة 8.5 في المائة",
 "むちょうせいとうにゅう": "حَلِيب صُويَا (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "むちをくれる": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "むちん": "مَجَّانِيّ, مَجَّانًا",
 "むち打ち": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري) / جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "むち打ち症": "جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "むち打つ": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "むっくと": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء",
 "むっくり": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء / سمين",
 "むっさい": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "むっすり": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "むっちむち": "سمين",
 "むっちゃ": "عَبَثِيّ, سَخِيف / طَفْح, طَفْح جِلْدِيّ / مُفْرِط, زَائِد / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "むっちり": "سمين",
 "むっつ": "سِتَّة / اَلسَّاعَة اَلسَّادِسَة",
 "むっつり": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "むっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "むつ": "سِتَّة / اَلسَّاعَة اَلسَّادِسَة",
 "むつう": "غَيْر مُؤْلِم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "むつうしょう": "تسكين الألم, فقدان الإحساس بالألم (غياب الإحساس بالألم دون فقدان الوعي)",
 "むつかしい": "صَعْب / مُسْتَحِيل / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط) / كَئِيب, مُوحِش",
 "むつかる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "むつき": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير. / حِفَاضة, حِفَاظ / قيود (القيود المفروضة على غير الناضجين) / قماط, ملابس التقميط (رداء (ثوب أو شرائط ضيقة من القماش) للرضيع) / سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "むつご": "سُدَاسِيّ, سِتَّة (العدد الأصلي الذي هو مجموع خمسة وواحد)",
 "むつごろう": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على اليابسة باستخدام زعانف صدرية قوية)",
 "むつどき": "اَلسَّاعَة اَلسَّادِسَة",
 "むつまじい": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "むつらぼし": "الثُّرَيَّا",
 "むづかしい": "صَعْب / مُسْتَحِيل / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط) / كَئِيب, مُوحِش",
 "むて": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه) / خَالِي الوِفَاض, صِفْر اليَدَيْن (لم يكتسب أو يحصل على شيء)",
 "むていけい": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "むていけん": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ) / غير متسق, متناقض (يظهر نقصاً في الاتساق) / غَيْرُ مُتَّسِقٍ, مُتَنَاقِضٌ (لا يمكن جعله متسقاً أو منسجماً)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "むていこう": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "むていこうしゅぎ": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "むていでんでんげん": "فَوْقَ, فَوْق / لِأَعْلَى",
 "むていでんでんげんそうち": "فَوْقَ, فَوْق / لِأَعْلَى",
 "むてき": "مَنِيع / بوق الضباب (جهاز تحذير يتكون من بوق يولد نغمة منخفضة عالية الصوت) / إشارة الضباب, بوق الضباب (إشارة تحذير منخفضة وعالية الصوت يمكن سماعها من قبل السفن المحاصرة بالضباب)",
 "むてっぽう": "طَفْح, طَفْح جِلْدِيّ",
 "むてん": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "むでん": "لَاسِلْكِيّ",
 "むとう": "خال من السكر (لا يحتوي على السكر)",
 "むとうざい": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "むとうせい": "خارج عن السيطرة, غير منضبط (غير خاضع للسيطرة؛ خارج السيطرة)\nمثال: أكبر مشكلة صحية غير مسيطر عليها هي الإيدز",
 "むとうはそう": "ناخب متأرجح (ناخب ليس لديه ولاء لأي حزب سياسي ويمكن لقراراته غير المتوقعة أن ترجح كفة الانتخابات)",
 "むとく": "فَقِير / مِسْكِين / فُقَرَاء",
 "むとくてん": "بِلَا أَهْدَاف, بِلَا نِقَاط (لم يُسجَّل فيه أي نقاط أو أهداف)",
 "むとす": "إرَادَة / رَغْبَة, إرَادَة / تَعَمَّدَ, نَوَى",
 "むとどけ": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة) / غير مسجل (غير مسجل) / غير مسجل ((للحيوانات) غير مسجل أو معتمد لدى جمعية سلالة رسمية)\nمثال: مواطن غير مسجل",
 "むとんじゃく": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / فَاتِر, لَامُبَالٍ (يتّسم بانعدام الاهتمام) / وَسَطِيّ (لَيْسَ مُفْرِطًا وَلَا قَلِيلًا جِدًّا)",
 "むとんちゃく": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / فَاتِر, لَامُبَالٍ (يتّسم بانعدام الاهتمام) / وَسَطِيّ (لَيْسَ مُفْرِطًا وَلَا قَلِيلًا جِدًّا)",
 "むどう": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "むどく": "غَيْرُ سَامّ (آمن للأكل) / غَيْرُ سَامّ (لا ينتج سمًّا ولا يحتوي عليه)",
 "むどくか": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان)",
 "むな": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / ثَدْي, بز / قَلْب, فُؤَاد / قَلْب / كُبَّا / رِئَة, سَحَر",
 "むなあて": "لَبَب / مِرْيَلَة",
 "むないた": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "むなかき": "عارضة الدولفين (عارضة تحت الصاري المائل لمركب شراعي) / لجام الصدر, مارتنجال (شريط سرج يربط قطعة الأنف بالحزام البطني؛ يمنع الحصان من رفع رأسه للخلف)",
 "むながい": "عارضة الدولفين (عارضة تحت الصاري المائل لمركب شراعي) / لجام الصدر, مارتنجال (شريط سرج يربط قطعة الأنف بالحزام البطني؛ يمنع الحصان من رفع رأسه للخلف)",
 "むながらみ": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "むながわら": "قرميد القمة (بلاط زخرفي منحني في المقطع العرضي؛ يستخدم لتغطية قمة السقف)",
 "むなぎ": "أَنْقَلِيس, أَنْكَلِيس / عارضة القمة, قمة السقف (عارضة موضوعة على طول الحافة حيث يلتقي جانبان مائلان للسقف في الأعلى؛ توفر مرفقاً للنهايات العليا للعوارض الخشبية)",
 "むなくそ": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / مُقْرِف, مُقَزِّز",
 "むなくそがわるい": "مُقْرِف, مُقَزِّز",
 "むなくそわるい": "مُقْرِف, مُقَزِّز",
 "むなぐら": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "むなこと": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "むなさき": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "むなさわぎ": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "むなざんよう": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "むなしい": "فَارِغ / فَرَغَ / سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / جُثَّة هَامِدَة, فَاقِد الحَيَاة (حُرم من الحياة؛ لم يعد على قيد الحياة) / خَالٍ مِنَ الحَيَاة (لا يمتلك القدرة على دعم الحياة) / مَيِّت, هَامِد (فاقد للحيويّة والنشاط والإثارة) / خَاوٍ مِنَ الحَيَاة (خَالٍ مِنَ الحَيَاة أَوْ فُرِّغَ مِنَ الكَائِنَات الحَيَّة)",
 "むなしく": "عَبَثًا, سُدًى",
 "むなしくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "むなじろてん": "دلق الحجر (دلق أوراسي ذو معطف بني مع صدر وحلق شاحب)",
 "むなち": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "むなぢ": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "むなひぼ": "طُفُولَة",
 "むなひも": "طُفُولَة",
 "むなびれ": "زعنفة صدرية (إحدى زوج من الزعانف تقع خلف الرأس مباشرة في الأسماك تساعد في التحكم في اتجاه الحركة)",
 "むなもと": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "むなやけ": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "むに": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى) / بُوذَا, بُدّ",
 "むにする": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها. / فَارِغ / فَرَغَ",
 "むにむさん": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه / فَرِيد, فَذّ",
 "むにむざん": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه / فَرِيد, فَذّ",
 "むにむに": "إسْفَنْجِيّ, طَرِيّ مَطَّاطِيّ (ذو قِوام إسْفَنْجِيّ؛ لَيِّن ومَليء بالمَسامّ)",
 "むにゃむにゃ": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام)",
 "むにゅう": "انقطاع اللبن, عوز اللبن (حالة عدم إفراز الحليب في ثدي الأم بعد الولادة)",
 "むにゅうしょう": "انقطاع اللبن, عوز اللبن (حالة عدم إفراز الحليب في ثدي الأم بعد الولادة)",
 "むにゅうぼうしょう": "انعدام الثدي (غياب الغدد الثديية (إما عن طريق الجراحة أو عيب في النمو))",
 "むにょう": "انحباس البول, انقطاع البول (عدم القدرة على التبول)",
 "むにん": "غير مأهول, مُسير عن بعد (يفتقر إلى طاقم)\nمثال: قمر صناعي غير مأهول إلى المريخ",
 "むにんしき": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به) / غَيْر مُعْتَرَف بِه (لا يتمتّع بسمعة راسخة)",
 "むね": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / ثَدْي, بز / قَلْب, فُؤَاد / قَلْب / كُبَّا / رِئَة, سَحَر / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله) / سلسلة جبال",
 "むねあて": "لَبَب / مِرْيَلَة",
 "むねおどる": "مُثِير",
 "むねかざり": "بْرُوش",
 "むねがわるい": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / مَرِيض, مُتَأَثِّر بِعُمْق (متأثر تأثرًا عميقًا بشعور قوي) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت) / غَاضِب, غَضْبَان",
 "むねくそ": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / مُقْرِف, مُقَزِّز",
 "むねくそがわるい": "مُقْرِف, مُقَزِّز",
 "むねさんずん": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "むねざんよう": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "むねつぶし": "رابط, موثق (شيء يستخدم للربط أو التوثيق) / حافظة ملفات, مجلد (أداة لحفظ الأوراق السائبة أو المجلات) / آلة حصاد وربط (آلة تقطع الحبوب وتربطها في حزم) / رابط, مادة رابطة (شيء يستخدم لربط الجسيمات المنفصلة ببعضها البعض أو تسهيل الالتصاق بسطح ما)",
 "むねにいちもつ": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "むねにおさめる": "احتفظ بكل شيء لنسفه",
 "むねにく": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "むねにたたむ": "احتفظ بكل شيء لنسفه",
 "むねのすく": "مُنْعِش",
 "むねのたにま": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "むねひも": "طُفُولَة",
 "むねやけ": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "むねわる": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "むねん": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "むねんがる": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "むねんをはらす": "اِنْتَقَمَ",
 "むねポケ": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "むねポケット": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "むね肉": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "むのう": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "むのうしゃ": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "むのうやく": "عُضْوِيّ",
 "むのうりょく": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "むのうりょくしゃ": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "むはい": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "むはいりょ": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين) / غَيْرُ مُتَرَوٍّ, مُتَسَرِّع (بِدُونِ تَفْكِيرٍ أَوْ تَأَمُّلٍ كَافٍ)\nمثال: سلوك مستهتر بشكل صادم",
 "むはっこうパン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "むはんのう": "غير متجاوب, غير مستجيب (لا يستجيب لتأثير أو محفز ما) / غَيْر مُسْتَجِيب (لا يتأثر بالإيحاء أو التأثير) / غَيْرُ مُتَجَاوِب, لَامُبَالٍ (منعزل وغير مبالٍ؛ بارد المشاعر)",
 "むばいかい": "فورية, مباشرة (عدم وجود وسيط أو وكالة متداخلة) / آنية, فورية (سرعة الفعل أو الحدوث) / إدراك فوري, بداهة (وعي حدسي فوري)\nمثال: فورية التغطية التلفزيونية",
 "むばんそう": "منفرداً, وحده (دون أي شخص أو شيء آخر) / بِدُون, غَيْر مَصْحُوب ((عن حالة أو حدث) يحدث دون شيء محدّد مصاحب له) / غير مصحوب, وحيد (بدون مرافقة) / غير مصحوب (بموسيقى) (عزف أو غناء بدون مصاحبة)\nمثال: بقي الطفل في المنزل وحده",
 "むひ": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "むひしょう": "اِنْعِْدَام الطِحَال",
 "むひしょうこうぐん": "اِنْعِْدَام الطِحَال",
 "むひつ": "أُمِّيَّة",
 "むひはん": "أعمى (في الاتباع), غير انتقادي (غير ناقد؛ لا يميل إلى البحث عن الأخطاء أو لفت الانتباه إليها) / غير ممحص, غير نقدي (يتميز بتجاهل المعايير أو الإجراءات النقدية)\nمثال: معجب مخلص وتقريباً غير انتقادي (أعمى)",
 "むひょう": "بَرَد (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد)\nمثال: لا أتحمل البرد. / غير موسوم, غير مُميز (ليس لديه علامة تعريف) / غَيْر مُلَاحَظ, مُغْفَل (لم يُؤخَذ في الحسبان)\nمثال: أوراق لعب غير معلمة",
 "むひょうはく": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "むび": "نَائِم",
 "むびゅう": "عِصْمَة",
 "むびるい": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز؛ أنواع شبه مائية وأرضية) / بتراواني (يتعلق بالضفادع والعلاجيم)",
 "むふう": "بِلَا رِيَاح, سَاكِن الرِّيح (بِدُون رِيَاح أَوْ بِرِيَاحٍ شِبْه مَعْدُومَة) / صَامِت, هَادِئ",
 "むふんべつ": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "むへい": "جَالِس, عَدِيم السُّوَيْقَة (متصل مباشرة بالقاعدة؛ ليس له ساق وسيطة) / ثَابِت, لَاطِئ (متصل بشكل دائم بركيزة؛ ليس حراً في التحرك)\nمثال: زهور لاطئة",
 "むへん": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء / موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات الشخصية)",
 "むへんさい": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "むへんざい": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "むべ": "بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "むべなるかな": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "むほう": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "むほうこっか": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "むほうしゃ": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "むほうしゅう": "بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة",
 "むほうしん": "انعدام الهدف, عبثية (صفة الافتقار إلى أي غرض محدد)",
 "むほうじょうたい": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "むほうもの": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "むほん": "ثَوْرَة, تَمَرُّد",
 "むほんにん": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "むぼう": "غَيْر مُغَطًّى, مَكْشُوف (غير مغطى بالملابس) / مُتَهَوِّر",
 "むぼうび": "أَعْزَل",
 "むま": "كَابُوس / جَاثُوم, كَابُوس / كابوس, حلم / باروك",
 "むみ": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة) / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "むみかんそう": "كَلِيل",
 "むみむしゅう": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ) / رَتِيب, فَاتِر (يفتقر إلى خصائص مثيرة؛ غير مشوق) / تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "むむ": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / مليمتر (وحدة مترية للطول تساوي واحداً من الألف من المتر) / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "むむじゅんせい": "اِتِّسَاق",
 "むめ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة) / أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية) / في أدنى مستوى (في أدنى وضع؛ الأقرب إلى الأرض)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى / رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه) / نافذة العارضة (نافذة فوق الباب تكون عادة مفصلية بعارضة أفقية فوق الباب)",
 "むめい": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى) / مُظْلِم / اتِّفَاقِيّ, بِلَا سَبَب (ليس له سبب أو سبب ظاهر) / بِلَا سَبَب, بِلَا مُبَرِّر (ليس له سبب أو مبرر يبرره) / غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "むめいこつ": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة)",
 "むめいし": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ) / بِنْصِر",
 "むめいせんし": "الجندي المجهول (جندي غير محدد الهوية يتم تكريم جثمانه كنصب تذكاري)",
 "むめいどうみゃく": "الجذع العضدي الرأسي, شريان لا اسم له (شريان كبير ينشأ من قوس الأبهر وينقسم إلى الشريان تحت الترقوة الأيمن والشريان السباتي المشترك الأيمن؛ يغذي الجانب الأيمن من الرقبة والرأس والكتف…)",
 "むもう": "أَجْرَد",
 "むもくてき": "بلا هدف, عبثي (لا يظهر أي غرض أو هدف) / عَبَثِيّ, لَا طَائِلَ مِنْه (لَا يَخْدِمُ أَيَّ غَرَضٍ مُفِيد؛ لَا مُبَرِّرَ لِوُجُودِه)",
 "むもん": "سادة, غير منقوش (يفتقر للنقوش خاصة في اللون)",
 "むやく": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "むやちん": "دُونَ إِيجَار, مَجَّانًا (بدون دفع إيجار) / مُعْفًى مِنَ الإِيجَار (مَجَّانِيّ؛ بِدُونِ دَفْعِ إِيجَار)\nمثال: يمكنني العيش هنا مجاناً",
 "むやみ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة / مُفْرِط, زَائِد",
 "むやみに": "باستهتار, بلا تفكير (إظهار عدم التفكير) / دون تفكير (بطريقة خالية من التفكير)\nمثال: عامل والديه باستهتار / بإفراط, بشكل مبالغ فيه (لدرجة تتجاوز الحدود الطبيعية أو المناسبة)\nمثال: كبير جداً",
 "むやみやたら": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة / مُفْرِط, زَائِد",
 "むゆう": "غير لامع, غير مصقول (ليس له طبقة لامعة) / غير مزجج (غير مزود بالزجاج)\nمثال: ورق غير مصقول / سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むゆうしょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むゆうびょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "むゆうびょうしゃ": "سائر في النوم (شخص يمشي أثناء نومه)",
 "むよう": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية) / مَحْظُور, مَمْنُوع (غَيْر مَسْموح بِهِ بِمُوجَب القانون) / مَحْظُور, مُحَرَّم (ممنوع استخدامه أو ذكره)",
 "むようのちょうぶつ": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب) / خشب ميت (فرع أو جزء من شجرة ميت)",
 "むよく": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً) / غير أناني, مؤثر (للغير) (يتجاهل مصالحه ورفاهيته الخاصة لصالح الآخرين)",
 "むら": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة. / تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / تَقَلُّب, غَدْر (عدم الوفاء بحكم عدم الموثوقية أو الغدر) / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "むらい": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "むらがり": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "むらがる": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
