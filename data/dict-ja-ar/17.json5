 "よくふか": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "よくふかい": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "よくふく": "باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي)",
 "よくぶか": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "よくぶかい": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "よくぼう": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "よくまあ": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "よくめ": "اِنْحِيَاز",
 "よくも": "بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة) / بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: كان ودوداً بشكل مفاجئ",
 "よくもまあ": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "よくやき": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "よくよう": "تَجْوِيد, تَرْتِيل (جوّد القارئ:أتى بـ التّلاوة على وجهها الحقّ وراعى أحكام التّجويد في القرآن (قرأ القرآن مُجوّداً):رتّله ترتيلاً؛ تجوّد في العمل:تأنّق فيه،والشيء:تخيّره وطلب أن يكون جيّداً)",
 "よくようかく": "تفعيلة إيامبية, تفعيلة قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-مشددة)",
 "よくようのない": "مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "よくよく": "بِعِنَايَة / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / حَرِيص, حَكِيم / حَرِيص",
 "よくよくようかく": "تفعيلة أنابيستية, تفعيلة قصيرة-قصيرة-طويلة (وحدة مترية بمقاطع غير مشددة-غير مشددة-مشددة)",
 "よくりゅう": "اِحْتِجَاز, حَجْز / تيروصور, زاحف مجنح (زاحف منقرض من العصر الجوراسي والطباشيري له منقار يشبه الطيور وأجنحة غشائية مدعومة بالإصبع الرابع الطويل جداً لكل طرف أمامي)",
 "よくりゅうしゃ": "أسير, أسيرة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "よくろう": "جناح الكنيسة, مجاز مستعرض (هيكل يشكل الجزء المستعرض للكنيسة المصلبة؛ يقطع صحن الكنيسة بزوايا قائمة)",
 "よくをいうと": "بشكل مثالي, مثالياً (بطريقة مثالية)\nمثال: بشكل مثالي، هذا سيزيل كل المشاكل",
 "よくをいえば": "بشكل مثالي, مثالياً (بطريقة مثالية)\nمثال: بشكل مثالي، هذا سيزيل كل المشاكل",
 "よくをかく": "طَمُعَ, طَمِعَ",
 "よくスパン": "باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي)",
 "よく出来た": "مُتَوَازِن",
 "よく出来ました": "أَحْسَنْتَ, أَحْسَنْتِ",
 "よく焼き": "نَاضِجٌ تَمَامًا ((عَنِ اللَّحْم) مَطْهُوٌّ حَتَّى لَمْ يَبْقَ لَحْمٌ وَرْدِيٌّ بِدَاخِلِه)",
 "よく考えたら": "فِعْلًا",
 "よけ": "حِمَايَة",
 "よけい": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا. / إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "よけいもの": "الصنيَة",
 "よける": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري / يَدْرَأ",
 "よけん": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / مُسَلَّم ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "よげん": "جَيْب تَمَام (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب. / تَنَبُّؤ / نُبُوءَة, تَنَبُّؤ",
 "よげんしゃ": "نَبِيّ, نَبِيء (و من النبوة النبي لأنه أشرف خلق الله؛ ما إرتفع عن الأرض) / مُتَنَبِّئ, نَبِيء\nمثال: إلياس نبي من عند الله.",
 "よこ": "أُفُقِيّ / جانبي, من جانب لآخر (بالتناوب يساراً ويميناً بالنسبة لنقطة مركزية)\nمثال: الحركة الجانبية للقارب / جَانِب / صَفْحَة / بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً",
 "よこあい": "جَانِب / صَفْحَة",
 "よこあな": "كَهْف, غَار",
 "よこいたにあまだれ": "تَلَجْلَجَ, تَلَعْثَمَ",
 "よこいっせん": "بِمُحَاذَاة, جَنْبًا إِلَى جَنْب (بجانب بعضهما البعض، متجهين في نفس الاتجاه) / بسباق محموم, جنباً إلى جنب (متساوٍ أو متقارب في سباق أو منافسة أو مقارنة) / رَأْسًا بِرَأْسٍ, مُتَعَادِل (غَيْرُ حَاسِمٍ مِنْ حَيْثُ النَّتِيجَةُ؛ مُتَقَارِبٌ أَوْ مُتَسَاوٍ فِي سِبَاقٍ أَوْ مُنَافَسَةٍ)\nمثال: ركضت الخيول جنباً إلى جنب",
 "よこいと": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "よこう": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ / بَرُوفَة / أثر طيب, نشوة لاحقة (متعة تذكر حدث سار) / شفق, وهج لاحق (وهج يُرى أحياناً في السماء بعد غروب الشمس)\nمثال: استمتع بنشوة انتصاره / أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية) / أثر تال, أثر لاحق (تأثير متأخر لدواء أو علاج)\nمثال: كان للدواء آثار تالية غير متوقعة",
 "よこうえんしゅう": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "よこうれんしゅう": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "よこおよぎ": "سباحة جانبية (طريقة سباحة تتحرك فيها الذراعان للأمام والخلف بينما تقوم الساقان بركلة المقص)",
 "よこかぜ": "رياح جانبية (رياح تهب عبر مسار سفينة أو طائرة)",
 "よこがお": "حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز",
 "よこき": "عارضة, قطعة عرضية (دعامة مستعرضة) / جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "よこぎ": "عارضة, قطعة عرضية (دعامة مستعرضة) / جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "よこぎる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "よこく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / مَقْطُورَة / تَشْوِيقَة / حَلِيف, حَلِيفَة",
 "よこくし": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في ذلك المستوى)",
 "よこくへん": "مَقْطُورَة / تَشْوِيقَة",
 "よこぐし": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في ذلك المستوى)",
 "よこぐるま": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب) / عناد, مخالفة (تمرد متعمد وعنيد ومقاومة للتوجيه أو الانضباط)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "よここう": "مدخل أفقي للمجم, نفق أفقي (ممر أفقي تقريباً من السطح إلى داخل المنجم)",
 "よこさま": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "よこざい": "عارضة, قطعة عرضية (دعامة مستعرضة) / جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "よこざひょう": "إِحْدَاثِيّ سِينِيّ, الإحداثي الأفقي (قيمة الإحداثي على المحور الأفقي)",
 "よこざま": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "よこざん": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "よこし": "طِحَال",
 "よこしま": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "よこじく": "إِحْدَاثِيّ سِينِيّ, الإحداثي الأفقي (قيمة الإحداثي على المحور الأفقي)",
 "よこす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "よこすじ": "عَرْضِيّ, مُسْتَعْرِض (يَمْتَدّ أَوْ يَقَع بِالعَرْض؛ في اتِّجاه عَمودِيّ عَلى المِحْوَر)",
 "よこすじジャッカル": "ابن آوى مخطط الجانب (ابن آوى موطنه جنوب أفريقيا ذو شريط أسفل جانبه)",
 "よこすべり": "انزلاق جانبي (مناورة طيران؛ تنزلق الطائرة جانبياً في الهواء) / انزلاق, تزحلق (انزلاق غير متوقع)",
 "よこずれだんそう": "صدع انزلاقي الاتجاه (صدع جيولوجي يبدو فيه أن أحد السطحين المتجاورين قد تحرك أفقياً)",
 "よこせいさく": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة) / تجهيزات الصاري, حبال السفينة (معدات تتكون من حبال وما إلى ذلك تدعم سواري السفينة وأشرعتها)",
 "よこたわる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "よこだき": "مَهْد",
 "よこちょ": "بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه) / بشكل جانبي, جانبياً (في اتجاه جانبي) / بشكل مائل, من الجانب (من الجانب؛ بشكل منحرف) / بالجنب, بالعرض (مع تقديم جانب واحد للأمام)\nمثال: عيون ترمق بطرف العين من وجه ذابل",
 "よこちょう": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "よこっちょ": "بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه) / بشكل جانبي, جانبياً (في اتجاه جانبي) / بشكل مائل, من الجانب (من الجانب؛ بشكل منحرف) / بالجنب, بالعرض (مع تقديم جانب واحد للأمام)\nمثال: عيون ترمق بطرف العين من وجه ذابل",
 "よこっつら": "جَانِب / صَفْحَة",
 "よこっぱら": "جَانِب / صَفْحَة",
 "よこつら": "جَانِب / صَفْحَة",
 "よこづけ": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)",
 "よこて": "جَانِب / صَفْحَة",
 "よこで": "جَانِب / صَفْحَة",
 "よこどり": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "よこなが": "مُسْتَطِيل (مُنْحَرِف عَن شَكْل المُرَبَّع أَوْ الدَّائِرَة بِاسْتِطالَتِه في اتِّجاه واحِد) / مُسْتَطِيل الوَرَقَة ((عن شكل الورقة) ذو شكل مُستطيل بعض الشيء بجوانب شبه متوازية) / شكل مستطيل, مستطيل (شكل مستوٍ ينحرف عن المربع أو الدائرة بسبب الاستطالة)",
 "よこなぐり": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "よこに": "أفقياً (في اتجاه أفقي)\nمثال: غالباً ما يتم إضافة معرض للاستفادة من المساحة رأسياً وأفقياً / عَبْرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "よこになる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "よこにらみ": "وَهَج",
 "よこね": "دبل (عقدة لمفاوية ملتهبة ومتورمة بسبب الطاعون أو السيلان أو السل)",
 "よこはば": "اتساع, عَرْض (مدى الشيء من جانب إلى آخر) / سعة أفق, شمولية (القدرة على فهم مجموعة واسعة من المواضيع)\nمثال: يجب أن يكون لدى المعلم شمولية في المعرفة بالمادة",
 "よこはま": "يُوكُوهَامَا\nمثال: 私の妹は横浜の近くに住んでいる。 — تعيش أختي قرب يوكوهاما.",
 "よこばい": "نطاط الأوراق (حشرة صغيرة قافزة تمتص عصارة النباتات) / أفعى جانبية الحركة, أفعى مقرنة / سايدويندر (صاروخ جو-جو بجهاز توجيه بالأشعة تحت الحمراء) / مُثَبِّت, مُسْتَقِرّ (يُؤَدِّي إلى الاسْتِقْرار والثَّبات)",
 "よこばいガラガラへび": "أفعى جانبية الحركة, أفعى مقرنة / سايدويندر (صاروخ جو-جو بجهاز توجيه بالأشعة تحت الحمراء)",
 "よこばら": "جَانِب / صَفْحَة",
 "よこばり": "جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "よこぶえ": "ناي, ناي مستعرض (آلة نفخ خشبية عالية النبرة؛ أنبوب رفيع مغلق من أحد طرفيه بفتحات للأصابع في أحد طرفيه وفتحة بالقرب من الطرف المغلق يتم نفخ الهواء عبرها) / ناي الحفلات الغربي, ناي بوهيم (ناي الحفلات الغربي (يسمى أيضاً الناي المستعرض أو ناي بوهيم) هو آلة نفخ خشبية تُعزف من الجانب ومصنوعة من المعدن أو الخشب)",
 "よこぶとり": "قَصِير وَبَدِين, مُكَتَّل (قَصِير القَامَة وَمُمْتَلِئ الجِسْم)",
 "よこぼう": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "よこぼり": "خَنْدَق",
 "よこみち": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "よこめん": "جَانِب / صَفْحَة",
 "よこもじ": "خط روماني (نمط خط استخدم في النقوش الرومانية القديمة)",
 "よこもち": "وَسِيلَةُ النَّقْل",
 "よこやり": "مُقَاطَعَة",
 "よこやりをいれる": "قَاطَعَ",
 "よこゆれ": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة",
 "よこをむく": "غضّ النظر, غضّ الطرف",
 "よこパス": "تمريرة عرضية (تمريرة إلى مستقبل في الملعب بعيدًا عن الممرر)",
 "よこ糸": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "よご": "تنبؤ بسير المرض, مآل المرض (التنبؤ بمسار المرض) / تنبؤ, توقعات (تنبؤ حول كيفية تطور شيء ما (مثل الطقس)) / تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة)",
 "よござんした": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها) / مَعَ تَحِيَّاتِي, مَعَ تَمَنِّيَّاتِي (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: ألقى زيري تحية.",
 "よござんす": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها) / مَعَ تَحِيَّاتِي, مَعَ تَمَنِّيَّاتِي (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: ألقى زيري تحية.",
 "よごし": "تلويث, توسيخ (فعل توسيخ شيء ما) / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "よごす": "تُرْبَة, أَرْض / اِتَّسَخَ\nمثال: その本を汚さないように扱ってくれるなら、貸してあげるよ。 — يمكنك استعارة هذا الكتاب بشرط أن تبقيه نظيفاً. / عَار, خِزْي",
 "よごと": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "よごはんてい": "تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي)) / تنبؤ, توقع (بيان يصدر حول المستقبل) / بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "よごれ": "تُرْبَة, تُرَاب / بُقْعَة, قَذَارَة / قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار عالمياً؛ يعتبر أخطر أنواع القرش)",
 "よごれざめ": "قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار عالمياً؛ يعتبر أخطر أنواع القرش)",
 "よごれたかね": "سلب, غنيمة (بضائع أو أموال تم الحصول عليها بشكل غير قانوني)",
 "よさ": "جَدَارَة",
 "よさん": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "よさんか": "مِيزَانِيَّة, مُوَازَنَة",
 "よさんさくげん": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "よさんじょう": "مالي, ميزاني (من أو يتعلق بالميزانية)\nمثال: اعتبارات الميزانية",
 "よさんぶそく": "عجز الميزانية (زيادة النفقات على الإيرادات)",
 "よさんカット": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "よざけ": "المباراة الختامية (المباراة الأخيرة في سلسلة من مباراتين متتاليتين) / قبعة نوم (قبعة قماشية تلبس في السرير) / مشروب قبل النوم (مشروب كحولي يؤخذ عند وقت النوم)",
 "よし": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام) / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بالتأكيد, بلا شك (بدون شك (تستخدم لتعزيز تأكيد)) / مَقْبُول ((استخدام غير معياريّ) مُرْضٍ)\nمثال: ستبلي حسناً بمفردها",
 "よしあし": "نَوْعِيَّة, جَوْدَة",
 "よしありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "よしきた": "جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "よしきりざめ": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "よしとする": "قِيمَة",
 "よしなき": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "よしなしごと": "هُرَاء, لَغْو",
 "よしなし事": "هُرَاء, لَغْو",
 "よしなに": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "よしび": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "よしぶえ": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "よしみ": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "よしもとそうごうげいのうがくいん": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية والعسكرية والأمن القومي؛ تشرف على وكالة الاستخبارات المركزية)",
 "よしゅうごう": "عُمْدَة",
 "よしょく": "لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "よしよし": "جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة. / تلميس, مسح (لمسة خفيفة باليدين)",
 "よしわるし": "نَوْعِيَّة, جَوْدَة",
 "よしん": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار) / هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ / اِئْتِمَان",
 "よしんば": "بِالرَغْم مِن",
 "よじ": "اَلسَّاعَة اَلرَّابِعَة / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "よじげん": "البعد الرابع, الزمن (الإحداثي الرابع المطلوب (إلى جانب الأبعاد المكانية الثلاثة) لتحديد حدث فيزيائي)",
 "よじげんちょうりっぽうたい": "تسراكت, مكعب فائق (النظير رباعي الأبعاد للمكعب)",
 "よじのぼる": "تَسَلَّقَ / شَعْبَطَة",
 "よじょう": "فَائِض / إِيحَائِيَّة (حالة أو صفة الامتلاء بالإيحاءات وتحفيز الفكر)",
 "よじる": "لَوَى, بَرَمَ",
 "よじん": "أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية) / أثر تال, أثر لاحق (تأثير متأخر لدواء أو علاج)\nمثال: كان للدواء آثار تالية غير متوقعة / جَمْرَة / آخَرُون",
 "よじ登る": "تَسَلَّقَ / شَعْبَطَة",
 "よす": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / تضمن",
 "よすいはき": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "よすいろ": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "よすう": "بَقِيَّة / عُمْدَة",
 "よすが": "مُسَاعَدَة / نِسْبِيّ / قَرِيب, قَرِيبَة / منبه للذاكرة, مُذكّر (تجربة تجعلك تتذكر شيئاً ما) / تَذْكِير (رسالة تساعدك على تذكر شيء ما) / مُذكِّر, مُنذِر (شخص يقدم تحذيراً لتجنب وقوع خطأ)\nمثال: تجاهل تذكيرات زوجته",
 "よすぎ": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "よすてびと": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "よせ": "نهاية اللعبة (المراحل النهائية من لعبة الشطرنج بعد إزالة معظم القطع من الرقعة) / مرحلة نهائية, نهاية اللعبة (المراحل النهائية لعملية تفاوض ممتدة)\nمثال: المرحلة النهائية الدبلوماسية / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "よせあつめ": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "よせあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "よせい": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "よせぎ": "أرضية خشبية مزخرفة, باركية (تطعيم خشبي منقوش يستخدم لتغطية الأرضية)",
 "よせぎざいく": "أرضية خشبية مزخرفة, باركية (تطعيم خشبي منقوش يستخدم لتغطية الأرضية)",
 "よせぎれ": "باتشوورك, ترقيع (خياطة تتكون من قطع من مواد مختلفة مخيطة معاً في نمط) / لحاف مرقع (لحاف مصنوع عن طريق خياطة رقع من خامات مختلفة معاً) / خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "よせざん": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "よせせき": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "よせつ": "ظِلّ اَلتَّمَام (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / تَعْلِيق",
 "よせなみ": "تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ)",
 "よせば": "مكان تجمع, ملتقى (مكان مفضل يجتمع فيه الناس) / قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "よせむね": "سقف مائل الجوانب, سقف هرمي (سقف له نهايات مائلة بالإضافة إلى جوانب مائلة)",
 "よせむねづくり": "سقف مائل الجوانب, سقف هرمي (سقف له نهايات مائلة بالإضافة إلى جوانب مائلة)",
 "よせむねやね": "سقف مائل الجوانب, سقف هرمي (سقف له نهايات مائلة بالإضافة إلى جوانب مائلة)",
 "よせもの": "بُودِنْغ",
 "よせよ": "لِوَجْهِ اللّٰهِ, مِنْ أَجْلِ اللّٰهِ",
 "よせる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / نَقَلَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "よせん": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "よせんかい": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف / تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "よせんつうか": "مُؤَهِّل",
 "よせんつうかしゃ": "مُقَيِّدٌ",
 "よせ集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "よそ": "خَارِج, بره / تَجَاهَلَ, طَنَّش / أَرْبَعُونَ",
 "よそいき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "よそう": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق) / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "よそうがい": "مُفَاجِئ",
 "よそうだか": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "よそうや": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل))",
 "よそえる": "قَارَنَ / شَبَّهَ",
 "よそおい": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "よそおう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "よそぎき": "سُمْعَة, شُهْرَة",
 "よそく": "تَنَبُّؤ",
 "よそくふのう": "غَيْرُ مُتَوَقَّع, غَيْرُ مُنْتَظَم (لَا يَحْدُثُ بِمُعَدَّلٍ مُنْتَظَمٍ أَوْ فَتَرَاتٍ ثَابِتَة) / غَيْرُ مُتَوَقَّع (غَيْرُ مَعْرُوفٍ مُسْبَقًا) / غير متوقع, لا يمكن التنبؤ به (لا يمكن التنبؤ به)",
 "よそさま": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "よそながら": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "よそにする": "أَهْمَلَ / إِهْمَال",
 "よそのひと": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "よその人": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "よそもの": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "よそもん": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "よそゆき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "よそよそしい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "よそる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "よそ様": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "よそ者": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "よそ行き": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "よた": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة) / مُغَفَّل, أَحْمَق / غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "よたか": "سبد (طيور غير جاثمة شفقية أو ليلية بشكل رئيسي بريش بني رمادي مبقع وعيون كبيرة؛ تتغذى على الحشرات) / عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "よたく": "بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا. / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "よたくきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "よたばなし": "خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "よたもの": "دَمَوِيّ, سَفَّاح",
 "よたもん": "دَمَوِيّ, سَفَّاح",
 "よたよた": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة)\nمثال: مشى مترنحاً نحو المخرج",
 "よたろう": "كَذَّاب, كَذَّابَة / ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "よだきい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "よだれ": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "よだれかけ": "مِرْيَلَة",
 "よだれどり": "شَهِيّ, لَذِيذ (ذو مذاق طيّب يُسيل اللعاب)",
 "よだれをたらす": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "よだれをだす": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "よだれを出す": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "よだれを垂らす": "أَسَالَ لُعَابًا (فعل تعدّ من سَالَ؛ جعله يَسِيل؛ جعله يُصبح سائلا بعد أن كان غازًا أو صلبا) / هَذَى",
 "よだれ掛け": "مِرْيَلَة",
 "よだれ鶏": "شَهِيّ, لَذِيذ (ذو مذاق طيّب يُسيل اللعاب)",
 "よだん": "تَنَبُّؤ / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "よち": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "よちず": "خَرِيطَةُ الْعَالَمِ (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "よちのうりょく": "تنبؤ, معرفة مسبقة (معرفة حدث قبل وقوعه)",
 "よちょう": "فَأل, نَذِيْر",
 "よちょきん": "حِسَاب مَصْرَفِيّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "よっか": "جَنَاحِيَّة",
 "よっかく": "مُسْتَحِمّ, مُغْتَسِل (شخص يستحم) / سباح (شخص يسافر عبر الماء بالسباحة)\nمثال: استمتع المستحمون بالماء البارد",
 "よっかねつ": "ربعي (يحدث كل رابع يوم (خاصة الحمى والضعف الناجمين عن الملاريا)) / حمى الربع (حمى الملاريا التي تتكرر كل رابع يوم)\nمثال: ملاريا ربعية",
 "よっきゃく": "مُسْتَحِمّ, مُغْتَسِل (شخص يستحم) / سباح (شخص يسافر عبر الماء بالسباحة)\nمثال: استمتع المستحمون بالماء البارد",
 "よっきゅう": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "よっきゅうふまん": "إِحْبَاط",
 "よっこいしょ": "حنق, غضبة (حالة من التهيج أو الانزعاج)",
 "よっしゃ": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "よっしゃー": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "よっつ": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام. / اَلسَّاعَة اَلْعَاشِرَة",
 "よっつのちから": "تفاعل, تفاعل أساسي ((في الفيزياء) نقل الطاقة بين الجسيمات الأولية أو بين جسيم أولي ومجال أو بين المجالات؛ يتوسطه بوزونات قياس)",
 "よって": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "よってきたる": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "よって来たる": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "よって来る": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "よっぱらい": "سَكْرَان, ثَمِل (من شرب الخمر حتى سَكِرَ) / سِكِّير, خِمِّير\nمثال: تبدو كأنها سكرانة.",
 "よっぱらう": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "よっぽど": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / تَقْرِيبًا, عَلَى وَشْك",
 "よつ": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام. / اَلسَّاعَة اَلْعَاشِرَة",
 "よつあし": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / حَيَوَان (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان, وَحْش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "よつおり": "قطع ربعي (حجم كتاب تُصنع صفحاته بطي ورقة مرتين لتكوين أربع ورقات)",
 "よつかど": "مُفْتَرَق, تَقَاطُع",
 "よつぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "よつぎり": "رُبُع (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه) / حَارَة\nمثال: الساعة السادسة و الربع مساء.",
 "よつご": "رباعي (مجموعة من أربعة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم رباعي (واحد من أربعة أطفال ولدوا في نفس الوقت من نفس الحمل) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "よつじ": "مُفْتَرَق, تَقَاطُع",
 "よつつじ": "مُفْتَرَق, تَقَاطُع",
 "よつどもえ": "رُبَاعِيّ الأَضْلَاع (ذو أربعة أضلاع)",
 "よづめ": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "よてい": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "よていあん": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "よていがい": "مُفَاجِئ",
 "よていし": "اسْتِماتَة",
 "よていせつ": "تعيين مسبق, قدرية ((اللاهوت) التحديد مسبقاً؛ وخاصة المذهب (المرتبط عادة بكالفن) القائل بأن الله قد قضى بكل حدث عبر الأبدية (بما في ذلك الخلاص النهائي للبشرية)) / جبرية, قضاء وقدر (تحديد مسبق كما لو كان عن طريق القدر أو المصير)",
 "よていちょうわ": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "よていひょう": "جَدْوَل, جَدْوَل أَعْمَال",
 "よていび": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "よてき": "عصارة اللحم (الدهن الذي ينضح من اللحم ويقطر أثناء شوائه أو قليه)",
 "よとう": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي) / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "よとうむし": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى الأرض)",
 "よとく": "عائد الوظيفة, مكافأة المنصب (تعويض يتم تلقيه بحكم شغل منصب أو وظيفة (عادة في شكل أجور أو رسوم))",
 "よど": "بِرْكَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "よどみ": "رُكُود / ركود اقتصادي / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / مُتَرَدِّد, مُتَلَعْثِم (غير ثابت في الكلام أو الفعل)\nمثال: كان هناك تردد في كلامه",
 "よどみない": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "よどみなく": "بِطَلَاقَة, لِبْلِب",
 "よどむ": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "よなぐにさん": "عثة الأطلس (عثة عملاقة واسعة الانتشار في آسيا؛ تُربى أحياناً من أجل الحرير)",
 "よなぬき": "سلم خماسي (سلم ناقص مكون من خمس نغمات؛ عادة ما تُحذف النغمتان الرابعة والسابعة من السلم الدياتوني)",
 "よにいう": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "よにげや": "عَابِر, قَصِير العُمُر (زائل وقصير الأمد) / غَيْرُ مَوْثُوق, مَشْبُوه تِجَارِيًّا ((يوصف به الشركات وأصحابها) غير جدير بالثقة أو الاعتماد) / مدين هارب, نصاب (مدين يهرب لتجنب الدفع)",
 "よにでる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "よにも": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "よにゅう": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "よにん": "آخَرُون",
 "よにんぐみ": "رباعي, مجموعة رباعية (أربعة أشخاص يُنظر إليهم كوحدة واحدة) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)\nمثال: انضم إلى رباعي غنائي / عِصَابَة الْأَرْبَعَة",
 "よね": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "よねんせい": "فِي السَّنَةِ الرَّابِعَةِ (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الرَّابِعَةِ وَالأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "よねんなく": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "よねんもなく": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "よのう": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "よのおぼえ": "سُمْعَة, شُهْرَة",
 "よのつね": "عَادِيّ, مَأْلُوف",
 "よのなか": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "よのならい": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "よのめ": "فِي اَللَّيْلَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "よは": "أَعْقَاب",
 "よはい": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "よはく": "فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص",
 "よはくちゅう": "مُلَاحَظَة هَامِشِيَّة",
 "よばいびと": "خاطب, طالب الزواج (رجل يتودد لامرأة (بغرض الزواج))",
 "よばいぶみ": "رِسَالَةُ حُبٍّ",
 "よばいぼし": "شِهَاب",
 "よばる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "よばれる": "سُمِّيَ",
 "よばれるプログラム": "إجراء, دالة (تسلسل محدد من الخطوات، جزء من برنامج حاسوبي أكبر)",
 "よばわり": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "よばわる": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "よばん": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "よひと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "よひょう": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح) / إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً)",
 "よび": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / تَحْضِير, إِعْدَاد / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "よびあつめる": "اِجْتَمَعَ (ضد تَفَرَّقَ، كانوا جَمِيْع، أو كانوا مع بعض؛ الناس على كذا: ضدّ تَفَرَّقُوْا؛ كانوا على رأي واحد)\nمثال: اجتمع الناس في المتنزه.",
 "よびいれる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびうり": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "よびえきしょうこうくんれんかてい": "فيلق تدريب ضباط الاحتياط (برنامج تدريبي لإعداد طلاب الجامعات ليصبحوا ضباطًا مفوضين)",
 "よびおこす": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "よびかえす": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "よびかけ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "よびかける": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد. / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "よびきん": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "よびぐん": "قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي) / طامح, طامع (شاب طموح ومتطلع)\nمثال: طامح رفيع المستوى",
 "よびこ": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "よびこう": "مدرسة إعدادية, مدرسة تحضيرية (مدرسة ثانوية خاصة)",
 "よびこうさく": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "よびこみ": "كلب (مصطلحات غير رسمية للكلاب) / منادٍ (شخص يقف أمام عرض (كما في الكرنفال) ويلقي خطاب بيع صاخب وملون للزبائن المحتملين)",
 "よびこむ": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびごえ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "よびさます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / اِسْتَحْضَارَ, اِسْتَدَعَى",
 "よびざせき": "مقعد خلفي قابل للطي (مقعد خارجي قابل للطي في الجزء الخلفي من بعض السيارات القديمة)",
 "よびしけん": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "よびせん": "أَوَّلِيّ",
 "よびせんきょ": "أَوَّلِيّ",
 "よびそうち": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "よびだし": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته) / عَالِيّ الرُتْبَة",
 "よびだしおん": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "よびだしがわ": "طَازَج (طَازَج وَجَدِيد) / بَارِد عَلِيل, مُنْعِش ((عامّيّة اسكتلنديّة) يمنح البرودة والانتعاش) / زائر, ضيف (زائر اجتماعي أو للعمل) / متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "よびだしじかん": "وقت الوصول ((في علم الحاسوب) الفترة بين طلب البيانات من قبل النظام ووقت توفير البيانات بواسطة محرك الأقراص)\nمثال: وقت الوصول هو مجموع وقت البحث وكمون الدوران ووقت معالجة الأوامر",
 "よびだしじょう": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "よびだしふごう": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "よびだす": "استدعاء للخدمة, استنفار (أمر بالالتحاق بالواجب العسكري) / دَعَا (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびちしき": "خلفية, معلومات أساسية (معلومات ضرورية لفهم موقف أو مشكلة)\nمثال: أطلعته السفارة على خلفية الحادث",
 "よびつけ": "رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "よびつける": "دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "よびてき": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "よびとめる": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "よびどい": "كُوع, مِرْفَق / كُوعٌ",
 "よびな": "اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "よびね": "سعر اسمي (سعر تقديري قد يشبه أو لا يشبه سعر السوق للأصل)",
 "よびひ": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "よびひん": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "よびぶひん": "قِطْعَة غَيَار (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "よびへい": "جندي احتياط (عضو في قوات الاحتياط العسكرية)",
 "よびみず": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / حَمَاسِيّ, مُحَفِّز (يحثّ على النشاط أو يُصَعِّد الفعل كأنّه يَحْفِز ويَدْفَع) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: الهدف من الفن هو إثارة العواطف",
 "よびみずしきけいざいせいさく": "تحضير المضخة (إدخال الماء في المضخة لتحسين الختم وبدء تدفق المياه) / إنفاق بالعجز (إنفاق الأموال التي تم جمعها عن طريق الاقتراض؛ تستخدمه الحكومات لتحفيز اقتصادها)",
 "よびもどす": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "よびや": "مُرَوِّج",
 "よびょう": "تَعْقِيد / مُضَاعَفَة",
 "よびよせる": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "よびりん": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ) / اِتِّصَال\nمثال: ياني يرن الجرس.",
 "よふん": "مَحْبُوس, مَكْبُوت (يتسم بكبت الدوافع أو المشاعر أو يدل عليه)",
 "よぶ": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / يَسْتَحْضِر, يَسْتَدْعِي / دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "よぶこ": "صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "よぶん": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي / نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "よへい": "أثر باق, بقية (شيء نجا وبقي من الماضي) / الباقي في المنصب (مسؤول يبقى في منصبه بعد انتهاء ولايته)\nمثال: بقية من الستينيات",
 "よほう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / تَنَبَّأَ / تَوَقُّع",
 "よほど": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / تَقْرِيبًا, عَلَى وَشْك",
 "よぼう": "سبق الإصرار والترصّد (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / شَعْبِيَّة / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "よぼういがく": "طب وقائي (فرع الطب المعني بالوقاية من الأمراض)\nمثال: المؤسسة الطبية لا تربح من الطب الوقائي",
 "よぼういりょう": "طب وقائي (فرع الطب المعني بالوقاية من الأمراض)\nمثال: المؤسسة الطبية لا تربح من الطب الوقائي",
 "よぼうこうげき": "ضربة وقائية, هجوم وقائي (ضربة تُنفذ من أجل ردع عدوان متوقع من قبل قوات معادية)",
 "よぼうせっしゅ": "تَطْعِيم, تَلْقِيح (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "よぼうせん": "إجراء دفاعي, دفاع (عمل عسكري أو موارد تحمي دولة ضد أعداء محتملين)\nمثال: ماتوا في الدفاع عن ستالينغراد / احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / احتراز, وقاية (سمة ممارسة الحذر مسبقاً) / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "よぼうそち": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / احتراز, وقاية (سمة ممارسة الحذر مسبقاً) / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "よぼうちゅうしゃ": "تمنيع",
 "よぼうてき": "اِحْتِرَازِيّ / رَدْعِيّ / وِقَائِيّ",
 "よぼうやく": "اِحْتِرَازِيّ",
 "よぼよぼ": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "よまいごと": "قَرْقَرِيّ, هَدِير (صوت مستمر ممتلئ ومنخفض النبرة ونابض) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تذمر, قرقرة (ضجيج مستمر منخفض ومكتوم وعالٍ)\nمثال: سمعوا هدير الرعد",
 "よまわり": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "よみ": "قِرَاءَة",
 "よみあげ": "تِلَاوَة",
 "よみかえる": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "よみかた": "نُطْق, لَفْظ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / تَفْسِير",
 "よみがあまい": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "よみがえ": "قِيَامَة / سُورَةُ الْقِيَامَةِ",
 "よみがえり": "قِيَامَة / سُورَةُ الْقِيَامَةِ",
 "よみがな": "فُورِيغَانَا",
 "よみきかせ": "قِرَاءَة",
 "よみこなす": "هَضَمَ",
 "よみこみ": "قِرَاءَة",
 "よみこむ": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "よみじ": "هَادِيس",
 "よみする": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "よみだし": "قِرَاءَة",
 "よみだしせんようメモリ": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "よみだす": "استرجع",
 "よみちがい": "قراءة خاطئة (سوء تفسير ناتج عن قراءة غير دقيقة)",
 "よみちがえ": "قراءة خاطئة (سوء تفسير ناتج عن قراءة غير دقيقة)",
 "よみて": "قَارِئ, قَارِئَة / قَارِئ / مُلَحِّن / مُؤَلِّف مُوسِيقِيّ / كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "よみとく": "فَسَّرَ, أَوَّلَ / فَكَّ تَّعْمِيَة, فَكَّ مُعَمَّى",
 "よみとばす": "يَرْتَ",
 "よみとり": "قِرَاءَة",
 "よみとりかきこみきおくそうち": "كَبْش",
 "よみとりき": "قَارِئ, قَارِئَة / قَارِئ",
 "よみとりせんようきおくそうち": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "よみとりせんようメモリ": "ذاكرة القراءة فقط, روم ((في علم الحاسوب) ذاكرة يمكن الوصول إلى محتوياتها وقراءتها ولكن لا يمكن تغييرها)",
 "よみとる": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "よみながす": "يَرْتَ",
 "よみにくい": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "よみのくに": "هَادِيس",
 "よみびと": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "よみびとしらず": "مَجْهُول",
 "よみまちがえる": "أَسَاءَ الْفَهْم",
 "よみもの": "قراءة, مادة للقراءة (مادة مكتوبة مخصصة للقراءة)\nمثال: عيّن المعلم قراءات جديدة",
 "よみやすい": "مَقْرُوء",
 "よみやすさ": "قَابِلِيَّة التَّمْيِيز, مَقْرُوئِيَّة (التمايز الذي يجعل الإدراك سهلاً) / مَقْرُوئِيَّة, وُضُوح الخَطّ (صفة الكتابة (المطبوعة أو اليدوية) التي يمكن قراءتها بسهولة)",
 "よみ人しらず": "مَجْهُول",
 "よむ": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / تَنَبَّأَ / لَفَظَ (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى) / نَطَقَ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: هذه الكلمة صعبة اللفظ.",
 "よめ": "عَرُوس / كَنَّة, زَوْجَة اَلاِبْن / زَوْجَة, اِمْرَأَة / رُؤْيَة لَيْلِيَّة",
 "よめいり": "زَوَاج, نِكَاح / زَوَاج / عُرْس, زِفَاف",
 "よめいりどうぐ": "جِهَاز العَرُوس",
 "よめいりまえ": "أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "よめいる": "تَزَوَّجَ",
 "よめがきみ": "فَأْرَة, فَأْر",
 "よめご": "عَرُوس",
 "よめさん": "زَوْجَة, اِمْرَأَة",
 "よめし": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "よめしゅうとめ": "كَنَّة, زَوْجَة اَلاِبْن",
 "よめにいく": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "よめにゆく": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "よめはん": "زَوْجَة, اِمْرَأَة",
 "よめる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "よも": "هُنَا وَهُنَاكَ",
 "よもぎ": "حبق الراعي, شيح (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس)",
 "よもぎう": "أَرْض خَرَاب (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "よもぎがしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "よもぎぞく": "أرطماسيا, شيح (أي من الشجيرات أو الأعشاب المركبة المختلفة من جنس الشيح ذات أوراق خضراء أو رمادية عطرية)",
 "よもじご": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "よもすえ": "نِهَايَةُ الْعَالَم, الْقِيَامَة",
 "よもつくに": "هَادِيس",
 "よもや": "بِالتَّأْكِيد",
 "よやく": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد. / بَرْمَجَة (فِي : هي عملية كتابة تعليمات وتوجيه أوامر لجهاز الحَاسُوبِ أو أي جهاز آخر مثل قارئات أقراص الدي في دي أو أجهزة استقبال الصوت والصورة في نظم الاتصالات…؛ اسم لفظي للفعل بَرْمَجَ)\nمثال: تسمح لغة البرمجة بكتابة البرامج الحاسوبية.",
 "よやくうけつけ": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "よやくきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "よやくこうどく": "اِشْتِرَاك",
 "よやくしゃ": "وكيل حجز (شخص يتعاقد مع شخص أو شركة لتقديم عروض)",
 "よやくずみ": "مَحْجُوز",
 "よやくまちリスト": "قَائِمَة اَلْاِنْتِظَار",
 "よゆう": "فَائِض / اتزان, رباطة جأش (ثبات العقل تحت الضغط)\nمثال: تقبل مشاكلهم برباطة جأش وهي باتزان",
 "よゆうのよっちゃん": "عَفْوًا",
 "よら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "より": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَدَلًا مِن / أَكْثَر مِن, عَنّ / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا. / لَوَى, بَرَمَ / اِخْتَارَ",
 "よりあい": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "よりあう": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "よりあわせる": "اِنْضَفَرَ, تَدَاخَلَ",
 "よりいい": "أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "よりいっそう": "زائد, متزايد (أصبح أكبر في الحجم أو الكمية أو الدرجة)",
 "よりいと": "برم, دوران سريع (عملية الدوران بسرعة) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: أدار الكرنك بقوة",
 "よりうえ": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "よりか": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَدَلًا مِن / أَكْثَر مِن, عَنّ / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "よりき": "رَقِيب شُرْطَة (رجل قانون برتبة رقيب)",
 "よりくず": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "よりしほう": "إِيدُو",
 "よりせん": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "よりだす": "اِخْتَارَ",
 "よりつき": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "よりつく": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "よりて": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "よりどころ": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "よりぬき": "نُخْبَة\nمثال: あの科学者たちは選り抜きだ。 — هؤلاء العلماء هم صفوة الصفوة.",
 "よりぬく": "اِخْتَارَ",
 "よりめ": "حول إنسي, حول داخلي (حول تتجه فيه إحدى العينين أو كلتيهما إلى الداخل نحو الأنف)",
 "よりも": "مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / بَدَلًا مِن / أَكْثَر مِن, عَنّ / مُنْتَهٍ, هَالِك (محكوم عليه بالفناء والزوال)",
 "よりよい": "أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "よりよほう": "إِيدُو",
 "よりより": "أَحْيَانًا, سَاعَات",
 "よりわける": "صَنَّفَ, قَسَّمَ",
 "より一層": "زائد, متزايد (أصبح أكبر في الحجم أو الكمية أو الدرجة)",
 "より上": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "より分ける": "صَنَّفَ, قَسَّمَ",
 "より合わせる": "اِنْضَفَرَ, تَدَاخَلَ",
 "より抜き": "نُخْبَة\nمثال: あの科学者たちは選り抜きだ。 — هؤلاء العلماء هم صفوة الصفوة.",
 "より糸": "برم, دوران سريع (عملية الدوران بسرعة) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: أدار الكرنك بقوة",
 "より線": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "より良い": "أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "よる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة. / عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟ / اِخْتَارَ / لَوَى, بَرَمَ",
 "よるがお": "أثمان أبيض, زهرة القمر (متسلق استوائي شامل له زهور ليلية بيضاء عطرة)",
 "よるがた": "لَيْلِيّ\nمثال: 僕は夜型なんだ。 — أنا رجل سهر.",
 "よるがたにんげん": "بومة الليل, ساهر (شخص يحب أن يكون نشطاً في وقت متأخر من الليل)",
 "よるごはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "よるのいとなみ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "よるのおんな": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "よるのじょおう": "سيلينسيريوس, ملكة الليل (صبار متسلق أمريكي استوائي له فروع مثلثة؛ يزرع غالباً لزهوره الكبيرة البارزة التي تتفتح ليلاً تليها ثمار صفراء مخططة بالأحمر)",
 "よるのちょう": "مُضِيفَة",
 "よるひる": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "よるよう": "بَيْنَ لَيْلةٍ وَضُحاهَا (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "よれ": "جَعْدَة / تَجَعُّد, جَعْدَة",
 "よれい": "جرس الإنذار, ناقوس الخطر (جرس يستخدم لإطلاق إنذار) / مَأْمُول اَلْحَيَاة, مُتَوَسِّط العُمْر المُتَوَقَّع",
 "よれき": "مَعْرُوف / أَنْعَمَ",
 "よれば": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "よれよれ": "بَالٍ",
 "よろ": "مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よろい": "دِرْع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "よろいねずみ": "مُدَرَّع",
 "よろいまど": "نافذة شيش (نافذة ذات ريش زجاجية)",
 "よろう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "よろく": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "よろける": "تَرَنُّح / تَرَنَّحَ",
 "よろこばしい": "سَعِيد, مُفْرِح",
 "よろこばす": "فُرْجَة",
 "よろこび": "سُرُور, فَرَح (شُعُور حَسَن يتبع الرضا، والارتياح)\nمثال: قبل زيري بسرور.",
 "よろこびごと": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "よろこぶ": "أَفْرَحَ / هَنَّأَ, يُهَنِّئُ / أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "よろこんで": "بِرَغْبَة, بِمَتْعَة",
 "よろしい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "よろしおす": "حَسَّن, لَطِيف (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "よろしく": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "よろしくおつきあいください": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしくおねがいいたします": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしくおねがいします": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしくお付き合いください": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしくお付き合い下さい": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしくお願いいたします": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしくお願いします": "سَاعِدُونِي, سَاعِدْنِي",
 "よろしゅう": "مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よろず": "عَشَرَة آلَاف / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل / كُلّ شَيْء / مُخْتَلِف, مُتَنَوَّع",
 "よろずとせ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "よろずや": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "よろずよ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "よろず屋": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "よろつく": "تَرَنُّح / تَرَنَّحَ",
 "よろぴく": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よろよろ": "آيِل لِلسُّقُوط, مُتَدَاعٍ ((للهياكل أو المؤسسات) فقد استقراره؛ يتهاوى أو على وشك الانهيار) / مُتَخَاذِل, مُتَهَالِك (غير ثابت في مشيته بسبب الوهن أو الشيخوخة)",
 "よろん": "رَأْي عَامّ / رأي عارض, ملاحظة قضائية عارضة (رأي يبديه قاضٍ حول نقطة قانونية لا تؤثر بشكل مباشر على القضية المعنية وبالتالي ليست ملزمة) / رأي عارض, ملاحظة عابرة (ملاحظة عرضية)",
 "よろんちょうさ": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "よろピク": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "よわ": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة. / لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة.",
 "よわい": "ضَعِيف / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "よわいする": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "よわいそうごさよう": "تفاعل ضعيف, قوة نووية ضعيفة ((في الفيزياء) تفاعل بين الجسيمات الأولية ينطوي على نيوترينوات أو مضادات النيوترينو وهو المسؤول عن أنواع معينة من التحلل الإشعاعي؛ يتوسطه بوزونات…)",
 "よわいちから": "تفاعل ضعيف, قوة نووية ضعيفة ((في الفيزياء) تفاعل بين الجسيمات الأولية ينطوي على نيوترينوات أو مضادات النيوترينو وهو المسؤول عن أنواع معينة من التحلل الإشعاعي؛ يتوسطه بوزونات…)",
 "よわいもの": "ضَعِيف",
 "よわいものいじめ": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا) / تَنَمُّر (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)\nمثال: الإنفصاليون مثل الإرهاب.",
 "よわいをかさねる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "よわき": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان. / هُبُوطِيّ (يتوقع انخفاضاً في الأسعار)",
 "よわきいちば": "سوق هابطة (سوق يتميز بانخفاض أسعار الأوراق المالية)",
 "よわきそうば": "سوق هابطة (سوق يتميز بانخفاض أسعار الأوراق المالية)",
 "よわきもの": "ضَعِيف",
 "よわごしがいこう": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "よわさ": "ضَعْف",
 "よわす": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "よわせる": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "よわたり": "كَفَاف",
 "よわたりじょうず": "عَالَمِيّ, كَوْنِيّ (ذو نطاق أو تطبيق عالميّ شامل) / عالمي, كوزموبوليتاني (مكون من أشخاص من أجزاء كثيرة من العالم أو يألفون العيش فيها؛ خاصة من ليس لديهم مواقف أو اهتمامات إقليمية ضيقة) / عالمي الانتشار, كوزموبوليتاني (ينمو أو يحدث في أجزاء كثيرة من العالم) / عالمي, كوزموبوليتاني (شخص متطور سافر في العديد من البلدان)\nمثال: امتد إحسانه العالمي بنزاهة إلى جميع الأعراق وجميع المعتقدات",
 "よわっちぃ": "ضَعِيف",
 "よわっちい": "ضَعِيف",
 "よわね": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "よわねをはく": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "よわび": "سلق, غلي (الطهي في سائل تم غليه)",
 "よわふくみしきょう": "سوق المشترين (سوق يكون فيه عدد الأشخاص الذين يريدون البيع أكثر ممن يريدون الشراء)",
 "よわまり": "تَقْلِيل, إِنْقَاص",
 "よわまる": "ضَعُفّ / أْضْعَفّ",
 "よわみ": "ضَعْف",
 "よわみそ": "ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "よわむし": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "よわよわしい": "ضَعِيف",
 "よわりおとろえる": "فَتَرَ, ضَعُفَ / قَبَعَ / أُهْمِلَ",
 "よわる": "انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "よをさる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "よをひについで": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "よをわたる": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "よん": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "よんかいせい": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "よんきょう": "متأهل لنصف النهائي (واحد من أربعة منافسين متبقين في بطولة بنظام الإقصاء)",
 "よんぎょうれん": "رُبَاعِيّ",
 "よんく": "اَلدَّفْع اَلرَّبَاعِيّ",
 "よんさい": "بِعُمُر أَرْبَع سَنَوَات (في عامه الرابع من العمر)",
 "よんじゅう": "أَرْبَعُونَ",
 "よんじゅうく": "أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)",
 "よんじゅうだい": "أَرْبَعُونَ (يَدُلُّ عَلَى العَدَد 40) / أَرْبَعُون (العدد الأصلي الذي هو حاصل ضرب عشرة في أربعة)",
 "よんじゅうねんだい": "الأربعينات (الفترة من العمر بين 40 و 50) / الأربعينات (1940), عقد 1940 (العقد من 1940 إلى 1949)",
 "よんせい": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "よんせん": "أَرْبَعَة آلَاف (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "よんそく": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / رباعي الأرجل (حيوان خاصة الثدييات له أربعة أطراف متخصصة للمشي)",
 "よんたんとう": "تتروز, سكر رباعي (أي سكر أحادي يحتوي على أربع ذرات كربون في الجزيء)",
 "よんだいたいかい": "الدوري الرئيسي, الدوري الممتاز (أهم دوري في أي رياضة (خاصة البيسبول))",
 "よんでじのごとく": "حَرْفِيًّا / بِٱلْحَرْف",
 "よんとう": "سكر رباعي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج أربعة جزيئات من السكر الأحادي عند التحلل المائي الكامل)",
 "よんど": "أربعة أضعاف (بمقدار أربعة أضعاف)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "よんどころない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "よんばい": "أربعة أضعاف (بمقدار أربعة أضعاف)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "よんひゃく": "أَرْبَعُمِئَة (يَدُلُّ عَلَى العَدَد 400)",
 "よんびょうし": "زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "よんぶさく": "رُبَاعِيَّة",
 "よんほん": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "よんもじことば": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "よんもじご": "كلمة نابية, لفظ فاحش (أي من عدة كلمات قصيرة (غالباً ما تكون من 4 أحرف في الإنجليزية) تُعتبر عموماً بذيئة أو مسيئة)",
 "よんやよんや": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "よんりん": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "よんりんくどう": "اَلدَّفْع اَلرَّبَاعِيّ",
 "よんりんしゃ": "سَيَّارَة, أُوتُومُوبِيل (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "よんわおん": "أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "よんダブリューディー": "اَلدَّفْع اَلرَّبَاعِيّ",
 "よー": "بشكل جميل, بلطف (بطريقة لطيفة)\nمثال: منزل مطلي بشكل جميل / غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ / يَاه, اسمع / هَلَا",
 "よーいどん": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "よーいドン": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "よーし": "بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / تمام, حسناً (تعبير عن الموافقة يحدث عادة في بداية الجملة) / بالتأكيد, بلا شك (بدون شك (تستخدم لتعزيز تأكيد)) / مَقْبُول ((استخدام غير معياريّ) مُرْضٍ)\nمثال: ستبلي حسناً بمفردها",
 "よーそろー": "مَفْهُوم",
 "ら": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / لَاتِينِيّ, الرُّومِيَّة (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية) / لَاتِينِيّ, الرُّومِيّ (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية)\nمثال: العديد من الكلمات الإنجليزية أصلها لاتيني. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "らあめん": "رَامِن, رَامَن",
 "らい": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / مُنْذُ / لِأَنَّ / جذام, مرض هانسن (مرض حبيبي مزمن وسار يحدث في المناطق الاستوائية وشبه الاستوائية؛ يتميز بعقيدات ملتهبة تحت الجلد وهزال أجزاء الجسم؛ تسببه عصيات المتفطرة الجذامية) / رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "らいう": "عَاصِفَة رَعْدِيَّة",
