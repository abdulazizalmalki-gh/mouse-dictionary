 "よこづなけいこ": "تدريب, تمرين (تدريب منهجي بتكرارات متعددة)\nمثال: الممارسة تؤدي إلى الإتقان",
 "よこて": "جَانِب",
 "よこで": "جَانِب",
 "よこどり": "إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "よこなが": "مُسْتَطِيل (مُنْحَرِف عَن شَكْل المُرَبَّع أَوْ الدَّائِرَة بِاسْتِطالَتِه في اتِّجاه واحِد)",
 "よこなぐり": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)",
 "よこに": "أفقياً (في اتجاه أفقي)\nمثال: غالباً ما يتم إضافة معرض للاستفادة من المساحة رأسياً وأفقياً / عَبْرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "よこになる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "よこにらみ": "وَهَج",
 "よこね": "دبل (عقدة لمفاوية ملتهبة ومتورمة بسبب الطاعون أو السيلان أو السل)",
 "よこはば": "اتساع, عَرْض (مدى الشيء من جانب إلى آخر)\nمثال: يجب أن يكون لدى المعلم شمولية في المعرفة بالمادة",
 "よこはま": "يُوكُوهَامَا\nمثال: 私の妹は横浜の近くに住んでいる。 — تعيش أختي قرب يوكوهاما.",
 "よこばい": "نطاط الأوراق (حشرة صغيرة قافزة تمتص عصارة النباتات) / أفعى جانبية الحركة, أفعى مقرنة / مُثَبِّت, مُسْتَقِرّ (يُؤَدِّي إلى الاسْتِقْرار والثَّبات)",
 "よこばいガラガラへび": "أفعى جانبية الحركة, أفعى مقرنة",
 "よこばら": "جَانِب",
 "よこばり": "جائز مستعرض, عارضة مستعرضة (عارضة أفقية تمتد عبر شيء ما)",
 "よこぶえ": "ناي, ناي مستعرض (آلة نفخ خشبية عالية النبرة؛ أنبوب رفيع مغلق من أحد طرفيه بفتحات للأصابع في أحد…)",
 "よこぶとり": "قَصِير وَبَدِين, مُكَتَّل (قَصِير القَامَة وَمُمْتَلِئ الجِسْم)",
 "よこぼう": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "よこぼり": "خَنْدَق",
 "よこみち": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف)) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "よこめん": "جَانِب",
 "よこもじ": "خط روماني (نمط خط استخدم في النقوش الرومانية القديمة)",
 "よこもち": "وَسِيلَةُ النَّقْل",
 "よこやり": "مُقَاطَعَة",
 "よこやりをいれる": "قَاطَعَ",
 "よこゆれ": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات)\nمثال: اتُهم بسلب السكارى في الحديقة",
 "よこをむく": "غضّ النظر, غضّ الطرف",
 "よこパス": "تمريرة عرضية (تمريرة إلى مستقبل في الملعب بعيدًا عن الممرر)",
 "よこピース": "علامة النصر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)",
 "よこ糸": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "よご": "تنبؤ بسير المرض, مآل المرض (التنبؤ بمسار المرض) / تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة)",
 "よござんした": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها…)\nمثال: ألقى زيري تحية.",
 "よござんす": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها…)\nمثال: ألقى زيري تحية.",
 "よごし": "تلويث, توسيخ (فعل توسيخ شيء ما) / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل.",
 "よごす": "تُرْبَة, أَرْض\nمثال: その本を汚さないように扱ってくれるなら、貸してあげるよ。 — يمكنك استعارة هذا الكتاب بشرط أن تبقيه نظيفاً. / عَار, خِزْي",
 "よごと": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "よごはんてい": "تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي))\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "よごれ": "تُرْبَة, تُرَاب / قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار…)",
 "よごれざめ": "قرش أبيض الطرف, قرش محيطي أبيض الطرف (قرش كبير يعيش في المياه العميقة ذو زعنفة ظهرية بيضاء الطرف؛ واسع الانتشار…)",
 "よごれたかね": "سلب, غنيمة (بضائع أو أموال تم الحصول عليها بشكل غير قانوني)",
 "よさ": "جَدَارَة",
 "よさん": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ))\nمثال: زاد الحضور بنسبة 50 في المائة",
 "よさんか": "مِيزَانِيَّة, مُوَازَنَة",
 "よさんさくげん": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "よさんじょう": "مالي, ميزاني (من أو يتعلق بالميزانية)\nمثال: اعتبارات الميزانية",
 "よさんぶそく": "عجز الميزانية (زيادة النفقات على الإيرادات)",
 "よさんカット": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "よざけ": "المباراة الختامية (المباراة الأخيرة في سلسلة من مباراتين متتاليتين)",
 "よし": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش…) / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية)\nمثال: ستبلي حسناً بمفردها",
 "よしあし": "نَوْعِيَّة, جَوْدَة",
 "よしありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "よしきた": "جَيِّد (بَيِّن الجَوْدَة)",
 "よしきりざめ": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض…)",
 "よしとする": "قِيمَة",
 "よしなき": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "よしなしごと": "هُرَاء, لَغْو",
 "よしなし事": "هُرَاء, لَغْو",
 "よしなに": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "よしび": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "よしぶえ": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "よしみ": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "よしもとそうごうげいのうがくいん": "مجلس الأمن القومي (لجنة في الفرع التنفيذي للحكومة تقدم المشورة للرئيس بشأن الشؤون الخارجية…)",
 "よしゅうごう": "عُمْدَة",
 "よしょく": "لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو…)\nمثال: الأصفر والأزرق لونان مكملان",
 "よしよし": "جَيِّد (بَيِّن الجَوْدَة) / تلميس, مسح (لمسة خفيفة باليدين)",
 "よしり": "صلصة السمك, صوص السمك",
 "よしる": "صلصة السمك, صوص السمك",
 "よしわるし": "نَوْعِيَّة, جَوْدَة",
 "よしん": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار) / هَزّةٌ اِرْتِدادِيَّةٌ, تَوابِعُ / اِئْتِمَان / سِيرَة مَرْضِيَة",
 "よしんば": "بِالرَغْم مِن",
 "よじ": "اَلسَّاعَة اَلرَّابِعَة / رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة.",
 "よじげん": "البعد الرابع, الزمن (الإحداثي الرابع المطلوب (إلى جانب الأبعاد المكانية الثلاثة) لتحديد حدث فيزيائي)",
 "よじげんちょうりっぽうたい": "تسراكت, مكعب فائق (النظير رباعي الأبعاد للمكعب)",
 "よじのぼる": "تَسَلَّقَ",
 "よじょう": "فَائِض / إِيحَائِيَّة (حالة أو صفة الامتلاء بالإيحاءات وتحفيز الفكر)",
 "よじる": "لَوَى, بَرَمَ",
 "よじん": "أثر لاحق (أي نتيجة تتبع سببها بعد فترة زمنية)\nمثال: كان للدواء آثار تالية غير متوقعة / جَمْرَة / آخَرُون",
 "よじ登る": "تَسَلَّقَ",
 "よす": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / تضمن",
 "よすいはき": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "よすいろ": "مجرى الفائض, مفيض (قناة تحمل المياه الزائدة فوق السد أو حوله أو حول أي عائق آخر)",
 "よすう": "بَقِيَّة / عُمْدَة",
 "よすが": "مُسَاعَدَة / نِسْبِيّ / منبه للذاكرة, مُذكّر (تجربة تجعلك تتذكر شيئاً ما)\nمثال: تجاهل تذكيرات زوجته",
 "よすぎ": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "よすてびと": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "よせ": "نهاية اللعبة (المراحل النهائية من لعبة الشطرنج بعد إزالة معظم القطع من الرقعة)\nمثال: المرحلة النهائية الدبلوماسية / جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع / قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "よせあつめ": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "よせあつめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "よせい": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "よせえ": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "よせぎ": "أرضية خشبية مزخرفة, باركية (تطعيم خشبي منقوش يستخدم لتغطية الأرضية)",
 "よせぎざいく": "أرضية خشبية مزخرفة, باركية (تطعيم خشبي منقوش يستخدم لتغطية الأرضية)",
 "よせぎれ": "باتشوورك, ترقيع (خياطة تتكون من قطع من مواد مختلفة مخيطة معاً في نمط)",
 "よせざん": "إضَافَة\nمثال: جمع خيل هو خيول.",
 "よせせき": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "よせつ": "ظِلّ اَلتَّمَام (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا. / تَعْلِيق",
 "よせなみ": "تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ)",
 "よせば": "مكان تجمع, ملتقى (مكان مفضل يجتمع فيه الناس) / مُعَسْكَر عَمَل, مُعَسْكَر أَشْغَال / قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "よせむね": "سقف مائل الجوانب, سقف هرمي (سقف له نهايات مائلة بالإضافة إلى جوانب مائلة)",
 "よせむねづくり": "سقف مائل الجوانب, سقف هرمي (سقف له نهايات مائلة بالإضافة إلى جوانب مائلة)",
 "よせむねやね": "سقف مائل الجوانب, سقف هرمي (سقف له نهايات مائلة بالإضافة إلى جوانب مائلة)",
 "よせもの": "بُودِنْغ",
 "よせよ": "لِوَجْهِ اللّٰهِ, مِنْ أَجْلِ اللّٰهِ",
 "よせる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / نَقَلَ / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / تضمن",
 "よせん": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة)\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "よせんかい": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ)\nمثال: التدريب مقدمة ضرورية للتوظيف / تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "よせんつうか": "مُؤَهِّل",
 "よせんつうかしゃ": "مُقَيِّدٌ",
 "よせ集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "よそ": "خَارِج, بره / تَجَاهَلَ, طَنَّش / أَرْبَعُونَ",
 "よそいき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "よそう": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "よそういじょう": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "よそうがい": "مُفَاجِئ",
 "よそうだか": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء"
}
