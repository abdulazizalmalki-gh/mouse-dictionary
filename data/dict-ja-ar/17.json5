 "めまぐるしい": "دَائِخ",
 "めまぜ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة)",
 "めまつ": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "めみえ": "مُقَابَلَة / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "めめしい": "مُخَنَّث",
 "めもあや": "باهِر",
 "めもくれず": "بلامبالاة (مع اللامبالاة؛ بطريقة غير مبالية)\nمثال: هزت كتفيها بلامبالاة",
 "めもくれない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "めもと": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "めもり": "تَخَرُّج",
 "めやす": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار) / تَقْرِيب",
 "めやに": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "めりこむ": "غَطَسَ",
 "めりはり": "تحوير / تَرَاوُح, اِخْتِلَاف / حيوية, نشاط (النشاط والحركة العامة)\nمثال: كانت مسرحية ثقيلة وحاول الممثلون عبثاً بث الحياة فيها",
 "めりはりのきいた": "دَجِر",
 "めりめり": "تصدع, شرخ (عملية إحداث شقوق في شيء ما)\nمثال: طرقعة سوط",
 "めり込む": "غَطَسَ",
 "めろう": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "めろめろ": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "めをうばう": "فَتَنَ",
 "めをかける": "اِهْتَمَّ, اِعْتَنَى",
 "めをくらます": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "めをさます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "めをそむける": "غضّ النظر, غضّ الطرف / إِهْمال / هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "めをそらす": "غضّ النظر, غضّ الطرف",
 "めをだす": "نَبْتَة",
 "めをつぶる": "أَغْمَضَ العَيْنَيَنِ عَنْ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "めをつむる": "أَغْمَضَ العَيْنَيَنِ عَنْ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "めをとおす": "مَسَحَ ضَوْئِيًّا (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "めをとじる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "めをとめる": "أَعَارَ اِنْتِبَاه",
 "めをはしらせる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)…)\nمثال: نظر إلى السماء.",
 "めをひらく": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "めをふく": "بُرْعُم",
 "めをほそくする": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب)",
 "めをほそめる": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب)",
 "めをまわす": "إِغْمَاء / مَذْهُول / أَدَارَ عَيْنَيْهِ, بَرَمَ عَيْنَيْهِ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "めをみる": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "めをやる": "بَدَا (ظَهَرَ)",
 "めん": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في…) / إِقَالَة / قُطْن, قُطُن / نُودَلْز, شَعْرِيَّة / طَحِين, دَقِيق / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / صَفْحَة, صفحة / مِيَانْمَار, بُورْمَا",
 "めんう": "زُغَيْبَة (ريش زغبي للطيور الصغيرة؛ يبقى في بعض الطيور البالغة)",
 "めんえき": "حَصَانَة, مَنَاعَة",
 "めんえきおうとう": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو…)",
 "めんえきおうとういでんし": "استجابة مناعية, رد فعل مناعي (رد فعل دفاعي جسدي يتعرف على مادة غازية (مولد ضد: مثل فيروس أو فطر أو بكتيريا أو…)",
 "めんえきがく": "علم المناعة (فرع العلوم الطبية الذي يدرس الجهاز المناعي للجسم)",
 "めんえきがくしゃ": "عالم مناعة (عالم طبي يتخصص في علم المناعة)",
 "めんえききこう": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "めんえきけい": "جِهَاز المَنَاعَة, الْجِهَاز المَنَاعِيّ",
 "めんえきげん": "عامل تحصين, مولد المناعة (أي مادة أو كائن حي يثير استجابة مناعية (ينتج مناعة) عند إدخاله في الجسم)",
 "めんえきげんせい": "استمناع, مولدية للمناعة (خاصية إثارة استجابة مناعية)",
 "めんえきせい": "حَصَانَة, مَنَاعَة",
 "めんえきたい": "جِسْم مُضَادّ (شيء مادي؛ جسد الإنسان أو الحيوان)\nمثال: الحليب مفيد للجسم.",
 "めんえきふぜん": "عوز مناعي, نقص المناعة (اضطراب مناعي يكون فيه جزء من الجهاز المناعي للجسم غير كافٍ وتنخفض المقاومة…)",
 "めんえきよくせいざい": "دواء مثبط للمناعة, مثبط للمناعة (دواء يقلل من الاستجابة المناعية الطبيعية للجسم)",
