 "よこうえんしゅう": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "よこうれんしゅう": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "よこおよぎ": "سباحة جانبية (طريقة سباحة تتحرك فيها الذراعان للأمام والخلف بينما تقوم الساقان بركلة المقص)",
 "よこかぜ": "رياح جانبية (رياح تهب عبر مسار سفينة أو طائرة)",
 "よこがお": "حُدُود خَارِجِيَّة",
 "よこき": "عارضة, قطعة عرضية (دعامة مستعرضة)",
 "よこぎ": "عارضة, قطعة عرضية (دعامة مستعرضة)",
 "よこぎる": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "よこく": "لَاحَظَ / مَقْطُورَة / حَلِيف, حَلِيفَة",
 "よこくし": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في…)",
 "よこくへん": "مَقْطُورَة",
 "よこぐし": "تكامل أفقي (الاستيعاب في شركة واحدة لعدة شركات تعمل في نفس مستوى الإنتاج وتشارك الموارد في…)",
 "よこぐるま": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "よここう": "مدخل أفقي للمجم, نفق أفقي (ممر أفقي تقريباً من السطح إلى داخل المنجم)",
 "よこさま": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته",
 "よこざい": "عارضة, قطعة عرضية (دعامة مستعرضة)",
 "よこざひょう": "إِحْدَاثِيّ سِينِيّ, الإحداثي الأفقي (قيمة الإحداثي على المحور الأفقي)",
 "よこざま": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته",
 "よこざん": "عقلة, قضيب أفقي (جهاز جمباز يتكون من قضيب مثبت في وضع أفقي بواسطة قائمين عند كلا الطرفين)",
 "よこし": "طِحَال",
 "よこしま": "شِرِير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "よこじく": "إِحْدَاثِيّ سِينِيّ, الإحداثي الأفقي (قيمة الإحداثي على المحور الأفقي)",
 "よこす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "よこすじ": "عَرْضِيّ, مُسْتَعْرِض (يَمْتَدّ أَوْ يَقَع بِالعَرْض؛ في اتِّجاه عَمودِيّ عَلى المِحْوَر)",
 "よこすじジャッカル": "ابن آوى مخطط الجانب (ابن آوى موطنه جنوب أفريقيا ذو شريط أسفل جانبه)",
 "よこすべり": "انزلاق جانبي (مناورة طيران؛ تنزلق الطائرة جانبياً في الهواء)",
 "よこずれだんそう": "صدع انزلاقي الاتجاه (صدع جيولوجي يبدو فيه أن أحد السطحين المتجاورين قد تحرك أفقياً)",
 "よこせいさく": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة)",
 "よこたわる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "よこだき": "مَهْد",
 "よこちょ": "بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه)\nمثال: عيون ترمق بطرف العين من وجه ذابل",
 "よこちょう": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "よこっちょ": "بشكل جانبي, بطرف العين (إلى جانب واحد أو باتجاهه)\nمثال: عيون ترمق بطرف العين من وجه ذابل",
 "よこっつら": "جَانِب",
