 "背の高さ": "اِرْتِفَاع",
 "背びれ": "زعنفة ظهرية (زعنفة وسطية غير مقترنة على ظهور الأسماك وبعض الفقاريات المائية الأخرى تساعد في الحفاظ على التوازن)",
 "背もたれ": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "背丁": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "背丈": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "背中": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "背中で語る": "التزم بوعودك",
 "背中の痛み": "ألم الظهر (وجع موضعي في الظهر)",
 "背中合わせ": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع) / وَجْهَانِ لِعُمْلَةٍ وَاحِدَةٍ",
 "背乗り": "سرقة الهوية (الاستيلاء على المعلومات الشخصية لشخص آخر (مثل الاسم، رقم الضمان الاجتماعي، رقم بطاقة الائتمان، جواز السفر) دون علم ذلك الشخص والاستخدام الاحتيالي…)",
 "背任": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "背任罪": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "背信": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة (صفة مساعدة العدو)",
 "背信者": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "背信行為": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "背側": "ظَهْرِيّ",
 "背反": "مُثِير لِلاشْمِئْزَاز, مُقْرِف (بالغ الكراهة؛ يثير النفور والاشمئزاز) / تَنَاقُضٌ",
 "背反行為": "اِنْتِهَاك",
 "背嚢": "حقيبة ظهر, حقيبة محمولة على الظهر (حقيبة تُحمل بحزام على الظهر أو الكتف)",
 "背子": "حَبِيب, حَبِيبَة / رَفِيق, رَفِيقَة",
 "背屈": "ثني ظهري (عملية الثني للخلف (للجسم أو لجزء من الجسم))",
 "背広組": "مُوَظَّف, مُوَظَّفَة",
 "背後": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / خلفية",
 "背後関係": "خلفية",
 "背後霊": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "背徳": "فَسَاد",
 "背徳的": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "背戸": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "背戻": "عَصَى",
 "背教": "رِدَّة, اِرْتِدَاد",
 "背教者": "مُرْتَدّ",
 "背景": "خلفية / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "背景幕": "خلفية المسرح, ستارة خلفية (مناظر معلقة في الجزء الخلفي من المسرح)",
 "背景放射": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "背景説明": "إحاطة إعلامية (مؤتمر صحفي أو مقابلة يشرح فيه مسؤول حكومي للمراسلين خلفية إجراء أو سياسة ما)\nمثال: أعطانا الوزير إحاطة عن قضايا الصحة العامة",
 "背板": "لوح إسناد, لوح ظهر (لوح يستخدم لدعم ظهر شخص أو شيء ما) / لوحة السلة (لوحة رأسية مرتفعة مثبت بها سلة؛ تستخدم للعب كرة السلة)\nمثال: ارتدت الكرة من اللوحة",
 "背格好": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "背水": "مكان معزول, منطقة راكدة (مكان أو حالة لا يحدث فيها أي تطور أو تقدم) / مسطح مائي راكد, مياه راكدة (مسطح مائي نشأ عن فيضان أو مد أو بسبب حجزه بواسطة سد)\nمثال: البلد في حالة ركود اقتصادي",
 "背水の陣": "كَمَلْجَأ أَخِير (يُفعل كملاذ أخير خاصة لمنع أزمة أو كارثة)",
 "背泳": "سباحة الظهر (طريقة سباحة تشبه الزحف (السباحة الحرة) إلا أن السباح يستلقي على ظهره)",
 "背泳ぎ": "سباحة الظهر (طريقة سباحة تشبه الزحف (السباحة الحرة) إلا أن السباح يستلقي على ظهره)",
 "背点": "نقيض الأوج الشمسي (النقطة المعاكسة في الاتجاه للأوج الشمسي؛ النقطة التي يبتعد عنها النظام الشمسي)",
 "背理": "سَخَافَة",
 "背理法": "الإثبات بالخلف, برهان الخلف (دحض عن طريق إظهار أن عواقب الاقتراح سخيفة؛ أو إثبات اقتراح عن طريق إظهار أن نفيها يؤدي إلى تناقض)",
 "背甲": "دِرْع, صَدَفَة (غطاء خارجي صلب لبعض الكائنات الحية مثل المفصليات والسلاحف) / خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "背痛": "ألم الظهر (وجع موضعي في الظهر)",
 "背筋": "عَمُود فَقْرِيّ",
 "背虫": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري) / كُسَاح",
 "背表紙": "عَمُود فَقْرِيّ",
 "背負い革": "مِقْلَاع / حَمَّالَة",
 "背部": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "背離": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)",
 "背面": "خَلْفِيّ",
 "背面跳び": "قفزة فوسبري (القفز فوق العارضة للخلف والرأس أولاً)",
 "背馳": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "背骨": "عَمُود فَقْرِيّ",
 "背高": "طول القامة (خاصية كونه أطول من متوسط القامة) / ارتفاع, طُول (البعد الرأسي للامتداد؛ المسافة من قاعدة الشيء إلى قمته)",
 "背高鴫": "أبو مغازل أسود الجناح (أبو مغازل من أوروبا وأفريقيا وآسيا ذو ريش أبيض في الغالب ولكن بأجنحة سوداء) / كُرْسُوع, أَبُو الْمَغَازِل",
 "背高鷸": "أبو مغازل أسود الجناح (أبو مغازل من أوروبا وأفريقيا وآسيا ذو ريش أبيض في الغالب ولكن بأجنحة سوداء) / كُرْسُوع, أَبُو الْمَغَازِل",
 "背鰭": "زعنفة ظهرية (زعنفة وسطية غير مقترنة على ظهور الأسماك وبعض الفقاريات المائية الأخرى تساعد في الحفاظ على التوازن)",
 "背黒ジャッカル": "ابن آوى أسود الظهر (ابن آوى موطنه أفريقيا ذو ظهر أسود)",
 "背黒海蛇": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "背黒鴎": "نورس الرنجة (نورس كبير يعيش في نصف الكرة الشمالي)",
 "胎": "رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه.",
 "胎位": "إِرَاءَة / إِهْدَاء, مَنْح",
 "胎便": "عقي",
 "胎便吸引症候群": "مَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "胎児": "جَنِين",
 "胎児仮死": "ضائقة جنينية (حالة غير طبيعية للجنين؛ تكتشف عادة أثناء الحمل وتتميز بضربات قلب غير طبيعية)",
 "胎児性がん": "سرطانة جنينية (ورم خبيث في الخصية)",
 "胎児性アルコール症候群": "متلازمة الكحول الجنينية (حالة طبية خلقية يحدث فيها تشوه في الجسم أو ضعف في تطور الوجه أو القدرة العقلية لأن الأم كانت تشرب الكحول أثناء الحمل)",
 "胎児性癌": "سرطانة جنينية (ورم خبيث في الخصية)",
 "胎動": "حركة الجنين (حركة الجنين داخل الرحم (تُكتشف عادة بحلول الأسبوع السادس عشر من الحمل)) / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "胎座": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "胎生": "ولود (ينتج صغارًا أحياء (وليس بيضًا))",
 "胎生学": "علم الأجنة (فرع علم الأحياء الذي يدرس تكوين وتطور الكائنات الحية في مراحلها المبكرة)",
 "胎生学者": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "胎盤": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "胎盤形成": "توضع المشيمي, وضع المشيمة (ترتيب البويضات في المشيمة وترتيب المشيمات في المبيض) / تشكل المشيمة (تكون المشيمة في الرحم)",
 "胎盤早期剥離": "انفصال المشيمة المبكر (اضطراب في الحمل تنفصل فيه المشيمة قبل الأوان عن جدار الرحم)",
 "胎脂": "طلاء دهني, فيرنيكس كازيوزا (مادة وقائية بيضاء تشبه الجبن تغطي جلد الجنين)",
 "胎膜": "غشاء جنيني (أي غشاء يعمل لحماية أو تغذية أو تنفس أو إخراج الجنين النامي)",
 "胎芽": "جَنِين / بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "胎齢": "عمر الحمل, عمر جنيني (عمر الجنين محسوباً من وقت الإخصاب)",
 "胚": "جَنِين",
 "胚乳": "بياض البيض, زلال (الجزء الأبيض من البيضة؛ المادة الهلامية المغذية والواقية المحيطة بالصفار وتتكون أساساً من الألبومين المذاب في الماء) / ألبومين, زلال (بروتين بسيط قابل للذوبان في الماء يوجد في العديد من الأنسجة والسوائل الحيوانية)",
 "胚培養士": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "胚子": "جَنِين",
 "胚性": "جَنِينِيّ, فِي طَوْرِ التَّكَوُّن (في مرحلة مبكّرة من التطوّر) / جَنِينِيّ (يتعلق بالكائن الحي قبل الولادة أو الفقس)",
 "胚性幹細胞": "أينشتاينيوم (عنصر مشع ما بعد اليورانيوم يتم إنتاجه بقصف البلوتونيوم بالنيوترونات)",
 "胚珠": "بويضة صغيرة (بويضة صغيرة أو غير ناضجة) / بويضة (جسم صغير يحتوي على الخلية الجرثومية الأنثوية للنبات؛ يتطور إلى بذرة بعد الإخصاب)",
 "胚盤": "أدمة الأريمة, قرص جرثومي (طبقة من الخلايا في الجزء الداخلي للأريمة)",
 "胚盤胞": "كيسة أريمية (أريمة الثدييات المشيمية التي حدث فيها بعض تمايز الخلايا)",
 "胚種": "جُرْثُومَة",
 "胚胎": "اِنْتَاش / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "胚膜": "برقع, غشاء جنيني (الغشاء الداخلي للأجنة في الفقاريات العليا (خاصة عندما يغطي الرأس عند الولادة))",
 "胚芽": "جُرْثُومَة",
 "胚葉": "طبقة جرثومية, طبقة منتشة ((في علم الأجنة) أي من طبقات الخلايا الثلاث التي تتمايز في الأجنة بعد عملية المعيدة)",
 "胛": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "胞子": "بوغ (جسم تكاثري لاجنسي صغير عادة ما يكون وحيد الخلية تنتجه العديد من النباتات غير الزهرية والفطريات وبعض البكتيريا والأوالي، وهو قادر على التطور إلى فرد…)\nمثال: يتكون البوغ الجنسي بعد اندماج الأمشاج",
 "胞子体": "طور بوغي, نابت بوغي (الفرد أو الطور المنتج للأبواغ في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "胞子嚢": "كيس الأبواغ, محفظة بوغية (عضو يحتوي على الأبواغ أو ينتجها)",
 "胞子嚢群": "بثرة بوغية, كويمة بوغية (مجموعة من الحوافظ البوغية عادة على الجانب السفلي لسعفة السرخس) / بثرة (بنية منتجة للأبواغ في بعض الأشنات والفطريات)",
 "胞子植物": "بَوْغِيّ, حَامِلٌ لِلْأَبْوَاغِ (يَحْمِلُ الأَبْوَاغَ بَدَلًا مِنْ إِنْتَاجِ البُذُورِ)",
 "胞状": "حويصلي (من أو يتعلق بالحويصلات أو يتضمنها)\nمثال: تنفس حويصلي طبيعي",
 "胞状奇胎": "حمل عنقودي, رحى عدارية (شذوذ أثناء الحمل؛ تتحلل الزغابات المشيمية حول الجنين وتشكل عناقيد من أكياس مملوءة بسائل؛ يرتبط عادة بموت الجنين)",
 "胞状鬼胎": "حمل عنقودي, رحى عدارية (شذوذ أثناء الحمل؛ تتحلل الزغابات المشيمية حول الجنين وتشكل عناقيد من أكياس مملوءة بسائل؛ يرتبط عادة بموت الجنين)",
 "胞胚": "أريمة (مرحلة مبكرة من الجنين تنتج عن انقسام البويضة؛ كرة مملوءة بالسائل يتكون جدارها من طبقة واحدة من الخلايا)",
 "胞胚腔": "تجويف الأريمة (التجويف المملوء بالسائل داخل الأريمة)",
 "胞膜": "غِشاءُ البَوْغ, غِطَاء (غشاء يحيط بالأبواغ النامية ويحميها، خاصة ذلك الذي يغطي البثرات البوغية في السرخس)",
 "胞衣": "خَلَاص",
 "胡乱": "مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / زفر, سمكي (مكون من أو متعلق بـ أو يشبه السمك)\nمثال: كان للحساء رائحة سمكية",
 "胡人": "صُغْدِيّ",
 "胡孫眼": "بوليبور, فطر متعدد المسام (فطريات مسامية خشبية؛ أي فطر من فصيلة بوليبوراسيا أو فصيلة بوليتاسيا يكون سطحه الحامل للأبواغ داخل أنابيب أو مسام؛ الأجسام الثمرية عادة ما تكون خشبية…)",
 "胡散": "مُريب, مَشبوه",
 "胡散臭い": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ) / مَشْبُوه (مشكوك في نزاهته أو قانونيَّته) / مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / مُسْتَتِر, مُظْلِم (هادئ ومعتم أو مستتر عن الأنظار)",
 "胡桃": "جَوْز (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "胡桃割り": "كَسَّارَة جَوْز / كَسَّارَة بُنْدُق",
 "胡桃割り人形": "كَسَّارَة جَوْز / كَسَّارَة بُنْدُق",
 "胡桃油": "زيت الجوز (زيت مستخرج من الجوز)",
 "胡椒": "فِلْفِل, فُلْفُل (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "胡椒入れ": "رجاجة فلفل, فلفلة (رجاجة ذات غطاء مثقوب لرش الفلفل المطحون)",
 "胡椒草": "رشاد مزروع (رشاد يزرع للسلطات والزينة)",
 "胡瓜": "خِيَار (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "胡瓜魚": "هف قوس قزح (سمكة غذائية بحرية وحبيسة مهمة في شرق أمريكا الشمالية وألاسكا) / هف أمريكي (الهف الشائع في شرق أمريكا الشمالية وألاسكا)",
 "胡盧": "دُبَّاء",
 "胡簶": "جَعْبَة",
 "胡籙": "جَعْبَة",
 "胡臭": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام)",
 "胡荽": "كُزْبَرَة, قُسْبَرَة",
 "胡蘆": "دُبَّاء",
 "胡蘿蔔": "جَزَر, جزر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "胡虜": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "胡蝶": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "胡蝶花": "سوسن دموي",
 "胡蝶蘭": "أوركيد العثة, فالاينوبسيس (أي من بساتين الفاكهة المختلفة من جنس فالاينوبسيس ذات أوراق بيضاوية أو بيضاوية مقلوبة عريضة لامعة متدلية غالباً خضراء داكنة مشوبة بالأرجواني أو مرقطة…)",
 "胡鬼板": "مِدَقّ, مِدَقَّة (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "胡麻": "بذور السمسم, سمسم (بذور بيضاوية صغيرة لنبات السمسم) / سِمْسِم, جُلْجُلان",
 "胡麻を擂る": "تَمَلَّقَ, تَبَصْبَصَ",
 "胡麻塩": "خَلِيس",
 "胡麻擂り": "مداهنة, نفاق (تذلل متملق)",
 "胡麻油": "زَيْت سِمْسِم, زَيْت السِمْسِم (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "胡麻粒": "بذور السمسم, سمسم (بذور بيضاوية صغيرة لنبات السمسم)",
 "胤": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "胤裔": "خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "胯下": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "胴": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟ / صُدْرَة ((علم الحيوان) جزء من صدفة السلحفاة يشكل جانبها السفلي) / وسادة حماية الصدر (وسادة كبيرة يرتديها المبارز لحماية الصدر) / صدرية درعية (صفيحة صدرية معدنية كانت تلبس تحت معطف الزرد) / صدرية القميص (مقدمة قميص الرجل الرسمي) / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / تَاجِر, تَاجِرَة",
 "胴が長い": "طَوِيلُ الجَسَد (لَهُ جَسَدٌ طَوِيلٌ نِسْبِيًّا)",
 "胴の長い": "طَوِيلُ الجَسَد (لَهُ جَسَدٌ طَوِيلٌ نِسْبِيًّا)",
 "胴まわり": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "胴中": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "胴乱": "حقيبة ساعي, حقيبة كتف (أمتعة تتكون من حقيبة صغيرة ذات قاع مسطح و(عادة) حزام كتف)",
 "胴付": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "胴付き": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "胴付きノコ": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "胴付きノコギリ": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "胴付き鋸": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "胴付鋸": "منشار مقوى الظهر (منشار يدوي مدعم بتقوية معدنية على طول الحافة العلوية)",
 "胴付長靴": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "胴体": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟ / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "胴元": "مَصْرَفِيّ, بَنْكِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "胴回り": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "胴囲": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "胴差し": "عارضة (عارضة مصنوعة عادة من الصلب؛ دعامة رئيسية في هيكل)",
 "胴巻き": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة))",
 "胴慾": "طَمَع, شُحُّ",
 "胴欲": "طَمَع, شُحُّ",
 "胴着": "ملابس داخلية (رداء يلبس تحت ملابس أخرى)",
 "胴突": "مِدَكّ (أداة لدفع شيء بقوة)",
 "胴突き": "مِدَكّ (أداة لدفع شيء بقوة)",
 "胴締め": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "胴衣": "صُدَيْرِيّ (المنسوب إلى الصُدَيْر أي مصغر الصدر؛ لباس للرجال غربي يغطي الجذع ويزرّر عند الصدر وليس له أكمام، يُرتدى غالبا تحت السترة) / ملابس داخلية (رداء يلبس تحت ملابس أخرى)",
 "胴親": "مَصْرَفِيّ, بَنْكِيّ",
 "胴輪": "عِنان",
 "胴部": "جِذْع, جِسْم (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "胴鎧": "لَبَب",
 "胴長短足": "طَوِيلُ الجَسَد (لَهُ جَسَدٌ طَوِيلٌ نِسْبِيًّا)",
 "胴震い": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)",
 "胴顫い": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)",
 "胸": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / ثَدْي, بز / قَلْب, فُؤَاد / قَلْب / كُبَّا / رِئَة, سَحَر",
 "胸おどる": "مُثِير",
 "胸が悪い": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / مَرِيض, مُتَأَثِّر بِعُمْق (متأثر تأثرًا عميقًا بشعور قوي) / مَجْنُون, مُخْتَلّ (مصاب بالجنون أو الاضطراب العقليّ) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت) / غَاضِب, غَضْبَان",
 "胸くそ": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / مُقْرِف, مُقَزِّز",
 "胸くそが悪い": "مُقْرِف, مُقَزِّز",
 "胸くそ悪い": "مُقْرِف, مُقَزِّز",
 "胸ぐら": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "胸さわぎ": "تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "胸に一物": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "胸に畳む": "احتفظ بكل شيء لنسفه",
 "胸に納める": "احتفظ بكل شيء لنسفه",
 "胸のすく": "مُنْعِش",
 "胸の谷間": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "胸びれ": "زعنفة صدرية (إحدى زوج من الزعانف تقع خلف الرأس مباشرة في الأسماك تساعد في التحكم في اتجاه الحركة)",
 "胸もと": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "胸やけ": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "胸ポケ": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "胸ポケット": "جيب صدر (جيب في الجزء الداخلي أو الخارجي العلوي من معطف الرجل)",
 "胸三寸": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "胸乳": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "胸倉": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "胸像": "حفلة صاخبة, نوبة إفراط (مناسبة للإفراط في الأكل أو الشرب) / مُفْلِس (يفتقر إلى الأموال) / تمثال نصفي (نحت لرأس وكتفي شخص) / صدر المرأة (صدر المرأة)\nمثال: ذهبوا في نوبة إفراط استمرت ثلاثة أيام",
 "胸元": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / الحفرة الشرسوفية, فم المعدة (انخفاض طفيف في خط الوسط أسفل القص مباشرة (حيث يمكن لضربة أن تؤثر على الضفيرة الشمسية))",
 "胸先": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "胸前": "خَزِينَة / كُمُودِينُو, أَدْرَاجِيَّة / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
 "胸墻": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض) / تصوينة, درابزين سور (جدار منخفض على طول حافة السطح أو الشرفة)",
 "胸壁": "حاجز صد, ساتر (تحصين يتكون من جدار منخفض) / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / تصوينة, درابزين سور (جدار منخفض على طول حافة السطح أو الشرفة)",
 "胸声": "سجل الصدر, صوت الصدر (النطاقات الدنيا للصوت في الكلام أو الغناء)",
 "胸座": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
