 "盗み取る": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "盗み笑い": "إِهْلَاس",
 "盗み聞き": "تَنَصُّت, اِسْتِرَاق سَمْع / تَنَصُّت",
 "盗む": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / اِنْتَحَلَ",
 "盗る": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "盗人": "لِصّ, لِصَّة",
 "盗人猛々しい": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "盗人猫": "زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "盗作": "اِنْتِحال",
 "盗取": "سَرِقَة, سَرَقَة",
 "盗品": "نَهَبَ",
 "盗塁": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "盗掠": "سرقة, لصوصية (فعل أخذ شيء من شخص ما بشكل غير قانوني) / تسلل, خلسة (تجنب الكشف عن طريق التحرك بحذر)\nمثال: اللصوصية فظيعة في مطار كينيدي الدولي",
 "盗汗": "فَرْط التَّعَرُّق اللَّيْلِيّ",
 "盗犯": "سَطْو / لُصُوصِيَّة",
 "盗用": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "盗癖": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "盗聴": "اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "盗聴器": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "盗聴機": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "盗賊": "لِصّ, لِصَّة",
 "盗賊鴎": "كَرْكَر",
 "盗難": "سَرِقَة, سَرَقَة\nمثال: 盗難の届をだしたいのですけど。 — أريد أن أبلغ عن سرقة.",
 "盛": "إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء",
 "盛り": "اِرْتِفَاع / مُمْتَاز, فَاخِر / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء",
 "盛りあがり": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "盛りあがる": "اِنْتَفَخَ, وَرِمَ",
 "盛りがつく": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, مسار عجل (أخدود أو شق (خاصة في الأرض اللينة الناتج عن العجلات)) / دورة الشبق, شبق (ينطبق على الثدييات غير البشرية: حالة أو فترة من الإثارة الجنسية والنشاط المتزايد)\nمثال: وقعوا في روتين محادثة ممل",
 "盛りが付く": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, مسار عجل (أخدود أو شق (خاصة في الأرض اللينة الناتج عن العجلات)) / دورة الشبق, شبق (ينطبق على الثدييات غير البشرية: حالة أو فترة من الإثارة الجنسية والنشاط المتزايد)\nمثال: وقعوا في روتين محادثة ممل",
 "盛りだくさん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "盛りのついた": "شبِق, في فترة الشبق ((للثدييات الدنيا) تُظهر أو تكون في حالة شبق)\nمثال: حالة الشبق",
 "盛りの付いた": "شبِق, في فترة الشبق ((للثدييات الدنيا) تُظهر أو تكون في حالة شبق)\nمثال: حالة الشبق",
 "盛り上がり": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "盛り上がる": "اِنْتَفَخَ, وَرِمَ",
 "盛り合せ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "盛り合わせ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "盛り土": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "盛り沢山": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "盛り立てる": "أَحْيَا",
 "盛り花": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "盛り込む": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "盛り返す": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "盛る": "ازدهر / جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مَلَأَ / وَصَفَ / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "盛れる": "جَمَّلَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "盛ん": "سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / مَحْبُوب\nمثال: 我々の国ではウインタースポーツが盛んだ。 — الرياضات الشتوية محبوبة جداً في بلدنا. / نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور. / مُتَحَمِّس",
 "盛んな歓迎": "حَفَاوَة, حُسْن الِاسْتِقْبَال (اللطف في استقبال الضيوف أو الغرباء)",
 "盛んに": "بِنَشَاطٍ",
 "盛んになる": "ازدهر",
 "盛世": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "盛合せ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "盛合わせ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "盛名": "سُمْعَة, شُهْرَة",
 "盛土": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "盛夏": "قيظ",
 "盛大": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد) / حَازِم, قَاطِع (قويّ وحاسم في التعبير أو الفعل) / حازم, فعال (يتميز بـ أو مليء بالقوة أو الشدة (غالباً ولكن ليس بالضرورة جسدياً))\nمثال: متحدث قوي",
 "盛岡": "مُورْيُوكَا",
 "盛年": "أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها)",
 "盛挙": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "盛時": "أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها)",
 "盛栄": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "盛況": "نَجَاح",
 "盛田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "盛花": "تنسيق الزهور (ترتيب زخرفي للزهور)",
 "盛行": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "盛衰": "رَفَاهَة, خَيْر",
 "盛込む": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "盛運": "اِزْدِهَار, رَخَاء",
 "盟": "تَحَالُف, اِتِّحَاد / عُصْبَة, اِتِّحَاد / دَوْرِيّ (لُفِّي؛ اسْتَدِيرِي)\nمثال: كان دوري كي أنظف المسكن",
 "盟う": "شَتَمَ, سَبَّ\nمثال: 君は聖書に手をのせて誓うべきだ。 — ينبغي أن تقسم ويدك على الإنجيل.",
 "盟主": "قَائِد, زَعِيم",
 "盟友": "حَلِيف, حَلِيفَة",
 "盟約": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "盟邦": "حَلِيف, حَلِيفَة",
 "監": "سِكْرِتِير, سِكْرِتِيرَة",
 "監事": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه) / مُشْرِف, مُشْرِفَة",
 "監修": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "監倉": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)",
 "監守": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس.",
 "監守人": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "監察": "تَفَقُّد",
 "監察医": "طَبِيب شَرْعِيّ, طَبِيب عَدْلِيّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "監察官": "مُفَتِّش, مُفَتِّشَة",
 "監房": "صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ",
 "監査": "تَفَقُّد",
 "監査人": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه)",
 "監査官": "مُفَتِّش, مُفَتِّشَة",
 "監査役": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه)",
 "監獄": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "監理": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "監的": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "監督": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "監督官": "مُفَتِّش, مُفَتِّشَة",
 "監督教会": "الكنيسة الأسقفية (كنيسة الولايات المتحدة التي تتواصل مع كرسي كانتربري) / الكنيسة الأسقفية في اسكتلندا (فرع مستقل من الطائفة الإنجليكانية في اسكتلندا)",
 "監督生": "حاكم إداري, محافظ (كبير الضباط أو كبير القضاة)\nمثال: محافظ شرطة باريس",
 "監督者": "مشرف عام, ناظر (شخص يوجه ويدير منظمة) / مَسْؤُول العِمارَة, مُشْرِف المَبْنَى (حارس مبنى سكني يمثل المالك ويعمل كبواب وجامع للإيجار)",
 "監禁": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "監禁室": "سجن السفينة, محبس (مؤسسة عقابية (خاصة على متن سفينة)) / بريغ (سفينة شراعية بصاريتين ومجهزة بأشرعة مربعة على كلا الصاريتين)",
 "監視": "رصد, متابعة (فعل مراقبة شيء ما (وأحياناً الاحتفاظ بسجل له))\nمثال: يلعب رصد اتصالات العدو دوراً مهماً في أوقات الحرب",
 "監視プログラム": "برنامج مراقبة (برنامج يراقب وينظم ويتحكم أو يتحقق من عمليات نظام معالجة البيانات)",
 "監視下": "خاضع للإشراف, مُراقب (تحت المراقبة أو تحت توجيه مشرف أو ناظر)\nمثال: لعب تحت الإشراف",
 "監視体制": "نظام مراقبة (نظام تلفزيون الدائرة المغلقة يستخدم للمراقبة الدقيقة لشخص أو مجموعة)",
 "監視員": "متفرج",
 "監視哨": "مرصد, نقطة مراقبة (موقع مرتفع يتيح رؤية واسعة)",
 "監視塔": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "監視局": "مُرَاقِب, مُرَاقِبَة / شَاشَة الْعَرْض, شَاشَة / عَرِيف, عَرِيفَة / رَاقَّبَ",
 "監視者": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "監視船": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "監護者": "أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "盤": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "盤層": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "盤石": "ثَبَات",
 "盤秤": "رَصِيد",
 "盤竜類": "بيليكوصور (زاحف بدائي كبير له شراع شوكي طويل؛ من العصر البرمي أو أواخر العصر القديم في أوروبا وأمريكا الشمالية)",
 "盤面": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ",
 "盤領": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "盥": "بانيو, حوض استحمام (حاوية مفتوحة كبيرة نسبياً تملأ بالماء وتستخدم لغسل الجسم) / حوض كبير, دن (وعاء مفتوح كبير لحفظ أو تخزين السوائل) / ملء حوض (الكمية التي يستوعبها حوض)\nمثال: حوض من الماء",
 "盪々": "شَاسِع, وَاسِع",
 "盪盪": "شَاسِع, وَاسِع",
 "目": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / بَنْد",
 "目あか": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目あて": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف. / مَشْهَد / مَنْظَر",
 "目いっぱい": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "目かくし": "غَمَّى",
 "目からうろこの落ちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "目からウロコの落ちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "目から鱗の落ちる": "أَخْرَوِيّ, كَارِثِيّ (يُنبِئ بالدمار أو الهلاك النهائي) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "目がさめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "目が合う": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص",
 "目が覚める": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "目くそ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目くばせ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "目くらまし": "تمويه, ستار دخاني (إجراء يهدف إلى الإخفاء أو الإرباك أو التعتيم) / ستار دخاني ((عسكرياً) شاشة تتكون من سحابة من الدخان تحجب التحركات)\nمثال: طلب صلاحيات مراقبة جديدة هو مجرد ستار دخاني لإخفاء فشلهم / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "目くるめく": "إبهار, إعشاء (سطوع يكفي للتسبب بالعمى الجزئي والمؤقت)",
 "目こぼし": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما) / تآمر, تواطؤ (الاتفاق على مؤامرة سرية)",
 "目こぼれ": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "目ざとい": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ) / حَادُّ البَصَر, حَادُّ النَّظَر (شَدِيدُ الانْتِبَاهِ وَالإِدْرَاك) / ثَاقِب البَصَر, حَدِيد النَّظَر (ذو بصر حادّ جدًّا)",
 "目ざまし": "مُنَبِّه, سَاعَة مُنَبِّهَة / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "目じるし": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "目す": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "目する": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "目っけ物": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "目つき": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目にあう": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "目にかかる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "目にする": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "目につく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "目には目を": "الْعَيْنُ بِالْعَيْن",
 "目にもとまらぬ": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "目にも止まらぬ": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "目にも留まらぬ": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "目に付く": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "目に懸かる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "目に掛かる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "目に浮かぶ": "صُورَة, تَصْوِير / صُورَة, صُورَة شَمْسِيَّة",
 "目に留める": "أَعَارَ اِنْتِبَاه",
 "目に見えて": "بشكل مرئي (بحيث يكون مرئياً) / بوضوح, عياناً (بطريقة مرئية)\nمثال: عرضت العلامة بشكل مرئي",
 "目に遭う": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "目のつけどころ": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "目の上のこぶ": "إِزْعَاج",
 "目の上の瘤": "إِزْعَاج",
 "目の不自由": "عَمًى",
 "目の付けどころ": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "目の付け所": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "目の前": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / فَوْرِيّ",
 "目の届かないところ": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء) / بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً) / مَحْجُوب, مَخْفِيّ (غَيْرُ مُتَاحٍ لِلنَّظَر)\nمثال: استلقى متربصاً",
 "目の届かない所": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء) / بعيداً عن الأنظار, خارج مدى الرؤية (لم يعد مرئياً) / مَحْجُوب, مَخْفِيّ (غَيْرُ مُتَاحٍ لِلنَّظَر)\nمثال: استلقى متربصاً",
 "目の届くところに": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "目の届く所に": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "目の届く限り": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "目の当たり": "شَخْصِيًّا",
 "目の当り": "شَخْصِيًّا",
 "目の毒": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "目の玉": "مُقْلَة اَلْعَيْن",
 "目の玉が飛び出る": "بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "目の球": "مُقْلَة اَلْعَيْن",
 "目の粗い": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "目の細かい": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "目の色": "لون العين (تصبغ قزحية العين)\nمثال: لا تزال وراثة لون العين، مثل لون الشعر، قيد البحث، ومن الواضح أن عدة جينات يمكن أن تعدل النتيجة النهائية",
 "目の覚めるよう": "خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت) / لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / صَاعِق, مُذْهِل (يسبب أو قادر على التسبب في الذهول أو الصدمة أو فقدان الوعي) / مُذْهِل, مُصْعِق (يُسبب ذهولًا وحيرة شديدين)",
 "目の覚める様": "خَاطِف لِلْأَنْظَار, مُذْهِل (جميل أو جذاب بشكل لافت) / لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / صَاعِق, مُذْهِل (يسبب أو قادر على التسبب في الذهول أو الصدمة أو فقدان الوعي) / مُذْهِل, مُصْعِق (يُسبب ذهولًا وحيرة شديدين)",
 "目の詰んだ": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "目の辺り": "شَخْصِيًّا",
 "目はし": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "目ぼし": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "目ぼしい": "مَرْمُوق, بَارِز",
 "目まぐるしい": "دَائِخ",
 "目もあや": "باهِر",
 "目もくれず": "بلامبالاة (مع اللامبالاة؛ بطريقة غير مبالية)\nمثال: هزت كتفيها بلامبالاة",
 "目もくれない": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ) / سِيَّان, لَا يَهُمّ ((غالبًا متبوع بـ 'لـ') لا أهمّيّة له؛ لا فرق بين خياراته) / فَاتِر, لَامُبَالٍ (يتّسم بانعدام الاهتمام) / وَسَطِيّ (لَيْسَ مُفْرِطًا وَلَا قَلِيلًا جِدًّا)",
 "目もと": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "目も綾": "باهِر",
 "目やに": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目をかける": "اِهْتَمَّ, اِعْتَنَى",
 "目をくらます": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "目をさます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "目をそらす": "غضّ النظر, غضّ الطرف",
 "目をつぶる": "أَغْمَضَ العَيْنَيَنِ عَنْ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "目をとおす": "مَسَحَ ضَوْئِيًّا (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "目をとじる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "目をとめる": "أَعَارَ اِنْتِبَاه",
 "目を回す": "إِغْمَاء / أُغْمِيَ, غُشِيَ / مَذْهُول / أَدَارَ عَيْنَيْهِ, بَرَمَ عَيْنَيْهِ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "目を奪う": "فَتَنَ",
 "目を掛ける": "اِهْتَمَّ, اِعْتَنَى",
 "目を晦ます": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)",
 "目を止める": "أَعَارَ اِنْتِبَاه",
 "目を留める": "أَعَارَ اِنْتِبَاه",
 "目を眩ます": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "目を瞑る": "أَغْمَضَ العَيْنَيَنِ عَنْ / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "目を細くする": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "目を細める": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "目を背ける": "غضّ النظر, غضّ الطرف / إِهْمال / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "目を落とす": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)",
 "目を見る": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "目を覚ます": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / صَحَا (أَفَاقَ؛ اِسْتَيْقَظَ)",
 "目を走らせる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "目を通す": "مَسَحَ ضَوْئِيًّا (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "目を逸らす": "غضّ النظر, غضّ الطرف",
 "目を閉じる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "目を開く": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "目んめ": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "目ん玉": "مُقْلَة اَلْعَيْن",
 "目アカ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目ヤニ": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目一杯": "حتى النهاية, لأقصى حد (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: أنت متورط في هذا حتى النهاية (يفيد انتهاء الغاية؛ يفيد الغاية)",
 "目上": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "目下": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "目串": "اِتِّهَام, شَكّ / اِتِّهَام",
 "目交ぜ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "目今": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "目付": "رقيب (شخص مخول بقراءة المنشورات أو المراسلات أو مشاهدة العروض المسرحية ومنع أي شيء يعتبر فاحشاً أو غير مقبول سياسياً كلياً أو جزئياً) / لَوَّام, نَاقِد (شخص يلوم أو يدين)",
 "目付き": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目伏し": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目元": "رأي, منظور (رأي أو حكم (بمعنى مجازي))\nمثال: في نظر القانون",
 "目先": "فَوْرِيّ / بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "目処": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "目処がたたず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "目処がたつ": "هُنَاكَ, يُوجَدُ",
 "目処が立たず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "目処が立たない": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "目処が立つ": "هُنَاكَ, يُوجَدُ",
 "目出し帽": "قناع التزلج (قناع صوفي للوجه لحماية الوجه من البرد أثناء التزلج على الثلج)",
 "目利き": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "目前": "فَوْرِيّ / بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً) / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / دنو, وشوك (حالة كونه وشيكاً وعرضة للحدوث قريباً)",
 "目加田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "目医者": "أخصائي عيون, طبيب عيون (طبيب متخصص في تشخيص وعلاج أمراض العين)",
 "目印": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "目叩く": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "目合": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "目合ひ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "目地": "مُشْتَرَك / مِفْصَل",
 "目垢": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目安": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار) / تَقْرِيب",
 "目差": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目差し": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目庇": "حافة أمامية, قناع (حافة تبرز إلى الأمام لتظليل العينين) / قناع الخوذة (قطعة من الدرع الصفيحي (ذات شقوق للعين) مثبتة أو مفصلية بخوذة من العصور الوسطى لحماية الوجه)\nمثال: سحب حافة قبعته لأسفل ومشى بجهد للأمام",
 "目張り": "شريط عزل الطقس (شريط ضيق من المواد لتغطية مفصل الباب أو النافذة لمنع البرد)",
 "目当": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف. / مَشْهَد / مَنْظَر",
 "目当て": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف. / مَشْهَد / مَنْظَر",
 "目打ち": "تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل)) / تثقيب, خط ثقوب (خط من الثقوب الصغيرة للتمزيق في مكان معين) / تثقيب, خرق (ثقب مصنوع في شيء ما)\nمثال: ثقب في طبلة الأذن",
 "目抜き": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "目抜き通り": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "目指": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目指し": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目撃": "شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "目撃者": "شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "目敏い": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ) / حَادُّ البَصَر, حَادُّ النَّظَر (شَدِيدُ الانْتِبَاهِ وَالإِدْرَاك) / ثَاقِب البَصَر, حَدِيد النَّظَر (ذو بصر حادّ جدًّا)",
 "目数": "عَدَّ / كُونْت",
 "目新しい": "أَصْلِيّ",
 "目方": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "目早い": "ثَاقِب النَّظَر, حَادّ البَصَر (ذو بصر حادّ ونافذ) / حَادُّ البَصَر, حَادُّ النَّظَر (شَدِيدُ الانْتِبَاهِ وَالإِدْرَاك) / ثَاقِب البَصَر, حَدِيد النَّظَر (ذو بصر حادّ جدًّا)",
 "目明": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "目明かし": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "目明き千人盲千人": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "目明し": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "目星": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "目映い": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "目時": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "目暮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "目木": "باربيريس ياباني (شجيرة نفضية مدمجة لها توت أحمر دائم؛ واسعة الانتشار في الزراعة خاصة للأسوار الحية)",
 "目板": "فَسْقِيَّة, فِسْقِيَّة",
 "目検": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "目標": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / مَعْلَم (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَرْمًى / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَجَّلَ هَدَفًا (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: لقد أخطأ الهدف. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "目標プログラム": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "目標物": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "目標言語": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "目次": "فِهْرِس, مُحْتَوَيَات (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "目止め": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "目減り": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "目溢れ": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "目玉": "مُقْلَة اَلْعَيْن / قطعة مركزية (شيء يوضع في وسط شيء آخر (كما على الطاولة)) / ركيزة, قطعة مركزية (الميزة المركزية أو الأكثر أهمية)\nمثال: كان التعليم الركيزة الأساسية للبرنامج السياسي للحزب الديمقراطي / سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن) / مَقْلِيٌّ مِنْ جَانِبٍ وَاحِد ((عَنِ البَيْض) مَقْلِيٌّ عَلَى جَانِبٍ وَاحِدٍ فَقَط)",
 "目玉が飛び出る": "بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "目玉クリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "目玉商品": "سلعة استدراج, منتج خاسر للاستدراج (سلعة مميزة تباع بخسارة لجذب الزبائن) / جَاذِبٌ لِلنَّظَرِ, لَافِتٌ لِلِانْتِبَاهِ (يَسْتَحْوِذُ عَلَى الِانْتِبَاهِ)",
 "目玉焼": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "目玉焼き": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "目白": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "目白押し": "تدافع, زحام (فعل التدافع (شق طريقك عن طريق الدفع)) / مَحْشُوّ, مَكْدُوس (مَمْلُوء عَنْ آخِرِه حَتَّى السَّعَة القُصْوَى)",
 "目白鮫": "قرش الرمل (أكثر أنواع القرش الرمادي شيوعاً على طول سواحل ولايات وسط المحيط الأطلسي؛ بطيء الحركة ويصطاده الصيادون أحياناً) / قرش أسود الطرف (قرش واسع الانتشار في المياه الضحلة، تبدو زعانفه وكأنها مغموسة في الحبر)",
 "目的": "هَدَف, مَقْصِد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَبَب ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: لقد أخطأ الهدف.",
 "目的プログラム": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "目的因": "علة غائية ((في الفلسفة) الغاية أو الغرض من شيء أو عملية)",
 "目的地": "وِجْهَة, وُجْهَة",
 "目的性": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع)\nمثال: نهائية الموت",
 "目的意識": "ذات هدف, هادفة (صفة امتلاك غرض محدد)",
 "目的格": "حالة النصب (حالة الأسماء التي تعمل كمفعول به مباشر للفعل)",
 "目的物": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "目的的": "هَادِف (ذو معنى من خلال وجود غاية) / ذو غرض, هادف (يخدم كـ أو يشير إلى وجود غرض أو هدف)",
 "目的節": "جملة الغاية, عبارة غائية (جملة تعبر عن غرض أو نية (مثل تلك التي تبدأ بـ 'من أجل' أو 'كي'))",
 "目的言語": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "目的語": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "目的論": "غائية",
 "目盛": "تَخَرُّج",
 "目盛り": "تَخَرُّج",
 "目眩": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "目眩し": "تمويه, ستار دخاني (إجراء يهدف إلى الإخفاء أو الإرباك أو التعتيم) / ستار دخاني ((عسكرياً) شاشة تتكون من سحابة من الدخان تحجب التحركات)\nمثال: طلب صلاحيات مراقبة جديدة هو مجرد ستار دخاني لإخفاء فشلهم / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "目眩まし": "تمويه, ستار دخاني (إجراء يهدف إلى الإخفاء أو الإرباك أو التعتيم) / ستار دخاني ((عسكرياً) شاشة تتكون من سحابة من الدخان تحجب التحركات)\nمثال: طلب صلاحيات مراقبة جديدة هو مجرد ستار دخاني لإخفاء فشلهم / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "目礼": "مُتَدَلٍّ, مُنْحَنٍ لِلأَسْفَل (ذو فروع أو رؤوس أزهار تنحني إلى الأسفل)",
 "目移り": "تشتيت, صرف الانتباه (عملية التشتيت؛ صرف انتباه شخص ما عن شيء ما) / إلهاء, تسرية (ترفيه يثير اهتماماً ساراً ويصرف انتباهك عن الهموم والمضايقات) / تشتت, شرود (اضطراب عقلي وتشتت في الانتباه) / إلهاء, تشتيت (عائق يمنع الانتباه)\nمثال: السحرة خبراء في صرف الانتباه",
 "目立ちたがり": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "目立ちたがり屋": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "目立て": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "目端": "سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير)",
 "目箒": "ريحان (أوراق الريحان الشائع؛ تستخدم طازجة أو مجففة) / حبق, ريحان (نبات حولي أو معمر من آسيا الاستوائية له سنابل من الزهور البيضاء الصغيرة وأوراق عطرية؛ أحد أهم أعشاب الطهي؛ يستخدم في السلطات والأطعمة والصلصات وبعض…)",
 "目算": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "目糞": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "目線": "رَنَا ((رَنَا) رنوا ورنوا: أدام النظر في سكون طرف. ويقال رناه ورنا إليه ورنا له؛ (رَنَا) إلى حديثه: أصغى) / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "目腐れ": "غَائِمُ العَيْنَيْن, كَلِيل (مُتْعَبٌ إِلَى حَدِّ الإِنْهَاك)",
 "目腐れ金": "أجر زهيد, مبلغ ضئيل (دفعة غير كافية)\nمثال: يعملون طوال اليوم مقابل مبلغ زهيد",
 "目色": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص) / تعبير وجهي (إيماءة تنفذ بواسطة عضلات الوجه)\nمثال: تعبير حزين",
 "目草": "عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة)",
 "目薬": "غسول العين, كحل سائل (غسول يتكون من محلول يستخدم كمنظف للعيون)",
 "目見": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目見え": "مُقَابَلَة / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "目見得": "مُقَابَلَة / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "目視": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة",
 "目覚し": "مُنَبِّه, سَاعَة مُنَبِّهَة / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "目覚しい": "لافت للنظر",
 "目覚し時計": "مُنَبِّه, سَاعَة مُنَبِّهَة",
 "目覚まし": "مُنَبِّه, سَاعَة مُنَبِّهَة / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "目覚ましい": "لافت للنظر",
 "目覚まし時計": "مُنَبِّه, سَاعَة مُنَبِّهَة",
 "目覚ます": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "目覚め": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه) / صحو, يقظة (حالة البقاء مستيقظاً)\nمثال: أيام الخطر وليالي اليقظة",
 "目覚める": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ) / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "目論み": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "目論む": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "目論見": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "目論見書": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "目貼り": "شريط عزل الطقس (شريط ضيق من المواد لتغطية مفصل الباب أو النافذة لمنع البرد)",
 "目路": "ساحة بصرية",
 "目途": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "目途がたつ": "هُنَاكَ, يُوجَدُ",
 "目途が立たず": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "目途が立たない": "فِي مَهَبّ الرِّيح, مُعَلَّق (شديد الغموض وعدم اليقين) / لَمْ يُحْسَم بَعْد, مُعَلَّق (لم يُحدَّد أو يُبَتّ فيه بعد)",
 "目途が立つ": "هُنَاكَ, يُوجَدُ",
 "目通り": "جُمْهُور, نَظَّارَة",
 "目配せ": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "目配り": "انتباه, يقظة (سمة كون المرء ملاحظاً ومنتبهاً) / انتباه, مراعاة (سمة مراعاة الآخرين والتفكير فيهم) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين))",
 "目録": "كَتَالُوج, فِهْرِس / مُحْتَوَى, مَضْمُون",
 "目障り": "قذى للعين, منظر مؤذٍ للعين (شيء قبيح ومسيء جداً) / إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "目隠し": "غَمَّى",
 "目面": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目顔": "إِشَارَة",
 "目高": "كيلي فيش (أسماك صغيرة تعيش في أسراب تشبه الشبوط وتعيش في المياه الدافئة البحرية غالباً؛ تستخدم كطعم أو أسماك أحواض أو في مكافحة البعوض)",
 "目黒": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "目鼻": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "目鼻だち": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目鼻立": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "目鼻立ち": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "盲": "عَمًى / أُمِّيَّة / جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "盲人": "مَكْفوف",
 "盲信": "سذاجة, سرعة التصديق (الميل للتصديق بسهولة)",
 "盲千人目明き千人": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "盲印": "خَتْم مَطَّاطِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "盲導犬": "كلب مرشد (كلب مدرب لإرشاد المكفوفين)",
 "盲想": "خِدَاع, ضَلَالَة / غَرُور",
 "盲斑": "نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "盲滅法": "مُتَهَوِّر",
 "盲点": "نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "盲目": "عَمًى / أَعْمَى, عَمْيَاء\nمثال: 愛は盲目。 — الحب أعمى.",
 "盲目的": "أَعْمَى, عَمْيَاء",
 "盲目的に": "بشكل أعمى, دون تفكير (بدون تحضير أو تفكير؛ بدون أساس عقلاني) / بشكل أعمى, دون تبصر (دون رؤية أو نظر)\nمثال: اشتروا السيارة بشكل أعمى",
 "盲目飛行": "طيران آلي (الملاحة بالطائرة اعتمادًا كليًا على الأجهزة)",
 "盲者": "مَكْفوف",
 "盲腸": "أعور (التجويف الذي تبدأ فيه الأمعاء الغليظة والذي يفتح فيه اللفائفي)\nمثال: الزائدة الدودية هي فرع من الأعور / مُلْحَق / الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "盲腸炎": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "盲腸炎手術": "اِسْتِئْصَال الزَائِدَة الدُودِيَّة",
 "盲蛇": "ثعبان أعمى (ثعبان حفار يشبه الدودة من المناطق الدافئة له عيون أثرية)",
 "盲蜘蛛": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "盲進": "تطاول, وقاحة (نوع من الفظاظة في شكل فعل تطاول) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض قانوني, قرينة ((قانون) استدلال لحقيقة واقعة من حقائق أخرى تم إثباتها أو الاعتراف بها أو ملاحظتها قضائياً) / مُسلّمة, مُعطى (افتراض يؤخذ كأمر مسلم به)\nمثال: كان تطاوله لا يطاق",
 "盲長屋": "مبنى سكني متهالك, نزل رخيص (مبنى سكني متهالك بالكاد يفي بالمعايير الدنيا)",
 "盲鰻": "جُرَيْث",
 "直": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / عَادِيّ, مَأْلُوف / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه / قَرِيبًا, سَرْعَانَ مَا / بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / نَزِيه, صَادِق / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ) / النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً)) / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / قِيمَة",
 "直々": "بالذات, شخصياً (بالحضور الجسدي المباشر؛ دون وسيط)\nمثال: ذهبت إلى هناك شخصياً / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / عَادِيّ, مَأْلُوف / مُطِيع, مُذْعِن",
 "直き": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "直ぐ": "فَوْرًا, حَالًا / قَرِيبًا, سَرْعَانَ مَا / بِسُهُولَة / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "直ぐさま": "فَوْرًا, حَالًا",
 "直ぐそば": "بِالْقُرْب مِن, بِجَانِب",
 "直ぐと": "فَوْرًا, حَالًا / مُبَاشَرَةً",
 "直ぐに": "فَوْرًا, حَالًا",
 "直ぐにでも": "فَوْرًا, حَالًا",
 "直ぐにも": "فَوْرًا, حَالًا",
 "直ぐ側": "بِالْقُرْب مِن, بِجَانِب",
 "直ぐ様": "فَوْرًا, حَالًا",
 "直し": "تَصْحِيح / إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها)",
 "直し物": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها)",
 "直す": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / شِفَاء / شَفَى / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "直ちに": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا. / مُبَاشَرَةً",
 "直と": "بِالْقُرْب مِن, بِجَانِب / مُبَاشَرَةً / فَجْأَةً",
 "直に": "مُبَاشَرَةً / فَوْرًا, حَالًا / بِسُهُولَة",
 "直らない": "لا يمكن إصلاحه (مستحيل إصلاحه أو تصحيحه أو تعديله)\nمثال: ضرر لا يمكن إصلاحه",
 "直る": "شُفِيَ, بَرِئَ / شِفَاء / شَفَى / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "直上": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "直交": "قَائِمُ الزَّوَايَا, مُتَعَامِد (لَهُ مَجْمُوعَةُ مَحَاوِرَ مُتَعَامِدَة؛ يَلْتَقِي بِزَوَايَا قَائِمَة) / مُتَعَامِدٌ إِحْصَائِيًّا (غير مرتبط إحصائياً) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث)",
 "直交座標": "إِحْدَاثِيّ دِيكَارْتِيّ (أحد الإحداثيات في نظام يحدد نقطة في مستوى أو فراغ عبر بعدها عن خطين أو ثلاثة مستويات على التوالي؛ الخطان أو تقاطعات المستويات الثلاثة هي محاور…)",
 "直交性": "قَائِمُ الزَّوَايَا, مُتَعَامِد (لَهُ مَجْمُوعَةُ مَحَاوِرَ مُتَعَامِدَة؛ يَلْتَقِي بِزَوَايَا قَائِمَة) / مُتَعَامِدٌ إِحْصَائِيًّا (غير مرتبط إحصائياً) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث)",
 "直伝": "انْتِقَال مُبَاشِر (آلية انتقال ينتقل فيها العامل المعدي مباشرة إلى الجسم عن طريق اللمس أو العض أو التقبيل أو الجماع أو عن طريق قطرات تدخل العين أو الأنف أو الفم)",
