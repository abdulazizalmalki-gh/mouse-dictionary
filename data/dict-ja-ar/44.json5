 "肘": "كُوع, مِرْفَق / كُوعٌ",
 "肘当て": "واقي كوع (ملابس واقية تتكون من وسادة تلبس فوق الكوع من قبل لاعبي كرة القدم والهوكي)",
 "肘掛": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "肘掛け": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "肘掛け椅子": "كُرْسِيّ ذُو ذِرَاعَيْن, أَرِيكَة (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "肘木": "شَرِيحَة",
 "肘鉄": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "肘鉄砲": "دفع بالمرفق (التدافع باستخدام المرافق)\nمثال: الدفع بالمرفق مخالفة في كرة السلة / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "肘関節": "مرفق, مفصل المرفق (مفصل رزي بين الساعد والعضد والمفصل المقابل في الطرف الأمامي لذوات الأربع)",
 "肘頭": "نَاتِئ مِرْفَقِيّ, طَرَف الْمِرْفَق",
 "肛門": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "肛門外科": "طب المستقيم (فرع الطب المعني بتشخيص وعلاج اضطرابات القولون أو المستقيم أو الشرج)",
 "肛門学": "طب المستقيم (فرع الطب المعني بتشخيص وعلاج اضطرابات القولون أو المستقيم أو الشرج)",
 "肛門性交": "جِمَاع شَرَجِيّ (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "肛門括約筋": "مصرة الشرج (العضلة العاصرة للشرج)",
 "肛門期": "المرحلة الشرجية ((التحليل النفسي) المرحلة الجنسية والاجتماعية الثانية لنمو الطفل والتي يتم خلالها تعلم التحكم في الأمعاء)",
