 "皆伐": "بَيِّن, حَاسِم (محدّد بوضوح وحدّة في الذهن) / جَلِيّ, وَاضِح (وَاضِح وَمُتَمَيِّز لِلحَوَاسّ؛ سَهْل الإِدْرَاك) / مَقْطُوع الأَشْجَار كُلِّيًّا (أُزيلت جميع أشجاره دفعة واحدة)",
 "皆元": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "皆具": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "皆川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "皆既": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "皆既月蝕": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "皆既月食": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "皆既食": "كسوف كلي (كسوف كما يُرى من مكان يكون فيه الجرم المحجوب مخفياً تماماً)",
 "皆本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "皆様": "الْجَمِيع, كُلّ شَخْص",
 "皆様方": "الْجَمِيع, كُلّ شَخْص",
 "皆殺し": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "皆済": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "皆無": "مَعْدُوم",
 "皆皆": "كُلّ, جَمِيع / كُلّ شَيْء",
 "皆皆様": "الْجَمِيع, كُلّ شَخْص",
 "皆目": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "皇": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "皇后": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "皇后宮": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "皇嗣": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇国": "إِمْبِرَاطُورِيَّة",
 "皇天": "بروفيدنس",
 "皇太后": "إِمْبِرَاطُورَة الأُمّ",
 "皇太子": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇太子妃": "ولية العهد (وريثة أنثى ظاهرة للعرش) / زوجة ولي العهد (زوجة ولي العهد)",
 "皇太子殿下": "سُمُوُّهُ الْمَلَكِيّ, سُمُوَّتُهَا الْمَلَكِيَّة",
 "皇妃": "إِمْبِرَاطُورَة, مَلِكَة / إِمْبْرَاطُورَة, زَوْجَةْ إِمِبْرَاطُور",
 "皇婿": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "皇子": "أَمِير",
 "皇子の命": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇子の尊": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "皇孫": "قَيْصَر, إِمْبْرَاطُور",
 "皇帝": "قَيْصَر, إِمْبْرَاطُور",
 "皇帝ペンギン": "بطريق إمبراطور (أكبر البطاريق؛ بطريق من القارة القطبية الجنوبية)",
 "皇帝教皇主義": "إيراستية (المذهب القائل بأن الدولة لها السيادة على الكنيسة في الأمور الكنسية)",
 "皇弟": "أَخ الْأَصْغَر, أَخ الصَّغِير",
 "皇御国": "إِمْبِرَاطُورِيَّة",
 "皇御孫": "قَيْصَر, إِمْبْرَاطُور",
 "皇族": "مَلَكِيَّة",
 "皇朝": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "皇漢医学": "اَلطِّبّ اَلصِّينِيّ",
 "皇考": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)",
 "皇配": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "皎々": "لَامِع, نَيِّر / مُسْتَنِير",
 "皓々": "لَامِع, نَيِّر / مُسْتَنِير",
 "皓礬": "كبريتات الزنك (مسحوق عديم اللون قابل للذوبان في الماء؛ يستخدم كمثبت للون أو لحفظ الخشب أو للترسيب الكهربائي للزنك)",
 "皛納": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "皮": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / قشرة (الغطاء الخارجي الطبيعي للطعام (يزال عادة قبل الأكل))\nمثال: 私は林檎の皮をむくことができる。 — أستطيع تقشير تفاحة. / صَدَفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / صَدَفة, بَيْت (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…) / قِشْر / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\") / قَوْقَعة / قِشْرَة\nمثال: لا تدعها للصدفة. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "皮かぶり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "皮かむり": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "皮なめし": "دِبَاغَة",
 "皮ひも": "زنوبَة, شِبْشِب",
 "皮ふ科": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "皮むき": "تَقْشِير / سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات) / مقلّم (أخصائي تقليم أظافر يقلم الأظافر)",
 "皮むき器": "مِقْشَرَة / كلب (مصطلحات غير رسمية للكلاب) / منادٍ (شخص يقف أمام عرض (كما في الكرنفال) ويلقي خطاب بيع صاخب وملون للزبائن المحتملين)",
 "皮むき機": "مِقْشَرَة / كلب (مصطلحات غير رسمية للكلاب) / منادٍ (شخص يقف أمام عرض (كما في الكرنفال) ويلقي خطاب بيع صاخب وملون للزبائن المحتملين)",
 "皮をはぐ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮をむく": "قَشَّرَ / قِشْرَة, قِشْر",
 "皮を剝く": "قَشَّرَ / قِشْرَة, قِشْر",
 "皮を剝ぐ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮を剥く": "قَشَّرَ / قِشْرَة, قِشْر",
 "皮を剥ぐ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮フ科": "طِبّ الأَمْرَاض الجِلْدِيَّة (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "皮下": "تحت الجلد (متعلق بالمنطقة الواقعة تحت البشرة أو يقع فيها)\nمثال: إبرة تحت الجلد",
 "皮下組織": "تحت الأدمة (طبقة من الخلايا تفرز الجليد الكيتيني في المفصليات مثلاً)",
 "皮冠": "تضيق القلفة, شبم (ضيق غير طبيعي في القلفة يمنع تراجعها فوق الحشفة)",
 "皮切り": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "皮剝": "سلخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮剝ぎ": "سلخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮剥": "سلخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮剥き": "تَقْشِير / سكين تقشير (سكين حاد صغير يستخدم في تقشير الفواكه أو الخضروات) / مقلّم (أخصائي تقليم أظافر يقلم الأظافر)",
 "皮剥ぎ": "سلخ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "皮多": "إِتَا",
 "皮屑": "ثائرة, غضب (شعور بالغضب والعداء) / قشور جلد الحيوان, وَبَر (قشور صغيرة من جلود الحيوانات أو شعرها أو ريش الطيور يمكن أن تسبب تفاعلات تحسسية لدى بعض الناس)\nمثال: ثارت ثائرته",
 "皮層": "قشرة العدسة (النسيج الذي يحيط بنواة العدسة) / قشرة مخية (طبقة الخلايا العصبية غير الميالينية (المادة الرمادية) التي تشكل قشرة المخ) / قشرة (النسيج المكون للطبقة الخارجية لعضو أو هيكل في النبات أو الحيوان)",
 "皮弁": "رَفْرَف",
 "皮田": "إِتَا",
 "皮疹": "طَفْح, طَفْح جِلْدِيّ",
 "皮癬": "جَرَب (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "皮癬ダニ": "سوسة الجرب (سوس مبيض يهاجم جلد البشر والحيوانات الأخرى)\nمثال: سوس الجرب يسبب الجرب",
 "皮目": "عديسة (واحدة من العديد من المسام البارزة على سيقان النباتات الخشبية التي تسمح بتبادل الغازات بين الغلاف الجوي والأنسجة الداخلية)",
 "皮相": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / سَطْحِيّ",
 "皮相的": "سَطْحِيّ",
 "皮紐": "زنوبَة, شِبْشِب",
 "皮紙": "رَقّ",
 "皮細工": "مصنوعات جلدية (عمل مصنوع من الجلد)",
 "皮肉": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء / مُفَاجِئ / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "皮肉なことに": "بتهكم, بسخرية (بطريقة ساخرة) / للمفارقة, من السخرية أن (على عكس الخطة أو التوقع)\nمثال: بدأت بتقليده بسخرية",
 "皮肉る": "هجا",
 "皮肉屋": "ساخر, متهكم (فكاهي يستخدم السخرية والتهكم والغمز لانتقاد الرذائل أو الحماقات)",
 "皮脂": "إفراز دهني, زهم (الإفراز الزيتي للغدد الدهنية؛ مع العرق يرطب ويحمي الجلد)",
 "皮脂腺": "غُدَّة دُهْنيّة",
 "皮膚": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
