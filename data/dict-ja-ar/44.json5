 "病身": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم)",
 "病院": "مُسْتَشْفًى, مَارِسْتَان (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
 "病院船": "سفينة مستشفى (سفينة بنيت لتكون مستشفى؛ تستخدم للجرحى في زمن الحرب)",
 "病院車": "سَيَّارَة إِسْعَاف (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "病難": "مُعَانَاة",
 "病魔": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "症": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "症例": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "症候": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "症候学": "عِلْم اَلْأَعْرَاض (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "症候群": "مُتَلَازِمَة, أَعْرَاض",
 "症状": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "痒い": "مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)",
 "痒み": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
