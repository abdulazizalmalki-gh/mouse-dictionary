 "田畑": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "田畠": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "田端": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "田舎": "ريف, منطقة ريفية (منطقة خارج المدن والبلدات)\nمثال: تغنى شعره بوتيرة الحياة الهادئة في الريف / مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "田舎くさい": "رَيْفِيّ, قَرَوِيّ",
 "田舎っぺ": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "田舎っぽい": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها) / إقليمي, ريفي (مكون من أو مرتبط بمقاطعة أو إقليم) / فلاح, قروي (شخص من الريف) / رئيس إقليمي ((الكنيسة الكاثوليكية) مسؤول مسؤول عن مقاطعة كنسية يعمل تحت الرئيس العام للرهبنة)\nمثال: ريفي ومساير للأعراف بعمق",
 "田舎っ兵衛": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "田舎気質": "خُشُونَة, رِيفِيَّة (صفة كون الشخص ريفياً أو فجاً)",
 "田舎紳士": "أقطاعي, إسكواير (مالك أرض ريفي إنجليزي) / مرافق الفارس (نبيل شاب مرافق لفارس) / مرافق السيدات (رجل يرافق امرأة)",
 "田舎者": "مُوَاطِن (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "田舎育ち": "خَشِن, رِيفِيُّ النَّشْأَةِ (فظّ وغير مهذّب؛ نشأ في الريف)",
 "田舎臭い": "رَيْفِيّ, قَرَوِيّ",
 "田舎風": "رَيْفِيّ, قَرَوِيّ",
 "田芥": "حوذان سام, حوذان كرفسي الأوراق (عشب حولي ينمو في الأماكن السبخة)",
 "田芥子": "حوذان سام, حوذان كرفسي الأوراق (عشب حولي ينمو في الأماكن السبخة)",
 "田荘": "أَرْض زِرَاعِيَّة (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "田薯": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "田虫": "سَعْفَة, قَرَع",
 "田計里": "أبو طيط, زقزاق شامي (زقزاق متوج كبير من العالم القديم له دلايات ومهاميز)",
 "田貴": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "田起こし": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "田起し": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "田辺": "تانابي, تانابه / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "田部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "田野": "رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "田鍬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "田鳧": "أبو طيط, زقزاق شامي (زقزاق متوج كبير من العالم القديم له دلايات ومهاميز)",
 "田鶴": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "田鼈": "بق الماء العملاق (بق مائي كبير ذو أجزاء فم ثاقبة وماصة؛ يتغذى على الأسماك الصغيرة)",
 "田鼠": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة. / جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم) / فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "由": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "由ありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "由あり気": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "由って来る": "إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "由なき": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "由なし事": "هُرَاء, لَغْو",
 "由井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "由姫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "由来": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / أَصْلًا",
 "由来書": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "由来書き": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "由無き": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "由無し事": "هُرَاء, لَغْو",
 "由田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "由緒": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "由緒ある": "جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَهِيب, وَقُور (مثير للإعجاب والتبجيل بسبب عراقته وقِدَمه)",
 "由縁": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "甲": "دِرْع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع. / خُوذَة, بَيْضَة / دِرْع, صَدَفَة (غطاء خارجي صلب لبعض الكائنات الحية مثل المفصليات والسلاحف) / مشط القدم (جزء الحذاء أو الجورب الذي يغطي قوس القدم) / قوس القدم, مشط القدم (قوس القدم) / مُدَّعٍ, الْمُدَّعِي",
 "甲の薬は乙の毒": "مَصَائِبُ قَوْمٍ عِنْدَ قَوْمٍ فَوَائِدُ",
 "甲イカ": "حَبَّار",
 "甲乙": "تَمْيِيْز",
 "甲介": "مَحَارَة ((في التشريح) بنية تشبه الصدفة في شكلها)",
 "甲兵": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "甲冑師": "صانع أسلحة (مُصنِّع للأسلحة النارية) / صانع أسلحة, مسؤول تسليح (جندي مجند مسؤول عن صيانة الأسلحة الصغيرة والمدافع الرشاشة وما إلى ذلك) / صانع الأسلحة, صانع الدروع (عامل ماهر في صنع الدروع أو الأسلحة)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير",
 "甲子": "جرذ الخشب (أي من القوارض الصغيرة قصيرة الذيل المتنوعة في نصف الكرة الشمالي، تتميز بفراء ناعم رمادي من الأعلى وأبيض من الأسفل مع ذيول مكسوة بالفراء وآذان كبيرة؛…)",
 "甲所": "مَرْبِط الْفَرَس",
 "甲掛け": "عقاب الممر (شكل من أشكال العقاب يُجبر فيه الشخص على الركض بين صفين من الرجال يواجهون بعضهم البعض ومسلحين بهراوات أو سياط لضرب الضحية) / قفاز طويل (قفاز بكم طويل) / قفاز مدرع (قفاز من الجلد المدرع؛ يحمي اليد) / تحدي, قفاز التحدي (عرض أو قبول تحد)\nمثال: رمى قفاز التحدي",
 "甲斐": "تَسَبَّب / نَتِيجَة",
 "甲斐あって": "بِفَضْل, بِسَبَبِ",
 "甲斐がない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "甲斐が無い": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "甲斐ない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "甲斐なし": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً) / انْعِدَام القِيمَة (صفة كون الشيء بلا فائدة عملية)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "甲斐性": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة) / دهاء, سعة الحيلة (القدرة على التعامل بدهاء مع المشاكل غير العادية)\nمثال: رجل ذو دهاء عظيم",
 "甲斐無い": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "甲斐無し": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً) / انْعِدَام القِيمَة (صفة كون الشيء بلا فائدة عملية)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "甲斐田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "甲斐甲斐しい": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "甲板": "ظَهْر, سَطْح (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "甲板いす": "كرسي الشاطئ, كرسي سطح السفينة (كرسي قابل للطي للاستخدام في الهواء الطلق؛ يدعم إطار خشبي قطعة من القماش)",
 "甲板椅子": "كرسي الشاطئ, كرسي سطح السفينة (كرسي قابل للطي للاستخدام في الهواء الطلق؛ يدعم إطار خشبي قطعة من القماش)",
 "甲板渡し": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "甲殻": "دِرْع, صَدَفَة (غطاء خارجي صلب لبعض الكائنات الحية مثل المفصليات والسلاحف)",
 "甲殻類": "قشريات (أي مفصلي مائي بشكل رئيسي له عادة جسم مقسم وهيكل خارجي كيتيني) / قشري (من أو ينتمي إلى طائفة القشريات)",
 "甲烏賊": "حَبَّار",
 "甲状せんしゅ": "تضخم الغدة الدرقية, دراق (تضخم غير طبيعي للغدة الدرقية)",
 "甲状腺": "درقي (يوحي بوجود اضطراب في الغدة الدرقية) / درقي (من أو يتعلق بالغدة الدرقية) / غدة درقية (تقع بالقرب من قاعدة الرقبة)\nمثال: شخصية درقية",
 "甲状腺ホルモン": "هرمون الغدة الدرقية (أي من عدة مركبات وثيقة الصلة تنتجها الغدة الدرقية وتكون نشطة استقلابياً)",
 "甲状腺刺激ホルモン": "الهرمون المنبه للدرقية, ثيروتروبين (هرمون الغدة النخامية الأمامية الذي يحفز وظيفة الغدة الدرقية)",
 "甲状腺機能亢進症": "الانسمام الدرقي, فرط نشاط الغدة الدرقية (غدة درقية مفرطة النشاط؛ إنتاج مفرط مرضياً لهرمونات الغدة الدرقية أو الحالة الناتجة عن الإنتاج المفرط لهرمونات الغدة الدرقية)",
 "甲状腺機能低下症": "قُصُور اَلدَّرَقِيَّة",
 "甲状腺炎": "التهاب الغدة الدرقية (التهاب الغدة الدرقية)",
 "甲状腺腫": "تضخم الغدة الدرقية, دراق (تضخم غير طبيعي للغدة الدرقية)",
 "甲状軟骨": "تفاحة آدم, غضروف درقي (أكبر غضروف في الحنجرة)",
 "甲皮": "دِرْع, صَدَفَة (غطاء خارجي صلب لبعض الكائنات الحية مثل المفصليات والسلاحف)",
 "甲種": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "甲虫": "خنفساء وحيد القرن (أي من خنافس كبيرة استوائية بشكل رئيسي متنوعة لها قرون على الرأس؛ آفة على جوز الهند) / خُنْفُسَاء",
 "甲虫類": "خُنْفُسَاء",
 "甲蟹": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "甲蠃": "قُنْفُذ البَحْر",
 "甲走った": "حَادّ, صَارِخ (ذو لون ساطع بشكل مفرط وصارخ) / حَادّ, صَاخِب (يُصِرُّ بِحِدَّةٍ عَلَى أَنْ يُسْمَع) / حَادّ, صَرِير (ذو نبرة عالية وحادَّة أو يُصدر نغمات كذلك)",
 "甲野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "甲鉄": "دِرْع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "甲鉄板": "تصفيح, درع صفيحي (صفيحة فولاذية مقواة خصيصاً تستخدم لحماية التحصينات أو المركبات من نيران العدو)",
 "甲高い": "حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "申": "سَعْدَان, قِرْد",
 "申しあげる": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "申しつける": "لقَّن",
 "申しにくい": "أَنَا آسِف, أَنَا آسِفَة",
 "申しよう": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "申しわけ": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申しわけありません": "أَنَا آسِف, أَنَا آسِفَة / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "申しわけない": "أَنَا آسِف, أَنَا آسِفَة\nمثال: 申し訳ないけど、できません。 — أنا آسف لكن ذلك مستحيل. / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "申し上げる": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "申し付ける": "لقَّن",
 "申し伝える": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي.",
 "申し入れ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "申し入れる": "اِقْتَرَحَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / خَطَبَ, طَلَبَ يَد (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد)\nمثال: اقترح سامي المساعدة.",
 "申し入れ書": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "申し出": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "申し出で": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "申し出る": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "申し出人": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申し出者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申し分": "شِكَايَة, شَكْوَى / دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "申し分け": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申し分ない": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "申し分のない": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "申し分の無い": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "申し分無い": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "申し受ける": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "申し合せる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "申し合わせ": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "申し合わせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "申し子": "رَبَّانِيّ, مِنْ عِنَايَةِ السَّمَاء (مُنَاسِبٌ أَوْ مَحْظُوظٌ بِشَكْلٍ اسْتِثْنَائِيٍّ كَأَنَّمَا بِتَدَخُّلٍ إِلَهِيٍّ) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "申し様": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "申し添える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "申し渡す": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "申し立て": "تَصْرِيح, بَيَان",
 "申し立て人": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / طالب الانتصاف, مقدم الالتماس (شخص يلتمس من المحكمة رفع مظلمة أو استرداد حق)\nمثال: مستعطف لرضاها",
 "申し聞かせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "申し訳": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申し訳ありません": "أَنَا آسِف, أَنَا آسِفَة / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "申し訳がたたない": "أَنَا آسِف, أَنَا آسِفَة",
 "申し訳が立たない": "أَنَا آسِف, أَنَا آسِفَة",
 "申し訳け": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申し訳ございません": "أَنَا آسِف, أَنَا آسِفَة\nمثال: 大変ご不自由をおかけして申し訳ございません。 — أعتذر عن ما سببته لك من متاعب. / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "申し訳ない": "أَنَا آسِف, أَنَا آسِفَة\nمثال: 申し訳ないけど、できません。 — أنا آسف لكن ذلك مستحيل. / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "申し訳なさそう": "اعتذاري, معتذر (يقدم أو يعبر عن اعتذار)\nمثال: مذكرة اعتذار",
 "申し訳無い": "أَنَا آسِف, أَنَا آسِفَة\nمثال: 申し訳ないけど、できません。 — أنا آسف لكن ذلك مستحيل. / شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "申し訳程度": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "申し越し": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "申し越す": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "申し込み": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "申し込み書": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "申し込み者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申し込み順": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "申し込む": "اِقْتَرَحَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / خَطَبَ, طَلَبَ يَد (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً فتزوج\" لمن يطلب شيئاً صغيراً فيحصل على شيء أكبر؛ يشير إلى فعل التحدث إلى الجمهور بغرض إلقاء خطاب، وعظ، أو إرشاد)\nمثال: اقترح سامي المساعدة.",
 "申し述べる": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "申し送り": "رِسَالَة, خَبَر / تسليم, تمرير (عملية تمرير شيء ما لشخص آخر)",
 "申し送る": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "申し遣わす": "سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "申し開き": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "申し開らく": "شَرَحَ (شَرَّحَ، قَطَّعَ قِطَعَاً رِقَاقاً؛ فَسَّرَ، أَوْضَحَ، بَيَّنَ) / فَسَّرَ / أَبَانَ\nمثال: شكرا على الشرح.",
 "申し難い": "أَنَا آسِف, أَنَا آسِفَة",
 "申す": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "申すまでもない": "بَدِيهِيّ, بَدَهِيّ",
 "申すまでもなく": "بُوضُوح",
 "申す迄もなく": "بُوضُوح",
 "申す迄も無く": "بُوضُوح",
 "申上げる": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "申付ける": "لقَّن",
 "申伝える": "أَبْلَغَ, نَقَلَ (أَكْثَرُ بَلَاغَة)\nمثال: أبلغ توم تحياتي.",
 "申入": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "申出": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "申出で": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "申出る": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "申出人": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申出者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申分": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申分け": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申受ける": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "申合せ": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "申告": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "申告書": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "申告者": "جازم, مؤكِّد (شخص يدعي قول الحقيقة) / مُعلن\nمثال: مؤكد جريء",
 "申命記": "سِفْر التَثْنِيَة, سِفْر تَثْنِيَةِ الاِشْتِرَاع (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "申毒": "الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند.",
 "申渡す": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "申状": "رثاء, عويل (صرخة حزن وأسى) / عريضة دعوى, لائحة شكوى ((المملكة المتحدة) بيان مكتوب بأسباب الشكوى يقدم إلى محكمة قانونية لطلب رفع الظلم)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح",
 "申立": "تَصْرِيح, بَيَان",
 "申立て": "تَصْرِيح, بَيَان",
 "申立人": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / طالب الانتصاف, مقدم الالتماس (شخص يلتمس من المحكمة رفع مظلمة أو استرداد حق)\nمثال: مستعطف لرضاها",
 "申聞かせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "申訳": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "申請": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "申請人": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申請者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "申越し": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
