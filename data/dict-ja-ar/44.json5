 "異種": "غير متجانس, متباين (مشتق من كائنات حية من أنواع مختلفة ولكن ذات صلة) / غير متنادد (لا يتوافق في الهيكل أو الأصل التطوري)\nمثال: طعم غير متجانس",
 "異種交配": "تزاوج بين الأعراق (التكاثر بين أبوين من أعراق مختلفة) / تزاوج خلطي, تهجين ((في الوراثة) فعل خلط أنواع أو أصناف مختلفة من الحيوانات أو النباتات لإنتاج هجائن)",
 "異種同形": "تَسَاوِي الشَّكْل, تَمَاثُل بَلُّورِيّ ((في علم الأحياء) تشابه أو تطابق الشكل أو الهيئة أو البنية)",
 "異種族混交": "تَمَازُج الأَجْنَاسِ",
 "異種移植": "زراعة أعضاء مغايرة (إجراء جراحي يتم فيه نقل أنسجة أو أعضاء كاملة من نوع بيولوجي إلى نوع آخر)",
 "異端": "هَرْطَقَة, بِدْعَة",
 "異端児": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "異端審問": "مَحَاكِمُ التَّفْتِيش",
 "異端者": "وَثَنِيّ / وَثَنِيّ, وَثَنِيَّة / خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "異端視": "هَرْطَقَة, بِدْعَة",
 "異系交配": "زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "異能": "قُوَى عُظْمَى",
 "異能者": "حيوان متحول, طافر (حيوان خضع لطفرة جينية) / طافر, متحول (يميل للخضوع لطفرة أو ناتج عنها) / طافر, طفرة ((في علم الأحياء) كائن حي له خصائص ناتجة عن تغيير كروموسومي)\nمثال: جين طافر",
 "異臭": "نَتَانَة",
 "異色": "فَرِيد, فَذّ",
 "異見": "اِعْتَرَاض / اِعْتِرَاض / تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "異言": "لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة) / لسان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "異論": "اِعْتَرَاض / اِعْتِرَاض",
 "異議": "اِعْتَرَاض / اِعْتِرَاض",
 "異議の申し立て": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه) / اِعْتِرَاض, اِحْتِجَاج\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "異議の申立て": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه) / اِعْتِرَاض, اِحْتِجَاج\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "異議申し立て": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "異議申立": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "異議申立て": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "異象": "بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "異質": "مُخْتَلِف / آٰخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "異質性": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "異邦": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "異邦人": "أَجْنَبِيّ, أَجْنَبِيَّة / غَرِيب, غَرِيبَة / أَجْنَبِيّ / أُمِّي",
 "異郷": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "異郷人": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "異音": "ألوفون, بديل صوتي ((لغويات) أي من الأشكال المختلفة صوتياً لنفس الفونيم)",
 "異類": "اِخْتِلَاف",
 "異食": "إم (وحدة خطية (1/6 بوصة) تستخدم في الطباعة) / القو, شهوة الغرائب (اضطراب في الأكل، يتكرر عند الأطفال، يتم فيه تناول مواد غير مغذية بشكل مستمر)",
 "異食症": "إم (وحدة خطية (1/6 بوصة) تستخدم في الطباعة) / القو, شهوة الغرائب (اضطراب في الأكل، يتكرر عند الأطفال، يتم فيه تناول مواد غير مغذية بشكل مستمر)",
 "畳": "تكراري (يتسم بالتكرار)",
 "畳みかける": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "畳みじわ": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "畳み掛ける": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "畳み皴": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "畳み皺": "خنجر الكريس (خنجر ماليزي ذو نصل متموج) / تجعد, ثنية (انخفاض أو طية طفيفة في نعومة السطح) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "畳み込み": "التفاف, تلافيف (عملية اللف أو اللي أو الالتفاف معاً) / تلفيف (طية محدبة أو ارتفاع في سطح الدماغ) / تلفيف, دوامة (شكل شيء يدور بسرعة)",
 "畳み込む": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "畳む": "طَوَى / طَيَّة / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "畳句": "تَكْرَار, إِعَادَة",
 "畳成語": "تَكْرَارِيّ (يتسم بالتكرار المتتابع)",
 "畳椅子": "كرسي قابل للطي, كرسي منطوي (كرسي يمكن طيه بشكل مسطح للتخزين)",
 "畳目": "طَوَى / طَيَّة",
 "畸形": "تَشَوُّه شَكْلِيّ",
 "疆埸": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)",
 "疋田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "疎": "ضَئِيل / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / بشكل غير كامل, ناقصاً (ليس لدرجة كاملة أو تامة)\nمثال: كلمات مفهومة بشكل غير كامل",
 "疎々しい": "عدائي, غير ودود (غير ميال للصداقة أو الود) / صعب الاستخدام, غير صديق للمستخدم (ليس سهلاً في الفهم أو الاستخدام) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً) / غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)\nمثال: برود في التصرف غير ودود",
 "疎い": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / جَاهِل",
 "疎か": "متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون / نَاهِيكَ عَن, هٰذَا عَدَا عَنْ / متهاون, مقصّر (يتميز بالإهمال وعدم الاكتراث غير المبرر)\nمثال: آباء مهملون",
 "疎かにする": "أَهْمَلَ / إِهْمَال",
 "疎ましい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك) / غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بَغِيض, كَرِيه المُعَاشَرَة (غير سار في التعامل معه)\nمثال: موقف بغيض",
 "疎む": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "疎ら": "ضَئِيل",
 "疎んじる": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "疎んずる": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "疎外": "تنفير (فعل التنفير؛ فعل التسبب في العداء) / نقل الملكية ((قانون) النقل الطوعي والمطلق لسند الملكية وحيازة الممتلكات العقارية من شخص لآخر) / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)\nمثال: سلوكه نفر الطلاب الآخرين",
 "疎意": "تنفير (فعل التنفير؛ فعل التسبب في العداء) / نقل الملكية ((قانون) النقل الطوعي والمطلق لسند الملكية وحيازة الممتلكات العقارية من شخص لآخر) / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)\nمثال: سلوكه نفر الطلاب الآخرين",
 "疎慢": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)",
 "疎放": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "疎明": "تَفْسِير, شَرْح",
 "疎水": "قَنَاة / رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء) / كاره للماء, نافر من الماء (يفتقر إلى الألفة مع الماء؛ يميل إلى صد الماء وعدم امتصاصه؛ يميل لعدم الذوبان في الماء أو الاختلاط به)",
 "疎水性": "رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء) / كاره للماء, نافر من الماء (يفتقر إلى الألفة مع الماء؛ يميل إلى صد الماء وعدم امتصاصه؛ يميل لعدم الذوبان في الماء أو الاختلاط به)",
 "疎漏": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد)",
 "疎略": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "疎疎しい": "عدائي, غير ودود (غير ميال للصداقة أو الود) / صعب الاستخدام, غير صديق للمستخدم (ليس سهلاً في الفهم أو الاستخدام) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً) / غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)\nمثال: برود في التصرف غير ودود",
 "疎通": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "疎遠": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)",
 "疎開": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "疎開者": "مُرَحَّل",
 "疎隔": "تنفير (فعل التنفير؛ فعل التسبب في العداء) / نقل الملكية ((قانون) النقل الطوعي والمطلق لسند الملكية وحيازة الممتلكات العقارية من شخص لآخر) / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)\nمثال: سلوكه نفر الطلاب الآخرين",
 "疎雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "疏": "تَفْسِير, شَرْح",
 "疏水": "قَنَاة",
 "疏注": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "疏註": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "疏雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "疑": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "疑い": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "疑い深い": "شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه)\nمثال: 田舎の人々は外部の人に対して昔から疑い深い。 — يشتبه الريفيون عادةً بالغرباء.",
 "疑う": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "疑ぐる": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "疑り": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "疑り深い": "شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه)",
 "疑る": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "疑わしい": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة) / مُبْدَئِيّ, مُتَرَدِّد (غير مستقرّ في الرأي؛ مُتذبذب)",
 "疑似": "زَائِف المَظْهَر, شِبْه ((غالباً يُستخدم في التركيبات) غير حقيقي لكنه يحمل مظهر الحقيقي) / دجال, محتال (شخص يقدم ادعاءات خادعة) / مشتبه به, مشكوك فيه (يُعتقد أنه محتمل)\nمثال: لص مشتبه به",
 "疑似体験": "مُحَاكَاة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "疑似体験療法": "علاج بالتعرض (شكل من أشكال العلاج السلوكي يواجه فيه الناجي المشاعر أو الرهاب أو القلق بشأن حدث صادم ويعيشه مرة أخرى في حالة العلاج)",
 "疑似的": "زَائِف المَظْهَر, شِبْه ((غالباً يُستخدم في التركيبات) غير حقيقي لكنه يحمل مظهر الحقيقي) / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "疑似相関": "ارتباط زائف (ارتباط بين متغيرين لا ينتج عن أي علاقة مباشرة بينهما بل من علاقتهما بمتغيرات أخرى)",
 "疑似科学": "علم زائف (نشاط يشبه العلم ولكنه يعتمد على افتراضات مغلوطة)",
 "疑似餌": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "疑問": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
