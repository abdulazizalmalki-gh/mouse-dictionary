 "異性核": "أيزومر, متصاوغ (مركب يوجد في أشكال ذات ترتيبات ذرية مختلفة ولكن لها نفس الوزن الجزيئي)",
 "異性装": "تخنث, لبيسة الجنس الآخر (ممارسة اعتماد ملابس أو أسلوب أو الدور الجنسي للجنس الآخر)",
 "異所": "في مكان آخر (في أو إلى مكان آخر)\nمثال: ذهب إلى مكان آخر / بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "異所性": "توطن متباين (وجود الكائنات الحية ذات الصلة في مناطق جغرافية منفصلة دون تداخل)",
 "異才": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "異教": "وَثَنِيَّة",
 "異教徒": "وَثَنِيّ / وَثَنِيّ, جَاهِل / وَثَنِيّ, وَثَنِيَّة",
 "異数": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "異数体": "مغاير الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على عدد كروموسومات ليس مضاعفاً زوجياً لعدد الكروموسومات الأحادي لذلك النوع)",
 "異数性": "اختلال الصيغة الصبغية (شذوذ ينطوي على عدد كروموسومات ليس مضاعفاً دقيقاً للعدد الفرداني (مجموعة كروموسومات واحدة غير مكتملة))",
 "異文": "اِخْتِلَاف",
 "異文化交流": "عبر الثقافات (يتعامل مع ثقافتين أو أكثر أو يقارن بينهما)\nمثال: مسح عبر الثقافات",
 "異文化間": "عبر الثقافات (يتعامل مع ثقافتين أو أكثر أو يقارن بينهما)\nمثال: مسح عبر الثقافات",
 "異方": "غير موحد الخواص, متباين الخصائص (تتغير خصائصه بتغير الاتجاه)\nمثال: بلورات متباينة الخواص",
 "異方性": "تباين الخواص (خاصية كون الشيء متباين الخواص؛ له قيمة مختلفة عند قياسه في اتجاهات مختلفة)",
 "異方性度": "فَا",
 "異星人": "غَرِيب, غَرِيبَة / أَجْنَبِيّ, أَجْنَبِيَّة",
 "異朝": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "異材": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة / تلوث, ملوث (مادة تسبب التلوث)",
 "異極鉱": "كالامين, هيميمورفيت (معدن أبيض؛ خام شائع للزنك)",
 "異様": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "異母姉妹": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
