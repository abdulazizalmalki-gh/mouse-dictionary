 "罰を与える": "عَاقَبَ, قَاصَصَ",
 "罰則": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / قانون العقوبات (المدونة القانونية التي تحكم الجرائم وعقوباتها)",
 "罰当たり": "بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "罰打": "جَزَاء",
 "罰点": "س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف العربية يسبقه حرف النُوْن ويلية حرف العَيْن وهو الحرف الثاني عشر بالترتيب…؛ تنقل المضارع من الحال إلى الاستقبال)",
 "罰糞": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "罰金": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "罰金刑": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "署": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "署する": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "署名": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "署名者": "موقع (شخص يوقع على وثيقة ويلتزم بها) / مستخدم لغة الإشارة (شخص يمكنه استخدام لغة الإشارة للتواصل)",
 "署員": "عضو هيئة, موظف (موظف يكون عضواً في هيئة عاملين (خاصة عضو في الطاقم الذي يعمل لرئيس الولايات المتحدة))",
 "署長": "شَيْخ, قَائِد",
 "罵り": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "罵り言葉": "سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب) / حشو, زيادة لفظية (كلمة أو عبارة لا تحمل معنى مستقلاً ولكنها تضاف لإكمال جملة أو سطر شعري)\nمثال: تم حذف الشتائم",
 "罵る": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "罵倒": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "罵声": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "罵言": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "罵詈": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "罵詈讒謗": "إِهَانَة, سَبّ (تعبير وقح يهدف إلى الإساءة أو الأذى) / تَشْوِيه السُّمْعَة, تَلْطِيخ السُّمْعَة (تشهير افترائي)\nمثال: عندما ارتكب الطالب خطأ غبياً لم يوفر له أي شتيمة",
 "罷めさせる": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "罷める": "اِسْتَقَالَ",
 "罷り出る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "罷り越す": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "罷り間違う": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "罷免": "إِقَالَة",
 "罷業": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "罹る": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "罹患者": "شَهِيد (من يعاني من أجل مبدأ) / عَلِيل, مَرِيض (شخص يعاني من مرض)",
 "罹災": "مُعَانَاة",
 "罹災民": "ضَحِيَّة / أُضْحِيَّة",
 "罹災者": "ضَحِيَّة / أُضْحِيَّة",
 "罹病": "إِمْرَاض, فَسَاد (صفة كون الشيء غير صحي وضاراً بشكل عام) / سوداوية, كآبة مرضية (حالة ذهنية كئيبة أو غير صحية بشكل غير طبيعي) / مُعَدَّل المَرَض, نِسْبَة الِاعْتِلَال (معدل الحدوث النسبي لمرض معين)\nمثال: خوفه من البقاء وحيداً يقارب الحالة المرضية",
 "羃": "أُسّ",
 "羃指数": "أُسّ",
 "羃数": "أُسّ",
 "羃級数": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "羅": "لَاتِينِيّ, الرُّومِيَّة (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية) / لَاتِينِيّ, الرُّومِيّ (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية)\nمثال: العديد من الكلمات الإنجليزية أصلها لاتيني.",
 "羅列": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / ترقيم, قائمة مرقمة (قائمة مرقمة)\nمثال: استمر العد لعدة ساعات",
 "羅北": "الشَّمَال, الشَّمَال المِغْنَاطِيسِيّ (الاتجاه الذي تشير إليه إبرة البوصلة)",
 "羅府": "لُوس أَنْجِلِس",
 "羅漢": "بوذا (الشخص الذي حقق حالة من الاستنارة الكاملة)",
 "羅盤": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "羅語": "لَاتِينِيّ, الرُّومِيَّة (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية) / لَاتِينِيّ, الرُّومِيّ (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية)\nمثال: العديد من الكلمات الإنجليزية أصلها لاتيني.",
 "羅針儀": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "羅針盤": "بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "羅針盤座": "حُقّ, علبة مجوهرات أثرية (صندوق صغير استخدمه الإغريق القدماء لحفظ الأدوية) / حُقّة (فاكهة لنباتات مثل لسان الحمل؛ كبسولة يسقط جزؤها العلوي عند إطلاق البذور)",
 "羆": "دُبّ أَسْمَر",
 "羇旅": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "羈": "عِذَار",
 "羈旅": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ يَحْصونَ الأعْمالَ وَيُدَوِّنونَها ، عبس آية 15 جمع: سَفَرَةٌ) / اِنْتَقَلَ, سَارَ / مُسَافِرَة, رِحْلَة\nمثال: سافر سامي وليلى.",
 "羈束": "غُلّ, أَغْلال",
 "羈絆": "غُلّ, أَغْلال",
 "羈縻": "إحكام, إرفاق (عملية تثبيت الأشياء ببعضها البعض) / أداة تثبيت, مثبت (قيد يربط بشيء ما أو يثبت شيئاً في مكانه)",
 "羊": "خَرُوف / ضَأْن / غَنَم / شاء (أَرَادَ) / حَمَل (رَفَعَ، أَقَلَّ) / خروف\nمثال: إن شاء الله ؛",
 "羊小屋": "حظيرة أغنام, زريبة غنم (حظيرة للأغنام)",
 "羊歯": "سَرْخَس",
 "羊歯植物": "نبات تريدي, نبات وعائي لا زهري (نباتات تحتوي على أنسجة وعائية وتتكاثر عن طريق الأبواغ)",
 "羊毛": "صُوف",
 "羊毛猿": "سَعْدَان صُوفِيّ",
 "羊水": "سُخْد, سَائِل سَلْوِيّ",
 "羊水穿刺": "بزل السلى (استخراج السائل الأمنيوسي من المرأة الحامل (بعد الأسبوع الخامس عشر من الحمل) للمساعدة في تشخيص تشوهات الجنين)",
 "羊皮": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة) / رَقّ",
 "羊皮紙": "رَقّ",
 "羊肉": "لَحْم اَلضَّأْن (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "羊脂": "شحم الضأن (شحم من جسم خروف ناضج)",
 "羊腸": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "羊膜": "سَلى, أَمْنِيُون (جعله يَسْلَو، أي ينسى الهمّ والهجر وغيره مما كان عنده. فرّج همه؛ الشاة ونحوها: نزهى سلاها)",
 "羊膜腔": "تجويف سلوي (التجويف المملوء بالسائل الذي يحيط بالجنين النامي)",
 "羊膜類": "حيوان سلوي (أي عضو من السلويات)",
 "羊質虎皮": "صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق) / حلي تافهة, خردوات (أشياء زخرفية ليس لها قيمة كبيرة)",
 "羊雲": "ركام متوسط (سحابة ركامية على ارتفاع متوسط يبلغ 2 أو 3 أميال)",
 "羊革": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "羊飼い": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "羌": "لغة تشيانغ (لغة تبتية بورمية يتم التحدث بها في سيتشوان)",
 "美": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "美々しい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "美い": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "美しい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "美しさ": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "美ら": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "美丈夫": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "美人": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "美化": "تَجْمِيل / تعظيم, تمجيد (فعل التمجيد (كما في العبادة)) / إضفاء المثالية, مثالية (تصوير شيء ما على أنه مثالي) / مجد (حالة من الشرف الرفيع)\nمثال: تمجيد الله",
 "美名": "ذَرِيعَة, عُذْر",
 "美味": "خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها",
 "美味い": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "美味しい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / جَذَّاب",
 "美味しそう": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "美味ちい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / جَذَّاب",
 "美味佳肴": "خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها",
 "美女桜": "رعي الحمام, فيربينا (أي من النباتات الأمريكية الاستوائية أو شبه الاستوائية العديدة من جنس رعي الحمام تزرع لسنابلها المبهرجة من الزهور متنوعة الألوان)",
 "美妙": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "美姫": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "美婦": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "美学": "استطيقا, علم الجمال ((فن) فرع الفلسفة الذي يتعامل مع الجمال والذوق (مع التركيز على المعايير التقييمية التي تطبق على الفن))\nمثال: افترض علم الجمال التقليدي وجود معايير عالمية وخالدة للقيمة الفنية",
 "美学的": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / استيطيقي, جمالي (يتعلق بموضوع علم الجمال (الاستيطيقا)) / جمالية ((فلسفة) نظرية فلسفية حول ماهية الجميل)\nمثال: الملكات الجمالية",
 "美容": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / تَجْمِيل",
 "美容体操": "تمارين سويدية, جمبازيات (تمارين خفيفة مصممة لتعزيز اللياقة البدنية العامة) / تمرينات سويدية, جمبازيات (ممارسة التمارين الرياضية البسيطة (للياقة))\nمثال: تم توضيح العديد من التمارين السويدية المختلفة في الفيديو",
 "美容外科": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "美容室": "صَالُون تَجْمِيل, مَحَلّ تَجْمِيل (مجلسٌ يجتمع فيه بعض أعيان المجتمع عند أحدهم يناقشون فيه أمور الأدب والفنّ؛ هو المَجْلِس في البيت الذي يستقبلون فيه الضيوف، يسمه البعض غرفة الضيوف أو غرفة الاستقبال أو غرفة الخطار. )\nمثال: لدى زيري صالون حلاقة.",
 "美容家": "أخصائي تجميل, خبير تجميل (شخص يعمل في صالون تجميل)",
 "美容師": "أخصائي تجميل, خبير تجميل (شخص يعمل في صالون تجميل)",
 "美容店": "صالون, صالون تجميل (محل يعمل فيه مصففو الشعر وأخصائيو التجميل)",
 "美容所": "صالون, صالون تجميل (محل يعمل فيه مصففو الشعر وأخصائيو التجميل)",
 "美容整形": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "美容整形外科": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "美容整形手術": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "美容法": "علاج تجميلي (تحسين الجمال الشخصي لشخص ما)",
 "美容液": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "美容術": "تجميل (ممارسة تجميل الوجه والشعر والجلد)",
 "美容院": "صالون, صالون تجميل (محل يعمل فيه مصففو الشعر وأخصائيو التجميل)",
 "美小辞": "ضَئِيل / تَصْغِيرِيّ",
 "美形": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "美徳": "فَضِيلَة / عِفَّة, طَهَارَة",
 "美点": "فَضِيلَة / عِفَّة, طَهَارَة",
 "美白": "تبييض, تفتيح (التغيير إلى لون أفتح)",
 "美的": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / استيطيقي, جمالي (يتعلق بموضوع علم الجمال (الاستيطيقا)) / جمالية ((فلسفة) نظرية فلسفية حول ماهية الجميل)\nمثال: الملكات الجمالية",
 "美神": "الزُّهَرَة, فينوس (اسم للكوكب الثاني قربًا من الشَّمْس، وهو كوكب صخريّ يَملك غلافاً جوياً وغيوماً هائلة السّماكة تَمنع أي أشعة ضوء من سطحه من النفاذ وتتسبب بظاهرة…) / فِينُوس\nمثال: أقطف الزهرة بنفسي.",
 "美禄": "كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "美称": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "美粧院": "صالون, صالون تجميل (محل يعمل فيه مصففو الشعر وأخصائيو التجميل)",
 "美美しい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "美術": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "美術博物館": "غاليري, معرض فني (غرفة أو سلسلة من الغرف حيث يتم عرض الأعمال الفنية)",
 "美術史": "تاريخ الفن (التخصص الأكاديمي الذي يدرس تطور الرسم والنحت)",
 "美術史家": "مُؤَرِّخ الفَنّ, مُؤَرِّخة الفَنّ",
 "美術品": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "美術商": "تاجر فنون (تاجر في الأعمال الفنية التي تتطلب تقييماً جمالياً)",
 "美術学校": "مدرسة فنون (مدرسة متخصصة في الفن)",
 "美術家": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "美術展": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))\nمثال: その美術展は今京都で開かれています。 — يعقد الآن المعرض الفني في كيوتو.",
 "美術展覧会": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "美術工芸": "حرف يدوية, فنون وحرف (فنون التصميم الزخرفي والحرف اليدوية)\nمثال: رعوا الفنون والحرف اليدوية لتشجيع الحرفية في عصر الإنتاج الضخم",
 "美術的": "ذَوَّاقِيّ, فَنِّيّ (يُلبّي المعايير والحساسيات الجمالية) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / فني (يتعلق بالفن أو الفنانين أو يميزهم)\nمثال: خلفيته الفنية",
 "美術監督": "مدير فني (المخرج المسؤول عن الجوانب الفنية لإنتاج مسرحي (الأزياء والمناظر والإضاءة))",
 "美術評論家": "ناقد فني (ناقد للوحات الفنية)",
 "美術運動": "حركة فنية (مجموعة من الفنانين يتفقون على مبادئ عامة)",
 "美術館": "غاليري, معرض فني (غرفة أو سلسلة من الغرف حيث يتم عرض الأعمال الفنية)",
 "美貌": "وسامة (صفة امتلاك ملامح منتظمة ومحددة جيداً (خاصة للرجل))",
 "美質": "فَضِيلَة / عِفَّة, طَهَارَة",
 "美道": "اشتهاء الغلمان, لواط بالأطفال (العلاقات الجنسية بين رجل وصبي (عادة الجماع الشرجي مع الصبي كشريك سلبي))",
 "美酒": "مُرْتَفِع الدَّرَجَة",
 "美醜": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "美青年": "أدونيس ((الأساطير اليونانية) شاب وسيم أحبته كل من أفروديت وبيرسيفوني) / أدونيس, شاب وسيم (أي شاب وسيم)\nمثال: عندما مات أدونيس قضى زيوس بأن يمضي الشتاء في العالم السفلي مع بيرسيفوني والصيف مع أفروديت",
 "美顔術": "تنظيف بشرة, علاج الوجه (عناية بالوجه تتضمن عادةً التنظيف والتدليك ووضع الكريمات التجميلية) / سطحي, وجهي (مكون من أو يخص السطح الخارجي لشيء ما) / وجهي (متعلق بالوجه) / عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)\nمثال: تدليك وجهي",
 "美食主義": "أبيقورية, تلذذ (طبع وعادات الأبيقوري (المحب للملذات))",
 "美食学": "فَنّ اَلْأَكْل (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "美食家": "ذواقة, محب للطعام (شخص مكرس للاستمتاع الحسي المترف (خاصة الطعام والشراب الجيد))",
 "美魔女": "كَهْل / كَهْلَة",
 "美麗": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "羔": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ) / لَحْم اَلضَّأْن, خَرُوف (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: حمل سامي سلاحه.",
 "羚羊": "ظَبْي (الغَزَال ذو القُرُون الحادة، سمي ظبيا لأن قِرْنه يَظْبِي أي يجرح)\nمثال: أبو ظبي هي عاصمة الإمارات العربية المتحدة. / سيرو (ظبي ماعز قصير القرون داكن المعطف يعيش في المناطق الجبلية بجنوب وجنوب شرق آسيا)",
 "羝羊": "كَبْش",
 "羞": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "羞恥": "حياء, خجل (شعور بالخوف من الإحراج)",
 "羞恥心": "حياء, خجل (شعور بالخوف من الإحراج)",
 "羞明": "ألم العين الضوئي, رهاب الضوء (ألم في العين ناتج عن التعرض للضوء الساطع (غالباً ما يرتبط بالمهق)) / رهاب الضوء (خوف مرضي من الضوء)",
 "群": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "群がり": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "群がる": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "群れ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "群れる": "كَوْم",
 "群をなす": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "群を成す": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "群体": "مُسْتَعْمَرَة / مُسْتَعْمَرَة, مُسْتَمْلَكَة",
 "群作用": "عَمَل جَمَاعِيّ (إجراء يتّخذه مجموعة من الناس)",
 "群俗": "الْجَمَاهِير, العَامَّةُ",
 "群像": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "群前置詞": "حرف جر مركب (حرف جر يتكون من مجموعة كلمات تعمل كوحدة واحدة)",
 "群小": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "群居": "أنيسية, حب الاجتماع (صفة كون المرء اجتماعياً — كره البقاء وحيداً)",
 "群山": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "群峰": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال",
 "群島": "أَرْخَبِيل",
 "群游": "سِرْب, مجموعة أسماك (مجموعة كبيرة من الأسماك) / مياه ضحلة (امتداد من المياه الضحلة) / رصيف رملي, مياه ضحلة (ضفة رملية في مسطح مائي تكون مرئية عند الجزر المنخفض)\nمثال: سبح سرب من الأسماك الصغيرة اللامعة بالجوار",
 "群狼": "قطيع ذئاب (مجموعة من الذئاب تصطاد معًا) / زمرة ذئاب (مجموعة من الغواصات تعمل معاً في مهاجمة قوافل العدو)",
