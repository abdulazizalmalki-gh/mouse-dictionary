 "環状交差点": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "環状山": "فَوَّهَةُ الْبُرْكَان, فَوَّهَة / فَوَّهَةُ الْبُرْكَان",
 "環状網": "عُرْوَة, عُقْدَة",
 "環礁": "جزيرة مرجانية (جزيرة تتكون من شعاب مرجانية دائرية تحيط ببحيرة شاطئية)",
 "環節": "جزء, قسم (أحد الأجزاء أو القطع المتعددة التي تتناسب مع غيرها لتكوين جسم كامل) / جُزْء, فَلْقَة (أحد الأجزاء التي ينقسم إليها الشيء بشكل طبيعي)\nمثال: قسم من صنارة الصيد",
 "環節動物": "دودة حلقية (ديدان ذات أجسام أسطوانية مقسمة داخلياً وخارجياً) / حلقي, حلقياتي (يتعلق بـ أو ينتمي إلى أو من خصائص أي من ديدان شعبة الحلقيات)",
 "環視": "رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس)",
 "瓔珞": "قِلَادَة",
 "瓜": "شَمَّام",
 "瓜に爪あり爪に爪なし": "هُنَاكَ, يُوجَدُ",
 "瓜の蔓": "قرع, يقطين (أي كرمة من الفصيلة القرعية تحمل ثماراً ذات قشور صلبة)",
 "瓜二つ": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة) / قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ) / مُتَمَاثِل (ذو خصائص بقيم موحّدة على طول جميع المحاور) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: التوائم المتطابقة هي أحادية البويضة",
 "瓜坊": "خَنْزِير بَرِيّ",
 "瓜生": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "瓜田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "瓜類": "قرعيات (أي نبات من الفصيلة القرعية)",
 "瓠": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة) / قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "瓢": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة) / قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "瓢箪": "دُبَّاء / قَرْع (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "瓣": "بَتَلَة, تُوَيْجَة / صِمَام (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "瓣膜": "صِمَام (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "瓤嚢": "حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة)",
 "瓦": "قِرْمِيدَة, قِرْمِيد / قَرْمَدَ",
 "瓦屋": "مبلط (عامل يضع البلاط)",
 "瓦毛": "حصان أشهب مصفر (حصان ذو لون أسمر مصفر فاتح مع عرف وذيل داكنين) / بوكسكين, جلد الغزال (جلد سويدي ناعم مصفر مصنوع أصلاً من جلد الغزال ولكن الآن عادة من جلد الغنم)",
 "瓦状": "مُتَرَاكِب (مرتّب بحيث تتراكب الحواف كقرميد السقف)",
 "瓦石": "زُبَالَة / نُفَايَات (بقيَّة؛ ما زاد على الحاجة) / قُمَامَة / مُخَلَّفَات\nمثال: توم عامل نفايات. / طُوبَة, لَبِنَة",
 "瓦礫": "أَنْقَاض, رُكام / زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "瓦解": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "瓩米": "كيلوغرام-متر (وحدة شغل تساوي الشغل المبذول بواسطة قوة كيلوغرام واحد تعمل خلال مسافة متر واحد)",
 "瓶": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "瓶入り": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "瓶型": "قَارُورِيّ الشَّكْل (على شكل قارورة)",
 "瓶子": "مرطبان / جَرَّة (اسم للمَرَّة الواحدة من الجَرّ؛ إناء من خَزَف أو صُلْصَال له بطن كبير وعروتان وفمّ واسع)\nمثال: من ترك الجرة مفتوحة؟",
 "瓶詰": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "瓶詰め": "زُجَاجَة (قطعة زُجَاج؛ قِنْدِيل) / قِنِّينَة (وعاء توضع فيه السوائل، ويصنع من مواد مختلفة مثل الزجاج والبلاستيك) / قزازة / بطل / قارورة (وعاء زجاجي توضع فيه السوائل، وله عنق وسدادة) / قُزازة / عَبَّأَ فِي زُجَاجَة / يرضع بواسطَة زجاجَة\nمثال: سرقوا زجاجة نبيذي!",
 "甄": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "甄別": "تَمْيِيْز",
 "甌穴": "حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "甍段": "درجة الطنف, درجة جملونية ((في العمارة) درجة على قمة جدار الجملون)",
 "甎": "طُوبَة, لَبِنَة",
 "甑炉": "فرن (حجرة مغلقة يتم فيها إنتاج الحرارة لتدفئة المباني، أو تدمير النفايات، أو صهر الخامات وتنقيتها، وما إلى ذلك)",
 "甘": "لَذِيذ / شَهِيّ",
 "甘々": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "甘い": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا / رَيًّا, عَبِق / مُتَسَامِح, مُتَسَاهِل (مَيَّال إِلَى التَّسَاهُل والقَبُول) / متسامح, متساهل (يتميز بـأو يميل إلى الاستجابة لرغبات شخص ما) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)\nمثال: أجداد متساهلون / سَاذَج / مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "甘いもの": "حَلْوَيَات\nمثال: 何か甘いものがほしい。 — أريد شيئاً حلواً.",
 "甘いもの好き": "ولع بالحلويات (شهية قوية للطعام الحلو)",
 "甘い物": "حَلْوَيَات\nمثال: 何か甘いものがほしい。 — أريد شيئاً حلواً.",
 "甘い物好き": "ولع بالحلويات (شهية قوية للطعام الحلو)",
 "甘える": "اِسْتَغَلَّ",
 "甘く": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "甘たるい": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها) / سكري (يحتوي على السكر)\nمثال: يأكل الكثير من الطعام السكري",
 "甘ちゃん": "رقيق القلب, عاطفي (شخص ضعيف وعاطفي بشكل مفرط)",
 "甘ったるい": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها) / سكري (يحتوي على السكر)\nمثال: يأكل الكثير من الطعام السكري",
 "甘っちょろい": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "甘とうがらし": "فلفل حلو, فلفل رومي (فلفل كبير معتدل مقرمش سميك الجدار عادة ما يكون جرسي الشكل أو مستطيلاً إلى حد ما؛ يستخدم عادة في السلطات) / بابريكا, فلفل حلو (نبات يحمل ثماراً كبيرة معتدلة سميكة الجدران عادة ما تكون على شكل جرس؛ فلفل السلطة الرئيسي)",
 "甘み": "حَلَاوَةٌ / حَلْوَيَات",
 "甘め": "حُلْوِيّ, مَائِل لِلْحَلَاوَة (حلو إلى حد ما)",
 "甘やか": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "甘やかす": "دَلَّلَ, دَلَّعَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ)\nمثال: دلل سامي صديقته.",
 "甘ダイ": "تايلفيش (سمكة غذائية بنفسجية مرقطة بالأصفر تعيش في المياه العميقة الدافئة) / بلانكيلو (أسماك غذائية بحرية مهمة)",
 "甘受": "مُتَقَبِّل",
 "甘口": "تَسَاهُل, رَأْفَة (الرحمة كنتيجة لكون الشخص ليناً أو متسامحاً) / رقة, لطف (التصرف بأسلوب رقيق ولطيف ومتزن) / اعتدال (طقس جيد مع درجات حرارة مريحة)\nمثال: تعلمت أصابعه الرقة / تملق, نفاق (ثناء مفرط أو غير صادق) / غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "甘味": "حَلَاوَةٌ / حَلْوَيَات / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "甘味料": "مُحَلِّيّ",
 "甘唐辛子": "فلفل حلو, فلفل رومي (فلفل كبير معتدل مقرمش سميك الجدار عادة ما يكون جرسي الشكل أو مستطيلاً إلى حد ما؛ يستخدم عادة في السلطات) / بابريكا, فلفل حلو (نبات يحمل ثماراً كبيرة معتدلة سميكة الجدران عادة ما تكون على شكل جرس؛ فلفل السلطة الرئيسي)",
 "甘噛み": "فَم, بق",
 "甘心": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "甘扁桃": "لوز, لوز حلو (شجرة نفضية شجيرية صغيرة موطنها آسيا وشمال أفريقيا لها أزهار وردية جميلة ومكسرات صالحة للأكل ذات قيمة عالية محاطة بقشرة خضراء صلبة؛ تزرع في جنوب…)",
 "甘木": "عِرْقْسُوس, نَبَات اَلسُّوس",
 "甘松": "ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "甘松香": "ناردين (مرهم عطري كان يستخدم في العصور القديمة)",
 "甘汞": "كالوميل, كلوريد الزئبقوز (مسحوق عديم اللون والطعم يستخدم طبياً كمسهل)",
 "甘海苔": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل) / لافر أحمر (أعشاب بحرية حمراء صالحة للأكل) / حوض تطهير, مغسل ((العهد القديم) حوض كبير استخدمه الكهنة في المعابد اليهودية القديمة لأداء طقوس الاغتسال)",
 "甘甘": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "甘皮": "بُشَيْرَة / الغِلاف الدَّاخِلِيّ, عَجْمَة (الطبقة الداخلية الصلبة (عادة خشبية) لغلاف الثمرة في بعض الفواكه (كالخوخ أو البرقوق أو الكرز أو الزيتون) والتي تحتوي على البذرة)\nمثال: يجب إزالة النوى من البرقوق قبل الطهي",
 "甘粛": "قَانْسُو, غَانْسُو",
 "甘精": "سُكَّرِيّ",
 "甘美": "حُلْو (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به) / حَلْوَى\nمثال: الكعكة حلوة جدا",
 "甘肌": "الغِلاف الدَّاخِلِيّ, عَجْمَة (الطبقة الداخلية الصلبة (عادة خشبية) لغلاف الثمرة في بعض الفواكه (كالخوخ أو البرقوق أو الكرز أو الزيتون) والتي تحتوي على البذرة)\nمثال: يجب إزالة النوى من البرقوق قبل الطهي",
 "甘苔": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل) / لافر أحمر (أعشاب بحرية حمراء صالحة للأكل) / حوض تطهير, مغسل ((العهد القديم) حوض كبير استخدمه الكهنة في المعابد اليهودية القديمة لأداء طقوس الاغتسال)",
 "甘苦い": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "甘草": "عرق السوس (حلوى سوداء منكهة بالجذر المجفف لنبات عرق السوس) / عرق سوس (نبات عميق الجذور خشن الملمس موطنه منطقة البحر الأبيض المتوسط له أزهار زرقاء وأوراق مركبة ريشية؛ يزرع على نطاق واسع في أوروبا لجذوره الحلوة السميكة…)",
 "甘菜": "شَمَنْدَر اَلسُّكَّر",
 "甘葛": "لَبْلَاب",
 "甘蔗": "قَصَب السُّكَّر",
 "甘蔗糖": "سكر القصب (سكر من قصب السكر يستخدم كعامل تحلية) / سكر القصب (سكروز يتم الحصول عليه من قصب السكر)",
 "甘蕉": "مَوْزَة / مَوْز (نبات فاكهة استوائية من الفصيلة الموزية؛ ثمر نبات الموز) / موزة / موز (نبات فاكهة استوائية من الفصيلة الموزية؛ ثمر نبات الموز)\nمثال: هن بحاجة للموز.",
 "甘薯": "بَطَاطَا حُلْوَة",
 "甘藍": "مَلْفُوف, كُرُنْب",
 "甘藷": "بَطَاطَا حُلْوَة",
 "甘藻": "عشب الشريط, فاليسنيريا (نبات مائي مغمور بأوراق تشبه الشريط؛ العالم القديم وأستراليا) / حشيشة البحر, زوستيرا (نبات بحري مغمور بأوراق ضيقة طويلة جداً يوجد بكثرة على طول سواحل شمال الأطلسي)",
 "甘言": "مداهنة, ملاطفة (تملق يهدف إلى الإقناع)",
 "甘言蜜語": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "甘酸っぱい": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "甘露": "جَذَّابٌ جِنْسِيًّا, فَاتِن (قَادِرٌ عَلَى إِثَارَةِ الرَّغْبَةِ الجِنْسِيَّة) / شَهِيٌّ لِلغَايَة, لَذِيذٌ جِدًّا (بَالِغُ اللَّذَّةِ لِحَاسَّةِ التَّذَوُّق) / مغثر / مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "甘露水": "ماء وسكر (ماء محلى بالسكر)",
 "甘露煮": "مُبَلْوَر, مُسَكَّر ((خَاصَّةً عَنِ الفَوَاكِه) مَحْفُوظ بِتَغْلِيفِه بِالسُّكَّر أَوْ تَشَرُّبِه إِيَّاه) / مُسَكَّر, مُغَلَّف بِالسُّكَّر (مُغَطّى بطبقة من السكر أو الشراب المركز)",
 "甘鯛": "تايلفيش (سمكة غذائية بنفسجية مرقطة بالأصفر تعيش في المياه العميقة الدافئة) / بلانكيلو (أسماك غذائية بحرية مهمة)",
 "甚く": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "甚だ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "甚だしい": "الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "甚だもって": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "甚だ以て": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "甚六": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "甚兵衛鮫": "قرش حوت (قرش مرقط كبير يعيش في المياه السطحية الدافئة في جميع أنحاء العالم؛ يشبه الحوت ويتغذى بشكل رئيسي على العوالق)",
 "甚大": "ضَخْم, هَائِل",
 "甚振る": "عَذَاب / عَذَّبَ",
 "甜菜": "شَمَنْدَر اَلسُّكَّر",
 "甜菜糖": "سكر البنجر (سكر من بنجر السكر يستخدم كعامل تحلية) / سكر البنجر (سكر مصنوع من بنجر السكر)",
 "甜言蜜語": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "生": "صَافٍ, اَلصَّافِي / خَام (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / طَبِيعِيّ / غير محمي, مكشوف (يفتقر للحماية أو الدفاع) / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / طَالِب, طَالِبَة / حَيَوِيّ / أَسَاسِيّ",
 "生々": "دَجِر",
 "生々しい": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / طَازَج, طَازَة / عَذْب",
 "生々世々": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "生い立ち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "生い立つ": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "生い茂る": "اِزْدَهَرَ, أَهَلَّ",
 "生う": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "生えでる": "نَبْتَة",
 "生える": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "生え出る": "نَبْتَة",
 "生え抜き": "ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ) / مُنْذُ البِدَايَة",
 "生え際": "خط الشعر, منبت الشعر (الحد الطبيعي الذي يشكله الشعر على الرأس) / خط رفيع جداً, خط شعري (خط رفيع للغاية)",
 "生かじり": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود / بط مخوض (أي من العديد من بط المياه الضحلة الذي يتغذى عن طريق قلب جسمه والخوض في الماء) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "生かす": "استدانة, روافع مالية (الاستثمار بأموال مقترضة كوسيلة لتضخيم المكاسب المحتملة (مع خطر حدوث خسائر أكبر)) / قُوَّة تَأْثِير, نُفُوذ (أفضلية استراتيجية؛ القدرة على التصرف بفاعلية) / قوة الرافعة, ميزة ميكانيكية (الميزة الميكانيكية المكتسبة من خلال التواجد في وضع يسمح باستخدام رافعة)\nمثال: يمكن للمجموعات الصغيرة نسبياً أن تمارس أحياناً نفوذاً سياسياً هائلاً / أَحْيَا / اِسْتَعَادَ",
 "生き": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً / بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "生きかえる": "أَحْيَا",
 "生きがい": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "生きがいい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "生きが良い": "طَازَج, طَازَة / عَذْب / دَجِر",
 "生きざま": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生きた": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "生きた化石": "حفرية حية",
 "生きている化石": "حفرية حية",
 "生きながらえる": "نَجَا",
 "生きぬく": "نَجَا",
 "生きのいい": "طَازَج, طَازَة / عَذْب / دَجِر",
 "生きの良い": "طَازَج, طَازَة / عَذْب / دَجِر",
 "生きる": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / اِرْتَزَقَ / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "生きる道": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生き写し": "صُورَة طِبْق الأَصْل, نُسْخَة مُطَابِقَة (صورة مماثلة تماماً أو نظير مطابق)",
 "生き地獄": "جحيم, عذاب (أي مكان يسوده الألم والاضطراب)\nمثال: جحيم المعركة",
 "生き存える": "نَجَا",
 "生き延びる": "نَجَا",
 "生き抜く": "نَجَا",
 "生き方": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生き様": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生き残り": "بقاء (شيء ينجو ويبقى) / انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة) / بقاء, نجاة (حالة البقاء على قيد الحياة) / ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "生き残る": "نَجَا",
 "生き永らえる": "نَجَا",
 "生き物": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما)",
 "生き生き": "بِشَكْل حَيّ, بِوُضُوح (بطريقة حية)\nمثال: وصف مغامراته بشكل حي",
 "生き甲斐": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "生き続ける": "نَجَا",
 "生き血": "شريان الحياة, عصب الحياة (قوة أساسية أو مانحة للحياة) / دم الحياة, شريان الحياة (الدم باعتباره قوام الحياة والحيوية)\nمثال: الماء هو شريان الحياة في الهند",
 "生き身": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "生き返る": "أَحْيَا",
 "生き長らえる": "نَجَا",
 "生き霊": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً",
 "生き魑魅": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً",
 "生く": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "生ける": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "生ける屍": "زُومْبِي, المَيِّت الحَيّ",
 "生け垣": "وَشِيع, سِيَاج نَبَاتِيّ",
 "生け簀": "حَوْض سَمَك (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "生け花": "إِيكِيبَانَا",
 "生け贄": "تَضْحِيَة, قُرْبَان / ضَحَّى / ضَحِيَّة / أُضْحِيَّة",
 "生け込む": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "生ごみ処理機": "طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام)",
 "生じる": "أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "生じろい": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "生す": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / أَنْجَبَ\nمثال: أعرف ذلك الولد.",
 "生ずる": "أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "生った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "生っちょろい": "فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "生っちろい": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "生っ白い": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "生っ粋": "صَافٍ, اَلصَّافِي",
 "生つば": "لُعَاب, رِيق",
 "生なか": "مُتَوَسِّط / بفتور, بقلب غير حاضر (بدون حماس؛ بطريقة فاترة)\nمثال: حاولت بفتور",
 "生ぬるい": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ) / فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة) / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "生のままで": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "生まじめ": "مُفْرِط فِي الجِدِّيَّة (جادّ إلى حدّ المبالغة)",
 "生まる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)",
 "生まれ": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれかわり": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "生まれがいい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "生まれがよい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "生まれが良い": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "生まれたて": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "生まれた場所": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "生まれついて": "طَبِيعِيّ",
 "生まれつき": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "生まれつく": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれてくる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれてこのかた": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "生まれてこの方": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "生まれて来る": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれながら": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "生まれのいい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "生まれのよい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "生まれの良い": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "生まれる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれ乍ら": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "生まれ付く": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれ出る": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生まれ変わり": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "生まれ損い": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "生まれ損ない": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "生まれ立て": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "生まれ落ちる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生み": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "生みつける": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "生みの子": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "生みの苦しみ": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "生みの親": "مُؤَسِّس, مُؤَسِّسَة",
 "生み付ける": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "生み出す": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / اِخْتَرَعَ / دُبّ / دُبَّة / اِحْتَمَلَ",
 "生み落とす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "生む": "وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / أَنْجَبَ\nمثال: أعرف ذلك الولد. / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "生もの": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "生やさしい": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "生やす": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "生ゆで": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "生り": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "生り物": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة.",
 "生れ": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生れた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "生れたて": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "生れながら": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "生れ乍ら": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "生れ付く": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生れ立て": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "生れ落ちる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生を享ける": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生を受ける": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生ゴミ処理機": "طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام)",
 "生データ": "بيانات خام (بيانات غير محللة؛ بيانات لم تخضع بعد للتحليل)",
 "生ビール": "بيرة البرميل, جعة مسكوبة (بيرة مسحوبة من برميل)",
 "生ライブ": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "生一本": "أمانة, صدق (صفة كون الشخص صادقاً) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "生中": "مُتَوَسِّطُ الْحَجْمِ (متوسط في الحجم) / مُتَوَسِّط / بفتور, بقلب غير حاضر (بدون حماس؛ بطريقة فاترة)\nمثال: حاولت بفتور",
 "生乳": "حليب خام (حليب غير مبستر)",
 "生体": "كَائِن حَيّ",
 "生体工学": "البيونيك, الهندسة الحيوية (تطبيق المبادئ البيولوجية على دراسة وتصميم الأنظمة الهندسية (خاصة الأنظمة الإلكترونية))",
 "生体自己制御": "ارتجاع بيولوجي (برنامج تدريبي يُعطى فيه الشخص معلومات حول العمليات الفسيولوجية (مثل معدل ضربات القلب) بهدف التحكم الواعي بها)",
 "生体解剖": "تشريح الأحياء (فعل إجراء عمليات على الحيوانات الحية (خاصة في البحث العلمي))",
 "生体認証": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)",
 "生保": "تَأْمِين عَلَى اَلْحَيَاة / رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "生兵法は大怪我のもと": "قَلِيلًا",
 "生兵法は大怪我の元": "قَلِيلًا",
 "生兵法は大怪我の基": "قَلِيلًا",
 "生処": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "生分解性": "قَابِل لِلتَّحَلُّل البِيُولُوجِيّ (قابل للتحلّل بفعل البكتيريا ونحوها)",
 "生力": "طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية)",
 "生動": "تدفق, حيوية (أسلوب نشيط) / حيوية, نشاط (خاصية القدرة على البقاء والنمو) / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية) / حيوية, طاقة (قدرة صحية على النشاط القوي)\nمثال: حيوية البذرة",
 "生化学": "كِيمِيَاء حَيَوِيَّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء.",
 "生半": "مُتَوَسِّط / بفتور, بقلب غير حاضر (بدون حماس؛ بطريقة فاترة)\nمثال: حاولت بفتور",
 "生半可": "سَطْحِيّ",
 "生協": "تعاونية, جمعية تعاونية (مؤسسة تجارية مملوكة بشكل مشترك (ينظمها عادة المزارعون أو المستهلكون) تنتج وتوزع السلع والخدمات وتدار لصالح مالكيها)",
 "生口": "أَسِير الْحَرْب, أَسِير (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / عَبْد (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / أَمَة (المرأة المملوكة، خلاف الحرة)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "生合成": "تخليق حيوي, نشوء حيوي (إنتاج مركب كيميائي بواسطة كائن حي)",
 "生命": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / مِهْنَة, مسار مهني / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية)",
 "生命体": "شَكْل حَيَوِيّ (الشكل الجسدي المميز لكائن حي ناضج)",
 "生命保険": "تَأْمِين عَلَى اَلْحَيَاة",
 "生命保険会社": "تَأْمِين عَلَى اَلْحَيَاة",
 "生命保険協会": "تَأْمِين عَلَى اَلْحَيَاة",
 "生命保険証書": "تَأْمِين عَلَى اَلْحَيَاة",
 "生命倫理": "أخلاقيات علم الأحياء (فرع الأخلاق الذي يدرس القيم الأخلاقية في العلوم الطبية الحيوية)",
 "生命倫理学": "أخلاقيات علم الأحياء (فرع الأخلاق الذي يدرس القيم الأخلاقية في العلوم الطبية الحيوية)",
 "生命刑": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "生命力": "تدفق, حيوية (أسلوب نشيط) / حيوية, نشاط (خاصية القدرة على البقاء والنمو) / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية) / حيوية, طاقة (قدرة صحية على النشاط القوي)\nمثال: حيوية البذرة",
 "生命工学": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين العمال وبيئاتهم) / تكنولوجيا حيوية (فرع البيولوجيا الجزيئية الذي يدرس استخدام الكائنات الحية الدقيقة لأداء عمليات صناعية محددة)\nمثال: أنتجت التكنولوجيا الحيوية بكتيريا معدلة وراثياً حلت المشكلة",
 "生命権": "حق الحياة (الحق في العيش)",
 "生命科学": "بيولوجيا, علوم الحياة (أي فرع من فروع العلوم الطبيعية يتعامل مع بنية وسلوك الكائنات الحية)",
 "生命維持装置": "نظام دعم الحياة (معدات طبية تساعد أو تحل محل وظائف جسدية مهمة وبالتالي تمكن المريض من العيش والذي لولاها قد لا ينجو) / نظام دعم الحياة (معدات تجعل الحياة ممكنة في ظروف بيئية مميتة لولا ذلك)\nمثال: المريض على أجهزة دعم الحياة",
 "生命線": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق) / حبل الغواص (حبل يرفع أو ينزل غواص أعماق البحار) / شريان حياة, طوق نجاة (دعم يمكن الناس من البقاء أو الاستمرار في فعل شيء ما (غالباً من خلال توفير اتصال أساسي)) / خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)\nمثال: وفر الجسر الجوي شريان حياة لبرلين / خط الحياة (تجعد في راحة اليد؛ يقال في قراءة الكف أنه يشير إلى طول العمر)",
 "生唾": "لُعَاب, رِيق",
 "生噛じり": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود / بط مخوض (أي من العديد من بط المياه الضحلة الذي يتغذى عن طريق قلب جسمه والخوض في الماء) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "生国": "أرض الوطن, البلد الأم (البلد الذي ولدت فيه)",
 "生地": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء. / عَجِين, عَجِينَة / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "生地主義": "حق الإقليم, حق المولد (المبدأ القائل بأن جنسية الشخص عند الولادة تتحدد بمكان ولادته)",
 "生地屋": "بَزَّاز",
 "生地獄": "جحيم, عذاب (أي مكان يسوده الألم والاضطراب)\nمثال: جحيم المعركة",
 "生垣": "وَشِيع, سِيَاج نَبَاتِيّ",
 "生変": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "生天目": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "生姜": "زَنْجَبِيل / أَصْهَب",
 "生姜醤油": "صَلْصَةْ اَلصُّويَا",
 "生娘": "بتول, بِكْر (المنقطعه عن الرجال)",
 "生存": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "生存力": "حيوية, قابلية الحياة ((للكائنات الحية) القدرة على النمو والتطور الطبيعي) / جَدْوَى, قَابِلِيَّة التَّطْبِيق (القدرة على الإنجاز بطريقة عملية ومفيدة)",
 "生存圏": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "生存期間": "حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة",
 "生存権": "حق الحياة (الحق في العيش)",
 "生存者": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "生害": "اِنْتَحَرَ",
 "生年": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "生年月日": "تَارِيخُ الْمِيلَادِ, تَارِيخُ مِيلَادِ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "生彩": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تنوع, حيوية (الاهتمام والتنوع والشدة في الطابع)\nمثال: كانت الحقبة البيوريتانية تفتقر إلى الحيوية",
 "生徒": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "生得": "مُتَأَصِّل",
 "生得的": "فِطْرِيّ",
 "生息": "أَقَام, قَطَن (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "生息地": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "生息子": "شاب (مراهق أو شاب بالغ ذكر)",
 "生息環境": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "生意気": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "生意気ざかり": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "生意気盛り": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "生態": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "生態学": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "生態環境": "عِلْم اَلْبِيئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "生態的": "بِيئِيّ, إِيكُولُوجِيّ",
 "生態的地位": "تخصص بيئي, مكانة بيئية ((علم البيئة) وضع الكائن الحي داخل بيئته ومجتمعه (الذي يؤثر على بقائه كنوع))",
 "生態系": "نِظَام بِيئِي (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "生憎": "أَنَا آسِف, أَنَا آسِفَة",
 "生成": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "生成り": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا) / غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "生成器": "مُوَلِّد / مُوَلِّد كَهْرَبَائِيّ",
 "生成文法": "نحو توليدي ((لسانيات) نوع من النحو يصف التركيب من خلال مجموعة من القواعد المنطقية التي يمكن أن تولد كل الجمل النحوية في لغة ما وتعطيها الوصف الهيكلي الصحيح)",
 "生成規則": "إِنْتَاج",
 "生所": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "生揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "生損保": "تَأْمِين عَلَى اَلْحَيَاة",
 "生新": "طَازَج, طَازَة / عَذْب",
 "生日": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "生易しい": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "生暖か": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ)",
 "生暖かい": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ)",
 "生来": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "生格": "حَالَة اَلْمُضَاف إِلَيْهِ, مَجْرُور",
 "生検": "خَزْعَة",
 "生業": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / مَعِيشَة, مَعَاش",
 "生歯": "بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "生死": "تناسخ الأرواح, سامسارا ((في الهندوسية والبوذية) الدورة اللانهائية من الولادة والمعاناة والموت والبعث) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "生死不明": "مَفْقُود",
 "生残": "بقاء (شيء ينجو ويبقى) / انتقاء طبيعي, بقاء (عملية طبيعية تؤدي إلى تطور الكائنات الحية الأكثر تكيفاً مع البيئة) / بقاء, نجاة (حالة البقاء على قيد الحياة)",
 "生残者": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "生殖": "تَكَاثُر",
 "生殖医療": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "生殖器": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "生殖器官": "عضو تناسلي, عضو جنسي (أي عضو يشارك في التكاثر الجنسي)",
 "生殖細胞": "خلية تناسلية, خلية جرثومية (حيوان منوي أو بويضة؛ خلية مسؤولة عن نقل الحمض النووي للجيل القادم)",
 "生殖能力": "خُصُوبَة",
 "生殖腺": "غُدَّة تَناسُلِيَّة",
 "生殖腺刺激ホルモン": "غونادوتروبين, موجهة الغدد التناسلية (هرمون تفرزه الغدة النخامية الأمامية والمشيمة؛ يحفز الغدد التناسلية ويتحكم في النشاط الإنجابي)",
 "生殖補助医療": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "生殖補助技術": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "生殺し": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو الصالحة (مثل الرضع والأفراد الفاضلين)) / إهمال, نسيان (مكان خيالي للأشياء المفقودة أو المهملة) / طي الكتمان, نسيان (حالة كونه مهملاً أو منسياً)",
 "生殺与奪": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "生毛": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / زَغَبُ الجَنِين (الشعر الزغبي الناعم الذي يغطي الجنين البشري؛ يسقط عادة خلال الشهر التاسع من الحمل)",
 "生気": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生気論": "حيوية ((فلسفة) مذهب يرى أن الحياة مبدأ حيوي متميز عن الفيزياء والكيمياء)",
 "生水": "مَاء الحَنَفِيَّة (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)",
 "生活": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / مَعِيشَة, مَعَاش",
 "生活の質": "جَوْدَة الْحَيَاة",
 "生活スタイル": "نَمَط الحَيَاة",
 "生活パターン": "نَمَط الحَيَاة",
 "生活保護": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "生活保護法": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "生活力": "تدفق, حيوية (أسلوب نشيط) / حيوية, نشاط (خاصية القدرة على البقاء والنمو) / طاقة حيوية, قوة حيوية ((في علم الأحياء) قوة افتراضية (ليست فيزيائية أو كيميائية) كان يعتقد هنري برجسون أنها تسبب تطور ونمو الكائنات الحية) / حيوية, طاقة (قدرة صحية على النشاط القوي)\nمثال: حيوية البذرة",
 "生活協同組合": "تَعَاوُنِيّ",
 "生活史": "دورة حياة (سلسلة من المراحل التي يمر بها الكائن الحي بين تكرار مرحلة أساسية) / دورة حياة (مسار التغيرات التطورية في كائن حي من الزيجوت المخصب إلى النضج حيث يمكن إنتاج زيجوت آخر)",
 "生活圏": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود",
 "生活年齢": "عمر زمني (العمر مقاساً بالوقت (السنوات والشهور) الذي وجد فيه شيء أو شخص ما)\nمثال: كان عمره الزمني 71 عاماً",
 "生活必需品": "ضَرُورَة, حَاجَة",
 "生活態度": "نَمَط الحَيَاة",
 "生活振り": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生活支援": "صِيَانَة",
 "生活水準": "مُسْتَوَى اَلْمَعِيشَة",
 "生活法": "حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生活環": "دورة حياة (سلسلة من المراحل التي يمر بها الكائن الحي بين تكرار مرحلة أساسية) / دورة حياة (مسار التغيرات التطورية في كائن حي من الزيجوت المخصب إلى النضج حيث يمكن إنتاج زيجوت آخر)",
 "生活空間": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "生活給": "أجر المعيشة, حد الكفاف (أجر كافٍ للعامل وعائلته للعيش براحة)",
 "生活習慣": "نَمَط الحَيَاة",
 "生活者": "مُسْتَهْلِك / مُسْتَنْفِد",
 "生活語": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "生涯": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生涯を閉じる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "生涯教育": "تعليم مستمر (برنامج تعليمي مصمم بشكل أساسي للطلاب البالغين الذين يشاركون بدوام جزئي)",
 "生温い": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ) / فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة) / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "生温か": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ)",
 "生温かい": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ)",
 "生焼け": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "生煮え": "نَادِر / غَامِض / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "生熟り": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "生熟れ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "生爪": "ظُفْر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "生物": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما) / عِلْم اَلْأَحْيَاء, بِيُولُوجِيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "生物テロ": "إرهاب بيولوجي (الإرهاب باستخدام أسلحة الحرب البيولوجية)",
 "生物体": "كَائِن حَيّ",
 "生物兵器": "سلاح بيولوجي (أي سلاح يمكن استخدامه في الحرب البيولوجية)\nمثال: خشوا من استخدام فيروس الجدري كسلاح بيولوجي",
 "生物剤": "خطر بيولوجي, عامل بيولوجي (أي بكتيريا أو فيروس أو سم يمكن استخدامه في الحرب البيولوجية)",
 "生物化学": "كِيمِيَاء حَيَوِيَّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء.",
 "生物化学的酸素要求量": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "生物圏": "غلاف حيوي, محيط حيوي (مناطق سطح الأرض وغلافها الجوي (أو كوكب آخر) حيث توجد الكائنات الحية)",
 "生物地理学": "جغرافيا حيوية (التعامل مع التوزيع الجغرافي للحيوانات والنباتات)",
 "生物多様性": "تَنَوُّع البِيُولُوجِيّ",
 "生物学": "عِلْم اَلْأَحْيَاء, بِيُولُوجِيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "生物学主義": "بيولوجية, تفسير بيولوجي (استخدام المبادئ البيولوجية في تفسير السلوك البشري وخاصة الاجتماعي)",
 "生物学的": "بِيُولُوجِيّ, أَحْيَائِي",
 "生物学的多様性": "تَنَوُّع البِيُولُوجِيّ",
 "生物学的製剤": "بِيُولُوجِيّ, أَحْيَائِي",
 "生物学者": "أَحْيَائِي (إلى أَحْيَاء؛ الأحيائي أو عالم الأحياء هو الشخص المتخصص في علم الأحياء، والذي يدرس تركيب وآلية عمل المتعضيات والأنظمة الحية أو علاقتها بالبيئة)\nمثال: هو عالم أحيائي.",
 "生物工学": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين العمال وبيئاتهم) / تكنولوجيا حيوية (فرع البيولوجيا الجزيئية الذي يدرس استخدام الكائنات الحية الدقيقة لأداء عمليات صناعية محددة)\nمثال: أنتجت التكنولوجيا الحيوية بكتيريا معدلة وراثياً حلت المشكلة",
 "生物戦": "حرب بيولوجية, هجوم بيولوجي (استخدام البكتيريا أو الفيروسات أو السموم لتدمير البشر والحيوانات أو الغذاء)",
 "生物時計": "سَاعَة بَيُولُوجِيَّة (آلية فطرية في الكائنات الحية تتحكم في دورية العديد من الوظائف الفسيولوجية)",
 "生物検定": "مقايسة حيوية (تقييم النشاط البيولوجي لمادة ما عن طريق اختبار تأثيرها على كائن حي ومقارنة النتيجة ببعض المعايير المتفق عليها)",
 "生物海洋学": "علم الأحياء البحرية (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "生物測定学": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)",
 "生物物理学": "فيزياء حيوية (الفيزياء كما تطبق على المشاكل البيولوجية)",
 "生物界": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "生物発光": "ضيائية حيوية (ضيائية تنتجها عمليات فسيولوجية (كما في اليراع))",
 "生物的": "بِيُولُوجِيّ, أَحْيَائِي",
 "生物相": "الحياة البيولوجية, كائنات حية (جميع الكائنات الحية النباتية والحيوانية في منطقة معينة)",
 "生物系": "بِيُولُوجِيّ, أَحْيَائِي",
 "生物統計学": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)",
 "生物群集": "مجتمع حيوي ((في علم البيئة) مجموعة من الكائنات الحية المترابطة التي تسكن نفس المنطقة وتتفاعل مع بعضها البعض)",
 "生理": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "生理前症候群": "متلازمة ما قبل الحيض (متلازمة تحدث لدى العديد من النساء قبل 2 إلى 14 يوماً من بدء الحيض)",
 "生理学": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "生理学研究所": "عضة صغيرة, قرصة (عضة صغيرة حادة) / لذعة, نكهة حادة (جودة حارة ولاذعة) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل) / مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)\nمثال: برودة الصباح الباكر",
 "生理機能": "فِيزْيُولُوجِيَا, عِلْم وَظَائِف اَلْأَعْضَاء",
 "生理用ナプキン": "فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية)",
 "生理的": "فَسْلَجِي, فِسْيُولُوجِي / حَدْسِيّ, غَرِيزِيّ (مُكْتَسَب بِالحَدْس لا بِالتَّفْكير أَوْ المُلاحَظَة) / حشوي (متعلق بالأحشاء أو يؤثر فيها)\nمثال: نزيف حشوي",
 "生理的食塩水": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "生理食塩水": "محلول ملحي (محلول متساوي التوتر من كلوريد الصوديوم والماء المقطر)",
 "生生": "دَجِر",
 "生生しい": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / طَازَج, طَازَة / عَذْب",
 "生生世世": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "生産": "إِنْتَاج / ولادة حية (ولادة جنين حي (بغض النظر عن مدة الحمل))",
 "生産コスト": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "生産ライン": "خط إنتاج, خط تجميع (نظام ميكانيكي في مصنع يتم بموجبه نقل السلعة عبر مواقع يتم فيها إجراء عمليات متتالية عليها)",
 "生産中止": "إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "生産側非同期手続き": "مُنْتِج",
 "生産児": "ولادة حية (ولادة جنين حي (بغض النظر عن مدة الحمل))",
 "生産力": "إنْتَاجِيَّة",
 "生産品": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "生産国": "أرض الوطن, البلد الأم (البلد الذي ولدت فيه)",
 "生産工学": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "生産性": "إنْتَاجِيَّة",
 "生産手段": "وَسَائِل الْإِنْتَاج",
 "生産物": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "生産率": "ولادة حية (ولادة جنين حي (بغض النظر عن مدة الحمل))",
 "生産現場": "أرضية المصنع, صالة الإنتاج (مكان عمل يتكون من جزء من المصنع يضم الآلات)\nمثال: يتم العمل الإنتاجي في أرضية المصنع",
 "生産的": "خَصِب, غَنِيّ (يَتَّسِمُ بِالخُصُوبَة الشَّدِيدَة وَالإِنْتَاجِيَّة العَالِيَة) / خصب, مثمر (ينتج أو قادر على الإنتاج (خاصة بغزارة)) / إنتاجي, توليدي (لديه القدرة على الإنتاج أو الابتكار) / مُثْمِر, مُنْتِج (يُسفِر عن نتائج إيجابية)\nمثال: أرض زراعية منتجة / إيجابي, بناء (يبني أو يميل إلى البناء أو التحسين أو تعزيز التنمية) / بَنَّاء (يركز على ما هو جدير بالثناء أو مبعث على الأمل أو في مصلحة الخير)\nمثال: نقد بناء",
 "生産管理工学": "إدارة صناعية, هندسة صناعية (فرع الهندسة الذي يتعامل مع إنشاء وإدارة الأنظمة التي تدمج الناس والمواد والطاقة بطرق منتجة)",
 "生産者": "مُنْتِج",
 "生産者物価指数": "مؤشر أسعار الجملة, مؤشر أسعار المنتجين (مؤشر للتغيرات في أسعار الجملة)",
 "生産販売在庫": "پْسِي, بْسِي",
 "生産費": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "生産過剰": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "生産高": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "生田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "生田目": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "生白い": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "生皮": "جلد خام (جلد غير مدبوغ خاصة للماشية؛ يقطع إلى شرائط ويستخدم للسياط والحبال)",
 "生直ぐ": "حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "生真面目": "مُفْرِط فِي الجِدِّيَّة (جادّ إلى حدّ المبالغة)",
 "生石灰": "أكسيد الكالسيوم, الجير الحي (أكسيد بلوري أبيض يستخدم في إنتاج هيدروكسيد الكالسيوم)",
 "生砂": "رمل أخضر (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "生硬": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "生禅": "مُتَسَمٍّ, مُدَّعٍ (كما يدّعيه المرء لنفسه في كثير من الأحيان دون مبرّر)",
 "生立つ": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "生管": "حاسوب شخصي (حاسوب رقمي صغير يعتمد على معالج دقيق ومصمم ليستخدمه شخص واحد في كل مرة)",
 "生簀": "حَوْض سَمَك (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "生粋": "صَافٍ, اَلصَّافِي",
 "生者": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "生肉": "لحم نيء (لحم غير مطبوخ)",
 "生育": "وضع, ولادة (عملية الولادة)",
 "生肴": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "生臙脂": "دودة قرمزية",
 "生臭い": "مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / زفر, سمكي (مكون من أو متعلق بـ أو يشبه السمك)\nمثال: كان للحساء رائحة سمكية / فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي) / دُنْيَوِيّ",
 "生花": "إِيكِيبَانَا",
 "生茹で": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "生血": "شريان الحياة, عصب الحياة (قوة أساسية أو مانحة للحياة) / دم الحياة, شريان الحياة (الدم باعتباره قوام الحياة والحيوية)\nمثال: الماء هو شريان الحياة في الهند",
 "生見": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "生計": "مَعِيشَة, مَعَاش",
 "生計を立てる": "اِرْتَزَقَ",
 "生計者": "كاسب, متكسب (شخص يكسب أجراً مقابل عمله)",
 "生計費指数": "تكاليف المعيشَة",
 "生誕": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "生販在": "پْسِي, بْسِي",
 "生贄": "تَضْحِيَة, قُرْبَان / ضَحَّى / ضَحِيَّة / أُضْحِيَّة",
 "生起": "حُدُوث",
 "生身": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / خَام (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "生返る": "أَحْيَا",
 "生返事": "فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "生還": "بَاقٍ, نَاجٍ (لا يزال في الوجود ولم ينقرض)",
 "生還者": "ناجٍ (حيوان يبقى على قيد الحياة رغم الشدائد) / بَاقٍ عَلَى قَيْد الْحَيَاة, نَاجٍ (من يعيش أطول من غيره) / باقٍ عَلَى قَيْد الحَياة, ناجٍ (الشخص الذي يعيش بعد محنة أو كارثة)\nمثال: كانت الحيوانات الأصلح فقط هي الناجية من فصول الشتاء الباردة",
 "生配信": "بَثّ مُبَاشِر (نشر أو أذاع خبرًا أو معلومة؛ أرسل إشارات أو موجات عبر وسيط معين)\nمثال: لبث ياني مكانه.",
 "生配信ライブ": "بَثّ مُبَاشِر (نشر أو أذاع خبرًا أو معلومة؛ أرسل إشارات أو موجات عبر وسيط معين)\nمثال: لبث ياني مكانه.",
 "生酔い": "سكران قليلاً (من شرب الخمر حتى سَكِرَ)\nمثال: تبدو كأنها سكرانة.",
 "生長": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "生長素": "أوكسين (هرمون نباتي يعزز تكوين الجذور ونمو البراعم)",
 "生霊": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً / روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً / بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب",
 "生類": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما)",
 "生飲み込み": "سَطْحِيّ",
 "生駒": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "生魑魅": "روح, شبح (تمثيل عقلي لتجربة مؤرقة (كأرواح الموتى)) / شبح, طيف خبيث (روح حاقدة أو مسكونة)\nمثال: بدا وكأنه رأى شبحاً",
 "生魚": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "生鮮": "طَازَج, طَازَة / عَذْب",
 "生鮮食品": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "生鮮食料品": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "生麩": "غلوتين القمح (غلوتين محضر من القمح)",
 "生麸": "غلوتين القمح (غلوتين محضر من القمح)",
 "生齧り": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود / بط مخوض (أي من العديد من بط المياه الضحلة الذي يتغذى عن طريق قلب جسمه والخوض في الماء) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "産": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / أَصْلِيّ / أُصُول",
 "産じょく": "اَلنِّفَاس",
 "産す": "دُبّ / دُبَّة / اِحْتَمَلَ / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "産する": "دُبّ / دُبَّة / اِحْتَمَلَ / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "産まれる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "産み": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "産みつける": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "産みの子": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "産みの苦しみ": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "産みの親": "مُؤَسِّس, مُؤَسِّسَة",
 "産み付ける": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "産み出す": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / اِخْتَرَعَ / دُبّ / دُبَّة / اِحْتَمَلَ",
 "産み落とす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "産む": "وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / أَنْجَبَ\nمثال: أعرف ذلك الولد. / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "産休": "إجَازَة أُمُومَة",
 "産児": "مَخَاض, وَضْع",
 "産児制限": "تَحْدِيد اَلنَّسْل",
 "産出": "إِنْتَاج",
 "産出高": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "産別": "نقابة صناعية (نقابة عمالية تقبل جميع العمال في صناعة معينة بغض النظر عن حرفتهم)",
 "産別会議": "مؤتمر المنظمات الصناعية (اتحاد للنقابات الصناعية في أمريكا الشمالية اندمج مع الاتحاد الأمريكي للعمل في عام 1955)",
 "産制": "تَحْدِيد اَلنَّسْل",
 "産前": "قَبْل الوِلَادَة (يحدث أو يوجد قبل الولادة)\nمثال: فترة ما قبل الولادة",
 "産卵": "بيض السمك, سرء (كتلة البيض التي تضعها الأسماك أو البرمائيات أو الرخويات)",
 "産卵口": "فَرْج, حِرّ",
 "産卵期": "موسم التزاوج, موسم التكاثر (موسم التكاثر هو الموسم الأنسب، وعادة ما يكون بظروف مواتية ووفرة في الغذاء والماء، للتكاثر)",
 "産卵管": "مضع البيض (هيكل أنبوبي لوضع البيض في نهاية البطن في العديد من إناث الحشرات وبعض الأسماك)",
 "産品": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "産地": "مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "産声をあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "産声を上げる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "産婆": "قَابِلَة, دَايَة",
 "産子": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة / ذُرِّيَّة, وَلَد / نِتاج",
 "産後": "بَعْد الوِلَادَة (يحدث مباشرة بعد الولادة)\nمثال: نمو ما بعد الولادة",
 "産業": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة. / مَعِيشَة, مَعَاش",
 "産業スパイ": "تَجَسُّس صِنَاعِيّ",
 "産業別組合": "نقابة صناعية (نقابة عمالية تقبل جميع العمال في صناعة معينة بغض النظر عن حرفتهم)",
 "産業動物": "مَوَاشٍ, أَنْعَام",
 "産業化": "تَصْنِيع, تَحَوُّل صِنَاعِيّ",
 "産業用": "صِنَاعِيّ",
 "産業組合主義": "اشتراكية النقابات (شكل من أشكال النظرية الاشتراكية يدعو لملكية الدولة للصناعة ولكن بإدارة نقابات العمال)",
 "産業革命": "الثورة الصناعية",
 "産毛": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / زَغَبُ الجَنِين (الشعر الزغبي الناعم الذي يغطي الجنين البشري؛ يسقط عادة خلال الشهر التاسع من الحمل)",
 "産気": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "産炭": "منجم فحم (منجم يُستخرج منه الفحم من الأرض)",
 "産物": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء / تَسَبَّب / نَتِيجَة",
 "産生": "إِنْتَاج",
 "産痛": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "産科": "طب التوليد, قبالة (فرع الطب المعني بالولادة ورعاية الأم)",
 "産科医": "طبيب توليد (طبيب متخصص في التوليد)",
 "産科医師": "طبيب توليد (طبيب متخصص في التوليد)",
 "産科学": "طب التوليد, قبالة (فرع الطب المعني بالولادة ورعاية الأم)",
 "産科病院": "مُسْتَشْفَى وِلَادَة (اسم مفعول من الفعل \"اسْتَشْفَى\")\nمثال: أعمل في مستشفى.",
