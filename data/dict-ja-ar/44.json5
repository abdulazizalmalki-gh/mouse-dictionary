 "王將": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王府": "أُوكْلَانْد",
 "王座": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش. / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "王手": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "王手をかける": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / هَدَّدَ / أَنْذَرَ",
 "王手を掛ける": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / هَدَّدَ / أَنْذَرَ",
 "王政": "مَلِكِيَّة",
 "王政復古": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إعادة تأهيل, استعادة (فعل إعادة شيء أو شخص إلى حالة مرضية) / نموذج استعادة, نموذج ترميم (نموذج يمثل المشهد الطبيعي لعصر جيولوجي سابق أو يمثل حيواناً منقرضاً وما إلى ذلك) / عمل مرمم, قطعة مرممة (قطعة أثرية أو فنية تم ترميمها أو إعادة بنائها)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "王族": "مَلَكِيَّة",
 "王朝": "سُلَالَة",
 "王様": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王様ゲーム": "لعبة جماعية (لعبة لتسلية الضيوف في حفلة)",
 "王様ペンギン": "بطريق ملك (بطريق كبير في الجزر المحاذية للدائرة القطبية الجنوبية)",
 "王権神授説": "الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون لمحاسبة رعاياهم؛ التمرد هو أسوأ الجرائم السياسية)",
 "王殺し": "قتل الملك (فعل قتل الملك) / قاتل الملك (شخص يرتكب جريمة قتل الملك)",
 "王水": "مَاء مَلَكِيّ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "王無中": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)",
 "王物": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "王立": "مَلَكِيّ, قَيْصَرِيّ",
 "王立動物虐待防止協会": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز الثاني ميثاقاً ملكياً في عام 1662) دعمت الحكومة البريطانية من خلالها…)",
 "王立協会": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز الثاني ميثاقاً ملكياً في عام 1662) دعمت الحكومة البريطانية من خلالها…)",
 "王立園芸協会": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية) / روديوم (عنصر فلزي صلب أبيض من مجموعة البلاتين ويوجد في خامات البلاتين) / العامل الرايزيسي, عامل ريزوس (مستضد فصيلة الدم يمتلكه الأشخاص إيجابيو العامل الرايزيسي)",
 "王立工学アカデミー": "الأكاديمية الملكية, الأكاديمية الملكية للفنون (أكاديمية فخرية في لندن (تأسست عام 1768) تهدف إلى زراعة الرسم والنحت والهندسة المعمارية في بريطانيا)",
 "王笏": "صَوْلَجَان",
 "王統": "عائلة مالكة, ملوك (الأشخاص الملكيون بشكل جماعي)\nمثال: حضر الزفاف أفراد من العائلة المالكة",
 "王者": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / نَصِير, نَصِيرَة",
 "王蛇": "بُوَاء",
 "王道": "ملكية, مُلك (كرامة أو رتبة أو منصب الملك) / طريق ملكي, طريق ممهد (طريقة أو وسيلة مميزة وسهلة لتحقيق شيء ما)\nمثال: الطريق الممهد للنجاح",
 "王道的": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ) / عَرِيق, كْلَاسِيكِيّ (مَعْرُوفٌ وَمُسْتَقِرٌّ مُنْذُ زَمَنٍ طَوِيلٍ فِي الشَّكْلِ أَوِ الأُسْلُوب) / تُرَاثِيّ, كْلَاسِيكِيّ (يُعتبر من أعلى مستويات الجودة وذو أهمية وقيمة دائمتين) / كِلَاسِيكِيّ, نَمَطِيّ (من نوع معروف؛ نموذجي بشكل لافت)\nمثال: فخار صيني كلاسيكي",
 "王道進行": "طريق ملكي, طريق ممهد (طريقة أو وسيلة مميزة وسهلة لتحقيق شيء ما)\nمثال: الطريق الممهد للنجاح",
 "王配": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "玖": "تِسْعَة, تسعة",
 "玖我": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玩ぶ": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "玩具": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو. / ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "玩具かぼちゃ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "玩具カボチャ": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "玩具南瓜": "قرع, يقطين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "玩具箱": "صندوق ألعاب (صندوق لتخزين الألعاب)",
 "玩味": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق. / تَقْدِير",
 "玩弄品": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "玩弄物": "ألعوبة, لعبة (شيء مصنوع مصمم للعب به)",
 "玩物": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "玲々": "ذُو طَنِين, مُتَرَنِّم (يشبه صوت الرنين القصير العالي لجرس صغير)",
 "玲玲": "ذُو طَنِين, مُتَرَنِّم (يشبه صوت الرنين القصير العالي لجرس صغير)",
 "玲瓏": "شَفَّاف / وَاضِح",
 "玳瑁": "سلحفاة صقرية المنقار (سلحفاة بحرية استوائية عدوانية ذات منقار يشبه الصقر؛ مصدر للغذاء وأفضل أنواع صدف السلاحف)",
 "玻璃": "مَرْو, كَوَارْتْز / زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟",
 "玻璃器": "أواني زجاجية (صنف من أدوات المائدة مصنوع من الزجاج)",
 "玻璃版": "طباعة النمط الغروي, كولوتيب (عملية طباعة ميكانيكية ضوئية تستخدم لوحاً زجاجياً بسطح جيلاتيني يحمل الصورة المراد استنساخها؛ يمكن استخدامها مع لون واحد أو أكثر)",
 "珈琲店": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "珈琲粉砕機": "طَاحُونَة قَهْوَة (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق)",
 "珊瑚": "مَرْجَان",
 "珊瑚樹": "ذُو بِنْيَةٍ تَفَرُّعِيَّة, شَجَرِيّ (يُشْبِهُ الشَّجَرَةَ فِي شَكْلِهِ وَبِنْيَتِهِ المُتَفَرِّعَة)",
 "珊瑚海": "بَحْر كُورَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "珊瑚礁": "شعاب مرجانية (شعاب تتكون من المرجان المتصلب في الحجر الجيري)",
 "珊瑚色": "مَرْجَان",
 "珊瑚蛇": "ثعبان مرجاني (أي من عدة ثعابين سامة من العالم الجديد مخططة ببراعة بالأحمر والأسود وإما الأصفر أو الأبيض؛ واسعة الانتشار في أمريكا الجنوبية والوسطى) / ثعبان مرجاني (أي من ثعابين سامة متنوعة من فصيلة العربيد في آسيا وأفريقيا وأستراليا)",
 "珍": "نَادِر / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "珍か": "نَادِر",
 "珍しい": "نَادِر / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "珍中の珍": "عُمْلَة نَادِرَة, نَادِرَة (شخص نادر أو فريد من نوعه)",
 "珍事": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "珍味": "خفة, رشاقة (خفة في الحركة أو الأسلوب) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / حذاقة, دبلوماسية (التعامل بمهارة ودقة مع المواقف) / رقة, هشاشة (نقص القوة البدنية)\nمثال: رقة لمستها",
 "珍品": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "珍奇": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "珍妙": "كْوِير",
 "珍希": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "珍無類": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "珍珠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "珍珠母": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)",
 "珍田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "珍稀": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "珍糞漢": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل)",
 "珍紛漢": "ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل)",
 "珍紛漢紛": "غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب) / غير مفهوم, مبهم (ملفوظ أو منطوق بشكل سيء، أو طغت عليه الضوضاء)",
 "珍談": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "珍貴": "ثَمِين",
 "珍道具": "جِهَاز",
 "珍重": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "珍鳥": "عُمْلَة نَادِرَة, نَادِرَة (شخص نادر أو فريد من نوعه)",
 "珠": "ضَرَّة / خرزة (كرة صغيرة بها ثقب في المنتصف) / حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / حبة, قطرة (شكل كروي وصغير)\nمثال: حبات العرق على جبهته / كَوْم / رَصَاصَة, رَصَاص",
 "珠孔": "نقير (فتحة دقيقة في جدار البويضة يدخل من خلالها أنبوب اللقاح)",
 "珠心": "نيوسيلة (الجزء المركزي لبويضة النبات؛ يحتوي على كيس الجنين)",
 "珠数": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "珠柄": "حبل سري (ساق بويضة أو بذرة النبات)",
 "珠海": "تْشُوهَاي, جُوخَاي",
 "珠玉": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "珠皮": "غِطَاء, لِحَاف (غطاء واقٍ خارجي مثل جلد الحيوان أو قشرة أو غلاف بذرة أو قشر أو صدفة)",
 "珠芽": "بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "珠貝": "صدفة القمر (بطنيات قدم بحرية لها أصداف مستديرة ناعمة تشكل أبراجاً قصيرة)",
 "珥とう": "سدادة أذن (سدادة من القطن أو الشمع أو المطاط يتم تركيبها في قناة الأذن للحماية من دخول الماء أو الضوضاء العالية) / سدادة أذن (سماعة) (سماعة أذن يتم إدخالها في قناة الأذن)",
 "珥璫": "سدادة أذن (سدادة من القطن أو الشمع أو المطاط يتم تركيبها في قناة الأذن للحماية من دخول الماء أو الضوضاء العالية) / سدادة أذن (سماعة) (سماعة أذن يتم إدخالها في قناة الأذن)",
 "珪ニッケル鉱": "غارنيريت (معدن أخضر يتكون من سيليكات النيكل والمغنيسيوم المائية؛ مصدر للنيكل)",
 "珪化物": "سيليسيد (أي من مركبات السيليكون المختلفة مع عنصر أو شق أكثر إيجابية كهربائية)",
 "珪岩": "كوارتزيت (صخر متحول صلب يتكون أساساً من بلورات الكوارتز المتشابكة)",
 "珪灰石": "ولاستونيت (معدن أبيض أو رمادي يوجد عادة في الحجر الجيري المتحول؛ سيليكات الكالسيوم)",
 "珪石": "ثاني أكسيد السيليكون, سيليكا",
 "珪砂": "رمل الكوارتز (رمل يتكون أساساً من الكوارتز، يستخدم كمادة خام رئيسية لإنتاج الزجاج التجاري)",
 "珪素樹脂": "راتنج السيليكون (مركب سيليكون بوليمري)",
 "珪肺": "سَحَار سِيلِيسِيّ",
 "珪肺症": "سَحَار سِيلِيسِيّ",
 "珪藻": "دياتوم, طحالب عصوية (طحالب مجهرية وحيدة الخلية تعيش في المياه المالحة أو العذبة ولها جدران خلوية مشبعة بالسيليكا)",
 "珪藻土": "تراب دياتومي (تربة خفيفة تتكون من بقايا دياتومات سيليكية وتستخدم غالباً كمادة ترشيح)",
 "珪質": "سيليسي (متعلق بـ أو يحتوي على أو يشبه السيليكا)\nمثال: الصخر الرملي هو حجر رملي سيليسي",
 "珪酸": "حمض السيليسيليك (مادة هلامية (سيليكا مائية)) / ثاني أكسيد السيليكون, سيليكا",
 "珪酸ナトリウム": "زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "珪酸塩": "سيليكات (ملح أو إستر مشتق من حمض السيليسيليك)",
 "班": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / فِرْقَة, جَمَاعَة",
 "班次": "ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "班長": "رئيس العمال, ملاحظ (شخص يمارس السيطرة على العمال)",
 "現": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / وَاقِع (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "現す": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "現ずる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "現つ": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / وَاقِع (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "現つ御神": "قَيْصَر, إِمْبْرَاطُور",
 "現つ神": "قَيْصَر, إِمْبْرَاطُور",
 "現なま": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "現に": "فِعْلًا",
 "現る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "現れ": "تَجَسَّد",
 "現れる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "現れ出る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "現わす": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "現われ": "تَجَسَّد",
 "現われる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "現われ出る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "現ナマ": "سيولة فورية, نقد جاهز (المال في شكل نقد متاح بسهولة)\nمثال: كانت زوجته دائماً مصدراً جيداً للنقد الجاهز",
 "現下": "تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "現人": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "現人神": "قَيْصَر, إِمْبْرَاطُور",
 "現今": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "現代": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار / العصر الحديث (الأوقات الحالية أو الحديثة)",
 "現代っ子": "ابْن شَوَارِع, مُتَمَرِّس (يملك الحيلة والدهاء اللازمَيْن للنجاة في البيئة الحضريّة) / مُتَطَوِّر, مُوَاكِب لِلعَصْر (مُتَوَافِق مَعَ أَحْدَث الأَفْكَار أَوِ الأَنْمَاط العَصْرِيَّة)",
 "現代ギリシャ語": "اللُّغَةُ الْيُونَانِيَّةُ الْحَدِيثَة",
 "現代主義": "حداثة, عصرنة (ممارسات نموذجية للحياة أو الفكر المعاصر) / حداثة (نوع من الفن والأدب يُحدث قطيعة واعية مع الأنواع السابقة) / حداثة, عصرية (صفة كونه حالياً أو من الحاضر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "現代化": "تَحْدِيث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره وتكلّم إليه،حدّثه قلبه:أعلمه،أحسّ مسبقاً بشيء،حدّث الشيء:جعله حديثاً،جدّده؛ حدّث بالنّعمة:أشاعها وشكر عليها)\nمثال: تم تحديث القاموس.",
 "現代用語": "مُوَلَّدَة / تَوْلِيد",
 "現代的": "عَصْرِيّ, حَدِيث",
 "現代舞踊": "رقص حديث (أسلوب من الرقص المسرحي ليس مقيداً مثل الباليه الكلاسيكي؛ حيث تكون الحركات معبرة عن المشاعر)",
 "現代英語": "الإنجليزية الحديثة (الإنجليزية منذ حوالي 1450)",
 "現代風": "حداثة, عصرية (صفة كونه حالياً أو من الحاضر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "現住所": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "現像": "إِعْمَار, تَعْمِير",
 "現像液": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو مهارة؛ في الاستخدام المعاصر، يُقصد به غالبًا «مُطَوِّر البرمجيات» أو «مُطَوِّر التطبيقات» أي شخص يعمل على تصميم وتطوير البرمجيات)",
 "現先": "إعادة شراء, استرداد (فعل إعادة شراء شيء تم بيعه سابقاً)",
 "現出": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "現品": "مقطرة (أداة عقاب سابقة تتكون من إطار خشبي ثقيل بفتحات يمكن فيها قفل قدمي (وأحياناً يدي) المخالف) / ملقط تثبيت الحيوانات (إطار لتقييد الحيوان أثناء تلقيه رعاية بيطرية أو أثناء وضع حدوة له) / دعامات بناء السفن (إطار يدعم قارباً أثناء البناء)",
 "現在": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / اِعْتِبَارًا مِن / اِبْتِدَاءً مِن / مُضَارِع, فِعْل مُضَارِع",
 "現在分詞": "اسم الفاعل (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "現在完了": "مضارع تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الحاضر)",
 "現在完了形": "مضارع تام (زمن تام يُستخدم للتعبير عن حدث اكتمل في الحاضر)",
 "現在形": "مُضَارِع, فِعْل مُضَارِع",
 "現在時制": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "現在時刻": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "現在進行形": "مضارع مستمر (زمن يُستخدم للتعبير عن حدث مستمر في وقت الكلام) / دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "現地": "بُقْعَة",
 "現地人": "أَصْلِيّ",
 "現地化": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "現地時間": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
