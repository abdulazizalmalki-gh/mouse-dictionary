 "羽振りのいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "羽振りのよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "羽振りの良い": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "羽板": "نَصْل الرِّيشَة (الجزء المسطح الشبيه بالشبكة من الريشة المكون من سلسلة من الأسلات على جانبي القصبة) / ريشة, شفرة (سطح مسطح يدور ويدفع ضد الهواء أو الماء) / ريشة توجيه, زعنفة (زعنفة مثبتة بذيل سهم أو قنبلة أو صاروخ لتثبيته أو توجيهه) / دوارة الرياح, ريشة الطقس (جهاز ميكانيكي مثبت على هيكل مرتفع؛ يدور بحرية لإظهار اتجاه الرياح)",
 "羽枝": "سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم' / ريشة (قسم من ورقة مقسمة ريشياً عادة)",
 "羽柄": "قصبة الريشة (العمود الفقري المجوف للريشة) / عود الوج, قصب الذريرة (نبات مستنقعات معمر ذو أوراق تشبه السيف وجذور عطرية) / قصب الذريرة (الجذر العطري لنبات الوج المستخدم طبياً) / كلاموس, نخيل القصب (أي نخيل آسيوي استوائي من جنس كلاموس؛ سيقانه الخفيفة القوية مصدر لعيدان الروتان)",
 "羽根": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟ / جَنَاح / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / رِيشَة",
 "羽根つき": "باتلدور (لعبة مضرب قديمة)",
 "羽根ペン": "إِبْرَة, شَوْكَة",
 "羽根突き": "باتلدور (لعبة مضرب قديمة)",
 "羽根車": "دافعة (شفرة الدوار (كما في ضاغط المحرك النفاث))",
 "羽根飾り": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "羽毛": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟",
 "羽毛ふとん": "زَغَبُ العَيْدَر (زغب بط العيدر) / دوفيت, لحاف ريشي (لحاف ناعم محشو عادة بريش البط)",
 "羽毛布団": "زَغَبُ العَيْدَر (زغب بط العيدر) / دوفيت, لحاف ريشي (لحاف ناعم محشو عادة بريش البط)",
 "羽球": "بَدْمِينْتُون, تِنِس اَلرِّيشَة",
 "羽白海鳩": "غلموت أسود, مور أسود (غلموت شمال الأطلسي)",
 "羽目": "لَجْنَة, لَجْنَة تَحْكِيم / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "羽目板": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة) / تلبيسة خشبية, وزرة جدارية (جدار مغطى بألواح (عادة خشبية) في جزئه السفلي)",
 "羽織る": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "羽翼": "مُسَاعَدَة, إِمْدَاد",
 "羽虫": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور)",
 "羽虱": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور)",
 "羽衣烏": "شحرور أحمر الجناح (شحرور من أمريكا الشمالية ذو بقع قرمزية على الأجنحة)",
 "羽衣甘藍": "كُرْنُب أَجْعَد",
 "羽衣虫喰": "حميراء أمريكية (طائر مغرد صائد للذباب يعيش في شرق أمريكا الشمالية، يتميز الذكر بلون برتقالي ساطع على الجوانب والأجنحة والذيل)",
 "羽軸": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي) / محور (محور ورقة مركبة أو نورة مركبة)\nمثال: تسبب السقوط في كسر ظهره",
 "羽釜": "عَرِيض الحَافَّة ((عن القبّعات) ذو حافّة عريضة)",
 "羽隠": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "羽隠し": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "羽隠虫": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "羽音": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "羽飾り": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "翁": "شَيْخ, عَجُوز / جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَهِيب, وَقُور (مثير للإعجاب والتبجيل بسبب عراقته وقِدَمه)",
 "翁草": "أُقْحُوَان / صَنَوْبَر, صنوبر",
 "翅": "جَنَاح",
 "翅翼": "جَنَاح",
 "翅鞘": "غمْد الجناح (أي من الأجنحة الأمامية القرنية في الخنافس وبعض الحشرات الأخرى التي تغطي وتحمي الأجنحة الخلفية الوظيفية)",
 "翌": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "習々": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "習いごと": "تَنْفِيذ",
 "習い事": "تَنْفِيذ",
 "習い性": "طبيعة ثانية (سلوك مكتسب تمت ممارسته لفترة طويلة لدرجة أنه يبدو فطريًا)",
 "習う": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "習わし": "عَادَة, عُرْف",
 "習作": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "習俗": "اِسْتِخْدَام",
 "習合": "توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام التصريفات)) / تلفيقية, توفيقية (اتحاد (أو محاولة دمج) أنظمة فكرية أو معتقدات مختلفة (خاصة في الدين أو الفلسفة))\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "習字": "الخط, فن الخط (الكتابة اليدوية الجميلة)",
 "習得": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "習性": "عَادَة / سُلُوك, تَصَرُّف",
 "習慣": "عَادَة / عَادَة, عُرْف",
 "習慣化": "اعتياد, تعود (تكيف عام مع ظروف بيئية غير متغيرة) / إدمان, اعتماد (التحمل غير الطبيعي والاعتماد على شيء يسبب التعود نفسياً أو جسدياً (خاصة الكحول أو المخدرات))",
 "習慣性": "مُسَبِّب لِلْإِدْمَان (يسبب أو يتميز بالإدمان)\nمثال: عقاقير تسبب الإدمان / مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "習慣性流産": "إجهاض متكرر (إجهاض تلقائي متكرر (غالباً لسبب غير معروف))",
 "習慣的": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "習熟": "إِمْكَان\nمثال: 彼はフランス語に習熟しようとした。 — حاول أن يتقن الفرنسية.",
 "習癖": "عَادَة",
 "習練": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "習習": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "翔ける": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "翔ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "翔る": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء) / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "翔んでる": "غَرِيب, مُثِيرٌ لِلدَّهْشَة ((غير رسمي) غَيْرُ تَقْلِيدِيٍّ بِشَكْلٍ لَافِت)",
 "翕然": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "翠玉": "زُمُرُّد / أَخْضَر زُمُرُّدِيّ, خَضْرَاء زُمُرُّدِيَّة (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا)\nمثال: ذلك الضوء أخضر.",
 "翠緑": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "翠色": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "翡翠": "سَلْدَج / قِرِلَّى / رَفْرَاف / يَشْم / يَشْب / سَلْدَج / قِرِلَّى / رَفْرَاف",
 "翡翠色": "أخضر يشمي (لون أخضر فاتح يتراوح من الأزرق المخضر إلى الأخضر المصفر)",
 "翡翠輝石": "جاديت (معدن أخضر صلب يتكون من سيليكات صوديوم ألمنيوم في شكل بلوري أحادي الميل؛ مصدر لليشم)",
 "翩々": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "翩翩": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "翩翻": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "翫味": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق. / تَقْدِير",
 "翮": "إِبْرَة, شَوْكَة",
 "翰墨": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "翰林院": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "翳": "خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "翳み": "خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "翳り": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "翹望": "اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "翻": "أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "翻す": "قَلَبَ / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "翻って": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "翻る": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / اضطراب, قلاقل (ثوران أو صخب غير منظم) / رفرفة (خفقان سريع غير طبيعي للأذينين في القلب (خاصة بنظم منتظم)؛ يمكن أن يؤدي إلى حصار القلب)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه / قَلَبَ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "翻刻": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "翻印": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "翻字": "نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "翻案": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "翻然": "فَجْأَةً / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "翻訳": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / فَكَّ تَّعْمِيَة, فَكَّ مُعَمَّى",
 "翻訳プログラム": "مُتَرْجِم / مُتَرْجِمَة / تُرْجُمَان",
