 "脂肪": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "脂肪ぶとり": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "脂肪便": "إسهال دهني (وجود كميات أكبر من المعتاد من الدهون في البراز الذي يكون رغوياً وكريه الرائحة وطافياً؛ عَرَض لاضطرابات استقلاب الدهون ومتلازمة سوء الامتصاص)",
 "脂肪吸引": "شفط الدهون (استئصال الشحم (خاصة لأغراض تجميلية) حيث يتم إزالة الأنسجة الدهنية الزائدة من تحت الجلد عن طريق الشفط)",
 "脂肪吸引法": "شفط الدهون (استئصال الشحم (خاصة لأغراض تجميلية) حيث يتم إزالة الأنسجة الدهنية الزائدة من تحت الجلد عن طريق الشفط)",
 "脂肪塞栓症": "انصمام دهني (حالة خطيرة تسد فيها الدهون شرياناً؛ يمكن أن تدخل الدهون مجرى الدم بعد كسر عظم طويل أو في حالة إصابة الأنسجة الدهنية أو نتيجة للكبد الدهني)",
 "脂肪太り": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "脂肪族化合物": "مركب أليفاتي (مركب عضوي يكون إما ألكان أو ألكين أو ألكاين أو مشتقاتها)",
 "脂肪油": "زيت ثابت (زيت حيواني أو نباتي غير متطاير)",
 "脂肪症": "بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "脂肪細胞": "خَلِيَّة دُهْنِيَّة",
 "脂肪組織": "دهن, شحم (نوع من أنسجة الجسم يحتوي على دهون مخزنة تعمل كمصدر للطاقة؛ كما أنه يوفر توسيداً وعزلاً للأعضاء الحيوية)\nمثال: حماهم النسيج الدهني من البرد القارس",
 "脂肪線": "عَلَامَة تَمَدُّد, عَلَامَة مَطّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "脂肪肉腫": "ساركومة شحمية (ساركومة الخلايا الدهنية)",
 "脂肪肝": "كَبِد دُهْنِيّ",
 "脂肪腫": "ورم شحمي (ورم يتكون من نسيج دهني)",
 "脂肪質": "دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "脂肪過多": "سِمْنَة, بَدَانَة",
 "脂肪過多症": "سِمْنَة, بَدَانَة",
 "脂肪酸": "حمض دهني (أي من فئة الأحماض الكربوكسيلية الأليفاتية الأحادية التي تشكل جزءاً من جزيء الدهون ويمكن اشتقاقها من الدهون عن طريق التحلل المائي)",
 "脂腺": "غُدَّة دُهْنيّة",
 "脂臀": "تراكم الدهون في الأرداف, ستياتوبيغيا (تراكم شديد للدهون في الأرداف)",
 "脂薬": "مِلَاط, جِبْس / مَرْهَم, دَهُون",
 "脂質": "لِيبِيد, دُهْنِيَّة",
 "脂質異常症": "فَرْط شَحْمِيَّات الدَّم",
 "脂身": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "脅え": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)\nمثال: خاف زيري نوعا ما.",
 "脅かし": "تَهْدِيد",
 "脅かす": "هَدَّدَ / أَنْذَرَ / فَاجَأَ, بَاغَثَ / أَخَافَ, أَرْعَبَ / هَدَّدَ / أَنْذَرَ",
 "脅し": "تَهْدِيد",
 "脅しつける": "هَدَّدَ / أَنْذَرَ",
 "脅しをかける": "هَدَّدَ / أَنْذَرَ",
 "脅しを掛ける": "هَدَّدَ / أَنْذَرَ",
 "脅し付ける": "هَدَّدَ / أَنْذَرَ",
 "脅し取る": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "脅す": "هَدَّدَ / أَنْذَرَ",
 "脅喝": "تَهْدِيد",
 "脅嚇": "تَرْهِيب, تَخْوِيف",
 "脅威": "تَهْدِيد",
 "脅迫": "تَهْدِيد",
 "脅迫的": "مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "脆い": "سَرِيعُ الكَسْر, هَشّ (قَلِيلُ المُرُونَة؛ يَسْهُلُ تَشَقُّقُهُ أَوِ انْكِسَارُهُ) / غَيْرُ مُلَدَّن, هَشّ ((لِلْمَعْدَنِ أَوِ الزُّجَاج) لَمْ يُلَدَّنْ وَبِالتَّالِي سَهْلُ التَّشَقُّقِ أَوِ الكَسْر) / جَافّ, قَاسٍ (يفتقر إلى الدفء والسخاء في الروح) / بريتل, توفي (سكر مكرمل مبرد في صفائح رقيقة) / رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "脆くも": "بِسُرْعَة, عَاجِلًا",
 "脆弱": "ضَعِيف",
 "脆弱性": "ضعف, قابلية الإصابة (الاستعداد للإصابة أو الهجوم) / عرضة للخطر, هشاشة (حالة كونه ضعيفاً أو مكشوفاً)\nمثال: عرضته للتقاضي",
 "脆性": "قرمشة, هشاشة (صلب ولكن ينكسر بسهولة)",
 "脇": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده) / بِالْقُرْب مِن, بِجَانِب / بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / خارج الـموضوع / جَانِب / صَفْحَة / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "脇が甘い": "عرضة / عُرْضَة لِلْجَرْح / هَشّ (رقيق أو ضعيف البنية؛ لين وسهل الكسر أو التفتيت) / ضَعِيْف",
 "脇の下": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده)",
 "脇役": "دور ثانوي, دور صغير (دور صغير)",
 "脇息": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "脇戸": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "脇机": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "脇柱": "حلق الباب, عارضة الباب (القائم الجانبي للباب)",
 "脇目もふらず": "قَلْبًا وَقَالَبًا",
 "脇目も振らず": "قَلْبًا وَقَالَبًا",
 "脇腹": "جَانِب / صَفْحَة / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "脇芽": "مَاصّ / مُغَفَّل",
 "脇道": "طريق جانبي (طريق فرعي يتفرع من طريق رئيسي) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "脇骨": "ضِلْع",
 "脈": "نَبْض, نَبْضَة / وَرِيد, عِرْق / سِلْسِلَة / أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "脈々": "مُتَوَاصِل, مُتَّصِل",
 "脈なし病": "التهاب الشرايين تاكاياسو, مرض انعدام النبض (اضطراب يتميز بغياب النبض في كلا الذراعين وفي الشرايين السباتية)",
 "脈を打つ": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "脈動": "نَبْض, نَبْضُ القَلْب",
 "脈打つ": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "脈拍": "نَبْض, نَبْضَة",
 "脈搏数": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "脈無し病": "التهاب الشرايين تاكاياسو, مرض انعدام النبض (اضطراب يتميز بغياب النبض في كلا الذراعين وفي الشرايين السباتية)",
 "脈理": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "脈石": "غَثّ, شَوْب (الحيوان والإنسان: عجف وهزل، ضد سمن؛ غَثَّت الشاة، ق)",
 "脈管": "وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "脈管学": "علم الأوعية الدموية (فرع العلوم الطبية الذي يدرس الأوعية الدموية والليمفاوية واضطراباتها)",
 "脈管炎": "التهاب الأوعية الدموية (التهاب وعاء دموي)",
 "脈管系": "الجهاز الوعائي (الأوعية والأنسجة التي تحمل أو تدور السوائل مثل الدم أو الليمف أو النسغ عبر جسم الحيوان أو النبات)",
 "脈絡": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "脈絡叢": "ضَفِيرَة مَشِيمَوِيَّة",
 "脈絡網膜炎": "التهاب المشيمية والشبكية (التهاب طبقة المشيمية خلف الشبكية)",
 "脈絡膜": "مَشِيمِيَّة",
 "脈翅類": "عصبيات الأجنحة (حشرة لها أجزاء فم قارضة وأربعة أجنحة غشائية كبيرة بعروق تشبه الشبكة)",
 "脈脈": "مُتَوَاصِل, مُتَّصِل",
 "脊柱": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره",
 "脊柱側彎症": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "脊柱側湾症": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "脊柱前弯症": "قَعَس",
 "脊柱後弯症": "حُدَاب",
 "脊柱管": "قناة شوكية, قناة فقرية (القناة في الفقرات المتعاقبة التي يمر عبرها الحبل الشوكي)",
 "脊梁": "سلسلة جبال, سلسلة جبلية (سلسلة من التلال أو الجبال)\nمثال: كان الوادي يقع بين سلسلتين من التلال / عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره",
 "脊椎": "عَمُود فَقْرِيّ / فَقَرَة",
 "脊椎カリエス": "داء بوت (سل العمود الفقري مع تدمير الفقرات مما يؤدي إلى انحناء العمود الفقري)",
 "脊椎側彎症": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "脊椎側湾症": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "脊椎動物": "فَقَارِيّ, فَقَارِيَّة",
 "脊椎炎": "التهاب الفقار (التهاب مفصل فقري؛ يتميز بالألم والتصلب)",
 "脊椎破壊": "السنسنة المشقوقة, الصلب المشقوق (عيب خلقي غير نادر تتشوه فيه فقرة؛ ما لم تتأثر عدة فقرات أو يكون هناك قيلة نخاعية سحائية، تكون الأعراض قليلة؛ يمكن تشخيصه عن طريق بزل السلى)",
 "脊椎骨": "فَقَرَة",
 "脊椎麻酔": "تخدير شوكي, تخدير نصفي (تخدير النصف السفلي من الجسم؛ ناتج عن إصابة الحبل الشوكي أو عن طريق حقن مخدر تحت الغشاء العنكبوتي المحيط بالحبل الشوكي)",
 "脊索": "حبل ظهري (بنية مرنة تشبه القضيب تشكل المحور الداعم للجسم في الحبليات الدنيا والفقاريات الدنيا وفي أجنة الفقاريات العليا)",
 "脊索動物": "حَبْلِيّ",
 "脊髄": "نُخَاع شَوْكِيّ",
 "脊髄小脳変性症": "دكتوراه في العلوم (درجة فخرية في العلوم)",
 "脊髄性小児麻痺": "شَلَل الْأَطْفَال",
 "脊髄液": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "脊髄灰白質炎": "شَلَل الْأَطْفَال",
 "脊髄炎": "التهاب النخاع (التهاب الحبل الشوكي)",
 "脊髄癆": "تابس ظهري, رنح حركي (زهري يصيب الحبل الشوكي يتميز بتنكس الخلايا العصبية الحسية وآلام طاعنة في الجذع والساقين ومشية غير مستقرة وسلس وبول وعجز جنسي)",
 "脊髄神経": "عصب شوكي (أي من الأزواج الـ 31 من الأعصاب الخارجة من كل جانب من الحبل الشوكي (كل منها متصل بالحبل بواسطة جذرين: بطني وظهري))",
 "脚": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "脚下照顧": "رحم الله امرَأً عرف قدر نفسه (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "脚光": "ضوء الكلس (مصباح يتكون من لهب موجه إلى أسطوانة من الجير مع عدسة لتركيز الضوء؛ كان يستخدم سابقاً لإضاءة المسرح) / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء",
 "脚半": "لفافة ساق, واقي ساق (غطاء للساق مصنوع من القماش أو الجلد يمتد من الركبة إلى الكاحل) / جرموق (حذاء يغطي الكاحل بجوانب مرنة) / سبات, غطاء حذاء (غطاء قماشي يغطي مشط القدم والكاحلين) / لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "脚本": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / سِينَارْيُو / خَطّ, حَرْف (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: تعبت من الكتابة.",
 "脚本家": "كاتب نصوص (شخص يكتب نصوصاً للمسرحيات أو الأفلام أو الدراما الإذاعية)",
 "脚気": "بري بري (عوز فيتامين ناتج عن نقص الثيامين (فيتامين ب1))",
 "脚注": "حاشية سفلية (ملاحظة مطبوعة توضع أسفل النص في صفحة مطبوعة)",
 "脚湯": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "脚病": "بري بري (عوز فيتامين ناتج عن نقص الثيامين (فيتامين ب1))",
 "脚立": "سلم مزدوج, سلم نقال (سلم محمول قابل للطي بمفصلات في الأعلى)",
 "脚絆": "لفافة ساق, واقي ساق (غطاء للساق مصنوع من القماش أو الجلد يمتد من الركبة إلى الكاحل) / جرموق (حذاء يغطي الكاحل بجوانب مرنة) / سبات, غطاء حذاء (غطاء قماشي يغطي مشط القدم والكاحلين) / لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "脚色": "تجسيد درامي, تمثيل مسرحي (تمثيل درامي) / درجمة, معالجة درامية (التحويل إلى شكل درامي (مسرحي أو تمثيلي))\nمثال: كانت المسرحية معالجة درامية لقصة قصيرة / تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما) / تنميق, زخرفة زائدة (زينة فائضة عن الحاجة) / تنميق, زخرفة (توضيح تفسير باستخدام تفاصيل زخرفية (أحياناً خيالية))\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة",
 "脚荷": "ثقل الموازنة, صابورة (أي مادة ثقيلة تستخدم لتثبيت سفينة أو منطاد) / كابح, موازن ضوء (جهاز كهربائي لبدء وتنظيم مصابيح الفلورسنت والتفريغ) / كابح, مقاومة الموازنة (مقاومة تدرج في دائرة لتعويض التغييرات (مثل تلك الناشئة عن تقلبات درجات الحرارة)) / ثبات, رزانة (سمة تميل لإعطاء الاستقرار في الشخصية والأخلاق؛ شيء يثبت العقل أو المشاعر)",
 "脚車": "عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة) / سبّاك معادن (عامل يصب المعدن المنصهر في منتجات نهائية)",
 "脚輪": "عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة للحركة) / رشاشة سكر (رجاجة ذات غطاء مثقوب لرش السكر البودرة) / سبّاك معادن (عامل يصب المعدن المنصهر في منتجات نهائية)",
 "脚部": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "脚長": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "脚長蜂": "دبور الورق (أي من عدة دبابير اجتماعية تبني أعشاشاً من مادة تشبه الورق)",
 "脚韻": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "脛": "قَصَبَة / شِين",
 "脛巾": "طماق, غطاء ساق (رداء يغطي الساق (يمتد عادة من الركبة إلى الكاحل))",
 "脛当": "واقي ساق (ملابس واقية صلبة يرتديها لاعبو الهوكي أو الماسك في البيسبول لحماية السيقان) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية)",
 "脛当て": "واقي ساق (ملابس واقية صلبة يرتديها لاعبو الهوكي أو الماسك في البيسبول لحماية السيقان) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية)",
 "脛節": "ظنبوب, قصبة الساق (العظم الداخلي والأسمك من بين عظمتي الساق البشرية بين الركبة والكاحل)",
 "脛肉": "عُرْقُوب",
 "脛骨": "ظنبوب, قصبة الساق (العظم الداخلي والأسمك من بين عظمتي الساق البشرية بين الركبة والكاحل)",
 "脯": "قَدِيد",
 "脱がす": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "脱ぎ捨てる": "تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه)",
 "脱ぎ脱ぎ": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "脱ぐ": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "脱け": "إِغْفَال / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "脱ける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "脱け出る": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً / تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "脱け殻": "قِشْرَة",
 "脱け毛": "تسريح, تمشيط (فعل تمرير المشط خلال الشعر)\nمثال: كان شعره بحاجة إلى تمشيط",
 "脱る": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "脱メタボ": "حمية, ريجيم (فعل تقييد تناول الطعام)",
