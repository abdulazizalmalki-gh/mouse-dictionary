 "肛門鏡": "منظار المستقيم (منظار لفحص المستقيم)",
 "肝": "كَبِد, كِبْد / سَودَة / شَجَاعَة, جَسَارَة / مَرْبِط الْفَرَس",
 "肝いり": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝がん": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝が太い": "جَرِيء, جَسُور",
 "肝っ玉": "أَحْشَاء",
 "肝に銘じる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "肝の据わった": "لَا يَتَزَعْزَع, وَقُور (لا يسهل إزعاجه أو إثارته؛ يتّسم بهدوء وضبط نفس شديدَين)",
 "肝を煎る": "إغاظة, انزعاج (غضب ناتج عن إثارة مزعجة) / التهاب بالاحتكاك, سحجة (ألم ودفء ناتج عن الاحتكاك)\nمثال: كان لديه سحجة سيئة على ركبته / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "肝ガン": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝入り": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝動脈": "شريان كبدي (شرايين تغذي الكبد)",
 "肝心": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "肝心要": "حَاسِم",
 "肝所": "مَرْبِط الْفَرَس",
 "肝斑": "كَلَف (سبب له كُلْفَة، أي كان أمرا صعبا وغير سهل أو طبيعي؛ جعل عليه كُلْفَة وثَمَنا كبيرا، أي كان غاليا عليه)\nمثال: كلف ذلك فاضل حياته.",
 "肝油": "زيت السمك, زيت كبد السمك (زيت دهني يتم الحصول عليه من أكباد الأسماك المختلفة)",
 "肝炎": "اِلْتِهَاب الْكَبِد",
 "肝煎": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝煎り": "حماية, رعاية (تأييد وتوجيه كريم)\nمثال: أقيمت البطولة تحت رعاية مجلس المدينة",
 "肝玉": "أَحْشَاء",
 "肝疾患": "مرض كبدي (مرض يصيب الكبد)",
 "肝癌": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝硬変": "تَشَمُّع, تَلَيُّف",
 "肝管": "قناة كبدية (القناة التي تصرف الصفراء من الكبد)",
 "肝細胞がん": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "肝細胞ガン": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "肝細胞癌": "سرطانة الخلية الكبدية, ورم كبدي (سرطانة الكبد)",
 "肝練り": "جَرُؤَ / تَحَدَّى / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "肝肥大": "تضخم الكبد (تضخم غير طبيعي للكبد)",
 "肝腎要": "حَاسِم",
 "肝臓": "كَبِد, كِبْد / سَودَة",
 "肝臓がん": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝臓ガン": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝臓炎": "اِلْتِهَاب الْكَبِد",
 "肝臓病": "مرض كبدي (مرض يصيب الكبد)",
 "肝臓癌": "سرطان الكبد (مرض ورمي خبيث في الكبد)",
 "肝臓茸": "فطر شريحة اللحم (فطر صالح للأكل شائع بقبعة بلون الكبد أو اللحم النيئ؛ وفير في جنوب شرق الولايات المتحدة)",
 "肝蛭症": "داء المتورقات (الإصابة بالمتورقة الكبدية؛ يحدث أحياناً تلف في الكبد)",
 "肝要": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "肝門": "باب الكبد (فتحة لدخول وخروج الأوعية الدموية الرئيسية من وإلى الكبد)",
 "肝門脈": "وريد بابي, وريد بابي كبدي (وريد قصير يحمل الدم إلى الكبد)",
 "肝静脈": "وريد كبدي (وريد يصرف الكبد؛ يصب في الوريد الأجوف)",
 "肝魂": "أَحْشَاء",
 "股": "أُرْبِيَّة, مَغْبَن / شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / فَخِذ, فَخْذ",
 "股ぐら": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "股上": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "股動脈": "شريان فخذي (الشريان الرئيسي للفخذ؛ وهو استمرار للشريان الحرقفي الظاهر)",
 "股布": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "股座": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "股座膏薬": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "股引": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "股引き": "ملابس داخلية طويلة (ملابس داخلية دافئة بأرجل طويلة)",
 "股抜き": "جِسْرٌ صَغِير (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "股肉": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "股釘": "أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / سلع أساسية (سلعة ضرورية يكون الطلب عليها ثابتاً) / دبوس دباسة / مسمار مشبك (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)",
 "股間": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "股関節": "مَفْصِل اَلْوَرْكِ",
 "肢": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "肢体": "طَرَف, عُضْو",
 "肢帯": "كورسيه, مشد (رداء داخلي نسائي ضيق ومشكّل) / حزام, زنار (شريط من مادة حول الخصر يقوي التنورة أو البنطال) / حزام (بنية مطوقة أو حلقية الشكل)",
 "肥": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "肥える": "اِزْدَادَ وَزْنًا, اِكْتَسَبَ وَزْنًا\nمثال: 肥えた鶏は卵を産まない。 — الدجاجات السمينة تبيض أقل.",
 "肥し": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "肥す": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "肥やし": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "肥やす": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "肥厚": "تثخين, تغليظ (فعل التغليظ أو التثخين) / مُتَزَايِد التَّعْقِيد (يَزْدَاد تَعْقِيدًا وَتَشَابُكًا) / تغلظ, عقدة (أي تضخم سميك) / مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف",
 "肥国": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "肥壺": "قَعَادَة",
 "肥大": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً / تضخم (تضخم غير طبيعي لجزء من الجسم أو عضو)",
 "肥大した": "متضخم ((عن عضو أو جزء من الجسم) متضخم بشكل مفرط نتيجة لزيادة حجم الخلايا المكونة له) / مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية) / مُتَضَخِّم (أكْبَر مِن الحَجْم الطَّبيعِيّ) / مُكَبَّر (كالصورة الفوتوغرافية؛ جُعل أكبر حجماً)\nمثال: ألياف عضلة القلب المتضخمة",
 "肥大化": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "肥料": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "肥沃": "خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل.",
 "肥沃な三日月地帯": "الهِلَال الخَصِيب",
 "肥満": "بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "肥満症": "سِمْنَة, بَدَانَة",
 "肥満細胞": "خَلِيَّة بَدِينَة, خَلِيَّة صَارِيَّة",
 "肥溜": "بِئْر تَسْرِيب, بَيَّارَة صَرْف",
 "肥溜め": "بِئْر تَسْرِيب, بَيَّارَة صَرْف",
 "肥立ち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "肥育": "فِي طَوْرِ التَّسْمِين (خَاضِعٌ لِعَمَلِيَّةِ التَّسْمِينِ اسْتِعْدَادًا لِلذَّبْحِ)",
 "肥胖": "سِمْنَة, بَدَانَة",
 "肩": "كَتِف, كِتْف\nمثال: 肩が痛い。 — لدي ألم في أكتافي.",
 "肩あて": "واقي كتف (ملابس واقية تتكون من وسادة صلبة مستديرة يرتديها لاعبو كرة القدم لحماية أكتافهم)",
 "肩かけかばん": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "肩かけカバン": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "肩がこる": "جِدِّيّ / جَدِّيّ, جَادّ\nمثال: 彼女は肩が凝る本を読む気にはなれなかった。 — لم تكن في المزاج المناسب للكتب الجادة.",
 "肩が凝る": "جِدِّيّ / جَدِّيّ, جَادّ\nمثال: 彼女は肩が凝る本を読む気にはなれなかった。 — لم تكن في المزاج المناسب للكتب الجادة.",
 "肩すかし": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / خَيْبَة أَمَل",
 "肩すかしをくわせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "肩すかしを食わせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "肩で風を切る": "تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة) / شِيك جِدًّا, فَخْم ((عامّيّة بريطانيّة) أَنِيق لِلغَايَة) / عامل متجول أسترالي (عامل أسترالي متجول يحمل ممتلكاته الشخصية في صرة أثناء سفره بحثاً عن عمل)",
 "肩に担ぐ": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "肩の力を抜く": "اِسْتَرْخَى",
 "肩ばら": "بريسكت, لحم الصدر (قطعة لحم من الصدر أو أسفل الصدر خاصة في البقر)",
 "肩ひも": "حمالة, شريط الكتف (شريط يمر فوق الكتف ويدعم ملابس أو حقيبة)",
 "肩をもつ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "肩を入れる": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "肩を持つ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "肩を貸す": "مد يد العون (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "肩バラ": "بريسكت, لحم الصدر (قطعة لحم من الصدر أو أسفل الصدر خاصة في البقر)",
 "肩代わり": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "肩先": "كَتِف, كِتْف",
 "肩入れ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "肩口": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "肩巾": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها)",
 "肩帯": "حزام صدري (دعامة هيكلية ترتبط بها الأطراف الأمامية للفقاريات)",
 "肩当": "واقي كتف (ملابس واقية تتكون من وسادة صلبة مستديرة يرتديها لاعبو كرة القدم لحماية أكتافهم)",
 "肩当て": "واقي كتف (ملابس واقية تتكون من وسادة صلبة مستديرة يرتديها لاعبو كرة القدم لحماية أكتافهم)",
 "肩息": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "肩掛": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها)",
 "肩掛け": "شَال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها)",
 "肩掛けかばん": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "肩掛けカバン": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "肩掛け鞄": "حقيبة كتف (حقيبة يد كبيرة يمكن حملها بحزام يوضع فوق الكتف)",
 "肩揚げが取れる": "بَلَغَ رُشْدَهُ",
 "肩揚げも取れる": "بَلَغَ رُشْدَهُ",
 "肩揚げを下ろす": "بَلَغَ رُشْدَهُ",
 "肩揚も取れる": "بَلَغَ رُشْدَهُ",
 "肩文字": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "肩書": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "肩書き": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "肩甲": "رِيشَة كَتِفِيَّة (ريشة تغطي كتف الطائر) / كتفي (متعلق بـ أو بالقرب من لوح الكتف) / وشاح كتف رهباني (رداء يتكون من قطعة طويلة وعريضة من القماش الصوفي تلبس فوق الكتفين مع فتحة للرأس؛ جزء من الزي الرهباني)",
 "肩甲帯": "حزام الكتف, قوس صدرية (القوس العظمي الذي يتكون من الترقوة ولوح الكتف في البشر)",
 "肩甲骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "肩章": "رتبة كتف, علامة الكتف (كَتَّافات تشير إلى الرتبة)",
 "肩紐": "حمالة, شريط الكتف (شريط يمر فوق الكتف ويدعم ملابس أو حقيبة)",
 "肩胛骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "肩身": "كَتِف, كِتْف / شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "肩身が広い": "فَخُور",
 "肩身の狭い": "خَجْلَان, خَجُول",
 "肩透かし": "تجنب, تحاشي (التجنب المتعمد؛ الابتعاد عن شيء أو منع حدوثه) / تنصل, تهرب (عدم أداء شيء بغيض (كما هو الحال عن طريق الخداع أو الحيلة) من المفترض أن تقوم به) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً / خَيْبَة أَمَل",
 "肩透かしをくわせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "肩透かしを食わせる": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "肩部": "كَتِف, كِتْف",
 "肩関節": "كتف, مفصل الكتف (مفصل كروي بين رأس عظم العضد وتجويف لوح الكتف)",
 "肩骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "肩高": "حارك (أعلى جزء من الظهر عند قاعدة العنق لحيوانات مختلفة خاصة حيوانات الجر)",
 "肯う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد. / صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "肯じる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯ずる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯んじる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯んずる": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肯定": "تَأْكِيد, تَوْكِيد / إِيحَاء ذَاتِيّ / إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "肯定応答": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "肯定文": "جُمْلَةٌ مُثْبَتَةٌ (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "肯定的": "إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "肯諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "肱": "ذِرَاع / سِلَاح / سَلَّحَ / عَضُد (مُعِين؛ قُوَّة)",
 "肱木": "شَرِيحَة",
 "育ち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "育ちがいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちがよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちが悪い": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "育ちが良い": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちのいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちのよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちの良い": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "育ちゆく": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "育ち行く": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "育つ": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "育て": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "育てあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "育ての親": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "育てる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / تنشئَة, تَرْبِيَة",
 "育て上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "育て親": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "育む": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "育休": "إجَازَة أُمُومَة",
 "育児": "رعاية الأطفال (خدمة تتضمن العناية بأطفال الآخرين)",
 "育児休暇": "إجَازَة أُمُومَة",
 "育児嚢": "جراب, جريب (حاوية صغيرة أو متوسطة الحجم لحفظ أو حمل الأشياء) / جيب ((في التشريح) بنية تشبه الكيس في العديد من الحيوانات (مثل الجرابيات أو الغوفر أو البجع)) / جيب, كيس (حيز مغلق)\nمثال: وجد عمال المناجم المحاصرون جيباً من الهواء",
 "育児学": "طب الأطفال (فرع الطب المعني بعلاج الرضع والأطفال)",
 "育児室": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "育児放棄": "إهمال الأطفال (فشل القائمين على الرعاية في توفير الرعاية العاطفية والجسدية الكافية للطفل)",
 "育児語": "كلام الأطفال (الكلام النامي للطفل الصغير) / محاكاة كلام الأطفال (تقليد شخص بالغ لكلام طفل صغير)",
 "育児院": "دَار الْأَيْتَام, مَيْتَم (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "育成": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَنَمِّر, نَاهِض (واقف على الرِّجل الخلفيَّة اليسرى مع رفع القوائم الأماميَّة والرأس جانبيّاً) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل)",
 "育成牛": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "育林": "زراعة الغابات (فرع علم الغابات الذي يتعامل مع تنمية ورعاية الغابات)",
 "育種": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "育種家": "مربي حيوانات, مُرَبٍّ (شخص يقوم بتربية الحيوانات بغرض التكاثر والإنتاج)",
 "育種所": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "育英": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / تَعْلِيم, ثَقَافَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "育英資金": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "育雛": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / استغراق في التفكير, وجوم (تأمل مرضي مستمر في مشكلة ما) / تحضين, حضن (الجلوس على البيض لفقسه بواسطة دفء الجسم)",
 "育雛器": "مربي حيوانات, مُرَبٍّ (شخص يقوم بتربية الحيوانات بغرض التكاثر والإنتاج)",
 "肺": "رِئَة, سَحَر",
 "肺うっ血": "احتقان رئوي (احتقان في الرئتين)",
 "肺がん": "سَرَطَان اَلرِّئَة",
 "肺ガン": "سَرَطَان اَلرِّئَة",
 "肺切除": "استئصال الرئة (إزالة جراحية لرئة (عادة لعلاج سرطان الرئة))",
 "肺切除術": "استئصال الرئة (إزالة جراحية لرئة (عادة لعلاج سرطان الرئة))",
 "肺動脈": "شريان رئوي (واحد من شريانين (فرعي الجذع الرئوي) يحملان الدم الوريدي من القلب إلى الرئتين)",
 "肺動脈弁": "صمام رئوي (صمام هلالي بين البطين الأيمن والشريان الرئوي؛ يمنع الدم من التدفق من الشريان عائداً إلى القلب)",
 "肺塞栓": "انصمام رئوي (انسداد الشريان الرئوي بمادة غريبة أو بجلطة دموية)",
 "肺塞栓症": "انصمام رئوي (انسداد الشريان الرئوي بمادة غريبة أو بجلطة دموية)",
 "肺循環": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "肺性心": "قلب رئوي (تضخم البطين الأيمن للقلب بسبب مرض في الرئتين أو الأوعية الدموية الرئوية)",
 "肺書": "رئة كتابية (عضو في العديد من العناكب يحتوي على العديد من الطيات الغشائية الرقيقة التي تشبه أوراق الكتاب)",
 "肺気胸": "استرواح الصدر (وجود غير طبيعي للهواء في التجويف الجنبي مما يؤدي إلى انخماص الرئة؛ قد يكون تلقائياً (بسبب إصابة في الصدر) أو مستحثاً (كعلاج لمرض السل))",
 "肺気腫": "انتفاخ الرئة (حالة غير طبيعية للرئتين تتميز بانخفاض وظيفة الجهاز التنفسي)",
 "肺活量": "سعة حيوية (الحد الأقصى لكمية الهواء التي يمكن زفرها بعد استنشاق أقصى قدر ممكن)",
 "肺炎": "ذَات اَلرِّئَة, اِلْتِهَاب رِئَوِيّ",
 "肺炎双球菌": "مكورة رئوية (بكتيريا تسبب الالتهاب الرئوي في الفئران والبشر)",
 "肺炎球菌": "مكورة رئوية (بكتيريا تسبب الالتهاب الرئوي في الفئران والبشر)",
 "肺炭疽": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "肺病": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "肺癌": "سَرَطَان اَلرِّئَة",
 "肺結核": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "肺胞": "حويصلة هوائية, سنخ (كيس صغير جداً لحمل الهواء في الرئتين؛ يتكون من التوسع النهائي للممرات الهوائية الدقيقة)",
 "肺胞炎": "التهاب الأسناخ (التهاب الأسناخ في الرئتين الناتج عن استنشاق الغبار؛ مع التعرض المتكرر قد تصبح الحالة مزمنة) / التهاب السنخ الجاف (التهاب في سنخ السن؛ يحدث أحياناً بعد قلع السن وفشل تكون جلطة دموية)",
 "肺腑": "رِئَة, سَحَر",
 "肺腺がん": "سَرَطَان اَلرِّئَة",
 "肺腺ガン": "سَرَطَان اَلرِّئَة",
 "肺腺癌": "سَرَطَان اَلرِّئَة",
 "肺臓": "رِئَة, سَحَر",
 "肺葉": "فص الرئة (أي من الفصوص الثلاثة للرئة اليمنى أو الفصين للرئة اليسرى)",
 "肺静脈": "وريد رئوي (أي من أربعة أوردة تحمل الدم الشرياني من الرئتين إلى الأذين الأيسر للقلب)",
 "肺鬱血": "احتقان رئوي (احتقان في الرئتين)",
 "肺魚": "سمكة رئوية (سمكة تتنفس الهواء ولها جسم ممدود وزعانف مزدوجة لحمية؛ تبني بعض الأنواع أغطية طينية مبطنة بالمخاط للنجاة من الجفاف)",
 "胃": "مَعِدَة, مِعْدَة",
 "胃の腑": "مَعِدَة, مِعْدَة",
 "胃もたれ": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "胃カメラ": "منظار المعدة (نوع من المناظير لفحص المعدة بصرياً) / تنظير المعدة (فحص بصري للمعدة عن طريق منظار المعدة الذي يتم إدخاله عبر المريء)",
 "胃カメラ検査": "تنظير المعدة (فحص بصري للمعدة عن طريق منظار المعدة الذي يتم إدخاله عبر المريء)",
 "胃内視鏡": "منظار المعدة (نوع من المناظير لفحص المعدة بصرياً)",
 "胃切除術": "تَكْمِيم المَعِدَة",
 "胃弱": "عسر الهضم (اضطراب في وظيفة الجهاز الهضمي يتميز بعدم الراحة أو حرقة المعدة أو الغثيان)",
 "胃洗浄": "مضخة معدة (مضخة شفط تستخدم لإزالة محتويات المعدة)",
 "胃洗浄器": "مضخة معدة (مضخة شفط تستخدم لإزالة محتويات المعدة)",
 "胃液": "عصارة معدية (إفرازات هضمية لغدد المعدة تتكون أساساً من حمض الهيدروكلوريك والموسين وإنزيمات الببسين والرينين والليباز)",
 "胃潰瘍": "قرحة معدية (قرحة هضمية في المعدة)",
 "胃炎": "التهاب المعدة (التهاب بطانة المعدة؛ غثيان وفقدان الشهية وعدم ارتياح بعد الأكل)",
 "胃痛": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "胃腸": "جهاز هضمي, قناة هضمية (ممر أنبوبي من الغشاء المخاطي والعضلات يمتد حوالي 8.3 متر من الفم إلى الشرج؛ وظيفته الهضم والإخراج)",
 "胃腸吻合術": "مفاغرة معدية معوية (إنشاء جراحي لفتحة بين جدار المعدة والأمعاء الدقيقة؛ يجرى عندما يتم إزالة الفتحة الطبيعية)",
 "胃腸炎": "التهاب المعدة والأمعاء (التهاب في المعدة والأمعاء)",
 "胃腸病": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "胃腸病学": "طب الجهاز الهضمي (فرع الطب الذي يدرس الجهاز الهضمي وأمراضه)",
 "胃腸風邪": "التهاب المعدة والأمعاء (التهاب في المعدة والأمعاء)",
 "胃袋": "مَعِدَة, مِعْدَة",
 "胃酸": "عُصَارَة هَضْمِيَّة",
 "胃鏡": "منظار المعدة (نوع من المناظير لفحص المعدة بصرياً)",
 "胆": "كَبِد, كِبْد / سَودَة / شَجَاعَة, جَسَارَة / مَرْبِط الْفَرَس / مرارة (كيس عضلي ملحق بالكبد يخزن الصفراء (التي يفرزها الكبد) حتى الحاجة إليها للهضم)",
 "胆のう": "مرارة (كيس عضلي ملحق بالكبد يخزن الصفراء (التي يفرزها الكبد) حتى الحاجة إليها للهضم)",
 "胆のう炎": "التهاب المرارة (التهاب المرارة)",
