 "自治領": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "自涜": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "自滅": "انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "自滅的": "اِنْتِحَارِيّ, مُدَمِّرٌ لِلذَّات (خطير على النفس أو على المصالح الشخصيّة)",
 "自然": "طَبِيعَة, طبيعة / طَبِيعِيّ / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "自然の摂理": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "自然主義": "طبيعية ((فلسفة) المذهب القائل بأن العالم يمكن فهمه بمصطلحات علمية دون اللجوء إلى تفسيرات روحية أو خارقة للطبيعة) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "自然主義者": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان)) / طبيعاني, فيلسوف الطبيعة (مدافع عن العقيدة القائلة بأن العالم يمكن فهمه بالمصطلحات العلمية)",
 "自然人類学": "أنثروبولوجيا فيزيائية (فرع الأنثروبولوجيا الذي يتعامل مع نشأة وتنوع البشر)",
 "自然保護区": "مَحْمِيَّة طَبِيعِيَّة",
 "自然免疫": "مناعة طبيعية, مناعة فطرية (مناعة ضد المرض تحدث كجزء من التكوين البيولوجي الطبيعي للفرد)",
 "自然出産": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "自然分娩": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "自然分離": "انتزاع, قَلْع (تمزيق قسري أو فصل جراحي لجزء من الجسم عن آخر) / اجتثاث, انحراف النهر (تغير مفاجئ في مجرى النهر الذي يشكل الحدود بين قطعتين من الأرض مما يؤدي إلى فقدان جزء من أرض مالك واحد وزيادة لاحقة في أرض آخر)",
 "自然史": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "自然哲学": "فيزياء (علم المادة والطاقة وتفاعلاتهما)\nمثال: مادته المفضلة كانت الفيزياء",
 "自然地理": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "自然地理学": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "自然学": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "自然対数": "لوغاريتم طبيعي",
 "自然崇拝": "عبادة الطبيعة (نظام ديني يؤله ويعبد القوى والظواهر الطبيعية)",
 "自然律": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "自然放射線": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "自然数": "عَدَد طَبِيعِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "自然林": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط البشري)",
 "自然治療": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "自然治癒": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "自然法": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "自然法則": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "自然流産": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "自然消滅": "شَبَح, خَيَال",
 "自然淘汰": "اِنْتِقَاءٌ طَبِيعِيّ",
 "自然災害": "كارثة طبيعية",
 "自然物": "جِسْم طَبِيعِيّ (جسم موجود في الطبيعة؛ ليس من صنع الإنسان)",
 "自然状態": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "自然現象": "ظاهرة طبيعية (جميع الظواهر التي ليست اصطناعية)",
 "自然環境": "بِيئَة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة.",
 "自然界": "طَبِيعَة, طبيعة",
 "自然療法": "علاج طبيعي, نعتالوباثي (طريقة لعلاج المرض باستخدام الغذاء والتمارين والحرارة لمساعدة عملية الشفاء الطبيعية)",
 "自然療法士": "معالج طبيعي (معالج يمارس العلاج الطبيعي (غير الدوائي))",
 "自然発火": "احتراق ذاتي (اشتعال مادة (مثل الخرق الزيتية) ناتج عن عملية أكسدة داخلية)",
 "自然発生": "تولد ذاتي, نشوء تلقائي (ظاهرة عضوية افتراضية يتم من خلالها إنشاء الكائنات الحية من مواد غير حية)",
 "自然的": "طَبِيعِيّ",
 "自然石": "حجر الحقل (حجر يوجد بشكل طبيعي في الحقول؛ يستخدم غالباً كمواد بناء)",
 "自然神学": "اللاهوت الطبيعي (لاهوت يرى أن معرفة الله يمكن اكتسابها عن طريق العقل البشري دون مساعدة الوحي الإلهي)",
 "自然神教": "رُبُوبِيَّة",
 "自然科学": "علوم طبيعية (العلوم المعنية بدراسة العالم المادي وظواهره)",
 "自然科学者": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان))",
 "自然言語": "لُغَةْ طَبِيعِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "自然言語処理": "مُعَالَجَة اللُّغَات الطَبِيعِيَّة",
 "自然資源": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "自然選択": "اِنْتِقَاءٌ طَبِيعِيّ",
 "自然霊": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / عنصري (متعلق بـ أو كونه عنصراً (كيميائياً)) / جوهري, عاصف (متعلق بالظروف الجوية القاسية)\nمثال: كبريت عنصري",
 "自然食": "طعام صحي (أي طعام طبيعي أو محضر يعتقد شعبياً أنه يعزز الصحة الجيدة)",
 "自爆": "عَمَلِيَّة تَفْجِيرِيَّة إِنْتِحَارِيَّة, عَمَلِيَّة تَفْجِيرِيَّة",
 "自爆テロ": "عَمَلِيَّة تَفْجِيرِيَّة إِنْتِحَارِيَّة, عَمَلِيَّة تَفْجِيرِيَّة",
 "自用": "مُتَعَنِّت",
 "自由": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "自由がきかない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "自由が利かない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "自由が効かない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "自由に": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "自由の女神": "تِمْثَال الْحُرِّيَّة\nمثال: 自由の女神はアメリカの象徴である。 — تمثال الحرية رمزٌ لأمريكا.",
 "自由の女神像": "تِمْثَال الْحُرِّيَّة",
 "自由の身": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "自由エネルギー": "طاقة ((في الفيزياء) كمية ديناميكية حرارية تكافئ قدرة نظام فيزيائي على القيام بشغل؛ وحدات الطاقة هي الجول أو الإرج)\nمثال: يمكن للطاقة أن تتخذ أشكالاً متنوعة",
 "自由ソフトウェア": "بَرْمَجِيَّات حُرَّة",
 "自由三昧": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由世界": "الْعَالَم الْحُرّ",
 "自由主義": "لِيبْرَالِيَّة",
 "自由主義者": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / تحرري, ليبرالي (متسامح مع التغيير؛ غير مقيد بالسلطوية أو الأرثوذكسية أو التقاليد) / حُرّ, مُتَصَرِّف (غير حرفيّ في الترجمة أو التفسير) / جَوَاد, سَخِيّ اليَد (يُعطي أو يُمنح بسخاء وبلا تردد)",
 "自由人": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل)",
 "自由党": "الحزب الليبرالي (حزب سياسي في أستراليا وكندا ودول أخرى، وسابقاً في بريطانيا العظمى)",
 "自由刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "自由労働者": "مُياوِم",
 "自由勝手": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由化": "تحرير, تخفيف القيود (عملية جعل الشيء أقل صرامة)",
 "自由参加": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / اِخْتِيَارِيّ",
 "自由国": "ولاية حرة (أي ولاية كانت تحظر العبودية قبل الحرب الأهلية الأمريكية)",
 "自由型": "أسلوب حر, سباحة حرة (سباق (كما في السباحة) يمتلك فيه كل متسابق حرية اختيار الأسلوب الذي سيستخدمه)",
 "自由契約": "انتقال حر ((رياضة) حالة اللاعب المحترف الحر في التفاوض على عقد للعب لأي فريق) / حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً)) / عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "自由契約選手": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل) / لاعب حر ((في الرياضة) رياضي محترف حر في توقيع عقد للعب مع أي فريق)",
 "自由奔放": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة) / حُرّ, مُنْطَلِق (خالٍ من القيود أو القواعد)",
 "自由帳": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "自由度": "درجة الحرية ((إحصاء) متغير غير مقيد في توزيع التردد) / درجة الحرية (واحدة من الحد الأدنى لعدد المعاملات اللازمة لوصف حالة نظام فيزيائي)",
 "自由形": "أسلوب حر, سباحة حرة (سباق (كما في السباحة) يمتلك فيه كل متسابق حرية اختيار الأسلوب الذي سيستخدمه)",
 "自由思想": "ربوبية, فكر حر (شكل من أشكال العقلانية اللاهوتية يؤمن بالله على أساس العقل دون الرجوع إلى الوحي)",
 "自由思想家": "مفكر حر (شخص يرفض الدين)",
 "自由恋愛": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "自由意志": "حُرِّيَّة الْإِرَادَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "自由意志論": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "自由戦士": "محارب للحرية",
 "自由時間": "رَاحَة, خُلُو مِنَ الْعَمَل\nمثال: いくらか自由時間があるときは、いつもクラシック音楽を聴くのが楽しみだ。 — أحب دائما أن أستمع للموسيقى الكلاسيكية عندما يكون لدي وقت فارغ.",
 "自由業": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "自由権": "حرية مدنية (حق فردي أساسي يحميه القانون ويُعبر عنه بالحصانة من التدخل الحكومي غير المبرر) / حرية سياسية, حرية مدنية (حرية الفرد في ممارسة حقوقه كما تضمنها قوانين البلاد)",
 "自由民": "أحرار (الناس الذين يتمتعون بالحرية)\nمثال: موطن الأحرار والشجعان",
 "自由気まま": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由港": "ميناء حر (ميناء مفتوح بشروط متساوية لجميع السفن التجارية) / منطقة حرة, ميناء حر (منطقة مجاورة للميناء حيث يمكن استلام البضائع المعدة لإعادة الشحن وتخزينها دون دفع رسوم جمركية)",
 "自由研究": "بحث علمي, مشروع بحثي (البحث في الأسئلة التي تطرحها النظريات والفرضيات العلمية)",
 "自由自在": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "自由至上主義": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "自由落下": "انخفاض حاد, سقوط (انخفاض حاد ومفاجئ في كمية ما) / سقوط حر (حركة السقوط المثالية لشيء يخضع فقط لمجال الجاذبية)\nمثال: انخفاض بمقدار 57 نقطة في مؤشر داو جونز",
 "自由裁量": "دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "自由詩": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "自由貿易": "تِجَارَة حُرَّة",
 "自由連想": "تداعي حر (عملية تفكير تقترح فيها الأفكار (كلمات أو صور) أفكاراً أخرى في تسلسل)",
 "自由都市": "مَشَاعِيَّة",
 "自由電子": "إِلِكْتْرُون حُرّ (إلكترون غير مرتبط بذرة أو أيون أو جزيء ولكنه حر الحركة تحت تأثير مجال كهربائي)",
 "自画": "بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "自画像": "بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "自発": "تِلْقَائِيَّة, عَفْوِيَّة (صفة كون الشيء عفوياً ونابعاً من مشاعر طبيعية دون قيد)\nمثال: عفوية ضحكته",
 "自発性": "تِلْقَائِيَّة, عَفْوِيَّة (صفة كون الشيء عفوياً ونابعاً من مشاعر طبيعية دون قيد)\nمثال: عفوية ضحكته",
 "自発的": "تِلْقَائِيّ, مُرْتَجَل (يُقال أو يُفعل دون تخطيط أو كتابة مسبقة) / تلقائي, عفوي (يحدث أو ينشأ دون سبب خارجي ظاهر)\nمثال: ضحك عفوي",
 "自白": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)",
 "自白剤": "مصل الحقيقة (عقار مخدر وريدي له تأثير منوم؛ يحفز الاسترخاء ويضعف الموانع؛ يُعتقد أنه يدفع الناس للتحدث بحرية)",
 "自省": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "自知": "معرفة الذات (فهم لنفسك وأهدافك وقدراتك)",
 "自社株購入権": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "自称": "مُنَصِّبٌ نَفْسَهُ (يصف نفسه بصفة ما دون تأييد من الآخرين) / مُتَكَلِّم",
 "自立": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "自立型": "قَائِمٌ بِذَاتِه, مُسْتَقِلّ (قادر على العمل بشكل مستقلّ دون الاعتماد على غيره)",
 "自筆": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "自粛": "تمالك النفس (إظهار التحفظ المفروض على الذات)\nمثال: اعتدال فعال في النقاش",
 "自粛警察": "مُعَيَّن ذَاتِيًّا (عيّن نفسه بنفسه دون تفويض من جهة أخرى)",
 "自給": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自給率": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自給自足": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自練": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自罰": "عقاب الذات (عقاب يوقعه الشخص على نفسه)",
 "自署": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "自習書": "كريبج (لعبة ورق (عادة للاعبين اثنين) يتم فيها توزيع ست أوراق لكل لاعب ويتخلص من ورقة أو اثنتين) / المهملات (البطاقات التي يتخلص منها اللاعبون في لعبة الكريبج) / سرير أطفال, مهد (سرير أطفال ذو جوانب عالية مصنوعة من شرائح خشبية أو قضبان) / صومعة صغيرة, مخزن حبوب (صندوق أو مخزن لتخزين الحبوب)",
 "自臭症": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "自若": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "自虐": "تعذيب النفس, جلد الذات (ضيق مفروض ذاتياً)",
 "自虐ネタ": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "自虐的": "تعذيب النفس, جلد الذات (ضيق مفروض ذاتياً)",
 "自衛": "دِفَاع عَنِ النَّفْسِ",
 "自衛団": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "自衛官": "دِفَاع عَنِ النَّفْسِ",
 "自衛消防隊": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "自衛艦": "دِفَاع عَنِ النَّفْسِ",
 "自衛艦隊": "دِفَاع عَنِ النَّفْسِ",
 "自衛隊": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "自衛隊法": "دِفَاع عَنِ النَّفْسِ",
 "自衛隊派遣": "دِفَاع عَنِ النَّفْسِ",
 "自裁": "مُنْتَحِر, مُنْتَحِرَة",
 "自製": "مَنْزِلِيّ",
 "自覚": "وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني. / ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "自覚的": "خَجُول, مُرْتَبِك مِنْ ذَاتِهِ (واعٍ بشكل مفرط وغير مريح بمظهره أو سلوكه) / مُدْرِكٌ لِنَفْسِهِ, وَاعٍ بِذَاتِهِ (مُدْرِكٌ لِذَاتِهِ كَفَرْدٍ وَلِكَيْنُونَتِهِ وَأَفْعَالِهِ وَأَفْكَارِهِ)",
 "自記気圧計": "باروجراف, مسجل الضغط الجوي (بارومتر مسجل؛ يسجل تلقائياً التغيرات في الضغط الجوي على الورق)",
 "自記温度計": "مقياس حرارة ذاتي التسجيل (مقياس حرارة يسجل درجة الحرارة تلقائياً)",
 "自認": "إدخال, قبول (فعل السماح لشخص بالدخول) / حق الدخول, دخول (الحق في الدخول) / إِقْرَار, اعْتِرَاف (إقرار بصحة شيء ما) / تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)\nمثال: تم إجراء الجراحة عند إدخاله الثاني إلى العيادة",
 "自警": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين)",
 "自警団": "دِفَاع عَنِ النَّفْسِ",
 "自警団員": "عضو لجنة الأمن الأهلية (عضو في لجنة الأمن الأهلية)",
 "自讃": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "自負": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自負心": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "自販機": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "自責": "إدانة النفس, اتهام الذات (اعتراف بأنك فشلت في فعل أو أن تكون شيئاً تعلم أنه يجب عليك فعله أو كونه)",
 "自責の念": "شعور بالذنب (ندم ناتج عن الشعور بالمسؤولية عن جريمة أو خطأ ما)",
 "自責点": "ركضة مكتسبة (ركضة لم تُسجل نتيجة لخطأ من الفريق الآخر)",
 "自費": "مِنَ الجَيْب, نَقْدِيّ (يستلزم إنفاق مال نقديّ مباشر)",
 "自賛": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "自走式": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه) / ذَاتِيّ الحَرَكَة, ذَاتِيّ الدَّفْع (يحتوي في ذاته على وسيلة الدفع أو الحركة)",
 "自走砲": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه) / ذَاتِيّ الحَرَكَة, ذَاتِيّ الدَّفْع (يحتوي في ذاته على وسيلة الدفع أو الحركة)",
 "自足": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "自身": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "自身番": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "自車学": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自車校": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "自転": "دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "自転車": "دَرَّاجَة (مَرْكَبَة من عجلتين أو ثلاث، ولها مقعد واحد عادة، مثل الدراجة الهوائية والدراجة النارية؛ دراجة هوائية. (تخصيص)) / بسْكليت / بِسِكْليت / بِسْكْلات\nمثال: كين يريد دراجة.",
 "自転車をこぐ": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "自転車を漕ぐ": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "自転車タクシー": "ريكشو دراجة, عربة نقل بدواسات (دراجة ثلاثية العجلات (تدفع عادة بالتدويس)؛ تستخدم في الشرق لنقل الركاب بالأجرة)\nمثال: الأولاد الذين كانوا يسحبون الريكشو سابقاً يركبون الآن دراجات الريكشو",
 "自転車競技": "سباق الدراجات (سباق بين راكبي الدراجات الهوائية)",
 "自転車競技場": "فيلودروم (مضمار بيضاوي مائل لسباق الدراجات أو الدراجات النارية)",
 "自重": "عزة نفس, كرامة (صفة الجدارة بالتقدير أو الاحترام)\nمثال: كان من دون كرامته أن يغش / عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / حمل ميت (حمل ثابت على هيكل (مثل الجسر) بسبب وزن الهيكل المدعوم نفسه)",
 "自閉": "تَوَحُّد, مَرَض التَّوَحُّد",
 "自閉スペクトラム症": "اِضْطِرَاب طَيْف التَّوَحُّد",
 "自閉症": "تَوَحُّد, مَرَض التَّوَحُّد",
 "自閉症スペクトラム症": "اِضْطِرَاب طَيْف التَّوَحُّد",
 "自閉症スペクトラム障害": "اِضْطِرَاب طَيْف التَّوَحُّد",
 "自閉症協会": "آسا",
 "自首": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "自鳴琴": "صندوق موسيقى (ينتج الموسيقى عن طريق دبابيس على أسطوانة دوارة تضرب الأسنان المضبوطة للوحة معدنية تشبه المشط)",
 "臭い": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز) / مُريب, مَشبوه\nمثال: あいつが臭い。 — يبدو مريباً. / مُبَالِغ فِي التَّمْثِيل (مُتَكَلَّف فِي الأَدَاء الدِّرَامِيّ؛ مُبَالَغ فِيه) / أَخْرَق / رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة. / جَوّ, هَالَة (صفة مميزة ولكن غير ملموسة تحيط بشخص أو شيء) / إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس) / أورة, نسمة (إحساس (مثل نسيم بارد أو ضوء ساطع) يسبق بداية اضطرابات معينة مثل نوبة الصداع النصفي أو نوبة الصرع)\nمثال: جو من الغموض",
 "臭いがする": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة.",
 "臭い消し": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "臭う": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة. / نَتُنَ, نَتِنَ / أَشَعَّ ((أَشَعَّتِ) الشمسُ: نَشَرَتْ شْعاعها؛ أَشَعَّتِ النارُ: أَرسلت ضوءها وحرارتها)\nمثال: أشع الإسبرانتو!",
 "臭み": "تَصَنُّع, تَكَلُّف",
 "臭わす": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "臭わせる": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "臭化カリウム": "بروميد البوتاسيوم",
 "臭化メチル": "بروميد الميثيل",
 "臭化水素": "بروميد الهيدروجين (غاز عديم اللون ينتج حمض الهيدروبروميك عند ذوبانه في الماء)",
 "臭化物": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط) / بروميد (أي من أملاح حمض الهيدروبروميك؛ كان يستخدم سابقاً كمهدئ ولكن تم استبداله عموماً بأدوية أكثر أماناً)",
 "臭化銀": "بروميد الفضة (بروميد يغمق لونه عند تعرضه للضوء؛ يُستخدم في صنع المستحلبات الفوتوغرافية)",
 "臭味": "نَتُنَ, نَتِنَ / تَصَنُّع, تَكَلُّف",
 "臭橘": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة وثماراً زخرفية ولكن غير صالحة للأكل: تستخدم كأصل في التطعيم وللأسوار الحية)",
 "臭気": "نَتُنَ, نَتِنَ",
 "臭気止め": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "臭素": "بُرُوم, بُرُومِين",
 "臭素紙": "ورق بروميد (ورق تصوير حساس بمستحلبات بروميد الفضة ينتج نغمات صور سوداء محايدة أو زرقاء سوداء باردة)",
 "臭素酸": "حمض البروميك (حمض غير مستقر يستخدم كعامل مؤكسد)",
 "臭覚": "حاسة الشم, شم (الملكة التي تمكننا من تمييز الروائح)",
 "臭跡": "أَرِيج",
 "臭鼠": "فَأْرُ المِسْك",
 "至": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟",
 "至って": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "至らない": "ناقص-غير كامل",
 "至らぬ": "ناقص-غير كامل",
 "至らぬ点": "عيب, قصور (خلل أو نقص)\nمثال: هذا التفسير هو عيب مؤسف لنقص المعلومات لدينا",
 "至り": "زائدة, طرف (جزء خارجي من الجسم يبرز منه) / طرف قاصي (ذلك الجزء من الطرف الأبعد عن الجذع) / حد أقصى, طرف (المنطقة أو النقطة الخارجية أو الأبعد) / أقصى درجات, غاية (أعظم أو أقصى درجة)\nمثال: من المهم الحفاظ على دفء الأطراف",
 "至る": "بَلَغَ / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "至る所": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "至れりつくせり": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "至れり尽くせり": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "至れり尽せり": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "至上": "تَفَوُّق",
 "至上主義": "استعلاء, فوقية (الاعتقاد بأن مجموعة أو عرقاً معيناً يتفوق على الآخرين)\nمثال: استعلاء العرق الأبيض",
 "至上権": "تَفَوُّق",
 "至上者": "الْكَائِنُ الْأَسْمَى",
 "至人": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "至大": "عِمْلاق",
 "至妙": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "至宝": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "至尊": "قَيْصَر, إِمْبْرَاطُور",
 "至当": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "至心": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "至急": "مُسْتَعْجِل / بإلحاح, بشكل عاجل (بإلحاح شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "至急便": "بريد سريع (بريد يتم توزيعه بواسطة نظام سريع وفعال)",
 "至情": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "至極": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / قِمَّة",
 "至福": "تطويبة / سعادة قصوى, طوبى (حالة من السعادة العارمة)\nمثال: التطويبة المفضلة لديها هي 'طوبى للودعاء لأنهم يرثون الأرض'",
 "至福千年": "أَلْفِيَّة",
 "至福千年説": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "至聖所": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان يُحفظ تابوت العهد) / قُدْس الأَقْدَاس ((مجازياً) شيء يعتبر مقدساً أو لا يجوز انتهاكه)\nمثال: كل سياسي يخشى المساس بقدس الأقداس، نظام الضمان الاجتماعي",
 "至要": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "至誠": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "至軽風": "هواء خفيف (رياح تتحرك بسرعة 1-3 عقد؛ 1 على مقياس بوفورت)",
 "至近弾": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "至近距離": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "至適": "أَمْثَل, مِثَالِيّ (الأكثر استحساناً ضمن قيد معين صريح أو ضمني)",
 "至高": "أَعْلَى, سَيِّد (الأَعْظَم مَكَانَةً أَوْ سُلْطَةً أَوْ قُوَّةً) / أَسْمَى, سَامٍ (في أعلى درجة أو أقصاها؛ بالغ الشدة) / أَسْمَى, أَعْلَى (نهائي أو أخير في الحياة أو مسيرة التقدم) / أَسْمَى, أَعْلَى (الأعلى في التميز أو الإنجاز)",
 "致し方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "致し方ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "致す": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "致事": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "致仕": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "致命": "مُمِيت, قَاتِل",
 "致命的": "مُمِيت, قَاتِل",
 "致死": "مُمِيت",
 "致死因子": "جين مميت (أي جين له تأثير يسبب موت الكائن الحي في أي مرحلة من مراحل الحياة)",
 "致死性": "مُمِيت",
 "致死的": "مُمِيت",
 "致死遺伝子": "جين مميت (أي جين له تأثير يسبب موت الكائن الحي في أي مرحلة من مراحل الحياة)",
 "致死量": "جرعة مميتة (حجم الجرعة التي تسبب الموت)",
 "臺灣": "تَايْوَان, تَيْوَان (بلد في شرق آسيا عاصمته تايبيه)\nمثال: ستهاجم الصين تايوان.",
 "臼": "رَحًى (رَحَى: طاحون؛ مؤنثة، جمعها: أرحاء، أرحية، أرح، رَحِيّ، رِحِيّ، رِحًى، وأُرْحِي، ومِثل: رَحْوان ورَحْيان؛ ورَحَى: وَجْ، جمعه أرحاء، بمعنى الصدر)",
 "臼づく": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "臼搗く": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "臼歯": "ضِرْس",
 "臼砲": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "舁き上げる": "كَتِف, كِتْف",
 "舂き砕く": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "舂き米": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "舂く": "بدن السفينة, هيكل السفينة (الإطار أو الجسم الرئيسي للسفينة) / قشرة (كأس دائم متضخم عند قاعدة الفراولة أو التوت) / غِلاف, قِشْرَة خَارِجِيَّة (غطاء خارجي جاف لثمرة أو بذرة أو جوزة) / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "舂米": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "舅": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "興": "فَائِدَة",
 "興ざめ": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط) / كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / مخمد (لوحة حديدية متحركة تنظم تيار الهواء في موقد أو مدخنة أو فرن)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "興し": "إِعْمَار, تَعْمِير / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "興す": "نَشَّطَ, قَوَّى (جعل شخصًا أو شيئًا أكثر حيوية أو نشاطًا؛ حفَّز حركة أو نشاطًا في مجال معين)\nمثال: نشط البرنامج الآن. / أَطْلَقَ, قَذَفَ",
 "興る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "興亡盛衰": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "興信所": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "興味": "فَائِدَة",
 "興味が薄い": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "興味ない": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة) / غير مهتم, لا مبالٍ (ليس لديه أو لا يظهر اهتماماً)\nمثال: متفرج غير مهتم",
 "興味の薄い": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "興味をそそる": "حَدَّدَ ((حَدَّدَ) على الشَّيْء: أَقَامَ لَهُ حدا؛ (حَدَّدَ) عَلى فلَان: مَنعه من حريَّة التَّصَرُّف) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين)\nمثال: حدد له موعدا مع الطبيب.",
 "興味本位": "لَافِت, مُثِير لِلانْتِبَاه (يستحوذ على الانتباه ويأسره) / ضجة, مثير (يسبب اهتمامًا شديدًا أو فضولًا أو عاطفة قوية) / حسي (متعلق بـ أو معني بالإحساس)\nمثال: القشرة الحسية",
 "興味無い": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة) / غير مهتم, لا مبالٍ (ليس لديه أو لا يظهر اهتماماً)\nمثال: متفرج غير مهتم",
 "興味索然": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود) / غير مثير للاهتمام, ممل (لا يثير أي اهتمام أو انتباه أو فضول أو إثارة)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "興奮": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "興奮剤": "مُنَشِّط, مُنَبِّه",
 "興奮性": "استثارية, سرعة التأثر (سهولة الإثارة) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم)",
 "興奮薬": "منبه, منشط (عقار يسرع مؤقتاً بعض العمليات الحيوية)",
 "興廃": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "興敗": "قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "興業銀行": "بنك صناعي, شركة قروض صناعية (شركة تمويل تقدم قروضاً صغيرة للعمال الصناعيين)",
 "興産": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "興盛": "اِزْدِهَار, رَخَاء",
 "興行": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / صناعة الترفيه (المشاركون في توفير الترفيه: الراديو والتلفزيون والأفلام والمسرح)",
 "興行主": "منتج مسرحي, منظم عروض (راعٍ ذكر يحجز وينظم وسائل الترفيه العامة) / مقدم عروض (شخص ذكر ماهر في تقديم عروض فعالة)",
 "興行師": "منتج مسرحي, منظم عروض (راعٍ ذكر يحجز وينظم وسائل الترفيه العامة) / مقدم عروض (شخص ذكر ماهر في تقديم عروض فعالة)",
 "興起": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "興趣": "فَائِدَة",
 "興醒め": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط) / كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / مخمد (لوحة حديدية متحركة تنظم تيار الهواء في موقد أو مدخنة أو فرن)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "興銀": "بنك صناعي, شركة قروض صناعية (شركة تمويل تقدم قروضاً صغيرة للعمال الصناعيين)",
 "興隆": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "舌": "لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة) / لسان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان. / للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "舌ざわり": "مَلْمَس",
 "舌たるい": "لُثْغَة",
 "舌っ足らず": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "舌の根の乾かぬうち": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌の根の乾かぬ内": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌の根も乾かぬうち": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌の根も乾かぬ内": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "舌下": "تحت اللسان (يقع أسفل اللسان)",
 "舌下神経": "عصب تحت اللسان, عصب قحفي ثاني عشر (يغذي العضلات الداخلية لللسان وعضلات اللسان الأخرى)",
 "舌下腺": "غدة تحت اللسان (غدة لعابية صغيرة تنتج الميوسين (المكون اللزج للعاب)؛ توجد في البشر على جانبي الفم تحت اللسان)",
 "舌代": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "舌側": "لِسَانِيّ",
 "舌動脈": "شريان لساني (شريان ينشأ من الشريان السباتي الظاهر ويغذي الجانب السفلي من اللسان)",
 "舌咽神経": "عصب بلعومي لساني, عصب قحفي تاسع (عصب حسي للبلعوم ومؤخرة اللسان؛ تعصب الألياف الحركية العضلات التي ترفع البلعوم والحنجرة؛ يشمل أليافاً لاودية إلى العقدة الأذنية)",
 "舌圧子": "خافض لسان (خافض رقيق يستخدم للضغط على اللسان لأسفل أثناء فحص الفم والحلق)",
 "舌尖音": "ذِرْوِيّ, قِمِّيّ (يقع عند القمة أو الذروة)",
 "舌形動物": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية للثدييات)",
 "舌炎": "التهاب اللسان (التهاب اللسان)",
 "舌痛症": "ألم اللسان (ألم في اللسان)",
 "舌禍": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "舌端": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "舌端音": "رِقَاقِيّ, صَفِيحِيّ (مرتب في صفائح أو يتكون من رقائق)",
 "舌背音": "ظَهْرِيّ",
 "舌苔": "فَرْو / مِعْطَف, ثَوْبٌ مُفَرًّى / فَرَّى",
 "舌虫": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية للثدييات)",
 "舌触り": "مَلْمَس",
 "舌足らず": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "舌鋒": "لسان حاد, لسان سليط (طريقة مريرة أو نقدية في التحدث)",
 "舌鋒鋭い": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "舌長": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "舌革": "لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة) / لسان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "舌頂音": "إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة)",
 "舌頭": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "舌骨": "عظم لامي",
 "舌鮃": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "舍人": "خَادِم, خَادِمَة",
 "舎": "كُوخ, تَخْشِيبَة / بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "舎人": "خَادِم, خَادِمَة",
 "舎利別": "شَرَاب, قَطْر",
 "舎利塔": "ذخيرة مقدسة, وعاء الذخائر (حاوية تُحفظ فيها الآثار الدينية أو تُعرض (خاصة آثار القديسين))",
 "舎利塩": "كبريتات المغنيسيوم (ملح للمغنيسيوم)",
 "舎営": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "舎宅": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "舎密": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها) / كِيمِيَائِيّ, كِيمِيَاوِيّ\nمثال: هو يحب الكيمياء.",
 "舎弟": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "舐": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舐め": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舐める": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)\nمثال: その子犬は彼女の頬を舐めた。 — الكلب لعق خدها. / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / اِسْتَخَفَّ, اِسْتَهَانَ\nمثال: 俺をなめるな。 — لا تستخف بمقدرتي.",
 "舐めプレイ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / خسارة, هزيمة (نهاية غير ناجحة لصراع أو مسابقة)\nمثال: كانت هزيمة بفارق ضئيل",
 "舐め腐る": "تَرَفَّعَ",
 "舐め舐め": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / خسارة, هزيمة (نهاية غير ناجحة لصراع أو مسابقة)\nمثال: كانت هزيمة بفارق ضئيل",
 "舐る": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "舗": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان.",
 "舗石": "حَجَر رَصْف (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "舗装": "تبليط, رصف (فعل وضع مواد الرصف على منطقة ما) / رصيف (السطح المرصوف لطريق عام) / رصف, مادة رصف (مادة تستخدم لرصف منطقة ما)",
 "舗装機械": "آلة رصف (آلة لرصف الطرق)",
 "舞": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى)",
 "舞々": "حَلَزُون",
 "舞い": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى)",
 "舞い上がる": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "舞い戻る": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "舞い立つ": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "舞い踊る": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "舞い躍る": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "舞い風": "زَوْبَعَة",
 "舞う": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص. / برم, دوران سريع (عملية الدوران بسرعة) / تجربة, محاولة سريعة (محاولة عادة ما تكون قصيرة) / جلبة, دوامة (حركة مضطربة) / تلفيف, دوامة (شكل شيء يدور بسرعة)\nمثال: أدار الكرنك بقوة",
 "舞を舞う": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "舞人": "رَاقِص, رَاقِصَة",
 "舞台": "مَرْحَلَة / مُنَصَّة, مَسْرَح / إنتاج مسرحي, عمل مسرحي (إنتاج دراما على المسرح) / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم) / فص, مثبت (قاعدة تثبيت تتكون من قطعة معدنية (كما في خاتم أو مجوهرات أخرى) تثبت الحجر الكريم في مكانه) / إعداد المائدة (طقم مائدة لشخص واحد) / إطار, محيط (السياق والبيئة التي يوضع فيها شيء ما)\nمثال: كان الماس في مثبت ذهبي بسيط / فَلْكَة / كُرَة",
 "舞台係り": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "舞台効果": "مؤثر مسرحي (تأثير خاص يتم إنشاؤه على المسرح)",
 "舞台監督": "مخرج مسرحي (شخص يشرف على الممثلين ويوجه الحركة في إنتاج عرض مسرحي)",
 "舞台稽古": "بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "舞台背景": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "舞台芸術": "فنون أدائية (فنون أو مهارات تتطلب أداءً عاماً)",
 "舞台衣装": "بَذْلَة, بَدْلَة",
 "舞台袖": "كوليس, مجرى انزلاق (عضو خشبي محفور (مخدد) لاستيعاب لوح منزلق) / كواليس (لوح مسطح يقع في أجنحة المسرح)",
 "舞台装置": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)",
 "舞台裏": "بَعِيدًا عَن الأَنْظَار (ليس في العلن) / خَلْف الكَوَالِيس (خلف الكواليس؛ ليس على المسرح) / خلف الكواليس (يقع أو يحدث في منطقة المسرح غير المرئية للجمهور) / بَعِيد عَن الأَنْظَار, خَلْفَ الكَوَالِيس (مخفيّ عن النظر العامّ أو الاهتمام)\nمثال: تمت الصفقة بعيداً عن الأنظار",
 "舞台負け": "رَهَاب المَسْرَح",
 "舞台道具": "قطعة ديكور مستقلة (قطعة من المناظر تهدف إلى الوقوف بمفردها كجزء من إعداد المسرح)",
 "舞姫": "راقصة باليه (أنثى ترقص الباليه)",
 "舞手": "رَاقِص, رَاقِصَة",
 "舞立つ": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "舞舞": "حَلَزُون",
 "舞茸": "دجاجة الغابة, فطر دجاجة الغابة (فطر كبير صالح للأكل بني رمادي يشكل كتلة من القبعات المتداخلة تشبه الدجاجة إلى حد ما عند قاعدة الأشجار)",
 "舞萩": "نبات التلغراف, نبات الراقص (شجيرة آسيوية استوائية منتصبة تدور وريقاتها الجانبية الصغيرة على محاورها وتهتز صعوداً وهبوطاً تحت تأثير أشعة الشمس)",
 "舞踊": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى)",
 "舞踊家": "رَاقِص, رَاقِصَة",
 "舞踊曲": "موسيقى الرقص (موسيقى للرقص عليها) / موسيقى الرقص, موسيقى قاعة الرقص (نوع من الموسيقى الشعبية المؤلفة لرقص القاعات)",
 "舞踏": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "舞踏会": "ضَرَّة",
 "舞踏家": "رَاقِص, رَاقِصَة",
 "舞踏曲": "موسيقى الرقص (موسيقى للرقص عليها) / موسيقى الرقص, موسيقى قاعة الرقص (نوع من الموسيقى الشعبية المؤلفة لرقص القاعات)",
 "舞踏會": "ضَرَّة",
 "舞踏病": "داء الرقص, رقص (أي من الاضطرابات العصبية التنكسية المتعددة التي تتميز بحركات تشنجية للجسم والأطراف) / رقم الكلاب (رقم (حركات لا إرادية) في الكلاب)",
 "舞蹈": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى)",
 "舞風": "زَوْبَعَة",
 "舞鶴草": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة)",
 "舟": "سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة. / فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة",
 "舟をこぐ": "نَامَ عَلَى نَفْسِهِ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "舟を漕ぐ": "نَامَ عَلَى نَفْسِهِ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "舟人": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب البحر عملا له) / بَحْرِيّ / مَلَّاح / نُوتِيّ / نَوْتِيّ\nمثال: هى متزوجة من بحار.",
 "舟唄": "أغنية المراكبي, باركارول (أغنية قوارب يغنيها جندوليو البندقية)",
 "舟場": "رَصِيف",
 "舟大工": "بناء السفن, نجار سفن (نجار يساعد في بناء وإطلاق السفن الخشبية)",
 "舟底": "جَمَّة, إِنْكِلِيَّة",
 "舟形": "زَوْرَقِيّ الشَّكْل (على شكل زَورق) / عظم زورقي (أكبر عظام الرسغ على جانب الإبهام)",
 "舟橋": "جِسْر عَائِم (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "舟歌": "أغنية المراكبي, باركارول (أغنية قوارب يغنيها جندوليو البندقية)",
 "舟溜まり": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة) / رسوم الرسو (رسم للإرساء)",
 "舟状": "قَارِبِيُّ الشَّكْل (ذو شكل مقعّر يشبه القارب)",
