 "肉襞": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "肉襦袢": "بِلَوْن الجِلْد البَشَرِيّ (بلون أحمر فاتح أو وردي كلون البشرة)",
 "肉親": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "肉質": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "肉迫": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية))",
 "肉阜": "لحيمة, نتوء لحمي (نتوء على نبات أو حيوان مثل داليات الطيور أو نتوء بالقرب من نقير بعض البذور)",
 "肉類": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "肉食": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉食動物": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉食性": "أكل اللحوم (صفة كون الحيوان يأكل اللحوم كجزء رئيسي من نظامه الغذائي)",
 "肉食獣": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉食系": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "肉髯": "تعريشة, سياج أغصان (هيكل يتكون من أوتاد متشابكة مع الفروع لتشكيل سياج) / دالية, لغد (طية جلدية لحمية مجعدة وغالباً ما تكون زاهية الألوان تتدلى من عنق أو حلق بعض الطيور (الدجاج والديك الرومي) أو السحالي) / أكاسيا, سنط (أي من الأشجار الأسترالية المتنوعة التي تنتج أعمدة رفيعة مناسبة للسياج المضفر)",
 "肋": "ضِلْع",
 "肋材": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "肋筋": "رِكَاب",
 "肋膜": "جنب, غشاء الجنب (الغشاء المصلي الرقيق حول الرئتين والجدران الداخلية للصدر)",
 "肋膜炎": "ذات الجنب (التهاب غشاء الجنب الرئوي)",
 "肋軟骨": "غضروف ضلعي (الغضاريف التي تربط القص بنهايات الأضلاع؛ تسمح مرونتها للصدر بالتحرك أثناء التنفس)",
 "肋軟骨炎": "التهاب الغضروف الضلعي (التهاب عند تقاطع الضلع وغضروفه)",
 "肋間": "وَرْبِيَّة, وَرْبِيّ",
 "肋間動脈": "شريان بين الضلوع, شريان ورابي (عدة شرايين تغذي المسافات الوربية (بين الأضلاع) في القفص الصدري)",
 "肋間筋": "عضلة بين الضلوع, عضلة ورقية (عضلات بين الأضلاع؛ تنقبض أثناء الشهيق)",
 "肋骨": "ضِلْع / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر.",
 "肌": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "肌ざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "肌の色": "بشرة, لون البشرة (لون وجه الشخص)",
 "肌合": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "肌合い": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "肌寒": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "肌寒い": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "肌感覚": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "肌理": "مَلْمَس / حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم. / تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "肌着": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "肌膚": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال.",
 "肌色": "بشرة, لون البشرة (لون وجه الشخص)",
 "肌触り": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "肌質": "مَلْمَس",
 "肌身": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "肌馬": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "肌骨": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "肖像": "صُورَة / بُورْتْرِيَّة\nمثال: この切手には誰の肖像が印刷してありますか。 — من هو الشخص المصور على هذا الطابع؟",
