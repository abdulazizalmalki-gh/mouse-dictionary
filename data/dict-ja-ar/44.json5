 "用語集": "مَسْرَد",
 "用足": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "用足し": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "用途": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "用途が広い": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "用途の広い": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "用途多彩": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "用達": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "用達し": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / متعهد مؤن, ممون (شخص يورد المؤن (خاصة الطعام))",
 "用量": "جُرْعَة",
 "田": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "田んぼ": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "田上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "田中": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
