 "考え方": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "考え深い": "عَمِيق اَلتَّفْكِير",
 "考え深げ": "عَمِيق اَلتَّفْكِير",
 "考え無し": "دون تفكير (بطريقة خالية من التفكير) / خَامِل الذِّهْن (بطيء التفكير وخامل عقليّاً) / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / بِلَا تَفْكِير, غَيْرُ مُتَأَمِّل (لَا يُظْهِرُ أَوْ يَتَّسِمُ بِالتَّفْكِيرِ المُتَأَنِّي)\nمثال: حدق دون تفكير في الصورة",
 "考え物": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "考え直す": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "考え込む": "تَفَكَّرَ, فَكَّرَ",
 "考え違い": "سُوء فَهْم",
 "考古": "عِلْمُ الآثَار (أَدْرَكَ حقيقة الشيء) / آثَار (البقايا؛ الأطلال) / عِلْمُ الْآثَارِ الْقَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "考古学": "عِلْمُ الآثَار (أَدْرَكَ حقيقة الشيء) / آثَار (البقايا؛ الأطلال) / عِلْمُ الْآثَارِ الْقَدِيمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "考古学的": "أثري (متعلق بـ أو يتعامل مع أو مكرس لعلم الآثار)\nمثال: حفرية أثرية",
 "考古学者": "عالم آثار (عالم أنثروبولوجيا يدرس شعوب ما قبل التاريخ وثقافتهم)",
 "考察": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "考慮": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "考慮にいれる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "考慮に入れる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "考査": "اِخْتِبَار, اِمْتِحَان (اختبر الشّيء:خبره) / فَحْص (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض) / اِمْتِحَان, اِخْتِبَار (اِمْتِحَان)\nمثال: تم اختبار زيري.",
 "考案": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "考案者": "مُخْتَرِع, مُبْتَكِر",
 "考究": "تَحْقِيق",
 "考試": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "考課": "تَقْيِيم, تَقْدِير",
 "考量": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "耄碌": "خرف, هرم (حالة الخرف) / خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "者": "أُقْنُوم / فَرْد / أُقْنُوم / فَرْد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "者ども": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "者共": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "耆欲": "إعجاب, ميل (شعور بالمتعة والاستمتاع)\nمثال: كان لدي دائماً ميل للقراءة",
 "耆那教": "جَيْنِيَّة, جَايْنِيَّة",
 "而るを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "而今": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "而今而後": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "而後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "耐えうる": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "耐えがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "耐えきれる": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "耐えしのぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "耐える": "دُبّ / دُبَّة / اِحْتَمَلَ / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "耐え凌ぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "耐え得る": "قَاوَمَ (ظَلَّ يقوم ضد الشيء، استمر في القيام)\nمثال: قاوم حتى النهاية!",
 "耐え忍ぶ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "耐え難い": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "耐久": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء",
 "耐久力": "مَتَانَة",
 "耐久性": "مَتَانَة",
 "耐久財": "سلع استهلاكية معمرة, سلع معمرة (سلع استهلاكية لا تتلف أو تُستهلك بمجرد الاستخدام)",
 "耐乏": "تَقَشُّف",
 "耐力壁": "جدار حامل (أي جدار يدعم أرضية أو سقف مبنى)",
