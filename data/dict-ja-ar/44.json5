 "肉汁": "بويون, مرق متبل (مرق صافي متبل)",
 "肉片": "قطعة لحم, قطعية لحم (قطعة من اللحم تم قطعها من ذبيحة الحيوان)",
 "肉牛": "أبقار اللحم, ماشية اللحم (الماشية التي تُربى من أجل لحومها)",
 "肉球": "قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "肉的": "مَادِّيّ, مَلْمُوس",
 "肉眼": "عَيْن مُجَرَّدَة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "肉穂花序": "إغريض (المحور اللحمي لسنبلة محاط غالباً بقنابة)",
 "肉穴": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا / اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "肉竿": "قَضِيب, ذَكَر",
 "肉筆": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "肉筆画": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "肉縁": "صِلَة الدَّم الوَاحِد",
 "肉置き": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "肉肉しい": "لَحْمِيّ",
 "肉腫": "ساركومة (ورم خبيث عادة ينشأ من النسيج الضام (العظام أو العضلات وما إلى ذلك)؛ أحد الأنواع الأربعة الرئيسية للسرطان)",
 "肉芽": "تحبيب (فعل تشكيل شيء ما إلى حبيبات) / تحبب, نسيج حبيبي (نسيج ضام جديد وأوعية دموية دقيقة تتشكل على أسطح الجرح أثناء عملية الشفاء)\nمثال: تحبيب الأدوية / بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور) / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "肉芽組織": "تحبب, نسيج حبيبي (نسيج ضام جديد وأوعية دموية دقيقة تتشكل على أسطح الجرح أثناء عملية الشفاء)",
 "肉芽腫": "ورم حبيبي (ورم يتكون من نسيج حبيبي ناتج عن إصابة أو التهاب أو عدوى)",
 "肉茎": "سُوَيْق, سُوَيْقَة / زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "肉薄": "شوي (الطهي بالتعرض المباشر للحرارة المشعة (كما فوق نار أو تحت شواية)) / رَفِيع, رَقِيق / ضعيف, ضعيفة",
