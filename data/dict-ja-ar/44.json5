 "皺々": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)",
 "皺が寄る": "جَعْدَة / تَجَعُّد, جَعْدَة",
 "皺くちゃ": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)",
 "皺だらけ": "مُغَضَّن",
 "皺っぽい": "مُغَضَّن",
 "皺を伸ばす": "اِسْتَقَامَ (أَقَامَ نفسه)",
 "皺を寄せる": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "皺伸ばし": "اِسْتِجْمَام",
 "皺取り": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب خط الشعر وشد الجلد واستئصال الأنسجة الزائدة)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "皺寄せ": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "皺曲": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "皺皺": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)",
 "皺胃": "إِنْفَحَة",
 "皺襞": "طَوَى / طَيَّة",
 "皿": "طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء",
 "皿ばかり": "رَصِيد",
 "皿洗い": "تنظيف ما بعد الأكل, غسل الأواني (غسل الأطباق وما إلى ذلك بعد تناول وجبة)",
 "皿洗い機": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "皿秤": "رَصِيد",
 "皿鉢": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق الدوران بينما تتبع إبرة الفونوغراف الأخدود) / طبق تقديم كبير (طبق كبير ضحل يستخدم لتقديم الطعام)",
 "盃": "كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء) / فِنْجَان (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: هل لي بكأس ماء؟",
 "盆": "صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: هذه شركة صينية. / فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / بُون",
 "盆と正月が一緒に来たよう": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "盆と正月が一緒に来た様": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "盆地": "طَشْت / حوض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "盆子原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "盆暗": "غَبِيّ / غَبِيّ, أَحْمَق / أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "盆栽": "بُونْسَاي",
 "盈虚": "مَرْحَلَة",
 "盈虧": "مَرْحَلَة",
 "益": "فَائِدَة, جَدْوَى\nمثال: 労なくして益なし。 — كل شيء وله ثمن / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "益々": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "益々もって": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "益々以て": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "益する": "فَائِدَة, جَدْوَى",
 "益人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "益体": "جَدْوَى, فَائِدَة (صفة كون الشيء ذا فائدة عملية)",
 "益体もない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "益体も無い": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "益山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "益川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "益田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
