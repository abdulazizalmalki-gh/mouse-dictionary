 "腰を下ろす": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "腰を屈める": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس)",
 "腰を折る": "قَاطَعَ",
 "腰を据える": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "腰を掛ける": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "腰を落ちつける": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "腰を落ち着ける": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "腰を降ろす": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "腰ミノ": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
 "腰付き": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "腰仙": "قطني عجزي (من أو يتعلق بمنطقة أسفل الظهر والجزء الخلفي من الحوض)",
 "腰垣": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "腰壁": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "腰屋根": "فَانُوس",
 "腰巻": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "腰巻き": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "腰巾着": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "腰布": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "腰帯": "كورسيه, مشد (رداء داخلي نسائي ضيق ومشكّل) / حزام, زنار (شريط من مادة حول الخصر يقوي التنورة أو البنطال) / حزام (بنية مطوقة أو حلقية الشكل)",
 "腰張": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة) / تلبيسة خشبية, وزرة جدارية (جدار مغطى بألواح (عادة خشبية) في جزئه السفلي)",
 "腰張り": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة) / تلبيسة خشبية, وزرة جدارية (جدار مغطى بألواح (عادة خشبية) في جزئه السفلي)",
 "腰強": "عَنِيد / لَزِج",
 "腰当て": "صخب, ضجة (اضطراب نشط وسريع) / إطار التنورة, بستل (هيكل يُلبس في الخلف أسفل الخصر لإعطاء امتلاء لتنورة المرأة) / واقي ورك (ملابس واقية تتكون من وسادة يرتديها لاعبو كرة القدم والهوكي) / واقي الفخذ العلوي (واحدة من قطعتين من الدرع الصفيحي تتدليان من تنورة الدرع لحماية الفخذين العلويين)",
 "腰折": "مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / وتري قوسي, يعزف بالقوس (عن آلة وترية؛ يصدر صوتاً عن طريق التمرير بالقوس) / أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / قَنْطَرِيّ, مُقَوَّس (يشكل قوسًا أو يشبهه) / تعطيل, مماطلة (تكتيك يستخدم للتضليل أو التأخير)",
 "腰折れ": "مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / وتري قوسي, يعزف بالقوس (عن آلة وترية؛ يصدر صوتاً عن طريق التمرير بالقوس) / أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / قَنْطَرِيّ, مُقَوَّس (يشكل قوسًا أو يشبهه) / تعطيل, مماطلة (تكتيك يستخدم للتضليل أو التأخير)",
 "腰折れ屋根": "سقف جامبريل, سقف جملوني مزدوج الميل (سقف جملوني له ميلان على كل جانب ويكون الميل السفلي أكثر انحداراً)",
 "腰抜け": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "腰掛": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "腰掛け": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "腰掛ける": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "腰掛け台": "بِنْش",
 "腰掛る": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "腰掛台": "بِنْش",
 "腰椎": "فَقَرَة قَطَنِيَّة",
 "腰椎穿刺": "بَزْل قَطَنِيّ",
 "腰気": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "腰湯": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "腰痛": "أَلَمْ قَطَنِيّ, أَلَمْ اَلْقَطَنْ (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "腰神経": "عصب قطني (أي من خمسة أزواج من الأعصاب الشوكية الخارجة من القسم القطني للحبل الشوكي)",
 "腰筋": "عضلة قطنية (أي من عضلتين في البطن والحوض تثني الجذع وتدير الفخذ)",
 "腰簑": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
 "腰縄": "رِبَاط",
 "腰羽目": "حتى الخصر (يصل إلى الخصر)\nمثال: ارتفع الماء حتى الخصر",
 "腰蓑": "تنورة عشبية (تنورة مصنوعة من شفرات العشب الطويلة)",
 "腰部": "صُلْب, حَقْو (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "腰間": "وَرِك",
 "腰骨": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة) / ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "腰高": "مُتَسَلِّط",
 "腱": "وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "腱板": "كُفَّة مُدَوَّرَة",
 "腱炎": "التهاب الوتر (التهاب الوتر)",
 "腱索": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "腱膜": "وَتَر عَرِيض (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "腱膜瘤": "إبهام أفحج, وكعة (تضخم مؤلم في الجراب الزلالي للمفصل الأول لإبهام القدم)",
 "腱鞘炎": "التهاب الوتر وغمده (التهاب الوتر وغمده المحيط) / التهاب الوتر (التهاب الوتر)",
 "腸": "مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان / مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان / فَرَث / مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…) / قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "腸の腐った": "فَاسِقٌ, مُنْحَرِف (يَنْحَرِفُ عَمَّا يُعْتَبَرُ أَخْلَاقِيًّا أَوْ صَحِيحًا أَوْ لَائِقًا)",
 "腸カタル": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)",
 "腸チフス": "الْحُمَّى التِّيفِيَّة",
 "腸チフス菌": "سالمونيلا تيفية, عصوية التيفوئيد (شكل من أشكال السالمونيلا يسبب حمى التيفوئيد)",
 "腸内": "مَعَوِيّ",
 "腸内フローラ": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد ضرورية لأداء وظائفها الطبيعية)",
 "腸内洗浄": "غسيل القولون (حقنة شرجية مائية تعطى لتنظيف القولون)",
 "腸内細菌叢": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد ضرورية لأداء وظائفها الطبيعية)",
 "腸捻転": "انفتال (التواء غير طبيعي للأمعاء (عادة في منطقة اللفائفي أو القولون السيني) مما يؤدي إلى انسداد معوي)",
 "腸満": "تطبل البطن (انتفاخ البطن الناجم عن تراكم الغازات في الأمعاء أو التجويف البريتوني)",
 "腸炎": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)",
 "腸疾患": "اعتلال معوي (مرض يصيب القناة المعوية)",
 "腸石": "حَصَاة مِعَوِيَّة (حصاة تحدث في الأمعاء)",
 "腸管": "قَنَاة هَضْمِيَّة",
 "腸線": "خيط معوي, وتر جراحي (حبل قوي مصنوع من أمعاء الأغنام ويستخدم في الجراحة) / بازلاء حلوة برية, سذاب الماعز (شجيرة معمرة من شرق أمريكا الشمالية لها أوراق زغبية وزهور مصفرة ووردية؛ ومصدر للروتينون)",
 "腸詰": "سُجُق, نَقَانِق",
 "腸詰め": "سُجُق, نَقَانِق",
 "腸詰め菌": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "腸詰菌": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "腸重積": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات الموجودة في جدار الخلية) / انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح)\nمثال: انغماد الأريمة",
 "腸重積症": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات الموجودة في جدار الخلية) / انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح)\nمثال: انغماد الأريمة",
 "腸閉塞": "انسداد معوي (انسداد الأمعاء (خاصة اللفائفي) الذي يمنع محتويات الأمعاء من المرور إلى الأمعاء السفلية)",
 "腸間膜": "مِسْرَاق",
 "腸骨": "حرقفة (الجزء العلوي والأعرض من العظام الثلاثة المكونة لعظم الورك)",
 "腸骨動脈": "شريان حرقفي (واحد من الشرايين الكبيرة التي تغذي الحوض والساقين بالدم)",
 "腹": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه. / شَجَاعَة, جَسَارَة / كَرَم, سَخَاء",
 "腹いせ": "اِنْتِقَام",
 "腹がいる": "أَهْدَأَ, هَدَّأَ",
 "腹がくろい": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "腹が太い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "腹が居る": "أَهْدَأَ, هَدَّأَ",
 "腹が決まる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "腹が黒い": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "腹づもり": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "腹にたまる": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "腹に一物": "دسيسة, مكيدة (مؤامرة ماكرة ومعقدة لتحقيق أهدافك (الشريرة عادة))",
 "腹に溜まる": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "腹に納める": "احتفظ بكل شيء لنسفه",
 "腹に落ちる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "腹の底": "في الأعماق, في الجوهر (في الواقع)\nمثال: هي طيبة جداً في جوهرها",
 "腹の据わった": "بَاسِل, جَرِيء (يتميز بالشجاعة والتصميم في مواجهة الصعوبات أو الخطر؛ قوي وغير مكبوت)\nمثال: عليك أن تعجب بها: كان شيئاً جريئاً للقيام به",
 "腹の虫": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة ولكن بعضها طفيلي)",
 "腹びれ": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه الحركة؛ تقابل الأطراف الخلفية للفقاريات البرية)",
 "腹ぺこ": "جَائِع, جَوْعَان",
 "腹ぼて": "عرض, معرض (شيء يُعرض للجمهور) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "腹やみ": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "腹をきめる": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "腹を据える": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "腹を決める": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "腹ペコ": "جَائِع, جَوْعَان",
 "腹ボテ": "عرض, معرض (شيء يُعرض للجمهور) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: كان للمتحف العديد من معروضات الفن الشرقي",
 "腹下し": "مُلَيّن / إِسْهَال",
 "腹下り": "إِسْهَال",
 "腹中": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "腹側": "بَطْنِيّ, مُتَّجِه نَحْو المِحْوَر (الأقرب إلى أو المتجه نحو محور عضو أو كائن حي) / بَطْنِيّ (نحو أو على أو بالقرب من البطن (أمام الرئيسيات أو السطح السفلي لحيوان أدنى))\nمثال: يُعرف الجانب العلوي للورقة بالسطح البطني",
 "腹切": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "腹切り": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "腹壁": "جدار البطن",
 "腹子": "بطارخ, بيض السمك (البيض أو المبيض الممتلئ بالبيض للسمك) / بطارخ القشريات (كتلة البيض أو السرء لبعض القشريات مثل الكركند) / بطارخ (بيض إناث الأسماك) / بطارخ (بيض السمك أو المبيض الممتلئ بالبيض؛ له قوام حبيبي)",
 "腹巻": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة))",
 "腹巻き": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة))",
 "腹帯": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه) / خَصْر, مُحِيط الجسم (المسافة حول جسم الشخص)",
 "腹式呼吸": "تنفس بطني (تنفس يتم فيه بذل معظم الجهد التنفسي بواسطة عضلات البطن)\nمثال: يمارس المغنون التنفس البطني",
 "腹当て": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / لَبَب",
 "腹心の友": "أمين سر, خليل (شخص يُؤتمن على الأمور الخاصة)",
 "腹心の部下": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "腹掛け": "مِرْيَلَة",
 "腹横筋": "مستعرضة بطنية (عضلة مسطحة بألياف مستعرضة تشكل الجدران الأمامية والجانبية لتجويف البطن)",
 "腹水": "اِسْتِسْقَاء",
 "腹汚い": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "腹減った": "أَنَا جَائِع, أَنَا جَائِعَة",
 "腹病": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "腹病み": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "腹痛": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "腹積もり": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "腹積り": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "腹穢い": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "腹立たしい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "腹立ち": "غَضَب / أَغْضَبَ / غَضِبَ",
 "腹笑い": "نُكْتَة صَارِخَة, نُكْتَة مُضْحِكَة جِدًّا (نكتة تبدو مضحكة للغاية) / جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "腹筋": "عضلة بطنية (عضلات البطن) / تمرين الجلوس من الرقود (تمرين للبطن يجلس فيه الشخص من وضع الاستلقاء دون استخدام الذراعين للرافعة)",
 "腹筋運動": "تمرين الجلوس من الرقود (تمرين للبطن يجلس فيه الشخص من وضع الاستلقاء دون استخدام الذراعين للرافعة)",
 "腹肢": "رجل عائمة, قدم سباحة (واحدة من الزوائد البطنية المزدوجة لبعض القشريات المائية التي تعمل بشكل أساسي لحمل البيض عند الإناث وتتكيف عادة للسباحة)",
 "腹脚": "رجل عائمة, قدم سباحة (واحدة من الزوائد البطنية المزدوجة لبعض القشريات المائية التي تعمل بشكل أساسي لحمل البيض عند الإناث وتتكيف عادة للسباحة)",
 "腹腔": "بطن, تجويف بطني (التجويف الذي يحتوي على الأحشاء الرئيسية؛ في الثدييات يفصله عن الصدر الحجاب الحاجز)",
 "腹腔動脈": "جذع زلاقي, شريان زلاقي (شريان ينشأ من الأبهر البطني أسفل الحجاب الحاجز مباشرة ويتفرع إلى الشريان المعدي الأيسر والشريان الكبدي المشترك والشريان الطحالي)",
 "腹腔穿刺": "بزل البطن (بزل البطن لإزالة السائل للتشخيص)",
 "腹腔鏡": "مِنْظَار الْبَطْن",
 "腹腔鏡手術": "تنظير البطن",
 "腹腔鏡検査": "تنظير البطن",
 "腹膜": "صِفَاق",
 "腹膜炎": "التهاب البريتوان, التهاب الصفاق (التهاب الصفاق (الغشاء البريتوني))",
 "腹落ち": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "腹蔵": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "腹蔵なく": "بِصَراحة",
 "腹裂き": "تفريغ من المضمون (تغيير شيء ما (مثل قانون تشريعي أو بيان) بطريقة تقلل من قيمته) / إخراج الأحشاء, نزع الأحشاء (عملية إزالة الأمعاء أو الأحشاء؛ عملية القطع بحيث تبرز الأحشاء) / إفراغ الأحشاء (إزالة جراحية لعضو (أو محتويات عضو) من مريض)\nمثال: اعتماد تعديلاتهم كان سيعني تفريغ القانون من مضمونه",
 "腹話術": "التكلم من البطن (فن إسقاط صوتك بحيث يبدو أنه يأتي من مصدر آخر (مثل دمية المتكلم من البطن))",
 "腹話術師": "مُتَكَلِّم مِنْ بَطْنِه",
 "腹赤": "تَرُوتَة, أُطْرُوط",
 "腹足類": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل عيوناً ذات سويقات)",
 "腹違い": "أَبَوِيّ",
 "腹部": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "腹部大動脈瘤": "تمدد الشريان الأورطي البطني (تمدد الأوعية الدموية في الشريان الأورطي البطني المرتبط بالشيخوخة وارتفاع ضغط الدم)",
 "腹部突き上げ法": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "腹鰭": "زعنفة بطنية, زعنفة حوضية (إحدى زوج من الزعانف المتصلة بحزام الحوض في الأسماك تساعد في التحكم في اتجاه الحركة؛ تقابل الأطراف الخلفية للفقاريات البرية)",
 "腹黒": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "腹黒い": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "腺": "غُدَّة",
 "腺がん": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "腺ガン": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "腺ペスト": "طاعون دملي (الشكل الأكثر شيوعًا للطاعون لدى البشر؛ يتميز بقشعريرة وإعياء وهذيان وتكون دمامل في الإبطين والفخذ؛ لا ينتشر من شخص لآخر)",
 "腺房": "عنيبة (واحدة من الأكياس الصغيرة أو التوسعات الشبيهة بالكيس في غدة مركبة) / عنيبة (واحدة من الحسيلات الصغيرة التي تشكل فاكهة متجمعة أو متعددة مثل التوت الأسود)",
 "腺様": "شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية) / لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "腺熱": "داء التقبيل, كثرة الوحيدات العدوائية (مرض حاد يتميز بالحمى وتضخم الغدد الليمفاوية وزيادة غير طبيعية في كريات الدم البيضاء وحيدة النواة في مجرى الدم؛ ليس شديد العدوى؛ يعتقد البعض أنه يمكن…)",
 "腺癌": "سرطانة غدية (ورم خبيث ينشأ في الظهارة الغدية)",
 "腺腫": "ورم غدي (ورم ظهاري حميد من أصل غدي)",
 "腿": "فَخِذ, فَخْذ",
 "腿口類": "فكيات الأرجل (تستخدم في بعض التصنيفات؛ تشمل رتب سيفيات الذيل وعقارب البحر)",
 "腿節": "عظم الفخذ, فخذ (أطول وأسمك عظم في الهيكل العظمي البشري؛ يمتد من الحوض إلى الركبة)",
 "腿肉": "رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "膀胱": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "膀胱炎": "التهاب المثانة (التهاب المثانة البولية والحالبين)",
 "膀胱結石": "حَصَاةُ المَثَانَة (حصاة تتكون في المثانة)",
 "膃肭": "فقمة الفراء (فقمة ذات أذنين تعيش في نصف الكرة الجنوبي؛ فراؤها السفلي الناعم الكثيف هو مصدر جلد الفقمة) / فقمة الفراء الشمالية (فقمة ذات أذنين تعيش في شمال المحيط الهادئ)\nمثال: ذكر فقمة الفراء أكبر بكثير من الأنثى",
 "膈": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "膏沃": "خُصُوبَة",
 "膏腴": "خُصُوبَة",
 "膏薬": "مِلَاط, جِبْس / مَرْهَم, دَهُون",
 "膜": "غِشَاء",
 "膜性": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "膜性迷路": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "膜状": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "膜翅類": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "膜迷路": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "膜骨": "عظم غشائي (أي عظم ينمو داخل الأنسجة الغشائية دون تكوين غضروفي مسبق؛ مثل الترقوة وعظام الجمجمة)",
 "膜鳴楽器": "طبل (آلة إيقاعية موسيقية؛ تتكون عادة من أسطوانة مجوفة مع غشاء مشدود عبر كل طرف)",
 "膝": "رُكْبَة / حَجَر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / وَلَغَ\nمثال: عوقب زيري بالحجر.",
 "膝がしら": "رَضَفَة",
 "膝げり": "رُكْبَة",
 "膝づめ": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "膝の皿": "رَضَفَة",
