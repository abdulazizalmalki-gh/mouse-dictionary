 "猛禽類": "جارح, طائر جارح (أي من الطيور اللاحمة العديدة التي تصطاد وتقتل الحيوانات الأخرى)",
 "猛者": "بلطجي, رجل قوي (رجل يتنمر على الأشخاص الأضعف) / مُحَارِب قَدِيم / نَشَّال",
 "猛進": "شَحْطَة / شَرْطَة / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)",
 "猛鳥": "طَيْر جَارِح",
 "猜む": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "猜忌": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "猜疑": "اِتِّهَام, شَكّ / اِتِّهَام",
 "猜疑心": "اِتِّهَام, شَكّ / اِتِّهَام",
 "猟": "صَيْد / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس.",
 "猟る": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "猟人": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "猟場": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "猟奇的": "شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر)",
 "猟季": "موسم الصيد (الموسم الذي يكون فيه قتل نوع معين قانونيًا)",
 "猟官制": "نظام الغنائم, نظام المحسوبية (نظام توظيف وترقية الموظفين المدنيين الذين هم أصدقاء ومؤيدون للمجموعة الحاكمة)",
 "猟官制度": "نظام الغنائم, نظام المحسوبية (نظام توظيف وترقية الموظفين المدنيين الذين هم أصدقاء ومؤيدون للمجموعة الحاكمة)",
 "猟師": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "猟期": "موسم الصيد (الموسم الذي يكون فيه قتل نوع معين قانونيًا)",
 "猟犬": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "猟色": "فَحْشَاء, فِسْق",
 "猟虎": "قضاعة البحر (قضاعة بحرية كبيرة من سواحل شمال المحيط الهادئ ذات فراء بني داكن سميك جداً)",
 "猟鳥": "طائر صيد, طائر طريدة (أي طائر (مثل الطيهوج أو التدرج) يتم صيده كرياضة)",
 "猥り": "أَنَانِيّ / مُتَهَوِّر / فَضْفَاض, واسِع / غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه) / أصم, غير نسبي (حقيقي ولكن لا يمكن التعبير عنه كحاصل قسمة عددين صحيحين) / عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))\nمثال: مخاوف غير عقلانية",
 "猥りがわしい": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "猥本": "إِبَاحِيَّة",
 "猥褻": "فَاحِش, قَذِر",
 "猥褻文書": "إِبَاحِيَّة",
 "猥褻罪": "خدش للحياء, فعل غير لائق (فعل غير لائق أو خادش للحياء) / خدش للحياء, فحش (جودة كون الشيء غير محتشم)",
 "猥言": "كلمة بذيئة (كلمة تعتبر غير لائقة للذكر) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)\nمثال: 'فشل' كلمة بذيئة بالنسبة له",
 "猥語": "كلمة بذيئة (كلمة تعتبر غير لائقة للذكر) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)\nمثال: 'فشل' كلمة بذيئة بالنسبة له",
 "猥談": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "猥雑": "بَذِيء / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)",
 "猩々": "إِنْسَان اَلْغَاب, إِنْسَان الْغَابَة (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "猩々緋": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "猩々草": "فربيون كأسي, نار على الجبل (بنت القنصل في الولايات المتحدة وشرق المكسيك؛ غالباً ما يتم الخلط بينها وبين الفربيون متباين الأوراق)",
 "猩々蝿": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "猩々蠅": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "猩猩": "إِنْسَان اَلْغَاب, إِنْسَان الْغَابَة (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "猩猩緋": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "猩猩蝿": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "猩猩蠅": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "猩紅熱": "حمى قرمزية (مرض معد حاد (عادة عند الأطفال) يتميز بالحمى وطفح جلدي أحمر)",
 "猪": "خَنْزِير بَرِيّ / مُتَوَحِّش / صَيْد / خِنْزِير",
 "猪の子": "خَنْزِير بَرِيّ / خِنْزِير / حَلُوف / خنزير / حلوف / خَنْزير",
 "猪勇": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "猪口": "بوليت (أي فطر من فصيلة بوليتاسيا)",
 "猪口才": "تطاول, وقاحة (مرح غير لائق) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صَفَاقَة, وَقَاحَة (عبارة وقحة)",
 "猪垣": "حِظَار",
 "猪子": "خَنْزِير بَرِيّ / خِنْزِير / حَلُوف / خنزير / حلوف / خَنْزير",
 "猪武者": "أَهْوَج, مُتَهَوِّر (جريء بشكل متهور ومُفرِط) / طائش, متهور (شخص متهور مندفع غير مسؤول)",
 "猪熊": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "猪狩り": "صَيْد",
 "猪突": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "猪股": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "猪豚": "خَنْزِير بَرِيّ",
 "猪首": "عنق ثوري, عنق غليظ (رقبة سميكة وقصيرة وقوية)",
 "猫": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط. / شَامِيسِين / غَيْشَا / عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "猫かぶり": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)\nمثال: 猫かぶりしてもお前の正体は分かっているよ。 — أنت ذئب في ثياب خروف.",
 "猫かわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "猫じゃらし": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "猫っかわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "猫っ可愛がり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "猫の手も借りたい": "قَلِيل المَوْظَّفِين, نَاقِص العَدَد (يفتقر إلى العدد الكافي من العاملين أو المساعدين)",
 "猫の目": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "猫ばば": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "猫まんま": "القط الغذاء",
 "猫トイレ": "صُنْدُوق فَضَلَات, صُنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "猫可愛がり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "猫和多": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "猫用トイレ": "صُنْدُوق فَضَلَات, صُنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟",
 "猫砂": "رمل فضلات القطط (طين محبب يوضع في حاوية حيث يمتص فضلات القطط أو الكلاب)",
 "猫糞": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "猫背": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي) / الحدب, حداب (انحناء خلفي غير طبيعي للعمود الفقري)",
 "猫蚤": "برغوث القط (برغوث يتكاثر بشكل رئيسي على القطط والكلاب والجرذان)",
 "猫被り": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية) / احتيال, خدعة (شيء يهدف إلى الخداع؛ حيلة متعمدة تهدف إلى الحصول على ميزة) / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)\nمثال: 猫かぶりしてもお前の正体は分かっているよ。 — أنت ذئب في ثياب خروف.",
 "猫踏んじゃった": "أَعْوَاد الْأَكْل, هَاشِي",
 "猫車": "عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "猫額": "صِغَر (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)",
 "猫額大": "دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "猫飯": "القط الغذاء",
 "猫鼬": "نِمْس",
 "献じる": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "献ずる": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "献る": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "献上": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "献名": "اسم الأب, نسبة للأب (اسم عائلي مشتق من اسم أبيك أو أحد أسلافك من جهة الأب)",
 "献呈": "إِرَاءَة / إِهْدَاء, مَنْح",
 "献杯": "توست, خبز محمص (شرائح من الخبز تم تحميصها) / نخب (شرب نخب تكريماً لشخص أو حدث أو للصحة) / مُنْتَهٍ, هالِك (شخص في مأزق يائس؛ شخص محكوم عليه بالهلاك) / نجم المجتمع (مشهور يتلقى الكثير من الإشادة والاهتمام)\nمثال: سأكون هالكاً إذا لم تنجح هذه الخطة",
 "献物": "قُرْبَان",
 "献立": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "献立表": "قَائِمَة, قَائِمَةُ الطَّعَام / قَائِمَة",
 "献策": "اِقْتِرَاح, مُقْتَرَح",
 "献納": "قُرْبَان",
 "献納品": "تَبَرُّع, هِبَة",
 "献納者": "مُتَبَرِّع",
 "献血者": "متبرع بالدم (شخص يتبرع بالدم لاستخدامه في عمليات نقل الدم)",
 "献血車": "سيارة التبرع بالدم (مركبة آلية مجهزة لجمع التبرعات بالدم)",
 "献言": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "献詞": "تَفَانٍ / إِهْدَاء",
 "献身": "تَفَرُّغ",
 "献身的": "مُخْلِص, وَفِيّ (شديد الإخلاص والمودّة والتفاني)",
 "献辞": "تَفَانٍ / إِهْدَاء",
 "献金": "تَبَرُّع, هِبَة",
 "猯": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "猶": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / أَكْثَر / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "猶お": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / أَكْثَر / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "猶も": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "猶予": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "猶予なく": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "猶予期間": "فترة السماح",
 "猶又": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "猶子": "اِبْنُ أَخٍ, اِبْنُ أُخْتٍ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "猾智": "مَاكِر",
 "猾知": "مَاكِر",
 "猿": "سَعْدَان, قِرْد / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "猿ぐつわ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "猿の腰掛け": "بوليبور, فطر متعدد المسام (فطريات مسامية خشبية؛ أي فطر من فصيلة بوليبوراسيا أو فصيلة بوليتاسيا يكون سطحه الحامل للأبواغ داخل أنابيب أو مسام؛ الأجسام الثمرية عادة ما تكون خشبية…)",
 "猿まね": "القرد يرى، القرد يفعل\nمثال: 猿まねはやめろ。 — لا تَكن مقلّداً.",
 "猿公": "سَعْدَان, قِرْد",
 "猿子": "جَزَم, تُنْجِيّ (قطع أو حسم الشيء بدقة وثبات؛ في : جعل الكلمة في حالة الجزم، وذلك بحذف الحرف الأخير أو حركته) / سَعْدَان, قِرْد",
 "猿子鳥": "جَزَم, تُنْجِيّ (قطع أو حسم الشيء بدقة وثبات؛ في : جعل الكلمة في حالة الجزم، وذلك بحذف الحرف الأخير أو حركته)",
 "猿梨": "أكتينيديا حادة, كيوي هاردي (كرمة آسيوية متسلقة لها أوراق طويلة مسننة بدقة وعناقيد من الزهور البيضاء تليها ثمار صفراء مخضرة صالحة للأكل)",
 "猿楽座": "منظمة مهنية, نقابة مهنية (منظمة مكونة من مهنيين وتعمل لصالحهم)",
 "猿橋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "猿渡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "猿猴": "سَعْدَان, قِرْد / كَبَا",
 "猿猴鶏頭": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب)",
 "猿環": "وصلة دوارة (قارنة (كما في سلسلة) لها طرف يدور على مسمار برأس)",
 "猿目": "رَئِيسِيَّات",
 "猿真似": "القرد يرى، القرد يفعل\nمثال: 猿まねはやめろ。 — لا تَكن مقلّداً.",
 "猿芝居": "مبالغة في التمثيل (تمثيل رديء من قبل ممثل مبالغ)",
 "猿轡": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "猿面冠者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "猿頬": "جيب شدقي (جيب غشائي داخل فم العديد من القوارض (مثل الغوفر))",
 "猿頰": "جيب شدقي (جيب غشائي داخل فم العديد من القوارض (مثل الغوفر))",
 "獄": "سِجْن, حَبْس (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "獄司": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "獄吏": "حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "獄囚": "سَجِين, سَجِينَة",
 "獄屋": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "獄所": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "獄舎": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "獄道者": "وَغْد, نَذْل",
 "獅": "أَسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / لَيْث (أَسَد) / أسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / سبع (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / أسد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)",
 "獅子": "أَسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / لَيْث (أَسَد) / أسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / سبع (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / أسد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "獅子っ鼻": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "獅子吼": "خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "獅子奮迅": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "獅子宮": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "獅子座": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "獅子王": "أَسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / لَيْث (أَسَد) / أسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / سبع (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / أسد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "獅子舞": "رَقَص الأَسَد (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "獅子頭": "أيل سيكا, أيل ياباني (أيل صغير في اليابان ذو قرون متشعبة قليلاً)",
 "獅子鼻": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "獅子鼻猿": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "獏": "تَابِير / موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط",
 "獐": "يَحْمُور, يَأْمُور",
 "獐鹿": "يَحْمُور, يَأْمُور",
 "獣": "مُتَوَحِّش / مُتَوَحِّش / صَيْد",
 "獣の数字": "عَدَد الْوَحْش (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "獣人": "فَرْوِيّ, مُفَرَّى",
 "獣医": "طَبِيب بَيْطَرِيّ, بيطار (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "獣医学": "طب بيطري (فرع الطب الذي يتعامل مع تشخيص وعلاج أمراض وإصابات الحيوانات)",
 "獣医師": "طَبِيب بَيْطَرِيّ, بيطار (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "獣姦": "بَهِيمِيّة",
 "獣帯": "أَبْرَاجُ السَّمَاء",
 "獣弓類": "ثيرابسيد (من المحتمل أن يكون من ذوات الدم الحار؛ يعتبر سلفاً مباشراً للثدييات)",
 "獣性": "وحشية",
 "獣欲": "شَهْوَة",
 "獣炭": "أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "獣狩り": "صَيْد",
 "獣畜": "مَوَاشٍ, أَنْعَام",
 "獣疫": "طاعون الماشية (مرض فيروسي معد حاد يصيب الماشية (غالباً ما يكون قاتلاً)؛ يتميز بالحمى والإسهال والتهاب الأغشية المخاطية)",
 "獣的": "بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني)",
 "獣皮": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "獣皮紙": "رَقّ",
 "獣脂": "شَحْم",
 "獣脚類": "ثيروبود, ديناصور ثيروبود (أي من العديد من الديناصورات اللاحمة من العصر الترياسي إلى الطباشيري ذات أطراف أمامية قصيرة وكانت تمشي أو تركض على أرجل خلفية قوية)",
 "獣類": "مُتَوَحِّش",
 "獦子鳥": "شرشور جبلي, عصفور زغاري",
 "獰悪": "عَنِيف",
 "獰猛": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "獲る": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "獲得": "اِكْتِسَاب",
 "獲得免疫": "مناعة مكتسبة (مناعة ضد مرض معين ليست فطرية ولكن تم اكتسابها خلال الحياة)",
 "獲得形質": "صِفَة مُكْتَسَبَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "獲物": "فَرِيسَة / غَنِيمَة / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "獲麟": "النِهاية",
 "獺": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "獺祭": "عمل أدبي, مؤلف أدبي (كتابة إبداعية أو خيالية)",
 "玄人": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / بائعة هوى",
 "玄人気質": "احترافية, مهنية (الخبرة المميزة للشخص المهني)",
 "玄人筋": "مُحْتَرِف, مُحْتَرِفَة",
 "玄兎": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "玄冬": "شِتَاء, شتا (أحد فُصُول السنة، يبدأ في 21 ديسمبر، وينتهي في 20 مارس، وفيه تنخفض درجات الحَرَارَة)\nمثال: ولد في فصل الشتاء.",
 "玄妙": "عَوِيص, غَامِضٌ عَمِيق (صعب الفهم؛ غير مفهوم لذوي المعرفة العادية)",
 "玄室": "حجرة الدفن, ضريح (حجرة تُستخدم كقبر)",
 "玄武岩": "بَازَلْت",
 "玄武岩質": "بازلتي (من أو متعلق بـ أو يحتوي على البازلت)\nمثال: الصهارة البازلتية سائلة",
 "玄猿": "غِيبُون, جِبَّوْن",
 "玄石": "مَغْنَاطِيس",
 "玄米": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "玄米粉": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "玄米茶": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "玄翁": "مِرْزَبَّة, إِرْزَبَّة",
 "玄葉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玄関": "دُخُول / مَدْخَل",
 "玄関ホール": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال)",
 "玄関マット": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول) / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "玄関先": "دُخُول / مَدْخَل",
 "玄関口": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى) / بوابة, مدخل (مدخل يمكن إغلاقه ببوابة)",
 "玄関番": "بَوَّاب, بَوَّابَة",
 "玄鳥": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "率": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة.",
 "率いる": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "率る": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "率土": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "率然": "مُبَاغِت, مُفَاجِئ",
 "率爾": "مُبَاغِت, مُفَاجِئ",
 "率爾ながら": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "率由": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "率直": "إِفْرَنْجِيّ",
 "玉": "ضَرَّة / خرزة (كرة صغيرة بها ثقب في المنتصف) / حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / حبة, قطرة (شكل كروي وصغير)\nمثال: حبات العرق على جبهته / كَوْم / رَصَاصَة, رَصَاص / جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية. / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / غَيْشَا",
 "玉うき": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "玉かけ": "رشق, قذف (الرمي بحركة واسعة (كما لو كان بمقلاع))",
 "玉どめ": "عقدة فرنسية (غرزة مصنوعة بلف الخيط عدة مرات حول الإبرة قبل إدخالها في القماش)",
 "玉なし": "عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة / فَاسِد",
 "玉に瑕": "شائبة, منغص (إزعاج ينتقص من فائدة شيء ما)",
 "玉ねぎ": "بَصَل / بصل / بصلة / بُصَل",
 "玉ははき": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "玉ばはき": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "玉ウキ": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "玉レタス": "خس آيسبرغ, خس الرؤوس (خس ذو أوراق خضراء فاتحة مقرمشة ومعبأة بإحكام في رأس صلب)\nمثال: خس الآيسبرغ لا يزال هو الخس الأكثر شعبية",
 "玉井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玉体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "玉兎": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "玉垂れ": "ستار خيزراني (حاجز أيديولوجي حول الصين الشيوعية خاصة في الخمسينيات والستينيات)",
 "玉型": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "玉塵": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)",
 "玉子": "بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "玉子焼き": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض. / مِقْلَاة (وعاء قلي الطعام)",
 "玉子焼き器": "مِقْلَاة (وعاء قلي الطعام)",
 "玉将": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "玉將": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "玉屋": "صَائِغ, صَائِغَة / فُقَّاعَةُ صَابُون",
 "玉帚": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "玉座": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "玉形": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "玉押金亀子": "جَعْل الرَوْث, جِعْرَان (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "玉掛": "رشق, قذف (الرمي بحركة واسعة (كما لو كان بمقلاع))",
 "玉掛け": "رشق, قذف (الرمي بحركة واسعة (كما لو كان بمقلاع))",
 "玉撞き": "بِلْيَارْدُو",
 "玉散る": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع) / بريق, لمعان (المرح المعبر عنه ببريق أو لمعان أو حيوية في الوجه) / تألق, تلألؤ (حدوث وميض صغير أو شرارة)\nمثال: كان في عينيه بريق",
 "玉敷き": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "玉木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玉村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玉杓子": "مِغْرَفَة",
 "玉梓": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "玉止め": "عقدة فرنسية (غرزة مصنوعة بلف الخيط عدة مرات حول الإبرة قبل إدخالها في القماش)",
 "玉水": "قَطْرَةُ مَطَر",
 "玉浮": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "玉浮き": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "玉無し": "عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة / فَاسِد",
 "玉状": "كُرَوِيّ (ذو شكل الكرة أو المجال)",
 "玉瑛": "قَرِيس, قَرِيت",
 "玉田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玉留め": "عقدة فرنسية (غرزة مصنوعة بلف الخيط عدة مرات حول الإبرة قبل إدخالها في القماش)",
 "玉石": "حَصَاة",
 "玉石混交": "تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "玉石混淆": "تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "玉砂利": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "玉突き": "بِلْيَارْدُو",
 "玉突き台": "طاولة بلياردو (معدات ألعاب تتكون من طاولة ثقيلة تلعب عليها البلياردو)",
 "玉章": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "玉箒": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "玉繭": "شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر من أطوار حياتها)",
 "玉置": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "玉茎": "قَضِيب, ذَكَر",
 "玉菜": "مَلْفُوف, كُرُنْب",
 "玉葱": "بَصَل / بصل / بصلة / بُصَل",
 "玉藻": "عُشْب بَحْرِيّ",
 "玉虫色": "غَامِض, مُلْتَبِس (غَيْرُ يَقِينِيٍّ كَعَلَامَةٍ أَوْ دَلَالَةٍ) / حمال أوجه, غامض (مفتوح لأكثر من تفسير؛ أو ذو طبيعة أو مغزى غير مؤكد؛ أو (غالباً) يهدف إلى التضليل) / غَامِض, مُلْتَبِس (قابل للتساؤل ومفتوح للتأويل)\nمثال: بيان ملتبس",
 "玉蜀黍畑": "حقل ذرة (حقل مزروع بالذرة)",
 "玉袋": "صَفَن, كِيس اَلصَّفَن",
 "玉貝": "صدفة القمر (بطنيات قدم بحرية لها أصداف مستديرة ناعمة تشكل أبراجاً قصيرة)",
 "玉蹴り": "كُرَة اَلْقَدَم",
 "玉軸受": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "玉軸受け": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "玉輪": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "玉酒": "مُرْتَفِع الدَّرَجَة",
 "玉門": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "玉音放送": "بث إذاعي (بث عبر الراديو)",
 "玉飾り": "السَّنَة الْجَدِيدَة",
 "玉髄": "عقيق أبيض, كالسيدوني (كوارتز حليبي أو رمادي نصف شفاف إلى شفاف)",
 "玉黍": "غَلَّة / برونكل (بطني قدم بحري صالح للأكل) / بروينكل, حلزون بحري (حلزون بحري صغير صالح للأكل؛ يطهى بالبخار في النبيذ أو يخبز) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء) / عناقية, فنكا (نباتات سامة زاحفة بشكل رئيسي بزهور زرقاء)",
 "王": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ)\nمثال: بارون نفط / قَيْصَر, إِمْبْرَاطُور / أَمِير",
 "王位": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "王侯将相いずくんぞ種あらんや": "مكانة عالية (منصب ذو مكانة متفوقة)",
 "王党": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "王党派": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "王公": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "王冠": "تَاج, إِكْلِيل / غِطَاء زُجَاجَة, غِطَاء قَارُورَة",
 "王后": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "王国": "مَمْلَكَة, مُلْك (دَوْلَةً يَحْكُمُهَا مَلِكٌ) / مَمْلَكَة (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "王太妃": "ولية العهد (وريثة أنثى ظاهرة للعرش) / زوجة ولي العهد (زوجة ولي العهد)",
