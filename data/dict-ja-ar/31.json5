 "刺網": "شبكة خيشومية (شبكة صيد مسطحة معلقة عمودياً في الماء لتشابك الأسماك من خياشيمها)",
 "刺繍": "تَطْرِيز",
 "刺繍枠": "طارة تطريز (إطار مصنوع من طارتين؛ يستخدم للتطريز)",
 "刺股": "ثُنَائِيُّ الشُّعَب (ذُو شُعْبَتَيْن)",
 "刺胞動物": "جوفمعوي, لاسع (حيوانات متناظرة شعاعياً لها أجسام تشبه الكيس بفتحة واحدة فقط ومجسات ذات هياكل لاسعة)",
 "刺蕃茘枝": "غرافيولا, قشطة شائكة (فاكهة استوائية شائكة كبيرة ذات لب لاذع) / غرافيولا, قشطة شائكة (شجرة استوائية أمريكية صغيرة تحمل فاكهة كبيرة عصيرية حامضة قليلاً)",
 "刺衝": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
 "刺身": "سَاشِيمِي",
 "刺通す": "طَعْن / طَعْنَة / طَعَنَ",
 "刺青": "وَشْم / وَشَمَ, وَشَّمَ",
 "刺魚": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "刻": "خَرْبَشَ / فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / حزم, صرامة (عزم لا هوادة فيه) / حزم, صرامة (انتباه حي الضمير للقواعد والتفاصيل) / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "刻する": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "刻み": "مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب) / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة",
 "刻み値": "زيادة, علاوة (المقدار الذي يزداد به الشيء) / تصاعد, زيادة (عملية التحول إلى أكبر أو أطول أو أكثر عدداً أو أهمية)\nمثال: اقترحوا زيادة بنسبة 15 في المائة في الأجرة",
 "刻み幅": "خطوة واسعة, قفزة (تقدم كبير (خاصة في عبارة 'قطع أشواطاً')) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / خطوة (المسافة التي تغطيها خطوة)\nمثال: قطعوا أشواطاً كبيرة في الإنتاجية",
 "刻み目": "ثلم, حز (قطع صغير) / ثلم, حز (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط) / ممر, ممر جبلي (موقع في سلسلة جبال لتكوين جيولوجي يكون أقل ارتفاعاً من القمم المحيطة) / ثلمة, حز\nمثال: كان هناك أربعة حزوز في مقبض مسدسه",
 "刻み込む": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "刻む": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / عَذَاب / عَذَّبَ",
 "刻下": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "刻印": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ.",
 "刻器": "منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "刻子": "زلاجة صندوقية (زلاجة يجرها حصان واحد تتكون من صندوق على زحافات)",
 "刻時機構": "سَاعَة, ساعة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "刻薄": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "刻限": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "剃り跡": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "剃る": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "剃刀": "شَفْرَة حِلَاقَة / بَالِغ الوُضُوح (مُحَدَّد المَعَالِم بِوُضُوح شَدِيد) / حَادٌّ كَالمُوسَى (حادّ كحدّة شفرة الموسى)",
 "剃刀砥": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ)",
 "剃毛": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "剃髪": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "剄る": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "則": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / مُنْحَدَر / مَيْل",
 "則る": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "削ぎ落とす": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "削ぐ": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / قَلَّلَ",
 "削げる": "انفصل / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "削げ落とす": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "削り": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削りかす": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削りくず": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削りクズ": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削り出す": "آلَة, مَاكِينَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "削り屑": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削り滓": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削り粕": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "削る": "حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / قَلَّلَ / حَذَفَ (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "削剥作用": "تعرية, كشف (إزالة الغطاء)",
 "削去": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "削器": "مِكْشَطة (أي من الأدوات اليدوية المختلفة للكشط)",
 "削岩機": "ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "削摩": "تعرية, كشف (إزالة الغطاء) / انحناءة مبالغ فيها (انحناء عميق مع سحب القدم للخلف (يدل على التواضع المفرط)) / خدش, كشط (ضجيج خشن ناتج عن الكشط) / كُشَاطَة ((عادةً بالجمع) ما يُكشط عن سطح شيء ما ويُجمع)\nمثال: كل ذلك الانحناء والتذلل لم يثر إعجابه",
 "削減": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "削片": "شَظِيَّة",
 "削片板": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في أوراق صلبة)",
 "削進": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "削除": "حذف, شطب (عملية حذف شيء مكتوب أو مطبوع) / استئصال, حذف (الإسقاط الذي يحدث عندما يختصر التغيير التحريري مقطعاً مكتوباً) / حذف ((في علم الوراثة) فقدان أو غياب نيوكليوتيد واحد أو أكثر من الكروموسوم) / حذف (أي عملية يتم فيها ترك أصوات أو كلمات من الكلمات أو العبارات المنطوقة)\nمثال: حذوفات المحرر كثيراً ما تزعج المؤلفين الشباب",
 "剋": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / اِنْتِصَار, نَصْر / حزم, صرامة (عزم لا هوادة فيه) / حزم, صرامة (انتباه حي الضمير للقواعد والتفاصيل)",
 "前": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أماماً, في المقدمة (في أو في المقدمة) / سلفاً, مسبقاً (قبل الوقت؛ تحسباً) / إلى الأمام, قدماً (في اتجاه أمامي) / في الصدارة, متقدماً (يتقدم أو يسبق في منافسة)\nمثال: أرى أضواء مدينة أمامنا / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر. / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / جَبْهَة / أَمَامِيّ / صَاعِدًا / مُهَاجِم\nمثال: まっすぐ前を見てください。 — انظر امامك مباشره.",
 "前々から": "دَائِمًا, أَبَدًا",
 "前々日": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / قَبْلَ أَمْس, أَمْس الْأَوَّل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: لم تكن أول مرة.",
 "前かがみ": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前かがみになる": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "前だれ": "مِرْيَلَة, مِئْزَر",
 "前のめり": "وِقَائِيّ, استباق الْأَحْدَاث / مُتَسَرِّع",
 "前ふり": "مُقَدِّمَة",
 "前ぶれ": "بَشِير, مُبَشِّر",
 "前もって": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "前を失礼します": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "前カレ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "前ジテ": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "前世": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "前世紀": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "前人": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "前人未到": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "前人未発": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "前人未踏": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)",
 "前仕手": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "前付": "المواد التمهيدية, مقدمات الكتاب (مادة مكتوبة تسبق المتن الرئيسي لكتاب)",
 "前付け": "المواد التمهيدية, مقدمات الكتاب (مادة مكتوبة تسبق المتن الرئيسي لكتاب)",
 "前代未聞": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل)",
 "前件": "سَابِق (يسبق في الوقت أو الترتيب) / سَابِق (مرجع الجناس؛ عبارة أو جملة يشار إليها بضمير عائد) / سابقة, مقدمة (حدث أو سبب أو واقعة سابقة) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد))",
 "前任": "سَابِق",
 "前任者": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / سَلَف (من يسبقك في الوقت (كما في شغل منصب أو وظيفة))",
 "前会計": "دفع مسبق (الدفع مقدماً)",
 "前例": "سَابِقَة (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة)\nمثال: افتقد لزوجته السابقة.",
 "前倒し": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "前借": "قَرْض, إِعَارَة",
 "前借金": "قَرْض, إِعَارَة",
 "前側": "أَمَامِيّ",
 "前備え": "طَلِيعَة",
 "前兆": "فَأل, نَذِيْر",
 "前兆現象": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / سلائف, مادة أولية (مادة تتكون منها مادة أخرى (خاصة عن طريق تفاعل استقلابي))",
 "前処理": "تَحْضِير, إِعْدَاد",
 "前出": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "前前日": "أَوَّل أَمْس (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / قَبْلَ أَمْس, أَمْس الْأَوَّل (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: لم تكن أول مرة.",
 "前半": "شوط أول (الأول من شوطين للعب)",
 "前古": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "前史": "عَصْر مَا قَبْلَ التَّارِيخ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "前向き": "حَدَاثِيّ, مُبْتَكِر (سابق لعصره ومتطوّر)",
 "前向性健忘": "فقدان الذاكرة التقدمي, نسيان تقدمي (فقدان الذاكرة للأحداث التي تلي الصدمة مباشرة؛ وأحياناً يسري على الأحداث أثناء الصدمة ولفترة طويلة بعدها)",
 "前哨": "مخفر أمامي (موقع عسكري متمركز على مسافة من الجسم الرئيسي للقوات) / مخفر حدودي, مستوطنة حدودية (مستوطنة على حدود الحضارة) / مخفر أمامي, نقطة نائية (محطة في موقع ناء أو قليل السكان)",
 "前哨地": "مخفر أمامي (موقع عسكري متمركز على مسافة من الجسم الرئيسي للقوات) / مخفر حدودي, مستوطنة حدودية (مستوطنة على حدود الحضارة) / مخفر أمامي, نقطة نائية (محطة في موقع ناء أو قليل السكان)",
 "前哨戦": "مُنَاوَشَة / بريلود, مقدمة (موسيقى تسبق الفوغا أو تقدم فصلاً في الأوبرا) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "前垂": "مِرْيَلَة, مِئْزَر",
