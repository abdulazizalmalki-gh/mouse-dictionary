 "凶相": "نَحْس, سُوءُ الحَظّ",
 "凶荒": "مَجَاعَة",
 "凶行": "عُنْف, عَنْف / عُنْف",
 "凶行人": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية) / همجي, وحش (شخص قاسي وجشع)",
 "凶賊": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "凶運": "نَحْس, شُؤْم",
 "凸": "حَاجِب (قوس الشعر فوق كل عين) / جبهة, جبين (جزء الوجه فوق العينين) / قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة / خبطة, ضربة (ارتطام (كما هو الحال في التصادم)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, ورم (كتلة في الجسم ناتجة عن ضربة)\nمثال: الخبطة ألقته عن الدراجة / مُحَدَّب",
 "凸する": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "凸る": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / رِسَالَة, خَبَر",
 "凸レンズ": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "凸円": "تحدب (الخاصية التي يمتلكها الشكل المحدب) / تحدب, شكل محدب (شكل ينحني أو يبرز إلى الخارج)",
 "凸凹": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / عَدَم مُسَاوَاة (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل) / مُتَبَايِنَة\nمثال: عليك عدم الخوف.",
 "凸助": "فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ) / بَوْش\nمثال: انظر من الفتحة.",
 "凸坊": "عَابِس, مُقَطِّب الجَبِين (كَئِيب أَوْ غَيْر وُدِّيّ فِي المَظْهَر)",
 "凸型": "تحدب (الخاصية التي يمتلكها الشكل المحدب) / تحدب, شكل محدب (شكل ينحني أو يبرز إلى الخارج)",
