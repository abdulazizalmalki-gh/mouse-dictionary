 "低血糖症": "نقص سكر الدم (انخفاض نسبة السكر في الدم بشكل غير طبيعي ناتج عادة عن الأنسولين المفرط أو سوء…)",
 "低語": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح)",
 "低調": "خَامِد",
 "低資": "منخفض الفائدة ((تستخدم للقروض) تفرض نسبة صغيرة نسبياً من المبلغ المقترض)",
 "低軌道": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "低迷": "حَامَ (دار أو طاف حول شيء؛ اقترب من شيء دون الوصول إليه)",
 "低速ギヤ": "الترس الأول, السرعة الأولى (أدنى نسبة تروس أمامية في صندوق تروس المركبة؛ تستخدم لبدء تحرك السيارة)",
 "低速車": "بَطِيء الحَرَكَة (يَتَحَرَّك بِبُطْء)",
 "低酸素症": "نقص الأكسجة (نقص الأكسجين مما يسبب دافعاً قوياً جداً لتصحيح النقص)",
 "低金利政策": "ائتمان منخفض الفائدة, مال رخيص (ائتمان متاح بأسعار فائدة منخفضة)",
 "低開発国": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "低音": "غيتار البيس",
 "低音部記号": "مفتاح الباص, مفتاح فا (مفتاح)\nمثال: بحث عن المفتاح.",
 "低頻度": "تردد منخفض, طبقة منخفضة (طبقة صوتية تُدرك على أنها أدنى من غيرها)",
 "低騒音": "صَامِت, هَادِئ",
 "低髄液圧症候群": "سائل دماغي شوكي (سائل صاف ينتج في بطينات الدماغ؛ يملأ ويحمي التجاويف في الدماغ والحبل الشوكي)",
 "住": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل.",
 "住い": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "住す": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "住する": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "住まい": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "住まい手": "سَاكِن, سَاكِنَة",
 "住まう": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "住みか": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد)",
 "住みつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "住みにくい": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "住みやすい": "مُنَاسِب, مُلَائِم",
 "住み分け": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع)",
 "住み分ける": "فَرَّقَ",
 "住み心地": "رَاحَة",
 "住み所": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "住み手": "مُسْتَأْجِر",
 "住み易い": "مُنَاسِب, مُلَائِم",
 "住み替え": "مُتَحَرِّك",
 "住み着く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "住み込む": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "住み難い": "غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "住む": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "住んだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "住人": "ساكن, قاطن (شخص يسكن في مكان معين) / مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما…)\nمثال: اشتريت جوال مستعمل.",
 "住処": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد)",
 "住友": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "住吉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "住宅": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "住宅ローン": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "住宅ローン減税": "إعفاء ضريبي, خصم ضريبي (تخفيض في المبلغ الإجمالي الذي تُحسب عليه الضريبة؛ يقلل الضرائب بالنسبة المئوية…)",
 "住宅団地": "مجمع سكني, مشروع سكني (منطقة سكنية تضم مساكن متشابهة بناها مطورون عقاريون وتخضع عادة لإدارة واحدة)\nمثال: يعيشون في المجمع السكني الجديد",
 "住宅地": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住宅地区": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住宅産業": "صناعة الإسكان, صناعة البناء والتشييد (صناعة تقوم ببناء المساكن)",
 "住宅用火災警報器": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "住宅街": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住宅設備": "أداة منزلية, جهاز منزلي (جهاز يؤدي وظيفة محددة في المنزل)",
 "住宅都市整備公団": "وزارة الإسكان والتنمية الحضرية (الإدارة الفيدرالية الأمريكية التي تدير البرامج الفيدرالية التي تتعامل مع تحسين…)",
 "住宅金融組合": "جمعية بناء (المعادل البريطاني لجمعية الادخار والإقراض في الولايات المتحدة)",
 "住家": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / عَرِين, جُحْر (اِسْمٌ لِمَاْوَى الأَسَد) / مَجْلِس",
 "住居": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل.",
 "住居侵入罪": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "住居地域": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "住屋": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل.",
 "住所": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "住所地": "مأوى, مسكن (سكن يعيش فيه شخص ما)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "住所録": "قَائِمَة بَرِيدِيَّة",
 "住替え": "مُتَحَرِّك",
 "住民": "سَاكِن, سَاكِنَة",
 "住民投票": "اِسْتِفْتَاء عَام (تصويت من قبل الناخبين لتحديد الرأي العام حول مسألة ذات أهمية وطنية)",
 "住環境": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "住着く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "住空間": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "住職": "رَئِيس الدَّيْر, أَبَاتِي",
 "住血吸虫": "بلهارسيا, منشقة (ديدان مفلطحة تتطفل في الأوعية الدموية للثدييات)",
 "住血吸虫症": "بلهارسيا, داء البلهارسيات (عدوى طفيلية تسببها طفيليات من جنس البلهارسيا؛ شائعة في المناطق الاستوائية…)",
 "住設": "أداة منزلية, جهاز منزلي (جهاز يؤدي وظيفة محددة في المنزل)",
 "住警器": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
