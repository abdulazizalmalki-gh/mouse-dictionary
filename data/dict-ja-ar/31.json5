 "中町": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "中略": "إِغْفَال",
 "中皮": "ظهارة متوسطة (ظهارة تنشأ في الأديم المتوسط الجنيني؛ تبطن تجويف الجسم البدائي)",
 "中皮腫": "ورم الظهارة المتوسطة (شكل من أشكال سرطانة الظهارة المتوسطة المبطنة للرئتين أو البطن أو القلب؛ يرتبط عادة بالتعرض لغبار الأسبستوس)",
 "中皿": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "中盛": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "中盛り": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "中盤": "مركز, منتصف (نقطة متساوية البعد عن نهايات خط أو أطراف شكل ما) / خط الوسط, وسط الملعب ((رياضة) الجزء الأوسط من ملعب اللعب (كما في كرة القدم))",
 "中石": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "中石器時代": "حجري متوسط, ميزوليثي (من أو متعلق بفترة متوسطة من العصر الحجري (تلي العصر الحجري القديم))",
 "中神": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "中秋の名月": "قمر الحصاد (القمر المكتمل الأقرب إلى الاعتدال الخريفي (في سبتمبر))",
 "中程": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "中程度": "مُتَوَسِّط",
 "中空": "أَجْوَف / جَوّ",
 "中立": "حِيَاد",
 "中立主義": "حياد (سياسة الحياد أو عدم الانحياز في الشؤون الدولية)",
 "中立地帯": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "中立性": "حِيَاد",
 "中立的": "مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "中等": "مُتَوَسِّط, مُعَدَّل",
 "中等学校": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / ثَانَوِيَّة (مؤَنَّث الثانَويّ)\nمثال: لا أحب المدرسة.",
 "中等教育": "تعليم ثانوي (التعليم بعد المراحل الابتدائية؛ تقدمه مدرسة ثانوية أو مدرسة تحضيرية للكلية)",
 "中等部": "مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "中篇": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم)",
 "中篇小説": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم)",
 "中米": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "中糸": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "中細": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار الرصف أو للتكسير أو الضرب أو التسطيح أو التنعيم) / عصا الإيقاع, مطرقة الطبل (عصا طبل خفيفة ذات رأس مستدير تستخدم لضرب الآلات الإيقاعية مثل الأجراس والطبول) / صولجان, مطرقة رياضية (أداة رياضية ذات مقبض طويل ورأس يشبه المطرقة؛ تستخدم في الألعاب الرياضية (البولو أو الكروكيت) لضرب الكرة)",
 "中絶": "خِدَاج, إِجْهَاض / إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "中絶性交": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "中絶薬": "حبوب الإجهاض, ميفيبريستون",
 "中継": "سِبَاق تَتَابُع / اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة / وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / سِبَاق تَتَابُع",
 "中継ぎ": "اتصال, ضم (عملية جعل شيئين متلامسين (خاصة للتواصل))\nمثال: تشابك الأيدي حول الطاولة / وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / سِبَاق تَتَابُع",
 "中継ぎ人": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "中継交換機": "ثيروكسين (هرمون تنتجه الغدة الدرقية لتنظيم عملية التمثيل الغذائي من خلال التحكم في معدل الأكسدة في الخلايا) / ثلاثي يود الثيرونين (هرمون درقي يشبه الثيروكسين ولكن مع ذرة يود واحدة أقل لكل جزيء وينتج بكمية أقل؛ يمارس نفس التأثيرات البيولوجية للثيروكسين ولكنه أكثر فاعلية وأقصر مدة) / طن, طن متري (وحدة وزن تعادل 1000 كيلوغرام) / ديوكسي ثيميدين أحادي الفوسفات\nمثال: الثيروكسين يحتوي على 65% يود",
 "中継器": "مكرر إشارة ((إلكترونيات) جهاز إلكتروني يضخم الإشارة قبل إرسالها مرة أخرى) / سلاح ناري متكرر الرمي (سلاح ناري يمكنه إطلاق عدة طلقات دون إعادة تلقيم) / عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي)) / مُكَرِّر (شخص يكرر فعل الشيء)\nمثال: يمكن استخدام مكررات الإشارة في شبكات الحاسوب لتمديد مسافات الكابلات",
 "中継地": "ختام, نقطة التوقف (النهاية الزمنية؛ وقت الختام)\nمثال: تمت الإشارة إلى نقطة توقف كل جولة بجرس",
 "中継局": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "中継所": "محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة)",
 "中継線交換機": "ثيروكسين (هرمون تنتجه الغدة الدرقية لتنظيم عملية التمثيل الغذائي من خلال التحكم في معدل الأكسدة في الخلايا) / ثلاثي يود الثيرونين (هرمون درقي يشبه الثيروكسين ولكن مع ذرة يود واحدة أقل لكل جزيء وينتج بكمية أقل؛ يمارس نفس التأثيرات البيولوجية للثيروكسين ولكنه أكثر فاعلية وأقصر مدة) / طن, طن متري (وحدة وزن تعادل 1000 كيلوغرام) / ديوكسي ثيميدين أحادي الفوسفات\nمثال: الثيروكسين يحتوي على 65% يود",
 "中継装置": "سِبَاق تَتَابُع",
