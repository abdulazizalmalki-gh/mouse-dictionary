 "八十万": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "八十代": "ثَمَانُونَ (يَدُلُّ عَلَى العَدَد 80) / ثَمَانُون (العدد الأصلي الذي هو حاصل ضرب عشرة في ثمانية)",
 "八十日目": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "八千": "ثَمَانِيَة آلَاف / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "八千代": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "八千年": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "八千歳": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "八卦": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "八咫": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "八咫の烏": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "八咫烏": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "八哥鳥": "مينة متوجة (طائر متوج بني داكن من جنوب شرق آسيا)",
 "八島": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "八州": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "八幡": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "八幡の藪知らず": "مَتَاهَة",
 "八幡知らず": "مَتَاهَة",
 "八折り判": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "八折判": "قطع ثُماني (حجم كتاب تُصنع صفحاته بطي ورقة ثلاث مرات لتكوين ثماني ورقات)",
 "八挺": "براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "八方美人": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع))",
 "八時": "اَلسَّاعَة اَلثَّامِنَة",
 "八月": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "八本": "ثَمَانِيَة, تمانية / ثَمَانِيَةٌ",
 "八洲": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "八洲国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "八百": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة / جماهير, جموع (عامة الناس بشكل عام) / جمهور, حشد كبير (تجمع كبير للناس) / جموع, حشد (كمية كبيرة غير محددة)\nمثال: افصل المحاربين عن الجموع",
 "八百万": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل",
 "八百屋": "بَقَّال / جاك لجميع المهن",
 "八百長": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "八目": "ثَامِن, ثَامِنَة / ثُمْن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "八目鰻": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "八腕類": "أخطبوطيات (رأسيات الأرجل بثمانية أذرع ولكن تفتقر إلى صدفة داخلية)",
 "八角": "مثمن / ليسوم حقيقي, ينسون نجمي",
 "八角形": "مثمن",
 "八角茴香": "ليسوم حقيقي, ينسون نجمي",
 "八辺形": "مثمن",
 "八進数": "ثماني (متعلق بنظام عددي أساسه 8)\nمثال: رقم ثماني",
 "八進法": "تدوين ثماني (أي تدوين رياضي يستخدم 8 أحرف مختلفة (عادة الأرقام من 0 إلى 7))",
 "八重": "ثُمَانِيّ (ذو ثماني وحدات أو مكوّنات) / ضِعْفِيّ, مُضَاعَف (ضعف الكمية أو العدد)",
 "八面体": "ثماني السطوح (أي متعدد سطوح له ثمانية أوجه مستوية)",
 "八面六臂": "جاك لجميع المهن",
 "八面玲瓏": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "八頭": "يَام",
 "公": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته. / عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / دُوق ((دَوْقَّهُ): حَمَّقَهُ)\nمثال: الدوق يمتلك الكثير من الأراضي. / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق.",
 "公々然": "فِي وَضَح اَلنَّهَار (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / جهارًا نهارًا\nمثال: جون في عمر أخي.",
 "公の場": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
