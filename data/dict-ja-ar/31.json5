 "𬵪": "إِسْقُمَرِيّ / مَاكْرِيل",
 "𰻞𰻞麺": "معكرونة بيانجبيانج",
 "﨑": "رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "﨟纈染": "باتيك",
 "﨟纈染め": "باتيك",
 "＆": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "０": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر.",
 "０時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "０番目": "صِفْرِيّ",
 "１": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１つ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "１つがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "１つ目": "أَعْوَر, عَوْرَاء / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "１つ１つ": "بِالتَّفْصِيل, تَفْصِيلًا",
 "１つ２つ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "１ミリ": "بُوصَة, شِبْر",
 "１丁目１番地": "بَادِئَ ذِي بَدْءٍ",
 "１万": "عَشَرَة آلَاف",
 "１世紀": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "１人": "لوحد / لحال / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "１人で": "وَحِيد, مُنْفَرِد",
 "１人残らず": "كُلّ, جَمِيع",
 "１人１人": "كُلّ",
 "１佐": "عَقِيد, زَعِيم",
 "１個": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１個あたり": "كُلّ",
 "１個当たり": "كُلّ",
 "１個当り": "كُلّ",
 "１億": "مئة مليون",
 "１切れ": "شريحة / قَطَّعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "１列": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎.",
 "１匹": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１回": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "１士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "１尉": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "１年生": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ. / سَنَوِيّ",
 "１度": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "１度も": "يَوْمًا",
 "１打": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "１撃": "البَرْق",
 "１日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "１時": "اَلسَّاعَة اَلْوَاحِدَة / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "１月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "１服": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "１本": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / غَيْشَا",
 "１杯": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان / سِعَة / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１枚": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１次": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَوَّلِيّ",
 "１歩": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة\nمثال: もう一歩も歩けないよ。 — لا يمكنني المشي خطوة أخرى. / مُسْتَوًى / مَرْحَلَة",
 "１歩１歩": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "１番": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَفْضَل / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "１番手": "مُتَكَلِّم",
 "１番目": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "１等": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "１等兵": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "１等空佐": "عَقِيد, زَعِيم",
 "１等陸佐": "عَقِيد, زَعِيم",
 "１等陸士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "１羽": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１行": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "１足": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "１錠": "صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: هذه شركة صينية.",
 "１階": "طَابِق أَرْضِيّ, دَوْر أَرْضِيّ",
 "１頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "１０": "عَشَرَة, عَشْرَة",
 "１０万": "مِائَة أَلْف",
 "１０分の１": "عَاشِر / عُشْر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "１０割": "كُلّ شَيْء",
 "１０時": "اَلسَّاعَة اَلْعَاشِرَة",
 "１０月": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "１０進": "عَشْرِيّ",
 "１０進小数点": "فَاصِل عَشْرِيّ",
 "１０進数": "عَشْرِيّ",
 "１００": "مِٱئَة, مِئَة",
 "１００パー": "تَمَامًا",
 "１００万": "مِلْيُون, ١٠٠٠٠٠٠ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "１００点満点": "كَمَال, إتقان",
 "１００００": "عَشَرَة آلَاف",
 "１０００００": "مِائَة أَلْف",
 "１００００００": "مِلْيُون, ١٠٠٠٠٠٠ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "１１": "أَحَد عَشَر, إِحْدَى عَشْرَةَ (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / مِشْوَال, رَافِعَة / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "１１時": "السَاعَة الحَادِيَة عَشَرَة",
 "１１月": "نُوفِمْبِر, نُوفَمْبِر (الشهر الحادي عشر في السنة الميلادية)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "１１０番": "أُطْلُب الشُّرْطَة, نَاد الشُّرْطَة",
 "１２": "اِثْنَا عَشَرَ / مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "１２時": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "１２月": "دِيسِمْبِر, دِيسَمْبِر (الشهر الثاني عشر في السنة الروميّة)\nمثال: أنا في إضراب من 8 إلى 12 ديسمبر.",
 "１２０パーセント": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "１２０％": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "１３": "ثَلَاثَةَ عَشَرَ (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "１３月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "１４": "أَرْبَعَةَ عَشَرَ (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "１５": "خَمْسَةَ عَشَرَ (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
