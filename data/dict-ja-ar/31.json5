 "人道橋": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "人道犯罪": "جَرِيمَة ضِدَّ الْإِنْسَانِيَّةَ",
 "人道的": "إِنْسَانِيّ",
 "人達": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "人里": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "人里はなれた": "وَحِيد, مُوحِش",
 "人里離れた": "وَحِيد, مُوحِش",
 "人長": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "人間": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "人間のくず": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "人間のクズ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "人間の堕落": "السقوط, الهبوط ((الميثولوجيا اليهودية المسيحية) عندما أكل آدم وحواء من ثمر شجرة معرفة الخير والشر، فعاقبهما الله بإخراجهما من جنة عدن إلى العالم حيث يخضعان للمرض…)",
 "人間の屑": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "人間の盾": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "人間らしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "人間不信": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)",
 "人間中心主義": "مركزية بشرية (الميل لتقييم الواقع حصرياً من حيث القيم البشرية)",
 "人間中心的": "متمركز حول الإنسان (يتمحور حول الإنسان)\nمثال: نظرتنا للعالم التي تتمركز حول الإنسان",
 "人間以上": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "人間力": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة) / دهاء, سعة الحيلة (القدرة على التعامل بدهاء مع المشاكل غير العادية)\nمثال: رجل ذو دهاء عظيم",
 "人間化": "أَنْسَنَة",
 "人間同士": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "人間型": "أندرويد, روبوت بشري (إنسان آلي يشبه البشر)",
 "人間失格": "لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "人間嫌い": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "人間工学": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين العمال وبيئاتهم)",
 "人間工学的": "أرغونومي, هندسي بشري (مكون من أو متعلق ببيئة العمل (الأرغونوميا) وملائمتها للبشر)",
 "人間性": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "人間愛": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "人間拡張": "ههه",
 "人間活動": "عَمَل بَشَرِيّ, فِعْل (شيء يفعله الناس أو يتسبّبون في حدوثه)",
 "人間生態学": "ديموغرافيا, علم السكان (فرع علم الاجتماع الذي يدرس خصائص السكان البشريين)",
 "人間疎外": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "人間的": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "人間道": "إِنْسَانِيَّة, رَأْفَة (صفة الرحمة أو مراعاة الآخرين (الناس أو الحيوانات))",
 "人間関係": "عَلَاقَة شَخْصِيَّة (علاقة بين الأشخاص)",
 "人集め": "جمهور, حشد كبير (تجمع كبير للناس)",
 "人集り": "كَوْم",
 "人非人": "الْأَلَدُّ الْخَصِم / مَهْوُوْس",
 "人面": "وجه, وجه بشري (مقدمة الرأس البشري من الجبهة إلى الذقن ومن الأذن للأذن)\nمثال: غسل وجهه",
 "人頭": "سُكَّان / سُكَّانِيَّة / رأس بشري (رأس كائن بشري) / جُمْجُمَة",
 "人頭税": "ضريبة الاقتراع (ضريبة بمبلغ ثابت لكل شخص وتدفع كشرط للحصول على حق التصويت)",
 "人類": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "人類学": "عِلْمُ الإِنْسَان, أَنْطْرُوبُولُوجْيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "人類学者": "أنثروبولوجي, عالم أنثروبولوجيا (عالم اجتماعي متخصص في الأنثروبولوجيا)",
 "人類愛": "إِنْسَانِيَّة",
 "人類猿": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "人食い": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "人食いザメ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "人食い人種": "غُول, آكِلُ لُحُوم البَشْر",
 "人食い馬": "عَاضّ (شخص يقوم بالعض)",
 "人食い鮫": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "人馬": "قَنْطُور",
 "人馬宮": "بُرْج اَلْقَوْس, اَلْقَوْس (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "人騒がせ": "إنذار كاذب (تحذير يُعطى بشأن شيء يفشل في الحدوث)",
 "人騙し": "خِدَاع, خَدْع",
 "人魂": "شِهَاب",
 "人魚": "خَيَلَان, اِبْنَة الْبَحْر",
 "人鳥": "بِطْرِيق",
 "人鳥類": "بِطْرِيق",
 "什": "عَشَرَة, عَشْرَة",
 "什一": "عُشر (تقدمة تمثل عشر الدخل الشخصي) / عشور (جباية تعادل عُشر شيء ما)",
 "什一献金": "عُشر (تقدمة تمثل عشر الدخل الشخصي) / عشور (جباية تعادل عُشر شيء ما)",
 "什器": "آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل))",
 "什物": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية.",
 "什麼": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)",
 "仁": "النزعَة إلى الخير / بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق. / نَوَاة / نوية",
 "仁人": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (من أو يتعلق بالمذهب الإنساني أو يميزه) / إنساني (مدافع عن مبادئ الإنسانية؛ شخص مهتم بمصالح البشر ورفاهيتهم) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: مساعدات إنسانية",
 "仁侠": "مُرُوءَة / يَاكُوزَا",
 "仁兄": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "仁川": "إِنْشْيُون",
 "仁徳": "النزعَة إلى الخير",
 "仁心": "النزعَة إلى الخير",
 "仁恕": "النزعَة إلى الخير",
 "仁恵": "دماثة, لطف (صفة كون الشخص طيباً ووديعاً) / دماثة, لطف (تميز في الأخلاق أو السلوك الاجتماعي)",
 "仁愛": "النزعَة إلى الخير",
 "仁慈": "حَنُون بِالفِطْرَة, طَيِّب القَلْب (ذو طبع فطري طيّب وحنون)",
 "仁村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "仁科": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "仁義": "فَضِيلَة / عِفَّة, طَهَارَة / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "仁者": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (من أو يتعلق بالمذهب الإنساني أو يميزه) / إنساني (مدافع عن مبادئ الإنسانية؛ شخص مهتم بمصالح البشر ورفاهيتهم) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: مساعدات إنسانية",
 "仁藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "仁輪加狂言": "فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة) / حشوة مفرومة, فورس ميت (خليط من الدجاج النيئ المفروم والفطر مع الفستق والكمأة والبصل والبقدونس والكثير من الزبدة ويربط بالبيض)",
 "仄": "بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت",
 "仄々": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط / بحرارة, بقلب خالص (بطريقة قلبية) / بشكل ثقيل (للملابس), بشكل دافئ (بطريقة دافئة (غالباً للملابس))\nمثال: رحبنا بها بحرارة",
 "仄か": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "仄めかし": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "仄めかす": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "仄めく": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / بريق خافت, بصيص (وميض من الضوء (خاصة الضوء المنعكس))\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "仄仄": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط / بحرارة, بقلب خالص (بطريقة قلبية) / بشكل ثقيل (للملابس), بشكل دافئ (بطريقة دافئة (غالباً للملابس))\nمثال: رحبنا بها بحرارة",
 "仄暗い": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "仆る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "仇": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / ضَرَّ أَضَرَّ / مُنَافِس / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر. / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "仇する": "ضَرَرٌ / ضَرَّ أَضَرَّ / غَزَا, اِجْتاحَ / عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "仇となる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "仇なす": "اِنْتَقَمَ",
 "仇になる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "仇をなす": "اِنْتَقَمَ",
 "仇を取る": "اِنْتَقَمَ",
 "仇を成す": "اِنْتَقَمَ",
 "仇敵": "عَدُوّ, عَدُوَّة (ركض أو جري) / عَدُوّ (ركض أو جري) / عَدَائِيّ",
 "仇討": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "仇討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "仇讎": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ) / اِنْتَقَمَ\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "今": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "今い": "تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "今から": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "今か今か": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "今が今": "آنِفاً",
 "今さっき": "آنِفاً",
 "今さら": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "今さらながら": "مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "今しがた": "آنِفاً",
 "今しき": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今しも": "آنِفاً",
 "今し方": "آنِفاً",
 "今すぐ": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "今すぐにでも": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "今っぽい": "عَصْرِيّ, حَدِيث",
 "今でこそ": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今では": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今でも": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "今となっては": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "今どき": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今なお": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "今に": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "今にして": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今になって": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今にも": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "今のうち": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今のとこ": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "今のところ": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "今の内": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今の所": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "今の時代": "الأوقات المعاصرة, العصر الحديث (ظروف وأفكار العصر الحالي)\nمثال: في أوقات حديثة كهذه",
 "今はこれまで": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "今はなき": "رَاحِل, مُتَوَفًّى (ميّت؛ انتقل إلى رحمة الله) / سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت / رَاحِل, مُتَوَفًّى (ميّت؛ انتقل إلى رحمة الله) / ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول)) / سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)\nمثال: حشد صاخب من البحارة المخمورين",
 "今はむかし": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "今はやり": "عَصْرِيّ, مُوَاكِب لِلْمُوضَة (رائج ويُعتبر جذاباً أو عصرياً في وقته)",
 "今は亡き": "رَاحِل, مُتَوَفًّى (ميّت؛ انتقل إلى رحمة الله) / سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "今は昔": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "今は是まで": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "今は是迄": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "今は此れ迄": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "今は無き": "رَاحِل, مُتَوَفًّى (ميّت؛ انتقل إلى رحمة الله) / ثمل, سكران (مذهول أو متهيج بواسطة مادة كيميائية (خاصة الكحول)) / سَالِف, غَابِر (فِي المَاضِي البَعِيدِ؛ سَابِق) / مُسْتَنْفَد, مُنْهَكُ القُوَى (نُزِفَتْ طَاقَتُهُ أَوْ فَاعِلِيَّتُهُ؛ مُتْعَبٌ تَمَامًا)\nمثال: حشد صاخب من البحارة المخمورين",
 "今ひとつ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "今ほど": "آنِفاً",
 "今まで": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "今までで": "حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "今までにない": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "今めかしい": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس) / عَصْرِيّ, مُوَاكِب لِلْمُوضَة (رائج ويُعتبر جذاباً أو عصرياً في وقته)\nمثال: ملابس عصرية",
 "今も": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "今もって": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "今もなお": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "今も尚": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "今や": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今や遅しと": "بفارغ الصبر, بنافذ الصبر (مع نفاد صبر؛ بطريقة غير صبورة)\nمثال: أجابها بفارغ الصبر",
 "今を去る": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "今を去ること": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "今を盛りと": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
 "今んとこ": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "今一": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً",
 "今一つ": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "今一度": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "今一歩": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "今井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今以て": "بعد, حتى الآن (تستخدم في الجمل المنفية لوصف موقف كان قائماً حتى هذه النقطة أو حتى الوقت الحاضر)\nمثال: حتى الآن لم يتصل",
 "今別府": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今回": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今夕": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "今夜": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "今宵": "الليلة, هذا المساء (خلال ليلة اليوم الحالي)\nمثال: مر علي الليلة",
 "今少し": "قَلِيلًا",
 "今尚": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "今川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今帰仁": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "今度": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / حالاً, خلال وقت قصير (في المستقبل القريب) / بفترة قصيرة, بوقت قصير (لفترة قصيرة) / بمسافة قصيرة (على مسافة قصيرة) / بِإِيجَاز, بِاخْتِصَار (بطريقة موجزة؛ في بضع كلمات)\nمثال: سيكون الطبيب هنا قريباً / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "今後": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "今後とも": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "今後共": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "今思えば": "فِي وَقْت لَاحِق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "今日": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "今日あって明日ない身": "تذكرة الموت, ميمينتو موري (تذكير (مثل جمجمة) بحتمية موتك)",
 "今日このごろ": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今日この頃": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今日た": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار / مُؤَخَّرًا / حَدِيثًا / بِأَخَرَة",
 "今日では": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今日のところは": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "今日の所は": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "今日は": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "今日び": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今日も今日とて": "يَوْمًا بَعْدَ يَوْم",
 "今日日": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今日様": "إله الشمس (إله يجسد الشمس أو يرتبط بها بشكل ما)",
 "今日的": "عَصْرِيّ, حَدِيث",
 "今時": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今晩": "هٰذَا الْمَسَاء, اللَّيْلَ / اَللَّيْلَة",
 "今晩は": "مَسَاء الْخَيْر, مَسَاء النُّور",
 "今暁": "هٰذَا الصَّبَاح",
 "今更": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "今更ながら": "مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "今朝": "هٰذَا الصَّبَاح",
 "今朝がた": "هٰذَا الصَّبَاح",
 "今朝方": "هٰذَا الصَّبَاح",
 "今村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今様": "شعر, قصيدة (مؤلف مكتوب بتفعيلات مترية تشكل أسطراً إيقاعية)",
 "今様歌": "شعر, قصيدة (مؤلف مكتوب بتفعيلات مترية تشكل أسطراً إيقاعية)",
 "今次": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "今泉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今流行り": "عَصْرِيّ, مُوَاكِب لِلْمُوضَة (رائج ويُعتبر جذاباً أو عصرياً في وقته)",
 "今現在": "آنِفاً",
 "今田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今直ぐ": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "今直ぐにでも": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "今程": "آنِفاً",
 "今節": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今般": "الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "今西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今道心": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "今野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "今風": "عَصْرِيّ, حَدِيث",
 "介": "دِرْع (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)",
 "介して": "عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / خِلَالَ, عَبْرَ / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / بِوَاسِطَة\nمثال: عبر جرذ الطريق.",
 "介す": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "介する": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "介入": "تَدَخُّل, تَطَفُّل",
 "介助": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "介助者": "مرافق عسكري, مساعد (ضابط يعمل كمساعد عسكري لضابط أعلى رتبة) / مساعد (شخص يعمل كمساعد)",
 "介卵": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / استغراق في التفكير, وجوم (تأمل مرضي مستمر في مشكلة ما) / تحضين, حضن (الجلوس على البيض لفقسه بواسطة دفء الجسم)",
 "介在": "مَوْجُود (الذي له وجود)\nمثال: أنا موجود لوحدي",
 "介在配列": "إنترون (تسلسل من الحمض النووي لجين حقيقي النواة لا يترجم إلى بروتين)",
 "介抱": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "介殻": "صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)",
 "介添え人": "إشبين العريس (الإشبين الرئيسي في حفل الزفاف) / ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "介添人": "إشبين العريس (الإشبين الرئيسي في حفل الزفاف) / ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "介詞": "جَارّ, حَرْف جَرّ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "介護": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "介護付きホーム": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "介護付ホーム": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "介護保険法": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "介護士": "مُقَدِّم الرِّعايَة (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "介護施設": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "介護殺人": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "介護者": "مُقَدِّم رِعَايَة (شخص مسؤول عن تلبية احتياجات طفل أو شخص بالغ معال) / أخصائي صحي, مقدم رعاية صحية (شخص يساعد في تحديد أو منع أو علاج المرض أو الإعاقة)",
 "介護認定": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "介錯": "ضرب العنق, قطع الرأس (القتل بقطع الرأس) / قطع الرأس (الإعدام بقطع رأس الضحية) / مُسَاعَدَة, إِمْدَاد",
 "介錯人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "介音": "مُتَوَسِّط, وَسَطِيّ (يتعلّق بالوسط أو يقع فيه أو يمتدّ نحوه) / مُتَوَسِّط, نَاصِف (يَقْسِم الحَيَوَان إِلَى نِصْفَيْن أَيْمَن وَأَيْسَر)",
 "仍りて": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "仏": "فَرَنْجَة / فرنسا (أوروبية تقع في الجزء الجنوبي الغربي من قارة أوروبا. كانت تسمى بلاد الإِفْرَنْجَ أو الفَرَنْجَة)\nمثال: نساء فرنسا جميلات. / بُوذَا, بُدّ / بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد) / بُوذَا, بُدّ / مَيِّت",
 "仏さま": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "仏さん": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "仏になる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "仏の座": "أذن القسيس, لاميون متموج (نبات أوراسي له أوراق مسننة وزهور صغيرة ثنائية الشفة بيضاء أو حمراء أرجوانية)",
 "仏トン": "طُنّ مِتْرِيّ",
 "仏人": "فرنسي (شخص يحمل الجنسية الفرنسية)",
 "仏典": "سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية)",
 "仏図": "بُوذَا, بُدّ / سْتُوبَا",
 "仏国": "فَرَنْجَة / فرنسا (أوروبية تقع في الجزء الجنوبي الغربي من قارة أوروبا. كانت تسمى بلاد الإِفْرَنْجَ أو الفَرَنْجَة)\nمثال: نساء فرنسا جميلات.",
 "仏土": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض.",
 "仏塔": "سْتُوبَا",
 "仏子": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا) / بَشَرِيَّة, الْجِنْس الْبَشَرِيّ / بُودِيسَاتْفَا",
 "仏弟子": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "仏徒": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "仏心": "رَحْمَة, رَأْفَة / رَحْمَة, شَفَقَة",
 "仏心宗": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "仏性": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل) / رَأْفَة, رَحْمَة (الميل ليكون لطيفاً ومتسامحاً) / رحمة (الشعور الذي يحفز الشفقة)",
 "仏手柑": "يد بوذا (فاكهة كبيرة تشبه الليمون مقسمة إلى أقسام تشبه الأصابع؛ معظم الأصناف لا تحتوي على لب أو عصير)",
 "仏教": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "仏教家": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "仏教徒": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "仏文": "الفَرَنْسِيَّة, اللُّغَة الفَرَنْسِيَّة",
 "仏智": "إحاطة بكل شيء, علم مطلق (حالة العلم بكل شيء؛ امتلاك معرفة لا نهائية)",
 "仏果": "اَلنِّرْفَانَا",
 "仏桑花": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "仏桑華": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة)",
 "仏様": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "仏法": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "仏法僧": "كرة متدحرجة (كرة أرضية تتدحرج على طول الملعب الداخلي) / حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض) / شقراق (طائر من العالم القديم يتقلب أو يتدحرج في الطيران؛ مرتبط بالرفراف) / لفافة شعر, مجعد شعر (جهاز ميكانيكي يتكون من أنبوب أسطواني يُلف حوله الشعر لتجعيده)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً",
 "仏米": "أمريكي فرنسي (أمريكي ولد في فرنسا أو من أجداد فرنسيين)",
 "仏者": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "仏臭い": "مَا وَرَائِيّ, مُتَعَالٍ (يوجد خارج نطاق الطبيعة أو لا يتوافق معها)",
 "仏語": "الفَرَنْسِيَّة, اللُّغَة الفَرَنْسِيَّة",
 "仏貨": "فرنك فرنسي (سابقاً وحدة المال الأساسية في فرنسا)",
 "仏道": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "仏門": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "仏陀": "بُوذَا, بُدّ",
 "仏頂": "جفاء, غلظة (أسلوب فظ مفاجئ)",
 "仏頂面": "بوّز, بَرطَمَ",
 "仏領ギアナ": "غِيَانَا اَلْفَرَنْسِيَّة, غَيانا اَلْفَرَنْسِيَّة",
 "仔": "صَغِير, حَدَث",
 "仔牛": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "仔牛皮": "جلد العجل (جلد ناعم من جلد عجل)",
 "仔牛肉": "لَحْم عِجْل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "仔牛革": "جلد العجل (جلد ناعم من جلد عجل)",
 "仔犬": "جَرْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "仔猫": "قُطَيْط, قُطَيْطَة",
 "仔細": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "仔細に": "بِالتَّفْصِيل, تَفْصِيلًا",
 "仔細に及ばず": "هُنَاكَ, يُوجَدُ",
 "仔羊": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ) / لَحْم اَلضَّأْن, خَرُوف (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: حمل سامي سلاحه.",
 "仔虫": "يَرَقَة",
 "仔豚": "خِنَّوْص",
 "仔馬": "فَرَس قَزَم (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان / مُهْر, فِلْو",
 "仔鳩": "زُغْلُول, جَوْزَل",
 "仔鹿": "شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "仕": "مَسْؤُول / مَسْئُول (اسم مفعول من الفعل سَألَ بمعنى \"مايُسْأَل عنه\"؛ الشخص الذي يرعى شيئا فسوف يُسأل عنه)\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "仕える": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "仕え奉る": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "仕え女": "خادمة (عاملة منزلية)",
 "仕なおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "仕る": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "仕を致す": "اِسْتَقَالَ",
 "仕上": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "仕上がり": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "仕上げ": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "仕上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "仕上げ工": "منهي السباق (حيوان يفوز في مسابقة سرعة) / سيارة منهية للسباق (سيارة سباق تنهي السباق) / عامل تشطيب (عامل ينفذ الخطوة الأخيرة في عملية التصنيع) / مشطب, ملمع (دهان يضع طبقة الطلاء النهائية)",
 "仕上り": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "仕上工": "منهي السباق (حيوان يفوز في مسابقة سرعة) / سيارة منهية للسباق (سيارة سباق تنهي السباق) / عامل تشطيب (عامل ينفذ الخطوة الأخيرة في عملية التصنيع) / مشطب, ملمع (دهان يضع طبقة الطلاء النهائية)",
 "仕事": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "仕事の虫": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事をやめる": "اِسْتَقَالَ",
 "仕事を辞める": "اِسْتَقَالَ",
 "仕事バカ": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事中": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "仕事中毒": "إدمان العمل (قهرية تجاه العمل)",
 "仕事中毒者": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事人": "مُحْتَرِف, مُحْتَرِفَة",
 "仕事人間": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事台": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "仕事唄": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "仕事師": "عَامِل, شَغِّيل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "仕事帰り": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "仕事日": "يوم عمل (اليوم الذي يتم فيه إنجاز العمل)",
 "仕事歌": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "仕事率": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "仕事着": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "仕事第一主義": "إدمان العمل (قهرية تجاه العمل)",
 "仕事箱": "سلة عمل, صندوق أدوات الخياطة (حاوية لحفظ أدوات ومواد العمل (خاصة للخياطة))",
 "仕事部屋": "غرفة عمل, مشغل (غرفة يتم فيها إنجاز العمل)",
 "仕事量": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "仕事馬鹿": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕付": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً) / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "仕付け": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً) / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "仕付ける": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / تغيير الوجهة (الإبحار في مسار متعرج) / تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / حبل الشراع ((مصطلح بحري) حبل (أو سلسلة) ينظم الزاوية التي يتم ضبط الشراع بها بالنسبة للرياح) / سروج, عدة الخيل (تجهيزات للحصان) / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "仕付け糸": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً)",
 "仕似す": "قَلَّدَ",
 "仕儀": "حَالَة, وَضْع",
 "仕入": "شِرَاء, اِشْتِرَاء",
 "仕入れ": "شِرَاء, اِشْتِرَاء",
 "仕入れる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "仕入れ先": "مُزَوِّد, مُزَوِّدَة",
 "仕入れ単価": "سعر الشراء (السعر الذي يتم شراء شيء ما به فعلياً)",
 "仕入先": "مُزَوِّد, مُزَوِّدَة",
 "仕入単価": "سعر الشراء (السعر الذي يتم شراء شيء ما به فعلياً)",
 "仕出かす": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "仕出し": "تَمْوِين / صَامِت, غَيْر نَاطِق (غير قادر على أو لا ينطوي بشكل خاص على الكلام أو السطور المنطوقة) / ممثل دور عابر (يؤدي دوراً صغيراً في عمل درامي)\nمثال: كان له دور صامت في المسرحية",
 "仕出し屋": "متعهد طعام, ممون حفلات (شخص يوفر الطعام والخدمة (كما في الحفلات))",
 "仕出屋": "متعهد طعام, ممون حفلات (شخص يوفر الطعام والخدمة (كما في الحفلات))",
 "仕分": "تَصْنِيف",
 "仕分け": "تَصْنِيف",
 "仕分ける": "صَنَّفَ, قَسَّمَ",
 "仕切": "تَقْسِيم / إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً)",
 "仕切り": "تَقْسِيم / إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً)",
 "仕切り屋": "مُعَيَّن ذَاتِيًّا (عيّن نفسه بنفسه دون تفويض من جهة أخرى)",
 "仕切る": "تَقْسِيم / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "仕切弁": "بوابة هويس, صمام هويس (منظم يتكون من صمام أو بوابة تتحكم في معدل تدفق المياه عبر هويس)",
 "仕初": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "仕初め": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "仕口": "طَرِيقَة, مِنْهَج",
 "仕向け": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "仕向ける": "أَغْوَى, أَغْرَى / أَغْرَى / مِقْبَض / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "仕向る": "أَغْوَى, أَغْرَى / أَغْرَى / مِقْبَض / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "仕始める": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "仕度": "تَحْضِير, إِعْدَاد",
 "仕手": "فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / براز, قذارة (مصطلحات بذيئة للبراز) / مُضَارِب",
 "仕手戦": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "仕打ち": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / حَرَكَة",
 "仕拵え": "تَحْضِير, إِعْدَاد",
 "仕掛": "أَدَاة, جِهَاز / حِيلَة / مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم. / فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "仕掛かり": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "仕掛かり品": "عمل قيد الإنجاز (قطعة عمل لم تنته بعد)",
 "仕掛け": "أَدَاة, جِهَاز / حِيلَة / مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم. / فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "仕掛ける": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / تَحَدٍّ, التَّحَدِّي / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "仕掛け人": "مُحَرِّض, مُحَرِّضَة",
 "仕掛け品": "عمل قيد الإنجاز (قطعة عمل لم تنته بعد)",
 "仕掛け地雷": "شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "仕掛け扉": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "仕掛け爆弾": "شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "仕掛け絵本": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "仕掛り品": "عمل قيد الإنجاز (قطعة عمل لم تنته بعد)",
 "仕掛人": "مُحَرِّض, مُحَرِّضَة",
 "仕掛品": "عمل قيد الإنجاز (قطعة عمل لم تنته بعد)",
 "仕掛地雷": "شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "仕損じ": "خطأ فادح, زلة (خطأ محرج)",
 "仕損じる": "خطأ فادح, زلة (خطأ محرج)",
 "仕損ずる": "خطأ فادح, زلة (خطأ محرج)",
 "仕損ない": "خطأ فادح, زلة (خطأ محرج)",
 "仕方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "仕方がない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "仕方ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "仕方なく": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "仕方なしに": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "仕方のない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "仕方書": "وَصْفَة",
 "仕方無く": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "仕方無しに": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "仕業": "مَأْثُرَة",
 "仕様": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مُوَاصَفَة",
 "仕様のない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "仕様書": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ / مُوَاصَفَة",
 "仕様書き": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ / مُوَاصَفَة",
 "仕樣": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مُوَاصَفَة",
 "仕済ます": "أَدَّى",
 "仕留める": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "仕直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "仕着": "إسطبل تأجير, إيواء الخيول (رعاية (إطعام وإيواء) الخيول مقابل أجر) / تسليم, نقل قانوني (النقل الطوعي لشيء ما (سند أو حيازة) من طرف إلى آخر) / صَفْرَاوِيّ (يعاني من اضطراب كبديّ أو هضميّ أو يُوحي بذلك) / زي الخدم الموحد (زي يرتديه بعض الخدم والسائقين)",
 "仕着せ": "إسطبل تأجير, إيواء الخيول (رعاية (إطعام وإيواء) الخيول مقابل أجر) / تسليم, نقل قانوني (النقل الطوعي لشيء ما (سند أو حيازة) من طرف إلى آخر) / صَفْرَاوِيّ (يعاني من اضطراب كبديّ أو هضميّ أو يُوحي بذلك) / زي الخدم الموحد (زي يرتديه بعض الخدم والسائقين)",
 "仕種": "لَفْتَة, إِشَارَة / تَمْثِيل",
 "仕立": "تفصيل, خياطة (مهنة الخياط) / تَحْضِير, إِعْدَاد / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "仕立て": "تفصيل, خياطة (مهنة الخياط) / تَحْضِير, إِعْدَاد / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "仕立てる": "خَيَّاط, خَيَّاطَة / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "仕立て上げる": "جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "仕立て屋": "خَيَّاط, خَيَّاطَة",
 "仕立て物": "خِيَاطَة, حِيَاكَة",
 "仕立て直し": "تَغَيُّر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "仕立て直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "仕立屋": "خَيَّاط, خَيَّاطَة",
 "仕立物": "خِيَاطَة, حِيَاكَة",
 "仕組": "هَيْكَل / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "仕組み": "هَيْكَل / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "仕組む": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "仕置": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "仕置き": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "仕舞": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية",
 "仕舞い": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية",
 "仕舞いこむ": "كنز مخفي, مخبأ (مخزون سري من الأشياء الثمينة أو المال)",
 "仕舞いに": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "仕舞い込む": "كنز مخفي, مخبأ (مخزون سري من الأشياء الثمينة أو المال)",
 "仕草": "لَفْتَة, إِشَارَة / تَمْثِيل",
 "仕訳": "تَصْنِيف",
 "仕訳ける": "صَنَّفَ, قَسَّمَ",
 "仕訳書": "مُوَاصَفَة",
 "仕訳表": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل) / دفتر يومية, سجل (كتاب سجل كشيء مادي) / مذكرات, يوميات (سجل كتابي يومي للتجارب والملاحظات (الشخصية عادة)) / دورية, مجلة علمية (دورية مخصصة لموضوع معين)\nمثال: يقرأ المجلات الطبية",
 "仕込": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / تَحْضِير, إِعْدَاد",
 "仕込み": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / تَحْضِير, إِعْدَاد",
 "仕込み杖": "عصا سيف (عصا تخفي سيفاً أو خنجراً)",
 "仕込む": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه) / اِكْتَسَبَ, كَسَبَ\nمثال: متى حصل الحادث؟ / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "仕込杖": "عصا سيف (عصا تخفي سيفاً أو خنجراً)",
 "仕返し": "اِنْتِقَام, قِصَاص (فعل الانتقام (إيذاء شخص ما انتقاماً لشيء ضار فعله) خاصة في الحياة الآخرة) / استرداد الاستثمار, عائد الاستثمار (عائد مالي أو مكافأة (خاصة العوائد التي تساوي الاستثمار الأولي))\nمثال: لي النقمة أنا أجازي يقول الرب",
 "仕返す": "اِنْتَقَمَ",
 "仕送り": "سماح (فعل السماح) / تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / بدل, تعديل (مبلغ يضاف أو يخصم بناءً على ظروف مؤهلة) / بدل, مخصص (مبلغ مسموح به أو ممنوح (كما خلال فترة معينة))\nمثال: اعترض على السماح بالتدخين في غرفة الطعام",
 "仕遂げる": "أَدَّى",
 "他": "آخَر, غَيْرُهُ (أيّ بديل من بدائل شتّى؛ شيء آخر) / آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / أَبْعَد (جعله بَعيدًا؛ جَاوَزَ الحَدَّ) / أَقْصَى / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / فَوْق / فَوْقَ\nمثال: أبعد صورتها عني. / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا. / آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر.",
 "他でもない": "لم يعد (ليس الآن) / ليس, ليس أكثر (إشارة إلى الدرجة التي توجد بها صفة معينة)\nمثال: لم تعد موجودة",
 "他ない": "هُنَاكَ, يُوجَدُ\nمثال: 私たちはそこへ行くよりほかなかった。 — لم يكن لدينا خيار إلا الذهاب إلى هناك.",
 "他に": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "他にも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "他に方法がない": "هُنَاك, يُوجَد",
 "他に方法が無い": "هُنَاك, يُوجَد",
 "他に方法はない": "هُنَاك, يُوجَد",
 "他に方法は無い": "هُنَاك, يُوجَد",
 "他の追随を許さない": "لَا يُمْكِن تَجَاوُزُهُ (لا يمكن تخطيه أو التفوق عليه)",
 "他はない": "هُنَاكَ, يُوجَدُ",
 "他人": "آخَرُون\nمثال: 彼女はもっと他人の言うことを聞くべきだ。 — ينبغي لها أن تستمع إلى آراء الآخرين أكثر. / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "他人様": "آخَرُون",
 "他人行儀": "تَقْلِيدِيّ, مُتَكَلِّف (رَسْمِيٌّ بِشَكْلٍ صَارِمٍ أَوْ مُقَيَّدٌ بِالأَعْرَافِ) / فخم, مهيب (يتميز بالأبهة والمراسم والعرض الفخم)",
 "他人資本": "رأس مال مقترض (رأس المال الذي تقترضه الشركة من المؤسسات أو الأشخاص؛ ويشمل السندات المختلفة)",
 "他動": "فِعْل مُتَعَدٍّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "他動性": "تَعَدٍّ (العلاقة النحوية التي ينشئها الفعل المتعدي) / تَعَدٍّ ((المنطق والرياضيات) علاقة بين ثلاثة عناصر بحيث إذا كانت قائمة بين الأول والثاني وبين الثاني والثالث، فإنها بالضرورة تكون قائمة بين الأول والثالث)",
 "他動的": "مَبْنِيٌّ لِلْمَجْهُول",
 "他動詞": "فِعْل مُتَعَدٍّ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "他国": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "他国人": "أَجْنَبِيّ, أَجْنَبِيَّة",
 "他国者": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "他家": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "他家受粉": "تبادل التأثير, تلاقح الأفكار (تأثير محفز بين عناصر متنوعة) / تلقيح خلطي (إخصاب عن طريق نقل حبوب اللقاح من مئبر زهرة إلى ميسم زهرة أخرى)\nمثال: تلاقح الفنون",
 "他家受精": "إثراء متبادل, تلاقح فكري (التبادل بين ثقافات مختلفة أو طرق تفكير مختلفة بشكل مثمر ومفيد للطرفين) / إخصاب خلطي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من فردين مختلفين من نفس النوع)\nمثال: الإثراء المتبادل بين العلم والفنون الإبداعية",
 "他屋": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "他山の石": "عِبْرَة, مِثَال رَادِع (عقوبة يقصد بها أن تكون تحذيراً للآخرين)\nمثال: قرروا أن يجعلوه عبرة",
 "他州": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "他年": "آخَر, غَيْرُهُ (أيّ بديل من بدائل شتّى؛ شيء آخر)",
 "他心": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه",
 "他念なく": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "他念無く": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "他意": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية)) / خصومة, عداء (شعور الشخص المعادي)\nمثال: لم يستطع إخفاء عدائه",
 "他意はない": "بِدُون مُؤَاخَذَة, لَا مُؤَاخْذَة",
 "他愛": "إِيثَار, غَيْرِيَّة",
 "他我": "الأنا الآخر, توأم الروح (صديق مقرب جداً وموثوق يبدو وكأنه جزء من نفسك)",
 "他所": "خَارِج, بره / تَجَاهَلَ, طَنَّش / في مكان آخر (في أو إلى مكان آخر)\nمثال: ذهب إلى مكان آخر / مُتَحَرِّك / مُؤَثِّر",
 "他所の人": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "他所様": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "他方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "他日": "فيما بعد, من الآن فصاعداً (بعد هذا في الزمان أو الترتيب أو المكان؛ بعد هذا) / في الآخرة, في الحياة الآخرة (في حياة أو حالة مستقبلية) / أدناه, فيما بعد (في جزء لاحق من هذه الوثيقة أو البيان أو المسألة) / مستقبل (الزمن الذي لم يأت بعد)\nمثال: من الآن فصاعداً لن تتلقى مصروفاً",
 "他殺": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "他生": "تَنَاسُخ الْأَرْوَاح",
 "他界": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "他称": "غَائِب",
 "他者": "آخَرُون",
 "他者性": "انْفِصَال, تَمَايُز (صفة عدم التشابه؛ كون الشيء متميزاً أو مختلفاً عما هو معروف أو مجرب)",
 "他者間": "مُتَعَدِّد الأَطْرَاف, مُتَعَدِّد الجَوَانِب (لديه أجزاء أو جوانب متعددة)",
 "他聞": "علانية, عمومية (صفة كون الشيء مفتوحاً للأنظار العامة أو متاحاً للجمهور) / إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: علانية قاعة المحكمة",
 "他花受精": "إثراء متبادل, تلاقح فكري (التبادل بين ثقافات مختلفة أو طرق تفكير مختلفة بشكل مثمر ومفيد للطرفين) / إخصاب خلطي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من فردين مختلفين من نفس النوع)\nمثال: الإثراء المتبادل بين العلم والفنون الإبداعية",
 "他薦": "تَوْصِيَة",
 "他處": "في مكان آخر (في أو إلى مكان آخر)\nمثال: ذهب إلى مكان آخر / مُتَحَرِّك / مُؤَثِّر",
 "他覚的": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "他言": "أَفْشَى",
 "他言無用": "السر في بئر",
 "他言語": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)",
 "他責": "تبادل اللوم, تقاذف الاتهامات (اتهامات متبادلة بين أشخاص يرفضون قبول المسؤولية الفردية عن حدث غير مرغوب فيه)",
 "他郷": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "他面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "他面角": "زاوية متعددة السطوح (الفضاء المحاط بثلاثة مستويات أو أكثر تتقاطع في رأس)",
 "仗": "قدرة عسكرية, قوة عسكرية (القدرة من حيث الأفراد والمعدات التي تؤثر على القدرة على خوض الحرب)",
 "付": "بَائِد, مُؤَرَّخ (يَحْمِل سِمَات المَاضِي القَرِيب الَّذِي عَادَةً مَا يُسْتَهَان بِه) / شَامِل / اِنْطِبَاع, أَثَر / تَقْلِيد / حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ) / بَخْت\nمثال: لقد حالفني الحظ. / اجتماعية (الميل للاختلاط بالآخرين وتكوين مجموعات اجتماعية)\nمثال: الثدييات كفئة ليست قوية في الاجتماعيات",
 "付いている": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "付いてくる": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付いてる": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "付いて回る": "تَمَسَّكَ",
 "付いて来る": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付いて行く": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "付いて行ける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付かたり": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付き": "شَامِل / اِنْطِبَاع, أَثَر / تَقْلِيد / حَظّ ((حَظَّ) حظا: حسن حظه فهو محظوظ وحظيظ) / بَخْت\nمثال: لقد حالفني الحظ. / اجتماعية (الميل للاختلاط بالآخرين وتكوين مجموعات اجتماعية)\nمثال: الثدييات كفئة ليست قوية في الاجتماعيات",
 "付きまとう": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "付き人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "付き具合": "اِلْتِصَاق",
 "付き合い": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "付き合いきれない": "اِكتَفَى, مُكتَفٍ",
 "付き合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "付き従う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "付き添い": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付き添い人": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付き添い役": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付き添い者": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم)",
 "付き添う": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "付き添役": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付き物": "مُلْحَق",
 "付き纏う": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "付き者": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付き馬": "أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "付く": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / نَدْبَة, نَدْب / دُبّ / دُبَّة / اِحْتَمَلَ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "付け": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة. / حبة, قرص (جرعة من الدواء على شكل قرص صغير) / شريط, لسان (شريط قصير من مادة متصل بشيء أو بارز منه لتسهيل فتحه أو تحديده أو التعامل معه) / مفتاح الجدولة (المفتاح الموجود في الآلة الكاتبة أو معالج النصوص الذي يسبب جدولة) / صحافة التابلويد, صحافة صفراء (صحافة تعتمد على الإثارة والمبالغة)\nمثال: اسحب اللسان لفتح العلبة / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / مُؤَثِّر صَوْتِيّ / بَائِد, مُؤَرَّخ (يَحْمِل سِمَات المَاضِي القَرِيب الَّذِي عَادَةً مَا يُسْتَهَان بِه)",
 "付けた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "付けたり": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付けまげ": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "付ける": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / أْثَث ((أَثَّثَ): لين ومهد؛ (أَثَّثَ) البيت: فرشه بالأثاث) / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "付け不足": "شحنة غير كافية, شحنة ناقصة (شحنة غير كافية) / تسعير منخفض, سعر بخس (سعر منخفض جداً)",
 "付け人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "付け値": "عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "付け出し": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "付け出す": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "付け加え": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付け加える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "付け加えると": "بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "付け合せ": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "付け合せる": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / قَارَنَ / شَبَّهَ",
 "付け合わせ": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "付け合わせる": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / قَارَنَ / شَبَّهَ",
 "付け回す": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付け回る": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付け届け": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "付け掛け": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "付け文": "رِسَالَةُ حُبٍّ",
 "付け替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "付け替える": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "付け札": "زَقِيطَة",
 "付け根": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "付け毛": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "付け火": "إحراق الممتلكات, حريق متعمد (الحرق العمد لتدمير الممتلكات)",
 "付け焼き刃": "تَصَنُّع, تَكَلُّف",
 "付け焼刃": "تَصَنُّع, تَكَلُّف",
 "付け目": "نقطة ضعف (صفة غير كافية أو ناقصة) / عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "付け知恵": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "付け紙": "زَقِيطَة",
 "付け薬": "مَرْهَم, دَهُون",
 "付け足し": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付け足す": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "付け足り": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付け込み": "إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل",
 "付け込み帳": "دفتر أستاذ, دفتر يومية (دفتر يومية محاسبي كشيء مادي) / دفتر الأستاذ, دفتر الحسابات (سجل تُدون فيه الحسابات التجارية)\nمثال: اشترى دفتر يومية جديداً",
 "付け込む": "اِسْتَغَلَّ / أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "付け馬": "أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "付け髪": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "付け髷": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "付す": "أَفِكْس / أَشَارَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付する": "أَفِكْس / أَشَارَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "付与": "مَنَحَ / مِنْحة",
 "付人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "付会": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "付保": "تَأْمِين",
 "付値": "عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "付出し": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "付加": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付加え": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "付加価値ネットワーク": "عَرَبَة نَقْل, عربيه نقل",
 "付加価値再販業者": "فولت-أمبير (وحدة للقدرة الكهربائية في دائرة التيار المتردد تساوي القدرة المبددة عندما ينتج 1 فولت تياراً مقداره 1 أمبير)",
 "付加価値税": "ضريبة القيمة المضافة (ضريبة تعتمد على قيمة السلع التي يحصلها بائع التجزئة النهائي)",
 "付加価値通信網": "عَرَبَة نَقْل, عربيه نقل",
 "付加反応": "تفاعل إضافة (تفاعل كيميائي يضاف فيه جزيء إلى آخر)",
 "付加詞": "فَضْلَة",
 "付勢": "تَحَيُّز",
 "付合": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش)) / حق الدخول, دخول (الحق في الدخول) / إذعان, انضمام (الموافقة على أو القبول بـ (غالبًا على مضض)) / إضافة, مُقتنى جديد (شيء يضاف إلى ما تمتلكه بالفعل)\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "付合い": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "付嘱": "إسباغ, تقليد (فعل منح شرف أو تقديم هدية)",
 "付室": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال) / دهليز (أي من التجاويف الجسدية المختلفة المؤدية إلى تجويف آخر (كما في الأذن أو المهبل))",
 "付届": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "付届け": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "付属": "انتماء (السعادة التي تشعر بها في علاقة آمنة)\nمثال: مع زملائه في الفصل شعر بإحساس بالانتماء",
 "付属品": "كَمَالِيّ / مُسَاعِد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / أَكْسِسْوَار\nمثال: علي مساعدة ماري.",
 "付属書": "مُلْحَق",
 "付属物": "أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي",
 "付属節": "جملة تابعة, جملة ثانوية (جملة في جملة معقدة لا يمكن أن تقف وحدها كجملة كاملة وتعمل داخل الجملة كاسم أو صفة أو ظرف)",
 "付属肢": "زائدة, لاحقة (جزء متصل بشيء أكبر منه) / بروز, زائدة (امتداد أو بروز طبيعي من جزء من كائن حي سواء كان حيواناً أو نباتاً) / زائدة, طرف (جزء خارجي من الجسم يبرز منه)\nمثال: نتوء عظمي",
 "付帯": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / جانبي, طارئ ((يتبعه أحياناً 'لـ') ثانوي أو عابر أو تابع في الأهمية أو الطبيعة أو يحدث كمرافق أو نتيجة بالصدفة) / بند عرضي, نفقات نثرية (بند أو عنصر ثانوي أو عرضي)\nمثال: نفقات عرضية",
 "付帯的": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / جانبي, طارئ ((يتبعه أحياناً 'لـ') ثانوي أو عابر أو تابع في الأهمية أو الطبيعة أو يحدث كمرافق أو نتيجة بالصدفة) / بند عرضي, نفقات نثرية (بند أو عنصر ثانوي أو عرضي)\nمثال: نفقات عرضية",
 "付帯費用": "مصروفات عرضية, نفقات نثرية ((غالباً بصيغة الجمع) مصروف لم يتم وضعه في الميزانية أو لم يتم تحديده)\nمثال: طلب تعويضاً قدره 7 دولارات عن نفقات نثرية",
 "付庸": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "付替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "付札": "زَقِيطَة",
 "付毛": "شعر مستعار, وصلة شعر (غطاء أو خصلة من شعر بشري أو صناعي تستخدم للتنكر أو الزينة)",
 "付注": "تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "付添い人": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付添う": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "付添人": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付添役": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "付添者": "مُرافِق, مُشْرِف (شخص يرافق ويشرف على فتاة شابة أو تجمع للشباب لضمان السلوك القويم)",
 "付点": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط",
 "付番": "تَرْقِيم",
 "付着": "اِلْتِصَاق\nمثال: 海の植物は海底に付着して育つ。 — النباتات البحرية تنمو في قاع البحر.",
