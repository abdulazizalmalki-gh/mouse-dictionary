 "分館": "توسعة, جناح (إضافة توسع المبنى الرئيسي)",
 "切": "مُشْتَاق / مُعْفَى مِنَ الخِدْمَة (لا يؤدّي واجبات أو ليس في جدول المهام) / بعيداً, فصلاً (لم يعد متصلاً أو ملامساً) / بَعِيدًا (من شيء أو مكان أو منصب معين) / عَلَى بُعْد (على مسافة في المكان أو الزمان)\nمثال: نظف الأوساخ / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مُتَّجِه / خاتمة / ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "切々": "شَغُوف, مُتَحَمِّس / مُؤَثِّر, مُبَكٍّ (يثير المشاعر والعواطف)",
 "切った張った": "عَنِيف",
 "切っては切れない": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "切っても切れない": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "切って捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切っ先": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "切っ端": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "切ない": "أَلِيم, مُؤْلِم / طُغْيَانِيّ, قَمْعِيّ (يَتَّسِم بِقَسْوَة ظَالِمَة أَوْ سُلُوك تَعَسُّفِيّ) / خانِق, كابِت (يُثْقِل كاهِل النَّفْس والحَواسّ بِشِدَّة)",
 "切なる": "مُشْتَاق",
 "切に": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "切らす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "切り": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مُتَّجِه / خاتمة / ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد",
 "切りがいい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "切りがない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "切りがよい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "切りが無い": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "切りが良い": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "切りくず": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "切りっぱし": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "切りっ端": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "切りつめる": "قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ",
 "切りなおす": "إعادة خلط, تعديل وزاري (الخلط مرة أخرى) / إعادة خلط, تعديل وزاري (إعادة توزيع لشيء ما)\nمثال: طلب المقامر إعادة خلط الأوراق",
 "切りぬく": "مَقْصُوص, مُقْتَطَع (تم قصه واستخراجه)",
 "切りのない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "切りの無い": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "切りの良い": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "切りひらく": "شَفَّاف / وَاضِح",
 "切りまわす": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "切り上げ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "切り上げる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "切り下げ": "بخس, تقليل القيمة (تخفيض قيمة شيء ما أو أهميته) / تخفيض القيمة (تخفيض رسمي لعملة وطنية؛ انخفاض في قيمة عملة بلد ما بالنسبة لعملات الدول الأجنبية)",
 "切り下げる": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "切り伏せる": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切り倒す": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "切り傷": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り入る": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "切り出し": "حطابة, قطع الأشجار (عمل قطع الأشجار للحصول على الأخشاب) / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ)) / استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "切り出す": "مَقْلَع / فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح.",
 "切り分かつ": "مُقَطَّعٌ إِلَى قِطَع (مقسَّم إلى قطع)",
 "切り分ける": "مُقَطَّعٌ إِلَى قِطَع (مقسَّم إلى قطع) / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "切り刻む": "آلة كي, معصرة غسيل (مجفف ملابس لتجفيف وكي الغسيل بتمريره بين أسطوانتين ساخنتين ثقيلتين)",
 "切り割る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り去る": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り取り": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة / سَطْو / لُصُوصِيَّة",
 "切り取り線": "خط منقط (خط مكون من نقاط أو شرطات؛ يستخدم غالباً للإشارة إلى المكان الذي يجب التوقيع فيه على عقد (أو مستندات أخرى))\nمثال: فقط وقع على الخط المنقط",
 "切り取る": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り口": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "切り回し": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "切り回す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "切り土": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "切り売り主義": "بِغَاءٌ, دَعَارَة",
 "切り妻": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون)",
 "切り子": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "切り子ガラス": "زجاج محفور (زجاج مزخرف بقطع أو طحن جوانبه)",
 "切り屑": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "切り岸": "جُرْف (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "切り崩す": "مُسْتَوًى / مَرْحَلَة / انفصل",
 "切り張り": "ترقيع (فعل إصلاح ثقب في ثوب بخياطة رقعة عليه)",
 "切り戻し": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات)",
 "切り手": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس))",
 "切り払う": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "切り抜き": "قُلَامَة / مِشْبَك / كْلِيبْ",
 "切り抜き帖": "ألبوم قصاصات (ألبوم يمكن لصق القصاصات أو الملاحظات أو الصور فيه)",
 "切り抜き帳": "ألبوم قصاصات (ألبوم يمكن لصق القصاصات أو الملاحظات أو الصور فيه)",
 "切り抜き細工": "جزء مقتطع, قُصاصة (جزء تم قصه أو المقصود قصه) / صورة مفرغة (صورة فوتوغرافية تم قص الخلفية منها) / قاطع تيار (مفتاح يقطع الدائرة الكهربائية في حالة الحمل الزائد)",
 "切り抜く": "مَقْصُوص, مُقْتَطَع (تم قصه واستخراجه)",
 "切り抜ける": "هَزَمَ, غَلَبَ",
 "切り拓く": "شَفَّاف / وَاضِح",
 "切り捨て": "تَضْحِيَة, قُرْبَان / ضَحَّى / إِغْفَال",
 "切り捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه) / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切り接ぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة / تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "切り換え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切り換える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "切り換え時": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "切り放つ": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り替え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切り替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "切り替え時": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "切り替わる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "切り札": "وَرَقَة رَابِحَة",
 "切り杭": "جُذْمُور, كُنَّاشَة",
 "切り枝": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "切り枯らす": "دَمَّرَ",
 "切り株": "جِذْع, جِذْل (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "切り欠き": "جزء مقتطع, قُصاصة (جزء تم قصه أو المقصود قصه) / صورة مفرغة (صورة فوتوغرافية تم قص الخلفية منها) / قاطع تيار (مفتاح يقطع الدائرة الكهربائية في حالة الحمل الزائد)",
 "切り欠く": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り殺す": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切り炭": "صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "切り盛り": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "切り目": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "切り直す": "إعادة خلط, تعديل وزاري (الخلط مرة أخرى) / إعادة خلط, تعديل وزاري (إعادة توزيع لشيء ما)\nمثال: طلب المقامر إعادة خلط الأوراق",
 "切り石": "حجر منحوت, حجر مهذب (كتلة مستطيلة من الحجر المنحوت تستخدم لأغراض البناء)",
 "切り立った": "حاد الانحدار, شديد الانحدار (ذو ميل حاد) / حَادّ, شَدِيد الانْحِدَار (للمنحدر؛ مضبوط بزاوية عالية) / بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير) / منحدر حاد (مكان شديد الانحدار (كما في التل))\nمثال: سلالم العلية شديدة الانحدار",
 "切り立てる": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り端": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ)) / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "切り籠": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "切り紙絵": "جزء مقتطع, قُصاصة (جزء تم قصه أو المقصود قصه) / صورة مفرغة (صورة فوتوغرافية تم قص الخلفية منها) / قاطع تيار (مفتاح يقطع الدائرة الكهربائية في حالة الحمل الزائد)",
 "切り組む": "نقر (ثقب مربع مصنوع لاستقبال اللسان وتشكيل وصلة)",
 "切り絵": "جزء مقتطع, قُصاصة (جزء تم قصه أو المقصود قصه) / صورة مفرغة (صورة فوتوغرافية تم قص الخلفية منها) / قاطع تيار (مفتاح يقطع الدائرة الكهربائية في حالة الحمل الزائد)",
 "切り継ぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة / تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "切り羽": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
