 "冱てる": "تَجَمَّدَ",
 "冴": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها / براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "冴え": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها / براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "冴えない": "كَلِيل / غَيْرُ مُرْضٍ, مُخَيِّبٌ لِلآمَال (لا يرقى إلى مستوى التوقّعات) / غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "冴える": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "冴えわたる": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "冴え冴え": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "冴え冴えした": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "冴え冴えとした": "مَسْرُور, فَرِح (كلُّ من يشعر بالسُّرُور)\nمثال: أما مسرور برؤيتك.",
 "冴え渡る": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "况や": "نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "冶": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "冶金": "عِلْم المَعَادِن (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "冶金学": "عِلْم المَعَادِن (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "冶金学者": "خبير معادن, مهندس تعدين (مهندس مدرب على استخراج وتكرير وسبك وتصنيع المعادن)",
 "冷": "ثَلَّاجَة / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷々": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / غير مبالٍ, غير مكترث (يفتقر إلى الاهتمام أو الرعاية أو الشعور) / غَيْرُ مُنْشَغِل, غَيْرُ مُهْتَمّ (لَيْسَ مُنْشَغِلًا أَوْ مُنْخَرِطًا فِي أَمْرٍ مَا) / غَيْرُ مُبَالٍ, غَيْرُ مُكْتَرِث (مرتاح النفس؛ غير قلق)",
 "冷え": "برود, جفاء (نقص في المودة أو الحماس) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل)\nمثال: برود مؤلم في النبرة والأسلوب",
 "冷え冷え": "ببرود (بافتقار لدفء المشاعر؛ بطريقة باردة غير عاطفية)\nمثال: خاطبها ببرود",
 "冷え腹": "إِسْهَال",
 "冷え込み": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة / تباطؤ, تلكؤ (فعل الإبطاء أو التخلف عن الركب)",
 "冷え込む": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "冷かし": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة) / رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "冷かす": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة) / بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "冷し": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "冷す": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / أَهْدَأَ, هَدَّأَ",
 "冷たい": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷たい戦争": "الْحَرْب الْبَارِدَة / حَرْب بَارِدَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "冷っこい": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷ます": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "冷めやらぬ": "تريث, تلكؤ (فعل التريث أو البقاء لفترة أطول)",
 "冷める": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "冷め遣らぬ": "تريث, تلكؤ (فعل التريث أو البقاء لفترة أطول)",
 "冷や": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷やか": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح",
